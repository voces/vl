// A type-checker for a meaningful subset of VL, written in VL
// (Track H / H3 self-hosting — the compiler stage after the lexer and parser).
//
// Side-by-side with `compiler/typecheck.ts`, whose SHAPE it follows (a type
// algebra, a scope chain, inference from initializers, structural assignability,
// a diagnostics channel) but reimplemented idiomatically for VL — it is NOT a
// transliteration. VL has no module system yet, so the TS driver
// (`tests/selfhost_typecheck_test.ts`) concatenates `compiler/ast.vl`,
// `compiler/parser.vl`, this file, then a `.vl` harness before compiling, so the
// AST types/constructors, the global parser state `P`, the parse entry points,
// and `i32ToStr` are already in scope. The checker consumes the REAL parser's
// node arena (`P.nodes`): it lexes nothing and parses nothing itself, it walks
// the union AST the parser built.
//
// ── Finding 1 — the type algebra is a TYPE ARENA ─────────────────────────────
// VL's `compiler/typecheck.ts` represents types as a RECURSIVE union `VLType`
// whose members nest more `VLType`s (an `Object` property's type is a `VLType`, a
// `Function`'s return is a `VLType`). That encoding is NOT expressible in VL: a
// `type` union alias cannot self- or forward-reference its own members (the same
// limitation that forced the AST to use arena indices for child nodes — see
// `ast.vl`). So types live in their OWN flat arena `T.tys: Ty[]` and every place
// a type would nest another type holds an `i32` INDEX into that arena instead:
//   - `TyObj.objFieldTypes : i32[]`  (a field's type is a type-arena index)
//   - `TyFunc.fnParamTypes : i32[]`, `TyFunc.fnRet : i32`
//   - `TyUnion.uMembers : i32[]`, `TyNullable.nInner : i32`
// This is the same workaround the AST node arena uses, applied to the type
// algebra — the predicted gap, now confirmed (PR gap inventory #1).
//
// ── Finding 2 (RESOLVED) — the mono-visitor constraint is lifted ─────────────
// Historically, two distinct functions that `is`-narrowed the SAME union and were
// mutually recursive through it MISCOMPILED ("Object has no field …"), which forced
// every per-variant body to be INLINED into the single `checkNode` mega-function.
// That host bug is FIXED — pinned by `tests/cases/types/union-two-visitors.vl` and
// `union-narrowed-helper-recursion.vl` — so the visitor is now factored naturally:
// per-kind helpers (`checkCallNode`, `checkFuncDeclNode`, `checkProgramNode`) take
// the NARROWED variant as a struct parameter, narrow further `Node` children
// themselves, and recurse back through `checkNode`. Remaining small arms stay
// inline in `checkNode` for readability, not out of necessity.
//
// Checker state lives in the global `T` (a `Checker` struct), like the parser's
// `P` — a style choice for call-site brevity. (The old struct-param-into-recursive-
// group miscompile is also fixed, pinned by
// `tests/cases/functions/struct-param-mutual-recursion-global.vl`.)

// The AST data layer (`compiler/ast.vl`): the global parser state `P` (whose
// `P.nodes` arena the checker walks), the int→string helper, and every `Node`
// variant type the single `checkNode` visitor `is`-narrows. The checker's own
// `Ty` type algebra stays PRIVATE to this module.
import {
  f32LitOverflows,
  f64LitOverflows,
  intLexemeIsExactF32,
} from "./emit_bignum"
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  ErrExpr,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  ImportDecl,
  Index,
  IsExpr,
  LetDecl,
  MatchExpr,
  Member,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  Param,
  Paren,
  Program,
  RetStmt,
  StrLit,
  TypeDecl,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
  mkBinary,
  mkBlock,
  mkIf,
  mkNum,
} from "./ast"
import {
  P,
  declNameTokOf,
  fillArgDefaults,
  fnRequiredArity,
  hasNamedArgs,
  i32ToStr,
  nodeToks,
  orderArgsByParamNames,
  tsMentionsAnyName,
  ufcsAliasOf,
} from "./ast"
// The free INDEX-OPERATOR declaration-name encoding (B14).
import { OP_INDEX_GET, OP_INDEX_SET, opDeclLabel, opDeclOpOf } from "./ast"
// The parser's SPELLING TREE (D-PARSETY, #1117) — what `parseTypeName` saw,
// before it concatenated it into a name. `tsToTy` resolves from this instead of
// re-parsing the concatenation.
import { PIN_ANON, PIN_NONE, PIN_SIGKEY } from "./ast"
import {
  TS_APP,
  TS_ARR,
  TS_ERR,
  TS_FIELD,
  TS_FUNC,
  TS_ISECT,
  TS_LITNUM,
  TS_LITSTR,
  TS_MAP,
  TS_NAME,
  TS_NEG,
  TS_NULL,
  TS_OBJ,
  TS_PAREN,
  TS_UNION,
  annTsOf,
  clearAnnTs,
  clearUdTs,
  declGpBaseOf,
  declGpParamsOf,
  tsKidCount,
  tsKidStart,
  tsKids,
  tsKind,
  tsText,
  tsToName,
  udTsRootAt,
} from "./ast"
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  ErrExpr,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  Index,
  IsExpr,
  LetDecl,
  Member,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  Param,
  Paren,
  Program,
  RetStmt,
  StrLit,
  TypeDecl,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
} from "./ast"
import {
  SYM_MEM_METHOD,
  redunECol,
  redunELine,
  redunName,
  redunSCol,
  redunSLine,
  redunTok,
  redunType,
  scopeResKind,
  scopeResName,
  scopeResType,
  symBindKind,
  symBindNode,
  symBindType,
  symEnabled,
  symMemCol,
  symMemEndCol,
  symMemLine,
  symMemNode,
  symMemTy,
  symOccDecl,
  symOccIsDecl,
  symOccTok,
  symVisEC,
  symVisEL,
  symVisKind,
  symVisName,
  symVisNode,
  symVisSC,
  symVisSL,
} from "./check_state"

// ── THE TYPE-NAME GRAMMARS AND THE BRACKET-DEPTH WALK: THE HOME IS `tyname.vl` ────────
//
// Twenty-one pure character grammars over a type-name STRING used to live in THIS file,
// because until #1228 this was the lowest module both the checker and the emitter could
// reach (`emit_base.vl` imports this one, so a home up there was unreachable from here —
// eight headers in this file said so). They now live one module further down, in
// `compiler/tyname.vl`, a LEAF with zero imports: every body is a pure function of a
// string, which is what makes the extra module free rather than a new cycle risk.
//
// Phase 0 published all twenty uniformly from HERE and this line was a re-export — an
// import that also publishes — so every call site in this file, plus `emit_base.vl`'s
// `import`/`export … from "./typecheck"` lines and `driver.vl`'s `gaeLtAt`, compiled
// untouched and phase 0 changed no emitter module. **That is no longer the arrangement.**
// D-TYNAMEHOME phase 1 re-pointed all nine consumers at the home (1a `emit_classify` +
// `emit_base`, 1b `emit_collect` + `emit_mono`, 1c `emit_rewrite` + `driver` + `emit_rep` +
// `emit_sections`), so NOTHING reaches `tyname.vl` through this file any more and the
// re-export is a plain `import`. `emit_base.vl`'s republishing line is likewise gone, so the
// three-hop chase (`tyname` → `typecheck` → `emit_base` → an emitter module) is out of the
// tree: every consumer is now exactly ONE hop from the home.
//
// The set shrank TWENTY → SEVENTEEN with the line's demotion, and the seventeen are exactly
// the grammars this file itself calls. `parenEnclosesWhole` and `tyGtIsClose` had no
// consumer through here from the moment phase 0 published all twenty uniformly, and
// `peelGroupParens` lost its last one (`emit_base`) in 1a. Unpublishing is resolver-enforced,
// not asserted: dropping a name a consumer still wants makes the compiler refuse to build
// itself and NAME the consumers, and these three produce no such error.
//
// ── PHASE 2 PUT A REPUBLISHING LINE BACK; THE FOLLOW-UP IT FILED IS NOW DISCHARGED ─────
// D-TYNAMEHOME phase 2 moved `splitUnionAtoms` / `unionMemberCount` down to the leaf and
// could not re-point every consumer — `emit_base.vl`, `emit_classify.vl` and `wasmEmit.vl`
// were HELD by concurrent slices — so it parked an
// `export { splitUnionAtoms, unionMemberCount } from "./tyname"` line here, exactly the
// shape #1236 deleted, to keep their imports resolving with ZERO held-file edits. **That
// line is gone.** The three files came free; their FIVE entries now name `./tyname`, and the
// two grammars reach this file's own five call sites through the plain `import` below like
// the other twenty-six. Nothing in the tree republishes a grammar again, and the leaf's ten
// importers are ten ONE-hop edges — the arrangement #1236 reached and phase 2 dented.
//
// **THE RE-POINT SET IS RESOLVER-DERIVED, NOT GREPPED, AND IT IS NOT THE SET THE QUEUE
// ENTRY NAMED.** Deleting the line makes the compiler refuse to build itself and enumerate
// the consumers: `emit_base.vl` (2 entries), `emit_classify.vl` (2), `wasmEmit.vl` (1) —
// FIVE entries in THREE files, re-derived by this cleanup and identical to phase 2's own
// run. D-SPLITDOWN's queue entry priced phase 2 at "six import lines in three files —
// `emit_rep`, `wasmEmit`, `emit_collect`" and did not list `emit_base` or `emit_classify` at
// all. Unpublishing stays resolver-enforced rather than asserted, in both directions: a
// control build with ZERO `is not exported by` errors is the whole proof that no consumer
// was left behind.
//
// **PHASE 2'S FILING PREDICTED THIS IMPORT WOULD GO 17 → 19; IT READ 26 → 28.** Seventeen
// was phase 1's number and it went stale the moment W1/W2/W4/W7/W14 moved nine further
// grammars into the leaf and added them to the list below. A count carried forward in a
// comment drifts on exactly the slices that touch the list it describes — the same shape
// this programme already recorded for `tyname.vl`'s own IN roster.
//
// A module line must sit with the other module lines: `vl fmt` hoists `import` and
// `export … from` to the top of the file, so a module line parked at the grammars' old
// position is not format-stable — it round-trips to here, dragging its comment along.
import {
  annGenAppSpanEnds,
  arrElemNameRaw,
  fieldNameOf,
  fieldTypeTextOf,
  fnParamsTextOf,
  fnRetTextOf,
  gaeArgsTextOf,
  gaeHeadNameOf,
  gaeLtAt,
  groupInnerOf,
  listElemNameOf,
  mapSpellKeyEnd,
  mapSpellKeyName,
  mapSpellValName,
  nameIsArray,
  nameIsBareIdent,
  nameIsBraceSpanEnds,
  nameIsFuncTypeAtom,
  nameIsMapOpen,
  nameIsMapSpanEnds,
  nameIsParenOpen,
  nameIsParenSpanEnds,
  nameIsQuotedLeaf,
  nameIsShapeOpen,
  nameMentionsIdent,
  parenEnclosesWhole,
  splitUnionAtoms,
  tyTopIndexOf,
  tyTopLevelSplit,
  unionMemberCount,
} from "./tyname"
// The generic AST child walker. Shared with the lint pass rather than duplicated:
// the write-effect summary behind the aliased-write invalidation needs the same
// total traversal the lint rules do, and a second copy is a second thing to keep in
// step with the node roster.
import { nodeChildren } from "./lint"

// ── Type-arena variants ──────────────────────────────────────────────────────
// One struct per type KIND, prefixed field names so `is` discriminates the union
// (the AST's convention). A nested type is always an `i32` index into `T.tys`.

// The primitive VOCABULARY. It was a comment over a `string` field until it became a
// declaration: a closed set spelled in the source is a literal union, and every
// `primName == "i32"` in the compiler is then an `i32.eq` against an interned atom with
// its source text unchanged (F2/#1402's template, applied to the type arena itself).
// The checker is a COMPLETE ORACLE for the conversion — a name outside this set is a hard
// type error, not a silently false comparison, which is what a `string` field allowed.
export type PrimName = "i32"
  | "i64"
  | "f32"
  | "f64"
  | "boolean"
  | "string"
  | "void"
  | "null"
  | "never"

// A primitive.
export type TyPrim = { primName: PrimName }
// The error/unknown type — produced on a type failure so checking continues
// without cascading (akin to TS `Never`/`Unknown`); assignable to/from anything.
//
// `errKind` is WRITE-ONLY and always the same value: the whole compiler contains one
// construction and no read at all (`grep -rn errKind compiler/*.vl` is two lines, this
// declaration and that construction). It exists because `is` discriminates the arena union
// on field NAMES, so the variant needs one field to be distinguishable — it does not need
// that field to be a heap string. An `i32` carries the same nothing for no allocation.
export type TyErr = { errKind: i32 }
// A structural object: parallel arrays of field names and their type-arena
// indices. (Constructed by the harness to seed object-typed bindings; the parser
// subset has no object-type literal syntax yet, so it is not built from source.)
export type TyObj = { objFieldNames: string[], objFieldTypes: i32[] }
// A function: parameter type indices and a return type index.
export type TyFunc = { fnParamTypes: i32[], fnRet: i32 }
// A union `A | B | …`: member type-arena indices.
export type TyUnion = { uMembers: i32[] }
// A nullable `T?` / `T | null`: the inner type-arena index.
export type TyNullable = { nInner: i32 }
// A growable array `T[]`: the element type-arena index (`-1` for an empty `[]`
// whose element is not yet known — assignable to any array, like a hole).
export type TyArray = { aElem: i32 }
// A string-keyed map `{[K]: V}` or a Set over it: key and value type-arena
// indices (`-1` for the holes of a bare `Map()`/`Set()`, pinned by the binding
// annotation or the first `.set`/`.add`). `mSet` is 1 for the SET flavor — a set
// is internally a boolean-valued map but exposes ONLY `.add`/`.has`/`.delete`/
// `.length`/`.values()` (the Map surface — `.set`/`.get`/`.keys` — must not leak).
export type TyMap = { mKey: i32, mVal: i32, mSet: i32 }
// A generic TYPE PARAMETER (`T` in `function id<T>(x: T): T`): opaque inside the
// generic body (assignable both ways, like the err hole); at a CALL site each
// TyVar param BINDS to its argument's type and the return substitutes through.
export type TyVar = { tvName: string }
// The literal-member VOCABULARY — the same conversion `PrimName` records above, on the
// other closed set the arena held as a raw `string` with its members written out in a
// comment. Nine producers, every one a literal `mkLitTy("str"/"int"/"flt", …)`.
export type LitKind = "str" | "int" | "flt"

// A LITERAL type — the host's `StringLiteral`/`IntegerLiteral`/`RealLiteral`:
// a single-inhabitant type (`"a"`, `0`, `1.5`), the member unit of a literal
// union. `litText` is the member's text —
// the RAW characters between the quotes for "str" (escapes unresolved; both
// the annotation and the literal expression carry the same raw lexeme, so
// membership compares consistently), the numeric lexeme for "int"/"flt".
export type TyLit = { litKind: LitKind, litText: string }
// A NEGATION `!T` (A4) — "anything but `T`". Almost always consumed by
// `intersectTy` (`A & !B` subtracts); a residual standalone negation accepts
// any source NOT assignable to its inner type.
export type TyNeg = { negTy: i32 }

// The unified type. Declared after its members (a union alias can't forward-
// reference). Discriminated with `is`, exactly like the AST `Node`.
export type Ty = TyPrim |
  TyErr |
  TyObj |
  TyFunc |
  TyUnion |
  TyNullable |
  TyArray |
  TyMap |
  TyVar |
  TyLit |
  TyNeg

// A type diagnostic: a message plus the AST node index it was raised at. VL has
// no exceptions, so errors are accumulated on `T.diags`, not thrown.
// `tline`/`tcol` are the SOURCE position of the node's anchor token (1-based
// line, 0-based column — the lexer's convention), resolved by `tErr` through the
// `nodeToks` side table at raise time; `tline == 0` means "no position" (the
// node had no token mapping), in which case the diagnostic renders bare.
// `tcode` is the stable CATEGORY code: "" for a type-soundness rejection (the
// default), or `CODE_UNSUPPORTED_LOWERING` for a program the type system
// accepts but codegen cannot lower yet (see `tErrUnsupported`).
type TDiag = { tmsg: string, tat: i32, tline: i32, tcol: i32, tcode: string }

// The stable category code for EMITTER-CAPABILITY rejections: the construct is
// type-valid, but codegen cannot lower it yet. Machine-distinguishable from a
// type-soundness verdict (the LSP/tooling read it via `diagCodeLen`/
// `diagCodeByte`), yet still an error — a program that cannot build must not
// pass `vl check`.
const CODE_UNSUPPORTED_LOWERING = "unsupported-lowering"

// ── Checker state (one struct, held in the global `T`) ───────────────────────
// `tys`     — the type arena (every type is an index into it).
// `scopes`  — the scope chain: an array of `name → type-index` maps. Index 0 is
//             the global scope; entering a block/function pushes a fresh map,
//             leaving pops it. Shadowing is innermost-wins lookup.
// `diags`   — accumulated diagnostics.
// `curRet`  — the type-arena index of the enclosing function's return type while
//             checking its body (`-1` outside any function), so `return e` can be
//             checked against it.
export type Checker = {
  tys: Ty[],
  scopes: {[string]: i32}[],
  diags: TDiag[],
  curRet: i32,
}

// The single checker instance. The harness calls `initChecker()` then the entry
// point `checkProgram(root)` and reads `T.diags`.
export let T: Checker = { tys: [], scopes: [], diags: [], curRet: -1 }

let symDeclScope: {[string]: i32}[] = []

// The OPEN-scope span stack, pushed/popped in lockstep with `symDeclScope`: the
// top is the span of the scope a `symDecl` binds into. A narrowing-only scope (no
// owner node) pushes a full-file sentinel — it never holds a binding. `SCOPE_EOF`
// is a line past any real source line, so the global scope (and any sentinel)
// contains every in-file position while staying the LOOSEST (so an inner scope
// always shadows it).
const SCOPE_EOF = 1000000000
let scopeSL: i32[] = []
let scopeSC: i32[] = []
let scopeEL: i32[] = []
let scopeEC: i32[] = []

// `cUserTypes` — declared struct/union types: a `name → type-arena index` map built
// in a pre-pass over the program's `type` declarations (so a struct name in a
// param/return/let annotation, or in a later struct's field, resolves). A MODULE
// GLOBAL rather than a `Checker` field: the emitter handles a bare-map global but not
// a bare-map struct field, and there is exactly one checker instance, so this is
// equivalent (and keeps the full compiler self-emittable). Reset by `initChecker`.
export let cUserTypes: {[string]: i32} = Map()

// ── Arena-mutation generations (the emit-side repOf memo invalidation) ───────
// `tyMutEpoch` advances on EVERY in-place mutation of an EXISTING `T.tys` entry
// — empty-collection pinning (`aElem`/`mKey`/`mVal`/`nInner`), return-inference
// patching (`fnRet`), hole-shape field recording — i.e. any event that can
// change a type's canonical structural key (`repCanonKey`, emit_rep.vl). Its
// memos there are stamped with this epoch; a stale stamp discards the memo, so
// a bump is always SAFE (worst case a recompute) while a MISSED bump is a
// soundness bug (a stale key could merge/split struct slots wrongly). Minting a
// NEW arena index needs no bump: no existing type's key walk can reach it.
// `cUserTypesVer` advances on every `cUserTypes` WRITE (decl registration,
// `resolveAnnot` memoization) — any event that can change which declared arena
// index a struct-slot NAME resolves to (the `repSlotOfTy` scan input). Both
// also advance in `initChecker`: the arena is re-minted per program, so no memo
// stamped under an earlier program may survive on a shared instance.
export let tyMutEpoch = 0
export let cUserTypesVer = 0

// GENERIC TYPE ALIASES (A10 stage 3, host `instantiateAlias`): a parameterized
// `type Box<T> = { value: T }` registers here (NOT in `cUserTypes` — it has no
// concrete type until applied). Parallel per-alias arrays: the base name ("Box"),
// the parameter-name SLICE (see below), and the `TypeDecl` node index whose fields
// are re-resolved per APPLICATION (`Box<i32>`) under a type-param binding
// environment. Applications memoize into `cUserTypes` under their full synthetic
// name ("Box<i32>"), which also closes recursive applications.
let gaNames: string[] = []
let gaDeclIxs: i32[] = []

// D-GAPARAM — the declared type-PARAMETER NAMES, as a flat column plus a
// (start, count) slice per alias, the same shape the spelling arena uses for its
// kids (`tsKids`/`tsKidStart`/`tsKidCount`).
//
// This column used to be `gaParamLists: string[]`, ONE COMMA-JOINED STRING per
// alias ("T", "A,B") that `applyGenAliasArgs` split back apart with
// `splitGenArgs` on EVERY APPLICATION. The joining is not this file's doing:
// `parser.vl`'s `parseTypeDecl` folds the parameter TOKENS into the declared
// name (`name = name + ","` per parameter) and its own comment says "the checker
// splits them back out" — so a list the parser held as tokens was joined into a
// string, sliced back out of that string here at registration, and then
// re-split at every use. Splitting ONCE at registration removes the per-
// application parse and the per-application `string[]` it allocated; the arity
// check and the binding loop read `gaParamCount` / `gaParamNames[start + k]`
// directly.
//
// The remaining half is a HAND-OFF to whoever owns `parser.vl` + `ast.vl`: bank
// the parameter names on the `TypeDecl` node (a `string[]` beside `tdFields`, or
// the same flat-column shape) and the `<`-scan-and-slice at registration goes
// too — a name is then only ever a name, never a list the checker takes apart.
let gaParamNames: string[] = []
let gaParamStart: i32[] = []
let gaParamCount: i32[] = []

// The TYPE-PARAM BINDING ENVIRONMENT consulted by `nameToTy` (innermost LAST):
// a generic function's `<T>` names bind to their TyVars while its annotations
// resolve (`resolveAnnot`), and an alias application's params bind to the
// argument types while the alias body resolves (`applyGenAlias`).
let tpEnvNames: string[] = []
let tpEnvTys: i32[] = []

// DEMANDED HOLE SHAPES (host: `getChildType` pins an `Infer<Unknown>` to a
// GROWING `{…}` object): a member access on an inference-hole param
// (`self.x` where `self` is the hole `?add.0`) records field `x` on the
// hole's demanded shape — a TyObj that grows one DERIVED hole
// (`?fld.x.?add.0`) per accessed field. Each call site then checks its
// argument against the demanded shape (so `getx(5)` rejects when the body
// read `o.x`), and `substTyDeep` resolves the derived holes against the
// call's bindings (`?fld.x.?getx.0` → field `x` of the pinned argument).
let holeShapeNames: string[] = []
let holeShapeTys: i32[] = []
// Hole NAMES that were INDEXED (`self[i]`) — so the hole demands an array. The call site
// rejects a non-indexable scalar argument bound to such a param (`head(5)` where the body
// read `self[0]`), the indexing analogue of the demanded-shape check above.
let holeArrayDemand: string[] = []
// Hole NAMES whose body used the MAP/SET SURFACE (`self.set(k, v)`, `.get`, `.has`,
// `.delete`, `.add`, `.keys()`, `.values()`) — so the hole demands a map, and the parallel
// `holeMapTys` entry IS that map: an open `{[?]: ?}` the body's own operations pin in place.
// The MAP dual of `holeArrayDemand`, carrying a type rather than only a flag, because a map's
// demand has two halves to pin and an argument's `Map()` may need either of them
// (`holeMapDemandTy`).
let holeMapNames: string[] = []
let holeMapTys: i32[] = []

// ALTERNATIVE hole constraints contributed by an `is` GUARD over the hole itself:
//
//     function foobar(v) {
//       if v is {foo: string} then return v.foo
//       return v.bar
//     }
//
// Inside the then-branch `v` is NARROWED to `{foo: string}`, so `v.foo` reads the
// narrowed binding and never grows the demanded shape — only the fall-through
// `v.bar` does. The shape therefore records the constraint of the COMPLEMENT path
// ALONE (`{bar: any}`), and checking every argument against it rejects the very
// argument the guard exists to accept. The tested types are ALTERNATIVES, not
// additional fields, so they are recorded here and the call-arg check accepts an
// argument satisfying the demanded shape OR one of them.
//
// This is precise rather than a loosening, because each alternative also carries
// WHICH demanded fields an argument taking the guard's TRUE path still reaches:
//   • `holeAltPreN[k]` — the number of shape fields already demanded when the guard
//     was reached. Those accesses run BEFORE the guard, so they are still required.
//   • `holeAltTailN[k]` — the shape-field count at the END of the guard `if`, i.e.
//     the start of the fields demanded AFTER it, or -1 when the then-branch
//     DIVERGES (a `return`/`break`/`continue` guard clause) and the tail is
//     therefore unreachable for an argument that satisfies the alternative.
// Fields demanded strictly INSIDE the `if` (its else arm) are never required: the
// guard being true means that arm did not run. So `if v is T then return v.foo` /
// `return v.bar` accepts `{foo: string}` while `print(v.zap)` ahead of the guard,
// or a non-diverging then-branch, keeps the complement's fields required.
let holeAltNames: string[] = []
let holeAltTys: i32[] = []
let holeAltPreN: i32[] = []
let holeAltTailN: i32[] = []
// The arena index of the HOLE each alternative constrains — the same hole
// `holeAltNames[k]` names. `mkGuardedRetTy` needs a HANDLE on that hole (not just
// its name) to build a guarded-member DERIVATION whose base points at it; the row
// is the only place the two are already paired.
let holeAltHoleIx: i32[] = []

// ── DERIVED-HOLE DERIVATIONS (W6: "a union is a data structure") ─────────────
//
// A DERIVED hole is a hole that names a READ off another hole — field-of,
// return-of, element-of, guarded-alternative-of. The derivation used to live in
// the hole's NAME, as a dotted path (`?fld.x.?ret.?f.0`) that four functions
// decoded again by prefix-match plus recursive slicing, with the guarded form
// round-tripping two arena indices through DECIMAL TEXT. That is a type held as
// a parsable string, and it is now a DATA STRUCTURE: one row per derivation, in
// the parallel-array style every other side table here uses.
//
//   hdKind[r]   HD_FLD | HD_RET | HD_ELEM | HD_GALT
//   hdField[r]  HD_FLD: the property read. "" otherwise.
//   hdInner[r]  HD_GALT: the type the guarded branch contributes (arena ix). -1 otherwise.
//   hdAlt[r]    HD_GALT: the guard's tested type (arena ix). -1 otherwise.
//   hdBase[r]   the hole this derivation READS FROM (arena ix) — itself possibly derived.
//   hdDepth[r]  how many derivation layers stack here, so the re-basing budget
//               (`HOLE_REBASE_MAX`) is a stored count instead of a `?`-census of the name.
//
// The NAME is still minted, and still identical byte-for-byte (`hdRenderName`),
// because it remains the hole's IDENTITY: generic bindings (`bNames`), demanded
// shapes, array demands and the alternative rows are all keyed by it. Rendering a
// type is allowed; parsing one back is what this retires. Nothing reads a `?fld.`
// prefix any more — the structure is authoritative from the moment it is minted.
const HD_FLD = 0
const HD_RET = 1
const HD_ELEM = 2
const HD_GALT = 3
let hdKind: i32[] = []
let hdField: string[] = []
let hdInner: i32[] = []
let hdAlt: i32[] = []
let hdBase: i32[] = []
let hdDepth: i32[] = []
// Arena index -> derivation row, grown on demand (a derived hole's arena index is
// dense enough in practice that a sparse i32 sidecar beats a scan). -1 / past the
// end = NOT a derived hole, which is exactly the old "no prefix matched" answer.
let hdRowOfTy: i32[] = []

// The `is`-guard ALTERNATIVE rows (indices into `holeAlt*`) whose THEN-branch is
// currently being checked. A `return` inside one is reached ONLY by an argument
// that satisfies the alternative, so the type it contributes to the inferred
// return is recorded as a GUARDED member (`?galt.` — see `mkGuardedRetTy`) rather
// than as an unconditional one. Innermost row wins: dropping a member needs only
// ONE guard proven false, and keeping it is always the sound direction.
let guardAltStack: i32[] = []

// Unions minted by `joinTys` that carry at least one HOLE member. `substTyDeep`
// re-FOLDS such a union under a call's bindings instead of rebuilding it verbatim
// (`refoldJoinUnion`): the members that RESOLVE are re-joined, and a member still
// unresolved is DROPPED once some member did resolve — a `?fld.bar.<h>` that does
// not resolve at a site whose pinned argument has no `bar` is a branch that
// argument can never reach, and a `?galt.` guard member whose alternative the
// pinned argument cannot satisfy is a branch it can never take. Without the
// re-fold every hole-joined return would surface as a `A | B` union at sites where
// exactly one arm is live, breaking programs that lower fine today.
let joinHoleUnions: i32[] = []

// The UNCOLLAPSED deferred join a call site could not decide, parked under that
// call's NODE index. `collapseDeferredJoin` hands the emitter-safe collapse out as
// the call's type (a deferred join has no runtime shape, so it must never reach
// codegen as a node type), but that collapse is LOSSY: over
// hole members `joinTys` keeps whichever arm is assignable and drops the rest.
//
// A `return h(w)` in a RELAY body then advertised one arm as the relay's whole
// inferred return, and the constraint carried by the other arm vanished a level
// early — `ps(relay({bar: 42}))` type-checked clean and emitted invalid wasm. The
// return-inference path reads the parked join back (`inferRetTyOf`) so the relay
// carries the WHOLE join to its own call sites, where the pinned argument re-folds
// it. Only the return path reads it; every other consumer still sees the collapse.
let dJoinNode: i32[] = []
let dJoinTy: i32[] = []

// DEFERRED JOINS that ESCAPED a call site lossily — the collapse handed out ONE arm
// while the join still named holes this site could not pin. Parallel arrays: the
// uncollapsed join, the call node to anchor a diagnostic on, and the callee's name.
//
// Nothing re-examined these. Under the OUTER call that finally pins the holes the
// join can re-fold to a genuine multi-member union: a two-armed `h(a, b, c)` used
// as `function go(x) { print(h(x, "s", true)) }` with `go(1)` really does result in
// `i32 | string`. The emitter has no rep for an un-annotated join return at a
// monomorphized instance, so that spelling emitted INVALID WASM with `vl check`
// reporting no errors. `validateEscJoins` re-folds each at the pinning call and
// rejects loudly when the arms really do disagree — the same landing the direct
// spelling `print(h(1, "s", true))` already gets from the print-of-a-union floor.
let escJoinTy: i32[] = []
let escJoinIx: i32[] = []
let escJoinWho: string[] = []

// DEFERRED binary-op constraints over un-annotated-param holes. When `a + b` / `s + "!"` / `n < 2`
// has a HOLE operand, its validity can't be decided in the body (a hole is permissively assignable
// to string AND numeric, so the eager check greedily picks a branch). Record `(lt, op, rt)`; the
// generic call-site re-validates each under the SUBSTITUTED argument types via `binOpDefinedFor` —
// one rule for the whole capability: numeric (`n + 1` rejects a string), string (`s + "!"` rejects
// a number), and RELATIONAL (`a + b` rejects `(i32, string)`) all fall out of one check. Operand
// TYPE indices are stored (a hole is a `TyVar` index, stable in the arena); `substTyDeep` maps them
// to the concrete argument types at the call.
let binCstrLt: i32[] = []
let binCstrOp: string[] = []
let binCstrRt: i32[] = []

// DEFERRED call-argument constraints over un-annotated-param holes: inside a generic
// body a HOLE flowed as an argument into a CONCRETE parameter (`function f(x) { g(x) }`
// with `g(n: i32)`). The body can't judge it — a hole is permissively assignable both
// ways — so the demand is recorded (hole type, expected param type, callee name) and the
// generic CALL SITE re-validates it under the substituted argument types, exactly like
// the binary-op constraints above. Indices are arena type indices; `substTyDeep` maps
// the hole to the call's concrete argument type.
let argCstrAt: i32[] = []
let argCstrExp: i32[] = []
let argCstrWho: string[] = []

// SOLVED un-annotated parameter types — the parameter's own body USAGE, read back as
// its type. A hole is permissively assignable both ways, so a usage that requires a
// concrete type (`const r: K = u`, `return u` under a declared return, `q(u)` into an
// annotated parameter, a `K` field / element / map value) rejects nothing in the body
// and leaves the parameter's REP to whatever the call site's argument happened to be.
// The two are not interchangeable: a NAMED string litunion is an interned i32 ATOM
// while a plain `string` is a `(ref $array)`, so the correct program `p("a")` through
// `function p(u) { const r: K = u }` emitted a module the engine rejects, and the
// non-member `p("zz")` — which the annotated spelling rejects — passed `vl check`.
//
// Both directions come from one answer: SOLVE the hole to what its usage demands and
// the parameter becomes indistinguishable from the annotated spelling — the call site
// checks the argument against it, and the emitter's synthesized annotation
// (`synthParamAnnots`, off `nodeTyIx`) reps it identically.
//
// Keyed by the parameter's HOLE NAME, which is already its identity: the pass-1 hoist
// and `checkFuncDeclNode` mint the same name for the same parameter, so both read one
// answer out of `unannotParamTy`.
let solvedParamTys: {[string]: i32} = Map()
// Declarations whose solve has been ATTEMPTED, keyed by decl node index — a body is
// probed at most once, whether or not the probe found anything to solve.
let paramSolveTried: {[string]: boolean} = Map()
// Hole → concrete destination, recorded ONLY while `paramSolveProbe` is set.
// `assignableExpr` is the one seam every binding / argument / return / field /
// element / store flows through, so a single hook there sees every such usage.
let holeFlowSrc: i32[] = []
let holeFlowDst: i32[] = []
let paramSolveProbe = false

// The const-binding chain, PARALLEL to `T.scopes`: each frame records which of
// its names were bound `const` (immutable NAME, not immutable data — a field
// write through a const stays legal). Kept module-level (not a `Checker` field)
// so the exported struct shape is unchanged.
let constScopes: {[string]: boolean}[] = []

// The function-DECLARATION chain, PARALLEL to `T.scopes`: each frame records the
// arena node of every `FuncDecl` declared in it. `fnDeclIx` answers the same
// question for TOP-LEVEL functions only; this answers it for a NESTED one too,
// under the scope chain's own shadowing rule, which is what a call needs to
// recover the callee's parameter list — and with it the DEFAULTS a call site may
// omit. Kept module-level (not a `Checker` field) so the exported struct shape
// is unchanged, exactly like `constScopes`.
let fnDeclScopes: {[string]: i32}[] = []

// UN-INFERRED EMPTY-COLLECTION FLOOR (mirrors the host's `reportUninferredBinding`
// in `compiler/typecheck.ts`): an un-annotated empty `[]` / `Map()` / `Set()` whose
// element/key/value hole is never pinned — by an annotation or a downstream
// `.push`/`.set`/`.add` — has a genuinely unknown type. We can't decide that at the
// declaration (a later use may still pin it), so each such binding is RECORDED here
// (its name, its type-arena index, the decl node) and re-examined at scope close /
// program end: if the hole is STILL open (`aElem < 0`, or `mKey`/`mVal < 0`), it
// "cannot be inferred" and an annotation is required. Three parallel arrays + a
// per-record scope-depth, flushed by `flushUninferred(depth)` (avoids a nested
// `Pending[][]`). An ANNOTATED empty collection never lands here (the binding takes
// the annotation's element type), so the compiler's own annotated `let x: T[] = []`
// / `Map()` / `Set()` bindings are untouched.
let pendNames: string[] = []
let pendTys: i32[] = []
let pendAts: i32[] = []
let pendDepths: i32[] = []

// FLOW-NARROWED PROPERTY PATHS (mirrors the host's `narrowedPaths` overlay):
// a stack of `key → type-arena index` entries (`"o.v" → i32`) overlaid while a
// branch body is checked, plus per-scope frame marks so `popScope` unwinds the
// entries pushed inside that scope. Bare-NAME narrowings keep riding the scope
// chain (a shadowing `declare`); only dotted paths land here.
//
// `npInvBy` is the INVALIDATION side table, one slot per entry: the arena index of
// the call that may have written the path's field through an alias, or -1 while the
// narrowing is still in force. A narrowing over a property path is a fact about
// HEAP state, so unlike a bare local it can be falsified by a write the guarded
// scope never spells — `clr(o)` where `clr` assigns `o.v = null` left `o.v` narrowed
// and both the checker and the emitter believed it (a trap for a ref rep, a printed
// `null` for a boxed one). `callWritesPlace` decides, per call, which entries stop
// being in force.
//
// INVALIDATION IS WRITTEN IN PLACE, NOT PUSHED. A shadowing push would unwind at
// the end of whatever inner block held the call, resurrecting the narrowing for the
// statements after it — `if o.v != null { if c { clr(o) } print(o.v.length) }` must
// stay rejected, because the write MAY have happened. Overwriting the entry the
// guard pushed keeps the invalidation alive exactly as long as the narrowing it
// kills, and `popScope` retires both together.
let npKeys: string[] = []
let npTys: i32[] = []
let npInvBy: i32[] = []
let npEpochs: i32[] = []
let npFrames: i32[] = []

// CYCLE GUARD stacks for `assignable` over recursive named types (A11): a
// (src, dst) pair already being compared higher in the recursion is assumed
// assignable — coinductive, mirroring the host's lazy alias-leaf leniency for
// self-referential types (`left: Tree | null` terminates, not expands).
let asgSrcStack: i32[] = []
let asgDstStack: i32[] = []

// CYCLE GUARD stacks for the generic call-site binding walk (`bindGenWalk`)
// and the deep substitution (`substTyDeep`) — a recursive named type is cyclic
// in the arena, so both walks remember what they are already visiting.
let bgSrcStack: i32[] = []
let bgDstStack: i32[] = []
let stSeenStack: i32[] = []

// DEPTH GUARD for `tyToStr` on recursive named types (A11): a cyclic arena
// shape would otherwise render forever — past a fixed depth it prints `…`.
let tyToStrDepth = 0

// The TOP-LEVEL atom width of the render the LAST `tyToStrAt` returned — the DISPLAY
// renderer's `emitNameAtoms`/`nomNameAtoms`, produced BY the renderer instead of
// re-derived by scanning the finished string. Same invariant as its two siblings: a
// render gains a top-level `|` at exactly two places (the union arm's join and the
// nullable arm's ` | null` suffix), and every other arm builds a name whose separators
// sit inside a grouper or behind a top-level `=>` — ONE atom.
//
// It exists so this renderer can reach `arrElemRender` — the ONE array-grouping home the
// two emit renderers already share — which needs the element's width (D-ARRWIDTH).
//
// Not an arena-lifetime sidecar (method note 7): a scalar written on the way out of every
// return and read by the immediate caller, never carried between programs.
let tyStrAtoms = 1

// Places already union-SUBTRACTED by a post-guard fall-through in the current
// scope (one subtraction per place per block — see the guard-clause comment in
// the IfStmt arm), with per-scope frame marks like the path overlay's.
let pgKeys: string[] = []
let pgFrames: i32[] = []

// NARROWED bare-name bindings: name → the type it was DECLARED with, before a
// narrowing shadowed it. Per-scope frame marks like the two overlays above, so
// `popScope` unwinds a scope's entries with the narrowings themselves. Two entry
// KINDS ride one bank (`NAR_KIND_ASG` / `NAR_KIND_GUARD`) because one question is
// asked of both — what the storage can hold — and the answers must not disagree.
//
// WHY THIS EXISTS AT ALL (#1225's defect, re-derived). A bare-NAME narrowing in
// this checker is a shadowing `declare` into a scope the caller PUSHED for the
// branch (`applyNarrows`), and `popScope` takes it away again. The assignment
// narrowing uses the same `declare` with NO scope of its own — so it does not
// shadow the declaration, it OVERWRITES it, in the very scope that holds it. The
// narrowing is a correct FLOW fact and the overwrite is what is wrong with it:
// the declared type is the binding's STORAGE contract, and three questions must
// keep asking it after a narrowing, or a legal program stops compiling —
//
//   * what the binding ACCEPTS. `let xs: S[] | null = []` / `xs = [{n:1}]` /
//     `xs = null` rejected "cannot assign null to {n: i32}[]", and a FUNCTION
//     declared afterwards could not assign null to the global either: the
//     narrowed type was what its body's `lookup` found. A GUARD narrowing leaks
//     into the same question — `while q != null { … q = null }` rejected "cannot
//     assign null to i32" — which is why guard entries are banked here too.
//   * whether a null TEST is meaningful. `if xs != null` rejected "cannot
//     compare {n: i32}[] with null", which is how the defect was filed. This one
//     is ASSIGNMENT-KIND ONLY: a redundant `if q != null` nested inside a live
//     guard is a genuinely dead test and keeps its diagnostic.
//   * whether a write RETIRES the narrowing (`writeRetiresNarrowing`).
//
// Reads keep the narrowed type — that is the whole point of narrowing, and the
// straight-line `let x: T | null = null` / `x = mk()` / `x.f` pattern depends on
// it. Only the questions above are re-pointed at the declaration.
//
// THE DEPTH IS LOAD-BEARING, not bookkeeping. An entry answers only while its own
// `declare` is still the INNERMOST binding of the name: `let x: i32 | null = null`
// / `x = 5` / `{ let x = "s"   x = null }` banked `i32 | null` for the outer `x`
// and the inner write read it, so `null` went into a `string` binding and the
// binding's type was overwritten with `i32?` — a check-clean wrong type.
//
// A RETIRED bare-name narrowing leaves the name READABLE, at its DECLARED type — the
// declared type going back into the scope the narrowing shadowed IS the whole retirement,
// and every read after the write then asks the storage. It used to be refused outright,
// for an emitter reason and not a soundness one: the emitter's narrow stack held the
// region's narrowed rep for the rest of the guarded block, so a read typed `i32?` here
// lowered against the stale UNBOXED rep. The emitter retires the same write now
// (`narrowRetired`, emit_state.vl), so the two agree and the read lowers.
//
// THE PROPERTY-PATH SPELLING STILL REFUSES (`pathInvalidatedErr`), and the asymmetry is the
// difference in what the emitter can see: a bare-name write is a statement the emit walk
// passes over, while a path narrowing also dies to an ALIASED write through a call, which
// the emitter has no relation to detect.
//
// `narFnEpoch` counts FUNCTION BODIES CHECKED, and every narrowing — bank entry or path
// overlay slot — records the count at install. A closure created inside a guarded region
// reads its capture at the region's NARROWED rep and runs later, so a write that retires
// the narrowing behind it is observed through the capture: `if v != null { const w = () =>
// { print(v + 1) }   v = null   w() }` is check-clean and emits an invalid module without
// this. A mismatch between the recorded epoch and the current one means "a body that may
// have captured this narrowing has been checked since it was installed", and the write
// keeps master's verdict AND master's message — a captured narrowing is exactly the case
// where refusing the write is the sound answer, not an accident.
//
// A closure created BEFORE the guard captured the binding un-narrowed, and its epoch is
// already spent when the narrowing installs, so it does not block the write.
const NAR_KIND_ASG = 0
const NAR_KIND_GUARD = 1
let narFnEpoch = 0
let asgDeclKeys: string[] = []
let asgDeclTys: i32[] = []
let asgDeclDepths: i32[] = []
let asgDeclKinds: i32[] = []
let asgDeclEpochs: i32[] = []
let asgDeclFrames: i32[] = []

// The scope-chain DEPTH of the innermost binding of `name`, or -1 when undeclared.
// `lookup` is the same walk reading the type out; this one reads the frame it came
// from, which is what the narrowing bank validates its entries against.
function lookupDepth(name: string) {
  let i = T.scopes.length - 1
  while i >= 0 {
    if T.scopes[i].has(name) { return i }
    i = i - 1
  }
  -1
}

// The DECLARED type banked for narrowed `name`, or -1 when no live entry of a
// matching kind still shadows the name. `kind` is `NAR_KIND_ASG` /
// `NAR_KIND_GUARD`, or -1 for "either". Entries of the WRONG kind are skipped
// rather than stopping the walk, so a guard narrowing layered over an assignment
// narrowing does not hide it from the assignment-kind question.
function narDeclaredTy(name: string, kind: i32) {
  const d = lookupDepth(name)
  if d < 0 { return -1 }
  let i = asgDeclKeys.length - 1
  while i >= 0 {
    if asgDeclKeys[i] == name && asgDeclDepths[i] == d {
      if kind < 0 || asgDeclKinds[i] == kind { return asgDeclTys[i] }
    }
    i = i - 1
  }
  -1
}

// The DECLARED type of an assignment-narrowed name, or -1.
function asgDeclaredTy(name: string) { narDeclaredTy(name, NAR_KIND_ASG) }

// The bank SLOT of the live guard-kind narrowing of `name`, or -1. Retirement writes
// through this slot, so it must find exactly the entry `narDeclaredTy` reads.
function narGuardSlot(name: string) {
  const d = lookupDepth(name)
  if d < 0 { return -1 }
  let i = asgDeclKeys.length - 1
  while i >= 0 {
    if asgDeclKeys[i] == name && asgDeclDepths[i] == d {
      if asgDeclKinds[i] == NAR_KIND_GUARD { return i }
    }
    i = i - 1
  }
  -1
}

// Bank `name`'s declared type before a narrowing shadows it, at the scope depth the
// shadowing `declare` writes to. Idempotent per (name, depth, kind): a second
// `x = e` must not re-bank the ALREADY-NARROWED type as the declaration.
function noteNarShadow(name: string, declTy: i32, kind: i32) {
  const d = T.scopes.length - 1
  let i = asgDeclKeys.length - 1
  while i >= 0 {
    if (
      asgDeclKeys[i] == name &&
      asgDeclDepths[i] == d &&
      asgDeclKinds[i] == kind
    ) {
      return 0
    }
    i = i - 1
  }
  asgDeclKeys.push(name)
  asgDeclTys.push(declTy)
  asgDeclDepths.push(d)
  asgDeclKinds.push(kind)
  asgDeclEpochs.push(narFnEpoch)
  0
}

// True when `ix` is a bare NAME that an assignment narrowed away from a declared
// type — i.e. a place whose STORAGE can still hold null even though its current
// flow type cannot. The null-TEST legality question, and nothing else.
function isAsgNarrowedName(ix: i32) {
  const n = P.nodes[ix]
  if n is Ident { return asgDeclaredTy(n.identName) >= 0 }
  false
}

// INFERRED TYPE-GUARD functions (A6b, host `guards`): a named function whose
// body is exactly `return <null-test-on-a-param>` becomes a guard — calling it
// in a condition narrows the argument's null-ness. Parallel arrays: the guard's
// name, the tested param's index, and 1 when the non-null branch is THEN
// (`self != null`) / 0 when it is ELSE (`p == null`).
let guardNames: string[] = []
let guardParamIdxs: i32[] = []
let guardThens: i32[] = []

// Record an un-annotated empty-collection binding for the deferred scope-close check.
function notePending(name: string, ty: i32, at: i32) {
  pendNames.push(name)
  pendTys.push(ty)
  pendAts.push(at)
  pendDepths.push(T.scopes.length - 1)
  0
}

// Does type-arena index `ty` still reach an UNRESOLVED collection hole — an empty
// `[]` element (`aElem < 0`) or a bare `Map()`/`Set()` key/value (`mKey`/`mVal < 0`)
// that no annotation or downstream use ever pinned? Mirrors the host's
// `containsUnresolvedHole`, but over the arena's `-1` hole sentinel.
function unresolvedHole(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyArray { return t.aElem < 0 }
  if t is TyMap { return t.mKey < 0 || t.mVal < 0 }
  false
}

// Does `ty` reach an unresolved empty-collection hole (an empty `[]` element or a bare
// `Map()`/`Set()` key/value) THROUGH struct fields / arrays / maps / nullable wrappers —
// the deep analogue of `unresolvedHole`. The rep-twin phase-0a2 gate: an object/array
// LITERAL carrying such a hole is plainly `assignable` to a concrete destination (an empty
// fits any element type), so `assignableExpr`'s plain-assignable short-circuit accepts it
// BEFORE the ObjLit/ArrayLit adoption block runs — the block that records the destination
// rep on the `nodeRepTyIx` sidecar. This predicate re-routes those literals through the
// recorder. Depth-bounded (recursive struct/array types are cyclic in the arena).
function tyReachesEmptyHole(ty: i32, depth: i32): boolean {
  if ty < 0 || depth <= 0 { return false }
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem < 0 { return true }
    return tyReachesEmptyHole(t.aElem, depth - 1)
  }
  if t is TyMap {
    if t.mKey < 0 || t.mVal < 0 { return true }
    return tyReachesEmptyHole(t.mVal, depth - 1)
  }
  if t is TyObj {
    let i = 0
    while i < t.objFieldTypes.length {
      if tyReachesEmptyHole(t.objFieldTypes[i], depth - 1) { return true }
      i = i + 1
    }
    return false
  }
  if t is TyNullable { return tyReachesEmptyHole(t.nInner, depth - 1) }
  false
}

// True when `ty` contains a `TyUnion` reachable through struct fields, array
// elements, map values, or nullable inners. Gates `recordRepTyAdopt` for the
// UNION-SOFTENING adoption case: an ObjLit field value whose self-inferred type is
// a NARROWER member of a destination union field (`{f: "x"}` : `{f: string}` vs the
// destination `{f: f32 | string}`) softens the recorded rep type, so a same-fieldset
// twin (an inner `{f: union}` row interned beside the outer `{f: {f: union}}`) is
// resolved WRONG by `structIndexOfObjCtx`'s ambiguity arm — the softened key matches
// no row and `repRowOfTyStruct` declines. Re-stamping the literal's rep to the union-
// bearing destination corrects it (fuzz sweep uM8vds declared leg, the `mix:` triple-
// nest twin cluster). `TyNullable` is a distinct variant (handled by
// `recordNullHoleObjAdopt`) — this reaches only genuine `TyUnion` softening.
function tyReachesUnion(ty: i32, depth: i32): boolean {
  if ty < 0 || depth <= 0 { return false }
  const t = T.tys[ty]
  if t is TyUnion { return true }
  if t is TyArray { return tyReachesUnion(t.aElem, depth - 1) }
  if t is TyMap { return tyReachesUnion(t.mVal, depth - 1) }
  if t is TyNullable { return tyReachesUnion(t.nInner, depth - 1) }
  if t is TyObj {
    let i = 0
    while i < t.objFieldTypes.length {
      if tyReachesUnion(t.objFieldTypes[i], depth - 1) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// USAGE-DRIVEN INFERENCE through a TYPED context: when an empty `[]` / bare
// `Map()`/`Set()` (open holes) flows into a slot with a concrete shape — a `T[]`
// param at a call site, an annotated assignment (`const ys: i32[] = zs`), or a
// `T[]`-returning tail — PIN the source's open holes to the destination's, in place,
// so the binding is no longer uninferable. Mirrors the host's `constrainElementHole`.
// A no-op unless the source is an array/map with an open hole and the destination
// supplies the matching shape; recurses into element types so a nested empty pins too.
function constrainEmpty(srcTy: i32, dstTy: i32) {
  if srcTy < 0 || dstTy < 0 { return 0 }
  const s = T.tys[srcTy]
  const d = T.tys[dstTy]
  if s is TyArray {
    if d is TyArray {
      if s.aElem < 0 {
        s.aElem = d.aElem
        tyMutEpoch = tyMutEpoch + 1 // in-place element pin — canonical keys change
      } else {
        constrainEmpty(s.aElem, d.aElem)
      }
    }
    return 0
  }
  if s is TyMap {
    if d is TyMap {
      if s.mKey < 0 {
        s.mKey = d.mKey
        tyMutEpoch = tyMutEpoch + 1 // in-place key pin
      }
      if s.mVal < 0 {
        s.mVal = d.mVal
        tyMutEpoch = tyMutEpoch + 1 // in-place value pin
      }
    }
    return 0
  }
  0
}

// Flush every pending binding recorded at scope `depth` (called just before the
// scope is popped, and for the global scope at program end). A binding whose hole is
// still open at this point will never be pinned, so report the unified
// "cannot infer a type" diagnostic — the same wording the host raises.
function flushUninferred(depth: i32) {
  const keepN: string[] = []
  const keepT: i32[] = []
  const keepA: i32[] = []
  const keepD: i32[] = []
  let i = 0
  while i < pendNames.length {
    if pendDepths[i] == depth {
      if unresolvedHole(pendTys[i]) {
        tErr(
          "cannot infer a type for '" + pendNames[i] + "' — add a type annotation",
          pendAts[i],
        )
      }
    } else {
      keepN.push(pendNames[i])
      keepT.push(pendTys[i])
      keepA.push(pendAts[i])
      keepD.push(pendDepths[i])
    }
    i = i + 1
  }
  pendNames = keepN
  pendTys = keepT
  pendAts = keepA
  pendDepths = keepD
  0
}

// ── definite-assignment flow (A-definite-assign) ─────────────────────────────
// Mirrors `compiler/typecheck.ts`'s host analysis (which lives in `parser.ts`):
// an uninitialized `let x: T` (no initializer) starts UNASSIGNED and is non-null,
// so a READ before it is provably written on every preceding path is a "used
// before it is assigned" error — closing the silent-`0` soundness gap
// (`let x: i32; return x` used to compile and return a fabricated 0). The
// declaration is fine; only the read is gated.
//
// `daUnassigned` is the live set of binding NAMES still un-written on the CURRENT
// path (a plain list — the set is tiny, only uninitialized lets in scope). A
// `let x: T` with no initializer adds its name; `x = …` removes it; a read of a
// still-present name errors (and drops it, so the same hole doesn't re-fire on
// every later read). The host keys by `Binding` identity for exact shadowing; VL
// keys by name (innermost-wins like `lookup`/`isConstName`) — sound for the
// subset since the compiler's own source has NO uninitialized lets and no source
// shadows an uninitialized let. Fork/join for `if`/`else` and loops is explicit
// (snapshot/restore/join), modelled on the host. `daWriteTarget` is the node
// index of a plain-`=` LHS Ident currently being evaluated as a WRITE (not a
// read) so the `Ident` arm does not trip use-before-assign on it; a compound
// `x += …` desugars to `x = x + (…)` whose RHS reads `x` and IS checked.
const daUnassigned: string[] = []
let daWriteTarget = -1

// True if `name` is currently in the live unassigned set.
function daIsUnassigned(name: string) {
  let i = 0
  while i < daUnassigned.length {
    if daUnassigned[i] == name { return true }
    i = i + 1
  }
  false
}

// Mark `name` unassigned on the current path (a `let x: T` with no initializer).
function daAdd(name: string) {
  if !daIsUnassigned(name) { daUnassigned.push(name) }
  0
}

// Mark `name` assigned on the current path (a write or a checked read), removing
// it from the live set. Rebuilds the survivors into a temp, then refills the
// global IN PLACE (`.clear()` + push) — the global array reference is never
// reassigned (mirrors the host's `unassigned.delete`, and keeps the self-emitter
// on its supported in-place-mutation path).
function daMarkAssigned(name: string) {
  const keep: string[] = []
  let i = 0
  while i < daUnassigned.length {
    if daUnassigned[i] != name { keep.push(daUnassigned[i]) }
    i = i + 1
  }
  daClear()
  let j = 0
  while j < keep.length {
    daUnassigned.push(keep[j])
    j = j + 1
  }
  0
}

// Empty the live set IN PLACE (never reassigns the global reference).
function daClear() {
  // The self-host emitter lowers `.pop()` (and `.length`) as statements but not
  // `.clear()`, so empty the array in place by popping until empty.
  while daUnassigned.length > 0 { daUnassigned.pop() }
  0
}

// Check a READ of `name`: if still unassigned on this path, report it and drop it
// so the same hole doesn't re-fire on every later read.
function daCheckRead(name: string, at: i32) {
  if daIsUnassigned(name) {
    daMarkAssigned(name)
    tErr("`" + name + "` is used before it is assigned", at)
  }
  0
}

// Snapshot the live unassigned set (a copy), for forking and joining paths.
function daSnapshot() {
  const snap: string[] = []
  let i = 0
  while i < daUnassigned.length {
    snap.push(daUnassigned[i])
    i = i + 1
  }
  snap
}

// Restore the live set from a snapshot (in place — never reassigns the global).
function daRestore(snap: string[]) {
  daClear()
  let i = 0
  while i < snap.length {
    daUnassigned.push(snap[i])
    i = i + 1
  }
  0
}

// Join two surviving paths into the live set: a name is assigned-after-the-merge
// only if it is assigned on BOTH — equivalently it is STILL unassigned if it is
// unassigned on EITHER. So the joined live set is the UNION of the two paths'
// unassigned sets. (`a` is taken as the current live set; `b` is folded in.)
function daJoinInto(b: string[]) {
  let i = 0
  while i < b.length {
    daAdd(b[i])
    i = i + 1
  }
  0
}

// True if the statement at node `ix` ALWAYS exits its enclosing path (so its end
// is unreachable and it contributes nothing to a definite-assignment join). A
// `return`/`break`/`continue` diverges; a `Block` diverges if its last statement
// does; an `if … else …` diverges only if BOTH arms diverge (a chain recurses
// through its `ifElse`). Mirrors the host's `divergesStatement` for the subset.
function daBranchDiverges(ix: i32) {
  if ix < 0 { return false }
  const s = P.nodes[ix]
  if s is RetStmt {
    return true
  } else if s is BreakStmt {
    return true
  } else if s is ContinueStmt {
    return true
  } else if s is Block {
    const st = s.blkStmts
    if st.length > 0 { return daBranchDiverges(st[st.length - 1]) }
    return false
  } else if s is IfStmt {
    if s.ifElse < 0 { return false }
    return daBranchDiverges(s.ifThen) && daBranchDiverges(s.ifElse)
  }
  false
}

// ── missing-return totality (soundness) ──────────────────────────────────────
// The condition node under any `Paren` wrappers (`((x is T))` → `x is T`). The
// condition-SHAPE matchers (chain discrimination, exhaustiveness) peel through this
// so a parenthesized guard classifies exactly like the bare spelling — keeping them
// in agreement with the narrowing collectors, which already peel `Paren`.
function condUnderParens(ix: i32) {
  const n = P.nodes[ix]
  if n is Paren { return condUnderParens(n.parInner) }
  ix
}

// True if the `if`-condition at `ifCondIx` opens a DISCRIMINATING chain — `x is T`, or a
// `place == <literal>` over a literal-union-bearing place. Such an ELSE-LESS chain may be
// EXHAUSTIVE (cover every variant), which the dedicated exhaustiveness check adjudicates;
// the general missing-return rule defers to it rather than double-flagging. Mirrors the
// `isChain` detection in that check.
function ifCondIsDiscriminating(ifCondIx: i32) {
  const fc = P.nodes[condUnderParens(ifCondIx)]
  if fc is IsExpr { return true }
  if fc is BinExpr {
    if fc.binOp == "==" {
      let eqPlace = -1
      if litTyOfExpr(fc.binRight) >= 0 { eqPlace = fc.binLeft }
      else if litTyOfExpr(fc.binLeft) >= 0 { eqPlace = fc.binRight }
      if eqPlace >= 0 {
        const eqObj = P.nodes[eqPlace]
        if eqObj is Ident {
          if isLitBearing(lookup(eqObj.identName)) { return true }
        }
      }
    }
  }
  false
}

// True if executing the node at `ix` always produces a RETURN VALUE or DIVERGES — i.e.
// control never falls off its end without a value. Unlike `daBranchDiverges`, a bare
// trailing VALUE EXPRESSION counts (an implicit return — `!isStmtNode`), so this is the
// totality test for "a non-void function must yield a value on every path". A `Block` is
// total iff its last statement is; an `if`/`else` iff BOTH arms are (an `else if` chain
// recurses through `ifElse`); a `while true { … }` never falls through (diverges or
// returns from inside) so it is total — every other loop / if-without-else / statement
// can complete without a value and is NOT total.
function nodeIsTotal(ix: i32) {
  if ix < 0 { return false }
  const n = P.nodes[ix]
  if n is Block {
    const st = n.blkStmts
    if st.length == 0 { return false }
    return nodeIsTotal(st[st.length - 1])
  }
  if n is RetStmt { return true }
  if n is BreakStmt { return true }
  if n is ContinueStmt { return true }
  if n is IfStmt {
    if n.ifElse < 0 {
      // An ELSE-LESS `if`: a discriminating `is` / literal-equality chain may be
      // EXHAUSTIVE — defer to the dedicated exhaustiveness check (it knows the union's
      // variants). A plain else-less `if` always has a fall-through, so it is NOT total.
      if ifCondIsDiscriminating(n.ifCond) { return true }
      return false
    }
    return nodeIsTotal(n.ifThen) && nodeIsTotal(n.ifElse)
  }
  if n is WhileStmt {
    // `while true { … }` never completes normally — it diverges or returns inside.
    const c = P.nodes[n.whileCond]
    if c is BoolLit { return c.boolVal != 0 }
    return false
  }
  // A bare trailing value expression IS the implicit return.
  return !isStmtNode(ix)
}

// True if `name` resolves (innermost-first) to a `const` binding.
function isConstName(name: string) {
  let i = T.scopes.length - 1
  while i >= 0 {
    if T.scopes[i].has(name) {
      if i < constScopes.length { return constScopes[i].has(name) }
      return false
    }
    i = i - 1
  }
  false
}

// Well-known primitive type-arena indices, pinned by `initChecker` so the hot
// primitives are interned once (not re-pushed per use). `-1` until initialized.
export let TY_I32 = -1
let TY_I64 = -1
let TY_F64 = -1
let TY_F32 = -1
let TY_BOOL = -1
let TY_STR = -1
let TY_VOID = -1
let TY_ERR = -1
let TY_NULL = -1
// `never` — the EMPTY type (host `Never`): what an intersection of disjoint
// concrete types folds to. The bottom type: assignable to anything, nothing
// (but itself / err) assignable to it.
let TY_NEVER = -1

// ── type-arena constructors ──────────────────────────────────────────────────
// Each appends a variant to `T.tys` and returns its index. (The same shape as the
// AST's `mk*` constructors, for the parallel arena.)

function addTy(t: Ty) {
  T.tys.push(t)
  T.tys.length - 1
}

function mkPrim(name: PrimName) {
  const t: Ty = { primName: name }
  addTy(t)
}

function mkErrTy() {
  const t: Ty = { errKind: 0 }
  addTy(t)
}

export function mkObjTy(names: string[], typeIxs: i32[]) {
  const t: Ty = { objFieldNames: names, objFieldTypes: typeIxs }
  addTy(t)
}

function mkFuncTy(params: i32[], ret: i32) {
  const t: Ty = { fnParamTypes: params, fnRet: ret }
  addTy(t)
}

function mkUnionTy(members: i32[]) {
  const t: Ty = { uMembers: members }
  addTy(t)
}

function mkNullableTy(inner: i32) {
  const t: Ty = { nInner: inner }
  addTy(t)
}

export function mkArrayTy(elem: i32) {
  const t: Ty = { aElem: elem }
  addTy(t)
}

function mkMapTy(key: i32, val: i32, isSet: i32) {
  const t: Ty = { mKey: key, mVal: val, mSet: isSet }
  addTy(t)
}

// THE ONE HOME of "which HASH does a `Map`/`Set` key take" — the map rep has exactly
// two, `string` (hashed element-wise, `__str_hash__`) and `i32` (hashed by the integer
// mix). Answers the arena type the keys are hashed AS (`TY_I32` / `TY_STR`), or -1 for
// a key the rep cannot hold. Every gate — the two annotation gates (`tsToTy`'s `TS_MAP`,
// `nameToTyReal`'s map arm), the usage-driven pin (`checkInferredMapKey`) and the two
// emitter key-rep predicates (`nodeTyMapKeyIsI32`, `emit_rep.tyMapKeyIsI32`) — projects
// this one answer, so the checker and the emitter cannot disagree about which hash a
// map takes.
//
// THE TEST IS THE LOWERING, NOT THE SPELLING. Index equality against `TY_I32`/`TY_STR`
// read the spelling: a nominal newtype is minted as a SECOND arena index over the SAME
// `Ty` value (`newtype-design.md` §3) and is erased before the emitter runs, so
// `{[Id]: V}` over `type Id = new i32` hashes byte-for-byte as `{[i32]: V}` — yet the
// index compare refused it, and refused it in BOTH spellings (the annotation and the
// `m[k] = v` pin), which made an annotation that restates what inference already knows a
// reject. `tyPrimNameOf` is structural and peels a one-member union wrapper, so the
// brand, the transparent alias and the alias-of-an-alias all reach their base here.
//
// A LITERAL UNION is deliberately NOT admitted, and it is not an oversight: a NAMED
// string litunion reps as an interned i32 ATOM while its own spelling stays `K` at emit
// (`numLitUnionBaseName` excludes the string base for exactly this reason), so the two
// halves of a `{[K]: V}` map would disagree about the hash — the key expression lowers
// as an atom and the map struct resolves string-keyed. That is a silent wrong answer,
// strictly worse than the reject; admitting it needs the key RENDER and `.keys()`'s
// element type to move together.
export function mapKeyRepTy(k: i32) {
  if tyIsPrimNamed(k, "i32") { return TY_I32 }
  if tyIsPrimNamed(k, "string") { return TY_STR }
  -1
}

// The DECISION form of `mapKeyRepTy` — "can the map rep hash this key at all". The
// caller that says no resolves the annotation to -1 and reports the unsupported-key
// diagnostic (`checkLetDeclNode`, `checkInferredMapKey`).
export function mapKeyTySupported(k: i32) { mapKeyRepTy(k) >= 0 }

function mkTyVar(name: string) {
  const t: Ty = { tvName: name }
  addTy(t)
}

// The CANONICAL decimal form of an integer literal LEXEME (`0x10` → `16`,
// `1_000` → `1000`, `007` → `7`), so literal-type identity compares VALUES,
// not raw source spellings — `0x10` is a member of `16 | 32`. A lexeme whose
// value exceeds the i32 range keeps its raw spelling (an i64-sized literal
// never denotes a literal-union member; identity then stays textual, exactly
// as before).
function canonIntLexeme(t: string) {
  if !intLexemeFitsI32(t) { return t }
  let v = 0
  let i = 0
  let base = 10
  if t.length >= 2 && t[0] == '0' {
    const p = t[1]
    if p == 'x' || p == 'X' {
      base = 16
      i = 2
    } else if p == 'b' || p == 'B' {
      base = 2
      i = 2
    } else if p == 'o' || p == 'O' {
      base = 8
      i = 2
    }
  }
  while i < t.length {
    const c = t[i]
    if c != '_' {
      let d = 0
      if c >= '0' && c <= '9' { d = c - '0' }
      else if c >= 'a' && c <= 'f' { d = c - 'a' + 10 }
      else { d = c - 'A' + 10 }
      v = v * base + d
    }
    i = i + 1
  }
  i32ToStr(v)
}

function mkLitTy(kind: LitKind, text: string) {
  let canon = text
  if kind == "int" { canon = canonIntLexeme(text) }
  const t: Ty = { litKind: kind, litText: canon }
  addTy(t)
}

// The ARENA type of one LITERAL-MEMBER LEXEME — `"a"` → the `str` literal type, `1.5` →
// `flt`, `0x10` → `int` — or -1 when `name` does not begin a literal member at all.
//
// THE one home for that lexeme grammar. `nameToTy`'s annotation resolver and
// `canonEmitName`'s literal arm each wrote it out, and because canon had no arena type to
// hand back, the emit-name side carried a SECOND copy of the base-scalar rule as well
// (`litBaseName`, the spelling twin of `litBaseTy`). Routing canon here retires both
// copies: the arm asks for the TYPE and lets the renderer name it.
//
// This is a LEXEME operation, not type-grammar parsing — the quote / leading-digit test is
// what decides the name is a literal at all, and the slice that follows recovers the member
// TEXT, the exact inverse of the `"\"" + litText + "\""` every literal render writes.
function litMemberTy(name: string) {
  if name.length == 0 { return -1 }
  // A STRING-LITERAL type `"a"` — the quoted lexeme is the member; keep the RAW inner
  // text (the literal expression side keeps its raw lexeme too, so membership compares
  // the same characters).
  // The GROUP-INTERIOR cut at its home (`tyname.groupInnerOf`, W1) — the `"…"` quoted
  // member is one of the three delimiters that family names, and the quote TEST stays
  // here because the home is delimiter-blind by design (its header records why) — and the
  // quote TEST is `tyname.nameIsQuotedLeaf` (W3), the other half of the `"` alphabet. Its
  // bound is the `name.length == 0` early return two lines up, not the home's: the home
  // carries none.
  if nameIsQuotedLeaf(name) { return mkLitTy("str", groupInnerOf(name)) }
  // A NUMERIC-LITERAL type (`0`, `1.5`): int vs float by the `.`.
  if name[0] >= '0' && name[0] <= '9' {
    if hasDot(name) { return mkLitTy("flt", name) }
    return mkLitTy("int", name)
  }
  -1
}

function mkNegTy(inner: i32) {
  const t: Ty = { negTy: inner }
  addTy(t)
}

// ── return-type inference state (module globals, reset by initChecker) ────────
// An un-annotated function's hoisted return type is the PENDING sentinel `-2`
// until its body is checked. `fnDeclIx` maps a top-level function name to its
// FuncDecl arena index so a forward call can infer the callee ON DEMAND;
// `inferStack` is the in-progress set (cycle detection); `inferObserved` /
// `inferSawErr` accumulate what a pending body's `return`s / trailing expression
// yielded (first concrete type wins; an in-cycle call contributes only "err").
let fnDeclIx: {[string]: i32} = Map()
// ── free index operators (B14) ───────────────────────────────────────────────
// Every `function "[]"(self: T, …)` / `function "[]="(self: T, …)` the program
// declares, as the operator it implements and the (receiver-carrying, possibly
// merge-mangled) name it declared under — collected by the top-level hoist, so
// the registry describes the MERGED program and needs no cross-module alias.
//
// DISPATCH IS BY THE RECEIVER'S TYPE, not by its spelling: a candidate wins when
// the receiver is `assignable` to its `self` parameter, the same test UFCS
// resolution uses. That is what makes two views over one structural shape
// dispatch apart — their nominal brands are the only difference, and `assignable`
// is where the brand rule lives.
let opIdxOps: string[] = []
let opIdxFns: string[] = []
// The RESOLVED operator function for one index SITE, keyed by the node the
// checker resolved it at (an `Index` for a read, the assignment `BinExpr` for a
// write) and read back by the emitter's dispatch rewrite, so the two never
// re-derive the choice independently. SPARSE — a program that declares no index
// operator banks nothing, which is this feature's inertness statement.
let opIdxSiteNode: i32[] = []
let opIdxSiteFn: string[] = []
let inferStack: string[] = []
let inferObserved = -1
let inferSawErr = false
// The VALUE type of the most recently checked Block — its trailing expression's type
// (the block's implicit-return value), or TY_VOID when the block ends in a statement.
// `checkNode(Block)` itself returns TY_VOID (a block is a statement); this carries the
// tail value out-of-band so an `if … { v } else { w }` EXPRESSION can join its branch
// values. Read immediately after a `checkNode(block)`.
let blockTailTy = -1
// True while checking a node whose VALUE is the enclosing function's return (an
// implicit-return tail position): the function-body tail statement, and — propagated —
// the tail of each branch of a tail `if`/`else`. Gates seeding `inferObserved` from a
// branch value so a base-case branch pins the type before a recursive sibling branch is
// checked (`if n<2 { n } else { rec(n-1)+rec(n-2) }`), WITHOUT a non-tail `if`'s branch
// values polluting the inferred return.
let retTailPos = false

// Every top-level (module-scope) `let`/`const` NAME, hoisted in pass 1.5 so a
// function body — checked in pass 2 OR pulled early by demand-inference — resolves
// it regardless of source order, exactly as it already resolves a top-level
// function. Membership also drives the pass-2 redeclare-error skip (the hoist owns
// the canonical declaration). Reset per compile in initChecker.
let moduleGlobals: {[string]: boolean} = Map()

// Recursive return-type inference (binding-group fixpoint). A function whose return
// only becomes knowable AFTER a recursive cycle resolves can't be inferred in one
// demand pass — the cycle-break commits a provisional `void`. So a SUPPRESSED
// return-inference PRE-PASS resolves every un-annotated return BEFORE the real check
// pass, iterating the cycle-poisoned ("tentative") functions to a fixpoint. This is
// standard SCC binding-group inference, realized lazily through the existing demand
// inference (the demand call stack IS the dependency-order traversal). `bodyChecked`
// lets the real pass still check each body once (the pre-pass only resolved types).
let topUnannotFns: i32[] = []
// The top-level statement list, captured at `checkProgram` entry so the return-inference
// floor can reverse-map an inferred struct-union's object members to named types
// (`structUnionRetName`) — the floor must accept EXACTLY the unions the emitter can
// lower (all members named), so it uses the same predicate as the export.
let gRootStmts: i32[] = []
// A20: parallel arrays (name -> inferred concrete return-type name) for each
// un-annotated top-level function, exported for the emitter so it can classify a
// return from the inferred TYPE rather than re-deriving from the return expression
// (which misses a plain-variable return). Kept OUT of the AST `fnRet` so `fmt` never
// re-adds the annotation. A string-VALUED map would do, but a `{[string]: string}`
// with `?? ""` mis-lowers (nullable-ref vs ref), so the TYPE stays in arrays. Reset per compile.
let inferRetFn: string[] = []
let inferRetTy: string[] = []
// #1057 — the TOP-LEVEL ATOM COUNT of the recorded name, parallel to `inferRetTy`. The
// emitter's anonymous-nominal residual (`registerInferRetNominalUnion`) asks "did this
// recorded name spell a UNION" and answered by RE-SPLITTING the name it had just been
// handed; the recorder banks the answer instead, and the consumer is a lookup.
//
// The FIRST attempt at this column walked the recorded ARENA type's union/nullable spine
// (`retMemCountOf`) and was REFUTED in `registerInferRetNominalUnion`'s own comment: a
// litunion member renders as ONE atom (its ALIAS) while the spine walk counts its literal
// members, so the two disagree on `K0 | null` — and in the other direction a bare `K0`
// return renders one atom while the walk counts >= 2, which would register a union this
// compiler does not register. The count belongs to the NAME PRODUCER (how many atoms it
// joined), not to a walk of the type it rendered. `recordInferRet` is the single funnel
// every producer's name lands in, so the count is banked there, on the very string the
// consumer would have split. -1 is unreachable by construction (every push records).
let inferRetAtomCount: i32[] = []
// The TOP-LEVEL atom count of the name the LAST inferred-return name producer returned —
// the number `unionMemberCount` would report for it, produced BY THE PRODUCER THAT JOINED
// IT instead of re-derived by scanning the finished string (#1115, the `emitNameAtoms`
// discipline of #1113 applied to the inferred-return funnel).
//
// The contract every producer honours: **write this immediately before each NON-EMPTY
// return** (`irAtoms` / `irRendered` do it in one expression). Writing only on the
// non-empty returns is what makes the ladder in `checkFuncDeclNode` total without an
// entry-reset: the rungs short-circuit, so the LAST producer to return non-empty is the
// one whose name is recorded, and every earlier rung's "" (however much its own nested
// calls churned this scalar) is overwritten by the winner.
//
// Not an arena-lifetime sidecar (method note 7): a scalar written on the way out of a
// call and read by the immediate caller, never carried between programs.
let inferRetNameAtoms = 1

// Hand back inferred-return name `nm` and report that it is `atoms` top-level atoms wide.
// The producers' way of returning a second value: VL has one return slot, and the width is
// free at the `|` join that built the name.
// ── THE RUNG COLUMN (destringify B26/B27) ────────────────────────────────────
// WHICH PRODUCER answered for a recorded inferred-return row. The lambda cascade is ~28
// short-circuiting producers and the one that answers non-empty IS the decision — but the
// decision was thrown away and every consumer re-derived it by running character predicates
// over the NAME the producer had built. `synthRetAnnots` alone runs up to 25 of them.
//
// Banking it is the same move #1057/#1112/#1115 made for the atom COUNT and #1113 for the canon
// WIDTH, at the same funnel: the producer knows, so the producer records.
//
// THE FALL-THROUGH IS NOT A PRODUCER and gets its own code rather than 0-by-omission — B26
// numbered it 0 and spent a measurement discovering that "no rung" and "rung 0" are different
// claims. `IR_RUNG_NONE` means the `recordable` path (`anm`, the SPACED `tyToStructStr` render),
// which admits three unrelated shapes through one `||`. Those three now carry their own codes
// (the `IR_REC_*` band below), so a fall-through row says WHICH gate admitted it.
//
// The cascade's INITIALIZER (`unm = sfbNm`) is a producer despite not being spelled
// `if unm == ""`, and B27 found it banked at 0 with the fall-through, which is what made an
// earlier entry attribute two of `synthRetAnnots`' arms to the wrong source. It is `IR_RUNG_SFB`.
const IR_RUNG_NONE = 0 // the `recordable` fall-through — determines nothing
const IR_RUNG_SFB = 28 // `structFieldBoxRetName`, the cascade's initializer
// Rungs 1..27 are the `if unm == ""` producers in source order. 28 and 29 are OUT OF BAND on
// purpose — 28 is the cascade's initializer (not an `if unm == ""` rung at all) and 29 is a
// second LEG of rung 8's producer, not a new cascade position. A future cascade producer takes
// the next in-band number by renaming, never by renumbering; a future extra leg takes 30.
// EVERY producer has a NAME, none is a bare literal at its call site. The predicate below is a
// POSITIONAL claim — that 6 and 7 are `nullableRetName` and `nulLitUnionRetName` — so inserting a
// producer mid-cascade must be a mechanical rename here, never a silent renumber that would
// misfire it with no compile error and no test failure.
const IR_RUNG_STRUCT_MAP_FIELD = 1
const IR_RUNG_STRUCT_PLAIN = 2
const IR_RUNG_VALUE_UNION = 3
const IR_RUNG_LITUNION_ARR_VU = 4
const IR_RUNG_STRUCT_UNION = 5
const IR_RUNG_NULLABLE = 6
const IR_RUNG_NUL_LITUNION = 7
const IR_RUNG_NUL_ELEM_LIST = 8
// `nulElemListRetName` IS TWO PRODUCERS IN ONE BODY, and this is the second. Its numeric leg
// (`(f64|null)[]` &c) renders a value-union box and is claimed by `synthRetAnnots`' arm 4; its
// NICHE legs (`(boolean|null)[]`, `(string|null)[]`, `(K|null)[]`) render shapes that arm's
// predicate deliberately REJECTS — `parenUnionArrElemName` carries the same three-way split,
// inverted, in its `nameIsNulBool` / `nameIsNulString` / `nameIsNulLitUnion` guards — so they
// reach no arm at all and stay unpinned.
//
// B26 called this "the one producer whose output does not determine the consumer's arm" and said
// it needed its own discrimination. B27 corrected that: the discrimination already exists, in the
// consumer, and all this needs is for the two legs to say which they are. Splitting the code is
// the whole fix.
const IR_RUNG_NUL_ELEM_LIST_NICHE = 29
const IR_RUNG_NUL_STRUCT_ELEM_LIST = 9
const IR_RUNG_NUL_MAP_ELEM_LIST = 10
const IR_RUNG_NUL_LIST_ELEM_LIST = 11
const IR_RUNG_ELEM_VU_LIST = 12
const IR_RUNG_ELEM_VARIANT_BOX_LIST = 13
const IR_RUNG_ELEM_MAP_UNION_LIST = 14
const IR_RUNG_ELEM_REFARM_VU_LIST = 15
const IR_RUNG_NESTED_ELEM_UNION_LIST = 16
const IR_RUNG_STRUCT_FIELD_BOX_ELEM_LIST = 17
const IR_RUNG_STRUCT_ELEM_LIST = 18
const IR_RUNG_NUL_CLOSURE_ELEM_LIST = 19
const IR_RUNG_CLO_ARM_VU = 20
const IR_RUNG_MAP_UNION = 21
const IR_RUNG_REFARM_UNION = 22
const IR_RUNG_VARIANT_BOX = 23
const IR_RUNG_NESTED_LEAF_LIST = 24
const IR_RUNG_MAP_ELEM_LIST = 25
const IR_RUNG_LITUNION_ELEM_LIST = 26
const IR_RUNG_LITUNION_ALIAS = 27

// ── THE FALL-THROUGH'S THREE GATES ───────────────────────────────────────────────────────────
// NOT PRODUCERS, which is why they are not rungs. `recordable` admits three unrelated shapes
// through one `||`, so banking 0 for all three said only "not a producer" — the conflation B26
// spent a measurement discovering. These name WHICH GATE admitted the row.
//
// THEIR OWN BAND (>= 40), so the in-band cascade numbering (1..27) and the out-of-band
// producer/leg numbering (28 initializer, 29 second leg, next leg 30) never have to step over
// them. A future gate takes 43; a future leg still takes 30.
//
// THE THREE ADMITTED SETS ARE PAIRWISE DISJOINT ON EVERY INPUT, not merely on reached ones:
//   · scalar-list vs classifiable — `arrElemNameRaw` is a function, and {i32,string} is disjoint
//     from {i64,f32,f64}; the six bare-leaf spellings fail `nameIsArray` so the cut yields "".
//   · obj-shape vs either array leg — one requires a final `]`, the other a final `}`.
//   · obj-shape vs the bare leaves — none of them opens with `{`.
// So no tie-break rule is needed and the `||` order is NOT load-bearing. It is preserved anyway,
// so this split asserts nothing about it. If a future change WIDENS any gate, disjointness must
// be re-argued rather than assumed.
const IR_REC_CLASSIFIABLE = 40 // `isClassifiableRetName` — NOT "scalar": it admits `i32[]`/`string[]` too
const IR_REC_OBJ_SHAPE = 41 // `isObjShapeName`
const IR_REC_SCALAR_LIST = 42 // `isScalarListRetName`
// The NAMED-function loop is a SECOND cascade over the same producers, and it must bank the same
// codes: a rung identifies the PRODUCER, not the cascade it was reached through. Leaving it
// unbanked made every named row read `IR_RUNG_NONE` — "no producer answered" for rows where one
// plainly did — which is exactly the fall-through conflation B26 hit and B27 named. It is
// unobservable today (`synthRetAnnots` looks rows up by NODE key and named rows are keyed by
// function name), and it would have been a trap for the next arm converted.

let inferRetNameRung = IR_RUNG_NONE
// `let`, not `const` — it is RESET PER PROGRAM beside the other `inferRet*` columns. Declaring
// it `const` made it the only column that survived `initChecker`, so row indices from a previous
// program shifted every lookup: 20 suite failures that each PASSED in isolation, because a single
// compiler instance compiling many programs is the only place the leak is visible.
let inferRetRung: i32[] = []

// Record the rung that answered. Applied to the RESULT so the cascade stays short-circuiting —
// the producers have side effects (several register unions) and must not be called eagerly.
function irRung(rung: i32, nm: string): string {
  if nm != "" { inferRetNameRung = rung }
  nm
}

// `irAtoms` for a producer that reports its own RUNG — used where one function body is really two
// producers and the cascade's single `irRung` wrap cannot tell them apart. The cascade must NOT
// also wrap such a producer, or its code would overwrite the leg's.
function irAtomsRung(nm: string, atoms: i32, rung: i32): string {
  inferRetNameAtoms = atoms
  inferRetNameRung = rung
  nm
}

function irAtoms(nm: string, atoms: i32): string {
  inferRetNameAtoms = atoms
  return nm
}

// `irAtoms` for a name that IS a `tyToEmitName` render: adopt the RENDERER's own reported
// width (`emitNameAtoms`, #1113). Written as a call so the render is evaluated BEFORE
// `emitNameAtoms` is read, with no dependence on argument evaluation order.
function irRendered(nm: string): string {
  inferRetNameAtoms = emitNameAtoms
  return nm
}
// The ARENA-INDEX sibling of `inferRetTy` (parallel array): the `Ty`-arena index of each
// recorded inferred return type, so the emitter's `collectU` inferred-return loop can drive
// the STRUCTURAL arena walks (`collectTyReachRegister` / `collectTyReachCloSigs`) off the
// resolved type — covering unions/closures reachable through an INFERRED return that the
// `registerInlineUnion(inferRetTyAt)` NAME walk (rendered-name-driven) does not surface. Per
// the #1046 inferred-variant-box work this is 0-growth redundancy over the name walk (verified
// by the register/sig-growth oracle), a step toward retiring the name walks. `-1` when the
// recorder had no arena index (falls through the walks harmlessly).
let inferRetTyIx: i32[] = []
// Name → its FIRST index in the arrays, so the hot `inferRetNameOf` is an O(1) map lookup
// instead of a linear scan (it was ~6% of self-compile time). An i32-VALUED map (the well-
// supported `{[string]: i32}` path — the string-valued map above mis-lowers), kept in sync via
// `recordInferRet`. FIRST-wins, matching the old scan. The arrays stay for the emitter's INDEXED
// access (`inferRetCount`/`inferRetTyAt`) and to hold the string type the map can't.
let inferRetIdx: {[string]: i32} = Map()
// The binding analogue of `inferRetFn`/`inferRetTy`: an un-annotated `const`/`let`
// whose INFERRED type is a value union is recorded by its LetDecl NODE INDEX, so the
// emitter classifies + lowers it like an annotated nullable/value-union binding even
// when the initializer is one it can't statically classify (an `if`-expression with an
// ident/expression arm). Captured DURING the check (scope live), keyed by node index.
let inferLetIx: i32[] = []
let inferLetTy: string[] = []
// The NICHE analogue of `inferLetIx`: an un-annotated `const x = if c then "hi" else
// null` infers `string | null`, which is a niche ref rep (`ref.null $aTypeIdx`), NOT a
// value-union box — so `valueUnionRetName` renders "" and the `inferLetIx` table skips
// it. Record such bindings by LetDecl NODE INDEX so the emitter's `letIsNulString`
// classifies the slot as the kind-16 nullable-string rep and reuses the annotated
// `string | null` if-binding lowering. No name is needed (the niche is monomorphic).
let inferLetNulStrIx: i32[] = []
// The `boolean | null` companion of `inferLetNulStrIx` — the other niche scalar
// nullable (an i32 0/1 with sentinel 2 = null). Same recording discipline: an
// un-annotated `const x = if c then true else null` by LetDecl NODE INDEX, so the
// emitter classifies the slot as the niche i32 rep and reuses the annotated lowering.
let inferLetNulBoolIx: i32[] = []
let bodyChecked: {[string]: boolean} = Map()
// TYPED-IR FOUNDATION: node index → resolved type-arena index, recorded for EVERY node on
// the real (non-quiet) check pass so the EMITTER can consume the checker's already-computed
// type instead of re-deriving it syntactically from the AST (the per-kind `letIs*`/`expr*`
// predicate ladders). A flat table sized to the node arena at `checkProgram`. Nodes the
// emitter SYNTHESIZES after checking (monomorphized instance bodies) fall past the end and
// read back -1 via `nodeTyIxOf`, so a consumer falls back to its syntactic path there.
let nodeTyIx: i32[] = []
// `is`-TEST TYPE sidecar: the arena type an `IsExpr`'s CHECK type resolves to, keyed by the
// `IsExpr` node. `checkIsExprNode` already resolves it (`isTypeTy`, from the node's own
// SPELLING TREE) to enforce the variant-membership rule, so the emitter's narrowing stack banks
// THE ANSWER instead of re-deriving the narrowed type by picking apart the tested SPELLING.
// Sized with `nodeTyIx` and read through `isVarTyIxOf`, so an emitter-synthesized
// (monomorphized) `is` node falls past the end, reads -1, and its consumer keeps the name path.
let isVarTyIx: i32[] = []
// CONTEXT-RESOLVED type sidecar (rep-twin-matcher phase 0a): parallel to `nodeTyIx`, this table
// records — at the arena-pure coercion/ADOPTION sites — the DESTINATION (context) type a literal
// node was widened INTO, which the emitter actually builds the rep for. `nodeTyIx` holds the
// checker's NAIVE self-inferred type (`{f: boolean}` for a `{f: boolean}` literal), and it stays
// untouched for its existing consumers; the emitter's rep/layer keying reads `nodeRepTyIxOf`, which
// returns the recorded context type when present and falls back to `nodeTyIxOf` otherwise. Recorded
// for the union-box / nullable-niche / i32→i64 adoptions where the literal's built rep is the
// destination (a `{f: boolean}` return adopted to `{f: boolean | {w: i32}}`), recursively into
// fields/elements exactly where the adoption recursion goes (`tyDeeperThan`-guarded for recursive
// types). NOTHING consumes it in this phase — the recorder is byte-identical.
let nodeRepTyIx: i32[] = []
// ANNOTATION ATOM-COUNT sidecar (#1055): how many TOP-LEVEL union atoms the annotation
// node's EMIT-TIME spelling is joined from, banked BY THE PRODUCER OF THAT SPELLING.
//
// `canonEmitTypeNames` is that producer — it rewrites every `TypeRef`'s `tyName` into the
// emitter's vocabulary at the end of `checkProgram`, and `compileSrc` hands the SAME arena
// to `emitProgram`, so the name it writes is the name every emitter consumer reads. The
// emitter used to re-derive the count by SPLITTING that rendered name back apart
// (`registerCollapsedUnionName`); it now reads the number the producer already knows.
//
// Why the count cannot be recovered from the arena: an annotation whose members are
// SAME-SHAPE declared structs (`A | B` with `type A = {v: i32}` / `type B = {v: i32}`)
// resolves through `nameToTy`'s union arm, where `sameVariantTy` DEDUPS the two members
// to one and the whole union collapses to a plain `TyObj`. After that collapse the arena
// holds a struct, not a union, and "the source spelled a union" survives only in the
// spelling. (`retMemCountOf`'s arena-spine walk was the refuted attempt at the sibling
// question — see `recordInferRet`.)
//
// One entry per NODE (not per name): -1 for a node that is not a `TypeRef`, so a
// consumer's `>= 2` test reads exactly what `splitUnionAtoms("")` gives it (1 atom, no
// union) at a non-annotation node. Sized to the node arena and rebuilt inside
// `canonEmitTypeNames`, which runs unconditionally on every checked program, so the
// sidecar's lifetime is the program's.
let annUnionAtoms: i32[] = []
// NOMINAL-IDENTITY sidecar (C1): the `Ty`-arena indices of DECLARED STRUCT types (`cStructTyIxs`)
// and of UNION-VARIANT MEMBER types (`cVariantMemberTyIxs`). A struct annotation's node reads
// `nodeTyIsStruct` = "its recorded type IS a declared struct and NOT a variant member" — the emitter's
// nominal classifier then confirms structurally instead of an O(nodes) `nameIsStructDecl` AST scan.
// The arena stays purely STRUCTURAL (`TyObj` has no name); nominal-ness is checker metadata, not a Ty.
let cStructTyIxs: i32[] = []
// The declared NAME of each `cStructTyIxs` entry (parallel array), so a declared-struct
// arena index resolves back to its alias name — the reverse map `cUnionTyIxs`/`cUnionNames`
// already give unions. Used by the NAME-FAITHFUL renderer (`tyToNominalName`) to render a
// nominal struct as its NAME rather than a structural `{…}` expansion, so an arena walk
// reproduces the name walk's registration keys (rep-adoption name-faithful-renderer slice).
let cStructNames: string[] = []
let cVariantMemberTyIxs: i32[] = []
// Declared UNION-ALIAS `Ty` indices (`type T = A | B`), for the emitter's `isUName` (C1).
let cUnionTyIxs: i32[] = []
// The declared NAME of each `cUnionTyIxs` entry (parallel array), so a union type index can
// resolve back to its alias name — used to pin an anonymous lambda's litunion return as the
// ALIAS (an inline litunion spelling reps as a string ref, so the alias name is required).
let cUnionNames: string[] = []
// GENERIC-APPLICATION NOMINAL sidecar (typed-IR P1). The third reverse map in the
// `cStructTyIxs`/`cUnionTyIxs` family, and the record #1267 measured missing: the arena
// knows what `Box<i32>` EXPANDS to and nothing at all about the fact that an application
// was written, so the nominal renderer had no route back to `Box<i32>` and produced the
// structural `{value: i32}` instead — 114 of the 194 cells where `tyToNominalName ∘
// nameToTy` disagrees with `canonEmitName`, the single largest class in that residue.
//
// `applyGenAliasArgs` is the site with both halves in hand. It MEMOIZES the expansion per
// `(head, argument type indices)` and mints a fresh `TyObj` per distinct application, and
// the arena does not intern (`addTy` always pushes), so the recorded index belongs to that
// application and to nothing else — an inline `{value: i32}` written elsewhere in the same
// program gets its own index and is never claimed by this map.
//
// A NAME IS A NAME: the head is genuine nominal identity (the emitter's own `gaeBases`
// registry is keyed by that declared name), so storing it as a string is not the disease.
// The ARGUMENTS are stored as ARENA INDICES, not as a spelling — the renderer recurses
// through them, so nothing here has to be parsed back.
let gaAppTyIxs: i32[] = []
let gaAppHeads: string[] = []
// The arguments of each `gaAppTyIxs` entry, flattened: entry `i` owns
// `gaAppArgFlat[gaAppArgStart[i] .. + gaAppArgCount[i]]`. Same flat-slice shape as the
// `gaParamNames`/`gaParamStart`/`gaParamCount` triple this file already uses for the
// declaration side.
let gaAppArgStart: i32[] = []
let gaAppArgCount: i32[] = []
let gaAppArgFlat: i32[] = []
// Per-row finiteness memo for the reader's cycle guard: -1 unknown, 0 the expansion is
// CYCLIC (decline — see `tyReachesSelf`), 1 finite.
let gaAppFinite: i32[] = []
// The names of one-member `type N = A` aliases whose single variant is spelled as a bare
// type NAME or a generic APPLICATION (`type MyCat = Cat`, `type Y = Box<i32>`) — recorded
// SYNTACTICALLY in pass 0a, before any variant resolves. The parser encodes every
// non-`{`-bodied `type N = …` as a one-member `UnionDecl`, and the arena cannot tell such an
// alias from a canonicalized object INTERSECTION (`type AB = {a} & {b}`, also a one-member
// union over one `TyObj`) — only the spelling can. The intersection's merged shape must keep
// its alias NAME (the emitter interns it as a named struct via `unionStructAliasShape`);
// a plain alias-reference must be TRANSPARENT instead (see `aliasRefIsPlainRoot`).
let cPlainAliasNames: string[] = []

// ── the declaration FILL registry (pass 0a / 0b) ─────────────────────────────
// `cUserTypes` gets a declaration's PLACEHOLDER in pass 0a and its SHAPE in pass 0b, so a
// name resolved between the two answers from an EMPTY arena entry. That is not a missing
// diagnostic, it is a WRONG TYPE: `declaredTyOfName`'s transparency collapse
// (`singleAliasMemberTyIx`) needs the alias's one member to be present, so an unfilled
// `type Flag = boolean` hands back the union WRAPPER, and the struct field that named it
// keeps a one-member `TyUnion` where the declaration denotes `boolean`.
//
// These three columns make the fill DEMAND-ORDERED. `cFillStmtIx` maps a declared type
// name to its declaration statement (LAST wins, exactly as `cUserTypes` does for a
// redeclared name); `cFillDoneAt` is the set of arena entries already filled, keyed by
// ARENA INDEX so two declarations sharing one placeholder still fill it once;
// `cFillActive` is true only while pass 0b runs, so no later pass — and not the emitter,
// which re-resolves names long afterwards — can re-enter the fill.
//
// `cFillDoneAt` is a FLAG COLUMN INDEXED BY the arena index (1 == filled), not a list of
// the filled indices: the membership question is asked once per declaration and the list
// grows once per declaration, so a scan would be O(#typedecls²) over the whole pass.
// Indexing is available because `addTy` appends without interning, so a placeholder's
// arena index is dense and unique to it. The KEY is unchanged — arena index, never name —
// which is what keeps a redeclaration filling one placeholder exactly once.
let cFillStmtIx: {[string]: i32} = Map()
let cFillDoneAt: i32[] = []
let cFillActive = false
// NOMINAL NEWTYPE sidecar (webcraft P1.5 / A14) — the fourth member of the
// `cStructTyIxs` / `cUnionTyIxs` / `gaAppTyIxs` family, and built to the same rule:
// the arena stays STRUCTURAL and nominal-ness is a column beside it.
//
// `nwDeclNames` is the DECLARATION fact — the names written `type N = new …`,
// recorded in pass 0a. `nwTyIxs`/`nwNames`/`nwBaseTyIxs` are the arena-index
// sidecar: index `nwTyIxs[i]` carries the brand `nwNames[i]` and is structurally
// the type at `nwBaseTyIxs[i]`.
//
// A BRAND IS A NAME, and that is the whole representation: a branded index is a
// second index over the SAME `Ty` payload (`addTy(T.tys[base])`), so every
// structural question — rep, width, field lookup, `is TyPrim` — answers exactly
// as the base answers, and only `assignable`/`tyEq`/the binary-operator mixing
// rule consult the column. That is what makes the type ZERO-COST: there is no
// wrapper for the emitter to unwrap, and the emitter never learns the name at all
// (canon's alias-transparency arm has already rewritten the annotation).
// `docs/internals/newtype-design.md` is the design record.
let nwDeclNames: string[] = []
let nwTyIxs: i32[] = []
let nwNames: string[] = []
let nwBaseTyIxs: i32[] = []
// FLAT RECORD sidecar (webcraft P1.2) — the measured layout of every
// `flat type N = { … }` in the program, built once by `resolveFlatLayouts` after
// the declaration passes have resolved field types, and read by exactly one
// consumer: the `N.size` / `N.field` constant fold in `checkMemberNode`.
//
// The layout rule is the whole design in one line: **offsets are the running sum
// of the declared field widths and the compiler never inserts a byte.** No
// alignment, no trailing pad, no reordering. `docs/internals/flat-records-design.md`
// §2 records why (the requirements doc's own example carries an explicit `pad`
// field, which is only necessary if nothing pads implicitly; and unaligned access
// is legal in wasm, so there is no correctness argument for the alternative).
//
// PER DECLARATION: `flSizes[d]` is the total byte size, or `FL_UNRESOLVED` while
// the nested-record fixpoint is still running, or `FL_INVALID` when the
// declaration was rejected (which suppresses the cycle report — an invalid
// declaration is not a recursive one).
let flNames: string[] = []
let flSizes: i32[] = []
let flFStart: i32[] = []
let flFCount: i32[] = []
// The declaration's arena node, so the CYCLE report — which is discovered in the
// fixpoint, long after the statement walk that found the declaration — can still
// anchor its diagnostic on the right line.
let flDeclNodes: i32[] = []
// PER FIELD, in declaration order: the name, the width (or `-1` when the field is
// a NESTED flat record, in which case `flFNest` is that record's index here), and
// the byte offset once the declaration resolves.
let flFNames: string[] = []
let flFWidth: i32[] = []
let flFNest: i32[] = []
let flFOff: i32[] = []
// Depth counter for the LITERAL-adoption window (`nomLitAdopts`): while positive,
// `assignableGo`'s brand test stands down. Only ever raised around a walk whose
// SOURCE is a scalar literal, which is what makes waiving the whole walk equivalent
// to waiving the destination's own brand.
let nomLitRelax = 0
// Litunion alias PROVENANCE (rep-rewrite Stage B, b1). The narrowing/join/
// intersection algebra re-mints a declared litunion alias as a fresh arena
// COPY (`K | null` inferred through `joinTys`, `!= null` through `subtractTy`,
// `K & !"a"` through `isectDistribute`): a `TyUnion` sharing the alias's
// `TyLit` members but at an index the union-alias REGISTRY cannot recognize —
// so "alias-ness" (the atom-vs-string rep axis) was unanswerable at those
// indices, and the rep tree's `litunion:noalias` bucket was dominated by
// them. These parallel arrays record (copy index → source alias index) at the
// mint sites; `tyLitUnionAliasIx` reads them back. Only a copy whose member
// set is CONTAINED in the alias's (narrowing only ever subtracts) records —
// a join that ADDS a foreign literal is not that alias. A genuinely-inline
// litunion (`: "a" | "b"` spelled with no alias source) records nothing.
let cLitUnionCopyTyIxs: i32[] = []
let cLitUnionCopyAliasIxs: i32[] = []
// A single placeholder `TyFunc` arena index for monomorphizer `=>sigkey` closure pins (C1 endgame).
let cFuncPinTyIx = -1
// A single placeholder `TyObj` arena index for interned anonymous-shape `#anonN` names (C1 endgame).
let cObjPinTyIx = -1
// ── the PIN COLUMN (census W11) ─────────────────────────────────────────────
// A synthesized annotation node's PROVENANCE, in its own column: the `PIN_*` kind
// and, for `PIN_SIGKEY`, the `$fnsig` key that is its payload. Keyed by node index,
// exactly like `nodeTyIx` beside it, and reset with it.
//
// This replaces reading the fact off the node's NAME. The two handles the emitter
// mints (`"=>ii>i"`, `"#anon3"`) used to announce themselves by a PREFIX on the
// `tyName` column, and every consumer decoded that prefix itself: two arms here,
// two in `emit_mono`, one at `emit_classify.paramCloSigKey`. The census called
// that "not a grammar — retired by giving the pin its own column", and this is it.
// Only the MINT still bridges from the legacy string form (`synthPinKindOf`).
let nodePinKind: i32[] = []
let nodePinPay: string[] = []
// The node index of the if-EXPRESSION currently being checked as a `let`/`const`
// INITIALIZER, or -1. The one position outside return-tail where the emitter CAN lower an
// else-less if-expression's `T | null` value (`emit_collect.nliInferIfLet`), so the one
// position where `checkIfStmtNode` widens it instead of typing it `TY_VOID`. Written and
// restored around the initializer check in `checkLetDeclNode`; peeled through `Paren` so
// `const r = (if c { 5 })` marks the same node `checkNode` reaches.
let letInitIfIx = -1
let inferQuiet = false
let cycleBreakCount = 0
let inferTentative: string[] = []
let unresolvedFns: string[] = []
let fnSawValueRet = false

// Redundant RETURN-type annotation rule: `retNatural` is the body's NATURAL inferred
// return (first non-void/non-error, mirroring noteInferredRet) accumulated for an
// ANNOTATED function, so the rule can compare it to the explicit `: T`. A match means
// removing the annotation yields the identical inferred return. Saved/reset/restored
// per function in checkFuncDeclNode.
let retNatural = -1
let retNaturalErr = false

// CONTEXTUAL (bidirectional) inference for un-annotated function-literal params. When an
// expression is checked in a position with a known EXPECTED type, a lambda `(x) => …` sitting
// there infers its params from the expected function type — even when nested inside a composite
// (an `((i32) => i32)[]` array, a `{ f: (i32) => i32 }` object). `seedExpected` walks the
// expected type and the expression in lockstep and records, PER LAMBDA NODE, its expected param
// types; the lambda's `checkFuncDeclNode` then reads them by node index. Node-keyed rather than
// a single-shot global, so the MANY lambdas of one composite each get their own seed and a seed
// never leaks into an unrelated body. Every contextual position routes through `seedExpected`
// (a HOF call arg, a `.map`/`.filter` receiver, an annotated `let`/return/field/element) — one
// mechanism, all positions.
let cbExpNode: i32[] = [] // lambda node index
let cbExpOff: i32[] = []  // offset of its param-type run in `cbExpPool`
let cbExpLen: i32[] = []  // run length (param count)
let cbExpPool: i32[] = [] // flattened expected param-type arena indices

// The contextual expected RETURN type per lambda node — the return-side dual of the
// param seeding above. A lambda whose body infers a NARROWER numeric than the expected
// return (`const v: () => i64 = () => (5)`) ADOPTS the expected return, so the widening
// happens INSIDE the body at the return seam (where codegen inserts the convert) instead
// of riding function-type variance, which has no adapter (see `fnSlotAssignable`).
let cbExpRetNode: i32[] = []
let cbExpRetTy: i32[] = []

// Record `retTy` as the expected return type of the lambda at `nodeIx` (latest wins).
function recordCbExpectedRet(nodeIx: i32, retTy: i32) {
  cbExpRetNode.push(nodeIx)
  cbExpRetTy.push(retTy)
  0
}

// The expected return type recorded for the lambda at `nodeIx` — the LAST recorded one
// (the real pass overrides the pre-inference pass), or -1 when none.
function cbExpectedRetFor(nodeIx: i32) {
  let found = -1
  let i = 0
  while i < cbExpRetNode.length {
    if cbExpRetNode[i] == nodeIx { found = cbExpRetTy[i] }
    i = i + 1
  }
  found
}

// Lambda nodes that are the init of an UN-annotated `const`/`let` binding (`const add = (a, b) =>
// a + b`). Such a lambda's un-annotated params are inference HOLES — monomorphized per use exactly
// like a named generic function (the emitter value-flow-monomorphizes them, env and all) — rather
// than rejected as uninferable. Any OTHER no-context anonymous lambda stays a clean rejection.
let valBindLambda: i32[] = []
function noteValBindLambda(nodeIx: i32) { valBindLambda.push(nodeIx) }
function isValBindLambda(nodeIx: i32) {
  let i = 0
  while i < valBindLambda.length {
    if valBindLambda[i] == nodeIx { return true }
    i = i + 1
  }
  false
}

// Record `paramTys` as the expected param types of the lambda at `nodeIx` (latest wins).
function recordCbExpected(nodeIx: i32, paramTys: i32[]) {
  cbExpNode.push(nodeIx)
  cbExpOff.push(cbExpPool.length)
  cbExpLen.push(paramTys.length)
  let i = 0
  while i < paramTys.length {
    cbExpPool.push(paramTys[i])
    i = i + 1
  }
  0
}

// The expected param types recorded for the lambda at `nodeIx` — the LAST recorded run (the
// real pass overrides the pre-inference pass), or `[]` when none.
function cbExpectedFor(nodeIx: i32) {
  let found = -1
  let i = 0
  while i < cbExpNode.length {
    if cbExpNode[i] == nodeIx { found = i }
    i = i + 1
  }
  const out: i32[] = []
  if found >= 0 {
    let j = 0
    while j < cbExpLen[found] {
      out.push(cbExpPool[cbExpOff[found] + j])
      j = j + 1
    }
  }
  out
}

// The body's TAIL expression of a lambda (its implicit-return value) — the last statement's
// return argument, or a bare trailing-expression statement. A lambda body is always a (possibly
// synthetic one-statement) Block. -1 when there is no tail value. Lets `seedExpected` flow an
// expected RESULT type into a lambda's body, so a CURRIED `(a) => (b) => …` reaches its inner
// lambda.
function lambdaBodyTail(bodyIx: i32) {
  if bodyIx < 0 { return -1 }
  const b = P.nodes[bodyIx]
  if b is Block {
    const stmts = b.blkStmts
    if stmts.length == 0 { return -1 }
    const last = stmts[stmts.length - 1]
    const ln = P.nodes[last]
    if ln is RetStmt { return ln.retArg }
    return last
  }
  -1
}

// FIELD-LEVEL contextual return adoption — the object dual of the scalar rule in
// `checkFuncDeclNode`: an object-literal-bodied lambda whose inferred return shape widens
// FIELD-WISE into the contextual expected return (`const v: () => {f: i64} = () => ({f: 5})`)
// ADOPTS the expected shape. Sound only when every widening field's VALUE is a small int
// literal — the literal re-encodes at the wider rep inside the body, and the expected field
// type is RECORDED on the literal node so the emitter's literal-shape interner
// (`anonFieldCode`, which otherwise codes a small literal i32) interns the wide slot.
// Anything else keeps the inferred shape, and `objNumWidens` in `fnSlotAssignable` rejects
// it loudly (a function value's field rep is fixed; only a literal body can re-encode).
// The FIELD WALK of `objRetWidenAdopt`, factored out so a NESTED object field recurses:
// `litIx` is an ObjLit whose inferred type `sTyIx` adopts the expected `dTyIx` field-wise,
// appending each re-encodable value node + its adopted field type to `recNodes`/`recTys`.
// Returns false on any proven field mismatch (the caller keeps the inferred type).
function objLitWidenFields(
  litIx: i32,
  sTyIx: i32,
  dTyIx: i32,
  recNodes: i32[],
  recTys: i32[],
): boolean {
  const lit = P.nodes[litIx]
  if !(lit is ObjLit) { return false }
  const s = T.tys[sTyIx]
  const d = T.tys[dTyIx]
  if !(s is TyObj) { return false }
  if !(d is TyObj) { return false }
  if s.objFieldNames.length != d.objFieldNames.length { return false }
  let i = 0
  while i < d.objFieldNames.length {
    const dty = d.objFieldTypes[i]
    const sty = objFieldType(s, d.objFieldNames[i])
    if sty < 0 { return false }
    // The field's VALUE expression in the literal body (shared by the numeric-widen
    // and the float-literal→f32 arms below).
    let fv = -1
    const fl = lit.objFields
    let fi = 0
    while fi < fl.length {
      const fn = P.nodes[fl[fi]]
      if fn is FieldInit {
        if fn.fiName == d.objFieldNames[i] { fv = fn.fiValue }
      }
      fi = fi + 1
    }
    if numWidens(sty, dty) {
      // The widening field's value must be a small int literal in the literal body.
      if fv < 0 { return false }
      const fvn = P.nodes[fv]
      if fvn is NumLit {
        if hasDot(fvn.numText) { return false }
        if !intLexemeFitsI32(fvn.numText) { return false }
        recNodes.push(fv)
        recTys.push(dty)
      } else {
        return false
      }
    } else if primNameOf(dty) == "f32" && isF32AdoptingLitExpr(fv) {
      // LITERAL → f32 field (`() => ({a: 3.5, …})` against `{a: f32, …}`): the field
      // infers f64 (or i32) but the literal re-encodes exactly at f32 (the field dual of
      // the scalar arm above). Record f32 on the value node so `anonFieldCode` interns the
      // f32 field slot (it would else code the literal's default f64/i32).
      recNodes.push(fv)
      recTys.push(dty)
    } else if assignable(sty, dty) && !assignable(dty, sty) {
      // The field WIDENS by BOXING — a bare scalar/struct arm into a UNION or NULLABLE
      // field (`{f: false}` against `{f: boolean | {w: i32}}`, `{f: 99}` against
      // `{f: i64 | string}`). Adopt when the literal value re-encodes at the wider field
      // type (`assignableExpr`, field-wise) — the object dual of the value-union return
      // arm. Record the field type so the emitter boxes the field slot and coerces the
      // ObjLit value into the box, exactly as the annotated `: {f: boolean | {w: i32}}`
      // named-function return already lowers. `synthRetAnnots` pins the lambda's `fnRet`
      // to the whole struct shape (`nameIsStructWithUnionField`), so its `$fnsig` result
      // is the union-field struct — without which the value call mis-recovered the plain
      // struct (MISMATCH / INVALID-WASM at the boxed field read).
      // A NESTED object field whose INNER field widens (`{f: {f: 16743}}` against
      // `{f: {f: i32 | string}}`): the value is itself an ObjLit — RECURSE so the inner
      // literal adopts the union-field shape and records ITS node type; without the
      // descent the lambda body built the self-inferred `{f: i32}` layout while the sig
      // keyed the union-field struct (INVALID-WASM at the return; fuzz-nightly run
      // 29808029476, seed 78530533 d5 `(i32) => {f: {f: i32 | string}}`).
      if fv < 0 { return false }
      let fvIn = fv
      let fvDone = false
      while !fvDone {
        const fvp = P.nodes[fvIn]
        if fvp is Paren { fvIn = fvp.parInner } else { fvDone = true }
      }
      const fvNode = P.nodes[fvIn]
      // The recursion targets a NESTED-STRUCT dest only: an ObjLit value against a UNION
      // field (`{f: {f: h0}}` against `{f: {f:{[string]:string}} | boolean}` — the literal
      // is a MEMBER of the union, an ARM, not a field-wise widening target) descends into
      // `!(d is TyObj)` and refuted the WHOLE adoption — so nothing recorded, no
      // `synthRetAnnots` pin, and the emitter's self-derivation keyed the outer literal
      // onto the same-field-name-set MAP-field twin (INVALID-WASM at the `struct.new`;
      // fuzz frontier seed 658239060 d5). Route a non-TyObj dest through the plain
      // member-flow check below, recording the union field type so the emitter boxes.
      let dtyIsObj = false
      const dtyT = T.tys[dty]
      if dtyT is TyObj { dtyIsObj = true }
      if fvNode is ObjLit && dtyIsObj {
        if !objLitWidenFields(fvIn, sty, dty, recNodes, recTys) { return false }
        recNodes.push(fvIn)
        recTys.push(dty)
      } else {
        if !assignableExpr(fv, sty, dty) { return false }
        recNodes.push(fv)
        recTys.push(dty)
      }
    } else if tyIsLitUnion(dty) {
      // LITUNION field (`f: "8"` against `f: K0 = "xz" | "8"`): the body value is a bare
      // string literal that is a MEMBER of the expected literal-union. It infers the
      // softened `string`, but re-encodes as the litunion's i32 ATOM — the field dual of
      // the scalar litunion-return arm (`(i32) => K = (x) => "b"`). Adopt when the value is
      // a member literal; record the litunion field type so `anonFieldCode` interns the
      // atom slot (it would else code the string). The named-function VALUE spelling of the
      // same struct-with-litunion-field return already lowers to this rep.
      if fv < 0 { return false }
      if !assignableExpr(fv, sty, dty) { return false }
      recNodes.push(fv)
      recTys.push(dty)
    } else {
      // A non-widening field must match exactly (mutual assignability) — a shape
      // difference beyond numeric widening is not an adoption, it is a mismatch.
      if !assignable(sty, dty) { return false }
      if !assignable(dty, sty) { return false }
    }
    i = i + 1
  }
  true
}

function objRetWidenAdopt(bodyIx: i32, inferredTy: i32, expRetTy: i32) {
  if inferredTy < 0 || expRetTy < 0 { return false }
  let u = lambdaBodyTail(bodyIx)
  if u < 0 { return false }
  let done = false
  while !done {
    const pn = P.nodes[u]
    if pn is Paren { u = pn.parInner } else { done = true }
  }
  const lit = P.nodes[u]
  if !(lit is ObjLit) { return false }
  const s = T.tys[inferredTy]
  // A NULLABLE expected result (`() => {f: K0} | null` — spelled directly, or through the
  // nullable-closure wrapper `(() => {f: K0} | null) | null`): adopt against the INNER
  // struct. The caller still adopts the FULL nullable expected, so the lambda's `$fnsig`
  // result keys the nullable struct exactly as the annotation-side consumer does. Without
  // the unwrap a litunion field never adopted and the two sides keyed DIFFERENT structs
  // (`{f: string}` vs `{f: K0}` — a cast-failure TRAP at the narrowed nullable-closure
  // call; fuzz frontier seed 679748579 d5 --branching --multiobs).
  let expInnerTy = expRetTy
  const dn = T.tys[expRetTy]
  if dn is TyNullable { expInnerTy = dn.nInner }
  const d = T.tys[expInnerTy]
  if s is TyObj {
    if d is TyObj {
      const recNodes: i32[] = []
      const recTys: i32[] = []
      if !objLitWidenFields(u, inferredTy, expInnerTy, recNodes, recTys) {
        return false
      }
      if recNodes.length == 0 { return false }
      if !inferQuiet {
        let r = 0
        while r < recNodes.length {
          const rn = recNodes[r]
          while nodeTyIx.length <= rn { nodeTyIx.push(-1) }
          nodeTyIx[rn] = recTys[r]
          r = r + 1
        }
        // REP SIDECAR (phase 0a): `nodeTyIx` above stamps the WIDENING FIELD VALUES, but the
        // top-level return literal `u` keeps its naive self-inferred type — the emitter's
        // `structIndexOfObjCtx` keys on the literal NODE, so record the destination struct
        // there (recursing into fields) so the rep layer resolves the union-field / i64-field
        // / nullable-niche shape the emitter builds. Byte-identical (nothing reads it yet).
        recordRepTyAdopt(u, expInnerTy, 6)
      }
      return true
    }
  }
  false
}

// Propagate an EXPECTED type into an expression, recording per-lambda param expectations. A
// lambda at a function-typed position is seeded directly — its params from the expected param
// types AND its body recursively against the expected RESULT type (so a CURRIED `(a) => (b) => …`
// types its inner lambda from a nested function type). A composite LITERAL (array / object)
// recurses into its elements / fields. So a lambda nested anywhere in the expected shape — under
// arrows, arrays, or object fields, at any depth — is reached by ONE recursive mechanism. Any
// other shape is a no-op.
// The union member index of `u`'s FUNCTION arm whose parameter arity is `arity` (`(() => i64) |
// {w:i32}` with a 0-arg lambda → the `() => i64` member), or -1 when no function arm matches. Lets
// `seedExpected` adopt a bare LAMBDA into a union's closure arm (the emit already boxes a closure
// arm — this is the checker seam that widens `f: () => 5` to the `() => i64` member). The FIRST
// matching arm wins (a union with two same-arity func arms is not a supported shape).
function unionFuncArmForArity(u: TyUnion, arity: i32) {
  const members = u.uMembers
  let i = 0
  while i < members.length {
    const m = members[i]
    const mt = T.tys[m]
    if mt is TyFunc {
      if mt.fnParamTypes.length == arity { return m }
    }
    i = i + 1
  }
  -1
}
// True if the union OBJECT arm `tyIx` can be BOTH boxed into the union's `{tag, value}` rep AND
// have its narrowed fields read back with valid wasm — the safety gate for seeding a struct literal
// into this arm. A field that is a scalar / string (`TyPrim`), a nested struct (`TyObj`, recursively
// safe), or a closure (`TyFunc`) has a sound variant-struct rep: construction boxes it, and a
// narrowed read of it either lowers (`v.a`, `v.f.g`) or FAILS LOUD (`v.f(1)` on a closure field is a
// clean "callee is not a function name" reject) — never invalid wasm. A field that is an ARRAY,
// a union, or a nullable has NO sound narrowed-read rep yet (`v.f[0](1)` over a reflist-of-closures
// field emits a type-mismatched read — INVALID WASM), so an arm carrying one is NOT seed-safe:
// leaving it unseeded keeps the un-annotated field lambda a clean "cannot infer" reject instead of
// letting the checker accept a shape the emitter mis-lowers. (A stricter sibling of `unionArmBoxSafe`,
// which the widening-adoption path uses — that one also excludes closures; this one admits them
// because a closure FIELD boxes + reads soundly, only its narrowed CALL is a loud gap.)
function unionArmSeedSafe(tyIx: i32) {
  const t = T.tys[tyIx]
  if !(t is TyObj) { return false }
  const ftys = t.objFieldTypes
  let i = 0
  while i < ftys.length {
    const ft = T.tys[ftys[i]]
    if ft is TyPrim {
      // scalar / string / boolean field — boxes + reads cleanly
    } else if ft is TyFunc {
      // a closure field — boxes into the variant struct; a narrowed call is a loud reject
    } else if ft is TyObj {
      if !unionArmSeedSafe(ftys[i]) { return false }
    } else if ft is TyArray {
      // a CLOSURE-ARRAY field (`f: ((i32) => K0)[]`) — the reflist field boxes into the
      // variant struct and a narrowed indexed call reads back the closure element; the
      // seed is what lets the element lambdas infer their params/result from the arm.
      // Every other element rep keeps the un-seeded clean reject.
      if ft.aElem < 0 { return false }
      const aet = T.tys[ft.aElem]
      if !(aet is TyFunc) { return false }
    } else {
      return false // other array / union / nullable field — no sound narrowed-read rep yet
    }
    i = i + 1
  }
  true
}
// The union member index of `u`'s OBJECT arm whose shape covers the object literal `objIx` (every
// literal field name is a field of the arm) AND whose fields are seed-safe (`unionArmSeedSafe`), or
// -1. The object dual of `unionFuncArmForArity`: lets `seedExpected` descend a struct LITERAL flowing
// into a union (`{f: (i32) => i32, …} | boolean`) into its matching struct arm, so a bare field lambda
// (`f: (q) => …`) infers its params from that arm's field types instead of failing "cannot infer a
// type for parameter". Seeding only supplies the contextual param types — the whole literal is still
// gated by the normal assignability check against the union, so a mis-matched arm cannot be silently
// accepted; the seed-safety gate additionally keeps a shape the emitter cannot yet lower (an array /
// union / nullable field) a clean reject rather than an INVALID-WASM acceptance. FIRST match wins.
function unionObjArmForLit(u: TyUnion, objIx: i32) {
  const on = P.nodes[objIx]
  if on is ObjLit {
    const members = u.uMembers
    let i = 0
    while i < members.length {
      const m = members[i]
      const mt = T.tys[m]
      if mt is TyObj && unionArmSeedSafe(m) {
        let ok = true
        let j = 0
        while j < on.objFields.length {
          const fnode = P.nodes[on.objFields[j]]
          if fnode is FieldInit {
            if objFieldType(mt, fnode.fiName) < 0 { ok = false }
          }
          j = j + 1
        }
        if ok { return m }
      }
      i = i + 1
    }
  }
  -1
}
// The union member index of `u`'s array arm covering the array literal `arrIx`, or -1. Lets
// `seedExpected` descend an array LITERAL flowing into a union into that arm so a bare element
// lambda (directly, or NESTED in a struct-element field) infers its params/result from the arm's
// element type. Two admitted element shapes, both of which the emitter has a sound narrowed read
// for (the direct `T[]` binding lowers today):
//   - a CLOSURE element (`((i32) => f32)[] | i32`): the element lambda seeds off the function arm;
//   - a STRUCT element (`{a: f64, f: (() => f64|null)[], z: string}[] | i64`) whose fields are
//     seed-safe (`unionArmSeedSafe`) AND cover the literal's element ObjLit field names: a bare
//     field/closure-array-field lambda deep in the element struct seeds off the arm's field types
//     (else it self-infers a narrower result — e.g. `() => f64` for a `() => f64|null` field — and
//     the boxed producer/consumer disagree → a runtime cast trap).
// A scalar/string array arm needs no contextual seed (its elements infer standalone) and is left
// out. Seeding only supplies contextual types; the whole literal is still gated by the normal
// assignability check against the union, so a mis-matched arm cannot be silently accepted. FIRST
// match wins.
function unionArrayArmForLit(u: TyUnion, arrIx: i32) {
  const an = P.nodes[arrIx]
  if an is ArrayLit {
    const members = u.uMembers
    let i = 0
    while i < members.length {
      const m = members[i]
      const mt = T.tys[m]
      // The HOLE declines this ARM and the scan moves to the next member
      // (`tyArrayElemIx`): an array arm whose element the arena has not resolved carries
      // `aElem == -1`, and reading it is an out-of-bounds `array.get` in the compiler.
      // Declining the arm is the same answer the seed already gives a scalar-element arm.
      const aeIx = tyArrayElemIx(m)
      if mt is TyArray && aeIx >= 0 {
        const aet = T.tys[aeIx]
        if aet is TyFunc { return m }
        if aet is TyObj && unionArmSeedSafe(aeIx) {
          // Every literal element that is an ObjLit must field-check against the arm's struct
          // element (mirrors `unionObjArmForLit`), so a wrong-shaped arm is not seeded.
          let ok = true
          let j = 0
          while j < an.arrElems.length {
            let ei = an.arrElems[j]
            let peeled = false
            while !peeled {
              const ep = P.nodes[ei]
              if ep is Paren { ei = ep.parInner } else { peeled = true }
            }
            const en = P.nodes[ei]
            if en is ObjLit {
              let k = 0
              while k < en.objFields.length {
                const fnode = P.nodes[en.objFields[k]]
                if fnode is FieldInit {
                  if objFieldType(aet, fnode.fiName) < 0 { ok = false }
                }
                k = k + 1
              }
            }
            j = j + 1
          }
          if ok { return m }
        }
      }
      i = i + 1
    }
  }
  -1
}
function seedExpected(exprIx: i32, expectedTy: i32) {
  if exprIx < 0 || expectedTy < 0 { return 0 }
  let u = exprIx
  let done = false
  while !done {
    const node = P.nodes[u]
    if node is Paren { u = node.parInner } else { done = true }
  }
  const en = P.nodes[u]
  const et = T.tys[expectedTy]
  // A nullable expected type (`(i32) => i32 | null` — e.g. a map VALUE slot, which is
  // `V | null`) seeds its inner: the RHS lambda / literal still wants the non-null shape.
  if et is TyNullable { return seedExpected(u, et.nInner) }
  if en is FuncDecl {
    if en.fnName == "" {
      if et is TyFunc {
        recordCbExpected(u, et.fnParamTypes)
        recordCbExpectedRet(u, et.fnRet)
        // RECURSE into the lambda's BODY against the expected RESULT type — the dual of the
        // array/object recursion below. A curried `(a) => (b) => …` against `(i32) => ((i32) =>
        // i32)` then types its inner lambda's params from the result function type, at any depth.
        seedExpected(lambdaBodyTail(en.fnBody), et.fnRet)
      } else if et is TyUnion {
        // A lambda flowing into a UNION with a bare-closure arm (`f: (() => i64) | {w:i32}`):
        // seed it against the arity-matching function arm, so `() => 5` widens to `() => i64`
        // and adopts the union (the emit boxes the closure arm into the `{tag, value}` rep).
        // Without this the lambda infers its own bare `() => i32` and the union assignment is a
        // loud type error — the checker seam the emit layers depend on. Arity-matched so a
        // non-function arm (or a wrong-arity closure) is left to the normal assignability check.
        const arm = unionFuncArmForArity(et, en.fnParams.length)
        if arm >= 0 { seedExpected(u, arm) }
      }
    }
  } else if en is ArrayLit {
    if et is TyArray {
      let i = 0
      while i < en.arrElems.length {
        seedExpected(en.arrElems[i], et.aElem)
        i = i + 1
      }
    } else if et is TyUnion {
      // An array LITERAL flowing into a union with a CLOSURE-ARRAY arm (`[(q) => …]` into
      // `((i32) => f32)[] | i32`) or a STRUCT-ARRAY arm with closure-bearing element fields
      // (`[{…, f: [() => 5], …}]` into `{a, f: (() => f64|null)[], z}[] | i64`): descend into the
      // matching array arm so a bare element lambda — directly or nested in an element field —
      // infers its params/result from that arm's element type (the array dual of the closure-arm
      // and struct-arm seeding above). Without this seed a nested field lambda self-infers a
      // narrower result and the boxed producer/consumer disagree (runtime cast trap). Re-entering
      // with the arm's `TyArray` reuses the element-recursion branch; assignability still gates the
      // whole literal against the union, so a wrong arm cannot be silently adopted.
      const arm = unionArrayArmForLit(et, u)
      if arm >= 0 { seedExpected(u, arm) }
    }
  } else if en is ObjLit {
    if et is TyObj {
      const fields = en.objFields
      let i = 0
      while i < fields.length {
        const fnode = P.nodes[fields[i]]
        if fnode is FieldInit {
          const fty = objFieldType(et, fnode.fiName)
          if fty >= 0 { seedExpected(fnode.fiValue, fty) }
        }
        i = i + 1
      }
    } else if et is TyUnion {
      // A struct LITERAL flowing into a union (`{f: (i32) => i32, …} | boolean`): descend into the
      // matching struct ARM so a bare field lambda infers its params from that arm's field types
      // (the object dual of the closure-arm seeding above). Without this an un-annotated field
      // lambda has no contextual seed and fails "cannot infer a type for parameter". Re-entering
      // with the arm's `TyObj` reuses the field-recursion branch; assignability still gates the
      // whole literal against the union, so a wrong arm cannot be silently adopted.
      const arm = unionObjArmForLit(et, u)
      if arm >= 0 { seedExpected(u, arm) }
    }
  }
  0
}

// Reset all checker module state, then intern the well-known primitives and the
// global scope. Call once before checking.
export function initChecker() {
  redunReset()
  cbExpNode = []
  cbExpOff = []
  cbExpLen = []
  cbExpPool = []
  cbExpRetNode = []
  cbExpRetTy = []
  valBindLambda = []
  T.tys = []
  T.scopes = []
  T.diags = []
  T.curRet = -1
  cUserTypes = Map()
  // The arena is re-minted for this program: advance BOTH generations so no
  // emit-side memo stamped under a previous program can be consulted on a
  // shared instance (advance, never reset — a reset could collide with a stamp
  // an earlier program left behind).
  tyMutEpoch = tyMutEpoch + 1
  cUserTypesVer = cUserTypesVer + 1
  gaNames = []
  gaDeclIxs = []
  gaParamNames = []
  gaParamStart = []
  gaParamCount = []
  annotNameMemo = Map()
  annotNameMemoNegVer = Map()
  annotPart = Map()
  annotClash = Map()
  tpEnvNames = []
  tpEnvTys = []
  bgSrcStack = []
  bgDstStack = []
  stSeenStack = []
  holeShapeNames = []
  holeShapeTys = []
  holeArrayDemand = []
  holeMapNames = []
  holeMapTys = []
  holeAltNames = []
  holeAltTys = []
  holeAltPreN = []
  holeAltTailN = []
  holeAltHoleIx = []
  // The derivation rows are ARENA-PARALLEL, so they are reset exactly where the
  // arena is (`T.tys = []` above) — a row surviving the re-mint would describe a
  // type index that no longer exists.
  hdKind = []
  hdField = []
  hdInner = []
  hdAlt = []
  hdBase = []
  hdDepth = []
  hdRowOfTy = []
  guardAltStack = []
  joinHoleUnions = []
  dJoinNode = []
  dJoinTy = []
  escJoinTy = []
  escJoinIx = []
  escJoinWho = []
  binCstrLt = []
  binCstrOp = []
  binCstrRt = []
  argCstrAt = []
  argCstrExp = []
  argCstrWho = []
  solvedParamTys = Map()
  paramSolveTried = Map()
  holeFlowSrc = []
  holeFlowDst = []
  paramSolveProbe = false
  fnDeclIx = Map()
  opIdxOps = []
  opIdxFns = []
  opIdxSiteNode = []
  opIdxSiteFn = []
  moduleGlobals = Map()
  topUnannotFns = []
  gRootStmts = []
  inferRetFn = []
  inferRetTy = []
  inferRetAtomCount = []
  inferRetTyIx = []
  inferRetRung = []
  inferRetIdx = Map()
  inferLetIx = []
  inferLetTy = []
  inferLetNulStrIx = []
  inferLetNulBoolIx = []
  bodyChecked = Map()
  nodeTyIx = []
  isVarTyIx = []
  nodeRepTyIx = []
  annUnionAtoms = []
  cFuncPinTyIx = -1
  cObjPinTyIx = -1
  nodePinKind = []
  nodePinPay = []
  inferQuiet = false
  cycleBreakCount = 0
  inferTentative = []
  unresolvedFns = []
  fnSawValueRet = false
  retNatural = -1
  retNaturalErr = false
  daClear()
  daWriteTarget = -1
  inferStack = []
  inferObserved = -1
  inferSawErr = false
  TY_I32 = mkPrim("i32")
  TY_I64 = mkPrim("i64")
  TY_F64 = mkPrim("f64")
  TY_F32 = mkPrim("f32")
  TY_BOOL = mkPrim("boolean")
  TY_STR = mkPrim("string")
  TY_VOID = mkPrim("void")
  TY_ERR = mkErrTy()
  TY_NULL = mkPrim("null")
  TY_NEVER = mkPrim("never")
  T.scopes.push(Map())
  constScopes = []
  constScopes.push(Map())
  fnDeclScopes = []
  fnDeclScopes.push(Map())
  pendNames = []
  pendTys = []
  pendAts = []
  pendDepths = []
  npKeys = []
  npTys = []
  npInvBy = []
  npEpochs = []
  npFrames = []
  weSums = Map()
  weOpen = []
  weRoots = []
  weFnDecls = Map()
  weCut = 0
  asgSrcStack = []
  asgDstStack = []
  tyToStrDepth = 0
  pgKeys = []
  pgFrames = []
  asgDeclKeys = []
  asgDeclTys = []
  asgDeclDepths = []
  asgDeclKinds = []
  asgDeclEpochs = []
  asgDeclFrames = []
  narFnEpoch = 0
  reScopeBases = []
  reNpBases = []
  guardNames = []
  guardParamIdxs = []
  guardThens = []
  // LSP symbol-table data — cleared every check (the `symEnabled` mode flag is the
  // driver's to set, so it is NOT reset here). The global scope's decl frame is
  // seeded to parallel the global type scope `T.scopes` already pushed below.
  symOccTok = []
  symOccDecl = []
  symOccIsDecl = []
  // Token-membership set mirroring `symOccTok` — reset in lockstep (see `symOccHasTok`).
  symOccTokSet = Map()
  symDeclScope = []
  symBindNode = []
  symBindType = []
  symBindKind = []
  symMemNode = []
  symMemTy = []
  symMemLine = []
  symMemCol = []
  symMemEndCol = []
  symVisName = []
  symVisNode = []
  symVisKind = []
  symVisSL = []
  symVisSC = []
  symVisEL = []
  symVisEC = []
  scopeSL = []
  scopeSC = []
  scopeEL = []
  scopeEC = []
  scopeResName = []
  scopeResKind = []
  scopeResType = []
  if symEnabled != 0 {
    symDeclScope.push(Map())
    // The global scope spans the whole file (looser than any nested scope).
    scopeSL.push(1)
    scopeSC.push(0)
    scopeEL.push(SCOPE_EOF)
    scopeEC.push(0)
  }
  // Memory intrinsics (host `defaultScope`): raw linear-memory stores/loads and
  // the `__log__` host hook used by low-level corpus programs.
  declare("__store_i32__", mkFuncTy([TY_I32, TY_I32], TY_VOID))
  declare("__store_i64__", mkFuncTy([TY_I32, TY_I64], TY_VOID))
  declare("__store_f32__", mkFuncTy([TY_I32, TY_F32], TY_VOID))
  declare("__store_f64__", mkFuncTy([TY_I32, TY_F64], TY_VOID))
  declare("__store_i8__", mkFuncTy([TY_I32, TY_I32], TY_VOID))
  declare("__store_i16__", mkFuncTy([TY_I32, TY_I32], TY_VOID))
  declare("__load_i32__", mkFuncTy([TY_I32], TY_I32))
  declare("__store_string__", mkFuncTy([TY_I32, TY_STR], TY_I32))
  declare("__log_string__", mkFuncTy([TY_I32, TY_I32], TY_VOID))
  declare("__log__", mkFuncTy([TY_I32, TY_I32], TY_VOID))
  declare("__memory_grow__", mkFuncTy([TY_I32], TY_I32))
  const noParams: i32[] = []
  declare("__memory_size__", mkFuncTy(noParams, TY_I32))
  declare("__memory_copy__", mkFuncTy([TY_I32, TY_I32, TY_I32], TY_VOID))
  declare("__memory_fill__", mkFuncTy([TY_I32, TY_I32, TY_I32], TY_VOID))
  // THE LOAD-WIDTH MATRIX (webcraft P0.1, `buffer-design.md` §C2). Each VL signature
  // IS the wasm instruction's signature — the same rule P0.3/P0.4's numeric intrinsics
  // follow — so there is nothing to choose here beyond the name:
  //
  //   __load_i8__  → i32.load8_s   __load_u8__  → i32.load8_u
  //   __load_i16__ → i32.load16_s  __load_u16__ → i32.load16_u
  //   __load_i64__ → i64.load      __load_f32__ → f32.load    __load_f64__ → f64.load
  //
  // The narrow loads all RESULT in i32 — that is what the instruction does: the `_s`
  // form sign-extends the byte/halfword into the i32, the `_u` form zero-extends it,
  // and the difference is the whole reason both spellings exist (`__load_i8__` of the
  // byte 0xFF is -1; `__load_u8__` of the same byte is 255).
  //
  // THE WIDE STORE WIDTHS were declared above long before they lowered; they now do,
  // as the exact duals of the three wide loads (`nameIsMemStoreIntrinsic`):
  //
  //   __store_i64__ → i64.store   __store_f32__ → f32.store   __store_f64__ → f64.store
  //
  // The VALUE operand takes the declared width (an integer literal re-encodes at i64, a
  // float literal at f32/f64) — unlike the ADDRESS, which is an i32 in all fourteen.
  //
  // THE NARROW STORE WIDTHS complete §C2's matrix:
  //
  //   __store_i8__ → i32.store8 (0x3a)     __store_i16__ → i32.store16 (0x3b)
  //
  // Both take an i32 VALUE and TRUNCATE it — there is one instruction per width and it
  // cannot tell a signed byte from an unsigned one, which is why there is no
  // `__store_u8__`/`__store_u16__` twin (§O2, ruled). That asymmetry against the loads,
  // which really do have two instructions each, is the instruction set's and is
  // deliberate: `__store_i8__(a, 255)` and `__store_i8__(a, -1)` write the same byte,
  // and `__load_i8__` reads it back as -1 while `__load_u8__` reads 255.
  //
  // `__store_string__` and `__log_string__` stay dead: they are the two names
  // `nameIsUnimplementedIntrinsic` lists, and calling one is a positioned CHECKER
  // diagnostic rather than an `emitProgram: call to unknown function` that reads like a
  // typo'd identifier. Neither is a table entry away — see that comment.
  declare("__load_i8__", mkFuncTy([TY_I32], TY_I32))
  declare("__load_u8__", mkFuncTy([TY_I32], TY_I32))
  declare("__load_i16__", mkFuncTy([TY_I32], TY_I32))
  declare("__load_u16__", mkFuncTy([TY_I32], TY_I32))
  declare("__load_i64__", mkFuncTy([TY_I32], TY_I64))
  declare("__load_f32__", mkFuncTy([TY_I32], TY_F32))
  declare("__load_f64__", mkFuncTy([TY_I32], TY_F64))
  0
}

// The intrinsic names the EMITTER dispatches on at the CALL SITE, by name, before it
// ever looks up a declaration: each lowers to instructions inline
// (`wasmEmit.emitCallExpr`'s `__store_i32__`/`__load_i32__`/`__log__` arms and the
// array-intrinsic floor `__array_new__`/`__array_new_default__`/`__array_copy__`/
// `__trap__`). A user function of one of these names therefore NEVER RUNS — the call
// site is rewritten and the body is silently discarded.
//
// Measured, one shape per name: `function __load_i32__(a: i32) { return 7 }` +
// `print(__load_i32__(1))` printed **0** (an `i32.load` of address 1), `vl check` clean;
// in STATEMENT position `__store_i32__` and `__log__` discarded the body just as
// silently. The others only failed LOUDLY by accident of stack shape (an `i32.store`
// leaves nothing where an i32 was wanted) or because the checker happens to carry an
// arity arm for them — not by design, and a differently-shaped user signature loses that
// accident. So the rule is the NAME, not the symptom: reject the DEFINITION, where the
// author can see it, instead of letting a call site quietly mean something else.
//
// This list is the reservation; the emitter's per-name arms stay where they are because
// each picks a DIFFERENT lowering (a dispatch, not a classification). The two must be
// kept in step — a new inline-lowered intrinsic belongs here the same day.
//
// EXPORTED because it is also the exact soundness condition for `capScan`'s callee-position
// capture exemption (`emit_classify.vl`): a name whose CALL SITE the emitter rewrites before
// looking up a declaration denotes instructions, not a value, so there is nothing to read out
// of an enclosing frame. `emit_base.isBuiltinFnName` had been keeping a PARTIAL COPY of this
// set for that purpose and its header filed the export as the fix; `capScan` now asks this
// predicate directly, so a new intrinsic reserved here is exempt there the same day and the
// two cannot drift.
export function nameIsEmitterIntrinsic(name: string) {
  if name == "__store_i32__" { return true }
  if name == "__load_i32__" { return true }
  if name == "__log__" { return true }
  if name == "__trap__" { return true }
  if name == "__array_new__" { return true }
  if name == "__array_new_default__" { return true }
  if name == "__array_copy__" { return true }
  // The load-width matrix and the two memory-size ops, lowered inline the same way —
  // reserved the same DAY they acquired an emitter arm, per this comment's own rule.
  if nameIsMemLoadIntrinsic(name) { return true }
  // The five other store widths (three wide, two narrow), likewise reserved the day
  // each acquired its arm.
  if nameIsMemStoreIntrinsic(name) { return true }
  if name == "__memory_size__" { return true }
  if name == "__memory_grow__" { return true }
  // The bulk pair, reserved the day they acquired their arm.
  if nameIsMemBulkIntrinsic(name) { return true }
  false
}

// THE BULK PAIR (`buffer-design.md` §C3) — the two ops webcraft calls load-bearing
// rather than convenient, because snapshot and rollback ARE these instructions and
// without them a snapshot is a per-word loop:
//
//   __memory_copy__(dst, src, len)   → memory.copy   (0xfc 10 0x00 0x00)
//   __memory_fill__(dst, byte, len)  → memory.fill   (0xfc 11 0x00)
//
// All six operands are i32 and both results are void, so unlike the store widths there
// is no width dispatch: every operand takes the ordinary `emitMemIntrinArg` spine.
//
// TWO SEMANTICS THE SIGNATURE DOES NOT SHOW, both of them the instruction's and
// therefore not this layer's to soften (the VL signature IS the wasm signature, the
// same rule the load matrix and P0.3/P0.4's numeric intrinsics follow):
//
//   - `len` is UNSIGNED. A negative length is ~4 GiB and traps. A caller that wants
//     "a non-positive length writes nothing" must say so itself — `std:buffer`'s
//     `fill`/`copyFrom` do, because that is POLICY and policy is std's (O1 = (c)).
//   - `memory.copy` is defined to behave as if the bytes went through a temporary, so
//     it is OVERLAP-SAFE IN BOTH DIRECTIONS — memmove, not memcpy. That is a property
//     of the instruction, which is exactly why it is worth reaching: the `std:buffer`
//     loop it replaces had to choose its direction from the addresses by hand.
//
// Neither needs an import and neither needs a data segment: these are the `memory.init`
// family's siblings, but only the two that operate on already-mapped bytes. What they
// DO need is the `0xfc` misc prefix, which this emitter had no writer for until they
// landed — see `fbMemBulk`.
export function nameIsMemBulkIntrinsic(name: string) {
  if name == "__memory_copy__" { return true }
  if name == "__memory_fill__" { return true }
  false
}

// The seven NEW load widths (`__load_i32__` predates them and keeps its own arm at every
// call site, so it is deliberately NOT in this set — see each caller). One list, consulted
// by the checker's definition reservation, the emitter's dispatch, and the import scan, so
// the three cannot drift: a width missing from any one of them is a silent wrong answer.
export function nameIsMemLoadIntrinsic(name: string) {
  if name == "__load_i8__" { return true }
  if name == "__load_u8__" { return true }
  if name == "__load_i16__" { return true }
  if name == "__load_u16__" { return true }
  if name == "__load_i64__" { return true }
  if name == "__load_f32__" { return true }
  if name == "__load_f64__" { return true }
  false
}

// The five store widths that are not `__store_i32__` — the three WIDE ones (the exact
// duals of `__load_i64__`/`__load_f32__`/`__load_f64__`) and the two NARROW ones that
// complete §C2's matrix. `__store_i32__` predates them all and keeps its own arm at
// every call site, so it is deliberately NOT in this set, exactly as `__load_i32__` is
// not in `nameIsMemLoadIntrinsic`.
//
// The narrow pair has no signed/unsigned split because there is one instruction per
// width and it truncates (§O2, ruled `store8`/`store16` at the `std:buffer` surface).
// They differ from the wide three in exactly one respect the emitter must honour: their
// VALUE operand is an i32, so it takes the ordinary `emitMemIntrinArg` spine rather
// than an `emitExprAs{I64,F32,F64}` widening — see the arm.
//
// One list, consulted by the checker's definition reservation, the emitter's dispatch,
// the tail-value classifier, the statement `drop` suppression and the memory-usage scan
// — so the five cannot drift.
export function nameIsMemStoreIntrinsic(name: string) {
  if name == "__store_i64__" { return true }
  if name == "__store_f32__" { return true }
  if name == "__store_f64__" { return true }
  if name == "__store_i8__" { return true }
  if name == "__store_i16__" { return true }
  false
}

// THE DECLARED-BUT-UNLOWERED MEMORY INTRINSICS — the ones that pass `vl check` and then
// die at emit with `emitProgram: call to unknown function`. Re-censused at each head, in
// three call POSITIONS each (statement / value / binding), against the names
// `defaultScope` declares: #1170 gave the load-width matrix and `memory.size`/
// `memory.grow` their arms (twelve lowering, five not), the wide store widths got
// theirs next, and THIS change adds the narrow store pair and the bulk pair — declared
// and lowered in the same commit, so they never spend a day on this list. TWO remain:
//
//   `__store_string__`  `__log_string__`                — host-boundary string sinks
//
// Named here so the CHECKER says that, positioned and in the author's terms, instead of
// letting the call reach the emitter and come back as `call to unknown function` — a
// message that reads like a TYPO'D IDENTIFIER when the identifier is real and the
// IMPLEMENTATION is what is missing. `docs/internals/memory-gc-design.md` §1.2 filed
// exactly that as "the half worth fixing first"; this is that half.
//
// The two string sinks are NOT a table entry away: `__store_string__` would have to copy
// a GC `(array i32)` into linear memory with no byte encoding decided, and `__log_string__`
// is a host import the native runner does not provide. Each needs a design.
export function nameIsUnimplementedIntrinsic(name: string) {
  if name == "__store_string__" { return true }
  if name == "__log_string__" { return true }
  false
}

// The shared rejection for a definition that binds an emitter-intrinsic name.
function checkNotEmitterIntrinsic(name: string, at: i32) {
  if nameIsEmitterIntrinsic(name) {
    tErr(
      "'" +
        name +
        "' is a compiler intrinsic and cannot be redefined — every call to it lowers to instructions inline, so this definition would never run",
      at,
    )
  }
  0
}

// ── scope chain ──────────────────────────────────────────────────────────────

// ── flow narrowing (condition collectors) ────────────────────────────────────
// The canonical narrowing key for a "place" — a bare name (`x`) or a property
// path rooted at one (`o.v`, `o.v.w`) — or "" for anything else (a call, an
// index, a literal: not a stable place to narrow). Mirrors the host's
// `placeKey`; `x?.y` keys the same place as `x.y`, so a guard written with
// `?.` refines the regular `x.y` reads in the branch body.
function placeKeyOf(ix: i32) {
  const n = P.nodes[ix]
  if n is Ident { return n.identName }
  if n is Member {
    const base = placeKeyOf(n.memObj)
    if base == "" { return "" }
    return base + "." + n.memProp
  }
  if n is OptMember {
    const base = placeKeyOf(n.omObj)
    if base == "" { return "" }
    return base + "." + n.omProp
  }
  ""
}

// The overlay SLOT of the innermost narrowing of `key`, or -1 when `key` was never
// narrowed in a live scope. The single walk the three overlay questions share — the
// type, the invalidator, and how the slot sits relative to a loop barrier.
function narrowedPathIx(key: string) {
  let i = npKeys.length - 1
  while i >= 0 {
    if npKeys[i] == key { return i }
    i = i - 1
  }
  -1
}

// The innermost narrowed-path overlay entry for `key`, or -1 — which means EITHER
// "never narrowed" OR "narrowed and since invalidated by an aliasing write or a
// falsifying assignment". One function answers "is this narrowing in force", so the
// two readers that matter — the member/optional-member read arms and `placeCurTy`'s
// fact collection — cannot disagree. Fact collection wants exactly this reading too:
// after `clr(o)` a fresh `if o.v != null` must re-derive the narrowing from the
// DECLARED field type, not from the stale non-null one.
function narrowedPathTy(key: string) {
  const i = narrowedPathIx(key)
  if i < 0 { return -1 }
  if npInvBy[i] >= 0 { return -1 }
  npTys[i]
}

// The node that invalidated the innermost narrowing of `key`, or -1 when `key` is
// narrowed-and-in-force or was never narrowed. The two states `narrowedPathTy`
// folds into -1 are told apart here, and only for the diagnostic: an unguarded
// nullable read keeps its existing message, an invalidated one names the call or
// the write.
function narrowedPathInvBy(key: string) {
  const i = narrowedPathIx(key)
  if i < 0 { return -1 }
  npInvBy[i]
}

// Whether `s` begins with `pfx`. (The slice is bound before it is compared: a bare
// member call in TAIL position is not a lowerable statement — see format.vl's note.)
function keyHasPrefix(s: string, pfx: string) {
  if pfx.length > s.length { return false }
  const head = s.slice(0, pfx.length)
  head == pfx
}

// The sub-path of the place at `ix` below root name `root` — `o.v` under `o` is
// `"v"`, `o.a.v` under `o` is `"a.v"`. `""` when the place is not rooted at `root`,
// is `root` itself (rebinding the parameter is not a field write), or is not a
// keyable place at all (an index target keys nothing, and no narrowing key can name
// one either, so the two sides stay consistent).
function placeSubPath(ix: i32, root: string) {
  const k = placeKeyOf(ix)
  if k == "" || k == root { return "" }
  const pfx = root + "."
  if !keyHasPrefix(k, pfx) { return "" }
  const sub = k.slice(pfx.length, k.length)
  sub
}

// WRITE-EFFECT SUMMARIES for the effect-based invalidation rule, keyed
// `"<fn-node-ix>#<param-ix>"`. A value is either the OPAQUE token `"*"` — assume the
// callee writes everything reachable through that parameter — or a `,`-TERMINATED
// list of the field sub-paths it may write (`"v,a.v,"`). Keyed by the callee's arena
// index rather than its name, so two nested functions sharing a name (which capture
// analysis is already name-confused about) cannot share a summary.
//
// `weOpen` is the in-progress stack. A recursive cycle answers `"*"`, not "writes
// nothing": a summary that guesses must guess CLOSED, and a one-pass walk has no
// fixpoint to fall back on.
//
// A MAP, not parallel arrays, because the bank is read once per (live narrowing ×
// call) while it grows one entry per summarised (callee, parameter): a scan makes the
// predicate quadratic in the number of DISTINCT callees a guarded region calls, which
// is the dominant term for property-path guards. `""` is a legitimate value ("writes
// nothing"), so presence is asked with `has` and never inferred from the value.
let weSums: {[string]: string} = Map()
let weOpen: string[] = []

// The function bodies currently being summarised, innermost last. A call inside a
// callee body may name a function declared in that body — or in a sibling frame of it
// — and `lookupFnDeclNode` reads the CALLER's scope chain, where neither is visible.
// Answering "not a function" there is what made the whole nested-write route fail
// OPEN: `function outer(x) { function inner(y) { y.v = null }  inner(x) }` summarised
// as writing nothing.
let weRoots: i32[] = []

// Counts cycles CUT during the walk, so a provisional summary is not cached. Cutting
// a cycle at ⊥ and iterating is the least fixpoint of a may-write analysis, and for
// the key that was QUERIED the first pass already reaches it — `X = base ∪ X` has
// least solution `base`. An inner key on the cycle does NOT: `g` computed while `f`
// was open is missing `f`'s own writes, so caching it would answer a later
// independent query with a summary that is too small.
let weCut = 0

// Answer a recursive cycle OPAQUE instead of ⊥ — the strictly-fail-closed reading.
// It is sound but costs every read-only recursive callee: measured at 18 of 348 grid
// cells newly rejecting CORRECT programs, all of them that one shape, against 0 for
// the fixpoint. Kept as a switch because it is the conservative fallback if the
// fixpoint argument above is ever found wanting.
const ALIAS_CYCLE_OPAQUE = false

// Set to make every statically-known callee answer OPAQUE — the BROAD rule ("any
// call receiving the object invalidates every narrowing rooted at it"), kept as one
// switch so the two candidate rules are one code path and one measurement harness.
// The effect-based rule is what ships; see docs/internals/open-rulings.md.
const ALIAS_RULE_BROAD = false

// Split a `,`-terminated effect summary into its sub-paths.
function weSplit(s: string) {
  const out: string[] = []
  let start = 0
  let i = 0
  while i < s.length {
    if s[i] == ',' {
      if i > start { out.push(s.slice(start, i)) }
      start = i + 1
    }
    i = i + 1
  }
  out
}

// The write-effect summary of parameter `paramIx` of the `FuncDecl` at `fnIx`.
function fnWriteEffects(fnIx: i32, paramIx: i32) {
  const key = i32ToStr(fnIx) + "#" + i32ToStr(paramIx)
  if weSums.has(key) { return weSums[key] ?? "*" }
  if weIsOpen(key) { return weCycleAnswer() }
  const fd = P.nodes[fnIx]
  if fd is FuncDecl {
    const ps = fd.fnParams
    if paramIx >= 0 && paramIx < ps.length {
      const p = P.nodes[ps[paramIx]]
      if p is Param {
        const cutBefore = weCut
        weOpen.push(key)
        weRoots.push(fd.fnBody)
        const acc = weScan(fd.fnBody, p.parName)
        weRoots.pop()
        weOpen.pop()
        weCache(key, acc, cutBefore)
        return acc
      }
    }
  }
  "*"
}

// Whether a summary for `key` is already being computed higher in the recursion.
function weIsOpen(key: string) {
  let i = 0
  while i < weOpen.length {
    if weOpen[i] == key { return true }
    i = i + 1
  }
  false
}

// What a cut cycle answers: ⊥ for the fixpoint reading, opaque for the strict one.
function weCycleAnswer() {
  weCut = weCut + 1
  if ALIAS_CYCLE_OPAQUE { return "*" }
  ""
}

// Cache a summary unless it is PROVISIONAL — computed with a cycle cut while another
// summary was still open, which is the one case the first pass leaves too small.
function weCache(key: string, acc: string, cutBefore: i32) {
  if weCut != cutBefore && weOpen.length > 0 { return 0 }
  weSums[key] = acc
  0
}

// The `FuncDecl` named `name` declared inside any body currently being summarised,
// innermost frame first, or -1.
function findFnDeclInRoots(name: string) {
  let i = weRoots.length - 1
  while i >= 0 {
    const d = findFnDeclIn(weRoots[i], name)
    if d >= 0 { return d }
    i = i - 1
  }
  -1
}

// The subtree walk, MEMOISED on `(rootIx, name)`. Every query inside one summary asks
// the same root, and an INTRINSIC call (`print`) asks a name no root holds — so the
// uncached walk is re-run per call in the body, making one summary quadratic in the
// number of calls that body makes. The NEGATIVE answer is the one worth banking:
// `-1` means "this subtree was walked and holds no such declaration".
//
// The memo is exact rather than approximate. `findFnDeclWalk` is a pure function of
// `(P.nodes, rootIx, name)` and the checker appends no nodes, so a banked answer is
// the answer the walk would give.
//
// KEYING ON THE ROOT IS LOAD-BEARING. The same name resolves to different
// declarations under different enclosing bodies, so a name-only memo — or a flat
// module-wide name→declaration map — can answer a declaration this walk would never
// reach. That direction fails OPEN: `callDeclFnIx` would summarise an unrelated body
// as writing nothing where it owes the caller the opaque answer.
function findFnDeclIn(rootIx: i32, name: string) {
  if rootIx < 0 || rootIx >= P.nodes.length { return -1 }
  const key = i32ToStr(rootIx) + "#" + name
  if weFnDecls.has(key) { return weFnDecls[key] ?? -1 }
  const d = findFnDeclWalk(rootIx, name)
  weFnDecls[key] = d
  d
}

// Memo bank for `findFnDeclIn`, keyed `"<subtree-root-node-ix>#<name>"`.
let weFnDecls: {[string]: i32} = Map()

// The uncached pre-order walk: the FIRST `FuncDecl` named `name` in the subtree, the
// root itself included, or -1.
function findFnDeclWalk(rootIx: i32, name: string) {
  if rootIx < 0 || rootIx >= P.nodes.length { return -1 }
  const n = P.nodes[rootIx]
  if n is FuncDecl {
    if n.fnName == name { return rootIx }
  }
  const kids = nodeChildren(rootIx)
  let i = 0
  while i < kids.length {
    const d = findFnDeclWalk(kids[i], name)
    if d >= 0 { return d }
    i = i + 1
  }
  -1
}

// Accumulate the field sub-paths a subtree may write through the parameter named
// `pname`, or `"*"` for opaque. Three things make it opaque, each a construct whose
// later effect this walk cannot bound:
//   * the parameter ESCAPES — stored into a field, an element, or returned. Whoever
//     holds it afterwards can write any field through it.
//   * it reaches an INDIRECT call (a function-typed value, a struct field holding a
//     function, a first-class callee) whose target is not statically one `FuncDecl`.
//   * it reaches a call whose declaration cannot be resolved at all.
// Nested `FuncDecl`s ARE descended: a capturing inner function writing `pname.v` is
// a write through the parameter. An inner function that shadows `pname` with its own
// binding of the same name over-approximates, which is the safe direction.
function weScan(ix: i32, pname: string) {
  if ix < 0 || ix >= P.nodes.length { return "" }
  let acc = ""
  const n = P.nodes[ix]
  if n is BinExpr {
    if n.binOp == "=" {
      const sub = placeSubPath(n.binLeft, pname)
      if sub != "" { acc = acc + sub + "," }
      // the parameter itself stored into the heap — it escapes
      if placeKeyOf(n.binRight) == pname { return "*" }
    }
  } else if n is RetStmt {
    if n.retArg >= 0 {
      if placeKeyOf(n.retArg) == pname { return "*" }
    }
  } else if n is Call {
    const inner = callEffectsOn(ix, pname)
    if inner == "*" { return "*" }
    acc = acc + inner
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    const sub = weScan(kids[i], pname)
    if sub == "*" { return "*" }
    acc = acc + sub
    i = i + 1
  }
  acc
}

// The field sub-paths a CALL inside a callee body may write through `pname`, by
// composing the nested callee's own summary: passing `pname.a` where the nested
// callee writes `v` through that parameter is a write of `a.v` here.
function callEffectsOn(callIx: i32, pname: string) {
  const cn = P.nodes[callIx]
  if cn is Call { return callEffectsOnReal(cn, pname) }
  ""
}

function callEffectsOnReal(cn: Call, pname: string) {
  const declIx = callDeclFnIx(cn)
  // An intrinsic cannot write a field of anything handed to it, so a body whose only
  // use of the parameter is `print(p.v)` has NO write effect. Distinguishing this from
  // the opaque `-1` is what keeps a read-only callee from invalidating its caller's
  // narrowings — the false positive that decides whether the rule is usable at all.
  if declIx == -2 { return "" }
  const args = callArgPlaces(cn)
  let acc = ""
  let i = 0
  while i < args.length {
    const ak = placeKeyOf(args[i])
    let rooted = ak == pname
    let below = ""
    if !rooted {
      const s = placeSubPath(args[i], pname)
      if s != "" {
        rooted = true
        below = s + "."
      }
    }
    if rooted {
      if declIx < 0 {
        return "*" // indirect / unresolvable callee
      }
      const sum = fnWriteEffects(declIx, i)
      if sum == "*" { return "*" }
      const parts = weSplit(sum)
      let j = 0
      while j < parts.length {
        acc = acc + below + parts[j] + ","
        j = j + 1
      }
    }
    i = i + 1
  }
  acc
}

// A call's argument places in CALLEE-PARAMETER order. A UFCS/method callee
// (`o.m(a)`) puts the receiver at parameter 0, which is how `m(o, a)` declares it;
// every other shape is the written argument list.
function callArgPlaces(cn: Call) {
  const out: i32[] = []
  const cf = P.nodes[cn.callFn]
  if cf is Member {
    if lookupFnDeclNode(cf.memProp) >= 0 { out.push(cf.memObj) }
  }
  let i = 0
  while i < cn.callArgs.length {
    out.push(cn.callArgs[i])
    i = i + 1
  }
  out
}

// The callee classification behind every invalidation decision:
//   >= 0  the `FuncDecl` the call resolves to STATICALLY (a UFCS receiver occupies
//         parameter 0), so its write effects can be summarised.
//   -1    OPAQUE — a function VALUE, a struct field holding one, or a receiver whose
//         type did not resolve. The target is not statically one body, so assume it
//         writes anything reachable.
//   -2    an INTRINSIC — `print`, or a string/array/map/set method. It writes no
//         field of an object handed to it, and saying so is what keeps a read-only
//         callee from invalidating its caller's narrowings.
function callDeclFnIx(cn: Call) {
  const cf = P.nodes[cn.callFn]
  if cf is Ident {
    const d = lookupFnDeclNode(cf.identName)
    if d >= 0 { return d }
    const nd = findFnDeclInRoots(cf.identName)
    if nd >= 0 { return nd }
    if lookup(cf.identName) >= 0 {
      return -1 // a function VALUE: target unknown
    }
    return -2 // an intrinsic named by a bare identifier
  }
  if cf is Member {
    const d = lookupFnDeclNode(cf.memProp)
    if d >= 0 { return d }
    const nd = findFnDeclInRoots(cf.memProp)
    if nd >= 0 { return nd }
    return memberCalleeKind(cf)
  }
  -1
}

// A non-UFCS member callee: a STRUCT FIELD holding a function is opaque (the value it
// holds is not statically one body), anything else is a collection/string method.
function memberCalleeKind(cf: Member) {
  const rt = nodeTyOf(cf.memObj)
  if rt < 0 {
    return -1 // receiver type unresolved → fail closed
  }
  const t = T.tys[rt]
  if t is TyObj {
    if objFieldType(t, cf.memProp) >= 0 { return -1 }
  }
  -2
}

// The type recorded for a node by the check that already visited it, or -1.
function nodeTyOf(ix: i32) {
  if ix < 0 || ix >= nodeTyIx.length { return -1 }
  nodeTyIx[ix]
}

// The names a function BINDS: its parameters, every `let`/`const` in its body at any
// depth, both `for` variables, and every nested function's parameters and name. A
// write rooted at one of these is local business; a write rooted at anything else is
// a write through a FREE variable, which is the caller's binding.
function fnBoundNames(fnIx: i32, out: string[]) {
  const n = P.nodes[fnIx]
  if n is FuncDecl {
    let i = 0
    while i < n.fnParams.length {
      const p = P.nodes[n.fnParams[i]]
      if p is Param { out.push(p.parName) }
      i = i + 1
    }
  }
  if n is LetDecl { out.push(n.letName) }
  if n is ForRange { out.push(n.frVar) }
  if n is ForIn { out.push(n.fiVar) }
  const kids = nodeChildren(fnIx)
  let k = 0
  while k < kids.length {
    if kids[k] >= 0 { fnBoundNames(kids[k], out) }
    k = k + 1
  }
  0
}

function nameIn(names: string[], name: string) {
  let i = 0
  while i < names.length {
    if names[i] == name { return true }
    i = i + 1
  }
  false
}

// The FULL place keys a function writes through a FREE variable — a captured local or
// a module-level binding — `,`-terminated, or `"*"` for opaque.
//
// WHY THIS CHANNEL EXISTS: the parameter channel is keyed on ARGUMENTS, so a callee
// that takes none cannot be seen through it. `function zap() { o.v = null }` called
// inside `if o.v != null { … }` is exactly as falsifying as `clr(o)` and was exactly
// as invisible. A capturing nested function and a capturing closure are the two
// mutation routes that reach a field with no argument at all.
function fnWriteFreePaths(fnIx: i32) {
  const key = i32ToStr(fnIx) + "#free"
  if weSums.has(key) { return weSums[key] ?? "*" }
  if weIsOpen(key) { return weCycleAnswer() }
  const fd = P.nodes[fnIx]
  if fd is FuncDecl {
    const bound: string[] = []
    fnBoundNames(fnIx, bound)
    const cutBefore = weCut
    weOpen.push(key)
    weRoots.push(fd.fnBody)
    const acc = weScanFree(fd.fnBody, bound)
    weRoots.pop()
    weOpen.pop()
    weCache(key, acc, cutBefore)
    return acc
  }
  "*"
}

// Accumulate the free-variable place keys a subtree writes, composing a nested known
// callee's own free writes. An opaque nested callee makes the whole answer opaque.
function weScanFree(ix: i32, bound: string[]) {
  if ix < 0 || ix >= P.nodes.length { return "" }
  let acc = ""
  const n = P.nodes[ix]
  if n is BinExpr {
    if n.binOp == "=" {
      const k = placeKeyOf(n.binLeft)
      if k != "" && isPathKey(k) {
        if !nameIn(bound, placeRootOf(k)) { acc = acc + k + "," }
      }
    }
  } else if n is Call {
    const inner = callFreeEffects(ix)
    if inner == "*" { return "*" }
    acc = acc + inner
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    const sub = weScanFree(kids[i], bound)
    if sub == "*" { return "*" }
    acc = acc + sub
    i = i + 1
  }
  acc
}

// The free-variable writes a nested CALL contributes. An intrinsic contributes none;
// an opaque callee makes the answer opaque.
function callFreeEffects(callIx: i32) {
  const cn = P.nodes[callIx]
  if cn is Call {
    const d = callDeclFnIx(cn)
    if d == -2 { return "" }
    if d < 0 { return "*" }
    return fnWriteFreePaths(d)
  }
  ""
}

// The ROOT name of a place key (`"o.a.v"` → `"o"`).
function placeRootOf(key: string) {
  let i = 0
  while i < key.length {
    if key[i] == '.' {
      const head = key.slice(0, i)
      return head
    }
    i = i + 1
  }
  key
}

// THE ONE PLACE that decides whether the call at `callIx` invalidates the path
// narrowing keyed `key`. Everything else about aliased writes is bookkeeping around
// this answer.
//
// The rule is EFFECT-BASED: `key` dies only when some argument place `ak` of the call
// is a prefix of `key` AND the callee may write, through that parameter, a sub-path
// that is a prefix of the rest of `key`. Writing `o.a` kills `o.a.v` (the sub-object
// is replaced), writing `o.w` leaves `o.v` alone, and a callee that only READS keeps
// every narrowing — which is what makes the rule usable rather than merely sound.
//
// It fails CLOSED at every edge: an unresolvable or first-class callee, a recursive
// cycle, and a parameter that escapes all answer "writes everything".
//
// THE HOLE IT DOES NOT CLOSE, stated so the next reader does not read the rule as
// total: invalidation is keyed on the SYNTACTIC argument. `const p = o` then `clr(p)`
// leaves a narrowing on `o.v` in force, because nothing connects the two names. That
// is an aliasing question this checker has no machinery for; the measured grid marks
// the cell, and closing it needs a may-alias relation, not a wider write rule.
function callInvalidatesNarrowedPath(callIx: i32, key: string) {
  const cn = P.nodes[callIx]
  if cn is Call { return callInvalidatesReal(cn, key) }
  false
}

function callInvalidatesReal(cn: Call, key: string) {
  const declIx = callDeclFnIx(cn)
  // An intrinsic writes no object field. The BROAD rule as filed does not make that
  // distinction — "any call that receives the object" includes `print(o)` — so the
  // switch bypasses this too, and the two measurements compare the filed rules
  // rather than a hybrid.
  if declIx == -2 && !ALIAS_RULE_BROAD { return false }
  // AN OPAQUE CALLEE INVALIDATES EVERY LIVE NARROWING, not only the ones rooted at
  // its arguments. A closure that captured the object takes NO argument, so an
  // argument-keyed fallback would fail open on exactly the construct that has no
  // statically known body.
  if declIx < 0 { return true }
  // Writes through a FREE variable, which likewise need no argument.
  const free = fnWriteFreePaths(declIx)
  if free == "*" { return true }
  if pathHitsAny(key, free, "") { return true }
  const args = callArgPlaces(cn)
  let i = 0
  while i < args.length {
    const ak = placeKeyOf(args[i])
    if ak != "" {
      if key == ak { return true }
      const pfx = ak + "."
      if keyHasPrefix(key, pfx) {
        if ALIAS_RULE_BROAD { return true }
        const sum = fnWriteEffects(declIx, i)
        if sum == "*" { return true }
        const rest = key.slice(pfx.length, key.length)
        if pathHitsAny(rest, sum, "") { return true }
      }
    }
    i = i + 1
  }
  false
}

// Whether any written sub-path in the `,`-terminated summary `sum` (each optionally
// carried under `under`) is `path` itself or a PREFIX of it. Writing `o.a` replaces
// the sub-object, so it kills `o.a.v` as surely as writing `o.a.v` does.
function pathHitsAny(path: string, sum: string, under: string) {
  const parts = weSplit(sum)
  let j = 0
  while j < parts.length {
    const w = under + parts[j]
    if path == w || keyHasPrefix(path, w + ".") { return true }
    j = j + 1
  }
  false
}

// RE-EXECUTION BARRIERS: the scope depth and overlay height at entry to each open
// loop body and nested-function body, innermost last.
//
// A narrowing retires at a falsifying write because the statements AFTER the write
// run with the narrowing gone — a statement-order fact. A loop body breaks that
// reading: it is checked once and executed many times, so the reads textually BEFORE
// the write run again after it. `if q != null { while c { use(q)   q = null } }` is
// exactly that shape and `use(q)` sees a null on the second iteration.
//
// The narrowing a loop's OWN condition establishes is different: the condition is
// re-tested on every back edge, so it holds on entry to every iteration whatever the
// body wrote. `while q != null { use(q)   q = null }` — the idiom the retirement
// rule exists to allow — is therefore sound with no back-edge analysis, and so is a
// guard INSIDE the body. Both sit at or above the barrier mark; a narrowing from an
// enclosing guard sits below it. A nested FUNCTION body carries the same hazard for
// the same reason (the body may run any number of times, at any point), and takes the
// same mark.
//
// A write that would retire a narrowing BELOW the innermost mark keeps its reject.
// That is master's verdict for every such program, so the barrier bounds the
// widening rather than trading one unsound acceptance for another.
let reScopeBases: i32[] = []
let reNpBases: i32[] = []

// Enter / leave a re-execution barrier. Call BEFORE the body's narrowing scope is
// pushed, so a narrowing the loop's own condition contributes counts as inside.
function pushReBarrier() {
  reScopeBases.push(T.scopes.length)
  reNpBases.push(npKeys.length)
  0
}
function popReBarrier() {
  if reScopeBases.length > 0 {
    reScopeBases.pop()
    reNpBases.pop()
  }
  0
}

// Whether a bare-name narrowing shadowing at scope depth `depth` was established
// inside the innermost open barrier — i.e. re-established every time the write runs.
function narInsideBarrier(depth: i32) {
  if reScopeBases.length == 0 { return true }
  depth >= reScopeBases[reScopeBases.length - 1]
}

// The same question for a property-path narrowing, by overlay slot.
function npInsideBarrier(npIx: i32) {
  if reNpBases.length == 0 { return true }
  npIx >= reNpBases[reNpBases.length - 1]
}

// Whether a live narrowing DOES overlay the write target but sits below the innermost
// re-execution barrier — the one reason `writeStorageTy` answers -1 for a place a
// narrowing covers. Asked only to choose the diagnostic: the write is refused either
// way, but "cannot assign null to i32" says nothing about why the same write one block
// out is fine.
function writeBarredByLoop(ix: i32) {
  const n = P.nodes[ix]
  if n is Ident {
    if narDeclaredTy(n.identName, NAR_KIND_GUARD) < 0 { return false }
    return !narInsideBarrier(lookupDepth(n.identName))
  }
  if n is Member {
    const key = placeKeyOf(ix)
    if key == "" { return false }
    const slot = narrowedPathIx(key)
    if slot < 0 || npInvBy[slot] >= 0 { return false }
    return !npInsideBarrier(slot)
  }
  false
}

// The diagnostic for a write the re-execution barrier refuses. It names the loop rather
// than the type, because the type is fine: the same write one block further out is
// accepted, and so is this one under a guard the loop itself re-tests.
function writeBarredErr(place: string, at: i32) {
  tErr(
    "'" +
      place +
      "' was narrowed by a guard OUTSIDE this loop, so this write would leave the " +
      "reads before it reading null on the next iteration — move the write out of " +
      "the loop, or make the guard on '" +
      place +
      "' the loop's own condition",
    at,
  )
  0
}

// THE STORAGE TYPE OF AN ASSIGNMENT TARGET — what the place can HOLD, as against
// what a narrowing currently proves it holds — or -1 when no live narrowing overlays
// the place and the flow type IS the storage type. That -1 covers every place in a
// program with no narrowing, so this is exactly the set of writes a narrowing used to
// shrink.
//
// A bare NAME reads the narrowing bank, because the guard's shadowing `declare` hid
// the declaration in an outer scope. A property PATH reads the field off the
// RECEIVER's own type, because the overlay keys the path string and never touches the
// struct's field types; the receiver keeps its own narrowing, since a non-null
// receiver is what makes the field reachable at all.
//
// Returns -1 across a re-execution barrier (see `narInsideBarrier`): the write stays
// rejected there, which is master's verdict.
function writeStorageTy(ix: i32) {
  const n = P.nodes[ix]
  if n is Ident {
    // An ASSIGNMENT narrowing's null write is accepted today, barrier or not — and
    // `let x: i32 | null = null` / `x = 5` / `while c { use(x)   x = null }` is a
    // CORRECT program for a single-iteration loop, so barring it would newly reject
    // working code. Only the guard-kind acceptance is new, so only it is bounded.
    const gSlot = narGuardSlot(n.identName)
    if gSlot >= 0 {
      if asgDeclEpochs[gSlot] != narFnEpoch { return -1 }
      if !narInsideBarrier(lookupDepth(n.identName)) { return -1 }
      return asgDeclTys[gSlot]
    }
    return narDeclaredTy(n.identName, NAR_KIND_ASG)
  }
  if n is Member {
    const key = placeKeyOf(ix)
    if key == "" { return -1 }
    const slot = narrowedPathIx(key)
    if slot < 0 || npInvBy[slot] >= 0 { return -1 }
    if npEpochs[slot] != narFnEpoch { return -1 }
    if !npInsideBarrier(slot) { return -1 }
    const noNames: string[] = []
    const noTys: i32[] = []
    return placeFieldTy(placeCurTy(n.memObj, noNames, noTys), n.memProp, false)
  }
  -1
}

// DOES A WRITE TO `tgtKey` OF A VALUE TYPED `rt` RETIRE THE NARROWING `(key, npTy)`?
// The one home for that question — both the bare-name and the property-path
// retirement sides ask it, so they cannot disagree, and the read arms' "is this
// narrowing in force" reading stays the complement of it.
//
// Three ordered legs:
//   * PLACE. The write must name the narrowed place or a PREFIX of it. `o.v = …`
//     retires `o.v` and also `o.v.w` (the sub-object is a different object now),
//     while `o.w = …` retires neither. An unkeyable target (`xs[i] = …`) names no
//     place and retires nothing — and no narrowing can key one either, so both sides
//     stay consistent.
//   * VALUE, for an EXACT place match: a write the narrowing still admits keeps it.
//     `if q != null { q = 5   use(q) }` must keep reading `q` as non-null, and
//     `assignable` is the same relation every other reader of a narrowed type uses.
//   * A PREFIX match retires UNCONDITIONALLY, whatever the value's type: the place
//     now holds a different object, and nothing is known about its fields. Without
//     this leg the widening is unsound on its own terms — `if o != null && o.v !=
//     null { o = null   use(o.v) }` reads `o.v` off a null receiver, because the
//     member arm answers from the overlay before it ever checks the receiver.
function writeRetiresNarrowing(
  tgtKey: string,
  rt: i32,
  key: string,
  npTy: i32,
) {
  if tgtKey == "" { return false }
  if key == tgtKey { return !assignable(rt, npTy) }
  keyHasPrefix(key, tgtKey + ".")
}

// Retire every narrowing the accepted write at `atIx` falsifies, IN PLACE — never by
// pushing a shadowing entry. A push unwinds at the end of whatever inner block holds
// the write and resurrects the narrowing for the statements after it
// (`if q != null { if c { q = null }   use(q) }` must stay rejected), which is the
// same reason `npInvBy` overwrites rather than pushes.
//
// The in-place form differs by spelling and the difference is only mechanical: a
// property path is marked in `npInvBy`, and a bare name's narrowing is a shadowing
// `declare`, so retiring it means writing the declared type back into THE SCOPE THE
// GUARD PUSHED. Both then retire for good when that scope pops.
function retireNarrowingsForWrite(tgtIx: i32, rt: i32, atIx: i32) {
  const tgtKey = placeKeyOf(tgtIx)
  if tgtKey == "" { return 0 }
  let i = 0
  while i < npKeys.length {
    if npInvBy[i] < 0 {
      if writeRetiresNarrowing(tgtKey, rt, npKeys[i], npTys[i]) {
        npInvBy[i] = atIx
      }
    }
    i = i + 1
  }
  const tn = P.nodes[tgtIx]
  if tn is Ident {
    const nm = tn.identName
    const dcl = narDeclaredTy(nm, -1)
    if dcl >= 0 {
      if writeRetiresNarrowing(nm, rt, nm, lookup(nm)) {
        // The DECLARED type goes back into the scope the narrowing shadowed, so a
        // LATER write to the same name is checked against the storage again.
        const d = lookupDepth(nm)
        if d >= 0 { T.scopes[d][nm] = dcl }
      }
    }
  }
  0
}

// Mark every live narrowing the call at `callIx` invalidates. Runs AFTER the call's
// own arguments are checked, so `f(o.v.length, o)` still reads `o.v` under the
// narrowing that held when the argument was evaluated.
function noteCallInvalidations(callIx: i32) {
  if npKeys.length == 0 { return 0 }
  let i = 0
  while i < npKeys.length {
    if npInvBy[i] < 0 {
      if callInvalidatesNarrowedPath(callIx, npKeys[i]) { npInvBy[i] = callIx }
    }
    i = i + 1
  }
  0
}

// The source line of a node, or 0 when it has no anchor token.
function nodeLineOf(at: i32) {
  if at >= 0 && at < nodeToks.length {
    const tk = nodeToks[at]
    if tk >= 0 && tk < P.toks.length { return P.toks[tk].line }
  }
  0
}

// The callee's written name, for the diagnostic. `"?"` when the callee is neither a
// bare name nor a member access (a parenthesised or computed callee).
function calleeNameOf(callIx: i32) {
  const cn = P.nodes[callIx]
  if cn is Call {
    const cf = P.nodes[cn.callFn]
    if cf is Ident { return cf.identName }
    if cf is Member { return cf.memProp }
  }
  "?"
}

// The diagnostic for reading a path whose narrowing a write retired. It names the
// WRITE, not merely the nullness, because the write is what the reader has to act on —
// the guard above is correct and the read below is correct, and only their separation
// by that write is wrong. An ALIASING CALL and a direct ASSIGNMENT are the two ways a
// path narrowing dies, and the message says which, because "the call to '?'" for a
// plain `o.v = null` sends the reader looking for a call there is none of.
function pathInvalidatedErr(key: string, byIx: i32, at: i32) {
  const by = P.nodes[byIx]
  let what = "the assignment"
  let after = "the assignment"
  if by is Call {
    what = "the call to '" + calleeNameOf(byIx) + "'"
    after = "the call"
  }
  tErr(
    "'" +
      key +
      "' was narrowed by a guard, but " +
      what +
      " on line " +
      i32ToStr(nodeLineOf(byIx)) +
      " can write it — re-test '" +
      key +
      "' after " +
      after,
    at,
  )
  TY_ERR
}

// The node index of the place compared against `null` in a `x == null` /
// `x != null` / `null == x` comparison, or -1 (not a null compare).
function nullCmpPlace(condIx: i32) {
  const cond = P.nodes[condIx]
  if cond is BinExpr {
    const lhs = P.nodes[cond.binLeft]
    const rhs = P.nodes[cond.binRight]
    if rhs is NullLit { return cond.binLeft }
    if lhs is NullLit { return cond.binRight }
  }
  -1
}

// Whether `ty` is the `null` primitive (compared structurally — `null` may be
// interned more than once across annotations).
function isNullTy(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyPrim { return t.primName == "null" }
  false
}

// Whether `ty` is the `void` primitive (compared STRUCTURALLY — like `null`, `void` may
// be interned at more than one arena index, so `== TY_VOID` is not reliable).
function isVoidTy(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyPrim { return t.primName == "void" }
  false
}

// Whether `ty` CARRIES a `void` — the primitive itself, or a `void` MEMBER of a union /
// nullable. No value has such a type: `void | i32` is what an if-expression with one void
// arm and one value arm joins to, and it reaches a value slot exactly where a plain `void`
// does (`print(if c { f() } else { 1 })` emitted a module that fails to validate).
//
// Depth-bounded like the other structural walks. Composites (array / map / struct / fn)
// are deliberately NOT descended: a `void` inside one is refused at the element or field
// slot that built it, which names the position the author wrote.
function tyMentionsVoid(ty: i32, depth: i32) {
  if ty < 0 { return false }
  if depth <= 0 { return false }
  if isVoidTy(ty) { return true }
  const t = T.tys[ty]
  if t is TyUnion {
    const ms = t.uMembers
    let mi = 0
    while mi < ms.length {
      if tyMentionsVoid(ms[mi], depth - 1) { return true }
      mi = mi + 1
    }
    return false
  }
  if t is TyNullable { return tyMentionsVoid(t.nInner, depth - 1) }
  false
}

// Whether the expression at `exprIx` (peeled through parens) is an if-EXPRESSION or a
// `match` — the two void-typed expression FORMS every void-in-value-slot gate exempts,
// and the one predicate all of them ask.
//
// A statement-`if` and a void-armed `match` type context-free `void`, but that `void` is
// PROVISIONAL: the `let`/`const` initializer position resolves an else-less if-expression
// to `T | null` instead (`checkIfStmtNode`'s tail, gated on `letInitIfIx`), so a gate that
// fired here would refuse a program that path types correctly. In the positions the
// emitter genuinely cannot lower, it names the real defect — `emitProgram: if-expression
// requires an else arm` names the missing `else`, which a "got void" wording cannot — so
// those keep the emitter's message rather than trading it for a vaguer one.
function voidSlotExemptExpr(exprIx: i32) {
  if exprIx < 0 { return false }
  let vi = exprIx
  const vp = P.nodes[vi]
  if vp is Paren { vi = vp.parInner }
  const vn = P.nodes[vi]
  if vn is IfStmt { return true }
  if vn is MatchExpr { return true }
  false
}

// A `void` expression HAS no value, so a slot that DEMANDS one is a type error. This is
// the one home for that verdict on the positions whose demanded type comes from
// INFERENCE: with no written type there is nothing for `assignable` to compare against,
// so the "cannot assign void to … of type T" / "expected T, got void" messages that cover
// the ANNOTATED positions never fire, and the void reached codegen — which has no value to
// put on the stack and emitted a module that fails to validate.
//
// `slot` names the demanding position, in the `<slot> expects …, got <ty>` shape the
// checker's other slot messages already use. Answers whether the slot was refused, so the
// caller can substitute `TY_ERR` and keep one mistake to one diagnostic.
function voidValueSlotErr(ty: i32, exprIx: i32, slot: string, at: i32) {
  if !tyMentionsVoid(ty, 8) { return false }
  // The provisional-void exemption covers a WHOLLY void if/match only: a union that
  // MENTIONS void is a MIXED arm join (`if c { f() } else { 1 }`), where the void is one
  // arm's real type and no position resolves it away.
  if isVoidTy(ty) {
    if voidSlotExemptExpr(exprIx) { return false }
  }
  tErr(slot + " expects a value, got " + tyToStr(ty), at)
  true
}

// Whether `ty` is exactly `string | null` — a `TyNullable` wrapping the `string`
// primitive. Cheap (no `tyToStr`); used to record an inferred niche if-binding.
function isNulStringTy(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    const inr = t.nInner
    if inr < 0 { return false }
    const it = T.tys[inr]
    if it is TyPrim { return it.primName == "string" }
  }
  false
}

// Whether `ty` ADMITS null — a `TyNullable`, the bare `null` prim, or a union with a
// `null` member. Gates the completion coercion: an object literal may OMIT a field whose
// declared type admits null (it is materialized as `null` at construction).
function tyAdmitsNull(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable { return true }
  if t is TyPrim { return t.primName == "null" }
  if t is TyUnion {
    const ms = t.uMembers
    let i = 0
    while i < ms.length {
      if isNullTy(ms[i]) { return true }
      i = i + 1
    }
  }
  false
}

// Whether `ty` is a union whose every member is a structural OBJECT (`Cat | Dog`) — the
// variant-boxed struct-union rep the emitter lowers via its expression-based `exprUnion`
// fallback. An inferred return of this shape no longer floors (the annotated form already
// lowers + `is`-narrows). A MIXED union (a struct mixed with a scalar/string) is NOT this
// — it has no single rep, so it stays floored.
function isStructUnionTy(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyUnion {
    const members = t.uMembers
    if members.length < 2 { return false }
    let i = 0
    while i < members.length {
      const m = T.tys[members[i]]
      if !(m is TyObj) { return false }
      i = i + 1
    }
    return true
  }
  false
}

// Whether `ty` is exactly `boolean | null` — a `TyNullable` wrapping the `boolean`
// primitive (the niche scalar nullable: an i32 0/1 with sentinel 2 = null). Cheap
// (no `tyToStr`); used to record an inferred niche if-binding.
function isNulBoolTy(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    const inr = t.nInner
    if inr < 0 { return false }
    const it = T.tys[inr]
    // The canonical boolean prim interns as `mkPrim("boolean")` (`TY_BOOL`); an annotation
    // may also name it "boolean" — accept both, like the inferred-return niche path.
    if it is TyPrim { return it.primName == "boolean" }
  }
  false
}

// The non-null part of `ty` (the host's `nonNullable`): a nullable peels to
// its inner type; anything else is already non-null. -1 propagates. NESTED
// nullables collapse (`Nullable(Nullable(X))` ≡ `Nullable(X)` ≡ non-null `X`) —
// a double nullable arises when a map whose VALUE is already nullable is read
// (`{[string]: T | null}` → `mkNullableTy(T | null)`); a single peel there would
// leave an inner `T?` that a narrowed member/field access rejects as non-object,
// so a `!= null` narrow must strip EVERY layer to reach the non-null value.
//
// A ONE-MEMBER UNION AROUND A NULLABLE IS NOT THIS FUNCTION'S JOB, and teaching it to peel
// one is a MISCOMPILE rather than a missing case. `type T = (S | null)` interns
// `TyUnion[S?]`, and `declaredTyOfName` already resolves that wrapper to its member for
// every inner (`singleAliasMemberTyIx` → `nulAliasMemberFaithful`), so an annotation of `T`
// arrives here as a plain `S?`. A wrapper that reaches here is one the EMITTER also refused
// to see through, and peeling it makes the checker narrow a value the emitter is still
// lowering as a union box: measured at 47 loud emit rejects, 15 check-clean-invalid-wasm
// cells and zero new running programs across the 1,020-cell alias grid. The peel belongs at
// the transparency predicate, which is the one place both sides read.
function nonNullTy(ty: i32) {
  if ty < 0 { return -1 }
  let cur = ty
  while true {
    const t = T.tys[cur]
    if t is TyNullable {
      if t.nInner < 0 { return cur }
      cur = t.nInner
    } else {
      return cur
    }
  }
  cur
}

// A place's CURRENT type during fact collection: facts already collected into
// `names`/`tys` (innermost-last wins) override the path overlay, which
// overrides the scope/field lookup — so successive narrowings compose
// (`o != null && o.y is i32` resolves `o.y` against the non-null `o`).
// Read-only: collection must never raise a diagnostic.
function placeCurTy(ix: i32, names: string[], tys: i32[]) {
  const key = placeKeyOf(ix)
  if key != "" {
    let i = names.length - 1
    while i >= 0 {
      if names[i] == key { return tys[i] }
      i = i - 1
    }
    const ov = narrowedPathTy(key)
    if ov >= 0 { return ov }
  }
  const n = P.nodes[ix]
  if n is Ident { return lookup(n.identName) }
  if n is Member {
    return placeFieldTy(placeCurTy(n.memObj, names, tys), n.memProp, false)
  }
  if n is OptMember {
    return placeFieldTy(placeCurTy(n.omObj, names, tys), n.omProp, true)
  }
  -1
}

// The type of field `prop` read off `baseTy` for narrowing purposes (no
// diagnostics): an OPTIONAL hop peels a nullable receiver and re-wraps the
// result nullable; the field resolves off a struct, or as a shared union
// field. -1 when unresolvable (no narrowing is recorded then).
function placeFieldTy(baseTy: i32, prop: string, optional: boolean) {
  if baseTy < 0 { return -1 }
  const bt = T.tys[baseTy]
  let wasNullable = false
  let core = baseTy
  if bt is TyNullable {
    if !optional { return -1 }
    wasNullable = true
    core = bt.nInner
  }
  if core < 0 { return -1 }
  const ct = T.tys[core]
  let ft = -1
  if ct is TyObj { ft = objFieldType(ct, prop) }
  else if ct is TyUnion { ft = sharedUnionFieldTy(ct, prop) }
  if ft < 0 { return -1 }
  if wasNullable { return mkNullableTy(ft) }
  ft
}

// SHARED-FIELD ACCESS over a struct union (the host's `sharedUnionField`): a
// field present on EVERY member with a mutually-assignable type is readable on
// the union directly, without narrowing — `(A | B).tag`. -1 when any member
// lacks the field, disagrees on its type, or isn't a struct.
function sharedUnionFieldTy(u: TyUnion, prop: string) {
  const members = u.uMembers
  if members.length < 1 { return -1 }
  let shared = -1
  let i = 0
  while i < members.length {
    const mIx = members[i]
    if mIx < 0 { return -1 }
    const m = T.tys[mIx]
    if m is TyObj {
      const ft = objFieldType(m, prop)
      if ft < 0 { return -1 }
      if shared < 0 { shared = ft }
      else if !assignable(shared, ft) || !assignable(ft, shared) { return -1 }
    } else {
      return -1
    }
    i = i + 1
  }
  shared
}

// Flatten a union/nullable into its variant list (`null` becomes the null
// type), mirroring the host's `flattenVariants`.
function flattenVariantsInto(ty: i32, out: i32[]) {
  if ty < 0 {
    out.push(ty)
    return 0
  }
  const t = T.tys[ty]
  if t is TyUnion {
    const members = t.uMembers
    let i = 0
    while i < members.length {
      flattenVariantsInto(members[i], out)
      i = i + 1
    }
    return 0
  }
  if t is TyNullable {
    flattenVariantsInto(t.nInner, out)
    out.push(TY_NULL)
    return 0
  }
  out.push(ty)
  0
}

// Two arena types denoting the same variant (mutually assignable). A generic
// type variable is never "the same variant" as anything — the host's hole
// guard (`isHole`) — so narrowing never pins an un-instantiated parameter.
function sameVariantTy(a: i32, b: i32) {
  if a < 0 || b < 0 { return false }
  const ta = T.tys[a]
  if ta is TyVar { return false }
  const tb = T.tys[b]
  if tb is TyVar { return false }
  // Named variants resolve to one canonical arena entry (`cUserTypes`), so
  // the common same-variant case is index equality — skip both traversals.
  if a == b { return true }
  if !assignable(a, b) { return false }
  assignable(b, a)
}

// Litunion alias-PROVENANCE stamp (Stage B b1, see `cLitUnionCopyTyIxs`):
// record that freshly-minted union `res` is a COPY of the declared litunion
// alias `src` derives from. `src` is the operation's INPUT type (a nullable
// wrapper unwraps to its inner — `K | null` narrowing subtracts from the
// nullable). Records only when
//   · `res` is itself a litunion at an index with no alias identity yet, and
//   · `src` resolves to a declared alias (directly, via its own recorded
//     provenance — copies chain — or through a `| null` wrapper), and
//   · every member of `res` is a member of that alias (the subset gate:
//     narrowing/subtraction/dedup only ever KEEP members, so a copy is always
//     contained; a join that widened past the alias is NOT the alias).
// A miss records nothing — the index simply stays alias-less, exactly the
// pre-provenance state. Never consulted on the checking hot path (the rep
// layers read it at emit); the copy list stays small (one entry per litunion
// re-mint).
function litUnionProvSrcAlias(src: i32): i32 {
  if src < 0 { return -1 }
  const t = T.tys[src]
  if t is TyNullable { return litUnionProvSrcAlias(t.nInner) }
  tyLitUnionAliasIx(src)
}

function noteLitUnionCopy(res: i32, src: i32) {
  if res < 0 { return 0 }
  if !tyIsLitUnion(res) { return 0 }
  if tyLitUnionAliasIx(res) >= 0 { return 0 }
  const alias = litUnionProvSrcAlias(src)
  if alias < 0 { return 0 }
  const rt = T.tys[res]
  const at = T.tys[alias]
  if rt is TyUnion {
    if at is TyUnion {
      let i = 0
      while i < rt.uMembers.length {
        let hit = false
        let j = 0
        while j < at.uMembers.length {
          if sameVariantTy(rt.uMembers[i], at.uMembers[j]) { hit = true }
          j = j + 1
        }
        if !hit { return 0 }
        i = i + 1
      }
      cLitUnionCopyTyIxs.push(res)
      cLitUnionCopyAliasIxs.push(alias)
    }
  }
  0
}

// Remove a variant from a union/nullable, returning the residual type (the
// host's `subtractType`) — backs else-branch narrowing: in `if x is A { … }
// else { … }`, `x` is `U − A` in the else branch. Returns -1 both when nothing
// concrete is removed (open-world negation isn't tracked) and when nothing
// remains (a dead branch — the host skips overlaying a `Never`).
function subtractTy(ty: i32, removed: i32) {
  if ty < 0 || removed < 0 { return -1 }
  const drop: i32[] = []
  flattenVariantsInto(removed, drop)
  const vars: i32[] = []
  flattenVariantsInto(ty, vars)
  const kept: i32[] = []
  let i = 0
  while i < vars.length {
    const v = vars[i]
    let hit = false
    let j = 0
    while j < drop.length {
      if sameVariantTy(v, drop[j]) { hit = true }
      j = j + 1
    }
    if !hit { kept.push(v) }
    i = i + 1
  }
  if kept.length == vars.length { return -1 }
  if kept.length == 0 { return -1 }
  // Reassemble the residual: a surviving `null` folds back into a nullable.
  let hasNull = false
  const core: i32[] = []
  let k = 0
  while k < kept.length {
    if isNullTy(kept[k]) { hasNull = true } else { core.push(kept[k]) }
    k = k + 1
  }
  if core.length == 0 { return TY_NULL }
  let res = core[0]
  if core.length > 1 {
    res = mkUnionTy(core)
    // A narrowed litunion alias (`K` minus some members, `K | null` minus the
    // null) is a fresh COPY of the alias — stamp its provenance (b1).
    noteLitUnionCopy(res, ty)
  }
  if hasNull { return mkNullableTy(res) }
  res
}

// Whether `ix` is the `never` primitive (the empty type).
function isNeverTy(ix: i32) {
  if ix < 0 { return false }
  const t = T.tys[ix]
  if t is TyPrim { return t.primName == "never" }
  // An empty union (no surviving members — e.g. a degenerate `type D = D` or an
  // empty intersection `A & B`) is uninhabited, i.e. `never`. The declaration
  // already reported it; treating it as `never` keeps use sites from cascading.
  if t is TyUnion { return t.uMembers.length == 0 }
  false
}

// A prose description of a type's underlying SHAPE, for explaining why two
// intersection operands can't overlap (`A & B` → "an object and a string
// literal"). Mirrors the TS host's `operandKind`. A single-member union (a
// `type B = "foo"` alias) peels to its member so it reads "a string literal",
// not "a union".
function operandKind(ix: i32) {
  if ix < 0 { return "a type" }
  const t = T.tys[ix]
  if t is TyUnion {
    if t.uMembers.length == 1 { return operandKind(t.uMembers[0]) }
    return "a union"
  }
  if t is TyLit {
    if t.litKind == "str" { return "a string literal" }
    return "a number literal"
  }
  if t is TyObj { return "an object" }
  if t is TyFunc { return "a function" }
  if t is TyPrim { return "the type `" + t.primName + "`" }
  if t is TyArray { return "an array" }
  if t is TyMap { return "a map" }
  "a type"
}

// The base scalar a literal type SOFTENS to (host: `StringLiteral` → string,
// `IntegerLiteral` → its magnitude-defaulted integer type, `RealLiteral` →
// f64). An integer literal past the i32 range softens to i64 (the host's
// `defaultIntegerType` magnitude rule), so the literal-aware assignability
// path never sneaks an out-of-range literal into an i32 slot.
export function litBaseTy(t: TyLit) {
  if t.litKind == "str" { return TY_STR }
  if t.litKind == "flt" { return TY_F64 }
  if intLexemeFitsI32(t.litText) { return TY_I32 }
  TY_I64
}

// The EMIT NAME of that base scalar — `litBaseTy` rendered. The four-way rule above had
// been written out THREE more times: once per renderer's `TyLit` arm, and once over the
// SPELLING (`canonEmitName`'s `litBaseName`, now gone with P3's routing). All three said
// the same thing, and one of them had to re-derive `str`/`flt` from the characters. The
// prim test is total by `litBaseTy`'s own arms — every one of them returns a `TyPrim`.
function tyLitBaseName(t: TyLit) {
  const bt = T.tys[litBaseTy(t)]
  if bt is TyPrim { return bt.primName }
  ""
}

// Whether `ty` carries LITERAL members (a literal type, or a union/nullable
// with a literal member) — the "closed set" types whose membership rules the
// literal-union checks enforce.
function isLitBearing(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyLit { return true }
  if t is TyNullable { return isLitBearing(t.nInner) }
  if t is TyUnion {
    const members = t.uMembers
    let i = 0
    while i < members.length {
      if isLitBearing(members[i]) { return true }
      i = i + 1
    }
  }
  false
}

// Soften a literal / all-literal union operand to its base scalar (host: a
// numeric-literal union is its base type for ARITHMETIC and ordering — the
// union constrains what may be ASSIGNED, not what may be computed). A mixed
// union (different bases, or any non-literal member) is left alone.
function softenLitTy(ty: i32) {
  if ty < 0 { return ty }
  const t = T.tys[ty]
  if t is TyLit { return litBaseTy(t) }
  if t is TyUnion {
    const members = t.uMembers
    let base = -1
    let i = 0
    while i < members.length {
      const m = members[i]
      if m < 0 { return ty }
      const mt = T.tys[m]
      if mt is TyLit {
        const b = litBaseTy(mt)
        if base < 0 { base = b }
        else if base != b { return ty }
      } else {
        return ty
      }
      i = i + 1
    }
    if base >= 0 { return base }
  }
  ty
}

// The LITERAL type of a literal EXPRESSION (host: a string/number literal
// carries its own `StringLiteral`/`IntegerLiteral`/`RealLiteral` type), or -1
// when the expression isn't a bare literal. Peels parens. The string text is
// the RAW lexeme between the quotes — the same characters a literal-type
// annotation keeps — so membership compares consistently.
//
// THE QUOTE PEEL BELOW IS **NOT** `tyname.groupInnerOf` (W1), and the boundary is the
// OPERAND'S LANGUAGE, not the three characters of arithmetic. `StrLit.strText` is a
// string in the EXPRESSION language; `tyname.vl` is the TYPE-NAME grammar's leaf, and
// its cut is published as one of that grammar's operations. Routing an expression
// lexeme through it would make the identical peels in `parser.vl` / `format.vl` owe
// `tyname` an import they have no other reason to hold. The line is drawn where it
// costs a module edge, not where the characters happen to match — which is why
// `litMemberTy` and `tsToTyReal` (type NAMES that happen to be quoted lexemes) ARE
// routed and this and `checkMatchExprNode`'s pattern peel are not.
function litTyOfExpr(ix: i32) {
  if ix < 0 { return -1 }
  const e = P.nodes[ix]
  if e is Paren { return litTyOfExpr(e.parInner) }
  if e is StrLit {
    const raw = e.strText
    return mkLitTy("str", raw.slice(1, raw.length - 1))
  }
  if e is NumLit {
    if hasDot(e.numText) { return mkLitTy("flt", e.numText) }
    return mkLitTy("int", e.numText)
  }
  -1
}

// `A & !B` (host `subtractType` under an intersection fold): drop B's variants
// from A. Differs from the narrowing `subtractTy` in its EDGES: nothing
// concrete dropped → A unchanged (open-world negation, e.g. `i32 & !2`);
// everything dropped → `never` (host: an empty intersection).
function isectSubtract(ty: i32, removed: i32) {
  if ty < 0 || removed < 0 { return -1 }
  const drop: i32[] = []
  flattenVariantsInto(removed, drop)
  const vars: i32[] = []
  flattenVariantsInto(ty, vars)
  const kept: i32[] = []
  let i = 0
  while i < vars.length {
    const v = vars[i]
    let hit = false
    let j = 0
    while j < drop.length {
      if sameVariantTy(v, drop[j]) { hit = true }
      j = j + 1
    }
    if !hit { kept.push(v) }
    i = i + 1
  }
  if kept.length == vars.length { return ty }
  if kept.length == 0 { return TY_NEVER }
  let hasNull = false
  const core: i32[] = []
  let k = 0
  while k < kept.length {
    if isNullTy(kept[k]) { hasNull = true } else { core.push(kept[k]) }
    k = k + 1
  }
  if core.length == 0 { return TY_NULL }
  let res = core[0]
  if core.length > 1 {
    res = mkUnionTy(core)
    // `K & !"a"` — an intersection-subtracted litunion alias is a COPY (b1).
    noteLitUnionCopy(res, ty)
  }
  if hasNull { return mkNullableTy(res) }
  res
}

// Fold `A & B` (host `intersectType`): a negation operand SUBTRACTS, a union
// operand DISTRIBUTES (`(0|1|2) & !2` → `0 | 1`), two object types MERGE
// field-wise (A3: `{a} & {b}` is `{a, b}`, a shared field refines to the meet),
// a subtype pair keeps the NARROWER side, and a disjoint concrete pair folds to
// `never` (no common values). -1 (unresolved) poisons the fold.
function intersectTy(a: i32, b: i32) {
  if a < 0 || b < 0 { return -1 }
  const tb = T.tys[b]
  if tb is TyNeg { return isectSubtract(a, tb.negTy) }
  const ta = T.tys[a]
  if ta is TyNeg { return isectSubtract(b, ta.negTy) }
  if ta is TyUnion {
    const du = isectDistribute(ta.uMembers, b)
    // A distributed litunion alias (`K & <lit>`) re-mints a subset COPY (b1).
    noteLitUnionCopy(du, a)
    return du
  }
  if tb is TyUnion {
    const du2 = isectDistribute(tb.uMembers, a)
    noteLitUnionCopy(du2, b)
    return du2
  }
  if ta is TyObj {
    if tb is TyObj {
      // Structural field-wise merge: the value that is BOTH carries every
      // field of each side; a shared field is the meet of the two sides.
      const mnames: string[] = []
      const mtys: i32[] = []
      const anames = ta.objFieldNames
      const atys = ta.objFieldTypes
      let ai = 0
      while ai < anames.length {
        mnames.push(anames[ai])
        mtys.push(atys[ai])
        ai = ai + 1
      }
      const bnames = tb.objFieldNames
      const btys = tb.objFieldTypes
      let bi = 0
      while bi < bnames.length {
        let at2 = -1
        let mi = 0
        while mi < mnames.length {
          if mnames[mi] == bnames[bi] { at2 = mi }
          mi = mi + 1
        }
        if at2 >= 0 {
          mtys[at2] = intersectTy(mtys[at2], btys[bi])
        } else {
          mnames.push(bnames[bi])
          mtys.push(btys[bi])
        }
        bi = bi + 1
      }
      return mkObjTy(mnames, mtys)
    }
  }
  if assignable(a, b) { return a }
  if assignable(b, a) { return b }
  TY_NEVER
}

// Distribute an intersection over a union operand: `(A | B) & C` is
// `(A & C) | (B & C)`, dropping members that fold to `never`.
function isectDistribute(members: i32[], other: i32) {
  const kept: i32[] = []
  let i = 0
  while i < members.length {
    const r = intersectTy(members[i], other)
    if r >= 0 && !isNeverTy(r) {
      let dup = false
      let j = 0
      while j < kept.length {
        if sameVariantTy(r, kept[j]) { dup = true }
        j = j + 1
      }
      if !dup { kept.push(r) }
    }
    i = i + 1
  }
  if kept.length == 0 { return TY_NEVER }
  if kept.length == 1 { return kept[0] }
  mkUnionTy(kept)
}

// Append one narrowing fact (place key → type) when the place is stable and
// the narrowed type resolved (-1 means "no fact" and is skipped).
function pushNarrowFact(placeIx: i32, ty: i32, names: string[], tys: i32[]) {
  if ty < 0 { return 0 }
  const key = placeKeyOf(placeIx)
  if key == "" { return 0 }
  names.push(key)
  tys.push(ty)
  0
}

// Whether the place runs through a `?.` hop — its negation is then not a sound
// else-branch refinement (the chain may be null because a RECEIVER was).
function placeHasOptionalHop(ix: i32) {
  const n = P.nodes[ix]
  if n is OptMember { return true }
  if n is Member { return placeHasOptionalHop(n.memObj) }
  false
}

// For a guard on an optional chain (`x?.y is T`), the truthy branch also
// implies every `?.` receiver is non-null — push those facts innermost-first
// (each resolves against an already-narrowed receiver), so the body's regular
// `x.y` reads resolve. THEN branch only (the host's `optionalChainThenFacts`).
function pushOptChainThenFacts(placeIx: i32, names: string[], tys: i32[]) {
  const n = P.nodes[placeIx]
  if n is Member {
    pushOptChainThenFacts(n.memObj, names, tys)
    return 0
  }
  if n is OptMember {
    pushOptChainThenFacts(n.omObj, names, tys)
    const cur = placeCurTy(n.omObj, names, tys)
    const inner = nonNullTy(cur)
    if inner >= 0 && inner != cur { pushNarrowFact(n.omObj, inner, names, tys) }
    return 0
  }
  0
}

// The argument PLACE a guard call narrows in the branch where its non-null
// side is `wantThen` (1: THEN, 0: ELSE), or -1: not a registered guard call /
// wrong direction / no stable argument. Handles the inline form
// (`present(v)`) and the UFCS form (`v.present()` — the receiver fills the
// guard's `self` param 0).
function guardCallPlace(cond: Call, wantThen: i32) {
  const cfn = P.nodes[cond.callFn]
  let gname = ""
  let gRecv = -1
  if cfn is Ident {
    gname = cfn.identName
  } else if cfn is Member {
    gname = cfn.memProp
    gRecv = cfn.memObj
  }
  if gname == "" { return -1 }
  const gi = guardIndexOf(gname)
  if gi < 0 { return -1 }
  if guardThens[gi] != wantThen { return -1 }
  const pIdx = guardParamIdxs[gi]
  const cargs = cond.callArgs
  if gRecv >= 0 {
    if pIdx == 0 { return gRecv }
    if pIdx - 1 < cargs.length { return cargs[pIdx - 1] }
    return -1
  }
  if pIdx < cargs.length { return cargs[pIdx] }
  -1
}

// Collect the narrowings that hold when `cond` is TRUE into the parallel
// `names`/`tys` arrays (keys are place paths — see `placeKeyOf`): `x != null`
// strips x's null, `x is T` pins x to T (`is null` pins to the null type),
// `a && b` contributes BOTH conjuncts, `!(e)` contributes e's FALSE
// narrowings, and parens recurse. A guard over an optional chain also narrows
// each `?.` receiver non-null (host `optionalChainThenFacts`).
function collectThenNarrows(condIx: i32, names: string[], tys: i32[]) {
  const cond = P.nodes[condIx]
  if cond is Paren { return collectThenNarrows(cond.parInner, names, tys) }
  if cond is Unary {
    if cond.unOp == "!" { return collectElseNarrows(cond.unArg, names, tys) }
    return 0
  }
  if cond is IsExpr {
    pushOptChainThenFacts(cond.isObj, names, tys)
    if cond.isVariant == "null" {
      pushNarrowFact(cond.isObj, TY_NULL, names, tys)
    } else {
      const tIdx = isTypeTyRead(cond.isVariant, condIx)
      if tIdx >= 0 { pushNarrowFact(cond.isObj, tIdx, names, tys) }
    }
    return 0
  }
  if cond is BinExpr {
    if cond.binOp == "&&" {
      collectThenNarrows(cond.binLeft, names, tys)
      collectThenNarrows(cond.binRight, names, tys)
      return 0
    }
    if cond.binOp == "!=" {
      const placeIx = nullCmpPlace(condIx)
      if placeIx >= 0 {
        pushOptChainThenFacts(placeIx, names, tys)
        const cur = placeCurTy(placeIx, names, tys)
        const inner = nonNullTy(cur)
        if inner >= 0 && inner != cur {
          pushNarrowFact(placeIx, inner, names, tys)
        }
      }
    }
    return 0
  }
  // Inferred type-guard call (A6b): `if present(v)` narrows `v` the way the
  // guard's body narrows its parameter — non-null here when the guard's
  // non-null branch is THEN.
  if cond is Call {
    const gArg = guardCallPlace(cond, 1)
    if gArg >= 0 {
      pushOptChainThenFacts(gArg, names, tys)
      const gCur = placeCurTy(gArg, names, tys)
      const gInner = nonNullTy(gCur)
      if gInner >= 0 && gInner != gCur {
        pushNarrowFact(gArg, gInner, names, tys)
      }
    }
    return 0
  }
  0
}

// Collect the narrowings that hold when `cond` is FALSE: `x == null` strips
// the null in the else-branch, `x is null` false means non-null, `x is T`
// false leaves the union COMPLEMENT `U − T` (host `subtractType`), `a || b`
// contributes BOTH disjuncts (De Morgan: neither held), `!(e)` contributes
// e's TRUE narrowings, and parens recurse. A place behind a `?.` hop is never
// else-narrowed (the chain may be null because a receiver was).
function collectElseNarrows(condIx: i32, names: string[], tys: i32[]) {
  const cond = P.nodes[condIx]
  if cond is Paren { return collectElseNarrows(cond.parInner, names, tys) }
  if cond is Unary {
    if cond.unOp == "!" { return collectThenNarrows(cond.unArg, names, tys) }
    return 0
  }
  if cond is IsExpr {
    if placeHasOptionalHop(cond.isObj) { return 0 }
    const cur = placeCurTy(cond.isObj, names, tys)
    if cond.isVariant == "null" {
      const inner = nonNullTy(cur)
      if inner >= 0 && inner != cur {
        pushNarrowFact(cond.isObj, inner, names, tys)
      }
    } else {
      const tIdx = isTypeTyRead(cond.isVariant, condIx)
      if tIdx >= 0 {
        pushNarrowFact(cond.isObj, subtractTy(cur, tIdx), names, tys)
      }
    }
    return 0
  }
  if cond is BinExpr {
    if cond.binOp == "||" {
      collectElseNarrows(cond.binLeft, names, tys)
      collectElseNarrows(cond.binRight, names, tys)
      return 0
    }
    if cond.binOp == "==" {
      const placeIx = nullCmpPlace(condIx)
      if placeIx >= 0 {
        if !placeHasOptionalHop(placeIx) {
          const cur = placeCurTy(placeIx, names, tys)
          const inner = nonNullTy(cur)
          if inner >= 0 && inner != cur {
            pushNarrowFact(placeIx, inner, names, tys)
          }
        }
      }
    }
    return 0
  }
  // Inferred type-guard call (A6b): `if absent(p) { … } else { /* p!=null */ }`
  // — non-null in the ELSE branch when the guard's non-null branch is ELSE.
  if cond is Call {
    const gArg = guardCallPlace(cond, 0)
    if gArg >= 0 {
      if !placeHasOptionalHop(gArg) {
        const gCur = placeCurTy(gArg, names, tys)
        const gInner = nonNullTy(gCur)
        if gInner >= 0 && gInner != gCur {
          pushNarrowFact(gArg, gInner, names, tys)
        }
      }
    }
    return 0
  }
  0
}

// Whether a narrowing key is a property PATH (`o.v`) rather than a bare name.
function isPathKey(s: string) {
  let i = 0
  while i < s.length {
    if s[i] == 46 {
      return true // '.'
    }
    i = i + 1
  }
  false
}

// Apply collected narrowings around a branch: a bare name shadows via the
// scope chain (the caller pushes a scope first), a property path rides the
// `npKeys`/`npTys` overlay — whose entries the matching `popScope` unwinds.
//
// A bare name's shadow carries TWO things across with it, both because the shadow is
// a full binding in a scope of its own and every question the scope chain answers
// reads it instead of the declaration:
//
//   * ITS DECLARED TYPE, banked so the write side can still ask what the storage
//     holds (`writeStorageTy`). Banked only when the narrowing actually CHANGES the
//     type — a fact identical to the current type shadows nothing, and banking it
//     would put a guard-kind entry in front of an assignment-kind one for no gain.
//   * ITS CONSTNESS. `isConstName` stops at the first scope that BINDS the name and
//     asks that frame alone — the scope-chain shadowing rule, which a `let` shadowing
//     an outer `const` depends on. A narrowing shadow is not a new binding, so
//     without this mirror the `const` reject silently disappears inside every guard:
//     `const q = mk(true)` / `if q != null { q = 5 }` compiled and ran on master.
function applyNarrows(names: string[], tys: i32[]) {
  let i = 0
  while i < names.length {
    if isPathKey(names[i]) {
      npKeys.push(names[i])
      npTys.push(tys[i])
      npInvBy.push(-1)
      npEpochs.push(narFnEpoch)
    } else {
      const wasConst = isConstName(names[i])
      const declTy = lookup(names[i])
      if declTy >= 0 && declTy != tys[i] {
        noteNarShadow(names[i], declTy, NAR_KIND_GUARD)
      }
      declare(names[i], tys[i])
      if wasConst {
        const ctop = constScopes.length - 1
        if ctop >= 0 { constScopes[ctop][names[i]] = true }
      }
    }
    i = i + 1
  }
  0
}

// The START char offset of a SCOPE-OWNING node (the `{`/`for` token), or `-1`.
// Only the node kinds that open a lexical scope are handled (block bodies, the
// two `for` forms); other owners fall back to "no start" → a full-file sentinel.
function scopeStartOff(owner: i32) {
  if owner < 0 || owner >= P.nodes.length { return -1 }
  const n = P.nodes[owner]
  if n is Block { return n.pos }
  if n is ForRange { return n.pos }
  if n is ForIn { return n.pos }
  if n is FuncDecl { return n.pos }
  -1
}

// The token index whose START offset is exactly `off`, or `-1`. A scope owner's
// `pos` is a token boundary (`{`/`for`), so this recovers its line/col.
function tokIxAtStart(off: i32) {
  if off < 0 { return -1 }
  // The lexer appends tokens in scan order, so `start` offsets are strictly
  // increasing — binary search (this runs per scope push in LSP mode, and a
  // linear scan over all tokens made scope collection quadratic).
  let lo = 0
  let hi = P.toks.length - 1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const s = P.toks[mid].start
    if s == off { return mid }
    if s < off { lo = mid + 1 } else { hi = mid - 1 }
  }
  -1
}

// Push the open-scope span for `owner` (the scope-owning node), in lockstep with
// the decl-scope map. The END is the owner's anchor (last) token — the closing
// `}` for a block; the START its first token. `owner < 0` (a narrowing-only
// scope, which never holds a binding) pushes a full-file sentinel.
function pushScopeSpan(owner: i32) {
  let startL = 1
  let startC = 0
  let endL = SCOPE_EOF
  let endC = 0
  if owner >= 0 {
    const so = scopeStartOff(owner)
    const stk = tokIxAtStart(so)
    if stk >= 0 {
      const st = P.toks[stk]
      startL = st.line
      startC = st.col
    }
    if owner < nodeToks.length {
      const etk = nodeToks[owner]
      if etk >= 0 && etk < P.toks.length {
        const et = P.toks[etk]
        endL = et.line
        endC = et.col + et.text.length
      }
    }
  }
  scopeSL.push(startL)
  scopeSC.push(startC)
  scopeEL.push(endL)
  scopeEC.push(endC)
  0
}

// Enter a new lexical scope (push a fresh name→type map). Marks the current
// narrowed-path overlay depth so `popScope` unwinds entries pushed inside.
// `owner` is the scope-owning node (its source span bounds visibility for the
// LSP scope query); `-1` for a narrowing-only overlay that holds no binding.
function pushScope(owner: i32) {
  T.scopes.push(Map())
  constScopes.push(Map())
  fnDeclScopes.push(Map())
  npFrames.push(npKeys.length)
  pgFrames.push(pgKeys.length)
  asgDeclFrames.push(asgDeclKeys.length)
  if symEnabled != 0 {
    symDeclScope.push(Map())
    pushScopeSpan(owner)
  }
  0
}

// Leave the innermost scope. (`.pop()` in statement position drops its return
// value correctly now — the old PR #4 wasm-validation gap is fixed and pinned by
// `tests/cases/lists/struct-field-pop-statement.vl`.)
function popScope() {
  flushUninferred(T.scopes.length - 1)
  T.scopes.pop()
  constScopes.pop()
  fnDeclScopes.pop()
  if npFrames.length > 0 {
    const base = npFrames[npFrames.length - 1]
    npFrames.pop()
    while npKeys.length > base {
      npKeys.pop()
      npTys.pop()
      npInvBy.pop()
      npEpochs.pop()
    }
  }
  if pgFrames.length > 0 {
    const pbase = pgFrames[pgFrames.length - 1]
    pgFrames.pop()
    while pgKeys.length > pbase { pgKeys.pop() }
  }
  if asgDeclFrames.length > 0 {
    const abase = asgDeclFrames[asgDeclFrames.length - 1]
    asgDeclFrames.pop()
    while asgDeclKeys.length > abase {
      asgDeclKeys.pop()
      asgDeclTys.pop()
      asgDeclDepths.pop()
      asgDeclKinds.pop()
      asgDeclEpochs.pop()
    }
  }
  if symEnabled != 0 {
    if symDeclScope.length > 0 { symDeclScope.pop() }
    if scopeSL.length > 0 {
      scopeSL.pop()
      scopeSC.pop()
      scopeEL.pop()
      scopeEC.pop()
    }
  }
  0
}

// ── LSP symbol-table recording (no-ops when `symEnabled == 0`) ────────────────
// A binding's type-arena index, retained by `bindingId` (its decl node index)
// so hover can render it after the scope closed. The last write for a node wins
// (a re-check during demand-inference overwrites with the resolved type).
function symRetainType(declNode: i32, ty: i32, kind: i32) {
  let i = 0
  while i < symBindNode.length {
    if symBindNode[i] == declNode {
      symBindType[i] = ty
      symBindKind[i] = kind
      return 0
    }
    i = i + 1
  }
  symBindNode.push(declNode)
  symBindType.push(ty)
  symBindKind.push(kind)
  0
}

// Stamp a binding's VISIBILITY scope for the position query, from open-scope span
// `spanIx` (a `scope*` stack index). Skipped when the index is out of range.
// FIRST stamp per binding (`declNode`) wins: a top-level function name is stamped
// in pass 1 with its (correct, global) scope BEFORE pass 2, so a later
// demand-inference re-entry — which runs the body from an artificially deep stack
// and would mis-pick the enclosing-scope span — cannot clobber it. A local/param's
// span is derived from its scope-owning node, so it is correct on first stamp
// regardless of stack depth.
function symStampVis(name: string, declNode: i32, kind: i32, spanIx: i32) {
  if spanIx < 0 || spanIx >= scopeSL.length { return 0 }
  let k = 0
  while k < symVisNode.length {
    if symVisNode[k] == declNode { return 0 }
    k = k + 1
  }
  symVisName.push(name)
  symVisNode.push(declNode)
  symVisKind.push(kind)
  symVisSL.push(scopeSL[spanIx])
  symVisSC.push(scopeSC[spanIx])
  symVisEL.push(scopeEL[spanIx])
  symVisEC.push(scopeEC[spanIx])
  0
}

// Record a DECLARATION: bind `name → declNode` in the innermost decl scope, emit
// the declaration's own occurrence (anchored at its NAME token), and retain its
// type. `declNode` is the bindingId; `nameTok` its identifier token (from the
// parser's `declNameTok` side table — falls back to the node anchor when unset).
function symDecl(name: string, declNode: i32, ty: i32, kind: i32) {
  if symEnabled == 0 { return 0 }
  if symDeclScope.length > 0 {
    const top = symDeclScope.length - 1
    symDeclScope[top][name] = declNode
  }
  symRetainType(declNode, ty, kind)
  // Visibility for completion: a binding is visible across its OWN (innermost)
  // scope. Stamped before the occurrence dedup so a demand-inference re-check
  // refreshes the span (see `symStampVis`).
  symStampVis(name, declNode, kind, scopeSL.length - 1)
  let tok = declNameTokOf(declNode)
  if tok < 0 {
    if declNode >= 0 && declNode < nodeToks.length { tok = nodeToks[declNode] }
  }
  // Idempotent by token: a function body re-checked during demand-inference would
  // otherwise stamp the same source identifier twice.
  if symOccHasTok(tok) { return 0 }
  symOccTok.push(tok)
  symOccRecordTok(tok)
  symOccDecl.push(declNode)
  symOccIsDecl.push(1)
  0
}

// Token-keyed membership set mirroring `symOccTok`, so the dedup guard is O(1)
// instead of a linear scan over every prior occurrence (which made recording the
// occurrence list O(n²)). Reset in lockstep with `symOccTok` (see the check
// preamble) and inserted into at every occurrence append (`symOccRecordTok`).
let symOccTokSet: {[string]: boolean} = Map()

// Record token `tok` into the membership set (mirrors a `symOccTok.push(tok)`).
// Negative tokens are never deduped, matching `symOccHasTok`, so they are skipped.
function symOccRecordTok(tok: i32) {
  if tok < 0 { return 0 }
  symOccTokSet[i32ToStr(tok)] = true
  0
}

// Whether an occurrence at token `tok` is already recorded (the dedup guard).
// O(1) via `symOccTokSet`, kept in sync with `symOccTok` at every append/reset.
function symOccHasTok(tok: i32) {
  if tok < 0 { return false }
  // A member-call cannot be a bare tail expression (the emitter rejects it as a
  // statement) — bind the `.has` result first (see `sliceNode` in format.vl).
  const present = symOccTokSet.has(i32ToStr(tok))
  present
}

// Like `symDecl`, but binds into the ENCLOSING decl scope (one level out from the
// innermost). A function name lives in the scope surrounding its body, yet its
// body scope is already pushed when the params/name are processed — so its
// binding must land one frame up to resolve recursive and sibling references.
function symDeclInOuter(name: string, declNode: i32, ty: i32, kind: i32) {
  if symEnabled == 0 { return 0 }
  const outer = symDeclScope.length - 2
  if outer >= 0 {
    symDeclScope[outer][name] = declNode
  } else if symDeclScope.length > 0 {
    symDeclScope[symDeclScope.length - 1][name] = declNode
  }
  symRetainType(declNode, ty, kind)
  // A function name is visible in the ENCLOSING scope (where it binds), not its
  // body — the decl-scope frame is one out, so its span is one below the top.
  // Stamped before the occurrence dedup (see `symDecl`).
  let outerSpan = scopeSL.length - 2
  if outerSpan < 0 { outerSpan = scopeSL.length - 1 }
  symStampVis(name, declNode, kind, outerSpan)
  let tok = declNameTokOf(declNode)
  if tok < 0 {
    if declNode >= 0 && declNode < nodeToks.length { tok = nodeToks[declNode] }
  }
  if symOccHasTok(tok) { return 0 }
  symOccTok.push(tok)
  symOccRecordTok(tok)
  symOccDecl.push(declNode)
  symOccIsDecl.push(1)
  0
}

// Resolve `name` to its binding's decl node through the decl-scope chain
// (innermost first — mirrors `lookup`), or `-1` if it is not a tracked binding
// (a builtin/intrinsic, or an import seeded with no decl node).
function symResolve(name: string) {
  let i = symDeclScope.length - 1
  while i >= 0 {
    if symDeclScope[i].has(name) { return symDeclScope[i][name] ?? (-1) }
    i = i - 1
  }
  -1
}

// Record a USE occurrence of the identifier node `useNode` (its anchor token IS
// the identifier). Resolves to its binding through the decl-scope chain; a name
// with no tracked binding records nothing (no go-to-def target).
function symUse(useNode: i32, name: string) {
  if symEnabled == 0 { return 0 }
  const decl = symResolve(name)
  if decl < 0 { return 0 }
  let tok = -1
  if useNode >= 0 && useNode < nodeToks.length { tok = nodeToks[useNode] }
  if symOccHasTok(tok) { return 0 }
  symOccTok.push(tok)
  symOccRecordTok(tok)
  symOccDecl.push(decl)
  symOccIsDecl.push(0)
  0
}

// Whether `ty` is an unresolved hole the host's `isHole` would skip (an
// `Infer`/`Unknown` analogue): a generic type variable or an error placeholder.
//
// A UNION IS A DATA STRUCTURE, and this guard reads it as one rather than as the
// string it would render to. A union whose members are ALL holes is itself a
// hole: `tyToStr` renders it `any | any`, an inlay hint is formatted `: T` — a
// suggestion of the annotation to WRITE — and `any` is not a type VL can spell.
// The BARE hole was already suppressed here (`t is TyVar`); the same hole inside
// a one-arm-per-hole union slipped the guard only because the test never looked
// past the top constructor. The defect was the INCONSISTENCY that produced:
// `: any` hidden, `: any | any` shown, for the same unresolved thing.
//
// A union with ANY resolved member (`any | string`) is NOT a hole and keeps its
// hint — it carries real information, and deleting an informative hint from
// correct code is the failure mode this surface guards against elsewhere (the
// `…` depth-cap rendering is deliberately kept for exactly that reason). That is
// why this is an ALL-members test and not an any-member one.
//
// Deliberately NOT extended to `TyNullable`: `let x = null` renders `_ | null`,
// and that type IS determined (VL spells it `null`) — see
// `tests/cases/types/infer-null-unconstrained.vl`, whose whole point is that the
// lone null is fully resolved. Its remedy belongs at the INFERENCE site, not at the
// renderer: a `TyNullable` over an absent inner is NOT always the lone null —
// `function mk() { return [] }` makes `mk().pop()` one too, and there the blank is
// honest (the element really is unknown), so a renderer arm answering `null` for
// every absent inner would misreport it.
//
// Depth-bounded at the arena's established budget (`tyDeeperThan`'s 16): a
// recursive type is CYCLIC in the arena (`type L = {next: L | null}` reaches its
// own index), so an unbounded member walk would not terminate. Exhausting the
// budget answers "not a hole" — the answer that KEEPS the hint.
export function inlayHole(ty: i32) { inlayHoleDeep(ty, 16) }

function inlayHoleDeep(ty: i32, depth: i32): boolean {
  if ty < 0 { return true }
  if depth <= 0 { return false }
  const t = T.tys[ty]
  if t is TyVar { return true }
  if t is TyErr { return true }
  if t is TyUnion {
    const ms = t.uMembers
    // An EMPTY member list is not a union of holes — it is a degenerate arena
    // entry, and answering "hole" for it would suppress on a shape this rule has
    // nothing to say about.
    if ms.length == 0 { return false }
    let i = 0
    while i < ms.length {
      if !inlayHoleDeep(ms[i], depth - 1) { return false }
      i = i + 1
    }
    return true
  }
  false
}

// A multi-module compile merges every module's AST, so
// `modOfTok` resolves which file a finding is in; the
// cli keeps only the entry module's (driver wrapper
// `redunModuleAt`).

function redunReset() {
  redunSLine = []
  redunSCol = []
  redunELine = []
  redunECol = []
  redunName = []
  redunType = []
  redunTok = []
  0
}

// Record `let <name>: T = init` as redundant when init's own type == the annotation.
// `declIx` is the LetDecl node (for its name token); `n` carries letName/letInit.
function recordRedundantAnnot(
  n: LetDecl,
  declIx: i32,
  initTy: i32,
  annot: i32,
) {
  // Only a CONCRETE init type that renders identically to the annotation. A hole
  // (empty `[]`/`Map()`, a lone `null`), an error, or `never` is never redundant.
  if inlayHole(initTy) { return 0 }
  if isNeverTy(initTy) { return 0 }
  if annot == TY_ERR { return 0 }
  if !tyEq(initTy, annot) { return 0 }
  const nameTok = declNameTokOf(declIx)
  if nameTok < 0 { return 0 }
  // The fix deletes the annotation, so the span runs from just after the NAME to
  // the assignment `=`. Find that `=` by scanning the tokens between (the
  // annotation can be multi-token — `{[string]: i32}[]`, a function type — so the
  // init node's anchor token is unreliable). It is the first `EQUAL` at bracket
  // depth 0 that is NOT part of `=>` (an `EQUAL` immediately followed by `>`).
  let eqTok = -1
  let depth = 0
  let t = nameTok + 1
  while t < P.toks.length {
    if eqTok < 0 {
      const kd = P.toks[t].kind
      if kd == "LPAREN" || kd == "LBRACK" || kd == "LBRACE" {
        depth = depth + 1
      } else if kd == "RPAREN" || kd == "RBRACK" || kd == "RBRACE" {
        depth = depth - 1
      } else if depth == 0 && kd == "EQUAL" {
        let isArrow = false
        if t + 1 < P.toks.length {
          if P.toks[t + 1].kind == "GT" { isArrow = true }
        }
        if !isArrow { eqTok = t }
      }
    }
    t = t + 1
  }
  if eqTok < 0 { return 0 }
  // Span start = the `:` token (always `nameTok + 1` for an annotated decl). Using
  // the colon's own position — not `nameTok.col + name.length` — is robust to the
  // module merge mangling the binding NAME (`local$m0`), which would otherwise push
  // the start past the `:` into the type.
  const colonTok = nameTok + 1
  if colonTok >= P.toks.length { return 0 }
  redunSLine.push(P.toks[colonTok].line)
  redunSCol.push(P.toks[colonTok].col)
  redunELine.push(P.toks[eqTok].line)
  redunECol.push(P.toks[eqTok].col)
  redunName.push(demangleName(n.letName))
  redunType.push(tyToStr(initTy))
  redunTok.push(nameTok)
  0
}

// Does a return EXPRESSION's type get pinned by the return ANNOTATION (rather than
// inferred on its own)? An empty `[]`/`{}`/`Map()`/`Set()` or a bare `null` resolves
// from the declared return via `T.curRet`, so the annotation is LOAD-BEARING.
function retInfluencedByAnnot(ix: i32) {
  if ix < 0 { return false }
  const nd = P.nodes[ix]
  if nd is ArrayLit { return nd.arrElems.length == 0 }
  if nd is ObjLit { return nd.objFields.length == 0 }
  if nd is NullLit { return true }
  if nd is Call {
    const cn = P.nodes[nd.callFn]
    if cn is Ident {
      if cn.identName == "Map" || cn.identName == "Set" {
        return nd.callArgs.length == 0
      }
    }
  }
  false
}

// Record a redundant RETURN-type annotation (`function f(): T { … }` whose body's
// inferred return already IS T) into the same finding stream the `let` rule uses. The
// fix deletes the `: T` between the params `)` and the body `{`. Both span ends are
// TOKEN-INDEX scans (robust in a merged multi-module compile): the colon is the first
// `COLON` at bracket depth 0 scanning from the function NAME; the body `{` is the
// token at the block's source offset, scanned FORWARD from the colon. An OBJECT return
// is excluded — a named/structural struct emits as a WasmGC ref whose inferred type
// can be tyToStr-equal yet not emit-identical (`peekTok(): Tok`).
function recordRedundantRet(n: FuncDecl, fnIx: i32, ret: i32) {
  // Only SCALAR/STRING returns — the categories the emitter default + `A20` classify
  // for an un-annotated function. Object / array / union / nullable returns can
  // mis-lower (the emitter re-derives them from the return expression), so keep those.
  const rnm = tyToStructStr(ret)
  if !isClassifiableRetName(rnm) { return 0 }
  // Skip GENERIC functions (an un-annotated param is a per-call-site hole; `A20` does
  // not elaborate them, so a removed string return could mis-lower).
  let gi = 0
  while gi < n.fnParams.length {
    const gpn = P.nodes[n.fnParams[gi]]
    if gpn is Param {
      if gpn.parType < 0 { return 0 }
    }
    gi = gi + 1
  }
  const nameTok = declNameTokOf(fnIx)
  if nameTok < 0 { return 0 }
  let colonTok = -1
  let depth = 0
  let ci = nameTok + 1
  while ci < P.toks.length && colonTok < 0 {
    const kd = P.toks[ci].kind
    if kd == "LPAREN" || kd == "LBRACK" || kd == "LBRACE" {
      depth = depth + 1
    } else if kd == "RPAREN" || kd == "RBRACK" || kd == "RBRACE" {
      depth = depth - 1
    } else if depth == 0 && kd == "COLON" {
      colonTok = ci
    }
    ci = ci + 1
  }
  if colonTok < 0 { return 0 }
  const bn = P.nodes[n.fnBody]
  if !(bn is Block) { return 0 }
  if bn.pos < 0 { return 0 }
  let braceTok = -1
  let bi = colonTok + 1
  while bi < P.toks.length && braceTok < 0 {
    if P.toks[bi].start == bn.pos { braceTok = bi }
    bi = bi + 1
  }
  if braceTok < 0 { return 0 }
  redunSLine.push(P.toks[colonTok].line)
  redunSCol.push(P.toks[colonTok].col)
  redunELine.push(P.toks[braceTok].line)
  redunECol.push(P.toks[braceTok].col)
  redunName.push(opDeclLabel(demangleName(n.fnName)))
  redunType.push(tyToStr(ret))
  redunTok.push(nameTok)
  0
}

// Record a member-access node's resolved type + its property-name span, keyed by
// the node (last write wins — a re-check during demand-inference overwrites the
// hole with the pinned type). A no-op unless `symEnabled` and the type resolved.
// Returns `ty` so it can wrap a member arm's return: `return symMem(ix, ft)`.
function symMem(ix: i32, ty: i32) {
  if symEnabled == 0 { return ty }
  if ty < 0 { return ty }
  if ix < 0 || ix >= nodeToks.length { return ty }
  const tk = nodeToks[ix]
  if tk < 0 || tk >= P.toks.length { return ty }
  const t = P.toks[tk]
  // Property-name length, to bound the span the cursor must fall within.
  let pl = 0
  const nd = P.nodes[ix]
  if nd is Member { pl = nd.memProp.length }
  else if nd is OptMember { pl = nd.omProp.length }
  let i = 0
  while i < symMemNode.length {
    if symMemNode[i] == ix {
      symMemTy[i] = ty
      return ty
    }
    i = i + 1
  }
  symMemNode.push(ix)
  symMemTy.push(ty)
  symMemLine.push(t.line)
  symMemCol.push(t.col)
  symMemEndCol.push(t.col + pl)
  ty
}

// Record a method-CALL callee member name (`xs.push`, `m.set`, `s.slice`) for
// semantic tokens. A method call's callee never flows through the member-read
// arm (the builtin arms type and return it directly), so `symMem` never sees it;
// this records its property-name span, classified as a `method`. A later `symMem`
// for the same node (a struct field holding a function, resolved via the call's
// fall-through) overwrites the type so member hover still works for that case.
function symMemMethod(ix: i32) {
  if symEnabled == 0 { return ix }
  if ix < 0 || ix >= nodeToks.length { return ix }
  const tk = nodeToks[ix]
  if tk < 0 || tk >= P.toks.length { return ix }
  const t = P.toks[tk]
  let pl = 0
  const nd = P.nodes[ix]
  if nd is Member { pl = nd.memProp.length }
  else if nd is OptMember { pl = nd.omProp.length }
  let i = 0
  while i < symMemNode.length {
    if symMemNode[i] == ix { return ix }
    i = i + 1
  }
  symMemNode.push(ix)
  symMemTy.push(SYM_MEM_METHOD)
  symMemLine.push(t.line)
  symMemCol.push(t.col)
  symMemEndCol.push(t.col + pl)
  ix
}

// Strip a module-merge mangling suffix (`add$m1` → `add`) so an imported name
// shows under its SOURCE name in completion. The merge appends `$m<N>` (N = the
// module table index) to every cross-module name; `$` is not a legal identifier
// char (the lexer forbids it), so the first `$` marks the suffix. A name without
// a `$` (every single-file / same-module binding) is returned unchanged.
export function demangleName(nm: string) {
  let i = 0
  while i < nm.length {
    if nm[i] == '$' { return nm.slice(0, i) }
    i = i + 1
  }
  nm
}

// Strip every `$m<digits>` MODULE-MERGE mangle suffix from a free-form diagnostic MESSAGE
// — the merge renames a module's declarations `name` → `name$mN` (N = its table index),
// an internal name that must not surface to the user. `$` is not a valid source identifier
// char (the lexer), so the pattern is unambiguous. The message analogue of `demangleName`
// (which strips a BARE name): a message embeds the name mid-text, and `tyToStr` can embed a
// mangled TYPE name too (`Box$m1<i32>`), so both are cleaned by one pass over the text.
export function demangleMsg(s: string) {
  const out: i32[] = []
  let i = 0
  while i < s.length {
    if (
      s[i] == '$' &&
      i + 2 < s.length &&
      s[i + 1] == 'm' &&
      s[i + 2] >= '0' &&
      s[i + 2] <= '9'
    ) {
      i = i + 2
      while i < s.length && s[i] >= '0' && s[i] <= '9' { i = i + 1 }
    } else {
      out.push(s[i])
      i = i + 1
    }
  }
  fromCodePoints(out)
}

// Bind `name` to type-arena index `ty` in the innermost scope.
export function declare(name: string, ty: i32) {
  const top = T.scopes.length - 1
  T.scopes[top][name] = ty
  0
}

// Record `nodeIx` as the `FuncDecl` that `name` declares in the CURRENT scope.
function declareFnDeclNode(name: string, nodeIx: i32) {
  const top = fnDeclScopes.length - 1
  if top >= 0 { fnDeclScopes[top][name] = nodeIx }
  0
}

// The `FuncDecl` node `name` currently resolves to, or -1 when it resolves to
// something that is not a function declaration.
//
// The walk stops at the FIRST scope that binds `name` at all and asks only that
// frame — the scope chain's own shadowing rule. So a local binding that shadows
// a function name (`const parse = …` beside `function parse(…)`) answers -1
// rather than reaching past itself to the function, and the call keeps the
// exact-arity gate a function VALUE must have.
function lookupFnDeclNode(name: string) {
  let i = T.scopes.length - 1
  while i >= 0 {
    if T.scopes[i].has(name) {
      if i < fnDeclScopes.length { return fnDeclScopes[i][name] ?? -1 }
      return -1
    }
    i = i - 1
  }
  -1
}

// Look `name` up through the scope chain, innermost first. Returns its type-arena
// index, or `-1` if undeclared (innermost-wins, so shadowing works).
export function lookup(name: string) {
  let i = T.scopes.length - 1
  while i >= 0 {
    if T.scopes[i].has(name) { return T.scopes[i][name] ?? -1 }
    i = i - 1
  }
  -1
}

// Raise a diagnostic at AST node `at`, resolving its source position (the
// node's anchor token via the `nodeToks` side table) eagerly so the driver can
// render `line:col: message`. Every lookup is BOUNDS-CHECKED: a harness that
// builds `P.nodes` by hand (or resets it without resetting `nodeToks`) yields
// an out-of-range index, which degrades to "no position" (`tline == 0`), never
// a trap.
export function tErr(msg: string, at: i32) { tErrCoded(msg, at, "") }

// The EMITTER-CAPABILITY channel: raise an error for a construct the type
// system ACCEPTS but codegen cannot lower yet, under the stable
// `unsupported-lowering` category code. Keeps codegen maturity out of the type
// system's verdict vocabulary: a `tErr` says "this program is type-invalid", a
// `tErrUnsupported` says "this program is type-valid but cannot build". Both
// are errors (an unbuildable program must not pass), but tooling can tell them
// apart by code. Message convention: name the type-valid construct, then the
// workaround after an em dash.
function tErrUnsupported(msg: string, at: i32) {
  tErrCoded(msg, at, CODE_UNSUPPORTED_LOWERING)
}

function tErrCoded(msg: string, at: i32, code: string) {
  let ln = 0
  let co = 0
  if at >= 0 && at < nodeToks.length {
    const tk = nodeToks[at]
    if tk >= 0 && tk < P.toks.length {
      const t = P.toks[tk]
      ln = t.line
      co = t.col
    }
  }
  // An EXACT repeat (same message, same anchor) is noise, not information — two
  // passes can resolve the same annotation (the pass-1.5 hoist and the real pass
  // both report a generic-alias arity/bare-use error, identically positioned).
  // Drop the repeat; the diagnostic count stays small, so the scan is cheap.
  let di = 0
  while di < T.diags.length {
    const d = T.diags[di]
    if d.tat == at && d.tmsg == msg { return 0 }
    di = di + 1
  }
  T.diags.push({ tmsg: msg, tat: at, tline: ln, tcol: co, tcode: code })
  0
}

// ── small numeric / string helpers (no union narrowing) ──────────────────────

// Is type-arena index `ix` the `string` primitive?
function isStringTy(ix: i32) {
  if ix < 0 { return false }
  const t = T.tys[ix]
  if t is TyPrim { return t.primName == "string" }
  false
}

// Is type-arena index `ix` a numeric primitive (i32/i64/f32/f64)? A `TyErr` or
// `TyVar` placeholder also counts, so a checking failure or unresolved hole
// doesn't cascade a spurious "not a number" error.
function isNumeric(ix: i32) {
  if ix < 0 { return false }
  const t = T.tys[ix]
  if t is TyErr { return true }
  if t is TyVar { return true }
  if t is TyPrim {
    return t.primName == "i32" ||
      t.primName == "i64" ||
      t.primName == "f64" ||
      t.primName == "f32"
  }
  false
}

// The bare primitive name of type-arena index `ix`, or "" if it is not a primitive.
// ABSENCE IS `null`, NOT `""`. The old empty-string marker was never TESTED for anywhere
// — 0 sites compared this to `""` — it only had to lose every `== "i32"` comparison, which
// `null` does identically. `T | null` is the absence idiom the language already commits to.
function primNameOf(ix: i32): PrimName | null {
  if ix < 0 { return null }
  const t = T.tys[ix]
  if t is TyPrim { return t.primName }
  null
}

// The primitive name as TEXT, for the few consumers that spell it into a string rather
// than decide on it — a rep KEY builder, and the `as`-target spelling the canon pass
// writes back onto the node. Absence renders empty, which is what those sites read before.
export function primNameStr(p: PrimName | null): string {
  if p == null { return "" }
  p
}

// Numeric WIDENING lattice (B2): may a value of primitive type `sn` implicitly
// flow into a `dn`-typed slot? Only the LOSSLESS edges are permitted:
//   i32 → i64,  i32 → f64,  f32 → f64
// (plus every type to itself). Each preserves the value exactly. Codegen inserts
// the matching wasm convert at the boundary. Keyed on bare names so it is a pure
// value-lattice query independent of arena identity.
//
// REJECTED — needing an explicit conversion VL has no syntax for yet:
//   i32 → f32  (above 2^24 the i32 rounds to the nearest f32 — lossy)
//   i64 → f64  (above 2^53 the i64 rounds to the nearest f64 — lossy)
// plus every narrowing (i64→i32, f64→f32, …) and any float→integer (truncation).
function numWidensName(sn: PrimName | null, dn: PrimName | null) {
  if sn == dn { return false }
  if sn == "i32" {
    if dn == "i64" || dn == "f64" { return true }
  }
  if sn == "f32" {
    if dn == "f64" { return true }
  }
  false
}

// True when `src`→`dst` is an implicit numeric widening (see `numWidensName` —
// the lossless edges only; i32→f32 / i64→f64 are rejected as lossy).
function numWidens(src: i32, dst: i32) {
  numWidensName(primNameOf(src), primNameOf(dst))
}

// Are `a` and `b` two numeric operands of DIFFERENT but compatible types, so a mixed
// arithmetic/comparison widens the narrower side to the wider one? True exactly when
// one operand widens to the other (either direction). The shared op type
// is then the WIDER of the two (`widerNumeric`).
function mixesNumeric(a: i32, b: i32) {
  if numWidens(a, b) { return true }
  if numWidens(b, a) { return true }
  false
}

// The WIDER of two mixed numeric operands (the result/op type): whichever the other
// widens INTO. Caller guarantees `mixesNumeric(a, b)`.
function widerNumeric(a: i32, b: i32) {
  if numWidens(a, b) { return b }
  a
}

// Do two numeric type indices denote the SAME numeric type?
export function sameNumeric(a: i32, b: i32) {
  const ta = T.tys[a]
  const tb = T.tys[b]
  if ta is TyErr { return true }
  if tb is TyErr { return true }
  if ta is TyVar { return true }
  if tb is TyVar { return true }
  if ta is TyPrim {
    if tb is TyPrim { return ta.primName == tb.primName }
  }
  false
}

// Is the EXPRESSION at `ix` a bare SCALAR literal — a number, a string, a boolean,
// or one of those behind parens / a unary sign? These are the expressions a NOMINAL
// NEWTYPE destination adopts without an explicit conversion (P1.5, §2.3 of
// `docs/internals/newtype-design.md`): a literal carries no prior identity, so it is
// not a candidate for the brand confusion the type exists to prevent.
//
// Deliberately SYNTACTIC, and deliberately not the same question as `litTyOfExpr`:
// the rule is about how the value was WRITTEN, not about whether its type happens to
// be a literal type. An object / array literal is absent because it needs no arm —
// both already adapt element-wise through `assignableExpr`, which re-applies the
// brand rule one level down.
function exprIsBrandAdoptingLiteral(ix: i32) {
  if ix < 0 { return false }
  const e = P.nodes[ix]
  if e is Paren { return exprIsBrandAdoptingLiteral(e.parInner) }
  if e is Unary {
    if e.unOp == "-" { return exprIsBrandAdoptingLiteral(e.unArg) }
    return false
  }
  if e is NumLit { return true }
  if e is StrLit { return true }
  if e is BoolLit { return true }
  false
}

// Is the EXPRESSION at `ix` (peeling parens) a float `.` NUMBER literal? A float
// literal is polymorphic across the float types: it types f64 by default but
// re-encodes EXACTLY into an f32 slot, so a float literal flowing into an `f32`
// binding/operand is accepted (the demote that a general f64 value would need is
// never performed — the literal is encoded at f32 directly). Integer literals are
// NOT covered here (they ride the i32→{i64,f32,f64} widening lattice).
function isFloatLitExpr(ix: i32) {
  if ix < 0 { return false }
  const e = P.nodes[ix]
  if e is Paren { return isFloatLitExpr(e.parInner) }
  // A unary-minus over a float literal (`-1.5`) is still a float LITERAL — it
  // re-encodes exactly at f32 (negation is exact in IEEE-754), so it flows into any
  // f32 position the positive literal would (`f32 = -1.5`, `f32[] = [-1.5]`, an f32
  // map value / union atom / field). Without this a leading `-` made the value a
  // plain f64 expression, rejected as a lossy demote.
  if e is Unary {
    if e.unOp == "-" { return isFloatLitExpr(e.unArg) }
  }
  // A literal whose magnitude overflows f32 does NOT re-encode at f32 (it would
  // encode ±infinity), so it gets no f32 grant — it takes the normal
  // f64-value-into-f32 lossy-demote rejection at the flow site.
  if e is NumLit {
    if !hasDot(e.numText) { return false }
    return !f32LitOverflows(e.numText)
  }
  false
}

// Is the EXPRESSION at `ix` (peeling parens / a unary sign) an INTEGER literal whose
// value f32 holds EXACTLY (`intLexemeIsExactF32`)? The integer half of the contextual-
// f32-literal rule, and it takes the OTHER of the two principled designs on purpose:
//
//   - a `.` literal is CONTEXT-TYPED (`isFloatLitExpr`) — it is f32 from birth and
//     rounds ONCE, because an exactness gate would reject `0.1`, `0.2`, `3.14` and
//     every other useful constant, leaving the feature with nothing to admit;
//   - an integer literal is EXACTNESS-GATED — it denotes an exact integer, so silently
//     turning `16777217` into `16777216` would be precisely the lossy implicit
//     conversion VL's lossless-only posture exists to forbid.
//
// The unifying rule is one sentence: a literal is admitted into an f32 context exactly
// when f32 holds the best representation of what the author WROTE. Writing the `.` is
// the author asking for a real number (so rounding is the contract); writing an integer
// is not. An inexact integer constant keeps both escape hatches — `16777217.0` (one
// rounding, at f32) or `16777217 as f32` (an explicit convert) — so nothing is
// unreachable, only unsilent.
//
// Negation is exact in IEEE-754, so the sign peels exactly as it does for a float
// literal. A CHAR literal is NOT admitted: `'a'` is an i32 code point, and a code point
// in a float slot is a category confusion, not a numeric one.
function isExactF32IntLitExpr(ix: i32) {
  if ix < 0 { return false }
  const e = P.nodes[ix]
  if e is Paren { return isExactF32IntLitExpr(e.parInner) }
  if e is Unary {
    if e.unOp == "-" { return isExactF32IntLitExpr(e.unArg) }
  }
  if e is NumLit {
    if hasDot(e.numText) { return false }
    return intLexemeIsExactF32(e.numText)
  }
  false
}

// Does the EXPRESSION at `ix` adopt an f32 context as a LITERAL — either half of the
// contextual-f32-literal rule? The single predicate every f32 grant site asks, so the
// float and integer halves can never drift apart position by position (the defect the
// float half itself shipped through: it reached bindings before arguments, and
// arguments before returns).
function isF32AdoptingLitExpr(ix: i32) {
  if isFloatLitExpr(ix) { return true }
  isExactF32IntLitExpr(ix)
}

// Is this ordering comparison an f32 operand against an f32-adopting LITERAL? The
// comparison twin of `binOpType`'s literal-adopt arm: `fv > 1` / `1 > fv` compare at f32
// exactly as `fv + 1` computes at f32. Comparison needs its own site because it yields
// `TY_BOOL` and never consults `widerNumeric`, so the arithmetic arm cannot cover it.
function cmpF32LitAdopts(n: BinExpr, olt: i32, ort: i32) {
  if primNameOf(olt) == "f32" && isF32AdoptingLitExpr(n.binRight) {
    return true
  }
  primNameOf(ort) == "f32" && isF32AdoptingLitExpr(n.binLeft)
}

// The least upper bound used by `??` (host: `flatten(Union(nonNull(l), r))`):
// mutually-assignable types collapse to the wider; otherwise a two-member union.
function joinTys(a: i32, b: i32) {
  if a < 0 { return b }
  if b < 0 { return a }
  if assignable(b, a) { return a }
  if assignable(a, b) { return b }
  // Distinct variants: a FLATTENED, deduped union (nullability folds back
  // into a `?` wrapper) — mirrors the host's `flattenType(Union(...))`.
  const vars: i32[] = []
  flattenVariantsInto(a, vars)
  flattenVariantsInto(b, vars)
  const kept: i32[] = []
  let hasNull = false
  let i = 0
  while i < vars.length {
    const v = vars[i]
    if isNullTy(v) {
      hasNull = true
    } else {
      let dup = false
      let j = 0
      while j < kept.length {
        if kept[j] == v { dup = true }
        if sameVariantTy(kept[j], v) { dup = true }
        j = j + 1
      }
      if !dup { kept.push(v) }
    }
    i = i + 1
  }
  if kept.length == 0 { return TY_NULL }
  let res = kept[0]
  if kept.length > 1 {
    res = mkUnionTy(kept)
    // A joined litunion alias (`if c then k1 else k2`, `k ?? "a"` — both sides
    // the same alias / a member of it) re-mints the alias as a COPY; the
    // subset gate inside the stamp rejects a join that widened PAST it (b1).
    noteLitUnionCopy(res, a)
    noteLitUnionCopy(res, b)
  }
  if hasNull { return mkNullableTy(res) }
  res
}

// The RETURN-inference join (`noteInferredRet` only — NOT the general `joinTys`).
//
// SOUNDNESS — a HOLE must not collapse HERE. An inference hole is PERMISSIVELY
// assignable both ways, so `joinTys`'s mutual-assignability collapse silently picks
// one side and DROPS the other. A function whose returns join a guard-narrowed value
// with a hole-derived field —
//     function foobar(v) {
//       if v is {foo: string} then return v.foo   // `string`
//       return v.bar                              // `?fld.bar.?foobar.0`
//     }
// — then advertised plain `string` to EVERY call site while the emitter lowered the
// field's real type: `printString(foobar({bar: 42}))` reported no errors and emitted
// invalid wasm (an i32 in a `(ref $type)` slot). Keeping both sides as a DEFERRED
// JOIN hands the choice to the call site, where `substTyDeep` re-folds the members
// under the pinned argument (`refoldJoinUnion`).
//
// Deliberately scoped to the return accumulator. A deferred join is a checker-internal
// placeholder with NO runtime shape, so every path that could hand one to the emitter
// has to collapse it again (`collapseDeferredJoin` at the call site); widening
// `joinTys` itself put one on every value-`if` and let it escape as a node type, which
// the emitter classified as a real union box — invalid wasm for programs that worked.
function joinRetTys(a: i32, b: i32) {
  if a < 0 { return b }
  if b < 0 { return a }
  if a == b { return a }
  if !tyIsHole(a) && !tyIsHole(b) { return joinTys(a, b) }
  const kept: i32[] = []
  flattenVariantsInto(a, kept)
  flattenVariantsInto(b, kept)
  const uniq: i32[] = []
  let i = 0
  while i < kept.length {
    let dup = false
    let j = 0
    while j < uniq.length {
      if uniq[j] == kept[i] { dup = true }
      j = j + 1
    }
    if !dup { uniq.push(kept[i]) }
    i = i + 1
  }
  if uniq.length == 1 { return uniq[0] }
  const res = mkUnionTy(uniq)
  joinHoleUnions.push(res)
  res
}

// Collapse a DEFERRED JOIN that is about to ESCAPE the checker (a call's result type,
// which becomes a node type the emitter reads). Re-joining through the ordinary
// `joinTys` restores exactly the pre-change collapse, so an unresolvable join — a
// generic body calling a generic body, where the members name a hole this site does
// not bind — behaves as it always did instead of reaching codegen as a union the
// emitter has no rep for. Anything that is not a deferred join passes through.
function collapseDeferredJoin(tyIx: i32) {
  if !tyIsDeferredJoin(tyIx) { return tyIx }
  const t = T.tys[tyIx]
  if t is TyUnion {
    let res = -1
    let i = 0
    while i < t.uMembers.length {
      res = joinTys(res, t.uMembers[i])
      i = i + 1
    }
    if res >= 0 { return res }
  }
  tyIx
}

// Park the UNCOLLAPSED deferred join `tyIx` under call node `nodeIx` (last write
// wins — the checker re-walks a body once per inference pass, and the pass whose
// witnesses reach the call site is the last one).
// PARK a call node's uncollapsed deferred join. Never from the parameter-solve probe:
// that probe OBSERVES a body, and this table is keyed by CALL NODE, so a probe row is not
// the idempotent re-record the hole-NAME-keyed tables give — the real pass finds the row
// already present and declines to re-park, which silently dropped the escaped-join reject
// `soundness/hole-join-two-level-chain-reject.vl` pins.
function noteDeferredJoinNode(nodeIx: i32, tyIx: i32) {
  if paramSolveProbe { return 0 }
  if nodeIx < 0 { return 0 }
  let k = 0
  while k < dJoinNode.length {
    if dJoinNode[k] == nodeIx {
      dJoinTy[k] = tyIx
      return 0
    }
    k = k + 1
  }
  dJoinNode.push(nodeIx)
  dJoinTy.push(tyIx)
  0
}

// The type the RETURN accumulator should see for node `nodeIx`, whose checked type
// came back as `t`: the parked UNCOLLAPSED deferred join when this node is a call
// whose join the site could not decide, else `t` itself. This is the one consumer
// allowed to see a deferred join outside `substTyDeep` — `elaborateInferRets`
// already treats an inferred return that IS a deferred join as generic, exactly
// like the bare `TyVar` return it stands in for.
function inferRetTyOf(nodeIx: i32, t: i32) {
  if nodeIx < 0 { return t }
  let k = 0
  while k < dJoinNode.length {
    if dJoinNode[k] == nodeIx {
      if dJoinTy[k] >= 0 { return dJoinTy[k] }
      return t
    }
    k = k + 1
  }
  t
}

function isJoinHoleUnion(tyIx: i32) {
  let k = 0
  while k < joinHoleUnions.length {
    if joinHoleUnions[k] == tyIx { return true }
    k = k + 1
  }
  false
}

// A type that is (or wraps) a DEFERRED join — a union still carrying a hole
// member. It denotes no runtime shape of its own: each call site re-folds it to
// the single arm that site's pinned argument reaches, so the codegen-support
// floors that reject a genuine inferred union must skip it.
function tyIsDeferredJoin(tyIx: i32) {
  if tyIx < 0 { return false }
  const t = T.tys[tyIx]
  if t is TyNullable { return tyIsDeferredJoin(t.nInner) }
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if tyIsHole(t.uMembers[i]) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// The BASE hole a DERIVED member-read hole reads from: a FIELD read and a GUARDED
// alternative both bottom out at the hole they read (and nest — a field of a field).
// Any other hole (a plain param hole, and a `HD_RET` / `HD_ELEM` derivation) is
// returned unchanged, which is how `holeMemberDeadAt` tells "this member is a read
// off a pinned argument" from "this member IS an argument".
//
// Walks `hdBase` — the derivation the hole was MINTED with. The string form
// prefix-matched `?fld.` / `?galt.` and re-sliced the tail; a hole with no row is
// the old "no prefix matched, return the name unchanged".
function holeBaseTy(tyIx: i32) {
  const row = hdRowOf(tyIx)
  if row < 0 { return tyIx }
  const k = hdKind[row]
  if k == HD_FLD {
    // An EMPTY property name never bottoms out — the string form's `d > 0` guard
    // (a `?fld..<h>` from a parser error-recovery `""` member name has no first
    // dot to cut at, so it read as a non-derived name). Kept verbatim.
    if hdField[row].length == 0 { return tyIx }
    return holeBaseTy(hdBase[row])
  }
  if k == HD_GALT { return holeBaseTy(hdBase[row]) }
  tyIx
}

// SOUNDNESS GATE on the re-fold. Is deferred-join member `mIx` PROVABLY dead under
// these bindings — a branch the pinned argument can never take?
//
// Only a DERIVED member-read hole can be proven dead, and only against a CONCRETE
// pin: `?fld.bar.<h>` where `h` is pinned to an object with no `bar` (the read has
// no meaning, so that return never runs), or `?galt.…` whose guard the pin cannot
// satisfy. Everything else is LIVE — in particular a member that merely resolved to
// ANOTHER hole (`pick(x, "s", true)` inside a generic body binds `?pick.0` to the
// enclosing `?go.0`) is still undecided, not dead.
//
// Treating "still a hole after substitution" as dead — the first cut of this fix —
// was itself a soundness hole: `printString(pick(x, "s", true))` dropped the `?go.0`
// arm, reported plain `string`, recorded NO deferred argument constraint, and
// emitted invalid wasm for `go(1)` — a spelling the pre-existing collapse CAUGHT.
function holeMemberDeadAt(mIx: i32, bNames: string[], bTys: i32[]) {
  if mIx < 0 { return false }
  const t = T.tys[mIx]
  if !(t is TyVar) { return false }
  const base = holeBaseTy(mIx)
  if base == mIx {
    return false // not a derived read — never provably dead
  }
  const pin = substHoleTy(base, bNames, bTys)
  if pin < 0 {
    return false // the base is not pinned here — defer
  }
  if tyIsHole(pin) {
    return false // pinned to another hole — still undecided
  }
  // The base IS concrete, yet the derived read does not resolve: this branch cannot
  // be reached by this argument.
  substHoleTy(mIx, bNames, bTys) < 0
}

// Re-fold a deferred join under a call's bindings: drop every PROVABLY DEAD member
// (`holeMemberDeadAt`) and re-join the rest, so a call site where exactly one arm is
// live sees that arm's type rather than a spurious `A | B`. A member that is merely
// unresolved SURVIVES — the join stays deferred and re-folds again at the call site
// that finally pins it. Returns `tyIx` unchanged when nothing was dropped and no
// member changed (a concrete type keeps its arena identity).
//
// The re-join goes through `joinRetTys`, NOT `joinTys`: a surviving member that is
// still a HOLE must not be collapsed away by the mutual-assignability rule (a hole
// is permissively assignable both ways, so `joinTys` silently picks one arm). That
// is the very drop `joinRetTys` exists to avoid in the return accumulator; the re-fold has to
// hold the same line, or a re-fold that only RE-BASED its members (a generic body
// calling a generic body) would hand back one arm and lose the rest. Members that
// all resolved to concrete types fold through `joinTys` exactly as before.
function refoldJoinUnion(
  tyIx: i32,
  orig: i32[],
  subst: i32[],
  changed: boolean,
  bNames: string[],
  bTys: i32[],
) {
  let anyDead = false
  let i = 0
  while i < orig.length {
    if holeMemberDeadAt(orig[i], bNames, bTys) { anyDead = true }
    i = i + 1
  }
  if !anyDead && !changed { return tyIx }
  let res = -1
  let live = 0
  let j = 0
  while j < orig.length {
    if !holeMemberDeadAt(orig[j], bNames, bTys) {
      res = joinRetTys(res, subst[j])
      live = live + 1
    }
    j = j + 1
  }
  // Every arm proven dead is not a type — keep the union rather than invent one.
  if live == 0 || res < 0 { return mkUnionTy(subst) }
  res
}

// (`dotIndexFrom` and `decValOf` lived here. They existed ONLY to cut a derived
// hole's dotted path apart and to read the two arena indices a guarded member
// packed into it as DECIMAL TEXT. The derivation is a data structure now — see
// `hdKind` & co. — so both decoders are gone with their one caller.)

// Whether the expression is a bare `true`/`false` literal (through parens) —
// excluded from the A7 boolean→i32 value coercion (a literal in an i32 slot is
// more likely a mistake; write `1`/`0`).
export function isBoolLitExpr(ix: i32) {
  if ix < 0 { return false }
  const e = P.nodes[ix]
  if e is Paren { return isBoolLitExpr(e.parInner) }
  if e is BoolLit { return true }
  false
}

// True if `dstTy` has an f32 POSITION a float literal can re-encode into: a bare `f32`, a
// nullable `f32?` (the inner), or any f32 member of a union (recursively).
function dstAdmitsF32(dstTy: i32) {
  if dstTy < 0 { return false }
  if primNameOf(dstTy) == "f32" { return true }
  const t = T.tys[dstTy]
  if t is TyNullable { return dstAdmitsF32(t.nInner) }
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if dstAdmitsF32(t.uMembers[i]) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// Does function type `tyIx` carry an inference HOLE — a `TyVar` param or return? Such a type is a
// GENERIC (capability-bounded) function value (`(a, b) => a + b`), not a concrete signature.
function fnTyHasHole(tyIx: i32) {
  const t = T.tys[tyIx]
  if t is TyFunc {
    const ps = t.fnParamTypes
    let i = 0
    while i < ps.length {
      if tyIsHole(ps[i]) { return true }
      i = i + 1
    }
    return tyIsHole(t.fnRet)
  }
  false
}

// Do every deferred binary-op constraint THIS binding resolves hold (the capability check, as a
// pure boolean — `validateBinCstrs` is the diagnostic-emitting twin)? A constraint still touching
// an unbound hole defers (true here).
function binCstrsHold(bNames: string[], bTys: i32[]) {
  let ci = 0
  while ci < binCstrOp.length {
    const clt = substTyDeep(binCstrLt[ci], bNames, bTys)
    const crt = substTyDeep(binCstrRt[ci], bNames, bTys)
    if !tyIsHole(clt) {
      if !tyIsHole(crt) {
        if !binOpDefinedFor(binCstrOp[ci], clt, crt) { return false }
      }
    }
    ci = ci + 1
  }
  true
}

// Is a GENERIC function value of type `srcTy` (hole params/return) assignable to the CONCRETE
// function type `dstTy`? Instantiate it at `dstTy`'s param types (bind the holes), require the
// body's capability to hold there and the substituted return to match `dstTy`'s return — exactly
// the per-call-site instantiation, but driven by the target type. This governs every typed boundary
// a generic function value meets (an annotated binding/param/return/element); the emitter then
// materializes that instance (`monoInstanceFor`). The permissive structural `assignable` (which a
// hole passes unconditionally) would wrongly accept a return/capability mismatch that cannot lower.
function genericFnAssignable(srcTy: i32, dstTy: i32) {
  const s = T.tys[srcTy]
  const d = T.tys[dstTy]
  if s is TyFunc {
    if d is TyFunc {
      const sp = s.fnParamTypes
      const dp = d.fnParamTypes
      if sp.length != dp.length { return false }
      const bNames: string[] = []
      const bTys: i32[] = []
      let i = 0
      while i < sp.length {
        bindGenWalk(sp[i], dp[i], bNames, bTys)
        if !assignable(dp[i], sp[i]) { return false }
        i = i + 1
      }
      if !binCstrsHold(bNames, bTys) { return false }
      if !argCstrsHold(bNames, bTys) { return false }
      return assignable(substTyDeep(s.fnRet, bNames, bTys), d.fnRet)
    }
  }
  false
}

// Whether a struct type is SOUND to box into a value union via a WIDENING struct
// literal (`{f: 97.5}` into `{f: f32} | {w: i32}` — the checker adopts the arm,
// the emitter boxes the plain struct into the union rep). Restricted to structs
// whose every field is a primitive scalar / string / boolean, or a nested plain
// struct: the emitter boxes exactly those into a union today. A field that is
// itself a LITUNION (or any other composite needing its own boxed rep) has no
// such union-boxed rep yet — adopting it would emit INVALID wasm — so those arms
// stay a loud reject (the emit-rep work is the sibling agents' territory).
function unionArmBoxSafe(tyIx: i32) {
  const t = T.tys[tyIx]
  if !(t is TyObj) { return false }
  const ftys = t.objFieldTypes
  let i = 0
  while i < ftys.length {
    const ft = T.tys[ftys[i]]
    if ft is TyPrim {
      // scalar / string / boolean field — boxes cleanly
    } else if ft is TyObj {
      if !unionArmBoxSafe(ftys[i]) { return false }
    } else if tyIsLitUnion(ftys[i]) {
      // A literal-union field (`f: K0`) boxes as its interned i32 ATOM: the variant
      // tables record the union name (`uFieldElemName`, the `sFieldElemName` twin) and
      // the variant construct path lowers a member literal as its atom id — the same
      // rep the plain struct field carries.
    } else if T.tys[ftys[i]] is TyFunc {
      // A bare FUNCTION-typed field (`f: (i32) => K0`) boxes as the closure fat-pointer
      // (code 14) — the variant construct passes the lambda through, and the narrowed
      // member call routes to `call_ref` (`exprIsClosure`'s variant-member arm). A
      // NULLABLE closure field stays out (its arm rep is not yet proven here).
    } else if ft is TyNullable {
      // A NULLABLE-litunion field (`f: K0 | null`, the code-30 i32 niche with the -1
      // sentinel) and a nullable-f32 field (`f: f32 | null`, the code-16 value box the
      // plain struct field already carries) both box: the variant construct path
      // threads the same per-code arms the plain struct-literal path uses. Other
      // nullable field types keep their loud reject (their variant rep is unproven).
      const nfi = ft.nInner
      if nfi < 0 { return false }
      if !(tyIsLitUnion(nfi) || primNameOf(nfi) == "f32") { return false }
    } else {
      return false
    }
    i = i + 1
  }
  true
}
// Literal-aware assignability for a numeric binding/argument/return: the normal
// `assignable` lattice, PLUS the float-literal→f32 exception (`isFloatLitExpr`). Used
// where the SOURCE EXPRESSION node is in hand (so the literal can be recognized);
// type-only sites keep using `assignable`.
// Record the destination ARRAY type on an ArrayLit source whose element target is a
// NICHE-nullable scalar (`K | null` / `boolean | null` / `string | null`), peeling a
// nullable destination wrapper (`(K|null)[] | null`) and grouping parens. Runs BEFORE
// `assignableExpr`'s plain-assignable short-circuit: `[null]` infers `null[]`, which IS
// covariantly assignable, so the literal-aware adoption block (where the litunion-array
// recording lives) is never reached for it — yet the recorded type is the emitter's ONLY
// classification signal for a literal with no rep-classifying element (all-`null`, or a
// string-first `["x", null]` that would else claim the plain string list).
function recordNicheNulElemArrayLit(srcExpr: i32, dstTy: i32, depth: i32) {
  if inferQuiet || srcExpr < 0 || dstTy < 0 || depth <= 0 { return 0 }
  let dtix = dstTy
  const dN = T.tys[dtix]
  if dN is TyNullable { dtix = dN.nInner }
  // An UNFILLED A-infer-null hole (`let x = null`) peels to no inner — nothing to record
  // (indexing the arena at -1 traps the compiler).
  if dtix < 0 { return 0 }
  const d = T.tys[dtix]
  const e = P.nodes[srcExpr]
  if e is Paren {
    // Record on the WRAPPING Paren too, not only the inner literal: the emitter's
    // typed-IR fast paths (`exprStringArray` and siblings) consult whichever node a
    // consumer holds — a Paren keeping its stale pre-adoption record (`string[]`)
    // would re-claim the wrong rep at the closure-result classification.
    if recordNicheNulElemArrayLit(e.parInner, dtix, depth) == 1 {
      while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
      nodeTyIx[srcExpr] = dtix
      return 1
    }
    return 0
  }
  if d is TyArray {
    if tyIsNicheNulScalarElem(d.aElem) {
      if e is ArrayLit {
        while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
        nodeTyIx[srcExpr] = dtix
        return 1
      }
    }
    return 0
  }
  // A niche-nul-elem array nested in a STRUCT-FIELD literal value (`{f: [null]}` against
  // `{f: (K | null)[] | null}`): the WHOLE ObjLit is covariantly `assignable`, so
  // `assignableExpr`'s field-wise recursion (line ~3733 — which would re-stamp the inner
  // array) is never reached; descend here, mirroring `recordNullHoleObjAdopt`. Only the
  // inner niche array is re-stamped — the ObjLit keeps its own struct record. Guarded
  // against recursive destinations (`tyDeeperThan`) exactly like the null-hole sibling.
  if d is TyObj {
    if e is ObjLit {
      if tyDeeperThan(dstTy, 16) { return 0 }
      const dfn = d.objFieldNames
      const dft = d.objFieldTypes
      let k = 0
      while k < e.objFields.length {
        const f = P.nodes[e.objFields[k]]
        if f is FieldInit {
          let dj = -1
          let j = 0
          while j < dfn.length {
            if dfn[j] == f.fiName { dj = j }
            j = j + 1
          }
          if dj >= 0 {
            recordNicheNulElemArrayLit(f.fiValue, dft[dj], depth - 1)
          }
        }
        k = k + 1
      }
    }
    return 0
  }
  0
}
// True when the type at `ti` carries a BARE-`null` HOLE in a struct-field / array-element
// position (`{f: null}`, `{f: {f: null}}`, `null[]` inside a field): such a render is a
// literal's own structural inference, never a spellable annotation — no registered shape
// row can match it, so a name-keyed consumer resolving through it mis-keys. Walks
// TyObj / TyArray only (a null inside a closure signature or map value is not a literal
// hole); depth-capped against recursive types.
function tyHasNullHole(ti: i32, depth: i32): boolean {
  if ti < 0 || depth <= 0 { return false }
  const t = T.tys[ti]
  if t is TyPrim { return t.primName == "null" }
  if t is TyObj {
    const fts = t.objFieldTypes
    let i = 0
    while i < fts.length {
      if tyHasNullHole(fts[i], depth - 1) { return true }
      i = i + 1
    }
    return false
  }
  if t is TyArray { return tyHasNullHole(t.aElem, depth - 1) }
  false
}

// True when the type structure reachable from `ti` nests DEEPER than `budget` levels
// of obj/array/nullable/union wrappers — in particular, a RECURSIVE type
// (`type L = {n: L | null}`) exceeds every finite budget. `recordNullHoleObjAdopt`
// skips such destinations: a recursive re-stamp would send the emitter's canonical
// render (`tyToEmitName`, no back-edge vocabulary) into unbounded recursion.
function tyDeeperThan(ti: i32, budget: i32): boolean {
  if ti < 0 { return false }
  if budget <= 0 { return true }
  const t = T.tys[ti]
  if t is TyObj {
    const fts = t.objFieldTypes
    let i = 0
    while i < fts.length {
      if tyDeeperThan(fts[i], budget - 1) { return true }
      i = i + 1
    }
    return false
  }
  if t is TyArray { return tyDeeperThan(t.aElem, budget - 1) }
  if t is TyNullable { return tyDeeperThan(t.nInner, budget - 1) }
  if t is TyUnion {
    const ms = t.uMembers
    let i = 0
    while i < ms.length {
      if tyDeeperThan(ms[i], budget - 1) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// Record the DESTINATION type on an ObjLit (or ArrayLit-of-ObjLit) source whose OWN
// checked type carries a bare-`null` hole (`[{f: {f: null}}]` against
// `{f: {f: i64 | null}}[]`): the hole-carrying type is covariantly ASSIGNABLE, so
// `assignableExpr`'s literal-aware adoption block is never reached — yet the recorded
// type is the emitter's ambiguity-resolution signal (`structIndexOfObjCtx`), and the
// null-hole render resolves NO registered row (its canon key is a proven mismatch
// against every twin), falling back to the first same-fieldset row — the WRONG twin
// when an inner/outer pair shares the fieldset (invalid wasm; fuzz sweep7 declared
// leg, seed 129301940 case_00201). The struct-element sibling of
// `recordNicheNulElemArrayLit`; like it, runs BEFORE the plain-assignable
// short-circuit. Nested ObjLit field values re-stamp recursively so the inner
// literal's resolution corrects too. Returns 1 when this node was re-stamped.
function recordNullHoleObjAdopt(srcExpr: i32, dstTy: i32, depth: i32) {
  if inferQuiet || srcExpr < 0 || dstTy < 0 || depth <= 0 { return 0 }
  // A RECURSIVE destination (`type L = {n: L | null}` — its `{n: null, v: 7}` tail
  // literal is exactly a null-hole source) must NOT re-stamp: see `tyDeeperThan`.
  if tyDeeperThan(dstTy, 16) { return 0 }
  let dtix = dstTy
  const dN = T.tys[dtix]
  if dN is TyNullable { dtix = dN.nInner }
  if dtix < 0 { return 0 }
  const d = T.tys[dtix]
  const e = P.nodes[srcExpr]
  if e is Paren {
    if recordNullHoleObjAdopt(e.parInner, dtix, depth) == 1 {
      while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
      nodeTyIx[srcExpr] = dtix
      return 1
    }
    return 0
  }
  if d is TyArray {
    if e is ArrayLit {
      let any = 0
      let i = 0
      while i < e.arrElems.length {
        if recordNullHoleObjAdopt(e.arrElems[i], d.aElem, depth - 1) == 1 {
          any = 1
        }
        i = i + 1
      }
      if any == 1 {
        while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
        nodeTyIx[srcExpr] = dtix
      }
      return any
    }
    return 0
  }
  if d is TyObj {
    if e is ObjLit {
      // Only a literal whose OWN recorded type carries a null hole re-stamps —
      // a fully-classified literal keeps its structural record untouched.
      let own = -1
      if srcExpr < nodeTyIx.length { own = nodeTyIx[srcExpr] }
      if !tyHasNullHole(own, 6) { return 0 }
      // Every literal field must exist on the destination (else this is not an
      // adoption — the assignability error path owns it). Validate the full field
      // set FIRST, so a late miss leaves no partial re-stamp behind.
      const dfn = d.objFieldNames
      const djs: i32[] = []
      let k = 0
      while k < e.objFields.length {
        const f = P.nodes[e.objFields[k]]
        if f is FieldInit {
          let dj = -1
          let j = 0
          while j < dfn.length {
            if dfn[j] == f.fiName { dj = j }
            j = j + 1
          }
          if dj < 0 { return 0 }
          djs.push(dj)
        } else {
          djs.push(-1)
        }
        k = k + 1
      }
      k = 0
      while k < e.objFields.length {
        const f = P.nodes[e.objFields[k]]
        if f is FieldInit {
          if djs[k] >= 0 {
            recordNullHoleObjAdopt(
              f.fiValue,
              d.objFieldTypes[djs[k]],
              depth - 1,
            )
          }
        }
        k = k + 1
      }
      while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
      nodeTyIx[srcExpr] = dtix
      return 1
    }
    return 0
  }
  0
}

export function assignableExpr(srcExpr: i32, srcTy: i32, dstTy: i32) {
  // (A GENERIC function value meeting a CONCRETE function type is decided by instantiation inside
  // `assignable`'s `TyFunc` case — `genericFnAssignable` — so it governs nested positions like an
  // array element too, not just this expression-level entry.)
  recordNicheNulElemArrayLit(srcExpr, dstTy, 6)
  recordNullHoleObjAdopt(srcExpr, dstTy, 6)
  // REP SIDECAR (phase 0a2): an ObjLit/ArrayLit whose source type reaches an unresolved
  // empty-collection hole (`{nodes: []}`, `{m: Map()}`) is plainly `assignable` to its
  // concrete destination — the empty fits any element type — so the short-circuit below
  // returns BEFORE the literal-aware adoption block (which records the destination rep).
  // Record the destination struct/array here so the emitter's row resolver keys the
  // element-resolved shape (`{nodes: i32[]}`) rather than the naive hole (`{nodes: ![]}`).
  // PURE (writes only `nodeRepTyIx`) → byte-identical this phase.
  if !inferQuiet && srcExpr >= 0 && tyReachesEmptyHole(srcTy, 8) {
    recordRepTyAdopt(srcExpr, dstTy, 6)
  } else if !inferQuiet && srcExpr >= 0 && tyReachesUnion(dstTy, 8) {
    // Union-softening adoption (see `tyReachesUnion`): an ObjLit/ArrayLit whose
    // field value narrowed a destination union field leaves the recorded rep type
    // softened, mis-resolving a same-fieldset twin. Re-stamp the destination rep so
    // the emitter's structural row resolver keys the union-bearing shape. PURE
    // (writes only `nodeRepTyIx`).
    recordRepTyAdopt(srcExpr, dstTy, 6)
  }
  // THE FLOW HOOK for the un-annotated-parameter solve. It sits ABOVE the
  // `assignable` short-circuit because a HOLE source always returns there
  // (`assignable` answers true for a `TyVar` immediately), so this is the only point
  // in the function a hole reaches — and every binding / argument / return / field /
  // element / store position flows through here, which is what makes one hook enough.
  // Inert unless the parameter-solve probe is running.
  noteHoleFlow(srcTy, dstTy)
  if assignable(srcTy, dstTy) {
    // THE OBJECT-SHAPE FLOOR. `assignable` accepts structural subtyping between two
    // object shapes and the emitter has no adapter for it (`objShapeAdapterless`), so the
    // pair used to reach codegen and fail there while `vl check` reported the file clean.
    // It belongs at THIS seam — the one every binding / argument / return / field /
    // element / store flows through — for the reason `assignable`'s own placement note
    // gives: no position can be taught half the rule.
    //
    // Reported here and answered TRUE: the program IS type-valid, so a second
    // "cannot assign" from the caller would contradict this one. The error already
    // recorded is what fails the check.
    if !inferQuiet && srcExpr >= 0 {
      if objShapeAdapterless(srcExpr, srcTy, dstTy, 12) {
        objShapeAdapterlessErr(srcExpr, srcTy, dstTy)
      }
    }
    return true
  }
  // NOMINAL NEWTYPE (P1.5): a SYNTACTIC literal is brand-polymorphic — it adopts the
  // destination's brand (`const e: EntityId = 1`, `xs: EntityId[] = [1, 2]`). A literal
  // has no prior identity, so it cannot be the confusion a newtype exists to catch:
  // that bug class is entirely about a VARIABLE carrying the wrong brand. Rejecting it
  // would buy no safety and would cost every sentinel constant in engine code.
  //
  // Only the destination's OWN brand is waived, by retrying against the base index; the
  // structural check underneath is unchanged, so nothing else is relaxed. An OBJECT
  // literal needs no arm here at all — the field-wise block below reads `T.tys[dstTy]`
  // (a branded index is a second index over the SAME `Ty`, so it IS the `TyObj`) and
  // recurses through `assignableExpr` per field, which re-applies the brand rule to
  // every field value. A wrongly-branded variable inside a literal still rejects.
  if nomLitAdopts(srcExpr, srcTy, dstTy) { return true }
  // A LITERAL re-encodes EXACTLY at f32, so it flows into any destination whose f32
  // position it fits: a bare `f32`, a nullable `f32?` (a map value / niche), or an f32 MEMBER
  // of a union (`f32 | string`). A `.` literal is context-typed and rounds once; an integer
  // literal must be exactly representable (`isF32AdoptingLitExpr`). An arbitrary f64 or i32
  // VALUE is NOT covered (that is a lossy demote — the rule is about literals, not values).
  //
  // DESTINATION FIRST, and that order is load-bearing for COMPILE TIME, not style: the
  // integer half of `isF32AdoptingLitExpr` folds the lexeme into a BIGNUM, and this is the
  // seam every binding / argument / return / field / element / store / push flows through.
  // Asking the literal first would pay that allocation for every integer literal in the
  // program, nearly all of which have an i32 destination; `dstAdmitsF32` is a short arena
  // walk that answers false immediately for them. Both predicates are pure, so the swap is
  // an evaluation-order change only. (This compiler is WasmGC-allocation-bound.)
  if dstAdmitsF32(dstTy) {
    if isF32AdoptingLitExpr(srcExpr) { return true }
  }
  // (A float-literal array → `f32[]`, and any literal array adapting element-wise, is handled by
  // the `ArrayLit` recursion in the literal-aware block below — the array dual of the ObjLit case.)
  // `boolean`-where-`i32`-expected coercion (A7): a boolean-typed VALUE flows
  // into an i32 slot as 1/0 (a no-op in codegen — boolean rides in an i32).
  // One-directional, and a bare `true`/`false` LITERAL is excluded.
  if primNameOf(dstTy) == "i32" {
    if primNameOf(srcTy) == "boolean" && !isBoolLitExpr(srcExpr) { return true }
  }
  // LITERAL-typed destination (host: a literal expression carries its own
  // literal type): a bare literal flows wherever its LITERAL type is a member
  // (`"a"` into `"a" | "b"`), even though its softened base (`string`) does not.
  if srcExpr >= 0 {
    const lTy = litTyOfExpr(srcExpr)
    if lTy >= 0 {
      if assignable(lTy, dstTy) { return true }
    }
    // An OBJECT LITERAL checks field-wise against a literal-bearing object
    // target, so a field's bare literal can match a literal-union field
    // (`{tag: "circle", r: 5}` against `{tag: "circle" | "square", r: i32}`).
    const e = P.nodes[srcExpr]
    if e is Paren { return assignableExpr(e.parInner, srcTy, dstTy) }
    if e is ObjLit {
      const s = T.tys[srcTy]
      if s is TyObj {
        // A nullable struct target (`S | null` / a `V?` map value) peels its wrapper so an object
        // literal still adapts field-wise into the inner struct — the ObjLit dual of the ArrayLit
        // nullable peel below (without it a float-literal `f32` field, a litunion field, or an
        // omitted-nullable field fails to coerce through the `| null`). The peel ITERATES: a
        // nullable-VALUE map slot (`{[string]: S | null}` — the stored `V?` over `S | null`)
        // stacks two wrappers, and a single unwrap left the literal against `S | null`.
        let dtix = dstTy
        let dPeel = true
        while dPeel {
          const dNW = T.tys[dtix]
          if dNW is TyNullable { dtix = dNW.nInner } else { dPeel = false }
        }
        const d = T.tys[dtix]
        if d is TyObj {
          const dnames = d.objFieldNames
          const dtys = d.objFieldTypes
          let i = 0
          let ok = true
          while i < dnames.length {
            const sft = objFieldType(s, dnames[i])
            if sft < 0 {
              // COMPLETION COERCION: an object literal may OMIT a field whose declared
              // type ADMITS null — the field is materialized as `null` at construction
              // (`let cat: Cat = { meow: 7 }` with `foo: i32 | null`). A non-nullable
              // omitted field is still required. Scoped to this EXPRESSION-aware path (an
              // object LITERAL against a known target), NOT general structural
              // assignability — so it never widens through a container / variance.
              if !tyAdmitsNull(dtys[i]) { ok = false }
            } else {
              // The field's VALUE expression, for the literal-aware recursion.
              let fexpr = -1
              const fl = e.objFields
              let fi = 0
              while fi < fl.length {
                const fn = P.nodes[fl[fi]]
                if fn is FieldInit {
                  if fn.fiName == dnames[i] { fexpr = fn.fiValue }
                }
                fi = fi + 1
              }
              if !assignableExpr(fexpr, sft, dtys[i]) { ok = false }
            }
            i = i + 1
          }
          // REP SIDECAR (phase 0a): a field-wise-adopted ObjLit builds the DESTINATION
          // struct rep (a boxed union field, an i64/f32 field, an omitted nullable field);
          // record it on the literal node so the emitter's row resolver keys the shape it
          // builds, not the naive self-inference. Unconsumed → byte-identical.
          if ok { recordRepTyAdopt(srcExpr, dstTy, 6) }
          return ok
        }
        // A struct literal flowing into a UNION adopts the FIRST struct arm it adapts
        // into field-wise (`{f: 97.5}` into `{f: f32} | {w: i32}`, `{a: 3.5, f: "x", …}`
        // into `{a: f32, f: K, …} | string`). The emitter already boxes a struct literal
        // into a union slot at a direct binding (the i32-field spelling lowers today); this
        // is the checker seam that lets a WIDENING field (a float-literal `f32`, a litunion
        // member) reach that same rep. Record the concrete arm on the literal node so the
        // shape interner / field encoder sees the arm's field types, not the inferred ones.
        if d is TyUnion {
          const members = d.uMembers
          let mi = 0
          while mi < members.length {
            const mt = T.tys[members[mi]]
            if mt is TyObj && unionArmBoxSafe(members[mi]) {
              if assignableExpr(srcExpr, srcTy, members[mi]) {
                if !inferQuiet {
                  while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
                  nodeTyIx[srcExpr] = members[mi]
                  // REP SIDECAR (phase 0a): the struct literal builds the concrete ARM
                  // struct's rep — record it (recursing into fields) for the row resolver.
                  recordRepTyAdopt(srcExpr, members[mi], 6)
                }
                return true
              }
            }
            mi = mi + 1
          }
        }
      }
    }
    // An array LITERAL checks element-wise against the target's element type, so a bare element
    // adapts exactly as it would at a binding — the array analogue of the ObjLit recursion above.
    // This SUBSUMES the scalar float-literal → `f32[]` rule and generalizes it to ANY element
    // type and ANY nesting depth: a float-literal element fits `f32[]`, an object-literal element
    // with an `f32` field fits `{x: f32}[]`, and a nested literal recurses (`[[1.5]]` → `f32[][]`).
    // An empty `[]` fits any element type (the loop does not run). An arbitrary non-literal value
    // element is NOT widened — the per-element `assignableExpr` still rejects a lossy f64 demote.
    if e is ArrayLit {
      // A map value / niche slot is `V?` (`{[string]: f32[]}` seeds `f32[]?`) — peel the nullable
      // wrapper(s) so a literal array still adapts into the inner element type (a nullable-VALUE
      // map slot stacks two wrappers; iterate like the ObjLit peel above).
      let dtix = dstTy
      let dPeel = true
      while dPeel {
        const dNW = T.tys[dtix]
        if dNW is TyNullable { dtix = dNW.nInner } else { dPeel = false }
      }
      const d = T.tys[dtix]
      if d is TyArray {
        let i = 0
        let ok = true
        while i < e.arrElems.length {
          if (
            !assignableExpr(e.arrElems[i], nodeTyIxOf(e.arrElems[i]), d.aElem)
          ) {
            ok = false
          }
          i = i + 1
        }
        // CONTEXT ADOPTION (atom lists): a literal array accepted by a literal-union
        // element target IS that atom list (`const ks: VK[] = ["aa", "bb"]`) — record the
        // destination array type on the literal node so the emitter classifies it as the
        // i32 atom-id list (`nodeArrayElemIsLitUnion`). Its member elements are string
        // exprs syntactically, so the literal's own recorded type is `string[]`, which
        // would else claim the string-list rep at every seam (slot, collect, construct).
        // The NICHE-nullable scalar elements (`K | null` / `boolean | null` / `string |
        // null`) record the same way: an all-`null` `[null]` self-infers as `null[]` (no
        // classifying element exists), so the recorded type is the ONLY signal the
        // emitter's element probes (`nodeArrayElemIsNulLitUnion` / `…NulBool` /
        // `…NulStr`) have at a position with no threaded annotation (a lambda body, an
        // argument) — one signal, every position.
        if (
          ok &&
          !inferQuiet &&
          (tyIsLitUnion(d.aElem) || tyIsNicheNulScalarElem(d.aElem))
        ) {
          if srcExpr < nodeTyIx.length { nodeTyIx[srcExpr] = dtix }
        }
        // REP SIDECAR (phase 0a): a literal array adopted element-wise (a struct-element
        // list `{f: boolean}[]` widened to `{f: boolean | {w: i32}}[]`, an i64/f32 element)
        // builds the destination element rep — recurse into the elements so each element
        // ObjLit resolves the shape the emitter builds. Unconsumed → byte-identical.
        if ok { recordRepTyAdopt(srcExpr, dstTy, 6) }
        return ok
      }
      // An array literal flowing into a UNION adopts the FIRST array arm it adapts into
      // element-wise (`["a"]` into `K0[] | {w: i32}`, `[1.5]` into `f32[] | i64`) — the
      // array dual of the ObjLit union-arm adoption above. The concrete arm is RECORDED
      // on the literal node so the emitter classifies the list with the arm's element
      // rep (an atom-id list, an f32 list), not the literal's softened one (`string[]` /
      // `f64[]`), and the union box tags the arm the checker picked.
      if d is TyUnion {
        const members = d.uMembers
        let mi = 0
        while mi < members.length {
          const mt = T.tys[members[mi]]
          if mt is TyArray {
            // An `f32[]` arm adopts like any other list arm: the f32-list value atom
            // (kind 12) gives the box a real rep, and the emitter's coerce re-encodes
            // the literal's f64-classified elements at f32 (`coerceListKind` 7).
            if assignableExpr(srcExpr, srcTy, members[mi]) {
              if !inferQuiet {
                while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
                nodeTyIx[srcExpr] = members[mi]
                // REP SIDECAR (phase 0a): record the concrete array ARM (recursing into
                // elements) so the row resolver keys the arm the checker picked.
                recordRepTyAdopt(srcExpr, members[mi], 6)
              }
              return true
            }
          }
          mi = mi + 1
        }
      }
    }
  }
  false
}

// Does `s` contain a "." (so a number literal is a float)? Indexing a string
// yields the i32 char CODE, so the comparison is against the char literal `'.'`.
function hasDot(s: string) {
  let i = 0
  while i < s.length {
    if s[i] == '.' { return true }
    i = i + 1
  }
  false
}

// Does the non-negative integer LEXEME `t` (decimal / `0x` hex / `0b` binary /
// `0o` octal, `_` separators skipped) fit the i32 range [0, 2147483647]? Ports
// the host's `defaultIntegerType` magnitude rule (typecheck.ts): an un-annotated
// integer literal defaults to i32 when its value fits, else widens to i64 —
// defaulting an out-of-range literal to i32 would silently wrap (0xDEAD_BEEF).
// A `NumLit` lexeme never carries a sign (unary minus is a separate node), so
// only the positive bound is checked. Digits fold with a pre-multiply overflow
// guard (`v > (max - d) / base`) instead of 64-bit arithmetic.
export function intLexemeFitsI32(t: string) {
  let v = 0
  let i = 0
  let base = 10
  if t.length >= 2 && t[0] == '0' {
    const p = t[1]
    if p == 'x' || p == 'X' {
      base = 16
      i = 2
    } else if p == 'b' || p == 'B' {
      base = 2
      i = 2
    } else if p == 'o' || p == 'O' {
      base = 8
      i = 2
    }
  }
  while i < t.length {
    const c = t[i]
    if c == '_' {
      i = i + 1
    } else {
      let d = 0
      if c >= '0' && c <= '9' { d = c - '0' }
      else if c >= 'a' && c <= 'f' { d = c - 'a' + 10 }
      else { d = c - 'A' + 10 }
      if v > (2147483647 - d) / base { return false }
      v = v * base + d
      i = i + 1
    }
  }
  true
}

// Is the integer LEXEME's magnitude EXACTLY 2^31 (2147483648)? The host PARSER
// folds a negated literal into a signed literal before defaulting (`-${text}`,
// parser.ts), so `-2147483648` / `-0x8000_0000` sits AT I32_MIN and defaults to
// i32 — even though the bare magnitude is one past I32_MAX. The unary `-` arm
// uses this for parity. Compares the significant digits (base prefix, `_`
// separators and leading zeros stripped) against 2^31 written in the lexeme's
// base; hex letters never match a decimal digit char, so no case folding needed.
export function intLexemeIs2Pow31(t: string) {
  let digits = "2147483648"
  let i = 0
  if t.length >= 2 && t[0] == '0' {
    const p = t[1]
    if p == 'x' || p == 'X' {
      digits = "80000000"
      i = 2
    } else if p == 'b' || p == 'B' {
      digits = "10000000000000000000000000000000"
      i = 2
    } else if p == 'o' || p == 'O' {
      digits = "20000000000"
      i = 2
    }
  }
  let started = false
  let j = 0
  while i < t.length {
    const c = t[i]
    if c == '_' {
      i = i + 1
    } else if !started && c == '0' {
      i = i + 1
    } else {
      started = true
      if j >= digits.length { return false }
      if c != digits[j] { return false }
      i = i + 1
      j = j + 1
    }
  }
  j == digits.length
}

// Is the EXPRESSION at `ix` (peeling parens) an INTEGER literal of magnitude
// exactly 2^31 — the one operand whose NEGATION fits i32 while the bare literal
// does not? Companion of `intLexemeIs2Pow31` for the unary `-` arm.
function isNegI32MinLit(ix: i32) {
  if ix < 0 { return false }
  const e = P.nodes[ix]
  if e is Paren { return isNegI32MinLit(e.parInner) }
  if e is NumLit {
    if hasDot(e.numText) { return false }
    return intLexemeIs2Pow31(e.numText)
  }
  false
}

// Map a written type NAME to its type-arena index (a primitive, or TY_ERR for an
// unknown name). Takes the bare NAME — NOT a `Node` index — so it never narrows
// the `Node` union (see Finding 2). The single caller (`checkNode`) extracts the
// `TypeRef`'s name inline before calling this.

// True if the type name contains the TOP-LEVEL separator `sep` (`|` for an
// inline-union synthetic name `A|B|null`, `&` for an intersection `A&B`).
function nameHasSep(name: string, sep: i32) {
  tyTopIndexOf(name, sep, 0, 0) >= 0
}

function nameHasPipe(name: string) { nameHasSep(name, '|') }

// D-ARRGROUP — THE ONE HOME of the array-ELEMENT grouping rule, shared by all THREE
// renderers (the two emit renderers and the DISPLAY renderer `tyToStrGo`, whose own
// `TyArray` arm was the shortened mirror: no grouping at all, so `(A | B)[]` rendered
// `A | B[]` — a spelling that parses successfully to `A | (B[])`, a DIFFERENT type, and
// makes the checker report that a type cannot be assigned to itself).
// Render the array whose element rendered as `el` and whose element ARENA type
// is `elTy`: the element is wrapped in grouping parens before the `[]` exactly when the
// suffix would otherwise re-bind — a FUNCTION element (`((i32) => i32)[]` is an array of
// functions, whereas bare the trailing `[]` binds into the closure's RESULT, spelling
// `(i32) => i32[]`, a function RETURNING a list; a depth-3 chain `(()=>(()=>i32)[])[]`
// mangled to `(()=>()=>i32[])` minted a ref-list slot distinct from the annotation's, the
// value call's `$fnsig` key missed and fell to the all-i32 arity sig — INVALID WASM at the
// call) or a UNION element, which is parenthesized precisely so its `|`s stop being
// top-level. The array sibling of the TyFunc-result / union-member / nullable-closure
// grouping-paren preservation.
//
// `tyToEmitNameGo` and `tyToNominalName` each carried this as a private four-line copy.
// They are the two renderers the SCORECARD CORRECTION's "kill the SOURCES" strategy points
// at, and a renderer asking `nameHasPipe` about a string it has just built is the disease
// in miniature. #1153's hand-off item 5 analysed two DUALS — the `emitNameAtoms` BANK and a
// structural `ae is TyUnion || ae is TyNullable` test — and #1191 declined both, because the
// structural test mis-parenthesizes a union whose members DEDUP to one part and only the bank
// was exact, while the bank existed on one renderer and not the other. Merging the copies
// left ONE site to convert; giving `tyToNominalName` its own `nomNameAtoms` bank supplied the
// missing half, and the conversion is the `elAtoms` parameter below.
//
// D-ARRWIDTH: the element's WIDTH is supplied BY ITS PRODUCER, not recovered by scanning the
// element name for a top-level `|`. A WIDE element (more than one top-level atom) is exactly
// a union element, because a render's width exceeds 1 only where the render itself wrote a
// top-level `|` (the union arm's join and the nullable arm's `|null` suffix). The one shape
// where a top-level `|` and a width of 1 coexist — a function type whose RESULT is a union,
// `(i32)=>f64|boolean` — is claimed by the TyFunc test ABOVE the width test and never
// reaches it. Measured at this site on both channels: see the D-ARRWIDTH section of
// `docs/internals/destringify-types-program.md`.
function arrElemRender(el: string, elTy: i32, elAtoms: i32): string {
  if tyIxIsFunc(elTy) { return "(" + el + ")[]" }
  if elAtoms > 1 { return "(" + el + ")[]" }
  el + "[]"
}

// Is arena index `ix` a FUNCTION type? TOTAL in `ix`, and that is the whole reason it
// exists: `-1` is the DECLARED HOLE an empty `[]` element or an unresolved lambda result
// carries (`tyArrayElemIx`'s note), and `T.tys[-1]` is an out-of-bounds `array.get` that
// TRAPS the compiler — no diagnostic, no location, just a wasm backtrace
// (`tests/cases/arrays/lambda-empty-array-literal-return.vl` states that failure shape).
// The two EMIT renderers never meet the hole because they decline the whole name ("")
// before the test; the DISPLAY renderer must render every type it is handed, holes
// included (the blank `_`), so it reaches the test with `-1` in hand. Asking here keeps the
// hole answered once rather than at each `is TyFunc` grouping site.
function tyIxIsFunc(ix: i32): boolean {
  if ix < 0 || ix >= T.tys.length { return false }
  const t = T.tys[ix]
  if t is TyFunc { return true }
  false
}

// The index of a TOP-LEVEL `=>` in `name`, or -1 — the FUNCTION-TYPE marker the parser
// emits for `(params) => ret`. An arrow nested in a param/return group
// (`((i32) => i32) => void`) or in a generic ARGUMENT (`Box<(i32) => i32>`) is NOT the
// top one; `'='` is the scanner's arrow token, so the `>` lookahead lives in the home.
function topLevelArrowIndex(name: string) { tyTopIndexOf(name, '=', 0, 0) }

// The TOP-LEVEL arrow index the LAST `isTopLevelFuncTypeName` call scanned for —
// produced BY the predicate instead of re-derived by a caller that needs the index as
// well as the answer (#1113's `canonAtoms` / `emitNameAtoms` pattern, applied to a
// POSITION rather than a width). Meaningful only when that call returned TRUE; a FALSE
// answer can come from any of the three conjuncts and leaves whatever the scan found.
//
// Not an arena-lifetime sidecar (method note 7): a scalar written on the way out of the
// predicate and read by the IMMEDIATE caller, with no call between the write and the
// read, never carried between programs.
let funcArrowAt = -1

// True if `name` is a top-level FUNCTION TYPE `(params)=>ret` — a top-level `=>` with the
// leading `(...)` param group closing right before it. The `=>` binds LOOSER than `|`/`&`,
// so `(i32) => A | B` is `(i32) => (A | B)` (a function returning a union), NOT
// `((i32) => A) | B`; this guards the union/intersection splits from grabbing a `|`/`&`
// that belongs to the return. A genuine `((i32) => i32) | string` has its arrow nested in
// parens (depth 1), so `topLevelArrowIndex` returns -1 and it still splits as a union.
export function isTopLevelFuncTypeName(name: string) {
  const arrowAt = topLevelArrowIndex(name)
  funcArrowAt = arrowAt
  if arrowAt < 1 { return false }
  // The PAREN grammar's OPEN half at its home in `tyname.vl`. The CLOSE half stays inline and
  // MUST: this is the ARROW-relative spelling — the param list closes right before the
  // `=>`, so the last character of the whole name belongs to the RETURN type, and
  // `nameIsParenSpanEnds` would answer about a different position entirely.
  if !nameIsParenOpen(name) { return false }
  if name[arrowAt - 1] != ')' { return false }
  true
}

// ── the TOP-LEVEL SPLIT: `splitTypeName` / `splitGenArgs` are `tyname.tyTopLevelSplit` ──
//
// D-SPLITDOWN. Both of this file's splitters WERE the SPLIT home written out again, and
// the six + two call sites now spell the home directly:
//
//   * `splitGenArgs(s, out)` was `tyTopLevelSplit(s, ',', true, out)` statement for
//     statement — the same `end = s.length` fall-through, the same `part.length > 0`
//     push gate (which is what `dropEmpty` true selects), the same `start = end + 1`
//     resume;
//   * `splitTypeName(name, sep, out)` was `tyTopLevelSplit(name, sep, false, out)`. Only
//     the `at < 0` arm was spelled differently — it pushed `slice(start, length)` inline
//     where the home assigns `end = s.length` and falls into the common push — and the
//     two agree on every input, not merely every reachable one: `at < 0` pushes
//     `slice(start, length)` on both sides, `at >= 0` pushes `slice(start, at)` on both,
//     and with `dropEmpty` FALSE the home's `part.length > 0 || !dropEmpty` gate is
//     unconditionally true, exactly as this one's push was unguarded.
//
// The home could not live in `emit_base.vl`, where #1147 minted it: that file imports
// THIS one, so a call from here would cycle the module graph. It lives in `tyname.vl`,
// the zero-import leaf, which is also where `tyTopIndexOf` — the only thing its body
// needs — already was. The census scored the three writings as three separate
// "single-writing" homes; they were one operation, and the down-move is what let all
// three reach it.

// The registry slot of a generic alias base name ("Box"), or -1.
function gaIndexOf(name: string) {
  let i = 0
  while i < gaNames.length {
    if gaNames[i] == name { return i }
    i = i + 1
  }
  -1
}

// The AST node (a TypeRef / annotation child) that diagnostics raised INSIDE
// name resolution anchor to — the generic-alias ARITY error (`applyGenAlias`)
// and the BARE-generic-use error (`nameToTy`). Resolution is name-keyed (no
// node flows through it), so the positioned entry points (let / param / return
// / field annotation resolution) bank their TypeRef node here via
// `nameToTyAt` / `resolveAnnotAt`; -1 (no position) outside them (e.g. the
// emitter's re-resolution calls, which re-raise errors the checker already
// reported positioned).
let annotDiagAt = -1

// Resolve an annotation from the parser's SPELLING TREE where the annotation
// node carries one, and from the concatenated NAME where it does not.
//
// `annTsOf` answers -1 for exactly two populations, and neither is a checker-time
// annotation: an emitter-SYNTHESIZED `TypeRef` (`synthTypeRef`), minted from a
// name the emitter computed and never passed through the parser, and a name a
// later pass rewrote without the node (`emit_rep`'s post-canon re-resolutions).
// Both reach `nameToTy` through the UNpositioned entries, which is why this is a
// ladder and not a replacement — see D-ASCANON's measurement (#1129): at the two
// POSITIONED funnels the tree is present on 333,073 of 333,073 reads.
function annotResolve(name: string, root: i32) {
  if root >= 0 { return tsToTy(root) }
  nameToTy(name)
}

// Resolve annotation NAME with resolution diagnostics anchored at node `at`,
// reading the spelling tree banked on annotation node `ann`.
//
// `at` and `ann` are the same node at three of the four callers. They differ at
// a struct FIELD, whose "unknown type" diagnostic anchors on the `FieldDef` (so
// the message points at the field, not at its type) while the spelling is banked
// on the `TypeRef` CHILD. Passing one node for both jobs is what made 3,851
// corpus reads look like a coverage hole in #1129's probe; the hop is the fix.
function nameToTyAnn(name: string, at: i32, ann: i32) {
  const saved = annotDiagAt
  annotDiagAt = at
  const r = annotResolve(name, annTsOf(ann))
  annotDiagAt = saved
  r
}

// The same, where the diagnostic anchor IS the annotation node.
function nameToTyAt(name: string, at: i32) { nameToTyAnn(name, at, at) }

// The TYPE on the right of an `is` / `!is` test, and of a `match` TYPE PATTERN
// (`parseMatchPattern` mints a real `IsExpr` for one, so both are the same node
// shape and the same channel). Resolved from the parser's SPELLING TREE, which
// D-PARSETY P2 banks on the `IsExpr` node ITSELF (`parseIsType` → `setAnnTs`,
// and `driver.vl`'s module merge rewrites that tree rather than the rendering).
//
// Five callers, one home: `checkIsExprNode`, the `match` arm checker, and — via
// the banked-read wrapper `isTypeTyRead` below — the two narrowing collectors and
// the if-chain exhaustiveness scan. All five already hold the node index, so this
// is a plain read, not a new sidecar.
//
// Diagnostics anchoring is deliberately NOT `nameToTyAt`'s: an `is` type has
// never set `annotDiagAt`, so a generic-arity error raised inside resolution
// keeps reporting where it reports today.
//
// `annotResolve`'s NAME leg is DEAD here, and structurally so rather than by
// luck: `mkIsExpr`/`mkIsExprNeg` have exactly three call sites, all three in
// `parser.vl` (the `is` / `!is` operators and `parseMatchPattern`), and every one
// banks a root with `setAnnTs` on the line after minting the node — so no `IsExpr`
// exists without a spelling tree, and `checkProgram` (the only caller of all five
// sites, from `driver.vl` alone) runs before the emitter can synthesize one.
// Measured: 0 tree-misses in 228,869 reads over 1,335 corpus files and 50,400 fuzz
// programs. The fall-through is not deleted because it is `annotResolve`'s shared
// body, serving the UNpositioned population — not a rung private to this site.
function isTypeTy(name: string, isIx: i32) { annotResolve(name, annTsOf(isIx)) }

// The same type, for the three READERS of an `is` node that has already been checked —
// the two narrowing collectors and the if-chain exhaustiveness scan. All three run inside
// the `if` whose condition `checkIsExprNode` has just resolved and BANKED (`isVarTyIx`,
// read here through `isVarTyIxOf`), on the same node, in the same type-parameter frame.
//
// Where the spelling is a bare NAME the bank IS the answer: `tsLeafTy` is three nominal
// lookups (`primTyOfName`, the type-param environment, the declaration) and allocates
// nothing for a name the node's own check already resolved, so re-entering the grammar
// returns the identical arena index.
//
// A COMPOSITE spelling (`{w: i32}`, `i32[]`, `()=>i64`, `("pp"|"qq")`) resolves instead,
// and the reason is the ARENA rather than the answer: `T.tys` is not hash-consed, so
// `tsToTyReal` mints a fresh row per structural spelling and the reader's index differs
// from the banked one BY CONSTRUCTION. Reading the bank there would delete that row and
// renumber every index after it, and `repElemKeyGo`'s identity arm keys `TyVar`/`TyLit`/
// `TyErr` by arena INDEX. The bare-name half is separable from the composite half exactly
// because it mints nothing to delete: skipping it removes no entry from the arena.
function isTypeTyRead(name: string, isIx: i32) {
  const banked = isVarTyIxOf(isIx)
  if banked >= 0 {
    const root = annTsOf(isIx)
    if root >= 0 {
      if tsKind[root] == TS_NAME { return banked }
    }
  }
  isTypeTy(name, isIx)
}

// Apply a generic alias (`Box<i32>`, `Pair<i32,string>`, `Box<T>` under a live
// type-param env): resolve the arguments in the CURRENT environment, check the
// arity, bind the declared parameter names to the argument types, and resolve
// the declaration's fields under those bindings — the host's `instantiateAlias`
// substitution. The result memoizes into `cUserTypes` under a RESOLVED key
// (`Box<#2>` — the head + the argument arena indices, NOT the spelled name:
// a `Box<T>` spelled under two different `T` bindings must not collide),
// REGISTERED as an empty placeholder before the fields resolve so a recursive
// application (`type A<T> = { next: A<T> | null }`) lands on its own (cyclic)
// arena index instead of recursing forever. Returns -1 for an unknown
// base/argument (the caller reports "unknown type"); a wrong ARITY reports
// here (the full name is otherwise well-formed, anchored at `annotDiagAt`)
// and yields the error type.
export function applyGenAlias(head: string, inner: string) {
  applyGenAliasArgs(head, inner, -1)
}

// The body of `applyGenAlias`, with the ARGUMENT list taken from either source:
// `appIx >= 0` is a `TS_APP` spelling node whose kids are the arguments, and
// `inner` is then unused; `appIx < 0` splits `inner` at its top-level commas.
// Everything after the argument list — arity, the resolved memo key, the
// placeholder registration, the field substitution — is one body precisely
// because the two routes must not be able to drift.
function applyGenAliasArgs(head: string, inner: string, appIx: i32) {
  const gi = gaIndexOf(head)
  if gi < 0 { return -1 }
  // The declared parameter names, read as a SLICE of the flat column — split
  // once when the alias registered (D-GAPARAM), not re-split here per
  // application. `pcount` is the declared ARITY.
  const pstart = gaParamStart[gi]
  const pcount = gaParamCount[gi]
  const argTys: i32[] = []
  if appIx >= 0 {
    const astart = tsKidStart[appIx]
    const acnt = tsKidCount[appIx]
    let ti = 0
    while ti < acnt {
      const kid = tsKids[astart + ti]
      // The recovery leaf renders `""`, which `splitGenArgs` drops — so `Box<>`
      // is an ARITY error on both routes, not an unresolved argument.
      if tsKind[kid] != TS_ERR {
        const a = tsToTy(kid)
        if a < 0 { return -1 }
        argTys.push(a)
      }
      ti = ti + 1
    }
  } else {
    const argNames: string[] = []
    tyTopLevelSplit(inner, ',', true, argNames)
    let ai = 0
    while ai < argNames.length {
      const a = nameToTy(argNames[ai])
      if a < 0 { return -1 }
      argTys.push(a)
      ai = ai + 1
    }
  }
  if argTys.length != pcount {
    tErr(
      "`" +
        head +
        "` expects " +
        i32ToStr(pcount) +
        " type arguments but got " +
        i32ToStr(argTys.length),
      annotDiagAt,
    )
    return TY_ERR
  }
  let memoKey = head + "<#"
  let mi = 0
  while mi < argTys.length {
    memoKey = memoKey + i32ToStr(argTys[mi]) + ","
    mi = mi + 1
  }
  if cUserTypes.has(memoKey) { return cUserTypes[memoKey] ?? -1 }
  const fnames: string[] = []
  const ftys: i32[] = []
  const resIx = mkObjTy(fnames, ftys)
  cUserTypes[memoKey] = resIx
  cUserTypesVer = cUserTypesVer + 1 // new declared-name resolution registered
  // TYPED-IR P1: bank the fact that this arena index IS the application `head<argTys>`.
  // Recorded on the memo MISS, so exactly one row exists per distinct application — the
  // same population `cUserTypes` keys, and the same index every later hit returns.
  gaAppTyIxs.push(resIx)
  gaAppHeads.push(head)
  gaAppArgStart.push(gaAppArgFlat.length)
  gaAppArgCount.push(argTys.length)
  gaAppFinite.push(-1)
  let gaf = 0
  while gaf < argTys.length {
    gaAppArgFlat.push(argTys[gaf])
    gaf = gaf + 1
  }
  let bi = 0
  while bi < pcount {
    tpEnvNames.push(gaParamNames[pstart + bi])
    tpEnvTys.push(argTys[bi])
    bi = bi + 1
  }
  const decl = P.nodes[gaDeclIxs[gi]]
  if decl is TypeDecl {
    const dfields = decl.tdFields
    let fi = 0
    while fi < dfields.length {
      const fd = P.nodes[dfields[fi]]
      if fd is FieldDef {
        fnames.push(fd.fdName)
        let fty = TY_ERR
        if fd.fdType >= 0 {
          const ftn = P.nodes[fd.fdType]
          if ftn is TypeRef {
            // The alias body's field annotation is a parsed `TypeRef` like any
            // other, so it resolves from its own spelling tree — under the `<T>`
            // bindings pushed above, which both routes read from `tpEnvNames`.
            const r = annotResolve(ftn.tyName, annTsOf(fd.fdType))
            if r >= 0 {
              fty = r
              // Record the resolved type on the field's TYPE-ANNOTATION node so the emitter
              // classifies a field type structurally from the `Ty` arena, not a re-parsed name (C1).
              if !inferQuiet && fd.fdType < nodeTyIx.length {
                nodeTyIx[fd.fdType] = r
              }
            } else {
              tErr(
                unknownTyText(ftn.tyName) + " for field '" + fd.fdName + "'",
                dfields[fi],
              )
            }
          }
        }
        ftys.push(fty)
      }
      fi = fi + 1
    }
  }
  // The placeholder registered above was just FILLED in place (its field arrays
  // are `fnames`/`ftys`) — an existing arena entry changed shape.
  tyMutEpoch = tyMutEpoch + 1
  let pj = 0
  while pj < pcount {
    tpEnvNames.pop()
    tpEnvTys.pop()
    pj = pj + 1
  }
  resIx
}

// ── The three LEAF rungs both resolvers bottom out at ────────────────────────
// `nameToTy` (the character-surgery resolver) and `tsToTy` (the structural one)
// differ only in how they take a COMPOSITION apart — a union, an array suffix,
// an inline object. Where the spelling is a bare identifier there is nothing to
// take apart, and both must answer identically, so the three leaf rungs live
// here once. Each is a NOMINAL lookup: a name is a name (the program plan's
// terminal condition explicitly keeps `structIndexByName("Cat")`), and none of
// them inspects a character of its argument.

// The primitive spellings. -1 = "not a primitive" (every hit is a fixed arena
// index, all >= 0, so the sentinel cannot collide with an answer).
//
// EXPORTED because the emit side's name bridge (`emit_rep.declTyIxOfName`) asks it
// directly: a bare primitive keyword is a leaf, and running the whole annotation
// grammar to arrive back here is the parse that bridge exists to avoid. The
// answers are the arena's SEEDED indices (`TY_I32` … `TY_NULL`, minted once per
// program by the reset above), so the emit-side rung and this resolver's own leaf
// are the same value by construction rather than by agreement.
export function primTyOfName(name: string) {
  if name == "i32" { return TY_I32 }
  if name == "i64" { return TY_I64 }
  if name == "f64" { return TY_F64 }
  if name == "f32" { return TY_F32 }
  if name == "boolean" { return TY_BOOL }
  if name == "string" { return TY_STR }
  if name == "void" { return TY_VOID }
  // The `null` type itself — the check type of `x is null` (host: an Alias
  // named "null"); union members spell it through the `|`-split / `TS_NULL`.
  if name == "null" { return TY_NULL }
  -1
}

// A live type-parameter BINDING (a generic function's `<T>` while its
// annotations resolve via `resolveAnnot`, or a generic alias application's
// params while its body resolves via `applyGenAlias`) — innermost wins.
// `tpEnvTys` only ever receives `mkTyVar` results and already-resolved argument
// types, both >= 0, so -1 unambiguously means "not bound".
function tpEnvTyOfName(name: string) {
  let tpi = tpEnvNames.length - 1
  while tpi >= 0 {
    if tpEnvNames[tpi] == name { return tpEnvTys[tpi] }
    tpi = tpi - 1
  }
  -1
}

// A declared struct/union type (registered by the program's pre-pass). A SINGLE-MEMBER union
// alias (`type Id = i32`, `type Name = string`, `type MyCat = Cat`) is TRANSPARENT — it denotes
// its member, not a one-variant union box. The parser accepts a bare `type N = A` as a one-member
// union, but a union of one is just that one type, so resolve to the member (`x: Id` is a plain
// `i32`, usable with `+`; before this it was the box → "operator + not defined" / invalid wasm).
function declaredTyOfName(name: string) {
  if cUserTypes.has(name) {
    // ORDER-INDEPENDENCE, at the one entry point every route to a declared type comes
    // through (`tsLeafTy` and `nameToTyReal`'s last rung both bottom out here). Pass 0a
    // minted this entry as an EMPTY placeholder and pass 0b fills it; a name resolved in
    // between reads the placeholder, which is a different TYPE and not merely a missing
    // one — see `forceDeclFill`. Inert outside pass 0b.
    forceDeclFill(name)
    const ut = cUserTypes[name] ?? -1
    if ut >= 0 {
      const utt = T.tys[ut]
      if utt is TyUnion {
        // Collapse a PRIMITIVE-scalar single member, and an OBJECT member reached through a
        // plain alias REFERENCE (`type MyCat = Cat`, `type Y = Box<i32>`). The one-member
        // OBJECT case that stays opaque is the canonicalized intersection (`type AB = {a}&{b}`),
        // which the emitter DOES intern as a named struct. `singleAliasMemberTyIx` is the single
        // rule both sides read — collapsing here without the emitter's `singleMemberAliasTyIx`
        // agreeing (or the reverse) diverges the two.
        const sm = singleAliasMemberTyIx(ut, name)
        // A NOMINAL NEWTYPE keeps the collapse and adds a brand on top of it
        // (`nwBrand` is the identity for every name not declared `new`). The
        // collapse must stay: it is what the EMITTER's `singleMemberAliasTyIx`
        // twin does with the same annotation, and the brand is invisible to it —
        // which is precisely why the newtype costs nothing to emit.
        if sm >= 0 { return nwBrand(name, sm) }
      }
    }
    return nwBrand(name, ut)
  }
  // A BARE reference to a generic alias has no concrete type — its parameters
  // were never supplied (host: `Generic type … was used without any`).
  if gaIndexOf(name) >= 0 {
    tErr(
      "Generic type `" +
        name +
        "` expects type arguments but was used without any",
      annotDiagAt,
    )
    return TY_ERR
  }
  -1
}

// The leaf a SPELLING NODE with nothing to decompose resolves to: `TS_NAME`'s
// identifier, `TS_MAP`'s key token, and `TS_ERR`'s `""`. All three are single
// tokens the lexer produced, so the composition arms `nameToTy` runs between
// the primitive check and the type-param check (an array suffix, a `{`-shape,
// a `<`-application) provably cannot fire on them — an IDENT lexeme holds no
// `[`, `{`, `<` or `|`.
function tsLeafTy(name: string) {
  const pv = primTyOfName(name)
  if pv >= 0 { return pv }
  const tv = tpEnvTyOfName(name)
  if tv >= 0 { return tv }
  declaredTyOfName(name)
}

// D-MAPKEYDIAG — the spelling node whose KEY the unsupported-map-key diagnostic
// names, or -1 when this annotation opens no map spelling. THE STRUCTURAL DUAL OF
// `tyname.mapSpellKeyName`'s GATE, which was this checker's last re-parse of a name
// it had itself rendered.
//
// That gate is `name[0] == '{' && name[1] == '['` — deliberately WIDER than a whole
// map span, because a LIST of boolean-keyed maps (`{[boolean]:i32}[]`) and a nullable
// one (`{[boolean]:i32}|null`) are the same user mistake and must get the same
// actionable message (`maps/error-unsupported-key-not-whole-span.vl` is the fixture
// that keeps that width honest). Read STRUCTURALLY, that width is a descent down the
// LEFT SPINE and nothing else, because `ast.tsToName` puts a child's first character
// at index 0 for exactly three constructors:
//
//   `TS_ARR`   renders `kid + "[]"`
//   `TS_UNION` renders `kid0 + "|" + …`
//   `TS_ISECT` renders `kid0 + "&" + …`
//
// Every other node opens with a character that cannot be `{[`: `TS_PAREN`/`TS_FUNC`
// with `(`, `TS_NEG` with `!`, `TS_APP` with its head IDENT, the leaves with their own
// lexeme, and `TS_OBJ` with a `{` whose NEXT character is a field NAME (an IDENT) or
// `}` — never `[`. So `i32 | {[boolean]:i32}`, `({[boolean]:i32})` and
// `{v: {[boolean]:i32}}` keep the bare "unknown type" they get today, and the descent
// carries no character comparison at all.
//
// Terminates because `tsMk` finishes a node only after its children, so a kid's arena
// index is strictly less than its parent's and the walk strictly descends.
function tsMapKeyNodeOf(root: i32) {
  let ix = root
  let out = -1
  let going = true
  while going {
    going = false
    if ix >= 0 {
      const k = tsKind[ix]
      if k == TS_MAP {
        out = ix
      } else if k == TS_ARR || k == TS_UNION || k == TS_ISECT {
        if tsKidCount[ix] > 0 {
          ix = tsKids[tsKidStart[ix]]
          going = true
        }
      }
    }
  }
  out
}

// ── `tsToTy` — the structural dual of `nameToTy` ─────────────────────────────
// `nameToTy` below is the compiler's SECOND recursive-descent type parser: the
// first one is `parseTypeName` (`compiler/parser.vl`), which had the annotation's
// whole structure in hand and returned a string built by concatenation. D-PARSETY
// (#1117) made that parser KEEP what it saw, as a flat spelling tree; this is the
// function that consumes it.
//
// Arm for arm, in `nameToTy`'s order, with the same constructors in the same
// sequence — the arena is not hash-consed, so a dual that allocates a different
// number of entries in a different order is not a dual. Every place `nameToTy`
// scans characters to find a boundary, this reads a child edge:
//
//   `nameHasPipe` + `splitTypeName(name, '|')`  → `TS_UNION`'s kids
//   `nameHasSep(name, '&')` + `splitTypeName`   → `TS_ISECT`'s kids
//   the `wraps` depth scan                      → `TS_PAREN`'s single kid
//   `topLevelArrowIndex` + the param split      → `TS_FUNC`'s kids (return LAST)
//   the trailing `[]` test                      → `TS_ARR`
//   the `"]:"` search                           → `TS_MAP`'s key text + value kid
//   the field/colon depth scans                 → `TS_OBJ`'s `TS_FIELD` kids
//   the `<`-scan + `slice`                      → `TS_APP`'s head text + kids
//
// Three places mirror a SKIP the string side gets for free from an empty render,
// and each is marked below: the parser's recovery leaf `TS_ERR` renders `""`, and
// `""` is dropped by `splitGenArgs`, by the union arm's `part.length > 0` guard,
// and by `(paramsStr.length > 0)`. `TS_ISECT` has no such guard and must NOT skip
// — `A &` poisons to -1 on both sides.
// ── the UNKNOWN-TYPE component bank ────────────────────────────
// Both type resolvers answer -1 for "did not resolve", and -1 propagates straight out
// of every composite arm (an unresolved element poisons its array, an unresolved member
// poisons its union, an unresolved field poisons its shape — each by design, so no `-1`
// sentinel leaks into the arena). The consequence for DIAGNOSTICS is that the caller
// only ever holds the WHOLE annotation, and the message degraded as the type nested:
//
//   v: any                        → unknown type 'any'
//   v: {bar: any}                 → unknown type '{bar:any}'          (blames the shape)
//   v: {foo: string} | {bar: any} → unknown type '{foo:string}|{bar:any}' (blames both)
//
// `unkTyPart` banks the FIRST failing component, written by the resolver wrappers below:
// the INNERMOST recursion to fail writes its own spelling and every enclosing frame sees
// a non-empty bank and leaves it alone, so what survives is the leaf, not the composite
// that carried it. The bank costs nothing on the success path (one length test) and no
// resolver arm changed — the wrapper is the whole mechanism.
//
// LIFETIME is one OUTERMOST resolution: `unkTyDepth` counts frames and the first frame
// clears the bank, so a speculative resolution elsewhere (`canonEmitName`'s `&` fold,
// `unionAliasMembers`) can never leave a stale part behind for a later diagnostic. The
// two resolvers share the counter deliberately — `tsToTy`'s generic-application arm calls
// into `nameToTy`, so they are one recursion, not two.
//
// REFUTED while measuring this: the report that the UNION case additionally "loses the
// second diagnostic entirely". It does not, at this head — 3 annotations × 7 function
// bodies, 21 cells: whether `cannot infer a return type for 'f'` accompanies the message
// is decided by the BODY (a body that returns the un-inferable param produces it, a body
// with no value return does not) and is identical for `any`, `{bar: any}` and
// `{foo: string} | {bar: any}`. Only the naming half of that report reproduces.
let unkTyPart = ""
let unkTyDepth = 0

// The SECOND bank on the same wire: a union member list the emitter cannot separate
// (`nomUnionRepClashMsg`) is a resolution failure with a diagnostic of its own, so
// `annUnionInnerTy` poisons the annotation to -1 exactly as an unresolved member does and
// banks WHY. Every `unknownTyText` caller then reports the specific reason without gaining
// an arm. Same lifetime as `unkTyPart` — cleared by the outermost resolver frame.
let unkTyClash = ""

// The `unknown type` diagnostic text for the whole annotation `name`, naming the
// offending COMPONENT when the bank holds one that is not the whole name. Read
// immediately after the failing resolution (every call site is a resolve/`tErr` pair).
function unknownTyText(name: string) {
  if unkTyClash.length > 0 { return unkTyClash }
  const part = unkTyPart
  if part.length == 0 { return "unknown type '" + name + "'" }
  if part == name { return "unknown type '" + name + "'" }
  // "within", not "in": two of the six call sites already append their own `in …` clause
  // (`… for field 'a'`, `… in union 'Both<T>'`), and "unknown type 'T' in 'T&S' in union
  // 'Both<T>'" reads as one clause too many.
  "unknown type '" + part + "' within '" + name + "'"
}

// The SPELLING-TREE resolver, wrapped: bank this subtree's spelling if it is the
// innermost frame that failed. `tsToName` re-renders the parser's own tree, so the part
// is quoted in the same canonical spacing the whole name is.
function tsToTy(ix: i32) {
  unkTyDepth = unkTyDepth + 1
  if unkTyDepth == 1 {
    unkTyPart = ""
    unkTyClash = ""
  }
  const r = tsToTyReal(ix)
  if r < 0 {
    if unkTyPart.length == 0 { unkTyPart = tsToName(ix) }
  }
  unkTyDepth = unkTyDepth - 1
  r
}

// The NAME resolver, wrapped the same way (the unpositioned entries and the emitter's
// re-resolutions come through here).
function nameToTy(name: string) {
  unkTyDepth = unkTyDepth + 1
  if unkTyDepth == 1 {
    unkTyPart = ""
    unkTyClash = ""
  }
  // THE BARE-NAME RUNG. A name that is a bare identifier cannot enter any composite arm
  // of `nameToTyReal`, so its answer IS the shared leaf ladder — and `tsLeafTy` is that
  // ladder, already the TREE route's leaf, so this routes to an existing home rather than
  // adding a second copy of prim/type-parameter/declared.
  //
  // MEASURED, not argued. Instrumented over `tests/cases` (1,673 files reporting) and the
  // compiler's own self-compile, running BOTH answers and comparing their renders:
  // **6,161 bare runs, 0 disagreements**, and 8 more on the self-compile, also 0. The
  // population is large because this fires at RECURSIVE entries too — a union's members,
  // an array's element, a field's type are each a bare name in the common case — so it
  // short-circuits the leaf resolutions, not only the 1,320 outermost ones the parse
  // census counts.
  //
  // Arena-neutral BY CONSTRUCTION, which is the gate the programme's own rung rule sets:
  // all three leaf rungs are LOOKUPS of an index somebody else minted, so skipping the
  // ladder above them cannot change what is minted or the order it is minted in.
  let r = -1
  if nameIsBareIdent(name) {
    r = tsLeafTy(name)
  } else {
    r = nameToTyReal(name)
  }
  if r < 0 {
    if unkTyPart.length == 0 { unkTyPart = name }
  }
  unkTyDepth = unkTyDepth - 1
  r
}

// ── the ANNOTATION union's member list, shared by BOTH annotation routes ────────────
// `tsToTyReal` (the parser TREE route) and `nameToTyReal` (the string NAME route) build
// the same union from the same members, so the two rules below have ONE home each. A
// second copy is what let the flatten below land on one route and not the other.

// The union TYPE an annotation's kept `members` denote, with the LITERAL-UNION FLATTEN.
//
// A UNION OF LITERAL UNIONS IS A LITERAL UNION: `K | K2` denotes the litunion whose
// members are `K`'s and `K2`'s LITERALS, not a union with two opaque union members.
// Without the flatten `tyIsLitUnion` sees `TyUnion` members and answers NO for the whole
// annotation, so `litUnionInlineNameOfTy` declines, BOTH renderers soften it to `string`,
// `anyLitUnionUsed` never sets `gLitUnionUsed` (which turns off every atom classifier in
// the MODULE), and `is K` const-folds to `i32.const 0` — a guard that can never fire.
// Sixteen of the twenty grid cells in `docs/internals/litunion-compact-rep-design.md`
// §8.3 are that one missing flatten, eleven of them SILENTLY wrong.
//
// THE DECLARATION ROUTE HAS ALWAYS FLATTENED — `type Q = K | K2` registers a real
// litunion alias — so this is the ANNOTATION route reaching the same arena shape, not a
// new rule. It is the same "a union of unions is one union" that `joinTys` applies
// through `flattenVariantsInto` and that canon's `unionAliasMembers` applies on the NAME
// side; the two annotation arms were the only places that had neither, and they are the
// reason a render-only fix cannot work: canon can be taught to SPELL `K | K2` as its
// flattened members, but every classifier that asks the ARENA still answers "not a
// literal union", and the two answers together are worse than either alone (measured:
// canon-only is 2 cells UP and 12 DOWN).
//
// SCOPED TO LITERAL-UNION MEMBERS, by measurement rather than by taste. A general member
// flatten is a much wider arena change (every `AB | null` over a struct / value-union
// alias) with its own population; a litunion member is the one whose REP the outer union
// must adopt, and the grid says the run-merge into a MIXED union buys ZERO cells and
// costs two (§8.3's scope ruling).
//
// A `null` SIBLING DECLINES THE FLATTEN, and that is the governing law rather than a
// gap. `K | K2 | null` flattened lands on the atom NICHE, where it becomes
// byte-for-byte its declared-alias control `C | null` — 13 RUN-OK / 5 RUN-WRONG / 2
// EMIT-REJ on both — which is 10 cells UP and 3 DOWN, and the 3 are that control's OWN
// pre-existing holes (an un-narrowed `print` of a nullable litunion is a deliberate loud
// reject; a nullable-litunion FIELD / ELEMENT read prints its raw atom id). An outcome
// class must never move down, so the niche half ships when those holes close, with the
// numbers already measured.
//
// The DEDUP is the arm's own, unchanged: `sameVariantTy` against what is already kept,
// so an overlapping pair (`"oa"|"ob" | "ob"|"oc"`) keeps `"ob"` exactly once and the
// flattened set is the UNION of the member sets — while `is K` stays a SUBSET test,
// because `emitIs`'s `laTexts` ladder compares against the TESTED type's own members.
//
// A ONE-MEMBER list is returned UNCHANGED — the degenerate `K | K` deduped to `K`'s own
// arena index long before this, and re-minting a structural twin for it would lose
// exactly the identity `nodeTyIsLitUnionAlias` compares.
function annUnionInnerTy(members: i32[], hasNull: boolean): i32 {
  if members.length == 0 { return TY_ERR }
  if members.length == 1 { return members[0] }
  // Two members the emitter cannot separate poison the annotation (-1) with the reason
  // banked — ahead of the `null` early-out, because `N | i32 | null` is the same union.
  const nwClash = nomUnionRepClashMsg(members)
  if nwClash.length > 0 {
    unkTyClash = nwClash
    return -1
  }
  if hasNull { return mkUnionTy(members) }
  // EVERY member must be a literal union. A litunion member of a MIXED union keeps its
  // own arena node, and that is the scope ruling rather than caution: flattening the RUN
  // buys ZERO grid cells (`K | K2 | f64` measures 6 RUN-OK unmerged and 5 merged — the
  // merge is what master already performs when the flattened alias happens to be
  // declared, and it costs `==` two cells) while the mixed arena SHAPE is load-bearing
  // elsewhere — `tests/cases/closures/closure-result-union-composed-carrier.vl`'s
  // `(() => K0 | boolean) | null` emits invalid wasm the moment `K0`'s literals become
  // sibling members of the closure's result union.
  let allLit = true
  let a = 0
  while a < members.length {
    if !tyIsLitUnion(members[a]) { allLit = false }
    a = a + 1
  }
  const flat: i32[] = []
  let i = 0
  while i < members.length {
    const mlits: i32[] = []
    if allLit {
      const mt = T.tys[members[i]]
      if mt is TyUnion {
        let ml = 0
        while ml < mt.uMembers.length {
          mlits.push(mt.uMembers[ml])
          ml = ml + 1
        }
      }
    }
    if mlits.length == 0 { mlits.push(members[i]) }
    let mk = 0
    while mk < mlits.length {
      let dup = false
      let dj = 0
      while dj < flat.length {
        if sameVariantTy(mlits[mk], flat[dj]) { dup = true }
        dj = dj + 1
      }
      if !dup { flat.push(mlits[mk]) }
      mk = mk + 1
    }
    i = i + 1
  }
  if flat.length == 1 { return flat[0] }
  // A DECLARED alias with exactly these literal members OWNS the arena index — see
  // `litUnionAliasTyOfMembers`. Minting a twin instead is what the index-identity
  // classifiers cannot see through, and it is asked of the NON-flattened member list
  // too: the PURE inline spelling of an aliased set (`"aa"|"bb"` beside
  // `type K = "aa"|"bb"`) reaches here with `allLit` false — its members are `TyLit`s,
  // not unions — and canon spells it `K`, so without the lookup the two producers
  // disagree exactly as they did before this slice (measured: 16 cells DOWN).
  // `litUnionAliasTyOfMembers` answers -1 for any member that is not a string literal,
  // so a mixed list (`K0 | boolean` flattened or not) never reaches an alias here.
  const lal = litUnionAliasTyOfMembers(flat)
  if lal >= 0 { return lal }
  mkUnionTy(flat)
}

// The WHOLE union type an `A | B | null` spelling denotes: `annUnionInnerTy` over the
// non-`null` members, wrapped in the NICHE when a `null` member was present. -1 (a
// poisoned annotation) propagates unwrapped — `mkNullableTy(-1)` would mint a nullable
// over the sentinel and lose the failure.
//
// THE HOME OF THE `null` WRAP, read by both annotation routes (`tsToTyReal`'s `TS_UNION`
// arm and `nameToTyReal`'s pipe arm), which had this pair of lines each. The DECLARATION
// route (`checkProgram` pass 0b's `UnionDecl` arm) reproduces the rule through these two
// halves rather than through this whole, because its wrap is GATED on the inner — see the
// niche fold there for why, and for the six cells that say so.
//
// The declaration route had NEITHER line: it pushed every resolved variant into the
// alias's member list, `null` among them. So `type T = string | null` interned as the
// two-member union `TyUnion[string, null]` while the inline annotation `string | null`
// interned as `TyNullable(string)`, and the PARENTHESIZED declaration
// `type T = (string | null)` — one variant, resolved through the annotation route — got
// the niche. Naming the type removed the niche, and with it every consumer keyed on it:
// the `!= null` narrow (`nonNullTy` peels a `TyNullable`, not a `null` SIBLING), the
// emitter's niche lowering against the union ROW the two-member arity minted
// (`cVariantMemberTyIxs`, `collectU`), and the transparency predicate
// (`singleAliasMemberTyIx` reads a ONE-member wrapper).
function annUnionTy(members: i32[], hasNull: boolean): i32 {
  const inner = annUnionInnerTy(members, hasNull)
  if inner < 0 { return -1 }
  if hasNull { return mkNullableTy(inner) }
  inner
}

function tsToTyReal(ix: i32) {
  if ix < 0 { return -1 }
  const k = tsKind[ix]
  const start = tsKidStart[ix]
  const cnt = tsKidCount[ix]
  // An inline UNION `A | B | null`. A `null` member makes the result NULLABLE;
  // duplicate members COLLAPSE (host `flattenType` dedup); an UNRESOLVED member
  // poisons the whole union (-1), because `assignable` treats a negative side as
  // "accept anything" and `Bogus | i32` must not silently accept everything.
  if k == TS_UNION {
    const members: i32[] = []
    let hasNull = false
    let pi = 0
    while pi < cnt {
      const kid = tsKids[start + pi]
      const kk = tsKind[kid]
      if kk == TS_NULL {
        hasNull = true
      } else if kk != TS_ERR {
        // renders "" — the string arm's `part.length > 0`
        const m = tsToTy(kid)
        if m < 0 { return -1 }
        let dup = false
        let dj = 0
        while dj < members.length {
          if sameVariantTy(m, members[dj]) { dup = true }
          dj = dj + 1
        }
        if !dup { members.push(m) }
      }
      pi = pi + 1
    }
    return annUnionTy(members, hasNull)
  }
  // An INTERSECTION `A & B` (A3) — fold the operands through `intersectTy` so a
  // finite annotation simplifies to a concrete type (`(0|1|2) & !2` → `0 | 1`).
  if k == TS_ISECT {
    let acc = -1
    let ii = 0
    while ii < cnt {
      const operand = tsToTy(tsKids[start + ii])
      if operand < 0 { return -1 }
      if ii == 0 { acc = operand } else { acc = intersectTy(acc, operand) }
      ii = ii + 1
    }
    return acc
  }
  // A prefix NEGATION `!A` (A4): "anything but A".
  if k == TS_NEG {
    const negd = tsToTy(tsKids[start])
    if negd < 0 { return -1 }
    return mkNegTy(negd)
  }
  // A parenthesized GROUP `(A)`. The string arm strips the parens and re-enters,
  // so a COMMA group `(A, B)` re-enters on `"A,B"` — which matches no arm and
  // resolves to -1. A group is a single type or it is nothing.
  if k == TS_PAREN {
    if cnt == 1 { return tsToTy(tsKids[start]) }
    return -1
  }
  // A FUNCTION TYPE `(params)=>ret` — the kids are the parameters in order and
  // then the RETURN last (`parseTypeAtom`'s contract).
  if k == TS_FUNC {
    const ptys: i32[] = []
    let pn = cnt - 1
    // A lone recovery param renders `""`, so the string arm sees `paramsStr`
    // empty and builds a ZERO-parameter function. Two of them render `","` and
    // do NOT collapse, so the skip is exact only at count 1.
    if pn == 1 {
      if tsKind[tsKids[start]] == TS_ERR { pn = 0 }
    }
    let pk = 0
    while pk < pn {
      const pt = tsToTy(tsKids[start + pk])
      if pt < 0 { return -1 }
      ptys.push(pt)
      pk = pk + 1
    }
    const rty = tsToTy(tsKids[start + cnt - 1])
    if rty < 0 { return -1 }
    return mkFuncTy(ptys, rty)
  }
  // A STRING-LITERAL type `"a"` — `tsText` keeps the QUOTED lexeme (that is what
  // makes `tsToName` reproduce the annotation exactly), and the member is the RAW
  // inner text, as on the literal-expression side.
  // The GROUP-INTERIOR cut at its home (`tyname.groupInnerOf`, W1), and THE OPERAND IS
  // A TYPE NAME, not a lexeme: `ast.tsToName` returns `tsText[ix]` VERBATIM for a
  // `TS_LITSTR` node, and the parser stores the very string it also concatenates into
  // `TypeRef.tyName` — so this is `litMemberTy`'s quoted-member peel reached through
  // the spelling tree instead of through the rendered name, character for character.
  if k == TS_LITSTR {
    const lex = tsText[ix]
    return mkLitTy("str", groupInnerOf(lex))
  }
  // A NUMERIC-LITERAL type (`0`, `1.5`): int vs float by the `.` in the LEXEME.
  if k == TS_LITNUM {
    if hasDot(tsText[ix]) { return mkLitTy("flt", tsText[ix]) }
    return mkLitTy("int", tsText[ix])
  }
  if k == TS_NULL { return TY_NULL }
  // An array type `T[]`. An UNRESOLVED element poisons the annotation: building
  // `mkArrayTy(-1)` would leak the empty-`[]` ELEMENT HOLE as the type of every
  // `xs[i]` read, and a member access on that hole indexes the arena at -1 — a
  // checker CRASH (`generics/type-alias-nested.vl`).
  if k == TS_ARR {
    const aeTy = tsToTy(tsKids[start])
    if aeTy < 0 { return -1 }
    return mkArrayTy(aeTy)
  }
  // A MAP `{[K]: V}`. The key is a bare identifier TOKEN, not a parsed type, so it
  // rides `tsText`; `string` and `i32` keys are supported (`mapKeyTySupported` — the
  // two the map rep hashes), and any other key resolves to -1 for "unknown type".
  // An UNRESOLVED VALUE poisons the annotation, like the array/union arms: a
  // `mkMapTy(str, -1)` here would be indistinguishable from the empty-`Map()`
  // INFERENCE hole, so the checker would accept `{[string]: nope}` in silence
  // and the emitter would lower a value slot it has no type for.
  if k == TS_MAP {
    const mk = tsLeafTy(tsText[ix])
    if !mapKeyTySupported(mk) { return -1 }
    const mvTy = tsToTy(tsKids[start])
    if mvTy < 0 { return -1 }
    return mkMapTy(mk, mvTy, 0)
  }
  // An INLINE OBJECT type `{x: T, y: U}`. A field whose NAME failed to parse
  // renders `":T"`, whose first top-level colon is at index 0 — the string arm's
  // `colonAt > 0` drops it, so an empty field name drops here too.
  // An UNRESOLVED FIELD TYPE poisons the annotation (-1, "unknown type
  // '{bar: nope}'") for the same reason the array arm poisons its element:
  // storing the -1 sentinel in `objFieldTypes` leaks it to every consumer that
  // indexes `T.tys` by a field type — a checker CRASH at the ones that assume
  // resolution succeeded (`unionArmSeedSafe`).
  if k == TS_OBJ {
    const fnames: string[] = []
    const ftys: i32[] = []
    let fi = 0
    while fi < cnt {
      const fdIx = tsKids[start + fi]
      if tsKind[fdIx] == TS_FIELD {
        if tsText[fdIx].length > 0 {
          const fdTy = tsToTy(tsKids[tsKidStart[fdIx]])
          if fdTy < 0 { return -1 }
          fnames.push(tsText[fdIx])
          ftys.push(fdTy)
        }
      }
      fi = fi + 1
    }
    return mkObjTy(fnames, ftys)
  }
  // A generic alias APPLICATION `Box<i32>` / `Pair<i32,string>` — substitute the
  // arguments into the declared body (A10 stage 3). The head is the identifier
  // the parser read, never a slice of a rendered name.
  if k == TS_APP { return applyGenAliasArgs(tsText[ix], "", ix) }
  // `TS_NAME` (a bare identifier), and `TS_ERR`, whose `""` text falls through
  // every leaf rung to -1 exactly as `nameToTy("")` does.
  tsLeafTy(tsText[ix])
}

function nameToTyReal(name: string) {
  // An inline UNION `A | B | null` — the parser joins the members with `|` into one
  // synthetic name. Split on TOP-LEVEL `|`s (depth-aware), resolve each member, and
  // build the union (a `null` member makes it NULLABLE). Checked FIRST so a member's
  // `[]`/map shape isn't read as a suffix of the whole union name. Duplicate
  // members COLLAPSE (host `flattenType` dedup: `"a" | "a" | "b"` is `"a" | "b"`).
  if nameHasPipe(name) && !isTopLevelFuncTypeName(name) {
    const parts: string[] = []
    tyTopLevelSplit(name, '|', false, parts)
    const members: i32[] = []
    let hasNull = false
    let pi = 0
    while pi < parts.length {
      const part = parts[pi]
      if part == "null" {
        hasNull = true
      } else if part.length > 0 {
        // An UNRESOLVED member poisons the whole union (-1, "unknown type") —
        // like the array-suffix arm below. Pushing the -1 would leak the
        // sentinel into the member list, and `assignable` treats a negative
        // side as "accept anything", so `Bogus | i32` would silently accept
        // every source.
        const m = nameToTy(part)
        if m < 0 { return -1 }
        let dup = false
        let dj = 0
        while dj < members.length {
          if sameVariantTy(m, members[dj]) { dup = true }
          dj = dj + 1
        }
        if !dup { members.push(m) }
      }
      pi = pi + 1
    }
    // The litunion FLATTEN and the `null` NICHE wrap at their shared home — the TREE
    // route's mirror (`tsToTyReal`'s `TS_UNION` arm). Three routes, one rule.
    return annUnionTy(members, hasNull)
  }
  // An INTERSECTION `A & B` (A3) — fold the operands through `intersectTy` so a
  // finite annotation simplifies to a concrete type (`(0|1|2) & !2` → `0 | 1`).
  // An unresolvable operand poisons the whole name (-1, "unknown type").
  if nameHasSep(name, '&') && !isTopLevelFuncTypeName(name) {
    const iparts: string[] = []
    tyTopLevelSplit(name, '&', false, iparts)
    let acc = -1
    let ii = 0
    while ii < iparts.length {
      const operand = nameToTy(iparts[ii])
      if operand < 0 { return -1 }
      if ii == 0 { acc = operand } else { acc = intersectTy(acc, operand) }
      ii = ii + 1
    }
    return acc
  }
  if name.length > 0 {
    // A prefix NEGATION `!A` (A4): "anything but A" — almost always consumed by
    // the `&` fold above (`A & !B` subtracts B's variants from A).
    if name[0] == '!' {
      const negd = nameToTy(name.slice(1, name.length))
      if negd < 0 { return -1 }
      return mkNegTy(negd)
    }
    // A PARENTHESIZED group `(A | B)` — strip when the leading `(` closes only at
    // the final character. That question is `tyname.parenEnclosesWhole`, and the call
    // reaches the PREDICATE's home rather than the LADDER's: `tyGroupEndIndex` is
    // shared by two comparisons that disagree on a group which never closes, so a site
    // that spells its own comparison is choosing between them silently. The peel needs
    // the FALSE reading — a group whose closer does not exist has no final character to
    // give up, and `groupInnerOf` would take a real one (`(abc` → `ab`) — which is what
    // `parenEnclosesWhole` returns and what `emit_base.tyGroupWrapsWhole` (never-closes
    // ⇒ TRUE, "nothing closed it early", consumed only by SPAN tests) does not.
    // The endpoint test is the PAREN grammar's SPAN half at its home; the walk stays a
    // separate conjunct exactly as `peelGroupParens` keeps it, because the recursion
    // below is `nameToTy` and not a plain slice. The CUT that pairs with the test is
    // `tyname.groupInnerOf` (W1) — the SPAN + WALK pair above is this site's guard, a
    // fourth shape again among the family's call sites, which is why the home carries
    // none of them.
    if nameIsParenSpanEnds(name) {
      if parenEnclosesWhole(name) { return nameToTy(groupInnerOf(name)) }
    }
    // A FUNCTION TYPE `(params)=>ret` (the parser's synthetic name for `(i32) => i32`):
    // the leading `(...)` is the param list, then `=>`, then the return atom. Build a
    // `TyFunc` so a function-typed binding/param/field type-checks (call arity + types).
    // THE WHOLE PREDICATE, at the home 700 lines above (D-ALIASREF). This was
    // `arrowAt >= 1 && nameIsParenOpen(name) && name[arrowAt - 1] == ')'` — an
    // arrow scan, a routed OPEN half and an inline ARROW-relative CLOSE, which is
    // `isTopLevelFuncTypeName`'s body character for character, in the same order,
    // with the same short-circuits. The census that reached this site through the
    // `')'` character classified it as the ARROW-relative close family and declined
    // it beside `emit_base.annFnDecompose`; it is not a grammar site wanting a
    // paren home at all, it is a COMPLETE home written out twice in one file — the
    // duplication rule's clearest case, and the reason to look at the whole
    // conjunction rather than at the character the census matched.
    //
    // `funcArrowAt` is the predicate's own bank (D-ARROWBANK), read IMMEDIATELY:
    // the recursion below is `nameToTy`, which reaches `isTopLevelFuncTypeName`
    // again and overwrites it. One `topLevelArrowIndex` walk still runs, exactly as
    // before — it moved inside the predicate.
    //
    // Both CUTS are `tyname.fnParamsTextOf` / `fnRetTextOf` (W4), given the banked index.
    // The FINDER cannot follow them down — it writes that bank — so the cut takes the
    // index as an argument and the predicate stays here. The census listed neither of
    // these two writings.
    if isTopLevelFuncTypeName(name) {
      const arrowAt = funcArrowAt
      const paramsStr = fnParamsTextOf(name, arrowAt)
      const retStr = fnRetTextOf(name, arrowAt)
      const ptys: i32[] = []
      if paramsStr.length > 0 {
        const pparts: string[] = []
        tyTopLevelSplit(paramsStr, ',', false, pparts)
        let pk = 0
        while pk < pparts.length {
          const pt = nameToTy(pparts[pk])
          if pt < 0 { return -1 }
          ptys.push(pt)
          pk = pk + 1
        }
      }
      const rty = nameToTy(retStr)
      if rty < 0 { return -1 }
      return mkFuncTy(ptys, rty)
    }
    // A STRING- or NUMERIC-LITERAL type (`"a"`, `0`, `1.5`), at the lexeme grammar's
    // home — shared with `canonEmitName`'s literal arm, which used to spell it out again.
    const lmt = litMemberTy(name)
    if lmt >= 0 { return lmt }
  }
  const pv = primTyOfName(name)
  if pv >= 0 { return pv }
  // An array type `T[]`: the parser appends a literal `[]` per array suffix to the
  // type NAME (`i32[]`, `Tok[]`, `i32[][]`). Strip one suffix and wrap the element.
  const nlen = name.length
  // The ARRAY-NAME grammar's TEST half then its CUT half, both at their home in `tyname.vl`. The
  // `nlen >= 2` bound the hand-written form carried lives inside `nameIsArray`. The two
  // calls are the FAITHFUL form, not `arrElemNameRaw(name) != ""`: the degenerate `"[]"`
  // is an array name whose element is "", and this arm must still enter for it (master
  // resolved `nameToTy("")`) — collapsing to the one-call form would skip the arm.
  if nameIsArray(name) {
    // An UNRESOLVED element name poisons the whole array annotation (-1,
    // "unknown type 'Bad[]'"). Building `mkArrayTy(-1)` here instead would
    // leak the `-1` ELEMENT HOLE (the empty-`[]` sentinel) as the type of
    // every `xs[i]` read — and a member access on that hole indexes the
    // type arena at -1, a checker CRASH (generics/type-alias-nested.vl).
    const aeTy = nameToTy(arrElemNameRaw(name))
    if aeTy < 0 { return -1 }
    return mkArrayTy(aeTy)
  }
  // A MAP `{[K]:V}` (the parser's synthetic index-signature name) —
  // the MAP-NAME grammar's SPAN and its two CUTS, each at its home in `tyname.vl`. The
  // supported keys are `string` and `i32` (`mapKeyTySupported`); any other key resolves
  // to -1 so the caller reports "unknown type". An UNRESOLVED VALUE poisons the
  // annotation too — the `mkMapTy(str, -1)` it would otherwise build is the
  // empty-`Map()` INFERENCE hole, which every consumer reads as "not yet known"
  // rather than "no such type".
  //
  // The `nlen >= 5` bound this arm carried is implied by the two gates (see
  // `mapSpellKeyEnd`), and the key-end test is what the arm's own `]:` scan was:
  // when it finds nothing the arm falls through to the inline-object arm below,
  // exactly as the un-taken `while` did.
  if nameIsMapSpanEnds(name) && mapSpellKeyEnd(name) >= 0 {
    const mk = nameToTy(mapSpellKeyName(name))
    if !mapKeyTySupported(mk) { return -1 }
    const mv = nameToTy(mapSpellValName(name))
    if mv < 0 { return -1 }
    return mkMapTy(mk, mv, 0)
  }
  // An INLINE OBJECT type `{x:T,y:U}` (the parser's synthetic anonymous-struct
  // name — starts `{` but not `{[`). Split the TOP-LEVEL commas (depth-aware: a
  // field's own map/object/array commas don't split), then each field at its first
  // top-level `:`, and build the structural TyObj. An UNRESOLVED FIELD TYPE
  // poisons the annotation, like the array arm's element: the -1 sentinel stored
  // in `objFieldTypes` is read back by every consumer that indexes `T.tys` by a
  // field type, and the ones that assume resolution succeeded CRASH on it.
  //
  // The WIDE brace-endpoint span at its home in `tyname.vl` (`nameIsBraceSpanEnds`): the `nlen >= 2`
  // bound this arm hoisted to an enclosing block IS that home's own first line, so the two
  // nested `if`s collapse into one call. The WIDTH is what this arm needs and the reason it
  // is not `nameIsShapeOpen`: a map name also opens `{` and ends `}`, and reaches here only
  // when the map arm ABOVE has already declined it (a non-string key, or a key that never
  // closes) — at which point falling into the field split is exactly master's behaviour.
  if nameIsBraceSpanEnds(name) {
    const fnames: string[] = []
    const ftys: i32[] = []
    // The fields are the top-level commas of the brace's INTERIOR — scanned from
    // index 1, so the opening `{` is not counted and the field commas sit at depth
    // 0; the run ends at the closing brace rather than at the end of the name.
    let fstart = 1
    let fgoing = true
    while fgoing {
      let fend = tyTopIndexOf(name, ',', 0, fstart)
      if fend < 0 {
        fend = nlen - 1
        fgoing = false
      }
      const field = name.slice(fstart, fend)
      if field.length > 0 {
        const colonAt = tyTopIndexOf(field, ':', 0, 0)
        if colonAt > 0 {
          // Both halves of the FIELD-COLON cut at their home (`tyname.fieldTypeTextOf` /
          // `fieldNameOf`, W14), given the TOP-LEVEL colon this arm just found. The three
          // emitter copies find their colon with a depth-BLIND `indexOf(":")` over an
          // already-flattened name; the finder is deliberately not folded into the cut.
          const fdTy = nameToTy(fieldTypeTextOf(field, colonAt))
          if fdTy < 0 { return -1 }
          fnames.push(fieldNameOf(field, colonAt))
          ftys.push(fdTy)
        }
      }
      fstart = fend + 1
    }
    return mkObjTy(fnames, ftys)
  }
  // A live type-parameter BINDING (a generic function's `<T>` while its
  // annotations resolve via `resolveAnnot`, or a generic alias application's
  // params while its body resolves via `applyGenAlias`) — innermost wins.
  const tv = tpEnvTyOfName(name)
  if tv >= 0 { return tv }
  // A generic alias APPLICATION `Box<i32>` / `Pair<i32,string>` — the parser
  // folds the arguments into the synthetic name; substitute them into the
  // declared body (A10 stage 3).
  //
  // The GENERIC-APPLICATION SPAN at its home in `tyname.vl` (`annGenAppSpanEnds`) — the `nlen >= 3`
  // cheap reject, the trailing-`>` compare and the `lt > 0` scan, in that order, which is the
  // order this arm's three nested `if`s already ran them in. A name failing ANY of the three
  // fell through to `declaredTyOfName` before and still does; the arm's hand-rolled
  // first-`<` loop is `gaeLtAt`, re-asked here for the two slices — which are themselves
  // `tyname.gaeHeadNameOf` / `gaeArgsTextOf` (W2), taking that index rather than a third
  // scan. The ARGUMENT cut spelled its endpoint against the HOISTED length `nlen`, the
  // second of the two writings whose length expression the census had not normalised.
  if annGenAppSpanEnds(name) {
    const ltAt = gaeLtAt(name)
    return applyGenAlias(gaeHeadNameOf(name, ltAt), gaeArgsTextOf(name, ltAt))
  }
  declaredTyOfName(name)
}

// The collection FLAVOR of a binding initializer: "Set" when the init is a
// `Set()` call, else "Map" (a `Map()` call or any other shape). Lets the
// i32-keyed diagnostic name the right constructor (`Map`/`Set`).
function initMapCtorName(initIx: i32) {
  if initIx < 0 { return "Map" }
  const inode = P.nodes[initIx]
  if inode is Call {
    const cn = P.nodes[inode.callFn]
    if cn is Ident {
      if cn.identName == "Set" { return "Set" }
    }
  }
  return "Map"
}

// THE ONE WORDING for a key the map rep cannot hash — the rep has exactly two hashes
// (`mapKeyTySupported`). Both the ANNOTATION gate (`checkLetDeclNode`, which names the
// key by its SPELLING) and the USAGE-DRIVEN pin (`checkInferredMapKey`, which names it
// by the type the first write inferred) raise it, so the two spellings of one program
// reject in the SAME channel with the SAME words.
function mapKeyUnsupportedErr(keyText: string, ctor: string, at: i32) {
  tErrUnsupported(
    "A " +
      keyText +
      "-keyed " +
      ctor +
      " isn't supported yet — `Map`/`Set` keys must be `string` or `i32`",
    at,
  )
}

// Adjudicate the key a USAGE-DRIVEN pin (`m.set(k, v)`, `s.add(k)`, `m[k] = v`) just
// wrote into an open `mKey` hole. A bare `Map()` has no annotation for the gate above
// to read, so WITHOUT this the annotated `{[f64]: V}` is a clean type error while its
// inferred twin checks clean and dies in codegen as `emitProgram: map key is not a
// string` — the same program refused in two channels, one of them past `vl check`.
// A HOLE key (an un-annotated parameter reaching `m.set(k, v)`) is not adjudicated
// here: it is still unsolved, and the call-site re-validation owns it. An error key is
// a cascade and stays silent.
function checkInferredMapKey(k: i32, isSet: i32, at: i32) {
  if k < 0 { return 0 }
  if mapKeyTySupported(k) { return 0 }
  const kt = T.tys[k]
  if kt is TyVar { return 0 }
  if kt is TyErr { return 0 }
  let ctor = "Map"
  if isSet == 1 { ctor = "Set" }
  mapKeyUnsupportedErr(tyToStr(k), ctor, at)
  0
}

// ── type → string (for diagnostics) ──────────────────────────────────────────
// Renders a type-arena index as a readable type name. Recurses through the arena
// for object/function/union/nullable. Narrows the `Ty` union only — never `Node`.
//
// ONE MODE BIT, TWO ENTRIES, ONE RECURSION. `nominal` — may a type that HAS a declared
// name render as that name? Yes for every surface a person reads (a declared struct is
// `Cat`, an application is `Box<i32>`, a declared union alias is `U`); no for the
// checker's emitter-facing NAME PRODUCERS, whose strings are table keys the emitter
// holds under the STRUCTURAL spelling.
//
// EVERY COMPOSITE IS SPELLED THE WAY VL SOURCE SPELLS IT — `=>` and never `->`,
// `T | null` and never `T?`, `(A | B)[]` and never the differently-typed `A | B[]` — on
// BOTH entries, with no mode bit to turn it off. A render a person cannot write is a
// render that lies, and the STRUCTURAL entry needs the same discipline for the sharper
// reason that its consumers PARSE what it hands them: they match a `{…}` shape by field
// set, re-form an `<elem>[]` annotation out of it, and classify its parts. A spelling
// only this renderer emits is a second type language, and every classifier reading the
// column then has to know which of the two it is holding — which is the mistake this
// file exists to stop making.
export function tyToStr(ix: i32) { tyToStrAt(ix, true) }

// The STRUCTURAL render — `tyToStr`'s recursion with the nominal legs off. Read by the
// checker's emitter-facing name producers (`nodeArrayElemName`, `nodeTyName`, the
// inferred-return recorders, the resolved-list name a hole's shape is pinned under),
// whose result is looked up in an emitter table keyed by a STRUCTURAL spelling
// (`structIndexOfTypeName` matches a `{…}` shape by field set). A nominal name there is
// a key those tables do not hold.
//
// THE PRICE OF GETTING THIS SPLIT WRONG IS MEASURED, AND IT IS SMALL AND LOUD RATHER
// THAN WIDE: with these nine sites moved onto the nominal entry, 1,608 of the 1,609
// emitted corpus modules are still byte-identical and exactly ONE file loud-rejects —
// `arrays/map-collapse-to-variant.vl`, `emitProgram: field access but no struct type
// declared`, because an un-annotated `.map` callback's synthesized param annotation is
// resolved by `synthParamAnnots` through `structIndexOfTypeName`, which has no route
// from `Cat` back to the interned inline shape. A near-inert wrong answer with one
// witness is exactly the shape that survives a suite and dies in a user's program, so
// the split is stated here rather than left to the one corpus file that notices.
//
// IT IS ALSO THE ALIAS-BODY RENDER a person hovers for — an answer about `Pt` that says
// `Pt` is no answer, so the hover wants the BODY, structurally, in a spelling it could
// have been written in. Same question, same entry.
//
// EXACTLY ONE OF THE NINE CALL SITES IS SPELLING-SENSITIVE, and it is
// `nodeArrayElemName`'s struct-shape element. Its readers classify the element as a
// closure CELL, and they must ask that of the element's own top level
// (`nameIsClosureElem`) — a `=>`-anywhere test reads a closure FIELD as a closure
// ELEMENT and types the cell `(ref $cloStruct)` for a struct: invalid wasm. That is the
// standing invariant on this entry's output; a classifier that keys on a spelling only
// this renderer emits is holding the wrong evidence. Under it the corpus is
// byte-identical with this entry source-spelled: 1,990 of 1,990 emitted modules.
export function tyToStructStr(ix: i32) { tyToStrAt(ix, false) }

function tyToStrAt(ix: i32, nominal: boolean) {
  // Both bail-outs below are single tokens — one atom, like every arm that does not
  // write a top-level `|`.
  tyStrAtoms = 1
  // NO ARENA ENTRY (`ix < 0`) — an empty `[]` whose element nothing constrained, an
  // empty `Map()`/`Set()` whose key or value nothing constrained. The USER-FACING
  // question these answer is the SAME one the `TyVar` hole arm answers ("no type was
  // determined here; say what it is"), so they answer it in the SAME token: `_`. The
  // arena distinction — an unsolved entry vs no entry at all — is the checker's
  // bookkeeping and buys a reader nothing; two blanks for one sentence just made the
  // second one look like a different, internal condition.
  //
  // ANGLE BRACKETS ARE THE VOCABULARY OF AN ERROR THAT ALREADY HAPPENED, and after
  // this only `<error>` (`TyErr`) and the unreachable `<?>` wear them. That split is
  // the contract `soundness/absence-markers-render-reject.vl` pins: `_` says the
  // checker never learned the type, `<error>` says the reader's own annotation was
  // rejected above — collapsing them would send a reader who has an `unknown type`
  // error to look for a missing annotation instead.
  if ix < 0 { return "_" }
  if tyToStrDepth > 8 { return "…" }
  tyToStrDepth = tyToStrDepth + 1
  const s = tyToStrGo(ix, nominal)
  tyToStrDepth = tyToStrDepth - 1
  s
}

function tyToStrGo(ix: i32, nominal: boolean) {
  // A NOMINAL NEWTYPE renders as its NAME. This is the only renderer that must —
  // a diagnostic reading "cannot assign i32 to i32" for `const e: EntityId = n`
  // names the distinction the type exists to draw and then hides it. The EMIT
  // renderers (`tyToEmitName`, `canonEmitName`) deliberately do NOT get this arm:
  // their output is the emitter's vocabulary and a newtype must be erased there
  // (`docs/internals/newtype-design.md` §3).
  const nwn = nomNameOfTy(ix)
  if nwn != "" { return nwn }
  // NOMINAL-FIRST, the same three legs and the same ORDER `tyToNominalNameGo` and
  // `transparentMemberEmitName` ask them in — declared struct, generic application,
  // declared union alias. An application has to precede the union leg for the reason
  // it does there: it expands to a `TyObj`/`TyUnion` whose structural render is exactly
  // the expansion the nominal answer exists to replace. Each leg declines with "" for a
  // type it does not name (an anonymous shape, an uninstantiated or cyclic application),
  // so every type with no source spelling still renders structurally.
  //
  // NO `numLitUnionBaseName` SOFTEN HERE, and that is the one place display and the
  // emit-name renderer legitimately part. That soften exists because `Z` is not a name
  // the EMITTER can classify (`type Z = 0 | 1` lowers as its base scalar); a reader's
  // question is what the source calls the type, and `Z` is both the answer and a
  // spelling that parses back to the same type.
  if nominal {
    const sdn = structNameOfTy(ix)
    if sdn != "" { return sdn }
    const gan = genAppNameOfTy(ix)
    if gan != "" { return gan }
    const udn = unionAliasDeclNameOfTy(ix)
    if udn != "" { return udn }
  }
  const t = T.tys[ix]
  // EXHAUSTIVE over `Ty` and deliberately `_`-less: the checker's match
  // exhaustiveness names any arena variant this renderer stops answering for, so a
  // 12th variant breaks the self-compile here instead of printing `<?>` in a
  // diagnostic — a valid-looking string that says nothing about the type.
  match t {
    TyPrim => {
      return t.primName
    }
    TyErr => {
      return "<error>"
    }
    TyObj => {
      // GAP: `.length`/index chained directly on an array field of an `is`-narrowed
      // value miscompiles, so the array fields are bound to locals first (PR #3).
      const names = t.objFieldNames
      const ftys = t.objFieldTypes
      let s = "{"
      let i = 0
      while i < names.length {
        if i > 0 { s = s + ", " }
        s = s + names[i] + ": " + tyToStrAt(ftys[i], nominal)
        i = i + 1
      }
      // Every field separator sits inside the braces — ONE atom. Set rather than
      // inherited: the field renders above left the last field's width behind.
      tyStrAtoms = 1
      return s + "}"
    }
    TyFunc => {
      const ptys = t.fnParamTypes
      let s = "("
      let i = 0
      while i < ptys.length {
        if i > 0 { s = s + ", " }
        s = s + tyToStrAt(ptys[i], nominal)
        i = i + 1
      }
      let rs = tyToStrAt(t.fnRet, nominal)
      // A function type is ONE atom: the params are parenthesized and everything after
      // the top-level arrow belongs to the RESULT. Set rather than inherited — the
      // param/result renders above left their own widths behind.
      tyStrAtoms = 1
      // VL writes a function type `(params) => ret`.
      //
      // A FUNCTION RESULT that is itself a function keeps grouping parens — the
      // TyFunc-result leg of the same rule `arrElemRender` carries for elements, and the
      // arm both emit renderers already hold.
      if tyIxIsFunc(t.fnRet) { rs = "(" + rs + ")" }
      return s + ") => " + rs
    }
    TyUnion => {
      const members = t.uMembers
      let s = ""
      // The render's atom count, accumulated as the members are joined: the join writes
      // exactly one top-level `|` per member boundary, so the whole render is as wide as
      // its members together. A member is not always ONE atom (a nullable member renders
      // `X | null`), which is why this is summed rather than read off `members.length`.
      let psum = 0
      let i = 0
      while i < members.length {
        if i > 0 { s = s + " | " }
        let ms = tyToStrAt(members[i], nominal)
        let mw = tyStrAtoms
        // A FUNCTION-TYPE member renders PARENTHESIZED (`((i32) => f64) | string`). Bare,
        // the closure's result swallows the union's sibling members — `(i32) => f64 |
        // string` is a function RETURNING `f64 | string`, a different type. The grouping
        // parens put every separator inside a grouper — one atom again.
        if tyIxIsFunc(members[i]) {
          ms = "(" + ms + ")"
          mw = 1
        }
        s = s + ms
        psum = psum + mw
        i = i + 1
      }
      tyStrAtoms = psum
      return s
    }
    TyNullable => {
      const inner = tyToStrAt(t.nInner, nominal)
      const innerAtoms = tyStrAtoms
      // VL has no `T?` suffix — a nullable is written `T | null`.
      //
      // A NULLABLE FUNCTION type keeps grouping parens (`((i32) => string) | null`) —
      // bare, the ` | null` binds into the closure's RESULT and the render spells a
      // function returning `string | null` instead.
      if tyIxIsFunc(t.nInner) {
        // The grouped closure is one atom; `null` is the second.
        tyStrAtoms = 2
        return "(" + inner + ") | null"
      }
      // A union INNER keeps its own top-level `|`s (`A | B | null`), so the `null` arm
      // ADDS to the inner render's width rather than making the whole render two atoms.
      tyStrAtoms = innerAtoms + 1
      return inner + " | null"
    }
    TyArray => {
      const el = tyToStrAt(t.aElem, nominal)
      const elw = tyStrAtoms
      // A list render is ONE atom in every form — a wide element is parenthesized
      // precisely so its `|`s stop being top-level. Set rather than inherited: the
      // element render left the ELEMENT's width behind.
      tyStrAtoms = 1
      return arrElemRender(el, t.aElem, elw)
    }
    TyMap => {
      const mk = tyToStrAt(t.mKey, nominal)
      const mv = tyToStrAt(t.mVal, nominal)
      // The key/value separators sit inside the braces — one atom.
      tyStrAtoms = 1
      return "{[" + mk + "]: " + mv + "}"
    }
    TyVar => {
      // An inference hole (`?fn.N`) — an un-annotated, still-polymorphic param — is
      // an internal name, so render it as the BLANK `_`. Deliberately not an
      // identifier-shaped word: VL has no dynamic top type
      // (`docs/guide/soundness.md`), and every bareword spelling reads as a type
      // NAME the reader will then try to write. `_` reads as an unfilled slot, which
      // is what a hole is. It is the renderer's ONE blank: `tyToStrAt`'s absent-arena
      // bail-out writes the same `_`, because "un-annotated param" and "element of an
      // empty `[]`" are one sentence to a reader. The remaining non-name tokens all
      // mean something else — `<error>` (`TyErr`, an annotation the reader wrote and
      // the checker rejected), `<?>` (the unreachable tail), `…` (depth cap).
      // `_` must never be added to the LSP's absence filter (`ABSENT_TYPE_MARKERS` in
      // lsp/src/typeFeatures.ts): a blank-bearing type is informative and shows — and
      // as a bare underscore it is a SUBSTRING of ordinary identifiers, so a sentinel
      // list that matched it would delete hints from healthy code (`{foo_bar: i32}`).
      // A declared type param (`T`) carries a real source name and keeps it.
      if t.tvName[0] == '?' { return "_" }
      return t.tvName
    }
    TyLit => {
      // A literal type renders as its member text — quoted for a string literal
      // (host `stringifyType`: `expected "a" | "b", got "c"`).
      if t.litKind == "str" { return "\"" + t.litText + "\"" }
      return t.litText
    }
    TyNeg => {
      const ns = tyToStrAt(t.negTy, nominal)
      // A RESIDUAL negation has no source spelling at all, so its width is nominal:
      // one atom, like every other non-`|`-writing arm.
      tyStrAtoms = 1
      return "!" + ns
    }
  }
  // UNREACHABLE by construction: every arena variant has an arm above and every
  // arm returns. It stays as the function's trailing value, and it is the token a
  // 12th variant would print if the `match` were ever given a `_`.
  "<?>"
}

// ── structural "renders as this PRIMITIVE" ───────────────────────────────────
// The primitive name arena type `ix` RENDERS as (`tyToStr`), or "" when it renders
// as anything else. `tyEq`'s discipline applied to the one-primitive case: the
// answer is read off the arena, never off a built string. Differs from `primNameOf`
// only in unwrapping a SINGLE-member union — `tyToStr`'s union arm joins members
// with " | ", so a one-member union prints as its member bare (`mkUnionTy` does not
// collapse, so such an entry is constructible) and the render-comparing sites this
// replaces did accept it. The returned name is `TyPrim.primName`, the primitive's
// own IDENTITY — the same thing `tyEq` compares — not a rendering of a structure.
function tyPrimNameOf(ix: i32): PrimName | null {
  if ix < 0 { return null }
  const t = T.tys[ix]
  if t is TyPrim { return t.primName }
  if t is TyUnion {
    if t.uMembers.length == 1 { return tyPrimNameOf(t.uMembers[0]) }
  }
  null
}

// Whether arena type `ix` IS the primitive `nm` — the decision form of
// `tyPrimNameOf`, replacing `tyToStr(ix) == "i32"` at the sites that were asking a
// STRUCTURAL question ("is the inner the string primitive?") by rendering.
function tyIsPrimNamed(ix: i32, nm: PrimName): boolean {
  tyPrimNameOf(ix) == nm
}

// ── the ELEMENT row of an array type, with the empty-`[]` hole answered ONCE ──
// The element ARENA INDEX of `ix` when `ix` is a `TyArray` whose element names a real
// arena row; `-1` when `ix` is not an array, or when its element is the HOLE.
//
// THE one home for `TyArray.aElem`'s hole. `aElem` is `-1` for an empty `[]` whose
// element type is not yet known — that is the declared representation (see `TyArray`),
// not a corruption — so `T.tys[t.aElem]` on such a type is an out-of-bounds `array.get`
// INSIDE THE COMPILER: no diagnostic, no source location, no module, just a wasm
// backtrace through `vl-compiler.wasm`. That is strictly the worst failure this file can
// produce, and it is one missing comparison away from every element read.
//
// The census that motivates a named home: this file dereferences `aElem` at 22 sites and
// EIGHTEEN of them spell `if x.aElem < 0 { return … }` inline immediately above the read.
// The four that did not were a SHORTENED MIRROR of those eighteen — `nulElemListRetName`
// was the only member of its own thirteen-function `*RetName` ladder without the guard,
// and `structElemFieldsPlain` had the comparison ONE LINE BELOW the read it needed to
// gate. A reader adding the next element read asks this function instead of copying a
// sibling and losing the line.
//
// The UPPER bound is checked too: an index past the arena end traps identically, and no
// inline guard had it.
function tyArrayElemIx(ix: i32): i32 {
  if ix < 0 || ix >= T.tys.length { return -1 }
  const t = T.tys[ix]
  if t is TyArray {
    if t.aElem < 0 || t.aElem >= T.tys.length { return -1 }
    return t.aElem
  }
  -1
}

// ── structural type equality ─────────────────────────────────────────────────
// Whether two arena types RENDER identically (`tyToStr(a) == tyToStr(b)`),
// decided structurally without building the strings. Powers the "redundant
// annotation" hints, whose meaning is literally "the annotation spells what
// inference already prints" — so this mirrors the RENDERING rules rather than
// plain shape equality:
//   - union LAYERS flatten in the render and a one-member union prints as its
//     member, so members compare through `unionMembersInto`;
//   - every internal inference hole prints `_`, so two holes compare equal;
//   - object field ORDER is significant (the render is ordered).
// Mutual assignability is NOT equality (width subtyping accepts extra fields);
// `sameVariantTy` keeps its two-way `assignable` check.
const tyEqAStack: i32[] = []
const tyEqBStack: i32[] = []

function tyEq(a: i32, b: i32) {
  if a == b { return true }
  if a < 0 || b < 0 { return false }
  // A pair already being compared higher in the recursion is assumed equal —
  // the cycle guard for recursive named types, like `assignable`'s.
  let gi = tyEqAStack.length - 1
  while gi >= 0 {
    if tyEqAStack[gi] == a && tyEqBStack[gi] == b { return true }
    gi = gi - 1
  }
  tyEqAStack.push(a)
  tyEqBStack.push(b)
  const ok = tyEqGo(a, b)
  tyEqAStack.pop()
  tyEqBStack.pop()
  ok
}

// Flatten nested union LAYERS only — a nullable renders `T?`, not `T | null`,
// so (unlike `flattenVariantsInto`) a nullable stays opaque here.
function unionMembersInto(ty: i32, out: i32[]) {
  if ty >= 0 {
    const t = T.tys[ty]
    if t is TyUnion {
      const ms = t.uMembers
      let i = 0
      while i < ms.length {
        unionMembersInto(ms[i], out)
        i = i + 1
      }
      return 0
    }
  }
  out.push(ty)
  0
}

// Union render-equality: the flattened member sequences match pairwise.
function unionEq(a: i32, b: i32) {
  const av: i32[] = []
  unionMembersInto(a, av)
  const bv: i32[] = []
  unionMembersInto(b, bv)
  if av.length != bv.length { return false }
  let i = 0
  while i < av.length {
    if !tyEq(av[i], bv[i]) { return false }
    i = i + 1
  }
  true
}

function tyEqGo(a: i32, b: i32) {
  // `tyEq` answers "do these RENDER identically", and a NOMINAL NEWTYPE renders as
  // its name — so two brands, or a brand and its base, are not equal here either.
  // Keeps the predicate consistent with `tyToStr`, which is its stated contract.
  if nomNameOfTy(a) != nomNameOfTy(b) { return false }
  const ta = T.tys[a]
  const tb = T.tys[b]
  // Either side being a union routes to the same member-sequence comparison, so
  // this asymmetric pre-test sits AHEAD of the exhaustive dispatch on `ta` below
  // (its `TyUnion` arm would otherwise shadow the `b`-side case).
  if tb is TyUnion { return unionEq(a, b) }
  // EXHAUSTIVE over `Ty` and deliberately `_`-less: the checker names any arena
  // variant this equality stops answering for, so a 12th variant breaks the
  // self-compile here instead of silently answering `false` = "these two types are
  // different", which every caller reads as a settled verdict.
  match ta {
    TyUnion => {
      return unionEq(a, b)
    }
    TyPrim => {
      if tb is TyPrim { return ta.primName == tb.primName }
      return false
    }
    TyErr => {
      if tb is TyErr { return true }
      return false
    }
    TyVar => {
      if tb is TyVar {
        // An inference hole renders `_` regardless of its internal name.
        if ta.tvName[0] == '?' { return tb.tvName[0] == '?' }
        return ta.tvName == tb.tvName
      }
      return false
    }
    TyLit => {
      if tb is TyLit {
        return ta.litKind == tb.litKind && ta.litText == tb.litText
      }
      return false
    }
    TyNullable => {
      if tb is TyNullable { return tyEq(ta.nInner, tb.nInner) }
      return false
    }
    TyArray => {
      if tb is TyArray { return tyEq(ta.aElem, tb.aElem) }
      return false
    }
    TyMap => {
      if tb is TyMap {
        if ta.mSet != tb.mSet { return false }
        return tyEq(ta.mKey, tb.mKey) && tyEq(ta.mVal, tb.mVal)
      }
      return false
    }
    TyFunc => {
      if tb is TyFunc {
        const ap = ta.fnParamTypes
        const bp = tb.fnParamTypes
        if ap.length != bp.length { return false }
        if !tyEq(ta.fnRet, tb.fnRet) { return false }
        let i = 0
        while i < ap.length {
          if !tyEq(ap[i], bp[i]) { return false }
          i = i + 1
        }
        return true
      }
      return false
    }
    TyObj => {
      if tb is TyObj {
        const an = ta.objFieldNames
        const bn = tb.objFieldNames
        if an.length != bn.length { return false }
        const aty = ta.objFieldTypes
        const bty = tb.objFieldTypes
        let i = 0
        while i < an.length {
          if an[i] != bn[i] { return false }
          if !tyEq(aty[i], bty[i]) { return false }
          i = i + 1
        }
        return true
      }
      return false
    }
    TyNeg => {
      if tb is TyNeg { return tyEq(ta.negTy, tb.negTy) }
      return false
    }
  }
  // UNREACHABLE by construction: every arena variant has an arm above and every
  // arm returns. The per-arm `tb` tests are SAME-VARIANT guards, not a second
  // dispatch — their `return false` is the right answer for every other variant,
  // so they stay `if`s.
  false
}

// The type-arena index of object `o`'s field `name`, or `-1` if absent. Takes a
// concrete `TyObj` (already narrowed by the caller) — `Ty`-union only.
// Arena step by FIELD NAME — index in, index out. The `tyStep*` peel family's
// object arm, exported because the shape interner's descent peels a shape's FIELD
// TEXTS and needs the matching arena field. Declines (-1) on a non-`TyObj` and on a
// name the object lacks; the caller then takes the name leg unchanged.
export function tyFieldTyOf(ty: i32, name: string): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyObj { return objFieldType(t, name) }
  -1
}

function objFieldType(o: TyObj, name: string) {
  const names = o.objFieldNames
  const ftys = o.objFieldTypes
  let i = 0
  while i < names.length {
    if names[i] == name { return ftys[i] }
    i = i + 1
  }
  -1
}

// ── emit-name canonicalization ────────────────────────────────────────────────
// The native emitter classifies annotations by their synthetic NAME, and the
// literal/intersection algebra above is purely a CHECKER notion — at runtime a
// same-base literal union IS its base scalar (`"a" | "b"` rides a string,
// `0 | 1` an i32, `1.5 | 2.5` an f64) and a folded intersection IS its fold
// (`(0|1|2) & !2` an i32, `{a} & {b}` the merged shape). So at the end of
// `checkProgram`, `canonEmitTypeNames` rewrites every annotation name into the
// emitter's vocabulary; a name with no literal/intersection construct passes
// through BYTE-IDENTICAL (the membership rules were already enforced above —
// the emitter only needs the representation).

// Whether `name` contains a construct the emitter can't classify: a quoted
// string-literal member, an `&` intersection, a `!` negation, a parenthesized
// group, or a numeric-literal member (a digit at a member-START position —
// after `|` / `:` / `,` or at the very start; a digit INSIDE an identifier
// like `i32` never starts a member).
function nameNeedsCanon(name: string) {
  let i = 0
  while i < name.length {
    const c = name[i]
    if c == '"' || c == '&' || c == '!' || c == '(' { return true }
    // A composite form (`Id[]`, `{[string]: Id}`, `{x: Id}`) may embed a single-member alias in its
    // element / value / field, which `canonEmitName`'s array/map/object recursion resolves — so it
    // must run even when no other canon trigger is present. Idempotent for an already-canon composite
    // (a non-alias element rewrites to itself), so this only broadens WHICH names recurse, not the
    // result of any name that already canon'd.
    if c == '[' || c == '{' { return true }
    // A top-level union (`AB | null`) must be processed so a union-ALIAS member expands to
    // its flattened members (the inline `(A|B)|null` already trips the `(` test above). The
    // member-canon loop is idempotent for an already-flat union, so this is a no-op there.
    if c == '|' { return true }
    if c >= '0' && c <= '9' {
      if i == 0 { return true }
      const p = name[i - 1]
      if p == '|' || p == ':' || p == ',' { return true }
    }
    i = i + 1
  }
  false
}

// Whether `ix` HAS an emitter-classifiable synthetic name — i.e. `tyToEmitName(ix)
// != ""`, decided STRUCTURALLY without building the name. The callers that ask this
// are asking a genuine CAPABILITY question ("can the emitter name this type?");
// phrasing it as "render it and test the result for the empty string" minted a name
// (and every nested name under it) purely to throw it away, and coupled the
// predicate to the renderer's spelling rules. Same arms in the same order as
// `tyToEmitName`: a `TyVar` / residual `TyNeg` / `TyErr` / the `never` prim has no
// name, and a composite has one exactly when every component does.
//
// `tyToEmitName`'s litunion-ALIAS legs (`litUnionAliasNameOfTy` on a union member,
// nullable inner, struct field, array element, map value, fn result) are NOT
// mirrored here because they cannot change the ANSWER, only the spelling: an alias
// name is only ever substituted for a type `tyIsLitUnion` accepts — a union of
// string literals — and every one of those already names itself (`string`). Same
// for the flattened-alias REGROUP, which only ever substitutes for `TyLit` members.
// `tyToEmitName` has no cycle guard, so neither does this; a type that would
// recurse forever here recursed forever there.
function tyIsEmitRepresentable(ix: i32): boolean {
  if ix < 0 { return false }
  const t = T.tys[ix]
  // EXHAUSTIVE over `Ty` and deliberately `_`-less: a 12th arena variant breaks the
  // self-compile here instead of silently answering `false` = "the emitter cannot
  // name this", which sends every caller down its fallback path.
  match t {
    TyPrim => {
      return t.primName != "never"
    }
    TyLit => {
      return true
    }
    TyUnion => {
      const members = t.uMembers
      // An EMPTY union produces no parts, and `tyToEmitName` returns "" for it.
      if members.length == 0 { return false }
      let i = 0
      while i < members.length {
        if !tyIsEmitRepresentable(members[i]) { return false }
        i = i + 1
      }
      return true
    }
    TyNullable => {
      return tyIsEmitRepresentable(t.nInner)
    }
    TyObj => {
      // A field-less shape renders `{}` — non-empty, so representable.
      const ftys = t.objFieldTypes
      let i = 0
      while i < ftys.length {
        if !tyIsEmitRepresentable(ftys[i]) { return false }
        i = i + 1
      }
      return true
    }
    TyArray => {
      return tyIsEmitRepresentable(t.aElem)
    }
    TyMap => {
      if !tyIsEmitRepresentable(t.mKey) { return false }
      return tyIsEmitRepresentable(t.mVal)
    }
    TyFunc => {
      const ps = t.fnParamTypes
      let i = 0
      while i < ps.length {
        if !tyIsEmitRepresentable(ps[i]) { return false }
        i = i + 1
      }
      return tyIsEmitRepresentable(t.fnRet)
    }
    TyVar => {
      // An unsolved type PARAMETER has no emitter name (the header's list).
    }
    TyNeg => {
      // A RESIDUAL negation — `intersectTy` folds the rest — has no emitter name.
    }
    TyErr => {
      // The error/unknown hole has no emitter name.
    }
  }
  // The three empty arms above land here: `tyToEmitName` spells "" for each, so
  // the capability answer is false.
  false
}

// Whether `ix`'s emitter-classifiable name is EXACTLY `string` — `tyToEmitName(ix)
// == "string"`, decided structurally. Only three of `tyToEmitName`'s arms can spell
// a bare `string`: the `string` prim, a string LITERAL (softened to `string`), and a
// union whose parts all render `string` (the render DEDUPS, so they collapse to one
// part). Every other arm renders a composite (`{…}`, `…[]`, `(…)=>…`, `…|null`,
// `{[…]:…}`) or a declared ALIAS name, none of which is the bare primitive.
function tyEmitNameIsString(ix: i32): boolean {
  if ix < 0 { return false }
  const t = T.tys[ix]
  if t is TyPrim { return t.primName == "string" }
  if t is TyLit { return t.litKind == "str" }
  if t is TyUnion {
    const members = t.uMembers
    if members.length == 0 { return false }
    // THE MIRROR OF THE UNION ARM, AND IT GREW BACK WITH IT (owner ruling 2026-07-29,
    // reversing 2026-07-28). These two tests — the flattened-alias REGROUP and the
    // per-member litunion-ALIAS lookup — are here because the render this predicts can
    // substitute a declared alias NAME for a literal run, and a name that is not `string`
    // makes the answer false. Both legs are back in `tyToEmitNameGo`'s union arm, so both
    // are back here. DUAL-WRITTEN in the same slice, deliberately — the header's contract
    // is `tyToEmitName(ix) == "string"` decided structurally, and it is a contract only if
    // the two move together.
    //
    // The answer this MOVES back is exactly the mixed union whose non-lit members all
    // render `string` (`"a" | "b" | string`, a litunion alias beside its own base): #1296
    // rendered `string` and answered true, this build renders `K0|string` and answers
    // false. NO CORPUS PROGRAM REACHES IT — restoring these legs moved 0 of 1,700 files on
    // all six A/B channels, in this slice exactly as in #1296's — so it is carried as a
    // CONTRACT obligation, not as a measured cell, and reported that way.
    const rgTexts: string[] = []
    let rgNonLit = false
    let rg = 0
    while rg < members.length {
      const rm = T.tys[members[rg]]
      if rm is TyLit {
        if rm.litKind == "str" { rgTexts.push(rm.litText) }
      } else {
        let rmNull = false
        if rm is TyPrim {
          if rm.primName == "null" { rmNull = true }
        }
        if !rmNull { rgNonLit = true }
      }
      rg = rg + 1
    }
    let rgAlias = ""
    if rgNonLit && rgTexts.length >= 2 {
      rgAlias = litUnionAliasOfLitTexts(rgTexts)
    }
    if rgAlias != "" && rgAlias != "string" { return false }
    let i = 0
    while i < members.length {
      const rgm = T.tys[members[i]]
      let skip = false
      if rgAlias != "" && rgm is TyLit { skip = true }
      if !skip {
        // A closure member renders PARENTHESIZED (`(()=>i32)`) — never bare.
        if rgm is TyFunc { return false }
        // A member that IS a registered litunion alias contributes its NAME.
        const al = litUnionAliasNameOfTy(members[i])
        if al != "" {
          if al != "string" { return false }
        } else if !tyEmitNameIsString(members[i]) {
          return false
        }
      }
      i = i + 1
    }
    return true
  }
  false
}

// THE RENDER-CONTEXT VOCABULARY — the `ctx` half of the one agreed emit renderer
// (`renderEmit(ty, ctx)`), threaded here in phase P1 with NO consumer reading it for a
// decision yet.
//
// WHY A PARAMETER AT ALL. The three producers of the emitter's type vocabulary
// (`canonEmitName`, `tyToEmitName`, `tyToNominalName`) disagree with each other on 853 of
// 5,172 resolvable corpus annotations, and the disagreement is TWO-DIRECTIONAL: 41 where
// canon rewrites and the renderer does not, 108 the other way, 5 where both move
// differently. Both answers are already right SOMEWHERE — #1124 shipped the STRUCTURAL
// expansion for a generic application standing as a multi-member union member, while
// #1122 measured the NOMINAL route and found it regresses `type MyCat = Cat`. The same
// construct family sits on both sides: a litunion alias `K0` SOFTENS to `string` in a
// direct union and is PRESERVED inside a closure result, a map value, an array element and
// a struct field (four distinct fuzz-nightly invalid-wasm seeds are cited in
// `tyToEmitNameGo`'s arms for exactly that), and a NULLABLE litunion is preserved by canon
// and softened by the renderer. So the policy cannot be global — the POSITION decides, and
// a renderer that cannot say where it is cannot state the rule. See the `renderEmit`
// design in `docs/internals/destringify-types-program.md`.
//
// THE ENCODING. Powers of two, and a render carries EXACTLY ONE position bit — the
// IMMEDIATE position it occupies in its parent — plus the sticky `RC_NULLABLE` below.
// Bits rather than an enum because the rules these will state quantify over SETS of
// positions ("preserved in a field, an element, a map value or a closure result"), which
// is one `&` against a bit union.
const RC_ROOT = 0      // a top-level render: no enclosing position at all
const RC_UNION_MEM = 1 // a member of a union
const RC_NULLABLE = 2  // under a nullable — see the STICKY note below
const RC_FIELD = 4     // an object field's type
const RC_ELEM = 8      // an array element's type
const RC_MAP_KEY = 16  // a map key's type
const RC_MAP_VAL = 32  // a map value's type
const RC_FN_PARAM = 64 // a function type's parameter
const RC_FN_RES = 128  // a function type's result

// `RC_NULLABLE` IS STICKY ACROSS A UNION JOIN, AND IT HAS TO BE, BECAUSE THE TWO
// SPELLINGS PUT THE NULLABLE AT DIFFERENT DEPTHS. Structurally `A | B | null` is a
// `TyNullable` OVER a `TyUnion`, so `A` sits two levels down; in the STRING spelling
// `canonEmitName` splits one flat top-level `|` and `A` and `null` are siblings. A rule
// that reads "am I under a nullable" must get the same answer from both or the one agreed
// renderer is not one renderer. So the union arm of every producer below passes
// `RC_UNION_MEM | (ctx & RC_NULLABLE)`, and canon's flat split re-derives the bit from a
// `null` sibling (`partsHaveNull`). Every other bit is REPLACED at each descent: a field
// of a struct that is itself an array element is a field, not both.
//
// ANCESTRY BEYOND THAT ONE STICKY BIT IS NOT MODELLED HERE, AND THE SECOND ONE THAT WAS
// ADDED CAME BACK OUT. #1271 gave this file `RC_UNDER_FUNC` (256) — "anywhere inside a
// function type, at any depth" — because the numeric-litunion-alias rule below could not
// fire under a function type without breaking `(Z) => i32`:
//
//   type Z = 0 | 1
//   function run(m: (Z) => i32): i32 { const v = m(1); return v }
//   function mk(x: Z): i32 { x + 2 }
//   print(run(mk))
//
// The DEFECT that bit worked around was not in this renderer. `canonEmitName` left a
// top-level function type VERBATIM unless its result happened to be parenthesized, so the
// annotation pipeline's key for that parameter was `(Z)=>i32` — alias name and all — while
// `mk`'s OWN parameter annotation, an `RC_ROOT` `Z`, canon'd to `i32`. The two `$fnsig`
// spellings of one closure forked, and a producer that softened anywhere inside a function
// type simply moved WHICH spelling was the odd one out. Gating this renderer against
// softening made the two AGREE on the un-softened spelling and left eight other shapes
// (`(i32) => Z`, `(i32) => {a:Z}`, …) invalid: they fork the other way, because the thing
// on their side of the fork is a DECLARATION whose annotations canon at `RC_ROOT`.
//
// So the rule is now stated once, at the place that decides it: the interior of a function
// TYPE is CANON'D — params and result, bare result or parenthesized
// (`canonEmitNameAt`'s function-type arm), at `RC_FN_PARAM` and `RC_FN_RES`. Those two
// positions agree with the `RC_ROOT` a DECLARATION's annotations canon at on every rule
// this file states except one: `ctxKeepsLitUnion` holds at `RC_FN_RES` and not at
// `RC_ROOT`, so an INLINE `() => "a"|"b"` keeps its members while `function mk(): "a"|"b"`
// softens to `string`. That asymmetry is untouched here and is not reachable as a
// miscompile — the soundness floor refuses the shape ("function-value call arity has no
// interned signature") identically before and after, measured both ways. With that,
// nothing under a function type needs to know it is under one — the alias softens on both
// sides and the spellings meet. Measured: removing the bit ALONE reddens six grid cells
// (`(Z) => i32` and `({a:Z}) => i32` through all three call forms); removing it WITH the
// canon fix moves zero, and the canon fix takes 38 cells forward.
//
// Every OTHER bit is REPLACED at each descent: a field of a struct that is itself an array
// element is a field, not both. Only `RC_NULLABLE` rides through.

// The TOP-LEVEL atom count of the name the LAST `tyToEmitName` call returned — the
// number `unionMemberCount` would report for it, produced BY THE RENDERER instead of
// re-derived by scanning the finished string (#1113). A rendered name gains a top-level
// `|` at exactly two places (the union arm's join and the nullable arm's `|null`
// suffix); every other arm builds a name whose separators all sit inside a grouper or
// behind a top-level `=>`, so it is ONE atom. Meaningful only when the render is
// non-empty — a "" result is a failure signal no caller counts.
//
// Not an arena-lifetime sidecar (method note 7): a scalar written on the way out of
// every non-empty return and read by the immediate caller, never carried between
// programs.
let emitNameAtoms = 1

// The ANCESTOR stack of the render in progress — `isEquatable`'s `seen` guard, for the
// renderer. A RECURSIVE type (`type Node = {v: i32, next: Node | null}`) is a CYCLE in
// the arena, and a structural render of a cycle is an infinite string: every arm below
// recurses into the field / element / member / result types, so without this the render
// does not terminate and the COMPILER dies with `wasm trap: call stack exhausted`. That
// is not hypothetical — two single-file, well-typed programs reach it on a stock build:
// `const n: Node & {v: i32} = …` (the `&`-fold arm of `canonEmitName`) and
// `type U = Box<Node> | {w: i32}` (`unionMemberGenAppShape`). A cyclic type simply has
// no finite emit NAME, which is exactly what "" already means to every caller — the
// recursive shapes the emitter does lower ride their NOMINAL annotation spelling
// (`Node`), never a structural render, so declining here takes nothing away.
//
// Push/pop balanced around the recursive entry, so it holds ANCESTORS only: a shape that
// mentions one struct TWICE as siblings (`{a: S, b: S}`) still renders both — `S` is
// popped when the first field finishes. Not an arena-lifetime sidecar (method note 7):
// it is empty on entry and on exit of every top-level call, by that balance.
const emitNameSeen: i32[] = []

// Render a RESOLVED arena type as an emitter-classifiable synthetic name, or
// "" when it has none (a TyVar, a residual negation, err/never, or — see the
// cycle guard above — a RECURSIVE type). Only the
// `&`-fold arm of `canonEmitName` consults this — every other arm rewrites the
// name STRUCTURALLY without resolving it, so a NAMED struct keeps its name.
// The "does it have one at all?" question has a structural answer
// (`tyIsEmitRepresentable`) — ask that rather than testing this for "".
//
// THE POSITION-FREE ENTRY. Every caller outside this renderer asks about a type standing
// on its own, so this is `RC_ROOT` by definition and the arity stays one — which is also
// what keeps the emitter's own call sites (`emit_classify.vl`'s `annSigKey` twins) out of
// this phase entirely.
export function tyToEmitName(ix: i32) { tyToEmitNameAt(ix, RC_ROOT) }

// The same render, told the POSITION it occupies in its parent. The cycle guard lives here
// rather than on the entry above so the RECURSIVE calls below — which are the only ones
// that can close a cycle — keep passing through it.
function tyToEmitNameAt(ix: i32, ctx: i32) {
  let si = 0
  while si < emitNameSeen.length {
    if emitNameSeen[si] == ix {
      emitNameAtoms = 1
      return ""
    }
    si = si + 1
  }
  emitNameSeen.push(ix)
  const r = tyToEmitNameGo(ix, ctx)
  emitNameSeen.pop()
  r
}

// The position a composite's INTERIOR stands at, for the STRUCTURAL renderer — normally
// the interior's own position, but `RC_ROOT` when `ix` is a registered generic-APPLICATION
// instance (`Box<"a"|"b">`).
//
// WHY THE EXPANSION IS A ROOT AND NOT A FIELD. Canon never sees this shape structurally: it
// spells the annotation `Box<` + `canonEmitNameAt(arg, RC_ROOT)` + `>` and hands the
// EXPANSION to `gaeBases`, so the emitter's row for `Box<"a"|"b">` carries whatever
// `RC_ROOT` produced — a softened `string` field. This renderer walks the arena and sees
// only the expanded `{v: …}`, where the argument now stands at `RC_FIELD` and the inline
// litunion leg would keep it. That fork is invalid wasm and it was MEASURED, not feared: a
// lambda whose inferred return is `Box<"aa"|"zz">` builds a module whose functype names the
// atom-field row while the annotation registered the string-field one
// (`type mismatch: expected (ref $type), found (ref $type)`, `vl check` rc 0). Teaching
// CANON the argument's real position was built too (`canonarg`) and is worse: the same cell
// becomes `emitProgram: ref valtype with no interned shape` and a green global moves 489 →
// 564 bytes. Canon's own application arm says why — *"an ARGUMENT stands where the parameter
// it binds stands, which is a position this rewrite has no way to know"* — so the renderer
// agrees with the position canon actually used, rather than inventing a better one.
//
// The NOMINAL renderer needs none of this: `genAppNameOfTy` short-circuits ahead of its
// composite arms, so an application instance never reaches them.
function appKidCtx(ix: i32, ctx: i32): i32 {
  if cTyIxListHas(gaAppTyIxs, ix) { return RC_ROOT }
  ctx
}

function tyToEmitNameGo(ix: i32, ctx: i32) {
  emitNameAtoms = 1
  if ix < 0 { return "" }
  const t = T.tys[ix]
  // EXHAUSTIVE over `Ty` and deliberately `_`-less: a 12th arena variant breaks the
  // self-compile here instead of silently rendering "" = "no emitter-classifiable
  // name", which every name-keyed registry downstream reads as a settled answer.
  match t {
    TyPrim => {
      if t.primName == "never" { return "" }
      return t.primName
    }
    TyLit => {
      // A LITERAL renders as its base scalar, at the ONE home that answers that (see
      // `tyLitBaseName`) — this arm and its twin in the other renderer were two of the three
      // hand-written copies of `litBaseTy`'s four-way rule.
      return tyLitBaseName(t)
    }
    TyUnion => {
      const members = t.uMembers
      // THE PURE INLINE LITERAL UNION KEEPS ITS MEMBERS — canon's `litUnionPreserve` /
      // `nulLitUnionPreserve` pair, mirrored off the arena. Without it every `TyLit` member
      // below rendered its BASE (`string`) and the dedup collapsed the run to that one
      // scalar, so an inline `{tag: "a" | "b"}` rendered `{tag:string}` while the ANNOTATION
      // side spelled it `{tag:"a"|"b"}` — one arena type, two names, and every name-keyed
      // registry downstream (struct layouts, `$fnsig` keys, mv slots, union rows) holds a
      // row for each.
      //
      // THE TWO GATES ARE CANON'S TWO RUNGS, NOT A NEW POLICY. `nulLitUnionPreserve` fires
      // on any top-level split holding a `null` sibling, at EVERY position; the bare form
      // reaches `litUnionPreserve` only under `ctxKeepsLitUnion`, because a bare inline
      // litunion at `RC_ROOT` / `RC_FN_PARAM` has no param-valtype or struct-field ladder arm
      // (the measurement is on `ctxKeepsLitUnion` itself). Rendering it at those two
      // positions would spell a name the emitter rejects; rendering it at neither leaves the
      // disagreement this leg exists to close.
      const luiN = litUnionInlineNameOfTy(ix)
      if luiN != "" {
        if luiHasNull {
          emitNameAtoms = luiAtoms + 1
          return luiN + "|null"
        }
        if ctxKeepsLitUnion(ctx) {
          emitNameAtoms = luiAtoms
          return luiN
        }
      }
      // THE MIXED-UNION PRESERVE — the OWNER'S RULING of 2026-07-29, which REVERSES the
      // soften ruling of 2026-07-28: *"I'm reverting the softening. `K | f64` should be
      // preserved as `K | f64` (or flattened to the constituent parts of `K | f64`).
      // Softening to a string is just wrong as I see it."*
      //
      // So a string-litunion ALIAS standing as a MEMBER of a union keeps its ALIAS name:
      // `K0 | f64` is `K0|f64`, not `string|f64`. The two legs below are the rule, and
      // `canonEmitNameAt`'s union arm carries its MIRROR (`mixedUnionLitAliasRegroup`) so
      // the ANNOTATION side spells the same union the same way — that mirror is what makes
      // this a unification rather than a return to the 55-row disagreement #1296 closed.
      //
      // WHICH OF THE OWNER'S TWO SPELLINGS THIS IS, AND WHY. The ruling allows the ALIAS or
      // the FLATTENED members; this is the ALIAS, chosen by measurement, not by taste. The
      // flattened spelling `"a"|"b"|f64` is not in the EMITTER's union grammar: a union ATOM
      // that is a single quoted literal fails `nameIsLitUnionType` (`nameIsInlineLitUnion`
      // needs 2+ quoted atoms), so `canonLitUnionArms`, `unionHasValueAtom` and
      // `isVariantBoxUnionAtoms` all classify it as a non-atom "other" member and the box
      // loses its string arm. The alias spelling is the one every one of those ladders
      // already has a leg for — it is what this renderer produced for the whole of the
      // project's history before #1296, and the emitter consumed it.
      //
      // A LIT RUN WITH NO REGISTERED ALIAS STILL SOFTENS, on both producers, and that is the
      // ruling read exactly: there is no `K` to preserve for an un-aliased inline
      // `"a"|"b"|f64`, and softening it is the behaviour master and pre-#1296 master share.
      // The rule is therefore "spell the run by its alias where the program gave it one".
      //
      // THE DATA REP DOES NOT MOVE IN EITHER DIRECTION, which is why the spelling is free to:
      // `emitUnionCoerce`'s atom ladder classifies the incoming value by EXPRESSION
      // (`exprString` → value-atom kind 2), never by the union's spelling, and
      // `repCanonKey`'s union arm mix-widens the member in the ARENA before any rep key is
      // minted. The rep key for `K0|f64` is `(string|f64)` under both rulings — see the
      // re-derived coercion census in `docs/internals/destringify-types-program.md`.
      //
      // FLATTENED-alias regroup: a litunion-ALIAS member's literals flatten into sibling
      // TyLit members (`flattenVariantsInto`: `K0 | i64` → ["64","bjtvb","tt", i64]), so
      // the per-member alias lookup below never sees the alias and each lit softened to
      // `string` — the widened spelling minted TWIN field/slot rows beside the
      // annotation-spelled ones (divergent structs/mv slots — INVALID-WASM; fuzz-nightly
      // seed 658239060 d5). In a MIXED union (at least one non-TyLit member) regroup the
      // str-lit members into their exactly-matching registered alias, rendered at the
      // FIRST lit's position. A PURE litunion keeps the historical `string` softening
      // (the `canonEmitTypeNames` invariant), and a lit set matching no alias keeps the
      // per-member path unchanged.
      let rgAlias = ""
      const rgTexts: string[] = []
      let rgNonLit = false
      let rg = 0
      while rg < members.length {
        const rm = T.tys[members[rg]]
        if rm is TyLit {
          if rm.litKind == "str" { rgTexts.push(rm.litText) }
        } else {
          let rmNull = false
          if rm is TyPrim {
            if rm.primName == "null" { rmNull = true }
          }
          if !rmNull { rgNonLit = true }
        }
        rg = rg + 1
      }
      if rgNonLit && rgTexts.length >= 2 {
        rgAlias = litUnionAliasOfLitTexts(rgTexts)
      }
      const parts: string[] = []
      // The render's atom count, accumulated as the parts are KEPT: the join below inserts
      // exactly one top-level `|` per part boundary, so the whole render is as wide as its
      // parts together. A part is not always ONE atom — a nullable member renders `X|null` —
      // which is why this is summed rather than read off `parts.length` at the end.
      let psum = 0
      let rgDone = false
      let i = 0
      while i < members.length {
        // A MEMBER that is a registered litunion ALIAS (`K0 | i64`) keeps its alias name
        // rather than softening to `string` — the alias arm reps as the i32 atom in the
        // union box, and every `$fnsig`/slot key derived from this render must agree with
        // the annotation side's `(K0|i64)` spelling. Without it a closure returning
        // `(K0 | i64)[]` keyed `(string|i64)[]` while the value call keyed the alias —
        // divergent functypes, a cast-failure TRAP (fuzz-nightly run 29808029476, seed
        // 78530533 d5). The union-member sibling of the TyFunc-result / TyObj-field
        // alias preservation above and below.
        const rgm = T.tys[members[i]]
        if rgAlias != "" && rgm is TyLit {
          if !rgDone {
            rgDone = true
            parts.push(rgAlias)
            psum = psum + 1
          }
          i = i + 1
          continue
        }
        // An ALIAS name is one identifier — one atom. Only the RENDER leg can be wider,
        // and it reports its own width in `emitNameAtoms`.
        let sc = 1
        let s = litUnionAliasNameOfTy(members[i])
        if s == "" {
          // A union MEMBER, carrying the sticky nullable bit down so this arm agrees with
          // canon's flat `A|B|null` split about what "under a nullable" means.
          s = tyToEmitNameAt(members[i], RC_UNION_MEM | (ctx & RC_NULLABLE))
          sc = emitNameAtoms
        }
        if s == "" { return "" }
        // A FUNCTION-TYPE member renders PARENTHESIZED (`(()=>f32|null)|{w:i32}`) — the
        // annotation's atom spelling. Bare, the closure's result arms swallow the union's
        // sibling members (`()=>f32|null|{w:i32}`), so `annSigKey` read a top-level arrow
        // and keyed the whole result `>c` while the pinned lambda interned `>u` — a
        // divergent `ref.cast` functype at the value call (INVALID-WASM; fuzz-nightly
        // seed 556796311 d6).
        // The grouping parens put every separator inside a grouper — one atom again.
        if rgm is TyFunc {
          s = "(" + s + ")"
          sc = 1
        }
        let dup = false
        let j = 0
        while j < parts.length {
          if parts[j] == s { dup = true }
          j = j + 1
        }
        if !dup {
          parts.push(s)
          psum = psum + sc
        }
        i = i + 1
      }
      if parts.length == 0 { return "" }
      let out = parts[0]
      let k = 1
      while k < parts.length {
        out = out + "|" + parts[k]
        k = k + 1
      }
      emitNameAtoms = psum
      return out
    }
    TyNullable => {
      // A NULLABLE LITUNION-ALIAS (`K0 | null`) keeps its alias rather than the softened
      // `string|null` — the two spell DIFFERENT reps (the alias niche is the i32 atom with
      // the -1 sentinel; `string|null` is the nullable string ref). A `{[string]: K0|null}[]`
      // lambda pin rendered the softened value and its element slot keyed the STRING-valued
      // map struct while the captured map was the mono atom map — INVALID-WASM at the array
      // build (fuzz sweep4 plain leg, seed 142958508 case_00046). The nullable sibling of
      // the TyUnion-member / TyObj-field / TyMap-value / TyArray-element alias preservation.
      const nal = litUnionAliasNameOfTy(t.nInner)
      if nal != "" {
        // An alias identifier plus the `null` arm — two atoms.
        emitNameAtoms = 2
        return nal + "|null"
      }
      // …and an UN-ALIASED one keeps its MEMBERS, for the same reason and at every position:
      // canon's `nulLitUnionPreserve` has no `ctxKeepsLitUnion` gate. The alias leg above is
      // the same preference `litUnionInlineNameOfTy` applies internally, so the two cannot
      // disagree about which spelling wins.
      const nlui = litUnionInlineNameOfTy(t.nInner)
      if nlui != "" {
        emitNameAtoms = luiAtoms + 1
        return nlui + "|null"
      }
      const inner = tyToEmitNameAt(t.nInner, RC_NULLABLE)
      const innerAtoms = emitNameAtoms
      if inner == "" { return "" }
      // A NULLABLE FUNCTION type keeps the kind-19 grouping parens (`((i32)=>string)|null`)
      // — bare, the render spells a closure RETURNING `string|null` instead (the `|null`
      // binds to the result), the same swallowed-arm ambiguity as the union-member case.
      const nfn = T.tys[t.nInner]
      if nfn is TyFunc {
        // The grouped closure is one atom; `null` is the second.
        emitNameAtoms = 2
        return "(" + inner + ")|null"
      }
      // A union INNER keeps its own top-level `|`s (`A|B|null`), so the `null` arm ADDS to
      // the inner render's width rather than making the whole name two atoms.
      emitNameAtoms = innerAtoms + 1
      return inner + "|null"
    }
    TyObj => {
      const names = t.objFieldNames
      const ftys = t.objFieldTypes
      let out = "{"
      let fi = 0
      while fi < names.length {
        // A FIELD preserves a literal-union ALIAS (`{f: K0}`, `{f: K0 | null}`) rather
        // than the softened `string` — so a rendered shape resolves the SAME struct index
        // the annotation side interned (`{f:K0}`, the i32-atom field layout), not the
        // string-field twin. Without it a nullable-struct closure-result pin
        // (`nullableRetName`'s TyObj arm) keyed `>n` on `{f:string}` while the annotated
        // value call keyed `>n` on `{f:K0}` — divergent `$fnsig` entries: a cast-failure
        // TRAP at the narrowed nullable-closure call (fuzz frontier seed 679748579 d5).
        // The field dual of the TyFunc-result alias preservation below.
        let fs = ""
        const ftn = T.tys[ftys[fi]]
        if ftn is TyNullable {
          const fal = litUnionAliasNameOfTy(ftn.nInner)
          if fal != "" { fs = fal + "|null" }
        }
        if fs == "" {
          const fbal = litUnionAliasNameOfTy(ftys[fi])
          if fbal != "" { fs = fbal }
        }
        if fs == "" { fs = tyToEmitNameAt(ftys[fi], appKidCtx(ix, RC_FIELD)) }
        if fs == "" { return "" }
        if fi > 0 { out = out + "," }
        out = out + names[fi] + ":" + fs
        fi = fi + 1
      }
      // Every field separator sits inside the braces — ONE atom. Set rather than
      // inherited: the field renders above left `emitNameAtoms` holding the last field's
      // width.
      emitNameAtoms = 1
      return out + "}"
    }
    TyArray => {
      // A litunion-ALIAS element (`K0[]`) keeps its alias name rather than softening to
      // `string[]` — the two spell DIFFERENT reps (the alias array is the interned-i32
      // ATOM list; `string[]` is the string-ref list), so a widened render minted a TWIN
      // mv slot beside the annotation-spelled one and the narrowed map read resolved the
      // other twin's struct (INVALID-WASM; fuzz-nightly seed 210853359 d6). The array
      // sibling of the TyUnion-member / TyObj-field / TyMap-value alias preservation.
      let el = litUnionAliasNameOfTy(t.aElem)
      // The ELEMENT's own atom WIDTH, as the element's producer reported it — an alias
      // identifier is one atom, the render leg reports its own (D-ARRWIDTH).
      let elw = 1
      if el == "" {
        el = tyToEmitNameAt(t.aElem, appKidCtx(ix, RC_ELEM))
        elw = emitNameAtoms
      }
      if el == "" { return "" }
      // A list name is ONE atom in every form — a union element is parenthesized precisely
      // so its `|`s stop being top-level. Set rather than inherited (the element render
      // left its own width behind). The grouping itself is `arrElemRender`'s (D-ARRGROUP),
      // which also carries the CLOSURE-element rationale this arm used to state twice.
      emitNameAtoms = 1
      return arrElemRender(el, t.aElem, elw)
    }
    TyMap => {
      const mk = tyToEmitNameAt(t.mKey, RC_MAP_KEY)
      // A litunion-ALIAS map VALUE (`{[string]: K0}`) keeps its alias name rather than
      // softening to `string` — an atom-valued map is the MONO i32 map, and every
      // `$fnsig`/mv-slot key derived from this render must agree with the annotation
      // side's `{[string]:K0}` spelling. Widened, a never-constructed inner closure's
      // synthesized `>m` sig keyed the STRING-valued map struct while the narrowed
      // call's map read resolved the mono atom map — INVALID-WASM at the result store
      // (fuzz seed 113148886 d6). The map-value sibling of the TyUnion-member /
      // TyObj-field / TyFunc-result alias preservation around it.
      let mv = litUnionAliasNameOfTy(t.mVal)
      if mv == "" { mv = tyToEmitNameAt(t.mVal, appKidCtx(ix, RC_MAP_VAL)) }
      if mk == "" || mv == "" { return "" }
      // The key/value separators sit inside the braces — one atom.
      emitNameAtoms = 1
      return "{[" + mk + "]:" + mv + "}"
    }
    TyFunc => {
      // A FUNCTION type renders the emitter's closure-annotation form `(p1, p2) => ret` — so an
      // inferred closure VALUE (`const g = f(4)`) recovers an annotation-shaped name the closure
      // `$fnsig` producers (`annSigKey`) can key. "" if any param / the result is unrenderable.

      const ps = t.fnParamTypes
      let out = "("
      let i = 0
      while i < ps.length {
        const ps1 = tyToEmitNameAt(ps[i], RC_FN_PARAM)
        if ps1 == "" { return "" }
        if i > 0 { out = out + "," }
        out = out + ps1
        i = i + 1
      }
      // A function RESULT preserves a literal-union ALIAS (`() => K0`, `() => K0 | null`)
      // rather than `tyToEmitName`'s softened `string` — so an INFERRED closure value (a
      // `??`-defaulted map-value closure, a call result) keys the litunion's i32-atom token
      // (`>i`, via `annRetKind`), byte-matching the constructed lambda's `$fnsig`. Without it
      // the inferred name widened to `string|null`, whose `nulstr` `(ref array)` result clashed
      // with the litunion-atom call (INVALID-WASM at the value call's `local.set`). Mirrors the
      // return-position `nulLitUnionRetName` / `nullableRetName` alias preservation.
      let rs = ""
      const rtn = T.tys[t.fnRet]
      if rtn is TyNullable {
        const nal = litUnionAliasNameOfTy(rtn.nInner)
        if nal != "" { rs = nal + "|null" }
      }
      if rs == "" {
        const bal = litUnionAliasNameOfTy(t.fnRet)
        if bal != "" { rs = bal }
      }
      if rs == "" { rs = tyToEmitNameAt(t.fnRet, appKidCtx(ix, RC_FN_RES)) }
      if rs == "" { return "" }
      // A function-type RESULT keeps grouping parens so the outer `$fnsig` producers see a
      // single result token (`(i32)=>((i32)=>i32)`), matching the source-annotation form.
      const rt = T.tys[t.fnRet]
      if rt is TyFunc { rs = "(" + rs + ")" }
      // A function type is ONE atom: the params are parenthesized and everything after the
      // top-level `=>` belongs to the RESULT — the #516 rule `unionMemberCount` implements
      // by stopping at a top-level arrow, so `(i32)=>A|B` counts 1, not 2.
      emitNameAtoms = 1
      return out + ")=>" + rs
    }
    TyVar => {
      // An unsolved type PARAMETER has no name in the emitter's vocabulary — the
      // monomorphizer names the INSTANCE.
    }
    TyNeg => {
      // A RESIDUAL negation — `intersectTy` folds the rest — has no emitter name.
    }
    TyErr => {
      // The error/unknown hole has no emitter name; a rejected program never
      // reaches the emitter that would need one.
    }
  }
  // The empty arms above land here: "" is the renderer's "no emitter-classifiable
  // name", which `tyIsEmitRepresentable` predicts structurally arm-for-arm.
  ""
}

// The declared NAME of DECLARED-STRUCT arena index `ty` (`type S = {…}` → "S"), or "" when
// `ty` is not a registered declared struct. Reverse of `cUserTypes` via the parallel
// `cStructTyIxs`/`cStructNames` arrays — the struct analogue of `litUnionAliasNameOfTy`'s
// `cUnionTyIxs`/`cUnionNames` reverse map. First-match wins (a redeclared name overwrote
// `cUserTypes` in pass 0a, so both decls share the LAST arena index and either name is
// interchangeable). Used by `tyToNominalName` to render a nominal struct as its NAME.
export function structNameOfTy(ty: i32): string {
  if ty < 0 { return "" }
  let i = 0
  while i < cStructTyIxs.length {
    if cStructTyIxs[i] == ty { return cStructNames[i] }
    i = i + 1
  }
  ""
}

// The declared ALIAS NAME of DECLARED-UNION arena index `ty` (`type U = A | B` → "U",
// `type K = "a" | "b"` → "K"), or "" when `ty` is not a registered union alias — the
// index-match leg of `litUnionAliasNameOfTy`, generalized to VALUE unions (which are not
// litunions). Used by `tyToNominalName` to render a declared union alias by its name.
export function unionAliasDeclNameOfTy(ty: i32): string {
  if ty < 0 { return "" }
  let i = 0
  while i < cUnionTyIxs.length {
    if cUnionTyIxs[i] == ty { return cUnionNames[i] }
    i = i + 1
  }
  ""
}

// The GENERIC APPLICATION arena index `ty` was produced by, rendered nominally
// (`Box<i32>`, `Pair<i32,string>`), or "" when `ty` is not a recorded application — the
// third leg of the `structNameOfTy` / `unionAliasDeclNameOfTy` family, over the sidecar
// `applyGenAliasArgs` banks. First-match wins, exactly as on the two siblings; the memo
// there makes at most one row per index anyway.
//
// The ARGUMENTS render through `tyToNominalNameAt` in FIELD position, so a nested
// application (`Box<Box<i32>>`) spells in full and a declared struct argument keeps its
// own name. The ancestor stack inside that entry is what makes the recursion safe on a
// recursive alias — the cycle answers "" and this arm declines with it, rather than
// producing a half-name a consumer would key on.
//
// The separator is `,` with no space, which is the spelling `gaeArgsTextOf` cuts on and
// the one `canonEmitName` keeps — so an agreeing render is byte-equal, not merely
// equivalent.
// Does arena type `ix` REACH ITSELF — is its expansion CYCLIC?
//
// This is the guard the nominal short-circuit cannot do without. `type L<T> = {head: T,
// tail: L<T>[]}` applied at `i32` mints a `TyObj` whose `tail` element IS that very index,
// so the application has a perfectly finite nominal NAME (`L<i32>`) while its EXPANSION has
// none. `tyToNominalNameAt`'s ancestor stack discovers that by descending into the body; a
// head-first short-circuit returns before the descent and so never sees it, which silently
// clears `nomNameCycle` — the bank `guardFiniteUserTypes` rejects such a program from.
// Measured: without this guard all three `tests/cases/generics/recursive-generic-alias-*`
// fixtures move from master's clean reject to a compiler TRAP (a wasm backtrace), because
// the emitter is then handed a name whose shape it descends forever.
//
// A VISITED set (not a depth counter alone) is what makes this cheap: each reachable index
// is expanded once, so a shared sub-shape costs once and a cycle terminates on the revisit.
// The depth cap is a second belt for a pathologically deep acyclic type.
function tyReachesSelf(ix: i32): boolean {
  if ix < 0 { return false }
  const seen: i32[] = []
  tyReachesGo(ix, ix, seen, 0)
}

function tyReachesGo(cur: i32, target: i32, seen: i32[], depth: i32): boolean {
  if cur < 0 { return false }
  if depth > 64 { return false }
  const kids: i32[] = []
  tyChildrenOf(cur, kids)
  let i = 0
  while i < kids.length {
    const k = kids[i]
    if k == target { return true }
    if k >= 0 {
      let dup = false
      let j = 0
      while j < seen.length {
        if seen[j] == k { dup = true }
        j = j + 1
      }
      if !dup {
        seen.push(k)
        if tyReachesGo(k, target, seen, depth + 1) { return true }
      }
    }
    i = i + 1
  }
  false
}

// The DIRECT child type indices of arena entry `ix`, appended to `out`. The leaf
// constructors (`TyPrim`/`TyLit`/`TyVar`/`TyErr`) have none.
function tyChildrenOf(ix: i32, out: i32[]) {
  if ix < 0 { return 0 }
  const t = T.tys[ix]
  if t is TyArray {
    out.push(t.aElem)
    return 0
  }
  if t is TyNullable {
    out.push(t.nInner)
    return 0
  }
  if t is TyNeg {
    out.push(t.negTy)
    return 0
  }
  if t is TyUnion {
    const ms = t.uMembers
    let i = 0
    while i < ms.length {
      out.push(ms[i])
      i = i + 1
    }
    return 0
  }
  if t is TyObj {
    const fs = t.objFieldTypes
    let i = 0
    while i < fs.length {
      out.push(fs[i])
      i = i + 1
    }
    return 0
  }
  if t is TyFunc {
    const ps = t.fnParamTypes
    let i = 0
    while i < ps.length {
      out.push(ps[i])
      i = i + 1
    }
    out.push(t.fnRet)
    return 0
  }
  if t is TyMap {
    out.push(t.mKey)
    out.push(t.mVal)
    return 0
  }
  0
}

export function genAppNameOfTy(ty: i32): string {
  if ty < 0 { return "" }
  let i = 0
  while i < gaAppTyIxs.length {
    if gaAppTyIxs[i] == ty {
      // CYCLIC EXPANSION: decline, so the caller descends and the cycle bank fills exactly
      // as it did before this arm existed. Memoized per row (`-1` unknown / `0` cyclic /
      // `1` finite) — the answer cannot change once `applyGenAliasArgs` has filled the
      // shape, and every read of this map happens after that.
      if gaAppFinite[i] < 0 {
        if tyReachesSelf(ty) { gaAppFinite[i] = 0 } else { gaAppFinite[i] = 1 }
      }
      if gaAppFinite[i] == 0 { return "" }
      const st = gaAppArgStart[i]
      const cn = gaAppArgCount[i]
      // A zero-argument row cannot arise (`applyGenAliasArgs` rejects an arity mismatch
      // before the memo, and a declared generic has at least one parameter), but a head
      // with no arguments would render `Box<>` — not a spelling anything can resolve. Bail
      // to "" so the caller keeps whatever route it had.
      if cn <= 0 { return "" }
      let s = ""
      let a = 0
      while a < cn {
        // `RC_ROOT`, WORD FOR WORD THE RULE CANON'S OWN APPLICATION ARM STATES: *"an
        // ARGUMENT stands where the parameter it binds stands, which is a position this
        // rewrite has no way to know — `RC_ROOT` is what every other whole-annotation entry
        // uses and what the argument text arrived carrying"*. This arm said `RC_FIELD`, and
        // while nothing read the bit the two spellings could not disagree; the inline
        // litunion leg reads it, and `Box<"a=>b"|"zz">` promptly SPLIT — canon softening the
        // argument at `RC_ROOT` to `Box<string>` while this renderer kept it at the
        // `RC_FIELD` keep position. One arena type, two names, which is the fragmentation
        // both producers' preserve rules exist to remove. (`ctx` reaches nothing else in
        // this renderer but the sticky `RC_NULLABLE` bit, which neither constant carries —
        // so the change is inert everywhere the new leg does not fire, and that is
        // measured, not argued: see the `garoot` control in the programme doc.)
        const an = tyToNominalNameAt(gaAppArgFlat[st + a], RC_ROOT)
        // An argument with no nominal name (a TyVar — an UNINSTANTIATED `Box<T>` inside the
        // alias's own body — or a cycle) makes the whole application unspellable. Decline
        // rather than emit `Box<>` or a partial name.
        if an == "" { return "" }
        if a > 0 { s = s + "," }
        s = s + an
        a = a + 1
      }
      // The application is ONE top-level atom, whatever the recursion left in the bank.
      nomNameAtoms = 1
      return gaAppHeads[i] + "<" + s + ">"
    }
    i = i + 1
  }
  ""
}

// NAME-FAITHFUL renderer (rep-adoption name-faithful-renderer slice). Like `tyToEmitName`,
// but NOMINAL-FIRST: a TyObj that IS a registered declared struct renders as its NAME (via
// `structNameOfTy`) and a TyUnion that IS a registered declared union alias renders as its
// alias name (via `unionAliasDeclNameOfTy`), rather than the structural `{…}` / `A|B`
// expansion `tyToEmitName` always produces. So an ARENA walk that renders each reachable
// union with THIS function reproduces the name walk's exact `registerInlineUnion` keys — a
// declared struct/union keeps the name the source annotation spelled (`tyNameOf`), never a
// structural twin that a nominal `structIndexByName`/`isUName` lookup can't resolve. Litunion
// aliases, nullable spelling, and grouping-paren preservation are inherited from `tyToEmitName`'s
// arms (recursing into `tyToNominalName` for composites). Nominal-first ALSO tames recursion: a
// named recursive struct (`type Tree = {children: Tree[]}`) short-circuits to "Tree" before its
// self-referential field re-enters. NOTHING consumes this in emitted output yet — it is a
// byte-identical foundation for the (deferred) arena registration walk.
// The TOP-LEVEL atom width of the name the LAST `tyToNominalName` call returned — the
// nominal renderer's `emitNameAtoms`, produced BY the renderer instead of re-derived by
// scanning the finished string. Same invariant as its structural sibling: a rendered name
// gains a top-level `|` at exactly two places (the union arm's join and the nullable arm's
// `|null` suffix), and every other arm builds a name whose separators sit inside a grouper
// or behind a top-level `=>` — ONE atom.
//
// It exists so `arrElemRender` — the ONE array-grouping home all three renderers share —
// can be told the element's width instead of scanning the element name for a top-level
// `|` (the display renderer's bank is `tyStrAtoms`, the third of the set). That
// site could not convert while only ONE of the two renderers banked a width (#1191's
// hand-off names exactly this gap: "only one of them covers `tyToNominalName`, which has no
// bank at all").
//
// Not an arena-lifetime sidecar (method note 7): a scalar written on the way out of every
// non-empty return and read by the immediate caller, never carried between programs.
let nomNameAtoms = 1

// The ANCESTOR stack of the nominal render in progress — `emitNameSeen`'s twin, O1 of the
// one-agreed-renderer design. Nominal-first tames a DECLARED recursive struct by
// short-circuiting to its name, but NOT a recursive GENERIC alias: `applyGenAlias` memoizes
// each instance under a key and registers a placeholder before resolving the fields, so
// `type L<T> = { head: T, tail: L<T> | null }` resolves to a genuinely CYCLIC arena entry
// that is anonymous — in neither `cStructTyIxs` nor `cUnionTyIxs` — and nothing stops the
// descent. Without this the render exhausts the call stack and TRAPS the compiler.
//
// Push/pop balanced around the recursive entry, so it holds ANCESTORS only: a type that
// mentions one shape TWICE as siblings still renders both. Not an arena-lifetime sidecar
// (method note 7): empty on entry and on exit of every top-level call, by that balance.
const nomNameSeen: i32[] = []

// TRUE when the last top-level `tyToNominalName` was CUT by the ancestor stack above — the
// producer-supplied bank that makes the cut observable, in the shape `nomNameAtoms` and
// `emitNameAtoms` already use. "" alone cannot carry it: this renderer returns "" for a
// TyVar, for `never` and for any arm it has no name for, none of which is a cycle, so a
// caller testing the string would reject every generic alias in the program.
let nomNameCycle = false

// THE POSITION-FREE ENTRY, exactly as on the structural sibling: every caller outside this
// renderer (`emit_collect.vl`'s registration walk) asks about a type standing on its own.
// The cycle bank is per top-level render, so it resets here rather than in the recursion.
export function tyToNominalName(ix: i32): string {
  nomNameCycle = false
  tyToNominalNameAt(ix, RC_ROOT)
}

// Did the LAST `tyToNominalName` hit a cycle — i.e. does that type have no finite nominal
// name at all? Read by `emit_collect.vl`'s `guardFiniteUserTypes`, which rejects such a
// program by name instead of letting any renderer trap on it.
export function tyNomNameCycled(): boolean { nomNameCycle }

// O1 IS DISCHARGED HERE, with the caller that makes it reachable in the same change
// (`guardFiniteUserTypes`). The reject that used to hide this guard was driven by a
// hand-written SECOND COPY of this function's descent — same nominal short-circuits, same
// composite arms, a path stack in place of the concatenation — whose own header said it
// "mirrors `tyToNominalName`'s descent exactly, minus the string building". Two copies of a
// walk are two things to keep in step; the walk now answers the question itself.
function tyToNominalNameAt(ix: i32, ctx: i32): string {
  nomNameAtoms = 1
  if ix < 0 { return "" }
  let si = 0
  while si < nomNameSeen.length {
    if nomNameSeen[si] == ix {
      nomNameAtoms = 1
      nomNameCycle = true
      return ""
    }
    si = si + 1
  }
  nomNameSeen.push(ix)
  const r = tyToNominalNameGo(ix, ctx)
  nomNameSeen.pop()
  r
}

function tyToNominalNameGo(ix: i32, ctx: i32): string {
  nomNameAtoms = 1
  if ix < 0 { return "" }
  // NOMINAL-FIRST: a declared struct or union alias renders as its NAME — one identifier,
  // so one atom (the reset above).
  const sdn = structNameOfTy(ix)
  if sdn != "" { return sdn }
  // …and a GENERIC APPLICATION renders as the application (`Box<i32>`), which is equally
  // nominal: the head is a declared name and the arguments render nominally under it.
  // Ahead of the union arm for the same reason `structNameOfTy` is — an application
  // expands to a `TyObj`/`TyUnion` whose structural render is exactly the expansion this
  // renderer exists to avoid producing. Declines ("") for an uninstantiated or cyclic
  // argument, so every shape that had no nominal route before still takes its old one.
  const gan = genAppNameOfTy(ix)
  if gan != "" { return gan }
  const udn = unionAliasDeclNameOfTy(ix)
  if udn != "" {
    // …EXCEPT a declared alias for a NUMERIC literal union (`type Z = 0 | 1`, the
    // one-member `type One = 1`, the alias-of-an-alias `type Y = Z`), which denotes its
    // BASE SCALAR — `i32` / `i64` / `f64`, never the alias name. The name is not a
    // spelling the emitter's vocabulary can classify: `collectU` registers such a decl in
    // `unNames` (a `UnionDecl` whose single variant is not a `{…}` shape is not skipped),
    // so `isUName` claims the annotation for the `{tag, value}` UNION BOX while every READ
    // of the value lowers as the plain scalar the checker's algebra says it is — the silent
    // invalid wasm `numLitUnionAliasName` was written against
    // (`tests/cases/literal-unions/numeric-litunion-alias.vl`).
    //
    // ONE RULE, ONE HOME, TWO ENTRIES. `canonEmitName` reaches it through the NAME-keyed
    // `numLitUnionAliasName` (a `cUserTypes` lookup, then this); the renderer reaches it
    // through the arena index it is already holding. So the two producers cannot drift, and
    // the renderer takes the destringified route — no name, no second parse.
    //
    // UNCONDITIONAL IN THE POSITION, INCLUDING INSIDE A FUNCTION TYPE, and #1271's
    // `RC_UNDER_FUNC` gate on exactly this arm is the thing that came out to make it so.
    // The gate said "not under a function type — that region is `canonEmitName`'s VERBATIM
    // region"; `canonEmitNameAt`'s function-type arm no longer HAS a verbatim region, so
    // the alias softens on both sides of every `$fnsig` fork instead of on neither. See
    // the position-bit note above for the measurement.
    // THE STRING-LITUNION TWIN OF THIS ARM IS THE OWNER'S 2026-07-28 SOFTEN, AND IT IS
    // BLOCKED HERE BY A DEFECT THAT IS NOT THIS RULE'S. `tyToEmitNameGo`'s union arm now
    // spells a string-litunion ALIAS member `string`; the same soften belongs on this
    // renderer, and the shape it takes is this short-circuit gaining
    // `if (ctx & RC_UNION_MEM) != 0 && tyIsLitUnion(ix) { fall through }`. Built and
    // measured: it takes B2's Lsoft class from 56 rows to 0 and B3's from 58 to 2 — and it
    // makes ONE fuzz shape in 6,000 stop compiling, because `IsExpr.isVariant` is not in
    // the emitter's vocabulary and master's DUPLICATE variant row was hiding that:
    //
    //   type K0 = "080" | "lp" | "hp"                              // fuzz seed 1000003 d6,
    //   const v: ((i32) => {f: K0 | i64} | string)[] = [(q0) => ({f: 5000000077})]
    //   const t0 = v[0](1)                                         // case_00039
    //   if t0 is {f: K0 | i64} { … }
    //   // master: registers BOTH `{f:K0|i64}` (this render) and `{f:string|i64}` (the
    //   // canon'd annotation) as variants, and the `is` spelling matches the first.
    //   // With the soften: one row, `{f:string|i64}`, and the raw `is` spelling matches
    //   // nothing → `emitProgram: `is` names a type that is not a union variant`.
    //
    // `canonEmitTypeNames`'s `IsExpr` arm rewrites `isVariant` for a union operand through
    // TWO partial pieces of canon already (`unionMemberGenAppShape`, the transparency
    // render); the completion is to canon the whole spelling. That was built too, and it is
    // NOT a small gate: `canonEmitNameAt(isVariant, RC_ROOT)` softens a bare string LITERAL
    // test as well (`is "lhrf"` → `is string`), and past a `tyIsLitUnion` /
    // `numLitUnionBaseName` / `tyIsNullableLitUnion` guard it still reddens four corpus
    // files, one of them a WRONG ANSWER (`soundness/literal-is-runtime-value.vl`, RUNOUT).
    // So the `is` spelling needs its own slice — most likely rendering the checker's banked
    // `isVarTyIxOf` type rather than growing a fourth exclusion — and this arm waits for it.
    // Until then this renderer stays SOURCE-FAITHFUL and the two producers agree on B1's
    // axis only.
    const nlb = numLitUnionBaseName(ix)
    if nlb != "" { return nlb }
    return udn
  }
  const t = T.tys[ix]
  // EXHAUSTIVE over `Ty` and deliberately `_`-less: a 12th arena variant breaks the
  // self-compile here instead of silently rendering "" = "no nominal name".
  match t {
    TyPrim => {
      if t.primName == "never" { return "" }
      return t.primName
    }
    TyLit => {
      // A LITERAL renders as its base scalar, at the ONE home that answers that (see
      // `tyLitBaseName`) — this arm and its twin in the other renderer were two of the three
      // hand-written copies of `litBaseTy`'s four-way rule.
      return tyLitBaseName(t)
    }
    TyUnion => {
      const members = t.uMembers
      // THE PURE INLINE LITERAL UNION KEEPS ITS MEMBERS — the structural sibling's leg,
      // character for character, and it must be: the two renderers and canon spell one arena
      // type one way or the name-keyed registries hold a row per spelling. See the twin in
      // `tyToEmitNameGo` for the two gates and why they are canon's rungs rather than a new
      // policy.
      const luiN = litUnionInlineNameOfTy(ix)
      if luiN != "" {
        if luiHasNull {
          nomNameAtoms = luiAtoms + 1
          return luiN + "|null"
        }
        if ctxKeepsLitUnion(ctx) {
          nomNameAtoms = luiAtoms
          return luiN
        }
      }
      // SOURCE-FAITHFUL (alias-preserving) render: a litunion-ALIAS member keeps its alias
      // name (`K0` in `K0 | {w:i32}`), reconstructing a flattened lit run into its registered
      // alias via the regroup. The POSITION-DEPENDENT litunion softening (`canonEmitName`
      // softens `K0` in a DIRECT union but keeps it inside a closure RESULT) is NOT
      // re-implemented here — a consumer applies `canonEmitName` once over the WHOLE rendered
      // name, where the func-type structure is visible; softening per-arm in isolation would
      // lose that context. So this arm produces exactly the source spelling the name walk
      // started from, and `canonEmitName(render)` reproduces the name walk's key.
      //
      // IT NO LONGER MIRRORS `tyToEmitNameGo`'s UNION ARM, AND THAT IS RECORDED RATHER THAN
      // TIDIED. That arm lost both of these legs to the owner's 2026-07-28 mixed-union
      // soften; this one keeps them because the SOURCE-FAITHFUL property is load-bearing for
      // one consumer that the ruling did not reach — see the blocked-soften note on the
      // `unionAliasDeclNameOfTy` short-circuit above, which carries the fuzz shape, the two
      // measured fix attempts and what the next slice has to do first.
      let rgAlias = ""
      const rgTexts: string[] = []
      let rgNonLit = false
      let rg = 0
      while rg < members.length {
        const rm = T.tys[members[rg]]
        if rm is TyLit {
          if rm.litKind == "str" { rgTexts.push(rm.litText) }
        } else {
          let rmNull = false
          if rm is TyPrim {
            if rm.primName == "null" { rmNull = true }
          }
          if !rmNull { rgNonLit = true }
        }
        rg = rg + 1
      }
      if rgNonLit && rgTexts.length >= 2 {
        rgAlias = litUnionAliasOfLitTexts(rgTexts)
      }
      const parts: string[] = []
      // The KEPT parts' widths, SUMMED — not `parts.length`. The join below writes exactly one
      // top-level `|` per part boundary, but a PART is not always one atom (a nullable member
      // renders `X|null`), and a DUPLICATE part contributes nothing at all.
      let psum = 0
      let rgDone = false
      let i = 0
      while i < members.length {
        const rgm = T.tys[members[i]]
        if rgAlias != "" && rgm is TyLit {
          if !rgDone {
            rgDone = true
            parts.push(rgAlias)
            psum = psum + 1
          }
          i = i + 1
          continue
        }
        // An ALIAS name is one identifier — one atom. Only the RENDER leg can be wider, and
        // it reports its own width in `nomNameAtoms`.
        let sc = 1
        let s = litUnionAliasNameOfTy(members[i])
        if s == "" {
          // The union-member position, with the sticky nullable bit — the same rule the
          // structural sibling applies, so the two agree about `A|B|null`.
          s = tyToNominalNameAt(members[i], RC_UNION_MEM | (ctx & RC_NULLABLE))
          sc = nomNameAtoms
        }
        if s == "" { return "" }
        // The grouping parens put every separator inside a grouper — one atom again.
        if rgm is TyFunc {
          s = "(" + s + ")"
          sc = 1
        }
        let dup = false
        let j = 0
        while j < parts.length {
          if parts[j] == s { dup = true }
          j = j + 1
        }
        if !dup {
          parts.push(s)
          psum = psum + sc
        }
        i = i + 1
      }
      if parts.length == 0 { return "" }
      let out = parts[0]
      let k = 1
      while k < parts.length {
        out = out + "|" + parts[k]
        k = k + 1
      }
      nomNameAtoms = psum
      return out
    }
    TyNullable => {
      const nal = litUnionAliasNameOfTy(t.nInner)
      if nal != "" {
        // An alias identifier plus the `null` arm — two atoms.
        nomNameAtoms = 2
        return nal + "|null"
      }
      // …and an UN-ALIASED one keeps its MEMBERS at every position — `nulLitUnionPreserve`'s
      // mirror, the structural sibling's leg.
      const nlui = litUnionInlineNameOfTy(t.nInner)
      if nlui != "" {
        nomNameAtoms = luiAtoms + 1
        return nlui + "|null"
      }
      // A nullable DECLARED struct/union keeps its nominal name (`S|null`, `U|null`).
      const nsn = tyToNominalNameAt(t.nInner, RC_NULLABLE)
      const nsnAtoms = nomNameAtoms
      if nsn == "" { return "" }
      const nfn = T.tys[t.nInner]
      if nfn is TyFunc {
        // The grouped closure is one atom; `null` is the second.
        nomNameAtoms = 2
        return "(" + nsn + ")|null"
      }
      // A union INNER keeps its own top-level `|`s (`A|B|null`), so the `null` arm ADDS to the
      // inner render's width rather than making the whole name two atoms.
      nomNameAtoms = nsnAtoms + 1
      return nsn + "|null"
    }
    TyObj => {
      const names = t.objFieldNames
      const ftys = t.objFieldTypes
      let out = "{"
      let fi = 0
      while fi < names.length {
        let fs = ""
        const ftn = T.tys[ftys[fi]]
        if ftn is TyNullable {
          const fal = litUnionAliasNameOfTy(ftn.nInner)
          if fal != "" { fs = fal + "|null" }
        }
        if fs == "" {
          const fbal = litUnionAliasNameOfTy(ftys[fi])
          if fbal != "" { fs = fbal }
        }
        if fs == "" { fs = tyToNominalNameAt(ftys[fi], RC_FIELD) }
        if fs == "" { return "" }
        if fi > 0 { out = out + "," }
        out = out + names[fi] + ":" + fs
        fi = fi + 1
      }
      // Every field separator sits inside the braces — ONE atom. Set rather than inherited:
      // the field renders above left `nomNameAtoms` holding the last field's width.
      nomNameAtoms = 1
      return out + "}"
    }
    TyArray => {
      let el = litUnionAliasNameOfTy(t.aElem)
      // The ELEMENT's own atom WIDTH, as the element's producer reported it — an alias
      // identifier is one atom, the render leg reports its own.
      let elw = 1
      if el == "" {
        el = tyToNominalNameAt(t.aElem, RC_ELEM)
        elw = nomNameAtoms
      }
      if el == "" { return "" }
      // A list name is ONE atom in every form — a union element is parenthesized precisely so
      // its `|`s stop being top-level. Set rather than inherited: the element recursion left
      // the ELEMENT's width in `nomNameAtoms`.
      nomNameAtoms = 1
      return arrElemRender(el, t.aElem, elw)
    }
    TyMap => {
      const mk = tyToNominalNameAt(t.mKey, RC_MAP_KEY)
      let mv = litUnionAliasNameOfTy(t.mVal)
      if mv == "" { mv = tyToNominalNameAt(t.mVal, RC_MAP_VAL) }
      if mk == "" || mv == "" { return "" }
      // The key/value separators sit inside the braces — one atom.
      nomNameAtoms = 1
      return "{[" + mk + "]:" + mv + "}"
    }
    TyFunc => {
      const ps = t.fnParamTypes
      let out = "("
      let i = 0
      while i < ps.length {
        const ps1 = tyToNominalNameAt(ps[i], RC_FN_PARAM)
        if ps1 == "" { return "" }
        if i > 0 { out = out + "," }
        out = out + ps1
        i = i + 1
      }
      let rs = ""
      const rtn = T.tys[t.fnRet]
      if rtn is TyNullable {
        const nal = litUnionAliasNameOfTy(rtn.nInner)
        if nal != "" { rs = nal + "|null" }
      }
      if rs == "" {
        const bal = litUnionAliasNameOfTy(t.fnRet)
        if bal != "" { rs = bal }
      }
      if rs == "" { rs = tyToNominalNameAt(t.fnRet, RC_FN_RES) }
      if rs == "" { return "" }
      const rt = T.tys[t.fnRet]
      if rt is TyFunc { rs = "(" + rs + ")" }
      // A function type is ONE atom: the params are parenthesized and everything after the
      // top-level `=>` belongs to the RESULT. Set rather than inherited: the param/result
      // renders above left their own widths behind.
      nomNameAtoms = 1
      return out + ")=>" + rs
    }
    TyVar => {
      // An unsolved type PARAMETER has no nominal spelling.
    }
    TyNeg => {
      // A RESIDUAL negation has no nominal spelling.
    }
    TyErr => {
      // The error/unknown hole has no nominal spelling.
    }
  }
  // The three empty arms above land here: "" is this renderer's "no nominal name",
  // the same sentinel `tyToEmitNameGo` uses.
  ""
}

// Canonicalize one inline `{…}` shape name (an object `{f:T,…}` or a map
// `{[K]:V}`): each field/key/value type recurses through `canonEmitName`, the
// surrounding structure is rebuilt with the parser's exact conventions (no
// spaces), so a shape with no literal field is reproduced byte-identical.
//
// Takes no `ctx` of its own and needs none: it OVERRIDES the position for everything it
// recurses into. A field is a field and a map value is a map value whatever the shape
// itself is standing in, so the shape's own position never reaches a child.
function canonShapeName(name: string) {
  // A map `{[K]:V}` — the OPEN, the key-end WALK and the two CUTS are the MAP-NAME
  // grammar's, at its home. This ran the same `tyGroupEndIndex` walk over the shape's
  // INTERIOR and then re-derived both slices from the interior's coordinates; the home
  // walks the whole name, so the `± 1` bookkeeping goes with the copy. The caller has
  // already established the closing `}` this shape needs (`canonEmitNameAt`'s brace arm),
  // which is what makes `mapSpellValName`'s span gate a no-op here rather than a narrowing.
  if mapSpellKeyEnd(name) >= 0 {
    return "{[" +
      canonEmitNameAt(mapSpellKeyName(name), RC_MAP_KEY) +
      "]:" +
      canonEmitNameAt(mapSpellValName(name), RC_MAP_VAL) +
      "}"
  }
  // The `{…}` SHAPE BODY, cut at the group-interior home (`tyname.groupInnerOf`, W1).
  // The guard is the CALLER's (`canonEmitNameAt`'s brace arm has already established the
  // closing `}`) — a fifth guard shape among the family's sites.
  const inner = groupInnerOf(name)
  // A `{[`-opening name whose key never closes into a `]:` is not a map and not an object
  // shape either — returned untouched, exactly as the copy's inner `kend < 0` arm did.
  if nameIsMapOpen(name) { return name }
  // An object shape `{f:T,…}`: split the interior at its top-level commas, canon
  // each field's type past its first top-level `:`.
  let out = "{"
  let start = 0
  let going = true
  while going {
    let end = tyTopIndexOf(inner, ',', 0, start)
    if end < 0 {
      end = inner.length
      going = false
    }
    const field = inner.slice(start, end)
    const colonAt = tyTopIndexOf(field, ':', 0, 0)
    if start > 0 { out = out + "," }
    if colonAt >= 0 {
      // The FIELD-COLON cut at its home (`tyname.fieldNameOf` / `fieldTypeTextOf`, W14) —
      // and THIS is the writing that keeps the DELIMITER. Rebuilding the shape text needs
      // the `:` back, so the name half is taken at `colonAt + 1`: the same home at a
      // different index, which is exactly why the index is a parameter rather than a `+ 1`
      // baked into the body. (W1 lost a site to this endpoint-normalisation trap twice.)
      out = out +
        fieldNameOf(field, colonAt + 1) +
        canonEmitNameAt(fieldTypeTextOf(field, colonAt), RC_FIELD)
    } else {
      out = out + field
    }
    start = end + 1
  }
  out + "}"
}

// Rewrite one synthetic annotation name into the emitter's vocabulary (see the
// block comment above). Structure-preserving: only literal members, `&` folds
// and whole-name parens change; any name without those constructs is returned
// byte-identical (the `nameNeedsCanon` fast path).
// If `name` is a declared UNION ALIAS (`type AB = A | B`), its flattened member-set emit name
// (`"A|B"`); "" for a struct alias / primitive / generic / unknown (which keep their own name).
// `canonEmitName` uses this to FLATTEN a union-alias member of an OUTER union — `AB | null`
// canonicalizes to `A | B | null`, the same name the inline `(A | B) | null` produces, which
// the emitter's union machinery recognizes (an un-expanded alias name is not a union name, so
// `AB | null` otherwise fell through to the i32-local default — "only i32 locals are supported").
function unionAliasMembers(name: string) {
  const ix = cUserTypes[name] ?? -1
  if ix < 0 { return "" }
  const t = T.tys[ix]
  if t is TyUnion { return tyToEmitName(ix) }
  ""
}

// True if the one-member alias BODY at SPELLING ROOT `root` is a bare type NAME (`Cat`,
// `i32`, `null`) or a generic APPLICATION (`Box<i32>`, `Pair<i32,string>`) — the two
// spellings that make `type N = …` a plain alias REFERENCE. Everything else a one-member
// `UnionDecl` can carry is excluded, and each exclusion is load-bearing: an inline shape /
// object INTERSECTION (`{a:i32}&{b:i32}`, `A & B`) must keep its alias name (the emitter
// interns it as a named struct through `unionStructAliasShape` — expanding it would lose
// that registration), while a list / map / function-type / literal body (`i32[]`,
// `(i32) => i32`) is left exactly as master had it (those are rejected in the CHECKER
// today — a clean error, not a miscompile — so widening them is a separate change with its
// own evidence).
//
// **THIS ASKS THE PARSER, NOT THE STRING (D-ALIASREF).** It was a hand-written
// identifier-RUN scanner over the member's rendered spelling — 13 character-grammar tests,
// the largest single block of them left in this file — that re-derived "bare identifier, or
// identifier then `<…>` closing the whole spelling" from characters the parser had just
// concatenated. `parseVariantName` banks each member's spelling ROOT on the `UnionDecl`
// (D-PARSETY P2, `udTsRootAt`), so the question is one array read of what the parser
// actually saw. The owner's rule names this exact shape: *a name is a name, but a parsable
// type? no.*
//
// **`TS_NULL` is in the accepted set, and that is the routing being EXACT rather than a
// tightening dressed as a dedup.** `type X = null` renders as the four identifier
// characters `null`, so the character scanner could not tell it from a type NAME and
// answered true; the tree can, and answers `TS_NULL`. Dropping it here would silently make
// one alias shape opaque — the pass-0a lesson from D-BRACEDOWN, in the other direction.
// (`TS_ERR` is NOT accepted: its spelling is `""`, which the scanner's `length == 0` guard
// already rejected, so the two agree.)
//
// A root of -1 (`tsPop` on an empty stack) answers false. Every arm of `parseTypeAtom`
// finishes a node — including its `expect("IDENT")` recovery arm, which pushes `TS_ERR`
// precisely so a malformed annotation still leaves exactly one root — so this is
// unreachable from the parser as written, and measured 0/1,502 on the corpus; false is the
// conservative answer either way (an alias that is not transparent is the pre-D-PARSETY
// default and cannot mis-resolve a program that compiles).
function aliasRefIsPlainRoot(root: i32) {
  if root < 0 { return false }
  const k = tsKind[root]
  k == TS_NAME || k == TS_APP || k == TS_NULL
}

// ── flat record layouts (webcraft P1.2) ─────────────────────────────────────
// The whole feature is these functions plus one interception at the top of
// `checkMemberNode`. Nothing in `emit_*.vl` changes: a `flat` type is an ORDINARY
// record that has additionally been validated and measured (the marker subtracts
// nothing), and the layout constants are folded into `NumLit` nodes IN THE ARENA
// before the emitter runs — so there is no `Member` node left to lower and no flat
// type left to recognize. `docs/internals/flat-records-design.md`.

// `flSizes[d]` sentinels. Negative so they can never collide with a real size
// (which is a sum of non-negative widths).
const FL_UNRESOLVED = -1
const FL_INVALID = -2

// The index of `name` in the flat-layout sidecar, or -1 if it was not declared
// `flat type name = { … }`.
function flatIndexOf(name: string) {
  let i = 0
  while i < flNames.length {
    if flNames[i] == name { return i }
    i = i + 1
  }
  -1
}

// The byte width of a SCALAR flat field type, or -1 for anything else.
//
// This reads the RESOLVED arena type rather than the field's spelling, which is
// what makes a nominal newtype over a scalar (`type EntityId = new i32`) work with
// no code for it: a brand is a second index over the SAME `Ty` payload, so
// `is TyPrim` and `primName` answer exactly as the base answers
// (`newtype-design.md` §3.1).
//
// `boolean` is deliberately ABSENT. It is an i32 at the wasm level, so 4 would be
// the consistent answer — but C's `bool` is 1 byte, and this tier exists to match
// foreign layouts byte-for-byte, so a `boolean` field silently occupying 4 is a
// 3-byte drift in exactly the code whose value is byte-comparability. `flag: i32`
// is a one-word fix and the reject says so. Widening a reject later is
// backward-compatible; narrowing an accept is not.
function flatScalarWidth(tyIx: i32) {
  if tyIx < 0 { return -1 }
  const t = T.tys[tyIx]
  if t is TyPrim {
    if t.primName == "i32" { return 4 }
    if t.primName == "f32" { return 4 }
    if t.primName == "i64" { return 8 }
    if t.primName == "f64" { return 8 }
  }
  -1
}

// The declared type SPELLING of a `FieldDef`'s annotation, or "" when it has none.
// The nested-record test is the one question that must be asked of the spelling
// rather than the arena: a resolved `TyObj` does not carry the name it was declared
// under, so it cannot say whether the record it describes was declared `flat`.
function flatFieldTyName(fdIx: i32) {
  if fdIx < 0 { return "" }
  const fd = P.nodes[fdIx]
  if fd is FieldDef {
    if fd.fdType >= 0 {
      const tr = P.nodes[fd.fdType]
      if tr is TypeRef { return tr.tyName }
    }
  }
  ""
}

// Measure every `flat type` in the program. Runs after the declaration passes have
// filled each record's field types, so scalars can be read off the arena.
//
// TWO PHASES, and they are separate so that an INVALID declaration is never also
// reported as a RECURSIVE one:
//   A. validate + stage each declaration's fields (scalars get a width now, a
//      nested flat record is deferred);
//   B. a fixpoint over the staged declarations, resolving a record once every
//      nested record it contains has resolved. Anything still unresolved when the
//      fixpoint stops making progress is part of a CYCLE — an infinite layout —
//      and is reported by name rather than hung on.
function resolveFlatLayouts(stmts: i32[]) {
  // ── phase A: validate and stage ───────────────────────────────────────────
  // Two sweeps, because a flat record may nest one DECLARED LATER in the source:
  // register every flat name first, then validate fields against the full set.
  let ri = 0
  while ri < stmts.length {
    const sd = P.nodes[stmts[ri]]
    if sd is TypeDecl {
      if sd.tdFlat == 1 {
        // A GENERIC flat type has no layout: a type parameter has no width, and
        // there is no instantiation to measure at a declaration. Rejected here
        // rather than staged, so it never enters the sidecar and `Box<T>.size`
        // stays an ordinary undeclared-identifier error.
        // "Is this declaration generic" is the PARSER's fact (D-DECLPARAM): the
        // bank exists iff a `<` followed the declared name, which is exactly what
        // the `gaeLtAt(…) > 0` scan of the folded name answered.
        if declGpBaseOf(stmts[ri]) != "" {
          tErr(
            "a `flat` type cannot be generic — `" +
              sd.tdName +
              "` has type parameters, which have no byte width",
            stmts[ri],
          )
        } else if flatIndexOf(sd.tdName) < 0 {
          flNames.push(sd.tdName)
          flSizes.push(FL_UNRESOLVED)
          flFStart.push(0)
          flFCount.push(0)
          flDeclNodes.push(stmts[ri])
        }
      }
    }
    ri = ri + 1
  }
  let si = 0
  while si < stmts.length {
    const sd2 = P.nodes[stmts[si]]
    if sd2 is TypeDecl {
      if sd2.tdFlat == 1 {
        const d = flatIndexOf(sd2.tdName)
        if d >= 0 && flFCount[d] == 0 { flatStageDecl(d, sd2) }
      }
    }
    si = si + 1
  }
  // ── phase B: size the nest, by fixpoint ───────────────────────────────────
  let progress = true
  while progress {
    progress = false
    let d2 = 0
    while d2 < flNames.length {
      if flSizes[d2] == FL_UNRESOLVED {
        if flatTrySize(d2) { progress = true }
      }
      d2 = d2 + 1
    }
  }
  // Whatever is still unresolved cannot be sized at any depth: every remaining
  // declaration is waiting on another remaining declaration, which is a cycle.
  let d3 = 0
  while d3 < flNames.length {
    if flSizes[d3] == FL_UNRESOLVED {
      tErr(
        "`flat type " +
          flNames[d3] +
          "` is recursive — a flat record is stored INLINE, so a cycle has no " +
          "finite size",
        flDeclNodes[d3],
      )
      flSizes[d3] = FL_INVALID
    }
    d3 = d3 + 1
  }
  0
}

// Validate one flat declaration's fields and stage their widths. Every rejected
// field marks the whole declaration INVALID, so a later `N.size` reports nothing
// (the field error is the actionable one) and phase B never reports a cycle for it.
function flatStageDecl(d: i32, sd: TypeDecl) {
  const declTyIx = cUserTypes[sd.tdName] ?? -1
  const dfields = sd.tdFields
  flFStart[d] = flFNames.length
  let bad = false
  let fi = 0
  while fi < dfields.length {
    const fd = P.nodes[dfields[fi]]
    if fd is FieldDef {
      const fname = fd.fdName
      // `N.size` is the record's TOTAL SIZE, so a field of that name makes the
      // spelling ambiguous. Rejected rather than resolved either way: "field
      // wins" hides the record's size behind a field, "size wins" hides a
      // field's offset, and both are silent wrong answers in address arithmetic.
      if fname == "size" {
        tErr(
          "a `flat` type cannot have a field named 'size' — that spelling is " +
            "the record's total byte size (`" +
            sd.tdName +
            ".size`); rename the field",
          dfields[fi],
        )
        bad = true
      }
      const fty = flatFieldTyOf(declTyIx, fi)
      const w = flatScalarWidth(fty)
      if w > 0 {
        flFNames.push(fname)
        flFWidth.push(w)
        flFNest.push(-1)
        flFOff.push(0)
      } else {
        const nest = flatIndexOf(flatFieldTyName(dfields[fi]))
        if nest >= 0 {
          // A nested flat record INLINES: its bytes sit at the offset the running
          // sum has reached, and reaching one of ITS fields is `Outer.k + Inner.a`
          // — which is why the constant surface needs only one level of access.
          flFNames.push(fname)
          flFWidth.push(-1)
          flFNest.push(nest)
          flFOff.push(0)
        } else {
          // A field whose type failed to resolve at all was already reported by
          // the declaration pass; do not cascade a second message onto it.
          if !flatTyAlreadyErrored(fty) {
            tErr(
              "field '" +
                fname +
                "' cannot be in a `flat` type: " +
                flatWhyNot(fty, flatFieldTyName(dfields[fi])) +
                " — a flat field must be i32/i64/f32/f64, a newtype over one of " +
                "those, or another `flat` type",
              dfields[fi],
            )
          }
          bad = true
        }
      }
    }
    fi = fi + 1
  }
  flFCount[d] = flFNames.length - flFStart[d]
  if bad { flSizes[d] = FL_INVALID }
  0
}

// The resolved arena type of field `fi` of the record registered at `declTyIx`.
// The declaration pass pushed field types in declaration order into the SAME
// arrays the placeholder holds, so the index lines up with `tdFields`.
function flatFieldTyOf(declTyIx: i32, fi: i32) {
  if declTyIx < 0 { return -1 }
  const pt = T.tys[declTyIx]
  if pt is TyObj {
    const ftys = pt.objFieldTypes
    if fi < ftys.length { return ftys[fi] }
  }
  -1
}

// Whether an unusable field type is one the declaration pass ALREADY reported
// (an unresolvable annotation lands as the error type). Suppresses a second
// message on the same field.
function flatTyAlreadyErrored(tyIx: i32) {
  if tyIx < 0 { return true }
  const t = T.tys[tyIx]
  if t is TyErr { return true }
  false
}

// The clause naming WHY a field type has no place in a flat record. Every arm
// names a representation fact, because that is the thing the programmer has to
// work around.
function flatWhyNot(tyIx: i32, spelling: string) {
  if tyIx < 0 { return "its type has no byte width" }
  const t = T.tys[tyIx]
  // EXHAUSTIVE over `Ty` and deliberately `_`-less: a 12th arena variant breaks the
  // self-compile here instead of silently printing the generic width clause, which
  // reads as a representation FACT about a shape nobody classified.
  match t {
    TyPrim => {
      if t.primName == "boolean" {
        return "`boolean` has no declared byte width (use i32 — C's `bool` is 1 " +
          "byte and VL's is 4, so this tier will not guess)"
      }
      if t.primName == "string" { return "a string is a heap reference" }
      return "`" + t.primName + "` has no byte width"
    }
    TyArray => {
      return "an array is a heap reference"
    }
    TyMap => {
      return "a map/set is a heap reference"
    }
    TyFunc => {
      return "a function value is a reference"
    }
    TyNullable => {
      return "a nullable has no in-memory discriminant in this tier"
    }
    TyUnion => {
      return "a union is boxed on the heap"
    }
    TyObj => {
      if spelling == "" { return "an inline record is not a `flat` type" }
      return "`" + spelling + "` is a record but is not declared `flat`"
    }
    TyLit => {
      // A literal type — its base scalar is what the field would hold, and that
      // base is a `TyPrim` the arm above already names, so the generic clause is
      // the honest one here.
    }
    TyVar => {
      // An unsolved type PARAMETER: the monomorphizer folds a `flat` layout
      // per-instance (`monoFoldTyParamLayout`), so no rep fact exists yet.
    }
    TyNeg => {
      // A RESIDUAL negation — no representation to name.
    }
    TyErr => {
      // Suppressed one caller earlier by `flatTyAlreadyErrored`, so this clause is
      // never the message a programmer sees for the error type.
    }
  }
  // The four empty arms above land here: no representation fact to name, so the
  // clause states only the width consequence.
  "its type has no byte width"
}

// Try to size declaration `d`: succeeds once every nested record it holds has a
// size. Fills the per-field byte offsets as a RUNNING SUM — no alignment, no
// padding, no reordering (§2).
function flatTrySize(d: i32) {
  const start = flFStart[d]
  const count = flFCount[d]
  let k = 0
  while k < count {
    if flFWidth[start + k] < 0 {
      const nest = flFNest[start + k]
      if nest < 0 { return false }
      if flSizes[nest] == FL_UNRESOLVED { return false }
      // A nested record that is INVALID makes this one unsizeable too, but the
      // error is already on the page — take the declaration out of the fixpoint
      // silently rather than reporting a cycle for it.
      if flSizes[nest] == FL_INVALID {
        flSizes[d] = FL_INVALID
        return true
      }
    }
    k = k + 1
  }
  let off = 0
  let j = 0
  while j < count {
    flFOff[start + j] = off
    let w = flFWidth[start + j]
    if w < 0 { w = flSizes[flFNest[start + j]] }
    off = off + w
    j = j + 1
  }
  flSizes[d] = off
  true
}

// The i32 value of the layout constant `name.prop`, or -1 when `prop` names
// neither the record's size nor one of its fields. Only ever asked about a name
// that is already known to be a sized flat type.
function flatConstOf(d: i32, prop: string) {
  if prop == "size" { return flSizes[d] }
  const start = flFStart[d]
  const count = flFCount[d]
  let k = 0
  while k < count {
    if flFNames[start + k] == prop { return flFOff[start + k] }
    k = k + 1
  }
  -1
}

// The layout constant `name.prop` by NAME, for the monomorphizer's per-instance
// fold of a type parameter's layout members (`emit_mono.monoFoldTyParamLayout`):
// -1 when `name` is not a usable `flat` type, -2 when it is one but has no member
// `prop`. The two misses are separate because they are different mistakes and the
// monomorphizer names each one against the binding that made it.
export function flatConstOfNameProp(name: string, prop: string) {
  const d = flatIndexOf(name)
  if d < 0 { return -1 }
  // A rejected or cyclic declaration: its error is already on the page.
  if flSizes[d] < 0 { return -1 }
  const v = flatConstOf(d, prop)
  if v < 0 { return -2 }
  v
}

// The `N.size` / `N.field` interception at the top of `checkMemberNode`, and the
// only place the layout sidecar is READ. Answers 0 for an ordinary field access
// (which the rest of `checkMemberNode` then handles), 1 when the node was FOLDED
// to its constant, 2 when it reported an error, and 3 when the receiver is a live
// type PARAMETER whose fold belongs to the monomorphizer (typed `i32` here).
//
// THREE GUARDS, and together they make this unreachable from any program that
// compiles today:
//   1. the receiver is a BARE IDENTIFIER — `TValue.size`, never `f().size`;
//   2. the identifier does NOT resolve as a value. A local named `TValue` shadows
//      the layout constants, and every `x.f` in an existing program has a value
//      `x` by construction, so no existing access can be diverted;
//   3. the identifier names a FLAT type. A declared NON-flat type gets a targeted
//      message naming `flat` — master answers `undeclared identifier 'N'` here,
//      which teaches nothing, and that message is the feature's discoverability
//      path.
//
// The FOLD is an in-place arena rewrite to a `NumLit`, the technique
// `desugarMatchAt` already uses for `match`. It is what keeps the emitter at zero
// lines: by the time emit runs there is no `Member` node left to lower. It is also
// idempotent — a second visit sees a `NumLit` and never reaches here — which
// matters because the checker re-walks nodes in its speculative windows.
function flatMemberFold(n: Member, ix: i32) {
  const obj = P.nodes[n.memObj]
  if obj is Ident {
    const nm = obj.identName
    if lookup(nm) >= 0 { return 0 }
    // A live type PARAMETER (`T.size` inside `function "[]"<T>(self: Rows<T>, …)`).
    // The layout is not knowable HERE — `T` is abstract for the one pass the
    // checker makes over a generic body — so the fold is DEFERRED to the
    // monomorphizer, which owns the per-instance binding and rewrites this node
    // once per instance (`emit_mono.monoSubstTyParamExprs`). The member's TYPE is
    // `i32` under every binding, so the rest of the body checks exactly as it will
    // after the fold; what the checker cannot verify is whether the binding names a
    // `flat` type and whether it HAS this member, and both are reported by the
    // monomorphizer against the instance that got it wrong.
    if tpEnvTyOfName(nm) >= 0 { return 3 }
    const d = flatIndexOf(nm)
    if d < 0 {
      if (cUserTypes[nm] ?? -1) >= 0 {
        tErr(
          "`" +
            nm +
            "` is not a `flat` type, so it has no byte layout — only a " +
            "`flat type " +
            nm +
            " = { … }` has `.size` and per-field offsets",
          ix,
        )
        return 2
      }
      return 0
    }
    // The declaration was rejected or is part of a cycle; its error is already on
    // the page, so fail quietly rather than cascade onto every use site.
    if flSizes[d] < 0 { return 2 }
    const v = flatConstOf(d, n.memProp)
    if v < 0 {
      tErr(
        "`flat type " +
          nm +
          "` has no field '" +
          n.memProp +
          "' — its layout members are `.size` and one offset per declared field",
        ix,
      )
      return 2
    }
    P.nodes[ix] = P.nodes[mkNum(i32ToStr(v), n.pos)]
    return 1
  }
  0
}

// ── nominal newtypes (webcraft P1.5 / A14) ──────────────────────────────────
// The whole feature is these five functions plus one test in `assignableGo`, one
// in `tyEqGo` and one in `checkBinExprNode`. Nothing in `emit_*.vl` changes: by
// the time the emitter runs, `canonEmitTypeNames` has rewritten every newtype
// annotation to its base's spelling, exactly as it already does for a plain
// `type MyInt = i32` alias. See `docs/internals/newtype-design.md` §3.

// True if `name` was declared `type N = new …`.
function isNewtypeName(name: string) {
  let i = 0
  while i < nwDeclNames.length {
    if nwDeclNames[i] == name { return true }
    i = i + 1
  }
  false
}

// The BRAND arena index `ix` carries, or "" when it is an ordinary structural type.
// The single reader of the sidecar; every nominal decision in the checker asks it.
export function nomNameOfTy(ix: i32) {
  if ix < 0 { return "" }
  let i = 0
  while i < nwTyIxs.length {
    if nwTyIxs[i] == ix { return nwNames[i] }
    i = i + 1
  }
  ""
}

// The UN-branded arena index a branded index stands for (itself, when unbranded).
// Read by the literal-adoption arm, which needs a destination whose own brand is
// waived while everything below it still checks.
function nomBaseTyIx(ix: i32) {
  if ix < 0 { return ix }
  let i = 0
  while i < nwTyIxs.length {
    if nwTyIxs[i] == ix { return nwBaseTyIxs[i] }
    i = i + 1
  }
  ix
}

// The arena index `ix` ERASES to at run time: `nomBaseTyIx` iterated to a fixpoint, so a
// brand over a brand (`type N2 = new N`) reaches the same base its outermost brand does.
// The bound is a cycle guard, not a depth policy — the sidecar is append-only and a brand
// is always minted over an index that already exists, so a chain cannot be long.
function nomErasedTyIx(ix: i32) {
  let cur = ix
  let steps = 0
  while steps < 8 {
    const b = nomBaseTyIx(cur)
    if b == cur { return cur }
    cur = b
    steps = steps + 1
  }
  cur
}

// ── unions whose arms share ONE runtime representation ──────────────────────────────
// The diagnostic for a union two of whose members are DISTINCT to the checker but ONE
// value shape to the emitter, or "" when every member is separable.
//
// A union box carries a single tag, and `emitIs` answers `x is T` by comparing it. A
// nominal brand is minted as a SECOND arena index over the SAME `Ty` value and is ERASED
// before the emitter runs (`canonEmitTypeNames`; `newtype-design.md` §3), so `N` and its
// base — and two newtypes over one base — reach that tag identically. No membership
// predicate can separate them the way #1340's separates a literal-union arm from a
// `string` arm: a litunion member is a runtime-observable SUBSET of its base, whereas a
// brand has no runtime witness at all. Every construction of such a union therefore
// answers TRUE to `is` for both arms, whichever arm the value came from — measured across
// i32/i64/f64/f32/boolean/string/array/struct bases and in local, parameter and struct-field
// position, and the two cells that appear to survive are masked (their inverted twins,
// built through the other arm, are wrong).
//
// So the union is not a type this language can represent, and the honest answer is to
// refuse the SPELLING rather than to answer `is` wrongly. Giving the arm its own tag is
// the escalation this declines: it requires the brand to survive into the emitter, which
// is precisely the cost `newtype-design.md` exists to avoid.
//
// THE COMPARATOR IS THE MEMBER LIST'S OWN DEDUP, APPLIED ONE ERASURE DOWN, and that is
// what bounds the rule to brands without naming them. Both member builders drop a member
// that is `sameVariantTy` with one already kept, so every pair that reaches here is
// already NOT mutually assignable; a pair whose ERASED forms then are can differ by
// nothing but a brand. Index equality alone is not enough — it catches a scalar base,
// whose name resolves to one canonical arena entry, and misses a STRUCTURAL one
// (`new i32[]` beside `i32[]`, `new {a: i32}` beside `{a: i32}`), where each resolution
// mints its own index over the same shape.
//
// INERT WITHOUT `new`: the sidecar is empty for every program that declares no newtype, so
// this answers "" before looking at a member — a brand-free program cannot reach the
// mutual-assignability calls below, let alone a diagnostic.
function nomUnionRepClashMsg(members: i32[]) {
  if nwTyIxs.length == 0 { return "" }
  let i = 1
  while i < members.length {
    let j = 0
    while j < i {
      if sameVariantTy(nomErasedTyIx(members[i]), nomErasedTyIx(members[j])) {
        return "union members '" +
          tyToStr(members[j]) +
          "' and '" +
          tyToStr(members[i]) +
          "' have the same runtime representation, so `is` cannot tell " +
          "them apart — a nominal newtype is erased to its base at run time"
      }
      j = j + 1
    }
    i = i + 1
  }
  ""
}

// Would the assignment `srcExpr : srcTy -> dstTy` succeed if the NOMINAL brands in
// `dstTy` were ignored? True only for a syntactic scalar LITERAL source (§2.3 of
// the design doc): a literal carries no prior identity, so it adopts whatever brand
// the destination asks for, at whatever depth the destination wears it — a bare
// `EntityId`, an `EntityId?` map read, an `EntityId` map value slot.
//
// Relaxing the WHOLE walk is safe precisely because the source is a scalar literal:
// there is no nested value under it whose own brand could be waived along with the
// destination's. An object / array literal is deliberately NOT admitted here — it
// adapts element-wise through `assignableExpr`, which re-applies the brand rule to
// every component.
//
// The first line is the feature's INERTNESS statement: a program with no `new`
// declaration has an empty sidecar, so this answers `false` without doing any work
// and nothing anywhere else in the checker can observe the newtype rules at all.
function nomLitAdopts(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if nwTyIxs.length == 0 { return false }
  if srcExpr < 0 { return false }
  if !exprIsBrandAdoptingLiteral(srcExpr) { return false }
  nomLitRelax = nomLitRelax + 1
  const ok = assignable(srcTy, dstTy)
  nomLitRelax = nomLitRelax - 1
  ok
}

// Does `dstTy` carry a nominal brand at or under its wrappers? The GATE for the
// expression-aware retry below: shallow on purpose — a brand is a property of a
// declared type, and the destination shapes a slot check meets are the type
// itself or one or two wrappers over it (`V?`, `V[]`, `V | null`).
function tyReachesBrand(ty: i32, d: i32) {
  if ty < 0 { return false }
  if d <= 0 { return false }
  if nomNameOfTy(ty) != "" { return true }
  const t = T.tys[ty]
  if t is TyNullable { return tyReachesBrand(t.nInner, d - 1) }
  if t is TyArray { return tyReachesBrand(t.aElem, d - 1) }
  if t is TyUnion {
    const ms = t.uMembers
    let i = 0
    let any = false
    while i < ms.length {
      if tyReachesBrand(ms[i], d - 1) { any = true }
      i = i + 1
    }
    return any
  }
  false
}

// The expression-aware retry for a slot checked with the BARE structural
// `assignable` — now ONE such slot, the map `.set` KEY. `assignableExpr` is where
// every contextual coercion lives — the scalar-literal brand adoption AND the
// object-literal field-wise adaptation, which is the one a nominal STRUCT slot
// needs and which `nomLitAdopts` deliberately cannot supply (relaxing a whole walk
// under an object literal would waive the brands of its field VALUES too).
//
// Gated on the destination actually carrying a brand, so a program with no `new`
// — and a newtype program's brand-free slots — keep the bare structural check
// they have today, byte for byte. Without the gate this would widen every map
// slot to `assignableExpr`'s coercions, which is a real behaviour change and an
// unrelated one.
//
// THE `.set` VALUE NO LONGER COMES HERE: that slot took the full `assignableExpr`
// (the twin-grid slice below), which SUBSUMES this retry. The KEY deliberately did
// not follow it — `checkIndexNode`'s map arm checks `m[k]`'s key with the bare
// `assignable` too, so widening the key would make `.set` diverge from the
// assignment path in the OTHER direction, which is the defect this pairing exists
// to remove.
function nomSlotAccepts(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if nwTyIxs.length == 0 { return false }
  if srcExpr < 0 { return false }
  if !tyReachesBrand(dstTy, 6) { return false }
  assignableExpr(srcExpr, srcTy, dstTy)
}

// The branded arena index for newtype `name` over base `base` — minted once per
// (name, base) pair and reused, so `assignable`'s `src == dst` fast path still
// fires and `resolveAnnot`'s name-keyed memo stays stable across resolutions.
//
// The branded index is a SECOND index over the SAME `Ty` value, not a deep copy:
// a `TyObj` placeholder filled in pass 0b pushes into the very field arrays the
// brand shares, so a forward reference through the newtype name sees the finished
// shape. The NOMINAL sidecars are mirrored onto the new index for the same reason
// — `structNameOfTy` / `unionAliasDeclNameOfTy` must answer about the brand
// exactly as they answer about its base, or a declared struct reached through its
// newtype name would lose its declared name in the renderers.
function nwBrand(name: string, base: i32) {
  if base < 0 { return base }
  if !isNewtypeName(name) { return base }
  let i = 0
  while i < nwTyIxs.length {
    if nwNames[i] == name && nwBaseTyIxs[i] == base { return nwTyIxs[i] }
    i = i + 1
  }
  const ix = addTy(T.tys[base])
  nwTyIxs.push(ix)
  nwNames.push(name)
  nwBaseTyIxs.push(base)
  const sdn = structNameOfTy(base)
  if sdn != "" {
    cStructTyIxs.push(ix)
    cStructNames.push(sdn)
  }
  const udn = unionAliasDeclNameOfTy(base)
  if udn != "" {
    cUnionTyIxs.push(ix)
    cUnionNames.push(udn)
  }
  ix
}

// True if `name` is a one-member `type N = A` alias whose body is a plain type reference
// (`aliasRefIsPlainRoot`, recorded syntactically in pass 0a).
function isPlainAliasRef(name: string) {
  let i = 0
  while i < cPlainAliasNames.length {
    if cPlainAliasNames[i] == name { return true }
    i = i + 1
  }
  false
}

// True if the one-member alias `name` (arena index `ti`, already known to be a `TyUnion`)
// denotes its member TRANSPARENTLY. Two populations, and the pair below is the WHOLE rule —
// `nameToTy` and `singleMemberAliasTyIx` must agree exactly or the checker and the emitter
// diverge on the same annotation:
//   - a PRIMITIVE member (`type Id = i32`, `type Name = string`) — always transparent;
//   - a FUNCTION member (`type F = (i32) => i32`) — always transparent; see below;
//   - an OBJECT member reached through a plain alias REFERENCE (`type MyCat = Cat`,
//     `type Y = Box<i32>`) — transparent, because the emitter has no named-struct route to
//     such an alias at all: it registers `N` as a one-variant union row (`unNames`), so
//     `isUName(N)` claims the annotation for the union BOX while the initializer lowers a
//     plain struct — silent INVALID WASM for `type Y = Box<i32>`, and a
//     "field access but no struct type declared" / "ref valtype with no interned shape"
//     emit reject for `type MyCat = Cat`.
// An object member whose body is NOT a plain reference is the canonicalized INTERSECTION
// (`type AB = {a:i32} & {b:i32}`) — that one IS interned as a named struct
// (`unionStructAliasShape`) and works today, so it is deliberately left opaque.
//
// WHY THE FUNCTION MEMBER (D-ALIASFN). An arrow-bodied `type F = (i32) => i32` is a
// one-member `UnionDecl` like every other non-`{…}` body, so without this arm `F` denotes
// `TyUnion[TyFunc]` — and a union is not callable. Measured on the parent commit: EVERY
// call through an alias-spelled function type is a CHECKER error, in every position
// (global / local / param / return / narrowed-from-nullable), with the message
// ``called value is not a function ((i32) -> i32)`` — which reads as nonsense precisely
// because `tyToStr` renders a one-member union as its member. Downstream, the emitter's
// `nulCloFlag` wants `TyNullable(TyFunc)` and gets `TyNullable(TyUnion[TyFunc])`, so an
// alias-spelled nullable closure is a clean emit REJECT as a local, a param and a return
// (#1133's four remaining located cells). Both are one defect: the degenerate wrapper. A
// function type has no nominal emit route to lose — there is no `unNames`/`sNames` row a
// declared function type could resolve THROUGH — so the transparency is unconditional
// (no `isPlainAliasRef` gate, which exists only to keep the canonicalized intersection's
// named-struct route alive).
//
// WHY THE ARRAY MEMBER (D-ALIASARR), AND WHY ONLY OVER A SCALAR SPINE. `type L = i32[]` is the
// same degenerate wrapper one arm over, and #1137 handed it on with a caution: that an array,
// UNLIKE a function, might have a nominal emit route to lose. Measured, that caution is right
// for EXACTLY ONE element kind and wrong for the rest — which is why the gate below is a
// property of the ELEMENT and not of the array.
//
// Method: a 17-position alias-vs-inline twin table over six alias bodies (`i32[]`, `string[]`,
// `f64[]`, `boolean[]`, `Cat[]`, `i32[][]`), 102 cells, run against a parent-built compiler and
// against this one. On the parent, 17/17 positions differ for every body and there are 0 cells
// where the alias spelling works and the inline spelling does not — there is no working route
// to lose because there is no working route at all: `xs[0]` reads ``cannot index non-array
// i32[]``, `.length`/`.push` read ``field '…' is not on every member of i32[]``, and a RETURN
// whose result is never read builds an INVALID MODULE, the same silent-miscompile shape
// D-ALIASFN found one arm over.
//
// The ONE exception is a NOMINAL element. `singleMemberAliasTyIx`'s consumers hand the member
// to `tyToEmitNameAt`, which renders a declared struct element STRUCTURALLY — `Cat[]` becomes
// `{n:i32}[]` — so the declared name the emitter's element tables key on is dropped. That is a
// real route, and it is load-bearing: `type Cat = {n: i32}; type L = Cat[]` used as a UNION ARM
// in a parameter (`f(x: L | i32)`) COMPILES AND RUNS on the parent and becomes an emit reject
// if the render is substituted. So the arm is gated on `arrSpineIsScalar` — peel the array
// spine and require a `TyPrim` leaf, the condition under which `tyToEmitName` is
// name-faithful. Five of the six bodies qualify; `Cat[]` keeps the parent's behaviour exactly,
// in both directions, and is handed off rather than forced.
//
// The corpus population is empty either way: 0 array-bodied aliases in the 1,314 `tests/cases`
// files, and `singleAliasMemberTyIx` meets a one-member union over a `TyArray` 0 times in a
// `vl check --codegen` sweep of them (against 67 `TyPrim`, 48 `TyFunc`, 41 `TyObj` and 18
// `TyLit` members of 178 one-member unions, out of 2,551 `TyUnion` meets). So the arm cannot
// regress anything extant and its entombment comes from new fixtures.
//
// WHY THE MAP MEMBER (D-ALIASMAP), AND WHY WITH NO GATE AT ALL. `type M = {[string]: i32}` is
// the same degenerate wrapper once more, and it became spellable only at #1201 — before that
// `parseTypeDecl` sent every `{`-leading body to the struct-field path and the declaration was a
// hard parse error, which is why the arm above could defer it as "unobservable". The deferral
// named its price: "it has its own twin table to build and its own value-name family to check".
// Both were built, and BOTH ANSWERS CAME BACK DIFFERENT FROM THE ARRAY ARM'S.
//
// Twin table A — 41 cells: four map VALUE kinds (`i32`, `string`, `f64`, `boolean`) x eight
// annotation POSITIONS (global, param, return, struct field, array element, `| null`, map value,
// function-local) plus nine shape variants (index read, `.has`, map-of-map-alias, alias-of-alias,
// `{[i32]: …}` key, closure param, closure result, union member, field read+write). Twin table B
// — 32 cells: the four value kinds that ask the NOMINAL-render question the array arm's gate came
// from (a declared struct `Cat`, a literal-union alias `K0`, an inline `{n:i32}` shape, `i32 |
// null`) x the same eight positions. Every cell exists twice: once spelled through the alias and
// once with the alias-free INLINE spelling, the two programs identical character for character
// apart from the annotation. Graded on the RUN VALUE, not on an exit code.
//
// On the parent, the alias leg is 1 OK / 24 checker rejects / 16 emit rejects / 0 invalid modules
// (table A) and 4 / 12 / 16 / 0 (table B). With this arm it is 35 / 1 / 1 / 4 and 26 / 0 / 0 / 6.
// **Both tables land on the alias-free control's PARENT verdict in every one of their 73 cells**,
// and the control itself is unmoved by this arm — so the alias spelling stops being a distinct
// dialect rather than acquiring one. All five cells that ran on the parent still run.
//
// THE GATE THE HAND-OFF PREDICTED DOES NOT EXIST, and table B is what refutes it. #1137 handed
// this arm on with "the gate is probably `mapValue` non-nominal", by analogy with `Cat[]`. The
// analogy fails at the render: `tyToEmitName`'s ARRAY arm re-renders its element, so a declared
// element's NAME is dropped and `Cat[]` has a nominal route to lose — its MAP arm emits
// `{[K]:V}` for every value there is (and deliberately preserves a litunion-alias value), so a
// map alias has no nominal route to lose because a map name is never a route. Measured, not
// reasoned: `type M = {[string]: Cat}` works in six of eight positions with this arm and its two
// failures are the inline spelling's own, on the parent, cell for cell.
//
// The two failing POSITIONS are array-element and map-value, and they are one PRE-EXISTING emit
// defect that this arm merely makes reachable through the alias: a map whose value is not the
// mono-i32 kind (`f64`, `string`, a struct, a nullable — but not `i32`, `boolean` or a litunion
// alias) is INVALID WASM as an array element or as another map's value. All ten cells fail
// identically with NO alias in the program on the parent, so the arm converts an emit reject
// that was an artifact of the union box into the inline spelling's own miscompile. Loud, not
// silent: `vl build` reports `is not a valid WebAssembly module … (this is a compiler emit bug)`
// and exits 1. Filed for the emitter; not gated around here, because a gate would buy two cells
// by re-breaking six and would put the alias back into a dialect of its own.
function singleAliasMemberTyIx(ti: i32, name: string) {
  const t = T.tys[ti]
  if t is TyUnion {
    if t.uMembers.length == 1 {
      const m0 = t.uMembers[0]
      const mt = T.tys[m0]
      if mt is TyPrim { return m0 }
      if mt is TyFunc { return m0 }
      if mt is TyArray {
        if arrSpineIsScalar(m0) { return m0 }
      }
      if mt is TyMap { return m0 }
      if mt is TyObj {
        if isPlainAliasRef(name) { return m0 }
      }
      // D-ALIASLU: a UNION member (`type A = K` over a litunion, `type A = U` over a
      // declared value union, and the `new` form of either — `type NK = new K`). The
      // degenerate wrapper once more, and for a litunion it was the LAST rep whose
      // alias spelling was a dialect of its own: a litunion reps as an interned i32
      // ATOM, so the union ROW this alias minted made `isUName` claim every
      // `A`-annotated slot for the `{tag, anyref}` BOX while every READ classified
      // from the arena and lowered the atom — `call __print_i32__` on a `(ref $box)`,
      // i.e. INVALID WASM with `vl check` rc 0, at every position and for every use.
      //
      // TWO GATES, which are `transparentMemberEmitName`'s two legs read backwards:
      //   - a DECLARED union renders as its own NAME, so nothing nominal is dropped
      //     and the render is what canon leaves the direct spelling as. This includes
      //     a NUMERIC litunion, whose nominal leg declines ON PURPOSE so that both
      //     spellings get `numLitUnionAliasName`'s base scalar (`type Z = 0 | 1` is
      //     `i32` to the emitter, never `Z`).
      //   - an INLINE union has no declared name to drop, but its MEMBERS may — see
      //     `unionAliasMembersFaithful`, which is #1137's `Cat[]` caution landing on
      //     the one member kind that really does have it.
      if unionAliasDeclNameOfTy(m0) != "" { return m0 }
      if unionAliasMembersFaithful(m0) { return m0 }
      // D-ALIASNUL: a NULLABLE member — `type A = (K | null)`, `type A = (string | null)`,
      // and the un-parenthesized `type A = K | null`, which interns as the SAME
      // one-member wrapper over a `TyNullable` (the `null` arm is normalized into the
      // niche, not kept as a sibling variant). Same defect, same witness: the alias's
      // union ROW claimed the slot for the box while the read lowered the niche.
      //
      // UNGATED IN THE INNER, unlike the array arm's `arrSpineIsScalar` and the union
      // arm's `unionAliasMembersFaithful` — see `nulAliasMemberFaithful` for the grid
      // that says an inner gate here costs 100 oracle-parity cells and protects one
      // declared-struct residue that is loud on both sides.
      if nulAliasMemberFaithful(m0) { return m0 }
    }
  }
  -1
}

// True when the emit render of UN-NAMED UNION type `ty` is NAME-FAITHFUL — the union
// analogue of `arrSpineIsScalar`, and likewise a property of the MEMBERS rather than of
// the wrapper. `tyToEmitNameGo`'s union arm re-renders every member, so the render
// substitutes for the alias exactly when each member's own render is name-faithful: a
// `TyLit` renders as its base scalar (or, for a run matching a registered alias, as that
// litunion ALIAS) and a `TyPrim` as its own `primName`. So `("a" | "b")` and `(K | f64)`
// qualify, and `(i32 | string)` does too.
//
// A DECLARED STRUCT member is the exception #1137's `Cat[]` caution predicted, and it is
// MEASURED here rather than reasoned: with this gate absent, a one-member alias over
// `(Cat | Dog)` renders `{n:i32}|{m:i32}`, the variant names `emitIs` dispatches on are
// dropped, and `x is Cat` becomes `emitProgram: \`is\` receiver is not a union` — at the
// module cell and inside a function alike, where the alias-free spelling runs. The
// DECLARED union of the same structs is unaffected: it is claimed by the nominal leg
// above and renders as its name.
function unionAliasMembersFaithful(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyUnion {
    const ms = t.uMembers
    if ms.length < 1 { return false }
    let i = 0
    while i < ms.length {
      const mt = T.tys[ms[i]]
      let ok = false
      if mt is TyLit { ok = true }
      if mt is TyPrim { ok = true }
      // A LITUNION member of a MIXED union (`(K | f64)`, where the arena keeps `K` as a
      // nested union rather than flattening it) is rendered by its ALIAS on the union arm
      // (`litUnionAliasNameOfTy(members[i])`, and the `rgAlias` regroup for the flattened
      // shape) — so it is faithful for exactly the reason a `TyLit` is.
      if tyIsLitUnion(ms[i]) { ok = true }
      if !ok { return false }
      i = i + 1
    }
    return true
  }
  false
}

// True when a ONE-MEMBER alias over NULLABLE member `ty` denotes that member — the
// nullable arm of `singleAliasMemberTyIx`, and the arm with NO GATE ON THE INNER.
//
// `type T = (S | null)` interns `TyUnion[S?]`, so the wrapper is a NAME and not a type
// constructor and the alias denotes `S?`. Both sides read that from here: the CHECKER
// through `declaredTyOfName` (so `x: T` is a plain `S?`, which `nonNullTy` then peels
// like any other niche) and the EMITTER through `singleMemberAliasTyIx`. Declining here
// diverges them — the alias's union ROW claims the slot for the `{tag, anyref}` box
// while every read of the value lowers the niche — which is what the two consumers'
// notes describe and what `nonNullTy` must NEVER be taught to paper over: peeling the
// wrapper in the narrow while this predicate still declines it is the CHECKER moving
// alone, measured at 47 loud emit rejects and 15 check-clean-invalid-wasm cells and
// **zero** new running programs.
//
// WHY NO INNER GATE, MEASURED. A 1,020-cell twin grid — 15 inners × (8 positions + 9
// uses) × {3 alias spellings, the alias-free INLINE oracle}, graded on the RUN at both
// runtime inputs — reads **+100 oracle-parity cells and 0 regressions** against an inner
// gate of a primitive or litunion inner only. Every inner that gate's note called
// structurally-rendered lands on the oracle cell for cell: an inline struct, a list, a
// map, a generic application, a closure, a declared union, a numeric litunion, a nested
// nullable.
//
// The `| null` DECLARATION fold is UNGATED for the same reason and cannot be gated
// separately: it decides which shape a declaration INTERNS, and an inner this arm calls
// transparent while the declaration keeps the two-member union is the same divergence one
// layer down — `collectU` mints the alias a union ROW that no read of the value lowers as.
// So the two questions are one question, and `annUnionTy` answers it for all four
// spellings.
//
// A DECLARED STRUCT inner is the ONE residue and it is 3 axes of 17, both verdicts LOUD
// and never a wrong answer: at a module `const` (`emitProgram: ref valtype with no
// interned shape`), at a generic instantiation (`only i32, … parameters are supported`)
// and as a list ELEMENT (`a nullable-{v:i32} list element has no rep`, where the inline
// spelling rejects too). Gating it out costs 13 oracle-parity cells — including the
// parameter-position field read this predicate exists to make work — to convert three
// loud emit rejects into three loud check rejects, so the render's dropped struct name
// is filed against the emitter rather than bought here.
function nulAliasMemberFaithful(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable { return true }
  // The UN-NORMALIZED shape — a `TyUnion` of literal members beside `null`, which is what
  // a `type A = B` wrapper sees when `B`'s own `| null` declaration kept the raw survivor
  // list instead of the niche. The declaration fold is ungated, so the only route left to
  // that shape is a POISONED fold: `annUnionTy` answers -1 for an unseparable nominal pair
  // (the clash the declaration already reported), and the survivors — `null` among them —
  // are pushed as they stood.
  tyIsNullableLitUnion(ty)
}

// True when `ty` is an ARRAY (of arrays, of arrays…) whose LEAF element is a primitive — the
// exact condition under which `tyToEmitName` renders the type name-faithfully, because every
// rung it walks (`T[]`, and a `TyPrim`'s own spelling) is the spelling the annotation had.
// Any other leaf — a declared or inline object, a map, a union, a nullable, a function — is
// rendered structurally or softened, so the render is NOT a faithful substitute for the alias
// and the member stays opaque. Bounded by the arena walk itself: an array's element is always
// a strictly earlier construction, so the spine cannot cycle.
function arrSpineIsScalar(ty: i32) {
  let cur = ty
  let going = true
  let ans = false
  while going {
    if cur < 0 {
      going = false
    } else {
      const t = T.tys[cur]
      if t is TyArray {
        cur = t.aElem
      } else {
        if t is TyPrim { ans = true }
        going = false
      }
    }
  }
  ans
}

// The ARENA TYPE a declared one-member union ALIAS denotes TRANSPARENTLY (`type Id = i32`,
// `type Name = string`, `type Y = Box<i32>`, `type M = {[string]: i32}`), or -1 when `name`
// is not such an alias (`singleAliasMemberTyIx` is the rule). Such an alias denotes its
// member, so the emitter resolves it to the member's own vocabulary rather than registering
// a one-variant union box.
//
// A TYPE INDEX, not a NAME, and that is renderEmit P4 (route (3) of #1199's six
// transformations). Its `singleMemberAliasName` predecessor RENDERED here
// (`tyToEmitName(m)`) and canon then fed the render straight back into its own string
// rewriter — `canonEmitNameAt(sma, ctx)` — which is W9's whole thesis in one line: *the
// checker re-parsing a name it had just rendered*. The two consumers below now render the
// member ONCE, at the position it stands in, and nothing re-parses the answer.
//
// The substitution is EXACT rather than similar, and it was measured before it was made: a
// site comparator computing BOTH legs at every reach read **0 disagreements in 129 reaches**
// — 124 at this arm (positions `RC_ROOT` 87, `RC_UNION_MEM|RC_NULLABLE` 16, `RC_UNION_MEM` 6,
// `RC_MAP_VAL` 6, `RC_ELEM` 5, `RC_FIELD` 4) and 5 at the `is`-variant site — on the VALUE
// and on the atom WIDTH bank alike. The re-canon was a no-op at this arm for every input the
// corpus can produce, which is the honest shape of this phase: **P4 does not move an answer,
// it moves who decides it.**
//
// THE POPULATION IS CORPUS-ONLY, AND THAT IS MEASURED RATHER THAN ASSUMED. The same
// comparator reads **0 reaches over 9,600 generated fuzz programs** (`scripts/fuzzgen.vl`
// mints declared STRUCTS, never a one-member `type N = …` alias) and **0 over the compiler's
// own 29 modules, `std` and `scripts`**. Fuzz is COVERAGE for this arm, not agreement — the
// distinction #1207 had to draw for its own second target, and it is why the graded channel
// here is the corpus A/B, where cutting the arm reddens 21 rows and cutting the `is` site 2.
//
// NOMINAL-vs-STRUCTURAL was load-bearing and IS NO LONGER — the paragraph below is kept
// because the fix is the row it names. Resolving a declared-struct member to its declared NAME
// (`type MyCat = Cat` → "Cat", via `structNameOfTy`) looked strictly better — it keeps nominal
// identity — and it REGRESSED both `type MyCat = Cat` and `type Y = B` to `emitProgram: ref
// valtype with no interned shape`. The reason is the very row this fix routed around: the
// emitter's `collectU` registered the one-member alias as a union (its variant `Cat` is not a
// `{…}` shape, so `unionStructAliasShape` did not skip it) and PUSHED `Cat` into `uVariants` —
// so the name `Cat` classified as a union VARIANT box, not a plain struct. The named route was
// poisoned; the inline shape was the one that resolved.
//
// THAT ROW IS GONE. Under this ruling `MyCat` is not a union — it denotes `Cat` — so the row
// was never owed, and `collectU` now skips it (`isTransparentAlias`, below). The OBJECT arm
// therefore renders NOMINALLY (`transparentMemberEmitName`, below), and the entombment is the
// pair of sabotages that reproduce this paragraph and its mirror: restoring the row is
// `ref valtype with no interned shape` on `types/struct-alias-transparent.vl`, and keeping the
// row's absence with the STRUCTURAL render is `only i32, …, or string parameters are supported`
// on the same file. Every other arm (`TyPrim` / `TyFunc` / `TyArray` / `TyMap`) renders exactly
// as before.
function singleMemberAliasTyIx(name: string) {
  if !cUserTypes.has(name) { return -1 }
  const ti = cUserTypes[name] ?? -1
  if ti < 0 { return -1 }
  singleAliasMemberTyIx(ti, name)
}

// True when the DECLARED name `name` is a TRANSPARENT one-member alias — `singleAliasMemberTyIx`
// claims it, in ANY of its arms (`type MyCat = Cat`, `type Y = Box<i32>`, `type Id = i32`,
// `type F = (i32) => i32`, `type L = i32[]`, `type M = {[string]: i32}`). The object arm is
// gated there on `isPlainAliasRef`, so the canonicalized intersection (`type AB = {a} & {b}`)
// is NOT claimed by any of this.
//
// EXPORTED FOR `collectU`'S SKIP, AND THAT SKIP IS THE POISON #1122's RULING NAMES. The note
// over `singleMemberAliasTyIx` records why the transparent member had to render STRUCTURALLY
// rather than as its declared NAME: routing `type MyCat = Cat` to "Cat" regressed to
// `ref valtype with no interned shape`, *because* `collectU` registered the alias as a
// one-variant union and pushed `Cat` into `uVariants`, so the NAME classified as a union
// VARIANT box. That row is not a fact about the language — under that very ruling `MyCat` is
// not a union at all, it DENOTES `Cat` — so the emitter stops minting it, and the nominal
// route it was poisoning comes back.
//
// THE GATE USED TO BE THE `TyObj` ARM ALONE, AND ITS PRICE WAS THE EMPTY ROW'S BOX. #1308
// claimed only the object arm, reasoning that a `TyPrim` / `TyFunc` / `TyArray` / `TyMap`
// member is not an `isStructAtom`, so its alias row carries ZERO variants and poisons no name.
// True about `uVariants` and WRONG about the row: an empty row still sets `uDeclared`, which
// mints the shared union box `(struct (field i32) (field anyref))` — plus the value-atom boxes
// `markValueUnionAtoms` hangs off it, the ref-array slots `markRefArrayArms` does, and the map
// slots `markMapUnionArms` does — for a program that HAS NO UNION. Dropping the gate moves 37
// corpus files, every one of them SMALLER, **-437 bytes**, with check / check-msg / build-rc /
// RUN identical on all 1,707; 26 of the 37 lose exactly that box and 36 lose at least one heap
// type. Its widening-guard sweep is 19 member kinds x 17 positions x {alias, alias-free
// control} = 608 cells graded on the RUN: **0 cells move**, while the same grid rebuilt on the
// MODULE reaches 140 cells (every widened kind, no unclaimed kind), all 140 smaller, and the
// inverted control — this predicate answering false, i.e. #1308 reverted — reddens 11 of them
// (2 silent invalid wasm). So the grid can see this population and reads zero for the widening.
export function isTransparentAlias(name: string) {
  singleMemberAliasTyIx(name) >= 0
}

// The emit SPELLING of a transparent alias's member — the ONE producer read by both the
// annotation rewriter (`canonEmitNameTs`) and the `is` rewriter. D-ISALIAS is the reason it
// is one function and not two call sites: those two spell the union's VARIANT and the test
// that names it, and a divergence between them is `is` naming a variant the emitter does not
// have (an emit reject for the object arm, an INVALID MODULE for the scalar and array arms).
//
// NOMINAL-FIRST FOR AN OBJECT MEMBER, WHICH IS THE HALF #1122 COULD NOT HAVE. That ruling
// BUILT the declared-NAME render, measured it regressing `type MyCat = Cat` to
// `ref valtype with no interned shape`, and named the cause in the same paragraph: `collectU`
// minted the alias as a one-variant union and pushed the member's own name into `uVariants`.
// The consequence is one rung further on, in `collectS`, and it is what the measurement
// actually saw: that pass skips a `TypeDecl` whose name `variantIndexOf` claims, so the poison
// row stopped `Cat` from interning as a standalone STRUCT, and the only interned spelling left
// was the inline shape `collectAnnShapes` put there. With the row gone (`isTransparentAlias`
// above, read by `collectU`) the member interns under its own name — and the inline shape stops
// being interned, because `collectAnnShapes` dedups it against the declared struct. So the two
// halves are ONE change in both directions: with the row, only the structural spelling
// resolves; without it, only the nominal one does.
//
// The gate is the member's own arena entry, not a second reading of the alias: the `TyObj` arm
// of `singleAliasMemberTyIx` is already `isPlainAliasRef`-gated, so a `TyObj` here IS the
// plain-reference population and the canonicalized intersection never reaches it. A member with
// no declared name (an inline shape behind a generic application) falls through to the
// structural render unchanged, which is every other arm's behaviour too.
//
// THE GENERIC-APPLICATION RUNG SITS UNDER THE DECLARED NAME, AND IT IS THE SAME NOMINAL
// RULE ONE RUNG WIDER. `type Y = Box<i32>` has no declared struct to name — no `TypeDecl` is
// spelled `Box<i32>` — but the application IS a nominal spelling: the head is a declared name
// and `genAppNameOfTy` renders the arguments nominally under it, which is exactly the order
// `tyToNominalNameGo` asks the two in. It closes nine census rows on the nominal axis
// (B2 20 → 11, B3 126 → 117) and moves nothing on the six-channel corpus.
//
// IT HAS TWO CONSUMERS THAT MUST BE READY FOR THE NAME IT PRODUCES, AND ALONE IT IS THREE
// CELLS DOWN — measured on a 13-position × 2-spelling alias-vs-application sweep, this arm
// against the alias-free control:
//   - the FIELD-CODE ladder. Under the structural render a field typed by the alias
//     (`type Holder = { c: Y }`, and its `| null` twin) reached `fieldTypeCode` as an inline
//     shape; under the application name it arrives as `Box<i32>`, which types only because
//     `emit_classify.nameIsGenAppDecl` routes an application to code 15. Without it, both
//     field cells take the reject the DIRECT spelling `{ c: Box<i32> }` used to take.
//   - the `is` REWRITER's rewrite ORDER. `canonEmitTypeNames`' variant arm resolves a
//     transparent member and only THEN expands an application to its shape, so `Y` lands in
//     `uVariants` as `{v:i32}`; the `is` arm has to apply the same two rewrites in the same
//     order or it names `Box<i32>` against that table. Inert until this arm existed, because
//     a leading expansion cannot see a name the rung below it has not yet produced.
// The `collectU` skip the OBJECT arm is inseparable from is NOT a third dependency here:
// `isTransparentAlias` claims every transparent arm, so the alias's poison row is already
// not minted, and this arm changes no emitter table at all.
function transparentMemberEmitName(smt: i32, ctx: i32): string {
  const mt = T.tys[smt]
  if mt is TyObj {
    const sdn = structNameOfTy(smt)
    if sdn != "" {
      // A declared name is ONE identifier, so one atom — the same bank
      // `tyToEmitNameAt` fills for its own renders, set here because this arm
      // returns without calling it.
      emitNameAtoms = 1
      return sdn
    }
    // The application spelling is likewise ONE top-level atom (`genAppNameOfTy` says so on
    // its own bank, which is the NOMINAL renderer's; this producer's callers read the EMIT
    // one). Declines for an uninstantiated or cyclic argument, so a member with no finite
    // application name still falls through to the structural render.
    const gan = genAppNameOfTy(smt)
    if gan != "" {
      emitNameAtoms = 1
      return gan
    }
  }
  // A DECLARED UNION member renders as its own ALIAS NAME, at EVERY position — the
  // same nominal-first rule the object arm above applies, and the one that makes
  // `type A = K` spell byte-identically to `K`. It cannot be left to the structural
  // render below, for the same reason the object arm cannot: that render drops the
  // declared name the emitter's tables key on. For a LITUNION the loss is a
  // position-dependent one — `tyToEmitNameGo`'s litunion leg is
  // `ctxKeepsLitUnion`-gated, so at `RC_ROOT` / `RC_FN_PARAM` it softens to `string`
  // while the ALIAS spelling canon leaves untouched stays `K`: one type, two names,
  // and the atom/string rep split that follows. That gate belongs to the INLINE member
  // list (a name the emitter has no root/param ladder arm for), never to an identifier.
  //
  // A NUMERIC litunion alias is DELIBERATELY NOT NOMINAL, and the guard is the one
  // home that owns the rule: `numLitUnionAliasName` rewrites `type Z = 0 | 1` to its
  // BASE SCALAR, so `Z` is not the emitter's name for it and the structural render
  // (`i32`, via `tyLitBaseName`) is. Rendering the alias here would spell a union name
  // for a plain i32 slot — the very shape this arm exists to remove.
  const uan = unionAliasDeclNameOfTy(smt)
  if uan != "" {
    if numLitUnionAliasName(uan) == "" {
      // An alias name is ONE identifier — one atom, as on the two arms above.
      emitNameAtoms = 1
      return uan
    }
  }
  tyToEmitNameAt(smt, ctx)
}

// The BASE-SCALAR emit name of a NUMERIC literal-union type (`0 | 1` → "i32",
// `1.5 | 2.5` → "f64", the one-member `1` → "i32"), or "" for anything else —
// a string litunion, a mixed-base union, a union with a non-literal member.
//
// `softenLitTy` IS the rule (host: "a numeric-literal union is its base type for
// ARITHMETIC and ordering — the union constrains what may be ASSIGNED, not what may
// be computed"), so this is a projection of the checker's own algebra, not a second
// answer: it returns the type unchanged for every set it does not claim, and only a
// homogeneous all-`TyLit` union moves.
//
// The STRING base is excluded on purpose. `type K = "a" | "b"` keeps its alias NAME at
// emit because that name IS the atom identity (`nodeTyIsLitUnionAlias` → the interned
// i32 atom rep); softening it to `string` would store an atom id in a `(ref $array)`
// cell. A numeric literal union has no such identity to keep — its members ARE i32s.
//
// A one-member union WRAPPER is peeled first (`type Y = Z`): the parser encodes every
// non-`{`-bodied `type N = …` as a one-member `UnionDecl`, so an alias-of-an-alias is a
// union over a union. Depth-bounded rather than free recursion — a declared type may be
// cyclic (`applyGenAlias` registers an instance under its own index; see #1127's
// `guardFiniteUserTypes`) and this runs BEFORE any emit-side finiteness guard.
// EXPORTED for `emit_rewrite.unionParamPinName`, the un-annotated callback-param pin, which
// needs this rule for a reason canon cannot cover for it: canon rewrites NAMES in annotations,
// and that selector reads the type ARENA (this entry) and the registered `unNames` ROWS (the
// name-keyed entry below) — neither of which is an annotation. Same rule, same home, no second
// answer; see that call site for the wasm it got wrong without it.
export function numLitUnionBaseName(ty: i32): string {
  let cur = ty
  let peels = 0
  while peels < 8 {
    if cur < 0 { return "" }
    const t = T.tys[cur]
    let inner = -1
    if t is TyUnion {
      if t.uMembers.length == 1 { inner = t.uMembers[0] }
    }
    if inner < 0 {
      peels = 8
    } else {
      cur = inner
      peels = peels + 1
    }
  }
  if cur < 0 { return "" }
  const soft = softenLitTy(cur)
  if soft == cur { return "" }
  if soft < 0 { return "" }
  const st = T.tys[soft]
  if st is TyPrim {
    const pn = st.primName
    if pn == "i32" || pn == "i64" || pn == "f64" { return pn }
  }
  ""
}

// The single base NUMERIC scalar every value of `ty` reps as at emit — `"i32"` /
// `"i64"` / `"f64"` — or "" when `ty` is not uniformly one of the three.
//
// This is the RECEIVER side of the numeric-litunion `is` membership test, and it has to
// answer for the MIXED spellings the tested type never carries: `K | i32` and `K | f64`
// (a numeric litunion beside its own base) collapse to that base with NO union box —
// every member softens to the same scalar, so the union has exactly one rep and the
// emitter gives the binding a plain `i32` / `f64` local. `numLitUnionBaseName` cannot
// answer for those: `softenLitTy` leaves a union alone the moment a member is not a
// `TyLit`, which is precisely what the `i32` arm of `K | i32` is.
//
// A `boolean` / `char` / `string` / `f32` member answers "" — they are not one of the
// three names, so an i32-repped `boolean` never presents as the i32 a numeric compare
// would then be emitted against.
//
// The walk is an explicit WORKLIST rather than recursion, and it is STEP-BOUNDED for the
// same reason `numLitUnionBaseName` peels under a bound: a declared type may be cyclic
// (`applyGenAlias` registers an instance under its own index) and this runs with no
// finiteness guard in front of it. Exceeding the bound answers "" — the conservative
// direction, since every consumer treats "" as "not my shape".
function tyNumScalarBaseName(ty: i32): string {
  const work: i32[] = [ty]
  let wi = 0
  let base = ""
  while wi < work.length {
    if wi >= 64 { return "" }
    const cur = work[wi]
    wi = wi + 1
    if cur < 0 { return "" }
    const t = T.tys[cur]
    if t is TyUnion {
      let i = 0
      while i < t.uMembers.length {
        work.push(t.uMembers[i])
        i = i + 1
      }
    } else {
      let nm = ""
      if t is TyPrim { nm = t.primName }
      if t is TyLit { nm = tyLitBaseName(t) }
      if nm != "i32" && nm != "i64" && nm != "f64" { return "" }
      if base == "" { base = nm }
      else if base != nm { return "" }
    }
  }
  base
}

// The base numeric scalar node `ix`'s recorded type reps as, or "" — `tyNumScalarBaseName`
// as the node query the emitter asks (it holds nodes, not arena indices, and reads every
// other type fact of an `is` receiver through a wrapper of exactly this shape).
export function nodeNumScalarBaseName(ix: i32) {
  tyNumScalarBaseName(nodeTyIxOf(ix))
}

// The member literal TEXTS (raw lexemes) of a NUMERIC literal-union type `ty`, in source
// order — `0 | 1` -> ["0","1"], `1.5 | 2.5` -> ["1.5","2.5"], the one-member `1` -> ["1"].
// Empty for anything `numLitUnionBaseName` does not claim, so a STRING litunion answers
// empty here and a numeric one answers empty in `tyLitMemberTexts`: the two extractors
// partition the literal kinds exactly as the two REPS do (an interned atom / member string
// for the string kinds, a plain base scalar for the numeric ones), and neither can hand a
// caller a text of the kind it is not lowering for.
//
// The one-member `UnionDecl` wrapper the parser mints for `type Y = Z` is peeled on the
// same bound `numLitUnionBaseName` peels on, so an alias-of-an-alias yields the members.
export function tyNumLitMemberTexts(ty: i32) {
  const out: string[] = []
  if numLitUnionBaseName(ty) == "" { return out }
  let cur = ty
  let peels = 0
  while peels < 8 {
    if cur < 0 { return out }
    const t = T.tys[cur]
    let inner = -1
    if t is TyUnion {
      if t.uMembers.length == 1 { inner = t.uMembers[0] }
    }
    if inner < 0 {
      peels = 8
    } else {
      cur = inner
      peels = peels + 1
    }
  }
  if cur < 0 { return out }
  const ct = T.tys[cur]
  if ct is TyUnion {
    let i = 0
    while i < ct.uMembers.length {
      const m = T.tys[ct.uMembers[i]]
      if m is TyLit { out.push(m.litText) }
      i = i + 1
    }
    return out
  }
  if ct is TyLit { out.push(ct.litText) }
  out
}

// The emit name of a DECLARED alias for a numeric literal union, or "". Exported for the
// registered-ROW reader `numLitUnionBaseName`'s note names.
export function numLitUnionAliasName(name: string) {
  if !cUserTypes.has(name) { return "" }
  const ti = cUserTypes[name] ?? -1
  if ti < 0 { return "" }
  numLitUnionBaseName(ti)
}

// True if `name` is an APPLICATION of a DECLARED generic alias whose argument list closes
// the whole name (`Box<i32>`, `Pair<i32,string>`) — not `Box<i32>[]` (an array of one) and
// not `Box<i32>|Tag` (a union carrying one), whose suffix / separator a caller peels first.
// The head is checked against the generic-alias registry (`gaIndexOf`) rather than being
// taken on the spelling's word, so an unrelated name that merely ends in `>` never matches.
function nameIsGenAppOfDecl(name: string) {
  // The whole spelling test — `n < 3`, the trailing `>`, the hand-rolled first-`<` loop and
  // its `lt <= 0` reject — is `annGenAppSpanEnds` at its home in `tyname.vl`, in that same order. Only
  // the REGISTRY lookup is this function's own, and it takes the head cut from `gaeLtAt` —
  // through `tyname.gaeHeadNameOf` (W2), the cut given that index.
  if !annGenAppSpanEnds(name) { return false }
  gaIndexOf(gaeHeadNameOf(name, gaeLtAt(name))) >= 0
}

// The STRUCTURAL emit name of a generic-alias APPLICATION standing as one member of a
// MULTI-member declared union (`type U = Box<i32> | Tag` → "{v:i32}"), or "" when `member`
// is not such an application or its instance is not an object type.
//
// Same shape of defect, and same resolution, as the one-member alias above: the emitter has
// no route to a union MEMBER under an application name. `collectU` asks `isStructAtom`, which
// answers from the `TypeDecl` names — and a generic alias declares `Box<T>`, never `Box<i32>`
// — so the member is dropped from `uVariants` while the alias still registers in `unNames`.
// The annotation then classifies as the union BOX and the initializer lowers the plain
// struct: silent INVALID WASM, for every construction site of that member (global, local,
// argument, return, reassignment).
//
// STRUCTURAL for the reason #1122 measured: the application's own name resolves nothing
// downstream (the instance interns under it only when a TypeRef spells it, which a union
// member is not), whereas the inline shape is the vocabulary `isStructAtom` already accepts —
// `type U = {v:i32} | Tag` compiles and runs today, and so does the `type A = Box<i32>;
// type U = A | Tag` spelling, which reaches exactly this shape through `singleMemberAliasTyIx`.
function unionMemberGenAppShape(member: string) {
  if !nameIsGenAppOfDecl(member) { return "" }
  const ti = nameToTy(member)
  if ti < 0 { return "" }
  const t = T.tys[ti]
  if t is TyObj { return tyToEmitName(ti) }
  ""
}

// The TOP-LEVEL atom count of the name the LAST `canonEmitName` call returned, and its
// `nulLitUnionPreserve` sibling. `canonEmitTypeNames` — the pass that PRODUCES every
// emit-time annotation spelling — reads it instead of re-splitting the string it has just
// joined (#1113, retiring the `unionMemberCount(c)` #1112 banked with).
//
// The invariant that makes it total: a canon'd name gains a TOP-LEVEL `|` at exactly two
// places, the union arm's join and `nulLitUnionPreserve`'s `|null` suffix. Every other arm
// either recurses (and inherits the recursive count) or builds a name whose separators
// are inside a grouper / behind a top-level `=>` — ONE atom. The `!nameNeedsCanon`
// early-out is the load-bearing case, and it is exact by that predicate's own shape: it
// returns TRUE on any `|` ANYWHERE in the name, so a name that reaches the early-out has
// no `|` at all.
//
// Neither is an arena-lifetime sidecar (method note 7): both are scalars written on the
// way out of a call and read by the immediate caller, never carried between programs.
let canonAtoms = 1
let nluAtoms = 1
let lupAtoms = 1

// THE PRE-CANON SPELLING of every annotation inside a GENERIC DECLARATION — a generic
// alias's field annotations and a generic function's parameter/return annotations — as a
// node-index column and the name each node carried BEFORE `canonEmitTypeNames` rewrote it.
// Read by `emit_collect.gaeCollectDecls` and `emit_mono` through `declAnnRawTyName`.
//
// The canon pass is a NAME rewrite with no SCOPE: it resolves `Id` through the declared
// registry wherever `Id` is written. Inside the body of `type Box<Id> = { v: Id }` that is
// the wrong answer — there `Id` is the alias's own type PARAMETER, and the checker says so
// (`tsLeafTy` asks `tpEnvTyOfName` before `declaredTyOfName`, so it reports `Box<string>`
// as `{v: string}`). Transparency rewrote the field annotation to `i32` before the emitter
// ever saw it, so `gaeCollectDecls` recorded `i32` against a parameter list holding `Id` and
// `emit_base.gaeApplyFieldTy` had nothing left to match: the field kept the ALIAS's body
// type while the checker had bound the parameter to the ARGUMENT. Two answers for one field,
// `vl check` rc=0, and a module that does not parse.
//
// A SIDECAR rather than a suppression, and that is MEASURED. Teaching `canonEmitNameAt` to
// leave a live parameter name alone fixes the same 84 cells but REDDENS 8 that are green on
// master — every depth-2 field at the no-op instantiation (`type Id = i32` +
// `type Box<Id> = { v: Id[][] }` at `Box<i32>`). Surviving in the ARENA, `Id[][]` is a
// nested list whose ELEMENT is a name `collectU` has registered (a one-member alias is still
// a `UnionDecl`), so the ref-list intern gave the inner row a union BOX element and the
// literal `[[1]]` lowered into it — `expected i32, found (ref $type)`. The substitution is
// the only consumer that wants the parameter name back; every other pass wants exactly what
// canon produces. So the arena keeps its single vocabulary and the substitutions get a
// second column.
//
// THE FuncDecl HALF IS THE SAME DEFECT AT A DIFFERENT DECLARATION, and it was measured as
// its own 11 x 6 grid (the shadowed name's KIND x the CALL ARGUMENT's type, each against a
// `<T>`-named control): `type Id = i32` + `function ident<Id>(v: Id): Id` was invalid wasm
// in 49 of 66 cells with a CORRECT control in every one. The green 17 are the diagonal —
// where the argument's type happens to equal what the alias names, so the erasure is a
// no-op — plus the two rows canon does not rewrite (a declared struct, and a STRING literal
// union, whose alias name canon deliberately keeps).
let cgpFieldNodes: i32[] = []
let cgpFieldRaw: string[] = []

// A NULLABLE LITERAL-UNION's preserved canonical name, or "" if `parts` (the top-level `|`-split
// members of a union annotation) are not one. `K | null` / `"a" | "b" | null` must keep the litunion
// members intact — the generic union soften below collapses each quoted literal to `string`, erasing
// the litunion identity and mis-routing the type to the `string | null` ref box (kind 16) instead of
// the i32 ATOM NICHE (`-1` = null). Reconstructs as `<litunion-core>|null` (alias preserved, literals
// kept quoted), which `nameIsNulLitUnion` recognizes and `vtKindOfType` maps to the i32 kind 0.
function nulLitUnionPreserve(parts: string[], ctx: i32) {
  let hasNull = false
  const rest: string[] = []
  let i = 0
  while i < parts.length {
    if parts[i] == "null" { hasNull = true } else { rest.push(parts[i]) }
    i = i + 1
  }
  if !hasNull { return "" }
  if rest.length == 0 { return "" }
  let core = rest[0]
  let j = 1
  while j < rest.length {
    core = core + "|" + rest[j]
    j = j + 1
  }
  if nameIsLitUnionType(core) {
    // The reconstructed name's atom count, banked for `canonEmitName` (#1113): `rest`
    // holds TOP-LEVEL members of the original split (so none carries a top-level `|` of
    // its own) and the `null` arm adds one. Duplicate `null` members collapse into the
    // single suffix, which is why this is `rest.length + 1` and not `parts.length`.
    nluAtoms = rest.length + 1
    return core + "|null"
  }
  // THE SAME QUESTION, THROUGH ONE GROUPING PAREN — and it is the SIBLING CLASSIFIER'S
  // RUNG, not a new one. A top-level `|` split hands out a part that still carries the
  // grouper the source wrote: `(("a" | "b") | null)[]` splits its ELEMENT into
  // `("a"|"b")` + `null`, so `core` arrives GROUPED and `nameIsLitUnionType` declines it
  // by construction — its inline leg (`nameIsInlineLitUnion`) opens with an O(1) reject
  // that requires the name to BEGIN with a quote. `litRunPartTexts`, the 2026-07-29
  // ruling's own member classifier 130 lines below, already states the rule this arm was
  // missing — *"a GROUPER is not a member: `("a"|"b")` contributes exactly what its
  // interior does"* — and carries the identical two-conjunct guard, exact on a split part
  // because such a part can hold no top-level `|` of its own.
  //
  // WITHOUT IT, ONE ARENA TYPE GOT TWO SPELLINGS AND THE CORPUS HELD BOTH:
  // `("a"|"b")[]|null` canon'd to `K[]|null` (preserved, aliased) while its sibling
  // `(("a"|"b")|null)[]` canon'd to `(string|null)[]` (softened) — the same litunion, one
  // grouping paren apart, and BOTH renderers spelled the second `(K|null)[]`.
  // `tests/cases/lists/litunion-inline-nullable-element.vl`'s own header records what the
  // softened spelling cost: `nameIsStringArray` accepted `(string|null)[]` as its niche, so
  // atom ids built into a string-list slot were read back through the string backing, and
  // the rejects had to be re-derived STRUCTURALLY because the name had nothing left to
  // reject on.
  //
  // The interior goes to the NON-NULL sibling rather than being re-tested here, so the
  // declared-ALIAS preference (`litUnionAliasOfLitTexts`, "a name that is an intern KEY
  // must be one name per type") keeps exactly one home and cannot drift from it.
  if nameIsParenSpanEnds(core) && !isTopLevelFuncTypeName(core) {
    const iparts: string[] = []
    tyTopLevelSplit(groupInnerOf(core), '|', false, iparts)
    const lup = litUnionPreserve(iparts)
    if lup != "" {
      // `litUnionPreserve` banks its own width (1 for an alias, one per kept member
      // otherwise); the `null` arm adds one, exactly as the ungrouped path above.
      nluAtoms = lupAtoms + 1
      return lup + "|null"
    }
  }
  // …AND THROUGH ONE TRANSPARENT ALIAS, which is the THIRD spelling of the same question.
  // `type K2 = K` and `type NK = new K` DENOTE the litunion, but `nameIsLitUnionType` reads the
  // alias's OWN `cUserTypes` entry — the one-member wrapper, not a litunion — so both rungs above
  // decline and canon SOFTENED `K2 | null` to `string | null`. The non-null spelling never hits
  // this: canon resolves a transparent alias at the LEAF, and only a top-level `|` split reaches
  // here with the alias still spelled. Softened, a `{[string]: K2 | null}` map built its vals slot
  // `(ref null $aTypeIdx)` while every read lowered the i32 atom — check-clean INVALID WASM. One
  // canon hop on the core is exactly the resolution the leaf arm would have given it, and the
  // `isTransparentAlias` gate keeps every ordinary `T | null` off the extra call.
  if isTransparentAlias(core) {
    const cCore = canonEmitNameAt(core, ctx)
    if nameIsLitUnionType(cCore) {
      nluAtoms = canonAtoms + 1
      return cCore + "|null"
    }
  }
  // A NULLABLE UNION OF LITERAL UNIONS (`K | K2 | null`) DELIBERATELY DOES NOT FLATTEN
  // HERE, and the gate is the ARENA's: `annUnionInnerTy` declines a `null`-carrying
  // annotation, so flattening the SPELLING alone would put the two producers back in the
  // state this slice exists to end — canon naming an atom niche while every arena
  // classifier answers "not a literal union". Measured, on the 20-cell nullable row:
  // canon-only is 4 cells DOWN, arena+canon together is 10 UP and 3 DOWN, and the 3 are
  // the declared-alias control's own pre-existing holes. The niche half ships with those,
  // not before — see `annUnionInnerTy`'s header for the numbers.
  ""
}

// True at the render POSITIONS where a literal union keeps its members — the four the
// structural renderer already preserves a litunion ALIAS at (`tyToEmitNameGo`'s `TyArray`
// element, `TyObj` field, `TyMap` value and `TyFunc` result arms each call
// `litUnionAliasNameOfTy` before recursing). O3 of the one-agreed-renderer design states the
// policy as position-dependent in BOTH directions, and this is its positive half.
//
// FALSE at `RC_ROOT` and `RC_FN_PARAM`, and that is MEASURED, not stylistic: an ungated
// preserve reddens four cells that are green on master — a bare inline litunion as a
// function PARAM (`emitProgram: only i32, i64, f64, f32, boolean, struct, union, array, or
// string parameters are supported`) and as a DECLARED struct field (`emitProgram: only i32 /
// boolean / string / array struct fields are supported`), because those two valtype ladders
// have an arm for the litunion ALIAS name and none for the inline member spelling. The
// renderer softens at exactly those two positions too, for the same reason.
function ctxKeepsLitUnion(ctx: i32) {
  if (ctx & RC_ELEM) != 0 { return true }
  if (ctx & RC_FIELD) != 0 { return true }
  if (ctx & RC_MAP_VAL) != 0 { return true }
  if (ctx & RC_FN_RES) != 0 { return true }
  false
}

// THE MIXED-UNION SPELLING HAS NO POSITION GATE, AND THAT IS A MEASURED RESULT, NOT AN
// OMISSION. The 2026-07-29 preserve ruling does not fully land today because the EMITTER
// holds a THIRD copy of the soften rule — `emit_classify.canonLitUnionArms`, reached from
// `rlCanonLitUnionAtoms` (ref-list ELEMENT names) and `mvCanonValName` (map VALUE names) —
// which rewrites a litunion ATOM of a mixed union to `string`. The union ROW, meanwhile,
// is registered under the CANON'D ANNOTATION, so preserving here makes the row and the
// query two different strings:
//
//   type K = "a" | "b"
//   function mk(): (K | f64)[] { return ["a", 2.5] }
//   function go() { const xs = mk(); const v = xs[0]; if v is K { print(v) } }
//   go()
//   // emitProgram: union box atom test on a union with no recorded members: string|f64
//
// TWO POSITION GATES WERE BUILT AND BOTH ARE REFUTED, which is why neither is here:
//
//  · soften at `RC_ELEM` only — the emitter's normalizer DESCENDS (`X[]` → element,
//    `{[K]:V}` → value, `{f:T}` → field), so a field under an element still forks:
//    `tests/cases/maps/litunion-struct-field-array-value-closure-factory.vl`
//    (`{[string]: {f: K0 | f64}[]}`) stays rc 0 → 1.
//  · soften at `RC_ELEM | RC_FIELD | RC_MAP_VAL` — the normalizer's whole reach — fixes
//    that one and breaks TWO OTHERS (`types/declared-vs-inline-mixed-union-field-twin`,
//    `unions/struct-field-array-of-struct-union`), because the union REGISTRY is keyed by
//    NAME and is blind to position: a rule that spells one arena type `K0|{w:i32}` at the
//    root and `string|{w:i32}` as a field mints TWO rows for ONE type, which is the very
//    fragmentation both rulings exist to prevent.
//
// So the spelling must be position-INDEPENDENT, and the only two position-independent
// rules are "soften everywhere" (master) and "preserve everywhere" (this file). The
// emitter half is filed with its exact diff in
// `docs/internals/destringify-types-program.md` (2026-07-29).
//
// A PURE literal union's preserved canonical name, or "" if `parts` (the top-level `|`-split
// members of a union annotation) are not one. The non-null sibling of `nulLitUnionPreserve`:
// `"a" | "b"` must keep its members intact, because softening each to `string` and deduping
// erases the litunion identity and reps the annotation as a STRING REF where its `K` alias
// spelling reps as the interned i32 ATOM. Duplicate members collapse (`"a" | "a"` is one atom),
// which is what the softening path's own `kept` dedup did and what the arena does.
function litUnionPreserve(parts: string[]) {
  const kept: string[] = []
  let i = 0
  while i < parts.length {
    let dup = false
    let j = 0
    while j < kept.length {
      if kept[j] == parts[i] { dup = true }
      j = j + 1
    }
    if !dup { kept.push(parts[i]) }
    i = i + 1
  }
  if kept.length < 2 { return "" }
  let core = kept[0]
  let k = 1
  while k < kept.length {
    core = core + "|" + kept[k]
    k = k + 1
  }
  if nameIsLitUnionType(core) {
    // A DECLARED alias with exactly these members WINS the spelling — the same preference
    // `litUnionAliasNameOfTy` gives the structural renderer, for the same reason: a name
    // that is an intern KEY must be one name per type. Without it the two spellings of one
    // litunion map type mint TWO `{[string]:…}` shape slots, so a `{[string]: ("a"|"b")[]}`
    // value handed to a `{[string]: K[]}` parameter is still invalid wasm — preserved or
    // softened, a second spelling is a second row.
    //
    // The member texts are recovered by dropping each kept member's surrounding quotes —
    // the exact inverse of the `"\"" + litText + "\""` every literal RENDER writes
    // (`tyToStr`), on a member `nameIsLitUnionType` has just confirmed is a quoted literal.
    // That drop is the GROUP-INTERIOR cut at its home (`tyname.groupInnerOf`, W1): the
    // operand is one top-level atom of a litunion type NAME, and the guard is the
    // `nameIsLitUnionType(core)` test on the line above — a SIXTH guard shape, and the
    // only one in the family whose receiver is an INDEX expression rather than a name.
    const texts: string[] = []
    let q = 0
    while q < kept.length {
      texts.push(groupInnerOf(kept[q]))
      q = q + 1
    }
    const al = litUnionAliasOfLitTexts(texts)
    if al != "" {
      // An alias name is ONE identifier — one atom.
      lupAtoms = 1
      return al
    }
    // Each kept member is a TOP-LEVEL member of the original split, so none carries a
    // top-level `|` of its own and the join writes exactly `kept.length - 1` separators.
    lupAtoms = kept.length
    return core
  }
  // A UNION OF LITERAL UNIONS IS A LITERAL UNION — the leg above answers only when every
  // part is a quoted LEXEME, so `K | K2` fell past it. See `litUnionFlatten`.
  litUnionFlatten(parts)
}

// ── the FLATTEN: a union all of whose members are literal unions IS a literal union ──
// `K | K2` spells the litunion whose members are the UNION of `K`'s and `K2`'s
// (`"aa"|"bb"|"cc"|"dd"`), which reps as the interned i32 ATOM and never boxes. Returns
// that spelling, or "" when some part of `parts` is not literal-derived.
//
// THIS IS `annUnionInnerTy`'s RULE, MIRRORED ONTO THE STRING SIDE, and the two ship
// together for a measured reason. With the arena arm in place `K | K2` interns as ONE
// `TyUnion` of `TyLit` members, so `litUnionInlineNameOfTy` — the structural renderer's
// litunion leg — spells it as its flattened member set. Canon has no arena to read: its
// `litUnionPreserve` asks `nameIsLitUnionType` of the joined PART SPELLINGS (`"K|K2"`),
// and an alias-named part is not a quoted lexeme, so without this leg the union still
// fell through to the per-member softening below — every member widened to `string`, the
// dedup collapsed it to the bare scalar, and one arena type had two spellings again. That
// is the exact disagreement #1296/#1300 and both renderers' preserve legs exist to
// prevent. (Deleting this tail while KEEPING the arena arm is sabotage C: the fixture
// fails in both tiers.)
//
// The tail below is `litUnionInlineNameOfTy`'s tail character-for-character — dedup the
// member TEXTS, prefer a DECLARED alias with exactly that set (a name that is an intern KEY
// must be one name per type), else join the quoted members and bank the width. The two
// producers agree because they run the same three steps in the same order on the same set.
//
// EVERY part must be literal-derived (`LRP_LITS`). `LRP_NEUTRAL` is NOT enough and that is
// load-bearing: a NUMERIC literal member classifies neutral and pushes no text, so
// accepting it would silently DROP the member from the flattened set (`"a" | "b" | 1`
// would spell `"a"|"b"`, a narrower type than the program wrote). The `null` arm is neutral
// for the same reason and is handled by `nulLitUnionPreserve`, which strips it before
// asking. `litRunPartTexts` is the shared member classifier, so a grouper
// (`K | ("aa"|"bb")`), a nested union (`(K | K2) | K3`) and a bare quoted lexeme all reach
// here through the one grammar.
//
// SET UNION IS THE MEANING, and `is K` stays a SUBSET test: `emitIs`'s `laTexts` ladder
// emits `id == m0 || id == m1 || …` over the TESTED type's own members, so `x is K` over a
// flattened `KO1 | KO2` answers true for exactly `K`'s members and false for the rest —
// which is what an overlapping pair (`"oa"|"ob" | "ob"|"oc"`) needs and what a duplicate
// pair (`K | K`, `K | ("aa"|"bb")`) collapses to.
function litUnionFlatten(parts: string[]) {
  const texts: string[] = []
  let i = 0
  while i < parts.length {
    const c = litRunPartTexts(parts[i], texts)
    if c != LRP_LITS { return "" }
    i = i + 1
  }
  const kept: string[] = []
  let t = 0
  while t < texts.length {
    let dup = false
    let j = 0
    while j < kept.length {
      if kept[j] == texts[t] { dup = true }
      j = j + 1
    }
    if !dup { kept.push(texts[t]) }
    t = t + 1
  }
  // FEWER THAN TWO DISTINCT MEMBERS HAS NO INLINE SPELLING — `nameIsInlineLitUnion` requires
  // 2+ quoted atoms, so a one-member set would render a name no downstream classifier
  // accepts. The identical guard sits in `litUnionPreserve` above and in the arena twin.
  if kept.length < 2 { return "" }
  const al = litUnionAliasOfLitTexts(kept)
  if al != "" {
    // An alias name is ONE identifier — one atom.
    lupAtoms = 1
    return al
  }
  let out = "\"" + kept[0] + "\""
  let k = 1
  while k < kept.length {
    out = out + "|\"" + kept[k] + "\""
    k = k + 1
  }
  lupAtoms = kept.length
  out
}

// ── the mixed-union literal-run REGROUP, canon's side (owner ruling 2026-07-29) ───────
// `tyToEmitNameGo`'s union arm regroups the flattened string-LITERAL members of a MIXED
// union back into their registered alias (`K0 | f64` renders `K0|f64`). Canon must spell
// the same union the same way or the ruling re-opens the 55-row disagreement #1296 closed,
// so this is that rule on the STRING side: same three-way member classification, same
// `litUnionAliasOfLitTexts` lookup, same "at the FIRST literal member's position".
//
// IT IS A MIRROR, AND THE MIRROR IS THE POINT. The renderer classifies ARENA members
// (`rm is TyLit` / `litKind == "str"` / the `null` prim); this classifies member
// SPELLINGS. The two must partition identically or one producer regroups where the other
// softens — which is the exact defect shape both rulings were about.

// A member spelling that is NOT literal-derived: the member that makes a union MIXED.
const LRP_OTHER = 0
// The `null` arm, or a NUMERIC literal — the renderer's walk counts neither as a run text
// nor as a mix-maker (`rm is TyLit` skips the `rgNonLit` branch, a non-`str` kind pushes no
// text), so neither does this.
const LRP_NEUTRAL = 1
// A member that flattens to one or more STRING literals: a quoted leaf, a registered
// litunion ALIAS, or an inline litunion spelling.
const LRP_LITS = 2

// Append the string-literal member TEXTS that union-member spelling `p` contributes to the
// enclosing union's flattened literal run, and report which of the three classes it is in.
//
// A member that classifies OTHER pushes NOTHING — the inline-union arm collects into a
// LOCAL and commits only when every sub-member is literal-derived — so a caller's `out`
// holds exactly the texts of the members it counted.
function litRunPartTexts(p: string, out: string[]): i32 {
  if p.length == 0 { return LRP_OTHER }
  if p == "null" { return LRP_NEUTRAL }
  // A GROUPER is not a member: `("a"|"b")` contributes exactly what its interior does.
  if nameIsParenSpanEnds(p) && !isTopLevelFuncTypeName(p) {
    return litRunPartTexts(groupInnerOf(p), out)
  }
  // An INLINE union spelling — reached through the grouper strip above, because a
  // top-level `|` split never hands out a part that still has one.
  if nameHasPipe(p) && !isTopLevelFuncTypeName(p) {
    const sub: string[] = []
    tyTopLevelSplit(p, '|', false, sub)
    const local: string[] = []
    let anyLit = false
    let si = 0
    while si < sub.length {
      const sc = litRunPartTexts(sub[si], local)
      if sc == LRP_OTHER { return LRP_OTHER }
      if sc == LRP_LITS { anyLit = true }
      si = si + 1
    }
    if !anyLit { return LRP_NEUTRAL }
    let li = 0
    while li < local.length {
      out.push(local[li])
      li = li + 1
    }
    return LRP_LITS
  }
  // A LITERAL member lexeme, through the one home for that grammar. `litMemberTy` returns
  // -1 without allocating for every ordinary name, so this costs a `[0]` read on the
  // members that are not literals at all.
  const lmt = litMemberTy(p)
  if lmt >= 0 {
    const lt = T.tys[lmt]
    if lt is TyLit {
      if lt.litKind == "str" {
        out.push(lt.litText)
        return LRP_LITS
      }
    }
    return LRP_NEUTRAL
  }
  // A registered litunion ALIAS (`K0`) contributes its own members' texts — this is the
  // member the ARENA has already flattened away by the time the renderer sees it, which is
  // why the renderer needs a regroup and this needs an expansion.
  const ai = cUserTypes[p] ?? -1
  if ai >= 0 {
    if tyIsLitUnion(ai) {
      const at = T.tys[ai]
      if at is TyUnion {
        let mi = 0
        while mi < at.uMembers.length {
          const mt = T.tys[at.uMembers[mi]]
          if mt is TyLit { out.push(mt.litText) }
          mi = mi + 1
        }
        return LRP_LITS
      }
    }
  }
  LRP_OTHER
}

// The registered litunion ALIAS that a MIXED union spelling's string-literal run regroups
// into, or "" when the spelling is not mixed, carries no run of 2+ literals, or its run
// matches no registered alias. Fills `cls` with one class per part so the substitution
// does not re-derive it.
//
// THE THREE GUARDS ARE THE RENDERER'S THREE, IN ITS ORDER: `rgNonLit` (a mixed union — a
// PURE litunion keeps the historical `string` softening, which is the `canonEmitTypeNames`
// invariant), `rgTexts.length >= 2` (a one-literal alias is not a union and never regrouped),
// and the exact-SET alias lookup (a run matching no alias keeps the per-member path).
function mixedUnionLitAliasRegroup(parts: string[], cls: i32[]) {
  const texts: string[] = []
  let nonLit = false
  let i = 0
  while i < parts.length {
    const c = litRunPartTexts(parts[i], texts)
    cls.push(c)
    if c == LRP_OTHER { nonLit = true }
    i = i + 1
  }
  if !nonLit { return "" }
  if texts.length < 2 { return "" }
  litUnionAliasOfLitTexts(texts)
}

// True if any top-level member of a `|`-split union spelling is the bare `null` arm. The
// STRING side's only way to ask the question `TyNullable` answers structurally: canon
// splits `A|B|null` into three flat siblings, so "this union is nullable" has to be read
// off a sibling rather than off an enclosing node. Feeds the sticky `RC_NULLABLE` bit, so
// the members of `A|B|null` reach their renders carrying the same position the structural
// renderers give the members of `TyNullable(TyUnion(A,B))`.
function partsHaveNull(parts: string[]) {
  let i = 0
  while i < parts.length {
    if parts[i] == "null" { return true }
    i = i + 1
  }
  false
}

// THE POSITION-FREE ENTRY — see `tyToEmitName`. `emit_collect.vl` canons a whole
// RENDER, which is `RC_ROOT` and holds no parser tree by construction.
export function canonEmitName(name: string) { canonEmitNameAt(name, RC_ROOT) }

// The same rewrite, told the POSITION the name occupies in the annotation around it,
// and holding no tree — every RECURSION into a sub-spelling enters here, because a
// canon arm cuts a SUBSTRING and the parser banked a root only for the whole one.
function canonEmitNameAt(name: string, ctx: i32) {
  canonEmitNameTs(name, ctx, -1)
}

// D-CANONFOLD — the same rewrite, told the parser's SPELLING ROOT for `name`.
//
// `canonEmitTypeNames`'s two rewrite sites are the only callers that hold one: a
// `TypeRef`'s root is `annTsOf(nodeIx)` and a `UnionDecl` member's is
// `udTsRootAt(nodeIx, k)`, and #1288 measured both funnels at 100% coverage. The
// root is consumed by exactly ONE arm — the intersection fold — because that arm
// is the only place canon still asks the checker to take a whole annotation
// SPELLING apart (`nameToTy`). Everything else canon does with the name is either
// a leaf question with a `tyname.vl` home or a recursion, and a recursion has no
// root to be handed.
//
// `root < 0` is therefore the total and unchanged behaviour, which is what every
// recursive entry, `canonEmitName`'s render callers and any un-banked annotation
// get. The fold's ladder is `annotResolve` — the SAME two-leg ladder every
// positioned annotation, the `is` test and the `UnionDecl` member registration
// already climb — so the tree route here is not a second resolver, it is the one
// the checker already uses one pass earlier on this very spelling.
function canonEmitNameTs(name: string, ctx: i32, root: i32) {
  canonAtoms = 1
  if name.length == 0 { return name }
  // A single-member union alias is transparent — RENDER its member FIRST (before the
  // `nameNeedsCanon` early-out, which would otherwise return a bare alias name unchanged), so
  // `type Id = i32` → "i32" and `type Ids = Id[]`-style nesting resolves through the arena
  // rather than through a second pass over the render. Transparency does not MOVE the name —
  // the member stands exactly where the alias stood — so the position rides through unchanged,
  // which is the whole reason this arm can render AT `ctx` instead of at `RC_ROOT`.
  const smt = singleMemberAliasTyIx(name)
  if smt >= 0 {
    const smr = transparentMemberEmitName(smt, ctx)
    // The EMPTINESS guard the predecessor carried implicitly: it tested its own render for
    // "" (`sma != ""`) and fell through to the rest of the rewriter when the member had no
    // emit name at all. Same test, one render later, so an unnameable member still reaches
    // the arms below rather than blanking the annotation.
    if smr != "" {
      // The RENDER's own atom width, as its producer reported it — the bank P0 gave the
      // second renderer for exactly this hand-off. The predecessor inherited the width from
      // the re-canon of the render; both were measured equal at every reach.
      canonAtoms = emitNameAtoms
      return smr
    }
  }
  // A declared alias for a NUMERIC literal union (`type Z = 0 | 1`, and the one-member
  // `type Z = 1`) denotes its BASE SCALAR here — the identical name the INLINE spelling
  // produces (the union arm below canons `0` and `1` to `i32` through the literal arm's
  // `softenLitTy` and dedups them to one atom). Before the `nameNeedsCanon` early-out,
  // which sees a bare
  // alias name with no digit/pipe/quote in it and returns it untouched.
  //
  // Untouched, the emitter received the ALIAS NAME, `collectU` had registered it in
  // `unNames` (a `UnionDecl` whose single variant is not a `{…}` shape is not skipped),
  // so `isUName` claimed the annotation for the `{tag, value}` UNION BOX while every READ
  // of the value lowered as the plain i32 the checker's own algebra says it is —
  // `global.get` of a `(ref $box)` handed to `__print_i32__`, SILENT INVALID WASM at
  // every read position (top level, function body, struct field, array element), with
  // `vl check` clean. The compiler named the mis-classification itself on `==`:
  // "`==` over a struct union is not supported yet".
  //
  // Both halves of the split were already right on their own: `isValueUnionBox` excludes
  // a homogeneous literal union ("all-`str` (`"a"|"b"`) or all-numeric (`0|1|2`)") and
  // `nodeTyIsUnionAlias`'s comment already asserted that `0 | 1 | 2` "canon-names i32".
  // It did not — for the ALIAS spelling — until here.
  // A GENERIC APPLICATION `Head<a1, a2>`: canon each ARGUMENT and re-render. This arm did
  // not exist, so the argument position was the ONE place in an annotation the emitter's
  // vocabulary never reached: `type Nm = string` + `type Box<T> = {v: T}` + `Box<Nm>` was
  // `vl check` rc=0 (the checker resolves `Nm` through its own registry and reports
  // `{v: string}`) and invalid wasm, because `gaeApplyFieldTy` substituted the ARGUMENT
  // TEXT verbatim and the field was recorded as `Nm` — a name `collectU` had registered as
  // a one-member `UnionDecl`, so the field interned as a union BOX while every read lowered
  // as the string it is. Swept over 9 alias-body kinds against a concrete-argument control:
  // 8 of 9 invalid wasm, all 9 controls CORRECT, and the one green row is a DECLARED struct
  // (a name canon does not rewrite, and one the emitter resolves on its own).
  //
  // BEFORE the `nameNeedsCanon` early-out, which sees no digit, pipe or quote in `Box<Nm>`
  // and returns it untouched — the same reason `numLitUnionAliasName` sits above it.
  //
  // The HEAD is deliberately NOT canon'd: it names a generic alias DECLARATION, and the
  // emitter's registry (`gaeBases`) is keyed by that declared name.
  if annGenAppSpanEnds(name) {
    const gLt = gaeLtAt(name)
    const gArgs: string[] = []
    // Both cuts are `tyname.gaeHeadNameOf` / `gaeArgsTextOf` (W2) — the census never
    // listed this arm in the family at all, and it writes BOTH halves.
    tyTopLevelSplit(gaeArgsTextOf(name, gLt), ',', false, gArgs)
    let gOut = gaeHeadNameOf(name, gLt) + "<"
    let gi2 = 0
    while gi2 < gArgs.length {
      if gi2 > 0 { gOut = gOut + "," }
      // An ARGUMENT stands where the parameter it binds stands, which is a position this
      // rewrite has no way to know — `RC_ROOT` is what every other whole-annotation entry
      // uses and what the argument text arrived carrying.
      gOut = gOut + canonEmitNameAt(gArgs[gi2], RC_ROOT)
      gi2 = gi2 + 1
    }
    // An application is ONE atom — its separators all sit inside the `<>`. Set rather than
    // inherited: the argument recursions left their own widths behind.
    canonAtoms = 1
    return gOut + ">"
  }
  const nla = numLitUnionAliasName(name)
  if nla != "" {
    canonAtoms = 1
    return nla
  }
  if !nameNeedsCanon(name) { return name }
  // A top-level UNION: canon each member and collapse duplicates (`"a" | "b"`
  // both soften to string → the bare scalar; a mixed-base union keeps each
  // softened member — `"a" | 1` stays the boxed `string|i32`). A top-level FUNCTION
  // type is NOT a union (its `=>` binds looser than `|`, the #516 rule applied to
  // `nameToTy`) — `(i32) => A | B` is a function returning a union, so it is left for
  // the function-type pass-through below, NOT split here.
  if nameHasPipe(name) && !isTopLevelFuncTypeName(name) {
    const parts: string[] = []
    tyTopLevelSplit(name, '|', false, parts)
    // A nullable literal-union (`K | null`) keeps its litunion members — see `nulLitUnionPreserve`.
    const nlu = nulLitUnionPreserve(parts, ctx)
    if nlu != "" {
      canonAtoms = nluAtoms
      return nlu
    }
    // A PURE literal union (`"a" | "b"`) keeps its members too, exactly as the `| null`
    // sibling above already does. Without this, every member softened to `string` and
    // deduped to the ONE base scalar, so an INLINE spelling reached the emitter naming a
    // STRING while its `K` ALIAS spelling kept the litunion name — two spellings of ONE
    // type carrying two reps, which is the split behind four filed miscompile families
    // (nested `("a"|"b")[][]`, an inline litunion map VALUE, an inline-SHAPE field, and a
    // `.map` callback PARAM). The emitter's name grammar was already ready for it:
    // `nameIsLitUnionType` accepts the inline member spelling (`nameIsInlineLitUnion`)
    // beside the alias name, and the `| null` form has been arriving here preserved since
    // `nulLitUnionPreserve` was written.
    const lup = litUnionPreserve(parts)
    // …and a preserve whose answer is a DECLARED ALIAS NAME is kept at EVERY position,
    // which is `ctxKeepsLitUnion`'s own measurement read exactly rather than widened.
    // That gate exists because an ungated preserve reddens four cells — a bare INLINE
    // litunion spelling as a function PARAM and as a DECLARED struct field, "because
    // those two valtype ladders have an arm for the litunion ALIAS name and none for the
    // inline member spelling". So the thing the two positions cannot take is the INLINE
    // spelling, and the ALIAS name is what they already have an arm for; gating on the
    // SHAPE OF THE ANSWER is strictly more precise than gating on the position.
    //
    // IT IS ALSO WHAT THE ARENA NOW REQUIRES. `annUnionInnerTy` gives `K | K2` the
    // DECLARED alias's own arena index when one matches, so the value's REP at every
    // position is the interned atom; leaving `RC_ROOT` spelling it `string` puts an i32
    // atom in a `(ref $array)` local — the `P15atom_store` cell, RUN-WRONG on master and
    // INVALID-WASM without this line (measured, both for `K | K2` and for the pure inline
    // spelling of an aliased set).
    //
    // `nameHasPipe` IS the alias test here: `litUnionPreserve` returns either one
    // identifier (its `litUnionAliasOfLitTexts` preference) or a `|`-joined member run,
    // and only the second is the spelling those two ladders lack.
    if lup != "" {
      const lupAlias = !nameHasPipe(lup)
      if ctxKeepsLitUnion(ctx) || lupAlias {
        canonAtoms = lupAtoms
        return lup
      }
    }
    const kept: string[] = []
    // THE MIXED-UNION LITERAL-RUN REGROUP — the OWNER'S RULING of 2026-07-29, on the
    // annotation side. `tyToEmitNameGo`'s union arm spells a mixed union's string-literal
    // run by its registered ALIAS (`K0 | f64` → `K0|f64`); without this the same union
    // canon'd to `string|f64` here, because a `K0` member is expanded through
    // `unionAliasMembers` (which renders the alias's own PURE-litunion arena type, and a
    // pure litunion softens) and a quoted member softens through the literal arm below.
    // That canon-softens / renderer-preserves split IS the 55-row Lsoft class, so the two
    // halves of the reversal ship in one slice.
    const rgCls: i32[] = []
    const rgAlias = mixedUnionLitAliasRegroup(parts, rgCls)
    let rgDone = false
    // The position every member below is rendered AT. `RC_NULLABLE` is re-derived from a
    // `null` SIBLING here because the flat split has no enclosing nullable node to inherit
    // it from, and it is OR'd with (not substituted for) the inherited bit so a nullable
    // union nested inside a nullable stays one.
    let memCtx = RC_UNION_MEM | (ctx & RC_NULLABLE)
    if partsHaveNull(parts) { memCtx = memCtx | RC_NULLABLE }
    // The kept members' atom counts, SUMMED — not `kept.length`. A kept member is
    // normally one atom, but the union-ALIAS expansion below substitutes a whole rendered
    // member SET for one member (`AB` → `A|B`), so `AB | null` keeps TWO entries and
    // joins to a THREE-atom name.
    let atoms = 0
    let i = 0
    while i < parts.length {
      // The regrouped run stands at the FIRST literal-derived member's position and the
      // rest of the run drops — character-for-character what the renderer's `rgDone` does
      // over the arena's members, and the reason the two joins agree member-for-member.
      if rgAlias != "" && rgCls[i] == LRP_LITS {
        if !rgDone {
          rgDone = true
          // An alias name is ONE identifier — one atom.
          kept.push(rgAlias)
          atoms = atoms + 1
        }
        i = i + 1
        continue
      }
      let c = canonEmitNameAt(parts[i], memCtx)
      let ca = canonAtoms
      // A union-ALIAS member flattens into this outer union (`AB | null` → `A | B | null`):
      // a union of unions is one union, so expand the alias to its members — matching the
      // inline `(A | B) | null` form the emitter recognizes. (A bare `AB` annotation has no
      // top-level `|`, so it never reaches here and stays its alias name.)
      const exp = unionAliasMembers(c)
      if exp != "" {
        c = exp
        // `unionAliasMembers` renders through `tyToEmitName`, which reports the render's
        // own atom width — the flattened member set is as wide as the alias's union.
        ca = emitNameAtoms
      }
      // A FUNCTION-type member keeps grouping parens (`((i32) => i32) | null` — a NULLABLE
      // function), so the rejoined name stays distinct from `(i32) => i32 | null` (a
      // function returning a nullable). `canonEmitName` strips a member's own wrapping
      // parens (the bare `(i32) => i32`, a top-level function type), so re-add them.
      if isTopLevelFuncTypeName(c) {
        c = "(" + c + ")"
        ca = 1
      }
      let dup = false
      let j = 0
      while j < kept.length {
        if kept[j] == c { dup = true }
        j = j + 1
      }
      if !dup {
        kept.push(c)
        atoms = atoms + ca
      }
      i = i + 1
    }
    let out = kept[0]
    let k = 1
    while k < kept.length {
      out = out + "|" + kept[k]
      k = k + 1
    }
    canonAtoms = atoms
    return out
  }
  // A top-level INTERSECTION: fold through the checker algebra (`intersectTy`),
  // then render the fold. An unrenderable fold leaves the name unchanged — the
  // emitter reports its own coverage gap.
  //
  // D-CANONFOLD: the fold asks the PARSER's spelling tree where one is banked for
  // this name, and re-parses the concatenation only where none is. `annotResolve`
  // is the shared ladder (`tsToTy(root)` on a root, `nameToTy(name)` otherwise) —
  // the same one `checkProgram`'s `UnionDecl` registration used on this very
  // member spelling one pass earlier, and the same one every positioned annotation
  // funnel climbs. So this is not a second resolver arriving; it is the sole
  // remaining whole-annotation re-parse in the canon pass reaching the route the
  // rest of the checker already takes.
  //
  // WHAT THE ROOT IS AND IS NOT: it describes `name` exactly when canon was
  // ENTERED with `name` — the whole `TypeRef` spelling, or the whole `UnionDecl`
  // member. Every recursion enters through `canonEmitNameAt` with `root = -1`, so
  // a fold reached from inside a union member / array element / function param
  // takes the NAME leg unchanged. Measured over `tests/cases` (`vl check
  // --codegen`, the ZZFR counter probe): 25 fold reaches, 23 of them at the entry
  // depth and 2 nested — so the tree route is what the arm mostly gets, and the
  // name route is what it keeps for the rest.
  if (nameHasSep(name, '&')) {
    const folded = annotResolve(name, root)
    if folded >= 0 {
      // The FOLD stands exactly where the intersection spelling stood, so the position
      // passes straight through. This arm is already `nameToTy` then render — the design's
      // P4 note that it converts by DELETING a string round-trip rather than by inventing
      // anything is visible right here, and the `ctx` it will need is now arriving.
      const r = tyToEmitNameAt(folded, ctx)
      // The FOLD's render carries its own width — `(0|1|2) & !2` folds to the one-atom
      // `i32`, but a fold that stays a union renders as one.
      const ra = emitNameAtoms
      if r != "" {
        canonAtoms = ra
        return r
      }
    }
    // The unchanged name: it reached here with no top-level `|` at all (the union arm
    // above claims every name that has one, bar a top-level function type — whose atoms
    // stop at the arrow), so it is one atom.
    canonAtoms = 1
    return name
  }
  // A trailing `[]`: canon the ELEMENT (no top-level `|`/`&` here, so the
  // suffix binds the whole core); a union element keeps its grouping parens. NOT for a
  // TOP-LEVEL function type (`(i32) => i32[]`) — there the `[]` binds the RETURN type
  // (`i32[]`), not the whole function, so it is a function returning a list, handled by
  // the function-type pass-through below — NOT an array of functions.
  // The ARRAY-NAME grammar's CUT at its home in `tyname.vl`, answering the TEST at the same time:
  // `arrElemNameRaw` yields "" for a non-array name AND for the degenerate `"[]"`, which
  // is exactly the `length > 2 && suffix` triple this replaced (`"[]"` is the only
  // length-2 array name). It allocates nothing on the reject path — the slice runs only
  // after `nameIsArray` — so the hot fall-through pays a call, not an allocation.
  const arrCore = arrElemNameRaw(name)
  if arrCore != "" && !isTopLevelFuncTypeName(name) {
    const core = canonEmitNameAt(arrCore, RC_ELEM)
    // The ELEMENT's own atom WIDTH, as the element's producer reported it. D-ELEMWIDTH:
    // master asked `nameHasPipe(core)` — a whole-name depth scan of a string this very
    // function had just finished building, to recover a number the build already knew.
    // A WIDE element (more than one top-level atom) is exactly a union element.
    const coreAtoms = canonAtoms
    // A list name is ONE atom in every form below — a union element is parenthesized
    // precisely so its `|`s stop being top-level. Set rather than inherited: the element
    // recursion left the ELEMENT's width in `canonAtoms`.
    canonAtoms = 1
    // A UNION element (`(A|B)[]`) or a FUNCTION-type element (`((i32) => i32)[]` — an
    // ARRAY OF functions, distinct from `(i32) => i32[]`, a function RETURNING a list)
    // keeps grouping parens; `canonEmitName` strips a member's own wrapping parens, so
    // re-add them — mirroring the union-member rule above.
    //
    // THE TWO TESTS ARE NOT A PARTITION AND THE OVERLAP IS THE POINT. Width and
    // `nameHasPipe` disagree on exactly one shape — a top-level FUNCTION type whose
    // RESULT is a union (`(i32) => f64|boolean`), which has a top-level `|` and is ONE
    // atom, because the function arm sets `canonAtoms = 1` and its `|` sits behind the
    // top-level `=>`. Every such name is claimed by the SECOND test, whose returned
    // expression is character-for-character the first's — so the reclassification cannot
    // reach an output. Measured both directions on both channels: 29,108 reaches
    // (1,419 corpus + 27,689 fuzz), 287 disagreements, 287/287 in that direction and
    // 287/287 `isTopLevelFuncTypeName`, and ZERO in the other direction (a wide element
    // with no top-level `|` does not exist — `canonAtoms` exceeds 1 only at the union
    // join and the `|null` suffix, both of which write the separator).
    if coreAtoms > 1 { return "(" + core + ")[]" }
    if isTopLevelFuncTypeName(core) { return "(" + core + ")[]" }
    return core + "[]"
  }
  // A parenthesized group wrapping the whole (no top-level `|`/`&`/`[]` left):
  // strip and canon the inside. NOT for a TOP-LEVEL function type whose RETURN is
  // parenthesized (`(i32) => ((i32) => i32)` — a curried/closure-returning function): its
  // leading `(` wraps only the PARAM list, so a blind first/last strip corrupts it to
  // `i32)=>((i32)=>i32`. Such a name keeps its top-level arrow (handled below).
  // The endpoint pair is the PAREN grammar's SPAN half at its home, and the CUT is the
  // GROUP-INTERIOR home `tyname.groupInnerOf` (W1) — a SPAN + arrow-reject guard, a
  // seventh shape. The empty name returned at the top of this function, so the home's
  // `length < 2` guard is never the deciding conjunct here; it would not matter if it
  // were, because `.slice` CLAMPS and the home agrees with the raw expression on EVERY
  // input — `"{".slice(1, 0)` and `"".slice(1, -1)` both evaluate to `""` (run, not
  // reasoned; #1243 measured it and the home's own header records the reading).
  if nameIsParenSpanEnds(name) && !isTopLevelFuncTypeName(name) {
    // A GROUPER is not a position: `(X)` stands wherever `X` would, so the ctx rides
    // through the strip. (O4 will decide whether the parens come back — that is a
    // question about the render, not about where it sits.)
    return canonEmitNameAt(groupInnerOf(name), ctx)
  }
  // A TOP-LEVEL function type — ANY top-level function type: canon the param list and the
  // result, re-render with the result's grouping parens when it is itself a function.
  //
  // THIS ARM USED TO CARRY A `nameIsParenSpanEnds(name) &&` CONJUNCT, so it claimed only
  // `(i32) => ((i32) => i32)` — a name that happens to END in `)` because its RESULT is a
  // parenthesized function — and `(i32) => Z` fell through to the bottom UNCHANGED. That
  // made "canon leaves a function type verbatim" the de-facto rule, with one accidental
  // exception; #1267 filed the exception as an asymmetry (the paren-result arm canons its
  // PARAMS at `RC_FN_PARAM`, so `(K0|i64) => ((i32)=>i32)` softened and `(K0|i64) => i32`
  // did not) and #1271 filed the rule itself as the root of a miscompile FAMILY.
  //
  // THE INTERIOR OF A FUNCTION TYPE IS NOT A REGION WITH ITS OWN SPELLING RULES — it is the
  // signature of some function DECLARATION, whose own parameter and return annotations this
  // very pass canons. Leave it verbatim and the two spellings of one closure fork:
  //
  //   type Z = 0 | 1
  //   function mk(x: i32): Z { 1 }        // return annotation canons at RC_ROOT → `i32`
  //   function run(m: (i32) => Z): i32 { const v = m(1); return v }
  //   print(run(mk))                      // master: INVALID MODULE
  //                                       // type mismatch: expected i32, found (ref $type)
  //
  // `annRetKind` reads the func type's result text and sees `Z`, which `collectU` has
  // registered in `unNames`, so the `$fnsig` result token is the `{tag,value}` UNION BOX
  // while `mk` — whose own annotation softened — is declared returning a plain i32. Eight
  // shapes fork that way (`(i32) => Z`, `(i32) => Z[]`, `(i32) => Z|null`, `(i32) => {a:Z}`,
  // `(i32) => {a:Z}[]`, `(Z[]) => i32`, `(Z|null) => i32`, `() => Z|null`), and #1271's
  // producer-side gate could not close one of them: gating the OTHER producer makes both
  // sides keep `Z`, which is only right when the fork's other side is a func type too.
  // Canon'ing here makes both sides SOFTEN, which is right in every position, because the
  // other side of a `$fnsig` fork is always a declaration canon'd at `RC_ROOT`.
  //
  // The rule this does NOT change is `ctxKeepsLitUnion`: a param is canon'd at
  // `RC_FN_PARAM` and a result at `RC_FN_RES`, exactly as the paren-result form already
  // was, so an inline `("a"|"b") => i32` still softens to `(string) => i32` (the honest `S`
  // token its value call already resolved through `cloCallSigKey`'s arena fallback) and a
  // DECLARED `type K = "a"|"b"` still rides through untouched — `nameNeedsCanon` sees no
  // digit, pipe or quote in a bare alias name and returns it. Both are pinned by
  // `tests/cases/closures/closure-litunion-param-valuecall.vl`.
  //
  // The `isTopLevelFuncTypeName` walk is the guard's whole content now; the PAREN-grammar
  // SPAN test that used to lead it is gone with the arm it selected. (D-ALIASREF's reading
  // of this site — "CLOSE-ONLY, no opener test at all" — is settled by deletion rather than
  // by routing.)
  if isTopLevelFuncTypeName(name) {
    // The arrow index the guard above just scanned for, not a second scan of the same
    // name for the same position (D-ARROWBANK). Nothing runs between the predicate's
    // return and this read — it is the guard's only conjunct — so the bank cannot
    // have been overwritten by another `isTopLevelFuncTypeName` call.
    // Both CUTS are `tyname.fnParamsTextOf` / `fnRetTextOf` (W4), given that banked index
    // — the pure half of a grammar whose FINDER is stuck here by the bank it writes.
    const fa = funcArrowAt
    const psStr = fnParamsTextOf(name, fa)
    let out = "("
    if psStr.length > 0 {
      const parts: string[] = []
      tyTopLevelSplit(psStr, ',', false, parts)
      let pi = 0
      while pi < parts.length {
        if pi > 0 { out = out + "," }
        out = out + canonEmitNameAt(parts[pi], RC_FN_PARAM)
        pi = pi + 1
      }
    }
    let rc = canonEmitNameAt(fnRetTextOf(name, fa), RC_FN_RES)
    if isTopLevelFuncTypeName(rc) { rc = "(" + rc + ")" }
    // A function type is ONE atom (the params are parenthesized, the result sits behind
    // the top-level `=>` where `unionMemberCount` stops). Set rather than inherited: the
    // param/result recursions left their own widths behind.
    canonAtoms = 1
    return out + ")=>" + rc
  }
  // A literal member → its base scalar, RENDERED FROM THE ARENA. This is P3 of the
  // one-agreed-renderer design: transformation (1) of the six #1199 measured — the
  // LARGEST group of canon's 81 rewrite shapes — stops being a second spelling rule and
  // becomes "build the type, widen it, render it AT THIS POSITION".
  //
  // Its dual was already the checker's: `softenLitTy` IS the widening rule (host: "a
  // numeric-literal union is its base type for ARITHMETIC and ordering"), and
  // `numLitUnionBaseName` one arm above has projected it for the ALIAS spelling since
  // #1198. What was missing was a way for canon to get an arena type at a LEAF, which
  // `litMemberTy` now supplies at the grammar's home.
  //
  // TOTAL here, so no fall-through is needed: `softenLitTy` of a `TyLit` is `litBaseTy`,
  // which returns one of exactly four prims (`string`/`f64`/`i32`/`i64`) — never `never`,
  // the only prim the renderer has no name for.
  const lmt = litMemberTy(name)
  if lmt >= 0 {
    const lbn = tyToEmitNameAt(softenLitTy(lmt), ctx)
    // A softened literal is a base SCALAR — ONE atom. Set rather than inherited: the
    // render left its own width behind in `emitNameAtoms`.
    canonAtoms = 1
    return lbn
  }
  // A residual negation (only meaningful under `&`) — leave for the emitter.
  if name[0] == '!' { return name }
  // An inline `{…}` shape: canon its field/value types. The WIDE brace-endpoint span at its
  // home in `tyname.vl` (`nameIsBraceSpanEnds`) — WIDE deliberately, because `canonShapeName` handles
  // a MAP name too (it takes the map branch on `{[`), so tightening to `nameIsShapeOpen`
  // would leave every `{[string]:V}` annotation's VALUE type un-canonicalized. The home's
  // `length >= 2` bound is implied, not added: the `name[0]` reads above already require a
  // character, and on a ONE-character name `name[0]` and `name[length - 1]` are the same
  // character, which cannot be both `{` and `}`.
  if nameIsBraceSpanEnds(name) {
    const shp = canonShapeName(name)
    // Every separator sits inside the braces — one atom. Set rather than inherited: the
    // field recursions inside `canonShapeName` left their own widths behind.
    canonAtoms = 1
    return shp
  }
  name
}

// Bank every annotation node INSIDE A GENERIC DECLARATION with the name it carries RIGHT
// NOW — i.e. before the rewrite loop below runs, so the banked spelling is the DECLARED one.
//
// TWO DECLARATION KINDS, ONE BANK. A generic ALIAS's field annotations are read straight
// off the registry pass 0a already built (`gaDeclIxs[gi]` IS the `TypeDecl` node), so the
// alias set is the checker's own; a generic FUNCTION's parameter and return annotations are
// read off the arena, because there is no equivalent registry for them. They share the bank
// and the reader because they are ONE question — "what did this annotation say before canon
// resolved it" — asked by two substitutions that must not disagree about the answer.
//
// Banked for EVERY field, not only the ones naming a parameter: which fields those are is
// `gaeApplyFieldTy`'s question (a structural walk over the annotation, gated by
// `gaeParamShadowed` at each leaf), and asking it here would be a second copy of the
// predicate that decides the substitution. The consumer asks the real one —
// `emit_collect.gaeDeclFieldTyName` takes the raw spelling only where
// `emit_base.gaeAnnHasParam` says the substitution would land, so a field like
// `type Box<T> = {v: 0|1}` keeps the canon'd `i32` it has always had.
function collectGenAliasFieldAnns() {
  cgpFieldNodes = []
  cgpFieldRaw = []
  let gi = 0
  while gi < gaNames.length {
    const decl = P.nodes[gaDeclIxs[gi]]
    if decl is TypeDecl {
      const fields = decl.tdFields
      let fi = 0
      while fi < fields.length {
        // The parser's bodyless sentinel is `tdFields == [-1]`; skip it rather than index
        // the arena with it.
        if fields[fi] >= 0 {
          const fnode = P.nodes[fields[fi]]
          if fnode is FieldDef {
            if fnode.fdType >= 0 {
              const tr = P.nodes[fnode.fdType]
              if tr is TypeRef {
                cgpFieldNodes.push(fnode.fdType)
                cgpFieldRaw.push(tr.tyName)
              }
            }
          }
        }
        fi = fi + 1
      }
    }
    gi = gi + 1
  }
  // The generic-FUNCTION half: every `<T>`-carrying `FuncDecl`'s parameter and return
  // annotations. Signature only — a `LetDecl` in the body carries the same hazard and is
  // NOT banked here, because the only consumers today are the parameter pin and the return
  // pin, and a bank entry with no consumer is a claim this file cannot check.
  let fx = 0
  while fx < P.nodes.length {
    const fnd = P.nodes[fx]
    if fnd is FuncDecl {
      if fnd.fnTyParams.length > 0 {
        const ps = fnd.fnParams
        let pi = 0
        while pi < ps.length {
          const pnd = P.nodes[ps[pi]]
          if pnd is Param {
            if pnd.parType >= 0 {
              const ptr = P.nodes[pnd.parType]
              if ptr is TypeRef {
                cgpFieldNodes.push(pnd.parType)
                cgpFieldRaw.push(ptr.tyName)
              }
            }
          }
          pi = pi + 1
        }
        if fnd.fnRet >= 0 {
          const rtr = P.nodes[fnd.fnRet]
          if rtr is TypeRef {
            cgpFieldNodes.push(fnd.fnRet)
            cgpFieldRaw.push(rtr.tyName)
          }
        }
      }
    }
    fx = fx + 1
  }
  0
}

// The DECLARED spelling of the annotation at `nodeIx`, or "" when `nodeIx` is not a banked
// one. The emitter's route back to a type-parameter name that alias transparency (or
// numeric-literal-union softening — `type Z = 0 | 1` shadows a parameter exactly as
// `type Id = i32` does) resolved out of the arena. See `cgpFieldNodes`.
export function declAnnRawTyName(nodeIx: i32) {
  let i = 0
  while i < cgpFieldNodes.length {
    if cgpFieldNodes[i] == nodeIx { return cgpFieldRaw[i] }
    i = i + 1
  }
  ""
}

// The post-check sweep: rewrite every `TypeRef` annotation and every
// `UnionDecl` variant name in the arena. Runs once at the end of
// `checkProgram` — `compileSrc` hands this SAME arena to `emitProgram`, so the
// emitter only ever sees its own vocabulary.
// The node indices `canonEmitTypeNames` REWROTE, ascending (the pass walks nodes in
// order, so the column is sorted and `canonRewroteNode` can binary-search it).
//
// WHY THIS EXISTS RATHER THAN ASKING `annTsOf`. The emitter's arena hand-over needs to
// know whether a node's recorded type still describes its spelling, and canon is the one
// pass that can break that: it is not a rename, so a name it rewrote may denote a
// different TYPE (`type Z = 0 | 1` canons to `i32`). The first gate asked `annTsOf(ti) >=
// 0` and read a surviving spelling tree as the answer — sound in one direction only.
// `clearAnnTs` does drop the tree on exactly the rewritten nodes, but it is not the ONLY
// reason a node has no tree: an emitter-SYNTHESIZED `TypeRef` never had one, and its
// `nodeTyIx` is perfectly good. Measured at the collect root: of 2,518 nodes the tree
// test rejected, **1,258 were rewritten by canon and 1,260 were not** — the converse the
// gate relied on is false half the time. So the question is asked directly instead.
export let canonCleared: i32[] = []

// MEASUREMENT (B5, the separate-column variant the owner ruling asks about): the arena
// type each REWRITTEN node's NEW spelling denotes, parallel to `canonCleared`.
// `nodeTyIx` is untouched, so no existing consumer changes; the only reader is the
// emitter's collect-site gate.
export let canonTyIxCol: i32[] = []

export function canonTyIxOf(ix: i32): i32 {
  let lo = 0
  let hi = canonCleared.length - 1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = canonCleared[mid]
    if at == ix { return canonTyIxCol[mid] }
    if at < ix { lo = mid + 1 } else { hi = mid - 1 }
  }
  -1
}

// Did `canonEmitTypeNames` rewrite node `ix` in place (and drop its spelling tree)?
export function canonRewroteNode(ix: i32): boolean {
  let lo = 0
  let hi = canonCleared.length - 1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = canonCleared[mid]
    if at == ix { return true }
    if at < ix { lo = mid + 1 } else { hi = mid - 1 }
  }
  false
}

export function canonEmitTypeNames() {
  // Reset with `annUnionAtoms` and for the same reason its note gives: a second program
  // on this instance must not inherit the first one's node indices.
  canonCleared = []
  canonTyIxCol = []
  annUnionAtoms = []
  // BEFORE the rewrite loop — the bank holds the declared spellings, which is the whole
  // point of it.
  collectGenAliasFieldAnns()
  let i = 0
  while i < P.nodes.length {
    // The atom-count bank (#1055): one entry PUSHED per node, in node order, so the
    // column is exactly `P.nodes.length` long and index == node index. A non-`TypeRef`
    // node banks -1 (there is no annotation spelling to count); a `TypeRef` banks the
    // count of the name this pass just PRODUCED — reported BY `canonEmitName` in
    // `canonAtoms` (#1113). #1112 banked it by running `unionMemberCount` over the
    // finished string, which is the same number arrived at by taking apart a string this
    // very pass had just joined; the producer knows the width of every `|` it writes, so
    // it hands it over instead. Exact, not a structural approximation — the count is
    // accumulated from the same joins that build the name.
    // Pushing (rather than pre-sizing and indexing) is what makes the reset above
    // LOAD-BEARING: without it a second program in the same instance would shift every
    // index, which the shared-instance suite catches immediately.
    let atoms = -1
    const n = P.nodes[i]
    if n is TypeRef {
      // D-CANONFOLD: this site HOLDS the parser's root for the spelling it is about
      // to rewrite, so it hands it over instead of leaving the one arm that still
      // takes a whole annotation apart (the intersection fold) to re-parse it. Read
      // BEFORE the rewrite, which is also what makes the drop below coherent.
      const c = canonEmitNameTs(n.tyName, RC_ROOT, annTsOf(i))
      // The rewrite INVALIDATES the parser's spelling tree for this node: canon
      // is not a rename, so a tree kept past it describes a different TYPE, not a
      // different spelling of the same one (`ast.clearAnnTs`, which carries the
      // measurement). Dropped BEFORE the assignment so the two never disagree.
      if c != n.tyName {
        clearAnnTs(i)
        canonCleared.push(i)
        canonTyIxCol.push(nameToTy(c))
        n.tyName = c
      }
      atoms = canonAtoms
    } else if n is UnionDecl {
      const vs = n.udVariants
      let vi = 0
      while vi < vs.length {
        // D-CANONFOLD: a member spelling is banked on THIS node in member order
        // (`setUdTs`), so the intersection fold reads the member's own tree rather
        // than re-parsing the concatenation — the same read `checkProgram`'s union
        // registration already makes (`annotResolve(variants[vi], udTsRootAt(…))`,
        // D-UDVARTY). Six of the twelve distinct fold spellings on the corpus reach
        // it from here.
        let c2 = canonEmitNameTs(vs[vi], RC_ROOT, udTsRootAt(i, vi))
        // A generic-alias APPLICATION member of a MULTI-member union resolves to its
        // structural shape (`unionMemberGenAppShape`) — the emitter has no route to it
        // under the application name. A ONE-member union is excluded: that alias is
        // already transparent on both sides (`singleAliasMemberTyIx`), and expanding its
        // variant here would additionally make `unionStructAliasShape` claim it as a
        // named struct — a second registration of a shape the annotation already resolves.
        if vs.length >= 2 {
          const gs = unionMemberGenAppShape(c2)
          if gs != "" { c2 = gs }
        }
        // …and the rewrite DROPS that root, `clearAnnTs`'s twin one table over
        // (`ast.clearUdTs`). The `TypeRef` arm above has held this invariant since
        // #1288; the member table had no post-canon reader until the fold above
        // became one, which is the whole reason it is stated here now.
        if c2 != vs[vi] {
          clearUdTs(i, vi)
          vs[vi] = c2
        }
        vi = vi + 1
      }
    } else if n is IsExpr {
      // `u is Box<i32>` against a UNION operand: the union's own member was rewritten to
      // its structural shape above, so the tested name must follow or the emitter resolves
      // no variant. Gated on the OPERAND's checked type being a `TyUnion` — read off the
      // typed-IR bank, no sidecar of its own — which is exactly the population whose
      // variants the rewrite above touched. A NULLABLE operand (`b: Box<i32> | null`) is
      // deliberately excluded: it carries no `UnionDecl`, its annotation keeps the
      // application NAME (`nullablePartOf` peels straight to it), and `is Box<i32>` already
      // resolves there — rewriting it would break the one spelling that works.
      //
      // D-ISALIAS: the same repair for a TRANSPARENT one-member alias
      // (`type L = i32[]`, `type Id = i32`, `type F = (i32) => i32`,
      // `type MyCat = Cat`). The union-variant arm above canon'd `L` to its
      // member's emit name through the transparency predicate, so an `is L` left
      // spelled `L` names a variant the emitter no longer has — and the
      // consequence is not a clean miss: for a SCALAR-element arm the emitter
      // falls through to code it cannot validate (an INVALID MODULE), and only
      // for a ref-element arm does it reach the located
      // ``is` names a type that is not a union variant`` reject. Measured on
      // master, this bites EVERY transparency arm that predates this slice —
      // `type Id = i32` in a union, narrowed with `is`, is an invalid module
      // today — so the rewrite is written against the whole rule and not
      // against the array arm that surfaced it.
      //
      // Gated on the TRANSPARENCY predicate rather than run through
      // `canonEmitName` unconditionally: the general canon softens a literal
      // member to its base scalar (`"a"` → `string`), which would destroy a
      // literal-union `is` test that resolves correctly today. The value
      // written is what `canonEmitName` computes for that same name — its
      // first arm IS this predicate followed by this render — which is the
      // invariant that keeps the two spellings of one annotation from
      // diverging.
      //
      // renderEmit P4, the SECOND of the arm's two round-trips: this site read
      // the member's render out of `singleMemberAliasName` and then fed it back
      // through the whole string rewriter (`canonEmitName(sis)`) before
      // storing it. The render IS the answer; the re-canon was measured a
      // no-op at every reach on both channels, together with its sibling above.
      const opTy = nodeTyIxOf(n.isObj)
      if opTy >= 0 {
        const ot = T.tys[opTy]
        if ot is TyUnion {
          const gis = unionMemberGenAppShape(n.isVariant)
          if gis != "" { n.isVariant = gis }
          const sit = singleMemberAliasTyIx(n.isVariant)
          if sit >= 0 {
            const sir = transparentMemberEmitName(sit, RC_ROOT)
            if sir != "" { n.isVariant = sir }
          }
          // …AND THE APPLICATION REWRITE RUNS AFTER THE TRANSPARENCY RENDER TOO, BECAUSE
          // THE MEMBER ARM ABOVE APPLIES THE TWO IN THAT ORDER. `canonEmitNameTs` resolves a
          // transparent member and only THEN does the variant loop expand an application to
          // its shape, so a member spelled `Y` for `type Y = Box<i32>` lands in `uVariants`
          // as `{v:i32}` — the render's application name, expanded. The test that names that
          // variant has to travel the same two rungs in the same order or it names
          // `Box<i32>` against a variant table holding `{v:i32}`: ``is` names a type that is
          // not a union variant``, D-ISALIAS's own failure mode arriving from the other side.
          // Idempotent, which is why the leading rewrite can stay for the DIRECT spelling: a
          // name this pass has already expanded is a `{…}` shape, and
          // `unionMemberGenAppShape` claims only an application.
          const gis2 = unionMemberGenAppShape(n.isVariant)
          if gis2 != "" { n.isVariant = gis2 }
        }
      }
    } else if n is AsExpr {
      // `x as W` where `W` is a user ALIAS of a numeric scalar (`type W = f64`).
      // FOUR emit consumers read this string and compare it to the four PRIMITIVE
      // spellings — `emitAsCast` (`tgt == "f64"` / `"i64"` / `"f32"`, else the i32
      // arm), `exprIsI64` / `exprIsF32` / `exprIsF64` (`e.asTy == "i64"` …) and the
      // value-type feature scan in `emitProgram` — so an alias fell through every
      // one of them and the cast emitted INVALID WASM (`type mismatch: expected
      // f64, found i32`) for i64/f32/f64 targets. This pass is where the emitter's
      // vocabulary is minted, and `asTy` was the one type spelling it never swept.
      //
      // The canon'd spelling is NOT re-derived from the string: `checkNode` banked
      // the cast's checked type on this very node (`nodeTyIx[ix] = checkCastNode`),
      // and `checkCastNode` admits the cast only when the target RESOLVES to one of
      // i32/i64/f32/f64 (`primNameOf(nameToTyAt(n.asTy, ix))`), so the primitive
      // name read straight off the typed-IR IS the emitter's vocabulary here — no
      // parse, and no second answer that could disagree with the checker's. The
      // four-way gate repeats `checkCastNode`'s admission rule so a REJECTED cast
      // (`TyErr`, or a non-scalar target) leaves the author's spelling alone for
      // the diagnostic that already quotes it.
      const at = primNameOf(nodeTyIxOf(i))
      if at == "i32" || at == "i64" || at == "f32" || at == "f64" {
        // `n.asTy` is the author's SPELLING, a plain string on the node, so the atom is
        // materialized here rather than the node's field changing type.
        const ats = primNameStr(at)
        if ats != n.asTy { n.asTy = ats }
      }
    }
    annUnionAtoms.push(atoms)
    i = i + 1
  }
  0
}

// ── value-comparability: may `ty` be compared with the default structural `==`? ─
// SOUNDNESS (mirrors the host's `isEquatable`): `==`/`!=` on a plain data object
// falls back to structural equality, which is sound only when EVERY component is
// itself value-comparable. Primitives and strings compare natively; a FUNCTION
// field compares by reference (same table index + captured env), so it does NOT
// make its object non-equatable; an array is equatable iff its element type is; an
// object iff all its fields are. A non-discriminated UNION (or NULLABLE, or a map)
// field is NOT value-comparable — discriminating the variant would be required
// first — so its enclosing object needs an explicit `==`. `seen` guards a cyclic
// (recursive) object shape: a type already on the stack is treated as equatable
// (its fields decide), matching the host's cycle guard.
function isEquatable(ty: i32, seen: i32[]) {
  if ty < 0 { return true }
  const t = T.tys[ty]
  if t is TyPrim {
    // Every scalar primitive (incl. string, bool) is value-comparable; `void`/`null`
    // never reach a structural compare (a nullness test short-circuits earlier).
    return true
  }
  if t is TyErr { return true }
  if t is TyVar { return true }
  if t is TyFunc { return true }
  if t is TyArray { return isEquatable(t.aElem, seen) }
  if t is TyObj {
    let si = 0
    while si < seen.length {
      if seen[si] == ty { return true }
      si = si + 1
    }
    seen.push(ty)
    const ftys = t.objFieldTypes
    let i = 0
    let ok = true
    while i < ftys.length {
      if !isEquatable(ftys[i], seen) { ok = false }
      i = i + 1
    }
    seen.pop()
    return ok
  }
  // TyUnion / TyNullable / TyMap: not structurally value-comparable.
  false
}

// ── `==`/`!=` LOWERABILITY: the ONE home for "can these operands be compared, and how" ──
// `isEquatable` one function up answers a DIFFERENT question — "are this object/array's
// COMPONENTS value-comparable" — and it is a soundness rule about fields. This answers the
// question about the OPERAND'S OWN REP: which compare core, if any, exists for it. Both the
// checker's acceptance (`checkBin`'s equality arm) and the emitter's dispatch
// (`nodeEqCmpKind` → `emitNulNicheEq` / `emitEqNonNullCore`, plus the `emitFail` backstop)
// read THIS function, so "the checker accepted it" and "the emitter can lower it" are one
// sentence rather than two guesses.
//
// THEY WERE TWO GUESSES, AND THAT IS THE DEFECT THIS CLOSES. The equatability gate above runs
// only when the LEFT operand is a `TyObj`/`TyArray`, so a `TyNullable` operand never reached
// any gate at all; the emitter's `==` ladder then classified the niche by its NON-NULL rep
// (`listOpKindOfBin` claims `i32[] | null` as an i32 list, `exprIsStrEq` claims
// `string | null`, `exprIsClosure` claims a nullable closure) and lowered the bare compare —
// `vl check`-clean INVALID WASM for the list/closure niches (a `(ref null $l)` into the
// compare frame's `(ref $l)` slot) and a `vl check`-clean runtime TRAP for the string/struct
// niches (the recovered read / the field `struct.get` on a genuine null).
//
// The token names the LOWERING, not the type:
//   ""           OPAQUE — this operand's rep does not decide the compare: a type variable,
//                the error hole, a literal or literal-union (whose interned-atom machinery
//                owns its own dispatch), a value-union BOX, and every BOX- or SENTINEL-repped
//                nullable (`boolean | null` rides the i32 sentinel 2, `i32 | null` and
//                `K | null` ride the box's null tag). Those already answer `null == null`
//                true and `null == v` false. The existing dispatch keeps them; the checker
//                accepts.
//   "none"       NO LOWERING EXISTS — the checker rejects (`unsupported-lowering`) and the
//                emitter carries the same answer as an `emitFail` backstop.
//   "scalar" · "str" · "list" · "strlist" · "reflist" · "struct" · "closure"
//                a NON-NULL rep the emitter has a compare core for.
//   "nulstr" · "nullist" · "nulstrlist" · "nulreflist" · "nulstruct" · "nulclosure"
//                a nullable REF NICHE — the same core, under the null guard
//                (`emitNulNicheEq`). These are exactly the six niches whose NON-NULL core
//                exists. The other five nullable niches answer "none" because their
//                non-null `==` has no core either: `nulmap`, and the four distinct-backing
//                scalar lists (`nulf64list`/`nuli64list`/`nulf32list` — `f64[] == f64[]` is
//                itself check-clean invalid wasm today — and the ref-list shapes deeper than
//                `i32[][]`).
export function eqCmpKindOfTy(ty: i32): string {
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyPrim {
    if t.primName == "string" { return "str" }
    // `void` / `null` / `never` never reach a value compare — a null test decides first.
    return "scalar"
  }
  if t is TyErr { return "" }
  if t is TyVar { return "" }
  if t is TyNeg { return "" }
  if t is TyLit { return "" }
  if t is TyFunc { return "closure" }
  if t is TyObj { return "struct" }
  if t is TyMap { return "none" }
  if t is TyArray { return eqCmpKindOfArrayElem(t.aElem) }
  if t is TyNullable { return eqCmpKindOfNulInner(t.nInner) }
  if t is TyUnion {
    // A DECLARED nullable alias (`type L = i32[] | null`) resolves through the `UnionDecl`
    // route and lands here as `TyUnion[i32[], null]` while the INLINE spelling of the same
    // type is a `TyNullable` — the same rep, two arena shapes. Both must reach the niche
    // answer or the alias spelling keeps the invalid wasm the inline one loses.
    const uInner = unionSoleNonNullMember(ty)
    if uInner >= 0 { return eqCmpKindOfNulInner(uInner) }
    return ""
  }
  ""
}

// The single non-null MEMBER of a two-member `X | null` union, or -1 when `ty` is not that
// shape (a wider value union, or one with no `null` member).
function unionSoleNonNullMember(ty: i32) {
  const t = T.tys[ty]
  if t is TyUnion {
    if t.uMembers.length != 2 { return -1 }
    if isNullTy(t.uMembers[0]) { return t.uMembers[1] }
    if isNullTy(t.uMembers[1]) { return t.uMembers[0] }
  }
  -1
}

// The `==` token for an ARRAY whose element type is `elem`. The emitter has exactly three
// list-compare cores — `emitListEqICore` (i32/boolean backing), `emitListEqSCore` (string
// elements) and `emitListEqRCore` (a ref list of i32/boolean lists) — so this is a CLOSED
// list and every other element rep is "none". A HOLE element (`-1`, an un-pinned `[]`) takes
// the i32 core, which is what `exprArray` classifies an empty literal as.
function eqCmpKindOfArrayElem(elem: i32): string {
  if elem < 0 { return "list" }
  const e = T.tys[elem]
  if e is TyVar { return "" }
  if e is TyErr { return "" }
  if e is TyPrim {
    if e.primName == "i32" { return "list" }
    if e.primName == "boolean" { return "list" }
    if e.primName == "string" { return "strlist" }
    return "none"
  }
  if e is TyArray {
    const ie = e.aElem
    if ie < 0 { return "reflist" }
    const i2 = T.tys[ie]
    if i2 is TyPrim {
      if i2.primName == "i32" { return "reflist" }
      if i2.primName == "boolean" { return "reflist" }
    }
    return "none"
  }
  "none"
}

// The `==` token for a nullable `inner | null`. The BOX- and SENTINEL-repped nullables answer
// "" (they compare tag-first and are already correct on every runtime input); every remaining
// nullable is a `(ref null …)` niche, which needs the null guard and can only have one when
// its non-null rep has a core.
function eqCmpKindOfNulInner(inner: i32): string {
  if inner < 0 { return "" }
  const it = T.tys[inner]
  if it is TyPrim {
    if it.primName == "string" { return "nulstr" }
    return ""
  }
  if it is TyLit { return "" }
  if it is TyUnion { return "" }
  if it is TyErr { return "" }
  if it is TyVar { return "" }
  if it is TyNeg { return "" }
  if it is TyNullable { return eqCmpKindOfNulInner(it.nInner) }
  if it is TyFunc { return "nulclosure" }
  if it is TyObj { return "nulstruct" }
  if it is TyMap { return "none" }
  if it is TyArray {
    const ak = eqCmpKindOfArrayElem(it.aElem)
    if ak == "list" { return "nullist" }
    if ak == "strlist" { return "nulstrlist" }
    if ak == "reflist" { return "nulreflist" }
    return ak
  }
  ""
}

// The `==` lowering token for the value AST node `ix` reads — `eqCmpKindOfTy` of the type the
// checker banked for it. The emitter's whole view of the comparability question.
export function nodeEqCmpKind(ix: i32): string { eqCmpKindOfTy(nodeTyIxOf(ix)) }

// ── structural assignability: is `src` assignable to `dst`? ──────────────────
// Both are type-arena indices. The error type is assignable in both directions
// (so one failure doesn't cascade). Primitives match by name. An object is
// assignable to another when it has (at least) every target field, each field
// assignable (width + depth subtyping — the structural rule). A function matches
// on arity then parameter/return assignability (parameters contravariant). A
// value is assignable to a nullable when it is assignable to the inner type (or
// is itself nullable). A union source is assignable when EVERY member is; a union
// target accepts a source assignable to ANY member. Narrows `Ty` only.
// A param/return SLOT of a function type: numeric prims are INVARIANT here. The numeric
// widening lattice (`numWidensName`) holds for a VALUE flowing into a wider slot — codegen
// converts at the boundary — but a function VALUE's wasm functype fixes each param/result
// rep and no adapter thunk exists, so `() => i32` must not flow into a `() => i64` slot
// (accepted, it emits an i32-result functype every i64-expecting call site mistrusts —
// invalid wasm). A lambda LITERAL in that position still works: the checker seeds the
// expected return (`recordCbExpectedRet`) and the body ADOPTS it, widening at its return
// seam, so the lambda reaches this comparison already at the wider type.
function fnSlotAssignable(src: i32, dst: i32) {
  if numWidens(src, dst) { return false }
  if objNumWidens(src, dst) { return false }
  assignable(src, dst)
}

// A struct type with a numerically-WIDER field on the destination side (`{f: i32}` vs
// `{f: i64}`): assignable as a VALUE (construction converts at the field store) but NOT
// as a function-type slot — a function value's functype fixes the field rep, so the
// covariant accept emitted an i32-field shape every call site mistrusts (invalid wasm).
// The object dual of the scalar invariance in `fnSlotAssignable`; recursion covers a
// nested struct field. A lambda LITERAL in that position still works: the checker adopts
// the expected shape when the widening fields are literals (`objRetWidenAdopt`), so it
// reaches the comparison already at the wider type.
function objNumWidens(src: i32, dst: i32) {
  if src < 0 || dst < 0 { return false }
  const s = T.tys[src]
  const d = T.tys[dst]
  if s is TyObj {
    if d is TyObj {
      let i = 0
      while i < d.objFieldNames.length {
        const sf = objFieldType(s, d.objFieldNames[i])
        if sf >= 0 {
          if numWidens(sf, d.objFieldTypes[i]) { return true }
          if objNumWidens(sf, d.objFieldTypes[i]) { return true }
        }
        i = i + 1
      }
    }
  }
  false
}

// The OBJECT pair the last `objShapeAdapterless` walk stopped on. The walk is entered
// with the pair the author wrote (`Cat[]` into `Animal[]`) while the reason lives at a
// nested pair (`Cat` into `Animal`); the diagnostic names both, so the container that
// carried the pair is never mistaken for the thing that is unsupported.
let shapeAdaptSrcTy = -1
let shapeAdaptDstTy = -1
// The SOURCE EXPRESSION of that same stopped-on pair, `(…)`-peeled — banked beside the two
// types for the same reason they are: the walk is entered on the expression the author
// wrote and the pair lives one or more containers in, so the outer expression does not say
// what the claimed source form is. `{ pet: aCat }` into `{pet: Animal}` is an object
// literal whose CLAIMED pair is a pinned `Cat` field value, and `[{legs, purr}]` into
// `Animal[]` is an array literal whose claimed pair IS an object literal — reading the
// outer expression gets both backwards. -1 when the walk had no expression there.
let shapeAdaptSrcExpr = -1
// Which RULE claimed the stopped-on pair: the object-shape one (false) or the
// container-element storage-class one (true). They need different wordings — one names a
// dropped field, the other names an element whose storage changed — and the pair banked
// above does not say which, since both bank a pair. Set on every claim, beside the pair,
// so the two can never disagree.
let shapeAdaptElemPair = false

// The expression at `ix` with `(…)` peeled — the syntactic form, for the constructor
// exemption in `objShapeAdapterless`. -1 stays -1.
function ctorExprOf(ix: i32) {
  let cur = ix
  let peel = true
  while peel {
    if cur < 0 { return -1 }
    const e = P.nodes[cur]
    if e is Paren { cur = e.parInner } else { peel = false }
  }
  cur
}

// Whether every field NAME of `dst` is a field name of `src` AND the two have the same
// field count — i.e. the shapes agree on WHICH fields exist, whatever their order or
// their field types. The emitter can rebuild a value field-by-field exactly when this
// holds; a field it would have to DROP has no rebuild.
function objFieldNameSetsEq(src: i32, dst: i32): boolean {
  const s = T.tys[src]
  const d = T.tys[dst]
  if s is TyObj {
    if d is TyObj {
      if s.objFieldNames.length != d.objFieldNames.length { return false }
      let i = 0
      while i < d.objFieldNames.length {
        if objFieldType(s, d.objFieldNames[i]) < 0 { return false }
        i = i + 1
      }
      return true
    }
  }
  false
}

// The wasm ELEMENT storage class a container's element (or map key/value) type lowers
// to. Two element types in DIFFERENT classes make two unrelated CONTAINER wasm types, so
// there is no element-converting copy to insert and the flow has no lowering — the
// container twin of the object-shape rule below.
//
// MEASURED, and the measurement is why this is a CLASS test and not a type-identity one.
// Widening an element is FREE whenever the class holds: a REF element takes `| null` for
// nothing (`C[]` -> `(C | null)[]`, `string[]` -> `(string | null)[]` and
// `i32[][]` -> `(i32[] | null)[]` all RUN, because a nullable ref is the same wasm reftype),
// and so does a NICHE-nullable scalar (`boolean[]` -> `(boolean | null)[]` and
// `K[]` -> `(K | null)[]` RUN, because the sentinel lives inside the element's own value
// space). What has NO lowering is a class CHANGE: `i32[]` -> `(i32 | null)[]` boxes the
// element, `i64[]` and `f64[]` the same, `K[]` -> `string[]` swaps an interned atom for a
// ref, and `i32[]` -> `f64[]` changes the element width. Every one of those is
// `vl check`-clean invalid wasm on the base this shipped against.
//
// `ESC_UNKNOWN` always DECLINES. An inference hole, a type variable, or any shape this
// ladder does not name must never be claimed on a guess — a generic `first<T>(y: T[])`
// applied to an `i32[]` reaches here with a hole on one side.
const ESC_UNKNOWN = 0
const ESC_I32 = 1
const ESC_I64 = 2
const ESC_F32 = 3
const ESC_F64 = 4
const ESC_BOOL = 5
const ESC_STRING = 6
const ESC_REF = 7  // object / array / map / function, and any nullable or union of them
const ESC_BOX = 8  // a value union the emitter boxes — a scalar beside another atom
const ESC_ATOM = 9 // a literal union: one interned i32 id

function elemStoreClassOf(ty: i32, depth: i32): i32 {
  if ty < 0 { return ESC_UNKNOWN }
  if depth <= 0 { return ESC_UNKNOWN }
  if tyReachesHole(ty, 8) { return ESC_UNKNOWN }
  // A niche-nullable scalar reps exactly as its base does: the `| null` is a sentinel
  // inside the element, not a second element type.
  if tyIsNicheNulScalarElem(ty) {
    if tyIsNullableLitUnion(ty) { return ESC_ATOM }
    const n = T.tys[ty]
    if n is TyNullable { return elemStoreClassOf(n.nInner, depth - 1) }
    return ESC_UNKNOWN
  }
  if tyIsLitUnion(ty) { return ESC_ATOM }
  const t = T.tys[ty]
  if t is TyPrim {
    const p = t.primName
    if p == "i32" { return ESC_I32 }
    if p == "i64" { return ESC_I64 }
    if p == "f32" { return ESC_F32 }
    if p == "f64" { return ESC_F64 }
    if p == "boolean" { return ESC_BOOL }
    if p == "string" { return ESC_STRING }
    return ESC_UNKNOWN
  }
  if t is TyObj { return ESC_REF }
  if t is TyArray { return ESC_REF }
  if t is TyMap { return ESC_REF }
  if t is TyFunc { return ESC_REF }
  if t is TyNullable {
    if tyPrintsAsRef(t.nInner, 8) { return ESC_REF }
    return ESC_BOX
  }
  if t is TyUnion {
    if tyPrintsAsRef(ty, 8) { return ESC_REF }
    return ESC_BOX
  }
  ESC_UNKNOWN
}

// Do a container's source and destination element types land in different storage
// classes? Neither side may be UNKNOWN — declining on an unclassified pair is what keeps
// a generic element from being claimed on a guess.
function containerElemClassDiffers(se: i32, de: i32): boolean {
  const sc = elemStoreClassOf(se, 8)
  if sc == ESC_UNKNOWN { return false }
  const dc = elemStoreClassOf(de, 8)
  if dc == ESC_UNKNOWN { return false }
  sc != dc
}

// Does reaching `dst` from `src` need an object-shape ADAPTER that codegen does not
// have? `assignable`'s `TyObj` arm is structural WIDTH + DEPTH subtyping — it walks the
// DESTINATION's field names only, so a source carrying EXTRA fields is accepted. The
// emitter interns a struct's wasm heap type from its own field list, so the two shapes
// are unrelated wasm types: the reference does not fit the slot and there is no
// conversion to insert. Such a pair reached codegen and failed there — as invalid wasm at
// a direct store/call, and as an `indirect call type mismatch` TRAP when it sat in a
// function value's signature.
//
// SCOPE, and it is measured rather than assumed. The axis is the SOURCE's shape
// PROVENANCE, not the container and not the width-vs-depth relation:
//   - A field the destination LACKS has no lowering under ANY source form — an annotated
//     binding, a parameter, a call result, and an UN-annotated binding of a literal all
//     emit invalid wasm. That is what this answers true for.
//   - Every OTHER difference between two shapes that agree on their field names — a
//     reordered field list, a field whose own type widens, a nested shape that differs —
//     is broken for a PINNED source and CORRECT for an un-annotated binding of an object
//     literal, because the emitter re-interns that literal at the destination row. The
//     two are indistinguishable from the types alone, so this declines both: rejecting
//     them would reject working programs. They remain a `vl check`-clean emit hole, and
//     closing them needs the emitter to grow the adapter (the variance work), not a
//     wider rule here.
//
// The recursion mirrors the containers `assignable` itself recurses through — nullable
// inner, union member, array element, map key/value, function slot (parameters swapped,
// as `assignable` compares them) — so wherever `assignable` can reach an object pair,
// this can too. A bare binding breaks exactly as an array element does.
//
// An object LITERAL is exempt from the SHAPE mismatch, and that exemption is the
// workaround the diagnostic names: it is BUILT at the destination shape, so the value
// reaching the slot already has the slot's rep. Its FIELD VALUES are not exempt — each is
// judged against the destination field's type on its own — which is how `{ p: someCat }`
// into `{ p: Animal }` is caught while `{ p: { legs: 4, purr: true } }` is not. An array
// literal is exempt element-wise the same way.
//
// THE EXEMPTION IS SCOPED TO WHAT "BUILT AT THE DESTINATION SHAPE" BUYS, and a field the
// destination does not declare is outside it: building at the destination shape is
// precisely what DISCARDS such a field, initializer and all. So an EXCESS field is claimed
// for a literal exactly as for every other source form — a `{ legs: 4, purr: side() }`
// against `{ legs: i32 }` never called `side`, with no diagnostic and a valid module. The
// verdict is one clause, the failure MODE differs by source form (a wrong evaluation count
// for the literal, invalid wasm for a pinned source), and the diagnostic says which.
//
// A pair reaching an inference HOLE is never claimed: `{x: _, y: _}` is not a shape yet,
// and `tyEq` calls it different from every concrete shape.
//
// Answers only for pairs `assignable` already ACCEPTED; a rejected pair keeps its own
// diagnostic and never reaches here.
function objShapeAdapterless(
  srcExpr: i32,
  src: i32,
  dst: i32,
  depth: i32,
): boolean {
  if src < 0 || dst < 0 || depth <= 0 { return false }
  if src == dst { return false }
  const s = T.tys[src]
  const d = T.tys[dst]
  // Nullable pairs peel exactly as `assignableGo`'s nullable arm does, and in its order.
  if d is TyNullable {
    if s is TyNullable {
      return objShapeAdapterless(-1, s.nInner, d.nInner, depth - 1)
    }
    return objShapeAdapterless(srcExpr, src, d.nInner, depth - 1)
  }
  // A union SOURCE is assignable when EVERY member is, so any member needing an adapter
  // makes the whole flow one.
  if s is TyUnion {
    const sms = s.uMembers
    let si = 0
    while si < sms.length {
      if objShapeAdapterless(-1, sms[si], dst, depth - 1) { return true }
      si = si + 1
    }
    return false
  }
  // A union TARGET accepts the source at SOME member. It is adapterless only when no
  // accepting member is: one clean member is a lowering.
  if d is TyUnion {
    const dms = d.uMembers
    let di = 0
    let anyClean = false
    let anyAdapts = false
    while di < dms.length {
      if assignable(src, dms[di]) {
        if objShapeAdapterless(srcExpr, src, dms[di], depth - 1) {
          anyAdapts = true
        } else {
          anyClean = true
        }
      }
      di = di + 1
    }
    if anyClean { return false }
    return anyAdapts
  }
  const cx = ctorExprOf(srcExpr)
  if s is TyObj {
    if d is TyObj {
      // A COST early-out, not a decision: `tyEq` is render-equality, so two equal object
      // types have equal ordered field-name lists, which `objFieldNameSetsEq` below
      // declines anyway. It is here because the identical pair is the overwhelmingly
      // common one and this spares it two `tyReachesHole` walks and a field scan. A
      // one-leg sabotage of THIS line alone moves nothing, and that is expected.
      if tyEq(src, dst) { return false }
      // A pair reaching an inference HOLE is not a pair of shapes yet. An un-annotated
      // parameter used only as `o.x` demands `{x: _}`, which looks exactly like a
      // width-subtyped destination beside a two-field argument and is not one — the solve
      // pins it from the argument and it lowers. THIS LINE IS LOAD-BEARING;
      // `objects/object-shape-hole-destination-not-claimed.vl` is what holds it.
      if tyReachesHole(src, 8) || tyReachesHole(dst, 8) { return false }
      if cx >= 0 {
        const ce = P.nodes[cx]
        if ce is ObjLit {
          // The literal itself is rebuilt at `dst`; its field VALUES still have to fit
          // the destination field types, judged with their own expressions.
          const dnames = d.objFieldNames
          const dtys = d.objFieldTypes
          let li = 0
          while li < dnames.length {
            const sft = objFieldType(s, dnames[li])
            if sft >= 0 {
              let fexpr = -1
              const fl = ce.objFields
              let fi = 0
              while fi < fl.length {
                const fn = P.nodes[fl[fi]]
                if fn is FieldInit {
                  if fn.fiName == dnames[li] { fexpr = fn.fiValue }
                }
                fi = fi + 1
              }
              if objShapeAdapterless(fexpr, sft, dtys[li], depth - 1) {
                return true
              }
            }
            li = li + 1
          }
          // FALLS THROUGH to the dropped-FIELD decision below — the exemption covers what
          // "built at the destination shape" actually buys, and a field the destination
          // does not declare is not in it. `emitObj` walks the DESTINATION struct's field
          // list and looks each name up in the literal, so a field the destination lacks is
          // never visited: its initializer is never lowered, never evaluated, and its
          // side effects never happen — a silently WRONG EVALUATION COUNT rather than the
          // invalid wasm the non-literal source forms take. Both verdicts are this
          // function's, and both are the same clause of the header above ("a field the
          // destination LACKS has no lowering under ANY source form"); an arm that
          // returned here carried the field-VALUE leg of the rule and not the
          // dropped-FIELD leg. `objShapeAdapterlessErr` words the literal case for what it
          // is, since "construct the value at the destination shape" is what the author
          // already did.
        }
      }
      if objFieldNameSetsEq(src, dst) { return false }
      shapeAdaptSrcTy = src
      shapeAdaptDstTy = dst
      shapeAdaptSrcExpr = cx
      shapeAdaptElemPair = false
      return true
    }
    return false
  }
  if s is TyArray {
    if d is TyArray {
      if cx >= 0 {
        const ae = P.nodes[cx]
        if ae is ArrayLit {
          const els = ae.arrElems
          let ei = 0
          while ei < els.length {
            if (
              objShapeAdapterless(
                els[ei],
                nodeTyIxOf(els[ei]),
                d.aElem,
                depth - 1,
              )
            ) {
              return true
            }
            ei = ei + 1
          }
          return false
        }
      }
      // The nested pair FIRST, so a container carrying an object pair keeps the precise
      // object wording; only then the element's own storage class. A nested container
      // resolves through this same arm one level in, which is what makes
      // `i32[][]` -> `(i32 | null)[][]` report the INNER array pair rather than the outer.
      if objShapeAdapterless(-1, s.aElem, d.aElem, depth - 1) { return true }
      if containerElemClassDiffers(s.aElem, d.aElem) {
        shapeAdaptSrcTy = src
        shapeAdaptDstTy = dst
        shapeAdaptSrcExpr = cx
        shapeAdaptElemPair = true
        return true
      }
      return false
    }
    return false
  }
  if s is TyMap {
    if d is TyMap {
      if objShapeAdapterless(-1, s.mKey, d.mKey, depth - 1) { return true }
      if objShapeAdapterless(-1, s.mVal, d.mVal, depth - 1) { return true }
      if containerElemClassDiffers(s.mKey, d.mKey) {
        shapeAdaptSrcTy = src
        shapeAdaptDstTy = dst
        shapeAdaptSrcExpr = cx
        shapeAdaptElemPair = true
        return true
      }
      if containerElemClassDiffers(s.mVal, d.mVal) {
        shapeAdaptSrcTy = src
        shapeAdaptDstTy = dst
        shapeAdaptSrcExpr = cx
        shapeAdaptElemPair = true
        return true
      }
      return false
    }
    return false
  }
  if s is TyFunc {
    if d is TyFunc {
      const sp = s.fnParamTypes
      const dp = d.fnParamTypes
      if sp.length != dp.length { return false }
      if objShapeAdapterless(-1, s.fnRet, d.fnRet, depth - 1) { return true }
      let pi = 0
      while pi < sp.length {
        // Parameters compare contravariantly in `assignable`'s `TyFunc` arm; keep the
        // same operand order so the pair examined is the pair it accepted.
        if objShapeAdapterless(-1, dp[pi], sp[pi], depth - 1) { return true }
        pi = pi + 1
      }
      return false
    }
    return false
  }
  false
}

// The field names `src` carries that `dst` does not, rendered `` `a`, `b` ``.
function objDroppedFieldList(src: i32, dst: i32) {
  const s = T.tys[src]
  const d = T.tys[dst]
  let out = ""
  if s is TyObj {
    if d is TyObj {
      let i = 0
      while i < s.objFieldNames.length {
        if objFieldType(d, s.objFieldNames[i]) < 0 {
          if out != "" { out = out + ", " }
          out = out + "`" + s.objFieldNames[i] + "`"
        }
        i = i + 1
      }
    }
  }
  out
}

// The message for an `objShapeAdapterless` pair. It names the OBJECT pair that has no
// lowering and the fields that make it one — not the container that carried it, which is
// reported separately so a reader of `Cat[]` into `Animal[]` is not left thinking arrays
// are the unsupported thing — then the two ways out. Neither way out claims a position:
// the literal clause states what a constructor DOES (it is built at the shape it flows
// into) and holds at every position this fires from, and spelling the source at the
// target's shape holds everywhere.
function objShapeAdapterlessErr(srcExpr: i32, src: i32, dst: i32) {
  let sT = shapeAdaptSrcTy
  let dT = shapeAdaptDstTy
  let sX = shapeAdaptSrcExpr
  if sT < 0 || dT < 0 {
    sT = src
    dT = dst
    sX = srcExpr
  }
  let through = ""
  if !tyEq(sT, src) || !tyEq(dT, dst) {
    through = " (reached through " +
      tyToStr(src) +
      " into " +
      tyToStr(dst) +
      ")"
  }
  // AN OBJECT LITERAL GETS ITS OWN WORDING, because the other message's two ways out are
  // both wrong here: "construct the value at the destination shape" is what the author
  // already did, and "not yet supported by codegen" describes a build failure the literal
  // does not take. What the literal takes is SILENT — it builds at the destination shape,
  // which drops the excess field's initializer unevaluated — so the message names the
  // evaluation that would not happen, and the one way out (drop the field or declare it).
  // THE CONTAINER-ELEMENT WORDING. The object message's whole vocabulary is wrong here:
  // no field is dropped, the two shapes may be the same shape, and "construct the value at
  // the destination shape" points at an object that is not what changed. What changed is
  // how the ELEMENT is stored, so the message names that and the container it fixes.
  if shapeAdaptElemPair {
    tErrUnsupported(
      "a value of type " +
        tyToStr(sT) +
        " flowing into " +
        tyToStr(dT) +
        through +
        " changes how the ELEMENT is stored: type-valid (the element type widens) but " +
        "not yet supported by codegen — a container's wasm type is fixed by its element's " +
        "storage, so these are unrelated types and no element-converting copy exists. " +
        "Build the container at " +
        tyToStr(dT) +
        " (a literal is built at the type it flows into), or declare the source as " +
        tyToStr(dT),
      srcExpr,
    )
    return 0
  }
  if litShapeDropSrcExpr(sX) {
    tErr(
      "this object literal sets " +
        objDroppedFieldList(sT, dT) +
        ", which " +
        tyToStr(dT) +
        " does not declare" +
        through +
        ": a literal is built at the shape it flows into, so the extra field would be " +
        "dropped and its initializer never evaluated — a call there would never run. " +
        "Remove the field, or declare it on " +
        tyToStr(dT),
      srcExpr,
    )
  } else {
    tErrUnsupported(
      "an object value of shape " +
        tyToStr(sT) +
        " flowing into " +
        tyToStr(dT) +
        through +
        " drops the field " +
        objDroppedFieldList(sT, dT) +
        ": type-valid (structural width subtyping) but not yet supported by codegen — a " +
        "struct's wasm type is its own field list, so these are unrelated types and no " +
        "field-dropping conversion exists. Construct the value at " +
        tyToStr(dT) +
        " (an object literal is built at the shape it flows into), or declare the source " +
        "with exactly " +
        tyToStr(dT) +
        "'s fields",
      srcExpr,
    )
  }
}

// Is the CLAIMED pair's source (`shapeAdaptSrcExpr`, already `(…)`-peeled) an object
// literal? That is the whole difference between the two wordings, and it must be asked of
// the pair the walk stopped on: `{ pet: aCat }` is an object literal whose claimed source
// is the pinned `Cat` in `pet`, and `[{ legs, purr }]` is an array literal whose claimed
// source IS an object literal. Asking the outer expression answers both the wrong way.
function litShapeDropSrcExpr(claimedExpr: i32) {
  if claimedExpr < 0 { return false }
  const ce = P.nodes[claimedExpr]
  if ce is ObjLit { return true }
  false
}

function assignable(src: i32, dst: i32) {
  if src < 0 || dst < 0 { return true }
  if src == dst { return true }
  let gi = asgSrcStack.length - 1
  while gi >= 0 {
    if asgSrcStack[gi] == src && asgDstStack[gi] == dst { return true }
    gi = gi - 1
  }
  asgSrcStack.push(src)
  asgDstStack.push(dst)
  const ok = assignableGo(src, dst)
  asgSrcStack.pop()
  asgDstStack.pop()
  ok
}

function assignableGo(src: i32, dst: i32) {
  const s = T.tys[src]
  const d = T.tys[dst]
  if s is TyErr { return true }
  if d is TyErr { return true }
  if s is TyVar { return true }
  if d is TyVar { return true }
  // `never` (the empty type) is the BOTTOM type: assignable anywhere. (As a
  // TARGET it accepts nothing — no concrete source reaches `s.primName ==
  // d.primName` with "never" on only one side.)
  if s is TyPrim {
    if s.primName == "never" { return true }
  }
  // Nullable target: accepts `null` itself, the inner, or another nullable's inner.
  if d is TyNullable {
    if src == TY_NULL { return true }
    if s is TyNullable { return assignable(s.nInner, d.nInner) }
    return assignable(src, d.nInner)
  }
  // A nullable source is not assignable to a non-nullable target.
  if s is TyNullable { return false }
  // Union source: every member must be assignable to the target.
  if s is TyUnion {
    const members = s.uMembers
    let i = 0
    let ok = true
    while i < members.length {
      if !assignable(members[i], dst) { ok = false }
      i = i + 1
    }
    return ok
  }
  // Union target: the source must be assignable to some member.
  if d is TyUnion {
    const members = d.uMembers
    let i = 0
    let ok = false
    while i < members.length {
      if assignable(src, members[i]) { ok = true }
      i = i + 1
    }
    return ok
  }
  // LITERAL types (host `StringLiteral`/`IntegerLiteral`/`RealLiteral`): a
  // literal source is assignable to the SAME literal (a closed set's member —
  // the union-target case above already tried each member), or anywhere its
  // base scalar flows (`0` → i32, `"a"` → string). A non-literal source is
  // NEVER assignable to a literal target — `string` does not flow into
  // `"a" | "b"` (the union is a closed set, not an open string type).
  if s is TyLit {
    if d is TyLit { return s.litKind == d.litKind && s.litText == d.litText }
    return assignable(litBaseTy(s), dst)
  }
  if d is TyLit { return false }
  // A NEGATION target `!T` (A4, residual — usually folded away by
  // `intersectTy`): accepts a source NOT assignable to the negated type.
  if d is TyNeg { return !assignable(src, d.negTy) }
  if s is TyNeg { return false }
  // NOMINAL NEWTYPE (P1.5): a brand and its base — or two different brands — do not
  // flow into each other, though every structural rule below would accept them.
  // This ONE test is the whole distinctness guarantee: `assignable` is the single
  // chokepoint every position goes through (let init, assignment, argument, return,
  // struct field, array element, map key/value, union member, comparison), so no
  // position can be taught half the rule.
  //
  // PLACEMENT IS LOAD-BEARING. It sits AFTER the `TyErr`/`TyVar` holes (an errored
  // or un-inferred operand must not acquire a second diagnostic), after `never`
  // (the bottom type flows anywhere), and after the nullable / union / literal /
  // negation arms — every one of which DESTRUCTURES and recurses, so the brand is
  // compared at the level it actually sits on. `EntityId | null` accepting an
  // `EntityId` works because the nullable arm peels first and this test then runs
  // on the inner pair.
  if nomLitRelax == 0 {
    if nomNameOfTy(src) != nomNameOfTy(dst) { return false }
  }
  // The STRUCTURAL tail, EXHAUSTIVE over `Ty` and deliberately `_`-less: a 12th
  // arena variant breaks the self-compile here instead of silently answering
  // `false` = "not assignable", which is a spurious LOUD reject of a valid
  // program. Only the arms above this point are order-sensitive (see the
  // placement note); by here every `s` variant is either destructured already or
  // decided structurally, so the claimed variants are spelled as empty arms naming
  // the earlier test that returns for them.
  //
  // `TyErr` has NO ARM because it cannot: the early `s is TyErr { return true }`
  // NARROWS `s`, so `TyErr` is not a member of the scrutinee's type here and an arm
  // for it is a type error. The guard is unaffected — exhaustiveness is checked
  // against the narrowed member set, which a 12th variant joins too.
  match s {
    TyPrim => {
      if d is TyPrim {
        // Lossless numeric WIDENING (B2): a narrower numeric value flows into a wider
        // slot — annotation, argument, return — along the lattice i32→{i64,f32,f64},
        // i64→f64, f32→f64. The reverse (any narrowing, e.g. i64→i32, f64→f32, f64→i32)
        // is NOT assignable: it is lossy and must be made explicit. Codegen inserts the
        // matching wasm convert at the boundary. f32 literals reach an f32 slot via the
        // float-literal exception at the binding/arg/return sites (a float literal types
        // f64 by default but re-encodes exactly at f32). The binding takes the WIDER type.
        if numWidensName(s.primName, d.primName) { return true }
        return s.primName == d.primName
      }
      return false
    }
    TyObj => {
      if d is TyObj {
        const dnames = d.objFieldNames
        const dtys = d.objFieldTypes
        let i = 0
        let ok = true
        while i < dnames.length {
          const srcIx = objFieldType(s, dnames[i])
          if srcIx < 0 { ok = false }
          else if !assignable(srcIx, dtys[i]) { ok = false }
          i = i + 1
        }
        return ok
      }
      return false
    }
    TyArray => {
      if d is TyArray {
        // An empty `[]` (element `-1`) is assignable to any array; otherwise the
        // element types must be assignable.
        return assignable(s.aElem, d.aElem)
      }
      return false
    }
    TyMap => {
      if d is TyMap {
        // A bare `Map()`/`Set()` (key/value holes, `-1`) is assignable to any map.
        return assignable(s.mKey, d.mKey) && assignable(s.mVal, d.mVal)
      }
      return false
    }
    TyFunc => {
      if d is TyFunc {
        // A GENERIC function value (hole params/return) is assignable to a CONCRETE function type only
        // by INSTANTIATION — its body's capability must hold at the target's param types and yield the
        // target's return — NOT the structural rule below, which a hole passes unconditionally. This
        // type-level check reaches every nested position (an ARRAY element, a field) that the
        // expression-level `assignableExpr` interception does not.
        if fnTyHasHole(src) { return genericFnAssignable(src, dst) }
        const sp = s.fnParamTypes
        const dp = d.fnParamTypes
        if sp.length != dp.length { return false }
        let i = 0
        let ok = fnSlotAssignable(s.fnRet, d.fnRet)
        while i < sp.length {
          if !fnSlotAssignable(dp[i], sp[i]) { ok = false }
          i = i + 1
        }
        return ok
      }
      return false
    }
    TyVar => {
      // Claimed by `s is TyVar` at the top, which returns true.
    }
    TyNullable => {
      // Claimed by the nullable pair above: the `d is TyNullable` arm peels both
      // sides, and the bare `s is TyNullable` guard right after it returns false.
    }
    TyUnion => {
      // Claimed by the union-SOURCE arm above, which returns its `ok`.
    }
    TyLit => {
      // Claimed by the literal-SOURCE arm above, which returns on both legs.
    }
    TyNeg => {
      // Claimed by `s is TyNeg` above, which returns false.
    }
  }
  // UNREACHABLE by construction: the six empty arms above are each claimed by an
  // earlier `s`-test that returns, and the five real arms return on every leg.
  false
}

// ── per-kind helpers (take a NARROWED variant; recurse back through checkNode) ──
// These helpers receive an already-narrowed `Node` variant as a STRUCT PARAMETER,
// narrow further `Node` children themselves, and call back into `checkNode` — the
// exact shape "Finding 2" historically prohibited. The miscompile is fixed in the
// host (pinned by `tests/cases/types/union-two-visitors.vl` and
// `union-narrowed-helper-recursion.vl`), so the visitor can be factored naturally.

// Look up a generic binding by type-param name in the parallel bind arrays.
function bindOf(bNames: string[], bTys: i32[], name: string) {
  let i = 0
  while i < bNames.length {
    if bNames[i] == name { return bTys[i] }
    i = i + 1
  }
  -1
}

// The demanded shape (TyObj arena index) of hole `name`, or -1.
function holeShapeOf(name: string) {
  let i = 0
  while i < holeShapeNames.length {
    if holeShapeNames[i] == name { return holeShapeTys[i] }
    i = i + 1
  }
  -1
}

// How many fields hole `name`'s demanded shape carries right now (0 when it has
// no shape yet). The shape's `TyObj` grows IN PLACE, so an alternative records a
// COUNT, not a snapshot type.
function holeShapeFieldCount(name: string) {
  const shape = holeShapeOf(name)
  if shape < 0 { return 0 }
  const st = T.tys[shape]
  if st is TyObj { return st.objFieldNames.length }
  0
}

// The `holeAlt*` row hole `name` already carries for tested type `ty`, or -1.
// Matched STRUCTURALLY (`tyEq`) rather than by arena index for the same reason
// `noteHoleAlt` is: every pass over the body re-resolves the `is` annotation to a
// FRESH arena entry, so the index differs while the type does not. `tyEq` decides
// exactly the render-equality this used to spell as `tyToStr(a) == tyToStr(b)`,
// without building either string.
function holeAltRowOf(name: string, ty: i32) {
  if ty < 0 { return -1 }
  let i = 0
  while i < holeAltNames.length {
    if holeAltNames[i] == name && tyEq(holeAltTys[i], ty) { return i }
    i = i + 1
  }
  -1
}

// Register an `is`-guard ALTERNATIVE `ty` for hole `name`, with the fields
// demanded so far (reached before the guard) pinned as its required prefix.
// Returns the new row's index so the guard can patch `holeAltTailN` once its arms
// are checked, or -1 when there is nothing to patch (an unusable `ty`, or a row
// this alternative already has — see below).
function noteHoleAlt(holeIx: i32, name: string, ty: i32) {
  if ty < 0 { return -1 }
  // A body is checked more than once (the return-inference pre-pass, then the real
  // pass) and the demanded shape ACCUMULATES across them — it is never cleared — so
  // only the FIRST walk sees it grow from empty and can say which fields precede the
  // guard. A re-check therefore keeps the existing row verbatim (returning -1, so the
  // guard does not re-patch its tail either) rather than appending a duplicate the
  // diagnostic would render twice or refreshing it from an already-grown shape.
  // Matched STRUCTURALLY (`tyEq`), not by arena index: each pass re-resolves the
  // `is` annotation to a FRESH arena entry. `holeAltRowOf` is the same test.
  let i = 0
  while i < holeAltNames.length {
    if holeAltNames[i] == name && tyEq(holeAltTys[i], ty) { return -1 }
    i = i + 1
  }
  const pre = holeShapeFieldCount(name)
  holeAltNames.push(name)
  holeAltTys.push(ty)
  holeAltPreN.push(pre)
  holeAltTailN.push(-1)
  holeAltHoleIx.push(holeIx)
  holeAltNames.length - 1
}

// The demanded-shape fields an argument satisfying alternative `k` STILL reaches:
// the prefix demanded before the guard, plus (when the guard's then-branch does
// not diverge) the suffix demanded after it. Returns -1 when nothing is required.
function holeAltResidualTy(shape: i32, k: i32) {
  if shape < 0 { return -1 }
  const st = T.tys[shape]
  if st is TyObj {
    const names: string[] = []
    const tys: i32[] = []
    const all = st.objFieldNames
    const allTys = st.objFieldTypes
    let i = 0
    while i < holeAltPreN[k] && i < all.length {
      names.push(all[i])
      tys.push(allTys[i])
      i = i + 1
    }
    const tail = holeAltTailN[k]
    if tail >= 0 {
      let j = tail
      while j < all.length {
        names.push(all[j])
        tys.push(allTys[j])
        j = j + 1
      }
    }
    if names.length == 0 { return -1 }
    return mkObjTy(names, tys)
  }
  -1
}

// `srcExpr < 0` (a DISPATCH probe with no argument node — a UFCS receiver, an
// operator operand) checks the type alone, so the literal-aware / rep-sidecar
// recording in `assignableExpr` is not driven by a node index it does not have.
function holeAssignOk(srcExpr: i32, at: i32, dst: i32) {
  if srcExpr < 0 { return assignable(at, dst) }
  assignableExpr(srcExpr, at, dst)
}

// Does `at` (the argument expression `srcExpr`) satisfy hole `name`'s demand? The
// accumulated shape satisfies it, and so does any `is`-guard ALTERNATIVE whose
// still-reachable demanded fields (`holeAltResidualTy`) are satisfied too. True
// when the hole demands nothing.
function holeDemandOk(name: string, srcExpr: i32, at: i32) {
  // A MAP demand is checked FIRST and it is a hard requirement, not one arm of a
  // disjunction: a hole the body used the map surface on is a map, so `put(5)` where the
  // body did `q.set("a", 1)` stays the reject it is today (the `{set: _}` struct shape it
  // used to grow refused the i32 for the same reason, in worse words).
  //
  // BOTH PINS run on the way through, and they are what make the position inferable rather
  // than merely accepted. `constrainEmpty(at, hm)` pins an argument still open at the call
  // (`const m = Map(); put(m)` — otherwise `cannot infer a type for 'm'`); the reverse pins
  // a demand the callee left open from a concrete argument (`const m = Map(); m["a"] = 1;
  // take(m)`, where the callee only READS), so the emitter's param pin has a type to name.
  const hm = holeMapOf(name)
  if hm >= 0 {
    if !holeAssignOk(srcExpr, at, hm) { return false }
    constrainEmpty(at, hm)
    // A demand the callee's own operations left OPEN is not satisfiable here, and the
    // reason is ORDER, not assignability. The body has ALREADY been checked against the
    // open type, so its recorded node types are stale — a `.get` on an unpinned value
    // recorded `V | null` with no `V` — and pinning the demand from this argument now
    // would emit against those. That is bidirectional inference (ROADMAP E5), not a pin;
    // refuse, which is exactly the verdict the `{get: _}` struct shape reached before.
    if holeMapDemandOpen(hm) { return false }
  }
  const shape = holeShapeOf(name)
  if shape < 0 { return true }
  if holeAssignOk(srcExpr, at, shape) { return true }
  let k = 0
  while k < holeAltNames.length {
    if holeAltNames[k] == name {
      if holeAssignOk(srcExpr, at, holeAltTys[k]) {
        const resid = holeAltResidualTy(shape, k)
        if resid < 0 { return true }
        if holeAssignOk(srcExpr, at, resid) { return true }
      }
    }
    k = k + 1
  }
  false
}

// Membership test over a small ARENA-TYPE list, by structural type identity (the
// alternative-arm dedup below). `tyEq` is the same comparator `noteHoleAlt` /
// `holeAltIndex` (7080, 7103) already dedup `holeAltTys` with — this list is the
// SECOND dedup of the same alternatives and was the odd one out, keyed on
// `tyToStr(m)`: render-equality standing in for type identity. Two ways that is
// not the same question — `tyToStr` TRUNCATES at depth 8 (`…`), so two arms
// differing only below it collapse into one; and it renders `Nullable(TyFunc)`
// and `TyFunc(→ Nullable)` alike. `tyEq` decides the render-equality question
// STRUCTURALLY, without building either string, and carries a cycle guard the
// depth cutoff was standing in for.
function tyArrHasEq(xs: i32[], v: i32) {
  let i = 0
  while i < xs.length {
    if tyEq(xs[i], v) { return true }
    i = i + 1
  }
  false
}

// Alternative `k` as the caller actually experiences it: the `is`-tested type
// CONJOINED with the demanded fields a guard-taking argument still reaches
// (`holeAltResidualTy`). `holeDemandOk` requires BOTH, so rendering the tested type
// alone produced a self-contradictory diagnostic — `expected {foo: string} | …, got
// {foo: string}` for `print(v.zap); if v is {foo: string} …`, naming an arm the
// rejected argument appears to satisfy. Residual fields come FIRST so the arm reads
// in demand order (`{zap: any, foo: string}`) and lines up with the complement arm;
// a name present in both keeps the tested type, which is the more specific of the
// two (a demanded field is a `?fld` hole, rendering `any`).
function holeAltRenderTy(shape: i32, k: i32) {
  const alt = holeAltTys[k]
  const resid = holeAltResidualTy(shape, k)
  if resid < 0 { return alt }
  const at = T.tys[alt]
  const rt = T.tys[resid]
  if at is TyObj {
    if rt is TyObj {
      const names: string[] = []
      const tys: i32[] = []
      let i = 0
      while i < rt.objFieldNames.length {
        if objFieldType(at, rt.objFieldNames[i]) < 0 {
          names.push(rt.objFieldNames[i])
          tys.push(rt.objFieldTypes[i])
        }
        i = i + 1
      }
      let j = 0
      while j < at.objFieldNames.length {
        names.push(at.objFieldNames[j])
        tys.push(at.objFieldTypes[j])
        j = j + 1
      }
      return mkObjTy(names, tys)
    }
  }
  alt
}

// The full EXPECTATION for hole `name` as ONE type: the demanded shape alone, or
// — when the body also `is`-tested the hole — the DISJUNCTION of every accepted
// arm, so the diagnostic and hover both name all of them rather than the
// complement path's constraint alone. Each alternative is rendered with its
// still-required residual folded in (`holeAltRenderTy`), so every printed arm is
// one an argument could actually satisfy. -1 when the hole demands nothing.
function holeDemandTy(name: string) {
  // A MAP demand is the whole expectation on its own — `holeDemandOk` requires it
  // unconditionally, so it is not one arm of the disjunction below.
  const hmd = holeMapOf(name)
  if hmd >= 0 { return hmd }
  const shape = holeShapeOf(name)
  const members: i32[] = []
  let k = 0
  while k < holeAltNames.length {
    if holeAltNames[k] == name {
      const m = holeAltRenderTy(shape, k)
      if !tyArrHasEq(members, m) { members.push(m) }
    }
    k = k + 1
  }
  if shape >= 0 {
    if !tyArrHasEq(members, shape) { members.push(shape) }
  }
  if members.length == 0 { return -1 }
  if members.length == 1 { return members[0] }
  mkUnionTy(members)
}

// `holeDemandTy` rendered — the `expected …` half of a failed hole-demand check.
function holeDemandStr(name: string) {
  const d = holeDemandTy(name)
  // "Demands nothing" is the same blank `tyToStrAt` writes for an absent arena entry,
  // and it must stay the same token: this string lands in the `expected …` half of a
  // message whose `got …` half comes from that renderer.
  if d < 0 { return "_" }
  tyToStr(d)
}

// Record that hole `name` was indexed (so it demands an array). Idempotent.
function noteArrayDemand(name: string) {
  let i = 0
  while i < holeArrayDemand.length {
    if holeArrayDemand[i] == name { return 0 }
    i = i + 1
  }
  holeArrayDemand.push(name)
  0
}

// The array BUILTIN methods that constrain an un-annotated-param hole RECEIVER to an array
// (rather than growing a `{method: any}` struct shape). Element-bearing and array-specific —
// a map exposes `set`/`add`/`has`/`delete`/`keys`/`values`, never these — so recognizing them
// on a hole can't hijack a genuine map/struct use.
function holeArrMethod(name: string) {
  name == "map" || name == "filter" || name == "push" || name == "pop"
}

// The MAP/SET builtin methods that constrain an un-annotated-param hole RECEIVER to a map —
// the exact dual of `holeArrMethod`, and the set its header already names. Disjoint from the
// array methods and from every string method, so recognizing them on a hole cannot hijack an
// array / string / struct use; `length` / `size` are NOT here because they are member READS
// shared by all three collections and already special-cased at the member arm.
function holeMapMethod(name: string) {
  name == "set" ||
    name == "get" ||
    name == "has" ||
    name == "delete" ||
    name == "add" ||
    name == "keys" ||
    name == "values"
}

// The demanded MAP type of hole `name` (the arena index of a `TyMap` whose key/value the
// callee's own map operations pin IN PLACE, exactly as `.push` pins an empty `[]`'s element),
// or -1 when the hole has no map demand. Parallel columns, like `holeShape*`.
function holeMapOf(name: string) {
  let i = 0
  while i < holeMapNames.length {
    if holeMapNames[i] == name { return holeMapTys[i] }
    i = i + 1
  }
  -1
}

// GET-OR-CREATE hole `name`'s demanded map: an OPEN `{[?]: ?}` on first use, then the same
// arena entry for every later map operation in the body, so `q.set("a", 1)` followed by
// `q.has("b")` accumulates onto ONE type instead of two that agree. `isSet` mints the Set
// flavor — `boolean`-valued and `mSet == 1` — which is what `.add`'s own arm requires, and
// is the only thing `.add` on a hole can mean.
//
// The demand is created DURING the body check and read at the CALL SITE, and both directions
// of the pin matter: the callee's operations pin the demand, which then pins an argument
// whose `Map()` is still open (`const m = Map(); put(m)`), and a call whose argument is
// already concrete pins the demand for the emitter. `holeDemandOk` runs both.
// True if map-demand `ty` still has an open half — the callee only READ the map, so neither
// its key nor its value was pinned by anything in the body. The demand is then a shape no
// argument can be checked against (see `holeDemandOk`).
function holeMapDemandOpen(ty: i32) {
  if ty < 0 { return true }
  const t = T.tys[ty]
  if t is TyMap {
    // A HOLE in either half counts as open, not just the `-1` no-type-yet. `q[k] = v` inside
    // a callee whose `k` / `v` are THEMSELVES un-annotated params pins the demand to those
    // holes — a non-negative index that is still undecided — and the rep layer has no map
    // struct for it: measured as `vl check` rc 0 and `emitProgram: indexed-assignment target
    // is not an array`.
    if t.mKey < 0 || t.mVal < 0 { return true }
    return tyIsHole(t.mKey) || tyIsHole(t.mVal)
  }
  true
}

// Report a failed hole-ARGUMENT demand — ONE home for the wording, shared by the general
// call path and the UFCS one. An OPEN map demand gets its own sentence: the generic
// `expected …, got …` would render the unpinned demand `{[_]: _}` and read as a
// mismatch, when the actual problem is that nothing decided the parameter's type.
function holeArgDemandErr(name: string, argN: i32, at: i32, ix: i32) {
  const hmE = holeMapOf(name)
  if hmE >= 0 {
    if holeMapDemandOpen(hmE) {
      tErr(
        "argument " +
          i32ToStr(argN) +
          ": parameter is used as a map but nothing in the body pins its key or value" +
          " — add a type annotation",
        ix,
      )
      return 0
    }
  }
  tErr(
    "argument " +
      i32ToStr(argN) +
      ": expected " +
      holeDemandStr(name) +
      ", got " +
      tyToStr(at),
    ix,
  )
  0
}

// Report an argument an INDEXED hole cannot take (`tyRefusesArrayDemand`) — ONE home for the
// wording, shared by the general call path and the UFCS one. A MAP argument gets its own
// sentence: `q[i]` with an i32 index is ambiguous between an array and an i32-keyed map, the
// body was checked as the array, and "expected an array" alone would send the reader to
// change the ARGUMENT when the fix is to annotate the PARAMETER — the more so because an
// argument still open (`const m = Map()`) renders `{[_]: _}`.
function holeArgArrayErr(argN: i32, at: i32, ix: i32) {
  if at >= 0 {
    const t = T.tys[at]
    if t is TyMap {
      tErr(
        "argument " +
          i32ToStr(argN) +
          ": parameter is indexed with an i32, which is ambiguous between an array and" +
          " an i32-keyed map — add a type annotation",
        ix,
      )
      return 0
    }
  }
  tErr(
    "argument " + i32ToStr(argN) + ": expected an array, got " + tyToStr(at),
    ix,
  )
  0
}

function holeMapDemandTy(name: string, isSet: boolean) {
  const have = holeMapOf(name)
  if have >= 0 { return have }
  let mv = -1
  let ms = 0
  if isSet {
    mv = TY_BOOL
    ms = 1
  }
  const ty = mkMapTy(-1, mv, ms)
  holeMapNames.push(name)
  holeMapTys.push(ty)
  ty
}

function holeIsArrayDemanded(name: string) {
  let i = 0
  while i < holeArrayDemand.length {
    if holeArrayDemand[i] == name { return true }
    i = i + 1
  }
  false
}

// A type that is still an inference HOLE (`TyVar`): an un-annotated param, or a derived hole.
function tyIsHole(tyIx: i32) {
  if tyIx < 0 { return false }
  const t = T.tys[tyIx]
  if t is TyVar { return true }
  false
}

// Record a deferred binary-op constraint when either operand is a hole — the body can't yet decide
// the operator's form, so the generic call-site validates it under substitution.
function noteBinCstr(lt: i32, op: string, rt: i32) {
  if tyIsHole(lt) || tyIsHole(rt) {
    let k = 0
    while k < binCstrOp.length {
      if binCstrLt[k] == lt && binCstrOp[k] == op && binCstrRt[k] == rt {
        return 0
      }
      k = k + 1
    }
    binCstrLt.push(lt)
    binCstrOp.push(op)
    binCstrRt.push(rt)
  }
  0
}

// Whether the EMITTER can lower `lt op rt` for two CONCRETE operand types — the soundness criterion
// the generic call-site checks after substituting a hole to its argument type. A still-unresolved
// operand (`TyVar`, a nested generic) DEFERS (true — the outer call validates it). Mirrors
// `checkBinary`'s accepted forms; an operator OVERLOAD (`opSelfFnTy`) would also satisfy it but does
// not yet lower, so it stays a clean reject. Operators not modelled here return true (no false
// reject — they keep today's behaviour).
function binOpDefinedFor(op: string, lt0: i32, rt0: i32) {
  const lt = softenLitTy(lt0)
  const rt = softenLitTy(rt0)
  if tyIsHole(lt) || tyIsHole(rt) { return true }
  if op == "==" || op == "!=" {
    // MUTUAL COMPATIBILITY, the same criterion `checkBinary` applies to two annotated
    // operands: VL has no cross-type equality, and the emitter has no lowering for one
    // (`i32 == string` emits an i32 against a `(ref $type)` and the engine rejects the
    // module). Two exemptions keep the rule to the genuine mismatches:
    //   - A NULLNESS TEST asks about the storage, and every storage can answer it, so a
    //     `null` on either side defers to `checkBinary`'s own null arms — which is what
    //     keeps `function isNil(x) { x == null }` writable over every argument type.
    //   - A NOMINAL brand is ERASED before the emitter, so lowerability is a question about
    //     what the operands ERASE TO, not about their brands: `id == 0` compares two i32s at
    //     run time even though the brand/base pair fails `assignable` both ways. Asking
    //     `nomErasedTyIx` rather than waiving the check on any brand mismatch keeps
    //     `EntityId == string` a reject. Which brands may MIX is `checkBinary`'s
    //     `nomBinMixes` — it has the operand expressions this criterion does not.
    if isNullTy(lt) || isNullTy(rt) { return true }
    const eqL = nomErasedTyIx(lt)
    const eqR = nomErasedTyIx(rt)
    return assignable(eqL, eqR) || assignable(eqR, eqL)
  }
  const lArr = T.tys[lt]
  const rArr = T.tys[rt]
  if op == "+" {
    if isStringTy(lt) && isStringTy(rt) {
      return true // string concat
    }
    if lArr is TyArray {
      if rArr is TyArray {
        return true // list concat (element agreement checked in the body)
      }
    }
    return isNumeric(lt) && isNumeric(rt)
  }
  if op == "-" || op == "*" || op == "/" || op == "%" {
    return isNumeric(lt) && isNumeric(rt)
  }
  if op == "<" || op == ">" || op == "<=" || op == ">=" {
    if isStringTy(lt) && isStringTy(rt) { return true }
    return isNumeric(lt) && isNumeric(rt)
  }
  true
}

// Record a deferred call-argument constraint: hole-typed argument `at` flowed into the
// CONCRETE param type `exp` of callee `who`. Idempotent per (at, exp) pair. An `exp` that
// still carries a hole is NOT recorded — after `bindGenWalk`+`substTyDeep` at the inner
// call it could only be one of the enclosing body's own holes, and that hole's demands
// surface through its own bindings instead. Same for an `exp` that is a DEFERRED JOIN:
// it is not yet a type, so there is nothing to hold the argument to.
function noteArgCstr(at: i32, exp: i32, who: string) {
  if tyIsDeferredJoin(exp) { return 0 }
  let k = 0
  while k < argCstrAt.length {
    if argCstrAt[k] == at && argCstrExp[k] == exp { return 0 }
    k = k + 1
  }
  argCstrAt.push(at)
  argCstrExp.push(exp)
  argCstrWho.push(who)
  0
}

// True when `ty` reaches an inference HOLE (a `TyVar`) anywhere in its tree — through an
// array element, a map key/value, a struct field, a nullable inner, a union member, or a
// function type's params/return. The FULLY-CONCRETE test the parameter solve needs, and
// `tyIsHole`'s composite twin: a DEMANDED SHAPE (`{bar: _}`, a `TyObj` whose field is a
// derived hole) is not a bare `TyVar`, so `tyIsHole` says no about a type that carries no
// answer at all. Depth-bounded — a recursive struct/array type is cyclic in the arena.
function tyReachesHole(ty: i32, depth: i32): boolean {
  if ty < 0 { return true }
  if depth <= 0 { return true }
  const t = T.tys[ty]
  if t is TyVar { return true }
  if t is TyArray { return tyReachesHole(t.aElem, depth - 1) }
  if t is TyMap {
    if tyReachesHole(t.mKey, depth - 1) { return true }
    return tyReachesHole(t.mVal, depth - 1)
  }
  if t is TyNullable { return tyReachesHole(t.nInner, depth - 1) }
  if t is TyObj {
    let i = 0
    while i < t.objFieldTypes.length {
      if tyReachesHole(t.objFieldTypes[i], depth - 1) { return true }
      i = i + 1
    }
    return false
  }
  if t is TyUnion {
    let m = 0
    while m < t.uMembers.length {
      if tyReachesHole(t.uMembers[m], depth - 1) { return true }
      m = m + 1
    }
    return false
  }
  if t is TyFunc {
    let p = 0
    while p < t.fnParamTypes.length {
      if tyReachesHole(t.fnParamTypes[p], depth - 1) { return true }
      p = p + 1
    }
    if t.fnRet == -2 { return true }
    return tyReachesHole(t.fnRet, depth - 1)
  }
  false
}

// Record a hole's FLOW into a concrete destination while the parameter-solve probe
// runs (see `solvedParamTys`). The destination must be FULLY CONCRETE: a deferred join,
// `never`, an error, or anything reaching a `TyVar` carries no answer to solve to, so it
// is not recorded and the parameter stays a hole, behaving exactly as before.
//
// The composite case is the load-bearing half. A hole's DEMANDED SHAPE (`{bar: _}`,
// accumulated from `v.bar` inside a relay body) is a `TyObj` — not a bare `TyVar` — so it
// passes `tyIsHole`, and adopting it as the solution turned the working relay program
// `relay({foo: "RF"})` into "expected {bar: _}, got {foo: string}". A demanded shape is a
// LOWER BOUND collected from usage, never a type the parameter must equal.
function noteHoleFlow(src: i32, dst: i32) {
  if !paramSolveProbe { return 0 }
  noteHoleFlowGo(src, dst, 6)
}

// The parallel src/dst walk `noteHoleFlow` records through. A BARE hole meeting a concrete
// destination is the answer; a COMPOSITE source carrying the hole is descended into against
// the SAME position of the destination, so `{f: u}` into a `{f: K}` field, `[u]` into a
// `K[]` element and a `K`-valued map store each reach the hole they actually constrain.
// Without the descent the composite source short-circuits `assignable` whole (an element
// hole is assignable to anything) and the per-position flow is never asked.
//
// Only MATCHING shapes descend, and only by field NAME for a struct: a mismatch is a
// diagnostic the caller is about to report, not a constraint to adopt.
function noteHoleFlowGo(src: i32, dst: i32, depth: i32) {
  if depth <= 0 { return 0 }
  if src < 0 || dst < 0 { return 0 }
  if tyIsHole(src) {
    if tyIsDeferredJoin(dst) { return 0 }
    if isNeverTy(dst) { return 0 }
    if tyReachesHole(dst, 8) { return 0 }
    const dt = T.tys[dst]
    if dt is TyErr { return 0 }
    holeFlowSrc.push(src)
    holeFlowDst.push(dst)
    return 0
  }
  const s = T.tys[src]
  const d = T.tys[dst]
  if s is TyArray {
    if d is TyArray { return noteHoleFlowGo(s.aElem, d.aElem, depth - 1) }
    return 0
  }
  if s is TyMap {
    if d is TyMap { return noteHoleFlowGo(s.mVal, d.mVal, depth - 1) }
    return 0
  }
  if s is TyNullable {
    if d is TyNullable { return noteHoleFlowGo(s.nInner, d.nInner, depth - 1) }
    return 0
  }
  if s is TyObj {
    if d is TyObj {
      let i = 0
      while i < s.objFieldNames.length {
        let j = 0
        while j < d.objFieldNames.length {
          if d.objFieldNames[j] == s.objFieldNames[i] {
            noteHoleFlowGo(s.objFieldTypes[i], d.objFieldTypes[j], depth - 1)
          }
          j = j + 1
        }
        i = i + 1
      }
    }
    return 0
  }
  0
}

// The HOLE NAME of parameter `pi` — the parameter's identity across the pass-1 hoist,
// the body check and the solve table. A NAMED function keys on its name and position
// (so the hoisted signature and the body bind the identical hole); an anonymous
// lambda has no name and keys on its node index instead.
function paramHoleName(fnName: string, fnIx: i32, pi: i32) {
  if fnName != "" { return "?" + fnName + "." + i32ToStr(pi) }
  "?#L" + i32ToStr(fnIx) + "." + i32ToStr(pi)
}

// THE type an un-annotated parameter takes — the SINGLE source of truth. A parameter
// its own body pinned takes that type, exactly as if it had been annotated; one
// nothing pinned takes a fresh inference hole. Every producer goes through here — the
// pass-1 signature hoist, `checkFuncDeclNode`, and through the `nodeTyIx` the latter
// records, the emitter's synthesized annotation — so no two of them can drift.
function unannotParamTy(holeName: string) {
  const s = solvedParamTys[holeName] ?? -1
  if s >= 0 { return s }
  mkTyVar(holeName)
}

// Is `name` the hole name of one of `fnIx`'s own parameters? A probe's body reaches
// other functions' holes too (a callee's un-annotated parameter, a nested function's),
// and those are not this declaration's to solve.
function holeNameIsParamOf(
  name: string,
  fnName: string,
  fnIx: i32,
  nParams: i32,
) {
  let k = 0
  while k < nParams {
    if paramHoleName(fnName, fnIx, k) == name { return true }
    k = k + 1
  }
  false
}

// Solve every un-annotated parameter of top-level function `fnIx` from its body's
// usage: probe the body once with diagnostics, symbols and the redundant-type stream
// suppressed, then read the flow constraints its holes accumulated and record the
// FIRST concrete destination per parameter.
//
// A SECOND, DISAGREEING usage (`const r1: string = u   const r2: i32 = u`) is
// deliberately not merged here. The real pass now checks the body against the solved
// type, so the second usage rejects there — the same reject, at the same position,
// that the annotated spelling has always produced.
//
// Attempted at most once per declaration and never re-entered from inside a probe.
// Only a TOP-LEVEL `function` is probed, from pass 1.8, which is what makes the
// answer independent of source order: it lands before any expression is checked, so a
// call ABOVE the declaration sees the solved parameter too. (A top-level `function` is
// a statement, never an expression, so it can carry no contextual callback type for
// the solve to contradict — `cbExpectedFor` is keyed by a seeded lambda node.)
function solveUnannotParams(fnIx: i32) {
  if paramSolveProbe { return 0 }
  const key = i32ToStr(fnIx)
  if paramSolveTried[key] ?? false { return 0 }
  const fd = P.nodes[fnIx]
  if fd is FuncDecl {
    const ps = fd.fnParams
    let anyHole = false
    let pi = 0
    while pi < ps.length {
      const pn = P.nodes[ps[pi]]
      if pn is Param {
        if pn.parType < 0 {
          if (solvedParamTys[paramHoleName(fd.fnName, fnIx, pi)] ?? -1) < 0 {
            anyHole = true
          }
        }
      }
      pi = pi + 1
    }
    if !anyHole { return 0 }
    paramSolveTried[key] = true
    // The saves mirror `inferReturnsPrePass` — the established shape for a quiet body
    // re-check — plus the two deferred-constraint tables, whose rows the real pass
    // re-records for itself and which would otherwise be adjudicated twice.
    const savedDiag = T.diags.length
    const savedSym = symEnabled
    const savedRedun = redunName.length
    const savedQuiet = inferQuiet
    const savedBinN = binCstrOp.length
    const savedArgN = argCstrAt.length
    const savedJoinN = dJoinNode.length
    const nFlow = holeFlowSrc.length
    symEnabled = 0
    inferQuiet = true
    paramSolveProbe = true
    checkFuncDeclNode(fd, fnIx)
    paramSolveProbe = false
    inferQuiet = savedQuiet
    symEnabled = savedSym
    while T.diags.length > savedDiag { T.diags.pop() }
    redunTruncate(savedRedun)
    while binCstrOp.length > savedBinN {
      binCstrLt.pop()
      binCstrOp.pop()
      binCstrRt.pop()
    }
    while argCstrAt.length > savedArgN {
      argCstrAt.pop()
      argCstrExp.pop()
      argCstrWho.pop()
    }
    // The PARKED deferred joins too, and this one is keyed by CALL NODE rather than by
    // hole name — so a probe's row is not the idempotent re-record the name-keyed tables
    // give, it is a row the real pass then finds already present and declines to re-park.
    // That silently dropped the escaped-join reject at `goUnion(1)` in
    // `soundness/hole-join-two-level-chain-reject.vl`: a program that must reject, and did.
    while dJoinNode.length > savedJoinN {
      dJoinNode.pop()
      dJoinTy.pop()
    }
    let fi = nFlow
    while fi < holeFlowSrc.length {
      const st = T.tys[holeFlowSrc[fi]]
      if st is TyVar {
        if (solvedParamTys[st.tvName] ?? -1) < 0 {
          if holeNameIsParamOf(st.tvName, fd.fnName, fnIx, ps.length) {
            solvedParamTys[st.tvName] = holeFlowDst[fi]
          }
        }
      }
      fi = fi + 1
    }
    while holeFlowSrc.length > nFlow {
      holeFlowSrc.pop()
      holeFlowDst.pop()
    }
    // Patch the hoisted TyFunc IN PLACE so a call checked before pass 2 reaches this
    // declaration binds the solved parameter — the same in-place patch the inferred
    // RETURN makes, for the same reason. Gated on this node BEING the registered
    // top-level declaration (the same guard `bodyChecked` carries): a NESTED namesake
    // is not hoisted, and `lookup` would hand it the OUTER function's signature to
    // corrupt.
    if fd.fnName != "" && (fnDeclIx[fd.fnName] ?? -1) == fnIx {
      const bound = lookup(fd.fnName)
      if bound >= 0 {
        const bt = T.tys[bound]
        if bt is TyFunc {
          const bpt = bt.fnParamTypes
          let k = 0
          while k < ps.length {
            if k < bpt.length {
              const sv = solvedParamTys[paramHoleName(fd.fnName, fnIx, k)] ?? -1
              if sv >= 0 {
                bpt[k] = sv
                tyMutEpoch = tyMutEpoch + 1 // solved parameter patched in place
              }
            }
            k = k + 1
          }
        }
      }
    }
  }
  0
}

// Record a DEFERRED JOIN that escaped call `ix` to callee `who` lossily (the collapse
// kept one arm and dropped the rest because the join still named unpinned holes).
// Idempotent per (ty, ix). Never recorded from a QUIET probe body — a probe's tables
// are truncated but a constraint validated later, outside the probe, is not.
function noteEscJoin(ty: i32, ix: i32, who: string) {
  if inferQuiet { return 0 }
  if ty < 0 || ix < 0 { return 0 }
  let k = 0
  while k < escJoinTy.length {
    if escJoinTy[k] == ty && escJoinIx[k] == ix { return 0 }
    k = k + 1
  }
  escJoinTy.push(ty)
  escJoinIx.push(ix)
  escJoinWho.push(who)
  0
}

// Re-validate every escaped deferred join THIS call's bindings decide. A join that
// re-folds to a single type was collapsed FAITHFULLY — the arms agree for this
// argument, which is the overwhelmingly common case (`pick(x, y, true)` with both
// arms i32). A join that re-folds to a genuine multi-member union was NOT: the
// enclosing body was checked against one arm while the value really is the union,
// and the emitter has no rep for an un-annotated join return at a monomorphized
// instance. Reject at the INNER call — the position where the disagreement lives —
// naming both the callee and the union its arms resolve to. Still touching a hole
// (or still a deferred join) is undecided and defers to the site that pins it.
function validateEscJoins(bNames: string[], bTys: i32[]) {
  let ci = 0
  while ci < escJoinTy.length {
    const rj = substTyDeep(escJoinTy[ci], bNames, bTys)
    if rj != escJoinTy[ci] && !tyIsHole(rj) && !tyIsDeferredJoin(rj) {
      const rt = T.tys[rj]
      if rt is TyUnion {
        if rt.uMembers.length > 1 {
          let who = escJoinWho[ci]
          if who == "" { who = "a call" } else { who = "`" + who + "`" }
          tErrUnsupported(
            "the returns of " +
              who +
              " join to " +
              tyToStr(rj) +
              " for this argument — type-valid, but an inferred union return through an" +
              " un-annotated parameter is not yet supported by codegen; annotate the return type",
            escJoinIx[ci],
          )
        }
      }
    }
    ci = ci + 1
  }
  0
}

// Re-validate every deferred call-argument constraint that THIS call resolves: substitute
// the hole to the call's concrete argument type and check it against the recorded param
// type. A constraint still touching an unresolved hole (not bound by this call, or a
// nested generic) defers — `validateBinCstrs` for argument flow.
//
// RE-DEFERRAL. A constraint whose hole substituted to ANOTHER hole (the call passed
// the ENCLOSING body's own hole down, so `?fld.bar.<hCallee>` re-based to
// `?fld.bar.<hCaller>`) is not merely undecided at this site — it must be re-recorded
// under the CALLER's hole, or nothing will re-check it when the OUTER call finally
// pins that one. Without this the constraint dies at the first hop and the two-level
// chain type-checks clean.
function validateArgCstrs(bNames: string[], bTys: i32[], ix: i32) {
  const nOrig = argCstrAt.length
  let ci = 0
  while ci < nOrig {
    const rat = substTyDeep(argCstrAt[ci], bNames, bTys)
    const rexp = substTyDeep(argCstrExp[ci], bNames, bTys)
    if rat != argCstrAt[ci] {
      if tyIsHole(rat) || tyIsDeferredJoin(rat) {
        if !tyIsHole(rexp) { noteArgCstr(rat, rexp, argCstrWho[ci]) }
      }
    }
    // A side still carrying a hole — bare, or as a DEFERRED JOIN arm — is undecided
    // at this site and defers to the call that pins it.
    if !tyIsHole(rat) && !tyIsDeferredJoin(rat) {
      if !tyIsHole(rexp) && !tyIsDeferredJoin(rexp) {
        if !assignable(rat, rexp) {
          let who = argCstrWho[ci]
          if who == "" { who = "a call" } else { who = "`" + who + "`" }
          tErr(
            "argument of type " +
              tyToStr(rat) +
              " flows into " +
              who +
              " expecting " +
              tyToStr(rexp) +
              " (the call's argument types)",
            ix,
          )
        }
      }
    }
    ci = ci + 1
  }
  0
}

// Do every deferred call-argument constraint THIS binding resolves hold (the pure-boolean
// twin of `validateArgCstrs`, for `genericFnAssignable`)? An unresolved hole defers.
function argCstrsHold(bNames: string[], bTys: i32[]) {
  let ci = 0
  while ci < argCstrAt.length {
    const rat = substTyDeep(argCstrAt[ci], bNames, bTys)
    const rexp = substTyDeep(argCstrExp[ci], bNames, bTys)
    if !tyIsHole(rat) && !tyIsDeferredJoin(rat) {
      if !tyIsHole(rexp) && !tyIsDeferredJoin(rexp) {
        if !assignable(rat, rexp) { return false }
      }
    }
    ci = ci + 1
  }
  true
}

// Re-validate every deferred binary-op constraint that THIS call resolves: substitute the holes to
// the call's concrete argument types and check the operator is defined for them. A constraint still
// touching an unresolved hole (not bound by this call, or a nested generic) defers. The general
// capability check — numeric / string / relational all fall out of one rule.
//
// RE-DEFERRAL, exactly as in `validateArgCstrs`: an operand that substituted to
// ANOTHER hole is re-recorded under that hole, so `function gb(v) { return v.bar + 1 }`
// reached through `function go(w) { print(gb(w)) }` still rejects `go({bar: "s"})`.
function validateBinCstrs(bNames: string[], bTys: i32[], ix: i32) {
  const nOrigB = binCstrOp.length
  let ci = 0
  while ci < nOrigB {
    const clt = substTyDeep(binCstrLt[ci], bNames, bTys)
    const crt = substTyDeep(binCstrRt[ci], bNames, bTys)
    if clt != binCstrLt[ci] || crt != binCstrRt[ci] {
      if tyIsHole(clt) || tyIsHole(crt) { noteBinCstr(clt, binCstrOp[ci], crt) }
    }
    if !tyIsHole(clt) {
      if !tyIsHole(crt) {
        if !binOpDefinedFor(binCstrOp[ci], clt, crt) {
          tErr(
            "operator '" +
              binCstrOp[ci] +
              "' is not defined for " +
              tyToStr(clt) +
              " and " +
              tyToStr(crt) +
              " (the call's argument types)",
            ix,
          )
        }
      }
    }
    ci = ci + 1
  }
  0
}

// A type that definitively CANNOT be indexed `[i]`: a scalar primitive (i32 / f64 / i64 /
// f32 / boolean / null / …) — anything but a `string`. An array / string / struct (may carry
// a `"[]"` trap) / map / hole / error is NOT rejected here (it resolves or defers).
function tyIsNonIndexableScalar(tyIx: i32) {
  if tyIx < 0 { return false }
  const t = T.tys[tyIx]
  if t is TyPrim { return t.primName != "string" }
  false
}

// A type an INDEXED hole (`self[i]`, an i32 index — so the body demanded an ARRAY) cannot
// take. A non-indexable scalar cannot be indexed at all; a MAP can, but by its KEY and to a
// NULLABLE value, which is a different read discipline from an array's — and the body was
// ALREADY checked against the array one (its element is an `HD_ELEM` hole, resolved through
// `TyArray`), so every type the body derived from the read is an array's. Accepting the map
// here emits an array read over a map ref, or — measured — prints a `boolean` map value
// through the i32 formatter the array reading chose: `vl check`-clean SILENTLY WRONG output.
// `q[1]` on a hole is genuinely ambiguous between `i32[]` and `{[i32]: V}` and only the
// ARGUMENT decides, which is backward flow (ROADMAP E5): reject rather than pick.
function tyRefusesArrayDemand(tyIx: i32) {
  if tyIsNonIndexableScalar(tyIx) { return true }
  if tyIx < 0 { return false }
  const t = T.tys[tyIx]
  t is TyMap
}

// Member access on an inference hole (host `getChildType` on `Infer<Unknown>`):
// record the field on the hole's demanded shape — creating the shape on first
// access, the field on first read — and return the field's DERIVED hole.
// Takes the hole BOTH ways on purpose: `holeName` is its IDENTITY (the key of
// every hole side table here), `holeIx` its arena HANDLE (the base a field
// derivation points at). The caller has already narrowed the receiver, so it has
// both — re-deriving the name here from the index would only re-do that narrowing.
//
// And that re-derivation currently MISCOMPILES, so do not "simplify" this back to
// one parameter. Binding a field of a union narrowed by a NEGATED `is` + early
// return to a `const` emits invalid wasm (`expected i32, found (ref $type)`):
//
//     const t = arena[ix]
//     if !(t is A) { return "" }
//     const nm = t.aName          // <- the miscompile
//
// Using the field expression DIRECTLY, and the POSITIVE narrow (`if t is A { … }`),
// both lower fine. Found by this refactor; not fixed here.
function holeMemberTy(holeIx: i32, holeName: string, prop: string) {
  if holeIx < 0 { return TY_ERR }
  let shape = holeShapeOf(holeName)
  if shape < 0 {
    const fnames: string[] = []
    const ftys: i32[] = []
    shape = mkObjTy(fnames, ftys)
    holeShapeNames.push(holeName)
    holeShapeTys.push(shape)
  }
  const st = T.tys[shape]
  if st is TyObj {
    const f = objFieldType(st, prop)
    if f >= 0 { return f }
    const d = mkDerivedHole(HD_FLD, prop, -1, -1, holeIx)
    if d < 0 { return TY_ERR }
    st.objFieldNames.push(prop)
    st.objFieldTypes.push(d)
    tyMutEpoch = tyMutEpoch + 1 // hole shape gained a field in place
    return d
  }
  TY_ERR
}

// A GUARDED return member (`HD_GALT`) — the type a `return` inside an `is`-guard's
// then-branch contributes, reachable ONLY by an argument that satisfies the guard's
// tested type. The branch type and the tested type are carried as stable arena
// indices on the derivation ROW, so the member survives the `holeAlt*` table being
// truncated (they used to ride the name as decimal text for the same reason).
// Minted only for a CONCRETE branch type (a hole one needs no wrapper: it already
// defers).
function mkGuardedRetTy(t: i32) {
  if t < 0 { return t }
  if tyIsHole(t) { return t }
  if guardAltStack.length == 0 { return t }
  const row = guardAltStack[guardAltStack.length - 1]
  if row < 0 { return t }
  if row >= holeAltNames.length { return t }
  const altTy = holeAltTys[row]
  if altTy < 0 { return t }
  const g = mkDerivedHole(HD_GALT, "", t, altTy, holeAltHoleIx[row])
  if g < 0 { return t }
  g
}

// The derivation row of an arena type, or -1 when it is not a derived hole.
function hdRowOf(tyIx: i32) {
  if tyIx < 0 { return -1 }
  if tyIx >= hdRowOfTy.length { return -1 }
  hdRowOfTy[tyIx]
}

// How many DERIVED-read layers a hole stacks over its base param hole — a STORED
// count, computed once per mint. (It used to be a census of `?` characters in the
// name, which worked only because every layer minted exactly one.) Used only to
// CAP the re-basing below.
function hdDepthOf(tyIx: i32) {
  const r = hdRowOf(tyIx)
  if r < 0 { return 0 }
  hdDepth[r]
}

// The hole NAME a derivation renders to. This is the one direction that stays
// stringly: the name is the hole's IDENTITY — generic bindings, demanded shapes,
// array demands and alternative rows are all keyed by it — and rendering a type is
// allowed. Nothing parses it back.
function hdRenderName(
  kind: i32,
  field: string,
  inner: i32,
  alt: i32,
  baseName: string,
) {
  if kind == HD_FLD { return "?fld." + field + "." + baseName }
  if kind == HD_RET { return "?ret." + baseName }
  if kind == HD_ELEM { return "?elem." + baseName }
  "?galt." + i32ToStr(inner) + "." + i32ToStr(alt) + "." + baseName
}

// MINT a derived hole: a fresh `TyVar` plus the derivation row that says what it
// derives. `base` must be a hole (every derivation reads off one); -1 when it is
// not, which every caller treats as "no derived hole here".
function mkDerivedHole(
  kind: i32,
  field: string,
  inner: i32,
  alt: i32,
  base: i32,
) {
  if base < 0 { return -1 }
  const bt = T.tys[base]
  if !(bt is TyVar) { return -1 }
  const ix = mkTyVar(hdRenderName(kind, field, inner, alt, bt.tvName))
  const row = hdKind.length
  hdKind.push(kind)
  hdField.push(field)
  hdInner.push(inner)
  hdAlt.push(alt)
  hdBase.push(base)
  hdDepth.push(hdDepthOf(base) + 1)
  while hdRowOfTy.length <= ix { hdRowOfTy.push(-1) }
  hdRowOfTy[ix] = row
  ix
}

// Re-basing budget. A derived hole re-based onto an OUTER hole at every call hop
// grows its name by one layer per hop; a self-recursive generic body
// (`function f(v) { return f(v.bar) }`) would grow it without bound as the
// binding-group fixpoint iterates. Past this depth re-basing stops and the name
// stays unresolved — the plain "cannot decide here" answer, so the cap can only lose
// diagnostics, never soundness (an unresolved hole still records its demand and
// still blocks nothing).
const HOLE_REBASE_MAX = 8

// RE-BASE derivation `row` onto the hole its base resolved to. "field `bar` of
// `<hInner>`" under a binding `<hInner> := <hOuter>` IS "field `bar` of `<hOuter>`"
// — the read is on the SAME value, now named by the caller's hole. Returning the
// re-based hole (rather than -1, "unresolved") is what lets an argument constraint
// recorded inside a generic body SURVIVE the hop out to the caller and be
// re-validated when the OUTER call finally pins `<hOuter>` to a concrete argument.
// -1 when the inner resolution is not a hole, or the depth cap is hit.
//
// Re-basing is now a COPY OF THE ROW with a new base, where it used to be a string
// prefix (re-cut from the very name being decoded) concatenated onto the inner name.
function rebaseDerivedHole(row: i32, innerTy: i32) {
  if innerTy < 0 { return -1 }
  const it = T.tys[innerTy]
  if it is TyVar {
    if hdDepthOf(innerTy) >= HOLE_REBASE_MAX { return -1 }
    return mkDerivedHole(
      hdKind[row],
      hdField[row],
      hdInner[row],
      hdAlt[row],
      innerTy,
    )
  }
  -1
}

// Resolve a (possibly DERIVED) hole against a call's bindings: a direct binding on
// its name wins; a RETURN derivation collapses to the pinned function's return (the
// host's instantiate-and-collapse — keeps `inferred-return-soundness` rejecting); a
// FIELD derivation to the pinned object's field (the structural A13 read `self.x`
// concretized per call site). A base that resolves to ANOTHER HOLE re-bases onto it
// (`rebaseDerivedHole`) instead of going unresolved — the TWO-LEVEL chain `go` →
// `gb(w)` → `w.bar`, where dropping the link let an i32 reach a `string` param with
// no diagnostic. -1 = unresolved.
//
// Takes the hole's ARENA INDEX, not its name: the derivation row hangs off the
// index, and each layer's base is a row field rather than a suffix of a string.
// (This function was the compiler's clearest case of a type held as a parsable
// string — four prefix matches and fifteen slices, decoding what the mint knew.)
function substHoleTy(tyIx: i32, bNames: string[], bTys: i32[]) {
  if tyIx < 0 { return -1 }
  const t = T.tys[tyIx]
  if !(t is TyVar) { return -1 }
  const b = bindOf(bNames, bTys, t.tvName)
  if b >= 0 { return b }
  const row = hdRowOf(tyIx)
  if row < 0 { return -1 }
  const kind = hdKind[row]
  // A GUARDED return member (`mkGuardedRetTy`). The pinned argument decides
  // REACHABILITY: it satisfies the guard's tested type, so the branch's type is
  // this member's value; it cannot, so the branch is dead here and the member stays
  // unresolved (the deferred-join re-fold then drops it). An unpinned hole defers,
  // exactly like every other derived hole.
  if kind == HD_GALT {
    const gInner = hdInner[row]
    const gAlt = hdAlt[row]
    if gInner < 0 || gAlt < 0 { return -1 }
    const gPin = substHoleTy(hdBase[row], bNames, bTys)
    if gPin < 0 { return -1 }
    if tyIsHole(gPin) { return rebaseDerivedHole(row, gPin) }
    if holeAssignOk(-1, gPin, gAlt) { return gInner }
    return -1
  }
  if kind == HD_RET {
    const inner = substHoleTy(hdBase[row], bNames, bTys)
    if inner >= 0 {
      const it = T.tys[inner]
      if it is TyFunc { return it.fnRet }
      return rebaseDerivedHole(row, inner)
    }
    return -1
  }
  // The element of an indexed hole (`self[i]`): resolve the hole to its pinned
  // argument; an array yields its element, a string an i32 code point. Mirrors the
  // FIELD read for indexing.
  if kind == HD_ELEM {
    const innerE = substHoleTy(hdBase[row], bNames, bTys)
    if innerE >= 0 {
      const itE = T.tys[innerE]
      if itE is TyArray { return itE.aElem }
      if itE is TyPrim {
        if itE.primName == "string" { return TY_I32 }
      }
      return rebaseDerivedHole(row, innerE)
    }
    return -1
  }
  // HD_FLD. An empty property name never resolves — the string form's `dot > 0`
  // guard, kept verbatim (see `holeBaseTy`).
  if hdField[row].length == 0 { return -1 }
  const inner2 = substHoleTy(hdBase[row], bNames, bTys)
  if inner2 >= 0 {
    const it2 = T.tys[inner2]
    if it2 is TyObj {
      const f = objFieldType(it2, hdField[row])
      if f >= 0 { return f }
    }
    return rebaseDerivedHole(row, inner2)
  }
  -1
}

// Generic CALL-SITE binding, deep (host `instantiateFunctionType`): walk an
// expected parameter type against the argument's actual type and bind every
// TyVar leaf — a declared type param (`T`) or an inference hole (`?f.N`) — on
// FIRST use. Later uses are checked by the caller against the SUBSTITUTED
// expected type (`substTyDeep`), so disagreeing uses still error
// (generics/return-correlation). Nested positions bind too: a `Box<T>` param
// (`{value: T}`) pins `T` from the argument's field, a callback param's
// signature from the argument function. Recursion over a cyclic arena (a
// recursive named type) is cut by the visited-pair stack.
export function bindGenWalk(
  expIx: i32,
  atIx: i32,
  bNames: string[],
  bTys: i32[],
) {
  if expIx < 0 || atIx < 0 { return 0 }
  const e = T.tys[expIx]
  if e is TyVar {
    if bindOf(bNames, bTys, e.tvName) < 0 {
      bNames.push(e.tvName)
      bTys.push(atIx)
    }
    return 0
  }
  let gi = bgSrcStack.length - 1
  while gi >= 0 {
    if bgSrcStack[gi] == expIx && bgDstStack[gi] == atIx { return 0 }
    gi = gi - 1
  }
  bgSrcStack.push(expIx)
  bgDstStack.push(atIx)
  const a = T.tys[atIx]
  if e is TyArray {
    if a is TyArray { bindGenWalk(e.aElem, a.aElem, bNames, bTys) }
  } else if e is TyNullable {
    if a is TyNullable { bindGenWalk(e.nInner, a.nInner, bNames, bTys) }
    else if atIx != TY_NULL { bindGenWalk(e.nInner, atIx, bNames, bTys) }
  } else if e is TyObj {
    if a is TyObj {
      const enames = e.objFieldNames
      const etys = e.objFieldTypes
      let i = 0
      while i < enames.length {
        const sf = objFieldType(a, enames[i])
        if sf >= 0 { bindGenWalk(etys[i], sf, bNames, bTys) }
        i = i + 1
      }
    }
  } else if e is TyFunc {
    if a is TyFunc {
      const ep = e.fnParamTypes
      const ap = a.fnParamTypes
      let i = 0
      while i < ep.length {
        if i < ap.length { bindGenWalk(ep[i], ap[i], bNames, bTys) }
        i = i + 1
      }
      bindGenWalk(e.fnRet, a.fnRet, bNames, bTys)
    }
  } else if e is TyMap {
    // A map/set param (`{[string]: T}`) pins `T` from the argument's value
    // type (the key position walks too, for symmetry).
    if a is TyMap {
      bindGenWalk(e.mKey, a.mKey, bNames, bTys)
      bindGenWalk(e.mVal, a.mVal, bNames, bTys)
    }
  }
  bgSrcStack.pop()
  bgDstStack.pop()
  0
}

// Deep substitution of a call's bindings into a type (host: instantiate-and-
// collapse): a bound TyVar becomes its binding; a DERIVED return hole
// `?ret.<calleeHole>` collapses to the pinned function's return (the body
// called a hole param — `function apply(fn, a, b) fn(a, b)`); composites
// rebuild ONLY when a child actually changed, so a concrete type keeps its
// arena identity (and the in-place pinning semantics that ride on it).
// Cyclic arenas (recursive named types) return themselves unchanged.
export function substTyDeep(tyIx: i32, bNames: string[], bTys: i32[]) {
  if tyIx < 0 || bNames.length == 0 { return tyIx }
  const t = T.tys[tyIx]
  if t is TyVar {
    const b = substHoleTy(tyIx, bNames, bTys)
    if b >= 0 { return b }
    return tyIx
  }
  let si = stSeenStack.length - 1
  while si >= 0 {
    if stSeenStack[si] == tyIx { return tyIx }
    si = si - 1
  }
  stSeenStack.push(tyIx)
  let res = tyIx
  if t is TyArray {
    const e2 = substTyDeep(t.aElem, bNames, bTys)
    if e2 != t.aElem { res = mkArrayTy(e2) }
  } else if t is TyNullable {
    const n2 = substTyDeep(t.nInner, bNames, bTys)
    if n2 != t.nInner { res = mkNullableTy(n2) }
  } else if t is TyObj {
    const onames = t.objFieldNames
    const otys = t.objFieldTypes
    const out: i32[] = []
    let changed = false
    let i = 0
    while i < otys.length {
      const f2 = substTyDeep(otys[i], bNames, bTys)
      if f2 != otys[i] { changed = true }
      out.push(f2)
      i = i + 1
    }
    if changed {
      const nn: string[] = []
      let j = 0
      while j < onames.length {
        nn.push(onames[j])
        j = j + 1
      }
      res = mkObjTy(nn, out)
    }
  } else if t is TyFunc {
    const ps = t.fnParamTypes
    const out2: i32[] = []
    let changed2 = false
    let k = 0
    while k < ps.length {
      const p2 = substTyDeep(ps[k], bNames, bTys)
      if p2 != ps[k] { changed2 = true }
      out2.push(p2)
      k = k + 1
    }
    const r2 = substTyDeep(t.fnRet, bNames, bTys)
    if r2 != t.fnRet { changed2 = true }
    if changed2 { res = mkFuncTy(out2, r2) }
  } else if t is TyUnion {
    const ms = t.uMembers
    const out3: i32[] = []
    let changed3 = false
    let u = 0
    while u < ms.length {
      const m2 = substTyDeep(ms[u], bNames, bTys)
      if m2 != ms[u] { changed3 = true }
      out3.push(m2)
      u = u + 1
    }
    // A DEFERRED join (a union `joinTys` minted over a hole member) re-folds: every
    // PROVABLY DEAD member is dropped and the rest re-joined. Checked even when no
    // member CHANGED — a `?fld.bar.<h>` whose pin has no `bar` is dead precisely
    // because it did not resolve. Any other union rebuilds verbatim, as before.
    if isJoinHoleUnion(tyIx) {
      res = refoldJoinUnion(tyIx, ms, out3, changed3, bNames, bTys)
    } else if changed3 {
      // DEDUPE, THEN COLLAPSE — the fold the ANNOTATION path performs and this walk did
      // not, which is the whole of #1483's regression. Substitution can make two members
      // the SAME type (`T | string` at `T := string`), and `annUnionInnerTy` answers that
      // with `members[0]` while this arm rebuilt a two-member union of identical members.
      // One type then had two representations depending which door it came through, and a
      // consumer handed the un-folded one recorded a union BOX where the value is a bare
      // ref: check-clean invalid wasm.
      //
      // ARENA-INDEX identity only, NOT `sameVariantTy`. The annotation path's dedup is
      // structural, and matching it here would merge members this walk has no business
      // merging — the mixed-union arena SHAPE is load-bearing (`annUnionInnerTy`'s own
      // header records that flattening a litunion RUN buys zero cells and costs `==` two).
      // Two members that are literally the same row are the same type by construction, and
      // that is the case substitution creates; anything subtler is left alone.
      const uniq: i32[] = []
      let q = 0
      while q < out3.length {
        let seen = false
        let w = 0
        while w < uniq.length {
          if uniq[w] == out3[q] { seen = true }
          w = w + 1
        }
        if !seen { uniq.push(out3[q]) }
        q = q + 1
      }
      if uniq.length == 1 { res = uniq[0] } else { res = mkUnionTy(uniq) }
    }
  } else if t is TyMap {
    const k2 = substTyDeep(t.mKey, bNames, bTys)
    const v2 = substTyDeep(t.mVal, bNames, bTys)
    if k2 != t.mKey || v2 != t.mVal { res = mkMapTy(k2, v2, t.mSet) }
  } else if t is TyNeg {
    const g2 = substTyDeep(t.negTy, bNames, bTys)
    if g2 != t.negTy { res = mkNegTy(g2) }
  }
  stSeenStack.pop()
  res
}

// ── free index-operator resolution (B14) ─────────────────────────────────────

// The tail of the parameter list an index operator wants, for the arity error.
function opIdxArityTail(op: string) {
  if op == OP_INDEX_SET { return ", value" }
  ""
}

// Does the program declare ANY index operator? The single inertness gate: false
// for every program that declares none, and then no index expression anywhere
// does any extra work and nothing is banked.
function opIdxDeclared() { opIdxFns.length > 0 }

// A type whose indexing is the LANGUAGE's, never a user operator's: arrays,
// maps, strings, an un-pinned inference hole, and the error type. The swallow
// lives here — a receiver that answers true reaches the built-in arms exactly as
// it does with no operator declared anywhere.
//
// A newtype over one of these is deliberately INCLUDED (a `new i32[]` still
// indexes as an array): the brand renames a type, it does not re-open a
// primitive's syntax.
function tyBuiltinIndexable(ty: i32) {
  if ty < 0 { return true }
  const t = T.tys[ty]
  if t is TyArray { return true }
  if t is TyMap { return true }
  if t is TyVar { return true }
  if t is TyErr { return true }
  if t is TyPrim { return t.primName == "string" }
  false
}

// The index-operator function `op` dispatches to for a receiver of type
// `recvTy` — the FIRST declaration whose `self` parameter accepts it — or "" when
// the program declares none that fits.
//
// FIRST-DECLARED WINS, and it is only reachable when two declarations' receivers
// both accept one value, which for two DECLARED types means one is structurally
// assignable to the other. Nominal newtypes (the shape `std:buffer`'s views use)
// are never in that position, since a brand accepts only itself.
function opIdxFnFor(op: string, recvTy: i32) {
  if recvTy < 0 { return "" }
  let i = 0
  while i < opIdxFns.length {
    if opIdxOps[i] == op {
      const nm = opIdxFns[i]
      const fnTy = lookup(nm)
      if fnTy >= 0 {
        // An un-annotated return is still the PENDING sentinel until its body is
        // checked; force it here, exactly as the UFCS and `a op b` resolutions do,
        // so a call site ahead of the declaration reads a real return type.
        const preFt = T.tys[fnTy]
        if preFt is TyFunc {
          if preFt.fnRet == -2 {
            if !onInferStack(nm) {
              const dIx = fnDeclIx[nm] ?? -1
              if dIx >= 0 { checkNode(dIx) }
            }
          }
        }
        const ft = T.tys[fnTy]
        if ft is TyFunc {
          const ps = ft.fnParamTypes
          if ps.length > 0 {
            if assignable(recvTy, ps[0]) { return nm }
          }
        }
      }
    }
    i = i + 1
  }
  ""
}

// BANK the resolved operator function on its site node, for the emitter's
// dispatch rewrite to read back. Only on the REAL pass — a quiet inference probe
// may resolve against a hole that later pins elsewhere.
function opIdxBank(siteIx: i32, fn: string) {
  if inferQuiet { return 0 }
  if siteIx < 0 { return 0 }
  let i = 0
  while i < opIdxSiteNode.length {
    if opIdxSiteNode[i] == siteIx {
      opIdxSiteFn[i] = fn
      return 0
    }
    i = i + 1
  }
  opIdxSiteNode.push(siteIx)
  opIdxSiteFn.push(fn)
  0
}

// The operator function the checker resolved at index site `ix`, or "" — the
// emitter's read of the bank above.
export function opIdxFnAtNode(ix: i32) {
  if ix < 0 { return "" }
  let i = 0
  while i < opIdxSiteNode.length {
    if opIdxSiteNode[i] == ix { return opIdxSiteFn[i] }
    i = i + 1
  }
  ""
}

// The declared type of parameter `pi` of the operator function `fn`, or -1.
function opIdxParamTy(fn: string, pi: i32) {
  const fnTy = lookup(fn)
  if fnTy < 0 { return -1 }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    const ps = ft.fnParamTypes
    if pi < ps.length { return ps[pi] }
  }
  -1
}

// The declared RETURN type of the operator function `fn` (TY_ERR while pending).
function opIdxRetTy(fn: string) {
  const fnTy = lookup(fn)
  if fnTy < 0 { return TY_ERR }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    if ft.fnRet == -2 { return TY_ERR }
    return ft.fnRet
  }
  TY_ERR
}

// Bind the index operator's declared type parameters from the receiver and key
// types, the way `opSelfFnTy` binds a binary operator's. ONE `"[]"` function
// serves every instantiation of a generic container, so its declared parameter
// and return types are a TEMPLATE, not the site's types: a site that takes them
// verbatim types `b[0]` of a `function "[]"<T>(self: Box<T>, i: i32): T` as a
// bare `T`, and an UNBOUND type variable is assignable to everything — which is
// `vl check` clean and an invalid module at emit.
// `keyTy` of -1 binds the receiver alone (the write arm, whose key may not have
// been re-checked at that point).
function opIdxBindGen(
  fn: string,
  recvTy: i32,
  keyTy: i32,
  bNames: string[],
  bTys: i32[],
) {
  const fnTy = lookup(fn)
  if fnTy >= 0 {
    const ft = T.tys[fnTy]
    if ft is TyFunc {
      const ps = ft.fnParamTypes
      if ps.length > 0 { bindGenWalk(ps[0], recvTy, bNames, bTys) }
      if ps.length > 1 {
        if keyTy >= 0 { bindGenWalk(ps[1], keyTy, bNames, bTys) }
      }
    }
  }
}

// Operator dispatch `a op b` over a STRUCT left operand through the free
// `self`-function named for the operator (`function +(self, b)` — host parser
// B13+B14): the function must exist, take exactly (self, right), and its FIRST
// param must be NAMED `self` (the pollution rule). Binds the operands into the
// function's holes like any call (the operator "monomorphizes per call") and
// substitutes the return. -1 = no such function fits (the caller falls through
// to the operator-FIELD lookup / the native numeric paths).
function opSelfFnTy(op: string, lt: i32, rt: i32, rightIx: i32, ix: i32) {
  const fnTy = lookup(op)
  if fnTy < 0 { return -1 }
  const preFt = T.tys[fnTy]
  if preFt is TyFunc {
    if preFt.fnRet == -2 {
      if !onInferStack(op) {
        const dIx = fnDeclIx[op] ?? -1
        if dIx >= 0 { checkNode(dIx) }
      }
    }
  } else {
    return -1
  }
  const dIx2 = fnDeclIx[op] ?? -1
  if dIx2 < 0 { return -1 }
  const d = P.nodes[dIx2]
  let selfOk = false
  if d is FuncDecl {
    if d.fnParams.length == 2 {
      const p0 = P.nodes[d.fnParams[0]]
      if p0 is Param {
        if p0.parName == "self" { selfOk = true }
      }
    }
  }
  if !selfOk { return -1 }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    let retTy = ft.fnRet
    if retTy == -2 { retTy = TY_ERR }
    const params = ft.fnParamTypes
    if params.length != 2 { return -1 }
    if !assignable(lt, params[0]) { return -1 }
    const bNames: string[] = []
    const bTys: i32[] = []
    const p0t = T.tys[params[0]]
    if p0t is TyVar {
      if !holeDemandOk(p0t.tvName, -1, lt) { return -1 }
    }
    bindGenWalk(params[0], lt, bNames, bTys)
    bindGenWalk(params[1], rt, bNames, bTys)
    const expected = substTyDeep(params[1], bNames, bTys)
    const p1t = T.tys[params[1]]
    if p1t is TyVar {
      if !holeDemandOk(p1t.tvName, rightIx, rt) {
        tErr(
          "operator '" +
            op +
            "': expected " +
            holeDemandStr(p1t.tvName) +
            ", got " +
            tyToStr(rt),
          ix,
        )
      }
    }
    if !assignableExpr(rightIx, rt, expected) {
      tErr(
        "operator '" +
          op +
          "': expected " +
          tyToStr(expected) +
          ", got " +
          tyToStr(rt),
        ix,
      )
    }
    if bNames.length > 0 { retTy = substTyDeep(retTy, bNames, bTys) }
    return retTy
  }
  -1
}

// The declared parameter NAMES of the top-level function `name` (via its
// `FuncDecl` in `fnDeclIx`), or an empty list when no declaration is known (an
// undeclared name, or a closure-valued binding — `TyFunc` carries no parameter
// names, so NAMED arguments resolve only against a declared function).
function fnParamNamesOf(name: string) {
  const out: string[] = []
  const dIx = fnDeclIx[name] ?? -1
  if dIx >= 0 {
    const d = P.nodes[dIx]
    if d is FuncDecl {
      const ps = d.fnParams
      let i = 0
      while i < ps.length {
        const p = P.nodes[ps[i]]
        if p is Param { out.push(p.parName) }
        i = i + 1
      }
    }
  }
  out
}

// The DECLARED parameter nodes behind a call's callee, when the call is DIRECT
// — an `Ident` that the scope chain resolves to a `FuncDecl` (top-level or
// nested). A closure-valued callee has no declaration to read defaults from, so
// it answers the empty list and every default-driven relaxation is off for it:
// a function VALUE keeps full arity.
function calleeDeclParams(calleeIx: i32) {
  const none: i32[] = []
  const cf = P.nodes[calleeIx]
  if cf is Ident {
    const dIx = lookupFnDeclNode(cf.identName)
    if dIx >= 0 {
      const d = P.nodes[dIx]
      if d is FuncDecl { return d.fnParams }
    }
  }
  none
}

// The "expected …" half of an arity diagnostic. A parameter list with no
// defaults has `lo == hi` and renders exactly as it always did; a list with
// defaults renders the accepted RANGE, so the reader sees which calls are legal
// rather than only which one is not.
function arityWantText(lo: i32, hi: i32) {
  if lo >= hi { return i32ToStr(hi) }
  i32ToStr(lo) + " to " + i32ToStr(hi)
}

// Is `dIx` a form allowed as a parameter DEFAULT — a LITERAL, optionally signed?
//
// A default is substituted into each DIRECT call site that omits the argument,
// so its expression is emitted in the CALLER's frame. A literal is the exact
// boundary that makes that hygienic: it has no free names, so it can neither
// read the callee's parameters and locals (which do not exist at the call site)
// nor be captured by a caller-local binding that happens to share a name with
// something the default meant. Anything with a name in it — a reference to an
// EARLIER parameter, a call, an allocation — would have to be evaluated inside
// the callee, and a callee that evaluates its own defaults needs to know which
// arguments were omitted: an ABI change, not sugar.
function paramDefaultIsLiteral(dIx: i32) {
  if dIx < 0 { return false }
  const d = P.nodes[dIx]
  if d is NumLit { return true }
  if d is StrLit { return true }
  if d is CharLit { return true }
  if d is BoolLit { return true }
  if d is NullLit { return true }
  if d is Unary {
    // A SIGNED numeric literal (`-1`): the sign is a `Unary` over the literal,
    // and it is still name-free.
    if d.unOp == "-" || d.unOp == "+" {
      const inner = P.nodes[d.unArg]
      if inner is NumLit { return true }
    }
  }
  false
}

// Declaration-side validation of parameter DEFAULTS. `paramTys` aligns 1:1 with
// `params` — the resolved annotation types.
//
// Defaults are DIRECT-CALL-SITE SUGAR: a call omitting a trailing argument has
// the default substituted into it before emit, so the callee's ABI (full arity,
// one wasm parameter per declared parameter) and the `$fnsig` closure signature
// space are untouched, and a function VALUE keeps its full signature. The four
// rules below are that decision made explicit at the places the design leaks:
//
//   TRAILING-ONLY  a parameter without a default may not follow one with a
//                  default — otherwise omitting the earlier argument would have
//                  to shift the later ones and positional omission stops being
//                  decidable.
//   ANNOTATED      a default needs a type annotation. An un-annotated parameter
//                  is an inference HOLE that each call site pins independently
//                  and the emitter monomorphizes per pinned shape; a hole with a
//                  default would be pinned at some call sites and not others.
//                  Requiring the annotation keeps defaults and holes DISJOINT,
//                  so the monomorphizer's instance keying never sees a default.
//   NON-GENERIC    the annotation may not mention one of this function's own
//                  type parameters — a call that omits the argument would drop
//                  one of that type parameter's binding sites.
//   LITERAL        the default expression must be a literal (see
//                  `paramDefaultIsLiteral`).
function checkParamDefaults(n: FuncDecl, params: i32[], paramTys: i32[]) {
  let sawDefault = false
  let pi = 0
  while pi < params.length {
    const p = P.nodes[params[pi]]
    if p is Param {
      const dIx = p.parDefault
      if dIx < 0 {
        if sawDefault {
          tErr(
            "parameter `" +
              p.parName +
              "` has no default but follows one that does — defaults must be the LAST parameters",
            params[pi],
          )
        }
      } else {
        sawDefault = true
        if p.parType < 0 {
          tErr(
            "a default value needs a type annotation — write `" +
              p.parName +
              ": T = …`",
            params[pi],
          )
        } else if tsMentionsAnyName(annTsOf(p.parType), n.fnTyParams) {
          tErr(
            "parameter `" +
              p.parName +
              "` cannot have a default: its type names a type parameter of `" +
              n.fnName +
              "`, which an omitted argument would leave unbound",
            params[pi],
          )
        }
        if !paramDefaultIsLiteral(dIx) {
          tErr(
            "a default value must be a literal — `" +
              p.parName +
              "`'s default is substituted at each call site, so it cannot name a parameter, a local, or a call",
            dIx,
          )
        } else {
          let pt = TY_ERR
          if pi < paramTys.length { pt = paramTys[pi] }
          seedExpected(dIx, pt)
          const dt = checkNode(dIx)
          if pt >= 0 && !assignable(dt, pt) {
            tErr(
              "parameter `" +
                p.parName +
                "` default: expected " +
                tyToStr(pt) +
                ", got " +
                tyToStr(dt),
              dIx,
            )
          }
        }
      }
    }
    pi = pi + 1
  }
  0
}

// Bind a call's arguments into PARAMETER order when any is NAMED (`f(b: 1,
// a: 2)`), mirroring the host's `orderArgumentsByParameters`: named args fill
// their parameter's slot, positionals fill the remaining slots in order.
// Returns the VALUE-node indices in parameter order, or an empty list on a
// binding failure (an unknown/duplicate name — diagnosed here). `paramNames`
// must align 1:1 with the checked parameter types (the UFCS path passes the
// names AFTER `self`, since the receiver fills slot 0 separately).
// `declParams` is the callee's `FuncDecl.fnParams`, or empty when the callee has
// no declaration: a slot left unfilled by both the named and the positional pass
// is filled from its parameter's DEFAULT, which is what lets a named call skip a
// MIDDLE parameter (`f(1, c: 3)` where `b` has a default). A slot with neither
// an argument nor a default names the parameter it is missing.
function orderNamedCallArgs(
  paramNames: string[],
  args: i32[],
  argNames: string[],
  ix: i32,
  declParams: i32[],
) {
  const bad: i32[] = []
  if paramNames.length < args.length {
    // Arity is diagnosed by the caller; just refuse to reorder.
    tErr("named arguments require a declared function with matching arity", ix)
    return bad
  }
  const ordered = orderArgsByParamNames(paramNames, args, argNames)
  if ordered.length != paramNames.length {
    tErr("named argument does not match a parameter", ix)
    return bad
  }
  const missing = fillArgDefaults(ordered, declParams)
  if missing >= 0 {
    let who = ""
    if missing < paramNames.length { who = paramNames[missing] }
    tErr("missing argument for parameter `" + who + "`", ix)
    return bad
  }
  ordered
}

function ufcsCallTy(plainName: string, recvTy: i32, n: Call, ix: i32) {
  // A UFCS callee names a free `self`-function by its SOURCE name. The module
  // merge mangles such functions (`shout` → `shout$m1`) but leaves the call's
  // property string plain so field precedence still resolves from the receiver
  // type; `ufcsAliasOf` maps the plain name to the mangled function here, where
  // the field check has already been passed. Single-file builds have no merge,
  // so the alias is identity.
  const name = ufcsAliasOf(plainName)
  const fnTy = lookup(name)
  if fnTy < 0 { return -1 }
  const preFt = T.tys[fnTy]
  if preFt is TyFunc {
    if preFt.fnRet == -2 {
      if !onInferStack(name) {
        const dIx = fnDeclIx[name] ?? -1
        if dIx >= 0 { checkNode(dIx) }
      }
    }
  } else {
    return -1
  }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    let retTy = ft.fnRet
    if retTy == -2 { retTy = TY_ERR }
    const params = ft.fnParamTypes
    let args = n.callArgs
    if params.length != args.length + 1 { return -1 }
    if !assignable(recvTy, params[0]) { return -1 }
    // NAMED arguments (`5.scale(plus: 1, by: 2)`): the receiver is an unnamed
    // slot-0 positional, so the explicit args bind against the parameter names
    // AFTER `self`, in PARAMETER order (host: `orderArgumentsByParameters` over
    // the full list with the injected receiver unnamed).
    if hasNamedArgs(n.callArgNames) {
      const uNames = fnParamNamesOf(name)
      if uNames.length != params.length {
        tErr("named arguments require a declared function", ix)
        return TY_ERR
      }
      const restNames: string[] = []
      let rn = 1
      while rn < uNames.length {
        restNames.push(uNames[rn])
        rn = rn + 1
      }
      // UFCS keeps EXACT arity (the `params.length != args.length + 1` gate
      // above), so no slot can be left for a default to fill — hence the empty
      // declaration list.
      const noDefaults: i32[] = []
      args = orderNamedCallArgs(restNames, args, n.callArgNames, ix, noDefaults)
      if args.length != restNames.length { return TY_ERR }
    }
    // Generic dispatch (host: UFCS reuses the call machinery, so `self`
    // monomorphizes to the receiver's shape): bind the receiver into the
    // `self` param's holes — when the body DEMANDED fields, a receiver
    // missing one is NOT this method (fall through to the caller's error) —
    // then bind/check the explicit args and substitute the return.
    const bNames: string[] = []
    const bTys: i32[] = []
    const p0 = T.tys[params[0]]
    if p0 is TyVar {
      if !holeDemandOk(p0.tvName, -1, recvTy) { return -1 }
    }
    bindGenWalk(params[0], recvTy, bNames, bTys)
    let i = 0
    while i < args.length {
      const at = checkNode(args[i])
      bindGenWalk(params[i + 1], at, bNames, bTys)
      const expected = substTyDeep(params[i + 1], bNames, bTys)
      const pHole = T.tys[params[i + 1]]
      if pHole is TyVar {
        if !holeDemandOk(pHole.tvName, args[i], at) {
          holeArgDemandErr(pHole.tvName, i + 1, at, ix)
        }
        if holeIsArrayDemanded(pHole.tvName) {
          if tyRefusesArrayDemand(at) { holeArgArrayErr(i + 1, at, ix) }
        }
      }
      constrainEmpty(at, expected)
      if !assignableExpr(args[i], at, expected) {
        tErr(
          "argument " +
            i32ToStr(i + 1) +
            ": expected " +
            tyToStr(expected) +
            ", got " +
            tyToStr(at),
          ix,
        )
      }
      i = i + 1
    }
    if bNames.length > 0 { retTy = substTyDeep(retTy, bNames, bTys) }
    return retTy
  }
  -1
}

// The innermost guard registration for `name`, or -1 (not a guard).
function guardIndexOf(name: string) {
  let i = guardNames.length - 1
  while i >= 0 {
    if guardNames[i] == name { return i }
    i = i - 1
  }
  -1
}

// The A6b guard fact of a function body's result expression over the params:
// the index of the param whose NULL-ness it tests, or -1 (not a guard shape).
// Sets nothing itself — the caller reads the branch direction from the shape:
// the encoded result is `paramIndex * 2 + 1` when the non-null branch is THEN
// (`x != null`, `x is T`), `paramIndex * 2` when it is ELSE (`x == null`,
// `x is null`). Mirrors the host's `conditionNarrowing` over a bare param.
function guardFactOf(exprIx: i32, paramNames: string[]) {
  const e = P.nodes[exprIx]
  if e is Paren { return guardFactOf(e.parInner, paramNames) }
  if e is IsExpr {
    const obj = P.nodes[e.isObj]
    if obj is Ident {
      let gi = 0
      while gi < paramNames.length {
        if paramNames[gi] == obj.identName {
          if e.isVariant == "null" { return gi * 2 }
          return gi * 2 + 1
        }
        gi = gi + 1
      }
    }
    return -1
  }
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" {
      const placeIx = nullCmpPlace(exprIx)
      if placeIx >= 0 {
        const p = P.nodes[placeIx]
        if p is Ident {
          let gj = 0
          while gj < paramNames.length {
            if paramNames[gj] == p.identName {
              if e.binOp == "!=" { return gj * 2 + 1 }
              return gj * 2
            }
            gj = gj + 1
          }
        }
      }
    }
  }
  -1
}

// ── numeric-opcode intrinsics ────────────────────────────────────────────────
// The operations that ARE a single wasm instruction. They are not a library —
// there is no runtime behind them, only an opcode — so the checker types them here
// and the emitter writes the byte. Three families:
//
//   BITCASTS, width-named because they cross between the float and integer views:
//     f32bits(x: f32): i32      i32.reinterpret_f32
//     f64bits(x: f64): i64      i64.reinterpret_f64
//     f32fromBits(b: i32): f32  f32.reinterpret_i32
//     f64fromBits(b: i64): f64  f64.reinterpret_i64
//   FLOAT ops, one name per operation with the WIDTH taken from the operands:
//     sqrt · abs · floor · ceil · trunc · nearest      (1 argument)
//     min · max · copysign                             (2 arguments)
//   INTEGER ops, likewise width-directed:
//     clz · ctz · popcnt                               (1 argument)
//     rotl · rotr · divU · remU                        (2, yielding the width)
//     ltU · leU · gtU · geU                            (2, yielding a boolean)
//
// The IEEE ones are bit-exact and fully specified, which is why they can be the whole
// float vocabulary a deterministic program needs: `nearest` is round-half-to-EVEN,
// `min`/`max` propagate NaN and order -0 below +0 (they are NOT `<`/`>`), `abs` and
// `copysign` are sign-bit edits. Transcendentals are deliberately absent — no wasm
// opcode computes one, so any `sin` would be a library whose last bit is a policy
// choice, and a program that must match another implementation exactly has to own
// that choice itself.
//
// The UNSIGNED integer ops are operations, not a type: an i32 IS signed in VL (`/` is
// div_s, `<` is lt_s, `>>` is shr_s) and the unsigned instructions read the identical
// bit pattern under a different interpretation. VL already settled this shape when it
// spelled the unsigned shift as the OPERATOR `>>>` rather than introducing a `u32`;
// `divU`/`ltU` are that decision continued, and they cost no new type, no new widening
// edge and no second integer rep.

// Is `name` bound by the PROGRAM — a declared function (hoisted, so a forward
// reference counts) or any in-scope binding? A user definition wins over the
// intrinsic of the same name, so adding an intrinsic can never capture a call that
// already resolved to the program's own function. The emitter reads the same rule
// off its collected function table (`fnIndexOf`), which the same declarations fill.
function numIntrShadowed(name: string) {
  if (fnDeclIx[name] ?? -1) >= 0 { return true }
  lookup(name) >= 0
}

// The ARGUMENT type of the bitcast named `name`, or -1 when it is not a bitcast.
function bitcastArgTy(name: string) {
  if name == "f32bits" { return TY_F32 }
  if name == "f64bits" { return TY_F64 }
  if name == "f32fromBits" { return TY_I32 }
  if name == "f64fromBits" { return TY_I64 }
  -1
}

// The RESULT type of the bitcast named `name` — the SAME 32/64 bit width read at the
// other type, which is the whole point: no value conversion, only a reinterpretation.
function bitcastRetTy(name: string) {
  if name == "f32bits" { return TY_I32 }
  if name == "f64bits" { return TY_I64 }
  if name == "f32fromBits" { return TY_F32 }
  if name == "f64fromBits" { return TY_F64 }
  -1
}

// Type the bitcast call `name(arg)`, or -1 when `name` is not a bitcast. Arity and the
// argument type are checked here; `assignableExpr` (not bare `assignable`) so a float
// LITERAL argument re-encodes into an `f32` parameter, matching every other f32 position.
function bitcastCallTy(name: string, n: Call, ix: i32) {
  const want = bitcastArgTy(name)
  if want < 0 { return -1 }
  const args = n.callArgs
  if args.length != 1 {
    tErr(name + " expects 1 argument, got " + i32ToStr(args.length), ix)
  } else {
    const got = checkNode(args[0])
    if !assignableExpr(args[0], got, want) {
      tErr(name + " expects " + tyToStr(want) + ", got " + tyToStr(got), ix)
    }
  }
  bitcastRetTy(name)
}

// Is `name` one of the numeric-opcode intrinsics at all? The emitter's import scan asks
// this: an intrinsic RESULT type appears nowhere as an annotation (`f64bits(x)` is an
// i64, `f32fromBits(b)` an f32), so the scan that decides the `__print_*__` imports has
// to recognize the call itself and read its recorded type.
export function isNumIntrinsicName(name: string) {
  if bitcastArgTy(name) >= 0 { return true }
  if floatIntrArity(name) > 0 { return true }
  intIntrArity(name) > 0
}

// How many arguments the FLOAT intrinsic `name` takes, or 0 when it is not one.
function floatIntrArity(name: string) {
  if name == "sqrt" { return 1 }
  if name == "abs" { return 1 }
  if name == "floor" { return 1 }
  if name == "ceil" { return 1 }
  if name == "trunc" { return 1 }
  if name == "nearest" { return 1 }
  if name == "min" { return 2 }
  if name == "max" { return 2 }
  if name == "copysign" { return 2 }
  0
}

// How many arguments the INTEGER intrinsic `name` takes, or 0 when it is not one.
function intIntrArity(name: string) {
  if name == "clz" { return 1 }
  if name == "ctz" { return 1 }
  if name == "popcnt" { return 1 }
  if name == "rotl" { return 2 }
  if name == "rotr" { return 2 }
  if name == "divU" { return 2 }
  if name == "remU" { return 2 }
  if name == "ltU" { return 2 }
  if name == "leU" { return 2 }
  if name == "gtU" { return 2 }
  if name == "geU" { return 2 }
  0
}

// Is `name` one of the unsigned COMPARISONS? Those yield a boolean; every other
// integer intrinsic yields the operand width (the wasm instructions do exactly this —
// `i64.lt_u` leaves an i32, `i64.clz` an i64).
function intIntrIsCompare(name: string) {
  if name == "ltU" { return true }
  if name == "leU" { return true }
  if name == "gtU" { return true }
  name == "geU"
}

// Does the argument at `argIx`, of type `ty`, make the whole operation f64? A GENUINE
// f64 does; a bare float LITERAL does not, because it re-encodes exactly at f32 and so
// adapts DOWN to an f32 operand. This is the rule the binary operators already run on
// (`f32var + 1.0` stays f32, `f32var + f64var` widens), so an intrinsic and an operator
// applied to the same operands compute at the same width.
function argForcesF64(argIx: i32, ty: i32) {
  if primNameOf(ty) != "f64" { return false }
  !isFloatLitExpr(argIx)
}

// The WIDTH a float intrinsic call computes at: f32 when an operand is genuinely f32 and
// none is genuinely f64, else f64. All-integer operands therefore land on f64, where they
// widen losslessly — `sqrt(2)` is the f64 square root, as `2 / 1.0` is f64 division.
function floatIntrWidth(argIxs: i32[], argTys: i32[]) {
  let sawF32 = false
  let i = 0
  while i < argTys.length {
    if argForcesF64(argIxs[i], argTys[i]) { return TY_F64 }
    if primNameOf(argTys[i]) == "f32" { sawF32 = true }
    i = i + 1
  }
  if sawF32 { return TY_F32 }
  TY_F64
}

// The WIDTH an integer intrinsic call computes at: i64 when an operand is i64 (the i32
// side widens losslessly), else i32 — the selection rule the i64 binary operators use.
function intIntrWidth(argTys: i32[]) {
  let i = 0
  while i < argTys.length {
    if primNameOf(argTys[i]) == "i64" { return TY_I64 }
    i = i + 1
  }
  TY_I32
}

// Type the float / integer intrinsic call `name(args…)`, or -1 when `name` is not one.
// The operand width is decided from the arguments and every argument is then checked
// against it, so a mixed call reports the width it actually computes at.
function numIntrCallTy(name: string, n: Call, ix: i32) {
  const isFloat = floatIntrArity(name) > 0
  let arity = intIntrArity(name)
  if isFloat { arity = floatIntrArity(name) }
  if arity == 0 { return -1 }
  const args = n.callArgs
  if args.length != arity {
    let want = i32ToStr(arity) + " arguments"
    if arity == 1 { want = "1 argument" }
    tErr(name + " expects " + want + ", got " + i32ToStr(args.length), ix)
    // Still yield a type so the call site does not cascade: the width is unknowable
    // from a wrong-arity call, so take the family's default.
    if isFloat { return TY_F64 }
    if intIntrIsCompare(name) { return TY_BOOL }
    return TY_I32
  }
  const argTys: i32[] = []
  let i = 0
  while i < args.length {
    argTys.push(checkNode(args[i]))
    i = i + 1
  }
  let width = intIntrWidth(argTys)
  if isFloat { width = floatIntrWidth(args, argTys) }
  let j = 0
  while j < args.length {
    if !assignableExpr(args[j], argTys[j], width) {
      tErr(
        name + " expects " + tyToStr(width) + ", got " + tyToStr(argTys[j]),
        ix,
      )
    }
    j = j + 1
  }
  if !isFloat {
    if intIntrIsCompare(name) { return TY_BOOL }
  }
  width
}

// A call expression: array-method builtins (`xs.push`), string-method builtins
// (`.slice`/`.indexOf`/`.includes`/`.charCodeAt`), the `print`/`fromCodePoint`
// builtins, then the generic function-call path (arity + per-arg assignability).
// UFCS `self`-method dispatch (host parser: `o.f(args)` → `f(o, args)` for a
// free function whose first parameter accepts the receiver). Returns the
// call's type, or -1 when no matching function exists (the caller reports its
// own "no method"/"no field" error). Mirrors the general call path's pending-
// return demand-inference; generic (TyVar) self-functions are not dispatched.
function checkCallNode(n: Call, ix: i32) {
  // Array method call `xs.push(e)`: when the callee is a member access whose
  // receiver is an array, type it as a builtin (NOT a struct field). Only fires for
  // an array receiver, so a plain `f(…)` / non-array method falls through.
  const cfn = P.nodes[n.callFn]
  if cfn is Member {
    // A member-access callee is, by definition, function-typed — the `method`
    // classification for semantic tokens. The builtin method arms below type and
    // return it directly (never via the member-read arm), so record its name here;
    // a struct field holding a function falls through to `checkNode(n.callFn)` and
    // `symMem` overwrites the type for hover.
    symMemMethod(n.callFn)
    let recvTy = checkNode(cfn.memObj)
    let rt = T.tys[recvTy]
    // An un-annotated-param HOLE receiving an ARRAY method (`self.map`/`.filter`/`.push`/
    // `.pop`) is constrained to an array — the method analogue of `self[i]` / `self.length`.
    // Synthesize an array over a DERIVED element hole (`?elem.<hole>`) and fall into the
    // array-method arm below; `noteArrayDemand` makes a non-array argument a call-site error
    // and pins the param to the concrete array per call shape (the emitter then monomorphizes
    // the method on the concrete element, exactly like an annotated array param). Without this
    // the hole would grow a `{map: any}` STRUCT shape no array argument can satisfy.
    if rt is TyVar {
      if holeArrMethod(cfn.memProp) {
        noteArrayDemand(rt.tvName)
        const elemHole = mkDerivedHole(HD_ELEM, "", -1, -1, recvTy)
        recvTy = mkArrayTy(elemHole)
      } else if holeMapMethod(cfn.memProp) {
        // An un-annotated-param HOLE receiving a MAP/SET method — the exact dual of the
        // array arm above. Become the hole's DEMANDED map (`{[?]: ?}`, one arena entry per
        // hole) and fall into the map-method arm below, which pins the open key/value from
        // the method's own arguments in place, exactly as `.push` pins an empty `[]`'s
        // element. `.add` mints the Set flavor, the only thing `.add` on a hole can mean.
        // Without this the hole grew a `{set: any}` STRUCT shape no map argument can
        // satisfy — `argument 1: expected {set: _}, got {[string]: i32}`, a diagnostic that
        // names a method the argument has.
        recvTy = holeMapDemandTy(rt.tvName, cfn.memProp == "add")
      }
    }
    rt = T.tys[recvTy]
    if rt is TyArray {
      const margs = n.callArgs
      if cfn.memProp == "push" {
        if margs.length != 1 {
          tErr("push expects 1 argument, got " + i32ToStr(margs.length), ix)
        } else {
          // Contextual param inference for a pushed callback: `fs.push((n) => n + 1)` over a
          // `((i32) => i32)[]` seeds the lambda's param from the element function type, so an
          // un-annotated lambda infers `n` instead of erroring (mirrors the `.map`/`.filter`
          // seeding). A non-function element / non-lambda arg is left untouched by `seedExpected`.
          if rt.aElem >= 0 { seedExpected(margs[0], rt.aElem) }
          const pat = checkNode(margs[0])
          // The first `.push(v)` on a bare empty `[]` (element hole `-1`) PINS its
          // element type to `typeof v` in place — this is the usage-driven inference
          // that resolves an un-annotated `const xs = []` (see `infer-empty-push.vl`),
          // and clears the uninferred-binding floor. A later conflicting push is then
          // a clean type error.
          if rt.aElem < 0 {
            rt.aElem = pat
            tyMutEpoch = tyMutEpoch + 1 // `.push` pinned the element in place
          } else if !assignableExpr(margs[0], pat, rt.aElem) {
            // `assignableExpr` (not bare `assignable`) so a float-literal argument re-encodes into
            // an `f32` element (`xs.push(2.5)` over `f32[]`), exactly as it does at a binding.
            tErr(
              "push: cannot add " + tyToStr(pat) + " to " + tyToStr(recvTy),
              ix,
            )
          }
        }
        return TY_I32
      }
      // `.map(fn)` / `.filter(pred)`: the callback is a 1-arg function over the
      // element type; map yields an array of the callback's return, filter the
      // same array type (its predicate must yield bool).
      if cfn.memProp == "map" || cfn.memProp == "filter" {
        const cargs = n.callArgs
        if cargs.length != 1 {
          tErr(
            cfn.memProp + " expects 1 argument, got " + i32ToStr(cargs.length),
            ix,
          )
          return TY_ERR
        }
        // Contextual param inference: the callback is `(elem) -> ?` over the
        // receiver's element type. Stash that expected param type so an
        // UN-annotated function-literal arg (`function(n) …`) infers `n` from the
        // receiver instead of erroring — matching the host. Only meaningful when
        // the arg is an anonymous function literal AND the element type is known
        // (not the `-1` hole of a never-pinned `[]`); otherwise it is left
        // pending and cleared below so it can't leak.
        const cbArg = P.nodes[cargs[0]]
        if cbArg is FuncDecl {
          if cbArg.fnName == "" && rt.aElem >= 0 {
            recordCbExpected(cargs[0], [rt.aElem])
          }
        }
        const cbTy = checkNode(cargs[0])
        const cb = T.tys[cbTy]
        if cb is TyFunc {
          const cbParams = cb.fnParamTypes
          if cbParams.length != 1 {
            tErr(
              cfn.memProp +
                " callback expects 1 parameter, got " +
                i32ToStr(cbParams.length),
              ix,
            )
          } else if !assignable(rt.aElem, cbParams[0]) {
            tErr(
              cfn.memProp +
                " callback: parameter expects " +
                tyToStr(cbParams[0]) +
                ", got " +
                tyToStr(rt.aElem),
              ix,
            )
          }
          if cfn.memProp == "filter" {
            if !assignable(cb.fnRet, TY_BOOL) {
              tErr(
                "filter predicate must yield boolean, got " + tyToStr(cb.fnRet),
                ix,
              )
            }
            return recvTy
          }
          return mkArrayTy(cb.fnRet)
        }
        tErr(cfn.memProp + " expects a function, got " + tyToStr(cbTy), ix)
        return TY_ERR
      }
      // `.pop()` / `.get(i)` yield `T | null` (an empty pop / out-of-range get is
      // normal absence); `.clear()` empties in place and yields nothing.
      if cfn.memProp == "pop" {
        if margs.length != 0 {
          tErr("pop expects 0 arguments, got " + i32ToStr(margs.length), ix)
        }
        return mkNullableTy(rt.aElem)
      }
      if cfn.memProp == "get" {
        if margs.length != 1 {
          tErr("get expects 1 argument, got " + i32ToStr(margs.length), ix)
        } else {
          const gat = checkNode(margs[0])
          if !assignable(gat, TY_I32) {
            tErr("get: index must be i32, got " + tyToStr(gat), ix)
          }
        }
        return mkNullableTy(rt.aElem)
      }
      if cfn.memProp == "clear" {
        if margs.length != 0 {
          tErr("clear expects 0 arguments, got " + i32ToStr(margs.length), ix)
        }
        return TY_VOID
      }
      // `.slice(start, end?)` yields a NEW array of the SAME element type — the bounds
      // are i32 (a missing `end` defaults to the length; negatives count from the end).
      if cfn.memProp == "slice" {
        if margs.length != 1 && margs.length != 2 {
          tErr(
            "slice expects 1 or 2 arguments, got " + i32ToStr(margs.length),
            ix,
          )
        } else {
          let si = 0
          while si < margs.length {
            const sat = checkNode(margs[si])
            if !assignable(sat, TY_I32) {
              tErr("slice: bound must be i32, got " + tyToStr(sat), ix)
            }
            si = si + 1
          }
        }
        return recvTy
      }
      // UFCS `self`-method on an array receiver (`parts.join(sep)`): an array
      // carries no user FIELD, so a matching free `self`-function resolves
      // directly — the array dual of the string/struct/union UFCS paths.
      const au = ufcsCallTy(cfn.memProp, recvTy, n, ix)
      if au >= 0 { return au }
      tErr("no method '." + cfn.memProp + "' on array " + tyToStr(recvTy), ix)
      return TY_ERR
    }
    // Map/Set methods over the `{[K]: V}` rep, gated by FLAVOR: a map exposes
    // `.set`/`.get`/`.has`/`.delete`/`.keys()`/`.values()`; a SET exposes only
    // `.add`/`.has`/`.delete`/`.values()` (the Map surface must not leak — `.set`
    // on a set is an unknown-property error). `.add` is the one member gated on
    // the VALUE TYPE rather than on the flavor bit — see its arm. The first
    // `.set`/`.add` on a bare `Map()`/`Set()` PINS its key/value holes in place,
    // so a later conflicting use is a clean type error.
    if rt is TyMap {
      const mp = cfn.memProp
      const margs2 = n.callArgs
      if mp == "set" && rt.mSet == 0 {
        if margs2.length != 2 {
          tErr("set expects 2 arguments, got " + i32ToStr(margs2.length), ix)
        } else {
          const k0 = checkNode(margs2[0])
          // THE VALUE ARGUMENT IS A STORE INTO THE MAP'S VALUE SLOT, so it takes the
          // SAME two contextual steps `xs.push(v)` takes into an array element and
          // `m[k] = v` takes into the very same slot — `seedExpected` first, then the
          // expression-aware `assignableExpr`. Without them `.set` was the one store
          // position with the bare structural check, and the twin grid against
          // `m[k] = v` read 34 CHKERR cells whose index-assignment spelling was OK:
          // a float / exact-integer literal into an `f32` value, a member literal into
          // a literal-union value, an object / array literal adapting field- or
          // element-wise, and each of those again through a `V | null` or `f32 |
          // string` value and through a map reached from an array element or a struct
          // field. `assignableExpr` is not a second copy of those rules — it IS the
          // one home the assignment path calls, so the two cannot drift.
          if rt.mVal >= 0 { seedExpected(margs2[1], rt.mVal) }
          const v0 = checkNode(margs2[1])
          if rt.mKey < 0 {
            rt.mKey = k0
            tyMutEpoch = tyMutEpoch + 1 // `.set` pinned the key in place
            checkInferredMapKey(k0, rt.mSet, ix)
          } else if (
            !assignable(k0, rt.mKey) &&
            !nomSlotAccepts(margs2[0], k0, rt.mKey)
          ) {
            tErr(
              "set: expected " + tyToStr(rt.mKey) + ", got " + tyToStr(k0),
              ix,
            )
          }
          if rt.mVal < 0 {
            rt.mVal = v0
            tyMutEpoch = tyMutEpoch + 1 // `.set` pinned the value in place
          } else if !assignableExpr(margs2[1], v0, rt.mVal) {
            // `assignableExpr` SUBSUMES the `nomSlotAccepts` retry this arm used to
            // carry (that helper IS `assignableExpr` behind two gates), so the newtype
            // literal-adoption rule the map slot needed — `m.set("k", 1)` over a
            // `{[string]: EntityId}` — still fires, now as one rung instead of two.
            tErr(
              "set: expected " + tyToStr(rt.mVal) + ", got " + tyToStr(v0),
              ix,
            )
          }
        }
        return TY_VOID
      }
      if mp == "get" && rt.mSet == 0 {
        if margs2.length != 1 {
          tErr("get expects 1 argument, got " + i32ToStr(margs2.length), ix)
        } else {
          const k1 = checkNode(margs2[0])
          if !assignable(k1, rt.mKey) {
            tErr(
              "get: key must be " + tyToStr(rt.mKey) + ", got " + tyToStr(k1),
              ix,
            )
          }
        }
        return mkNullableTy(rt.mVal)
      }
      // `.add(x)` — the membership INSERT, `m[x] = true` spelled as the Set surface.
      // ADMITTED ON ANY MAP WHOSE VALUE IS `boolean`, not only on one whose
      // PROVENANCE is a `Set()` call. `mSet` is a one-way refinement: it is written
      // by the `Set()` constructor and carried onto a `let`/`const` binding under a
      // map-shaped annotation (see `checkLetDeclNode`), and by NO other position —
      // a struct or variant FIELD, an inline-shape field, a PARAM, a return, an
      // array element and a map value all resolve `{[K]: boolean}` through
      // `tsToTy`/`nameToTyReal`, which build `mkMapTy(k, v, 0)`. So gating `.add` on
      // `mSet == 1` made it a property of HOW THE VALUE WAS SPELLED AT ITS BINDING
      // rather than of its type, and `s.seen.add(5)` was `unknown property` in every
      // one of those positions — through a BOUND receiver (`const b = s.seen`)
      // exactly as much as a direct one, which is what says the receiver form was
      // never the discriminator.
      // The value type IS the whole question: a `boolean`-valued map is precisely
      // the shape that holds a Set's contents, `.add` stores the same constant
      // `true` the assignment path stores, and the emitter's `add` arm is already
      // flavor-blind (it gates on `exprMap`, the predicate `.set` gates on, and the
      // reservation scan claims `set` and `add` in ONE arm). The Set surface stays
      // sealed in the direction the tests pin: an `mSet == 1` value still gets
      // `unknown property` for `.set`/`.get`/`.keys` (those arms gate on
      // `mSet == 0`), and `.values()` still yields ELEMENTS for a set and the
      // membership booleans for a map. A bare `Map()` whose value hole is still
      // open (`mVal < 0`) is NOT boolean-valued, so it keeps rejecting `.add` —
      // `Set()` remains the way to write a set.
      if mp == "add" && (rt.mSet == 1 || tyIsPrimNamed(rt.mVal, "boolean")) {
        if margs2.length != 1 {
          tErr("add expects 1 argument, got " + i32ToStr(margs2.length), ix)
        } else {
          const ka = checkNode(margs2[0])
          if rt.mKey < 0 {
            rt.mKey = ka
            tyMutEpoch = tyMutEpoch + 1 // `.add` pinned the Set key in place
            checkInferredMapKey(ka, rt.mSet, ix)
          } else if !assignable(ka, rt.mKey) {
            tErr(
              "add: expected " + tyToStr(rt.mKey) + ", got " + tyToStr(ka),
              ix,
            )
          }
        }
        return TY_VOID
      }
      if mp == "has" || mp == "delete" {
        if margs2.length != 1 {
          tErr(mp + " expects 1 argument, got " + i32ToStr(margs2.length), ix)
        } else {
          const k2 = checkNode(margs2[0])
          if !assignable(k2, rt.mKey) {
            tErr(
              mp + ": key must be " + tyToStr(rt.mKey) + ", got " + tyToStr(k2),
              ix,
            )
          }
        }
        return TY_BOOL
      }
      if mp == "keys" && rt.mSet == 0 {
        if margs2.length != 0 { tErr("keys expects no arguments", ix) }
        return mkArrayTy(rt.mKey)
      }
      if mp == "values" {
        if margs2.length != 0 { tErr("values expects no arguments", ix) }
        // A set's `.values()` yields its ELEMENTS (the keys); a map's its values.
        if rt.mSet == 1 { return mkArrayTy(rt.mKey) }
        return mkArrayTy(rt.mVal)
      }
      tErr("unknown property `" + mp + "` on " + tyToStr(recvTy), ix)
      return TY_ERR
    }
    // String methods: `.slice(i32,i32)->string`, `.indexOf(string)->i32`,
    // `.includes(string)->bool`, `.charCodeAt(i32)->i32`. (`.length` is a Member,
    // handled there; `s[i]` is an Index.) Element types are checked.
    if rt is TyPrim {
      if rt.primName == "string" {
        const sp = cfn.memProp
        const sargs = n.callArgs
        if sp == "slice" {
          if sargs.length != 2 {
            tErr("slice expects 2 arguments, got " + i32ToStr(sargs.length), ix)
          } else {
            const s0 = checkNode(sargs[0])
            const s1 = checkNode(sargs[1])
            if !assignable(s0, TY_I32) || !assignable(s1, TY_I32) {
              tErr(
                "slice expects i32 bounds, got " +
                  tyToStr(s0) +
                  " and " +
                  tyToStr(s1),
                ix,
              )
            }
          }
          return TY_STR
        }
        if sp == "indexOf" {
          if sargs.length != 1 {
            tErr(
              "indexOf expects 1 argument, got " + i32ToStr(sargs.length),
              ix,
            )
          } else {
            const a0 = checkNode(sargs[0])
            if !assignable(a0, TY_STR) {
              tErr("indexOf expects a string, got " + tyToStr(a0), ix)
            }
          }
          return TY_I32
        }
        if sp == "includes" {
          if sargs.length != 1 {
            tErr(
              "includes expects 1 argument, got " + i32ToStr(sargs.length),
              ix,
            )
          } else {
            const a0 = checkNode(sargs[0])
            if !assignable(a0, TY_STR) {
              tErr("includes expects a string, got " + tyToStr(a0), ix)
            }
          }
          return TY_BOOL
        }
        if sp == "charCodeAt" {
          if sargs.length != 1 {
            tErr(
              "charCodeAt expects 1 argument, got " + i32ToStr(sargs.length),
              ix,
            )
          } else {
            const a0 = checkNode(sargs[0])
            if !assignable(a0, TY_I32) {
              tErr("charCodeAt expects an i32 index, got " + tyToStr(a0), ix)
            }
          }
          return TY_I32
        }
        // UFCS `self`-method on a string receiver (`"hello".first()`).
        const su = ufcsCallTy(sp, recvTy, n, ix)
        if su >= 0 { return su }
        tErr("no method '." + sp + "' on string", ix)
        return TY_ERR
      }
    }
    // UFCS `self`-method on any other receiver (struct / nullable / union):
    // `o.f(args)` lowers to `f(o, args)` when the receiver carries no such
    // FIELD (a callable field keeps precedence) and a matching free function
    // exists; otherwise fall through to the normal member-call path/error.
    let ufcsHasField = false
    const urt = T.tys[recvTy]
    if urt is TyObj {
      if objFieldType(urt, cfn.memProp) >= 0 { ufcsHasField = true }
    }
    if !ufcsHasField {
      const uu = ufcsCallTy(cfn.memProp, recvTy, n, ix)
      if uu >= 0 { return uu }
    }
  }
  // A memory intrinsic that is DECLARED in the default scope but has no emitter arm
  // (`nameIsUnimplementedIntrinsic` — the two re-censused there). Reported HERE rather
  // than left to the emitter, which answers `emitProgram: call to unknown function`: a
  // message that reads like a typo'd identifier when the identifier is real and the
  // IMPLEMENTATION is what is missing. Same channel `print` of a reference uses — an
  // emitter-capability admission, positioned in the source, not a type error.
  //
  // Gated on the program NOT declaring a function of that name. Unlike the names
  // `nameIsEmitterIntrinsic` reserves, these two are NOT emitter-intercepted — the
  // emitter has no arm for them, so `function __store_string__(a: i32, s: string) { … }`
  // genuinely SHADOWS the builtin and genuinely runs (measured). A diagnostic that fired
  // on a user's own function would delete a working escape hatch to fix a message.
  //
  // The three WIDE store widths used to be here and are not any more: they acquired
  // emitter arms, so they moved to the reservation list, and their escape hatch closed
  // with the same motion — a `function __store_f64__(…)` definition would now never run,
  // which is exactly what `checkNotEmitterIntrinsic` exists to say out loud.
  if cfn is Ident {
    if (
      nameIsUnimplementedIntrinsic(cfn.identName) &&
      (fnDeclIx[cfn.identName] ?? -1) < 0
    ) {
      tErrUnsupported(
        "'" +
          cfn.identName +
          "' is declared but has no implementation yet — it type-checks and then has nothing to lower (see `docs/internals/memory-gc-design.md` §1.2)",
        ix,
      )
    }
  }
  // `print(x)` is a compiler builtin (no module/import system yet): it accepts a
  // single value of any printable type and yields void. Special-cased so a program
  // that prints does not trip "undeclared identifier 'print'". Each argument is
  // still checked so a type error inside it surfaces.
  if cfn is Ident {
    if cfn.identName == "print" {
      const pargs = n.callArgs
      let pj = 0
      while pj < pargs.length {
        const pt = checkNode(pargs[pj])
        // `print` demands a value to render, and a `void` call has none — the emitter's
        // print ladder ends in `call __print_i32__` with nothing on the stack.
        voidValueSlotErr(pt, pargs[pj], "print", pargs[pj])
        // `print` renders ONE scalar/string rep at runtime; a BOXED value-union (`i32 |
        // string` — `≥2` distinct value atoms) has no fixed rep, so emit cannot lower
        // `print(<union>)` (it produced invalid wasm). An emitter-capability rejection,
        // not a type error — the union must be narrowed with `is` first.
        // `tyPrintsAsUnionBox` is the exact boxing gate: it stays false for a same-rep
        // literal union (`0 | 1` is plain i32, `"a" | "b"` plain string) and for `never`
        // (empty), so those still print. It reads the leaves with the same literal
        // SOFTENING the emit name gets — without it `const v: "ab" | i32 = 3; print(v)`
        // walked past this gate and emitted invalid wasm while `string | i32` (the same
        // type, already softened by the author) was rejected here.
        if tyPrintsAsUnionBox(pt) {
          tErrUnsupported(
            "print of a union value (" +
              tyToStr(pt) +
              ") is type-valid but not yet supported by codegen — narrow it first, e.g. `if v is i32 { print(v) }`",
            pargs[pj],
          )
        }
        // The SAME rule for the other reps `print` has no import for: an array, a
        // struct, a map/set, a function value, and any of those behind `| null`.
        // The emitter's print ladder ends in an unguarded `call __print_i32__`, so
        // each of these handed a `(ref $t)` to an `(i32) -> ()` import and the module
        // failed to VALIDATE — while `vl check` reported the program clean.
        if tyPrintsAsRef(pt, 24) {
          tErrUnsupported(
            "print of " +
              tyToStr(pt) +
              " is type-valid but not yet supported by codegen — `print` renders one scalar or string; print the elements/fields individually, e.g. `print(xs[0])`",
            pargs[pj],
          )
        }
        pj = pj + 1
      }
      return TY_VOID
    }
    // `Map()` / `Set()` construct an empty string-keyed map: key/value HOLES (-1)
    // assignable to any map annotation (`const m: {[string]: i32} = Map()`).
    if cfn.identName == "Map" || cfn.identName == "Set" {
      if n.callArgs.length != 0 {
        tErr(cfn.identName + " expects no arguments", ix)
      }
      if cfn.identName == "Set" {
        // A set's VALUE type is the membership boolean; the element (key) is a
        // hole pinned by the annotation or the first `.add`.
        return mkMapTy(-1, TY_BOOL, 1)
      }
      return mkMapTy(-1, -1, 0)
    }
    // `toString(x)` is a builtin: an i32 (decimal digits) or boolean ("true" /
    // "false") renders as a string.
    if cfn.identName == "toString" {
      const targs = n.callArgs
      if targs.length != 1 {
        tErr("toString expects 1 argument, got " + i32ToStr(targs.length), ix)
      } else {
        const t0 = checkNode(targs[0])
        if !assignable(t0, TY_I32) && !assignable(t0, TY_BOOL) {
          tErr("toString expects an i32 or boolean, got " + tyToStr(t0), ix)
        }
      }
      return TY_STR
    }
    // `fromCodePoints(xs)` is a builtin: an `i32[]` of code points -> a string,
    // in one bulk copy (the amortized alternative to per-char concat).
    if cfn.identName == "fromCodePoints" {
      const pargs = n.callArgs
      if pargs.length != 1 {
        tErr(
          "fromCodePoints expects 1 argument, got " + i32ToStr(pargs.length),
          ix,
        )
      } else {
        const p0 = checkNode(pargs[0])
        const p0t = T.tys[p0]
        let pOk = false
        if p0t is TyArray {
          // An empty `[]` literal's element hole (-1) pins to i32 here.
          if p0t.aElem < 0 || assignable(p0t.aElem, TY_I32) { pOk = true }
        }
        if p0t is TyErr { pOk = true }
        if !pOk {
          tErr("fromCodePoints expects an i32[], got " + tyToStr(p0), ix)
        }
      }
      return TY_STR
    }
    // `fromCodePoint(code)` is a builtin: an i32 code point -> a length-1 string.
    if cfn.identName == "fromCodePoint" {
      const fargs = n.callArgs
      if fargs.length != 1 {
        tErr(
          "fromCodePoint expects 1 argument, got " + i32ToStr(fargs.length),
          ix,
        )
      } else {
        const f0 = checkNode(fargs[0])
        if !assignable(f0, TY_I32) {
          tErr("fromCodePoint expects an i32, got " + tyToStr(f0), ix)
        }
      }
      return TY_STR
    }
    // The array-intrinsic floor (std-design D1 / collections-design §LS.2),
    // host parity: `defaultScope.ts`. `__array_new__(n, fill)` allocates `n`
    // slots each set to `fill`, typing as `T[]` with `T` = the fill's type.
    if cfn.identName == "__array_new__" {
      const anArgs = n.callArgs
      if anArgs.length != 2 {
        tErr(
          "__array_new__ expects 2 arguments, got " + i32ToStr(anArgs.length),
          ix,
        )
        return mkArrayTy(-1)
      }
      const anLen = checkNode(anArgs[0])
      if !assignable(anLen, TY_I32) {
        tErr("__array_new__ expects an i32 length, got " + tyToStr(anLen), ix)
      }
      return mkArrayTy(checkNode(anArgs[1]))
    }
    // `__array_new_default__(n)`: `n` zeroed/default slots. The element type is
    // a HOLE (-1) pinned by the annotation — the empty-`[]` mechanism (host: the
    // fresh element hole returned by `typeFromExpression`).
    if cfn.identName == "__array_new_default__" {
      const adArgs = n.callArgs
      if adArgs.length != 1 {
        tErr(
          "__array_new_default__ expects 1 argument, got " +
            i32ToStr(adArgs.length),
          ix,
        )
      } else {
        const adLen = checkNode(adArgs[0])
        if !assignable(adLen, TY_I32) {
          tErr(
            "__array_new_default__ expects an i32 length, got " + tyToStr(adLen),
            ix,
          )
        }
      }
      return mkArrayTy(-1)
    }
    // `__array_copy__(dst, dstAt, src, srcAt, count)`: bulk-move `count`
    // elements from `src[srcAt..]` into `dst[dstAt..]`; void. dst/src must be
    // arrays; the dst↔src ELEMENT correlation is deliberately NOT enforced —
    // host parity: generic param↔param correlation is lenient there too (a
    // mismatched pair fails loudly at the emit stage in both compilers).
    if cfn.identName == "__array_copy__" {
      const acArgs = n.callArgs
      if acArgs.length != 5 {
        tErr(
          "__array_copy__ expects 5 arguments, got " + i32ToStr(acArgs.length),
          ix,
        )
        return TY_VOID
      }
      let acI = 0
      while acI < 5 {
        const acT = checkNode(acArgs[acI])
        if acI == 0 || acI == 2 {
          const acTy = T.tys[acT]
          let acOk = false
          if acTy is TyArray { acOk = true }
          if acTy is TyErr { acOk = true }
          if !acOk {
            tErr("__array_copy__ expects a T[], got " + tyToStr(acT), ix)
          }
        } else {
          if !assignable(acT, TY_I32) {
            tErr("__array_copy__ expects an i32, got " + tyToStr(acT), ix)
          }
        }
        acI = acI + 1
      }
      return TY_VOID
    }
    // `__trap__()`: the deliberate abort primitive — lowered to `unreachable`.
    // `__trap__("reason")`: an OPTIONAL single string message, printed to the
    // host boundary (the print-of-string path) before the abort — so the trap
    // carries a human-readable reason. Either form still "never returns".
    if cfn.identName == "__trap__" {
      if n.callArgs.length > 1 {
        tErr("__trap__ takes an optional string message", ix)
      } else if n.callArgs.length == 1 {
        const trapMsgTy = checkNode(n.callArgs[0])
        if !assignable(trapMsgTy, TY_STR) {
          tErr(
            "__trap__ takes an optional string message, got " + tyToStr(trapMsgTy),
            ix,
          )
        }
      }
      return TY_VOID
    }
    // The NUMERIC-OPCODE intrinsics: each lowers to exactly one wasm instruction, so
    // the checker only has to type them. A user BINDING of the same name shadows the
    // intrinsic (`numIntrShadowed`), and the emitter gates on the same rule — the
    // intrinsic arm is a fallback for a name the program did not define itself.
    if !numIntrShadowed(cfn.identName) {
      const bcTy = bitcastCallTy(cfn.identName, n, ix)
      if bcTy >= 0 { return bcTy }
      const niTy = numIntrCallTy(cfn.identName, n, ix)
      if niTy >= 0 { return niTy }
    }
  }
  const fnTy = checkNode(n.callFn)
  let args = n.callArgs
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    // PENDING return (-2): the un-annotated callee hasn't been inferred yet (a
    // forward call). Demand-infer it now — check its FuncDecl, which patches this
    // very TyFunc in place — unless it is already on the in-progress stack (an
    // in-cycle call: contribute TY_ERR so the cycle can be detected at the root).
    if ft.fnRet == -2 {
      if cfn is Ident {
        if !onInferStack(cfn.identName) {
          const dIx = fnDeclIx[cfn.identName] ?? -1
          if dIx >= 0 { checkNode(dIx) }
        }
      }
    }
    let retTy = ft.fnRet
    if retTy == -2 {
      retTy = TY_ERR
      // A DIRECT self-recursive call (`fib(n-1)` inside `fib`) — the callee is the very
      // function being inferred (the inference-stack top) — resolves to that body's
      // PROVISIONAL type: the concrete base-case returns accumulated so far
      // (`inferObserved`). Without this it is `TY_ERR`, and since `assignable(TY_ERR,
      // string)` is vacuously true, a `+` over the call (`fib(n-1) + fib(n-2)`) takes the
      // string-concat form and pollutes the inferred return to `i32 | string`. The base
      // case is checked before the recursive tail, so `inferObserved` already holds it.
      // MUTUAL recursion (callee != the accumulating function) keeps `TY_ERR` and is
      // settled by the binding-group fixpoint; a recursive call seen before any base case
      // (`inferObserved < 0`) also stays `TY_ERR`.
      if cfn is Ident {
        if inferStack.length > 0 {
          if inferStack[inferStack.length - 1] == cfn.identName {
            if inferObserved >= 0 { retTy = inferObserved }
          }
        }
      }
    }
    const params = ft.fnParamTypes
    // DEFAULTS are DIRECT-call-site sugar: a call that names a DECLARED function
    // may omit trailing arguments whose parameters carry a default, so the
    // accepted arity is the range [`fnRequiredArity`, `params.length`]. A call
    // through a function VALUE has no declaration to read defaults from and
    // keeps its exact-arity gate — which is what leaves the `$fnsig` closure ABI
    // out of this feature entirely.
    const dParams = calleeDeclParams(n.callFn)
    let required = params.length
    if dParams.length == params.length { required = fnRequiredArity(dParams) }
    if args.length < required || args.length > params.length {
      tErr(
        "wrong number of arguments: expected " +
          arityWantText(required, params.length) +
          ", got " +
          i32ToStr(args.length),
        ix,
      )
      return retTy
    }
    // NAMED arguments bind to parameters by NAME, then positionally — source
    // order is irrelevant for named args (host: `ensureParameters` /
    // `orderArgumentsByParameters`). `TyFunc` carries no parameter names, so
    // the names resolve against the callee's `FuncDecl`; a closure-valued
    // callee (no declaration) cannot take named arguments.
    if hasNamedArgs(n.callArgNames) {
      let cNames: string[] = []
      if cfn is Ident { cNames = fnParamNamesOf(cfn.identName) }
      if cNames.length != params.length {
        tErr("named arguments require a declared function", ix)
        return retTy
      }
      args = orderNamedCallArgs(cNames, args, n.callArgNames, ix, dParams)
      if args.length != params.length { return retTy }
    } else if args.length < params.length {
      // Trailing positional omission: check the defaults against their
      // parameters alongside the supplied arguments, so one loop below covers
      // the whole parameter list. (`args` is rebound to a COPY — `n.callArgs`
      // stays the source list; the emit-side normalization is `emit_rewrite`'s.)
      const padded: i32[] = []
      let pj = 0
      while pj < params.length {
        if pj < args.length { padded.push(args[pj]) } else { padded.push(-1) }
        pj = pj + 1
      }
      if fillArgDefaults(padded, dParams) >= 0 { return retTy }
      args = padded
    }
    // Generic CALL-SITE inference: a TyVar param (or `T[]`) BINDS its type-param to
    // the argument's type (first use wins; later uses must agree), and the return
    // type substitutes through the binding — so `id("s")` is `string`, and
    // `let n: i32 = id("s")` is a genuine type error downstream.
    const bNames: string[] = []
    const bTys: i32[] = []
    let i = 0
    while i < args.length {
      // Contextual param inference for a function-VALUE argument: propagate the expected
      // param type into the argument so an un-annotated literal param infers from the
      // signature (the general HOF case, matching `.map`/`.filter`) — including a lambda
      // nested in a composite argument (`apply([(x) => …], …)`). SUBSTITUTE the type-param
      // bindings accumulated from EARLIER args first, so a generic HOF's callback infers its
      // param from the already-bound type param: `mapArr(xs: T[], f: (T) => R)` called
      // `mapArr([1,2,3], (x) => …)` binds `T = i32` from `xs`, then seeds `f`'s `(x)` as `i32`
      // (without this `x` stays a `TyVar` and the monomorphizer can't concretize the lambda).
      seedExpected(args[i], substTyDeep(params[i], bNames, bTys))
      const at = checkNode(args[i])
      // Bind every TyVar reachable in the expected param position from the
      // argument's shape (first use wins), then check the argument against the
      // SUBSTITUTED expected type — a later disagreeing use errors here.
      bindGenWalk(params[i], at, bNames, bTys)
      const expected = substTyDeep(params[i], bNames, bTys)
      // A HOLE argument meeting a CONCRETE param can't be judged here — a hole is
      // permissively assignable both ways, so the check below passes vacuously.
      // Record the demand; the generic call site that pins the hole re-validates
      // it under the substituted argument types (the deferred binary-op-constraint
      // pattern), so `function f(x) { g(x) }` with `g(n: i32)` rejects `f("s")`.
      //
      // A DEFERRED JOIN argument (`pick(x, "s", true)` — a union still carrying a
      // hole arm) is vacuous here for the SAME reason: `assignable` accepts it
      // because its hole arm accepts anything. It must record the demand too, or the
      // whole spelling type-checks clean and dies at wasm validation. This is the
      // net for the arms this PR stopped collapsing.
      //
      // The demand is recorded on the argument's UNCOLLAPSED type: when the argument
      // is a call whose deferred join this site could not decide, the collapse handed
      // out ONE arm (`collapseDeferredJoin` — the emitter needs a real type), and a
      // constraint keyed on that arm dies when the outer pin proves that arm
      // UNREACHABLE. `ps(mid(w))` with `mid` relaying an `is`-guard join is exactly
      // that: the guard arm was the one kept, `go({bar: 42})` cannot reach it, and the
      // constraint evaporated instead of reporting the `bar` arm's i32. The parked
      // join re-folds to the arm the pinned argument really takes.
      const atCstr = inferRetTyOf(args[i], at)
      if tyIsHole(atCstr) || tyIsDeferredJoin(atCstr) {
        if !tyIsHole(expected) {
          let ccWho = ""
          if cfn is Ident { ccWho = cfn.identName }
          noteArgCstr(atCstr, expected, ccWho)
        }
      }
      // A hole param whose body DEMANDED fields (member access on the hole)
      // checks the argument against the demanded shape, so `getx(5)` rejects
      // when the body read `o.x` (host: the grown `Infer<{x,…}>` pin).
      const pHole = T.tys[params[i]]
      if pHole is TyVar {
        if !holeDemandOk(pHole.tvName, args[i], at) {
          holeArgDemandErr(pHole.tvName, i + 1, at, ix)
        }
        // A hole the body INDEXED (`self[i]`) demands an array — a scalar argument can't be
        // indexed, so reject it here (`head(5)`) instead of deferring to an emit failure.
        if holeIsArrayDemanded(pHole.tvName) {
          if tyRefusesArrayDemand(at) { holeArgArrayErr(i + 1, at, ix) }
        }
      }
      // Passing an empty-collection argument into a concrete `T[]` / map param pins
      // its element type from the param (`len(empty)` resolves `empty` to `i32[]`),
      // clearing its uninferred floor — pure downstream-usage inference, no push.
      constrainEmpty(at, expected)
      if !assignableExpr(args[i], at, expected) {
        tErr(
          "argument " +
            i32ToStr(i + 1) +
            ": expected " +
            tyToStr(expected) +
            ", got " +
            tyToStr(at),
          ix,
        )
      }
      i = i + 1
    }
    // Substitute the binding into a generic return type — deep, so a
    // structural return (`{first: B, second: A}`, a generic alias body, a
    // function-typed field) concretizes per call site; a DERIVED `?ret.` hole
    // collapses to the pinned callee's return (see `substTyDeep`, which keeps
    // `functions/inferred-return-soundness.vl` rejecting).
    if bNames.length > 0 {
      const dBeforeC = T.diags.length
      validateBinCstrs(bNames, bTys, ix)
      validateArgCstrs(bNames, bTys, ix)
      // The escaped-join reject is the FALLBACK, not an additional voice: when this
      // same site already reported a precise operand/argument-flow diagnostic, that
      // one names the actual mismatch and the join report would only repeat it in
      // vaguer words (`hole-join-generic-arg-reject.vl` gets both otherwise).
      if T.diags.length == dBeforeC { validateEscJoins(bNames, bTys) }
      retTy = substTyDeep(retTy, bNames, bTys)
    }
    // A DEFERRED JOIN the re-fold could not decide here (the callee's arms name a
    // hole THIS site does not bind — a generic body calling a generic body) must not
    // ESCAPE as this call's type: the emitter reads node types and has no rep for a
    // placeholder union. Collapse it back to the pre-change behavior — but PARK the
    // uncollapsed join first, so a `return h(w)` relay body can carry the whole join
    // to its own call sites (`inferRetTyOf`) instead of the one arm the collapse
    // happens to keep.
    const cRetTy = collapseDeferredJoin(retTy)
    if cRetTy != retTy {
      noteDeferredJoinNode(ix, retTy)
      let ejWho = ""
      if cfn is Ident { ejWho = cfn.identName }
      noteEscJoin(retTy, ix, ejWho)
    }
    return cRetTy
  }
  if ft is TyErr { return TY_ERR }
  if ft is TyVar {
    // Calling an INFERENCE-HOLE value — an un-annotated parameter used as a
    // function inside its own (generic) body: `function apply(fn, a, b)
    // fn(a, b)`. Host parity: the hole pins to a function shape per
    // monomorphized call site, so here the arguments are checked on their own
    // and the call yields a fresh hole (resolved when an outer call binds the
    // generic signature; the emitter compiles each instance concretely).
    const hargs = n.callArgs
    let hj = 0
    while hj < hargs.length {
      checkNode(hargs[hj])
      hj = hj + 1
    }
    return mkDerivedHole(HD_RET, "", -1, -1, fnTy)
  }
  tErr("called value is not a function (" + tyToStr(fnTy) + ")", ix)
  TY_ERR
}

// Resolve a written annotation NAME in the context of generic type-parameter
// names: the type params bind to their TyVars in the type-param ENVIRONMENT
// consulted by `nameToTy`, so a bare `T`, a `T[]` suffix, a structural
// `{first: B, second: A}`, and a generic alias application `Box<T>` all
// resolve through the one name grammar with the params substituted.
// MEMOIZED for the env-free case (no typarams, no live type-param environment):
// `nameToTy` MINTS fresh arena types per call for an inline spelling, so the
// emitter's per-probe resolutions (`repNameCanonId`'s dedup keys, the compat
// probes' nested-name checks) re-minted the SAME structural types thousands of
// times — on a deep same-fieldset composite the arena grew past 300K types and a
// table allocation crossed the engine limit: a compiler CRASH ("allocation size
// too large"; fuzz seed 459979688 d6 bm). One index per spelling per program is
// also semantically TIGHTER: probes now compare against the one memoized
// structure. Only SUCCESSFUL resolutions memoize (a name unresolvable early may
// resolve once later declarations register); a live tpEnv (an enclosing generic
// body / applyGenAlias substitution) bypasses — the same spelling means
// different types under different bindings. Reset per program (`initChecker`).
let annotNameMemo: {[string]: i32} = Map()
// FAILED resolutions memoize too — under the version that failed (`cUserTypesVer`):
// a name unresolvable NOW may resolve once later declarations register, so the
// negative hit is honored only while no new declared-name resolution landed.
// (`nameToTy` mints PARTIAL types before failing, so un-memoized failures re-probed
// in a loop still grow the arena — the same runaway the positive memo closes.)
let annotNameMemoNegVer: {[string]: i32} = Map()
// …and so does the failing COMPONENT the miss banked (`unkTyPart`). The diagnostic sites
// read that bank on the line after their resolution, and a NEGATIVE memo hit returns -1
// WITHOUT re-entering the resolver — so without this the message would quote whatever
// name failed LAST anywhere in the program. It reproduced immediately: two functions,
// `a(v: nope[][])` then `b(v: bad[])`, and `a` reported `unknown type 'bad' within
// 'nope[][]'` — the checker hoists every top-level signature in pass 1 (silently, priming
// the negative memo) and reports in pass 2, so EVERY reported name is a memo hit.
// A `{[string]: string}` map — the natural spelling, and the SELF-COMPILE entombment for
// the assignment-boundary map-shape fix.
//
// It was two parallel ARRAYS because the compiler could not compile itself with the map:
// the re-initializing `annotPart = Map()` in `initChecker` `struct.new`'d the shared MONO
// (i32-valued) map struct instead of this binding's string-valued one, and the module
// failed to validate (`type mismatch: expected (ref null $type), found (ref $type)`). The
// assignment boundary was the only one of six that did not seed the map SHAPE. Filed as a
// `return m[k] ?? ""` defect — the `??` read was never involved; see
// `tests/cases/maps/map-reassign-value-shape.vl`.
//
// THIS SPELLING IS A SECOND CHANGE ON PURPOSE. The fix shipped first, alone, because the
// compiler bootstraps from the published `seed-latest` — master's compiler — and source
// that USES the construct a fix enables cannot be compiled by a seed that LACKS the fix.
// Landing both together made `refresh-compiler.sh --prove-fixpoint` die at `function[135]`
// (`initChecker`) from a freshly fetched seed. Once the fix is in the published seed, this
// line compiles, and the compiler's own source is then the strongest pin the fix can have.
let annotPart: {[string]: string} = Map()

// …and so does the UNSEPARABLE-MEMBER reason (`unkTyClash`), for the same reason and by
// the same mechanism: a negative memo hit returns -1 without re-entering the resolver, so
// a `N | i32` parameter hoisted in pass 1 and reported in pass 2 would fall back to the
// generic "unknown type" wording. The two banks are separate maps rather than one tagged
// map because they are two different bank FIELDS and the restore writes each back to its
// own.
let annotClash: {[string]: string} = Map()

// The component banked for the failing spelling `name`, or "".
function annotPartOf(name: string) { return annotPart[name] ?? "" }

// The unseparable-member reason banked for the failing spelling `name`, or "".
function annotClashOf(name: string) { return annotClash[name] ?? "" }

export function resolveAnnot(name: string, typarams: string[]) {
  resolveAnnotTs(name, typarams, -1)
}

// `resolveAnnot`, with the annotation's spelling ROOT threaded to the three
// legs that actually resolve. `root < 0` is the NAME route — what the exported
// entry point (and its 7 `emit_rep.vl` callers) get, since a post-canon emit-time
// name has no live tree.
//
// The MEMO is untouched and stays keyed on the name, deliberately: it is the one
// index per spelling per program that closed the arena runaway, and a memo HIT
// must return the same index it minted whichever route minted it. Only the MISS
// path resolves, so only the miss path reads the tree.
function resolveAnnotTs(name: string, typarams: string[], root: i32) {
  if typarams.length == 0 {
    if tpEnvNames.length == 0 {
      const hit = annotNameMemo[name] ?? -2
      if hit != -2 { return hit }
      const negVer = annotNameMemoNegVer[name] ?? -1
      if negVer == cUserTypesVer {
        // Restore the component this name banked when it actually resolved, so the
        // caller's `unknownTyText` reads THIS name's leaf and not the last one anywhere.
        unkTyPart = annotPartOf(name)
        unkTyClash = annotClashOf(name)
        return -1
      }
      const r = annotResolve(name, root)
      if r >= 0 {
        annotNameMemo[name] = r
      } else {
        annotNameMemoNegVer[name] = cUserTypesVer
        annotPart[name] = unkTyPart
        annotClash[name] = unkTyClash
      }
      return r
    }
    return annotResolve(name, root)
  }
  let i = 0
  while i < typarams.length {
    tpEnvNames.push(typarams[i])
    tpEnvTys.push(mkTyVar(typarams[i]))
    i = i + 1
  }
  const r = annotResolve(name, root)
  let j = 0
  while j < typarams.length {
    tpEnvNames.pop()
    tpEnvTys.pop()
    j = j + 1
  }
  r
}

// `resolveAnnot` with resolution diagnostics anchored at node `at` (the
// annotation's TypeRef) — see `annotDiagAt`.
function resolveAnnotAt(name: string, typarams: string[], at: i32) {
  const saved = annotDiagAt
  annotDiagAt = at
  const r = resolveAnnotTs(name, typarams, annTsOf(at))
  annotDiagAt = saved
  r
}

// Is `name` currently being inferred (on the in-progress stack)?
function onInferStack(name: string) {
  let i = 0
  while i < inferStack.length {
    if inferStack[i] == name { return true }
    i = i + 1
  }
  false
}

// Record a type a PENDING body produced (a `return e` or the trailing expression):
// the first CONCRETE type wins; an error type only notes that something err-ish
// flowed back (an in-cycle call), which distinguishes "void body" from "no basis".
function noteInferredRet(t: i32) {
  if t < 0 { return 0 }
  const tt = T.tys[t]
  if tt is TyErr {
    inferSawErr = true
    return 0
  }
  if tt is TyPrim {
    if tt.primName == "void" { return 0 }
  }
  // JOIN every non-void return, not just the first: a function whose returns
  // disagree (`return 5` … `return null`, or `return 5` … `return "hi"`) infers the
  // flattened UNION/nullable of them (`joinTys` mirrors the host's
  // `flattenType(Union(...))`), so the caller sees the true type. First-wins silently
  // dropped later branches — the checker then mis-typed a `!= null` compare or let a
  // string flow through an i32 result and crash codegen.
  // A return reached only through an `is`-guard over a HOLE param contributes a
  // GUARDED member, so the call site can tell whether its pinned argument reaches
  // this branch at all (`mkGuardedRetTy` / `substHoleTy`'s `HD_GALT` arm).
  const g = mkGuardedRetTy(t)
  if inferObserved < 0 {
    inferObserved = g
  } else {
    inferObserved = joinRetTys(inferObserved, g)
  }
  0
}

// The natural-return accumulator for the redundant-return rule (annotated funcs):
// the FIRST non-void/non-error return observed, mirroring noteInferredRet so the
// captured type IS what an unannotated version would infer.
function noteNaturalRet(t: i32) {
  if t < 0 { return 0 }
  const tt = T.tys[t]
  if tt is TyErr {
    retNaturalErr = true
    return 0
  }
  if tt is TyPrim {
    if tt.primName == "void" { return 0 }
  }
  // JOIN, mirroring noteInferredRet (above) so the captured "natural" return IS what
  // an unannotated version would infer — a multi-return function joins to a union.
  if retNatural < 0 {
    retNatural = t
  } else {
    retNatural = joinTys(retNatural, t)
  }
  0
}

function listHasStr(xs: string[], v: string) {
  let i = 0
  while i < xs.length {
    if xs[i] == v { return true }
    i = i + 1
  }
  false
}

// Is `ix` a STATEMENT node (not a value-producing expression)? A function whose
// body's last node / `return` arg is a value expression has a value return POSITION;
// one whose body ends in a bare statement (a recursive `if`/`while` with no trailing
// value) is genuinely void. The redundant-return fixpoint defers ONLY value-return
// functions poisoned by a cycle, so genuine void recursion is never mis-flagged.
function isStmtNode(ix: i32) {
  const nd = P.nodes[ix]
  if nd is LetDecl { return true }
  if nd is IfStmt { return true }
  if nd is WhileStmt { return true }
  if nd is BreakStmt { return true }
  if nd is ContinueStmt { return true }
  if nd is RetStmt { return true }
  if nd is ForRange { return true }
  if nd is ForIn { return true }
  false
}

function resetReturnPending(name: string) {
  const h = lookup(name)
  if h >= 0 {
    const ht = T.tys[h]
    if ht is TyFunc {
      ht.fnRet = -2
      tyMutEpoch = tyMutEpoch + 1 // return-inference fixpoint reset in place
    }
  }
  0
}

// Demand-infer one top-level function's return, but only if still pending (the
// memoization guard already short-circuits a resolved one; the fixpoint resets to
// pending first to force a fresh re-inference once neighbours have settled).
function preInferOne(dIx: i32) {
  const dn = P.nodes[dIx]
  if dn is FuncDecl {
    const h = lookup(dn.fnName)
    let pending = true
    if h >= 0 {
      const ht = T.tys[h]
      if ht is TyFunc {
        if ht.fnRet != -2 { pending = false }
      }
    }
    if pending { checkFuncDeclNode(dn, dIx) }
  }
  0
}

// The return-inference PRE-PASS: resolve every un-annotated return with diagnostics,
// symbol recording and the redundant-type stream SUPPRESSED, so the real check pass
// runs against final return types. Non-cycle functions resolve in the first demand
// sweep (dependency order); cycle-poisoned ones iterate to a fixpoint — each round
// resets the still-tentative set to pending and re-infers, until the set stops
// shrinking. What remains is genuinely base-case-less (recorded for the real pass).
function inferReturnsPrePass() {
  if topUnannotFns.length == 0 { return 0 }
  inferQuiet = true
  const savedDiag = T.diags.length
  const savedSym = symEnabled
  const savedRedun = redunName.length
  symEnabled = 0
  let i = 0
  while i < topUnannotFns.length {
    preInferOne(topUnannotFns[i])
    i = i + 1
  }
  let shrinking = true
  let rounds = 0
  while shrinking && rounds < 2000 {
    rounds = rounds + 1
    const work = inferTentative
    inferTentative = []
    let r = 0
    while r < work.length {
      resetReturnPending(work[r])
      r = r + 1
    }
    let q = 0
    while q < work.length {
      const dIx = fnDeclIx[work[q]] ?? -1
      if dIx >= 0 { preInferOne(dIx) }
      q = q + 1
    }
    if inferTentative.length >= work.length { shrinking = false }
  }
  unresolvedFns = []
  let u = 0
  while u < inferTentative.length {
    unresolvedFns.push(inferTentative[u])
    u = u + 1
  }
  symEnabled = savedSym
  while T.diags.length > savedDiag { T.diags.pop() }
  redunTruncate(savedRedun)
  inferQuiet = false
  0
}

function redunTruncate(n: i32) {
  while redunSLine.length > n { redunSLine.pop() }
  while redunSCol.length > n { redunSCol.pop() }
  while redunELine.length > n { redunELine.pop() }
  while redunECol.length > n { redunECol.pop() }
  while redunName.length > n { redunName.pop() }
  while redunType.length > n { redunType.pop() }
  while redunTok.length > n { redunTok.pop() }
  0
}

// The UNCOVERED union members of the last non-exhaustive `is`-chain
// `ifChainExhausts` analyzed (rendered, comma-joined), so the diagnostic can
// NAME what is missing — the `match` exhaustiveness error's sibling. "" when
// the chain was exhaustive, or when it was non-exhaustive for a reason other
// than member coverage (a non-coverable arm shape, an uncovered `null` path):
// there is no member list to name, so the caller keeps its generic wording.
let chainMissing = ""

// SOUNDNESS — exhaustiveness of an else-less `is`-chain. Does the flat
// `if p is A {…} else if p is B {…}` chain rooted at `ifIx` (no final `else`)
// COVER every variant of `p`'s union type? If so its fall-through is unreachable
// and the chain needs no `else`; if not, a value falls off the end (the host
// types that as `| null`). Mirrors the host's `conditionsExhaust`, but over the
// discriminated place's declared union MEMBERS (VL has no union-subtraction /
// `Never` machinery): collect the per-arm tested types, require every arm to test
// the SAME single place, then check each union member is covered by some arm.
// Conservative — any arm that isn't a bare `place is T` (a compound `&&`/`||`, a
// different place, a null test) makes the chain non-exhaustive (returns false),
// never wrongly exhaustive.
function ifChainExhausts(ifIx: i32) {
  chainMissing = ""
  let havePlace = false
  let placeName = "?"
  const testedTys: i32[] = []
  // `allIsArms` stays true only while every arm seen is a bare `<sameIdent> is T`
  // (the only shape we can prove exhaustive by union-member coverage).
  let allIsArms = true
  let node = P.nodes[ifIx]
  let walking = true
  while walking {
    if node is IfStmt {
      // Classify this arm's condition. Only a single `<ident> is T` (not null)
      // contributes to coverage; anything else makes the chain non-coverable.
      // A parenthesized arm (`else if (p is B)`) classifies like the bare one.
      const condIx = condUnderParens(node.ifCond)
      const cond = P.nodes[condIx]
      if cond is IsExpr {
        if cond.isVariant == "null" {
          allIsArms = false
        } else {
          const obj = P.nodes[cond.isObj]
          if obj is Ident {
            if !havePlace {
              placeName = obj.identName
              havePlace = true
            } else if placeName != obj.identName {
              allIsArms = false
            }
            const tIx = isTypeTyRead(cond.isVariant, condIx)
            if tIx < 0 { allIsArms = false } else { testedTys.push(tIx) }
          } else {
            allIsArms = false
          }
        }
      } else if cond is BinExpr {
        // A literal-equality arm `place == <lit>` discriminates a literal
        // union the same way an `is` arm does (host: literal narrowing via
        // `atomFact` + `subtractType`) — contribute the tested literal type.
        let armLit = -1
        let armObj = -1
        if cond.binOp == "==" {
          armLit = litTyOfExpr(cond.binRight)
          armObj = cond.binLeft
          if armLit < 0 {
            armLit = litTyOfExpr(cond.binLeft)
            armObj = cond.binRight
          }
        }
        if armLit >= 0 {
          const eobj = P.nodes[armObj]
          if eobj is Ident {
            if !havePlace {
              placeName = eobj.identName
              havePlace = true
            } else if placeName != eobj.identName {
              allIsArms = false
            }
            testedTys.push(armLit)
          } else {
            allIsArms = false
          }
        } else {
          allIsArms = false
        }
      } else {
        allIsArms = false
      }
      if node.ifElse < 0 {
        // No `else`: the chain ends here — decide by coverage below.
        walking = false
      } else {
        const nxt = P.nodes[node.ifElse]
        if nxt is IfStmt {
          node = nxt
        } else {
          // A real (block) `else` covers the fall-through outright — exhaustive
          // regardless of the arm shapes.
          return true
        }
      }
    } else {
      return false
    }
  }
  // No `else`. Only a pure `is`-chain over one place can be exhaustive by member
  // coverage; any other shape genuinely falls through.
  if !allIsArms { return false }
  // No place was discriminated (shouldn't happen) — not exhaustive.
  if !havePlace { return false }
  // Look up the place's union members; cover each against the tested set.
  const pty = lookup(placeName)
  if pty < 0 { return false }
  const pt = T.tys[pty]
  if pt is TyNullable {
    // A nullable place needs an explicit `is null` (or `else`) arm to be covered;
    // an else-less `is`-chain over the inner variants always leaves the null path.
    return false
  }
  if pt is TyUnion {
    // Cover each union member against the tested set; collect the uncovered
    // ones (rendered) so the diagnostic can name exactly what is missing.
    const members = pt.uMembers
    let mi = 0
    let allCovered = true
    while mi < members.length {
      let covered = false
      let ti = 0
      while ti < testedTys.length {
        if assignable(members[mi], testedTys[ti]) { covered = true }
        ti = ti + 1
      }
      if !covered {
        allCovered = false
        if chainMissing != "" { chainMissing = chainMissing + ", " }
        chainMissing = chainMissing + tyToStr(members[mi])
      }
      mi = mi + 1
    }
    return allCovered
  }
  // A non-union place: an `is`-chain over it is degenerate; treat as covered
  // (a single concrete type is "exhausted" by any always-true branch).
  true
}

// A function declaration: resolve param/return annotations (narrowing the Param/
// TypeRef children), bind the signature, and check the body in a fresh scope.
// An UN-ANNOTATED return type is INFERRED from the body — its `return`s and
// trailing expression accumulate via `noteInferredRet` (under the `-2` pending
// `curRet`), and the result is PATCHED into the hoisted TyFunc in place, so every
// caller (incl. ones that demand-inferred this function early) sees it. A
// base-case-less cycle (`ping(){return pong()}` / `pong(){return ping()}`) has
// nothing concrete to latch onto and reports "cannot infer a return type".
function checkFuncDeclNode(n: FuncDecl, fnIx: i32) {
  // A `function` (top-level OR nested) whose name the emitter dispatches on inline is a
  // definition that can never run — reject it at the definition, not at the call site
  // that silently means something else. Anchored on the decl node, so the pass-1 hoist
  // and this pass report the SAME (message, anchor) pair and `tErrCoded` dedups them.
  checkNotEmitterIntrinsic(n.fnName, fnIx)
  // Bind the name to THIS declaration node in the ENCLOSING scope (the body's
  // own scope is pushed further down), so a call inside that scope can recover
  // the parameter list — and its DEFAULTS. A top-level function is already
  // recorded by the pass-1 hoist under the same name; a NESTED one has no hoist
  // and is recorded here, which is also the point it becomes callable.
  if n.fnName != "" { declareFnDeclNode(n.fnName, fnIx) }
  const inferring = n.fnRet < 0
  // The infer-stack KEY: a named function uses its name (so self-recursion is detected); an
  // ANONYMOUS lambda has no name, so key it by NODE INDEX — else two nested anonymous lambdas
  // (`(a) => (b) => …`) both key on "" and the inner falsely trips the recursive-cycle guard
  // below, breaking with a provisional `void` (its return then mis-infers `void`, so a curried
  // lambda `f(4)` reads as a void result).
  let inferKey = n.fnName
  if inferKey == "" { inferKey = "#L" + i32ToStr(fnIx) }
  // Already inferred on demand (a forward call checked this body before pass 2
  // reached it)? Skip the re-check so diagnostics aren't duplicated.
  if inferring {
    // Recursive cycle: this function is already on the inference stack. Break with a
    // provisional `void` (the binding-group fixpoint re-infers it once the cycle's
    // resolvable members settle), and COUNT the break so the completion below knows
    // the result is tentative rather than final.
    if onInferStack(inferKey) {
      cycleBreakCount = cycleBreakCount + 1
      return TY_VOID
    }
    if inferQuiet && !paramSolveProbe {
      // Suppressed pre-pass: memoize a resolved return (a `-2` reset by the fixpoint
      // forces a fresh re-inference). The PARAMETER-solve probe never takes the memo:
      // it needs the body walked for the flow constraints, not the return.
      const hoisted = lookup(n.fnName)
      if hoisted >= 0 {
        if (fnDeclIx[n.fnName] ?? -1) >= 0 {
          const ht = T.tys[hoisted]
          if ht is TyFunc {
            if ht.fnRet != -2 { return TY_VOID }
          }
        }
      }
    } else {
      // Real check pass: returns are already resolved by the pre-pass, so skip ONLY a
      // TOP-LEVEL body already diagnostic-checked (a forward call reached it before
      // pass 2 did). Gated on `fnIx` matching the registered top-level decl, so a
      // NESTED function sharing a name (e.g. two `add` closures) is never skipped.
      if (fnDeclIx[n.fnName] ?? -1) == fnIx {
        if bodyChecked[n.fnName] ?? false { return TY_VOID }
      }
    }
  }
  // Solve this declaration's un-annotated parameters from its body usage. A no-op for a
  // TOP-LEVEL function (pass 1.6 already did it, order-independently) and inside a probe;
  // this reach is the NESTED `function` and the value-bound lambda, neither of which is
  // hoisted, so their first observer IS this call. A parameter the receiver already pinned
  // contextually is not a hole when the probe runs, so it records no flow and the
  // `cbExpect` branch below still wins — one answer, not two.
  solveUnannotParams(fnIx)
  const params = n.fnParams
  // The contextual expected param types recorded for THIS lambda node (`seedExpected` at a
  // call arg, a `.map`/`.filter` receiver, or an annotated let/return/field/element). Keyed by
  // node index, so a composite's many lambdas each read their own — no single-shot leak.
  const cbExpect = cbExpectedFor(fnIx)
  const cbExpectUsable = cbExpect.length == params.length
  const paramTys: i32[] = []
  let paramUninferable = false
  let pi = 0
  while pi < params.length {
    const pNode = P.nodes[params[pi]]
    let pt = TY_ERR
    if pNode is Param {
      if pNode.parType >= 0 {
        const ptn = P.nodes[pNode.parType]
        if ptn is TypeRef {
          pt = resolveAnnotAt(ptn.tyName, n.fnTyParams, pNode.parType)
          if pt < 0 {
            tErr(unknownTyText(ptn.tyName), pNode.parType)
            pt = TY_ERR
          }
          // Record the resolved type on the param's TYPE-ANNOTATION node too (not just the
          // param node), so the emitter can classify a param annotation STRUCTURALLY from the
          // `Ty` arena instead of re-parsing its synthetic name (`tyNameOf`) — C1.
          if !inferQuiet && pt >= 0 {
            if pNode.parType < nodeTyIx.length { nodeTyIx[pNode.parType] = pt }
          }
        }
      } else if cbExpectUsable && cbExpect[pi] >= 0 {
        // Contextual inference: the expected callback type pins this un-annotated
        // param (e.g. `xs.map(function(n) …)` over `i32[]` ⇒ `n: i32`), matching
        // the host's receiver-driven inference.
        pt = cbExpect[pi]
      } else if n.fnName != "" {
        // HOST PARITY (`Infer<Unknown>` param holes): a NAMED function's
        // un-annotated parameter is a fresh inference HOLE — a synthetic TyVar
        // (one per param, named by declaration + position so the hoisted
        // signature and the body bind the same hole). Each CALL SITE pins it
        // independently through the existing generic TyVar binding (the
        // per-call `bNames`/`bTys`), mirroring the host's per-callsite
        // `instantiateFunctionType`; the emitter then monomorphizes one wasm
        // instance per distinct shape. Inside the body the hole is opaque
        // (assignable both ways), exactly like an explicit `<T>` param — UNLESS the
        // body's own usage pinned it, which `unannotParamTy` is the one place to say.
        pt = unannotParamTy(paramHoleName(n.fnName, fnIx, pi))
      } else if isValBindLambda(fnIx) {
        // A lambda bound to an UN-annotated `const`/`let` (`const add = (a, b) => a + b`): its
        // un-annotated param is a fresh inference HOLE, exactly like a named function's — the
        // emitter value-flow-monomorphizes one instance per call shape (env and all). Keyed by NODE
        // index (the lambda is anonymous), the dual of the named branch above.
        pt = unannotParamTy(paramHoleName("", fnIx, pi))
      } else {
        // An ANONYMOUS literal with no annotation and no contextual type is genuinely uninferable —
        // its value-typed binding demands a concrete signature NOW (host parity).
        tErr(
          "cannot infer a type for parameter `" + pNode.parName + "`",
          params[pi],
        )
        // The body can't be typed once a param is unknown — don't also cascade a "cannot infer a
        // return type" from the resulting error-only return.
        paramUninferable = true
      }
    }
    // TYPED-IR: record the param node's resolved type so the emitter can recover a
    // contextually-inferred callback param's type (`xs.map((x) => …)` over `f64[]` ⇒ x: f64)
    // and synthesize its annotation, instead of defaulting an un-annotated param to i32.
    // Gated on the real pass (`!inferQuiet`); a generic hole stays a `TyVar` and is excluded
    // by the emitter's reader (`nodeTyName`).
    if !inferQuiet && pt >= 0 {
      if params[pi] < nodeTyIx.length { nodeTyIx[params[pi]] = pt }
    }
    paramTys.push(pt)
    pi = pi + 1
  }
  // Parameter DEFAULTS (`a: i32 = 0`, and the `a?: T` spelling the parser
  // desugars into one), checked once the annotations have resolved.
  checkParamDefaults(n, params, paramTys)
  // Resolve the return-type annotation (or the pending sentinel when inferring).
  let ret = -2
  if !inferring {
    ret = TY_VOID
    const rtn = P.nodes[n.fnRet]
    if rtn is TypeRef {
      ret = resolveAnnotAt(rtn.tyName, n.fnTyParams, n.fnRet)
      if ret < 0 {
        tErr(unknownTyText(rtn.tyName), n.fnRet)
        ret = TY_ERR
      }
      // Record the resolved return type on the RETURN-ANNOTATION node so the emitter can
      // classify it structurally from the `Ty` arena rather than re-parsing `tyNameOf` — C1.
      if !inferQuiet && ret >= 0 {
        if n.fnRet < nodeTyIx.length { nodeTyIx[n.fnRet] = ret }
      }
    }
    // `f` is hoisted in the outer scope (checkProgram pre-pass), but re-declaring
    // it here covers nested function decls and is an idempotent rebind otherwise.
    // (An anonymous function EXPRESSION has no name to bind.)
    if n.fnName != "" { declare(n.fnName, mkFuncTy(paramTys, ret)) }
  }
  // Save the inference accumulators (a demand-inference can nest inside another
  // function's body check) and the enclosing return type.
  const savedObserved = inferObserved
  const savedSawErr = inferSawErr
  const cbBefore = cycleBreakCount
  const savedValueRet = fnSawValueRet
  const savedRetNatural = retNatural
  const savedRetNaturalErr = retNaturalErr
  retNatural = -1
  retNaturalErr = false
  if inferring {
    inferStack.push(inferKey)
    inferObserved = -1
    inferSawErr = false
    fnSawValueRet = false
  }
  // A FUNCTION BODY CHECKED HERE CAN CAPTURE whatever narrowings are live around it, and
  // it runs LATER — so a narrowing installed BEFORE this point and retired AFTER it would
  // be retired behind the capture's back. `narFnEpoch` is how the write side tells the two
  // apart; see `writeStorageTy`.
  narFnEpoch = narFnEpoch + 1
  // Check the body in a fresh scope sharing the parameters.
  pushScope(n.fnBody)
  // Keep the function's TYPE PARAMETERS in scope for the WHOLE body, so a body
  // annotation that names one — a local `const out: T[]`, `const x: T` — resolves it
  // (to an opaque `TyVar`, like the param signatures) instead of failing "unknown type
  // 'T'". `resolveAnnot` only scopes typarams around a single param/return annotation.
  // The emitter substitutes the concrete type per monomorphized instance (`monoCloneBody`
  // rewrites the body's annotations), so the annotation lowers correctly.
  let tpBody = 0
  while tpBody < n.fnTyParams.length {
    tpEnvNames.push(n.fnTyParams[tpBody])
    tpEnvTys.push(mkTyVar(n.fnTyParams[tpBody]))
    tpBody = tpBody + 1
  }
  // Definite-assignment: a function body is its OWN flow context — it runs at
  // call time, not at the declaration site, so a NESTED function that captures an
  // outer still-unassigned `let x` must not be flagged (the call may happen after
  // `x` is written). Save and clear the live unassigned set for the body, then
  // restore the enclosing path.
  const daSavedUnassigned = daSnapshot()
  daClear()
  const savedRet = T.curRet
  T.curRet = ret
  // LSP: the function name binds in the OUTER scope (decl-scope chain), but its
  // body — params + statements — is checked under this pushed scope. Record the
  // name occurrence against the enclosing decl scope before descending.
  if symEnabled != 0 {
    if n.fnName != "" && fnIx >= 0 {
      symDeclInOuter(n.fnName, fnIx, mkFuncTy(paramTys, ret), 2)
    }
  }
  let dj = 0
  while dj < params.length {
    const pNode2 = P.nodes[params[dj]]
    if pNode2 is Param {
      declare(pNode2.parName, paramTys[dj])
      if symEnabled != 0 {
        symDecl(pNode2.parName, params[dj], paramTys[dj], 1)
      }
    }
    dj = dj + 1
  }
  const body = P.nodes[n.fnBody]
  if body is Block {
    const stmts = body.blkStmts
    let s = 0
    while s < stmts.length {
      // The LAST statement's value is this function's implicit return. Under inference,
      // mark it as the return-tail position so a tail `if`/`else`'s base-case branch
      // seeds `inferObserved` before a recursive sibling branch is checked.
      const savedRTPbody = retTailPos
      if s == stmts.length - 1 && inferring {
        retTailPos = true
      } else {
        retTailPos = false
      }
      // THE IMPLICIT RETURN IS SEEDED WITH THE DECLARED TYPE, exactly as the explicit
      // one is (`checkRetStmtNode`: `if want >= 0 { seedExpected(n.retArg, want) }`).
      // Without it the trailing expression is checked with no expectation, so a narrower
      // literal types at its DEFAULT — which is why the bare-expression coercion had to be
      // done later, in the emitter, and why nothing compared the tail to the annotation.
      // A tail that is UNREACHABLE is not the implicit return. `function early(): i32 {
      // return 1 print(9) }` is two statements on one line — the `return` supplies the
      // value and `print(9)` is dead code — so neither seeding nor checking may treat it
      // as the returned expression. `functions/return-then-statement-same-line.vl` pins
      // exactly this and records that it "previously surfaced a spurious `expected i32,
      // got null`"; re-introducing that is what a tail-position test without a divergence
      // guard does.
      let tailIsReturn = s == stmts.length - 1
      if tailIsReturn && s > 0 {
        if daBranchDiverges(stmts[s - 1]) { tailIsReturn = false }
      }
      if tailIsReturn && !inferring && ret >= 0 && !isStmtNode(stmts[s]) {
        seedExpected(stmts[s], ret)
      }
      const stTy = checkNode(stmts[s])
      retTailPos = savedRTPbody
      // The trailing expression is the implicit return; under inference it is a
      // return-type witness. With a CONCRETE annotated return, a trailing empty
      // collection (`mk(): i32[] { … inner }`) pins its element from the return
      // type here — before the body scope is popped (and `inner`'s floor checked).
      if s == stmts.length - 1 {
        // …and then CHECKED against it — through `assignableExpr`, NOT `assignable`. The
        // coercions the language grants a value meeting a declared type live there
        // (`boolean-to-i32.vl`: "the coercion sits at `assignableExpr`, which every field /
        // element / store / push also flows through"), and the bare-expression return is
        // one more such position. Checking with plain `assignable` reddens 13 corpus files
        // that are pinning legitimate coercions — a narrower numeric literal widening to
        // the declared `i64`/`f32`, a boolean meeting an `i32`, a litunion adoption.
        //
        // An explicit `return <expr>` has been checked all along; the bare trailing
        // expression — which IS the implicit return — was not, so
        // `function h(): i32 { "s" }` type-checked clean and emitted invalid wasm, and
        // `function h(): boolean { 5 }` ran and printed `true` (the coercion is
        // ONE-directional: boolean meets i32, an arbitrary i32 is not a boolean).
        if !inferring && tailIsReturn {
          if ret >= 0 {
            if !isStmtNode(stmts[s]) {
              if !isVoidTy(ret) {
                if !assignableExpr(stmts[s], stTy, ret) {
                  tErr(
                    "expected " + tyToStr(ret) + ", got " + tyToStr(stTy),
                    stmts[s],
                  )
                }
              }
            }
          }
        }
        if inferring {
          // A value-producing trailing expression is a value return POSITION (vs a
          // bare trailing statement); the redundant-return fixpoint defers only these.
          if !isStmtNode(stmts[s]) { fnSawValueRet = true }
          noteInferredRet(inferRetTyOf(stmts[s], stTy))
        } else {
          // Redundant-return rule: witness the trailing expression's NATURAL type
          // (before constrainEmpty pins a hole); an annotation-influenced trailing
          // (empty `[]`/`Map()`, `null`) disqualifies the function.
          if retInfluencedByAnnot(stmts[s]) { retNaturalErr = true }
          noteNaturalRet(stTy)
          constrainEmpty(stTy, ret)
          // SOUNDNESS — missing-return / non-exhaustive fall-through. When the
          // body's LAST statement is an else-less `is`-chain that does NOT cover
          // every variant of its discriminated union, a value falls off the end
          // (the host types this as `branches | null`). For a non-void declared
          // return that is a soundness hole: "you forgot a case". An `if` WITH a
          // final `else`, or an EXHAUSTIVE chain, is unreachable past its end and
          // is fine; any other trailing statement is a normal value/return and is
          // left to the per-`return` and trailing-expression checks above. Skip
          // when the return type is itself nullable (a `| null` fall-through is
          // assignable) or the error type (don't cascade).
          const lastN = P.nodes[stmts[s]]
          if lastN is IfStmt {
            // Only a DISCRIMINATING chain is subject to this exhaustiveness
            // rule — a trailing `if` over `is` arms, or a literal-equality
            // chain (`n == 0` / `else if n == 1 …`) over a LITERAL-UNION place
            // (host: the un-covered member leaves a `| null` fall-through,
            // `exhaustive-missing-literal-case`). Plain `if cond {…}` shapes
            // over non-literal places keep the existing per-branch checks.
            const firstCond = P.nodes[condUnderParens(lastN.ifCond)]
            let isChain = false
            if firstCond is IsExpr {
              isChain = true
            } else if firstCond is BinExpr {
              if firstCond.binOp == "==" {
                let eqPlace = -1
                if litTyOfExpr(firstCond.binRight) >= 0 {
                  eqPlace = firstCond.binLeft
                } else if litTyOfExpr(firstCond.binLeft) >= 0 {
                  eqPlace = firstCond.binRight
                }
                if eqPlace >= 0 {
                  const eqObj = P.nodes[eqPlace]
                  if eqObj is Ident {
                    if isLitBearing(lookup(eqObj.identName)) { isChain = true }
                  }
                }
              }
            }
            const retT = T.tys[ret]
            let retNullable = false
            if retT is TyNullable { retNullable = true }
            if isChain && !isVoidTy(ret) && ret != TY_ERR && !retNullable {
              if !ifChainExhausts(stmts[s]) {
                // Name the uncovered variants when member coverage computed
                // them (the `match` sibling's courtesy); a chain that is
                // non-exhaustive for a SHAPE reason (a non-coverable arm, an
                // uncovered `null` path) has no member list, so stay generic.
                let chainFix = "add the missing variant(s) or an `else` (expected " +
                  tyToStr(ret) +
                  ")"
                if chainMissing != "" {
                  chainFix = "missing " +
                    chainMissing +
                    " (add the arm(s) or an `else`; expected " +
                    tyToStr(ret) +
                    ")"
                }
                tErr(
                  "non-exhaustive `is`-chain falls through with no `else` — " +
                    chainFix,
                  stmts[s],
                )
              }
            }
          }
        }
      }
      s = s + 1
    }
  }
  // HOVER over an un-annotated param: the body has now recorded everything it demands
  // of each param HOLE, so re-retain the binding's type as that demand — the same
  // disjunction the call-arg diagnostic names (`{foo: string} | {bar: _}`) instead
  // of the bare hole, which renders as an uninformative `_`. One source of truth for
  // the message and the LSP. Holes the body never constrained keep the `TyVar` (still
  // `_`, and still skipped by the inlay-hint scan's `inlayHole`).
  if symEnabled != 0 && !inferQuiet {
    let hp = 0
    while hp < params.length {
      const hpNode = P.nodes[params[hp]]
      if hpNode is Param && paramTys[hp] >= 0 {
        const hpTy = T.tys[paramTys[hp]]
        if hpTy is TyVar {
          const hpDemand = holeDemandTy(hpTy.tvName)
          if hpDemand >= 0 { symRetainType(params[hp], hpDemand, 1) }
        }
      }
      hp = hp + 1
    }
  }
  // Capture body TOTALITY (missing-return soundness) while the body scope is still LIVE
  // — `ifCondIsDiscriminating` looks up a discriminated param/local's type, which the
  // `popScope` below would drop. The flag is consumed after `ret` is finalized.
  const bodyTotalForRet = nodeIsTotal(n.fnBody)
  T.curRet = savedRet
  daRestore(daSavedUnassigned)
  let tpPop = 0
  while tpPop < n.fnTyParams.length {
    tpEnvNames.pop()
    tpEnvTys.pop()
    tpPop = tpPop + 1
  }
  popScope()
  if !inferQuiet {
    // Mark only the registered TOP-LEVEL decl (not a nested/shadowing namesake).
    if n.fnName != "" && (fnDeclIx[n.fnName] ?? -1) == fnIx {
      bodyChecked[n.fnName] = true
    }
  }
  if inferring {
    inferStack.pop()
    let inferred = TY_VOID
    // Set when the OBJECT-shaped contextual adoption fires (`objRetWidenAdopt` below):
    // gates the plain-struct CANON record — a lambda whose self-inference already
    // matches its context keeps the established un-pinned route (pinning EVERY
    // plain-struct lambda regressed `.map`-collapse / factory / generic-HOF cases).
    let objRetAdopted = false
    const sawCycle = cycleBreakCount > cbBefore
    if inferObserved >= 0 {
      inferred = inferObserved
    } else if sawCycle && fnSawValueRet {
      // A value return position resolved to `void` ONLY because a recursive-cycle
      // member was still pending. Defer: the binding-group fixpoint re-infers this
      // once the cycle's resolvable members settle (a genuinely base-case-less cycle
      // stays tentative and is reported by the real pass). Genuine void recursion has
      // no value return position (`fnSawValueRet` is false), so it is never deferred.
      if !listHasStr(inferTentative, n.fnName) { inferTentative.push(n.fnName) }
      inferred = TY_VOID
    } else if inferSawErr {
      // Only err-ish types flowed back: no basis. A param that was itself uninferable
      // already reported the root cause, so suppress the redundant message.
      if !paramUninferable {
        tErr(
          "cannot infer a return type for '" +
            n.fnName +
            "' — annotate a return type",
          n.fnBody,
        )
      }
      inferred = TY_ERR
    }
    // CONTEXTUAL RETURN ADOPTION: an anonymous lambda whose body infers a NARROWER numeric
    // than the contextual expected return (`const v: () => i64 = () => (5)`, an arg to a
    // `p: () => i64` param, a `{f: () => i64}` field) takes the EXPECTED return as its own,
    // so the widening lands at the lambda's return seam — where codegen inserts the convert
    // (`emitReturnValue`) — and its emitted functype result matches every call site. Numeric
    // widening through function-type VARIANCE is rejected instead (`fnSlotAssignable`): a
    // function VALUE's rep is fixed, so the body is the only place the value can widen.
    if n.fnName == "" && inferred >= 0 {
      const expRet = cbExpectedRetFor(fnIx)
      if expRet >= 0 {
        if numWidens(inferred, expRet) { inferred = expRet }
        // LITERAL → f32 dual of the numeric widen: a literal-bodied lambda whose contextual
        // return is f32 (`(i32) => f32 = (x) => 5.5`) infers f64 (a float literal's default)
        // or i32 (an integer literal's), but the literal re-encodes EXACTLY at f32 — the same
        // grant `isF32AdoptingLitExpr`/`assignableExpr` make at a direct `const v: f32 = 5.5`
        // binding. Adopt f32 so the lambda's functype result is f32 and `emitReturnValue`
        // encodes the literal at f32 in the body (the named-function-value spelling `= mk`
        // already lowers).
        if inferred != expRet && primNameOf(expRet) == "f32" {
          if isF32AdoptingLitExpr(lambdaBodyTail(n.fnBody)) {
            inferred = expRet
          }
        }
        // Object-shaped dual: `() => ({f: 5})` against `() => {f: i64}` — adopt the
        // expected shape when every widening field is a re-encodable literal
        // (`objRetWidenAdopt` also records the field types for the emitter's interner).
        if objRetWidenAdopt(n.fnBody, inferred, expRet) {
          inferred = expRet
          objRetAdopted = true
        }
        // LITERAL-UNION dual: a bare string-literal body that is a MEMBER of the expected
        // literal-union (`(i32) => K = (x) => "b"`) adopts the litunion. Its inferred type is
        // the softened `string`; the direct `const k: K = "b"` binding grants the member flow
        // via `assignableExpr`/`litTyOfExpr`, but the lambda-return path only had the
        // numeric/object arms. Adopting makes the lambda's functype result the litunion (an i32
        // atom), and the member literal encodes as its atom id at the return seam.
        if inferred != expRet && tyIsLitUnion(expRet) {
          const luTail = lambdaBodyTail(n.fnBody)
          if luTail >= 0 && assignableExpr(luTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // NULLABLE-STRING result: a lambda whose body infers a bare `string` member of an expected
        // `string | null` closure result (`(i32) => string | null = (x) => "hey"`) adopts the
        // nullable — its functype result is the string-ref `ref.null` NICHE (position-independent),
        // and `emitReturnValue` niches the value, exactly as the named-function VALUE (`= mk`) lowers.
        // Recorded by the `nullableRetName` arm below + pinned by `synthRetAnnots`. This arm
        // covers the string/boolean NICHES only: a nullable numeric SCALAR (`i32 | null`,
        // `f32 | null`) is the value-union BOX and adopts through the `valueUnionRetName` arm
        // below (its `$fnsig` keys `>u` on both producers — `annRetKind`'s nullable-scalar arm).
        // `TyNullable`-inner-`string` is checked directly (`valueUnionRetName` also claims
        // `T | null`, so the niche must be recognized before it).
        if inferred != expRet {
          const etU = T.tys[expRet]
          if etU is TyNullable {
            // The BOOLEAN-niche dual of the string niche: a lambda whose body infers a bare
            // `boolean` / `null` member of an expected `boolean | null` (`() => boolean | null =
            // () => null`) adopts the niche — its functype result is the i32 sentinel (2 = null),
            // exactly as the annotated `: boolean | null` return and the named-function VALUE lower.
            // Recorded by `nullableRetName` + pinned by `synthRetAnnots` (`nullablePartOf` non-empty).
            if (
              tyIsPrimNamed(etU.nInner, "string") ||
              tyIsPrimNamed(etU.nInner, "boolean")
            ) {
              const nsTail = lambdaBodyTail(n.fnBody)
              if nsTail >= 0 && assignableExpr(nsTail, inferred, expRet) {
                inferred = expRet
              }
            }
            // The NULLABLE-LIST dual (`() => boolean[] | null = () => ([false])`): a lambda
            // whose body infers the bare i32-backed LIST member of an expected `T[] | null`
            // adopts the niche — its functype result is the nullable i32-list wrapper
            // (`(ref null $lTypeIdx)`, the `>o` result token), exactly as the annotated
            // `: boolean[] | null` named-function return lowers. Recorded by
            // `nullableRetName`'s i32-backed-list arm + pinned by `synthRetAnnots`.
            // The distinct-backing leaves (`i64[] | null`, …) are NOT adopted (outside
            // the value-call ABI — they stay loud checker rejects).
            if inferred != expRet && tyIsNulI32BackedListInner(etU.nInner) {
              const nlTail = lambdaBodyTail(n.fnBody)
              if nlTail >= 0 && assignableExpr(nlTail, inferred, expRet) {
                inferred = expRet
              }
            }
            // The NULLABLE-CLOSURE dual (`(i32) => ((i32) => K0) | null = (q0) => (null)`): a
            // lambda whose body infers `null` (or a closure) against an expected nullable-closure
            // result adopts the niche — its functype result is `(ref null $cloStruct)`, and
            // `emitReturnValue`'s `retNulClosure` arm niches a `return null` as `ref.null
            // $cloStruct`. Recorded by `nullableRetName`'s `TyFunc`-inner arm + pinned by
            // `synthRetAnnots`. Position-independent, exactly as the annotated `: ((i32)=>K0)|null`
            // return already lowers (the pin only removes the annotation).
            const etInnerTy = T.tys[etU.nInner]
            if etInnerTy is TyFunc {
              const ncTail = lambdaBodyTail(n.fnBody)
              if ncTail >= 0 && assignableExpr(ncTail, inferred, expRet) {
                inferred = expRet
              }
            }
            // The NULLABLE-STRUCT dual (`() => {a, f, z} | null = () => ({…})`, also
            // `(i32) => {f: i64} | null = (q) => ({f: 7})`): a lambda whose body infers the
            // bare struct member (or `null`) of an expected `S | null` closure result adopts
            // the nullable — its functype result is the `(ref null $S)` niche (`>n`,
            // byte-matching the value call's `annRetKind`), exactly as the annotated
            // named-function VALUE spelling already lowers. Recorded by `nullableRetName`'s
            // TyObj arm + pinned by `synthRetAnnots`.
            if etInnerTy is TyObj {
              const nsoTail = lambdaBodyTail(n.fnBody)
              if nsoTail >= 0 && assignableExpr(nsoTail, inferred, expRet) {
                inferred = expRet
              }
            }
            // The NULLABLE-LITUNION dual (`() => K0 | null = () => ("42")`): a lambda whose body
            // infers a bare `string` MEMBER of the expected `K | null` litunion adopts the niche —
            // its functype result is the i32 atom (the `-1` sentinel = null), and `emitReturnValue`'s
            // `retNulLitUnion` arm encodes the member literal as its atom id / a `return null` as
            // `-1`. Recorded by `nulLitUnionRetName` + pinned by `synthRetAnnots` (`nullablePartOf`
            // non-empty). Exposed already by the annotated `: () => K | null` form.
            if tyIsLitUnion(etU.nInner) {
              const nluTail = lambdaBodyTail(n.fnBody)
              if nluTail >= 0 && assignableExpr(nluTail, inferred, expRet) {
                inferred = expRet
              }
            }
          }
        }
        // VALUE-UNION result (C1, `() => i64 | boolean`): a lambda whose body infers a bare
        // SCALAR arm of the expected value-union box result adopts the union, so the widening
        // lands at the return seam — `emitReturnValue` boxes the scalar into the `{tag, value}`
        // rep and the lambda's functype result IS the box (`synthRetAnnots` pins `fnRet` to the
        // recorded union name; the `"union"` return kind then drives the union result valtype). Without this the
        // body returned a raw scalar into a union-box functype result (INVALID-WASM at the call
        // site's box-typed local). The scalar-arm boxing is position-independent, so this is the
        // closure-return dual of the array-element boxing. Checked AFTER the niche arms (a
        // `T | null` niche must not be swallowed as a value union).
        if inferred != expRet && valueUnionRetName(expRet) != "" {
          const vuTail = lambdaBodyTail(n.fnBody)
          if vuTail >= 0 && assignableExpr(vuTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // LITUNION-ARRAY value-union result (`(i32) => K0[] | i64`): a lambda whose body infers
        // the bare scalar arm (`(q0) => (5000000077)` infers i64) of the expected `litunion-array
        // | scalar` box result adopts the union, so the boxing lands at the return seam
        // (`emitReturnValue` boxes the scalar into the `{tag, value}` rep, or the array arm rides
        // as the kind-7 list ref) and the lambda's functype result IS the box — its `$fnsig` keys
        // `>u`, matching the value call. `valueUnionRetName` declines this union (its `tyToStr`
        // render flattens the litunion-array atom), so it needs its own alias-preserving arm.
        // The annotated `mk(): K0[] | i64` named-function spelling already lowers this box.
        if inferred != expRet && litUnionArrayValueUnionRetName(expRet) != "" {
          const laTail = lambdaBodyTail(n.fnBody)
          // Gate on STRICT `assignable` of the body's INFERRED type (not the expression-level
          // `assignableExpr` the other arms use): the litunion-array arm reps as the kind-7
          // i32-ATOM list, but a bare array-LITERAL body (`(q0) => (["84"])`) self-infers the
          // SOFTENED `string[]` (kind-9 string-ref backing) — `assignableExpr` would element-re-type
          // the literal to `K0[]` and adopt, yet the emitter boxes the string[] wrapper with the
          // wrong tag (the consumer's `is K0[]` mismatches). Only a body already at the union's rep
          // (a `return a` where `a: K0[]`, or a scalar arm) is `assignable`; the softened-literal
          // spelling stays the loud reject master gives (litunion-array-LITERAL element re-typing
          // in a boxed arm is a separate gap).
          if laTail >= 0 && assignable(inferred, expRet) { inferred = expRet }
        }
        // CLOSURE-ARM value-union result (`(i32) => (() => string) | i64`): a lambda whose
        // body infers ONE arm (a closure or a scalar) of the expected closure-arm value union
        // adopts the union, so the boxing lands at the return seam — `emitReturnValue` boxes
        // the arm (a closure member is the kind-11 REF atom, riding the box's anyref value)
        // and the lambda's functype result IS the box (`synthRetAnnots` pins `fnRet` via its
        // `isValueUnionName` arm; the `$fnsig` keys `>u`, matching the value call's
        // `annRetKind`). The annotated named-function-VALUE spelling of the same union result
        // already lowers this box soundly, so the pin only removes the annotation.
        if inferred != expRet && cloArmValueUnionRetName(expRet) != "" {
          const cvTail = lambdaBodyTail(n.fnBody)
          if cvTail >= 0 && assignableExpr(cvTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // MAP-MEMBER-UNION result (`() => {[string]:f32} | {w:i32}`): a lambda whose body infers
        // one struct arm of the expected map-member-union box result adopts the union, so the
        // widening lands at the return seam — `emitReturnValue` boxes the struct/map arm into the
        // #865/#868 map-union box and the lambda's functype result IS the box (`synthRetAnnots` pins
        // `fnRet` to the recorded union name). Without this the body returned a bare struct into a
        // union-box functype result (a `ref valtype with no interned shape` crash). Position-
        // independent, like the value-union arm: the annotated `: {[string]:f32}|{w:i32}` return
        // exposes this rep already, so the lambda pin adds no invalid wasm.
        if inferred != expRet && mapUnionRetName(expRet) != "" {
          const muTail = lambdaBodyTail(n.fnBody)
          if muTail >= 0 && assignableExpr(muTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // REF-ARM value-union result (`(i32) => T[] | {w: i32}`, repOf item (d)): a lambda whose
        // body infers ONE arm (`(q0) => ([{f: true}])` infers `T[]`) of the expected ref-arm
        // union adopts the union, so the boxing lands at the return seam — `emitReturnValue`
        // boxes the reflist/struct arm into the `{tag, value}` rep and the lambda's functype
        // result IS the box (`synthRetAnnots` pins `fnRet` to the recorded name; its `$fnsig`
        // keys `>u`, matching the call site's `annSigKey`). Without the pin the lambda's
        // functype result was the RAW reflist while the narrowed call site `ref.cast` the
        // funcref to the `>u` sig — a guaranteed runtime cast TRAP (annotated spelling) or,
        // with the consumer gate also missing, INVALID-WASM (the #911 finding). The annotated
        // named-function spelling (`mk(): T[] | {w: i32}`) already lowers this box soundly, so
        // the pin only removes the annotation. NOMINAL-gated (`refArmUnionRetName` declines an
        // anonymous-element array arm), so the #911 declared-twin-gated shapes stay loud.
        if inferred != expRet && refArmUnionRetName(expRet, gRootStmts) != "" {
          const raTail = lambdaBodyTail(n.fnBody)
          if raTail >= 0 && assignableExpr(raTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // VARIANT-BOX union result with an INLINE-struct arm (`(i32) => i32 | {w: i32}`,
        // `() => {f: i32} | f64` — the R2 closure-result `$fnsig` seam): a lambda whose body
        // infers ONE arm of the expected union adopts the whole union, so the boxing lands at
        // the return seam (`emitReturnValue` boxes the arm) and the lambda's functype result IS
        // the box — its `$fnsig` keys `>u`, byte-matching the value call's `annSigKey`. The
        // annotated named-function spelling of every such union already lowers this box soundly
        // (the value call reads it back through `is`), so the pin only removes the annotation.
        // AFTER `refArmUnionRetName` (ref-array arms carry a slot render this arm declines).
        if inferred != expRet && variantBoxUnionRetName(expRet) != "" {
          const vbTail = lambdaBodyTail(n.fnBody)
          if vbTail >= 0 && assignableExpr(vbTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // ELEMENT-NULLABLE LIST result (`() => (f64|null)[]`): a lambda whose body is an
        // array literal assignable to the expected value-union-box list adopts it, so
        // `emitReturnValue` seeds each nullable element (`[null]`) through the SAME rep the
        // annotated `(f64|null)[]` return / named-function form already lowers soundly
        // (`synthRetAnnots` pins `fnRet`). Position-independent: the annotated spelling
        // exposes this rep everywhere already, so the lambda pin cannot add invalid wasm.
        if inferred != expRet && nulElemListRetName(expRet) != "" {
          const elTail = lambdaBodyTail(n.fnBody)
          if elTail >= 0 && assignableExpr(elTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // ELEMENT-NULLABLE-STRUCT LIST result (`() => (S | null)[]`): a lambda whose
        // body array literal (non-null struct elements, or a `null` hole) is assignable
        // to the expected nullable-struct-element list adopts it, so `emitReturnValue`
        // builds each element through the kind-1 struct NICHE (`(ref null $S)`) the
        // annotated `(): (S|null)[]` named-function value spelling already lowers soundly
        // (`synthRetAnnots` pins `fnRet` via `parenUnionArrElemName`). Un-pinned, the
        // body's non-null structs self-classified a `{…}[]` reflist keyed on a DIFFERENT
        // slot than the annotation-side value call's `(…|null)[]` slot — a "no interned
        // signature" reject / cast-failure TRAP. The nullable-struct sibling of the
        // element-nullable arm above.
        if inferred != expRet && nulStructElemListRetName(expRet) != "" {
          const nseTail = lambdaBodyTail(n.fnBody)
          if nseTail >= 0 && assignableExpr(nseTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // ELEMENT-NULLABLE-MAP LIST result (`() => ({[string]: boolean} | null)[]`): a lambda
        // whose body array literal (non-null maps, or a `null` hole) is assignable to the
        // expected nullable-map-element list adopts it, so `emitReturnValue` builds each
        // element through the kind-3 map NICHE (`(ref null $mapStruct)`) the annotated
        // `(): ({[string]:boolean}|null)[]` named-function value spelling already lowers
        // (`synthRetAnnots` pins `fnRet` via `parenUnionArrElemName`). Un-pinned, the body's
        // non-null maps self-classified a `{[string]:V}[]` reflist keyed on a DIFFERENT slot
        // than the annotation-side value call's `(…|null)[]` slot — a "no interned signature"
        // reject / cast-failure TRAP (fuzz sweep YKq9Jw declared, seed 43421976). The
        // nullable-map sibling of the nullable-struct arm above.
        if inferred != expRet && nulMapElemListRetName(expRet) != "" {
          const nmeTail = lambdaBodyTail(n.fnBody)
          if nmeTail >= 0 && assignableExpr(nmeTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // ELEMENT-NULLABLE-SCALAR-LIST result (`() => (f64[] | null)[]`): a lambda whose
        // body array literal (non-null inner lists, or a `null` hole) is assignable to the
        // expected nullable-list-element list adopts it, so `emitReturnValue` builds each
        // element through the nullable inner-wrapper niche (`(ref null $wrapper)`) the
        // annotated `(): (f64[]|null)[]` named-function value spelling already lowers
        // (`synthRetAnnots` pins `fnRet` via `parenUnionArrElemName`). Un-pinned, the body's
        // non-null lists self-classified a plain `f64[][]` reflist keyed on a DIFFERENT slot
        // than the annotation-side value call's `(…|null)[]` slot — a cast-failure TRAP
        // (fuzz post-#1051 sweep GATING leg). The scalar-list sibling of the nullable-map
        // arm above.
        if inferred != expRet && nulListElemListRetName(expRet) != "" {
          const nleTail = lambdaBodyTail(n.fnBody)
          if nleTail >= 0 && assignableExpr(nleTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // ELEMENT-VALUE-UNION LIST result (`() => (i64|boolean)[]`): a lambda whose body array
        // literal is assignable to the expected value-union-box list adopts it, so `emitReturnValue`
        // boxes each element (`[7]`) through the SAME element-kind-2 rep the annotated
        // `(i64|boolean)[]` return / named-function-value form already lowers soundly (`synthRetAnnots`
        // pins `fnRet`). The value-union sibling of the element-nullable arm above.
        if inferred != expRet && elemValueUnionListRetName(expRet) != "" {
          const evTail = lambdaBodyTail(n.fnBody)
          if evTail >= 0 && assignableExpr(evTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // ELEMENT-VARIANT-BOX-UNION LIST result (`(i32) => ({a,f,z} | i64)[]`): a lambda
        // whose body array literal is assignable to the expected variant-box-element list
        // adopts it, so `emitReturnValue` boxes each element through the SAME element-kind-2
        // rep the annotated return / named-function-VALUE form already lowers
        // (`synthRetAnnots` pins `fnRet` via its `parenUnionArrElemName` arm). The
        // variant-box sibling of the element-value-union arm above.
        if inferred != expRet && elemVariantBoxListRetName(expRet) != "" {
          const vbeTail = lambdaBodyTail(n.fnBody)
          if vbeTail >= 0 && assignableExpr(vbeTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // ELEMENT-MAP-UNION LIST result (`() => ({[string]: string} | f64)[]`): a lambda
        // whose body array literal is assignable to the expected map-union-element list
        // adopts it, so `emitReturnValue` boxes each element through the SAME element-kind-2
        // map-union box rep the annotated `(…)[]` return / named-function-VALUE form already
        // lowers (`synthRetAnnots` pins `fnRet` via its `parenUnionArrElemName` arm). Un-pinned,
        // the body's f64-array self-classified a `f64[]` reflist keyed on a DIFFERENT slot than
        // the annotation-side value call's union-box `(…)[]` slot — a cast-failure TRAP (fuzz
        // sweep YKq9Jw multiobs, seed 58637234). The map-union sibling of the element-value-union
        // and element-variant-box arms above.
        if inferred != expRet && elemMapUnionListRetName(expRet) != "" {
          const meTail = lambdaBodyTail(n.fnBody)
          if meTail >= 0 && assignableExpr(meTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // ELEMENT-REFARM-VALUE-UNION LIST result (`() => ((i32|boolean)[] | i32)[]`): a lambda
        // whose body array literal (`() => ([77])` infers `i32[]`) is assignable to the expected
        // list of `(union-element-array | scalar)` boxes adopts it, so `emitReturnValue` boxes
        // each element through the SAME element-kind-2 box the annotated `((i32|boolean)[]|i32)[]`
        // return / named-function-VALUE spelling already lowers (`synthRetAnnots` pins `fnRet` via
        // its `parenUnionArrElemName` arm). Un-pinned, the body's `i32[]` self-classified a plain
        // reflist keyed on a DIFFERENT `$fnsig` slot than the annotation-side value call's box-list
        // slot — a cast-failure TRAP. The union-element-array sibling of the element-value-union arm.
        if inferred != expRet && elemRefArmValueUnionListRetName(expRet) != "" {
          const raeTail = lambdaBodyTail(n.fnBody)
          if raeTail >= 0 && assignableExpr(raeTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // NESTED (2-D+) UNION-ELEMENT array result (`() => ({f: (…) => boolean} | i32)[][]`):
        // a lambda whose body nested array literal (`[[77], [{f:…}]]` self-infers `i32[][]`
        // from the first inner list's leaf) is assignable to the expected 2-D+ box-element
        // list adopts it, so `emitReturnValue` builds the nested lists through the SAME
        // element-kind-2 box the annotated `(…)[][]` return / NAMED-function value spelling
        // already lowers soundly (`synthRetAnnots` pins `fnRet` off THIS producer's rung, `IR_RUNG_NESTED_ELEM_UNION_LIST`).
        // Un-pinned, the outer array self-classified `i32[][]` and stored a union-list element
        // into the i32-list backing — INVALID-WASM (fuzz sweep wo7cNe declared, seed 174529790).
        // The nested sibling of the 1-D element-value/variant/map-union arms above.
        if inferred != expRet && nestedElemUnionListRetName(expRet) != "" {
          const nueTail = lambdaBodyTail(n.fnBody)
          if nueTail >= 0 && assignableExpr(nueTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // UNION-FIELD-STRUCT-element LIST result (`() => {f: {f: f64} | boolean}[]`): a
        // lambda whose body array literal is assignable to the expected list of
        // boxed-field structs adopts it, so each element literal builds the boxed field
        // slot exactly as the annotated `(): {f:…|boolean}[]` spelling lowers
        // (`synthRetAnnots` pins `fnRet` via the element's `nameIsStructWithUnionField`).
        // The element-list sibling of the `structFieldBoxRetName` struct arm.
        if inferred != expRet && structFieldBoxElemListRetName(expRet) != "" {
          const sfeTail = lambdaBodyTail(n.fnBody)
          if sfeTail >= 0 && assignableExpr(sfeTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // NULLABLE-CLOSURE-element LIST result (`() => ((() => i64) | null)[] = () =>
        // ([null])`): a lambda whose body array literal is assignable to the expected
        // kind-5 niche list adopts it, so `emitReturnValue` seeds each element (a `null`
        // → `ref.null $cloStruct`) through the SAME rep the annotated return /
        // named-function form already lowers soundly (`synthRetAnnots` pins `fnRet`).
        // The closure-niche sibling of the element-nullable arm above.
        if inferred != expRet && nulClosureElemListRetName(expRet) != "" {
          const nceTail = lambdaBodyTail(n.fnBody)
          if nceTail >= 0 && assignableExpr(nceTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // NESTED-LIST result (`() => i64[][] = () => ([[100]])`): a lambda whose body array
        // literal is assignable to the expected nested scalar-leaf array adopts it, so the
        // body literal builds under the pinned RETURN's threading (`synthRetAnnots` pins
        // `fnRet`; the leaf widens at the store like a named function's return) and the
        // `$fnsig` result keys the arm's reflist slot on BOTH producers. Unlike the 1-D
        // scalar-list note below, the pinned `fnRet` TypeRef IS scanned by `collectA`'s
        // ref-array branch (`ensureRefElem` + the leaf-pair forcing), so the call-result
        // index finds its list types collected. (R4.)
        if inferred != expRet && nestedLeafListRetName(expRet) != "" {
          const nlTail = lambdaBodyTail(n.fnBody)
          if nlTail >= 0 && assignableExpr(nlTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // SCALAR-LEAF LIST result (`(i32) => f32[] = (q0) => ([97.5])`, `() => i64[] =
        // () => ([5])`): a lambda whose body array literal is assignable to the expected
        // distinct-backing scalar-leaf list adopts it — the elements re-encode at the leaf
        // (`assignableExpr`'s ArrayLit arm, the same grant a direct `const xs: f32[] = [1.5]`
        // binding makes), the adopted name is recorded (`isScalarListRetName`) and
        // `synthRetAnnots` pins `fnRet` to it, so the body literal builds the leaf's wrapper
        // under the RETURN-position seed and the value-call index read finds its list types
        // collected — the SAME sound path the annotated named-function spelling
        // (`mk(q0: i32): f32[]`) already lowers.
        if inferred != expRet && scalarLeafListRetName(expRet) != "" {
          const slTail = lambdaBodyTail(n.fnBody)
          if slTail >= 0 && assignableExpr(slTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // LITUNION-ELEMENT LIST result (`(i32) => K0[] = (q0) => (["4664"])`): a lambda
        // whose body array literal's elements are MEMBERS of the expected litunion-element
        // list adopts it — `assignableExpr`'s ArrayLit arm records the destination array
        // type on the literal (the atom-array contextual adoption a direct
        // `const ks: K0[] = ["4664"]` binding makes), so the body builds the i32 atom
        // list; the lambda's `>a` result token already byte-matches the annotation side
        // (a litunion array shares the i32-list backing), so no pin is needed. The
        // named-function spelling (`mk(q0: i32): K0[]`) lowers this already.
        if inferred != expRet && litUnionElemListRetName(expRet) != "" {
          const lulTail = lambdaBodyTail(n.fnBody)
          if lulTail >= 0 && assignableExpr(lulTail, inferred, expRet) {
            inferred = expRet
          }
        }
        // STRUCT-ELEMENT LIST result (`(i32) => {f: f32}[]`, `(i32) => {a: f32, f: K0,
        // z: i64}[]`): a lambda whose body array literal's element structs coerce FIELD-WISE
        // into the expected element shape adopts the expected list — `assignableExpr`'s
        // per-element ObjLit coercion RECORDS the coerced field types (a float-literal f32
        // field, a small-int i64/f64 field, a litunion member) for the emitter's interner,
        // exactly as a direct `const xs: {f: f32}[] = [{f: 1.5}]` binding does. Gated on
        // plainly-lowerable element fields (`structElemListRetName`: scalar / string /
        // litunion) so a map / union / nullable-field element stays a loud reject.
        if inferred != expRet && structElemListRetName(expRet) != "" {
          const seTail = lambdaBodyTail(n.fnBody)
          if seTail >= 0 && assignableExpr(seTail, inferred, expRet) {
            inferred = expRet
            objRetAdopted = true
          }
        }
        // EMPTY-`[]` RESULT THAT NO ARM ABOVE ADOPTED — the LOUD FLOOR, and the LAST rung of
        // this ladder. `const fq: () => string[] = () => { return [] }` infers the element
        // HOLE (`TyArray.aElem == -1`): not a narrower version of the annotation's rep, the
        // ABSENCE of one. When an arm above adopted, `inferred == expRet` and this cannot
        // fire; when nothing did, the lambda's `fnRet` stays the hole while the value call
        // casts the funcref to the annotation's `$fnsig` — `wasm trap: indirect call type
        // mismatch`, check-clean, module written — or the body's list `struct.new` disagrees
        // with the result slot (invalid wasm). Neither is a diagnostic a reader can act on.
        //
        // The exemption is the I32-BACKED elements (`i32`, `boolean`): they share the one
        // i32-list backing, so the hole and the annotation name the SAME list rep and the
        // un-adopted lowering is already correct (measured: 12 of 12 cells correct). Every
        // rep that needs its own backing either adopts above (`i64`/`f64`/`f32` via
        // `scalarLeafListRetName`, a struct element via `structElemListRetName`, a litunion
        // element via `litUnionElemListRetName`) or lands here.
        //
        // The named-function spelling of the same program lowers, so the message names it:
        // `scalarLeafListRetName`'s exclusion note ("`string[]` self-classifies identically
        // to the annotation, so no adoption is ever needed") is true of a NON-EMPTY literal
        // and false of an empty one, which is why this rep reached emit unpinned at all.
        if inferred != expRet && unresolvedHole(inferred) {
          const ehT = T.tys[expRet]
          if ehT is TyArray {
            if (
              !tyIsPrimNamed(ehT.aElem, "i32") &&
              !tyIsPrimNamed(ehT.aElem, "boolean")
            ) {
              tErrUnsupported(
                "a lambda returning an empty `[]` cannot build the " +
                  tyToStr(expRet) +
                  " result its annotation asks for — type-valid, but the element type has no" +
                  " rep to build from; return the literal from a named function" +
                  " (`function f(): " +
                  tyToStr(expRet) +
                  " { return [] }`), which lowers this",
                n.fnBody,
              )
            }
          }
        }
      }
    }
    // PERMISSIVE FALL-THROUGH (totality): an un-annotated function that can fall off the
    // end on some path implicitly yields `null` there, so its inferred return widens to
    // `T | null` (host byline: "types hidden by aggressive inference"). A box-able value
    // type (`i32`/`i64`/`f64`/`f32` and their unions) lowers un-annotated via the
    // `uBoxIdx` box; a NICHE (`boolean`/`string`) widens too but stays floored just below
    // ("annotate the return type") until A20 carries the niche seed. A void/error
    // inferred return (no value return at all) never falls into a value position, so it
    // is exempt. Mirrors the annotated rule below: fall-through `null` must be part of the
    // return type, here by widening rather than by an explicit annotation.
    if (
      !bodyTotalForRet &&
      inferred >= 0 &&
      !isVoidTy(inferred) &&
      inferred != TY_ERR
    ) {
      const inT = T.tys[inferred]
      if !(inT is TyNullable) { inferred = mkNullableTy(inferred) }
    }
    // Robustness floor (host parity with the empty-`[]` "cannot infer — annotate"
    // floor): an un-annotated function whose returns JOIN to a union/nullable now
    // infers the CORRECT type, but the emitter cannot yet lower an un-annotated
    // union/nullable return — the `A20` return classifier carries scalar/string/array,
    // not the union box / nullable-struct seed, so a bare `return null` / a string
    // through an i32 result crashes codegen ("bare null needs a struct-typed context").
    // Require an explicit annotation here, which DOES lower (the annotated path seeds
    // the return). Codegen elaboration that removes this requirement — inferred
    // union/nullable returns end-to-end — is the documented follow-up.
    // A VALUE union/nullable (`i32 | string`, `i32 | null`) now lowers un-annotated via
    // the `uBoxIdx` box (valueUnionRetName != "" — exported above, emitted like the
    // annotated path), so it does NOT floor. Only a union/nullable the emitter still
    // can't box un-annotated — struct-ref unions, `boolean | null` / `string | null`
    // niches — hits the floor.
    // A DEFERRED join (a union `joinTys` minted over an inference HOLE — see
    // `joinHoleUnions`) is NOT a union the emitter ever lowers: it is a placeholder
    // that collapses to ONE arm at each call site, where `substTyDeep` re-folds it
    // under the pinned argument. Flooring it here would reject the very
    // `is`-guard-over-a-hole spelling `inference/hole-is-guard-alternative.vl` pins.
    if (
      !inferQuiet &&
      n.fnName != "" &&
      inferred >= 0 &&
      !tyIsDeferredJoin(inferred) &&
      valueUnionRetName(inferred) == ""
    ) {
      const itt = T.tys[inferred]
      // A VARIANT-BOX union (`{w: i32} | i32`, `Cat | i32`, and their nullable form
      // `{w: i32} | i32 | null` — canon wraps the null into a `TyNullable`) lowers
      // un-annotated: the A20 loop records `variantBoxUnionRetName` under the function's
      // name, `collectU`'s inferred-return loop registers the box + its variant struct,
      // and the emitter's `isUName` return classification boxes it exactly like the
      // annotated `: {w: i32} | i32` spelling. Checked BEFORE the TyUnion/TyNullable arms
      // (it spans both) so the floor accepts EXACTLY the box the emitter registers; a
      // shape `variantBoxUnionRetName` still declines falls through to floor.
      if litUnionAliasNameOfTy(inferred) != "" {
        // A pure literal union with a DECLARED alias (`type K = "a" | "b"`) lowers
        // un-annotated as the interned i32 ATOM: the A20 loop records the alias name and
        // the emitter's return classification reads the same `nameIsLitUnionType` rep the
        // annotated `: K` spelling reaches. An INLINE litunion (no alias to record) still
        // floors below — it has no name for the emitter to key on.
      } else if variantBoxUnionRetName(inferred) != "" {
        // lowers un-annotated — no floor
      } else if itt is TyUnion {
        // A pure STRUCT-union whose every member maps to a NAMED type (`Cat | Dog`) lowers
        // un-annotated via the variant-boxed rep, exactly like the annotated form — so it
        // does NOT floor. The export uses the SAME `structUnionRetName` predicate, so the
        // floor accepts EXACTLY what the emitter can register/lower; a union mixing a
        // scalar/string, or one with an anonymous/un-named-shape member, still floors.
        if structUnionRetName(inferred, gRootStmts) == "" {
          tErrUnsupported(
            "'" +
              n.fnName +
              "' infers the union return type " +
              tyToStr(inferred) +
              " — type-valid, but an inferred return of this shape is not yet supported by codegen; annotate the return type",
            n.fnBody,
          )
        }
      } else if itt is TyNullable {
        // The NICHE nullables (`boolean | null` / `string | null` / `K | null`) lower
        // un-annotated — the A20 table carries their inferred name and the emitter seeds
        // the niche (sentinel `2` / `ref.null $array` / the litunion's `-1` atom) from it —
        // so they do NOT floor. Only a nullable the emitter still can't box/niche
        // un-annotated (a nullable STRUCT ref) hits the floor.
        if (
          !tyIsPrimNamed(itt.nInner, "boolean") &&
          !tyIsPrimNamed(itt.nInner, "string") &&
          litUnionAliasNameOfTy(itt.nInner) == ""
        ) {
          tErrUnsupported(
            "'" +
              n.fnName +
              "' infers the nullable return type " +
              tyToStr(inferred) +
              " — type-valid, but an inferred return of this shape is not yet supported by codegen; annotate the return type",
            n.fnBody,
          )
        }
      }
    }
    ret = inferred
    // Patch the hoisted TyFunc IN PLACE so existing references see the result;
    // a nested (un-hoisted) NAMED function declares fresh; an anonymous lambda
    // just carries its type as the expression value.
    // The parameter-solve probe OBSERVES this body; it must not DECIDE the return.
    // Patching (or re-declaring) the hoisted signature here would hand pass 1.7's
    // return inference an already-resolved return, so it would never re-derive it
    // against the parameters pass 1.6 just solved.
    if n.fnName != "" && !paramSolveProbe {
      const bound = lookup(n.fnName)
      let patched = false
      if bound >= 0 {
        const bt = T.tys[bound]
        if bt is TyFunc {
          bt.fnRet = inferred
          tyMutEpoch = tyMutEpoch + 1 // inferred return patched in place
          patched = true
        }
      }
      if !patched { declare(n.fnName, mkFuncTy(paramTys, inferred)) }
      // Re-retain the SYMBOL-TABLE type with the inferred return: the entry
      // stamped while checking the signature (`symDeclInOuter`, above) carried the
      // `-2` infer-later sentinel, and the in-place patch above only touches the
      // scope-bound copy (a distinct arena entry). Without this, hover / inlay on
      // an unannotated function render `-> _`. `symRetainType` overwrites the
      // existing `fnIx` entry in place.
      if symEnabled != 0 {
        symRetainType(fnIx, mkFuncTy(paramTys, inferred), 2)
      }
    } else if !inferQuiet {
      // An ANONYMOUS lambda is lifted to a top-level function by the emitter under a
      // synthesized `__lambda_N` name the checker never saw, so the name-keyed
      // inferred-return table can't reach it (the emitter's `inferRetNameOf("__lambda_N")`
      // misses, and the return mis-classifies as i32). Record the inferred SCALAR/STRING/
      // LIST return under a node-index sentinel key (`#<nodeIx>` — `#` can't appear in a
      // real name, so no collision), read back by `inferRetNameByNode`. This is the lambda
      // analogue of the named loop in `checkProgram`; without it a non-i32 return reached
      // through a VARIABLE (`(n) => { const x: i64 = …; return x }`) — which the emitter's
      // expression-based fallback misses — emits invalid wasm.
      const anm = tyToStructStr(inferred)
      // A STRUCT-with-BOXED-FIELD contextual return (`{f: boolean | {w: i32}}`, `{f: i64 |
      // string}` — a struct whose field is a union/nullable) the checker adopted at the lambda
      // boundary (`objRetWidenAdopt`'s boxing-widen arm). Recorded under the CANONICAL emit name
      // (`tyToEmitName`, spaceless — the `sNames` / `structIndexByName` key), NOT the spaced
      // `tyToStr` render, so `synthRetAnnots`'s pin + `internShapeDeep`'s inline-shape intern
      // resolve. Takes precedence over `recordable` (which would else record the spaced `anm`,
      // an un-interned key). Empty unless the inferred struct genuinely carries a boxed field.
      const sfbNm = structFieldBoxRetName(inferred)
      // A MAP-carrying STRUCT return (`{a: string, f: {f: {[string]: {f: i64}}}, z: f32}`):
      // recorded under the CANONICAL emit name too — the spaced `recordable` render never
      // pins, and the un-pinned body literal's nested `{f: h0}` resolved the map's own
      // value struct `{f: i64}` by field-name set, minting a wrong-layout outer twin
      // (INVALID-WASM; fuzz-nightly seed 184510897 d6). AFTER `sfbNm` (a boxed-field
      // struct keeps its established pin).
      let smfNm = ""
      if sfbNm == "" { smfNm = structMapFieldRetName(inferred) }
      // A PLAIN struct return (`{f: f32}`, `{a: i64, f: f64, z: {…}}` — scalar /
      // litunion / nested-plain fields only): recorded CANONICALLY too. The spaced
      // `recordable` render never pins, and an un-pinned lambda's body literal
      // fieldset-matches — a program with a same-fieldset TWIN row in scope resolved
      // the WRONG row (`{f: 4.5}` took the `{f: f64}` twin where the context declared
      // `{f: f32}` — INVALID-WASM, fuzz sweep3 multiobs leg, seed 784841544
      // case_00222; the third same-fieldset pin-miss this arc after #969's map-field
      // and case_00290's element-list). Composite fields (map / union / closure /
      // list) keep their own recorder arms below.
      let spfNm = ""
      if sfbNm == "" && smfNm == "" && objRetAdopted {
        spfNm = structPlainRetName(inferred)
      }
      // A single STRUCT-shape (`{meow: i32}`) inferred return is recorded too — a lambda
      // that COLLAPSES to one union variant (`(a) => if a is Cat { a } else { catShape }`)
      // types as that variant's shape; the emitter resolves it to the concrete variant
      // (`variantIndexOfTypeName`) so a `.map` result is the variant ref list, not the box.
      // WHICH GATE admitted the fall-through row, asked in the SAME short-circuit the `||` had:
      // the gates run only when all three canonical recorders declined, each runs at most once,
      // and they run in the source order they were written in. `recordable` is bit-identical to
      // the disjunction it replaces.
      let recCode = IR_RUNG_NONE
      if sfbNm == "" && smfNm == "" && spfNm == "" {
        if isClassifiableRetName(anm) { recCode = IR_REC_CLASSIFIABLE }
        else if isObjShapeName(anm) { recCode = IR_REC_OBJ_SHAPE }
        else if isScalarListRetName(anm) { recCode = IR_REC_SCALAR_LIST }
      }
      const recordable = recCode != IR_RUNG_NONE
      // A UNION inferred/contextual return (`i32 | string`, `Cat | Dog`) — export its emitter-format
      // name (value-union or struct-union) under the same node sentinel, mirroring the named-function
      // A20 loop. This is the CONTEXTUAL return the checker proved for the lambda at ITS boundary
      // (binding / return / field / array / arg), so the emitter pins a union-returning closure value
      // POSITION-INDEPENDENTLY (`synthRetAnnots`), instead of re-deriving it per boundary.
      let unm = ""
      // NOT THE ONLY WRITER SINCE THE r8 SPLIT: `nulElemListRetName` sets the rung itself
      // (`irAtomsRung`), and the contextual-ADOPTION gate earlier in this function calls that
      // producer too — so a write can land BEFORE this reset. Safe because this reset is
      // unconditional and precedes the cascade, and the only read is at the record below; stated
      // because that safety is now an ordering property of a long function rather than an obvious
      // one.
      //
      // ARMED FROM A KNOWN STATE. The global's lifetime is now exactly one cascade run: cleared
      // here, written by whichever `irRung` answers, read once at the record below. Nothing it
      // holds can outlive this block, so it needs no reset in `initChecker` and cannot cross a
      // program boundary — the failure the column itself had on its first build.
      inferRetNameRung = IR_RUNG_NONE
      if !recordable {
        unm = irRung(IR_RUNG_SFB, sfbNm)
        if unm == "" { unm = irRung(IR_RUNG_STRUCT_MAP_FIELD, smfNm) }
        if unm == "" { unm = irRung(IR_RUNG_STRUCT_PLAIN, spfNm) }
        if unm == "" {
          unm = irRung(IR_RUNG_VALUE_UNION, valueUnionRetName(inferred))
        }
        // A LITUNION-ARRAY value-union contextual return (`(i32) => K0[] | i64`, adopted just
        // above) — record its alias-preserving emit name so `collectU`'s inferred-return loop
        // REGISTERS the union and `synthRetAnnots`'s `isValueUnionName` arm pins the lambda's
        // `fnRet` to it; the `$fnsig` result then keys `>u`, matching the value call. The
        // litunion-array sibling of the `valueUnionRetName` arm above (which flattens the atom).
        if unm == "" {
          unm = irRung(
            IR_RUNG_LITUNION_ARR_VU,
            litUnionArrayValueUnionRetName(inferred),
          )
        }
        if unm == "" {
          unm = irRung(
            IR_RUNG_STRUCT_UNION,
            structUnionRetName(inferred, gRootStmts),
          )
        }
        // A NULLABLE-ref contextual return (`P | null`, `string | null`) — recorded under the same
        // node sentinel so `synthRetAnnots` pins a nullable-returning closure value position-
        // independently (the nullable dual of the union pin).
        if unm == "" {
          unm = irRung(IR_RUNG_NULLABLE, nullableRetName(inferred, gRootStmts))
        }
        // A NULLABLE-LITUNION contextual return (`() => K0 | null`, adopted just above) — record
        // the alias name so `synthRetAnnots` pins the lambda's `fnRet` as the nullable litunion
        // (an i32 atom with `-1` = null), whose member-encoding `emitReturnValue` already performs.
        if unm == "" {
          unm = irRung(IR_RUNG_NUL_LITUNION, nulLitUnionRetName(inferred))
        }
        // An ELEMENT-NULLABLE list contextual return (`() => (f64|null)[]`, adopted just
        // above) — record its emitter name so `synthRetAnnots` pins the lambda's `fnRet` as
        // the value-union-box list, whose `[null]` element seeding `emitReturnValue` already
        // performs for the annotated form.
        if unm == "" { unm = nulElemListRetName(inferred) }
        // An ELEMENT-NULLABLE-STRUCT list contextual return (`() => (S | null)[]`, adopted
        // just above) — record its canonical emit name so `synthRetAnnots` pins the lambda's
        // `fnRet` as the nullable-struct-element list (its `parenUnionArrElemName` arm), whose
        // kind-1 struct-niche element seeding `emitReturnValue` already performs for the
        // annotated form.
        if unm == "" {
          unm = irRung(
            IR_RUNG_NUL_STRUCT_ELEM_LIST,
            nulStructElemListRetName(inferred),
          )
        }
        // An ELEMENT-NULLABLE-MAP list contextual return (`() => ({[string]:boolean}|null)[]`,
        // adopted just above) — record its canonical emit name so `synthRetAnnots` pins the
        // lambda's `fnRet` as the nullable-map-element list (its `parenUnionArrElemName` arm),
        // whose kind-3 map-niche element seeding `emitReturnValue` already performs for the
        // annotated form.
        if unm == "" {
          unm = irRung(
            IR_RUNG_NUL_MAP_ELEM_LIST,
            nulMapElemListRetName(inferred),
          )
        }
        // An ELEMENT-NULLABLE-SCALAR-LIST contextual return (`() => (f64[]|null)[]`, adopted
        // just above) — record its canonical emit name so `synthRetAnnots` pins the lambda's
        // `fnRet` as the nullable-list-element list (its `parenUnionArrElemName` arm), whose
        // nullable inner-wrapper element seeding `emitReturnValue` already performs for the
        // annotated form.
        if unm == "" {
          unm = irRung(
            IR_RUNG_NUL_LIST_ELEM_LIST,
            nulListElemListRetName(inferred),
          )
        }
        // An ELEMENT-VALUE-UNION list contextual return (`() => (i64|boolean)[]`, adopted just
        // above) — record its emitter name so `synthRetAnnots` pins the lambda's `fnRet` as the
        // value-union-box list, whose element boxing `emitReturnValue` already performs.
        if unm == "" {
          unm = irRung(
            IR_RUNG_ELEM_VU_LIST,
            elemValueUnionListRetName(inferred),
          )
        }
        // An ELEMENT-VARIANT-BOX-UNION list contextual return (`(i32) => ({a,f,z}|i64)[]`,
        // adopted just above) — record its emitter name so `synthRetAnnots` pins the lambda's
        // `fnRet` as the variant-box-element list, whose element boxing `emitReturnValue`
        // already performs for the annotated form.
        if unm == "" {
          unm = irRung(
            IR_RUNG_ELEM_VARIANT_BOX_LIST,
            elemVariantBoxListRetName(inferred),
          )
        }
        // An ELEMENT-MAP-UNION list contextual return (`() => ({[string]:string}|f64)[]`,
        // adopted just above) — record its emitter name so `synthRetAnnots` pins the lambda's
        // `fnRet` as the map-union-box element list, whose element boxing `emitReturnValue`
        // already performs for the annotated form.
        if unm == "" {
          unm = irRung(
            IR_RUNG_ELEM_MAP_UNION_LIST,
            elemMapUnionListRetName(inferred),
          )
        }
        // An ELEMENT-REFARM-VALUE-UNION list contextual return (`() => ((i32|boolean)[]|i32)[]`,
        // adopted just above) — record its emitter name so `synthRetAnnots` pins the lambda's
        // `fnRet` as the box-list (its `parenUnionArrElemName` arm registers the inner
        // union-element-array + scalar union), whose element boxing `emitReturnValue` already
        // performs for the annotated form.
        if unm == "" {
          unm = irRung(
            IR_RUNG_ELEM_REFARM_VU_LIST,
            elemRefArmValueUnionListRetName(inferred),
          )
        }
        // A NESTED (2-D+) union-element array contextual return (`() => ({f:…}|i32)[][]`,
        // adopted just above) — record its emitter name so `synthRetAnnots` pins the lambda's
        // `fnRet` as the nested box-element array (the arm keyed on THIS producer's rung), whose
        // return-position `pendingListKind` threading + `$fnsig` reflist-slot keying the
        // annotated NAMED-function form already performs.
        if unm == "" {
          unm = irRung(
            IR_RUNG_NESTED_ELEM_UNION_LIST,
            nestedElemUnionListRetName(inferred),
          )
        }
        // A UNION-FIELD-STRUCT-element list contextual return (`() => {f: {f:f64}|boolean}[]`,
        // adopted just above) — record its emitter name so `synthRetAnnots` pins the lambda's
        // `fnRet` as the boxed-field-element list, whose element boxing the annotated
        // spelling already performs.
        if unm == "" {
          unm = irRung(
            IR_RUNG_STRUCT_FIELD_BOX_ELEM_LIST,
            structFieldBoxElemListRetName(inferred),
          )
        }
        // A PLAIN-STRUCT-element list return (`() => {a: i64, f: f64, z: {…}}[]`) — record
        // its canonical name so `synthRetAnnots` pins the lambda and the element literals
        // build under the annotated threading instead of fieldset-matching (a same-fieldset
        // TWIN row in scope matched the wrong row — INVALID-WASM, fuzz sweep3 multiobs leg,
        // seed 369283890 case_00290). ADOPTION-GATED like the plain-struct record above:
        // a lambda whose self-inference already matched keeps the un-pinned route
        // (un-gated, this record regressed the closure-value ref-list ABI suite cases).
        if unm == "" && objRetAdopted {
          unm = irRung(
            IR_RUNG_STRUCT_ELEM_LIST,
            structElemListRetName(inferred),
          )
        }

        // A NULLABLE-CLOSURE-element list contextual return (`() => ((() => i64) | null)[]`,
        // adopted just above) — record its emitter name so `synthRetAnnots` pins the lambda's
        // `fnRet` (its `parenUnionArrElemName` arm): the pinned TypeRef collects the kind-5
        // ref-list slot + element `$fnsig`, and `emitReturnValue` threads the `[null]` seed.
        if unm == "" {
          unm = irRung(
            IR_RUNG_NUL_CLOSURE_ELEM_LIST,
            nulClosureElemListRetName(inferred),
          )
        }
        // A CLOSURE-ARM value-union contextual return (`(i32) => (() => string) | i64`,
        // adopted just above) — record its emitter name so `collectU`'s inferred-return loop
        // REGISTERS the union and `synthRetAnnots` pins the lambda's `fnRet` to it; the
        // `$fnsig` result then keys `>u`, matching the value call.
        if unm == "" {
          unm = irRung(IR_RUNG_CLO_ARM_VU, cloArmValueUnionRetName(inferred))
        }
        // A MAP-MEMBER-UNION contextual return (`() => {[string]:f32} | {w:i32}`, adopted just above)
        // — record its emitter name so `synthRetAnnots` pins the lambda's `fnRet` as the map-union box
        // (#865/#868), whose arm boxing `emitReturnValue` already performs for the annotated form.
        if unm == "" {
          unm = irRung(IR_RUNG_MAP_UNION, mapUnionRetName(inferred))
        }
        // A REF-ARM value-union contextual return (`(i32) => T[] | {w: i32}`, adopted just
        // above; repOf item (d)) — record its nominal render so `collectU`'s inferred-return
        // loop REGISTERS the union and `synthRetAnnots`'s `isUName` arm pins the lambda's
        // `fnRet` to the same spelling `nodeUnionName` hands the emitter's binding resolution.
        if unm == "" {
          unm = irRung(
            IR_RUNG_REFARM_UNION,
            refArmUnionRetName(inferred, gRootStmts),
          )
        }
        // A VARIANT-BOX union contextual return with an INLINE-struct arm (`(i32) => i32 |
        // {w: i32}`, adopted just above) — record its emitter name so `collectU`'s inferred-
        // return loop REGISTERS the union and `synthRetAnnots`'s `isUName` arm pins the
        // lambda's `fnRet` to it; the `$fnsig` result then keys `>u`, matching the value call.
        if unm == "" {
          unm = irRung(IR_RUNG_VARIANT_BOX, variantBoxUnionRetName(inferred))
        }
        // A NESTED-LIST contextual return (`() => i64[][]`, adopted just above) — record its
        // emitter name so `synthRetAnnots` pins the lambda's `fnRet` as the nested array, whose
        // return-position literal threading + `$fnsig` reflist-slot keying the annotated form
        // already performs (the pinned TypeRef collects its own list types). (R4.)
        if unm == "" {
          unm = irRung(
            IR_RUNG_NESTED_LEAF_LIST,
            nestedLeafListRetName(inferred),
          )
        }
        // A MAP-ELEMENT list contextual return (`(i32) => {[string]: f32}[]`) — record its
        // emitter name so `synthRetAnnots` pins the lambda's `fnRet` as the map-element
        // array, whose kind-3 slot keying the annotated named-function form already performs.
        if unm == "" {
          unm = irRung(IR_RUNG_MAP_ELEM_LIST, mapElemListRetName(inferred))
        }
        // A LITUNION-ALIAS-element list contextual return (`(i32) => K0[]`, adopted just
        // above) — record the `K0[]` name so `synthRetAnnots` pins the lambda's `fnRet`
        // and the body member literals build the i32 ATOM list the annotated return does.
        if unm == "" {
          unm = irRung(
            IR_RUNG_LITUNION_ELEM_LIST,
            litUnionElemListRetName(inferred),
          )
        }
        // A LITERAL-UNION contextual return (`(i32) => K = (x) => "b"`, adopted just above) — record
        // the ALIAS name so `synthRetAnnots` pins the lambda's `fnRet` as the litunion, whose functype
        // result reps as an i32 atom (`vtKindOfType`): the `$fnsig` result keys `>i` to match the value
        // call, and `emitReturnValue` encodes the member literal as its atom id (`retLitUnion`).
        // `litUnionAliasNameOfTy` is a general-purpose helper (every renderer calls it), so
        // it does NOT report a width — its answer is a declared ALIAS identifier, one atom,
        // reported here at its only recorder rung (#1115).
        if unm == "" {
          unm = irRung(
            IR_RUNG_LITUNION_ALIAS,
            irAtoms(litUnionAliasNameOfTy(inferred), 1),
          )
        }
      }
      // The width of the name this ladder settled on, handed over by the producer that
      // JOINED it rather than re-derived by splitting it (#1115). The rungs short-circuit,
      // so the LAST producer to answer non-empty is the one that wrote `inferRetNameAtoms`.
      // The `recordable` name is `anm`, which is not a producer's join: all three gates
      // (`isClassifiableRetName` / `isScalarListRetName` / `isObjShapeName`) admit only
      // ONE-atom spellings — a fixed scalar/list name, or a `{…}` shape whose every
      // separator `isObjShapeName` has just proved sits inside the braces.
      let rAtoms = 1
      if !recordable { rAtoms = inferRetNameAtoms }
      // THE RUNG, on the identical footing as the width above it: read from the cascade only on
      // the path that RAN the cascade. A `recordable` row is structurally incapable of carrying
      // a rung, which is what it means for the fall-through not to be a producer.
      // THE GATE CODE ON THE `recordable` PATH, the producer's rung otherwise. A recordable row
      // is still structurally incapable of carrying a PRODUCER rung — it never runs the cascade —
      // but it now carries the identity of the gate that admitted it, which is what the arm-9
      // conversion reads. The gate codes are never written to `inferRetNameRung`, so they cannot
      // leak into a later row through the producer channel.
      let rRung = recCode
      if !recordable { rRung = inferRetNameRung }
      // A DEFERRED JOIN is a per-call-site placeholder, not a shape the emitter can
      // classify a return by — see the named-function twin in `elaborateInferRets`.
      if recordable || unm != "" {
        if !tyIsDeferredJoin(inferred) {
          const nodeKey = "#" + i32ToStr(fnIx)
          if inferRetNameOf(nodeKey) == "" {
            let rty = unm
            if recordable { rty = anm }
            recordInferRet(nodeKey, rty, inferred, rAtoms, rRung)
          }
        }
      }
    }
    inferObserved = savedObserved
    inferSawErr = savedSawErr
    fnSawValueRet = savedValueRet
  }
  // SOUNDNESS — missing return: a function whose body can fall off the end without
  // yielding a value on some path implicitly produces `null` there. That is sound ONLY
  // when `null` is part of the return type — a NULLABLE return (declared `: T | null`,
  // or an inferred return widened to `T | null` just above) lowers the fall-through as
  // `null` (the emitter pads it; see `emitNullForRet`). A NON-nullable value return with
  // a reachable fall-through has nowhere to put the `null`, so it is rejected (the TS
  // `noImplicitReturns` case: annotated `: i32` that falls through). Suppressed in the
  // pre-pass (`inferQuiet`) and on a void/error return (no cascade).
  let retNullableNow = false
  if ret >= 0 {
    const rtn = T.tys[ret]
    if rtn is TyNullable { retNullableNow = true }
  }
  if (
    !inferQuiet &&
    !isVoidTy(ret) &&
    ret != TY_ERR &&
    !bodyTotalForRet &&
    !retNullableNow
  ) {
    tErr(
      "not all code paths return a value in '" +
        n.fnName +
        "' — add a `return`, or annotate the return type `| null` to fall through",
      n.fnBody,
    )
  }
  // Redundant RETURN annotation: the body's NATURAL inferred return already equals the
  // explicit `: T`, so removing it yields the identical type. Conservative: a single
  // concrete observed return rendering identically to `ret`; a hole / error / `never`
  // / an annotation-influenced return is skipped. Annotated functions are checked only
  // in the real pass, so this never fires under the suppressed pre-pass.
  if (
    !inferring &&
    !inferQuiet &&
    n.fnRet >= 0 &&
    retNatural >= 0 &&
    !retNaturalErr
  ) {
    if !inlayHole(retNatural) && !isNeverTy(retNatural) && ret != TY_ERR {
      if tyEq(retNatural, ret) { recordRedundantRet(n, fnIx, ret) }
    }
  }
  retNatural = savedRetNatural
  retNaturalErr = savedRetNaturalErr
  // Inferred type guard (A6b, host parity — degenerate case): a NAMED function
  // whose body's RESULT is exactly a null-test on one of its params registers
  // as a guard, so calling it in a condition narrows the argument (inline,
  // UFCS, and the guard-clause form).
  if n.fnName != "" {
    const gBody = P.nodes[n.fnBody]
    if gBody is Block {
      const gStmts = gBody.blkStmts
      if gStmts.length > 0 {
        const gLastIx = gStmts[gStmts.length - 1]
        const gLast = P.nodes[gLastIx]
        let gResIx = gLastIx
        if gLast is RetStmt { gResIx = gLast.retArg }
        if gResIx >= 0 {
          const gParamNames: string[] = []
          let gp = 0
          while gp < params.length {
            const gpn = P.nodes[params[gp]]
            if gpn is Param {
              gParamNames.push(gpn.parName)
            } else {
              gParamNames.push("")
            }
            gp = gp + 1
          }
          const gFact = guardFactOf(gResIx, gParamNames)
          if gFact >= 0 {
            const gThen = gFact - gFact / 2 * 2
            guardNames.push(n.fnName)
            guardParamIdxs.push(gFact / 2)
            guardThens.push(gThen)
          }
        }
      }
    }
  }
  // The function's own type — a FuncDecl in EXPRESSION position (a lambda, or a
  // named function referenced as a value) evaluates to it.
  mkFuncTy(paramTys, ret)
}

// Resolve declaration statement `sx`'s fields / union variants and fill them into the
// placeholder pass 0a minted for it, pushing into the SAME arrays its arena entry holds.
// A name redeclared later overwrote `cUserTypes` in pass 0a, so both declarations resolve
// into the LAST placeholder; `cFillDoneAt` keeps each arena entry filled exactly once.
//
// TWO CALLERS, and the second is what makes the fill ORDER-INDEPENDENT: pass 0b's
// source-order driver, and `declaredTyOfName` on demand (`forceDeclFill`) the moment a
// body resolved here names a declaration the driver has not reached yet. Without the
// second, a name resolved between 0a and its own fill answers from an EMPTY arena entry,
// `singleAliasMemberTyIx`'s transparency collapse declines for want of its one member,
// and the field keeps the union WRAPPER the alias is not.
//
// The done-marking happens BEFORE the body resolves, so a self- or mutually-recursive
// declaration still lands on its own empty placeholder — the cyclic arena shape such a
// declaration MEANS, and the reason `type List = { rest: List[] }` already worked.
function fillTypeDeclAt(sx: i32) {
  const sd = P.nodes[sx]
  if sd is TypeDecl {
    const declIx = cUserTypes[sd.tdName] ?? -1
    if declIx >= 0 && !fillDone(declIx) {
      markFillDone(declIx)
      const pt = T.tys[declIx]
      if pt is TyObj {
        const fnames = pt.objFieldNames
        const ftys = pt.objFieldTypes
        const dfields = sd.tdFields
        let fi = 0
        while fi < dfields.length {
          const fd = P.nodes[dfields[fi]]
          if fd is FieldDef {
            fnames.push(fd.fdName)
            let fty = TY_ERR
            if fd.fdType >= 0 {
              const ftn = P.nodes[fd.fdType]
              if ftn is TypeRef {
                // The diagnostic anchors on the FIELD (`dfields[fi]`); the
                // spelling tree is banked on its `TypeRef` child.
                const r = nameToTyAnn(ftn.tyName, dfields[fi], fd.fdType)
                if r >= 0 {
                  fty = r
                  // Record the resolved type on the field's annotation node so the emitter
                  // classifies a struct field structurally from the arena, not the name (C1).
                  if !inferQuiet && fd.fdType < nodeTyIx.length {
                    nodeTyIx[fd.fdType] = r
                  }
                } else {
                  tErr(
                    unknownTyText(ftn.tyName) + " for field '" + fd.fdName + "'",
                    dfields[fi],
                  )
                }
              }
            }
            ftys.push(fty)
          }
          fi = fi + 1
        }
        // The 0a placeholder was just FILLED in place (its field arrays are
        // the ones pushed above) — an existing arena entry changed shape.
        tyMutEpoch = tyMutEpoch + 1
      }
    }
  } else if sd is UnionDecl {
    // A union's variants are type NAMES; resolve each into the member
    // type-arena indices (forward references hit the 0a placeholders).
    const declIx = cUserTypes[sd.udName] ?? -1
    if declIx >= 0 && !fillDone(declIx) {
      markFillDone(declIx)
      const pt = T.tys[declIx]
      if pt is TyUnion {
        const members = pt.uMembers
        const variants = sd.udVariants
        // A DEGENERATE self-cycle — `type D = D`, a body that is nothing but
        // the alias itself — has no base case, so nothing can inhabit it.
        // Reported at the DECLARATION (host parser parity), so an UNUSED
        // `type D = D` still flags; the members stay empty (host: `Never`).
        if variants.length == 1 && variants[0] == sd.udName {
          tErr(
            "Type `" +
              sd.udName +
              "` is defined in terms of itself " +
              "with no base type, so it can never have a value",
            sx,
          )
        } else {
          let vi = 0
          let resolvedAny = false
          const declMemberIxs: i32[] = []
          // The surviving members, and the two lists the NICHE fold below needs:
          // every non-`null` survivor, and whether a `null` variant was among them.
          // Filled here instead of straight into `members` (the live arena array)
          // because the fold replaces the whole list with one wrapped member.
          const surviving: i32[] = []
          const nonNull: i32[] = []
          let sawNull = false
          while vi < variants.length {
            // D-UDVARTY: a union MEMBER is a parser spelling, banked on this
            // declaration node in member order by `setUdTs` — so resolve the
            // TREE, not the concatenated name. `annotResolve` is the shared
            // ladder (`tsToTy` when a root is present, `nameToTy` when it is
            // not), the same one every positioned annotation and the `is`
            // test already climb. Measured over the 1,314-file corpus swept
            // with `vl check --codegen`: 548 of 548 reads carry a root (0
            // misses), 547 rows answer on both sides with 224 distinct
            // rendered types per side, and the STRICT structural walk finds 0
            // disagreements — while `tyEq` finds 0 under a sabotage the strict
            // walk catches 547 times, which is why the walk is the comparator.
            const m = annotResolve(variants[vi], udTsRootAt(sx, vi))
            if m >= 0 {
              declMemberIxs.push(m)
              resolvedAny = true
              // A member that folds to `never` (an empty intersection —
              // `A & B` over disjoint operands) DROPS from the union
              // (`0 | (1 & !1)` is `0`); a declaration with NO surviving
              // member is the never-value HARD ERROR below (host PR #189:
              // errors at the declaration even when unused).
              if !isNeverTy(m) {
                surviving.push(m)
                if m == TY_NULL { sawNull = true } else { nonNull.push(m) }
              }
            } else {
              tErr(
                unknownTyText(variants[vi]) + " in union '" + sd.udName + "'",
                sx,
              )
            }
            vi = vi + 1
          }
          // The DECLARATION route's copy of `annUnionInnerTy`'s unseparable-member
          // rule: this loop builds its member list itself, so `type U = N | i32`
          // never reaches the shared annotation home. The union is still FILLED —
          // one diagnostic at the declaration is the whole report, and poisoning the
          // arena entry would turn every use into a second, worse message. Read off
          // the SURVIVOR list, which is what the members used to be: `TY_NULL` never
          // shares a nominal erasure with anything, so the answer is unchanged.
          const nwClash = nomUnionRepClashMsg(surviving)
          if nwClash.length > 0 {
            tErr(nwClash + " in union '" + sd.udName + "'", sx)
          }
          // THE `null` NICHE FOLD — an un-parenthesized `type T = X | null` denotes
          // `X?`, exactly as the inline annotation `X | null` and the parenthesized
          // declaration `type T = (X | null)` already do (`annUnionTy`, the shared
          // home). Without it the `null` stayed a SIBLING VARIANT of the alias's
          // union: two-member arity, so the members registered as variant boxes
          // (`cVariantMemberTyIxs`) and the wrapper stopped being the one-member
          // shape `singleAliasMemberTyIx` reads — while every consumer of the value
          // lowered the niche. The failure is `vl check` rc 0 and an INVALID MODULE for
          // an inner whose rep the niche folds into a sentinel, and a loud
          // narrow-first reject for one it does not, at every position, for the
          // spelling that names the type and not for the one that inlines it.
          //
          // The union WRAPPER stays — `cUserTypes[T]` is the index pass 0a minted and
          // forward references already hold, so the alias denotes `TyUnion[X?]`, which
          // is the parenthesized declaration's own arena shape, character for
          // character. A poisoned fold (`annUnionTy` -1, the unseparable pair the
          // clash diagnostic above just reported) keeps the raw survivor list, so that
          // report is still the whole report.
          //
          // UNGATED ON THE INNER, so this is `annUnionTy` — the SHARED ANNOTATION HOME —
          // and not a second copy of it. The niche is reachable through the alias for
          // every inner because `singleAliasMemberTyIx`'s nullable arm claims it for
          // every inner (`nulAliasMemberFaithful`): the checker resolves `T` to `X?`
          // and `collectU` SKIPS the alias's row, so `v is X` resolves against the
          // declared member instead of finding a variant row the param no longer
          // lowers as. While that arm was gated, an inner it declined kept a
          // capability on the two-member union that the niche did not have, and the
          // fold had to decline the same inners or the two disagreed — a declared
          // struct plus `v is S` ran on the union row and was `emitProgram: \`is\`
          // receiver is not a union value` on the niche.
          //
          // MEASURED, not reasoned, and the measurement is what rules out an inner gate
          // rather than an argument about which inners render faithfully. A 1,020-cell
          // twin grid — 15 inners × (8 positions + 9 uses) × {`(X | null)`,
          // `X | null`, `(X) | null`, the alias-free INLINE oracle}, every program run
          // at BOTH runtime inputs and graded against the analytically-known stdout —
          // reads, for each un-parenthesized spelling: **CORRECT 135 → 211 of 255**,
          // oracle parity **62/120 → 117/120** on positions and **69/135 → 135/135** on
          // uses, **0 silently-wrong cells before or after** (0 of 1,020), and the
          // parenthesized spelling and the oracle immobile in all 510 of theirs. Both
          // un-parenthesized spellings land on the parenthesized one's distribution
          // EXACTLY, and the emitted module is byte-identical across all four spellings
          // on 107/107 buildable use groups and 102/104 buildable position groups (the
          // two outliers are oracle-vs-parenthesized and predate the fold).
          //
          // THE RESIDUE IS 18 CELLS THAT LOSE A RUNNING PROGRAM, all of them the
          // NUMERIC LITUNION inner (`type KN = 1 | 2`), 9 axes × 2 spellings — and every
          // one lands on the INLINE spelling's OWN verdict, message for message
          // (`emitProgram: bare null needs a struct-typed context`, and
          // `emitProgram: \`is\` names a type that is not a union variant` for the `is`
          // axis). A numeric-litunion NICHE carries 6 of 17 axes where the two-member
          // union carried 15, so folding it is a pure loss ON THAT INNER — but gating it
          // back out is the WORSE trade and that is measured too: 220 correct against the
          // parenthesized spelling's 211, bought with parity 115/120 and 127/135, i.e. a
          // PARENTHESIZATION DIALECT in 10 of that inner's 17 axes. `type T = (KN | null)`
          // is already `KN?` on the transparency arm, so an inner gate here can only make
          // the two declaration spellings disagree, which is the defect this fold exists
          // to close. The hole is the emitter's numeric-litunion niche, loud at every
          // reach, and it is the inline spelling's hole first.
          //
          // A further 18 cells move from a loud check reject onto the inline spelling's
          // own CHECK-CLEAN-INVALID-WASM hole — a nested-nullable inner at six positions,
          // and a list / map / closure inner passed onward to a non-null parameter —
          // reaching the identical function, byte offset and validator message as the
          // alias-free twin. Loud, never a wrong answer, and filed against the emitter.
          //
          // `mkNullableTy` does not intern, so the wrap must happen exactly once, which
          // is what routing through `annUnionTy` (rather than its two halves) gives.
          let folded = -1
          if sawNull && nonNull.length > 0 {
            folded = annUnionTy(nonNull, true)
          }
          if folded >= 0 {
            members.push(folded)
          } else {
            let mi = 0
            while mi < surviving.length {
              members.push(surviving[mi])
              mi = mi + 1
            }
          }
          // Variant-member registration is ARITY-AWARE (Stage B b1, latent
          // irregularity (a) from the #920 shadow report): only a REAL
          // (2+ surviving member) union registers its members as variants.
          // The emitter lowers a single-member union as the member ITSELF
          // (a `{a} & {b}` struct alias, a transparent `type Id = i32`),
          // never as a variant box — the old arity-blind push made such a
          // member's index classify "variant" through the flat TyObj arm
          // while the union's own index classified "struct".
          if members.length >= 2 {
            let ri = 0
            while ri < declMemberIxs.length {
              cVariantMemberTyIxs.push(declMemberIxs[ri])
              ri = ri + 1
            }
          }
          // The 0a placeholder union was just FILLED in place (`members` is
          // its `uMembers` array) — an existing arena entry changed shape.
          tyMutEpoch = tyMutEpoch + 1
          if resolvedAny && members.length == 0 {
            // Explain the empty intersection in SOURCE terms (matching the TS
            // host): name the two operands and their kinds (`A & B`, an object
            // and a string literal), or call out a self-reference
            // (`type E = A & E`). Falls back to the generic wording for a
            // non-binary / non-intersection never (e.g. `type C = NeverAlias`).
            // D-UDNEVER: the intersection's OPERANDS are the kids of the
            // member's `TS_ISECT` spelling node. Read them; do not re-split the
            // name the parser concatenated. `splitTopAmp` — a depth-aware
            // top-level `&` scanner over a rendered type, `<>`-aware since
            // D-CLASSANG — had this as its ONLY call site and is deleted with it.
            //
            // Behaviour is preserved at the two gates that matter. `ops.length
            // == 2` selected a BINARY top-level intersection, and the kid count
            // of a `TS_ISECT` is exactly that count; a member with no top-level
            // `&` has a non-`TS_ISECT` root and yields 0 kids, where the old
            // scanner yielded the 1-element whole name — both miss `== 2` and
            // fall to the generic wording. A member with no recorded root does
            // the same. `tsToName` reproduces the spelling character for
            // character (it is what `driver.vl`'s module merge itself pushes
            // into `udVariants`), so `expr` and the self-reference NAME test are
            // unchanged.
            const opRoots: i32[] = []
            const ops: string[] = []
            const isectRoot = udTsRootAt(sx, 0)
            if isectRoot >= 0 {
              if tsKind[isectRoot] == TS_ISECT {
                const opStart = tsKidStart[isectRoot]
                let opk = 0
                while opk < tsKidCount[isectRoot] {
                  opRoots.push(tsKids[opStart + opk])
                  ops.push(tsToName(tsKids[opStart + opk]))
                  opk = opk + 1
                }
              }
            }
            let didDetail = false
            if variants.length == 1 && ops.length == 2 {
              const expr = ops[0] + " & " + ops[1]
              const selfRef = ops[0] == sd.udName || ops[1] == sd.udName
              if selfRef {
                tErr(
                  "Type `" +
                    sd.udName +
                    "` refers to itself inside an intersection (`" +
                    expr +
                    "`), so it reduces to `never`",
                  sx,
                )
              } else {
                tErr(
                  "Type `" +
                    sd.udName +
                    "` is `never` (an empty type — `" +
                    expr +
                    "`, " +
                    operandKind(tsToTy(opRoots[0])) +
                    " and " +
                    operandKind(tsToTy(opRoots[1])) +
                    ", have no common values), so it has no values",
                  sx,
                )
              }
              didDetail = true
            }
            if !didDetail {
              tErr(
                "Type `" +
                  sd.udName +
                  "` is `never` (an empty type — " +
                  "its operands have no common values), so it has no values",
                sx,
              )
            }
          }
        }
      }
    }
  }
  0
}

// Is the arena entry `declIx` already filled? Keyed by ARENA INDEX, not by name, so two
// declarations sharing one placeholder (a redeclaration) fill it exactly once. One
// bounds-checked read of the flag column; an index past its end is simply not yet marked.
function fillDone(declIx: i32) {
  if declIx < 0 || declIx >= cFillDoneAt.length { return false }
  cFillDoneAt[declIx] == 1
}

// Mark arena entry `declIx` filled, extending the flag column to cover it. The column only
// ever grows, so the extension costs O(highest arena index marked) across the whole pass.
function markFillDone(declIx: i32) {
  if declIx < 0 { return 0 }
  while cFillDoneAt.length <= declIx { cFillDoneAt.push(0) }
  cFillDoneAt[declIx] = 1
  0
}

// Fill declaration `name` NOW, when pass 0b is running and has not reached it. Inert
// outside pass 0b (`cFillActive`), which is what keeps every later re-resolution — pass
// 1/2, and the emitter's own name bridges — a plain lookup.
//
// The UNKNOWN-TYPE BANK is saved across the nested fill. This runs inside an enclosing
// `tsToTy` / `nameToTy` frame whose `unkTyPart` belongs to the annotation the caller is
// resolving; the nested fill raises its own diagnostics at its own declaration, so it
// gets a fresh outermost frame (`unkTyDepth = 0`) and hands the caller's bank back
// untouched. Sharing the bank would let a nested failure rename the caller's diagnostic.
function forceDeclFill(name: string) {
  if !cFillActive { return 0 }
  const sx = cFillStmtIx[name] ?? (-1)
  if sx < 0 { return 0 }
  const svDepth = unkTyDepth
  const svPart = unkTyPart
  const svClash = unkTyClash
  unkTyDepth = 0
  fillTypeDeclAt(sx)
  unkTyDepth = svDepth
  unkTyPart = svPart
  unkTyClash = svClash
  0
}

// The program root: pass 0 registers `type` declarations (structs, then unions over
// them), pass 1 hoists function signatures (call-before-decl + mutual recursion),
// pass 2 checks every top-level statement.
function checkProgramNode(n: Program) {
  const stmts = n.progStmts
  cStructTyIxs = []
  cStructNames = []
  cVariantMemberTyIxs = []
  cUnionTyIxs = []
  cUnionNames = []
  gaAppTyIxs = []
  gaAppHeads = []
  gaAppArgStart = []
  gaAppArgCount = []
  gaAppArgFlat = []
  gaAppFinite = []
  cPlainAliasNames = []
  cFillStmtIx = Map()
  cFillDoneAt = []
  cFillActive = false
  nwDeclNames = []
  nwTyIxs = []
  nwNames = []
  nwBaseTyIxs = []
  flNames = []
  flSizes = []
  flFStart = []
  flFCount = []
  flDeclNodes = []
  flFNames = []
  flFWidth = []
  flFNest = []
  flFOff = []
  cLitUnionCopyTyIxs = []
  cLitUnionCopyAliasIxs = []
  // Pass 0: register top-level struct `type` declarations BEFORE anything else, so
  // a struct name in a param/return/let annotation (pass 1/2) or in a later struct's
  // field resolves via `nameToTy`. Types register in source order, so a field may
  // reference an EARLIER struct; a forward reference to a later struct reports
  // "unknown type" (deferred).
  // Pass 0a: pre-register EVERY top-level `type` name with an EMPTY placeholder
  // (struct or union) so SELF- and FORWARD-references inside field annotations
  // and union variants resolve (host A11: a recursive alias is a lazy
  // self-referential leaf; here the placeholder's arrays are filled in pass 0b,
  // so the reference lands on the FINAL arena index — the arena shape is cyclic
  // for a recursive type, which `assignable`/`tyToStr` guard against).
  let t0 = 0
  while t0 < stmts.length {
    const sd0 = P.nodes[stmts[t0]]
    if sd0 is TypeDecl {
      // A GENERIC alias (`type Box<T> = …` — the parser folds the params into
      // the declared name "Box<T>") registers in the generic-alias registry,
      // NOT in `cUserTypes`: it has no concrete type until applied. Pass 0b
      // skips it (its `cUserTypes` lookup misses); each application resolves
      // its fields under the param→argument bindings (`applyGenAlias`).
      // NOMINAL NEWTYPE (P1.5): record the DECLARATION fact before anything
      // resolves. A generic newtype (`type Handle<T> = new …`) is not in this
      // phase — the generic-alias registry memo-keys applications by a
      // synthesized name and branding that is a separate design — so the marker
      // is only honoured on the concrete arm below.
      // D-DECLPARAM — THE PARSER'S OWN LIST, NOT A RE-PARSE OF THE NAME IT JOINED.
      // This was a `<`-scan (`gaeLtAt`) plus two cuts (`gaeHeadNameOf` /
      // `gaeArgsTextOf`) plus a top-level split, run over `tdName` — a string
      // `parseTypeDecl` had assembled by concatenating the very IDENT tokens
      // being recovered here. The parser banks the base and the list on the
      // declaration node (`ast.setDeclGp`), so this is two array reads.
      //
      // The GUARD moves with the data and stays exact: the bank exists iff the
      // parser consumed a `<` after the declared name, which is what `gLt > 0`
      // tested (index 0 is impossible — a declared name starts with an
      // identifier). A zero-parameter `type Box<> = …` banks a row with an empty
      // list, as `gaeArgsTextOf` + `tyTopLevelSplit` produced an empty list for it.
      //
      // The MODULE MERGE rewrites `tdName`'s base segment in place; the bank is
      // re-written in lockstep there (`driver.modRwStmt` → `setDeclGpBase`), the
      // same discipline `modRwType` keeps for a `TypeRef`'s spelling tree.
      const gBase = declGpBaseOf(stmts[t0])
      if gBase != "" {
        gaNames.push(gBase)
        gaDeclIxs.push(stmts[t0])
        // D-GAPARAM: the parameter list is banked ONCE, here, into the flat
        // column. Master re-split the joined string inside `applyGenAliasArgs`,
        // i.e. once per APPLICATION of the alias; the list is a property of the
        // DECLARATION and cannot change between applications.
        const gps = declGpParamsOf(stmts[t0])
        gaParamStart.push(gaParamNames.length)
        gaParamCount.push(gps.length)
        let gpi = 0
        while gpi < gps.length {
          gaParamNames.push(gps[gpi])
          gpi = gpi + 1
        }
      } else {
        // A bodyless alias (parser sentinel `tdFields == [-1]`) registers as the
        // error type — the parser already reported it, and the error type
        // suppresses use-site cascades. A real (possibly empty `{}`) body builds
        // an object placeholder that pass 0b fills.
        // The FILL registry entry, so a forward reference to this name can demand its
        // shape before pass 0b's walk reaches it. A GENERIC alias is deliberately absent
        // — it has no `cUserTypes` entry to fill, and each application resolves the body
        // itself under its own parameter bindings (`applyGenAlias`).
        cFillStmtIx[sd0.tdName] = stmts[t0]
        const df0 = sd0.tdFields
        const bodyless0 = df0.length == 1 && df0[0] == (-1)
        if bodyless0 {
          cUserTypes[sd0.tdName] = TY_ERR
          cUserTypesVer = cUserTypesVer + 1
        } else {
          const fnames0: string[] = []
          const ftys0: i32[] = []
          const sIx0 = mkObjTy(fnames0, ftys0)
          cUserTypes[sd0.tdName] = sIx0
          cUserTypesVer = cUserTypesVer + 1
          cStructTyIxs.push(sIx0)
          cStructNames.push(sd0.tdName)
          if sd0.tdNew == 1 { nwDeclNames.push(sd0.tdName) }
        }
      }
    } else if sd0 is UnionDecl {
      // A one-member alias whose body is a plain type REFERENCE (`type MyCat = Cat`,
      // `type Y = Box<i32>`) is TRANSPARENT — recorded here, in pass 0a, because the
      // decision is SYNTACTIC (the arena cannot tell it from a canonicalized `{a} & {b}`
      // intersection) and both readers run later. A self-cycle (`type D = D`) is excluded:
      // it is the degenerate never-type pass 0b reports on, and resolving it transparently
      // would chase its own placeholder.
      //
      // SYNTACTIC is now literal: the shape question goes to the member's SPELLING ROOT
      // (D-PARSETY P2's `udTsRootAt`), not to a re-scan of the member's rendered name. The
      // self-cycle exclusion stays a NAME compare — `type D = D` is about the identifier,
      // which is what `TS_NAME`'s text holds and what the declaration is keyed by.
      const uvs0 = sd0.udVariants
      if uvs0.length == 1 && uvs0[0] != sd0.udName {
        if aliasRefIsPlainRoot(udTsRootAt(stmts[t0], 0)) {
          cPlainAliasNames.push(sd0.udName)
        }
      }
      cFillStmtIx[sd0.udName] = stmts[t0]
      const members0: i32[] = []
      const uIx0 = mkUnionTy(members0)
      cUserTypes[sd0.udName] = uIx0
      cUserTypesVer = cUserTypesVer + 1
      cUnionTyIxs.push(uIx0)
      cUnionNames.push(sd0.udName)
      if sd0.udNew == 1 { nwDeclNames.push(sd0.udName) }
    }
    t0 = t0 + 1
  }
  // Pass 0b: resolve each declaration's fields/variants and fill them into the
  // placeholder, in DEMAND order rather than source order. The driver below still walks
  // source order, but `fillTypeDeclAt` is re-entered from `declaredTyOfName` whenever a
  // body names a declaration the walk has not reached, so a FORWARD reference resolves
  // against the filled shape and a field's arena type no longer depends on which
  // declaration came first. Nothing else in the language orders declarations, and the
  // spelling channel never did: `canonEmitTypeNames` runs after this pass and rewrote a
  // transparent alias to its member either way, so the two channels used to disagree.
  cFillDoneAt = []
  cFillActive = true
  let ti = 0
  while ti < stmts.length {
    fillTypeDeclAt(stmts[ti])
    ti = ti + 1
  }
  cFillActive = false
  // Pass 0c: MEASURE every `flat type` (webcraft P1.2). Runs here because it needs
  // pass 0b's resolved field types (a scalar's width is read off the arena, which
  // is what makes a newtype over a scalar work for free) and must precede any
  // expression checking, since `N.size` / `N.field` fold against this sidecar.
  resolveFlatLayouts(stmts)
  // Pass 1: hoist top-level function signatures so call-before-decl and mutual
  // recursion type-check.
  let hi = 0
  while hi < stmts.length {
    const s = P.nodes[stmts[hi]]
    if s is FuncDecl {
      // A SECOND top-level `function` of the same name is a redeclaration error,
      // exactly like a duplicate `let`/`const` (B16). Without this the later
      // hoist silently overwrites the earlier one and the last body wins.
      if (fnDeclIx[s.fnName] ?? -1) >= 0 {
        // `opDeclLabel` is the identity on an ordinary name; an index operator
        // reads back as `"[]" for F32View` rather than as its minted spelling.
        tErr("redeclared " + opDeclLabel(s.fnName), stmts[hi])
      }
      const hp = s.fnParams
      const hpt: i32[] = []
      let k = 0
      while k < hp.length {
        const hpn = P.nodes[hp[k]]
        let t = TY_ERR
        if hpn is Param {
          if hpn.parType >= 0 {
            const hptn = P.nodes[hpn.parType]
            if hptn is TypeRef {
              const r = resolveAnnotAt(hptn.tyName, s.fnTyParams, hpn.parType)
              if r >= 0 { t = r }
            }
          } else {
            // An un-annotated param hoists as its inference HOLE (the same
            // declaration+position name `checkFuncDeclNode` mints, so a
            // forward call site binds the identical hole by name) — or as the type
            // pass 1.8's solve pinned it to, which `unannotParamTy` decides for both
            // this hoist and the body so they cannot disagree. (Pass 1.8 runs AFTER
            // this hoist and patches the signature it builds here in place; the call
            // through `unannotParamTy` is what keeps a RE-hoist consistent.)
            t = unannotParamTy(paramHoleName(s.fnName, stmts[hi], k))
          }
        }
        hpt.push(t)
        k = k + 1
      }
      // An UN-ANNOTATED return hoists as the PENDING sentinel (-2): the real type
      // is inferred from the body in pass 2 (or on demand at a forward call site),
      // then PATCHED into this same TyFunc in place.
      let hret = -2
      if s.fnRet >= 0 {
        const hrtn = P.nodes[s.fnRet]
        if hrtn is TypeRef {
          const r = resolveAnnotAt(hrtn.tyName, s.fnTyParams, s.fnRet)
          if r >= 0 { hret = r } else { hret = TY_VOID }
        }
      }
      declare(s.fnName, mkFuncTy(hpt, hret))
      fnDeclIx[s.fnName] = stmts[hi]
      declareFnDeclNode(s.fnName, stmts[hi])
      // REGISTER a free index operator (B14). Its ARITY is fixed by the operator
      // — `"[]"` is (self, index), `"[]="` is (self, index, value) — and checking
      // it here means a malformed declaration is reported once, at itself, rather
      // than at every use site that fails to resolve.
      const opk = opDeclOpOf(s.fnName)
      if opk != "" {
        let want = 2
        if opk == OP_INDEX_SET { want = 3 }
        if hp.length != want {
          tErr(
            "operator " +
              opDeclLabel(s.fnName) +
              " takes " +
              i32ToStr(want) +
              " parameters (self, index" +
              opIdxArityTail(opk) +
              "), got " +
              i32ToStr(hp.length),
            stmts[hi],
          )
        } else {
          opIdxOps.push(opk)
          opIdxFns.push(s.fnName)
        }
      }
      // Collect un-annotated returns (hoisted as the `-2` pending sentinel) for the
      // return-inference pre-pass.
      if hret == (-2) { topUnannotFns.push(stmts[hi]) }
      // Completion visibility: a top-level function is global. Stamped here (only
      // the global scope is open) so it wins over any later demand-inference
      // re-entry, which would run the body from a deeper stack (see `symStampVis`).
      if symEnabled != 0 {
        symStampVis(s.fnName, stmts[hi], 2, scopeSL.length - 1)
      }
    }
    hi = hi + 1
  }
  // Pass 1.5: hoist top-level VALUE bindings (`let`/`const`) — names + types — so a
  // function body sees every module-level value regardless of source order, exactly
  // as pass 1 makes every top-level function visible. This makes the module scope
  // order-independent; the annotation a forward-referenced/demand-inferred function
  // used to NEED (so its body could resolve a later global) becomes genuinely
  // redundant.
  //
  // Initialization order still matters for STRAIGHT-LINE top-level code: each global
  // joins the definite-assignment dead-zone here (`daAdd`) and is marked assigned
  // only when pass 2 reaches its initializer, so reading one before its `let` is a
  // "used before initialization" (TDZ) error. A function body runs at CALL time, not
  // at the declaration site — `checkFuncDeclNode` clears the dead-zone for the body
  // (`daSnapshot`/`daClear`) — so a deferred read from inside a function is correctly
  // NOT flagged. The annotation type is registered now for forward references; pass 2
  // overwrites the binding with the final (identical, for annotated) type.
  let mi = 0
  while mi < stmts.length {
    const sm = P.nodes[stmts[mi]]
    if sm is LetDecl {
      if moduleGlobals[sm.letName] ?? false {
        // A genuine top-level redeclaration — reported here (pass 2 skips its own
        // redeclare check for module globals, since the hoist owns the declaration).
        tErr("redeclared " + sm.letName, stmts[mi])
      } else {
        let mty = TY_ERR
        if sm.letType >= 0 {
          const mtn = P.nodes[sm.letType]
          if mtn is TypeRef {
            const r = nameToTyAt(mtn.tyName, sm.letType)
            if r >= 0 { mty = r }
          }
        } else if sm.letInit >= 0 {
          // Un-annotated: peek ONLY at a LITERAL initializer — side-effect free. A
          // `checkNode` here would prematurely demand-infer callees and PATCH their
          // hoisted return types (corrupting the real pass-2 result), so a non-literal
          // init stays an error placeholder that pass 2 overwrites with its real type.
          // (A forward reference to an un-annotated NON-literal global is the one case
          // still order-dependent — it carries no manifest type to hoist.)
          const initN = P.nodes[sm.letInit]
          if initN is NumLit {
            if hasDot(initN.numText) { mty = TY_F64 }
            else if intLexemeFitsI32(initN.numText) { mty = TY_I32 }
            else { mty = TY_I64 }
          } else if initN is StrLit {
            mty = TY_STR
          } else if initN is CharLit {
            mty = TY_I32
          } else if initN is BoolLit {
            mty = TY_BOOL
          }
        }
        declare(sm.letName, mty)
        moduleGlobals[sm.letName] = true
        // TDZ: in the dead-zone until pass 2 reaches the initializer.
        daAdd(sm.letName)
      }
    }
    mi = mi + 1
  }
  // Pass 1.6: solve every un-annotated PARAMETER from its body's usage, BEFORE any
  // expression is checked — so a call site binds the solved parameter type whatever
  // the source order, and before pass 1.7 infers returns against it. See
  // `solvedParamTys`.
  let sp = 0
  while sp < stmts.length {
    const sps = P.nodes[stmts[sp]]
    if sps is FuncDecl { solveUnannotParams(stmts[sp]) }
    sp = sp + 1
  }
  // Pass 1.7: return-inference pre-pass — resolve every un-annotated return (cycles
  // included, via the binding-group fixpoint) BEFORE checking bodies, so pass 2 sees
  // final return types and a recursive function needs no return annotation.
  inferReturnsPrePass()
  // Pass 2: check every top-level statement (bodies included).
  let j = 0
  while j < stmts.length {
    checkNode(stmts[j])
    j = j + 1
  }
  // A function whose return never resolved (a genuinely base-case-less recursive
  // cycle) — the fixpoint found no concrete basis. Reported here, after the real
  // pass (the pre-pass suppressed it).
  let uf = 0
  while uf < unresolvedFns.length {
    const ufIx = fnDeclIx[unresolvedFns[uf]] ?? -1
    if ufIx >= 0 {
      const ufn = P.nodes[ufIx]
      if ufn is FuncDecl {
        tErr(
          "cannot infer a return type for '" +
            unresolvedFns[uf] +
            "' — annotate a return type",
          ufn.fnBody,
        )
      }
    }
    uf = uf + 1
  }
  TY_VOID
}

// ── the Node visitor (dispatch; per-kind helpers above take narrowed variants) ──
// `checkNode` dispatches EVERY node kind — expressions AND statements — and
// returns the node's type-arena index (statements yield `TY_VOID`). Every
// per-variant body is INLINED here, including the nested `TypeRef`/`Param`/`Block`
// narrowing, because no other function may narrow `Node` (Finding 2). It is the
// direct analogue of the parser_harness's single `walk`. On a type error it
// raises a diagnostic and returns `TY_ERR` so checking continues.
// Thin recording wrapper around the real per-variant checker: on the real (non-quiet)
// pass, store each node's resolved type-arena index into the typed-IR table. Recording the
// arena INDEX (not a snapshot) means a hole pinned later in place — an empty `[]` element
// fixed by a downstream `.push` — is reflected when the emitter reads it back. Last write
// wins, so a re-checked node settles on its final type.
// Wrap a match arm body as a Block (a bare-expression body becomes a one-statement block).
function matchBlockOf(bodyIx: i32) {
  const b = P.nodes[bodyIx]
  if b is Block { return bodyIx }
  const one: i32[] = []
  one.push(bodyIx)
  mkBlock(one, -1)
}

// The arm's block WITH its payload bindings (phase 2b) — `matchBlockOf` plus the clause's
// `const x = scrut.x` decls PREPENDED, which is the whole of the phase-2b lowering. The arm is
// already `if scrut is Move { <block> }`, so the result is node-for-node the hand-written
// `if cmd is Move { const x = cmd.x; … }` twin: no new chain, no new narrowing, no new emitter path.
//
// A Block body is rewritten IN PLACE (`P.nodes[bodyIx] = …`, the same arena overwrite
// `desugarMatchAt` ends with) rather than replaced by a fresh index: the body already carries a
// checked `nodeTyIx` row, and a new node minted here would read back -1 forever. A bare-expression
// body has no such row to preserve — it is wrapped, exactly as `matchBlockOf` wraps it today.
function matchArmBlockOf(bodyIx: i32, bindIx: i32) {
  if bindIx < 0 { return matchBlockOf(bodyIx) }
  const stmts: i32[] = []
  const bn = P.nodes[bindIx]
  if bn is Block {
    let i = 0
    while i < bn.blkStmts.length {
      stmts.push(bn.blkStmts[i])
      i = i + 1
    }
  }
  const b = P.nodes[bodyIx]
  if b is Block {
    let j = 0
    while j < b.blkStmts.length {
      stmts.push(b.blkStmts[j])
      j = j + 1
    }
    const spliced = mkBlock(stmts, b.pos)
    P.nodes[bodyIx] = P.nodes[spliced]
    return bodyIx
  }
  stmts.push(bodyIx)
  mkBlock(stmts, -1)
}

// `scrut == p0 [|| scrut == p1 …]` over match arm `k`'s OR-patterns.
//
// A TYPE pattern is ALREADY the test: the parser minted it as an `IsExpr` over this very
// scrutinee (`parseMatchPattern`), so the arm's condition is the pattern node itself and the
// chain the desugar builds is byte-for-byte the `if scrut is A { … } else if scrut is B { … }`
// a hand-written guard chain would have produced. That is what makes every arm — INCLUDING the
// one that becomes the bare `else` — narrow: the then-branches through `collectThenNarrows`'s
// `is` fact, the final else through `collectElseNarrows`'s union COMPLEMENT (`subtractTy`).
function matchArmCond(
  scrut: i32,
  pats: i32[],
  armStart: i32[],
  armCount: i32[],
  k: i32,
  pos: i32,
) {
  let cond = -1
  let pj = 0
  while pj < armCount[k] {
    const pat = pats[armStart[k] + pj]
    let term = -1
    const pn = P.nodes[pat]
    if pn is IsExpr {
      term = pat
    } else {
      term = mkBinary("==", scrut, pat, pos)
    }
    if cond < 0 { cond = term } else { cond = mkBinary("||", cond, term, pos) }
    pj = pj + 1
  }
  cond
}

// Arm `k`'s PAYLOAD-BINDING clause (phase 2b) — the `Block` of `const x = scrut.x` decls the
// parser banked on the arm's pattern — or -1 when it binds nothing. Reads pattern 0's column entry
// because only a SINGLE-pattern arm may carry a clause (`checkMatchTypeArms` rejects the rest,
// which is forced: a multi-pattern arm gets no then-narrowing, so the scrutinee is still the whole
// union inside it and the field read would not type). ONE rule, two readers — the checker declares
// what this returns, the desugar prepends it.
//
// A multi-pattern arm reads -1 rather than pattern 0's clause: the or-pattern reject
// (`matchArmHasBinds`, below) has already named the mistake, and CHECKING those decls would stack
// a second, misleading `field 'x' is not on every member of <the whole union>` on top of it.
function matchArmBindsOf(n: MatchExpr, k: i32) {
  if n.matchArmCount[k] != 1 { return -1 }
  n.matchBinds[n.matchArmStart[k]]
}

// Whether ANY of arm `k`'s patterns carries a clause — the or-pattern reject reads this, not
// `matchArmBindsOf`, so `A | B{x} => …` is caught as well as `A{x} | B => …`.
function matchArmHasBinds(n: MatchExpr, k: i32) {
  let j = 0
  while j < n.matchArmCount[k] {
    if n.matchBinds[n.matchArmStart[k] + j] >= 0 { return true }
    j = j + 1
  }
  false
}

// The arm that becomes the desugared chain's bare `else`: the `_` WILDCARD arm when there is
// one, otherwise the LAST arm (the match is exhaustive, so it is the only case left). Taken
// from the pattern columns rather than the node so the CHECKER can ask the same question
// before the desugar runs — `checkMatchTypeArms` checks each arm body under exactly the
// narrowing its branch in this chain will have, and a drift between the two rules would put an
// arm's body under the wrong narrowed type. ONE rule, two readers.
function matchElseArmOf(pats: i32[], armStart: i32[], armCount: i32[]) {
  const nArms = armStart.length
  let wildArm = -1
  let ai = 0
  while ai < nArms {
    let pj = 0
    while pj < armCount[ai] {
      const p = P.nodes[pats[armStart[ai] + pj]]
      if p is Ident { wildArm = ai }
      pj = pj + 1
    }
    ai = ai + 1
  }
  if wildArm >= 0 { return wildArm }
  nArms - 1
}

// Lower the checked, exhaustive `MatchExpr` at `ix` to an if/else chain, OVERWRITING the arena slot
// in place — so lint AND emit see only if-chains (no per-node `match` handling needed in either).
// The wildcard arm (or, if none, the LAST arm — exhaustive, the only case left) becomes the bare
// `else`. Runs in the REAL check pass only.
//
// A ZERO-arm `match` (`match k {}` — the parser accepts it) has no body to make that bare `else`,
// and the `bodies[elseArm]` read at `elseArm == -1` TRAPPED THE COMPILER ("out of bounds array
// access", no diagnostic, no position — reproducible on master over a literal union). The checker
// has already reported that match (non-exhaustive over a non-empty union), so its node is left
// alone: a type-erroring program never reaches emit, where a surviving `MatchExpr` would matter.
function desugarMatchAt(ix: i32) {
  const n = P.nodes[ix]
  if n is MatchExpr {
    const scrut = n.matchScrut
    const pats = n.matchPats
    const armStart = n.matchArmStart
    const armCount = n.matchArmCount
    const bodies = n.matchBodies
    const mpos = n.pos
    const nArms = armStart.length
    if nArms > 0 {
      const elseArm = matchElseArmOf(pats, armStart, armCount)
      let chain = matchArmBlockOf(bodies[elseArm], matchArmBindsOf(n, elseArm))
      let k = nArms - 1
      while k >= 0 {
        if k != elseArm {
          const cond = matchArmCond(scrut, pats, armStart, armCount, k, mpos)
          const thenB = matchArmBlockOf(bodies[k], matchArmBindsOf(n, k))
          chain = mkIf(cond, thenB, chain, mpos)
        }
        k = k - 1
      }
      P.nodes[ix] = P.nodes[chain]
    }
  }
  0
}

function checkNode(ix: i32) {
  const t = checkNodeReal(ix)
  if !inferQuiet {
    if ix >= 0 {
      if ix < nodeTyIx.length { nodeTyIx[ix] = t }
    }
  }
  t
}

function checkNodeReal(ix: i32) {
  if ix < 0 { return TY_ERR }
  const n = P.nodes[ix]

  // ── literals & identifiers ────────────────────────────────────────────────
  if n is NumLit {
    // A literal with a "." is f64. An integer literal defaults to the NARROWEST
    // type that holds it exactly — i32 if its magnitude fits, else i64 — the
    // host's `defaultIntegerType` rule (`intLexemeFitsI32`).
    if hasDot(n.numText) {
      // A literal whose magnitude rounds past the largest finite double names a
      // value f64 cannot represent — and VL has no infinity spelling to encode
      // it honestly, so it is an ERROR (silent ±inf would be a lossy implicit
      // conversion). The judgement is the ENCODER's own rounding
      // (`f64LitOverflows`), exact at the boundary. Runtime arithmetic still
      // yields ±inf per IEEE-754 — this rejects only literal text.
      if f64LitOverflows(n.numText) { tErr("float literal overflows f64", ix) }
      return TY_F64
    }
    if intLexemeFitsI32(n.numText) { return TY_I32 }
    return TY_I64
  } else if n is StrLit {
    return TY_STR
  } else if n is CharLit {
    // A char literal `'x'` is its i32 CODE POINT (composes with arithmetic / `==` /
    // string indexing exactly like a bare int literal), NOT a string.
    return TY_I32
  } else if n is BoolLit {
    return TY_BOOL
  } else if n is NullLit {
    return TY_NULL
  } else if n is Ident {
    const ty = lookup(n.identName)
    if ty < 0 {
      tErr("undeclared identifier '" + n.identName + "'", ix)
      return TY_ERR
    }
    if symEnabled != 0 { symUse(ix, n.identName) }
    // Definite-assignment read gate: a bare-name READ of a still-unassigned
    // binding is "used before assigned". The LHS of a plain `=` is a WRITE, not a
    // read (the `BinExpr` `=` arm marks it as `daWriteTarget` before evaluating
    // the target), so it is skipped here; a compound `x += …` desugars to
    // `x = x + (…)` whose RHS reads `x` and DOES reach this gate.
    if ix != daWriteTarget { daCheckRead(n.identName, ix) }
    return ty
  } else if n is Paren {
    return checkNode(n.parInner)
    // ── explicit numeric cast `x as T` ──────────────────────────────────────────
  } else if n is AsExpr {
    return checkCastNode(n, ix)
    // ── unary ─────────────────────────────────────────────────────────────────
  } else if n is Unary {
    return checkUnaryNode(n, ix)
  } else if n is BinExpr {
    return checkBinExprNode(n, ix)
  } else if n is Call {
    const callTy = checkCallNode(n, ix)
    // A call is where a path narrowing can be falsified by a write the guarded
    // scope never spells. Asked AFTER the arguments are checked so the call's own
    // operands still read under the narrowing that held when they were evaluated.
    noteCallInvalidations(ix)
    return callTy
    // ── member access ───────────────────────────────────────────────────────────
  } else if n is Member {
    return checkMemberNode(n, ix)
  } else if n is ArrayLit {
    return checkArrayLitNode(n, ix)
  } else if n is Index {
    return checkIndexNode(n, ix)
  } else if n is ObjLit {
    return checkObjLitNode(n, ix)
  } else if n is IsExpr {
    return checkIsExprNode(n, ix)
  } else if n is OptMember {
    return checkOptMemberNode(n, ix)
  } else if n is ErrExpr {
    return TY_ERR
    // ── let / const ─────────────────────────────────────────────────────────────
  } else if n is LetDecl {
    return checkLetDeclNode(n, ix)
  } else if n is FuncDecl {
    return checkFuncDeclNode(n, ix)
    // ── while ─────────────────────────────────────────────────────────────────
  } else if n is WhileStmt {
    return checkWhileStmtNode(n, ix)
    // Accepted unconditionally: valid only inside a loop, but loop-nesting is
    // not tracked yet (a misplaced `break`/`continue` is a parser concern).
  } else if n is BreakStmt {
    return TY_VOID
  } else if n is ContinueStmt {
    return TY_VOID
    // ── for v in A to B [step S] ────────────────────────────────────────────────
    // A numeric range loop: the bounds (and step, if present) must be i32; the loop
    // variable is i32 in the body's scope.
  } else if n is ForRange {
    return checkForRangeNode(n, ix)
  } else if n is ForIn {
    return checkForInNode(n, ix)
  } else if n is MatchExpr {
    return checkMatchExprNode(n, ix)
  } else if n is IfStmt {
    return checkIfStmtNode(n, ix)
  } else if n is RetStmt {
    return checkRetStmtNode(n, ix)
  } else if n is Block {
    return checkBlockNode(n, ix)
  } else if n is Program {
    return checkProgramNode(n)
  } else if n is Param {
    return TY_VOID
  } else if n is TypeRef {
    return TY_VOID
  } else if n is TypeDecl {
    // Registered by the Program pass-0 pre-pass; nothing to do when visited.
    return TY_VOID
  } else if n is UnionDecl {
    // Registered by the Program pass-0 pre-pass; nothing to do when visited.
    return TY_VOID
  } else if n is ImportDecl {
    // A tooling node (the lint tier reads it): import binding/resolution
    // happened in the module front end (the driver's token-level `modScan` +
    // merge), so the checker has nothing to verify here.
    return TY_VOID
  }
  TY_ERR
}

// Flatten a (possibly nested) union/nullable type into its leaf atom NAMES, pushing
// each into `out` ("null" for the nullable slot). joinTys can nest a nullable around a
// union (`mkNullableTy(mkUnionTy(...))`), so recurse; a scalar leaf renders no-space
// via tyToStr. Used to build the emitter-format `a|b|null` union name for an inferred
// return (the emitter's `splitUnionAtoms` splits on a bare `|`, NOT tyToStr's ` | `).
function collectRetAtoms(er: i32, out: string[]) {
  if er < 0 { return 0 }
  const t = T.tys[er]
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      collectRetAtoms(t.uMembers[i], out)
      i = i + 1
    }
  } else if t is TyNullable {
    collectRetAtoms(t.nInner, out)
    out.push("null")
  } else {
    out.push(tyToStructStr(er))
  }
  0
}

// The CANONICAL emitter NAME (`{f:boolean|{w:i32}}`, `{f:i64|string}`) for an inferred return
// `er` IF it is a bare STRUCT whose every field is emit-nameable AND at least one field is a
// UNION or NULLABLE (a boxed / niche field slot), else "". A struct whose composite field a
// closure result BODY literal built from bare-scalar/struct literals does NOT naturally box —
// the lambda self-infers the plain field shape — so the value call mis-recovered the boxed field
// (a MISMATCH: `t0(1).f is boolean` read the wrong tag; or INVALID-WASM: an i64 field read where
// an i32 was stored). `synthRetAnnots` pins the lambda's `fnRet` to this canonical name so its
// `$fnsig` result is the union-FIELD struct and `emitReturnValue` boxes the body ObjLit, exactly
// as the annotated `: {f: …}` named-function form lowers. Canonical (`tyToEmitName`), spaceless —
// the `structIndexByName` / `internShapeDeep` key (`tyToStr`'s spaced render would not resolve).
// The struct-field dual of `valueUnionRetName` / `mapUnionRetName`.
function structFieldBoxRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if !(t is TyObj) { return "" }
  let hasBox = false
  let i = 0
  while i < t.objFieldTypes.length {
    const ft = T.tys[t.objFieldTypes[i]]
    if ft is TyUnion {
      // Every member must be a SCALAR / string-literal / OBJECT (a boxable value or struct-mixed
      // union — `i64 | string`, `boolean | {w: i32}`). A CLOSURE / MAP / LIST / nullable member is
      // NOT lowerable as a boxed struct-field slot (`((i32) => K0) | f64`, `{[string]: V} | X`) — the
      // annotated form itself rejects those, so pinning would turn a working shape into a NEW loud
      // reject. Decline the whole struct then (its unlowerable shape stays a clean reject, unchanged).
      let m = 0
      let uClo = 0
      let uObj = 0
      while m < ft.uMembers.length {
        const mt = T.tys[ft.uMembers[m]]
        if mt is TyObj { uObj = uObj + 1 }
        if !(mt is TyPrim) && !(mt is TyLit) && !(mt is TyObj) {
          // A LITUNION-ALIAS member kept NESTED in the arena (`K0 | boolean` = TyUnion
          // [TyUnion[lits], bool] — `tyToStr` flattens it for display, the entry does
          // not): it rides the box as the i32 atom / string ref, `tyToEmitName` renders
          // the alias (`K0`), and the annotated spelling lowers — admit it. Without
          // this the whole struct declined, the closure-field lambda recorded the
          // SPACED self render instead of the canonical pin, and its `$fnsig` result
          // kept the twin plain row while the value call keyed the boxed-field struct
          // — INVALID-WASM (fuzz sweep3 declared leg, seed 128787380 case_00189).
          if mt is TyFunc {
            // ONE closure member beside a STRUCT sibling (`(() => i64) | {w: i32}`):
            // the #965 variant-box admission — the closure rides the box anyref as the
            // kind-11 ref atom and the annotated spelling lowers. Un-admitted, the
            // whole struct declined, no pin fired, and the outer literal of a
            // `{f: {f: (() => i64) | {w: i32}}}` lambda return fieldset-collided onto
            // the inner `{f: <box>}` twin row — INVALID-WASM (fuzz sweep5 plain leg,
            // seed 685652043 case_00146). ONE closure member: a second is DECLINED here
            // conservatively, not because the box cannot hold it — a bare closure arm tags
            // on its interned signature slot (`cloSigSlotTag`), so two of them are
            // discriminable — but because this inferred-return naming path has never been
            // measured on that shape (mirrors `variantBoxUnionRetName`).
            uClo = uClo + 1
            if uClo > 1 { return "" }
          } else if mt is TyMap {
            // A MAP member (`{[string]: {a, f, z}} | i32` field): rides the box tagged
            // by `mapSlotTag` (the #865/#868 map-union rep) and the annotated spelling
            // of such a field lowers fully. Un-admitted, the whole struct declined, the
            // lambda recorded only the SPACED self render (which the canonical-only pin
            // arms reject), stayed un-pinned, and its inferred-return struct resolution
            // fieldset-collided onto the map's own VALUE row — the `$fnsig` interned
            // `>s0;` while the value call keyed `>s1;`: a loud "no interned signature"
            // (fuzz post-#990 sweep plain leg, seed 40814368 case_00383). Require the
            // canonical render to succeed (the vbUnionMemberName map-admission twin).
            if !tyIsEmitRepresentable(ft.uMembers[m]) { return "" }
          } else if !tyIsLitUnion(ft.uMembers[m]) {
            return ""
          }
        }
        m = m + 1
      }
      if uClo > 0 && uObj == 0 { return "" }
      hasBox = true
    } else if ft is TyNullable {
      // A NULLABLE struct field (`{f: f64 | null}`, `{f: S | null}`) — a niche slot the
      // ANNOTATED form already lowers. Record it as box-bearing (so the pin fires) when the
      // inner is a prim/literal/object; an unlowerable inner (closure/map/list) declines the
      // whole struct as before. The old blanket decline left the lambda UN-pinned — for a
      // shape whose outer and nested structs share a field-name set (`{a: f32, f: {a: f64,
      // f: {f: f64 | null}}}`), the un-pinned return resolution collapsed onto the WRONG
      // same-name-set struct and emitted the outer f32 field as f64 — INVALID-WASM (fuzz
      // seed 103465585 d6). Pinned, the lambda takes the annotated-form path (proven).
      const nin = T.tys[ft.nInner]
      if !(nin is TyPrim) && !(nin is TyLit) && !(nin is TyObj) {
        // A NULLABLE STRUCT-ELEMENT LIST field (`{f: {f: string}[] | null}` — the
        // code-28 nul-ref-list slot the annotated form already lowers): admit it so
        // the lambda pins to the canonical render. Declined, the recorder kept the
        // `?`-spelled `tyToStr` shape no pin arm matches — the un-pinned body
        // literal then resolved the OUTER `{f: …}` onto the same-field-name INNER
        // `{f: string}` row and built one level short: INVALID-WASM (fuzz sweep3
        // branching leg, seed 46882632 case_00050). Other inners (closure / map /
        // scalar-backed lists) keep the decline — their nullable field slots are
        // not all lowerable, and an unsupported shape must stay a loud reject.
        let nulListOk = false
        if nin is TyArray {
          if nin.aElem >= 0 {
            const nel = T.tys[nin.aElem]
            if nel is TyObj { nulListOk = true }
          }
        }
        if !nulListOk { return "" }
      }
      hasBox = true
    } else if ft is TyObj {
      // A NESTED struct field (`{f: {f: i32 | string}}`): the boxed slot may sit one level
      // down — RECURSE so the pin fires for a lambda whose NESTED literal field adopted a
      // union-field shape (`objLitWidenFields`' descent). Without it the lambda's `$fnsig`
      // kept the self-inferred plain layout while the value call keyed the boxed-field
      // struct — INVALID-WASM (fuzz-nightly run 29808029476, seed 78530533 d5,
      // `(i32) => {f: {f: i32 | string}}`). A nested shape with no box contributes
      // nothing (the "" is a plain no-box, not a decline — its own unlowerable unions
      // still fail loudly at the field-coding gate).
      if structFieldBoxRetName(t.objFieldTypes[i]) != "" { hasBox = true }
    }
    i = i + 1
  }
  if !hasBox { return "" }
  irRendered(tyToEmitName(er))
}

// The CANONICAL emitter NAME (`{a:string,f:{f:{[string]:{f:i64}}},z:f32}`) for an inferred
// return `er` IF it is a bare STRUCT carrying a MAP field anywhere in its (recursively
// nested-struct) field tree, else "". A map-carrying struct a lambda BODY literal builds
// has NO field-set anchor for its nested literals — the un-pinned inner `{f: h0}` resolved
// by first-field-name-set match to the map's own VALUE struct `{f: i64}` (interned first),
// the map ref took the i64 field widen, and the outer literal minted a WRONG-layout twin
// row beside the annotation's — INVALID-WASM (`i64.extend_i32_s` on a map ref; fuzz-nightly
// run 29893544685, seed 184510897 d6, `() => {a: string, f: {f: {[string]: {f: i64}}},
// z: f32}`). `synthRetAnnots` pins the lambda's `fnRet` to this canonical name so the body
// ObjLit threads the SAME per-field struct indices the annotated named-function spelling
// (which lowers already) seeds. Canonical (`tyToEmitName`), spaceless — the
// `structIndexByName` / `internShapeDeep` key. The map-field sibling of
// `structFieldBoxRetName`; checked AFTER it in the recorder (a boxed-field struct keeps
// its own pin).
function structMapFieldRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if !(t is TyObj) { return "" }
  if !tyObjHasMapField(er) { return "" }
  irRendered(tyToEmitName(er))
}

// True if struct-arena entry `er` (a `TyObj`) carries a `TyMap` field directly or inside a
// nested `TyObj` field (any depth). The `structMapFieldRetName` gate.
function tyObjHasMapField(er: i32) {
  const t = T.tys[er]
  if t is TyObj {
    let i = 0
    while i < t.objFieldTypes.length {
      const ft = T.tys[t.objFieldTypes[i]]
      if ft is TyMap { return true }
      if ft is TyObj {
        if tyObjHasMapField(t.objFieldTypes[i]) { return true }
      }
      i = i + 1
    }
  }
  false
}

// The CANONICAL emitter NAME (`{f:{f:f64}|boolean}[]`) for an inferred return `er` IF it is a
// LIST whose ELEMENT is a `structFieldBoxRetName` struct (a struct with a boxed union/nullable
// field slot), else "". The element-list sibling of `structFieldBoxRetName`: a closure-result
// array literal of such structs self-infers the plain element shape (`{f:{f:f64}}[]` — no box),
// so un-pinned the binding's element rep and the annotation-side consumer keyed DIFFERENT
// layouts — INVALID-WASM at the element construct (`expected i32, found ref`; fuzz-nightly run
// 29874629450, seed 214588500 d6, `() => {f: {f: f64} | boolean}[]`). `synthRetAnnots` pins the
// lambda's `fnRet` to this name so the body array literal builds boxed-field elements exactly
// as the annotated `(): {f:…|boolean}[]` spelling (which lowers already) does.
function structFieldBoxElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if !(t is TyArray) { return "" }
  if t.aElem < 0 { return "" }
  if structFieldBoxRetName(t.aElem) == "" { return "" }
  irRendered(tyToEmitName(er))
}

// True when every LEAF atom of the (possibly nested) union/nullable type `er` renders
// to a SHORT name `valueAtomKind` could admit — a prim/literal/type-var leaf, or a
// prim-element list (`i32[]`). A composite leaf (struct, map, closure, negation,
// nested list) always renders to a `-1`-kind atom, so the whole union declines and the
// render was wasted — and for a RECURSIVE struct the waste is CATASTROPHIC: `tyToStr`
// expands `{child: S | null, kids: S[]}` DOUBLY per depth level (≈4–6 K chars at the
// depth-8 cap), and `splitUnionAtoms`'s per-atom accumulation walks that name again —
// re-run per narrowing consult of one `const p = f()` binding of type `S | null`, this
// took ~14 s of compile for a 30-line program (#912's fuzzgen: 66 s vs master's 4.5 s).
// The gate decides structurally, BEFORE `collectRetAtoms` renders anything. (The same
// pre-gate shape as `nodeUnionName`'s allValue scan — the third recurrence of the
// render-before-checking quadratic class; see also #494.)
function retAtomsCheap(er: i32) {
  if er < 0 { return true }
  const t = T.tys[er]
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if !retAtomsCheap(t.uMembers[i]) { return false }
      i = i + 1
    }
    return true
  }
  if t is TyNullable { return retAtomsCheap(t.nInner) }
  if t is TyPrim { return true }
  if t is TyLit { return true }
  if t is TyVar { return true }
  if t is TyErr { return true }
  if t is TyArray {
    // Only a prim-element list renders short AND can classify (`i32[]`, `string[]`);
    // a composite-element list (`S[]`, `i32[][]`) renders big and always declines.
    if t.aElem < 0 { return true }
    const et = T.tys[t.aElem]
    return et is TyPrim
  }
  false
}

// The value-atom KIND of one LEAF of an inferred return type — the structural dual of
// `valueAtomKind(tyToStr(leaf))`, read off the arena instead of a rendering. Only two
// leaf shapes can classify: a PRIMITIVE (whose `primName` is the primitive's own
// identity, not a rendering of a structure) and a PRIM-ELEMENT LIST (the emitter's list
// atoms). Every other leaf renders to a name `valueAtomKind` rejects — a struct/map/
// closure shape, a quoted literal, `<error>`, `any` — so it is -1 here.
function retAtomKindOf(er: i32) {
  if er < 0 { return -1 }
  const t = T.tys[er]
  if t is TyPrim { return valueAtomKind(t.primName) }
  if t is TyArray {
    if t.aElem < 0 { return -1 }
    const et = T.tys[t.aElem]
    if et is TyPrim {
      const en = et.primName
      // `i32[]` / `boolean[]` are matched by exact name AHEAD of `valueAtomKind`'s
      // litunion-array arm; the other list atoms sit BEHIND it, so a declared litunion
      // alias spelled like a primitive would claim them — ask the same question here.
      if en == "i32" || en == "boolean" { return 7 }
      if nameIsLitUnionType(en) { return 7 }
      if en == "f64" { return 8 }
      if en == "string" { return 9 }
      if en == "i64" { return 10 }
      if en == "f32" { return 12 }
    }
    return -1
  }
  if t is TyVar {
    // An inference hole renders `any` — never an atom; a declared type param carries its
    // own source name, which classifies exactly as the rendered atom would.
    if t.tvName.length > 0 {
      if t.tvName[0] == '?' { return -1 }
    }
    return valueAtomKind(t.tvName)
  }
  -1
}

// Push the value-atom KIND of every leaf of `er`, in `collectRetAtoms` order — `6` (the
// `null` atom) for a nullable slot. The kind-valued dual of `collectRetAtoms`: same walk,
// same order, no strings built.
function collectRetAtomKinds(er: i32, out: i32[]) {
  if er < 0 { return 0 }
  const t = T.tys[er]
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      collectRetAtomKinds(t.uMembers[i], out)
      i = i + 1
    }
  } else if t is TyNullable {
    collectRetAtomKinds(t.nInner, out)
    out.push(6)
  } else {
    out.push(retAtomKindOf(er))
  }
  0
}

// ── the print gate's boxing question, with the literal SOFTENING applied ──────
// The value-atom kind of one leaf FOR THE PRINT GATE: `retAtomKindOf`, plus the LITERAL
// arm it deliberately does not have. A literal member softens to its BASE SCALAR in the
// name the emitter keys on (`canonEmitName`: `"ab" | i32` canons to `string|i32`, and the
// emitter BOXES that), so a classifier that answers -1 for a literal says "not boxed"
// about a union the emitter does box.
//
// `retAtomKindOf` itself must NOT learn this arm, and the reason is measured, not
// theorised: it also feeds `valueUnionRetName`, whose NAME has to keep a litunion ALIAS
// arm UN-softened — `K0 | i64` registers with the alias atom, and softening it to
// `string|i64` mis-reps the closure-result box. Exactly one corpus entry proves it
// (`closures/closure-result-litunion-arm-union.vl`, which goes to `type mismatch:
// expected i64, found (ref $type)`). Hence a separate walk rather than one shared arm.
function printAtomKindOf(er: i32) {
  if er < 0 { return -1 }
  const t = T.tys[er]
  if t is TyLit { return retAtomKindOf(litBaseTy(t)) }
  retAtomKindOf(er)
}

// Push the print-gate kind of every leaf of `er`, in `collectRetAtomKinds` order, with
// the SCALAR-PRIM dedup `canonEmitName` performs on the softened name — `"a" | string`
// is ONE atom (both soften to `string`, so it is not boxed and still prints), `"a" | 1`
// is TWO (`string|i32`, boxed). Only kinds 0-5 dedup: each scalar-prim NAME maps to
// exactly one of those codes, so two distinct literal-free scalar members can never
// collide, whereas the LIST kinds deliberately share one code (7 backs `i32[]`,
// `boolean[]` and a litunion array at once) and collapsing there would fold a genuine
// two-arm union into one.
function collectPrintAtomKinds(er: i32, out: i32[]) {
  if er < 0 { return 0 }
  const t = T.tys[er]
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      collectPrintAtomKinds(t.uMembers[i], out)
      i = i + 1
    }
  } else if t is TyNullable {
    collectPrintAtomKinds(t.nInner, out)
    out.push(6)
  } else {
    const k = printAtomKindOf(er)
    if k >= 0 && k <= 5 {
      let j = 0
      while j < out.length {
        if out[j] == k { return 0 }
        j = j + 1
      }
    }
    out.push(k)
  }
  0
}

// Scratch for the print-gate leaf scan — module level like `vuAtomKinds`, drained by its
// only consumer.
const pgAtomKinds: i32[] = []

// Whether `print(x)` would be handed the emitter's BOXED value-union rep (`uBoxIdx`),
// which `print` cannot lower — the gate `checkNode`'s `print` builtin arm raises on.
//
// STRICTLY WIDER than `valueUnionRetName(pt) != ""`, the test this replaces, and only on
// literal-bearing unions: with no literal leaf the softening and the dedup are both
// no-ops (no two distinct scalar prims share a kind), so every union that gate claimed is
// still claimed. The unions it ADDS are the ones whose members the emitter softens —
// `"ab" | i32`, `"a" | 1`, `K0 | i32`, `1 | null` — every one of which built a module that
// failed to parse as WebAssembly while its already-softened sibling (`string | i32`) got a
// clean diagnostic. Asking the kind walk directly also drops the name build: the gate
// never wanted the NAME, only the verdict.
function tyPrintsAsUnionBox(pt: i32) {
  if pt < 0 { return false }
  // Decline a union with any composite leaf WITHOUT rendering it, exactly as
  // `valueUnionRetName` does — the render of a recursive struct leaf is exponential.
  if !retAtomsCheap(pt) { return false }
  collectPrintAtomKinds(pt, pgAtomKinds)
  const ok = valueUnionFromAtomKinds(pgAtomKinds)
  while pgAtomKinds.length > 0 { pgAtomKinds.pop() }
  ok
}

// Whether `print(x)` would be handed a WasmGC REFERENCE the scalar print imports cannot
// take. `print` renders ONE scalar/string rep (the union gate above says the same thing
// about a box); the emitter's print ladder is a run of POSITIVE tests ending in an
// unguarded `call __print_i32__`, so every value whose rep is a reference — an array, a
// struct, a map/set, a function value, a union carrying one of those, and any of them
// behind `| null` — was handed to an `(i32) -> ()` import with a `(ref $t)` on the stack.
// The module then failed to VALIDATE ("expected i32, found (ref $type)") while `vl check`
// reported the program clean. `driver.builtinScan` publishes `print`'s accepted set as
// `(i32 | i64 | f32 | f64 | boolean | string) -> void`; this is the gate that makes that
// string true.
//
// `string` is deliberately NOT here: it is a reference too, but the ladder routes it to
// the string streaming printer. Nor is a LITERAL union (i32/string atoms widened to their
// member text), nor a `TyVar` (a generic body's `T` — monomorphization decides its rep at
// the call site, and the concrete argument is gated there).
//
// Depth-bounded like `tyReachesUnion`: a self-referential alias reached through a union or
// nullable member would otherwise not terminate.
function tyPrintsAsRef(pt: i32, depth: i32) {
  if pt < 0 { return false }
  if depth <= 0 { return false }
  const t = T.tys[pt]
  if t is TyArray { return true }
  if t is TyObj { return true }
  if t is TyMap { return true }
  if t is TyFunc { return true }
  if t is TyNullable { return tyPrintsAsRef(t.nInner, depth - 1) }
  if t is TyUnion {
    const ms = t.uMembers
    let i = 0
    while i < ms.length {
      if tyPrintsAsRef(ms[i], depth - 1) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// `isValueUnionName`'s verdict over an already-classified atom-kind sequence: 2+ atoms,
// every atom a value atom, and either 2+ non-null atoms or exactly one NUMERIC scalar
// beside `null` (a boolean/ref + null stays a niche, not a box).
function valueUnionFromAtomKinds(kinds: i32[]) {
  if kinds.length < 2 { return false }
  let nonNull = 0
  let hasNull = false
  let soloKind = -1
  let i = 0
  while i < kinds.length {
    const k = kinds[i]
    if k < 0 { return false }
    if k == 6 {
      hasNull = true
    } else {
      nonNull = nonNull + 1
      soloKind = k
    }
    i = i + 1
  }
  if nonNull >= 2 { return true }
  if nonNull == 1 && hasNull {
    return soloKind == 0 || soloKind == 3 || soloKind == 4 || soloKind == 5
  }
  false
}

// Scratch for the leaf-kind scan — module level (like `tyEqAStack`) so the checker's
// hottest decline path allocates nothing; drained by its only consumer.
const vuAtomKinds: i32[] = []

// Whether the inferred return `er` IS a value union the emitter boxes — the structural
// dual of `isValueUnionName(<er's joined atom render>)`, decided from the arena BEFORE
// anything is rendered. The join is transparent: under `retAtomsCheap` every admitted
// leaf renders to a single top-level atom (no `|`, no `=>`, balanced groupers), so the
// name's `splitUnionAtoms` atoms are exactly this walk's leaves, in this order.
function tyIsValueUnion(er: i32) {
  collectRetAtomKinds(er, vuAtomKinds)
  const ok = valueUnionFromAtomKinds(vuAtomKinds)
  while vuAtomKinds.length > 0 { vuAtomKinds.pop() }
  ok
}

// The emitter-format union NAME (`i32|string`, `i32|null`) for an inferred return type
// `er` IF it is a VALUE union the emitter can box (the `uBoxIdx` rep: ≥2 non-null value
// atoms, or one numeric scalar + null — the same gate the annotated path uses), else "".
// This is what lets an UN-annotated union/nullable return lower: the name drives
// `registerValueUnionName` (type interning), the `"union"` return kind (the result
// valtype), and `emitUnionCoerce` at the return site — exactly the annotated path.
//
// The VERDICT is `tyIsValueUnion`'s, read off the arena; the name is built only for the
// unions that ARE value unions, as the key those emitter tables want. Deciding from the
// built name instead (`isValueUnionName`) renders, joins and re-splits the atoms of every
// non-union inferred return too — the overwhelming majority of the calls, and the
// compiler's single largest string cost.
function valueUnionRetName(er: i32) {
  if er < 0 { return "" }
  // Decline a union with any composite leaf WITHOUT rendering it (`retAtomsCheap`) —
  // its atom cannot classify anyway, and the render of a recursive struct leaf is
  // exponential in the `tyToStr` depth cap.
  if !retAtomsCheap(er) { return "" }
  if !tyIsValueUnion(er) { return "" }
  const atoms: string[] = []
  collectRetAtoms(er, atoms)
  let nm = ""
  let i = 0
  while i < atoms.length {
    if i > 0 { nm = nm + "|" }
    nm = nm + atoms[i]
    i = i + 1
  }
  // One atom per LEAF, exactly: `tyIsValueUnion`'s own invariant is that under
  // `retAtomsCheap` every admitted leaf renders to a single top-level atom (no `|`, no
  // `=>`, balanced groupers), so the join's width is the leaf count. (#1115.)
  irAtoms(nm, atoms.length)
}

// Whether union `er` has a LITUNION-ARRAY member (`K0[]`, `("a"|"b")[]`) — the arm
// `litUnionArrayValueUnionRetName` exists for, decided from the arena instead of from
// `litUnionArrayElemOf` over a rendered member name.
function tyUnionHasLitUnionArrayMember(er: i32) {
  if er < 0 { return false }
  const t = T.tys[er]
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      const m = T.tys[t.uMembers[i]]
      if m is TyArray {
        if tyIsLitUnion(m.aElem) { return true }
      }
      i = i + 1
    }
  }
  false
}

// The emitter-format union NAME (`K0[]|i64`) for an inferred return `er` that is a VALUE
// union with a LITUNION-ARRAY arm (`K0[]`) and a scalar sibling — the litunion-array + scalar
// case `valueUnionRetName` DECLINES: `collectRetAtoms` renders the array member with `tyToStr`,
// which FLATTENS the litunion element (`"84"|"trl"|"bf"[]`), so `splitUnionAtoms` fractures the
// atoms and `isValueUnionName` rejects. But `K0[]` IS a value atom (kind 7 — it shares the i32
// list backing, `valueAtomKind`/`litUnionArrayElemOf`), so the union boxes exactly like
// `i32[] | i64`. Render each member with `tyToEmitName` (alias-preserving — `K0[]` stays `K0[]`),
// require ≥1 litunion-array member (else `valueUnionRetName` already owns the pure-scalar union),
// and confirm the joined name is a value-union name. The annotated named-function spelling
// (`mk(q0: i32): K0[] | i64`) already interns `>u` and lowers this box soundly (both arms
// round-trip through `is`), so `synthRetAnnots`'s `isValueUnionName` pin routes the anonymous
// lambda through the SAME box. The litunion-array dual of `valueUnionRetName`.
function litUnionArrayValueUnionRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if !(t is TyUnion) { return "" }
  const members = t.uMembers
  if members.length < 2 { return "" }
  // No litunion-array member, no name to build: decline from the arena before the
  // per-member `tyToEmitName` renders. (A PRE-decline only — the rendered `hasLitArr`
  // below stays the verdict, since the atom-level dual of `tyToEmitName`'s
  // alias-preserving grammar is a separate piece of design from `retAtomKindOf`'s.)
  if !tyUnionHasLitUnionArrayMember(er) { return "" }
  let hasLitArr = false
  let name = ""
  // A member RENDER can itself be wider than one atom (`tyToEmitName`'s nullable arm
  // spells `X|null`), so the join's width is the SUM of the members' reported widths, not
  // the member count — method note 23's trap, avoided by accumulating (#1115).
  let psum = 0
  let i = 0
  while i < members.length {
    const mn = tyToEmitName(members[i])
    const mw = emitNameAtoms
    if mn == "" { return "" }
    if litUnionArrayElemOf(mn) != "" { hasLitArr = true }
    if i > 0 { name = name + "|" }
    name = name + mn
    psum = psum + mw
    i = i + 1
  }
  if !hasLitArr { return "" }
  if isValueUnionName(name) { return irAtoms(name, psum) }
  ""
}

// `nominalNameOfObj` keyed on an ARENA INDEX and rooted at the program's own statement
// list — the reverse map read from the EMITTER (`isVariantSpelling`), where `gRootStmts`
// is not in scope and the caller holds a type rather than a member list.
//
// THE DISTINCTION FROM `structNameOfTy`, which looks like the same question and is not:
// that one matches by arena-index IDENTITY (`cStructTyIxs[i] == ty`), so it answers "" for
// an INLINE shape that merely EQUALS a declared struct — `{meow: i32}` written in an `is`
// test interns its own arena entry. This one matches by bidirectional `assignable`, which
// is the equality the emitter's variant tables were built under (`structUnionRetName`
// spells an inferred union's members with exactly this call). Measured, not assumed: the
// index-identity version left `is {meow: i32}` unresolved at both of its gates.
export function nominalStructNameOfTy(ty: i32): string {
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyObj { return nominalNameOfObj(ty, gRootStmts) }
  ""
}

// The user-type NAME whose declared shape structurally equals object type `obj`, found
// by scanning the program's `TypeDecl`s (`cUserTypes` is a `Map` the compiler subset
// cannot iterate). Structural equality is bidirectional assignability — so a 1-field
// `{meow}` does NOT match a 2-field `Cat = {meow, foo}` (the missing field breaks one
// direction). "" if no named type matches.
function nominalNameOfObj(obj: i32, stmts: i32[]) {
  let i = 0
  while i < stmts.length {
    const s = P.nodes[stmts[i]]
    if s is TypeDecl {
      const nm = s.tdName
      if cUserTypes.has(nm) {
        const ti = cUserTypes[nm] ?? (-1)
        if ti >= 0 {
          const tt = T.tys[ti]
          if tt is TyObj {
            if assignable(obj, ti) && assignable(ti, obj) { return nm }
          }
        }
      }
    }
    i = i + 1
  }
  ""
}

// The emitter-format NAME of an inferred STRUCT-union return `er` — `Cat|Dog`, each
// member reverse-mapped (`nominalNameOfObj`) to the user-type name whose shape it
// equals. The emitter's union machinery is keyed on these NOMINAL names — the structural
// `{meow: i32}` render `tyToStr` produces does NOT resolve through `registerInlineUnion`
// / `structIndexByName`, so the reverse map is required. "" unless `er` is an all-object
// union of ≥2 members AND every member resolves to a named type (else it declines, so the
// emitter never sees an unregisterable name).
function structUnionRetName(er: i32, stmts: i32[]) {
  if er < 0 { return "" }
  if !isStructUnionTy(er) { return "" }
  const t = T.tys[er]
  if t is TyUnion {
    const members = t.uMembers
    let name = ""
    let i = 0
    while i < members.length {
      const nm = nominalNameOfObj(members[i], stmts)
      if nm == "" { return "" }
      if i > 0 { name = name + "|" }
      name = name + nm
      i = i + 1
    }
    // Every member is a DECLARED TYPE NAME — one identifier, one atom — so the join's
    // width is the member count (#1115).
    return irAtoms(name, members.length)
  }
  ""
}

// The emitter-format NAME of an inferred NULLABLE-ref return `er` — `P | null` (the struct inner
// reverse-mapped to its user-type name, exactly as `structUnionRetName` does for a union member) or
// `string | null`. The emitter pins a nullable-returning closure VALUE from this (`synthRetAnnots`) so
// its `$fnsig` result keys the nullable token (`>n<idx>;` / `>N`) and the value call's `ref.cast`
// resolves — without it the lambda's return collapses to the bare non-null kind (`>s<idx>;`) and the
// call's nullable key is un-interned. "" unless `er` is a nullable whose inner the emitter lowers (a
// NAMED struct — niche `(ref null $struct)` — or string — niche `ref.null $array`).
// Whether nullable-INNER type `it` is an ARRAY of a PRIM i32/boolean element — the
// `T[] | null` subset that reps as the `nullist` niche (`(ref null $lTypeIdx)`) and
// carries the `>o` value-call result token. The distinct-backing leaves (i64/f64/f32/
// string elements) are NOT this — their nullable lists stay outside the value-call ABI.
// A LITUNION element (`K0[] | null`) shares the i32 backing too but its lambda
// adoption still mis-keys the sig producers (the named-function VALUE spelling works;
// the lambda stays a clean checker reject until that seam is audited), so it is
// deliberately excluded here.
function tyIsNulI32BackedListInner(itIx: i32) {
  if itIx < 0 { return false }
  const it = T.tys[itIx]
  if it is TyArray {
    if it.aElem < 0 { return false }
    const el = T.tys[it.aElem]
    if el is TyPrim { return el.primName == "i32" || el.primName == "boolean" }
    // A NICHE-nullable boolean element (`(boolean | null)[] | null`): the element's null
    // rides IN the i32 (sentinel 2), so the list keeps the SAME i32 backing and the outer
    // `| null` is the same `(ref null $lTypeIdx)` niche — the pin/`nodeTyIsNulI32List`
    // definition-site dual, without which the lambda's inferred non-null list result
    // (`boolean[]`) disagrees with the value call's nullable-list `ref.cast` (TRAP). The
    // litunion niches stay excluded per the sig-producer note above.
    if el is TyNullable {
      const ei = T.tys[el.nInner]
      if ei is TyPrim { return ei.primName == "boolean" }
    }
  }
  false
}

function nullableRetName(er: i32, stmts: i32[]) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyNullable {
    const it = T.tys[t.nInner]
    if it is TyObj {
      const nm = nominalNameOfObj(t.nInner, stmts)
      // NON-spaced (`P|null`) — the emitter's internal name convention (`nullablePartOf`,
      // `structUnionRetName`'s `Cat|Dog`), not the spaced `tyToStr` render.
      // A declared type NAME is one atom; `null` is the second (#1115).
      if nm != "" { return irAtoms(nm + "|null", 2) }
      // An INLINE shape with no matching TypeDecl (`{a: boolean, f: {f: f64}, z: i32}`,
      // the anonymous `(i32) => {f: i64} | null` spelling): render the emitter-format shape
      // text — `structIndexOfTypeName` resolves it by FIELD-SET to the same struct index the
      // annotation side keys, so the two `$fnsig` producers agree on `>n<idx>;`. A map (`{[`)
      // is excluded (no struct rep); an un-internable shape leaves the sig unresolved
      // downstream — a loud reject, exactly as before the pin.
      const inm = tyToEmitName(t.nInner)
      // The SHAPE-NAME grammar's OPENER at its home in `tyname.vl` — the `length >= 2` bound and
      // both character compares live there. A map (`{[`) is what the second conjunct
      // excludes, which is exactly why the home and not the map-accepting endpoint pair.
      if nameIsShapeOpen(inm) {
        // The `{…}` shape's separators all sit inside the braces (the renderer reports
        // its own width); `null` adds one atom (#1115).
        return irAtoms(inm + "|null", emitNameAtoms + 1)
      }
    } else if it is TyFunc {
      // A NULLABLE-CLOSURE contextual return (`((i32) => K0) | null`, kind 19): the closure
      // fat-pointer made nullable (`(ref null $cloStruct)` — the niche). Render the inner
      // function type in the emitter's NON-spaced `=>` form, PARENTHESIZED and NON-spaced around
      // the bar (`((i32)=>K0)|null`) — the form `nameIsNulClosure` / `nullablePartOf` recognize
      // (neither SPACED render does — `tyToStructStr`'s `->` nor the display entry's `=>`).
      // The RESULT preserves a literal-union ALIAS
      // (`litUnionAliasNameOfTy`) rather than `tyToEmitName`'s softened `string`, so the inner
      // value-call (`t0(1)`) and the interned inner `$fnsig` agree on the litunion's i32-atom
      // token (`>i`, via `annRetKind`) — NOT the string `>S`, whose `(ref array)` result would
      // clash with the litunion-atom `print`. `synthRetAnnots` pins the lambda's `fnRet` to this,
      // and `emitReturnValue`'s `retNulClosure` arm niches a `return null` as `ref.null
      // $cloStruct`. (Closure dual of the nullable-struct pin; the lambda's `$fnsig` result keys `>C`.)
      let ips = ""
      const pts = it.fnParamTypes
      let pj = 0
      while pj < pts.length {
        const pn = tyToEmitName(pts[pj])
        if pn == "" { return "" }
        if pj > 0 { ips = ips + "," }
        ips = ips + pn
        pj = pj + 1
      }
      let irs = litUnionAliasNameOfTy(it.fnRet)
      if irs == "" { irs = tyToEmitName(it.fnRet) }
      // The grouped closure is ONE atom (its separators AND its top-level `=>` sit inside
      // the parens); `null` is the second (#1115).
      if irs != "" { return irAtoms("((" + ips + ")=>" + irs + ")|null", 2) }
    } else if tyIsNulI32BackedListInner(t.nInner) {
      // The nullable i32-BACKED list (`boolean[] | null`, `i32[] | null`, a litunion
      // `K0[] | null` — kind 15): the shared i32-list wrapper made nullable
      // (`(ref null $lTypeIdx)`). Rendered NON-spaced (`boolean[]|null`) so
      // `nullablePartOf` recognizes it; `synthRetAnnots` pins the lambda's `fnRet` to it
      // and the annotated nullable-list return machinery (`retNulListFlag`) lowers the
      // body — the lambda's `$fnsig` result keys `>o`, matching the value call's
      // `annRetKind`. The distinct-backing leaves (`i64[] | null`, …) are NOT rendered
      // (outside the value-call ABI — they stay loud rejects).
      const lnm = tyToEmitName(t.nInner)
      return irAtoms(lnm + "|null", emitNameAtoms + 1)
    } else if tyIsPrimNamed(t.nInner, "string") {
      return irAtoms("string|null", 2)
    } else if tyIsPrimNamed(t.nInner, "boolean") {
      // The boolean niche (`boolean | null`): the i32 sentinel rep (2 = null). Pinned by
      // `synthRetAnnots` (`nullablePartOf` non-empty) so `emitReturnValue`'s `tyIsNulBool`
      // arm niches a `return null` / `return <bool>`, matching the annotated form.
      return irAtoms("boolean|null", 2)
    }
  }
  ""
}

// The emitter-format NAME of an inferred NULLABLE-LITUNION return `er` (`() => K0 | null`): a
// `TyNullable` (or a `TyUnion` with a `null` atom) whose non-null part is a LITERAL union. The
// emitter niches it as the i32 atom with `-1` = null (`nodeTyIsNulLitUnion` → `retNulLitUnion`),
// so the pin (`synthRetAnnots`, via `nullablePartOf` non-empty) routes the anonymous lambda
// through the SAME sound rep the annotated `: () => K | null` return already lowers. Renders the
// litunion by its ALIAS (`K0|null`); an inline `("a"|"b")|null` litunion has no alias and stays
// "" (a clean reject — the fuzzer's shapes alias the union). "" for any non-nullable-litunion.
function nulLitUnionRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyNullable {
    const alias = litUnionAliasNameOfTy(t.nInner)
    // An alias identifier plus the `null` arm — two atoms (#1115).
    if alias != "" { return irAtoms(alias + "|null", 2) }
  }
  ""
}

// The emitter-format NAME of an inferred ELEMENT-NULLABLE list return `er` — `(f64|null)[]`,
// `(i32|null)[]`, `(i64|null)[]`, `(f32|null)[]`: a `TyArray` whose element is a `TyNullable`
// over a numeric scalar. Its elements are the value-union `{tag, payload}` boxes (element kind
// 2, the SAME rep the annotated `(f64|null)[]` return uses), so the emitter pins a lambda to it
// (`synthRetAnnots`) and routes through that existing sound path. The parser renders the union
// with NO spaces (`f64|null`), matching `parenUnionArrElemName` / `isValueUnionName`. "" unless
// `er` is such an array (a struct / string / boolean element uses a distinct or absent rep).
function nulElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    // The HOLE declines here (`tyArrayElemIx`): an un-annotated lambda returning a bare
    // `[]` reaches this ladder with an element index of `-1`, and reading it was the
    // compiler's own out-of-bounds `array.get` — check-stage, no diagnostic, no module.
    const ei = tyArrayElemIx(er)
    if ei < 0 { return "" }
    const et = T.tys[ei]
    if et is TyNullable {
      // The inner's PRIMITIVE name, read off the arena (`tyPrimNameOf`) rather than
      // recovered from a `tyToStr` render — here the name is the emitted PAYLOAD, so
      // it is still spelled into the result, but the DECISION is structural.
      const inner = tyPrimNameOf(et.nInner)
      if inner == "f64" || inner == "i32" || inner == "i64" || inner == "f32" {
        // THE BOX LEG — a value union, claimed by `synthRetAnnots`' arm 4.
        return irAtomsRung(
          "(" + primNameStr(inner) + "|null)[]",
          1,
          IR_RUNG_NUL_ELEM_LIST,
        )
      }
      // The NICHE leaves: `(boolean|null)[]` (i32 sentinel-2 list), `(string|null)[]`
      // (string-ref list with `ref.null` elements), `(K|null)[]` (i32 atom list with the
      // `-1` sentinel, rendered by its ALIAS). Each rides an existing non-box list rep the
      // annotated return already lowers; the pin routes the anonymous lambda through it.
      if inner == "boolean" || inner == "string" {
        // A NICHE LEG — arm 4's `nameIsNulBool` / `nameIsNulString` guards reject these, and no
        // later arm claims them, so they are recorded and left UNPINNED.
        return irAtomsRung(
          "(" + primNameStr(inner) + "|null)[]",
          1,
          IR_RUNG_NUL_ELEM_LIST_NICHE,
        )
      }
      const alias = litUnionAliasNameOfTy(et.nInner)
      if alias != "" {
        // The third leg, and a niche for the same reason (`nameIsNulLitUnion`).
        return irAtomsRung(
          "(" + alias + "|null)[]",
          1,
          IR_RUNG_NUL_ELEM_LIST_NICHE,
        )
      }
    }
  }
  ""
}

// The emitter-format NAME of a NULLABLE-CLOSURE-element list return `er` —
// `(((i32)=>K0)|null)[]`, `((()=>i64)|null)[]`: a `TyArray` whose element is a `TyNullable`
// over a function type. Its elements are the kind-5 NICHE over the shared closure
// fat-pointer (`(ref null $cloStruct)`, the `rlElemNullable` bit — the SAME rep the
// annotated spelling lowers), rendered through `nullableRetName`'s TyFunc arm so a litunion
// RESULT keeps its ALIAS (`K0`, the i32-atom token) and the whole name byte-matches the
// parser's canonical annotation. `synthRetAnnots` pins a lambda's `fnRet` to it (its
// `parenUnionArrElemName` arm) so an all-`null` body literal (`() => ([null])`) builds
// under the RETURN-position kind-5 seed and the pinned TypeRef collects the ref-list slot
// + the element's `$fnsig` — the path the annotated named-function form already lowers.
// "" otherwise.
function nulClosureElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyNullable {
      const it = T.tys[et.nInner]
      if it is TyFunc {
        const en = nullableRetName(t.aElem, gRootStmts)
        if en != "" { return irAtoms("(" + en + ")[]", 1) }
      }
    }
  }
  ""
}

// The emitter-format NAME of a DISTINCT-BACKING SCALAR-LEAF list return `er` — `i64[]`,
// `f64[]`, `f32[]`: a `TyArray` whose element is one of the scalar leaves with its OWN list
// backing. The name is in `isScalarListRetName`'s recordable set, and `synthRetAnnots` pins a
// lambda's `fnRet` to it so the body literal builds the leaf's wrapper and the value-call
// index read finds its list types collected — the SAME sound path the annotated
// named-function return already lowers. An `i32[]`/`boolean[]`/`string[]`/litunion `K[]`
// element is EXCLUDED: those self-classify identically to the annotation (a shared backing),
// so no adoption is ever needed there. "" otherwise.
function scalarLeafListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyPrim {
      const pn = et.primName
      if pn == "i64" || pn == "f64" || pn == "f32" { return pn + "[]" }
    }
  }
  ""
}

// The emitter-format NAME of a LITUNION-ALIAS-element list return `er` — `K0[]`: the
// adoption gate + recorded name for a member-literal-bodied lambda
// (`(i32) => K0[] = (q0) => (["4664"])`). `synthRetAnnots` pins the lambda's `fnRet` to
// it so the body literal builds the i32 ATOM list under the annotated return's threading
// (un-pinned, the member literals self-classify a STRING list into the i32-list functype
// result — invalid wasm); the named-function spelling (`mk(q0: i32): K0[]`) lowers this
// already. An alias-less INLINE litunion element declines ("" — no pinnable name).
function litUnionElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    if tyIsLitUnion(t.aElem) {
      const an = litUnionAliasNameOfTy(t.aElem)
      if an != "" { return irAtoms(an + "[]", 1) }
    }
  }
  ""
}

// The emitter-format NAME of a STRUCT-ELEMENT list return `er` (`{f: f32}[]`,
// `{a: f32, f: K0, z: i64}[]`) whose element fields are all PLAINLY LOWERABLE (a scalar /
// string / boolean prim, or a litunion alias) — the element shapes the named-function
// spelling (`mk(q0: i32): {f: f32}[]`) already round-trips through the value-call ABI, so a
// lambda may adopt them. A map / union / nullable / list / closure / nested-struct field is
// NOT this (those composition seams stay loud rejects). "" otherwise.
function structElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyObj {
      if !structElemFieldsPlain(t.aElem, 4) { return "" }
      return irRendered(tyToEmitName(er))
    }
  }
  ""
}

// The emitter-format NAME of a NULLABLE-STRUCT-element list return `er` —
// `({a: string, f: i32, z: boolean} | null)[]`: a `TyArray` whose element is a
// `TyNullable` over a `TyObj` with plainly-lowerable fields (`structElemFieldsPlain`).
// Its elements are the kind-1 STRUCT niche (`(ref null $S)`, the `rlElemNicheNullable`
// bit — the SAME rep the annotated `(): (S|null)[]` named-function value spelling
// already lowers). `synthRetAnnots` pins a lambda's `fnRet` to it (via
// `parenUnionArrElemName`, which extracts the `{…}|null` element) so an anonymous
// lambda's body literal builds under the RETURN-position kind-1-niche seed and the
// pinned TypeRef collects the ref-list slot — un-pinned, the body's non-null struct
// elements self-classified a `{…}[]` reflist (slot N) while the annotation-side value
// call keyed the `(…|null)[]` slot (slot M): divergent `$fnsig` reflist tokens, a
// "no interned signature" reject (direct binding) or a cast-failure TRAP (union arm).
// The nullable-struct sibling of `nulElemListRetName` / `structElemListRetName`. ""
// otherwise (a composite-field element stays a loud reject).
function nulStructElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyNullable {
      const it = T.tys[et.nInner]
      if it is TyObj {
        // A BOXED-UNION-FIELD element (`({f: i64|string|{q:i64}} | null)[]` — the element
        // struct carries a variant-box union field) is NOT `structElemFieldsPlain`, but the
        // annotated `(…|null)[]` named-function-VALUE spelling already lowers it (the
        // kind-1 struct niche over the boxed-field struct row), so admit it through the
        // SAME pin when `structFieldBoxRetName` proves every field lowerable. Un-admitted,
        // the bare lambda self-classified a plain `{f:…}[]` reflist slot vs the
        // annotation-side `(…|null)[]` slot — a cast-failure TRAP / "bare null needs a
        // struct-typed context" reject (fuzz post-#1051 sweep declared leg). The
        // nullable-element sibling of `structFieldBoxElemListRetName`.
        if !structElemFieldsPlain(et.nInner, 4) {
          if structFieldBoxRetName(et.nInner) == "" { return "" }
        }
        return irRendered(tyToEmitName(er))
      }
    }
  }
  ""
}

// The emitter-format NAME of a NULLABLE-MAP-element list return `er` —
// `({[string]: boolean} | null)[]`, `({[string]: string} | null)[]`: a `TyArray` whose
// element is a `TyNullable` over a `TyMap`. Its elements are the kind-3 map struct made
// nullable (`(ref null $mapStruct)`, the `rlElemNullable` niche — the SAME rep the annotated
// `(…|null)[]` return / named-function-VALUE spelling already lowers), so `synthRetAnnots`
// pins a lambda's `fnRet` to it (its `parenUnionArrElemName` arm — `{[string]:…}|null` is a
// 2+-member `|` inner). Un-pinned, the body's non-null-map array self-classified a
// `{[string]:V}[]` reflist keyed on a DIFFERENT slot than the annotation-side value call's
// `(…|null)[]` slot — a "no interned signature" reject / cast-failure TRAP (fuzz sweep
// YKq9Jw declared, seed 43421976). The nullable-map sibling of `nulStructElemListRetName`. ""
// otherwise.
function nulMapElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyNullable {
      const it = T.tys[et.nInner]
      if it is TyMap { return irRendered(tyToEmitName(er)) }
    }
  }
  ""
}

// The emitter-format NAME of a NULLABLE-SCALAR-LIST-element list return `er` —
// `(f64[] | null)[]`, `(i64[] | null)[]`: a `TyArray` whose element is a `TyNullable` over a
// `TyArray` of a scalar/string PRIM leaf. Its elements are the inner list's wrapper ref kept
// nullable (`(ref null $wrapper)`, the `rlElemNullable` bit over the kind-4/6/7/8/10 inner —
// `nullArrayArrElem`'s rep, which the annotated `(…|null)[]` return / named-function-VALUE
// spelling already lowers), so `synthRetAnnots` pins a lambda's `fnRet` to it (its
// `parenUnionArrElemName` arm — `f64[]|null` is a 2+-member `|` inner). Un-pinned, the body's
// non-null lists self-classified a plain `f64[][]` reflist keyed on a DIFFERENT slot than the
// annotation-side value call's `(…|null)[]` slot — a cast-failure TRAP; an all-`[null]` body
// missed the element seed entirely ("bare null needs a struct-typed context"; fuzz post-#1051
// sweep GATING leg). The scalar-list sibling of `nulMapElemListRetName` /
// `nulStructElemListRetName`. A BOX-ELEMENT inner list (`((i32|boolean)[] | null)[]`) admits too
// (see the arm below); a nested (2-D+) or other composite-element inner list stays declined
// ("" — those composition seams keep their loud rejects).
function nulListElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyNullable {
      const it = T.tys[et.nInner]
      if it is TyArray {
        if it.aElem < 0 { return "" }
        const lt = T.tys[it.aElem]
        if lt is TyPrim { return irRendered(tyToEmitName(er)) }
        // A BOX-ELEMENT inner list (`((i32|boolean)[] | null)[]`, `((i64|{q:i64})[] | null)[]`):
        // the inner list's elements ride the union `{tag, payload}` box (element kind 2), so the
        // OUTER element is that box-list's wrapper kept nullable — `nullArrayArrElem`'s kind-9
        // (nested-ref-array) inner arm, exactly the rep the annotated `(): ((i32|boolean)[]|null)[]`
        // named-function-VALUE spelling already lowers soundly. Un-admitted, the bare lambda's body
        // (`[[false]]`) self-classified a plain `boolean[][]` reflist keyed on a DIFFERENT `$fnsig`
        // slot than the annotation-side value call's `(…|null)[]` box-list slot — a cast-failure
        // TRAP (fuzz post-#1063 sweep branching leg). The value-union sibling of the scalar-leaf
        // arm above; a map-union / ref-arm / nested-2D inner stays declined (its own route).
        if elemValueUnionListRetName(et.nInner) != "" {
          return irRendered(tyToEmitName(er))
        }
        if elemVariantBoxListRetName(et.nInner) != "" {
          return irRendered(tyToEmitName(er))
        }
      }
    }
  }
  ""
}

// The CANONICAL emitter NAME for a PLAIN struct inferred return (`{f: f32}`) whose
// fields all pass `structElemFieldsPlain` — the bare-struct sibling of
// `structElemListRetName`, feeding the recorder's `spfNm` canon record so
// `synthRetAnnots`' whole-span-shape arm pins the lambda.
function structPlainRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if !(t is TyObj) { return "" }
  if !structElemFieldsPlain(er, 4) { return "" }
  irRendered(tyToEmitName(er))
}

// The field gate of `structElemListRetName`: every field a scalar / string / boolean
// prim, a litunion alias, or (recursively) a NESTED plain struct. The nested-struct
// admission is load-bearing: an UN-pinned lambda returning a list of such structs
// self-resolves each element literal by field-name set, and a program with
// same-fieldset TWIN rows in scope matched the WRONG row and boxed the element as a
// union-box list — INVALID-WASM (fuzz sweep3 multiobs leg, seed 369283890
// case_00290). The named-fn spelling lowers nested-struct fields already (code 15).
// Map / union / nullable / list / closure fields stay declined (their composition
// seams keep the loud rejects).
function structElemFieldsPlain(objTy: i32, depth: i32): boolean {
  if depth <= 0 { return false }
  const et = T.tys[objTy]
  if !(et is TyObj) { return false }
  let i = 0
  while i < et.objFieldTypes.length {
    const fty = et.objFieldTypes[i]
    if fty < 0 { return false }
    const ft = T.tys[fty]
    let ok = false
    if ft is TyPrim { ok = true }
    if tyIsLitUnion(fty) { ok = true }
    if ft is TyObj {
      if structElemFieldsPlain(fty, depth - 1) { ok = true }
    }
    // A MAP field (`a: {[string]: f64 | null}` inside `{a: {…}, f: …, z: …}`): the
    // annotated named-fn spelling lowers a string-keyed map field (the kind-3 map struct
    // ref, whatever value the emitter can lower), and un-admitted the whole struct declined
    // the canon record — an un-pinned closure returning a list of such structs
    // self-classified each element and mis-keyed the outer struct's heap type
    // (fuzz sweep tFpE3l declared, seed 18472788 p0c: the value-union sibling field `f`
    // twinned). Gated on a non-empty `tyToEmitName` (an un-nameable map value stays a loud
    // reject on the annotated path itself, so the pin adds no invalid wasm).
    if ft is TyMap {
      if tyIsEmitRepresentable(fty) { ok = true }
    }
    // A CLOSURE field (`z: () => f64` inside `{a: string, f: {[string]: f64}, z: …}`): the
    // annotated named-fn spelling lowers a closure field (the code-14 fat-pointer slot,
    // whatever result the emitter can lower), and un-admitted the whole struct declined the
    // canon record — an un-pinned closure returning a LIST of such structs self-classified
    // each element and mis-coded a SIBLING map/composite field (the closure field alone is
    // harmless; a map sibling took the i32 default → `struct.new` of a ref into an i32 slot,
    // INVALID-WASM: fuzz sweep D8n9AN declared, seed 472261954 p0c
    // `() => {a: string, f: {[string]: f64}, z: () => f64}[]`). Gated on a non-empty
    // `tyToEmitName` (an un-lowerable closure stays a loud reject on the annotated path
    // itself, so the pin adds no invalid wasm — the map-field discipline above).
    if ft is TyFunc {
      if tyIsEmitRepresentable(fty) { ok = true }
    }
    if ft is TyArray {
      // A PLAIN-STRUCT-ELEMENT LIST field (`f: {a: string, f: i32, z: f64}[]` inside
      // `{a: i32, f: {…}[], z: f32}`): the annotated named-fn spelling lowers, and
      // un-admitted the whole struct declined the canon record — the un-pinned field
      // lambda's result struct fieldset-collided onto its OWN LIST-ELEMENT twin row
      // ({a, f, z} on both) and the f32 `z` field took the element row's f64 code:
      // INVALID-WASM (fuzz post-#996 sweep plain leg, seed 849016038 case_00056).
      // Scalar-element lists admit too (same rep argument); a deeper composite
      // element declines as before.
      // `tyArrayElemIx` decides the element row BEFORE it is read. The `>= 0` comparison
      // used to sit one line BELOW the `T.tys[ft.aElem]` above it, so it gated the litunion
      // and nested-struct probes while the read that actually needed it went unguarded — an
      // inferred `{f: []}` field carries the `-1` hole and trapped the compiler.
      const feIx = tyArrayElemIx(fty)
      if feIx >= 0 {
        const aet = T.tys[feIx]
        if aet is TyPrim { ok = true }
        if !ok {
          if tyIsLitUnion(feIx) { ok = true }
          if aet is TyObj {
            if structElemFieldsPlain(feIx, depth - 1) { ok = true }
          }
          // A BOX-ELEMENT-UNION LIST field (`f: (i64|string|{q:i64})[]` inside
          // `{f: (i64|string|{q:i64})[]}`): the field array's elements ride the union
          // `{tag, payload}` box — the SAME rep `elemValueUnionListRetName` /
          // `elemVariantBoxListRetName` pin for a bare `(…)[]` return, and which the annotated
          // named-fn spelling (`mk(): {f: (i64|string|{q:i64})[]}[]`) already lowers soundly.
          // Un-admitted the whole struct declined the canon record → an un-pinned closure
          // returning a list of such structs self-classified each element's `f` array from its
          // first literal (`["other"]` → `string[]`, `[13131313131]` → `i64[]`) — twin heap
          // reps: a "ref valtype with no interned shape" reject (single element) or an
          // "expected/found (ref $type)" INVALID-WASM (mixed elements) at the struct.new
          // (fuzz sweep tFpE3l declared, seed 18472788 p0c). Covers a pure value-union element
          // (`i64|string`) AND a variant-box element (an inline-struct arm + scalar siblings,
          // `i64|string|{q:i64}`) — both share the box. A niche `(scalar|null)[]` /
          // map-union / ref-arm element stays declined (its own route / loud reject).
          if !ok {
            if elemValueUnionListRetName(fty) != "" { ok = true }
            if !ok && elemVariantBoxListRetName(fty) != "" { ok = true }
          }
          // A MAP-ELEMENT LIST field (`z: {[string]: f32}[]` inside `{a: …, f: …, z: {…}[]}`):
          // the kind-3 map-element ref-list (`mapElemListRetName`'s rep), which the annotated
          // named-fn spelling lowers. Un-admitted, the outer struct declined the canon record
          // (the tFpE3l p0c sibling of the map field above). An un-nameable map-value element
          // stays a loud reject on the annotated path itself.
          if !ok && aet is TyMap {
            if tyIsEmitRepresentable(ft.aElem) { ok = true }
          }
        }
      }
    }
    if !ok { return false }
    i = i + 1
  }
  true
}

// The emitter-format NAME of a MAP-ELEMENT list return `er` — `{[string]: f32}[]`: a
// `TyArray` whose element is a string-keyed map. `synthRetAnnots` pins a lambda's `fnRet`
// to it so its `$fnsig` result keys the SAME kind-3 map-element ref-list slot the
// annotation-side value call resolves (the named-function spelling lowers this already);
// un-pinned, the literal-side element spelling diverges and the call finds no interned
// signature. A map value type the emitter cannot lower keeps rejecting loudly on the
// annotated path itself. "" otherwise.
function mapElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyMap { return irRendered(tyToEmitName(er)) }
  }
  ""
}

// The emitter-format NAME of an inferred ELEMENT-VALUE-UNION list return `er` — `(i64|boolean)[]`,
// `(i64|string)[]`, `(i32|f64)[]`: a `TyArray` whose element is a VALUE union the emitter boxes
// (`isValueUnionName`). Its elements are the value-union `{tag, payload}` boxes (element kind 2, the
// SAME rep the annotated `(i64|boolean)[]` return / named-function-value form lowers), so the emitter
// pins a lambda to it (`synthRetAnnots`) and routes through that existing sound path. `tyToEmitName`
// renders the parens-wrapped, space-free name `(i64|boolean)[]` matching `parenUnionArrElemName`. The
// value-union sibling of `nulElemListRetName` (which owns the `(scalar|null)[]` niche). "" otherwise.
function elemValueUnionListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    const en = tyToEmitName(t.aElem)
    if en != "" && isValueUnionName(en) { return irRendered(tyToEmitName(er)) }
  }
  ""
}

// The emitter-format NAME of an inferred ELEMENT-VARIANT-BOX-UNION list return `er` —
// `({a:boolean,f:boolean,z:i32}|i64)[]`, `(i32|{w:i32})[]`: a `TyArray` whose element is a
// union `variantBoxUnionRetName` renders (an inline-struct arm + scalar/string/litunion-alias
// siblings). Its elements are the `{tag, payload}` boxes (element kind 2 — the SAME rep the
// annotated return / named-function-VALUE spelling already lowers), so the emitter pins a
// lambda to it (`synthRetAnnots`) and routes through that existing sound path. The member
// render is `variantBoxUnionRetName`'s (a litunion arm keeps its ALIAS — `rlSlotByName`'s
// primary key), parens-wrapped to match `parenUnionArrElemName`. The variant-box sibling of
// `elemValueUnionListRetName`. "" otherwise.
function elemVariantBoxListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const en = variantBoxUnionRetName(t.aElem)
    if en != "" { return irAtoms("(" + en + ")[]", 1) }
  }
  ""
}

// The emitter-format NAME of an inferred ELEMENT-MAP-UNION list return `er` —
// `({[string]: string} | f64)[]`, `({[string]: f32} | {w: i32})[]`: a `TyArray` whose
// element is a map-member union `mapUnionRetName` renders (a map member + object/scalar
// siblings, all riding the `{tag, payload}` box — element kind 2, the SAME rep the
// annotated `(…)[]` return / named-function-VALUE spelling already lowers). The map-union
// sibling of `elemVariantBoxListRetName` (`variantBoxUnionRetName` declines map members).
// Pinned by `synthRetAnnots`'s `parenUnionArrElemName` arm (a 2+-member `|` inner). "" otherwise.
function elemMapUnionListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const en = mapUnionRetName(t.aElem)
    if en != "" { return irAtoms("(" + en + ")[]", 1) }
  }
  ""
}

// The emitter-format NAME of an inferred ELEMENT-REFARM-VALUE-UNION list return `er` —
// `((i32|boolean)[] | i32)[]`, `((string|i64|{q:i64})[] | f64)[]`: a `TyArray` whose element is a
// union mixing a box-list-element ARRAY arm (`(i32|boolean)[]` — a VALUE-union-element list, or
// `(string|i64|{q:i64})[]` — a VARIANT-BOX-union-element list carrying a struct arm; either is the
// kind-2 box list) with scalar prim siblings. The element union's arms box as `{tag, payload}` (the
// array arm rides the box's anyref `value` as a REF atom, the scalar arm boxes its value) — the SAME
// rep the annotated `((…)[]|…)[]` return / named-function-VALUE spelling already lowers soundly, so
// the emitter pins a lambda to it (`synthRetAnnots`'s `parenUnionArrElemName` arm registers the inner
// union). Un-pinned, the body's `[77]` / `[9.25]` self-classified a plain `i32[]` / `f64[]` reflist
// keyed on a DIFFERENT `$fnsig` slot than the annotation-side value call's box-list slot — a
// cast-failure TRAP (fuzz sweep zq0NPY multiobs, seed 24438928 case_00007; the variant-box-arm sibling
// from fuzz sweep cV4tlq branching, seed 396585459 case_00221). The union-element-array sibling of
// `elemValueUnionListRetName` (which owns pure-scalar value-union elements) — its array arm is what
// `variantBoxUnionRetName` / `refArmUnionRetName` decline (an array-of-scalar/variant-box-union, not
// obj). "" otherwise.
function elemRefArmValueUnionListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if !(t is TyArray) { return "" }
  if t.aElem < 0 { return "" }
  const et = T.tys[t.aElem]
  if !(et is TyUnion) { return "" }
  const members = et.uMembers
  if members.length < 2 { return "" }
  let hasArr = false
  let mi = 0
  while mi < members.length {
    const m = T.tys[members[mi]]
    if m is TyArray {
      // The array element must render as a box-list element the emitter boxes as `{tag, payload}`
      // (element kind 2): a pure VALUE union the emitter boxes (`(i32|boolean)[]` — `isValueUnionName`),
      // OR a VARIANT-BOX union carrying a struct arm (`(string|i64|{q:i64})[]` —
      // `variantBoxUnionRetName`, whose annotated named-fn spelling lowers the same box). A niche
      // `(scalar|null)[]` element (both predicates exclude it) or a map/closure element is NOT this
      // family — those stay on their own paths / loud rejects.
      const eln = tyToEmitName(m.aElem)
      if eln == "" { return "" }
      if !isValueUnionName(eln) && variantBoxUnionRetName(m.aElem) == "" {
        return ""
      }
      hasArr = true
    } else if m is TyPrim {
      // A scalar-prim sibling boxes as a value atom (`i32`) — fine.
    } else {
      // A struct / map / closure / nested-array sibling widens the family beyond the sound
      // annotated box; decline so those stay on their established routes.
      return ""
    }
    mi = mi + 1
  }
  if !hasArr { return "" }
  irRendered(tyToEmitName(er))
}

// The emitter-format NAME of an inferred NESTED (2-D+) union-element array return `er` —
// `({f: (i32,i32,i32) => boolean} | i32)[][]`, `(i64 | boolean)[][]`. A `TyArray` whose
// element is ITSELF an array (≥2 dims) and whose innermost 1-D leaf array is one of the
// recognized box-element lists (value-union / variant-box / map-union). Its elements are
// nested ref-lists bottoming out at the kind-2 `{tag, payload}` box — the SAME rep the
// annotated `(…)[][]` return / named-function-VALUE spelling already lowers soundly (a NAMED
// fn with the explicit 2-D annotation works today). The emitter pins a lambda to it
// (`synthRetAnnots`'s arm for THIS producer's rung), so the body's nested array literal
// builds under the return-position `pendingListKind` threading instead of self-classifying
// the outer array from its first element's leaf (`[77]` → `i32[][]`) — INVALID-WASM at the
// union-list element (fuzz sweep wo7cNe declared, seed 174529790). The nested sibling of
// the 1-D `elemValueUnionListRetName` / `elemVariantBoxListRetName` / `elemMapUnionListRetName`.
function nestedElemUnionListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if !(t is TyArray) { return "" }
  if t.aElem < 0 { return "" }
  const inner = T.tys[t.aElem]
  if !(inner is TyArray) { return "" }
  // Peel to the innermost (leaf) 1-D array.
  let leafArr = t.aElem
  let done = false
  while !done {
    const la = T.tys[leafArr]
    if la is TyArray {
      if la.aElem < 0 { return "" }
      const le = T.tys[la.aElem]
      if le is TyArray { leafArr = la.aElem } else { done = true }
    } else {
      done = true
    }
  }
  if (
    elemValueUnionListRetName(leafArr) != "" ||
    elemVariantBoxListRetName(leafArr) != "" ||
    elemMapUnionListRetName(leafArr) != ""
  ) {
    return irRendered(tyToEmitName(er))
  }
  ""
}

// The emitter-format NAME of a CLOSURE-ARM value union return `er` (`(()=>string)|i64`,
// `((i32)=>f64)|boolean`): a ≥2-member union mixing at least one FUNCTION-TYPE member with
// scalar prims. A closure member is the kind-11 REF atom (`valueAtomKind` — the fat-pointer
// rides the box's anyref value), rendered in the emitter's non-spaced, parens-grouped form
// (`nullableRetName`'s TyFunc render); the RESULT preserves a litunion ALIAS so the inner
// value call and interned inner `$fnsig` agree on the atom token. Gated through
// `isValueUnionName` (the same gate the annotated path uses), so the pin routes the
// anonymous lambda through the SAME sound box the annotated named-function-VALUE spelling
// already lowers. "" for any other shape (map / array / object members stay on their paths).
function cloArmValueUnionRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  // A NULLABLE closure-arm value union (`((i32) => f32) | i32 | null` — canon wraps the
  // null into a TyNullable over the 2+-member union): the box already carries a null
  // member atom, so the rep IS the same `>u` box — render the inner union and append
  // `|null` (the `variantBoxUnionRetName` / `mapUnionRetName` nullable discipline).
  // Un-peeled, the outer lambda never adopted the union and interned the RAW-closure
  // `$fnsig` result while the value call cast to the box sig — a cast-failure TRAP
  // (fuzz sweep4 plain leg, seed 395013828 case_00309).
  if t is TyNullable {
    const inner = cloArmValueUnionRetName(t.nInner)
    // The inner union keeps its own top-level `|`s, so `null` ADDS one atom to the width
    // the recursion just reported (#1115).
    if inner != "" { return irAtoms(inner + "|null", inferRetNameAtoms + 1) }
    return ""
  }
  if t is TyUnion {
    const members = t.uMembers
    if members.length < 2 { return "" }
    let hasClo = false
    let name = ""
    let i = 0
    while i < members.length {
      const m = T.tys[members[i]]
      let mn = ""
      if m is TyFunc {
        let ips = ""
        const pts = m.fnParamTypes
        let pj = 0
        while pj < pts.length {
          const pn = tyToEmitName(pts[pj])
          if pn == "" { return "" }
          if pj > 0 { ips = ips + "," }
          ips = ips + pn
          pj = pj + 1
        }
        let irs = litUnionAliasNameOfTy(m.fnRet)
        if irs == "" { irs = tyToEmitName(m.fnRet) }
        if irs == "" { return "" }
        mn = "((" + ips + ")=>" + irs + ")"
        hasClo = true
      } else if m is TyPrim {
        mn = m.primName
      } else {
        return ""
      }
      if i > 0 { name = name + "|" }
      name = name + mn
      i = i + 1
    }
    if !hasClo { return "" }
    // Every member render is ONE atom — a prim's own name, or a closure PARENTHESIZED
    // (which puts its separators and its `=>` inside a grouper) — so the join's width is
    // the member count (#1115).
    if isValueUnionName(name) { return irAtoms(name, members.length) }
  }
  ""
}

// The emitter-format NAME of an inferred/contextual NESTED LIST return `er` with a
// SCALAR/STRING LEAF — `i64[][]`, `f64[][]`, `string[][]`, `f32[][]`, or a deeper
// recursion over those (`i64[][][]`): a `TyArray` whose element is itself a `TyArray`,
// bottoming out at a scalar/string/boolean prim. Pinning a lambda's `fnRet` to this
// (`synthRetAnnots`) makes the body literal build under the RETURN-position seed —
// `() => ([[100]])` against `() => i64[][]` builds i64 INNER lists (the leaf widens at
// the store), instead of the self-classified i32 default whose sig/wrapper diverge —
// and the `$fnsig` result keys the SAME reflist slot the annotation side resolves. An
// `i32[][]`/`boolean[][]` leaf is EXCLUDED: the self-classified build already agrees
// with the annotation there (one i32[] backing), so no pin is needed — recording it
// would only churn working programs. A struct/union/closure/map leaf is NOT this (the
// R6/R3/R1 composition seams stay loud). "" otherwise.
function nestedLeafListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyArray {
      if et.aElem < 0 { return "" }
      const lt = T.tys[et.aElem]
      if lt is TyPrim {
        const pn = lt.primName
        if pn == "i64" || pn == "f64" || pn == "f32" || pn == "string" {
          return irRendered(tyToEmitName(er))
        }
        return ""
      }
      if lt is TyArray {
        // Deeper nesting: the leaf decides — recurse on the INNER array.
        if nestedLeafListRetName(t.aElem) != "" {
          return irRendered(tyToEmitName(er))
        }
      }
    }
  }
  ""
}

// The emitter-format NAME of an inferred MAP-MEMBER-UNION return `er` (`{[string]:f32}|{w:i32}`):
// a ≥2-member union whose FIRST member is a MAP and whose every member is a map or object shape.
// `tyToEmitName` renders it in the emitter's non-spaced vocabulary, MAP-FIRST (so the name matches
// `nameIsMap`, the shape the emitter's `registerInlineUnion` map-member-union box path — #865/#868 —
// keys on). Pinning a lambda's `fnRet` to this (`synthRetAnnots`) routes the anonymous lambda through
// the SAME sound rep the annotated `: {[string]:f32}|{w:i32}` return lowers (verified: the annotated
// spelling interns + prints; the pin only removes the annotation). "" for a non-union, a map-SECOND
// union (the emitter's classifiers assume map-first — left a LOUD reject, never invalid wasm), or a
// union with a non-map/non-object member (an unrepresentable arm the box path rejects downstream).
function mapUnionRetName(er: i32) {
  if er < 0 { return "" }
  // THE MAP-SECOND CLAIM BELOW IS NOT IMPLEMENTED, and is left as a note rather than silently
  // deleted: the body requires only `hasMap`, with no POSITION check, so `{w:i32}|{[string]:f32}`
  // does render. That was invisible while `nameIsMapMemberUnion` (which does require map-first)
  // stood between this producer and the pin; it does not any more, so the discrepancy is recorded
  // here. It is behaviour-neutral — such a name registers and was already pinned through
  // `isUName` — but the header should not be read as a guarantee.
  //
  // A NULLABLE map-member union (`{[string]: boolean} | i32 | null`) normalizes to
  // TyNullable over the union — unwrap it for the member gate; the render keeps the
  // full `…|null` spelling (`tyToEmitName(er)`), which `synthRetAnnots`'s nullable
  // pin arm accepts and the annotated form already lowers. Un-recorded, the lambda's
  // `$fnsig` result keyed the raw scalar arm (`>i`) while the binding local held the
  // union box — INVALID-WASM at the call-result store (fuzz seed 103465585 d6).
  let uIx = er
  const tn = T.tys[er]
  if tn is TyNullable { uIx = tn.nInner }
  const t = T.tys[uIx]
  if t is TyUnion {
    const members = t.uMembers
    if members.length < 2 { return "" }
    // At least one MAP member, and every member a map, an object shape, or a
    // scalar/string prim (`{[string]: string} | boolean` — the prim rides the box
    // as its value atom, exactly as in the variant-box unions). A litunion /
    // array / closure / nullable member declines — those stay on their own paths.
    let hasMap = false
    // NON-NULL COUNT — `TY_NULL` is a `TyPrim`; see the gate after the loop.
    let muNonNull = 0
    let i = 0
    while i < members.length {
      const m = T.tys[members[i]]
      // The NON-NULL count, taken before the shape arms so it narrows nothing.
      if !tyIsPrimNamed(members[i], "null") { muNonNull = muNonNull + 1 }
      if m is TyMap {
        hasMap = true
      } else if !(m is TyObj) {
        if !(m is TyPrim) { return "" }
      }
      i = i + 1
    }
    if !hasMap { return "" }
    // AT LEAST TWO NON-NULL MEMBERS — the `refArmUnionRetName` guard's twin, for the same reason
    // and the same shape. `null|{[string]:f32}` reached here with one real member, and
    // `registerInlineUnion` diverts such a name to `registerMapValUnion` on its non-null part
    // rather than pushing the composite, so nothing registers it.
    if muNonNull < 2 { return "" }
    return irRendered(tyToEmitName(er))
  }
  ""
}

// The emitter-format NAME of a REF-ARM value union `er` (`T[] | {w: i32}` — a ≥2-member
// union with at least one REF-ARRAY member and every member an object shape or an array
// of object shapes; repOf item (d)'s shape class). Members render NOMINALLY when a
// declared type matches (`nominalNameOfObj` — the emitter's narrow-atom compare is
// name-keyed, and the program's `is T[]` spelling is nominal), falling back to the
// structural `tyToEmitName` render for an anonymous arm (`{w:i32}`). The rendered name
// is registered by `collectU`'s inferred-return loop, pinned onto the lambda by
// `synthRetAnnots` (its `isUName` arm — same spelling), and returned to the emitter's
// union-binding resolution by `nodeUnionName` — ONE renderer, so all three byte-match.
// An ARRAY member whose element has no nominal name declines ("" — the #911
// declared-twin gate keeps anonymous-element reflists a loud reject; rendering them
// would only trade that reject for a deeper one). "" for any other shape (scalar /
// string / map / closure / null members stay on their existing paths).
function refArmUnionRetName(er: i32, stmts: i32[]) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyUnion {
    const members = t.uMembers
    if members.length < 2 { return "" }
    // Structural pre-gate BEFORE any render (the #494 discipline): every member an
    // object or an array-of-object, at least one array.
    let hasList = false
    // NON-NULL COUNT, because `TY_NULL` is a `TyPrim` and the scalar-sibling arm below admits
    // one. See the `>= 2` gate after the loop.
    let rauNonNull = 0
    let hasObjSibling = false
    let gi = 0
    while gi < members.length {
      const m = T.tys[members[gi]]
      // The NON-NULL count, taken before the shape arms so it cannot narrow `m` out from under
      // the `!(m is TyPrim)` scalar-sibling arm below.
      if !tyIsPrimNamed(members[gi], "null") { rauNonNull = rauNonNull + 1 }
      if m is TyArray {
        // The HOLE declines with every other non-object element (`tyArrayElemIx`): an
        // arm whose element the arena has not resolved carries `aElem == -1`, and
        // reading it is the compiler's own out-of-bounds `array.get`.
        const meIx = tyArrayElemIx(members[gi])
        if meIx < 0 { return "" }
        const et = T.tys[meIx]
        if !(et is TyObj) { return "" }
        hasList = true
      } else if m is TyObj {
        hasObjSibling = true
      } else if !(m is TyPrim) {
        // A SCALAR sibling (`{f: string}[] | f64`) rides the box as a value atom —
        // the annotated named-fn spelling lowers it, and un-admitted the lambda
        // stayed UNPINNED while the value call's by-arity sig fallback cast to the
        // wrong functype: a runtime TRAP (fuzz sweep5 multiobs seed 763624784
        // case_00371). Anything else (map / closure / list-of-nonobj) still declines.
        return ""
      }
      gi = gi + 1
    }
    if !hasList { return "" }
    // AT LEAST TWO NON-NULL MEMBERS, which the `members.length >= 2` gate above does NOT imply:
    // `TY_NULL` is a `TyPrim`, so the scalar-sibling arm admits it and `S[] | null` reached here
    // with one real member. That name is NOT registrable — `registerInlineUnion` diverts a
    // `<refarray>|null` to its non-null part and never pushes the composite, and
    // `isVariantBoxUnionAtoms` would decline it at `nonNull >= 2` anyway — so a consumer that
    // pins off THIS producer's rung would pin against a union with no box.
    //
    // The sibling `variantBoxUnionRetName` already carries the equivalent guard, added when the
    // same shape was traced there: `flattenVariantsInto` re-materialises `null` as a SIBLING
    // member and `joinRetTys` mints `mkUnionTy` with no `hasNull` fold, so the arena really does
    // hold `TyUnion[X, null]` post-substitution. This is that guard, at the producer that was
    // missing it.
    if rauNonNull < 2 { return "" }
    let name = ""
    let i = 0
    while i < members.length {
      const m = T.tys[members[i]]
      let mn = ""
      if m is TyArray {
        let en = nominalNameOfObj(m.aElem, stmts)
        // An ANONYMOUS-shape element (`{f: string}[]`) renders canonically ONLY
        // beside PRIM-only siblings (`{f: string}[] | f64` — the raw-scalar arm
        // boxes; fuzz sweep5 multiobs seed 763624784 case_00371): the interner keys
        // the inline spelling and the annotated form lowers it. Beside an OBJ
        // sibling (`{f: boolean}[] | {w: i32}`) the pinned array-literal coerce
        // still rejects the anonymous-element arm — keep those UN-pinned on their
        // established route (the closure-union-result-arm canary).
        if en == "" && !hasObjSibling { en = tyToEmitName(m.aElem) }
        if en == "" { return "" }
        mn = en + "[]"
      } else if m is TyPrim {
        mn = m.primName
      } else {
        mn = nominalNameOfObj(members[i], stmts)
        if mn == "" { mn = tyToEmitName(members[i]) }
        if mn == "" { return "" }
      }
      if i > 0 { name = name + "|" }
      name = name + mn
      i = i + 1
    }
    // Every member render is ONE atom — the structural pre-gate above admits only an
    // array-of-object (`S[]` / `{…}[]`), an object shape and a scalar prim, and each of
    // those spells its separators inside a grouper — so the join's width is the member
    // count (#1115).
    return irAtoms(name, members.length)
  }
  ""
}

// The emitter-format NAME of a VARIANT-BOX union `er` with an INLINE-struct arm and a
// scalar/string sibling (`i32 | {w: i32}`, `{f: string} | {w: i32}`, `{f: i32} | f64`,
// `{a: i32, f: i32, z: f64} | boolean`): a ≥2-member union whose every member is an
// object shape or a scalar/string prim, with at least one object member. This is the
// closure-RESULT unlock for the R2 `$fnsig` seam: the annotated named-function spelling
// (`mk(x: i32): i32 | {w: i32}` bound to a `(i32) => i32 | {w: i32}` value) already
// interns `>u` and its value call round-trips, so pinning a lambda's `fnRet` to this
// name (`synthRetAnnots`'s `isUName` arm — the render is registered by `collectU`'s
// inferred-return loop) routes the anonymous lambda through the SAME sound box.
// `tyToEmitName` renders the emitter's non-spaced vocabulary, byte-matching the
// `registerInlineUnion` / `splitUnionAtoms` name shape. Declines ("") when:
//  · any member is a map / array / nullable (those shapes are owned by
//    `mapUnionRetName` / `refArmUnionRetName` / the nullable arms — or stay loud),
//  · a closure member appears WITHOUT a struct sibling (closure + scalar mixes are
//    `cloArmValueUnionRetName`'s), or a second closure member appears (a conservative
//    bound of THIS naming path — the box tags two closure arms apart by signature slot,
//    so admitting one would be a widening to measure, not a correctness fix),
//  · any member is a literal type (`TyLit` — a litunion member renders softened to
//    `string`, divorcing the pinned name from the annotation's atom rep),
//  · any member renders "" (an unrepresentable leaf), or no object member exists
//    (a pure-scalar union is `valueUnionRetName`'s), or every member is a NOMINAL
//    object (`structUnionRetName` owns the nominal render — checked by the caller
//    running that arm first).
function variantBoxUnionRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  // A NULLABLE variant-box union (`{a,f,z} | i32 | null` — canon wraps the null into a
  // `TyNullable` over the 2+-member union): the box already carries a null member atom
  // (`valueAtomKind("null")`), so the rep IS the same `>u` box — render the inner union
  // and append the `|null` atom, which `registerInlineUnion`'s variant-box path admits
  // (a `null` atom rides the tag, no variant slot) and `annRetKind` keys `>u` for.
  if t is TyNullable {
    const inner = variantBoxUnionRetName(t.nInner)
    // The inner union keeps its own top-level `|`s, so `null` ADDS one atom to the width
    // the recursion just reported (#1115).
    if inner != "" { return irAtoms(inner + "|null", inferRetNameAtoms + 1) }
    return ""
  }
  if t is TyUnion {
    const members = t.uMembers
    if members.length < 2 { return "" }
    // A litunion-ALIAS member's literals FLATTEN into sibling TyLit members
    // (`flattenVariantsInto`: `K0 | {w: i32} | f64` -> ["pd", "42", {w:i32}, f64]),
    // so no single member names the alias. Regroup: collect the str-lit members and
    // resolve them as ONE registered alias by exact member-set match, rendered at
    // the FIRST lit's position (preserving the annotation's member order so the
    // pinned name byte-matches the annotation spelling). No exact alias match (or a
    // non-str lit) declines the whole union, keeping the loud reject.
    const litTexts: string[] = []
    let i0 = 0
    while i0 < members.length {
      const m0 = T.tys[members[i0]]
      if m0 is TyLit {
        if m0.litKind != "str" { return "" }
        litTexts.push(m0.litText)
      }
      i0 = i0 + 1
    }
    let litAlias = ""
    if litTexts.length > 0 {
      litAlias = litUnionAliasOfLitTexts(litTexts)
      if litAlias == "" { return "" }
    }
    let hasComposite = litAlias != ""
    let hasClo = false
    let hasObj = false
    let name = ""
    // The APPEND count, not `members.length`: the litunion regroup below CONTRACTS a run
    // of `TyLit` members into ONE alias atom (`continue`), so the loop's iteration count
    // and the result's atom count are different numbers — method note 23's shape in the
    // contracting direction. Every appended `mn` is one atom (an alias identifier, a
    // parenthesized functype, or a `vbUnionMemberName` prim/`{…}`/`X[]`). (#1115.)
    let psum = 0
    let litDone = false
    let i = 0
    while i < members.length {
      const m = T.tys[members[i]]
      let mn = ""
      if m is TyLit {
        if litDone {
          i = i + 1
          continue
        }
        litDone = true
        mn = litAlias
      } else if m is TyFunc {
        // A CLOSURE arm beside a STRUCT arm (`(() => f32|null) | {w: i32}`): the closure
        // rides the box anyref as the kind-11 REF atom (`isVariantBoxUnion` admits it), and
        // the annotated spelling of such a union already lowers soundly — so render the
        // parenthesized functype atom, byte-matching the annotation's `((…)=>…)` member.
        // ONE closure arm at most — a conservative bound of this path rather than a rep
        // limit, since the box tags closure arms apart by signature slot (`cloSigSlotTag`) —
        // and the struct-sibling requirement below keeps closure + scalar/list mixes on their
        // existing owners (`cloArmValueUnionRetName`) / loud paths. Without this the outer
        // lambda of a `(i32) => (() => f32|null) | {w:i32}` value never adopted the union —
        // its `$fnsig` interned the raw-closure result while the value call cast to the
        // `>u` sig (INVALID-WASM; fuzz-nightly seed 556796311 d6).
        if hasClo { return "" }
        const cn = tyToEmitName(members[i])
        if cn == "" { return "" }
        mn = "(" + cn + ")"
        hasClo = true
        hasComposite = true
      } else {
        mn = vbUnionMemberName(members[i])
        if mn == "" { return "" }
        // A BARE `null` MEMBER IS DECLINED, and this is a real shape rather than a defensive
        // guard: the `TyNullable` arm above OWNS the null and appends the atom itself, but the
        // JOIN/SUBSTITUTION route does not fold. `flattenVariantsInto` re-materialises `null` as
        // a SIBLING member, `joinRetTys` mints `mkUnionTy` with no `hasNull` fold (unlike
        // `joinTys` and `narrowRemove`, which both re-wrap), and once substitution binds the
        // holes `refoldJoinUnion` / `substTyDeep` hand back an ORDINARY `TyUnion` still carrying
        // `TY_NULL`. Three consumers in this file assert that shape exists — `eqCmpKindOfTy`
        // ("the same rep, two arena shapes"), `unionSoleNonNullMember`, and
        // `nodeTyMapValIsNulBool`'s `sawNull && sawBool` scan.
        //
        // WITHOUT THIS the render is a two-atom NICHE — `boolean|null`, `string|null`,
        // `K0|null` — because `vbUnionMemberName`'s `TyPrim` arm spells `TY_NULL` as `"null"`
        // and `"null"` is in neither negative list below, so it even sets `hasComposite` and
        // passes the gate. `elemVariantBoxListRetName` then wraps it to `(boolean|null)[]`,
        // which reps as the i32 SENTINEL list, while `synthRetAnnots`' arm 4 would pin it as a
        // kind-2 BOX list. That is precisely the divergence the `nulElemListRetName` split
        // exists to prevent, at the one producer that could still reach it.
        if mn == "null" { return "" }
        if m is TyObj { hasObj = true }
        if mn != "i32" && mn != "i64" && mn != "f64" && mn != "f32" {
          if mn != "boolean" && mn != "string" { hasComposite = true }
        }
      }
      if name != "" { name = name + "|" }
      name = name + mn
      psum = psum + 1
      i = i + 1
    }
    // ONE ATOM IS NOT A UNION. The `members.length < 2` guard at the top counts ARENA
    // members, which is the count BEFORE the litunion regroup above contracts a whole run
    // of `TyLit` members into a single alias atom — so a PURE literal union (`type K = "A"
    // | "B" | "C"`, every member a `TyLit`) reaches here having appended exactly one atom,
    // `K`. That is the interned i32 ATOM rep (`nodeTyIsLitUnionAlias` -> `retLitUnion`),
    // not the `{tag, payload}` box this name keys, and the two disagree at the seam: the
    // callee boxed while every call site read the atom. `psum` is the post-contraction
    // count, so it is the one that can see it.
    if psum < 2 { return "" }
    if hasClo && !hasObj { return "" }
    if !hasComposite { return "" }
    return irAtoms(name, psum)
  }
  ""
}

// One member's render for `variantBoxUnionRetName`: a scalar/string prim by name, a
// literal-union ALIAS by its alias (`K0` — the i32-atom rep; `tyToEmitName` would soften
// it to `string`, divorcing the pinned name from the annotation's atom member), and an
// object shape field-wise (each field a prim or a litunion alias). "" for anything else
// (map / array / closure / nullable / inline-litunion members stay on their own paths).
function vbUnionMemberName(mIx: i32): string {
  const alias = litUnionAliasNameOfTy(mIx)
  if alias != "" { return alias }
  const m = T.tys[mIx]
  if m is TyPrim { return m.primName }
  // A SCALAR-LEAF array member (`i64[] | boolean`, `i64[][] | boolean` — a value-atom
  // list or a nested scalar-leaf array): its rep is a plain wrapper ref riding the box
  // (the value-atom / kind-9 nested-list rule), and the annotated named-fn spelling of
  // such a union lowers fully (both arms round-trip, `is i64[][]` narrows) — so the
  // rendered name pins a contextual lambda through the same sound path. An
  // OBJECT-element array member stays declined (its arm-narrow registration and
  // element-literal widening are the deferred repOf seams).
  if m is TyArray {
    let leaf = m.aElem
    let vguard = 0
    let scalarLeaf = false
    while vguard < 8 {
      vguard = vguard + 1
      if leaf < 0 { break }
      const lt = T.tys[leaf]
      if lt is TyArray {
        leaf = lt.aElem
      } else {
        let leafPrim = leaf
        // A NULLABLE-scalar element leaf (`(i64 | null)[]` — the value-union-box
        // element list) admits too: the annotated named-fn spelling of a union
        // carrying such an arm lowers fully (both arms round-trip, the `!= null`
        // element narrow included), so the pin routes the lambda the same way.
        if lt is TyNullable { leafPrim = lt.nInner }
        const lp = T.tys[leafPrim]
        if lp is TyPrim {
          const pn = lp.primName
          if (
            pn == "i32" ||
            pn == "i64" ||
            pn == "f64" ||
            pn == "f32" ||
            pn == "boolean" ||
            pn == "string"
          ) {
            scalarLeaf = true
          }
        }
        break
      }
    }
    if scalarLeaf {
      const en = tyToEmitName(mIx)
      if en != "" { return en }
    }
    return ""
  }
  if m is TyObj {
    // A NOMINAL struct arm (`Cat | i32` where `type Cat = {legs: i32}`): render the
    // declared type NAME so the registered variant matches the annotated `Cat | i32`
    // spelling (`structUnionRetName`'s `nominalNameOfObj` render) and an `is Cat`
    // narrow resolves the variant — otherwise the inline field-wise render below
    // registers the variant by shape and `is Cat` finds no variant. Falls through to
    // the inline render when no declared type structurally matches the shape.
    const nom = nominalNameOfObj(mIx, gRootStmts)
    if nom != "" { return nom }
    const names = m.objFieldNames
    const ftys = m.objFieldTypes
    let out = "{"
    let fi = 0
    while fi < names.length {
      let fs = litUnionAliasNameOfTy(ftys[fi])
      if fs == "" {
        const ft = T.tys[ftys[fi]]
        // EXHAUSTIVE over `Ty` and deliberately `_`-less: the FIELD ladder is where
        // an un-admitted shape silently declines the whole union arm, and every
        // admission below was added after a fuzz TRAP or INVALID-WASM cell, so a
        // 12th arena variant must break the self-compile here rather than join that
        // list. The four declining arms spell the `else` they replace.
        match ft {
          TyPrim => {
            fs = ft.primName
          }
          TyMap => {
            // A MAP field (`{f: {[string]: string}} | boolean`): the annotated named-fn
            // spelling of a union carrying such an arm lowers fully (the arm narrow and
            // the `t.f[k]` read round-trip), so render the field canonically and pin the
            // lambda through the same sound path. Without it the pin declined, the
            // RETURN-position lambdas of an annotated closure-array literal emitted raw
            // arm-typed `$fnsig`s while the value call cast to the `>u` box sig — a
            // cast-failure TRAP (fuzz sweep2 multiobs seed 655720167 case_00209).
            fs = tyToEmitName(ftys[fi])
            if fs == "" { return "" }
          }
          TyObj => {
            // A NESTED-STRUCT field (`{a: string, f: {f: string}, z: {[string]: i64}}
            // | boolean`): code 15 — the annotated spelling lowers it, and un-admitted
            // the whole arm declined, the lambda stayed un-pinned (self `boolean`
            // `$fnsig`), and the narrowed value call's cast hit the wrong functype —
            // a runtime TRAP (fuzz sweep5 declared seed 448399393 case_00335). The
            // map-field admission's sibling.
            fs = tyToEmitName(ftys[fi])
            if fs == "" { return "" }
          }
          TyNullable => {
            // A NULLABLE field (`{f: i64 | null} | string | f64`): every nullable field
            // spelling the annotation grammar admits has a field code (`i64|null` the
            // code-16 value union, `string|null` the code-20 niche, …), and the
            // annotated spelling of such a union lowers fully. Un-admitted, the whole
            // arm declined, the expected-return adoption never fired, and the lambda's
            // recorded return stayed the raw null-hole render (`{f: null}`) — the #981
            // whole-span pin arm then interned an ARM-typed `$fnsig` while the value
            // call cast to the `>u` box sig: a cast-failure TRAP (fuzz sweep6 multiobs
            // leg, seed 153999330 case_00187). The nullable sibling of the map-field /
            // nested-struct admissions above.
            fs = tyToEmitName(ftys[fi])
            if fs == "" { return "" }
          }
          TyArray => {
            // A LIST field (`{a: i64[], f: {f: string}, z: () => f64} | i32 | null` —
            // code 26/5/…): the annotated spelling lowers, and un-admitted the whole
            // arm declined — the `() => (77)` lambda stayed un-pinned and returned the
            // RAW i32 where the value call expected the box: INVALID-WASM (fuzz
            // post-#993 sweep branching leg, seed 3496995 case_00249). The list
            // sibling of the admissions above.
            fs = tyToEmitName(ftys[fi])
            if fs == "" { return "" }
          }
          TyFunc => {
            // A CLOSURE field (`z: () => f64` — code 14): same draw as the list field
            // above; renders as the bare arrow (a FIELD position carries no trailing
            // `|` ambiguity — fields split at commas).
            fs = tyToEmitName(ftys[fi])
            if fs == "" { return "" }
          }
          TyUnion => {
            // A VALUE-UNION field (`z: string | i32` — code 16): the annotated named-fn
            // spelling of a union carrying such an arm lowers fully (the arm narrow, the
            // `t0.z` field read, and the field-value narrow all round-trip). Un-admitted,
            // the whole arm declined, and a closure returning `({z: string|i32} | i64)[]`
            // never adopted the union-array result — its body self-inferred `i64[]` and
            // returned a raw i64-list wrapper while the value call cast the funcref to the
            // ref-list `$fnsig`: a cast-failure TRAP (fuzz sweep hPjUJh branching leg,
            // seed 117044659 case_00365). tyToEmitName preserves member order and litunion
            // aliases, and the inner `|` is brace-scoped exactly like the nullable field
            // arm's (`{f: i64|null}`). The value-union sibling of the map / nested-struct
            // / nullable / list / closure field admissions above.
            fs = tyToEmitName(ftys[fi])
            if fs == "" { return "" }
          }
          TyErr => {
            // The error/unknown hole has no field code — decline the whole arm.
            return ""
          }
          TyVar => {
            // An unsolved type PARAMETER has no field code — decline the whole arm.
            return ""
          }
          TyLit => {
            // A bare `TyLit` field reached WITHOUT its litunion alias (the
            // `litUnionAliasNameOfTy` probe above already claimed the aliased form) —
            // decline the whole arm.
            return ""
          }
          TyNeg => {
            // A RESIDUAL negation has no field code — decline the whole arm.
            return ""
          }
        }
      }
      if fi > 0 { out = out + "," }
      out = out + names[fi] + ":" + fs
      fi = fi + 1
    }
    return out + "}"
  }
  ""
}

// True if node `ix`'s recorded type is a PURE literal union (every member a `TyLit` —
// an aliased or inline litunion): it reps as the i32 ATOM (alias) or the string ref
// (inline), NEVER the value-union box, so the emitter's union-box classifiers must not
// claim it. Gates `exprUnion`'s checker-typed Call fallback: without it a call whose
// result is a litunion (`const r = pick(ks)`, `pick(p: K[]): K`) classified as a box
// and the atom-valued store mismatched the ref cell.
export function nodeTyIsPureLitUnion(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyUnion {
    if t.uMembers.length < 2 { return false }
    let i = 0
    while i < t.uMembers.length {
      if !(T.tys[t.uMembers[i]] is TyLit) { return false }
      i = i + 1
    }
    return true
  }
  false
}

// True when at least one member of the union member list is NOT an object shape — the
// cheap NO-RENDER pre-gate for `nodeUnionName`'s variant-box fallback arm. A mixed
// union (`f64 | {w: i32}`, `K0 | boolean`) boxes value-union style and its narrowed
// read needs the NAME to unbox; a pure-object union (`{f: string} | {w: i32}`, the
// huge `Node`) narrows via the variant alone, so declining here keeps the costly
// member renders off that path.
function mixedVariantBoxGate(members: i32[]): boolean {
  let i = 0
  while i < members.length {
    if !(T.tys[members[i]] is TyObj) { return true }
    i = i + 1
  }
  false
}

// The public entry point: check the program rooted at node `rootIx`, returning
// the number of diagnostics raised (diagnostics also accumulate on `T.diags`).
// (The old PR #5 gap — a discarded/`let`-bound call return mis-lowering at module
// scale, which forced callers into expression position — is fixed and pinned by
// `tests/cases/statements/discarded-call-return.vl`; the discarded `checkNode`
// below exercises it in this very module.)
export function checkProgram(rootIx: i32) {
  const rootN0 = P.nodes[rootIx]
  if rootN0 is Program { gRootStmts = rootN0.progStmts }
  // Size the typed-IR table to the (now fully parsed) node arena, all holes (-1).
  nodeTyIx = []
  isVarTyIx = []
  cFuncPinTyIx = -1
  cObjPinTyIx = -1
  nodePinKind = []
  nodePinPay = []
  let ntz = 0
  while ntz < P.nodes.length {
    nodeTyIx.push(-1)
    isVarTyIx.push(-1)
    ntz = ntz + 1
  }
  checkNode(rootIx)
  // The global scope (depth 0) is never popped, so flush its un-annotated
  // empty-collection bindings here: any still-open hole is genuinely uninferable.
  flushUninferred(0)
  // Rewrite literal/intersection annotation names into the emitter's
  // vocabulary (membership was enforced above; the emitter needs only the
  // runtime representation). Names without those constructs are untouched.
  canonEmitTypeNames()
  // A20: record each un-annotated function's INFERRED concrete return name for the
  // emitter (never the AST, so `fmt` stays oblivious).
  let ei = 0
  while ei < topUnannotFns.length {
    const efn = P.nodes[topUnannotFns[ei]]
    if efn is FuncDecl {
      const eft = lookup(efn.fnName)
      if eft >= 0 {
        const eftt = T.tys[eft]
        if eftt is TyFunc {
          const er = eftt.fnRet
          // Skip GENERIC functions (a `self` marker or any un-annotated param is a
          // `TyVar` hole): their return is per-call-site, so the definition-time
          // inferred type is a placeholder that renders to a misleading name (e.g.
          // `sumsq(self)` → `string`). Only a fully concrete signature is elaborated.
          // A DEFERRED JOIN return is generic for exactly the same reason — it is a
          // placeholder that collapses to one arm per call site, NOT a union the
          // emitter should register a box for. Exporting it made the emitter classify
          // `function relay(x) { return pick(x, "s", true) }` as returning a value
          // union while the body returned the plain arm — a module that fails
          // validation ("expected (ref 2), got (ref 0)").
          let generic = false
          const ert0 = T.tys[er]
          if ert0 is TyVar { generic = true }
          if tyIsDeferredJoin(er) { generic = true }
          let gp = 0
          while gp < eftt.fnParamTypes.length {
            const pt = T.tys[eftt.fnParamTypes[gp]]
            if pt is TyVar { generic = true }
            if tyIsDeferredJoin(eftt.fnParamTypes[gp]) { generic = true }
            gp = gp + 1
          }
          if !generic && er >= 0 && er != TY_VOID && er != TY_ERR {
            // Only SCALAR/STRING returns — names that unambiguously round-trip through
            // the emitter's classifier. A structural object / union / array name
            // (`{x: i32}`, `A | B`, `Tok[]`) can mis-classify, and the emitter's
            // expression-based fallback already handles those, so leave them be.
            const enm = tyToStructStr(er)
            if isClassifiableRetName(enm) {
              // `isClassifiableRetName`'s admitted set is six scalar spellings plus
              // `i32[]`/`string[]` — every one of them a single atom (#1115).
              recordInferRet(efn.fnName, enm, er, 1, IR_REC_CLASSIFIABLE)
            } else {
              // A VALUE union/nullable inferred return (`i32 | string`, `i32 | null`)
              // lowers through the same `uBoxIdx` machinery as an annotation — export
              // its emitter-format name so `buildFnMap`/`registerValueUnionName`/the
              // return site pick it up.
              const un = valueUnionRetName(er)
              if un != "" {
                recordInferRet(
                  efn.fnName,
                  un,
                  er,
                  inferRetNameAtoms,
                  IR_RUNG_VALUE_UNION,
                )
              } else if structUnionRetName(er, gRootStmts) != "" {
                // A STRUCT-union (`Cat | Dog`) lowers un-annotated via the variant-boxed
                // rep — the SAME machinery as an annotated `: Cat | Dog`. Export its
                // nominal name so the emitter registers the union + classifies the
                // binding (`registerInlineUnion` / `unionNameOfExpr`).
                // The width is read AFTER the render that reports it (#1115) — a local,
                // so no argument-evaluation order is relied on.
                const sun = structUnionRetName(er, gRootStmts)
                recordInferRet(
                  efn.fnName,
                  sun,
                  er,
                  inferRetNameAtoms,
                  IR_RUNG_STRUCT_UNION,
                )
              } else if litUnionAliasNameOfTy(er) != "" {
                // A pure LITERAL-UNION inferred return (`function f(k: K) { return k }` over a
                // `type K = "a" | "b"`) reps as the interned i32 ATOM, exactly like the annotated
                // `: K` spelling — export the ALIAS name so the emitter's return classification
                // reaches the atom rep (`nameIsLitUnionType` -> `retLitUnion`) instead of the
                // value-union box. An alias name is ONE identifier, so one atom (#1115).
                // The lambda ladder records the identical name at its own litunion rung.
                recordInferRet(
                  efn.fnName,
                  litUnionAliasNameOfTy(er),
                  er,
                  1,
                  IR_RUNG_LITUNION_ALIAS,
                )
              } else if variantBoxUnionRetName(er) != "" {
                // A VARIANT-BOX union (`{w: i32} | i32`, `Cat | i32` — a struct arm beside a
                // scalar) lowers un-annotated via the SAME `>u` box the annotated `: {w:
                // i32} | i32` spelling interns: `collectU`'s inferred-return loop registers
                // the box + its variant struct from this recorded name, the emitter's
                // `isUName` return classification stores `"union"`, and `emitReturnValue`
                // boxes the struct/scalar arm exactly as the annotated form does. Export
                // the `variantBoxUnionRetName` emit render (the anonymous-lambda spelling
                // already records this same name under its `#<nodeIx>` sentinel).
                const vbn = variantBoxUnionRetName(er)
                recordInferRet(
                  efn.fnName,
                  vbn,
                  er,
                  inferRetNameAtoms,
                  IR_RUNG_VARIANT_BOX,
                )
              } else {
                // A NICHE nullable (`boolean | null` / `string | null`) lowers via its
                // sentinel / `ref.null $array` rep, not the box, so `valueUnionRetName`
                // declines it. Export the canonical niche name (no spaces, matching the
                // emitter's classifier) so the return-site seeding / functype result
                // valtype pick it up. A non-niche nullable (struct ref) stays floored.
                const ert = T.tys[er]
                if ert is TyNullable {
                  // Two atoms, written out literally right here (#1115).
                  if tyIsPrimNamed(ert.nInner, "boolean") {
                    recordInferRet(
                      efn.fnName,
                      "boolean|null",
                      er,
                      2,
                      IR_RUNG_NULLABLE,
                    )
                  } else if tyIsPrimNamed(ert.nInner, "string") {
                    recordInferRet(
                      efn.fnName,
                      "string|null",
                      er,
                      2,
                      IR_RUNG_NULLABLE,
                    )
                  } else if litUnionAliasNameOfTy(ert.nInner) != "" {
                    // The LITERAL-UNION niche (`K | null`): an i32 atom with `-1` for null,
                    // the same rep the annotated `: K | null` spelling reaches
                    // (`nodeTyIsNulLitUnion` -> `retNulLitUnion`). The alias plus `null` is
                    // two atoms, like its boolean/string siblings above.
                    recordInferRet(
                      efn.fnName,
                      litUnionAliasNameOfTy(ert.nInner) + "|null",
                      er,
                      2,
                      IR_RUNG_NUL_LITUNION,
                    )
                  }
                }
              }
            }
          }
        }
      }
    }
    ei = ei + 1
  }
  T.diags.length
}

// A20: the emitter reads this to classify an un-annotated function's return from its
// inferred TYPE name rather than re-deriving from the return expression.
// Record an inferred-return entry: push the parallel arrays AND the by-name map (first-wins).
// Every `inferRetFn`/`inferRetTy` push goes through here so the map stays in sync.
function recordInferRet(
  name: string,
  ty: string,
  tyIx: i32,
  atoms: i32,
  rung: i32,
) {
  if !inferRetIdx.has(name) { inferRetIdx[name] = inferRetFn.length }
  inferRetFn.push(name)
  inferRetTy.push(ty)
  // #1057 — bank the recorded name's TOP-LEVEL atom count HERE, at the one funnel every
  // inferred-return name producer lands in. #1112 took the number by running
  // `unionMemberCount` over the finished string; #1115 takes it from `atoms`, the width
  // the CALLER's producer already knew at its own `|` join. Same number, no scan of a
  // string the compiler just assembled — the `canonEmitName` -> `canonAtoms` trade of
  // #1113, applied to this funnel. (The refuted alternative is an arena-SPINE walk of the
  // recorded TYPE — see the column's comment: a litunion member renders as one atom while
  // its spine counts several. The width must be the producer's JOIN width, never a walk.)
  inferRetAtomCount.push(atoms)
  inferRetTyIx.push(tyIx)
  // AN EXPLICIT PARAMETER, not a read of the cascade's global — the sibling `atoms` column has
  // been passed this way since #1115 and the first version of this column did not copy that
  // discipline. Reading a global here made the row's rung depend on whether the caller had just
  // run the cascade, and TWO gates sit between the cascade and this call (`tyIsDeferredJoin`, and
  // the first-wins `inferRetNameOf(nodeKey) == ""` that fires when a lambda node is re-checked
  // non-quietly). Either one left the global armed for the NEXT row — and the next row's most
  // likely shape is a `recordable` one, which never runs the cascade at all and would have
  // inherited a nullability answer belonging to a different lambda.
  inferRetRung.push(rung)
  0
}

// The TOP-LEVEL atom count of the inferred-return NAME at row `i` (`inferRetTyAt`'s
// sibling): >= 1 for every recorded row, -1 only for an out-of-range index.
export function inferRetAtomCountAt(i: i32) {
  if i < 0 || i >= inferRetAtomCount.length { return -1 }
  inferRetAtomCount[i]
}

// THE INFERRED-RETURN NULL QUESTION — arena-first, and the home is HERE because both of its
// dependencies are: `inferRetTyIxOf` two functions down, `tyBearsNull` in the same file.
//
// `recordInferRet` banks two columns beside a function name: the SPELLING the checker's adoption
// ladder settled on, and `inferRetTyIx`, the arena type it was deciding ABOUT. Readers had only
// ever consulted the spelling, splitting a rendered member set on `|` and looking for a `null`
// atom. This asks the TYPE.
//
// `ty < 0` IS `false`, NOT A NAME FALLBACK — and the guarantee is narrower than a first draft of
// this comment claimed, so it is worth stating exactly.
//
// FOR NAME-KEYED ROWS: every `recordInferRet` reached with a function NAME passes a real `er`.
// The calls in `elaborateInferRets` sit under one gate — `!generic && er >= 0 && er != TY_VOID &&
// er != TY_ERR` — and the remaining two key `"#" + i32ToStr(fnIx)`, which is not a spellable
// identifier and so cannot collide. So for the names these two callers ask about, no arena index
// means no ROW, no row means `inferRetNameOf` returns `""`, and `unionSetHasNull("")` is false.
// Measured: of 848 reaches at the void-inference caller, 837 carry no arena index and every one
// of those has an empty name.
//
// IT DOES NOT HOLD FOR THE `#`-KEYED COLUMN, and a sibling written next door would be wrong on
// day one. The node-keyed `recordInferRet` in `checkFuncDeclNode` is gated only on
// `!tyIsDeferredJoin(inferred)`, whose own first line lets a negative index straight through,
// while its `rty` is non-empty by the guard above it. Nothing observed produces such a row, but
// `inferRetBearsNullByNode` is the obvious next function to write HERE, beside
// `inferRetNameByNode`, and it would need the name leg this one does not.
//
// AND THE COLUMNS ARE PARALLEL BY PHASE ORDER, not by a row invariant. `monoInferListElem` /
// `monoInferLocalScalar` roll a speculative re-check back by popping TWO of the five columns and
// leave `inferRetIdx` alone; they run only during `monomorphize`, after every name-keyed row is
// already written by `elaborateInferRets` at the end of checking. That is why the reduction holds
// — not because the columns cannot desync.
//
// An earlier draft spelled that leg `unionSetHasNull(inferRetNameOf(name))` and described it as
// the live half. It was neither live nor a second opinion — it was `false` with a string
// operation in front of it, and it forced this helper to live one module up, away from both of
// the things it actually reads.
//
// NOT A DUAL IN GENERAL: #1120 measured these two columns to drive DIFFERENT decisions on 14.5%
// of a fully-covered column at `synthRetAnnots`, whose 15-arm ladder reads the raw name. Its
// divergence families do not change the answer to the narrow question asked here — measured, with
// a control at EACH caller that fires when the arena walk is sabotaged.
export function inferRetBearsNull(name: string): boolean {
  const ty = inferRetTyIxOf(name)
  if ty < 0 { return false }
  tyBearsNull(ty)
}

export function inferRetNameOf(name: string) {
  if inferRetIdx.has(name) {
    const i = inferRetIdx[name] ?? -1
    if i >= 0 { return inferRetTy[i] }
  }
  ""
}

// The inferred-return name of an ANONYMOUS lambda, keyed by its FuncDecl NODE INDEX (the
// emitter passes `fnStmts[i]`). Anonymous lambdas are recorded under a `#<nodeIx>` sentinel
// key (they have no real name); the emitter consults this when the name-keyed lookup misses.
export function inferRetNameByNode(nodeIx: i32) {
  return inferRetNameOf("#" + i32ToStr(nodeIx))
}

// THE ARENA SIBLING of `inferRetNameOf` / `inferRetNameByNode` (destringify D-SYNTHRET): the
// `Ty` index the recorder banked for the SAME row the name comes from, so a consumer that
// needs the type does not re-parse the name to get it. `inferRetTyIx` has been recorded
// alongside `inferRetTy` since #1046; this is the keyed reader it never had.
//
// `-1` where the recorder had no arena index, which is exactly the un-handed call.
export function inferRetTyIxOf(name: string) {
  if inferRetIdx.has(name) {
    const i = inferRetIdx[name] ?? -1
    if i >= 0 { return inferRetTyIx[i] }
  }
  -1
}

export function inferRetTyIxByNode(nodeIx: i32) {
  return inferRetTyIxOf("#" + i32ToStr(nodeIx))
}

// Whether an inferred return TYPE name is one the emitter's A20 classifier carries directly
// (a scalar / string / simple list) — the set the inferred-return table records. Shared by
// the named-function recording loop and the anonymous-lambda recording in `checkFuncDeclNode`.
//
// The six LEAF names are bare prim-name equalities, which the destringify rule allows (a name
// is a name). The two LIST names were not: `nm == "i32[]"` decides a COMPOSITE type by matching
// its rendered characters, fusing the `[]` (structure) and the `i32` (a name) into one opaque
// match. Split at that seam they are the array grammar's ONE CUT (`arrElemNameRaw`, its home
// 2,000 lines below in this same file) plus a leaf name — and the cut is taken ONCE for both.
// Provably equivalent, not merely measured: the cut returns "" for a non-array name and
// otherwise `nm` minus its final two characters, so `arrElemNameRaw(nm) == "i32"` holds on
// exactly the inputs `nm == "i32[]"` holds on.
function isClassifiableRetName(nm: string) {
  if (
    nm == "i32" ||
    nm == "i64" ||
    nm == "f32" ||
    nm == "f64" ||
    nm == "boolean" ||
    nm == "string"
  ) {
    return true
  }
  const elem = arrElemNameRaw(nm)
  elem == "i32" || elem == "string"
}

// A scalar-list inferred-return name the emitter's closure-result classifier carries
// (the `"f64list"`/`"i64list"`/`"f32list"` kinds) but which `isClassifiableRetName` deliberately omits
// (those array names must not reach the redundant-return lint). Recorded for an anonymous
// lambda so its `$fnsig` result resolves position-independently — the checker's per-node
// f32[] typing is unreliable (a float literal types f64), so the syntactic classifier alone
// can miss an f32-list lambda return.
//
// The three scalar-leaf list spellings are the array grammar's ONE CUT plus three leaf names
// — the same seam `isClassifiableRetName` above splits, and the shape the emitter's own
// `nameIsI64Array` / `nameIsF32Array` / `nameIsF64Array` already ship
// (`arrElemNameRaw(name) == "f64"`, one line each). `typecheck.vl` sits BELOW `emit_base.vl`
// and cannot import them, but it OWNS the cut (D-ARRDOWN moved it here), so the two sides of
// the compiler now decide a scalar list by the same two steps rather than one of them
// matching a whole rendering.
function isScalarListRetName(nm: string) {
  const elem = arrElemNameRaw(nm)
  elem == "i64" || elem == "f32" || elem == "f64"
}

// Whether a rendered type name is a single object SHAPE (`{meow: i32}`) — `tyToStr` of a
// `TyObj`. The emitter resolves it to a concrete union variant (a collapsed `.map` callback
// return) via field-set match. A nullable `{…}?` / union `{…} | {…}` is NOT a single shape.
function isObjShapeName(nm: string) {
  // The WIDE brace-endpoint span at its home in `tyname.vl` (`nameIsBraceSpanEnds`) — the fully
  // De-Morganed `nm.length < 2 || nm[0] != '{' || nm[len - 1] != '}'` guard is that home
  // negated, conjunct for conjunct, over the two `if`s master spread it across. It must
  // stay WIDE: a `TyMap` renders `{[string]:i32}`, which this function accepts today (the
  // `|` walk below does not reject it either), and tightening to `nameIsShapeOpen` would
  // change that answer — a behaviour change owing its own evidence, not this refactor's.
  if !nameIsBraceSpanEnds(nm) { return false }
  // Reject a brace that is actually part of a larger composite (`{…} | {…}`, `{…}?`): a
  // single shape has no TOP-LEVEL `|`.
  //
  // This was the file's LAST hand-written type-name walk outside the two homes, and the
  // narrowest of them: a BRACE-ONLY depth counter, blind to `[]`/`()`/`<>` and to quoted
  // literal members. The brace-only reading is not merely a shorter spelling of the home's
  // — it disagrees, and in the direction that loses a shape:
  //   `{a:"}|{"}`  — the quoted `}` closed the brace early, the following `|` then read as
  //   TOP-LEVEL, and a single object shape was rejected as a union.
  // `tyTopIndexOf` skips a quoted member whole (escape-aware) and counts every grouper, so
  // both spellings of that answer come from one place. Nothing else here changes: a `|`
  // nested inside the braces is depth >= 1 to both walks, and a `|` between two shapes is
  // depth 0 to both.
  tyTopIndexOf(nm, '|', 0, 0) < 0
}

// Iteration over the inferred-return table (the emitter's `collectU` registers any
// VALUE-union names here so their box/value-box reps are interned even when an inferred
// return is the program's only value union). `inferRetTyAt` is the rendered type name.
export function inferRetCount() { inferRetFn.length }
// THE ROW INDEX, resolved once — so a consumer that wants BOTH the recorded name and the
// recorded type reads one lookup and two columns instead of two lookups that happen to agree.
// The agreement was never in doubt (both `inferRetNameOf` and `inferRetTyIxOf` key the same
// first-wins `inferRetIdx`, and no row can carry a name without a type — every
// `recordInferRet` call site passes both), but "provably the same row" beats "two readers I
// checked by hand", and it also retires the second `"#" + i32ToStr(nodeIx)` key mint on the
// anonymous-lambda path.
export function inferRetRowOf(name: string): i32 {
  if inferRetIdx.has(name) { return inferRetIdx[name] ?? -1 }
  -1
}

export function inferRetRowByNode(nodeIx: i32): i32 {
  inferRetRowOf("#" + i32ToStr(nodeIx))
}

// The rung banked for row `i`, or -1 out of range. NO RECORDED ROW BANKS `IR_RUNG_NONE` any
// more: every producer in both cascades carries a code, and the `recordable` fall-through now
// carries the identity of the GATE that admitted it (the `IR_REC_*` band). 0 survives only as
// the unbanked sentinel — the producer global's initial value and its pre-cascade reset.
export function inferRetRungAt(i: i32): i32 {
  if i < 0 || i >= inferRetRung.length { return -1 }
  inferRetRung[i]
}

// ── THE RUNG PREDICATES ───────────────────────────────────────────────────────
// One predicate per converted arm, exported instead of the raw codes so the NUMBERING stays this
// file's business and a consumer never spells one.
//
// SAFE AGAINST NAMED ROWS ONLY BECAUSE `#` CANNOT OPEN AN IDENTIFIER, and this applies to ALL of
// them: `synthRetAnnots` looks a row up by NODE key (`"#" + nodeIx`) while the named loop keys on
// a function name, so the two key spaces are disjoint by construction. That was inert while named
// rows banked `IR_RUNG_NONE`; now that they carry real codes, a node key that could collide with
// an identifier would fire these on the wrong row. Any future non-`#` node key breaks all of them.
//
// THE CONTRACT EACH ONE ASSERTS is that the named producer's every non-empty output satisfies its
// arm's predicate AND no other arm's that the ladder reaches first. "No EARLIER arm" is the half
// that is easy to check and the half usually written down; the LATER arms in the same
// same-bodied run matter too, and only look inert because arms 5-8 currently share one body — if
// one of them ever gains a distinct body (a `resolveShapeToNominal`, say), every equivalence in
// that run has to be re-argued rather than assumed.

// Rung 16 — `nestedElemUnionListRetName`.
export function inferRetRungIsNestedElemUnionList(i: i32): boolean {
  inferRetRungAt(i) == IR_RUNG_NESTED_ELEM_UNION_LIST
}

// Rung 24 — `nestedLeafListRetName`.
export function inferRetRungIsNestedLeafList(i: i32): boolean {
  inferRetRungAt(i) == IR_RUNG_NESTED_LEAF_LIST
}

// Rung 26 — `litUnionElemListRetName`.
export function inferRetRungIsLitUnionElemList(i: i32): boolean {
  inferRetRungAt(i) == IR_RUNG_LITUNION_ELEM_LIST
}

// Rung 25 — `mapElemListRetName`.
export function inferRetRungIsMapElemList(i: i32): boolean {
  inferRetRungAt(i) == IR_RUNG_MAP_ELEM_LIST
}

// ARM 4's set — every producer whose render is a paren-grouped value-union array. Nine rungs,
// including `nulElemListRetName`'s BOX leg but not its niche legs (see `IR_RUNG_NUL_ELEM_LIST_NICHE`).
export function inferRetRungIsParenUnionElemList(i: i32): boolean {
  const r = inferRetRungAt(i)
  if r == IR_RUNG_NUL_ELEM_LIST { return true }
  if r == IR_RUNG_NUL_STRUCT_ELEM_LIST { return true }
  if r == IR_RUNG_NUL_MAP_ELEM_LIST { return true }
  if r == IR_RUNG_NUL_LIST_ELEM_LIST { return true }
  if r == IR_RUNG_ELEM_VU_LIST { return true }
  if r == IR_RUNG_ELEM_VARIANT_BOX_LIST { return true }
  if r == IR_RUNG_ELEM_MAP_UNION_LIST { return true }
  if r == IR_RUNG_ELEM_REFARM_VU_LIST { return true }
  if r == IR_RUNG_NUL_CLOSURE_ELEM_LIST { return true }
  false
}

// ARM 1's set — every producer whose render is a UNION the emitter boxes, by any of the four
// routes that arm's disjunction covered. Eight rungs.
//
// THIS ONE REMOVES A CROSS-PASS DEPENDENCE, which the others do not. For rungs 5, 21 and 22 the
// old disjunction reduced to `isUName(ctx)` ALONE — a lookup in the module's union REGISTRY, so
// the pin depended on a chain that runs in a LATER pass: `collectU`'s inferred-return loop ->
// `registerInferRetNominalUnion` (gated on the banked atom width >= 2) -> `registerInlineUnion`
// -> `isVariantBoxUnionAtoms`, which needs >= 1 struct/ref-array/map atom AND >= 2 NON-NULL
// members. (Rung 23 is NOT in that group: its litunion-regroup outputs — `K0|i64` — are claimed
// by `nameIsLitUnionArmValueUnion`, for which `isValueUnionName` and `isUName` are both false.
// An earlier draft of this comment credited that predicate to rung 4, which is wrong: rung 4 is
// gated by `isValueUnionName` and never needed it.)
//
// THE CHAIN DID NOT CLOSE FOR 21 AND 22 UNTIL THIS SLICE, and saying it did was the error a
// review caught. `mapUnionRetName` and `refArmUnionRetName` gated on `members.length >= 2` and
// `hasMap`/`hasList` and counted NO non-null members — and `TY_NULL` is a `TyPrim`, so both
// admitted it. `S[] | null` and `null | {[string]:f32}` therefore reached those producers with
// ONE real member, are not registrable (`registerInlineUnion` diverts such a name to its non-null
// part and never pushes the composite), and would have been pinned here against a union with no
// box. Both producers now carry the `>= 2 non-null` gate their sibling `variantBoxUnionRetName`
// already had, so the chain closes BY CONSTRUCTION rather than by survey.
//
// AND IT REMOVES A SAFETY NET, which is the honest cost. `isUName` doubled as an INTERLOCK: "pin
// only a union the emitter actually registered". Where the chain declines, the row reaches no arm
// and stays un-pinned; after this it is pinned against a union with no `uBox`. Not observable
// today — the four contracts and `isVariantBoxUnionAtoms` agree — but the failure mode on the
// first divergence changes from "silently un-pinned" to "pinned at a shape with no box".
// The PLAIN-STRUCT-ELEMENT-LIST rung (`structElemListRetName`), for `synthRetAnnots`' arm 11 —
// the ONE arm of that cascade's six-arm tail with a measurable effect on the corpus (forcing it
// off moves 5 rows; the other five move 0 apiece).
export function inferRetRungIsStructElemList(i: i32): boolean {
  inferRetRungAt(i) == IR_RUNG_STRUCT_ELEM_LIST
}

export function inferRetRungIsBoxedUnion(i: i32): boolean {
  const r = inferRetRungAt(i)
  if r == IR_RUNG_VALUE_UNION { return true }
  if r == IR_RUNG_LITUNION_ARR_VU { return true }
  if r == IR_RUNG_STRUCT_UNION { return true }
  if r == IR_RUNG_CLO_ARM_VU { return true }
  if r == IR_RUNG_MAP_UNION { return true }
  if r == IR_RUNG_REFARM_UNION { return true }
  if r == IR_RUNG_VARIANT_BOX { return true }
  if r == IR_RUNG_LITUNION_ALIAS { return true }
  false
}

// The fall-through's SCALAR-LIST leg. `isScalarListRetName`'s admitted set is exactly
// {"i64[]", "f32[]", "f64[]"} — `arrElemNameRaw` rejects anything not ending `[]` and otherwise
// drops exactly those two characters, so `arrElemNameRaw(nm) == "f64"` IFF `nm == "f64[]"`. Arm
// 9's own three-way predicate is the same three strings, from the same single home for the cut.
export function inferRetRungIsScalarListRet(i: i32): boolean {
  inferRetRungAt(i) == IR_REC_SCALAR_LIST
}

// Rungs 6 and 7 — `nullableRetName` and `nulLitUnionRetName`, the only producers that mint a
// TOP-LEVEL nullable name. Both mint `<part> + "|null"` and nothing else, so a consumer asking
// "is this row's name a nullable" is asking exactly which producer answered.
export function inferRetRungIsNullable(i: i32): boolean {
  const r = inferRetRungAt(i)
  r == IR_RUNG_NULLABLE || r == IR_RUNG_NUL_LITUNION
}

export function inferRetTyAt(i: i32) {
  if i < 0 || i >= inferRetTy.length { return "" }
  inferRetTy[i]
}
// The `Ty`-arena index of the `i`th recorded inferred return (`-1` if none) — the emitter's
// `collectU` drives the structural arena walks off this so an inferred return's reachable
// unions/closures register/intern exactly like an annotated one.
export function inferRetTyIxAt(i: i32) {
  if i < 0 || i >= inferRetTyIx.length { return -1 }
  inferRetTyIx[i]
}

// The emitter reads this to classify an un-annotated binding (`const x = if c then v
// else null`) from its inferred value-union TYPE name (keyed by LetDecl node index),
// rather than re-deriving it from the initializer expression. "" when the binding is
// not an inferred value union. Iteration mirrors the inferred-return table so the
// emitter's `collectU` interns every inferred binding union's box reps too.
export function inferLetNameOf(letIx: i32) {
  let i = 0
  while i < inferLetIx.length {
    if inferLetIx[i] == letIx { return inferLetTy[i] }
    i = i + 1
  }
  ""
}
export function inferLetCount() { inferLetIx.length }
export function inferLetIxAt(i: i32) { inferLetIx[i] }
// TYPED-IR FOUNDATION: the resolved type-arena index the checker recorded for AST node
// `ix`, or -1 if none (an emitter-synthesized node, or a node never checked). The emitter
// reads the `Ty` at this index (`T.tys[...]`) to lower the node by its checked type rather
// than re-deriving it syntactically.
export function nodeTyIxOf(ix: i32) {
  if ix >= 0 {
    if ix < nodeTyIx.length { return nodeTyIx[ix] }
  }
  -1
}
// ANNOTATION ATOM COUNT (#1055): how many TOP-LEVEL `|`-joined atoms the annotation node
// `ix`'s emit-time spelling has — the number `splitUnionAtoms(tyNameOf(ix)).length` would
// re-derive, banked by `canonEmitTypeNames`, the pass that PRODUCED that spelling.
// -1 for a node that is not a `TypeRef` (no annotation spelling) and for a node that
// postdates the bank (an emitter-synthesized annotation); >= 1 otherwise.
export function annUnionAtomsOf(ix: i32) {
  if ix >= 0 {
    if ix < annUnionAtoms.length { return annUnionAtoms[ix] }
  }
  -1
}
// The arena type the `is` test at node `ix` checks AGAINST — what the narrowing binds the
// tested place to — or -1 for a node the checker never resolved (an emitter-synthesized
// `is`, or a non-`IsExpr` node). Recorded by `checkIsExprNode`.
export function isVarTyIxOf(ix: i32) {
  if ix >= 0 {
    if ix < isVarTyIx.length { return isVarTyIx[ix] }
  }
  -1
}
// The CONTEXT-RESOLVED companion of `nodeTyIxOf` (rep-twin-matcher phase 0a). Returns the
// destination type recorded by `recordRepTyAdopt` at an adoption site when present, else the
// naive `nodeTyIxOf`. The emitter's rep/layer resolvers key on THIS so a widened literal's row
// resolves to the shape the emitter actually builds. No consumer yet (phase 0a is byte-identical).
export function nodeRepTyIxOf(ix: i32) {
  if ix >= 0 {
    if ix < nodeRepTyIx.length {
      const r = nodeRepTyIx[ix]
      if r >= 0 { return r }
    }
  }
  nodeTyIxOf(ix)
}
// Stamp the CONTEXT (destination) type `dstTy` onto a literal source `srcExpr` (and, recursively,
// onto its ObjLit fields / ArrayLit elements against the corresponding destination sub-types) in
// the `nodeRepTyIx` sidecar. Called at the arena-pure ADOPTION sites (an ObjLit/ArrayLit widened
// into a union-field / nullable-niche / i64 destination): the literal's OWN checked type is its
// naive self-inference, but the emitter builds the rep for the destination, so the sidecar carries
// it. PURE — reads only `T.tys`/`P.nodes`, writes only `nodeRepTyIx`, so it cannot perturb any
// existing checker/emitter behavior. Nullable wrappers are peeled (the emitter's struct row is the
// inner shape). Recursive destinations are declined (`tyDeeperThan(…,16)`, mirroring
// `recordNullHoleObjAdopt`): a recursive re-stamp would send the emitter's back-edge-free canon
// render into unbounded recursion. Returns 1 when this node was stamped.
function recordRepTyAdopt(srcExpr: i32, dstTy: i32, depth: i32) {
  if inferQuiet || srcExpr < 0 || dstTy < 0 || depth <= 0 { return 0 }
  if tyDeeperThan(dstTy, 16) { return 0 }
  let dtix = dstTy
  let peel = true
  while peel {
    const dN = T.tys[dtix]
    if dN is TyNullable {
      if dN.nInner < 0 { return 0 }
      dtix = dN.nInner
    } else {
      peel = false
    }
  }
  const d = T.tys[dtix]
  const e = P.nodes[srcExpr]
  if e is Paren {
    recordRepTyAdopt(e.parInner, dtix, depth)
    while nodeRepTyIx.length <= srcExpr { nodeRepTyIx.push(-1) }
    nodeRepTyIx[srcExpr] = dtix
    return 1
  }
  if e is ObjLit {
    if d is TyObj {
      const dfn = d.objFieldNames
      const dft = d.objFieldTypes
      let k = 0
      while k < e.objFields.length {
        const f = P.nodes[e.objFields[k]]
        if f is FieldInit {
          let j = 0
          while j < dfn.length {
            if dfn[j] == f.fiName {
              recordRepTyAdopt(f.fiValue, dft[j], depth - 1)
            }
            j = j + 1
          }
        }
        k = k + 1
      }
      while nodeRepTyIx.length <= srcExpr { nodeRepTyIx.push(-1) }
      nodeRepTyIx[srcExpr] = dtix
      return 1
    }
    // A nested ObjLit whose destination is a UNION (a struct arm boxed into a union
    // FIELD): pick the first struct member whose field-name set corresponds and recurse
    // against that concrete arm — the arm is the shape the emitter builds. A best-effort
    // structural match (no `assignableExpr` re-entry, keeping the recorder side-effect free).
    if d is TyUnion {
      const members = d.uMembers
      let mi = 0
      while mi < members.length {
        const mt = T.tys[members[mi]]
        if mt is TyObj {
          if objLitFieldsCorrespond(e, mt) {
            return recordRepTyAdopt(srcExpr, members[mi], depth)
          }
        }
        mi = mi + 1
      }
      return 0
    }
    return 0
  }
  if e is ArrayLit {
    if d is TyArray {
      let i = 0
      while i < e.arrElems.length {
        recordRepTyAdopt(e.arrElems[i], d.aElem, depth - 1)
        i = i + 1
      }
      while nodeRepTyIx.length <= srcExpr { nodeRepTyIx.push(-1) }
      nodeRepTyIx[srcExpr] = dtix
      return 1
    }
    // An array literal boxed into a union arm — recurse against the first array member.
    if d is TyUnion {
      const members = d.uMembers
      let mi = 0
      while mi < members.length {
        const mt = T.tys[members[mi]]
        if mt is TyArray {
          return recordRepTyAdopt(srcExpr, members[mi], depth)
        }
        mi = mi + 1
      }
      return 0
    }
    return 0
  }
  0
}
// True when the ObjLit `e`'s field-name set corresponds one-to-one with the struct type `mt`'s
// declared field names (order-independent). Structural fieldset check for `recordRepTyAdopt`'s
// union-arm pick — the recorder's own light dual of `objLitWidenFields`' correspondence, without
// the assignability re-entry.
function objLitFieldsCorrespond(e: ObjLit, mt: TyObj): boolean {
  const dfn = mt.objFieldNames
  if e.objFields.length != dfn.length { return false }
  let k = 0
  while k < e.objFields.length {
    const f = P.nodes[e.objFields[k]]
    if f is FieldInit {
      let found = false
      let j = 0
      while j < dfn.length {
        if dfn[j] == f.fiName { found = true }
        j = j + 1
      }
      if !found { return false }
    } else {
      return false
    }
    k = k + 1
  }
  true
}
// EMIT-TIME typed-IR coverage (C1 endgame): copy the type the checker already recorded on `srcNode`
// onto a SYNTHESIZED annotation node `destNode`. Used where the synthesis name is an emitter-internal
// form `nameToTy` can't resolve (an interned anonymous shape `#anonN`), but the source param/expr node
// carries the real arena type. Grows the flat table as needed.
export function recordNodeTyFrom(destNode: i32, srcNode: i32) {
  if destNode < 0 { return 0 }
  const ty = nodeTyIxOf(srcNode)
  while nodeTyIx.length <= destNode { nodeTyIx.push(-1) }
  nodeTyIx[destNode] = ty
  0
}
// The lazily-built placeholder `TyFunc` for closure pins — only its `is TyFunc`-ness is read (via
// `nodeTyIsFunc`); the real signature rides the PIN COLUMN's payload. Reset per program.
function funcPinTyIx() {
  if cFuncPinTyIx < 0 {
    const ps: i32[] = []
    cFuncPinTyIx = mkFuncTy(ps, -1)
  }
  cFuncPinTyIx
}
// The lazily-built placeholder `TyObj` for interned anonymous shapes — only its `is TyObj`-ness is
// read (`nodeTyIsStruct`); the real layout rides the `#anonN` NAME (the emitter's `sNames` table).
function objPinTyIx() {
  if cObjPinTyIx < 0 {
    const ns: string[] = []
    const ts: i32[] = []
    cObjPinTyIx = mkObjTy(ns, ts)
  }
  cObjPinTyIx
}
// THE PIN COLUMN's WRITER. `kind`/`payload` describe node `nodeIx`'s provenance; a
// `PIN_NONE` write is the no-op that keeps an ordinary synthesized annotation out of
// the column entirely (so a reader's "" / `PIN_NONE` answer is unambiguously "not a
// pin", with no need to size the table to the arena).
export function recordNodePin(nodeIx: i32, kind: i32, payload: string) {
  if nodeIx < 0 { return 0 }
  if kind == PIN_NONE { return 0 }
  while nodePinKind.length <= nodeIx {
    nodePinKind.push(PIN_NONE)
    nodePinPay.push("")
  }
  nodePinKind[nodeIx] = kind
  nodePinPay[nodeIx] = payload
  0
}
// The pin KIND recorded for node `ix` (`PIN_NONE` when it carries no pin).
export function nodePinKindOf(ix: i32) {
  if ix < 0 { return PIN_NONE }
  if ix >= nodePinKind.length { return PIN_NONE }
  nodePinKind[ix]
}
// The pin PAYLOAD recorded for node `ix` — for `PIN_SIGKEY`, the `$fnsig` key the
// monomorphizer resolved for the closure argument that pinned this parameter. ""
// when the node carries no pin. THE read `emit_classify.paramCloSigKey` makes
// instead of slicing the marker off the node's name.
export function nodePinPayloadOf(ix: i32) {
  if ix < 0 { return "" }
  if ix >= nodePinPay.length { return "" }
  nodePinPay[ix]
}
// EMIT-TIME typed-IR coverage (C1 endgame): the monomorphizer CLONES a generic instance's body,
// creating fresh annotation nodes whose type-param names are substituted to CONCRETE names — these
// nodes fall PAST the checker-sized `nodeTyIx` (so a structural classifier reads -1 and falls back to
// the name). Resolve the concrete substituted `name` and record it on the new node so the emitter's
// arena-reading classifiers cover monomorphized instances too. `name` is already concrete (no TyVar),
// so `nameToTy` resolves it under the empty type-param env. Idempotent; grows the flat table as needed.
//
// `pin` is the node's PIN COLUMN entry (`PIN_*`), supplied by the mint. It is only
// consulted when `nameToTy` declines, which is exactly when the name is an
// emitter-internal handle rather than a type spelling:
//
//   PIN_SIGKEY — a monomorphizer closure pin. It IS a function type, so record the
//     placeholder `TyFunc` and `nodeTyIsFunc` classifies it structurally. The real
//     signature rides the pin column's payload, not this arena entry.
//   PIN_ANON — an interned anonymous shape. It IS a struct-shaped object, so record
//     the placeholder `TyObj` for `nodeTyIsStruct`. The real layout rides `sNames`.
//
// Both used to be decided HERE by prefix-testing `name` (`'='`,`'>'` / `'#'`,`'a'`,
// `'n'`,`'o'`,`'n'`) — seven character compares reading a provenance marker out of
// a column that is supposed to hold a NAME (census W11).
// RETURNS the recorded arena index (-1 when nothing resolved), so a caller that
// already needs the pinned type as a VALUE reads it here instead of re-resolving the
// same spelling later. The monomorphizer's speculative-inference windows
// (`monoInferListElem` / `monoInferLocalScalar`) are index-fed from exactly this
// return — the only producer of those indices, and the reason they take no names.
export function nameMentionsGenAliasParam(nm: string): boolean {
  let i = 0
  while i < gaParamNames.length {
    if nameMentionsIdent(nm, gaParamNames[i]) { return true }
    i = i + 1
  }
  false
}

export function recordClonedNodeTy(nodeIx: i32, name: string, pin: i32) {
  recordClonedNodeTyKnown(nodeIx, name, pin, -1)
}

// `recordClonedNodeTyKnown` with the handed type as a FALLBACK instead of an override: the
// NAME is resolved first and wins wherever it resolves, and `tyFb` is consulted only where
// it does NOT — the position that otherwise records a COARSE PLACEHOLDER
// (`funcPinTyIx` / `objPinTyIx`).
//
// WHAT READS THIS, so the next slice checks the right thing: for a monomorphized param the
// recorded type is banked into `emit_mono`'s `pinnedTyIx` column and handed to
// `monoInferListElem` / `monoInferLocalScalar`, which `declare` it and RE-CHECK the generic
// body — and that check's result becomes the instance's synthesized RETURN annotation. So a
// changed answer here can move emitted bytes; it is not confined to one node's sidecar.
// Measured for this change: 0 of 2,017 corpus rows move.
//
// The precedence is the whole point, and it is measured rather than chosen. Over the corpus
// the monomorphizer's pinned names resolve and AGREE with the argument's recorded type 838
// times; they resolve and DISAGREE 119 times (dominated by an argument type that renders
// empty, plus the genuine `i64` pin over an `i32` literal, where the NAME is the correct
// answer and an override would be a wrong pin); and they FAIL TO RESOLVE 77 times. Those 77
// are the emitter's own synthetic spellings — `#anon0` for an interned anonymous shape,
// `=>ii>i` for a `$fnsig` key — names that exist ONLY as strings and that `nameToTy` was
// never able to parse back. A placeholder is all the name path can offer there; the handed
// arena type is the real one.
export function recordClonedNodeTyFb(
  nodeIx: i32,
  name: string,
  pin: i32,
  tyFb: i32,
) {
  if nodeIx < 0 { return -1 }
  let ty = nameToTy(name)
  if ty < 0 {
    // `PIN_SIGKEY` ONLY — one pin, not both, and excluding `PIN_ANON` is a MEASURED RESULT
    // rather than caution. DO NOT "complete" this by adding the ANON arm.
    //
    // The two look identical from here: both spellings (`=>ii>i`, `#anon0`) are ones the
    // EMITTER minted for itself, `nameToTy` can parse neither, and both fall through to a
    // coarse placeholder below. They are not identical.
    //
    // A `$fnsig` key is a pure ENCODING of a function type and carries no identity of its
    // own, so the argument's arena `TyFunc` is strictly more information about the same
    // type. `#anonN` is THE NAME OF A SPECIFIC INTERNED ROW in the emitter's shape table,
    // and that row identity is not something the checker's arena carries — a structurally
    // EQUAL argument type is a DIFFERENT row. Recording it for an ANON pin turned five
    // `tests/cases/inference/hole-*` chains from running into
    // `struct.get expected (ref null 0), found local.get of type i32`: a derived hole
    // marker is deliberately left unresolved here for the inference to re-base later, and
    // the concrete type pinned shut a slot that had to stay open.
    //
    // Isolated by enabling the two arms separately — SIGKEY alone is green everywhere,
    // SIGKEY+ANON reddens exactly those five. So of the 77 unresolvable sites the header
    // counts, the ANON majority is NOT convertible by this route.
    if pin == PIN_SIGKEY { ty = tyFb }
  }
  if ty < 0 {
    if pin == PIN_SIGKEY { ty = funcPinTyIx() }
    else if pin == PIN_ANON { ty = objPinTyIx() }
  }
  while nodeTyIx.length <= nodeIx { nodeTyIx.push(-1) }
  nodeTyIx[nodeIx] = ty
  ty
}

// THE HAND-OVER FORM. `recordClonedNodeTy` above resolves the synthesized NAME by parsing
// it — which is the shape the destringify programme exists to remove, at its purest where
// the producer BUILT that name out of parts it already held (`emit_rewrite`'s
// `lt.tyName + "[]"` appends a suffix and this parses it straight back off).
//
// `tyIn >= 0` means the caller already holds the arena index and hands it over; the parse
// is then not skipped by a shortcut, it never happens. `-1` keeps the old route for the
// callers that genuinely only have a name.
//
// The name is still recorded on the node — it is the node's `tyName`, read by consumers
// that have not been converted — so this removes the PARSE, not yet the spelling.
//
// SIBLING WARNING: `recordClonedNodeTyFb` above has the IDENTICAL signature and the
// OPPOSITE precedence — there the NAME wins and the handed index only fills a gap.
// Passing one where the other is meant compiles silently and inverts the resolution order.
export function recordClonedNodeTyKnown(
  nodeIx: i32,
  name: string,
  pin: i32,
  tyIn: i32,
) {
  if nodeIx < 0 { return -1 }
  let ty = tyIn
  if ty < 0 { ty = nameToTy(name) }
  if ty < 0 {
    if pin == PIN_SIGKEY { ty = funcPinTyIx() }
    else if pin == PIN_ANON { ty = objPinTyIx() }
  }
  while nodeTyIx.length <= nodeIx { nodeTyIx.push(-1) }
  nodeTyIx[nodeIx] = ty
  ty
}
// The arena index of the `i32` primitive. The monomorphizer's all-i32 param arm mints no
// annotation node at all (`parType` stays -1), so it has no `recordClonedNodeTy` return to
// bank; this is the one type it needs and the constant is here rather than exported mutable.
export function i32TyIx() { TY_I32 }
// The primitive-type NAME the checker recorded for node `ix` — `T.tys[nodeTyIx[ix]]`'s
// `primName` when it resolved to a `TyPrim` (`i32`/`i64`/`f64`/`f32`/`boolean`/…), else "".
// A STRUCTURAL query over the `Ty` arena — the emitter's scalar classifiers read this
// instead of string-testing the parser's synthetic annotation name (`tyNameOf`), so a
// scalar rep is decided from the checked type, not a re-parsed name (C1).
export function nodeTyPrimName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyPrim { return t.primName }
  ""
}
// STRUCTURAL: node `ix`'s recorded type is a FUNCTION type (`TyFunc`). The emitter's closure
// classifier reads this instead of a depth-aware `=>` arrow test on the name — a `TyFunc` is a
// bare function value, while a func ARRAY (`((i32)=>i32)[]`) is a `TyArray` and a nullable
// closure (`((i32)=>i32)|null`) a `TyNullable`, so the structure excludes those for free (C1).
export function nodeTyIsFunc(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyFunc { return true }
  false
}
// STRUCTURAL: the wasm ELEMENT-REP name of the array type the checker recorded for node `ix`,
// normalized to the emitter's list-rep vocabulary — "i32" (an `i32[]`, a `boolean[]`, or a
// literal-union `K[]`: all share the i32 atom backing), "f64"/"f32"/"i64" (scalar-elem lists),
// "string" (a `string[]`), or "" when the node isn't a recorded array (or its element is a ref
// / nested list). The emitter's `ret*ArrFlag` classifiers read this instead of `nameIsX[]`
// string tests on the synthetic name (C1). Mirrors `nameIsI32Array`/`nameIsF64Array`/… exactly.
// The `primName` of `ty`'s ARRAY ELEMENT, or "" unless `ty` is a `TyArray` whose element is a
// bare `TyPrim`. The arena twin of the `arrElemNameRaw(name) == "<scalar>"` cut, factored here so
// its consumers read one line and a sixth element kind has one home to be added to.
//
// DELIBERATELY UNFILTERED — it answers `boolean` too. A consumer that must stay as narrow as the
// name cut applies its own whitelist; folding one in here would make the helper's answer depend
// on which caller was written first.
export function tyArrayElemPrimName(ty: i32): string {
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem >= 0 {
      const el = T.tys[t.aElem]
      if el is TyPrim { return el.primName }
    }
  }
  ""
}

export function nodeTyArrayElemRepName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyArray {
    const e = t.aElem
    if e >= 0 {
      const et = T.tys[e]
      if et is TyPrim {
        if et.primName == "boolean" { return "i32" }
        return et.primName
      }
      // A `(boolean | null)[]` element — the boolean SENTINEL niche — shares the i32
      // backing (0/1, spare 2 = null), so its list reps as an i32 list. Only the
      // `null → 2` element coercion + sentinel read/print differ.
      if et is TyNullable {
        const en = T.tys[et.nInner]
        if en is TyPrim {
          if en.primName == "boolean" { return "i32" }
          // A `(string | null)[]` element — the string ref made nullable. A `string[]`
          // element is ALREADY `(ref null $aTypeIdx)` at the wasm level, so the nullable
          // element shares the EXACT strlist backing; only `null → ref.null` construct +
          // the element READ (kept `(ref null)`, narrowed) differ. Reps as a string list.
          if en.primName == "string" { return "string" }
        }
      }
      if tyIsLitUnion(e) { return "i32" }
      // A `(K | null)[]` element — the litunion atom NICHE — shares the i32 backing (member ids ≥ 0,
      // spare `-1` = null), so its list reps as an i32 list, exactly like the non-null `K[]` above.
      // Both the ADOPTED `TyNullable`-inner form and the INFERRED `"a" | null` expanded-union form
      // classify (`tyIsNullableLitUnion`). Only the `null → -1` element coercion + the sentinel read
      // differ. Without this the element rep fell through to "" and the list defaulted to a string ref
      // list, mismatching the i32 construct/read.
      if tyIsNullableLitUnion(e) { return "i32" }
    }
  }
  ""
}
// STRUCTURAL: the WIDENED scalar rep of node `ix`'s type — like `nodeTyPrimName`, but a string
// literal union (`"a"|"b"`) reports "string" (it widens one-way to `string`; at an annotation-rep
// site it classifies as string exactly as its canon-collapsed name does). "" for a non-prim /
// non-litunion. Lets the `string` classifier read the arena without misclassifying a litunion. C1.
export function nodeTyWidenedRepName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyPrim { return t.primName }
  if tyIsLitUnion(ty) { return "string" }
  // A SINGLE literal type (`: "world"`, `: 1.5`, `: 7`) or a HOMOGENEOUS NUMERIC
  // literal union (`1.5 | 2.5`, `0 | 1`) has no `TyPrim` of its own but reps as its
  // base scalar — EXACTLY the softening `canonEmitName` applies to the annotation NAME
  // (`softenLitTy` then `tyLitBaseName`: `"…"` → "string", a float → "f64", an int →
  // "i32"/"i64"). Since C1
  // the arena is the primary classifier, so this MUST agree with the softened name: the
  // annotation node's functype/let/param/field rep is the widened scalar, matching the
  // widened VALUE it constrains (a `"world"` return is a string ref, a `1.5` return an
  // f64). Without this a bare `TyLit` fell to the `""`/i32 default while its value emitted
  // a string/f64 — INVALID WASM ("expected i32, found (ref $type)"). A string-atom litunion
  // ALIAS (`type K = "a"|"b"`) stays the interned i32 atom (`tyIsLitUnion` above / the
  // `nodeTyIsLitUnionAlias` guards in `vtKindOfType`/`retStrFlag`); `softenLitTy` widens
  // ONLY homogeneous-base literal sets (a mixed `"a"|7` stays the value-union box).
  const soft = softenLitTy(ty)
  if soft != ty {
    const st = T.tys[soft]
    if st is TyPrim { return st.primName }
  }
  ""
}
// STRUCTURAL: node `ix`'s type is `string | null` (kind 16 nullable raw-array ref) — a
// `TyNullable` whose inner is the `string` prim. A `K | null` litunion niche is NOT this (its
// inner is a `TyUnion`), matching `nullablePartOf(name) == "string"`. C1.
// PAIRED WITH `nodeTyIsNullableString`, and they answer DIFFERENT questions despite differing
// by one syllable. This one demands a `TyNullable` over a bare `TyPrim "string"` — the shape an
// ANNOTATION records. Its sibling delegates to `tyEmitNameIsString`, which also accepts a `TyLit`
// of `litKind == "str"` and a `TyUnion` whose members all render `string`, and is asked of an
// EXPRESSION node's recorded join type. Converting a name test to the wrong one of the pair
// narrows silently: `"world" | null` and `("a" | "b" | string) | null` reach the sibling and not
// this.
export function nodeTyIsNulString(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    const inner = T.tys[t.nInner]
    if inner is TyPrim { return inner.primName == "string" }
  }
  false
}
// STRUCTURAL: node `ix`'s type is `boolean | null` (the i32 sentinel-2 niche) — a
// `TyNullable` whose inner is the `boolean` prim. Lets `exprNulBool` recover the niche
// from the checker's recorded type for an expression whose syntactic form it can't trace
// (a `(boolean | null)[]` element read `p[i]`, an inferred `const t = p[i]`), so the
// `!= null` / `?? d` / print routes to the sentinel compare. Mirrors `nodeTyIsNulString`.
export function nodeTyIsNulBool(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    const inner = T.tys[t.nInner]
    if inner is TyPrim { return inner.primName == "boolean" }
  }
  false
}
// STRUCTURAL: node `ix`'s type is a nullable NUMERIC scalar (`i32 | null`, `i64 | null`,
// `f64 | null`, `f32 | null`) — a `TyNullable` whose inner numeric prim has no spare value to
// niche into, so the value reps as the value-union {tag, value} BOX (`repOfNullable`'s scalar
// arm). The niche nullables (`string | null`, `boolean | null`, litunion/struct/closure/list
// `| null`) are structurally excluded — they are NOT box values and must not classify union.
export function nodeTyIsNulScalarBox(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    const inner = T.tys[t.nInner]
    if inner is TyPrim {
      return (inner.primName == "i32" ||
        inner.primName == "i64" ||
        inner.primName == "f64" ||
        inner.primName == "f32")
    }
  }
  false
}
// STRUCTURAL: node `ix`'s type is `((…) => …) | null` (kind 19 nullable closure) — a `TyNullable`
// whose inner is a `TyFunc`. Mirrors `nameIsNulClosure`; the structure excludes a nullable
// non-closure for free. C1.
// STRUCTURAL: node `ix`'s type is `i32[] | null` / `boolean[] | null` (kind 15, nullable i32-list) —
// a `TyNullable` whose inner is an array of the `i32`/`boolean` prim (both i32-repped). A litunion
// array is EXCLUDED, matching `nameIsNulI32List` (which tests `"i32[]"`/`"boolean[]"` only). C1.
export function nodeTyIsNulI32List(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    const it = T.tys[t.nInner]
    if it is TyArray {
      const e = it.aElem
      if e >= 0 {
        const et = T.tys[e]
        if et is TyPrim {
          return et.primName == "i32" || et.primName == "boolean"
        }
        // A literal-union element (`K[] | null`, `("a"|"b")[] | null`) — its atoms are
        // interned i32 ids, sharing the i32-list backing/rep exactly like `i32[]` (the arena
        // dual of `nameIsI32Array`'s litunion arm). A scalar-elem / ref-elem list is not this.
        if tyIsLitUnion(e) { return true }
        // A NICHE-nullable i32-backed element (`(K | null)[] | null`, `(boolean | null)[] |
        // null`): the element's null rides IN the i32 (`-1` / 2 sentinel), so the list is the
        // SAME i32 backing and the outer `| null` is the same `(ref null $lTypeIdx)` niche —
        // the arena dual of `nameIsI32Array`'s nul-litunion/nul-boolean arms.
        if tyIsNullableLitUnion(e) { return true }
        if et is TyNullable {
          const ei = T.tys[et.nInner]
          if ei is TyPrim { return ei.primName == "boolean" }
        }
      }
    }
  }
  false
}
// STRUCTURAL: node `ix`'s type is an ARRAY OF FUNCTIONS (`((i32)=>i32)[]`) — a `TyArray` whose
// element is a `TyFunc` (a closure-element ref list, kind 5). Mirrors `nameIsClosureArray`. C1.
export function nodeTyIsClosureArray(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyArray {
    const e = t.aElem
    if e >= 0 {
      const et = T.tys[e]
      if et is TyFunc { return true }
    }
  }
  false
}
// Linear membership over a small nominal-index set (a handful of struct/variant decls per program).
function cTyIxListHas(xs: i32[], v: i32) {
  let i = 0
  while i < xs.length {
    if xs[i] == v { return true }
    i = i + 1
  }
  false
}
// STRUCTURAL (C1): node `ix`'s recorded type IS a declared struct and NOT a union-variant member —
// the nominal analogue of the emitter's `isSName(tyNameOf(ix))`, read from the checker's arena-index
// sets instead of an O(nodes) `nameIsStructDecl` AST scan. Under-approximates (a struct not covered by
// `nodeTyIx`, or a UnionDecl struct-alias, reads false) so callers keep the name test as the fallback.
export function nodeTyIsStruct(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  if cTyIxListHas(cVariantMemberTyIxs, ty) { return false }
  if cTyIxListHas(cStructTyIxs, ty) { return true }
  const t = T.tys[ty]
  if t is TyObj { return true }
  if t is TyUnion {
    // A struct-alias union — a canonicalized `{a} & {b}` object intersection wraps its single merged
    // object shape in a one-member union; the emitter interns it as a struct (`isSName`), so match it.
    if t.uMembers.length == 1 {
      const m = T.tys[t.uMembers[0]]
      if m is TyObj { return true }
    }
  }
  false
}
// STRUCTURAL (C1): node `ix`'s recorded type IS an OBJECT union-variant member — the nominal analogue
// of `variantIndexOf(tyNameOf(ix)) >= 0`, read from the checker's variant-member arena-index set. The
// `is TyObj` guard excludes a TRANSPARENT single-member PRIMITIVE alias (`type Id = i32`, a one-member
// union whose member `i32` lands in the set but denotes the scalar, not a variant box). Confirms only.
export function nodeTyIsVariant(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  if !cTyIxListHas(cVariantMemberTyIxs, ty) { return false }
  const t = T.tys[ty]
  if t is TyObj { return true }
  false
}
// STRUCTURAL (C1): node `ix`'s recorded type is a NULLABLE declared struct (`S | null`) — a
// `TyNullable` whose inner is a declared struct (never a variant member, never `string | null`,
// which its `TyPrim` inner already excludes). The nominal analogue of `retNulRefFlag`'s name path.
// PAIRED WITH `nodeTyIsNullableStruct`, and the split runs the OTHER way from the string pair.
// This one accepts an inner registered in `cStructTyIxs` OR a bare `TyObj`, and EXCLUDES variant
// members. Its sibling is only `it is TyObj` — so it misses a declared struct whose arena entry is
// nominal rather than a bare `TyObj` (the struct-alias one-member `TyUnion` shape
// `nodeTyIsStruct` handles), and it does not exclude variant members. Same naming distance,
// opposite direction of narrowness: read the bodies, not the names.
export function nodeTyIsNulStruct(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    const inner = t.nInner
    if inner < 0 { return false }
    if cTyIxListHas(cVariantMemberTyIxs, inner) { return false }
    if cTyIxListHas(cStructTyIxs, inner) { return true }
    const it = T.tys[inner]
    if it is TyObj { return true }
    return false
  }
  false
}
// STRUCTURAL (C1): node `ix`'s recorded type is an ARRAY of a declared struct (`S[]`) — the clean
// base case of the emitter's recursive `nameIsRefArray`. Confirms ONLY the plain struct-element list
// (element in `cStructTyIxs`, not a variant member); nested / union / value-union / closure / nullable
// ref arrays fall to the name path. So a caller stays byte-identical (confirm-only + name fallback).
export function nodeTyIsStructArray(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyArray {
    const e = t.aElem
    if e < 0 { return false }
    if cTyIxListHas(cVariantMemberTyIxs, e) { return false }
    if cTyIxListHas(cStructTyIxs, e) { return true }
    const et = T.tys[e]
    if et is TyObj { return true }
    return false
  }
  false
}
// STRUCTURAL (C1): node `ix`'s recorded type is a DECLARED value-union alias box (`type T = A | B`) —
// the nominal analogue of the emitter's `isUName`. Confirms only a declared union (`cUnionTyIxs`) with
// 2+ members that is NOT a string litunion (`tyIsLitUnion`, which boxes as an i32 atom, not a union) —
// so a single-member struct-alias union and a litunion both fall to the name path.
// STRUCTURAL (C1): node `ix`'s type is a DECLARED litunion ALIAS (`type K = "a" | "b"`) — its arena
// index is a registered union alias (`cUnionTyIxs`) that is a litunion. Matches `nameIsLitUnionType` at
// emit time: `canonEmitTypeNames` softens an INLINE `"a" | "b"` annotation to `string` (string rep), but
// an alias keeps its name (atom rep), so only aliases classify as litunions here.
// STRUCTURAL (C1): node `ix`'s type is a nullable litunion (`K | null` / `"a" | "b" | null`) — the
// per-NODE form of `tyIsNullableLitUnion`, which is THE ONE HOME of the question. Matches
// `nameIsNulLitUnion`: `canonEmitTypeNames` PRESERVES a nullable litunion's members
// (`nulLitUnionPreserve`), so BOTH inline and aliased forms classify here.
//
// D-NULLITHOME: this body used to be a PRIVATE COPY that handled only the `TyNullable` form
// (`K | null`) and answered NO for the EXPANDED `TyUnion` form (a null member plus all-quoted
// literal members) that `tyIsNullableLitUnion` — 500 lines below, in this same file — has always
// accepted. `type K = "ab" | "zz" | null` interns as that expanded union, so the niche arm of
// `globalCellKind` (and of `buildLocals`, the param ladder and the return ladder) declined and the
// cell was built as a union BOX, while every READ classified from the arena, where the alias and
// the inline spelling are one type, and lowered the atom niche — `struct.get`-free
// `call __print_i32__` on a `(ref $box)`, i.e. INVALID WASM, at every construction site. The
// header above already CLAIMED both forms classify here; only the body disagreed.
//
// The variant dispatch below is the retiring copy's CHEAP REJECT, kept (#1138): only a
// `TyNullable` (the two-part `K | null`) or a `TyUnion` (the expanded `"a" | "b" | null`) can be
// this niche, and every OTHER arena variant is the overwhelming majority of what this is asked
// about — 13.4M entries per corpus sweep. A bare `tyIsNullableLitUnion(nodeTyIxOf(ix))`
// delegation is CORRECT and was measured: it doubles that home's entries (+17.5M, +90%) because
// every non-union node pays a call to re-derive a reject this test settles in place. Both live
// arms still delegate, so the grammar has ONE home.
export function nodeTyIsNulLitUnion(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable { return tyIsNullableLitUnion(ty) }
  if t is TyUnion { return tyIsNullableLitUnion(ty) }
  false
}

// The declared ALIAS NAME of litunion TYPE index `ty` (`type K = "a" | "b"` → "K"), or "" when
// `ty` is not a registered litunion alias. Reverse of `cUserTypes` via the parallel
// `cUnionTyIxs`/`cUnionNames` arrays — used to pin an anonymous lambda's adopted litunion return
// as its alias (the alias reps as an i32 atom; the inline member spelling would rep as a string).
export function litUnionAliasNameOfTy(ty: i32) {
  if ty < 0 { return "" }
  if !tyIsLitUnion(ty) { return "" }
  let i = 0
  while i < cUnionTyIxs.length {
    if cUnionTyIxs[i] == ty { return cUnionNames[i] }
    i = i + 1
  }
  // STRUCTURAL fallback: an annotation position may REBUILD the alias's member union
  // at a fresh arena index, so the index compare misses and the member was
  // unnameable. An all-str-lit TyUnion in the arena is alias-derived
  // (`canonEmitTypeNames` softens INLINE litunion spellings to `string` — string
  // rep, never a lit-member TyUnion), so matching a registered litunion alias by
  // member-literal SET is exact, not a guess.
  const tu = T.tys[ty]
  if tu is TyUnion {
    const texts: string[] = []
    let m0 = 0
    while m0 < tu.uMembers.length {
      const mt = T.tys[tu.uMembers[m0]]
      if mt is TyLit { texts.push(mt.litText) }
      m0 = m0 + 1
    }
    return litUnionAliasOfLitTexts(texts)
  }
  ""
}

// The registered litunion ALIAS whose member-literal set is EXACTLY `texts` (`["pd",
// "42"]` -> "K0"), or "" — shared by the structural fallback above and the
// flattened-member regroup in `variantBoxUnionRetName`.
export function litUnionAliasOfLitTexts(texts: string[]): string {
  if texts.length == 0 { return "" }
  let a = 0
  while a < cUnionTyIxs.length {
    if tyIsLitUnion(cUnionTyIxs[a]) {
      const rt = T.tys[cUnionTyIxs[a]]
      if rt is TyUnion {
        if rt.uMembers.length == texts.length {
          let all = true
          let m = 0
          while m < texts.length {
            let found = false
            let r = 0
            while r < rt.uMembers.length {
              const rm = T.tys[rt.uMembers[r]]
              if rm is TyLit {
                if rm.litText == texts[m] { found = true }
              }
              r = r + 1
            }
            if !found { all = false }
            m = m + 1
          }
          if all { return cUnionNames[a] }
        }
      }
    }
    a = a + 1
  }
  ""
}
// The registered litunion ALIAS's OWN arena index whose member set is exactly the
// str-literal types `members` (`["aa","bb"]` -> `K`'s index), or -1.
//
// THE ARENA TWIN of `litUnionAliasOfLitTexts`, and it exists for the same reason one
// index apart: a NAME that is an intern key must be one name per type, and an arena
// INDEX that a classifier compares by identity must be one index per type.
// `nodeTyIsLitUnionAlias` / `litUnionAliasNameOfTy` / `noteLitUnionCopy` all ask
// `cTyIxListHas(cUnionTyIxs, ty)` — INDEX identity with a registered alias — so a
// FRESHLY MINTED union carrying exactly `K`'s members is not `K` to any of them.
// `tsToTy`'s union arm used to get that identity for free on the degenerate spellings
// (`K | K` deduped to ONE member and returned `K`'s own index); once the litunion
// flatten opens the member list that accident is gone, and this restores it as a rule.
export function litUnionAliasTyOfMembers(members: i32[]): i32 {
  if members.length < 2 { return -1 }
  const texts: string[] = []
  let i = 0
  while i < members.length {
    const m = T.tys[members[i]]
    if m is TyLit {
      if m.litKind != "str" { return -1 }
      texts.push(m.litText)
    } else {
      return -1
    }
    i = i + 1
  }
  let a = 0
  while a < cUnionTyIxs.length {
    const ti = cUnionTyIxs[a]
    if tyIsLitUnion(ti) {
      const rt = T.tys[ti]
      if rt is TyUnion {
        // AN EXACT SET, both directions. `>=` here is a silent TYPE WIDENING: a
        // 2-member annotation would adopt a 4-member alias's index, and `is
        // ("wa"|"wb")` over a `W4` value then answers TRUE for every member — a
        // guard that always fires, `vl check` clean. Pinned by
        // `tests/cases/literal-unions/union-of-litunions-flatten.vl`'s `widenGuard`.
        if rt.uMembers.length == texts.length {
          let all = true
          let mi = 0
          while mi < texts.length {
            let found = false
            let r = 0
            while r < rt.uMembers.length {
              const rm = T.tys[rt.uMembers[r]]
              if rm is TyLit {
                if rm.litText == texts[mi] { found = true }
              }
              r = r + 1
            }
            if !found { all = false }
            mi = mi + 1
          }
          if all { return ti }
        }
      }
    }
    a = a + 1
  }
  -1
}

// The atom WIDTH of the last `litUnionInlineNameOfTy` answer, and whether that union
// carried a `null` MEMBER — the arena twin of canon's `lupAtoms` / `nulLitUnionPreserve`'s
// `hasNull`. Banked rather than returned because a VL function has one result.
let luiAtoms = 1
let luiHasNull = false

// The INLINE spelling of the string-LITERAL run of union `ty`, from its arena members
// (`"a"|"b"`), or "" when `ty` is not a string-literal union. **The UN-ALIASED sibling of
// `litUnionAliasNameOfTy`, and the ARENA twin of canon's `litUnionPreserve`** — the two
// renderers had the alias half of this rule at six positions each and no leg at all for an
// inline litunion the program never named, so a keep-position `{tag: "a" | "b"}` was
// softened to `{tag:string}` while canon (whose `litUnionPreserve` has been preserving it
// since #1302) spelled the annotation `{tag:"a"|"b"}`. Two spellings of ONE arena type is
// two rows in every name-keyed registry downstream.
//
// A `null` MEMBER is not a literal and does not disqualify the run: the arena spells
// `"a" | "b" | null` BOTH as a `TyNullable` over a pure litunion and as a flat `TyUnion`
// with a `null` `TyPrim` member (`tyIsNullableLitUnion` carries both forms), and canon's
// `nulLitUnionPreserve` reaches the flat one through its top-level split. `luiHasNull`
// reports which the caller got, because the `| null` form is preserved at EVERY position
// while the bare form is preserved only where `ctxKeepsLitUnion` holds — canon's asymmetry,
// mirrored rather than corrected here (see the residue note in
// `docs/internals/destringify-types-program.md`).
//
// FEWER THAN TWO DISTINCT MEMBERS HAS NO INLINE SPELLING, and that is the emitter's name
// grammar rather than a taste: `nameIsInlineLitUnion` requires 2+ quoted atoms, so a
// one-member run would render a name no downstream litunion classifier accepts. Canon's
// `litUnionPreserve` declines on the identical `kept.length < 2` test.
//
// A DECLARED alias with exactly these members WINS the spelling, which is
// `litUnionPreserve`'s own `litUnionAliasOfLitTexts` preference asked off the arena instead
// of off the text: a name that is an intern KEY must be one name per type.
export function litUnionInlineNameOfTy(ty: i32): string {
  luiAtoms = 1
  luiHasNull = false
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyUnion {
    const texts: string[] = []
    let sawNull = false
    let i = 0
    while i < t.uMembers.length {
      const m = T.tys[t.uMembers[i]]
      if m is TyLit {
        if m.litKind != "str" { return "" }
        let dup = false
        let d = 0
        while d < texts.length {
          if texts[d] == m.litText { dup = true }
          d = d + 1
        }
        if !dup { texts.push(m.litText) }
      } else if m is TyPrim {
        if m.primName != "null" { return "" }
        sawNull = true
      } else {
        return ""
      }
      i = i + 1
    }
    if texts.length < 2 { return "" }
    luiHasNull = sawNull
    const al = litUnionAliasOfLitTexts(texts)
    if al != "" {
      // An alias name is ONE identifier — one atom.
      luiAtoms = 1
      return al
    }
    // A quoted member holds no top-level `|` of its own, so the join writes exactly
    // `texts.length - 1` separators — canon's `lupAtoms = kept.length`.
    let out = "\"" + texts[0] + "\""
    let k = 1
    while k < texts.length {
      out = out + "|\"" + texts[k] + "\""
      k = k + 1
    }
    luiAtoms = texts.length
    return out
  }
  ""
}

export function nodeTyIsLitUnionAlias(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  if !cTyIxListHas(cUnionTyIxs, ty) { return false }
  tyIsLitUnion(ty)
}
// Does the annotation node's type BEAR NULL — structurally, without rendering it and splitting
// the render on `|`.
//
// TWO SHAPES, and missing the first is the trap this replaced. `retUnionFlag` answers 1 for a
// `TyNullable` over a scalar as well as for a `TyUnion`, so a predicate that only walked
// `uMembers` would answer FALSE for `i32 | null` — and a false answer there leaves a `return
// null` unboxed. The name form it replaces gets both because `"i32 | null"` splits to an atom
// list containing `null`.
// The ARENA-INDEX half, split out so a caller holding a `Ty` rather than a NODE can ask. The
// inferred-return table is such a caller: it records the arena index beside the name
// (`inferRetTyIx`), and `inferRetTyIxOf(name)` hands it back — so an inferred-return row can ask
// this question structurally where only a rendered NAME was available before.
// STRUCTURAL type equality over the arena, depth-bounded. Two indices are the same TYPE when
// their rows have the same variant and their components are recursively the same.
//
// THE ARENA IS AN APPEND LOG, so index equality is construction identity, not type identity: the
// same type built twice has two indices. Everything in this programme that needed to compare types
// rather than read their structure has run into that. This is the comparison that does not care.
//
// NOT A REPLACEMENT FOR INDEX EQUALITY WHERE IDENTITY IS NOMINAL. A declared union's identity is
// its declaration, and two declarations with equal members are different types — interning them
// broke 133 corpus rows. Use this only where the thing being compared genuinely has no nominal
// identity: an INLINE union spelling, whose sameness is structural by definition.
export function tySame(a: i32, b: i32): boolean { tySameAt(a, b, 24) }

function tySameAt(a: i32, b: i32, depth: i32): boolean {
  if a == b { return true }
  if a < 0 || b < 0 { return false }
  if depth <= 0 { return false }
  const x = T.tys[a]
  const y = T.tys[b]
  if x is TyPrim {
    if y is TyPrim { return x.primName == y.primName }
    return false
  }
  if x is TyArray {
    if y is TyArray { return tySameAt(x.aElem, y.aElem, depth - 1) }
    return false
  }
  if x is TyNullable {
    if y is TyNullable { return tySameAt(x.nInner, y.nInner, depth - 1) }
    return false
  }
  if x is TyUnion {
    if y is TyUnion {
      if x.uMembers.length != y.uMembers.length { return false }
      let i = 0
      while i < x.uMembers.length {
        if !tySameAt(x.uMembers[i], y.uMembers[i], depth - 1) { return false }
        i = i + 1
      }
      return true
    }
    return false
  }
  // A STRUCT member compares by field NAMES and field TYPES. The names are part of the type here,
  // not a rendering of it — an object type IS its field set, and two objects with the same field
  // types under different names are different types.
  if x is TyObj {
    if y is TyObj {
      if x.objFieldNames.length != y.objFieldNames.length { return false }
      let f = 0
      while f < x.objFieldNames.length {
        if x.objFieldNames[f] != y.objFieldNames[f] { return false }
        if !tySameAt(x.objFieldTypes[f], y.objFieldTypes[f], depth - 1) {
          return false
        }
        f = f + 1
      }
      return true
    }
    return false
  }
  if x is TyMap {
    if y is TyMap {
      if !tySameAt(x.mKey, y.mKey, depth - 1) { return false }
      return tySameAt(x.mVal, y.mVal, depth - 1)
    }
    return false
  }
  false
}

export function tyBearsNull(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable { return true }
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      const mi = t.uMembers[i]
      const m = T.tys[mi]
      if m is TyPrim {
        if m.primName == "null" { return true }
      }
      // RECURSE — mirroring `collectRetAtoms`, the walk that BUILT the name this replaces.
      // The arena keeps a union's members NESTED (`annUnionInnerTy` flattens only when EVERY
      // member is a litunion), so `i32 | (string | null)` is `TyUnion[i32, TyNullable(string)]`
      // and the `null` sits one level DOWN. `collectRetAtoms` descends through `TyUnion` and
      // `TyNullable` and pushes `"null"` for every nullable it passes, so the recorded name is
      // `i32|string|null` — a direct-members-only scan answers FALSE where the name answers
      // TRUE, and the two are then not the same question at all.
      //
      // Descent is through UNION and NULLABLE members ONLY. A `TyArray` / `TyObj` member is a
      // leaf here exactly as it is there (`out.push(tyToStructStr(er))`): a nullable FIELD or
      // ELEMENT does not make the union itself null-bearing.
      if tyBearsNull(mi) { return true }
      i = i + 1
    }
    return false
  }
  false
}

export function nodeTyBearsNull(ix: i32): boolean {
  tyBearsNull(nodeTyIxOf(ix))
}

// READ THE ARMS, NOT THIS HEADER'S "EXCLUDED" LINE. The header below says what this EXCLUDES —
// a nullable niche, a literal union — and lists no extra inclusions, which reads as
// "`isUName` minus literal unions". It is wider than that. Two further POSITIVE arms follow the
// first: a same-shape-collapsed `TyObj` claimed via `annUnionAtomsOf(ix) >= 2`, and a nullable
// NUMERIC literal union via `nulNumLitUnionBaseName`.
//
// Substituting this for `isUName(nm) && !nodeTyIsLitUnionAlias(ix)` at
// `emit_classify.letAnnIsUnion` — which reads as the same conjunction — breaks SIX passing tests
// (rc 0 -> 1): `types/intersection-annotation.vl`,
// `types/union-alias-transparent-and-its-gate.vl`,
// `literal-unions/is-numeric-litunion-membership.vl`,
// `literal-unions/mixed-union-litunion-arm-is-membership.vl` and two generics frontier cases.
export function nodeTyIsUnionAlias(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  // A value/struct union box (`i32 | string`, `Cat | Dog`) — inline OR declared; the emitter registers
  // both in `unNames` (`isUName`). Excluded: a nullable niche (a `TyNullable`, not a `TyUnion`), and a
  // LITERAL union — string OR numeric (`0 | 1 | 2` canon-names `i32`), whose members are all `TyLit`
  // and which reps as an interned atom, not a `{tag, value}` box. A struct-alias is single-member.
  if isValueUnionBox(ty) { return true }
  // A SAME-SHAPE union (`A | B` with A, B structurally IDENTICAL) collapses to a single `TyObj` in the
  // arena — structural equality dedups the members — losing its union-ness, though the emitter keeps the
  // union box for tag discrimination (`isUName`). The arena can't represent this, so recover it locally
  // from the annotation node: a `TypeRef` whose emit-time spelling has 2+ TOP-LEVEL atoms yet resolved
  // to a struct.
  //
  // The count is READ, not re-derived. `canonEmitTypeNames` — the pass that PRODUCES every
  // emit-time annotation spelling — banks it per node (`annUnionAtomsOf`, #1055/#1113), and
  // `emit_collect.vl`'s `collectU` already asks this identical question that way. The two
  // sites are now the same query against the same column, which is the point: the split that
  // stood here re-derived, from a string, a number the producer had already written down.
  //
  // The `-1` the bank returns for a non-`TypeRef` node is the same answer the split gave for
  // one (it never ran — the `nd is TypeRef` gate). A node that POSTDATES the bank also reads
  // `-1`, i.e. "not a union", and that population is NOT empty — it is 29,215 of the 124,426
  // reaches this arm takes (3,415/9,764 corpus + 25,800/114,662 fuzz, 23.5%). What IS measured
  // empty is the DISAGREEMENT: over all 124,426 reaches, bank-missing ones included, the split
  // never answered "union" where the bank answers "not" — 0 divergences, with the comparator
  // proved in the same build (forcing the bank leg FALSE lights up 62 corpus reaches). The
  // reason is structural: an emitter-SYNTHESIZED `TypeRef` (`synthTypeRef`) is minted from a
  // RENDER, and the render of a `TyObj` is a `{…}` shape or a nominal name — one top-level
  // atom either way, so a post-bank node cannot spell the collapsed union this arm looks for.
  if t is TyObj {
    if annUnionAtomsOf(ix) >= 2 { return true }
  }
  if t is TyNullable {
    const inner = t.nInner
    if inner >= 0 {
      const it = T.tys[inner]
      if it is TyPrim {
        const pn = it.primName
        if pn == "i32" || pn == "f64" || pn == "i64" || pn == "f32" {
          return true
        }
      }
      if isValueUnionBox(inner) { return true }
    }
  }
  // A NULLABLE NUMERIC literal union (`1 | 2 | null`, and the two-part `Z | null` over
  // `type Z = 1 | 2`) IS the box — its rep is `<base scalar> | null`, which is exactly the box a
  // nullable i32/i64/f64 already gets, and `vtKindOfType` says so through this same predicate's
  // sibling arm. Claimed HERE rather than beside the `TyNullable` scalars above because the two
  // spellings intern differently — the inline form as a `TyNullable` over the litunion, the
  // declared two-part form as a `TyUnion` with a `null` member — and `nulNumLitUnionBaseName`
  // answers for both, so one line covers what two arms would.
  //
  // WITHOUT IT THIS PREDICATE CONTRADICTED `vtKindOfType` ABOUT ONE TYPE, and the disagreement
  // was visible in three consumers at once. `paramUnion` said "not a union value", so `exprUnion`
  // did too and the numeric-litunion `is` MEMBERSHIP arm — which gates on `exprUnion` — fell past
  // to ``emitProgram: `is` names a type that is not a union variant`` at a PARAM while the same
  // program at a `let` compiled. `retAnnKindChain` left `fRetKind` at `"i32"`, so the CALL-RESULT
  // classifier (`fnRetUnionSid` reads that column) typed `const r = mk(b)` as a bare i32.
  // `emitReturnValue`'s `retUNm` and `emitNullReturn` left `return null` unboxed —
  // `emitProgram: bare null needs a struct-typed context`. Those three are the SAME question with
  // three call sites, which is why moving them piecemeal made things worse and moving the shared
  // predicate makes all three agree: the return type, the returned value and the receiving local
  // now derive the box from one answer.
  //
  // The bare litunions stay excluded exactly as the header says, and by construction rather than
  // by a second test: `nulNumLitUnionBaseName` requires a `null` member (so `1 | 2` alone is
  // still the plain i32 atom) and rejects a `"str"` member (so `"a" | "b" | null` keeps the
  // interned-atom niche with its `-1` sentinel, not a box).
  nulNumLitUnionBaseName(ty) != ""
}
// A `{tag, value}` value/struct union box: `TyUnion`, 2+ members, NOT a pure literal union.
function isValueUnionBox(tyix: i32) {
  if tyix < 0 { return false }
  const t = T.tys[tyix]
  if t is TyUnion {
    if t.uMembers.length < 2 { return false }
    // A HOMOGENEOUS literal union (all members `TyLit` of the SAME `litKind`) is an interned atom,
    // NOT a box: all-`str` (`"a"|"b"`) or all-numeric (`0|1|2`). A MIXED-kind literal union (`"x"|7`,
    // a string lit + a numeric lit) can't share one atom rep, so it boxes as a value union.
    let allSameLit = true
    // `null` is "no member seen yet" — the vocabulary is a literal union now, so the
    // empty-string sentinel it used has no spelling in the type.
    let litKind: LitKind | null = null
    let i = 0
    while i < t.uMembers.length {
      const m = T.tys[t.uMembers[i]]
      if m is TyLit {
        if litKind == null { litKind = m.litKind }
        else if litKind != m.litKind { allSameLit = false }
      } else {
        allSameLit = false
      }
      i = i + 1
    }
    return !allSameLit
  }
  false
}
export function nodeTyIsNulClosure(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    const inner = T.tys[t.nInner]
    if inner is TyFunc { return true }
  }
  false
}
// ── Arena-level (Ty-index-keyed) nominal queries ──────────────────────────────
// The emitter's `repOf` descriptor derivation (`emit_rep.vl`) classifies TYPES —
// `Ty`-arena indices — where the `nodeTy*` twins above classify a NODE's recorded
// type. The purely structural arms live in `emit_rep`; these expose only the
// checker-PRIVATE nominal-identity metadata (the sidecar index sets) that a
// structural walk cannot re-derive (the arena's `TyObj`/`TyUnion` carry no name).
export function tyIxIsVariantMember(ty: i32) {
  if ty < 0 { return false }
  cTyIxListHas(cVariantMemberTyIxs, ty)
}
// The declared litunion ALIAS a litunion arena index denotes, or -1: the index
// itself when it IS a declared alias (`type K = "a" | "b"`), else the recorded
// source alias when it is a checker-minted COPY of one (alias PROVENANCE — see
// `cLitUnionCopyTyIxs`), else -1 (a genuinely-inline litunion, whose rep stays
// position-decided by the canon pass: string bare, atom under `| null`). The
// rep layers read this instead of a copy-blind registry test where
// the question is "does this index carry a declared alias's atom identity".
export function tyLitUnionAliasIx(ty: i32): i32 {
  if ty < 0 { return -1 }
  if !tyIsLitUnion(ty) { return -1 }
  if cTyIxListHas(cUnionTyIxs, ty) { return ty }
  let i = 0
  while i < cLitUnionCopyTyIxs.length {
    if cLitUnionCopyTyIxs[i] == ty { return cLitUnionCopyAliasIxs[i] }
    i = i + 1
  }
  -1
}
// A `{tag, value}` value/struct union BOX at arena level — `isValueUnionBox`,
// exposed under the `ty*` naming for the emitter's descriptor arms.
export function tyIsValueUnionBox(ty: i32) { isValueUnionBox(ty) }
// The nested-array LEAF kinds the inferred-empty synthesis can type CORRECTLY — and nothing
// wider, because the wider set is a MISCOMPILE rather than a missing feature.
//
// `arrLitNestedElemKind` maps a leaf to a ref-list kind from the arena, and the authority it has
// to agree with is `refArrElemKind(<elem> + "[]")`: the annotation `collectLocals` synthesizes is
// resolved BY NAME, and `rlInternName` keeps the FIRST kind banked against a rep key. The two
// agree on exactly this set. Outside it they diverge — an `f32[]` leaf is 4 here and 10 there, a
// nested `i32[][]` leaf is 4 here and 9 there — and the outer list's backing is then typed as the
// i32-list wrapper while a different wrapper is stored into it: `vl check` rc 0 and a module that
// does not instantiate.
//
// SO THE UNCOVERED LEAVES DECLINE, and that is the point. Declining keeps the LOUD reject master
// gives (`index receiver is not an array or string`); the alternative is trading a loud reject for
// a silent miscompile, which is the exact failure class this synthesis exists to CLOSE. Widening
// the set means answering from `refArrElemKind` and extending the flag block (kind 10 needs
// `fa32Used`; kind 9 needs the inner row interned at a strictly lower slot, since the wrapper is
// read during the same forward pass) — a real design step, and it wants a fixture per leaf.
//
// BOTH HALVES MOVE TOGETHER. This is asked by `nodeArrayElemName` below, which decides whether an
// annotation is synthesized at all, AND by `arrLitNestedElemName`, which decides whether the row
// is interned. Declining in only one leaves "a spelling with no row stays uncovered", which
// reaches the same invalid module by the other route.
export function tyNestedArrLeafSupported(elemTy: i32): boolean {
  if elemTy < 0 { return false }
  const el = T.tys[elemTy]
  if el is TyArray {
    const leaf = el.aElem
    if leaf < 0 { return false }
    // A literal-union leaf (`K[]`) is an i32-ATOM array riding the i32-list wrapper — kind 4,
    // which is what both sides answer for it.
    if tyIsLitUnion(leaf) { return true }
    const lt = T.tys[leaf]
    if lt is TyPrim {
      if lt.primName == "i32" { return true }
      if lt.primName == "boolean" { return true }
      if lt.primName == "string" { return true }
      if lt.primName == "f64" { return true }
      if lt.primName == "i64" { return true }
    }
  }
  false
}

// TYPED-IR query: the element type NAME of the array the checker recorded for node `ix`
// (e.g. "f64", "string", an inline `{v: i32}` shape), or "" when `ix` has no recorded
// concrete array type. A GENERIC element (a `TyVar`) returns "" — a generic build's
// annotation is substituted by the monomorphizer per instance, NOT synthesized here (a
// shared instance body would otherwise stamp a bogus `T[]`). The emitter synthesizes an
// `<elem>[]` annotation from this so an un-annotated empty `[]` reuses the annotated path.
// Node `ix`'s recorded type is an ARRAY whose element is the `boolean` PRIMITIVE — structurally,
// with no render and no compare against one. Replaces `nodeArrayElemName(ix) == "boolean"`, whose
// `TyPrim` arm is a `tyToStructStr` call whose only consumer was that compare.
export function nodeTyArrayElemIsBoolPrim(ix: i32): boolean {
  tyArrayElemPrimName(nodeTyIxOf(ix)) == "boolean"
}

// The NESTED form: an array of arrays whose LEAF element is the `boolean` primitive. Replaces
// `arrElemNameRaw(arrElemNameRaw(nodeTyName(ix))) == "boolean"` — two grammar cuts over a render,
// asking what two `TyArray` hops answer directly.
export function nodeTyNestedElemIsBoolPrim(ix: i32): boolean {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyArray { return tyArrayElemPrimName(t.aElem) == "boolean" }
  false
}

export function nodeArrayElemName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem >= 0 {
      const el = T.tys[t.aElem]
      if el is TyVar { return "" }
      if el is TyPrim { return tyToStructStr(t.aElem) }
      // A STRUCT element renders its inline shape name (`{v: i32}`), which
      // `structIndexOfTypeName` matches to the interned struct by field-set.
      if el is TyObj { return tyToStructStr(t.aElem) }
      // A MAP element (`{[string]: V}[]`, `{[i32]: V}[]`, a `Set()` element) renders the
      // EMIT name — `{[K]:V}`, spaceless, which is character-for-character the synthetic
      // name `parseType` builds for the annotated `{[K]: V}[]` spelling — so the inferred
      // literal `[Map()]` and the annotated `const xs: {[K]: V}[] = [Map()]` intern ONE
      // ref-list row (kind 3) instead of the inferred one falling to the i32 list, where a
      // map-struct ref stored as an i32 element is a loud emit reject. The KEY rides the
      // spelling here, unlike a struct/variant FIELD row: `rlElemMapKeyI32` reads it back
      // off this very name, which is why the array-element position lowers BOTH key reps.
      // "" for an unpinned value (`tyToEmitName` of a hole), which keeps master's answer.
      if el is TyMap { return tyToEmitName(t.aElem) }
      // A VALUE-UNION element (`(Cat | Dog)[]`, `(i32 | string)[]`, `(Cat | i32)[]`)
      // renders the NOMINAL composite — the spelling the union's `unNames` ROW is
      // registered under, which is `refArrElemName`'s table key for the ANNOTATED
      // `(Cat | Dog)[]` spelling — so an UN-annotated literal of union elements
      // recovers the same kind-2 box slot. The emitter's first-element SYNTAX probe
      // (`arrLitIsRef`) cannot see such an element: a CALL (`[pick(true)]`) and an
      // IDENT (`[w]`) are neither an object literal nor a nested literal, so with no
      // recorded name the literal fell to the i32 list and the union box stored into
      // it was `expected i32, found (ref $type)`.
      //
      // A LITERAL union (`("a" | "b")[]`) is EXCLUDED and has its own query
      // (`nodeArrayElemIsLitUnion`): its elements are interned i32 ATOMS riding the
      // i32-list wrapper, not boxes, so naming it here would claim the ref-list build
      // for an i32-backed list. A one-member union has no box either.
      //
      // THE ASSIGNABILITY REVERSE MAP IS THE FALLBACK, NOT THE PREFERENCE, AND THE
      // ORDER WAS MEASURED. An INFERRED struct union (`function pick(b) { … }` with
      // no return annotation) has the object literals' OWN arena entries as its
      // members, and `tyToNominalName` keys its nominal short-circuit on arena-index
      // IDENTITY (`structNameOfTy`) — so it spells such a union STRUCTURALLY,
      // `{meow:i32}|{woof:i32}`, which no union ROW carries: the emitter registers an
      // inferred return under the reverse-mapped composite
      // (`registerInferRetNominalUnion`, whose name is `structUnionRetName`'s). So
      // that producer answers here too — but only where the render has no nominal
      // route, because it spells a DECLARED ALIAS BY ITS MEMBERS (`Cat|Dog` for
      // `type U = Cat | Dog`, whose registered row is `U`). Asking it first read 20
      // cells DOWN on the position grid for exactly that reason.
      if el is TyUnion {
        const aeMems = el.uMembers
        if aeMems.length >= 2 {
          if !tyIsLitUnion(t.aElem) {
            const aeu = tyToNominalName(t.aElem)
            if unionAliasDeclNameOfTy(t.aElem) == "" {
              if structNameOfTy(aeMems[0]) == "" {
                const aer = structUnionRetName(t.aElem, gRootStmts)
                if aer != "" { return aer }
              }
            }
            return aeu
          }
        }
      }
      // A FUNCTION element (`((i32,i32)=>i32)[]`) renders the closure-element table key — the
      // emit-form function type WRAPPED in grouping parens, matching `refArrElemName`'s form for an
      // annotated closure array — so an UN-annotated literal of function values (`[add, mul]`)
      // recovers the same kind-5 slot. "" when a param/return is generic (a `TyVar` → unpinned).
      if el is TyFunc {
        const fn = tyToEmitName(t.aElem)
        if fn == "" { return "" }
        return "(" + fn + ")"
      }
      // A NULLABLE-CLOSURE element (`(((i32) => K0) | null)[]` — the kind-5 niche over the
      // shared closure fat-pointer): renders the full `(<fn>)|null` table key via
      // `nullableRetName`'s nullable-closure arm — the SAME form `refArrElemName` yields for
      // the annotated spelling, with a litunion RESULT kept as its ALIAS (`K0`, the i32-atom
      // rep) — so a literal like `[() => 7, null]` typed only through a LAMBDA's contextual
      // result (no direct binding annotation) still interns/resolves the niche slot and the
      // element `$fnsig` key the annotation side derives.
      if el is TyNullable {
        const ni = T.tys[el.nInner]
        if ni is TyFunc {
          const stmts: i32[] = []
          return nullableRetName(t.aElem, stmts)
        }
      }
      // A NESTED ARRAY element (`i32[][]`, `string[][]`) renders the inner array's emit
      // name. Without this arm the cascade fell through to "", no annotation was
      // synthesized for the binding, and the list took the i32-list default — so pushing an
      // ARRAY into an inferred empty `[]` stored a ref into an i32 element and emitted a
      // module that CHECKS CLEAN and does not instantiate (`expected i32, found (ref
      // $type)`), which is the same failure the union arm above this one exists to close.
      //
      // The machinery it feeds already covers the shape from both other directions: the
      // ANNOTATED `const outer: i32[][] = []` and the nested LITERAL `[[1, 2, 3]]` both run
      // at master. Only this synthesis was missing, so the arm hands the same spelling those
      // two paths already intern their row under.
      //
      // "" for a generic or otherwise unpinned inner element, via `tyToEmitName` — the same
      // decline protocol the `TyFunc` arm above uses, so an unresolved nested element keeps
      // falling through rather than claiming a row that was never interned.
      if el is TyArray {
        if !tyNestedArrLeafSupported(t.aElem) { return "" }
        return tyToEmitName(t.aElem)
      }
    }
  }
  ""
}
export function inferLetTyAt(i: i32) { inferLetTy[i] }

// The CANONICAL emit render of node `ix`'s recorded STRUCT type (`tyToEmitName` —
// spaceless, litunion-ALIAS preserving), or "" when the node's type is not a TyObj or
// has an unrepresentable leaf. The struct-resolution consumers (`structIndexOfExpr`'s
// closure-call fallback) try this BEFORE `nodeTyName`'s spaced `tyToStr` render: the
// spaced render FLATTENS an alias field (`{a: K0 | boolean}` spells its literal
// members), and the flattened field text classifies as NO field code —
// `structIndexOfTypeName`'s scan then matched the shape LENIENTLY onto the plain
// same-name-set twin row, so a boxed-field closure-call result read took the plain
// row's layout: INVALID-WASM (fuzz sweep3 declared leg, seed 128787380 case_00189).
// Scoped to the resolution site (not folded into `nodeTyName`) so the annotation-
// synthesis consumers keep the spaced spelling they were built against.
export function nodeTyCanonObjName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyObj {
    // A RECURSIVE type (`type L = {n: L | null}` — reachable here through a field
    // referencing a recursive-typed binding) has NO finite canonical render:
    // `tyToEmitName` carries no back-edge vocabulary and recurses unboundedly.
    // "" is the documented degenerate — the consumer keeps its fallback.
    if tyDeeperThan(ty, 16) { return "" }
    return tyToEmitName(ty)
  }
  ""
}

// TYPED-IR query: the rendered NAME of the scalar/string type the checker recorded for node
// `ix` (`"f64"`, `"string"`, `"i32"`, …), or "" when none / generic (a `TyVar`) / a composite
// type. The emitter reads this for an un-annotated callback PARAM (`xs.map((x) => …)`) to
// synthesize its annotation, so the param's valtype follows the contextually-inferred element
// instead of defaulting to i32. Only PRIM/string types are surfaced — a struct/array/union
// callback param is out of scope here (those route through their own per-rep paths).
// Node `ix`'s recorded type is the `string` PRIMITIVE — asked of the arena with no string in
// the question and none in the answer.
//
// It replaces `nodeTyName(ix) == "string"`, which RENDERED the type and compared the render. That
// is the shape this programme exists to remove: the render is a `tyToStructStr` walk allocating a
// spelling, and the only use of the spelling was a four-way character compare against a constant
// the arena already knows structurally.
//
// `TyPrim`-ONLY, deliberately. A literal union canon-softens to the spelling `string` at several
// positions in this compiler, and five separate sites have now had to be measured to find out
// whether the softened answer or the structural one is the right one. This asks the structural
// question; a caller that wants the softened one should say so by reading the render.
export function nodeTyIsStringPrim(ix: i32): boolean {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyPrim { return t.primName == "string" }
  false
}

export function nodeTyName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyPrim {
    if t.primName == "void" { return "" }
    return tyToStructStr(ty)
  }
  // A STRUCT type renders its inline shape (`{x: i32}`); the emitter's `synthParamAnnots`
  // resolves that to the declared struct's NOMINAL name (`structIndexOfTypeName` matches by
  // field-set), so an un-annotated struct-element callback param (`ps.map((p) => p.x)`) gets
  // the same `p: P` annotation the explicit form would.
  if t is TyObj { return tyToStructStr(ty) }
  // A FUNCTION type renders its closure-annotation name (`(i32) => i32`) so an un-annotated
  // closure VALUE from a call result (`const g = f(4)`) recovers a sig-keyable name.
  if t is TyFunc { return tyToEmitName(ty) }
  // A REF-LIST type renders its recursive emit name (`{v:i32}[]`, `((i32) => i32)[]`) so an
  // un-annotated ref-list callback param (`(S[]) => i32 = (xs) => …`) recovers a name
  // `synthParamAnnots` resolves to the nominal element (`S[]`). Without it the param fell through
  // to "" and defaulted to i32 — a missing-type silently lowered as the wrong type.
  if t is TyArray { return tyToEmitName(ty) }
  ""
}

// True if the node at `ix` has a recorded type that is a VALUE union (`Cat | Dog`) — a
// `TyUnion` with 2+ members. Lets the emitter's `synthParamAnnots` give an un-annotated
// union-element callback param (`xs.filter((a) => a is Cat)`) a union annotation, so its
// `is`-narrowing and closure `$fnsig` param token resolve. A nullable (`T | null`) is a
// `TyNullable`, not a `TyUnion`, so it is excluded here (its own slice).
//
// SECOND CONSUMER (#1310), and it wants precisely the property that makes this NOT
// `exprUnion`: this is the CHECKER's view, `exprUnion` is the EMITTER's REP
// classification, and the two disagree wherever a rep classifier has a gap. An
// un-annotated array literal of union elements is typed `(Cat|Dog)[]` here and lowered
// as an i32 list by `arrLitIsRef` (which asks the first element's SYNTAX), so an element
// read has `exprUnion` false while the checker calls it a union. `monoStaticIsResult`
// scopes its spelling-resolved exclusion by this: a test over a receiver the CHECKER
// typed as a union belongs to the union ladder whatever the rep layer managed, and must
// never be const-folded as a monomorphized static guard.
export function nodeTyIsUnion(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyUnion { return t.uMembers.length >= 2 }
  false
}

// True if type-arena entry `ty` is a union whose members are ALL string-LITERAL types (`"a" | "b"`) — a
// "literal union", which the emitter lowers as an interned i32 ATOM (one id per distinct member string).
// True if `ty` carries a LITERAL anywhere in its member tree, so its `RC_ROOT` emit render
// is LOSSY: `ctxKeepsLitUnion` is false at `RC_ROOT`, so `"pp" | "qq"`, `1 | 2` and
// `K | string` all render as the base scalar their members soften to. Two such types render
// ALIKE without denoting the same set of values, which makes render-equality answer about
// the BASE instead of about the type — so any equality test over `tyToEmitName` has to
// decline them. A literal union is a runtime-observable SUBSET of its base and its own
// membership lowerings (`emitIs`'s atom / string / numeric arms) are what answer for it.
// Depth-capped for the recursive arena; a one-member `TyUnion` wrapper is peeled by the
// same recursion that walks a real member set.
// COMPLETENESS of a substitution (destringify D-MONORET): does `ty` still contain an
// unresolved `TyVar` anywhere inside it?
//
// `substTyDeep` rebuilds only the children that CHANGED, so a type parameter it could not
// bind is left in place rather than reported. A consumer that hands the result onward as a
// concrete type therefore cannot tell "substituted fully" from "substituted partly", and
// the difference is not cosmetic: recording a partly-substituted return type on a
// monomorphized instance is a WRONG type, the shape three hand-overs on this branch had to
// be reverted for. This is the predicate that separates them.
//
// DEPTH-BOUNDED rather than seen-stack'd, matching `tyRenderSoftensLitsGo` beside it: a
// recursive named type is cyclic in the arena, and the bound both terminates and is the
// conservative answer — running out of depth returns TRUE (assume a variable may lurk), so
// an unknown is treated as incomplete and the caller keeps its name path. A predicate that
// gates a hand-over must fail toward the OLD behaviour.
export function tyHasTyVar(ty: i32) { tyHasTyVarGo(ty, 12) }

function tyHasTyVarGo(ty: i32, depth: i32) {
  if ty < 0 { return false }
  if depth <= 0 { return true }
  const t = T.tys[ty]
  if t is TyVar { return true }
  if t is TyArray { return tyHasTyVarGo(t.aElem, depth - 1) }
  if t is TyNullable { return tyHasTyVarGo(t.nInner, depth - 1) }
  if t is TyNeg { return tyHasTyVarGo(t.negTy, depth - 1) }
  if t is TyMap {
    if tyHasTyVarGo(t.mKey, depth - 1) { return true }
    return tyHasTyVarGo(t.mVal, depth - 1)
  }
  if t is TyObj {
    const fs = t.objFieldTypes
    let i = 0
    while i < fs.length {
      if tyHasTyVarGo(fs[i], depth - 1) { return true }
      i = i + 1
    }
    return false
  }
  if t is TyFunc {
    const ps = t.fnParamTypes
    let k = 0
    while k < ps.length {
      if tyHasTyVarGo(ps[k], depth - 1) { return true }
      k = k + 1
    }
    return tyHasTyVarGo(t.fnRet, depth - 1)
  }
  if t is TyUnion {
    const ms = t.uMembers
    let u = 0
    while u < ms.length {
      if tyHasTyVarGo(ms[u], depth - 1) { return true }
      u = u + 1
    }
    return false
  }
  false
}

export function tyRenderSoftensLits(ty: i32) { tyRenderSoftensLitsGo(ty, 8) }

function tyRenderSoftensLitsGo(ty: i32, depth: i32) {
  if ty < 0 || depth <= 0 { return false }
  const t = T.tys[ty]
  if t is TyLit { return true }
  if t is TyUnion {
    const ms = t.uMembers
    let i = 0
    while i < ms.length {
      if tyRenderSoftensLitsGo(ms[i], depth - 1) { return true }
      i = i + 1
    }
  }
  false
}

export function tyIsLitUnion(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyUnion {
    if t.uMembers.length < 1 { return false }
    let i = 0
    while i < t.uMembers.length {
      const m = T.tys[t.uMembers[i]]
      if m is TyLit {
        if m.litKind != "str" { return false }
      } else {
        return false
      }
      i = i + 1
    }
    return true
  }
  false
}

// True if type-arena entry `ty` is an ARRAY whose ELEMENT is a literal union (`K[]`, an inline
// `("a"|"b")[]`) — `nameIsLitUnionArray`'s STRUCTURAL dual (destringify: the litunion FIELD
// classifiers). The name predicate strips one trailing `[]`, peels ONE grouping-paren layer and
// asks `nameIsLitUnionType`; the arena needs neither peel — a grouping paren is not a type, and
// exactly one `TyArray` hop is taken. The excluded shapes line up on both sides: a 2-D `K[][]`
// (the element is itself a `TyArray`), a `(K | null)[]` (a `TyNullable` element) and a
// `("a" | "b" | null)[]` all answer NO here exactly as the name path does.
export function tyIsLitUnionArray(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyArray {
    const r = tyIsLitUnion(t.aElem)
    return r
  }
  false
}

// True if the NAMED type `name` (a `type K = "a" | "b"` alias) is a literal union — the emitter's
// annotation-side query (the checker preserves the literal members even though the emit-side `udVariants`
// are widened to `"string"`).
export function nameIsLitUnionType(name: string) {
  if cUserTypes.has(name) {
    const ti = cUserTypes[name] ?? -1
    const r = tyIsLitUnion(ti)
    return r
  }
  // An INLINE (un-aliased) literal union — the synthetic annotation name `"a"|"b"` carries the
  // members directly (no `cUserTypes` entry). It is a literal union iff it has 2+ top-level members
  // and every one is a QUOTED string literal (`"…"`), matching `tyIsLitUnion` over the named alias.
  const inl = nameIsInlineLitUnion(name)
  inl
}

// True if the synthetic type name `name` is an INLINE literal union: 2+ top-level `|`-separated
// members, each a quoted string literal. A mixed member (`"a" | i32`, `"a" | null`) or a single
// literal fails — those are value unions / nullables / single-literal types, not atom unions.
function nameIsInlineLitUnion(name: string) {
  // Cheap O(1) reject before the allocating split: an inline literal-union name always begins with
  // a quoted member (`"a"|…`). This skips every ordinary name (`i32`, `string`, struct/union names,
  // map/array shapes) — the overwhelming majority of `nameIsLitUnionType` calls — without allocating.
  // Both quote tests are `tyname.nameIsQuotedLeaf` (W3). The two BOUNDS stay here and they
  // are DIFFERENT bounds — `>= 1` for the cheap reject (any quoted name at all) and `>= 2`
  // per atom (a literal member needs both quotes) — which is one of the reasons the home
  // folds neither in.
  if name.length < 1 { return false }
  if !nameIsQuotedLeaf(name) { return false }
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  if atoms.length < 2 { return false }
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    if a.length < 2 { return false }
    if !nameIsQuotedLeaf(a) { return false }
    i = i + 1
  }
  true
}

// True if `ti` is a TyMap whose VALUE — at any map-nesting depth, one nullable wrapper
// peeled per level — is a literal union (`{[string]: K0}`, `{[string]: {[string]: K0}}`,
// `{[string]: K0 | null}`). The map-value usage arm of `anyLitUnionUsed`.
function tyMapValIsLitUnion(ti: i32, depth: i32): boolean {
  if ti < 0 || depth <= 0 { return false }
  const t = T.tys[ti]
  if t is TyMap {
    let v = t.mVal
    if v < 0 { return false }
    const vt = T.tys[v]
    if vt is TyNullable { v = vt.nInner }
    if v < 0 { return false }
    if tyIsLitUnion(v) { return true }
    return tyMapValIsLitUnion(v, depth - 1)
  }
  false
}

// True if the program uses ANY literal-union type — a single `P.nodes` pass for the emitter to
// run ONCE, so its per-node atom detectors can early-out when no literal union exists. Every
// literal-union usage surfaces as a `TypeRef` annotation (a `type K = …` RHS, a `: K` / `: "a"|"b"`
// binding/param/return), so one TypeRef scan via `nameIsLitUnionType` covers named + inline.
export function anyLitUnionUsed() {
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is TypeRef {
      // A litunion used ONLY as a MAP VALUE (`{[string]: K0}`, nested
      // `{[string]: {[string]: K0}}` — no bare `K0` annotation anywhere) counts too:
      // the mv-slot layer interns the value as i32 ATOM ids regardless of this flag,
      // so with detection off the compare/print classifiers treated the atom read as
      // a string — `m[k] == "bbpt"` called strEq with the raw i32 id: INVALID-WASM
      // (the r4 residual of the nullable-nested-map family). Nullable-value maps are
      // covered by the same probe, which peels one nullable wrapper per map level.
      if tyMapValIsLitUnion(nodeTyIxOf(i), 4) { return true }
    }
    // A litunion used ONLY as an ARRAY element (`K[]`, no bare `K` annotation anywhere) — or any
    // EXPRESSION the checker typed as a litunion (a `K[]` element read `xs[i]`, a `for k in xs` var) —
    // also counts. A direct Ty check over the recorded node type (not the annotation name, which for
    // `K[]` is not a bare litunion name). Without it `gLitUnionUsed` stays 0 and atom detection is off,
    // so `const sk = xs[i]` lowers as a `string` ref — the i32 atom into a `(ref $array)` cell.
    //
    // THE NULLABLE NICHE IS ASKED AT EVERY NODE, NOT ONLY AT AN ANNOTATION, and asking it only of a
    // TypeRef is what made a `(K | null)[]` read print the RAW ATOM ID: the annotation of a
    // `(K | null)[]` is a TypeRef whose own type is the TyArray, so NO node in such a program carries
    // a bare nullable-litunion ANNOTATION type and nothing else here mentioned the niche. So
    // `gLitUnionUsed` stayed 0 for the whole module, `exprIsLitAtom` short-circuited on its first
    // line, and `print` fell past every atom arm to `__print_i32__`: `0`, `-1`, `1` for
    // `["p", null, "q"]`, with `vl check` rc 0.
    //
    // WHY THERE IS NO `nodeArrayElemIsNulLitUnion` PROBE BESIDE ITS NON-NULL TWIN. The non-null one
    // is needed because a `K[]` program can mention the litunion nowhere else — `K[]` is not a bare
    // litunion NAME and the ELEMENT reads record the bare litunion. The nullable twin has no such
    // gap: every read of a `(K | null)[]` element records the NICHE on the reading node (a loop var,
    // an index read, a binding), and a CONSTRUCTION-ONLY program does not need the flag at all — the
    // `null`-to-`-1` element seed comes from `nodeArrayElemIsNulLitUnion` at the ARRAY LITERAL, which
    // never consults `gLitUnionUsed`. Adding it was measured to move no cell of the 198-cell grid and
    // to be reachable by no program, so it stays out of a scan that pays per node on every program.
    if nodeTyIsLitUnion(i) { return true }
    if nodeTyIsNulLitUnion(i) { return true }
    if nodeArrayElemIsLitUnion(i) { return true }
    i = i + 1
  }
  false
}

// True if node `ix` has a recorded ARRAY type whose ELEMENT is a literal union (`K[]`). The
// emitter seeds atom construction for such an array literal's elements (they lower as ids, not
// strings). A direct Ty check — no name round-trip (a rendered `"a" | "b"` would not re-parse).
export function nodeArrayElemIsLitUnion(ix: i32) {
  const pty = nodeArrayElemPeelTy(ix)
  if pty < 0 { return false }
  const t = T.tys[pty]
  if t is TyArray {
    const r = tyIsLitUnion(t.aElem)
    return r
  }
  false
}

// The recorded type of node `ix` with ONE nullable wrapper peeled — a NULLABLE-list
// receiver (`(K | null)[] | null`) indexed in its checker-proved non-null branch still
// RECORDS the nullable type on the receiver node, so the element probes below must see
// through the wrapper to classify the element. -1 (out-of-arena) when unrecorded.
function nodeArrayElemPeelTy(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyNullable { return t.nInner }
  ty
}

// True if node `ix` has a recorded ARRAY type whose ELEMENT is `boolean | null` (a
// `(boolean | null)[]` literal). The emitter seeds `pendingNulBool` for such a literal's
// elements so a `null` element lowers as the sentinel 2 (a `true`/`false` element rides
// its i32 0/1 untouched) — the list analogue of the scalar `boolean | null` niche.
export function nodeArrayElemIsNulBool(ix: i32) {
  const pty = nodeArrayElemPeelTy(ix)
  if pty < 0 { return false }
  const t = T.tys[pty]
  if t is TyArray {
    const e = t.aElem
    if e >= 0 {
      const et = T.tys[e]
      if et is TyNullable {
        const en = T.tys[et.nInner]
        if en is TyPrim { return en.primName == "boolean" }
      }
    }
  }
  false
}

// True if node `ix` has a recorded ARRAY type whose ELEMENT is `string | null` (a `(string | null)[]`).
// The read side of the string-ref niche list: the element is stored `(ref null $aTypeIdx)`, so an
// element read `p[i]` STAYS nullable (a `nulstr` the caller narrows with `!= null`) rather than
// recovering non-null the way a plain `string[]` element does. Mirrors `nodeArrayElemIsNulBool`.
export function nodeArrayElemIsNulStr(ix: i32) {
  const pty = nodeArrayElemPeelTy(ix)
  if pty < 0 { return false }
  const t = T.tys[pty]
  if t is TyArray {
    const e = t.aElem
    if e >= 0 {
      const et = T.tys[e]
      if et is TyNullable {
        const en = T.tys[et.nInner]
        if en is TyPrim { return en.primName == "string" }
      }
    }
  }
  false
}

// True if node `ix` has a recorded ARRAY type whose ELEMENT is `K | null` (a `(K | null)[]` — a
// literal union made nullable). The emitter seeds `pendingLitUnion` (member literals lower as their
// interned ids) AND `pendingNulLitUnion` (a `null` element lowers as the sentinel `-1`) for such a
// literal's elements — the atom-niche analogue of `nodeArrayElemIsNulBool`. Mirrors that probe with
// `tyIsLitUnion` on the nullable's inner instead of a `boolean` primitive test.
export function nodeArrayElemIsNulLitUnion(ix: i32) {
  const pty = nodeArrayElemPeelTy(ix)
  if pty < 0 { return false }
  const t = T.tys[pty]
  if t is TyArray { return tyIsNullableLitUnion(t.aElem) }
  false
}
// True if type `ty` is a NULLABLE literal union — either the two-part form `K | null` (a `TyNullable`
// whose inner is a litunion) OR the expanded member form `"a" | "b" | null` (a `TyUnion` with a null
// member and every OTHER member a quoted string literal). Matches `nameIsNulLitUnion`'s dual handling
// at the name level: a `(K | null)[]` literal's ADOPTED annotation gives the `TyNullable` form, while
// its INFERRED element type (`["a", null]` → the union of the elements' types) gives the expanded
// `TyUnion` form — both must classify as the atom niche so the literal takes the i32-list path.
export function tyIsNullableLitUnion(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable { return tyIsLitUnion(t.nInner) }
  if t is TyUnion {
    if t.uMembers.length < 2 { return false }
    let sawNull = false
    let sawLit = false
    let i = 0
    while i < t.uMembers.length {
      const m = T.tys[t.uMembers[i]]
      if m is TyPrim {
        if m.primName != "null" { return false }
        sawNull = true
      } else if m is TyLit {
        if m.litKind != "str" { return false }
        sawLit = true
      } else {
        return false
      }
      i = i + 1
    }
    return sawNull && sawLit
  }
  false
}
// True if type-arena entry `ty` is a NULLABLE NUMERIC literal union — `1 | 2 | null`, or the
// two-part `Z | null` over `type Z = 1 | 2` — and, if so, WHICH base scalar its non-null
// members rep as (`"i32"` / `"i64"` / `"f64"`); "" for everything else. The numeric twin of
// `tyIsNullableLitUnion`, which is STRING-only by construction (its `litKind != "str"` reject).
//
// THE REP IS `<base> | null`, WHICH IS THE VALUE-UNION BOX, and that is why this question has
// to be asked separately rather than folded into `numLitUnionBaseName`. That home answers the
// NON-null rule — a homogeneous all-`TyLit` union collapses to its base scalar — and it
// deliberately declines the moment a member is not a `TyLit`, which the `null` member is. So
// the nullable form is claimed by neither litunion rule: it reached the boxed classifiers only
// through the `let`/global ladder's NAME test (`letIsUnion`) and fell to the `"i32"` default
// everywhere the rep is derived from the annotation NODE, which is a rep DISAGREEMENT between
// storage classes for one type — an i32 param/return cell that cannot hold the null its own
// annotation admits.
//
// `null` alone is not enough and neither is one literal: a non-`TyLit` non-null member (`1 |
// string | null`) is an ordinary heterogeneous box and answers "" here, and a STRING literal
// member answers "" so the atom-sentinel niche keeps `tyIsNullableLitUnion`.
export function nulNumLitUnionBaseName(ty: i32): string {
  if ty < 0 { return "" }
  const t = T.tys[ty]
  // The two-part spelling: `TyNullable` over a homogeneous numeric litunion.
  if t is TyNullable { return numLitUnionBaseName(t.nInner) }
  if t is TyUnion {
    if t.uMembers.length < 2 { return "" }
    let sawNull = false
    let base = -1
    let i = 0
    while i < t.uMembers.length {
      const m = T.tys[t.uMembers[i]]
      if m is TyPrim {
        if m.primName != "null" { return "" }
        sawNull = true
      } else if m is TyLit {
        if m.litKind == "str" { return "" }
        // The per-member soften and the ONE-BASE requirement are `softenLitTy`'s union arm
        // minus its all-`TyLit` precondition, which the `null` member is what breaks. A
        // mixed-width member set (`1 | 2.5 | null`) has no single base and answers "" — the
        // conservative direction, since every consumer reads "" as "not my shape".
        const b = litBaseTy(m)
        if base < 0 { base = b }
        else if base != b { return "" }
      } else {
        return "" // a non-literal non-null member is an ordinary heterogeneous box
      }
      i = i + 1
    }
    if !sawNull { return "" }
    if base < 0 { return "" }
    const bt = T.tys[base]
    if bt is TyPrim {
      const bn = bt.primName
      if bn == "i32" || bn == "i64" || bn == "f64" { return bn }
    }
    return ""
  }
  ""
}

// The emitter's per-NODE query for the rule above: node `ix`'s recorded type is a nullable
// numeric literal union, so its cell is the value-union box.
export function nodeTyIsNulNumLitUnion(ix: i32) {
  nulNumLitUnionBaseName(nodeTyIxOf(ix)) != ""
}

// The emitter's per-node query: node `ix` has a recorded literal-union type.
export function nodeTyIsLitUnion(ix: i32) {
  const r = tyIsLitUnion(nodeTyIxOf(ix))
  return r
}

// True if array-ELEMENT type `ty` is a NICHE-nullable scalar the emitter reps without a
// box — `K | null` (litunion atom, i32 sentinel `-1`), `boolean | null` (i32 sentinel 2),
// `string | null` (`(ref null $aTypeIdx)` element). Gates the ArrayLit context-adoption
// recording: a literal accepted by such an element target IS the niche list, and the
// recorded destination type is what the emitter's element probes key on.
function tyIsNicheNulScalarElem(ty: i32): boolean {
  if tyIsNullableLitUnion(ty) { return true }
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    const inn = T.tys[t.nInner]
    if inn is TyPrim {
      return inn.primName == "boolean" || inn.primName == "string"
    }
  }
  false
}

// True if node `ix`'s recorded type is a string-keyed MAP whose VALUE type is a literal
// union (`{[string]: K}`, `K = "a" | "b"`) — the atom-valued MONO map (each value is the
// interned atom id, a plain i32). The emitter's map store / `??`-default sites read this
// off the RECEIVER to seed the atom context, so a member literal lowers as its id, not a
// string ref.
export function nodeTyMapValIsLitUnion(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyMap { return tyIsLitUnion(t.mVal) }
  false
}

// True if node `ix`'s recorded type is a string-keyed MAP whose VALUE is a NULLABLE literal
// union (`{[string]: K | null}`): each value is the interned atom id with the `-1` null
// sentinel — still the MONO i32 map. The store/`??`-default sites read this to admit a bare
// `null` (lowered as `-1`) alongside the member literals.
export function nodeTyMapValIsNulLitUnion(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyMap { return tyIsNullableLitUnion(t.mVal) }
  false
}

// True if node `ix`'s recorded type is a string-keyed MAP whose VALUE is `boolean | null`:
// each value is 0/1 with the `2` null sentinel — still the MONO i32 map. The `??`-default
// emitter reads this (alongside `nodeTyMapValIsNulLitUnion`) to coalesce a STORED null (the
// sentinel) as well as a missing key.
export function nodeTyMapValIsNulBool(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if !(t is TyMap) { return false }
  const mv = T.tys[t.mVal]
  if mv is TyNullable { return primNameOf(mv.nInner) == "boolean" }
  if mv is TyUnion {
    if mv.uMembers.length != 2 { return false }
    let sawNull = false
    let sawBool = false
    let i = 0
    while i < mv.uMembers.length {
      const m = T.tys[mv.uMembers[i]]
      if m is TyPrim {
        if m.primName == "null" { sawNull = true }
        else if m.primName == "boolean" { sawBool = true }
      }
      i = i + 1
    }
    return sawNull && sawBool
  }
  false
}

// True if node `ix`'s recorded type is a MAP whose VALUE is a plain `boolean` — the MONO i32
// map with 0/1 values and the `2` NICHE still spare. A BARE read `m[k]` over one types
// `boolean | null` (a missing key IS null), so its miss arm can and must yield that spare
// sentinel: the non-nullable-value dual of `nodeTyMapValIsNulBool`, which the miss arm reads
// beside it. (`{[K]: boolean}` and `{[K]: boolean | null}` differ only in whether a null can
// be STORED; the read type — and so the read's rep — is the niche either way.)
export function nodeTyMapValIsBool(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyMap { return primNameOf(t.mVal) == "boolean" }
  false
}

// The MAP RECEIVER node of a fused map READ — `m[k]` (an Index) and its METHOD spelling
// `m.get(k)` are the SAME fused get (`emitCoalesce` routes both through `emitMapGetOr`), so
// every rule that keys a `??` on the RECEIVER's value type must see BOTH spellings or it is
// taught half a set: the `.get` half then falls through to whatever the generic path does,
// which for an atom-valued map is the raw i32 id (a silent wrong answer at `print`) and for a
// non-member default is a LATE emit reject where the index spelling is a clean one.
//
// Returns the receiver node index, or -1 when `lhsIx` is not a read shape. Deliberately a
// pure SHAPE query: the caller still asks the receiver's recorded type for its map-ness
// (`nodeTyMapValIsLitUnion` / `nodeTyMapValIsNulLitUnion`), so a LIST `xs[i]` / `xs.get(i)`
// answers exactly as it did before. Parens are NOT peeled here — each caller passes the node
// its own layer already resolved (the emitter's `unwrapParen`, which lives downstream in
// `emit_base.vl` and so cannot be called from here).
export function fusedMapReadRecvIx(lhsIx: i32) {
  if lhsIx < 0 { return -1 }
  const l = P.nodes[lhsIx]
  if l is Index { return l.idxArr }
  if l is Call {
    const c = P.nodes[l.callFn]
    if c is Member {
      if c.memProp == "get" {
        if l.callArgs.length == 1 { return c.memObj }
      }
    }
  }
  -1
}

// The member literal TEXTS (raw inner lexeme, no quotes) of the VALUE literal union of node
// `ix`'s recorded map type — the atom-map dual of `nodeLitUnionMemberTexts`. Empty if `ix`
// is not an atom-valued map. The emitter's `??`-default gate checks the default literal is
// a MEMBER (a non-member would mint a fresh atom id under a `string`-typed result).
export function nodeTyMapValLitUnionTexts(ix: i32) {
  const out: string[] = []
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return out }
  const t = T.tys[ty]
  if t is TyMap {
    if !tyIsLitUnion(t.mVal) && !tyIsNullableLitUnion(t.mVal) { return out }
    let mv = t.mVal
    const mvN = T.tys[mv]
    if mvN is TyNullable { mv = mvN.nInner }
    const v = T.tys[mv]
    if v is TyUnion {
      let i = 0
      while i < v.uMembers.length {
        const m = T.tys[v.uMembers[i]]
        if m is TyLit {
          if m.litKind == "str" { out.push(m.litText) }
        }
        i = i + 1
      }
    }
  }
  out
}

// The member literal TEXTS (raw inner lexeme, no quotes) of ATOM-repped TYPE `ty`, in source order:
// every string-literal member of a union (`"a" | "b"` -> ["a","b"]), or the single text of a bare
// literal type (`"a"` -> ["a"] — a fully-narrowed atom, and the type an `is "x"` test carries). Empty
// for anything else, INCLUDING a nullable (`K | null`): the null arm has no member text, so a caller
// that reads an empty list off a nullable must say so rather than emit a chain that matches nothing.
// The emitter keys the interned atom id off each text (`internAtom(quoteLex(t))`).
export function tyLitMemberTexts(ty: i32) {
  const out: string[] = []
  if ty < 0 { return out }
  const t = T.tys[ty]
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      const m = T.tys[t.uMembers[i]]
      if m is TyLit {
        if m.litKind == "str" { out.push(m.litText) }
      }
      i = i + 1
    }
    return out
  }
  if t is TyLit {
    if t.litKind == "str" { out.push(t.litText) }
  }
  out
}

// The member literal TEXTS of node `ix`'s literal-union type, in source order — used by the emitter to
// widen an atom to its member `string` (`print(k)` etc.). Empty if `ix`'s recorded type is not a
// UNION, which deliberately EXCLUDES both a bare literal and a `K | null` nullable: `tyLitMemberTexts`
// answers those, and this node query's callers treat an empty list as "not a widenable atom".
export function nodeLitUnionMemberTexts(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return emptyTextList() }
  const t = T.tys[ty]
  if t is TyUnion { return tyLitMemberTexts(ty) }
  emptyTextList()
}

// The member literal TEXTS of node `ix`'s NULLABLE literal-union type — both spellings
// (`K | null`, a TyNullable over the litunion; and the expanded `"a" | "b" | null` an alias
// carrying its own null arm interns as). The null arm contributes NO text, so the list is
// exactly the widenable members and the caller emits the `-1` sentinel arm itself.
//
// Empty when `ix` is not the nullable niche, which is how `print`'s dispatch tells the two
// widening chains apart: a NARROWED read records the bare litunion and takes
// `nodeLitUnionMemberTexts`' member-only chain, which needs no null arm. Asked FIRST, because
// the expanded spelling satisfies both queries and only this one knows a null can arrive.
export function nodeNulLitUnionMemberTexts(ix: i32) {
  const ty = nulLitUnionPeelTy(nodeTyIxOf(ix))
  if ty < 0 { return emptyTextList() }
  tyLitMemberTexts(ty)
}

// Peel every NULLABLE wrapper off `ty` and answer the arena index of the LITUNION underneath, or
// -1 when `ty` is not the nullable niche at all (a BARE litunion included — its print needs no
// sentinel arm, so it must decline here).
//
// DEPTH MATTERS. A bare read over a `{[string]: K | null}` map types `K | null | null` — the
// read's own missing-key nullability wrapping the stored value's — so a one-wrapper peel answers
// "not a niche" about a value that is exactly the niche, and the print chain then had no member
// texts to widen with. The EXPANDED spelling (`type K = "a" | "b" | null`) carries its null as a
// UNION MEMBER instead of a wrapper and needs no peel, which is the second arm.
function nulLitUnionPeelTy(ty: i32): i32 {
  if ty < 0 { return 0 - 1 }
  const t = T.tys[ty]
  if t is TyNullable {
    if tyIsLitUnion(t.nInner) { return t.nInner }
    return nulLitUnionPeelTy(t.nInner)
  }
  if tyIsNullableLitUnion(ty) { return ty }
  0 - 1
}

// A fresh empty `string[]` — `nodeLitUnionMemberTexts`'s two decline arms, which must each hand back a
// list the caller may keep (the emitter's widening loops read `.length` on it).
function emptyTextList() {
  const out: string[] = []
  out
}

// True if NODE `ix`'s recorded type has at least one string-literal member and EVERY one of them also
// appears in `texts` — the question `k is T` folds to a constant TRUE on, where `texts` is `T`'s
// member set. A NULLABLE node answers false by construction (`tyLitMemberTexts` declines it), because
// its null arm is a member of no tested set: `K | null is K` is a runtime test, not a constant.
export function nodeLitMembersWithin(ix: i32, texts: string[]) {
  const mine = tyLitMemberTexts(nodeTyIxOf(ix))
  if mine.length == 0 { return false }
  let i = 0
  while i < mine.length {
    let found = false
    let j = 0
    while j < texts.length {
      if texts[j] == mine[i] { found = true }
      j = j + 1
    }
    if !found { return false }
    i = i + 1
  }
  true
}

// True if node `ix` has a recorded OBJECT (struct) type — a cheap, NO-RENDER variant-tag check. Gates
// the emitter's `nodeTyName`-rendering struct fallback (`structIndexOfExpr`) so the costly `tyToStr`
// runs only on a confirmed struct receiver the syntactic cases missed (a struct-returning closure value
// call — `arr[i](x).field`), never on the hot path.
export function nodeTyIsObj(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  t is TyObj
}

// True if node `ix` has a recorded MAP type (`{[K]: V}`) — a cheap NO-RENDER variant-tag check, the
// map dual of `nodeTyIsObj`. Gates the emitter's map classifiers (`exprMap` / `mapShapeOfExpr`) so a
// map-returning closure VALUE call whose callee they miss (a closure local `v()`, an indexed closure
// `arr[i]()`) still routes through the map lowering, exactly as a named `fnRetMap` factory does.
// Node `ix`'s recorded type REACHES a map — through a `TyNullable` hop or as a member of a
// `TyUnion`, not only as a bare `TyMap`. The SPAN twin of `nameIsMap`, which cuts a `{[` out of
// anywhere in a spelling and so accepts `{[string]:i32} | null` and `{[string]:V} | i64` alike.
//
// The exact twin (`nodeTyIsMap`) is NOT the twin for those callers: substituting it at
// `fnHasMapParam` moved 4 corpus rows, because 16 corpus params are nullable- or union-wrapped
// maps that the spelling accepts and a bare `t is TyMap` does not. Width is part of a predicate's
// identity, and the arena form has to match the width of the name form it replaces, not merely
// its subject.
export function nodeTyReachesMap(ix: i32): boolean {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  tyReachesMap(ty)
}

function tyReachesMap(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyMap { return true }
  if t is TyNullable { return tyReachesMap(t.nInner) }
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if tyReachesMap(t.uMembers[i]) { return true }
      i = i + 1
    }
    return false
  }
  false
}

export function nodeTyIsMap(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  t is TyMap
}

// The emitter-format VALUE type-name of node `ix`'s recorded map type (`string` for `{[string]: string}`,
// `f32` for `{[string]: f32}`), or "" if `ix` is not a map. RENDERS the value type (`tyToEmitName`), so
// the emitter calls it only as a map-SHAPE fallback (`mapShapeOfExpr`) for a map-returning closure value
// call — never on the hot path. The value name resolves to the map's mv slot via `mvSlotOfMapValNameOrMono`.
export function nodeTyMapValName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyMap { return tyToEmitName(t.mVal) }
  ""
}

// The WHOLE map spelling of node `ix`'s recorded map type — `{[K]:V}`, the emit render,
// which is character-for-character the synthetic name `parseType` builds for an annotated
// `{[K]: V}`. "" when `ix` is not a map, or when either half is still a hole (an unpinned
// `Map()` renders ""), so a caller reading this gets a name it can synthesize an
// ANNOTATION from or nothing at all. The KEY-and-VALUE twin of `nodeTyMapValName`, for the
// consumers that need the map's own identity rather than its value's:
// `emit_mono.monoArgTyName` pins an un-annotated PARAM from it.
export function nodeTyMapName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyMap { return tyToEmitName(ty) }
  ""
}

// True if node `ix`'s recorded type is an i32-KEYED map (`{[i32]: V}`), one `| null`
// wrapper tolerated — the KEY twin of `nodeTyMapValName`, and a NO-RENDER variant-tag
// walk. The emitter's shape resolvers (`mapShapeOfExpr`'s arena fall-through) ask it to
// pick the i32-keyed map struct for a receiver whose syntactic arms carry no type NAME.
//
// The KEY question is `mapKeyRepTy`'s, not an index compare: a nominal newtype key is a
// distinct arena index over the same `Ty`, so `mKey == TY_I32` answered FALSE for a
// `{[Id]: V}` whose emit name canons to `{[i32]: V}` — the checker and the emitter would
// have picked different map structs for one type.
// `nodeTyMapKeyIsI32` with the SPAN `nameIsI32KeyedMap` actually has. That predicate is
// `mapSpellKeyName(name) == "i32"`, which cuts the `{[K]:` span from ANYWHERE in the spelling —
// so it answers TRUE for `{[i32]: V}[]`, an ARRAY of i32-keyed maps, while the exact arena twin
// peels only a `| null` hop and declines. Converting a caller from the name to the exact twin
// would therefore NARROW it.
//
// That direction is the dangerous one HERE. The callers are the `mI32Used` type-MINTING flags:
// over-answering mints a wasm type that goes unused, under-answering leaves a needed type
// unminted and the module invalid. So the conversion needs the span, not the exact form.
//
// Kept separate from `nodeTyMapKeyIsI32` rather than widening it, because that one has eight
// callers asking the EXACT question about one type, and this asks "does an i32-keyed map occur
// anywhere under here".
export function nodeTyMapKeyIsI32Span(ix: i32): boolean {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  tyMapKeyIsI32Span(ty)
}

function tyMapKeyIsI32Span(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyMap { return mapKeyRepTy(t.mKey) == TY_I32 }
  if t is TyNullable { return tyMapKeyIsI32Span(t.nInner) }
  if t is TyArray { return tyMapKeyIsI32Span(t.aElem) }
  false
}

export function nodeTyMapKeyIsI32(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    const it = T.tys[t.nInner]
    if it is TyMap { return mapKeyRepTy(it.mKey) == TY_I32 }
    return false
  }
  if t is TyMap { return mapKeyRepTy(t.mKey) == TY_I32 }
  false
}

// True if node `ix` has a recorded NULLABLE-STRUCT type (`P | null`) — a cheap NO-RENDER check (a
// `TyNullable` wrapping a `TyObj`). The nullable dual of `nodeTyIsObj`: gates the emitter's nullable
// consumer classifiers (`exprNullableStruct`) so a nullable-struct-returning closure value call whose
// callee they miss (an indexed closure-array element `arr[i](x)`) still classifies kind-9.
export function nodeTyIsNullableStruct(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    const it = T.tys[t.nInner]
    return it is TyObj
  }
  false
}

// True if node `ix` has a recorded NULLABLE type (`TyNullable`, any inner). The emitter
// uses it to decide whether a `??` result stays nullable — a `?? null` (or a nullable-typed
// default) leaves the coalesce result nullable, so the ref-value recover must be skipped.
export function nodeTyIsNullable(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  T.tys[ty] is TyNullable
}

// True if node `ix` has a recorded `string | null` type — the niche-string (kind 16) dual of
// `nodeTyIsNullableStruct`. Gates `exprNullableString`'s fallback so a `string | null`-returning
// closure value call whose callee it misses (an indexed closure-array element) classifies kind-16.
// A nullable LITUNION (`K0 | null`) is EXCLUDED first: the emit name of each string-literal
// member is `string` (and they dedup), so the emit NAME alone can't tell `K0 | null` from
// `string | null` — but the litunion niche reps as an i32 (atom id / `-1` sentinel), not a
// string ref, and claiming it kind-16 stored the callee's i32 result into a
// `(ref null $array)` local (INVALID-WASM). Decided by `tyEmitNameIsString` — the same
// question `tyToEmitName(t.nInner) == "string"` asked, answered off the arena.
export function nodeTyIsNullableString(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    if tyIsLitUnion(t.nInner) { return false }
    return tyEmitNameIsString(t.nInner)
  }
  false
}

// The emitter-format shape NAME of a nullable-struct node `ix`'s INNER struct (`{x:i32}` for a
// `P | null`), or "" otherwise. RENDERS (`tyToEmitName`), so the emitter calls it only as a struct-index
// FALLBACK (`structIndexOfExpr`) for a nullable-returning closure value call — never on the hot path.
// The nullable sibling of `nodeTyName`, resolving to the inner struct's layout index via
// `structIndexOfTypeName`.
export function nodeNulStructInnerName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyNullable {
    const it = T.tys[t.nInner]
    if it is TyObj { return tyToEmitName(t.nInner) }
  }
  ""
}

// The emitter-format union NAME of node `ix` (a value union "i32|string" or a struct union "Cat|Dog"),
// or "" if its recorded type is not a 2+-member union. RENDERS the union (`tyToStr`, the #494-costly
// op), so the emitter calls it only as a FALLBACK — for a union-valued CALL result whose callee its
// syntactic resolution misses (an indexed closure-array call `arr[i](x)`) — never on the hot path
// (declared / param / binding unions resolve from the cheap annotation string). The name-typed sibling
// of `nodeTyIsUnion`, needed for the value-union UNBOX (the struct case narrows via the variant alone).
export function nodeUnionName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyUnion {
    if t.uMembers.length >= 2 {
      // CHEAPLY gate to a VALUE union (all members scalar/literal atoms) BEFORE rendering: a STRUCT
      // union (e.g. the huge `Node`) has object members, and `valueUnionRetName`/`structUnionRetName`
      // would RENDER it (`tyToStr` — the #494 ~4× self-compile cost) only to decline / for the
      // variant path that doesn't need the name. The value-union UNBOX (the sole caller's need) is the
      // only case that requires a name here; a struct-union narrow resolves via the variant alone.
      let allValue = true
      let i = 0
      while i < t.uMembers.length {
        const mt = T.tys[t.uMembers[i]]
        if !(mt is TyPrim) {
          if !(mt is TyLit) { allValue = false }
        }
        i = i + 1
      }
      if allValue { return valueUnionRetName(ty) }
      // A REF-ARM value union (`T[] | {w: i32}` — repOf item (d)): a binding INFERRED from a
      // closure-value call of this result type narrows (`t1 is T[]`) but its unbox gated on
      // `unionNameOfIdent`, which reached this fallback and got "" — the raw box leaked into
      // the indexed read (INVALID-WASM nominal / a TRAP annotated, the #911 finding). Render
      // the union's NOMINAL name (the same spelling the recording arm registers and
      // `synthRetAnnots` pins), so the narrowed read unboxes like any other union binding.
      // Declines ("") for an anonymous-element array arm — the #911 declared-twin-gated
      // shapes stay a loud reject. Reached only on the Call fallback (never the hot path),
      // and `refArmUnionRetName` structurally pre-gates before rendering (#494 discipline).
      const ran = refArmUnionRetName(ty, gRootStmts)
      if ran != "" { return ran }
      // A MAP-member union (`{[string]: i32} | boolean`): a binding INFERRED from a
      // closure-value call of this result type (a narrowed nullable-closure rebind
      // `t0()`) holds the box, and its narrowed MAP-arm read must unbox — which keys
      // on this name. Render the same spelling `mapUnionRetName` pins on an adopted
      // lambda (the registered union name), so the unbox resolves exactly like the
      // annotated-binding path.
      const mun = mapUnionRetName(ty)
      if mun != "" { return mun }
      // A MIXED variant-box union (`f64 | {w: i32}`, `K0 | boolean` — ≥1 non-object arm):
      // a binding INFERRED from a closure-value call of this result type (an indexed
      // closure-array element `v[0](1)`, a narrowed nullable-closure rebind `t0()`) holds
      // the box, and its narrowed read must UNBOX — which keys on this name. Render the
      // same spelling `variantBoxUnionRetName` pins on the adopted lambda (the registered
      // union name), so the unbox resolves exactly like the annotated-binding path. A
      // pure-OBJECT union (`{f: string} | {w: i32}`, the huge `Node`) stays "" — its
      // narrow resolves via the variant alone and the render is the #494-costly op the
      // hot path must avoid (`mixedVariantBoxGate` declines before any member renders).
      if mixedVariantBoxGate(t.uMembers) {
        const vbn = variantBoxUnionRetName(ty)
        if vbn != "" { return vbn }
        // A CLOSURE-ARM value union (`(()=>string) | i64`): a binding INFERRED from a
        // closure-value call of this result type (an indexed closure-array element
        // `v[0](1)`) holds the box, and its narrowed read must UNBOX — which keys on
        // this name. Render the same spelling `cloArmValueUnionRetName` pins on the
        // adopted lambda (the registered union name), so the unbox resolves exactly
        // like the annotated-binding path.
        const can = cloArmValueUnionRetName(ty)
        if can != "" { return can }
      }
    }
  }
  // A nullable value SCALAR (`i32 | null`) is a `TyNullable`, NOT a `TyUnion`, yet reps as the
  // value-union {tag,value} BOX — so a value call whose result is `i32 | null` (a `??`-derived
  // closure `t0(1)` with no lifted fe / annotation) resolves its box name here for the binding's
  // union unbox / narrow, mirroring the annotated-closure path. `valueUnionRetName` gates through
  // `isValueUnionName`, which admits ONLY the numeric-scalar nullables that box (`i32|null`, …) and
  // declines the `boolean|null` / `string|null` NICHES, so those stay "" (their niche rep handles).
  if t is TyNullable {
    const nvn = valueUnionRetName(ty)
    if nvn != "" { return nvn }
    // A NULLABLE variant-box union (`{a,f,z} | i32 | null`): a binding inferred from a
    // closure-value call of this result type holds the `>u` box (the null is a member
    // atom) — render the same spelling `variantBoxUnionRetName` pins on the adopted
    // lambda, so the narrowed read unboxes and `!= null` tag-tests like the annotated
    // path. `mixedVariantBoxGate` pre-gates before any member renders (#494 discipline).
    const nit = T.tys[t.nInner]
    if nit is TyUnion {
      if mixedVariantBoxGate(nit.uMembers) {
        const nvb = variantBoxUnionRetName(ty)
        if nvb != "" { return nvb }
      }
    }
    return ""
  }
  ""
}

// Roll the inferred-return table back to `mark` — ALL FIVE columns, not two.
//
// `recordInferRet` pushes five parallel columns (`inferRetFn`, `inferRetTy`, `inferRetAtomCount`,
// `inferRetTyIx`, `inferRetRung`) and claims `inferRetIdx[name]` first-wins. The two speculative
// re-check probes below used to undo that by popping TWO of the five, while the `binCstr*` group
// three lines up pops every column of ITS group.
//
// THIS IS UNREACHABLE, AND `inferQuiet` IS WHY — not, as a first draft of this comment claimed, a
// pass schedule. That framing pointed the next reader at a tripwire that does not exist and stayed
// quiet about the edit that would actually arm this. The name-keyed `recordInferRet` calls live in
// `checkProgram`, which the probes never call, so no reordering can put them in reach. The one
// recorder the probes CAN reach is the node-keyed call in `checkFuncDeclNode` — and its whole
// block is gated `} else if !inferQuiet {`, while both probes set `inferQuiet = true` for the
// duration and nothing inside can clear it. So `inferRetFn.length` cannot exceed `mark` here.
//
// **The edit that arms this is relaxing that `!inferQuiet` gate**, and nothing else.
//
// `paramSolveProbe`, the third quiet re-check, takes no `inferRet*` mark at all and does not need
// one for the same reason. It is not an omission.
//
// THE INDEX IS DELIBERATELY NOT ROLLED BACK. A `.delete()` here would be the compiler's first, and
// `emitMapDelete` inlines a tombstone plus an amortized compaction at every site — measured at
// 1,003 bytes of compiler binary to roll back a table that cannot have grown. The readers are
// hardened instead: `inferRetTyAt` / `inferRetTyIxAt` now bounds-check like their
// `inferRetAtomCountAt` / `inferRetRungAt` siblings already did, so a stale index entry yields -1
// rather than an out-of-bounds read. That is the same defence at a twentieth of the cost, and it
// protects the readers whether or not the rollback is ever reached.
function rollbackInferRet(mark: i32) {
  while inferRetFn.length > mark { inferRetFn.pop() }
  while inferRetTy.length > mark { inferRetTy.pop() }
  while inferRetTyIx.length > mark { inferRetTyIx.pop() }
  while inferRetAtomCount.length > mark { inferRetAtomCount.pop() }
  while inferRetRung.length > mark { inferRetRung.pop() }
  0
}

// MONOMORPHIC BODY INFERENCE — lift the element-hole ceiling for an un-annotated param.
// The shared definition body of a function is type-checked ONCE with each un-annotated
// parameter bound to an OPAQUE inference hole, so an inferred empty-list local built from a
// pass-through (`out.push(self[i])`) pins its element (the indexed param's element name), but
// one built from a NON-TRIVIAL expression over the element (`out.push(self[i] * 2)`) cannot —
// the hole isn't known to be numeric. This re-checks the body for ONE concrete call shape:
// each parameter is bound to its pinned type (`paramTyIxs`, ARENA INDICES aligned with the
// decl's params; -1 = unpinned, bound to the error type), so the SAME existing list-element
// inference resolves the local concretely. Returns the inferred LIST type-name of `localName`
// (`"i32[]"`, `"f64[]"`), or "" when it is not an inferred list or stays generic — in which
// case the emitter keeps its prior behavior.
//
// The pins arrive already RESOLVED: the monomorphizer banks `recordClonedNodeTy`'s return (and
// `i32TyIx()` on the arm that mints no annotation node) as it clones the params, so no pinned
// type spelling is re-resolved here. The parameter is an index column, not a name column.
//
// Runs fully ISOLATED at emit time (after the real check pass): `nodeTyIx` recording and
// symbols are suppressed via `inferQuiet`, and every diagnostic / inference table the body
// check appends to is truncated back to its saved length, so the global checker state the
// emitter still reads is byte-identical afterwards. Mirrors `inferReturnsPrePass`'s discipline.
export function monoInferListElem(
  declIx: i32,
  paramTyIxs: i32[],
  localName: string,
) {
  if declIx < 0 { return "" }
  const dn = P.nodes[declIx]
  if !(dn is FuncDecl) { return "" }
  const body = P.nodes[dn.fnBody]
  if !(body is Block) { return "" }
  // Snapshot the suppression flags and every append-only inference/diagnostic table.
  const sQuiet = inferQuiet
  const sSym = symEnabled
  const sDiag = T.diags.length
  const sHoleN = holeShapeNames.length
  const sHoleT = holeShapeTys.length
  const sHoleArr = holeArrayDemand.length
  const sHoleMap = holeMapNames.length
  const sHoleAlt = holeAltNames.length
  const sBinC = binCstrOp.length
  const sILet = inferLetIx.length
  const sINulS = inferLetNulStrIx.length
  const sINulB = inferLetNulBoolIx.length
  const sIRet = inferRetFn.length
  const sStack = inferStack.length
  const sTent = inferTentative.length
  const sRedun = redunName.length
  inferQuiet = true
  symEnabled = 0
  // Bind the parameters concretely in a fresh scope, then check the body STATEMENTS in
  // that scope directly (not `checkNode(dn.fnBody)`, whose Block arm would push+pop its own
  // scope and drop the local before we can read it). The list element hole resolves through
  // the pushes; a `return`'s check against a stale `T.curRet` only yields a truncated diag.
  pushScope(dn.fnBody)
  const params = dn.fnParams
  let pi = 0
  while pi < params.length {
    const p = P.nodes[params[pi]]
    if p is Param {
      let pty = TY_ERR
      if pi < paramTyIxs.length {
        if paramTyIxs[pi] >= 0 { pty = paramTyIxs[pi] }
      }
      declare(p.parName, pty)
    }
    pi = pi + 1
  }
  const stmts = body.blkStmts
  let s = 0
  while s < stmts.length {
    checkNode(stmts[s])
    s = s + 1
  }
  // Read the resolved local: a fully-pinned `T[]` (element no longer a `TyVar`) renders its
  // list type name; anything else (not a list, or still generic) yields "".
  let listName = ""
  const lt = lookup(localName)
  if lt >= 0 {
    const ltt = T.tys[lt]
    if ltt is TyArray {
      if ltt.aElem >= 0 {
        const el = T.tys[ltt.aElem]
        if !(el is TyVar) { listName = tyToStructStr(lt) }
      }
    }
  }
  popScope()
  // Restore: truncate every table back, then the flags + diagnostic stream.
  while holeShapeNames.length > sHoleN { holeShapeNames.pop() }
  while holeShapeTys.length > sHoleT { holeShapeTys.pop() }
  while holeArrayDemand.length > sHoleArr { holeArrayDemand.pop() }
  while holeMapNames.length > sHoleMap {
    holeMapNames.pop()
    holeMapTys.pop()
  }
  while holeAltNames.length > sHoleAlt {
    holeAltNames.pop()
    holeAltTys.pop()
    holeAltPreN.pop()
    holeAltTailN.pop()
    holeAltHoleIx.pop()
  }
  while binCstrOp.length > sBinC {
    binCstrOp.pop()
    binCstrLt.pop()
    binCstrRt.pop()
  }
  while inferLetIx.length > sILet { inferLetIx.pop() }
  while inferLetTy.length > sILet { inferLetTy.pop() }
  while inferLetNulStrIx.length > sINulS { inferLetNulStrIx.pop() }
  while inferLetNulBoolIx.length > sINulB { inferLetNulBoolIx.pop() }
  rollbackInferRet(sIRet)
  while inferStack.length > sStack { inferStack.pop() }
  while inferTentative.length > sTent { inferTentative.pop() }
  redunTruncate(sRedun)
  while T.diags.length > sDiag { T.diags.pop() }
  symEnabled = sSym
  inferQuiet = sQuiet
  listName
}

// The SCALAR sibling of `monoInferListElem`: re-check the body of `declIx` with its params
// pinned to `paramTyIxs` (arena indices, same column its list sibling takes) and read the
// resolved type of the LOCAL `localName`, returning its
// prim NAME when it settles on a concrete NON-i32 scalar (`string` / `f64` / `i64` / `f32`),
// else "". This lets the monomorphizer type an un-annotated `return <local>` whose local is a
// scalar ELEMENT of a hole-pinned param (`const t = self[i]; return t`, or a `let acc = "";
// acc = acc + self[i]; return acc` fold) — the emitter's return-kind inference runs BEFORE
// locals are collected and the checker's typed-IR is stale for a hole-derived node, so without
// this the instance's functype result defaults to i32 and clashes with the string/f64 ref the
// body returns. i32 / boolean (both i32 valtype) and any still-generic local yield "" so the
// existing inferred-return path is left byte-identical. The save/restore mirrors
// `monoInferListElem` exactly (every append-only inference/diagnostic table is truncated back).
export function monoInferLocalScalar(
  declIx: i32,
  paramTyIxs: i32[],
  localName: string,
) {
  if declIx < 0 { return "" }
  const dn = P.nodes[declIx]
  if !(dn is FuncDecl) { return "" }
  const body = P.nodes[dn.fnBody]
  if !(body is Block) { return "" }
  const sQuiet = inferQuiet
  const sSym = symEnabled
  const sDiag = T.diags.length
  const sHoleN = holeShapeNames.length
  const sHoleT = holeShapeTys.length
  const sHoleArr = holeArrayDemand.length
  const sHoleMap = holeMapNames.length
  const sHoleAlt = holeAltNames.length
  const sBinC = binCstrOp.length
  const sILet = inferLetIx.length
  const sINulS = inferLetNulStrIx.length
  const sINulB = inferLetNulBoolIx.length
  const sIRet = inferRetFn.length
  const sStack = inferStack.length
  const sTent = inferTentative.length
  const sRedun = redunName.length
  inferQuiet = true
  symEnabled = 0
  pushScope(dn.fnBody)
  const params = dn.fnParams
  let pi = 0
  while pi < params.length {
    const p = P.nodes[params[pi]]
    if p is Param {
      let pty = TY_ERR
      if pi < paramTyIxs.length {
        if paramTyIxs[pi] >= 0 { pty = paramTyIxs[pi] }
      }
      declare(p.parName, pty)
    }
    pi = pi + 1
  }
  const stmts = body.blkStmts
  let s = 0
  while s < stmts.length {
    checkNode(stmts[s])
    s = s + 1
  }
  // Read the resolved local: a concrete NON-i32 scalar prim renders its name; anything else
  // (i32 / boolean / non-scalar / still-generic) yields "" → the inferred-return path is left
  // untouched.
  let scalarName = ""
  const lt = lookup(localName)
  if lt >= 0 {
    const ltt = T.tys[lt]
    if ltt is TyPrim {
      const pn = ltt.primName
      if pn == "string" || pn == "f64" || pn == "i64" || pn == "f32" {
        scalarName = pn
      }
    }
  }
  popScope()
  while holeShapeNames.length > sHoleN { holeShapeNames.pop() }
  while holeShapeTys.length > sHoleT { holeShapeTys.pop() }
  while holeArrayDemand.length > sHoleArr { holeArrayDemand.pop() }
  while holeMapNames.length > sHoleMap {
    holeMapNames.pop()
    holeMapTys.pop()
  }
  while holeAltNames.length > sHoleAlt {
    holeAltNames.pop()
    holeAltTys.pop()
    holeAltPreN.pop()
    holeAltTailN.pop()
    holeAltHoleIx.pop()
  }
  while binCstrOp.length > sBinC {
    binCstrOp.pop()
    binCstrLt.pop()
    binCstrRt.pop()
  }
  while inferLetIx.length > sILet { inferLetIx.pop() }
  while inferLetTy.length > sILet { inferLetTy.pop() }
  while inferLetNulStrIx.length > sINulS { inferLetNulStrIx.pop() }
  while inferLetNulBoolIx.length > sINulB { inferLetNulBoolIx.pop() }
  rollbackInferRet(sIRet)
  while inferStack.length > sStack { inferStack.pop() }
  while inferTentative.length > sTent { inferTentative.pop() }
  redunTruncate(sRedun)
  while T.diags.length > sDiag { T.diags.pop() }
  symEnabled = sSym
  inferQuiet = sQuiet
  scalarName
}

// Whether the LetDecl at `letIx` was recorded as an inferred `string | null` niche
// if-binding (the niche analogue of `inferLetNameOf`). The emitter's `letIsNulString`
// consults this so the slot classifies as kind 16 and reuses the annotated lowering.
export function isInferLetNulStr(letIx: i32) {
  let i = 0
  while i < inferLetNulStrIx.length {
    if inferLetNulStrIx[i] == letIx { return true }
    i = i + 1
  }
  false
}

// The `boolean | null` companion of `isInferLetNulStr`: whether the LetDecl at `letIx`
// was recorded as an inferred `boolean | null` niche if-binding. The emitter's
// `letNulBool` consults this so the slot classifies as the niche i32 rep.
export function isInferLetNulBool(letIx: i32) {
  let i = 0
  while i < inferLetNulBoolIx.length {
    if inferLetNulBoolIx[i] == letIx { return true }
    i = i + 1
  }
  false
}

// ── value-union NAME classification (moved from wasmEmit to break the
// typecheck→emitter import cycle; pure string/atom logic the checker needs too) ──
// ── inline union annotations (`v: A | B`) ─────────────────────────────────────
// An INLINE union annotation parses to a `TypeRef` whose synthetic name is the
// pipe-joined member list (`"A|B"`, mirroring the `i32[]` / `{[K]:V}` synthetic
// names — see `parser.vl`'s `parseTypeName`). A NAMED alias `type N = A | B` is a
// `UnionDecl` whose name `"N"` is registered in `unNames`; an inline annotation has
// no such name, so none of the name-keyed union machinery (`isUName`, valtype
// interning, narrowing) recognizes it. To make an inline `A | B` behave IDENTICALLY
// to a named alias, we register the synthetic name itself as a union alias — the
// same tables, the same heap-type interning, the same tags — so every downstream
// lookup keyed on the type-name string just works.
//
// **THE TWO SPLITTERS OF THAT SYNTHETIC NAME ARE NOT HERE ANY MORE.**
// `splitUnionAtoms` and `unionMemberCount` — the top-level `|` split and its counting
// dual — are pure functions of a string that depend on nothing but `tyTopIndexOf`, so
// D-TYNAMEHOME phase 2 moved them to their family's home in `tyname.vl` alongside
// `tyTopLevelSplit`. This file imports them back (see the module-line comment at the top)
// and every call site below is untouched.

// The value-atom kind of a NICHE-nullable scalar-element LIST member name —
// `(boolean | null)[]` / `(K | null)[]` share the i32-list backing (kind 7),
// `(string | null)[]` the string-list backing (kind 9); -1 otherwise. The element's
// null encodes INSIDE the element rep (sentinel 2 / `-1` / `ref.null $a`), so the
// outer list carries no extra structure beyond its leaf backing's list.
function nulElemListAtomKind(name: string) {
  // The whole prelude — array TEST, `[]` CUT, one NAIVE grouping-paren strip — is
  // `listElemNameOf` at its home in `tyname.vl`, character for character. The `n < 5` cheap
  // reject is kept as the fast path it always was (a 4-character name cannot be a
  // nullable-element list), and it also makes the `elem == ""` decline unreachable:
  // with `n >= 5` an array element is at least 3 characters long.
  if name.length < 5 { return -1 }
  const elem = listElemNameOf(name)
  if elem == "" { return -1 }
  const atoms: string[] = []
  splitUnionAtoms(elem, atoms)
  if atoms.length < 2 { return -1 }
  let sawNull = false
  const rest: string[] = []
  let i = 0
  while i < atoms.length {
    if atoms[i] == "null" { sawNull = true } else { rest.push(atoms[i]) }
    i = i + 1
  }
  if !sawNull { return -1 }
  if rest.length == 0 { return -1 }
  if rest.length == 1 {
    if rest[0] == "boolean" { return 7 }
    if rest[0] == "string" { return 9 }
    if nameIsLitUnionType(rest[0]) { return 7 }
    return -1
  }
  // The expanded inline litunion form (`("a" | "b" | null)[]`) — decided from the ATOMS
  // this function already holds, not from a name rebuilt out of them.
  //
  // It used to JOIN `rest` back into `"a"|"b"` and hand the join to `nameIsLitUnionType`,
  // which re-SPLIT it (`nameIsInlineLitUnion` → `splitUnionAtoms`) into the very list
  // `rest` already is: a decision that was a projection of a value the caller was holding
  // (method note 2). The join and the re-split are both gone, and the answer is unchanged
  // by construction on both of that predicate's legs:
  //   · its DECLARED-alias leg (`cUserTypes.has`) is dead here — a joined name carries a
  //     `|`, and no declared type NAME can, so the lookup could never hit;
  //   · its INLINE leg is exactly "2+ top-level atoms, each a quoted string literal", and
  //     `rest` IS that top-level split (a `|`-join of top-level atoms re-splits to itself,
  //     since no atom carries a top-level `|` of its own), with `rest.length >= 2` already
  //     established by the arm above.
  let q = 0
  while q < rest.length {
    const a = rest[q]
    if a.length < 2 { return -1 }
    // The QUOTED-LEAF test at its home (`tyname.nameIsQuotedLeaf`, W3) — this is the
    // inlined copy of `nameIsInlineLitUnion`'s per-atom leg the comment above describes,
    // and the census's W3 list did not carry it.
    if !nameIsQuotedLeaf(a) { return -1 }
    q = q + 1
  }
  7
}

// True if `name` is a VALUE union carrying a literal-union ALIAS arm (`K0 | i64`,
// `K0 | f64`): ≥2 top-level atoms, every atom a value atom / `null` / a declared
// litunion alias, at least one alias arm and ≥2 non-null arms. Such a union boxes
// like a value union — the litunion arm rides the box as its member-string atom
// (tag `string`), so a closure result pinned to this name lowers exactly like the
// annotated named-function spelling. The alias arm makes `isValueUnionName`
// decline (its `valueAtomKind` is -1), hence this dedicated predicate.
export function nameIsLitUnionArmValueUnion(name: string) {
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  if atoms.length < 2 { return false }
  let hasAlias = false
  let nonNull = 0
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    if a != "null" {
      nonNull = nonNull + 1
      if nameIsLitUnionType(a) { hasAlias = true }
      else if valueAtomKind(a) < 0 { return false }
    }
    i = i + 1
  }
  hasAlias && nonNull >= 2
}

// ── value-union atom classification ───────────────────────────────────────────
// The atom KIND of a value-union member type name: 0 i32, 1 boolean, 2 string,
// 3 i64, 4 f64, 5 f32, 6 null, 11 closure (a function type — a REF atom riding the
// box anyref), 7-10/12 scalar-element lists — or -1 for anything else (a struct
// name, an inline shape, a ref-element array).
// The kind doubles as the atom's tag offset (`scalarTagOf`).
// The literal-union ELEMENT name of a `K[]` / `("a"|"b")[]` array type-name, or "" when
// `name` is not a litunion array. The checker-side twin of the emitter's
// `nameIsLitUnionArray` (which typecheck cannot import): strip the trailing `[]`, peel
// one grouping-paren layer, and require a litunion (`nameIsLitUnionType` — a named alias
// or an inline all-quoted member set). Cheap-rejects any name not ending in `[]`.
export function litUnionArrayElemOf(name: string) {
  // Array TEST + `[]` CUT + one NAIVE paren strip = `listElemNameOf` at its home in `tyname.vl`.
  // The `n < 3` cheap reject is kept; it is also what made the two answers "" carries
  // (not an array / the degenerate `"[]"`) indistinguishable here already — both decline.
  if name.length < 3 { return "" }
  const elem = listElemNameOf(name)
  if elem == "" { return "" }
  if nameIsLitUnionType(elem) { return elem }
  ""
}

export function valueAtomKind(name: string) {
  if name == "i32" { return 0 }
  if name == "boolean" { return 1 }
  if name == "string" { return 2 }
  if name == "i64" { return 3 }
  if name == "f64" { return 4 }
  if name == "f32" { return 5 }
  if name == "null" { return 6 }
  // A LIST member of a value union (`i32[] | string`) is a REF atom — the union box's
  // `value` field holds the list WRAPPER ref directly (like a string), no scalar box. Each
  // list type gets a distinct code so it tags distinctly (`boolean[]` shares the i32 list).
  //
  // The five list arms below took the array grammar's ONE CUT once, here, and then compare a
  // LEAF name — the seam `isClassifiableRetName` / `isScalarListRetName` split too. Before,
  // each arm matched a WHOLE rendering (`name == "f64[]"`), which fuses the `[]` (structure)
  // and the `f64` (a name) into one opaque compare so neither half can be seen or shared;
  // this function then re-took the very same cut two arms later inside `litUnionArrayElemOf`
  // and `nulElemListAtomKind`. Provably equivalent, arm for arm: `arrElemNameRaw` yields ""
  // for a non-array name and otherwise `name` minus its final two characters, so
  // `elem == "f64"` holds on exactly the inputs `name == "f64[]"` holds on. The arm ORDER is
  // unchanged, and the binding is pure, so hoisting it above the litunion arm decides nothing.
  const elem = arrElemNameRaw(name)
  if elem == "i32" || elem == "boolean" { return 7 }
  // A literal-union ARRAY (`K[]` over `type K = "a" | "b"`, or an inline `("a"|"b")[]`): its
  // elements are interned i32 ATOM ids, so the list shares the exact `i32[]` backing and rides
  // the SAME kind-7 atom (`boolean[]`'s pattern — the construct seeds the atom-element context,
  // a narrowed read yields the atom list). A real `i32[]`/`boolean[]` member cannot coexist with
  // it in one union (same backing, one tag), so the shared tag never mis-discriminates.
  if litUnionArrayElemOf(name) != "" { return 7 }
  if elem == "f64" { return 8 }
  if elem == "string" { return 9 }
  if elem == "i64" { return 10 }
  // The f32 list rides its own atom (the `$fa32`/`$fl32` backing — distinct from the
  // f64 list's kind 8, so `f32[] | i64` tags/unboxes the f32 wrapper). Code 12 sits
  // ABOVE the closure kind 11: the codes are append-only (each doubles as a tag offset).
  if elem == "f32" { return 12 }
  // A NICHE-nullable scalar-element LIST member (`(boolean | null)[]`, `(K | null)[]`,
  // `(string | null)[]`): the element's null rides IN the element rep (an i32 sentinel /
  // `ref.null` string), so the list IS its leaf backing's atom — the i32 list (7) or the
  // string list (9). One kind per backing keeps the `is`-compare tag consistent with
  // `emitUnionCoerce`'s carrier classification ("i32[]" / "string[]").
  const nk = nulElemListAtomKind(name)
  if nk >= 0 { return nk }
  // A CLOSURE member (`(() => i64) | i64`) is a REF atom (kind 11) — the closure
  // fat-pointer struct rides the box's anyref `value` directly (a `structref`
  // subtype), no per-rep scalar value box. Checked LAST so a concrete scalar/list
  // name (none of which carry a top-level `=>`) never reaches it.
  if nameIsFuncTypeAtom(name) { return 11 }
  -1
}

// True if `name` is a VALUE union this emitter boxes: 2+ top-level atoms, every
// atom a scalar/string/null name, and either (a) 2+ non-null atoms, or (b) exactly
// one non-null NUMERIC atom plus `null` (`i32 | null` — a scalar has no spare null
// niche, so it boxes; `boolean | null` keeps its existing sentinel NICHE encoding,
// and a single REF member + null (`S | null`, `string | null`) stays a niche
// nullable ref — neither is a box).
export function isValueUnionName(name: string) {
  if unionMemberCount(name) < 2 { return false }
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  let nonNull = 0
  let hasNull = false
  let soloKind = -1
  let i = 0
  while i < atoms.length {
    const k = valueAtomKind(atoms[i])
    if k < 0 { return false }
    if k == 6 {
      hasNull = true
    } else {
      nonNull = nonNull + 1
      soloKind = k
    }
    i = i + 1
  }
  if nonNull >= 2 { return true }
  if nonNull == 1 && hasNull {
    // Only a NUMERIC scalar boxes with null; boolean|null / string|null are niches.
    return soloKind == 0 || soloKind == 3 || soloKind == 4 || soloKind == 5
  }
  false
}

// True when a binary operator's two operands carry INCOMPATIBLE nominal brands
// (P1.5). Equal brands — including two un-branded operands, the overwhelming case —
// are compatible. A syntactic LITERAL on the un-branded side adopts, so only a
// branded operand meeting a base-typed or differently-branded VALUE reports.
function nomBinMixes(lt: i32, rt: i32, lx: i32, rx: i32) {
  // A `null` OPERAND AGAINST NULLABLE STORAGE IS NOT A BRAND MIX. `null` carries no
  // brand and adopts none, and a null test asks about the STORAGE — which for a
  // newtype over a nullable (`type T1 = new (string | null)`, `new (K | null)`)
  // genuinely admits it. This was the ONE shape a brand made unwritable: `v != null`
  // read `cannot compare T1 and null`, so such a value could be neither tested nor
  // narrowed, and there is no other spelling of the test.
  //
  // GATED ON `tyAdmitsNull`, and the gate is load-bearing rather than defensive. This
  // predicate is read TWICE — here, and as the `nomEqLit` escape in the equality arm —
  // so answering "not a mix" for a NON-nullable brand does not merely soften this
  // message, it suppresses the general `cannot compare … with null` reject too:
  // `type Id = new i32` + `if v != null` walked past the checker and became an
  // `emitProgram: bare null needs a struct-typed context` emit reject instead.
  if isNullTy(lt) && tyAdmitsNull(rt) { return false }
  if isNullTy(rt) && tyAdmitsNull(lt) { return false }
  const ln = nomNameOfTy(lt)
  const rn = nomNameOfTy(rt)
  if ln == rn { return false }
  if ln == "" {
    if exprIsBrandAdoptingLiteral(lx) { return false }
  }
  if rn == "" {
    if exprIsBrandAdoptingLiteral(rx) { return false }
  }
  true
}

// Extracted from `checkNodeReal`'s `BinExpr` arm (C3: thin the dispatcher).
function checkBinExprNode(n: BinExpr, ix: i32) {
  const op = n.binOp
  // `a && b` / `a || b`: the LEFT side's narrowings hold while CHECKING the
  // right (`p != null && p.x > 0` checks `p.x` under a non-null `p`; for `||`
  // the right is reached only when the left was FALSE, so its else-narrowings
  // hold — `p == null || p.x > 0`).
  if op == "&&" || op == "||" {
    const clt = checkNode(n.binLeft)
    const cnames: string[] = []
    const ctys: i32[] = []
    if op == "&&" {
      collectThenNarrows(n.binLeft, cnames, ctys)
    } else {
      collectElseNarrows(n.binLeft, cnames, ctys)
    }
    let cpushed = 0
    if cnames.length > 0 {
      pushScope(-1)
      applyNarrows(cnames, ctys)
      cpushed = 1
    }
    const crt = checkNode(n.binRight)
    if cpushed == 1 { popScope() }
    if !assignable(clt, TY_BOOL) || !assignable(crt, TY_BOOL) {
      tErr("operator '" + op + "' expects boolean operands", ix)
    }
    return TY_BOOL
  }
  // Definite-assignment: the LHS of a plain `=` with a bare-name target is a
  // pure WRITE — flag the target node so the `Ident` arm does not trip
  // use-before-assign on it (the assignment is what assigns it). A compound
  // `x += …` is desugared to `x = x + (…)`: the inner `x` in the RHS is NOT the
  // write target, so its read is still gated. Cleared after the target is
  // checked. Saved/restored so a nested `=` (e.g. `a = (b = c)`) is exact.
  const savedWriteTarget = daWriteTarget
  if op == "=" {
    const wtgt = P.nodes[n.binLeft]
    if wtgt is Ident { daWriteTarget = n.binLeft }
  }
  let lt = checkNode(n.binLeft)
  daWriteTarget = savedWriteTarget
  // Contextual typing for an assignment RHS (`m[k] = (x) => …` over a `{[…]: (i32)=>i32}`
  // map, `xs[i] = (n) => …`, `f = (n) => …`): seed the LHS type so an un-annotated lambda
  // param infers from the target (the let-init / arg / return positions already seed).
  if op == "=" { seedExpected(n.binRight, lt) }
  // Contextual typing for a `??` DEFAULT (`v["k"] ?? (q2) => (12121)` over a `{[string]: (i32) =>
  // i32 | null}` map): seed the default operand with the LHS type so an un-annotated default-lambda
  // param infers from the non-null LHS closure type (`seedExpected` unwraps the `TyNullable` map
  // read to `(i32) => i32 | null`, then seeds `q2: i32`). Without it the bare `(q2) => …` default is
  // an uninferable-param reject. Mirrors the `=` seeding; the LHS non-null shape drives the lambda.
  if op == "??" { seedExpected(n.binRight, lt) }
  let rt = checkNode(n.binRight)
  // The `??` DEFAULT is the value the expression yields when the LHS is null, so a `void`
  // default leaves the coalesce with nothing to produce. The other operators reject a
  // `void` operand through their own arms below (`operator '+' is not defined for void and
  // i32`, `cannot compare void with i32`, …) — `??` has none, because it type-joins its
  // operands rather than demanding a shape of them.
  if op == "??" {
    if voidValueSlotErr(rt, n.binRight, "`??` default", ix) { rt = TY_ERR }
  }
  // A binary op with a HOLE operand can't decide its form until the hole is bound at the call —
  // record the deferred constraint (skipping assignment / logical, handled by their own arms).
  if op != "=" && op != "&&" && op != "||" { noteBinCstr(lt, op, rt) }
  // NOMINAL NEWTYPE (P1.5): the operands of every non-assignment binary operator must
  // carry the SAME brand. Same-brand ops are ALLOWED and the result keeps the brand —
  // that half needs no code, because the arithmetic tail already ends in `return lt`.
  // A literal adopts the other side's brand (`id + 1`, `id == 0`, `"id=" + id`), which
  // is the same rule the assignment positions use.
  //
  // The reject cannot be left to the structural rules: `sameNumeric` compares
  // `primName`, so `EntityId + i32` is invisible to it, and the ordering operators
  // (`<`, `>`) never consult `assignable` at all. Raised HERE, before the operator
  // arms, so one rule covers arithmetic, bitwise, ordering and equality alike.
  if op != "=" && op != "&&" && op != "||" && op != "??" {
    if nomBinMixes(lt, rt, n.binLeft, n.binRight) {
      if op == "==" || op == "!=" {
        tErr("cannot compare " + tyToStr(lt) + " and " + tyToStr(rt), ix)
        return TY_BOOL
      }
      tErr(
        "operator '" + op + "' mixes " + tyToStr(lt) + " and " + tyToStr(rt),
        ix,
      )
      return TY_ERR
    }
  }
  // Assignment: RHS must be assignable to the LHS's (already-bound) type.
  if op == "=" {
    // A `const` NAME cannot be rebound (`x = …`, and the `x++`/`x += …`
    // desugarings). Data behind it stays mutable (a Member/Index target).
    const tgt = P.nodes[n.binLeft]
    if tgt is Ident {
      if isConstName(tgt.identName) {
        tErr("cannot reassign `const` " + tgt.identName, ix)
      }
      // This write makes the binding definitely assigned on the current path.
      daMarkAssigned(tgt.identName)
    }
    // An index-set into an empty `[]` (`xs[i] = v`) pins its element type to
    // `typeof v` in place — usage-driven inference (`infer-empty-index-set.vl`),
    // clearing the uninferred floor. `lt` is the (open `-1`) element type, so
    // every assignment succeeds against it until it is pinned.
    if tgt is Index {
      // The whole left-hand side (receiver included) was already checked as
      // `lt` above — READ the recorded type instead of re-checking, so a
      // diagnostic inside the receiver subtree isn't reported twice. The
      // fallback re-check only fires for a node the table doesn't cover.
      let arrTy0 = nodeTyIxOf(tgt.idxArr)
      if arrTy0 < 0 { arrTy0 = checkNode(tgt.idxArr) }
      // An un-annotated-param HOLE receiver stands for its DEMANDED map (`checkIndexNode`
      // minted it when the index turned out not to be an i32), so the map pin below is the
      // SAME arm the concrete receiver takes rather than a second copy of it: `q["a"] = 1`
      // in a callee's body pins the demand's key and value, and the call site then pins an
      // argument still open (`const m = Map(); put(m)`).
      const arrH0 = T.tys[arrTy0]
      if arrH0 is TyVar {
        const hmw = holeMapOf(arrH0.tvName)
        if hmw >= 0 { arrTy0 = hmw }
      }
      const arrT0 = T.tys[arrTy0]
      if arrT0 is TyArray {
        if arrT0.aElem < 0 {
          arrT0.aElem = rt
          tyMutEpoch = tyMutEpoch + 1 // index-write pinned the element in place
        }
      }
      // An index-set into a bare `Map()` (`m[k] = v`) pins its key and value holes the
      // SAME way `m.set(k, v)` pins them one arm over — the two WRITE spellings of one
      // program have to infer identically, and the array element above is the same rule
      // for the other collection. Without it the index spelling fell to the "cannot
      // infer" floor while both its `.set` twin and its annotated twin ran.
      // The key type is READ off the recorded table (`checkIndexNode` already checked
      // the whole target), so a diagnostic inside the key expression is not raised twice.
      if arrT0 is TyMap {
        if arrT0.mKey < 0 {
          let kt0 = nodeTyIxOf(tgt.idxIndex)
          if kt0 < 0 { kt0 = checkNode(tgt.idxIndex) }
          if kt0 >= 0 {
            arrT0.mKey = kt0
            tyMutEpoch = tyMutEpoch + 1 // index-write pinned the key in place
            checkInferredMapKey(kt0, arrT0.mSet, ix)
          }
        }
        if arrT0.mVal < 0 {
          arrT0.mVal = rt
          tyMutEpoch = tyMutEpoch + 1 // index-write pinned the value in place
        }
      }
      // FREE INDEX-WRITE OPERATOR (B14): `x[i] = v` resolves to a
      // `function "[]="(self: T, i: I, v: V)` by the receiver's TYPE. Banked on
      // THIS assignment node, not on the target `Index` — the target keeps the
      // READ resolution it was checked with, which is what `x[i] += v` needs
      // (its desugaring reads through the very same `Index` node).
      if opIdxDeclared() {
        if !tyBuiltinIndexable(arrTy0) {
          const wfn = opIdxFnFor(OP_INDEX_SET, arrTy0)
          if wfn != "" {
            const wbNames: string[] = []
            const wbTys: i32[] = []
            opIdxBindGen(wfn, arrTy0, nodeTyIxOf(tgt.idxIndex), wbNames, wbTys)
            const vt0 = opIdxParamTy(wfn, 2)
            let vt = vt0
            if vt0 >= 0 {
              if wbNames.length > 0 { vt = substTyDeep(vt0, wbNames, wbTys) }
            }
            if vt >= 0 {
              if !assignableExpr(n.binRight, rt, vt) {
                tErr(
                  "index write: expected " + tyToStr(vt) + ", got " + tyToStr(rt),
                  ix,
                )
              }
            }
            opIdxBank(ix, wfn)
            return rt
          }
          // A READ operator with no WRITE one: name the missing half, exactly as
          // the closure-FIELD trap does below.
          const rOnly = opIdxFnFor(OP_INDEX_GET, arrTy0)
          if rOnly != "" {
            tErr(
              "no \"" +
                OP_INDEX_SET +
                "\" operator for index assignment on " +
                tyToStr(arrTy0),
              ix,
            )
            return TY_ERR
          }
        }
      }
      // Index WRITE trap (B13, host `indexTrap` "[]="): `o[k] = v` on an
      // object that declares `"[]="` checks the value against the method's
      // VALUE parameter (index/wrong-value-type.vl rejects); an object with
      // only a READ trap rejects the write (host: the missing-method error).
      if arrT0 is TyObj {
        const wtrap = objFieldType(arrT0, "[]=")
        if wtrap >= 0 {
          const wt = T.tys[wtrap]
          if wt is TyFunc {
            if wt.fnParamTypes.length == 2 {
              if !assignableExpr(n.binRight, rt, wt.fnParamTypes[1]) {
                tErr(
                  "index write: expected " +
                    tyToStr(wt.fnParamTypes[1]) +
                    ", got " +
                    tyToStr(rt),
                  ix,
                )
              }
              return rt
            }
          }
        } else if objFieldType(arrT0, "[]") >= 0 {
          tErr(
            "no \"[]=\" method for index assignment on " + tyToStr(arrTy0),
            ix,
          )
          return TY_ERR
        }
      }
    }
    // WHAT A PLACE ACCEPTS IS ITS STORAGE TYPE, NOT ITS CURRENT FLOW TYPE.
    // A narrowing must never shrink what the storage can hold, and BOTH kinds leaked
    // into this question. An earlier assignment narrowing made `let xs: S[] | null`
    // / `xs = [{n:1}]` / `xs = null` reject the third line as "cannot assign null to
    // {n: i32}[]", and a function declared after the narrowing could not assign null
    // to the global either. A GUARD narrowing did the same to the write inside the
    // guard, in both spellings — `while q != null { … q = null }` rejected "cannot
    // assign null to i32" and `if o.v != null { … o.v = null }` rejected "cannot
    // assign null to string" — which killed the natural way to walk a nullable chain
    // to exhaustion. Neither reject was a soundness rule: the storage admits null,
    // the same write outside the guard is accepted, and the fix is to accept the
    // write and RETIRE the narrowing (`retireNarrowingsForWrite`, below).
    // `writeStorageTy` is -1 for every place no narrowing overlays, which is every
    // place on master, so this is exactly the set of writes a narrowing shrank.
    //
    // GATED ON A NULL-BEARING RIGHT-HAND SIDE, and the gate is not cosmetic. The
    // narrowed type is `nonNullTy(storage)`, so the ONLY writes it refuses that the
    // storage allows are the ones carrying null — and gating on that keeps every
    // assignment that type-checks today on its EXACT current path, including
    // whatever contextual coercion `assignableExpr` performs against the target
    // (an object literal coerces field-wise, a bare lambda infers its params). The
    // un-gated form — always ask the storage — is strictly wider, still accepts
    // everything, and MOVED CODEGEN: it re-compiled the compiler's own frozen
    // source 12 bytes smaller. Same verdicts, different coercions; the fixpoint is
    // what noticed. An `is T` variant pin is left alone by the same gate: the write
    // that FLIPS a variant carries no null, and rejecting it is how a loop over a
    // union terminates (see `checkWhileStmtNode`).
    //
    // `lt` ITSELF STAYS THE FLOW TYPE. It is what `seedExpected` contextually types
    // the right-hand side with and what `nodeTyIxOf` hands the emitter for the
    // target node, so re-pointing it at the storage would move the emitted store
    // rep for programs that already compile.
    let asgLt = lt
    let asgBarred = false
    const rtN = T.tys[rt]
    let rhsNullBearing = isNullTy(rt)
    if rtN is TyNullable { rhsNullBearing = true }
    if rhsNullBearing {
      const asgDcl = writeStorageTy(n.binLeft)
      if asgDcl >= 0 {
        asgLt = asgDcl
      } else {
        asgBarred = writeBarredByLoop(n.binLeft)
      }
    }
    const asgOk = assignableExpr(n.binRight, rt, asgLt)
    if !asgOk {
      if asgBarred {
        writeBarredErr(placeKeyOf(n.binLeft), ix)
      } else {
        tErr("cannot assign " + tyToStr(rt) + " to " + tyToStr(asgLt), ix)
      }
    }
    // A-infer-null: a nullable binding's open inner HOLE (`let x = null`)
    // fills from the first non-null assignment (in place, so the binding
    // becomes `T | null` everywhere); and a straight-line non-null `x = e`
    // narrows `x` for the REST of the enclosing block (host
    // `assignmentNarrowing` — an assignment inside a branch unwinds with the
    // branch's scope, so it never leaks past the join).
    const asgTgt = P.nodes[n.binLeft]
    if asgTgt is Ident {
      const asgCur = lookup(asgTgt.identName)
      if asgCur >= 0 {
        const rtT = T.tys[rt]
        let rhsNullable = false
        if rtT is TyNullable { rhsNullable = true }
        const rhsNonNull = !rhsNullable && !isNullTy(rt) && rt >= 0
        const asgCt = T.tys[asgCur]
        if asgCt is TyNullable {
          if rhsNonNull {
            if asgCt.nInner < 0 {
              asgCt.nInner = rt
              tyMutEpoch = tyMutEpoch + 1 // nullable inner pinned in place
            }
            // Bank the DECLARED type before shadowing it. The narrowing itself is
            // unchanged — reads still see the non-null type, which is what the
            // `let x: T | null = null` / `x = mk()` / `x.f` pattern rides.
            noteNarShadow(asgTgt.identName, asgCur, NAR_KIND_ASG)
            declare(asgTgt.identName, nonNullTy(asgCur))
          }
        }
      }
    }
    // THE NARROWING IS A PATH FACT, AND A FALSIFYING WRITE ENDS THE PATH. One driver
    // retires both kinds of bare-name narrowing and the property-path overlay, so the
    // write side cannot disagree with itself across the three spellings. Only an
    // ACCEPTED write retires anything: a rejected one did not happen, and letting it
    // retire would cascade a second diagnostic onto every read after it.
    if asgOk { retireNarrowingsForWrite(n.binLeft, rt, ix) }
    // Assignment is an expression yielding its RIGHT-HAND SIDE (host parity;
    // DECISIONS: assignment-as-expression).
    return rt
  }
  // Nullish coalescing: `a ?? d` — the result is `a`'s NON-NULL part unioned
  // with `d`'s type (host `NullCoalesce`: `a ?? b` with a nullable `b` stays
  // nullable; a non-null default collapses to the inner type). A non-nullable
  // LHS just yields itself.
  //
  // `??` coalesces whenever the LHS evaluates to null — a STORED null in a
  // nullable-valued map read (`m[k]` over `{[string]: V | null}` is a DOUBLE
  // nullable `(V | null) | null`) is null just like a missing key, so peel the
  // FULL nullability of the merged read type (`nonNullTy` collapses nested
  // nullables), not one layer. A non-null default then types the whole `??`
  // NON-NULL (universal operator contract; USER SEMANTICS RULING 2026-07-23).
  if op == "??" {
    const lt2 = T.tys[lt]
    if lt2 is TyNullable {
      const innerFull = nonNullTy(lt)
      // A LITERAL default re-encodes at an inner `f32`, so keep the result f32 — else
      // `joinTys` widens `f32 + f64` (or `f32 + i32`) and a downstream `f32` slot rejects
      // the demote.
      if primNameOf(innerFull) == "f32" && isF32AdoptingLitExpr(n.binRight) {
        return innerFull
      }
      // A literal-union inner with a MEMBER-LITERAL default stays the union (`m[k] ?? "aa"`
      // over a `{[string]: K}` map is a `K`, an i32 atom) — else the bare literal types
      // `string` and `joinTys` widens the whole result to `string`, divorcing the checked
      // type from the atom rep the read produces.
      if isLitBearing(innerFull) {
        const dl = litTyOfExpr(n.binRight)
        if dl >= 0 {
          if assignable(dl, innerFull) { return innerFull }
        }
        // An ATOM-VALUED MAP get's default must itself be an atom — a member literal
        // (accepted above) or a value of the same literal union. The fused read's rep is
        // the bare i32 atom id, so a `string`-typed default (or a NON-member literal,
        // which would mint a fresh id) cannot lower: type-valid (`joinTys` widens to
        // `string`) but unbuildable — the emitter-capability channel.
        //
        // The receiver comes from the ONE fused-read shape home (`fusedMapReadRecvIx`), so
        // the METHOD spelling `m.get(k) ?? d` — which `emitCoalesce` lowers through the very
        // same `emitMapGetOr` — is rejected HERE too. It used to fall past this `is Index`
        // gate and reach the emitter's own copy of the rule as a LATE `emitProgram:` error.
        const mgRecv = fusedMapReadRecvIx(n.binLeft)
        if mgRecv >= 0 {
          if nodeTyMapValIsLitUnion(mgRecv) {
            if !assignable(rt, innerFull) {
              tErrUnsupported(
                "`??` over an atom-valued map needs a member-literal (or atom) default",
                ix,
              )
            }
          }
        }
      }
      // When the DEFAULT fits the non-null LHS type (with contextual coercion — an inline
      // object literal `{f: "aa"}` field-wise coerces to a `{f: K}` litunion field, #851),
      // the `??` result IS that LHS type — NOT the `joinTys` LUB, which WIDENS a litunion
      // struct field (`{f: K}`) to `string` when the default's field types bare `string`.
      // That widening divorced the checked type from the i32-atom rep the map-value struct
      // field read produces: `print((m[k] ?? {f:"aa"}).f)` rendered the RAW ATOM ID (the
      // read's node type carried no litunion members to widen). The variable-default spelling
      // (`m[k] ?? d`, `d: {f: K}`) already returned the union — `joinTys` of two identical
      // types — so only the inline-literal default was wrong; this extends the same result to
      // it. `assignableExpr` (not `assignable`) so the object literal coerces field-wise.
      if assignableExpr(n.binRight, rt, innerFull) { return innerFull }
      return joinTys(innerFull, rt)
    }
    return lt
  }
  // Equality: result bool; requires mutual compatibility.
  if op == "==" || op == "!=" {
    // A NULL TEST ASKS ABOUT THE STORAGE, AND AN ASSIGNMENT NARROWING DOES NOT
    // CHANGE THE STORAGE. `let xs: S[] | null = []` / `xs = [{n:1}]` /
    // `if xs != null { … }` rejected the guard with "cannot compare {n: i32}[]
    // with null": the narrowing had made `xs`'s flow type non-nullable, and a null
    // test against a non-nullable type is a hard error here — deliberately, because
    // a guard that can never be false is a bug worth naming. The rule is right and
    // its INPUT was wrong. The declared type still admits null, the emitter's slot
    // still holds a nullable rep, and a later `xs = null` (accepted again, above)
    // makes the test genuinely two-valued, so the guard is meaningful and the
    // narrowed and guarded spellings stop being mutually exclusive.
    //
    // Deliberately NOT "a null test on any non-nullable is fine": `let xs: S[] = []`
    // / `xs != null` stays the error it is, because nothing about THAT binding can
    // ever be null. `asgDeclaredTy` is the exact difference between the two, and it
    // is -1 for every binding no assignment narrowed.
    if isNullTy(lt) || isNullTy(rt) {
      if isAsgNarrowedName(n.binLeft) || isAsgNarrowedName(n.binRight) {
        return TY_BOOL
      }
    }
    // CLOSED SET (literal unions): comparing a literal-union place against a
    // literal OUTSIDE its set can never be true — reject rather than compile
    // an always-false test (host: discrimination is total over the union;
    // `literal-union-reject-compare`). Only fires when one side's TYPE
    // carries literal members and the OTHER side is a bare literal.
    if isLitBearing(lt) {
      const eqR = litTyOfExpr(n.binRight)
      if eqR >= 0 {
        if !assignable(eqR, lt) {
          tErr(
            "cannot compare " +
              tyToStr(lt) +
              " with " +
              tyToStr(eqR) +
              " — not a member of the union",
            ix,
          )
        }
        // A MEMBER compare is always a valid discrimination (`v == 7` over
        // `"x" | 7` — the mixed union's softened sides aren't mutually
        // assignable, so it must not fall through to the general rule).
        return TY_BOOL
      }
    } else if isLitBearing(rt) {
      const eqL = litTyOfExpr(n.binLeft)
      if eqL >= 0 {
        if !assignable(eqL, rt) {
          tErr(
            "cannot compare " +
              tyToStr(eqL) +
              " with " +
              tyToStr(rt) +
              " — not a member of the union",
            ix,
          )
        }
        return TY_BOOL
      }
    }
    // A NOMINAL NEWTYPE compared with a LITERAL is compatible (`id == 0`) — the
    // literal adopts the brand, as it does in every other position. Both directions
    // of `assignable` fail on a brand/base pair, so without this the sentinel test
    // would be the one shape a newtype makes unwritable. The MIXING reject for two
    // genuine values already fired above, before the equality arms.
    const nomEqLit = nomNameOfTy(lt) != nomNameOfTy(rt) &&
      !nomBinMixes(lt, rt, n.binLeft, n.binRight)
    if !assignable(lt, rt) && !assignable(rt, lt) && !nomEqLit {
      tErr("cannot compare " + tyToStr(lt) + " with " + tyToStr(rt), ix)
    } else {
      // SOUNDNESS: a STRUCTURAL `==`/`!=` on a plain object (or array) defaults
      // to field-by-field equality, which is sound only when every field is
      // itself value-comparable. A non-discriminated union/nullable/map field is
      // not — so reject the default structural compare and ask for an explicit
      // `==`. (Unions/nullables compared DIRECTLY — value-union equality, `==
      // null` nullness tests — never reach here: only an object/array operand is
      // tested, matching the host's anonymous-object structural fallback.)
      const lT = T.tys[lt]
      let structural = false
      if lT is TyObj { structural = true }
      else if lT is TyArray { structural = true }
      if structural {
        const seen: i32[] = []
        if !isEquatable(lt, seen) {
          tErr(
            tyToStr(lt) +
              " isn't equatable (a field is not value-comparable) — define a `==` operator for it",
            ix,
          )
        }
      }
    }
    // THE EMITTER-CAPABILITY GATE, off the ONE comparability home (`eqCmpKindOfTy`). A rep
    // with no compare core must not pass `vl check`: every one of them was check-clean
    // INVALID WASM, because the emitter's `==` ladder has no arm for it and falls through to
    // the i32 tail, which emits `i32.eq` over two refs. A null TEST is exempt — it is not a
    // value compare and `emitNulIsNullTest` owns it for every rep.
    if !isNullTy(lt) && !isNullTy(rt) {
      const eqLk = eqCmpKindOfTy(lt)
      const eqRk = eqCmpKindOfTy(rt)
      if eqLk == "none" || eqRk == "none" {
        let eqBad = lt
        if eqLk != "none" { eqBad = rt }
        tErrUnsupported(
          "`" + op + "` over " + tyToStr(eqBad) + " has no lowering",
          ix,
        )
      }
    }
    return TY_BOOL
  }
  // OPERATOR DISPATCH on a user object (B13 + B14): `a op b` with a STRUCT
  // left operand resolves through a free `self`-function named for the
  // operator (host parser dispatch — checked FIRST, host order), else
  // through an operator closure FIELD (`"*": function(s) …` — host
  // `opFunc`). Equality/logicals/`=`/`??` returned above, so only the
  // arithmetic/comparison operators reach here.
  if op != "&&" && op != "||" {
    const odsp = T.tys[lt]
    if odsp is TyObj {
      const osf = opSelfFnTy(op, lt, rt, n.binRight, ix)
      if osf >= 0 { return osf }
      const ofld = objFieldType(odsp, op)
      if ofld >= 0 {
        const oft = T.tys[ofld]
        if oft is TyFunc {
          if oft.fnParamTypes.length == 1 {
            if !assignableExpr(n.binRight, rt, oft.fnParamTypes[0]) {
              tErr(
                "operator '" +
                  op +
                  "': expected " +
                  tyToStr(oft.fnParamTypes[0]) +
                  ", got " +
                  tyToStr(rt),
                ix,
              )
            }
            return oft.fnRet
          }
        }
      }
    }
  }
  // Ordering comparison: result bool; requires matching numeric types. A
  // literal / literal-union operand is its base scalar here (`n < 2` over
  // `0 | 1 | 2` compares as i32 — host: a numeric-literal union softens).
  if op == "<" || op == ">" || op == "<=" || op == ">=" {
    const olt = softenLitTy(lt)
    const ort = softenLitTy(rt)
    // String ordering: a lexicographic compare of two strings yields a bool.
    if isStringTy(olt) && isStringTy(ort) { return TY_BOOL }
    // One CONCRETE string against a HOLE is an ordering whose form the body cannot yet
    // decide — the string reading is live, so DEFER rather than force the numeric one.
    // `noteBinCstr` has already recorded the constraint, and `validateBinCstrs` adjudicates
    // it at each call site through `binOpDefinedFor`, whose ordering rule admits exactly
    // `string`/`string` and numeric/numeric — so every non-string binding of the hole is
    // still rejected, at the call that pins it. This is the ordering twin of the deferral
    // `+` already makes for `s + h`: without it a HALF-annotated spelling is unwritable
    // while both its bare and its fully-annotated twins accept, so adding an annotation
    // would remove a capability.
    if isStringTy(olt) && tyIsHole(ort) { return TY_BOOL }
    if tyIsHole(olt) && isStringTy(ort) { return TY_BOOL }
    // A hole operand reaching a numeric comparison is USED numerically — record the demand.
    if !isNumeric(olt) || !isNumeric(ort) {
      tErr(
        "comparison expects numeric operands, got " +
          tyToStr(olt) +
          " and " +
          tyToStr(ort),
        ix,
      )
    } else if (
      !sameNumeric(olt, ort) &&
      !mixesNumeric(olt, ort) &&
      !cmpF32LitAdopts(n, olt, ort)
    ) {
      // Mixed numerics may be compared when one side widens to the other
      // (i32/i64, i32/f64, f32/f64, …); the narrower side widens. Other mixes error.
      // The f32-with-a-LITERAL pair is admitted by `cmpF32LitAdopts` instead — the
      // comparison twin of the arithmetic arm in `binOpType`, so `fv > 1` and `fv + 1`
      // agree about which operands an f32 accepts (they did not: arithmetic took the
      // literal and the comparison rejected it).
      tErr("comparison mixes " + tyToStr(olt) + " and " + tyToStr(ort), ix)
    }
    return TY_BOOL
  }
  // `+` also concatenates strings.
  if op == "+" {
    // String concat requires an operand that ACTUALLY is a string. A hole (un-annotated
    // param) is permissively `assignable` to string, so the bare `assignable(_, STR)` test
    // collapsed `a + b` over two holes to `string` — wrong: that op is instantiation-dependent
    // (i32+i32→i32, f64→f64, string→string) and must DEFER its result to the operand hole
    // (resolved per call site through `substTyDeep`, so `const x: i32 = add(3, 4)` types and
    // `const x: string = add(3, 4)` is rejected). A hole paired with a REAL string (`s + "!"`)
    // still concatenates. With one concrete-string operand present, fall back to the
    // assignability test (so the other side may be a hole that pins to string).
    if isStringTy(lt) || isStringTy(rt) {
      if assignable(lt, TY_STR) && assignable(rt, TY_STR) { return TY_STR }
      // A `new string` NEWTYPE concatenates — with a same-brand value or with a
      // string LITERAL — and the result KEEPS the brand, which is the string form
      // of the rule the arithmetic tail follows. `nomBinMixes` has already rejected
      // a genuine mix above, so reaching here means the brands agree or the other
      // side is a literal. Without this arm a `new string` would be the one newtype
      // whose values could not be joined at all: `as` is numeric-only, so there is
      // no unwrap to fall back on.
      if nomNameOfTy(lt) != "" || nomNameOfTy(rt) != "" {
        if assignable(nomBaseTyIx(lt), TY_STR) {
          if assignable(nomBaseTyIx(rt), TY_STR) {
            if nomNameOfTy(lt) != "" { return lt }
            return rt
          }
        }
      }
    }
    // List concat `a + b` → a new `T[]` (collections-design §VL.4); the two
    // element types must agree (an empty `[]` adopts the other side's).
    const lta = T.tys[lt]
    if lta is TyArray {
      const rta = T.tys[rt]
      if rta is TyArray {
        constrainEmpty(rt, lt)
        constrainEmpty(lt, rt)
        if assignable(rt, lt) { return lt }
        if assignable(lt, rt) { return rt }
        tErr("cannot concat " + tyToStr(lt) + " and " + tyToStr(rt), ix)
        return TY_ERR
      }
    }
  }
  // Remaining arithmetic: numeric-only, both the SAME numeric type (no implicit
  // i32 ↔ f64). A literal / all-literal-union operand SOFTENS to its base
  // scalar first (host: `n + 10` over `1 | 2 | 3` computes — and yields — a
  // plain i32; the union constrains assignment, not arithmetic).
  lt = softenLitTy(lt)
  rt = softenLitTy(rt)
  // A hole operand reaching arithmetic is USED numerically — record the demand so the call-arg
  // check enforces a numeric (or operator-overloaded) argument (`isNumeric(TyVar)` passes below).
  if !isNumeric(lt) || !isNumeric(rt) {
    // Reached only AFTER string-concat and array-concat are ruled out above, so
    // this is a genuine operand-type mismatch — `+` does have string/array forms,
    // so don't claim it is "numeric-only"; just report no form fits these types.
    tErr(
      "operator '" +
        op +
        "' is not defined for " +
        tyToStr(lt) +
        " and " +
        tyToStr(rt),
      ix,
    )
    return TY_ERR
  }
  // BITWISE / SHIFT / REMAINDER are INTEGER-ONLY: a float operand (i32↔f64 mixing or
  // even same-type f64) has no form for any of these. Reject before the numeric-widening
  // rules so `1.0 & 2` and `5.5 % 2.0` error (the float-widening lattice must not make
  // them pass). Arithmetic (`+ - * /`) and comparisons are unaffected.
  //
  // `%` is here for a DIFFERENT reason than the bitwise ops, and the difference is the
  // whole rationale. Float remainder is a meaningful operation — it is just one wasm has
  // no instruction for, and the one-line `a - trunc(a / b) * b` identity is NOT it: against
  // C/Rust `fmod` that identity disagrees on ~43% of random operand pairs, on every
  // `|a / b|` past 2^53 (`1e17 % 3` → 0, not 1), on a `-0.0` dividend, on an infinite
  // divisor (NaN, not the dividend), and it overflows to `-inf` at `f64::MAX`. Accepting
  // `%` on floats via that identity would trade a LOUD reject for silent numeric
  // corruption, which is strictly worse. Exact float remainder needs a scaled
  // shift-and-subtract helper, and when it lands it belongs where every other float
  // operation with no operator spelling already lives — a float intrinsic, beside
  // `sqrt`/`trunc`/`copysign`. Until then this rejects, which stays correct either way.
  if (
    op == "&" ||
    op == "|" ||
    op == "^" ||
    op == "<<" ||
    op == ">>" ||
    op == ">>>" ||
    op == "%"
  ) {
    if (
      primNameOf(lt) == "f64" ||
      primNameOf(lt) == "f32" ||
      primNameOf(rt) == "f64" ||
      primNameOf(rt) == "f32"
    ) {
      tErr(
        "operator '" +
          op +
          "' is integer-only, got " +
          tyToStr(lt) +
          " and " +
          tyToStr(rt),
        ix,
      )
      return TY_ERR
    }
  }
  // A LITERAL operand adopts the OTHER side's f32 type (the literal re-encodes exactly at
  // f32, so `x + 4.0` with `x: f32` stays f32 — the `4.0` is NOT demoted f64, and `x + 1`
  // stays f32 rather than being the `mixes f32 and i32` error it is without this). Checked
  // before the general mixed rule so the result is f32, not the wider f64. This RETYPES THE
  // LITERAL and does not touch the mixed-arithmetic lattice underneath: `mixesNumeric` /
  // `widerNumeric` / `binMixHardF64` still see exactly the pairs they saw before, because
  // the only pairs this arm intercepts (f32 with a LITERAL other side) were an f32-typed
  // result already (float literal) or a hard error (integer literal).
  if primNameOf(lt) == "f32" && isF32AdoptingLitExpr(n.binRight) { return lt }
  if primNameOf(rt) == "f32" && isF32AdoptingLitExpr(n.binLeft) { return rt }
  // A mixed-numeric op widens the narrower operand to the wider one and yields the
  // wider type (`i32 op i64`→i64, `f64 op i32`→f64, `f32 op f64`→f64, …). Done BEFORE
  // the same-type check so a compatible mixed pair is accepted (B2). i32-only programs
  // never reach here (they are `sameNumeric` and fall through to `return lt`).
  if mixesNumeric(lt, rt) { return widerNumeric(lt, rt) }
  if !sameNumeric(lt, rt) {
    tErr(
      "operator '" + op + "' mixes " + tyToStr(lt) + " and " + tyToStr(rt),
      ix,
    )
    return TY_ERR
  }
  return lt
}
// ── let declaration ────────────────────────────────────────────────────────

// Extracted from `checkNodeReal`'s `LetDecl` arm (C3: thin the dispatcher).
function checkLetDeclNode(n: LetDecl, ix: i32) {
  // Resolve the annotation (if any) by reading the TypeRef child INLINE.
  let annot = -1
  if n.letType >= 0 {
    const tn = P.nodes[n.letType]
    if tn is TypeRef {
      annot = nameToTyAt(tn.tyName, n.letType)
      if annot < 0 {
        // A map shape whose KEY is neither `string` nor `i32` (`{[boolean]: V}`,
        // `{[f64]: V}`) has no hash in the map rep — report that directly (with the
        // supported set) instead of a bare "unknown type", naming the constructor in
        // play. An emitter/runtime-capability rejection, not a type error — the
        // unsupported-lowering channel.
        // A SUPPORTED key with an unresolvable VALUE (`{[string]: nope}`) is not a
        // key problem — it keeps the bare "unknown type", so this arm asks the key
        // gate itself rather than "is there a key text at all".
        //
        // D-MAPKEYDIAG: the key TEXT comes from the PARSER'S SPELLING TREE — the very
        // `IDENT` lexeme the parser read — instead of being sliced back out of the
        // name the parser built from it (`mapSpellKeyName`, this checker's last call
        // into a rendered-type re-parse). `tsMapKeyNodeOf` is that cut's gate read
        // structurally; see its header for why the LEFT-SPINE descent is exactly the
        // `{[`-prefix test, character for character.
        //
        // THE KEY PROBE IS `tsLeafTy`, THE LEAF RUNG `tsToTyReal`'S OWN MAP ARM ASKS.
        // It resolves the same VALUE `nameToTy` does for every possible key — a key is
        // a bare `IDENT`, so `nameToTy`'s composite arms all decline and it runs
        // `primTyOfName` → `tpEnvTyOfName` → `declaredTyOfName`, which IS `tsLeafTy` —
        // and it differs in the SIDE EFFECT that matters here: `nameToTy` re-enters the
        // `unkTyPart` bank at depth 1 and CLEARS it. That clear is what made the `else`
        // arm below print the whole-annotation form for a map whose VALUE is the
        // unresolved part (`unknown type '{[string]:nope}'`) where the `nope[]` /
        // `nope | i32` / `{v: nope}` siblings all print the component form
        // (`unknown type 'nope' within '…'`) — a diagnostic that named the spelling
        // the user already typed instead of the leaf they must fix. #1290 filed that
        // inconsistency rather than smuggling it into a byte-identity refactor; this
        // is the fix, and it is a probe that no longer perturbs a diagnostic bank it
        // has no business touching, not a rewording.
        const mapKeyIx = tsMapKeyNodeOf(annTsOf(n.letType))
        let badKey = ""
        if mapKeyIx >= 0 { badKey = tsText[mapKeyIx] }
        if badKey != "" && !mapKeyTySupported(tsLeafTy(badKey)) {
          mapKeyUnsupportedErr(badKey, initMapCtorName(n.letInit), n.letType)
        } else {
          tErr(unknownTyText(tn.tyName), n.letType)
        }
        annot = TY_ERR
      }
      // Record the resolved type on the `let`'s TYPE-ANNOTATION node so the emitter can
      // classify it structurally from the `Ty` arena rather than re-parsing `tyNameOf` — C1.
      if !inferQuiet && annot >= 0 {
        if n.letType < nodeTyIx.length { nodeTyIx[n.letType] = annot }
      }
    }
  }
  let initTy = -1
  // Bidirectional: a `const f: (i32) => i32 = (x) => …` (or a composite of such — an
  // annotated array/object of lambdas) infers each un-annotated lambda param from the
  // annotation BEFORE the initializer is checked.
  if n.letInit >= 0 && annot >= 0 { seedExpected(n.letInit, annot) }
  // An UN-annotated binding to a bare lambda (`const add = (a, b) => …`): mark the lambda so its
  // un-annotated params type as inference holes (a value-flow-monomorphized generic function)
  // rather than being rejected as uninferable. Annotated bindings seed a concrete type above.
  if annot < 0 && n.letInit >= 0 {
    const liN = P.nodes[n.letInit]
    if liN is FuncDecl {
      if liN.fnName == "" { noteValBindLambda(n.letInit) }
    }
  }
  // The if-EXPRESSION initializer position, marked for `checkIfStmtNode`'s else-less
  // widening (see its tail). A scalar written on the way IN and restored on the way OUT —
  // never carried between statements, let alone between programs — and it names ONE node,
  // so a nested `if` inside the initializer is unaffected.
  const savedLetInitIf = letInitIfIx
  letInitIfIx = ifExprNodeOf(n.letInit)
  if n.letInit >= 0 { initTy = checkNode(n.letInit) }
  letInitIfIx = savedLetInitIf
  // A `void` initializer (`const x = f()` over a void function) has NO value to bind.
  // The assignment path (`x = f()`) already rejects it; the BINDING path did not — an
  // un-annotated binding had no assignability check, and `assignableExpr(void, T)` is
  // lenient — so a void binding slipped past `vl check` and CRASHED codegen. Reject it
  // here with a clear, source-located message, poisoning `initTy` to suppress cascades.
  // EXCEPT an if-EXPRESSION init (`const x = if c then 5`), the provisional-void form
  // `voidSlotExemptExpr` names: a statement-if is context-free `void`, but the if-binding
  // inference below resolves it to `T | null` (the else-less false path is the implicit
  // `null`) — that path owns it. The exemption lives in that one predicate, shared with
  // `voidValueSlotErr`'s slots; the MESSAGE stays this position's own, because it can name
  // the binding the author wrote.
  if n.letInit >= 0 && isVoidTy(initTy) {
    if !voidSlotExemptExpr(n.letInit) {
      tErr(
        "cannot bind the void result of '" +
          n.letName +
          "' — a void function returns no value",
        ix,
      )
      initTy = TY_ERR
    }
  }
  // Redundant explicit annotation: the initializer's CONTEXT-FREE type (checked
  // just above, before the annotation is consulted) already IS the annotation, so
  // `: T` adds nothing. Recorded BEFORE `constrainEmpty` runs, so an empty-
  // collection hole the annotation legitimately pins is naturally excluded.
  if annot >= 0 && initTy >= 0 && n.letInit >= 0 {
    recordRedundantAnnot(n, ix, initTy, annot)
  }
  let bound = TY_ERR
  if annot >= 0 {
    bound = annot
    if initTy >= 0 {
      // An annotated assignment of an empty-collection initializer pins the
      // SOURCE binding's open holes from the annotation (`const ys: i32[] = zs`
      // resolves `zs`'s element) — clearing its uninferred floor in place.
      constrainEmpty(initTy, annot)
      // A `never`-typed annotation (a degenerate/empty-intersection alias) was
      // ALREADY reported at its declaration; don't also cascade a "cannot assign
      // … of type <empty>" at every use site.
      const neverAnnot = isNeverTy(annot)
      if !neverAnnot && !assignableExpr(n.letInit, initTy, annot) {
        // An object literal (`{}` / `{x: 1}`) assigned to a map type is a
        // category error, not a width mismatch — point at the fix (`Map()`)
        // rather than the opaque "cannot assign {} to … of type {[string]: …}".
        const annT = T.tys[annot]
        const initN = P.nodes[n.letInit]
        let objToMap = false
        if annT is TyMap {
          if initN is ObjLit { objToMap = true }
        }
        if objToMap {
          tErr(
            "An object literal isn't a map value — construct a map with " +
              "`Map()` (or a set with `Set()`), e.g. `let m: {[string]: i32} = Map()`",
            ix,
          )
        } else if isNumeric(initTy) && isNumeric(annot) {
          // Both sides numeric but not assignable ⇒ a lossy/narrowing edge the
          // lossless-only implicit-widening rule (#298) won't take silently.
          // Explain the lossiness rather than the opaque "cannot assign i32 to f32".
          tErr(
            tyToStr(initTy) +
              " doesn't fit in " +
              tyToStr(annot) +
              " — the conversion is lossy and must be made explicit with `as` " +
              "(write `x as " +
              tyToStr(annot) +
              "`)",
            ix,
          )
        } else {
          tErr(
            "cannot assign " +
              tyToStr(initTy) +
              " to '" +
              n.letName +
              "' of type " +
              tyToStr(annot),
            ix,
          )
        }
      }
      // A `Set()` initializer keeps its SET flavor even under a map-shaped
      // annotation (`let s: {[string]: boolean} = Set()`): the binding exposes
      // the Set surface (`.add`, no `.set`/`.get`/`.keys`), with the
      // annotation's key/value types.
      const it2 = T.tys[initTy]
      if it2 is TyMap {
        if it2.mSet == 1 {
          const an2 = T.tys[annot]
          if an2 is TyMap { bound = mkMapTy(an2.mKey, an2.mVal, 1) }
        }
      }
    }
  } else if initTy >= 0 {
    bound = initTy
    // USAGE-DRIVEN NULLABLE HOLE (A-infer-null): an un-annotated `let x =
    // null` is NOT pinned to the exact `null` type — `null` is hole-bearing
    // (it inhabits every `T | null`). Bind a nullable with an OPEN inner
    // hole; the first non-null assignment fills `T` in place (see the `=`
    // arm), so `x` becomes `T | null`. A COMPLETE initializer still pins.
    if isNullTy(initTy) { bound = mkNullableTy(-1) }
    // UN-INFERRED EMPTY-COLLECTION FLOOR: an un-annotated `[]` / `Map()` / `Set()`
    // whose hole is still open here may yet be pinned by a downstream
    // `.push`/`.set`/`.add` (those mutate the shared arena entry in place), so we
    // can't decide now. Record it for the scope-close re-check; if the hole stays
    // open it is genuinely uninferable and `flushUninferred` reports it.
    if unresolvedHole(bound) { notePending(n.letName, bound, ix) }
    // Export an un-annotated IF-EXPRESSION binding's INFERRED value-union type (by
    // node index) for the emitter, so it lowers like an annotated nullable/value-union
    // binding even when an arm is one the emitter can't statically classify (an ident
    // `if c then v else null`). Niches/non-unions render "" and are skipped — the
    // emitter's existing paths handle those. Mirrors the inferred-RETURN export.
    //
    // GATED to an if-expression init: the emitter's SOLE consumer is `nliInferIfLet`
    // (if-expr bindings), and `valueUnionRetName` renders the bound type via `tyToStr`
    // — cheap for a small union, but ruinous on the huge AST-node union that every
    // `const e = P.nodes[i]` binds. Restricting to if-expr inits keeps the render off
    // that hot path (the cause of the #494 ~4× self-compile regression).
    let initIf = n.letInit
    if initIf >= 0 {
      const ini0 = P.nodes[initIf]
      if ini0 is Paren { initIf = ini0.parInner }
    }
    let isIfInit = false
    if initIf >= 0 {
      const ini1 = P.nodes[initIf]
      if ini1 is IfStmt { isIfInit = true }
    }
    if isIfInit {
      const lvn = valueUnionRetName(bound)
      if lvn != "" {
        inferLetIx.push(ix)
        inferLetTy.push(lvn)
      } else if isNulStringTy(bound) {
        // `string | null` is a NICHE (not a value-union box) so `valueUnionRetName`
        // renders "" — record it separately for the kind-16 slot classification.
        inferLetNulStrIx.push(ix)
      } else if isNulBoolTy(bound) {
        // `boolean | null` is the OTHER niche (the i32 sentinel-2 rep) — same story,
        // recorded for the niche slot classification (`isInferLetNulBool`).
        inferLetNulBoolIx.push(ix)
      }
    }
  } else {
    tErr("'" + n.letName + "' needs a type annotation or initializer", ix)
  }
  // Same-scope redeclaration (B16): a second `let`/`const` of a name already
  // bound in the INNERMOST scope frame is an error — `let a = 1; let a = 2` in
  // one block silently overwrites otherwise. Only the same frame is rejected;
  // shadowing a name from an OUTER scope in a nested block is legal (the scope
  // chain is innermost-wins), so we check `T.scopes[top].has` — the current
  // frame only — not the full `lookup` chain.
  const dtop = T.scopes.length - 1
  // A module global is pre-declared by the pass-1.5 hoist, so its own pass-2
  // declaration would falsely trip the same-frame redeclare check — skip it there
  // (genuine top-level dups are caught in the hoist). Nested `let`s are unaffected.
  const preHoisted = dtop == 0 && (moduleGlobals[n.letName] ?? false)
  if !preHoisted && T.scopes[dtop].has(n.letName) {
    tErr("redeclared " + n.letName, ix)
  }
  // The same reservation the `function` path enforces: `const __load_i32__ = (x: i32) => 7`
  // is called through the emitter's inline arm exactly like the `function` spelling, so the
  // lambda never runs. A PARAMETER of that name is untouched — it is never a callee.
  checkNotEmitterIntrinsic(n.letName, ix)
  declare(n.letName, bound)
  if symEnabled != 0 { symDecl(n.letName, ix, bound, 0) }
  if n.letKw == "const" {
    const ctop = constScopes.length - 1
    if ctop >= 0 { constScopes[ctop][n.letName] = true }
  }
  // Definite-assignment: an uninitialized `let x` / `let x: T` (no initializer)
  // starts UNASSIGNED; a later read before it is written is an error. An
  // initialized `let x = …` (and every `const`, which must have a value) is
  // assigned from the start, so it is never tracked. A re-declaration that
  // shadows clears any prior assigned/unassigned record under that name.
  daMarkAssigned(n.letName)
  if n.letInit < 0 { daAdd(n.letName) }
  return TY_VOID
}
// ── match ──────────────────────────────────────────────────────────────────

// Mark the union members that arm pattern type `pt` covers, in the `covered` flag column
// parallel to `uMems`. Returns 1 when it covered at least one NEW member, -1 when every member
// it names was already covered (a redundant arm), 0 when it names no member of the union at all.
//
// Coverage is decided by ARENA TYPE, through `sameVariantTy` — the same judgement `nameToTy`
// itself used to dedup the union's members, and the same one `is` narrowing uses. It is
// therefore STRUCTURAL, not nominal: `type C = {c: i32}` and `type C2 = {c: i32}` are ONE
// member and ONE arm, because the arena resolves them to one entry and no runtime test could
// tell them apart either.
function markUnionCover(uMems: i32[], covered: i32[], pt: i32) {
  let found = 0
  let fresh = 0
  let j = 0
  while j < uMems.length {
    if sameVariantTy(uMems[j], pt) {
      found = found + 1
      if covered[j] == 0 {
        covered[j] = 1
        fresh = fresh + 1
      }
    }
    j = j + 1
  }
  if found == 0 { return 0 }
  if fresh == 0 { return -1 }
  1
}

// True if arm pattern type `pt` is a COMPOSITE — a union or a nullable — rather than one
// variant. An arm tests its type with a single `is`, and `x is A | B` / `x is A | null` is a
// shape the emitter does not lower (`emitProgram: \`is\` names a type that is not a union
// variant` — the same on master), so a pattern that resolves to one is rejected AT the pattern
// with the spelling that does work, rather than type-checked into a codegen failure.
function tyIsCompositePat(pt: i32) {
  const t = T.tys[pt]
  if t is TyUnion { return true }
  if t is TyNullable { return true }
  false
}

// True if any variant in `mems` is a LITERAL type. An arm tests its member with `is`, and
// `x is 0` / `x is "a"` over a VALUE union does not lower (`emitProgram: literal \`is\` over a
// struct union is not supported`, on master too), so such a union has no arm spelling that
// works — the whole scrutinee is refused, with the shape that does work named.
function unionHasLitMember(mems: i32[]) {
  let i = 0
  while i < mems.length {
    const t = T.tys[mems[i]]
    if t is TyLit { return true }
    i = i + 1
  }
  false
}

// Why a scrutinee is refused, named for the type it actually is. A `match` needs a closed
// member SET to be complete over, and every member must have an arm spelling that lowers.
function matchScrutRejectMsg(st: i32, mems: i32[]) {
  if unionHasLitMember(mems) {
    return "match over a union with literal members is not supported — compare them with `==` in an if-chain, got " +
      tyToStr(st)
  }
  "match scrutinee must be a union, got " + tyToStr(st)
}

// `match` over a VALUE union — a struct union (`C | D`), a scalar union (`i32 | string`), a
// mixed one (`A | i32 | string`), and a nullable's `| null` variant. Arms are TYPE patterns
// (`C =>`, `i32 =>`, `{c: i32} =>`, `null =>`, `A | B =>`) plus the same `_` wildcard.
//
// The lowering is the `is`-chain `desugarMatchAt` already builds, because the parser minted each
// type pattern as an `IsExpr` over the scrutinee (`parseMatchPattern`): the arm condition IS the
// pattern node. So there is no second narrowing path, no second tag test, and no emitter change
// — the emitted chain is indistinguishable from the hand-written `if u is C { … } else if …`
// this replaces, which is exactly the guard chain the corpus already exercises.
//
// What `match` adds over that chain is the part the chain cannot have: COMPLETENESS. Every
// member of the union must be named by some arm, or a `_` must be present — a missing arm is a
// compile ERROR (the rule phase 1 shipped for literal unions, kept verbatim here, and the whole
// reason the roadmap wants the compiler's own kind ladders on `match`).
//
// The three passes are not one pass because their ORDERS differ. Pattern diagnostics must come
// out in SOURCE order; the narrowing an arm body is checked under must be accumulated in CHAIN
// order (source order minus the else arm, then the else arm), because that is the order the
// desugared chain subtracts members in. Folding them together would either misreport diagnostics
// or check a body under the wrong narrowed type.
// Whether the arm BODY declares `name` in its OWN top-level scope. The desugar prepends the
// bindings to that block, so the two declarations land in ONE scope — a collision the ordinary
// scope machinery never sees, because pre-desugar they are two nested scopes and shadowing is
// legal there. Without this the emitter would be the first pass to meet two same-named locals of
// possibly different types.
function matchBodyDeclares(bodyIx: i32, name: string) {
  if bodyIx < 0 { return false }
  const b = P.nodes[bodyIx]
  if b is Block {
    let i = 0
    while i < b.blkStmts.length {
      const st = P.nodes[b.blkStmts[i]]
      if st is LetDecl {
        if st.letName == name { return true }
      } else if st is FuncDecl {
        if st.fnName == name { return true }
      }
      i = i + 1
    }
  }
  false
}

// The two clause-level rejects that exist because the desugar SPLICES rather than wraps: a name
// bound twice by one clause, and a name the arm body redeclares. Both would be accepted here and
// decided by the emitter's local allocator; both are reported AT the binding.
function checkMatchBindNames(bIx: i32, bodyIx: i32) {
  if bIx < 0 { return 0 }
  const bn = P.nodes[bIx]
  if bn is Block {
    let i = 0
    while i < bn.blkStmts.length {
      const st = P.nodes[bn.blkStmts[i]]
      if st is LetDecl {
        let j = 0
        while j < i {
          const pv = P.nodes[bn.blkStmts[j]]
          if pv is LetDecl {
            if pv.letName == st.letName {
              tErr(
                "duplicate payload binding `" + st.letName + "`",
                bn.blkStmts[i],
              )
            }
          }
          j = j + 1
        }
        if matchBodyDeclares(bodyIx, st.letName) {
          tErr(
            "payload binding `" +
              st.letName +
              "` is redeclared in the arm body — rename one",
            bn.blkStmts[i],
          )
        }
      }
      i = i + 1
    }
  }
  0
}

// Check a clause's `const` decls INSIDE the arm's narrowing scope, so `const x = scrut.x` reads
// the field off the NARROWED member and the name is visible to the body that follows. `checkNode`
// on the clause `Block` itself would push a scope of its own and drop every binding on the floor.
// A DUPLICATE binding is skipped rather than checked: `checkMatchBindNames` has already reported
// it, and declaring the name twice in this one scope would stack the scope machinery's own terse
// `redeclared x` on top of the message that explains what the mistake actually was.
function checkMatchBindDecls(bIx: i32) {
  if bIx < 0 { return 0 }
  const bn = P.nodes[bIx]
  if bn is Block {
    let i = 0
    while i < bn.blkStmts.length {
      let dup = false
      const st = P.nodes[bn.blkStmts[i]]
      if st is LetDecl {
        let j = 0
        while j < i {
          const pv = P.nodes[bn.blkStmts[j]]
          if pv is LetDecl {
            if pv.letName == st.letName { dup = true }
          }
          j = j + 1
        }
      }
      if !dup { checkNode(bn.blkStmts[i]) }
      i = i + 1
    }
  }
  0
}

function checkMatchTypeArms(n: MatchExpr, ix: i32, st: i32, uMems: i32[]) {
  // `uMems` is the scrutinee's variant list (`flattenVariantsInto`, so a nullable contributes
  // its inner variants plus `null`) — `unMemTys`' checker-side twin, a data structure, never a
  // re-split of a rendered spelling. `covered` is its parallel flag column.
  const covered: i32[] = []
  let ci = 0
  while ci < uMems.length {
    covered.push(0)
    ci = ci + 1
  }
  let hasWild = false
  // A pattern that names no member covers nothing — report it AT THE PATTERN and suppress the
  // exhaustiveness report below (the bad pattern is the root cause; don't cascade).
  let sawBadPat = false
  const nArms = n.matchArmStart.length
  // ── pass 1 (SOURCE order): resolve + validate every pattern, bank its check type, mark cover.
  let ai = 0
  while ai < nArms {
    let pj = 0
    while pj < n.matchArmCount[ai] {
      const patIx = n.matchPats[n.matchArmStart[ai] + pj]
      const pn = P.nodes[patIx]
      if pn is Ident {
        // The parser mints an `Ident` pattern ONLY for `_` (every other name is a type
        // pattern), so this arm is the wildcard.
        hasWild = true
      } else if pn is IsExpr {
        const pt = isTypeTy(pn.isVariant, patIx)
        if pt < 0 {
          sawBadPat = true
          tErr("unknown type '" + pn.isVariant + "' in match pattern", patIx)
        } else if tyIsCompositePat(pt) {
          sawBadPat = true
          tErr(
            "match pattern `" +
              pn.isVariant +
              "` names a union — list its members as separate arms (`A | B => …`)",
            patIx,
          )
        } else {
          // BANK the resolved check type on the pattern node — the very `isVarTyIx` row
          // `checkIsExprNode` fills for a hand-written `is`, which the emitter's narrowing
          // stack reads back through `isVarTyIxOf` (and `narrowTys` carries). Banked HERE
          // instead of re-checking the pattern through `checkNode`, which would re-check the
          // SCRUTINEE once per arm — an n-fold duplicate of every diagnostic the scrutinee
          // expression raises.
          if patIx < isVarTyIx.length { isVarTyIx[patIx] = pt }
          if patIx < nodeTyIx.length { nodeTyIx[patIx] = TY_BOOL }
          const hit = markUnionCover(uMems, covered, pt)
          if hit == 0 {
            tErr(
              "match pattern `" +
                pn.isVariant +
                "` is not a member of " +
                tyToStr(st),
              patIx,
            )
          } else if hit < 0 {
            tErr(
              "redundant match arm: `" + pn.isVariant + "` is already covered",
              patIx,
            )
          }
        }
      } else if pn is StrLit {
        // A string-literal pattern discriminates a literal union's MEMBER TEXT; over a value
        // union the arms discriminate TYPES, so name the difference instead of reporting a
        // phantom missing member.
        sawBadPat = true
        tErr(
          "invalid match pattern " +
            pn.strText +
            " — a pattern over a value union is a member type or the `_` wildcard",
          patIx,
        )
      } else {
        sawBadPat = true
        tErr(
          "invalid match pattern — a pattern over a value union is a member type or the `_` wildcard",
          patIx,
        )
      }
      pj = pj + 1
    }
    // PAYLOAD CLAUSES (phase 2b), still in source order. An OR arm may not carry one: the checker
    // gives a multi-pattern arm NO then-narrowing (`collectThenNarrows` reports none for the
    // `a || b` condition the desugar builds for it), so the scrutinee inside the arm is still the
    // whole union and `scrut.x` would not type. Rust's rule — identical bindings in every
    // alternative — needs narrowing to the JOIN of the alternatives, which is ROADMAP B21 item 4.
    if n.matchArmCount[ai] > 1 {
      if matchArmHasBinds(n, ai) {
        tErr(
          "payload binding is not allowed on an or-pattern arm — give each type its own arm",
          n.matchPats[n.matchArmStart[ai]],
        )
      }
    } else {
      checkMatchBindNames(matchArmBindsOf(n, ai), n.matchBodies[ai])
    }
    ai = ai + 1
  }
  // Whether every member is named (or a `_` stands in for the rest) — settled by pass 1, and
  // read by pass 3 as well as by the exhaustiveness report at the end.
  let exhaustive = hasWild
  if !hasWild {
    let ec = 0
    let allCov = true
    while ec < covered.length {
      if covered[ec] == 0 { allCov = false }
      ec = ec + 1
    }
    exhaustive = allCov
  }
  // ── pass 2 (CHAIN order): the progressive ELSE narrowings. `armAcc[k]` is how much of the
  // accumulator holds when the chain enters arm `k`'s branch — i.e. the union minus every
  // member the arms tested BEFORE it. This is `collectElseNarrows`' `subtractTy` fold, run in
  // the same order and over the same nodes the emitted chain will run it.
  const elseArm = matchElseArmOf(n.matchPats, n.matchArmStart, n.matchArmCount)
  const accNames: string[] = []
  const accTys: i32[] = []
  const armAcc: i32[] = []
  let z = 0
  while z < nArms {
    armAcc.push(0)
    z = z + 1
  }
  let ck = 0
  while ck < nArms {
    if ck != elseArm {
      armAcc[ck] = accNames.length
      let pj = 0
      while pj < n.matchArmCount[ck] {
        collectElseNarrows(
          n.matchPats[n.matchArmStart[ck] + pj],
          accNames,
          accTys,
        )
        pj = pj + 1
      }
    }
    ck = ck + 1
  }
  if elseArm >= 0 { armAcc[elseArm] = accNames.length }
  // ── pass 3 (SOURCE order): check each arm body under its branch's narrowing, joining the
  // arm VALUE types so a value-position `match` and a return-tail `match` both type.
  // -1 is the "unset" join seed (`joinTys` returns the other operand); the positive TY_ERR
  // sentinel would POISON the join, so never seed with it.
  let matchTy = -1
  let bi = 0
  while bi < nArms {
    const nmz: string[] = []
    const tyz: i32[] = []
    let q = 0
    while q < armAcc[bi] {
      nmz.push(accNames[q])
      tyz.push(accTys[q])
      q = q + 1
    }
    // The arm's own THEN fact, for a single-pattern arm. A multi-pattern (`||`-joined) arm
    // gets none — exactly what `collectThenNarrows` reports for the `a || b` condition the
    // desugar builds for it, so the body sees the same type either way. Pushed AFTER the
    // accumulated complement, and `applyNarrows` binds in order, so the arm's own type wins.
    //
    // The ELSE arm normally takes the complement alone (for an exhaustive match the two are
    // the same type). When the match is NOT exhaustive the complement is WIDER than the type
    // the arm names, and checking the body under it stacks a confusing "field is not on every
    // member of <residual>" onto the missing-arm error that is the actual cause. A
    // non-exhaustive match is a hard error, so that program never reaches emit and the
    // narrower reading cannot be observed — take it, and let the ONE root cause stand.
    if bi != elseArm || !exhaustive {
      if n.matchArmCount[bi] == 1 {
        collectThenNarrows(n.matchPats[n.matchArmStart[bi]], nmz, tyz)
      }
    }
    // The scope is pushed for the PAYLOAD CLAUSE as well as for the narrowing — an arm can bind
    // without narrowing (a non-place scrutinee contributes no fact), and its `const`s must still
    // be arm-local. The clause is checked here, between `applyNarrows` and the body: after, so
    // `scrut.x` reads the field off the narrowed member; before, so the body sees the names.
    const bindIx = matchArmBindsOf(n, bi)
    const scoped = nmz.length > 0 || bindIx >= 0
    if scoped {
      pushScope(-1)
      applyNarrows(nmz, tyz)
      checkMatchBindDecls(bindIx)
    }
    const body = n.matchBodies[bi]
    const bt = checkNode(body)
    let armTy = bt
    const bn = P.nodes[body]
    if bn is Block {
      armTy = blockTailTy
      // A statement-tail block has `blockTailTy == -1` ("no value") — that is VOID, not the
      // sentinel TY_ERR (both are -1), so a void-arm `match` must not be mistaken for an error.
      if armTy < 0 { armTy = TY_VOID }
    }
    if scoped { popScope() }
    matchTy = joinTys(matchTy, armTy)
    bi = bi + 1
  }
  if matchTy < 0 { matchTy = TY_VOID }
  // EXHAUSTIVENESS: every member covered, or a wildcard. `_` is ALLOWED but never REQUIRED —
  // a match that names every member is complete without one, and adding one is not an error
  // (it is the only way to write a default for a union that later grows a member). Missing
  // members are rendered from the ARENA member types, so the report names what the union
  // actually holds rather than a re-split spelling.
  if !hasWild && !sawBadPat {
    let missing = ""
    let mk = 0
    while mk < uMems.length {
      if covered[mk] == 0 {
        if missing != "" { missing = missing + ", " }
        missing = missing + tyToStr(uMems[mk])
      }
      mk = mk + 1
    }
    if missing != "" {
      tErr(
        "non-exhaustive match — missing " + missing + " (add the arm or a `_`)",
        ix,
      )
    }
  }
  // Lower to an if/else chain in place (real pass only) so lint + emit see only if-chains.
  if !inferQuiet { desugarMatchAt(ix) }
  matchTy
}

// Extracted from `checkNodeReal`'s `MatchExpr` arm (C3: thin the dispatcher).
function checkMatchExprNode(n: MatchExpr, ix: i32) {
  // `match scrut { pat => body … }` — exhaustive dispatch over a union. Two arm vocabularies,
  // decided by the SCRUTINEE: a literal union (`"a" | "b"`) dispatches on member STRINGS
  // (phase 1, below); any other union dispatches on member TYPES (`checkMatchTypeArms`).
  // Both check that every pattern is a member, enforce EXHAUSTIVENESS (all members covered, or
  // a `_` wildcard), reject REDUNDANT arms, and join the arm VALUE types so a value-position
  // `match` (`const x = match …`) and a return-tail `match` both type.
  // The scrutinee and the arm bodies are NOT in return-tail position; RESTORE the flag on
  // every exit (mirroring `checkIfStmtNode`) so a `match` subexpression is transparent to a
  // SIBLING in the same statement — a stale `false` re-typed a following else-less tail-`if`
  // as void instead of `then | null`.
  const mTail = retTailPos
  retTailPos = false
  const st = checkNode(n.matchScrut)
  if !tyIsLitUnion(st) {
    // Any OTHER union — struct, scalar, mixed, and the `| null` spellings both `TyUnion` and
    // `TyNullable` produce — takes the type-pattern path. The old blanket gate rejected all of
    // them, not because they could not lower (the `is`-chain they desugar to has always
    // lowered — `tests/cases/unions/*` is full of it) but because phase 1 had no pattern
    // SYNTAX for a type. Nothing else was behind it.
    const uMems: i32[] = []
    flattenVariantsInto(st, uMems)
    if uMems.length > 1 && !unionHasLitMember(uMems) {
      const r = checkMatchTypeArms(n, ix, st, uMems)
      retTailPos = mTail
      return r
    }
    tErr(matchScrutRejectMsg(st, uMems), ix)
    retTailPos = mTail
    return TY_ERR
  }
  // The member texts (inner, no quotes), and a parallel covered-flag.
  const members: string[] = []
  const sty = T.tys[st]
  if sty is TyUnion {
    let mi = 0
    while mi < sty.uMembers.length {
      const mm = T.tys[sty.uMembers[mi]]
      if mm is TyLit { members.push(mm.litText) }
      mi = mi + 1
    }
  }
  const covered: i32[] = []
  let ci = 0
  while ci < members.length {
    covered.push(0)
    ci = ci + 1
  }
  let hasWild = false
  // A pattern that is neither a member STRING literal nor the `_` wildcard covers
  // nothing — report it AT THE PATTERN (silently skipping it surfaced later as a
  // misattributed "non-exhaustive match", or as a phantom wildcard for a non-`_`
  // identifier) and suppress the exhaustiveness error below (the bad pattern is
  // the root cause; don't cascade).
  let sawBadPat = false
  // -1 is the "unset" join seed (`joinTys` returns the other operand); the positive TY_ERR
  // sentinel would POISON the join (every arm joins back to error), so never seed with it.
  let matchTy = -1
  let ai = 0
  while ai < n.matchArmStart.length {
    // Patterns of arm `ai`.
    let pj = 0
    while pj < n.matchArmCount[ai] {
      const patIx = n.matchPats[n.matchArmStart[ai] + pj]
      const pn = P.nodes[patIx]
      if pn is Ident {
        // The parser mints an `Ident` pattern ONLY for `_` (D-MATCHTY: every other name now
        // parses as a TYPE pattern, handled below), so this arm is the wildcard.
        hasWild = true
      } else if pn is IsExpr {
        // A TYPE pattern over a literal union: the arms here discriminate member STRINGS, and
        // an identifier that names no type reaches this same arm (`match k { high => … }`),
        // so the wording is phase 1's verbatim — it must not silently cover every member.
        sawBadPat = true
        tErr(
          "invalid match pattern `" +
            pn.isVariant +
            "` — a pattern is a member string literal or the `_` wildcard",
          patIx,
        )
      } else if pn is StrLit {
        // The member name is the pattern's inner text (strip the surrounding quotes).
        // NOT `tyname.groupInnerOf` (W1) — `strText` is an EXPRESSION lexeme; see the
        // language boundary recorded on `litTyOfExpr`. (The `>= 2` gate here is also NOT
        // the home's bound: it keeps a degenerate lexeme WHOLE where the home returns "".)
        const raw = pn.strText
        let inner = raw
        if raw.length >= 2 { inner = raw.slice(1, raw.length - 1) }
        let found = -1
        let fi = 0
        while fi < members.length {
          if members[fi] == inner { found = fi }
          fi = fi + 1
        }
        if found < 0 {
          tErr(
            "match pattern \"" + inner + "\" is not a member of " + tyToStr(st),
            patIx,
          )
        } else if covered[found] == 1 {
          tErr(
            "redundant match arm: \"" + inner + "\" is already covered",
            patIx,
          )
        } else {
          covered[found] = 1
        }
      } else {
        // Any other node kind (a parse-recovered pattern, a future literal form):
        // same story — it covers nothing, so name it rather than mis-blame coverage.
        sawBadPat = true
        tErr(
          "invalid match pattern — a pattern is a member string literal or the `_` wildcard",
          patIx,
        )
      }
      pj = pj + 1
    }
    // Body value type. (Arm bodies are NOT checked in return-tail position; the match's joined
    // value seeds the function return once, below — avoids a per-arm void/err mis-seed.)
    const body = n.matchBodies[ai]
    const bt = checkNode(body)
    let armTy = bt
    const bn = P.nodes[body]
    if bn is Block {
      armTy = blockTailTy
      // A statement-tail block has `blockTailTy == -1` ("no value") — that is VOID, not the
      // sentinel TY_ERR (both are -1), so a void-arm `match` must not be mistaken for an error.
      if armTy < 0 { armTy = TY_VOID }
    }
    matchTy = joinTys(matchTy, armTy)
    ai = ai + 1
  }
  // A void-armed match leaves the join unset (-1) or void; normalize to VOID so the function-
  // body-tail seeding (`noteInferredRet`) does not mistake it for the error sentinel.
  if matchTy < 0 { matchTy = TY_VOID }
  // Exhaustiveness: every member covered, or a wildcard. Skipped after an invalid
  // pattern — that arm covers nothing, so a missing-member report would mis-blame
  // coverage for what the pattern diagnostic already explained.
  if !hasWild && !sawBadPat {
    let missing = ""
    let mk = 0
    while mk < members.length {
      if covered[mk] == 0 {
        if missing != "" { missing = missing + ", " }
        missing = missing + "\"" + members[mk] + "\""
      }
      mk = mk + 1
    }
    if missing != "" {
      tErr(
        "non-exhaustive match — missing " + missing + " (add the arm or a `_`)",
        ix,
      )
    }
  }
  // Lower to an if/else chain in place (real pass only) so lint + emit see only if-chains.
  if !inferQuiet { desugarMatchAt(ix) }
  retTailPos = mTail
  return matchTy
}

// Extracted from `checkNodeReal`'s `IfStmt` arm (C3: thin the dispatcher).
// The node index of `ix` when it is an if-EXPRESSION (peeling grouping parens), else -1.
// The producer of `letInitIfIx`; mirrors the `isIfInit` peel `checkLetDeclNode` already
// runs a few lines below for the inferred-union export, so the two positions are the same
// position by construction rather than by coincidence.
function ifExprNodeOf(ix: i32): i32 {
  if ix < 0 { return -1 }
  let cur = ix
  let peels = 0
  while peels < 8 {
    const nd = P.nodes[cur]
    if nd is Paren {
      cur = nd.parInner
      if cur < 0 { return -1 }
      peels = peels + 1
    } else {
      peels = 8
    }
  }
  if cur < 0 { return -1 }
  const fin = P.nodes[cur]
  if fin is IfStmt { return cur }
  -1
}

function checkIfStmtNode(n: IfStmt, ix: i32) {
  // An `if`/`else` in VALUE position is an EXPRESSION whose value is the join of its
  // branch tail values (`if c { 1 } else { 2 }` is `i32`). Capture whether THIS `if`
  // sits in the function's return-tail position; the condition itself never does.
  const ifTail = retTailPos
  retTailPos = false
  const condTy = checkNode(n.ifCond)
  if !assignable(condTy, TY_BOOL) {
    tErr("if-condition must be boolean, got " + tyToStr(condTy), ix)
  }
  // Narrowing over a simple identifier:
  //  - `if x is T { … }` refines `x` to the variant `T` in the THEN branch.
  //  - `if x != null { … }` refines a nullable `x` to its inner type in the THEN.
  //  - `if x == null { … } else { … }` refines `x` to inner in the ELSE; and when
  //    the THEN always exits (a guard clause), `x` is inner AFTER the `if` too.
  // Branch narrowing rides a pushed scope that shadows `x`. (Union-complement
  // narrowing after `is T` was tried and REVERTED — it made VL miss real errors;
  // null-stripping is the well-defined core and is what the corpus leans on.)
  // The condition's TRUE narrowings hold in the THEN branch, its FALSE
  // narrowings in the ELSE (and, for a diverging then — a guard clause — for
  // the rest of the enclosing block). The collectors handle `is` / null
  // compares / `&&`-`||` chains / `!(…)` / parens.
  const tnNames: string[] = []
  const tnTys: i32[] = []
  collectThenNarrows(n.ifCond, tnNames, tnTys)
  const enNames: string[] = []
  const enTys: i32[] = []
  collectElseNarrows(n.ifCond, enNames, enTys)
  // Definite-assignment fork/join: each branch is a separate path forked off
  // the if-entry state; after the chain they JOIN. A binding is assigned after
  // the `if` only if assigned on EVERY surviving (non-diverging) path. With no
  // `else`, the implicit fall-through (condition false) is a surviving path
  // that assigns nothing — so a write only inside `if c { x = 1 }` does NOT
  // make `x` assigned afterwards. A branch that always exits (`return`/`break`/
  // `continue`) contributes nothing to the merge (its end is unreachable).
  const daEntry = daSnapshot()
  const daThenDiverges = daBranchDiverges(n.ifThen)
  // `is`-GUARD ALTERNATIVES over an un-annotated-param HOLE. A then-narrow that
  // refines a HOLE binding is not an extra field demand — it is an ALTERNATIVE the
  // body handles on its own branch (`if v is {foo: string} then return v.foo`). The
  // narrowed binding shadows the hole for the whole then-branch, so those uses never
  // grow the demanded shape; without recording them the shape would carry the
  // COMPLEMENT path's fields alone and reject the argument the guard accepts.
  // Registered BEFORE the branch scope is pushed, so `lookup` still sees the hole.
  const altRows: i32[] = []
  // The rows this guard tests, INCLUDING ones a previous pass over the same body
  // already registered (`noteHoleAlt` reports only NEW rows, so its tail-patch stays
  // first-pass-only). The guarded-return marking must fire on every pass — the real
  // pass is the one whose `noteInferredRet` witnesses reach the call site.
  const guardRows: i32[] = []
  let ai = 0
  while ai < tnNames.length {
    if !isPathKey(tnNames[ai]) {
      const curIx = lookup(tnNames[ai])
      if curIx >= 0 {
        const cur = T.tys[curIx]
        if cur is TyVar {
          const row = noteHoleAlt(curIx, cur.tvName, tnTys[ai])
          if row >= 0 {
            altRows.push(row)
            guardRows.push(row)
          } else {
            const seen = holeAltRowOf(cur.tvName, tnTys[ai])
            if seen >= 0 { guardRows.push(seen) }
          }
        }
      }
    }
    ai = ai + 1
  }
  if tnNames.length > 0 {
    pushScope(-1)
    applyNarrows(tnNames, tnTys)
  }
  retTailPos = ifTail
  // Every `return` lowered under this branch is reached ONLY by an argument that
  // satisfies the guard's alternative — mark the branch so `noteInferredRet` records
  // its contribution as a GUARDED member (see `guardAltStack`).
  const guardedRet = guardRows.length > 0
  if guardedRet { guardAltStack.push(guardRows[guardRows.length - 1]) }
  checkNode(n.ifThen)
  if guardedRet { guardAltStack.pop() }
  retTailPos = false
  const thenTy = blockTailTy
  if tnNames.length > 0 { popScope() }
  // SEED the inferred return from the then-branch value BEFORE the else is checked, so
  // a recursive call in the else (`fib(n-1)+fib(n-2)`) resolves against the base-case
  // type (`return n` → i32) instead of an unresolved hole (the #487 mechanism, now
  // reached through an implicit-return branch value, not just an explicit `return`).
  // Seed only from a genuine value-`if` (one WITH an `else` — a no-else `if` is a
  // statement, not a value expression) and only a CONCRETE branch value: a TY_VOID
  // (a statement-tail branch, e.g. a void procedure's recursive tail call) or a still-
  // unresolved TY_ERR (a recursive call with no base case seeded yet) must not be
  // mistaken for the return type, or a void procedure infers a spurious value/error.
  if ifTail && n.ifElse >= 0 {
    if thenTy != TY_VOID && thenTy != TY_ERR {
      // The then-arm's implicit-return value is guarded exactly like an explicit
      // `return` inside it (`if v is T then v.foo else v.bar`).
      if guardedRet { guardAltStack.push(guardRows[guardRows.length - 1]) }
      noteInferredRet(thenTy)
      if guardedRet { guardAltStack.pop() }
    }
  }
  // Surviving paths' end-states, each as an unassigned snapshot. Seed with the
  // then-branch end if it survived.
  const daThenEnd = daSnapshot()
  daRestore(daEntry)
  let daElseDiverges = false
  let daElseEnd = daEntry
  let elseTy = TY_VOID
  const daHasElse = n.ifElse >= 0
  if daHasElse {
    daElseDiverges = daBranchDiverges(n.ifElse)
    if enNames.length > 0 {
      pushScope(-1)
      applyNarrows(enNames, enTys)
    }
    retTailPos = ifTail
    const elseRes = checkNode(n.ifElse)
    retTailPos = false
    elseTy = blockTailTy
    // An `else if` CHAIN: the else node is an IfStmt whose VALUE is its own branch
    // join (the checkNode result). `blockTailTy` holds only the INNERMOST block's
    // tail, which under-joins a mixed chain (`if a then k else if b then "cc" else
    // k2` joined to the litunion, dropping the string arm — the emitted string ref
    // then flowed into an i32 join).
    const enElse = P.nodes[n.ifElse]
    if enElse is IfStmt { elseTy = elseRes }
    if enNames.length > 0 { popScope() }
    if ifTail {
      if elseTy != TY_VOID && elseTy != TY_ERR { noteInferredRet(elseTy) }
    }
    daElseEnd = daSnapshot()
  }
  // Close each `is`-guard alternative registered above. A then-branch that DIVERGES
  // (a guard clause) leaves the code after this `if` unreachable for an argument that
  // satisfies the alternative, so nothing past it is required (`holeAltTailN` stays
  // -1). Otherwise execution rejoins here and every field demanded from now on IS
  // reached — record where that suffix starts. Fields demanded strictly inside the
  // `if` (the else arm) fall in neither range: the guard being true skipped them.
  if !daThenDiverges {
    let ac = 0
    while ac < altRows.length {
      const row = altRows[ac]
      holeAltTailN[row] = holeShapeFieldCount(holeAltNames[row])
      ac = ac + 1
    }
  }
  // Join the surviving paths. Start from the empty set and fold in every
  // surviving path's unassigned set (the union = "unassigned on some surviving
  // path"). The else path (or, with no `else`, the entry fall-through) always
  // counts unless it diverges.
  daClear()
  if !daThenDiverges { daJoinInto(daThenEnd) }
  if daHasElse {
    if !daElseDiverges { daJoinInto(daElseEnd) }
  } else {
    daJoinInto(daEntry)
  }
  // GUARD CLAUSE: a THEN that always exits applies the FALSE narrowings to
  // the rest of the enclosing block (`if x == null { return } … x.f …`).
  // Host `postGuardNarrowings` parity: only a SINGLE-arm `if` with NO `else`
  // (an `else`/`else if` chain does not post-narrow the fall-through), and
  // only ONE union SUBTRACTION per place per block — the host checker accepts
  // a twice-subtracted residual but both codegens reject it
  // (xfail-false-reject-seq-guard-residual), so the front end keeps rejecting the
  // second subtraction. Null-STRIPS always apply (guard sequences rely on
  // them). Path-keyed entries unwind at the ENCLOSING scope's `popScope`.
  if enNames.length > 0 && !daHasElse {
    const tn2 = P.nodes[n.ifThen]
    if tn2 is Block {
      const tst = tn2.blkStmts
      if tst.length > 0 {
        const last = P.nodes[tst[tst.length - 1]]
        let diverges = false
        if last is RetStmt { diverges = true }
        else if last is BreakStmt { diverges = true }
        else if last is ContinueStmt { diverges = true }
        if diverges {
          let gi2 = 0
          while gi2 < enNames.length {
            const gKey = enNames[gi2]
            const gTy = enTys[gi2]
            if isPathKey(gKey) {
              npKeys.push(gKey)
              npTys.push(gTy)
              npInvBy.push(-1)
              npEpochs.push(narFnEpoch)
            } else if gTy == nonNullTy(lookup(gKey)) {
              declare(gKey, gTy)
            } else {
              let gSeen = false
              let gj = 0
              while gj < pgKeys.length {
                if pgKeys[gj] == gKey { gSeen = true }
                gj = gj + 1
              }
              if !gSeen {
                pgKeys.push(gKey)
                declare(gKey, gTy)
              }
            }
            gi2 = gi2 + 1
          }
        }
      }
    }
  }
  retTailPos = ifTail
  // The `if`-expression's VALUE type: the join of the two branch tail values. With no
  // `else` the `if` may not yield a value (the fall-through has none), so it is valueless
  // (TY_VOID) — a value-position use without `else` stays as before. A statement `if`
  // (void branches) joins to TY_VOID, unchanged.
  if daHasElse { return joinTys(thenTy, elseTy) }
  // An else-less `if` in RETURN-TAIL position: the false fall-through yields no value —
  // that path is `null` (exactly the #484 function fall-through), so the function's
  // return is `thenTy | null`. The emitter routes this to `emitIfTail` (the then-arm
  // returns the value; the false path falls through to the function-end null padding,
  // `emitNullForRet`).
  //
  // …AND in a `let`/`const` INITIALIZER (`const r = if c { 5 }`), which is new here. The
  // comment that stood in this spot said "outside tail position the emitter can't yet
  // leave a nullable value on the stack, so it stays TY_VOID — a clean `cannot assign
  // void` at the use site, pending a typed-blocktype if-expression". **THAT REASON IS NO
  // LONGER TRUE FOR THIS POSITION**: `emit_collect.nliInferIfLet` lowers an if-expression
  // BINDING against the checker's exported inferred union (`inferLetIx`/`inferLetTy`,
  // whose own gate — `isIfInit` in `checkLetDeclNode` — is this exact position), so the
  // capability the decline was waiting for arrived and nothing re-read the decline.
  // Measured: `const r = if c { 5 }` then `r ?? 0` / `r == null` / `r + 1` / a `string`
  // arm / an annotated `: i32 | null` binding all ran correctly under the widening, in
  // and out of a function body; the reported symptom (filed as a `??` bug — `??` is not
  // involved, it returns its LHS unchanged) was the checker refusing at the BINDING.
  //
  // The widening is POSITION-GATED, not global, and the gate is a measurement: the three
  // positions the emitter still cannot lower — a call ARGUMENT, an explicit `return`, and
  // a bare `print(if c { 5 } ?? 0)` — all answer `emitProgram: union if-expression
  // requires an else arm`, so widening there would trade the checker's clean, positioned
  // "cannot assign void" for an emit-stage reject. Those keep master's behaviour exactly.
  if thenTy != TY_VOID && thenTy != TY_ERR {
    if ifTail { return mkNullableTy(thenTy) }
    if ix == letInitIfIx { return mkNullableTy(thenTy) }
  }
  return TY_VOID
}
// ── explicit numeric cast `x as T` ──────────────────────────────────────────

// `x as T` (B2) is an explicit, CHECKED numeric conversion. Unlike the implicit
// lossless-widening rule (`numWidensName`, which permits only i32→i64, i32→f64,
// f32→f64), `as` permits EVERY numeric-scalar direction: those widenings PLUS the
// lossy widenings (i64→f64, i32→f32, i64→f32), the narrowings (i64→i32 wrap,
// f64→f32 demote) and int↔float conversions — that explicitness is the whole
// point. The float→int forms trap at runtime on NaN / out-of-range (see emit).
// `as` is numeric-only for now: a non-numeric operand OR target is a type error.
// The cast expression's type is exactly `T`.
function checkCastNode(n: AsExpr, ix: i32) {
  const arg = checkNode(n.asObj)
  const target = nameToTyAt(n.asTy, ix)
  if target < 0 {
    tErr("unknown type `" + n.asTy + "` in `as` cast", ix)
    return TY_ERR
  }
  // The TARGET must be a concrete numeric scalar (strict — `primNameOf` skips
  // arrays/objects/unions/type-vars). The OPERAND uses the tolerant `isNumeric`
  // (true for `TyErr`), so an already-errored operand does not pile on a second
  // diagnostic here.
  const tn = primNameOf(target)
  const targetIsScalar = tn == "i32" ||
    tn == "i64" ||
    tn == "f32" ||
    tn == "f64"
  if !isNumeric(arg) || !targetIsScalar {
    tErr("`as` supports numeric conversions only", ix)
    return TY_ERR
  }
  target
}

// ── unary ──────────────────────────────────────────────────────────────────

// Extracted from `checkNodeReal`'s `Unary` arm (C3: thin the dispatcher).
function checkUnaryNode(n: Unary, ix: i32) {
  const arg = checkNode(n.unArg)
  if n.unOp == "!" {
    if !assignable(arg, TY_BOOL) {
      tErr("operator '!' expects boolean, got " + tyToStr(arg), ix)
    }
    return TY_BOOL
  }
  // Postfix `x++` / `x--` (`"p+"`/`"p-"`): `unArg` is the `x = x ± 1` assignment,
  // already fully checked by `checkNode` above (const-reassign, numeric arithmetic,
  // assignability). The postfix expression's type is that of the operand.
  if n.unOp == "p+" || n.unOp == "p-" {
    if !isNumeric(arg) {
      tErr("'++'/'--' expects a numeric variable, got " + tyToStr(arg), ix)
      return TY_ERR
    }
    return arg
  }
  // "-"
  if !isNumeric(arg) {
    tErr("unary '-' expects a numeric type, got " + tyToStr(arg), ix)
    return TY_ERR
  }
  // Host parity: the host folds `-lit` into a signed literal BEFORE defaulting,
  // so `-2147483648` (magnitude 2^31, one past I32_MAX) sits at I32_MIN and is
  // i32 — even though the bare operand literal alone types i64.
  if n.unOp == "-" {
    if isNegI32MinLit(n.unArg) { return TY_I32 }
  }
  return arg
}
// ── member `o.field` ───────────────────────────────────────────────────────

// Extracted from `checkNodeReal`'s `Member` arm (C3: thin the dispatcher).
function checkMemberNode(n: Member, ix: i32) {
  // FLAT LAYOUT CONSTANT (webcraft P1.2): `TValue.size` / `TValue.tt`. Answered
  // BEFORE the receiver is checked, because the receiver is a TYPE name and
  // checking it as an expression is `undeclared identifier` — which is exactly
  // what master answers here, so this interception cannot change an existing
  // program. `flatMemberFold` is guarded three ways (bare identifier / names a
  // FLAT type / does not resolve as a value) and rewrites the node in place.
  const fl = flatMemberFold(n, ix)
  if fl == 1 { return TY_I32 }
  if fl == 2 { return TY_ERR }
  // A layout member on a type PARAMETER: an `i32` whose VALUE the monomorphizer
  // supplies per instance. The node stays a `Member` until then.
  if fl == 3 { return TY_I32 }
  // A flow-narrowed property path (`if o.v is T { … }`) overrides the stored
  // field type within the branch (the host's `narrowedPaths` overlay).
  const mKey = placeKeyOf(ix)
  if mKey != "" {
    const mOv = narrowedPathTy(mKey)
    if mOv >= 0 { return symMem(ix, mOv) }
    const mInv = narrowedPathInvBy(mKey)
    if mInv >= 0 { return pathInvalidatedErr(mKey, mInv, ix) }
  }
  const objTy = checkNode(n.memObj)
  // A NEGATIVE receiver type is an unpinned inference hole (the `-1` element
  // of a never-pinned empty `[]` read back through `xs[i]`), not an arena
  // index — indexing `T.tys` with it would CRASH. The hole itself is already
  // reported (`flushUninferred` / the unknown-annotation path), so don't
  // cascade.
  if objTy < 0 { return TY_ERR }
  const ot = T.tys[objTy]
  if ot is TyObj {
    const ft = objFieldType(ot, n.memProp)
    if ft < 0 {
      tErr("no field '" + n.memProp + "' on " + tyToStr(objTy), ix)
      return TY_ERR
    }
    return symMem(ix, ft)
  }
  if ot is TyErr { return TY_ERR }
  // SHARED-FIELD ACCESS over a struct union — `(A | B).tag` when every
  // member carries the field at the same type (the host's
  // `sharedUnionField`); an unshared field still needs an `is` narrowing.
  if ot is TyUnion {
    const sf = sharedUnionFieldTy(ot, n.memProp)
    if sf >= 0 { return symMem(ix, sf) }
    // The field is on SOME but not all members of the union — reading it is
    // unsafe until the value is narrowed (`is`) to a member that has it.
    // (NOT "non-object": the members ARE objects; the field just isn't shared.)
    tErr(
      "field '" +
        n.memProp +
        "' is not on every member of " +
        tyToStr(objTy) +
        " — narrow with `is` first",
      ix,
    )
    return TY_ERR
  }
  // `.length` on an array, a map, or a string is an i32.
  if ot is TyArray {
    if n.memProp == "length" { return symMem(ix, TY_I32) }
    tErr("no field '" + n.memProp + "' on array " + tyToStr(objTy), ix)
    return TY_ERR
  }
  if ot is TyMap {
    // `.length` and `.size` are both the live-entry count (an i32) — `.size` is the
    // JS Map/Set name, `.length` the list-consistent alias; both read the same field.
    if n.memProp == "length" { return symMem(ix, TY_I32) }
    if n.memProp == "size" { return symMem(ix, TY_I32) }
    tErr("no field '" + n.memProp + "' on map " + tyToStr(objTy), ix)
    return TY_ERR
  }
  if ot is TyPrim {
    if ot.primName == "string" {
      if n.memProp == "length" { return symMem(ix, TY_I32) }
      tErr("no field '" + n.memProp + "' on string", ix)
      return TY_ERR
    }
  }
  // Member access on an INFERENCE HOLE (`self.x` where `self` is the
  // un-annotated param hole `?add.0` — host: `getChildType` pins the
  // `Infer<Unknown>` to a growing object shape): record the demanded field
  // and yield its derived hole; the call site pins both (A13).
  if ot is TyVar {
    if ot.tvName.length > 0 {
      if ot.tvName[0] == '?' {
        // `.length` is the i32 length an array / string / map exposes — treat it as that
        // (not a struct field) so an un-annotated param used as a collection (`self[i]` +
        // `self.length`) infers without growing a bogus `{length}` shape that an array
        // argument can't satisfy. A NON-length field still grows the hole's struct shape.
        if n.memProp == "length" { return symMem(ix, TY_I32) }
        return symMem(ix, holeMemberTy(objTy, ot.tvName, n.memProp))
      }
    }
  }
  tErr("member access '." + n.memProp + "' on non-object " + tyToStr(objTy), ix)
  return TY_ERR
}
// ── array literal ───────────────────────────────────────────────────────────
// `[e, e, …]` types as `T[]` where `T` is the first element's type (the rest must
// be assignable to it). An empty `[]` is `T[]` with an unknown element (`-1`),
// assignable to any array — its concrete element is pinned by the binding's
// annotation (`let a: i32[] = []`).

// Extracted from `checkNodeReal`'s `ArrayLit` arm (C3: thin the dispatcher).
function checkArrayLitNode(n: ArrayLit, _ix: i32) {
  const elems = n.arrElems
  if elems.length < 1 { return mkArrayTy(-1) }
  // A `void` element has no value to store. Poisoned to `TY_ERR` rather than joined, so
  // an ANNOTATED literal (`const xs: i32[] = [f()]`) keeps its single "cannot assign"
  // message instead of gaining a second one for the same mistake.
  let elemTy = checkNode(elems[0])
  if voidValueSlotErr(elemTy, elems[0], "list element", elems[0]) {
    elemTy = TY_ERR
  }
  let ei = 1
  while ei < elems.length {
    let et = checkNode(elems[ei])
    if voidValueSlotErr(et, elems[ei], "list element", elems[ei]) {
      et = TY_ERR
    }
    // Host parity: the element type is the UNION of every element's type
    // (flattened/deduped) — `[a, b, c]` over mixed struct variants types as
    // `(A | B | C)[]`; an annotation then checks each member structurally.
    elemTy = joinTys(elemTy, et)
    ei = ei + 1
  }
  return mkArrayTy(elemTy)
}
// ── index `a[i]` ────────────────────────────────────────────────────────────

// Extracted from `checkNodeReal`'s `Index` arm (C3: thin the dispatcher).
function checkIndexNode(n: Index, ix: i32) {
  const arrTy = checkNode(n.idxArr)
  const idxTy = checkNode(n.idxIndex)
  // Guard the unpinned-hole receiver (`-1` — see the Member-arm note).
  if arrTy < 0 { return TY_ERR }
  const at = T.tys[arrTy]
  // A MAP index `m[k]`: the key must match the map's key type; a READ yields the
  // NULLABLE value (`V | null` — the key may be absent; default with `??`), and an
  // assignment target `m[k] = v` accepts a plain `V` (assignable to `V | null`).
  if at is TyMap {
    if !assignable(idxTy, at.mKey) {
      tErr(
        "map key must be " + tyToStr(at.mKey) + ", got " + tyToStr(idxTy),
        ix,
      )
    }
    return mkNullableTy(at.mVal)
  }
  // Indexing an un-annotated-param HOLE (`self[i]`) constrains it to an array: demand an
  // i32 index and return the element as a DERIVED hole (`HD_ELEM`), resolved per call
  // site against the pinned array's element (`substHoleTy`). Mirrors `holeMemberTy`
  // for `self.x`, so an un-annotated `function head(self) { return self[0] }` infers.
  if at is TyVar {
    if !assignable(idxTy, TY_I32) {
      // A NON-i32 index can only be a MAP — an array is i32-indexed, and that is the whole
      // disambiguation — so constrain the hole to its demanded map and pin the KEY from the
      // index, the index-spelling twin of the `.set` arm's pin. `q["a"] = 1` used to report
      // `array index must be i32, got string` about a parameter nothing said was an array.
      // (The i32 index below stays the ARRAY demand: `q[1]` is genuinely ambiguous between
      // `i32[]` and `{[i32]: V}`, and only the ARGUMENT can decide, which is backward flow.)
      if mapKeyTySupported(idxTy) {
        const hmi = holeMapDemandTy(at.tvName, false)
        const hmt = T.tys[hmi]
        if hmt is TyMap {
          if hmt.mKey < 0 {
            hmt.mKey = idxTy
            tyMutEpoch = tyMutEpoch + 1 // hole index-read pinned the demanded key in place
          }
          return mkNullableTy(hmt.mVal)
        }
      }
      tErr("array index must be i32, got " + tyToStr(idxTy), ix)
    }
    noteArrayDemand(at.tvName)
    return mkDerivedHole(HD_ELEM, "", -1, -1, arrTy)
  }
  // FREE INDEX OPERATOR (B14): `x[i]` on a receiver the LANGUAGE does not index
  // resolves to a `function "[]"(self: T, i: I)` by the receiver's TYPE. Checked
  // before the closure-FIELD trap below, mirroring the `a op b` arm's order (a
  // free operator function outranks an operator field).
  if opIdxDeclared() {
    if !tyBuiltinIndexable(arrTy) {
      const rfn = opIdxFnFor(OP_INDEX_GET, arrTy)
      if rfn != "" {
        const bNames: string[] = []
        const bTys: i32[] = []
        opIdxBindGen(rfn, arrTy, idxTy, bNames, bTys)
        const kt = opIdxParamTy(rfn, 1)
        if kt >= 0 {
          const ktb = substTyDeep(kt, bNames, bTys)
          if !assignableExpr(n.idxIndex, idxTy, ktb) {
            tErr(
              "index: expected " + tyToStr(ktb) + ", got " + tyToStr(idxTy),
              ix,
            )
          }
        }
        opIdxBank(ix, rfn)
        const rty = opIdxRetTy(rfn)
        if bNames.length > 0 { return substTyDeep(rty, bNames, bTys) }
        return rty
      }
      // A WRITE operator with no READ operator is not a usable type: the
      // assignment form checks its target as an ordinary index expression, so
      // `x[i] = v` would report "cannot index" and name the wrong half. Say
      // which half is missing instead.
      const wOnly = opIdxFnFor(OP_INDEX_SET, arrTy)
      if wOnly != "" {
        tErr(
          "operator " +
            opDeclLabel(wOnly) +
            " needs a matching \"" +
            OP_INDEX_GET +
            "\" operator — an index that cannot be READ cannot be written either",
          ix,
        )
        return TY_ERR
      }
    }
  }
  // Index TRAP (B13, host parser `indexTrap`): a user object that declares a
  // `"[]"` method handles `o[k]` itself — the key checks against the
  // method's parameter (so an i32-keyed trap indexed with a string REJECTS,
  // index/wrong-key-type.vl), the result is its return. Checked BEFORE the
  // native i32-index rule (a trap key may be any type); a struct with no
  // `"[]"` falls through to the cannot-index error. Write traps (`o[k] = v`)
  // check in the assignment arm against `"[]="`.
  if at is TyObj {
    const trap = objFieldType(at, "[]")
    if trap >= 0 {
      const tt = T.tys[trap]
      if tt is TyFunc {
        if tt.fnParamTypes.length == 1 {
          if !assignableExpr(n.idxIndex, idxTy, tt.fnParamTypes[0]) {
            tErr(
              "index: expected " +
                tyToStr(tt.fnParamTypes[0]) +
                ", got " +
                tyToStr(idxTy),
              ix,
            )
          }
          return tt.fnRet
        }
      }
    }
    tErr("cannot index non-array " + tyToStr(arrTy), ix)
    return TY_ERR
  }
  if !assignable(idxTy, TY_I32) {
    tErr("array index must be i32, got " + tyToStr(idxTy), ix)
  }
  if at is TyArray { return at.aElem }
  if at is TyErr { return TY_ERR }
  // Indexing a string yields the i32 code point at that position.
  if at is TyPrim {
    if at.primName == "string" { return TY_I32 }
  }
  tErr("cannot index non-array " + tyToStr(arrTy), ix)
  return TY_ERR
}
// ── object literal ──────────────────────────────────────────────────────────
// `{ x: e, y: e }` types as a structural `TyObj` whose fields carry each value's
// checked type. Assignability against an annotation/param/return then matches it
// to a declared struct by structure (`assignable`), so field ORDER need not match
// the declaration. Reads each FieldInit child INLINE (Finding 2).

// Extracted from `checkNodeReal`'s `ObjLit` arm (C3: thin the dispatcher).
function checkObjLitNode(n: ObjLit, _ix: i32) {
  const fields = n.objFields
  const fnames: string[] = []
  const ftys: i32[] = []
  let i = 0
  while i < fields.length {
    const fnode = P.nodes[fields[i]]
    if fnode is FieldInit {
      fnames.push(fnode.fiName)
      // A `void` field initializer has no value to store; poisoned to `TY_ERR` so an
      // annotated literal keeps one message for the mistake. Without this the shape
      // carried a `void` member all the way to `emitProgram: ref valtype with no
      // interned shape`, which names nothing the author wrote.
      let fty = checkNode(fnode.fiValue)
      const fslot = "field '" + fnode.fiName + "'"
      if voidValueSlotErr(fty, fnode.fiValue, fslot, fnode.fiValue) {
        fty = TY_ERR
      }
      ftys.push(fty)
    }
    i = i + 1
  }
  return mkObjTy(fnames, ftys)
}
// ── type guard `x is T` ─────────────────────────────────────────────────────
// Always a `bool`. Checks the operand and that `T` names a known type. The actual
// narrowing of `x` to `T` happens in the THEN branch of an enclosing `if` (see the
// IfStmt case); used elsewhere it is just a boolean test.

// Extracted from `checkNodeReal`'s `IsExpr` arm (C3: thin the dispatcher).
function checkIsExprNode(n: IsExpr, ix: i32) {
  const objTy = checkNode(n.isObj)
  const chkTy = isTypeTy(n.isVariant, ix)
  // BANK the resolved check type on the `is` node: the emitter's narrowing stack
  // carries the narrowed type as an arena index from here, instead of re-classifying
  // the tested spelling at every read of the narrowed binding.
  if chkTy >= 0 {
    if ix >= 0 {
      if ix < isVarTyIx.length { isVarTyIx[ix] = chkTy }
    }
  }
  if chkTy < 0 {
    tErr("unknown type '" + n.isVariant + "' in 'is'", ix)
  } else if n.isVariant != "null" {
    // SOUNDNESS: `x is T` is meaningful only when the value can actually BE a
    // `T` — i.e. `T` is assignable to `x`'s type (its non-null part when `x` is
    // nullable). Otherwise the test can never hold, and since the THEN branch
    // narrows `x` to `T` VERBATIM (`collectThenNarrows`), an ungated test hands
    // the branch a binding of a type the value provably does not have. That is a
    // LAUNDER, not a dead branch: `n: Name` (`type Name = new string`) passed to
    // a `string` parameter is a hard type error, yet `if n is string { f(n) }`
    // would slip the same value through — and for a newtype there is no legal
    // unwrap at all (`as` is numeric-only). Scalar mismatches (`i32 is string`)
    // launder straight into invalid wasm.
    //
    // The gate covers EVERY operand, not just unions. `TyVar` (a generic
    // parameter) and `TyErr` (an un-inferred or already-errored operand) pass
    // `assignable` in both directions by construction, so an opaque operand is
    // still freely testable and never acquires a second diagnostic.
    const ot = T.tys[objTy]
    let baseTy = objTy
    let inUnion = false
    if ot is TyUnion {
      inUnion = true
    } else if ot is TyNullable {
      inUnion = true
      baseTy = ot.nInner
    }
    if !assignable(chkTy, baseTy) {
      if inUnion {
        tErr(
          "`is` check type '" +
            n.isVariant +
            "' is not a variant of " +
            tyToStr(objTy),
          ix,
        )
      } else {
        tErr(
          "`is` check type '" +
            n.isVariant +
            "' can never match a value of type " +
            tyToStr(objTy),
          ix,
        )
      }
    }
  }
  return TY_BOOL
}
// ── optional member `o?.field` ─────────────────────────────────────────────
// Null-safe access: a NULLABLE receiver reads the field off its inner type and
// re-wraps the result nullable (`{x: i32} | null` ?. x → `i32 | null`); a
// non-null receiver behaves like a plain member read.

// Extracted from `checkNodeReal`'s `OptMember` arm (C3: thin the dispatcher).
function checkOptMemberNode(n: OptMember, ix: i32) {
  // `x?.y` keys the same narrowed place as `x.y` (host `placeKey`).
  const omKey = placeKeyOf(ix)
  if omKey != "" {
    const omOv = narrowedPathTy(omKey)
    if omOv >= 0 { return symMem(ix, omOv) }
    const omInv = narrowedPathInvBy(omKey)
    if omInv >= 0 { return pathInvalidatedErr(omKey, omInv, ix) }
  }
  const recv = checkNode(n.omObj)
  // Guard the unpinned-hole receiver (`-1` — see the Member-arm note).
  if recv < 0 { return TY_ERR }
  const rcv = T.tys[recv]
  let wasNullable = false
  let baseTy = recv
  if rcv is TyNullable {
    wasNullable = true
    baseTy = rcv.nInner
    // Peel a SECOND nullable layer too: the host's `flattenType` collapses
    // `T??` to `T?`, so a doubly-nullable receiver (`m[k]?.v` off a nullable
    // map read) still reads its field with one `?.`.
    if baseTy >= 0 {
      const rcv2 = T.tys[baseTy]
      if rcv2 is TyNullable { baseTy = rcv2.nInner }
    }
  }
  if baseTy < 0 { return TY_ERR }
  const bt = T.tys[baseTy]
  if bt is TyObj {
    const oft = objFieldType(bt, n.omProp)
    if oft < 0 {
      tErr("no field '" + n.omProp + "' on " + tyToStr(baseTy), ix)
      return TY_ERR
    }
    if wasNullable { return symMem(ix, mkNullableTy(oft)) }
    return symMem(ix, oft)
  }
  if bt is TyErr { return TY_ERR }
  // Shared union field through `?.` — same rule as the plain member read.
  if bt is TyUnion {
    const osf = sharedUnionFieldTy(bt, n.omProp)
    if osf >= 0 {
      if wasNullable { return symMem(ix, mkNullableTy(osf)) }
      return symMem(ix, osf)
    }
  }
  tErr("member access '?." + n.omProp + "' on non-object " + tyToStr(recv), ix)
  return TY_ERR
}

// Extracted from `checkNodeReal`'s `WhileStmt` arm (C3: thin the dispatcher).
function checkWhileStmtNode(n: WhileStmt, ix: i32) {
  const wc = checkNode(n.whileCond)
  if !assignable(wc, TY_BOOL) {
    tErr("while-condition must be boolean, got " + tyToStr(wc), ix)
  }
  // Definite-assignment: a loop body may run ZERO times, so an assignment
  // inside it is NOT guaranteed to reach code after the loop. Check the body
  // with the live state (so a read AFTER an in-body assignment is fine), then
  // RESTORE the pre-loop state for the fall-through.
  const daLoopEntry = daSnapshot()
  // THE BODY IS A NARROWING SCOPE, exactly like an `if` THEN-arm: the condition
  // is re-tested before every iteration, so whatever it proves holds on entry to
  // each one (`while e != null { e + 1 }` reads the unboxed `i32`).
  //
  // WHY A BODY THAT REASSIGNS THE GUARDED BINDING NEEDS NO BACK-EDGE PASS. The
  // condition's re-test on every back edge is the whole argument: the fact holds on
  // entry to each iteration whatever the previous one wrote, so a write inside the
  // body only has to retire the fact for the statements AFTER it — which is what
  // `retireNarrowingsForWrite` does for a write anywhere, loop or not.
  // `while q != null { use(q)   q = null }` walks a nullable chain to exhaustion,
  // and `while q != null { q = null   use(q) }` is rejected at the `use`.
  //
  // The BARRIER below is for the other direction: a narrowing established OUTSIDE
  // this loop gets no re-test, so a write in the body would leave the reads before
  // it reading a stale fact on the next iteration. Those writes keep their reject.
  //
  // TWO KINDS OF FACT ARE FILTERED OUT, and each has its own reason.
  //
  // ONLY A NULL STRIP, never an `is T` variant pin. The write contract above is what
  // makes a strip free: the one assignment it forbids is the one that would falsify it.
  // A variant pin costs something real — it would reject the assignment that FLIPS the
  // variant, and that is how a loop over a union terminates
  // (`while x is i64 { … x = true }`, `unions/paren-is-narrow.vl`, which this rejected
  // until the filter went in). The test is the same one the post-guard narrowing already
  // uses: the fact equals the place's type with `null` peeled off.
  //
  // PROPERTY PATHS (`o.v`) ARE EXCLUDED. They are not a scope-shadowed binding
  // but an overlay keyed by path string, and nothing re-points the WRITE side at
  // the declaration for them, so a path fact can be falsified inside the body
  // through any alias of the object — a call taking the struct clears the field
  // and the fact survives. That hole is reachable in an `if` arm today (a
  // narrowed `o.v` read after such a call is check-clean and traps or reads a
  // stale value), so extending path narrowing to a loop body would only widen
  // it. Bare names have no aliasing: a local is the only name for its slot.
  const wnNames: string[] = []
  const wnTys: i32[] = []
  collectThenNarrows(n.whileCond, wnNames, wnTys)
  const wbNames: string[] = []
  const wbTys: i32[] = []
  let wi = 0
  while wi < wnNames.length {
    if !isPathKey(wnNames[wi]) {
      if wnTys[wi] == nonNullTy(lookup(wnNames[wi])) {
        wbNames.push(wnNames[wi])
        wbTys.push(wnTys[wi])
      }
    }
    wi = wi + 1
  }
  pushReBarrier()
  if wbNames.length > 0 {
    pushScope(-1)
    applyNarrows(wbNames, wbTys)
  }
  checkNode(n.whileBody)
  if wbNames.length > 0 { popScope() }
  popReBarrier()
  daRestore(daLoopEntry)
  return TY_VOID
}
// ── for range ──────────────────────────────────────────────────────────────
// Extracted from `checkNodeReal`'s `ForRange` arm (C3: thin the dispatcher).
function checkForRangeNode(n: ForRange, ix: i32) {
  const frFrom = checkNode(n.frFrom)
  const frTo = checkNode(n.frTo)
  if !assignable(frFrom, TY_I32) || !assignable(frTo, TY_I32) {
    tErr(
      "for-range bounds must be i32, got " +
        tyToStr(frFrom) +
        " and " +
        tyToStr(frTo),
      ix,
    )
  }
  if n.frStep >= 0 {
    const frStep = checkNode(n.frStep)
    if !assignable(frStep, TY_I32) {
      tErr("for-range step must be i32, got " + tyToStr(frStep), ix)
    }
    // A range `for` with a LITERAL `step 0` never advances its loop variable —
    // a degenerate / infinite loop. Catch only a literal integer 0 (a negative
    // step parses as a Unary wrapping the NumLit, and a runtime-0 step is not
    // statically known, so neither is matched here).
    const stepNode = P.nodes[n.frStep]
    if stepNode is NumLit {
      if stepNode.numText == "0" { tErr("`for` step is 0", n.frStep) }
    }
  }
  // A `for` body re-executes with no condition to re-establish anything, so every
  // narrowing live here predates it — see `pushReBarrier`.
  pushReBarrier()
  pushScope(ix)
  declare(n.frVar, TY_I32)
  if symEnabled != 0 { symDecl(n.frVar, ix, TY_I32, 0) }
  // Loop body may run zero times — see `WhileStmt` (A-definite-assign).
  const daFrEntry = daSnapshot()
  // The loop variable is always assigned in the body; clear it from the dead-zone
  // so a body read isn't flagged when the loop var SHADOWS a still-uninitialized
  // module global of the same name (the `daRestore` below preserves that global's
  // TDZ for any post-loop read).
  daMarkAssigned(n.frVar)
  checkNode(n.frBody)
  daRestore(daFrEntry)
  popScope()
  popReBarrier()
  return TY_VOID
}
// ── for v in iterable ───────────────────────────────────────────────────────
// A for-in loop over an array: the loop variable binds to the element type.

// Extracted from `checkNodeReal`'s `ForIn` arm (C3: thin the dispatcher).
function checkForInNode(n: ForIn, ix: i32) {
  const iterTy = checkNode(n.fiIter)
  let elemTy = TY_ERR
  const it = T.tys[iterTy]
  if it is TyArray {
    elemTy = it.aElem
  } else if it is TyMap {
    // `for k in m` over a map / set iterates its KEYS (the key type) — like
    // `for k in m.keys()`.
    elemTy = it.mKey
  } else if isStringTy(iterTy) {
    // `for ch in s` iterates a STRING's code units — each an i32, exactly as `s[i]`
    // reads one. A string IS the raw i32 array at the wasm level, so this rides the
    // same element-iteration machinery as an `i32[]`.
    elemTy = TY_I32
  } else if it is TyErr {
    elemTy = TY_ERR
  } else {
    tErr("for-in expects an array or map, got " + tyToStr(iterTy), ix)
  }
  // See ForRange: a `for` body re-executes with nothing to re-establish a narrowing.
  pushReBarrier()
  pushScope(ix)
  declare(n.fiVar, elemTy)
  if symEnabled != 0 { symDecl(n.fiVar, ix, elemTy, 0) }
  // Loop body may run zero times — see `WhileStmt` (A-definite-assign).
  const daFiEntry = daSnapshot()
  // See ForRange: clear the loop var from the dead-zone for the body so it can't
  // collide with a shadowed, still-uninitialized module global of the same name.
  daMarkAssigned(n.fiVar)
  checkNode(n.fiBody)
  daRestore(daFiEntry)
  popScope()
  popReBarrier()
  return TY_VOID
}
// ── return ─────────────────────────────────────────────────────────────────

// Extracted from `checkNodeReal`'s `RetStmt` arm (C3: thin the dispatcher).
function checkRetStmtNode(n: RetStmt, ix: i32) {
  const want = T.curRet
  if n.retArg < 0 {
    if want >= 0 && !assignable(TY_VOID, want) {
      tErr("return needs a value of type " + tyToStr(want), ix)
    }
    return TY_VOID
  }
  // Under a PENDING return type (-2: this function's return is being inferred),
  // record the returned type as a witness instead of checking a mismatch.
  if want == -2 {
    // `return <expr>` is always a value return position.
    fnSawValueRet = true
    // A returned CALL whose deferred join this site could not decide contributes the
    // WHOLE join, not the lossy collapse the emitter gets (`inferRetTyOf`).
    const rArgTy = checkNode(n.retArg)
    // `return <void call>` names a value to return and has none. Reported here rather
    // than left to the mismatch check below, which never sees this path (the return type
    // is still being inferred) — and which passes even when it does, because
    // `assignable(void, void)` holds under an explicit `: void`. A void body still
    // returns from a BARE `return`, or by ending in the call as a statement.
    if voidValueSlotErr(rArgTy, n.retArg, "return", ix) { return TY_VOID }
    noteInferredRet(inferRetTyOf(n.retArg, rArgTy))
    return TY_VOID
  }
  // Bidirectional: `function mk(): (i32) => i32 { return (x) => … }` infers the returned
  // lambda's param from the declared return type (also through a composite return shape).
  if want >= 0 { seedExpected(n.retArg, want) }
  const got = checkNode(n.retArg)
  // The same gate under an explicit `: void`, the one RESOLVED return type the mismatch
  // check below cannot catch it with: `assignable(void, void)` holds, so the void flowed
  // into a module with nothing on the stack to return. Every other declared return type
  // already reports it as its own mismatch ("expected i32, got void"), naming what the
  // annotation asked for — a strictly better message, so this gate stays out of its way.
  if isVoidTy(want) {
    if voidValueSlotErr(got, n.retArg, "return", ix) { return TY_VOID }
  }
  // Redundant-return rule: witness the explicit return's NATURAL type (before
  // constrainEmpty); an annotation-influenced return disqualifies the function.
  if retInfluencedByAnnot(n.retArg) { retNaturalErr = true }
  noteNaturalRet(got)
  // An explicit `return inner` of an empty collection pins its element from the
  // declared return type — usage-driven inference clearing the floor.
  constrainEmpty(got, want)
  if want >= 0 && !assignableExpr(n.retArg, got, want) {
    tErr(
      "return type mismatch: expected " + tyToStr(want) + ", got " + tyToStr(got),
      ix,
    )
  }
  return TY_VOID
}
// ── block ─────────────────────────────────────────────────────────────────

// Extracted from `checkNodeReal`'s `Block` arm (C3: thin the dispatcher).
function checkBlockNode(n: Block, ix: i32) {
  pushScope(ix)
  const stmts = n.blkStmts
  const savedRTP = retTailPos
  let tailTy = TY_VOID
  let i = 0
  while i < stmts.length {
    // Only the LAST statement is the block's value (and inherits tail position); the
    // rest are not the block's value, so they never carry the return tail.
    if i == stmts.length - 1 {
      retTailPos = savedRTP
    } else {
      retTailPos = false
    }
    const sty = checkNode(stmts[i])
    if i == stmts.length - 1 {
      // A value-producing trailing expression is the block's value; a trailing
      // STATEMENT (return / let / assignment / loop) leaves the block valueless.
      if !isStmtNode(stmts[i]) {
        tailTy = sty
      } else {
        // An if-EXPRESSION tail (`{ … if c { v1 } else { v2 } }`) IS the block's value, even
        // though an `IfStmt` is otherwise a statement node — `checkNode` already returned the
        // arms' join (`joinTys`). Non-void only for a genuine value-`if` WITH an else (a
        // statement-`if`/else-less tail stays valueless), so a nested if-expression as an
        // if-expression ARM (`if c { if d { 1 } else { 2 } } else { 3 }`) types as a value.
        const lastN2 = P.nodes[stmts[i]]
        if lastN2 is IfStmt {
          if lastN2.ifElse >= 0 {
            if sty != TY_VOID && sty != TY_ERR { tailTy = sty }
          }
        }
      }
    }
    i = i + 1
  }
  retTailPos = savedRTP
  popScope()
  blockTailTy = tailTy
  return TY_VOID
}
