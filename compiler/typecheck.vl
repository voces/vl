// ── arena-mutation generations (the emit-side `repOf` memo invalidation) ─────

// ── constraints phase 1: the bound environment and the coherence ledger ──────

// The join of two types a place may hold after an `if`. A place holds a member of its declared
// type, so a numeric member is never absorbed by one it widens to: `i32` and `f64` join to
// `i32 | f64`, not `f64`, which is how the value is stored (D2627). Otherwise `joinTys`.
function narJoinTys(a: i32, b: i32): i32 {
  if a < 0 || b < 0 { return joinTys(a, b) }
  if numericVariantUncovered(a, b) || numericVariantUncovered(b, a) {
    return joinVariantTys(a, b)
  }
  joinTys(a, b)
}

// The type a place holds after ledger row `i` on the arm whose own statement depth is `ownDepth`:
// a row at that depth runs whenever the arm does and replaces `cur`; a deeper one is conditional,
// so the two join (D1846).
function narFoldRow(cur: i32, i: i32, ownDepth: i32): i32 {
  // A kill (a call or alias that may write, an unkeyable write) leaves the place unknown, which
  // only a later write at the arm's own depth replaces.
  if narClobRetired[i] == 2 { return NAR_UNKNOWN }
  if narClobDepths[i] == ownDepth { return narClobTys[i] }
  if cur == NAR_UNKNOWN { return NAR_UNKNOWN }
  narJoinTys(cur, narClobTys[i])
}

// What each place key holds here, parallel to `keys`: the arm join's start for a path through an
// `if` that carries no condition fact about it. -1 where the key does not resolve.
function narKeysNowTys(keys: string[]): i32[] {
  const out: i32[] = []
  let i = 0
  while i < keys.length {
    out.push(narKeyNowTy(keys[i]))
    i = i + 1
  }
  out
}

// What the place `key` reads at here: a bare name's binding, a path's live overlay, else its
// field or cell type off the prefix it hangs from.
function narKeyNowTy(key: string): i32 {
  if !isPathKey(key) { return lookup(key) }
  const ov = narrowedPathTy(key)
  if ov >= 0 { return ov }
  const steps = keySteps(key)
  if steps.length == 0 { return -1 }
  const pres = keyStepPrefixTys(key, steps)
  const last = steps.length - 1
  const pt = pres[last]
  if pt < 0 { return -1 }
  if steps[last][0] == '.' {
    return placeFieldTy(pt, steps[last].slice(1, steps[last].length), false)
  }
  placeElemTy(pt)
}

// What `key` read at the head of the `if` behind `f`: its type now with every in-place write
// since then undone, then redone. -1 where the key does not resolve.
function narHeadTy(f: IfChk, key: string): i32 {
  let j = narIpAt.length - 1
  while j >= f.ipMark {
    narIpApply(f, j, true)
    j = j - 1
  }
  const t = narKeyNowTy(key)
  j = f.ipMark
  while j < narIpAt.length {
    narIpApply(f, j, false)
    j = j + 1
  }
  t
}

// The flow-narrowing join at the end of an `if` (DECISIONS.md, "Flow narrowing: per-path facts
// meet at joins"). Each path through the `if` starts at the condition's fact for a key, or at its
// entry type, and folds its arm's ledger rows; the key reads at the meet of the surviving paths
// below the `if`. `sum*` receives one summary row per key joined, for `narCompactIf`.
function applyArmJoins(
  f: IfChk,
  elseHi: i32,
  thenDiverges: boolean,
  elseDiverges: boolean,
  condIx: i32,
  sumKeys: string[],
  sumTys: i32[],
  sumPrev: i32[],
  sumRet: i32[],
) {
  // Both arms diverging leaves no code below to describe.
  if thenDiverges && elseDiverges { return 0 }
  const ix = f.ifIx
  const keys: string[] = []
  const slot: {[string]: i32} = Map()
  const kEnt: i32[] = []
  const kThen: i32[] = []
  const kElse: i32[] = []
  const kCond: boolean[] = []
  const kOk: boolean[] = []
  const kRet: i32[] = []
  const kElseSeen: boolean[] = []
  // One pass over the subtree's rows, in order, folding each into its key's two paths.
  let i = f.clobMark
  const end = narClobKeys.length
  while i < end {
    const nm = narClobKeys[i]
    if narClobHits(i, nm) {
      let k = slot[nm] ?? -1
      if k < 0 {
        k = keys.length
        slot[nm] = k
        keys.push(nm)
        // A key the condition tests starts each arm at that arm's fact, from the entry the head
        // saw. Any other key enters both arms at what it held on entry, which a row inside an
        // arm's own narrowing cannot tell (D4198).
        const ti = strListLastIx(f.tnNames, nm)
        const ei = strListLastIx(f.enNames, nm)
        let ent = narHeadTy(f, nm)
        if ent < 0 { ent = narClobPrev[i] }
        let ts = ent
        let es = ent
        const cond = ti >= 0 || ei >= 0
        if cond {
          if ti >= 0 { ent = f.tnEnt[ti] } else { ent = f.enEnt[ei] }
          ts = ent
          es = ent
          if ti >= 0 { ts = f.tnTys[ti] }
          if ei >= 0 { es = f.enTys[ei] }
        }
        kEnt.push(ent)
        kThen.push(ts)
        kElse.push(es)
        kCond.push(cond)
        // A condition fact over a path one arm leaves is the post-guard rule's, not this join's.
        kOk.push(
          ent >= 0
            && !crCondRetired(condIx, nm)
            && !(cond && (thenDiverges || elseDiverges)),
        )
        kRet.push(0)
        kElseSeen.push(false)
      }
      // A call that can write the place leaves it unknown, and a merged entry would hand the
      // fact back (D1849).
      const r = narClobRetired[i]
      if r == 1 { kRet[k] = 1 }
      if i < f.thenLo {
        // A write in the condition may or may not have run on either path.
        if kCond[k] || r == 2 {
          kOk[k] = false
        } else {
          kThen[k] = narJoinTys(kThen[k], narClobTys[i])
          kElse[k] = narJoinTys(kElse[k], narClobTys[i])
        }
      } else if i < f.thenHi {
        kThen[k] = narFoldRow(kThen[k], i, f.thenOwnDepth)
      } else if i >= f.elseLo && i < elseHi {
        kElse[k] = narFoldRow(kElse[k], i, f.elseOwnDepth)
        kElseSeen[k] = true
      }
    }
    i = i + 1
  }
  let k = 0
  while k < keys.length {
    const nm = keys[k]
    // This pass's answer replaces an earlier check's, which may have been at other types.
    narIfEnds[i32ToStr(ix) + "#" + nm] = -1
    // A path fact over a type variable or a hole meets per instance, and the join is banked
    // once per node, so such a key keeps the type the arms left it at (D3286).
    if tyHasHole(kEnt[k]) || tyHasHole(kThen[k]) || tyHasHole(kElse[k]) {
      kOk[k] = false
    }
    if kOk[k] {
      // An `else if` link has no block of its own: its end type is its own chain's join,
      // which counts the path where none of its arms ran (D2627).
      let chainEnd = -1
      if kElseSeen[k] { chainEnd = narChainEndTy(ix, nm) }
      let jt = -1
      // No else arm is still a path through the `if`: the fall-through, at the else fact.
      let ee = kElse[k]
      if chainEnd >= 0 { ee = chainEnd }
      const te = kThen[k]
      // A kill on any surviving path survives the meet.
      if thenDiverges {
        if ee != NAR_UNKNOWN { jt = ee }
      } else if elseDiverges {
        if te != NAR_UNKNOWN { jt = te }
      } else if ee != NAR_UNKNOWN && te != NAR_UNKNOWN {
        // The ELSE side first, so a one-armed join renders in the declaration's own order
        // (`i64 | boolean`, not `boolean | i64`) — the diagnostic below reads it.
        jt = narJoinTys(ee, te)
      }
      narNoteChainEnd(ix, nm, jt)
      if jt >= 0 {
        sumKeys.push(nm)
        sumTys.push(jt)
        sumPrev.push(kEnt[k])
        sumRet.push(kRet[k])
        // A chain link's code below is its parent's, which joins it through `chainEnd`. An
        // `if` in value position installs when its statement ends, the boundary the
        // emitter's push follows, and only as that statement's whole value.
        if !f.isElseArm {
          if narIfIsStmt(ix) {
            narInstallJoin(ix, nm, jt, chainEnd >= 0)
          } else {
            narDeferJoin(ix, nm, jt, chainEnd >= 0)
          }
        }
      }
    }
    k = k + 1
  }
  0
}

// Install the joins held for statement `st`, which has just been checked.
function narApplyDeferred(st: i32) {
  while narDefStmt.length > 0 && narDefStmt[narDefStmt.length - 1] == st {
    const k = narDefStmt.length - 1
    narInstallJoin(st, narDefKey[k], narDefTy[k], narDefChain[k])
    narDefStmtPop()
    narDefKeyPop()
    narDefTyPop()
    narDefChainPop()
  }
  0
}

// Install the join `jt` of `key` for the code below the `if` at `ix`, in the block holding the
// `if` — the lifetime the emitter's push after the statement has — and bank it for that push.
function narInstallJoin(ix: i32, key: string, jt: i32, viaChain: boolean) {
  if isPathKey(key) {
    // Against what the path reads at now, not at entry: an arm's write may have retired the
    // entry narrowing in place. A retired innermost entry is replaced even by an equal join, so
    // the reads and writes below resolve through a live one (D3316).
    const inner = narrowedPathIx(key)
    const retired = inner >= 0 && narrowedPathTyRaw(key) < 0
    if jt != narKeyNowTy(key) || retired {
      npKeysPush(key)
      npTysPush(jt)
      npInvByPush(-1)
      npEpochsPush(narFnEpoch)
      npSettlePush(-2)
      npCapByPush(-1)
      npAsgPush(0)
      recordArmJoin(ix, key, jt)
    }
    return 0
  }
  const cur = lookup(key)
  if cur >= 0 && jt != cur {
    // Banked like the post-guard fall-through, so a write below is checked against storage
    // and a call that may write the name ends it (D2390).
    noteNarShadow(key, cur, NAR_KIND_POSTGUARD)
    declare(key, jt)
    narFitCompanions(key, cur, jt)
    recordArmJoin(ix, key, jt)
  } else if viaChain {
    // The `else if` chain's join reaches the emitter only at this statement (D2627).
    recordArmJoin(ix, key, jt)
  }
  0
}

// Retire in place every narrowing layer of `name` in the current function, inside the loop
// barrier, that does not admit `now`, the type the write left it at: each reads `store` after.
function narRetireLayers(name: string, now: i32, store: i32) {
  const ds = scopeDepthsOf[name]
  if ds == null { return 0 }
  const base = crFnBase()
  let bar = 0
  if reScopeBases.length > 0 { bar = reScopeBases[reScopeBases.length - 1] }
  let j = ds.length - 1
  while j >= 0 {
    const d = ds[j]
    if d < base || d < bar || crFirstBank(name, d) < 0 { return 0 }
    const t = T.scopes[d][name] ?? -1
    if t >= 0 && !assignable(now, t) { narSetScope(d, name, store) }
    j = j - 1
  }
  0
}

// The type a write of a value typed `rt` leaves a narrowed name at: the member of `store` it
// re-narrows to, or `pre`, what the name held, when the write names no single member and `pre`
// admits it. `store` when neither holds.
function writeNarrowAfter(store: i32, pre: i32, rt: i32): i32 {
  const rn = writeMemberTy(store, rt)
  if rn == store && rt >= 0 && pre >= 0 && writeLandsWithin(store, rt, pre) {
    return pre
  }
  rn
}

// Re-derive every pending `??` over the hole `ty`, now that its inner is known. Runs at the fill,
// the first moment the answer exists, and validates as much as it re-banks: the read is already
// checked against `given`, so a fill whose inner does not fit is a disagreement to name, not to
// bank over. The derivation is the `??` arm's own tail, re-asked through `assignableExpr`.
function fillCoalHoleNodes(ty: i32) {
  let i = 0
  while i < chPendNodes.length {
    if chPendTys[i] == ty {
      const cn = chPendNodes[i]
      const nd = P.nodes[cn]
      if nd is BinExpr {
        const inner = nonNullTy(ty)
        const dft = nodeTyIxOf(nd.binRight)
        let res = inner
        if dft >= 0 {
          if !assignableExpr(nd.binRight, dft, inner) {
            res = joinTys(inner, dft)
          }
        }
        const given = chPendGiven[i]
        if assignable(res, given) {
          if cn < nodeTyIx.length { nodeTySet(cn, res) }
        } else {
          tErr(
            "`??` here was typed "
              + tyToStr(given)
              + " — the assignment below makes the binding "
              + tyToStr(ty)
              + ", so the read is "
              + tyToStr(res)
              + "; annotate the binding",
            cn,
          )
        }
      }
    }
    i = i + 1
  }
  0
}

// The type an open container slot takes from its first write `vt`: the literal-widened value,
// or for a bare `null` a fresh open `_ | null` recorded against the write `at` (D2506).
function cnhPinTy(
  vt: i32,
  at: i32,
  recv: i32,
  isVal: boolean,
  demand: boolean,
): i32 {
  if !isNullTy(vt) { return widenLitTy(vt) }
  const h = mkNullableTy(-1)
  cnhTys.push(h)
  cnhAts.push(at)
  let nm = ""
  if recv >= 0 { nm = placeKeyOf(recv) }
  cnhNames.push(nm)
  cnhIsVal.push(isVal)
  cnhDemand.push(demand)
  h
}

// Fill the open container null hole `slot` from a write or destination of type `vt`: its
// non-null part becomes `T`, as the `=` arm fills a `let x = null`. A no-op on any other slot.
function cnhFill(slot: i32, vt: i32) {
  if vt < 0 || vt == TY_ERR || vt == TY_VOID { return 0 }
  if !cnhIsOpen(slot) { return 0 }
  if nhOpen(vt) { return nhLink(slot, vt) }
  let inner = vt
  const v = T.tys[vt]
  if v is TyNullable { inner = v.nInner }
  if inner < 0 || isNullTy(inner) { return 0 }
  nhFillLinked(slot, widenLitTy(inner))
}

// Fill the open null hole `h` with `inner` in place, and every hole linked to it. A hole already
// filled stops the walk, which is what bounds it.
function nhFillLinked(h: i32, inner: i32) {
  const t = T.tys[h]
  if t is TyNullable {
    if t.nInner >= 0 { return 0 }
    t.nInner = inner
    tyMutEpoch = tyMutEpoch + 1 // a null hole filled in place
    fillCoalHoleNodes(h)
  } else {
    return 0
  }
  let i = 0
  while i < nhLinkA.length {
    if nhLinkA[i] == h { nhFillLinked(nhLinkB[i], inner) }
    if nhLinkB[i] == h { nhFillLinked(nhLinkA[i], inner) }
    i = i + 1
  }
  0
}

// Refuse a call to a generic or hole-parameter function that passes a container whose element
// or value is still an open `_ | null`: the instance is chosen here, before `T` exists, and a
// later fill cannot reach it (D2506).
function refuseOpenNullHoleArg(argIx: i32, who: string) {
  if argIx < 0 { return 0 }
  const seen: i32[] = []
  if !tyHoldsOpenNullHole(nodeTyIxOf(argIx), seen) { return 0 }
  let nm = placeKeyOf(argIx)
  if nm == "" { nm = "this argument" } else { nm = "`" + nm + "`" }
  let what = "the element type of "
  const at = T.tys[nodeTyIxOf(argIx)]
  if at is TyMap { what = "the value type of " }
  let callee = "this call"
  if who != "" { callee = "`" + who + "`" }
  tErr(
    what
      + nm
      + " is still open here — fill or annotate it before passing it to "
      + callee,
    argIx,
  )
  0
}

// Usage-driven inference through a typed context: an empty `[]` / bare `Map()`/`Set()` flowing
// into a slot with a concrete shape (a `T[]` param at a call site, an annotated assignment, a
// `T[]`-returning tail) has its open holes pinned to the destination's, in place. A no-op
// unless the shapes match. Depth-bounded: a recursive struct would otherwise recur forever.
function constrainEmpty(srcTy: i32, dstTy: i32) {
  constrainEmptyD(srcTy, dstTy, 12)
}

// `constrainEmpty` at a position that holds the source expression — the form every site that
// pins and then asks `assignableExpr` must use. The pin erases its own trigger, since
// `recordRepTyAdopt` records a literal's destination rep only while `tyReachesEmptyHole` holds,
// so the recording happens on that same condition and before the pin.
function constrainEmptyExpr(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if !inferQuiet && srcExpr >= 0 && tyReachesEmptyHole(srcTy, 8) {
    recordRepTyAdopt(srcExpr, dstTy, 6)
  }
  constrainEmpty(srcTy, dstTy)
}

// Pin every delivery this body recorded against the shape a concrete return witness named, and
// retire the frame. With no such witness nothing is pinned — the program never said what the
// element type is, so the binding keeps its own `cannot infer a type` floor (D1591).
function flushInferRetHoles() {
  if irhMarks.length == 0 { return 0 }
  const top = irhMarks.length - 1
  const mark = irhMarks[top]
  const dst = irhConcrete[top]
  irhMarks.pop()
  irhConcrete.pop()
  let i = mark
  while i < irhTys.length {
    if dst >= 0 { constrainEmptyExpr(irhExprs[i], irhTys[i], dst) }
    i = i + 1
  }
  while irhTys.length > mark {
    irhExprs.pop()
    irhTys.pop()
  }
  0
}

// The inferred return `observed` of the body whose witness frame is on top, re-typed f32 when
// some witness is an f32 value and every other is a float literal, as an
// `if` join does (`joinF32LitTails`). Retires the frame whether or not it re-types.
function inferRetF32Join(inferring: boolean, observed: i32): i32 {
  if irwMarks.length == 0 { return observed }
  const mark = irwMarks[irwMarks.length - 1]
  irwMarks.pop()
  let res = observed
  if (
    inferring
    && observed >= 0
    && primNameOf(observed) != "f32"
    && f32JoinRetypesRunning()
  ) {
    const fTy = inferRetF32Of(mark)
    if fTy >= 0 { res = fTy }
  }
  while irwExprs.length > mark {
    irwExprs.pop()
    irwTys.pop()
  }
  res
}

// The f32 type the witnesses from `mark` on join to when they are f32 values and literals.
function inferRetF32Of(mark: i32): i32 {
  const es: i32[] = []
  const ts: i32[] = []
  let i = mark
  while i < irwExprs.length {
    const t = irwTys[i]
    // A value-less or diverging path delivers nothing to the join.
    if t != TY_VOID && primNameOf(t) != "never" {
      es.push(irwExprs[i])
      ts.push(t)
    }
    i = i + 1
  }
  f32LitJoinOf(es, ts)
}

// The f32 type a join of the values `exprs`, typed `tys`, takes when some are f32 values and
// every other is a float literal or a join of them (`floatLitTails`); else -1. The
// literals' `if` and `match` nodes are re-typed f32 only when the whole join qualifies.
function f32LitJoinOf(exprs: i32[], tys: i32[]): i32 {
  // The common join has no f32 member; it is answered by type tests alone.
  let j = 0
  while j < tys.length && primNameOf(tys[j]) != "f32" { j = j + 1 }
  if j == tys.length { return -1 }
  let fTy = -1
  let lits = 0
  const savedQuiet = inferQuiet
  inferQuiet = true
  let i = 0
  while i < exprs.length && lits >= 0 {
    if primNameOf(tys[i]) == "f32" { fTy = joinTys(fTy, tys[i]) }
    else if floatLitTails(exprs[i]) { lits = lits + 1 }
    else { lits = -1 }
    i = i + 1
  }
  inferQuiet = savedQuiet
  if lits <= 0 || fTy < 0 || primNameOf(fTy) != "f32" { return -1 }
  if !inferQuiet {
    let k = 0
    while k < exprs.length {
      if primNameOf(tys[k]) != "f32" { f32LitTailsAdopt(exprs[k], TY_F32) }
      k = k + 1
    }
  }
  fTy
}

function constrainEmptyD(srcTy: i32, dstTy: i32, depth: i32) {
  if srcTy < 0 || dstTy < 0 || depth <= 0 { return 0 }
  const s = T.tys[srcTy]
  const d = T.tys[dstTy]
  // A container null hole delivered to a nullable slot takes the slot's `T` (D2506).
  if d is TyNullable {
    if d.nInner >= 0 && cnhIsOpen(srcTy) { return cnhFill(srcTy, dstTy) }
  }
  // A nullable destination pins the same holes its inner shape does: a `string[] | null` field
  // or map value accepts a non-null `[]`, and the hole behind it needs the element rep either
  // way. Unwrapped on the source side too, so a nullable producer flowing into a nullable slot
  // lines its inner shapes up rather than stopping at the wrapper.
  if d is TyNullable { return constrainEmptyD(srcTy, d.nInner, depth - 1) }
  if s is TyNullable { return constrainEmptyD(s.nInner, dstTy, depth - 1) }
  // An open `[]` delivered to a union is built as its first list member, the arm
  // `recordRepTyAdopt` records for a literal, so a call returning one pins the same way.
  if s is TyArray {
    if s.aElem < 0 {
      if d is TyUnion {
        let ui = 0
        while ui < d.uMembers.length {
          const um = T.tys[d.uMembers[ui]]
          if um is TyArray {
            return constrainEmptyD(srcTy, d.uMembers[ui], depth - 1)
          }
          ui = ui + 1
        }
        return 0
      }
    }
  }
  if s is TyArray {
    if d is TyArray {
      if s.aElem < 0 {
        // Both sides open is not a pin but a link — `s.aElem = d.aElem` would write the `-1`
        // back and lose the fact that these two rows must agree, which `arrDefHoleToI32` needs
        // once an unpinned hole acquires a default. D1470.
        if d.aElem < 0 {
          noteHoleLink(srcTy, dstTy)
        } else {
          s.aElem = d.aElem
          tyMutEpoch = tyMutEpoch + 1 // in-place element pin — canonical keys change
        }
      } else {
        constrainEmptyD(s.aElem, d.aElem, depth - 1)
      }
    }
    return 0
  }
  if s is TyMap {
    if d is TyMap {
      if s.mKey < 0 {
        s.mKey = d.mKey
        tyMutEpoch = tyMutEpoch + 1 // in-place key pin
      }
      if s.mVal < 0 {
        s.mVal = d.mVal
        tyMutEpoch = tyMutEpoch + 1 // in-place value pin
      } else {
        constrainEmptyD(s.mVal, d.mVal, depth - 1)
      }
    }
    return 0
  }
  // A struct destination pins field-wise, by name. The source is an object literal's own
  // inferred shape, so its field order is the literal's, not the declaration's — matching
  // positionally would pin `{ b: fq(), a: [1] }` from the wrong field.
  if s is TyObj {
    if d is TyObj {
      let i = 0
      while i < s.objFieldNames.length {
        if i < s.objFieldTypes.length {
          const dft = objFieldType(d, s.objFieldNames[i])
          if dft >= 0 { constrainEmptyD(s.objFieldTypes[i], dft, depth - 1) }
        }
        i = i + 1
      }
    }
    return 0
  }
  0
}

// D1470 — an `__array_new_default__` hole that nothing pinned, defaulted to `i32` in place;
// false for every other unresolved hole. `array.new_default` promises the element's zero and
// says nothing about which element, so `i32` is honest here where `const xs = []` is not.
// Asked from `flushUninferred`, after every pin has had its chance.
function arrDefHoleToI32(ty: i32) {
  if !arrDefRowIsCall(ty) { return false }
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem < 0 {
      arrDefPinHoleElem(ty)
      return true
    }
  }
  false
}

// D1566 — an operator operand cannot wait for the flush, so it peeks the default rather than
// taking it. Every other position tolerates the in-band `-1` an unpinned element reads back as,
// but the operator arms index `T.tys` with the operand type and `T.tys[-1]` traps the compiler.
// Peeking leaves the row open, so a later store can still decide the element.
function arrDefOperandElemPeek(exprIx: i32) {
  if exprIx < 0 { return -1 }
  let cur = exprIx
  let hops = 0
  while hops < 4 {
    const p = P.nodes[cur]
    if p is Paren {
      cur = p.parInner
      hops = hops + 1
    } else {
      hops = 4
    }
  }
  const e = P.nodes[cur]
  if e is Index {
    const at = nodeTyIxOf(e.idxArr)
    if at < 0 { return -1 }
    const t = T.tys[at]
    if t is TyArray {
      if t.aElem < 0 {
        if arrDefRowServed(at) {
          // The element `arrDefPinHoleElem` would write, read without writing this row: the
          // same link fixpoint it runs (`resolveHoleLinks` propagates only an element some pin
          // already decided, never a default), then `i32` if nothing reached the row.
          resolveHoleLinks()
          const t2 = T.tys[at]
          let el = TY_I32
          if t2 is TyArray {
            if t2.aElem >= 0 { el = t2.aElem }
          }
          // The read's own recorded type, not the row's: `checkNode` banked the `-1` this read
          // answered a moment ago and the emitter reads that, so a stale entry makes
          // `print(a[0] ?? 1)` refuse at emit. The row stays open, so a later store re-decides
          // it.
          if !inferQuiet {
            if cur < nodeTyIx.length { nodeTySet(cur, el) }
          }
          return el
        }
      }
    }
  }
  -1
}

// Pin `asgOpenElemRow`'s open element from a store's value type `vt` when `exprIx` reads that same
// row, and answer the element's value type; -1 when it is some other read. A store whose value
// reads the place it writes (`xs[i] += v`, or that spelled out) has no other moment to pin: the
// read answers `-1`, the operator floor turns that into `TY_ERR`, and the store banks it. D1603.
function asgReadElemPin(exprIx: i32, vt: i32) {
  if asgOpenElemRow < 0 || exprIx < 0 { return -1 }
  if vt < 0 || vt == TY_ERR || vt == TY_VOID { return -1 }
  if tyHasHole(vt) { return -1 }
  const e = P.nodes[exprIx]
  if e is Index {
    if nodeTyIxOf(e.idxArr) != asgOpenElemRow { return -1 }
    const t = T.tys[asgOpenElemRow]
    if t is TyArray {
      if t.aElem >= 0 { return -1 }
      t.aElem = widenLitTy(vt)
      tyMutEpoch = tyMutEpoch + 1 // the store's own value pinned the element in place
      const el = arrElemValueTy(vt)
      // The read's recorded type too, for `arrDefOperandElemPeek`'s reason: `checkNode` banked
      // the `-1` a moment ago and the emitter reads that entry.
      if !inferQuiet {
        if exprIx < nodeTyIx.length { nodeTySet(exprIx, el) }
      }
      return el
    }
  }
  -1
}

// D1512 — the one place an unpinned intrinsic hole acquires its element: whatever the link graph
// can still reach (`resolveHoleLinks`, run first), else the `i32` default. Returns the row's
// element after the pin, or -1 when the row is not an array. Both sites that default such a hole
// go through here, so an intrinsic delivered into a plain `v = …` cannot take `i32` on its own.
export function arrDefPinHoleElem(ty: i32) {
  if ty < 0 { return -1 }
  resolveHoleLinks()
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem < 0 {
      // A literal-union element is stored at its base primitive, whose zero the intrinsic
      // writes; the `i32` default only when no callee wrote the row.
      let el = litMembersBaseTy(calleeWrittenElem(ty))
      if el < 0 { el = TY_I32 }
      t.aElem = el
      tyMutEpoch = tyMutEpoch + 1 // in-place element pin — canonical keys change
    }
    return t.aElem
  }
  -1
}

// The element a hole callee's first write gives an open list row handed to it as a binding,
// directly or through a chain of hole links, or -1 when no callee wrote it (D3746).
function calleeWrittenElem(ty: i32): i32 {
  if calleeWriteRow.length == 0 { return -1 }
  const rows = holeLinkClosure(ty)
  let i = 0
  while i < calleeWriteRow.length {
    if i32ListHas(rows, calleeWriteRow[i]) {
      return widenLitTy(calleeWriteGot[i])
    }
    i = i + 1
  }
  -1
}

// Pin a still-open list binding at scope close to the element a hole callee's write gave it;
// false when no callee wrote it, which leaves the binding's own diagnostic standing (D3746).
function calleeWritePin(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem >= 0 { return false }
    const el = calleeWrittenElem(ty)
    if el < 0 { return false }
    t.aElem = el
    tyMutEpoch = tyMutEpoch + 1 // in-place element pin — canonical keys change
    return true
  }
  false
}

// Before a caller's write of `got` pins open list row `ty`, give the row an earlier hole callee's
// element when `got`'s element cannot hold that callee's write: the first write decides, as at
// the direct spelling, and the caller's write is checked against it. A callee write it can hold
// (a literal `1` beside a later `2.5`) leaves the caller's write to decide (D3775).
function calleeWritePrePin(ty: i32, got: i32) {
  if ty < 0 || got < 0 || calleeWriteRow.length == 0 { return 0 }
  if got == TY_ERR || tyHasHole(got) { return 0 }
  const el = widenLitTy(got)
  const rows = holeLinkClosure(ty)
  let i = 0
  while i < calleeWriteRow.length {
    if i32ListHas(rows, calleeWriteRow[i]) {
      if !assignable(calleeWriteGot[i], el) {
        calleeWritePin(ty)
        return 0
      }
    }
    i = i + 1
  }
  0
}

// D1565 — every link pair, to a fixpoint: a resolved row hands its element to its open partner
// and the sweep repeats until no row moves. A one-hop consult reads a partner that has not
// resolved yet and takes `i32` while the rest of the chain lands on `f64`. A component nothing
// pins is untouched; the bound is structural, since a sweep that changes anything pins a row.
function resolveHoleLinks() {
  if holeLinkA.length == 0 { return 0 }
  const bound = holeLinkA.length * 2 + 1
  let sweeps = 0
  let changed = true
  while changed {
    changed = false
    sweeps = sweeps + 1
    if sweeps > bound {
      // Unreachable by the bound above, and stated rather than assumed: a sweep only ever turns
      // an open element into a resolved one, never back. A named failure beats a `while` that
      // spins, since a hang is the one outcome a checker must never have.
      tErr("internal: __array_new_default__ hole links did not converge", -1)
      return 0
    }
    let i = 0
    while i < holeLinkA.length {
      if holeLinkPinFrom(holeLinkA[i], holeLinkB[i]) { changed = true }
      if holeLinkPinFrom(holeLinkB[i], holeLinkA[i]) { changed = true }
      i = i + 1
    }
  }
  0
}

// Flush every pending binding recorded at scope `depth`, called just before the scope is popped
// and for the global scope at program end. A binding whose hole is still open at this point
// will never be pinned, so it takes the unified "cannot infer a type" diagnostic.
export function flushUninferred(depth: i32) {
  flushNullHoles(depth)
  const keepN: string[] = []
  const keepT: i32[] = []
  const keepA: i32[] = []
  const keepD: i32[] = []
  let i = 0
  while i < pendNames.length {
    if pendDepths[i] == depth {
      if unresolvedHole(pendTys[i]) {
        if !arrDefHoleToI32(pendTys[i]) && !calleeWritePin(pendTys[i]) {
          tErr(
            "cannot infer a type for '"
              + pendNames[i]
              + "' — "
              + uninferredFixText(pendNames[i], pendTys[i]),
            pendAts[i],
          )
        }
      }
    } else {
      keepN.push(pendNames[i])
      keepT.push(pendTys[i])
      keepA.push(pendAts[i])
      keepD.push(pendDepths[i])
    }
    i = i + 1
  }
  pendNamesSet(keepN)
  pendTysSet(keepT)
  pendAtsSet(keepA)
  pendDepthsSet(keepD)
  0
}

// ── definite-assignment flow ─────────────────────────────────────────────────
// Check a read of `name`: if it is still unassigned on this path, report it and drop it so the
// same hole does not re-fire on every later read.
function daCheckRead(name: string, at: i32) {
  if daLive.length == 0 { return 0 }
  const sid = sidOf(name)
  if daIsUnassignedSid(sid) {
    daMarkAssignedSid(sid)
    tErr("`" + name + "` is used before it is assigned", at)
  }
  0
}

// ── the type-parameter `self` operator, banked from both ends ────────────────

// ── the pin column ───────────────────────────────────────────────────────────

// The field walk of `objRetWidenAdopt`: `litIx` is an ObjLit whose inferred `sTyIx` adopts the
// expected `dTyIx` field-wise, appending each re-encodable value node and its adopted field type
// to `recNodes`/`recTys`. False on any proven mismatch, in which case the caller keeps the
// inferred shape. Adoption is sound only where the literal body can re-encode at the wider rep.
function objLitWidenFields(
  litIx: i32,
  sTyIx: i32,
  dTyIx: i32,
  recNodes: i32[],
  recTys: i32[],
): boolean {
  const lit = P.nodes[litIx]
  if !(lit is ObjLit) { return false }
  const s = T.tys[sTyIx]
  const d = T.tys[dTyIx]
  if !(s is TyObj) { return false }
  if !(d is TyObj) { return false }
  if s.objFieldNames.length != d.objFieldNames.length { return false }
  let i = 0
  while i < d.objFieldNames.length {
    const dty = d.objFieldTypes[i]
    const sty = objFieldType(s, d.objFieldNames[i])
    if sty < 0 { return false }
    // The field's value expression in the literal body, shared by the numeric-widen and the
    // float-literal-to-f32 arms below.
    let fv = -1
    const fl = lit.objFields
    let fi = 0
    while fi < fl.length {
      const fn = P.nodes[fl[fi]]
      if fn is FieldInit {
        if fn.fiName == d.objFieldNames[i] { fv = fn.fiValue }
      }
      fi = fi + 1
    }
    if numWidens(sty, dty) {
      // The widening field's value must be a small int literal in the literal body.
      if fv < 0 { return false }
      const fvn = P.nodes[fv]
      if fvn is NumLit {
        if numLexIsFloat(fvn.numText) { return false }
        if !numLexFitsI32(fvn.numText) { return false }
        recNodes.push(fv)
        recTys.push(dty)
      } else {
        return false
      }
    } else if primNameOf(dty) == "f32" && isF32AdoptingLitExpr(fv) {
      // A literal into an f32 field (`() => ({a: 3.5, …})` against `{a: f32, …}`): the field infers
      // f64 or i32 but the literal re-encodes exactly at f32, the field dual of the scalar arm.
      // Record f32 on the value node so `anonFieldCode` interns the f32 field slot rather than
      // coding the literal's default.
      recNodes.push(fv)
      recTys.push(dty)
    } else if assignable(sty, dty) && !assignable(dty, sty) {
      // The field widens by boxing — a bare scalar or struct arm into a union or nullable field
      // (`{f: false}` against `{f: boolean | {w: i32}}`). Adopt when the literal value re-encodes
      // at the wider field type, and record that type so the emitter boxes the field slot;
      // `synthRetAnnots` then pins the lambda's `fnRet` to the whole struct shape.
      if fv < 0 { return false }
      let fvIn = fv
      let fvDone = false
      while !fvDone {
        const fvp = P.nodes[fvIn]
        if fvp is Paren { fvIn = fvp.parInner } else { fvDone = true }
      }
      const fvNode = P.nodes[fvIn]
      // The recursion targets a nested-struct destination only: an ObjLit value against a union
      // field is a member of that union, an arm rather than a field-wise widening target, and
      // descending into it refutes the whole adoption, leaving the emitter to key the outer
      // literal onto a same-field-name-set twin. A non-`TyObj` dest takes the member-flow check.
      let dtyIsObj = false
      const dtyT = T.tys[dty]
      if dtyT is TyObj { dtyIsObj = true }
      if fvNode is ObjLit && dtyIsObj {
        if !objLitWidenFields(fvIn, sty, dty, recNodes, recTys) { return false }
        recNodes.push(fvIn)
        recTys.push(dty)
      } else {
        if !assignableExpr(fv, sty, dty) { return false }
        recNodes.push(fv)
        recTys.push(dty)
      }
    } else if tyIsLitUnion(dty) {
      // A litunion field (`f: "8"` against `f: K0 = "xz" | "8"`): the body value is a bare string
      // literal that is a member of the expected literal union. It infers the softened `string`
      // but re-encodes as the litunion's i32 atom, so record the litunion field type and
      // `anonFieldCode` interns the atom slot rather than the string.
      if fv < 0 { return false }
      if !assignableExpr(fv, sty, dty) { return false }
      recNodes.push(fv)
      recTys.push(dty)
    } else {
      // A non-widening field must match exactly (mutual assignability) — a shape
      // difference beyond numeric widening is not an adoption, it is a mismatch.
      if !assignable(sty, dty) { return false }
      if !assignable(dty, sty) { return false }
    }
    i = i + 1
  }
  true
}

function objRetWidenAdopt(bodyIx: i32, inferredTy: i32, expRetTy: i32) {
  if inferredTy < 0 || expRetTy < 0 { return false }
  let u = lambdaBodyTail(bodyIx)
  if u < 0 { return false }
  let done = false
  while !done {
    const pn = P.nodes[u]
    if pn is Paren { u = pn.parInner } else { done = true }
  }
  const lit = P.nodes[u]
  if !(lit is ObjLit) { return false }
  const s = T.tys[inferredTy]
  // A nullable expected result (`() => {f: K0} | null`, spelled directly or through the
  // nullable-closure wrapper): adopt against the inner struct. The caller still adopts the full
  // nullable expected, so the lambda's `$fnsig` result keys the nullable struct exactly as the
  // annotation-side consumer does; without the unwrap the two sides key different structs.
  let expInnerTy = expRetTy
  const dn = T.tys[expRetTy]
  if dn is TyNullable { expInnerTy = dn.nInner }
  const d = T.tys[expInnerTy]
  if s is TyObj {
    if d is TyObj {
      const recNodes: i32[] = []
      const recTys: i32[] = []
      if !objLitWidenFields(u, inferredTy, expInnerTy, recNodes, recTys) {
        return false
      }
      if recNodes.length == 0 { return false }
      if !inferQuiet {
        let r = 0
        while r < recNodes.length {
          const rn = recNodes[r]
          while nodeTyIx.length <= rn { nodeTyIx.push(-1) }
          nodeTySet(rn, recTys[r])
          r = r + 1
        }
        // Rep sidecar: `nodeTyIx` above stamps the widening field values, but the top-level return
        // literal `u` keeps its naive self-inferred type, and `structIndexOfObjCtx` keys on the
        // literal node. Record the destination struct there, recursing into fields, so the rep
        // layer resolves the union-field / i64-field / nullable-niche shape the emitter builds.
        recordRepTyAdopt(u, expInnerTy, 6)
      }
      return true
    }
  }
  false
}

// ── deep `is` over a `Json` value ────────────────────────────────────────────

// The shared rejection for a definition that binds an emitter-intrinsic name. The reason half of
// the message is per-family, because the two families fail the same way for different reasons:
// the memory tier lowers to instructions, the filesystem tier to a `call` of a host import. Both
// discard the user's body, which is the part the author needs, but only one lowers inline.
function checkNotEmitterIntrinsic(name: string, at: i32) {
  // An extern name is a host import name: `emitCall` routes the call to the import, so a
  // definition of that name would never run — the same reason the fs floor is reserved. An
  // `extern let` of the name is refused once, by `checkExternGlobals`.
  if (
    name != CALLSITE_NAME
    && externLinkOf(name) >= 0
    && externGlobalLinkOfNode(at) < 0
  ) {
    tErr(
      "'"
        + name
        + "' is declared `extern` — every call to it lowers to a host import, so this definition would never run",
      at,
    )
    return 0
  }
  checkNotIntrinsicName(name, at)
}

// The name-only half of `checkNotEmitterIntrinsic`: refuses a definition spelled as a compiler
// intrinsic. Exported for the module merge, which renames every top-level declaration before
// the checker sees it and so must screen the spelling first (D2263).
export function checkNotIntrinsicName(name: string, at: i32) {
  const msg = intrinsicNameRefusal(name)
  if msg != "" { tErr(msg, at) }
  0
}

// D541 — a binary operator declared below module scope can never dispatch, the twin of the check
// directly above: a definition that would never run, refused at the definition rather than
// silently meaning something else at the site. `opSelfFnTy` resolves through `lookup(op)` and a
// nested `function "+"` binds in a node table, so this is a position rule, not a type rule.
function checkNotNestedBinOpDecl(name: string, at: i32) {
  if !isBinOpDecl(name) { return 0 }
  if isTopLevelStmt(at) { return 0 }
  tErr(
    "operator `"
      + opDeclLabelBin(name)
      + "` can never dispatch: a binary operator must be declared at MODULE SCOPE, and "
      + "this one is nested inside a function body or block — move it to the top level",
    at,
  )
  0
}

// The innermost narrowed-path overlay entry for `key`, or -1, which means either "never narrowed"
// or "narrowed and since invalidated by an aliasing write or a falsifying assignment". One
// function answers "is this narrowing in force", so the member read arms and `placeCurTy`'s fact
// collection cannot disagree: after `clr(o)` a fresh guard re-derives from the declared type.
function narrowedPathTy(key: string) {
  const i = narrowedPathIx(key)
  if i < 0 { return -1 }
  if npInvBy[i] >= 0 { return -1 }
  if crPathCaptureLost(i, key) { return -1 }
  if i < crFnNpBase() { return writeLandNestedTy(npTys[i]) }
  npTys[i]
}

// The node that invalidated the innermost narrowing of `key`, or -1 when `key` is narrowed and in
// force, or never narrowed at all. The two states `narrowedPathTy` folds into -1 are told apart
// here, and only for the diagnostic: an unguarded nullable read keeps its existing message, an
// invalidated one names the call or the write.
function narrowedPathInvBy(key: string) {
  const i = narrowedPathIx(key)
  if i < 0 { return -1 }
  if crPathCaptureLost(i, key) { return -1 }
  npInvBy[i]
}

// Whether the write shape `w` may write the key step `st`, whose container's cell tag is `tag`
// ("" for a field step, or when unknown). A cell shape and a step whose containers are both known
// hit only when they are the same kind and one element type is assignable to the other.
// The step `[*]` stands for every element of a list, which an append also writes.
function shapeHitsStep(w: string, st: string, tag: string): boolean {
  let s = w
  const appends = s.length > 0 && s[0] == '+'
  if appends && st != LIST_EVERY_STEP { return false }
  if s.length > 0 && (s[0] == '-' || appends) { s = s.slice(1, s.length) }
  let wtag = ""
  let h = s.length - 2
  while h >= 0 && !(s[h] == ']' && s[h + 1] == '#') { h = h - 1 }
  if h >= 0 {
    wtag = s.slice(h + 1, s.length)
    s = s.slice(0, h + 1)
  }
  const every = st == LIST_EVERY_STEP && s.length > 0 && s[0] == '['
  if s != st && !every && !(s == "[]" && st.length > 0 && st[0] == '[') {
    return false
  }
  cellTagsMayAlias(wtag, tag)
}

// Whether the cell shape `w` stores only what the element narrowing `nar` admits: its container
// is a list of a type every value of which is a `nar`, as the checker held each such store to.
function shapeStoresWithin(w: string, nar: i32): boolean {
  if nar < 0 { return false }
  let h = w.length - 2
  while h >= 0 && !(w[h] == ']' && w[h + 1] == '#') { h = h - 1 }
  if h < 0 { return false }
  const tag = w.slice(h + 1, w.length)
  if tag.length < 3 || tag[1] != 'a' { return false }
  const e = weDigits(tag.slice(2, tag.length))
  e >= 0 && !tyIsHole(e) && !tyHasTyVar(e) && assignable(e, nar)
}

function cellTagsMayAlias(a: string, b: string): boolean {
  if a == "" || b == "" { return true }
  if a[1] != b[1] { return false }
  const ea = weDigits(a.slice(2, a.length))
  const eb = weDigits(b.slice(2, b.length))
  if ea < 0 || eb < 0 { return true }
  assignable(ea, eb) || assignable(eb, ea)
}

// Whether a function with the write shapes `sum` may write the place keyed `key` through some
// alias of an object on its path. A store into the key's own last step is harmless when the place
// stores exactly the narrowed type: whatever it writes, the narrowing still holds.
function shapesHitKey(sum: string, key: string): boolean {
  if sum == "*" || sum.indexOf("@") >= 0 { return true }
  if sum == "" { return false }
  const steps = keySteps(key)
  const tags = keyStepTags(key, steps)
  const parts = weSplit(sum)
  const root = placeRootOf(key)
  let lastSafe = -1
  let i = 0
  while i < parts.length {
    if parts[i][0] == '=' {
      if parts[i].slice(1, parts[i].length) == root { return true }
    }
    let s = 0
    while s < steps.length {
      if shapeHitsStep(parts[i], steps[s], tags[s]) {
        if s < steps.length - 1 || parts[i][0] == '-' { return true }
        if steps[s] == LIST_EVERY_STEP {
          if !shapeStoresWithin(parts[i], narrowedPathTyRaw(key)) {
            return true
          }
        } else if lastSafe < 0 {
          lastSafe = 0
          if keyStoresNarrowedTy(key) { lastSafe = 1 }
        }
        if lastSafe == 0 { return true }
      }
      s = s + 1
    }
    i = i + 1
  }
  false
}

// Per step of `key`, the cell tag of the container a subscript step reads (`cellTagOfTy` of the
// type its prefix holds, through the narrowings over it), "" for a field step or when unknown.
function keyStepTags(key: string, steps: string[]): string[] {
  if keyIsListEvery(key) { return listEveryTags(key, steps) }
  const out: string[] = []
  const pres = keyStepPrefixTys(key, steps)
  let s = 0
  while s < steps.length {
    out.push(keyStepTag(steps[s], pres[s]))
    s = s + 1
  }
  out
}

// Whether the place keyed `key` stores exactly the type its live narrowing reads it at.
function keyStoresNarrowedTy(key: string): boolean {
  const slot = narrowedPathIx(key)
  if slot < 0 || narFitSlot(slot) { return false }
  const nar = npTys[slot]
  const st = keyStoreTy(key)
  if nar < 0 || st < 0 { return false }
  // Two holes both render `_`, which says nothing about whether they are one type (D3197).
  if tyIsHole(st) || tyIsHole(nar) { return false }
  st == nar || tyToStr(st) == tyToStr(nar)
}

// The type a store into the place keyed `key` writes: the declared type of its last step, reached
// through the narrowings in force over its prefixes; -1 when unresolvable.
function keyStoreTy(key: string): i32 {
  const steps = keySteps(key)
  if steps.length == 0 { return -1 }
  let rootLen = 0
  while rootLen < key.length && key[rootLen] != '.' && key[rootLen] != '[' {
    rootLen = rootLen + 1
  }
  let pre = key.slice(0, rootLen)
  let t = lookup(pre)
  let s = 0
  while s < steps.length - 1 && t >= 0 {
    pre = pre + steps[s]
    const ov = narrowedPathTyRaw(pre)
    if ov >= 0 {
      t = ov
    } else if steps[s][0] == '.' {
      t = placeFieldTy(t, steps[s].slice(1, steps[s].length), false)
    } else {
      t = placeElemTy(t)
    }
    s = s + 1
  }
  if t < 0 { return -1 }
  const last = steps[steps.length - 1]
  if last[0] == '.' {
    return placeFieldTy(t, last.slice(1, last.length), false)
  }
  placeCellStoreTy(t)
}

// The one place that decides whether the call at `callIx` invalidates the path narrowing keyed
// `key`. The rule is effect-based: `key` dies only when some argument place of the call is a prefix
// of `key` and the callee may write, through that parameter, a sub-path that is a prefix of the
// rest. It fails closed at every edge, and it is keyed on the syntactic argument, so aliases live.
function callInvalidatesNarrowedPath(callIx: i32, key: string) {
  const cn = P.nodes[callIx]
  if cn is Call { return callInvalidatesReal(cn, callIx, key) }
  // An operator that may dispatch to a declaration is a call of it, its operands the arguments.
  const ds = opSiteDecls(callIx)
  if ds.length == 0 { return false }
  const args = opSiteArgs(callIx)
  let i = 0
  while i < ds.length {
    if ds[i] < 0 { return true }
    if declWritesPath(ds[i], args, key) { return true }
    i = i + 1
  }
  false
}

function callInvalidatesReal(cn: Call, callIx: i32, key: string) {
  const declIx = callDeclFnIx(cn, callIx)
  // A cell-removing collection method retires that cell's narrowings, and it has to be asked
  // first because it reaches neither leg below: an intrinsic answers `-2` on the next line, and
  // `callArgPlaces` puts a receiver in the argument list only for a UFCS call. The key argument
  // is read exactly as a write target is — a literal names its cell, anything else may hit any.
  const rmRecv = P.nodes[cn.callFn]
  if rmRecv is Member {
    if cellRemovingMethod(rmRecv.memProp) {
      const rmRoot = placeKeyOf(rmRecv.memObj)
      if rmRoot != "" {
        const rmLit = removedCellKeyText(cn, rmRecv.memProp)
        if rmLit == "" {
          if keyHasPrefix(key, rmRoot + "[") { return true }
        } else {
          const rmCell = rmRoot + "[" + rmLit + "]"
          if key == rmCell { return true }
          if keyHasPrefix(key, rmCell + ".") { return true }
          if keyHasPrefix(key, rmCell + "[") { return true }
        }
      }
    }
  }
  if declIx == -2 && pushKeepsElemOnly(cn, key) { return false }
  // An intrinsic writes only through its own effect on a receiver that may alias the path, and
  // through the function values it is handed and may run.
  if declIx == -2 && !ALIAS_RULE_BROAD {
    return shapesHitKey(
      callWriteShapes(cn, callIx, crNoNames, crNoNames, crNoNames),
      key,
    )
  }
  // An opaque callee invalidates every live narrowing, not only the ones rooted at its arguments:
  // a closure that captured the object takes no argument, so an argument-keyed fallback would
  // fail open on exactly the construct that has no statically known body.
  if declIx < 0 { return true }
  declWritesPath(declIx, callArgPlaces(cn, callIx), key)
}

// Whether the declaration at `declIx`, handed the argument places `args` in parameter order,
// may write the place keyed `key`: through a free variable, or through an argument.
function declWritesPath(declIx: i32, args: i32[], key: string): boolean {
  // The write shapes see every write the name-keyed legs below do — through an argument, a free
  // variable, an alias — and each function value the callee runs is charged at its argument.
  if !ALIAS_RULE_BROAD {
    const sh = weSubstArgs(fnWriteShapes(declIx), args, crNoNames, crNoNames)
    return shapesHitKey(sh, key)
  }
  // Writes through a free variable, which likewise need no argument.
  const free = fnWriteFreePaths(declIx)
  if free == "*" { return true }
  if pathHitsAny(key, free, "") { return true }
  let i = 0
  while i < args.length {
    const ak = placeKeyOf(args[i])
    if ak != "" {
      // An index cell of an argument dies to any call that receives the array, with no effect
      // refinement — the deliberately blunt half of this rule. The summaries are `,`-terminated
      // field sub-paths and an index write records nothing in one, so consulting them here would
      // read "writes nothing" for the callee that nulls the cell (inventory-2 D452).
      if keyHasPrefix(key, ak + "[") { return true }
      const pfx = ak + "."
      if keyHasPrefix(key, pfx) {
        if ALIAS_RULE_BROAD { return true }
        const sum = fnWriteEffects(declIx, i)
        if sum == "*" { return true }
        const rest = key.slice(pfx.length, key.length)
        if pathHitsAny(rest, sum, "") { return true }
      }
    }
    i = i + 1
  }
  false
}

// The diagnostic for a write the re-execution barrier refuses. It names the loop rather
// than the type, because the type is fine: the same write one block further out is
// accepted, and so is this one under a guard the loop itself re-tests.
function writeBarredErr(place: string, at: i32) {
  tErr(
    "'"
      + place
      + "' was narrowed by a guard OUTSIDE this loop, so this write would leave the "
      + "reads before it reading the old narrowing on the next iteration — move the "
      + "write out of the loop, or make the guard on '"
      + place
      + "' the loop's own condition",
    at,
  )
  0
}

// The storage type of an assignment target — what the place can hold, as against what a narrowing
// currently proves it holds — or -1 when no live narrowing overlays the place and the flow type is
// the storage type. A bare name reads the narrowing bank, since the guard's `declare` hid the
// declaration; a property path reads the field off the receiver's type. -1 across a barrier.
function writeStorageTy(ix: i32) {
  const n = P.nodes[ix]
  if n is Ident {
    // A guard's write is bounded by a loop barrier, and a nested function that captured the
    // narrowing is checked at each call instead (D2402). An assignment narrowing's is not: its
    // null write in a single-iteration loop is a correct program barring would reject.
    if narGuardSlot(n.identName) >= 0 { return narWriteStorage(n.identName) }
    return narDeclaredTy(n.identName, NAR_KIND_ASG)
  }
  if n is Member {
    const key = placeKeyOf(ix)
    if key == "" { return -1 }
    const slot = narrowedPathIx(key)
    if slot < 0 { return -1 }
    // An already-retired narrowing still answers, and bailing on `npInvBy[slot] >= 0` here is an
    // ordering bug inside one statement: `lt` is read off the target before the right-hand side is
    // checked, so a callee that retires the path mid-statement would leave `asgLt` at a type the
    // storage never had. A retired narrowing means the place reads at its declared type.
    if npEpochs[slot] != narFnEpoch && npAsg[slot] != 1 { return -1 }
    if !npInsideBarrier(slot) { return -1 }
    const noNames: string[] = []
    const noTys: i32[] = []
    return placeFieldTy(placeCurTy(n.memObj, noNames, noTys), n.memProp, false)
  }
  // An index cell is storage too, and this arm is not optional once a cell can be narrowed:
  // `if xs[0] != null { xs[0] = null }` runs when no narrowing covers the target, and without this
  // it would newly reject `cannot assign null to i32[]` — a working program lost to a rule whose
  // whole point is that it never shrinks what storage holds. Same three guards as the member arm.
  if n is Index {
    const key = placeKeyOf(ix)
    if key == "" { return -1 }
    const slot = narrowedPathIx(key)
    if slot < 0 { return -1 }
    if npEpochs[slot] != narFnEpoch && npAsg[slot] != 1 { return -1 }
    if !npInsideBarrier(slot) { return -1 }
    const noNames: string[] = []
    const noTys: i32[] = []
    return placeCellStoreTy(placeCurTy(n.idxArr, noNames, noTys))
  }
  -1
}

// Whether a write of a value typed `rt` to the place at `tgtIx` would leave the narrowing it held
// when an enclosing loop began, where the loop cannot re-read it: a write the declaration admits
// still has to land within that narrowing, since the reads before it run again (D2609).
function writeLeavesLoopEntry(tgtIx: i32, rt: i32): boolean {
  if rt < 0 { return false }
  const n = P.nodes[tgtIx]
  if n is Ident {
    if narGuardSlot(n.identName) < 0 { return false }
    const cap = narWriteStorage(n.identName)
    const depths: i32[] = []
    const wide = crChainWidest(n.identName, depths)
    if cap < 0 || wide < 0 || tySame(cap, wide) { return false }
    return !writeLandsWithin(wide, rt, cap)
  }
  // A field or cell answers by its path's narrowing; any other target keys "" and has none.
  pathWriteLeavesLoopEntry(tgtIx, rt)
}

// `writeLeavesLoopEntry` for a field or cell narrowed outside the innermost loop.
function pathWriteLeavesLoopEntry(tgtIx: i32, rt: i32): boolean {
  const key = placeKeyOf(tgtIx)
  if key == "" { return false }
  const slot = narrowedPathIx(key)
  if slot < 0 || slot >= npKeys.length { return false }
  if npInvBy[slot] >= 0 || npInsideBarrier(slot) { return false }
  const store = placeStoreTy(tgtIx)
  if store < 0 { return false }
  !writeLandsWithin(store, rt, npTys[slot])
}

// Whether a value typed `rt` written into storage `store` lands on a member `cap` holds: each
// member of a union value lands where it would alone, and `null` needs `cap` to admit it.
function writeLandsWithin(store: i32, rt: i32, cap: i32): boolean {
  const rT = T.tys[rt]
  if rT is TyUnion {
    let k = 0
    while k < rT.uMembers.length {
      if !writeLandsWithin(store, rT.uMembers[k], cap) { return false }
      k = k + 1
    }
    return true
  }
  if isNullTy(rt) { return tyAdmitsNull(cap) }
  if rT is TyNullable {
    if !tyAdmitsNull(cap) || rT.nInner < 0 { return false }
    return writeLandsWithin(store, rT.nInner, cap)
  }
  const m = writeMemberTy(store, rt)
  if m == store { return assignable(rt, cap) }
  tyMemberWithin(m, cap)
}

// Whether `ix` is a cell of a map, `m[k]`.
function placeIsMapCell(ix: i32): boolean {
  const n = P.nodes[ix]
  if n is Index {
    const noNames: string[] = []
    const noTys: i32[] = []
    const rt = placeCurTy(n.idxArr, noNames, noTys)
    if rt >= 0 {
      const nt = nonNullTy(rt)
      if nt >= 0 { return T.tys[nt] is TyMap }
    }
  }
  false
}

// The declared type of the field or cell at `ix`, whatever narrowing or loop covers it; -1 for
// any other node.
function placeStoreTy(ix: i32): i32 {
  const n = P.nodes[ix]
  if n is Member {
    const noNames: string[] = []
    const noTys: i32[] = []
    return placeFieldTy(placeCurTy(n.memObj, noNames, noTys), n.memProp, false)
  }
  // A cell's declared type is its container's element; any other node has none.
  placeCellDeclTy(ix)
}

// The declared element type of the cell at `ix`, or -1 when `ix` is no cell.
function placeCellDeclTy(ix: i32): i32 {
  const n = P.nodes[ix]
  if n is Index {
    const noNames: string[] = []
    const noTys: i32[] = []
    return placeCellStoreTy(placeCurTy(n.idxArr, noNames, noTys))
  }
  -1
}

// Does a write to `tgtKey` of a value typed `rt` retire the narrowing `(key, npTy)`? The one home
// for that question, so the bare-name and property-path sides cannot disagree. An exact match
// consults `rt` — a write the narrowing still admits keeps it — while a prefix match, in either
// separator, retires unconditionally. An unkeyable target keys "" and its caller handles it.
function writeRetiresNarrowing(
  tgtKey: string,
  rt: i32,
  key: string,
  npTy: i32,
) {
  if tgtKey == "" { return false }
  // A hole admits every write, so its narrowing is retired and re-derived from the value (D3197).
  if key == tgtKey && tyIsHole(npTy) { return true }
  if key == tgtKey { return !assignable(rt, npTy) }
  if keyHasPrefix(key, tgtKey + ".") { return true }
  keyHasPrefix(key, tgtKey + "[")
}

// Whether the write target at `tgtIx` is a field or a cell of a receiver typed as an inference
// hole, at any depth of a place (`b.a.v`, `b[0]`).
function writesHoleField(tgtIx: i32): boolean {
  const tn = P.nodes[tgtIx]
  let recv = -1
  if tn is Member { recv = tn.memObj }
  else if tn is Index { recv = tn.idxArr }
  else { return false }
  const on = P.nodes[recv]
  if on is Ident { return tyIsHole(lookup(on.identName)) }
  const noNames: string[] = []
  const noTys: i32[] = []
  if tyIsHole(placeCurTy(recv, noNames, noTys)) { return true }
  tyIsHole(nodeTyOf(recv))
}

// End every live path narrowing the write at `atIx` may reach through an alias: `q.f = null`
// after `const q = p` falsifies `p.f`. The write's shape is matched against each step of each
// key, as a call's write summary is; the target's own key and the paths under it are left to
// `writeRetiresNarrowing`. A write the narrowed type still admits keeps the narrowing (D2584).
function retireAliasedNarrowings(
  tgtIx: i32,
  tgtKey: string,
  rt: i32,
  atIx: i32,
) {
  if npKeys.length == 0 { return 0 }
  const shapes = weSplit(weTargetShape(tgtIx, crNoNames, crNoNames))
  if shapes.length != 1 || shapes[0][0] == '=' { return 0 }
  const shape = shapes[0]
  const recv = aliasWriteRecvIx(tgtIx)
  let recvTy = -1
  let recvName = ""
  if recv >= 0 {
    recvTy = nodeTyOf(recv)
    const rn = P.nodes[recv]
    if rn is Ident { recvName = rn.identName }
  }
  let family = ""
  if tgtKey == "" { family = indexRootKeyOf(tgtIx) }
  const recvFresh = recvName != "" && crSoleRefBinding(recvName)
  const n0 = npKeys.length
  let i = 0
  while i < n0 {
    const k = npKeys[i]
    const own = tgtKey != ""
      && (k == tgtKey
      || keyHasPrefix(k, tgtKey + ".")
      || keyHasPrefix(k, tgtKey + "["))
    const fam = family != "" && keyHasPrefix(k, family + "[")
    const kRoot = placeRootOf(k)
    // A receiver no other place refers to cannot be any object on another key's path; a key
    // root no other place refers to cannot be the receiver unless the receiver names it. Both
    // resolve names here, so neither holds for an entry an inner declaration hides (D3307).
    const hidden = narrowedPathIx(k) != i
    const apart = recvFresh && kRoot != recvName && !hidden
    const skip0 = kRoot != recvName && !hidden && crSoleRefBinding(kRoot)
    const keeps = (!hidden
      && elemOnlyStoreKeeps(i, elemDepthOf(tgtIx), asgRhsIx(atIx), rt))
    const hits = !own
      && !fam
      && !apart
      && !keeps
      && aliasWriteHitsKey(shape, recvTy, skip0, rt, k, npTys[i])
    if hits && npInvBy[i] >= 0 && i >= crFnNpBase() {
      // Already retired, typically by a sibling arm's write: the kill still ends this path,
      // and a merged entry must not hand the fact back (D3285).
      narClobKeysPush(k)
      narClobTysPush(-1)
      narClobPrevPush(-1)
      narClobDepthsPush(T.scopes.length)
      narClobRetiredPush(2)
      narClobBindPush(-1)
      narClobDeclPush(-1)
    }
    if hits && npInvBy[i] < 0 {
      crAliasWr[atIx] = true
      narSetInv(i, atIx)
      if nfSlots.length > 0 && i >= crFnNpBase() { narFitRetire(i, atIx, -1) }
      if i < crFnNpBase() {
        crAliasNestSlots.push(i)
        crAliasNestDepths.push(crFnBases.length)
      } else {
        crPathCallRetire(i, atIx)
        narClobKeysPush(k)
        narClobTysPush(-1)
        narClobPrevPush(npTys[i])
        narClobDepthsPush(T.scopes.length)
        narClobRetiredPush(2)
        narClobBindPush(-1)
        narClobDeclPush(-1)
        mapCellStaysPresent(k)
      }
    }
    i = i + 1
  }
  0
}

// A narrowed map cell a store through an alias may have written is present either way, so it
// reads the map's value type after, not the map read's `T | null`.
function mapCellStaysPresent(key: string) {
  const steps = keySteps(key)
  if steps.length == 0 || steps[steps.length - 1][0] != '[' { return 0 }
  const pres = keyStepPrefixTys(key, steps)
  const ct = pres[pres.length - 1]
  if ct < 0 { return 0 }
  const nt = nonNullTy(ct)
  if nt < 0 { return 0 }
  const m = T.tys[nt]
  if m is TyMap {
    npKeysPush(key)
    npTysPush(m.mVal)
    npInvByPush(-1)
    npEpochsPush(narFnEpoch)
    npSettlePush(-2)
    npCapByPush(-1)
    npAsgPush(0)
  }
  0
}

// Whether a write of shape `shape` into an object typed `recvTy`, storing a value typed `rt`,
// may falsify the narrowing of `key` to `npTy`. A field step matches only a receiver whose type
// may be the object's, the first step not at all when `skip0`; a store the narrowed type admits
// into the key's last step keeps it.
function aliasWriteHitsKey(
  shape: string,
  recvTy: i32,
  skip0: boolean,
  rt: i32,
  key: string,
  npTy: i32,
): boolean {
  const steps = keySteps(key)
  const pres = keyStepPrefixTys(key, steps)
  const tags = keyStepTags(key, steps)
  let s = 0
  while s < steps.length {
    if (
      shapeHitsStep(shape, steps[s], tags[s])
      && (steps[s][0] != '.' || objTysMayAlias(pres[s], recvTy))
      && !(s == 0 && skip0)
    ) {
      if s < steps.length - 1 { return true }
      if steps[s] == LIST_EVERY_STEP && shapeStoresWithin(shape, npTy) {
        return false
      }
      if rt < 0 || npTy < 0 || !assignable(rt, npTy) { return true }
      // A hole admits every write, which proves nothing about the pin's value (D3197). The
      // else arm of `is T` on one holds the pin's remainder, which a write of no `T` lands in.
      if tyIsHole(npTy) {
        const te = holeElseTested[key + "|" + i32ToStr(npTy)] ?? -1
        return te < 0 || tyMayHoldTy(rt, te)
      }
      // A numeric value the narrowing only widens to is stored as its own member (D2609).
      if numericVariantUncovered(rt, npTy) { return true }
    }
    s = s + 1
  }
  false
}

// Per step of `key`, the type of the prefix the step reads from, -1 when unresolvable.
function keyStepPrefixTys(key: string, steps: string[]): i32[] {
  const out: i32[] = []
  let rootLen = 0
  while rootLen < key.length && key[rootLen] != '.' && key[rootLen] != '[' {
    rootLen = rootLen + 1
  }
  let pre = key.slice(0, rootLen)
  let t = lookup(pre)
  let s = 0
  while s < steps.length {
    out.push(t)
    if t >= 0 {
      pre = pre + steps[s]
      const ov = narrowedPathTyRaw(pre)
      if ov >= 0 {
        t = ov
      } else if steps[s][0] == '.' {
        t = placeFieldTy(t, steps[s].slice(1, steps[s].length), false)
      } else {
        t = placeElemTy(t)
      }
    }
    s = s + 1
  }
  out
}

// Whether a value typed `rt` may be a `te`: `rt` or one of its members overlaps `te`.
function tyMayHoldTy(rt: i32, te: i32): boolean {
  if assignable(rt, te) || assignable(te, rt) { return true }
  const r = T.tys[rt]
  if r is TyUnion {
    let i = 0
    while i < r.uMembers.length {
      if assignable(r.uMembers[i], te) { return true }
      i = i + 1
    }
  }
  false
}

// Whether values of types `a` and `b` may be one object; true when either is unknown.
function objTysMayAlias(a: i32, b: i32): boolean {
  if a < 0 || b < 0 { return true }
  const na = nonNullTy(a)
  const nb = nonNullTy(b)
  if na < 0 || nb < 0 || na == nb { return true }
  if tyHasTyVar(na) || tyHasTyVar(nb) || tyIsHole(na) || tyIsHole(nb) {
    return true
  }
  assignable(na, nb) || assignable(nb, na)
}

// Retire every narrowing the accepted write at `atIx` falsifies, in place — never by pushing a
// shadowing entry, which would unwind at the end of whatever inner block holds the write and
// resurrect the narrowing for the statements after it. A property path is marked in `npInvBy`; a
// bare name's narrowing is a shadowing `declare`, so retiring it writes the declared type back.
function retireNarrowingsForWrite(
  tgtIx: i32,
  rt0: i32,
  atIx: i32,
  preAsgTy: i32,
) {
  let rt = rt0
  // A re-check of the write (a hole body checked again at its pin) answers afresh: the answer
  // an earlier check banked at the hole's own type is not this one's.
  clearAsgNarTyIx(atIx)
  const tgtKey = placeKeyOf(tgtIx)
  retireAliasedNarrowings(tgtIx, tgtKey, rt, atIx)
  // A variable-index write names no cell and therefore may have hit any of them. `xs[i] = null`
  // keys "" and the loop below would retire nothing at all, which is a soundness hole the moment
  // a narrowing can name a cell. Retire every live narrowing under the receiver; the cell keys
  // (`xs[0].v` as well as `xs[0]`) go with it through the same prefix.
  if tgtKey == "" {
    const root = indexRootKeyOf(tgtIx)
    if root == "" { return 0 }
    const pfx = root + "["
    const depth = elemDepthOf(tgtIx)
    const val = asgRhsIx(atIx)
    let r = 0
    while r < npKeys.length {
      // A store through a list narrowed by name is checked against its narrowed element.
      if (
        keyHasPrefix(npKeys[r], pfx)
        && !(keyHasPrefix(npKeys[r], root + LIST_EVERY_STEP)
          && narFitNameOf(r) != "")
        && !(elemKeyBase(npKeys[r]) == root && elemOnlyStoreKeeps(r, depth, val, rt))
      ) {
        let rprev = -1
        if npInvBy[r] < 0 { rprev = npTys[r] }
        narSetInv(r, atIx)
        noteKillSure(atIx, npKeys[r])
        // Unknown after the write, which an arm join must not merge a fact back over.
        narClobKeysPush(npKeys[r])
        narClobTysPush(-1)
        narClobPrevPush(rprev)
        narClobDepthsPush(T.scopes.length)
        narClobRetiredPush(2)
        narClobBindPush(-1)
        narClobDeclPush(-1)
      }
      r = r + 1
    }
    return 0
  }
  // The path's own live fact before this write: the arm JOIN's entry type, and the tell that a
  // narrowing covers the place at all (D1849).
  const preSlot = narrowedPathIx(tgtKey)
  let prePathTy = -1
  if preSlot >= 0 {
    // An entry a WRITE retired still seeds the ledger, at the storage type that write left the
    // place at: an earlier write on this path or a sibling arm's, whose own row the join folds.
    // Only a CALL's retirement stops the fold, since it leaves the place unknown (D1849, D3285).
    if npInvBy[preSlot] < 0 {
      prePathTy = npTys[preSlot]
    } else if pathRetiredByAssign(npInvBy[preSlot]) {
      prePathTy = placeStoreTy(tgtIx)
    }
  }
  // A literal stored into a literal union re-narrows by its own type, as for a bare name; and
  // the storage may hold `null` again, so a null test of the place is a real question.
  if preSlot >= 0 {
    const pst = placeStoreTy(tgtIx)
    rt = asgLitRhsTy(atIx, pst, rt)
    if tyAdmitsNull(pst) && !narWrittenPath(tgtKey) {
      narWrNames.push(tgtKey)
      narWrDepths.push(T.scopes.length - 1)
    }
  }
  let i = 0
  // The member the write re-narrows `tgtKey` to, or -1 when it names none. Pushed after the
  // walk below rather than inside it: a fresh entry would be re-tested by the same loop.
  let pathReTy = -1
  let pathReAsg = false
  let pathRetired = false
  while i < npKeys.length {
    // The write's attribution wins over a call's, and the overwrite is what makes the read below
    // legible: `w.f = mk()` is one statement whose right-hand side is checked first, so an opaque
    // `mk` marks the path and the write would otherwise be reported as the call's. The cause is
    // what `pathRetiredByAssign` reads to decide whether the emitter can see the retirement.
    let hit = writeRetiresNarrowing(tgtKey, rt, npKeys[i], npTys[i])
    // An enclosing function's narrowing a nested body writes ends where that body is CALLED,
    // which the call rule settles for both halves; the write runs later than this point.
    if i < crFnNpBase() { hit = false }
    // A write the narrowing admits still re-narrows the place to the member it stored, as it
    // does a bare name (`5` into an `f64` arm of `i32 | f64`).
    if !hit && i >= crFnNpBase() && npInvBy[i] < 0 && npKeys[i] == tgtKey {
      const pd = writeStorageTy(tgtIx)
      if pd >= 0 && !tySame(writeNarrowAfter(pd, npTys[i], rt), npTys[i]) {
        hit = true
      }
      if (pd >= 0 && tvPlaceWrite(pd, rt) && !tyIsTvWriteOf(npTys[i], pd, rt)) {
        hit = true
      }
    }
    // A write to a prefix of the key replaces the object the key reads through, so the key is
    // unknown after it on this path, whatever the write stored and whether or not a sibling arm
    // already ended the narrowing in place (D3319).
    if (
      i >= crFnNpBase()
      && (keyHasPrefix(npKeys[i], tgtKey + ".")
        || keyHasPrefix(npKeys[i], tgtKey + "["))
    ) {
      let kprev = -1
      if npInvBy[i] < 0 { kprev = npTys[i] }
      narClobKeysPush(npKeys[i])
      narClobTysPush(-1)
      narClobPrevPush(kprev)
      narClobDepthsPush(T.scopes.length)
      narClobRetiredPush(2)
      narClobBindPush(-1)
      narClobDeclPush(-1)
    }
    if hit {
      narSetInv(i, atIx)
      noteKillSure(atIx, npKeys[i])
      // The target's OWN narrowing going is what the emitter has to mirror; a path below it
      // goes through the prefix rule both sides already apply. Reads-only narrowing states one
      // rule for every receiver, so the path re-narrows to the written member exactly as a bare
      // name does, and reads at its declaration when the write names none (D1736, D1847).
      if npKeys[i] == tgtKey {
        pathRetired = true
        let pdcl = writeStorageTy(tgtIx)
        if pdcl < 0 { pdcl = placeStoreTy(tgtIx) }
        const prn = writeMemberTy(pdcl, rt)
        recordAsgNarTyIx(atIx, prn)
        // A map cell reads `T | null` at its declaration, since a read may miss; the write just
        // stored the key, so the reads after it hold the stored type.
        if prn != pdcl || placeIsMapCell(tgtIx) { pathReTy = prn }
        if tvPlaceWrite(pdcl, rt) {
          pathReTy = tvWriteTy(pdcl, rt, -1)
          pathReAsg = true
          recordAsgTvWrite(atIx, pdcl)
        }
      }
    }
    i = i + 1
  }
  // The assignment narrowing's path twin: a non-null write to a field or list cell no live
  // narrowing covers (none, or one a write, call or alias ended) strips `null` for the code after
  // it, as `x = 5` does a name (D1848, D3316). A map cell's `null` is the miss, so it is left out.
  if narrowedPathTyRaw(tgtKey) < 0 && pathReTy < 0 && !placeIsMapCell(tgtIx) {
    const pst = placeStoreTy(tgtIx)
    if pst >= 0 && tvPlaceWrite(pst, rt) {
      pathReTy = tvWriteTy(pst, rt, -1)
      pathReAsg = true
      recordAsgTvWrite(atIx, pst)
    } else if pst >= 0 && rt >= 0 && tyAdmitsNull(pst) && !tyAdmitsNull(rt) {
      const nn = nonNullTy(pst)
      if nn >= 0 && !tySame(nn, pst) {
        pathReTy = nn
        pathReAsg = true
        recordAsgNarTyIx(atIx, nn)
      }
    }
  }
  // A hole's field reads what a write stored in it (`holeFieldWriteTy`), as after a null test,
  // whatever narrowing the write retired (D3197).
  if pathReTy < 0 && rt >= 0 && writesHoleField(tgtIx) {
    const hst = placeStoreTy(tgtIx)
    if hst >= 0 && tyIsHole(hst) {
      // A concrete value reads at the member of the pinned place it lands on.
      if !tyHasHole(rt) && !tyAdmitsNull(rt) && !isNullTy(rt) {
        pathReTy = mkDerivedHole(HD_HWR, "", rt, -1, hst)
        recordAsgTvWrite(atIx, hst)
      } else {
        pathReTy = holeFieldWriteTy(hst, rt)
      }
    }
  }
  if pathReTy >= 0 {
    npKeysPush(tgtKey)
    npTysPush(pathReTy)
    npInvByPush(-1)
    npEpochsPush(narFnEpoch)
    npSettlePush(-2)
    npCapByPush(-1)
    if pathReAsg { npAsgPush(1) } else { npAsgPush(0) }
  }
  // Every write over a narrowed path joins, retiring or not — the first arm's retirement is
  // what makes the second arm's flip look admitted, exactly as for a bare name. The row also
  // carries the post-guard residual's veto, which reads the retiring ones (D1846, D1849).
  if prePathTy >= 0 {
    let endTy = pathReTy
    if endTy < 0 {
      if pathRetired {
        endTy = writeStorageTy(tgtIx)
        if endTy < 0 { endTy = placeStoreTy(tgtIx) }
      } else {
        // The member the write lands on, which a narrowing that only widens to it does not
        // name (`5` under a second arm's `f64`, D2629).
        const pst = placeStoreTy(tgtIx)
        endTy = writeReNarrowTy(prePathTy, rt)
        if pst >= 0 { endTy = writeNarrowAfter(pst, prePathTy, rt) }
      }
    }
    if endTy < 0 { endTy = prePathTy }
    narClobKeysPush(tgtKey)
    narClobTysPush(endTy)
    narClobPrevPush(prePathTy)
    narClobDepthsPush(T.scopes.length)
    let prtd = 0
    if pathRetired { prtd = 1 }
    narClobRetiredPush(prtd)
    narClobBindPush(-1)
    narClobDeclPush(narKeyBind(tgtKey))
  } else if pathReAsg {
    // The null strip of a path no narrowing covered is a path fact the join meets too.
    narClobKeysPush(tgtKey)
    narClobTysPush(pathReTy)
    narClobPrevPush(placeStoreTy(tgtIx))
    narClobDepthsPush(T.scopes.length)
    narClobRetiredPush(0)
    narClobBindPush(-1)
    narClobDeclPush(narKeyBind(tgtKey))
  } else {
    // A write over a narrowing a sibling arm or a kill already ended in place still ends this
    // path at the member it stores, and the join must see that (D3315).
    // Only over a narrowing: elsewhere no join reads the place. A map cell is left out, its
    // read may miss whatever the write stored.
    const fst = placeStoreTy(tgtIx)
    if fst >= 0 && preSlot >= 0 && !placeIsMapCell(tgtIx) {
      narClobKeysPush(tgtKey)
      narClobTysPush(writeMemberTy(fst, rt))
      narClobPrevPush(fst)
      narClobDepthsPush(T.scopes.length)
      narClobRetiredPush(1)
      narClobBindPush(-1)
      narClobDeclPush(narKeyBind(tgtKey))
    }
  }
  const tn = P.nodes[tgtIx]
  if tn is Ident {
    const nm = tn.identName
    let dcl = narDeclaredTy(nm, -1)
    const guarded = dcl >= 0 && narGuardSlot(nm) >= 0
    if guarded {
      const ws = narWriteStorage(nm)
      if ws >= 0 { dcl = ws }
    }
    if dcl >= 0 {
      const pre = lookup(nm)
      let rn = writeReNarrowTy(dcl, rt)
      // What the arm join reads a write that kept its narrowing as ending at.
      let keptEnd = rn
      let retires = writeRetiresNarrowing(nm, rt, nm, pre)
      // Under a guard the write re-narrows to what it stored, as a declaration-typed write
      // would, even when the narrowing already admitted it (`5` into an `f64` arm).
      if guarded {
        rn = writeNarrowAfter(dcl, pre, asgLitRhsTy(atIx, dcl, rt))
        retires = !tySame(rn, pre)
        if !retires { asgKeepNarrowSetAt(atIx, true) }
        // A kept write ends at the member it kept; a later null test of it is a dead-test
        // warning, not a refusal (DECISIONS.md, "A null test of a value proved non-null").
        keptEnd = rn
      }
      // A value typed at a declared type parameter into a declaration that admits null reads as
      // the parameter: whether it is null is its pin's question, which the body re-asks there.
      const tvWrite = tvPlaceWrite(dcl, rt)
      if tvWrite {
        rn = tvWriteTy(dcl, rt, pre)
        keptEnd = rn
        retires = pre != rn
        if guarded { asgKeepNarrowSetAt(atIx, false) }
      } else if retires && !guarded && tyIsTvWriteOf(pre, dcl, -1) {
        // A later write re-narrows from the declaration, as the first write's strip would.
        rn = writeMemberTy(dcl, asgLitRhsTy(atIx, dcl, rt))
      }
      if retires {
        // The RETIREMENT goes back in place, so it outlives whatever inner block holds the
        // write: a narrowing the write falsified must not resurrect at that block's `}`.
        const d = lookupDepth(nm)
        if guarded { narRetireLayers(nm, rn, dcl) }
        if d >= 0 { narSetScope(d, nm, dcl) }
        // The RE-NARROW — the one member of the declaration the written value can be — is a
        // shadow in the CURRENT block instead, because that is exactly how long the emitter's
        // own push lives (its `restoreNarrow` unwinds at the same `}`). Banked at the
        // assignment node so both halves lower the reads after the write alike (D1736).
        if rn != dcl {
          noteNarShadow(nm, dcl, NAR_KIND_GUARD)
          declare(nm, rn)
        }
        recordAsgNarTyIx(atIx, rn)
      }
      // The emitter reads the place at its declaration; the reads' own types carry the pin.
      if tvWrite { recordAsgTvWrite(atIx, dcl) }
      if guarded && tyAdmitsNull(dcl) { narNoteWritten(nm) }
      // A kept write ends at the member of the declaration it stored, when that is narrower
      // than the narrowing it kept (a nullable union's inner member); else at that narrowing.
      if !retires && !guarded { keptEnd = writeMemberTy(dcl, rt) }
      if !retires && pre >= 0 && !assignable(keptEnd, pre) { keptEnd = pre }
      // Every write joins, retiring or not: an arm that wrote a member the narrowing already
      // allowed still ENDS at that member, and the first arm's in-place retirement is what
      // makes the second arm's flip look admitted (D1846). Its before-type is the name's as
      // the assignment found it, ahead of the null-strip shadow the assignment itself declared.
      narClobKeysPush(nm)
      if retires { narClobTysPush(rn) } else { narClobTysPush(keptEnd) }
      if preAsgTy >= 0 {
        narClobPrevPush(preAsgTy)
      } else {
        narClobPrevPush(pre)
      }
      narClobDepthsPush(T.scopes.length)
      let rtd = 0
      if retires { rtd = 1 }
      narClobRetiredPush(rtd)
      narClobBindPush(-1)
      narClobDeclPush(narKeyBind(nm))
    }
  }
  0
}

// The member of `dcl` a place declared so reads at after a write of a value pinned at `pin`
// (`writeMemberTy`): `dcl` itself when the pin lands on no narrower member, and the literal
// union `nonNullTy(dcl)` when a non-null pin fits it, as no one member names it (D3423).
export function tvWriteLandTy(dcl: i32, pin: i32): i32 {
  const m = writeMemberTy(dcl, pin)
  if m != dcl || pin < 0 || isNullTy(pin) || tyAdmitsNull(pin) { return m }
  const nn = nonNullTy(dcl)
  if nn >= 0 && tyIsLitUnion(nn) && assignable(pin, nn) { return nn }
  m
}

// The type a bare name reads at after an accepted write retired its narrowing: the sole member
// of its declared type the written value is assignable to. The declared type when the write
// names no single member, which keeps every null-bearing write reading at the declaration —
// the rep the emitter's own retirement leaves in place (D1736).
function writeReNarrowTy(dcl: i32, rt: i32) {
  if rt < 0 || dcl < 0 { return dcl }
  if isNullTy(rt) { return dcl }
  const rtT = T.tys[rt]
  if rtT is TyNullable { return dcl }
  const d = T.tys[dcl]
  if d is TyUnion {
    let hit = -1
    let n = 0
    let i = 0
    while i < d.uMembers.length {
      if assignable(rt, d.uMembers[i]) {
        hit = d.uMembers[i]
        n = n + 1
      }
      i = i + 1
    }
    if n == 1 { return hit }
  }
  dcl
}

// The member of the declaration `dcl` a write of a value typed `rt` under a narrowing lands on,
// or `dcl` when it names none: as `writeReNarrowTy`, but a value lands on the member it IS before
// one it widens to, and a nullable declaration re-narrows its inner type too (D2609).
export function writeMemberTy(dcl: i32, rt: i32) {
  if rt < 0 || dcl < 0 { return dcl }
  if isNullTy(rt) { return dcl }
  const rtT = T.tys[rt]
  if rtT is TyNullable { return dcl }
  const d = T.tys[dcl]
  if d is TyUnion { return unionMemberOfWrite(dcl, d.uMembers, rt) }
  // A nullable declaration re-narrows its inner type the same way; nothing else has members.
  nullableMemberOfWrite(dcl, rt)
}

// `writeMemberTy` over a nullable declaration `dcl`: the member of its inner type, or `dcl`.
function nullableMemberOfWrite(dcl: i32, rt: i32): i32 {
  const d = T.tys[dcl]
  if d is TyNullable {
    if d.nInner < 0 { return dcl }
    const inT = T.tys[d.nInner]
    if inT is TyUnion { return unionMemberOfWrite(dcl, inT.uMembers, rt) }
    if assignable(rt, d.nInner) { return d.nInner }
  }
  dcl
}

// The member of `ms` a written value typed `rt` lands on: the one it IS, else the sole one it is
// assignable to (an `i32` into `i32 | f64` is the `i32` member, not a widened `f64`); `dcl` when
// neither names one.
function unionMemberOfWrite(dcl: i32, ms: i32[], rt: i32): i32 {
  // A union-typed value lands on one member only when every member of it does.
  const rT = T.tys[rt]
  if rT is TyUnion {
    let one = -1
    let k = 0
    while k < rT.uMembers.length {
      const m = unionMemberOfWrite(dcl, ms, rT.uMembers[k])
      if m == dcl || (one >= 0 && !tySame(m, one)) { return dcl }
      one = m
      k = k + 1
    }
    if one >= 0 { return one }
    return dcl
  }
  const w = widenLitTy(rt)
  let i = 0
  while i < ms.length {
    if !isNullTy(ms[i]) && tySame(w, ms[i]) { return ms[i] }
    i = i + 1
  }
  let hit = -1
  let n = 0
  i = 0
  while i < ms.length {
    if assignable(rt, ms[i]) {
      hit = ms[i]
      n = n + 1
    }
    i = i + 1
  }
  if n == 1 { return hit }
  dcl
}

// Mark every live narrowing the call at `callIx` invalidates. Runs after the call's own arguments
// are checked, so `f(o.v.length, o)` still reads `o.v` under the narrowing in force as that
// argument is evaluated.
function noteCallInvalidations(callIx: i32) {
  if neKeys.length > 0 { neKill("", curFnDeclIx) }
  if !(P.nodes[callIx] is Call) { crOpCall[callIx] = true }
  crCapRecCheck(callIx)
  crNoteCallBare(callIx)
  if npKeys.length == 0 { return 0 }
  let i = 0
  while i < npKeys.length {
    if callMayWrite(callIx, npKeys[i]) {
      let cprev = -1
      if npInvBy[i] < 0 { cprev = npTys[i] }
      // The mark is first-cause-wins — a write's attribution outranks a call's, which is what
      // the diagnostic reads. The LEDGER row is unconditional, because the arm JOIN reads the
      // two arms separately and a write in one must not hide a call in the other (D1849).
      if npInvBy[i] < 0 {
        narSetInv(i, callIx)
        if nfSlots.length > 0 && i >= crFnNpBase() {
          narFitRetire(i, callIx, -1)
        }
        if callKillSure(callIx, npKeys[i]) { noteKillSure(callIx, npKeys[i]) }
        crPathCallRetire(i, callIx)
        // Inside a nested body a call ends an enclosing narrowing for the rest of that body
        // only: the enclosing function's own call of the body ends it there, in both halves.
        if i < crFnNpBase() {
          crNestCallRet[callIx] = true
          crAliasNestSlots.push(i)
          crAliasNestDepths.push(crFnBases.length)
        }
      } else if i >= crFnNpBase() {
        // Already ended, but a nested function that read it under the narrowing, or a read
        // earlier in an enclosing loop, still sees what this writer does.
        crLoopReadCheck(i, callIx)
        crCaptureCallCheck(i, callIx)
      }
      narClobKeysPush(npKeys[i])
      narClobTysPush(-1)
      narClobPrevPush(cprev)
      narClobDepthsPush(T.scopes.length)
      narClobRetiredPush(2)
      narClobBindPush(-1)
      narClobDeclPush(-1)
    }
    i = i + 1
  }
  0
}

// Settle the path narrowing in overlay slot `slot` that the call at `callIx` just ended: bank
// its key for the emitter to retire after the open statement, so reads after that statement
// read the declared type and a re-test narrows afresh. A slot of an enclosing function, or a
// call with no statement of its own function open, stays unsettled and keeps refusing (D2405).
function crPathCallRetire(slot: i32, callIx: i32) {
  if slot < crFnNpBase() { return 0 }
  crLoopReadCheck(slot, callIx)
  crCaptureCallCheck(slot, callIx)
  // A verdict an untyped receiver forced is the checker not knowing, not a write: it keeps the
  // refusal, so a re-check at the call's argument types decides rather than inheriting a
  // declared-type read this body never needed. A read each pin answers is that re-check (D3446).
  if crCalleeUnresolved(callIx) { return 0 }
  if crInHoleTemplate() && !tyIsWriteLandRead(npTys[slot]) { return 0 }
  const top = crStmtIxs.length - 1
  if top < 0 || crStmtFns[top] != crFnBases.length {
    // A monomorphization re-check opens no statement; the original check settled this call.
    if crCallSettled[callIx] ?? false { npSettleSetAt(slot, -1) }
    return 0
  }
  const st = crStmtIxs[top]
  npSettleSetAt(slot, st)
  // A quiet pass types the body before its receivers have types, so a method call there may
  // read as opaque; only the real pass's answer reaches the emitter.
  if inferQuiet { return 0 }
  crAfterBank[st] = crwAddName(crAfterBank[st] ?? ",", npKeys[slot])
  crCallSettled[callIx] = true
  crRetNames.push(npKeys[slot])
  crRetCalls.push(callIx)
  crRetNarTys.push(npTys[slot])
  crRetWideTys.push(-1)
  crRetRoots.push(crCurRoot())
  crRetLoops.push(false)
  0
}

// A path read under a narrowing an enclosing function made: the nested function may run after
// a call there has written the path.
function crNoteCaptureRead(key: string) {
  const slot = narrowedPathIx(key)
  if slot < 0 || slot >= crFnNpBase() { return 0 }
  // An in-place `map`/`filter` callback of the function that made the narrowing has run by the
  // time any later call does.
  const nf = crFnNpBases.length
  if nf >= 2 && slot >= crFnNpBases[nf - 2] {
    if crCallbackKeeps(crFnIxs[crFnIxs.length - 1], key) { return 0 }
  }
  if npCapBy[slot] < 0 { npCapBySetAt(slot, crFnIxs[crFnIxs.length - 1]) }
  0
}

// A read of a path whose captured narrowing `crPathCaptureLost` dropped, for the note a refusal
// of that read gains: the function that dropped it, at the scope depth it is checked in.
function crNoteLostRead(key: string, ix: i32) {
  const slot = narrowedPathIx(key)
  if slot < 0 || !crPathCaptureLost(slot, key) { return 0 }
  // The emitter replays no narrowing of this path into the body (`capWidenOf`, D3419).
  if crFnIxs.length > 0 && key.indexOf(",") < 0 {
    const fnIx = crFnIxs[crFnIxs.length - 1]
    crCapWidenBank[fnIx] = crwAddName(crCapWidenBank[fnIx] ?? ",", key)
  }
  if npInvBy[slot] >= 0 { return 0 }
  crLostPush(key, ix, crFnIxs[crFnIxs.length - 1], crFnBases.length, false)
  0
}

// Whether the path narrowing in overlay slot `slot` is lost to the nested function being checked:
// the slot belongs to an enclosing function, and a function between the two escapes — it may run
// after that function returns, when any holder of the object may have written the path (D2407).
function crPathCaptureLost(slot: i32, key: string): boolean {
  if (
    slot >= 0
    && slot < npAsg.length
    && slot < crFnNpBase()
    && npAsg[slot] == 1
  ) {
    return true
  }
  let lv = crFnNpBases.length - 1
  while lv >= 0 && slot < crFnNpBases[lv] {
    if crFnEscapesAt(lv, key) { return true }
    lv = lv - 1
  }
  false
}

// Whether the function checked at level `lv` of `crFnIxs` may run other than by a call of its
// handle in the body that makes it, or as a callback that runs inside the call it is handed to.
function crFnEscapesAt(lv: i32, key: string): boolean {
  const fnIx = crFnIxs[lv]
  // A top-level function is its own root, and any code of the module may call it.
  const isRoot = crFnRoots[lv] == fnIx
  if isRoot { return true }
  const h = crLambdaHandle(fnIx)
  if h == "" { return !crCallbackKeeps(fnIx, key) }
  let body = crProgRoot
  if lv >= 1 {
    const pf = P.nodes[crFnIxs[lv - 1]]
    if pf is FuncDecl { body = pf.fnBody }
  }
  let esc = crEscNames[body] ?? ""
  if esc == "" {
    esc = crEscWalk(body, false, ",")
    crEscNames[body] = esc
  }
  esc.indexOf("," + h + ",") >= 0
}

// A call that ends a path narrowing a nested function already read under is refused: that
// function may run after the call, reading the old narrowing (D2402).
function crCaptureCallCheck(slot: i32, callIx: i32) {
  const rd = npCapBy[slot]
  if rd < 0 { return 0 }
  // Calling the reader itself runs it now, under the narrowing.
  crwEnsure(crCurRoot())
  let own = crwBindOf[rd] ?? ""
  const rdn = P.nodes[rd]
  if rdn is FuncDecl {
    if rdn.fnName != "" { own = rdn.fnName }
  }
  if own != "" && calleeNameOf(callIx) == own { return 0 }
  // Nor can it run later once its only handle has gone out of scope without escaping.
  if own != "" && lookup(own) < 0 && !crNameEscapesHere(own) { return 0 }
  tErrCoded(
    "'"
      + npKeys[slot]
      + "' is read at its narrowed type by the function on line "
      + i32ToStr(nodeLineOf(rd))
      + ", which may run after "
      + crCallDesc(callIx, false)
      + " writes it — re-test '"
      + npKeys[slot]
      + "' inside that function",
    callIx,
    CODE_NARROWING_ENDED_BY_CALL,
  )
  0
}

// A call in a loop that ends a path narrowing made outside the loop is refused when the loop read
// the path under that narrowing before the call: the read runs again after the call (D2403).
function crLoopReadCheck(slot: i32, callIx: i32) {
  const fb = crFnReBase()
  let b = fb
  while b < reNpBases.length && reNpBases[b] <= slot { b = b + 1 }
  if b >= reNpBases.length { return 0 }
  let r = reRdMarks[b]
  while r < crLoopRdSlots.length {
    if crLoopRdSlots[r] == slot {
      tErrCoded(
        "'"
          + npKeys[slot]
          + "' was narrowed by a guard outside this loop, and "
          + crCallDesc(callIx, false)
          + " can write it, so the read on line "
          + i32ToStr(nodeLineOf(crLoopRdNodes[r]))
          + " would see the old narrowing on the next iteration — re-test '"
          + npKeys[slot]
          + "' inside the loop",
        callIx,
        CODE_NARROWING_ENDED_BY_CALL,
      )
      return 0
    }
    r = r + 1
  }
  0
}

// ── a call that may reassign a narrowed binding ends the narrowing (D2390) ─────────────────

// May the call at `callIx` write the place keyed `key` — a bare name, or a path such as `o.v` or
// `xs[0]`? The one question every narrowing-drop site asks, answering true when unsure, so a
// finer effects summary can replace the answer without touching a caller. DECISIONS.md, "A call
// that may reassign a narrowed binding ends the narrowing".
function callMayWrite(callIx: i32, key: string): boolean {
  if isPathKey(key) { return callInvalidatesNarrowedPath(callIx, key) }
  // Nothing reassigns a `const`, whatever a callee writes under its name (D3019).
  if isConstName(key) { return false }
  crCallReaches(callIx, key)
}

function crStmtLeave() {
  const top = crStmtIxs.length - 1
  if top < 0 { return 0 }
  if narDefStmt.length > 0 { narApplyDeferred(crStmtIxs[top]) }
  const pb = crStmtPend[top]
  while crPendNames.length > pb {
    crPendNames.pop()
    crPendCalls.pop()
    crPendNarTys.pop()
    crPendDepths.pop()
  }
  const rb = crStmtRd[top]
  while crRdRet.length > rb {
    crRdRet.pop()
    crRdIx.pop()
  }
  crStmtIxs.pop()
  crStmtFns.pop()
  crStmtPend.pop()
  crStmtRd.pop()
  crStmtScopes.pop()
  0
}

// Push a path entry `name.f` for each field the record `nt` stores narrower than the record
// `declTy` or another member of the union `declTy`, so the path rules decide when a write through
// another place ends `name` too. Members that cannot hold an `nt` need none. A list narrowed by
// its elements gets `name[*]` per nesting depth instead (`narFitElems`).
function narFitCompanions(name: string, declTy: i32, nt: i32) {
  while nfSlots.length > 0 && nfSlots[nfSlots.length - 1] >= npKeys.length {
    nfSlotsPop()
    nfNamesPop()
  }
  if nt < 0 || declTy < 0 { return 0 }
  const r = T.tys[nt]
  if r is TyObj { narFitFields(name, declTy, nt, r) }
  narFitElems(name, declTy, nt)
  0
}

function narFitFields(name: string, declTy: i32, nt: i32, r: TyObj) {
  let wide = declTy
  const dt = T.tys[declTy]
  if dt is TyNullable { wide = dt.nInner }
  if wide < 0 { return 0 }
  const u = T.tys[wide]
  narFitMembers(name, nt, r, if u is TyUnion { u.uMembers } else { [wide] })
  0
}

// `keyStepTags` for an element entry: the tags of the list as declared, since the narrowing
// says what its cells hold now and not which other lists may be the same object.
function listEveryTags(key: string, steps: string[]): string[] {
  const root = placeRootOf(key)
  let t = narDeclaredTy(root, -1)
  if t < 0 { t = lookup(root) }
  const out: string[] = []
  for st in steps {
    t = listUnionWidest(t)
    out.push(keyStepTag(st, t))
    if t >= 0 { t = placeElemTy(t) }
  }
  out
}

// The member of a union of lists `t` whose element every other member's element is assignable
// to, which may alias whatever any member may; `t` itself when there is none or it is no union.
function listUnionWidest(t: i32): i32 {
  const n = nonNullTy(t)
  if n < 0 { return t }
  const u = T.tys[n]
  if !(u is TyUnion) { return t }
  for m in u.uMembers {
    if m < 0 { return t }
  }
  for m in u.uMembers {
    const mt = T.tys[m]
    if mt is TyArray {
      let all = true
      for o in u.uMembers {
        const ot = T.tys[o]
        if !(ot is TyArray) || !assignable(ot.aElem, mt.aElem) { all = false }
      }
      if all { return m }
    }
  }
  t
}

// A list narrowed by its elements (`b is K[]`) narrows its reads only: delivered whole, or as a
// field or element of a literal, to a type its declared type does not fit, it would outlive the
// guard as a `K[]` the declared type still writes (D4928). Reports each such delivery and answers
// true when it reported one; a `map` copy is the conversion.
function narListDeliveryErr(srcExpr: i32, srcTy: i32, dstTy: i32): boolean {
  if srcExpr < 0 || dstTy < 0 { return false }
  const ix = peelParenIx(srcExpr)
  if ix < 0 || ix >= P.nodes.length { return false }
  const s = P.nodes[ix]
  if s is ObjLit { return narListDeliveryFields(s, nonNullTy(dstTy)) }
  if s is ArrayLit {
    const dn = nonNullTy(dstTy)
    if dn < 0 { return false }
    const da = T.tys[dn]
    if !(da is TyArray) { return false }
    let hit = false
    for e in s.arrElems {
      if narListDeliveryErr(e, nodeTyOf(e), da.aElem) { hit = true }
    }
    return hit
  }
  // The list itself, or a row of it still a list (`b[0]` under `b is K[][]`, D4945).
  const pfx = elemRecvPrefix(ix)
  if pfx == "" { return false }
  const name = elemKeyBase(pfx)
  const rows = elemKeyDepth(pfx)
  const slot = elemEverySlotOf(name)
  if slot < 0 || npInvBy[slot] >= 0 { return false }
  const key = npKeys[slot]
  const leaf = npTys[slot]
  const depth = elemKeyDepth(key) - rows
  if depth <= 0 { return false }
  const byName = narFitNameOf(slot) != ""
  if byName && !assignable(srcTy, dstTy) { return false }
  if !byName && !listLeafFits(leaf, dstTy, depth) { return false }
  // A field or subscript place is typed as declared, the narrowing being on its elements alone.
  let decl = srcTy
  if !isPathKey(name) {
    decl = narDeclaredTy(name, -1)
    if decl < 0 { decl = lookup(name) }
    let r = 0
    while r < rows && decl >= 0 {
      decl = placeElemTy(listUnionWidest(nonNullTy(decl)))
      r = r + 1
    }
  }
  if decl < 0 { return false }
  if narDeclFitsDst(decl, dstTy) {
    narListDeclReads[ix] = true
    return false
  }
  const text = narRowText(ix)
  const copy = "'" + text + mapCopyText(depth) + "'"
  tErr(
    "'"
      + text
      + "' is narrowed by `is` only for reading its elements; it is still declared "
      + tyToStr(decl)
      + " and a later write may widen it, so it cannot be delivered as "
      + tyToStr(dstTy)
      + ". Copy it with "
      + copy,
    ix,
  )
  true
}

// Whether a narrowed list's declared type `decl` fits `dst` at every instantiation. A type
// parameter in `decl` is gradual to `assignable`, so it fits a concrete `dst` only at some
// instances, and a delivery there would hand the other instances a fresh list (D4928).
function narDeclFitsDst(decl: i32, dst: i32): boolean {
  if !assignable(decl, dst) { return false }
  !tyHasTyVar(decl) || tyHasTyVar(dst)
}

// Whether a list `depth` deep whose leaf is `leaf` is delivered to `dst` leaf for leaf.
function listLeafFits(leaf: i32, dst: i32, depth: i32): boolean {
  let d = dst
  let k = 0
  while k < depth {
    const dn = nonNullTy(d)
    if dn < 0 { return false }
    const da = T.tys[dn]
    if !(da is TyArray) { return false }
    d = da.aElem
    k = k + 1
  }
  d >= 0 && assignable(leaf, d)
}

// `narListDeliveryErr` over the fields of a record literal delivered to the record type `dst`.
function narListDeliveryFields(o: ObjLit, dst: i32): boolean {
  let hit = false
  for fx in o.objFields {
    const f = P.nodes[fx]
    if f is FieldInit {
      const ft = tyFieldTyOf(dst, f.fiName)
      if ft >= 0 && narListDeliveryErr(f.fiValue, nodeTyOf(f.fiValue), ft) {
        hit = true
      }
    }
  }
  hit
}

// The fields of `r` (the record `nt`) a member of `mems` that holds every `nt` stores wider.
function narFitMembers(name: string, nt: i32, r: TyObj, mems: i32[]) {
  let f = 0
  while f < r.objFieldNames.length {
    const ft = r.objFieldTypes[f]
    let wider = false
    for m in mems {
      if (
        !wider
        && m >= 0
        && m != nt
        && T.tys[m] is TyObj
        && assignable(nt, m)
        && !assignable(m, nt)
      ) {
        const mo = T.tys[m]
        if mo is TyObj {
          const mt = objFieldType(mo, r.objFieldNames[f])
          wider = mt >= 0 && ft >= 0 && !tySame(mt, ft)
        }
      }
    }
    if wider {
      nfSlotsPush(npKeys.length)
      nfNamesPush(name)
      npKeysPush(name + "." + r.objFieldNames[f])
      npTysPush(ft)
      npInvByPush(-1)
      npEpochsPush(narFnEpoch)
      npSettlePush(-2)
      npCapByPush(-1)
      npAsgPush(0)
    }
    f = f + 1
  }
  0
}

// A declaration in a block inside a narrowed binding's scope shadows it, and a call there may
// still write that binding. Its narrowing ends in the checker at once, since nothing in the block
// can read it, and in the emitter after the statement holding the block, where the name reaches it
// again. `loopIx` >= 0 asks of the loop there rather than of the call `callIx` (D3020).
function crRetireShadowed(name: string, callIx: i32, loopIx: i32) {
  const ds = scopeDepthsOf[name]
  // A shadow needs a narrowed binding and a declaration over it; the narrowing may sit at the
  // binding's own depth (a straight-line write or a join installed there, D3306).
  if ds == null || ds.length < 2 { return 0 }
  let h = crShadowedHeight(name, ds.length)
  while h > 0 {
    const hidden: i32[] = []
    while ds.length > h {
      hidden.push(ds[ds.length - 1])
      ds.pop()
    }
    const st = crStmtHolding(hidden[hidden.length - 1])
    let c = callIx
    if loopIx >= 0 {
      c = -1
      if crMayBeWritten(name) { c = crFirstWritingCall(loopIx, name) }
    } else if !callMayWrite(c, name) {
      c = -1
    }
    // The join row names this binding, which only the joins outside the shadow reach.
    if c >= 0 && st >= 0 {
      crRetireAt(name, c, false, st, false, crBindDepthOf(name))
    }
    let k = hidden.length - 1
    while k >= 0 {
      ds.push(hidden[k])
      k = k - 1
    }
    h = crShadowedHeight(name, h)
  }
  0
}

// A nested function runs when called, so a captured narrowing of a binding some function may
// write reads at its declared type in the body, bound in the body's own scope. A lambda passed
// straight to an array's `map` or `filter` runs inside that call and keeps the narrowing, unless
// its own body may write the binding (D2402).
function crCaptureWiden(fnIx: i32) {
  if crCurRoot() == fnIx { return crRootCaptureWiden(fnIx) }
  // A body is checked more than once. The real pass decides alone, so it starts the bank over;
  // a quiet pass (return inference, a monomorphization re-check of a clone, whose root the
  // writer analysis cannot see) only adds, and widens what the bank already names.
  const prior = crCapWidenBank[fnIx] ?? ","
  if !inferQuiet { crCapWidenBank[fnIx] = "," }
  // A name an enclosing body widened is widened here too: the emitter records a nested
  // function's captures from the frame the whole nest is written in.
  let f = 0
  while f < crFnIxs.length - 1 {
    const up = crCapWidenBank[crFnIxs[f]] ?? ""
    if up != "" {
      const ups = weSplit(up)
      let u = 0
      while u < ups.length {
        crCapWidenBank[fnIx] = crwAddName(crCapWidenBank[fnIx] ?? ",", ups[u])
        u = u + 1
      }
    }
    f = f + 1
  }
  const base = crFnBase()
  if asgDeclKeys.length == 0 || asgDeclDepths[0] >= base { return 0 }
  let escapes = -1
  // Only a name the body reads needs an answer.
  const reads = crBodyReadNames(fnIx)
  let r = 0
  while r < reads.length {
    const nm = reads[r]
    const i = crInnerRowBelow(nm, base)
    if i >= 0 {
      const wide = crOuterWidest(nm, base)
      if wide >= 0 && wide != lookup(nm) {
        if inferQuiet && prior.indexOf("," + nm + ",") >= 0 {
          crDeclareWidened(nm, wide)
        } else if crCaptureLosesNarrowing(fnIx, nm, asgDeclKinds[i], wide) {
          crDeclareWidened(nm, wide)
          crCapWidenBank[fnIx] = crwAddName(crCapWidenBank[fnIx] ?? ",", nm)
          crCapLossBank[fnIx] = crwAddName(crCapLossBank[fnIx] ?? ",", nm)
          crCapLossAny = true
        } else if crElemNarrowLive(nm) && !crCallbackKeeps(fnIx, nm) {
          crDeclareWidened(nm, wide)
          crCapWidenBank[fnIx] = crwAddName(crCapWidenBank[fnIx] ?? ",", nm)
        } else if crCaptureMayGoStale(fnIx, nm) {
          if escapes < 0 { escapes = crLambdaEscapes(fnIx) }
          const fnWriter = crMayBeWritten(nm)
          if escapes == 0 && !fnWriter && !crNameAssigned(nm) {
            // Nothing can change it.
          } else if (
            escapes == 0
            && !crBodyMayWrite(fnIx, nm)
            && !crBodyTests(fnIx, nm)
          ) {
            crCapRecDepths.push(crFnBases.length - 1)
            const hd = crLambdaHandle(fnIx)
            crCapRecHandles.push(hd)
            crCapRecCount[hd] = (crCapRecCount[hd] ?? 0) + 1
            crCapRecNames.push(nm)
            crCapRecTys.push(lookup(nm))
            crCapRecFns.push(fnIx)
          } else {
            crDeclareWidened(nm, wide)
            crCapWidenBank[fnIx] = crwAddName(crCapWidenBank[fnIx] ?? ",", nm)
          }
        }
      }
    }
    r = r + 1
  }
  0
}

// Whether the nested function `fnIx` may read a captured narrowing of `name` after it stopped
// holding: some function may write the name, or the name is ever assigned and the nested function
// escapes the body making it, so it may run after that assignment (D2462). A callback run inside
// the call it is handed to cannot.
function crCaptureMayGoStale(fnIx: i32, name: string): boolean {
  if crCallbackKeeps(fnIx, name) { return false }
  if crMayBeWritten(name) { return true }
  crNameAssigned(name)
}

// Whether a captured narrowing of `name` cannot outlive the capture: the nested function `fnIx`
// may run after a write that may store `null`, and its body then reads the storage at the
// declared type (D2529). A guard's narrowing refuses such a write under it, and a callback run
// inside the call it is handed to runs before any later write, so both are left to D2402.
function crCaptureLosesNarrowing(
  fnIx: i32,
  name: string,
  kind: i32,
  wide: i32,
): boolean {
  if kind == NAR_KIND_GUARD { return false }
  if crCallbackKeeps(fnIx, name) { return false }
  if crNameIsModuleTop(name) { return crNameNulledInProgram(name) }
  // A shared cell of a scalar box is read at the box, so any later write ends it there (D2555).
  crCaptureByRef(crDeclFrameOf(name), name, crTyIsScalarBox(wide))
}

// Whether running the nested function `fnIx` may itself write `name`.
function crBodyMayWrite(fnIx: i32, name: string): boolean {
  const fd = P.nodes[fnIx]
  if fd is FuncDecl {
    if crSubtreeAssigns(fd.fnBody, name) { return true }
    return crFirstWritingCall(fd.fnBody, name) >= 0
  }
  true
}

// A call of a nested function that kept a captured narrowing is refused unless the binding
// still holds the captured type there: a writer may have run since the function's creation.
function crCapRecCheck(callIx: i32) {
  if crCapRecHandles.length == 0 { return 0 }
  const h = calleeNameOf(callIx)
  const cn = P.nodes[callIx]
  if !(cn is Call) || h == "?" { return 0 }
  if (crCapRecCount[h] ?? 0) <= 0 { return 0 }
  let r = 0
  while r < crCapRecHandles.length {
    if crCapRecHandles[r] == h && crCapRecDepths[r] == crFnBases.length {
      const nm = crCapRecNames[r]
      if !tySame(lookup(nm), crCapRecTys[r]) {
        let by = "a write"
        if crMayBeWritten(nm) { by = "a call" }
        tErrCoded(
          "'"
            + h
            + "', made on line "
            + i32ToStr(nodeLineOf(crCapRecFns[r]))
            + ", reads '"
            + nm
            + "' as "
            + tyToStr(crCapRecTys[r])
            + ", a narrowing "
            + by
            + " since then may have ended — re-test '"
            + nm
            + "' before this call, or inside '"
            + h
            + "'",
          callIx,
          CODE_NARROWING_ENDED_BY_CALL,
        )
        return 0
      }
    }
    r = r + 1
  }
  0
}

// Whether the lambda `fnIx`, written in place as a call's argument, runs only inside that call
// and nothing then writes the place keyed `key`: the callee is an array's `map`/`filter`, or a
// declaration whose body only ever calls that parameter, and the call reaches no writer. Its
// own body must neither write `key` nor call what may.
function crCallbackKeeps(fnIx: i32, key: string): boolean {
  if fnIx < 0 || fnIx >= P.nodes.length { return false }
  const fd = P.nodes[fnIx]
  if !(fd is FuncDecl) { return false }
  if (
    crSubtreeAssigns(fd.fnBody, key)
    || crFirstWritingCall(fd.fnBody, key) >= 0
  ) {
    return false
  }
  crwEnsure(crCurRoot())
  const c = crwArgCall[fnIx] ?? -1
  if c < 0 || c >= P.nodes.length { return false }
  const cn = P.nodes[c]
  if cn is Call {
    const d = callDeclFnIx(cn, c)
    const cf = P.nodes[cn.callFn]
    if cf is Member {
      if (cf.memProp == "map" || cf.memProp == "filter") && d == -2 {
        return true
      }
    }
    if d < 0 { return false }
    const args = callArgPlaces(cn, c)
    let at = -1
    let i = 0
    while i < args.length {
      if peelParenIx(args[i]) == fnIx { at = i }
      i = i + 1
    }
    if at < 0 || !crParamOnlyCalled(d, at) { return false }
    return !callMayWrite(c, key)
  }
  false
}

// The bare-name narrowings the call at `callIx` ends — a `Call`, or an operator that dispatched
// to a declaration. Runs after the call is checked, with the statement holding it still open.
function crNoteCallBare(callIx: i32) {
  if asgDeclKeys.length == 0 || crStmtIxs.length == 0 { return 0 }
  // A body checked with no statement of its own open (a monomorphization re-check) banks
  // nothing: the open statement is its caller's.
  if crStmtFns[crStmtFns.length - 1] != crFnBases.length { return 0 }
  const names = crLiveNames()
  let i = 0
  while i < names.length {
    if callMayWrite(callIx, names[i]) {
      crRetire(names[i], callIx, false, crStmtIxs[crStmtIxs.length - 1])
    }
    crRetireShadowed(names[i], callIx, -1)
    i = i + 1
  }
  0
}

// The first call in the subtree at `ix` that may write `name`, or -1.
function crFirstWritingCall(ix: i32, name: string): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = P.nodes[ix]
  if n is Call || crIsDispatchSite(ix) {
    if callMayWrite(ix, name) { return ix }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      const c = crFirstWritingCall(kids[k], name)
      if c >= 0 { return c }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  -1
}

// Whether a store of the value `valIx` (typed `rt` once checked, -1 before) into a cell `depth`
// subscripts below its list's name keeps the element-only entry in `slot` (`pushElemReadFact`):
// a store at the entry's own depth of a value its leaf admits.
function elemOnlyStoreKeeps(
  slot: i32,
  depth: i32,
  valIx: i32,
  rt: i32,
): boolean {
  if slot < 0 || slot >= npKeys.length || narFitNameOf(slot) != "" {
    return false
  }
  const key = npKeys[slot]
  const leaf = npTys[slot]
  if leaf < 0 || !keyIsListEvery(key) || elemKeyDepth(key) != depth {
    return false
  }
  let vt = loopWritePeekTy(valIx, leaf)
  if vt < 0 { vt = rt }
  vt >= 0 && !tyIsHole(vt) && !tyHasTyVar(vt) && assignable(vt, leaf)
}

// Whether the call `cn` is a `push` of values the element-only entry `key` admits onto a list at
// its depth (`elemOnlyStoreKeeps`), which keeps the entry.
function pushKeepsElemOnly(cn: Call, key: string): boolean {
  const cf = P.nodes[cn.callFn]
  if !(cf is Member) || cn.callArgs.length == 0 || cf.memProp != "push" {
    return false
  }
  const slot = narrowedPathIx(key)
  const depth = elemDepthOf(cf.memObj)
  if slot < 0 || depth < 0 { return false }
  if elemKeyBase(elemRecvPrefix(cf.memObj)) != elemKeyBase(key) { return false }
  for a in cn.callArgs {
    if spreadArgOf(a) >= 0 { return false }
    if !elemOnlyStoreKeeps(slot, depth + 1, a, nodeTyOf(a)) { return false }
  }
  true
}

// `crFirstWritingCall` for an element entry `key`: a `push` on a list narrowed by name is
// checked against its narrowed element, so only its arguments are asked.
function crFirstElemWritingCall(ix: i32, key: string): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = P.nodes[ix]
  let own = false
  if n is Call {
    const cf = P.nodes[n.callFn]
    if cf is Member {
      const ro = P.nodes[peelParenIx(cf.memObj)]
      if ro is Ident {
        own = (cf.memProp == "push"
          && key == ro.identName + LIST_EVERY_STEP
          && elemKeyStoresChecked(key))
      }
    }
    if !own { own = pushKeepsElemOnly(n, key) }
  }
  if !own && (n is Call || crIsDispatchSite(ix)) {
    if callMayWrite(ix, key) { return ix }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      const c = crFirstElemWritingCall(kids[k], key)
      if c >= 0 { return c }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  -1
}

// A loop re-runs the reads before a call after it, so a narrowing live at the loop that a call
// anywhere in the loop may end ends before the loop starts, in both halves.
function crLoopPreRetire(loopIx: i32) {
  if npKeys.length > 0 {
    cbPendForLoop(loopIx)
    crLoopPathPreRetire(loopIx)
    cbPendClear()
  }
  if asgDeclKeys.length == 0 { return 0 }
  const names = crLiveNames()
  let i = 0
  while i < names.length {
    let c = -1
    if crMayBeWritten(names[i]) { c = crFirstWritingCall(loopIx, names[i]) }
    // So does a write in the loop that leaves a guard's narrowing (D2609), or a straight-line
    // null strip's: the reads at the loop's top run again after it (D3302).
    if c < 0 && !isPathKey(names[i]) && narDeclaredTy(names[i], -1) >= 0 {
      c = crLoopLeavingWrite(loopIx, names[i])
    }
    if c >= 0 { crRetire(names[i], c, true, loopIx) }
    crRetireShadowed(names[i], -1, loopIx)
    i = i + 1
  }
  0
}

// The path twin: a live path narrowing a write in the loop may leave ends before the loop,
// in both halves, so the reads before that write read the place's declared type.
function crLoopPathPreRetire(loopIx: i32) {
  let s = crFnNpBase()
  if s < 0 { s = 0 }
  // The entries a map cell's presence pushes below are not walked again.
  const n0 = npKeys.length
  while s < n0 && s < npKeys.length {
    if (
      npInvBy[s] < 0
      && npEpochs[s] == narFnEpoch
      && narrowedPathIx(npKeys[s]) == s
    ) {
      let a = crLoopLeavingPathWrite(loopIx, npKeys[s], npTys[s])
      // A `for` over a list reads its next element at the loop's top, after the body's calls,
      // which no read check in the body sees; so an element narrowing a call may end ends here.
      let byCall = false
      if a < 0 && keyIsListEvery(npKeys[s]) {
        a = crFirstElemWritingCall(loopIx, npKeys[s])
        byCall = a >= 0
      }
      if a >= 0 {
        narSetInv(s, a)
        if nfSlots.length > 0 { narFitRetire(s, a, loopIx) }
        noteKillSure(a, npKeys[s])
        npSettleSetAt(s, -1)
        if !byCall { crAliasWr[a] = true }
        crLoopMapCellPresent(npKeys[s], a)
        crRetNames.push(npKeys[s])
        crRetCalls.push(a)
        crRetNarTys.push(npTys[s])
        crRetWideTys.push(-1)
        crRetRoots.push(crCurRoot())
        crRetLoops.push(true)
        crBeforeBank[loopIx] = crwAddName(
          crBeforeBank[loopIx] ?? ",",
          npKeys[s],
        )
        narClobKeysPush(npKeys[s])
        narClobTysPush(-1)
        narClobPrevPush(npTys[s])
        narClobDepthsPush(T.scopes.length)
        narClobRetiredPush(2)
        narClobBindPush(-1)
        narClobDeclPush(-1)
      }
    }
    s = s + 1
  }
  0
}

// A map cell narrowed before the loop is present, and the loop's writes keep it so: after its
// narrowing ends it reads the stored type, not the map read's `T | null`.
function crLoopMapCellPresent(key: string, asgIx: i32) {
  const an = P.nodes[asgIx]
  if an is BinExpr {
    if placeIsMapCell(an.binLeft) {
      const st = placeStoreTy(an.binLeft)
      if st >= 0 {
        npKeysPush(key)
        npTysPush(st)
        npInvByPush(-1)
        npEpochsPush(narFnEpoch)
        npSettlePush(-2)
        npCapByPush(-1)
        npAsgPush(0)
      }
    }
  }
  0
}

// The first assignment to the place keyed `key`, narrowed to `pre`, in the loop subtree at `ix`
// whose value, typed before the loop runs, leaves that narrowing; -1 otherwise.
function crLoopLeavingPathWrite(ix: i32, key: string, pre: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = P.nodes[ix]
  if n is FuncDecl { return -1 }
  if n is BinExpr {
    if n.binOp == "=" && placeKeyOf(n.binLeft) == key {
      const store = writeStorageTy(n.binLeft)
      let vt = loopWritePeekTy(n.binRight, store)
      if vt >= 0 && store >= 0 {
        if !isLitBearing(store) { vt = litPeekBaseTy(vt) }
        if !writeLandsWithin(store, vt, pre) { return ix }
      }
    } else if (
      n.binOp == "="
      && loopWriteMayReach(n.binLeft, n.binRight, key, pre)
    ) {
      return ix
    }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      const a = crLoopLeavingPathWrite(kids[k], key, pre)
      if a >= 0 { return a }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  -1
}

// Whether a loop's write to `tgt` of `val` may end the narrowing of `key` to `pre` on the next
// iteration though it names another place: a prefix of the key (`o = …` under `o.f`), a cell of
// its receiver at a computed index, or a same-named last step through another receiver, which may
// alias. An unknown value counts as leaving (D3308).
function loopWriteMayReach(tgt: i32, val: i32, key: string, pre: i32): boolean {
  const tk = placeKeyOf(tgt)
  if tk != "" && (keyHasPrefix(key, tk + ".") || keyHasPrefix(key, tk + "[")) {
    return true
  }
  const steps = keySteps(key)
  if steps.length == 0 { return false }
  const last = steps[steps.length - 1]
  const t = P.nodes[peelParenIx(tgt)]
  let same = false
  if t is Member { same = last == "." + t.memProp }
  if t is Index {
    const ks = narrowedPathIx(key)
    if ks >= 0 && elemOnlyStoreKeeps(ks, elemDepthOf(tgt), val, -1) {
      return false
    }
    // A store through a list narrowed by name is checked against its narrowed element.
    if last == LIST_EVERY_STEP && steps.length == 1 {
      const ra = P.nodes[peelParenIx(t.idxArr)]
      if ra is Ident {
        if ra.identName == placeRootOf(key) && elemKeyStoresChecked(key) {
          return false
        }
      }
    }
    // A literal subscript names its cell, as the straight-line rule reads it (D3317).
    if tk != "" {
      const tsteps = keySteps(tk)
      same = tsteps.length > 0 && tsteps[tsteps.length - 1] == last
      if last == LIST_EVERY_STEP { same = true }
    } else {
      same = last[0] == '['
    }
  }
  if !same { return false }
  // Another receiver's place carries no narrowing of its own, so it stores at its declaration.
  let store = writeStorageTy(tgt)
  if store < 0 { store = placeStoreTy(tgt) }
  let vt = loopWritePeekTy(val, store)
  if vt < 0 || store < 0 { return true }
  if !isLitBearing(store) { vt = litPeekBaseTy(vt) }
  !writeLandsWithin(store, vt, pre)
}

// The first assignment to the bare name `name` in the loop subtree at `ix` whose value, typed
// before the loop runs, leaves the narrowing `name` holds there, or -1. A value whose type
// needs the loop to decide is left to the write itself, which refuses what the loop's entry
// type does not admit.
function crLoopLeavingWrite(ix: i32, name: string): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = P.nodes[ix]
  if n is FuncDecl { return -1 }
  if n is BinExpr {
    if n.binOp == "=" && placeKeyOf(n.binLeft) == name {
      const store = narWriteStorage(name)
      const pre = lookup(name)
      let vt = loopWritePeekTy(n.binRight, store)
      if vt >= 0 && store >= 0 && pre >= 0 {
        if !isLitBearing(store) { vt = litPeekBaseTy(vt) }
        if !writeLandsWithin(store, vt, pre) { return ix }
      }
    }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      const a = crLoopLeavingWrite(kids[k], name)
      if a >= 0 { return a }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  -1
}

// Record at the `&&`/`||` node `ix` the left operand's facts its right operand retired, by a write
// or a call: the arm the whole condition guards must not hold them (D2589). Runs while the
// scope the facts live in is still open. A name faced twice is judged by its last fact, the one
// its scope holds.
function crNoteRhsRetired(
  ix: i32,
  rhs: i32,
  names: string[],
  tys: i32[],
  npBase: i32,
) {
  let out = ""
  let i = 0
  while i < names.length {
    let by = -1
    if isPathKey(names[i]) {
      let s = npBase
      while s < npKeys.length && by < 0 {
        if npKeys[s] == names[i] && npInvBy[s] >= 0 { by = npInvBy[s] }
        s = s + 1
      }
    } else if !crNameFacedLater(names, i) && lookup(names[i]) != tys[i] {
      by = crFirstAssignOf(rhs, names[i])
      if by < 0 { by = crFirstWritingCall(rhs, names[i]) }
      if by < 0 { by = rhs }
    }
    if by >= 0 {
      out = crwAddName(out, names[i])
      crRhsOps.push(ix)
      crRhsNames.push(names[i])
      crRhsBys.push(by)
    }
    i = i + 1
  }
  if out == "" {
    if crRhsRetired.length > 0 { crRhsRetired[ix] = "" }
    return 0
  }
  crRhsRetired[ix] = "," + out
  0
}

// Drop the facts collected since `mark` that a call inside the condition may falsify:
// the test ran before the call. Banked at the condition for the emitter's matching decline.
function crFilterCond(condIx: i32, names: string[], tys: i32[], mark: i32) {
  if names.length <= mark { return 0 }
  let w = mark
  let i = mark
  while i < names.length {
    let keep = true
    if crMayBeWritten(names[i]) {
      const wc = crFirstWritingCall(condIx, names[i])
      if wc >= 0 {
        keep = false
        crCondDropBank[condIx] = crwAddName(
          crCondDropBank[condIx] ?? ",",
          names[i],
        )
        crCondDropN = crCondDropN + 1
        crRetNames.push(names[i])
        crRetCalls.push(wc)
        crRetNarTys.push(tys[i])
        crRetWideTys.push(lookup(names[i]))
        crRetRoots.push(crCurRoot())
        crRetLoops.push(false)
      }
    }
    if keep {
      names[w] = names[i]
      tys[w] = tys[i]
      w = w + 1
    }
    i = i + 1
  }
  while names.length > w {
    names.pop()
    tys.pop()
  }
  0
}

// The read hook: a read of `name` after the call that retired it, in the same statement, is
// refused; any other read at the retired type is remembered for the misuse note. -1 lets the
// read through.
function crReadHook(name: string, ix: i32): i32 {
  if crRetNames.length == 0 { return -1 }
  let p = crPendNames.length - 1
  while p >= 0 {
    if crPendNames[p] == name {
      let tail = " earlier in this statement may reassign it — read '"
        + name
        + "' in a statement after the call, and re-test it there"
      // Read inside a block the call's statement holds — an `if` arm the call's condition guards.
      if crStmtIxs.length > crPendDepths[p] {
        tail = ", in the statement that holds this one, may reassign it — '"
          + name
          + "' can be read again after that statement"
      }
      tErrCoded(
        "'"
          + name
          + "' is no longer narrowed to "
          + tyToStr(crPendNarTys[p])
          + ": "
          + crCallDesc(crPendCalls[p], false)
          + tail,
        ix,
        CODE_NARROWING_ENDED_BY_CALL,
      )
      return TY_ERR
    }
    p = p - 1
  }
  if crStmtIxs.length == 0 { return -1 }
  const cur = lookup(name)
  const root = crCurRoot()
  let r = crRetNames.length - 1
  while r >= 0 {
    if crRetNames[r] == name && crRetRoots[r] == root {
      if crRetWideTys[r] == cur {
        crRdRet.push(r)
        crRdIx.push(ix)
      }
      return -1
    }
    r = r - 1
  }
  -1
}

// The diagnostic for reading a path whose narrowing a write retired. It names the write, not
// merely the nullness, because the write is what the reader has to act on — the guard above and
// the read below are both correct, and only their separation is wrong. An aliasing call and a
// direct assignment are the two ways a path narrowing dies, and the message says which.
function pathInvalidatedErr(key: string, byIx: i32, at: i32) {
  const by = P.nodes[byIx]
  let what = "the assignment"
  let after = "the assignment"
  if crAliasWr[byIx] ?? false {
    what = crCallDesc(byIx, false)
  } else if by is Call || (crOpCall[byIx] ?? false) {
    what = crCallDesc(byIx, false)
    after = "the call"
  }
  // A write that stored a non-null value narrows too (D1848), and is not a guard.
  let cause = "a guard"
  const slot = narrowedPathIx(key)
  if slot >= 0 && slot < npAsg.length {
    if npAsg[slot] == 1 { cause = "a write of a non-null value" }
  }
  // A field entry of a narrowed name is the compiler's, not the user's: name the binding.
  let shown = key
  if slot >= 0 {
    const fitName = narFitNameOf(slot)
    if fitName != "" { shown = fitName }
  }
  tErr(
    "'"
      + shown
      + "' was narrowed by "
      + cause
      + ", but "
      + what
      + " on line "
      + i32ToStr(nodeLineOf(byIx))
      + " can write it — re-test '"
      + shown
      + "' after "
      + after,
    at,
  )
  TY_ERR
}

// A `never` value cannot be stored: the expression never returns, so a slot typed by it would
// take a type no value has. Reports and answers true when `ty` is `never` (D1972).
function neverValueSlotErr(ty: i32, slot: string, at: i32) {
  if ty < 0 || ty != TY_NEVER { return false }
  tErr(
    slot
      + " would hold a `never` value, and none exists: the expression never returns",
    at,
  )
  true
}

// A `void` expression has no value, so a slot that demands one is a type error. This is the one
// home for that verdict on the positions whose demanded type comes from inference: with no written
// type there is nothing for `assignable` to compare against. `slot` names the demanding position,
// and the answer says whether the slot is refused, so the caller can substitute `TY_ERR`.
function voidValueSlotErr(ty: i32, exprIx: i32, slot: string, at: i32) {
  if !tyMentionsVoid(ty, 8) { return false }
  // The provisional-void exemption covers a wholly void if/match only: a union that mentions void
  // is a mixed arm join (`if c { f() } else { 1 }`), where the void is one arm's real type and no
  // position resolves it away.
  if isVoidTy(ty) {
    if voidSlotExemptExpr(exprIx) { return false }
  }
  tErr(slot + " expects a value, got " + tyToStr(ty), at)
  true
}

// A place's current type during fact collection: facts already collected into `names`/`tys`
// (innermost-last wins) override the path overlay, which overrides the scope or field lookup, so
// successive narrowings compose. Read-only — collection must never raise a diagnostic. Parens peel
// here too (D352), in the tail's own arm, or `(t).v` would key `t.v`, find no fact and answer -1.
function placeCurTy(ix: i32, names: string[], tys: i32[]) {
  const key = placeKeyOf(ix)
  if key != "" {
    let i = names.length - 1
    while i >= 0 {
      if names[i] == key { return tys[i] }
      i = i - 1
    }
    const ov = narrowedPathTy(key)
    if ov >= 0 { return ov }
  }
  const n = P.nodes[ix]
  if n is Paren { return placeCurTy(n.parInner, names, tys) }
  if n is Ident { return lookup(n.identName) }
  if n is Member {
    return placeFieldTy(placeCurTy(n.memObj, names, tys), n.memProp, false)
  }
  if n is OptMember {
    return placeFieldTy(placeCurTy(n.omObj, names, tys), n.omProp, true)
  }
  if n is Index { return placeElemTy(placeCurTy(n.idxArr, names, tys)) }
  -1
}

// The type of field `prop` read off `baseTy` for narrowing purposes (no diagnostics): an optional
// hop peels a nullable receiver and re-wraps the result nullable; the field resolves off a struct,
// or as a shared union field. -1 when unresolvable, and no narrowing is recorded then.
function placeFieldTy(baseTy: i32, prop: string, optional: boolean) {
  if baseTy < 0 { return -1 }
  const bt = T.tys[baseTy]
  let wasNullable = false
  let core = baseTy
  if bt is TyNullable {
    if !optional { return -1 }
    wasNullable = true
    core = bt.nInner
  }
  if core < 0 { return -1 }
  const ct = T.tys[core]
  let ft = -1
  if ct is TyObj {
    ft = objFieldType(ct, prop)
  } else if ct is TyUnion {
    ft = sharedUnionFieldTy(ct, prop)
  } else if ct is TyVar {
    if !wasNullable { ft = holePlaceFieldTy(core, ct, prop) }
  }
  if ft < 0 { return -1 }
  if wasNullable { return mkNullableTy(ft) }
  ft
}

// Shared-field access over a struct union: a field present on every member is readable on the
// union directly and its type is the join of the per-member field types. -1 when a member lacks
// the field or is not a struct. The join is what admits a discriminated union, whose arms carry
// the tag at mutually unassignable literal types; whether the read lowers is `sharedUnionFieldPlan`'s.
function sharedUnionFieldTy(u: TyUnion, prop: string) {
  const members = u.uMembers
  if members.length < 1 { return -1 }
  let shared = -1
  let i = 0
  while i < members.length {
    const mIx = members[i]
    if mIx < 0 { return -1 }
    const m = T.tys[mIx]
    if m is TyObj {
      const ft = objFieldType(m, prop)
      if ft < 0 { return -1 }
      if shared < 0 {
        shared = ft
      } else {
        // Runtime field values of different numeric types join apart, as an `if` over the
        // members' reads would.
        njApartSet(true)
        shared = joinTys(shared, ft)
      }
    } else {
      return -1
    }
    i = i + 1
  }
  shared
}

// Refuses a shared-field read whose join would hold a list of one member's field type as a
// list another member stores differently, the refusal an `if` over the members' reads takes
// (`listJoinWidenCheck`). True when it refused.
function sharedFieldJoinWidens(
  u: TyUnion,
  prop: string,
  sf: i32,
  ix: i32,
): boolean {
  for mIx in u.uMembers {
    if mIx >= 0 && mIx < T.tys.length {
      const m = T.tys[mIx]
      if m is TyObj {
        const ft = objFieldType(m, prop)
        if ft >= 0 && listJoinStorageDiffers(ft, sf, 8) {
          tErr(
            "`"
              + prop
              + "` is "
              + tyToStr(ft)
              + " on "
              + tyToStr(mIx)
              + " and the members' read would join it as "
              + tyToStr(sf)
              + ": a container never widens implicitly, so narrow the receiver to one member first",
            ix,
          )
          return true
        }
      }
    }
  }
  false
}

// Refuses a write through a union receiver of a value some member's field cannot hold: the
// read types the field as the members' join, and the write has to fit their meet. True when it
// refused.
function sharedFieldWriteRefused(
  tgt: Member,
  valIx: i32,
  vt: i32,
  ix: i32,
): boolean {
  const rt = nodeTyIxOf(parenPeelIx(tgt.memObj))
  if rt < 0 || rt >= T.tys.length || vt < 0 { return false }
  const r = T.tys[rt]
  if r is TyUnion {
    for mIx in r.uMembers {
      if mIx >= 0 && mIx < T.tys.length {
        const m = T.tys[mIx]
        if m is TyObj {
          const ft = objFieldType(m, tgt.memProp)
          if ft >= 0 && !assignableExpr(valIx, vt, ft) {
            tErr(
              "cannot assign "
                + tyToStr(vt)
                + " to `"
                + tgt.memProp
                + "` through a union: "
                + tyToStr(mIx)
                + " stores it as "
                + tyToStr(ft)
                + " — a write must fit every member, so narrow the receiver first",
              ix,
            )
            return true
          }
        }
      }
    }
  }
  false
}

// Two arena types denoting the same variant (mutually assignable). A generic
// type variable is never "the same variant" as anything — the host's hole
// guard (`isHole`) — so narrowing never pins an un-instantiated parameter.
function sameVariantTy(a: i32, b: i32) {
  if a < 0 || b < 0 { return false }
  const ta = T.tys[a]
  if ta is TyVar { return false }
  const tb = T.tys[b]
  if tb is TyVar { return false }
  // Named variants resolve to one canonical arena entry (`cUserTypes`), so
  // the common same-variant case is index equality — skip both traversals.
  if a == b { return true }
  // `A[]` and `B[]` are two variants though each is assignable to the other in the body (D2760).
  if tyParamsPart(a, b, 0) { return false }
  if !assignable(a, b) { return false }
  assignable(b, a)
}

// Remove a variant from a union or nullable, returning the residual type — the else-branch
// narrowing of `if x is A { … } else { … }`, where `x` is `U − A`. Returns -1 both when nothing
// concrete is removed (open-world negation is not tracked) and when nothing remains, a dead branch
// the caller does not overlay.
export function subtractTy(ty: i32, removed: i32) {
  if ty < 0 || removed < 0 { return -1 }
  const drop: i32[] = []
  flattenVariantsInto(removed, drop)
  const vars: i32[] = []
  flattenVariantsInto(ty, vars)
  const kept: i32[] = []
  let i = 0
  while i < vars.length {
    const v = vars[i]
    let hit = false
    let j = 0
    while j < drop.length {
      if sameVariantTy(v, drop[j]) { hit = true }
      j = j + 1
    }
    if !hit { kept.push(v) }
    i = i + 1
  }
  if kept.length == vars.length { return -1 }
  if kept.length == 0 { return -1 }
  // Reassemble the residual: a surviving `null` folds back into a nullable.
  let hasNull = false
  const core: i32[] = []
  let k = 0
  while k < kept.length {
    if isNullTy(kept[k]) { hasNull = true } else { core.push(kept[k]) }
    k = k + 1
  }
  if core.length == 0 { return TY_NULL }
  let res = core[0]
  if core.length > 1 { res = mkUnionTy(core) }
  if hasNull { return mkNullableTy(res) }
  res
}

// `A & !B` under an intersection fold: drop B's variants from A. It differs from the narrowing
// `subtractTy` in its edges — nothing concrete dropped leaves A unchanged (open-world negation,
// `i32 & !2`), everything dropped folds to `never`, an empty intersection.
function isectSubtract(ty: i32, removed: i32) {
  if ty < 0 || removed < 0 { return -1 }
  const drop: i32[] = []
  flattenVariantsInto(removed, drop)
  const vars: i32[] = []
  flattenVariantsInto(ty, vars)
  const kept: i32[] = []
  let i = 0
  while i < vars.length {
    const v = vars[i]
    let hit = false
    let j = 0
    while j < drop.length {
      if sameVariantTy(v, drop[j]) { hit = true }
      j = j + 1
    }
    if !hit { kept.push(v) }
    i = i + 1
  }
  if kept.length == vars.length { return ty }
  if kept.length == 0 { return TY_NEVER }
  let hasNull = false
  const core: i32[] = []
  let k = 0
  while k < kept.length {
    if isNullTy(kept[k]) { hasNull = true } else { core.push(kept[k]) }
    k = k + 1
  }
  if core.length == 0 { return TY_NULL }
  let res = core[0]
  if core.length > 1 { res = mkUnionTy(core) }
  if hasNull { return mkNullableTy(res) }
  res
}

// Fold `A & B`: a negation operand subtracts, a union operand distributes (`(0|1|2) & !2` →
// `0 | 1`), two object types merge field-wise (`{a} & {b}` is `{a, b}`, a shared field refining to
// the meet), a subtype pair keeps the narrower side, and a disjoint concrete pair folds to `never`,
// there being no common values. -1, unresolved, poisons the fold.
function intersectTy(a: i32, b: i32) {
  if a < 0 || b < 0 { return -1 }
  const tb = T.tys[b]
  if tb is TyNeg { return isectSubtract(a, tb.negTy) }
  const ta = T.tys[a]
  if ta is TyNeg { return isectSubtract(b, ta.negTy) }
  if ta is TyUnion { return isectDistribute(ta.uMembers, b) }
  if tb is TyUnion { return isectDistribute(tb.uMembers, a) }
  if ta is TyObj {
    if tb is TyObj {
      // Structural field-wise merge: the value that is both carries every field of each side, and
      // a shared field is the meet of the two.
      const mnames: string[] = []
      const mtys: i32[] = []
      const anames = ta.objFieldNames
      const atys = ta.objFieldTypes
      let ai = 0
      while ai < anames.length {
        mnames.push(anames[ai])
        mtys.push(atys[ai])
        ai = ai + 1
      }
      const bnames = tb.objFieldNames
      const btys = tb.objFieldTypes
      let bi = 0
      while bi < bnames.length {
        let at2 = -1
        let mi = 0
        while mi < mnames.length {
          if mnames[mi] == bnames[bi] { at2 = mi }
          mi = mi + 1
        }
        if at2 >= 0 {
          mtys[at2] = intersectTy(mtys[at2], btys[bi])
        } else {
          mnames.push(bnames[bi])
          mtys.push(btys[bi])
        }
        bi = bi + 1
      }
      return mkObjTy(mnames, mtys)
    }
  }
  if assignable(a, b) { return a }
  if assignable(b, a) { return b }
  TY_NEVER
}

// Distribute an intersection over a union operand: `(A | B) & C` is
// `(A & C) | (B & C)`, dropping members that fold to `never`.
function isectDistribute(members: i32[], other: i32) {
  const kept: i32[] = []
  let i = 0
  while i < members.length {
    const r = intersectTy(members[i], other)
    if r >= 0 && !isNeverTy(r) {
      let dup = false
      let j = 0
      while j < kept.length {
        if sameVariantTy(r, kept[j]) { dup = true }
        j = j + 1
      }
      if !dup { kept.push(r) }
    }
    i = i + 1
  }
  if kept.length == 0 { return TY_NEVER }
  if kept.length == 1 { return kept[0] }
  mkUnionTy(kept)
}

// Whether `xs is chk` over the single list `cur` (or `cur | null`) narrows only its literal-set
// leaf, which keeps its storage: the name keeps its list type, since narrowed by name it would be
// delivered as `chk` while still holding what `cur` may store.
function listNarrowsElemsOnly(cur: i32, chk: i32): boolean {
  const d0 = nonNullTy(cur)
  let d = d0
  let n = chk
  if d < 0 || n < 0 || tyHasTyVar(d) || !(T.tys[d] is TyArray) { return false }
  while d >= 0 && n >= 0 && T.tys[d] is TyArray && T.tys[n] is TyArray {
    const da = T.tys[d]
    const na = T.tys[n]
    if da is TyArray && na is TyArray {
      d = da.aElem
      n = na.aElem
    }
  }
  if d < 0 || n < 0 || tySame(d, n) || !assignable(n, d) { return false }
  if listFitLitLeafOf(chk, d0, []) < 0 { return false }
  listFitNarrowKeepsRep(cur, chk)
}

// The discriminant rule: a test on a struct union's field refines the union itself, which is why a
// tag is written at all — the arms differ in it precisely so that reading it says which arm you
// have. A member survives when its own field type is still inhabitable under the fact. Four
// refusals: a `?.` hop, a member without the field, zero survivors, and all survivors.
function pushDiscrimParentFact(
  placeIx: i32,
  fieldTy: i32,
  names: string[],
  tys: i32[],
  bankIx: i32,
  elseBank: boolean,
  mode: DiscrimMode,
) {
  if fieldTy < 0 { return 0 }
  const n = P.nodes[placeIx]
  if !(n is Member) { return 0 }
  if placeHasOptionalHop(placeIx) { return 0 }
  const recvTy = placeCurTy(n.memObj, names, tys)
  if recvTy < 0 { return 0 }
  const rt = T.tys[recvTy]
  if !(rt is TyUnion) { return 0 }
  const ms = rt.uMembers
  const kept: i32[] = []
  let i = 0
  while i < ms.length {
    if ms[i] < 0 { return 0 }
    const m = T.tys[ms[i]]
    if !(m is TyObj) { return 0 }
    const ft = objFieldType(m, n.memProp)
    if ft < 0 { return 0 }
    if mode == "exclude" {
      // The complement of an equality: `s.kind == "circle"` being false rules out exactly the arms
      // whose tag can only be `"circle"` — `assignable(ft, fact)` says every value of that field is
      // the literal. An arm whose tag is a wider set survives, since it can hold something else.
      // That asymmetry is why this is not the intersect test negated.
      if !assignable(ft, fieldTy) { kept.push(ms[i]) }
    } else if assignable(fieldTy, ft) || assignable(ft, fieldTy) {
      kept.push(ms[i])
    }
    i = i + 1
  }
  if kept.length == 0 { return 0 }
  if kept.length == ms.length { return 0 }
  let res = kept[0]
  if kept.length > 1 { res = mkUnionTy(kept) }
  // Bank the answer for the emitter's narrowing stack (`isParentTyIxOf` / `isParentElseTyIxOf`),
  // which cannot re-derive it from the tested spelling. Guarded on the node being in range: an
  // emitter-synthesized `is` falls past the end and reads -1, which is the "push nothing" answer.
  if bankIx >= 0 {
    if elseBank {
      if bankIx < isTyColCap {
        while isParentElseTyIx.length <= bankIx { isParentElseTyIx.push(-1) }
        isParentElseTyIx[bankIx] = res
      }
    } else if bankIx < isTyColCap {
      while isParentTyIx.length <= bankIx { isParentTyIx.push(-1) }
      isParentTyIx[bankIx] = res
    }
  }
  pushNarrowFact(n.memObj, res, names, tys)
}

// For a guard on an optional chain (`x?.y is T`), the truthy branch also implies every `?.`
// receiver is non-null — push those facts innermost-first, each resolving against an
// already-narrowed receiver, so the body's regular `x.y` reads resolve. Then branch only.
function pushOptChainThenFacts(placeIx: i32, names: string[], tys: i32[]) {
  const n = P.nodes[placeIx]
  if n is Member {
    pushOptChainThenFacts(n.memObj, names, tys)
    return 0
  }
  if n is OptMember {
    pushOptChainThenFacts(n.omObj, names, tys)
    const cur = placeCurTy(n.omObj, names, tys)
    const inner = nonNullNarrowTy(cur)
    if inner >= 0 && inner != cur { pushNarrowFact(n.omObj, inner, names, tys) }
    return 0
  }
  0
}

// `x == L` over a literal union narrows `x` as `x is L` does (Q10): to the literal where the test
// holds, to the union less the literal where it fails. `holds` names the side being collected.
// Only an operand whose every member is a literal narrows; a plain `string` or `i32` stays as is.
function pushLitEqFact(
  condIx: i32,
  holds: boolean,
  names: string[],
  tys: i32[],
) {
  const lp = litCmpPlace(condIx)
  if lp < 0 { return 0 }
  const lit = litCmpTy(condIx)
  if lit < 0 { return 0 }
  const place = asgTestedPlace(lp)
  if !holds && placeHasOptionalHop(place) { return 0 }
  const cur = placeCurTy(place, names, tys)
  if cur < 0 { return 0 }
  let base = cur
  const ct = T.tys[cur]
  if ct is TyNullable { base = ct.nInner }
  if !allLitMembers(base) { return 0 }
  if isWideLitJoin(base) { return 0 }
  // The tested literal, banked as an `is` node banks its type: the emitter narrows a boxed
  // receiver through the same `is` channel, keyed on this comparison node.
  recordClonedIsVarTyIx(condIx, lit)
  if holds {
    const meet = litSetMeetTy(cur, lit)
    if meet >= 0 { return pushNarrowFact(place, meet, names, tys) }
    if meet == -1 && assignable(lit, base) {
      return pushNarrowFact(place, lit, names, tys)
    }
    return 0
  }
  pushNarrowFact(place, subtractTy(cur, lit), names, tys)
}

// Collect the narrowings that hold when `cond` is true into the parallel `names`/`tys` arrays,
// keyed by place path: `x != null` strips x's null, `x is T` pins x to T (`is null` pins to the
// null type), `a && b` contributes both conjuncts, `!(e)` contributes e's false narrowings, and
// parens recurse. A guard over an optional chain also narrows each `?.` receiver non-null.
function collectThenNarrows(condIx: i32, names: string[], tys: i32[]) {
  const mark = names.length
  collectThenNarrowsRaw(condIx, names, tys)
  crFilterCond(condIx, names, tys, mark)
}

function collectThenNarrowsRaw(condIx: i32, names: string[], tys: i32[]) {
  const cond = P.nodes[condIx]
  if cond is Paren { return collectThenNarrows(cond.parInner, names, tys) }
  if cond is Unary {
    if cond.unOp == "!" { return collectElseNarrows(cond.unArg, names, tys) }
    return 0
  }
  if cond is IsExpr {
    const isPl = asgTestedPlace(cond.isObj)
    pushOptChainThenFacts(cond.isObj, names, tys)
    if cond.isVariant == "null" {
      pushNarrowFact(isPl, TY_NULL, names, tys)
    } else {
      let tIdx = isTypeTyRead(cond.isVariant, condIx)
      // An overlapping literal set narrows to the overlap, as `checkIsExprNode` tests it.
      const isCur = placeCurTy(isPl, names, tys)
      let meet = litSetMeetTy(isCur, tIdx)
      if meet < 0 { meet = recFitMeetTy(isCur, tIdx) }
      if meet >= 0 { tIdx = meet }
      // A value that passed may be laid out as another arm (D4056): only `null` leaves.
      if (
        tIdx >= 0
        && (recIsFitsAcrossTags(isCur, tIdx) || listIsFitsAcrossReps(isCur, tIdx))
      ) {
        const nn = nonNullNarrowTy(isCur)
        if nn >= 0 && nn != isCur { pushNarrowFact(isPl, nn, names, tys) }
        // A list that keeps its storage still narrows its element reads (ruling (c), D4928).
        if (
          listIsFitsAcrossReps(isCur, tIdx)
          && recFitNarrowKeepsRep(isCur, tIdx)
        ) {
          pushElemReadFact(isPl, isCur, tIdx, names, tys)
        }
      } else if tIdx >= 0 && listNarrowsElemsOnly(isCur, tIdx) {
        // A list keeps its declared type and narrows its element reads (ruling (c), D4945).
        const nn = nonNullNarrowTy(isCur)
        if nn >= 0 && nn != isCur { pushNarrowFact(isPl, nn, names, tys) }
        pushElemReadFact(isPl, isCur, tIdx, names, tys)
      } else if (
        tIdx >= 0
        && recFitNarrowKeepsRep(isCur, tIdx)
        && listFitNarrowKeepsRep(isCur, tIdx)
      ) {
        pushNarrowFact(isPl, tIdx, names, tys)
        pushDiscrimParentFact(
          isPl,
          tIdx,
          names,
          tys,
          condIx,
          false,
          "intersect",
        )
      } else if tIdx >= 0 && recFitNarrowKeepsRep(isCur, tIdx) {
        pushElemReadFact(isPl, isCur, tIdx, names, tys)
      }
    }
    return 0
  }
  if cond is BinExpr {
    if cond.binOp == "&&" {
      const lmark = names.length
      collectThenNarrows(cond.binLeft, names, tys)
      crFilterRhsRetired(condIx, names, tys, lmark)
      collectThenNarrows(cond.binRight, names, tys)
      return 0
    }
    if cond.binOp == "!=" {
      const placeIx = asgTestedPlace(nullCmpPlace(condIx))
      if placeIx >= 0 {
        pushOptChainThenFacts(placeIx, names, tys)
        const cur = placeCurTy(placeIx, names, tys)
        const inner = nonNullNarrowTy(cur)
        if inner >= 0 && inner != cur {
          pushNarrowFact(placeIx, inner, names, tys)
        }
      }
      pushLitEqFact(condIx, false, names, tys)
    }
    // `s.kind == "circle"` — the discriminant in the spelling a user reaches for without
    // declaring a tag alias first, since `is KC` needs a name to test against. Only the parent is
    // narrowed, not the tested field: pinning `s.kind` to a bare `TyLit` would put a literal type
    // where the field's own rep — an interned atom, or a plain string — is what consumers read.
    if cond.binOp == "==" {
      const eqPlace = litCmpPlace(condIx)
      if eqPlace >= 0 {
        const eqTy = litCmpTy(condIx)
        if eqTy >= 0 {
          pushDiscrimParentFact(
            eqPlace,
            eqTy,
            names,
            tys,
            condIx,
            false,
            "intersect",
          )
        }
      }
      pushLitEqFact(condIx, true, names, tys)
    }
    return 0
  }
  // Inferred type-guard call: `if present(v)` narrows `v` the way the guard's body narrows its
  // parameter — non-null here when the guard's non-null branch is the then arm.
  if cond is Call {
    const gArg = guardCallPlace(cond, 1)
    if gArg >= 0 {
      pushOptChainThenFacts(gArg, names, tys)
      const gCur = placeCurTy(gArg, names, tys)
      const gInner = nonNullNarrowTy(gCur)
      if gInner >= 0 && gInner != gCur {
        pushNarrowFact(gArg, gInner, names, tys)
      }
    }
    return 0
  }
  0
}

// `subtractTy` for an `is` test's else arm. A concrete tested type stays apart from a type
// parameter's list, as in a return set: the else of `is i32[]` over `T[] | i32[]` is `T[]`, the
// arm each instance's emitter reads there. The else of `is T[]` keeps the whole union.
function elseRemainderTy(cur: i32, tIdx: i32): i32 {
  if tyHasTyVar(tIdx) { return subtractTy(cur, tIdx) }
  const saved = tpApartConcrete
  tpApartConcreteSet(true)
  const sub = subtractTy(cur, tIdx)
  tpApartConcreteSet(saved)
  sub
}

// Collect the narrowings that hold when `cond` is false: `x == null` strips the null in the else
// branch, `x is null` false means non-null, `x is T` false leaves the union complement `U − T`,
// `a || b` contributes both disjuncts (neither held), `!(e)` contributes e's true narrowings, and
// parens recurse. A place behind a `?.` hop is never else-narrowed, the chain being possibly null.
function collectElseNarrows(condIx: i32, names: string[], tys: i32[]) {
  const mark = names.length
  collectElseNarrowsRaw(condIx, names, tys)
  crFilterCond(condIx, names, tys, mark)
}

function collectElseNarrowsRaw(condIx: i32, names: string[], tys: i32[]) {
  const cond = P.nodes[condIx]
  if cond is Paren { return collectElseNarrows(cond.parInner, names, tys) }
  if cond is Unary {
    if cond.unOp == "!" { return collectThenNarrows(cond.unArg, names, tys) }
    return 0
  }
  if cond is IsExpr {
    const isPl = asgTestedPlace(cond.isObj)
    if placeHasOptionalHop(cond.isObj) { return 0 }
    const cur = placeCurTy(isPl, names, tys)
    if cond.isVariant == "null" {
      // The null face of the same hole (D1243), now the shared reader's — see its header.
      const inner = nonNullNarrowTy(cur)
      if inner >= 0 && (inner != cur || narPathHeldNonNull(isPl, inner)) {
        pushNarrowFact(isPl, inner, names, tys)
      }
    } else {
      const tIdx = isTypeTyRead(cond.isVariant, condIx)
      if tIdx >= 0 {
        let sub = elseRemainderTy(cur, tIdx)
        // A hole has no member list to subtract from, so the remainder is deferred to the pin
        // rather than lost. Without it the `else` arm of `if a is string` over an un-annotated
        // parameter reads `a` at the full pinned union and `a * 2` refuses a program whose
        // annotated twin runs (D1243). `holeElseRemainderOk` says which types it may mint for.
        if sub < 0 && holeElseRemainderOk(tIdx) {
          sub = mkDerivedHole(HD_GNOT, "", -1, tIdx, cur)
        }
        // On a hole's field, a shape `T` leaves the hole itself as the arm's fact, so a write
        // or call that ends the remainder the instance narrows to re-asks the reads after it
        // at the pin (D3420). A bare name keeps no fact, so it reads at its demand.
        const hk = placeKeyOf(isPl)
        if sub < 0 && tyIsHole(cur) && hk != "" && isPathKey(hk) {
          holeElseTestedSetAt(hk + "|" + i32ToStr(cur), tIdx)
          pushNarrowFact(isPl, cur, names, tys)
          return 0
        }
        pushNarrowFact(isPl, sub, names, tys)
        // The complement, banked into the else table. `setNarrowFromCondElse` declines to
        // else-narrow a struct union, so a checker-only complement would type `else { s.w }` clean
        // for an emitter still seeing the full union — trading an accurate `field 'w' is not on
        // every member` for an obscure emit reject. Both layers carry it, so they agree.
        pushDiscrimParentFact(isPl, sub, names, tys, condIx, true, "intersect")
      }
    }
    return 0
  }
  if cond is BinExpr {
    if cond.binOp == "||" {
      const lmark = names.length
      collectElseNarrows(cond.binLeft, names, tys)
      crFilterRhsRetired(condIx, names, tys, lmark)
      collectElseNarrows(cond.binRight, names, tys)
      return 0
    }
    if cond.binOp == "==" {
      const placeIx = asgTestedPlace(nullCmpPlace(condIx))
      if placeIx >= 0 {
        if !placeHasOptionalHop(placeIx) {
          const cur = placeCurTy(placeIx, names, tys)
          const inner = nonNullNarrowTy(cur)
          if (
            inner >= 0
            && (inner != cur || narPathHeldNonNull(placeIx, inner))
          ) {
            pushNarrowFact(placeIx, inner, names, tys)
          }
        }
      }
      // `if s.kind == "circle" { … } else { … }` — the else arm of the discriminant. The test
      // being false rules out exactly the arms whose tag can only be that literal, so the fact is
      // the literal and the mode is `"exclude"`; see its header for why that is not the positive
      // test negated.
      const eqPlace = litCmpPlace(condIx)
      if eqPlace >= 0 {
        const eqTy = litCmpTy(condIx)
        if eqTy >= 0 {
          pushDiscrimParentFact(
            eqPlace,
            eqTy,
            names,
            tys,
            condIx,
            true,
            "exclude",
          )
        }
      }
      pushLitEqFact(condIx, false, names, tys)
    }
    if cond.binOp == "!=" { pushLitEqFact(condIx, true, names, tys) }
    return 0
  }
  // Inferred type-guard call: `if absent(p) { … } else { /* p != null */ }` — non-null in the else
  // branch when the guard's non-null branch is the else.
  if cond is Call {
    const gArg = guardCallPlace(cond, 0)
    if gArg >= 0 {
      if !placeHasOptionalHop(gArg) {
        const gCur = placeCurTy(gArg, names, tys)
        const gInner = nonNullNarrowTy(gCur)
        if gInner >= 0 && gInner != gCur {
          pushNarrowFact(gArg, gInner, names, tys)
        }
      }
    }
    return 0
  }
  0
}

// Apply collected narrowings around a branch: a bare name shadows through the scope chain (the
// caller pushes a scope first), a property path rides the `npKeys`/`npTys` overlay, whose entries
// the matching `popScope` unwinds. A bare name's shadow carries its declared type across, banked
// for `writeStorageTy`, and its constness, without which the `const` reject vanishes in a guard.
function applyNarrows(names: string[], tys: i32[]) {
  let i = 0
  while i < names.length {
    if isPathKey(names[i]) {
      npKeysPush(names[i])
      npTysPush(tys[i])
      npInvByPush(-1)
      npEpochsPush(narFnEpoch)
      npSettlePush(-2)
      npCapByPush(-1)
      npAsgPush(0)
    } else {
      const wasConst = isConstName(names[i])
      let wasDecl = -1
      if wasConst { wasDecl = constDeclOf(names[i]) }
      const declTy = lookup(names[i])
      if declTy >= 0 && declTy != tys[i] {
        noteNarShadow(names[i], declTy, NAR_KIND_GUARD)
      }
      declare(names[i], tys[i])
      if declTy >= 0 && declTy != tys[i] {
        narFitCompanions(names[i], declTy, tys[i])
      }
      if wasConst {
        const ctop = constScopes.length - 1
        if ctop >= 0 { constScopes[ctop][names[i]] = wasDecl }
      }
    }
    i = i + 1
  }
  0
}

// Leave the innermost scope, unwinding what it pushed.
function popScope() {
  flushUninferred(T.scopes.length - 1)
  while (
    crWideDepths.length > 0
    && crWideDepths[crWideDepths.length - 1] >= T.scopes.length - 1
  ) {
    crWideDepths.pop()
    crWideNames.pop()
  }
  crPopSoleTo(T.scopes.length - 1)
  if narWrNames.length > 0 { narWrPopTo(T.scopes.length - 1) }
  if T.scopes.length > 0 {
    for k in T.scopes[T.scopes.length - 1] {
      const ds = scopeDepthsOf[k]
      if ds != null { ds.pop() }
    }
  }
  T.scopes.pop()
  constScopes.pop()
  fnDeclScopes.pop()
  fnAliasScopes.pop()
  // The collapsed-binding marks go with the frame their bindings did (D1048). One length test
  // when the list is empty, which is nearly every program.
  collBindPopTo(T.scopes.length)
  if npFrames.length > 0 {
    const base = npFrames[npFrames.length - 1]
    npFramesPop()
    while npKeys.length > base {
      npKeysPop()
      npTysPop()
      npInvByPop()
      npEpochsPop()
      npSettlePop()
      npCapByPop()
      npAsgPop()
    }
    while nfSlots.length > 0 && nfSlots[nfSlots.length - 1] >= npKeys.length {
      nfSlotsPop()
      nfNamesPop()
    }
  }
  narBankPopFrame()
  symScopePop()
}

// The root binding of the narrowed place `ix` reads, noted as a use, and the place's types
// recorded: an overlay hit returns before the receiver is checked.
function identNotePlace(ix: i32) {
  placeRecvTysNote(ix)
  const r = cwProjRootNode(ix)
  if r < 0 { return 0 }
  const n = P.nodes[r]
  if n is Ident { identNoteUse(r, n.identName) }
  0
}

// Each projection of the place `ix`, recorded at the type the read-only place walk gives it,
// which is the type a check of that node would record.
function placeRecvTysNote(ix: i32) {
  if inferQuiet || ix < 0 || ix >= nodeTyIx.length { return 0 }
  const n = P.nodes[ix]
  if n is Member { return placeRecvTyStep(ix, n.memObj) }
  if n is OptMember { return placeRecvTyStep(ix, n.omObj) }
  if n is Index { return placeRecvTyStep(ix, n.idxArr) }
  if n is Paren { return placeRecvTyStep(ix, n.parInner) }
  // The root `Ident`; any other node is no place, and the walk gives it no type.
  placeTyNote(ix)
}

// `placeRecvTysNote` at the projection `ix`, then at its receiver `recv`.
function placeRecvTyStep(ix: i32, recv: i32) {
  placeTyNote(ix)
  placeRecvTysNote(recv)
}

// Records at `ix` the type the place walk reads there, when it reads one.
function placeTyNote(ix: i32) {
  const noNames: string[] = []
  const noTys: i32[] = []
  const t = placeCurTy(ix, noNames, noTys)
  if t >= 0 { nodeTySet(ix, widenLitTy(t)) }
  0
}

// ── the node-anchored findings' span ─────────────────────────────────────────
// A multi-module compile merges every module's AST, so `modOfTok` resolves which file a finding
// is in; the CLI keeps only the entry module's (`redunModuleAt`).

// Fold the tree at `ix` in place: 1 when it is rewritten into its value's literal, 2 when it is
// a constant the check refuses (reported here), 0 when it is no constant tree.
function cexTryFold(ix: i32): i32 {
  if cexNotTree.length > 0 && (cexNotTree[ix] ?? false) { return 0 }
  if !cexRootShape(ix) || cexTreeShape(ix, 0) != 1 { return 0 }
  cexFoldAt(ix)
}

// `cexTryFold` for the operator `e` at `ix`, whose operator the caller has already admitted.
function cexTryFoldBin(e: BinExpr, ix: i32): i32 {
  if cexNotTree.length > 0 && (cexNotTree[ix] ?? false) { return 0 }
  if cexTreeShape(e.binLeft, 1) != 1 || cexTreeShape(e.binRight, 1) != 1 {
    return 0
  }
  cexFoldAt(ix)
}

// Fold the tree at `ix`, whose shape is a constant tree's.
function cexFoldAt(ix: i32): i32 {
  const v = cexEvalAt(ix, 0)
  if v.cxNo || cexPastF64(v) {
    cexKeepWhole(ix, 0)
    return 0
  }
  if v.cxErr != "" {
    tErr(v.cxErr, ix)
    return 2
  }
  cexRewrite(ix, v)
  1
}

// A constant delivered into `dstTy`, a number or a union with a number member: one the type
// cannot hold is refused naming its value and the type, and a whole float constant at an
// integer destination becomes that integer. Answers whether this decided the delivery.
function cexDeliver(srcExpr: i32, dstTy: i32): boolean {
  const lit = cexLitPeel(srcExpr)
  if lit < 0 { return false }
  const l = P.nodes[lit]
  if !(l is NumLit) { return false }
  const lt = nodeTyOf(lit)
  const isF = lt == TY_F64 || lt == TY_F32
  // Seven characters hold an integer every number type holds exactly, whatever the radix.
  if !isF && l.numText.length <= 7 { return false }
  let kind = 0
  if dstTy == TY_I32 || dstTy == TY_I64 { kind = 1 }
  else if dstTy == TY_F32 || dstTy == TY_F64 { kind = 2 }
  else if T.tys[dstTy] is TyUnion { kind = 3 }
  if kind == 0 { return false }
  // Nine hold none past the i32 range, which `i64` and `f64` hold exactly too.
  if !isF && l.numText.length <= 9 && (kind == 1 || dstTy == TY_F64) {
    return false
  }
  if !cexIsDerived(srcExpr) { return false }
  let v = cexOfLexeme(l.numText)
  if !cexOk(v) { return false }
  if intLitIsNegated(srcExpr) { v = cexNeg(v) }
  if kind == 3 { return cexDeliverUnion(v, lit, srcExpr, dstTy) }
  if cexFitsAt(v, l.numText, dstTy) {
    if kind == 2 || !v.cxFloat { return false }
    if !inferQuiet {
      arenaSetNode(lit, { numText: cexDecText(v), pos: l.pos })
      cexRetype(srcExpr, dstTy)
      cexConverted = true
    }
    return true
  }
  cexReported[lit] = true
  tErr(cexMisfitMsg(v, tyToStr(dstTy), kind == 2), srcExpr)
  true
}

// An `i64` value delivered into `i32` whose every leaf is an integer constant, through `if`,
// `match` and block tails and integer operators: it is `i64` only because some constant overflows
// `i32`, so that constant is refused in its own words (D3780). Answers whether it found one.
function cexJoinMisfit(srcExpr: i32): boolean {
  const todo: i32[] = [srcExpr]
  let bad = -1
  let badV = cexNotConst()
  let badLit = -1
  while todo.length > 0 {
    const at = cwPeel(todo.pop() ?? -1)
    if at < 0 || at >= P.nodes.length { return false }
    const e = P.nodes[at]
    if (
      tailPushIfArms(at, todo)
      || tailPushMatchArms(at, todo)
      || tailPushBlockTail(at, todo)
    ) {
      continue
    }
    if e is BinExpr {
      if (
        !binIntOnlyOp(e.binOp)
        && e.binOp != "+"
        && e.binOp != "-"
        && e.binOp != "*"
        && e.binOp != "/"
        && e.binOp != "%"
      ) {
        return false
      }
      todo.push(e.binLeft)
      todo.push(e.binRight)
      continue
    }
    const lit = cexLitPeel(at)
    if lit < 0 {
      if e is Unary && (e.unOp == "-" || e.unOp == "~") {
        todo.push(e.unArg)
        continue
      }
      return false
    }
    const l = P.nodes[lit]
    if !(l is NumLit) { return false }
    if numLexIsFloat(l.numText) { return false }
    let v = cexOfLexeme(l.numText)
    if !cexOk(v) { return false }
    if intLitIsNegated(at) { v = cexNeg(v) }
    if bad < 0 && !cexFitsAt(v, l.numText, TY_I32) {
      bad = at
      badV = v
      badLit = lit
    }
  }
  if bad < 0 { return false }
  // A constant already refused is not refused twice, nor is its join's mismatch reported.
  if !(cexReported[badLit] ?? false) {
    cexReported[badLit] = true
    tErr(cexMisfitMsg(badV, "i32", false), bad)
  }
  true
}

// A constant `v` delivered into the union `dstTy` is refused when no number member holds it.
function cexDeliverUnion(v: Cex, lit: i32, srcExpr: i32, dstTy: i32): boolean {
  const members: i32[] = []
  flattenVariantsInto(dstTy, members)
  let numeric = false
  for m in members {
    if m == TY_I32 || m == TY_I64 || m == TY_F32 || m == TY_F64 {
      numeric = true
      if cexFitsAt(v, cexLexeme(v), m) { return false }
    }
  }
  if !numeric { return false }
  cexReported[lit] = true
  tErr(
    "constant " + cexShown(v) + " fits no member of " + tyToStr(dstTy),
    srcExpr,
  )
  true
}

// When `at` is the name braced as a whole statement, `{ steps }`, and `want` is a one-field record
// of that name that the name's own type does not already fit: a note that the braces are a block,
// not the record shorthand (DV-1216).
function braceNameNote(at: i32, want: i32): string {
  if at < 0 || at >= P.nodes.length || want < 0 || want >= T.tys.length {
    return ""
  }
  if !i32ListHas(braceNameStmts, at) { return "" }
  const e = P.nodes[at]
  const w = T.tys[want]
  if e is Ident && w is TyObj {
    if w.objFieldNames.length != 1 { return "" }
    if assignable(nodeTyOf(at), want) { return "" }
    // The field is the binding's source name, which the merge may have renamed apart.
    const fld = demangleName(e.identName)
    if objFieldType(w, fld) >= 0 {
      return " — `{ "
        + fld
        + " }` here is a block, not a record; write `({ "
        + fld
        + " })` for the record"
    }
  }
  ""
}

// Mark the binding `decl` just declared at `depth` with type `bound` when it is an un-annotated
// `let` of a generic function value, and refuse the writes to it seen above its declaration.
function fsbMark(name: string, depth: i32, decl: i32, bound: i32) {
  const n = P.nodes[decl]
  if n is LetDecl {
    if n.letType >= 0 || n.letInit < 0 || inferQuiet { return 0 }
    if bound < 0 || bound >= T.tys.length { return 0 }
    // A list's elements are written whatever its keyword; its writes are re-asked, not refused.
    if fsbIsGenericList(n.letInit, bound) {
      bindMarkPush(fsbDepth, fsbName, name, depth)
      fsbRowDeclPush(decl)
      return 0
    }
    if n.letKw != "let" { return 0 }
    const bt = T.tys[bound]
    if !(bt is TyFunc) || !fsbIsGeneric(n.letInit, bound) { return 0 }
    bindMarkPush(fsbDepth, fsbName, name, depth)
    fsbRowDeclPush(decl)
    if depth == 0 {
      let i = 0
      while i < fsbPendName.length {
        if fsbPendName[i] == name {
          fsbRefuse(decl, fsbPendTy[i], fsbPendIx[i])
        }
        i = i + 1
      }
    }
  }
  0
}

// A write of `rhs`, of type `rt`, into the binding `tgt` names: refused when the binding is
// marked and the value is a concrete function. A write to a module binding not declared yet waits.
function fsbNoteStore(tgt: i32, rhs: i32, rt: i32, ix: i32) {
  if inferQuiet || rt < 0 || rt >= T.tys.length { return 0 }
  const t = T.tys[rt]
  if !(t is TyFunc) { return 0 }
  if fsbIsGeneric(rhs, rt) { return fsbNoteOwner(fsbDeclAtNode(tgt), rhs, rt) }
  const d = fsbDeclAtNode(tgt)
  if d >= 0 && fsbDeclIsList(d) { return 0 }
  if d >= 0 { return fsbRefuse(d, rt, ix) }
  const g = P.nodes[parenPeelIx(tgt)]
  if g is Ident {
    if lookupDepth(g.identName) == 0 {
      fsbPendNamePush(g.identName)
      fsbPendIxPush(ix)
      fsbPendTyPush(rt)
    }
  }
  0
}

// Record call `ix` through the marked binding `decl`, which re-asked the constraints `used` owns,
// with what it bound; `fsbRecheckCalls` re-asks those of every other function written to it.
function fsbNoteCall(
  ix: i32,
  decl: i32,
  used: i32,
  who: string,
  hNames: string[],
  hNo: i32[],
  hNode: i32[],
  argTys: i32[],
) {
  if decl < 0 || inferQuiet { return 0 }
  fsbCallArgTysPush(argTys)
  fsbCallIxPush(ix)
  fsbCallDeclPush(decl)
  fsbCallUsedPush(used)
  fsbCallWhoPush(who)
  fsbCallHNamesPush(hNames)
  fsbCallHNoPush(hNo)
  fsbCallHNodePush(hNode)
  fsbCallOwnNPush(0)
  // The writes already seen are re-asked here, inside the body the call stands in, so a pair
  // naming that body's type parameter is deferred to its instances as a direct call's is.
  fsbRecheckFrom(fsbCallIx.length - 1)
}

// Re-ask, at call `c`, each owner row recorded since it last asked.
export function fsbRecheckFrom(c: i32) {
  if c < 0 || c >= fsbCallOwnN.length { return 0 }
  let w = fsbCallOwnN[c]
  while w < fsbOwnDecl.length {
    if fsbOwnDecl[w] == fsbCallDecl[c] {
      fsbRecheckOne(c, fsbOwnFn[w], fsbOwnTy[w])
    }
    w = w + 1
  }
  fsbCallOwnNSetAt(c, fsbOwnDecl.length)
  0
}

// One call `c` re-asks owner `o`'s constraints with each type-variable parameter of the written
// function type `rt` bound, by position, to the argument the call passes there. Only the written
// function's own parameters are bound: the seed's type variables name another declaration's.
function fsbRecheckOne(c: i32, o: i32, rt: i32) {
  const nm: string[] = []
  const ty: i32[] = []
  const added = fsbBindParams(rt, fsbCallArgTys[c], nm, ty)
  if added == 0 || o == fsbCallUsed[c] { return 0 }
  if !fsbArgsFit(c, rt, nm, ty) { return 0 }
  const modeWas = substNestMode
  const declWas = substNestDecl
  substNestModeSet(SUBST_ALL)
  if o >= 0 { substNestModeSet(SUBST_DECLARED) }
  const ix = fsbCallIx[c]
  const who = fsbCallWho[c]
  const callee = fsbOwnerCallee(o)
  cstrOwnedStrictSet(o >= 0)
  validateBinCstrs(
    nm,
    ty,
    ix,
    callee,
    who,
    fsbCallHNames[c],
    fsbCallHNo[c],
    fsbCallHNode[c],
  )
  validatePrintCstrs(nm, ty, ix, callee, who)
  validateIsCstrs(nm, ty, ix, callee, who)
  validateArgCstrs(nm, ty, ix, callee, fsbCallHNames[c], fsbCallHNode[c])
  validateRetCstrs(nm, ty, ix, callee, who)
  validateLetCstrs(nm, ty, ix, callee, who)
  validateBmCstrs(nm, ty, ix, callee, who)
  validateMemCstrs(
    nm,
    ty,
    ix,
    callee,
    who,
    fsbCallHNames[c],
    fsbCallHNo[c],
    fsbCallHNode[c],
  )
  cstrOwnedStrictSet(false)
  substNestModeSet(modeWas)
  substNestDeclSet(declWas)
  0
}

// A delivery of the marked binding `src` to the concrete function type `dst` is a call at `dst`'s
// parameters for every function written to it (D3968).
function fsbNoteFnDelivery(src: i32, dst: i32) {
  if dst < 0 || dst >= T.tys.length || src < 0 { return 0 }
  const f = T.tys[dst]
  // An element of an array literal, or a field of an object literal, is delivered to the
  // destination's element or field type.
  const sn = P.nodes[parenPeelIx(src)]
  if f is TyNullable { return fsbNoteFnDelivery(src, f.nInner) }
  if sn is ArrayLit {
    if f is TyArray {
      for e in sn.arrElems { fsbNoteFnDelivery(e, f.aElem) }
    }
    return 0
  }
  if sn is ObjLit {
    if f is TyObj {
      for fi in sn.objFields {
        const fn = P.nodes[fi]
        if fn is FieldInit {
          fsbNoteFnDelivery(fn.fiValue, objFieldType(f, fn.fiName))
        }
      }
    }
    return 0
  }
  if !(f is TyFunc) || tyHasTyVar(dst) { return 0 }
  const d = fsbDeclAtNode(src)
  if d < 0 { return 0 }
  const args: i32[] = []
  for p in f.fnParamTypes { args.push(p) }
  const none: string[] = []
  const noIx: i32[] = []
  const noNode: i32[] = []
  fsbNoteCall(src, d, CSTR_ANYFN, "", none, noIx, noNode, args)
}

// The parameter types of the called type `ft` under the call's bindings.
function fsbArgTysOf(ft: TyFunc, vNames: string[], vTys: i32[]): i32[] {
  const out: i32[] = []
  for p in ft.fnParamTypes { out.push(substTyDeep(p, vNames, vTys)) }
  out
}

// Bind the type variables of each parameter of function type `rt` against the argument type at
// its position, structurally (`A[]`, `A | null`, `Box<A>`, `() => A` all bind `A`), appending to
// `nm`/`ty`; answers how many it bound.
function fsbBindParams(rt: i32, args: i32[], nm: string[], ty: i32[]): i32 {
  if rt < 0 || rt >= T.tys.length { return 0 }
  const f = T.tys[rt]
  const was = nm.length
  if f is TyFunc {
    let i = 0
    while i < f.fnParamTypes.length && i < args.length {
      const p = f.fnParamTypes[i]
      if p >= 0 && p < T.tys.length && args[i] >= 0 && args[i] < T.tys.length {
        bindGenWalk(p, args[i], nm, ty)
      }
      i = i + 1
    }
  }
  nm.length - was
}

// Whether each argument of call `c` is assignable to the parameter of `rt` at its position under
// the bindings `nm`/`ty`; the first that is not is refused at the call, as a direct call would be.
function fsbArgsFit(c: i32, rt: i32, nm: string[], ty: i32[]): boolean {
  const f = T.tys[rt]
  if !(f is TyFunc) { return true }
  const args = fsbCallArgTys[c]
  let i = 0
  while i < f.fnParamTypes.length && i < args.length {
    const want = substTyDeep(f.fnParamTypes[i], nm, ty)
    if (
      want >= 0
      && args[i] >= 0
      && !tyHasTyVar(want)
      && !assignable(args[i], want)
    ) {
      tErr(
        "argument "
          + i32ToStr(i + 1)
          + ": expected "
          + tyToStr(want)
          + ", got "
          + tyToStr(args[i])
          + " (a function written to this binding takes `"
          + tyToStr(want)
          + "` there)",
        fsbCallIx[c],
      )
      return false
    }
    i = i + 1
  }
  true
}

// Refuse at `ix` the concrete function type `rt` written to the binding declared by `decl`, with
// the annotation `check --fix` inserts after the binding's name when both are in one module.
function fsbRefuse(decl: i32, rt: i32, ix: i32) {
  const n = P.nodes[decl]
  if !(n is LetDecl) { return 0 }
  const annot = tyToStr(rt)
  const head = "cannot assign "
    + annot
    + " to `"
    + n.letName
    + "`: it keeps the generic type of its initializer, so a function written to it must be "
    + "generic too"
  // The annotation is a fix only when the initializer fits it too.
  const it = nodeTyIxOf(n.letInit)
  if it >= 0 && !assignable(it, rt) {
    return tErrCoded(
      head
        + " — no annotation holds both, since the initializer, "
        + tyToStr(it)
        + ", is not "
        + annot
        + "; bind this function to a `let` of its own",
      ix,
      CODE_GENERIC_BINDING_CONCRETE_WRITE,
    )
  }
  let data = ""
  const tk = declNameTokOf(decl)
  if tk >= 0 && tk < P.toks.length && rcwModOf(decl) == rcwModOf(ix) {
    const t = P.toks[tk]
    data = diagDataField("annot", annot)
      + diagDataField("line", i32ToStr(t.line))
      + diagDataField("col", i32ToStr(t.col + t.text.length))
  }
  tErrCodedData(
    head
      + " — to hold this one, annotate it, `let "
      + n.letName
      + ": "
      + annot
      + " = …`",
    ix,
    CODE_GENERIC_BINDING_CONCRETE_WRITE,
    data,
  )
}

// Whether argument `i` of call `n`, of type `at`, is a wider record the parameter's declared
// record type `expected` would refuse only for its extra fields, and the function can take a
// generic parameter there: not exported, the type named in no other annotation of its signature.
// A function read as a value is declined when the rewrite is applied.
function wsCandidate(
  n: Call,
  i: i32,
  arg: i32,
  at: i32,
  expected: i32,
): boolean {
  if arg < 0 || at < 0 || expected < 0 || expected >= T.tys.length {
    return false
  }
  if at == expected || !(T.tys[expected] is TyObj) { return false }
  // Asked of every argument: only a record with more fields, or a parameter this rewrite made
  // generic, goes on to the declaration and the field-by-field comparison.
  const pre = T.tys[at]
  if pre is TyObj {
    const ew = T.tys[expected]
    if ew is TyObj {
      if pre.objFieldNames.length <= ew.objFieldNames.length { return false }
    }
  } else if !(pre is TyVar) {
    return false
  }
  const d = wsCalleeDecl(n)
  if d < 0 || i32ListHas(wsNoDecl, d) { return false }
  const fd = P.nodes[d]
  if !(fd is FuncDecl) || i >= fd.fnParams.length || declHasExportKw(d) {
    return false
  }
  const pn = P.nodes[fd.fnParams[i]]
  if (
    !(pn is Param)
    || pn.parType < 0
    || pn.parRest == 1
    || pn.parName == "self"
  ) {
    return false
  }
  const ann = P.nodes[pn.parType]
  if !(ann is TypeRef) || !wsIsIdent(ann.tyName) { return false }
  const et = T.tys[expected]
  const st = T.tys[at]
  if !(et is TyObj) { return false }
  // A parameter this rewrite already made generic, passed on whole, makes this one generic too:
  // each of its instances is one of the wider records its own calls are held to.
  if st is TyVar {
    if st.tvName.length < 3 || st.tvName.slice(0, 3) != "__W" { return false }
  } else if st is TyObj {
    let f = 0
    while f < et.objFieldNames.length {
      const sf = objFieldType(st, et.objFieldNames[f])
      if sf < 0 || !tySame(sf, et.objFieldTypes[f]) { return false }
      f = f + 1
    }
    if !objShapeAdapterlessAt(arg, at, expected) { return false }
  } else {
    return false
  }
  let j = 0
  while j < fd.fnParams.length {
    const oj = P.nodes[fd.fnParams[j]]
    if j != i && oj is Param {
      if wsAnnMentions(oj.parType, ann.tyName) { return false }
    }
    j = j + 1
  }
  if fd.fnRet < 0 { return wsInferredRetPrim(fd.fnName) }
  !wsAnnMentions(fd.fnRet, ann.tyName)
}

// The declared record type a rewritten parameter `i` of the declaration call `n` names had, or -1
// when it is no rewritten one.
function wsOrigTyOf(n: Call, i: i32): i32 {
  if wsDecl.length == 0 { return -1 }
  const d = wsCalleeDecl(n)
  if d < 0 { return -1 }
  const r = wsRowOf(d, i)
  if r < 0 { return -1 }
  const a = P.nodes[wsOrigAnn[r]]
  if a is TypeRef { return resolveAnnot(a.tyName, []) }
  -1
}

// The note for the refused store into `nlAsgTgt` of a value typed `nlAsgGot`, when the target is
// a numeric-literal binding written whole, through one index, or at one literal field, and the
// literal also fits the stored type; queued with the slot and the suggested type.
function numLitAsgNoteQueue(msg: string, di: i32) {
  const tgt = parenPeelIx(nlAsgTgt)
  if tgt < 0 || tgt >= P.nodes.length { return 0 }
  let idIx = tgt
  let slot = "="
  let fname = ""
  const tn = P.nodes[tgt]
  if tn is Index {
    idIx = parenPeelIx(tn.idxArr)
    slot = "[]"
  } else if tn is Member {
    idIx = parenPeelIx(tn.memObj)
    fname = tn.memProp
    slot = "." + fname
  }
  if idIx < 0 || idIx >= P.nodes.length { return 0 }
  const id = P.nodes[idIx]
  if !(id is Ident) { return 0 }
  if id is Ident {
    const decl = numLitDeclOf(id.identName)
    if decl < 0 { return 0 }
    const dn = P.nodes[decl]
    const bt = lookup(id.identName)
    if bt < 0 || nlAsgGot < 0 { return 0 }
    const btt = T.tys[bt]
    const got = widenLitTy(nlAsgGot)
    if got < 0 || got >= T.tys.length { return 0 }
    if dn is LetDecl {
      let base = bt
      let gotBase = got
      let list = ""
      let fieldLit = -1
      if btt is TyArray {
        if btt.aRead != 0 || fname != "" { return 0 }
        base = btt.aElem
        list = "[]"
        if slot == "=" {
          const gt = T.tys[got]
          if !(gt is TyArray) { return 0 }
          if gt is TyArray { gotBase = gt.aElem }
        }
      } else if btt is TyObj {
        if fname == "" { return 0 }
        base = objFieldType(btt, fname)
        const iv = P.nodes[parenPeelIx(dn.letInit)]
        if iv is ObjLit {
          for fi in iv.objFields {
            const f = P.nodes[fi]
            if f is FieldInit {
              if f.fiName == fname && exprIsNumLit(f.fiValue) {
                fieldLit = f.fiValue
              }
            }
          }
        }
        if fieldLit < 0 { return 0 }
      } else if slot != "=" {
        return 0
      }
      const bn = primNameStr(primNameOf(base))
      const gn = primNameStr(primNameOf(gotBase))
      const bytes = slot == "=" && list != "" && numLitListIsBytes(dn.letInit)
      if !numLitFitsStore(bn, gn, bytes) { return 0 }
      let litAt = dn.letInit
      if fieldLit >= 0 { litAt = fieldLit }
      if !numLitValuesFit(litAt, gn) { return 0 }
      // A `const` refuses the whole store already; annotating it would not help.
      if slot == "=" && dn.letKw == "const" { return 0 }
      let note = ""
      if fieldLit >= 0 {
        note = " — field `"
          + demangleName(fname)
          + "` of `"
          + demangleName(dn.letName)
          + "` on "
          + rcwWhere(decl, nlAsgTgt)
          + " has no annotation, so its literal defaulted to `"
          + bn
          + "`; write it `"
          + demangleName(fname)
          + ": "
          + numLitText(fieldLit)
          + " as "
          + gn
          + "`"
      } else {
        note = numLitAnnotNote(dn, decl, nlAsgTgt, bt, gn + list)
      }
      nlnDiag.push(di)
      nlnMsg.push(msg)
      nlnText.push(note)
      nlnDecl.push(decl)
      nlnUse.push(id.identName)
      if list != "" && slot == "=" { slot = "=[]" }
      nlnSlot.push(slot)
      nlnWant.push(gotBase)
      if fieldLit >= 0 { nlnAnn.push("") } else { nlnAnn.push(gn + list) }
      nlnLeaf.push(-1)
      // A whole scalar store's suggestion is graded against the binding's reads as well.
      if slot == "=" && fieldLit < 0 {
        nlnLeafTy.push(gotBase)
      } else {
        nlnLeafTy.push(-1)
      }
    }
  }
  0
}

// Queue the note for the diagnostic about to be pushed at index `di`, if it has one.
function numLitNoteQueue(msg: string, at: i32, di: i32) {
  if nlWantTy >= 0 && numLitFnNoteQueue(msg, at, di) { return 0 }
  if numLitBindName.length == 0 { return 0 }
  if nlAsgTgt >= 0 { return numLitAsgNoteQueue(msg, di) }
  const idIx = numLitReadIdent(at)
  if idIx >= 0 {
    const id = P.nodes[idIx]
    if id is Ident {
      const decl = numLitDeclOf(id.identName)
      if decl >= 0 {
        const note = numLitDefaultNote(msg, at, idIx, decl)
        if note != "" {
          let leaf = -1
          if nlDefaultTy >= 0 { leaf = idIx }
          numLitReadNotePush(di, msg, note, decl, id.identName, nlDefaultAnn)
          return numLitReadLeafPush(leaf, nlDefaultTy)
        }
      }
    }
  }
  numLitLeafNoteQueue(msg, at, di)
}

// Would value `v` have type `want` once every numeric-literal binding it reads is annotated
// `want`? Through arithmetic and negation; every other leaf must be a literal that fits or
// already have that type.
function numLitArithFits(v: i32, want: i32, depth: i32): boolean {
  const p = parenPeelIx(v)
  if depth <= 0 || p < 0 || p >= P.nodes.length { return false }
  const n = P.nodes[p]
  const wn = primNameStr(primNameOf(want))
  let t = widenLitTy(nodeTyIxOf(p))
  if n is Ident {
    if numLitDeclOf(n.identName) >= 0 { t = lookup(n.identName) }
  }
  if t >= 0 && tySame(t, want) { return true }
  if n is Unary {
    if n.unOp == "-" { return numLitArithFits(n.unArg, want, depth - 1) }
    return false
  }
  if n is BinExpr {
    if !numLitArithOp(n.binOp) { return false }
    return numLitArithFits(n.binLeft, want, depth - 1)
      && numLitArithFits(n.binRight, want, depth - 1)
  }
  if n is Ident {
    if numLitDeclOf(n.identName) < 0 { return false }
  } else if !(n is NumLit) {
    return false
  }
  numLitFitsStore(primNameStr(primNameOf(t)), wn, false)
}

// The numeric-literal binding read within value `v` that a `want`-typed destination refuses and
// whose annotation `want` fixes, through record and list literals, arithmetic and negation; -1
// when none. Sets `nlLeafWant` to the type the binding should carry.
function numLitLeafFor(v: i32, want: i32, depth: i32): i32 {
  const p = parenPeelIx(v)
  if depth <= 0 || want < 0 || want >= T.tys.length { return -1 }
  if p < 0 || p >= P.nodes.length { return -1 }
  const n = P.nodes[p]
  const wt = T.tys[want]
  if n is Ident {
    if numLitDeclOf(n.identName) < 0 { return -1 }
    const bt = lookup(n.identName)
    if bt < 0 || tySame(bt, want) { return -1 }
    const bn = primNameStr(primNameOf(bt))
    const wn = primNameStr(primNameOf(want))
    if !numLitFitsStore(bn, wn, false) { return -1 }
    const decl = numLitDeclOf(n.identName)
    if decl < 0 || decl >= P.nodes.length { return -1 }
    const dn = P.nodes[decl]
    if dn is LetDecl {
      if !numLitValuesFit(dn.letInit, wn) { return -1 }
    }
    nlLeafWant = want
    return p
  }
  if n is ObjLit {
    if wt is TyObj {
      for fi in n.objFields {
        const f = P.nodes[fi]
        if f is FieldInit {
          const r = numLitLeafFor(
            f.fiValue,
            objFieldType(wt, f.fiName),
            depth - 1,
          )
          if r >= 0 { return r }
        }
      }
    }
    return -1
  }
  if n is ArrayLit {
    if wt is TyArray {
      for el in n.arrElems {
        const r = numLitLeafFor(el, wt.aElem, depth - 1)
        if r >= 0 { return r }
      }
    }
    return -1
  }
  numLitLeafInOp(p, want, depth)
}

// `numLitLeafFor` through a negation or an arithmetic operator whose value fits `want` once its
// literal bindings do; -1 for every other node, which reads no binding a note can name.
function numLitLeafInOp(p: i32, want: i32, depth: i32): i32 {
  const n = P.nodes[p]
  if n is BinExpr {
    if !numLitArithOp(n.binOp) || !numLitArithFits(p, want, 8) { return -1 }
    const r = numLitLeafFor(n.binLeft, want, depth - 1)
    if r >= 0 { return r }
    return numLitLeafFor(n.binRight, want, depth - 1)
  }
  const neg = exprNegatedArg(p)
  if neg >= 0 { return numLitLeafFor(neg, want, depth - 1) }
  -1
}

// The note for a mismatch whose value holds a numeric-literal binding inside a record or list
// literal or an arithmetic expression, found against the destination type `nlWantTy`; for an
// `operator … mixes` refusal, against the other operand's type.
function numLitLeafNoteQueue(msg: string, at: i32, di: i32) {
  const v = parenPeelIx(at)
  if v < 0 || v >= P.nodes.length { return 0 }
  let leaf = -1
  if nlWantTy >= 0 {
    leaf = numLitLeafFor(v, nlWantTy, 8)
  } else {
    const bn = P.nodes[v]
    if bn is BinExpr && msg.slice(0, 10) == "operator '" {
      const lt = widenLitTy(nodeTyIxOf(bn.binLeft))
      const rt = widenLitTy(nodeTyIxOf(bn.binRight))
      if rt >= 0 && numLitArithFits(v, rt, 8) {
        leaf = numLitLeafFor(bn.binLeft, rt, 8)
      }
      if leaf < 0 && lt >= 0 && numLitArithFits(v, lt, 8) {
        leaf = numLitLeafFor(bn.binRight, lt, 8)
      }
    }
  }
  if leaf < 0 { return 0 }
  const id = P.nodes[leaf]
  if id is Ident {
    const decl = numLitDeclOf(id.identName)
    if decl < 0 { return 0 }
    const dn = P.nodes[decl]
    const bt = lookup(id.identName)
    if dn is LetDecl {
      const ann = primNameStr(primNameOf(nlLeafWant))
      const note = numLitAnnotNote(dn, decl, at, bt, ann)
      numLitReadNotePush(di, msg, note, decl, id.identName, ann)
      return numLitReadLeafPush(leaf, nlLeafWant)
    }
  }
  0
}

// The hint at an `is` whose tested type is contained in another arm of the operand's union
// (`is B` over `A | B` with every `B` an `A`): `is` tests whether the value fits the type, so
// an `A` that fits `B` tests as a `B` (the owner's structural `is`, D3885).
function recordContainedIsAt(n: IsExpr, ix: i32, objTy: i32, chkTy: i32) {
  if chkTy < 0 || objTy < 0 { return 0 }
  const ot = T.tys[objTy]
  if !(ot is TyUnion) { return 0 }
  // Two records only: a scalar, literal or list containment is the ordinary narrowing it reads as.
  if !(T.tys[chkTy] is TyObj) { return 0 }
  for m in ot.uMembers {
    if (m != chkTy && m >= 0 && T.tys[m] is TyObj && recArmContains(m, chkTy)) {
      const tk = findingStartTok(ix)
      if tk < 0 { return 0 }
      let i = 0
      while i < isvalTok.length {
        if isvalTok[i] == tk { return 0 }
        i = i + 1
      }
      const t = P.toks[tk]
      isvalLine.push(t.line)
      isvalCol.push(t.col)
      isvalEnd.push(findingEndCol(ix, tk))
      isvalTok.push(tk)
      isvalName.push("")
      isvalType.push("")
      isvalLit.push(n.isVariant)
      isvalMsg.push(
        "`"
          + tyToStrUser(chkTy)
          + "` is contained in `"
          + tyToStrUser(m)
          + "`, so `is "
          + tyToStrUser(chkTy)
          + "` tests the value",
      )
      return 0
    }
  }
  0
}

// Raise a diagnostic at AST node `at`, resolving its source position — the node's anchor token
// through the `nodeToks` side table — eagerly, so the driver can render `line:col: message`. Every
// lookup is bounds-checked: a harness that builds `P.nodes` by hand yields an out-of-range index,
// which degrades to "no position" (`tline == 0`) rather than trapping.
export function tErr(msg: string, at: i32) { tErrCoded(msg, at, "") }

// `tErr` for a value delivered to a `want`-typed destination, which lets the numeric-literal note
// find a literal binding inside a record, list or arithmetic value.
function tErrWant(msg: string, at: i32, want: i32) {
  let m = msg
  // An `i64` made only of constants, one of which overflows `i32`: that constant is the
  // error, refused at its own span (D3780). Beside other operands, the note names it.
  if want == TY_I32 && !inferQuiet && at >= 0 && nodeTyOf(at) == TY_I64 {
    if cexJoinMisfit(at) { return 0 }
    m = m + cexWideConstNote(at)
  }
  m = m + braceNameNote(at, want)
  nlWantTy = want
  tErr(m, at)
  nlWantTy = -1
  0
}

// The emitter-capability channel: raise an error for a construct the type system accepts but
// codegen cannot lower yet, under the stable `unsupported-lowering` category code. Both are errors,
// an unbuildable program not being allowed to pass, but tooling can tell them apart by code.
// Message convention: name the type-valid construct, then the workaround after an em dash.
function tErrUnsupported(msg: string, at: i32) {
  tErrCoded(msg, at, CODE_UNSUPPORTED_LOWERING)
}

function tErrCoded(msg: string, at: i32, code: string) {
  tErrCodedData(msg, at, code, "")
}

// `tErrCoded` plus the structured payload — the only raise that fills `tdata`. Anchoring: a node
// whose own NAME is the subject spans that one token — a declaration's declared name, a member
// access's property, the names `driver.vl`'s emit and module anchors already prefer. Every other
// kind spans WHOLE, which is `tErrPushNodeSpan`'s arm.
function tErrCodedData(msg: string, at: i32, code: string, data: string) {
  if at >= 0 && at < P.nodes.length {
    const n = P.nodes[at]
    // A loop's binder and a parameter's name carry `declNameTok` too, and neither is its
    // construct's subject — the diagnostics there are about the loop and the parameter.
    if n is FuncDecl || n is TypeDecl || n is UnionDecl || n is LetDecl {
      const nm = declNameTokOf(at)
      if nm >= 0 && nm < P.toks.length {
        return tErrPushTok(msg, at, nm, code, data)
      }
    } else if n is Member || n is OptMember {
      const tk = nodeLastTok(at)
      if tk >= 0 { return tErrPushTok(msg, at, tk, code, data) }
    }
  }
  tErrPushNodeSpan(msg, at, code, data)
}

// Raise `msg` over node `at`'s whole span: its first token through its last, across lines.
// `nodeStartTok` resolves inside the node's own module, so the two bound one span; a last
// token at or before the start is a one-token node. With no start token: the `nodeToks`
// anchor, else positionless.
function tErrPushNodeSpan(msg: string, at: i32, code: string, data: string) {
  const first = nodeStartTok(at)
  if first >= 0 {
    let end = nodeLastTok(at)
    if end < first { end = first }
    return tErrPush(
      msg,
      at,
      P.toks[first].line,
      P.toks[first].col,
      end,
      code,
      data,
    )
  }
  const last = nodeLastTok(at)
  if last >= 0 { return tErrPushTok(msg, at, last, code, data) }
  tErrPush(msg, at, 0, 0, -1, code, data)
}

// Raise `msg` spanning exactly token `tk` — the caller has already decided the token is the
// whole subject, so nothing widens it. Out-of-range is the caller's to rule out.
export function tErrPushTok(
  msg: string,
  at: i32,
  tk: i32,
  code: string,
  data: string,
) {
  tErrPush(msg, at, P.toks[tk].line, P.toks[tk].col, tk, code, data)
}

// D1585 — the reserved-name refusal, raised from one place by both faces: a single file's
// declaration and a module's (`driver.modCheckReservedDecls`, the only reader that still sees the
// pre-merge name). Message, channel and anchor are shared, so the two faces cannot drift in
// wording. Anchored at the declaration's name token, the `nodeToks` anchor being a closing brace.
export function tErrBuiltinTyDecl(name: string, at: i32): i32 {
  const msg = "a `type` declaration may not take the built-in type name `"
    + name
    + "` — every annotation resolves that name to the primitive, so the declaration "
    + "can never be referred to; rename it"
  const tk = declNameTokOf(at)
  if tk >= 0 && tk < P.toks.length { return tErrPushTok(msg, at, tk, "", "") }
  tErr(msg, at)
  0
}

export function tErrPush(
  msg0: string,
  at: i32,
  ln: i32,
  co: i32,
  endTok: i32,
  code0: string,
  data: string,
) {
  // A misuse of a name a call un-narrowed says so, whichever check refused it (D2390).
  let msg = msg0
  let code = code0
  if crRdRet.length > 0 {
    const note = crMisuseNote(msg0, at)
    if note != "" {
      msg = msg0 + note
      if code == "" { code = CODE_NARROWING_ENDED_BY_CALL }
    }
  }
  if crLostAny() {
    const lnote = crLostNote(msg, at)
    if lnote != "" { msg = msg + lnote }
  }
  // A demand re-asked at a pin away from the delivery it came through names that delivery.
  if cvNow >= 0 && at != cvNow { msg = msg + cvViaNote(cvNow) }
  if code == "" && zeroBytesFixIx.length > 0 && i32ListHas(zeroBytesFixIx, at) {
    code = CODE_ZERO_BYTES
  }
  // An exact repeat (same message, same anchor) is noise, not information — two passes can resolve
  // the same annotation, the pass-1.5 hoist and the real pass both reporting a generic-alias arity
  // error at the same position. Drop the repeat; the diagnostic count stays small, so the scan is
  // cheap.
  let di = 0
  while di < T.diags.length {
    const d = T.diags[di]
    if d.tat == at && d.tmsg == msg { return 0 }
    di = di + 1
  }
  numLitNoteQueue(msg, at, T.diags.length)
  if recAdOrigDecl.length > 0 && !recAdRaising {
    if recAdWholeErr(at) || recAdMentions(at, 6) {
      msg = msg + recAdNoteFor(at)
    }
    if !recAdWholeErr(at) { recAdLoose = recAdLoose + 1 }
  }
  T.diags.push(
    {
      tmsg: msg,
      tat: at,
      tline: ln,
      tcol: co,
      tendTok: endTok,
      tcode: code,
      tdata: data,
    },
  )
  0
}

// ── small numeric / string helpers (no union narrowing) ──────────────────────

// Whether `v` is a type parameter and `u` a union with `v` among its members.
function tyVarMemberOf(v: i32, u: i32): boolean {
  if v < 0 || u < 0 || v >= T.tys.length || u >= T.tys.length { return false }
  if !(T.tys[v] is TyVar) { return false }
  const ut = T.tys[u]
  if ut is TyUnion {
    let i = 0
    while i < ut.uMembers.length {
      const m = ut.uMembers[i]
      if m == v || (m >= 0 && sameVariantTy(m, v)) { return true }
      if m >= 0 && m < T.tys.length && sameDeclaredTyParam(m, v) { return true }
      i = i + 1
    }
  }
  false
}

// Whether `as` from `from` to `to`, deferred off a gradual union, holds at a pin: an arm of a
// union, or a numeric conversion or the type itself.
function asPinHolds(from: i32, to: i32): boolean {
  if from < 0 || to < 0 || from >= T.tys.length { return true }
  const f = T.tys[from]
  if f is TyUnion { return unionCoversTy(f, to) }
  // A nullable operand is a union operand, as `checkCastNode` reads it.
  if f is TyNullable {
    if f.nInner < 0 { return true }
    const nu = T.tys[mkUnionTy([f.nInner, TY_NULL])]
    if nu is TyUnion { return unionCoversTy(nu, to) }
    return true
  }
  if from == to || assignable(from, to) { return true }
  isNumeric(from) && isNumeric(to) && primNameOf(from) != "boolean"
}

// The join of `a` and `b` when one is a join kept apart over a type parameter and the other a
// union holding one too: the side holding every member of the other, or their union kept
// apart. -1 otherwise.
function gradualUnionJoin(a: i32, b: i32): i32 {
  if tpJoinUnions.length == 0 { return -1 }
  const ta = tpJoinUnions.has(a)
  const tb = tpJoinUnions.has(b)
  if !ta && !tb { return -1 }
  // A kept-apart join beside a concrete type keeps it too, unless it already holds it.
  const concreteBeside = (ta && !tyHasTyVar(b)) || (tb && !tyHasTyVar(a))
  if !concreteBeside && (tpGradualView(a) == a || tpGradualView(b) == b) {
    return -1
  }
  if isNullTy(a) || isNullTy(b) || a == TY_VOID || b == TY_VOID { return -1 }
  if tyMembersWithin(b, a) { return a }
  if tyMembersWithin(a, b) { return b }
  const tc = joinVariantTys(a, b)
  // arena-tick exempt: a per-program mark on a fresh arena row.
  tpJoinUnions[tc] = 1
  tc
}

// Whether every member of `x` is a member of `u`.
function tyMembersWithin(x: i32, u: i32): boolean {
  const xs: i32[] = []
  flattenVariantsInto(x, xs)
  const us: i32[] = []
  flattenVariantsInto(u, us)
  for m in xs {
    let hit = false
    for n in us {
      if n == m || sameVariantTy(n, m) { hit = true }
    }
    if !hit { return false }
  }
  true
}

// The least upper bound used by `??` (host: `flatten(Union(nonNull(l), r))`):
// mutually-assignable types collapse to the wider; otherwise a two-member union.
export function joinTys(a: i32, b: i32) {
  const apart = njApart
  njApartSet(false)
  if a < 0 { return b }
  if b < 0 { return a }
  // A join is a destination for both sides: an empty `[]` / `Map()` arm takes its sibling's
  // element type, in either order, so the literal is built at the type it flows into (D2209).
  constrainEmpty(a, b)
  constrainEmpty(b, a)
  const tpn = joinTyParamNull(a, b)
  if tpn >= 0 { return tpn }
  // A bare declared parameter beside a concrete type is their union, re-joined at each pin:
  // folding `5` into `T` would read it as the pin's type (D2906).
  const aVar = T.tys[a] is TyVar
  const bVar = T.tys[b] is TyVar
  if (aVar || bVar) && (tyParamBesideBare(a, b) || tyParamBesideBare(b, a)) {
    const tc = joinVariantTys(a, b)
    // arena-tick exempt: a per-program mark on a fresh arena row.
    tpJoinUnions[tc] = 1
    noteHoleTpJoin(tc)
    return tc
  }
  // Such a union absorbs only its own members: its parameter member is assignable from
  // anything, which would fold `T | string` beside `T | i32` to the first (D3212).
  if tpJoinUnions.length > 0 && !aVar && !bVar {
    const gj = gradualUnionJoin(a, b)
    if gj >= 0 { return gj }
  }
  // A declared parameter beside such a union joins into it, as a member or kept apart: the
  // parameter is assignable to the union's own parameter, which would drop one of them.
  if tpJoinUnions.length > 0 {
    if (
      (aVar && tyIsGradualParam(a) && tpJoinUnions.has(b))
      || (bVar && tyIsGradualParam(b) && tpJoinUnions.has(a))
    ) {
      if aVar && tyVarMemberOf(a, b) { return b }
      if bVar && tyVarMemberOf(b, a) { return a }
      const tv = joinVariantTys(a, b)
      // arena-tick exempt: a per-program mark on a fresh arena row.
      tpJoinUnions[tv] = 1
      noteHoleTpJoin(tv)
      return tv
    }
  }
  // Two different declared type parameters are two types, though a type variable is
  // assignable either way inside a generic body: collapsing would type the join as one
  // side and every instance binding them apart would read the other as it (D2760).
  if (
    tyParamsPart(a, b, 0)
    || tyParamArmAbsorbs(a, b)
    || tyParamArmAbsorbs(b, a)
  ) {
    const tj = joinVariantTys(a, b)
    // arena-tick exempt: a per-program mark on a fresh arena row.
    tpJoinUnions[tj] = 1
    return tj
  }
  // A type parameter beside a union holding it joins as that union: inside the body the
  // parameter is assignable to either, and taking it alone drops the union's other members (D2876).
  if tyVarMemberOf(a, b) { return b }
  if tyVarMemberOf(b, a) { return a }
  const oj = tpOpenJoin(a, b)
  if oj >= 0 { return oj }
  if apart {
    const nj = numApartJoin(a, b)
    if nj >= 0 { return nj }
  }
  // Two different records may join wider than either (`{f: i32}` into `{f: f64}`) (D2731).
  if !recordJoinMinted && a != b {
    if T.tys[a] is TyObj && T.tys[b] is TyObj { recordJoinMintedSet(true) }
  }
  if paramJoinDropsNull(a, b) || paramJoinDropsNull(b, a) {
    return paramNullJoin(a, b)
  }
  if assignable(b, a) && !joinWidensMap(b, a) { return a }
  if assignable(a, b) && !joinWidensMap(a, b) { return b }
  joinVariantTys(a, b)
}

// The join `paramJoinDropsNull` keeps: each member once, the null as a member rather than a
// wrapper, so a pin binding a parameter to a nullable type substitutes to one flat union.
function paramNullJoin(a: i32, b: i32): i32 {
  const ms: i32[] = []
  flattenVariantsInto(a, ms)
  flattenVariantsInto(b, ms)
  const kept: i32[] = []
  let hasNull = false
  for m in ms {
    if isNullTy(m) {
      hasNull = true
    } else {
      let dup = false
      for k in kept {
        if k == m || sameVariantTy(k, m) { dup = true }
        if k >= 0 && m >= 0 && sameDeclaredTyParam(k, m) { dup = true }
      }
      if !dup { kept.push(m) }
    }
  }
  if hasNull { kept.push(TY_NULL) }
  const res = mkUnionTy(kept)
  if tyIsTpJoinUnion(a) || tyIsTpJoinUnion(b) {
    // arena-tick exempt: a per-program mark on a fresh arena row.
    tpJoinUnions[res] = 1
  }
  if isJoinHoleUnion(a) || isJoinHoleUnion(b) { joinHoleUnions.push(res) }
  noteHoleTpJoin(res)
  // arena-tick exempt: a per-program mark on a fresh arena row.
  paramNullJoins[res] = 1
  res
}

// `a op b` where an operand is a numeric union: each member pair takes the scalar rule, and
// the result is the union of the pair results in first-seen order (a comparison is boolean).
function numUnionBinTy(n: BinExpr, ix: i32, lt: i32, rt: i32): i32 {
  let ls = numUnionMembersOf(lt)
  if ls.length == 0 { ls = [lt] }
  let rs = numUnionMembersOf(rt)
  if rs.length == 0 { rs = [rt] }
  const cmp = numCmpOp(n.binOp)
  const res: i32[] = []
  for a in ls {
    for b in rs {
      if !isNumericPrimTy(a) || !isNumericPrimTy(b) {
        tErr(
          "operator '"
            + n.binOp
            + "' is not defined for "
            + tyToStr(lt)
            + " and "
            + tyToStr(rt),
          ix,
        )
        if cmp { return TY_BOOL }
        return TY_ERR
      }
      const p = numPairTy(n, a, b)
      if p < 0 {
        tErr(
          "operator '"
            + n.binOp
            + "' over "
            + tyToStr(lt)
            + " and "
            + tyToStr(rt)
            + " mixes the members "
            + tyToStr(a)
            + " and "
            + tyToStr(b)
            + "; narrow with `is` or convert with `as` first",
          ix,
        )
        if cmp { return TY_BOOL }
        return TY_ERR
      }
      let seen = false
      for r in res {
        if r == p || tySame(r, p) { seen = true }
      }
      if !seen { res.push(p) }
    }
  }
  if cmp { return TY_BOOL }
  if res.length == 1 { return res[0] }
  mkUnionTy(res)
}

// `joinTys` for the arms of a value `if` or `match`.
function joinArmTys(a: i32, b: i32): i32 {
  tpArmJoinDepth = tpArmJoinDepth + 1
  const j = joinTys(a, b)
  tpArmJoinDepth = tpArmJoinDepth - 1
  j
}

// `joinArmTys` of an arm typed `a` beside one typed `b`, where `aLit`/`bLit` say an arm's every
// value is a literal. Two runtime values of different numeric types join as their union; a
// literal adapts to its sibling as before.
function joinArmLit(a: i32, aLit: boolean, b: i32, bLit: boolean): i32 {
  if a == b {
    const same = joinArmTys(a, b)
    // A kept-apart join of runtime arms joined with itself is still one (D3569), and so is a
    // written union of type parameters, whose runtime members a pin must not fold (D3594).
    if (tpJoinUnions.get(a) ?? 0) == 2 { markTpJoinApart(same) }
    else if !aLit && !bLit && writtenTpUnion(a) { markTpJoinApart(same) }
    return same
  }
  const apart = !aLit && !bLit && !njJoinGated(a, b, false)
  njApartSet(apart)
  const j = joinArmTys(a, b)
  njApartSet(false)
  if apart { markTpJoinApart(j) }
  j
}

// The join of a `??`'s non-null left type `l` and its default `d` (typed `dt`) when the two are
// runtime numbers that could part, joined apart as `joinArmLit` joins the `if` the operator
// spells; -1 when the ordinary `??` rules decide (a literal or hole default, a gated function).
function coalJoinApart(lhs: i32, l: i32, dt: i32, d: i32): i32 {
  if !njMayPart(l, dt) || tyIsHole(dt) || armLit(dt, d) { return -1 }
  if njJoinGated(l, dt, false) || !coalLhsParts(lhs) { return -1 }
  // A hole body keeps master's widening (D2562), as does a union left operand; a declared
  // parameter's body joins apart, as its `if` spelling does, and so does its recheck (D3580).
  if l >= T.tys.length { return -1 }
  if njFnOpen(njFnIx) && !(njFnTyParams(njFnIx) && !(T.tys[l] is TyUnion)) {
    return -1
  }
  joinArmLit(l, false, dt, false)
}

// The union of `a` and `b` when each holds a numeric primitive and their numeric members differ,
// else -1: runtime values of different numeric types join apart, never widened.
function numApartJoin(a: i32, b: i32): i32 {
  if a == b || a < 0 || b < 0 { return -1 }
  if !tyHoldsNumericPrim(a) || !tyHoldsNumericPrim(b) { return -1 }
  if tyHasTyVar(a) || tyHasTyVar(b) { return -1 }
  if !numericVariantUncovered(a, b) && !numericVariantUncovered(b, a) {
    return -1
  }
  joinVariantTys(a, b)
}

// Records the if-join `ix` of `a` and `b`, collapsed to `j`, when the return-set rule would
// keep a type parameter's list apart in it; a pin that re-joins it apart re-checks the body.
// `ok` says the join is delivered where an instance can build it as a union (`tpIfMarkOk`).
function noteTpIfJoin(ix: i32, a: i32, b: i32, j: i32, ok: boolean) {
  if tpEnvNames.length == 0 || monoRecheckDepth > 0 { return 0 }
  if ix < 0 || a < 0 || b < 0 || j < 0 { return 0 }
  if !tyHasTyVar(a) && !tyHasTyVar(b) { return 0 }
  const saved = tpApartConcrete
  tpApartConcreteSet(true)
  let aj = -1
  if (
    tyParamsPart(a, b, 0)
    || tyParamArmAbsorbs(a, b)
    || tyParamArmAbsorbs(b, a)
  ) {
    aj = joinTys(a, b)
  }
  tpApartConcreteSet(saved)
  noteTpJoinRow(ix, aj, j, ok)
}

// The join of the arm types `ts` under the return-set rule, or -1 when none names a type
// parameter (only then can it differ from the collapse).
function tpApartJoinOf(ts: i32[]): i32 {
  if ts.length < 2 || monoRecheckDepth > 0 || !tysHaveTyVarIn(ts) { return -1 }
  const saved = tpApartConcrete
  tpApartConcreteSet(true)
  const savedClash = joinClashMsg
  let j = ts[0]
  let i = 1
  while i < ts.length {
    if ts[i] >= 0 { j = joinTys(j, ts[i]) }
    i = i + 1
  }
  joinClashMsgSet(savedClash)
  tpApartConcreteSet(saved)
  j
}

// The if-joins of `calleeFn` a call re-asks at its bindings: a join that stays apart there
// re-checks the callee's body at the pinned parameter types `pTys`, and one still open (a
// generic caller) is parked until the caller's own pin (D2832).
function validateTpIfJoins(
  bNames: string[],
  bTys: i32[],
  pTys: i32[],
  retTy: i32,
  ix: i32,
  calleeFn: i32,
) {
  if calleeFn < 0 || monoRecheckDepth > 0 || inferQuiet { return 0 }
  const owner = cstrOwnerTop()
  if tysHaveTyVarIn(bTys) {
    if owner >= 0 && tpIfFnHasRow(calleeFn) {
      noteTpIfRe(calleeFn, owner, bNames, bTys, pTys)
    }
  } else {
    tpIfPinCheck(calleeFn, pTys, bNames, bTys, retTy, ix)
  }
  // The joins a generic callee of this body left open, now pinned in this body's terms.
  const n0 = tpIfReFn.length
  let r = 0
  while r < n0 {
    if tpIfReOwner[r] == calleeFn {
      const rNames: string[] = []
      const rTys: i32[] = []
      let q = 0
      while q < tpIfReCount[r] {
        rNames.push(tpIfReNames[tpIfReStart[r] + q])
        rTys.push(substTyDeep(tpIfReTys[tpIfReStart[r] + q], bNames, bTys))
        q = q + 1
      }
      const rParams: i32[] = []
      const ps = tpIfReParams[r]
      let pi = 0
      while pi < ps.length {
        rParams.push(substTyDeep(ps[pi], bNames, bTys))
        pi = pi + 1
      }
      if tysHaveTyVarIn(rTys) {
        if owner >= 0 { noteTpIfRe(tpIfReFn[r], owner, rNames, rTys, rParams) }
      } else {
        tpIfPinCheck(tpIfReFn[r], rParams, rNames, rTys, -1, ix)
      }
    }
    r = r + 1
  }
  0
}

// The joins of `fn` at the concrete bindings `bNames`/`bTys`: one that stays apart where it is
// not built as a union refuses the call, and otherwise the body is re-checked there.
function tpIfPinCheck(
  fn: i32,
  pTys: i32[],
  bNames: string[],
  bTys: i32[],
  retTy: i32,
  ix: i32,
) {
  let apartJ = -1
  let unbuilt = -1
  let k = 0
  while k < tpIfFn.length {
    if tpIfFn[k] == fn {
      const sj = substTyDeep(tpIfJoin[k], bNames, bTys)
      if sj >= 0 && !tyHasTyVar(sj) && tyUnionAllLists(sj) {
        // The widest names the whole chain of an `else if`, whose links are rows too.
        if apartJ < 0 || unionMemberCountOf(sj) > unionMemberCountOf(apartJ) {
          apartJ = sj
        }
        if unbuilt < 0 && !tpIfRowBuilt(k) { unbuilt = sj }
      }
    }
    k = k + 1
  }
  if apartJ < 0 { return 0 }
  let msg = ""
  if unbuilt >= 0 {
    apartJ = unbuilt
    msg = "no one list holds it where its value goes — bind it to a `const`, or deliver it where its union is declared"
  } else {
    msg = tpIfRecheck(fn, pTys, bNames, bTys, retTy)
  }
  if msg == "" { return 0 }
  let fWho = "the callee's body"
  const fd = P.nodes[fn]
  if fd is FuncDecl {
    if fd.fnName != "" { fWho = "the body of `" + fd.fnName + "`" }
  }
  tErr(
    "at the call's argument types, the branches of an `if` or `match` in "
      + fWho
      + " join "
      + tpMembersListText(apartJ)
      + ": "
      + msg,
    ix,
  )
  0
}

// Re-checks the body of `fn` at the pinned parameter types `pTys`, where a join of its is a
// union of lists, and answers the first sentence that body earns there ("" for none). A value
// the body hands back is held to the call's type `retTy` (-1: not asked), and a list or record
// the instance would build of the join at the template's one-list type is refused.
function tpIfRecheck(
  fn: i32,
  pTys: i32[],
  bNames: string[],
  bTys: i32[],
  retTy: i32,
): string {
  const dn = P.nodes[fn]
  if !(dn is FuncDecl) { return "" }
  let i = 0
  while i < pTys.length {
    if pTys[i] < 0 || tyHasTyVar(pTys[i]) { return "" }
    i = i + 1
  }
  let want = retTy
  if want >= 0 && (tyHasTyVar(want) || want == TY_ERR || isVoidTy(want)) {
    want = -1
  }
  if prbArmed { prbEnter() }
  const cs = checkMark()
  const savedRet = T.curRet
  const savedFn = curFnDeclIx
  const savedNat = retNatural
  const savedNatErr = retNaturalErr
  // An unasked return is `TY_ERR`, which every value passes: `-2` would bank the returns as
  // witnesses of whatever function is being inferred around this call.
  if want >= 0 { T.curRet = want } else { T.curRet = TY_ERR }
  curFnDeclIx = fn
  const savedNjFn = njFnIx
  njFnIxSet(fn)
  cstrOwnerStack.push(fn)
  tpIfCmpNamesSet(bNames)
  tpIfCmpTysSet(bTys)
  tpIfCmpBadSet("")
  tpIfCmpOnSet(true)
  const d0 = T.diags.length
  let msg = ""
  const sv = monoRecheckBegin(fn, pTys, bNames, bTys)
  if sv != null {
    if T.diags.length > d0 { msg = T.diags[d0].tmsg }
    if msg == "" && want >= 0 {
      const rets: i32[] = []
      collectRetValues(dn.fnBody, rets)
      let r = 0
      while r < rets.length && msg == "" {
        const rt = checkNode(rets[r])
        if rt >= 0 && rt != TY_ERR && rt != TY_VOID && rt != TY_NEVER {
          if !assignable(rt, want) {
            msg = "it returns "
              + tyToStr(rt)
              + ", which the call reads as "
              + tyToStr(want)
          }
        }
        r = r + 1
      }
    }
    monoRecheckEnd(sv)
  }
  tpIfCmpOnSet(false)
  if msg == "" { msg = tpIfCmpBad }
  cstrOwnerStack.pop()
  curFnDeclIx = savedFn
  njFnIxSet(savedNjFn)
  T.curRet = savedRet
  retNaturalSet(savedNat)
  retNaturalErrSet(savedNatErr)
  checkRollback(cs, RB_PINNED)
  if prbArmed { prbLeave("tpIfRecheck") }
  msg
}

// Records the first node the instance would build at a type other than the one the re-check
// gives it, where that type holds a union of lists: a node the template typed concretely is
// built at that type, and a list, record or function literal at its substitution.
function tpIfCmpNode(ix: i32, t: i32) {
  if tpIfCmpBad != "" || ix < 0 || t < 0 || ix >= nodeTyIx.length { return 0 }
  const tpl = nodeTyIx[ix]
  if tpl < 0 || tpIfJoinAt.has(ix) { return 0 }
  const wt = widenLitTy(t)
  if wt == tpl || !tyHoldsListUnion(wt, 0) { return 0 }
  let st = tpl
  if tyHasTyVar(tpl) {
    const n = P.nodes[ix]
    if !(n is ArrayLit || n is ObjLit || n is FuncDecl) { return 0 }
    st = substTyDeep(tpl, tpIfCmpNames, tpIfCmpTys)
  }
  if st == wt || tyEq(st, wt) { return 0 }
  tpIfCmpBadSet(
    "the value is "
      + tyToStr(wt)
      + " where the body builds "
      + tyToStr(st)
      + " — narrow it with `is` first",
  )
  0
}

// Whether `o` holds a member apart from some member of `u` (`tyParamsPart`) that no member of
// `u` is the same variant as, one of the two being a union: `T[] | f64[]` beside `string[]`
// keeps all three, and `T[]` beside `T[] | f64[]` both (D2783, D2814).
function tyParamArmAbsorbs(u: i32, o: i32): boolean {
  if !tpApartConcrete { return false }
  if u < 0 || o < 0 || u >= T.tys.length || o >= T.tys.length { return false }
  if !(T.tys[u] is TyUnion) && !(T.tys[o] is TyUnion) { return false }
  const us: i32[] = []
  flattenVariantsInto(u, us)
  const os: i32[] = []
  flattenVariantsInto(o, os)
  let j = 0
  while j < os.length {
    let same = false
    let apart = false
    let i = 0
    while i < us.length {
      if us[i] == os[j] || sameVariantTy(us[i], os[j]) { same = true }
      if tyParamsPart(us[i], os[j], 0) { apart = true }
      i = i + 1
    }
    if apart && !same { return true }
    j = j + 1
  }
  false
}

// The join of `a` and `b` as distinct variants: a flattened, deduped union, with nullability
// folding back into a `?` wrapper.
function joinVariantTys(a: i32, b: i32) {
  const vars: i32[] = []
  flattenVariantsInto(a, vars)
  flattenVariantsInto(b, vars)
  const kept: i32[] = []
  let hasNull = false
  let i = 0
  while i < vars.length {
    const v = vars[i]
    if isNullTy(v) {
      hasNull = true
    } else {
      let dup = false
      let j = 0
      while j < kept.length {
        if kept[j] == v { dup = true }
        if sameVariantTy(kept[j], v) { dup = true }
        if !dup {
          const fw = joinObjFieldwise(kept[j], v)
          if fw >= 0 {
            kept[j] = fw
            dup = true
          }
        }
        j = j + 1
      }
      if !dup { kept.push(v) }
    }
    i = i + 1
  }
  dropStrLitsBesideString(kept)
  if kept.length == 0 { return TY_NULL }
  // A set joined with a map it shares a rep with has no union to become (D2673); the node whose
  // check made the join reports it (`checkNodeDone`).
  const jclash = setMapUnionClashMsg(kept, true)
  if jclash != "" {
    joinClashMsgSet(jclash)
    return TY_ERR
  }
  let res = kept[0]
  if kept.length > 1 { res = mkUnionTy(kept) }
  if hasNull { return mkNullableTy(res) }
  res
}

// Two records sharing a field-name set that D1023 would refuse as union arms join as one
// record of per-field joins, the type the annotated spelling names (D2731); -1 otherwise.
function joinObjFieldwise(a: i32, b: i32): i32 {
  if a < 0 || b < 0 || a >= T.tys.length || b >= T.tys.length { return -1 }
  const ta = T.tys[a]
  const tb = T.tys[b]
  if ta is TyObj {
    if tb is TyObj {
      if !objSigSame(ta, tb) || objArmsSameType(ta, tb) { return -1 }
      if objArmsDiscriminable(ta, tb) { return -1 }
      let k = 0
      while k < ta.objFieldNames.length {
        if (
          !fieldJoinKeepsRecordsApart(
            ta.objFieldTypes[k],
            objPairedTy(ta, tb, k),
          )
        ) {
          return -1
        }
        k = k + 1
      }
      const names: string[] = []
      const tys: i32[] = []
      let i = 0
      while i < ta.objFieldNames.length {
        names.push(ta.objFieldNames[i])
        tys.push(joinTys(ta.objFieldTypes[i], objPairedTy(ta, tb, i)))
        i = i + 1
      }
      recordJoinMintedSet(true)
      return mkObjTy(names, tys)
    }
  }
  -1
}

// The return-inference join, for `noteInferredRet` alone — not the general `joinTys`. A hole must
// not collapse here: it is permissively assignable both ways, so the mutual-assignability collapse
// picks one side and drops the other. Keeping both as a deferred join hands the choice to the call
// site; such a join has no runtime shape, so every path to the emitter must collapse it again.
function joinRetTys(a: i32, b: i32) {
  if a < 0 { return b }
  if b < 0 { return a }
  if a == b { return a }
  if !tyIsHole(a) && !tyIsHole(b) {
    const saved = tpApartConcrete
    tpApartConcreteSet(true)
    njApartSet(njApartRet)
    const j = joinTys(a, b)
    tpApartConcreteSet(saved)
    return j
  }
  const kept: i32[] = []
  flattenVariantsInto(a, kept)
  flattenVariantsInto(b, kept)
  const uniq: i32[] = []
  let i = 0
  while i < kept.length {
    let dup = false
    let j = 0
    while j < uniq.length {
      if uniq[j] == kept[i] { dup = true }
      j = j + 1
    }
    if !dup { uniq.push(kept[i]) }
    i = i + 1
  }
  if uniq.length == 1 { return uniq[0] }
  const res = mkUnionTy(uniq)
  joinHoleUnions.push(res)
  if njApartRet { apartHoleJoins[res] = true }
  res
}

// Collapse a deferred join about to escape the checker — a call's result type, which becomes a node
// type the emitter reads. Re-joining through the ordinary `joinTys` means an unresolvable join,
// whose members name a hole this site does not bind, behaves as an ordinary join rather than
// reaching codegen as a union the emitter has no rep for. Anything else passes through.
function collapseDeferredJoin(tyIx: i32) {
  if !tyIsDeferredJoin(tyIx) { return tyIx }
  const t = T.tys[tyIx]
  if t is TyUnion {
    const apart = apartHoleJoins.get(tyIx) ?? false
    let res = -1
    let i = 0
    while i < t.uMembers.length {
      if res >= 0 { njApartSet(apart) }
      res = joinTys(res, t.uMembers[i])
      njApartSet(false)
      i = i + 1
    }
    if res >= 0 { return res }
  }
  tyIx
}

// Deferred join `tyIx` as the join a body declaring its parameters keeps apart: the members
// once each, a null as the wrapper, both marked so every pin re-joins it as the lambda does.
function openParamJoinOf(tyIx: i32): i32 {
  const ms: i32[] = []
  flattenVariantsInto(tyIx, ms)
  const kept: i32[] = []
  let hasNull = false
  for m in ms {
    if isNullTy(m) {
      hasNull = true
    } else {
      let dup = false
      for k in kept {
        if k == m || sameVariantTy(k, m) || sameDeclaredTyParam(k, m) {
          dup = true
        }
      }
      if !dup { kept.push(m) }
    }
  }
  // Every member is a parameter's runtime value, so numbers stay apart at the pin (D3521).
  const u = mkUnionTy(kept)
  // arena-tick exempt: a per-program mark on a fresh arena row.
  tpJoinUnions[u] = 2
  if !hasNull { return u }
  const res = mkNullableTy(u)
  // arena-tick exempt: a per-program mark on a fresh arena row.
  tpJoinUnions[res] = 2
  res
}

// Soundness gate on the re-fold: is deferred-join member `mIx` provably dead under these bindings,
// a branch the pinned argument can never take? Only a derived member-read hole can be proven dead,
// and only against a concrete pin. Everything else is live — in particular a member that merely
// resolved to another hole is still undecided, and calling that dead is itself a soundness hole.
function holeMemberDeadAt(mIx: i32, bNames: string[], bTys: i32[]) {
  if mIx < 0 { return false }
  const t = T.tys[mIx]
  if !(t is TyVar) { return false }
  const base = holeBaseTy(mIx)
  if base == mIx {
    return false // not a derived read — never provably dead
  }
  const pin = substHoleTy(base, bNames, bTys)
  if pin < 0 {
    return false // the base is not pinned here — defer
  }
  if tyIsHole(pin) {
    return false // pinned to another hole — still undecided
  }
  // The base is concrete, yet the derived read does not resolve: this branch cannot be reached by
  // this argument.
  substHoleTy(mIx, bNames, bTys) < 0
}

// Re-fold a deferred join under a call's bindings: drop every provably dead member and re-join the
// rest, so a call site where exactly one arm is live sees that arm's type rather than a spurious
// `A | B`. A merely unresolved member survives, and the join re-folds again at the site that pins
// it. The re-join goes through `joinRetTys`, so a surviving hole member is not collapsed away.
function refoldJoinUnion(
  tyIx: i32,
  orig: i32[],
  subst: i32[],
  changed: boolean,
  bNames: string[],
  bTys: i32[],
) {
  let anyDead = false
  let i = 0
  while i < orig.length {
    if holeMemberDeadAt(orig[i], bNames, bTys) { anyDead = true }
    i = i + 1
  }
  if !anyDead && !changed { return tyIx }
  let res = -1
  let live = 0
  let j = 0
  // A lambda's deferred return re-joins as it always has: its instance builds no kept-apart join.
  lamCheckDepth = lamCheckDepth + 1
  lamRefoldDepth = lamRefoldDepth + 1
  const apart = apartHoleJoins.get(tyIx) ?? false
  while j < orig.length {
    if !holeMemberDeadAt(orig[j], bNames, bTys) {
      njApartRetSet(apart)
      res = joinRetTys(res, subst[j])
      njApartRetSet(false)
      live = live + 1
    }
    j = j + 1
  }
  lamCheckDepth = lamCheckDepth - 1
  lamRefoldDepth = lamRefoldDepth - 1
  // Every arm proven dead is not a type — keep the union rather than invent one.
  if live == 0 || res < 0 { return mkUnionTy(subst) }
  // The null `paramNullJoin` kept stays: re-joined here, outside the body that declared the
  // holes, the caller's holes would absorb it (D3497).
  if paramNullJoins.has(tyIx) && !isNullTy(res) && !tyBearsNull(res) {
    for m in subst {
      if isNullTy(m) { return mkNullableTy(res) }
    }
  }
  res
}

// Do every deferred binary-op constraint this binding resolves hold — the capability check as a
// pure boolean, `validateBinCstrs` being the diagnostic-emitting twin? A constraint still touching
// an unbound hole defers, answering true.
function binCstrsHold(bNames: string[], bTys: i32[], calleeFn: i32) {
  let ci = 0
  while ci < binCstr.op.length {
    if cstrOwnedBy(binCstr.fn[ci], calleeFn) {
      const clt = substTyDeep(binCstr.lt[ci], bNames, bTys)
      const crt = substTyDeep(binCstr.rt[ci], bNames, bTys)
      if !tyHasHole(clt) {
        if !tyHasHole(crt) {
          if eqLitNonMember(clt, crt) { return false }
          if !eqLitMemberOk(clt, crt) && !eqLitMemberOk(crt, clt) {
            if !binOpDefinedFor(binCstr.op[ci], clt, crt) { return false }
          }
        }
      }
    }
    ci = ci + 1
  }
  true
}

// Is a generic function value of type `srcTy` (hole params or return) assignable to the concrete
// function type `dstTy`? Instantiate it at `dstTy`'s param types, require the body's capability to
// hold there and the substituted return to match — the per-call-site instantiation driven by the
// target type. The permissive structural `assignable` would accept a mismatch that cannot lower.
function genericFnAssignable(srcTy: i32, dstTy: i32) {
  const s = T.tys[srcTy]
  const d = T.tys[dstTy]
  if s is TyFunc {
    if d is TyFunc {
      const sp = s.fnParamTypes
      const dp = d.fnParamTypes
      if sp.length != dp.length { return false }
      const bNames: string[] = []
      const bTys: i32[] = []
      let i = 0
      while i < sp.length {
        bindGenWalk(sp[i], dp[i], bNames, bTys)
        if !assignable(dp[i], sp[i]) { return false }
        i = i + 1
      }
      // -1: a function value names no declaration here, so every constraint is still consulted —
      // `cstrOwnedBy`'s unknown-callee fallback, rather than guessing an owner from a `TyFunc`.
      if !binCstrsHold(bNames, bTys, CSTR_ANYFN) { return false }
      if !argCstrsHold(bNames, bTys) { return false }
      // No `retCstrsHold` rung here, and its absence is deliberate. A function value names no
      // declaration, so `cstrOwnedBy`'s fallback puts every generic's return constraint in scope,
      // and `substTyDeep` matches TyVars by name, so it can refuse an unrelated instantiation.
      // The `assignable` on the next line already compares the instance's return to the target's.
      return assignable(substTyDeep(s.fnRet, bNames, bTys), d.fnRet)
    }
  }
  false
}

// A declared generic function delivered by name as a value to the concrete function type
// `dstTy` is instantiated there, so the constraints its body deferred are adjudicated at the
// bindings that type gives its parameters, as a direct call's are (D3080).
function genFnValueCstrs(srcExpr: i32, srcTy: i32, dstTy: i32) {
  // A validator re-delivers a recorded value through `assignableExpr`, which must not re-enter.
  // With no generic declared, or no function type in the destination, there is nothing to bind.
  if genFnCstrBusy || !cstrCandAny || !tyMayHoldFn(dstTy, 0) { return 0 }
  genFnCstrBusySet(true)
  genFnValueCstrsAt(srcExpr, srcTy, dstTy, 0)
  genFnCstrBusySet(false)
  0
}

// `genFnValueCstrs` at `srcExpr`, reaching through the fields of an object literal and the
// elements of a list literal delivered to a record or list type, `depth` levels down.
function genFnValueCstrsAt(srcExpr: i32, srcTy: i32, dstTy: i32, depth: i32) {
  if srcExpr < 0 || dstTy < 0 || depth > 8 { return 0 }
  const lit = P.nodes[parenPeelIx(srcExpr)]
  if lit is ObjLit {
    const dobj = T.tys[dstTy]
    if dobj is TyObj {
      for fi in lit.objFields {
        const f = P.nodes[fi]
        if f is FieldInit {
          const ft = objFieldType(dobj, f.fiName)
          if ft >= 0 {
            genFnValueCstrsAt(f.fiValue, nodeTyOf(f.fiValue), ft, depth + 1)
          }
        }
      }
    }
    return 0
  }
  if lit is ArrayLit {
    const darr = T.tys[dstTy]
    if darr is TyArray {
      for el in lit.arrElems {
        genFnValueCstrsAt(el, nodeTyOf(el), darr.aElem, depth + 1)
      }
    }
    return 0
  }
  const e = lit
  if !(e is Ident) { return 0 }
  let st = srcTy
  if st < 0 { st = lookup(e.identName) }
  if st < 0 { return 0 }
  let decl = fnDeclIx[e.identName] ?? CSTR_NODECL
  // A generic nested in the enclosing function, delivered where that function's own type
  // parameters type the destination (`return b` at `(T) => void`): its demands are re-recorded
  // at those parameters, as a call of it in the enclosing body is (D3896).
  let nested = false
  if decl < 0 {
    const nd = lookupFnDeclNode(e.identName)
    if nestParentOf.has(nd) {
      decl = nd
      nested = true
    }
  }
  if decl < 0 || decl >= P.nodes.length { return 0 }
  const fd = P.nodes[decl]
  if !(fd is FuncDecl) { return 0 }
  if fd.fnTyParams.length == 0 { return 0 }
  let dt = dstTy
  const dn = T.tys[dt]
  if dn is TyNullable { dt = dn.nInner }
  // At a concrete destination a nested generic is the function-value adapter's to check, which
  // reports the same demand as its reason.
  const open = tyHasTyVar(dt)
  if dt < 0 || (nested && !open) { return 0 }
  // A generic declared elsewhere is deferred only to the generic whose body is being checked,
  // so every type variable of the destination must be that generic's.
  if !nested && open && !tyVarsOfEnclosingGeneric(dt) { return 0 }
  const s = T.tys[st]
  const d = T.tys[dt]
  if !(s is TyFunc) || !(d is TyFunc) { return 0 }
  if s.fnParamTypes.length != d.fnParamTypes.length { return 0 }
  const bNames: string[] = []
  const bTys: i32[] = []
  let i = 0
  while i < s.fnParamTypes.length {
    bindGenWalk(s.fnParamTypes[i], d.fnParamTypes[i], bNames, bTys)
    i = i + 1
  }
  if bNames.length == 0 { return 0 }
  const noN: string[] = []
  const noNo: i32[] = []
  const noNode: i32[] = []
  const who = e.identName
  const noArgs: i32[] = []
  const modeWas = substNestMode
  const declWas = substNestDecl
  const strictWas = cstrOwnedStrict
  const cvWas = cvNow
  let owner = decl
  if nested {
    owner = CSTR_NODECL
    substNestModeSet(SUBST_NESTED)
    substNestDeclSet(decl)
  } else if open {
    // A destination typed by the enclosing generic's parameters defers what it cannot decide to
    // that generic, as a direct call in its body does; only the delivered function's own
    // constraints are re-asked (D3923).
    substNestModeSet(SUBST_DECLARED)
    cstrOwnedStrictSet(true)
    // What is deferred carries this delivery, which the refusal at the pin names.
    cvNow = srcExpr
  }
  pinBmCstrElems(bNames, bTys, srcExpr, owner, noArgs)
  validateBinCstrs(bNames, bTys, srcExpr, owner, who, noN, noNo, noNode)
  validatePrintCstrs(bNames, bTys, srcExpr, owner, who)
  validateNestCstrs(bNames, bTys, srcExpr, owner, who)
  validateArgCstrs(bNames, bTys, srcExpr, owner, noN, noNode)
  validateRetCstrs(bNames, bTys, srcExpr, owner, who)
  validateLetCstrs(bNames, bTys, srcExpr, owner, who)
  validateBmCstrs(bNames, bTys, srcExpr, owner, who)
  validateMemCstrs(bNames, bTys, srcExpr, owner, who, noN, noNo, noNode)
  validateUfcsCstrs(bNames, bTys, srcExpr, owner, who)
  cstrOwnedStrictSet(strictWas)
  cvNow = cvWas
  substNestModeSet(modeWas)
  substNestDeclSet(declWas)
  0
}

// Record the destination record on a record literal delivered where a field's type differs
// from its own (`{ k: [1, 2] }` into `{ k: f64[] }`), so the emitter builds the literal at the
// destination's row and not at another row that shares its field names (D2437).
function recordListFieldWidenAdopt(srcExpr: i32, dstTy: i32) {
  if inferQuiet || srcExpr < 0 || dstTy < 0 { return 0 }
  if tyDeeperThan(dstTy, 16) { return 0 }
  let dtix = dstTy
  const dN = T.tys[dtix]
  if dN is TyNullable { dtix = dN.nInner }
  if dtix < 0 { return 0 }
  const d = T.tys[dtix]
  const e = P.nodes[parenPeelIx(srcExpr)]
  if !(d is TyObj) { return 0 }
  // A union-bearing destination is the union-softening stamp's, in `assignableExpr`.
  if tyReachesUnion(dtix, 8) { return 0 }
  if e is ObjLit {
    if e.objFields.length != d.objFieldNames.length { return 0 }
    let differs = false
    let k = 0
    while k < e.objFields.length {
      const f = P.nodes[e.objFields[k]]
      if f is FieldInit {
        let dj = -1
        let j = 0
        while j < d.objFieldNames.length {
          if d.objFieldNames[j] == f.fiName { dj = j }
          j = j + 1
        }
        if dj < 0 { return 0 }
        const own = nodeTyIxOf(f.fiValue)
        if own < 0 { return 0 }
        if !tyEq(own, d.objFieldTypes[dj]) { differs = true }
      } else {
        return 0
      }
      k = k + 1
    }
    if differs { return recordRepTyAdopt(srcExpr, dtix, 6) }
  }
  0
}

// D581 — the element's source type for the array-literal recursion, and the one place this function
// reads the container instead of the element node. The element node's own recorded type is the
// precise answer at the body's first ask, but at the pin it is stale — it still says `T`, so
// `assignable(T, string)` waves every element past. Gated on the element's record being hole-bearing.
function litElemSrcTy(elemIx: i32, srcTy: i32) {
  const nt = nodeTyIxOf(elemIx)
  if nt < 0 { return nt }
  if !tyHasHole(nt) { return nt }
  // Under a pin's re-check the element's own type is substituted: a literal joining `T` with a
  // concrete element is a gradual union, wider than its own `T` element (D2906).
  if litPinN.length > 0 {
    const pe = substTyDeep(nt, litPinN, litPinT)
    if pe >= 0 && !tyHasHole(pe) { return pe }
  }
  if srcTy < 0 { return nt }
  const s = T.tys[srcTy]
  if s is TyArray {
    if s.aElem >= 0 {
      if !tyHasHole(s.aElem) { return s.aElem }
    }
  }
  nt
}

// The function-value into void-slot grant (see its call site in `assignableExpr`). True — and the
// seam recorded for the emitter's twin mint — when `dstTy` is a `TyFunc` returning `void`, `srcTy`
// is a concrete `TyFunc` with a resolved non-void return, the param lists match pairwise under
// `fnSlotAssignable`, and `srcExpr` names an unshadowed module-scope `function` declaration.
function fnValVoidCoerce(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if srcExpr < 0 || srcTy < 0 || dstTy < 0 { return false }
  const d = T.tys[dstTy]
  if !(d is TyFunc) { return false }
  if !isVoidTy(d.fnRet) { return false }
  const s = T.tys[srcTy]
  if !(s is TyFunc) { return false }
  if fnTyHasHole(srcTy) { return false }
  // The source's return must be resolved and non-void: a `-2` pending return is still being
  // inferred, and a void source needs no coercion, taking the plain assignable path.
  if s.fnRet < 0 { return false }
  if isVoidTy(s.fnRet) { return false }
  const sp = s.fnParamTypes
  const dp = d.fnParamTypes
  if sp.length != dp.length { return false }
  let i = 0
  while i < sp.length {
    if !fnSlotAssignable(dp[i], sp[i]) { return false }
    i = i + 1
  }
  // The expression form: a paren-peeled Ident naming an unshadowed module-scope
  // `function` declaration.
  let u = srcExpr
  let done = false
  while !done {
    const pn = P.nodes[u]
    if pn is Paren { u = pn.parInner } else { done = true }
  }
  const en = P.nodes[u]
  if en is Ident {
    if (fnDeclIx[en.identName] ?? -1) < 0 { return false }
    if lookupDepth(en.identName) != 0 { return false }
    if !inferQuiet { noteVoidCoerceVal(u, en.identName) }
    return true
  }
  false
}

// Pin the radix literal at `litIx` to `width`. Answers 2 when this reported (the caller then
// answers the flow true, so the opaque width mismatch is not said twice), else 1 when the literal
// adopted 64 bits, else 0. A pattern past 64 bits reported at the literal itself, so it is silent
// here.
function radixLitAdoptWidth(litIx: i32, width: i32) {
  const t = P.nodes[litIx]
  if t is NumLit {
    const bits = numLexRadixBits(t.numText)
    if bits > 64 { return 2 }
    if width == 64 {
      while litWide64.length <= litIx { litWide64Push(false) }
      litWide64SetAt(litIx, true)
      if litIx < nodeTyIx.length { nodeTySet(litIx, TY_I64) }
      return 1
    }
    if bits > width {
      if !inferQuiet { tErr(radixLitTooWideMsg(t.numText, width), litIx) }
      return 2
    }
  }
  0
}

// Pin the radix literal `srcExpr` delivers into `dstTy` to the destination's width. A value
// `if`, `match` or block delivers its tails, and an object or array literal its fields and
// elements, so each reaches its own destination here too (D2617). A negated literal is a literal
// tree, which `litTreeAdoptDst` pins below (D3049).
function radixLitAdoptDst(srcExpr: i32, dstTy: i32) {
  if inferQuiet || srcExpr < 0 || dstTy < 0 { return 0 }
  const lix = parenPeelIx(srcExpr)
  const e = P.nodes[lix]
  if e is NumLit {
    if numLexRadixBits(e.numText) < 0 { return 0 }
    const w = dstIntWidth(dstTy, 3)
    if w < 0 { return 0 }
    return radixLitAdoptWidth(lix, w)
  }
  if e is IfStmt || e is MatchExpr || e is Block {
    return radixLitAdoptTails(lix, dstTy)
  }
  if e is ObjLit { return radixLitAdoptFields(e, dstTy) }
  if e is ArrayLit { return radixLitAdoptElems(e, dstTy) }
  if e is BinExpr || e is Unary {
    if litTreeAdoptDst(lix, dstTy) == TY_I64 { return 1 }
    return 0
  }
  radixLitNoParts()
}

// The fields of object literal `e`, each against its own destination field type. A bare literal
// field is left alone: the emitter already reads it at the slot's width, and `assignableExpr`'s
// own field-wise recursion pins it when that one runs.
function radixLitAdoptFields(e: ObjLit, dstTy: i32) {
  const dix = nonNullTy(dstTy)
  if dix < 0 { return 0 }
  const d = T.tys[dix]
  let rc = 0
  if d is TyObj {
    let i = 0
    while i < e.objFields.length {
      const f = P.nodes[e.objFields[i]]
      if f is FieldInit {
        const fty = objFieldType(d, f.fiName)
        if fty >= 0 && !(P.nodes[parenPeelIx(f.fiValue)] is NumLit) {
          const fc = radixLitAdoptDst(f.fiValue, fty)
          if fc > rc { rc = fc }
        }
      }
      i = i + 1
    }
  }
  rc
}

// The elements of array literal `e`, each against the element type of `dstTy`, a bare literal
// element left alone as a bare field is.
function radixLitAdoptElems(e: ArrayLit, dstTy: i32) {
  const dix = nonNullTy(dstTy)
  if dix < 0 { return 0 }
  const d = T.tys[dix]
  let rc = 0
  if d is TyArray {
    let i = 0
    while i < e.arrElems.length {
      const el = e.arrElems[i]
      if !(P.nodes[parenPeelIx(el)] is NumLit) {
        const ec = radixLitAdoptDst(el, d.aElem)
        if ec > rc { rc = ec }
      }
      i = i + 1
    }
  }
  rc
}

// The tails of the value `if`, `match` or block at `ix`, pinned to `dstTy`. Only a join every
// `if` and `match` of which is typed `i32` or `i64` takes part. When a tail widens to 64 bits,
// those nodes are re-typed `i64` with it, so the emitter builds the join at that width; at a float
// destination they are re-typed to it, so a radix tail is read as the value a bare one is.
function radixLitAdoptTails(ix: i32, dstTy: i32) {
  const spine: i32[] = []
  const leaves: i32[] = []
  valueTailSplit(ix, spine, leaves)
  let all32 = true
  let si = 0
  while si < spine.length {
    // A `match` desugared ahead of this delivery leaves its later links untyped; the head's type
    // is the whole chain's.
    const pt = nodeTyOf(spine[si])
    if !(pt < 0 && spine[si] != ix) {
      const pn = primNameOf(pt)
      if pn != "i32" && pn != "i64" { return 0 }
      if pn != "i32" { all32 = false }
    }
    si = si + 1
  }
  let reTy = -1
  let rc = 0
  const fpn = primNameOf(nonNullTy(dstTy))
  if fpn == "f64" || fpn == "f32" {
    let treeLeaf = false
    let ti = 0
    while ti < leaves.length {
      if litTreeAdoptDst(parenPeelIx(leaves[ti]), dstTy) >= 0 {
        treeLeaf = true
      }
      ti = ti + 1
    }
    if all32 && (treeLeaf || radixLeafAmong(leaves)) { reTy = nonNullTy(dstTy) }
  } else {
    let i = 0
    while i < leaves.length {
      const lc = radixLitAdoptDst(leaves[i], dstTy)
      if lc > rc { rc = lc }
      i = i + 1
    }
    if rc == 1 { reTy = TY_I64 }
  }
  if reTy >= 0 {
    let s = 0
    while s < spine.length {
      if spine[s] < nodeTyIx.length { nodeTySet(spine[s], reTy) }
      s = s + 1
    }
  }
  rc
}

// The type of the value `if` or `match` at `ix` when some tail is an `f32` value and every other
// is a float literal, which adopts f32 as it does beside an operator (`raw * 2.0`); else -1. Its
// `if`/`match` nodes are re-typed f32, so each literal re-encodes at single precision (D2775).
function joinF32LitTails(ix: i32): i32 {
  const spine: i32[] = []
  const leaves: i32[] = []
  valueTailSplit(ix, spine, leaves)
  let fTy = -1
  let lits = 0
  let i = 0
  while i < leaves.length {
    const lt = nodeTyOf(leaves[i])
    if isFloatLitExpr(leaves[i]) { lits = lits + 1 }
    else if lt >= 0 && primNameOf(lt) == "f32" { fTy = joinTys(fTy, lt) }
    else { return -1 }
    i = i + 1
  }
  if lits == 0 || fTy < 0 || primNameOf(fTy) != "f32" { return -1 }
  // Flagged on every pass: an inference pass records the `if`'s value type too.
  let s = 0
  while s < spine.length {
    if !inferQuiet && spine[s] < nodeTyIx.length { nodeTySet(spine[s], fTy) }
    f32JoinAdoptedSetAt(spine[s], true)
    f32JoinAdoptCountSet(f32JoinAdoptCount + 1)
    s = s + 1
  }
  fTy
}

// The f32 a value `match` at `ix` typed `matchTy` takes when its arms are an f32 value and
// literals, as an `if` does, else -1, with any inner join re-typed f32 handed back `matchTy`.
function matchF32Join(ix: i32, matchTy: i32): i32 {
  if ix < 0 || matchTy < 0 { return -1 }
  let j = -1
  if primNameOf(matchTy) == "f64" {
    if !valDiscarded(ix) && (!matchInRetTail || f32JoinRetypesRunning()) {
      j = joinF32LitTails(ix)
    }
  }
  if j < 0 { f32JoinRevert(ix) }
  j
}

// A radix literal takes the OTHER operand's width, so `x >= 0x80000000` over an `i64` compares the
// 64-bit pattern rather than the i32 one its digits imply. Upward only: a 32-bit peer leaves a
// wide literal alone, so `x + 0x1_0000_0000` still widens the expression to i64.
function radixLitAdoptPeer64(exprIx: i32, peerTy: i32) {
  if dstIntWidth(peerTy, 3) != 64 { return 0 }
  radixLitAdoptDst(exprIx, peerTy)
}

export function assignableExpr(srcExpr: i32, srcTy: i32, dstTy: i32) {
  lbiNoteDelivery(srcExpr, dstTy, nlAsgTgt)
  nolNoteDelivery(srcExpr, dstTy)
  if fsbName.length > 0 && !inferQuiet && srcExpr >= 0 {
    fsbNoteFnDelivery(srcExpr, dstTy)
  }
  if numUnionMinted && numUnionConverts(srcTy, dstTy) && !njExprHeld(srcExpr) {
    return true
  }
  if litNumUnionConverts(srcTy, dstTy) && !njExprHeld(srcExpr) {
    numUnionMinted = true
    return true
  }
  if srcExpr >= 0 && dstTy >= 0 {
    const cse = P.nodes[srcExpr]
    if cse is NumLit || cse is Unary || cse is Paren {
      if cexDeliver(srcExpr, dstTy) { return true }
    }
  }
  // A bare `{}` completes against a record destination; a required field it omits is refused
  // here, in words, instead of as the site's generic mismatch (D2223).
  if bareBraceDeliver(srcExpr, dstTy, 8, true) { return true }
  // A generic function value meeting a concrete function type is decided by instantiation inside
  // `assignable`'s `TyFunc` case (`genericFnAssignable`), so it governs nested positions like an
  // array element too, not just this expression-level entry.
  recordElemRepArrayLit(srcExpr, dstTy, 6)
  recordNullHoleObjAdopt(srcExpr, dstTy, 6)
  recordListFieldWidenAdopt(srcExpr, dstTy)
  // A hex / binary / octal literal is a bit pattern of the destination's width, and this seam is
  // where every binding / argument / return / field / element / store position delivers one.
  if srcTy == TY_I32 && litTreeAdoptDst(parenPeelIx(srcExpr), dstTy) >= 0 {
    return true
  }
  if radixLitAdoptDst(srcExpr, dstTy) == 2 { return true }
  // Rep sidecar: an ObjLit/ArrayLit whose source type reaches an unresolved empty-collection hole
  // (`{nodes: []}`, `{m: Map()}`) is plainly `assignable` to its concrete destination, so the
  // short-circuit below returns before the adoption block. Record the destination here so the
  // emitter's row resolver keys the element-resolved shape. Writes only `nodeRepTyIx`.
  if !inferQuiet && srcExpr >= 0 && tyReachesEmptyHole(srcTy, 8) {
    recordRepTyAdopt(srcExpr, dstTy, 6)
  } else if !inferQuiet && srcExpr >= 0 && tyReachesUnion(dstTy, 8) {
    // Union-softening adoption (see `tyReachesUnion`): an ObjLit/ArrayLit whose field value
    // narrowed a destination union field leaves the recorded rep type softened, mis-resolving a
    // same-fieldset twin. Re-stamp the destination rep so the emitter's structural row resolver
    // keys the union-bearing shape. Writes only `nodeRepTyIx`.
    recordRepTyAdopt(srcExpr, dstTy, 6)
  }
  // The flow hook for the un-annotated-parameter solve. It sits above the `assignable`
  // short-circuit because a hole source always returns there, so this is the only point in the
  // function a hole reaches — and every binding / argument / return / field / element / store
  // position flows through here. Inert unless the parameter-solve probe is running.
  noteHoleFlow(srcTy, dstTy, srcExpr)
  if !inferQuiet && narListDeliveryErr(srcExpr, srcTy, dstTy) { return true }
  if assignable(srcTy, dstTy) {
    if !inferQuiet && srcExpr >= 0 { genFnValueCstrs(srcExpr, srcTy, dstTy) }
    if fvaAdapt(srcExpr, srcTy, dstTy) { return true }
    // The constraint probe records a hole delivery's pin as well, so a caller whose body is
    // checked before this one still re-asks it at its own pins.
    if cstrProbe && srcExpr >= 0 { rcwPinProbe(srcExpr, srcTy, dstTy) }
    // The object-shape floor. `assignable` accepts structural subtyping between two object shapes
    // and the emitter has no adapter for it (`objShapeAdapterless`), so the pair would reach codegen
    // and fail there on a file `vl check` reports clean. It belongs at this seam, the one every
    // delivery flows through. Reported here and answered true, the program being type-valid.
    if !inferQuiet && srcExpr >= 0 {
      // The `Writable` floor (D793). A covariant list assignment whose value is written through
      // cannot be lowered by either answer the language has — an alias admits a type-confused read,
      // and a converting copy gives one handle a private list. The assignment itself is illegal,
      // reported at this seam and answered true, the program being type-valid.
      const cwCode = covarWriteThrough(srcExpr, srcTy, dstTy)
      if cwCode == 1 {
        covarWriteThroughErr(srcExpr, srcTy, dstTy)
        return true
      }
      // D853 — the second arm is a different unsoundness and says so. Two declared unions over one
      // written-through list share one box, so nothing is copied and "the two element storages
      // differ" would be false. The message names the arms rather than the storages.
      if cwCode == 2 {
        covarTwoUnionsErr(srcExpr, srcTy, dstTy)
        return true
      }
      noteRefListView(srcExpr, srcTy, dstTy)
      // D2060 — the record twin: a field widened by this delivery is shared with the source,
      // so it is legal only where nothing the delivery reaches writes it.
      rcwPend(srcExpr, srcTy, dstTy)
      if mapDeliveryMayRecord(srcExpr, srcTy, dstTy) {
        recordMapUnbox(srcExpr, srcTy, dstTy, 8)
      } else if tyWideUnionMinted {
        recordListWidenRetag(srcExpr, srcTy, dstTy)
      }
      if !wsSuppress && objShapeAdapterlessAt(srcExpr, srcTy, dstTy) {
        objShapeAdapterlessErr(srcExpr, srcTy, dstTy)
      } else if srcTy != dstTy {
        let recDst = dstTy
        if dstTy == lwStoreDst && lwStoreVal >= 0 { recDst = lwStoreVal }
        recPend(srcExpr, srcTy, recDst, srcExpr)
      } else if T.tys[srcTy] is TyObj || T.tys[srcTy] is TyArray {
        recOwnPend(srcExpr, srcTy)
      }
    }
    return true
  }
  if !inferQuiet && srcExpr >= 0 && recAdForce(srcExpr, srcTy, dstTy) {
    return true
  }
  // Nominal newtype: a syntactic literal is brand-polymorphic and adopts the destination's brand
  // (`const e: EntityId = 1`). A literal has no prior identity, so it cannot be the confusion a
  // newtype exists to catch. Only the destination's own brand is waived, by retrying against the
  // base index; an object literal needs no arm, its field-wise block re-applying the rule per field.
  if nomLitAdopts(srcExpr, srcTy, dstTy) { return true }
  // Function value into a void slot: a `(P…) => T` value is assignable where `(P…) => void` is
  // expected — the coercion that keeps "extract the inline lambda to a named function" from breaking
  // the call that worked. Keyed on the expected type's return being void, and granted only for the
  // set `synthVoidTwins` can mint a capture-free void twin for; other values keep the mismatch.
  if fnValVoidCoerce(srcExpr, srcTy, dstTy) { return true }
  // A `u8` storage slot — an array element, the only position `u8` is legal in — accepts any `i32`
  // value: the storage is one byte, `array.set` truncating to the low 8 bits and `array.get_u`
  // widening back into 0..255. The one error is an out-of-range non-negative integer literal. This
  // lives at the expression seam, `assignable(i32, u8)` staying false so an `i32[]` cannot flow in.
  if primNameOf(dstTy) == "u8" {
    if srcExpr >= 0 {
      const u8e = P.nodes[srcExpr]
      if u8e is Paren { return assignableExpr(u8e.parInner, srcTy, dstTy) }
      if u8e is NumLit {
        if numLexIsFloat(u8e.numText) { return false }
        if u8LexValue(u8e.numText) > 255 {
          if !inferQuiet {
            tErr(
              "the literal "
                + u8e.numText
                + " does not fit a `u8` element (0..255) — a computed value truncates to its low 8 bits, but a literal this size is a mistake the compiler can see",
              srcExpr,
            )
          }
          // Reported here and answered true, the same discipline `objShapeAdapterlessErr` follows:
          // the position is otherwise well-typed, so a second "cannot assign" from the caller
          // would contradict this message.
          return true
        }
        return true
      }
    }
    const u8s = primNameOf(srcTy)
    return u8s == "i32" || u8s == "u8"
  }
  // A literal re-encodes exactly at f32, so it flows into any destination whose f32 position it
  // fits: a bare `f32`, a nullable `f32?`, or an f32 member of a union. An arbitrary f64 or i32
  // value is not covered. Destination first, and that order is load-bearing for compile time: the
  // integer half folds the lexeme into a bignum, while `dstAdmitsF32` is a short arena walk.
  if dstAdmitsF32(dstTy) {
    if isF32AdoptingLitExpr(srcExpr) {
      cexFloatUse(srcExpr)
      return true
    }
    if f32LitTailsAdopt(srcExpr, dstTy) { return true }
  }
  // The same grant one width up, and only its integer half: an i32-typed literal already rides
  // the `i32 -> f64` lattice edge, so what this admits is the literals between 2^31 and 2^53 that
  // type `i64` and would otherwise meet the lossy `i64 -> f64` refusal. D1890.
  if dstAdmitsF64(dstTy) {
    if isExactF64IntLitExpr(srcExpr) {
      cexFloatUse(srcExpr)
      return true
    }
  }
  // A `const` literal, or a join of them, read as `string`: a literal-typed destination takes it at
  // the literal type it is, in a list or object literal exactly as at an argument (D2157).
  if srcExpr >= 0 && srcExpr < wideLitByNode.length {
    const uw = wideLitByNode[srcExpr]
    if uw >= 0 && uw != srcTy {
      if assignable(uw, dstTy) { return true }
    }
  }
  // A literal-typed destination: a bare literal flows wherever its literal type is a member (`"a"`
  // into `"a" | "b"`), even though its softened base (`string`) does not.
  if srcExpr >= 0 {
    const lTy = litTyOfExpr(srcExpr)
    if lTy >= 0 {
      if assignable(lTy, dstTy) { return true }
    }
    // An object literal checks field-wise against a literal-bearing object target, so a field's
    // bare literal can match a literal-union field (`{tag: "circle", r: 5}` against
    // `{tag: "circle" | "square", r: i32}`).
    const e = P.nodes[srcExpr]
    if e is Paren {
      const pok = assignableExpr(e.parInner, srcTy, dstTy)
      // A wrapping paren takes the f32 list its literal adopted, so both nodes read alike.
      if pok && !inferQuiet && f32ListUnder(srcExpr, e.parInner) {
        nodeTySet(srcExpr, nodeTyIxOf(e.parInner))
      }
      return pok
    }
    if e is ObjLit {
      const s = T.tys[srcTy]
      if s is TyObj {
        // A nullable struct target (`S | null`, or a `V?` map value) peels its wrapper so an object
        // literal still adapts field-wise into the inner struct — the ObjLit dual of the ArrayLit
        // peel below. The peel iterates: a nullable-value map slot stacks two wrappers, and a
        // single unwrap leaves the literal against `S | null`.
        let dtix = dstTy
        let dPeel = true
        while dPeel {
          const dNW = T.tys[dtix]
          if dNW is TyNullable { dtix = dNW.nInner } else { dPeel = false }
        }
        const d = T.tys[dtix]
        if d is TyObj {
          const dnames = d.objFieldNames
          const dtys = d.objFieldTypes
          let i = 0
          let ok = true
          while i < dnames.length {
            const sft = objFieldType(s, dnames[i])
            if sft < 0 {
              // Completion coercion: an object literal may omit a field whose declared type admits
              // null — the field is materialized as `null` at construction. A non-nullable omitted
              // field is still required. Scoped to this expression-aware path, not to general
              // structural assignability, so it never widens through a container or variance.
              if !tyAdmitsNull(dtys[i]) { ok = false }
            } else {
              // The field's value expression, for the literal-aware recursion.
              let fexpr = -1
              const fl = e.objFields
              let fi = 0
              while fi < fl.length {
                const fn = P.nodes[fl[fi]]
                if fn is FieldInit {
                  if fn.fiName == dnames[i] { fexpr = fn.fiValue }
                }
                fi = fi + 1
              }
              if !assignableExpr(fexpr, sft, dtys[i]) { ok = false }
            }
            i = i + 1
          }
          // Rep sidecar: a field-wise-adopted ObjLit builds the destination struct rep (a boxed
          // union field, an i64/f32 field, an omitted nullable field), so record it on the literal
          // node and the emitter's row resolver keys the shape it builds, not the self-inference.
          if ok { recordRepTyAdopt(srcExpr, dstTy, 6) }
          // A field the record does not declare is refused where the literal is written, as at
          // a destination `assignable` accepts by width (#1460). Reported and answered true.
          if (
            ok
            && bareBraceSpec == 0
            && !inferQuiet
            && srcExpr != argLitAt
            && objLitSetsUndeclared(e, dtix)
          ) {
            if !objLitHasDupKey(srcExpr) {
              objLitUndeclaredErr(srcExpr, srcTy, dtix, "")
            }
          }
          return ok
        }
        // A struct literal flowing into a union adopts the first struct arm it adapts into
        // field-wise (`{f: 97.5}` into `{f: f32} | {w: i32}`). The emitter already boxes a struct
        // literal into a union slot at a direct binding; this is the checker seam that lets a
        // widening field reach that same rep. The concrete arm is recorded on the literal node.
        if d is TyUnion {
          // Flattened, because a union member may itself be a union: `type Shape = Circle | Rect`
          // used as an arm of `Shape | ParseError` leaves a `TyUnion` in `uMembers`, which the
          // `mt is TyObj` test skips. Each candidate is still gated by `unionArmBoxSafe` and still
          // recorded as the concrete arm; canon's union-alias flatten covers both spellings.
          const members: i32[] = []
          flattenVariantsInto(dstTy, members)
          // An arm declaring every field the literal sets is preferred; an arm that would drop
          // one is taken only when no other accepts, and then refused as at a record (#1460).
          let mi = 0
          let pass = 0
          while pass < 2 {
            mi = 0
            while mi < members.length {
              const mt = T.tys[members[mi]]
              if (
                mt is TyObj
                && unionArmBoxSafe(members[mi])
                && objLitSetsUndeclared(e, members[mi]) == (pass == 1)
              ) {
                bareBraceSpecSet(bareBraceSpec + 1)
                const armOk = assignableExpr(srcExpr, srcTy, members[mi])
                bareBraceSpecSet(bareBraceSpec - 1)
                if armOk && pass == 1 {
                  if (
                    !inferQuiet
                    && bareBraceSpec == 0
                    && !objLitHasDupKey(srcExpr)
                  ) {
                    objLitUndeclaredErr(
                      srcExpr,
                      srcTy,
                      members[mi],
                      " (reached through "
                        + tyToStr(srcTy)
                        + " into "
                        + tyToStr(dstTy)
                        + ")",
                    )
                  }
                  return true
                }
                if armOk {
                  if !inferQuiet {
                    while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
                    nodeTySet(srcExpr, members[mi])
                    // Rep sidecar: the struct literal builds the concrete arm struct's rep — record
                    // it, recursing into fields, for the row resolver.
                    recordRepTyAdopt(srcExpr, members[mi], 6)
                  }
                  return true
                }
              }
              mi = mi + 1
            }
            pass = pass + 1
          }
        }
      }
    }
    // An array literal checks element-wise against the target's element type, so a bare element
    // adapts exactly as it would at a binding — the array analogue of the ObjLit recursion above.
    // This subsumes the scalar float-literal into `f32[]` rule at any element type and nesting
    // depth. An empty `[]` fits any element; a non-literal element still rejects a lossy demote.
    if e is ArrayLit {
      // A map value or niche slot is `V?` (`{[string]: f32[]}` seeds `f32[]?`) — peel the nullable
      // wrappers so a literal array still adapts into the inner element type; a nullable-value map
      // slot stacks two, so the peel iterates like the ObjLit one above.
      let dtix = dstTy
      let dPeel = true
      while dPeel {
        const dNW = T.tys[dtix]
        if dNW is TyNullable { dtix = dNW.nInner } else { dPeel = false }
      }
      const d = T.tys[dtix]
      if d is TyArray {
        let i = 0
        let ok = true
        const cexWas = cexConverted
        cexConverted = false
        while i < e.arrElems.length {
          const sp = P.nodes[e.arrElems[i]]
          if sp is Spread {
            // A spread hands over its list's elements, each delivered as one element (D3253).
            let spe = tyArrayElemIx(nodeTyIxOf(sp.spdArg))
            if spe >= 0 && tyHasHole(spe) && litPinN.length > 0 {
              spe = substTyDeep(spe, litPinN, litPinT)
            }
            if spe >= 0 && !assignable(spe, d.aElem) { ok = false }
          } else if (
            !assignableExpr(
              e.arrElems[i],
              litElemSrcTy(e.arrElems[i], srcTy),
              d.aElem,
            )
          ) {
            ok = false
          }
          i = i + 1
        }
        // A whole float constant an element became is an integer, so the list is built at the
        // destination's element type.
        const cexElem = cexConverted
        cexConverted = cexWas || cexElem
        // Context adoption (atom lists): a literal array accepted by a literal-union element target
        // is that atom list (`const ks: VK[] = ["aa", "bb"]`), so the destination array type is
        // recorded on the literal node and the emitter classifies it as the i32 atom-id list. The
        // niche-nullable scalar elements record the same way — `[null]` carries no other signal.
        if (
          ok
          && !inferQuiet
          && (tyIsLitUnion(d.aElem)
            || tyIsNicheNulScalarElem(d.aElem)
            || arrLitJoinUnionElem(srcExpr, dtix)
            || cexElem
            || f32ElemsAdoptedOver(srcExpr, d.aElem))
        ) {
          if srcExpr < nodeTyIx.length { nodeTySet(srcExpr, dtix) }
        }
        // Rep sidecar: a literal array adopted element-wise (a struct-element list widened, an
        // i64/f32 element) builds the destination element rep — recurse into the elements so each
        // element ObjLit resolves the shape the emitter builds.
        if ok { recordRepTyAdopt(srcExpr, dstTy, 6) }
        return ok
      }
      // An array literal flowing into a union adopts the first array arm it adapts into
      // element-wise (`["a"]` into `K0[] | {w: i32}`, `[1.5]` into `f32[] | i64`) — the array dual
      // of the ObjLit union-arm adoption above. The concrete arm is recorded on the literal node so
      // the emitter classifies the list with the arm's element rep, not the literal's softened one.
      if d is TyUnion {
        const members = d.uMembers
        let mi = 0
        while mi < members.length {
          const mt = T.tys[members[mi]]
          if mt is TyArray {
            // An `f32[]` arm adopts like any other list arm: the f32-list value atom
            // (kind 12) gives the box a real rep, and the emitter's coerce re-encodes
            // the literal's f64-classified elements at f32 (`coerceListKind` 7).
            bareBraceSpecSet(bareBraceSpec + 1)
            const armOk = assignableExpr(srcExpr, srcTy, members[mi])
            bareBraceSpecSet(bareBraceSpec - 1)
            if armOk {
              if !inferQuiet {
                while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
                nodeTySet(srcExpr, members[mi])
                // Rep sidecar: record the concrete array arm, recursing into elements, so the row
                // resolver keys the arm the checker picked.
                recordRepTyAdopt(srcExpr, members[mi], 6)
              }
              return true
            }
          }
          mi = mi + 1
        }
      }
    }
  }
  false
}

// ── the top-level split lives in `tyname.tyTopLevelSplit` ───────────────────
// It cannot live in `emit_base.vl`, which imports this file — a call from here would cycle the
// module graph. `tyname.vl` is the zero-import leaf that already holds `tyTopIndexOf`.

// Resolve an annotation from the parser's spelling tree where the annotation node carries one, and
// from the concatenated name where it does not. `annTsOf` answers -1 for exactly two populations,
// neither a checker-time annotation: an emitter-synthesized `TypeRef`, and a name a later pass
// rewrote without the node. Both reach `nameToTy` through the unpositioned entries.
export function annotResolve(name: string, root: i32) {
  if root >= 0 { return tsToTy(root) }
  nameToTy(name)
}

// Resolve annotation `name` with resolution diagnostics anchored at node `at`, reading the spelling
// tree banked on annotation node `ann`. The two are the same node at three of the four callers;
// they differ at a struct field, whose "unknown type" diagnostic anchors on the `FieldDef` so the
// message points at the field, while the spelling is banked on the `TypeRef` child.
function nameToTyAnn(name: string, at: i32, ann: i32) {
  // An annotation a rewrite minted is typed as the rewrite typed it.
  const minted = luAnnTy[ann] ?? -1
  if minted >= 0 { return minted }
  const saved = annotDiagAt
  annotDiagAtSet(at)
  const r = annotResolve(name, annTsOf(ann))
  annotDiagAtSet(saved)
  r
}

// The same, where the diagnostic anchor IS the annotation node.
function nameToTyAt(name: string, at: i32) { nameToTyAnn(name, at, at) }

// The type on the right of an `is` / `!is` test, and of a `match` type pattern, which
// `parseMatchPattern` mints as a real `IsExpr`. Resolved from the parser's spelling tree, banked on
// the `IsExpr` node itself. Diagnostics anchoring is deliberately not `nameToTyAt`'s: an `is` type
// has never set `annotDiagAt`, and `annotResolve`'s name leg is structurally dead here.
function isTypeTy(name: string, isIx: i32) { annotResolve(name, annTsOf(isIx)) }

// The same type, for the three readers of an `is` node that has already been checked — the two
// narrowing collectors and the if-chain exhaustiveness scan. Where the spelling is a bare name the
// bank is the answer. A composite spelling resolves instead, and for the arena's sake rather than
// the answer's: `T.tys` is not hash-consed, so the reader's index differs by construction.
function isTypeTyRead(name: string, isIx: i32) {
  const banked = isVarTyIxOf(isIx)
  if banked >= 0 {
    const root = annTsOf(isIx)
    if root >= 0 {
      if tsKind[root] == TS_NAME { return banked }
    }
  }
  isTypeTy(name, isIx)
}

// Apply a generic alias (`Box<i32>`, `Pair<i32,string>`, `Box<T>` under a live type-param env):
// resolve the arguments, check the arity, bind the declared parameter names to them, and resolve
// the declaration's fields under those bindings. Memoizes into `cUserTypes` under a resolved key,
// registered as a placeholder first so recursion terminates. -1 for an unknown base or argument.
export function applyGenAlias(head: string, inner: string) {
  applyGenAliasArgs(head, inner, -1)
}

// The body of `applyGenAlias`, with the argument list taken from either source: `appIx >= 0` is a
// `TS_APP` spelling node whose kids are the arguments, and `inner` is then unused; `appIx < 0`
// splits `inner` at its top-level commas. Everything after the argument list is one body precisely
// because the two routes must not be able to drift.
function applyGenAliasArgs(head: string, inner: string, appIx: i32) {
  const gi = gaIndexOf(head)
  // `Map<K, V>` / `Set<T>` — the builtin collections' names, reached only when no user
  // declaration claims the head (a user `type Map<A> = …` is found by `gaIndexOf` above).
  if gi < 0 {
    if (head == "Map" || head == "Set") && !cUserTypes.has(head) {
      return builtinCollAppTy(head, inner, appIx)
    }
    return builtinCtorTyLeafFail(head)
  }
  // The declared parameter names, read as a slice of the flat column — split once when the alias
  // registered (D-GAPARAM), not re-split here per application. `pcount` is the declared arity.
  const pstart = gaParamStart[gi]
  const pcount = gaParamCount[gi]
  const argTys: i32[] = []
  if appIx >= 0 {
    const astart = tsKidStart[appIx]
    const acnt = tsKidCount[appIx]
    let ti = 0
    while ti < acnt {
      const kid = tsKids[astart + ti]
      // The recovery leaf renders `""`, which `splitGenArgs` drops — so `Box<>` is an arity
      // error on both routes, not an unresolved argument.
      if tsKind[kid] != TS_ERR {
        const a = tsToTy(kid)
        if a < 0 { return -1 }
        argTys.push(a)
      }
      ti = ti + 1
    }
  } else {
    const argNames: string[] = []
    tyTopLevelSplit(inner, ',', true, argNames)
    let ai = 0
    while ai < argNames.length {
      const a = nameToTy(argNames[ai])
      if a < 0 { return -1 }
      argTys.push(a)
      ai = ai + 1
    }
  }
  if argTys.length != pcount {
    tErr(
      "`"
        + head
        + "` expects "
        + i32ToStr(pcount)
        + " type arguments but got "
        + i32ToStr(argTys.length),
      annotDiagAt,
    )
    return TY_ERR
  }
  let memoKey = head + "<#"
  let mi = 0
  while mi < argTys.length {
    memoKey = memoKey + i32ToStr(argTys[mi]) + ","
    mi = mi + 1
  }
  const cuHit = cUserTypes[memoKey]
  if cuHit is i32 { return cuHit }
  const fnames: string[] = []
  const ftys: i32[] = []
  const resIx = mkObjTy(fnames, ftys)
  cUserTypes[memoKey] = resIx
  cUserTypesVer = cUserTypesVer + 1 // new declared-name resolution registered
  // Bank the fact that this arena index is the application `head<argTys>`. Recorded on the memo
  // miss, so exactly one row exists per distinct application — the same population `cUserTypes`
  // keys, and the same index every later hit returns.
  cTyIxSetAdd(gaAppTyIxs, gaAppTyIxSet, resIx)
  gaAppHeads.push(head)
  gaAppArgStart.push(gaAppArgFlat.length)
  gaAppArgCount.push(argTys.length)
  gaAppFinite.push(-1)
  let gaf = 0
  while gaf < argTys.length {
    gaAppArgFlat.push(argTys[gaf])
    gaf = gaf + 1
  }
  let bi = 0
  while bi < pcount {
    tpEnvNames.push(gaParamNames[pstart + bi])
    tpEnvTys.push(argTys[bi])
    bi = bi + 1
  }
  const decl = P.nodes[gaDeclIxs[gi]]
  if decl is TypeDecl {
    const dfields = decl.tdFields
    let fi = 0
    while fi < dfields.length {
      const fd = P.nodes[dfields[fi]]
      if fd is FieldDef {
        fnames.push(fd.fdName)
        let fty = TY_ERR
        if fd.fdType >= 0 {
          const ftn = P.nodes[fd.fdType]
          if ftn is TypeRef {
            // The alias body's field annotation is a parsed `TypeRef` like any
            // other, so it resolves from its own spelling tree — under the `<T>`
            // bindings pushed above, which both routes read from `tpEnvNames`.
            const r = annotResolve(ftn.tyName, annTsOf(fd.fdType))
            if r >= 0 {
              fty = r
              // Record the resolved type on the field's type-annotation node so the emitter
              // classifies a field type structurally from the `Ty` arena, not a re-parsed name.
              if !inferQuiet && fd.fdType < nodeTyIx.length {
                nodeTySet(fd.fdType, r)
              }
            } else {
              unknownTyErr(
                ftn.tyName,
                " for field '" + fd.fdName + "'",
                dfields[fi],
              )
            }
          }
        }
        ftys.push(fty)
      }
      fi = fi + 1
    }
  }
  // The placeholder registered above is now filled in place (its field arrays are `fnames`/`ftys`)
  // — an existing arena entry changed shape.
  tyMutEpoch = tyMutEpoch + 1
  let pj = 0
  while pj < pcount {
    tpEnvNames.pop()
    tpEnvTys.pop()
    pj = pj + 1
  }
  resIx
}

// ── the three leaf rungs both resolvers bottom out at ────────────────────────

// `nameToTy` (the character-surgery resolver) and `tsToTy` (the structural one) differ only in how
// they take a composition apart — a union, an array suffix, an inline object. Where the spelling is
// a bare identifier there is nothing to take apart and both must answer identically, so the three
// leaf rungs live here once. Each is a nominal lookup and inspects no character of its argument.

// An INTERSECTION operand, spelling-tree route: a negation here is subtracted from the
// operand beside it and the annotation's own type is the positive remainder, which is the one
// place the ruling keeps a written `!T`. Every other position reaches `tsToTy`'s refusing arm,
// so `A & (B | !C)` — a negation stored inside a union — is refused like any other.
function tsIsectOperandTy(kid: i32) {
  if tsKind[kid] == TS_NEG {
    const inner = tsToTy(tsKids[tsKidStart[kid]])
    if inner < 0 { return -1 }
    return mkNegTy(inner)
  }
  tsToTy(kid)
}

// The name route's twin, for the same reason and with the same scope: only a `!` that IS the
// whole operand resolves, so a negation nested any deeper reaches the refusal.
function nameIsectOperandTy(part: string) {
  if part.length > 0 {
    if part[0] == '!' {
      const inner = nameToTy(part.slice(1, part.length))
      if inner < 0 { return -1 }
      return mkNegTy(inner)
    }
  }
  nameToTy(part)
}

function declaredTyOfName(name: string) {
  // A bound in value position: a design refusal, not a capability gap. `{ toString(): string }` as
  // a parameter type would be an existential needing dynamic dispatch, and everything in VL
  // monomorphizes. The sentence names the position it is legal in. A body-scope `type` needs no arm
  // here — the parser hoists it under a unique name, so pass 0a registers it like any other (D1045).
  if cBoundDecls.has(name) {
    tErr(
      "`"
        + name
        + "` is a BOUND, not a type — it declares method members, which constrain a type parameter and have no values. Use it as a constraint: `function f<T: "
        + name
        + ">(x: T)`",
      annotDiagAt,
    )
    return TY_ERR
  }
  if cUserTypes.has(name) {
    // Order-independence, at the one entry point every route to a declared type comes through
    // (`tsLeafTy` and `nameToTyReal`'s last rung both bottom out here). Pass 0a minted this entry as
    // an empty placeholder and pass 0b fills it; a name resolved in between reads the placeholder,
    // which is a different type and not merely a missing one. Inert outside pass 0b.
    forceDeclFill(name)
    const ut = cUserTypes[name] ?? -1
    let res = ut
    if ut >= 0 {
      const utt = T.tys[ut]
      if utt is TyUnion {
        // Collapse a primitive-scalar single member, and an object member reached through a plain
        // alias reference (`type MyCat = Cat`, `type Y = Box<i32>`). The one-member object case that
        // stays opaque is the canonicalized intersection, which the emitter interns as a named
        // struct. `singleAliasMemberTyIx` is the single rule both sides read.
        const sm = singleAliasMemberTyIx(ut, name)
        // A nominal newtype keeps the collapse and adds a brand on top of it — `nwBrand` is the
        // identity for every name not declared `new`. The collapse must stay: it is what the
        // emitter's `singleMemberAliasTyIx` twin does with the same annotation, and the brand is
        // invisible to it, which is precisely why the newtype costs nothing to emit.
        if sm >= 0 { res = sm }
      }
    }
    const answer = nwBrand(name, res)
    // D1048's second-hint provenance, re-banked at the reference. The declaration route recorded
    // that `type R = string | "err"` dropped an arm, and every later `: R` resolves through here.
    // It banks the index the reference actually answers, which is what makes an enclosing spelling
    // (`R[]`, `R | i32`) decline on its own. `forceDeclFill` above makes it order-independent.
    if collapsedAliases.has(name) {
      if answer >= 0 { collapsedTySet(answer) }
    }
    return answer
  }
  // A bare reference to a generic alias has no concrete type: its parameters are never supplied.

  if gaIndexOf(name) >= 0 {
    tErr(
      "Generic type `"
        + name
        + "` expects type arguments but was used without any",
      annotDiagAt,
    )
    return TY_ERR
  }
  -1
}

// The leaf a spelling node with nothing to decompose resolves to: `TS_NAME`'s identifier,
// `TS_MAP`'s key token, and `TS_ERR`'s `""`. All three are single tokens the lexer produced, so the
// composition arms `nameToTy` runs between the primitive check and the type-param check provably
// cannot fire on them — an ident lexeme holds no `[`, `{`, `<` or `|`.
function tsLeafTy(name: string) {
  if name == "u8" { return storageTyLeafFail() }
  const pv = primTyOfName(name)
  if pv >= 0 { return pv }
  const tv = tpEnvTyOfName(name)
  if tv >= 0 { return tv }
  const dv = declaredTyOfName(name)
  if dv >= 0 { return dv }
  builtinCtorTyLeafFail(name)
}

// `Map<K, V>` is the map type `{[K]: V}`, a long spelling of it. `Set<T>` is its own type, the
// set flavor (`mSet` 1) over the same rep, so both lower through the index signature
// (`builtinCollSpelling`). Arguments come from the spelling tree when `appIx` has one, else
// from `inner`'s text. An unsupported key banks the index signature's refusal.
function builtinCollAppTy(head: string, inner: string, appIx: i32) {
  const argTys: i32[] = []
  if appIx >= 0 {
    const astart = tsKidStart[appIx]
    const acnt = tsKidCount[appIx]
    let ti = 0
    while ti < acnt {
      const kid = tsKids[astart + ti]
      if tsKind[kid] != TS_ERR {
        const a = tsToTy(kid)
        if a < 0 { return -1 }
        argTys.push(a)
      }
      ti = ti + 1
    }
  } else {
    const argNames: string[] = []
    tyTopLevelSplit(inner, ',', true, argNames)
    let ai = 0
    while ai < argNames.length {
      const a = nameToTy(argNames[ai])
      if a < 0 { return -1 }
      argTys.push(a)
      ai = ai + 1
    }
  }
  let want = 2
  if head == "Set" { want = 1 }
  if argTys.length != want {
    tErr(collTyArgCountMsg(head, want, argTys.length), annotDiagAt)
    return TY_ERR
  }
  const k = argTys[0]
  if !mapKeyTySupported(k) {
    unkTyClashSet(mapKeyUnsupportedMsg(tyToStr(k), head))
    return -1
  }
  if head == "Set" { return mkMapTy(k, TY_BOOL, 1) }
  mkMapTy(k, argTys[1], 0)
}

// Raises the unknown-type sentence for `name` (with the caller's `tail`) at `at`. When a module
// of the program or std exports the unresolved name, it is the missing-import refusal instead,
// whose edit `check --fix` applies; with none it is recorded as a miss for the CLI's wider look.
function unknownTyErr(name: string, tail: string, at: i32) {
  let part = unkTyPart
  if part.length == 0 { part = name }
  if unkTyClash.length == 0 && nameIsBareIdent(part) && !isBuiltinTyName(part) {
    const from = ufcsModOfNode(at)
    const specs = mimpSpecsFor(part, from, -1)
    if !mimpAnyProgramSpec(specs) { mimpNoteMiss(part) }
    if specs.length > 0 {
      let data = diagDataField("member", part)
      for sp in specs { data = data + diagDataField("modules", sp) }
      return tErrCodedData(
        "unknown type '"
          + part
          + "'"
          + tail
          + mimpExportedByNote(part, specs, from),
        at,
        CODE_MISSING_IMPORT,
        data,
      )
    }
  }
  tErr(unknownTyTextIn(name, tail), at)
}

// A `self`-function the member-call order can never reach is refused at its declaration
// (DECISIONS.md, D2475): the receiver type already defines `name`, and that member is
// what `recv.name(…)` calls. Coded, with `member`, `recv` and `rung` (`method`/`field`) as data.
function checkSelfFnReachable(name: string, selfTy: i32, fnIx: i32) {
  const rung = memberRungOnTy(selfTy, name)
  if rung == 0 { return 0 }
  let what = "method"
  if rung == MC_RUNG_FIELD { what = "field" }
  const recv = demangleMsg(tyToStr(selfTy))
  tErrCodedData(
    "`"
      + name
      + "` is already a "
      + what
      + " of `"
      + recv
      + "`, so `"
      + selfFnRecvSpelling(selfTy)
      + "."
      + name
      + "(…)` would never call this function — rename it",
    fnIx,
    CODE_SELF_FN_SHADOWED,
    diagDataField("member", name)
      + diagDataField("recv", recv)
      + diagDataField("rung", what),
  )
  0
}

// Free `self`-functions dispatchable on `recvTy` — the in-scope half of the edit-distance
// pool, mirroring `ufcsCallTy`'s own lookup without its arity gate: a name search asks
// whether the function exists, not how many arguments it takes.
function selfFnNamesFor(recvTy: i32) {
  const out: string[] = []
  for name in fnDeclIx.keys() {
    if declFirstParamIsSelf(name) {
      const fnTy = lookup(name)
      if fnTy >= 0 {
        const ft = T.tys[fnTy]
        if ft is TyFunc {
          if ft.fnParamTypes.length > 0 {
            if assignable(recvTy, ft.fnParamTypes[0]) {
              const un = demangleName(name)
              if un.length >= 2 && nameIsBareIdent(un) { out.push(un) }
            }
          }
        }
      }
    }
  }
  out
}

// One receiver kind's two-source lookup: the newcomer map above (exact, case-folded)
// first, then an edit distance (`tyEditDist`, D1590's budget) over `names` plus every
// in-scope self-function `recvTy` could dispatch to.
function methodSuggestFrom(
  spellFrom: string[],
  spellTo: string[],
  names: string[],
  recvTy: i32,
  prop: string,
) {
  let si = 0
  while si < spellFrom.length {
    if tyFoldedEq(prop, spellFrom[si]) { return spellTo[si] }
    si = si + 1
  }
  const budget = tySuggestBudget(prop.length)
  let best = ""
  let bestD = budget + 1
  let ni = 0
  while ni < names.length {
    const nd = tyEditDist(prop, names[ni])
    if nd < bestD {
      bestD = nd
      best = names[ni]
    }
    ni = ni + 1
  }
  const cand = selfFnNamesFor(recvTy)
  let ci = 0
  while ci < cand.length {
    if cand[ci].length >= 2 && cand[ci] != prop {
      const ud = tyEditDist(prop, cand[ci])
      if ud < bestD {
        bestD = ud
        best = cand[ci]
      }
    }
    ci = ci + 1
  }
  best
}

// The name to offer for a missed method call `prop` on `recvTy`, or "" for none —
// dispatched by receiver kind (string / array / map). A kind with no table (struct,
// union, an unresolved generic) still gets the edit distance over its self-functions.
function methodSuggestFor(recvTy: i32, prop: string) {
  if recvTy < 0 { return "" }
  if prop.length < 2 { return "" }
  if !nameIsBareIdent(prop) { return "" }
  const rt = T.tys[recvTy]
  if rt is TyPrim {
    if rt.primName == "string" {
      return methodSuggestFrom(
        strMethodSpellFrom,
        strMethodSpellTo,
        strMethodNames,
        recvTy,
        prop,
      )
    }
  }
  if rt is TyArray {
    return methodSuggestFrom(
      listMethodSpellFrom,
      listMethodSpellTo,
      listMethodNames,
      recvTy,
      prop,
    )
  }
  if rt is TyMap {
    // `put`/`containsKey` name the MAP surface — offering them on a set would suggest a
    // call `checkCallNode`'s own arm refuses, so a set gets the edit distance alone.
    if rt.mSet == 1 {
      return methodSuggestFrom([], [], mapMethodNames(recvTy), recvTy, prop)
    }
    return methodSuggestFrom(
      mapMethodSpellFrom,
      mapMethodSpellTo,
      mapMethodNames(recvTy),
      recvTy,
      prop,
    )
  }
  methodSuggestFrom([], [], [], recvTy, prop)
}

// The `; did you mean '.<name>'?` clause for a missed method call, or "" when nothing is
// near enough — the method twin of `tyDidYouMean`, a SUFFIX so `no method '.<prop>' on
// <type>` stays the prefix every consumer matches on (glean VL-045, D1599).
function methodDidYouMean(recvTy: i32, prop: string) {
  const s = methodSuggestFor(recvTy, prop)
  if s.length == 0 { return "" }
  "; did you mean '." + s + "'?"
}

// The spelling-tree resolver, wrapped: bank this subtree's spelling if it is the
// innermost frame that failed. `tsToName` re-renders the parser's tree, so the quoted
// part matches the whole name's canonical spacing.
function tsToTy(ix: i32) {
  unkTyDepthSet(unkTyDepth + 1)
  if unkTyDepth == 1 {
    unkTyPartSet("")
    unkTyClashSet("")
    collapsedTySet(-1)
  }
  const r = tsToTyReal(ix)
  if r < 0 {
    if unkTyPart.length == 0 { unkTyPartSet(tsToName(ix)) }
  }
  unkTyDepthSet(unkTyDepth - 1)
  r
}

// The name resolver, wrapped the same way — unpositioned entries and the emitter's
// re-resolutions come through here.
export function nameToTy(name: string) {
  unkTyDepthSet(unkTyDepth + 1)
  if unkTyDepth == 1 {
    unkTyPartSet("")
    unkTyClashSet("")
    collapsedTySet(-1)
  }
  // A bare identifier cannot enter any composite arm of `nameToTyReal`, so its answer is
  // the shared leaf ladder: `tsLeafTy`, already the tree route's leaf, rather than a
  // second copy of the prim/type-parameter/declared lookup. Arena-neutral by construction
  // — all three leaf rungs are lookups of an index someone else already minted.
  let r = -1
  if nameIsBareIdent(name) {
    r = tsLeafTy(name)
  } else {
    r = nameToTyReal(name)
  }
  if r < 0 {
    if unkTyPart.length == 0 { unkTyPartSet(name) }
  }
  unkTyDepthSet(unkTyDepth - 1)
  r
}

// —— literal-union flatten, shared by the annotation and declaration routes ——
// "A union whose members are all literal unions is one" (`litunion-compact-rep-design.md`
// §8.3), stated once because the annotation (`annUnionInnerTy`) and declaration
// (`fillTypeDeclAt`'s `UnionDecl` arm) routes build a union's member list separately.

// Push `ty` onto `out` unless a member already there is the same variant — the dedup both
// the flatten and non-flatten legs need, so an overlapping pair keeps a shared member
// exactly once.
function pushDistinctVariantTy(out: i32[], ty: i32) {
  let i = 0
  while i < out.length {
    if sameVariantTy(ty, out[i]) && !annArmsPart(ty, out[i]) { return 0 }
    i = i + 1
  }
  out.push(ty)
  0
}

// Flattens `members` into `out` and answers true only when every member is a literal or a
// homogeneous literal union over one common base; otherwise leaves `out` untouched and
// answers false. A bare literal of the common base is a member of that set, not a reason to
// decline (D1043) — this is not the subsumption collapse, it adds a value rather than dropping one.
function litUnionFlatMembers(members: i32[], out: i32[]): boolean {
  if members.length < 2 { return false }
  let base = -1
  let sawUnion = false
  let i = 0
  while i < members.length {
    let b = homogLitUnionBase(members[i])
    if b >= 0 { sawUnion = true } else { b = armLiteralBaseTy(members[i]) }
    if b < 0 { return false }
    if base < 0 { base = b }
    if base != b { return false }
    i = i + 1
  }
  if !sawUnion { return false }
  i = 0
  while i < members.length {
    const mt = T.tys[members[i]]
    if mt is TyUnion {
      let ml = 0
      while ml < mt.uMembers.length {
        pushDistinctVariantTy(out, mt.uMembers[ml])
        ml = ml + 1
      }
    } else {
      pushDistinctVariantTy(out, members[i])
    }
    i = i + 1
  }
  true
}

// The declared records an inferred-return union's anonymous members are spelled as: the
// recorded name maps each `{…}` member to the declared type of the same shape
// (`nominalNameOfObj`), and the emitter makes that name's members arms. Without this the
// arena reads the declared record as a plain struct while the name registry reads an arm (D3593).
function inferRegisterNominalTwins(ty: i32) {
  const u = nonNulTyOf(ty)
  if u < 0 { return 0 }
  const t = T.tys[u]
  if t is TyUnion {
    if t.uMembers.length < 2 { return 0 }
    let i = 0
    while i < t.uMembers.length {
      const m = t.uMembers[i]
      if m >= 0 && T.tys[m] is TyObj {
        const nm = nominalNameOfObj(m, gRootStmts)
        if nm != "" {
          const di = cUserTypes[nm] ?? (-1)
          // Committed here, not left pending: the named-function recorder runs after
          // `annCommitVariantMembers`, and a declared record needs no forward resolution.
          if di >= 0 && di != m && cTyIxSetHas(cStructTyIxSet, di) {
            if !cTyIxSetHas(cVariantMemberTyIxSet, di) {
              cTyIxSetAdd(cVariantMemberTyIxs, cVariantMemberTyIxSet, di)
            }
          }
        }
      }
      i = i + 1
    }
  }
  0
}

// The annotation routes' member dedup, and the one place that records what a dropped
// duplicate collapsed with: `type A = {v: i32}` and `type B = {v: i32}` mint distinct arena
// nodes that `sameVariantTy` calls one variant, so `A | B` keeps one member but both names
// must register here — `sameVariantTy` is mutual, so a match can hold across either index.
function annUnionPushDistinctMember(members: i32[], m: i32) {
  let dup = false
  let dj = 0
  while dj < members.length {
    const kept = members[dj]
    if sameVariantTy(m, kept) && !annArmsPart(m, kept) {
      dup = true
      if m != kept { annRegisterVariantMembers([m, kept]) }
    }
    dj = dj + 1
  }
  if !dup { members.push(m) }
  0
}

// —— the annotation union's member list, shared by both annotation routes ——
// `tsToTyReal` (the tree route) and `nameToTyReal` (the string route) build the same union
// from the same members, through one shared home per rule rather than a copy per route.

// The union type an annotation's kept `members` denote, with the literal-union flatten: a
// union of literal unions is a literal union, so without flattening `is K` const-folds to a
// guard that can never fire (`litunion-compact-rep-design.md` §8.3). Shares
// `litUnionFlatMembers` with the declaration route; a one-member list returns unchanged.
function annUnionInnerTy(members: i32[], hasNull: boolean): i32 {
  if members.length == 0 { return TY_ERR }
  if members.length == 1 { return members[0] }
  // Two members the emitter cannot separate poison the annotation (-1), reason banked —
  // ahead of the `null` early-out, since `N | i32 | null` is the same union.
  const nwClash = nomUnionRepClashMsg(members)
  if nwClash.length > 0 {
    unkTyClashSet(nwClash)
    return -1
  }
  // The subsumed-arm collapse, ahead of the `null` wrap — `string | "err" | null` is
  // `string?` for the same reason `string | "err"` is `string`, else the duplicate atom
  // would carry into the niche. Re-enters on the survivors so a one-member result collapses exactly once.
  const kept: i32[] = []
  if unionDropSubsumedArms(members, kept) {
    const collapsed = annUnionInnerTy(kept, hasNull)
    // Banks the provenance, since the result itself carries no trace of a dropped arm.
    // Written after the recursion, so a double collapse banks the final index (D1048).
    if collapsed >= 0 { collapsedTySet(collapsed) }
    return collapsed
  }
  // An inline string-literal union under `| null` is the same hidden alias as without it, so
  // `"a" | "b" | null` and `K | null` name one inner type (D3198).
  if hasNull && !allStrLitArms(members) {
    annRegisterVariantMembers(members)
    return mkUnionTy(members)
  }
  // Every member must be a literal union — a litunion member of a mixed union keeps its own
  // arena node, since that mixed shape is load-bearing elsewhere
  // (`closure-result-union-composed-carrier.vl` miscompiles if flattened). Shares
  // `litUnionFlatMembers` with the declaration route's `UnionDecl` arm.
  const flat: i32[] = []
  if !litUnionFlatMembers(members, flat) {
    let i = 0
    while i < members.length {
      pushDistinctVariantTy(flat, members[i])
      i = i + 1
    }
  }
  if flat.length == 1 { return flat[0] }
  annRegisterVariantMembers(flat)
  // A declared alias with exactly these literal members owns the arena index
  // (`litUnionAliasTyOfMembers`) — minting a twin instead is invisible to the index-identity
  // classifiers. Asked of the non-flattened list too: a pure inline `"aa"|"bb"` beside `type
  // K = "aa"|"bb"` must resolve to the same index canon spells `K`, or the two producers disagree.
  const lal = litUnionAliasTyOfMembers(flat)
  if lal >= 0 { return lal }
  const fresh = mkUnionTy(flat)
  if tyIsLitUnion(fresh) { registerInlineLitUnion(fresh) }
  fresh
}

// The whole union type an `A | B | null` spelling denotes: `annUnionInnerTy` over the
// non-`null` members, wrapped in the null niche when `null` is present (a poisoned -1
// propagates unwrapped, since `mkNullableTy(-1)` would lose the sentinel). A declared union
// alias with a `null` member must resolve to this same niche rep, not a plain `TyUnion`.
function annUnionTy(members: i32[], hasNull: boolean): i32 {
  // A declaration's own members have no annotation position; pass 0d reports those.
  const clash = setMapUnionClashMsg(members, false)
  if clash != "" && annotDiagAt >= 0 {
    tErr(clash, annotDiagAt)
    return TY_ERR
  }
  // A member that is itself `null` (`null | null`, `N | null` over `type N = null`) is the
  // niche, not an inner type; with no other member the union is the `null` type (D4673).
  const nonNull: i32[] = []
  let anyNull = hasNull
  for m in members {
    if isNullTy(m) { anyNull = true } else { nonNull.push(m) }
  }
  if nonNull.length == 0 && anyNull { return TY_NULL }
  if nonNull.length < members.length { return annUnionTy(nonNull, anyNull) }
  const inner = annUnionInnerTy(members, hasNull)
  if inner < 0 { return -1 }
  // arena-tick exempt: a per-program mark on an annotation's row.
  annUnionTys[inner] = true
  if hasNull {
    const wrapped = mkNullableTy(inner)
    // Carries the collapse bank through the niche wrap: `string | "err" | null` is
    // `string?`, and without this the bank would still name the unwrapped `string`.
    if collapsedTy == inner { collapsedTySet(wrapped) }
    return wrapped
  }
  inner
}

function tsToTyReal(ix: i32) {
  if ix < 0 { return -1 }
  const k = tsKind[ix]
  const start = tsKidStart[ix]
  const cnt = tsKidCount[ix]
  // An inline union `A | B | null`: a `null` member makes the result nullable, duplicate
  // members collapse, and an unresolved member poisons the whole union (-1) rather than
  // let `assignable` treat the negative sentinel as "accept anything".
  if k == TS_UNION {
    const members: i32[] = []
    let hasNull = false
    let pi = 0
    while pi < cnt {
      const kid = tsKids[start + pi]
      const kk = tsKind[kid]
      if kk == TS_NULL {
        hasNull = true
      } else if kk != TS_ERR {
        // renders "" for the string arm's `part.length > 0` check
        const m = tsToTy(kid)
        if m < 0 { return -1 }
        annUnionPushDistinctMember(members, m)
      }
      pi = pi + 1
    }
    return annUnionTy(members, hasNull)
  }
  // An intersection `A & B` — fold the operands through `intersectTy` so a finite
  // annotation simplifies to a concrete type (`(0|1|2) & !2` → `0 | 1`).
  if k == TS_ISECT {
    let acc = -1
    let ii = 0
    while ii < cnt {
      const operand = tsIsectOperandTy(tsKids[start + ii])
      if operand < 0 { return -1 }
      if ii == 0 { acc = operand } else { acc = intersectTy(acc, operand) }
      ii = ii + 1
    }
    return acc
  }
  // A prefix negation `!A` written in an annotation — refused at both routes, since a rule
  // enforced on one is one a re-render can walk around. `TyErr`, not -1: the diagnosis
  // already stands and -1 would make the caller append a misleading `unknown type`.
  if k == TS_NEG {
    tErr(negInAnnotationMsg("!" + tsToName(tsKids[start])), annotDiagAt)
    return TY_ERR
  }
  // A parenthesized group `(A)`: strip the parens and re-enter, so a comma group
  // `(A, B)` re-enters on `"A,B"`, matches no arm, and resolves to -1 — a group is a
  // single type or it is nothing.
  if k == TS_PAREN {
    if cnt == 1 { return tsToTy(tsKids[start]) }
    return -1
  }
  // A function type `(params)=>ret` — the children are the parameters in order, then
  // the return last (`parseTypeAtom`'s contract).
  if k == TS_FUNC {
    const ptys: i32[] = []
    let pn = cnt - 1
    // A lone recovery param renders `""`, so the string arm sees `paramsStr` empty and
    // builds a zero-parameter function; two of them render `","` and do not collapse.
    if pn == 1 {
      if tsKind[tsKids[start]] == TS_ERR { pn = 0 }
    }
    let pk = 0
    while pk < pn {
      const pt = tsToTy(tsKids[start + pk])
      if pt < 0 { return -1 }
      ptys.push(pt)
      pk = pk + 1
    }
    const rty = tsToTy(tsKids[start + cnt - 1])
    if rty < 0 { return -1 }
    return mkFuncTy(ptys, rty)
  }
  // A string-literal type `"a"`: `tsText` keeps the quoted lexeme, so `tsToName`
  // reproduces the annotation exactly, and the member is the raw inner text — the same
  // rule as the literal-expression side. `ast.tsToName` returns `tsText[ix]` verbatim for
  // a `TS_LITSTR` node, matching the string the parser also concatenates into `TypeRef.tyName`.
  if k == TS_LITSTR {
    const lex = tsText[ix]
    return mkLitTy("str", groupInnerOf(lex))
  }
  // An integer-literal type (`0`). A float literal in a type is refused (`floatLitTypeFail`).
  if k == TS_LITNUM {
    if numLexIsFloat(tsText[ix]) { return floatLitTypeFail(tsText[ix]) }
    return mkLitTy("int", tsText[ix])
  }
  if k == TS_NULL { return TY_NULL }
  // An array type `T[]`. An unresolved element poisons the annotation: `mkArrayTy(-1)`
  // would leak the empty-`[]` element hole as the type of every `xs[i]` read, and a member
  // access on that hole indexes the arena at -1 — a checker crash (`type-alias-nested.vl`).
  if k == TS_ARR {
    // A `readonly` marker on this suffix mints the view over the same element — the tree
    // route's twin of `nameToTyReal`'s marker arm.
    const ro = tsText[ix] == "readonly"
    // `u8[]` — the one position `u8` is legal in. Matched on the element spelling rather
    // than by resolving it, since `u8` deliberately never resolves as a leaf (`TY_U8`) —
    // this keeps the storage type out of every value position with no context flag threaded through.
    const aeKid = tsKids[start]
    if tsKind[aeKid] == TS_NAME && tsText[aeKid] == "u8" {
      if ro { return mkArrayViewTy(TY_U8) }
      return mkArrayTy(TY_U8)
    }
    const aeTy = tsToTy(aeKid)
    if aeTy < 0 { return -1 }
    if ro { return mkArrayViewTy(aeTy) }
    return mkArrayTy(aeTy)
  }
  // A map `{[K]: V}` — the key is a bare identifier token, not a parsed type, so it rides
  // `tsText`; only `string`/`i32` keys are supported (`mapKeyTySupported`), any other
  // resolves to -1. An unresolved value also poisons the annotation: `mkMapTy(str, -1)`
  // would be indistinguishable from the empty-`Map()` inference hole.
  if k == TS_MAP {
    const mk = tsLeafTy(tsText[ix])
    if !mapKeyTySupported(mk) { return -1 }
    const mvTy = tsToTy(tsKids[start])
    if mvTy < 0 { return -1 }
    return mkMapTy(mk, mvTy, 0)
  }
  // An inline object type `{x: T, y: U}`. A field whose name failed to parse renders
  // `":T"` and drops here too, since its first top-level colon sits at index 0
  // (`colonAt > 0`). An unresolved field type also poisons the annotation (-1) — storing
  // it in `objFieldTypes` would crash a consumer that assumes resolution succeeded.
  if k == TS_OBJ {
    const fnames: string[] = []
    const ftys: i32[] = []
    let fi = 0
    while fi < cnt {
      const fdIx = tsKids[start + fi]
      // A method member in value position — the tree route's half of the refusal
      // `nameToTyReal`'s brace arm raises, so both routes reach one wording. A design
      // rule enforced on only one route is one a re-render can walk around.
      if tsKind[fdIx] == TS_METHOD {
        tErr(methodInValuePosMsg(tsToName(fdIx)), annotDiagAt)
        return TY_ERR
      }
      if tsKind[fdIx] == TS_FIELD {
        if tsText[fdIx].length > 0 {
          const fdTy = tsToTy(tsKids[tsKidStart[fdIx]])
          if fdTy < 0 { return -1 }
          fnames.push(tsText[fdIx])
          ftys.push(fdTy)
        }
      }
      fi = fi + 1
    }
    return mkObjTy(fnames, ftys)
  }
  // A generic alias application `Box<i32>` / `Pair<i32,string>` — substitute the
  // arguments into the declared body. The head is the identifier the parser read,
  // never a slice of a rendered name.
  if k == TS_APP { return applyGenAliasArgs(tsText[ix], "", ix) }
  // `TS_NAME` (a bare identifier), and `TS_ERR`, whose `""` text falls through
  // every leaf rung to -1 exactly as `nameToTy("")` does.
  tsLeafTy(tsText[ix])
}

function nameToTyReal(name: string) {
  // An inline union `A | B | null` — the parser joins members with `|` into one synthetic
  // name. Split on top-level `|`s (depth-aware), resolve each member, and build the union
  // (a `null` member makes it nullable). Checked first so a member's `[]`/map shape isn't
  // read as a suffix of the whole union name; duplicate members collapse.
  if nameHasPipe(name) && !isTopLevelFuncTypeName(name) {
    const parts: string[] = []
    tyTopLevelSplit(name, '|', false, parts)
    const members: i32[] = []
    let hasNull = false
    let pi = 0
    while pi < parts.length {
      const part = parts[pi]
      if part == "null" {
        hasNull = true
      } else if part.length > 0 {
        // An unresolved member poisons the whole union (-1): pushing it into the member
        // list would let `assignable` treat the negative sentinel as "accept anything".
        const m = nameToTy(part)
        if m < 0 { return -1 }
        annUnionPushDistinctMember(members, m)
      }
      pi = pi + 1
    }
    // The litunion flatten and the `null` niche wrap at their shared home — the tree
    // route's mirror of `tsToTyReal`'s `TS_UNION` arm. Three routes, one rule.
    return annUnionTy(members, hasNull)
  }
  // An intersection `A & B` — fold the operands through `intersectTy` so a finite
  // annotation simplifies to a concrete type (`(0|1|2) & !2` → `0 | 1`). An unresolvable
  // operand poisons the whole name (-1).
  if nameHasSep(name, '&') && !isTopLevelFuncTypeName(name) {
    const iparts: string[] = []
    tyTopLevelSplit(name, '&', false, iparts)
    let acc = -1
    let ii = 0
    while ii < iparts.length {
      const operand = nameIsectOperandTy(iparts[ii])
      if operand < 0 { return -1 }
      if ii == 0 { acc = operand } else { acc = intersectTy(acc, operand) }
      ii = ii + 1
    }
    return acc
  }
  if name.length > 0 {
    // A prefix negation `!A` written in an annotation — the name route's half of the
    // refusal the spelling tree raises, so both reach one wording.
    if name[0] == '!' {
      tErr(negInAnnotationMsg(name), annotDiagAt)
      return TY_ERR
    }
    // A float literal written as a type — the name route's half of the spelling tree's refusal.
    if name[0] >= '0' && name[0] <= '9' {
      if numLexIsFloat(name) { return floatLitTypeFail(name) }
    }
    // A parenthesized group `(A | B)`: peel only when `tyname.parenEnclosesWhole` says the
    // leading `(` closes at the final character — not `emit_base.tyGroupWrapsWhole`, which
    // disagrees on a group that never closes (returns true where this needs false, since
    // `groupInnerOf` would otherwise take a real closer for one that doesn't exist).
    if nameIsParenSpanEnds(name) {
      if parenEnclosesWhole(name) { return nameToTy(groupInnerOf(name)) }
    }
    // A function type `(params)=>ret` (the parser's synthetic name for `(i32) => i32`):
    // builds a `TyFunc` so a function-typed binding/param/field type-checks. Matches
    // `isTopLevelFuncTypeName`; `funcArrowAt` banks the arrow index and must be read
    // immediately, since the recursion below (`nameToTy`) reaches the predicate again and overwrites it.
    if isTopLevelFuncTypeName(name) {
      const arrowAt = funcArrowAt
      const paramsStr = fnParamsTextOf(name, arrowAt)
      const retStr = fnRetTextOf(name, arrowAt)
      const ptys: i32[] = []
      if paramsStr.length > 0 {
        const pparts: string[] = []
        tyTopLevelSplit(paramsStr, ',', false, pparts)
        let pk = 0
        while pk < pparts.length {
          const pt = nameToTy(pparts[pk])
          if pt < 0 { return -1 }
          ptys.push(pt)
          pk = pk + 1
        }
      }
      const rty = nameToTy(retStr)
      if rty < 0 { return -1 }
      return mkFuncTy(ptys, rty)
    }
    // A string- or numeric-literal type (`"a"`, `0`, `1.5`), at the lexeme grammar's
    // home — shared with `canonEmitName`'s literal arm.
    const lmt = litMemberTy(name)
    if lmt >= 0 { return lmt }
  }
  if name == "u8" { return storageTyLeafFail() }
  const pv = primTyOfName(name)
  if pv >= 0 { return pv }
  // `readonly T[]` — the view's marker prefixes the whole list spelling, so it is stripped
  // here and the list under it resolves through the array arm below. A marker over anything
  // but a list resolves to nothing: there is no read-only view of a scalar or a map.
  if nameIsReadOnlyList(name) {
    const listIx = nameToTy(roListInnerName(name))
    if listIx < 0 { return -1 }
    const lt = T.tys[listIx]
    if lt is TyArray { return mkArrayViewTy(lt.aElem) }
    return -1
  }
  // An array type `T[]`: the parser appends a literal `[]` per array suffix to the type
  // name (`i32[]`, `Tok[]`, `i32[][]`). Strip one suffix and wrap the element.
  const nlen = name.length
  // The array-name grammar's test then its cut, both at their home in `tyname.vl`. Not
  // `arrElemNameRaw(name) != ""`: the degenerate `"[]"` is an array whose element is "",
  // and this arm must still enter for it — the one-call form would skip it.
  if nameIsArray(name) {
    // `u8[]` through the rendered-name path, the twin of `tsToTyReal`'s `TS_ARR` arm — the
    // same element-spelling door, so an answer only one route knows never diverges.
    const aeName = arrElemNameRaw(name)
    if aeName == "u8" { return mkArrayTy(TY_U8) }
    // An unresolved element name poisons the whole array annotation (-1): `mkArrayTy(-1)`
    // would leak the empty-`[]` element hole, and a member access on it crashes the checker.
    const aeTy = nameToTy(aeName)
    if aeTy < 0 { return -1 }
    return mkArrayTy(aeTy)
  }
  // A map `{[K]:V}` (the parser's synthetic index-signature name) — span and cuts live in
  // `tyname.vl`. Supported keys are `string`/`i32` (`mapKeyTySupported`); any other key, or
  // an unresolved value, resolves to -1 rather than building `mkMapTy(str, -1)`, which would
  // be indistinguishable from the empty-`Map()` inference hole.
  if nameIsMapSpanEnds(name) && mapSpellKeyEnd(name) >= 0 {
    const mk = nameToTy(mapSpellKeyName(name))
    if !mapKeyTySupported(mk) { return -1 }
    const mv = nameToTy(mapSpellValName(name))
    if mv < 0 { return -1 }
    return mkMapTy(mk, mv, 0)
  }
  // An inline object type `{x:T,y:U}` (starts `{` but not `{[`). Split top-level commas
  // (depth-aware), then each field at its first top-level `:`, and build the structural
  // `TyObj`. An unresolved field type poisons the whole annotation (-1) — the sentinel stored
  // in `objFieldTypes` would crash a consumer that assumes resolution succeeded.
  if nameIsBraceSpanEnds(name) {
    const fnames: string[] = []
    const ftys: i32[] = []
    // Fields are the top-level commas of the brace's interior, scanned from index 1 so
    // the opening `{` doesn't count; the run ends at the closing brace, not the name's end.
    let fstart = 1
    let fgoing = true
    while fgoing {
      let fend = tyTopIndexOf(name, ',', 0, fstart)
      if fend < 0 {
        fend = nlen - 1
        fgoing = false
      }
      const field = name.slice(fstart, fend)
      if field.length > 0 {
        const colonAt = tyTopIndexOf(field, ':', 0, 0)
        // A method member in value position (`function f(x: { m(): string })`). The
        // refusal belongs here, not the grammar, since the grammar cannot see which
        // position it is in — the same rule `declaredTyOfName`'s alias arm applies.
        if colonAt > 1 {
          if field[colonAt - 1] == ')' {
            tErr(methodInValuePosMsg(field), annotDiagAt)
            // `TyErr`, not -1: this diagnosis already stands, and -1 would make the caller
            // append a misleading `unknown type` — the type is known, just not a value type.
            return TY_ERR
          }
        }
        if colonAt > 0 {
          // Field-colon cut at its home (`tyname.fieldTypeTextOf`/`fieldNameOf`), given the
          // top-level colon already found; the emitter's own copies use a depth-blind `indexOf(":")`.
          const fdTy = nameToTy(fieldTypeTextOf(field, colonAt))
          if fdTy < 0 { return -1 }
          fnames.push(fieldNameOf(field, colonAt))
          ftys.push(fdTy)
        }
      }
      fstart = fend + 1
    }
    return mkObjTy(fnames, ftys)
  }
  // A live type-parameter binding (a generic function's `<T>` while its annotations
  // resolve via `resolveAnnot`, or a generic alias application's params while its body
  // resolves via `applyGenAlias`) — innermost wins.
  const tv = tpEnvTyOfName(name)
  if tv >= 0 { return tv }
  // A generic alias application `Box<i32>` / `Pair<i32,string>` — the parser folds the
  // arguments into the synthetic name; substitute them into the declared body. Span test at
  // its home in `tyname.vl` (`annGenAppSpanEnds`); a name failing it falls through to
  // `declaredTyOfName`. Slices are `tyname.gaeHeadNameOf`/`gaeArgsTextOf`, given `gaeLtAt`'s index.
  if annGenAppSpanEnds(name) {
    const ltAt = gaeLtAt(name)
    return applyGenAlias(gaeHeadNameOf(name, ltAt), gaeArgsTextOf(name, ltAt))
  }
  const dvn = declaredTyOfName(name)
  if dvn >= 0 { return dvn }
  builtinCtorTyLeafFail(name)
}

// The one wording for a key the map rep cannot hash (`mapKeyTySupported` has exactly three
// hashes). Both the annotation gate (`checkLetDeclNode`) and the usage-driven pin
// (`checkInferredMapKey`) raise it, so the annotated and inferred spellings of one
// program reject in the same channel with the same words.
function mapKeyUnsupportedErr(keyText: string, ctor: string, at: i32) {
  tErrUnsupported(mapKeyUnsupportedMsg(keyText, ctor), at)
}

// Adjudicates the key a usage-driven pin (`m.set(k, v)`, `s.add(k)`, `m[k] = v`) just
// wrote into an open `mKey` hole — a bare `Map()` has no annotation for the checker's
// static gate to read, so without this an inferred unsupported key checks clean and dies
// in codegen instead. A hole key is still unsolved and left to call-site re-validation.
function checkInferredMapKey(k: i32, isSet: i32, at: i32) {
  if k < 0 { return 0 }
  if mapKeyTySupported(k) { return 0 }
  const kt = T.tys[k]
  if kt is TyVar { return 0 }
  if kt is TyErr { return 0 }
  let ctor = "Map"
  if isSet == 1 { ctor = "Set" }
  mapKeyUnsupportedErr(tyToStr(k), ctor, at)
  0
}

// ── emit-name canonicalization ──
// The emitter classifies annotations by synthetic name, and the literal/intersection
// algebra above is checker-only — a same-base literal union is its base scalar at runtime.
// `canonEmitTypeNames` rewrites every annotation name into that vocabulary at the end of `checkProgram`.

// ── flat record layouts ──
// The whole feature is these functions plus one interception at the top of
// `checkMemberNode`. Nothing in `emit_*.vl` changes: layout constants are folded into
// `NumLit` nodes in the arena before the emitter runs (`flat-records-design.md`).

// How a value of record arm `y` fits record arm `x` when both carry the same field names: 0
// when some field's types share no value, 1 when every field of `y` is assignable to `x`'s,
// 2 when a field overlaps without containment, so only the stored value can answer (D4056).
export function recArmFitKind(x: i32, y: i32): i32 {
  if x < 0 || y < 0 { return 0 }
  const tx = T.tys[x]
  const ty = T.tys[y]
  if !(tx is TyObj) || !(ty is TyObj) { return 0 }
  if !objSigSame(tx, ty) || !objSigSame(ty, tx) { return 0 }
  let all = true
  let i = 0
  while i < ty.objFieldNames.length {
    const fy = ty.objFieldTypes[i]
    const k = tyFitKind(fy, objFieldType(tx, ty.objFieldNames[i]))
    if k == 0 { return 0 }
    if k == 2 { all = false }
    i = i + 1
  }
  if all { 1 } else { 2 }
}

// Whether record arm `x` holds every value of arm `y` but not the reverse: field by field for
// arms of one field-name set, where a narrower number is not contained in a wider one, else by
// assignability.
function recArmContains(x: i32, y: i32): boolean {
  const tx = T.tys[x]
  const ty = T.tys[y]
  if tx is TyObj && ty is TyObj && objSigSame(tx, ty) && objSigSame(ty, tx) {
    return recArmFitKind(x, y) == 1 && recArmFitKind(y, x) != 1
  }
  assignable(y, x) && !assignable(x, y)
}

// How a value of type `src` fits `dst`: 1 always (assignable), 0 never (no shared value), 2
// only for some values, so a test has to read the value.
export function tyFitKind(src: i32, dst: i32): i32 {
  if numericRepsApart(src, dst) { return 0 }
  if assignable(src, dst) { return 1 }
  if tysShareValue(src, dst) { 2 } else { 0 }
}

// Can one value inhabit both `a` and `b`? Member-wise: a pair where either side is assignable to
// the other, or two same-shape records whose arms fit (`recArmFitKind`).
function tysShareValue(a: i32, b: i32): boolean {
  if a < 0 || b < 0 { return false }
  const ams: i32[] = []
  const bms: i32[] = []
  flattenVariantsInto(a, ams)
  flattenVariantsInto(b, bms)
  for ma in ams {
    for mb in bms {
      if ma >= 0 && mb >= 0 && !numericRepsApart(ma, mb) {
        if assignable(ma, mb) || assignable(mb, ma) { return true }
        if recArmFitKind(ma, mb) != 0 { return true }
      }
    }
  }
  false
}

// Does some arm of `cur` other than `chk` sit under its own tag and still hold values that fit
// `chk`? Then `is chk` answers from the value, and the then arm keeps `cur`, since a value that
// passed may be laid out as either arm (D4056).
export function recIsFitsAcrossTags(cur: i32, chk: i32): boolean {
  if cur < 0 || chk < 0 { return false }
  if !(T.tys[chk] is TyObj) { return false }
  const ms: i32[] = []
  flattenVariantsInto(cur, ms)
  let records = 0
  for m in ms {
    if m >= 0 && T.tys[m] is TyObj { records = records + 1 }
  }
  // A lone record, nullable or not, sits under no box tag.
  if records < 2 { return false }
  for m in ms {
    if m >= 0 && m != chk && !tySame(m, chk) {
      if recArmsTagApart(chk, m) && recArmFitKind(chk, m) != 0 { return true }
    }
  }
  false
}

// Reports `msg` unless already reported, at any anchor — `tErrPush`'s own dedupe keys on
// `(message, anchor)`, too weak here since one bad union is reachable from its declaration
// and every annotation naming it. The message alone is the key; the first writer wins.
function tErrOncePerMsg(msg: string, at: i32) {
  let di = 0
  while di < T.diags.length {
    if T.diags[di].tmsg == msg { return 0 }
    di = di + 1
  }
  tErr(msg, at)
}

function checkUnionSetMapClash(stmts: i32[]) {
  let si = 0
  while si < stmts.length {
    const sd = P.nodes[stmts[si]]
    if sd is UnionDecl {
      const declIx = cUserTypes[sd.udName] ?? -1
      if declIx >= 0 {
        const flat: i32[] = []
        flattenVariantsInto(declIx, flat)
        const sm = setMapUnionClashMsg(flat, false)
        if sm != "" { tErrOncePerMsg(sm, stmts[si]) }
      }
    }
    si = si + 1
  }
  0
}
// Measures every `flat type` in the program, after the declaration passes have filled each
// record's field types. Two phases, kept separate so an invalid declaration is never also
// reported as a recursive one: (A) validate and stage each declaration's fields, deferring a
// nested flat record; (B) a fixpoint, reporting anything still unresolved as a cycle by name.

function resolveFlatLayouts(stmts: i32[]) {
  // ── phase A: validate and stage ──
  // Two sweeps, since a flat record may nest one declared later in the source: register
  // every flat name first, then validate fields against the full set.
  let ri = 0
  while ri < stmts.length {
    const sd = P.nodes[stmts[ri]]
    if sd is TypeDecl {
      if sd.tdFlat == 1 {
        // A generic flat type has no layout: a type parameter has no width, and there is no
        // instantiation to measure at a declaration. Rejected here rather than staged, so it
        // never enters the sidecar and `Box<T>.size` stays an undeclared-identifier error.
        if declGpBaseOf(stmts[ri]) != "" {
          tErr(
            "a `flat` type cannot be generic — `"
              + sd.tdName
              + "` has type parameters, which have no byte width",
            stmts[ri],
          )
        } else if flatIndexOf(sd.tdName) < 0 {
          flNames.push(sd.tdName)
          flSizes.push(FL_UNRESOLVED)
          flFStart.push(0)
          flFCount.push(0)
          flDeclNodes.push(stmts[ri])
        }
      }
    }
    ri = ri + 1
  }
  let si = 0
  while si < stmts.length {
    const sd2 = P.nodes[stmts[si]]
    if sd2 is TypeDecl {
      if sd2.tdFlat == 1 {
        const d = flatIndexOf(sd2.tdName)
        if d >= 0 && flFCount[d] == 0 { flatStageDecl(d, sd2) }
      }
    }
    si = si + 1
  }
  // ── phase B: size the nest, by fixpoint ──
  let progress = true
  while progress {
    progress = false
    let d2 = 0
    while d2 < flNames.length {
      if flSizes[d2] == FL_UNRESOLVED {
        if flatTrySize(d2) { progress = true }
      }
      d2 = d2 + 1
    }
  }
  // Whatever is still unresolved cannot be sized at any depth: every remaining
  // declaration is waiting on another remaining declaration, which is a cycle.
  let d3 = 0
  while d3 < flNames.length {
    if flSizes[d3] == FL_UNRESOLVED {
      tErr(
        "`flat type "
          + flNames[d3]
          + "` is recursive — a flat record is stored INLINE, so a cycle has no "
          + "finite size",
        flDeclNodes[d3],
      )
      flSizes[d3] = FL_INVALID
    }
    d3 = d3 + 1
  }
  0
}

// Validate one flat declaration's fields and stage their widths. Every rejected field marks
// the whole declaration invalid, so a later `N.size` reports nothing (the field error is the
// actionable one) and phase B never reports a cycle for it.
function flatStageDecl(d: i32, sd: TypeDecl) {
  const declTyIx = cUserTypes[sd.tdName] ?? -1
  const dfields = sd.tdFields
  flFStart[d] = flFNames.length
  let bad = false
  let fi = 0
  while fi < dfields.length {
    const fd = P.nodes[dfields[fi]]
    if fd is FieldDef {
      const fname = fd.fdName
      // `N.size` is the record's total size, so a field of that name makes the spelling
      // ambiguous. Rejected rather than resolved either way: "field wins" hides the size,
      // "size wins" hides the field's offset, both silent wrong answers in address arithmetic.
      if fname == "size" {
        tErr(
          "a `flat` type cannot have a field named 'size' — that spelling is "
            + "the record's total byte size (`"
            + sd.tdName
            + ".size`); rename the field",
          dfields[fi],
        )
        bad = true
      }
      const spellW = flatStorageSpellWidth(flatFieldTyName(dfields[fi]))
      const fty = flatFieldTyOf(declTyIx, fi)
      const w = flatScalarWidth(fty)
      if spellW > 0 {
        // A sub-word storage width read off the FIELD spelling — `u8`/`i8` one byte, `u16`/`i16`
        // two. `fillTypeDeclAt` resolved all four to the `u8` placeholder, so the width cannot
        // come from the arena type; the spelling is what distinguishes 1 from 2.
        flFNames.push(fname)
        flFWidth.push(spellW)
        flFNest.push(-1)
        flFOff.push(0)
      } else if w > 0 {
        flFNames.push(fname)
        flFWidth.push(w)
        flFNest.push(-1)
        flFOff.push(0)
      } else {
        const nest = flatIndexOf(flatFieldTyName(dfields[fi]))
        if nest >= 0 {
          // A nested flat record inlines: its bytes sit at the offset the running sum has
          // reached, and reaching one of its fields is `Outer.k + Inner.a` — which is why
          // the constant surface needs only one level of access.
          flFNames.push(fname)
          flFWidth.push(-1)
          flFNest.push(nest)
          flFOff.push(0)
        } else {
          // A field whose type failed to resolve at all is already reported by
          // the declaration pass; do not cascade a second message onto it.
          if !flatTyAlreadyErrored(fty) {
            tErr(
              "field '"
                + fname
                + "' cannot be in a `flat` type: "
                + flatWhyNot(fty, flatFieldTyName(dfields[fi]))
                + " — a flat field must be i32/i64/f32/f64, a sub-word storage width "
                + "(u8/i8/u16/i16), a newtype over one of those, or another `flat` type",
              dfields[fi],
            )
          }
          bad = true
        }
      }
    }
    fi = fi + 1
  }
  flFCount[d] = flFNames.length - flFStart[d]
  if bad { flSizes[d] = FL_INVALID }
  0
}

// The `N.size`/`N.field` interception at the top of `checkMemberNode`, the only place the
// layout sidecar is read. Answers 0 for an ordinary field access, 1 when folded to its
// constant, 2 when it reported an error, 3 when the receiver is a live type parameter whose
// fold belongs to the monomorphizer. The fold is an idempotent in-place arena rewrite to a `NumLit`.
function flatMemberFold(n: Member, ix: i32) {
  const obj = P.nodes[n.memObj]
  if obj is Ident {
    const nm = obj.identName
    if lookup(nm) >= 0 { return 0 }
    // A live type parameter (`T.size`): the layout isn't knowable here, since `T` is
    // abstract for the checker's one pass over a generic body, so the fold defers to the
    // monomorphizer, which rewrites this node once per instance. The member's type is `i32`
    // under every binding; whether the binding names a usable `flat` type is checked there instead.
    if tpEnvTyOfName(nm) >= 0 { return 3 }
    const d = flatIndexOf(nm)
    if d < 0 {
      if (cUserTypes[nm] ?? -1) >= 0 {
        tErr(
          "`"
            + nm
            + "` is not a `flat` type, so it has no byte layout — only a "
            + "`flat type "
            + nm
            + " = { … }` has `.size` and per-field offsets",
          ix,
        )
        return 2
      }
      return 0
    }
    // A declaration rejected, or part of a cycle, has its error already on
    // the page — fail quietly rather than cascade onto every use site.
    if flSizes[d] < 0 { return 2 }
    const v = flatConstOf(d, n.memProp)
    if v < 0 {
      tErr(
        "`flat type "
          + nm
          + "` has no field '"
          + n.memProp
          + "' — its layout members are `.size` and one offset per declared field",
        ix,
      )
      return 2
    }
    arenaReplaceNode(ix, mkNum(i32ToStr(v), n.pos))
    return 1
  }
  0
}

// ── nominal newtypes ──
// The whole feature is these five functions plus one test each in `assignableGo`, `tyEqGo`
// and `checkBinExprNode`. Nothing in `emit_*.vl` changes: `canonEmitTypeNames` rewrites
// every newtype annotation to its base's spelling before the emitter runs (`newtype-design.md` §3).

// —— unions whose arms share one runtime representation ——
// The diagnostic for a union two of whose members are distinct to the checker but one value
// shape to the emitter, or "" when every member is separable — a nominal brand is a second
// index erased before the emitter runs, so a brand and its base reach a union box's tag identically.
function nomUnionRepClashMsg(members: i32[]) {
  if nwTyIxs.length == 0 { return "" }
  let i = 1
  while i < members.length {
    let j = 0
    while j < i {
      if sameVariantTy(nomErasedTyIx(members[i]), nomErasedTyIx(members[j])) {
        return "union members '"
          + tyToStr(members[j])
          + "' and '"
          + tyToStr(members[i])
          + "' have the same runtime representation, so `is` cannot tell "
          + "them apart — a nominal newtype is erased to its base at run time"
      }
      j = j + 1
    }
    i = i + 1
  }
  ""
}

// Would `srcExpr : srcTy -> dstTy` succeed if the nominal brands in `dstTy` are ignored?
// True only for a syntactic scalar literal source: it carries no prior identity, so it
// adopts whatever brand the destination wears at any depth. An object/array literal is not
// admitted — it adapts element-wise through `assignableExpr` instead.
function nomLitAdopts(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if nwTyIxs.length == 0 { return false }
  if srcExpr < 0 { return false }
  if !exprIsBrandAdoptingLiteral(srcExpr) || lbiIsInlined(srcExpr) {
    return false
  }
  nomLitRelaxSet(nomLitRelax + 1)
  const ok = assignable(srcTy, dstTy)
  nomLitRelaxSet(nomLitRelax - 1)
  ok
}

// The expression-aware retry for a slot checked with the bare structural `assignable` — the
// map `.set` key. `assignableExpr` covers both scalar-literal brand adoption and object-literal
// field-wise adaptation, which `nomLitAdopts` alone cannot supply. Gated on the destination
// actually carrying a brand, so a brand-free program keeps its bare structural check unchanged.
function nomSlotAccepts(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if nwTyIxs.length == 0 { return false }
  if srcExpr < 0 { return false }
  if !tyReachesBrand(dstTy, 6) { return false }
  assignableExpr(srcExpr, srcTy, dstTy)
}

// —— the mixed-union literal-run regroup, canon's side ——
// `tyToNameGo`'s union arm regroups the flattened string-literal members of a mixed
// union back into their registered alias (`K0 | f64` renders `K0|f64`); canon must spell the
// same union the same way, so this classifies member spellings by the same three-way rule the renderer applies to arena members.

// —— the subsumed-arm collapse, canon's side ——
// The arena drops a union arm that adds no values; canon must drop the same arm or the two
// producers agree about the type and disagree about the rep — the arena saying `string`
// while canon spells `Kind|string` reserves a union box for a plain-string binding (D1048).

// —— structural assignability: is `src` assignable to `dst`? ——
// The error type is assignable both ways (so one failure doesn't cascade). An object is
// assignable when it has at least every target field, each assignable (width + depth
// subtyping); a union source needs every member assignable, a union target needs some member to accept it.
function fnSlotAssignable(src: i32, dst: i32) {
  if numWidens(src, dst) { return false }
  if objNumWidens(src, dst) { return false }
  if fnSlotAtomToString(src, dst) { return assignable(src, dst) }
  if containerElemClassDiffers(src, dst) { return false }
  if fnSlotNulDiffers(src, dst) { return false }
  assignable(src, dst)
}

// Is a list element `de` strictly wider than `se`, so a store through the wider handle could
// put in a value `se` forbids? An inference hole or `never` source decides nothing yet.
function listElemWidens(se: i32, de: i32): boolean {
  if se < 0 || de < 0 { return false }
  if se == de { return false }
  if tyReachesHole(se, 8) || tyReachesHole(de, 8) { return false }
  if primNameOf(se) == "never" { return false }
  !assignable(de, se)
}

// —— written-through covariance: the per-value half of D791's write scan (D821) ——
// D791 lowered a read-only covariant list assignment as an element-converting copy, licensed
// by a rep-scoped predicate that declines on an unrelated list sharing an element rep — a
// false reject clause 2 forbids. A per-value `Writable` answer instead (D793): 0 = safe to copy, 1 = refuse, 2 = unknown, fall back to the rep-scoped scan.

// Reported at the assignment rather than the write, since the assignment is what the
// author can change. Not a capability concession: the copy exists (D791), this program is
// the one shape it is not allowed to run in.
function covarWriteThroughErr(srcExpr: i32, srcTy: i32, dstTy: i32) {
  covarWriteThroughErrAt(srcExpr, srcTy, dstTy, srcExpr)
}

// The same refusal reported at `at`, for a delivery checked away from its own node (a generic
// body's receiver, re-asked at the call that pins it).
function covarWriteThroughErrAt(srcExpr: i32, srcTy: i32, dstTy: i32, at: i32) {
  let where = "somewhere in this program"
  const wAt = covarValueWriteAt(covarRootName(srcExpr), covarRootFrame(srcExpr))
  if wAt >= 0 { where = "(line " + i32ToStr(nodeLineOf(wAt)) + ")" }
  tErr(
    "a "
      + tyToStr(srcTy)
      + " cannot be assigned to "
      + tyToStr(dstTy)
      + " here: the list is WRITTEN THROUGH "
      + where
      + ", and a covariant list "
      + "assignment is read-only. The two element storages differ, so the destination would "
      + "have to hold a converted copy, and a store through either handle would not be seen "
      + "through the other. Declare the source as "
      + tyToStr(listMutableTwin(dstTy))
      + " so both handles share one element storage, or copy it with "
      + containerWidenCopyHintBare(srcTy, dstTy),
    at,
  )
}

// The argument seam's container refusals for a generic body's receiver, re-asked once the
// pin at `at` has bound it to `recvTy`. `callIx` is the member call inside the body (D2165).
function ufcsRecvPinSeam(callIx: i32, recvTy: i32, selfTy: i32, at: i32) {
  if callIx < 0 || callIx >= P.nodes.length { return 0 }
  const c = P.nodes[callIx]
  if c is Call {
    const rx = ufcsRecvExpr(c)
    if rx < 0 { return 0 }
    if covarWriteThrough(rx, recvTy, selfTy) == 1 {
      covarWriteThroughErrAt(rx, recvTy, selfTy, at)
      return 0
    }
    if objShapeAdapterlessAt(rx, recvTy, selfTy) {
      objShapeAdapterlessErr(at, recvTy, selfTy)
    } else if recvTy != selfTy {
      recPend(rx, recvTy, selfTy, at)
    } else {
      recOwnPend(rx, recvTy)
    }
  }
  0
}

// The second sentence (D853), reported at the assignment like its sibling but deliberately
// not sharing its wording: nothing is copied here — both declared views rep as the
// program's one box and every handle aliases one list — so what is wrong is that two
// declared views of one written-through list disagree about which arms the elements may be.
function covarTwoUnionsErr(srcExpr: i32, srcTy: i32, dstTy: i32) {
  tErr(
    "a "
      + tyToStr(srcTy)
      + " cannot be assigned to "
      + tyToStr(dstTy)
      + " here: this list is ALSO declared with a DIFFERENT element union elsewhere in this "
      + "program, and it is written through. VL lists alias, so the two declarations describe "
      + "one storage: a store admitted by one of them can put an element the other has no arm "
      + "for, and a read through that other one has no correct value. Give every handle on this "
      + "list the same element type, or drop the write",
    srcExpr,
  )
}

// —— a record delivered covariantly is read-only in its widened fields (D2060) ——
// `{x: i32}` passed as `{x: i32 | string}` is shared, not copied, so a `string` stored through
// the wider handle lands in a field the source types `i32`. The reads-only rule for covariant
// lists (DECISIONS.md A9) applies field by field: legal where nothing writes a widened slot.

// A covariant slot path is a run of segments, `.f` for a field and `[]` for any element or map
// value, relative to the delivered value. A trailing `*` marks a slot nothing below is followed
// into, so everything reachable under it counts as widened. Answers whether `s` and `d` differ.
function rcwCovs(
  s: i32,
  d: i32,
  path: string,
  out: string[],
  depth: i32,
): boolean {
  if s < 0 || d < 0 || s >= T.tys.length || d >= T.tys.length { return false }
  if s == d || tyEq(s, d) { return false }
  if depth > 12 {
    out.push(path + "*")
    return true
  }
  const st = T.tys[s]
  const dt = T.tys[d]
  // A hole or type variable on the destination side adopts the source; a named type parameter
  // on the source side may be any type, so the slot counts as widened and its type as unknown.
  if dt is TyVar || st is TyErr || dt is TyErr { return false }
  if st is TyVar {
    if st.tvName.length == 0 || st.tvName[0] == '?' { return false }
    // At the root, only a BOUNDED parameter delivered into a record shares its argument's
    // record; an unbounded one is pinned to the destination's own type.
    if path == "" {
      if !(dt is TyObj) || tpBoundOfName(st.tvName) < 0 { return false }
      out.push("*")
    } else {
      out.push(rcwTyped(path, s))
    }
    return true
  }
  // A nullable source into a nullable type variable binds the variable to its inner type, so
  // the slot adopts the source as a bare variable does (D2526).
  if dt is TyNullable && st is TyNullable {
    const dIn = dt.nInner
    if dIn >= 0 && dIn < T.tys.length && T.tys[dIn] is TyVar {
      return rcwCovs(st.nInner, dIn, path, out, depth + 1)
    }
  }
  // A union (or nullable) source into a record is one of its members; each member the record
  // accepts contributes its own widened slots, and `null` none.
  if dt is TyObj && (st is TyUnion || st is TyNullable) {
    const ms = rcwMembersOf(s)
    let any = false
    let mi = 0
    while mi < ms.length {
      const m = ms[mi]
      if m >= 0 && !isNullTy(m) && assignable(m, d) {
        if rcwCovs(m, d, path, out, depth + 1) { any = true }
      }
      mi = mi + 1
    }
    return any
  }
  let differs = false
  let walked = false
  if st is TyObj {
    if dt is TyObj {
      walked = true
      let i = 0
      while i < dt.objFieldNames.length {
        const sf = objFieldType(st, dt.objFieldNames[i])
        if sf >= 0 {
          const fp = path + "." + dt.objFieldNames[i]
          if rcwCovs(sf, dt.objFieldTypes[i], fp, out, depth + 1) {
            differs = true
          }
        }
        i = i + 1
      }
    }
  }
  if st is TyArray {
    if dt is TyArray {
      // A delivered container whose element changes storage is copied or refused by the
      // container rule (DECISIONS.md "No implicit container widening"), so no handle is
      // shared; one that keeps its storage is shared, and this rule decides its writes.
      if path == "" && rcwContainerRuleDomain(st.aElem, dt.aElem) {
        return false
      }
      walked = true
      differs = rcwCovs(st.aElem, dt.aElem, path + "[]", out, depth + 1)
    }
  }
  if st is TyMap {
    if dt is TyMap {
      if path == "" && rcwContainerRuleDomain(st.mVal, dt.mVal) { return false }
      walked = true
      differs = rcwCovs(st.mVal, dt.mVal, path + "[]", out, depth + 1)
    }
  }
  if walked {
    if differs && path != "" { out.push(rcwTyped(path, s)) }
    return differs
  }
  if dt is TyUnion || dt is TyNullable { rcwIntoUnion(s, d, path, out, depth) }
  else if rcwIsRefTy(s) { out.push(path + "*") }
  if path != "" { out.push(rcwTyped(path, s)) }
  true
}

// A value landing in a wider union keeps its own type, and a handle reaches its slots only by
// narrowing to a member the value is assignable to, so each such member's widened slots are
// the value's. A union value lands member by member.
function rcwIntoUnion(s: i32, d: i32, path: string, out: string[], depth: i32) {
  if s < 0 || d < 0 || s >= T.tys.length || d >= T.tys.length || depth > 12 {
    return 0
  }
  const parts = rcwMembersOf(s)
  if parts.length != 1 || parts[0] != s {
    let pi = 0
    while pi < parts.length {
      rcwIntoUnion(parts[pi], d, path, out, depth + 1)
      pi = pi + 1
    }
    return 0
  }
  if isNullTy(s) { return 0 }
  const ms = rcwMembersOf(d)
  let i = 0
  while i < ms.length {
    // An exact member keeps the value's type; an unfilled hole (-1) adopts it.
    if ms[i] < 0 || tyEq(s, ms[i]) { return 0 }
    i = i + 1
  }
  let any = false
  i = 0
  while i < ms.length {
    if !isNullTy(ms[i]) && assignable(s, ms[i]) {
      any = true
      const sub: string[] = []
      rcwCovs(s, ms[i], path, sub, depth + 1)
      let k = 0
      while k < sub.length {
        if rcwPathOf(sub[k]) != path { out.push(sub[k]) }
        k = k + 1
      }
    }
    i = i + 1
  }
  if !any && rcwIsRefTy(s) { out.push(path + "*") }
  0
}

// The widened slots a delivery of `srcExpr` (typed `srcTy`) into `dstTy` shares with an
// existing value: the slots a fresh literal owns are dropped.
function rcwSharedCovs(srcExpr: i32, srcTy: i32, dstTy: i32): string[] {
  const all: string[] = []
  rcwCovs(srcTy, dstTy, "", all, 0)
  const out: string[] = []
  let i = 0
  while i < all.length {
    if !rcwSlotFresh(srcExpr, rcwPathOf(all[i]), 0, 0) { out.push(all[i]) }
    i = i + 1
  }
  out
}

// Record a delivery of `srcExpr` (typed `srcTy`) into `dstTy` when it widens a shared slot.
export function rcwPend(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if srcExpr < 0 || srcTy < 0 || dstTy < 0 || srcTy == dstTy { return 0 }
  // A scalar source shares nothing; a type variable may stand for a record.
  if srcTy >= T.tys.length { return 0 }
  if !rcwIsRefTy(srcTy) && !(T.tys[srcTy] is TyVar) { return 0 }
  // A source typed at a hole shares whatever its pin is: each pin re-asks it (D3250).
  if T.tys[srcTy] is TyVar && rcwIsRefTy(dstTy) && cstrOwnerTop() >= 0 {
    rcwPinNote(srcExpr, srcTy, dstTy)
  }
  const key = i32ToStr(srcExpr) + "#" + i32ToStr(srcTy) + "#" + i32ToStr(dstTy)
  if rcwPendSeen.has(key) { return 0 }
  rcwPendSeen[key] = true
  // The slots are computed here, inside the scope that knows a type parameter's bound.
  const covs = rcwSharedCovs(srcExpr, srcTy, dstTy)
  if covs.length == 0 { return 0 }
  rcwPendCovs.push(rcwKey(covs))
  rcwPendSrc.push(srcExpr)
  rcwPendSrcTy.push(srcTy)
  rcwPendDstTy.push(dstTy)
  0
}

// The deliveries `calleeFn`'s body recorded at a hole, at this call's bindings: a source the pin
// makes concrete is asked the direct spelling's record rules, and one still open is recorded
// for the caller's pins.
function validateRcwPins(bNames: string[], bTys: i32[], calleeFn: i32) {
  if inferQuiet && !cstrProbe { return 0 }
  const n = rcwPinSrc.length
  let i = 0
  while i < n {
    if cstrOwnedBy(rcwPinFn[i], calleeFn) {
      const sub = substTyDeep(rcwPinSrcTy[i], bNames, bTys)
      if sub >= 0 && sub != rcwPinSrcTy[i] {
        if tyHasHole(sub) {
          if T.tys[sub] is TyVar && cstrOwnerTop() >= 0 {
            rcwPinNote(rcwPinSrc[i], sub, rcwPinDstTy[i])
          }
        } else if !inferQuiet && assignable(sub, rcwPinDstTy[i]) {
          // The delivery seam's two record rules, in its order: a shape stored differently,
          // then a widened field something writes.
          if objShapeAdapterlessAt(rcwPinSrc[i], sub, rcwPinDstTy[i]) {
            objShapeAdapterlessErr(rcwPinSrc[i], sub, rcwPinDstTy[i])
          } else {
            rcwPend(rcwPinSrc[i], sub, rcwPinDstTy[i])
          }
        }
      }
    }
    i = i + 1
  }
  0
}

// The entry for a whole delivery of `srcExpr`: the storage and object-shape floor first, then
// the readonly-only list rule.
function objShapeAdapterlessAt(srcExpr: i32, src: i32, dst: i32): boolean {
  shapeAdaptNulCopySet(false)
  shapeAdaptNestedCopySet(false)
  shapeAdaptMapSharedSet(false)
  shapeAdaptRecFieldSet(false)
  if objShapeAdapterless(srcExpr, src, dst, 12, true) { return true }
  let wd = dst
  if dst == lwStoreDst && lwStoreVal >= 0 { wd = lwStoreVal }
  listWidenWalk(srcExpr, src, wd, 12, false)
}

// A literal built inside a function, or handed through a generic call, is built at the row of a
// declared record of its own field storage when one exists, not where the call delivers it; into
// a record that stores a field differently it is refused as an existing record is (D3338). A
// record spelled inline in an annotation is declared too (D3430). True when it refused.
function recBuiltAtDeclared(at: i32, srcTy: i32, dstTy: i32): boolean {
  const own = nonNulTyOf(srcTy)
  const dst = nonNulTyOf(dstTy)
  if own < 0 || dst < 0 || !(T.tys[own] is TyObj) || !(T.tys[dst] is TyObj) {
    return false
  }
  if recAtPinnedArg(at) { return false }
  let found = false
  for k in cUserTypes.keys() {
    if !found && nameIsBareIdent(demangleName(k)) {
      found = recDeclaredRowOf(cUserTypes[k] ?? -1, own, dst)
    }
  }
  for ut in recAnnObjs {
    if !found { found = recDeclaredRowOf(recAdRecOf(ut), own, dst) }
  }
  if !found { return false }
  shapeAdaptSrcTySet(own)
  shapeAdaptDstTySet(dst)
  shapeAdaptSrcExprSet(at)
  shapeAdaptElemPairSet(false)
  shapeAdaptWidthFieldSet(false)
  shapeAdaptRecStorageSet(true)
  shapeAdaptRecStorageFieldSet(recStorageFieldOf(own, dst))
  lwStoreDstSet(-1)
  objShapeAdapterlessErr(at, own, dst)
  shapeAdaptRecStorageSet(false)
  true
}

// A record a function built, or an element of a list binding, delivered where a field it holds as
// an integer is a bare float: the value is built at its own row and has no conversion, so it is
// refused as an existing record is (D3339). True when it refused.
function recFloatBuiltElsewhere(at: i32, srcTy: i32, dstTy: i32): boolean {
  const own = nonNulTyOf(srcTy)
  const dst = nonNulTyOf(dstTy)
  if !recIntToFloat(own, dst, REC_STORE_DEPTH) { return false }
  shapeAdaptSrcTySet(own)
  shapeAdaptDstTySet(dst)
  shapeAdaptSrcExprSet(at)
  shapeAdaptElemPairSet(false)
  shapeAdaptWidthFieldSet(false)
  shapeAdaptRecStorageSet(true)
  shapeAdaptRecStorageFieldSet(recFloatField(own, dst))
  lwStoreDstSet(-1)
  objShapeAdapterlessErr(at, own, dst)
  shapeAdaptRecStorageSet(false)
  true
}

// A function with no declared result called only at `call`, whose every returned value is an
// object literal: each is built at the record the call delivers it to, `dstTy`'s member it
// lands on (D3444). True when it recorded that build.
function recFnBuiltAtDst(fd: i32, call: i32, srcTy: i32, dstTy: i32): boolean {
  const own = nonNulTyOf(srcTy)
  if own < 0 || !(T.tys[own] is TyObj) { return false }
  const dst = recAdLanding(own, nonNulTyOf(dstTy))
  if dst < 0 || !(T.tys[dst] is TyObj) || !objFieldNameSetsEq(own, dst) {
    return false
  }
  cwIxBuild()
  const sites: i32[] = []
  if rcwCallSites(fd, sites) >= 0 || sites.length != 1 || sites[0] != call * 2 {
    return false
  }
  const leaves = recFnValueLeaves(fd)
  if leaves.length == 0 { return false }
  for lf in leaves {
    if !(P.nodes[cwPeel(lf)] is ObjLit) { return false }
  }
  for lf in leaves { recordRepTyAdopt(cwPeel(lf), dst, 6) }
  true
}

// Does the object literal `lit` fit the record `dst` field by field, where only an integer
// literal may meet another number, at every depth of object literals?
function recLitFits(lit: i32, dst: i32, depth: i32): boolean {
  if lit < 0 || dst < 0 || depth <= 0 { return false }
  const d = T.tys[dst]
  const e = P.nodes[lit]
  if !(e is ObjLit) || !(d is TyObj) { return false }
  if !objFieldNameSetsEq(nodeTyIxOf(lit), dst) { return false }
  let i = 0
  while i < d.objFieldNames.length {
    const fx = cwPeel(objLitFieldExpr(lit, d.objFieldNames[i]))
    const df = d.objFieldTypes[i]
    if fx < 0 { return false }
    const fe = P.nodes[fx]
    const ok = assignable(nodeTyIxOf(fx), df)
      || (fe is NumLit && recNumClass(df) != "")
      || (fe is ObjLit && recLitFits(fx, nonNulTyOf(df), depth - 1))
    if !ok { return false }
    i = i + 1
  }
  true
}

// —— adoption: a binding or function holding only literals takes the record it is delivered to ——
// The destination is written as its annotation or result and the program checked again, so
// every use sees it. A re-check that refuses anything but the adopted value handed on whole
// undoes it, unless it changed a number's width (DECISIONS.md "Record covariance").

// Note a delivery of `srcExpr` (a `srcTy`) as a `dstTy`, when it hands a literal binding, or an
// element of a literal list binding, to a record that stores a field differently.
export function recAdoptNote(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if srcTy < 0 || dstTy < 0 || srcTy == dstTy { return 0 }
  if !tyHoldsObj(srcTy, 8) || !tyHoldsObj(dstTy, 8) { return 0 }
  const p = cwPeelValue(srcExpr)
  if p < 0 || p >= P.nodes.length { return 0 }
  const e = P.nodes[p]
  // A value `if`, `match` or block delivers each tail, and a `??` each operand (D3441).
  if recIsJoin(p) {
    const leaves: i32[] = []
    tailValueLeaves(p, leaves)
    for lf in leaves { recAdoptNote(lf, nodeTyIxOf(lf), dstTy) }
    return 0
  }
  const co = recCoalesceOperands(p)
  if co.length == 2 {
    recAdoptNote(co[0], nodeTyIxOf(co[0]), dstTy)
    recAdoptNote(co[1], nodeTyIxOf(co[1]), dstTy)
    return 0
  }
  if e is Ident {
    const decl = recFreshDeclOf(p)
    if decl < 0 { return 0 }
    const iv = P.nodes[parenPeelIx(recDeclInit(decl))]
    if iv is ArrayLit {
      return recAdPushDecl(
        decl,
        tyArrayElemIx(srcTy),
        tyArrayElemIx(recAdLandingList(nonNulTyOf(dstTy))),
        true,
        p,
      )
    }
    return recAdPushDecl(decl, srcTy, nonNulTyOf(dstTy), false, p)
  }
  if e is Index {
    const b = cwPeelValue(e.idxArr)
    if b < 0 || b >= P.nodes.length { return 0 }
    const bn = P.nodes[b]
    if bn is Ident {
      const decl = recFreshDeclOf(b)
      if decl < 0 { return 0 }
      const iv = P.nodes[parenPeelIx(recDeclInit(decl))]
      if iv is ArrayLit {
        return recAdPushDecl(decl, srcTy, nonNulTyOf(dstTy), true, p)
      }
    }
  }
  if e is Call {
    const fd = recInferredFnOf(p)
    if fd >= 0 {
      if recFnBuiltAtDst(fd, p, srcTy, dstTy) {
        return recAdPushDecl(fd, srcTy, nonNulTyOf(dstTy), false, p)
      }
      // A union destination keeps master's delivery, which boxes the record it builds.
      if recFloatBuiltElsewhere(p, srcTy, nonNulTyOf(dstTy)) { return 0 }
      if recHasLitLeaf(fd) && recBuiltAtDeclared(p, srcTy, dstTy) { return 0 }
      return recAdPushDecl(fd, srcTy, nonNulTyOf(dstTy), false, p)
    }
    const pa = recPassThroughArg(p)
    if pa >= 0 {
      // A generic identity hands its argument back, so a literal binding there adopts (D3442).
      const pp = cwPeelValue(pa)
      if (
        pp >= 0
        && ((P.nodes[pp] is Ident && recFreshDeclOf(pp) >= 0)
          || recPassThroughArg(pp) >= 0
          || recIsJoin(pp)
          || recCoalesceOperands(pp).length == 2)
      ) {
        return recAdoptNote(pa, nodeTyIxOf(pa), dstTy)
      }
      // A fresh call handed through is built at its own row, as it is delivered directly.
      const pf = if pp >= 0 { recInferredFnOf(pp) } else { -1 }
      if pf >= 0 {
        const pl = nonNulTyOf(dstTy)
        if (
          recFloatField(nonNulTyOf(srcTy), pl) != ""
          && recFloatBuiltElsewhere(p, srcTy, pl)
        ) {
          return 0
        }
        if recHasLitLeaf(pf) && recBuiltAtDeclared(p, srcTy, dstTy) { return 0 }
      }
      // An object literal argument is built at the identity's own instance, which holds an
      // integer where a flat float field waits (D3442).
      if pp >= 0 && P.nodes[pp] is ObjLit {
        const ol = nonNulTyOf(dstTy)
        if (
          recFloatField(nonNulTyOf(srcTy), ol) != ""
          && recFloatBuiltElsewhere(p, srcTy, ol)
        ) {
          return 0
        }
      }
      const po = recOriginExpr(pa)
      if (
        po >= 0
        && P.nodes[po] is ObjLit
        && recBuiltAtDeclared(p, srcTy, dstTy)
      ) {
        return 0
      }
    }
  }
  // A literal delivers each of its elements or fields to the matching part of the destination.
  const d = nonNulTyOf(dstTy)
  if d < 0 || d >= T.tys.length { return 0 }
  if e is ArrayLit {
    const de = tyArrayElemIx(d)
    if de >= 0 {
      for el in e.arrElems {
        if !(P.nodes[el] is Spread) { recAdoptNote(el, nodeTyIxOf(el), de) }
      }
    }
  } else if e is ObjLit {
    recAdNoteFields(p, d)
  }
  0
}

// `recAdoptNote` for each field of the object literal `lit` delivered as the record `d`.
function recAdNoteFields(lit: i32, d: i32) {
  const dt = T.tys[d]
  if dt is TyObj {
    let i = 0
    while i < dt.objFieldNames.length {
      const fx = objLitFieldExpr(lit, dt.objFieldNames[i])
      if fx >= 0 { recAdoptNote(fx, nodeTyIxOf(fx), dt.objFieldTypes[i]) }
      i = i + 1
    }
  }
  0
}

// A delivery its own type refuses, of a literal binding (or an element or field of a literal)
// into a record that stores one of its numbers at another width or kind (`i32` into `f32`): the
// binding adopts the record and the re-check judges its literal there, as its annotated twin's
// is (D3339). True when it noted such an adoption.
function recAdForce(srcExpr: i32, srcTy: i32, dstTy: i32): boolean {
  if srcTy < 0 || dstTy < 0 || !tyHoldsObj(srcTy, 8) || !tyHoldsObj(dstTy, 8) {
    return false
  }
  const p = cwPeelValue(srcExpr)
  if p < 0 || p >= P.nodes.length { return false }
  const e = P.nodes[p]
  const fd = recInferredFnOf(p)
  if fd >= 0 {
    const dl = recAdLanding(nonNulTyOf(srcTy), nonNulTyOf(dstTy))
    for lf in recFnValueLeaves(fd) {
      if !recLitFits(cwPeel(lf), dl, REC_STORE_DEPTH) { return false }
    }
    return recFnBuiltAtDst(fd, p, srcTy, dstTy)
  }
  if (
    !(e is Ident || e is Index || e is ArrayLit || e is ObjLit)
    && !recIsJoin(p)
    && recCoalesceOperands(p).length != 2
    && recPassThroughArg(p) < 0
  ) {
    return false
  }
  const before = recAdDecl.length
  recAdoptNote(srcExpr, srcTy, dstTy)
  let any = false
  let i = before
  while i < recAdDecl.length {
    if recAdWidth.has(recAdDecl[i]) {
      any = true
      recAdForced.push(p)
      recAdForcedDecl.push(recAdDecl[i])
    }
    i = i + 1
  }
  any
}

// The readonly-only list rule (DECISIONS.md "No implicit container widening", D2161): a list
// whose element widens is refused unless the destination is `readonly`. Keyed on each list's
// ORIGIN: a list literal is built at the type it flows into, so it is exempt while the lists
// inside it are judged by their own expressions. `underNul`: the pair sits under a `| null`.
function listWidenWalk(
  expr: i32,
  src: i32,
  dst: i32,
  depth: i32,
  underNul: boolean,
): boolean {
  if src < 0 || dst < 0 || depth <= 0 { return false }
  if src >= T.tys.length || dst >= T.tys.length { return false }
  if src == dst { return false }
  const x = listOriginExpr(expr)
  if x == LW_INFERRED { return false }
  if x >= 0 && listWidenJoin(x, dst, depth, underNul) { return true }
  if x >= 0 && (recIsJoin(x) || recCoalesceOperands(x).length == 2) {
    return false
  }
  const pa = if x >= 0 { recPassThroughArg(x) } else { -1 }
  if pa >= 0 {
    return listWidenWalk(pa, nodeTyIxOf(pa), dst, depth - 1, underNul)
  }
  const d = T.tys[dst]
  if d is TyNullable {
    const sn = T.tys[src]
    if sn is TyNullable {
      return listWidenWalk(-1, sn.nInner, d.nInner, depth - 1, true)
    }
    return listWidenWalk(x, src, d.nInner, depth - 1, true)
  }
  if d is TyUnion {
    // A union source is delivered member by member, each to the member that accepts it, so
    // `f64[] | i32[]` into itself is not refused for `i32[]` meeting `f64[]` first (D2877).
    if T.tys[src] is TyUnion {
      return listWidenFromSrc(x, src, dst, depth, underNul)
    }
    return listWidenIntoUnion(x, src, d.uMembers, depth, underNul)
  }
  listWidenFromSrc(x, src, dst, depth, underNul)
}

// A value `if`, `match` or block delivers each tail, and a `??` each operand, judged by its
// own origin (D3441). True when one of them is refused.
function listWidenJoin(
  x: i32,
  dst: i32,
  depth: i32,
  underNul: boolean,
): boolean {
  const leaves: i32[] = []
  if recIsJoin(x) {
    tailValueLeaves(x, leaves)
  } else {
    for o in recCoalesceOperands(x) { leaves.push(o) }
  }
  for lf in leaves {
    if listWidenWalk(lf, nodeTyIxOf(lf), dst, depth - 1, underNul) {
      return true
    }
  }
  false
}

// A union destination accepts the source at some member; the walk refuses only when every
// member that accepts it refuses.
function listWidenIntoUnion(
  x: i32,
  src: i32,
  dms: i32[],
  depth: i32,
  underNul: boolean,
): boolean {
  let anyClean = false
  let anyBad = false
  let i = 0
  while i < dms.length {
    if assignable(src, dms[i]) {
      if listWidenWalk(x, src, dms[i], depth - 1, underNul) {
        anyBad = true
      } else {
        anyClean = true
      }
    }
    i = i + 1
  }
  if anyClean { return false }
  anyBad
}

// The walk's dispatch on the source's own kind; a leaf holds no list.
function listWidenFromSrc(
  x: i32,
  src: i32,
  dst: i32,
  depth: i32,
  underNul: boolean,
): boolean {
  const s = T.tys[src]
  match s {
    TyNullable => {
      return listWidenWalk(-1, s.nInner, dst, depth - 1, underNul)
    }
    TyUnion => {
      let i = 0
      while i < s.uMembers.length {
        if listWidenWalk(-1, s.uMembers[i], dst, depth - 1, underNul) {
          return true
        }
        i = i + 1
      }
      return false
    }
    TyArray => {
      return listWidenArray(x, s, src, dst, depth, underNul)
    }
    TyObj => {
      return listWidenObj(x, s, dst, depth)
    }
    TyMap => {
      return listWidenMap(x, s, src, dst, depth)
    }
    TyFunc => {
      return listWidenFunc(s, dst, depth)
    }
    TyPrim | TyErr | TyVar | TyLit | TyNeg => {
      return false
    }
  }
}

// A list into a list: the element pair first, so the innermost widened list is the one named.
function listWidenArray(
  x: i32,
  s: TyArray,
  src: i32,
  dst: i32,
  depth: i32,
  underNul: boolean,
): boolean {
  const d = T.tys[dst]
  if d is TyArray {
    if x >= 0 {
      const lit = P.nodes[x]
      if lit is ArrayLit {
        return listWidenLitElems(lit.arrElems, d.aElem, depth)
      }
    }
    if listWidenWalk(-1, s.aElem, d.aElem, depth - 1, false) { return true }
    if d.aRead != 1 {
      if listElemWidens(s.aElem, d.aElem) { return listWidenClaim(x, src, dst) }
      return false
    }
    // A readonly destination that needs a converting copy under `| null` has no lowering yet.
    if underNul && listPairNeedsCopy(s.aElem, d.aElem) {
      shapeAdaptNulCopySet(true)
      return listWidenClaim(x, src, dst)
    }
  }
  false
}

// The elements of a list literal, each judged by its own expression; a spread hands over the
// elements of an existing list, which carry no origin of their own, unless it spreads a list
// literal, whose elements are judged as this literal's own (D4871).
function listWidenLitElems(els: i32[], de: i32, depth: i32): boolean {
  let i = 0
  while i < els.length {
    const el = P.nodes[els[i]]
    const sx = ctorExprOf(spreadArgOf(els[i]))
    const sl = if sx >= 0 { P.nodes[sx] } else { el }
    if sl is ArrayLit && sx >= 0 {
      if listWidenLitElems(sl.arrElems, de, depth - 1) { return true }
    } else if el is Spread {
      const st = nodeTyIxOf(el.spdArg)
      if st >= 0 && st < T.tys.length {
        const sa = T.tys[st]
        if sa is TyArray {
          if listWidenWalk(-1, sa.aElem, de, depth - 1, false) { return true }
        }
      }
    } else if listWidenWalk(els[i], nodeTyIxOf(els[i]), de, depth - 1, false) {
      return true
    }
    i = i + 1
  }
  false
}

// A record into a record: each field the destination declares, with its initializer when the
// source is an object literal. A record VALUE is shared, not rebuilt, so a list field whose
// element differs has no lowering even as a view (D2100): that pair is claimed outright.
function listWidenObj(x: i32, s: TyObj, dst: i32, depth: i32): boolean {
  const d = T.tys[dst]
  if d is TyObj {
    let lit = -1
    if x >= 0 {
      const ol = P.nodes[x]
      if ol is ObjLit { lit = x }
    }
    let i = 0
    while i < d.objFieldNames.length {
      const sf = objFieldType(s, d.objFieldNames[i])
      if sf >= 0 {
        const fx = objLitFieldExpr(lit, d.objFieldNames[i])
        if listWidenWalk(fx, sf, d.objFieldTypes[i], depth - 1, false) {
          return true
        }
        if lit < 0 && listSlotWidens(sf, d.objFieldTypes[i], 8) {
          shapeAdaptRecFieldSet(true)
          return listWidenClaimInner(sf, d.objFieldTypes[i], x)
        }
      }
      i = i + 1
    }
  }
  false
}

// Claim the first list pair inside `st` -> `dt` whose element differs, for the message.
function listWidenClaimInner(st: i32, dt: i32, x: i32): boolean {
  let s = st
  let d = dt
  let guard = 0
  while guard < 16 {
    const dn = T.tys[d]
    const sn = T.tys[s]
    if dn is TyNullable {
      d = dn.nInner
      if sn is TyNullable { s = sn.nInner }
    } else if dn is TyArray {
      if sn is TyArray {
        if listElemDiffers(sn.aElem, dn.aElem) {
          return listWidenClaim(x, s, d)
        }
        s = sn.aElem
        d = dn.aElem
      } else {
        return listWidenClaim(x, st, dt)
      }
    } else {
      return listWidenClaim(x, st, dt)
    }
    if s < 0 || d < 0 || s >= T.tys.length || d >= T.tys.length {
      return listWidenClaim(x, st, dt)
    }
    guard = guard + 1
  }
  listWidenClaim(x, st, dt)
}

// A map into a map. A map has no read-only view, so a key or value holding a list whose
// element widens is refused even into a `readonly` list: a store through the wider map puts a
// wider list where the narrower map's readers expect their own (D2161's r13). A list shared at
// its own element type (`string[]` into `readonly string[]`) passes.
function listWidenMap(
  x: i32,
  s: TyMap,
  src: i32,
  dst: i32,
  depth: i32,
): boolean {
  const d = T.tys[dst]
  if d is TyMap {
    if listWidenWalk(-1, s.mKey, d.mKey, depth - 1, false) { return true }
    if listWidenWalk(-1, s.mVal, d.mVal, depth - 1, false) { return true }
    const vw = listSlotWidens(s.mVal, d.mVal, 8)
    const kw = listSlotWidens(s.mKey, d.mKey, 8)
    if vw || kw {
      shapeAdaptMapSharedSet(true)
      return listWidenClaim(x, src, dst)
    }
  }
  false
}

// A function value: its result is covariant and its parameters contravariant, in the order
// `assignable`'s `TyFunc` arm compares them.
function listWidenFunc(s: TyFunc, dst: i32, depth: i32): boolean {
  const d = T.tys[dst]
  if d is TyFunc {
    if s.fnParamTypes.length != d.fnParamTypes.length { return false }
    if listWidenWalk(-1, s.fnRet, d.fnRet, depth - 1, false) { return true }
    let i = 0
    while i < s.fnParamTypes.length {
      if (
        listWidenWalk(
          -1,
          d.fnParamTypes[i],
          s.fnParamTypes[i],
          depth - 1,
          false,
        )
      ) {
        return true
      }
      i = i + 1
    }
  }
  false
}

// Does `st` -> `dt` pair a list with one whose element differs, anywhere inside, `readonly`
// or not? The shape a map value or record field cannot share.
function listSlotWidens(st: i32, dt: i32, depth: i32): boolean {
  if (
    st < 0
    || dt < 0
    || st >= T.tys.length
    || dt >= T.tys.length
    || depth <= 0
  ) {
    return false
  }
  if st == dt { return false }
  const d = T.tys[dt]
  match d {
    TyArray => {
      const se = tyArrayElemIx(st)
      if se < 0 { return false }
      if listElemDiffers(se, d.aElem) { return true }
      // A mutable list read as a view of a union or nullable element: a view stored back
      // through the wider slot may itself view a NARROWER list (D2161's r13).
      if d.aRead == 1 && !tyIxIsView(st) && elemAdmitsNarrowerShare(d.aElem) {
        return true
      }
      return listSlotWidens(se, d.aElem, depth - 1)
    }
    TyNullable => {
      return listSlotWidens(nonNulTyOf(st), d.nInner, depth - 1)
    }
    TyObj => {
      return listSlotWidensFields(st, d, depth)
    }
    TyMap => {
      return listSlotWidensEntries(st, d, depth)
    }
    // A leaf, a union or a function holds no list slot this rule shares.
    TyPrim | TyErr | TyFunc | TyUnion | TyVar | TyLit | TyNeg => {
      return false
    }
  }
}

// `listSlotWidens` over each field `d` declares, when `st` is a record too.
function listSlotWidensFields(st: i32, d: TyObj, depth: i32): boolean {
  const s = T.tys[st]
  if s is TyObj {
    let i = 0
    while i < d.objFieldNames.length {
      const sf = objFieldType(s, d.objFieldNames[i])
      if sf >= 0 && listSlotWidens(sf, d.objFieldTypes[i], depth - 1) {
        return true
      }
      i = i + 1
    }
  }
  false
}

// `listSlotWidens` over a map's key and value, when `st` is a map too.
function listSlotWidensEntries(st: i32, d: TyMap, depth: i32): boolean {
  const s = T.tys[st]
  if s is TyMap {
    return listSlotWidens(s.mKey, d.mKey, depth - 1)
      || listSlotWidens(s.mVal, d.mVal, depth - 1)
  }
  false
}

// Do two list elements differ in a way a shared list cannot carry: a widened element, or a
// different storage class?
function listElemDiffers(se: i32, de: i32): boolean {
  listElemWidens(se, de) || containerElemClassDiffers(se, de)
}

// `direct` — is the destination a slot a `(ref $src)` can be written into as it stands?
// True at a value flow, where a declared WasmGC supertype makes the reference fit. False
// wherever the pair sits under something whose own wasm type has to relate by identity — an
// array or map element, a function signature — since a struct-level `sub` edge does not reach those.
function objShapeAdapterless(
  srcExpr: i32,
  src: i32,
  dst: i32,
  depth: i32,
  direct: boolean,
): boolean {
  if src < 0 || dst < 0 || depth <= 0 { return false }
  if src == dst { return false }
  const s = T.tys[src]
  const d = T.tys[dst]
  // Nullable pairs peel exactly as `assignableGo`'s nullable arm does, and in its order.
  if d is TyNullable {
    if s is TyNullable {
      return objShapeAdapterless(-1, s.nInner, d.nInner, depth - 1, direct)
    }
    return objShapeAdapterless(srcExpr, src, d.nInner, depth - 1, direct)
  }
  // A union source is assignable when every member is, so any member needing an adapter
  // makes the whole flow one.
  if s is TyUnion {
    const sms = s.uMembers
    let si = 0
    while si < sms.length {
      if objShapeAdapterless(-1, sms[si], dst, depth - 1, false) { return true }
      si = si + 1
    }
    return false
  }
  // A union target accepts the source at some member. It is adapterless only when no
  // accepting member is: one clean member is a lowering.
  if d is TyUnion {
    const dms = d.uMembers
    let di = 0
    let anyClean = false
    let anyAdapts = false
    while di < dms.length {
      if assignable(src, dms[di]) {
        if objShapeAdapterless(srcExpr, src, dms[di], depth - 1, false) {
          anyAdapts = true
        } else {
          anyClean = true
        }
      }
      di = di + 1
    }
    if anyClean { return false }
    return anyAdapts
  }
  const cx = ctorExprOf(srcExpr)
  if s is TyObj {
    if d is TyObj {
      // A cost early-out, not a decision: `tyEq` is render-equality, so two equal object
      // types have equal ordered field-name lists, which `objFieldNameSetsEq` declines
      // anyway. Here because the identical pair is the overwhelmingly common one.
      if tyEq(src, dst) { return false }
      // A pair reaching an inference hole is not a pair of shapes yet. An un-annotated
      // parameter used only as `o.x` demands `{x: _}`, which looks like a width-subtyped
      // destination beside a two-field argument and is not one — the solve pins it from the
      // argument and it lowers.
      if tyReachesHole(src, 8) || tyReachesHole(dst, 8) { return false }
      if cx >= 0 {
        const ce = P.nodes[cx]
        if ce is ObjLit {
          // The literal itself is rebuilt at `dst`; its field values still have to fit
          // the destination field types, judged with their own expressions.
          const dnames = d.objFieldNames
          const dtys = d.objFieldTypes
          let li = 0
          while li < dnames.length {
            const sft = objFieldType(s, dnames[li])
            if sft >= 0 {
              let fexpr = -1
              const fl = ce.objFields
              let fi = 0
              while fi < fl.length {
                const fn = P.nodes[fl[fi]]
                if fn is FieldInit {
                  if fn.fiName == dnames[li] { fexpr = fn.fiValue }
                }
                fi = fi + 1
              }
              if objShapeAdapterless(fexpr, sft, dtys[li], depth - 1, true) {
                return true
              }
            }
            li = li + 1
          }
          // Falls through to the dropped-field decision: the exemption covers what "built
          // at the destination shape" buys, and a field the destination does not declare is
          // not in it. `emitObj` walks the destination's field list, so a lacked field is
          // never visited — its initializer never runs, a silently wrong evaluation count.
        }
      }
      // Agreeing field names, differing through a field — still adapterless, and one case
      // is worse than a hole: a field width pair (`{n: Wide}` into `{n: Narrow}`) is unsound
      // rather than unsupported, since a struct field is mutable. Not withdrawn here, since
      // the identical pair is correct for an un-annotated literal — the verdict turns on the source's provenance (D622).
      if objFieldNameSetsEq(src, dst) {
        // …except where a field pair is itself a width pair and the source is not a
        // rebuilt literal — withdrawing on the types alone would redden the un-annotated
        // literal case, which is correct, so the axis is the source's provenance
        // (`litShapeDropSrcExpr`). A struct's mutable field is WasmGC-invariant, so this is a clause-1 soundness violation with no sound lowering to build (D938).
        if (
          !litShapeDropSrcExpr(cx)
          && !srcIsUnannotatedObjBinding(srcExpr)
          && objFieldWidthPair(src, dst)
        ) {
          shapeAdaptSrcTySet(src)
          shapeAdaptDstTySet(dst)
          shapeAdaptSrcExprSet(cx)
          shapeAdaptElemPairSet(false)
          shapeAdaptWidthFieldSet(true)
          return true
        }
        return false
      }
      // The width lift (D622): a `Wide` flowing into a `Narrow` whose fields are the first
      // of `Wide`'s, in the canonical layout order with identical types, needs no
      // conversion — `emitTypeSection` declares a `(sub)` edge, only at a `direct` position.
      // An object literal is not lifted: `emitObj` builds it at the destination's field list, so an excess field's initializer never runs.
      if direct && !litShapeDropSrcExpr(cx) && objWidthPrefix(src, dst) {
        return false
      }
      shapeAdaptSrcTySet(src)
      shapeAdaptDstTySet(dst)
      shapeAdaptSrcExprSet(cx)
      shapeAdaptElemPairSet(false)
      shapeAdaptWidthFieldSet(false)
      return true
    }
    return false
  }
  if s is TyArray {
    if d is TyArray {
      if cx >= 0 {
        const ae = P.nodes[cx]
        if ae is ArrayLit {
          const els = ae.arrElems
          let ei = 0
          while ei < els.length {
            // A spread of a list literal is fresh too: it is delivered into the list type, so
            // its own elements are built at `d.aElem` (D4871).
            const sx = ctorExprOf(spreadArgOf(els[ei]))
            if sx >= 0 && P.nodes[sx] is ArrayLit {
              if (
                objShapeAdapterless(sx, nodeTyIxOf(sx), dst, depth - 1, direct)
              ) {
                return true
              }
            } else if (
              objShapeAdapterless(
                els[ei],
                nodeTyIxOf(els[ei]),
                d.aElem,
                depth - 1,
                true,
              )
            ) {
              return true
            }
            ei = ei + 1
          }
          return false
        }
      }
      // The nested pair first, so a container carrying an object pair keeps the precise
      // object wording; only then the element's own storage class — what makes
      // `i32[][]` -> `(i32 | null)[][]` report the inner array pair rather than the outer.
      if objShapeAdapterless(-1, s.aElem, d.aElem, depth - 1, false) {
        return true
      }
      if (
        containerElemClassDiffers(s.aElem, d.aElem)
        || (d.aRead == 0 && unionElemMemberWidens(s.aElem, d.aElem))
      ) {
        // Only a `readonly` destination takes the converting copy (D965), and only where
        // nothing writes the source: the copy is a snapshot. An unknown write state (2) refuses.
        if d.aRead == 1 && scalarElemWidenServed(s.aElem, d.aElem) {
          if cx < 0 {
            shapeAdaptNestedCopySet(true)
          } else if (
            covarValueWriteState(covarRootName(cx), covarRootFrame(cx))
            == 0
          ) {
            if !covarRootFreshLocal(cx) { noteScalarView(s.aElem, d.aElem) }
            return false
          }
        }
        shapeAdaptSrcTySet(src)
        shapeAdaptDstTySet(dst)
        shapeAdaptSrcExprSet(cx)
        shapeAdaptElemPairSet(true)
        shapeAdaptWidthFieldSet(false)
        return true
      }
      return false
    }
    return false
  }
  if s is TyMap {
    if d is TyMap {
      if objShapeAdapterless(-1, s.mKey, d.mKey, depth - 1, false) {
        return true
      }
      if objShapeAdapterless(-1, s.mVal, d.mVal, depth - 1, false) {
        return true
      }
      if containerElemClassDiffers(s.mKey, d.mKey) {
        shapeAdaptSrcTySet(src)
        shapeAdaptDstTySet(dst)
        shapeAdaptSrcExprSet(cx)
        shapeAdaptElemPairSet(true)
        shapeAdaptWidthFieldSet(false)
        return true
      }
      if (
        containerElemClassDiffers(s.mVal, d.mVal)
        || mapValBoxDiffers(s.mVal, d.mVal)
        || unionElemMemberWidens(s.mVal, d.mVal)
      ) {
        shapeAdaptSrcTySet(src)
        shapeAdaptDstTySet(dst)
        shapeAdaptSrcExprSet(cx)
        shapeAdaptElemPairSet(true)
        shapeAdaptWidthFieldSet(false)
        return true
      }
      return false
    }
    return false
  }
  if s is TyFunc {
    if d is TyFunc {
      const sp = s.fnParamTypes
      const dp = d.fnParamTypes
      if sp.length != dp.length { return false }
      if objShapeAdapterless(-1, s.fnRet, d.fnRet, depth - 1, false) {
        return true
      }
      let pi = 0
      while pi < sp.length {
        // Parameters compare contravariantly in `assignable`'s `TyFunc` arm; keep the
        // same operand order so the pair examined is the pair it accepted.
        if objShapeAdapterless(-1, dp[pi], sp[pi], depth - 1, false) {
          return true
        }
        pi = pi + 1
      }
      return false
    }
    return false
  }
  false
}

// The `readonly` spelling of `dst` that `src` could be delivered to — every list on the way to
// the widened one made a view — or -1 when this checker would refuse that too, so a message
// never offers a fix that does not build. `srcExpr` keeps the delivery's own write licence.
function readonlyFixOf(
  srcExpr: i32,
  src: i32,
  dst: i32,
  pairS: i32,
  pairD: i32,
): i32 {
  const ro = viewifyLists(src, dst, 8)
  if ro < 0 || ro == dst { return -1 }
  // A readonly copy is licensed where nothing writes the source (D791); the emitter decides a
  // record-into-union copy, so the offer asks the same licence rather than promise it.
  if pairS < 0 || pairD < 0 || pairS >= T.tys.length || pairD >= T.tys.length {
    return -1
  }
  const ps = T.tys[pairS]
  const pd = T.tys[pairD]
  if ps is TyArray {
    if pd is TyArray {
      if listPairNeedsCopy(ps.aElem, pd.aElem) {
        const rx = parenPeelIx(srcExpr)
        if covarValueWriteState(covarRootName(rx), covarRootFrame(rx)) != 0 {
          return -1
        }
      }
    }
  }
  if !assignable(src, ro) { return -1 }
  const sS = shapeAdaptSrcTy
  const sD = shapeAdaptDstTy
  const sX = shapeAdaptSrcExpr
  const sE = shapeAdaptElemPair
  const sW = shapeAdaptWidthField
  const nC = shapeAdaptNulCopy
  const nN = shapeAdaptNestedCopy
  const nM = shapeAdaptMapShared
  const nR = shapeAdaptRecField
  const nS = shapeAdaptRecStorage
  const nF = shapeAdaptRecStorageField
  const bad = covarWriteThrough(srcExpr, src, ro) != 0
    || objShapeAdapterlessAt(srcExpr, src, ro)
  shapeAdaptRecFieldSet(nR)
  shapeAdaptRecStorageSet(nS)
  shapeAdaptRecStorageFieldSet(nF)
  shapeAdaptSrcTySet(sS)
  shapeAdaptDstTySet(sD)
  shapeAdaptSrcExprSet(sX)
  shapeAdaptElemPairSet(sE)
  shapeAdaptWidthFieldSet(sW)
  shapeAdaptNulCopySet(nC)
  shapeAdaptNestedCopySet(nN)
  shapeAdaptMapSharedSet(nM)
  if bad { return -1 }
  ro
}

// The message for an `objShapeAdapterless` pair. Names the object pair that has no lowering
// and the fields that make it one, not the container that carried it (reported separately),
// then the two ways out: a constructor is built at the shape it flows into, or the source
// can be spelled at the target's shape.
export function objShapeAdapterlessErr(srcExpr: i32, src: i32, dstIn: i32) {
  // A map index store is checked against its read type `V | null`; the slot is `V`.
  let dst = dstIn
  if dstIn == lwStoreDst && lwStoreVal >= 0 { dst = lwStoreVal }
  let sT = shapeAdaptSrcTy
  let dT = shapeAdaptDstTy
  let sX = shapeAdaptSrcExpr
  if sT < 0 || dT < 0 {
    sT = src
    dT = dst
    sX = srcExpr
  }
  // A repeated key or a field the record type declares twice is refused at the repeat
  // itself; its second slot is not a field to drop.
  if objLitHasDupKey(sX) || objLitHasDupKey(srcExpr) { return 0 }
  if objTyHasDupField(dT) || objTyHasDupField(dst) { return 0 }
  let through = ""
  if !tyEq(sT, src) || !tyEq(dT, dst) {
    through = " (reached through "
      + tyToStr(src)
      + " into "
      + tyToStr(dst)
      + ")"
  }
  if shapeAdaptRecStorage {
    recStorageErr(srcExpr, sT, dT, sX, through)
    return 0
  }
  // An object literal gets its own wording: "construct at the destination shape" is what
  // the author already did, but what actually happens is silent — dropping the excess
  // field's initializer unevaluated. The container-element wording instead names what
  // changed: how the element is stored — not a capability gap, since a struct field is WasmGC-invariant (D938).
  if shapeAdaptWidthField {
    tErr(
      "an object of type "
        + tyToStr(sT)
        + " cannot flow into "
        + tyToStr(dT)
        + through
        + ": they agree on field names but differ INSIDE a field, and a struct field is "
        + "mutable — writing through the narrower view would leave the original holding a "
        + "value of the wrong type, so the two are unrelated by design and not by a missing "
        + "lowering. Give the source exactly "
        + tyToStr(dT)
        + "'s field types, or read the field out and rebuild",
      srcExpr,
    )
    return 0
  }
  // A design rule, not a missing lowering (DECISIONS.md §"No implicit container widening").
  // A mutable list pair `readonly` would accept names both fixes; a readonly copy pair is
  // refused only because the source is written, so that message names the write.
  if shapeAdaptElemPair {
    let rule = ": a container never widens implicitly. Its elements would have to be stored "
      + "differently, which takes a copy, and a write through the copy would no longer reach "
      + "the original."
    let hint = containerWidenCopyHint(sT, dT)
    // The whole delivered value built at the type it flows into, as its own declaration
    // spells it — every fix names a type the author can write at the source.
    const buildFix = " Build the source as `"
      + tyToStr(sourceBuildTy(dst))
      + "`"
    // An inner list spelled in the source (a literal's element or field) can still be copied
    // with `.map`; one reached only through a type is built at the outer type instead.
    const innerNamed = !(through != "" && sX < 0)
    if !innerNamed { hint = "" }
    const pairNote = tyToStr(sT) + " is not " + tyToStr(dT) + through
    let copyFix = buildFix
    if hint != "" { copyFix = " Copy it" + hint.slice(12, hint.length) }
    if shapeAdaptNulCopy || shapeAdaptNestedCopy {
      tErr(pairNote + containerCopyGapWhy(shapeAdaptNulCopy) + copyFix, srcExpr)
      return 0
    }
    if shapeAdaptMapShared {
      tErr(
        pairNote
          + ": a map never widens a list it holds, and it has no read-only view, so every handle "
          + "would share entries of two types."
          + buildFix,
        srcExpr,
      )
      return 0
    }
    if shapeAdaptRecField {
      tErr(
        pairNote
          + ": a record is shared, not rebuilt, so its list field would have to change type in "
          + "place, which no delivery does, readonly or not (D2100)."
          + buildFix,
        srcExpr,
      )
      return 0
    }
    if containerWidenReadonlyServes(sT, dT) {
      // The `readonly` fix is offered only when this checker accepts it for this delivery.
      const ro = readonlyFixOf(srcExpr, src, dst, sT, dT)
      let fix = ""
      if ro >= 0 {
        fix = " Declare the destination `"
          + tyToStr(ro)
          + "` for a read-only view"
        if hint != "" { fix = fix + hint }
      } else {
        fix = copyFix
      }
      tErr(
        pairNote
          + ": a container never widens implicitly, and only a readonly list is covariant. "
          + containerWidenWhy(sT, dT)
          + fix,
        srcExpr,
      )
      return 0
    }
    if through == "" && containerWidenServed(sT, dT) {
      const wAt = covarValueWriteAt(covarRootName(sX), covarRootFrame(sX))
      let written = "nothing shows this list is never written, and a container that may be "
        + "written"
      if wAt >= 0 {
        written = "this list is written (line "
          + i32ToStr(nodeLineOf(wAt))
          + "), and a written container"
      }
      rule = " here: "
        + written
        + " never widens implicitly. Its elements would have to be stored differently, which "
        + "takes a copy, and a write would not reach both."
    }
    // A pair reached through a literal spelled in the source is fixed at that inner value.
    let fixes = buildFix
    if through != "" && hint != "" { fixes = copyFix }
    else if hint != "" { fixes = fixes + hint }
    tErr(
      tyToStr(sT) + " is not " + tyToStr(dT) + through + rule + fixes,
      srcExpr,
    )
    return 0
  }
  if litShapeDropSrcExpr(sX) {
    objLitUndeclaredErr(srcExpr, sT, dT, through)
  } else {
    tErrUnsupported(
      "an object value of shape "
        + tyToStr(sT)
        + " flowing into "
        + tyToStr(dT)
        + through
        + " drops the field "
        + objDroppedFieldList(sT, dT)
        + ": type-valid (structural width subtyping) but not yet supported by codegen — a "
        + "struct's wasm type is its own field list, so these are unrelated types and no "
        + "field-dropping conversion exists. Construct the value at "
        + tyToStr(dT)
        + " (an object literal is built at the shape it flows into), or declare the source "
        + "with exactly "
        + tyToStr(dT)
        + "'s fields",
      srcExpr,
    )
  }
}

// The record storage rule's refusal: names the pair, the field stored differently, and both
// fixes: build the source at the destination, or copy it with an object literal.
function recStorageErr(at: i32, sT: i32, dT: i32, sX: i32, through: string) {
  const fnm = shapeAdaptRecStorageField
  let fieldNote = ""
  const s = T.tys[sT]
  const d = T.tys[dT]
  if s is TyObj {
    if d is TyObj {
      const sf = objFieldType(s, fnm)
      const df = objFieldType(d, fnm)
      if sf >= 0 && df >= 0 {
        fieldNote = " (`" + tyToStr(sf) + "` into `" + tyToStr(df) + "`)"
      }
    }
  }
  const root = covarRootName(sX)
  let copy = "{ "
  if d is TyObj {
    let i = 0
    while i < d.objFieldNames.length {
      if i > 0 { copy = copy + ", " }
      const fn = d.objFieldNames[i]
      if root != "" {
        copy = copy + fn + ": " + root + "." + fn
      } else {
        copy = copy + fn + ": …"
      }
      i = i + 1
    }
  }
  copy = copy + " }"
  recAdRaising = true
  tErr(
    tyToStr(sT)
      + " is not "
      + tyToStr(dT)
      + through
      + ": they store field `"
      + fnm
      + "` differently"
      + fieldNote
      + ", and a record is shared, not copied, so only a fresh record widens. A write through "
      + "the "
      + tyToStr(dT)
      + " would break the "
      + tyToStr(sT)
      + ". Build the source as `"
      + tyToStr(dT)
      + "`, or copy it with a literal `"
      + copy
      + "`",
    at,
  )
  recAdRaising = false
  0
}

// The refusal of an object literal setting a field its destination record does not declare.
function objLitUndeclaredErr(at: i32, sT: i32, dT: i32, through: string) {
  tErr(
    "this object literal sets "
      + objDroppedFieldList(sT, dT)
      + ", which "
      + tyToStr(dT)
      + " does not declare"
      + through
      + ": a literal is built at the shape it flows into, so the extra field would be "
      + "dropped and its initializer never evaluated — a call there would never run. "
      + "Remove the field, or declare it on "
      + tyToStr(dT),
    at,
  )
}

// Exported for the LSP query layer's UFCS candidate scan, which asks exactly the question
// `ufcsCallTy` asks of a written call — of every declared `self`-function — so the editor
// can offer the ones whose import is missing. The export is a visibility change, not a new answer.
export function assignable(src: i32, dst: i32) {
  if src < 0 || dst < 0 { return true }
  if src == dst { return true }
  let gi = asgSrcStack.length - 1
  while gi >= 0 {
    if asgSrcStack[gi] == src && asgDstStack[gi] == dst { return true }
    gi = gi - 1
  }
  asgSrcStackPush(src)
  asgDstStackPush(dst)
  const ok = assignableGo(src, dst)
  asgSrcStackPop()
  asgDstStackPop()
  ok
}

function assignableGo(src: i32, dst: i32) {
  const s = T.tys[src]
  const d = T.tys[dst]
  // A second, never-narrowed name for the same source variant, bound where `s` is still
  // the whole `Ty` union. The `s is X` guards below each subtract their variant from `s`
  // for the rest of the body, so a structural tail wanting the declared union needs `sTail`
  // instead — bound at the top so it is provably the same variant as `s`.
  const sTail = s
  if s is TyErr { return true }
  if d is TyErr { return true }
  if s is TyVar { return true }
  if d is TyVar { return true }
  // `never` (the empty type) is the bottom type: assignable anywhere. As a target it
  // accepts nothing — no concrete source reaches `s.primName == d.primName` with "never" on only one side.
  if s is TyPrim {
    if s.primName == "never" { return true }
  }
  // Nullable target: accepts `null` itself, the inner, or another nullable's inner.
  if d is TyNullable {
    if src == TY_NULL { return true }
    if s is TyNullable { return assignable(s.nInner, d.nInner) }
    return assignable(src, d.nInner)
  }
  // A nullable source is not assignable to a non-nullable target unless the target already
  // admits `null` (D1030): `T | null` is assignable to `D` iff `T` is and `null` is. A
  // self-referential union with a `null` arm interns as `TyUnion[TyNullable(rest)]`, so
  // without this `Json` is not assignable to its own superset `Json | JsonError`.
  if s is TyNullable {
    if assignable(TY_NULL, dst) { return assignable(s.nInner, dst) }
    return false
  }
  // Union source: every member must be assignable to the target. A value box holding a
  // numeric member that only widens to a numeric target has no conversion yet (D2611).
  if s is TyUnion {
    const members = s.uMembers
    const numDst = isNumericPrimTy(dst)
    let i = 0
    let ok = true
    while i < members.length {
      if !assignable(members[i], dst) { ok = false }
      if numDst && isNumericPrimTy(members[i]) && !tySame(members[i], dst) {
        ok = false
      }
      i = i + 1
    }
    return ok
  }
  // Union target: the source must be assignable to some member.
  if d is TyUnion {
    const members = d.uMembers
    let i = 0
    let ok = false
    while i < members.length {
      if assignable(src, members[i]) { ok = true }
      i = i + 1
    }
    return ok
  }
  // Literal types: a literal source is assignable to the same literal, or anywhere its base
  // scalar flows (`0` → i32, `"a"` → string). A non-literal source is never assignable to a
  // literal target — `string` does not flow into `"a" | "b"`, a closed set, not an open string type.
  if s is TyLit {
    if d is TyLit { return s.litKind == d.litKind && s.litText == d.litText }
    return assignable(litBaseTy(s), dst)
  }
  if d is TyLit { return false }
  // A negation target `!T` (residual, usually folded away by `intersectTy`): accepts a
  // source not assignable to the negated type.
  if d is TyNeg { return !assignable(src, d.negTy) }
  if s is TyNeg { return false }
  // Nominal newtype: a brand and its base — or two different brands — do not flow into each
  // other, though every structural rule below would accept them. `assignable` is the single
  // chokepoint every position goes through, so no position can be taught half the rule.
  // Placement is load-bearing: after the holes, `never`, and the nullable/union/literal/negation arms, all of which destructure and recurse.
  if nomLitRelax == 0 {
    if nomNameOfTy(src) != nomNameOfTy(dst) { return false }
  }
  // The structural tail, exhaustive over `Ty` and deliberately `_`-less: a 12th arena
  // variant breaks the self-compile here instead of silently answering `false`, a spurious
  // loud reject of a valid program. Scrutinised on `sTail`, not `s`: `s` has had every
  // guarded variant above subtracted from it, while `sTail` carries the full declared `Ty`.
  match sTail {
    TyPrim => {
      if d is TyPrim {
        // Lossless numeric widening: a narrower numeric value flows into a wider slot along
        // the lattice i32→{i64,f32,f64}, i64→f64, f32→f64; the reverse is not assignable,
        // since it is lossy and must be made explicit. Codegen inserts the matching wasm
        // convert at the boundary; the binding takes the wider type.
        if numWidensName(sTail.primName, d.primName) { return true }
        return sTail.primName == d.primName
      }
      return false
    }
    TyObj => {
      if d is TyObj {
        const dnames = d.objFieldNames
        const dtys = d.objFieldTypes
        let i = 0
        let ok = true
        while i < dnames.length {
          const srcIx = objFieldType(sTail, dnames[i])
          if srcIx < 0 { ok = false }
          else if !assignable(srcIx, dtys[i]) { ok = false }
          i = i + 1
        }
        return ok
      }
      return false
    }
    TyArray => {
      if d is TyArray {
        // A view never satisfies a mutable list. The view exists to forbid the writes the
        // list spelling licenses, so admitting it here would launder every one of them.
        if sTail.aRead == 1 {
          if d.aRead == 0 { return false }
        }
        // An empty `[]` (element `-1`) is assignable to any array; otherwise the
        // element types must be assignable.
        return assignable(sTail.aElem, d.aElem)
      }
      return false
    }
    TyMap => {
      if d is TyMap {
        // A set and a map are distinct types, neither assignable to the other, and a set is
        // invariant in its element. A bare `Map()`/`Set()` (holes, `-1`) fits its own flavor.
        if sTail.mSet != d.mSet { return false }
        if d.mSet == 1 {
          return assignable(sTail.mKey, d.mKey)
            && assignable(d.mKey, sTail.mKey)
        }
        return assignable(sTail.mKey, d.mKey) && assignable(sTail.mVal, d.mVal)
      }
      return false
    }
    TyFunc => {
      if d is TyFunc {
        // A generic function value (hole params/return) is assignable to a concrete
        // function type only by instantiation — its body's capability must hold at the
        // target's param types and yield the target's return, not the structural rule
        // below, which a hole passes unconditionally.
        if fnTyHasHole(src) { return genericFnAssignable(src, dst) }
        const sp = sTail.fnParamTypes
        const dp = d.fnParamTypes
        if sp.length != dp.length { return false }
        let i = 0
        let ok = fnSlotAssignable(sTail.fnRet, d.fnRet)
        while i < sp.length {
          if !fnSlotAssignable(dp[i], sp[i]) { ok = false }
          i = i + 1
        }
        return ok
      }
      return false
    }
    TyErr => {
      // Claimed by `s is TyErr` at the top, which returns true.
    }
    TyVar => {
      // Claimed by `s is TyVar` at the top, which returns true.
    }
    TyNullable => {
      // Claimed by the nullable pair above: the `d is TyNullable` arm peels both
      // sides, and the bare `s is TyNullable` guard right after it returns false.
    }
    TyUnion => {
      // Claimed by the union-SOURCE arm above, which returns its `ok`.
    }
    TyLit => {
      // Claimed by the literal-SOURCE arm above, which returns on both legs.
    }
    TyNeg => {
      // Claimed by `s is TyNeg` above, which returns false.
    }
  }
  // Unreachable by construction: each empty arm is claimed by an earlier `s`-test that
  // returns, and the five real arms return on every leg.
  false
}

// ── per-kind helpers (take a narrowed variant; recurse back through checkNode) ──
// These helpers receive an already-narrowed `Node` variant as a struct parameter, narrow
// further children themselves, and call back into `checkNode` — a host miscompile once
// prohibited this shape, fixed and pinned by `union-two-visitors.vl`.

// `srcExpr < 0` (a dispatch probe with no argument node — a UFCS receiver, an operator
// operand) checks the type alone, so the literal-aware / rep-sidecar recording in
// `assignableExpr` is not driven by a node index it does not have.
function holeAssignOk(srcExpr: i32, at: i32, dst: i32) {
  if srcExpr < 0 { return assignable(at, dst) }
  assignableExpr(srcExpr, at, dst)
}

// The map demand `hm` as call argument `at` meets it: a value the body only ever wrote `null`
// to takes the argument's own nullable value type, so each call site fills `T` (D2506).
function holeMapNullValAt(hm: i32, at: i32): i32 {
  if at < 0 { return hm }
  const d = T.tys[hm]
  const a = T.tys[at]
  if d is TyMap {
    if !cnhIsOpen(d.mVal) { return hm }
    if a is TyMap {
      if a.mVal >= 0 && assignable(TY_NULL, a.mVal) {
        return mkMapTy(d.mKey, a.mVal, d.mSet)
      }
    }
  }
  hm
}

// An open map argument `at` delivered to a demand whose value the body only wrote `null` to
// takes an open `_ | null` of its own, which the caller's writes fill (D2506).
function holeMapArgNullPin(hm: i32, at: i32, srcExpr: i32) {
  if at < 0 { return 0 }
  const d = T.tys[hm]
  const a = T.tys[at]
  if d is TyMap {
    if !cnhIsOpen(d.mVal) { return 0 }
    if a is TyMap {
      if a.mVal < 0 {
        a.mVal = cnhPinTy(TY_NULL, srcExpr, srcExpr, true, false)
        tyMutEpoch = tyMutEpoch + 1 // the argument's value pinned in place
      }
    }
  }
  0
}

// Does `at` (the argument expression `srcExpr`) satisfy hole `name`'s demand? The
// accumulated shape satisfies it, and so does any `is`-guard alternative whose still-
// reachable demanded fields (`holeAltResidualTy`) are satisfied too. True when the hole demands nothing.
function holeDemandOk(name: string, srcExpr: i32, at: i32) {
  // A map demand is checked first, and it is a hard requirement, not one arm of a
  // disjunction: a hole the body used the map surface on is a map. Both pins run on the way
  // through: `constrainEmpty(at, hm)` pins an argument still open at the call; the reverse
  // pins a demand the callee left open from a concrete argument.
  let hm = holeMapOf(name)
  if hm >= 0 {
    holeMapArgNullPin(hm, at, srcExpr)
    hm = holeMapNullValAt(hm, at)
    if !holeAssignOk(srcExpr, at, hm) { return false }
    constrainEmpty(at, hm)
    // A demand the callee's own operations left open is not satisfiable here, and the
    // reason is order, not assignability: the body has already been checked against the
    // open type, so its recorded node types are stale, and pinning the demand now would
    // emit against those. Bidirectional inference (roadmap), not a pin — refuse instead.
    if holeMapDemandOpen(hm) { return false }
  }
  const shape = holeShapeOf(name)
  if shape < 0 { return true }
  if holeAssignOk(srcExpr, at, shape) { return true }
  // A `new`-branded argument satisfies a shape SYNTHESISED from its own field reads: the demand
  // is structural (member reads only build it), and a brand is erased at run time, so the
  // underlying structure is what the body actually reads. Retry against the erased base so the
  // nominal barrier does not refuse the very type that induced the demand (D1894).
  const atBase = nomErasedTyIx(at)
  if atBase != at {
    if holeAssignOk(srcExpr, atBase, shape) { return true }
  }
  let k = 0
  while k < holeAltNames.length {
    if holeAltNames[k] == name {
      if holeAssignOk(srcExpr, at, holeAltTys[k]) {
        const resid = holeAltResidualTy(shape, k)
        if resid < 0 { return true }
        if holeAssignOk(srcExpr, at, resid) { return true }
      }
    }
    k = k + 1
  }
  false
}

// The pin's own refusal: an un-annotated type parameter whose body writes the list cannot
// bind a view, and nothing downstream would say so — the body checked its write against a
// synthesized mutable list, never against this argument.
function holeArgViewErr(argN: i32, at: i32, ix: i32) {
  tErr(
    "argument "
      + i32ToStr(argN)
      + ": the body writes this list, and "
      + tyToStrUser(at)
      + " is a read-only view — pass the mutable list, or spell the parameter "
      + "`readonly T[]` so the body may only read it",
    ix,
  )
  0
}

// Reports a failed hole-argument demand — one home for the wording, shared by the general
// call path and the UFCS one. An open map demand gets its own sentence, since the generic
// `expected …, got …` would render the unpinned demand and read as a mismatch.
function holeArgDemandErr(name: string, argN: i32, at: i32, ix: i32) {
  const hmE = holeMapOf(name)
  if hmE >= 0 {
    if holeMapDemandOpen(hmE) {
      tErr(
        "argument "
          + i32ToStr(argN)
          + ": parameter is used as a map but nothing in the body pins its key or value"
          + " — add a type annotation",
        ix,
      )
      return 0
    }
  }
  tErr(
    "argument "
      + i32ToStr(argN)
      + ": expected "
      + holeDemandStr(name)
      + ", got "
      + tyToStr(at)
      + getterDemandNote(holeDemandTy(name), at),
    ix,
  )
  0
}

// Reports an argument an indexed hole cannot take — one home for the wording, shared by the
// general call path and the UFCS one. A map argument gets its own sentence: `q[i]` with an
// i32 index is ambiguous between an array and an i32-keyed map, so "expected an array"
// alone would send the reader to change the argument when the fix is to annotate the parameter.
function holeArgArrayErr(argN: i32, at: i32, ix: i32) {
  if at >= 0 {
    const t = T.tys[at]
    if t is TyMap {
      tErr(
        "argument "
          + i32ToStr(argN)
          + ": parameter is indexed with an i32, which is ambiguous between an array and"
          + " an i32-keyed map — add a type annotation",
        ix,
      )
      return 0
    }
  }
  tErr(
    "argument " + i32ToStr(argN) + ": expected an array, got " + tyToStr(at),
    ix,
  )
  0
}

// A template hole's delivery, decided by the hole's type. True when the call is finished
// with (the caller yields `string`), false to let the ordinary argument check run. `string`
// is delivered directly — the render call becomes a `Paren` around the hole, since the
// renderer doesn't take a string. Otherwise a hole-shaped refusal names the domain, read off the renderer, never hard-coded.
function tplHoleHandled(
  callIx: i32,
  callPos: i32,
  holeIx: i32,
  at: i32,
  expected: i32,
) {
  // A string-literal type or a union of them is a set of strings, delivered as one (D1485).
  // Not rewritten under a pinned re-check: the body is every instance's, and the emitter
  // delivers a string-pinned hole itself (`tplStrHoleOf`, D2241).
  if isStringTy(softenLitTy(at)) {
    if monoRecheckDepth == 0 {
      arenaReplaceNode(callIx, mkParen(holeIx, callPos))
    }
    return true
  }
  if at < 0 { return false }
  const t = T.tys[at]
  if t is TyErr { return false }
  if tyIsHole(at) { return false }
  // A gradual union is checked at its concrete members, and the pin re-asks the whole union
  // as it does a bare hole's (`argCstrFits`).
  const gv = tpGradualView(at)
  if gv != at {
    if isStringTy(softenLitTy(gv)) || tyIsHole(gv) || assignable(gv, expected) {
      noteArgCstr(at, expected, "", ACF_TPL, -1)
      return !tyIsHole(gv) && isStringTy(softenLitTy(gv))
    }
  }
  if assignable(at, expected) { return false }
  tErr(
    "an interpolation hole is `string` or "
      + tyToStr(expected)
      + " — this one is "
      + tyToStr(at),
    holeIx,
  )
  true
}

// Reports an `argument N: expected …, got …` mismatch — one home for the wording and the
// anchor policy, shared by the general call path and the UFCS one. The anchor is the
// argument node, not the call, whose closing-paren anchor is a whole call away. A
// function-literal argument anchors at its first value-bearing return site when only the return type offends; otherwise at the literal's start token.
function argMismatchErr(argN: i32, expected: i32, at: i32, argIx: i32) {
  const msg = "argument "
    + i32ToStr(argN)
    + ": expected "
    + tyToStr(expected)
    + ", got "
    + tyToStr(at)
    + charLitForStringNote(argIx, expected)
    + boolForNumberNote(at, expected)
    + numUnionLossNote(at, expected)
    + storageListNote(argIx, at, expected)
    + litMemberNote(argIx, expected, 8)
  if argIx >= 0 && argIx < P.nodes.length {
    const n = P.nodes[argIx]
    if n is FuncDecl {
      const site = fnLitRetMismatchSite(n, expected, at)
      if site >= 0 { return tErr(msg, site) }
      return tErr(msg, argIx)
    }
  }
  tErrWant(msg, argIx, expected)
}

// Whether `lit` is a literal type that literal-bearing `other` admits: `x == "b"` at a pin that
// holds `"b"` is the direct spelling's comparison, which softening the literal would refuse.
function eqLitMemberOk(lit: i32, other: i32): boolean {
  if lit < 0 || lit >= T.tys.length || !(T.tys[lit] is TyLit) { return false }
  if !isLitBearing(other) { return false }
  assignable(lit, other)
}

// Whether an equality between `a` and `b` sets a literal against a literal-bearing type that does
// not admit it, in either order: the closed-set comparison the direct spelling refuses.
function eqLitNonMember(a: i32, b: i32): boolean {
  if eqLitOutside(a, b) { return true }
  eqLitOutside(b, a)
}

// `eqLitNonMember` with the literal on the `lit` side.
function eqLitOutside(lit: i32, other: i32): boolean {
  if lit < 0 || lit >= T.tys.length || !(T.tys[lit] is TyLit) { return false }
  if !isLitBearing(other) { return false }
  !assignable(lit, other)
}

// Whether an accepted assignment of right side `rhs`, a `rt` value, into a place of type
// `placeTy` yields the place's type: the two are one type in another spelling (a union's member
// order), or `rhs` is a literal built at the place's type because a `rt` value could reach the
// place only through an adapter. Leaves the diagnostic's claimed pair as found.
function asgYieldsPlaceTy(rhs: i32, rt: i32, placeTy: i32): boolean {
  if rt < 0 || placeTy < 0 || rt == placeTy { return false }
  if tyHasHole(rt) || tyHasHole(placeTy) { return false }
  if T.tys[rt] is TyErr || T.tys[placeTy] is TyErr { return false }
  if assignable(rt, placeTy) && assignable(placeTy, rt) { return true }
  if !asgRhsBuiltAtPlace(rhs) { return false }
  const sT = shapeAdaptSrcTy
  const dT = shapeAdaptDstTy
  const sX = shapeAdaptSrcExpr
  const eP = shapeAdaptElemPair
  const wF = shapeAdaptWidthField
  const nC = shapeAdaptNulCopy
  const nN = shapeAdaptNestedCopy
  const mS = shapeAdaptMapShared
  const rF = shapeAdaptRecField
  const rS = shapeAdaptRecStorage
  const rN = shapeAdaptRecStorageField
  const r = objShapeAdapterlessAt(-1, rt, placeTy)
  shapeAdaptRecStorageSet(rS)
  shapeAdaptRecStorageFieldSet(rN)
  shapeAdaptSrcTySet(sT)
  shapeAdaptDstTySet(dT)
  shapeAdaptSrcExprSet(sX)
  shapeAdaptElemPairSet(eP)
  shapeAdaptWidthFieldSet(wF)
  shapeAdaptNulCopySet(nC)
  shapeAdaptNestedCopySet(nN)
  shapeAdaptMapSharedSet(mS)
  shapeAdaptRecFieldSet(rF)
  r
}

// The predicate that arm asks, in one home with a sharper consequence: the pin has to ask
// exactly what the body asked or it disagrees with the direct spelling in one of two ways.
// Asking the plain predicate where the arm asks the expression invents a false reject — the
// float-literal-into-f32 rule lives at the expression seam (D551).
function bmArgPred(form: i32, got: i32, want: i32, argIx: i32) {
  if form == BM_PUSH || form == BM_SETVAL || form == BM_KEYMUST {
    return assignableExpr(argIx, got, want)
  }
  if form == BM_SETKEY || form == BM_ADDKEY {
    // The expression form first: a MEMBER literal is a legal key of a literal-union-keyed
    // map or set, and its own type is the member, not the `string` `checkNode` hands back (D1748).
    if assignableExpr(argIx, got, want) { return true }
    return nomSlotAccepts(argIx, got, want)
  }
  assignable(got, want)
}

// The one gate every builtin argument arm asks. True when the position is accepted or
// deferred; false when it is a reject the arm reports with `bmArgMsg`. Deferring returns
// true since a body that already reported its own mismatch has a loud diagnostic, and a
// second one at every call site would repeat it in vaguer words.
function bmArgOk(
  form: i32,
  label: string,
  got: i32,
  want: i32,
  ctx: i32,
  argIx: i32,
) {
  if tyHasHole(got) || tyHasHole(want) {
    // A generic function stored as the value is instantiated there (D3112).
    if fvaAdapt(argIx, got, want) { return true }
    noteBmCstr(form, label, got, want, ctx, argIx)
    return true
  }
  bmArgPred(form, got, want, argIx)
}

// The member arm's own sentence, for a receiver type that is not a hole: "" when
// `recv.prop` is a legal read (or deferred), otherwise the exact words `checkMemberNode`
// raises. Mirrors that arm arm-for-arm, in its order — load-bearing, since the pin's whole
// soundness argument is that it refuses only what the direct spelling already refuses.
function memberFloorMsg(objTy: i32, prop: string) {
  if objTy < 0 { return "" }
  const ot = T.tys[objTy]
  if ot is TyObj {
    if objFieldType(ot, prop) >= 0 { return "" }
    return "no field '" + prop + "' on " + tyToStr(objTy)
  }
  if ot is TyErr { return "" }
  if ot is TyUnion {
    if sharedUnionFieldTy(ot, prop) >= 0 { return "" }
    if prop == "length" && tyIsLitUnion(objTy) { return "" }
    return "field '"
      + prop
      + "' is not on every member of "
      + tyToStr(objTy)
      + " — narrow with `is` first"
      + unionFieldGapNote(ot, prop)
  }
  if ot is TyArray {
    if prop == "length" { return "" }
    return "no field '"
      + prop
      + "' on array "
      + tyToStr(objTy)
      + lengthSpellNote(prop)
  }
  if ot is TyMap {
    if prop == "length" { return "" }
    if ot.mSet == 1 {
      return "no field '"
        + prop
        + "' on set "
        + tyToStr(objTy)
        + lengthSpellNote(prop)
    }
    return "no field '"
      + prop
      + "' on map "
      + tyToStr(objTy)
      + lengthSpellNote(prop)
  }
  if ot is TyPrim {
    if ot.primName == "string" {
      if prop == "length" { return "" }
      return "no field '" + prop + "' on string" + lengthSpellNote(prop)
    }
  }
  if ot is TyVar { return tpMemberFloorMsg(ot.tvName, prop) }
  // The receiver is a scalar, so `.toString`/`.toStr` on it is almost certainly the
  // migration, not a typo — `stdFmtMovedNote` says which import brings the name back.
  // Deliberately only on this arm: a struct missing a `.toString` field is a different mistake.
  "member access '."
    + prop
    + "' on non-object "
    + tyToStr(objTy)
    + stdFmtMovedNote(prop)
}

// Raises the undeclared-name error at `ix` naming the modules that export `name`, under
// `missing-import`; false, raising nothing, when no module of the program or of std does.
function undeclaredImportRaise(name: string, ix: i32): boolean {
  const from = ufcsModOfNode(ix)
  const specs = mimpSpecsFor(name, from, -1)
  // No program module answered: a file the program does not import yet may, beside std.
  if !mimpAnyProgramSpec(specs) { mimpNoteMiss(name) }
  if specs.length == 0 { return false }
  let data = diagDataField("member", name)
  for s in specs { data = data + diagDataField("modules", s) }
  tErrCodedData(
    "undeclared identifier '" + name + "'" + mimpExportedByNote(name, specs, from),
    ix,
    CODE_MISSING_IMPORT,
    data,
  )
  true
}

// Raises the member arm's sentence at node `ix` — `memberFloorMsg`'s words, unless the call
// site banked a missing-import answer for this node, in which case D1230's sentence and its
// `ufcs-not-imported` code replace them. One home for the raise, since `checkMemberNode`
// refuses from seven arms and a per-arm enrichment would silently miss most of them.
function memberFloorErr(objTy: i32, prop: string, ix: i32) {
  // A method lookup over a receiver built from an error already reported is that error's
  // cascade: its instance differs from the method's only by the error. A missing FIELD is not,
  // so the floor below still raises for one.
  const cascade = tyMentionsErr(objTy, 8)
  const specs = ufcsMissSpecsAt(ix)
  if specs != "" {
    if cascade { return 0 }
    const alias = ufcsImportAliasAt(ix, prop, objTy)
    return tErrCodedData(
      ufcsNotImportedMsg(prop, specs, objTy, alias),
      ix,
      CODE_UFCS_NOT_IMPORTED,
      ufcsNotImportedData(prop, specs, objTy, alias),
    )
  }
  // The name is a function in scope that is not a method. Second, so D1230 keeps winning
  // wherever it applies: a name not in scope at all cannot reach this bank (D1570).
  const whyRow = ufcsWhyRow(ix)
  if whyRow >= 0 {
    if cascade { return 0 }
    return tErrCodedData(
      ufcsWhyMsg[whyRow],
      ix,
      CODE_UFCS_NOT_METHOD,
      ufcsWhyData[whyRow],
    )
  }
  // Never raise a wordless diagnostic. `memberFloorMsg`'s "" means "this read is fine or
  // is deferred" — a sentinel its two constraint-pin callers test, and this one, the only
  // one that raises, formatted unconditionally. A rung that answered "" while its own arm
  // went on to refuse printed nothing but a caret (D1004, D1221).
  const msg = memberFloorMsg(objTy, prop)
  if msg == "" {
    return tErr("member access '." + prop + "' on " + tyToStr(objTy), ix)
  }
  tErr(
    msg
      + unkeyedSubscriptNote(ix)
      + getterNarrowNote(objTy, ix)
      + builtinMethodNote(objTy, prop, ix),
    ix,
  )
}

// D1230 at member node `memIx`, else D1570 at call node `ix`, for `recv.prop(argc args)`; false
// when neither applies. For the string and array arms, which answer before the general one, so
// `memberFloorErr` never sees their calls. D1230 spans the property, as the quick-fix reads it.
function ufcsMissRaise(
  prop: string,
  recvTy: i32,
  argc: i32,
  ix: i32,
  memIx: i32,
): boolean {
  if tyMentionsErr(recvTy, 8) { return true }
  const specs = ufcsMissingImportSpecs(prop, recvTy, argc, ix)
  if specs != "" {
    const alias = ufcsImportAliasAt(ix, prop, recvTy)
    tErrCodedData(
      ufcsNotImportedMsg(prop, specs, recvTy, alias),
      memIx,
      CODE_UFCS_NOT_IMPORTED,
      ufcsNotImportedData(prop, specs, recvTy, alias),
    )
    return true
  }
  const name = ufcsSiteFn(ix, prop)
  const kind = ufcsNotMethodKind(name, recvTy, argc)
  if kind != 0 {
    tErrCodedData(
      ufcsNotMethodMsg(prop, name, recvTy, argc, kind),
      ix,
      CODE_UFCS_NOT_METHOD,
      ufcsNotMethodData(prop, name, recvTy, kind),
    )
    return true
  }
  false
}

// D1570's gate classifier — which arm of the UFCS rule refused `recv.prop(argc args)`, given
// that `prop` names a function in scope. 0 = no answer, 1 = the `self`-name rule, 2 = the
// arity range, 3 = the receiver type. Mirrors `ufcsWouldDispatch` arm for arm, and stops
// where that one stops, since this runs on a call that has already failed.
function ufcsNotMethodKind(name: string, recvTy: i32, argc: i32) {
  if (fnDeclIx[name] ?? -1) < 0 { return 0 }
  const fnTy = lookup(name)
  if fnTy < 0 { return 0 }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    const params = ft.fnParamTypes
    if params.length < 1 { return 1 }
    if !declFirstParamIsSelf(name) { return 1 }
    const uDecl = declParamsAfterSelf(name)
    let uRequired = params.length - 1
    if uDecl.length == params.length - 1 { uRequired = fnRequiredArity(uDecl) }
    if argc < uRequired || argc + 1 > params.length { return 2 }
    if !assignable(recvTy, params[0]) { return 3 }
    return 0
  }
  0
}

// Records `memberFloorErr`'s answer, computed here because only the call site knows `argc`.
// No-ops when no gate claims the call — every member access that is really a missing field
// must stay untouched.
function noteUfcsNotMethod(
  memIx: i32,
  prop: string,
  name: string,
  recvTy: i32,
  argc: i32,
) {
  let nm = name
  if (fnDeclIx[nm] ?? -1) < 0 { nm = mergedDeclKeyOf(prop) }
  const kind = ufcsNotMethodKind(nm, recvTy, argc)
  if kind == 0 { return 0 }
  noteUfcsWhy(
    memIx,
    ufcsNotMethodMsg(prop, nm, recvTy, argc, kind),
    ufcsNotMethodData(prop, nm, recvTy, kind),
  )
}

// The index arm's own sentence: "" when `recv[i]` resolves or defers, otherwise
// `checkIndexNode`'s `cannot index non-array …`. The write-only operator case also answers
// "" rather than borrow that arm's sentence — its diagnostic names a missing declaration,
// not this receiver, and repeating it at a call site the reader never wrote it at would mislead.
function indexFloorMsg(arrTy: i32) {
  if arrTy < 0 { return "" }
  if tyBuiltinIndexable(arrTy) { return "" }
  if opIdxDeclared() {
    if opIdxFnFor(OP_INDEX_GET, arrTy) != "" { return "" }
    if opIdxFnFor(OP_INDEX_SET, arrTy) != "" { return "" }
  }
  const at = T.tys[arrTy]
  if at is TyObj {
    // The index trap: gated exactly as the arm gates it — a `"[]"` field of any shape
    // other than a one-parameter function falls through there and must fall through here too.
    const trap = objFieldType(at, OP_INDEX_GET)
    if trap >= 0 {
      const tt = T.tys[trap]
      if tt is TyFunc {
        if tt.fnParamTypes.length == 1 { return "" }
      }
    }
  }
  "cannot index non-array " + tyToStr(arrTy)
}

// `memberFloorMsg` / `indexFloorMsg` in one call, keyed the way the table stores the
// operation: `OP_INDEX_GET` is the index form, anything else is that member name.
export function memCstrMsg(recv: i32, prop: string) {
  if prop == OP_INDEX_GET { return indexFloorMsg(recv) }
  if prop == OP_CALL_PIN { return callFloorMsg(recv) }
  if prop == OP_CALL_GUARDED_PIN {
    if isNullTy(recv) { return "" }
    return callFloorMsg(recv)
  }
  if keyHasPrefix(prop, MC_NULL_READ_MARK) {
    if !tyAdmitsNull(recv) { return "" }
    const nrProp = prop.slice(MC_NULL_READ_MARK.length, prop.length)
    if nrProp == OP_INDEX_GET { return indexFloorMsg(recv) }
    return memberFloorMsg(recv, nrProp)
  }
  if keyHasPrefix(prop, MC_METHOD_MARK) {
    const name = prop.slice(MC_METHOD_MARK.length, prop.length)
    if builtinMethodClaims(recv, name) { return "" }
    return "no method '." + name + "' on " + tyToStr(recv)
  }
  memberFloorMsg(recv, prop)
}

// Whether an object left operand has an operator dispatch for `op` (a free `self`-function
// named for the operator, or an operator field), asked from types alone since `opSelfFnTy`
// needs the right operand's node and can report diagnostics. Deliberately the weaker
// question: a false true costs nothing extra, a false false rejects a program that runs.
function objOpDispatchTy(op: string, lt: i32) {
  const ot = T.tys[lt]
  if ot is TyObj {
    if objFieldType(ot, op) >= 0 { return true }
  } else {
    return false
  }
  objOpSelfFnRetTy(op, lt) >= 0
}

// `checkBinary`'s dispatch arm as a type question: does `lt op …` resolve to a free
// `self`-function overload, and to what result type (-1 = no dispatch)? The `is TyObj` gate
// is load-bearing since a non-object receiver takes the language's own lowering and consults
// no declaration. Shared by `binOpDefinedFor`'s pin gate and `substHoleTy`'s `HD_BINOP` result, which must agree.
function objOpSelfDispatchTy(op: string, lt: i32) {
  const ot = T.tys[lt]
  if !(ot is TyObj) { return -1 }
  objOpSelfFnRetTy(op, lt)
}

// The self-function half of `objOpDispatchTy`, answering with the overload's return type
// (-1 = no dispatch) instead of a boolean. `objOpDispatchTy` also admits the operator-field
// route since a false true there is free; this one must not, because `monoPinBinOps` only
// rewrites through `drwSelfFnOf(op, 2)` and has no struct-table row for a field closure.
function objOpSelfFnRetTy(op: string, lt: i32) {
  // Receiver-directed, the same scan `opSelfFnTy` uses: the declaration whose `self` accepts
  // `lt`, keyed on `(symbol, receiver)` so each receiver type's operator resolves on its own.
  const opKey = opSelfFnKeyFor(op, lt)
  if opKey == "" { return -1 }
  const fnTy = lookup(opKey)
  if fnTy < 0 { return -1 }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    if ft.fnParamTypes.length != 2 { return -1 }
    const dIx = fnDeclIx[opKey] ?? -1
    if dIx < 0 { return -1 }
    const d = P.nodes[dIx]
    if d is FuncDecl {
      if d.fnParams.length == 2 {
        const p0 = P.nodes[d.fnParams[0]]
        if p0 is Param {
          if p0.parName == "self" {
            if assignable(lt, ft.fnParamTypes[0]) { return ft.fnRet }
          }
        }
      }
    }
  }
  -1
}

// Whether the emitter can lower `lt op rt` for two concrete operand types — the soundness
// criterion a generic call site checks after substituting a hole to its argument type. A
// still-unresolved operand defers (true — the outer call validates it). Mirrors
// `checkBinary`'s accepted forms and its arm order; operators not modelled here return true.
function binOpDefinedFor(op: string, lt0: i32, rt0: i32) {
  // A two-width literal set is not softened at a pin: its `i64` result is no `T` (D3524).
  const lt = softenLitTy(lt0)
  const rt = softenLitTy(rt0)
  if tyHasHole(lt) || tyHasHole(rt) { return true }
  if op == "min" || op == "max" || op == "abs" { return minMaxPinOk(lt, rt) }
  if op == OP_NEG { return isNumeric(lt) || tyIsNumUnion(lt) }
  if op == OP_BNOT { return isNumeric(lt) && !binFloatOperandPair(lt, lt) }
  if op == OP_AS { return asPinHolds(lt0, rt0) || numUnionAsConverts(lt0, rt0) }
  if op == OP_LITFIT { return primNameOf(lt) != "i32" }
  // A numeric union operand dispatches per member, each pair a scalar one (`numUnionBinTy`).
  if (
    numUnionOp(op)
    && (tyIsNumUnion(lt) || tyIsNumUnion(rt))
    && !nullTestOp(op, lt, rt)
  ) {
    return numUnionPinOk(op, lt, rt)
  }
  // The nominal-brand mix the BODY deferred on a hole operand (D1747). Both operands are
  // concrete here, which is the precondition that question needs; only a branded PAIR is
  // judged, since a pin has no expression node for `nomBinMixes`'s literal-adoption legs.
  if op != "??" {
    const bl = nomNameOfTy(lt0)
    const br = nomNameOfTy(rt0)
    if bl != "" && br != "" && bl != br { return false }
  }
  if op == "==" || op == "!=" {
    // Mutual compatibility (no cross-type equality) with two exemptions: a nullness test
    // defers to `checkBinary`'s null arms, and a nominal brand is erased before comparing.
    if isNullTy(lt) || isNullTy(rt) { return true }
    const eqL = nomErasedTyIx(lt)
    const eqR = nomErasedTyIx(rt)
    // The written pair too, as `checkBinary` asks it: `K | i32` beside `K` softens one side only.
    const eqL0 = nomErasedTyIx(lt0)
    const eqR0 = nomErasedTyIx(rt0)
    if (
      !assignable(eqL, eqR)
      && !assignable(eqR, eqL)
      && !assignable(eqL0, eqR0)
      && !assignable(eqR0, eqL0)
    ) {
      return false
    }
    // Pinned equality is held to the same two gates as the direct spelling — inside a
    // generic body `T` looks equatable (a `TyVar` is opaque) with nobody left to ask (D35).
    const pinMsgs: string[] = []
    const pinChan: i32[] = []
    eqRefusals(op, lt, rt, true, pinMsgs, pinChan)
    return pinMsgs.length == 0
  }
  // The object-dispatch gate, positioned exactly where `checkBinary`'s own arm order
  // puts it — self-function overloads only; the operator-field route is `objOpDispatchTy`'s.
  if objOpSelfDispatchTy(op, lt0) >= 0 { return true }
  if op == "+" {
    // The unsoftened pair on purpose: `checkBinary`'s `+` arm concatenates strings and lists
    // before the arithmetic tail softens, and mirroring that order matters for what it accepts.
    // Its gate is ONE operand concatenating AS a string plus mutual assignability, not both
    // being the prim — the narrower reading refused at the pin what the direct spelling takes.
    if concatsAsStr(lt0) || concatsAsStr(rt0) {
      if assignable(lt0, TY_STR) && assignable(rt0, TY_STR) {
        return true // string concat
      }
    }
    // `checkBinary`'s newtype leg, the branch this mirror did not copy: a `new string` brand
    // concatenates with a same-brand value or a literal and keeps the brand (D1747).
    if nomNameOfTy(lt0) != "" || nomNameOfTy(rt0) != "" {
      if assignable(nomBaseTyIx(lt0), TY_STR) {
        if assignable(nomBaseTyIx(rt0), TY_STR) { return true }
      }
    }
    const lArr0 = T.tys[lt0]
    if lArr0 is TyArray {
      const rArr0 = T.tys[rt0]
      if rArr0 is TyArray {
        // Element agreement is `checkBinary`'s to report; lowering does not depend on
        // element type at all, so every list pair the direct spelling admits lowers here too.
        return true
      }
    }
    return isNumeric(lt) && isNumeric(rt)
  }
  if op == "-" || op == "*" || op == "/" {
    return isNumeric(lt) && isNumeric(rt)
  }
  if op == "%" {
    // `%` shares the arithmetic rule rather than the integer-only one below so it still
    // reaches the operator-field dispatch route `checkBinary` checks before any numeric rule.
    if objOpDispatchTy(op, lt) { return true }
    return isNumeric(lt) && isNumeric(rt)
  }
  if binIntOnlyOp(op) {
    // Mirrors `checkBinary`'s arm order, not just its predicates: the object-dispatch defer
    // above must run first, or an object receiver with a real dispatch is falsely rejected here.
    if objOpDispatchTy(op, lt) { return true }
    if !isNumeric(lt) || !isNumeric(rt) { return false }
    return !binFloatOperandPair(lt, rt)
  }
  if op == "<" || op == ">" || op == "<=" || op == ">=" {
    if isStringTy(lt) && isStringTy(rt) { return true }
    return isNumeric(lt) && isNumeric(rt)
  }
  true
}

// Whether a resolved argument demand holds: `rat` fits `rexp`, or the demand is a template
// hole's and `rat` is a string, which the hole delivers without its renderer. A hole callee's
// argument with no origin node is held to the scalar rule alone: its type cannot say literal.
function argCstrFits(rat: i32, rexp: i32, form: i32) {
  if form == ACF_TPL && isStringTy(softenLitTy(rat)) { return true }
  if form > 0 { return !holeArgScalarRefused(rat, rexp) }
  // Decided by its node at the pin (`validateCompArgCstr`); a type alone would refuse a literal.
  if form == ACF_COMP { return true }
  assignable(rat, rexp)
}

// `argCstrFits` for demand `ci` at a pin that knows its argument nodes: a hole callee's scalar
// argument whose origin node is known is asked the direct call's own question of that node, so
// a literal adopts the parameter's width and a `boolean` literal is refused as it is directly.
function argCstrFitsAt(
  rat: i32,
  rexp: i32,
  ci: i32,
  hNames: string[],
  hArgNode: i32[],
) {
  const form = argCstr.form[ci]
  if form <= 0 { return argCstrFits(rat, rexp, form) }
  const org = holeArgOriginNode(ci, hNames, hArgNode)
  if org < 0 || !scalarPrimPair(rat, rexp) {
    return argCstrFits(rat, rexp, form)
  }
  const savedQuiet = inferQuiet
  if prbArmed { prbEnter() }
  inferQuiet = true
  const ok = assignableExpr(org, rat, rexp)
  inferQuiet = savedQuiet
  if prbArmed { prbLeave("argCstrFitsAt") }
  ok
}

// Re-validates every deferred `print` constraint this call resolves, holding the substituted
// type to the same two floors the direct spelling is held to. A type still touching an
// unresolved hole is re-recorded under the caller's hole and defers. The diagnostic is the
// direct spelling's, verbatim, reported at the call — the only position that knows the instance.
function validatePrintCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
) {
  const nOrigP = printCstr.ty.length
  const cvWas = cvNow
  let ci = 0
  while ci < nOrigP {
    if (
      cstrOwnedBy(printCstr.fn[ci], calleeFn)
      && !nestCstrOutside(printCstr.ix[ci])
    ) {
      cvNow = cvPick(CV_PRINT, ci, cvWas)
      const cpt = substTyDeep(printCstr.ty[ci], bNames, bTys)
      if (
        calleeFn >= 0
        || substNestMode == SUBST_NESTED
        || substNestMode == SUBST_HOLES
      ) {
        if cpt != printCstr.ty[ci] {
          if tyHasHole(cpt) { notePrintCstr(cpt, printCstr.ix[ci]) }
        }
      }
      if !tyHasHole(cpt) {
        // The two floors use different channels: a domain rejection (`tErr`, checked first,
        // as at the direct site) versus a capability reject for a union the emitter can't classify.
        let pMsg = ""
        let pUnsup = false
        if tyPrintsAsRef(cpt, 24) {
          pMsg = printRefRefusal(cpt)
        } else {
          pMsg = printUnionRefusal(cpt)
          if pMsg != "" { pUnsup = true }
        }
        if pMsg != "" {
          let pWho = "a type parameter is printed here: "
          if who != "" {
            pWho = "`" + who + "` prints its type parameter here: "
          }
          if pUnsup {
            tErrUnsupported(pWho + pMsg, ix)
          } else {
            tErr(pWho + pMsg, ix)
          }
        }
      }
    }
    ci = ci + 1
  }
  cvNow = cvWas
  0
}

// Solves every un-annotated parameter of top-level function `fnIx` from its body's usage:
// probes the body once (diagnostics and symbols suppressed) and records the first concrete
// destination per parameter. Top-level only, from pass 1.8 — a statement carries no
// contextual callback type, so the probe's answer is independent of source order.
function solveUnannotParams(fnIx: i32) {
  if paramSolveProbe { return 0 }
  const key = i32ToStr(fnIx)
  if paramSolveTried[key] ?? false { return 0 }
  const fd = P.nodes[fnIx]
  if fd is FuncDecl {
    const ps = fd.fnParams
    let anyHole = false
    let pi = 0
    while pi < ps.length {
      const pn = P.nodes[ps[pi]]
      if pn is Param {
        if pn.parType < 0 {
          if (solvedParamTys[paramHoleName(fd.fnName, fnIx, pi)] ?? -1) < 0 {
            anyHole = true
          }
        }
      }
      pi = pi + 1
    }
    if !anyHole { return 0 }
    paramSolveTried[key] = true
    if prbArmed { prbEnter() }
    // Rolls back every table the probe's body records except what it reads first (holeFlow);
    // the real pass re-records the rest. A kept `dJoin` row, keyed by call node, would block
    // the real pass from re-parking its reject.
    const m = checkMark()
    const savedSym = symEnabled
    const savedQuiet = inferQuiet
    symEnabled = 0
    inferQuiet = true
    paramSolveProbeSet(true)
    expObsBegin(fd, fnIx)
    checkFuncDeclNode(fd, fnIx)
    expObsFnSet(-1)
    paramSolveProbeSet(false)
    inferQuiet = savedQuiet
    symEnabled = savedSym
    let fi = m.holeFlow
    while fi < holeFlowSrc.length {
      const st = T.tys[holeFlowSrc[fi]]
      if st is TyVar {
        if (solvedParamTys[st.tvName] ?? -1) < 0 {
          if holeNameIsParamOf(st.tvName, fd.fnName, fnIx, ps.length) {
            solvedParamTysSetAt(st.tvName, holeFlowDst[fi])
          }
        }
      }
      fi = fi + 1
    }
    checkRollback(m, RB_SOLVE)
    if prbArmed { prbLeave("solveUnannotParams") }
    // Patches the hoisted `TyFunc` in place, gated on this node being the registered
    // top-level declaration — a nested namesake is not hoisted and would corrupt it.
    if fd.fnName != "" && (fnDeclIx[fd.fnName] ?? -1) == fnIx {
      const bound = lookup(fd.fnName)
      if bound >= 0 {
        const bt = T.tys[bound]
        if bt is TyFunc {
          const bpt = bt.fnParamTypes
          let k = 0
          while k < ps.length {
            if k < bpt.length {
              const sv = solvedParamTys[paramHoleName(fd.fnName, fnIx, k)] ?? -1
              if sv >= 0 {
                bpt[k] = sv
                tyMutEpoch = tyMutEpoch + 1 // solved parameter patched in place
              }
            }
            k = k + 1
          }
        }
      }
    }
  }
  0
}

// Re-validates every escaped join inside the body `calleeFn` instantiates; a join at module
// scope names holes no later call binds. One that re-folds to a single type collapsed
// faithfully; one that re-folds to a genuine multi-member union did not, and rejects at the
// inner call, naming both the callee and the union its arms resolve to.
function validateEscJoins(bNames: string[], bTys: i32[], calleeFn: i32) {
  let ci = 0
  while ci < escJoinTy.length {
    if escJoinFn[ci] < 0 || !cstrOwnedBy(escJoinFn[ci], calleeFn) {
      ci = ci + 1
      continue
    }
    const rj = substTyDeep(escJoinTy[ci], bNames, bTys)
    if rj != escJoinTy[ci] && !tyIsHole(rj) && !tyIsDeferredJoin(rj) {
      const rt = T.tys[rj]
      if rt is TyUnion {
        if rt.uMembers.length > 1 {
          let who = escJoinWho[ci]
          if who == "" { who = "a call" } else { who = "`" + who + "`" }
          tErrUnsupported(
            "the returns of "
              + who
              + " join to "
              + tyToStr(rj)
              + " for this argument — type-valid, but an inferred union return through an"
              + " un-annotated parameter is not yet supported by codegen; annotate the return type",
            escJoinIx[ci],
          )
        }
      }
    }
    ci = ci + 1
  }
  0
}

// A composite argument demand at the pin that closes it: its node is asked the direct call's
// question under the pin's bindings. One still open is left, not moved out to every caller,
// so a generic chain pays for it once per pin rather than once per hop.
function validateCompArgCstr(
  ci: i32,
  rat: i32,
  rexp: i32,
  bNames: string[],
  bTys: i32[],
  ix: i32,
) {
  if tyHasHole(rexp) || tyHasHole(rat) { return 0 }
  const savedQuiet = inferQuiet
  if prbArmed { prbEnter() }
  inferQuiet = true
  const ok = litPinAssignable(argCstr.node[ci], rat, rexp, bNames, bTys)
  inferQuiet = savedQuiet
  if prbArmed { prbLeave("validateCompArgCstr") }
  if ok { return 0 }
  argFlowErr(rat, rexp, ci, ix)
}

// Raises demand `ci`'s refusal at call `ix`, in the direct spelling's words: a template
// hole's is `tplHoleHandled`'s sentence, any other names the callee.
function argCstrErr(rat: i32, rexp: i32, ci: i32, ix: i32) {
  if argCstr.form[ci] > 0 {
    let callee = "a function value"
    if argCstr.who[ci] != "" { callee = "`" + argCstr.who[ci] + "`" }
    return tErr(
      "argument "
        + i32ToStr(argCstr.form[ci])
        + ": expected "
        + tyToStr(rexp)
        + ", got "
        + tyToStr(rat)
        + boolForNumberNote(rat, rexp)
        + " (the call of "
        + callee
        + " at the call's argument types)",
      ix,
    )
  }
  if argCstr.form[ci] == ACF_INDEX {
    return tErr(
      "array index must be i32, got "
        + tyToStr(rat)
        + " (the call's argument types)",
      ix,
    )
  }
  if argCstr.form[ci] == ACF_TPL {
    return tErr(
      "an interpolation hole is `string` or "
        + tyToStr(rexp)
        + " — this one is "
        + tyToStr(rat),
      ix,
    )
  }
  argFlowErr(rat, rexp, ci, ix)
}

// The refusal of demand `ci`'s argument `rat` flowing into a parameter `rexp`, naming the
// conversion when the direct spelling would.
function argFlowErr(rat: i32, rexp: i32, ci: i32, ix: i32) {
  let who = argCstr.who[ci]
  if who == "" { who = "a call" } else { who = "`" + who + "`" }
  tErr(
    "argument of type "
      + tyToStr(rat)
      + " flows into "
      + who
      + " expecting "
      + tyToStr(rexp)
      + boolForNumberNote(rat, rexp)
      + " (the call's argument types)",
    ix,
  )
}

// Re-validates every deferred call-argument constraint this call's callee owns
// (`cstrOwnedBy`), substituting the hole to the call's argument type. A hole that substitutes
// to another hole is re-recorded under it for the outer call that pins it, and only where the
// callee is named, as `validateBinCstrs` does.
function validateArgCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  hNames: string[],
  hArgNode: i32[],
) {
  const nOrig = argCstr.at.length
  const cvWas = cvNow
  let ci = 0
  while ci < nOrig {
    if !cstrOwnedBy(argCstr.fn[ci], calleeFn) {
      ci = ci + 1
      continue
    }
    cvNow = cvPick(CV_ARG, ci, cvWas)
    const rat = substTyDeep(argCstr.at[ci], bNames, bTys)
    const rexp = substTyDeep(argCstr.exp[ci], bNames, bTys)
    if argCstr.form[ci] == ACF_COMP {
      validateCompArgCstr(ci, rat, rexp, bNames, bTys, ix)
      ci = ci + 1
      continue
    }
    if rat != argCstr.at[ci] && calleeFn >= 0 {
      if tyIsHole(rat) || tyIsDeferredJoin(rat) {
        if !tyIsHole(rexp) {
          noteArgCstr(rat, rexp, argCstr.who[ci], argCstr.form[ci], -1)
        }
      }
    }
    // A hole callee's parameter still unpinned here moves out to the caller's hole with its
    // argument, whichever side this call resolved.
    if calleeFn >= 0 && argCstr.form[ci] > 0 && hdKindIs(rexp, HD_PARAM) {
      if rat != argCstr.at[ci] || rexp != argCstr.exp[ci] {
        let mvNode = -1
        if !tyIsHole(rat) { mvNode = holeArgOriginNode(ci, hNames, hArgNode) }
        noteArgCstr(rat, rexp, argCstr.who[ci], argCstr.form[ci], mvNode)
      }
    }
    // A side still carrying a hole — bare, or as a deferred-join arm — is undecided at this
    // site and defers to the call that pins it.
    if !tyIsHole(rat) && !tyIsDeferredJoin(rat) {
      if !tyIsHole(rexp) && !tyIsDeferredJoin(rexp) {
        if !argCstrFitsAt(rat, rexp, ci, hNames, hArgNode) {
          argCstrErr(rat, rexp, ci, ix)
        }
      }
    }
    ci = ci + 1
  }
  cvNow = cvWas
  0
}

// Whether a return-type mismatch is nominal-only, at a destination the author has no syntax
// to spell: the hole sits on the declared side alone (`wOnly`), the destination is a newtype
// brand, and the body type already fits the brand's unbranded base — the repair would be `x
// as A`, which the language has no form for (`wOnly` is what keeps a body-side hole under a concrete declaration a loud reject, D551).
function retNomOnlyAtHole(wOnly: i32, ix: i32, rg: i32, rw: i32) {
  if wOnly != 1 { return false }
  if !tyIsNewtypeBrand(rw) { return false }
  const b = nomBaseTyIx(rw)
  if b < 0 { return false }
  if b == rw { return false }
  assignableExpr(ix, rg, b)
}

// `assignableExpr` with the pin's bindings staged for a literal's elements (`litElemSrcTy`).
function litPinAssignable(
  ix: i32,
  src: i32,
  dst: i32,
  bNames: string[],
  bTys: i32[],
): boolean {
  const sN = litPinN
  const sT = litPinT
  litPinNSet(bNames)
  litPinTSet(bTys)
  const ok = assignableExpr(ix, src, dst) || joinLitsFitAt(ix, dst)
  litPinNSet(sN)
  litPinTSet(sT)
  ok
}

// Whether `ix` is an `if` or `match` every value of which is a string literal fitting `dst`: the direct
// spelling types such a join at its destination (`litJoinOf`), which a generic body cannot (D3423).
function joinLitsFitAt(ix: i32, dst: i32): boolean {
  if dst < 0 || dst >= T.tys.length || tyHasTyVar(dst) || tyHasNullMember(dst) {
    return false
  }
  const p = parenPeelIx(ix)
  if p < 0 || p >= P.nodes.length { return false }
  if !(P.nodes[p] is IfStmt || P.nodes[p] is MatchExpr) { return false }
  const todo: i32[] = [p]
  let guard = 0
  while todo.length > 0 {
    guard = guard + 1
    if guard > 64 { return false }
    const at = parenPeelIx(todo.pop() ?? -1)
    if at < 0 || at >= P.nodes.length { return false }
    if !tailPushIfArms(at, todo) && !tailPushMatchArms(at, todo) {
      if !tailPushBlockTail(at, todo) {
        if !(P.nodes[at] is StrLit) { return false }
        const lt = litTyOfExpr(at)
        if lt < 0 || !assignable(lt, dst) { return false }
      }
    }
  }
  true
}

// Re-validates every deferred return-type constraint this call resolves: substitutes the
// call's bindings into the body's returned type and the declared return type, and asks the
// mismatch question the body could only answer vacuously. Re-defers like `validateArgCstrs`
// when a hole substitutes to another hole; the message is the direct spelling's, verbatim.
function validateRetCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
) {
  const nOrigR = retCstr.got.length
  const cvWas = cvNow
  let ci = 0
  while ci < nOrigR {
    if (
      cstrOwnedBy(retCstr.fn[ci], calleeFn)
      && !nestCstrOutside(retCstr.ix[ci])
    ) {
      cvNow = cvPick(CV_RET, ci, cvWas)
      const rg = substTyDeep(retCstr.got[ci], bNames, bTys)
      const rw = substTyDeep(retCstr.want[ci], bNames, bTys)
      // Re-records only when the callee is named — an unnamed call cannot reassign ownership
      // — and gates on either side still holding a hole, not just the body side.
      if (
        calleeFn >= 0
        || substNestMode == SUBST_NESTED
        || substNestMode == SUBST_HOLES
      ) {
        if rg != retCstr.got[ci] || rw != retCstr.want[ci] {
          if tyHasHole(rg) || tyHasHole(rw) {
            noteRetCstr(rg, rw, retCstr.ix[ci])
          }
        }
      }
      if !tyHasHole(rg) {
        if (
          !tyHasHole(rw)
          && !retNomOnlyAtHole(retCstr.wOnly[ci], retCstr.ix[ci], rg, rw)
        ) {
          if !litPinAssignable(retCstr.ix[ci], rg, rw, bNames, bTys) {
            let rWho = "the callee's return"
            if who != "" { rWho = "the return of `" + who + "`" }
            tErr(
              "return type mismatch: expected "
                + tyToStr(rw)
                + ", got "
                + tyToStr(rg)
                + boolForNumberNote(rg, rw)
                + " ("
                + rWho
                + " at the call's argument types)",
              ix,
            )
          }
        }
      }
    }
    ci = ci + 1
  }
  cvNow = cvWas
  0
}

// Whether the deferred destination constraints this binding resolves hold — the twin of
// `validateRetCstrs` for a `let`/`const` binding rather than a return (D572 is why the two
// need separate tables). Same re-deferral rule; the message is `letAssignMsg`'s, verbatim,
// with the attribution appended since the reader wrote no assignment.
function validateLetCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
) {
  const nOrigL = letCstr.got.length
  const cvWas = cvNow
  let ci = 0
  while ci < nOrigL {
    if (
      cstrOwnedBy(letCstr.fn[ci], calleeFn)
      && !nestCstrOutside(letCstr.ix[ci])
      && !wrUnreachedBy(ci, ix, calleeFn)
    ) {
      cvNow = cvPick(CV_LET, ci, cvWas)
      const lg = substTyDeep(letCstr.got[ci], bNames, bTys)
      const lw = substTyDeep(letCstr.want[ci], bNames, bTys)
      // Re-records only when the callee is named, for the same ownership reason
      // `validateRetCstrs` gates on; also gated on either side holding a hole.
      if (
        calleeFn >= 0
        || substNestMode == SUBST_NESTED
        || substNestMode == SUBST_HOLES
      ) {
        if lg != letCstr.got[ci] || lw != letCstr.want[ci] {
          if tyHasHole(lg) || tyHasHole(lw) {
            noteLetCstr(lg, lw, letCstr.ix[ci], letCstr.name[ci])
          }
        }
      }
      if !tyHasHole(lg) {
        if !tyHasHole(lw) {
          if !litPinAssignable(letCstr.ix[ci], lg, lw, bNames, bTys) {
            let lWho = "the callee's body"
            if who != "" { lWho = "the body of `" + who + "`" }
            tErr(
              letAssignMsg(letCstr.ix[ci], lg, lw, letCstr.name[ci], -1)
                + " ("
                + lWho
                + " at the call's argument types)",
              ix,
            )
          }
        }
      }
    }
    ci = ci + 1
  }
  cvNow = cvWas
  0
}

// A deferred `.push(v)` whose receiver pins to an open list: the list's element takes what the
// direct spelling's first push gives it (`v`'s widened type, or the open `_ | null` a bare null
// mints), so the argument's row carries the element the body decided (D2218).
function cnhPinBmElem(
  want: i32,
  bNames: string[],
  bTys: i32[],
  at: i32,
  got: i32,
  pinRows: i32[],
) {
  const row = hdRowOf(want)
  if row < 0 || row >= hdKind.length { return 0 }
  if hdKind[row] != HD_ELEM { return 0 }
  const arr = substTyDeep(hdBase[row], bNames, bTys)
  if arr < 0 { return 0 }
  // A value's own type pins only a list written at the call; a binding's list keeps its own
  // later writes, which may still widen it.
  const valPin = isNullTy(got) || nhOpen(got) || i32ListHas(pinRows, arr)
  if !valPin {
    // A quiet re-check's write is not the program's; the real check records it again.
    if unresolvedHole(arr) && !inferQuiet {
      calleeWriteRow.push(arr)
      calleeWriteGot.push(got)
      calleeWriteAt.push(at)
    }
    return 0
  }
  const a = T.tys[arr]
  if a is TyArray {
    if a.aElem < 0 {
      let pin = got
      if !nhOpen(got) { pin = cnhPinTy(got, at, -1, false, false) }
      a.aElem = pin
      tyMutEpoch = tyMutEpoch + 1 // a hole body's push pinned the argument in place
    } else if !nhOpen(got) {
      cnhFill(a.aElem, got)
    }
  }
  0
}

// The pins a body's deferred `.push` arguments and element stores owe the open lists written at
// this call, in check order, ahead of every validation that reads those elements: the first
// write decides the element, as at the direct spelling (D2218).
function pinBmCstrElems(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  args: i32[],
) {
  const pinRows = callSiteOpenListRows(args)
  const nb = bmCstr.got.length
  const nl = letCstr.got.length
  let ci = 0
  let li = 0
  while ci < nb || li < nl {
    while ci < nb && !cstrOwnedBy(bmCstr.fn[ci], calleeFn) { ci = ci + 1 }
    while li < nl && !cstrOwnedBy(letCstr.fn[li], calleeFn) { li = li + 1 }
    let takeBm = ci < nb
    if ci < nb && li < nl { takeBm = bmCstr.seq[ci] <= letCstr.seq[li] }
    if takeBm && ci < nb {
      pinOpenElemFrom(
        bmCstr.got[ci],
        bmCstr.want[ci],
        bNames,
        bTys,
        ix,
        pinRows,
      )
      ci = ci + 1
    } else if li < nl {
      pinOpenElemFrom(
        letCstr.got[li],
        letCstr.want[li],
        bNames,
        bTys,
        ix,
        pinRows,
      )
      li = li + 1
    }
  }
  0
}

// One deferred write of `got` into `want` at the pin: an open list element adopts it.
function pinOpenElemFrom(
  got: i32,
  want: i32,
  bNames: string[],
  bTys: i32[],
  ix: i32,
  pinRows: i32[],
) {
  const g = substTyDeep(got, bNames, bTys)
  if isNullTy(g) || nhOpen(g) || (g >= 0 && !tyHasTyVar(g)) {
    cnhPinBmElem(want, bNames, bTys, ix, g, pinRows)
  }
  0
}

// Whether the deferred builtin-method-argument constraints this binding resolves hold — the
// twin of `validateLetCstrs` for a `.push`/`.set`/`.add` argument rather than an assignment
// (D582 is why `argCstr*` cannot serve this position). Same re-deferral rule, gated on either
// side; the message is the arm's own (`bmArgMsg`), verbatim, with the attribution appended.
function validateBmCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
) {
  const nOrigB = bmCstr.got.length
  const cvWas = cvNow
  let ci = 0
  while ci < nOrigB {
    if cstrOwnedBy(bmCstr.fn[ci], calleeFn) && !nestCstrOutside(bmCstr.ix[ci]) {
      cvNow = cvPick(CV_BM, ci, cvWas)
      const bg = substTyDeep(bmCstr.got[ci], bNames, bTys)
      const bw = substTyDeep(bmCstr.want[ci], bNames, bTys)
      let bc = bmCstr.ctx[ci]
      if bc >= 0 { bc = substTyDeep(bc, bNames, bTys) }
      // Re-records only when the callee is named — an unnamed call cannot reassign
      // ownership of the constraint.
      if (
        calleeFn >= 0
        || substNestMode == SUBST_NESTED
        || substNestMode == SUBST_HOLES
      ) {
        if bg != bmCstr.got[ci] || bw != bmCstr.want[ci] {
          if tyHasHole(bg) || tyHasHole(bw) {
            noteBmCstr(
              bmCstr.form[ci],
              bmCstr.label[ci],
              bg,
              bw,
              bc,
              bmCstr.ix[ci],
            )
          }
        }
      }
      if !tyHasHole(bg) {
        if !tyHasHole(bw) {
          if !bmArgPred(bmCstr.form[ci], bg, bw, bmCstr.ix[ci]) {
            let bWho = "the callee's body"
            if who != "" { bWho = "the body of `" + who + "`" }
            tErr(
              bmArgMsg(bmCstr.form[ci], bmCstr.label[ci], bg, bw, bc)
                + " ("
                + bWho
                + " at the call's argument types)",
              ix,
            )
          }
        }
      }
    }
    ci = ci + 1
  }
  cvNow = cvWas
  0
}

// Whether the deferred UFCS-receiver constraints this binding resolves hold, in three steps
// mirroring the language's own dispatch precedence: a receiver still carrying a hole
// re-defers; a receiver with a field of that name (any field, `drwWalk`'s `sFieldIndex` test)
// is a field call this constraint does not speak about; otherwise it must fit `self`, in the direct spelling's own words (`memberFloorMsg`).
function validateUfcsCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
) {
  const nOrigU = ufcsCstr.ty.length
  const cvWas = cvNow
  let ci = 0
  while ci < nOrigU {
    if (
      cstrOwnedBy(ufcsCstr.fn[ci], calleeFn)
      && !nestCstrOutside(ufcsCstr.ix[ci])
    ) {
      cvNow = cvPick(CV_UFCS, ci, cvWas)
      const ur = substTyDeep(ufcsCstr.ty[ci], bNames, bTys)
      if (
        calleeFn >= 0
        || substNestMode == SUBST_NESTED
        || substNestMode == SUBST_HOLES
      ) {
        if ur != ufcsCstr.ty[ci] {
          if tyHasHole(ur) {
            noteUfcsCstr(
              ur,
              ufcsCstr.prop[ci],
              ufcsCstr.ix[ci],
              ufcsCstr.p0[ci],
            )
          }
        }
      }
      if !tyHasHole(ur) {
        // The member-call order at the pinned receiver (D2517): a built-in method or a field
        // takes the call over the `self`-function, and must fit how the body used it.
        const uRung = memberRungOnTy(ur, ufcsCstr.prop[ci])
        if uRung != 0 {
          let uWho0 = "the callee's body"
          if who != "" { uWho0 = "the body of `" + who + "`" }
          memberPinFitsAt(
            ufcsCstr.ix[ci],
            ur,
            ufcsCstr.prop[ci],
            uRung,
            bNames,
            bTys,
            ix,
            uWho0,
          )
          let mi = 0
          while mi < ufcsCstr.more[ci].length {
            memberPinFitsAt(
              ufcsCstr.more[ci][mi],
              ur,
              ufcsCstr.prop[ci],
              uRung,
              bNames,
              bTys,
              ix,
              uWho0,
            )
            mi = mi + 1
          }
        }
        // An overloaded call noted no `self` type: each pin picks its own candidate.
        if uRung == 0 && ufcsCstr.p0[ci] < 0 {
          let oWho = "the callee's body"
          if who != "" { oWho = "the body of `" + who + "`" }
          ovPinCheck(
            ufcsCstr.ix[ci],
            ur,
            ufcsCstr.prop[ci],
            bNames,
            bTys,
            ix,
            oWho,
          )
          for mo in ufcsCstr.more[ci] {
            ovPinCheck(mo, ur, ufcsCstr.prop[ci], bNames, bTys, ix, oWho)
          }
        } else if uRung == 0 {
          if !assignable(ur, ufcsCstr.p0[ci]) {
            let uMsg = memberFloorMsg(ur, ufcsCstr.prop[ci])
            let uSuggest = ""
            if uMsg == "" {
              uMsg = "no method '." + ufcsCstr.prop[ci] + "' on " + tyToStr(ur)
              uSuggest = methodDidYouMean(ur, ufcsCstr.prop[ci])
            }
            let uWho = "the callee's body"
            if who != "" { uWho = "the body of `" + who + "`" }
            tErr(
              uMsg
                + " — the `"
                + ufcsCstr.prop[ci]
                + "` in scope takes "
                + tyToStr(ufcsCstr.p0[ci])
                + " ("
                + uWho
                + " at the call's argument types)"
                + uSuggest,
              ix,
            )
          } else if !tyHasHole(ufcsCstr.p0[ci]) {
            ufcsRecvPinSeam(ufcsCstr.ix[ci], ur, ufcsCstr.p0[ci], ix)
          }
        }
      }
    }
    ci = ci + 1
  }
  cvNow = cvWas
  0
}

// At a pin where the receiver's built-in method or field `prop` (`rung`) takes member call
// `callIx` over the `self`-function the generic body is typed against, the call must fit
// that member as the body used it: its arguments, and its value unless the body discarded a
// `void`. The emitter picks per instance only on a parameter of the generic itself (D2520).
function memberPinFitsAt(
  callIx: i32,
  recv: i32,
  prop: string,
  rung: i32,
  bNames: string[],
  bTys: i32[],
  at: i32,
  who: string,
) {
  if callIx < 0 || callIx >= P.nodes.length { return 0 }
  const c = P.nodes[callIx]
  if c is Call {
    let what = "built-in method"
    if rung == MC_RUNG_FIELD { what = "field" }
    const params: i32[] = []
    let res = -1
    if rung == MC_RUNG_BUILTIN {
      res = builtinSigOf(recv, prop, c.callArgs.length, params)
    } else {
      res = fieldSigOf(recv, prop, c.callArgs.length, params)
    }
    let why = ""
    if i32ListHas(ufcsUnpinnedSites, callIx) {
      why = "and this call cannot pick it per instance from inside a closure or through a "
        + "local — call it on the generic's own parameter"
    } else if hasNamedArgs(c.callArgNames) {
      why = "which takes no named arguments"
    } else if res < 0 {
      why = "which takes different arguments than this call passes"
    } else {
      let i = 0
      while i < c.callArgs.length && why == "" {
        const a = substTyDeep(nodeTyIxOf(c.callArgs[i]), bNames, bTys)
        if a >= 0 && !tyHasHole(a) && !assignable(a, params[i]) {
          why = "whose argument "
            + i32ToStr(i + 1)
            + " is "
            + tyToStr(params[i])
            + ", not "
            + tyToStr(a)
        }
        i = i + 1
      }
      // A field's value is not held to the body's use: a field call already ran per instance
      // before the built-in rung existed, and `print(x.tag())` reads either value.
      const used = substTyDeep(nodeTyIxOf(callIx), bNames, bTys)
      if (
        why == ""
        && rung == MC_RUNG_BUILTIN
        && used >= 0
        && used != TY_VOID
        && !tyHasHole(used)
      ) {
        if !tyEq(used, res) {
          why = "which returns "
            + tyToStr(res)
            + ", not the "
            + tyToStr(used)
            + " the body uses"
        }
      }
    }
    if why != "" {
      tErr(
        "`."
          + prop
          + "` on "
          + tyToStr(recv)
          + " is its "
          + what
          + ", not the `"
          + prop
          + "` in scope, "
          + why
          + " ("
          + who
          + " at the call's argument types)",
        at,
      )
    }
  }
  0
}

// Whether the deferred receiver-classification constraints this binding resolves hold — see
// `memCstr.ty`'s header for why the index and UFCS arms cannot decide it in the body (D651 /
// D691). The index form defers to the argument-flow gate where it already speaks; a receiver
// that is not the bare parameter is uncovered by either gate, a known bound rather than a defect.
function validateMemCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
  hNames: string[],
  hArgNo: i32[],
  hArgNode: i32[],
) {
  const nOrigM = memCstr.ty.length
  const cvWas = cvNow
  let ci = 0
  while ci < nOrigM {
    if (
      cstrOwnedBy(memCstr.fn[ci], calleeFn)
      && !nestCstrOutside(memCstr.ix[ci])
    ) {
      cvNow = cvPick(CV_MEM, ci, cvWas)
      const mr = substTyDeep(memCstr.ty[ci], bNames, bTys)
      if (
        calleeFn >= 0
        || substNestMode == SUBST_NESTED
        || substNestMode == SUBST_HOLES
      ) {
        if mr != memCstr.ty[ci] {
          if tyHasHole(mr) {
            noteMemCstr(mr, memCstr.prop[ci], memCstr.ix[ci], memCstr.dem[ci])
          }
        }
      }
      if !tyHasHole(mr) {
        let skip = false
        // A resolved index operator: BANK it on its site for the emitter's dispatch rewrite,
        // or the read/write reaches the emitter as a raw Index over a receiver with no list
        // rep — a clause-2 emit reject on a check-clean program (D1892). GET's site is the
        // index node, SET's the assignment node; each constraint carries the right `memCstr.ix`.
        if opIdxDeclared() && !tyBuiltinIndexable(mr) {
          if memCstr.prop[ci] == OP_INDEX_GET {
            const gfn = opIdxFnFor(OP_INDEX_GET, mr)
            if gfn != "" {
              opIdxBank(memCstr.ix[ci], gfn)
            } else {
              // A SET-only receiver has no readable index: the inline arm refuses an annotated
              // one here, so the hole path must too — `indexFloorMsg` answers "" for it (it
              // sees the setter) and would fall silently to the emitter (D1932).
              const sOnly = opIdxFnFor(OP_INDEX_SET, mr)
              if sOnly != "" {
                tErr(
                  "operator "
                    + opDeclLabel(sOnly)
                    + " needs a matching \""
                    + OP_INDEX_GET
                    + "\" operator — an index that cannot be READ cannot be written either",
                  ix,
                )
                skip = true
              }
            }
          } else if memCstr.prop[ci] == OP_INDEX_SET {
            const sfn = opIdxFnFor(OP_INDEX_SET, mr)
            if sfn != "" {
              opIdxBank(memCstr.ix[ci], sfn)
            } else if opIdxFnFor(OP_INDEX_GET, mr) != "" {
              // A GET operator with no SET: name the missing half, as the inline arm does.
              tErr(
                "no \""
                  + OP_INDEX_SET
                  + "\" operator for index assignment on "
                  + tyToStr(mr),
                ix,
              )
            }
          }
        }
        if memCstr.prop[ci] == OP_INDEX_GET {
          if tyRefusesArrayDemand(mr) { skip = true }
        }
        // `"[]="` is not a field name, so `memCstrMsg` cannot grade it; the assignment arm at
        // check time owns a concrete receiver's write diagnostic, and a builtin-indexable pin
        // is a real array/map write. The SET operator's own site is settled just above.
        if memCstr.prop[ci] == OP_INDEX_SET { skip = true }
        if !skip {
          const mMsg = memCstrMsg(mr, memCstr.prop[ci])
          if mMsg != "" {
            // Refuses in the hole's own words, attributed to the argument only when exactly
            // one parameter is spelled with this type variable — otherwise naming one would guess.
            let told = false
            if memCstr.dem[ci] {
              const dNo = cstrArgNoOf(memCstr.ty[ci], hNames, hArgNo)
              if dNo > 0 && cstrArgCountOf(memCstr.ty[ci], hNames) == 1 {
                const dTy = tpDemandTy(memCstr.ty[ci], calleeFn)
                if dTy >= 0 {
                  argMismatchErr(
                    dNo,
                    dTy,
                    mr,
                    cstrArgNodeOf(dNo, hArgNo, hArgNode),
                  )
                  told = true
                }
              }
            }
            if !told {
              let mWho = "the callee's body"
              if who != "" { mWho = "the body of `" + who + "`" }
              tErr(mMsg + " (" + mWho + " at the call's argument types)", ix)
            }
          }
        }
      }
    }
    ci = ci + 1
  }
  cvNow = cvWas
  0
}

// Substitutes every `HD_COAL` result hole this call resolves, for its BANK alone: the
// substitution is what records the pin (`substHoleTy`), and `nodeTyPinIxOf` is what the
// emitter's `??` arm then reads. No diagnostic here — the body owns the operand check, and a
// hole two calls pin differently poisons its own row, which is the answer the emitter needs.
function bankCoalHoles(bNames: string[], bTys: i32[], calleeFn: i32) {
  let ci = 0
  while ci < coalHoleTy.length {
    if cstrOwnedBy(coalHoleFn[ci], calleeFn) {
      substHoleTy(coalHoleTy[ci], bNames, bTys)
    }
    ci = ci + 1
  }
  0
}

// Do every deferred call-argument constraint THIS binding resolves hold (the pure-boolean
// twin of `validateArgCstrs`, for `genericFnAssignable`)? An unresolved hole defers.
function argCstrsHold(bNames: string[], bTys: i32[]) {
  let ci = 0
  while ci < argCstr.at.length {
    const rat = substTyDeep(argCstr.at[ci], bNames, bTys)
    const rexp = substTyDeep(argCstr.exp[ci], bNames, bTys)
    if !tyIsHole(rat) && !tyIsDeferredJoin(rat) {
      if !tyIsHole(rexp) && !tyIsDeferredJoin(rexp) {
        if !argCstrFits(rat, rexp, argCstr.form[ci]) { return false }
      }
    }
    ci = ci + 1
  }
  true
}

// Instantiates a generic function passed to an un-annotated parameter at the arguments the
// body calls that parameter with (`take(same)` where `take` calls `a("x")`): binding `vNames[k]`
// to `same<T>`'s open signature would leave every call of the hole typed `T` (D4420). Kept
// generic when a call is unpinned or two calls disagree, which the emitter still refuses.
function instGenFnHolePins(
  vNames: string[],
  vTys: i32[],
  calleeFn: i32,
  hNames: string[],
  hArgNode: i32[],
) {
  if calleeFn < 0 { return 0 }
  let k = 0
  while k < vNames.length {
    const vt = vTys[k]
    if vt >= 0 && vt < T.tys.length && tyHasTyVar(vt) {
      const vf = T.tys[vt]
      if (
        vf is TyFunc
        && argIsOwnGenericFnValue(holeArgNodeOf(vNames[k], hNames, hArgNode))
      ) {
        const inst = genFnHoleInstance(vNames, vTys, k, vt, calleeFn)
        if inst >= 0 { vTys[k] = inst }
      }
    }
    k = k + 1
  }
  0
}

// `vt` instantiated at every argument the callee's body passes when calling hole `vNames[k]`,
// or -1 when there is no such call, an argument is still open, or two calls disagree.
function genFnHoleInstance(
  vNames: string[],
  vTys: i32[],
  k: i32,
  vt: i32,
  calleeFn: i32,
): i32 {
  const vf = T.tys[vt]
  if !(vf is TyFunc) { return -1 }
  const gNames: string[] = []
  const gTys: i32[] = []
  let seen = false
  let ci = 0
  while ci < argCstr.at.length {
    if cstrOwnedBy(argCstr.fn[ci], calleeFn) && argCstr.form[ci] > 0 {
      const row = hdRowOf(argCstr.exp[ci])
      if row >= 0 && hdKind[row] == HD_PARAM && hdBase[row] >= 0 {
        const bt = T.tys[hdBase[row]]
        if bt is TyVar && bt.tvName == vNames[k] {
          const pj = hdInner[row]
          if pj < 0 || pj >= vf.fnParamTypes.length { return -1 }
          const rat = substTyDeep(argCstr.at[ci], vNames, vTys)
          if rat < 0 || tyHasTyVar(rat) || tyIsDeferredJoin(rat) { return -1 }
          bindGenWalk(vf.fnParamTypes[pj], rat, gNames, gTys)
          const want = substTyDeep(vf.fnParamTypes[pj], gNames, gTys)
          if tyHasTyVar(want) || !assignable(rat, want) { return -1 }
          seen = true
        }
      }
    }
    ci = ci + 1
  }
  if !seen { return -1 }
  const inst = substTyDeep(vt, gNames, gTys)
  if inst < 0 || tyHasTyVar(inst) { return -1 }
  inst
}

// Re-validates every deferred binary-op constraint this call resolves: substitutes the holes
// to the call's concrete argument types and checks the operator is defined for them — the one
// rule numeric, string and relational operators all reduce to. Re-defers when a hole
// substitutes to another hole; scoped to the callee (`cstrOwnedBy`) for the same by-name reason `noteMemCstr` needs it.
function validateBinCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
  hNames: string[],
  hArgNo: i32[],
  hArgNode: i32[],
) {
  const nOrigB = binCstr.op.length
  const cvWas = cvNow
  let ci = 0
  while ci < nOrigB {
    if cstrOwnedBy(binCstr.fn[ci], calleeFn) {
      cvNow = cvPick(CV_BIN, ci, cvWas)
      let clt = substTyDeep(binCstr.lt[ci], bNames, bTys)
      let crt = substTyDeep(binCstr.rt[ci], bNames, bTys)
      // Re-records only when the callee is named — an unnamed call cannot reassign ownership,
      // or a HOF's own element hole could adopt a sibling generic's constraint as its own.
      if (
        calleeFn >= 0
        || substNestMode == SUBST_NESTED
        || substNestMode == SUBST_HOLES
      ) {
        if clt != binCstr.lt[ci] || crt != binCstr.rt[ci] {
          if tyHasHole(clt) || tyHasHole(crt) {
            noteBinCstr(clt, binCstr.op[ci], crt)
          }
        }
      }
      let litHolds = false
      if !tyHasHole(clt) && !tyHasHole(crt) {
        litHolds = eqLitMemberOk(clt, crt) || eqLitMemberOk(crt, clt)
        // A literal outside the pin's closed set is refused, as the direct spelling is (D3158).
        if !litHolds && eqLitNonMember(clt, crt) {
          litHolds = true
          let lWho = "a type parameter is compared with `"
            + binCstr.op[ci]
            + "` here: "
          if who != "" {
            lWho = "`"
              + who
              + "` compares its type parameter with `"
              + binCstr.op[ci]
              + "` here: "
          }
          tErr(
            lWho
              + "cannot compare "
              + tyToStr(clt)
              + " with "
              + tyToStr(crt)
              + " — not a member of the union",
            ix,
          )
        }
        clt = softenBareLitTy(clt)
        crt = softenBareLitTy(crt)
      }
      if !tyHasHole(clt) && !litHolds {
        if !tyHasHole(crt) {
          // The equality refusal (in the direct spelling's own words) replaces the generic
          // sentence here, with the attribution placed in front since it ends on a remedy clause.
          const pMsgs: string[] = []
          const pChan: i32[] = []
          if binCstr.op[ci] == "==" || binCstr.op[ci] == "!=" {
            eqRefusals(binCstr.op[ci], clt, crt, true, pMsgs, pChan)
          }
          if pMsgs.length > 0 {
            let pWho = "a type parameter is compared with `"
              + binCstr.op[ci]
              + "` here: "
            if who != "" {
              pWho = "`"
                + who
                + "` compares its type parameter with `"
                + binCstr.op[ci]
                + "` here: "
            }
            let pm = 0
            while pm < pMsgs.length {
              const pTxt = pWho + pMsgs[pm]
              if pChan[pm] == 1 {
                tErrUnsupported(pTxt, ix)
              } else {
                tErr(pTxt, ix)
              }
              pm = pm + 1
            }
          } else if !binOpDefinedFor(binCstr.op[ci], clt, crt) {
            // The refusal sentence is the direct spelling's, verbatim; the anchor moves to
            // the first argument (not the call's last token) so a one-line call carets correctly.
            const lNo = cstrArgNoOf(binCstr.lt[ci], hNames, hArgNo)
            const rNo = cstrArgNoOf(binCstr.rt[ci], hNames, hArgNo)
            const lN = cstrArgCountOf(binCstr.lt[ci], hNames)
            const rN = cstrArgCountOf(binCstr.rt[ci], hNames)
            let refusal = "operator '"
              + binCstr.op[ci]
              + "' is not defined for "
              + tyToStr(clt)
              + " and "
              + tyToStr(crt)
            if binCstr.op[ci] == OP_NEG {
              refusal = "unary '-' expects a numeric type, got " + tyToStr(clt)
            }
            if binCstr.op[ci] == OP_BNOT {
              refusal = "unary '~' expects a numeric type, got " + tyToStr(clt)
              if isNumeric(clt) {
                refusal = "operator '~' is integer-only, got " + tyToStr(clt)
              }
            }
            if binCstr.op[ci] == OP_AS { refusal = asPinRefusal(clt, crt) }
            if binCstr.op[ci] == OP_LITFIT {
              refusal = tyToStr(clt)
                + " cannot hold the 64-bit operand it meets"
            }
            // An ordering over a gradual union is refused in the direct spelling's words.
            const cop = binCstr.op[ci]
            if (
              (cop == "<" || cop == ">" || cop == "<=" || cop == ">=")
              && (tyIsGradualUnion(binCstr.lt[ci])
                || tyIsGradualUnion(binCstr.rt[ci]))
            ) {
              refusal = "comparison expects numeric operands, got "
                + tyToStr(clt)
                + " and "
                + tyToStr(crt)
            }
            let anchorNo = lNo
            if anchorNo == 0 { anchorNo = rNo }
            let msg = refusal + " (the call's argument types)"
            if lN <= 1 && rN <= 1 && anchorNo > 0 {
              let bodyWho = "the callee's body"
              if who != "" { bodyWho = "the body of `" + who + "`" }
              // One argument responsible gets the `argument N:` head every other diagnostic
              // uses; two get no head (it would blame one) and the tail names both instead.
              let head = "argument " + i32ToStr(anchorNo) + ": "
              let tail = " ("
                + bodyWho
                + " applies '"
                + binCstr.op[ci]
                + "' to this argument)"
              if lNo != 0 && rNo != 0 {
                if lNo == rNo {
                  tail = " ("
                    + bodyWho
                    + " uses it on both sides of '"
                    + binCstr.op[ci]
                    + "')"
                } else {
                  head = ""
                  tail = " ("
                    + bodyWho
                    + " applies '"
                    + binCstr.op[ci]
                    + "' to arguments "
                    + i32ToStr(lNo)
                    + " and "
                    + i32ToStr(rNo)
                    + ")"
                }
              }
              if binCstr.op[ci] == OP_NEG {
                tail = " (" + bodyWho + " negates this argument)"
              }
              if binCstr.op[ci] == OP_BNOT {
                tail = " (" + bodyWho + " flips this argument's bits)"
              }
              if binCstr.op[ci] == OP_LITFIT {
                tail = " (" + bodyWho + " computes with it and a 64-bit value)"
              }
              msg = head + refusal + tail
            }
            const aNode = cstrArgNodeOf(anchorNo, hArgNo, hArgNode)
            if aNode >= 0 { tErr(msg, aNode) } else { tErr(msg, ix) }
          }
        }
      }
    }
    ci = ci + 1
  }
  cvNow = cvWas
  0
}

// Re-ask every demand parked on `name` with the pin substituted. Re-entrancy-guarded, since
// `substTyDeep` banks derived holes and would re-enter through `notePinnedHole`.
function argPinRecheck(name: string, ty: i32) {
  if argPinChecking { return 0 }
  argPinCheckingSet(true)
  const bN: string[] = []
  const bT: i32[] = []
  bN.push(name)
  bT.push(ty)
  let i = 0
  while i < argPinWant.length {
    if argPinDone[i] == 0 {
      const sub = substTyDeep(argPinGot[i], bN, bT)
      // Only a substitution that CHANGED the type says this pin reaches this demand, and only
      // a fully concrete result can be compared. An argument the function-value adapter
      // rewrote is already at the parameter's type.
      if sub >= 0 && sub != argPinGot[i] && !tyHasTyVar(sub) {
        if (
          !assignable(sub, argPinWant[i])
          && !(fvaDone[argPinNode[i]] ?? false)
        ) {
          argPinDoneSetAt(i, 1)
          argMismatchErr(argPinNo[i], argPinWant[i], sub, argPinNode[i])
        }
      }
    }
    i = i + 1
  }
  argPinCheckingSet(false)
  0
}

// Banks the pin `ty` that `owner`'s hole named `name` took, appending it to the hole's set
// unless a `tySame` pin is already there. Never banked from a quiet probe: `solveUnannotParams`
// truncates its tables afterward. The collapse (`HOLE_PIN_CONFLICT`) is derived on read.
function notePinnedHole(name: string, ty: i32, owner: string) {
  if inferQuiet { return 0 }
  if ty < 0 { return 0 }
  argPinRecheck(name, ty)
  const key = holePinKey(owner, name)
  const s = holePinSet[key] ?? []
  let i = 0
  while i < s.length {
    if s[i] == ty { return 0 }
    if tySame(s[i], ty) { return 0 }
    i = i + 1
  }
  s.push(ty)
  holePinSet[key] = s
  0
}

// `substHoleTyReal`, banking the answer for a DERIVED hole under its own name the way the
// direct-binding rung already banks its own. A derived hole is what the emitter reads back for a
// narrowed or projected parameter (`nodeTyPinIxOf`), and without a row of its own it reads an
// unresolved `TyVar` and classifies the value by its declared rep instead (D1693).
function substHoleTy(tyIx: i32, bNames: string[], bTys: i32[]) {
  const ver = shMemoSync(bNames, bTys)
  if ver >= 0 && shMemo.has(tyIx) { return shMemo.get(tyIx) ?? -1 }
  const r = substHoleTyReal(tyIx, bNames, bTys)
  if r >= 0 && hdRowOf(tyIx) >= 0 && !tyIsHole(r) {
    const t = T.tys[tyIx]
    if t is TyVar { notePinnedHole(t.tvName, r, tyVarOwnerOf(tyIx)) }
  }
  if ver >= 0 && ver == shMemoVer && shMemoStampSame() { shMemoPut(tyIx, r) }
  r
}

// True when union `pin` has a member assignable to `alt`: an `is alt` guard over a parameter
// pinned at `pin` can pass. A non-union pin answers false; its own assignability is asked first.
function pinHasMemberOf(pin: i32, alt: i32): boolean {
  const vs: i32[] = []
  flattenVariantsInto(pin, vs)
  if vs.length < 2 { return false }
  let i = 0
  while i < vs.length {
    if holeAssignOk(-1, vs[i], alt) { return true }
    i = i + 1
  }
  false
}

// Resolves a (possibly derived) hole against a call's bindings: a direct binding on its name
// wins; a return derivation collapses to the pinned function's return; a field derivation to
// the pinned object's field. A base that resolves to another hole re-bases onto it
// (`rebaseDerivedHole`) instead of going unresolved — the two-level chain where dropping the link let an i32 reach a `string` param with no diagnostic. -1 = unresolved.
function substHoleTyReal(tyIx: i32, bNames: string[], bTys: i32[]) {
  if tyIx < 0 { return -1 }
  const t = T.tys[tyIx]
  if !(t is TyVar) { return -1 }
  const b = bindOf(bNames, bTys, t.tvName)
  if b >= 0 {
    notePinnedHole(t.tvName, b, tyVarOwnerOf(tyIx))
    return b
  }
  const row = hdRowOf(tyIx)
  if row < 0 { return -1 }
  const kind = hdKind[row]
  // A guarded return member (`mkGuardedRetTy`): the pin decides reachability — satisfying the
  // guard's tested type makes the branch live, otherwise it stays unresolved and drops out.
  if kind == HD_GALT {
    const gInner = hdInner[row]
    const gAlt = hdAlt[row]
    if gInner < 0 || gAlt < 0 { return -1 }
    const gPin = substHoleTy(hdBase[row], bNames, bTys)
    if gPin < 0 { return -1 }
    if tyIsHole(gPin) { return rebaseDerivedHole(row, gPin) }
    if holeAssignOk(-1, gPin, gAlt) { return gInner }
    // A union pin with a member of the tested type reaches the branch too, so its return is a
    // member of the call's type, as the annotated parameter's is (D3094).
    if pinHasMemberOf(gPin, gAlt) { return gInner }
    return -1
  }
  // The guard's complement (`else` on a hole): the pin is the first place a remainder exists
  // (`subtractTy` needs a member list); a pin it cannot reduce keeps itself, as the un-narrowed `else` already meant.
  if kind == HD_GNOT {
    const nAlt = hdAlt[row]
    if nAlt < 0 { return -1 }
    const nPin = substHoleTy(hdBase[row], bNames, bTys)
    if nPin < 0 { return -1 }
    if tyIsHole(nPin) { return rebaseDerivedHole(row, nPin) }
    const nRest = subtractTy(nPin, nAlt)
    if nRest >= 0 { return nRest }
    return nPin
  }
  // The `??` result, deferred: the pin's non-null face when the default fits it, else the join
  // — `checkBinExprNodeReal`'s own coalesce tail, which needs both sides concrete to decide.
  if kind == HD_COAL {
    const cPin = substHoleTy(hdBase[row], bNames, bTys)
    if cPin < 0 { return -1 }
    if tyIsHole(cPin) { return rebaseDerivedHole(row, cPin) }
    // A declared parameter's pin that cannot be null leaves the default dead, as the concrete
    // `??` types it; a hole's keeps the join its instance lowers (D2951).
    if coalDeadAtPin(row, cPin) { return cPin }
    const cInner = nonNullTy(cPin)
    const cDft = substTyDeep(hdInner[row], bNames, bTys)
    // A pin that is only ever `null` always takes the default, as the concrete `??` types it.
    if isNullTy(cPin) && cDft >= 0 && !tyHasHole(cDft) {
      return widenLitTy(cDft)
    }
    if cDft < 0 || tyHasHole(cDft) { return cInner }
    if assignable(cDft, cInner) { return cInner }
    // A literal default the face does not hold widens to its base, as the concrete `??` types it.
    const cDt = T.tys[cDft]
    if cDt is TyLit { return joinTys(cInner, litBaseTy(cDt)) }
    return joinTys(cInner, widenLitTy(cDft))
  }
  // The `??` result over a hole default: the concrete tail, now that the default has a type.
  if kind == HD_COALD {
    const dPin = substHoleTy(hdBase[row], bNames, bTys)
    if dPin < 0 { return -1 }
    if tyIsHole(dPin) { return rebaseDerivedHole(row, dPin) }
    const dFace = substTyDeep(hdInner[row], bNames, bTys)
    if dFace < 0 || tyHasHole(dFace) { return -1 }
    if assignable(dPin, dFace) { return dFace }
    return joinTys(dFace, dPin)
  }
  // A place holding a written parameter value: the member of its declaration the pin lands on.
  if kind == HD_TVW {
    const wPin = substHoleTy(hdBase[row], bNames, bTys)
    if wPin < 0 { return -1 }
    if tyIsHole(wPin) { return rebaseDerivedHole(row, wPin) }
    return tvWriteLandTy(hdInner[row], wPin)
  }
  if kind == HD_HWR {
    const hPin = substHoleTy(hdBase[row], bNames, bTys)
    if hPin < 0 { return -1 }
    if tyIsHole(hPin) { return rebaseDerivedHole(row, hPin) }
    return writeMemberTy(hPin, hdInner[row])
  }
  if kind == HD_RET {
    const inner = substHoleTy(hdBase[row], bNames, bTys)
    if inner >= 0 {
      const fi = callPinFnTy(inner)
      if fi >= 0 {
        const it = T.tys[fi]
        if it is TyFunc { return it.fnRet }
      }
      return rebaseDerivedHole(row, inner)
    }
    return -1
  }
  // A parameter of calling the hole: the pinned function's own, -1 past its arity.
  if kind == HD_PARAM {
    const innerP = substHoleTy(hdBase[row], bNames, bTys)
    if innerP < 0 { return -1 }
    const itP = T.tys[innerP]
    if itP is TyFunc {
      const pj = hdInner[row]
      if pj >= 0 && pj < itP.fnParamTypes.length { return itP.fnParamTypes[pj] }
      return -1
    }
    return rebaseDerivedHole(row, innerP)
  }
  // A deferred binary-op result (`mkBinOpRetTy`): an object pin with a `self`-function
  // overload takes the overload's return type; every other pin keeps the body's own answer, mirroring `checkBinExprNode`'s dispatch arm exactly, including its `is TyObj` gate.
  if kind == HD_BINOP {
    const innerB = substHoleTy(hdBase[row], bNames, bTys)
    if innerB < 0 { return -1 }
    if tyIsHole(innerB) { return rebaseDerivedHole(row, innerB) }
    const dTy = objOpSelfDispatchTy(hdField[row], innerB)
    if dTy >= 0 { return dTy }
    // A pinned operand that concatenates as a string makes `+` a concat, whose result is
    // `string` and not the operand — the same answer `checkBinary`'s own arm reaches once the
    // hole is concrete, which is the agreement the pin exists to keep (D1739).
    if hdField[row] == "+" {
      if concatsAsStr(innerB) { return TY_STR }
    }
    // No dispatch: the body's own answer, which may itself name this hole (`return lt` for
    // the arithmetic tail) or be concrete (`TY_BOOL` for an ordering comparison).
    const bInner = hdInner[row]
    // An answer naming the operand is the operand's pin, already resolved above: resolving it
    // again would double the walk per link of an operator chain (D3407).
    if bInner == hdBase[row] && bNames.length > 0 {
      const bv = T.tys[bInner]
      if bv is TyVar {
        if substNestMode == SUBST_ALL || substBindsNestRow(bInner, bv.tvName) {
          return innerB
        }
      }
    }
    return substTyDeep(bInner, bNames, bTys)
  }
  // The element of an indexed hole (`self[i]`): resolve the hole to its pinned
  // argument; an array yields its element (its value type for `HD_ELEMV`, so a `u8` byte
  // reads as `i32`), a string an i32 code point. Mirrors the FIELD read for indexing.
  if kind == HD_ELEM || kind == HD_ELEMV {
    const innerE = substHoleTy(hdBase[row], bNames, bTys)
    if innerE >= 0 {
      const itE = T.tys[innerE]
      if itE is TyArray {
        if kind == HD_ELEMV { return arrElemValueTy(itE.aElem) }
        return itE.aElem
      }
      if itE is TyPrim {
        if itE.primName == "string" { return TY_I32 }
      }
      return rebaseDerivedHole(row, innerE)
    }
    return -1
  }
  // HD_FLD. An empty property name never resolves — the string form's `dot > 0`
  // guard, kept verbatim (see `holeBaseTy`).
  if hdField[row].length == 0 { return -1 }
  const inner2 = substHoleTy(hdBase[row], bNames, bTys)
  if inner2 >= 0 {
    const it2 = T.tys[inner2]
    if it2 is TyObj {
      const f = objFieldType(it2, hdField[row])
      if f >= 0 { return f }
    }
    return rebaseDerivedHole(row, inner2)
  }
  -1
}

// Generic call-site binding, deep: walks an expected parameter type against the argument's
// actual type and binds every `TyVar` leaf on first use. Later uses are checked by the caller
// against the substituted expected type, so disagreeing uses still error. Nested positions
// bind too — a `Box<T>` param pins `T` from the argument's field, a callback's from its signature.
export function bindGenWalk(
  expIx: i32,
  atIx: i32,
  bNames: string[],
  bTys: i32[],
) {
  if expIx < 0 || atIx < 0 { return 0 }
  const e = T.tys[expIx]
  if e is TyVar {
    // `T` ranges over value types; `u8` is a storage type with no value rep, so binding it
    // would instantiate an i32-list over a one-byte backing — declined here so `assignable` reports it at the argument instead.
    if primNameOf(atIx) == "u8" { return 0 }
    if bindOf(bNames, bTys, e.tvName) < 0 {
      bNames.push(e.tvName)
      bTys.push(widenLitTy(atIx))
    }
    return 0
  }
  let gi = bgSrcStack.length - 1
  while gi >= 0 {
    if bgSrcStack[gi] == expIx && bgDstStack[gi] == atIx { return 0 }
    gi = gi - 1
  }
  bgSrcStackPush(expIx)
  bgDstStackPush(atIx)
  const a = T.tys[atIx]
  if e is TyArray {
    if a is TyArray { bindGenWalk(e.aElem, a.aElem, bNames, bTys) }
  } else if e is TyNullable {
    if a is TyNullable { bindGenWalk(e.nInner, a.nInner, bNames, bTys) }
    else if atIx != TY_NULL { bindGenWalk(e.nInner, atIx, bNames, bTys) }
  } else if e is TyObj {
    if a is TyObj {
      const enames = e.objFieldNames
      const etys = e.objFieldTypes
      let i = 0
      while i < enames.length {
        const sf = objFieldType(a, enames[i])
        if sf >= 0 { bindGenWalk(etys[i], sf, bNames, bTys) }
        i = i + 1
      }
    }
  } else if e is TyFunc {
    if a is TyFunc {
      const ep = e.fnParamTypes
      const ap = a.fnParamTypes
      let i = 0
      while i < ep.length {
        if i < ap.length { bindGenWalk(ep[i], ap[i], bNames, bTys) }
        i = i + 1
      }
      bindGenWalk(e.fnRet, a.fnRet, bNames, bTys)
    }
  } else if e is TyMap {
    // A map/set param (`{[string]: T}`) pins `T` from the argument's value
    // type (the key position walks too, for symmetry).
    if a is TyMap {
      bindGenWalk(e.mKey, a.mKey, bNames, bTys)
      bindGenWalk(e.mVal, a.mVal, bNames, bTys)
    }
  }
  bgSrcStackPop()
  bgDstStackPop()
  0
}

// The union arm `bindGenWalk` lacks, into bindings of its own: a parameter `T | string` binds its
// one open member to the argument's members no concrete member admits (`R` at `string | R`, `U`
// of `U[] | i32[]` at `string[]`). Only the call's deferred checks read them (D2803, D4922).
export function bindGenUnionArm(
  expIx: i32,
  atIx: i32,
  uNames: string[],
  uTys: i32[],
) {
  if expIx < 0 || atIx < 0 { return 0 }
  if !(T.tys[expIx] is TyUnion) { return 0 }
  const gms: i32[] = []
  flattenVariantsInto(expIx, gms)
  let open = -1
  let i = 0
  while i < gms.length {
    if gms[i] >= 0 && tyHasTyVar(gms[i]) {
      if open >= 0 { return 0 }
      open = gms[i]
    }
    i = i + 1
  }
  if open < 0 { return 0 }
  const pms: i32[] = []
  flattenVariantsInto(atIx, pms)
  const rest: i32[] = []
  let k = 0
  while k < pms.length {
    if pms[k] < 0 || tyHasTyVar(pms[k]) { return 0 }
    let covered = false
    let m = 0
    while m < gms.length && !covered {
      if gms[m] != open && assignable(pms[k], gms[m]) { covered = true }
      m = m + 1
    }
    if !covered { rest.push(pms[k]) }
    k = k + 1
  }
  if rest.length == 0 { return 0 }
  bindGenWalk(open, tyOfMembers(rest), uNames, uTys)
}

// Banks `newTy` as the same generic application `origTy` is, with the arguments substituted
// (D949) — a no-op when `origTy` is not an application, when nothing changed, or when `newTy`
// is already banked (the memo can hand back an index this walk has already seen).
function genAppCarry(origTy: i32, newTy: i32, bNames: string[], bTys: i32[]) {
  if origTy < 0 || newTy < 0 { return 0 }
  if origTy == newTy { return 0 }
  let k = 0
  while k < gaAppTyIxs.length {
    if gaAppTyIxs[k] == newTy { return 0 }
    k = k + 1
  }
  let j = 0
  while j < gaAppTyIxs.length {
    if gaAppTyIxs[j] == origTy {
      const st = gaAppArgStart[j]
      const cn = gaAppArgCount[j]
      // Reads the substituted arguments before pushing the row: `substTyDeep` can bank rows
      // of its own, and a half-written row would be visible to it.
      const subbed: i32[] = []
      let a = 0
      while a < cn {
        subbed.push(substTyDeep(gaAppArgFlat[st + a], bNames, bTys))
        a = a + 1
      }
      cTyIxSetAdd(gaAppTyIxs, gaAppTyIxSet, newTy)
      gaAppHeads.push(gaAppHeads[j])
      gaAppArgStart.push(gaAppArgFlat.length)
      gaAppArgCount.push(cn)
      gaAppFinite.push(0 - 1)
      let b = 0
      while b < subbed.length {
        gaAppArgFlat.push(subbed[b])
        b = b + 1
      }
      return 0
    }
    j = j + 1
  }
  0
}

// The members of a union re-joined one at a time, as the join that made it would at these types.
// `fixed[i]` says member `i` is a list that keeps its own storage (`joinKeepingStorage`).
function rejoinMembers(ms: i32[], fixed: boolean[]): i32 {
  const apart = njRejoinApart
  njRejoinApartSet(false)
  if ms.length == 0 { return -1 }
  let r = ms[0]
  let rFixed = fixed[0]
  let i = 1
  while i < ms.length {
    njApartSet(apart)
    r = joinKeepingStorage(r, rFixed, ms[i], fixed[i])
    njApartSet(false)
    rFixed = rFixed || fixed[i]
    i = i + 1
  }
  rejoinDropSubsumed(r)
}

// The join of `a` and `b`, or the two apart when it collapsed onto a list that a side stored as
// built (`aFixed`, `bFixed`) keeps differently: only a fresh list literal is built at a join (D4862).
export function joinKeepingStorage(
  a: i32,
  aFixed: boolean,
  b: i32,
  bFixed: boolean,
): i32 {
  const j = joinTys(a, b)
  if (
    (aFixed && listJoinStorageDiffers(a, j, 8))
    || (bFixed && listJoinStorageDiffers(b, j, 8))
  ) {
    return joinVariantTys(a, b)
  }
  j
}

// The members of the return join at row `key` at this pin, one return value at a time: each
// value's recorded type substituted, with `fixed` saying whether it is a list stored as built
// (not a list literal). False when the row records no return set.
function retJoinMembersAt(
  key: i32,
  bNames: string[],
  bTys: i32[],
  ms: i32[],
  fixed: boolean[],
  vals: i32[],
): boolean {
  const tys = tpRetJoinTys.get(key) ?? []
  const fl = tpRetJoinFixed.get(key) ?? []
  if tys.length == 0 || fl.length != tys.length { return false }
  let k = 0
  while k < tys.length {
    const s = substTyDeep(tys[k], bNames, bTys)
    vals.push(s)
    const one: i32[] = []
    flattenVariantsInto(s, one)
    for m in one {
      ms.push(m)
      fixed.push(fl[k])
    }
    k = k + 1
  }
  ms.length > 0
}

// Records the return values of the body at `body` when its inferred return `ret` is a join a pin
// re-joins (`tpJoinUnions`): each value's type, and whether it is a list stored as built.
function noteRetJoinValues(ret: i32, body: i32) {
  if ret < 0 || ret >= T.tys.length || tpJoinUnions.length == 0 { return 0 }
  let inner = ret
  const rt = T.tys[ret]
  if rt is TyNullable { inner = rt.nInner }
  if !tpJoinUnions.has(ret) && !tpJoinUnions.has(inner) { return 0 }
  const rets: i32[] = []
  collectRetValues(body, rets)
  const tys: i32[] = []
  const fixed: boolean[] = []
  let i = 0
  while i < rets.length {
    const r = rets[i]
    i = i + 1
    // A value `if` yields its arms: its own node carries one arm's type, not their join.
    const x = parenPeelIx(r)
    if x >= 0 && x < P.nodes.length && P.nodes[x] is IfStmt {
      a20RetWalk(x, true, rets)
      continue
    }
    const t = nodeTyIxOf(r)
    if t < 0 { return 0 }
    // A value that is itself a recorded join (`return w(t)`) contributes that join's own values.
    const sub = tpRetJoinTys.get(t) ?? []
    const subFixed = tpRetJoinFixed.get(t) ?? []
    if sub.length > 0 && subFixed.length == sub.length {
      let k = 0
      while k < sub.length {
        tys.push(sub[k])
        fixed.push(subFixed[k])
        k = k + 1
      }
    } else {
      if t == ret || t == inner { return 0 }
      tys.push(t)
      fixed.push(!listLitFresh(r))
    }
  }
  if !retValuesCover(inner, tys) { return 0 }
  noteRetJoin(ret, tys, fixed)
}

// Whether every non-null member of the join `inner` is a member of one of the values `tys`: a
// value whose node type does not show what it yields leaves the join without a return set.
function retValuesCover(inner: i32, tys: i32[]): boolean {
  const want: i32[] = []
  flattenVariantsInto(inner, want)
  const have: i32[] = []
  for t in tys { flattenVariantsInto(t, have) }
  for w in want {
    if !isNullTy(w) {
      let found = false
      for h in have {
        if h == w || sameVariantTy(h, w) { found = true }
      }
      if !found { return false }
    }
  }
  true
}

// Deep substitution of a call's bindings into a type: a bound `TyVar` becomes its binding; a
// derived return hole collapses to the pinned function's return. Composites rebuild only when
// a child actually changed, so a concrete type keeps its arena identity (and the in-place
// pinning semantics that ride on it). A cyclic arena (a recursive named type) returns itself unchanged.
export function substTyDeep(tyIx: i32, bNames: string[], bTys: i32[]) {
  if tyIx < 0 || bNames.length == 0 { return tyIx }
  const t = T.tys[tyIx]
  if t is TyVar {
    if substNestMode != SUBST_ALL && !substBindsNestRow(tyIx, t.tvName) {
      return tyIx
    }
    const b = substHoleTy(tyIx, bNames, bTys)
    if b >= 0 { return b }
    return tyIx
  }
  let si = stSeenStack.length - 1
  while si >= 0 {
    if stSeenStack[si] == tyIx { return tyIx }
    si = si - 1
  }
  stSeenStackPush(tyIx)
  let res = tyIx
  if t is TyArray {
    const e2 = substTyDeep(t.aElem, bNames, bTys)
    // A `readonly T[]` stays a view once `T` is bound, or its covariance is lost.
    if e2 != t.aElem {
      if t.aRead == 1 { res = mkArrayViewTy(e2) } else { res = mkArrayTy(e2) }
    }
  } else if t is TyNullable {
    let n2 = substTyDeep(t.nInner, bNames, bTys)
    if (
      n2 != t.nInner
      && t.nInner >= 0
      && tpJoinUnions.has(tyIx)
      && T.tys[t.nInner] is TyUnion
    ) {
      // A kept-apart join's null wraps its union: the members re-join as one set (D3267).
      let key = tyIx
      if !tpRetJoinTys.has(tyIx) { key = t.nInner }
      let nms: i32[] = []
      let nFixed: boolean[] = []
      const vals: i32[] = []
      const recorded = retJoinMembersAt(key, bNames, bTys, nms, nFixed, vals)
      if !recorded {
        nms = []
        nFixed = []
        flattenVariantsInto(n2, nms)
        for _ in nms { nFixed.push(true) }
      }
      const tpSaved = tpApartConcrete
      tpApartConcreteSet(true)
      njRejoinApartSet((tpJoinUnions.get(tyIx) ?? 0) == 2)
      n2 = rejoinMembers(nms, nFixed)
      tpApartConcreteSet(tpSaved)
      if recorded { carryRetJoin(n2, key, vals) }
    }
    if n2 != t.nInner { res = mkNullableTy(nullableFlatInner(n2)) }
  } else if t is TyObj {
    const onames = t.objFieldNames
    const otys = t.objFieldTypes
    const out: i32[] = []
    let changed = false
    let i = 0
    while i < otys.length {
      const f2 = substTyDeep(otys[i], bNames, bTys)
      if f2 != otys[i] { changed = true }
      out.push(f2)
      i = i + 1
    }
    if changed {
      const nn: string[] = []
      let j = 0
      while j < onames.length {
        nn.push(onames[j])
        j = j + 1
      }
      res = mkObjTy(nn, out)
    }
  } else if t is TyFunc {
    const ps = t.fnParamTypes
    const out2: i32[] = []
    let changed2 = false
    let k = 0
    while k < ps.length {
      const p2 = substTyDeep(ps[k], bNames, bTys)
      if p2 != ps[k] { changed2 = true }
      out2.push(p2)
      k = k + 1
    }
    const r2 = substTyDeep(t.fnRet, bNames, bTys)
    if r2 != t.fnRet { changed2 = true }
    if changed2 { res = mkFuncTy(out2, r2) }
  } else if t is TyUnion {
    const ms = t.uMembers
    const out3: i32[] = []
    let changed3 = false
    let u = 0
    while u < ms.length {
      const m2 = substTyDeep(ms[u], bNames, bTys)
      if m2 != ms[u] { changed3 = true }
      out3.push(m2)
      u = u + 1
    }
    // A deferred join re-folds: every provably dead member drops and the rest re-joins,
    // checked even when nothing changed — an unresolved member is dead precisely because it did not resolve.
    if isJoinHoleUnion(tyIx) {
      res = refoldJoinUnion(tyIx, ms, out3, changed3, bNames, bTys)
    } else if changed3 && tpJoinUnions.has(tyIx) {
      // A union the return-set join kept apart re-joins under the same rule (D2784).
      let ums: i32[] = []
      let uFixed: boolean[] = []
      const vals: i32[] = []
      const recorded = retJoinMembersAt(tyIx, bNames, bTys, ums, uFixed, vals)
      if !recorded {
        ums = out3
        uFixed = []
        for _ in out3 { uFixed.push(true) }
      }
      const tpSaved = tpApartConcrete
      tpApartConcreteSet(true)
      njRejoinApartSet((tpJoinUnions.get(tyIx) ?? 0) == 2)
      res = rejoinMembers(ums, uFixed)
      tpApartConcreteSet(tpSaved)
      if recorded { carryRetJoin(res, tyIx, vals) }
    } else if changed3 {
      // A null the substitution put inside the union (`(A | null) | B`, or `A | B` at `A := T |
      // null`) folds out to one nullable wrapper over the rest, in member order (D3504, D3502).
      const src = substUnionNullFolded(tyIx, ms, out3)
      const wrapNull = src.length > 0
      // Dedupes by arena-index identity only (not `sameVariantTy`) then rebuilds: substitution
      // can make two members the same type, and matching structurally here would merge members this walk must leave alone (the mixed-union arena shape is load-bearing).
      let dms = out3
      if wrapNull { dms = src }
      const uniq: i32[] = []
      let q = 0
      while q < dms.length {
        let seen = false
        let w = 0
        while w < uniq.length {
          if uniq[w] == dms[q] { seen = true }
          // `T[] | i32[]` at `T := i32` is one list; the substituted `T[]` is a fresh index (D2818).
          if !wrapNull && substListTwin(uniq[w], dms[q]) { seen = true }
          if wrapNull && substListTwinNominal(uniq[w], dms[q]) { seen = true }
          w = w + 1
        }
        if !seen { uniq.push(dms[q]) }
        q = q + 1
      }
      // The third union-construction site needing the same subsumed-arm collapse
      // (`unionArmSubsumedBy`) as `annUnionInnerTy` and `fillTypeDeclAt`'s `UnionDecl` arm —
      // the index dedup above cannot see a value-level duplicate like `T | "err"` at `T :=
      // string`. `out` is read unconditionally; treating it as optional would double the member list.
      const kept3: i32[] = []
      unionDropSubsumedArms(uniq, kept3)
      // A type argument can make a set and a same-rep map meet in one union (D2673); the
      // node whose check substituted reports it (`checkNodeDone`).
      const sclash = setMapUnionClashMsg(kept3, false)
      if sclash != "" { joinClashMsgSet(sclash) }
      if kept3.length == 1 { res = kept3[0] } else { res = mkUnionTy(kept3) }
      if wrapNull { res = substNullableOver(out3, res) }
    }
  } else if t is TyMap {
    const k2 = substTyDeep(t.mKey, bNames, bTys)
    const v2 = substTyDeep(t.mVal, bNames, bTys)
    if k2 != t.mKey || v2 != t.mVal { res = mkMapTy(k2, v2, t.mSet) }
  } else if t is TyNeg {
    const g2 = substTyDeep(t.negTy, bNames, bTys)
    if g2 != t.negTy { res = mkNegTy(g2) }
  }
  stSeenStackPop()
  // Carries the application provenance across substitution (D949): the rebuilt type is a
  // fresh arena index the provenance bank does not know about unless re-banked here, or the same type renders under two different names depending which door it came through.
  genAppCarry(tyIx, res, bNames, bTys)
  res
}

// ── free index-operator resolution (B14) ─────────────────────────────────────

// The index-operator function `op` dispatches to for a receiver of type `recvTy` — the first
// declaration whose `self` parameter accepts it, or "" when none does. First-declared wins,
// reachable only when two declared receivers both accept one value (one structurally
// assignable to the other); a nominal newtype is never in that position, since a brand accepts only itself.
export function opIdxFnFor(op: string, recvTy: i32) {
  if recvTy < 0 { return "" }
  let i = 0
  while i < opIdxFns.length {
    if opIdxOps[i] == op {
      const nm = opIdxFns[i]
      const fnTy = lookup(nm)
      if fnTy >= 0 {
        // Forces an un-annotated return past its pending sentinel here, exactly as the UFCS
        // and `a op b` resolutions do, so a call ahead of the declaration reads a real type.
        const preFt = T.tys[fnTy]
        if preFt is TyFunc {
          if preFt.fnRet == -2 {
            if !onInferStack(nm) {
              const dIx = fnDeclIx[nm] ?? -1
              if dIx >= 0 { checkNode(dIx) }
            }
          }
        }
        const ft = T.tys[fnTy]
        if ft is TyFunc {
          const ps = ft.fnParamTypes
          if ps.length > 0 {
            if assignable(recvTy, ps[0]) { return nm }
          }
        }
      }
    }
    i = i + 1
  }
  ""
}

// Binds the index operator's declared type parameters from the receiver and key types, the
// way `opSelfFnTy` binds a binary operator's. One `"[]"` function serves every instantiation,
// so its declared types are a template, not the site's own — taken verbatim, an unbound type
// variable would be check-clean and invalid at emit. `keyTy < 0` binds the receiver alone (the write arm).
function opIdxBindGen(
  fn: string,
  recvTy: i32,
  keyTy: i32,
  bNames: string[],
  bTys: i32[],
) {
  const fnTy = lookup(fn)
  if fnTy >= 0 {
    const ft = T.tys[fnTy]
    if ft is TyFunc {
      const ps = ft.fnParamTypes
      if ps.length > 0 { bindGenWalk(ps[0], recvTy, bNames, bTys) }
      if ps.length > 1 {
        if keyTy >= 0 { bindGenWalk(ps[1], keyTy, bNames, bTys) }
      }
    }
  }
}

// The receiver-keyed declaration name for binary operator `op` whose `self` parameter accepts
// left-operand type `lt`, or "" — the receiver-directed scan of the operator registry
// (`opIdxFns`), the twin of `opIdxFnFor` for a binary operator. Several receiver types may each
// declare `op`; this picks the one the left operand is assignable to (B14 generalized).
export function opSelfFnKeyFor(op: string, lt: i32): string {
  if lt < 0 { return "" }
  let i = 0
  while i < opIdxFns.length {
    if opIdxOps[i] == op {
      const nm = opIdxFns[i]
      const fnTy = lookup(nm)
      if fnTy >= 0 {
        // Force an un-annotated return past its pending sentinel, as `opIdxFnFor` and the
        // bare `a op b` resolution do, so a call ahead of the declaration reads a real type.
        const preFt = T.tys[fnTy]
        if preFt is TyFunc {
          if preFt.fnRet == -2 {
            if !onInferStack(nm) {
              const dIx = fnDeclIx[nm] ?? -1
              if dIx >= 0 { checkNode(dIx) }
            }
          }
        }
        const ft = T.tys[fnTy]
        if ft is TyFunc {
          const ps = ft.fnParamTypes
          if ps.length > 0 {
            if assignable(lt, ps[0]) { return nm }
          }
        }
      }
    }
    i = i + 1
  }
  ""
}

// Operator dispatch `a op b` over a struct left operand through the free `self`-function
// named for the operator: the function must exist, take exactly `(self, right)`, with its
// first parameter named `self`. Binds the operands into the function's holes like any call
// and substitutes the return; -1 means no such function fits, and the caller falls through to the operator-field lookup or the native numeric paths.
function opSelfFnTy(op: string, lt: i32, rt: i32, rightIx: i32, ix: i32) {
  // Receiver-directed: the declaration whose `self` accepts the LEFT operand's type, from the
  // operator registry keyed on `(symbol, receiver)` (B14 generalized from `[]`/`[]=`). Several
  // receiver types may each declare `op`; the left operand picks which. One declaration
  // resolves to the same target a bare `lookup(op)` would, so single-receiver bytes are unchanged.
  const opKey = opSelfFnKeyFor(op, lt)
  if opKey == "" { return -1 }
  const fnTy = lookup(opKey)
  if fnTy < 0 { return -1 }
  // Bank the receiver-keyed name for the emitter, so `a + b` lowers to the exact declaration
  // resolved here rather than a bare-name re-scan that a merge could rewrite differently.
  opBinBank(ix, opKey)
  const preFt = T.tys[fnTy]
  if preFt is TyFunc {
    if preFt.fnRet == -2 {
      if !onInferStack(opKey) {
        const dIx = fnDeclIx[opKey] ?? -1
        if dIx >= 0 { checkNode(dIx) }
      }
    }
  } else {
    return -1
  }
  const dIx2 = fnDeclIx[opKey] ?? -1
  if dIx2 < 0 { return -1 }
  const d = P.nodes[dIx2]
  let selfOk = false
  if d is FuncDecl {
    if d.fnParams.length == 2 {
      const p0 = P.nodes[d.fnParams[0]]
      if p0 is Param {
        if p0.parName == "self" { selfOk = true }
      }
    }
  }
  if !selfOk { return -1 }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    let retTy = ft.fnRet
    if retTy == -2 { retTy = TY_ERR }
    const params = ft.fnParamTypes
    if params.length != 2 { return -1 }
    if !assignable(lt, params[0]) { return -1 }
    const bNames: string[] = []
    const bTys: i32[] = []
    const p0t = T.tys[params[0]]
    if p0t is TyVar {
      if !holeDemandOk(p0t.tvName, -1, lt) { return -1 }
    }
    bindGenWalk(params[0], lt, bNames, bTys)
    bindGenWalk(params[1], rt, bNames, bTys)
    const expected = substTyDeep(params[1], bNames, bTys)
    const p1t = T.tys[params[1]]
    if p1t is TyVar {
      if !holeDemandOk(p1t.tvName, rightIx, rt) {
        tErr(
          "operator '"
            + op
            + "': expected "
            + holeDemandStr(p1t.tvName)
            + ", got "
            + tyToStr(rt),
          ix,
        )
      }
    }
    if !assignableExpr(rightIx, rt, expected) {
      tErr(
        "operator '"
          + op
          + "': expected "
          + tyToStr(expected)
          + ", got "
          + tyToStr(rt),
        ix,
      )
    }
    if bNames.length > 0 { retTy = substTyDeep(retTy, bNames, bTys) }
    return retTy
  }
  -1
}

// The ELEMENT type a spread contributes: `...ys` over `ys: T[]` gives `T`. A `readonly` view
// spreads too — the destination list is fresh, so nothing the view forbids is laundered.
// Returns -1 for an empty-list source (element not yet known) and TY_ERR after refusing one
// that is not a list at all.
function spreadElemTy(spdIx: i32) {
  const inner = spreadArgOf(spdIx)
  if inner < 0 { return TY_ERR }
  const st = checkNode(inner)
  if st < 0 { return TY_ERR }
  const t = T.tys[st]
  if t is TyArray { return t.aElem }
  let note = ""
  if st == TY_STR { note = " — a string is not a list of characters in VL" }
  tErr("`...` spreads a list, and this is " + tyToStr(st) + note, inner)
  TY_ERR
}

// True, having reported, when a rest parameter's element is an unbound HOLE and the packed
// list's element joined to a union that BOXES. `T` would pin to that union and the instance
// the monomorphizer mints for it misbuilds — check-clean invalid wasm, the worst outcome
// there is — so it is refused at the pin, naming the concrete spelling that runs (D1851).
function restHoleUnionErr(pTy: i32, packIx: i32, ix: i32): boolean {
  const pe = tyArrayElemIx(pTy)
  if pe < 0 || pe >= T.tys.length { return false }
  const pt = T.tys[pe]
  if pt is TyVar {
    const at = tyArrayElemIx(checkNode(packIx))
    if at < 0 || at >= T.tys.length { return false }
    const a = T.tys[at]
    if a is TyUnion {
      if unionRidesI32Spine(at) { return false }
      tErr(
        "a rest parameter's element is inferred from the arguments, and these join to "
          + tyToStr(at)
          + " — a boxed union a type parameter cannot be pinned to. Spell the element out, "
          + "`...xs: ("
          + tyToStr(at)
          + ")[]`, or pass one element type",
        ix,
      )
      return true
    }
  }
  false
}

// Rewrite `f(a, b, c)` into `f(a, [b, c])` when `f`'s last parameter is a rest one, in place,
// so every later reader — this function's index-parallel loop, the monomorphizer's positional
// column, the emitter's list-literal path — sees an ordinary fixed-arity call. Returns false
// when it refused; `callIsRestPacked` is what stops it running twice.
function restCallPack(n: Call, ix: i32, restIx: i32) {
  const args = n.callArgs
  if hasNamedArgs(n.callArgNames) {
    tErr(
      "a named argument binds one parameter and a rest parameter is many, so a call "
        + "that reaches a rest parameter is positional",
      ix,
    )
    return false
  }
  const head: i32[] = []
  let i = 0
  while i < restIx {
    head.push(args[i])
    i = i + 1
  }
  const tail: i32[] = []
  while i < args.length {
    tail.push(args[i])
    i = i + 1
  }
  // The packed list reports at the first argument it swallows, so an element mismatch points
  // there rather than at the end of the file; with nothing to swallow it takes the call's.
  const lst = mkArrayLit(tail, n.pos)
  // The pack is checked as the rest argument, and its type is recorded like any argument's.
  while nodeTyIx.length <= lst { nodeTyIx.push(-1) }
  if tail.length > 0 {
    adoptNodeTok(lst, tail[0])
  } else {
    adoptNodeTok(lst, ix)
  }
  head.push(lst)
  n.callArgs = head
  const names: string[] = []
  n.callArgNames = names
  markCallRestPacked(ix)
  // Stamp the arena: the parse bank must not serve a cached tree by popping the rows this
  // appended, which would leave `callArgs` pointing past the truncation and make every name
  // inside the packed list read as unused.
  arenaNoteEdit(ix)
  true
}

// Declaration-side validation of parameter defaults (`paramTys` aligns 1:1 with `params`).
// Defaults are direct-call-site sugar — substituted into an omitting call before emit, so the
// ABI stays untouched — enforced as four rules: trailing-only (a defaulted parameter may not
// precede one without), annotated (disjoint from inference holes), non-generic, and literal.
function checkParamDefaults(n: FuncDecl, params: i32[], paramTys: i32[]) {
  let sawDefault = false
  let pi = 0
  while pi < params.length {
    const p = P.nodes[params[pi]]
    if p is Param {
      const dIx = p.parDefault
      if dIx < 0 {
        if sawDefault {
          tErr(
            "parameter `"
              + p.parName
              + "` has no default but follows one that does — defaults must be the LAST parameters",
            params[pi],
          )
        }
      } else {
        sawDefault = true
        if p.parType < 0 {
          tErr(
            "a default value needs a type annotation — write `"
              + p.parName
              + ": T = …`",
            params[pi],
          )
        } else if tsMentionsAnyName(annTsOf(p.parType), n.fnTyParams) {
          tErr(
            "parameter `"
              + p.parName
              + "` cannot have a default: its type names a type parameter of `"
              + n.fnName
              + "`, which an omitted argument would leave unbound",
            params[pi],
          )
        }
        let pt = TY_ERR
        if pi < paramTys.length { pt = paramTys[pi] }
        if paramDefaultIsCallsite(dIx) {
          // `__callsite__` is never checked as an expression — what is checked is the
          // destination, so the error surfaces here rather than at somebody else's call site.
          identSet(dIx, IDENT_BUILTIN)
          if pt >= 0 && !tyIsCallerLoc(pt) {
            tErr(
              "parameter `"
                + p.parName
                + "` is `__callsite__`, so its type must be `{ file: string, line: i32, col: i32 }` — got "
                + tyToStr(pt),
              dIx,
            )
          }
        } else if !paramDefaultIsLiteral(dIx) {
          tErr(
            "a default value must be a literal, a module-level `const`, or `__callsite__` — `"
              + p.parName
              + "`'s default is substituted at each call site, so it cannot name a parameter, a local, or a call",
            dIx,
          )
        } else {
          seedExpected(dIx, pt)
          const dt = checkNode(dIx)
          // Delivered like an argument, so a literal takes the parameter's type (`x: f32 = 0.1`).
          if pt >= 0 && !assignableExpr(dIx, dt, pt) {
            tErr(
              "parameter `"
                + p.parName
                + "` default: expected "
                + tyToStr(pt)
                + ", got "
                + tyToStr(dt),
              dIx,
            )
          }
        }
      }
    }
    pi = pi + 1
  }
  0
}

// Binds a call's arguments into parameter order when any is named (`f(b: 1, a: 2)`): named
// args fill their parameter's slot, positionals fill what remains in order. Returns the
// value-node indices in parameter order, or an empty list on a binding failure (an
// unknown/duplicate name, diagnosed here). A slot with neither an argument nor a default names the parameter it is missing.
function orderNamedCallArgs(
  paramNames: string[],
  args: i32[],
  argNames: string[],
  ix: i32,
  declParams: i32[],
) {
  const bad: i32[] = []
  if paramNames.length < args.length {
    // Arity is diagnosed by the caller; just refuse to reorder.
    tErr("named arguments require a declared function with matching arity", ix)
    return bad
  }
  const ordered = orderArgsByParamNames(paramNames, args, argNames)
  if namedOrderRefused(paramNames, args, argNames, ordered) { return bad }
  if ordered.length != paramNames.length {
    tErr("named argument does not match a parameter", ix)
    return bad
  }
  const missing = fillArgDefaults(ordered, declParams, ix)
  if missing >= 0 {
    let who = ""
    if missing < paramNames.length { who = paramNames[missing] }
    tErr("missing argument for parameter `" + who + "`", ix)
    return bad
  }
  ordered
}

// The Q8 rule (D4061): a positional argument lands at its written index, so it may follow named
// ones only when each sits in its own parameter's position, and a name may not take a parameter
// a positional argument filled. A method call's `paramNames` leaves the receiver out, which is
// position 0. Raises the first fault left to right; true when it raised.
function namedOrderRefused(
  paramNames: string[],
  args: i32[],
  argNames: string[],
  ordered: i32[],
) {
  let outAt = -1
  let outK = -1
  let j = 0
  while j < args.length {
    const nm = callArgNameAt(argNames, j)
    if nm == "" {
      if outAt >= 0 {
        tErrCodedData(
          "`"
            + callArgNameAt(argNames, outAt)
            + "` is parameter "
            + i32ToStr(outK + 1)
            + " but is written in position "
            + i32ToStr(outAt + 1)
            + namedOrderSlotOwner(paramNames, outAt)
            + "; name the arguments after it, or move it",
          args[j],
          CODE_NAMED_ARG_OUT_OF_POSITION,
          namedOrderFixData(paramNames, args, argNames, ordered, outAt),
        )
        return true
      }
    } else {
      const k = paramIndexOfName(paramNames, nm)
      if k < paramNames.length && k != j {
        if k < j && callArgNameAt(argNames, k) == "" {
          tErr(
            "`"
              + nm
              + "` is already given by the positional argument in position "
              + i32ToStr(k + 1)
              + "; give it once",
            args[j],
          )
          return true
        }
        if outAt < 0 {
          outAt = j
          outK = k
        }
      }
    }
    j = j + 1
  }
  false
}

// —— constraints phase 1: bounds ————————————————————————————————————————————
// A validation layer over machinery that already lowers: the body resolves a generic bound
// member against the bound, the instantiation site resolves it against the argument, and the
// two must agree — a mismatch is check-clean invalid wasm without this layer (D1001).

// The bound's members, as three parallel columns filled in source order: `names[i]`, `tys[i]`
// (the call's function type for a method, or the field's declared type for a colon member),
// and `isMethod[i]`. A zero-ary closure field satisfies a method bound by construction, but not
// the converse — a UFCS-satisfied value carries no closure (`docs/constraints-design.md` OQ-1).
function boundMembersOf(
  root: i32,
  names: string[],
  tys: i32[],
  isMethod: boolean[],
) {
  if root < 0 { return 0 }
  const start = tsKidStart[root]
  const cnt = tsKidCount[root]
  let i = 0
  while i < cnt {
    const kid = tsKids[start + i]
    const k = tsKind[kid]
    if k == TS_METHOD {
      const ks = tsKidStart[kid]
      const kc = tsKidCount[kid]
      const ptys: i32[] = []
      let p = 0
      while p < kc - 1 {
        ptys.push(tsToTy(tsKids[ks + p]))
        p = p + 1
      }
      names.push(tsText[kid])
      tys.push(mkFuncTy(ptys, tsToTy(tsKids[ks + kc - 1])))
      isMethod.push(true)
    } else if k == TS_FIELD {
      names.push(tsText[kid])
      tys.push(tsToTy(tsKids[tsKidStart[kid]]))
      isMethod.push(false)
    }
    i = i + 1
  }
  0
}

// The member list a bound offers, rendered for a diagnostic: `toString(), n`.
function boundMemberList(root: i32) {
  const bn: string[] = []
  const bt: i32[] = []
  const bm: boolean[] = []
  boundMembersOf(root, bn, bt, bm)
  let out = ""
  let i = 0
  while i < bn.length {
    if i > 0 { out = out + ", " }
    out = out + bn[i]
    if bm[i] { out = out + "()" }
    i = i + 1
  }
  out
}

// —— the witness: satisfaction is the existing call resolution ————————————————
// `x.m(a)` under a bound resolves by the same order every method call uses — a field of the
// receiver first, then a free `self`-function in scope. Returns a stable string naming which
// won (`"field"`, the mangled `self`-function name, or `""`) — the coherence key's value and the words the disagreement diagnostic prints (resolved in the instantiation site's own module scope, D1191).
function witnessOf(memberName: string, wantTy: i32, concTy: i32, ix: i32) {
  if concTy < 0 || wantTy < 0 { return "" }
  const ct = T.tys[concTy]
  if ct is TyObj {
    const ft = objFieldType(ct, memberName)
    if ft >= 0 {
      if assignable(ft, wantTy) { return "field" }
      return ""
    }
  }
  const mangled = ufcsAliasInScope(ix, memberName)
  const fnTy = lookup(mangled)
  if fnTy < 0 { return "" }
  const ft2 = T.tys[fnTy]
  if ft2 is TyFunc {
    const wt = T.tys[wantTy]
    if wt is TyFunc {
      // The receiver occupies slot 0 and the bound's arguments fill the rest —
      // the arity `ufcsCallTy` enforces, asked here of a type rather than of a
      // node so it can be asked before any call exists.
      if ft2.fnParamTypes.length != wt.fnParamTypes.length + 1 { return "" }
      if !assignable(concTy, ft2.fnParamTypes[0]) { return "" }
      let i = 0
      while i < wt.fnParamTypes.length {
        if !assignable(wt.fnParamTypes[i], ft2.fnParamTypes[i + 1]) {
          return ""
        }
        i = i + 1
      }
      // A callee whose return is still pending (-2) has not been inferred yet; force it,
      // exactly as `ufcsCallTy` does, so an un-annotated std export's real type is known here rather than guessed.
      let retTy = ft2.fnRet
      if retTy == (-2) {
        if !onInferStack(mangled) {
          const dIx = fnDeclIx[mangled] ?? -1
          if dIx >= 0 {
            checkNode(dIx)
            const re = T.tys[lookup(mangled)]
            if re is TyFunc { retTy = re.fnRet }
          }
        }
      }
      if !assignable(retTy, wt.fnRet) { return "" }
      return mangled
    }
  }
  ""
}

// Record this site's witness for (generic, instantiation type, member) and refuse
// a DISAGREEMENT, naming both sites and both witnesses. Returns true when the row
// is coherent (including the first time it is written).
function cohRecord(
  who: string,
  tyKey: string,
  memberName: string,
  wit: string,
  ix: i32,
) {
  const key = who + "#" + tyKey + "#" + memberName
  let i = 0
  while i < cohKeys.length {
    if cohKeys[i] == key {
      if cohWitness[i] == wit { return true }
      tErr(
        "incoherent bound: `"
          + who
          + "` instantiated at `"
          + tyKey
          + "` resolves `"
          + memberName
          + "` to `"
          + cohWitness[i]
          + "` at line "
          + i32ToStr(cohSiteLine[i])
          + ":"
          + i32ToStr(cohSiteCol[i] + 1)
          + " and to `"
          + wit
          + "` here — one generic at one type must have ONE witness across the whole program",
        ix,
      )
      return false
    }
    i = i + 1
  }
  cohKeys.push(key)
  cohWitness.push(wit)
  let ln = 0
  let co = 0
  if ix >= 0 && ix < nodeToks.length {
    const tk = nodeToks[ix]
    if tk >= 0 && tk < P.toks.length {
      ln = P.toks[tk].line
      co = P.toks[tk].col
    }
  }
  cohSiteLine.push(ln)
  cohSiteCol.push(co)
  true
}

// Subsumption: does the bound on `srcTp` grant everything the callee's bound `dstAnn`
// demands? Every member of the callee's bound must appear in the caller's with an assignable
// type and the same kind — a colon member is a layout demand, a method a callability demand,
// and a method does not satisfy a field. A caller parameter with no bound grants nothing.
function checkBoundSubsumes(
  srcTp: string,
  dstTp: string,
  dstAnn: i32,
  who: string,
  ix: i32,
) {
  const dstRoot = boundObjRootOf(dstAnn)
  if dstRoot < 0 { return 0 }
  const dn: string[] = []
  const dt: i32[] = []
  const dm: boolean[] = []
  boundMembersOf(dstRoot, dn, dt, dm)
  const srcAnn = tpBoundOfName(srcTp)
  const srcRoot = boundObjRootOf(srcAnn)
  const sn: string[] = []
  const st: i32[] = []
  const sm: boolean[] = []
  boundMembersOf(srcRoot, sn, st, sm)
  let d = 0
  while d < dn.length {
    let ok = false
    let s = 0
    while s < sn.length {
      if sn[s] == dn[d] && sm[s] == dm[d] {
        if st[s] >= 0 && dt[d] >= 0 {
          if assignable(st[s], dt[d]) { ok = true }
        }
      }
      s = s + 1
    }
    if !ok {
      let has = "`" + srcTp + "` is unbounded"
      if srcAnn >= 0 {
        has = "`"
          + srcTp
          + "`'s bound `"
          + boundText(srcAnn)
          + "` grants `"
          + boundMemberList(srcRoot)
          + "`"
      }
      let want = dn[d]
      if dm[d] { want = dn[d] + "()" }
      tErr(
        "`"
          + who
          + "` needs `"
          + dstTp
          + ": "
          + boundText(dstAnn)
          + "`, which demands `"
          + want
          + "` — but "
          + has
          + ". Add it to `"
          + srcTp
          + "`'s bound",
        ix,
      )
      return 0
    }
    d = d + 1
  }
  0
}

// The instantiation-site check: for each bounded type parameter the call actually bound,
// resolves every bound member against the concrete type in this site's scope and refuses
// what nothing satisfies. The bound's own member types resolve with the parameter bound to
// the concrete type, which is what makes `{ eq(T): boolean }` mean "eq takes another one of me" at each instantiation with no self-type machinery.
function checkBoundsAtCall(
  who: string,
  declIx: i32,
  bNames: string[],
  bTys: i32[],
  ix: i32,
) {
  if declIx < 0 { return 0 }
  if !fnHasTpBound(declIx) { return 0 }
  const dn = P.nodes[declIx]
  if !(dn is FuncDecl) { return 0 }
  let k = 0
  while k < dn.fnTyParams.length {
    const bAnn = fnTpBoundOf(declIx, k)
    if bAnn >= 0 {
      const tpName = dn.fnTyParams[k]
      let conc = -1
      let bi = 0
      while bi < bNames.length {
        if bNames[bi] == tpName { conc = bTys[bi] }
        bi = bi + 1
      }
      // Chaining through another generic's own type parameter has no instantiation type to
      // resolve a witness against, so it is decided by subsumption instead — statically,
      // which lands the error on the declaration that is wrong rather than a distant caller.
      // Bounds are free at emit once substitution has run; the check is what needs this, since a bounded generic relayed through an unbounded one has no pin left to ask (`vl check`-clean and invalid).
      if conc >= 0 {
        const ct0 = T.tys[conc]
        if ct0 is TyVar {
          if ct0.tvName.length > 0 {
            if ct0.tvName[0] != '?' {
              checkBoundSubsumes(ct0.tvName, tpName, bAnn, who, ix)
              k = k + 1
              continue
            }
          }
        }
      }
      if conc >= 0 && !tyHasHole(conc) {
        const root = boundObjRootOf(bAnn)
        if root < 0 {
          tErr(
            "`"
              + boundText(bAnn)
              + "` is not a bound — a bound is a type with method members (`type "
              + boundText(bAnn)
              + " = { m(): R }`) or an inline `{ m(): R }`",
            ix,
          )
        } else {
          // Bind the parameter to the CONCRETE type while the bound's member
          // types resolve, so a self-referential member means what it says here.
          tpEnvNames.push(tpName)
          tpEnvTys.push(conc)
          const bn: string[] = []
          const bt: i32[] = []
          const bm: boolean[] = []
          boundMembersOf(root, bn, bt, bm)
          tpEnvNames.pop()
          tpEnvTys.pop()
          const tyKey = tyToStr(conc)
          const bCovs: string[] = []
          let m = 0
          while m < bn.length {
            let wit = ""
            // An unresolved member type is the alias-self-reference case, reported at the
            // declaration (the body's own use raised it) rather than adding a second voice here.
            if bt[m] < 0 {
              m = m + 1
              continue
            }
            if bm[m] {
              wit = witnessOf(bn[m], bt[m], conc, ix)
            } else {
              // A COLON member is a layout demand and stays one: the value must
              // carry the field, which is ordinary structural assignability.
              const ct = T.tys[conc]
              if ct is TyObj {
                const ft = objFieldType(ct, bn[m])
                if ft >= 0 {
                  if assignable(ft, bt[m]) {
                    wit = "field"
                    rcwCovs(ft, bt[m], "." + bn[m], bCovs, 0)
                  }
                }
              }
            }
            const gBound = getterFnFor(conc, bn[m])
            if wit == "" && gBound != "" {
              tErr(
                tyKey
                  + " does not satisfy `"
                  + boundText(bAnn)
                  + "`: "
                  + getterBoundNote(gBound, bm[m]),
                ix,
              )
            } else if wit == "" && !bm[m] {
              tErr(
                tyKey
                  + " does not satisfy `"
                  + boundText(bAnn)
                  + "`: no field `"
                  + bn[m]
                  + ": "
                  + tyToStr(bt[m])
                  + "` — a field bound is satisfied only by a stored field; to accept a `"
                  + bn[m]
                  + "(self: "
                  + tyKey
                  + ")` function, bound on `{ "
                  + bn[m]
                  + "(): "
                  + tyToStr(bt[m])
                  + " }`",
                ix,
              )
            } else if wit == "" {
              let what = bn[m]
              if bm[m] { what = bn[m] + "(): " + tyToStr(retOfFuncTy(bt[m])) }
              tErr(
                tyKey
                  + " does not satisfy `"
                  + boundText(bAnn)
                  + "`: no `"
                  + what
                  + "` — the bound needs a field of that type or a `"
                  + bn[m]
                  + "(self: "
                  + tyKey
                  + ", …)` function in scope at this call",
                ix,
              )
            } else {
              cohRecord(who, tyKey, bn[m], wit, ix)
            }
            m = m + 1
          }
          // D2060 — a colon member wider than the argument's field is the covariant delivery
          // of a record, and the body writes through the bound's type.
          if bCovs.length > 0 && !inferQuiet {
            rcwBdDecl.push(declIx)
            rcwBdTp.push(tpName)
            rcwBdConc.push(conc)
            rcwBdCovs.push(rcwKey(bCovs))
            rcwBdCall.push(ix)
          }
        }
      }
    }
    k = k + 1
  }
  0
}

// The strict body (OQ-5, as ruled): inside `function f<T: B>(x: T)`, a member use on `x`
// resolves against `B`'s members and nothing else — `-1` when the bound has no such member,
// so the caller raises the refusal naming `B`. An unbounded `<T>` never reaches here; operator
// use is untouched, since the implicit `HD_BINOP` machinery is a separate mechanism (OQ-2).
function boundMemberTy(tvName: string, prop: string, wantCall: boolean) {
  const bAnn = tpBoundOfName(tvName)
  if bAnn < 0 { return -1 }
  const root = boundObjRootOf(bAnn)
  if root < 0 { return -1 }
  const bn: string[] = []
  const bt: i32[] = []
  const bm: boolean[] = []
  boundMembersOf(root, bn, bt, bm)
  let i = 0
  while i < bn.length {
    if bn[i] == prop {
      // Distinct from "no such member" (-1): `assignable` reads a negative side as "accept
      // anything", so feeding -1 here would make an unresolved bound silently accept every argument.
      if bt[i] < 0 { return BOUND_UNRESOLVED }
      // A method member is call-only (`x.m` alone has no closure to hand back); a field
      // member serves both spellings, since a field is a value and calling it calls the closure it holds.
      if bm[i] && !wantCall { return -1 }
      return bt[i]
    }
    i = i + 1
  }
  -1
}

// The refusal a strict body raises, naming the bound and what it offers. Returns
// "" when the receiver is not a bounded type parameter, so the caller keeps its
// existing (unbounded) answer.
function boundMemberFloorMsg(tvName: string, prop: string) {
  const bAnn = tpBoundOfName(tvName)
  if bAnn < 0 { return "" }
  const root = boundObjRootOf(bAnn)
  if root < 0 { return "" }
  const offers = boundMemberList(root)
  let has = "nothing"
  if offers.length > 0 { has = "`" + offers + "`" }
  "no `"
    + prop
    + "` on `"
    + tvName
    + "` — its bound `"
    + boundText(bAnn)
    + "` grants "
    + has
}

// Every type-parameter receiver's floor (`memberFloorMsg`'s `TyVar` rung). The domain is
// exactly "the annotation is not a bound" — `boundObjRootOf` answering -1 — since an unbounded
// `<T>` routes to inference before this rung and a real bound missing the member is answered
// one line up. Says only that: "…is not a type with members" is false of a field-member alias, which has members and simply declares no method ones.
function tpMemberFloorMsg(tvName: string, prop: string) {
  const bMsg = boundMemberFloorMsg(tvName, prop)
  if bMsg != "" { return bMsg }
  // An inference HOLE is not a declared parameter and owns no bound to name: it carries a
  // minted `?`-name the author never wrote, and `checkMemberNode` grows its shape rather
  // than reaching this floor. `memberFloorErr`'s own floor words it if one ever does.
  if tvName.length == 0 { return "" }
  if tvName[0] == '?' { return "" }
  "no `"
    + prop
    + "` on `"
    + tvName
    + "` — `"
    + boundText(tpBoundOfName(tvName))
    + "` is not a bound"
}

// Whether a UFCS call with `argc` explicit arguments on `recvTy` would dispatch to the free
// self-function merged as `mangled` (D1230) — mirrors `ufcsCallTy`'s gate arm for arm, and
// deliberately nothing after it, since this runs speculatively over every same-named candidate
// for a call that already failed and must not raise diagnostics or mutate inference state. A true answer is not a promise the call would compile, only the promise the message makes.
function ufcsWouldDispatch(mangled: string, recvTy: i32, argc: i32) {
  const fnTy = lookup(mangled)
  if fnTy < 0 { return false }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    const params = ft.fnParamTypes
    if params.length < 1 { return false }
    if !declFirstParamIsSelf(mangled) { return false }
    const uDecl = declParamsAfterSelf(mangled)
    let uRequired = params.length - 1
    if uDecl.length == params.length - 1 { uRequired = fnRequiredArity(uDecl) }
    // `ufcsCallTy`'s storage-type refusal: a `self` whose type parameter would bind `u8`.
    if tyIsU8ArrayTy(recvTy) {
      const bNames: string[] = []
      const bTys: i32[] = []
      bindGenWalk(params[0], recvTy, bNames, bTys)
      if tyReachesHole(substTyDeep(params[0], bNames, bTys), 8) { return false }
    }
    // The rest arm of `ufcsCallTy`'s gate, mirrored: a variadic callee's upper bound is
    // unbounded, and this speculative twin must agree about what dispatches.
    const uRest = restParamIndex(uDecl)
    if uRest >= 0 {
      let uLo = uRequired
      if uLo > uRest { uLo = uRest }
      if argc < uLo { return false }
      return assignable(recvTy, params[0])
    }
    if argc < uRequired || argc + 1 > params.length { return false }
    return assignable(recvTy, params[0])
  }
  false
}

// The comma-joined module specifiers that would make `recv.prop(argc args)` at call node `ix`
// resolve, or "" (D1230): the graph registry's rows in dependency-first order, then std's
// catalog (D3122), deduplicated. When the call's module binds `prop` as a function D1570
// explains (`ufcsSiteKind`), a plain one yields "" and a `self`-function drops the catalog.
function ufcsMissingImportSpecs(prop: string, recvTy: i32, argc: i32, ix: i32) {
  const specs: string[] = []
  const siteKind = ufcsSiteKind(ix, prop, recvTy, argc)
  if siteKind == 1 { return "" }
  let i = 0
  while i < ufcsImpName.length {
    if ufcsImpName[i] == prop {
      if ufcsWouldDispatch(ufcsImpMangled[i], recvTy, argc) {
        if !strListHas(specs, ufcsImpSpec[i]) { specs.push(ufcsImpSpec[i]) }
      }
    }
    i = i + 1
  }
  if siteKind == 0 { stdRecvSpecsInto(specs, prop, recvTy, argc) }
  let out = ""
  let j = 0
  while j < specs.length {
    if j > 0 { out = out + "," }
    out = out + specs[j]
    j = j + 1
  }
  out
}

// D1570's gate kind for `ufcsSiteFn`, or 0 (D3122). A plain function (1) answers ahead of
// every candidate module, since its author meant it as the method; any kind answers ahead of a
// std module the author never mentioned.
function ufcsSiteKind(ix: i32, prop: string, recvTy: i32, argc: i32) {
  ufcsNotMethodKind(ufcsSiteFn(ix, prop), recvTy, argc)
}

// D3122 — the std catalog's half of `ufcsMissingImportSpecs`: appends to `specs` each std
// module outside the registry whose `self`-function `prop` takes `argc` arguments and whose
// receiver annotation `recvTy` fits. Nothing of those modules is loaded, so the fit is read
// from the annotation's spelling (`stdRecvFits`) rather than from a declaration.
function stdRecvSpecsInto(
  specs: string[],
  prop: string,
  recvTy: i32,
  argc: i32,
) {
  if recvTy < 0 { return 0 }
  const rt = T.tys[recvTy]
  if rt is TyVar || rt is TyErr { return 0 }
  stdRecvLoad()
  let i = 0
  while i < stdRecvName.length {
    if (
      stdRecvName[i] == prop
      && !strListHas(specs, stdRecvSpec[i])
      && !ufcsRegistryHas(prop, stdRecvSpec[i])
      && argc >= stdRecvMin[i]
      && (stdRecvMax[i] < 0 || argc <= stdRecvMax[i])
      && stdRecvFits(stdRecvSelf[i], stdRecvTparams[i], recvTy)
    ) {
      specs.push(stdRecvSpec[i])
    }
    i = i + 1
  }
  0
}

// Whether a value of type `ty` is assignable to a catalog `self` annotation `spell`, whose
// type parameters are the `,`-joined `tparams`. The spelling holds only builtin leaves, those
// parameters, `[]`, a leading `readonly` and `|` (the generator's filter); a union annotation
// fits when every member of `ty` fits one of its members.
function stdRecvFits(spell: string, tparams: string, ty: i32) {
  let body = spell
  let ro = false
  if body.length > 9 && body.slice(0, 9) == "readonly " {
    ro = true
    body = body.slice(9, body.length)
  }
  const tps = stdRecvSplit(tparams, ',')
  const alts = stdRecvSplit(body, '|')
  const t = T.tys[ty]
  if alts.length > 1 && t is TyUnion {
    for m in t.uMembers {
      if !stdRecvFitsSome(alts, tps, m, ro) { return false }
    }
    return true
  }
  stdRecvFitsSome(alts, tps, ty, ro)
}

// Whether `ty` fits any one of the annotation members `alts`.
function stdRecvFitsSome(alts: string[], tps: string[], ty: i32, ro: boolean) {
  for a in alts {
    if stdRecvFitsOne(a, tps, ty, ro) { return true }
  }
  false
}

// Whether `ty` fits one annotation member `sp`: a type parameter anything but the storage type
// `u8`, which it never binds; `X[]` an array whose element is exactly `X` (a growable one unless
// `ro`); and a builtin leaf by `assignable`.
function stdRecvFitsOne(
  sp: string,
  tps: string[],
  ty: i32,
  ro: boolean,
): boolean {
  if ty < 0 { return false }
  if strListHas(tps, sp) { return ty != TY_U8 }
  if stdRecvIsList(sp) {
    const t = T.tys[ty]
    if t is TyArray {
      if !ro && t.aRead != 0 { return false }
      const inner = sp.slice(0, sp.length - 2)
      if strListHas(tps, inner) { return t.aElem != TY_U8 }
      if t.aElem < 0 { return false }
      return stdRecvFitsOne(inner, tps, t.aElem, false)
        && stdRecvLeafExact(inner, t.aElem)
    }
    return false
  }
  const lt = stdRecvLeafTy(sp)
  if lt < 0 { return false }
  assignable(ty, lt)
}

// An array element is invariant: `X[]` takes an element type `X` accepts and that accepts `X`.
// A nested `X[][]` element is decided by the recursion, so only a leaf is compared here.
function stdRecvLeafExact(sp: string, ty: i32): boolean {
  if stdRecvIsList(sp) { return true }
  const lt = stdRecvLeafTy(sp)
  lt >= 0 && assignable(lt, ty)
}

// A type parameter the callee's RETURN, or the signature of a function its body declares and
// uses, names and none of its PARAMETER annotations does: no argument can bind it. Callers skip
// a call with explicit type arguments. A DECLARED return is asked by its written spelling, an
// INFERRED one by `retTy`, the settled result the call site already holds (D1819).
function checkRetTyParamBound(declIx: i32, who: string, ix: i32, retTy: i32) {
  if inferQuiet { return 0 }
  if declIx < 0 { return 0 }
  const dn = P.nodes[declIx]
  if dn is FuncDecl {
    if dn.fnTyParams.length == 0 { return 0 }
    let rTs = -1
    if dn.fnRet >= 0 { rTs = annTsOf(dn.fnRet) }
    let k = 0
    while k < dn.fnTyParams.length {
      const one: string[] = [dn.fnTyParams[k]]
      let named = false
      if dn.fnRet >= 0 {
        if rTs >= 0 { named = tsMentionsAnyName(rTs, one) }
      } else {
        named = tyMentionsTyVarNamed(retTy, dn.fnTyParams[k], 8)
      }
      if named {
        if !anyParamMentionsTyParam(dn.fnParams, one) {
          let w = "the callee"
          if who != "" { w = "`" + who + "`" }
          let what = "'s return type names it"
          if dn.fnRet < 0 {
            what = "'s return type is inferred as `"
              + tyToStr(retTy)
              + "`, which names it,"
          }
          tErr(
            "cannot infer type parameter `"
              + dn.fnTyParams[k]
              + "`: "
              + w
              + what
              + " and no parameter does, so a call has nothing to bind it from — give `"
              + dn.fnTyParams[k]
              + "` a parameter position, or make the return type concrete",
            ix,
          )
          return 0
        }
      } else if !anyParamMentionsTyParam(dn.fnParams, one) {
        const inner = bodyFnParamNaming(dn.fnBody, dn.fnBody, one)
        if inner >= 0 {
          let w = "the callee"
          if who != "" { w = "`" + who + "`" }
          let what = "a function literal in its body takes it"
          const fdn = P.nodes[inner]
          if fdn is FuncDecl {
            if fdn.fnName != "" {
              what = "its body's function `" + fdn.fnName + "` takes it"
            }
          }
          const lname = bodyFnLetName(dn.fnBody, inner)
          if lname != "" {
            what = "its body's function `" + lname + "` takes it"
          }
          tErr(
            "cannot infer type parameter `"
              + dn.fnTyParams[k]
              + "`: no parameter of "
              + w
              + " names it, but "
              + what
              + " as a parameter type, so a call has nothing to bind it from — give `"
              + dn.fnTyParams[k]
              + "` a parameter position, or pass the type arguments explicitly",
            ix,
          )
          return 0
        }
        const retIx = bodyFnRetNaming(dn.fnBody, dn.fnBody, one)
        if retIx >= 0 {
          let w = "the callee"
          if who != "" { w = "`" + who + "`" }
          let what = "a function literal in its body returns it"
          const rdn = P.nodes[retIx]
          if rdn is FuncDecl {
            if rdn.fnName != "" {
              what = "its body's function `" + rdn.fnName + "` returns it"
            }
          }
          const rname = bodyFnLetName(dn.fnBody, retIx)
          if rname != "" {
            what = "its body's function `" + rname + "` returns it"
          }
          tErr(
            "cannot infer type parameter `"
              + dn.fnTyParams[k]
              + "`: no parameter of "
              + w
              + " names it, but "
              + what
              + ", so a call has nothing to bind it from — give `"
              + dn.fnTyParams[k]
              + "` a parameter position, or pass the type arguments explicitly",
            ix,
          )
          return 0
        }
      }
      k = k + 1
    }
  }
  0
}

// Runs the pending return inference of the function `name` binds, so its type is complete
// before a UFCS call reads it. False when `fnTy` is not a function at all.
function ufcsInferCallee(name: string, fnTy: i32): boolean {
  if fnTy < 0 { return false }
  const preFt = T.tys[fnTy]
  if preFt is TyFunc {
    if preFt.fnRet == -2 {
      if !onInferStack(name) {
        const dIx = fnDeclIx[name] ?? -1
        if dIx >= 0 { checkNode(dIx) }
      }
    }
    return true
  }
  false
}

// Whether `name` is a `self`-function whose declared `self` type accepts `recvTy`, raising no
// diagnostic — asked only of the type-bound candidate, once the scope's own has stepped aside.
function ufcsSelfAccepts(name: string, fnTy: i32, recvTy: i32): boolean {
  if fnTy < 0 { return false }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    if ft.fnParamTypes.length < 1 { return false }
    if !declFirstParamIsSelf(name) { return false }
    const p0 = ft.fnParamTypes[0]
    if p0 < 0 { return false }
    return assignable(recvTy, p0)
  }
  false
}

// The type of `self` under the call's bindings. `substTyDeep` rebuilds a list as a mutable
// one, so a `readonly T[]` parameter is re-wrapped as a view, or it would refuse its receiver.
function substSelfTy(p0: i32, bNames: string[], bTys: i32[]): i32 {
  const sub = substTyDeep(p0, bNames, bTys)
  if sub == p0 || p0 < 0 || sub < 0 { return sub }
  const pt = T.tys[p0]
  const st = T.tys[sub]
  if pt is TyArray {
    if st is TyArray {
      if pt.aRead == 1 && st.aRead == 0 { return mkArrayViewTy(st.aElem) }
    }
  }
  sub
}

// The `self`-function of set `row` a receiver of `recvTy` selects: the one whose head is the
// receiver's, else the one whose first parameter accepts it (a wider record), as a lone
// candidate would. "" when none does, "*" when several do. One lookup, after the receiver is
// typed, so the choice never feeds back into the receiver's inference.
export function ovPickFor(row: i32, recvTy: i32): string {
  const heads = ovRecvHeads(recvTy)
  let found = ""
  for c in ovSetCands[row] {
    if declFirstParamIsSelf(c) && strListHas(heads, ovFnHead[c] ?? "") {
      if found != "" { return "*" }
      found = c
    }
  }
  if found != "" || tyHasHole(recvTy) { return found }
  for c in ovSetCands[row] {
    if declFirstParamIsSelf(c) && ufcsSelfAccepts(c, lookup(c), recvTy) {
      if found != "" { return "*" }
      found = c
    }
  }
  found
}

// A member call whose receiver each instance supplies (an un-annotated or type-parameter
// receiver): the body types it by the one return type every candidate shares, and each pin
// picks and checks its own candidate (`ovPinCheck`), the choice the emitter makes per instance.
function ovHoleCallTy(row: i32, prop: string, recvTy: i32, n: Call, ix: i32) {
  let ret = -1
  let why = ""
  if !ufcsSitePinnable(ix, cstrOwnerTop()) {
    why = "the receiver is not a parameter of the function the call sits in"
  }
  const argc = n.callArgs.length
  for c in ovSetCands[row] {
    if why == "" && declFirstParamIsSelf(c) {
      const fty = lookup(c)
      if ufcsInferCallee(c, fty) {
        const ft = T.tys[fty]
        if ft is TyFunc {
          const req = fnRequiredArity(fnDeclParamsOf(c))
          if argc + 1 > ft.fnParamTypes.length || argc + 1 < req {
            why = "the candidates take different numbers of arguments"
          } else if (
            ft.fnRet < 0
            || tyHasHole(ft.fnRet)
            || tyHasTyVar(ft.fnRet)
          ) {
            why = "a candidate's return type depends on its receiver"
          } else if ret >= 0 && !tyEq(ret, ft.fnRet) {
            why = "the candidates return different types"
          } else {
            ret = ft.fnRet
          }
        }
      }
    }
  }
  if ret < 0 && why == "" { why = "no candidate takes a receiver" }
  if why != "" {
    tErr(
      ovChooseMsg(
        row,
        prop,
        " for a receiver each call supplies, because "
          + why
          + " — annotate the receiver",
      ),
      ix,
    )
    return TY_ERR
  }
  for a in n.callArgs { checkNode(a) }
  noteUfcsCstr(recvTy, prop, ix, -1)
  if !i32ListHas(ovHoleSites, ix) { ovHoleSitesPush(ix) }
  ret
}

// One instance's answer for the overloaded member call `site`, whose receiver this pin
// binds to `ur`: the candidate its head selects, its receiver and arguments checked under the
// pin, and the choice recorded per instance (`ovInstSite`) for the editor.
function ovPinCheck(
  site: i32,
  ur: i32,
  prop: string,
  bNames: string[],
  bTys: i32[],
  at: i32,
  uWho: string,
) {
  const row = ovSiteSetOf(site)
  if row < 0 { return 0 }
  let pick = ovPickFor(row, ur)
  if pick == "" || pick == "*" {
    tErr(
      ovRefuseMsg(row, prop, ur, pick)
        + " ("
        + uWho
        + " at the call's argument types)",
      at,
    )
    pick = ""
  }
  // Recorded refused or not ("" picks nothing), so the site is not also reported unpinned.
  const urS = tyToStrUser(ur)
  let seen = false
  let k = 0
  while k < ovInstSite.length {
    if ovInstSite[k] == site && ovInstRecv[k] == urS { seen = true }
    k = k + 1
  }
  if !seen {
    ovInstSite.push(site)
    ovInstRecv.push(urS)
    ovInstPick.push(pick)
  }
  if pick == "" { return 0 }
  const ft = T.tys[lookup(pick)]
  const c = P.nodes[site]
  if ft is TyFunc {
    if c is Call {
      const pN: string[] = []
      const pT: i32[] = []
      bindGenWalk(ft.fnParamTypes[0], ur, pN, pT)
      let i = 0
      while i < c.callArgs.length && i + 1 < ft.fnParamTypes.length {
        const got = substTyDeep(nodeTyIxOf(c.callArgs[i]), bNames, bTys)
        if got >= 0 && !tyHasHole(got) {
          bindGenWalk(ft.fnParamTypes[i + 1], got, pN, pT)
          const want = substTyDeep(ft.fnParamTypes[i + 1], pN, pT)
          if !assignable(got, want) {
            tErr(
              "argument "
                + i32ToStr(i + 1)
                + " of `."
                + prop
                + "(…)`: expected "
                + tyToStr(want)
                + ", got "
                + tyToStr(got)
                + " — the receiver "
                + tyToStrUser(ur)
                + " picks "
                + ovCandText(row, strListIndexOf(ovSetCands[row], pick))
                + " ("
                + uWho
                + " at the call's argument types)",
              at,
            )
          }
        }
        i = i + 1
      }
    }
  }
  0
}

function ufcsCallTy(plainName: string, recvTy: i32, n: Call, ix: i32) {
  // Receiver overloading: a member call the merge left to the receiver's head class picks its
  // candidate here, banking it on the site for every later reader (`ufcsAliasAtSite`).
  const ovRow = ovSiteSetOf(ix)
  if ovRow >= 0 {
    if recvTy < 0 || T.tys[recvTy] is TyErr { return TY_ERR }
    // The merge banks a lone `self`-function candidate itself; several choose here.
    if ovSelfCount(ovRow) > 1 {
      if T.tys[recvTy] is TyVar {
        return ovHoleCallTy(ovRow, plainName, recvTy, n, ix)
      }
      const pick = ovPickFor(ovRow, recvTy)
      if pick == "" || pick == "*" {
        tErr(ovRefuseMsg(ovRow, plainName, recvTy, pick), ix)
        return TY_ERR
      }
      ufcsSiteAdd(ix, pick)
    }
    // A receiver whose element is still open would take it from the callee the name picked.
    if ovRecvOpen(recvTy) {
      tErr(
        ovChooseMsg(
          ovRow,
          plainName,
          ", because the receiver's element type is not known yet — annotate it (`const xs: string[] = []`)",
        ),
        ix,
      )
      return TY_ERR
    }
  }
  // Maps the callee's plain source name to its merge-mangled function, after field precedence
  // has already been checked — resolved at this call's own site (D1120), since two merged
  // modules may each export the same-named `self`-function.
  let name = ufcsAliasAtSite(ix, plainName)
  let fnTy = lookup(name)
  if fnTy < 0 || ufcsScopeStepsAside(name, fnTy, recvTy) {
    // Type-bound fallback (§C, docs/internals/type-bound-ufcs-design.md): the caller's scope
    // binds no such `self`-function, or binds one declared for another type while the receiver
    // is a newtype (§F, D1984), so ask the receiver type's declaring module. Banked on the site
    // for the emitter.
    const hm = homeModuleOf(recvTy)
    if hm >= 0 {
      const tbName = ufcsExportedScopeIn(hm, plainName)
      if tbName != "" && tbName != name {
        const tbFn = lookup(tbName)
        if tbFn >= 0 {
          if fnTy < 0 || ufcsSelfAccepts(tbName, tbFn, recvTy) {
            name = tbName
            fnTy = tbFn
            ufcsSiteAdd(ix, tbName)
          }
        }
      }
    }
  }
  if fnTy < 0 { return -1 }
  if !ufcsInferCallee(name, fnTy) { return -1 }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    let retTy = ft.fnRet
    if retTy == -2 { retTy = TY_ERR }
    const params = ft.fnParamTypes
    let args = n.callArgs
    // The `self`-NAME rule, asked here because the REWRITE asks it and the two
    // must not disagree about what dispatches (see `declFirstParamIsSelf`).
    if !declFirstParamIsSelf(name) { return -1 }
    // The arity range the direct spelling takes: the receiver fills `self` and the defaults fill
    // the tail of the declaration the scope chain gives this callee, empty for a binding (D1604).
    const uDecl = paramsAfterFirst(declParamsInScope(name))
    let uRequired = params.length - 1
    // `fnRequiredArity` over the TAIL alone: `self` is never defaulted (it is
    // the receiver), so the tail's own required count IS the answer.
    if uDecl.length == params.length - 1 { uRequired = fnRequiredArity(uDecl) }
    // A rest parameter packs here too: the receiver has already filled slot 0, so the pack
    // starts one slot earlier in the member call's own argument list than in the
    // declaration. Packing before the gate is what puts the two back in step.
    const uRest = restParamIndex(uDecl)
    if uRest >= 0 {
      if !callIsRestPacked(ix) {
        let uLo = uRequired
        if uLo > uRest { uLo = uRest }
        if args.length < uLo { return -1 }
        if !restCallPack(n, ix, uRest) { return TY_ERR }
      }
      args = n.callArgs
    } else if hasSpreadItem(args) {
      tErr(spreadNoRestMsg(plainName), ix)
      return TY_ERR
    }
    if args.length < uRequired || args.length + 1 > params.length { return -1 }
    if !assignable(recvTy, params[0]) { return -1 }
    // D2060 — the receiver is delivered to `self` like an argument, so a wider `self` field
    // the body writes is refused here as it is at the argument seam.
    const rcwRecv = P.nodes[n.callFn]
    if rcwRecv is Member {
      if !inferQuiet { rcwPend(rcwRecv.memObj, recvTy, params[0]) }
    }
    // The vacuous half of that gate, deferred: `assignable` answers true for a `TyVar` on
    // either side, so this row makes a hole receiver's pass mean something once resolved (see `ufcsCstr.ty`'s header).
    noteUfcsCstr(recvTy, plainName, ix, params[0])
    if tyHasHole(recvTy) && !ufcsSitePinnable(ix, cstrOwnerTop()) {
      if !i32ListHas(ufcsUnpinnedSites, ix) { ufcsUnpinnedSitesPush(ix) }
    }
    // Named arguments bind against the parameter names after `self` (the receiver is an
    // unnamed slot-0 positional), in parameter order — the full list with the receiver unnamed.
    if hasNamedArgs(n.callArgNames) {
      const uNames = paramNamesOfNodes(declParamsInScope(name))
      if uNames.length != params.length {
        tErr(
          "named arguments work only on declared functions, not on a function value",
          ix,
        )
        return TY_ERR
      }
      const restNames: string[] = []
      let rn = 1
      while rn < uNames.length {
        restNames.push(uNames[rn])
        rn = rn + 1
      }
      args = orderNamedCallArgs(restNames, args, n.callArgNames, ix, uDecl)
      if args.length != restNames.length { return TY_ERR }
    } else if args.length + 1 < params.length {
      // Pads trailing positional omissions with the declaration's defaults into a copy, so
      // the loop below covers the whole parameter list; `n.callArgs` stays untouched since `emit_rewrite` re-derives its own fill after the receiver is injected.
      const uPadded: i32[] = []
      let up = 0
      while up + 1 < params.length {
        if up < args.length { uPadded.push(args[up]) } else { uPadded.push(-1) }
        up = up + 1
      }
      if fillArgDefaults(uPadded, uDecl, ix) >= 0 { return TY_ERR }
      args = uPadded
    }
    // Generic dispatch binds the receiver into the `self` param's holes first — a receiver
    // missing a field the body demanded is not this method and falls through — then binds and checks the explicit arguments and substitutes the return.
    const bNames: string[] = []
    const bTys: i32[] = []
    const p0 = T.tys[params[0]]
    if p0 is TyVar {
      if !holeDemandOk(p0.tvName, -1, recvTy) { return -1 }
      // The receiver pins `self` as an argument pins its parameter, casts parked on it included.
      holeCastPinCheck(
        p0.tvName,
        recvTy,
        declParamNameAt(declParamsInScope(name), 0),
      )
    }
    // The receiver is the first argument a literal can be, for the destination's binding.
    const uDst: string[] = []
    const uArgs: i32[] = []
    if callDstTyOf(ix) >= 0 && !callHasTyArgs(ix) {
      uArgs.push(ufcsRecvExpr(n))
      for a in args { uArgs.push(a) }
      dstBindLitTyParams(ix, retTy, params, uArgs, bNames, bTys, uDst)
    }
    bindGenWalk(params[0], recvTy, bNames, bTys)
    // The receiver's half of the `u8[]`-meets-a-generic rule the direct-call spelling already
    // enforces: `bindGenWalk` above declined to bind `T` to storage type `u8`, so the
    // substituted `self` param still carries the unsolved hole the arity gate's `assignable`
    // passed vacuously — needed here because `self` arrives ahead of the argument loop that rule normally sits in.
    if !inferQuiet {
      if tyIsU8ArrayTy(recvTy) {
        if tyReachesHole(substTyDeep(params[0], bNames, bTys), 8) {
          tErr(
            "`u8[]` cannot be passed to a generic parameter — `u8` is a storage type, so a type parameter never binds it and a `u8[]` is not a `T[]`",
            ix,
          )
          return TY_ERR
        }
      }
    }
    // The receiver is `self`'s argument, so it takes the argument seam's verdict too: the
    // dispatch gate above asks bare `assignable`, which misses the refusals the seam holds,
    // such as a container widened into a differently stored element (D2165). `self` is asked
    // under the receiver's own binding; a receiver that is still a hole is re-asked at the pin.
    const recvX = ufcsRecvExpr(n)
    const selfTy = substSelfTy(params[0], bNames, bTys)
    // A receiver that is an observed parameter is delivered to `self` here, not at the seam.
    if expObsFn >= 0 { expObsPin(recvTy, selfTy, recvX) }
    if recvX >= 0 && !tyHasHole(recvTy) && !tyHasHole(selfTy) {
      if !assignableExpr(recvX, recvTy, selfTy) {
        tErr(
          "receiver: expected " + tyToStr(selfTy) + ", got " + tyToStr(recvTy),
          recvX,
        )
      }
    }
    // The direct call's order and seed (`checkCallNode`): a lambda whose parameter meets a hole
    // is checked after the other arguments, against its parameter under the receiver's binding
    // and theirs, so `xs.sort((a, b) => …)` types `a` as `sort(xs, (a, b) => …)` does.
    const uOrder = lambdaLastOrder(paramsAfterFirstTy(params), args)
    let oi = 0
    while oi < uOrder.length {
      const i = uOrder[oi]
      seedExpected(args[i], substTyDeep(params[i + 1], bNames, bTys))
      const at = checkNode(args[i])
      bindGenWalk(params[i + 1], at, bNames, bTys)
      const expected = substTyDeep(params[i + 1], bNames, bTys)
      const pHole = T.tys[params[i + 1]]
      if pHole is TyVar {
        if !holeDemandOk(pHole.tvName, args[i], at) {
          holeArgDemandErr(pHole.tvName, i + 1, at, args[i])
        }
        if rowIsArrayDemanded(params[i + 1]) {
          if tyRefusesArrayDemand(at) { holeArgArrayErr(i + 1, at, args[i]) }
        }
        if holeIsArrayWriteDemanded(name, pHole.tvName) {
          if tyIxIsView(at) { holeArgViewErr(i + 1, at, args[i]) }
        }
        // The `as` cast the body parked on this hole, re-asked under the argument. D1342.
        holeCastPinCheck(pHole.tvName, at, declParamNameAt(uDecl, i))
      }
      constrainEmptyExpr(args[i], at, expected)
      const savedArgLit = argLitAt
      argLitAt = peelParenIx(args[i])
      const argOk = assignableExpr(args[i], at, expected)
      argLitAt = savedArgLit
      if !argOk {
        // Anchored at the offending argument (or its offending return site),
        // never at the call node — see `argMismatchErr`.
        argMismatchErr(i + 1, expected, at, args[i])
      }
      oi = oi + 1
    }
    if uDst.length > 0 && !inferQuiet {
      dstRetypeLitArgs(uDst, params, uArgs, bNames, bTys)
    }
    // The uninferable-return gate reads the declaration, so `xs.f()` and `f(xs)` answer alike;
    // the receiver is `self`, a parameter like any other for the purpose of binding.
    checkRetTyParamBound(fnDeclIx[name] ?? CSTR_NODECL, plainName, ix, retTy)
    // The UFCS half of the deferred-constraint re-validation, which lived in the direct-call
    // path alone: `xs.indexOf(nd)` and `indexOf(xs, nd)` are the same call and must answer the
    // same way, so the UFCS spelling needs its own re-validation of the callee's recorded
    // constraints too — the same self-arrives-ahead-of-the-argument-loop asymmetry as above.
    if !inferQuiet {
      if bNames.length > 0 {
        callBindNote(ix, bNames, bTys)
        // `params[0]` is the RECEIVER here, so the origins skip it (`selfOff` 1) and the
        // remaining parameters number from 1 — `xs.plus(y)` blames `argument 1`, not 2.
        const uhNames: string[] = []
        const uhArgNo: i32[] = []
        const uhArgNode: i32[] = []
        holeArgOrigins(params, args, 1, uhNames, uhArgNo, uhArgNode)
        const pinArgs: i32[] = [ufcsRecvExpr(n)]
        for a in args { pinArgs.push(a) }
        pinBmCstrElems(bNames, bTys, ix, fnDeclIx[name] ?? CSTR_NODECL, pinArgs)
        validateBinCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
          uhNames,
          uhArgNo,
          uhArgNode,
        )
        // The print capability rides the same pin and the same UFCS/direct symmetry as
        // above — `xs.show()` and `show(xs)` must answer the same way (D401).
        validatePrintCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
        )
        validateNestCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
        )
        validateIsCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
        )
        // A call argument inside the body, at the UFCS half for the same symmetry: `"s".inc()`
        // and `inc("s")` must answer the same way (D2425).
        validateArgCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          uhNames,
          uhArgNode,
        )
        // The declared return, at the UFCS half for the same symmetry: `p.g()` and `g(p)`
        // must answer the same way, or the method spelling of D551's family stays silent beside a loud direct one.
        validateRetCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
        )
        // Every other destination inside the body — a local, a re-assignment, a field or
        // element write — at the UFCS half for the same symmetry (D572).
        validateLetCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
        )
        // Every builtin-collection-method argument inside the body, at the UFCS half for the
        // same symmetry (D582).
        validateBmCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
        )
        // After the pins above, as the direct spelling does; the receiver is an argument too.
        const rcvN = P.nodes[n.callFn]
        if rcvN is Member { refuseOpenNullHoleArg(rcvN.memObj, plainName) }
        let oua = 0
        while oua < args.length {
          refuseOpenNullHoleArg(args[oua], plainName)
          oua = oua + 1
        }
        // The receiver classification of a `.length` / `x[i]` inside the body, at the UFCS
        // half for the same symmetry (D651 / D691).
        validateMemCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
          uhNames,
          uhArgNo,
          uhArgNode,
        )
        // The receiver of a UFCS `self`-method resolved inside the body, at the UFCS half
        // for the same symmetry (D1005).
        validateUfcsCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
        )
      }
    }
    if bNames.length > 0 { retTy = substTyDeep(retTy, bNames, bTys) }
    return retTy
  }
  -1
}

// Type the bitcast call `name(arg)`, or -1 when `name` is not a bitcast. Arity and the
// argument type are checked here; `assignableExpr` (not bare `assignable`) so a float
// LITERAL argument re-encodes into an `f32` parameter, matching every other f32 position.
function bitcastCallTy(name: string, n: Call, ix: i32) {
  const want = bitcastArgTy(name)
  if want < 0 { return -1 }
  const args = n.callArgs
  if args.length != 1 {
    tErr(name + " expects 1 argument, got " + i32ToStr(args.length), ix)
  } else {
    const got = checkNode(args[0])
    if !assignableExpr(args[0], got, want) {
      tErr(name + " expects " + tyToStr(want) + ", got " + tyToStr(got), ix)
    }
  }
  bitcastRetTy(name)
}

// Type the float / integer intrinsic call `name(args…)`, or -1 when `name` is not one.
// The operand width is decided from the arguments and every argument is then checked
// against it, so a mixed call reports the width it actually computes at.
function numIntrCallTy(name: string, n: Call, ix: i32) {
  const isFloat = floatIntrArity(name) > 0
  let arity = intIntrArity(name)
  if isFloat { arity = floatIntrArity(name) }
  if arity == 0 { return -1 }
  const args = n.callArgs
  if args.length != arity {
    let want = i32ToStr(arity) + " arguments"
    if arity == 1 { want = "1 argument" }
    tErr(name + " expects " + want + ", got " + i32ToStr(args.length), ix)
    // Still yield a type so the call site does not cascade: the width is unknowable
    // from a wrong-arity call, so take the family's default.
    if isFloat { return TY_F64 }
    if intIntrIsCompare(name) { return TY_BOOL }
    return TY_I32
  }
  const argTys: i32[] = []
  let i = 0
  while i < args.length {
    argTys.push(checkNode(args[i]))
    i = i + 1
  }
  const holeTy = minMaxHoleOperand(name, argTys)
  if holeTy >= 0 {
    noteBinCstr(argTys[0], name, argTys[argTys.length - 1])
    return holeTy
  }
  let width = intIntrWidth(argTys)
  if isFloat && !intMinMaxOperands(name, argTys) {
    width = floatIntrWidth(args, argTys)
  }
  // An operand is no delivery: `ltU(a, b)` computes at the width `a` and `b` give it.
  const savedNoDest = lbiNoDest
  lbiNoDest = true
  let j = 0
  while j < args.length {
    if !assignableExpr(args[j], argTys[j], width) {
      tErr(
        name + " expects " + tyToStr(width) + ", got " + tyToStr(argTys[j]),
        ix,
      )
    }
    j = j + 1
  }
  lbiNoDest = savedNoDest
  if !isFloat {
    if intIntrIsCompare(name) { return TY_BOOL }
  }
  width
}

// Method call on a member callee (`xs.push(e)`, `m.get(k)`, `s.slice(a)`): types the
// builtin receiver kinds directly, never as a struct field read. Returns the call type,
// or `-1` when no builtin arm claims it and the caller falls through to the field/UFCS
// path — the same "no answer" spelling `ufcsCallTy` and `arrayUnionCallTy` already use.
function checkMemberCallNode(
  n: Call,
  ix: i32,
  recvIx: i32,
  prop: string,
  recvPre: i32,
): i32 {
  // A member-access callee is always function-typed for semantic tokens; the builtin arms
  // below type it directly and never revisit the member-read arm, so its name is recorded here (a struct field holding a function falls through to `checkNode` and overwrites it for hover).
  symMemMethod(n.callFn)
  // An optional call hands the receiver's type in already non-null: `p?.f(…)` resolves the
  // callee against the value its guard admits, not against the `| null` the guard strips.
  let recvTy = recvPre
  if recvPre < 0 { recvTy = checkNode(recvIx) }
  if recvTy >= 0 { recvTy = strLitRecvTy(recvTy) }
  // A gradual union's built-in method is its concrete member's; the pin re-asks the whole union.
  if recvTy >= 0 && recvTy < T.tys.length && T.tys[recvTy] is TyUnion {
    const gv = tpGradualView(recvTy)
    if gv != recvTy && gv >= 0 && builtinMethodClaims(gv, prop) {
      noteMemCstr(recvTy, MC_METHOD_MARK + prop, ix, false)
      recvTy = gv
    }
  }
  let rt = T.tys[recvTy]
  // An un-annotated hole receiving an array method (`self.map`/`.push`/…) is constrained to
  // an array — synthesizing one over a derived element hole and falling into the array-method
  // arm below, which pins the concrete element per call shape. Without this the hole would
  // grow a `{map: any}` struct shape no array argument could satisfy.
  if rt is TyVar && !holeMethodIsSelfFn(prop, ix) {
    if holeArrMethod(prop) {
      noteArrayDemand(arrayDemandKey(recvTy))
      // The synthesized receiver below is a MUTABLE list, and nothing re-checks the
      // argument against it — so a write through the hole is filed here, and the pin
      // refuses a view for it.
      if listMethodMutates(prop) { noteArrayWriteDemand(rt.tvName) }
      const elemHole = mkDerivedHole(HD_ELEM, "", -1, -1, recvTy)
      recvTy = mkArrayTy(elemHole)
    } else if holeMapMethod(prop) {
      // A place a type-parameter write left nullable at some pins is asked at each, unless
      // the call is optional (D3445).
      if recvPre < 0 && tyIsWriteLandRead(recvTy) {
        noteMemCstr(recvTy, MC_NULL_READ_MARK + prop, ix, false)
      }
      // The dual for a hole receiving a map/set method: becomes the hole's demanded map
      // (`{[?]: ?}`) and falls into the map-method arm below, which pins the open key/value
      // from the method's own arguments — `.add` mints the Set flavor. Without this the hole
      // would grow a `{set: any}` struct shape no map argument could satisfy.
      recvTy = holeMapDemandTy(rt.tvName, prop == "add")
    }
  }
  rt = T.tys[recvTy]
  // Banked for the emitter's rewrite, which must take the rung this call took (D2476).
  if builtinMethodClaims(recvTy, prop) {
    memberCallRungAdd(ix, MC_RUNG_BUILTIN)
  }
  if rt is TyArray {
    // The view's whole contract: a `readonly T[]` receiver refuses every method that
    // changes the list's own shape. An element's fields are untouched by it — the marker
    // is on the list, not on what the list holds. Reported and then fallen through, so the
    // call still types as its own method and no cascade follows the one real diagnostic.
    if rt.aRead == 1 {
      if listMethodMutates(prop) {
        tErr(roWriteMsg("`." + prop + "()`", recvTy), ix)
      }
    }
    const margs = n.callArgs
    if prop == "push" {
      if margs.length < 1 {
        tErr("push expects at least 1 argument, got 0", ix)
      } else {
        // `push` is variadic — every argument appends, and a spread argument appends every
        // element of its source. One loop covers both, so `xs.push(...ys)` needs no case of
        // its own; the appends happen in argument order.
        let mi = 0
        while mi < margs.length {
          const spd = spreadArgOf(margs[mi])
          if spd >= 0 {
            const set = spreadElemTy(margs[mi])
            if rt.aElem < 0 {
              if set >= 0 {
                rt.aElem = set
                tyMutEpoch = tyMutEpoch + 1 // a spread pinned the element in place
              }
            } else if set >= 0 {
              if !bmArgOk(BM_PUSH, "push", set, rt.aElem, recvTy, spd) {
                tErr(bmArgMsg(BM_PUSH, "push", set, rt.aElem, recvTy), ix)
              }
            }
          } else {
            // Contextual param inference for a pushed callback: `fs.push((n) => n + 1)` over a
            // `((i32) => i32)[]` seeds the lambda's param from the element function type, so an
            // un-annotated lambda infers `n` instead of erroring (mirrors the `.map`/`.filter`
            // seeding). A non-function element / non-lambda arg is left untouched by `seedExpected`.
            if rt.aElem >= 0 { seedExpected(margs[mi], rt.aElem) }
            const pat = checkNode(margs[mi])
            // The first `.push(v)` on a bare empty `[]` pins its element type to `typeof v` in
            // place — the usage-driven inference that resolves an un-annotated `const xs = []`; a later conflicting push is then a clean type error.
            if rt.aElem < 0 { calleeWritePrePin(recvTy, pat) }
            if rt.aElem < 0 {
              rt.aElem = cnhPinTy(pat, ix, recvIx, false, false)
              tyMutEpoch = tyMutEpoch + 1 // `.push` pinned the element in place
            } else {
              cnhFill(rt.aElem, pat)
              // The pushed value's own open holes pin from the element slot — the same rule
              // `.set` / `m[k] = v` / `xs = e` apply at their own store positions.
              constrainEmptyExpr(margs[mi], pat, rt.aElem)
              // A float literal re-encodes into an `f32` element as at a binding (D582); a hole
              // lambda takes a concrete function element's type as an element store does, so a
              // body that cannot is refused here, not lowered at the hole's default (D3867).
              if pushHoleFnToConcrete(pat, rt.aElem) {
                if !assignableExpr(margs[mi], pat, rt.aElem) {
                  tErrWant(
                    letAssignMsg(margs[mi], pat, rt.aElem, "", -1),
                    margs[mi],
                    rt.aElem,
                  )
                }
              } else if (
                !bmArgOk(BM_PUSH, "push", pat, rt.aElem, recvTy, margs[mi])
              ) {
                tErr(bmPushMsg("push", pat, rt.aElem, recvTy, margs[mi]), ix)
              }
            }
          }
          mi = mi + 1
        }
      }
      return TY_I32
    }
    // `.map(fn)` / `.filter(pred)`: the callback is a 1-arg function over the
    // element type; map yields an array of the callback's return, filter the
    // same array type (its predicate must yield bool).
    if prop == "map" || prop == "filter" {
      const cargs = n.callArgs
      if cargs.length != 1 {
        tErr(prop + " expects 1 argument, got " + i32ToStr(cargs.length), ix)
        return TY_ERR
      }
      // Seeds the callback's expected param type from the receiver's element type, so an
      // un-annotated function-literal argument infers its param instead of erroring — only
      // when the arg is an anonymous literal and the element type is known, else cleared below.
      const cbArg = P.nodes[cargs[0]]
      // A named callback is typed by the element, which a refused function value names.
      if cbArg is Ident && ovSetMod.length > 0 {
        ovCbElemSetAt(cargs[0], rt.aElem)
      }
      if cbArg is FuncDecl {
        if cbArg.fnName == "" && rt.aElem >= 0 {
          recordCbExpected(cargs[0], [rt.aElem])
        }
        if !cbElemNarrowFor(recvIx, cargs[0]) { efLeaf[cargs[0]] = -1 }
      }
      const cbTy = checkNode(cargs[0])
      const cb = T.tys[cbTy]
      if cb is TyFunc {
        const cbParams = cb.fnParamTypes
        if cbParams.length != 1 {
          tErr(
            prop
              + " callback expects 1 parameter, got "
              + i32ToStr(cbParams.length),
            ix,
          )
        } else if !assignable(rt.aElem, cbParams[0]) {
          tErr(
            prop
              + " callback: parameter expects "
              + tyToStr(cbParams[0])
              + ", got "
              + tyToStr(rt.aElem),
            ix,
          )
        }
        if prop == "filter" {
          if !assignable(cb.fnRet, TY_BOOL) {
            tErr(
              "filter predicate must yield boolean, got " + tyToStr(cb.fnRet),
              ix,
            )
          }
          return listBuiltResultTy(recvTy, rt.aElem, rt.aRead)
        }
        return mkArrayTy(cb.fnRet)
      }
      tErr(prop + " expects a function, got " + tyToStr(cbTy), ix)
      return TY_ERR
    }
    // `.pop()` / `.get(i)` yield `T | null` (an empty pop / out-of-range get is
    // normal absence); `.clear()` empties in place and yields nothing. The element is
    // its VALUE type (`arrElemValueTy`), so a `u8[]` answers `i32 | null` — the same
    // widening `xs[i]` takes, and the rep `emitPopNulBox` already builds (D1211).
    if prop == "pop" {
      if margs.length != 0 {
        tErr("pop expects 0 arguments, got " + i32ToStr(margs.length), ix)
      }
      // The first pop under a `.length` test of this same list yields the element (D3558); an
      // element type over a type variable or hole lowers per instance, so it stays nullable.
      const popEl = arrElemValueTy(rt.aElem)
      if (
        margs.length == 0
        && !tyHasHole(popEl)
        && nePopTakes(ix, recvIx, curFnDeclIx)
      ) {
        return popEl
      }
      return mkNullableTy(popEl)
    }
    if prop == "get" {
      if margs.length != 1 {
        tErr("get expects 1 argument, got " + i32ToStr(margs.length), ix)
      } else {
        const gat = checkNode(margs[0])
        if !bmArgOk(BM_INDEXMUST, "get", gat, TY_I32, -1, margs[0]) {
          tErr(bmArgMsg(BM_INDEXMUST, "get", gat, TY_I32, -1), ix)
        }
      }
      return mkNullableTy(arrElemValueTy(rt.aElem))
    }
    if prop == "clear" {
      if margs.length != 0 {
        tErr("clear expects 0 arguments, got " + i32ToStr(margs.length), ix)
      }
      return TY_VOID
    }
    // `.slice(start, end?)` yields a NEW array of the SAME element type — the bounds
    // are i32 (a missing `end` defaults to the length; negatives count from the end).
    if prop == "slice" {
      if margs.length != 1 && margs.length != 2 {
        tErr(
          "slice expects 1 or 2 arguments, got " + i32ToStr(margs.length),
          ix,
        )
      } else {
        let si = 0
        while si < margs.length {
          const sat = checkNode(margs[si])
          if !bmArgOk(BM_BOUNDMUST, "slice", sat, TY_I32, -1, margs[si]) {
            tErr(bmArgMsg(BM_BOUNDMUST, "slice", sat, TY_I32, -1), ix)
          }
          si = si + 1
        }
      }
      return listBuiltResultTy(recvTy, rt.aElem, rt.aRead)
    }
    // UFCS `self`-method on an array receiver (`parts.join(sep)`): an array
    // carries no user FIELD, so a matching free `self`-function resolves
    // directly — the array dual of the string/struct/union UFCS paths.
    const au = ufcsCallTy(prop, recvTy, n, ix)
    if au >= 0 {
      memberCallRungAdd(ix, MC_RUNG_SELF_FN)
      return au
    }
    if ufcsMissRaise(prop, recvTy, n.callArgs.length, ix, n.callFn) {
      return TY_ERR
    }
    tErr(
      "no method '."
        + prop
        + "' on array "
        + tyToStr(recvTy)
        + methodDidYouMean(recvTy, prop),
      n.callFn,
    )
    return TY_ERR
  }
  // Map/Set methods over the `{[K]: V}` rep, gated by flavor: a map exposes `.set`/`.get`/
  // `.has`/`.delete`/`.keys`/`.values`; a set exposes `.add`/`.has`/`.delete`/`.keys`/`.values`.
  // `.add` alone gates on the value's TYPE rather than the flavor bit (see its own arm). The
  // first `.set`/`.add` on a bare `Map()`/`Set()` pins its key/value holes in place.
  if rt is TyMap {
    const mp = prop
    const margs2 = n.callArgs
    if mp == "set" && rt.mSet == 0 {
      if margs2.length != 2 {
        tErr("set expects 2 arguments, got " + i32ToStr(margs2.length), ix)
      } else {
        const k0 = checkNode(margs2[0])
        // The value argument is a store into the map's value slot, taking the same
        // contextual steps `xs.push(v)` and `m[k] = v` take: `seedExpected` first, then the
        // expression-aware `assignableExpr` — the one home the assignment path also calls, so `.set` and `m[k] = v` cannot drift apart.
        if rt.mVal >= 0 { seedExpected(margs2[1], rt.mVal) }
        const v0 = checkNode(margs2[1])
        if rt.mKey < 0 {
          rt.mKey = widenLitTy(k0)
          tyMutEpoch = tyMutEpoch + 1 // `.set` pinned the key in place
          checkInferredMapKey(rt.mKey, rt.mSet, ix)
        } else if !bmArgOk(BM_SETKEY, "set", k0, rt.mKey, -1, margs2[0]) {
          tErr(bmArgMsg(BM_SETKEY, "set", k0, rt.mKey, -1), ix)
        }
        if rt.mVal < 0 {
          rt.mVal = cnhPinTy(v0, ix, recvIx, true, isHoleMapDemandTy(recvTy))
          tyMutEpoch = tyMutEpoch + 1 // `.set` pinned the value in place
        } else {
          cnhFill(rt.mVal, v0)
          // The value argument's own open holes pin from the slot, the third step
          // this store shares with `m[k] = v` (which pins in `checkBinExprNode`'s
          // `=` arm) — without it, `m.set("a", fq())` over a `{[string]: f64[]}` reaches the emitter with an unpinned `[]`.
          constrainEmptyExpr(margs2[1], v0, rt.mVal)
          // `assignableExpr` already covers the newtype literal-adoption case (`m.set("k",
          // 1)` over `{[string]: EntityId}` fires), deferring to the pin under a hole (D582).
          // A hole lambda takes a concrete function value type as `m[k] = v` and `push` do, so
          // a body that cannot is refused here (D3881).
          if pushHoleFnToConcrete(v0, rt.mVal) {
            if !assignableExpr(margs2[1], v0, rt.mVal) {
              tErrWant(
                letAssignMsg(margs2[1], v0, rt.mVal, "", -1),
                margs2[1],
                rt.mVal,
              )
            }
          } else if !bmArgOk(BM_SETVAL, "set", v0, rt.mVal, -1, margs2[1]) {
            tErr(bmArgMsg(BM_SETVAL, "set", v0, rt.mVal, -1), ix)
          }
        }
      }
      return TY_VOID
    }
    if mp == "get" && rt.mSet == 0 {
      if margs2.length != 1 {
        tErr("get expects 1 argument, got " + i32ToStr(margs2.length), ix)
      } else {
        const k1 = checkNode(margs2[0])
        if !bmArgOk(BM_KEYMUST, "get", k1, rt.mKey, -1, margs2[0]) {
          tErr(bmArgMsg(BM_KEYMUST, "get", k1, rt.mKey, -1), ix)
        }
      }
      return mkNullableTy(rt.mVal)
    }
    // `.add(x)` is a Set method only: a boolean-valued map is a map, and its insert is
    // `m[k] = true` (DECISIONS.md, "`{[K]: V}` and `T[]` are concrete types").
    if mp == "add" && rt.mSet == 0 && tyIsPrimNamed(rt.mVal, "boolean") {
      // The hint yields to a `self`-function named `add`: a map has no such member (D2477).
      const ma = ufcsCallTy(mp, recvTy, n, ix)
      if ma >= 0 {
        memberCallRungAdd(ix, MC_RUNG_SELF_FN)
        return ma
      }
      tErr(
        "`.add` is a `Set` method — use `m[k] = true`, or make it a `Set<"
          + tyToStr(rt.mKey)
          + ">`",
        ix,
      )
      return TY_ERR
    }
    if mp == "add" && rt.mSet == 1 {
      if margs2.length != 1 {
        tErr("add expects 1 argument, got " + i32ToStr(margs2.length), ix)
      } else {
        const ka = checkNode(margs2[0])
        if rt.mKey < 0 {
          rt.mKey = widenLitTy(ka)
          tyMutEpoch = tyMutEpoch + 1 // `.add` pinned the Set key in place
          checkInferredMapKey(rt.mKey, rt.mSet, ix)
        } else if !bmArgOk(BM_ADDKEY, "add", ka, rt.mKey, -1, margs2[0]) {
          tErr(bmArgMsg(BM_ADDKEY, "add", ka, rt.mKey, -1), ix)
        }
      }
      return TY_VOID
    }
    if mp == "has" || mp == "delete" {
      if margs2.length != 1 {
        tErr(mp + " expects 1 argument, got " + i32ToStr(margs2.length), ix)
      } else {
        const k2 = checkNode(margs2[0])
        if !bmArgOk(BM_KEYMUST, mp, k2, rt.mKey, -1, margs2[0]) {
          tErr(bmArgMsg(BM_KEYMUST, mp, k2, rt.mKey, -1), ix)
        }
      }
      return TY_BOOL
    }
    if mp == "clear" {
      if margs2.length != 0 {
        tErr("clear expects 0 arguments, got " + i32ToStr(margs2.length), ix)
      }
      return TY_VOID
    }
    if mp == "keys" {
      if margs2.length != 0 { tErr("keys expects no arguments", ix) }
      return mkArrayTy(rt.mKey)
    }
    if mp == "values" {
      if margs2.length != 0 { tErr("values expects no arguments", ix) }
      // A set's `.values()` yields its ELEMENTS (the keys); a map's its values.
      if rt.mSet == 1 { return mkArrayTy(rt.mKey) }
      return mkArrayTy(rt.mVal)
    }
    // A name no map arm claims is a `self`-function call, as on every other receiver (D2477).
    const mu = ufcsCallTy(mp, recvTy, n, ix)
    if mu >= 0 {
      memberCallRungAdd(ix, MC_RUNG_SELF_FN)
      return mu
    }
    tErr(
      "unknown property `"
        + mp
        + "` on "
        + tyToStr(recvTy)
        + methodDidYouMean(recvTy, mp),
      ix,
    )
    return TY_ERR
  }
  // String methods: `.slice`/`.indexOf`/`.includes`/`.charCodeAt`, and the stage 2c trio
  // `.cpAt`/`.cpLen`/`.isCharBoundary` (`.length` is a `Member`, `s[i]` an `Index`). The trio
  // lives in the core rather than `std:str` (OQ-3) because each needs the UTF-8 storage directly
  // — a byte-offset decode, a continuation-byte scan, a lead-bit test — which the surface exposes no other way to reach.
  if rt is TyPrim {
    if rt.primName == "string" {
      const sp = prop
      const sargs = n.callArgs
      if sp == "slice" {
        if sargs.length != 2 {
          tErr("slice expects 2 arguments, got " + i32ToStr(sargs.length), ix)
        } else {
          const s0 = checkNode(sargs[0])
          const s1 = checkNode(sargs[1])
          // Two constraints, one sentence: each bound defers on its own (either can be the
          // hole), but the message names both types, so each form carries the other bound as its `ctx` and renders the identical sentence whichever side failed.
          const sb0 = bmArgOk(BM_BOUNDS0, "slice", s0, TY_I32, s1, sargs[0])
          const sb1 = bmArgOk(BM_BOUNDS1, "slice", s1, TY_I32, s0, sargs[1])
          if !sb0 {
            tErr(bmArgMsg(BM_BOUNDS0, "slice", s0, TY_I32, s1), ix)
          } else if !sb1 {
            tErr(bmArgMsg(BM_BOUNDS1, "slice", s1, TY_I32, s0), ix)
          }
        }
        return TY_STR
      }
      if sp == "indexOf" {
        if sargs.length != 1 {
          tErr("indexOf expects 1 argument, got " + i32ToStr(sargs.length), ix)
        } else {
          const a0 = checkNode(sargs[0])
          if !bmArgOk(BM_EXPECTSA, "indexOf", a0, TY_STR, -1, sargs[0]) {
            tErr(bmArgMsg(BM_EXPECTSA, "indexOf", a0, TY_STR, -1), ix)
          }
        }
        return TY_I32
      }
      if sp == "includes" {
        if sargs.length != 1 {
          tErr("includes expects 1 argument, got " + i32ToStr(sargs.length), ix)
        } else {
          const a0 = checkNode(sargs[0])
          if !bmArgOk(BM_EXPECTSA, "includes", a0, TY_STR, -1, sargs[0]) {
            tErr(bmArgMsg(BM_EXPECTSA, "includes", a0, TY_STR, -1), ix)
          }
        }
        return TY_BOOL
      }
      if sp == "charCodeAt" {
        if sargs.length != 1 {
          tErr(
            "charCodeAt expects 1 argument, got " + i32ToStr(sargs.length),
            ix,
          )
        } else {
          const a0 = checkNode(sargs[0])
          if !bmArgOk(BM_IDXPHRASE, "charCodeAt", a0, TY_I32, -1, sargs[0]) {
            tErr(bmArgMsg(BM_IDXPHRASE, "charCodeAt", a0, TY_I32, -1), ix)
          }
        }
        return TY_I32
      }
      // `s.cpAt(i)` — the code point whose UTF-8 sequence begins at byte offset `i`,
      // O(1) (§Codepoints). Not "the i-th code point": the argument is in the one
      // coordinate system `slice`, `indexOf` and `.length` share.
      if sp == "cpAt" {
        if sargs.length != 1 {
          tErr("cpAt expects 1 argument, got " + i32ToStr(sargs.length), ix)
        } else {
          const a0 = checkNode(sargs[0])
          if !bmArgOk(BM_BYTEOFF, "cpAt", a0, TY_I32, -1, sargs[0]) {
            tErr(bmArgMsg(BM_BYTEOFF, "cpAt", a0, TY_I32, -1), ix)
          }
        }
        return TY_I32
      }
      // `s.cpLen()` — the code-point count, O(n) and NAMED so the cost is visible at the
      // call site rather than hidden in a `.length` that is O(1) on some data and O(n)
      // on other data (§Codepoints: "a subscript should mean O(1), always").
      if sp == "cpLen" {
        if sargs.length != 0 {
          tErr("cpLen expects no arguments, got " + i32ToStr(sargs.length), ix)
        }
        return TY_I32
      }
      // `s.isCharBoundary(i)` — Rust's primitive, O(1): a single lead/continuation bit
      // test. Slicing off a boundary is LEGAL under Go-lean validity (§Validity), so this
      // is the tool for code that wants to check rather than a guard the language imposes.
      if sp == "isCharBoundary" {
        if sargs.length != 1 {
          tErr(
            "isCharBoundary expects 1 argument, got " + i32ToStr(sargs.length),
            ix,
          )
        } else {
          const a0 = checkNode(sargs[0])
          if (
            !bmArgOk(BM_BYTEOFF, "isCharBoundary", a0, TY_I32, -1, sargs[0])
          ) {
            tErr(bmArgMsg(BM_BYTEOFF, "isCharBoundary", a0, TY_I32, -1), ix)
          }
        }
        return TY_BOOL
      }
      // `s.bytes()` — the string's UTF-8 storage as a `u8[]`. A COPY, not a view:
      // see `emitStrBytesFnCode` for why a `u8[]` cannot express a non-zero `start`,
      // and `strings-design.md` §Byte view for the withdrawn zero-copy claim.
      if sp == "bytes" {
        if sargs.length != 0 {
          tErr("bytes expects no arguments, got " + i32ToStr(sargs.length), ix)
        }
        return mkArrayTy(TY_U8)
      }
      // UFCS `self`-method on a string receiver (`"hello".first()`).
      const su = ufcsCallTy(sp, recvTy, n, ix)
      if su >= 0 {
        memberCallRungAdd(ix, MC_RUNG_SELF_FN)
        return su
      }
      if ufcsMissRaise(sp, recvTy, n.callArgs.length, ix, n.callFn) {
        return TY_ERR
      }
      tErr(
        "no method '." + sp + "' on string" + methodDidYouMean(recvTy, sp),
        n.callFn,
      )
      return TY_ERR
    }
  }
  // UFCS `self`-method on any other receiver: `o.f(args)` lowers to `f(o, args)` when the
  // receiver has no such field (a callable field keeps precedence) and a matching free
  // function exists. The field-first test is `tyFieldTyOf`, the same predicate the emitter's
  // `drwWalk` calls on the receiver's recorded type, so the two cannot disagree (D1070).
  const ufcsHasField = tyFieldTyOf(recvTy, prop) >= 0
  const urt = T.tys[recvTy]
  // A bounded type parameter as the receiver (OQ-5, strict bodies): the bound answers, and
  // only the bound — arguments check against its declared members and the result is what it
  // promised. No dispatch happens here; the witness is chosen per instantiation site
  // (`checkBoundsAtCall`) and baked by the monomorphizer.
  if urt is TyVar {
    const bcTy = boundMemberTy(urt.tvName, prop, true)
    if bcTy == BOUND_UNRESOLVED {
      tErr(boundMemberUnknownMsg(urt.tvName, prop), ix)
      return TY_ERR
    }
    if bcTy >= 0 {
      const bcT = T.tys[bcTy]
      if bcT is TyFunc {
        const bcArgs = n.callArgs
        if bcArgs.length != bcT.fnParamTypes.length {
          tErr(
            "`"
              + prop
              + "` on `"
              + urt.tvName
              + "` expects "
              + i32ToStr(bcT.fnParamTypes.length)
              + " arguments, got "
              + i32ToStr(bcArgs.length),
            ix,
          )
          return TY_ERR
        }
        let bca = 0
        while bca < bcArgs.length {
          const bcat = checkNode(bcArgs[bca])
          const bcWant = bcT.fnParamTypes[bca]
          // An UNRESOLVED member type (`-1`) is a bound whose own annotation
          // named something this scope has no answer for. Reported once, at the
          // call, rather than fed to `assignable` — which reads a negative side
          // as "accept anything" and would silently pass every argument.
          if bcWant < 0 {
            tErr(boundMemberUnknownMsg(urt.tvName, prop), ix)
            return TY_ERR
          }
          if !assignableExpr(bcArgs[bca], bcat, bcWant) {
            argMismatchErr(bca + 1, bcWant, bcat, bcArgs[bca])
          }
          bca = bca + 1
        }
        if bcT.fnRet < 0 {
          tErr(boundMemberUnknownMsg(urt.tvName, prop), ix)
          return TY_ERR
        }
        return bcT.fnRet
      }
    }
    const bcMsg = boundMemberFloorMsg(urt.tvName, prop)
    if bcMsg != "" {
      tErr(bcMsg, ix)
      return TY_ERR
    }
  }
  if !ufcsHasField {
    const uu = ufcsCallTy(prop, recvTy, n, ix)
    if uu >= 0 {
      memberCallRungAdd(ix, MC_RUNG_SELF_FN)
      return uu
    }
    // The name is a self-function, just not one in scope (D1230) — asked here since only
    // the call knows the argument count, banked on the callee member node where the sentence is raised (`memberFloorErr`).
    noteUfcsMiss(
      n.callFn,
      ufcsMissingImportSpecs(prop, recvTy, n.callArgs.length, ix),
    )
    // When the name is already in scope, which gate declined (D1570) — banked beside
    // D1230's answer and read after it, since `argc` is known here and raised there.
    noteUfcsNotMethod(
      n.callFn,
      prop,
      ufcsAliasAtSite(ix, prop),
      recvTy,
      n.callArgs.length,
    )
  }
  -1
}

// A memory intrinsic declared in the default scope but with no emitter arm
// (`nameIsUnimplementedIntrinsic`) is reported here rather than as the emitter's generic "call
// to unknown function", which would misread a missing implementation as a typo. Gated on the
// callee still denoting that binding, so a shadowing declaration or parameter keeps it (D1604).
function checkUnimplementedIntrinsicCall(cfn: Ident, ix: i32) {
  if (
    nameIsUnimplementedIntrinsic(cfn.identName)
    && (fnDeclIx[cfn.identName] ?? -1) < 0
    && lookupDepth(cfn.identName) == 0
  ) {
    tErrUnsupported(
      "'"
        + cfn.identName
        + "' is declared but has no implementation yet — it type-checks and then has nothing to lower (see `docs/internals/memory-gc-design.md` §1.2)",
      ix,
    )
  }
}

// A SIMD lane argument is a wasm instruction IMMEDIATE, not a stack operand, so it MUST be a
// compile-time integer literal in `0..max` — a non-literal (a `-` prefix parses as `Unary`, not
// `NumLit`) or out-of-range lane is a loud check error (O3, `simd-design.md` §F). A lane row's
// index is its second argument; a shuffle's are every argument after its two vectors.
function checkSimdLaneArg(n: Call, cfn: Ident) {
  const nm = cfn.identName
  const row = simdRow(nm)
  if row < 0 { return 0 }
  const sig = simdRowSig(row)
  const max = simdRowLaneMax(row)
  if sig == SIMD_SIG_SHUF4 || sig == SIMD_SIG_SHUF16 {
    let k = 2
    while k < n.callArgs.length {
      simdLaneLitCheck(nm, n.callArgs[k], max)
      k = k + 1
    }
    return 0
  }
  if max >= 0 && n.callArgs.length >= 2 {
    simdLaneLitCheck(nm, n.callArgs[1], max)
  }
  0
}

// Reports unless `argIx` is an integer literal in `0..max`; the message names the intrinsic.
function simdLaneLitCheck(nm: string, argIx: i32, max: i32) {
  const laneIx = parenPeelIx(argIx)
  if laneIx < 0 || laneIx >= P.nodes.length { return 0 }
  const le = P.nodes[laneIx]
  if le is NumLit {
    if !numLexIsFloat(le.numText) {
      if u8LexValue(le.numText) <= max { return 0 }
    }
  }
  tErr(
    nm
      + " requires a compile-time lane index literal in 0.."
      + i32ToStr(max)
      + " — the wasm lane immediate is not a runtime operand",
    argIx,
  )
  0
}

// A memory intrinsic called with one argument more than it declares: the offset form, whose
// second argument is the memarg offset. Checks the offset (`memOffsetArgCheck`) and every other
// argument against the declared parameter it stands for; answers the call's type, or -1 when
// the call is not this form (a shadowed name, a named argument, any other arity).
function checkMemOffsetCall(n: Call, cfn: Ident): i32 {
  const nm = cfn.identName
  const base = memOffsetBaseArity(nm)
  if base < 0 || n.callArgs.length != base + 1 { return -1 }
  if hasNamedArgs(n.callArgNames) { return -1 }
  if (fnDeclIx[nm] ?? -1) >= 0 || lookupDepth(nm) != 0 { return -1 }
  const ft = T.tys[checkNode(n.callFn)]
  if ft is TyFunc {
    const ps = ft.fnParamTypes
    if ps.length != base { return -1 }
    memOffsetArgCheck(nm, n.callArgs[1])
    let k = 0
    while k < base {
      let pos = k
      if k >= 1 { pos = k + 1 }
      const a = n.callArgs[pos]
      seedExpected(a, ps[k])
      const at = checkNode(a)
      if !assignableExpr(a, at, ps[k]) { argMismatchErr(pos + 1, ps[k], at, a) }
      k = k + 1
    }
    return ft.fnRet
  }
  -1
}

// Reports unless the offset argument at `argIx` is a compile-time integer in
// `0..MEM_OFFSET_MAX`: a literal, a top-level `const` bound to one that no nearer binding
// shadows, or a sum of those.
function memOffsetArgCheck(nm: string, argIx: i32) {
  checkNode(argIx)
  if memOffsetCheckedValue(argIx) >= 0 { return 0 }
  tErr(
    nm
      + " takes its offset (argument 2) as a compile-time integer in 0..4294967295 — a literal, a top-level `const` bound to one, or a sum of those — since it is the instruction's memarg immediate, not a runtime operand",
    argIx,
  )
  0
}

// Calls to a compiler builtin named by the callee identifier — `print`, `Map`/`Set`, the
// codepoint constructors and the `__array_*` / bitcast / numeric intrinsics. None has a
// declaration to check against, so arity and argument types are checked here. Returns the
// call type, or `-1` when the name is none of them and the caller checks it as a value.
function checkBuiltinIdentCall(n: Call, ix: i32, cfn: Ident): i32 {
  // `print(x)` is a compiler builtin (no module/import system yet): it accepts a
  // single value of any printable type and yields void. Special-cased so a program
  // that prints does not trip "undeclared identifier 'print'". Each argument is
  // still checked so a type error inside it surfaces.
  if cfn.identName == "print" {
    const pargs = n.callArgs
    if pargs.length != 1 {
      tErr("print expects 1 argument, got " + i32ToStr(pargs.length), ix)
    }
    let pj = 0
    while pj < pargs.length {
      const pt = checkNode(pargs[pj])
      // `print` demands a value to render, and a `void` call has none — the emitter's
      // print ladder ends in `call __print_i32__` with nothing on the stack.
      voidValueSlotErr(pt, pargs[pj], "print", pargs[pj])
      // A domain rejection, asked first (the ruling): `print` takes one value of
      // `printDomainStr()`'s reps, and an array/struct/map/function value (bare, behind
      // `| null`, or inside a union) is not one — an ordinary domain error (`tErr`, no
      // code), not a capability admission, since the language never defined what such a print outputs (D711).
      if tyPrintsAsRef(pt, 24) {
        tErr(printRefRefusal(pt), pargs[pj])
      } else {
        // The BOXED value-union residue. `print(<i32 | string>)` now LOWERS — every arm
        // is inside the domain and the emitter dispatches on the box tag, the same
        // dispatch it performs for `is` (D712) — so what is left here is a box whose
        // arms that dispatch cannot classify, and only that keeps the concession.
        const puMsg = printUnionRefusal(pt)
        if puMsg != "" { tErrUnsupported(puMsg, pargs[pj]) }
      }
      // A printed type that still carries a HOLE answers FALSE to both floors above — it
      // is neither a ref nor a box YET — so the two of them together admit every generic
      // `print`. Defer it to the pin, the only position that knows the instance.
      // (`silent-class-inventory` D401; the recorder's header has the measurement.)
      notePrintCstr(pt, pargs[pj])
      pj = pj + 1
    }
    return TY_VOID
  }
  // `Map()` / `Set()` construct an empty string-keyed map: key/value HOLES (-1)
  // assignable to any map annotation (`const m: {[string]: i32} = Map()`).
  if cfn.identName == "Map" || cfn.identName == "Set" {
    if n.callArgs.length != 0 {
      tErr(cfn.identName + " expects no arguments", ix)
    }
    if callHasTyArgs(ix) { return collCtorTyArgsTy(cfn.identName, ix) }
    if cfn.identName == "Set" {
      // A set's VALUE type is the membership boolean; the element (key) is a
      // hole pinned by the annotation or the first `.add`.
      return mkMapTy(-1, TY_BOOL, 1)
    }
    return mkMapTy(-1, -1, 0)
  }
  // `toString(x)` resolves through the ordinary scope as `std:fmt`'s export now, and an
  // un-imported use gets the migration hint `undeclaredIdentMsg` appends.
  // `fromCodePoints(xs)` is a builtin: an `i32[]` of code points to a string, in one bulk
  // copy (the amortized alternative to per-char concat).
  if cfn.identName == "fromCodePoints" {
    const pargs = n.callArgs
    if pargs.length != 1 {
      tErr(
        "fromCodePoints expects 1 argument, got " + i32ToStr(pargs.length),
        ix,
      )
    } else {
      const p0 = checkNode(pargs[0])
      const p0t = T.tys[p0]
      let pOk = false
      if p0t is TyArray {
        // An empty `[]` literal's element hole (-1) pins to i32 here.
        if p0t.aElem < 0 || assignable(p0t.aElem, TY_I32) { pOk = true }
      }
      if p0t is TyErr { pOk = true }
      if !pOk {
        tErr("fromCodePoints expects an i32[], got " + tyToStr(p0), ix)
      }
    }
    return TY_STR
  }
  // `fromCodePoint(code)` is a builtin: an i32 code point -> a length-1 string.
  if cfn.identName == "fromCodePoint" {
    const fargs = n.callArgs
    if fargs.length != 1 {
      tErr(
        "fromCodePoint expects 1 argument, got " + i32ToStr(fargs.length),
        ix,
      )
    } else {
      const f0 = checkNode(fargs[0])
      if !assignable(f0, TY_I32) {
        tErr("fromCodePoint expects an i32, got " + tyToStr(f0), ix)
      }
    }
    return TY_STR
  }
  // `__str_from_bytes__(src, at, count)` (D4784): the bytes `src[at .. at + count]` as a fresh
  // string; the caller guarantees UTF-8. A builtin, not a declaration, so a call is no opaque
  // function value to the narrowing rule (`callDeclFnIx`).
  if cfn.identName == "__str_from_bytes__" {
    const sbArgs = n.callArgs
    if sbArgs.length != 3 {
      tErr(
        "__str_from_bytes__ expects 3 arguments, got " + i32ToStr(sbArgs.length),
        ix,
      )
      return TY_STR
    }
    const sbSrc = checkNode(sbArgs[0])
    if !assignable(sbSrc, mkArrayTy(TY_U8)) {
      tErr(
        "__str_from_bytes__ expects a u8[] source, got " + tyToStr(sbSrc),
        ix,
      )
    }
    let sbI = 1
    while sbI < 3 {
      const sbT = checkNode(sbArgs[sbI])
      if !assignable(sbT, TY_I32) {
        tErr("__str_from_bytes__ expects an i32 bound, got " + tyToStr(sbT), ix)
      }
      sbI = sbI + 1
    }
    return TY_STR
  }
  // The array-intrinsic floor (std-design D1 / collections-design §LS.2),
  // host parity: `defaultScope.ts`. `__array_new__(n, fill)` allocates `n`
  // slots each set to `fill`, typing as `T[]` with `T` = the fill's type.
  if cfn.identName == "__array_new__" {
    const anArgs = n.callArgs
    if anArgs.length != 2 {
      tErr(
        "__array_new__ expects 2 arguments, got " + i32ToStr(anArgs.length),
        ix,
      )
      return mkArrayTy(-1)
    }
    const anLen = checkNode(anArgs[0])
    if !assignable(anLen, TY_I32) {
      tErr("__array_new__ expects an i32 length, got " + tyToStr(anLen), ix)
    }
    return mkArrayTy(checkNode(anArgs[1]))
  }
  // `__array_new_default__(n)`: `n` zeroed/default slots. The element type is a hole (-1)
  // pinned by the destination — the empty-`[]` mechanism — and the emitter reads the same
  // pinned row back off this node (`arrNewDefaultKind`), so the two cannot disagree about
  // the rep. Two questions this arm cannot answer yet are recorded here and asked late (`arrDefCallIx`).
  if cfn.identName == "__array_new_default__" {
    const adArgs = n.callArgs
    if adArgs.length != 1 {
      tErr(
        "__array_new_default__ expects 1 argument, got " + i32ToStr(adArgs.length),
        ix,
      )
    } else {
      const adLen = checkNode(adArgs[0])
      if !assignable(adLen, TY_I32) {
        tErr(
          "__array_new_default__ expects an i32 length, got " + tyToStr(adLen),
          ix,
        )
      }
    }
    const adTy = mkArrayTy(-1)
    arrDefCallIx.push(ix)
    arrDefCallTy.push(adTy)
    return adTy
  }
  // `__array_copy__(dst, dstAt, src, srcAt, count)`: bulk-moves `count` elements from
  // `src[srcAt..]` into `dst[dstAt..]`; void. Both must be arrays; the element correlation
  // between them is deliberately not enforced here, matching the host's own leniency (a
  // mismatched pair fails loudly at the emit stage in both compilers).
  if cfn.identName == "__array_copy__" {
    const acArgs = n.callArgs
    if acArgs.length != 5 {
      tErr(
        "__array_copy__ expects 5 arguments, got " + i32ToStr(acArgs.length),
        ix,
      )
      return TY_VOID
    }
    let acI = 0
    while acI < 5 {
      const acT = checkNode(acArgs[acI])
      if acI == 0 || acI == 2 {
        const acTy = T.tys[acT]
        let acOk = false
        if acTy is TyArray { acOk = true }
        if acTy is TyErr { acOk = true }
        if !acOk {
          tErr("__array_copy__ expects a T[], got " + tyToStr(acT), ix)
        }
      } else {
        if !assignable(acT, TY_I32) {
          tErr("__array_copy__ expects an i32, got " + tyToStr(acT), ix)
        }
      }
      acI = acI + 1
    }
    return TY_VOID
  }
  // `__trap__()`: the deliberate abort primitive — lowered to `unreachable`.
  // `__trap__("reason")`: an OPTIONAL single string message, printed to the
  // host boundary (the print-of-string path) before the abort — so the trap
  // carries a human-readable reason. Either form still "never returns".
  if cfn.identName == "__trap__" {
    if n.callArgs.length > 1 {
      tErr("__trap__ takes an optional string message", ix)
    } else if n.callArgs.length == 1 {
      const trapMsgTy = checkNode(n.callArgs[0])
      if !assignable(trapMsgTy, TY_STR) {
        tErr(
          "__trap__ takes an optional string message, got " + tyToStr(trapMsgTy),
          ix,
        )
      }
    }
    return TY_NEVER
  }
  // The numeric-opcode intrinsics: each lowers to exactly one wasm instruction, so
  // the checker only has to type them. A user binding of the same name shadows the
  // intrinsic (`numIntrShadowed`), and the emitter gates on the same rule — the
  // intrinsic arm is a fallback for a name the program did not define itself.
  if !numIntrShadowed(cfn.identName) {
    const bcTy = bitcastCallTy(cfn.identName, n, ix)
    if bcTy >= 0 { return bcTy }
    const niTy = numIntrCallTy(cfn.identName, n, ix)
    if niTy >= 0 { return niTy }
  }
  -1
}

// The ordinary call: the callee evaluates to a function type, so the arguments are checked
// against its parameter list — named arguments reordered, an omitted trailing one filled
// from the declaration default, and type-parameter bindings solved from the argument types.
// Always answers; the caller's remaining arms cover an error or still-unsolved callee.
function checkCallOnFuncTy(n: Call, ix: i32, cfn: Node, ft: TyFunc): i32 {
  let args = n.callArgs
  // PENDING return (-2): the un-annotated callee hasn't been inferred yet (a
  // forward call). Demand-infer it now — check its FuncDecl, which patches this
  // very TyFunc in place — unless it is already on the in-progress stack (an
  // in-cycle call: contribute TY_ERR so the cycle can be detected at the root).
  if ft.fnRet == -2 {
    if cfn is Ident {
      if !onInferStack(cfn.identName) {
        const dIx = fnDeclIx[cfn.identName] ?? -1
        if dIx >= 0 { checkNode(dIx) }
      }
    }
  }
  let retTy = ft.fnRet
  if retTy == -2 {
    retTy = TY_ERR
    // A direct self-recursive call resolves to the function's own provisional inferred
    // type (`inferObserved`, already holding the base case since it is checked first) —
    // without this, `TY_ERR` makes `assignable(TY_ERR, string)` vacuously true and a `+`
    // over the recursive call pollutes the inferred return. Mutual recursion keeps `TY_ERR` for the fixpoint to settle.
    if cfn is Ident {
      if inferStack.length > 0 {
        if inferStack[inferStack.length - 1] == cfn.identName {
          if inferObserved >= 0 { retTy = inferObserved }
        }
      }
    }
  }
  const params = ft.fnParamTypes
  // Defaults are direct-call-site sugar: a call naming a declared function may omit
  // trailing arguments whose parameters carry a default, so the accepted arity is the
  // range [`fnRequiredArity`, `params.length`]. A call through a function value has no
  // declaration to read defaults from and keeps its exact-arity gate.
  const dParams = calleeDeclParams(n.callFn)
  // A rest parameter is the one thing that makes the accepted arity unbounded above, and the
  // pack below is what puts it back: after it the argument list is index-parallel with the
  // parameter list again, which is the invariant everything from here down is written around.
  let restIx = -1
  if dParams.length == params.length { restIx = restParamIndex(dParams) }
  if restIx >= 0 {
    if !callIsRestPacked(ix) {
      const lo = restRequiredArity(dParams, restIx)
      if args.length < lo {
        tErr(
          "wrong number of arguments: expected at least "
            + i32ToStr(lo)
            + ", got "
            + i32ToStr(args.length),
          ix,
        )
        return retTy
      }
      if !restCallPack(n, ix, restIx) { return retTy }
    }
    args = n.callArgs
    // Written type arguments already say what the element is, which is the refusal's remedy.
    if restIx < args.length && !callHasTyArgs(ix) {
      if restHoleUnionErr(params[restIx], args[restIx], ix) { return retTy }
    }
  } else if hasSpreadItem(args) {
    tErr(spreadNoRestMsg(calleeIdentName(cfn)), ix)
    return retTy
  }
  let required = params.length
  if dParams.length == params.length { required = fnRequiredArity(dParams) }
  if args.length < required || args.length > params.length {
    tErr(
      "wrong number of arguments: expected "
        + arityWantText(required, params.length)
        + ", got "
        + i32ToStr(args.length)
        + tyArgReadHintIfAny(args)
        + ovPlainHint(ix),
      ix,
    )
    return retTy
  }
  // Named arguments bind to parameters by name, then positionally — source order is
  // irrelevant for named args. `TyFunc` carries no parameter names, so the names resolve
  // against the declaration the scope chain gives this callee; a closure-valued binding has
  // none and cannot take named arguments, whatever a same-named declaration says (D1604).
  if hasNamedArgs(n.callArgNames) {
    const cNames = paramNamesOfNodes(dParams)
    if cNames.length != params.length {
      tErr(
        "named arguments work only on declared functions, not on a function value",
        ix,
      )
      return retTy
    }
    args = orderNamedCallArgs(cNames, args, n.callArgNames, ix, dParams)
    if args.length != params.length { return retTy }
  } else if args.length < params.length {
    // Trailing positional omission: check the defaults against their
    // parameters alongside the supplied arguments, so one loop below covers
    // the whole parameter list. (`args` is rebound to a COPY — `n.callArgs`
    // stays the source list; the emit-side normalization is `emit_rewrite`'s.)
    const padded: i32[] = []
    let pj = 0
    while pj < params.length {
      if pj < args.length { padded.push(args[pj]) } else { padded.push(-1) }
      pj = pj + 1
    }
    if fillArgDefaults(padded, dParams, ix) >= 0 { return retTy }
    args = padded
  }
  // Generic call-site inference: a `TyVar` param (or `T[]`) binds its type-param to
  // the argument's type (first use wins; later uses must agree), and the return
  // type substitutes through the binding — so `id("s")` is `string`, and
  // `let n: i32 = id("s")` is a genuine type error downstream.
  const bNames: string[] = []
  const bTys: i32[] = []
  const uNames: string[] = []
  const uTys: i32[] = []
  // Explicit type arguments bind first, so every argument is checked against them.
  const explicitTa = callHasTyArgs(ix)
  if explicitTa {
    if !bindExplicitTyArgs(cfn, ix, bNames, bTys) { return TY_ERR }
  }
  let dstNames = NO_DST_NAMES
  if !explicitTa && callDstTyOf(ix) >= 0 {
    dstNames = []
    dstBindLitTyParams(ix, ft.fnRet, params, args, bNames, bTys, dstNames)
  }
  const argOrder = lambdaLastOrder(params, args)
  // Each argument's destination as its own turn saw it, for the literals re-delivered below.
  const argExp: i32[] = []
  while argExp.length < args.length { argExp.push(-1) }
  let oi = 0
  while oi < argOrder.length {
    const i = argOrder[oi]
    // Contextual param inference for a function-value argument: propagates the expected
    // param type into it so an un-annotated literal param infers from the signature
    // (matching `.map`/`.filter`), substituting type-param bindings from earlier arguments
    // first — `mapArr(xs: T[], f: (T) => R)` called with `[1,2,3]` binds `T = i32` before seeding `f`'s param as `i32`.
    seedExpected(args[i], substTyDeep(params[i], bNames, bTys))
    if tpEnvNames.length > 0 { tpIfMarkOk(args[i]) }
    const at = checkNode(args[i])
    // A template hole meeting its injected renderer. This line is the first
    // moment the hole's type exists, which is why the type-directed half of
    // the template lowering lives here and not in the parser's desugar.
    if nodeIsTplHole(args[i]) {
      if tplHoleHandled(ix, n.pos, args[i], at, params[i]) { return TY_STR }
    }
    // A void argument would bind a type parameter to `void`, which no instance can carry; a
    // concrete parameter already refuses it through `assignable`, with its own message.
    if tyHasTyVar(params[i]) || tyIsHole(params[i]) {
      if isVoidTy(at) && !voidSlotExemptExpr(args[i]) {
        tErr(
          "argument " + i32ToStr(i + 1) + " expects a value, got void",
          args[i],
        )
        return TY_ERR
      }
    }
    // Bind every TyVar reachable in the expected param position from the
    // argument's shape (first use wins), then check the argument against the
    // SUBSTITUTED expected type — a later disagreeing use errors here.
    bindGenWalk(params[i], at, bNames, bTys)
    bindGenUnionArm(params[i], at, uNames, uTys)
    const expected = substTyDeep(params[i], bNames, bTys)
    argExp[i] = expected
    // A `u8[]` argument meeting a generic parameter: `bindGenWalk` above declined to bind
    // `T` to storage type `u8`, so `expected` still carries the unsolved hole and
    // `assignable` answers true vacuously — needing its own message here, or the
    // monomorphizer builds i32-list machinery over a one-byte backing. `u8[]` is not an instantiation of `T[]`, since `T` ranges over value types and `u8` is storage.
    if !inferQuiet {
      if tyIsU8ArrayTy(at) && tyReachesHole(expected, 8) {
        tErr(
          "`u8[]` cannot be passed to a generic parameter — `u8` is a storage type, so a type parameter never binds it and a `u8[]` is not a `T[]`",
          args[i],
        )
      }
    }
    // A hole or deferred-join argument passes `assignable` vacuously, so the demand is
    // recorded here and re-validated at the generic call site that pins it under the
    // substituted argument types — without this, `function f(x) { g(x) }` with `g(n: i32)`
    // type-checks `f("s")` clean and dies at wasm validation. Recorded on the argument's uncollapsed type, since a join's collapsed arm can later prove unreachable.
    let atCstr = inferRetTyOf(args[i], at)
    if coalDefHole.length > 0 { atCstr = coalPinTy(args[i], atCstr) }
    if (
      tyIsHole(atCstr)
      || tyIsDeferredJoin(atCstr)
      || (atCstr >= 0
        && atCstr < T.tys.length
        && T.tys[atCstr] is TyUnion
        && tpGradualView(atCstr) != atCstr)
    ) {
      if !tyIsHole(expected) {
        let ccWho = ""
        if cfn is Ident { ccWho = cfn.identName }
        let acForm = ACF_PLAIN
        if nodeIsTplHole(args[i]) { acForm = ACF_TPL }
        noteArgCstr(atCstr, expected, ccWho, acForm, -1)
      }
    } else if compArgCstrOk(atCstr, expected) {
      let cpWho = ""
      if cfn is Ident { cpWho = cfn.identName }
      noteArgCstr(atCstr, expected, cpWho, ACF_COMP, args[i])
    }
    // A hole param whose body DEMANDED fields (member access on the hole)
    // checks the argument against the demanded shape, so `getx(5)` rejects
    // when the body read `o.x` (host: the grown `Infer<{x,…}>` pin).
    const pHole = T.tys[params[i]]
    if pHole is TyVar {
      noteHoleArgNullRead(pHole.tvName, at, args[i])
      if !holeDemandOk(pHole.tvName, args[i], at) {
        holeArgDemandErr(pHole.tvName, i + 1, at, args[i])
      }
      // A hole the body INDEXED (`self[i]`) demands an array — a scalar argument can't be
      // indexed, so reject it here (`head(5)`) instead of deferring to an emit failure.
      if rowIsArrayDemanded(params[i]) {
        if tyRefusesArrayDemand(at) { holeArgArrayErr(i + 1, at, args[i]) }
        // An enclosing type parameter passed in takes the demand to its own pin.
        if at >= 0 && T.tys[at] is TyVar { noteArrayDemand(arrayDemandKey(at)) }
      }
      if holeIsArrayWriteDemanded(calleeIdentName(cfn), pHole.tvName) {
        if tyIxIsView(at) { holeArgViewErr(i + 1, at, args[i]) }
      }
      // The `as` cast the body parked on this hole, re-asked under the argument. D1342.
      holeCastPinCheck(
        pHole.tvName,
        at,
        holeCastParamName(n.callFn, dParams, i, pHole.tvName),
      )
    }
    // The cast this argument itself is (`id(a as? i32)`), whose destination the pin has to
    // re-ask (D1371) — but only when the parameter is not a hole: for a hole parameter,
    // `expected` is the pre-pin answer rather than a declared demand, and holding the cast to it would refuse a program whose annotated twin runs.
    if !tyIsHole(params[i]) { noteCastArgDest(args[i], i + 1, expected) }
    // Passing an empty-collection argument into a concrete `T[]` / map param pins
    // its element type from the param (`len(empty)` resolves `empty` to `i32[]`),
    // clearing its uninferred floor — pure downstream-usage inference, no push.
    constrainEmptyExpr(args[i], at, expected)
    const savedGenArg = widenRetagGenArg
    widenRetagGenArgSet(tyWideUnionMinted && tyHasTyVar(params[i]))
    const savedLbiGen = lbiNoDest
    lbiNoDest = tyHasTyVar(params[i])
    // A wider record into a declared record parameter: a parameter already made generic is
    // still held to its declared type, and a new one is made generic after this pass (D3992).
    const wsOrig = wsOrigTyOf(n, i)
    if wsOrig >= 0 && i < args.length && args[i] >= 0 && !tyHasTyVar(at) {
      wsSuppress = true
      const savedOrigLit = argLitAt
      argLitAt = peelParenIx(args[i])
      const wsOk = assignableExpr(args[i], at, wsOrig)
      argLitAt = savedOrigLit
      wsSuppress = false
      if !wsOk { argMismatchErr(i + 1, wsOrig, at, args[i]) }
    }
    const wsNew = wsOrig < 0
      && !inferQuiet
      && i < args.length
      && wsCandidate(n, i, args[i], at, expected)
    if wsNew { wsNotePending(n, i) }
    wsSuppress = wsNew
    const savedArgLit = argLitAt
    argLitAt = peelParenIx(args[i])
    const argOk = assignableExpr(args[i], at, expected)
    argLitAt = savedArgLit
    wsSuppress = false
    lbiNoDest = savedLbiGen
    widenRetagGenArgSet(savedGenArg)
    if !argOk {
      // Anchored at the offending argument (or its offending return site),
      // never at the call node — see `argMismatchErr`.
      argMismatchErr(i + 1, expected, at, args[i])
    } else if !tyIsHole(params[i]) {
      // It passed, and for a hole-bearing argument that means nothing: a hole is assignable
      // to anything, so a concrete parameter's comparison is answered before the deciding
      // type exists. Parked here and re-asked as the hole takes a pin (D1821).
      if tyHasTyVar(at) && tyIsFuncArena(expected) {
        if !argIsOwnGenericFnValue(args[i]) {
          argPinPark(expected, at, args[i], i + 1)
        }
      }
    }
    oi = oi + 1
  }
  // A list or record literal holding a generic function, met before a later argument bound the
  // type parameter its element type rides, is delivered again at the bound type (D3923).
  if !inferQuiet {
    let li = 0
    while li < args.length && li < params.length {
      if (
        argExp[li] >= 0
        && tyHasTyVar(argExp[li])
        && argIsLitAggregate(args[li])
      ) {
        const fin = substTyDeep(params[li], bNames, bTys)
        if fin != argExp[li] {
          genFnValueCstrs(args[li], nodeTyOf(args[li]), fin)
        }
      }
      li = li + 1
    }
  }
  if dstNames.length > 0 && !inferQuiet {
    dstRetypeLitArgs(dstNames, params, args, bNames, bTys)
  }
  // After the arguments, so a mismatched argument gets the more specific diagnostic first;
  // the answer itself is the callee's declaration, not this site's bindings.
  if cfn is Ident {
    let rtpDecl = fnDeclIx[cfn.identName] ?? CSTR_NODECL
    if rtpDecl == CSTR_NODECL { rtpDecl = lookupFnAliasNode(cfn.identName) }
    if !explicitTa {
      checkRetTyParamBound(rtpDecl, cfn.identName, ix, ft.fnRet)
    }
  }
  // Substitutes the binding into a generic return type — deep, so a structural return
  // (`{first: B, second: A}`, a generic alias body, a function-typed field) concretizes
  // per call site; a derived `?ret.` hole collapses to the pinned callee's return
  // (`substTyDeep`).
  const vNames: string[] = []
  const vTys: i32[] = []
  withUnionArmBinds(bNames, bTys, uNames, uTys, vNames, vTys)
  if vNames.length > 0 {
    const dBeforeC = T.diags.length
    let cstrCallee = CSTR_NODECL
    let cstrWho = ""
    if cfn is Ident {
      cstrCallee = fnDeclIx[cfn.identName] ?? CSTR_NODECL
      // A local bound to a declared generic names that declaration — without this rung the
      // call falls to `CSTR_NODECL` and adjudicates every generic in the program, since
      // `substTyDeep` matches `TyVar`s by name and `const g = idT  g(structList)` would
      // otherwise report a sibling's refusal.
      if cstrCallee == CSTR_NODECL {
        const aliasIx = lookupFnAliasNode(cfn.identName)
        if aliasIx >= 0 { cstrCallee = aliasIx }
      }
      cstrWho = cfn.identName
    }
    // The direct spelling has no receiver, so every parameter is an argument (`selfOff` 0)
    // and `params`/`args` are already 1:1 (named arguments reordered, defaults padded).
    const dhNames: string[] = []
    const dhArgNo: i32[] = []
    const dhArgNode: i32[] = []
    holeArgOrigins(params, args, 0, dhNames, dhArgNo, dhArgNode)
    const modeWas = substNestMode
    const declWas = substNestDecl
    let nestCallee = -1
    if cfn is Ident {
      // The declaration the callee names, directly or through an alias.
      nestCallee = lookupFnDeclNode(cfn.identName)
      if nestCallee < 0 { nestCallee = lookupFnAliasNode(cfn.identName) }
      if !nestParentOf.has(nestCallee) { nestCallee = -1 }
    }
    if nestCallee >= 0 {
      // A nested generic, named directly or through an alias, owns no constraint: they are its
      // enclosing function's, and a top-level function of the same name is another declaration.
      cstrCallee = CSTR_NODECL
      substNestModeSet(SUBST_NESTED)
      substNestDeclSet(nestCallee)
    } else if cstrCallee >= 0 {
      substNestModeSet(SUBST_DECLARED)
    } else if namesAllHoles(vNames) && tysHoldVar(vTys) {
      substNestModeSet(SUBST_HOLES)
    } else {
      substNestModeSet(SUBST_ALL)
    }
    const wsVd = T.diags.length
    instGenFnHolePins(vNames, vTys, cstrCallee, dhNames, dhArgNode)
    callBindNote(ix, vNames, vTys)
    pinBmCstrElems(vNames, vTys, ix, cstrCallee, args)
    if fsbName.length > 0 {
      fsbNoteCall(
        ix,
        fsbDeclAtNode(n.callFn),
        cstrCallee,
        cstrWho,
        dhNames,
        dhArgNo,
        dhArgNode,
        fsbArgTysOf(ft, vNames, vTys),
      )
    }
    validateBinCstrs(
      vNames,
      vTys,
      ix,
      cstrCallee,
      cstrWho,
      dhNames,
      dhArgNo,
      dhArgNode,
    )
    validatePrintCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
    validateNestCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
    validateIsCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
    validateArgCstrs(vNames, vTys, ix, cstrCallee, dhNames, dhArgNode)
    // The declared return rides the same pin: the body's mismatch check is vacuous under
    // a hole, and this is the first position that knows the instance (D551).
    validateRetCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
    // The destination seam, for the same reason: a value landing in a hole-typed local /
    // field / element inside the body is a mismatch the body's own gate cannot decide (D572).
    validateLetCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
    // A builtin collection method's argument inside the body, for the same reason at a
    // callee kind the deferred-argument table cannot name: a builtin has no `FuncDecl`, so its own arm is the whole check and is vacuous under a hole (D582).
    validateBmCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
    // After the pins above, which can leave an argument's element open (`cnhPinBmElem`).
    if !inferQuiet {
      let oa = 0
      while oa < args.length {
        refuseOpenNullHoleArg(args[oa], cstrWho)
        oa = oa + 1
      }
    }
    // The receiver classification of a `.length` / `x[i]` inside the body: both arms admit
    // the operation on a type variable correctly (a `T` pinned to a collection has it), and
    // this is the first position that knows which rep `T` became (D651 / D691).
    validateMemCstrs(
      vNames,
      vTys,
      ix,
      cstrCallee,
      cstrWho,
      dhNames,
      dhArgNo,
      dhArgNode,
    )
    validateUfcsCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
    validateRcwPins(vNames, vTys, cstrCallee)
    if T.diags.length > wsVd { wsNoteInstErr(cstrCallee) }
    substNestModeSet(modeWas)
    substNestDeclSet(declWas)
    // Not a validation: the `??` result holes are substituted here for their BANK, which is
    // the only route the emitter has to the type this call gave the expression (D1702).
    if bNames.length > 0 { bankCoalHoles(bNames, bTys, cstrCallee) }
    // The bounds the callee declared, judged here in this site's own scope against the
    // types this site bound — not deferred, since a bound is written at the declaration:
    // there is nothing to record on the way in, only something to check on the way out.
    checkBoundsAtCall(cstrWho, cstrCallee, bNames, bTys, ix)
    // The escaped-join reject is a fallback, not an additional voice: when this site
    // already reported a precise operand/argument-flow diagnostic, a join report would only repeat it in vaguer words.
    if T.diags.length == dBeforeC && bNames.length > 0 {
      validateEscJoins(bNames, bTys, cstrCallee)
    }
    retTy = substTyDeep(retTy, vNames, vTys)
    if tpIfFn.length > 0 || tpIfReFn.length > 0 {
      const pinTys: i32[] = []
      let pp = 0
      while pp < params.length {
        pinTys.push(substTyDeep(params[pp], vNames, vTys))
        pp = pp + 1
      }
      validateTpIfJoins(vNames, vTys, pinTys, retTy, ix, cstrCallee)
    }
  }
  // A deferred join this site cannot decide has no rep, so it collapses to one arm, parked
  // whole for a `return h(w)` relay (`inferRetTyOf`); in a body the gate does not hold, one of
  // that body's own parameters is kept as a union instead, which its pins re-join (D3589).
  let kept = -1
  if tyIsDeferredJoin(retTy) && !njFnReached(njFnIx) {
    const keep = (apartHoleJoins.get(retTy) ?? false) || calleeRetDeclared(cfn)
    kept = keptParamUnion(retTy, keep)
  }
  let cRetTy = kept
  if kept < 0 { cRetTy = collapseDeferredJoin(retTy) }
  if cRetTy != retTy {
    noteDeferredJoinNode(ix, retTy)
    let ejWho = ""
    if cfn is Ident { ejWho = cfn.identName }
    if kept < 0 { noteEscJoin(retTy, ix, ejWho) }
  }
  return cRetTy
}

// Binds each type parameter of the generic return `ret` from the type the call's destination
// expects, when every argument that would bind it is a literal adapting to that type, so
// `const hs: f32[] = filled(4, 0.0)` is `filled<f32>` as an annotated literal is an `f32` (D3539).
function dstBindLitTyParams(
  ix: i32,
  ret: i32,
  params: i32[],
  args: i32[],
  bNames: string[],
  bTys: i32[],
  outNames: string[],
) {
  const dst = dstForArgs(callDstTyOf(ix), args, ret)
  if dst < 0 || ret < 0 || !anyArgIsLitOnly(args) || !tyHasTyVar(ret) {
    return 0
  }
  const dN: string[] = []
  const dT: i32[] = []
  bindGenWalk(ret, dst, dN, dT)
  let k = 0
  while k < dN.length {
    if bindOf(bNames, bTys, dN[k]) < 0 {
      if prbArmed { prbEnter() }
      const adapts = dstTyParamAdapts(dN[k], dT[k], params, args, ix, ret, dst)
      if prbArmed { prbLeave("dstTyParamAdapts") }
      if adapts {
        bNames.push(dN[k])
        bTys.push(dT[k])
        outNames.push(dN[k])
        // The annotation chose the instance, so it is not redundant (D1442).
        cbSeedUsedSet(cbSeedUsed + 1)
      }
    }
    k = k + 1
  }
  0
}

// Records each literal argument that bound one of `names` at its parameter's substituted
// type, which is the type the instance is pinned by (`monoArgPinTyIx`) and the literal emitted at.
function dstRetypeLitArgs(
  names: string[],
  params: i32[],
  args: i32[],
  bNames: string[],
  bTys: i32[],
) {
  let i = 0
  while i < params.length && i < args.length {
    let hit = false
    for nm in names {
      if tyMentionsTyVarNamed(params[i], nm, 8) { hit = true }
    }
    if hit && args[i] >= 0 {
      const pt = substTyDeep(params[i], bNames, bTys)
      nodeTyRecord(args[i], pt)
      nodeTyRecord(parenPeelIx(args[i]), pt)
    }
    i = i + 1
  }
  0
}

// Whether the destination's `cand` for type parameter `name` replaces the arguments' binding at
// call `ix`: always for a bare `null` beside arguments `cand` holds; for a literal union only
// when every argument is a literal member of it; otherwise when every argument is a
// literal `cand` holds in its kind and the arguments' own instance cannot reach `dst` (D4024).
function dstTyParamAdapts(
  name: string,
  cand: i32,
  params: i32[],
  args: i32[],
  ix: i32,
  ret: i32,
  dst: i32,
): boolean {
  if (
    cand < 0
    || cand == TY_ERR
    || isVoidTy(cand)
    || tyHasTyVar(cand)
    || dstTyOpen(cand)
  ) {
    return false
  }
  // A body computing on `T` can leave a literal union (D3602), so only literal members of it
  // choose one.
  const litU = tyIsLitUnionLike(cand, 4)
  if litU {
    if litUnionOneBase(cand, 4) < 0 { return false }
    const cn = P.nodes[ix]
    if cn is Call {
      if !genericBodyClosed(callGenericDeclIx(cn), 0) { return false }
    } else {
      return false
    }
  }
  const one: string[] = [name]
  const oneT: i32[] = [cand]
  let seen = 0
  let own = -1
  let nulls = 0
  const others: i32[] = []
  let i = 0
  while i < params.length {
    if tyMentionsTyVarNamed(params[i], name, 8) {
      if i >= args.length || args[i] < 0 { return false }
      const want = substTyDeep(params[i], one, oneT)
      if argIsNullLit(args[i]) {
        // A bare `null` binds `T` to the null type (DV-402).
        if !assignable(TY_NULL, want) { return false }
        nulls = nulls + 1
        seen = seen + 1
        if own < 0 { own = TY_NULL }
        i = i + 1
        continue
      }
      if litU {
        const lt = litTyOfExpr(parenPeelIx(args[i]))
        if lt < 0 || !assignable(lt, want) { return false }
        seen = seen + 1
        if own < 0 { own = widenLitTy(lt) }
        i = i + 1
        continue
      }
      if !argIsLitOnly(args[i], 4) {
        others.push(i)
        i = i + 1
        continue
      }
      const x = parenPeelIx(args[i])
      if x < 0 || x >= P.nodes.length { return false }
      const isCall = P.nodes[x] is Call
      const savedQ = inferQuiet
      let at = -1
      if isCall {
        // A nested call is asked twice, speculatively: what it binds on its own, and whether the
        // destination's type, delivered to it in turn, is what it then answers.
        inferQuiet = true
        setCallDstTy(x, -1)
        at = checkNode(args[i])
        setCallDstTy(x, want)
        inferQuiet = savedQ
      } else {
        at = checkNode(args[i])
      }
      const aN: string[] = []
      const aT: i32[] = []
      bindGenWalk(params[i], at, aN, aT)
      if own < 0 { own = bindOf(aN, aT, name) }
      // Within the literal's kind only: an integer literal never makes `T` a float (B′).
      const wk = numKindMask(want, 8)
      if wk == 0 || (wk & ~numKindMask(at, 8)) != 0 { return false }
      inferQuiet = true
      if isCall { at = checkNode(args[i]) }
      const ok = at >= 0 && assignableExpr(args[i], at, want)
      inferQuiet = savedQ
      if !ok { return false }
      seen = seen + 1
    }
    i = i + 1
  }
  // A non-literal argument goes along only beside a `null`, and only one the binding holds.
  if others.length > 0 {
    if nulls == 0 { return false }
    for oi in others {
      const want = substTyDeep(params[oi], one, oneT)
      const savedQ = inferQuiet
      inferQuiet = true
      let at = nodeTyIxOf(args[oi])
      if at < 0 { at = checkNode(args[oi]) }
      const ok = at >= 0 && assignable(at, want)
      inferQuiet = savedQ
      if !ok { return false }
    }
    return true
  }
  if seen == 0 || own < 0 || tySame(own, cand) { return false }
  if nulls > 0 || litU { return true }
  // Only where the arguments' own instance cannot be delivered: anywhere it can, that instance
  // is the program's, and a body doing arithmetic on `T` must keep computing at it.
  const savedQ2 = inferQuiet
  inferQuiet = true
  const one2: string[] = [name]
  const own2: i32[] = [own]
  const ownRet = substTyDeep(ret, one2, own2)
  // `assignable` alone admits a list into a wider-element list; the delivery refuses that.
  const deliverable = assignable(ownRet, dst)
    && !objShapeAdapterlessAt(ix, ownRet, dst)
  inferQuiet = savedQ2
  !deliverable
}

// `p?.f(args)` — one guard over the receiver covers the whole call, so the callee and the
// arguments resolve against the receiver's non-null type and the result is that call's own
// return re-wrapped nullable. `-1` when no arm claimed the callee, leaving the caller's
// "called value is not a function" to speak (D1814).
function checkOptCallNode(n: Call, ix: i32, cfn: OptMember): i32 {
  omGuardSet(-1, -1)
  const recv = checkNode(cfn.omObj)
  if recv < 0 { return TY_ERR }
  const eff = omRecvTy(cfn.omObj, recv)
  if eff < 0 { return TY_ERR }
  // A `.` that inherited the chain's guard may not re-guard: same rule, same words, as the
  // member link's.
  if cfn.omDot {
    const de = T.tys[eff]
    if de is TyNullable {
      memberFloorErr(eff, cfn.omProp, ix)
      return TY_ERR
    }
  }
  const rcv = T.tys[recv]
  let wasNullable = false
  if rcv is TyNullable { wasNullable = true }
  const base = nonNullTy(eff)
  if base < 0 { return TY_ERR }
  let rt = checkMemberCallNode(n, ix, cfn.omObj, cfn.omProp, base)
  if rt < 0 {
    // No method arm claimed it: the callee is a VALUE on the receiver — a closure-typed
    // field. Its guarded type is the field's own function type, which is what the call
    // needs; the `?.` node's type is that same function behind a `| null`.
    const fnTy = checkNode(n.callFn)
    const g = omGuardTyAt(n.callFn)
    let cft = fnTy
    if g >= 0 { cft = g }
    if cft < 0 { return TY_ERR }
    const ft = T.tys[cft]
    if ft is TyErr { return TY_ERR }
    if !(ft is TyFunc) { return -1 }
    rt = checkCallOnFuncTy(n, ix, cfn, ft)
    if rt < 0 { return -1 }
  }
  omGuardSet(ix, rt)
  if rt == TY_VOID {
    noteOptCallRet(ix, rt, "")
    return TY_VOID
  }
  if wasNullable {
    const ort = mkNullableTy(rt)
    noteOptCallRet(ix, rt, valueUnionRetName(ort))
    return ort
  }
  noteOptCallRet(ix, rt, "")
  rt
}

// A call's explicit type arguments are legal on `Map`/`Set` and on a direct call of a
// declared generic function. Anything else is reported here, with its arguments still
// checked, and the call types as an error so nothing cascades from it.
function callTyArgsCalleeOk(cfn: Node, ix: i32): boolean {
  if cfn is Ident {
    const nm = cfn.identName
    if (nm == "Map" || nm == "Set") && lookupDepth(nm) < 0 { return true }
    if (
      arrayCtorNote(nm) != ""
      && lookupDepth(nm) < 0
      && lookupFnDeclNode(nm) < 0
    ) {
      tErr("explicit type arguments on `Array`" + arrayCtorNote(nm), ix)
      return false
    }
    const dIx = lookupFnDeclNode(nm)
    if dIx >= 0 {
      const d = P.nodes[dIx]
      if d is FuncDecl {
        if d.fnTyParams.length > 0 { return true }
        tErr(
          "`"
            + nm
            + "` is not generic, so it takes no type arguments — drop the `<…>`"
            + TY_ARG_READ_HINT,
          ix,
        )
        return false
      }
    }
  }
  tErr(
    "explicit type arguments need a direct call of a declared generic function, or `Map<K, V>()` / `Set<T>()`"
      + TY_ARG_READ_HINT,
    ix,
  )
  false
}

// Resolves a call's explicit type-argument nodes in the call's own scope, banking each type
// on its node for the emitter. -1 in `out` never survives: an unresolvable argument is
// reported at its own node and the answer is false.
function resolveCallTyArgs(ix: i32, out: i32[]): boolean {
  const tas = callTyArgsOf(ix)
  let ok = true
  let i = 0
  while i < tas.length {
    const ta = P.nodes[tas[i]]
    let t = -1
    if ta is TypeRef {
      t = nameToTyAt(ta.tyName, tas[i])
      if t < 0 { tErr(tyArgUnknownText(ta.tyName), tas[i]) }
    }
    if t < 0 {
      ok = false
      t = TY_ERR
    }
    if !inferQuiet {
      while nodeTyIx.length <= tas[i] { nodeTyIx.push(-1) }
      nodeTySet(tas[i], t)
    }
    out.push(t)
    i = i + 1
  }
  ok
}

// `Map<K, V>()` / `Set<T>()`: the constructor at the collection type its arguments name.
function collCtorTyArgsTy(ctor: string, ix: i32) {
  const tys: i32[] = []
  if !resolveCallTyArgs(ix, tys) { return TY_ERR }
  let want = 2
  if ctor == "Set" { want = 1 }
  if tys.length != want {
    tErr(collTyArgCountMsg(ctor, want, tys.length), ix)
    return TY_ERR
  }
  if !mapKeyTySupported(tys[0]) {
    mapKeyUnsupportedErr(tyToStr(tys[0]), ctor, callTyArgsOf(ix)[0])
    return TY_ERR
  }
  if ctor == "Set" { return mkMapTy(tys[0], TY_BOOL, 1) }
  mkMapTy(tys[0], tys[1], 0)
}

// Binds a generic callee's type parameters to the call's explicit type arguments, in
// declaration order, ahead of any argument — so each argument is checked against them.
// False (reported) on a count mismatch or an unresolvable argument.
function bindExplicitTyArgs(
  cfn: Node,
  ix: i32,
  bNames: string[],
  bTys: i32[],
): boolean {
  if cfn is Ident {
    const dIx = lookupFnDeclNode(cfn.identName)
    if dIx < 0 { return true }
    const d = P.nodes[dIx]
    if d is FuncDecl {
      const tys: i32[] = []
      if !resolveCallTyArgs(ix, tys) { return false }
      if tys.length != d.fnTyParams.length {
        let what = "type arguments"
        if d.fnTyParams.length == 1 { what = "type argument" }
        tErr(
          "`"
            + cfn.identName
            + "` takes "
            + i32ToStr(d.fnTyParams.length)
            + " "
            + what
            + " (`"
            + tyParamListText(d.fnTyParams)
            + "`), but the call gives "
            + i32ToStr(tys.length)
            + TY_ARG_READ_HINT,
          ix,
        )
        return false
      }
      let i = 0
      while i < tys.length {
        bNames.push(d.fnTyParams[i])
        bTys.push(tys[i])
        i = i + 1
      }
    }
  }
  true
}

// A call expression, dispatched on the callee's shape: a member callee to
// `checkMemberCallNode`, a bare identifier to `checkUnimplementedIntrinsicCall` and
// `checkBuiltinIdentCall`, a function-typed value to `checkCallOnFuncTy`. The type-answering
// three return `-1` for "no arm claimed it"; an unclaimed callee is reported here as `TY_ERR`.
function checkCallNode(n: Call, ix: i32) {
  const cfn = P.nodes[n.callFn]
  if callHasTyArgs(ix) {
    if !callTyArgsCalleeOk(cfn, ix) { return TY_ERR }
  }
  if cfn is Member {
    const mt = checkMemberCallNode(n, ix, cfn.memObj, cfn.memProp, -1)
    if mt >= 0 { return mt }
  }
  // `p?.f(args)` — the receiver's guard covers the whole call. Answered before the callee is
  // typed as a value, which is what read a nullable closure field as "not a function" (D1814).
  if cfn is OptMember {
    const ot = checkOptCallNode(n, ix, cfn)
    if ot >= 0 { return ot }
  }
  // A built-in call below answers without checking its callee, so the callee's binding is
  // recorded here, before any of them.
  if cfn is Ident { identNoteUse(n.callFn, cfn.identName) }
  if cfn is Ident {
    checkUnimplementedIntrinsicCall(cfn, ix)
    if cfn.identName == "__memory_shared__" && lookupDepth(cfn.identName) == 0 {
      memSharedCalls.push(ix)
    }
  }
  if cfn is Ident {
    if nameIsSimdIntrinsic(cfn.identName) { v128SeenSet(true) }
    checkSimdLaneArg(n, cfn)
  }
  if cfn is Ident {
    const mo = checkMemOffsetCall(n, cfn)
    if mo >= 0 { return mo }
  }
  if cfn is Ident {
    const bt = checkBuiltinIdentCall(n, ix, cfn)
    if bt >= 0 { return bt }
    if foreignLenCall(n, cfn) { return TY_ERR }
  }
  const savedCallee = ckCalleeIx
  ckCalleeIxSet(n.callFn)
  const fnTy = checkNode(n.callFn)
  ckCalleeIxSet(savedCallee)
  const ft = T.tys[fnTy]
  if ft is TyFunc { return checkCallOnFuncTy(n, ix, cfn, ft) }
  if ft is TyErr {
    // A module global called above its declaration, which the hoist could not type: its
    // arguments are still checked on their own, as a hole callee's are (D3899).
    if cfn is Ident && globalBeforeDecl(cfn.identName) {
      for ga in n.callArgs { checkNode(ga) }
    }
    return TY_ERR
  }
  if ft is TyVar {
    // Calling an inference-hole value — an un-annotated parameter used as a function inside
    // its own generic body (`function apply(fn, a, b) { fn(a, b) }`): the arguments are
    // checked on their own and the call yields a fresh hole, resolved once an outer call
    // binds the generic signature (the emitter compiles each instance concretely).
    const hargs = n.callArgs
    let hWho = ""
    if cfn is Ident { hWho = cfn.identName }
    let hj = 0
    while hj < hargs.length {
      const hat = checkNode(hargs[hj])
      // What the pinned function takes here, demanded of the argument at the pin (D3225).
      const hexp = mkDerivedHole(HD_PARAM, i32ToStr(hj), hj, -1, fnTy)
      if hat >= 0 && hexp >= 0 {
        noteArgCstr(hat, hexp, hWho, hj + 1, hargs[hj])
      }
      hj = hj + 1
    }
    if tyIsNonNullHoleRead(fnTy) {
      noteMemCstr(fnTy, OP_CALL_GUARDED_PIN, ix, false)
    } else {
      noteMemCstr(fnTy, OP_CALL_PIN, ix, false)
    }
    return mkDerivedHole(HD_RET, "", -1, -1, fnTy)
  }
  // `v.d()` over a getter reads `v.d` and calls the result: say which getter it read.
  let calledGetter = getSiteFnOf(n.callFn)
  if calledGetter == "" && cfn is Member {
    calledGetter = getterFnFor(checkNode(cfn.memObj), cfn.memProp)
  }
  if calledGetter != "" {
    tErr(
      "called value is not a function ("
        + tyToStr(fnTy)
        + ") — `."
        + getDeclPropOf(calledGetter)
        + "` reads the "
        + getDeclLabel(calledGetter)
        + "; drop the `()`",
      ix,
    )
    return TY_ERR
  }
  const shadow = builtinShadowMsg(n.callFn, fnTy)
  if shadow != "" {
    tErr(shadow, ix)
    return TY_ERR
  }
  tErr("called value is not a function (" + tyToStr(fnTy) + ")", ix)
  TY_ERR
}

// `len(x)` with no `len` in scope: refused at the callee with the VL spelling, `x.length`.
// True when it raised. A program that declares or imports its own `len` never reaches it.
function foreignLenCall(n: Call, cfn: Ident): boolean {
  if cfn.identName != "len" || n.callArgs.length != 1 { return false }
  if lookup("len") >= 0 { return false }
  const at = strLitRecvTy(checkNode(n.callArgs[0]))
  if !strListHas(builtinMethodNamesOf(at), "length") {
    tErr("undeclared identifier 'len'", n.callFn)
    return true
  }
  const recv = placeKeyOf(n.callArgs[0])
  let fix = "'.length'"
  if recv != "" { fix = "'" + recv + ".length'" }
  tErr(
    "undeclared identifier 'len' — a length is a member in VL; did you mean "
      + fix
      + "?",
    n.callFn,
  )
  true
}

export function resolveAnnot(name: string, typarams: string[]) {
  resolveAnnotTs(name, typarams, -1, "")
}

// `resolveAnnot`, with the annotation's spelling root threaded to the three legs that
// actually resolve. `root < 0` is the name route — what the exported entry point (and its
// `emit_rep.vl` callers) get, since a post-canon emit-time name has no live tree. The memo
// stays keyed on the name regardless: a hit returns the same index whichever route minted it, and only a miss re-reads the tree.
function resolveAnnotTs(
  name: string,
  typarams: string[],
  root: i32,
  owner: string,
) {
  if typarams.length == 0 {
    if tpEnvNames.length == 0 {
      const hit = annotNameMemo[name] ?? -2
      if hit != -2 {
        // Restores the collapse bank (D1048), for the same reason the negative leg restores
        // `unkTyPart`: a memo hit never re-enters the resolver, so a spelling whose first
        // resolution collapsed would answer "no collapse" at every later site.
        collapsedTySet(annotCollapsed[name] ?? -1)
        return hit
      }
      const negVer = annotNameMemoNegVer[name] ?? -1
      if negVer == cUserTypesVer {
        // Restore the component this name banked when it actually resolved, so the
        // caller's `unknownTyText` reads THIS name's leaf and not the last one anywhere.
        unkTyPartSet(annotPartOf(name))
        unkTyClashSet(annotClashOf(name))
        return -1
      }
      const diagsBefore = T.diags.length
      const r = annotResolve(name, root)
      if r >= 0 {
        // A resolution that raised a diagnostic is not banked: a quiet pass rolls the
        // diagnostic back, and a memo hit never raises it again (D2294).
        if T.diags.length == diagsBefore {
          annotNameMemo[name] = r
          // Banks the collapse alongside the index, only when there is one — the read
          // above defaults to -1, so the absent key means "this spelling collapses nothing".
          if collapsedTy >= 0 { annotCollapsedSetAt(name, collapsedTy) }
        }
      } else {
        annotNameMemoNegVer[name] = cUserTypesVer
        annotPart[name] = unkTyPart
        annotClash[name] = unkTyClash
      }
      return r
    }
    return annotResolve(name, root)
  }
  let i = 0
  while i < typarams.length {
    tpEnvNames.push(typarams[i])
    tpEnvTys.push(mkTyVarOwned(typarams[i], owner))
    i = i + 1
  }
  const r = annotResolve(name, root)
  let j = 0
  while j < typarams.length {
    tpEnvNames.pop()
    tpEnvTys.pop()
    j = j + 1
  }
  r
}

// A function's declared return type. `never` resolves only here: it says the function cannot
// return, which no other position can mean, so everywhere else it stays an unknown type (D1972).
function resolveRetAnnotAt(
  name: string,
  typarams: string[],
  at: i32,
  owner: string,
) {
  if name == "never" { return TY_NEVER }
  resolveAnnotAt(name, typarams, at, owner)
}

// `resolveAnnot` with resolution diagnostics anchored at node `at` (the
// annotation's TypeRef) — see `annotDiagAt`.
function resolveAnnotAt(
  name: string,
  typarams: string[],
  at: i32,
  owner: string,
) {
  const minted = luAnnTy[at] ?? -1
  if minted >= 0 { return minted }
  const saved = annotDiagAt
  annotDiagAtSet(at)
  const r = resolveAnnotTs(name, typarams, annTsOf(at), owner)
  annotDiagAtSet(saved)
  if name.length > 0 && name.slice(0, 1) == "{" { recAnnObjs.push(r) }
  // A container of vectors named by an annotation alone (a param, a field of a struct only
  // ever passed around, `v?: F32x4`) reaches no expression node, so it is refused here.
  if !inferQuiet {
    v128NestCheck(at, r)
    noteNestCstr(r, at)
  }
  r
}

// Record a type a PENDING body produced (a `return e` or the trailing expression):
// the first CONCRETE type wins; an error type only notes that something err-ish
// flowed back (an in-cycle call), which distinguishes "void body" from "no basis".
function noteInferredRet(t: i32) {
  if t < 0 { return 0 }
  const tt = T.tys[t]
  if tt is TyErr {
    inferSawErrSet(true)
    return 0
  }
  if tt is TyPrim {
    if tt.primName == "void" { return 0 }
    // A call that never returns is not a return witness: an un-annotated function that only
    // traps infers `void`, and `never` is a type a function must declare (D1972).
    if tt.primName == "never" { return 0 }
  }
  // Joins every non-void return, not just the first: a function whose returns disagree
  // (`return 5` … `return null`) infers the flattened union/nullable of them, so the caller
  // sees the true type — first-wins alone silently dropped later branches. A return reached
  // only through an `is`-guard over a hole param contributes a guarded member instead (`mkGuardedRetTy`).
  const g = mkGuardedRetTy(t)
  const lit = inferRetNextLit
  inferRetNextLitSet(false)
  inferRetLogTy.push(g)
  inferRetLogSeed.push(inferRetSeeding)
  inferRetLogLit.push(lit)
  inferRetJoin(g, lit)
  0
}

// Joins the return witness `g` into `inferObserved`; `lit` says it is a literal.
function inferRetJoin(g: i32, lit: boolean) {
  // A witness holding no number (a `null`, a string) neither adapts nor keeps a join apart.
  const neutral = !tyHoldsNumericPrim(g) && !tyHasTyVar(g)
  if inferObserved < 0 {
    inferObservedSet(g)
    inferObservedLitSet(neutral || lit)
    return 0
  }
  njApartRetSet(
    !inferObservedLit && !lit && !njJoinGated(inferObserved, g, true),
  )
  inferObservedSet(joinRetTys(inferObserved, g))
  if njApartRet { markTpJoinApart(inferObserved) }
  njApartRetSet(false)
  if !neutral { inferObservedLitSet(inferObservedLit && lit) }
  0
}

// A tail `if` arm's value, noted as a seed so `dropTailIfSeeds` can take it back.
function noteInferredSeed(t: i32, lit: boolean) {
  inferRetSeedingSet(true)
  inferRetNextLitSet(lit)
  noteInferredRet(t)
  inferRetSeedingSet(false)
  0
}

// Rewinds the inferred return to `obsMark`, the value it had at log row `logMark`, and re-joins
// only the non-seed rows since: the `return`s stay, every tail-arm value below the mark leaves.
function dropTailIfSeeds(logMark: i32, obsMark: i32, obsLit: boolean) {
  if logMark > inferRetLogTy.length { return 0 }
  const keepTy: i32[] = []
  const keepLit: boolean[] = []
  let i = logMark
  while i < inferRetLogTy.length {
    if inferRetLogSeed[i] {
      inferDroppedTy.push(inferRetLogTy[i])
      inferDroppedLit.push(inferRetLogLit[i])
    } else {
      keepTy.push(inferRetLogTy[i])
      keepLit.push(inferRetLogLit[i])
    }
    i = i + 1
  }
  while inferRetLogTy.length > logMark {
    inferRetLogTy.pop()
    inferRetLogSeed.pop()
    inferRetLogLit.pop()
  }
  inferObservedSet(obsMark)
  inferObservedLitSet(obsLit)
  let k = 0
  while k < keepTy.length {
    inferRetLogTy.push(keepTy[k])
    inferRetLogSeed.push(false)
    inferRetLogLit.push(keepLit[k])
    inferRetJoin(keepTy[k], keepLit[k])
    k = k + 1
  }
  0
}

function matchArmTally(
  ix: i32,
  body: i32,
  armTy: i32,
  acc: i32,
  accLit: boolean,
  lit: boolean,
): i32 {
  if ix < 0 || stmtAlwaysExits(body) { return acc }
  if ifArmGivesNoValue(body, armTy) {
    ifNoValueAtSetAt(ix, true)
    return acc
  }
  const v = f32ArmPlainTy(body, ifArmValTy(body, armTy))
  if acc < 0 { return v }
  joinArmLit(acc, accLit, v, lit)
}

// The type a valued `if` or `match` at `ix` joined to `join` takes instead, or -1: the
// destination banked for `ix` when every arm fits it (DV-1207). A `T | null` destination is
// banked as `T` (`seedExpected`), so only non-null arms adopt; a type parameter, or a `null` the
// seed left in a union, keeps the join's own type.
function litJoinOf(ix: i32, join: i32, arms: i32[], tys: i32[]): i32 {
  const jw = joinWantAt.get(ix) ?? -1
  if jw < 0 || join < 0 || tyHasTyVar(jw) || assignable(join, jw) { return -1 }
  if tyHasNullMember(jw) { return -1 }
  let i = 0
  while i < arms.length {
    if !joinArmFits(arms[i], tys[i], jw) { return -1 }
    i = i + 1
  }
  joinByWant.set(ix, true)
  jw
}

// Whether arm `armIx`, valued `armTy`, fits destination `want`: by its type, or as the literal
// its tail spells, which its type has already widened to the literal's base.
function joinArmFits(armIx: i32, armTy: i32, want: i32): boolean {
  if armTy < 0 || assignable(armTy, want) { return true }
  let tail = armIx
  const a = P.nodes[armIx]
  if a is Block {
    if a.blkStmts.length == 0 { return false }
    tail = a.blkStmts[a.blkStmts.length - 1]
  }
  const lt = litTyOfExpr(tail)
  lt >= 0 && assignable(lt, want)
}

// Checks each value a tail `if`/`else` (or the chain a `match` desugared to) yields against
// the declared return `ret`, at the arm that yields it — the check the bare tail expression
// gets. An arm that exits, yields no value or already failed is left to its own rule (D2234).
function checkTailArmsAgainst(ix: i32, ret: i32) {
  const leaves: i32[] = []
  tailValueLeaves(ix, leaves)
  let i = 0
  while i < leaves.length {
    const lf = leaves[i]
    i = i + 1
    const lt = nodeTyOf(lf)
    if lt >= 0 && lt != TY_ERR && lt != TY_NEVER && !isVoidTy(lt) {
      if !isStmtNode(lf) && !stmtAlwaysExits(lf) {
        if !assignableExpr(lf, lt, ret) {
          tErrWant(
            "expected "
              + tyToStr(ret)
              + ", got "
              + tyToStr(lt)
              + boolForNumberNote(lt, ret)
              + numUnionLossNote(lt, ret)
              + storageListNote(lf, lt, ret),
            lf,
            ret,
          )
        } else {
          noteRetCstr(coalPinTy(lf, lt), ret, lf)
        }
      }
    }
  }
  0
}

// The natural-return accumulator for the redundant-return rule (annotated funcs):
// the FIRST non-void/non-error return observed, mirroring noteInferredRet so the
// captured type IS what an unannotated version would infer.
function noteNaturalRet(t: i32) {
  if t < 0 { return 0 }
  const tt = T.tys[t]
  if tt is TyErr {
    retNaturalErrSet(true)
    return 0
  }
  if tt is TyPrim {
    if tt.primName == "void" { return 0 }
  }
  // JOIN, mirroring noteInferredRet (above) so the captured "natural" return IS what
  // an unannotated version would infer — a multi-return function joins to a union.
  if retNatural < 0 {
    retNaturalSet(t)
  } else {
    retNaturalSet(joinTys(retNatural, t))
  }
  0
}

// Demand-infer one top-level function's return, but only if still pending (the
// memoization guard already short-circuits a resolved one; the fixpoint resets to
// pending first to force a fresh re-inference once neighbours have settled).
function preInferOne(dIx: i32) {
  const dn = P.nodes[dIx]
  if dn is FuncDecl {
    const h = lookup(dn.fnName)
    let pending = true
    if h >= 0 {
      const ht = T.tys[h]
      if ht is TyFunc {
        if ht.fnRet != -2 { pending = false }
      }
    }
    if pending { checkFuncDeclNode(dn, dIx) }
  }
  0
}

// The return-inference pre-pass: resolves every un-annotated return with diagnostics, symbol
// recording and the redundant-type stream suppressed, so the real check pass runs against
// final return types. Non-cycle functions resolve in the first demand sweep; cycle-poisoned
// ones iterate to a fixpoint until the tentative set stops shrinking, and what remains is genuinely base-case-less.
function inferReturnsPrePass() {
  if topUnannotFns.length == 0 { return 0 }
  if prbArmed { prbEnter() }
  inferQuiet = true
  const m = checkMark()
  const savedSym = symEnabled
  symEnabled = 0
  let i = 0
  while i < topUnannotFns.length {
    preInferOne(topUnannotFns[i])
    i = i + 1
  }
  let shrinking = true
  let rounds = 0
  while shrinking && rounds < 2000 {
    rounds = rounds + 1
    const work = inferTentativeTake()
    let r = 0
    while r < work.length {
      resetReturnPending(work[r])
      r = r + 1
    }
    let q = 0
    while q < work.length {
      const dIx = fnDeclIx[work[q]] ?? -1
      if dIx >= 0 { preInferOne(dIx) }
      q = q + 1
    }
    if inferTentative.length >= work.length { shrinking = false }
  }
  unresolvedFnsSet([])
  let u = 0
  while u < inferTentative.length {
    unresolvedFns.push(inferTentative[u])
    u = u + 1
  }
  symEnabled = savedSym
  if prbSkip == 1 {
    checkRollback(m, RB_LINT)
  } else {
    checkRollback(m, RB_RETURNS)
  }
  inferQuiet = false
  if prbArmed { prbLeave("inferReturnsPrePass") }
  0
}

// Pass 1.65: types each un-annotated module global the hoist left a placeholder, by quietly
// checking its initializer at module scope, so a body checked before pass 2 reaches the
// declaration reads the global's real type (D3078). A lambda, or an initializer that raises a
// diagnostic or yields a hole, `null`, `void` or `never`, keeps the placeholder for pass 2.
function globalInitPrePass(lets: i32[]) {
  if lets.length == 0 { return 0 }
  if prbArmed { prbEnter() }
  const savedQuiet = inferQuiet
  const savedSym = symEnabled
  const m = checkMark()
  inferQuiet = true
  symEnabled = 0
  for li in lets {
    const ln = P.nodes[li]
    // A lambda with an un-annotated parameter is typed where it is written: checking one early
    // would fix those parameters before pass 2 marks them as inference holes.
    let lambdaInit = false
    if ln is LetDecl { lambdaInit = fsbIsHoleLambda(parenPeelIx(ln.letInit)) }
    if ln is LetDecl && !lambdaInit {
      const savedDiag = T.diags.length
      // Its own flow frame, so a read of a global still in the dead zone is neither reported
      // nor marked assigned here; pass 2 reports it where it is written.
      const daSaved = daEnterFrame()
      const it = checkNode(ln.letInit)
      daLeaveFrame(daSaved)
      const clean = T.diags.length == savedDiag
      while T.diags.length > savedDiag { T.diags.pop() }
      numLitNotesDropFrom(savedDiag)
      // A bare name of a top-level function is that function's own type, its type parameters
      // included, and the alias is recorded as pass 2 would record it (D3899).
      const aDecl = globalInitFnAlias(ln.letInit)
      if clean && it >= 0 && it != TY_ERR && !isVoidTy(it) && !isNullTy(it) {
        if !isNeverTy(it) && (aDecl >= 0 || !tyHasHole(it)) {
          declare(ln.letName, constStrLitBound(ln, it))
          if aDecl >= 0 && fnAliasScopes.length > 0 {
            fnAliasScopes[0][ln.letName] = aDecl
          }
        }
      }
    }
  }
  inferQuiet = savedQuiet
  symEnabled = savedSym
  checkRollback(m, RB_GLOBAL_INIT)
  if prbArmed { prbLeave("globalInitPrePass") }
  0
}

// Before pass 2 checks top-level statement `stmt`, quietly records the deferred constraints of
// every generic it reaches that no earlier statement did, callee before caller, so a call
// adjudicates its callee whatever the source order (D3062). Run per statement so a body sees the
// module values the statement sees; a cycle iterates while a table grows.
function cstrProbeBefore(stmt: i32) {
  if !cstrCandAny { return 0 }
  const order: i32[] = []
  let cyc = false
  const sn = P.nodes[stmt]
  if sn is FuncDecl {
    if (cstrCandIx[sn.fnName] ?? -1) == stmt {
      if (cstrCandState[sn.fnName] ?? 0) == 0 {
        cyc = cstrProbeVisit(stmt, order)
      }
    } else {
      cyc = cstrProbeWalk(sn.fnBody, order)
    }
  } else {
    cyc = cstrProbeWalk(stmt, order)
  }
  // The statement itself is checked for real next, so outside a cycle it needs no probe.
  if !cyc && order.length > 0 && order[order.length - 1] == stmt { order.pop() }
  if order.length == 0 { return 0 }
  if prbArmed { prbEnter() }
  const m = checkMark()
  const savedSym = symEnabled
  const savedQuiet = inferQuiet
  symEnabled = 0
  inferQuiet = true
  cstrProbeSet(true)
  let rounds = 0
  let growing = true
  while growing && rounds < 4 {
    rounds = rounds + 1
    const before = cstrRowCount()
    for oi in order {
      const fd = P.nodes[oi]
      if fd is FuncDecl { checkFuncDeclNode(fd, oi) }
    }
    growing = cyc && cstrRowCount() > before
  }
  cstrProbeSet(false)
  inferQuiet = savedQuiet
  symEnabled = savedSym
  checkRollback(m, RB_CSTR_PROBE)
  if prbArmed { prbLeave("cstrProbeBefore") }
  0
}

// Mark the last arm's condition when reaching it PROVES the test: every member no EARLIER arm
// covers must be covered by this arm, and there must be at least one such member (an arm the
// earlier ones already cover is unreachable, not provably true, and is left alone).
function markChainLastArmProven(ifIx: i32, members: i32[], testedTys: i32[]) {
  const last = chainLastArmOf(ifIx)
  if last < 0 { return 0 }
  if testedTys.length < 2 { return 0 }
  const lastTy = testedTys[testedTys.length - 1]
  let residue = 0
  let mi = 0
  while mi < members.length {
    let earlier = false
    let ti = 0
    while ti < testedTys.length - 1 {
      if assignable(members[mi], testedTys[ti]) { earlier = true }
      ti = ti + 1
    }
    if !earlier {
      if !assignable(members[mi], lastTy) { return 0 }
      residue = residue + 1
    }
    mi = mi + 1
  }
  if residue == 0 { return 0 }
  const ln = P.nodes[last]
  if ln is IfStmt {
    const cix = condUnderParens(ln.ifCond)
    const cnd = P.nodes[cix]
    // Only an `is` test is elided: the proof is about member coverage, and a literal `==`
    // arm's operand may be any expression the emitter must still evaluate.
    if cnd is IsExpr {
      if !condProvenTrue(ln.ifCond) { chainProvenCond.push(ln.ifCond) }
    }
  }
  0
}

// Soundness: does the else-less `is`-chain rooted at `ifIx` cover every variant of `p`'s
// union type? If so, fall-through is unreachable and needs no `else`; if not, a value falls
// off the end. Decided over the discriminated place's declared union members, requiring every
// arm test the same place — any arm that is not a bare `place is T` makes it non-exhaustive, never wrongly exhaustive.
function ifChainExhausts(ifIx: i32) {
  chainMissingSet("")
  let havePlace = false
  let placeName = "?"
  const testedTys: i32[] = []
  // `allIsArms` stays true only while every arm seen is a bare `<sameIdent> is T`
  // (the only shape we can prove exhaustive by union-member coverage).
  let allIsArms = true
  let node = P.nodes[ifIx]
  let walking = true
  while walking {
    if node is IfStmt {
      // Classify this arm's condition. Only a single `<ident> is T` (not null)
      // contributes to coverage; anything else makes the chain non-coverable.
      // A parenthesized arm (`else if (p is B)`) classifies like the bare one.
      const condIx = condUnderParens(node.ifCond)
      const cond = P.nodes[condIx]
      if cond is IsExpr {
        if cond.isVariant == "null" {
          allIsArms = false
        } else {
          const obj = P.nodes[cond.isObj]
          if obj is Ident {
            if !havePlace {
              placeName = obj.identName
              havePlace = true
            } else if placeName != obj.identName {
              allIsArms = false
            }
            const tIx = isTypeTyRead(cond.isVariant, condIx)
            if tIx < 0 { allIsArms = false } else { testedTys.push(tIx) }
          } else {
            allIsArms = false
          }
        }
      } else if cond is BinExpr {
        // A literal-equality arm `place == <lit>` discriminates a literal
        // union the same way an `is` arm does (host: literal narrowing via
        // `atomFact` + `subtractType`) — contribute the tested literal type.
        let armLit = -1
        let armObj = -1
        if cond.binOp == "==" {
          armLit = cmpLitTyOf(cond.binRight)
          armObj = cond.binLeft
          if armLit < 0 {
            armLit = cmpLitTyOf(cond.binLeft)
            armObj = cond.binRight
          }
        }
        if armLit >= 0 {
          const eobj = P.nodes[armObj]
          if eobj is Ident {
            if !havePlace {
              placeName = eobj.identName
              havePlace = true
            } else if placeName != eobj.identName {
              allIsArms = false
            }
            testedTys.push(armLit)
          } else {
            allIsArms = false
          }
        } else {
          allIsArms = false
        }
      } else {
        allIsArms = false
      }
      if node.ifElse < 0 {
        // No `else`: the chain ends here — decide by coverage below.
        walking = false
      } else {
        const nxt = P.nodes[node.ifElse]
        if nxt is IfStmt {
          node = nxt
        } else {
          // A real (block) `else` covers the fall-through outright — exhaustive
          // regardless of the arm shapes.
          return true
        }
      }
    } else {
      return false
    }
  }
  // No `else`. Only a pure `is`-chain over one place can be exhaustive by member
  // coverage; any other shape genuinely falls through.
  if !allIsArms { return false }
  // No place is discriminated (shouldn't happen) — not exhaustive.
  if !havePlace { return false }
  // Uses the pre-subtraction type first (`pgPreIx`): this chain's own post-guard narrowing
  // has already replaced the place's binding with the residue of the arms being counted, so
  // `lookup` alone would report "covered" for every chain whose arms actually diverge. The
  // bank is keyed by this chain's node, so it answers only when this chain did the subtracting; `lookup` is the fallback otherwise.
  let pty = -1
  if pgPreIx == ifIx {
    let pk = 0
    while pk < pgPreKeys.length {
      if pgPreKeys[pk] == placeName { pty = pgPreTys[pk] }
      pk = pk + 1
    }
  }
  if pty < 0 { pty = lookup(placeName) }
  if pty < 0 { return false }
  const pt = T.tys[pty]
  if pt is TyNullable {
    // A nullable place needs an explicit `is null` (or `else`) arm to be covered;
    // an else-less `is`-chain over the inner variants always leaves the null path.
    return false
  }
  if pt is TyUnion {
    // Cover each union member against the tested set; collect the uncovered
    // ones (rendered) so the diagnostic can name exactly what is missing.
    const members = pt.uMembers
    let mi = 0
    let allCovered = true
    while mi < members.length {
      let covered = false
      let ti = 0
      while ti < testedTys.length {
        if assignable(members[mi], testedTys[ti]) { covered = true }
        ti = ti + 1
      }
      if !covered {
        allCovered = false
        if chainMissing != "" { chainMissingSet(chainMissing + ", ") }
        chainMissingSet(chainMissing + tyToStr(members[mi]))
      }
      mi = mi + 1
    }
    if allCovered { markChainLastArmProven(ifIx, members, testedTys) }
    return allCovered
  }
  // A non-union place: an `is`-chain over it is degenerate; treat as covered
  // (a single concrete type is "exhausted" by any always-true branch).
  true
}

// Refuse a trailing else-less `is`-chain that does not cover every variant when the function
// returns a value: the uncovered path falls off the end and the emitter writes `unreachable`
// there. `retTy` is the annotated return or the inferred one, so inference is checked the same as
// an annotation; skipped for a void, error, or nullable return that legitimately falls (D1902).
function checkTrailingChainTotal(stmtIx: i32, retTy: i32) {
  if retTy < 0 { return }
  const lastN = P.nodes[stmtIx]
  if lastN is IfStmt {
    const firstCond = P.nodes[condUnderParens(lastN.ifCond)]
    let isChain = false
    if firstCond is IsExpr {
      isChain = true
    } else if firstCond is BinExpr {
      if firstCond.binOp == "==" {
        let eqPlace = -1
        if cmpLitTyOf(firstCond.binRight) >= 0 {
          eqPlace = firstCond.binLeft
        } else if cmpLitTyOf(firstCond.binLeft) >= 0 {
          eqPlace = firstCond.binRight
        }
        if eqPlace >= 0 {
          const eqObj = P.nodes[eqPlace]
          if eqObj is Ident {
            if isLitBearing(lookup(eqObj.identName)) { isChain = true }
          }
        }
      }
    }
    const retT = T.tys[retTy]
    let retNullable = false
    if retT is TyNullable { retNullable = true }
    if isChain && !isVoidTy(retTy) && retTy != TY_ERR && !retNullable {
      if !ifChainExhausts(stmtIx) {
        let chainFix = "add the missing variant(s) or an `else` (expected "
          + tyToStr(retTy)
          + ")"
        if chainMissing != "" {
          chainFix = "missing "
            + chainMissing
            + " (add the arm(s) or an `else`; expected "
            + tyToStr(retTy)
            + ")"
        }
        tErr(
          "non-exhaustive `is`-chain falls through with no `else` — " + chainFix,
          stmtIx,
        )
      }
    }
  }
}

// The inferred-return refusal, anchored at the END of the body it could not infer from — the
// one raise exempt from the node-span rule. It is a whole-body verdict and usually a
// consequence of an error inside that body, and the report is position-ordered: at the
// function's name it would print above its own cause.
function inferNoBasisErr(name: string, fnIx: i32, body: i32) {
  const msg = "cannot infer a return type for '"
    + name
    + "' — annotate a return type"
  const tk = nodeLastTok(body)
  if tk >= 0 { return tErrPushTok(msg, fnIx, tk, "", "") }
  tErr(msg, fnIx)
  0
}

// The un-annotated return, decided after the body is checked and its scope popped: the
// observed returns join into one type, a contextual expected return may adopt it, and the
// hoisted `TyFunc` is patched so existing references see the result. Restores the
// inference accumulators its caller saved, and hands back the return type to finalize.
function finishInferredReturn(
  n: FuncDecl,
  fnIx: i32,
  paramTys: i32[],
  causeReported: boolean,
  cbBefore: i32,
  savedObserved: i32,
  savedSawErr: boolean,
  savedValueRet: boolean,
  bodyTotalForRet: boolean,
): i32 {
  let ret = -2
  inferStack.pop()
  let inferred = TY_VOID
  // Set when the object-shaped contextual adoption fires (`objRetWidenAdopt` below):
  // gates the plain-struct canonical record — a lambda whose self-inference already
  // matches its context keeps the established un-pinned route (pinning every
  // plain-struct lambda regresses `.map`-collapse / factory / generic-HOF cases).
  let objRetAdopted = false
  const sawCycle = cycleBreakCount > cbBefore
  if inferObserved >= 0 {
    inferred = inferObserved
    noteRetJoinValues(inferred, n.fnBody)
  } else if sawCycle && fnSawValueRet {
    // A value return position resolved to `void` only because a recursive-cycle member
    // is still pending: defer, so the binding-group fixpoint re-infers this once the
    // cycle's resolvable members settle. Genuine void recursion has no value return
    // position (`fnSawValueRet` is false), so it is never deferred this way.
    if !strListHas(inferTentative, n.fnName) { inferTentative.push(n.fnName) }
    inferred = TY_VOID
  } else if inferSawErr {
    // Only err-ish types flowed back: no basis. An uninferable param or a bare `{}` in the
    // body already reported the root cause, so suppress the redundant message.
    if !causeReported { inferNoBasisErr(n.fnName, fnIx, n.fnBody) }
    inferred = TY_ERR
  }
  // Contextual return adoption: an anonymous lambda whose body infers a narrower numeric
  // than the contextual expected return takes the expected return as its own, so the
  // widening lands at the lambda's return seam (`emitReturnValue`). Numeric widening through
  // function-type variance is rejected instead (`fnSlotAssignable`), since a function value's rep is fixed.
  if n.fnName == "" && inferred >= 0 {
    // A contextual adoption below means the seed changed what this lambda infers, so an
    // annotation that supplied it is load-bearing and cannot be judged redundant by
    // comparing the two (D1442). Snapshot/compare rather than marking each arm, since there are twenty of them and a new one must not have to remember.
    const preAdopt = inferred
    const expRet = cbExpectedRetFor(fnIx)
    if expRet >= 0 {
      if numWidens(inferred, expRet) { inferred = expRet }
      // The f32 dual of the numeric widen: a literal-bodied lambda whose contextual return
      // is f32 infers f64/i32 by default, but the literal re-encodes exactly at f32 — the
      // same grant a direct `const v: f32 = 5.5` binding makes. Adopts f32 so the functype
      // result is f32 and `emitReturnValue` encodes the literal at f32 in the body.
      if inferred != expRet && primNameOf(expRet) == "f32" {
        if isF32AdoptingLitExpr(lambdaBodyTail(n.fnBody)) { inferred = expRet }
      }
      // Object-shaped dual: `() => ({f: 5})` against `() => {f: i64}` — adopt the
      // expected shape when every widening field is a re-encodable literal
      // (`objRetWidenAdopt` also records the field types for the emitter's interner).
      if objRetWidenAdopt(n.fnBody, inferred, expRet) {
        inferred = expRet
        objRetAdopted = true
      }
      // A bare `{}` body completes the expected record, as it would at any delivery (D2223).
      // Only marked when it cannot: the argument's own mismatch is then the one report.
      if inferred != expRet && bareBraceNode(lambdaBodyTail(n.fnBody)) {
        bareBraceSpecSet(bareBraceSpec + 1)
        bareBraceDeliver(lambdaBodyTail(n.fnBody), expRet, 8, true)
        bareBraceSpecSet(bareBraceSpec - 1)
        if bareBraceRecordOf(expRet) >= 0 { inferred = expRet }
      }
      // The litunion dual: a bare string-literal body that is a member of the expected
      // literal-union adopts it. Its inferred type is the softened `string`; the direct
      // `const k: K = "b"` binding grants the member flow via `assignableExpr`, but the
      // lambda-return path only had the numeric/object arms until this one.
      if inferred != expRet && tyIsLitUnion(expRet) {
        const luTail = lambdaBodyTail(n.fnBody)
        if luTail >= 0 && assignableExpr(luTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // A nullable-string result: a lambda body inferring a bare `string` member of an
      // expected `string | null` closure result adopts the nullable — its functype result is
      // the string-ref `ref.null` niche, and `emitReturnValue` niches the value exactly as
      // the named-function value spelling lowers. Covers the string/boolean niches only; a nullable numeric scalar boxes through `valueUnionRetName` instead.
      if inferred != expRet {
        const etU = T.tys[expRet]
        if etU is TyNullable {
          // The boolean-niche dual of the string niche: a lambda body inferring a bare
          // `boolean`/`null` member of an expected `boolean | null` adopts the niche — its
          // functype result is the i32 sentinel (2 = null), exactly as the annotated
          // `: boolean | null` return and the named-function value lower.
          if (
            tyIsPrimNamed(etU.nInner, "string")
            || tyIsPrimNamed(etU.nInner, "boolean")
          ) {
            const nsTail = lambdaBodyTail(n.fnBody)
            if nsTail >= 0 && assignableExpr(nsTail, inferred, expRet) {
              inferred = expRet
            }
          }
          // The nullable-list dual: a lambda body inferring the bare i32-backed list member
          // of an expected `T[] | null` adopts the niche — its functype result is the
          // nullable i32-list wrapper, exactly as the annotated form lowers. Distinct-backing
          // leaves (`i64[] | null`, …) are not adopted and stay loud checker rejects.
          if inferred != expRet && tyIsNulI32BackedListInner(etU.nInner) {
            const nlTail = lambdaBodyTail(n.fnBody)
            if nlTail >= 0 && assignableExpr(nlTail, inferred, expRet) {
              inferred = expRet
            }
          }
          // The nullable-closure dual: a lambda body inferring `null` (or a closure) against
          // an expected nullable-closure result adopts the niche — its functype result is
          // `(ref null $cloStruct)`, and `emitReturnValue`'s `retNulClosure` arm niches a
          // `return null` exactly as the annotated form already lowers.
          const etInnerTy = T.tys[etU.nInner]
          if etInnerTy is TyFunc {
            const ncTail = lambdaBodyTail(n.fnBody)
            if ncTail >= 0 && assignableExpr(ncTail, inferred, expRet) {
              inferred = expRet
            }
          }
          // The nullable-struct dual: a lambda body inferring the bare struct member (or
          // `null`) of an expected `S | null` closure result adopts the nullable — its
          // functype result is the `(ref null $S)` niche, exactly as the annotated
          // named-function value spelling already lowers.
          if etInnerTy is TyObj {
            const nsoTail = lambdaBodyTail(n.fnBody)
            if nsoTail >= 0 && assignableExpr(nsoTail, inferred, expRet) {
              inferred = expRet
            }
          }
          // The nullable-litunion dual: a lambda body inferring a bare `string` member of
          // the expected `K | null` litunion adopts the niche — its functype result is the
          // i32 atom (`-1` = null), and `emitReturnValue`'s `retNulLitUnion` arm encodes it
          // exactly as the annotated `: () => K | null` form already does.
          if tyIsLitUnion(etU.nInner) {
            const nluTail = lambdaBodyTail(n.fnBody)
            if nluTail >= 0 && assignableExpr(nluTail, inferred, expRet) {
              inferred = expRet
            }
          }
        }
      }
      // A value-union result: a lambda body inferring a bare scalar arm of the expected
      // value-union box result adopts the union, so the widening lands at the return seam —
      // `emitReturnValue` boxes the scalar and the functype result is the box itself
      // (`synthRetAnnots` pins `fnRet`). Checked after the niche arms, so a `T | null` niche is never swallowed as a value union.
      if inferred != expRet && valueUnionRetName(expRet) != "" {
        const vuTail = lambdaBodyTail(n.fnBody)
        if vuTail >= 0 && assignableExpr(vuTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The litunion-array dual of the value-union result: a lambda body inferring the bare
      // scalar arm of the expected `litunion-array | scalar` box adopts the union, boxing at
      // the return seam. `valueUnionRetName` declines this union (its render flattens the
      // litunion-array atom), so it needs its own alias-preserving arm.
      if inferred != expRet && litUnionArrayValueUnionRetName(expRet) != "" {
        const laTail = lambdaBodyTail(n.fnBody)
        // Gates on strict `assignable` of the body's inferred type, not the expression-level
        // `assignableExpr` the other arms use: the litunion-array arm reps as the kind-7
        // i32-atom list, but a bare array literal self-infers the softened `string[]`, whose
        // element re-typing would box the wrong tag. Only a body already at the union's own rep is adopted.
        if laTail >= 0 && assignable(inferred, expRet) { inferred = expRet }
      }
      // The closure-arm dual of the value-union result: a lambda body inferring one arm (a
      // closure or a scalar) of the expected closure-arm value union adopts it, boxing at
      // the return seam — a closure member is the kind-11 ref atom riding the box's anyref
      // value, and the functype result is the box (`synthRetAnnots` pins `fnRet`).
      if inferred != expRet && cloArmValueUnionRetName(expRet) != "" {
        const cvTail = lambdaBodyTail(n.fnBody)
        if cvTail >= 0 && assignableExpr(cvTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The map-member-union dual: a lambda body inferring one struct arm of the expected
      // map-member-union box result adopts the union, boxing the struct/map arm into the
      // #865/#868 map-union box at the return seam, exactly as the annotated form exposes
      // this rep already.
      if inferred != expRet && mapUnionRetName(expRet) != "" {
        const muTail = lambdaBodyTail(n.fnBody)
        if muTail >= 0 && assignableExpr(muTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The ref-arm dual: a lambda body inferring one arm (a ref list or a struct) of the
      // expected ref-arm union adopts it, boxing at the return seam so the functype result is
      // the box rather than the raw reflist a narrowed call site would then cast — a
      // guaranteed runtime trap or invalid wasm otherwise. Nominal-gated (`refArmUnionRetName` declines an anonymous-element array arm), so those shapes stay loud.
      if inferred != expRet && refArmUnionRetName(expRet, gRootStmts) != "" {
        const raTail = lambdaBodyTail(n.fnBody)
        if raTail >= 0 && assignableExpr(raTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The variant-box dual with an inline-struct arm: a lambda body inferring one arm of
      // the expected union adopts the whole union, boxing at the return seam so the
      // functype result is the box, matching the value call's `annSigKey`. Checked after
      // `refArmUnionRetName`, whose ref-array arms carry a slot render this arm declines.
      if inferred != expRet && variantBoxUnionRetName(expRet) != "" {
        const vbTail = lambdaBodyTail(n.fnBody)
        if vbTail >= 0 && assignableExpr(vbTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-nullable-list result: a lambda body array literal assignable to the
      // expected value-union-box list adopts it, so `emitReturnValue` seeds each nullable
      // element through the same rep the annotated `(f64|null)[]` form already lowers
      // (`synthRetAnnots` pins `fnRet`).
      if inferred != expRet && nulElemListRetName(expRet) != "" {
        const elTail = lambdaBodyTail(n.fnBody)
        if elTail >= 0 && assignableExpr(elTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-nullable-struct-list dual: a lambda body array literal (non-null
      // structs, or `null`) assignable to the expected nullable-struct-element list adopts
      // it, building each element through the kind-1 struct niche the annotated form already
      // lowers. Un-pinned, the body's structs would self-classify onto a different reflist slot than the annotation side.
      if inferred != expRet && nulStructElemListRetName(expRet) != "" {
        const nseTail = lambdaBodyTail(n.fnBody)
        if nseTail >= 0 && assignableExpr(nseTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-nullable-map-list dual: a lambda body array literal (non-null maps, or
      // `null`) assignable to the expected nullable-map-element list adopts it, building each
      // element through the kind-3 map niche the annotated form already lowers. Un-pinned,
      // the body's maps would self-classify onto a different reflist slot than the annotation side.
      if inferred != expRet && nulMapElemListRetName(expRet) != "" {
        const nmeTail = lambdaBodyTail(n.fnBody)
        if nmeTail >= 0 && assignableExpr(nmeTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-nullable-scalar-list dual: a lambda body array literal (non-null inner
      // lists, or `null`) assignable to the expected nullable-list-element list adopts it,
      // building each element through the nullable inner-wrapper niche the annotated form
      // already lowers. Un-pinned, the body's lists would self-classify onto a different reflist slot than the annotation side.
      if inferred != expRet && nulListElemListRetName(expRet) != "" {
        const nleTail = lambdaBodyTail(n.fnBody)
        if nleTail >= 0 && assignableExpr(nleTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-value-union-list dual: a lambda body array literal assignable to the
      // expected value-union-box list adopts it, boxing each element through the same
      // element-kind-2 rep the annotated form already lowers.
      if inferred != expRet && elemValueUnionListRetName(expRet) != "" {
        const evTail = lambdaBodyTail(n.fnBody)
        if evTail >= 0 && assignableExpr(evTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-variant-box-union-list dual: a lambda body array literal assignable to
      // the expected variant-box-element list adopts it, boxing each element through the
      // same element-kind-2 rep the annotated named-function value form already lowers.
      if inferred != expRet && elemVariantBoxListRetName(expRet) != "" {
        const vbeTail = lambdaBodyTail(n.fnBody)
        if vbeTail >= 0 && assignableExpr(vbeTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-map-union-list dual: a lambda body array literal assignable to the
      // expected map-union-element list adopts it, boxing each element through the same
      // element-kind-2 map-union box rep the annotated form already lowers. Un-pinned, the
      // body's array would self-classify onto a different reflist slot than the annotation side.
      if inferred != expRet && elemMapUnionListRetName(expRet) != "" {
        const meTail = lambdaBodyTail(n.fnBody)
        if meTail >= 0 && assignableExpr(meTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-refarm-value-union-list dual: a lambda body array literal assignable to
      // the expected list of (union-element-array | scalar) boxes adopts it, boxing each
      // element through the same element-kind-2 box the annotated form already lowers.
      // Un-pinned, the body's array would key onto a different `$fnsig` slot than the annotation side.
      if inferred != expRet && elemRefArmValueUnionListRetName(expRet) != "" {
        const raeTail = lambdaBodyTail(n.fnBody)
        if raeTail >= 0 && assignableExpr(raeTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The nested (2-D+) union-element array dual: a lambda body nested array literal
      // assignable to the expected 2-D+ box-element list adopts it, building the nested
      // lists through the same element-kind-2 box the annotated form already lowers
      // (`synthRetAnnots` pins `fnRet` off this producer's rung, `IR_RUNG_NESTED_ELEM_UNION_LIST`).
      if inferred != expRet && nestedElemUnionListRetName(expRet) != "" {
        const nueTail = lambdaBodyTail(n.fnBody)
        if nueTail >= 0 && assignableExpr(nueTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The union-field-struct-element-list dual: a lambda body array literal assignable to
      // the expected list of boxed-field structs adopts it, building each element's boxed
      // field slot exactly as the annotated form lowers (`synthRetAnnots` pins `fnRet` via
      // `nameIsStructWithUnionField`).
      if inferred != expRet && structFieldBoxElemListRetName(expRet) != "" {
        const sfeTail = lambdaBodyTail(n.fnBody)
        if sfeTail >= 0 && assignableExpr(sfeTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The nullable-closure-element-list dual: a lambda body array literal assignable to
      // the expected kind-5 niche list adopts it, seeding each element (a `null` to
      // `ref.null $cloStruct`) through the same rep the annotated form already lowers.
      if inferred != expRet && nulClosureElemListRetName(expRet) != "" {
        const nceTail = lambdaBodyTail(n.fnBody)
        if nceTail >= 0 && assignableExpr(nceTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The nested-list result: a lambda body array literal assignable to the expected
      // nested scalar-leaf array adopts it, building under the pinned return's threading
      // (`synthRetAnnots` pins `fnRet`); the `$fnsig` result keys the reflist slot on both
      // producers, unlike the 1-D scalar-list arm below (R4).
      if inferred != expRet && nestedLeafListRetName(expRet) != "" {
        const nlTail = lambdaBodyTail(n.fnBody)
        if nlTail >= 0 && assignableExpr(nlTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The scalar-leaf-list result: a lambda body array literal assignable to the expected
      // distinct-backing scalar-leaf list adopts it — elements re-encode at the leaf
      // (`assignableExpr`'s `ArrayLit` arm, the grant a direct `const xs: f32[] = [1.5]`
      // binding makes), and `synthRetAnnots` pins `fnRet` to the adopted name (`isScalarListRetName`).
      if inferred != expRet && scalarLeafListRetName(expRet) != "" {
        const slTail = lambdaBodyTail(n.fnBody)
        if slTail >= 0 && assignableExpr(slTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The litunion-element-list result: a lambda body array literal whose elements are
      // members of the expected litunion-element list adopts it — `assignableExpr`'s
      // `ArrayLit` arm records the destination array type, so the body builds the i32 atom
      // list; the `>a` result token already byte-matches the annotation side, so no pin is needed.
      if inferred != expRet && litUnionElemListRetName(expRet) != "" {
        const lulTail = lambdaBodyTail(n.fnBody)
        if lulTail >= 0 && assignableExpr(lulTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The struct-element-list result: a lambda body array literal's element structs
      // coerce field-wise into the expected shape and adopt it — `assignableExpr`'s
      // per-element `ObjLit` coercion records the coerced field types for the emitter's
      // interner. Gated on plainly-lowerable element fields, so a map/union/nullable field stays a loud reject.
      if inferred != expRet && structElemListRetName(expRet) != "" {
        const seTail = lambdaBodyTail(n.fnBody)
        if seTail >= 0 && assignableExpr(seTail, inferred, expRet) {
          inferred = expRet
          objRetAdopted = true
        }
      }
      // The loud floor, last rung of this ladder: an empty-`[]` result no arm above adopted
      // is the absence of a rep, not a narrower version of one — leaving `fnRet` a hole would
      // cast-trap the value call or disagree with the body's list at emit. Exempt only the
      // i32-backed elements (`i32`/`boolean`), which share the one i32-list backing with the annotation and so are already correct un-adopted.
      if inferred != expRet && unresolvedHole(inferred) {
        const ehT = T.tys[expRet]
        if ehT is TyArray {
          if (
            !tyIsPrimNamed(ehT.aElem, "i32")
            && !tyIsPrimNamed(ehT.aElem, "boolean")
          ) {
            tErrUnsupported(
              "a lambda returning an empty `[]` cannot build the "
                + tyToStr(expRet)
                + " result its annotation asks for — type-valid, but the element type has no"
                + " rep to build from; return the literal from a named function"
                + " (`function f(): "
                + tyToStr(expRet)
                + " { return [] }`), which lowers this",
              n.fnBody,
            )
          }
        }
      }
    }
    if inferred != preAdopt { cbSeedUsedSet(cbSeedUsed + 1) }
  }
  // A `const` literal returned is the `string` it is stored as, so a join with `null`, a number
  // or a record meets the return floors below exactly as that string does (D2157).
  inferred = widenLitTy(inferred)
  // Permissive fall-through (totality): an un-annotated function that can fall off the end
  // implicitly yields `null` there, so its inferred return widens to `T | null`. A box-able
  // value type lowers un-annotated via the `uBoxIdx` box; a niche (`boolean`/`string`) widens
  // too but stays floored below until A20 carries the niche seed. A void/error return is exempt.
  if (
    !bodyTotalForRet
    && inferred >= 0
    && !isVoidTy(inferred)
    && inferred != TY_ERR
  ) {
    const inT = T.tys[inferred]
    if !(inT is TyNullable) { inferred = mkNullableTy(inferred) }
  }
  // Robustness floor: an un-annotated function whose returns join to a union/nullable now
  // infers the correct type, but must still be annotated when the emitter cannot yet lower
  // it un-annotated — a value union/nullable already lowers via the `uBoxIdx` box and does
  // not floor; a deferred join (a per-call-site placeholder) is not a shape to floor either, since it collapses to one arm at each call site.
  if (
    !inferQuiet
    && n.fnName != ""
    && inferred >= 0
    && !tyIsDeferredJoin(inferred)
    && valueUnionRetName(inferred) == ""
  ) {
    const itt = T.tys[inferred]
    // A variant-box union (`{w: i32} | i32`, and its nullable form) lowers un-annotated: the
    // A20 loop records `variantBoxUnionRetName` and the emitter boxes it exactly like the
    // annotated spelling. Checked before the `TyUnion`/`TyNullable` arms below (it spans
    // both), so the floor accepts exactly the box the emitter registers.
    if litUnionAliasNameOfTy(inferred) != "" {
      // A pure literal union with a declared alias (`type K = "a" | "b"`) lowers
      // un-annotated as the interned i32 atom: the A20 loop records the alias name and the
      // emitter's return classification reads the same rep the annotated `: K` spelling
      // reaches. An inline litunion (no alias to record) still floors below.
    } else if variantBoxUnionRetName(inferred) != "" {
      // lowers un-annotated — no floor
    } else if mapUnionRetName(inferred) != "" {
      // A map-member union lowers un-annotated through the recorder's map-union rung (D2666).
    } else if tyIsLitUnion(inferred) {
      // A pure un-named literal union lowers un-annotated as a string ref, the same rep its
      // annotated twin carries — `collectF` records `retPrim = "string"` for this shape and
      // the return site widens an atom-repped value into it. The alias form above reps as
      // the atom instead, so the two never collide.
    } else if numLitUnionHasBase(inferred) {
      // A numeric literal union has no union rep at all: every member softens to one base
      // scalar, so the recorder banks the base (`numLitUnionBaseTy`, the same rule
      // `softenLitTy` states everywhere) and this arm accepts exactly what it banks. The
      // string litunion two arms up is the shape that keeps an identity (the interned atom), which is why it is a separate question.
    } else if itt is TyUnion {
      // No floor for a union the emitter lowers as its annotation: a struct union it can register
      // (`structUnionRetName`), a union of lists or with a function member it pins (D2768,
      // D4349), and a union over a type parameter, decided per instance where `T` is bound.
      if (
        structUnionRetName(inferred, gRootStmts) == ""
        && !tyHasTyVar(inferred)
        && !tyUnionAllLists(inferred)
        && !tyIsFnArmUnion(inferred)
      ) {
        tErrUnsupported(
          "'"
            + n.fnName
            + "' infers the union return type "
            + tyToStr(inferred)
            + " — type-valid, but an inferred return of this shape is not yet supported by codegen; annotate the return type",
          n.fnBody,
        )
      }
    } else if itt is TyNullable {
      // The niche nullables (`boolean | null` / `string | null` / `K | null`), a nullable
      // struct, a nullable list at every element type, and a never-filled infer-null hole
      // (`nInner < 0`, whose only value is `null`) all lower un-annotated — each named by its
      // own recorder for the emitter to seed from — so none of them floor (D1576).
      if (
        itt.nInner >= 0
        && !(T.tys[itt.nInner] is TyVar)
        && !tyIsParamUnion(itt.nInner)
        && !tyIsPrimNamed(itt.nInner, "boolean")
        && !tyIsPrimNamed(itt.nInner, "string")
        && litUnionAliasNameOfTy(itt.nInner) == ""
        && nullableRetName(inferred, gRootStmts) == ""
        && nulListRetName(inferred) == ""
      ) {
        // `T | null` over a type parameter is decided per instance, where `T` is bound.

        tErrUnsupported(
          "'"
            + n.fnName
            + "' infers the nullable return type "
            + tyToStr(inferred)
            + " — type-valid, but an inferred return of this shape is not yet supported by codegen; annotate the return type",
          n.fnBody,
        )
      }
    }
  }
  // A lambda's join of its enclosing body's type parameters is that body's kept-apart join, so
  // the lambda's instance and every caller re-join it at the pin alike (D3520, D3521). A call's
  // join it relays is the callee's, which a gated callee widens.
  if (
    n.fnName == ""
    && tyIsDeferredJoin(inferred)
    && !(dJoinRelayed.get(inferred) ?? false)
    && deferredJoinOverOpenParams(inferred)
  ) {
    inferred = openParamJoinOf(inferred)
  }
  ret = inferred
  // Patches the hoisted `TyFunc` in place so existing references see the result; a nested
  // (un-hoisted) named function declares fresh, and an anonymous lambda just carries its
  // type as the expression value. The parameter-solve probe observes this body and must not
  // decide the return, so patching here would deny pass 1.7 a fresh re-derivation.
  const cstrProbeTop = cstrProbe && (fnDeclIx[n.fnName] ?? -1) == fnIx
  if n.fnName != "" && !paramSolveProbe && !cstrProbeTop {
    // A nested function has no hoisted binding: only one already declared in the enclosing
    // scope is its own, and `lookup` further out would find an outer namesake (D1966).
    const isTopDecl = (fnDeclIx[n.fnName] ?? -1) == fnIx
    let bound = -1
    if isTopDecl || lookupDepth(n.fnName) == T.scopes.length - 1 {
      bound = lookup(n.fnName)
    }
    let patched = false
    if bound >= 0 {
      const bt = T.tys[bound]
      if bt is TyFunc {
        bt.fnRet = inferred
        tyMutEpoch = tyMutEpoch + 1 // inferred return patched in place
        patched = true
      }
    }
    if !patched { declare(n.fnName, mkFuncTy(paramTys, inferred)) }
    if !isTopDecl && !inferQuiet { noteNestedUnannotFn(fnIx, lookup(n.fnName)) }
    // Re-retains the symbol-table type with the inferred return: the entry stamped while
    // checking the signature carried the `-2` infer-later sentinel, and the in-place patch
    // above only touches the scope-bound copy. Without this, hover / inlay on an
    // unannotated function renders `-> _`.
    if symEnabled != 0 { symRetainType(fnIx, mkFuncTy(paramTys, inferred), 2) }
  } else if !inferQuiet {
    // An anonymous lambda is lifted to a top-level function under a synthesized
    // `__lambda_N` name the checker never saw, so the name-keyed inferred-return table
    // can't reach it. Records the inferred scalar/string/list return under a node-index
    // sentinel key (`#<nodeIx>`) instead, read back by `inferRetNameByNode`.
    const anm = tyToStructStr(inferred)
    // A struct-with-boxed-field contextual return the checker adopted at the lambda
    // boundary (`objRetWidenAdopt`'s boxing-widen arm), recorded under the canonical emit
    // name (not the spaced `tyToStr` render) so `synthRetAnnots`'s pin and
    // `internShapeDeep`'s intern resolve. Takes precedence over `recordable`.
    const sfbNm = structFieldBoxRetName(inferred)
    // A map-carrying struct return, recorded under the canonical emit name too — the spaced
    // `recordable` render never pins, and an un-pinned body literal's nested map field would
    // otherwise resolve by field-name set and mint a wrong-layout twin. Checked after `sfbNm` (a boxed-field struct keeps its established pin).
    let smfNm = ""
    if sfbNm == "" { smfNm = structMapFieldRetName(inferred) }
    // A plain struct return, recorded canonically too: the spaced `recordable` render never
    // pins, and an un-pinned lambda's body literal fieldset-matches — a same-fieldset twin
    // row in scope can resolve the wrong row otherwise. Composite fields (map/union/closure/list) keep their own recorder arms below.
    let spfNm = ""
    if sfbNm == "" && smfNm == "" && objRetAdopted {
      spfNm = structPlainRetName(inferred)
    }
    // A single struct-shape inferred return is recorded too — a lambda that collapses to
    // one union variant types as that variant's shape, so the emitter resolves it to the
    // concrete variant rather than the box. The gates run only when all three canonical
    // recorders declined, each at most once, in source order — `recordable` is bit-identical to the disjunction it replaces.
    let recCode = IR_RUNG_NONE
    if sfbNm == "" && smfNm == "" && spfNm == "" {
      if isClassifiableRetName(anm) { recCode = IR_REC_CLASSIFIABLE }
      else if isObjShapeName(anm) { recCode = IR_REC_OBJ_SHAPE }
      else if isScalarListRetName(anm) { recCode = IR_REC_SCALAR_LIST }
    }
    const recordable = recCode != IR_RUNG_NONE
    // A union inferred/contextual return exports its emitter-format name (value-union or
    // struct-union) under the same node sentinel, mirroring the named-function A20 loop —
    // the contextual return the checker proved for the lambda at its own boundary, pinned
    // position-independently (`synthRetAnnots`) rather than re-derived per boundary.
    let unm = ""
    // Not the only writer since the r8 split: `nulElemListRetName` sets the rung itself, and
    // the contextual-adoption gate above calls that producer too, so a write can land before
    // this reset — safe since the reset is unconditional and precedes the cascade. The
    // global's lifetime is exactly one cascade run: cleared here, written once, read once.
    irRungClear()
    if !recordable {
      unm = irRung(IR_RUNG_SFB, sfbNm)
      if unm == "" { unm = irRung(IR_RUNG_STRUCT_MAP_FIELD, smfNm) }
      if unm == "" { unm = irRung(IR_RUNG_STRUCT_PLAIN, spfNm) }
      if unm == "" {
        unm = irRung(IR_RUNG_VALUE_UNION, valueUnionRetName(inferred))
      }
      // The litunion-array value-union dual (adopted above): records its alias-preserving
      // emit name so `collectU` registers the union and `synthRetAnnots`'s `isValueUnionName`
      // arm pins `fnRet` to it, keying the `$fnsig` result `>u` to match the value call.
      if unm == "" {
        unm = irRung(
          IR_RUNG_LITUNION_ARR_VU,
          litUnionArrayValueUnionRetName(inferred),
        )
      }
      if unm == "" {
        unm = irRung(
          IR_RUNG_STRUCT_UNION,
          structUnionRetName(inferred, gRootStmts),
        )
      }
      // A NULLABLE-ref contextual return (`P | null`, `string | null`) — recorded under the same
      // node sentinel so `synthRetAnnots` pins a nullable-returning closure value position-
      // independently (the nullable dual of the union pin).
      if unm == "" {
        unm = irRung(IR_RUNG_NULLABLE, nullableRetName(inferred, gRootStmts))
      }
      // The nullable-litunion contextual return (adopted above): records the alias name so
      // `synthRetAnnots` pins the lambda's `fnRet` as the nullable litunion (an i32 atom with
      // `-1` = null), whose member-encoding `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(IR_RUNG_NUL_LITUNION, nulLitUnionRetName(inferred))
      }
      // The element-nullable-list contextual return (adopted above): records its emitter
      // name so `synthRetAnnots` pins the lambda's `fnRet` as the value-union-box list, whose
      // `[null]` element seeding `emitReturnValue` already performs for the annotated form.
      if unm == "" { unm = nulElemListRetName(inferred) }
      // The element-nullable-struct-list contextual return (adopted above): records its
      // canonical emit name so `synthRetAnnots` pins `fnRet` as the nullable-struct-element
      // list, whose kind-1 struct-niche element seeding `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(
          IR_RUNG_NUL_STRUCT_ELEM_LIST,
          nulStructElemListRetName(inferred),
        )
      }
      // The element-nullable-map-list contextual return (adopted above): records its
      // canonical emit name so `synthRetAnnots` pins `fnRet` as the nullable-map-element
      // list, whose kind-3 map-niche element seeding `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(IR_RUNG_NUL_MAP_ELEM_LIST, nulMapElemListRetName(inferred))
      }
      // The element-nullable-scalar-list contextual return (adopted above): records its
      // canonical emit name so `synthRetAnnots` pins `fnRet` as the nullable-list-element
      // list, whose inner-wrapper element seeding `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(
          IR_RUNG_NUL_LIST_ELEM_LIST,
          nulListElemListRetName(inferred),
        )
      }
      // The element-value-union-list contextual return (adopted above): records its emitter
      // name so `synthRetAnnots` pins `fnRet` as the value-union-box list, whose element
      // boxing `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(IR_RUNG_ELEM_VU_LIST, elemValueUnionListRetName(inferred))
      }
      // The element-variant-box-union-list contextual return (adopted above): records its
      // emitter name so `synthRetAnnots` pins `fnRet` as the variant-box-element list, whose
      // element boxing `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(
          IR_RUNG_ELEM_VARIANT_BOX_LIST,
          elemVariantBoxListRetName(inferred),
        )
      }
      // The element-map-union-list contextual return (adopted above): records its emitter
      // name so `synthRetAnnots` pins `fnRet` as the map-union-box element list, whose
      // element boxing `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(
          IR_RUNG_ELEM_MAP_UNION_LIST,
          elemMapUnionListRetName(inferred),
        )
      }
      // The element-refarm-value-union-list contextual return (adopted above): records its
      // emitter name so `synthRetAnnots` pins `fnRet` as the box-list, whose element boxing
      // `emitReturnValue` already performs for the annotated form.
      if unm == "" {
        unm = irRung(
          IR_RUNG_ELEM_REFARM_VU_LIST,
          elemRefArmValueUnionListRetName(inferred),
        )
      }
      // The nested (2-D+) union-element array contextual return (adopted above): records its
      // emitter name so `synthRetAnnots` pins `fnRet` as the nested box-element array, whose
      // return-position threading + `$fnsig` reflist-slot keying already performs.
      if unm == "" {
        unm = irRung(
          IR_RUNG_NESTED_ELEM_UNION_LIST,
          nestedElemUnionListRetName(inferred),
        )
      }
      // The union-field-struct-element-list contextual return (adopted above): records its
      // emitter name so `synthRetAnnots` pins `fnRet` as the boxed-field-element list, whose
      // element boxing the annotated spelling already performs.
      if unm == "" {
        unm = irRung(
          IR_RUNG_STRUCT_FIELD_BOX_ELEM_LIST,
          structFieldBoxElemListRetName(inferred),
        )
      }
      // The plain-struct-element-list return: records its canonical name so
      // `synthRetAnnots` pins the lambda and the element literals build under the annotated
      // threading instead of fieldset-matching a wrong same-fieldset twin. Adoption-gated
      // like the plain-struct record above, since un-gating regressed the closure-value ref-list ABI suite.
      if unm == "" && objRetAdopted {
        unm = irRung(IR_RUNG_STRUCT_ELEM_LIST, structElemListRetName(inferred))
      }

      // The nullable-closure-element-list contextual return (adopted above): records its
      // emitter name so `synthRetAnnots` pins `fnRet` (`parenUnionArrElemName`), whose kind-5
      // ref-list slot and `[null]` seeding `emitReturnValue` already threads.
      if unm == "" {
        unm = irRung(
          IR_RUNG_NUL_CLOSURE_ELEM_LIST,
          nulClosureElemListRetName(inferred),
        )
      }
      // The closure-arm value-union contextual return (adopted above): records its emitter
      // name so `collectU` registers the union and `synthRetAnnots` pins `fnRet` to it; the
      // `$fnsig` result then keys `>u`, matching the value call.
      if unm == "" {
        unm = irRung(IR_RUNG_CLO_ARM_VU, cloArmValueUnionRetName(inferred))
      }
      // The map-member-union contextual return (adopted above): records its emitter name so
      // `synthRetAnnots` pins `fnRet` as the map-union box (#865/#868), whose arm boxing
      // `emitReturnValue` already performs for the annotated form.
      if unm == "" {
        unm = irRung(IR_RUNG_MAP_UNION, mapUnionRetName(inferred))
      }
      // The ref-arm value-union contextual return (adopted above; repOf item (d)): records
      // its nominal render so `collectU` registers the union and `synthRetAnnots`'s `isUName`
      // arm pins `fnRet` to the same spelling the emitter's binding resolution uses.
      if unm == "" {
        unm = irRung(
          IR_RUNG_REFARM_UNION,
          refArmUnionRetName(inferred, gRootStmts),
        )
      }
      // The variant-box union contextual return with an inline-struct arm (adopted above):
      // records its emitter name so `collectU` registers the union and `synthRetAnnots`'s
      // `isUName` arm pins `fnRet` to it; the `$fnsig` result keys `>u`.
      if unm == "" {
        unm = irRung(IR_RUNG_VARIANT_BOX, variantBoxUnionRetName(inferred))
      }
      // The nested-list contextual return (adopted above): records its emitter name so
      // `synthRetAnnots` pins `fnRet` as the nested array, whose return-position threading
      // and `$fnsig` reflist-slot keying already performs (R4).
      if unm == "" {
        unm = irRung(IR_RUNG_NESTED_LEAF_LIST, nestedLeafListRetName(inferred))
      }
      // The map-element-list contextual return: records its emitter name so
      // `synthRetAnnots` pins `fnRet` as the map-element array, whose kind-3 slot keying the
      // annotated named-function form already performs.
      if unm == "" {
        unm = irRung(IR_RUNG_MAP_ELEM_LIST, mapElemListRetName(inferred))
      }
      // The litunion-alias-element-list contextual return (adopted above): records the
      // name so `synthRetAnnots` pins `fnRet` and the body member literals build the i32
      // atom list the annotated return does.
      if unm == "" {
        unm = irRung(
          IR_RUNG_LITUNION_ELEM_LIST,
          litUnionElemListRetName(inferred),
        )
      }
      // The literal-union contextual return (adopted above): records the alias name so
      // `synthRetAnnots` pins `fnRet` as the litunion, whose functype result reps as an i32
      // atom — the `$fnsig` result keys `>i` and `emitReturnValue` encodes the member literal
      // as its atom id (`retLitUnion`, #1115).
      if unm == "" {
        unm = irRung(
          IR_RUNG_LITUNION_ALIAS,
          irAtoms(litUnionAliasNameOfTy(inferred), 1),
        )
      }
      // A nullable list at an element type the nullable rung does not name (`string[] |
      // null`): `synthRetAnnots` pins it as `synthNulListRetAnns` pins a named function (D2399).
      if unm == "" {
        unm = irRung(IR_RUNG_NUL_LIST_RET, nulListRetName(inferred))
      }
    }
    // The width of the name this ladder settled on, handed over by the producer that
    // joined it rather than re-derived by splitting it (#1115). The rungs short-circuit, so
    // the last producer to answer non-empty is the one that wrote `inferRetNameAtoms`. The
    // `recordable` name is not a producer's join: its three gates admit only one-atom spellings.
    let rAtoms = 1
    if !recordable { rAtoms = inferRetNameAtoms }
    // The rung, on the identical footing as the width above: read from the cascade only on
    // the path that ran it. A `recordable` row cannot carry a producer rung — it never runs
    // the cascade — but it carries the gate code that admitted it instead, which the arm-9
    // conversion reads; gate codes never write to `inferRetNameRung`, so they cannot leak.
    let rRung = recCode
    if !recordable { rRung = inferRetNameRung }
    // A deferred join is a per-call-site placeholder, not a shape the emitter can
    // classify a return by — see the named-function twin in `elaborateInferRets`.
    if recordable || unm != "" {
      if !tyIsDeferredJoin(inferred) {
        const nodeKey = "#" + i32ToStr(fnIx)
        if inferRetNameOf(nodeKey) == "" {
          let rty = unm
          if recordable { rty = anm }
          recordInferRet(nodeKey, rty, inferred, rAtoms, rRung)
        }
      }
    }
  }
  inferObservedSet(savedObserved)
  inferSawErrSet(savedSawErr)
  fnSawValueRetSet(savedValueRet)
  ret
}

// A function declaration: resolves param/return annotations, binds the signature, and checks
// the body in a fresh scope. An un-annotated return is inferred from the body's returns and
// trailing expression (`noteInferredRet`, under a `-2` pending `curRet`), then patched into
// the hoisted `TyFunc` in place so every caller sees it. A base-case-less cycle has nothing to latch onto and reports "cannot infer a return type".
function checkFuncDeclNode(n: FuncDecl, fnIx: i32) {
  // No `break` crosses a function boundary, so the body's loops start a fresh base.
  const lpSaved = lpBase
  lpBaseSet(lpLabels.length)
  let r = 0
  if n.fnName != "" {
    const wsDiags = T.diags.length
    r = checkFuncDeclNodeReal(n, fnIx)
    if T.diags.length > wsDiags { wsBodyErr[fnIx] = true }
  } else {
    lamCheckDepth = lamCheckDepth + 1
    r = checkFuncDeclNodeReal(n, fnIx)
    lamCheckDepth = lamCheckDepth - 1
  }
  lpBaseSet(lpSaved)
  r
}

// `checkFuncDeclNode`'s body, counted by it inside a lambda.
// A function declared directly in a body that has a parameter of its name binds that name twice
// in one scope, as a `const` of it would: the owner's ruling (D3945). A function in a deeper block,
// an inner function or a lambda body may still shadow the parameter.
function checkParamNestedFnClash(n: FuncDecl, params: i32[]) {
  if inferQuiet || monoRecheckDepth > 0 || n.fnBody < 0 { return 0 }
  const body = P.nodes[n.fnBody]
  if !(body is Block) { return 0 }
  for st in body.blkStmts {
    const sn = P.nodes[st]
    if sn is FuncDecl {
      for pi in params {
        const pn = P.nodes[pi]
        if pn is Param {
          if sn.fnName != "" && pn.parName == sn.fnName {
            tErr(
              "redeclared "
                + sn.fnName
                + ": the parameter `"
                + pn.parName
                + "` and the function `"
                + sn.fnName
                + "` declared in the same body are one scope; rename one, or declare the "
                + "function in an inner block",
              st,
            )
          }
        }
      }
    }
  }
  0
}

function checkFuncDeclNodeReal(n: FuncDecl, fnIx: i32) {
  // A `function` (top-level OR nested) whose name the emitter dispatches on inline is a
  // definition that can never run — reject it at the definition, not at the call site
  // that silently means something else. Anchored on the decl node, so the pass-1 hoist
  // and this pass report the SAME (message, anchor) pair and `tErrCoded` dedups them.
  checkNotEmitterIntrinsic(n.fnName, fnIx)
  checkNotNestedBinOpDecl(n.fnName, fnIx)
  // Binds the name to this declaration node in the enclosing scope (the body's own scope is
  // pushed further down), so a call inside that scope can recover the parameter list and its
  // defaults. A top-level function is already recorded by the pass-1 hoist under the same
  // name; a nested one has no hoist and is recorded here, which is also the point it becomes callable.
  if n.fnName != "" { declareFnDeclNode(n.fnName, fnIx) }
  let inferring = n.fnRet < 0
  // Void-context lambda adoption: an un-annotated lambda literal whose contextual expected
  // return is `void` is checked as if annotated `: void` rather than inferred, so an explicit
  // `return expr` fails the same anchored mismatch a named `: void` spelling produces, and a
  // value-bearing tail is silently discarded by the emitter. Keyed on the context's expected return, never on the tail's own shape.
  if inferring && n.fnName == "" {
    if isVoidTy(cbExpectedRetFor(fnIx)) {
      inferring = false
      noteVoidCtxLambda(fnIx)
    }
  }
  // The same flip for the same reason: a bare `return` writes `: void`, so stop inferring and
  // take the `!inferring` ladder's `TY_VOID` default, which already discards a valued tail.
  let bareRetVoid = false
  if inferring {
    if blockHasBareReturn(n.fnBody) {
      inferring = false
      bareRetVoid = true
    }
  }
  // ...and for a result no caller reads, which the hoist already bound as `: void` (D2631).
  const ucVoided = inferring && fnResultUnconsumed(fnIx)
  if ucVoided { inferring = false }
  // The return an unread function shows in the editor: its tail's value, never lowered.
  let ucShowRet = TY_VOID
  // The infer-stack key: a named function uses its name (so self-recursion is detected); an
  // anonymous lambda has no name and keys by node index instead — else two nested anonymous
  // lambdas would both key on "" and the inner would falsely trip the recursive-cycle guard, mis-inferring its return as `void`.
  let inferKey = n.fnName
  if inferKey == "" { inferKey = "#L" + i32ToStr(fnIx) }
  // Already inferred on demand (a forward call checked this body before pass 2
  // reached it)? Skip the re-check so diagnostics aren't duplicated.
  if inferring {
    // Recursive cycle: this function is already on the inference stack. Break with a
    // provisional `void` (the binding-group fixpoint re-infers it once the cycle's
    // resolvable members settle), and COUNT the break so the completion below knows
    // the result is tentative rather than final.
    if onInferStack(inferKey) {
      cycleBreakCountSet(cycleBreakCount + 1)
      return TY_VOID
    }
    if inferQuiet && !paramSolveProbe && !cstrProbe {
      // Suppressed pre-pass: memoize a resolved return (a `-2` reset by the fixpoint
      // forces a fresh re-inference). The PARAMETER-solve probe never takes the memo:
      // it needs the body walked for the flow constraints, not the return.
      const hoisted = lookup(n.fnName)
      if hoisted >= 0 {
        if (fnDeclIx[n.fnName] ?? -1) >= 0 {
          const ht = T.tys[hoisted]
          if ht is TyFunc {
            if ht.fnRet != -2 { return TY_VOID }
          }
        }
      }
    } else {
      // Real check pass: returns are already resolved by the pre-pass, so skip only a
      // top-level body already diagnostic-checked (a forward call reached it before pass 2
      // did). Gated on `fnIx` matching the registered top-level decl, so a nested function
      // sharing a name (e.g. two `add` closures) is never skipped.
      if (fnDeclIx[n.fnName] ?? -1) == fnIx {
        if bodyChecked[n.fnName] ?? false { return TY_VOID }
      }
    }
  }
  // Solves this declaration's un-annotated parameters from its body usage. A no-op for a
  // top-level function (already done in pass 1.6) and inside a probe; this reach is the
  // nested `function` and the value-bound lambda, whose first observer is this call. A
  // parameter the receiver already pinned contextually is not a hole here, so `cbExpect` below still wins — one answer, not two.
  solveUnannotParams(fnIx)
  const params = n.fnParams
  // The contextual expected param types recorded for THIS lambda node (`seedExpected` at a
  // call arg, a `.map`/`.filter` receiver, or an annotated let/return/field/element). Keyed by
  // node index, so a composite's many lambdas each read their own — no single-shot leak.
  const cbExpect = cbExpectedFor(fnIx)
  const cbExpectUsable = cbExpect.length == params.length
  const paramTys: i32[] = []
  // Parallel to `paramTys`: did THIS parameter's annotation collapse a subsumed literal
  // arm (D1048's second hint)? Recorded here, where the annotation resolves, and read in
  // the declare loop below, which is where the binding — and so the scope depth the mark
  // is keyed by — comes into existence.
  const paramCollapsed: boolean[] = []
  let paramUninferable = false
  let pi = 0
  while pi < params.length {
    const pNode = P.nodes[params[pi]]
    let pt = TY_ERR
    let ptCollapsed = false
    if pNode is Param {
      if pNode.parType >= 0 {
        const ptn = P.nodes[pNode.parType]
        if ptn is TypeRef {
          pt = resolveAnnotAt(ptn.tyName, n.fnTyParams, pNode.parType, n.fnName)
          if pt >= 0 && pt == collapsedTy { ptCollapsed = true }
          if pt < 0 {
            unknownTyErr(ptn.tyName, "", pNode.parType)
            pt = TY_ERR
          }
          // Records the resolved type on the param's type-annotation node too (not just the
          // param node), so the emitter can classify a param annotation structurally from the
          // `Ty` arena instead of re-parsing its synthetic name (`tyNameOf`) — C1.
          if !inferQuiet && pt >= 0 {
            if pNode.parType < nodeTyIx.length { nodeTySet(pNode.parType, pt) }
          }
        }
      } else if cbExpectUsable && cbExpect[pi] >= 0 {
        // Contextual inference: the expected callback type pins this un-annotated param
        // (`xs.map(function(n) …)` over `i32[]` ⇒ `n: i32`). The seed is the only source of
        // this param's type, so an annotation that supplied it is load-bearing — count it
        // (D1442), or `recordRedundantAnnot` calls it redundant and `--fix` deletes it.
        pt = cbExpect[pi]
        cbSeedUsedSet(cbSeedUsed + 1)
      } else if n.fnName != "" {
        // A named function's un-annotated parameter is a fresh inference hole — a synthetic
        // `TyVar` per param, named by declaration and position so the hoisted signature and
        // the body bind the same hole. Each call site pins it independently, and the emitter
        // monomorphizes one instance per shape; the body sees it as opaque unless its own usage pinned it (`unannotParamTy`).
        pt = unannotParamTy(paramHoleName(n.fnName, fnIx, pi))
      } else if isValBindLambda(fnIx) {
        // A lambda bound to an UN-annotated `const`/`let` (`const add = (a, b) => a + b`): its
        // un-annotated param is a fresh inference HOLE, exactly like a named function's — the
        // emitter value-flow-monomorphizes one instance per call shape (env and all). Keyed by NODE
        // index (the lambda is anonymous), the dual of the named branch above.
        pt = unannotParamTy(paramHoleName("", fnIx, pi))
      } else {
        // An ANONYMOUS literal with no annotation and no contextual type is genuinely uninferable —
        // its value-typed binding demands a concrete signature NOW (host parity).
        tErr(
          "cannot infer a type for parameter `" + pNode.parName + "`",
          params[pi],
        )
        // The body can't be typed once a param is unknown — don't also cascade a "cannot infer a
        // return type" from the resulting error-only return.
        paramUninferable = true
      }
    }
    // A `void` result cannot be bound (spec T1.4), so no argument can reach a `void` parameter.
    if !inferQuiet && isVoidTy(pt) {
      tErr(
        "a parameter cannot be `void`: a `void` result cannot be bound, so no call could pass one — give the parameter a value type",
        params[pi],
      )
      pt = TY_ERR
    }
    // Records the param node's resolved type so the emitter can recover a
    // contextually-inferred callback param's type (`xs.map((x) => …)` over `f64[]` ⇒ x: f64)
    // and synthesize its annotation, instead of defaulting an un-annotated param to i32.
    // Gated on the real pass; a generic hole stays a `TyVar` and is excluded by the emitter's reader (`nodeTyName`).
    if !inferQuiet && pt >= 0 {
      if params[pi] < nodeTyIx.length { nodeTySet(params[pi], pt) }
    }
    paramTys.push(pt)
    paramCollapsed.push(ptCollapsed)
    pi = pi + 1
  }
  // Parameter DEFAULTS (`a: i32 = 0`, and the `a?: T` spelling the parser
  // desugars into one), checked once the annotations have resolved.
  checkParamDefaults(n, params, paramTys)
  if n.fnName != "" && params.length > 0 {
    const sp0 = P.nodes[params[0]]
    if sp0 is Param {
      if sp0.parName == "self" && sp0.parType >= 0 {
        checkSelfFnReachable(demangleName(n.fnName), paramTys[0], fnIx)
      }
    }
  }
  // Resolve the return-type annotation (or the pending sentinel when inferring).
  let ret = -2
  if !inferring {
    ret = TY_VOID
    // A VOID-adopted lambda has NO annotation node (`n.fnRet` is -1) — the guard
    // leaves `ret` at the `TY_VOID` default, which IS its adopted return.
    if n.fnRet >= 0 {
      const rtn = P.nodes[n.fnRet]
      if rtn is TypeRef {
        ret = resolveRetAnnotAt(rtn.tyName, n.fnTyParams, n.fnRet, n.fnName)
        // D1048's second hint: a declared return whose spelling collapsed marks the
        // DECLARATION, so an un-annotated `const r = f(…)` can inherit the provenance.
        // The pass-1 hoist below records the same fact for a top-level function; this
        // arm is what covers a NESTED one, which the hoist never walks.
        if ret >= 0 && ret == collapsedTy { markCollapsedRet(fnIx) }
        if ret < 0 {
          unknownTyErr(rtn.tyName, "", n.fnRet)
          ret = TY_ERR
        }
        // Records the resolved return type on the return-annotation node so the emitter can
        // classify it structurally from the `Ty` arena rather than re-parsing `tyNameOf` — C1.
        if !inferQuiet && ret >= 0 {
          if n.fnRet < nodeTyIx.length { nodeTySet(n.fnRet, ret) }
        }
      }
    }
    // `f` is hoisted in the outer scope (checkProgram pre-pass), but re-declaring
    // it here covers nested function decls and is an idempotent rebind otherwise.
    // (An anonymous function EXPRESSION has no name to bind.)
    if n.fnName != "" { declare(n.fnName, mkFuncTy(paramTys, ret)) }
  } else if n.fnName != "" && (fnDeclIx[n.fnName] ?? -1) != fnIx {
    // A nested named function binds its pending signature before its body, as the top-level
    // hoist does, so a self-call resolves and `finishInferredReturn` patches this binding.
    declare(n.fnName, mkFuncTy(paramTys, -2))
  }
  // A generic nested in another function owns its parameter rows (D3853).
  const nestedDecl = n.fnName != ""
    && n.fnTyParams.length > 0
    && (fnDeclIx[n.fnName] ?? -1) != fnIx
  if nestedDecl {
    nestParentOfPut(fnIx, curFnDeclIx)
    for pt in paramTys { markNestRows(pt, n.fnTyParams, fnIx, 0) }
    markNestRows(ret, n.fnTyParams, fnIx, 0)
  }
  // Save the inference accumulators (a demand-inference can nest inside another
  // function's body check) and the enclosing return type.
  const savedObserved = inferObserved
  const savedObservedLit = inferObservedLit
  const savedSawErr = inferSawErr
  const savedRetLogLen = inferRetLogTy.length
  const savedVoidRetLen = inferVoidRetSites.length
  const savedDroppedLen = inferDroppedTy.length
  const cbBefore = cycleBreakCount
  const bbBefore = bareBraceCount
  const savedValueRet = fnSawValueRet
  const savedRetNatural = retNatural
  const savedRetNaturalErr = retNaturalErr
  const pinnedReads0 = lbiPinnedReads
  retNaturalSet(-1)
  retNaturalErrSet(false)
  if inferring {
    inferStack.push(inferKey)
    inferObservedSet(-1)
    inferObservedLitSet(true)
    inferSawErrSet(false)
    fnSawValueRetSet(false)
  }
  // A function body checked here can capture whatever narrowings are live around it, and
  // it runs later — so a narrowing installed before this point and retired after it would
  // be retired behind the capture's back. `narFnEpoch` is how the write side tells the two
  // apart (`writeStorageTy`).
  narFnEpoch = narFnEpoch + 1
  // The body keeps its own ledger; the enclosing function's rows, and the marks an enclosing
  // `if` holds into them, come back when it closes.
  const savedClobKeys = narClobKeys
  const savedClobTys = narClobTys
  const savedClobPrev = narClobPrev
  const savedClobDepths = narClobDepths
  const savedClobRetired = narClobRetired
  const savedClobBind = narClobBind
  const savedClobDecl = narClobDecl
  narClobKeysSet([])
  narClobTysSet([])
  narClobPrevSet([])
  narClobDepthsSet([])
  narClobRetiredSet([])
  narClobBindSet([])
  narClobDeclSet([])
  crFnEnter(fnIx)
  // Check the body in a fresh scope sharing the parameters.
  pushScope(n.fnBody)
  // A parameter shadows an enclosing binding's path narrowings for the body.
  if npKeys.length > 0 {
    let spi = 0
    while spi < params.length {
      const spn = P.nodes[params[spi]]
      if spn is Param { narShadowPaths(spn.parName, fnIx) }
      spi = spi + 1
    }
  }
  crCaptureWiden(fnIx)
  // Paired with the `flushInferRetHoles` below, which must run while this scope is still
  // live — `popScope` is what raises the uninferable-binding floor (D1591).
  pushInferRetHoles()
  // Owns the deferred constraints this body records, so a call site can tell whose type
  // parameters they speak about (`cstrOwnedBy`). Only a registered top-level declaration is
  // pushed: a nested function or lambda has no `fnDeclIx` entry for a call site to match
  // against, so its constraints stay owned by the enclosing named function.
  let cstrOwnerPushed = false
  const fsbCallsAt = fsbCallIx.length
  if n.fnName != "" {
    if (fnDeclIx[n.fnName] ?? -1) == fnIx {
      cstrOwnerStack.push(fnIx)
      cstrOwnerPushed = true
    }
  }
  // Keeps the function's type parameters in scope for the whole body, so a body annotation
  // that names one — a local `const out: T[]`, `const x: T` — resolves to an opaque `TyVar`
  // instead of failing "unknown type 'T'"; `resolveAnnot` alone only scopes typarams around
  // a single param/return annotation. The emitter substitutes the concrete type per instance (`monoCloneBody`).
  let tpBody = 0
  while tpBody < n.fnTyParams.length {
    tpEnvNames.push(n.fnTyParams[tpBody])
    tpEnvTys.push(mkTyVar(n.fnTyParams[tpBody]))
    if nestedDecl { tvNestOf.set(tpEnvTys[tpEnvTys.length - 1], fnIx) }
    // The parameter's bound, for the same span (OQ-5, strict bodies). A row is pushed even
    // when the parameter is unbounded (-1), so the two stacks stay one-to-one with
    // `fnTyParams` and an unbounded `<T>` shadows an enclosing bounded `T` rather than
    // inheriting its bound — `tpEnv`'s own innermost-wins rule.
    tpBoundNamesPush(n.fnTyParams[tpBody])
    tpBoundAnnsPush(fnTpBoundOf(fnIx, tpBody))
    tpBody = tpBody + 1
  }
  // Definite-assignment: a function body is its own flow context — it runs at call time,
  // not at the declaration site, so a nested function capturing an outer still-unassigned
  // `let x` must not be flagged (the call may happen after `x` is written). The body checks in
  // its own frame, against an empty live set; `daLeaveFrame` restores the enclosing path.
  const daSavedUnassigned = daEnterFrame()
  const savedRet = T.curRet
  T.curRet = ret
  const savedInRetArg = inRetArg
  inRetArgSet(false)
  // D1045: the name the nominal-escape refusal puts in its sentence. An anonymous
  // lambda keeps the ENCLOSING function's name, which is the scope the declaration
  // is actually inside.
  const savedEscName = curFnEscName
  if n.fnName != "" { curFnEscNameSet(n.fnName) }
  const savedFnDeclIx = curFnDeclIx
  curFnDeclIx = fnIx
  const savedNjFn = njFnIx
  njFnIxSet(fnIx)
  // Why this body's return type is void, for the return that disagrees with it: nobody wrote
  // `: void`, so the mismatch has to name the bare `return` that decided it.
  const savedBareRetVoid = curFnBareRetVoid
  curFnBareRetVoidSet(bareRetVoid)
  // The function name binds in the OUTER scope (decl-scope chain), but its body — params +
  // statements — is checked under this pushed scope. Bound in every compile, not only the
  // LSP's: the binding-identity column resolves through the same chain.
  // The audit's must-fire control switches both sites off, in a compile only.
  const declSites = identAuditDrop != IDENT_DROP_FN_DECL || symEnabled != 0
  if n.fnName != "" && fnIx >= 0 && declSites {
    symDeclInOuter(n.fnName, fnIx, mkFuncTy(paramTys, ret), 2)
  }
  let dj = 0
  while dj < params.length {
    const pNode2 = P.nodes[params[dj]]
    if pNode2 is Param {
      declare(pNode2.parName, paramTys[dj])
      // D1048's second hint: the parameter's annotation collapsed, so the binding the
      // body sees carries the loss. Marked HERE and not at the resolution because the
      // mark is keyed by the scope frame, and that frame is this one.
      if paramCollapsed[dj] { markCollapsedBinding(pNode2.parName) }
      if declSites { symDecl(pNode2.parName, params[dj], paramTys[dj], 1) }
    }
    dj = dj + 1
  }
  if params.length == 1 {
    const pn1 = P.nodes[params[0]]
    if pn1 is Param { narrowFreshBinding(pn1.parName, fnIx) }
  }
  checkParamNestedFnClash(n, params)
  const body = P.nodes[n.fnBody]
  const savedStmtBlk = chkStmtBlk
  chkStmtBlkSet(n.fnBody)
  if body is Block {
    const stmts = body.blkStmts
    let s = 0
    while s < stmts.length {
      // The LAST statement's value is this function's implicit return. Under inference,
      // mark it as the return-tail position so a tail `if`/`else`'s base-case branch
      // seeds `inferObserved` before a recursive sibling branch is checked.
      const savedRTPbody = retTailPos
      if s == stmts.length - 1 && inferring {
        retTailPosSet(true)
      } else {
        retTailPosSet(false)
      }
      // The implicit return is seeded with the declared type, exactly as the explicit one is
      // (`checkRetStmtNode`) — otherwise a narrower literal types at its default instead. An
      // unreachable tail (`return 1  print(9)`, two statements on one line) is not the implicit
      // return, so neither seeding nor checking may treat it as the returned expression.
      let tailIsReturn = s == stmts.length - 1
      if tailIsReturn && s > 0 {
        if stmtAlwaysExits(stmts[s - 1]) { tailIsReturn = false }
      }
      if tailIsReturn && !inferring && ret >= 0 {
        if !isStmtNode(stmts[s]) || P.nodes[stmts[s]] is IfStmt {
          seedTailArms(stmts[s], ret)
        }
      }
      // A statement before the tail, or the tail of a void body, is discarded.
      if s < stmts.length - 1 || (!inferring && isVoidTy(ret)) {
        markValDiscard(stmts[s])
      } else if tailIsReturn && tpEnvNames.length > 0 {
        tpIfMarkOk(stmts[s])
      }
      crStmtEnter(stmts[s])
      const savedSpine = spineAt
      spineAtSet(-1)
      if s == stmts.length - 1 { spineAtSet(stmts[s]) }
      const stTy = checkNode(stmts[s])
      spineAtSet(savedSpine)
      crStmtLeave()
      retTailPosSet(savedRTPbody)
      if ucVoided && tailIsReturn {
        ucShowRet = discardedTailTy(stmts[s], stTy)
      }
      // The trailing expression is the implicit return; under inference it is a
      // return-type witness. With a CONCRETE annotated return, a trailing empty
      // collection (`mk(): i32[] { … inner }`) pins its element from the return
      // type here — before the body scope is popped (and `inner`'s floor checked).
      if s == stmts.length - 1 {
        // Checked against the return type through `assignableExpr`, not bare `assignable`, so
        // the same coercions a declared-type binding grants (a literal widening) apply here too,
        // matching an explicit `return <expr>` — the bare trailing expression, which is the
        // implicit return, needs the identical check.
        if !inferring && tailIsReturn {
          if ret >= 0 && !isVoidTy(ret) && ret != TY_ERR {
            clearTailVerdict(stmts[s])
          }
          if ret >= 0 {
            // A tail `if` is a statement node, so its arms' `{}` reach no `assignableExpr`.
            if isStmtNode(stmts[s]) {
              bareBraceDeliver(stmts[s], ret, 8, false)
            }
            if !isStmtNode(stmts[s]) {
              // A `never` body is graded whole below, not by its tail's value.
              if !isVoidTy(ret) && ret != TY_NEVER {
                if !assignableExpr(stmts[s], stTy, ret) {
                  tErrWant(
                    "expected "
                      + tyToStr(ret)
                      + ", got "
                      + tyToStr(stTy)
                      + boolForNumberNote(stTy, ret)
                      + numUnionLossNote(stTy, ret)
                      + storageListNote(stmts[s], stTy, ret)
                      + litMemberNote(stmts[s], ret, 8),
                    stmts[s],
                    ret,
                  )
                } else {
                  // The check above is vacuous whenever a side is a hole, exactly as the
                  // explicit `return`'s is — so the implicit return records the same pair for
                  // the pin to re-ask under substitution. Without it a generic's TAIL
                  // expression loses the refusal its `return` spelling makes (D1739).
                  noteRetCstr(coalPinTy(stmts[s], stTy), ret, stmts[s])
                }
              }
            } else if P.nodes[stmts[s]] is IfStmt {
              // A tail `if`/`else` — or the chain a tail `match` desugared to — is a statement
              // node, but under a non-void return each arm's value is the return (D2234).
              if !isVoidTy(ret) && ret != TY_NEVER {
                checkTailArmsAgainst(stmts[s], ret)
              }
            }
          }
        }
        if inferring {
          // A value-producing trailing expression is a value return POSITION (vs a
          // bare trailing statement); the redundant-return fixpoint defers only these.
          if !isStmtNode(stmts[s]) { fnSawValueRetSet(true) }
          // D1045 — the IMPLICIT return of the same rule: the trailing expression
          // is what a caller receives, so a body-scoped nominal escapes here too.
          if !isStmtNode(stmts[s]) { refuseLocalNomEscape(stTy, stmts[s]) }
          // The IMPLICIT return of the deferred pin, for the reason the explicit one
          // states: under inference the destination is the join, not this witness (D1591).
          // A tail `if` with a value-less arm is a statement, so the body has no tail value.
          if !ifYieldsNoValue(stmts[s]) {
            noteInferRetWitness(stmts[s], stTy)
            inferRetNextLitSet(armLit(stTy, stmts[s]))
            noteInferredRet(
              ifTailValTyOf(stmts[s], inferRetTyOf(stmts[s], stTy)),
            )
          }
          // The soundness check for an inferred return: `inferObserved` is the join of the
          // returns just walked (the value type the chain infers), while the tail if-statement's
          // own type is void for an all-returning chain — so the accumulated join is what the
          // fall-through is checked against, refused the same as an annotation would (D1902).
          checkTrailingChainTotal(stmts[s], inferObserved)
        } else {
          // Redundant-return rule: witness the trailing expression's NATURAL type
          // (before constrainEmpty pins a hole); an annotation-influenced trailing
          // (empty `[]`/`Map()`, `null`) disqualifies the function.
          if (
            retInfluencedByAnnot(stmts[s])
            || retSiteTypedByAnnot(stmts[s], stTy)
          ) {
            retNaturalErrSet(true)
          }
          noteNaturalRet(stTy)
          constrainEmptyExpr(stmts[s], stTy, ret)
          // Soundness — missing-return / non-exhaustive fall-through: an else-less `is`-chain
          // that does not cover every variant lets a value fall off the end, refused for a
          // non-void declared return (D1902).
          checkTrailingChainTotal(stmts[s], ret)
        }
      }
      s = s + 1
    }
  }
  chkStmtBlkSet(savedStmtBlk)
  // Hover over an un-annotated param: the body has now recorded everything it demands of the
  // param hole, so re-retains the binding's type as that demand (the same disjunction the
  // call-arg diagnostic names) instead of the bare hole, which renders as an uninformative `_`.
  // Holes the body never constrained keep the `TyVar`, still skipped by the inlay-hint scan.
  if symEnabled != 0 && !inferQuiet {
    let hp = 0
    while hp < params.length {
      const hpNode = P.nodes[params[hp]]
      if hpNode is Param && paramTys[hp] >= 0 {
        const hpTy = T.tys[paramTys[hp]]
        if hpTy is TyVar {
          const hpDemand = holeDemandTy(hpTy.tvName)
          if hpDemand >= 0 { symRetainType(params[hp], hpDemand, 1) }
        }
      }
      hp = hp + 1
    }
  }
  // Capture body TOTALITY (missing-return soundness) while the body scope is still LIVE
  // — `ifCondIsDiscriminating` looks up a discriminated param/local's type, which the
  // `popScope` below would drop. The flag is consumed after `ret` is finalized.
  const bodyTotalForRet = nodeIsTotal(n.fnBody)
  // The editor shows an unread function's inferred return, not the `void` it lowers as.
  if ucVoided && symEnabled != 0 && ucShowRet >= 0 && ucShowRet != TY_ERR {
    symRetainType(fnIx, mkFuncTy(paramTys, ucShowRet), 2)
  }
  T.curRet = savedRet
  inRetArgSet(savedInRetArg)
  curFnEscNameSet(savedEscName)
  curFnDeclIx = savedFnDeclIx
  njFnIxSet(savedNjFn)
  curFnBareRetVoidSet(savedBareRetVoid)
  daLeaveFrame(daSavedUnassigned)
  // A write after a call in source order (a loop's back edge) is re-asked here, inside this body,
  // so a pair naming its type parameter is deferred to its instances as at the call.
  let fsbC = fsbCallsAt
  while fsbC < fsbCallIx.length {
    fsbRecheckFrom(fsbC)
    fsbC = fsbC + 1
  }
  let tpPop = 0
  while tpPop < n.fnTyParams.length {
    tpEnvNames.pop()
    tpEnvTys.pop()
    tpBoundNamesPop()
    tpBoundAnnsPop()
    tpPop = tpPop + 1
  }
  if cstrOwnerPushed { cstrOwnerStack.pop() }
  // Every return witness is in, so the inferred return type is final — pin the empty
  // collections this body delivered to it, BEFORE `popScope` grades their bindings. An
  // ANNOTATED body recorded nothing (those positions pin at the delivery) (D1591).
  flushInferRetHoles()
  popScope()
  crFnLeave()
  narClobKeysSet(savedClobKeys)
  narClobTysSet(savedClobTys)
  narClobPrevSet(savedClobPrev)
  narClobDepthsSet(savedClobDepths)
  narClobRetiredSet(savedClobRetired)
  narClobBindSet(savedClobBind)
  narClobDeclSet(savedClobDecl)
  if !inferQuiet {
    // Marks only the registered top-level decl (not a nested/shadowing namesake).
    if n.fnName != "" && (fnDeclIx[n.fnName] ?? -1) == fnIx {
      bodyChecked[n.fnName] = true
    }
  }
  if inferring && inferObserved >= 0 {
    let dk = savedDroppedLen
    while dk < inferDroppedTy.length {
      inferRetJoin(inferDroppedTy[dk], inferDroppedLit[dk])
      dk = dk + 1
    }
  }
  while inferDroppedTy.length > savedDroppedLen {
    inferDroppedTy.pop()
    inferDroppedLit.pop()
  }
  inferObservedSet(inferRetF32Join(inferring, inferObserved))
  if inferring {
    ret = finishInferredReturn(
      n,
      fnIx,
      paramTys,
      paramUninferable || bareBraceCount > bbBefore,
      cbBefore,
      savedObserved,
      savedSawErr,
      savedValueRet,
      bodyTotalForRet,
    )
    inferObservedLitSet(savedObservedLit)
    // Inferred non-void after all: the tail's value arms return (`clearTailVerdict`).
    if ret >= 0 && !isVoidTy(ret) && ret != TY_ERR {
      clearTailVerdict(blockLastStmt(n.fnBody))
    }
  }
  refuseVoidRetsFrom(savedVoidRetLen, ret)
  // This body's witnesses belong to its own inference, not to an enclosing `if`'s replay.
  while inferRetLogTy.length > savedRetLogLen {
    inferRetLogTy.pop()
    inferRetLogSeed.pop()
    inferRetLogLit.pop()
  }
  // Soundness — missing return: a function whose body can fall off the end without yielding a
  // value on some path implicitly produces `null`, sound only when `null` is part of the
  // return type. Asks whether the whole type admits `null` (`tyBearsNull`, recursive), not
  // just its top node — a union that reaches `null` through a member needs this too. Suppressed in the pre-pass and on a void/error return.
  let retNullableNow = false
  if ret >= 0 { retNullableNow = tyBearsNull(ret) }
  // A `never` function has no value to return: every path must end in a call that never
  // returns, which is the shared exit rule over the whole body (D1972).
  if !inferQuiet && ret == TY_NEVER && ret >= 0 && !stmtAlwaysExits(n.fnBody) {
    let who = "this function"
    if n.fnName != "" { who = "`" + n.fnName + "`" }
    tErr(
      who
        + " is declared `never` but can return — end every path in a call that never returns, such as `__trap__()`",
      n.fnBody,
    )
  }
  if (
    !inferQuiet
    && !isVoidTy(ret)
    && ret != TY_NEVER
    && ret != TY_ERR
    && !bodyTotalForRet
    && !retNullableNow
  ) {
    const bn = braceNameTail(n.fnBody)
    if bn >= 0 && braceNameNote(bn, ret) != "" {
      const bnm = P.nodes[bn]
      let nm = ""
      if bnm is Ident { nm = bnm.identName }
      tErr(
        "`{ "
          + nm
          + " }` here is a block, not a record — write `return { "
          + nm
          + " }` or `({ "
          + nm
          + " })`",
        bn,
      )
    } else {
      tErr(
        "not all code paths return a value in '"
          + n.fnName
          + "' — add a `return`, or annotate the return type `| null` to fall through",
        n.fnBody,
      )
    }
  }
  // Redundant return annotation: the body's natural inferred return already equals the
  // explicit `: T`, so removing it yields the identical type. Conservative: a single
  // concrete observed return rendering identically to `ret`; a hole / error / `never` /
  // an annotation-influenced return is skipped, and this never fires under the pre-pass.
  if (
    !inferring
    && !inferQuiet
    && n.fnRet >= 0
    && retNatural >= 0
    && !retNaturalErr
  ) {
    if !inlayHole(retNatural) && !isNeverTy(retNatural) && ret != TY_ERR {
      // A bare `return` in the body makes the un-annotated spelling void, so the annotation
      // is load-bearing however well its type matches the tail (D1600).
      const pinned = lbiPinnedReads != pinnedReads0
      if tyEq(retNatural, ret) && !blockHasBareReturn(n.fnBody) && !pinned {
        recordRedundantRet(n, fnIx, ret)
      }
    }
  }
  retNaturalSet(savedRetNatural)
  retNaturalErrSet(savedRetNaturalErr)
  // Inferred type guard (A6b, host parity — degenerate case): a NAMED function
  // whose body's RESULT is exactly a null-test on one of its params registers
  // as a guard, so calling it in a condition narrows the argument (inline,
  // UFCS, and the guard-clause form).
  if n.fnName != "" {
    const gBody = P.nodes[n.fnBody]
    if gBody is Block {
      const gStmts = gBody.blkStmts
      if gStmts.length > 0 {
        const gLastIx = gStmts[gStmts.length - 1]
        const gLast = P.nodes[gLastIx]
        let gResIx = gLastIx
        if gLast is RetStmt { gResIx = gLast.retArg }
        if gResIx >= 0 {
          const gParamNames: string[] = []
          let gp = 0
          while gp < params.length {
            const gpn = P.nodes[params[gp]]
            if gpn is Param {
              gParamNames.push(gpn.parName)
            } else {
              gParamNames.push("")
            }
            gp = gp + 1
          }
          const gFact = guardFactOf(gResIx, gParamNames)
          if gFact >= 0 {
            const gThen = gFact - gFact / 2 * 2
            guardNamesPush(n.fnName)
            guardParamIdxsPush(gFact / 2)
            guardThensPush(gThen)
          }
        }
      }
    }
  }
  // The function's own type — a FuncDecl in EXPRESSION position (a lambda, or a
  // named function referenced as a value) evaluates to it.
  mkFuncTy(paramTys, ret)
}

// Resolves declaration statement `sx`'s fields/variants and fills them into the placeholder
// pass 0a minted for it. Two callers make the fill order-independent: pass 0b's source-order
// driver, and `declaredTyOfName`'s on-demand `forceDeclFill` when a body names a declaration
// the driver has not reached yet. Marks done before the body resolves, so a recursive declaration lands on its own empty placeholder.
function fillTypeDeclAt(sx: i32) {
  const sd = P.nodes[sx]
  if sd is TypeDecl {
    const declIx = cUserTypes[sd.tdName] ?? -1
    if declIx >= 0 && !fillDone(declIx) {
      markFillDone(declIx)
      const pt = T.tys[declIx]
      if pt is TyObj {
        const fnames = pt.objFieldNames
        const ftys = pt.objFieldTypes
        const dfields = sd.tdFields
        let fi = 0
        while fi < dfields.length {
          const fd = P.nodes[dfields[fi]]
          if fd is FieldDef {
            fnames.push(fd.fdName)
            let fty = TY_ERR
            if fd.fdType >= 0 {
              const ftn = P.nodes[fd.fdType]
              // A sub-word storage width (`u8`/`i8`/`u16`/`i16`) is legal only as a `flat` field
              // — the packed-storage carve-out beside `u8[]`'s, so the leaf gate does not refuse
              // it. Resolves to the `u8` storage type as a placeholder; the width comes from the
              // spelling in `flatStageDecl`, and elsewhere it stays illegal.
              if (
                ftn is TypeRef
                && sd.tdFlat == 1
                && flatStorageSpellWidth(ftn.tyName) > 0
              ) {
                fty = TY_U8
                if !inferQuiet && fd.fdType < nodeTyIx.length {
                  nodeTySet(fd.fdType, TY_U8)
                }
              } else if ftn is TypeRef {
                // The diagnostic anchors on the FIELD (`dfields[fi]`); the
                // spelling tree is banked on its `TypeRef` child.
                const r = nameToTyAnn(ftn.tyName, dfields[fi], fd.fdType)
                if r >= 0 {
                  fty = r
                  // Record the resolved type on the field's annotation node so the emitter
                  // classifies a struct field structurally from the arena, not the name (C1).
                  if !inferQuiet && fd.fdType < nodeTyIx.length {
                    nodeTySet(fd.fdType, r)
                  }
                } else {
                  unknownTyErr(
                    ftn.tyName,
                    " for field '" + fd.fdName + "'",
                    dfields[fi],
                  )
                }
              }
            }
            ftys.push(fty)
          }
          fi = fi + 1
        }
        // The 0a placeholder is just filled in place (its field arrays are
        // the ones pushed above) — an existing arena entry changed shape.
        tyMutEpoch = tyMutEpoch + 1
      }
    }
  } else if sd is UnionDecl {
    // A union's variants are type NAMES; resolve each into the member
    // type-arena indices (forward references hit the 0a placeholders).
    const declIx = cUserTypes[sd.udName] ?? -1
    if declIx >= 0 && !fillDone(declIx) {
      markFillDone(declIx)
      const pt = T.tys[declIx]
      if pt is TyUnion {
        const members = pt.uMembers
        const variants = sd.udVariants
        // A degenerate self-cycle — `type D = D`, a body that is nothing but
        // the alias itself — has no base case, so nothing can inhabit it.
        // Reported at the declaration (host parser parity), so an unused
        // `type D = D` still flags; the members stay empty (host: `Never`).
        if variants.length == 1 && variants[0] == sd.udName {
          tErr(
            "Type `"
              + sd.udName
              + "` is defined in terms of itself "
              + "with no base type, so it can never have a value",
            sx,
          )
        } else {
          let vi = 0
          let resolvedAny = false
          const declMemberIxs: i32[] = []
          // The surviving members, and the two lists the NICHE fold below needs:
          // every non-`null` survivor, and whether a `null` variant is among them.
          // Filled here instead of straight into `members` (the live arena array)
          // because the fold replaces the whole list with one wrapped member.
          const surviving: i32[] = []
          const nonNull: i32[] = []
          let sawNull = false
          while vi < variants.length {
            // A union member is a parser spelling, banked on this declaration node in member
            // order (`setUdTs`) — resolves the tree via `annotResolve`, the shared ladder every
            // positioned annotation and the `is` test already climb, not the concatenated name.
            let m = annotResolve(variants[vi], udTsRootAt(sx, vi))
            // D1022 — a member blocked by a declaration cycle falls back to its placeholder
            // rather than being dropped: `annotResolve` answers -1 while the fill is still in
            // progress, and dropping the arm silently narrowed the declared union to a type
            // the program never wrote. Pass 0a's placeholder exists precisely for this forward reference, so the fallback reaches it instead of losing the member.
            if m < 0 {
              const phName = variants[vi]
              const ph = cUserTypes[phName] ?? -1
              if ph >= 0 { m = ph }
            }
            if m >= 0 {
              declMemberIxs.push(m)
              resolvedAny = true
              // A member that folds to `never` (an empty intersection) drops from the union; a
              // declaration with no surviving member is the never-value error below. D1022 — an
              // unfilled placeholder is not `never`: dropping it as one let declaration ORDER
              // decide a type, since an empty union reads as `never`. The never-drop is only for a resolved empty intersection, not a placeholder still mid-fill.
              let mPlaceholder = false
              const mDecl = cFillStmtIx[variants[vi]] ?? -1
              if mDecl >= 0 {
                if !fillDone(mDecl) { mPlaceholder = true }
              }
              if !isNeverTy(m) || mPlaceholder {
                surviving.push(m)
                if m == TY_NULL { sawNull = true } else { nonNull.push(m) }
              }
            } else {
              unknownTyErr(variants[vi], " in union '" + sd.udName + "'", sx)
            }
            vi = vi + 1
          }
          // The declaration route's copy of `annUnionInnerTy`'s unseparable-member rule: this
          // loop builds its member list itself, so `type U = N | i32` never reaches the shared
          // annotation home. The union still fills — one diagnostic at the declaration is the
          // whole report, since poisoning the arena entry would turn every use into a worse one.
          const nwClash = nomUnionRepClashMsg(surviving)
          if nwClash.length > 0 {
            tErr(nwClash + " in union '" + sd.udName + "'", sx)
          }
          // The subsumed-arm collapse on the declaration side (`unionDropSubsumedArms`), the
          // same shared rule `annUnionInnerTy` applies — the two routes are one language, so
          // `type R = string | "err"` must collapse to `string` for the same reason the inline
          // spelling does. The registration list is filtered by the same predicate rather than rebuilt from the survivors, since `declMemberIxs` is a superset pushed before the never-drop.
          const survU: i32[] = []
          const nonNullU: i32[] = []
          const declU: i32[] = []
          // The declaration route's half of D1048's second-hint provenance: the annotation
          // route banks the arena index it collapsed to, while a declared alias banks its name
          // instead, since the index it produces is re-derived at every later `: R` through
          // `declaredTyOfName`. Recorded from the return value, not a length compare.
          if unionDropSubsumedArms(surviving, survU) {
            collapsedAliasesSetAt(sd.udName, true)
          }
          let cu = 0
          while cu < survU.length {
            if survU[cu] != TY_NULL { nonNullU.push(survU[cu]) }
            cu = cu + 1
          }
          cu = 0
          while cu < declMemberIxs.length {
            if !unionArmSubsumedBy(declMemberIxs[cu], surviving) {
              declU.push(declMemberIxs[cu])
            }
            cu = cu + 1
          }
          // The `null` niche fold: an un-parenthesized `type T = X | null` denotes `X?`,
          // exactly as the inline annotation and the parenthesized declaration already do
          // (`annUnionTy`, the shared home) — without it `null` stayed a sibling variant,
          // breaking the one-member wrapper shape every niche consumer expects. Ungated on the inner, so this is `annUnionTy` and not a second copy of it.
          let folded = -1
          if sawNull && nonNullU.length > 0 {
            folded = annUnionTy(nonNullU, true)
          } else if sawNull {
            // Every member is `null` (`type N = null | null`), which denotes `null` itself.
            folded = TY_NULL
          }
          // The literal-union flatten, on the declaration side (`litUnionFlatMembers`, the
          // same transform `annUnionInnerTy` climbs): this arm builds its member list itself,
          // so `type U = A | B` over two litunion aliases would otherwise fill the placeholder
          // with a union of unions, disagreeing with every channel that softens it. Gated on `!sawNull` since the null fold above already owns that list.
          const flatU: i32[] = []
          let flattened = false
          if folded >= 0 {
            members.push(folded)
          } else {
            if !sawNull { flattened = litUnionFlatMembers(survU, flatU) }
            if flattened {
              let fi = 0
              while fi < flatU.length {
                members.push(flatU[fi])
                fi = fi + 1
              }
            } else {
              let mi = 0
              while mi < survU.length {
                members.push(survU[mi])
                mi = mi + 1
              }
            }
          }
          // Variant-member registration is arity-aware (Stage B b1): only a real (2+
          // surviving member) union registers its members as variants, since the emitter
          // lowers a single-member union as the member itself, never as a variant box. A
          // flattened union registers the flattened members, not the source aliases — marking an alias itself a variant would box it at every other use in the module.
          if members.length >= 2 {
            if flattened {
              let fr = 0
              while fr < flatU.length {
                cTyIxSetAdd(
                  cVariantMemberTyIxs,
                  cVariantMemberTyIxSet,
                  flatU[fr],
                )
                fr = fr + 1
              }
            } else {
              let ri = 0
              while ri < declU.length {
                cTyIxSetAdd(
                  cVariantMemberTyIxs,
                  cVariantMemberTyIxSet,
                  declU[ri],
                )
                ri = ri + 1
              }
            }
          }
          // The 0a placeholder union is just filled in place (`members` is
          // its `uMembers` array) — an existing arena entry changed shape.
          noteUnionMembers(members)
          tyMutEpoch = tyMutEpoch + 1
          if resolvedAny && members.length == 0 {
            // Explains the empty intersection in source terms: names the two operands and
            // their kinds, or calls out a self-reference — falling back to generic wording for
            // a non-binary/non-intersection never. Reads the intersection's operands from the
            // member's `TS_ISECT` spelling node directly, rather than re-splitting the parser's concatenated name.
            const opRoots: i32[] = []
            const ops: string[] = []
            const isectRoot = udTsRootAt(sx, 0)
            if isectRoot >= 0 {
              if tsKind[isectRoot] == TS_ISECT {
                const opStart = tsKidStart[isectRoot]
                let opk = 0
                while opk < tsKidCount[isectRoot] {
                  opRoots.push(tsKids[opStart + opk])
                  ops.push(tsToName(tsKids[opStart + opk]))
                  opk = opk + 1
                }
              }
            }
            let didDetail = false
            if variants.length == 1 && ops.length == 2 {
              const expr = ops[0] + " & " + ops[1]
              const selfRef = ops[0] == sd.udName || ops[1] == sd.udName
              if selfRef {
                tErr(
                  "Type `"
                    + sd.udName
                    + "` refers to itself inside an intersection (`"
                    + expr
                    + "`), so it reduces to `never`",
                  sx,
                )
              } else {
                tErr(
                  "Type `"
                    + sd.udName
                    + "` is `never` (an empty type — `"
                    + expr
                    + "`, "
                    + operandKind(tsToTy(opRoots[0]))
                    + " and "
                    + operandKind(tsToTy(opRoots[1]))
                    + ", have no common values), so it has no values",
                  sx,
                )
              }
              didDetail = true
            }
            if !didDetail {
              tErr(
                "Type `"
                  + sd.udName
                  + "` is `never` (an empty type — "
                  + "its operands have no common values), so it has no values",
                sx,
              )
            }
          }
        }
      }
    }
  }
  0
}

// Fills declaration `name` now, when pass 0b is running and has not reached it yet. Inert
// outside pass 0b, which keeps every later re-resolution a plain lookup. Saves the
// unknown-type bank across the nested fill, so a nested failure raises at its own
// declaration with a fresh frame rather than renaming the caller's diagnostic.
function forceDeclFill(name: string) {
  if !cFillActive { return 0 }
  const sx = cFillStmtIx[name] ?? (-1)
  if sx < 0 { return 0 }
  const svDepth = unkTyDepth
  const svPart = unkTyPart
  const svClash = unkTyClash
  unkTyDepthSet(0)
  fillTypeDeclAt(sx)
  unkTyDepthSet(svDepth)
  unkTyPartSet(svPart)
  unkTyClashSet(svClash)
  0
}

// The program root: pass 0 registers `type` declarations (structs, then unions over
// them), pass 1 hoists function signatures (call-before-decl + mutual recursion),
// pass 2 checks every top-level statement.
function checkProgramNode(n: Program) {
  const stmts = n.progStmts
  // Pass 0: registers top-level struct `type` declarations before anything else, so a struct
  // name in a param/return/let annotation or a later struct's field resolves via `nameToTy`.
  // Pass 0a pre-registers every top-level `type` name with an empty placeholder (struct or
  // union) so self- and forward-references inside field annotations and union variants resolve, filled in pass 0b.
  let t0 = 0
  while t0 < stmts.length {
    const sd0 = P.nodes[stmts[t0]]
    // A `type` declaration may not take a built-in type name: the checker resolves a bare
    // name through `tsLeafTy`, which asks `primTyOfName` first, so `f64` in an annotation is
    // the primitive while nothing screened the declaration side — a reject, not a resolution
    // change, since making one side win would silently redefine a keyword inside one file (D1585).
    if sd0 is TypeDecl {
      if isBuiltinTyName(sd0.tdName) {
        tErrBuiltinTyDecl(sd0.tdName, stmts[t0])
      }
    }
    if sd0 is UnionDecl {
      if isBuiltinTyName(sd0.udName) {
        tErrBuiltinTyDecl(sd0.udName, stmts[t0])
      }
    }
    if sd0 is TypeDecl {
      // A bound alias (`type Showable = { toString(): string }`) registers in
      // `cBoundDecls`, not `cUserTypes` — it constrains a type parameter and has no
      // values, so a type-arena entry would make it spellable in value position, which
      // the trait-object design rules out. `declaredTyOfName` turns such a use into a sentence instead.
      const bAnn0 = declBoundOf(stmts[t0])
      if bAnn0 >= 0 {
        cBoundDeclsSetAt(sd0.tdName, bAnn0)
        t0 = t0 + 1
        continue
      }
      // A generic alias (`type Box<T> = …`) registers in the generic-alias registry, not
      // `cUserTypes`, since it has no concrete type until applied — pass 0b skips it, and each
      // application resolves its fields under the param→argument bindings (`applyGenAlias`).
      // The nominal-newtype declaration fact is recorded now regardless, honoured only on the concrete arm below.
      const gBase = declGpBaseOf(stmts[t0])
      if gBase != "" {
        gaNames.push(gBase)
        gaDeclIxs.push(stmts[t0])
        // D-GAPARAM: the parameter list is banked ONCE, here, into the flat
        // column. Master re-split the joined string inside `applyGenAliasArgs`,
        // i.e. once per APPLICATION of the alias; the list is a property of the
        // DECLARATION and cannot change between applications.
        const gps = declGpParamsOf(stmts[t0])
        gaParamStart.push(gaParamNames.length)
        gaParamCount.push(gps.length)
        let gpi = 0
        while gpi < gps.length {
          gaParamNames.push(gps[gpi])
          gpi = gpi + 1
        }
      } else {
        // A bodyless alias (parser sentinel `tdFields == [-1]`) registers as the error type,
        // since the parser already reported it; a real body builds an object placeholder pass
        // 0b fills. Banked in the fill registry so a forward reference can demand its shape
        // early — absent for a generic alias, which resolves under its own bindings instead.
        cFillStmtIx[sd0.tdName] = stmts[t0]
        const df0 = sd0.tdFields
        const bodyless0 = df0.length == 1 && df0[0] == (-1)
        if bodyless0 {
          cUserTypes[sd0.tdName] = TY_ERR
          cUserTypesVer = cUserTypesVer + 1
        } else {
          const fnames0: string[] = []
          const ftys0: i32[] = []
          const sIx0 = mkObjTy(fnames0, ftys0)
          cUserTypes[sd0.tdName] = sIx0
          cUserTypesVer = cUserTypesVer + 1
          cStructPush(sIx0, sd0.tdName)
          if sd0.tdNew == 1 {
            nwDeclNames.push(sd0.tdName)
            if isBodyTyDecl(stmts[t0]) { nwBodyScopedNamesSetAt(sd0.tdName, 1) }
          }
        }
      }
    } else if sd0 is UnionDecl {
      // A one-member alias whose body is a plain type reference is transparent — decided
      // here in pass 0a since the question is syntactic (the arena cannot tell it from a
      // canonicalized intersection) and both readers run later. A self-cycle (`type D = D`)
      // is excluded: it is the degenerate never-type pass 0b reports, and resolving it transparently would chase its own placeholder.
      const uvs0 = sd0.udVariants
      if uvs0.length == 1 && uvs0[0] != sd0.udName {
        if aliasRefIsPlainRoot(udTsRootAt(stmts[t0], 0)) {
          cPlainAliasNames.push(sd0.udName)
        }
      }
      cFillStmtIx[sd0.udName] = stmts[t0]
      const members0: i32[] = []
      const uIx0 = mkUnionTy(members0)
      cUserTypes[sd0.udName] = uIx0
      cUserTypesVer = cUserTypesVer + 1
      cTyIxSetAdd(cUnionTyIxs, cUnionTyIxSet, uIx0)
      cUnionNames.push(sd0.udName)
      if sd0.udNew == 1 {
        nwDeclNames.push(sd0.udName)
        if isBodyTyDecl(stmts[t0]) { nwBodyScopedNamesSetAt(sd0.udName, 1) }
      }
    }
    t0 = t0 + 1
  }
  // Pass 0b: resolves each declaration's fields/variants into the placeholder, in demand
  // order rather than source order — `fillTypeDeclAt` re-enters from `declaredTyOfName`
  // whenever a body names a declaration the walk has not reached, so a forward reference
  // resolves against the filled shape regardless of which declaration came first.
  cFillDoneAtSet([])
  cFillActiveSet(true)
  // A pure string-literal union alias fills ahead of the driver, because the reference to it
  // is by member set, not by name (D1151): an inline `{ k: "a" | "b" }` reaches for the alias
  // through `litUnionAliasTyOfMembers`, which scans for a filled litunion with exactly these
  // members — so an un-filled placeholder would mint a second, unregistered union for the same spelling.
  let li = 0
  while li < stmts.length {
    const ls = P.nodes[stmts[li]]
    if ls is UnionDecl {
      if udVariantsAllStrLit(ls.udVariants) { fillTypeDeclAt(stmts[li]) }
    }
    li = li + 1
  }
  let ti = 0
  while ti < stmts.length {
    fillTypeDeclAt(stmts[ti])
    ti = ti + 1
  }
  cFillActiveSet(false)
  // Pass 0c: MEASURE every `flat type` (webcraft P1.2). Runs here because it needs
  // pass 0b's resolved field types (a scalar's width is read off the arena, which
  // is what makes a newtype over a scalar work for free) and must precede any
  // expression checking, since `N.size` / `N.field` fold against this sidecar.
  resolveFlatLayouts(stmts)
  // Pass 0d: refuse a declared union whose set and map arms clash. Runs after 0b has filled
  // every arm, since a declaration cycle can leave a member a placeholder inside the fill.
  checkUnionSetMapClash(stmts)
  // Pass 1: hoist top-level function signatures so call-before-decl and mutual
  // recursion type-check.
  let hi = 0
  while hi < stmts.length {
    const s = P.nodes[stmts[hi]]
    // D1645 — a nameless `FuncDecl` is an arrow lambda at statement position, an
    // expression whose value is discarded: it binds no name, so nothing hoists it.
    // `declare("")` files every one of them under one key, which reports the second as
    // `redeclared` with a blank name and banks a pending return nothing patches.
    if s is FuncDecl && s.fnName.length > 0 {
      // A SECOND top-level `function` of the same name is a redeclaration error,
      // exactly like a duplicate `let`/`const` (B16). Without this the later
      // hoist silently overwrites the earlier one and the last body wins.
      if (fnDeclIx[s.fnName] ?? -1) >= 0 {
        // `opDeclLabel` is the identity on an ordinary name; an index operator
        // reads back as `"[]" for F32View` rather than as its minted spelling.
        tErr("redeclared " + getDeclLabel(opDeclLabel(s.fnName)), stmts[hi])
      }
      const hp = s.fnParams
      const hpt: i32[] = []
      let k = 0
      while k < hp.length {
        const hpn = P.nodes[hp[k]]
        let t = TY_ERR
        if hpn is Param {
          if hpn.parType >= 0 {
            const hptn = P.nodes[hpn.parType]
            if hptn is TypeRef {
              const r = resolveAnnotAt(
                hptn.tyName,
                s.fnTyParams,
                hpn.parType,
                s.fnName,
              )
              if r >= 0 { t = r }
            }
          } else {
            // An un-annotated param hoists as its inference hole (the same declaration+
            // position name `checkFuncDeclNode` mints, so a forward call binds the identical
            // hole by name) — or as the type pass 1.8's solve pinned it to, via
            // `unannotParamTy`, which keeps this hoist and the body from disagreeing.
            t = unannotParamTy(paramHoleName(s.fnName, stmts[hi], k))
          }
        }
        hpt.push(t)
        k = k + 1
      }
      // An UN-ANNOTATED return hoists as the PENDING sentinel (-2): the real type
      // is inferred from the body in pass 2 (or on demand at a forward call site),
      // then PATCHED into this same TyFunc in place.
      let hret = -2
      if s.fnRet >= 0 {
        const hrtn = P.nodes[s.fnRet]
        if hrtn is TypeRef {
          const r = resolveRetAnnotAt(
            hrtn.tyName,
            s.fnTyParams,
            s.fnRet,
            s.fnName,
          )
          // D1048's second hint, recorded order-independently: this hoist is the only pass
          // that resolves every top-level return before any body runs, so a `const r = f(…)`
          // written above `function f(): R` still inherits the provenance.
          if r >= 0 && r == collapsedTy { markCollapsedRet(stmts[hi]) }
          if r >= 0 { hret = r } else { hret = TY_VOID }
        }
      }
      // A result no caller reads is not returned: hoisted as the `: void` it is checked as.
      if hret == (-2) && fnResultUnconsumed(stmts[hi]) { hret = TY_VOID }
      declare(s.fnName, mkFuncTy(hpt, hret))
      fnDeclIx[s.fnName] = stmts[hi]
      declareFnDeclNode(s.fnName, stmts[hi])
      // A getter registers under its receiver type, the only route by which a read finds it.
      const gProp = getDeclPropOf(s.fnName)
      if gProp != "" && hpt.length == 1 {
        getFns.push(s.fnName)
        getProps.push(gProp)
        getDecls.push(stmts[hi])
        getSelfTys.push(hpt[0])
      }
      // REGISTER a free index operator (B14). Its ARITY is fixed by the operator
      // — `"[]"` is (self, index), `"[]="` is (self, index, value) — and checking
      // it here means a malformed declaration is reported once, at itself, rather
      // than at every use site that fails to resolve.
      const opk = opDeclOpOf(s.fnName)
      if opk == OP_INDEX_GET || opk == OP_INDEX_SET {
        let want = 2
        if opk == OP_INDEX_SET { want = 3 }
        if hp.length != want {
          tErr(
            "operator "
              + opDeclLabel(s.fnName)
              + " takes "
              + i32ToStr(want)
              + " parameters (self, index"
              + opIdxArityTail(opk)
              + "), got "
              + i32ToStr(hp.length),
            stmts[hi],
          )
        } else if opIdxDeadRecv(hpt[0]) {
          // The swallow, said out loud (D445): indexing an array, a map or a string is the
          // language's, never a user operator's, so a declaration over one of them is not a
          // dispatch that fails to happen — it is one the language already decided will never
          // happen, named here at the declaration rather than silently at every use site.
          tErr(
            "operator "
              + opDeclLabel(s.fnName)
              + " can never dispatch: indexing "
              + tyToStr(hpt[0])
              + " is the language's own, never a user operator's",
            stmts[hi],
          )
        } else {
          opIdxOps.push(opk)
          opIdxFns.push(s.fnName)
        }
      } else if isBinOpDecl(s.fnName) {
        // A BINARY operator: register it under its SYMBOL in the operator table `opSelfFnTy`'s
        // receiver scan reads, so several receiver types can each define the symbol and
        // dispatch resolves by the left operand's type (B14 generalized). Both a receiver-keyed
        // `+@Vec3` and a bare `+` (unannotated/hole `self`) register under `+` (D1934).
        let binSym = s.fnName
        if opk != "" { binSym = opk }
        opIdxOps.push(binSym)
        opIdxFns.push(s.fnName)
      }
      // The swallow at the binary operators, said out loud (D425) — the twin of the index
      // gate above: `checkBinary` reaches `opSelfFnTy` only when the left operand is an
      // object, so a declaration whose `self` is not one is not a dispatch that fails, it is
      // one the language already decided will never happen. Disjoint from D471's first-parameter-name gate (checked in the parser), so a declaration failing both gets the name diagnostic only.
      if isBinOpDecl(s.fnName) {
        if hp.length == 2 {
          let selfNamed = false
          // Whether `self` carries an ANNOTATION at all (D491) — read inside the `is
          // Param` narrowing, which is the only place the field exists.
          let selfAnn = false
          const bp0 = P.nodes[hp[0]]
          if bp0 is Param {
            if bp0.parName == "self" { selfNamed = true }
            if bp0.parType >= 0 { selfAnn = true }
          }
          if selfNamed {
            if binOpDeadSelf(hpt[0]) {
              tErr(
                "operator `"
                  + opDeclLabelBin(s.fnName)
                  + "` can never dispatch: `self` is the LEFT OPERAND and dispatch needs an object, but "
                  + tyToStr(hpt[0])
                  + " is not one",
                stmts[hi],
              )
            } else {
              // The hole this gate subtracts (D491) is banked, not judged — whether this
              // declaration fires is decided at the sites (`checkProgramEndOpDecls`). Both hole
              // spellings are banked as one population: `function "+"(self, other)` hoists its
              // parameter as a fresh type variable, so `tyHasHole` is true of it exactly as of `self: T` (D521).
              if hpt[0] >= 0 {
                if tyHasHole(hpt[0]) {
                  // Banked under the bare SYMBOL, not the receiver-keyed decl name: D491 is a
                  // whole-program question ("does this operator ever dispatch"), and the site
                  // side (`opBinSiteTook`) records the symbol, so both halves must key alike. A
                  // `self: T` op mints `+@T` but the question it answers is about `+`.
                  const holeSym = opDeclOpOf(s.fnName)
                  let holeKey = s.fnName
                  if holeSym != "" { holeKey = holeSym }
                  opBinHoleDeclNamePush(holeKey)
                  opBinHoleDeclNodePush(stmts[hi])
                  opBinHoleDeclAnnPush(selfAnn)
                }
              }
            }
          }
        }
      }
      // Collect un-annotated returns (hoisted as the `-2` pending sentinel) for the
      // return-inference pre-pass.
      if hret == (-2) { topUnannotFns.push(stmts[hi]) }
      // Completion visibility: a top-level function is global. Stamped here (only
      // the global scope is open) so it wins over any later demand-inference
      // re-entry, which would run the body from a deeper stack (see `symStampVis`).
      if symEnabled != 0 {
        symStampVis(s.fnName, stmts[hi], 2, scopeSL.length - 1)
      }
    }
    hi = hi + 1
  }
  // Pass 1.5 hoists top-level value bindings (names + types) so a function body sees every
  // module-level value regardless of source order, making the module scope order-independent.
  // Initialization order still matters for straight-line top-level code — each global joins
  // the definite-assignment dead-zone here — but a function body runs at call time, so a deferred read from inside one is correctly not flagged.
  lbiScanModLits(stmts)
  modClashNamesSet(Map())
  let mi = 0
  const phLets: i32[] = []
  while mi < stmts.length {
    const sm = P.nodes[stmts[mi]]
    if sm is LetDecl {
      // A top-level `function` and a top-level value binding share one scope and one
      // namespace, so the pair is the redeclaration the two same-kind rules already refuse
      // and a module merge refuses at parse. Anchored at the LATER declaration, since the
      // two hoists run in kind order and not in source order (D1661).
      const xfn = fnDeclIx[sm.letName] ?? -1
      if xfn >= 0 && !(moduleGlobals[sm.letName] ?? false) {
        let at = stmts[mi]
        if xfn > at { at = xfn }
        tErr("redeclared " + sm.letName, at)
        modClashNames[sm.letName] = true
      }
      if moduleGlobals[sm.letName] ?? false {
        // A genuine top-level redeclaration — reported here (pass 2 skips its own
        // redeclare check for module globals, since the hoist owns the declaration).
        tErr("redeclared " + sm.letName, stmts[mi])
      } else {
        let mty = TY_ERR
        if sm.letType >= 0 {
          const mtn = P.nodes[sm.letType]
          if mtn is TypeRef {
            const r = nameToTyAt(mtn.tyName, sm.letType)
            if r >= 0 { mty = r }
          }
        } else if sm.letInit >= 0 {
          // Un-annotated: peeks only at a literal initializer (side-effect free). A `checkNode`
          // here would prematurely demand-infer callees and patch their hoisted return types,
          // corrupting the real pass-2 result, so a non-literal init stays an error placeholder
          // that pass 2 overwrites with its real type.
          const initN = P.nodes[sm.letInit]
          if initN is NumLit {
            if numLexIsFloat(initN.numText) { mty = TY_F64 }
            else if numLexFitsI32(initN.numText) { mty = TY_I32 }
            else { mty = TY_I64 }
          } else if initN is StrLit {
            mty = TY_STR
            if sm.letKw == "const" {
              mty = mkWideStrLitTy(initN.strText, TY_STR)
            }
          } else if initN is CharLit {
            mty = TY_I32
          } else if initN is BoolLit {
            mty = TY_BOOL
          }
        }
        declare(sm.letName, mty)
        if sm.letKw == "const" { moduleConstDecl[sm.letName] = stmts[mi] }
        if mty == TY_ERR && sm.letType < 0 && sm.letInit >= 0 {
          phLets.push(stmts[mi])
        }
        if letDeclIsUnannotObjLit(stmts[mi]) {
          markObjLitBinding(sm.letName, 0)
        }
        if letDeclIsUnannotCtnLit(stmts[mi]) {
          markCtnLitBinding(sm.letName, 0, sm.letInit)
        }
        markNumLitBinding(sm.letName, 0, stmts[mi])
        let lbiTy0 = mty
        if sm.letType < 0 && sm.letInit >= 0 {
          const lit0 = lbiInitLit(sm.letInit)
          if lit0 >= 0 { lbiTy0 = lbiLitDefault(lit0) }
        }
        lbiMark(sm.letName, 0, stmts[mi], lbiTy0)
        markFnLitBinding(sm.letName, 0, stmts[mi])
        moduleGlobals[sm.letName] = true
        if sm.letKw == "const" && sm.letInit >= 0 {
          const cin = P.nodes[parenPeelIx(sm.letInit)]
          if cin is NumLit {
            if !numLexIsFloat(cin.numText) {
              moduleConstIntInitSetAt(sm.letName, parenPeelIx(sm.letInit))
            }
          }
        }
        // TDZ: in the dead-zone until pass 2 reaches the initializer.
        daAdd(sm.letName)
        moduleBeforeDecl[sm.letName] = stmts[mi]
      }
    }
    mi = mi + 1
  }
  // Pass 1.6: solve every un-annotated PARAMETER from its body's usage, BEFORE any
  // expression is checked — so a call site binds the solved parameter type whatever
  // the source order, and before pass 1.7 infers returns against it. See
  // `solvedParamTys`.
  let sp = 0
  while sp < stmts.length {
    const sps = P.nodes[stmts[sp]]
    if sps is FuncDecl { solveUnannotParams(stmts[sp]) }
    sp = sp + 1
  }
  globalInitPrePass(phLets)
  // Pass 1.7: return-inference pre-pass — resolve every un-annotated return (cycles
  // included, via the binding-group fixpoint) BEFORE checking bodies, so pass 2 sees
  // final return types and a recursive function needs no return annotation.
  inferReturnsPrePass()
  // Pass 1.9: the generic bodies pass 2 walks for their constraints (`cstrProbeBefore`).
  cstrPrePass(stmts)
  // Pass 2: check every top-level statement (bodies included).
  let j = 0
  while j < stmts.length {
    cstrProbeBefore(stmts[j])
    markValDiscard(stmts[j])
    crStmtEnter(stmts[j])
    checkNode(stmts[j])
    crStmtLeave()
    j = j + 1
  }
  // A function whose return never resolved (a genuinely base-case-less recursive
  // cycle) — the fixpoint found no concrete basis. Reported here, after the real
  // pass (the pre-pass suppressed it).
  let uf = 0
  while uf < unresolvedFns.length {
    const ufIx = fnDeclIx[unresolvedFns[uf]] ?? -1
    if ufIx >= 0 {
      const ufn = P.nodes[ufIx]
      if ufn is FuncDecl {
        inferNoBasisErr(unresolvedFns[uf], ufIx, ufn.fnBody)
      }
    }
    uf = uf + 1
  }
  bareBraceUndelivered()
  // LAST, because both of its filters read state this pass fills — see its header.
  annCommitVariantMembers()
  TY_VOID
}

// ── bare `{}` (D2223) ───────────────────────────────────────────────────────
// `{}` is the record literal with every field omitted, so it needs an expected record type
// whose fields all admit `null`. Deliveries mark it (`bareBraceDeliver`); what no delivery
// reached is refused after the last body is checked.

// Mark every bare `{}` that `srcExpr` delivers into `dstTy`, following parentheses, the
// fallback of `??`, list elements, record fields and the value tails of `if` / `match`. True
// only when it reported a refusal, or when `srcExpr` itself (`direct`, parentheses aside) is
// a `{}` it completed as a union member; every enclosing value is left to the ordinary check.
function bareBraceDeliver(
  srcExpr: i32,
  dstTy: i32,
  depth: i32,
  direct: boolean,
): boolean {
  if srcExpr < 0 || srcExpr >= P.nodes.length || depth <= 0 { return false }
  const e = P.nodes[srcExpr]
  if e is Paren {
    return bareBraceDeliver(e.parInner, dstTy, depth - 1, direct)
  }
  if e is BinExpr {
    if e.binOp == "??" {
      return bareBraceDeliver(e.binRight, dstTy, depth - 1, false)
    }
    return false
  }
  if e is Block {
    if e.blkStmts.length == 0 { return false }
    const last = e.blkStmts[e.blkStmts.length - 1]
    return bareBraceDeliver(last, dstTy, depth - 1, false)
  }
  if e is IfStmt {
    const a = bareBraceDeliver(e.ifThen, dstTy, depth - 1, false)
    const b = bareBraceDeliver(e.ifElse, dstTy, depth - 1, false)
    return a || b
  }
  if e is MatchExpr {
    let any = false
    let m = 0
    while m < e.matchBodies.length {
      if bareBraceDeliver(e.matchBodies[m], dstTy, depth - 1, false) {
        any = true
      }
      m = m + 1
    }
    return any
  }
  if e is ArrayLit { return bareBraceDeliverElems(e.arrElems, dstTy, depth) }
  if !(e is ObjLit) { return false }
  if e.objFields.length != 0 {
    bareBraceDeliverFields(e.objFields, dstTy, depth)
    return false
  }
  if i32ListHas(stmtBraceNodes, srcExpr) {
    // A block's last `{}` whose value is delivered is refused naming the `({})` spelling.
    if !i32ListHas(stmtBraceTails, srcExpr) || bareBraceSpec > 0 {
      return false
    }
    while bareBraceMark.length <= srcExpr { bareBraceMark.push(0) }
    bareBraceMark[srcExpr] = 1
    if inferQuiet { return false }
    tErr(
      "a `{}` here is an empty block; to produce an empty record write `({})`",
      srcExpr,
    )
    return true
  }
  if bareBraceHoleDst(dstTy) { return false }
  while bareBraceMark.length <= srcExpr { bareBraceMark.push(0) }
  bareBraceMark[srcExpr] = 1
  if inferQuiet { return false }
  const rec = bareBraceRecordOf(dstTy)
  if rec >= 0 {
    // The emitter builds the literal as this record, since no row has zero fields: its
    // recorded type, not only its rep, names the record every reader then resolves.
    recordRepTyAdopt(srcExpr, rec, 6)
    while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
    nodeTySet(srcExpr, rec)
    // Into a union the chosen member is the answer: the first whose fields all admit `null`,
    // the order the literal-to-union adoption below tries members in. A speculative trial of
    // one member only records; the outer delivery decides.
    if bareBraceSpec > 0 || !direct { return false }
    return rec != dstTy && bareBraceMembers(dstTy).length > 1
  }
  if bareBraceSpec > 0 { return false }
  const msg = bareBraceRequiredMsg(dstTy)
  if msg == "" { return false }
  bareBraceCountSet(bareBraceCount + 1)
  tErr(msg, srcExpr)
  true
}

// `bareBraceDeliver` over a list literal's elements, against the element type of `dstTy`.
function bareBraceDeliverElems(elems: i32[], dstTy: i32, depth: i32): boolean {
  if dstTy < 0 { return false }
  let at = dstTy
  const an = T.tys[at]
  if an is TyNullable { at = an.nInner }
  if at < 0 { return false }
  const aa = T.tys[at]
  if !(aa is TyArray) { return false }
  let any = false
  let k = 0
  while k < elems.length {
    if bareBraceDeliver(elems[k], aa.aElem, depth - 1, false) { any = true }
    k = k + 1
  }
  any
}

// Marks the `{}` values among a record literal's fields against the field types the record
// members of `dstTy` declare, reporting nothing: the literal's own check judges the fields,
// and a mark only records that a record type is expected there.
function bareBraceDeliverFields(fields: i32[], dstTy: i32, depth: i32) {
  const ms = bareBraceMembers(dstTy)
  bareBraceSpecSet(bareBraceSpec + 1)
  let k = 0
  while k < fields.length {
    const f = P.nodes[fields[k]]
    if f is FieldInit {
      let i = 0
      let done = false
      while i < ms.length && !done {
        const mo = T.tys[ms[i]]
        if mo is TyObj {
          let j = 0
          while j < mo.objFieldNames.length && !done {
            if mo.objFieldNames[j] == f.fiName {
              bareBraceDeliver(f.fiValue, mo.objFieldTypes[j], depth - 1, false)
              done = true
            }
            j = j + 1
          }
        }
        i = i + 1
      }
    }
    k = k + 1
  }
  bareBraceSpecSet(bareBraceSpec - 1)
  0
}

// Refuse every value-position `{}` no delivery gave a record type to complete, unless another
// diagnostic already stands on that literal.
function bareBraceUndelivered() {
  let i = 0
  while i < bareBraceLits.length {
    const ix = bareBraceLits[i]
    let marked = ix < bareBraceMark.length && bareBraceMark[ix] == 1
    let d = 0
    while d < T.diags.length && !marked {
      if T.diags[d].tat == ix { marked = true }
      d = d + 1
    }
    if !marked {
      if i32ListHas(stmtBraceTails, ix) {
        tErr("an empty block does nothing; remove it", ix)
      } else {
        tErr(
          "`{}` has no record type here to complete — give its destination a record type "
            + "whose fields admit `null`, or write its fields",
          ix,
        )
      }
    }
    i = i + 1
  }
  0
}

// —— the Node visitor (dispatch; per-kind helpers above take narrowed variants) ——
// Thin recording wrapper around `checkNodeReal`: on the real (non-quiet) pass, stores each
// node's resolved type-arena index into the typed-IR table. Recording the arena index, not a
// snapshot, means a hole pinned later in place is reflected when the emitter reads it back — last write wins.
export function checkNode(ix: i32) {
  const savedTail = retTailPos
  if retTailPos {
    if !tailSpineNode(ix) {
      if P.nodes[ix] is MatchExpr { matchTailNodeSet(ix) }
      retTailPosSet(false)
    }
  }
  const t = checkNodeReal(ix)
  if expObsFn >= 0 { expObsRead(ix, t) }
  checkNodeDone(ix, t, savedTail)
  t
}

// `checkNode`'s exit bookkeeping, shared with `checkIfStmtNode`'s walk of an `else if` chain.
function checkNodeDone(ix: i32, t: i32, savedTail: boolean) {
  retTailPosSet(savedTail)
  if joinClashMsg != "" {
    if !inferQuiet && ix >= 0 { tErr(joinClashMsg, ix) }
    joinClashMsgSet("")
  }
  // A call typed `never` ends its path; marked on every pass, since narrowing asks during inference too.
  if t == TY_NEVER && t >= 0 {
    if P.nodes[ix] is Call { markCallNever(ix) }
  }
  if !inferQuiet {
    if ix >= 0 {
      // A widening literal is recorded as its base: the emitter lowers the value as the
      // `string` it is stored as, and asks `nodeWideStrLitText` where the literal matters.
      const wt = widenLitTy(t)
      if ix < nodeTyIx.length { nodeTySet(ix, wt) }
      if wt != t { noteWideLitNode(ix, t) }
      noteInferJoin(ix, wt)
    }
    if v128Seen { v128NestCheck(ix, t) }
    noteNestCstr(t, ix)
  }
  if tpIfCmpOn { tpIfCmpNode(ix, t) }
  0
}

// A v128 vector lives in locals, parameters, returns and globals, and boxed as a nullable or
// union member; a container holding one bare — an array element, a struct field, a map key or
// value — has no lowering yet, so the first node typed with one is refused here, before emission.
function v128NestCheck(ix: i32, t: i32) {
  if ix < 0 || t < 0 { return 0 }
  if !tyNestsV128(t, 8) { return 0 }
  let i = 0
  while i < v128NestReported.length {
    if v128NestReported[i] == t { return 0 }
    i = i + 1
  }
  v128NestReported.push(t)
  tErrUnsupported(v128NestMsg(t), ix)
  0
}

// Re-asks every recorded `is` test this call resolves to a nullable record operand, with the
// annotated spelling's refusal when the tested record is not its record: that operand carries
// no tag, so the test reads the layout and can answer true for the wrong record.
function validateIsCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
) {
  const nOrig = isCstr.ty.length
  let ci = 0
  while ci < nOrig {
    if cstrOwnedBy(isCstr.fn[ci], calleeFn) && !nestCstrOutside(isCstr.ix[ci]) {
      const ct = substTyDeep(isCstr.ty[ci], bNames, bTys)
      if tyHasHole(ct) {
        if calleeFn >= 0 && ct != isCstr.ty[ci] {
          noteIsCstr(ct, isCstr.chk[ci], isCstr.name[ci], isCstr.ix[ci])
        }
      } else if ct >= 0 {
        const t = T.tys[ct]
        let base = -1
        if t is TyUnion { base = ct }
        if t is TyNullable { base = t.nInner }
        const chk = isCstr.chk[ci]
        const bad = base >= 0
          && (!assignable(chk, base) || isWidenNotVariant(chk, base))
        if bad && t is TyNullable && tyHasObjMember(base) {
          let pWho = "a parameter is tested here: "
          if who != "" { pWho = "`" + who + "` tests its parameter here: " }
          tErr(
            pWho
              + "`is` check type '"
              + isCstr.name[ci]
              + "' is not a variant of "
              + tyToStr(ct),
            ix,
          )
          return 0
        }
      }
    }
    ci = ci + 1
  }
  0
}

// Re-asks every recorded container this call instantiates under its bindings. Skipped unless
// a binding is (or holds) a vector, so a pin that binds no vector does no work.
function validateNestCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
) {
  let anyVec = false
  let bi = 0
  while bi < bTys.length {
    if tyIsOrNestsV128(bTys[bi], 8) { anyVec = true }
    bi = bi + 1
  }
  if !anyVec { return 0 }
  const nOrig = nestCstr.ty.length
  let ci = 0
  while ci < nOrig {
    if (
      cstrOwnedBy(nestCstr.fn[ci], calleeFn)
      && !nestCstrOutside(nestCstr.ix[ci])
    ) {
      const ct = substTyDeep(nestCstr.ty[ci], bNames, bTys)
      if tyHasHole(ct) {
        if calleeFn >= 0 && ct != nestCstr.ty[ci] {
          noteNestCstr(ct, nestCstr.ix[ci])
        }
      } else if tyNestsV128(ct, 8) {
        let pWho = "a type parameter is stored in a container here: "
        if who != "" {
          pWho = "`" + who + "` stores its type parameter in a container here: "
        }
        tErrUnsupported(pWho + v128NestMsg(ct), ix)
        return 0
      } else if tyBoxesV128(ct, 8) {
        // A generic body's `T | null` or union has no instance at a vector yet (D2634).
        let bWho = "a type parameter"
        if who != "" { bWho = "`" + who + "`'s type parameter" }
        tErrUnsupported(
          tyToStr(ct)
            + " boxes "
            + bWho
            + " bound to a 128-bit vector, which a generic body has no lowering for yet — write the `v128 | null` spelling outside the generic function",
          ix,
        )
        return 0
      }
    }
    ci = ci + 1
  }
  0
}

// Dispatches every node kind — expressions and statements — and returns the node's
// type-arena index (statements yield `TY_VOID`). Every per-variant body is inlined here,
// including the nested `TypeRef`/`Param`/`Block` narrowing, since no other function may
// narrow `Node`. On a type error it raises a diagnostic and returns `TY_ERR` so checking continues.
function checkNodeReal(ix: i32) {
  if ix < 0 { return TY_ERR }
  if symEnabled != 0 && lbiInlinedName.length > 0 { lbiSymRead(ix) }
  const n = P.nodes[ix]

  // ── literals & identifiers ────────────────────────────────────────────────
  if n is NumLit {
    // A literal with a "." is f64. An integer literal defaults to the NARROWEST
    // type that holds it exactly — i32 if its magnitude fits, else i64 — the
    // host's `defaultIntegerType` rule (`numLexFitsI32`).
    if numLexIsFloat(n.numText) {
      // A literal whose magnitude rounds past the largest finite double names a value f64
      // cannot represent — and VL has no infinity spelling to encode it honestly, so it is an
      // error (a silent ±inf would be a lossy implicit conversion). Runtime arithmetic still
      // yields ±inf per IEEE-754; this rejects only literal text.
      if f64LitOverflows(n.numText) { tErr("float literal overflows f64", ix) }
      return TY_F64
    }
    // A radix literal that adopted a 64-bit destination keeps that width across re-checks; one
    // wider than 64 bits has no destination at all, and says so here rather than wrapping.
    if n.numText.length >= 19 { cexNoteWideLit(ix, n.numText) }
    if litWide64Of(ix) { return TY_I64 }
    const ltt = litTreeTyOf(ix)
    if ltt >= 0 { return ltt }
    if numLexRadixBits(n.numText) > 64 {
      if !cexIsDerived(ix) { tErr(radixLitTooWideMsg(n.numText, 64), ix) }
      return TY_I64
    }
    if numLexFitsI32(n.numText) { return TY_I32 }
    return TY_I64
  } else if n is StrLit {
    return TY_STR
  } else if n is CharLit {
    // A char literal `'x'` is its i32 code point (composes with arithmetic / `==` /
    // string indexing exactly like a bare int literal), not a string.
    return TY_I32
  } else if n is BoolLit {
    return TY_BOOL
  } else if n is NullLit {
    return TY_NULL
  } else if n is Ident {
    // A marked parameter default resolves in the declaration's scope — for the one name form
    // v1 admits, the module frame. Checked once at the declaration and again at every call
    // site that omits the argument; the second reading is why the mark exists, so a
    // caller-local binding sharing the const's name cannot capture the substituted reference.
    if isDefaultGlobalRef(ix) {
      // A literal `const` is its literal here too, taken at the parameter's type.
      const dlit = lbiModLit[n.identName] ?? -1
      if dlit >= 0 {
        lbiInlineLit(ix, dlit, n.pos, n.identName)
        return checkNodeReal(ix)
      }
      identNoteModuleUse(ix, n.identName)
      if T.scopes.length > 0 {
        if T.scopes[0].has(n.identName) {
          return T.scopes[0][n.identName] ?? TY_ERR
        }
      }
      return TY_ERR
    }
    // A literal `const` has no single type: each read is its literal, typed by where it stands.
    const lit = lbiConstLitAt(ix, n.identName)
    if lit >= 0 {
      lbiInlineLit(ix, lit, n.pos, n.identName)
      return checkNodeReal(ix)
    }
    const ty = lookup(n.identName)
    // A module name declared as both a function and a value is refused as redeclared; which
    // of the two a read means is unknowable, so the read is that error's cascade.
    if lookupDepth(n.identName) == 0 && (modClashNames[n.identName] ?? false) {
      return TY_ERR
    }
    // Only a read at an extern's own type can name one, so the name lookup is asked of those alone.
    if ty >= extFnTyMin && ty < extFnTy.length && !extValueSeen {
      if extFnTy[ty] && ix != ckCalleeIx {
        if externLinkOf(n.identName) >= 0 { extValueSeenSet(true) }
      }
    }
    if ty < 0 {
      // `__callsite__` is legal — as a parameter default value, and nowhere else.
      // Reaching the undeclared-identifier floor means it appears in an expression, so
      // say which position it belongs in rather than that the name does not exist
      // (it does; `checkParamDefaults` accepts it).
      if n.identName == CALLSITE_NAME {
        tErr(
          "`__callsite__` is legal only as a parameter default value — write `caller: { file: string, line: i32, col: i32 } = __callsite__`",
          ix,
        )
        return TY_ERR
      }
      // The interpolation renderer's floor: `$tpl$render` is minted by the parser and
      // rewritten to the merged `toString$mN` by `modBuildRename`, so reaching here means
      // `std:fmt` never entered the module graph. Named, since the generic
      // undeclared-identifier message would point at a name the author cannot have written.
      if n.identName == TPL_RENDER_LOCAL {
        tErr(
          "internal: an interpolation hole's renderer was not merged — `std:fmt` is missing from this program's module graph",
          ix,
        )
        return TY_ERR
      }
      const moved = stdFmtMovedNote(n.identName)
      if moved == "" && undeclaredImportRaise(n.identName, ix) { return TY_ERR }
      tErr(
        "undeclared identifier '"
          + n.identName
          + "'"
          + moved
          + arrayCtorCallNote(n.identName, ix),
        ix,
      )
      return TY_ERR
    }
    // `ty` is this use's type as the checker resolved it — narrowed when the use
    // sits inside a guarded arm. Threaded in so the occurrence retains it.
    identNoteUse(ix, n.identName)
    if symEnabled != 0 { symUse(ix, n.identName, ty) }
    if ovSetMod.length > 0 && ix != ckCalleeIx {
      ovNoteFnValue(ix, n.identName, ty)
    }
    if ix != daWriteTarget {
      if crCapLossAny { crNoteLostName(n.identName, ix) }
      const crr = crReadHook(n.identName, ix)
      if crr >= 0 { return crr }
    }
    // Definite-assignment read gate: a bare-name read of a still-unassigned binding is "used
    // before assigned". The LHS of a plain `=` is a write, not a read (the `BinExpr` `=` arm
    // marks it `daWriteTarget` before evaluating the target), so it is skipped here; a
    // compound `x += …` desugars to `x = x + (…)`, whose RHS read does reach this gate.
    if ix != daWriteTarget { daCheckRead(n.identName, ix) }
    if lbiBindName.length > 0 && ix != daWriteTarget {
      lbiNoteRead(ix, n.identName)
    }
    // A top-level function read as a value keeps its declared parameters (D3992).
    if ix != ckCalleeIx && lookupDepth(n.identName) == 0 {
      if fnDeclIx.has(n.identName) { wsValueRead[n.identName] = true }
    }
    return ty
  } else if n is Paren {
    return checkNode(n.parInner)
    // ── explicit numeric cast `x as T` ──────────────────────────────────────────
  } else if n is AsExpr {
    return checkCastNode(n, ix)
    // ── unary ─────────────────────────────────────────────────────────────────
  } else if n is Unary {
    if n.unOp == "-" || n.unOp == "~" {
      const uf = cexTryFold(ix)
      if uf == 1 { return checkNodeReal(ix) }
      if uf == 2 { return TY_ERR }
      if n.unOp == "-" { cexNoteNegOperand(n.unArg) }
    }
    return checkUnaryNode(n, ix)
  } else if n is BinExpr {
    if n.binCompound.length == 0 && cexOp(n.binOp) {
      const bf = cexTryFoldBin(n, ix)
      if bf == 1 { return checkNodeReal(ix) }
      if bf == 2 { return TY_ERR }
    }
    const bt = checkBinExprNode(n, ix)
    if neKeys.length > 0 && n.binOp == "=" { neAssigned(n, curFnDeclIx) }
    return bt
  } else if n is Call {
    // Named arguments run in parameter order, so no fact may reach a pop among them (D3558).
    if neKeys.length > 0 && crIsNamedCall(ix) { neKill("", curFnDeclIx) }
    const callTy = checkCallNode(n, ix)
    if numUnionMinted { njNoteHeldCall(n, ix, callTy) }
    // A call is where a path narrowing can be falsified by a write the guarded
    // scope never spells. Asked after the arguments are checked so the call's own
    // operands still read under the narrowing that holds at their own evaluation.
    noteCallInvalidations(ix)
    return callTy
    // ── member access ───────────────────────────────────────────────────────────
  } else if n is Member {
    return checkMemberNode(n, ix)
  } else if n is ArrayLit {
    return checkArrayLitNode(n, ix)
  } else if n is Spread {
    // A spread the call and list-literal paths both declined — nothing here can unpack it.
    // The operand is still checked, so an error inside it is reported rather than swallowed.
    checkNode(n.spdArg)
    tErr(spreadNoRestMsg(""), ix)
    return TY_ERR
  } else if n is Index {
    return checkIndexNode(n, ix)
  } else if n is ObjLit {
    return checkObjLitNode(n, ix)
  } else if n is IsExpr {
    return checkIsExprNode(n, ix)
  } else if n is OptMember {
    return checkOptMemberNode(n, ix)
  } else if n is ErrExpr {
    return TY_ERR
    // ── let / const ─────────────────────────────────────────────────────────────
  } else if n is LetDecl {
    const lr = checkLetDeclNodeIn(n, ix)
    if neKeys.length > 0 { neKill(n.letName, curFnDeclIx) }
    if lpOn || exitFirstAt.length > 0 { noteExitFirstLet(n, ix) }
    return lr
  } else if n is FuncDecl {
    return checkFuncDeclNode(n, ix)
    // ── while ─────────────────────────────────────────────────────────────────
  } else if n is WhileStmt {
    // A loop re-runs what a fact proved once (D3558), and so does a for loop below.
    if neKeys.length > 0 { neKill("", curFnDeclIx) }
    return checkWhileStmtNode(n, ix)
    // A `break` joins its value into the loop or block it leaves; a misplaced one is the
    // parser's and the emitter's to report.
  } else if n is BreakStmt {
    return checkBreakNode(n, ix)
  } else if n is ContinueStmt {
    return TY_VOID
    // ── for v in A to B [step S] ────────────────────────────────────────────────
    // A numeric range loop: the bounds (and step, if present) must be i32; the loop
    // variable is i32 in the body's scope.
  } else if n is ForRange {
    if neKeys.length > 0 { neKill("", curFnDeclIx) }
    return checkForRangeNode(n, ix)
  } else if n is ForIn {
    if neKeys.length > 0 { neKill("", curFnDeclIx) }
    return checkForInNode(n, ix)
  } else if n is MatchExpr {
    return checkMatchExprNode(n, ix)
  } else if n is IfStmt {
    return checkIfStmtNode(ix)
  } else if n is RetStmt {
    return checkRetStmtNode(n, ix)
  } else if n is Block {
    return checkBlockNode(n, ix)
  } else if n is Program {
    return checkProgramNode(n)
  } else if n is Param {
    return TY_VOID
  } else if n is TypeRef {
    return TY_VOID
  } else if n is TypeDecl {
    // Registered by the Program pass-0 pre-pass; nothing to do when visited.
    return TY_VOID
  } else if n is UnionDecl {
    // Registered by the Program pass-0 pre-pass; nothing to do when visited.
    return TY_VOID
  } else if n is ImportDecl {
    // A tooling node (the lint tier reads it): import binding/resolution
    // happened in the module front end (the driver's token-level `modScan` +
    // merge), so the checker has nothing to verify here.
    return TY_VOID
  }
  TY_ERR
}

// The declared type name whose shape structurally equals object type `obj`, found by
// scanning the program's `TypeDecl`s (`cUserTypes` is a `Map` the compiler subset cannot
// iterate). Structural equality is bidirectional assignability, so a 1-field `{meow}` does
// not match a 2-field `Cat = {meow, foo}`. "" if no named type matches.
export function nominalNameOfObj(obj: i32, stmts: i32[]) {
  const i = nominalDeclAtOfObj(obj, stmts, 0)
  if i < 0 { return "" }
  const s = P.nodes[stmts[i]]
  if s is TypeDecl { return s.tdName }
  ""
}

// The index in `stmts`, from `from` on, of the first `TypeDecl` whose shape structurally
// equals object type `obj`, or -1.
export function nominalDeclAtOfObj(obj: i32, stmts: i32[], from: i32): i32 {
  let i = from
  while i < stmts.length {
    const s = P.nodes[stmts[i]]
    if s is TypeDecl {
      const nmHit = cUserTypes[s.tdName]
      if nmHit is i32 {
        const ti = nmHit
        if ti >= 0 {
          const tt = T.tys[ti]
          if tt is TyObj {
            if assignable(obj, ti) && assignable(ti, obj) { return i }
          }
        }
      }
    }
    i = i + 1
  }
  -1
}

// The emitter-format name of an inferred struct-union return `er` — `Cat|Dog`, each member
// reverse-mapped (`nominalNameOfObj`) to its user-type name. The emitter's union machinery is
// keyed on these nominal names, not `tyToStr`'s structural render. "" unless `er` is an
// all-object union of two or more members that all resolve to a named type.
export function structUnionRetName(er: i32, stmts: i32[]) {
  if er < 0 { return "" }
  if !isStructUnionTy(er) { return "" }
  const t = T.tys[er]
  if t is TyUnion {
    const members = t.uMembers
    let name = ""
    let i = 0
    while i < members.length {
      const nm = nominalNameOfObj(members[i], stmts)
      if nm == "" { return "" }
      if i > 0 { name = name + "|" }
      name = name + nm
      i = i + 1
    }
    // Every member is a declared type name — one identifier, one atom — so the join width
    // is the member count (#1115).
    return irAtoms(name, members.length)
  }
  ""
}

// The emitter-format name of an inferred nullable-ref return `er` — `P | null` (the struct
// inner reverse-mapped to its user-type name) or `string | null`. `synthRetAnnots` pins a
// nullable-returning closure to this so its `$fnsig` result keys the nullable token and the
// value call's `ref.cast` resolves. "" unless `er` is a nullable whose inner the emitter lowers.
export function nullableRetName(er: i32, stmts: i32[]) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyNullable {
    if t.nInner < 0 || t.nInner >= T.tys.length { return "" }
    const it = T.tys[t.nInner]
    if it is TyObj {
      const nm = nominalNameOfObj(t.nInner, stmts)
      // Non-spaced (`P|null`) — the emitter's internal convention (`nullablePartOf`), not the
      // spaced `tyToStr` render. A declared name is one atom, `null` the second (#1115).
      if nm != "" { return irAtoms(nm + "|null", 2) }
      // An inline shape with no matching `TypeDecl` renders as emitter-format shape text, so
      // `structIndexOfTypeName` resolves it by field set to the struct index the annotation keys.
      const inm = tyToEmitName(t.nInner)
      // The enclosing `it is TyObj` arm already rules out a map, so testing whether the render
      // came back at all is enough — no need to re-parse it for shape-openness.
      if inm != "" {
        // The `{…}` shape's separators all sit inside the braces (the renderer reports
        // its own width); `null` adds one atom (#1115).
        return irAtoms(inm + "|null", tyNameAtoms + 1)
      }
    } else if it is TyFunc {
      // A nullable-closure return (kind 19): the fat-pointer made nullable, rendered
      // parenthesized and non-spaced so `nullablePartOf` recognizes it (`((i32)=>K0)|null`).
      let ips = ""
      const pts = it.fnParamTypes
      let pj = 0
      while pj < pts.length {
        const pn = tyToEmitName(pts[pj])
        if pn == "" { return "" }
        if pj > 0 { ips = ips + "," }
        ips = ips + pn
        pj = pj + 1
      }
      let irs = litUnionAliasNameOfTy(it.fnRet)
      if irs == "" { irs = tyToEmitName(it.fnRet) }
      // The grouped closure is one atom (its separators and its `=>` sit inside the parens);
      // `null` is the second (#1115).
      if irs != "" { return irAtoms("((" + ips + ")=>" + irs + ")|null", 2) }
    } else if tyIsNulI32BackedListInner(t.nInner) {
      // The nullable i32-backed list (kind 15) reps as the shared list wrapper made nullable;
      // rendered non-spaced so `nullablePartOf` and `synthRetAnnots`'s pin both recognize it.
      const lnm = tyToEmitName(t.nInner)
      return irAtoms(lnm + "|null", tyNameAtoms + 1)
    } else if it is TyMap {
      // The nullable map (kind 3 struct made nullable) admits any string-keyed non-`Set` map,
      // not just the mono i32-valued shape (D956) — resolved through `inferredRetMapSlot`.
      let mapOk = false
      if it.mSet == 0 { mapOk = tyIsPrimNamed(it.mKey, "string") }
      const mnm = tyToEmitName(t.nInner)
      if mapOk && mnm != "" { return irAtoms(mnm + "|null", tyNameAtoms + 1) }
    } else if tyIsPrimNamed(t.nInner, "string") {
      return irAtoms("string|null", 2)
    } else if tyIsPrimNamed(t.nInner, "boolean") {
      // The boolean niche (`boolean | null`): the i32 sentinel rep (2 = null), matching what
      // `emitReturnValue`'s `tyIsNulBool` arm expects for a `return null` / `return <bool>`.
      return irAtoms("boolean|null", 2)
    }
  }
  ""
}

// The emitter-format name of a nullable-closure-element list return `er` —
// `(((i32)=>K0)|null)[]`: a `TyArray` whose element is a nullable function type. Elements are
// the kind-5 niche over the shared closure fat-pointer, rendered through `nullableRetName`'s
// `TyFunc` arm so a litunion result keeps its alias. "" otherwise.
function nulClosureElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyNullable {
      if et.nInner < 0 || et.nInner >= T.tys.length { return "" }
      const it = T.tys[et.nInner]
      if it is TyFunc {
        const en = nullableRetName(t.aElem, gRootStmts)
        if en != "" { return irAtoms("(" + en + ")[]", 1) }
      }
    }
  }
  ""
}

// The emitter-format name of a struct-element list return `er` (`{f: f32}[]`) whose fields
// are all plainly lowerable (a scalar/string/boolean prim, or a litunion alias) — the shape
// the named-function spelling already round-trips, so a lambda may adopt it. A map/union/
// nullable/list/closure/nested-struct field is not this (those stay loud rejects). "" otherwise.
function structElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyObj {
      if !structElemFieldsPlain(t.aElem, 4) { return "" }
      return irRendered(tyToEmitName(er))
    }
  }
  ""
}

// The emitter-format name of a nullable-struct-element list return `er` —
// `({a: string, f: i32, z: boolean} | null)[]`: elements are the kind-1 struct niche, the
// same rep the annotated named-function-value spelling already lowers, so `synthRetAnnots`
// can pin a lambda to it. The nullable-struct sibling of `nulElemListRetName`. "" otherwise.
function nulStructElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyNullable {
      if et.nInner < 0 || et.nInner >= T.tys.length { return "" }
      const it = T.tys[et.nInner]
      if it is TyObj {
        // A boxed-union-field element isn't `structElemFieldsPlain`, but the annotated form
        // lowers it too — admit it when `structFieldBoxRetName` proves every field lowerable.
        if !structElemFieldsPlain(et.nInner, 4) {
          if structFieldBoxRetName(et.nInner) == "" { return "" }
        }
        return irRendered(tyToEmitName(er))
      }
    }
  }
  ""
}

// The emitter-format name of a nullable-scalar-list-element list return `er` —
// `(f64[] | null)[]`: elements are the inner list's wrapper kept nullable, the rep the
// annotated spelling already lowers, so `synthRetAnnots` can pin a lambda to it. A box-element
// inner list admits too (below); a nested or other composite-element inner list stays declined.
function nulListElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyNullable {
      if et.nInner < 0 || et.nInner >= T.tys.length { return "" }
      const it = T.tys[et.nInner]
      if it is TyArray {
        if it.aElem < 0 { return "" }
        const lt = T.tys[it.aElem]
        if lt is TyPrim { return irRendered(tyToEmitName(er)) }
        // A box-element inner list (`((i32|boolean)[] | null)[]`) rides the union box too — its
        // wrapper made nullable — so admit it the same way as the scalar-leaf arm above.
        if elemValueUnionListRetName(et.nInner) != "" {
          return irRendered(tyToEmitName(er))
        }
        if elemVariantBoxListRetName(et.nInner) != "" {
          return irRendered(tyToEmitName(er))
        }
      }
    }
  }
  ""
}

// The canonical emitter name for a plain struct inferred return (`{f: f32}`) whose fields
// all pass `structElemFieldsPlain` — the bare-struct sibling of `structElemListRetName`,
// feeding the recorder's `spfNm` canon record so `synthRetAnnots`'s whole-span-shape arm
// pins the lambda.
function structPlainRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if !(t is TyObj) { return "" }
  if !structElemFieldsPlain(er, 4) { return "" }
  irRendered(tyToEmitName(er))
}

// The field gate for `structElemListRetName`: every field is a scalar/string/boolean prim, a
// litunion alias, or (recursively) a nested plain struct. The nested-struct admission is
// load-bearing — an un-pinned lambda self-resolves each element by field-name set, and a
// same-fieldset twin type in scope can box the wrong row as invalid wasm without this gate.
function structElemFieldsPlain(objTy: i32, depth: i32): boolean {
  if depth <= 0 { return false }
  const et = T.tys[objTy]
  if !(et is TyObj) { return false }
  let i = 0
  while i < et.objFieldTypes.length {
    const fty = et.objFieldTypes[i]
    if fty < 0 { return false }
    const ft = T.tys[fty]
    let ok = false
    if ft is TyPrim { ok = true }
    if tyIsLitUnion(fty) { ok = true }
    if ft is TyObj {
      if structElemFieldsPlain(fty, depth - 1) { ok = true }
    }
    // A map field admits when its value is emit-representable — the annotated form lowers a
    // string-keyed map field, and un-admitted the whole struct loses the canon record.
    if ft is TyMap {
      if tyIsEmitRepresentable(fty) { ok = true }
    }
    // A closure field admits the same way (emit-representable), for the same reason: without
    // it, a sibling composite field on an un-pinned struct can mis-code as invalid wasm.
    if ft is TyFunc {
      if tyIsEmitRepresentable(fty) { ok = true }
    }
    if ft is TyArray {
      // A plain-struct-element list field (`f: {...}[]`) admits recursively, using the same
      // annotated-form argument as the outer element — checked only after `feIx >= 0`.
      const feIx = tyArrayElemIx(fty)
      if feIx >= 0 {
        const aet = T.tys[feIx]
        if aet is TyPrim { ok = true }
        if !ok {
          if tyIsLitUnion(feIx) { ok = true }
          if aet is TyObj {
            if structElemFieldsPlain(feIx, depth - 1) { ok = true }
          }
          // A box-element-union list field (`f: (i64|string|{q:i64})[]`) rides the same union
          // box as a bare `(...)[]` return, so it admits through the same two predicates.
          if !ok {
            if elemValueUnionListRetName(fty) != "" { ok = true }
            if !ok && elemVariantBoxListRetName(fty) != "" { ok = true }
          }
          // A map-element list field admits when its value is emit-representable — the kind-3
          // map-element ref-list rep the annotated form already lowers.
          if !ok && aet is TyMap {
            if tyIsEmitRepresentable(ft.aElem) { ok = true }
          }
        }
      }
    }
    if !ok { return false }
    i = i + 1
  }
  true
}

// The emitter-format name of an inferred element-variant-box-union list return `er` —
// `({a:boolean,...}|i64)[]`: elements are `variantBoxUnionRetName`'s `{tag, payload}` boxes,
// the same rep the annotated form lowers, so `synthRetAnnots` can pin a lambda to it. The
// variant-box sibling of `elemValueUnionListRetName`. "" otherwise.
function elemVariantBoxListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const en = variantBoxUnionRetName(t.aElem)
    if en != "" { return irAtoms("(" + en + ")[]", 1) }
  }
  ""
}

// The emitter-format name of an inferred element-refarm-value-union list return `er` —
// `((i32|boolean)[] | i32)[]`: a union mixing a box-list-element array arm with scalar
// siblings, both boxed as `{tag, payload}` — the rep the annotated form lowers, so
// `synthRetAnnots` can pin a lambda to it. The array-arm sibling of `elemValueUnionListRetName`.
function elemRefArmValueUnionListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if !(t is TyArray) { return "" }
  if t.aElem < 0 { return "" }
  const et = T.tys[t.aElem]
  if !(et is TyUnion) { return "" }
  const members = et.uMembers
  if members.length < 2 { return "" }
  let hasArr = false
  let mi = 0
  while mi < members.length {
    const m = T.tys[members[mi]]
    if m is TyArray {
      // The array arm must itself render as a box-list element (a value union, or a
      // variant-box union) — a niche or map/closure element is not this family.
      const eln = tyToEmitName(m.aElem)
      if eln == "" { return "" }
      if !isValueUnionName(eln) && variantBoxUnionRetName(m.aElem) == "" {
        return ""
      }
      hasArr = true
    } else if m is TyPrim {
      // A scalar-prim sibling boxes as a value atom (`i32`) — fine.
    } else {
      // A struct / map / closure / nested-array sibling widens the family beyond the sound
      // annotated box; decline so those stay on their established routes.
      return ""
    }
    mi = mi + 1
  }
  if !hasArr { return "" }
  irRendered(tyToEmitName(er))
}

// The emitter-format name of an inferred nested (2-D+) union-element array return `er` —
// `(i64 | boolean)[][]`: an array whose innermost 1-D leaf is a recognized box-element list
// (value-union / variant-box / map-union). Elements bottom out at the same `{tag, payload}`
// box the annotated form lowers, so `synthRetAnnots` can pin a lambda to it.
function nestedElemUnionListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if !(t is TyArray) { return "" }
  if t.aElem < 0 { return "" }
  const inner = T.tys[t.aElem]
  if !(inner is TyArray) { return "" }
  // Peel to the innermost (leaf) 1-D array.
  let leafArr = t.aElem
  let done = false
  while !done {
    const la = T.tys[leafArr]
    if la is TyArray {
      if la.aElem < 0 { return "" }
      const le = T.tys[la.aElem]
      if le is TyArray { leafArr = la.aElem } else { done = true }
    } else {
      done = true
    }
  }
  if (
    elemValueUnionListRetName(leafArr) != ""
    || elemVariantBoxListRetName(leafArr) != ""
    || elemMapUnionListRetName(leafArr) != ""
  ) {
    return irRendered(tyToEmitName(er))
  }
  ""
}

// The emitter-format name of a ref-arm value union `er` (`T[] | {w: i32}`): a union with at
// least one ref-array member and every member an object shape or an array of object shapes.
// Members render nominally when a declared type matches, else structurally. One renderer
// feeds `collectU`, `synthRetAnnots` and `nodeUnionName`, so all three byte-match.
export function refArmUnionRetName(er: i32, stmts: i32[]) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyUnion {
    const members = t.uMembers
    if members.length < 2 { return "" }
    // Structural pre-gate before any render (#494): every member an object or an
    // array-of-object, at least one array.
    let hasList = false
    // Non-null count, because `TY_NULL` is a `TyPrim` and the scalar-sibling arm below admits
    // one — see the `>= 2` gate after the loop.
    let rauNonNull = 0
    let gi = 0
    while gi < members.length {
      const m = T.tys[members[gi]]
      // The non-null count, taken before the shape arms so it cannot narrow `m` out from under
      // the `!(m is TyPrim)` scalar-sibling arm below.
      if !tyIsPrimNamed(members[gi], "null") { rauNonNull = rauNonNull + 1 }
      if m is TyArray {
        // The hole declines with every other non-object element (`tyArrayElemIx`): an
        // unresolved array element carries `aElem == -1`, an out-of-bounds `array.get`.
        const meIx = tyArrayElemIx(members[gi])
        if meIx < 0 { return "" }
        const et = T.tys[meIx]
        if !(et is TyObj) { return "" }
        hasList = true
      } else if !(m is TyObj) && !(m is TyPrim) {
        // A scalar sibling (`{f: string}[] | f64`) rides the box as a value atom — the
        // annotated named-fn spelling lowers it; anything else here still declines.
        return ""
      }
      gi = gi + 1
    }
    if !hasList { return "" }
    // At least two non-null members: `S[] | null` (one real member) is not registrable —
    // `registerInlineUnion` diverts a `<refarray>|null` to its non-null part alone.
    if rauNonNull < 2 { return "" }
    let name = ""
    let i = 0
    while i < members.length {
      const m = T.tys[members[i]]
      let mn = ""
      if m is TyArray {
        let en = nominalNameOfObj(m.aElem, stmts)
        // An anonymous-shape element (`{f: string}[]`) renders canonically: the interner keys
        // the inline spelling, and the annotated form already lowers it.
        if en == "" { en = tyToEmitName(m.aElem) }
        if en == "" { return "" }
        mn = en + "[]"
      } else if m is TyPrim {
        mn = m.primName
      } else {
        mn = nominalNameOfObj(members[i], stmts)
        if mn == "" { mn = tyToEmitName(members[i]) }
        if mn == "" { return "" }
      }
      if i > 0 { name = name + "|" }
      name = name + mn
      i = i + 1
    }
    // Every member render is one atom — the pre-gate above admits only an array-of-object,
    // an object shape, or a scalar prim, each spelling its separators inside a grouper (#1115).
    return irAtoms(name, members.length)
  }
  ""
}

// The emitter-format name of a variant-box union `er` with an inline-struct arm and a
// scalar/string sibling (`i32 | {w: i32}`): every member an object shape or scalar/string
// prim, at least one object. `synthRetAnnots` pins a lambda's `fnRet` to this, routing it
// through the same `>u` box the annotated form interns. "" for a map/array/nullable member.
export function variantBoxUnionRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  // A nullable variant-box union normalizes to `TyNullable` over the union — the box already
  // carries a null member atom, so render the inner union and append `|null`.
  if t is TyNullable {
    const inner = variantBoxUnionRetName(t.nInner)
    // The inner union keeps its own top-level `|`s, so `null` adds one atom to the width
    // the recursion just reported (#1115).
    if inner != "" { return irAtoms(inner + "|null", inferRetNameAtoms + 1) }
    return ""
  }
  if t is TyUnion {
    const members = t.uMembers
    if members.length < 2 { return "" }
    // A litunion-alias member's literals flatten into sibling `TyLit` members, so no single
    // member names the alias — regroup them and resolve as one alias by exact member-set match.
    const litTexts: string[] = []
    let i0 = 0
    while i0 < members.length {
      const m0 = T.tys[members[i0]]
      if m0 is TyLit {
        if m0.litKind != "str" { return "" }
        litTexts.push(m0.litText)
      }
      i0 = i0 + 1
    }
    let litAlias = ""
    if litTexts.length > 0 {
      litAlias = litUnionAliasOfLitTexts(litTexts)
      if litAlias == "" { return "" }
    }
    let hasComposite = litAlias != ""
    let hasClo = false
    let hasObj = false
    let name = ""
    // The append count, not `members.length`: the litunion regroup below contracts a run of
    // `TyLit` members into one alias atom, so iteration count and atom count differ (#1115).
    let psum = 0
    let litDone = false
    let i = 0
    while i < members.length {
      const m = T.tys[members[i]]
      let mn = ""
      if m is TyLit {
        if litDone {
          i = i + 1
          continue
        }
        litDone = true
        mn = litAlias
      } else if m is TyFunc {
        // A closure arm beside a struct arm rides the box anyref as the kind-11 ref atom — at
        // most one closure arm; a struct sibling routes it through this same sound box.
        if hasClo { return "" }
        const cn = tyToEmitName(members[i])
        if cn == "" { return "" }
        mn = "(" + cn + ")"
        hasClo = true
        hasComposite = true
      } else {
        mn = vbUnionMemberName(members[i])
        if mn == "" { return "" }
        // A bare `null` member declines here on purpose — the `TyNullable` arm above owns
        // null and appends it itself; un-excluded this would render a false two-atom niche.
        if mn == "null" { return "" }
        if m is TyObj { hasObj = true }
        if mn != "i32" && mn != "i64" && mn != "f64" && mn != "f32" {
          if mn != "boolean" && mn != "string" { hasComposite = true }
        }
      }
      if name != "" { name = name + "|" }
      name = name + mn
      psum = psum + 1
      i = i + 1
    }
    // One atom is not a union: a pure literal union contracts to a single alias atom here,
    // which is the i32-atom rep, not this box — `psum` (post-contraction) catches it.
    if psum < 2 { return "" }
    if hasClo && !hasObj { return "" }
    if !hasComposite { return "" }
    return irAtoms(name, psum)
  }
  ""
}

// One member's render for `variantBoxUnionRetName`: a scalar/string prim by name, a
// litunion alias by its alias token (not `tyToEmitName`'s softened `string`), and an object
// shape field-wise. "" for a map/array/closure/nullable/inline-litunion member — those stay
// on their own paths.
function vbUnionMemberName(mIx: i32): string {
  const alias = litUnionAliasNameOfTy(mIx)
  if alias != "" { return alias }
  const m = T.tys[mIx]
  if m is TyPrim { return m.primName }
  // A scalar-leaf array member (`i64[] | boolean`) rides the box as a plain wrapper ref, the
  // same rep the annotated form lowers fully — an object-element array member stays declined.
  if m is TyArray {
    let leaf = m.aElem
    let vguard = 0
    let scalarLeaf = false
    while vguard < 8 {
      vguard = vguard + 1
      if leaf < 0 { break }
      const lt = T.tys[leaf]
      if lt is TyArray {
        leaf = lt.aElem
      } else {
        let leafPrim = leaf
        // A nullable-scalar element leaf (`(i64 | null)[]`) admits too — the annotated
        // named-fn spelling of such a union lowers fully, both arms round-tripping.
        if lt is TyNullable { leafPrim = lt.nInner }
        const lp = T.tys[leafPrim]
        if lp is TyPrim {
          const pn = lp.primName
          if (
            pn == "i32"
            || pn == "i64"
            || pn == "f64"
            || pn == "f32"
            || pn == "boolean"
            || pn == "string"
          ) {
            scalarLeaf = true
          }
        }
        break
      }
    }
    if scalarLeaf {
      const en = tyToEmitName(mIx)
      if en != "" { return en }
    }
    return ""
  }
  if m is TyObj {
    // A nominal struct arm renders its declared type name so the registered variant matches
    // the annotation; falls through to the inline field-wise render when no type matches.
    const nom = nominalNameOfObj(mIx, gRootStmts)
    if nom != "" { return nom }
    const names = m.objFieldNames
    const ftys = m.objFieldTypes
    let out = "{"
    let fi = 0
    while fi < names.length {
      let fs = litUnionAliasNameOfTy(ftys[fi])
      if fs == "" {
        const ft = T.tys[ftys[fi]]
        // Exhaustive over `Ty`, deliberately without a `_` arm: a new arena variant must break
        // the self-compile here rather than silently decline the whole union arm.
        match ft {
          TyPrim => {
            fs = ft.primName
          }
          TyMap => {
            // A map field renders canonically (`tyToEmitName`): the annotated spelling of a
            // union carrying such an arm lowers fully, so the pin routes through the same path.
            fs = tyToEmitName(ftys[fi])
            if fs == "" { return "" }
          }
          TyObj => {
            // A nested-struct field (code 15) admits the same way — the annotated spelling
            // lowers it, and un-admitted the whole arm would leave the lambda un-pinned.
            fs = tyToEmitName(ftys[fi])
            if fs == "" { return "" }
          }
          TyNullable => {
            // A nullable field admits the same way: every nullable spelling the annotation
            // grammar allows has a field code, and the annotated union lowers it fully.
            fs = tyToEmitName(ftys[fi])
            if fs == "" { return "" }
          }
          TyArray => {
            // A list field admits the same way — the annotated spelling lowers it, and
            // un-admitted the whole arm would leave the lambda un-pinned to a raw scalar.
            fs = tyToEmitName(ftys[fi])
            if fs == "" { return "" }
          }
          TyFunc => {
            // A closure field admits the same way, rendered as the bare arrow — a field
            // position carries no trailing `|` ambiguity, since fields split at commas.
            fs = tyToEmitName(ftys[fi])
            if fs == "" { return "" }
          }
          TyUnion => {
            // A value-union field admits the same way: `tyToEmitName` preserves member order
            // and litunion aliases, with the inner `|` brace-scoped like the nullable arm's.
            fs = tyToEmitName(ftys[fi])
            if fs == "" { return "" }
          }
          TyErr => {
            // The error/unknown hole has no field code — decline the whole arm.
            return ""
          }
          TyVar => {
            // An unsolved type parameter has no field code — decline the whole arm.
            return ""
          }
          TyLit => {
            // A bare `TyLit` field reached without its litunion alias (already claimed above)
            // has no field code — decline the whole arm.
            return ""
          }
          TyNeg => {
            // A residual negation has no field code — decline the whole arm.
            return ""
          }
        }
      }
      if fi > 0 { out = out + "," }
      out = out + names[fi] + ":" + fs
      fi = fi + 1
    }
    return out + "}"
  }
  ""
}

// The public entry point: checks the program rooted at node `rootIx`, returning the number
// of diagnostics raised (diagnostics also accumulate on `T.diags`).
// ── extern declarations ──────────────────────────────────────────────────────

// A20: the emitter reads this to classify an un-annotated function's return from its
// inferred type name rather than re-deriving from the return expression. Records an
// inferred-return entry: pushes the parallel arrays and the by-name map (first-wins).
// Every producer push goes through here so the map stays in sync.
export function recordInferRet(
  name: string,
  ty: string,
  tyIx: i32,
  atoms: i32,
  rung: i32,
) {
  // The reader half of D1645's rule: the map is keyed by NAME, and the empty name is
  // every anonymous lambda at once, so a row banked under it would answer for all of
  // them. An anonymous lambda has no name to record a return against — refuse the key.
  if name.length == 0 { return 0 }
  if !inferRetIdx.has(name) { inferRetIdx[name] = inferRetFn.length }
  inferRetFn.push(name)
  inferRetTy.push(ty)
  // Banks the recorded name's top-level atom count from `atoms` — the caller's own join
  // width, never re-scanned from the string (a litunion member is one atom, several in the arena).
  inferRetAtomCount.push(atoms)
  inferRetTyIx.push(tyIx)
  if rung == IR_RUNG_STRUCT_UNION || rung == IR_RUNG_VARIANT_BOX {
    inferRegisterNominalTwins(tyIx)
  }
  // An explicit parameter, not a global read: two gates sit between the cascade and this
  // call, either of which could leave a stale global armed for an unrelated next row.
  inferRetRung.push(rung)
  0
}

// Records `dstTy` for a delivery of `srcExpr` whose type `srcTy` is a union of maps and whose
// destination is one map, or that map's nullable: every member is assignable to it, so every
// member shares its storage. A list or record literal is walked to its elements and fields.
function recordMapUnbox(srcExpr: i32, srcTy: i32, dstIn: i32, depth: i32) {
  if srcExpr < 0 || srcTy < 0 || dstIn < 0 || depth <= 0 { return 0 }
  if srcTy >= T.tys.length || dstIn >= T.tys.length { return 0 }
  recordWidenRetagTails(srcExpr, dstIn)
  if tyWideUnionMinted { recordListWidenRetag(srcExpr, srcTy, dstIn) }
  const dstTy = nonNullTy(dstIn)
  if dstTy < 0 || dstTy >= T.tys.length { return 0 }
  const d = T.tys[dstTy]
  match d {
    TyArray => {
      const al = valueTailLeaves(srcExpr)
      let ai = 0
      while ai < al.length {
        mapUnboxListLit(al[ai], d.aElem, depth)
        ai = ai + 1
      }
      return 0
    }
    TyObj => {
      const ol = valueTailLeaves(srcExpr)
      let oi = 0
      while oi < ol.length {
        mapUnboxRecordLit(ol[oi], d.objFieldNames, d.objFieldTypes, depth)
        oi = oi + 1
      }
      return 0
    }
    TyMap => {
      if !tyAllMaps(srcTy) { return 0 }
      while mapUnboxTyIx.length <= srcExpr { mapUnboxTyIx.push(-1) }
      mapUnboxTyIx[srcExpr] = dstTy
      mapDeliveryRecordedSet(true)
      return 0
    }
    TyUnion => {
      return recordMapRetagTails(srcExpr, dstTy, depth)
    }
    // No other destination holds a map a union of maps can be delivered as.
    TyPrim | TyErr | TyFunc | TyVar | TyLit | TyNeg | TyNullable => {
      return 0
    }
  }
}

// `recordMapRetag` at each value a delivery into the union `dstTy` hands over: every tail of a
// value `if`, `match` or block, and the left operand of a `??`, each at its own type.
function recordMapRetagTails(srcExpr: i32, dstTy: i32, depth: i32) {
  if !tyHasMapMember(dstTy, 8) { return 0 }
  const spine: i32[] = []
  const leaves: i32[] = []
  valueTailSplit(srcExpr, spine, leaves)
  let i = 0
  while i < leaves.length {
    const lf = leaves[i]
    const n = P.nodes[lf]
    if n is BinExpr && n.binOp == "??" && depth > 0 {
      recordMapRetagTails(n.binLeft, dstTy, depth - 1)
      recordMapRetagTails(n.binRight, dstTy, depth - 1)
    } else {
      recordMapRetag(lf, nodeTyIxOf(lf), dstTy)
    }
    i = i + 1
  }
  0
}

// Records, for a union `srcTy` delivered into the union `dstTy`, each map member the
// destination lacks beside the destination member it is assignable to: a box built under the
// source member must carry that member's tag in the destination (`mapRetagRowsOf`).
function recordMapRetag(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if srcExpr < 0 || srcTy < 0 || srcTy >= T.tys.length { return 0 }
  // A box is a union of two or more non-null members, `| null` or not; one member is a niche.
  const sm: i32[] = []
  unionLeavesInto(srcTy, sm, 8)
  if sm.length < 2 { return 0 }
  const dm: i32[] = []
  unionLeavesInto(dstTy, dm, 8)
  const start = mapRetagFromTy.length
  let i = 0
  while i < sm.length {
    const a = sm[i]
    if T.tys[a] is TyMap && !tyAmong(a, dm) {
      let j = 0
      let found = false
      while j < dm.length && !found {
        if T.tys[dm[j]] is TyMap && assignable(a, dm[j]) {
          mapRetagFromTy.push(a)
          mapRetagToTy.push(dm[j])
          found = true
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  if mapRetagFromTy.length > start {
    mapDeliveryRecordedSet(true)
    mapRetagAt.set(srcExpr, start)
    mapRetagN.set(srcExpr, mapRetagFromTy.length - start)
  }
  0
}

// `recordMapUnbox` over each element of a list literal `srcExpr` delivered as `elemTy[]`.
function mapUnboxListLit(srcExpr: i32, elemTy: i32, depth: i32) {
  const e = P.nodes[srcExpr]
  if e is ArrayLit {
    let i = 0
    while i < e.arrElems.length {
      const el = e.arrElems[i]
      recordMapUnbox(el, nodeTyIxOf(el), elemTy, depth - 1)
      i = i + 1
    }
  }
  0
}

// `recordMapUnbox` over each field of a record literal `srcExpr` delivered as the record whose
// field names and types are `names` and `tys`.
function mapUnboxRecordLit(
  srcExpr: i32,
  names: string[],
  tys: i32[],
  depth: i32,
) {
  const e = P.nodes[srcExpr]
  if e is ObjLit {
    let k = 0
    while k < e.objFields.length {
      const f = P.nodes[e.objFields[k]]
      if f is FieldInit {
        let j = 0
        while j < names.length {
          if names[j] == f.fiName {
            recordMapUnbox(f.fiValue, nodeTyIxOf(f.fiValue), tys[j], depth - 1)
          }
          j = j + 1
        }
      }
      k = k + 1
    }
  }
  0
}

// Stamps the context (destination) type `dstTy` onto a literal source `srcExpr` (recursively,
// into `ObjLit` fields / `ArrayLit` elements) into the `nodeRepTyIx` sidecar, at arena-pure
// adoption sites — reads only `T.tys`/`P.nodes`, writes only `nodeRepTyIx`. Nullable wrappers
// are peeled; a destination deeper than 16 declines, to avoid unbounded recursion.
function recordRepTyAdopt(srcExpr: i32, dstTy: i32, depth: i32) {
  if inferQuiet || srcExpr < 0 || dstTy < 0 || depth <= 0 { return 0 }
  if tyDeeperThan(dstTy, 16) { return 0 }
  let dtix = dstTy
  let peel = true
  while peel {
    const dN = T.tys[dtix]
    if dN is TyNullable {
      if dN.nInner < 0 { return 0 }
      dtix = dN.nInner
    } else {
      peel = false
    }
  }
  const d = T.tys[dtix]
  const e = P.nodes[srcExpr]
  if e is Paren {
    recordRepTyAdopt(e.parInner, dtix, depth)
    while nodeRepTyIx.length <= srcExpr { nodeRepTyIx.push(-1) }
    nodeRepTyIx[srcExpr] = dtix
    return 1
  }
  if e is ObjLit {
    if d is TyObj {
      const dfn = d.objFieldNames
      const dft = d.objFieldTypes
      let k = 0
      while k < e.objFields.length {
        const f = P.nodes[e.objFields[k]]
        if f is FieldInit {
          let j = 0
          while j < dfn.length {
            if dfn[j] == f.fiName {
              recordRepTyAdopt(f.fiValue, dft[j], depth - 1)
            }
            j = j + 1
          }
        }
        k = k + 1
      }
      while nodeRepTyIx.length <= srcExpr { nodeRepTyIx.push(-1) }
      nodeRepTyIx[srcExpr] = dtix
      return 1
    }
    // An `ObjLit` whose destination is a union: recurse against the first member whose
    // field-name set corresponds and that the literal's own type fits, else the first whose
    // names correspond — arms may share every field name and differ in a field's type.
    if d is TyUnion {
      const am = objLitUnionArm(e, nodeTyIxOf(srcExpr), d.uMembers)
      if am >= 0 { return recordRepTyAdopt(srcExpr, am, depth) }
      return 0
    }
    return 0
  }
  if e is ArrayLit {
    if d is TyArray {
      let i = 0
      while i < e.arrElems.length {
        recordRepTyAdopt(e.arrElems[i], d.aElem, depth - 1)
        i = i + 1
      }
      while nodeRepTyIx.length <= srcExpr { nodeRepTyIx.push(-1) }
      nodeRepTyIx[srcExpr] = dtix
      return 1
    }
    // An array literal boxed into a union arm — recurse against the first array member.
    if d is TyUnion {
      const members = d.uMembers
      let mi = 0
      while mi < members.length {
        const mt = T.tys[members[mi]]
        if mt is TyArray {
          return recordRepTyAdopt(srcExpr, members[mi], depth)
        }
        mi = mi + 1
      }
      return 0
    }
    return 0
  }
  0
}
// The member of `members` an object literal `e` of checked type `srcTy` is stored as: the
// first record whose field names correspond and that `srcTy` is assignable to, else the first
// whose names correspond, else -1. A literal adopted as a member that leaves out a nullable
// field is that member, even though its written names do not correspond (D4601).
function objLitUnionArm(e: ObjLit, srcTy: i32, members: i32[]): i32 {
  if srcTy >= 0 && srcTy < T.tys.length {
    const st = T.tys[srcTy]
    if st is TyObj && st.objFieldNames.length > e.objFields.length {
      for m in members {
        if m == srcTy { return srcTy }
      }
    }
  }
  let first = -1
  let mi = 0
  while mi < members.length {
    const m = members[mi]
    if m >= 0 && m < T.tys.length {
      const mt = T.tys[m]
      if mt is TyObj {
        if objLitFieldsCorrespond(e, mt) {
          if srcTy >= 0 && srcTy < T.tys.length && assignable(srcTy, m) {
            return m
          }
          if first < 0 { first = m }
        }
      }
    }
    mi = mi + 1
  }
  first
}

// Refuses an inferred return that carries a body-scoped nominal type. Called from the two
// sites that witness a pending function's result (the explicit `return` and the trailing
// expression), so the diagnostic lands on the return. A declared return is untouched — writing
// `: Id` is the author saying they meant it.
function refuseLocalNomEscape(t: i32, at: i32) {
  if t < 0 { return 0 }
  const nm = localNomEscapeAt(t, 0)
  if nm == "" { return 0 }
  tErr(
    "return type `"
      + nm
      + "` is declared inside `"
      + demangleName(curFnEscName)
      + "` and no caller can name it; annotate the return or move `"
      + nm
      + "` to module scope",
    at,
  )
  0
}
// —— dense membership over the `Ty`-arena index sets ————————————————————————
// Each nominal-identity sidecar set is membership-tested through a parallel `boolean[]`
// indexed by the arena index itself, since the emitter probes membership on nearly every
// typed node. Some sets are also iterated in order — write only through `cTyIxSetAdd`.

// Whether a null test of a value typed `ty` is dead: no member admits `null`, one a recursive
// alias hides included, which `assignable` sees and the member walk does not.
export function tyProvesNonNull(ty: i32): boolean {
  tyExcludesNull(ty) && !assignable(TY_NULL, ty)
}

// The pinned re-check itself, in one home, opened and closed around the caller's read.
// `monoInferListElem`, `monoInferLocalScalar` and `monoInferRetExprTy` ask the same question,
// differing only in what they read back. Split into begin/end rather than a result selector
// because the read must happen inside the isolation, scope and suppression flags still active.
export function monoRecheckBegin(
  declIx: i32,
  paramTyIxs: i32[],
  tpNames: string[],
  tpTys: i32[],
): MonoSave | null {
  if declIx < 0 { return null }
  const dn = P.nodes[declIx]
  if !(dn is FuncDecl) { return null }
  const body = P.nodes[dn.fnBody]
  if !(body is Block) { return null }
  if prbArmed { prbEnter() }
  monoRecheckDepthSet(monoRecheckDepth + 1)
  const sv: MonoSave = { quiet: inferQuiet, sym: symEnabled, mark: checkMark() }
  inferQuiet = true
  symEnabled = 0
  njFnStack.push(njFnIx)
  njFnIxSet(declIx)
  // Binds the type parameters too, not only the value ones: `checkFuncDecl` keeps them in
  // scope as an opaque hole, so a body annotation naming one would otherwise stay a hole forever.
  let tpb = 0
  while tpb < tpNames.length {
    if tpb < tpTys.length {
      if tpTys[tpb] >= 0 {
        tpEnvNames.push(tpNames[tpb])
        tpEnvTys.push(tpTys[tpb])
      }
    }
    tpb = tpb + 1
  }
  // Checks the body statements directly in the pushed scope (not via `checkNode` on the
  // block), which would push/pop its own scope and drop the local before it can be read back.
  crFnEnter(declIx)
  pushScope(dn.fnBody)
  const params = dn.fnParams
  let pi = 0
  while pi < params.length {
    const p = P.nodes[params[pi]]
    if p is Param {
      let pty = TY_ERR
      if pi < paramTyIxs.length {
        if paramTyIxs[pi] >= 0 { pty = paramTyIxs[pi] }
      }
      declare(p.parName, pty)
    }
    pi = pi + 1
  }
  const stmts = body.blkStmts
  let s = 0
  while s < stmts.length {
    checkNode(stmts[s])
    s = s + 1
  }
  sv
}

// The closing half: pops the scope, rolls the `RB_MONO` families (the type-parameter bindings
// and the diagnostic stream among them) back to `sv`'s mark, then restores the flags — so the
// global checker state the emitter still reads matches its original values.
export function monoRecheckEnd(sv: MonoSave) {
  monoRecheckDepthSet(monoRecheckDepth - 1)
  njFnIxSet(njFnStack.pop() ?? -1)
  popScope()
  crFnLeave()
  checkRollback(sv.mark, RB_MONO)
  symEnabled = sv.sym
  inferQuiet = sv.quiet
  if prbArmed {
    if tpIfCmpOn {
      prbLeave("monoRecheck (in tpIfRecheck)")
    } else {
      prbLeave("monoRecheck")
    }
  }
  0
}

// —— value-union name classification (moved from wasmEmit to break the typecheck<->emitter
// import cycle) ——————————————————————————————————————————————————————————
// An inline union annotation's synthetic name (`"A|B"`) has no `unNames` entry the way a
// named alias does — register it as a union alias too, so the same tables/tags/lookups apply.

// The value-atom kind of a niche-nullable scalar-element list member name — `(K | null)[]`
// rides the i32-list backing (kind 7), `(boolean | null)[]` too under its own tag (kind 18),
// `(string | null)[]` the string-list backing (kind 9); -1 otherwise. Decided over `elem`'s member spans with no
// split and no per-member slice, mirroring the three arms of the splitting form it replaces.

// The one place a binary expression's type is handed out, so the one place the answer can be
// deferred to a pin. `ltOut` carries the left operand's type out rather than re-reading
// `nodeTyIx[n.binLeft]`: `checkNode` records a node type only when `!inferQuiet`, and a nested
// binary on the right could have overwritten a module-level slot before this returns.
function checkBinExprNode(n: BinExpr, ix: i32) {
  const ltOut: i32[] = []
  const bTy = checkBinExprNodeReal(n, ix, ltOut)
  if ltOut.length == 0 { return bTy }
  if n.binOp == "+" && !inferQuiet { plusLinkRecord(ix, ltOut[0]) }
  mkBinOpRetTy(n, bTy, ltOut[0])
}

// `a in b` outside a `for` head: refused, with the membership test the receiver `b` does have.
// Answers boolean, so the enclosing condition raises nothing further (DECISIONS.md §"`in` is a
// for-loop keyword, not an operator").
function checkInOpNode(n: BinExpr, ix: i32) {
  checkNode(n.binLeft)
  const rt = strLitRecvTy(checkNode(n.binRight))
  if rt >= 0 && rt < T.tys.length {
    const st = T.tys[nomErasedTyIx(rt)]
    if st is TyPrim {
      if st.primName == "string" {
        tErr(
          inOpHead() + "; to test for a substring, use `" + inStrFix(n) + "`",
          ix,
        )
        return TY_BOOL
      }
    }
  }
  tErr(inOpRefusal(rt), ix)
  TY_BOOL
}

// Extracted from `checkNodeReal`'s `BinExpr` arm (C3: thin the dispatcher).
function checkBinExprNodeReal(n: BinExpr, ix: i32, ltOut: i32[]) {
  const op = n.binOp
  if op == "in" { return checkInOpNode(n, ix) }
  // `a && b` / `a || b`: the left side's narrowings hold while checking the right (`&&`
  // narrows on true, `||` on false — the right is reached only in that branch).
  if op == "&&" || op == "||" {
    const clt = checkNode(n.binLeft)
    const cnames: string[] = []
    const ctys: i32[] = []
    if op == "&&" {
      collectThenNarrows(n.binLeft, cnames, ctys)
    } else {
      collectElseNarrows(n.binLeft, cnames, ctys)
    }
    let cpushed = 0
    const npBase = npKeys.length
    if cnames.length > 0 {
      pushScope(-1)
      applyNarrows(cnames, ctys)
      cpushed = 1
    }
    const crt = checkNode(n.binRight)
    if cpushed == 1 {
      crNoteRhsRetired(ix, n.binRight, cnames, ctys, npBase)
      popScope()
    }
    if !assignable(clt, TY_BOOL) || !assignable(crt, TY_BOOL) {
      tErr("operator '" + op + "' expects boolean operands", ix)
    }
    return TY_BOOL
  }
  // Definite-assignment: a plain `=` with a bare-name target is a pure write — flag it so
  // the `Ident` arm skips use-before-assign. A compound `x += ...` desugars, so its read isn't the target.
  const savedWriteTarget = daWriteTarget
  const savedGetWrite = getWriteTarget
  if op == "=" {
    const wtgt = P.nodes[n.binLeft]
    if wtgt is Ident { daWriteTarget = n.binLeft }
    if wtgt is Member { getWriteTargetSet(n.binLeft) }
    if wtgt is Index || wtgt is Member { luWriteTgtPut(n.binLeft, true) }
  }
  const savedLbiTgt = lbiWriteTgt
  if op == "=" { lbiWriteTgt = n.binLeft }
  let lt = checkNode(n.binLeft)
  daWriteTarget = savedWriteTarget
  getWriteTargetSet(savedGetWrite)
  // An unpinned intrinsic element answers with the default it will get (D1566), except under
  // `=`, whose Index case pins the element from the RHS instead — answering here would pre-empt that.
  if op != "=" {
    if lt < 0 {
      const peekL = arrDefOperandElemPeek(n.binLeft)
      if peekL >= 0 { lt = peekL }
    }
    // An operator reads a `const`'s literal as the `string` it is; the literal itself is
    // `nodeWideStrLitText`'s to answer, so no operator rule changes for it (D2157). A compare
    // decides once both sides are known (`eqKeepsWideLit`).
    if op != "==" && op != "!=" { lt = widenLitTy(lt) }
  }
  ltOut.push(lt)
  // Contextual typing for an assignment RHS: seed the LHS type so an un-annotated lambda
  // param infers from the target, matching let-init/arg/return seeding.
  if op == "=" { seedExpected(n.binRight, lt) }
  // Contextual typing for a `??` default: seed it with the LHS's non-null shape so an
  // un-annotated default-lambda param infers, mirroring the `=` seeding.
  if op == "??" { seedExpected(n.binRight, lt) }
  // Name the row an index store is about to pin, for the length of that store's value only, so a
  // read of the same place inside the value can pin the element rather than answer `TY_ERR`.
  const savedAsgRow = asgOpenElemRow
  asgOpenElemRowSet(-1)
  if op == "=" {
    asgOpenElemRowSet(asgOpenElemRowOf(n.binLeft))
    if tpEnvNames.length > 0 && P.nodes[n.binLeft] is Ident {
      tpIfMarkOk(n.binRight)
    }
  }
  const savedCmpdInner = nlCmpdInner
  const savedCmpdTgt = nlCmpdTgt
  if op == "=" && n.binCompound != "" {
    nlCmpdInner = parenPeelIx(n.binRight)
    nlCmpdTgt = n.binLeft
  }
  let rt = checkNode(n.binRight)
  lbiWriteTgt = savedLbiTgt
  nlCmpdInner = savedCmpdInner
  nlCmpdTgt = savedCmpdTgt
  asgOpenElemRowSet(savedAsgRow)
  lbiNoteOperands(n, ix)
  // The right operand takes the same answer, for the same reason: without it, an operator's
  // annotated face runs while the un-annotated one is check-clean invalid wasm (D1566).
  if op != "=" {
    if rt < 0 {
      const peekR = arrDefOperandElemPeek(n.binRight)
      if peekR >= 0 { rt = peekR }
    }
    if op == "==" || op == "!=" {
      if constLitNeverMeets(n.binLeft, lt, n.binRight, rt, op, ix) {
        return TY_BOOL
      }
      const keepL = eqKeepsWideLit(lt, rt)
      const keepR = eqKeepsWideLit(rt, lt)
      if !keepL {
        lt = widenLitTy(lt)
        ltOut[0] = lt
      }
      if !keepR { rt = widenLitTy(rt) }
    } else {
      rt = widenLitTy(rt)
    }
    // A store's value reading the place it writes: the value is what the program said the
    // element is, and the read has no answer of its own until this pins one.
    if lt < 0 {
      const asgPin = asgReadElemPin(n.binLeft, rt)
      if asgPin >= 0 {
        lt = asgPin
        ltOut[0] = asgPin // the out-column is the left operand's exact type, pin included
      }
    }
  }
  // The `??` default is the value produced when the LHS is null, so a `void` default leaves
  // nothing to produce — the other operators reject void through their own shape-demanding arms.
  if op == "??" {
    if voidValueSlotErr(rt, n.binRight, "`??` default", ix) { rt = TY_ERR }
    // The default's destination is the LHS's non-null shape — the one position where a typed
    // slot sits on the LEFT of the operator, which is why this needed its own pin (D1591).
    constrainEmptyExpr(n.binRight, rt, nonNullTy(lt))
    if lt >= 0 { lbiNoteCoalDefault(n.binRight, nonNullTy(lt)) }
  }
  // A radix literal operand takes the other side's width (the ruled literal rule). Assignment is
  // excluded: its destination is `assignableExpr`'s, which pins the narrowing direction too.
  if op != "=" && op != "&&" && op != "||" {
    if radixLitAdoptPeer64(n.binLeft, rt) == 1 { lt = TY_I64 }
    if radixLitAdoptPeer64(n.binRight, lt) == 1 { rt = TY_I64 }
    if lt == TY_I32 && rt == TY_I64 && op != "??" {
      const lpa = litTreeAdoptDst(n.binLeft, rt)
      if lpa >= 0 { lt = lpa }
    }
    if rt == TY_I32 && lt == TY_I64 {
      const rpa = litTreeAdoptDst(n.binRight, lt)
      if rpa >= 0 { rt = rpa }
    }
  }
  // A re-check pushes the node again; `checkShiftCounts` grades each once.
  if binShiftOp(op) && intLitLexemeOf(n.binRight) != "" {
    shiftCountNodes.push(ix)
  }
  // A binary op with a hole operand can't decide its form until the hole is bound at the call —
  // record the deferred constraint (skipping assignment / logical, handled by their own arms).
  if op != "=" && op != "&&" && op != "||" {
    if tyHasHole(lt) || tyHasHole(rt) {
      noteBinCstr(
        eqCstrOperandTy(op, n.binLeft, lt),
        op,
        eqCstrOperandTy(op, n.binRight, rt),
      )
      cexNoteHoleWidth(lt, rt)
      cexNoteHoleWidth(rt, lt)
    }
  }
  // Nominal newtype (P1.5): every non-assignment binary operator's operands must carry the
  // same brand — structural rules can't see it (`sameNumeric` compares `primName`, ordering skips `assignable`).
  if op != "=" && op != "&&" && op != "||" && op != "??" {
    if nomBinMixes(lt, rt, n.binLeft, n.binRight) {
      if op == "==" || op == "!=" {
        // A null test of a newtype over a base with no `null` is dead, as for any type.
        if isNullTy(rt) && tyProvesNonNull(lt) {
          recordDeadNullTest(ix, n.binLeft, lt, op)
          return TY_BOOL
        }
        if isNullTy(lt) && tyProvesNonNull(rt) {
          recordDeadNullTest(ix, n.binRight, rt, op)
          return TY_BOOL
        }
        tErr("cannot compare " + tyToStr(lt) + " and " + tyToStr(rt), ix)
        return TY_BOOL
      }
      tErr(
        "operator '" + op + "' mixes " + tyToStr(lt) + " and " + tyToStr(rt),
        ix,
      )
      return TY_ERR
    }
  }
  if (
    numUnionMinted
    && (tyIsNumUnion(lt) || tyIsNumUnion(rt))
    && numUnionOp(op)
    && !nullTestOp(op, lt, rt)
    && !njExprHeld(n.binLeft)
    && !njExprHeld(n.binRight)
  ) {
    if !(op == "+" && (concatsAsStr(lt) || concatsAsStr(rt))) {
      // Beside a type parameter the pairs are the pin's to check (`numUnionPinOk`).
      if tyHasTyVar(lt) || tyHasTyVar(rt) {
        noteBinCstr(lt, op, rt)
        if numCmpOp(op) { return TY_BOOL }
        if tyIsNumUnion(lt) { return lt }
        return rt
      }
      return numUnionBinTy(n, ix, lt, rt)
    }
  }
  // Assignment: RHS must be assignable to the LHS's (already-bound) type.
  if op == "=" {
    // A `const` name cannot be rebound (`x = ...`, and the `x++`/`x += ...`
    // desugarings). Data behind it stays mutable (a Member/Index target).
    const tgt = P.nodes[n.binLeft]
    if tgt is Member { sharedFieldWriteRefused(tgt, n.binRight, rt, ix) }
    if tgt is Ident {
      if isConstName(tgt.identName) {
        tErr("cannot reassign `const` " + tgt.identName, ix)
      }
      // A top-level write above the declaration would be overwritten by its initializer.
      if daLive.length > 0 && (moduleBeforeDecl[tgt.identName] ?? -1) >= 0 {
        if daIsUnassignedSid(sidOf(tgt.identName)) {
          tErr(
            "`" + tgt.identName + "` is written before its declaration",
            n.binLeft,
          )
        }
      }
      // This write makes the binding definitely assigned on the current path.
      daMarkAssigned(tgt.identName)
    }
    // An index-set into an empty `[]` pins its element type to `typeof v` in place —
    // usage-driven inference, clearing the uninferred floor.
    if tgt is Index {
      // The whole left-hand side is already checked as `lt` above — read the recorded type
      // instead of re-checking, so a diagnostic inside the receiver subtree isn't reported twice.
      let arrTy0 = nodeTyIxOf(tgt.idxArr)
      if arrTy0 < 0 { arrTy0 = checkNode(tgt.idxArr) }
      // An un-annotated-param hole receiver stands for its demanded map, so the map pin below
      // is the same arm the concrete receiver takes, not a second copy of it.
      const arrH0 = T.tys[arrTy0]
      if arrH0 is TyVar {
        // An index WRITE through a hole, filed like `xs.push(v)`: the read that typed the
        // receiver noted only that the body indexes it, which a view satisfies.
        noteArrayWriteDemand(arrH0.tvName)
        // The write's own deferred constraint, keyed to the ASSIGNMENT node so the pin can
        // BANK the `"[]="` operator there for the emitter — the read constraint the target
        // records only covers `"[]"`, and `p[4] = v` needs the setter (D1892). Vacuous when
        // the hole pins to a real array or map, which `validateMemCstrs` skips.
        if opIdxDeclared() { noteMemCstr(arrTy0, OP_INDEX_SET, ix, false) }
        const hmw = holeMapOf(arrH0.tvName)
        if hmw >= 0 { arrTy0 = hmw }
      }
      const arrT0 = T.tys[arrTy0]
      if arrT0 is TyArray {
        // An index write is a write to the list's own shape, so a view refuses it. Ahead of
        // the element pin below, which would otherwise infer a hole from a store that never
        // happens; reported and fallen through, so no cascade follows the one diagnostic.
        if arrT0.aRead == 1 { tErr(roWriteMsg("index assignment", arrTy0), ix) }
        if arrT0.aElem < 0 { calleeWritePrePin(arrTy0, rt) }
        if arrT0.aElem < 0 {
          arrT0.aElem = cnhPinTy(rt, ix, tgt.idxArr, false, false)
          tyMutEpoch = tyMutEpoch + 1 // index-write pinned the element in place
        } else {
          cnhFill(arrT0.aElem, rt)
        }
        // A `u8[]` store checks against the element type directly: `checkIndexNode` types a
        // `u8[]` read as `i32` (the widened value), so `lt` above can't see the out-of-range rule.
        if primNameOf(arrT0.aElem) == "u8" {
          assignableExpr(n.binRight, rt, arrT0.aElem)
        }
      }
      // An index-set into a bare `Map()` pins its key and value holes the same way `.set(k, v)`
      // does — the two write spellings of one program must infer identically.
      if arrT0 is TyMap {
        if arrT0.mKey < 0 {
          let kt0 = nodeTyIxOf(tgt.idxIndex)
          if kt0 < 0 { kt0 = checkNode(tgt.idxIndex) }
          if kt0 >= 0 {
            arrT0.mKey = widenLitTy(kt0)
            tyMutEpoch = tyMutEpoch + 1 // index-write pinned the key in place
            checkInferredMapKey(arrT0.mKey, arrT0.mSet, ix)
          }
        }
        if arrT0.mVal < 0 {
          const dmd = isHoleMapDemandTy(arrTy0)
          arrT0.mVal = cnhPinTy(rt, ix, tgt.idxArr, true, dmd)
          tyMutEpoch = tyMutEpoch + 1 // index-write pinned the value in place
        } else {
          cnhFill(arrT0.mVal, rt)
        }
      }
      // Free index-write operator (B14): banked on THIS assignment node, not the target —
      // the target keeps its read resolution, which `x[i] += v` needs (its desugaring re-reads it).
      if opIdxDeclared() {
        if !tyBuiltinIndexable(arrTy0) {
          const wfn = opIdxFnFor(OP_INDEX_SET, arrTy0)
          if wfn != "" {
            const wbNames: string[] = []
            const wbTys: i32[] = []
            opIdxBindGen(wfn, arrTy0, nodeTyIxOf(tgt.idxIndex), wbNames, wbTys)
            const vt0 = opIdxParamTy(wfn, 2)
            let vt = vt0
            if vt0 >= 0 {
              if wbNames.length > 0 { vt = substTyDeep(vt0, wbNames, wbTys) }
            }
            if vt >= 0 {
              if !assignableExpr(n.binRight, rt, vt) {
                tErr(
                  "index write: expected " + tyToStr(vt) + ", got " + tyToStr(rt),
                  ix,
                )
              }
            }
            opIdxBank(ix, wfn)
            noteCallInvalidations(ix)
            return rt
          }
          // A read operator with no write one: name the missing half, exactly as
          // the closure-field trap does below.
          const rOnly = opIdxFnFor(OP_INDEX_GET, arrTy0)
          if rOnly != "" {
            tErr(
              "no \""
                + OP_INDEX_SET
                + "\" operator for index assignment on "
                + tyToStr(arrTy0),
              ix,
            )
            return TY_ERR
          }
        }
      }
      // Index write trap (B13, host `indexTrap` "[]="): an object with only a read trap
      // rejects the write (the host's missing-method error).
      if arrT0 is TyObj {
        const wtrap = objFieldType(arrT0, "[]=")
        if wtrap >= 0 {
          const wt = T.tys[wtrap]
          if wt is TyFunc {
            if wt.fnParamTypes.length == 2 {
              if !assignableExpr(n.binRight, rt, wt.fnParamTypes[1]) {
                tErr(
                  "index write: expected "
                    + tyToStr(wt.fnParamTypes[1])
                    + ", got "
                    + tyToStr(rt),
                  ix,
                )
              }
              return rt
            }
          }
        } else if objFieldType(arrT0, "[]") >= 0 {
          tErr(
            "no \"[]=\" method for index assignment on " + tyToStr(arrTy0),
            ix,
          )
          return TY_ERR
        }
      }
    }
    // Narrowing applies to READS: a place accepts its storage type, never its current flow
    // (narrowed) type, so every write is checked against storage and may flip the variant (D1736).
    let asgLt = lt
    let asgBarred = false
    const asgDcl = writeStorageTy(n.binLeft)
    if asgDcl >= 0 {
      asgLt = asgDcl
    } else if elemValueHoleBase(lt) >= 0 {
      // An index write through a hole checks the element's STORAGE, so a `u8[]` pin still
      // refuses an out-of-range literal; the read type is the widened value (D2238).
      asgLt = mkDerivedHole(HD_ELEM, "", -1, -1, elemValueHoleBase(lt))
    } else {
      asgBarred = writeBarredByLoop(n.binLeft)
    }
    // A plain assignment pins the source's open holes, exactly as an annotated let-init, call
    // argument, or typed return already does — runs before `assignableExpr` so the pin applies first.
    constrainEmptyExpr(n.binRight, rt, asgLt)
    mapStoreValPin(n.binLeft, asgLt)
    noteU8StoreRhs(n.binLeft, n.binRight)
    nlAsgTgt = n.binLeft
    nlAsgGot = rt
    const asgFits = assignableExpr(n.binRight, rt, asgLt)
    nlAsgTgt = -1
    const asgOk = asgFits
      && !writeLeavesLoopEntry(n.binLeft, asgLitRhsTy(ix, asgLt, rt))
    lwStoreDstSet(-1)
    if !asgOk {
      if asgFits || asgBarred || (asgDcl >= 0 && writeBarredByLoop(n.binLeft)) {
        writeBarredErr(placeKeyOf(n.binLeft), ix)
      } else {
        nlAsgTgt = n.binLeft
        nlAsgGot = rt
        tErrWant(letAssignMsg(n.binRight, rt, asgLt, "", -1), n.binRight, asgLt)
        nlAsgTgt = -1
      }
    } else {
      // The same vacuous-gate check covers three write spellings (`r = e`, `b.v = e`,
      // `xs[0] = e`) — records the pair for the pin using `asgLt`, the storage type actually asked.
      noteLetCstr(coalPinTy(n.binRight, rt), asgLt, n.binRight, "")
      if P.nodes[n.binLeft] is Ident {
        wrDstDeclPut(n.binRight, identDeclOf(n.binLeft))
      }
      // And the slots of a literal source too: an array literal whose element join dropped a
      // hole reaches this gate hole-free, so the slots (not the pair) are the real question.
      if !tyHasHole(rt) {
        if !tyHasHole(asgLt) { noteLitElemCstrs(n.binRight, asgLt, 6) }
      }
    }
    // A-infer-null: a nullable binding's open inner hole fills from the first non-null
    // assignment in place; a straight-line non-null write narrows for the rest of the block.
    const asgTgt = P.nodes[n.binLeft]
    let asgPreTy = -1
    if asgTgt is Ident {
      if rt >= 0 && asgLt >= 0 && !tySame(asgLt, rt) {
        while asgStoreTys.length <= ix { asgStoreTysPush(-1) }
        asgStoreTysSetAt(ix, asgLt)
      } else if ix < asgStoreTys.length {
        // A re-check whose types now agree retires the earlier answer.
        asgStoreTysSetAt(ix, -1)
      }
      const asgCur = lookup(asgTgt.identName)
      // A re-check answers afresh (`asgStripTyOf`).
      asgPreTy = asgCur
      if ix < asgStripTys.length { asgStripTysSetAt(ix, -1) }
      if asgCur >= 0 {
        // A write to a hole binding ends the pin's jurisdiction over it: the call site pins the
        // parameter, this write replaces the value, so a cast after it is not the pin's to adjudicate (D1342).
        const asgHole = T.tys[asgCur]
        if asgHole is TyVar {
          noteCastClobber(asgHole.tvName + "." + asgTgt.identName)
        }
        const rtT = T.tys[rt]
        let rhsNullable = false
        if rtT is TyNullable { rhsNullable = true }
        const rhsNonNull = !rhsNullable && !isNullTy(rt) && rt >= 0
        const asgCt = T.tys[asgCur]
        if asgCt is TyNullable {
          if rhsNonNull {
            if asgCt.nInner < 0 {
              // D1589 — a read typed before the fill banked the hole itself: the fill
              // re-derives every such `??`, the moment its non-null part exists.
              nhFillLinked(asgCur, widenLitTy(rt))
            }
            // Bank the declared type before shadowing it — the narrowing itself is unchanged,
            // which is what the `let x: T | null = null` / `x = mk()` / `x.f` pattern rides.
            // Under a guard the write re-narrows from the declaration instead, below.
            if narGuardSlot(asgTgt.identName) < 0 {
              noteNarShadow(asgTgt.identName, asgCur, NAR_KIND_ASG)
              if tvPlaceWrite(asgCur, rt) {
                declare(asgTgt.identName, tvWriteTy(asgCur, rt, -1))
              } else {
                declare(asgTgt.identName, nonNullTy(asgCur))
                while asgStripTys.length <= ix { asgStripTysPush(-1) }
                asgStripTysSetAt(ix, nonNullTy(asgCur))
              }
            }
          } else if asgCt.nInner < 0 && rtT is TyNullable {
            // A nullable write fills the hole from its non-null part and narrows nothing: the
            // value may still be null, and an unfilled hole would type the binding `null` (D2597).
            if rtT.nInner >= 0 {
              nhFillLinked(asgCur, widenLitTy(rtT.nInner))
            } else {
              nhLink(asgCur, rt)
            }
          }
        }
      }
    }
    // The narrowing is a path fact, and a falsifying write ends the path — only an accepted
    // write retires it, since a rejected write did not happen and would cascade a second diagnostic.
    if asgOk { retireNarrowingsForWrite(n.binLeft, rt, ix, asgPreTy) }
    if asgOk { fsbNoteStore(n.binLeft, n.binRight, rt, ix) }
    // Assignment is an expression yielding its right-hand side (host parity;
    // DECISIONS: assignment-as-expression). A right side only the expression seam admits
    // (`[3.5, 4]` into `(i32 | f64)[]`) is built at the place's type, so it yields that (D2394).
    if asgOk && asgYieldsPlaceTy(n.binRight, rt, asgLt) { return asgLt }
    // A function value of a wider signature is stored as the adapter at the place's, and the
    // adapter is the value the expression yields, so it has the place's type (D3866).
    if asgOk && (fvaDone[parenPeelIx(n.binRight)] ?? false) { return asgLt }
    return rt
  }
  // An unpinned element hole is `-1`, and every arm below indexes `T.tys` with it — guarded
  // here, below both the `=` arm's own pin and the operand peek, rather than trapping (D1462).
  if lt < 0 { return TY_ERR }
  // Nullish coalescing peels the FULL nullability of the merged type (`nonNullTy`), not one
  // layer — a stored null in a nullable-valued map read is a double nullable, just like a miss.
  if op == "??" {
    // A `??` whose left operand can never be null has a dead default — recorded (a lint), not
    // rejected, since `emit_rewrite` folds it. A narrowed place is exempt: its storage still admits null.
    if tyExcludesNull(lt) {
      // A parked hole cast has no answer yet: `a as? i32` inside a hole's body types `i32`
      // until the call pins the operand, so a `??` over it looks dead here and is not (D1371).
      if !coalNarrowedPlace(n.binLeft) && !coalParkedHoleCast(n.binLeft) {
        recordDeadCoalesce(ix, lt)
      }
    }
    // A left operand that is only ever `null` always takes the default (D2261).
    if isNullTy(lt) { return rt }
    const lt2 = T.tys[lt]
    if lt2 is TyNullable {
      // D1589 — an open hole has no non-null part yet, so `nonNullTy` hands back the nullable
      // and the default's type is the safe answer: `fillCoalHoleNodes` re-derives it once the fill arrives.
      if lt2.nInner < 0 {
        if coalHoleDeferOk(rt) {
          noteCoalHole(ix, lt, rt)
          return rt
        }
      }
      const innerFull = nonNullTy(lt)
      // A literal default re-encodes at f32, so keep the result f32 — else `joinTys` widens
      // `f32 + f64`/`f32 + i32` and a downstream f32 slot rejects the demote.
      if primNameOf(innerFull) == "f32" && isF32AdoptingLitExpr(n.binRight) {
        return innerFull
      }
      // A litunion inner with a member-literal default stays the union (an i32 atom) — else
      // the bare literal types `string` and `joinTys` widens the result, divorcing it from the atom rep.
      if isLitBearing(innerFull) {
        const dl = litTyOfExpr(n.binRight)
        if dl >= 0 {
          if assignable(dl, innerFull) { return innerFull }
        }
        // An atom-valued map get's default must itself be an atom — a member literal or a
        // value of the same litunion; the method spelling `m.get(k) ?? d` is rejected here too.
        const mgRecv = fusedMapReadRecvIx(n.binLeft)
        if mgRecv >= 0 {
          if mapTyValIsLitUnion(nodeTyIxOf(mgRecv)) {
            if !assignable(rt, innerFull) {
              tErrUnsupported(
                "`??` over an atom-valued map needs a member-literal (or atom) default",
                ix,
              )
            }
          }
        }
      }
      if tyIsHole(rt) && !tyIsHole(innerFull) { coalDefNote(ix, innerFull, rt) }
      // A runtime default of another number type joins apart, as the `if` it spells does.
      const apart = coalJoinApart(n.binLeft, innerFull, rt, n.binRight)
      if apart >= 0 { return apart }
      // A declared parameter takes any default inside its body and its pin need not, so the
      // operator joins as the `if` it spells and the default keeps its own type (D3580, D3619).
      if coalParamDefault(innerFull, rt) {
        return joinArmLit(innerFull, false, rt, armLit(rt, n.binRight))
      }
      // When the default fits the non-null LHS type (with contextual coercion), the `??` result
      // IS that LHS type, not `joinTys`' LUB — which would widen a litunion field to `string`.
      if assignableExpr(n.binRight, rt, innerFull) { return innerFull }
      return joinTys(innerFull, rt)
    }
    // A hole left operand defers the whole tail above to the pin (`HD_COAL`): answering `lt` kept
    // the null `??` removed (D1693). The default is kept unwidened, so a pin whose non-null face
    // is a literal union holding it answers that union rather than `string`.
    let cdDft = litTyOfExpr(n.binRight)
    if cdDft < 0 { cdDft = rt }
    const cd = mkDerivedHole(HD_COAL, "", cdDft, -1, lt)
    if cd >= 0 {
      noteCoalResultHole(cd)
      return cd
    }
    return lt
  }
  // Equality: result bool; requires mutual compatibility.
  if op == "==" || op == "!=" {
    noteCmpConstLit(n.binLeft)
    noteCmpConstLit(n.binRight)
    // A void operand leaves nothing to compare (a call to a `: void` function or extern).
    if voidValueSlotErr(lt, n.binLeft, "`" + op + "`", n.binLeft) {
      return TY_BOOL
    }
    if voidValueSlotErr(rt, n.binRight, "`" + op + "`", n.binRight) {
      return TY_BOOL
    }
    // A null test asks about the storage, not the flow-narrowed type — a narrowing does not
    // change storage, so `isAsgNarrowedName` exempts exactly the bindings an assignment narrowed.
    if isNullTy(lt) || isNullTy(rt) {
      if isAsgNarrowedName(n.binLeft) || isAsgNarrowedName(n.binRight) {
        return TY_BOOL
      }
      // A value proved non-null makes the test dead: a warning, and the emitter folds it.
      if isNullTy(rt) && !isNullTy(lt) && tyProvesNonNull(lt) {
        recordDeadNullTest(ix, n.binLeft, lt, op)
        return TY_BOOL
      }
      if isNullTy(lt) && !isNullTy(rt) && tyProvesNonNull(rt) {
        recordDeadNullTest(ix, n.binRight, rt, op)
        return TY_BOOL
      }
    }
    // Closed set (literal unions): comparing a literal-union place against a literal outside
    // its set can never be true — reject rather than compile an always-false test.
    if isLitBearing(lt) {
      const eqR = cmpLitTyOf(n.binRight)
      if eqR >= 0 {
        if !assignable(eqR, lt) {
          tErr(
            "cannot compare "
              + tyToStr(lt)
              + " with "
              + tyToStr(eqR)
              + " — not a member of the union",
            ix,
          )
        }
        // A member compare is always a valid discrimination (`v == 7` over `"x" | 7`) — the
        // mixed union's softened sides aren't mutually assignable, so it must not fall through.
        return TY_BOOL
      }
    } else if isLitBearing(rt) {
      const eqL = cmpLitTyOf(n.binLeft)
      if eqL >= 0 {
        if !assignable(eqL, rt) {
          tErr(
            "cannot compare "
              + tyToStr(eqL)
              + " with "
              + tyToStr(rt)
              + " — not a member of the union",
            ix,
          )
        }
        return TY_BOOL
      }
    }
    // A nominal newtype compared with a literal is compatible (`id == 0`) — the literal adopts
    // the brand, as in every other position; the genuine-mix reject already fired above.
    const nomEqLit = nomNameOfTy(lt) != nomNameOfTy(rt)
      && !nomBinMixes(lt, rt, n.binLeft, n.binRight)
    const eqMutual = assignable(lt, rt) || assignable(rt, lt) || nomEqLit
    if !eqMutual {
      tErr("cannot compare " + tyToStr(lt) + " with " + tyToStr(rt), ix)
    }
    // Both `==` gates share one home (`eqRefusals`): structural soundness (field-by-field
    // compare needs every component comparable) and emitter-capability (no compare core exists).
    const eqMsgs: string[] = []
    const eqChan: i32[] = []
    eqRefusals(op, lt, rt, eqMutual, eqMsgs, eqChan)
    let eqM = 0
    while eqM < eqMsgs.length {
      if eqChan[eqM] == 1 {
        tErrUnsupported(eqMsgs[eqM], ix)
      } else {
        tErr(eqMsgs[eqM], ix)
      }
      eqM = eqM + 1
    }
    if eqMsgs.length == 0 && !isNullTy(lt) && !isNullTy(rt) {
      let eqTy = lt
      let eqPath = eqListFieldPath(lt, [])
      if eqPath == "" {
        eqTy = rt
        eqPath = eqListFieldPath(rt, [])
      }
      if eqPath != "" { recordDeepRecordEq(ix, eqTy, eqPath, op) }
    }
    return TY_BOOL
  }
  // A gradual union operand is checked at its concrete members; the constraint noted above
  // re-checks the whole union at each pin.
  if op != "&&" && op != "||" {
    if T.tys[lt] is TyUnion {
      const glt = tpGradualView(lt)
      if glt >= 0 && glt < T.tys.length { lt = glt }
    }
    if rt >= 0 && rt < T.tys.length && T.tys[rt] is TyUnion {
      const grt = tpGradualView(rt)
      if grt >= 0 && grt < T.tys.length { rt = grt }
    }
  }
  // Operator dispatch on a struct (B13 + B14): a free `self`-function named for the operator
  // is checked first, then an operator closure field — equality/logicals/`=`/`??` already returned.
  if op != "&&" && op != "||" {
    const odsp = T.tys[lt]
    // A `new v128` brand has no arithmetic of the language's own, so it dispatches like an
    // object: its declaring module's operator is the only meaning `a + b` can have.
    if tyIsV128Brand(lt) {
      const vsf = opSelfFnTy(op, lt, rt, n.binRight, ix)
      if vsf >= 0 {
        opBinSiteTook(op, true)
        noteCallInvalidations(ix)
        return vsf
      }
    }
    if odsp is TyObj {
      const osf = opSelfFnTy(op, lt, rt, n.binRight, ix)
      if osf >= 0 {
        opBinSiteTook(op, true)
        noteCallInvalidations(ix)
        return osf
      }
      const ofld = objFieldType(odsp, op)
      if ofld >= 0 {
        const oft = T.tys[ofld]
        if oft is TyFunc {
          if oft.fnParamTypes.length == 1 {
            if !assignableExpr(n.binRight, rt, oft.fnParamTypes[0]) {
              tErr(
                "operator '"
                  + op
                  + "': expected "
                  + tyToStr(oft.fnParamTypes[0])
                  + ", got "
                  + tyToStr(rt),
                ix,
              )
            }
            crOpOpaque[ix] = true
            noteCallInvalidations(ix)
            return oft.fnRet
          }
        }
      }
    } else {
      // A hole on the LEFT never reached the operator table at all: the lookup above is gated
      // on the left operand ALREADY being an object, and it is `opSelfFnTy`'s own trailing
      // `assignableExpr` that seeds a hole on the RIGHT. Record the mirror flow so the
      // parameter solve binds it too — inert outside the solve, as `noteHoleFlow` is (D1891).
      if tyIsHole(lt) { noteHoleFlow(lt, opSelfParamTy(op), -1) }
      // The site's own decision, recorded (D491): a non-object left operand takes the
      // language's own lowering with no declaration consulted — recorded for the declaration side.
      opBinSiteTook(op, false)
    }
  }
  // Ordering comparison: result bool, requires matching numeric types. A literal/litunion
  // operand is its base scalar here (`0 | 1 | 2` compares as i32).
  if op == "<" || op == ">" || op == "<=" || op == ">=" {
    const olt = softenLitOpTy(lt)
    const ort = softenLitOpTy(rt)
    // String ordering: a lexicographic compare of two strings yields a bool.
    if isStringTy(olt) && isStringTy(ort) { return TY_BOOL }
    // One concrete string against a hole defers rather than forcing numeric — `noteBinCstr`
    // records the constraint and `validateBinCstrs` adjudicates it at the call, mirroring `+`'s deferral.
    if isStringTy(olt) && tyIsHole(ort) { return TY_BOOL }
    if tyIsHole(olt) && isStringTy(ort) { return TY_BOOL }
    // A hole operand reaching a numeric comparison is used numerically — record the demand.
    if !isNumeric(olt) || !isNumeric(ort) {
      tErr(
        "comparison expects numeric operands, got "
          + tyToStr(olt)
          + " and "
          + tyToStr(ort),
        ix,
      )
    } else if (
      !sameNumeric(olt, ort)
      && !mixesNumeric(olt, ort)
      && !cmpF32LitAdopts(n, olt, ort)
    ) {
      // Mixed numerics may be compared when one side widens to the other; the f32-with-a-literal
      // pair is admitted separately (`cmpF32LitAdopts`) so comparison agrees with arithmetic's `+`.
      tErr("comparison mixes " + tyToStr(olt) + " and " + tyToStr(ort), ix)
    }
    return TY_BOOL
  }
  // `+` also concatenates strings.
  if op == "+" {
    // String concat needs an operand that concatenates AS a string — a hole is permissively
    // assignable to string, so this defers a two-hole `a + b` to the call site (`substTyDeep`),
    // and a NUMERIC member set softens to its own base and falls to the arithmetic tail.
    if concatsAsStr(lt) || concatsAsStr(rt) {
      if assignable(lt, TY_STR) && assignable(rt, TY_STR) { return TY_STR }
      // A `new string` newtype concatenates (with a same-brand value or a literal) and keeps
      // the brand — otherwise it would be the one newtype whose values could never be joined.
      if nomNameOfTy(lt) != "" || nomNameOfTy(rt) != "" {
        if assignable(nomBaseTyIx(lt), TY_STR) {
          if assignable(nomBaseTyIx(rt), TY_STR) {
            if nomNameOfTy(lt) != "" { return lt }
            return rt
          }
        }
      }
    }
    // List concat `a + b` → a new `T[]` (collections-design §VL.4); the two
    // element types must agree (an empty `[]` adopts the other side's).
    const lta = T.tys[lt]
    if lta is TyArray {
      const rta = T.tys[rt]
      if rta is TyArray {
        constrainEmpty(rt, lt)
        constrainEmpty(lt, rt)
        // No emitter-capability gate here any more: one concat lowering exists per list rep
        // (`emitListConcatG`); any residue is an emitter fact caught loudly at the emit site (D721).
        if assignable(rt, lt) { return lt }
        if assignable(lt, rt) { return rt }
        tErr("cannot concat " + tyToStr(lt) + " and " + tyToStr(rt), ix)
        return TY_ERR
      }
    }
  }
  // Remaining arithmetic: numeric-only, both the same numeric type (no implicit i32<->f64).
  // A literal/all-literal-union operand softens to its base scalar first. The refusal below
  // renders the pair the user WROTE: softening is how the operand is checked, not what it is,
  // and a message naming the base leaves a member set looking like a contradiction (D1739).
  const ltWrote = lt
  const rtWrote = rt
  lt = softenLitOpTy(lt)
  rt = softenLitOpTy(rt)
  // A hole operand reaching arithmetic is used numerically — record the demand so the call-arg
  // check enforces a numeric (or operator-overloaded) argument (`isNumeric(TyVar)` passes below).
  if !isNumeric(lt) || !isNumeric(rt) {
    // Reached only after string-concat and array-concat are ruled out above, so this is a
    // genuine operand-type mismatch, not a claim that `+` is numeric-only.
    tErr(
      "operator '"
        + op
        + "' is not defined for "
        + tyToStr(ltWrote)
        + " and "
        + tyToStr(rtWrote),
      ix,
    )
    return TY_ERR
  }
  // Bitwise/shift are integer-only — a float has no bits to shift. `%` is not in this family
  // any more (D1586): float remainder now lowers exactly via the `__f64_rem__` intrinsic.
  if binIntOnlyOp(op) {
    if binFloatOperandPair(lt, rt) {
      tErr(
        "operator '"
          + op
          + "' is integer-only, got "
          + tyToStr(lt)
          + " and "
          + tyToStr(rt),
        ix,
      )
      return TY_ERR
    }
  }
  // A literal operand adopts the other side's f32 type (a literal re-encodes exactly at f32),
  // checked before the general mixed rule so `x + 1` stays f32 rather than widening to f64.
  if primNameOf(lt) == "f32" && f32AdoptingOperand(n.binRight, lt) { return lt }
  if primNameOf(rt) == "f32" && f32AdoptingOperand(n.binLeft, rt) { return rt }
  // The f64 twin, integer half only — a `.`-literal already types f64 and needs no arm. Without
  // it `fv + 9000000000` is the mixed-numeric refusal while the same literal ASSIGNED to an f64
  // is admitted, so the two faces of one grant would disagree (D1890).
  if primNameOf(lt) == "f64" && isExactF64IntLitExpr(n.binRight) {
    cexFloatUse(n.binRight)
    return lt
  }
  if primNameOf(rt) == "f64" && isExactF64IntLitExpr(n.binLeft) {
    cexFloatUse(n.binLeft)
    return rt
  }
  // A mixed-numeric op widens the narrower operand to the wider one (`i32 op i64` -> i64, ...),
  // done before the same-type check so a compatible mixed pair is accepted (B2).
  if mixesNumeric(lt, rt) { return widerNumeric(lt, rt) }
  if !sameNumeric(lt, rt) {
    // A compound assignment's operand the target's defaulted literal does not mix with.
    if ix == nlCmpdInner {
      nlAsgTgt = nlCmpdTgt
      nlAsgGot = rt
    }
    tErr(
      "operator '" + op + "' mixes " + tyToStr(lt) + " and " + tyToStr(rt),
      ix,
    )
    nlAsgTgt = -1
    return TY_ERR
  }
  return lt
}
// ── let declaration ────────────────────────────────────────────────────────

// The type an un-annotated binding takes from its initializer's `initTy`. A `const` bound to a
// string literal is that literal's type, so it compares in O(1) (owner ruling, D2157); the type
// is a widening one, so a `let` that copies it holds a `string` it may reassign.
function constStrLitBound(n: LetDecl, initTy: i32): i32 {
  if n.letInit < 0 { return initTy }
  if n.letKw == "const" {
    const iN = P.nodes[n.letInit]
    if iN is StrLit { return mkWideStrLitTy(iN.strText, initTy) }
    // `const Y = Z` is the same one literal, and a join of several (`if c { Z } else { W }`)
    // keeps its literal set, as the join does where it is written; both read as `string`.
    if isWideLitJoin(initTy) { return initTy }
  }
  widenLitTy(initTy)
}

// Whether a compare keeps operand type `x` at its `const` literal: only beside a literal-typed
// other side (or its nullable) that the literal is a member of. Anywhere else it compares as the
// `string` it is; `constLitNeverMeets` refuses a literal side it can never equal.
function eqKeepsWideLit(x: i32, other: i32): boolean {
  if !isWideLitJoin(x) { return false }
  if other < 0 || isWideLitJoin(other) { return false }
  if !isLitBearing(other) { return false }
  if assignable(x, other) { return true }
  const o = T.tys[other]
  if o is TyNullable { return assignable(x, o.nInner) }
  false
}

// Refuses a compare that can never hold: one side a `const` string literal (or a join of them),
// the other a literal of a type with no member in common (owner ruling, D2198). Reports and
// returns true when it refused; a side that may hold any string never refuses.
function constLitNeverMeets(
  lx: i32,
  lty: i32,
  rx: i32,
  rty: i32,
  op: string,
  ix: i32,
): boolean {
  let wx = lx
  let wty = lty
  let oty = strLitViewOf(rx, rty)
  if !isWideLitJoin(lty) {
    if !isWideLitJoin(rty) { return false }
    wx = rx
    wty = rty
    oty = strLitViewOf(lx, lty)
  }
  if oty < 0 { return false }
  if !strLitSetsDisjoint(wty, oty) { return false }
  const always = if op == "!=" { "true" } else { "false" }
  tErr(constLitNeverMsg(wx, wty, oty, "comparison is always " + always), ix)
  true
}

// Whether string-literal sets `a` and `b` provably share no value. Membership compares lexemes,
// so a set holding an escape (`"\n"` beside a raw newline) is never called disjoint.
function strLitSetsDisjoint(a: i32, b: i32): boolean {
  const both: i32[] = []
  flattenStrLits(a, both)
  flattenStrLits(b, both)
  let i = 0
  while i < both.length {
    const t = T.tys[both[i]]
    if t is TyLit {
      if t.litText.indexOf("\\") >= 0 { return false }
    }
    i = i + 1
  }
  const bs: i32[] = []
  flattenStrLits(a, bs)
  let k = 0
  while k < bs.length {
    if assignable(bs[k], b) { return false }
    k = k + 1
  }
  true
}

// `ty` with every widening literal inside it replaced by its base scalar: a union of them
// (`if c { Z } else { W }`), a function's result (`() => Z`), a list's element and a map's key
// or value, rebuilt only where something widened. Every other type comes back unchanged.
export function widenLitTy(ty: i32): i32 {
  if wideLitTyIxs.length == 0 { return ty }
  widenLitTyGo(ty, 6)
}

function widenLitTyGo(ty: i32, depth: i32): i32 {
  if ty < 0 || depth <= 0 { return ty }
  const t = T.tys[ty]
  match t {
    TyLit => {
      if ty < wideLitTyIxs.length && wideLitTyIxs[ty] { return litBaseTy(t) }
      return ty
    }
    TyUnion => {
      let changed = false
      const ws: i32[] = []
      let i = 0
      while i < t.uMembers.length {
        const w = widenLitTyGo(t.uMembers[i], depth - 1)
        if w != t.uMembers[i] { changed = true }
        ws.push(w)
        i = i + 1
      }
      if !changed || ws.length == 0 { return ty }
      let acc = ws[0]
      let k = 1
      while k < ws.length {
        acc = joinTys(acc, ws[k])
        k = k + 1
      }
      return acc
    }
    TyNullable => {
      const wi = widenLitTyGo(t.nInner, depth - 1)
      if wi == t.nInner { return ty }
      return mkNullableTy(wi)
    }
    TyFunc => {
      const wr = widenLitTyGo(t.fnRet, depth - 1)
      if wr == t.fnRet { return ty }
      return mkFuncTy(t.fnParamTypes, wr)
    }
    TyArray => {
      if t.aRead == 1 { return ty }
      const we = widenLitTyGo(t.aElem, depth - 1)
      if we == t.aElem { return ty }
      return mkArrayTy(we)
    }
    TyMap => {
      const wk = widenLitTyGo(t.mKey, depth - 1)
      const wv = widenLitTyGo(t.mVal, depth - 1)
      if wk == t.mKey && wv == t.mVal { return ty }
      return mkMapTy(wk, wv, t.mSet)
    }
    TyPrim => {
      return ty
    }
    TyObj => {
      // An object literal widens its fields as it is built (`checkObjLitNode`), and a declared
      // record is annotated, so neither carries a widening literal to find here.
      return ty
    }
    TyErr => {
      return ty
    }
    TyVar => {
      return ty
    }
    TyNeg => {
      return ty
    }
  }
}

function checkLetDeclNodeIn(n: LetDecl, ix: i32) {
  if curFnDeclIx >= 0 { letDeclFnPut(ix, curFnDeclIx) }
  if n.letInit >= 0 { wrDstDeclPut(n.letInit, ix) }
  if n.letType < 0 && n.letInit >= 0 && !inferQuiet {
    const lp = cwPeel(n.letInit)
    if lp >= 0 {
      const li = P.nodes[lp]
      if li is IfStmt { letJoinCandidates.push(ix) }
      if li is BinExpr {
        if li.binOp == "??" { letJoinCandidates.push(ix) }
      }
    }
  }
  // Resolve the annotation (if any) by reading the TypeRef child inline.
  let annot = -1
  // D1048's second hint: did the annotation collapse a subsumed literal arm? Read immediately
  // after resolution and compared against THIS annotation's own answer.
  let annotCollapsedHere = false
  if n.letType >= 0 {
    const tn = P.nodes[n.letType]
    if tn is TypeRef {
      // A binding the list-union rewrite minted is typed as the rewrite typed it, since a
      // written `T[] | i32[]` resolves to one list (D2876).
      const lua = luAnnTy[n.letType] ?? -1
      if lua >= 0 {
        annot = lua
      } else {
        annot = nameToTyAt(tn.tyName, n.letType)
      }
      if annot >= 0 && annot == collapsedTy { annotCollapsedHere = true }
      if tn.tyName.length > 0 && tn.tyName.slice(0, 1) == "{" {
        recAnnObjs.push(annot)
      }
      if annot < 0 {
        // A map shape whose key is neither `string` nor `i32` has no hash in the map rep —
        // report that directly (with the supported set) rather than a bare "unknown type".
        const mapKeyIx = tsMapKeyNodeOf(annTsOf(n.letType))
        let badKey = ""
        if mapKeyIx >= 0 { badKey = tsText[mapKeyIx] }
        if badKey != "" && !mapKeyTySupported(tsLeafTy(badKey)) {
          mapKeyUnsupportedErr(badKey, initMapCtorName(n.letInit), n.letType)
        } else {
          unknownTyErr(tn.tyName, "", n.letType)
        }
        annot = TY_ERR
      }
      // Record the resolved type on the `let`'s type-annotation node so the emitter can
      // classify it structurally from the `Ty` arena rather than re-parsing `tyNameOf` — C1.
      if !inferQuiet && annot >= 0 {
        if n.letType < nodeTyIx.length { nodeTySet(n.letType, annot) }
      }
    }
  }
  let initTy = -1
  // Bidirectional: an annotated `const f: (i32) => i32 = (x) => ...` infers each un-annotated
  // lambda param from the annotation before the initializer is checked.
  const seedMark = cbSeedUsed
  if n.letInit >= 0 && annot >= 0 { seedExpected(n.letInit, annot) }
  // An un-annotated binding to a bare lambda: mark it so its un-annotated params type as
  // inference holes rather than being rejected as uninferable.
  if annot < 0 && n.letInit >= 0 {
    const liN = P.nodes[n.letInit]
    if liN is FuncDecl {
      if liN.fnName == "" { noteValBindLambda(n.letInit) }
    }
  }
  if n.letInit >= 0 {
    if tpEnvNames.length > 0 { tpIfMarkOk(n.letInit) }
    initTy = checkNode(n.letInit)
  }
  // A `void` initializer has no value to bind — reject with a source-located message,
  // poisoning `initTy`. Exempted: an if-expression init, whose false path is implicit `null`.
  // A minted scrutinee binding (D1991) keeps the `void`, so the `match` reports it in its own words.
  if n.letInit >= 0 && isVoidTy(initTy) && !symNameIsMinted(n.letName) {
    if !voidSlotExemptExpr(n.letInit) {
      tErr(
        "cannot bind the void result of '"
          + n.letName
          + "' — a void function returns no value",
        ix,
      )
      initTy = TY_ERR
    }
  }
  // An initializer whose type includes `void` has no value to store: refused at the if or match arm
  // that yields none, else at the initializer (D4071).
  if (
    n.letInit >= 0
    && annot < 0
    && initTy >= 0
    && !isVoidTy(initTy)
    && tyMentionsVoid(initTy, 8)
    && !symNameIsMinted(n.letName)
  ) {
    const arm = ifNoValueArmAt(n.letInit)
    if arm != n.letInit {
      const kw = valueBranchKeyword(n.letInit)
      tErr(
        "this arm yields no value, but the `"
          + kw
          + "` is the value of `"
          + n.letName
          + "`: end the arm with a value, or make the `"
          + kw
          + "` a statement",
        arm,
      )
    } else {
      tErr(
        "`"
          + n.letName
          + "` would take the type "
          + tyToStr(initTy)
          + ", and a value that may be `void` cannot be stored: test it before binding "
          + "it, or bind it only where it holds a value",
        n.letInit,
      )
    }
    initTy = TY_ERR
  }
  // A `never` initializer leaves nothing to bind, and an un-annotated binding would take a type
  // no value has; a declared type gives the dead binding a real one (D1972).
  if n.letInit >= 0 && annot < 0 && initTy == TY_NEVER && initTy >= 0 {
    tErr(
      "`"
        + n.letName
        + "` would hold a `never` value, and none exists: its initializer never returns — call it as a statement, or declare the binding's type",
      ix,
    )
    initTy = TY_ERR
  }
  // Redundant explicit annotation: skipped when checking the initializer consumed a contextual
  // seed the annotation supplied (an un-annotated lambda param) — comparing then would be circular (D1442).
  if (
    annot >= 0
    && initTy >= 0
    && n.letInit >= 0
    && cbSeedUsed == seedMark
    && !lbiIsSynth(n.letType, ix)
  ) {
    if exprIsNumLit(n.letInit) && lbiNumTy(annot) {
      lbiDeferRedundant(ix, initTy)
    } else if !lbiReadsPinned(n.letInit) {
      recordRedundantAnnot(n, ix, initTy, annot)
    }
  }
  let bound = TY_ERR
  if annot >= 0 {
    bound = annot
    if initTy >= 0 {
      // An annotated empty-collection initializer pins the source binding's open holes from
      // the annotation (`const ys: i32[] = zs` resolves `zs`'s element) in place.
      constrainEmptyExpr(n.letInit, initTy, annot)
      // A `never`-typed annotation is already reported at its declaration — don't cascade a
      // second "cannot assign ... of type <empty>" at every use site.
      const neverAnnot = isNeverTy(annot)
      if !neverAnnot && !assignableExpr(n.letInit, initTy, annot) {
        // Three sentences, one home: `letAssignMsg` picks between the object-literal-into-a-map,
        // lossy-numeric and opaque forms; the pin calls the same function on the substituted pair.
        tErrWant(
          letAssignMsg(n.letInit, initTy, annot, n.letName, n.letType),
          n.letInit,
          annot,
        )
      } else if !neverAnnot {
        // The check above is vacuous whenever a side is a hole — record the pair for the pin to
        // re-ask under substitution, only on the PASSING side (a failing one already reported, D572).
        noteLetCstr(coalPinTy(n.letInit, initTy), annot, n.letInit, n.letName)
        // And the slots of a literal source too, but only when the pair above carried no hole —
        // that is exactly when the literal's own element join dropped one, so nothing is recorded.
        if !tyHasHole(initTy) {
          if !tyHasHole(annot) { noteLitElemCstrs(n.letInit, annot, 6) }
        }
      }
    }
  } else if initTy >= 0 {
    bound = constStrLitBound(n, initTy)
    if tpIfJoinAt.length > 0 { bound = tpIfBindTy(n.letInit, bound) }
    // A-infer-null: an un-annotated `let x = null` binds a nullable with an open inner hole;
    // the first non-null assignment fills it in place (the `=` arm), so `x` becomes `T | null`.
    if isNullTy(initTy) {
      bound = mkNullableTy(-1)
      // ...and record the hole, so scope close can say whether anything ever filled it. A
      // hole nothing fills is the `null` type and has a rep (D1576).
      noteNullHole(bound, ix)
    }
    // Un-inferred empty-collection floor: a still-open hole may yet be pinned by a downstream
    // `.push`/`.set`/`.add` — recorded for the scope-close re-check (`flushUninferred`).
    if unresolvedHole(bound) { notePending(n.letName, bound, ix) }
    // Exports an un-annotated if-expression binding's inferred value-union type for the
    // emitter. Gated to if-expr/`?.` inits only — rendering via `tyToStr` is costly on the hot path.
    let initIf = n.letInit
    if initIf >= 0 {
      const ini0 = P.nodes[initIf]
      if ini0 is Paren { initIf = ini0.parInner }
    }
    let isIfInit = false
    if initIf >= 0 {
      const ini1 = P.nodes[initIf]
      if ini1 is IfStmt { isIfInit = true }
      // A standalone optional chain (`const t = a?.w`) is the other init shape whose union the
      // emitter can learn about from nowhere else — as rare as an if-expression init.
      if ini1 is OptMember { isIfInit = true }
      // …and a `??`, whose result is a join the program spells nowhere else (D1709).
      if ini1 is BinExpr {
        if ini1.binOp == "??" { isIfInit = true }
      }
      // …and an optional CALL (`const t = p?.f()`), whose `| null` comes from the guard and
      // so appears in neither the callee's type nor the call's own spelling (D1814).
      if ini1 is Call {
        const iniCallee = P.nodes[ini1.callFn]
        if iniCallee is OptMember { isIfInit = true }
      }
    }
    if isIfInit {
      const lvn = valueUnionRetName(bound)
      if lvn != "" {
        inferLetIx.push(ix)
        inferLetTy.push(lvn)
      } else if tyIsStructBearingUnion(bound) {
        // A MIXED union renders "" above — a struct member is not a value ATOM — and still reps
        // as the box, so its row is minted from the arena type instead of from a name. Its
        // struct members register as ARMS here, the one place the join is named (D1746).
        inferRegisterVariantMembers(bound)
        inferLetIx.push(ix)
        inferLetTy.push("")
      } else if isNulStringTy(bound) {
        // `string | null` is a niche (not a value-union box) so `valueUnionRetName`
        // renders "" — record it separately for the kind-16 slot classification.
        inferLetNulStrIx.push(ix)
      } else if isNulBoolTy(bound) {
        // `boolean | null` is the other niche (the i32 sentinel-2 rep) — same story,
        // recorded for the niche slot classification (`isInferLetNulBool`).
        inferLetNulBoolIx.push(ix)
      }
    }
  } else {
    tErr("'" + n.letName + "' needs a type annotation or initializer", ix)
  }
  // Same-scope redeclaration (B16): a second `let`/`const` of a name already bound in the
  // innermost frame errors; shadowing an outer name in a nested block is legal.
  const dtop = T.scopes.length - 1
  // A module global is pre-declared by the pass-1.5 hoist, so its own pass-2 declaration
  // would falsely trip the same-frame check — skip it there (top-level dups are caught in the hoist).
  const preHoisted = dtop == 0 && (moduleGlobals[n.letName] ?? false)
  if crWidenedInTop(n.letName) {
    crUnwidenTop(n.letName)
  } else if !preHoisted && T.scopes[dtop].has(n.letName) {
    tErr("redeclared " + n.letName, ix)
  }
  // The same reservation the `function` path enforces: a `const` of the emitter-intrinsic name
  // is called through the inline arm exactly like `function`, so the lambda never runs.
  checkNotEmitterIntrinsic(n.letName, ix)
  declare(n.letName, bound)
  if recAdOrigDecl.length > 0 && (recAdPinned[ix] ?? false) {
    recAdBound.push(bound)
  }
  if npKeys.length > 0 { narShadowPaths(n.letName, ix) }
  crNoteSoleRef(n)
  getLetBank(ix, bound)
  // The module hoist already recorded a global's row at depth 0; a second one would say the
  // same thing at the same depth (D1609).
  if !preHoisted && letDeclIsUnannotObjLit(ix) {
    markObjLitBinding(n.letName, T.scopes.length - 1)
  }
  if !preHoisted && letDeclIsUnannotCtnLit(ix) {
    markCtnLitBinding(n.letName, T.scopes.length - 1, n.letInit)
  }
  if !preHoisted && numLitBindCandidateTy(bound) {
    markNumLitBinding(n.letName, T.scopes.length - 1, ix)
  }
  if !preHoisted { lbiMark(n.letName, T.scopes.length - 1, ix, bound) }
  if !preHoisted { markFnLitBinding(n.letName, T.scopes.length - 1, ix) }
  fsbMark(n.letName, T.scopes.length - 1, ix, bound)
  // D1048's second hint: marks a binding whose type came from a spelling that collapsed a
  // subsumed literal arm. A bare call initializer is the whole rung, deliberately narrow.
  if annotCollapsedHere {
    markCollapsedBinding(n.letName)
  } else if n.letType < 0 && n.letInit >= 0 {
    const cInit = P.nodes[n.letInit]
    if cInit is Call {
      const cFn = P.nodes[cInit.callFn]
      if cFn is Ident {
        const cDecl = fnDeclIx[cFn.identName] ?? lookupFnDeclNode(cFn.identName)
        if fnRetCollapsed(cDecl) { markCollapsedBinding(n.letName) }
      }
    }
  }
  // `const f = addT` — records which declaration this binding aliases, for deferred-constraint
  // ownership alone. A bare Ident initializer naming a declared function is the whole rung.
  if n.letInit >= 0 {
    const aInit = P.nodes[parenPeelIx(n.letInit)]
    if aInit is Ident {
      const aDecl = fnDeclIx[aInit.identName]
        ?? lookupFnDeclNode(aInit.identName)
      if aDecl >= 0 {
        const atop = fnAliasScopes.length - 1
        if atop >= 0 { fnAliasScopes[atop][n.letName] = aDecl }
      }
    }
  }
  symDecl(n.letName, ix, bound, 0)
  if n.letKw == "const" {
    const ctop = constScopes.length - 1
    if ctop >= 0 { constScopes[ctop][n.letName] = ix }
  }
  // Definite-assignment: an uninitialized `let x` starts unassigned; a later read before a
  // write is an error. An initialized `let`/`const` is assigned from the start and never tracked.
  daMarkAssigned(n.letName)
  if (moduleBeforeDecl[n.letName] ?? -1) == ix {
    moduleBeforeDecl[n.letName] = -1
  }
  // An `extern let` is assigned by whoever provides the import, before any code here runs.
  if n.letInit < 0 && externGlobalLinkOfNode(ix) < 0 { daAdd(n.letName) }
  return TY_VOID
}
// ── match ──────────────────────────────────────────────────────────────────

// Marks the union members that arm pattern type `pt` covers, in the `covered` flag column
// parallel to `uMems`. Returns 1 when it covered at least one new member, -1 when every member
// it names is already covered (a redundant arm), 0 when it names no member at all. Coverage is
// decided by arena type (`sameVariantTy`), so two structurally-identical declared types are one member.
function markUnionCover(uMems: i32[], covered: i32[], pt: i32) {
  let found = 0
  let fresh = 0
  let j = 0
  while j < uMems.length {
    if sameVariantTy(uMems[j], pt) {
      found = found + 1
      if covered[j] == 0 {
        covered[j] = 1
        fresh = fresh + 1
      }
    }
    j = j + 1
  }
  if found == 0 { return 0 }
  if fresh == 0 { return -1 }
  1
}

// One integer-literal arm pattern: type-checks it against the scrutinee and claims its value,
// reporting a mismatch or a duplicate at the pattern. `claimed` holds the values already
// claimed, keyed `hi:lo` so a match of any arm count stays linear (D1990). Answers false only
// for a type mismatch — the one refusal that makes the pattern cover nothing.
function checkIntArmLit(
  patIx: i32,
  numIx: i32,
  neg: boolean,
  st: i32,
  claimed: {[string]: boolean},
) {
  // Checked as the expression it is, so `nodeTyIx` is filled for the `==` the desugar builds
  // over it — an `i32` literal reaches an `i64` scrutinee by the widening lattice, never the reverse.
  const pt = checkNode(patIx)
  if !assignable(pt, st) {
    tErr(
      "match pattern type mismatch: expected "
        + tyToStr(st)
        + ", found "
        + tyToStr(pt),
      patIx,
    )
    return false
  }
  // A hole scrutinee can't decide the compare's form here — record the deferred `==` the
  // desugared chain emits, so the call that pins the parameter adjudicates it later.
  noteBinCstr(st, "==", pt)
  if numIx < 0 { return true }
  const key = matchIntPatValue(numIx, neg)
  if key.length != 2 { return true }
  const k = i32ToStr(key[0]) + ":" + i32ToStr(key[1])
  if claimed.has(k) {
    tErr(
      "redundant match arm: `"
        + matchPatLabel(patIx, matchIntPatLexeme(numIx, neg))
        + " is already covered",
      patIx,
    )
    return true
  }
  claimed.set(k, true)
  true
}

// `match` over an integer scrutinee (D1572, VL-020): arms are integer literals of the
// scrutinee's type plus a mandatory `_`, since 2^32 cases is not a member set to be complete
// over. Duplicate arms and an arm after the `_` are errors. No emitter path of its own —
// `desugarMatchAt` already turns a non-`IsExpr` pattern into `scrut == pat`.
function checkMatchIntArms(n: MatchExpr, ix: i32, st: i32) {
  // The literal values already claimed, keyed by the 64-bit value's `hi:lo` halves.
  const claimed: {[string]: boolean} = Map()
  let hasWild = false
  let wildArm = -1
  // A pattern that is not an integer literal covers nothing — report it at the pattern and
  // suppress the missing-`_` report below, which would mis-blame coverage for it.
  let sawBadPat = false
  // -1 is the "unset" join seed (`joinTys` returns the other operand); the positive TY_ERR
  // sentinel would poison the join, so never seed with it.
  let matchTy = -1
  const matchArmTys: i32[] = []
  const mValArms: i32[] = []
  const mValTys: i32[] = []
  let matchValAcc = matchTallyBegin(ix)
  let mArmsLit = true
  const nArms = n.matchArmStart.length
  let ai = 0
  while ai < nArms {
    let pj = 0
    while pj < n.matchArmCount[ai] {
      const patIx = n.matchPats[n.matchArmStart[ai] + pj]
      const valIx = matchPatValNode(patIx)
      if matchPatIsWild(patIx) {
        hasWild = true
        if wildArm < 0 { wildArm = ai }
      } else if matchPatWasRefused(patIx) {
        sawBadPat = true
      } else {
        const numIx = matchPatIntNumOf(valIx)
        if valIx != patIx && numIx < 0 {
          // A constant whose literal is no integer: its read is checked for the mismatch.
          sawBadPat = true
          checkIntArmLit(patIx, -1, false, st, claimed)
        } else if numIx < 0 {
          // Any other pattern is another vocabulary's arm (a type pattern, a member string,
          // or a parse-recovery node) — named here rather than read as a missing member.
          sawBadPat = true
          tErr(intArmRejectMsg(st), patIx)
        } else if (!checkIntArmLit(patIx, numIx, numIx != valIx, st, claimed)) {
          sawBadPat = true
        }
      }
      pj = pj + 1
    }
    // An arm after the `_` is dead, and silently reordered if allowed: the wildcard
    // becomes the chain's bare `else`, so a later arm would test first — rejected, not reordered.
    if wildArm >= 0 && ai > wildArm {
      tErr(
        "unreachable match arm — the `_` wildcard must be the last arm",
        n.matchPats[n.matchArmStart[ai]],
      )
    }
    const body = n.matchBodies[ai]
    const svArm = valueArmAt
    if matchValued { valueArmAtSet(body) }
    if matchOnSpine { spineAtSet(body) }
    const bt = checkNode(body)
    valueArmAtSet(svArm)
    let armTy = bt
    const bn = P.nodes[body]
    if bn is Block {
      armTy = blockTailTy
      // A statement-tail block has `blockTailTy == -1` ("no value") — that is void, not the
      // sentinel TY_ERR (both are -1), so a void-arm `match` must not be read as an error.
      if armTy < 0 { armTy = TY_VOID }
    }
    if !matchArmExits(ix, body, armTy) {
      const bodyLit = armLit(armTy, body)
      matchTy = joinArmLit(
        matchTy,
        mArmsLit,
        f32ArmPlainTy(body, armTy),
        bodyLit,
      )
      if tpEnvNames.length > 0 { matchArmTys.push(f32ArmPlainTy(body, armTy)) }
      mValArms.push(body)
      mValTys.push(f32ArmPlainTy(body, armTy))
      matchValAcc = matchArmTally(
        ix,
        body,
        armTy,
        matchValAcc,
        mArmsLit,
        bodyLit,
      )
      mArmsLit = mArmsLit && bodyLit
    }
    ai = ai + 1
  }
  if matchTy < 0 { matchTy = TY_VOID }
  const mf32 = matchF32Join(ix, matchTy)
  const mlj = litJoinOf(ix, matchTy, mValArms, mValTys)
  if mf32 >= 0 {
    matchTy = mf32
    matchValAcc = mf32
  } else if mlj >= 0 {
    matchTy = mlj
    matchValAcc = mlj
  } else {
    noteTpJoinRow(ix, tpApartJoinOf(matchArmTys), matchTy, tpMatchOk)
  }
  matchTallyEnd(ix, matchValAcc)
  // Exhaustiveness is the wildcard, and it is required — an integer has no closed member set,
  // so there is no arm list that could stand in for one.
  if !hasWild && !sawBadPat {
    tErr("non-exhaustive match — an integer `match` needs a `_` arm", ix)
  }
  // Lower to an if/else chain in place (real pass only) so lint + emit see only if-chains.
  if !inferQuiet {
    desugarMatchAt(ix)
    if !sawBadPat { noteIntMatchHead(ix) }
  }
  matchTy
}

// The two clause-level rejects that exist because the desugar splices rather than wraps: a name
// bound twice by one clause, and a name the arm body redeclares. Both would be accepted here and
// decided by the emitter's local allocator; both are reported at the binding.
function checkMatchBindNames(bIx: i32, bodyIx: i32) {
  if bIx < 0 { return 0 }
  const bn = P.nodes[bIx]
  if bn is Block {
    let i = 0
    while i < bn.blkStmts.length {
      const st = P.nodes[bn.blkStmts[i]]
      if st is LetDecl {
        let j = 0
        while j < i {
          const pv = P.nodes[bn.blkStmts[j]]
          if pv is LetDecl {
            if pv.letName == st.letName {
              tErr(
                "duplicate payload binding `" + st.letName + "`",
                bn.blkStmts[i],
              )
            }
          }
          j = j + 1
        }
        if matchBodyDeclares(bodyIx, st.letName) {
          tErr(
            "payload binding `"
              + st.letName
              + "` is redeclared in the arm body — rename one",
            bn.blkStmts[i],
          )
        }
      }
      i = i + 1
    }
  }
  0
}

// Checks a clause's `const` decls inside the arm's narrowing scope, so `const x = scrut.x`
// reads the field off the narrowed member and the name is visible to the following body.
// A duplicate binding is skipped rather than checked — `checkMatchBindNames` already reported
// it, and declaring it twice would stack a terse `redeclared x` on the explanatory message.
function checkMatchBindDecls(bIx: i32) {
  if bIx < 0 { return 0 }
  const bn = P.nodes[bIx]
  if bn is Block {
    let i = 0
    while i < bn.blkStmts.length {
      let dup = false
      const st = P.nodes[bn.blkStmts[i]]
      if st is LetDecl {
        let j = 0
        while j < i {
          const pv = P.nodes[bn.blkStmts[j]]
          if pv is LetDecl {
            if pv.letName == st.letName { dup = true }
          }
          j = j + 1
        }
      }
      if !dup { checkNode(bn.blkStmts[i]) }
      i = i + 1
    }
  }
  0
}

function checkMatchTypeArms(n: MatchExpr, ix: i32, st: i32, uMems: i32[]) {
  // `uMems` is the scrutinee's variant list (a nullable contributes its inner variants plus
  // `null`) — a data structure, never a re-split of a rendered spelling. `covered` is parallel.
  const covered: i32[] = []
  let ci = 0
  while ci < uMems.length {
    covered.push(0)
    ci = ci + 1
  }
  let hasWild = false
  // A pattern that names no member covers nothing — report it at the pattern and suppress the
  // exhaustiveness report below (the bad pattern is the root cause; don't cascade).
  let sawBadPat = false
  const nArms = n.matchArmStart.length
  // ── pass 1 (SOURCE order): resolve + validate every pattern, bank its check type, mark cover.
  let ai = 0
  while ai < nArms {
    let pj = 0
    while pj < n.matchArmCount[ai] {
      const patIx = n.matchPats[n.matchArmStart[ai] + pj]
      const pn = P.nodes[patIx]
      if matchPatIsWild(patIx) {
        hasWild = true
      } else if pn is IsExpr {
        const pt = isTypeTy(pn.isVariant, patIx)
        if pt < 0 {
          sawBadPat = true
          tErr(matchUnknownTypeMsg(pn.isVariant, st), patIx)
        } else if tyIsCompositePat(pt) {
          sawBadPat = true
          tErr(
            "match pattern `"
              + pn.isVariant
              + "` names a union — list its members as separate arms (`A | B => …`)",
            patIx,
          )
        } else {
          // Banks the resolved check type on the pattern node (the `isVarTyIx` row the emitter's
          // narrowing stack reads) instead of re-checking, which would duplicate the scrutinee's diagnostics.
          if patIx < isVarTyIxCap {
            while isVarTyIx.length <= patIx { isVarTyIxPush(-1) }
            isVarTyIxSetAt(patIx, pt)
          }
          if patIx < nodeTyIx.length { nodeTySet(patIx, TY_BOOL) }
          const hit = markUnionCover(uMems, covered, pt)
          if hit == 0 {
            tErr(
              "match pattern `"
                + pn.isVariant
                + "` is not a member of "
                + tyToStr(st),
              patIx,
            )
          } else if hit < 0 {
            tErr(
              "redundant match arm: `" + pn.isVariant + "` is already covered",
              patIx,
            )
          }
          const twin = mapTwinTestMsg(uMems, pt, "a `match` arm")
          if twin != "" { tErr(twin, patIx) }
        }
      } else if pn is StrLit {
        // A string-literal pattern discriminates a litunion's member text; over a value union
        // the arms discriminate types, so name the difference instead of a phantom missing member.
        sawBadPat = true
        tErr(
          "invalid match pattern "
            + pn.strText
            + " — a pattern over a value union is a member type or the `_` wildcard",
          patIx,
        )
      } else {
        sawBadPat = true
        tErr(
          "invalid match pattern — a pattern over a value union is a member type or the `_` wildcard",
          patIx,
        )
      }
      pj = pj + 1
    }
    // An or-pattern arm may not carry a payload binding: it gets no then-narrowing
    // (`collectThenNarrows` reports none for the `||` condition), so `scrut.x` would not type.
    if n.matchArmCount[ai] > 1 {
      if matchArmHasBinds(n, ai) {
        tErr(
          "payload binding is not allowed on an or-pattern arm — give each type its own arm",
          n.matchPats[n.matchArmStart[ai]],
        )
      }
    } else {
      checkMatchBindNames(matchArmBindsOf(n, ai), n.matchBodies[ai])
    }
    ai = ai + 1
  }
  // Whether every member is named (or a `_` stands in for the rest) — settled by pass 1, and
  // read by pass 3 as well as by the exhaustiveness report at the end.
  let exhaustive = hasWild
  if !hasWild {
    let ec = 0
    let allCov = true
    while ec < covered.length {
      if covered[ec] == 0 { allCov = false }
      ec = ec + 1
    }
    exhaustive = allCov
  }
  // Pass 2 (chain order): the progressive else narrowings. `armAcc[k]` is how much of the
  // accumulator holds when the chain enters arm `k` — `collectElseNarrows`' fold, same order.
  const elseArm = matchElseArmOf(n.matchPats, n.matchArmStart, n.matchArmCount)
  const accNames: string[] = []
  const accTys: i32[] = []
  const armAcc: i32[] = []
  let z = 0
  while z < nArms {
    armAcc.push(0)
    z = z + 1
  }
  let ck = 0
  while ck < nArms {
    if ck != elseArm {
      armAcc[ck] = accNames.length
      let pj = 0
      while pj < n.matchArmCount[ck] {
        collectElseNarrows(
          n.matchPats[n.matchArmStart[ck] + pj],
          accNames,
          accTys,
        )
        pj = pj + 1
      }
    }
    ck = ck + 1
  }
  if elseArm >= 0 { armAcc[elseArm] = accNames.length }
  // Pass 3 (source order): check each arm body under its branch's narrowing, joining arm value
  // types. -1 is the "unset" join seed; the positive TY_ERR sentinel would poison the join.
  let matchTy = -1
  const matchArmTys: i32[] = []
  const mValArms: i32[] = []
  const mValTys: i32[] = []
  let matchValAcc = matchTallyBegin(ix)
  let mArmsLit = true
  let bi = 0
  while bi < nArms {
    const nmz: string[] = []
    const tyz: i32[] = []
    let q = 0
    while q < armAcc[bi] {
      nmz.push(accNames[q])
      tyz.push(accTys[q])
      q = q + 1
    }
    // The arm's own then-fact, pushed after the accumulated complement (order matters —
    // `applyNarrows` binds in order, so the arm's own type wins over the complement).
    if bi != elseArm || !exhaustive {
      if n.matchArmCount[bi] == 1 {
        collectThenNarrows(n.matchPats[n.matchArmStart[bi]], nmz, tyz)
      }
    }
    // The scope is pushed for the payload clause too, not just the narrowing — an arm can
    // bind without narrowing, and its `const`s must still be arm-local.
    const bindIx = matchArmBindsOf(n, bi)
    const scoped = nmz.length > 0 || bindIx >= 0
    if scoped {
      pushScope(-1)
      applyNarrows(nmz, tyz)
      checkMatchBindDecls(bindIx)
    }
    const body = n.matchBodies[bi]
    const svArm = valueArmAt
    if matchValued { valueArmAtSet(body) }
    if matchOnSpine { spineAtSet(body) }
    const bt = checkNode(body)
    valueArmAtSet(svArm)
    let armTy = bt
    const bn = P.nodes[body]
    if bn is Block {
      armTy = blockTailTy
      // A statement-tail block has `blockTailTy == -1` ("no value") — that is void, not the
      // sentinel TY_ERR (both are -1), so a void-arm `match` must not be mistaken for an error.
      if armTy < 0 { armTy = TY_VOID }
    }
    if scoped { popScope() }
    if !matchArmExits(ix, body, armTy) {
      const bodyLit = armLit(armTy, body)
      matchTy = joinArmLit(
        matchTy,
        mArmsLit,
        f32ArmPlainTy(body, armTy),
        bodyLit,
      )
      if tpEnvNames.length > 0 { matchArmTys.push(f32ArmPlainTy(body, armTy)) }
      mValArms.push(body)
      mValTys.push(f32ArmPlainTy(body, armTy))
      matchValAcc = matchArmTally(
        ix,
        body,
        armTy,
        matchValAcc,
        mArmsLit,
        bodyLit,
      )
      mArmsLit = mArmsLit && bodyLit
    }
    bi = bi + 1
  }
  if matchTy < 0 { matchTy = TY_VOID }
  const mf32 = matchF32Join(ix, matchTy)
  const mlj = litJoinOf(ix, matchTy, mValArms, mValTys)
  if mf32 >= 0 {
    matchTy = mf32
    matchValAcc = mf32
  } else if mlj >= 0 {
    matchTy = mlj
    matchValAcc = mlj
  } else {
    noteTpJoinRow(ix, tpApartJoinOf(matchArmTys), matchTy, tpMatchOk)
  }
  matchTallyEnd(ix, matchValAcc)
  // Exhaustiveness: `_` is allowed but never required — a match naming every member is
  // complete without one. Missing members render from the arena types, not a re-split spelling.
  if !hasWild && !sawBadPat {
    let missing = ""
    let mk = 0
    while mk < uMems.length {
      if covered[mk] == 0 {
        if missing != "" { missing = missing + ", " }
        missing = missing + tyToStr(uMems[mk])
      }
      mk = mk + 1
    }
    if missing != "" {
      tErr(
        "non-exhaustive match — missing " + missing + " (add the arm or a `_`)",
        ix,
      )
    }
  }
  // Lower to an if/else chain in place (real pass only) so lint + emit see only if-chains.
  if !inferQuiet { desugarMatchAt(ix) }
  matchTy
}

// ── a `const` as a match arm (D3271) ─────────────────────────────────────────
// A bare name in pattern position that names no type is a constant, compared by value: the
// pattern node becomes a read of it, so the desugared test is the hand-written `scrut == K`,
// and its literal is where the arm's value is read for duplicates, members and the jump table.

// Rewrites each arm pattern naming a constant into a read of it, and refuses every other bare
// name. Asked of the value vocabularies, where no type but `null` is a pattern, so a constant the
// name reaches wins over a type of that name. A `hole` scrutinee's arms still choose between the
// two, so there a type stays a type and a refusal is left to the scrutinee's own error.
function resolveMatchConstPats(n: MatchExpr, hole: boolean) {
  let i = 0
  while i < n.matchPats.length {
    const patIx = n.matchPats[i]
    const pn = P.nodes[patIx]
    if pn is IsExpr {
      const root = annTsOf(patIx)
      if root >= 0 && tsKind[root] == TS_NAME && pn.isVariant != "null" {
        const nm = matchPatValueName(patIx, pn.isVariant)
        let isConst = false
        if !hole { isConst = constDeclOf(nm) >= 0 }
        if isConst || !matchPatNamesType(pn.isVariant) {
          const why = matchConstPatWhy(nm, patIx)
          if why == "" {
            const rd: Node = { identName: nm, pos: pn.pos }
            arenaSetNode(patIx, rd)
            sidNoteNodeName(patIx, -1)
          } else if !hole {
            matchPatRefused[patIx] = true
            tErr(why, patIx)
          }
        }
      }
    }
    i = i + 1
  }
  0
}

// Extracted from `checkNodeReal`'s `MatchExpr` arm (C3: thin the dispatcher).
function checkMatchExprNode(n: MatchExpr, ix: i32) {
  // A discarded `match` lowers its arms as statements, as a spine one does, and so do the
  // blocks, `if`s and `match`es at their tails.
  const savedOnSpine = matchOnSpine
  const savedValued = matchValued
  const savedSpine = spineAt
  matchValuedSet(!valDiscarded(ix))
  matchOnSpineSet(spineAt == ix || !matchValued)
  const r = checkMatchExprNodeIn(n, ix)
  if lpColAt(nestedExitFirstAt, ix) == 1 { refuseNestedExitFirst(ix, r) }
  matchOnSpineSet(savedOnSpine)
  matchValuedSet(savedValued)
  spineAtSet(savedSpine)
  r
}

function checkMatchExprNodeIn(n: MatchExpr, ix: i32) {
  // Three arm vocabularies, decided by the scrutinee: an integer dispatches on literals
  // (D1572), a litunion on member strings, any other union on member types.
  const mTail = retTailPos
  const savedMatchTail = matchInRetTail
  matchInRetTailSet(matchTailNode == ix)
  retTailPosSet(false)
  const st = checkNode(n.matchScrut)
  tpMatchOkSet(mTail || tpIfOkAt.has(ix))
  // The scrutinee and arm bodies are NOT in return-tail position — restore the flag on every
  // exit so a `match` subexpression stays transparent to a sibling in the same statement.
  const nulLit = tyIsNullableLitUnion(st)
  if tyIsIntMatchScrut(st) || tyIsLitUnion(st) || nulLit {
    resolveMatchConstPats(n, false)
  } else if tyIsHole(st) {
    resolveMatchConstPats(n, true)
  }
  if tyIsIntMatchScrut(st) || (tyIsHole(st) && matchArmsAreIntLits(n)) {
    const ri = checkMatchIntArms(n, ix, st)
    matchInRetTailSet(savedMatchTail)
    retTailPosSet(mTail)
    return ri
  }
  // D1898 — a NULLABLE literal union takes the member-string vocabulary too, with `null` as
  // one more member: it is the same interned i32 atom as the bare set, `null` riding the spare
  // `-1`, so the desugared `k is null` / `k == "a"` chain is what already lowers.
  if !tyIsLitUnion(st) && !nulLit {
    // A third arm vocabulary (D1572): an integer scrutinee dispatches on literals, asked before
    // the union tests (which have no member set for one). A hole takes it too when arms are int literals.
    const uMems: i32[] = []
    flattenVariantsInto(st, uMems)
    if uMems.length > 1 && !unionHasLitMember(uMems) {
      const r = checkMatchTypeArms(n, ix, st, uMems)
      matchInRetTailSet(savedMatchTail)
      retTailPosSet(mTail)
      return r
    }
    // An error-typed scrutinee's own diagnostic is already raised; refusing it again is a cascade.
    if st < 0 || !(T.tys[st] is TyErr) {
      tErr(matchScrutRejectMsg(st, uMems), ix)
    }
    matchInRetTailSet(savedMatchTail)
    retTailPosSet(mTail)
    return TY_ERR
  }
  // The member texts (inner, no quotes), and a parallel covered-flag. `K | null` interns as a
  // `TyNullable` over the set while the expanded `"a" | "b" | null` interns as a `TyUnion` with
  // a null member, so both forms are read here and the `null` member rides `nulCovered`.
  const members: string[] = []
  let styIx = st
  const styN = T.tys[st]
  if styN is TyNullable { styIx = styN.nInner }
  const sty = T.tys[styIx]
  if sty is TyUnion {
    let mi = 0
    while mi < sty.uMembers.length {
      const mm = T.tys[sty.uMembers[mi]]
      if mm is TyLit { members.push(mm.litText) }
      mi = mi + 1
    }
  }
  const covered: i32[] = []
  let ci = 0
  while ci < members.length {
    covered.push(0)
    ci = ci + 1
  }
  let nulCovered = false
  let hasWild = false
  // A pattern that is neither a member string literal nor the `_` wildcard covers nothing —
  // report it at the pattern and suppress the exhaustiveness error below (don't cascade).
  let sawBadPat = false
  // -1 is the "unset" join seed (`joinTys` returns the other operand); the positive TY_ERR
  // sentinel would poison the join (every arm joins back to error), so never seed with it.
  let matchTy = -1
  const matchArmTys: i32[] = []
  const mValArms: i32[] = []
  const mValTys: i32[] = []
  let matchValAcc = matchTallyBegin(ix)
  let mArmsLit = true
  let ai = 0
  while ai < n.matchArmStart.length {
    // Patterns of arm `ai`.
    let pj = 0
    while pj < n.matchArmCount[ai] {
      const patIx = n.matchPats[n.matchArmStart[ai] + pj]
      const pn = P.nodes[matchPatValNode(patIx)]
      if matchPatIsWild(patIx) {
        hasWild = true
      } else if matchPatWasRefused(patIx) {
        sawBadPat = true
      } else if pn is IsExpr {
        // D1898 — `null` is the one type pattern this vocabulary takes, and only where the
        // scrutinee carries it; on a bare set it is not a member and keeps the wording below.
        if nulLit && pn.isVariant == "null" {
          if nulCovered {
            tErr("redundant match arm: `null` is already covered", patIx)
          } else {
            nulCovered = true
          }
        } else {
          // A type pattern over a literal union: an identifier naming no type reaches this same
          // arm too, so the wording must not silently claim to cover every member.
          sawBadPat = true
          tErr(
            "invalid match pattern `"
              + pn.isVariant
              + "` — a pattern is a member string literal, a `const` with a literal value"
              + matchNulPatHint(nulLit)
              + " or the `_` wildcard",
            patIx,
          )
        }
      } else if pn is StrLit {
        // A constant's read is checked so the desugared `==` has its operand's type.
        if matchConstPatLitAt(patIx) >= 0 { checkNode(patIx) }
        // The member name is the pattern's inner text (quotes stripped) — an expression
        // lexeme, not `tyname.groupInnerOf`'s home (a degenerate lexeme stays whole here).
        const raw = pn.strText
        let inner = raw
        if raw.length >= 2 { inner = raw.slice(1, raw.length - 1) }
        let found = -1
        let fi = 0
        while fi < members.length {
          if members[fi] == inner { found = fi }
          fi = fi + 1
        }
        if found < 0 {
          tErr(
            "match pattern "
              + matchStrPatLabel(patIx, inner)
              + " is not a member of "
              + tyToStr(st),
            patIx,
          )
        } else if covered[found] == 1 {
          tErr(
            "redundant match arm: "
              + matchStrPatLabel(patIx, inner)
              + " is already covered",
            patIx,
          )
        } else {
          covered[found] = 1
        }
      } else if matchConstPatLitAt(patIx) >= 0 {
        // A constant holding a number: the read is checked for the mismatch it is.
        sawBadPat = true
        tErr(
          "match pattern type mismatch: expected "
            + tyToStr(st)
            + ", found "
            + tyToStr(checkNode(patIx)),
          patIx,
        )
      } else {
        // Any other node kind (a parse-recovered pattern, a future literal form):
        // same story — it covers nothing, so name it rather than mis-blame coverage.
        sawBadPat = true
        tErr(
          "invalid match pattern — a pattern is a member string literal, a `const` with a literal value or the `_` wildcard",
          patIx,
        )
      }
      pj = pj + 1
    }
    // Body value type. (Arm bodies are not checked in return-tail position; the match's joined
    // value seeds the function return once, below — avoids a per-arm void/err mis-seed.)
    const body = n.matchBodies[ai]
    const svArm = valueArmAt
    if matchValued { valueArmAtSet(body) }
    if matchOnSpine { spineAtSet(body) }
    const bt = checkNode(body)
    valueArmAtSet(svArm)
    let armTy = bt
    const bn = P.nodes[body]
    if bn is Block {
      armTy = blockTailTy
      // A statement-tail block has `blockTailTy == -1` ("no value") — that is void, not the
      // sentinel TY_ERR (both are -1), so a void-arm `match` must not be mistaken for an error.
      if armTy < 0 { armTy = TY_VOID }
    }
    if !matchArmExits(ix, body, armTy) {
      const bodyLit = armLit(armTy, body)
      matchTy = joinArmLit(
        matchTy,
        mArmsLit,
        f32ArmPlainTy(body, armTy),
        bodyLit,
      )
      if tpEnvNames.length > 0 { matchArmTys.push(f32ArmPlainTy(body, armTy)) }
      mValArms.push(body)
      mValTys.push(f32ArmPlainTy(body, armTy))
      matchValAcc = matchArmTally(
        ix,
        body,
        armTy,
        matchValAcc,
        mArmsLit,
        bodyLit,
      )
      mArmsLit = mArmsLit && bodyLit
    }
    ai = ai + 1
  }
  // A void-armed match leaves the join unset (-1) or void; normalize to void so the function-
  // body-tail seeding (`noteInferredRet`) does not mistake it for the error sentinel.
  if matchTy < 0 { matchTy = TY_VOID }
  const mf32 = matchF32Join(ix, matchTy)
  const mlj = litJoinOf(ix, matchTy, mValArms, mValTys)
  if mf32 >= 0 {
    matchTy = mf32
    matchValAcc = mf32
  } else if mlj >= 0 {
    matchTy = mlj
    matchValAcc = mlj
  } else {
    noteTpJoinRow(ix, tpApartJoinOf(matchArmTys), matchTy, tpMatchOk)
  }
  matchTallyEnd(ix, matchValAcc)
  // Exhaustiveness: every member covered, or a wildcard. Skipped after an invalid pattern —
  // that arm covers nothing, so a missing-member report would mis-blame what the pattern already explained.
  if !hasWild && !sawBadPat {
    let missing = ""
    let mk = 0
    while mk < members.length {
      if covered[mk] == 0 {
        if missing != "" { missing = missing + ", " }
        missing = missing + "\"" + members[mk] + "\""
      }
      mk = mk + 1
    }
    // The `null` member is named last, so the sentence reads in the order the spelling does.
    if nulLit && !nulCovered {
      if missing != "" { missing = missing + ", " }
      missing = missing + "null"
    }
    if missing != "" {
      tErr(
        "non-exhaustive match — missing " + missing + " (add the arm or a `_`)",
        ix,
      )
    }
  }
  // Lower to an if/else chain in place (real pass only) so lint + emit see only if-chains.
  if !inferQuiet { desugarMatchAt(ix) }
  matchInRetTailSet(savedMatchTail)
  retTailPosSet(mTail)
  return matchTy
}

// An `else if` chain is checked along its spine: every link's head runs outermost-first, then
// every tail innermost-first, with `checkNode`'s own bookkeeping for each inner link between, so
// the chain's depth costs no stack (D1990).
function checkIfStmtNode(ix: i32) {
  const savedChainSpine = ifChainSpine
  ifChainSpineSet(spineAt == ix)
  const frames: IfChk[] = []
  const savedTails: boolean[] = []
  let cur = ix
  let elseRes = TY_VOID
  while cur >= 0 {
    const c = P.nodes[cur]
    const at = cur
    cur = -1
    if c is IfStmt {
      frames.push(checkIfHead(c, at))
      // A discarded chain discards every link and arm under it.
      if c.ifElse >= 0 && valDiscarded(at) { markValDiscard(c.ifElse) }
      if c.ifElse >= 0 {
        if P.nodes[c.ifElse] is IfStmt {
          // `checkNode`'s entry for the inner link; an `if` is a tail-spine node.
          savedTails.push(retTailPos)
          cur = c.ifElse
        } else {
          const elseSpine = spineAt
          const elseArm = valueArmAt
          if !valDiscarded(at) { valueArmAtSet(c.ifElse) }
          if ifChainSpine { spineAtSet(c.ifElse) }
          elseRes = checkNode(c.ifElse)
          spineAtSet(elseSpine)
          valueArmAtSet(elseArm)
        }
      }
    }
  }
  const savedOnTail = ifChainOnFnTail
  ifChainOnFnTailSet(ifChainSpine)
  const savedVloOn = vloMemoOn
  const savedVlo = vloMemo
  vloMemoOnSet(frames.length > 1)
  if vloMemoOn { vloMemoSet(Map()) }
  let k = frames.length - 1
  let res = checkIfTailAt(frames[k], elseRes, false)
  while k > 0 {
    const inner = frames[k]
    k = k - 1
    checkNodeDone(inner.ifIx, res, savedTails[k])
    res = checkIfTailAt(frames[k], res, inner.exits)
  }
  vloMemoOnSet(savedVloOn)
  vloMemoSet(savedVlo)
  ifChainOnFnTailSet(savedOnTail)
  ifChainSpineSet(savedChainSpine)
  res
}

// The head of one link: everything up to checking its else arm.
function checkIfHead(n: IfStmt, ix: i32): IfChk {
  // Am I the else arm of an enclosing `if`? Read and cleared here, so the flag reaches
  // exactly one callee and every `if` inside a branch body sees `-1` (`pgUpKeys`).
  const isElseArm = ix >= 0 && ix == pgUpArmIx
  pgUpArmIxSet(-1)
  const pgUpMark = pgUpKeys.length
  // What this `if`'s own subtree writes; read by the post-guard leg below (D1736).
  const clobMark = narClobKeys.length
  // Where its places stood on entry, for a key the join first meets inside an arm (`narHeadTy`).
  const ipMark = narIpAt.length
  const headDepth = T.scopes.length
  const headNp = npKeys.length
  // An `if`/`else` in value position is an expression whose value is the join of its branch
  // tail values — capture whether THIS `if` sits in the function's return-tail position.
  const ifTail = retTailPos
  const ifInRetArg = inRetArg
  retTailPosSet(false)
  // Where the inferred return stood before this `if`'s arms seeded it (`dropTailIfSeeds`).
  const seedLogMark = inferRetLogTy.length
  const seedObsMark = inferObserved
  const seedObsLit = inferObservedLit
  const condTy = checkNode(n.ifCond)
  if !assignable(condTy, TY_BOOL) {
    tErr("if-condition must be boolean, got " + tyToStr(condTy), n.ifCond)
  }
  // Narrowing over a simple identifier: `is T` refines to the variant, `!= null`/`== null`
  // refine a nullable. Union-complement narrowing after `is T` is deliberately excluded — it missed real errors.
  const tnNames: string[] = []
  const tnTys: i32[] = []
  collectThenNarrows(n.ifCond, tnNames, tnTys)
  const enNames: string[] = []
  const enTys: i32[] = []
  collectElseNarrows(n.ifCond, enNames, enTys)
  // What each tested place held on entry, before either arm's fact: the arm join's start for a
  // path that carries no fact of its own.
  const tnEnt = narKeysNowTys(tnNames)
  const enEnt = narKeysNowTys(enNames)
  // Definite-assignment fork/join: each branch forks off the if-entry state and they join
  // after — assigned only if assigned on every surviving path; a diverging branch contributes nothing.
  const daFork = daMark()
  // `is`-guard alternatives over a hole: a then-narrow refining a hole is an alternative the
  // body handles on its own branch, not an extra field demand — registered before the scope pushes.
  const altRows: i32[] = []
  // The rows this guard tests, including ones a previous pass already registered — the
  // guarded-return marking must fire on every pass, since the real pass witnesses the call site.
  const guardRows: i32[] = []
  let ai = 0
  while ai < tnNames.length {
    if !isPathKey(tnNames[ai]) {
      const curIx = lookup(tnNames[ai])
      if curIx >= 0 {
        const cur = T.tys[curIx]
        if cur is TyVar {
          const row = noteHoleAlt(curIx, cur.tvName, tnTys[ai])
          if row >= 0 {
            altRows.push(row)
            guardRows.push(row)
          } else {
            const seen = holeAltRowOf(cur.tvName, tnTys[ai])
            if seen >= 0 { guardRows.push(seen) }
          }
        }
      }
    }
    ai = ai + 1
  }
  if tnNames.length > 0 {
    pushScope(-1)
    applyNarrows(tnNames, tnTys)
  }
  retTailPosSet(ifTail)
  // Every `return` under this branch is reached only by an argument satisfying the guard's
  // alternative — mark the branch so `noteInferredRet` records it as a guarded member.
  const guardedRet = guardRows.length > 0
  if guardedRet { guardAltStackPush(guardRows[guardRows.length - 1]) }
  // The arm's OWN statement depth: its block pushes one scope, so a write recorded at exactly
  // this depth runs whenever the arm does and a deeper one is conditional (D1846).
  const thenOwnDepth = T.scopes.length + 1
  const thenLo = narClobKeys.length
  const thenArm = valueArmAt
  if valDiscarded(ix) {
    markValDiscard(n.ifThen)
  } else {
    valueArmAtSet(n.ifThen)
  }
  const thenSpine = spineAt
  if ifChainSpine { spineAtSet(n.ifThen) }
  const neMark = neEnter(n.ifCond, curFnDeclIx)
  checkNode(n.ifThen)
  neLeave(neMark)
  spineAtSet(thenSpine)
  valueArmAtSet(thenArm)
  const thenHi = narClobKeys.length
  // The guard-clause divergence test, asked once the arm is checked so a `never` call in it is
  // marked (D1972): the post-guard leg, the `else if` hand-up and the emitter's
  // `pushPostGuardNarrow` all ask the same predicate.
  const thenExits = stmtAlwaysExits(n.ifThen)
  if guardedRet { guardAltStackPop() }
  retTailPosSet(false)
  const thenTy = blockTailTy
  const thenIx = blockTailIx
  if tnNames.length > 0 { popScope() }
  // Seeds the inferred return from the then-branch value before the else is checked, so a
  // recursive call in the else resolves against the base case — only from a genuine value-`if`.
  if ifTail && n.ifElse >= 0 {
    if thenTy != TY_VOID && thenTy != TY_ERR {
      // The then-arm's implicit-return value is guarded exactly like an explicit
      // `return` inside it (`if v is T { v.foo } else { v.bar }`).
      if guardedRet { guardAltStackPush(guardRows[guardRows.length - 1]) }
      // The arm, not the arms' join: a tail `if`/`else` whose one arm is an open `[]` needs
      // the sibling arm's shape, and the join is a third arena row (D1591).
      noteInferRetWitness(thenIx, thenTy)
      const seedThen = ifArmValTy(n.ifThen, thenTy)
      noteInferredSeed(seedThen, armLit(seedThen, n.ifThen))
      if guardedRet { guardAltStackPop() }
    }
  }
  // Surviving paths' end-states, each as the DELTA its arm made against the fork point: the
  // ids it assigned and the ids it declared and left unwritten.
  const daThenSid: i32[] = []
  const daThenWas: i32[] = []
  daTouchedSince(daFork, daThenSid, daThenWas)
  daRollbackTo(daFork)
  const daThenAdds: i32[] = []
  const daThenRems: i32[] = []
  daSplitDelta(daThenSid, daThenWas, daThenAdds, daThenRems)
  // The else arm's own depth and row range, read by the arm join below. An absent else leaves
  // them at their no-rows defaults, which is what says the fall-through wrote nothing.
  let elseOwnDepth = -1
  let elseLo = 0
  const daHasElse = n.ifElse >= 0
  if daHasElse {
    if enNames.length > 0 {
      pushScope(-1)
      applyNarrows(enNames, enTys)
    }
    // An `else if` chain: the else node's VALUE is its own branch join, since `blockTailTy`
    // holds only the innermost block's tail and under-joins a mixed chain.
    const enElse = P.nodes[n.ifElse]
    // A chain link post-narrows the PARENT's fall-through, not its own — marked so its own
    // `checkIfStmtNode` banks into `pgUpKeys` instead of a scope that is about to be popped.
    if enElse is IfStmt { pgUpArmIxSet(n.ifElse) }
    retTailPosSet(ifTail)
    elseOwnDepth = T.scopes.length + 1
    elseLo = narClobKeys.length
  }
  return {
    ifIx: ix,
    isElseArm: isElseArm,
    pgUpMark: pgUpMark,
    clobMark: clobMark,
    ipMark: ipMark,
    headDepth: headDepth,
    headNp: headNp,
    ifTail: ifTail,
    ifInRetArg: ifInRetArg,
    seedLogMark: seedLogMark,
    seedObsMark: seedObsMark,
    seedObsLit: seedObsLit,
    thenExits: thenExits,
    tnNames: tnNames,
    tnTys: tnTys,
    tnEnt: tnEnt,
    enNames: enNames,
    enTys: enTys,
    enEnt: enEnt,
    altRows: altRows,
    thenOwnDepth: thenOwnDepth,
    thenLo: thenLo,
    thenHi: thenHi,
    thenTy: thenTy,
    daFork: daFork,
    daThenAdds: daThenAdds,
    daThenRems: daThenRems,
    daHasElse: daHasElse,
    elseOwnDepth: elseOwnDepth,
    elseLo: elseLo,
    exits: false,
  }
}

// The tail of one link, given its else arm's type and, for an `else if` link, whether that
// link always exits (the chain's own `stmtAlwaysExits`, read bottom-up).
function checkIfTailAt(f: IfChk, elseRes: i32, innerExits: boolean): i32 {
  const n0 = P.nodes[f.ifIx]
  if n0 is IfStmt { return checkIfTail(n0, f, elseRes, innerExits) }
  TY_ERR
}

function checkIfTail(
  n: IfStmt,
  f: IfChk,
  elseRes: i32,
  innerExits: boolean,
): i32 {
  // Any else arm but an `else if` link is asked here, once it is checked, so a `never` call in it
  // is already marked; a link's answer is its own tail's, read bottom-up.
  let elseExits = innerExits
  if n.ifElse >= 0 {
    if !(P.nodes[n.ifElse] is IfStmt) || isBareBlockIf(n.ifElse) {
      elseExits = stmtAlwaysExits(n.ifElse)
    }
  }
  const ix = f.ifIx
  const isElseArm = f.isElseArm
  const pgUpMark = f.pgUpMark
  const clobMark = f.clobMark
  const ifTail = f.ifTail
  const ifInRetArg = f.ifInRetArg
  const seedLogMark = f.seedLogMark
  const seedObsMark = f.seedObsMark
  const seedObsLit = f.seedObsLit
  const thenExits = f.thenExits
  const enNames = f.enNames
  const enTys = f.enTys
  const altRows = f.altRows
  const thenLo = f.thenLo
  const thenTy = f.thenTy
  const daFork = f.daFork
  const daThenAdds = f.daThenAdds
  const daThenRems = f.daThenRems
  const daHasElse = f.daHasElse
  const daThenDiverges = thenExits
  let daElseDiverges = false
  const daElseAdds: i32[] = []
  const daElseRems: i32[] = []
  let elseTy = TY_VOID
  let elseIsLink = false
  let elseHi = 0
  if daHasElse {
    const enElse = P.nodes[n.ifElse]
    elseHi = narClobKeys.length
    daElseDiverges = elseExits
    pgUpArmIxSet(-1)
    retTailPosSet(false)
    elseTy = blockTailTy
    let elseIx = blockTailIx
    // A chain link's value is the whole inner `if`'s join, and `blockTailIx` then names the
    // innermost block's tail — a node the join did not come from, so it names none (D1591).
    if enElse is IfStmt {
      elseTy = elseRes
      elseIx = -1
      elseIsLink = true
    }
    if enNames.length > 0 { popScope() }
    if ifTail {
      if elseTy != TY_VOID && elseTy != TY_ERR {
        // A chain link's value is the inner `if` itself.
        if elseIsLink { noteInferRetValue(n.ifElse, elseTy) }
        noteInferRetWitness(elseIx, elseTy)
        const seedElse = ifArmValTy(n.ifElse, elseTy)
        noteInferredSeed(seedElse, armLit(seedElse, n.ifElse))
      }
    }
    const daElseSid: i32[] = []
    const daElseWas: i32[] = []
    daTouchedSince(daFork, daElseSid, daElseWas)
    daRollbackTo(daFork)
    daSplitDelta(daElseSid, daElseWas, daElseAdds, daElseRems)
  }
  // Closes each `is`-guard alternative: a diverging then-branch leaves the code after this
  // `if` unreachable for that argument (nothing required); otherwise record where the reached suffix starts.
  if !daThenDiverges {
    let ac = 0
    while ac < altRows.length {
      const row = altRows[ac]
      holeAltTailN[row] = holeShapeFieldCount(holeAltNames[row])
      ac = ac + 1
    }
  }
  // Joins the surviving paths from the fork point: unassigned on some surviving path. The
  // else path (or the entry fall-through with no else) always counts unless it diverges.
  daRelease(daFork)
  daJoinArms(
    daThenDiverges,
    daThenAdds,
    daThenRems,
    daHasElse,
    daElseDiverges,
    daElseAdds,
    daElseRems,
  )
  // The narrowing column's own join, `daJoinArms`'s shape one table over: a name an arm wrote
  // reads below the `if` at the join of what the surviving arms left it at, not at its
  // declaration. Banked at this node so the emitter pushes the same member (D1846).
  const sumKeys: string[] = []
  const sumTys: i32[] = []
  const sumPrev: i32[] = []
  const sumRet: i32[] = []
  if narClobKeys.length > clobMark {
    applyArmJoins(
      f,
      elseHi,
      daThenDiverges,
      daElseDiverges,
      n.ifCond,
      sumKeys,
      sumTys,
      sumPrev,
      sumRet,
    )
  }
  // Guard clause: a then that always exits applies the false narrowings to the rest of the
  // block. Subtractions accumulate over a sequence of guards; restricted to bare names only.
  if thenExits {
    let gi2 = 0
    while gi2 < enNames.length {
      const gKey = enNames[gi2]
      const gTy = enTys[gi2]
      // From the arms on, not the condition: a write in the condition that follows a fact's
      // test already dropped that fact (D2589), and one before it is what the test tested.
      if narClobberedSince(thenLo, gKey) {
        // An arm on the fall-through path wrote a different member into `gKey`, so the
        // residual would describe a value the place does not hold. Both halves drop it: the
        // emitter reads `pgResidualVoidOf` at the same node (D1736).
        recordPgResidualVoid(ix)
      } else if isPathKey(gKey) {
        // Paths keep the no-`else` gate, and an else arm never hands one up either — an
        // `npKeys` entry is retired in place by a call/write inside the arm.
        if !daHasElse && !isElseArm {
          npKeysPush(gKey)
          npTysPush(gTy)
          npInvByPush(-1)
          npEpochsPush(narFnEpoch)
          npSettlePush(-2)
          npCapByPush(-1)
          npAsgPush(0)
        }
      } else if isElseArm {
        pgUpKeys.push(gKey)
        pgUpTys.push(gTy)
      } else {
        // Banks what the place held before this subtraction, for the exhaustiveness check
        // after a trailing chain — the one line that makes `lookup` stop answering that question.
        if pgPreIx != ix {
          pgPreIxSet(ix)
          pgPreKeysSet([])
          pgPreTysSet([])
        }
        pgPreKeys.push(gKey)
        pgPreTys.push(lookup(gKey))
        // ...and bank the shadowed declaration under the post-guard kind, so a consumer
        // needing the emitter's union can find it (D1035) — idempotent, banking the widest first.
        const gDecl = lookup(gKey)
        noteNarShadow(gKey, gDecl, NAR_KIND_POSTGUARD)
        // One leg for both kinds: a null strip and a union subtraction are the same shadowing
        // `declare` — split only so the strip could skip the subtraction bank, now gone.
        declare(gKey, gTy)
        if gDecl >= 0 && gDecl != gTy { narFitCompanions(gKey, gDecl, gTy) }
      }
      gi2 = gi2 + 1
    }
    // The chain below this `if`, banked by every `else if` arm whose own then diverged —
    // applied in reverse push order, since the deepest arm's residual must win.
    if !isElseArm {
      let pu = pgUpKeys.length
      while pu > pgUpMark {
        pu = pu - 1
        if narClobberedSince(thenLo, pgUpKeys[pu]) {
          recordPgResidualVoid(ix)
        } else {
          const upDecl = lookup(pgUpKeys[pu])
          noteNarShadow(pgUpKeys[pu], upDecl, NAR_KIND_POSTGUARD)
          declare(pgUpKeys[pu], pgUpTys[pu])
          if upDecl >= 0 && upDecl != pgUpTys[pu] {
            narFitCompanions(pgUpKeys[pu], upDecl, pgUpTys[pu])
          }
        }
      }
    }
  }
  // Retires this subtree's hand-ups, unless THIS `if` is a chain link whose then diverged —
  // then its entry rides up to the parent, which asks the same question.
  if !isElseArm || !thenExits {
    while pgUpKeys.length > pgUpMark {
      pgUpKeys.pop()
      pgUpTys.pop()
    }
  }
  narCompactIf(clobMark, sumKeys, sumTys, sumPrev, sumRet)
  f.exits = thenExits && daHasElse && daElseDiverges
  retTailPosSet(ifTail)
  // An `if` with a completing arm that yields no value is a statement: it is `void` as the
  // function's tail, so the arm values it seeded leave the inferred return.
  // An arm ending in a bare `{ … }` leaves the `if` undecided: whether that block yields its
  // tail is the open bare-block-as-expression ruling, and D1903 pins what runs today.
  let bareArm = armTailUndecided(n.ifThen)
  if daHasElse && !elseIsLink && armTailUndecided(n.ifElse) { bareArm = true }
  let noValue = !bareArm && !thenExits && ifArmGivesNoValue(n.ifThen, thenTy)
  if !bareArm && daHasElse && !daElseDiverges {
    // An `else if` link answers its own verdict: an else-less link's fall-through is its `null`.
    if elseIsLink {
      if ifYieldsNoValue(n.ifElse) { noValue = true }
    } else if ifArmGivesNoValue(n.ifElse, elseTy) {
      noValue = true
    }
  }
  // Written both ways: a later pass re-decides with the callees' final types.
  if ix >= 0 {
    if noValue { ifNoValueAtSetAt(ix, true) } else { ifNoValueClear(ix) }
  }
  if noValue && ifTail && !ifInRetArg && daHasElse {
    dropTailIfSeeds(seedLogMark, seedObsMark, seedObsLit)
  }
  // An f32 arm beside literal arms types the join f32, as it does an operator (PL-049). A return
  // tail's arms seed the inferred return one by one, which keeps its reading (D2774).
  let f32Join = -1
  if (
    daHasElse
    && !bareArm
    && (!ifTail || f32JoinRetypesRunning())
    && !valDiscarded(ix)
  ) {
    if joinMayAdoptF32(thenTy, elseTy) { f32Join = joinF32LitTails(ix) }
  }
  // Two runtime arms join apart, so an arm an inner join typed `f32` keeps that type rather
  // than the `f64` a widening sibling would read it at.
  const f32Keep = daHasElse
    && f32JoinAdoptCount > 0
    && !valueIsLitOnly(n.ifThen)
    && !valueIsLitOnly(n.ifElse)
    && !njFnReached(njFnIx)
  if daHasElse && ix >= 0 {
    let valTy = TY_VOID
    if !thenExits {
      valTy = ifArmValTy(n.ifThen, thenTy)
      if !f32Keep { valTy = f32ArmPlainTy(n.ifThen, valTy) }
    }
    if !daElseDiverges {
      // A `void` here is an else-less link's value-less fall-through, which adds nothing.
      let ev = ifArmValTy(n.ifElse, elseTy)
      if !f32Keep { ev = f32ArmPlainTy(n.ifElse, ev) }
      if thenExits || valTy == TY_VOID {
        valTy = ev
      } else if ev != TY_VOID {
        valTy = joinArmLit(
          valTy,
          armLit(valTy, n.ifThen),
          ev,
          armLit(ev, n.ifElse),
        )
      }
    }
    if f32Join >= 0 { valTy = f32Join }
    if bareArm { ifValTyAtSetAt(ix, -1) } else { ifValTyAtSetAt(ix, valTy) }
  }
  // A discarded `if` is a statement, whatever its arms hold.
  if valDiscarded(ix) {
    if ix >= 0 {
      discardValTyAtSetAt(ix, discardedIfValTy(daHasElse, thenTy, elseTy))
    }
    return TY_VOID
  }
  // The `if`-expression's value type: with an `else`, the join of the two branch tail
  // values.
  if f32Join >= 0 { return f32Join }
  if daHasElse {
    let thenPlain = thenTy
    let elsePlain = elseTy
    if !f32Keep {
      thenPlain = f32ArmPlainTy(n.ifThen, thenTy)
      elsePlain = f32ArmPlainTy(n.ifElse, elseTy)
    }
    // An arm block that always exits (`return`, `break`, `continue`) hands no value to the
    // join; the emitter ends it with a `never` value (`exitArmBlockAt`) so every rep lowers it.
    let plainJoin = joinArmLit(
      thenPlain,
      armLit(thenPlain, n.ifThen),
      elsePlain,
      armLit(elsePlain, n.ifElse),
    )
    // A function's tail `if` already lowers an exiting arm as a return, so it needs no tail.
    if thenExits && !daElseDiverges && P.nodes[n.ifThen] is Block {
      if atValueArmTail(ix) { refuseNestedExitFirst(ix, elsePlain) }
      plainJoin = elsePlain
      if !ifChainOnFnTail {
        noteExitArm(n.ifThen)
        noteExitFirst(ix)
      }
    }
    const elseBlk = n.ifElse >= 0 && P.nodes[n.ifElse] is Block
    if daElseDiverges && !thenExits && elseBlk {
      plainJoin = thenPlain
      if !ifChainOnFnTail { noteExitArm(n.ifElse) }
    }
    if !f32Keep { f32JoinRevert(ix) }
    // A string literal arm joins to `string`; beside an arm whose type holds that literal it
    // takes that type instead, and a destination that holds each arm's value types the `if`, so
    // `if ok { a.look } else { "none" }` is a `Look` (DV-1207).
    if !thenExits && !daElseDiverges {
      const lj = litJoinOf(
        ix,
        plainJoin,
        [n.ifThen, n.ifElse],
        [thenPlain, elsePlain],
      )
      if lj >= 0 { plainJoin = lj }
    }
    if tpEnvNames.length > 0 && !thenExits && !daElseDiverges {
      let elseApart = elsePlain
      if elseIsLink { elseApart = tpIfJoinAt.get(n.ifElse) ?? elsePlain }
      noteTpIfJoin(
        ix,
        thenPlain,
        elseApart,
        plainJoin,
        ifTail || tpIfOkAt.has(ix),
      )
    }
    return plainJoin
  }
  // An else-less `if` used as a value is `T | null` in every position — the false fall-through
  // yields `null`. One rule asked once, replacing the old per-position gates (DECISIONS.md).
  if thenTy != TY_VOID && thenTy != TY_ERR { return mkNullableTy(thenTy) }
  return TY_VOID
}
// ── explicit numeric cast `x as T` ──────────────────────────────────────────

// `x as T` (B2) is an explicit, checked numeric conversion — unlike the implicit
// lossless-widening rule, it permits every numeric-scalar direction (plus narrowings and
// int/float conversions). The propagation obligation a bare `as` takes on, shared by the union
// and numeric arms; `src` is the operand's numeric type, or -1 for a union's remainder `rest`.
function castPropagationFits(
  rest: i32,
  asTy: string,
  ix: i32,
  curRet: i32,
  src: i32,
): boolean {
  // A pending return (-2, still inferring) is refused rather than joined into — a cast that
  // silently widens the function's own signature defeats the point of an explicit cast.
  if curRet == -2 {
    tErr(
      "`as "
        + asTy
        + "` propagates "
        + tyToStr(rest)
        + " — use `as!` to trap instead, or `as?` to take the null here"
        + castWrapNote(asTy, src)
        + "; to propagate it, annotate the enclosing function's return type",
      ix,
    )
    return false
  }
  // At module scope there is nowhere to propagate to, and "the enclosing function cannot
  // return it" would name a function that does not exist — its own sentence, its own fix.
  if curRet < 0 {
    tErr(
      "`as "
        + asTy
        + "` propagates "
        + tyToStr(rest)
        + " out of the enclosing function, and there is none here — at module scope, use `as!` to trap or `as?` to take a nullable"
        + castWrapNote(asTy, src),
      ix,
    )
    return false
  }
  if !assignable(rest, curRet) {
    tErr(
      "`as "
        + asTy
        + "` propagates "
        + tyToStr(rest)
        + ", which the enclosing function cannot return (it returns "
        + tyToStr(curRet)
        + ") — use `as!` to trap instead, or `as?` to take the null here"
        + castWrapNote(asTy, src),
      ix,
    )
    return false
  }
  true
}

// Parks an `as` cast whose operand is still a hole: both of the trio's type-level questions
// depend on the operand, and a hole answers neither, so the numeric ladder admits the cast and
// types it `T`. One row per cast site, re-asked by `holeCastPinCheck` at the call that pins
// the hole (D1342).
function noteCastDemand(name: string, n: AsExpr, ix: i32, target: i32) {
  if name == "" { return 0 }
  // The pin describes the parameter, so the demand may only speak for a direct read of it —
  // `const b = a ?? 0` retypes `b`, so a rung reading the pin there must not fire on `b`.
  const vn = castOperandIdent(n.asObj)
  if vn == "" { return 0 }
  // A narrowing in force over the operand's place is the operand's type, not the pin's:
  // `a = 7` ahead of the cast leaves the parameter pinned while the cast reads a value that can't fail.
  if narrowedPathTy(vn) >= 0 { return 0 }
  // ...and a write to the hole binding is the same fact with no overlay to carry it: a hole
  // has nothing to narrow from, so only the write's own record says the pin has stopped describing it.
  if castClobbered(name + "." + vn) { return 0 }
  // An `is` guard over the hole means the same thing one statement out — declining is the
  // safe direction (never adds a refusal); this rung exists to close exactly that divergence.
  if holeHasIsAlt(name) { return 0 }
  let i = 0
  while i < holeCastIx.length {
    if holeCastIx[i] == ix { return 0 }
    i = i + 1
  }
  holeCastNames.push(name)
  holeCastModePush(n.asMode)
  holeCastVarPush(vn)
  holeCastTgtTyPush(target)
  holeCastTgtNamePush(n.asTy)
  holeCastIxPush(ix)
  holeCastRetPush(T.curRet)
  holeCastArgNPush(0 - 1)
  holeCastArgExpPush(0 - 1)
  holeCastArgIxPush(0 - 1)
  0
}

// Every parked cast on hole `name`, re-asked under the type this call site pinned it to. The
// same shape `holeIsArrayDemanded` uses: the body records what it needs to know, and the
// argument is the first place the answer exists. Gated on the real pass because the `as?` half
// writes a node type, which a probe's save/restore does not cover.
function holeCastPinCheck(name: string, at: i32, pName: string) {
  if inferQuiet { return 0 }
  if at < 0 { return 0 }
  if pName == "" { return 0 }
  if tyIsHole(at) { return 0 }
  let k = 0
  while k < holeCastNames.length {
    if holeCastNames[k] == name && holeCastVar[k] == pName {
      castPinAdjudicate(k, at)
    }
    k = k + 1
  }
  0
}

// One parked cast, adjudicated against the pinned operand type `at`. The ladder is
// `checkCastNode`'s own, minus the arms a hole already answered — this rung must never be the
// first place a cast is rejected for a reason the direct spelling reports differently.
function castPinAdjudicate(k: i32, at: i32) {
  const target = holeCastTgtTy[k]
  if target < 0 { return 0 }
  const mode = holeCastMode[k]
  if mode == "trap" { return 0 }
  const castIx = holeCastIx[k]
  // `as%` picks no arm and cannot fail, so the pin answers only the two questions a hole hid:
  // is the pinned operand a number at all, and is either side a float.
  if mode == "wrap" { return castPinWrapCheck(at, target, castIx) }
  // A nullable operand is a union operand, expanded exactly as `checkCastNode`'s arm expands
  // it — one rule, two entry points, so the hole and the annotation cannot disagree.
  let argU = at
  const argN = T.tys[at]
  if argN is TyNullable {
    if argN.nInner >= 0 {
      const nulU = mkUnionTy([argN.nInner, TY_NULL])
      if nulU >= 0 { argU = nulU }
    }
  }
  const argT = T.tys[argU]
  const dom = numCastDomainName(holeCastTgtName[k], target)
  if argT is TyUnion {
    // A numeric union converts at the member it holds where no member can fail, as there.
    if numUnionAsConverts(argU, target) { return 0 }
    // `as u8` over a union, refused at the pin in `checkCastNode`'s own words (D1587) — the
    // hole is where the operand's union first becomes visible; declining silently would diverge.
    if dom == "u8" {
      tErr(
        "`as u8` narrows a number into 0..255, and "
          + tyToStr(argU)
          + " is a union — take the numeric arm first, then the range (`(x as! i32) as! u8`)",
        castIx,
      )
      return 0
    }
    if !unionCoversTy(argT, target) { return 0 }
    const rest = subtractTy(argU, target)
    if rest < 0 { return 0 }
    if mode == "null" { return castPinNullLand(k, castIx, target) }
    castPropagationFits(rest, holeCastTgtName[k], castIx, holeCastRet[k], -1)
    return 0
  }
  const sn = primNameStr(primNameOf(at))
  // A pin at no number is never the target, so the cast fails there as a fallible one can. A
  // `boolean` pin converts exactly, as the direct spelling does.
  if sn == "boolean" { return 0 }
  const snNum = sn == "i32" || sn == "i64" || sn == "f32" || sn == "f64"
  if snNum && !numCastCanFail(sn, dom) { return 0 }
  if mode == "null" { return castPinNullLand(k, castIx, target) }
  castPropagationFits(TY_NULL, holeCastTgtName[k], castIx, holeCastRet[k], at)
  0
}

// D1371 — the re-record is not the whole answer: the body already handed the cast's value
// somewhere, at the pre-pin type, so it must be re-asked here through `argMismatchErr` — the
// one home of both the wording and the anchor, so the hole reports character-for-character
// what the annotated twin reports at the same position.
function castPinNullLand(k: i32, castIx: i32, target: i32) {
  castPinNullResult(castIx, target)
  const exp = holeCastArgExp[k]
  if exp < 0 { return 0 }
  const nt = nodeTyIxOf(castIx)
  if nt < 0 { return 0 }
  if assignable(nt, exp) { return 0 }
  argMismatchErr(holeCastArgN[k], exp, nt, holeCastArgIx[k])
  0
}

// Whether a numeric cast can fail, under the owner's ruling: a cast to an integer target is
// exact-or-fail, a cast to a float target rounds and cannot. `u8` is a domain, not a target
// type (D1587) — `x as u8` produces an `i32`, and what `u8` names is the range 0..255, so
// every numeric source (i32 included) can fail it. The nine pairs are closed, matching the emitter (D965).

// Reports and answers true when a wrap cast names a float on either side. `as%` is integers
// only by ruling, and the refusal names the family that does convert a float. One home for the
// wording, because a hole operand re-asks it at the call site that pins the width.
function wrapCastFloatRefused(argTy: i32, target: i32, ix: i32): boolean {
  const sn = primNameStr(primNameOf(argTy))
  const tn = primNameStr(primNameOf(target))
  let bad = ""
  if sn == "f32" || sn == "f64" { bad = sn }
  if tn == "f32" || tn == "f64" { bad = tn }
  if bad == "" { return false }
  tErr(
    "`as%` wraps between integer widths, and "
      + bad
      + " is a float — use the exact family (`as!` traps, `as?` yields null)",
    ix,
  )
  true
}

// One parked `as%` cast, re-asked under the type its call site pinned the hole to. Reported in
// `checkCastNode`'s own words, so the pin and the direct spelling cannot disagree.
function castPinWrapCheck(at: i32, target: i32, castIx: i32) {
  if primNameOf(at) == "boolean" {
    tErr(AS_WRAP_BOOL_MSG, castIx)
    return 0
  }
  if !isNumeric(at) {
    tErr("`as` supports numeric conversions only", castIx)
    return 0
  }
  if wrapCastFloatRefused(at, target, castIx) { return 0 }
  0
}

// Raises the redundant-cast refusal when cast `n` at `ix` names the type its operand already
// has (`t as! string` after `t is string`), with the edit that drops it; false otherwise.
function redundantCastRaise(
  n: AsExpr,
  arg: i32,
  target: i32,
  ix: i32,
): boolean {
  if arg < 0 || target < 0 || arg == TY_ERR || target == TY_ERR { return false }
  if !tyEq(softenLitTy(arg), target) { return false }
  let what = "this value"
  const on = P.nodes[n.asObj]
  if on is Ident { what = "`" + on.identName + "`" }
  let form = "as"
  if n.asMode == "trap" { form = "as!" }
  if n.asMode == "null" { form = "as?" }
  if n.asMode == "wrap" { form = "as%" }
  let data = ""
  const st = nodeStartTok(ix)
  const ot = nodeLastTok(n.asObj)
  // A one-token operand (a literal, `this`) is named as written.
  if st >= 0 && ot == st && ot < P.toks.length {
    what = "`" + P.toks[st].text + "`"
  }
  if st >= 0 && ot >= st && ot < P.toks.length {
    const keep = P.toks[ot].start + P.toks[ot].text.length - P.toks[st].start
    if keep > 0 { data = diagDataField("keep", i32ToStr(keep)) }
  }
  tErrCodedData(
    what
      + " is already `"
      + tyToStr(target)
      + "` here, so the `"
      + form
      + "` cast does nothing — drop it",
    ix,
    CODE_REDUNDANT_CAST,
    data,
  )
  true
}

function checkCastNode(n: AsExpr, ix: i32) {
  let arg = checkNode(n.asObj)
  let target = nameToTyAt(n.asTy, ix)
  const targetClash = if target < 0 { unkTyClash } else { "" }
  // `x as u8` is the i64->i32 narrowing with a different domain (D1587): `u8` is a storage
  // type resolving to nothing in value position, but narrows the number into 0..255, exactly-or-fail.
  const isU8Cast = target < 0 && n.asTy == "u8"
  if isU8Cast { target = TY_I32 }
  if target < 0 {
    // A reason the resolver banked (a float literal) is the whole diagnostic, as for `is`.
    if targetClash.length > 0 {
      tErr(targetClash, ix)
    } else {
      tErr("unknown type `" + n.asTy + "` in `as` cast", ix)
    }
    return TY_ERR
  }
  // A literal tree cast exactly to `i64` is computed there, as one delivered to an `i64` is
  // (D2709). The wrap cast keeps the 32-bit reading it names.
  if target == TY_I64 && arg == TY_I32 && n.asMode != "wrap" {
    if litTreeAdoptDst(parenPeelIx(n.asObj), TY_I64) >= 0 { arg = TY_I64 }
  }
  // A hole operand answers neither of the trio's type-level questions, so the numeric ladder
  // admits it on purpose — park both on the hole, re-asked at the call site that pins it (D1342).
  if arg >= 0 {
    const argH = T.tys[arg]
    if argH is TyVar {
      noteCastDemand(argH.tvName, n, ix, target)
      // A pin may make `as?` to a number miss (a union arm, a narrowing number, another type),
      // so over a type parameter or a hole it is `N | null` at every pin, as over a union
      // (D2754, D3654).
      if n.asMode == "null" && isNumericPrimTy(target) {
        return mkNullableTy(target)
      }
    }
  }
  // Union-operand `as` is the ruled propagation cast: `x as T` over `x: A|B|...` names the arm
  // wanted, everything else is the error. A nullable operand is a union operand — one arm, no second ladder.
  let argU = arg
  if arg >= 0 {
    const argN = T.tys[arg]
    if argN is TyNullable {
      if argN.nInner >= 0 {
        const nulU = mkUnionTy([argN.nInner, TY_NULL])
        if nulU >= 0 { argU = nulU }
      }
    }
  }
  // `as%` picks no arm — it is the wrap cast over two integer widths, so a union operand is
  // simply not a number and takes the numeric ladder's own refusal below.
  if argU >= 0 && n.asMode != "wrap" {
    const argT = T.tys[argU]
    if argT is TyUnion {
      // `as u8` narrows a number, it does not pick an arm (D1587) — a union operand taking
      // the arm ladder would hand back the arm's own `i32` with no range test.
      if isU8Cast {
        tErr(
          "`as u8` narrows a number into 0..255, and "
            + tyToStr(argU)
            + " is a union — take the numeric arm first, then the range (`(x as! i32) as! u8`)",
          ix,
        )
        return TY_ERR
      }
      // A numeric union converts at whichever member it holds when no member's conversion
      // can fail, as each member alone would.
      if numUnionAsConverts(argU, target) && !njExprHeld(n.asObj) {
        return target
      }
      if !unionCoversTy(argT, target) {
        // A gradual union's parameter may hold the target at a pin: the cast is parked on the
        // parameter and re-asked there, as over a bare one (D2906).
        if unionHasDeclaredParam(argT.uMembers) {
          noteBinCstr(argU, OP_AS, target)
          if n.asMode == "null" { return mkNullableTy(target) }
          return target
        }
        tErr(
          "`as "
            + n.asTy
            + "` names a type that is not a member of "
            + tyToStr(argU),
          ix,
        )
        return TY_ERR
      }
      const twin = mapTwinTestMsg([argU], target, "`as`")
      if twin != "" {
        tErr(twin, ix)
        return TY_ERR
      }
      const rest = subtractTy(argU, target)
      if rest < 0 {
        tErr(
          "`as` cannot compute the propagated remainder of " + tyToStr(argU),
          ix,
        )
        return TY_ERR
      }
      // `as!` traps on a miss, so nothing is propagated and the enclosing return is not
      // consulted at all — that is the whole point of the form.
      if n.asMode == "trap" { return target }
      // `as?` coalesces to null, so the expression is `T | null` — again nothing propagates.
      // Whether `T | null` has a rep at all is the emitter's question, not this checker's.
      if n.asMode == "null" { return mkNullableTy(target) }
      // The propagated remainder must fit the enclosing return, because that is where it
      // goes. A pending return (-2) is refused rather than joined into.
      if !castPropagationFits(rest, n.asTy, ix, T.curRet, -1) { return TY_ERR }
      return target
    }
  }
  // A v128 to a v128 (a `new v128` brand on either side, or both) re-brands the same 128 bits:
  // no conversion, cannot fail, so every mode but `as%` answers the target itself.
  if primNameOf(target) == "v128" && arg >= 0 && primNameOf(arg) == "v128" {
    if n.asMode != "wrap" { return target }
  }
  const tn = primNameOf(target)
  const targetIsScalar = tn == "i32"
    || tn == "i64"
    || tn == "f32"
    || tn == "f64"
  // A `boolean` converts to any numeric target as 1 or 0: exact, so it never fails and every
  // mode answers the target. `as%` names a wrap between integer widths, which a boolean is not.
  if targetIsScalar && arg >= 0 && primNameOf(softenLitTy(arg)) == "boolean" {
    if n.asMode == "wrap" {
      tErr(AS_WRAP_BOOL_MSG, ix)
      return TY_ERR
    }
    return target
  }
  if !isNumeric(arg) || !targetIsScalar {
    if redundantCastRaise(n, arg, target, ix) { return TY_ERR }
    tErr(
      "`as` supports numeric conversions only" + emptyArrCastHint(n.asObj, target),
      ix,
    )
    return TY_ERR
  }
  // `as%` keeps the low bits and cannot fail, so it owes none of the trio's sad-path answers
  // and the target type is the whole result (`DECISIONS.md` §"`as%` is the wrap cast").
  if n.asMode == "wrap" {
    if wrapCastFloatRefused(arg, target, ix) { return TY_ERR }
    return target
  }
  const constCast = castConstDecide(n, ix, arg, target)
  if constCast == 1 { return target }
  if constCast == 2 { return TY_ERR }
  if castBoundDecide(n, ix, arg, target) { return target }
  // The numeric arm honours the trio too: a cast that can fail owes the same three answers
  // the union arm gives, from the same words — the suffix went unchecked and silently ignored (D1041).
  const castDom = numCastDomainName(n.asTy, target)
  if numCastCanFail(primNameStr(primNameOf(arg)), castDom) {
    // `as!` traps on a miss, so nothing is propagated and the enclosing return is not
    // consulted — the same reading as the union arm's trap mode.
    if n.asMode == "trap" { return target }
    // `as?` re-wraps to `T | null` and the null stays local to the expression.
    if n.asMode == "null" { return mkNullableTy(target) }
    // A bare `as` propagates `null`, so the enclosing return must carry it.
    if !castPropagationFits(TY_NULL, n.asTy, ix, T.curRet, arg) {
      return TY_ERR
    }
  }
  target
}

// A cast over a constant tree is decided at its exact value (D3588): a value the domain holds
// converts exactly in every mode, a value it does not hold is a check error. 0 when the operand
// is no constant, 1 when it holds, 2 when refused. A radix pattern whose top bit is set at its
// own width stays the width-dependent reading the ordinary cast takes.
function castConstDecide(n: AsExpr, ix: i32, arg: i32, target: i32): i32 {
  const p = parenPeelIx(n.asObj)
  if p < 0 || cexTreeShape(p, 0) != 1 { return 0 }
  const v = cexEvalAt(p, 0)
  if !cexOk(v) { return 0 }
  if v.cxPat {
    let bits = 32
    if arg == TY_I64 { bits = 64 }
    if v.cxNeg || !cexFitsSigned(v, bits) { return 0 }
  }
  const dom = numCastDomainName(n.asTy, target)
  const why = castConstMisfit(v, dom, p)
  if why != "" {
    tErr(why + castConstModeTail(n.asMode, dom, v), ix)
    return 2
  }
  castConstSettle(n, ix, v, arg, dom)
  1
}

// ── unary ──────────────────────────────────────────────────────────────────

// Extracted from `checkNodeReal`'s `Unary` arm (C3: thin the dispatcher).
function checkUnaryNode(n: Unary, ix: i32) {
  const arg = checkNode(n.unArg)
  if n.unOp == "!" {
    if !assignable(arg, TY_BOOL) {
      tErr("operator '!' expects boolean, got " + tyToStr(arg), ix)
    }
    return TY_BOOL
  }
  // Postfix `x++`/`x--`: `unArg` is the `x = x +- 1` assignment, already fully checked
  // above (const-reassign, arithmetic, assignability). The postfix type is the operand's.
  if n.unOp == "p+" || n.unOp == "p-" {
    if numUnionMinted && tyIsNumUnion(arg) {
      tErr(
        "'++'/'--' over the numeric union "
          + tyToStr(arg)
          + " is not supported; write `x += 1`",
        ix,
      )
      return TY_ERR
    }
    if !isNumeric(arg) {
      tErr("'++'/'--' expects a numeric variable, got " + tyToStr(arg), ix)
      return TY_ERR
    }
    return arg
  }
  // The negation of an unpinned intrinsic element takes the default its binary siblings
  // take (D1566), asked here (not above `!`) since `!a[0]` is admitted over an open operand today.
  let arg2 = arg
  if arg2 < 0 {
    const peekU = arrDefOperandElemPeek(n.unArg)
    if peekU >= 0 { arg2 = peekU }
  }
  // A hole operand is numeric only at a pin that says so; the pin re-asks it (`OP_NEG`, or
  // `OP_BNOT` for `~`, which a float pin cannot satisfy).
  if arg2 >= 0 && !(T.tys[arg2] is TyPrim) && tyHasHole(arg2) {
    let unCstr = OP_NEG
    if n.unOp == "~" { unCstr = OP_BNOT }
    noteBinCstr(arg2, unCstr, arg2)
    arg2 = tpGradualView(arg2)
  }
  // A numeric union negates at each member's own type.
  if (
    numUnionMinted
    && n.unOp == "-"
    && tyIsNumUnion(arg2)
    && !njExprHeld(n.unArg)
  ) {
    return arg2
  }
  // A literal set negates at its base, as `x - 1` computes over it.
  if n.unOp == "-" && !isNumeric(arg2) && isNumeric(softenLitOpTy(arg2)) {
    arg2 = softenLitOpTy(arg2)
  }
  if !isNumeric(arg2) {
    tErr(
      "unary '" + n.unOp + "' expects a numeric type, got " + tyToStr(arg2),
      ix,
    )
    return TY_ERR
  }
  // `~` flips bits and a float has none, the binary bitwise family's rule (D3629).
  if n.unOp == "~" && binFloatOperandPair(arg2, arg2) {
    tErr("operator '~' is integer-only, got " + tyToStr(arg2), ix)
    return TY_ERR
  }
  // Host parity: the host folds `-lit` into a signed literal before defaulting, so
  // `-2147483648` sits at I32_MIN and is i32 even though the bare literal alone types i64.
  // A chain a wide destination adopted keeps its 64-bit leaf on a re-check.
  if n.unOp == "-" {
    if isNegI32MinLit(n.unArg) && litTreeTyOf(parenPeelIx(n.unArg)) != TY_I64 {
      return TY_I32
    }
  }
  arg2
}
// ── getters `get p(self: T): R` (property-access-design.md §D3a) ──────────────

// The type of a getter read `v.prop` at member node `ix`, banking the site for the rewrite
// into a call. A write through a getter, or a read of a getter another module did not export,
// is refused here and banks nothing.
function getterReadTy(fn: string, n: Member, ix: i32) {
  if ix == getWriteTarget {
    tErr(
      "cannot assign to `."
        + n.memProp
        + "`: it reads the "
        + getDeclLabel(fn)
        + ", and a getter is read-only",
      ix,
    )
    return TY_ERR
  }
  const gi = getRowOf(fn)
  if gi < 0 { return TY_ERR }
  if !getterVisibleAt(gi, ix) {
    tErr(
      "the "
        + getDeclLabel(fn)
        + " is not exported by the module that declares it — write `export get "
        + n.memProp
        + "` there",
      ix,
    )
    return TY_ERR
  }
  getSiteBank(ix, fn)
  const fnTy = lookup(fn)
  if fnTy < 0 { return TY_ERR }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    if ft.fnRet < 0 { return TY_ERR }
    if symEnabled != 0 {
      symMemGetter.push(ix)
      symMemGetterDecl.push(getDecls[gi])
    }
    return symMem(ix, ft.fnRet)
  }
  TY_ERR
}

// ── the getter declaration and body contract (§D3a-contract) ──────────────────

// ── the per-function summary (function-effects-design.md §C1, D2135) ─────────

// ── the getter step budget (§D3a-contract, D2061) ────────────────────────────

// ── the summary in words (hover, the dump) ───────────────────────────────────

// ── a union of lists (D2874) ────────────────────────────────────────────────
// `.length`, `u[i]` and `for v in u` over a union whose every member is a list. The real pass
// rewrites each site in place into an `is` chain over a `const` holding the receiver, so it
// lowers as the narrowed spelling does; a quiet pass may see a partial union and only types it.

// The union of the members' element types, each read at its value type, kept apart rather
// than widened (`f64[] | i32[]` reads `f64 | i32`). -1 when the elements have no union.
function luElemTy(ms: i32[]): i32 {
  let e = -1
  let i = 0
  while i < ms.length {
    const a = T.tys[ms[i]]
    if a is TyArray {
      const v = arrElemValueTy(a.aElem)
      if v < 0 { return -1 }
      if e < 0 { e = v } else { e = joinVariantTys(e, v) }
    }
    i = i + 1
  }
  if e == TY_ERR {
    joinClashMsgSet("")
    return -1
  }
  e
}

// The spelling the rewrite names `ty` by in an `is` test or an annotation: the first of its
// display name and its emit name that resolves back to `ty`, or "" when neither does. A failed
// resolution's diagnostics are dropped, since the answer is the whole point of asking.
export function luSpell(ty: i32): string {
  const dn = luPipeTight(tyToStr(ty))
  if luSpellsAs(dn, ty) { return dn }
  const en = tyToEmitName(ty)
  if en != "" && luSpellsAs(en, ty) { return en }
  // A function type's display name spaces its arrow, which no annotation name does; its emit
  // name spells a literal-union parameter by its old base scalar.
  const an = luArrowTight(dn)
  if an != dn && luSpellsAs(an, ty) { return an }
  // A union naming a type parameter, whose written form resolves to one member when its lists
  // meet: spelled for the pin to substitute, and typed through `luAnnTy`.
  if luUnionSpellsByMember(ty) { return dn }
  ""
}

// Whether `ty` is a union naming a type parameter each of whose members has a spelling.
function luUnionSpellsByMember(ty: i32): boolean {
  if ty < 0 || !tyHasTyVar(ty) { return false }
  const t = T.tys[ty]
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if luSpell(t.uMembers[i]) == "" { return false }
      i = i + 1
    }
    return true
  }
  false
}

function luSpellsAs(name: string, ty: i32): boolean {
  const mark = T.diags.length
  const back = nameToTy(name)
  while T.diags.length > mark { T.diags.pop() }
  back >= 0 && (tySame(back, ty) || tyEq(back, ty))
}

// Whether the union `u` and each of its members `ms` have a spelling. The receiver's `const`
// is annotated at `u` itself, since an un-annotated copy of a null-narrowed union reads its
// complement arm at the wrong rep (D2875).
function luAllSpell(u: i32, ms: i32[]): boolean {
  if luSpell(u) == "" { return false }
  let i = 0
  while i < ms.length {
    if luSpell(ms[i]) == "" { return false }
    i = i + 1
  }
  true
}

// `kw name[: ann] = init`, where `ann` is a type rendered to its spelling (-1: none).
function luDecl(
  kw: string,
  name: string,
  ann: i32,
  init: i32,
  site: i32,
  pos: i32,
): i32 {
  let tr = -1
  if ann >= 0 {
    tr = luAt(mkTypeRef(luSpell(ann), pos), site)
    luAnnTyPut(tr, ann)
  }
  luAt(mkLet(kw, name, tr, init, pos), site)
}

// One arm's value over list `recv`: its `.length`, or with an index its element, delivered
// through a `const` at the element union so each arm boxes into the same rep.
function luArm(recv: string, idx: string, elem: i32, site: i32, pos: i32): i32 {
  const stmts: i32[] = []
  if idx == "" {
    stmts.push(luAt(mkMember(luRef(recv, site, pos), "length", pos), site))
  } else {
    const rd = luAt(
      mkIndex(luRef(recv, site, pos), luRef(idx, site, pos), pos),
      site,
    )
    const tmp = "$le" + i32ToStr(site)
    stmts.push(luDecl("const", tmp, elem, rd, site, pos))
    stmts.push(luRef(tmp, site, pos))
  }
  luAt(mkBlock(stmts, pos), site)
}

// The `is` chain over `recv`'s members from `k` on, the last member being the bare `else`.
function luChain(
  ms: i32[],
  k: i32,
  recv: string,
  idx: string,
  elem: i32,
  site: i32,
  pos: i32,
): i32 {
  const arm = luArm(recv, idx, elem, site, pos)
  // A union with a type parameter's list tests its last member too: a complement cannot
  // narrow it, since the parameter may be the same list at the pin.
  const open = luAnyTyVar(ms)
  if k >= ms.length - 1 && !open { return arm }
  const test = luAt(mkIsExpr(luRef(recv, site, pos), luSpell(ms[k]), pos), site)
  if k >= ms.length - 1 {
    const tl: i32[] = []
    tl.push(luAt(mkCall(luRef("__trap__", site, pos), [], pos), site))
    return luAt(mkIf(test, arm, luAt(mkBlock(tl, pos), site), pos), site)
  }
  const rest = luChain(ms, k + 1, recv, idx, elem, site, pos)
  luAt(mkIf(test, arm, rest, pos), site)
}

// `recv.length` over a union of lists: i32, or -1 when `objTy` is not one the rewrite names.
function luLengthAt(n: Member, ix: i32, objTy: i32): i32 {
  if luOwnRecv(n.memObj) || (luWriteTgt[ix] ?? false) { return -1 }
  const ms = luMembers(objTy)
  if ms.length == 0 || !luRecvLowers(n.memObj, ms) { return -1 }
  if inferQuiet { return symMem(ix, TY_I32) }
  if !luAllSpell(objTy, ms) { return -1 }
  const recv = "$lu" + i32ToStr(ix)
  const stmts: i32[] = []
  stmts.push(luDecl("const", recv, objTy, n.memObj, ix, n.pos))
  stmts.push(luChain(ms, 0, recv, "", -1, ix, n.pos))
  luValueAt(ix, stmts, n.pos)
  checkNode(ix)
}

// `recv[i]` read over a union of lists: the element union, or -1 as `luLengthAt`. A write
// through the index is not rewritten, since storing one arm's element in another is unsound.
function luIndexAt(n: Index, ix: i32, arrTy: i32): i32 {
  if luWriteTgt[ix] ?? false { return -1 }
  if luOwnRecv(n.idxArr) { return -1 }
  const ms = luMembers(arrTy)
  if ms.length == 0 || !luRecvLowers(n.idxArr, ms) { return -1 }
  const elem = luElemTy(ms)
  if elem < 0 { return -1 }
  if inferQuiet { return elem }
  if !luAllSpell(arrTy, ms) || luSpell(elem) == "" { return -1 }
  const recv = "$lu" + i32ToStr(ix)
  const idx = "$li" + i32ToStr(ix)
  const stmts: i32[] = []
  stmts.push(luDecl("const", recv, arrTy, n.idxArr, ix, n.pos))
  stmts.push(luDecl("const", idx, -1, n.idxIndex, ix, n.pos))
  stmts.push(luChain(ms, 0, recv, idx, elem, ix, n.pos))
  luValueAt(ix, stmts, n.pos)
  checkNode(ix)
}

// `for v[, i] in recv { body }` over a union of lists, rewritten in place to
// `{ const $lu = recv; let $li = 0; while true { if $li >= <len> { break }; let i = $li;
// $li = $li + 1; let v: E = <$lu[i]>; body } }`, which re-reads the length every pass as a
// list's own loop does. -1 when a member or the element union has no spelling.
function luForInAt(n: ForIn, ix: i32, iterTy: i32, ms: i32[], elem: i32): i32 {
  if !luAllSpell(iterTy, ms) || luSpell(elem) == "" { return -1 }
  const pos = n.pos
  const recv = "$lu" + i32ToStr(ix)
  const ctr = "$li" + i32ToStr(ix)
  let at = n.fiVar2
  if at == "" { at = "$lk" + i32ToStr(ix) }
  const outer: i32[] = []
  outer.push(luDecl("const", recv, iterTy, n.fiIter, ix, pos))
  outer.push(luDecl("let", ctr, -1, luAt(mkNum("0", pos), ix), ix, pos))
  const lenCond = luAt(
    mkBinary(
      ">=",
      luRef(ctr, ix, pos),
      valueIfAdd(luChain(ms, 0, recv, "", -1, ix, pos)),
      pos,
    ),
    ix,
  )
  const brk: i32[] = []
  brk.push(luAt(mkBreak("break", "", pos), ix))
  const loop: i32[] = []
  loop.push(luAt(mkIf(lenCond, luAt(mkBlock(brk, pos), ix), -1, pos), ix))
  const atDecl = luDecl("let", at, -1, luRef(ctr, ix, pos), ix, pos)
  luDeclPosPut(atDecl, n.fiIter)
  loop.push(atDecl)
  const inc = luAt(
    mkBinary("+", luRef(ctr, ix, pos), luAt(mkNum("1", pos), ix), pos),
    ix,
  )
  loop.push(luAt(mkBinary("=", luRef(ctr, ix, pos), inc, pos), ix))
  const val = valueIfAdd(luChain(ms, 0, recv, at, elem, ix, pos))
  const vDecl = luDecl("let", n.fiVar, elem, val, ix, pos)
  luDeclPosPut(vDecl, n.fiIter)
  loop.push(vDecl)
  const bn = P.nodes[n.fiBody]
  if bn is Block {
    let i = 0
    while i < bn.blkStmts.length {
      loop.push(bn.blkStmts[i])
      i = i + 1
    }
  } else {
    loop.push(n.fiBody)
  }
  const cond = luAt(mkBool(1, -1), ix)
  const body = luAt(mkBlock(loop, pos), ix)
  outer.push(luAt(mkWhile(cond, body, n.fiLabel, pos, 0), ix))
  // `if true { … }` rather than a bare block, the statement form every walk descends.
  const once = luAt(mkBool(1, -1), ix)
  const w: Node = {
    ifCond: once,
    ifThen: luAt(mkBlock(outer, pos), ix),
    ifElse: -1,
    pos: pos,
  }
  arenaSetNode(ix, w)
  luGrow()
  checkNode(ix)
}

// ── a function value at another function type (D3073) ──────────────────────
// A function value keeps the `$fnsig` it carries, so a call through a function type of another
// rep traps. The delivery is rewritten in place into `(p…): R => f(p…)` at the destination's
// type and checked as written code; a conversion that code cannot make is refused there.

// The annotation node naming `ty` for the adapter, or -1 when it has no spelling. The checker
// reads the type itself; the spelling is the display name, which the emitter reads as the
// author's own annotation, since the emit spelling renders a named record structurally.
function fvaAnnot(ty: i32, site: i32, pos: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  let sp = ""
  // A single literal type is spelled by its base scalar, which it is stored as; the checker
  // reads the literal itself from `luAnnTy`.
  const sty = litPeekBaseTy(ty)
  if isVoidTy(sty) { sp = "void" } else { sp = luPipeTight(tyToStr(sty)) }
  if sp == "" || luSpell(sty) == "" { return -1 }
  // The display name leaves a nullable function type's arrow unparenthesised.
  const t = T.tys[ty]
  if t is TyNullable && t.nInner >= 0 {
    if T.tys[t.nInner] is TyFunc {
      sp = "(" + luPipeTight(tyToStr(t.nInner)) + ")|null"
    }
  }
  const tr = luAt(mkTypeRef(sp, pos), site)
  luAnnTyPut(tr, ty)
  tr
}

// The function arm of union `u` that a value of function type `src` converts into; -1 when no
// arm needs a conversion to take it, -2 when more than one converting arm would.
function fvaUnionArm(u: TyUnion, src: i32): i32 {
  let found = -1
  for m in u.uMembers {
    if m == src || tyEq(m, src) { return -1 }
    if T.tys[m] is TyFunc && assignable(src, m) {
      if !fvaFnMayDiffer(src, m, 8) { return -1 }
      if found >= 0 { return -2 }
      found = m
    }
  }
  found
}

// Rewrites the function value at `srcExpr`, of type `srcTy`, into an adapter at `dstTy`'s
// function type, when the two may differ in rep. True when the delivery is settled here,
// rewritten or refused; false leaves it to the caller unchanged.
function fvaAdapt(srcExpr: i32, srcTy: i32, dstTy: i32): boolean {
  fvaNoteNameDecl(srcExpr)
  if srcTy == dstTy || inferQuiet || monoRecheckDepth > 0 { return false }
  if srcExpr < 0 || srcTy < 0 || dstTy < 0 { return false }
  if srcTy >= T.tys.length || dstTy >= T.tys.length { return false }
  if !tyMayHoldFn(dstTy, 0) { return false }
  // A literal delivers each element or field at the destination's own type, one seam down.
  const lit = P.nodes[parenPeelIx(srcExpr)]
  if lit is ArrayLit {
    const da = T.tys[nonNullTy(dstTy)]
    if da is TyArray {
      for el in lit.arrElems {
        if spreadArgOf(el) < 0 { fvaAdapt(el, nodeTyIxOf(el), da.aElem) }
      }
    }
    return false
  }
  if lit is ObjLit {
    const dob = T.tys[nonNullTy(dstTy)]
    if dob is TyObj {
      for fi in lit.objFields {
        const f = P.nodes[fi]
        if f is FieldInit {
          const ft = objFieldType(dob, f.fiName)
          if ft >= 0 { fvaAdapt(f.fiValue, nodeTyIxOf(f.fiValue), ft) }
        }
      }
    }
    return false
  }
  const dt = nonNullTy(dstTy)
  if dt < 0 { return false }
  const d = T.tys[dt]
  const s = T.tys[srcTy]
  if s is TyFunc && d is TyUnion {
    // A function delivered into a union lands in the one function arm it converts to.
    const arm = fvaUnionArm(d, srcTy)
    if arm >= 0 { return fvaAdapt(srcExpr, srcTy, arm) }
    if arm == -2 {
      fvaRefuse(
        srcExpr,
        srcTy,
        dt,
        "it converts into more than one function arm of the union",
      )
      return true
    }
  }
  if !(s is TyFunc) || !(d is TyFunc) {
    // A function inside a container is not rewritten on the way, so a call through the
    // destination's function type would reach it at another signature.
    if fvaNestedFnDiffers(srcTy, dstTy, 0, 8) {
      fvaRefuseNested(srcExpr, srcTy, dstTy)
      return true
    }
    return false
  }
  if s.fnRet < 0 || d.fnRet < 0 { return false }
  if tyHasTyVar(dt) || s.fnParamTypes.length != d.fnParamTypes.length {
    return false
  }
  const site = srcExpr
  const pe = P.nodes[parenPeelIx(site)]
  // A generic function named as a value is instantiated by the adapter's direct call, whatever
  // type the checker gave the name (D3112); any other type parameter in the source is an
  // enclosing generic's, pinned per instance.
  if fvaDone[site] ?? false { return false }
  if tyReachesHole(dt, 8) { return false }
  if !fvaNamesGeneric(pe, parenPeelIx(site)) {
    // A hole is pinned later, where the value's use decides it.
    if fnTyHasHole(srcTy) || tyHasTyVar(srcTy) || tyReachesHole(srcTy, 8) {
      return false
    }
    if !fvaFnMayDiffer(srcTy, dt, 8) { return false }
  }
  const pos = nodePos(site)
  const params: i32[] = []
  const args: i32[] = []
  let i = 0
  while i < d.fnParamTypes.length {
    const pt = fvaAnnot(d.fnParamTypes[i], site, pos)
    if pt < 0 {
      fvaRefuse(srcExpr, srcTy, dt, "")
      return true
    }
    const pn = "$fp" + i32ToStr(i)
    params.push(luAt(mkParam(pn, pt, -1, 0, 0, pos), site))
    args.push(luRef(pn, site, pos))
    i = i + 1
  }
  const rt = fvaAnnot(d.fnRet, site, pos)
  if rt < 0 {
    fvaRefuse(srcExpr, srcTy, dt, "")
    return true
  }
  // A function declaration or a `const` is stable; any other value is read once, as the
  // argument of an enclosing lambda called in place, so the adapter calls the delivered value
  // rather than what a `let` later holds.
  const stable = fvaStableName(pe, parenPeelIx(site))
  let callee = -1
  let fvParam = -1
  if stable {
    if pe is Ident { callee = luRef(pe.identName, site, pos) }
  } else {
    const st = fvaAnnot(srcTy, site, pos)
    if st < 0 {
      fvaRefuse(srcExpr, srcTy, dt, "")
      return true
    }
    const fv = "$fv" + i32ToStr(site)
    fvParam = luAt(mkParam(fv, st, -1, 0, 0, pos), site)
    callee = luRef(fv, site, pos)
  }
  const lam = fvaLambda(
    params,
    rt,
    luAt(mkCall(callee, args, pos), site),
    site,
    pos,
  )
  fvaDone.set(site, true)
  const mark = T.diags.length
  if stable {
    arenaSetNode(site, lam)
  } else {
    const moved = addNode(P.nodes[site])
    adoptNodeTok(moved, site)
    const li = luAt(addNode(lam), site)
    const outerPs: i32[] = []
    outerPs.push(fvParam)
    const outer = luAt(addNode(fvaLambda(outerPs, -1, li, site, pos)), site)
    const outerArgs: i32[] = []
    outerArgs.push(moved)
    const names: string[] = []
    const c: Node = {
      callFn: outer,
      callArgs: outerArgs,
      callArgNames: names,
      pos: pos,
    }
    arenaSetNode(site, c)
  }
  luGrow()
  const t = checkNode(site)
  if T.diags.length > mark || !assignable(t, dstTy) {
    let why = ""
    if T.diags.length > mark { why = T.diags[mark].tmsg }
    while T.diags.length > mark { T.diags.pop() }
    fvaRefuse(site, srcTy, dt, why)
  }
  true
}

// The refusal for a container whose functions would need an adapter each.
function fvaRefuseNested(at: i32, srcTy: i32, dstTy: i32) {
  tErr(
    "a `"
      + tyToStr(srcTy)
      + "` cannot be used as `"
      + tyToStr(dstTy)
      + "` here: a call through that type would reach a function it holds at a signature "
      + "the function does not have, and the functions inside a value are not converted on the way. Build the "
      + "value at `"
      + tyToStr(dstTy)
      + "`, or wrap each function in a lambda of the wider type where it is stored",
    at,
  )
  0
}

// The refusal for a function value whose adapter cannot be built: `why` is the checker's
// reason for refusing the adapter's own call or result, "" when a slot type has no spelling.
function fvaRefuse(at: i32, srcTy: i32, dstTy: i32, why: string) {
  let msg = "a function of type `"
    + tyToStr(srcTy)
    + "` cannot be used as `"
    + tyToStr(dstTy)
    + "` here: calling it through that type needs its arguments or result converted, and "
  if why == "" {
    msg = msg + "a parameter or result type has no spelling to convert through"
  } else {
    msg = msg + "that conversion is refused (" + why + ")"
  }
  tErr(msg, at)
  0
}

// ── member `o.field` ───────────────────────────────────────────────────────

// Refuses a write to the built-in `.length` of a list, map, set or string at member node `ix`
// (D3586): it is read-only, and the emitter has no store for it. `kind` 0 is a list, 1 a map
// or set, 2 a string. Returns true when it refused; a record's own `length` field never asks.
function lengthWriteRefused(n: Member, ix: i32, kind: i32): boolean {
  if ix != getWriteTarget || n.memProp != "length" { return false }
  let recv = "xs"
  const o = P.nodes[n.memObj]
  if o is Ident { recv = o.identName }
  let msg = "`length` is read-only"
  if kind == 0 {
    msg = msg
      + "; to empty a list use `"
      + recv
      + ".clear()` or `"
      + recv
      + " = []`"
  } else if kind == 1 {
    msg = msg + "; to empty a map or set use `" + recv + ".clear()`"
  }
  tErr(msg, ix)
  true
}

// Extracted from `checkNodeReal`'s `Member` arm (C3: thin the dispatcher).
function checkMemberNode(n: Member, ix: i32) {
  // Flat layout constant (webcraft P1.2): answered before the receiver is checked, since the
  // receiver is a TYPE name and checking it as an expression would be "undeclared identifier".
  const fl = flatMemberFold(n, ix)
  // The receiver of a folded layout member names a type, which no value binding declares.
  if fl == 1 || fl == 3 { identSet(n.memObj, IDENT_BUILTIN) }
  if fl == 1 { return TY_I32 }
  if fl == 2 { return TY_ERR }
  // A layout member on a type parameter: an `i32` whose value the monomorphizer
  // supplies per instance. The node stays a `Member` until then.
  if fl == 3 { return TY_I32 }
  // A flow-narrowed property path (`if o.v is T { … }`) overrides the stored
  // field type within the branch (the host's `narrowedPaths` overlay).
  const mKey = placeKeyOf(ix)
  if mKey != "" {
    const mOv = narrowedPathTy(mKey)
    if mOv >= 0 {
      identNotePlace(n.memObj)
      crNoteLoopRead(mKey, ix)
      crNoteCaptureRead(mKey)
      return symMem(ix, mOv)
    }
    crNoteLostRead(mKey, ix)
    const mInv = narrowedPathInvBy(mKey)
    if (
      mInv >= 0
      && !(luWriteTgt[ix] ?? false)
      && !pathReadsDeclared(mKey, mInv, ix)
    ) {
      return pathInvalidatedErr(mKey, mInv, ix)
    }
    if mInv < 0 { crPathDropRead(mKey, ix) }
  }
  const objTy0 = strLitRecvTy(checkNode(n.memObj))
  // A negative receiver type is an unpinned inference hole, not an arena index — indexing
  // `T.tys` with it would crash. Already reported elsewhere, so don't cascade.
  if objTy0 < 0 { return TY_ERR }
  let objTy = objTy0
  if T.tys[objTy0] is TyUnion {
    const gObj = tpGradualRecv(objTy0, n.memProp, ix)
    if gObj >= 0 && gObj < T.tys.length { objTy = gObj }
  }
  // A getter on the receiver's nominal type, when no field or built-in member shares its name.
  const gFn = getterFnFor(objTy, n.memProp)
  if gFn != "" { return getterReadTy(gFn, n, ix) }
  const ot = T.tys[objTy]
  if ot is TyObj {
    const ft = objFieldType(ot, n.memProp)
    if ft < 0 {
      memberFloorErr(objTy, n.memProp, ix)
      return TY_ERR
    }
    return symMem(ix, ft)
  }
  if ot is TyErr { return TY_ERR }
  // Shared-field access over a struct union — a field every member carries at the same
  // type; an unshared field still needs an `is` narrowing.
  if ot is TyUnion {
    const sf = sharedUnionFieldTy(ot, n.memProp)
    if sf >= 0 {
      sharedFieldJoinWidens(ot, n.memProp, sf, ix)
      return symMem(ix, sf)
    }
    if n.memProp == "length" {
      // A string-literal union is a string: its length is the member's (D3423).
      if tyIsLitUnion(objTy) {
        if lengthWriteRefused(n, ix, 2) { return TY_ERR }
        return symMem(ix, TY_I32)
      }
      const lul = luLengthAt(n, ix, objTy)
      if lul >= 0 { return lul }
    }
    // The field is on some but not all members — unsafe until narrowed to a member that
    // has it. Names the offending member so a reader need not diff a four-arm union by hand.
    memberFloorErr(objTy, n.memProp, ix)
    return TY_ERR
  }
  // `.length` on an array, a map, or a string is an i32.
  if ot is TyArray {
    if lengthWriteRefused(n, ix, 0) { return TY_ERR }
    if n.memProp == "length" { return symMem(ix, TY_I32) }
    memberFloorErr(objTy, n.memProp, ix)
    return TY_ERR
  }
  if ot is TyMap {
    // `.length` is the live-entry count (an i32), the one name every collection answers;
    // `.size` is refused with a redirect to it (`lengthSpellNote`).
    if lengthWriteRefused(n, ix, 1) { return TY_ERR }
    if n.memProp == "length" { return symMem(ix, TY_I32) }
    memberFloorErr(objTy, n.memProp, ix)
    return TY_ERR
  }
  if ot is TyPrim {
    if ot.primName == "string" {
      if lengthWriteRefused(n, ix, 2) { return TY_ERR }
      if n.memProp == "length" { return symMem(ix, TY_I32) }
      memberFloorErr(objTy, n.memProp, ix)
      return TY_ERR
    }
  }
  // Member access on an inference hole records the demanded field and yields its derived
  // hole; the call site pins both (A13).
  if ot is TyVar {
    // D14-L/D691: `.length` on a type parameter is admitted here and re-asked at the pin —
    // a bounded type parameter reads its members from its bound first, checked before `.length` (OQ-5).
    const bmTy = boundMemberTy(ot.tvName, n.memProp, false)
    if bmTy == BOUND_UNRESOLVED {
      tErr(boundMemberUnknownMsg(ot.tvName, n.memProp), ix)
      return TY_ERR
    }
    if bmTy >= 0 { return symMem(ix, bmTy) }
    const bmMsg = boundMemberFloorMsg(ot.tvName, n.memProp)
    if bmMsg != "" {
      tErr(bmMsg, ix)
      return TY_ERR
    }
    if n.memProp == "length" {
      noteMemCstr(objTy, n.memProp, ix, false)
      return symMem(ix, TY_I32)
    }
    // A place holding a written type-parameter value reads its members as the parameter does:
    // each pin re-asks the read of the member it lands on, a nullable one included (D3240).
    if tyIsWriteLandRead(objTy) {
      noteMemCstr(objTy, n.memProp, ix, false)
      const twFld = mkDerivedHole(HD_FLD, n.memProp, -1, -1, objTy)
      if twFld >= 0 { return symMem(ix, twFld) }
    }
    if ot.tvName.length > 0 {
      if ot.tvName[0] == '?' {
        noteNullReadCstr(objTy, n.memProp, ix, n.memObj)
        // A read off a parameter's derivation after a write or call ended its narrowing is
        // re-asked at its pin, as the direct spelling's read is (D3233); off an un-annotated
        // parameter's, only an `is` remainder every pin sees ended (D3420).
        if (
          narrowingEndedAt(n.memObj)
          && (tyIsDeclaredParam(hdRootTy(objTy))
            || holeRemainderEndedSure(n.memObj))
        ) {
          noteMemCstr(objTy, n.memProp, ix, false)
        }
        // `.length` is the i32 length an array/string/map exposes — treat it as that (not a
        // struct field), so a collection-shaped hole infers without growing a bogus `{length}` shape.
        return symMem(ix, holeMemberTy(objTy, ot.tvName, n.memProp))
      }
    }
    // An unbounded `<T>` is an entirely open hole: the member read derives its type as the
    // `?`-hole does, keyed by the receiver's arena type so each generic adjudicates its own calls (D1431).
    if tpBoundOfName(ot.tvName) < 0 {
      noteMemCstr(objTy, n.memProp, ix, true)
      const tpFld = mkDerivedHole(HD_FLD, n.memProp, -1, -1, objTy)
      if tpFld >= 0 { return symMem(ix, tpFld) }
    }
  }
  memberFloorErr(objTy, n.memProp, ix)
  return TY_ERR
}
// ── array literal ───────────────────────────────────────────────────────────
// `[e, e, ...]` types as `T[]` where `T` is the first element's type (the rest must be
// assignable to it). An empty `[]` is `T[]` with an unknown element (`-1`), assignable to any
// array — its concrete element is pinned by the binding's annotation.

// Extracted from `checkNodeReal`'s `ArrayLit` arm (C3: thin the dispatcher).
function checkArrayLitNode(n: ArrayLit, _ix: i32) {
  const elems = n.arrElems
  if elems.length < 1 { return mkArrayTy(-1) }
  if hasSpreadItem(elems) { return checkSpreadArrayLit(elems) }
  // A `void` element has no value to store — poisoned to `TY_ERR` rather than joined, so an
  // annotated literal keeps one "cannot assign" message instead of a second one.
  let elemTy = widenLitTy(checkNode(elems[0]))
  if voidValueSlotErr(elemTy, elems[0], "list element", elems[0]) {
    elemTy = TY_ERR
  }
  const ets: i32[] = [elemTy]
  let ei = 1
  while ei < elems.length {
    let et = widenLitTy(checkNode(elems[ei]))
    if voidValueSlotErr(et, elems[ei], "list element", elems[ei]) {
      et = TY_ERR
    }
    ets.push(et)
    // Host parity: the element type is the union of every element's type (flattened/deduped)
    // — mixed struct variants type as `(A | B | C)[]`; an annotation then checks structurally.
    elemTy = joinTys(elemTy, et)
    ei = ei + 1
  }
  const apart = listJoinApart(elems, ets)
  if apart >= 0 { elemTy = apart }
  // An f32 element beside literal ones types the list `f32[]`, as it does an `if` join.
  if (
    apart < 0
    && elemTy >= 0
    && primNameOf(elemTy) != "f32"
    && elems.length > 1
    && f32JoinRetypesRunning()
  ) {
    const f32El = f32LitJoinOf(elems, ets)
    if f32El >= 0 { elemTy = f32El }
  }
  if neverValueSlotErr(elemTy, "a list element", elems[0]) { elemTy = TY_ERR }
  if elemTy == TY_NULL { nolLitsPush(_ix) }
  if elemTy >= 0 && T.tys[elemTy] is TyUnion { ulLitNSet(ulLitN + 1) }
  return mkArrayTy(elemTy)
}

// The element type of a list literal whose runtime elements `elems` (typed `ets`) hold numbers
// of different types: they join apart, as the arms of an `if` do, and each literal element then
// adapts to that join. -1 when no two runtime elements could part, or the function is gated.
function listJoinApart(elems: i32[], ets: i32[]): i32 {
  // The common list has one element type, and settles without asking any element.
  let mixed = false
  for et in ets {
    if et != ets[0] { mixed = true }
  }
  if !mixed { return -1 }
  const run: i32[] = []
  const lits: i32[] = []
  let parts = false
  let i = 0
  while i < ets.length {
    const et = ets[i]
    if et < 0 || et == TY_ERR { return -1 }
    if armLit(et, elems[i]) {
      lits.push(et)
    } else {
      // A nullable element keeps master's widening outside a body checked at each pin: a
      // generic `==` over a list of nullable number unions does not lower (D3535).
      if tyAdmitsNull(et) && !njFnOpen(njFnIx) { return -1 }
      if run.length > 0 && njMayPart(run[0], et) && !tyEqSameHoles(run[0], et) {
        if njJoinGated(run[0], et, false) { return -1 }
        parts = true
      }
      run.push(et)
    }
    i = i + 1
  }
  // A literal beside parted elements in a body checked at each pin keeps master's widening: the
  // pin's re-join cannot tell the literal from the runtime members (D3534).
  if !parts || (lits.length > 0 && njFnOpen(njFnIx)) { return -1 }
  let j = run[0]
  i = 1
  while i < run.length {
    j = joinArmLit(j, false, run[i], false)
    i = i + 1
  }
  for l in lits { j = joinArmLit(j, false, l, true) }
  j
}

// `[...a, e, ...b]` — the element type joins every plain element's type with every spread
// source's ELEMENT type. A spread of an empty list contributes nothing, so `[...[]]` stays an
// unpinned `T[]` exactly as `[]` does, and a literal that is only spreads of empty lists is
// pinned by its destination like any other empty one.
function checkSpreadArrayLit(elems: i32[]) {
  let elemTy = -1
  let ei = 0
  while ei < elems.length {
    let et = -1
    if spreadArgOf(elems[ei]) >= 0 {
      et = spreadElemTy(elems[ei])
    } else {
      et = widenLitTy(checkNode(elems[ei]))
      if voidValueSlotErr(et, elems[ei], "list element", elems[ei]) {
        et = TY_ERR
      }
    }
    if et >= 0 {
      if elemTy < 0 { elemTy = et } else { elemTy = joinTys(elemTy, et) }
    }
    ei = ei + 1
  }
  mkArrayTy(elemTy)
}
// ── index `a[i]` ────────────────────────────────────────────────────────────

// Extracted from `checkNodeReal`'s `Index` arm (C3: thin the dispatcher).
function checkIndexNode(n: Index, ix: i32) {
  const arrTy0 = strLitRecvTy(checkNode(n.idxArr))
  const idxTy = checkNode(n.idxIndex)
  // Guard the unpinned-hole receiver (`-1` — see the Member-arm note).
  if arrTy0 < 0 { return TY_ERR }
  let arrTy = arrTy0
  if T.tys[arrTy0] is TyUnion {
    const gArr = tpGradualRecv(arrTy0, OP_INDEX_GET, ix)
    if gArr >= 0 && gArr < T.tys.length { arrTy = gArr }
  }
  lbiNoteIndex(arrTy, n.idxIndex)
  if !inferQuiet { strIdxRecord(ix, arrTy) }
  // A flow-narrowed constant-index place overrides the element type within the branch — asked
  // after the receiver/subscript check (unlike the member arm) since the subscript node needs banking.
  const xKey = placeKeyOf(ix)
  if xKey != "" {
    const xOv = narrowedPathTy(xKey)
    if xOv >= 0 {
      crNoteLoopRead(xKey, ix)
      crNoteCaptureRead(xKey)
      return xOv
    }
    crNoteLostRead(xKey, ix)
    const xInv = narrowedPathInvBy(xKey)
    if (
      xInv >= 0
      && !(luWriteTgt[ix] ?? false)
      && !pathReadsDeclared(xKey, xInv, ix)
    ) {
      return pathInvalidatedErr(xKey, xInv, ix)
    }
    if xInv < 0 { crPathDropRead(xKey, ix) }
  }
  const at = T.tys[arrTy]
  // A map index: the key must match the map's key type; a read yields the nullable value
  // (`V | null`), and an assignment target accepts a plain `V`.
  if at is TyMap {
    // A set has no index: membership is `has`, insertion `add`.
    if at.mSet == 1 {
      tErr(
        "a Set has no index — test membership with `.has(x)` and insert with `.add(x)`",
        ix,
      )
      return TY_ERR
    }
    // The expression form, for the same reason `m.get`'s does: `m["green"]` on a
    // literal-union-keyed map is a member of that union, and `checkNode` types a string
    // literal as the widened `string` with no destination to narrow it against (D1748).
    if !assignableExpr(n.idxIndex, idxTy, at.mKey) {
      tErr(
        "map key must be " + tyToStr(at.mKey) + ", got " + tyToStr(idxTy),
        n.idxIndex,
      )
    }
    return mkNullableTy(at.mVal)
  }
  // Indexing a hole constrains it to an array: demand an i32 index and return the element as
  // a derived hole (`HD_ELEM`), resolved per call site — mirrors `holeMemberTy` for `self.x`.
  if at is TyVar {
    if !assignable(idxTy, TY_I32) {
      // A non-i32 index can only be a map — constrain the hole to its demanded map and pin
      // the key from the index (the index-spelling twin of the `.set` arm's pin).
      if mapKeyTySupported(idxTy) {
        if tyIsWriteLandRead(arrTy) {
          noteMemCstr(arrTy, MC_NULL_READ_MARK + OP_INDEX_GET, ix, false)
        }
        const hmi = holeMapDemandTy(at.tvName, false)
        const hmt = T.tys[hmi]
        if hmt is TyMap {
          if hmt.mKey < 0 {
            hmt.mKey = idxTy
            tyMutEpoch = tyMutEpoch + 1 // hole index-read pinned the demanded key in place
          }
          return mkNullableTy(hmt.mVal)
        }
      }
      tErr("array index must be i32, got " + tyToStr(idxTy), n.idxIndex)
    }
    noteArrayDemand(arrayDemandKey(arrTy))
    // Admitted here and re-asked at the pin (D691): `noteArrayDemand` only reaches a bound
    // receiver and refuses scalars/maps — a record/nullable/function/union pinned reaches the emitter unruled.
    noteMemCstr(arrTy, OP_INDEX_GET, ix, false)
    return mkDerivedHole(HD_ELEMV, "", -1, -1, arrTy)
  }
  // Free index operator (B14): `x[i]` on a non-indexable receiver resolves to a declared
  // `"[]"` function by type. Checked before the closure-field trap, mirroring the `a op b` order.
  if opIdxDeclared() {
    if !tyBuiltinIndexable(arrTy) {
      const rfn = opIdxFnFor(OP_INDEX_GET, arrTy)
      if rfn != "" {
        const bNames: string[] = []
        const bTys: i32[] = []
        opIdxBindGen(rfn, arrTy, idxTy, bNames, bTys)
        const kt = opIdxParamTy(rfn, 1)
        if kt >= 0 {
          const ktb = substTyDeep(kt, bNames, bTys)
          if !assignableExpr(n.idxIndex, idxTy, ktb) {
            tErr(
              "index: expected " + tyToStr(ktb) + ", got " + tyToStr(idxTy),
              ix,
            )
          }
        }
        opIdxBank(ix, rfn)
        noteCallInvalidations(ix)
        const rty = opIdxRetTy(rfn)
        if bNames.length > 0 { return substTyDeep(rty, bNames, bTys) }
        return rty
      }
      // A write operator with no read operator is not a usable type: the assignment form
      // checks the target as an ordinary index and would name the wrong half — say which is missing.
      const wOnly = opIdxFnFor(OP_INDEX_SET, arrTy)
      if wOnly != "" {
        tErr(
          "operator "
            + opDeclLabel(wOnly)
            + " needs a matching \""
            + OP_INDEX_GET
            + "\" operator — an index that cannot be READ cannot be written either",
          ix,
        )
        return TY_ERR
      }
    }
  }
  // Index trap (B13): a user object declaring `"[]"` handles `o[k]` itself — the key checks
  // against the method's parameter, checked before the native i32-index rule. Write traps use `"[]="`.
  if at is TyObj {
    const trap = objFieldType(at, "[]")
    if trap >= 0 {
      const tt = T.tys[trap]
      if tt is TyFunc {
        if tt.fnParamTypes.length == 1 {
          if !assignableExpr(n.idxIndex, idxTy, tt.fnParamTypes[0]) {
            tErr(
              "index: expected "
                + tyToStr(tt.fnParamTypes[0])
                + ", got "
                + tyToStr(idxTy),
              ix,
            )
          }
          return tt.fnRet
        }
      }
    }
    tErr(indexFloorMsg(arrTy), ix)
    return TY_ERR
  }
  if !assignable(idxTy, TY_I32) {
    tErr("array index must be i32, got " + tyToStr(idxTy), n.idxIndex)
  } else if tyHasTyVar(idxTy) {
    // A hole passes vacuously; the pin asks again at the type it binds (D3584).
    noteArgCstr(idxTy, TY_I32, "", ACF_INDEX, -1)
  }
  if at is TyUnion {
    // An index that is not an `i32` is already reported above.
    if !assignable(idxTy, TY_I32) && luMembers(arrTy).length > 0 {
      return TY_ERR
    }
    const lui = luIndexAt(n, ix, arrTy)
    if lui >= 0 { return lui }
    // A read rewrites; a write is refused by design, since the stored value would have to
    // fit every member's element at once.
    if (luWriteTgt[ix] ?? false) && luMembers(arrTy).length > 0 {
      tErr(
        "cannot write through an index of "
          + tyToStr(arrTy)
          + ": the value would have to fit every member's element — narrow with `is` first",
        ix,
      )
      return TY_ERR
    }
  }
  if at is TyArray {
    const ev = elemEveryReadTy(ix)
    if ev >= 0 { return ev }
    // The element's value type — a `u8[]` read is an `i32`, never a `u8`. Same shape as the
    // string arm below: `string` is `(array i32)` with no `char` type above it (DECISIONS A7).
    return arrElemValueTy(at.aElem)
  }
  if at is TyErr { return TY_ERR }
  // Indexing a string yields the UTF-8 byte at that position, as an `i32`.
  if at is TyPrim {
    if at.primName == "string" { return TY_I32 }
  }
  tErr(indexFloorMsg(arrTy), ix)
  return TY_ERR
}
// The element a read `xs[i]…[j]` holds under an element-only narrowing of `xs` (a name, a field
// path or a literal subscript, `pushElemReadFact`), or -1. A store through the place is typed as
// declared and ends it.
function elemEveryReadTy(ix: i32): i32 {
  if luWriteTgt[ix] ?? false { return -1 }
  const key = elemRecvPrefix(ix)
  if !keyIsListEvery(key) { return -1 }
  const slot = narrowedPathIx(key)
  if slot < 0 || narFitNameOf(slot) != "" { return -1 }
  const t = narrowedPathTy(key)
  if t >= 0 { crNoteCaptureRead(key) } else { crPathDropRead(key, ix) }
  t
}

// The key (`s[*]`, `m[*][*]`) of the element-only narrowing in force on the list `recvIx` names
// or of a row of it still a list (`m[0]`), as `s is S[]` over a `string[]` pushes it
// (`pushElemReadFact`), or "".
function elemOnlyKeyOf(recvIx: i32): string {
  const pfx = elemRecvPrefix(recvIx)
  if pfx == "" { return "" }
  const slot = elemEverySlotOf(elemKeyBase(pfx))
  if slot < 0 || narFitNameOf(slot) != "" { return "" }
  const key = npKeys[slot]
  if key.length <= pfx.length || narrowedPathTy(key) < 0 { return "" }
  crNoteCaptureRead(key)
  key
}

// The narrowing an element of `recvIx` carries into the parameter of the callback literal `cbIx`
// handed to its `map`/`filter` (`elemOnlyKeyOf`), as `elemFactFor` banks it, or false. Only a
// callback that runs in place and, asked as a loop body is, writes no element of the receiver
// out of the leaf nor calls what may, is handed elements that all still fit.
function cbElemNarrowFor(recvIx: i32, cbIx: i32): boolean {
  const key = elemOnlyKeyOf(recvIx)
  if key == "" { return false }
  const pfx = elemRecvPrefix(recvIx)
  const root = placeRootOf(pfx)
  const fd = P.nodes[cbIx]
  if !(fd is FuncDecl) { return false }
  const leaf = narrowedPathTy(key)
  const bound: string[] = []
  fnBoundNames(cbIx, bound)
  cbPendClear()
  cbPendAdd(cbIx, nodeTyOf(recvIx), bound)
  cbPendCollect(fd.fnBody, bound)
  const writes = (!crCallbackKeeps(cbIx, root)
    || crLoopLeavingPathWrite(fd.fnBody, key, leaf) >= 0
    || crFirstElemWritingCall(fd.fnBody, key) >= 0)
  cbPendClear()
  if writes { return false }
  elemFactFor(cbIx, pfx, key)
}

// Banks, under `at`, the fact an element of the list `pfx` reads (`elemRecvPrefix`) brings to a
// fresh binding from the element key `key`: its leaf, and how many element steps it narrows.
function elemFactFor(at: i32, pfx: string, key: string): boolean {
  efLeaf[at] = narrowedPathTy(key)
  efSteps[at] = (key.length - pfx.length) / LIST_EVERY_STEP.length - 1
  true
}

// Narrow the binding `name`, just declared in the current scope, by the fact banked under `at`
// (`elemFactFor`): the leaf itself at no steps, as a guard would, else every element so deep.
function narrowFreshBinding(name: string, at: i32) {
  const leaf = efLeaf[at] ?? -1
  const steps = efSteps[at] ?? -1
  if leaf < 0 || steps < 0 || name == "" { return 0 }
  if steps == 0 {
    const decl = lookup(name)
    if decl < 0 || tySame(decl, leaf) || !assignable(leaf, decl) { return 0 }
    return applyNarrows([name], [leaf])
  }
  let key = name
  let k = 0
  while k < steps {
    key = key + LIST_EVERY_STEP
    k = k + 1
  }
  applyNarrows([key], [leaf])
}

// ── object literal ──────────────────────────────────────────────────────────
// `{x: e, y: e}` types as a structural `TyObj` whose fields carry each value's checked type.
// Assignability against an annotation/param/return then matches it to a declared struct by
// structure, so field order need not match the declaration.

// Extracted from `checkNodeReal`'s `ObjLit` arm (C3: thin the dispatcher).
function checkObjLitNode(n: ObjLit, ix: i32) {
  const fields = n.objFields
  if fields.length == 0 {
    // A `{}` statement is an empty block, refused by the parser, or for a block's last
    // statement by `bareBraceDeliver` / `bareBraceUndelivered`; the error type keeps it at one.
    if i32ListHas(stmtBraceNodes, ix) {
      bareBraceCountSet(bareBraceCount + 1)
      if i32ListHas(stmtBraceTails, ix) { bareBraceLits.push(ix) }
      return TY_ERR
    }
    bareBraceLits.push(ix)
  }
  const fnames: string[] = []
  const ftys: i32[] = []
  let i = 0
  while i < fields.length {
    const fnode = P.nodes[fields[i]]
    if fnode is FieldInit {
      fnames.push(fnode.fiName)
      // A `void` field initializer has no value to store — poisoned to `TY_ERR` so an
      // annotated literal keeps one message, instead of an uninterned-shape reject naming nothing.
      let fty = widenLitTy(checkNode(fnode.fiValue))
      const fslot = "field '" + fnode.fiName + "'"
      if voidValueSlotErr(fty, fnode.fiValue, fslot, fnode.fiValue) {
        fty = TY_ERR
      }
      if neverValueSlotErr(fty, fslot, fnode.fiValue) { fty = TY_ERR }
      ftys.push(fty)
    }
    i = i + 1
  }
  objLitDupKeyErrs(fields)
  return mkObjTy(fnames, ftys)
}

// A key given twice in one object literal is refused, shorthand and quoted keys alike: the
// diagnostic spans the repeated key and names where the first one is (owner ruling, D3484).
function objLitDupKeyErrs(fields: i32[]) {
  let i = 1
  while i < fields.length {
    const first = objLitEarlierKey(fields, i)
    if first >= 0 {
      const f = P.nodes[fields[i]]
      if f is FieldInit { objLitDupKeyErr(f.fiName, fields[i], first) }
    }
    i = i + 1
  }
  0
}

// Raise the duplicate-key refusal over the key token of `dupIx`, citing `firstIx`'s key.
function objLitDupKeyErr(name: string, dupIx: i32, firstIx: i32) {
  dupNameErr(
    "key `" + name + "` is given twice in this object literal",
    dupIx,
    firstIx,
  )
}

// Raise `head` plus where the first one is, over the token node `dupIx` starts at.
export function dupNameErr(head: string, dupIx: i32, firstIx: i32) {
  const ft = nodeStartTok(firstIx)
  let where = ""
  if ft >= 0 {
    where = " (first at "
      + i32ToStr(P.toks[ft].line)
      + ":"
      + i32ToStr(P.toks[ft].col + 1)
      + ")"
  }
  const msg = head + where
  const dt = nodeStartTok(dupIx)
  if dt >= 0 { return tErrPushTok(msg, dupIx, dt, "", "") }
  tErr(msg, dupIx)
}

// ── type guard `x is T` ─────────────────────────────────────────────────────
// Always a `bool`. Checks the operand and that `T` names a known type. The actual narrowing of
// `x` to `T` happens in the then branch of an enclosing `if`; used elsewhere it is a boolean test.

function jsonDeepIsSite(ix: i32, chkTy: i32, objIx: i32, objTy0: i32): i32 {
  jwBadMsgSet("")
  if chkTy < 0 { return -1 }
  const objTy = jsonReceiverDeclTy(objIx, objTy0)
  const root = jsonUnionRootIn(objTy)
  if root < 0 { return -1 }
  // `x is Json` is the whole union and is trivially true — left to the ordinary route.
  // Membership is asked of the ROOT, not the receiver's possibly-narrowed view.
  if jsonSelfRef(chkTy, root) { return -1 }
  if jsonExactMemberOf(root, chkTy) { return -1 }
  // And an arm of the RECEIVER, not the same set when it is wider than the tree — a union
  // of `Json | Payload` makes `x is Payload` a tag test, not a walk.
  if jsonExactMemberOf(objTy, chkTy) { return -1 }
  const seen: i32[] = []
  const bad = jsonShapeBad(chkTy, root, seen)
  if bad != "" {
    // Not an error on its own: a JSON-shaped union is still an ordinary union, and the
    // ordinary route answers plenty of non-shape spellings — banked, used only if that gate rejects too.
    jwBadMsgSet(bad)
    return 0
  }
  jwRecordSite(ix, chkTy, jsonParamSpell(objTy, root), root)
  1
}

// The walker's parameter, spelled through names the program already carries — the root, plus
// any arms the receiver reaches beyond the tree (a wider receiver like `Json | JsonError`).
// Not `tyToStr(objTy)`: a narrowed receiver's arena type renders as the union flattened, which
// mints a spelling nothing registered — an emit reject on a check-clean program.
function jsonParamSpell(objTy: i32, root: i32): string {
  if assignable(objTy, root) { return tyToStr(root) }
  let s = tyToStr(root)
  const ms = jsonUnionMembers(objTy)
  let i = 0
  while i < ms.length {
    if !jsonSelfRef(ms[i], root) {
      if !jsonExactMemberOf(root, ms[i]) {
        const m = tyToStr(ms[i])
        if !jsonSpellHas(s, m) { s = s + " | " + m }
      }
    }
    i = i + 1
  }
  s
}

// The members of literal set `chk` that a value of `obj` can hold, when `chk` is not already
// inside `obj`: the type `x is chk` tests and narrows to. -1 when `chk` is not a literal set,
// `obj` holds no literal, or `chk` fits `obj` as written; `LIT_MEET_NONE` when none of `chk`
// fits. A `null` in `obj` is not a member of the meet.
function litSetMeetTy(obj: i32, chk: i32): i32 {
  if obj < 0 || chk < 0 { return -1 }
  if !allLitMembers(chk) { return -1 }
  let base = obj
  const ot = T.tys[obj]
  if ot is TyNullable { base = ot.nInner }
  if base < 0 { return -1 }
  const own: i32[] = []
  flattenLits(base, own)
  if own.length == 0 { return -1 }
  if assignable(chk, base) { return -1 }
  // Membership compares lexemes, so `"\u{e9}"` and `"é"` would look disjoint: an escape on
  // either side keeps the tested set as written, refused unless it fits.
  if litSetHasEscape(base) || litSetHasEscape(chk) { return -1 }
  const cands: i32[] = []
  flattenLits(chk, cands)
  const keep: i32[] = []
  let i = 0
  while i < cands.length {
    if assignable(cands[i], base) { keep.push(cands[i]) }
    i = i + 1
  }
  if keep.length == 0 { return LIT_MEET_NONE }
  // The whole set survives: the operand keeps its own type, and with it its rep.
  if keep.length == own.length && allLitMembers(base) { return base }
  if keep.length == 1 { return keep[0] }
  mkUnionTy(keep)
}

// The members of the literal-bearing union `obj` (or its nullable) whose base scalar is the
// primitive `chk`, as one type: what `x is string` narrows `1 | "s"` to (D3522). -1 when `chk` is
// no primitive, when it is already a variant, or when no literal member has it as its base.
function litBaseMeetTy(obj: i32, chk: i32): i32 {
  if obj < 0 || chk < 0 || !(T.tys[chk] is TyPrim) { return -1 }
  let base = obj
  const ot = T.tys[obj]
  if ot is TyNullable { base = ot.nInner }
  if base < 0 || !(T.tys[base] is TyUnion || T.tys[base] is TyLit) { return -1 }
  const vs: i32[] = []
  flattenVariantsInto(base, vs)
  const keep: i32[] = []
  for v in vs {
    if v >= 0 {
      const vt = T.tys[v]
      if vt is TyLit {
        if tySame(litBaseTy(vt), chk) { keep.push(v) }
      }
    }
  }
  if keep.length == 0 || assignable(chk, base) { return -1 }
  if keep.length == 1 { return keep[0] }
  mkUnionTy(keep)
}

// The members of integer literal set `chk` an integer `obj` can hold, where some but not all
// fit: `d is C` with `d: i32` and `C = 1 | 3000000000` tests the `1` (D3655). -1 otherwise,
// and for a float receiver, whose answer against an integer literal waits on D3689.
function litPrimMeetTy(obj: i32, chk: i32): i32 {
  if obj < 0 || chk < 0 || !(T.tys[obj] is TyPrim) { return -1 }
  const pn = primNameOf(obj)
  if pn != "i32" && pn != "i64" { return -1 }
  if !allLitMembers(chk) || assignable(chk, obj) { return -1 }
  const cands: i32[] = []
  flattenLits(chk, cands)
  const keep: i32[] = []
  for c in cands {
    const ct = T.tys[c]
    if ct is TyLit {
      if ct.litKind != "int" { return -1 }
    }
    if assignable(c, obj) { keep.push(c) }
  }
  if keep.length == 0 { return -1 }
  if keep.length == 1 { return keep[0] }
  mkUnionTy(keep)
}

// The part of `obj` that always fits the record type `chk`, where `chk` names none of `obj`'s
// members: `b is A` over `b: B` or `B | null` with every `B` an `A` tests as `is B`, and over
// `B | C` with no `C` able to fit `A` it tests the `B` (D4062). -1 otherwise.
function recFitMeetTy(obj: i32, chk: i32): i32 {
  if obj < 0 || chk < 0 { return -1 }
  const ct = T.tys[chk]
  if !(ct is TyObj) { return -1 }
  let base = obj
  const ot = T.tys[obj]
  if ot is TyNullable { base = ot.nInner }
  if base < 0 { return -1 }
  const bt = T.tys[base]
  if bt is TyObj {
    if recContainedIn(base, chk) { return base }
    return -1
  }
  if !(bt is TyUnion) { return -1 }
  let fit = -1
  for m in bt.uMembers {
    if m < 0 || tySame(m, chk) { return -1 }
    if recContainedIn(m, chk) {
      if fit >= 0 { return -1 }
      fit = m
    } else if !recNeverFits(m, ct) {
      return -1
    }
  }
  fit
}

// Whether every value of record `a` fits record `b` and not the reverse, the two declaring the
// same field names. A record with fields the other lacks is no containment D3885 settles.
function recContainedIn(a: i32, b: i32): boolean {
  if a < 0 || b < 0 { return false }
  const at = T.tys[a]
  const bt = T.tys[b]
  if !(at is TyObj) || !(bt is TyObj) { return false }
  if at.objFieldNames.length != bt.objFieldNames.length { return false }
  for f in at.objFieldNames {
    if strListIndexOf(bt.objFieldNames, f) < 0 { return false }
  }
  assignable(a, b) && !assignable(b, a)
}

// Whether narrowing a record `cur` to `chk` keeps its storage: a field narrowed to a string
// literal set is stored as an atom in `chk` and as a string in `cur`, so the value cannot be
// delivered as a `chk` (D4058).
function recFitNarrowKeepsRep(cur: i32, chk: i32): boolean {
  const names: string[] = []
  const sets: i32[] = []
  if recFitNarrowedFields(cur, chk, names, sets) != 1 { return true }
  for st in sets {
    for lex in tyLitSetMemberLexes(st) {
      if nameIsQuotedLeaf(lex) { return false }
    }
  }
  true
}

// For `r is B` over a single record `r: A` (or `A | null`) where every `B` is an `A` but not
// the reverse, the fields `B` narrows and the literal set each must hold (D4058). -1 when the
// test is not that shape, 0 when a narrowed field is not a literal set over `A`'s, else 1.
export function recFitNarrowedFields(
  obj: i32,
  chk: i32,
  names: string[],
  sets: i32[],
): i32 {
  if obj < 0 || chk < 0 { return -1 }
  const ct = T.tys[chk]
  if !(ct is TyObj) { return -1 }
  let base = obj
  const ot = T.tys[obj]
  if ot is TyNullable { base = ot.nInner }
  if base < 0 { return -1 }
  const bt = T.tys[base]
  if !(bt is TyObj) || !recContainedIn(chk, base) { return -1 }
  let i = 0
  while i < ct.objFieldNames.length {
    const fb = ct.objFieldTypes[i]
    const at = strListIndexOf(bt.objFieldNames, ct.objFieldNames[i])
    if at < 0 { return 0 }
    const fa = bt.objFieldTypes[at]
    if !assignable(fa, fb) {
      if tyLitSetMemberLexes(fb).length == 0 { return 0 }
      names.push(ct.objFieldNames[i])
      sets.push(fb)
    }
    i = i + 1
  }
  if names.length == 0 { return 0 }
  1
}

function checkIsExprNode(n: IsExpr, ix: i32) {
  // The tested place is a test, not a use: its lowering reads the field's own rep.
  const savedIsObj = crIsObj
  crIsObjSet(n.isObj)
  let objTy = checkNode(n.isObj)
  crIsObjSet(savedIsObj)
  const chkTy = isTypeTy(n.isVariant, ix)
  const chkClash = if chkTy < 0 { unkTyClash } else { "" }
  // A literal set that only overlaps the operand's tests as the overlap (D2205), and a base
  // scalar tests the literal members it is the base of (D3522).
  let meet = litSetMeetTy(objTy, chkTy)
  if meet == -1 && n.isVariant != "null" { meet = litBaseMeetTy(objTy, chkTy) }
  if meet == -1 { meet = litPrimMeetTy(objTy, chkTy) }
  if meet == -1 { meet = recFitMeetTy(objTy, chkTy) }
  // A `const` literal tests as the compare does: against a literal it never equals the
  // test is refused, and against anything else it is the `string` it is (D2198).
  if chkTy >= 0 && isWideLitJoin(objTy) {
    if allStrLitMembers(chkTy) {
      if strLitSetsDisjoint(objTy, chkTy) {
        tErr(
          constLitNeverMsg(n.isObj, objTy, chkTy, "test is always false"),
          ix,
        )
        return TY_BOOL
      }
      // Sets that meet test as their overlap (`meet`, D2205): `"debug"` may be tested
      // against `"debug" | "x"`, and a subset keeps its literal type (D2204).
      if !assignable(chkTy, objTy) { objTy = widenLitTy(objTy) }
    } else {
      objTy = widenLitTy(objTy)
    }
  }
  // Bank the resolved check type on the `is` node so the emitter's narrowing stack carries
  // it as an arena index, instead of re-classifying the spelling at every read of the binding.
  if chkTy >= 0 {
    if ix >= 0 {
      if ix < isVarTyIxCap {
        while isVarTyIx.length <= ix { isVarTyIxPush(-1) }
        isVarTyIxSetAt(ix, if meet >= 0 { meet } else { chkTy })
      }
    }
  }
  if chkTy < 0 {
    // A reason the resolver banked (a float literal, `u8`) is the whole diagnostic.
    if chkClash.length > 0 {
      tErr(chkClash, ix)
    } else {
      unknownTyErr(n.isVariant, " in 'is'", ix)
    }
    // `objTy < 0` is the operand's own "no answer", not a type — indexing `T.tys` with it
    // would trap the compiler (D1462); an unresolved operand is freely testable, same as `TyErr`.
  } else if n.isVariant != "null" && objTy >= 0 {
    // A record test over a hole is re-asked at each pin (D3109).
    if tyIsParamHole(objTy) { noteIsCstr(objTy, chkTy, n.isVariant, ix) }
    // Soundness: `x is T` is meaningful only when `T` is assignable to `x`'s type, since the
    // then branch narrows verbatim — an ungated test would launder invalid wasm through a newtype.
    const ot = T.tys[objTy]
    let baseTy = objTy
    let inUnion = false
    if ot is TyUnion {
      inUnion = true
    } else if ot is TyNullable {
      inUnion = true
      baseTy = ot.nInner
    }
    // A nullable whose inner is still open carries the in-band `-1` too (a bare `Map()`
    // read is `V | null` unpinned) — answered freely-testable, the same as an unresolved `TyErr`.
    if baseTy < 0 { return TY_BOOL }
    // The deep-`is` route, asked before the arm gate (D1035): `r is string[]` over a `Json`
    // passes assignability below (widens into `Json[]`) and would answer false for every value.
    const jwDeep = jsonDeepIsSite(ix, chkTy, n.isObj, objTy)
    if jwDeep == 1 { return TY_BOOL }
    if meet == LIT_MEET_NONE {
      tErr(litSetNeverMsg(n.isObj, objTy, chkTy), ix)
    } else if meet >= 0 {
      0
    } else if !assignable(chkTy, baseTy) || isWidenNotVariant(chkTy, baseTy) {
      if jwBadMsg != "" {
        tErr(
          "`is` check type '"
            + n.isVariant
            + "' is not a JSON shape — "
            + jwBadMsg,
          ix,
        )
      } else if inUnion {
        tErr(
          "`is` check type '"
            + n.isVariant
            + "' is not a variant of "
            + tyToStr(objTy),
          ix,
        )
      } else {
        tErr(
          "`is` check type '"
            + n.isVariant
            + "' can never match a value of type "
            + tyToStr(objTy),
          ix,
        )
      }
    } else {
      const twin = mapTwinTestMsg([objTy], chkTy, "`is`")
      if twin != "" { tErr(twin, ix) }
      recordCollapsedIsAt(n, ix, objTy, chkTy)
      recordContainedIsAt(n, ix, objTy, chkTy)
    }
  }
  return TY_BOOL
}

// Extracted from `checkNodeReal`'s `OptMember` arm (C3: thin the dispatcher).
function checkOptMemberNode(n: OptMember, ix: i32) {
  // `x?.y` keys the same narrowed place as `x.y` (host `placeKey`).
  const omKey = placeKeyOf(ix)
  if omKey != "" {
    const omOv = narrowedPathTy(omKey)
    if omOv >= 0 {
      identNotePlace(n.omObj)
      omGuardSet(ix, nonNullTy(omOv))
      crNoteLoopRead(omKey, ix)
      crNoteCaptureRead(omKey)
      return symMem(ix, omOv)
    }
    crNoteLostRead(omKey, ix)
    const omInv = narrowedPathInvBy(omKey)
    if omInv >= 0 && !pathReadsDeclared(omKey, omInv, ix) {
      omGuardSet(-1, -1)
      return pathInvalidatedErr(omKey, omInv, ix)
    }
  }
  omGuardSet(-1, -1)
  const recv = checkNode(n.omObj)
  // Guard the unpinned-hole receiver (`-1` — see the Member-arm note).
  if recv < 0 {
    omGuardSet(-1, -1)
    return TY_ERR
  }
  const eff = omRecvTy(n.omObj, recv)
  if eff < 0 {
    omGuardSet(-1, -1)
    return TY_ERR
  }
  // A `.` that inherited the chain's guard reads through it, so a field that is nullable in
  // its own right is a plain member access on a nullable value — the same refusal, and the
  // same fix (`o?.y?.z`), the direct spelling gives.
  if n.omDot {
    const de = T.tys[eff]
    if de is TyNullable {
      omGuardSet(-1, -1)
      memberFloorErr(eff, n.omProp, ix)
      return TY_ERR
    }
  }
  const rcv = T.tys[recv]
  let wasNullable = false
  let baseTy = eff
  if rcv is TyNullable { wasNullable = true }
  const et = T.tys[eff]
  if et is TyNullable {
    baseTy = et.nInner
    // Peels a second nullable layer too: the host's `flattenType` collapses `T??` to `T?`,
    // so a doubly-nullable receiver still reads its field with one `?.`.
    if baseTy >= 0 {
      const rcv2 = T.tys[baseTy]
      if rcv2 is TyNullable { baseTy = rcv2.nInner }
    }
  }
  if baseTy < 0 {
    omGuardSet(-1, -1)
    return TY_ERR
  }
  // `?.` reads a declared struct field, as it refuses a built-in `.length`, so a getter is
  // refused by name rather than as a missing field (property-access-design.md §D3a).
  const omGet = getterFnFor(baseTy, n.omProp)
  if omGet != "" {
    omGuardSet(-1, -1)
    tErr(
      "`?."
        + n.omProp
        + "` reads the "
        + getDeclLabel(omGet)
        + ", and `?.` reads only a declared struct field — narrow the receiver instead, e.g. `if v != null { v."
        + n.omProp
        + " }`",
      ix,
    )
    return TY_ERR
  }
  const bt = T.tys[baseTy]
  if bt is TyObj {
    const oft = objFieldType(bt, n.omProp)
    if oft < 0 {
      omGuardSet(-1, -1)
      tErr("no field '" + n.omProp + "' on " + tyToStr(baseTy), ix)
      return TY_ERR
    }
    omGuardSet(ix, oft)
    if wasNullable { return symMem(ix, mkNullableTy(oft)) }
    return symMem(ix, oft)
  }
  if bt is TyErr {
    omGuardSet(-1, -1)
    return TY_ERR
  }
  // Shared union field through `?.` — same rule as the plain member read.
  if bt is TyUnion {
    const osf = sharedUnionFieldTy(bt, n.omProp)
    if osf >= 0 {
      if sharedFieldJoinWidens(bt, n.omProp, osf, ix) {
        omGuardSet(-1, -1)
        return TY_ERR
      }
      omGuardSet(ix, osf)
      if wasNullable { return symMem(ix, mkNullableTy(osf)) }
      return symMem(ix, osf)
    }
  }
  omGuardSet(-1, -1)
  // A nullable receiver here is not "a non-object" — it is an object-less base behind a
  // `| null`. `?.` reaches declared struct fields only; builtins (`.length`) are unreachable through it.
  if wasNullable {
    tErr(
      "`"
        + omDotStr(n)
        + n.omProp
        + "` is not available on "
        + tyToStr(recv)
        + " — `?.` reads a declared struct field, and "
        + tyToStr(baseTy)
        + " has none; narrow the receiver instead, e.g. `if v != null { v."
        + n.omProp
        + " }`",
      ix,
    )
    return TY_ERR
  }
  tErr(
    "member access '"
      + omDotStr(n)
      + n.omProp
      + "' on non-object "
      + tyToStr(recv),
    ix,
  )
  return TY_ERR
}

// Extracted from `checkNodeReal`'s `WhileStmt` arm (C3: thin the dispatcher).
function checkWhileStmtNode(n: WhileStmt, ix: i32) {
  crLoopPreRetire(ix)
  // The barrier opens before the condition, which runs again after the body: its reads are
  // among the loop's re-run reads, and a write in it re-runs like one in the body.
  pushReBarrier(crLoopRdSlots.length)
  const wc = checkNode(n.whileCond)
  if !assignable(wc, TY_BOOL) {
    tErr("while-condition must be boolean, got " + tyToStr(wc), n.whileCond)
  }
  // Definite-assignment: a loop body may run zero times, so an in-body assignment is not
  // guaranteed to reach the fall-through — check the body live, then restore the pre-loop state.
  const daLoopMark = daMark()
  // The body is a narrowing scope like an `if` then-arm, re-tested every iteration — every fact
  // the condition proves, for a property path as much as a bare name and an `is T` pin as much
  // as a null strip. What could falsify a path fact mid-body retires it: a write through
  // `retireNarrowingsForWrite`, a call through `noteCallInvalidations` (D1736, D1845).
  const wnNames: string[] = []
  const wnTys: i32[] = []
  collectThenNarrows(n.whileCond, wnNames, wnTys)
  if wnNames.length > 0 {
    pushScope(-1)
    applyNarrows(wnNames, wnTys)
  }
  const blk = n.whileBlk == 1
  // A labelled block's tail is its value, so its body is discarded only when the block is.
  if !blk || valDiscarded(ix) { markValDiscard(n.whileBody) }
  lpPush(n.whileLabel)
  let neMark = neKeys.length
  if !blk { neMark = neEnter(n.whileCond, curFnDeclIx) }
  checkNode(n.whileBody)
  neLeave(neMark)
  let tailTy = -1
  let tailIx = -1
  let runsOut = lpOn && !condLitTrue(n.whileCond)
  if blk {
    runsOut = false
    if blockTailTy >= 0 && !isVoidTy(blockTailTy) && blockTailIx >= 0 {
      tailTy = blockTailTy
      tailIx = blockTailIx
    } else if !stmtAlwaysExits(n.whileBody) {
      runsOut = true
    }
  }
  const res = lpPopResult(ix, tailTy, tailIx, runsOut)
  if wnNames.length > 0 { popScope() }
  popReBarrier()
  daRollbackTo(daLoopMark)
  daRelease(daLoopMark)
  return res
}

// Pops the innermost entry, for the loop `ix`: its value type from the `break` values, the
// block tail `tailTy` (-1 for none) and `runsOut` (an exit with no value), else void.
function lpPopResult(ix: i32, tailTy: i32, tailIx: i32, runsOut: boolean): i32 {
  if !lpOn { return TY_VOID }
  const top = lpLabels.length - 1
  if top < 0 { return TY_VOID }
  let t = lpJoin[top]
  const bare = lpBare[top]
  lpLabelsPop()
  lpJoinPop()
  lpBarePop()
  if tailTy >= 0 { t = joinTys(t, tailTy) }
  if t < 0 {
    lpColSet(lpValTy, ix, -1)
    return TY_VOID
  }
  if runsOut || bare { t = joinTys(t, TY_NULL) }
  lpColSet(lpValTy, ix, t)
  lpValSeenSet(true)
  let used = 1
  if valDiscarded(ix) { used = 0 }
  lpColSet(lpValUsed, ix, used)
  let tl = -1
  if tailTy >= 0 { tl = tailIx }
  lpColSet(lpValTail, ix, tl)
  t
}

// `break [:label] [v]`: joins the value's type into the target's, or marks a value-less exit.
function checkBreakNode(n: BreakStmt, ix: i32) {
  if !lpOn { return TY_VOID }
  const t = lpTargetOf(n.brkLabel)
  if t < 0 { return TY_VOID }
  if n.brkHasVal != 1 {
    lpBareSetAt(t, true)
    return TY_VOID
  }
  const vt = brkPrevTy
  if vt < 0 || vt == TY_ERR { return TY_VOID }
  if isVoidTy(vt) {
    tErr("a `break` value must be a value, and this one has type void", ix)
    return TY_VOID
  }
  lpJoinSetAt(t, joinTys(lpJoin[t], widenLitTy(vt)))
  TY_VOID
}

// The one spelling of an exiting first arm the emitter cannot lower yet: a nullable-list value of
// a construct that is itself another's arm value, whose rep is read through this first arm (D3222).
function refuseNestedExitFirst(ix: i32, ty: i32) {
  if ty < 0 || !tyBearsNull(ty) { return 0 }
  const nn = nonNullTy(ty)
  if nn < 0 || !(T.tys[nn] is TyArray) { return 0 }
  tErr(
    "an `if` or `match` whose first arm always exits cannot yet hold a nullable list as the value of another's arm; bind it to a name first, or put the exiting arm last",
    ix,
  )
  0
}

// The direction rule (D1588, VL-038). A constant range whose step contradicts its direction
// can never iterate; so can `step 0` — one category, a descriptor that cannot complete as
// written. `excl` (the `until` form) accepts an empty `from == to` as a legal zero-trip range,
// so its refusal predicate is identical to `to`'s; only the message spells the keyword.
function checkRangeNeverRuns(
  fromIx: i32,
  toIx: i32,
  stepIx: i32,
  excl: boolean,
) {
  let stepK = 1
  const stepWritten = stepIx >= 0
  if stepWritten {
    if !constIntExprIs(stepIx) { return 0 }
    stepK = constIntExprVal(stepIx)
  }
  // Anchored at the step, not the `to`: this sentence names `step 0`, so the caret
  // belongs on the token the reader has to change. Fires whatever the bounds are.
  if stepK == 0 {
    return tErrCodedData(
      "a range with `step 0` never advances",
      stepIx,
      CODE_RANGE_NEVER_RUNS,
      diagDataField("step", "0"),
    )
  }
  if !constIntExprIs(fromIx) || !constIntExprIs(toIx) { return 0 }
  const from = constIntExprVal(fromIx)
  const to = constIntExprVal(toIx)
  if stepK > 0 && from <= to { return 0 }
  if stepK < 0 && from >= to { return 0 }
  const msg = rangeNeverRunsMsg(from, to, stepK, stepWritten, excl)
  const data = diagDataField("from", i32ToStr(from))
    + diagDataField("to", i32ToStr(to))
    + diagDataField("step", i32ToStr(stepK))
  const tk = forToKwTok(toIx)
  if tk >= 0 { return tErrPushTok(msg, toIx, tk, CODE_RANGE_NEVER_RUNS, data) }
  tErrCodedData(msg, toIx, CODE_RANGE_NEVER_RUNS, data)
}

// Extracted from `checkNodeReal`'s `ForRange` arm (C3: thin the dispatcher).
function checkForRangeNode(n: ForRange, ix: i32) {
  crLoopPreRetire(ix)
  // A range over `const` bounds keeps them as names: its constant-range refusals and the emitter's
  // step floor are about bounds the author wrote as literals.
  lbiKeepName = lbiKeepName + 1
  const frFrom = checkNode(n.frFrom)
  const frTo = checkNode(n.frTo)
  lbiKeepName = lbiKeepName - 1
  lbiNoteDelivery(n.frFrom, TY_I32, -1)
  lbiNoteDelivery(n.frTo, TY_I32, -1)
  if !assignable(frFrom, TY_I32) || !assignable(frTo, TY_I32) {
    if forRangeFloatish(frFrom) || forRangeFloatish(frTo) {
      tErr(
        "a `for` range counts in i32, so "
          + tyToStr(frFrom)
          + " and "
          + tyToStr(frTo)
          + " bounds have no step — count with an integer and scale: `for i in 0 to 10 { const x = i / 10.0 }`",
        ix,
      )
    } else {
      tErr(
        "for-range bounds must be i32, got "
          + tyToStr(frFrom)
          + " and "
          + tyToStr(frTo),
        ix,
      )
    }
  }
  if n.frStep >= 0 {
    lbiKeepName = lbiKeepName + 1
    const frStep = checkNode(n.frStep)
    lbiKeepName = lbiKeepName - 1
    lbiNoteDelivery(n.frStep, TY_I32, -1)
    if !assignable(frStep, TY_I32) {
      if forRangeFloatish(frStep) {
        tErr(
          "a `for` range counts in i32, so a "
            + tyToStr(frStep)
            + " step has no iteration count — count with an integer and scale: `for i in 0 to 10 { const x = i / 10.0 }`",
          ix,
        )
      } else {
        tErr("for-range step must be i32, got " + tyToStr(frStep), ix)
      }
    }
  }
  checkRangeNeverRuns(n.frFrom, n.frTo, n.frStep, n.frExcl)
  // A `for` body re-executes with no condition to re-establish anything, so every
  // narrowing live here predates it — see `pushReBarrier`.
  pushReBarrier(crLoopRdSlots.length)
  pushScope(ix)
  declare(n.frVar, TY_I32)
  symDecl(n.frVar, ix, TY_I32, 0)
  // Loop body may run zero times — see `WhileStmt` (A-definite-assign).
  const daFrMark = daMark()
  // The loop variable is always assigned in the body — clear it from the dead-zone so a body
  // read isn't flagged when it shadows a still-uninitialized module global of the same name.
  daMarkAssigned(n.frVar)
  markValDiscard(n.frBody)
  lpPush(n.frLabel)
  checkNode(n.frBody)
  const res = lpPopResult(ix, -1, -1, true)
  daRollbackTo(daFrMark)
  daRelease(daFrMark)
  popScope()
  popReBarrier()
  return res
}
// ── for v in iterable ───────────────────────────────────────────────────────
// A for-in loop over an array: the loop variable binds to the element type.

// Extracted from `checkNodeReal`'s `ForIn` arm (C3: thin the dispatcher).
function checkForInNode(n: ForIn, ix: i32) {
  crLoopPreRetire(ix)
  let iterTy = checkNode(n.fiIter)
  if iterTy >= 0 { iterTy = strLitRecvTy(iterTy) }
  let elemTy = forInBindTy(iterTy, false)
  let elem2Ty = forInBindTy(iterTy, true)
  const it = T.tys[iterTy]
  let luMs = luMembers(iterTy)
  if !luRecvLowers(n.fiIter, luMs) { luMs = [] }
  const luElem = if luMs.length > 0 { luElemTy(luMs) } else { -1 }
  if luElem >= 0 {
    if !inferQuiet {
      const luf = luForInAt(n, ix, iterTy, luMs, luElem)
      if luf >= 0 { return TY_VOID }
    }
    elemTy = luElem
    elem2Ty = TY_I32
  }
  if luElem >= 0 && inferQuiet {
    // Typed as the rewrite will type it; the real pass rewrites the loop.
  } else if it is TyArray || it is TyMap || isStringTy(iterTy) || it is TyErr {
    // Iterable (or already reported): `forInBindTy` has typed both bindings.
  } else if it is TyObj {
    // A struct is a NOMINAL record whose fields have different types, so a loop variable over
    // one has no type to bind, and the field read the author wants needs a key no operation
    // accepts. The map is the collection with keyed iteration (`open-rulings.md` §B8-for-struct).
    tErr(
      "a struct's fields are not a sequence, so `for … in "
        + tyToStr(iterTy)
        + "` has nothing to iterate — use a map (`{[string]: i32}`) for keyed iteration, or read the fields by name",
      n.fiIter,
    )
  } else {
    tErr(
      "for-in expects an array, a map or a string, got " + tyToStr(iterTy),
      n.fiIter,
    )
  }
  // See ForRange: a `for` body re-executes with nothing to re-establish a narrowing.
  pushReBarrier(crLoopRdSlots.length)
  pushScope(ix)
  declare(n.fiVar, elemTy)
  symDecl(n.fiVar, ix, elemTy, 0)
  // Every element read under an element-only narrowing fits its leaf: a write in the loop that
  // may leave it ended it before the loop (`crLoopPreRetire`).
  efLeaf[ix] = -1
  if it is TyArray {
    const fk = elemOnlyKeyOf(n.fiIter)
    if fk != "" { elemFactFor(ix, elemRecvPrefix(n.fiIter), fk) }
    narrowFreshBinding(n.fiVar, ix)
  }
  if n.fiVar2 != "" {
    declare(n.fiVar2, elem2Ty)
    symDecl(n.fiVar2, ix, elem2Ty, 0)
  }
  // Loop body may run zero times — see `WhileStmt` (A-definite-assign).
  const daFiMark = daMark()
  // See ForRange: clear the loop var from the dead-zone for the body so it can't
  // collide with a shadowed, still-uninitialized module global of the same name.
  daMarkAssigned(n.fiVar)
  if n.fiVar2 != "" { daMarkAssigned(n.fiVar2) }
  markValDiscard(n.fiBody)
  lpPush(n.fiLabel)
  checkNode(n.fiBody)
  const res = lpPopResult(ix, -1, -1, true)
  daRollbackTo(daFiMark)
  daRelease(daFiMark)
  popScope()
  popReBarrier()
  return res
}
// ── return ─────────────────────────────────────────────────────────────────

// Settles the `return <void expr>` sites an inferred body recorded from `from` on: refused when
// the function's final return type `ret` is a value, kept for `voidRetRewrite` when it is void.
function refuseVoidRetsFrom(from: i32, ret: i32) {
  if from < 0 || from > inferVoidRetSites.length { return 0 }
  const valued = ret >= 0 && !isVoidTy(ret) && ret != TY_ERR && ret != TY_NEVER
  let i = from
  while i < inferVoidRetSites.length {
    if valued {
      tErr(
        "return expects a value of type " + tyToStr(ret) + ", got void",
        inferVoidRetSites[i],
      )
    } else if isVoidTy(ret) {
      voidRetRwRet.push(inferVoidRetSites[i])
      voidRetRwBlk.push(inferVoidRetBlks[i])
    }
    i = i + 1
  }
  while inferVoidRetSites.length > from {
    inferVoidRetSites.pop()
    inferVoidRetBlks.pop()
  }
  0
}

// Extracted from `checkNodeReal`'s `RetStmt` arm (C3: thin the dispatcher).
function checkRetStmtNode(n: RetStmt, ix: i32) {
  const want = T.curRet
  if tpEnvNames.length > 0 { tpIfMarkOk(n.retArg) }
  // `T.curRet` is only ever `-1` at its `initChecker` reset, never written by a
  // function-body check (`checkFuncDeclNode` always saves/restores a real return type or
  // the `-2` inferring sentinel) — so `-1` here means this `return` is not inside any
  // function, lambda, method or getter body (PL-028, D2262).
  if want == -1 {
    tErr(
      "`return` is only valid inside a function; to end the program early use `exit(code)` from `std:process`, or restructure with `else`",
      ix,
    )
    return TY_VOID
  }
  // Only a call that itself never returns may stand in a `never` function's `return` (D1972).
  if want == TY_NEVER && want >= 0 {
    if n.retArg < 0 || checkNode(n.retArg) != TY_NEVER {
      tErr(
        "a function declared `never` cannot return — end the path in a call that never returns, such as `__trap__()`",
        ix,
      )
    }
    return TY_VOID
  }
  if n.retArg < 0 {
    // `tyIsHole` because `assignable` waves a `TyVar` past any destination, so a declared
    // `: T` accepted the bare return here and the emitter refused the instance (D1600).
    if want >= 0 && (tyIsHole(want) || !assignable(TY_VOID, want)) {
      // Both route-arounds, because either can be intended: the annotation is what makes this
      // return illegal, so dropping it is as valid a fix as supplying a value.
      tErr(
        "return needs a value of type "
          + tyToStr(want)
          + " — return a value, or annotate this function `: void`",
        ix,
      )
    }
    return TY_VOID
  }
  // Under a pending return type (-2: this function's return is being inferred),
  // record the returned type as a witness instead of checking a mismatch.
  if want == -2 {
    // A returned call whose deferred join this site could not decide contributes the
    // whole join, not the lossy collapse the emitter gets (`inferRetTyOf`).
    const savedInRetArg = inRetArg
    inRetArgSet(true)
    const cbArg = cycleBreakCount
    const rArgTy = checkNode(n.retArg)
    inRetArgSet(savedInRetArg)
    // `return <void expr>` evaluates the expression and returns nothing, so it is a void
    // return; the function's finish refuses it if the function returns a value. A void that is
    // only a recursive cycle's provisional answer is still a value return position (D2635).
    if (
      isVoidTy(rArgTy)
      && cycleBreakCount == cbArg
      && !voidSlotExemptExpr(n.retArg)
    ) {
      inferVoidRetSites.push(ix)
      inferVoidRetBlks.push(chkStmtBlk)
      return TY_VOID
    }
    fnSawValueRetSet(true)
    // `return <void call>` names a value to return and has none — reported here rather than
    // left to the mismatch check below, which never sees this path (the return type is still inferred).
    if voidValueSlotErr(rArgTy, n.retArg, "return", ix) { return TY_VOID }
    // D1045 — a body-scoped nominal type may not escape through an inferred return.
    refuseLocalNomEscape(rArgTy, ix)
    // An empty-collection hole returned here has a destination not final until the body ends
    // — the pin is deferred to `flushInferRetHoles` rather than skipped (D1591).
    noteInferRetWitness(n.retArg, rArgTy)
    inferRetNextLitSet(armLit(rArgTy, n.retArg))
    noteInferredRet(inferRetTyOf(n.retArg, rArgTy))
    return TY_VOID
  }
  // Bidirectional: `function mk(): (i32) => i32 { return (x) => … }` infers the returned
  // lambda's param from the declared return type (also through a composite return shape).
  if want >= 0 { seedExpected(n.retArg, want) }
  const cbGot = cycleBreakCount
  const got = checkNode(n.retArg)
  // Under a void return `assignable` passes anything void-bearing, so this gate refuses a union
  // that mentions void. A wholly void value is a void return: `return g()` calls, then returns (D2635).
  if isVoidTy(want) {
    if isVoidTy(got) && cycleBreakCount == cbGot {
      voidRetRwRet.push(ix)
      voidRetRwBlk.push(chkStmtBlk)
      return TY_VOID
    }
    if voidValueSlotErr(got, n.retArg, "return", ix) { return TY_VOID }
  }
  // Redundant-return rule: witness the explicit return's natural type (before
  // constrainEmpty); an annotation-influenced return disqualifies the function.
  if retInfluencedByAnnot(n.retArg) || retSiteTypedByAnnot(n.retArg, got) {
    retNaturalErrSet(true)
  }
  noteNaturalRet(got)
  // An explicit `return inner` of an empty collection pins its element from the
  // declared return type — usage-driven inference clearing the floor.
  constrainEmptyExpr(n.retArg, got, want)
  if want >= 0 && !assignableExpr(n.retArg, got, want) {
    tErrWant(
      "return type mismatch: expected "
        + tyToStr(want)
        + ", got "
        + tyToStr(got)
        + bareRetVoidNote(want)
        + charLitForStringNote(n.retArg, want)
        + boolForNumberNote(got, want)
        + storageListNote(n.retArg, got, want)
        + litMemberNote(n.retArg, want, 8),
      n.retArg,
      want,
    )
  } else if want >= 0 {
    // The check above is vacuous whenever a side is a hole — record the pair for the pin to
    // re-ask under substitution, only on the passing side (D551 body / D561 declared side).
    noteRetCstr(coalPinTy(n.retArg, got), want, n.retArg)
  }
  return TY_VOID
}
// ── block ─────────────────────────────────────────────────────────────────

// The value a discarded `if` would have had: its arms' join, or `T | null` without an else.
// A join clash is a value nobody reads, so it is not reported.
function discardedIfValTy(hasElse: boolean, thenTy: i32, elseTy: i32): i32 {
  if hasElse {
    const savedClash = joinClashMsg
    const j = joinArmTys(thenTy, elseTy)
    joinClashMsgSet(savedClash)
    return j
  }
  if thenTy != TY_VOID && thenTy != TY_ERR { return mkNullableTy(thenTy) }
  TY_VOID
}

// Extracted from `checkNodeReal`'s `Block` arm (C3: thin the dispatcher).
function checkBlockNode(n: Block, ix: i32) {
  const blkOnSpine = spineAt == ix
  const savedStmtBlk = chkStmtBlk
  chkStmtBlkSet(ix)
  pushScope(ix)
  const stmts = n.blkStmts
  const blkDiscard = valDiscarded(ix)
  const savedRTP = retTailPos
  let tailTy = TY_VOID
  let tailIx = -1
  let i = 0
  while i < stmts.length {
    // Only the last statement is the block's value (and inherits tail position); the
    // rest are not the block's value, so they never carry the return tail.
    if i == stmts.length - 1 {
      retTailPosSet(savedRTP)
    } else {
      retTailPosSet(false)
    }
    if (
      (blkDiscard || i < stmts.length - 1)
      && !(lpOn && breakValueAt(stmts, i))
    ) {
      markValDiscard(stmts[i])
    }
    crStmtEnter(stmts[i])
    let sty = TY_VOID
    if blkOnSpine && i == stmts.length - 1 {
      spineAtSet(stmts[i])
      sty = checkNode(stmts[i])
      spineAtSet(ix)
    } else {
      sty = checkNode(stmts[i])
    }
    crStmtLeave()
    if lpOn { brkPrevTySet(sty) }
    if i == stmts.length - 1 {
      // A value-producing trailing expression is the block's value; a trailing
      // statement (return / let / assignment / loop) leaves the block valueless.
      if !isStmtNode(stmts[i]) {
        tailTy = sty
        tailIx = stmts[i]
      } else {
        // An if-expression tail IS the block's value even though `IfStmt` is otherwise a
        // statement node — non-void only for a genuine value-`if` with an else.
        const lastN2 = P.nodes[stmts[i]]
        if lastN2 is IfStmt {
          // A discarded tail keeps its value here, typed on no node, for an enclosing arm's join.
          const ity = discardedValTyOf(stmts[i], sty)
          if lastN2.ifElse >= 0 {
            if ity != TY_VOID && ity != TY_ERR {
              tailTy = ity
              tailIx = stmts[i]
            }
          } else {
            // An else-less `if` ending a block is its `T | null` value, as a tail one is, when
            // its then-arm completes with a value (D1995's ruling); a then-arm that always
            // exits yields nothing here, and its fall-through meets the function's own `null`.
            if (
              ity != TY_VOID
              && ity != TY_ERR
              && !stmtAlwaysExits(lastN2.ifThen)
            ) {
              tailTy = ity
              tailIx = stmts[i]
            }
          }
        }
      }
    }
    i = i + 1
  }
  retTailPosSet(savedRTP)
  popScope()
  chkStmtBlkSet(savedStmtBlk)
  blockTailTySet(tailTy)
  blockTailIxSet(tailIx)
  return TY_VOID
}
