// The field walk of `objRetWidenAdopt`: `litIx` is an ObjLit whose inferred `sTyIx` adopts the
// expected `dTyIx` field-wise, appending each re-encodable value node and its adopted field type
// to `recNodes`/`recTys`. False on any proven mismatch, in which case the caller keeps the
// inferred shape. Adoption is sound only where the literal body can re-encode at the wider rep.
function objLitWidenFields(
  litIx: i32,
  sTyIx: i32,
  dTyIx: i32,
  recNodes: i32[],
  recTys: i32[],
): boolean {
  const lit = P.nodes[litIx]
  if !(lit is ObjLit) { return false }
  const s = T.tys[sTyIx]
  const d = T.tys[dTyIx]
  if !(s is TyObj) { return false }
  if !(d is TyObj) { return false }
  if s.objFieldNames.length != d.objFieldNames.length { return false }
  let i = 0
  while i < d.objFieldNames.length {
    const dty = d.objFieldTypes[i]
    const sty = objFieldType(s, d.objFieldNames[i])
    if sty < 0 { return false }
    // The field's value expression in the literal body, shared by the numeric-widen and the
    // float-literal-to-f32 arms below.
    let fv = -1
    const fl = lit.objFields
    let fi = 0
    while fi < fl.length {
      const fn = P.nodes[fl[fi]]
      if fn is FieldInit {
        if fn.fiName == d.objFieldNames[i] { fv = fn.fiValue }
      }
      fi = fi + 1
    }
    if numWidens(sty, dty) {
      // The widening field's value must be a small int literal in the literal body.
      if fv < 0 { return false }
      const fvn = P.nodes[fv]
      if fvn is NumLit {
        if numLexIsFloat(fvn.numText) { return false }
        if !numLexFitsI32(fvn.numText) { return false }
        recNodes.push(fv)
        recTys.push(dty)
      } else {
        return false
      }
    } else if primNameOf(dty) == "f32" && isF32AdoptingLitExpr(fv) {
      // A literal into an f32 field (`() => ({a: 3.5, …})` against `{a: f32, …}`): the field infers
      // f64 or i32 but the literal re-encodes exactly at f32, the field dual of the scalar arm.
      // Record f32 on the value node so `anonFieldCode` interns the f32 field slot rather than
      // coding the literal's default.
      recNodes.push(fv)
      recTys.push(dty)
    } else if assignable(sty, dty) && !assignable(dty, sty) {
      // The field widens by boxing — a bare scalar or struct arm into a union or nullable field
      // (`{f: false}` against `{f: boolean | {w: i32}}`). Adopt when the literal value re-encodes
      // at the wider field type, and record that type so the emitter boxes the field slot;
      // `synthRetAnnots` then pins the lambda's `fnRet` to the whole struct shape.
      if fv < 0 { return false }
      let fvIn = fv
      let fvDone = false
      while !fvDone {
        const fvp = P.nodes[fvIn]
        if fvp is Paren { fvIn = fvp.parInner } else { fvDone = true }
      }
      const fvNode = P.nodes[fvIn]
      // The recursion targets a nested-struct destination only: an ObjLit value against a union
      // field is a member of that union, an arm rather than a field-wise widening target, and
      // descending into it refutes the whole adoption, leaving the emitter to key the outer
      // literal onto a same-field-name-set twin. A non-`TyObj` dest takes the member-flow check.
      let dtyIsObj = false
      const dtyT = T.tys[dty]
      if dtyT is TyObj { dtyIsObj = true }
      if fvNode is ObjLit && dtyIsObj {
        if !objLitWidenFields(fvIn, sty, dty, recNodes, recTys) { return false }
        recNodes.push(fvIn)
        recTys.push(dty)
      } else {
        if !assignableExpr(fv, sty, dty) { return false }
        recNodes.push(fv)
        recTys.push(dty)
      }
    } else if tyIsLitUnion(dty) {
      // A litunion field (`f: "8"` against `f: K0 = "xz" | "8"`): the body value is a bare string
      // literal that is a member of the expected literal union. It infers the softened `string`
      // but re-encodes as the litunion's i32 atom, so record the litunion field type and
      // `anonFieldCode` interns the atom slot rather than the string.
      if fv < 0 { return false }
      if !assignableExpr(fv, sty, dty) { return false }
      recNodes.push(fv)
      recTys.push(dty)
    } else {
      // A non-widening field must match exactly (mutual assignability) — a shape
      // difference beyond numeric widening is not an adoption, it is a mismatch.
      if !assignable(sty, dty) { return false }
      if !assignable(dty, sty) { return false }
    }
    i = i + 1
  }
  true
}

function objRetWidenAdopt(bodyIx: i32, inferredTy: i32, expRetTy: i32) {
  if inferredTy < 0 || expRetTy < 0 { return false }
  let u = lambdaBodyTail(bodyIx)
  if u < 0 { return false }
  let done = false
  while !done {
    const pn = P.nodes[u]
    if pn is Paren { u = pn.parInner } else { done = true }
  }
  const lit = P.nodes[u]
  if !(lit is ObjLit) { return false }
  const s = T.tys[inferredTy]
  // A nullable expected result (`() => {f: K0} | null`, spelled directly or through the
  // nullable-closure wrapper): adopt against the inner struct. The caller still adopts the full
  // nullable expected, so the lambda's `$fnsig` result keys the nullable struct exactly as the
  // annotation-side consumer does; without the unwrap the two sides key different structs.
  let expInnerTy = expRetTy
  const dn = T.tys[expRetTy]
  if dn is TyNullable { expInnerTy = dn.nInner }
  const d = T.tys[expInnerTy]
  if s is TyObj {
    if d is TyObj {
      const recNodes: i32[] = []
      const recTys: i32[] = []
      if !objLitWidenFields(u, inferredTy, expInnerTy, recNodes, recTys) {
        return false
      }
      if recNodes.length == 0 { return false }
      if !inferQuiet {
        let r = 0
        while r < recNodes.length {
          const rn = recNodes[r]
          while nodeTyIx.length <= rn { nodeTyIx.push(-1) }
          nodeTySet(rn, recTys[r])
          r = r + 1
        }
        // Rep sidecar: `nodeTyIx` above stamps the widening field values, but the top-level return
        // literal `u` keeps its naive self-inferred type, and `structIndexOfObjCtx` keys on the
        // literal node. Record the destination struct there, recursing into fields, so the rep
        // layer resolves the union-field / i64-field / nullable-niche shape the emitter builds.
        recordRepTyAdopt(u, expInnerTy, 6)
      }
      return true
    }
  }
  false
}

// ── deep `is` over a `Json` value ────────────────────────────────────────────

// Refuses a write through a union receiver of a value some member's field cannot hold: the
// read types the field as the members' join, and the write has to fit their meet. True when it
// refused.
function sharedFieldWriteRefused(
  tgt: Member,
  valIx: i32,
  vt: i32,
  ix: i32,
): boolean {
  const rt = nodeTyIxOf(parenPeelIx(tgt.memObj))
  if rt < 0 || rt >= T.tys.length || vt < 0 { return false }
  const r = T.tys[rt]
  if r is TyUnion {
    for mIx in r.uMembers {
      if mIx >= 0 && mIx < T.tys.length {
        const m = T.tys[mIx]
        if m is TyObj {
          const ft = objFieldType(m, tgt.memProp)
          if ft >= 0 && !assignableExpr(valIx, vt, ft) {
            tErr(
              "cannot assign "
                + tyToStr(vt)
                + " to `"
                + tgt.memProp
                + "` through a union: "
                + tyToStr(mIx)
                + " stores it as "
                + tyToStr(ft)
                + " — a write must fit every member, so narrow the receiver first",
              ix,
            )
            return true
          }
        }
      }
    }
  }
  false
}

// Record call `ix` through the marked binding `decl`, which re-asked the constraints `used` owns,
// with what it bound; `fsbRecheckCalls` re-asks those of every other function written to it.
function fsbNoteCall(
  ix: i32,
  decl: i32,
  used: i32,
  who: string,
  hNames: string[],
  hNo: i32[],
  hNode: i32[],
  argTys: i32[],
) {
  if decl < 0 || inferQuiet { return 0 }
  fsbCallArgTysPush(argTys)
  fsbCallIxPush(ix)
  fsbCallDeclPush(decl)
  fsbCallUsedPush(used)
  fsbCallWhoPush(who)
  fsbCallHNamesPush(hNames)
  fsbCallHNoPush(hNo)
  fsbCallHNodePush(hNode)
  fsbCallOwnNPush(0)
  // The writes already seen are re-asked here, inside the body the call stands in, so a pair
  // naming that body's type parameter is deferred to its instances as a direct call's is.
  fsbRecheckFrom(fsbCallIx.length - 1)
}

// Re-ask, at call `c`, each owner row recorded since it last asked.
export function fsbRecheckFrom(c: i32) {
  if c < 0 || c >= fsbCallOwnN.length { return 0 }
  let w = fsbCallOwnN[c]
  while w < fsbOwnDecl.length {
    if fsbOwnDecl[w] == fsbCallDecl[c] {
      fsbRecheckOne(c, fsbOwnFn[w], fsbOwnTy[w])
    }
    w = w + 1
  }
  fsbCallOwnNSetAt(c, fsbOwnDecl.length)
  0
}

// One call `c` re-asks owner `o`'s constraints with each type-variable parameter of the written
// function type `rt` bound, by position, to the argument the call passes there. Only the written
// function's own parameters are bound: the seed's type variables name another declaration's.
function fsbRecheckOne(c: i32, o: i32, rt: i32) {
  const nm: string[] = []
  const ty: i32[] = []
  const added = fsbBindParams(rt, fsbCallArgTys[c], nm, ty)
  if added == 0 || o == fsbCallUsed[c] { return 0 }
  if !fsbArgsFit(c, rt, nm, ty) { return 0 }
  const modeWas = substNestMode
  const declWas = substNestDecl
  substNestModeSet(SUBST_ALL)
  if o >= 0 { substNestModeSet(SUBST_DECLARED) }
  const ix = fsbCallIx[c]
  const who = fsbCallWho[c]
  const callee = fsbOwnerCallee(o)
  cstrOwnedStrictSet(o >= 0)
  validateBinCstrs(
    nm,
    ty,
    ix,
    callee,
    who,
    fsbCallHNames[c],
    fsbCallHNo[c],
    fsbCallHNode[c],
  )
  validatePrintCstrs(nm, ty, ix, callee, who)
  validateIsCstrs(nm, ty, ix, callee, who)
  validateArgCstrs(nm, ty, ix, callee, fsbCallHNames[c], fsbCallHNode[c])
  validateRetCstrs(nm, ty, ix, callee, who)
  validateLetCstrs(nm, ty, ix, callee, who)
  validateBmCstrs(nm, ty, ix, callee, who)
  validateMemCstrs(
    nm,
    ty,
    ix,
    callee,
    who,
    fsbCallHNames[c],
    fsbCallHNo[c],
    fsbCallHNode[c],
  )
  cstrOwnedStrictSet(false)
  substNestModeSet(modeWas)
  substNestDeclSet(declWas)
  0
}

// A delivery of the marked binding `src` to the concrete function type `dst` is a call at `dst`'s
// parameters for every function written to it (D3968).
function fsbNoteFnDelivery(src: i32, dst: i32) {
  if dst < 0 || dst >= T.tys.length || src < 0 { return 0 }
  const f = T.tys[dst]
  // An element of an array literal, or a field of an object literal, is delivered to the
  // destination's element or field type.
  const sn = P.nodes[parenPeelIx(src)]
  if f is TyNullable { return fsbNoteFnDelivery(src, f.nInner) }
  if sn is ArrayLit {
    if f is TyArray {
      for e in sn.arrElems { fsbNoteFnDelivery(e, f.aElem) }
    }
    return 0
  }
  if sn is ObjLit {
    if f is TyObj {
      for fi in sn.objFields {
        const fn = P.nodes[fi]
        if fn is FieldInit {
          fsbNoteFnDelivery(fn.fiValue, objFieldType(f, fn.fiName))
        }
      }
    }
    return 0
  }
  if !(f is TyFunc) || tyHasTyVar(dst) { return 0 }
  const d = fsbDeclAtNode(src)
  if d < 0 { return 0 }
  const args: i32[] = []
  for p in f.fnParamTypes { args.push(p) }
  const none: string[] = []
  const noIx: i32[] = []
  const noNode: i32[] = []
  fsbNoteCall(src, d, CSTR_ANYFN, "", none, noIx, noNode, args)
}

// The if-joins of `calleeFn` a call re-asks at its bindings: a join that stays apart there
// re-checks the callee's body at the pinned parameter types `pTys`, and one still open (a
// generic caller) is parked until the caller's own pin (D2832).
function validateTpIfJoins(
  bNames: string[],
  bTys: i32[],
  pTys: i32[],
  retTy: i32,
  ix: i32,
  calleeFn: i32,
) {
  if calleeFn < 0 || monoRecheckDepth > 0 || inferQuiet { return 0 }
  const owner = cstrOwnerTop()
  if tysHaveTyVarIn(bTys) {
    if owner >= 0 && tpIfFnHasRow(calleeFn) {
      noteTpIfRe(calleeFn, owner, bNames, bTys, pTys)
    }
  } else {
    tpIfPinCheck(calleeFn, pTys, bNames, bTys, retTy, ix)
  }
  // The joins a generic callee of this body left open, now pinned in this body's terms.
  const n0 = tpIfReFn.length
  let r = 0
  while r < n0 {
    if tpIfReOwner[r] == calleeFn {
      const rNames: string[] = []
      const rTys: i32[] = []
      let q = 0
      while q < tpIfReCount[r] {
        rNames.push(tpIfReNames[tpIfReStart[r] + q])
        rTys.push(substTyDeep(tpIfReTys[tpIfReStart[r] + q], bNames, bTys))
        q = q + 1
      }
      const rParams: i32[] = []
      const ps = tpIfReParams[r]
      let pi = 0
      while pi < ps.length {
        rParams.push(substTyDeep(ps[pi], bNames, bTys))
        pi = pi + 1
      }
      if tysHaveTyVarIn(rTys) {
        if owner >= 0 { noteTpIfRe(tpIfReFn[r], owner, rNames, rTys, rParams) }
      } else {
        tpIfPinCheck(tpIfReFn[r], rParams, rNames, rTys, -1, ix)
      }
    }
    r = r + 1
  }
  0
}

// The joins of `fn` at the concrete bindings `bNames`/`bTys`: one that stays apart where it is
// not built as a union refuses the call, and otherwise the body is re-checked there.
function tpIfPinCheck(
  fn: i32,
  pTys: i32[],
  bNames: string[],
  bTys: i32[],
  retTy: i32,
  ix: i32,
) {
  let apartJ = -1
  let unbuilt = -1
  let k = 0
  while k < tpIfFn.length {
    if tpIfFn[k] == fn {
      const sj = substTyDeep(tpIfJoin[k], bNames, bTys)
      if sj >= 0 && !tyHasTyVar(sj) && tyUnionAllLists(sj) {
        // The widest names the whole chain of an `else if`, whose links are rows too.
        if apartJ < 0 || unionMemberCountOf(sj) > unionMemberCountOf(apartJ) {
          apartJ = sj
        }
        if unbuilt < 0 && !tpIfRowBuilt(k) { unbuilt = sj }
      }
    }
    k = k + 1
  }
  if apartJ < 0 { return 0 }
  let msg = ""
  if unbuilt >= 0 {
    apartJ = unbuilt
    msg = "no one list holds it where its value goes — bind it to a `const`, or deliver it where its union is declared"
  } else {
    msg = tpIfRecheck(fn, pTys, bNames, bTys, retTy)
  }
  if msg == "" { return 0 }
  let fWho = "the callee's body"
  const fd = P.nodes[fn]
  if fd is FuncDecl {
    if fd.fnName != "" { fWho = "the body of `" + fd.fnName + "`" }
  }
  tErr(
    "at the call's argument types, the branches of an `if` or `match` in "
      + fWho
      + " join "
      + tpMembersListText(apartJ)
      + ": "
      + msg,
    ix,
  )
  0
}

// Re-checks the body of `fn` at the pinned parameter types `pTys`, where a join of its is a
// union of lists, and answers the first sentence that body earns there ("" for none). A value
// the body hands back is held to the call's type `retTy` (-1: not asked), and a list or record
// the instance would build of the join at the template's one-list type is refused.
function tpIfRecheck(
  fn: i32,
  pTys: i32[],
  bNames: string[],
  bTys: i32[],
  retTy: i32,
): string {
  const dn = P.nodes[fn]
  if !(dn is FuncDecl) { return "" }
  let i = 0
  while i < pTys.length {
    if pTys[i] < 0 || tyHasTyVar(pTys[i]) { return "" }
    i = i + 1
  }
  let want = retTy
  if want >= 0 && (tyHasTyVar(want) || want == TY_ERR || isVoidTy(want)) {
    want = -1
  }
  if prbArmed { prbEnter() }
  const cs = checkMark()
  const savedRet = T.curRet
  const savedFn = curFnDeclIx
  const savedNat = retNatural
  const savedNatErr = retNaturalErr
  // An unasked return is `TY_ERR`, which every value passes: `-2` would bank the returns as
  // witnesses of whatever function is being inferred around this call.
  if want >= 0 { T.curRet = want } else { T.curRet = TY_ERR }
  curFnDeclIx = fn
  const savedNjFn = njFnIx
  njFnIxSet(fn)
  cstrOwnerStack.push(fn)
  tpIfCmpNamesSet(bNames)
  tpIfCmpTysSet(bTys)
  tpIfCmpBadSet("")
  tpIfCmpOnSet(true)
  const d0 = T.diags.length
  let msg = ""
  const sv = monoRecheckBegin(fn, pTys, bNames, bTys)
  if sv != null {
    if T.diags.length > d0 { msg = T.diags[d0].tmsg }
    if msg == "" && want >= 0 {
      const rets: i32[] = []
      collectRetValues(dn.fnBody, rets)
      let r = 0
      while r < rets.length && msg == "" {
        const rt = checkNode(rets[r])
        if rt >= 0 && rt != TY_ERR && rt != TY_VOID && rt != TY_NEVER {
          if !assignable(rt, want) {
            msg = "it returns "
              + tyToStr(rt)
              + ", which the call reads as "
              + tyToStr(want)
          }
        }
        r = r + 1
      }
    }
    monoRecheckEnd(sv)
  }
  tpIfCmpOnSet(false)
  if msg == "" { msg = tpIfCmpBad }
  cstrOwnerStack.pop()
  curFnDeclIx = savedFn
  njFnIxSet(savedNjFn)
  T.curRet = savedRet
  retNaturalSet(savedNat)
  retNaturalErrSet(savedNatErr)
  checkRollback(cs, RB_PINNED)
  if prbArmed { prbLeave("tpIfRecheck") }
  msg
}

// A declared generic function delivered by name as a value to the concrete function type
// `dstTy` is instantiated there, so the constraints its body deferred are adjudicated at the
// bindings that type gives its parameters, as a direct call's are (D3080).
function genFnValueCstrs(srcExpr: i32, srcTy: i32, dstTy: i32) {
  // A validator re-delivers a recorded value through `assignableExpr`, which must not re-enter.
  // With no generic declared, or no function type in the destination, there is nothing to bind.
  if genFnCstrBusy || !cstrCandAny || !tyMayHoldFn(dstTy, 0) { return 0 }
  genFnCstrBusySet(true)
  genFnValueCstrsAt(srcExpr, srcTy, dstTy, 0)
  genFnCstrBusySet(false)
  0
}

// `genFnValueCstrs` at `srcExpr`, reaching through the fields of an object literal and the
// elements of a list literal delivered to a record or list type, `depth` levels down.
function genFnValueCstrsAt(srcExpr: i32, srcTy: i32, dstTy: i32, depth: i32) {
  if srcExpr < 0 || dstTy < 0 || depth > 8 { return 0 }
  const lit = P.nodes[parenPeelIx(srcExpr)]
  if lit is ObjLit {
    const dobj = T.tys[dstTy]
    if dobj is TyObj {
      for fi in lit.objFields {
        const f = P.nodes[fi]
        if f is FieldInit {
          const ft = objFieldType(dobj, f.fiName)
          if ft >= 0 {
            genFnValueCstrsAt(f.fiValue, nodeTyOf(f.fiValue), ft, depth + 1)
          }
        }
      }
    }
    return 0
  }
  if lit is ArrayLit {
    const darr = T.tys[dstTy]
    if darr is TyArray {
      for el in lit.arrElems {
        genFnValueCstrsAt(el, nodeTyOf(el), darr.aElem, depth + 1)
      }
    }
    return 0
  }
  const e = lit
  if !(e is Ident) { return 0 }
  let st = srcTy
  if st < 0 { st = lookup(e.identName) }
  if st < 0 { return 0 }
  let decl = fnDeclIx[e.identName] ?? CSTR_NODECL
  // A generic nested in the enclosing function, delivered where that function's own type
  // parameters type the destination (`return b` at `(T) => void`): its demands are re-recorded
  // at those parameters, as a call of it in the enclosing body is (D3896).
  let nested = false
  if decl < 0 {
    const nd = lookupFnDeclNode(e.identName)
    if nestParentOf.has(nd) {
      decl = nd
      nested = true
    }
  }
  if decl < 0 || decl >= P.nodes.length { return 0 }
  const fd = P.nodes[decl]
  if !(fd is FuncDecl) { return 0 }
  if fd.fnTyParams.length == 0 { return 0 }
  let dt = dstTy
  const dn = T.tys[dt]
  if dn is TyNullable { dt = dn.nInner }
  // At a concrete destination a nested generic is the function-value adapter's to check, which
  // reports the same demand as its reason.
  const open = tyHasTyVar(dt)
  if dt < 0 || (nested && !open) { return 0 }
  // A generic declared elsewhere is deferred only to the generic whose body is being checked,
  // so every type variable of the destination must be that generic's.
  if !nested && open && !tyVarsOfEnclosingGeneric(dt) { return 0 }
  const s = T.tys[st]
  const d = T.tys[dt]
  if !(s is TyFunc) || !(d is TyFunc) { return 0 }
  if s.fnParamTypes.length != d.fnParamTypes.length { return 0 }
  const bNames: string[] = []
  const bTys: i32[] = []
  let i = 0
  while i < s.fnParamTypes.length {
    bindGenWalk(s.fnParamTypes[i], d.fnParamTypes[i], bNames, bTys)
    i = i + 1
  }
  if bNames.length == 0 { return 0 }
  const noN: string[] = []
  const noNo: i32[] = []
  const noNode: i32[] = []
  const who = e.identName
  const noArgs: i32[] = []
  const modeWas = substNestMode
  const declWas = substNestDecl
  const strictWas = cstrOwnedStrict
  const cvWas = cvNow
  let owner = decl
  if nested {
    owner = CSTR_NODECL
    substNestModeSet(SUBST_NESTED)
    substNestDeclSet(decl)
  } else if open {
    // A destination typed by the enclosing generic's parameters defers what it cannot decide to
    // that generic, as a direct call in its body does; only the delivered function's own
    // constraints are re-asked (D3923).
    substNestModeSet(SUBST_DECLARED)
    cstrOwnedStrictSet(true)
    // What is deferred carries this delivery, which the refusal at the pin names.
    cvNow = srcExpr
  }
  pinBmCstrElems(bNames, bTys, srcExpr, owner, noArgs)
  validateBinCstrs(bNames, bTys, srcExpr, owner, who, noN, noNo, noNode)
  validatePrintCstrs(bNames, bTys, srcExpr, owner, who)
  validateNestCstrs(bNames, bTys, srcExpr, owner, who)
  validateArgCstrs(bNames, bTys, srcExpr, owner, noN, noNode)
  validateRetCstrs(bNames, bTys, srcExpr, owner, who)
  validateLetCstrs(bNames, bTys, srcExpr, owner, who)
  validateBmCstrs(bNames, bTys, srcExpr, owner, who)
  validateMemCstrs(bNames, bTys, srcExpr, owner, who, noN, noNo, noNode)
  validateUfcsCstrs(bNames, bTys, srcExpr, owner, who)
  cstrOwnedStrictSet(strictWas)
  cvNow = cvWas
  substNestModeSet(modeWas)
  substNestDeclSet(declWas)
  0
}

export function assignableExpr(srcExpr: i32, srcTy: i32, dstTy: i32) {
  lbiNoteDelivery(srcExpr, dstTy, nlAsgTgt)
  nolNoteDelivery(srcExpr, dstTy)
  if fsbName.length > 0 && !inferQuiet && srcExpr >= 0 {
    fsbNoteFnDelivery(srcExpr, dstTy)
  }
  if numUnionMinted && numUnionConverts(srcTy, dstTy) && !njExprHeld(srcExpr) {
    return true
  }
  if litNumUnionConverts(srcTy, dstTy) && !njExprHeld(srcExpr) {
    numUnionMinted = true
    return true
  }
  if srcExpr >= 0 && dstTy >= 0 {
    const cse = P.nodes[srcExpr]
    if cse is NumLit || cse is Unary || cse is Paren {
      if cexDeliver(srcExpr, dstTy) { return true }
    }
  }
  // A bare `{}` completes against a record destination; a required field it omits is refused
  // here, in words, instead of as the site's generic mismatch (D2223).
  if bareBraceDeliver(srcExpr, dstTy, 8, true) { return true }
  // A generic function value meeting a concrete function type is decided by instantiation inside
  // `assignable`'s `TyFunc` case (`genericFnAssignable`), so it governs nested positions like an
  // array element too, not just this expression-level entry.
  recordElemRepArrayLit(srcExpr, dstTy, 6)
  recordNullHoleObjAdopt(srcExpr, dstTy, 6)
  recordListFieldWidenAdopt(srcExpr, dstTy)
  // A hex / binary / octal literal is a bit pattern of the destination's width, and this seam is
  // where every binding / argument / return / field / element / store position delivers one.
  if srcTy == TY_I32 && litTreeAdoptDst(parenPeelIx(srcExpr), dstTy) >= 0 {
    return true
  }
  if radixLitAdoptDst(srcExpr, dstTy) == 2 { return true }
  // Rep sidecar: an ObjLit/ArrayLit whose source type reaches an unresolved empty-collection hole
  // (`{nodes: []}`, `{m: Map()}`) is plainly `assignable` to its concrete destination, so the
  // short-circuit below returns before the adoption block. Record the destination here so the
  // emitter's row resolver keys the element-resolved shape. Writes only `nodeRepTyIx`.
  if !inferQuiet && srcExpr >= 0 && tyReachesEmptyHole(srcTy, 8) {
    recordRepTyAdopt(srcExpr, dstTy, 6)
  } else if !inferQuiet && srcExpr >= 0 && tyReachesUnion(dstTy, 8) {
    // Union-softening adoption (see `tyReachesUnion`): an ObjLit/ArrayLit whose field value
    // narrowed a destination union field leaves the recorded rep type softened, mis-resolving a
    // same-fieldset twin. Re-stamp the destination rep so the emitter's structural row resolver
    // keys the union-bearing shape. Writes only `nodeRepTyIx`.
    recordRepTyAdopt(srcExpr, dstTy, 6)
  }
  // The flow hook for the un-annotated-parameter solve. It sits above the `assignable`
  // short-circuit because a hole source always returns there, so this is the only point in the
  // function a hole reaches — and every binding / argument / return / field / element / store
  // position flows through here. Inert unless the parameter-solve probe is running.
  noteHoleFlow(srcTy, dstTy, srcExpr)
  if !inferQuiet && narListDeliveryErr(srcExpr, srcTy, dstTy) { return true }
  if assignable(srcTy, dstTy) {
    if !inferQuiet && srcExpr >= 0 { genFnValueCstrs(srcExpr, srcTy, dstTy) }
    if fvaAdapt(srcExpr, srcTy, dstTy) { return true }
    // The constraint probe records a hole delivery's pin as well, so a caller whose body is
    // checked before this one still re-asks it at its own pins.
    if cstrProbe && srcExpr >= 0 { rcwPinProbe(srcExpr, srcTy, dstTy) }
    // The object-shape floor. `assignable` accepts structural subtyping between two object shapes
    // and the emitter has no adapter for it (`objShapeAdapterless`), so the pair would reach codegen
    // and fail there on a file `vl check` reports clean. It belongs at this seam, the one every
    // delivery flows through. Reported here and answered true, the program being type-valid.
    if !inferQuiet && srcExpr >= 0 {
      // The `Writable` floor (D793). A covariant list assignment whose value is written through
      // cannot be lowered by either answer the language has — an alias admits a type-confused read,
      // and a converting copy gives one handle a private list. The assignment itself is illegal,
      // reported at this seam and answered true, the program being type-valid.
      const cwCode = covarWriteThrough(srcExpr, srcTy, dstTy)
      if cwCode == 1 {
        covarWriteThroughErr(srcExpr, srcTy, dstTy)
        return true
      }
      // D853 — the second arm is a different unsoundness and says so. Two declared unions over one
      // written-through list share one box, so nothing is copied and "the two element storages
      // differ" would be false. The message names the arms rather than the storages.
      if cwCode == 2 {
        covarTwoUnionsErr(srcExpr, srcTy, dstTy)
        return true
      }
      noteRefListView(srcExpr, srcTy, dstTy)
      // D2060 — the record twin: a field widened by this delivery is shared with the source,
      // so it is legal only where nothing the delivery reaches writes it.
      rcwPend(srcExpr, srcTy, dstTy)
      if mapDeliveryMayRecord(srcExpr, srcTy, dstTy) {
        recordMapUnbox(srcExpr, srcTy, dstTy, 8)
      } else if tyWideUnionMinted {
        recordListWidenRetag(srcExpr, srcTy, dstTy)
      }
      if !wsSuppress && objShapeAdapterlessAt(srcExpr, srcTy, dstTy) {
        objShapeAdapterlessErr(srcExpr, srcTy, dstTy)
      } else if srcTy != dstTy {
        let recDst = dstTy
        if dstTy == lwStoreDst && lwStoreVal >= 0 { recDst = lwStoreVal }
        recPend(srcExpr, srcTy, recDst, srcExpr)
      } else if T.tys[srcTy] is TyObj || T.tys[srcTy] is TyArray {
        recOwnPend(srcExpr, srcTy)
      }
    }
    return true
  }
  if !inferQuiet && srcExpr >= 0 && recAdForce(srcExpr, srcTy, dstTy) {
    return true
  }
  // Nominal newtype: a syntactic literal is brand-polymorphic and adopts the destination's brand
  // (`const e: EntityId = 1`). A literal has no prior identity, so it cannot be the confusion a
  // newtype exists to catch. Only the destination's own brand is waived, by retrying against the
  // base index; an object literal needs no arm, its field-wise block re-applying the rule per field.
  if nomLitAdopts(srcExpr, srcTy, dstTy) { return true }
  // Function value into a void slot: a `(P…) => T` value is assignable where `(P…) => void` is
  // expected — the coercion that keeps "extract the inline lambda to a named function" from breaking
  // the call that worked. Keyed on the expected type's return being void, and granted only for the
  // set `synthVoidTwins` can mint a capture-free void twin for; other values keep the mismatch.
  if fnValVoidCoerce(srcExpr, srcTy, dstTy) { return true }
  // A `u8` storage slot — an array element, the only position `u8` is legal in — accepts any `i32`
  // value: the storage is one byte, `array.set` truncating to the low 8 bits and `array.get_u`
  // widening back into 0..255. The one error is an out-of-range non-negative integer literal. This
  // lives at the expression seam, `assignable(i32, u8)` staying false so an `i32[]` cannot flow in.
  if primNameOf(dstTy) == "u8" {
    if srcExpr >= 0 {
      const u8e = P.nodes[srcExpr]
      if u8e is Paren { return assignableExpr(u8e.parInner, srcTy, dstTy) }
      if u8e is NumLit {
        if numLexIsFloat(u8e.numText) { return false }
        if u8LexValue(u8e.numText) > 255 {
          if !inferQuiet {
            tErr(
              "the literal "
                + u8e.numText
                + " does not fit a `u8` element (0..255) — a computed value truncates to its low 8 bits, but a literal this size is a mistake the compiler can see",
              srcExpr,
            )
          }
          // Reported here and answered true, the same discipline `objShapeAdapterlessErr` follows:
          // the position is otherwise well-typed, so a second "cannot assign" from the caller
          // would contradict this message.
          return true
        }
        return true
      }
    }
    const u8s = primNameOf(srcTy)
    return u8s == "i32" || u8s == "u8"
  }
  // A literal re-encodes exactly at f32, so it flows into any destination whose f32 position it
  // fits: a bare `f32`, a nullable `f32?`, or an f32 member of a union. An arbitrary f64 or i32
  // value is not covered. Destination first, and that order is load-bearing for compile time: the
  // integer half folds the lexeme into a bignum, while `dstAdmitsF32` is a short arena walk.
  if dstAdmitsF32(dstTy) {
    if isF32AdoptingLitExpr(srcExpr) {
      cexFloatUse(srcExpr)
      return true
    }
    if f32LitTailsAdopt(srcExpr, dstTy) { return true }
  }
  // The same grant one width up, and only its integer half: an i32-typed literal already rides
  // the `i32 -> f64` lattice edge, so what this admits is the literals between 2^31 and 2^53 that
  // type `i64` and would otherwise meet the lossy `i64 -> f64` refusal. D1890.
  if dstAdmitsF64(dstTy) {
    if isExactF64IntLitExpr(srcExpr) {
      cexFloatUse(srcExpr)
      return true
    }
  }
  // A `const` literal, or a join of them, read as `string`: a literal-typed destination takes it at
  // the literal type it is, in a list or object literal exactly as at an argument (D2157).
  if srcExpr >= 0 && srcExpr < wideLitByNode.length {
    const uw = wideLitByNode[srcExpr]
    if uw >= 0 && uw != srcTy {
      if assignable(uw, dstTy) { return true }
    }
  }
  // A literal-typed destination: a bare literal flows wherever its literal type is a member (`"a"`
  // into `"a" | "b"`), even though its softened base (`string`) does not.
  if srcExpr >= 0 {
    const lTy = litTyOfExpr(srcExpr)
    if lTy >= 0 {
      if assignable(lTy, dstTy) { return true }
    }
    // An object literal checks field-wise against a literal-bearing object target, so a field's
    // bare literal can match a literal-union field (`{tag: "circle", r: 5}` against
    // `{tag: "circle" | "square", r: i32}`).
    const e = P.nodes[srcExpr]
    if e is Paren {
      const pok = assignableExpr(e.parInner, srcTy, dstTy)
      // A wrapping paren takes the f32 list its literal adopted, so both nodes read alike.
      if pok && !inferQuiet && f32ListUnder(srcExpr, e.parInner) {
        nodeTySet(srcExpr, nodeTyIxOf(e.parInner))
      }
      return pok
    }
    if e is ObjLit {
      const s = T.tys[srcTy]
      if s is TyObj {
        // A nullable struct target (`S | null`, or a `V?` map value) peels its wrapper so an object
        // literal still adapts field-wise into the inner struct — the ObjLit dual of the ArrayLit
        // peel below. The peel iterates: a nullable-value map slot stacks two wrappers, and a
        // single unwrap leaves the literal against `S | null`.
        let dtix = dstTy
        let dPeel = true
        while dPeel {
          const dNW = T.tys[dtix]
          if dNW is TyNullable { dtix = dNW.nInner } else { dPeel = false }
        }
        const d = T.tys[dtix]
        if d is TyObj {
          const dnames = d.objFieldNames
          const dtys = d.objFieldTypes
          let i = 0
          let ok = true
          while i < dnames.length {
            const sft = objFieldType(s, dnames[i])
            if sft < 0 {
              // Completion coercion: an object literal may omit a field whose declared type admits
              // null — the field is materialized as `null` at construction. A non-nullable omitted
              // field is still required. Scoped to this expression-aware path, not to general
              // structural assignability, so it never widens through a container or variance.
              if !tyAdmitsNull(dtys[i]) { ok = false }
            } else {
              // The field's value expression, for the literal-aware recursion.
              let fexpr = -1
              const fl = e.objFields
              let fi = 0
              while fi < fl.length {
                const fn = P.nodes[fl[fi]]
                if fn is FieldInit {
                  if fn.fiName == dnames[i] { fexpr = fn.fiValue }
                }
                fi = fi + 1
              }
              if !assignableExpr(fexpr, sft, dtys[i]) { ok = false }
            }
            i = i + 1
          }
          // Rep sidecar: a field-wise-adopted ObjLit builds the destination struct rep (a boxed
          // union field, an i64/f32 field, an omitted nullable field), so record it on the literal
          // node and the emitter's row resolver keys the shape it builds, not the self-inference.
          if ok { recordRepTyAdopt(srcExpr, dstTy, 6) }
          // A field the record does not declare is refused where the literal is written, as at
          // a destination `assignable` accepts by width (#1460). Reported and answered true.
          if (
            ok
            && bareBraceSpec == 0
            && !inferQuiet
            && srcExpr != argLitAt
            && objLitSetsUndeclared(e, dtix)
          ) {
            if !objLitHasDupKey(srcExpr) {
              objLitUndeclaredErr(srcExpr, srcTy, dtix, "")
            }
          }
          return ok
        }
        // A struct literal flowing into a union adopts the first struct arm it adapts into
        // field-wise (`{f: 97.5}` into `{f: f32} | {w: i32}`). The emitter already boxes a struct
        // literal into a union slot at a direct binding; this is the checker seam that lets a
        // widening field reach that same rep. The concrete arm is recorded on the literal node.
        if d is TyUnion {
          // Flattened, because a union member may itself be a union: `type Shape = Circle | Rect`
          // used as an arm of `Shape | ParseError` leaves a `TyUnion` in `uMembers`, which the
          // `mt is TyObj` test skips. Each candidate is still gated by `unionArmBoxSafe` and still
          // recorded as the concrete arm; canon's union-alias flatten covers both spellings.
          const members: i32[] = []
          flattenVariantsInto(dstTy, members)
          // An arm declaring every field the literal sets is preferred; an arm that would drop
          // one is taken only when no other accepts, and then refused as at a record (#1460).
          let mi = 0
          let pass = 0
          while pass < 2 {
            mi = 0
            while mi < members.length {
              const mt = T.tys[members[mi]]
              if (
                mt is TyObj
                && unionArmBoxSafe(members[mi])
                && objLitSetsUndeclared(e, members[mi]) == (pass == 1)
              ) {
                bareBraceSpecSet(bareBraceSpec + 1)
                const armOk = assignableExpr(srcExpr, srcTy, members[mi])
                bareBraceSpecSet(bareBraceSpec - 1)
                if armOk && pass == 1 {
                  if (
                    !inferQuiet
                    && bareBraceSpec == 0
                    && !objLitHasDupKey(srcExpr)
                  ) {
                    objLitUndeclaredErr(
                      srcExpr,
                      srcTy,
                      members[mi],
                      " (reached through "
                        + tyToStr(srcTy)
                        + " into "
                        + tyToStr(dstTy)
                        + ")",
                    )
                  }
                  return true
                }
                if armOk {
                  if !inferQuiet {
                    while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
                    nodeTySet(srcExpr, members[mi])
                    // Rep sidecar: the struct literal builds the concrete arm struct's rep — record
                    // it, recursing into fields, for the row resolver.
                    recordRepTyAdopt(srcExpr, members[mi], 6)
                  }
                  return true
                }
              }
              mi = mi + 1
            }
            pass = pass + 1
          }
        }
      }
    }
    // An array literal checks element-wise against the target's element type, so a bare element
    // adapts exactly as it would at a binding — the array analogue of the ObjLit recursion above.
    // This subsumes the scalar float-literal into `f32[]` rule at any element type and nesting
    // depth. An empty `[]` fits any element; a non-literal element still rejects a lossy demote.
    if e is ArrayLit {
      // A map value or niche slot is `V?` (`{[string]: f32[]}` seeds `f32[]?`) — peel the nullable
      // wrappers so a literal array still adapts into the inner element type; a nullable-value map
      // slot stacks two, so the peel iterates like the ObjLit one above.
      let dtix = dstTy
      let dPeel = true
      while dPeel {
        const dNW = T.tys[dtix]
        if dNW is TyNullable { dtix = dNW.nInner } else { dPeel = false }
      }
      const d = T.tys[dtix]
      if d is TyArray {
        let i = 0
        let ok = true
        const cexWas = cexConverted
        cexConverted = false
        while i < e.arrElems.length {
          const sp = P.nodes[e.arrElems[i]]
          if sp is Spread {
            // A spread hands over its list's elements, each delivered as one element (D3253).
            let spe = tyArrayElemIx(nodeTyIxOf(sp.spdArg))
            if spe >= 0 && tyHasHole(spe) && litPinN.length > 0 {
              spe = substTyDeep(spe, litPinN, litPinT)
            }
            if spe >= 0 && !assignable(spe, d.aElem) { ok = false }
          } else if (
            !assignableExpr(
              e.arrElems[i],
              litElemSrcTy(e.arrElems[i], srcTy),
              d.aElem,
            )
          ) {
            ok = false
          }
          i = i + 1
        }
        // A whole float constant an element became is an integer, so the list is built at the
        // destination's element type.
        const cexElem = cexConverted
        cexConverted = cexWas || cexElem
        // Context adoption (atom lists): a literal array accepted by a literal-union element target
        // is that atom list (`const ks: VK[] = ["aa", "bb"]`), so the destination array type is
        // recorded on the literal node and the emitter classifies it as the i32 atom-id list. The
        // niche-nullable scalar elements record the same way — `[null]` carries no other signal.
        if (
          ok
          && !inferQuiet
          && (tyIsLitUnion(d.aElem)
            || tyIsNicheNulScalarElem(d.aElem)
            || arrLitJoinUnionElem(srcExpr, dtix)
            || cexElem
            || f32ElemsAdoptedOver(srcExpr, d.aElem))
        ) {
          if srcExpr < nodeTyIx.length { nodeTySet(srcExpr, dtix) }
        }
        // Rep sidecar: a literal array adopted element-wise (a struct-element list widened, an
        // i64/f32 element) builds the destination element rep — recurse into the elements so each
        // element ObjLit resolves the shape the emitter builds.
        if ok { recordRepTyAdopt(srcExpr, dstTy, 6) }
        return ok
      }
      // An array literal flowing into a union adopts the first array arm it adapts into
      // element-wise (`["a"]` into `K0[] | {w: i32}`, `[1.5]` into `f32[] | i64`) — the array dual
      // of the ObjLit union-arm adoption above. The concrete arm is recorded on the literal node so
      // the emitter classifies the list with the arm's element rep, not the literal's softened one.
      if d is TyUnion {
        const members = d.uMembers
        let mi = 0
        while mi < members.length {
          const mt = T.tys[members[mi]]
          if mt is TyArray {
            // An `f32[]` arm adopts like any other list arm: the f32-list value atom
            // (kind 12) gives the box a real rep, and the emitter's coerce re-encodes
            // the literal's f64-classified elements at f32 (`coerceListKind` 7).
            bareBraceSpecSet(bareBraceSpec + 1)
            const armOk = assignableExpr(srcExpr, srcTy, members[mi])
            bareBraceSpecSet(bareBraceSpec - 1)
            if armOk {
              if !inferQuiet {
                while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
                nodeTySet(srcExpr, members[mi])
                // Rep sidecar: record the concrete array arm, recursing into elements, so the row
                // resolver keys the arm the checker picked.
                recordRepTyAdopt(srcExpr, members[mi], 6)
              }
              return true
            }
          }
          mi = mi + 1
        }
      }
    }
  }
  false
}

// ── the top-level split lives in `tyname.tyTopLevelSplit` ───────────────────
// It cannot live in `emit_base.vl`, which imports this file — a call from here would cycle the
// module graph. `tyname.vl` is the zero-import leaf that already holds `tyTopIndexOf`.

// The expression-aware retry for a slot checked with the bare structural `assignable` — the
// map `.set` key. `assignableExpr` covers both scalar-literal brand adoption and object-literal
// field-wise adaptation, which `nomLitAdopts` alone cannot supply. Gated on the destination
// actually carrying a brand, so a brand-free program keeps its bare structural check unchanged.
function nomSlotAccepts(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if nwTyIxs.length == 0 { return false }
  if srcExpr < 0 { return false }
  if !tyReachesBrand(dstTy, 6) { return false }
  assignableExpr(srcExpr, srcTy, dstTy)
}

// —— the mixed-union literal-run regroup, canon's side ——
// `tyToNameGo`'s union arm regroups the flattened string-literal members of a mixed
// union back into their registered alias (`K0 | f64` renders `K0|f64`); canon must spell the
// same union the same way, so this classifies member spellings by the same three-way rule the renderer applies to arena members.

// —— the subsumed-arm collapse, canon's side ——
// The arena drops a union arm that adds no values; canon must drop the same arm or the two
// producers agree about the type and disagree about the rep — the arena saying `string`
// while canon spells `Kind|string` reserves a union box for a plain-string binding (D1048).

// The predicate that arm asks, in one home with a sharper consequence: the pin has to ask
// exactly what the body asked or it disagrees with the direct spelling in one of two ways.
// Asking the plain predicate where the arm asks the expression invents a false reject — the
// float-literal-into-f32 rule lives at the expression seam (D551).
function bmArgPred(form: i32, got: i32, want: i32, argIx: i32) {
  if form == BM_PUSH || form == BM_SETVAL || form == BM_KEYMUST {
    return assignableExpr(argIx, got, want)
  }
  if form == BM_SETKEY || form == BM_ADDKEY {
    // The expression form first: a MEMBER literal is a legal key of a literal-union-keyed
    // map or set, and its own type is the member, not the `string` `checkNode` hands back (D1748).
    if assignableExpr(argIx, got, want) { return true }
    return nomSlotAccepts(argIx, got, want)
  }
  assignable(got, want)
}

// The one gate every builtin argument arm asks. True when the position is accepted or
// deferred; false when it is a reject the arm reports with `bmArgMsg`. Deferring returns
// true since a body that already reported its own mismatch has a loud diagnostic, and a
// second one at every call site would repeat it in vaguer words.
function bmArgOk(
  form: i32,
  label: string,
  got: i32,
  want: i32,
  ctx: i32,
  argIx: i32,
) {
  if tyHasHole(got) || tyHasHole(want) {
    // A generic function stored as the value is instantiated there (D3112).
    if fvaAdapt(argIx, got, want) { return true }
    noteBmCstr(form, label, got, want, ctx, argIx)
    return true
  }
  bmArgPred(form, got, want, argIx)
}

// `argCstrFits` for demand `ci` at a pin that knows its argument nodes: a hole callee's scalar
// argument whose origin node is known is asked the direct call's own question of that node, so
// a literal adopts the parameter's width and a `boolean` literal is refused as it is directly.
function argCstrFitsAt(
  rat: i32,
  rexp: i32,
  ci: i32,
  hNames: string[],
  hArgNode: i32[],
) {
  const form = argCstr.form[ci]
  if form <= 0 { return argCstrFits(rat, rexp, form) }
  const org = holeArgOriginNode(ci, hNames, hArgNode)
  if org < 0 || !scalarPrimPair(rat, rexp) {
    return argCstrFits(rat, rexp, form)
  }
  const savedQuiet = inferQuiet
  if prbArmed { prbEnter() }
  inferQuiet = true
  const ok = assignableExpr(org, rat, rexp)
  inferQuiet = savedQuiet
  if prbArmed { prbLeave("argCstrFitsAt") }
  ok
}

// Solves every un-annotated parameter of top-level function `fnIx` from its body's usage:
// probes the body once (diagnostics and symbols suppressed) and records the first concrete
// destination per parameter. Top-level only, from pass 1.8 — a statement carries no
// contextual callback type, so the probe's answer is independent of source order.
function solveUnannotParams(fnIx: i32) {
  if paramSolveProbe { return 0 }
  const key = i32ToStr(fnIx)
  if paramSolveTried[key] ?? false { return 0 }
  const fd = P.nodes[fnIx]
  if fd is FuncDecl {
    const ps = fd.fnParams
    let anyHole = false
    let pi = 0
    while pi < ps.length {
      const pn = P.nodes[ps[pi]]
      if pn is Param {
        if pn.parType < 0 {
          if (solvedParamTys[paramHoleName(fd.fnName, fnIx, pi)] ?? -1) < 0 {
            anyHole = true
          }
        }
      }
      pi = pi + 1
    }
    if !anyHole { return 0 }
    paramSolveTried[key] = true
    if prbArmed { prbEnter() }
    // Rolls back every table the probe's body records except what it reads first (holeFlow);
    // the real pass re-records the rest. A kept `dJoin` row, keyed by call node, would block
    // the real pass from re-parking its reject.
    const m = checkMark()
    const savedSym = symEnabled
    const savedQuiet = inferQuiet
    symEnabled = 0
    inferQuiet = true
    paramSolveProbeSet(true)
    expObsBegin(fd, fnIx)
    checkFuncDeclNode(fd, fnIx)
    expObsFnSet(-1)
    paramSolveProbeSet(false)
    inferQuiet = savedQuiet
    symEnabled = savedSym
    let fi = m.holeFlow
    while fi < holeFlowSrc.length {
      const st = T.tys[holeFlowSrc[fi]]
      if st is TyVar {
        if (solvedParamTys[st.tvName] ?? -1) < 0 {
          if holeNameIsParamOf(st.tvName, fd.fnName, fnIx, ps.length) {
            solvedParamTysSetAt(st.tvName, holeFlowDst[fi])
          }
        }
      }
      fi = fi + 1
    }
    checkRollback(m, RB_SOLVE)
    if prbArmed { prbLeave("solveUnannotParams") }
    // Patches the hoisted `TyFunc` in place, gated on this node being the registered
    // top-level declaration — a nested namesake is not hoisted and would corrupt it.
    if fd.fnName != "" && (fnDeclIx[fd.fnName] ?? -1) == fnIx {
      const bound = lookup(fd.fnName)
      if bound >= 0 {
        const bt = T.tys[bound]
        if bt is TyFunc {
          const bpt = bt.fnParamTypes
          let k = 0
          while k < ps.length {
            if k < bpt.length {
              const sv = solvedParamTys[paramHoleName(fd.fnName, fnIx, k)] ?? -1
              if sv >= 0 {
                bpt[k] = sv
                tyMutEpoch = tyMutEpoch + 1 // solved parameter patched in place
              }
            }
            k = k + 1
          }
        }
      }
    }
  }
  0
}

// A composite argument demand at the pin that closes it: its node is asked the direct call's
// question under the pin's bindings. One still open is left, not moved out to every caller,
// so a generic chain pays for it once per pin rather than once per hop.
function validateCompArgCstr(
  ci: i32,
  rat: i32,
  rexp: i32,
  bNames: string[],
  bTys: i32[],
  ix: i32,
) {
  if tyHasHole(rexp) || tyHasHole(rat) { return 0 }
  const savedQuiet = inferQuiet
  if prbArmed { prbEnter() }
  inferQuiet = true
  const ok = litPinAssignable(argCstr.node[ci], rat, rexp, bNames, bTys)
  inferQuiet = savedQuiet
  if prbArmed { prbLeave("validateCompArgCstr") }
  if ok { return 0 }
  argFlowErr(rat, rexp, ci, ix)
}

// Re-validates every deferred call-argument constraint this call's callee owns
// (`cstrOwnedBy`), substituting the hole to the call's argument type. A hole that substitutes
// to another hole is re-recorded under it for the outer call that pins it, and only where the
// callee is named, as `validateBinCstrs` does.
function validateArgCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  hNames: string[],
  hArgNode: i32[],
) {
  const nOrig = argCstr.at.length
  const cvWas = cvNow
  let ci = 0
  while ci < nOrig {
    if !cstrOwnedBy(argCstr.fn[ci], calleeFn) {
      ci = ci + 1
      continue
    }
    cvNow = cvPick(CV_ARG, ci, cvWas)
    const rat = substTyDeep(argCstr.at[ci], bNames, bTys)
    const rexp = substTyDeep(argCstr.exp[ci], bNames, bTys)
    if argCstr.form[ci] == ACF_COMP {
      validateCompArgCstr(ci, rat, rexp, bNames, bTys, ix)
      ci = ci + 1
      continue
    }
    if rat != argCstr.at[ci] && calleeFn >= 0 {
      if tyIsHole(rat) || tyIsDeferredJoin(rat) {
        if !tyIsHole(rexp) {
          noteArgCstr(rat, rexp, argCstr.who[ci], argCstr.form[ci], -1)
        }
      }
    }
    // A hole callee's parameter still unpinned here moves out to the caller's hole with its
    // argument, whichever side this call resolved.
    if calleeFn >= 0 && argCstr.form[ci] > 0 && hdKindIs(rexp, HD_PARAM) {
      if rat != argCstr.at[ci] || rexp != argCstr.exp[ci] {
        let mvNode = -1
        if !tyIsHole(rat) { mvNode = holeArgOriginNode(ci, hNames, hArgNode) }
        noteArgCstr(rat, rexp, argCstr.who[ci], argCstr.form[ci], mvNode)
      }
    }
    // A side still carrying a hole — bare, or as a deferred-join arm — is undecided at this
    // site and defers to the call that pins it.
    if !tyIsHole(rat) && !tyIsDeferredJoin(rat) {
      if !tyIsHole(rexp) && !tyIsDeferredJoin(rexp) {
        if !argCstrFitsAt(rat, rexp, ci, hNames, hArgNode) {
          argCstrErr(rat, rexp, ci, ix)
        }
      }
    }
    ci = ci + 1
  }
  cvNow = cvWas
  0
}

// Whether a return-type mismatch is nominal-only, at a destination the author has no syntax
// to spell: the hole sits on the declared side alone (`wOnly`), the destination is a newtype
// brand, and the body type already fits the brand's unbranded base — the repair would be `x
// as A`, which the language has no form for (`wOnly` is what keeps a body-side hole under a concrete declaration a loud reject, D551).
function retNomOnlyAtHole(wOnly: i32, ix: i32, rg: i32, rw: i32) {
  if wOnly != 1 { return false }
  if !tyIsNewtypeBrand(rw) { return false }
  const b = nomBaseTyIx(rw)
  if b < 0 { return false }
  if b == rw { return false }
  assignableExpr(ix, rg, b)
}

// `assignableExpr` with the pin's bindings staged for a literal's elements (`litElemSrcTy`).
function litPinAssignable(
  ix: i32,
  src: i32,
  dst: i32,
  bNames: string[],
  bTys: i32[],
): boolean {
  const sN = litPinN
  const sT = litPinT
  litPinNSet(bNames)
  litPinTSet(bTys)
  const ok = assignableExpr(ix, src, dst) || joinLitsFitAt(ix, dst)
  litPinNSet(sN)
  litPinTSet(sT)
  ok
}

// Re-validates every deferred return-type constraint this call resolves: substitutes the
// call's bindings into the body's returned type and the declared return type, and asks the
// mismatch question the body could only answer vacuously. Re-defers like `validateArgCstrs`
// when a hole substitutes to another hole; the message is the direct spelling's, verbatim.
function validateRetCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
) {
  const nOrigR = retCstr.got.length
  const cvWas = cvNow
  let ci = 0
  while ci < nOrigR {
    if (
      cstrOwnedBy(retCstr.fn[ci], calleeFn)
      && !nestCstrOutside(retCstr.ix[ci])
    ) {
      cvNow = cvPick(CV_RET, ci, cvWas)
      const rg = substTyDeep(retCstr.got[ci], bNames, bTys)
      const rw = substTyDeep(retCstr.want[ci], bNames, bTys)
      // Re-records only when the callee is named — an unnamed call cannot reassign ownership
      // — and gates on either side still holding a hole, not just the body side.
      if (
        calleeFn >= 0
        || substNestMode == SUBST_NESTED
        || substNestMode == SUBST_HOLES
      ) {
        if rg != retCstr.got[ci] || rw != retCstr.want[ci] {
          if tyHasHole(rg) || tyHasHole(rw) {
            noteRetCstr(rg, rw, retCstr.ix[ci])
          }
        }
      }
      if !tyHasHole(rg) {
        if (
          !tyHasHole(rw)
          && !retNomOnlyAtHole(retCstr.wOnly[ci], retCstr.ix[ci], rg, rw)
        ) {
          if !litPinAssignable(retCstr.ix[ci], rg, rw, bNames, bTys) {
            let rWho = "the callee's return"
            if who != "" { rWho = "the return of `" + who + "`" }
            tErr(
              "return type mismatch: expected "
                + tyToStr(rw)
                + ", got "
                + tyToStr(rg)
                + boolForNumberNote(rg, rw)
                + " ("
                + rWho
                + " at the call's argument types)",
              ix,
            )
          }
        }
      }
    }
    ci = ci + 1
  }
  cvNow = cvWas
  0
}

// Whether the deferred destination constraints this binding resolves hold — the twin of
// `validateRetCstrs` for a `let`/`const` binding rather than a return (D572 is why the two
// need separate tables). Same re-deferral rule; the message is `letAssignMsg`'s, verbatim,
// with the attribution appended since the reader wrote no assignment.
function validateLetCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
) {
  const nOrigL = letCstr.got.length
  const cvWas = cvNow
  let ci = 0
  while ci < nOrigL {
    if (
      cstrOwnedBy(letCstr.fn[ci], calleeFn)
      && !nestCstrOutside(letCstr.ix[ci])
      && !wrUnreachedBy(ci, ix, calleeFn)
    ) {
      cvNow = cvPick(CV_LET, ci, cvWas)
      const lg = substTyDeep(letCstr.got[ci], bNames, bTys)
      const lw = substTyDeep(letCstr.want[ci], bNames, bTys)
      // Re-records only when the callee is named, for the same ownership reason
      // `validateRetCstrs` gates on; also gated on either side holding a hole.
      if (
        calleeFn >= 0
        || substNestMode == SUBST_NESTED
        || substNestMode == SUBST_HOLES
      ) {
        if lg != letCstr.got[ci] || lw != letCstr.want[ci] {
          if tyHasHole(lg) || tyHasHole(lw) {
            noteLetCstr(lg, lw, letCstr.ix[ci], letCstr.name[ci])
          }
        }
      }
      if !tyHasHole(lg) {
        if !tyHasHole(lw) {
          if !litPinAssignable(letCstr.ix[ci], lg, lw, bNames, bTys) {
            let lWho = "the callee's body"
            if who != "" { lWho = "the body of `" + who + "`" }
            tErr(
              letAssignMsg(letCstr.ix[ci], lg, lw, letCstr.name[ci], -1)
                + " ("
                + lWho
                + " at the call's argument types)",
              ix,
            )
          }
        }
      }
    }
    ci = ci + 1
  }
  cvNow = cvWas
  0
}

// Whether the deferred builtin-method-argument constraints this binding resolves hold — the
// twin of `validateLetCstrs` for a `.push`/`.set`/`.add` argument rather than an assignment
// (D582 is why `argCstr*` cannot serve this position). Same re-deferral rule, gated on either
// side; the message is the arm's own (`bmArgMsg`), verbatim, with the attribution appended.
function validateBmCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
) {
  const nOrigB = bmCstr.got.length
  const cvWas = cvNow
  let ci = 0
  while ci < nOrigB {
    if cstrOwnedBy(bmCstr.fn[ci], calleeFn) && !nestCstrOutside(bmCstr.ix[ci]) {
      cvNow = cvPick(CV_BM, ci, cvWas)
      const bg = substTyDeep(bmCstr.got[ci], bNames, bTys)
      const bw = substTyDeep(bmCstr.want[ci], bNames, bTys)
      let bc = bmCstr.ctx[ci]
      if bc >= 0 { bc = substTyDeep(bc, bNames, bTys) }
      // Re-records only when the callee is named — an unnamed call cannot reassign
      // ownership of the constraint.
      if (
        calleeFn >= 0
        || substNestMode == SUBST_NESTED
        || substNestMode == SUBST_HOLES
      ) {
        if bg != bmCstr.got[ci] || bw != bmCstr.want[ci] {
          if tyHasHole(bg) || tyHasHole(bw) {
            noteBmCstr(
              bmCstr.form[ci],
              bmCstr.label[ci],
              bg,
              bw,
              bc,
              bmCstr.ix[ci],
            )
          }
        }
      }
      if !tyHasHole(bg) {
        if !tyHasHole(bw) {
          if !bmArgPred(bmCstr.form[ci], bg, bw, bmCstr.ix[ci]) {
            let bWho = "the callee's body"
            if who != "" { bWho = "the body of `" + who + "`" }
            tErr(
              bmArgMsg(bmCstr.form[ci], bmCstr.label[ci], bg, bw, bc)
                + " ("
                + bWho
                + " at the call's argument types)",
              ix,
            )
          }
        }
      }
    }
    ci = ci + 1
  }
  cvNow = cvWas
  0
}

// Operator dispatch `a op b` over a struct left operand through the free `self`-function
// named for the operator: the function must exist, take exactly `(self, right)`, with its
// first parameter named `self`. Binds the operands into the function's holes like any call
// and substitutes the return; -1 means no such function fits, and the caller falls through to the operator-field lookup or the native numeric paths.
function opSelfFnTy(op: string, lt: i32, rt: i32, rightIx: i32, ix: i32) {
  // Receiver-directed: the declaration whose `self` accepts the LEFT operand's type, from the
  // operator registry keyed on `(symbol, receiver)` (B14 generalized from `[]`/`[]=`). Several
  // receiver types may each declare `op`; the left operand picks which. One declaration
  // resolves to the same target a bare `lookup(op)` would, so single-receiver bytes are unchanged.
  const opKey = opSelfFnKeyFor(op, lt)
  if opKey == "" { return -1 }
  const fnTy = lookup(opKey)
  if fnTy < 0 { return -1 }
  // Bank the receiver-keyed name for the emitter, so `a + b` lowers to the exact declaration
  // resolved here rather than a bare-name re-scan that a merge could rewrite differently.
  opBinBank(ix, opKey)
  const preFt = T.tys[fnTy]
  if preFt is TyFunc {
    if preFt.fnRet == -2 {
      if !onInferStack(opKey) {
        const dIx = fnDeclIx[opKey] ?? -1
        if dIx >= 0 { checkNode(dIx) }
      }
    }
  } else {
    return -1
  }
  const dIx2 = fnDeclIx[opKey] ?? -1
  if dIx2 < 0 { return -1 }
  const d = P.nodes[dIx2]
  let selfOk = false
  if d is FuncDecl {
    if d.fnParams.length == 2 {
      const p0 = P.nodes[d.fnParams[0]]
      if p0 is Param {
        if p0.parName == "self" { selfOk = true }
      }
    }
  }
  if !selfOk { return -1 }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    let retTy = ft.fnRet
    if retTy == -2 { retTy = TY_ERR }
    const params = ft.fnParamTypes
    if params.length != 2 { return -1 }
    if !assignable(lt, params[0]) { return -1 }
    const bNames: string[] = []
    const bTys: i32[] = []
    const p0t = T.tys[params[0]]
    if p0t is TyVar {
      if !holeDemandOk(p0t.tvName, -1, lt) { return -1 }
    }
    bindGenWalk(params[0], lt, bNames, bTys)
    bindGenWalk(params[1], rt, bNames, bTys)
    const expected = substTyDeep(params[1], bNames, bTys)
    const p1t = T.tys[params[1]]
    if p1t is TyVar {
      if !holeDemandOk(p1t.tvName, rightIx, rt) {
        tErr(
          "operator '"
            + op
            + "': expected "
            + holeDemandStr(p1t.tvName)
            + ", got "
            + tyToStr(rt),
          ix,
        )
      }
    }
    if !assignableExpr(rightIx, rt, expected) {
      tErr(
        "operator '"
          + op
          + "': expected "
          + tyToStr(expected)
          + ", got "
          + tyToStr(rt),
        ix,
      )
    }
    if bNames.length > 0 { retTy = substTyDeep(retTy, bNames, bTys) }
    return retTy
  }
  -1
}

// The ELEMENT type a spread contributes: `...ys` over `ys: T[]` gives `T`. A `readonly` view
// spreads too — the destination list is fresh, so nothing the view forbids is laundered.
// Returns -1 for an empty-list source (element not yet known) and TY_ERR after refusing one
// that is not a list at all.
function spreadElemTy(spdIx: i32) {
  const inner = spreadArgOf(spdIx)
  if inner < 0 { return TY_ERR }
  const st = checkNode(inner)
  if st < 0 { return TY_ERR }
  const t = T.tys[st]
  if t is TyArray { return t.aElem }
  let note = ""
  if st == TY_STR { note = " — a string is not a list of characters in VL" }
  tErr("`...` spreads a list, and this is " + tyToStr(st) + note, inner)
  TY_ERR
}

// True, having reported, when a rest parameter's element is an unbound HOLE and the packed
// list's element joined to a union that BOXES. `T` would pin to that union and the instance
// the monomorphizer mints for it misbuilds — check-clean invalid wasm, the worst outcome
// there is — so it is refused at the pin, naming the concrete spelling that runs (D1851).
function restHoleUnionErr(pTy: i32, packIx: i32, ix: i32): boolean {
  const pe = tyArrayElemIx(pTy)
  if pe < 0 || pe >= T.tys.length { return false }
  const pt = T.tys[pe]
  if pt is TyVar {
    const at = tyArrayElemIx(checkNode(packIx))
    if at < 0 || at >= T.tys.length { return false }
    const a = T.tys[at]
    if a is TyUnion {
      if unionRidesI32Spine(at) { return false }
      tErr(
        "a rest parameter's element is inferred from the arguments, and these join to "
          + tyToStr(at)
          + " — a boxed union a type parameter cannot be pinned to. Spell the element out, "
          + "`...xs: ("
          + tyToStr(at)
          + ")[]`, or pass one element type",
        ix,
      )
      return true
    }
  }
  false
}

// Declaration-side validation of parameter defaults (`paramTys` aligns 1:1 with `params`).
// Defaults are direct-call-site sugar — substituted into an omitting call before emit, so the
// ABI stays untouched — enforced as four rules: trailing-only (a defaulted parameter may not
// precede one without), annotated (disjoint from inference holes), non-generic, and literal.
function checkParamDefaults(n: FuncDecl, params: i32[], paramTys: i32[]) {
  let sawDefault = false
  let pi = 0
  while pi < params.length {
    const p = P.nodes[params[pi]]
    if p is Param {
      const dIx = p.parDefault
      if dIx < 0 {
        if sawDefault {
          tErr(
            "parameter `"
              + p.parName
              + "` has no default but follows one that does — defaults must be the LAST parameters",
            params[pi],
          )
        }
      } else {
        sawDefault = true
        if p.parType < 0 {
          tErr(
            "a default value needs a type annotation — write `"
              + p.parName
              + ": T = …`",
            params[pi],
          )
        } else if tsMentionsAnyName(annTsOf(p.parType), n.fnTyParams) {
          tErr(
            "parameter `"
              + p.parName
              + "` cannot have a default: its type names a type parameter of `"
              + n.fnName
              + "`, which an omitted argument would leave unbound",
            params[pi],
          )
        }
        let pt = TY_ERR
        if pi < paramTys.length { pt = paramTys[pi] }
        if paramDefaultIsCallsite(dIx) {
          // `__callsite__` is never checked as an expression — what is checked is the
          // destination, so the error surfaces here rather than at somebody else's call site.
          identSet(dIx, IDENT_BUILTIN)
          if pt >= 0 && !tyIsCallerLoc(pt) {
            tErr(
              "parameter `"
                + p.parName
                + "` is `__callsite__`, so its type must be `{ file: string, line: i32, col: i32 }` — got "
                + tyToStr(pt),
              dIx,
            )
          }
        } else if !paramDefaultIsLiteral(dIx) {
          tErr(
            "a default value must be a literal, a module-level `const`, or `__callsite__` — `"
              + p.parName
              + "`'s default is substituted at each call site, so it cannot name a parameter, a local, or a call",
            dIx,
          )
        } else {
          seedExpected(dIx, pt)
          const dt = checkNode(dIx)
          // Delivered like an argument, so a literal takes the parameter's type (`x: f32 = 0.1`).
          if pt >= 0 && !assignableExpr(dIx, dt, pt) {
            tErr(
              "parameter `"
                + p.parName
                + "` default: expected "
                + tyToStr(pt)
                + ", got "
                + tyToStr(dt),
              dIx,
            )
          }
        }
      }
    }
    pi = pi + 1
  }
  0
}

// —— the witness: satisfaction is the existing call resolution ————————————————
// `x.m(a)` under a bound resolves by the same order every method call uses — a field of the
// receiver first, then a free `self`-function in scope. Returns a stable string naming which
// won (`"field"`, the mangled `self`-function name, or `""`) — the coherence key's value and the words the disagreement diagnostic prints (resolved in the instantiation site's own module scope, D1191).
function witnessOf(memberName: string, wantTy: i32, concTy: i32, ix: i32) {
  if concTy < 0 || wantTy < 0 { return "" }
  const ct = T.tys[concTy]
  if ct is TyObj {
    const ft = objFieldType(ct, memberName)
    if ft >= 0 {
      if assignable(ft, wantTy) { return "field" }
      return ""
    }
  }
  const mangled = ufcsAliasInScope(ix, memberName)
  const fnTy = lookup(mangled)
  if fnTy < 0 { return "" }
  const ft2 = T.tys[fnTy]
  if ft2 is TyFunc {
    const wt = T.tys[wantTy]
    if wt is TyFunc {
      // The receiver occupies slot 0 and the bound's arguments fill the rest —
      // the arity `ufcsCallTy` enforces, asked here of a type rather than of a
      // node so it can be asked before any call exists.
      if ft2.fnParamTypes.length != wt.fnParamTypes.length + 1 { return "" }
      if !assignable(concTy, ft2.fnParamTypes[0]) { return "" }
      let i = 0
      while i < wt.fnParamTypes.length {
        if !assignable(wt.fnParamTypes[i], ft2.fnParamTypes[i + 1]) {
          return ""
        }
        i = i + 1
      }
      // A callee whose return is still pending (-2) has not been inferred yet; force it,
      // exactly as `ufcsCallTy` does, so an un-annotated std export's real type is known here rather than guessed.
      let retTy = ft2.fnRet
      if retTy == (-2) {
        if !onInferStack(mangled) {
          const dIx = fnDeclIx[mangled] ?? -1
          if dIx >= 0 {
            checkNode(dIx)
            const re = T.tys[lookup(mangled)]
            if re is TyFunc { retTy = re.fnRet }
          }
        }
      }
      if !assignable(retTy, wt.fnRet) { return "" }
      return mangled
    }
  }
  ""
}

// The instantiation-site check: for each bounded type parameter the call actually bound,
// resolves every bound member against the concrete type in this site's scope and refuses
// what nothing satisfies. The bound's own member types resolve with the parameter bound to
// the concrete type, which is what makes `{ eq(T): boolean }` mean "eq takes another one of me" at each instantiation with no self-type machinery.
function checkBoundsAtCall(
  who: string,
  declIx: i32,
  bNames: string[],
  bTys: i32[],
  ix: i32,
) {
  if declIx < 0 { return 0 }
  if !fnHasTpBound(declIx) { return 0 }
  const dn = P.nodes[declIx]
  if !(dn is FuncDecl) { return 0 }
  let k = 0
  while k < dn.fnTyParams.length {
    const bAnn = fnTpBoundOf(declIx, k)
    if bAnn >= 0 {
      const tpName = dn.fnTyParams[k]
      let conc = -1
      let bi = 0
      while bi < bNames.length {
        if bNames[bi] == tpName { conc = bTys[bi] }
        bi = bi + 1
      }
      // Chaining through another generic's own type parameter has no instantiation type to
      // resolve a witness against, so it is decided by subsumption instead — statically,
      // which lands the error on the declaration that is wrong rather than a distant caller.
      // Bounds are free at emit once substitution has run; the check is what needs this, since a bounded generic relayed through an unbounded one has no pin left to ask (`vl check`-clean and invalid).
      if conc >= 0 {
        const ct0 = T.tys[conc]
        if ct0 is TyVar {
          if ct0.tvName.length > 0 {
            if ct0.tvName[0] != '?' {
              checkBoundSubsumes(ct0.tvName, tpName, bAnn, who, ix)
              k = k + 1
              continue
            }
          }
        }
      }
      if conc >= 0 && !tyHasHole(conc) {
        const root = boundObjRootOf(bAnn)
        if root < 0 {
          tErr(
            "`"
              + boundText(bAnn)
              + "` is not a bound — a bound is a type with method members (`type "
              + boundText(bAnn)
              + " = { m(): R }`) or an inline `{ m(): R }`",
            ix,
          )
        } else {
          // Bind the parameter to the CONCRETE type while the bound's member
          // types resolve, so a self-referential member means what it says here.
          tpEnvNames.push(tpName)
          tpEnvTys.push(conc)
          const bn: string[] = []
          const bt: i32[] = []
          const bm: boolean[] = []
          boundMembersOf(root, bn, bt, bm)
          tpEnvNames.pop()
          tpEnvTys.pop()
          const tyKey = tyToStr(conc)
          const bCovs: string[] = []
          let m = 0
          while m < bn.length {
            let wit = ""
            // An unresolved member type is the alias-self-reference case, reported at the
            // declaration (the body's own use raised it) rather than adding a second voice here.
            if bt[m] < 0 {
              m = m + 1
              continue
            }
            if bm[m] {
              wit = witnessOf(bn[m], bt[m], conc, ix)
            } else {
              // A COLON member is a layout demand and stays one: the value must
              // carry the field, which is ordinary structural assignability.
              const ct = T.tys[conc]
              if ct is TyObj {
                const ft = objFieldType(ct, bn[m])
                if ft >= 0 {
                  if assignable(ft, bt[m]) {
                    wit = "field"
                    rcwCovs(ft, bt[m], "." + bn[m], bCovs, 0)
                  }
                }
              }
            }
            const gBound = getterFnFor(conc, bn[m])
            if wit == "" && gBound != "" {
              tErr(
                tyKey
                  + " does not satisfy `"
                  + boundText(bAnn)
                  + "`: "
                  + getterBoundNote(gBound, bm[m]),
                ix,
              )
            } else if wit == "" && !bm[m] {
              tErr(
                tyKey
                  + " does not satisfy `"
                  + boundText(bAnn)
                  + "`: no field `"
                  + bn[m]
                  + ": "
                  + tyToStr(bt[m])
                  + "` — a field bound is satisfied only by a stored field; to accept a `"
                  + bn[m]
                  + "(self: "
                  + tyKey
                  + ")` function, bound on `{ "
                  + bn[m]
                  + "(): "
                  + tyToStr(bt[m])
                  + " }`",
                ix,
              )
            } else if wit == "" {
              let what = bn[m]
              if bm[m] { what = bn[m] + "(): " + tyToStr(retOfFuncTy(bt[m])) }
              tErr(
                tyKey
                  + " does not satisfy `"
                  + boundText(bAnn)
                  + "`: no `"
                  + what
                  + "` — the bound needs a field of that type or a `"
                  + bn[m]
                  + "(self: "
                  + tyKey
                  + ", …)` function in scope at this call",
                ix,
              )
            } else {
              cohRecord(who, tyKey, bn[m], wit, ix)
            }
            m = m + 1
          }
          // D2060 — a colon member wider than the argument's field is the covariant delivery
          // of a record, and the body writes through the bound's type.
          if bCovs.length > 0 && !inferQuiet {
            rcwBdDecl.push(declIx)
            rcwBdTp.push(tpName)
            rcwBdConc.push(conc)
            rcwBdCovs.push(rcwKey(bCovs))
            rcwBdCall.push(ix)
          }
        }
      }
    }
    k = k + 1
  }
  0
}

// Runs the pending return inference of the function `name` binds, so its type is complete
// before a UFCS call reads it. False when `fnTy` is not a function at all.
function ufcsInferCallee(name: string, fnTy: i32): boolean {
  if fnTy < 0 { return false }
  const preFt = T.tys[fnTy]
  if preFt is TyFunc {
    if preFt.fnRet == -2 {
      if !onInferStack(name) {
        const dIx = fnDeclIx[name] ?? -1
        if dIx >= 0 { checkNode(dIx) }
      }
    }
    return true
  }
  false
}

// A member call whose receiver each instance supplies (an un-annotated or type-parameter
// receiver): the body types it by the one return type every candidate shares, and each pin
// picks and checks its own candidate (`ovPinCheck`), the choice the emitter makes per instance.
function ovHoleCallTy(row: i32, prop: string, recvTy: i32, n: Call, ix: i32) {
  let ret = -1
  let why = ""
  if !ufcsSitePinnable(ix, cstrOwnerTop()) {
    why = "the receiver is not a parameter of the function the call sits in"
  }
  const argc = n.callArgs.length
  for c in ovSetCands[row] {
    if why == "" && declFirstParamIsSelf(c) {
      const fty = lookup(c)
      if ufcsInferCallee(c, fty) {
        const ft = T.tys[fty]
        if ft is TyFunc {
          const req = fnRequiredArity(fnDeclParamsOf(c))
          if argc + 1 > ft.fnParamTypes.length || argc + 1 < req {
            why = "the candidates take different numbers of arguments"
          } else if (
            ft.fnRet < 0
            || tyHasHole(ft.fnRet)
            || tyHasTyVar(ft.fnRet)
          ) {
            why = "a candidate's return type depends on its receiver"
          } else if ret >= 0 && !tyEq(ret, ft.fnRet) {
            why = "the candidates return different types"
          } else {
            ret = ft.fnRet
          }
        }
      }
    }
  }
  if ret < 0 && why == "" { why = "no candidate takes a receiver" }
  if why != "" {
    tErr(
      ovChooseMsg(
        row,
        prop,
        " for a receiver each call supplies, because "
          + why
          + " — annotate the receiver",
      ),
      ix,
    )
    return TY_ERR
  }
  for a in n.callArgs { checkNode(a) }
  noteUfcsCstr(recvTy, prop, ix, -1)
  if !i32ListHas(ovHoleSites, ix) { ovHoleSitesPush(ix) }
  ret
}

function ufcsCallTy(plainName: string, recvTy: i32, n: Call, ix: i32) {
  // Receiver overloading: a member call the merge left to the receiver's head class picks its
  // candidate here, banking it on the site for every later reader (`ufcsAliasAtSite`).
  const ovRow = ovSiteSetOf(ix)
  if ovRow >= 0 {
    if recvTy < 0 || T.tys[recvTy] is TyErr { return TY_ERR }
    // The merge banks a lone `self`-function candidate itself; several choose here.
    if ovSelfCount(ovRow) > 1 {
      if T.tys[recvTy] is TyVar {
        return ovHoleCallTy(ovRow, plainName, recvTy, n, ix)
      }
      const pick = ovPickFor(ovRow, recvTy)
      if pick == "" || pick == "*" {
        tErr(ovRefuseMsg(ovRow, plainName, recvTy, pick), ix)
        return TY_ERR
      }
      ufcsSiteAdd(ix, pick)
    }
    // A receiver whose element is still open would take it from the callee the name picked.
    if ovRecvOpen(recvTy) {
      tErr(
        ovChooseMsg(
          ovRow,
          plainName,
          ", because the receiver's element type is not known yet — annotate it (`const xs: string[] = []`)",
        ),
        ix,
      )
      return TY_ERR
    }
  }
  // Maps the callee's plain source name to its merge-mangled function, after field precedence
  // has already been checked — resolved at this call's own site (D1120), since two merged
  // modules may each export the same-named `self`-function.
  let name = ufcsAliasAtSite(ix, plainName)
  let fnTy = lookup(name)
  if fnTy < 0 || ufcsScopeStepsAside(name, fnTy, recvTy) {
    // Type-bound fallback (§C, docs/internals/type-bound-ufcs-design.md): the caller's scope
    // binds no such `self`-function, or binds one declared for another type while the receiver
    // is a newtype (§F, D1984), so ask the receiver type's declaring module. Banked on the site
    // for the emitter.
    const hm = homeModuleOf(recvTy)
    if hm >= 0 {
      const tbName = ufcsExportedScopeIn(hm, plainName)
      if tbName != "" && tbName != name {
        const tbFn = lookup(tbName)
        if tbFn >= 0 {
          if fnTy < 0 || ufcsSelfAccepts(tbName, tbFn, recvTy) {
            name = tbName
            fnTy = tbFn
            ufcsSiteAdd(ix, tbName)
          }
        }
      }
    }
  }
  if fnTy < 0 { return -1 }
  if !ufcsInferCallee(name, fnTy) { return -1 }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    let retTy = ft.fnRet
    if retTy == -2 { retTy = TY_ERR }
    const params = ft.fnParamTypes
    let args = n.callArgs
    // The `self`-NAME rule, asked here because the REWRITE asks it and the two
    // must not disagree about what dispatches (see `declFirstParamIsSelf`).
    if !declFirstParamIsSelf(name) { return -1 }
    // The arity range the direct spelling takes: the receiver fills `self` and the defaults fill
    // the tail of the declaration the scope chain gives this callee, empty for a binding (D1604).
    const uDecl = paramsAfterFirst(declParamsInScope(name))
    let uRequired = params.length - 1
    // `fnRequiredArity` over the TAIL alone: `self` is never defaulted (it is
    // the receiver), so the tail's own required count IS the answer.
    if uDecl.length == params.length - 1 { uRequired = fnRequiredArity(uDecl) }
    // A rest parameter packs here too: the receiver has already filled slot 0, so the pack
    // starts one slot earlier in the member call's own argument list than in the
    // declaration. Packing before the gate is what puts the two back in step.
    const uRest = restParamIndex(uDecl)
    if uRest >= 0 {
      if !callIsRestPacked(ix) {
        let uLo = uRequired
        if uLo > uRest { uLo = uRest }
        if args.length < uLo { return -1 }
        if !restCallPack(n, ix, uRest) { return TY_ERR }
      }
      args = n.callArgs
    } else if hasSpreadItem(args) {
      tErr(spreadNoRestMsg(plainName), ix)
      return TY_ERR
    }
    if args.length < uRequired || args.length + 1 > params.length { return -1 }
    if !assignable(recvTy, params[0]) { return -1 }
    // D2060 — the receiver is delivered to `self` like an argument, so a wider `self` field
    // the body writes is refused here as it is at the argument seam.
    const rcwRecv = P.nodes[n.callFn]
    if rcwRecv is Member {
      if !inferQuiet { rcwPend(rcwRecv.memObj, recvTy, params[0]) }
    }
    // The vacuous half of that gate, deferred: `assignable` answers true for a `TyVar` on
    // either side, so this row makes a hole receiver's pass mean something once resolved (see `ufcsCstr.ty`'s header).
    noteUfcsCstr(recvTy, plainName, ix, params[0])
    if tyHasHole(recvTy) && !ufcsSitePinnable(ix, cstrOwnerTop()) {
      if !i32ListHas(ufcsUnpinnedSites, ix) { ufcsUnpinnedSitesPush(ix) }
    }
    // Named arguments bind against the parameter names after `self` (the receiver is an
    // unnamed slot-0 positional), in parameter order — the full list with the receiver unnamed.
    if hasNamedArgs(n.callArgNames) {
      const uNames = paramNamesOfNodes(declParamsInScope(name))
      if uNames.length != params.length {
        tErr(
          "named arguments work only on declared functions, not on a function value",
          ix,
        )
        return TY_ERR
      }
      const restNames: string[] = []
      let rn = 1
      while rn < uNames.length {
        restNames.push(uNames[rn])
        rn = rn + 1
      }
      args = orderNamedCallArgs(restNames, args, n.callArgNames, ix, uDecl)
      if args.length != restNames.length { return TY_ERR }
    } else if args.length + 1 < params.length {
      // Pads trailing positional omissions with the declaration's defaults into a copy, so
      // the loop below covers the whole parameter list; `n.callArgs` stays untouched since `emit_rewrite` re-derives its own fill after the receiver is injected.
      const uPadded: i32[] = []
      let up = 0
      while up + 1 < params.length {
        if up < args.length { uPadded.push(args[up]) } else { uPadded.push(-1) }
        up = up + 1
      }
      if fillArgDefaults(uPadded, uDecl, ix) >= 0 { return TY_ERR }
      args = uPadded
    }
    // Generic dispatch binds the receiver into the `self` param's holes first — a receiver
    // missing a field the body demanded is not this method and falls through — then binds and checks the explicit arguments and substitutes the return.
    const bNames: string[] = []
    const bTys: i32[] = []
    const p0 = T.tys[params[0]]
    if p0 is TyVar {
      if !holeDemandOk(p0.tvName, -1, recvTy) { return -1 }
      // The receiver pins `self` as an argument pins its parameter, casts parked on it included.
      holeCastPinCheck(
        p0.tvName,
        recvTy,
        declParamNameAt(declParamsInScope(name), 0),
      )
    }
    // The receiver is the first argument a literal can be, for the destination's binding.
    const uDst: string[] = []
    const uArgs: i32[] = []
    if callDstTyOf(ix) >= 0 && !callHasTyArgs(ix) {
      uArgs.push(ufcsRecvExpr(n))
      for a in args { uArgs.push(a) }
      dstBindLitTyParams(ix, retTy, params, uArgs, bNames, bTys, uDst)
    }
    bindGenWalk(params[0], recvTy, bNames, bTys)
    // The receiver's half of the `u8[]`-meets-a-generic rule the direct-call spelling already
    // enforces: `bindGenWalk` above declined to bind `T` to storage type `u8`, so the
    // substituted `self` param still carries the unsolved hole the arity gate's `assignable`
    // passed vacuously — needed here because `self` arrives ahead of the argument loop that rule normally sits in.
    if !inferQuiet {
      if tyIsU8ArrayTy(recvTy) {
        if tyReachesHole(substTyDeep(params[0], bNames, bTys), 8) {
          tErr(
            "`u8[]` cannot be passed to a generic parameter — `u8` is a storage type, so a type parameter never binds it and a `u8[]` is not a `T[]`",
            ix,
          )
          return TY_ERR
        }
      }
    }
    // The receiver is `self`'s argument, so it takes the argument seam's verdict too: the
    // dispatch gate above asks bare `assignable`, which misses the refusals the seam holds,
    // such as a container widened into a differently stored element (D2165). `self` is asked
    // under the receiver's own binding; a receiver that is still a hole is re-asked at the pin.
    const recvX = ufcsRecvExpr(n)
    const selfTy = substSelfTy(params[0], bNames, bTys)
    // A receiver that is an observed parameter is delivered to `self` here, not at the seam.
    if expObsFn >= 0 { expObsPin(recvTy, selfTy, recvX) }
    if recvX >= 0 && !tyHasHole(recvTy) && !tyHasHole(selfTy) {
      if !assignableExpr(recvX, recvTy, selfTy) {
        tErr(
          "receiver: expected " + tyToStr(selfTy) + ", got " + tyToStr(recvTy),
          recvX,
        )
      }
    }
    // The direct call's order and seed (`checkCallNode`): a lambda whose parameter meets a hole
    // is checked after the other arguments, against its parameter under the receiver's binding
    // and theirs, so `xs.sort((a, b) => …)` types `a` as `sort(xs, (a, b) => …)` does.
    const uOrder = lambdaLastOrder(paramsAfterFirstTy(params), args)
    let oi = 0
    while oi < uOrder.length {
      const i = uOrder[oi]
      seedExpected(args[i], substTyDeep(params[i + 1], bNames, bTys))
      const at = checkNode(args[i])
      bindGenWalk(params[i + 1], at, bNames, bTys)
      const expected = substTyDeep(params[i + 1], bNames, bTys)
      const pHole = T.tys[params[i + 1]]
      if pHole is TyVar {
        if !holeDemandOk(pHole.tvName, args[i], at) {
          holeArgDemandErr(pHole.tvName, i + 1, at, args[i])
        }
        if rowIsArrayDemanded(params[i + 1]) {
          if tyRefusesArrayDemand(at) { holeArgArrayErr(i + 1, at, args[i]) }
        }
        if holeIsArrayWriteDemanded(name, pHole.tvName) {
          if tyIxIsView(at) { holeArgViewErr(i + 1, at, args[i]) }
        }
        // The `as` cast the body parked on this hole, re-asked under the argument. D1342.
        holeCastPinCheck(pHole.tvName, at, declParamNameAt(uDecl, i))
      }
      constrainEmptyExpr(args[i], at, expected)
      const savedArgLit = argLitAt
      argLitAt = peelParenIx(args[i])
      const argOk = assignableExpr(args[i], at, expected)
      argLitAt = savedArgLit
      if !argOk {
        // Anchored at the offending argument (or its offending return site),
        // never at the call node — see `argMismatchErr`.
        argMismatchErr(i + 1, expected, at, args[i])
      }
      oi = oi + 1
    }
    if uDst.length > 0 && !inferQuiet {
      dstRetypeLitArgs(uDst, params, uArgs, bNames, bTys)
    }
    // The uninferable-return gate reads the declaration, so `xs.f()` and `f(xs)` answer alike;
    // the receiver is `self`, a parameter like any other for the purpose of binding.
    checkRetTyParamBound(fnDeclIx[name] ?? CSTR_NODECL, plainName, ix, retTy)
    // The UFCS half of the deferred-constraint re-validation, which lived in the direct-call
    // path alone: `xs.indexOf(nd)` and `indexOf(xs, nd)` are the same call and must answer the
    // same way, so the UFCS spelling needs its own re-validation of the callee's recorded
    // constraints too — the same self-arrives-ahead-of-the-argument-loop asymmetry as above.
    if !inferQuiet {
      if bNames.length > 0 {
        callBindNote(ix, bNames, bTys)
        // `params[0]` is the RECEIVER here, so the origins skip it (`selfOff` 1) and the
        // remaining parameters number from 1 — `xs.plus(y)` blames `argument 1`, not 2.
        const uhNames: string[] = []
        const uhArgNo: i32[] = []
        const uhArgNode: i32[] = []
        holeArgOrigins(params, args, 1, uhNames, uhArgNo, uhArgNode)
        const pinArgs: i32[] = [ufcsRecvExpr(n)]
        for a in args { pinArgs.push(a) }
        pinBmCstrElems(bNames, bTys, ix, fnDeclIx[name] ?? CSTR_NODECL, pinArgs)
        validateBinCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
          uhNames,
          uhArgNo,
          uhArgNode,
        )
        // The print capability rides the same pin and the same UFCS/direct symmetry as
        // above — `xs.show()` and `show(xs)` must answer the same way (D401).
        validatePrintCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
        )
        validateNestCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
        )
        validateIsCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
        )
        // A call argument inside the body, at the UFCS half for the same symmetry: `"s".inc()`
        // and `inc("s")` must answer the same way (D2425).
        validateArgCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          uhNames,
          uhArgNode,
        )
        // The declared return, at the UFCS half for the same symmetry: `p.g()` and `g(p)`
        // must answer the same way, or the method spelling of D551's family stays silent beside a loud direct one.
        validateRetCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
        )
        // Every other destination inside the body — a local, a re-assignment, a field or
        // element write — at the UFCS half for the same symmetry (D572).
        validateLetCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
        )
        // Every builtin-collection-method argument inside the body, at the UFCS half for the
        // same symmetry (D582).
        validateBmCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
        )
        // After the pins above, as the direct spelling does; the receiver is an argument too.
        const rcvN = P.nodes[n.callFn]
        if rcvN is Member { refuseOpenNullHoleArg(rcvN.memObj, plainName) }
        let oua = 0
        while oua < args.length {
          refuseOpenNullHoleArg(args[oua], plainName)
          oua = oua + 1
        }
        // The receiver classification of a `.length` / `x[i]` inside the body, at the UFCS
        // half for the same symmetry (D651 / D691).
        validateMemCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
          uhNames,
          uhArgNo,
          uhArgNode,
        )
        // The receiver of a UFCS `self`-method resolved inside the body, at the UFCS half
        // for the same symmetry (D1005).
        validateUfcsCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
        )
      }
    }
    if bNames.length > 0 { retTy = substTyDeep(retTy, bNames, bTys) }
    return retTy
  }
  -1
}

// Type the bitcast call `name(arg)`, or -1 when `name` is not a bitcast. Arity and the
// argument type are checked here; `assignableExpr` (not bare `assignable`) so a float
// LITERAL argument re-encodes into an `f32` parameter, matching every other f32 position.
function bitcastCallTy(name: string, n: Call, ix: i32) {
  const want = bitcastArgTy(name)
  if want < 0 { return -1 }
  const args = n.callArgs
  if args.length != 1 {
    tErr(name + " expects 1 argument, got " + i32ToStr(args.length), ix)
  } else {
    const got = checkNode(args[0])
    if !assignableExpr(args[0], got, want) {
      tErr(name + " expects " + tyToStr(want) + ", got " + tyToStr(got), ix)
    }
  }
  bitcastRetTy(name)
}

// Type the float / integer intrinsic call `name(args…)`, or -1 when `name` is not one.
// The operand width is decided from the arguments and every argument is then checked
// against it, so a mixed call reports the width it actually computes at.
function numIntrCallTy(name: string, n: Call, ix: i32) {
  const isFloat = floatIntrArity(name) > 0
  let arity = intIntrArity(name)
  if isFloat { arity = floatIntrArity(name) }
  if arity == 0 { return -1 }
  const args = n.callArgs
  if args.length != arity {
    let want = i32ToStr(arity) + " arguments"
    if arity == 1 { want = "1 argument" }
    tErr(name + " expects " + want + ", got " + i32ToStr(args.length), ix)
    // Still yield a type so the call site does not cascade: the width is unknowable
    // from a wrong-arity call, so take the family's default.
    if isFloat { return TY_F64 }
    if intIntrIsCompare(name) { return TY_BOOL }
    return TY_I32
  }
  const argTys: i32[] = []
  let i = 0
  while i < args.length {
    argTys.push(checkNode(args[i]))
    i = i + 1
  }
  const holeTy = minMaxHoleOperand(name, argTys)
  if holeTy >= 0 {
    noteBinCstr(argTys[0], name, argTys[argTys.length - 1])
    return holeTy
  }
  let width = intIntrWidth(argTys)
  if isFloat && !intMinMaxOperands(name, argTys) {
    width = floatIntrWidth(args, argTys)
  }
  // An operand is no delivery: `ltU(a, b)` computes at the width `a` and `b` give it.
  const savedNoDest = lbiNoDest
  lbiNoDest = true
  let j = 0
  while j < args.length {
    if !assignableExpr(args[j], argTys[j], width) {
      tErr(
        name + " expects " + tyToStr(width) + ", got " + tyToStr(argTys[j]),
        ix,
      )
    }
    j = j + 1
  }
  lbiNoDest = savedNoDest
  if !isFloat {
    if intIntrIsCompare(name) { return TY_BOOL }
  }
  width
}

// Method call on a member callee (`xs.push(e)`, `m.get(k)`, `s.slice(a)`): types the
// builtin receiver kinds directly, never as a struct field read. Returns the call type,
// or `-1` when no builtin arm claims it and the caller falls through to the field/UFCS
// path — the same "no answer" spelling `ufcsCallTy` and `arrayUnionCallTy` already use.
function checkMemberCallNode(
  n: Call,
  ix: i32,
  recvIx: i32,
  prop: string,
  recvPre: i32,
): i32 {
  // A member-access callee is always function-typed for semantic tokens; the builtin arms
  // below type it directly and never revisit the member-read arm, so its name is recorded here (a struct field holding a function falls through to `checkNode` and overwrites it for hover).
  symMemMethod(n.callFn)
  // An optional call hands the receiver's type in already non-null: `p?.f(…)` resolves the
  // callee against the value its guard admits, not against the `| null` the guard strips.
  let recvTy = recvPre
  if recvPre < 0 { recvTy = checkNode(recvIx) }
  if recvTy >= 0 { recvTy = strLitRecvTy(recvTy) }
  // A gradual union's built-in method is its concrete member's; the pin re-asks the whole union.
  if recvTy >= 0 && recvTy < T.tys.length && T.tys[recvTy] is TyUnion {
    const gv = tpGradualView(recvTy)
    if gv != recvTy && gv >= 0 && builtinMethodClaims(gv, prop) {
      noteMemCstr(recvTy, MC_METHOD_MARK + prop, ix, false)
      recvTy = gv
    }
  }
  let rt = T.tys[recvTy]
  // An un-annotated hole receiving an array method (`self.map`/`.push`/…) is constrained to
  // an array — synthesizing one over a derived element hole and falling into the array-method
  // arm below, which pins the concrete element per call shape. Without this the hole would
  // grow a `{map: any}` struct shape no array argument could satisfy.
  if rt is TyVar && !holeMethodIsSelfFn(prop, ix) {
    if holeArrMethod(prop) {
      noteArrayDemand(arrayDemandKey(recvTy))
      // The synthesized receiver below is a MUTABLE list, and nothing re-checks the
      // argument against it — so a write through the hole is filed here, and the pin
      // refuses a view for it.
      if listMethodMutates(prop) { noteArrayWriteDemand(rt.tvName) }
      const elemHole = mkDerivedHole(HD_ELEM, "", -1, -1, recvTy)
      recvTy = mkArrayTy(elemHole)
    } else if holeMapMethod(prop) {
      // A place a type-parameter write left nullable at some pins is asked at each, unless
      // the call is optional (D3445).
      if recvPre < 0 && tyIsWriteLandRead(recvTy) {
        noteMemCstr(recvTy, MC_NULL_READ_MARK + prop, ix, false)
      }
      // The dual for a hole receiving a map/set method: becomes the hole's demanded map
      // (`{[?]: ?}`) and falls into the map-method arm below, which pins the open key/value
      // from the method's own arguments — `.add` mints the Set flavor. Without this the hole
      // would grow a `{set: any}` struct shape no map argument could satisfy.
      recvTy = holeMapDemandTy(rt.tvName, prop == "add")
    }
  }
  rt = T.tys[recvTy]
  // Banked for the emitter's rewrite, which must take the rung this call took (D2476).
  if builtinMethodClaims(recvTy, prop) {
    memberCallRungAdd(ix, MC_RUNG_BUILTIN)
  }
  if rt is TyArray {
    // The view's whole contract: a `readonly T[]` receiver refuses every method that
    // changes the list's own shape. An element's fields are untouched by it — the marker
    // is on the list, not on what the list holds. Reported and then fallen through, so the
    // call still types as its own method and no cascade follows the one real diagnostic.
    if rt.aRead == 1 {
      if listMethodMutates(prop) {
        tErr(roWriteMsg("`." + prop + "()`", recvTy), ix)
      }
    }
    const margs = n.callArgs
    if prop == "push" {
      if margs.length < 1 {
        tErr("push expects at least 1 argument, got 0", ix)
      } else {
        // `push` is variadic — every argument appends, and a spread argument appends every
        // element of its source. One loop covers both, so `xs.push(...ys)` needs no case of
        // its own; the appends happen in argument order.
        let mi = 0
        while mi < margs.length {
          const spd = spreadArgOf(margs[mi])
          if spd >= 0 {
            const set = spreadElemTy(margs[mi])
            if rt.aElem < 0 {
              if set >= 0 {
                rt.aElem = set
                tyMutEpoch = tyMutEpoch + 1 // a spread pinned the element in place
              }
            } else if set >= 0 {
              if !bmArgOk(BM_PUSH, "push", set, rt.aElem, recvTy, spd) {
                tErr(bmArgMsg(BM_PUSH, "push", set, rt.aElem, recvTy), ix)
              }
            }
          } else {
            // Contextual param inference for a pushed callback: `fs.push((n) => n + 1)` over a
            // `((i32) => i32)[]` seeds the lambda's param from the element function type, so an
            // un-annotated lambda infers `n` instead of erroring (mirrors the `.map`/`.filter`
            // seeding). A non-function element / non-lambda arg is left untouched by `seedExpected`.
            if rt.aElem >= 0 { seedExpected(margs[mi], rt.aElem) }
            const pat = checkNode(margs[mi])
            // The first `.push(v)` on a bare empty `[]` pins its element type to `typeof v` in
            // place — the usage-driven inference that resolves an un-annotated `const xs = []`; a later conflicting push is then a clean type error.
            if rt.aElem < 0 { calleeWritePrePin(recvTy, pat) }
            if rt.aElem < 0 {
              rt.aElem = cnhPinTy(pat, ix, recvIx, false, false)
              tyMutEpoch = tyMutEpoch + 1 // `.push` pinned the element in place
            } else {
              cnhFill(rt.aElem, pat)
              // The pushed value's own open holes pin from the element slot — the same rule
              // `.set` / `m[k] = v` / `xs = e` apply at their own store positions.
              constrainEmptyExpr(margs[mi], pat, rt.aElem)
              // A float literal re-encodes into an `f32` element as at a binding (D582); a hole
              // lambda takes a concrete function element's type as an element store does, so a
              // body that cannot is refused here, not lowered at the hole's default (D3867).
              if pushHoleFnToConcrete(pat, rt.aElem) {
                if !assignableExpr(margs[mi], pat, rt.aElem) {
                  tErrWant(
                    letAssignMsg(margs[mi], pat, rt.aElem, "", -1),
                    margs[mi],
                    rt.aElem,
                  )
                }
              } else if (
                !bmArgOk(BM_PUSH, "push", pat, rt.aElem, recvTy, margs[mi])
              ) {
                tErr(bmPushMsg("push", pat, rt.aElem, recvTy, margs[mi]), ix)
              }
            }
          }
          mi = mi + 1
        }
      }
      return TY_I32
    }
    // `.map(fn)` / `.filter(pred)`: the callback is a 1-arg function over the
    // element type; map yields an array of the callback's return, filter the
    // same array type (its predicate must yield bool).
    if prop == "map" || prop == "filter" {
      const cargs = n.callArgs
      if cargs.length != 1 {
        tErr(prop + " expects 1 argument, got " + i32ToStr(cargs.length), ix)
        return TY_ERR
      }
      // Seeds the callback's expected param type from the receiver's element type, so an
      // un-annotated function-literal argument infers its param instead of erroring — only
      // when the arg is an anonymous literal and the element type is known, else cleared below.
      const cbArg = P.nodes[cargs[0]]
      // A named callback is typed by the element, which a refused function value names.
      if cbArg is Ident && ovSetMod.length > 0 {
        ovCbElemSetAt(cargs[0], rt.aElem)
      }
      if cbArg is FuncDecl {
        if cbArg.fnName == "" && rt.aElem >= 0 {
          recordCbExpected(cargs[0], [rt.aElem])
        }
        if !cbElemNarrowFor(recvIx, cargs[0]) { efLeaf[cargs[0]] = -1 }
      }
      const cbTy = checkNode(cargs[0])
      const cb = T.tys[cbTy]
      if cb is TyFunc {
        const cbParams = cb.fnParamTypes
        if cbParams.length != 1 {
          tErr(
            prop
              + " callback expects 1 parameter, got "
              + i32ToStr(cbParams.length),
            ix,
          )
        } else if !assignable(rt.aElem, cbParams[0]) {
          tErr(
            prop
              + " callback: parameter expects "
              + tyToStr(cbParams[0])
              + ", got "
              + tyToStr(rt.aElem),
            ix,
          )
        }
        if prop == "filter" {
          if !assignable(cb.fnRet, TY_BOOL) {
            tErr(
              "filter predicate must yield boolean, got " + tyToStr(cb.fnRet),
              ix,
            )
          }
          return listBuiltResultTy(recvTy, rt.aElem, rt.aRead)
        }
        return mkArrayTy(cb.fnRet)
      }
      tErr(prop + " expects a function, got " + tyToStr(cbTy), ix)
      return TY_ERR
    }
    // `.pop()` / `.get(i)` yield `T | null` (an empty pop / out-of-range get is
    // normal absence); `.clear()` empties in place and yields nothing. The element is
    // its VALUE type (`arrElemValueTy`), so a `u8[]` answers `i32 | null` — the same
    // widening `xs[i]` takes, and the rep `emitPopNulBox` already builds (D1211).
    if prop == "pop" {
      if margs.length != 0 {
        tErr("pop expects 0 arguments, got " + i32ToStr(margs.length), ix)
      }
      // The first pop under a `.length` test of this same list yields the element (D3558); an
      // element type over a type variable or hole lowers per instance, so it stays nullable.
      const popEl = arrElemValueTy(rt.aElem)
      if (
        margs.length == 0
        && !tyHasHole(popEl)
        && nePopTakes(ix, recvIx, curFnDeclIx)
      ) {
        return popEl
      }
      return mkNullableTy(popEl)
    }
    if prop == "get" {
      if margs.length != 1 {
        tErr("get expects 1 argument, got " + i32ToStr(margs.length), ix)
      } else {
        const gat = checkNode(margs[0])
        if !bmArgOk(BM_INDEXMUST, "get", gat, TY_I32, -1, margs[0]) {
          tErr(bmArgMsg(BM_INDEXMUST, "get", gat, TY_I32, -1), ix)
        }
      }
      return mkNullableTy(arrElemValueTy(rt.aElem))
    }
    if prop == "clear" {
      if margs.length != 0 {
        tErr("clear expects 0 arguments, got " + i32ToStr(margs.length), ix)
      }
      return TY_VOID
    }
    // `.slice(start, end?)` yields a NEW array of the SAME element type — the bounds
    // are i32 (a missing `end` defaults to the length; negatives count from the end).
    if prop == "slice" {
      if margs.length != 1 && margs.length != 2 {
        tErr(
          "slice expects 1 or 2 arguments, got " + i32ToStr(margs.length),
          ix,
        )
      } else {
        let si = 0
        while si < margs.length {
          const sat = checkNode(margs[si])
          if !bmArgOk(BM_BOUNDMUST, "slice", sat, TY_I32, -1, margs[si]) {
            tErr(bmArgMsg(BM_BOUNDMUST, "slice", sat, TY_I32, -1), ix)
          }
          si = si + 1
        }
      }
      return listBuiltResultTy(recvTy, rt.aElem, rt.aRead)
    }
    // UFCS `self`-method on an array receiver (`parts.join(sep)`): an array
    // carries no user FIELD, so a matching free `self`-function resolves
    // directly — the array dual of the string/struct/union UFCS paths.
    const au = ufcsCallTy(prop, recvTy, n, ix)
    if au >= 0 {
      memberCallRungAdd(ix, MC_RUNG_SELF_FN)
      return au
    }
    if ufcsMissRaise(prop, recvTy, n.callArgs.length, ix, n.callFn) {
      return TY_ERR
    }
    tErr(
      "no method '."
        + prop
        + "' on array "
        + tyToStr(recvTy)
        + methodDidYouMean(recvTy, prop),
      n.callFn,
    )
    return TY_ERR
  }
  // Map/Set methods over the `{[K]: V}` rep, gated by flavor: a map exposes `.set`/`.get`/
  // `.has`/`.delete`/`.keys`/`.values`; a set exposes `.add`/`.has`/`.delete`/`.keys`/`.values`.
  // `.add` alone gates on the value's TYPE rather than the flavor bit (see its own arm). The
  // first `.set`/`.add` on a bare `Map()`/`Set()` pins its key/value holes in place.
  if rt is TyMap {
    const mp = prop
    const margs2 = n.callArgs
    if mp == "set" && rt.mSet == 0 {
      if margs2.length != 2 {
        tErr("set expects 2 arguments, got " + i32ToStr(margs2.length), ix)
      } else {
        const k0 = checkNode(margs2[0])
        // The value argument is a store into the map's value slot, taking the same
        // contextual steps `xs.push(v)` and `m[k] = v` take: `seedExpected` first, then the
        // expression-aware `assignableExpr` — the one home the assignment path also calls, so `.set` and `m[k] = v` cannot drift apart.
        if rt.mVal >= 0 { seedExpected(margs2[1], rt.mVal) }
        const v0 = checkNode(margs2[1])
        if rt.mKey < 0 {
          rt.mKey = widenLitTy(k0)
          tyMutEpoch = tyMutEpoch + 1 // `.set` pinned the key in place
          checkInferredMapKey(rt.mKey, rt.mSet, ix)
        } else if !bmArgOk(BM_SETKEY, "set", k0, rt.mKey, -1, margs2[0]) {
          tErr(bmArgMsg(BM_SETKEY, "set", k0, rt.mKey, -1), ix)
        }
        if rt.mVal < 0 {
          rt.mVal = cnhPinTy(v0, ix, recvIx, true, isHoleMapDemandTy(recvTy))
          tyMutEpoch = tyMutEpoch + 1 // `.set` pinned the value in place
        } else {
          cnhFill(rt.mVal, v0)
          // The value argument's own open holes pin from the slot, the third step
          // this store shares with `m[k] = v` (which pins in `checkBinExprNode`'s
          // `=` arm) — without it, `m.set("a", fq())` over a `{[string]: f64[]}` reaches the emitter with an unpinned `[]`.
          constrainEmptyExpr(margs2[1], v0, rt.mVal)
          // `assignableExpr` already covers the newtype literal-adoption case (`m.set("k",
          // 1)` over `{[string]: EntityId}` fires), deferring to the pin under a hole (D582).
          // A hole lambda takes a concrete function value type as `m[k] = v` and `push` do, so
          // a body that cannot is refused here (D3881).
          if pushHoleFnToConcrete(v0, rt.mVal) {
            if !assignableExpr(margs2[1], v0, rt.mVal) {
              tErrWant(
                letAssignMsg(margs2[1], v0, rt.mVal, "", -1),
                margs2[1],
                rt.mVal,
              )
            }
          } else if !bmArgOk(BM_SETVAL, "set", v0, rt.mVal, -1, margs2[1]) {
            tErr(bmArgMsg(BM_SETVAL, "set", v0, rt.mVal, -1), ix)
          }
        }
      }
      return TY_VOID
    }
    if mp == "get" && rt.mSet == 0 {
      if margs2.length != 1 {
        tErr("get expects 1 argument, got " + i32ToStr(margs2.length), ix)
      } else {
        const k1 = checkNode(margs2[0])
        if !bmArgOk(BM_KEYMUST, "get", k1, rt.mKey, -1, margs2[0]) {
          tErr(bmArgMsg(BM_KEYMUST, "get", k1, rt.mKey, -1), ix)
        }
      }
      return mkNullableTy(rt.mVal)
    }
    // `.add(x)` is a Set method only: a boolean-valued map is a map, and its insert is
    // `m[k] = true` (DECISIONS.md, "`{[K]: V}` and `T[]` are concrete types").
    if mp == "add" && rt.mSet == 0 && tyIsPrimNamed(rt.mVal, "boolean") {
      // The hint yields to a `self`-function named `add`: a map has no such member (D2477).
      const ma = ufcsCallTy(mp, recvTy, n, ix)
      if ma >= 0 {
        memberCallRungAdd(ix, MC_RUNG_SELF_FN)
        return ma
      }
      tErr(
        "`.add` is a `Set` method — use `m[k] = true`, or make it a `Set<"
          + tyToStr(rt.mKey)
          + ">`",
        ix,
      )
      return TY_ERR
    }
    if mp == "add" && rt.mSet == 1 {
      if margs2.length != 1 {
        tErr("add expects 1 argument, got " + i32ToStr(margs2.length), ix)
      } else {
        const ka = checkNode(margs2[0])
        if rt.mKey < 0 {
          rt.mKey = widenLitTy(ka)
          tyMutEpoch = tyMutEpoch + 1 // `.add` pinned the Set key in place
          checkInferredMapKey(rt.mKey, rt.mSet, ix)
        } else if !bmArgOk(BM_ADDKEY, "add", ka, rt.mKey, -1, margs2[0]) {
          tErr(bmArgMsg(BM_ADDKEY, "add", ka, rt.mKey, -1), ix)
        }
      }
      return TY_VOID
    }
    if mp == "has" || mp == "delete" {
      if margs2.length != 1 {
        tErr(mp + " expects 1 argument, got " + i32ToStr(margs2.length), ix)
      } else {
        const k2 = checkNode(margs2[0])
        if !bmArgOk(BM_KEYMUST, mp, k2, rt.mKey, -1, margs2[0]) {
          tErr(bmArgMsg(BM_KEYMUST, mp, k2, rt.mKey, -1), ix)
        }
      }
      return TY_BOOL
    }
    if mp == "clear" {
      if margs2.length != 0 {
        tErr("clear expects 0 arguments, got " + i32ToStr(margs2.length), ix)
      }
      return TY_VOID
    }
    if mp == "keys" {
      if margs2.length != 0 { tErr("keys expects no arguments", ix) }
      return mkArrayTy(rt.mKey)
    }
    if mp == "values" {
      if margs2.length != 0 { tErr("values expects no arguments", ix) }
      // A set's `.values()` yields its ELEMENTS (the keys); a map's its values.
      if rt.mSet == 1 { return mkArrayTy(rt.mKey) }
      return mkArrayTy(rt.mVal)
    }
    // A name no map arm claims is a `self`-function call, as on every other receiver (D2477).
    const mu = ufcsCallTy(mp, recvTy, n, ix)
    if mu >= 0 {
      memberCallRungAdd(ix, MC_RUNG_SELF_FN)
      return mu
    }
    tErr(
      "unknown property `"
        + mp
        + "` on "
        + tyToStr(recvTy)
        + methodDidYouMean(recvTy, mp),
      ix,
    )
    return TY_ERR
  }
  // String methods: `.slice`/`.indexOf`/`.includes`/`.charCodeAt`, and the stage 2c trio
  // `.cpAt`/`.cpLen`/`.isCharBoundary` (`.length` is a `Member`, `s[i]` an `Index`). The trio
  // lives in the core rather than `std:str` (OQ-3) because each needs the UTF-8 storage directly
  // — a byte-offset decode, a continuation-byte scan, a lead-bit test — which the surface exposes no other way to reach.
  if rt is TyPrim {
    if rt.primName == "string" {
      const sp = prop
      const sargs = n.callArgs
      if sp == "slice" {
        if sargs.length != 2 {
          tErr("slice expects 2 arguments, got " + i32ToStr(sargs.length), ix)
        } else {
          const s0 = checkNode(sargs[0])
          const s1 = checkNode(sargs[1])
          // Two constraints, one sentence: each bound defers on its own (either can be the
          // hole), but the message names both types, so each form carries the other bound as its `ctx` and renders the identical sentence whichever side failed.
          const sb0 = bmArgOk(BM_BOUNDS0, "slice", s0, TY_I32, s1, sargs[0])
          const sb1 = bmArgOk(BM_BOUNDS1, "slice", s1, TY_I32, s0, sargs[1])
          if !sb0 {
            tErr(bmArgMsg(BM_BOUNDS0, "slice", s0, TY_I32, s1), ix)
          } else if !sb1 {
            tErr(bmArgMsg(BM_BOUNDS1, "slice", s1, TY_I32, s0), ix)
          }
        }
        return TY_STR
      }
      if sp == "indexOf" {
        if sargs.length != 1 {
          tErr("indexOf expects 1 argument, got " + i32ToStr(sargs.length), ix)
        } else {
          const a0 = checkNode(sargs[0])
          if !bmArgOk(BM_EXPECTSA, "indexOf", a0, TY_STR, -1, sargs[0]) {
            tErr(bmArgMsg(BM_EXPECTSA, "indexOf", a0, TY_STR, -1), ix)
          }
        }
        return TY_I32
      }
      if sp == "includes" {
        if sargs.length != 1 {
          tErr("includes expects 1 argument, got " + i32ToStr(sargs.length), ix)
        } else {
          const a0 = checkNode(sargs[0])
          if !bmArgOk(BM_EXPECTSA, "includes", a0, TY_STR, -1, sargs[0]) {
            tErr(bmArgMsg(BM_EXPECTSA, "includes", a0, TY_STR, -1), ix)
          }
        }
        return TY_BOOL
      }
      if sp == "charCodeAt" {
        if sargs.length != 1 {
          tErr(
            "charCodeAt expects 1 argument, got " + i32ToStr(sargs.length),
            ix,
          )
        } else {
          const a0 = checkNode(sargs[0])
          if !bmArgOk(BM_IDXPHRASE, "charCodeAt", a0, TY_I32, -1, sargs[0]) {
            tErr(bmArgMsg(BM_IDXPHRASE, "charCodeAt", a0, TY_I32, -1), ix)
          }
        }
        return TY_I32
      }
      // `s.cpAt(i)` — the code point whose UTF-8 sequence begins at byte offset `i`,
      // O(1) (§Codepoints). Not "the i-th code point": the argument is in the one
      // coordinate system `slice`, `indexOf` and `.length` share.
      if sp == "cpAt" {
        if sargs.length != 1 {
          tErr("cpAt expects 1 argument, got " + i32ToStr(sargs.length), ix)
        } else {
          const a0 = checkNode(sargs[0])
          if !bmArgOk(BM_BYTEOFF, "cpAt", a0, TY_I32, -1, sargs[0]) {
            tErr(bmArgMsg(BM_BYTEOFF, "cpAt", a0, TY_I32, -1), ix)
          }
        }
        return TY_I32
      }
      // `s.cpLen()` — the code-point count, O(n) and NAMED so the cost is visible at the
      // call site rather than hidden in a `.length` that is O(1) on some data and O(n)
      // on other data (§Codepoints: "a subscript should mean O(1), always").
      if sp == "cpLen" {
        if sargs.length != 0 {
          tErr("cpLen expects no arguments, got " + i32ToStr(sargs.length), ix)
        }
        return TY_I32
      }
      // `s.isCharBoundary(i)` — Rust's primitive, O(1): a single lead/continuation bit
      // test. Slicing off a boundary is LEGAL under Go-lean validity (§Validity), so this
      // is the tool for code that wants to check rather than a guard the language imposes.
      if sp == "isCharBoundary" {
        if sargs.length != 1 {
          tErr(
            "isCharBoundary expects 1 argument, got " + i32ToStr(sargs.length),
            ix,
          )
        } else {
          const a0 = checkNode(sargs[0])
          if (
            !bmArgOk(BM_BYTEOFF, "isCharBoundary", a0, TY_I32, -1, sargs[0])
          ) {
            tErr(bmArgMsg(BM_BYTEOFF, "isCharBoundary", a0, TY_I32, -1), ix)
          }
        }
        return TY_BOOL
      }
      // `s.bytes()` — the string's UTF-8 storage as a `u8[]`. A COPY, not a view:
      // see `emitStrBytesFnCode` for why a `u8[]` cannot express a non-zero `start`,
      // and `strings-design.md` §Byte view for the withdrawn zero-copy claim.
      if sp == "bytes" {
        if sargs.length != 0 {
          tErr("bytes expects no arguments, got " + i32ToStr(sargs.length), ix)
        }
        return mkArrayTy(TY_U8)
      }
      // UFCS `self`-method on a string receiver (`"hello".first()`).
      const su = ufcsCallTy(sp, recvTy, n, ix)
      if su >= 0 {
        memberCallRungAdd(ix, MC_RUNG_SELF_FN)
        return su
      }
      if ufcsMissRaise(sp, recvTy, n.callArgs.length, ix, n.callFn) {
        return TY_ERR
      }
      tErr(
        "no method '." + sp + "' on string" + methodDidYouMean(recvTy, sp),
        n.callFn,
      )
      return TY_ERR
    }
  }
  // UFCS `self`-method on any other receiver: `o.f(args)` lowers to `f(o, args)` when the
  // receiver has no such field (a callable field keeps precedence) and a matching free
  // function exists. The field-first test is `tyFieldTyOf`, the same predicate the emitter's
  // `drwWalk` calls on the receiver's recorded type, so the two cannot disagree (D1070).
  const ufcsHasField = tyFieldTyOf(recvTy, prop) >= 0
  const urt = T.tys[recvTy]
  // A bounded type parameter as the receiver (OQ-5, strict bodies): the bound answers, and
  // only the bound — arguments check against its declared members and the result is what it
  // promised. No dispatch happens here; the witness is chosen per instantiation site
  // (`checkBoundsAtCall`) and baked by the monomorphizer.
  if urt is TyVar {
    const bcTy = boundMemberTy(urt.tvName, prop, true)
    if bcTy == BOUND_UNRESOLVED {
      tErr(boundMemberUnknownMsg(urt.tvName, prop), ix)
      return TY_ERR
    }
    if bcTy >= 0 {
      const bcT = T.tys[bcTy]
      if bcT is TyFunc {
        const bcArgs = n.callArgs
        if bcArgs.length != bcT.fnParamTypes.length {
          tErr(
            "`"
              + prop
              + "` on `"
              + urt.tvName
              + "` expects "
              + i32ToStr(bcT.fnParamTypes.length)
              + " arguments, got "
              + i32ToStr(bcArgs.length),
            ix,
          )
          return TY_ERR
        }
        let bca = 0
        while bca < bcArgs.length {
          const bcat = checkNode(bcArgs[bca])
          const bcWant = bcT.fnParamTypes[bca]
          // An UNRESOLVED member type (`-1`) is a bound whose own annotation
          // named something this scope has no answer for. Reported once, at the
          // call, rather than fed to `assignable` — which reads a negative side
          // as "accept anything" and would silently pass every argument.
          if bcWant < 0 {
            tErr(boundMemberUnknownMsg(urt.tvName, prop), ix)
            return TY_ERR
          }
          if !assignableExpr(bcArgs[bca], bcat, bcWant) {
            argMismatchErr(bca + 1, bcWant, bcat, bcArgs[bca])
          }
          bca = bca + 1
        }
        if bcT.fnRet < 0 {
          tErr(boundMemberUnknownMsg(urt.tvName, prop), ix)
          return TY_ERR
        }
        return bcT.fnRet
      }
    }
    const bcMsg = boundMemberFloorMsg(urt.tvName, prop)
    if bcMsg != "" {
      tErr(bcMsg, ix)
      return TY_ERR
    }
  }
  if !ufcsHasField {
    const uu = ufcsCallTy(prop, recvTy, n, ix)
    if uu >= 0 {
      memberCallRungAdd(ix, MC_RUNG_SELF_FN)
      return uu
    }
    // The name is a self-function, just not one in scope (D1230) — asked here since only
    // the call knows the argument count, banked on the callee member node where the sentence is raised (`memberFloorErr`).
    noteUfcsMiss(
      n.callFn,
      ufcsMissingImportSpecs(prop, recvTy, n.callArgs.length, ix),
    )
    // When the name is already in scope, which gate declined (D1570) — banked beside
    // D1230's answer and read after it, since `argc` is known here and raised there.
    noteUfcsNotMethod(
      n.callFn,
      prop,
      ufcsAliasAtSite(ix, prop),
      recvTy,
      n.callArgs.length,
    )
  }
  -1
}

// A memory intrinsic called with one argument more than it declares: the offset form, whose
// second argument is the memarg offset. Checks the offset (`memOffsetArgCheck`) and every other
// argument against the declared parameter it stands for; answers the call's type, or -1 when
// the call is not this form (a shadowed name, a named argument, any other arity).
function checkMemOffsetCall(n: Call, cfn: Ident): i32 {
  const nm = cfn.identName
  const base = memOffsetBaseArity(nm)
  if base < 0 || n.callArgs.length != base + 1 { return -1 }
  if hasNamedArgs(n.callArgNames) { return -1 }
  if (fnDeclIx[nm] ?? -1) >= 0 || lookupDepth(nm) != 0 { return -1 }
  const ft = T.tys[checkNode(n.callFn)]
  if ft is TyFunc {
    const ps = ft.fnParamTypes
    if ps.length != base { return -1 }
    memOffsetArgCheck(nm, n.callArgs[1])
    let k = 0
    while k < base {
      let pos = k
      if k >= 1 { pos = k + 1 }
      const a = n.callArgs[pos]
      seedExpected(a, ps[k])
      const at = checkNode(a)
      if !assignableExpr(a, at, ps[k]) { argMismatchErr(pos + 1, ps[k], at, a) }
      k = k + 1
    }
    return ft.fnRet
  }
  -1
}

// Reports unless the offset argument at `argIx` is a compile-time integer in
// `0..MEM_OFFSET_MAX`: a literal, a top-level `const` bound to one that no nearer binding
// shadows, or a sum of those.
function memOffsetArgCheck(nm: string, argIx: i32) {
  checkNode(argIx)
  if memOffsetCheckedValue(argIx) >= 0 { return 0 }
  tErr(
    nm
      + " takes its offset (argument 2) as a compile-time integer in 0..4294967295 — a literal, a top-level `const` bound to one, or a sum of those — since it is the instruction's memarg immediate, not a runtime operand",
    argIx,
  )
  0
}

// Calls to a compiler builtin named by the callee identifier — `print`, `Map`/`Set`, the
// codepoint constructors and the `__array_*` / bitcast / numeric intrinsics. None has a
// declaration to check against, so arity and argument types are checked here. Returns the
// call type, or `-1` when the name is none of them and the caller checks it as a value.
function checkBuiltinIdentCall(n: Call, ix: i32, cfn: Ident): i32 {
  // `print(x)` is a compiler builtin (no module/import system yet): it accepts a
  // single value of any printable type and yields void. Special-cased so a program
  // that prints does not trip "undeclared identifier 'print'". Each argument is
  // still checked so a type error inside it surfaces.
  if cfn.identName == "print" {
    const pargs = n.callArgs
    if pargs.length != 1 {
      tErr("print expects 1 argument, got " + i32ToStr(pargs.length), ix)
    }
    let pj = 0
    while pj < pargs.length {
      const pt = checkNode(pargs[pj])
      // `print` demands a value to render, and a `void` call has none — the emitter's
      // print ladder ends in `call __print_i32__` with nothing on the stack.
      voidValueSlotErr(pt, pargs[pj], "print", pargs[pj])
      // A domain rejection, asked first (the ruling): `print` takes one value of
      // `printDomainStr()`'s reps, and an array/struct/map/function value (bare, behind
      // `| null`, or inside a union) is not one — an ordinary domain error (`tErr`, no
      // code), not a capability admission, since the language never defined what such a print outputs (D711).
      if tyPrintsAsRef(pt, 24) {
        tErr(printRefRefusal(pt), pargs[pj])
      } else {
        // The BOXED value-union residue. `print(<i32 | string>)` now LOWERS — every arm
        // is inside the domain and the emitter dispatches on the box tag, the same
        // dispatch it performs for `is` (D712) — so what is left here is a box whose
        // arms that dispatch cannot classify, and only that keeps the concession.
        const puMsg = printUnionRefusal(pt)
        if puMsg != "" { tErrUnsupported(puMsg, pargs[pj]) }
      }
      // A printed type that still carries a HOLE answers FALSE to both floors above — it
      // is neither a ref nor a box YET — so the two of them together admit every generic
      // `print`. Defer it to the pin, the only position that knows the instance.
      // (`silent-class-inventory` D401; the recorder's header has the measurement.)
      notePrintCstr(pt, pargs[pj])
      pj = pj + 1
    }
    return TY_VOID
  }
  // `Map()` / `Set()` construct an empty string-keyed map: key/value HOLES (-1)
  // assignable to any map annotation (`const m: {[string]: i32} = Map()`).
  if cfn.identName == "Map" || cfn.identName == "Set" {
    if n.callArgs.length != 0 {
      tErr(cfn.identName + " expects no arguments", ix)
    }
    if callHasTyArgs(ix) { return collCtorTyArgsTy(cfn.identName, ix) }
    if cfn.identName == "Set" {
      // A set's VALUE type is the membership boolean; the element (key) is a
      // hole pinned by the annotation or the first `.add`.
      return mkMapTy(-1, TY_BOOL, 1)
    }
    return mkMapTy(-1, -1, 0)
  }
  // `toString(x)` resolves through the ordinary scope as `std:fmt`'s export now, and an
  // un-imported use gets the migration hint `undeclaredIdentMsg` appends.
  // `fromCodePoints(xs)` is a builtin: an `i32[]` of code points to a string, in one bulk
  // copy (the amortized alternative to per-char concat).
  if cfn.identName == "fromCodePoints" {
    const pargs = n.callArgs
    if pargs.length != 1 {
      tErr(
        "fromCodePoints expects 1 argument, got " + i32ToStr(pargs.length),
        ix,
      )
    } else {
      const p0 = checkNode(pargs[0])
      const p0t = T.tys[p0]
      let pOk = false
      if p0t is TyArray {
        // An empty `[]` literal's element hole (-1) pins to i32 here.
        if p0t.aElem < 0 || assignable(p0t.aElem, TY_I32) { pOk = true }
      }
      if p0t is TyErr { pOk = true }
      if !pOk {
        tErr("fromCodePoints expects an i32[], got " + tyToStr(p0), ix)
      }
    }
    return TY_STR
  }
  // `fromCodePoint(code)` is a builtin: an i32 code point -> a length-1 string.
  if cfn.identName == "fromCodePoint" {
    const fargs = n.callArgs
    if fargs.length != 1 {
      tErr(
        "fromCodePoint expects 1 argument, got " + i32ToStr(fargs.length),
        ix,
      )
    } else {
      const f0 = checkNode(fargs[0])
      if !assignable(f0, TY_I32) {
        tErr("fromCodePoint expects an i32, got " + tyToStr(f0), ix)
      }
    }
    return TY_STR
  }
  // `__str_from_bytes__(src, at, count)` (D4784): the bytes `src[at .. at + count]` as a fresh
  // string; the caller guarantees UTF-8. A builtin, not a declaration, so a call is no opaque
  // function value to the narrowing rule (`callDeclFnIx`).
  if cfn.identName == "__str_from_bytes__" {
    const sbArgs = n.callArgs
    if sbArgs.length != 3 {
      tErr(
        "__str_from_bytes__ expects 3 arguments, got " + i32ToStr(sbArgs.length),
        ix,
      )
      return TY_STR
    }
    const sbSrc = checkNode(sbArgs[0])
    if !assignable(sbSrc, mkArrayTy(TY_U8)) {
      tErr(
        "__str_from_bytes__ expects a u8[] source, got " + tyToStr(sbSrc),
        ix,
      )
    }
    let sbI = 1
    while sbI < 3 {
      const sbT = checkNode(sbArgs[sbI])
      if !assignable(sbT, TY_I32) {
        tErr("__str_from_bytes__ expects an i32 bound, got " + tyToStr(sbT), ix)
      }
      sbI = sbI + 1
    }
    return TY_STR
  }
  // The array-intrinsic floor (std-design D1 / collections-design §LS.2),
  // host parity: `defaultScope.ts`. `__array_new__(n, fill)` allocates `n`
  // slots each set to `fill`, typing as `T[]` with `T` = the fill's type.
  if cfn.identName == "__array_new__" {
    const anArgs = n.callArgs
    if anArgs.length != 2 {
      tErr(
        "__array_new__ expects 2 arguments, got " + i32ToStr(anArgs.length),
        ix,
      )
      return mkArrayTy(-1)
    }
    const anLen = checkNode(anArgs[0])
    if !assignable(anLen, TY_I32) {
      tErr("__array_new__ expects an i32 length, got " + tyToStr(anLen), ix)
    }
    return mkArrayTy(checkNode(anArgs[1]))
  }
  // `__array_new_default__(n)`: `n` zeroed/default slots. The element type is a hole (-1)
  // pinned by the destination — the empty-`[]` mechanism — and the emitter reads the same
  // pinned row back off this node (`arrNewDefaultKind`), so the two cannot disagree about
  // the rep. Two questions this arm cannot answer yet are recorded here and asked late (`arrDefCallIx`).
  if cfn.identName == "__array_new_default__" {
    const adArgs = n.callArgs
    if adArgs.length != 1 {
      tErr(
        "__array_new_default__ expects 1 argument, got " + i32ToStr(adArgs.length),
        ix,
      )
    } else {
      const adLen = checkNode(adArgs[0])
      if !assignable(adLen, TY_I32) {
        tErr(
          "__array_new_default__ expects an i32 length, got " + tyToStr(adLen),
          ix,
        )
      }
    }
    const adTy = mkArrayTy(-1)
    arrDefCallIx.push(ix)
    arrDefCallTy.push(adTy)
    return adTy
  }
  // `__array_copy__(dst, dstAt, src, srcAt, count)`: bulk-moves `count` elements from
  // `src[srcAt..]` into `dst[dstAt..]`; void. Both must be arrays; the element correlation
  // between them is deliberately not enforced here, matching the host's own leniency (a
  // mismatched pair fails loudly at the emit stage in both compilers).
  if cfn.identName == "__array_copy__" {
    const acArgs = n.callArgs
    if acArgs.length != 5 {
      tErr(
        "__array_copy__ expects 5 arguments, got " + i32ToStr(acArgs.length),
        ix,
      )
      return TY_VOID
    }
    let acI = 0
    while acI < 5 {
      const acT = checkNode(acArgs[acI])
      if acI == 0 || acI == 2 {
        const acTy = T.tys[acT]
        let acOk = false
        if acTy is TyArray { acOk = true }
        if acTy is TyErr { acOk = true }
        if !acOk {
          tErr("__array_copy__ expects a T[], got " + tyToStr(acT), ix)
        }
      } else {
        if !assignable(acT, TY_I32) {
          tErr("__array_copy__ expects an i32, got " + tyToStr(acT), ix)
        }
      }
      acI = acI + 1
    }
    return TY_VOID
  }
  // `__trap__()`: the deliberate abort primitive — lowered to `unreachable`.
  // `__trap__("reason")`: an OPTIONAL single string message, printed to the
  // host boundary (the print-of-string path) before the abort — so the trap
  // carries a human-readable reason. Either form still "never returns".
  if cfn.identName == "__trap__" {
    if n.callArgs.length > 1 {
      tErr("__trap__ takes an optional string message", ix)
    } else if n.callArgs.length == 1 {
      const trapMsgTy = checkNode(n.callArgs[0])
      if !assignable(trapMsgTy, TY_STR) {
        tErr(
          "__trap__ takes an optional string message, got " + tyToStr(trapMsgTy),
          ix,
        )
      }
    }
    return TY_NEVER
  }
  // The numeric-opcode intrinsics: each lowers to exactly one wasm instruction, so
  // the checker only has to type them. A user binding of the same name shadows the
  // intrinsic (`numIntrShadowed`), and the emitter gates on the same rule — the
  // intrinsic arm is a fallback for a name the program did not define itself.
  if !numIntrShadowed(cfn.identName) {
    const bcTy = bitcastCallTy(cfn.identName, n, ix)
    if bcTy >= 0 { return bcTy }
    const niTy = numIntrCallTy(cfn.identName, n, ix)
    if niTy >= 0 { return niTy }
  }
  -1
}

// The ordinary call: the callee evaluates to a function type, so the arguments are checked
// against its parameter list — named arguments reordered, an omitted trailing one filled
// from the declaration default, and type-parameter bindings solved from the argument types.
// Always answers; the caller's remaining arms cover an error or still-unsolved callee.
function checkCallOnFuncTy(n: Call, ix: i32, cfn: Node, ft: TyFunc): i32 {
  let args = n.callArgs
  // PENDING return (-2): the un-annotated callee hasn't been inferred yet (a
  // forward call). Demand-infer it now — check its FuncDecl, which patches this
  // very TyFunc in place — unless it is already on the in-progress stack (an
  // in-cycle call: contribute TY_ERR so the cycle can be detected at the root).
  if ft.fnRet == -2 {
    if cfn is Ident {
      if !onInferStack(cfn.identName) {
        const dIx = fnDeclIx[cfn.identName] ?? -1
        if dIx >= 0 { checkNode(dIx) }
      }
    }
  }
  let retTy = ft.fnRet
  if retTy == -2 {
    retTy = TY_ERR
    // A direct self-recursive call resolves to the function's own provisional inferred
    // type (`inferObserved`, already holding the base case since it is checked first) —
    // without this, `TY_ERR` makes `assignable(TY_ERR, string)` vacuously true and a `+`
    // over the recursive call pollutes the inferred return. Mutual recursion keeps `TY_ERR` for the fixpoint to settle.
    if cfn is Ident {
      if inferStack.length > 0 {
        if inferStack[inferStack.length - 1] == cfn.identName {
          if inferObserved >= 0 { retTy = inferObserved }
        }
      }
    }
  }
  const params = ft.fnParamTypes
  // Defaults are direct-call-site sugar: a call naming a declared function may omit
  // trailing arguments whose parameters carry a default, so the accepted arity is the
  // range [`fnRequiredArity`, `params.length`]. A call through a function value has no
  // declaration to read defaults from and keeps its exact-arity gate.
  const dParams = calleeDeclParams(n.callFn)
  // A rest parameter is the one thing that makes the accepted arity unbounded above, and the
  // pack below is what puts it back: after it the argument list is index-parallel with the
  // parameter list again, which is the invariant everything from here down is written around.
  let restIx = -1
  if dParams.length == params.length { restIx = restParamIndex(dParams) }
  if restIx >= 0 {
    if !callIsRestPacked(ix) {
      const lo = restRequiredArity(dParams, restIx)
      if args.length < lo {
        tErr(
          "wrong number of arguments: expected at least "
            + i32ToStr(lo)
            + ", got "
            + i32ToStr(args.length),
          ix,
        )
        return retTy
      }
      if !restCallPack(n, ix, restIx) { return retTy }
    }
    args = n.callArgs
    // Written type arguments already say what the element is, which is the refusal's remedy.
    if restIx < args.length && !callHasTyArgs(ix) {
      if restHoleUnionErr(params[restIx], args[restIx], ix) { return retTy }
    }
  } else if hasSpreadItem(args) {
    tErr(spreadNoRestMsg(calleeIdentName(cfn)), ix)
    return retTy
  }
  let required = params.length
  if dParams.length == params.length { required = fnRequiredArity(dParams) }
  if args.length < required || args.length > params.length {
    tErr(
      "wrong number of arguments: expected "
        + arityWantText(required, params.length)
        + ", got "
        + i32ToStr(args.length)
        + tyArgReadHintIfAny(args)
        + ovPlainHint(ix),
      ix,
    )
    return retTy
  }
  // Named arguments bind to parameters by name, then positionally — source order is
  // irrelevant for named args. `TyFunc` carries no parameter names, so the names resolve
  // against the declaration the scope chain gives this callee; a closure-valued binding has
  // none and cannot take named arguments, whatever a same-named declaration says (D1604).
  if hasNamedArgs(n.callArgNames) {
    const cNames = paramNamesOfNodes(dParams)
    if cNames.length != params.length {
      tErr(
        "named arguments work only on declared functions, not on a function value",
        ix,
      )
      return retTy
    }
    args = orderNamedCallArgs(cNames, args, n.callArgNames, ix, dParams)
    if args.length != params.length { return retTy }
  } else if args.length < params.length {
    // Trailing positional omission: check the defaults against their
    // parameters alongside the supplied arguments, so one loop below covers
    // the whole parameter list. (`args` is rebound to a COPY — `n.callArgs`
    // stays the source list; the emit-side normalization is `emit_rewrite`'s.)
    const padded: i32[] = []
    let pj = 0
    while pj < params.length {
      if pj < args.length { padded.push(args[pj]) } else { padded.push(-1) }
      pj = pj + 1
    }
    if fillArgDefaults(padded, dParams, ix) >= 0 { return retTy }
    args = padded
  }
  // Generic call-site inference: a `TyVar` param (or `T[]`) binds its type-param to
  // the argument's type (first use wins; later uses must agree), and the return
  // type substitutes through the binding — so `id("s")` is `string`, and
  // `let n: i32 = id("s")` is a genuine type error downstream.
  const bNames: string[] = []
  const bTys: i32[] = []
  const uNames: string[] = []
  const uTys: i32[] = []
  // Explicit type arguments bind first, so every argument is checked against them.
  const explicitTa = callHasTyArgs(ix)
  if explicitTa {
    if !bindExplicitTyArgs(cfn, ix, bNames, bTys) { return TY_ERR }
  }
  let dstNames = NO_DST_NAMES
  if !explicitTa && callDstTyOf(ix) >= 0 {
    dstNames = []
    dstBindLitTyParams(ix, ft.fnRet, params, args, bNames, bTys, dstNames)
  }
  const argOrder = lambdaLastOrder(params, args)
  // Each argument's destination as its own turn saw it, for the literals re-delivered below.
  const argExp: i32[] = []
  while argExp.length < args.length { argExp.push(-1) }
  let oi = 0
  while oi < argOrder.length {
    const i = argOrder[oi]
    // Contextual param inference for a function-value argument: propagates the expected
    // param type into it so an un-annotated literal param infers from the signature
    // (matching `.map`/`.filter`), substituting type-param bindings from earlier arguments
    // first — `mapArr(xs: T[], f: (T) => R)` called with `[1,2,3]` binds `T = i32` before seeding `f`'s param as `i32`.
    seedExpected(args[i], substTyDeep(params[i], bNames, bTys))
    if tpEnvNames.length > 0 { tpIfMarkOk(args[i]) }
    const at = checkNode(args[i])
    // A template hole meeting its injected renderer. This line is the first
    // moment the hole's type exists, which is why the type-directed half of
    // the template lowering lives here and not in the parser's desugar.
    if nodeIsTplHole(args[i]) {
      if tplHoleHandled(ix, n.pos, args[i], at, params[i]) { return TY_STR }
    }
    // A void argument would bind a type parameter to `void`, which no instance can carry; a
    // concrete parameter already refuses it through `assignable`, with its own message.
    if tyHasTyVar(params[i]) || tyIsHole(params[i]) {
      if isVoidTy(at) && !voidSlotExemptExpr(args[i]) {
        tErr(
          "argument " + i32ToStr(i + 1) + " expects a value, got void",
          args[i],
        )
        return TY_ERR
      }
    }
    // Bind every TyVar reachable in the expected param position from the
    // argument's shape (first use wins), then check the argument against the
    // SUBSTITUTED expected type — a later disagreeing use errors here.
    bindGenWalk(params[i], at, bNames, bTys)
    bindGenUnionArm(params[i], at, uNames, uTys)
    const expected = substTyDeep(params[i], bNames, bTys)
    argExp[i] = expected
    // A `u8[]` argument meeting a generic parameter: `bindGenWalk` above declined to bind
    // `T` to storage type `u8`, so `expected` still carries the unsolved hole and
    // `assignable` answers true vacuously — needing its own message here, or the
    // monomorphizer builds i32-list machinery over a one-byte backing. `u8[]` is not an instantiation of `T[]`, since `T` ranges over value types and `u8` is storage.
    if !inferQuiet {
      if tyIsU8ArrayTy(at) && tyReachesHole(expected, 8) {
        tErr(
          "`u8[]` cannot be passed to a generic parameter — `u8` is a storage type, so a type parameter never binds it and a `u8[]` is not a `T[]`",
          args[i],
        )
      }
    }
    // A hole or deferred-join argument passes `assignable` vacuously, so the demand is
    // recorded here and re-validated at the generic call site that pins it under the
    // substituted argument types — without this, `function f(x) { g(x) }` with `g(n: i32)`
    // type-checks `f("s")` clean and dies at wasm validation. Recorded on the argument's uncollapsed type, since a join's collapsed arm can later prove unreachable.
    let atCstr = inferRetTyOf(args[i], at)
    if coalDefHole.length > 0 { atCstr = coalPinTy(args[i], atCstr) }
    if (
      tyIsHole(atCstr)
      || tyIsDeferredJoin(atCstr)
      || (atCstr >= 0
        && atCstr < T.tys.length
        && T.tys[atCstr] is TyUnion
        && tpGradualView(atCstr) != atCstr)
    ) {
      if !tyIsHole(expected) {
        let ccWho = ""
        if cfn is Ident { ccWho = cfn.identName }
        let acForm = ACF_PLAIN
        if nodeIsTplHole(args[i]) { acForm = ACF_TPL }
        noteArgCstr(atCstr, expected, ccWho, acForm, -1)
      }
    } else if compArgCstrOk(atCstr, expected) {
      let cpWho = ""
      if cfn is Ident { cpWho = cfn.identName }
      noteArgCstr(atCstr, expected, cpWho, ACF_COMP, args[i])
    }
    // A hole param whose body DEMANDED fields (member access on the hole)
    // checks the argument against the demanded shape, so `getx(5)` rejects
    // when the body read `o.x` (host: the grown `Infer<{x,…}>` pin).
    const pHole = T.tys[params[i]]
    if pHole is TyVar {
      noteHoleArgNullRead(pHole.tvName, at, args[i])
      if !holeDemandOk(pHole.tvName, args[i], at) {
        holeArgDemandErr(pHole.tvName, i + 1, at, args[i])
      }
      // A hole the body INDEXED (`self[i]`) demands an array — a scalar argument can't be
      // indexed, so reject it here (`head(5)`) instead of deferring to an emit failure.
      if rowIsArrayDemanded(params[i]) {
        if tyRefusesArrayDemand(at) { holeArgArrayErr(i + 1, at, args[i]) }
        // An enclosing type parameter passed in takes the demand to its own pin.
        if at >= 0 && T.tys[at] is TyVar { noteArrayDemand(arrayDemandKey(at)) }
      }
      if holeIsArrayWriteDemanded(calleeIdentName(cfn), pHole.tvName) {
        if tyIxIsView(at) { holeArgViewErr(i + 1, at, args[i]) }
      }
      // The `as` cast the body parked on this hole, re-asked under the argument. D1342.
      holeCastPinCheck(
        pHole.tvName,
        at,
        holeCastParamName(n.callFn, dParams, i, pHole.tvName),
      )
    }
    // The cast this argument itself is (`id(a as? i32)`), whose destination the pin has to
    // re-ask (D1371) — but only when the parameter is not a hole: for a hole parameter,
    // `expected` is the pre-pin answer rather than a declared demand, and holding the cast to it would refuse a program whose annotated twin runs.
    if !tyIsHole(params[i]) { noteCastArgDest(args[i], i + 1, expected) }
    // Passing an empty-collection argument into a concrete `T[]` / map param pins
    // its element type from the param (`len(empty)` resolves `empty` to `i32[]`),
    // clearing its uninferred floor — pure downstream-usage inference, no push.
    constrainEmptyExpr(args[i], at, expected)
    const savedGenArg = widenRetagGenArg
    widenRetagGenArgSet(tyWideUnionMinted && tyHasTyVar(params[i]))
    const savedLbiGen = lbiNoDest
    lbiNoDest = tyHasTyVar(params[i])
    // A wider record into a declared record parameter: a parameter already made generic is
    // still held to its declared type, and a new one is made generic after this pass (D3992).
    const wsOrig = wsOrigTyOf(n, i)
    if wsOrig >= 0 && i < args.length && args[i] >= 0 && !tyHasTyVar(at) {
      wsSuppress = true
      const savedOrigLit = argLitAt
      argLitAt = peelParenIx(args[i])
      const wsOk = assignableExpr(args[i], at, wsOrig)
      argLitAt = savedOrigLit
      wsSuppress = false
      if !wsOk { argMismatchErr(i + 1, wsOrig, at, args[i]) }
    }
    const wsNew = wsOrig < 0
      && !inferQuiet
      && i < args.length
      && wsCandidate(n, i, args[i], at, expected)
    if wsNew { wsNotePending(n, i) }
    wsSuppress = wsNew
    const savedArgLit = argLitAt
    argLitAt = peelParenIx(args[i])
    const argOk = assignableExpr(args[i], at, expected)
    argLitAt = savedArgLit
    wsSuppress = false
    lbiNoDest = savedLbiGen
    widenRetagGenArgSet(savedGenArg)
    if !argOk {
      // Anchored at the offending argument (or its offending return site),
      // never at the call node — see `argMismatchErr`.
      argMismatchErr(i + 1, expected, at, args[i])
    } else if !tyIsHole(params[i]) {
      // It passed, and for a hole-bearing argument that means nothing: a hole is assignable
      // to anything, so a concrete parameter's comparison is answered before the deciding
      // type exists. Parked here and re-asked as the hole takes a pin (D1821).
      if tyHasTyVar(at) && tyIsFuncArena(expected) {
        if !argIsOwnGenericFnValue(args[i]) {
          argPinPark(expected, at, args[i], i + 1)
        }
      }
    }
    oi = oi + 1
  }
  // A list or record literal holding a generic function, met before a later argument bound the
  // type parameter its element type rides, is delivered again at the bound type (D3923).
  if !inferQuiet {
    let li = 0
    while li < args.length && li < params.length {
      if (
        argExp[li] >= 0
        && tyHasTyVar(argExp[li])
        && argIsLitAggregate(args[li])
      ) {
        const fin = substTyDeep(params[li], bNames, bTys)
        if fin != argExp[li] {
          genFnValueCstrs(args[li], nodeTyOf(args[li]), fin)
        }
      }
      li = li + 1
    }
  }
  if dstNames.length > 0 && !inferQuiet {
    dstRetypeLitArgs(dstNames, params, args, bNames, bTys)
  }
  // After the arguments, so a mismatched argument gets the more specific diagnostic first;
  // the answer itself is the callee's declaration, not this site's bindings.
  if cfn is Ident {
    let rtpDecl = fnDeclIx[cfn.identName] ?? CSTR_NODECL
    if rtpDecl == CSTR_NODECL { rtpDecl = lookupFnAliasNode(cfn.identName) }
    if !explicitTa {
      checkRetTyParamBound(rtpDecl, cfn.identName, ix, ft.fnRet)
    }
  }
  // Substitutes the binding into a generic return type — deep, so a structural return
  // (`{first: B, second: A}`, a generic alias body, a function-typed field) concretizes
  // per call site; a derived `?ret.` hole collapses to the pinned callee's return
  // (`substTyDeep`).
  const vNames: string[] = []
  const vTys: i32[] = []
  withUnionArmBinds(bNames, bTys, uNames, uTys, vNames, vTys)
  if vNames.length > 0 {
    const dBeforeC = T.diags.length
    let cstrCallee = CSTR_NODECL
    let cstrWho = ""
    if cfn is Ident {
      cstrCallee = fnDeclIx[cfn.identName] ?? CSTR_NODECL
      // A local bound to a declared generic names that declaration — without this rung the
      // call falls to `CSTR_NODECL` and adjudicates every generic in the program, since
      // `substTyDeep` matches `TyVar`s by name and `const g = idT  g(structList)` would
      // otherwise report a sibling's refusal.
      if cstrCallee == CSTR_NODECL {
        const aliasIx = lookupFnAliasNode(cfn.identName)
        if aliasIx >= 0 { cstrCallee = aliasIx }
      }
      cstrWho = cfn.identName
    }
    // The direct spelling has no receiver, so every parameter is an argument (`selfOff` 0)
    // and `params`/`args` are already 1:1 (named arguments reordered, defaults padded).
    const dhNames: string[] = []
    const dhArgNo: i32[] = []
    const dhArgNode: i32[] = []
    holeArgOrigins(params, args, 0, dhNames, dhArgNo, dhArgNode)
    const modeWas = substNestMode
    const declWas = substNestDecl
    let nestCallee = -1
    if cfn is Ident {
      // The declaration the callee names, directly or through an alias.
      nestCallee = lookupFnDeclNode(cfn.identName)
      if nestCallee < 0 { nestCallee = lookupFnAliasNode(cfn.identName) }
      if !nestParentOf.has(nestCallee) { nestCallee = -1 }
    }
    if nestCallee >= 0 {
      // A nested generic, named directly or through an alias, owns no constraint: they are its
      // enclosing function's, and a top-level function of the same name is another declaration.
      cstrCallee = CSTR_NODECL
      substNestModeSet(SUBST_NESTED)
      substNestDeclSet(nestCallee)
    } else if cstrCallee >= 0 {
      substNestModeSet(SUBST_DECLARED)
    } else if namesAllHoles(vNames) && tysHoldVar(vTys) {
      substNestModeSet(SUBST_HOLES)
    } else {
      substNestModeSet(SUBST_ALL)
    }
    const wsVd = T.diags.length
    instGenFnHolePins(vNames, vTys, cstrCallee, dhNames, dhArgNode)
    callBindNote(ix, vNames, vTys)
    pinBmCstrElems(vNames, vTys, ix, cstrCallee, args)
    if fsbName.length > 0 {
      fsbNoteCall(
        ix,
        fsbDeclAtNode(n.callFn),
        cstrCallee,
        cstrWho,
        dhNames,
        dhArgNo,
        dhArgNode,
        fsbArgTysOf(ft, vNames, vTys),
      )
    }
    validateBinCstrs(
      vNames,
      vTys,
      ix,
      cstrCallee,
      cstrWho,
      dhNames,
      dhArgNo,
      dhArgNode,
    )
    validatePrintCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
    validateNestCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
    validateIsCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
    validateArgCstrs(vNames, vTys, ix, cstrCallee, dhNames, dhArgNode)
    // The declared return rides the same pin: the body's mismatch check is vacuous under
    // a hole, and this is the first position that knows the instance (D551).
    validateRetCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
    // The destination seam, for the same reason: a value landing in a hole-typed local /
    // field / element inside the body is a mismatch the body's own gate cannot decide (D572).
    validateLetCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
    // A builtin collection method's argument inside the body, for the same reason at a
    // callee kind the deferred-argument table cannot name: a builtin has no `FuncDecl`, so its own arm is the whole check and is vacuous under a hole (D582).
    validateBmCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
    // After the pins above, which can leave an argument's element open (`cnhPinBmElem`).
    if !inferQuiet {
      let oa = 0
      while oa < args.length {
        refuseOpenNullHoleArg(args[oa], cstrWho)
        oa = oa + 1
      }
    }
    // The receiver classification of a `.length` / `x[i]` inside the body: both arms admit
    // the operation on a type variable correctly (a `T` pinned to a collection has it), and
    // this is the first position that knows which rep `T` became (D651 / D691).
    validateMemCstrs(
      vNames,
      vTys,
      ix,
      cstrCallee,
      cstrWho,
      dhNames,
      dhArgNo,
      dhArgNode,
    )
    validateUfcsCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
    validateRcwPins(vNames, vTys, cstrCallee)
    if T.diags.length > wsVd { wsNoteInstErr(cstrCallee) }
    substNestModeSet(modeWas)
    substNestDeclSet(declWas)
    // Not a validation: the `??` result holes are substituted here for their BANK, which is
    // the only route the emitter has to the type this call gave the expression (D1702).
    if bNames.length > 0 { bankCoalHoles(bNames, bTys, cstrCallee) }
    // The bounds the callee declared, judged here in this site's own scope against the
    // types this site bound — not deferred, since a bound is written at the declaration:
    // there is nothing to record on the way in, only something to check on the way out.
    checkBoundsAtCall(cstrWho, cstrCallee, bNames, bTys, ix)
    // The escaped-join reject is a fallback, not an additional voice: when this site
    // already reported a precise operand/argument-flow diagnostic, a join report would only repeat it in vaguer words.
    if T.diags.length == dBeforeC && bNames.length > 0 {
      validateEscJoins(bNames, bTys, cstrCallee)
    }
    retTy = substTyDeep(retTy, vNames, vTys)
    if tpIfFn.length > 0 || tpIfReFn.length > 0 {
      const pinTys: i32[] = []
      let pp = 0
      while pp < params.length {
        pinTys.push(substTyDeep(params[pp], vNames, vTys))
        pp = pp + 1
      }
      validateTpIfJoins(vNames, vTys, pinTys, retTy, ix, cstrCallee)
    }
  }
  // A deferred join this site cannot decide has no rep, so it collapses to one arm, parked
  // whole for a `return h(w)` relay (`inferRetTyOf`); in a body the gate does not hold, one of
  // that body's own parameters is kept as a union instead, which its pins re-join (D3589).
  let kept = -1
  if tyIsDeferredJoin(retTy) && !njFnReached(njFnIx) {
    const keep = (apartHoleJoins.get(retTy) ?? false) || calleeRetDeclared(cfn)
    kept = keptParamUnion(retTy, keep)
  }
  let cRetTy = kept
  if kept < 0 { cRetTy = collapseDeferredJoin(retTy) }
  if cRetTy != retTy {
    noteDeferredJoinNode(ix, retTy)
    let ejWho = ""
    if cfn is Ident { ejWho = cfn.identName }
    if kept < 0 { noteEscJoin(retTy, ix, ejWho) }
  }
  return cRetTy
}

// Binds each type parameter of the generic return `ret` from the type the call's destination
// expects, when every argument that would bind it is a literal adapting to that type, so
// `const hs: f32[] = filled(4, 0.0)` is `filled<f32>` as an annotated literal is an `f32` (D3539).
function dstBindLitTyParams(
  ix: i32,
  ret: i32,
  params: i32[],
  args: i32[],
  bNames: string[],
  bTys: i32[],
  outNames: string[],
) {
  const dst = dstForArgs(callDstTyOf(ix), args, ret)
  if dst < 0 || ret < 0 || !anyArgIsLitOnly(args) || !tyHasTyVar(ret) {
    return 0
  }
  const dN: string[] = []
  const dT: i32[] = []
  bindGenWalk(ret, dst, dN, dT)
  let k = 0
  while k < dN.length {
    if bindOf(bNames, bTys, dN[k]) < 0 {
      if prbArmed { prbEnter() }
      const adapts = dstTyParamAdapts(dN[k], dT[k], params, args, ix, ret, dst)
      if prbArmed { prbLeave("dstTyParamAdapts") }
      if adapts {
        bNames.push(dN[k])
        bTys.push(dT[k])
        outNames.push(dN[k])
        // The annotation chose the instance, so it is not redundant (D1442).
        cbSeedUsedSet(cbSeedUsed + 1)
      }
    }
    k = k + 1
  }
  0
}

// Whether the destination's `cand` for type parameter `name` replaces the arguments' binding at
// call `ix`: always for a bare `null` beside arguments `cand` holds; for a literal union only
// when every argument is a literal member of it; otherwise when every argument is a
// literal `cand` holds in its kind and the arguments' own instance cannot reach `dst` (D4024).
function dstTyParamAdapts(
  name: string,
  cand: i32,
  params: i32[],
  args: i32[],
  ix: i32,
  ret: i32,
  dst: i32,
): boolean {
  if (
    cand < 0
    || cand == TY_ERR
    || isVoidTy(cand)
    || tyHasTyVar(cand)
    || dstTyOpen(cand)
  ) {
    return false
  }
  // A body computing on `T` can leave a literal union (D3602), so only literal members of it
  // choose one.
  const litU = tyIsLitUnionLike(cand, 4)
  if litU {
    if litUnionOneBase(cand, 4) < 0 { return false }
    const cn = P.nodes[ix]
    if cn is Call {
      if !genericBodyClosed(callGenericDeclIx(cn), 0) { return false }
    } else {
      return false
    }
  }
  const one: string[] = [name]
  const oneT: i32[] = [cand]
  let seen = 0
  let own = -1
  let nulls = 0
  const others: i32[] = []
  let i = 0
  while i < params.length {
    if tyMentionsTyVarNamed(params[i], name, 8) {
      if i >= args.length || args[i] < 0 { return false }
      const want = substTyDeep(params[i], one, oneT)
      if argIsNullLit(args[i]) {
        // A bare `null` binds `T` to the null type (DV-402).
        if !assignable(TY_NULL, want) { return false }
        nulls = nulls + 1
        seen = seen + 1
        if own < 0 { own = TY_NULL }
        i = i + 1
        continue
      }
      if litU {
        const lt = litTyOfExpr(parenPeelIx(args[i]))
        if lt < 0 || !assignable(lt, want) { return false }
        seen = seen + 1
        if own < 0 { own = widenLitTy(lt) }
        i = i + 1
        continue
      }
      if !argIsLitOnly(args[i], 4) {
        others.push(i)
        i = i + 1
        continue
      }
      const x = parenPeelIx(args[i])
      if x < 0 || x >= P.nodes.length { return false }
      const isCall = P.nodes[x] is Call
      const savedQ = inferQuiet
      let at = -1
      if isCall {
        // A nested call is asked twice, speculatively: what it binds on its own, and whether the
        // destination's type, delivered to it in turn, is what it then answers.
        inferQuiet = true
        setCallDstTy(x, -1)
        at = checkNode(args[i])
        setCallDstTy(x, want)
        inferQuiet = savedQ
      } else {
        at = checkNode(args[i])
      }
      const aN: string[] = []
      const aT: i32[] = []
      bindGenWalk(params[i], at, aN, aT)
      if own < 0 { own = bindOf(aN, aT, name) }
      // Within the literal's kind only: an integer literal never makes `T` a float (B′).
      const wk = numKindMask(want, 8)
      if wk == 0 || (wk & ~numKindMask(at, 8)) != 0 { return false }
      inferQuiet = true
      if isCall { at = checkNode(args[i]) }
      const ok = at >= 0 && assignableExpr(args[i], at, want)
      inferQuiet = savedQ
      if !ok { return false }
      seen = seen + 1
    }
    i = i + 1
  }
  // A non-literal argument goes along only beside a `null`, and only one the binding holds.
  if others.length > 0 {
    if nulls == 0 { return false }
    for oi in others {
      const want = substTyDeep(params[oi], one, oneT)
      const savedQ = inferQuiet
      inferQuiet = true
      let at = nodeTyIxOf(args[oi])
      if at < 0 { at = checkNode(args[oi]) }
      const ok = at >= 0 && assignable(at, want)
      inferQuiet = savedQ
      if !ok { return false }
    }
    return true
  }
  if seen == 0 || own < 0 || tySame(own, cand) { return false }
  if nulls > 0 || litU { return true }
  // Only where the arguments' own instance cannot be delivered: anywhere it can, that instance
  // is the program's, and a body doing arithmetic on `T` must keep computing at it.
  const savedQ2 = inferQuiet
  inferQuiet = true
  const one2: string[] = [name]
  const own2: i32[] = [own]
  const ownRet = substTyDeep(ret, one2, own2)
  // `assignable` alone admits a list into a wider-element list; the delivery refuses that.
  const deliverable = assignable(ownRet, dst)
    && !objShapeAdapterlessAt(ix, ownRet, dst)
  inferQuiet = savedQ2
  !deliverable
}

// `p?.f(args)` — one guard over the receiver covers the whole call, so the callee and the
// arguments resolve against the receiver's non-null type and the result is that call's own
// return re-wrapped nullable. `-1` when no arm claimed the callee, leaving the caller's
// "called value is not a function" to speak (D1814).
function checkOptCallNode(n: Call, ix: i32, cfn: OptMember): i32 {
  omGuardSet(-1, -1)
  const recv = checkNode(cfn.omObj)
  if recv < 0 { return TY_ERR }
  const eff = omRecvTy(cfn.omObj, recv)
  if eff < 0 { return TY_ERR }
  // A `.` that inherited the chain's guard may not re-guard: same rule, same words, as the
  // member link's.
  if cfn.omDot {
    const de = T.tys[eff]
    if de is TyNullable {
      memberFloorErr(eff, cfn.omProp, ix)
      return TY_ERR
    }
  }
  const rcv = T.tys[recv]
  let wasNullable = false
  if rcv is TyNullable { wasNullable = true }
  const base = nonNullTy(eff)
  if base < 0 { return TY_ERR }
  let rt = checkMemberCallNode(n, ix, cfn.omObj, cfn.omProp, base)
  if rt < 0 {
    // No method arm claimed it: the callee is a VALUE on the receiver — a closure-typed
    // field. Its guarded type is the field's own function type, which is what the call
    // needs; the `?.` node's type is that same function behind a `| null`.
    const fnTy = checkNode(n.callFn)
    const g = omGuardTyAt(n.callFn)
    let cft = fnTy
    if g >= 0 { cft = g }
    if cft < 0 { return TY_ERR }
    const ft = T.tys[cft]
    if ft is TyErr { return TY_ERR }
    if !(ft is TyFunc) { return -1 }
    rt = checkCallOnFuncTy(n, ix, cfn, ft)
    if rt < 0 { return -1 }
  }
  omGuardSet(ix, rt)
  if rt == TY_VOID {
    noteOptCallRet(ix, rt, "")
    return TY_VOID
  }
  if wasNullable {
    const ort = mkNullableTy(rt)
    noteOptCallRet(ix, rt, valueUnionRetName(ort))
    return ort
  }
  noteOptCallRet(ix, rt, "")
  rt
}

// A call expression, dispatched on the callee's shape: a member callee to
// `checkMemberCallNode`, a bare identifier to `checkUnimplementedIntrinsicCall` and
// `checkBuiltinIdentCall`, a function-typed value to `checkCallOnFuncTy`. The type-answering
// three return `-1` for "no arm claimed it"; an unclaimed callee is reported here as `TY_ERR`.
function checkCallNode(n: Call, ix: i32) {
  const cfn = P.nodes[n.callFn]
  if callHasTyArgs(ix) {
    if !callTyArgsCalleeOk(cfn, ix) { return TY_ERR }
  }
  if cfn is Member {
    const mt = checkMemberCallNode(n, ix, cfn.memObj, cfn.memProp, -1)
    if mt >= 0 { return mt }
  }
  // `p?.f(args)` — the receiver's guard covers the whole call. Answered before the callee is
  // typed as a value, which is what read a nullable closure field as "not a function" (D1814).
  if cfn is OptMember {
    const ot = checkOptCallNode(n, ix, cfn)
    if ot >= 0 { return ot }
  }
  // A built-in call below answers without checking its callee, so the callee's binding is
  // recorded here, before any of them.
  if cfn is Ident { identNoteUse(n.callFn, cfn.identName) }
  if cfn is Ident {
    checkUnimplementedIntrinsicCall(cfn, ix)
    if cfn.identName == "__memory_shared__" && lookupDepth(cfn.identName) == 0 {
      memSharedCalls.push(ix)
    }
  }
  if cfn is Ident {
    if nameIsSimdIntrinsic(cfn.identName) { v128SeenSet(true) }
    checkSimdLaneArg(n, cfn)
  }
  if cfn is Ident {
    const mo = checkMemOffsetCall(n, cfn)
    if mo >= 0 { return mo }
  }
  if cfn is Ident {
    const bt = checkBuiltinIdentCall(n, ix, cfn)
    if bt >= 0 { return bt }
    if foreignLenCall(n, cfn) { return TY_ERR }
  }
  const savedCallee = ckCalleeIx
  ckCalleeIxSet(n.callFn)
  const fnTy = checkNode(n.callFn)
  ckCalleeIxSet(savedCallee)
  const ft = T.tys[fnTy]
  if ft is TyFunc { return checkCallOnFuncTy(n, ix, cfn, ft) }
  if ft is TyErr {
    // A module global called above its declaration, which the hoist could not type: its
    // arguments are still checked on their own, as a hole callee's are (D3899).
    if cfn is Ident && globalBeforeDecl(cfn.identName) {
      for ga in n.callArgs { checkNode(ga) }
    }
    return TY_ERR
  }
  if ft is TyVar {
    // Calling an inference-hole value — an un-annotated parameter used as a function inside
    // its own generic body (`function apply(fn, a, b) { fn(a, b) }`): the arguments are
    // checked on their own and the call yields a fresh hole, resolved once an outer call
    // binds the generic signature (the emitter compiles each instance concretely).
    const hargs = n.callArgs
    let hWho = ""
    if cfn is Ident { hWho = cfn.identName }
    let hj = 0
    while hj < hargs.length {
      const hat = checkNode(hargs[hj])
      // What the pinned function takes here, demanded of the argument at the pin (D3225).
      const hexp = mkDerivedHole(HD_PARAM, i32ToStr(hj), hj, -1, fnTy)
      if hat >= 0 && hexp >= 0 {
        noteArgCstr(hat, hexp, hWho, hj + 1, hargs[hj])
      }
      hj = hj + 1
    }
    if tyIsNonNullHoleRead(fnTy) {
      noteMemCstr(fnTy, OP_CALL_GUARDED_PIN, ix, false)
    } else {
      noteMemCstr(fnTy, OP_CALL_PIN, ix, false)
    }
    return mkDerivedHole(HD_RET, "", -1, -1, fnTy)
  }
  // `v.d()` over a getter reads `v.d` and calls the result: say which getter it read.
  let calledGetter = getSiteFnOf(n.callFn)
  if calledGetter == "" && cfn is Member {
    calledGetter = getterFnFor(checkNode(cfn.memObj), cfn.memProp)
  }
  if calledGetter != "" {
    tErr(
      "called value is not a function ("
        + tyToStr(fnTy)
        + ") — `."
        + getDeclPropOf(calledGetter)
        + "` reads the "
        + getDeclLabel(calledGetter)
        + "; drop the `()`",
      ix,
    )
    return TY_ERR
  }
  const shadow = builtinShadowMsg(n.callFn, fnTy)
  if shadow != "" {
    tErr(shadow, ix)
    return TY_ERR
  }
  tErr("called value is not a function (" + tyToStr(fnTy) + ")", ix)
  TY_ERR
}

// `len(x)` with no `len` in scope: refused at the callee with the VL spelling, `x.length`.
// True when it raised. A program that declares or imports its own `len` never reaches it.
function foreignLenCall(n: Call, cfn: Ident): boolean {
  if cfn.identName != "len" || n.callArgs.length != 1 { return false }
  if lookup("len") >= 0 { return false }
  const at = strLitRecvTy(checkNode(n.callArgs[0]))
  if !strListHas(builtinMethodNamesOf(at), "length") {
    tErr("undeclared identifier 'len'", n.callFn)
    return true
  }
  const recv = placeKeyOf(n.callArgs[0])
  let fix = "'.length'"
  if recv != "" { fix = "'" + recv + ".length'" }
  tErr(
    "undeclared identifier 'len' — a length is a member in VL; did you mean "
      + fix
      + "?",
    n.callFn,
  )
  true
}

// Checks each value a tail `if`/`else` (or the chain a `match` desugared to) yields against
// the declared return `ret`, at the arm that yields it — the check the bare tail expression
// gets. An arm that exits, yields no value or already failed is left to its own rule (D2234).
function checkTailArmsAgainst(ix: i32, ret: i32) {
  const leaves: i32[] = []
  tailValueLeaves(ix, leaves)
  let i = 0
  while i < leaves.length {
    const lf = leaves[i]
    i = i + 1
    const lt = nodeTyOf(lf)
    if lt >= 0 && lt != TY_ERR && lt != TY_NEVER && !isVoidTy(lt) {
      if !isStmtNode(lf) && !stmtAlwaysExits(lf) {
        if !assignableExpr(lf, lt, ret) {
          tErrWant(
            "expected "
              + tyToStr(ret)
              + ", got "
              + tyToStr(lt)
              + boolForNumberNote(lt, ret)
              + numUnionLossNote(lt, ret)
              + storageListNote(lf, lt, ret),
            lf,
            ret,
          )
        } else {
          noteRetCstr(coalPinTy(lf, lt), ret, lf)
        }
      }
    }
  }
  0
}

// Demand-infer one top-level function's return, but only if still pending (the
// memoization guard already short-circuits a resolved one; the fixpoint resets to
// pending first to force a fresh re-inference once neighbours have settled).
function preInferOne(dIx: i32) {
  const dn = P.nodes[dIx]
  if dn is FuncDecl {
    const h = lookup(dn.fnName)
    let pending = true
    if h >= 0 {
      const ht = T.tys[h]
      if ht is TyFunc {
        if ht.fnRet != -2 { pending = false }
      }
    }
    if pending { checkFuncDeclNode(dn, dIx) }
  }
  0
}

// The return-inference pre-pass: resolves every un-annotated return with diagnostics, symbol
// recording and the redundant-type stream suppressed, so the real check pass runs against
// final return types. Non-cycle functions resolve in the first demand sweep; cycle-poisoned
// ones iterate to a fixpoint until the tentative set stops shrinking, and what remains is genuinely base-case-less.
function inferReturnsPrePass() {
  if topUnannotFns.length == 0 { return 0 }
  if prbArmed { prbEnter() }
  inferQuiet = true
  const m = checkMark()
  const savedSym = symEnabled
  symEnabled = 0
  let i = 0
  while i < topUnannotFns.length {
    preInferOne(topUnannotFns[i])
    i = i + 1
  }
  let shrinking = true
  let rounds = 0
  while shrinking && rounds < 2000 {
    rounds = rounds + 1
    const work = inferTentativeTake()
    let r = 0
    while r < work.length {
      resetReturnPending(work[r])
      r = r + 1
    }
    let q = 0
    while q < work.length {
      const dIx = fnDeclIx[work[q]] ?? -1
      if dIx >= 0 { preInferOne(dIx) }
      q = q + 1
    }
    if inferTentative.length >= work.length { shrinking = false }
  }
  unresolvedFnsSet([])
  let u = 0
  while u < inferTentative.length {
    unresolvedFns.push(inferTentative[u])
    u = u + 1
  }
  symEnabled = savedSym
  if prbSkip == 1 {
    checkRollback(m, RB_LINT)
  } else {
    checkRollback(m, RB_RETURNS)
  }
  inferQuiet = false
  if prbArmed { prbLeave("inferReturnsPrePass") }
  0
}

// Pass 1.65: types each un-annotated module global the hoist left a placeholder, by quietly
// checking its initializer at module scope, so a body checked before pass 2 reaches the
// declaration reads the global's real type (D3078). A lambda, or an initializer that raises a
// diagnostic or yields a hole, `null`, `void` or `never`, keeps the placeholder for pass 2.
function globalInitPrePass(lets: i32[]) {
  if lets.length == 0 { return 0 }
  if prbArmed { prbEnter() }
  const savedQuiet = inferQuiet
  const savedSym = symEnabled
  const m = checkMark()
  inferQuiet = true
  symEnabled = 0
  for li in lets {
    const ln = P.nodes[li]
    // A lambda with an un-annotated parameter is typed where it is written: checking one early
    // would fix those parameters before pass 2 marks them as inference holes.
    let lambdaInit = false
    if ln is LetDecl { lambdaInit = fsbIsHoleLambda(parenPeelIx(ln.letInit)) }
    if ln is LetDecl && !lambdaInit {
      const savedDiag = T.diags.length
      // Its own flow frame, so a read of a global still in the dead zone is neither reported
      // nor marked assigned here; pass 2 reports it where it is written.
      const daSaved = daEnterFrame()
      const it = checkNode(ln.letInit)
      daLeaveFrame(daSaved)
      const clean = T.diags.length == savedDiag
      while T.diags.length > savedDiag { T.diags.pop() }
      numLitNotesDropFrom(savedDiag)
      // A bare name of a top-level function is that function's own type, its type parameters
      // included, and the alias is recorded as pass 2 would record it (D3899).
      const aDecl = globalInitFnAlias(ln.letInit)
      if clean && it >= 0 && it != TY_ERR && !isVoidTy(it) && !isNullTy(it) {
        if !isNeverTy(it) && (aDecl >= 0 || !tyHasHole(it)) {
          declare(ln.letName, constStrLitBound(ln, it))
          if aDecl >= 0 && fnAliasScopes.length > 0 {
            fnAliasScopes[0][ln.letName] = aDecl
          }
        }
      }
    }
  }
  inferQuiet = savedQuiet
  symEnabled = savedSym
  checkRollback(m, RB_GLOBAL_INIT)
  if prbArmed { prbLeave("globalInitPrePass") }
  0
}

// Before pass 2 checks top-level statement `stmt`, quietly records the deferred constraints of
// every generic it reaches that no earlier statement did, callee before caller, so a call
// adjudicates its callee whatever the source order (D3062). Run per statement so a body sees the
// module values the statement sees; a cycle iterates while a table grows.
function cstrProbeBefore(stmt: i32) {
  if !cstrCandAny { return 0 }
  const order: i32[] = []
  let cyc = false
  const sn = P.nodes[stmt]
  if sn is FuncDecl {
    if (cstrCandIx[sn.fnName] ?? -1) == stmt {
      if (cstrCandState[sn.fnName] ?? 0) == 0 {
        cyc = cstrProbeVisit(stmt, order)
      }
    } else {
      cyc = cstrProbeWalk(sn.fnBody, order)
    }
  } else {
    cyc = cstrProbeWalk(stmt, order)
  }
  // The statement itself is checked for real next, so outside a cycle it needs no probe.
  if !cyc && order.length > 0 && order[order.length - 1] == stmt { order.pop() }
  if order.length == 0 { return 0 }
  if prbArmed { prbEnter() }
  const m = checkMark()
  const savedSym = symEnabled
  const savedQuiet = inferQuiet
  symEnabled = 0
  inferQuiet = true
  cstrProbeSet(true)
  let rounds = 0
  let growing = true
  while growing && rounds < 4 {
    rounds = rounds + 1
    const before = cstrRowCount()
    for oi in order {
      const fd = P.nodes[oi]
      if fd is FuncDecl { checkFuncDeclNode(fd, oi) }
    }
    growing = cyc && cstrRowCount() > before
  }
  cstrProbeSet(false)
  inferQuiet = savedQuiet
  symEnabled = savedSym
  checkRollback(m, RB_CSTR_PROBE)
  if prbArmed { prbLeave("cstrProbeBefore") }
  0
}

// The un-annotated return, decided after the body is checked and its scope popped: the
// observed returns join into one type, a contextual expected return may adopt it, and the
// hoisted `TyFunc` is patched so existing references see the result. Restores the
// inference accumulators its caller saved, and hands back the return type to finalize.
function finishInferredReturn(
  n: FuncDecl,
  fnIx: i32,
  paramTys: i32[],
  causeReported: boolean,
  cbBefore: i32,
  savedObserved: i32,
  savedSawErr: boolean,
  savedValueRet: boolean,
  bodyTotalForRet: boolean,
): i32 {
  let ret = -2
  inferStack.pop()
  let inferred = TY_VOID
  // Set when the object-shaped contextual adoption fires (`objRetWidenAdopt` below):
  // gates the plain-struct canonical record — a lambda whose self-inference already
  // matches its context keeps the established un-pinned route (pinning every
  // plain-struct lambda regresses `.map`-collapse / factory / generic-HOF cases).
  let objRetAdopted = false
  const sawCycle = cycleBreakCount > cbBefore
  if inferObserved >= 0 {
    inferred = inferObserved
    noteRetJoinValues(inferred, n.fnBody)
  } else if sawCycle && fnSawValueRet {
    // A value return position resolved to `void` only because a recursive-cycle member
    // is still pending: defer, so the binding-group fixpoint re-infers this once the
    // cycle's resolvable members settle. Genuine void recursion has no value return
    // position (`fnSawValueRet` is false), so it is never deferred this way.
    if !strListHas(inferTentative, n.fnName) { inferTentative.push(n.fnName) }
    inferred = TY_VOID
  } else if inferSawErr {
    // Only err-ish types flowed back: no basis. An uninferable param or a bare `{}` in the
    // body already reported the root cause, so suppress the redundant message.
    if !causeReported { inferNoBasisErr(n.fnName, fnIx, n.fnBody) }
    inferred = TY_ERR
  }
  // Contextual return adoption: an anonymous lambda whose body infers a narrower numeric
  // than the contextual expected return takes the expected return as its own, so the
  // widening lands at the lambda's return seam (`emitReturnValue`). Numeric widening through
  // function-type variance is rejected instead (`fnSlotAssignable`), since a function value's rep is fixed.
  if n.fnName == "" && inferred >= 0 {
    // A contextual adoption below means the seed changed what this lambda infers, so an
    // annotation that supplied it is load-bearing and cannot be judged redundant by
    // comparing the two (D1442). Snapshot/compare rather than marking each arm, since there are twenty of them and a new one must not have to remember.
    const preAdopt = inferred
    const expRet = cbExpectedRetFor(fnIx)
    if expRet >= 0 {
      if numWidens(inferred, expRet) { inferred = expRet }
      // The f32 dual of the numeric widen: a literal-bodied lambda whose contextual return
      // is f32 infers f64/i32 by default, but the literal re-encodes exactly at f32 — the
      // same grant a direct `const v: f32 = 5.5` binding makes. Adopts f32 so the functype
      // result is f32 and `emitReturnValue` encodes the literal at f32 in the body.
      if inferred != expRet && primNameOf(expRet) == "f32" {
        if isF32AdoptingLitExpr(lambdaBodyTail(n.fnBody)) { inferred = expRet }
      }
      // Object-shaped dual: `() => ({f: 5})` against `() => {f: i64}` — adopt the
      // expected shape when every widening field is a re-encodable literal
      // (`objRetWidenAdopt` also records the field types for the emitter's interner).
      if objRetWidenAdopt(n.fnBody, inferred, expRet) {
        inferred = expRet
        objRetAdopted = true
      }
      // A bare `{}` body completes the expected record, as it would at any delivery (D2223).
      // Only marked when it cannot: the argument's own mismatch is then the one report.
      if inferred != expRet && bareBraceNode(lambdaBodyTail(n.fnBody)) {
        bareBraceSpecSet(bareBraceSpec + 1)
        bareBraceDeliver(lambdaBodyTail(n.fnBody), expRet, 8, true)
        bareBraceSpecSet(bareBraceSpec - 1)
        if bareBraceRecordOf(expRet) >= 0 { inferred = expRet }
      }
      // The litunion dual: a bare string-literal body that is a member of the expected
      // literal-union adopts it. Its inferred type is the softened `string`; the direct
      // `const k: K = "b"` binding grants the member flow via `assignableExpr`, but the
      // lambda-return path only had the numeric/object arms until this one.
      if inferred != expRet && tyIsLitUnion(expRet) {
        const luTail = lambdaBodyTail(n.fnBody)
        if luTail >= 0 && assignableExpr(luTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // A nullable-string result: a lambda body inferring a bare `string` member of an
      // expected `string | null` closure result adopts the nullable — its functype result is
      // the string-ref `ref.null` niche, and `emitReturnValue` niches the value exactly as
      // the named-function value spelling lowers. Covers the string/boolean niches only; a nullable numeric scalar boxes through `valueUnionRetName` instead.
      if inferred != expRet {
        const etU = T.tys[expRet]
        if etU is TyNullable {
          // The boolean-niche dual of the string niche: a lambda body inferring a bare
          // `boolean`/`null` member of an expected `boolean | null` adopts the niche — its
          // functype result is the i32 sentinel (2 = null), exactly as the annotated
          // `: boolean | null` return and the named-function value lower.
          if (
            tyIsPrimNamed(etU.nInner, "string")
            || tyIsPrimNamed(etU.nInner, "boolean")
          ) {
            const nsTail = lambdaBodyTail(n.fnBody)
            if nsTail >= 0 && assignableExpr(nsTail, inferred, expRet) {
              inferred = expRet
            }
          }
          // The nullable-list dual: a lambda body inferring the bare i32-backed list member
          // of an expected `T[] | null` adopts the niche — its functype result is the
          // nullable i32-list wrapper, exactly as the annotated form lowers. Distinct-backing
          // leaves (`i64[] | null`, …) are not adopted and stay loud checker rejects.
          if inferred != expRet && tyIsNulI32BackedListInner(etU.nInner) {
            const nlTail = lambdaBodyTail(n.fnBody)
            if nlTail >= 0 && assignableExpr(nlTail, inferred, expRet) {
              inferred = expRet
            }
          }
          // The nullable-closure dual: a lambda body inferring `null` (or a closure) against
          // an expected nullable-closure result adopts the niche — its functype result is
          // `(ref null $cloStruct)`, and `emitReturnValue`'s `retNulClosure` arm niches a
          // `return null` exactly as the annotated form already lowers.
          const etInnerTy = T.tys[etU.nInner]
          if etInnerTy is TyFunc {
            const ncTail = lambdaBodyTail(n.fnBody)
            if ncTail >= 0 && assignableExpr(ncTail, inferred, expRet) {
              inferred = expRet
            }
          }
          // The nullable-struct dual: a lambda body inferring the bare struct member (or
          // `null`) of an expected `S | null` closure result adopts the nullable — its
          // functype result is the `(ref null $S)` niche, exactly as the annotated
          // named-function value spelling already lowers.
          if etInnerTy is TyObj {
            const nsoTail = lambdaBodyTail(n.fnBody)
            if nsoTail >= 0 && assignableExpr(nsoTail, inferred, expRet) {
              inferred = expRet
            }
          }
          // The nullable-litunion dual: a lambda body inferring a bare `string` member of
          // the expected `K | null` litunion adopts the niche — its functype result is the
          // i32 atom (`-1` = null), and `emitReturnValue`'s `retNulLitUnion` arm encodes it
          // exactly as the annotated `: () => K | null` form already does.
          if tyIsLitUnion(etU.nInner) {
            const nluTail = lambdaBodyTail(n.fnBody)
            if nluTail >= 0 && assignableExpr(nluTail, inferred, expRet) {
              inferred = expRet
            }
          }
        }
      }
      // A value-union result: a lambda body inferring a bare scalar arm of the expected
      // value-union box result adopts the union, so the widening lands at the return seam —
      // `emitReturnValue` boxes the scalar and the functype result is the box itself
      // (`synthRetAnnots` pins `fnRet`). Checked after the niche arms, so a `T | null` niche is never swallowed as a value union.
      if inferred != expRet && valueUnionRetName(expRet) != "" {
        const vuTail = lambdaBodyTail(n.fnBody)
        if vuTail >= 0 && assignableExpr(vuTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The litunion-array dual of the value-union result: a lambda body inferring the bare
      // scalar arm of the expected `litunion-array | scalar` box adopts the union, boxing at
      // the return seam. `valueUnionRetName` declines this union (its render flattens the
      // litunion-array atom), so it needs its own alias-preserving arm.
      if inferred != expRet && litUnionArrayValueUnionRetName(expRet) != "" {
        const laTail = lambdaBodyTail(n.fnBody)
        // Gates on strict `assignable` of the body's inferred type, not the expression-level
        // `assignableExpr` the other arms use: the litunion-array arm reps as the kind-7
        // i32-atom list, but a bare array literal self-infers the softened `string[]`, whose
        // element re-typing would box the wrong tag. Only a body already at the union's own rep is adopted.
        if laTail >= 0 && assignable(inferred, expRet) { inferred = expRet }
      }
      // The closure-arm dual of the value-union result: a lambda body inferring one arm (a
      // closure or a scalar) of the expected closure-arm value union adopts it, boxing at
      // the return seam — a closure member is the kind-11 ref atom riding the box's anyref
      // value, and the functype result is the box (`synthRetAnnots` pins `fnRet`).
      if inferred != expRet && cloArmValueUnionRetName(expRet) != "" {
        const cvTail = lambdaBodyTail(n.fnBody)
        if cvTail >= 0 && assignableExpr(cvTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The map-member-union dual: a lambda body inferring one struct arm of the expected
      // map-member-union box result adopts the union, boxing the struct/map arm into the
      // #865/#868 map-union box at the return seam, exactly as the annotated form exposes
      // this rep already.
      if inferred != expRet && mapUnionRetName(expRet) != "" {
        const muTail = lambdaBodyTail(n.fnBody)
        if muTail >= 0 && assignableExpr(muTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The ref-arm dual: a lambda body inferring one arm (a ref list or a struct) of the
      // expected ref-arm union adopts it, boxing at the return seam so the functype result is
      // the box rather than the raw reflist a narrowed call site would then cast — a
      // guaranteed runtime trap or invalid wasm otherwise. Nominal-gated (`refArmUnionRetName` declines an anonymous-element array arm), so those shapes stay loud.
      if inferred != expRet && refArmUnionRetName(expRet, gRootStmts) != "" {
        const raTail = lambdaBodyTail(n.fnBody)
        if raTail >= 0 && assignableExpr(raTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The variant-box dual with an inline-struct arm: a lambda body inferring one arm of
      // the expected union adopts the whole union, boxing at the return seam so the
      // functype result is the box, matching the value call's `annSigKey`. Checked after
      // `refArmUnionRetName`, whose ref-array arms carry a slot render this arm declines.
      if inferred != expRet && variantBoxUnionRetName(expRet) != "" {
        const vbTail = lambdaBodyTail(n.fnBody)
        if vbTail >= 0 && assignableExpr(vbTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-nullable-list result: a lambda body array literal assignable to the
      // expected value-union-box list adopts it, so `emitReturnValue` seeds each nullable
      // element through the same rep the annotated `(f64|null)[]` form already lowers
      // (`synthRetAnnots` pins `fnRet`).
      if inferred != expRet && nulElemListRetName(expRet) != "" {
        const elTail = lambdaBodyTail(n.fnBody)
        if elTail >= 0 && assignableExpr(elTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-nullable-struct-list dual: a lambda body array literal (non-null
      // structs, or `null`) assignable to the expected nullable-struct-element list adopts
      // it, building each element through the kind-1 struct niche the annotated form already
      // lowers. Un-pinned, the body's structs would self-classify onto a different reflist slot than the annotation side.
      if inferred != expRet && nulStructElemListRetName(expRet) != "" {
        const nseTail = lambdaBodyTail(n.fnBody)
        if nseTail >= 0 && assignableExpr(nseTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-nullable-map-list dual: a lambda body array literal (non-null maps, or
      // `null`) assignable to the expected nullable-map-element list adopts it, building each
      // element through the kind-3 map niche the annotated form already lowers. Un-pinned,
      // the body's maps would self-classify onto a different reflist slot than the annotation side.
      if inferred != expRet && nulMapElemListRetName(expRet) != "" {
        const nmeTail = lambdaBodyTail(n.fnBody)
        if nmeTail >= 0 && assignableExpr(nmeTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-nullable-scalar-list dual: a lambda body array literal (non-null inner
      // lists, or `null`) assignable to the expected nullable-list-element list adopts it,
      // building each element through the nullable inner-wrapper niche the annotated form
      // already lowers. Un-pinned, the body's lists would self-classify onto a different reflist slot than the annotation side.
      if inferred != expRet && nulListElemListRetName(expRet) != "" {
        const nleTail = lambdaBodyTail(n.fnBody)
        if nleTail >= 0 && assignableExpr(nleTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-value-union-list dual: a lambda body array literal assignable to the
      // expected value-union-box list adopts it, boxing each element through the same
      // element-kind-2 rep the annotated form already lowers.
      if inferred != expRet && elemValueUnionListRetName(expRet) != "" {
        const evTail = lambdaBodyTail(n.fnBody)
        if evTail >= 0 && assignableExpr(evTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-variant-box-union-list dual: a lambda body array literal assignable to
      // the expected variant-box-element list adopts it, boxing each element through the
      // same element-kind-2 rep the annotated named-function value form already lowers.
      if inferred != expRet && elemVariantBoxListRetName(expRet) != "" {
        const vbeTail = lambdaBodyTail(n.fnBody)
        if vbeTail >= 0 && assignableExpr(vbeTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-map-union-list dual: a lambda body array literal assignable to the
      // expected map-union-element list adopts it, boxing each element through the same
      // element-kind-2 map-union box rep the annotated form already lowers. Un-pinned, the
      // body's array would self-classify onto a different reflist slot than the annotation side.
      if inferred != expRet && elemMapUnionListRetName(expRet) != "" {
        const meTail = lambdaBodyTail(n.fnBody)
        if meTail >= 0 && assignableExpr(meTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-refarm-value-union-list dual: a lambda body array literal assignable to
      // the expected list of (union-element-array | scalar) boxes adopts it, boxing each
      // element through the same element-kind-2 box the annotated form already lowers.
      // Un-pinned, the body's array would key onto a different `$fnsig` slot than the annotation side.
      if inferred != expRet && elemRefArmValueUnionListRetName(expRet) != "" {
        const raeTail = lambdaBodyTail(n.fnBody)
        if raeTail >= 0 && assignableExpr(raeTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The nested (2-D+) union-element array dual: a lambda body nested array literal
      // assignable to the expected 2-D+ box-element list adopts it, building the nested
      // lists through the same element-kind-2 box the annotated form already lowers
      // (`synthRetAnnots` pins `fnRet` off this producer's rung, `IR_RUNG_NESTED_ELEM_UNION_LIST`).
      if inferred != expRet && nestedElemUnionListRetName(expRet) != "" {
        const nueTail = lambdaBodyTail(n.fnBody)
        if nueTail >= 0 && assignableExpr(nueTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The union-field-struct-element-list dual: a lambda body array literal assignable to
      // the expected list of boxed-field structs adopts it, building each element's boxed
      // field slot exactly as the annotated form lowers (`synthRetAnnots` pins `fnRet` via
      // `nameIsStructWithUnionField`).
      if inferred != expRet && structFieldBoxElemListRetName(expRet) != "" {
        const sfeTail = lambdaBodyTail(n.fnBody)
        if sfeTail >= 0 && assignableExpr(sfeTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The nullable-closure-element-list dual: a lambda body array literal assignable to
      // the expected kind-5 niche list adopts it, seeding each element (a `null` to
      // `ref.null $cloStruct`) through the same rep the annotated form already lowers.
      if inferred != expRet && nulClosureElemListRetName(expRet) != "" {
        const nceTail = lambdaBodyTail(n.fnBody)
        if nceTail >= 0 && assignableExpr(nceTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The nested-list result: a lambda body array literal assignable to the expected
      // nested scalar-leaf array adopts it, building under the pinned return's threading
      // (`synthRetAnnots` pins `fnRet`); the `$fnsig` result keys the reflist slot on both
      // producers, unlike the 1-D scalar-list arm below (R4).
      if inferred != expRet && nestedLeafListRetName(expRet) != "" {
        const nlTail = lambdaBodyTail(n.fnBody)
        if nlTail >= 0 && assignableExpr(nlTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The scalar-leaf-list result: a lambda body array literal assignable to the expected
      // distinct-backing scalar-leaf list adopts it — elements re-encode at the leaf
      // (`assignableExpr`'s `ArrayLit` arm, the grant a direct `const xs: f32[] = [1.5]`
      // binding makes), and `synthRetAnnots` pins `fnRet` to the adopted name (`isScalarListRetName`).
      if inferred != expRet && scalarLeafListRetName(expRet) != "" {
        const slTail = lambdaBodyTail(n.fnBody)
        if slTail >= 0 && assignableExpr(slTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The litunion-element-list result: a lambda body array literal whose elements are
      // members of the expected litunion-element list adopts it — `assignableExpr`'s
      // `ArrayLit` arm records the destination array type, so the body builds the i32 atom
      // list; the `>a` result token already byte-matches the annotation side, so no pin is needed.
      if inferred != expRet && litUnionElemListRetName(expRet) != "" {
        const lulTail = lambdaBodyTail(n.fnBody)
        if lulTail >= 0 && assignableExpr(lulTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The struct-element-list result: a lambda body array literal's element structs
      // coerce field-wise into the expected shape and adopt it — `assignableExpr`'s
      // per-element `ObjLit` coercion records the coerced field types for the emitter's
      // interner. Gated on plainly-lowerable element fields, so a map/union/nullable field stays a loud reject.
      if inferred != expRet && structElemListRetName(expRet) != "" {
        const seTail = lambdaBodyTail(n.fnBody)
        if seTail >= 0 && assignableExpr(seTail, inferred, expRet) {
          inferred = expRet
          objRetAdopted = true
        }
      }
      // The loud floor, last rung of this ladder: an empty-`[]` result no arm above adopted
      // is the absence of a rep, not a narrower version of one — leaving `fnRet` a hole would
      // cast-trap the value call or disagree with the body's list at emit. Exempt only the
      // i32-backed elements (`i32`/`boolean`), which share the one i32-list backing with the annotation and so are already correct un-adopted.
      if inferred != expRet && unresolvedHole(inferred) {
        const ehT = T.tys[expRet]
        if ehT is TyArray {
          if (
            !tyIsPrimNamed(ehT.aElem, "i32")
            && !tyIsPrimNamed(ehT.aElem, "boolean")
          ) {
            tErrUnsupported(
              "a lambda returning an empty `[]` cannot build the "
                + tyToStr(expRet)
                + " result its annotation asks for — type-valid, but the element type has no"
                + " rep to build from; return the literal from a named function"
                + " (`function f(): "
                + tyToStr(expRet)
                + " { return [] }`), which lowers this",
              n.fnBody,
            )
          }
        }
      }
    }
    if inferred != preAdopt { cbSeedUsedSet(cbSeedUsed + 1) }
  }
  // A `const` literal returned is the `string` it is stored as, so a join with `null`, a number
  // or a record meets the return floors below exactly as that string does (D2157).
  inferred = widenLitTy(inferred)
  // Permissive fall-through (totality): an un-annotated function that can fall off the end
  // implicitly yields `null` there, so its inferred return widens to `T | null`. A box-able
  // value type lowers un-annotated via the `uBoxIdx` box; a niche (`boolean`/`string`) widens
  // too but stays floored below until A20 carries the niche seed. A void/error return is exempt.
  if (
    !bodyTotalForRet
    && inferred >= 0
    && !isVoidTy(inferred)
    && inferred != TY_ERR
  ) {
    const inT = T.tys[inferred]
    if !(inT is TyNullable) { inferred = mkNullableTy(inferred) }
  }
  // Robustness floor: an un-annotated function whose returns join to a union/nullable now
  // infers the correct type, but must still be annotated when the emitter cannot yet lower
  // it un-annotated — a value union/nullable already lowers via the `uBoxIdx` box and does
  // not floor; a deferred join (a per-call-site placeholder) is not a shape to floor either, since it collapses to one arm at each call site.
  if (
    !inferQuiet
    && n.fnName != ""
    && inferred >= 0
    && !tyIsDeferredJoin(inferred)
    && valueUnionRetName(inferred) == ""
  ) {
    const itt = T.tys[inferred]
    // A variant-box union (`{w: i32} | i32`, and its nullable form) lowers un-annotated: the
    // A20 loop records `variantBoxUnionRetName` and the emitter boxes it exactly like the
    // annotated spelling. Checked before the `TyUnion`/`TyNullable` arms below (it spans
    // both), so the floor accepts exactly the box the emitter registers.
    if litUnionAliasNameOfTy(inferred) != "" {
      // A pure literal union with a declared alias (`type K = "a" | "b"`) lowers
      // un-annotated as the interned i32 atom: the A20 loop records the alias name and the
      // emitter's return classification reads the same rep the annotated `: K` spelling
      // reaches. An inline litunion (no alias to record) still floors below.
    } else if variantBoxUnionRetName(inferred) != "" {
      // lowers un-annotated — no floor
    } else if mapUnionRetName(inferred) != "" {
      // A map-member union lowers un-annotated through the recorder's map-union rung (D2666).
    } else if tyIsLitUnion(inferred) {
      // A pure un-named literal union lowers un-annotated as a string ref, the same rep its
      // annotated twin carries — `collectF` records `retPrim = "string"` for this shape and
      // the return site widens an atom-repped value into it. The alias form above reps as
      // the atom instead, so the two never collide.
    } else if numLitUnionHasBase(inferred) {
      // A numeric literal union has no union rep at all: every member softens to one base
      // scalar, so the recorder banks the base (`numLitUnionBaseTy`, the same rule
      // `softenLitTy` states everywhere) and this arm accepts exactly what it banks. The
      // string litunion two arms up is the shape that keeps an identity (the interned atom), which is why it is a separate question.
    } else if itt is TyUnion {
      // No floor for a union the emitter lowers as its annotation: a struct union it can register
      // (`structUnionRetName`), a union of lists or with a function member it pins (D2768,
      // D4349), and a union over a type parameter, decided per instance where `T` is bound.
      if (
        structUnionRetName(inferred, gRootStmts) == ""
        && !tyHasTyVar(inferred)
        && !tyUnionAllLists(inferred)
        && !tyIsFnArmUnion(inferred)
      ) {
        tErrUnsupported(
          "'"
            + n.fnName
            + "' infers the union return type "
            + tyToStr(inferred)
            + " — type-valid, but an inferred return of this shape is not yet supported by codegen; annotate the return type",
          n.fnBody,
        )
      }
    } else if itt is TyNullable {
      // The niche nullables (`boolean | null` / `string | null` / `K | null`), a nullable
      // struct, a nullable list at every element type, and a never-filled infer-null hole
      // (`nInner < 0`, whose only value is `null`) all lower un-annotated — each named by its
      // own recorder for the emitter to seed from — so none of them floor (D1576).
      if (
        itt.nInner >= 0
        && !(T.tys[itt.nInner] is TyVar)
        && !tyIsParamUnion(itt.nInner)
        && !tyIsPrimNamed(itt.nInner, "boolean")
        && !tyIsPrimNamed(itt.nInner, "string")
        && litUnionAliasNameOfTy(itt.nInner) == ""
        && nullableRetName(inferred, gRootStmts) == ""
        && nulListRetName(inferred) == ""
      ) {
        // `T | null` over a type parameter is decided per instance, where `T` is bound.

        tErrUnsupported(
          "'"
            + n.fnName
            + "' infers the nullable return type "
            + tyToStr(inferred)
            + " — type-valid, but an inferred return of this shape is not yet supported by codegen; annotate the return type",
          n.fnBody,
        )
      }
    }
  }
  // A lambda's join of its enclosing body's type parameters is that body's kept-apart join, so
  // the lambda's instance and every caller re-join it at the pin alike (D3520, D3521). A call's
  // join it relays is the callee's, which a gated callee widens.
  if (
    n.fnName == ""
    && tyIsDeferredJoin(inferred)
    && !(dJoinRelayed.get(inferred) ?? false)
    && deferredJoinOverOpenParams(inferred)
  ) {
    inferred = openParamJoinOf(inferred)
  }
  ret = inferred
  // Patches the hoisted `TyFunc` in place so existing references see the result; a nested
  // (un-hoisted) named function declares fresh, and an anonymous lambda just carries its
  // type as the expression value. The parameter-solve probe observes this body and must not
  // decide the return, so patching here would deny pass 1.7 a fresh re-derivation.
  const cstrProbeTop = cstrProbe && (fnDeclIx[n.fnName] ?? -1) == fnIx
  if n.fnName != "" && !paramSolveProbe && !cstrProbeTop {
    // A nested function has no hoisted binding: only one already declared in the enclosing
    // scope is its own, and `lookup` further out would find an outer namesake (D1966).
    const isTopDecl = (fnDeclIx[n.fnName] ?? -1) == fnIx
    let bound = -1
    if isTopDecl || lookupDepth(n.fnName) == T.scopes.length - 1 {
      bound = lookup(n.fnName)
    }
    let patched = false
    if bound >= 0 {
      const bt = T.tys[bound]
      if bt is TyFunc {
        bt.fnRet = inferred
        tyMutEpoch = tyMutEpoch + 1 // inferred return patched in place
        patched = true
      }
    }
    if !patched { declare(n.fnName, mkFuncTy(paramTys, inferred)) }
    if !isTopDecl && !inferQuiet { noteNestedUnannotFn(fnIx, lookup(n.fnName)) }
    // Re-retains the symbol-table type with the inferred return: the entry stamped while
    // checking the signature carried the `-2` infer-later sentinel, and the in-place patch
    // above only touches the scope-bound copy. Without this, hover / inlay on an
    // unannotated function renders `-> _`.
    if symEnabled != 0 { symRetainType(fnIx, mkFuncTy(paramTys, inferred), 2) }
  } else if !inferQuiet {
    // An anonymous lambda is lifted to a top-level function under a synthesized
    // `__lambda_N` name the checker never saw, so the name-keyed inferred-return table
    // can't reach it. Records the inferred scalar/string/list return under a node-index
    // sentinel key (`#<nodeIx>`) instead, read back by `inferRetNameByNode`.
    const anm = tyToStructStr(inferred)
    // A struct-with-boxed-field contextual return the checker adopted at the lambda
    // boundary (`objRetWidenAdopt`'s boxing-widen arm), recorded under the canonical emit
    // name (not the spaced `tyToStr` render) so `synthRetAnnots`'s pin and
    // `internShapeDeep`'s intern resolve. Takes precedence over `recordable`.
    const sfbNm = structFieldBoxRetName(inferred)
    // A map-carrying struct return, recorded under the canonical emit name too — the spaced
    // `recordable` render never pins, and an un-pinned body literal's nested map field would
    // otherwise resolve by field-name set and mint a wrong-layout twin. Checked after `sfbNm` (a boxed-field struct keeps its established pin).
    let smfNm = ""
    if sfbNm == "" { smfNm = structMapFieldRetName(inferred) }
    // A plain struct return, recorded canonically too: the spaced `recordable` render never
    // pins, and an un-pinned lambda's body literal fieldset-matches — a same-fieldset twin
    // row in scope can resolve the wrong row otherwise. Composite fields (map/union/closure/list) keep their own recorder arms below.
    let spfNm = ""
    if sfbNm == "" && smfNm == "" && objRetAdopted {
      spfNm = structPlainRetName(inferred)
    }
    // A single struct-shape inferred return is recorded too — a lambda that collapses to
    // one union variant types as that variant's shape, so the emitter resolves it to the
    // concrete variant rather than the box. The gates run only when all three canonical
    // recorders declined, each at most once, in source order — `recordable` is bit-identical to the disjunction it replaces.
    let recCode = IR_RUNG_NONE
    if sfbNm == "" && smfNm == "" && spfNm == "" {
      if isClassifiableRetName(anm) { recCode = IR_REC_CLASSIFIABLE }
      else if isObjShapeName(anm) { recCode = IR_REC_OBJ_SHAPE }
      else if isScalarListRetName(anm) { recCode = IR_REC_SCALAR_LIST }
    }
    const recordable = recCode != IR_RUNG_NONE
    // A union inferred/contextual return exports its emitter-format name (value-union or
    // struct-union) under the same node sentinel, mirroring the named-function A20 loop —
    // the contextual return the checker proved for the lambda at its own boundary, pinned
    // position-independently (`synthRetAnnots`) rather than re-derived per boundary.
    let unm = ""
    // Not the only writer since the r8 split: `nulElemListRetName` sets the rung itself, and
    // the contextual-adoption gate above calls that producer too, so a write can land before
    // this reset — safe since the reset is unconditional and precedes the cascade. The
    // global's lifetime is exactly one cascade run: cleared here, written once, read once.
    irRungClear()
    if !recordable {
      unm = irRung(IR_RUNG_SFB, sfbNm)
      if unm == "" { unm = irRung(IR_RUNG_STRUCT_MAP_FIELD, smfNm) }
      if unm == "" { unm = irRung(IR_RUNG_STRUCT_PLAIN, spfNm) }
      if unm == "" {
        unm = irRung(IR_RUNG_VALUE_UNION, valueUnionRetName(inferred))
      }
      // The litunion-array value-union dual (adopted above): records its alias-preserving
      // emit name so `collectU` registers the union and `synthRetAnnots`'s `isValueUnionName`
      // arm pins `fnRet` to it, keying the `$fnsig` result `>u` to match the value call.
      if unm == "" {
        unm = irRung(
          IR_RUNG_LITUNION_ARR_VU,
          litUnionArrayValueUnionRetName(inferred),
        )
      }
      if unm == "" {
        unm = irRung(
          IR_RUNG_STRUCT_UNION,
          structUnionRetName(inferred, gRootStmts),
        )
      }
      // A NULLABLE-ref contextual return (`P | null`, `string | null`) — recorded under the same
      // node sentinel so `synthRetAnnots` pins a nullable-returning closure value position-
      // independently (the nullable dual of the union pin).
      if unm == "" {
        unm = irRung(IR_RUNG_NULLABLE, nullableRetName(inferred, gRootStmts))
      }
      // The nullable-litunion contextual return (adopted above): records the alias name so
      // `synthRetAnnots` pins the lambda's `fnRet` as the nullable litunion (an i32 atom with
      // `-1` = null), whose member-encoding `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(IR_RUNG_NUL_LITUNION, nulLitUnionRetName(inferred))
      }
      // The element-nullable-list contextual return (adopted above): records its emitter
      // name so `synthRetAnnots` pins the lambda's `fnRet` as the value-union-box list, whose
      // `[null]` element seeding `emitReturnValue` already performs for the annotated form.
      if unm == "" { unm = nulElemListRetName(inferred) }
      // The element-nullable-struct-list contextual return (adopted above): records its
      // canonical emit name so `synthRetAnnots` pins `fnRet` as the nullable-struct-element
      // list, whose kind-1 struct-niche element seeding `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(
          IR_RUNG_NUL_STRUCT_ELEM_LIST,
          nulStructElemListRetName(inferred),
        )
      }
      // The element-nullable-map-list contextual return (adopted above): records its
      // canonical emit name so `synthRetAnnots` pins `fnRet` as the nullable-map-element
      // list, whose kind-3 map-niche element seeding `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(IR_RUNG_NUL_MAP_ELEM_LIST, nulMapElemListRetName(inferred))
      }
      // The element-nullable-scalar-list contextual return (adopted above): records its
      // canonical emit name so `synthRetAnnots` pins `fnRet` as the nullable-list-element
      // list, whose inner-wrapper element seeding `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(
          IR_RUNG_NUL_LIST_ELEM_LIST,
          nulListElemListRetName(inferred),
        )
      }
      // The element-value-union-list contextual return (adopted above): records its emitter
      // name so `synthRetAnnots` pins `fnRet` as the value-union-box list, whose element
      // boxing `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(IR_RUNG_ELEM_VU_LIST, elemValueUnionListRetName(inferred))
      }
      // The element-variant-box-union-list contextual return (adopted above): records its
      // emitter name so `synthRetAnnots` pins `fnRet` as the variant-box-element list, whose
      // element boxing `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(
          IR_RUNG_ELEM_VARIANT_BOX_LIST,
          elemVariantBoxListRetName(inferred),
        )
      }
      // The element-map-union-list contextual return (adopted above): records its emitter
      // name so `synthRetAnnots` pins `fnRet` as the map-union-box element list, whose
      // element boxing `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(
          IR_RUNG_ELEM_MAP_UNION_LIST,
          elemMapUnionListRetName(inferred),
        )
      }
      // The element-refarm-value-union-list contextual return (adopted above): records its
      // emitter name so `synthRetAnnots` pins `fnRet` as the box-list, whose element boxing
      // `emitReturnValue` already performs for the annotated form.
      if unm == "" {
        unm = irRung(
          IR_RUNG_ELEM_REFARM_VU_LIST,
          elemRefArmValueUnionListRetName(inferred),
        )
      }
      // The nested (2-D+) union-element array contextual return (adopted above): records its
      // emitter name so `synthRetAnnots` pins `fnRet` as the nested box-element array, whose
      // return-position threading + `$fnsig` reflist-slot keying already performs.
      if unm == "" {
        unm = irRung(
          IR_RUNG_NESTED_ELEM_UNION_LIST,
          nestedElemUnionListRetName(inferred),
        )
      }
      // The union-field-struct-element-list contextual return (adopted above): records its
      // emitter name so `synthRetAnnots` pins `fnRet` as the boxed-field-element list, whose
      // element boxing the annotated spelling already performs.
      if unm == "" {
        unm = irRung(
          IR_RUNG_STRUCT_FIELD_BOX_ELEM_LIST,
          structFieldBoxElemListRetName(inferred),
        )
      }
      // The plain-struct-element-list return: records its canonical name so
      // `synthRetAnnots` pins the lambda and the element literals build under the annotated
      // threading instead of fieldset-matching a wrong same-fieldset twin. Adoption-gated
      // like the plain-struct record above, since un-gating regressed the closure-value ref-list ABI suite.
      if unm == "" && objRetAdopted {
        unm = irRung(IR_RUNG_STRUCT_ELEM_LIST, structElemListRetName(inferred))
      }

      // The nullable-closure-element-list contextual return (adopted above): records its
      // emitter name so `synthRetAnnots` pins `fnRet` (`parenUnionArrElemName`), whose kind-5
      // ref-list slot and `[null]` seeding `emitReturnValue` already threads.
      if unm == "" {
        unm = irRung(
          IR_RUNG_NUL_CLOSURE_ELEM_LIST,
          nulClosureElemListRetName(inferred),
        )
      }
      // The closure-arm value-union contextual return (adopted above): records its emitter
      // name so `collectU` registers the union and `synthRetAnnots` pins `fnRet` to it; the
      // `$fnsig` result then keys `>u`, matching the value call.
      if unm == "" {
        unm = irRung(IR_RUNG_CLO_ARM_VU, cloArmValueUnionRetName(inferred))
      }
      // The map-member-union contextual return (adopted above): records its emitter name so
      // `synthRetAnnots` pins `fnRet` as the map-union box (#865/#868), whose arm boxing
      // `emitReturnValue` already performs for the annotated form.
      if unm == "" {
        unm = irRung(IR_RUNG_MAP_UNION, mapUnionRetName(inferred))
      }
      // The ref-arm value-union contextual return (adopted above; repOf item (d)): records
      // its nominal render so `collectU` registers the union and `synthRetAnnots`'s `isUName`
      // arm pins `fnRet` to the same spelling the emitter's binding resolution uses.
      if unm == "" {
        unm = irRung(
          IR_RUNG_REFARM_UNION,
          refArmUnionRetName(inferred, gRootStmts),
        )
      }
      // The variant-box union contextual return with an inline-struct arm (adopted above):
      // records its emitter name so `collectU` registers the union and `synthRetAnnots`'s
      // `isUName` arm pins `fnRet` to it; the `$fnsig` result keys `>u`.
      if unm == "" {
        unm = irRung(IR_RUNG_VARIANT_BOX, variantBoxUnionRetName(inferred))
      }
      // The nested-list contextual return (adopted above): records its emitter name so
      // `synthRetAnnots` pins `fnRet` as the nested array, whose return-position threading
      // and `$fnsig` reflist-slot keying already performs (R4).
      if unm == "" {
        unm = irRung(IR_RUNG_NESTED_LEAF_LIST, nestedLeafListRetName(inferred))
      }
      // The map-element-list contextual return: records its emitter name so
      // `synthRetAnnots` pins `fnRet` as the map-element array, whose kind-3 slot keying the
      // annotated named-function form already performs.
      if unm == "" {
        unm = irRung(IR_RUNG_MAP_ELEM_LIST, mapElemListRetName(inferred))
      }
      // The litunion-alias-element-list contextual return (adopted above): records the
      // name so `synthRetAnnots` pins `fnRet` and the body member literals build the i32
      // atom list the annotated return does.
      if unm == "" {
        unm = irRung(
          IR_RUNG_LITUNION_ELEM_LIST,
          litUnionElemListRetName(inferred),
        )
      }
      // The literal-union contextual return (adopted above): records the alias name so
      // `synthRetAnnots` pins `fnRet` as the litunion, whose functype result reps as an i32
      // atom — the `$fnsig` result keys `>i` and `emitReturnValue` encodes the member literal
      // as its atom id (`retLitUnion`, #1115).
      if unm == "" {
        unm = irRung(
          IR_RUNG_LITUNION_ALIAS,
          irAtoms(litUnionAliasNameOfTy(inferred), 1),
        )
      }
      // A nullable list at an element type the nullable rung does not name (`string[] |
      // null`): `synthRetAnnots` pins it as `synthNulListRetAnns` pins a named function (D2399).
      if unm == "" {
        unm = irRung(IR_RUNG_NUL_LIST_RET, nulListRetName(inferred))
      }
    }
    // The width of the name this ladder settled on, handed over by the producer that
    // joined it rather than re-derived by splitting it (#1115). The rungs short-circuit, so
    // the last producer to answer non-empty is the one that wrote `inferRetNameAtoms`. The
    // `recordable` name is not a producer's join: its three gates admit only one-atom spellings.
    let rAtoms = 1
    if !recordable { rAtoms = inferRetNameAtoms }
    // The rung, on the identical footing as the width above: read from the cascade only on
    // the path that ran it. A `recordable` row cannot carry a producer rung — it never runs
    // the cascade — but it carries the gate code that admitted it instead, which the arm-9
    // conversion reads; gate codes never write to `inferRetNameRung`, so they cannot leak.
    let rRung = recCode
    if !recordable { rRung = inferRetNameRung }
    // A deferred join is a per-call-site placeholder, not a shape the emitter can
    // classify a return by — see the named-function twin in `elaborateInferRets`.
    if recordable || unm != "" {
      if !tyIsDeferredJoin(inferred) {
        const nodeKey = "#" + i32ToStr(fnIx)
        if inferRetNameOf(nodeKey) == "" {
          let rty = unm
          if recordable { rty = anm }
          recordInferRet(nodeKey, rty, inferred, rAtoms, rRung)
        }
      }
    }
  }
  inferObservedSet(savedObserved)
  inferSawErrSet(savedSawErr)
  fnSawValueRetSet(savedValueRet)
  ret
}

// A function declaration: resolves param/return annotations, binds the signature, and checks
// the body in a fresh scope. An un-annotated return is inferred from the body's returns and
// trailing expression (`noteInferredRet`, under a `-2` pending `curRet`), then patched into
// the hoisted `TyFunc` in place so every caller sees it. A base-case-less cycle has nothing to latch onto and reports "cannot infer a return type".
function checkFuncDeclNode(n: FuncDecl, fnIx: i32) {
  // No `break` crosses a function boundary, so the body's loops start a fresh base.
  const lpSaved = lpBase
  lpBaseSet(lpLabels.length)
  let r = 0
  if n.fnName != "" {
    const wsDiags = T.diags.length
    r = checkFuncDeclNodeReal(n, fnIx)
    if T.diags.length > wsDiags { wsBodyErr[fnIx] = true }
  } else {
    lamCheckDepth = lamCheckDepth + 1
    r = checkFuncDeclNodeReal(n, fnIx)
    lamCheckDepth = lamCheckDepth - 1
  }
  lpBaseSet(lpSaved)
  r
}

function checkFuncDeclNodeReal(n: FuncDecl, fnIx: i32) {
  // A `function` (top-level OR nested) whose name the emitter dispatches on inline is a
  // definition that can never run — reject it at the definition, not at the call site
  // that silently means something else. Anchored on the decl node, so the pass-1 hoist
  // and this pass report the SAME (message, anchor) pair and `tErrCoded` dedups them.
  checkNotEmitterIntrinsic(n.fnName, fnIx)
  checkNotNestedBinOpDecl(n.fnName, fnIx)
  // Binds the name to this declaration node in the enclosing scope (the body's own scope is
  // pushed further down), so a call inside that scope can recover the parameter list and its
  // defaults. A top-level function is already recorded by the pass-1 hoist under the same
  // name; a nested one has no hoist and is recorded here, which is also the point it becomes callable.
  if n.fnName != "" { declareFnDeclNode(n.fnName, fnIx) }
  let inferring = n.fnRet < 0
  // Void-context lambda adoption: an un-annotated lambda literal whose contextual expected
  // return is `void` is checked as if annotated `: void` rather than inferred, so an explicit
  // `return expr` fails the same anchored mismatch a named `: void` spelling produces, and a
  // value-bearing tail is silently discarded by the emitter. Keyed on the context's expected return, never on the tail's own shape.
  if inferring && n.fnName == "" {
    if isVoidTy(cbExpectedRetFor(fnIx)) {
      inferring = false
      noteVoidCtxLambda(fnIx)
    }
  }
  // The same flip for the same reason: a bare `return` writes `: void`, so stop inferring and
  // take the `!inferring` ladder's `TY_VOID` default, which already discards a valued tail.
  let bareRetVoid = false
  if inferring {
    if blockHasBareReturn(n.fnBody) {
      inferring = false
      bareRetVoid = true
    }
  }
  // ...and for a result no caller reads, which the hoist already bound as `: void` (D2631).
  const ucVoided = inferring && fnResultUnconsumed(fnIx)
  if ucVoided { inferring = false }
  // The return an unread function shows in the editor: its tail's value, never lowered.
  let ucShowRet = TY_VOID
  // The infer-stack key: a named function uses its name (so self-recursion is detected); an
  // anonymous lambda has no name and keys by node index instead — else two nested anonymous
  // lambdas would both key on "" and the inner would falsely trip the recursive-cycle guard, mis-inferring its return as `void`.
  let inferKey = n.fnName
  if inferKey == "" { inferKey = "#L" + i32ToStr(fnIx) }
  // Already inferred on demand (a forward call checked this body before pass 2
  // reached it)? Skip the re-check so diagnostics aren't duplicated.
  if inferring {
    // Recursive cycle: this function is already on the inference stack. Break with a
    // provisional `void` (the binding-group fixpoint re-infers it once the cycle's
    // resolvable members settle), and COUNT the break so the completion below knows
    // the result is tentative rather than final.
    if onInferStack(inferKey) {
      cycleBreakCountSet(cycleBreakCount + 1)
      return TY_VOID
    }
    if inferQuiet && !paramSolveProbe && !cstrProbe {
      // Suppressed pre-pass: memoize a resolved return (a `-2` reset by the fixpoint
      // forces a fresh re-inference). The PARAMETER-solve probe never takes the memo:
      // it needs the body walked for the flow constraints, not the return.
      const hoisted = lookup(n.fnName)
      if hoisted >= 0 {
        if (fnDeclIx[n.fnName] ?? -1) >= 0 {
          const ht = T.tys[hoisted]
          if ht is TyFunc {
            if ht.fnRet != -2 { return TY_VOID }
          }
        }
      }
    } else {
      // Real check pass: returns are already resolved by the pre-pass, so skip only a
      // top-level body already diagnostic-checked (a forward call reached it before pass 2
      // did). Gated on `fnIx` matching the registered top-level decl, so a nested function
      // sharing a name (e.g. two `add` closures) is never skipped.
      if (fnDeclIx[n.fnName] ?? -1) == fnIx {
        if bodyChecked[n.fnName] ?? false { return TY_VOID }
      }
    }
  }
  // Solves this declaration's un-annotated parameters from its body usage. A no-op for a
  // top-level function (already done in pass 1.6) and inside a probe; this reach is the
  // nested `function` and the value-bound lambda, whose first observer is this call. A
  // parameter the receiver already pinned contextually is not a hole here, so `cbExpect` below still wins — one answer, not two.
  solveUnannotParams(fnIx)
  const params = n.fnParams
  // The contextual expected param types recorded for THIS lambda node (`seedExpected` at a
  // call arg, a `.map`/`.filter` receiver, or an annotated let/return/field/element). Keyed by
  // node index, so a composite's many lambdas each read their own — no single-shot leak.
  const cbExpect = cbExpectedFor(fnIx)
  const cbExpectUsable = cbExpect.length == params.length
  const paramTys: i32[] = []
  // Parallel to `paramTys`: did THIS parameter's annotation collapse a subsumed literal
  // arm (D1048's second hint)? Recorded here, where the annotation resolves, and read in
  // the declare loop below, which is where the binding — and so the scope depth the mark
  // is keyed by — comes into existence.
  const paramCollapsed: boolean[] = []
  let paramUninferable = false
  let pi = 0
  while pi < params.length {
    const pNode = P.nodes[params[pi]]
    let pt = TY_ERR
    let ptCollapsed = false
    if pNode is Param {
      if pNode.parType >= 0 {
        const ptn = P.nodes[pNode.parType]
        if ptn is TypeRef {
          pt = resolveAnnotAt(ptn.tyName, n.fnTyParams, pNode.parType, n.fnName)
          if pt >= 0 && pt == collapsedTy { ptCollapsed = true }
          if pt < 0 {
            unknownTyErr(ptn.tyName, "", pNode.parType)
            pt = TY_ERR
          }
          // Records the resolved type on the param's type-annotation node too (not just the
          // param node), so the emitter can classify a param annotation structurally from the
          // `Ty` arena instead of re-parsing its synthetic name (`tyNameOf`) — C1.
          if !inferQuiet && pt >= 0 {
            if pNode.parType < nodeTyIx.length { nodeTySet(pNode.parType, pt) }
          }
        }
      } else if cbExpectUsable && cbExpect[pi] >= 0 {
        // Contextual inference: the expected callback type pins this un-annotated param
        // (`xs.map(function(n) …)` over `i32[]` ⇒ `n: i32`). The seed is the only source of
        // this param's type, so an annotation that supplied it is load-bearing — count it
        // (D1442), or `recordRedundantAnnot` calls it redundant and `--fix` deletes it.
        pt = cbExpect[pi]
        cbSeedUsedSet(cbSeedUsed + 1)
      } else if n.fnName != "" {
        // A named function's un-annotated parameter is a fresh inference hole — a synthetic
        // `TyVar` per param, named by declaration and position so the hoisted signature and
        // the body bind the same hole. Each call site pins it independently, and the emitter
        // monomorphizes one instance per shape; the body sees it as opaque unless its own usage pinned it (`unannotParamTy`).
        pt = unannotParamTy(paramHoleName(n.fnName, fnIx, pi))
      } else if isValBindLambda(fnIx) {
        // A lambda bound to an UN-annotated `const`/`let` (`const add = (a, b) => a + b`): its
        // un-annotated param is a fresh inference HOLE, exactly like a named function's — the
        // emitter value-flow-monomorphizes one instance per call shape (env and all). Keyed by NODE
        // index (the lambda is anonymous), the dual of the named branch above.
        pt = unannotParamTy(paramHoleName("", fnIx, pi))
      } else {
        // An ANONYMOUS literal with no annotation and no contextual type is genuinely uninferable —
        // its value-typed binding demands a concrete signature NOW (host parity).
        tErr(
          "cannot infer a type for parameter `" + pNode.parName + "`",
          params[pi],
        )
        // The body can't be typed once a param is unknown — don't also cascade a "cannot infer a
        // return type" from the resulting error-only return.
        paramUninferable = true
      }
    }
    // A `void` result cannot be bound (spec T1.4), so no argument can reach a `void` parameter.
    if !inferQuiet && isVoidTy(pt) {
      tErr(
        "a parameter cannot be `void`: a `void` result cannot be bound, so no call could pass one — give the parameter a value type",
        params[pi],
      )
      pt = TY_ERR
    }
    // Records the param node's resolved type so the emitter can recover a
    // contextually-inferred callback param's type (`xs.map((x) => …)` over `f64[]` ⇒ x: f64)
    // and synthesize its annotation, instead of defaulting an un-annotated param to i32.
    // Gated on the real pass; a generic hole stays a `TyVar` and is excluded by the emitter's reader (`nodeTyName`).
    if !inferQuiet && pt >= 0 {
      if params[pi] < nodeTyIx.length { nodeTySet(params[pi], pt) }
    }
    paramTys.push(pt)
    paramCollapsed.push(ptCollapsed)
    pi = pi + 1
  }
  // Parameter DEFAULTS (`a: i32 = 0`, and the `a?: T` spelling the parser
  // desugars into one), checked once the annotations have resolved.
  checkParamDefaults(n, params, paramTys)
  if n.fnName != "" && params.length > 0 {
    const sp0 = P.nodes[params[0]]
    if sp0 is Param {
      if sp0.parName == "self" && sp0.parType >= 0 {
        checkSelfFnReachable(demangleName(n.fnName), paramTys[0], fnIx)
      }
    }
  }
  // Resolve the return-type annotation (or the pending sentinel when inferring).
  let ret = -2
  if !inferring {
    ret = TY_VOID
    // A VOID-adopted lambda has NO annotation node (`n.fnRet` is -1) — the guard
    // leaves `ret` at the `TY_VOID` default, which IS its adopted return.
    if n.fnRet >= 0 {
      const rtn = P.nodes[n.fnRet]
      if rtn is TypeRef {
        ret = resolveRetAnnotAt(rtn.tyName, n.fnTyParams, n.fnRet, n.fnName)
        // D1048's second hint: a declared return whose spelling collapsed marks the
        // DECLARATION, so an un-annotated `const r = f(…)` can inherit the provenance.
        // The pass-1 hoist below records the same fact for a top-level function; this
        // arm is what covers a NESTED one, which the hoist never walks.
        if ret >= 0 && ret == collapsedTy { markCollapsedRet(fnIx) }
        if ret < 0 {
          unknownTyErr(rtn.tyName, "", n.fnRet)
          ret = TY_ERR
        }
        // Records the resolved return type on the return-annotation node so the emitter can
        // classify it structurally from the `Ty` arena rather than re-parsing `tyNameOf` — C1.
        if !inferQuiet && ret >= 0 {
          if n.fnRet < nodeTyIx.length { nodeTySet(n.fnRet, ret) }
        }
      }
    }
    // `f` is hoisted in the outer scope (checkProgram pre-pass), but re-declaring
    // it here covers nested function decls and is an idempotent rebind otherwise.
    // (An anonymous function EXPRESSION has no name to bind.)
    if n.fnName != "" { declare(n.fnName, mkFuncTy(paramTys, ret)) }
  } else if n.fnName != "" && (fnDeclIx[n.fnName] ?? -1) != fnIx {
    // A nested named function binds its pending signature before its body, as the top-level
    // hoist does, so a self-call resolves and `finishInferredReturn` patches this binding.
    declare(n.fnName, mkFuncTy(paramTys, -2))
  }
  // A generic nested in another function owns its parameter rows (D3853).
  const nestedDecl = n.fnName != ""
    && n.fnTyParams.length > 0
    && (fnDeclIx[n.fnName] ?? -1) != fnIx
  if nestedDecl {
    nestParentOfPut(fnIx, curFnDeclIx)
    for pt in paramTys { markNestRows(pt, n.fnTyParams, fnIx, 0) }
    markNestRows(ret, n.fnTyParams, fnIx, 0)
  }
  // Save the inference accumulators (a demand-inference can nest inside another
  // function's body check) and the enclosing return type.
  const savedObserved = inferObserved
  const savedObservedLit = inferObservedLit
  const savedSawErr = inferSawErr
  const savedRetLogLen = inferRetLogTy.length
  const savedVoidRetLen = inferVoidRetSites.length
  const savedDroppedLen = inferDroppedTy.length
  const cbBefore = cycleBreakCount
  const bbBefore = bareBraceCount
  const savedValueRet = fnSawValueRet
  const savedRetNatural = retNatural
  const savedRetNaturalErr = retNaturalErr
  const pinnedReads0 = lbiPinnedReads
  retNaturalSet(-1)
  retNaturalErrSet(false)
  if inferring {
    inferStack.push(inferKey)
    inferObservedSet(-1)
    inferObservedLitSet(true)
    inferSawErrSet(false)
    fnSawValueRetSet(false)
  }
  // A function body checked here can capture whatever narrowings are live around it, and
  // it runs later — so a narrowing installed before this point and retired after it would
  // be retired behind the capture's back. `narFnEpoch` is how the write side tells the two
  // apart (`writeStorageTy`).
  narFnEpoch = narFnEpoch + 1
  // The body keeps its own ledger; the enclosing function's rows, and the marks an enclosing
  // `if` holds into them, come back when it closes.
  const savedClobKeys = narClobKeys
  const savedClobTys = narClobTys
  const savedClobPrev = narClobPrev
  const savedClobDepths = narClobDepths
  const savedClobRetired = narClobRetired
  const savedClobBind = narClobBind
  const savedClobDecl = narClobDecl
  narClobKeysSet([])
  narClobTysSet([])
  narClobPrevSet([])
  narClobDepthsSet([])
  narClobRetiredSet([])
  narClobBindSet([])
  narClobDeclSet([])
  crFnEnter(fnIx)
  // Check the body in a fresh scope sharing the parameters.
  pushScope(n.fnBody)
  // A parameter shadows an enclosing binding's path narrowings for the body.
  if npKeys.length > 0 {
    let spi = 0
    while spi < params.length {
      const spn = P.nodes[params[spi]]
      if spn is Param { narShadowPaths(spn.parName, fnIx) }
      spi = spi + 1
    }
  }
  crCaptureWiden(fnIx)
  // Paired with the `flushInferRetHoles` below, which must run while this scope is still
  // live — `popScope` is what raises the uninferable-binding floor (D1591).
  pushInferRetHoles()
  // Owns the deferred constraints this body records, so a call site can tell whose type
  // parameters they speak about (`cstrOwnedBy`). Only a registered top-level declaration is
  // pushed: a nested function or lambda has no `fnDeclIx` entry for a call site to match
  // against, so its constraints stay owned by the enclosing named function.
  let cstrOwnerPushed = false
  const fsbCallsAt = fsbCallIx.length
  if n.fnName != "" {
    if (fnDeclIx[n.fnName] ?? -1) == fnIx {
      cstrOwnerStack.push(fnIx)
      cstrOwnerPushed = true
    }
  }
  // Keeps the function's type parameters in scope for the whole body, so a body annotation
  // that names one — a local `const out: T[]`, `const x: T` — resolves to an opaque `TyVar`
  // instead of failing "unknown type 'T'"; `resolveAnnot` alone only scopes typarams around
  // a single param/return annotation. The emitter substitutes the concrete type per instance (`monoCloneBody`).
  let tpBody = 0
  while tpBody < n.fnTyParams.length {
    tpEnvNames.push(n.fnTyParams[tpBody])
    tpEnvTys.push(mkTyVar(n.fnTyParams[tpBody]))
    if nestedDecl { tvNestOf.set(tpEnvTys[tpEnvTys.length - 1], fnIx) }
    // The parameter's bound, for the same span (OQ-5, strict bodies). A row is pushed even
    // when the parameter is unbounded (-1), so the two stacks stay one-to-one with
    // `fnTyParams` and an unbounded `<T>` shadows an enclosing bounded `T` rather than
    // inheriting its bound — `tpEnv`'s own innermost-wins rule.
    tpBoundNamesPush(n.fnTyParams[tpBody])
    tpBoundAnnsPush(fnTpBoundOf(fnIx, tpBody))
    tpBody = tpBody + 1
  }
  // Definite-assignment: a function body is its own flow context — it runs at call time,
  // not at the declaration site, so a nested function capturing an outer still-unassigned
  // `let x` must not be flagged (the call may happen after `x` is written). The body checks in
  // its own frame, against an empty live set; `daLeaveFrame` restores the enclosing path.
  const daSavedUnassigned = daEnterFrame()
  const savedRet = T.curRet
  T.curRet = ret
  const savedInRetArg = inRetArg
  inRetArgSet(false)
  // D1045: the name the nominal-escape refusal puts in its sentence. An anonymous
  // lambda keeps the ENCLOSING function's name, which is the scope the declaration
  // is actually inside.
  const savedEscName = curFnEscName
  if n.fnName != "" { curFnEscNameSet(n.fnName) }
  const savedFnDeclIx = curFnDeclIx
  curFnDeclIx = fnIx
  const savedNjFn = njFnIx
  njFnIxSet(fnIx)
  // Why this body's return type is void, for the return that disagrees with it: nobody wrote
  // `: void`, so the mismatch has to name the bare `return` that decided it.
  const savedBareRetVoid = curFnBareRetVoid
  curFnBareRetVoidSet(bareRetVoid)
  // The function name binds in the OUTER scope (decl-scope chain), but its body — params +
  // statements — is checked under this pushed scope. Bound in every compile, not only the
  // LSP's: the binding-identity column resolves through the same chain.
  // The audit's must-fire control switches both sites off, in a compile only.
  const declSites = identAuditDrop != IDENT_DROP_FN_DECL || symEnabled != 0
  if n.fnName != "" && fnIx >= 0 && declSites {
    symDeclInOuter(n.fnName, fnIx, mkFuncTy(paramTys, ret), 2)
  }
  let dj = 0
  while dj < params.length {
    const pNode2 = P.nodes[params[dj]]
    if pNode2 is Param {
      declare(pNode2.parName, paramTys[dj])
      // D1048's second hint: the parameter's annotation collapsed, so the binding the
      // body sees carries the loss. Marked HERE and not at the resolution because the
      // mark is keyed by the scope frame, and that frame is this one.
      if paramCollapsed[dj] { markCollapsedBinding(pNode2.parName) }
      if declSites { symDecl(pNode2.parName, params[dj], paramTys[dj], 1) }
    }
    dj = dj + 1
  }
  if params.length == 1 {
    const pn1 = P.nodes[params[0]]
    if pn1 is Param { narrowFreshBinding(pn1.parName, fnIx) }
  }
  checkParamNestedFnClash(n, params)
  const body = P.nodes[n.fnBody]
  const savedStmtBlk = chkStmtBlk
  chkStmtBlkSet(n.fnBody)
  if body is Block {
    const stmts = body.blkStmts
    let s = 0
    while s < stmts.length {
      // The LAST statement's value is this function's implicit return. Under inference,
      // mark it as the return-tail position so a tail `if`/`else`'s base-case branch
      // seeds `inferObserved` before a recursive sibling branch is checked.
      const savedRTPbody = retTailPos
      if s == stmts.length - 1 && inferring {
        retTailPosSet(true)
      } else {
        retTailPosSet(false)
      }
      // The implicit return is seeded with the declared type, exactly as the explicit one is
      // (`checkRetStmtNode`) — otherwise a narrower literal types at its default instead. An
      // unreachable tail (`return 1  print(9)`, two statements on one line) is not the implicit
      // return, so neither seeding nor checking may treat it as the returned expression.
      let tailIsReturn = s == stmts.length - 1
      if tailIsReturn && s > 0 {
        if stmtAlwaysExits(stmts[s - 1]) { tailIsReturn = false }
      }
      if tailIsReturn && !inferring && ret >= 0 {
        if !isStmtNode(stmts[s]) || P.nodes[stmts[s]] is IfStmt {
          seedTailArms(stmts[s], ret)
        }
      }
      // A statement before the tail, or the tail of a void body, is discarded.
      if s < stmts.length - 1 || (!inferring && isVoidTy(ret)) {
        markValDiscard(stmts[s])
      } else if tailIsReturn && tpEnvNames.length > 0 {
        tpIfMarkOk(stmts[s])
      }
      crStmtEnter(stmts[s])
      const savedSpine = spineAt
      spineAtSet(-1)
      if s == stmts.length - 1 { spineAtSet(stmts[s]) }
      const stTy = checkNode(stmts[s])
      spineAtSet(savedSpine)
      crStmtLeave()
      retTailPosSet(savedRTPbody)
      if ucVoided && tailIsReturn {
        ucShowRet = discardedTailTy(stmts[s], stTy)
      }
      // The trailing expression is the implicit return; under inference it is a
      // return-type witness. With a CONCRETE annotated return, a trailing empty
      // collection (`mk(): i32[] { … inner }`) pins its element from the return
      // type here — before the body scope is popped (and `inner`'s floor checked).
      if s == stmts.length - 1 {
        // Checked against the return type through `assignableExpr`, not bare `assignable`, so
        // the same coercions a declared-type binding grants (a literal widening) apply here too,
        // matching an explicit `return <expr>` — the bare trailing expression, which is the
        // implicit return, needs the identical check.
        if !inferring && tailIsReturn {
          if ret >= 0 && !isVoidTy(ret) && ret != TY_ERR {
            clearTailVerdict(stmts[s])
          }
          if ret >= 0 {
            // A tail `if` is a statement node, so its arms' `{}` reach no `assignableExpr`.
            if isStmtNode(stmts[s]) {
              bareBraceDeliver(stmts[s], ret, 8, false)
            }
            if !isStmtNode(stmts[s]) {
              // A `never` body is graded whole below, not by its tail's value.
              if !isVoidTy(ret) && ret != TY_NEVER {
                if !assignableExpr(stmts[s], stTy, ret) {
                  tErrWant(
                    "expected "
                      + tyToStr(ret)
                      + ", got "
                      + tyToStr(stTy)
                      + boolForNumberNote(stTy, ret)
                      + numUnionLossNote(stTy, ret)
                      + storageListNote(stmts[s], stTy, ret)
                      + litMemberNote(stmts[s], ret, 8),
                    stmts[s],
                    ret,
                  )
                } else {
                  // The check above is vacuous whenever a side is a hole, exactly as the
                  // explicit `return`'s is — so the implicit return records the same pair for
                  // the pin to re-ask under substitution. Without it a generic's TAIL
                  // expression loses the refusal its `return` spelling makes (D1739).
                  noteRetCstr(coalPinTy(stmts[s], stTy), ret, stmts[s])
                }
              }
            } else if P.nodes[stmts[s]] is IfStmt {
              // A tail `if`/`else` — or the chain a tail `match` desugared to — is a statement
              // node, but under a non-void return each arm's value is the return (D2234).
              if !isVoidTy(ret) && ret != TY_NEVER {
                checkTailArmsAgainst(stmts[s], ret)
              }
            }
          }
        }
        if inferring {
          // A value-producing trailing expression is a value return POSITION (vs a
          // bare trailing statement); the redundant-return fixpoint defers only these.
          if !isStmtNode(stmts[s]) { fnSawValueRetSet(true) }
          // D1045 — the IMPLICIT return of the same rule: the trailing expression
          // is what a caller receives, so a body-scoped nominal escapes here too.
          if !isStmtNode(stmts[s]) { refuseLocalNomEscape(stTy, stmts[s]) }
          // The IMPLICIT return of the deferred pin, for the reason the explicit one
          // states: under inference the destination is the join, not this witness (D1591).
          // A tail `if` with a value-less arm is a statement, so the body has no tail value.
          if !ifYieldsNoValue(stmts[s]) {
            noteInferRetWitness(stmts[s], stTy)
            inferRetNextLitSet(armLit(stTy, stmts[s]))
            noteInferredRet(
              ifTailValTyOf(stmts[s], inferRetTyOf(stmts[s], stTy)),
            )
          }
          // The soundness check for an inferred return: `inferObserved` is the join of the
          // returns just walked (the value type the chain infers), while the tail if-statement's
          // own type is void for an all-returning chain — so the accumulated join is what the
          // fall-through is checked against, refused the same as an annotation would (D1902).
          checkTrailingChainTotal(stmts[s], inferObserved)
        } else {
          // Redundant-return rule: witness the trailing expression's NATURAL type
          // (before constrainEmpty pins a hole); an annotation-influenced trailing
          // (empty `[]`/`Map()`, `null`) disqualifies the function.
          if (
            retInfluencedByAnnot(stmts[s])
            || retSiteTypedByAnnot(stmts[s], stTy)
          ) {
            retNaturalErrSet(true)
          }
          noteNaturalRet(stTy)
          constrainEmptyExpr(stmts[s], stTy, ret)
          // Soundness — missing-return / non-exhaustive fall-through: an else-less `is`-chain
          // that does not cover every variant lets a value fall off the end, refused for a
          // non-void declared return (D1902).
          checkTrailingChainTotal(stmts[s], ret)
        }
      }
      s = s + 1
    }
  }
  chkStmtBlkSet(savedStmtBlk)
  // Hover over an un-annotated param: the body has now recorded everything it demands of the
  // param hole, so re-retains the binding's type as that demand (the same disjunction the
  // call-arg diagnostic names) instead of the bare hole, which renders as an uninformative `_`.
  // Holes the body never constrained keep the `TyVar`, still skipped by the inlay-hint scan.
  if symEnabled != 0 && !inferQuiet {
    let hp = 0
    while hp < params.length {
      const hpNode = P.nodes[params[hp]]
      if hpNode is Param && paramTys[hp] >= 0 {
        const hpTy = T.tys[paramTys[hp]]
        if hpTy is TyVar {
          const hpDemand = holeDemandTy(hpTy.tvName)
          if hpDemand >= 0 { symRetainType(params[hp], hpDemand, 1) }
        }
      }
      hp = hp + 1
    }
  }
  // Capture body TOTALITY (missing-return soundness) while the body scope is still LIVE
  // — `ifCondIsDiscriminating` looks up a discriminated param/local's type, which the
  // `popScope` below would drop. The flag is consumed after `ret` is finalized.
  const bodyTotalForRet = nodeIsTotal(n.fnBody)
  // The editor shows an unread function's inferred return, not the `void` it lowers as.
  if ucVoided && symEnabled != 0 && ucShowRet >= 0 && ucShowRet != TY_ERR {
    symRetainType(fnIx, mkFuncTy(paramTys, ucShowRet), 2)
  }
  T.curRet = savedRet
  inRetArgSet(savedInRetArg)
  curFnEscNameSet(savedEscName)
  curFnDeclIx = savedFnDeclIx
  njFnIxSet(savedNjFn)
  curFnBareRetVoidSet(savedBareRetVoid)
  daLeaveFrame(daSavedUnassigned)
  // A write after a call in source order (a loop's back edge) is re-asked here, inside this body,
  // so a pair naming its type parameter is deferred to its instances as at the call.
  let fsbC = fsbCallsAt
  while fsbC < fsbCallIx.length {
    fsbRecheckFrom(fsbC)
    fsbC = fsbC + 1
  }
  let tpPop = 0
  while tpPop < n.fnTyParams.length {
    tpEnvNames.pop()
    tpEnvTys.pop()
    tpBoundNamesPop()
    tpBoundAnnsPop()
    tpPop = tpPop + 1
  }
  if cstrOwnerPushed { cstrOwnerStack.pop() }
  // Every return witness is in, so the inferred return type is final — pin the empty
  // collections this body delivered to it, BEFORE `popScope` grades their bindings. An
  // ANNOTATED body recorded nothing (those positions pin at the delivery) (D1591).
  flushInferRetHoles()
  popScope()
  crFnLeave()
  narClobKeysSet(savedClobKeys)
  narClobTysSet(savedClobTys)
  narClobPrevSet(savedClobPrev)
  narClobDepthsSet(savedClobDepths)
  narClobRetiredSet(savedClobRetired)
  narClobBindSet(savedClobBind)
  narClobDeclSet(savedClobDecl)
  if !inferQuiet {
    // Marks only the registered top-level decl (not a nested/shadowing namesake).
    if n.fnName != "" && (fnDeclIx[n.fnName] ?? -1) == fnIx {
      bodyChecked[n.fnName] = true
    }
  }
  if inferring && inferObserved >= 0 {
    let dk = savedDroppedLen
    while dk < inferDroppedTy.length {
      inferRetJoin(inferDroppedTy[dk], inferDroppedLit[dk])
      dk = dk + 1
    }
  }
  while inferDroppedTy.length > savedDroppedLen {
    inferDroppedTy.pop()
    inferDroppedLit.pop()
  }
  inferObservedSet(inferRetF32Join(inferring, inferObserved))
  if inferring {
    ret = finishInferredReturn(
      n,
      fnIx,
      paramTys,
      paramUninferable || bareBraceCount > bbBefore,
      cbBefore,
      savedObserved,
      savedSawErr,
      savedValueRet,
      bodyTotalForRet,
    )
    inferObservedLitSet(savedObservedLit)
    // Inferred non-void after all: the tail's value arms return (`clearTailVerdict`).
    if ret >= 0 && !isVoidTy(ret) && ret != TY_ERR {
      clearTailVerdict(blockLastStmt(n.fnBody))
    }
  }
  refuseVoidRetsFrom(savedVoidRetLen, ret)
  // This body's witnesses belong to its own inference, not to an enclosing `if`'s replay.
  while inferRetLogTy.length > savedRetLogLen {
    inferRetLogTy.pop()
    inferRetLogSeed.pop()
    inferRetLogLit.pop()
  }
  // Soundness — missing return: a function whose body can fall off the end without yielding a
  // value on some path implicitly produces `null`, sound only when `null` is part of the
  // return type. Asks whether the whole type admits `null` (`tyBearsNull`, recursive), not
  // just its top node — a union that reaches `null` through a member needs this too. Suppressed in the pre-pass and on a void/error return.
  let retNullableNow = false
  if ret >= 0 { retNullableNow = tyBearsNull(ret) }
  // A `never` function has no value to return: every path must end in a call that never
  // returns, which is the shared exit rule over the whole body (D1972).
  if !inferQuiet && ret == TY_NEVER && ret >= 0 && !stmtAlwaysExits(n.fnBody) {
    let who = "this function"
    if n.fnName != "" { who = "`" + n.fnName + "`" }
    tErr(
      who
        + " is declared `never` but can return — end every path in a call that never returns, such as `__trap__()`",
      n.fnBody,
    )
  }
  if (
    !inferQuiet
    && !isVoidTy(ret)
    && ret != TY_NEVER
    && ret != TY_ERR
    && !bodyTotalForRet
    && !retNullableNow
  ) {
    const bn = braceNameTail(n.fnBody)
    if bn >= 0 && braceNameNote(bn, ret) != "" {
      const bnm = P.nodes[bn]
      let nm = ""
      if bnm is Ident { nm = bnm.identName }
      tErr(
        "`{ "
          + nm
          + " }` here is a block, not a record — write `return { "
          + nm
          + " }` or `({ "
          + nm
          + " })`",
        bn,
      )
    } else {
      tErr(
        "not all code paths return a value in '"
          + n.fnName
          + "' — add a `return`, or annotate the return type `| null` to fall through",
        n.fnBody,
      )
    }
  }
  // Redundant return annotation: the body's natural inferred return already equals the
  // explicit `: T`, so removing it yields the identical type. Conservative: a single
  // concrete observed return rendering identically to `ret`; a hole / error / `never` /
  // an annotation-influenced return is skipped, and this never fires under the pre-pass.
  if (
    !inferring
    && !inferQuiet
    && n.fnRet >= 0
    && retNatural >= 0
    && !retNaturalErr
  ) {
    if !inlayHole(retNatural) && !isNeverTy(retNatural) && ret != TY_ERR {
      // A bare `return` in the body makes the un-annotated spelling void, so the annotation
      // is load-bearing however well its type matches the tail (D1600).
      const pinned = lbiPinnedReads != pinnedReads0
      if tyEq(retNatural, ret) && !blockHasBareReturn(n.fnBody) && !pinned {
        recordRedundantRet(n, fnIx, ret)
      }
    }
  }
  retNaturalSet(savedRetNatural)
  retNaturalErrSet(savedRetNaturalErr)
  // Inferred type guard (A6b, host parity — degenerate case): a NAMED function
  // whose body's RESULT is exactly a null-test on one of its params registers
  // as a guard, so calling it in a condition narrows the argument (inline,
  // UFCS, and the guard-clause form).
  if n.fnName != "" {
    const gBody = P.nodes[n.fnBody]
    if gBody is Block {
      const gStmts = gBody.blkStmts
      if gStmts.length > 0 {
        const gLastIx = gStmts[gStmts.length - 1]
        const gLast = P.nodes[gLastIx]
        let gResIx = gLastIx
        if gLast is RetStmt { gResIx = gLast.retArg }
        if gResIx >= 0 {
          const gParamNames: string[] = []
          let gp = 0
          while gp < params.length {
            const gpn = P.nodes[params[gp]]
            if gpn is Param {
              gParamNames.push(gpn.parName)
            } else {
              gParamNames.push("")
            }
            gp = gp + 1
          }
          const gFact = guardFactOf(gResIx, gParamNames)
          if gFact >= 0 {
            const gThen = gFact - gFact / 2 * 2
            guardNamesPush(n.fnName)
            guardParamIdxsPush(gFact / 2)
            guardThensPush(gThen)
          }
        }
      }
    }
  }
  // The function's own type — a FuncDecl in EXPRESSION position (a lambda, or a
  // named function referenced as a value) evaluates to it.
  mkFuncTy(paramTys, ret)
}

// The program root: pass 0 registers `type` declarations (structs, then unions over
// them), pass 1 hoists function signatures (call-before-decl + mutual recursion),
// pass 2 checks every top-level statement.
function checkProgramNode(n: Program) {
  const stmts = n.progStmts
  // Pass 0: registers top-level struct `type` declarations before anything else, so a struct
  // name in a param/return/let annotation or a later struct's field resolves via `nameToTy`.
  // Pass 0a pre-registers every top-level `type` name with an empty placeholder (struct or
  // union) so self- and forward-references inside field annotations and union variants resolve, filled in pass 0b.
  let t0 = 0
  while t0 < stmts.length {
    const sd0 = P.nodes[stmts[t0]]
    // A `type` declaration may not take a built-in type name: the checker resolves a bare
    // name through `tsLeafTy`, which asks `primTyOfName` first, so `f64` in an annotation is
    // the primitive while nothing screened the declaration side — a reject, not a resolution
    // change, since making one side win would silently redefine a keyword inside one file (D1585).
    if sd0 is TypeDecl {
      if isBuiltinTyName(sd0.tdName) {
        tErrBuiltinTyDecl(sd0.tdName, stmts[t0])
      }
    }
    if sd0 is UnionDecl {
      if isBuiltinTyName(sd0.udName) {
        tErrBuiltinTyDecl(sd0.udName, stmts[t0])
      }
    }
    if sd0 is TypeDecl {
      // A bound alias (`type Showable = { toString(): string }`) registers in
      // `cBoundDecls`, not `cUserTypes` — it constrains a type parameter and has no
      // values, so a type-arena entry would make it spellable in value position, which
      // the trait-object design rules out. `declaredTyOfName` turns such a use into a sentence instead.
      const bAnn0 = declBoundOf(stmts[t0])
      if bAnn0 >= 0 {
        cBoundDeclsSetAt(sd0.tdName, bAnn0)
        t0 = t0 + 1
        continue
      }
      // A generic alias (`type Box<T> = …`) registers in the generic-alias registry, not
      // `cUserTypes`, since it has no concrete type until applied — pass 0b skips it, and each
      // application resolves its fields under the param→argument bindings (`applyGenAlias`).
      // The nominal-newtype declaration fact is recorded now regardless, honoured only on the concrete arm below.
      const gBase = declGpBaseOf(stmts[t0])
      if gBase != "" {
        gaNames.push(gBase)
        gaDeclIxs.push(stmts[t0])
        // D-GAPARAM: the parameter list is banked ONCE, here, into the flat
        // column. Master re-split the joined string inside `applyGenAliasArgs`,
        // i.e. once per APPLICATION of the alias; the list is a property of the
        // DECLARATION and cannot change between applications.
        const gps = declGpParamsOf(stmts[t0])
        gaParamStart.push(gaParamNames.length)
        gaParamCount.push(gps.length)
        let gpi = 0
        while gpi < gps.length {
          gaParamNames.push(gps[gpi])
          gpi = gpi + 1
        }
      } else {
        // A bodyless alias (parser sentinel `tdFields == [-1]`) registers as the error type,
        // since the parser already reported it; a real body builds an object placeholder pass
        // 0b fills. Banked in the fill registry so a forward reference can demand its shape
        // early — absent for a generic alias, which resolves under its own bindings instead.
        cFillStmtIx[sd0.tdName] = stmts[t0]
        const df0 = sd0.tdFields
        const bodyless0 = df0.length == 1 && df0[0] == (-1)
        if bodyless0 {
          cUserTypes[sd0.tdName] = TY_ERR
          cUserTypesVer = cUserTypesVer + 1
        } else {
          const fnames0: string[] = []
          const ftys0: i32[] = []
          const sIx0 = mkObjTy(fnames0, ftys0)
          cUserTypes[sd0.tdName] = sIx0
          cUserTypesVer = cUserTypesVer + 1
          cStructPush(sIx0, sd0.tdName)
          if sd0.tdNew == 1 {
            nwDeclNames.push(sd0.tdName)
            if isBodyTyDecl(stmts[t0]) { nwBodyScopedNamesSetAt(sd0.tdName, 1) }
          }
        }
      }
    } else if sd0 is UnionDecl {
      // A one-member alias whose body is a plain type reference is transparent — decided
      // here in pass 0a since the question is syntactic (the arena cannot tell it from a
      // canonicalized intersection) and both readers run later. A self-cycle (`type D = D`)
      // is excluded: it is the degenerate never-type pass 0b reports, and resolving it transparently would chase its own placeholder.
      const uvs0 = sd0.udVariants
      if uvs0.length == 1 && uvs0[0] != sd0.udName {
        if aliasRefIsPlainRoot(udTsRootAt(stmts[t0], 0)) {
          cPlainAliasNames.push(sd0.udName)
        }
      }
      cFillStmtIx[sd0.udName] = stmts[t0]
      const members0: i32[] = []
      const uIx0 = mkUnionTy(members0)
      cUserTypes[sd0.udName] = uIx0
      cUserTypesVer = cUserTypesVer + 1
      cTyIxSetAdd(cUnionTyIxs, cUnionTyIxSet, uIx0)
      cUnionNames.push(sd0.udName)
      if sd0.udNew == 1 {
        nwDeclNames.push(sd0.udName)
        if isBodyTyDecl(stmts[t0]) { nwBodyScopedNamesSetAt(sd0.udName, 1) }
      }
    }
    t0 = t0 + 1
  }
  // Pass 0b: resolves each declaration's fields/variants into the placeholder, in demand
  // order rather than source order — `fillTypeDeclAt` re-enters from `declaredTyOfName`
  // whenever a body names a declaration the walk has not reached, so a forward reference
  // resolves against the filled shape regardless of which declaration came first.
  cFillDoneAtSet([])
  cFillActiveSet(true)
  // A pure string-literal union alias fills ahead of the driver, because the reference to it
  // is by member set, not by name (D1151): an inline `{ k: "a" | "b" }` reaches for the alias
  // through `litUnionAliasTyOfMembers`, which scans for a filled litunion with exactly these
  // members — so an un-filled placeholder would mint a second, unregistered union for the same spelling.
  let li = 0
  while li < stmts.length {
    const ls = P.nodes[stmts[li]]
    if ls is UnionDecl {
      if udVariantsAllStrLit(ls.udVariants) { fillTypeDeclAt(stmts[li]) }
    }
    li = li + 1
  }
  let ti = 0
  while ti < stmts.length {
    fillTypeDeclAt(stmts[ti])
    ti = ti + 1
  }
  cFillActiveSet(false)
  // Pass 0c: MEASURE every `flat type` (webcraft P1.2). Runs here because it needs
  // pass 0b's resolved field types (a scalar's width is read off the arena, which
  // is what makes a newtype over a scalar work for free) and must precede any
  // expression checking, since `N.size` / `N.field` fold against this sidecar.
  resolveFlatLayouts(stmts)
  // Pass 0d: refuse a declared union whose set and map arms clash. Runs after 0b has filled
  // every arm, since a declaration cycle can leave a member a placeholder inside the fill.
  checkUnionSetMapClash(stmts)
  // Pass 1: hoist top-level function signatures so call-before-decl and mutual
  // recursion type-check.
  let hi = 0
  while hi < stmts.length {
    const s = P.nodes[stmts[hi]]
    // D1645 — a nameless `FuncDecl` is an arrow lambda at statement position, an
    // expression whose value is discarded: it binds no name, so nothing hoists it.
    // `declare("")` files every one of them under one key, which reports the second as
    // `redeclared` with a blank name and banks a pending return nothing patches.
    if s is FuncDecl && s.fnName.length > 0 {
      // A SECOND top-level `function` of the same name is a redeclaration error,
      // exactly like a duplicate `let`/`const` (B16). Without this the later
      // hoist silently overwrites the earlier one and the last body wins.
      if (fnDeclIx[s.fnName] ?? -1) >= 0 {
        // `opDeclLabel` is the identity on an ordinary name; an index operator
        // reads back as `"[]" for F32View` rather than as its minted spelling.
        tErr("redeclared " + getDeclLabel(opDeclLabel(s.fnName)), stmts[hi])
      }
      const hp = s.fnParams
      const hpt: i32[] = []
      let k = 0
      while k < hp.length {
        const hpn = P.nodes[hp[k]]
        let t = TY_ERR
        if hpn is Param {
          if hpn.parType >= 0 {
            const hptn = P.nodes[hpn.parType]
            if hptn is TypeRef {
              const r = resolveAnnotAt(
                hptn.tyName,
                s.fnTyParams,
                hpn.parType,
                s.fnName,
              )
              if r >= 0 { t = r }
            }
          } else {
            // An un-annotated param hoists as its inference hole (the same declaration+
            // position name `checkFuncDeclNode` mints, so a forward call binds the identical
            // hole by name) — or as the type pass 1.8's solve pinned it to, via
            // `unannotParamTy`, which keeps this hoist and the body from disagreeing.
            t = unannotParamTy(paramHoleName(s.fnName, stmts[hi], k))
          }
        }
        hpt.push(t)
        k = k + 1
      }
      // An UN-ANNOTATED return hoists as the PENDING sentinel (-2): the real type
      // is inferred from the body in pass 2 (or on demand at a forward call site),
      // then PATCHED into this same TyFunc in place.
      let hret = -2
      if s.fnRet >= 0 {
        const hrtn = P.nodes[s.fnRet]
        if hrtn is TypeRef {
          const r = resolveRetAnnotAt(
            hrtn.tyName,
            s.fnTyParams,
            s.fnRet,
            s.fnName,
          )
          // D1048's second hint, recorded order-independently: this hoist is the only pass
          // that resolves every top-level return before any body runs, so a `const r = f(…)`
          // written above `function f(): R` still inherits the provenance.
          if r >= 0 && r == collapsedTy { markCollapsedRet(stmts[hi]) }
          if r >= 0 { hret = r } else { hret = TY_VOID }
        }
      }
      // A result no caller reads is not returned: hoisted as the `: void` it is checked as.
      if hret == (-2) && fnResultUnconsumed(stmts[hi]) { hret = TY_VOID }
      declare(s.fnName, mkFuncTy(hpt, hret))
      fnDeclIx[s.fnName] = stmts[hi]
      declareFnDeclNode(s.fnName, stmts[hi])
      // A getter registers under its receiver type, the only route by which a read finds it.
      const gProp = getDeclPropOf(s.fnName)
      if gProp != "" && hpt.length == 1 {
        getFns.push(s.fnName)
        getProps.push(gProp)
        getDecls.push(stmts[hi])
        getSelfTys.push(hpt[0])
      }
      // REGISTER a free index operator (B14). Its ARITY is fixed by the operator
      // — `"[]"` is (self, index), `"[]="` is (self, index, value) — and checking
      // it here means a malformed declaration is reported once, at itself, rather
      // than at every use site that fails to resolve.
      const opk = opDeclOpOf(s.fnName)
      if opk == OP_INDEX_GET || opk == OP_INDEX_SET {
        let want = 2
        if opk == OP_INDEX_SET { want = 3 }
        if hp.length != want {
          tErr(
            "operator "
              + opDeclLabel(s.fnName)
              + " takes "
              + i32ToStr(want)
              + " parameters (self, index"
              + opIdxArityTail(opk)
              + "), got "
              + i32ToStr(hp.length),
            stmts[hi],
          )
        } else if opIdxDeadRecv(hpt[0]) {
          // The swallow, said out loud (D445): indexing an array, a map or a string is the
          // language's, never a user operator's, so a declaration over one of them is not a
          // dispatch that fails to happen — it is one the language already decided will never
          // happen, named here at the declaration rather than silently at every use site.
          tErr(
            "operator "
              + opDeclLabel(s.fnName)
              + " can never dispatch: indexing "
              + tyToStr(hpt[0])
              + " is the language's own, never a user operator's",
            stmts[hi],
          )
        } else {
          opIdxOps.push(opk)
          opIdxFns.push(s.fnName)
        }
      } else if isBinOpDecl(s.fnName) {
        // A BINARY operator: register it under its SYMBOL in the operator table `opSelfFnTy`'s
        // receiver scan reads, so several receiver types can each define the symbol and
        // dispatch resolves by the left operand's type (B14 generalized). Both a receiver-keyed
        // `+@Vec3` and a bare `+` (unannotated/hole `self`) register under `+` (D1934).
        let binSym = s.fnName
        if opk != "" { binSym = opk }
        opIdxOps.push(binSym)
        opIdxFns.push(s.fnName)
      }
      // The swallow at the binary operators, said out loud (D425) — the twin of the index
      // gate above: `checkBinary` reaches `opSelfFnTy` only when the left operand is an
      // object, so a declaration whose `self` is not one is not a dispatch that fails, it is
      // one the language already decided will never happen. Disjoint from D471's first-parameter-name gate (checked in the parser), so a declaration failing both gets the name diagnostic only.
      if isBinOpDecl(s.fnName) {
        if hp.length == 2 {
          let selfNamed = false
          // Whether `self` carries an ANNOTATION at all (D491) — read inside the `is
          // Param` narrowing, which is the only place the field exists.
          let selfAnn = false
          const bp0 = P.nodes[hp[0]]
          if bp0 is Param {
            if bp0.parName == "self" { selfNamed = true }
            if bp0.parType >= 0 { selfAnn = true }
          }
          if selfNamed {
            if binOpDeadSelf(hpt[0]) {
              tErr(
                "operator `"
                  + opDeclLabelBin(s.fnName)
                  + "` can never dispatch: `self` is the LEFT OPERAND and dispatch needs an object, but "
                  + tyToStr(hpt[0])
                  + " is not one",
                stmts[hi],
              )
            } else {
              // The hole this gate subtracts (D491) is banked, not judged — whether this
              // declaration fires is decided at the sites (`checkProgramEndOpDecls`). Both hole
              // spellings are banked as one population: `function "+"(self, other)` hoists its
              // parameter as a fresh type variable, so `tyHasHole` is true of it exactly as of `self: T` (D521).
              if hpt[0] >= 0 {
                if tyHasHole(hpt[0]) {
                  // Banked under the bare SYMBOL, not the receiver-keyed decl name: D491 is a
                  // whole-program question ("does this operator ever dispatch"), and the site
                  // side (`opBinSiteTook`) records the symbol, so both halves must key alike. A
                  // `self: T` op mints `+@T` but the question it answers is about `+`.
                  const holeSym = opDeclOpOf(s.fnName)
                  let holeKey = s.fnName
                  if holeSym != "" { holeKey = holeSym }
                  opBinHoleDeclNamePush(holeKey)
                  opBinHoleDeclNodePush(stmts[hi])
                  opBinHoleDeclAnnPush(selfAnn)
                }
              }
            }
          }
        }
      }
      // Collect un-annotated returns (hoisted as the `-2` pending sentinel) for the
      // return-inference pre-pass.
      if hret == (-2) { topUnannotFns.push(stmts[hi]) }
      // Completion visibility: a top-level function is global. Stamped here (only
      // the global scope is open) so it wins over any later demand-inference
      // re-entry, which would run the body from a deeper stack (see `symStampVis`).
      if symEnabled != 0 {
        symStampVis(s.fnName, stmts[hi], 2, scopeSL.length - 1)
      }
    }
    hi = hi + 1
  }
  // Pass 1.5 hoists top-level value bindings (names + types) so a function body sees every
  // module-level value regardless of source order, making the module scope order-independent.
  // Initialization order still matters for straight-line top-level code — each global joins
  // the definite-assignment dead-zone here — but a function body runs at call time, so a deferred read from inside one is correctly not flagged.
  lbiScanModLits(stmts)
  modClashNamesSet(Map())
  let mi = 0
  const phLets: i32[] = []
  while mi < stmts.length {
    const sm = P.nodes[stmts[mi]]
    if sm is LetDecl {
      // A top-level `function` and a top-level value binding share one scope and one
      // namespace, so the pair is the redeclaration the two same-kind rules already refuse
      // and a module merge refuses at parse. Anchored at the LATER declaration, since the
      // two hoists run in kind order and not in source order (D1661).
      const xfn = fnDeclIx[sm.letName] ?? -1
      if xfn >= 0 && !(moduleGlobals[sm.letName] ?? false) {
        let at = stmts[mi]
        if xfn > at { at = xfn }
        tErr("redeclared " + sm.letName, at)
        modClashNames[sm.letName] = true
      }
      if moduleGlobals[sm.letName] ?? false {
        // A genuine top-level redeclaration — reported here (pass 2 skips its own
        // redeclare check for module globals, since the hoist owns the declaration).
        tErr("redeclared " + sm.letName, stmts[mi])
      } else {
        let mty = TY_ERR
        if sm.letType >= 0 {
          const mtn = P.nodes[sm.letType]
          if mtn is TypeRef {
            const r = nameToTyAt(mtn.tyName, sm.letType)
            if r >= 0 { mty = r }
          }
        } else if sm.letInit >= 0 {
          // Un-annotated: peeks only at a literal initializer (side-effect free). A `checkNode`
          // here would prematurely demand-infer callees and patch their hoisted return types,
          // corrupting the real pass-2 result, so a non-literal init stays an error placeholder
          // that pass 2 overwrites with its real type.
          const initN = P.nodes[sm.letInit]
          if initN is NumLit {
            if numLexIsFloat(initN.numText) { mty = TY_F64 }
            else if numLexFitsI32(initN.numText) { mty = TY_I32 }
            else { mty = TY_I64 }
          } else if initN is StrLit {
            mty = TY_STR
            if sm.letKw == "const" {
              mty = mkWideStrLitTy(initN.strText, TY_STR)
            }
          } else if initN is CharLit {
            mty = TY_I32
          } else if initN is BoolLit {
            mty = TY_BOOL
          }
        }
        declare(sm.letName, mty)
        if sm.letKw == "const" { moduleConstDecl[sm.letName] = stmts[mi] }
        if mty == TY_ERR && sm.letType < 0 && sm.letInit >= 0 {
          phLets.push(stmts[mi])
        }
        if letDeclIsUnannotObjLit(stmts[mi]) {
          markObjLitBinding(sm.letName, 0)
        }
        if letDeclIsUnannotCtnLit(stmts[mi]) {
          markCtnLitBinding(sm.letName, 0, sm.letInit)
        }
        markNumLitBinding(sm.letName, 0, stmts[mi])
        let lbiTy0 = mty
        if sm.letType < 0 && sm.letInit >= 0 {
          const lit0 = lbiInitLit(sm.letInit)
          if lit0 >= 0 { lbiTy0 = lbiLitDefault(lit0) }
        }
        lbiMark(sm.letName, 0, stmts[mi], lbiTy0)
        markFnLitBinding(sm.letName, 0, stmts[mi])
        moduleGlobals[sm.letName] = true
        if sm.letKw == "const" && sm.letInit >= 0 {
          const cin = P.nodes[parenPeelIx(sm.letInit)]
          if cin is NumLit {
            if !numLexIsFloat(cin.numText) {
              moduleConstIntInitSetAt(sm.letName, parenPeelIx(sm.letInit))
            }
          }
        }
        // TDZ: in the dead-zone until pass 2 reaches the initializer.
        daAdd(sm.letName)
        moduleBeforeDecl[sm.letName] = stmts[mi]
      }
    }
    mi = mi + 1
  }
  // Pass 1.6: solve every un-annotated PARAMETER from its body's usage, BEFORE any
  // expression is checked — so a call site binds the solved parameter type whatever
  // the source order, and before pass 1.7 infers returns against it. See
  // `solvedParamTys`.
  let sp = 0
  while sp < stmts.length {
    const sps = P.nodes[stmts[sp]]
    if sps is FuncDecl { solveUnannotParams(stmts[sp]) }
    sp = sp + 1
  }
  globalInitPrePass(phLets)
  // Pass 1.7: return-inference pre-pass — resolve every un-annotated return (cycles
  // included, via the binding-group fixpoint) BEFORE checking bodies, so pass 2 sees
  // final return types and a recursive function needs no return annotation.
  inferReturnsPrePass()
  // Pass 1.9: the generic bodies pass 2 walks for their constraints (`cstrProbeBefore`).
  cstrPrePass(stmts)
  // Pass 2: check every top-level statement (bodies included).
  let j = 0
  while j < stmts.length {
    cstrProbeBefore(stmts[j])
    markValDiscard(stmts[j])
    crStmtEnter(stmts[j])
    checkNode(stmts[j])
    crStmtLeave()
    j = j + 1
  }
  // A function whose return never resolved (a genuinely base-case-less recursive
  // cycle) — the fixpoint found no concrete basis. Reported here, after the real
  // pass (the pre-pass suppressed it).
  let uf = 0
  while uf < unresolvedFns.length {
    const ufIx = fnDeclIx[unresolvedFns[uf]] ?? -1
    if ufIx >= 0 {
      const ufn = P.nodes[ufIx]
      if ufn is FuncDecl {
        inferNoBasisErr(unresolvedFns[uf], ufIx, ufn.fnBody)
      }
    }
    uf = uf + 1
  }
  bareBraceUndelivered()
  // LAST, because both of its filters read state this pass fills — see its header.
  annCommitVariantMembers()
  TY_VOID
}

// ── bare `{}` (D2223) ───────────────────────────────────────────────────────
// `{}` is the record literal with every field omitted, so it needs an expected record type
// whose fields all admit `null`. Deliveries mark it (`bareBraceDeliver`); what no delivery
// reached is refused after the last body is checked.

// —— the Node visitor (dispatch; per-kind helpers above take narrowed variants) ——
// Thin recording wrapper around `checkNodeReal`: on the real (non-quiet) pass, stores each
// node's resolved type-arena index into the typed-IR table. Recording the arena index, not a
// snapshot, means a hole pinned later in place is reflected when the emitter reads it back — last write wins.
export function checkNode(ix: i32) {
  const savedTail = retTailPos
  if retTailPos {
    if !tailSpineNode(ix) {
      if P.nodes[ix] is MatchExpr { matchTailNodeSet(ix) }
      retTailPosSet(false)
    }
  }
  const t = checkNodeReal(ix)
  if expObsFn >= 0 { expObsRead(ix, t) }
  checkNodeDone(ix, t, savedTail)
  t
}

// Dispatches every node kind — expressions and statements — and returns the node's
// type-arena index (statements yield `TY_VOID`). Every per-variant body is inlined here,
// including the nested `TypeRef`/`Param`/`Block` narrowing, since no other function may
// narrow `Node`. On a type error it raises a diagnostic and returns `TY_ERR` so checking continues.
function checkNodeReal(ix: i32) {
  if ix < 0 { return TY_ERR }
  if symEnabled != 0 && lbiInlinedName.length > 0 { lbiSymRead(ix) }
  const n = P.nodes[ix]

  // ── literals & identifiers ────────────────────────────────────────────────
  if n is NumLit {
    // A literal with a "." is f64. An integer literal defaults to the NARROWEST
    // type that holds it exactly — i32 if its magnitude fits, else i64 — the
    // host's `defaultIntegerType` rule (`numLexFitsI32`).
    if numLexIsFloat(n.numText) {
      // A literal whose magnitude rounds past the largest finite double names a value f64
      // cannot represent — and VL has no infinity spelling to encode it honestly, so it is an
      // error (a silent ±inf would be a lossy implicit conversion). Runtime arithmetic still
      // yields ±inf per IEEE-754; this rejects only literal text.
      if f64LitOverflows(n.numText) { tErr("float literal overflows f64", ix) }
      return TY_F64
    }
    // A radix literal that adopted a 64-bit destination keeps that width across re-checks; one
    // wider than 64 bits has no destination at all, and says so here rather than wrapping.
    if n.numText.length >= 19 { cexNoteWideLit(ix, n.numText) }
    if litWide64Of(ix) { return TY_I64 }
    const ltt = litTreeTyOf(ix)
    if ltt >= 0 { return ltt }
    if numLexRadixBits(n.numText) > 64 {
      if !cexIsDerived(ix) { tErr(radixLitTooWideMsg(n.numText, 64), ix) }
      return TY_I64
    }
    if numLexFitsI32(n.numText) { return TY_I32 }
    return TY_I64
  } else if n is StrLit {
    return TY_STR
  } else if n is CharLit {
    // A char literal `'x'` is its i32 code point (composes with arithmetic / `==` /
    // string indexing exactly like a bare int literal), not a string.
    return TY_I32
  } else if n is BoolLit {
    return TY_BOOL
  } else if n is NullLit {
    return TY_NULL
  } else if n is Ident {
    // A marked parameter default resolves in the declaration's scope — for the one name form
    // v1 admits, the module frame. Checked once at the declaration and again at every call
    // site that omits the argument; the second reading is why the mark exists, so a
    // caller-local binding sharing the const's name cannot capture the substituted reference.
    if isDefaultGlobalRef(ix) {
      // A literal `const` is its literal here too, taken at the parameter's type.
      const dlit = lbiModLit[n.identName] ?? -1
      if dlit >= 0 {
        lbiInlineLit(ix, dlit, n.pos, n.identName)
        return checkNodeReal(ix)
      }
      identNoteModuleUse(ix, n.identName)
      if T.scopes.length > 0 {
        if T.scopes[0].has(n.identName) {
          return T.scopes[0][n.identName] ?? TY_ERR
        }
      }
      return TY_ERR
    }
    // A literal `const` has no single type: each read is its literal, typed by where it stands.
    const lit = lbiConstLitAt(ix, n.identName)
    if lit >= 0 {
      lbiInlineLit(ix, lit, n.pos, n.identName)
      return checkNodeReal(ix)
    }
    const ty = lookup(n.identName)
    // A module name declared as both a function and a value is refused as redeclared; which
    // of the two a read means is unknowable, so the read is that error's cascade.
    if lookupDepth(n.identName) == 0 && (modClashNames[n.identName] ?? false) {
      return TY_ERR
    }
    // Only a read at an extern's own type can name one, so the name lookup is asked of those alone.
    if ty >= extFnTyMin && ty < extFnTy.length && !extValueSeen {
      if extFnTy[ty] && ix != ckCalleeIx {
        if externLinkOf(n.identName) >= 0 { extValueSeenSet(true) }
      }
    }
    if ty < 0 {
      // `__callsite__` is legal — as a parameter default value, and nowhere else.
      // Reaching the undeclared-identifier floor means it appears in an expression, so
      // say which position it belongs in rather than that the name does not exist
      // (it does; `checkParamDefaults` accepts it).
      if n.identName == CALLSITE_NAME {
        tErr(
          "`__callsite__` is legal only as a parameter default value — write `caller: { file: string, line: i32, col: i32 } = __callsite__`",
          ix,
        )
        return TY_ERR
      }
      // The interpolation renderer's floor: `$tpl$render` is minted by the parser and
      // rewritten to the merged `toString$mN` by `modBuildRename`, so reaching here means
      // `std:fmt` never entered the module graph. Named, since the generic
      // undeclared-identifier message would point at a name the author cannot have written.
      if n.identName == TPL_RENDER_LOCAL {
        tErr(
          "internal: an interpolation hole's renderer was not merged — `std:fmt` is missing from this program's module graph",
          ix,
        )
        return TY_ERR
      }
      const moved = stdFmtMovedNote(n.identName)
      if moved == "" && undeclaredImportRaise(n.identName, ix) { return TY_ERR }
      tErr(
        "undeclared identifier '"
          + n.identName
          + "'"
          + moved
          + arrayCtorCallNote(n.identName, ix),
        ix,
      )
      return TY_ERR
    }
    // `ty` is this use's type as the checker resolved it — narrowed when the use
    // sits inside a guarded arm. Threaded in so the occurrence retains it.
    identNoteUse(ix, n.identName)
    if symEnabled != 0 { symUse(ix, n.identName, ty) }
    if ovSetMod.length > 0 && ix != ckCalleeIx {
      ovNoteFnValue(ix, n.identName, ty)
    }
    if ix != daWriteTarget {
      if crCapLossAny { crNoteLostName(n.identName, ix) }
      const crr = crReadHook(n.identName, ix)
      if crr >= 0 { return crr }
    }
    // Definite-assignment read gate: a bare-name read of a still-unassigned binding is "used
    // before assigned". The LHS of a plain `=` is a write, not a read (the `BinExpr` `=` arm
    // marks it `daWriteTarget` before evaluating the target), so it is skipped here; a
    // compound `x += …` desugars to `x = x + (…)`, whose RHS read does reach this gate.
    if ix != daWriteTarget { daCheckRead(n.identName, ix) }
    if lbiBindName.length > 0 && ix != daWriteTarget {
      lbiNoteRead(ix, n.identName)
    }
    // A top-level function read as a value keeps its declared parameters (D3992).
    if ix != ckCalleeIx && lookupDepth(n.identName) == 0 {
      if fnDeclIx.has(n.identName) { wsValueRead[n.identName] = true }
    }
    return ty
  } else if n is Paren {
    return checkNode(n.parInner)
    // ── explicit numeric cast `x as T` ──────────────────────────────────────────
  } else if n is AsExpr {
    return checkCastNode(n, ix)
    // ── unary ─────────────────────────────────────────────────────────────────
  } else if n is Unary {
    if n.unOp == "-" || n.unOp == "~" {
      const uf = cexTryFold(ix)
      if uf == 1 { return checkNodeReal(ix) }
      if uf == 2 { return TY_ERR }
      if n.unOp == "-" { cexNoteNegOperand(n.unArg) }
    }
    return checkUnaryNode(n, ix)
  } else if n is BinExpr {
    if n.binCompound.length == 0 && cexOp(n.binOp) {
      const bf = cexTryFoldBin(n, ix)
      if bf == 1 { return checkNodeReal(ix) }
      if bf == 2 { return TY_ERR }
    }
    const bt = checkBinExprNode(n, ix)
    if neKeys.length > 0 && n.binOp == "=" { neAssigned(n, curFnDeclIx) }
    return bt
  } else if n is Call {
    // Named arguments run in parameter order, so no fact may reach a pop among them (D3558).
    if neKeys.length > 0 && crIsNamedCall(ix) { neKill("", curFnDeclIx) }
    const callTy = checkCallNode(n, ix)
    if numUnionMinted { njNoteHeldCall(n, ix, callTy) }
    // A call is where a path narrowing can be falsified by a write the guarded
    // scope never spells. Asked after the arguments are checked so the call's own
    // operands still read under the narrowing that holds at their own evaluation.
    noteCallInvalidations(ix)
    return callTy
    // ── member access ───────────────────────────────────────────────────────────
  } else if n is Member {
    return checkMemberNode(n, ix)
  } else if n is ArrayLit {
    return checkArrayLitNode(n, ix)
  } else if n is Spread {
    // A spread the call and list-literal paths both declined — nothing here can unpack it.
    // The operand is still checked, so an error inside it is reported rather than swallowed.
    checkNode(n.spdArg)
    tErr(spreadNoRestMsg(""), ix)
    return TY_ERR
  } else if n is Index {
    return checkIndexNode(n, ix)
  } else if n is ObjLit {
    return checkObjLitNode(n, ix)
  } else if n is IsExpr {
    return checkIsExprNode(n, ix)
  } else if n is OptMember {
    return checkOptMemberNode(n, ix)
  } else if n is ErrExpr {
    return TY_ERR
    // ── let / const ─────────────────────────────────────────────────────────────
  } else if n is LetDecl {
    const lr = checkLetDeclNodeIn(n, ix)
    if neKeys.length > 0 { neKill(n.letName, curFnDeclIx) }
    if lpOn || exitFirstAt.length > 0 { noteExitFirstLet(n, ix) }
    return lr
  } else if n is FuncDecl {
    return checkFuncDeclNode(n, ix)
    // ── while ─────────────────────────────────────────────────────────────────
  } else if n is WhileStmt {
    // A loop re-runs what a fact proved once (D3558), and so does a for loop below.
    if neKeys.length > 0 { neKill("", curFnDeclIx) }
    return checkWhileStmtNode(n, ix)
    // A `break` joins its value into the loop or block it leaves; a misplaced one is the
    // parser's and the emitter's to report.
  } else if n is BreakStmt {
    return checkBreakNode(n, ix)
  } else if n is ContinueStmt {
    return TY_VOID
    // ── for v in A to B [step S] ────────────────────────────────────────────────
    // A numeric range loop: the bounds (and step, if present) must be i32; the loop
    // variable is i32 in the body's scope.
  } else if n is ForRange {
    if neKeys.length > 0 { neKill("", curFnDeclIx) }
    return checkForRangeNode(n, ix)
  } else if n is ForIn {
    if neKeys.length > 0 { neKill("", curFnDeclIx) }
    return checkForInNode(n, ix)
  } else if n is MatchExpr {
    return checkMatchExprNode(n, ix)
  } else if n is IfStmt {
    return checkIfStmtNode(ix)
  } else if n is RetStmt {
    return checkRetStmtNode(n, ix)
  } else if n is Block {
    return checkBlockNode(n, ix)
  } else if n is Program {
    return checkProgramNode(n)
  } else if n is Param {
    return TY_VOID
  } else if n is TypeRef {
    return TY_VOID
  } else if n is TypeDecl {
    // Registered by the Program pass-0 pre-pass; nothing to do when visited.
    return TY_VOID
  } else if n is UnionDecl {
    // Registered by the Program pass-0 pre-pass; nothing to do when visited.
    return TY_VOID
  } else if n is ImportDecl {
    // A tooling node (the lint tier reads it): import binding/resolution
    // happened in the module front end (the driver's token-level `modScan` +
    // merge), so the checker has nothing to verify here.
    return TY_VOID
  }
  TY_ERR
}

// The pinned re-check itself, in one home, opened and closed around the caller's read.
// `monoInferListElem`, `monoInferLocalScalar` and `monoInferRetExprTy` ask the same question,
// differing only in what they read back. Split into begin/end rather than a result selector
// because the read must happen inside the isolation, scope and suppression flags still active.
export function monoRecheckBegin(
  declIx: i32,
  paramTyIxs: i32[],
  tpNames: string[],
  tpTys: i32[],
): MonoSave | null {
  if declIx < 0 { return null }
  const dn = P.nodes[declIx]
  if !(dn is FuncDecl) { return null }
  const body = P.nodes[dn.fnBody]
  if !(body is Block) { return null }
  if prbArmed { prbEnter() }
  monoRecheckDepthSet(monoRecheckDepth + 1)
  const sv: MonoSave = { quiet: inferQuiet, sym: symEnabled, mark: checkMark() }
  inferQuiet = true
  symEnabled = 0
  njFnStack.push(njFnIx)
  njFnIxSet(declIx)
  // Binds the type parameters too, not only the value ones: `checkFuncDecl` keeps them in
  // scope as an opaque hole, so a body annotation naming one would otherwise stay a hole forever.
  let tpb = 0
  while tpb < tpNames.length {
    if tpb < tpTys.length {
      if tpTys[tpb] >= 0 {
        tpEnvNames.push(tpNames[tpb])
        tpEnvTys.push(tpTys[tpb])
      }
    }
    tpb = tpb + 1
  }
  // Checks the body statements directly in the pushed scope (not via `checkNode` on the
  // block), which would push/pop its own scope and drop the local before it can be read back.
  crFnEnter(declIx)
  pushScope(dn.fnBody)
  const params = dn.fnParams
  let pi = 0
  while pi < params.length {
    const p = P.nodes[params[pi]]
    if p is Param {
      let pty = TY_ERR
      if pi < paramTyIxs.length {
        if paramTyIxs[pi] >= 0 { pty = paramTyIxs[pi] }
      }
      declare(p.parName, pty)
    }
    pi = pi + 1
  }
  const stmts = body.blkStmts
  let s = 0
  while s < stmts.length {
    checkNode(stmts[s])
    s = s + 1
  }
  sv
}

// The one place a binary expression's type is handed out, so the one place the answer can be
// deferred to a pin. `ltOut` carries the left operand's type out rather than re-reading
// `nodeTyIx[n.binLeft]`: `checkNode` records a node type only when `!inferQuiet`, and a nested
// binary on the right could have overwritten a module-level slot before this returns.
function checkBinExprNode(n: BinExpr, ix: i32) {
  const ltOut: i32[] = []
  const bTy = checkBinExprNodeReal(n, ix, ltOut)
  if ltOut.length == 0 { return bTy }
  if n.binOp == "+" && !inferQuiet { plusLinkRecord(ix, ltOut[0]) }
  mkBinOpRetTy(n, bTy, ltOut[0])
}

// `a in b` outside a `for` head: refused, with the membership test the receiver `b` does have.
// Answers boolean, so the enclosing condition raises nothing further (DECISIONS.md §"`in` is a
// for-loop keyword, not an operator").
function checkInOpNode(n: BinExpr, ix: i32) {
  checkNode(n.binLeft)
  const rt = strLitRecvTy(checkNode(n.binRight))
  if rt >= 0 && rt < T.tys.length {
    const st = T.tys[nomErasedTyIx(rt)]
    if st is TyPrim {
      if st.primName == "string" {
        tErr(
          inOpHead() + "; to test for a substring, use `" + inStrFix(n) + "`",
          ix,
        )
        return TY_BOOL
      }
    }
  }
  tErr(inOpRefusal(rt), ix)
  TY_BOOL
}

// Extracted from `checkNodeReal`'s `BinExpr` arm (C3: thin the dispatcher).
function checkBinExprNodeReal(n: BinExpr, ix: i32, ltOut: i32[]) {
  const op = n.binOp
  if op == "in" { return checkInOpNode(n, ix) }
  // `a && b` / `a || b`: the left side's narrowings hold while checking the right (`&&`
  // narrows on true, `||` on false — the right is reached only in that branch).
  if op == "&&" || op == "||" {
    const clt = checkNode(n.binLeft)
    const cnames: string[] = []
    const ctys: i32[] = []
    if op == "&&" {
      collectThenNarrows(n.binLeft, cnames, ctys)
    } else {
      collectElseNarrows(n.binLeft, cnames, ctys)
    }
    let cpushed = 0
    const npBase = npKeys.length
    if cnames.length > 0 {
      pushScope(-1)
      applyNarrows(cnames, ctys)
      cpushed = 1
    }
    const crt = checkNode(n.binRight)
    if cpushed == 1 {
      crNoteRhsRetired(ix, n.binRight, cnames, ctys, npBase)
      popScope()
    }
    if !assignable(clt, TY_BOOL) || !assignable(crt, TY_BOOL) {
      tErr("operator '" + op + "' expects boolean operands", ix)
    }
    return TY_BOOL
  }
  // Definite-assignment: a plain `=` with a bare-name target is a pure write — flag it so
  // the `Ident` arm skips use-before-assign. A compound `x += ...` desugars, so its read isn't the target.
  const savedWriteTarget = daWriteTarget
  const savedGetWrite = getWriteTarget
  if op == "=" {
    const wtgt = P.nodes[n.binLeft]
    if wtgt is Ident { daWriteTarget = n.binLeft }
    if wtgt is Member { getWriteTargetSet(n.binLeft) }
    if wtgt is Index || wtgt is Member { luWriteTgtPut(n.binLeft, true) }
  }
  const savedLbiTgt = lbiWriteTgt
  if op == "=" { lbiWriteTgt = n.binLeft }
  let lt = checkNode(n.binLeft)
  daWriteTarget = savedWriteTarget
  getWriteTargetSet(savedGetWrite)
  // An unpinned intrinsic element answers with the default it will get (D1566), except under
  // `=`, whose Index case pins the element from the RHS instead — answering here would pre-empt that.
  if op != "=" {
    if lt < 0 {
      const peekL = arrDefOperandElemPeek(n.binLeft)
      if peekL >= 0 { lt = peekL }
    }
    // An operator reads a `const`'s literal as the `string` it is; the literal itself is
    // `nodeWideStrLitText`'s to answer, so no operator rule changes for it (D2157). A compare
    // decides once both sides are known (`eqKeepsWideLit`).
    if op != "==" && op != "!=" { lt = widenLitTy(lt) }
  }
  ltOut.push(lt)
  // Contextual typing for an assignment RHS: seed the LHS type so an un-annotated lambda
  // param infers from the target, matching let-init/arg/return seeding.
  if op == "=" { seedExpected(n.binRight, lt) }
  // Contextual typing for a `??` default: seed it with the LHS's non-null shape so an
  // un-annotated default-lambda param infers, mirroring the `=` seeding.
  if op == "??" { seedExpected(n.binRight, lt) }
  // Name the row an index store is about to pin, for the length of that store's value only, so a
  // read of the same place inside the value can pin the element rather than answer `TY_ERR`.
  const savedAsgRow = asgOpenElemRow
  asgOpenElemRowSet(-1)
  if op == "=" {
    asgOpenElemRowSet(asgOpenElemRowOf(n.binLeft))
    if tpEnvNames.length > 0 && P.nodes[n.binLeft] is Ident {
      tpIfMarkOk(n.binRight)
    }
  }
  const savedCmpdInner = nlCmpdInner
  const savedCmpdTgt = nlCmpdTgt
  if op == "=" && n.binCompound != "" {
    nlCmpdInner = parenPeelIx(n.binRight)
    nlCmpdTgt = n.binLeft
  }
  let rt = checkNode(n.binRight)
  lbiWriteTgt = savedLbiTgt
  nlCmpdInner = savedCmpdInner
  nlCmpdTgt = savedCmpdTgt
  asgOpenElemRowSet(savedAsgRow)
  lbiNoteOperands(n, ix)
  // The right operand takes the same answer, for the same reason: without it, an operator's
  // annotated face runs while the un-annotated one is check-clean invalid wasm (D1566).
  if op != "=" {
    if rt < 0 {
      const peekR = arrDefOperandElemPeek(n.binRight)
      if peekR >= 0 { rt = peekR }
    }
    if op == "==" || op == "!=" {
      if constLitNeverMeets(n.binLeft, lt, n.binRight, rt, op, ix) {
        return TY_BOOL
      }
      const keepL = eqKeepsWideLit(lt, rt)
      const keepR = eqKeepsWideLit(rt, lt)
      if !keepL {
        lt = widenLitTy(lt)
        ltOut[0] = lt
      }
      if !keepR { rt = widenLitTy(rt) }
    } else {
      rt = widenLitTy(rt)
    }
    // A store's value reading the place it writes: the value is what the program said the
    // element is, and the read has no answer of its own until this pins one.
    if lt < 0 {
      const asgPin = asgReadElemPin(n.binLeft, rt)
      if asgPin >= 0 {
        lt = asgPin
        ltOut[0] = asgPin // the out-column is the left operand's exact type, pin included
      }
    }
  }
  // The `??` default is the value produced when the LHS is null, so a `void` default leaves
  // nothing to produce — the other operators reject void through their own shape-demanding arms.
  if op == "??" {
    if voidValueSlotErr(rt, n.binRight, "`??` default", ix) { rt = TY_ERR }
    // The default's destination is the LHS's non-null shape — the one position where a typed
    // slot sits on the LEFT of the operator, which is why this needed its own pin (D1591).
    constrainEmptyExpr(n.binRight, rt, nonNullTy(lt))
    if lt >= 0 { lbiNoteCoalDefault(n.binRight, nonNullTy(lt)) }
  }
  // A radix literal operand takes the other side's width (the ruled literal rule). Assignment is
  // excluded: its destination is `assignableExpr`'s, which pins the narrowing direction too.
  if op != "=" && op != "&&" && op != "||" {
    if radixLitAdoptPeer64(n.binLeft, rt) == 1 { lt = TY_I64 }
    if radixLitAdoptPeer64(n.binRight, lt) == 1 { rt = TY_I64 }
    if lt == TY_I32 && rt == TY_I64 && op != "??" {
      const lpa = litTreeAdoptDst(n.binLeft, rt)
      if lpa >= 0 { lt = lpa }
    }
    if rt == TY_I32 && lt == TY_I64 {
      const rpa = litTreeAdoptDst(n.binRight, lt)
      if rpa >= 0 { rt = rpa }
    }
  }
  // A re-check pushes the node again; `checkShiftCounts` grades each once.
  if binShiftOp(op) && intLitLexemeOf(n.binRight) != "" {
    shiftCountNodes.push(ix)
  }
  // A binary op with a hole operand can't decide its form until the hole is bound at the call —
  // record the deferred constraint (skipping assignment / logical, handled by their own arms).
  if op != "=" && op != "&&" && op != "||" {
    if tyHasHole(lt) || tyHasHole(rt) {
      noteBinCstr(
        eqCstrOperandTy(op, n.binLeft, lt),
        op,
        eqCstrOperandTy(op, n.binRight, rt),
      )
      cexNoteHoleWidth(lt, rt)
      cexNoteHoleWidth(rt, lt)
    }
  }
  // Nominal newtype (P1.5): every non-assignment binary operator's operands must carry the
  // same brand — structural rules can't see it (`sameNumeric` compares `primName`, ordering skips `assignable`).
  if op != "=" && op != "&&" && op != "||" && op != "??" {
    if nomBinMixes(lt, rt, n.binLeft, n.binRight) {
      if op == "==" || op == "!=" {
        // A null test of a newtype over a base with no `null` is dead, as for any type.
        if isNullTy(rt) && tyProvesNonNull(lt) {
          recordDeadNullTest(ix, n.binLeft, lt, op)
          return TY_BOOL
        }
        if isNullTy(lt) && tyProvesNonNull(rt) {
          recordDeadNullTest(ix, n.binRight, rt, op)
          return TY_BOOL
        }
        tErr("cannot compare " + tyToStr(lt) + " and " + tyToStr(rt), ix)
        return TY_BOOL
      }
      tErr(
        "operator '" + op + "' mixes " + tyToStr(lt) + " and " + tyToStr(rt),
        ix,
      )
      return TY_ERR
    }
  }
  if (
    numUnionMinted
    && (tyIsNumUnion(lt) || tyIsNumUnion(rt))
    && numUnionOp(op)
    && !nullTestOp(op, lt, rt)
    && !njExprHeld(n.binLeft)
    && !njExprHeld(n.binRight)
  ) {
    if !(op == "+" && (concatsAsStr(lt) || concatsAsStr(rt))) {
      // Beside a type parameter the pairs are the pin's to check (`numUnionPinOk`).
      if tyHasTyVar(lt) || tyHasTyVar(rt) {
        noteBinCstr(lt, op, rt)
        if numCmpOp(op) { return TY_BOOL }
        if tyIsNumUnion(lt) { return lt }
        return rt
      }
      return numUnionBinTy(n, ix, lt, rt)
    }
  }
  // Assignment: RHS must be assignable to the LHS's (already-bound) type.
  if op == "=" {
    // A `const` name cannot be rebound (`x = ...`, and the `x++`/`x += ...`
    // desugarings). Data behind it stays mutable (a Member/Index target).
    const tgt = P.nodes[n.binLeft]
    if tgt is Member { sharedFieldWriteRefused(tgt, n.binRight, rt, ix) }
    if tgt is Ident {
      if isConstName(tgt.identName) {
        tErr("cannot reassign `const` " + tgt.identName, ix)
      }
      // A top-level write above the declaration would be overwritten by its initializer.
      if daLive.length > 0 && (moduleBeforeDecl[tgt.identName] ?? -1) >= 0 {
        if daIsUnassignedSid(sidOf(tgt.identName)) {
          tErr(
            "`" + tgt.identName + "` is written before its declaration",
            n.binLeft,
          )
        }
      }
      // This write makes the binding definitely assigned on the current path.
      daMarkAssigned(tgt.identName)
    }
    // An index-set into an empty `[]` pins its element type to `typeof v` in place —
    // usage-driven inference, clearing the uninferred floor.
    if tgt is Index {
      // The whole left-hand side is already checked as `lt` above — read the recorded type
      // instead of re-checking, so a diagnostic inside the receiver subtree isn't reported twice.
      let arrTy0 = nodeTyIxOf(tgt.idxArr)
      if arrTy0 < 0 { arrTy0 = checkNode(tgt.idxArr) }
      // An un-annotated-param hole receiver stands for its demanded map, so the map pin below
      // is the same arm the concrete receiver takes, not a second copy of it.
      const arrH0 = T.tys[arrTy0]
      if arrH0 is TyVar {
        // An index WRITE through a hole, filed like `xs.push(v)`: the read that typed the
        // receiver noted only that the body indexes it, which a view satisfies.
        noteArrayWriteDemand(arrH0.tvName)
        // The write's own deferred constraint, keyed to the ASSIGNMENT node so the pin can
        // BANK the `"[]="` operator there for the emitter — the read constraint the target
        // records only covers `"[]"`, and `p[4] = v` needs the setter (D1892). Vacuous when
        // the hole pins to a real array or map, which `validateMemCstrs` skips.
        if opIdxDeclared() { noteMemCstr(arrTy0, OP_INDEX_SET, ix, false) }
        const hmw = holeMapOf(arrH0.tvName)
        if hmw >= 0 { arrTy0 = hmw }
      }
      const arrT0 = T.tys[arrTy0]
      if arrT0 is TyArray {
        // An index write is a write to the list's own shape, so a view refuses it. Ahead of
        // the element pin below, which would otherwise infer a hole from a store that never
        // happens; reported and fallen through, so no cascade follows the one diagnostic.
        if arrT0.aRead == 1 { tErr(roWriteMsg("index assignment", arrTy0), ix) }
        if arrT0.aElem < 0 { calleeWritePrePin(arrTy0, rt) }
        if arrT0.aElem < 0 {
          arrT0.aElem = cnhPinTy(rt, ix, tgt.idxArr, false, false)
          tyMutEpoch = tyMutEpoch + 1 // index-write pinned the element in place
        } else {
          cnhFill(arrT0.aElem, rt)
        }
        // A `u8[]` store checks against the element type directly: `checkIndexNode` types a
        // `u8[]` read as `i32` (the widened value), so `lt` above can't see the out-of-range rule.
        if primNameOf(arrT0.aElem) == "u8" {
          assignableExpr(n.binRight, rt, arrT0.aElem)
        }
      }
      // An index-set into a bare `Map()` pins its key and value holes the same way `.set(k, v)`
      // does — the two write spellings of one program must infer identically.
      if arrT0 is TyMap {
        if arrT0.mKey < 0 {
          let kt0 = nodeTyIxOf(tgt.idxIndex)
          if kt0 < 0 { kt0 = checkNode(tgt.idxIndex) }
          if kt0 >= 0 {
            arrT0.mKey = widenLitTy(kt0)
            tyMutEpoch = tyMutEpoch + 1 // index-write pinned the key in place
            checkInferredMapKey(arrT0.mKey, arrT0.mSet, ix)
          }
        }
        if arrT0.mVal < 0 {
          const dmd = isHoleMapDemandTy(arrTy0)
          arrT0.mVal = cnhPinTy(rt, ix, tgt.idxArr, true, dmd)
          tyMutEpoch = tyMutEpoch + 1 // index-write pinned the value in place
        } else {
          cnhFill(arrT0.mVal, rt)
        }
      }
      // Free index-write operator (B14): banked on THIS assignment node, not the target —
      // the target keeps its read resolution, which `x[i] += v` needs (its desugaring re-reads it).
      if opIdxDeclared() {
        if !tyBuiltinIndexable(arrTy0) {
          const wfn = opIdxFnFor(OP_INDEX_SET, arrTy0)
          if wfn != "" {
            const wbNames: string[] = []
            const wbTys: i32[] = []
            opIdxBindGen(wfn, arrTy0, nodeTyIxOf(tgt.idxIndex), wbNames, wbTys)
            const vt0 = opIdxParamTy(wfn, 2)
            let vt = vt0
            if vt0 >= 0 {
              if wbNames.length > 0 { vt = substTyDeep(vt0, wbNames, wbTys) }
            }
            if vt >= 0 {
              if !assignableExpr(n.binRight, rt, vt) {
                tErr(
                  "index write: expected " + tyToStr(vt) + ", got " + tyToStr(rt),
                  ix,
                )
              }
            }
            opIdxBank(ix, wfn)
            noteCallInvalidations(ix)
            return rt
          }
          // A read operator with no write one: name the missing half, exactly as
          // the closure-field trap does below.
          const rOnly = opIdxFnFor(OP_INDEX_GET, arrTy0)
          if rOnly != "" {
            tErr(
              "no \""
                + OP_INDEX_SET
                + "\" operator for index assignment on "
                + tyToStr(arrTy0),
              ix,
            )
            return TY_ERR
          }
        }
      }
      // Index write trap (B13, host `indexTrap` "[]="): an object with only a read trap
      // rejects the write (the host's missing-method error).
      if arrT0 is TyObj {
        const wtrap = objFieldType(arrT0, "[]=")
        if wtrap >= 0 {
          const wt = T.tys[wtrap]
          if wt is TyFunc {
            if wt.fnParamTypes.length == 2 {
              if !assignableExpr(n.binRight, rt, wt.fnParamTypes[1]) {
                tErr(
                  "index write: expected "
                    + tyToStr(wt.fnParamTypes[1])
                    + ", got "
                    + tyToStr(rt),
                  ix,
                )
              }
              return rt
            }
          }
        } else if objFieldType(arrT0, "[]") >= 0 {
          tErr(
            "no \"[]=\" method for index assignment on " + tyToStr(arrTy0),
            ix,
          )
          return TY_ERR
        }
      }
    }
    // Narrowing applies to READS: a place accepts its storage type, never its current flow
    // (narrowed) type, so every write is checked against storage and may flip the variant (D1736).
    let asgLt = lt
    let asgBarred = false
    const asgDcl = writeStorageTy(n.binLeft)
    if asgDcl >= 0 {
      asgLt = asgDcl
    } else if elemValueHoleBase(lt) >= 0 {
      // An index write through a hole checks the element's STORAGE, so a `u8[]` pin still
      // refuses an out-of-range literal; the read type is the widened value (D2238).
      asgLt = mkDerivedHole(HD_ELEM, "", -1, -1, elemValueHoleBase(lt))
    } else {
      asgBarred = writeBarredByLoop(n.binLeft)
    }
    // A plain assignment pins the source's open holes, exactly as an annotated let-init, call
    // argument, or typed return already does — runs before `assignableExpr` so the pin applies first.
    constrainEmptyExpr(n.binRight, rt, asgLt)
    mapStoreValPin(n.binLeft, asgLt)
    noteU8StoreRhs(n.binLeft, n.binRight)
    nlAsgTgt = n.binLeft
    nlAsgGot = rt
    const asgFits = assignableExpr(n.binRight, rt, asgLt)
    nlAsgTgt = -1
    const asgOk = asgFits
      && !writeLeavesLoopEntry(n.binLeft, asgLitRhsTy(ix, asgLt, rt))
    lwStoreDstSet(-1)
    if !asgOk {
      if asgFits || asgBarred || (asgDcl >= 0 && writeBarredByLoop(n.binLeft)) {
        writeBarredErr(placeKeyOf(n.binLeft), ix)
      } else {
        nlAsgTgt = n.binLeft
        nlAsgGot = rt
        tErrWant(letAssignMsg(n.binRight, rt, asgLt, "", -1), n.binRight, asgLt)
        nlAsgTgt = -1
      }
    } else {
      // The same vacuous-gate check covers three write spellings (`r = e`, `b.v = e`,
      // `xs[0] = e`) — records the pair for the pin using `asgLt`, the storage type actually asked.
      noteLetCstr(coalPinTy(n.binRight, rt), asgLt, n.binRight, "")
      if P.nodes[n.binLeft] is Ident {
        wrDstDeclPut(n.binRight, identDeclOf(n.binLeft))
      }
      // And the slots of a literal source too: an array literal whose element join dropped a
      // hole reaches this gate hole-free, so the slots (not the pair) are the real question.
      if !tyHasHole(rt) {
        if !tyHasHole(asgLt) { noteLitElemCstrs(n.binRight, asgLt, 6) }
      }
    }
    // A-infer-null: a nullable binding's open inner hole fills from the first non-null
    // assignment in place; a straight-line non-null write narrows for the rest of the block.
    const asgTgt = P.nodes[n.binLeft]
    let asgPreTy = -1
    if asgTgt is Ident {
      if rt >= 0 && asgLt >= 0 && !tySame(asgLt, rt) {
        while asgStoreTys.length <= ix { asgStoreTysPush(-1) }
        asgStoreTysSetAt(ix, asgLt)
      } else if ix < asgStoreTys.length {
        // A re-check whose types now agree retires the earlier answer.
        asgStoreTysSetAt(ix, -1)
      }
      const asgCur = lookup(asgTgt.identName)
      // A re-check answers afresh (`asgStripTyOf`).
      asgPreTy = asgCur
      if ix < asgStripTys.length { asgStripTysSetAt(ix, -1) }
      if asgCur >= 0 {
        // A write to a hole binding ends the pin's jurisdiction over it: the call site pins the
        // parameter, this write replaces the value, so a cast after it is not the pin's to adjudicate (D1342).
        const asgHole = T.tys[asgCur]
        if asgHole is TyVar {
          noteCastClobber(asgHole.tvName + "." + asgTgt.identName)
        }
        const rtT = T.tys[rt]
        let rhsNullable = false
        if rtT is TyNullable { rhsNullable = true }
        const rhsNonNull = !rhsNullable && !isNullTy(rt) && rt >= 0
        const asgCt = T.tys[asgCur]
        if asgCt is TyNullable {
          if rhsNonNull {
            if asgCt.nInner < 0 {
              // D1589 — a read typed before the fill banked the hole itself: the fill
              // re-derives every such `??`, the moment its non-null part exists.
              nhFillLinked(asgCur, widenLitTy(rt))
            }
            // Bank the declared type before shadowing it — the narrowing itself is unchanged,
            // which is what the `let x: T | null = null` / `x = mk()` / `x.f` pattern rides.
            // Under a guard the write re-narrows from the declaration instead, below.
            if narGuardSlot(asgTgt.identName) < 0 {
              noteNarShadow(asgTgt.identName, asgCur, NAR_KIND_ASG)
              if tvPlaceWrite(asgCur, rt) {
                declare(asgTgt.identName, tvWriteTy(asgCur, rt, -1))
              } else {
                declare(asgTgt.identName, nonNullTy(asgCur))
                while asgStripTys.length <= ix { asgStripTysPush(-1) }
                asgStripTysSetAt(ix, nonNullTy(asgCur))
              }
            }
          } else if asgCt.nInner < 0 && rtT is TyNullable {
            // A nullable write fills the hole from its non-null part and narrows nothing: the
            // value may still be null, and an unfilled hole would type the binding `null` (D2597).
            if rtT.nInner >= 0 {
              nhFillLinked(asgCur, widenLitTy(rtT.nInner))
            } else {
              nhLink(asgCur, rt)
            }
          }
        }
      }
    }
    // The narrowing is a path fact, and a falsifying write ends the path — only an accepted
    // write retires it, since a rejected write did not happen and would cascade a second diagnostic.
    if asgOk { retireNarrowingsForWrite(n.binLeft, rt, ix, asgPreTy) }
    if asgOk { fsbNoteStore(n.binLeft, n.binRight, rt, ix) }
    // Assignment is an expression yielding its right-hand side (host parity;
    // DECISIONS: assignment-as-expression). A right side only the expression seam admits
    // (`[3.5, 4]` into `(i32 | f64)[]`) is built at the place's type, so it yields that (D2394).
    if asgOk && asgYieldsPlaceTy(n.binRight, rt, asgLt) { return asgLt }
    // A function value of a wider signature is stored as the adapter at the place's, and the
    // adapter is the value the expression yields, so it has the place's type (D3866).
    if asgOk && (fvaDone[parenPeelIx(n.binRight)] ?? false) { return asgLt }
    return rt
  }
  // An unpinned element hole is `-1`, and every arm below indexes `T.tys` with it — guarded
  // here, below both the `=` arm's own pin and the operand peek, rather than trapping (D1462).
  if lt < 0 { return TY_ERR }
  // Nullish coalescing peels the FULL nullability of the merged type (`nonNullTy`), not one
  // layer — a stored null in a nullable-valued map read is a double nullable, just like a miss.
  if op == "??" {
    // A `??` whose left operand can never be null has a dead default — recorded (a lint), not
    // rejected, since `emit_rewrite` folds it. A narrowed place is exempt: its storage still admits null.
    if tyExcludesNull(lt) {
      // A parked hole cast has no answer yet: `a as? i32` inside a hole's body types `i32`
      // until the call pins the operand, so a `??` over it looks dead here and is not (D1371).
      if !coalNarrowedPlace(n.binLeft) && !coalParkedHoleCast(n.binLeft) {
        recordDeadCoalesce(ix, lt)
      }
    }
    // A left operand that is only ever `null` always takes the default (D2261).
    if isNullTy(lt) { return rt }
    const lt2 = T.tys[lt]
    if lt2 is TyNullable {
      // D1589 — an open hole has no non-null part yet, so `nonNullTy` hands back the nullable
      // and the default's type is the safe answer: `fillCoalHoleNodes` re-derives it once the fill arrives.
      if lt2.nInner < 0 {
        if coalHoleDeferOk(rt) {
          noteCoalHole(ix, lt, rt)
          return rt
        }
      }
      const innerFull = nonNullTy(lt)
      // A literal default re-encodes at f32, so keep the result f32 — else `joinTys` widens
      // `f32 + f64`/`f32 + i32` and a downstream f32 slot rejects the demote.
      if primNameOf(innerFull) == "f32" && isF32AdoptingLitExpr(n.binRight) {
        return innerFull
      }
      // A litunion inner with a member-literal default stays the union (an i32 atom) — else
      // the bare literal types `string` and `joinTys` widens the result, divorcing it from the atom rep.
      if isLitBearing(innerFull) {
        const dl = litTyOfExpr(n.binRight)
        if dl >= 0 {
          if assignable(dl, innerFull) { return innerFull }
        }
        // An atom-valued map get's default must itself be an atom — a member literal or a
        // value of the same litunion; the method spelling `m.get(k) ?? d` is rejected here too.
        const mgRecv = fusedMapReadRecvIx(n.binLeft)
        if mgRecv >= 0 {
          if mapTyValIsLitUnion(nodeTyIxOf(mgRecv)) {
            if !assignable(rt, innerFull) {
              tErrUnsupported(
                "`??` over an atom-valued map needs a member-literal (or atom) default",
                ix,
              )
            }
          }
        }
      }
      if tyIsHole(rt) && !tyIsHole(innerFull) { coalDefNote(ix, innerFull, rt) }
      // A runtime default of another number type joins apart, as the `if` it spells does.
      const apart = coalJoinApart(n.binLeft, innerFull, rt, n.binRight)
      if apart >= 0 { return apart }
      // A declared parameter takes any default inside its body and its pin need not, so the
      // operator joins as the `if` it spells and the default keeps its own type (D3580, D3619).
      if coalParamDefault(innerFull, rt) {
        return joinArmLit(innerFull, false, rt, armLit(rt, n.binRight))
      }
      // When the default fits the non-null LHS type (with contextual coercion), the `??` result
      // IS that LHS type, not `joinTys`' LUB — which would widen a litunion field to `string`.
      if assignableExpr(n.binRight, rt, innerFull) { return innerFull }
      return joinTys(innerFull, rt)
    }
    // A hole left operand defers the whole tail above to the pin (`HD_COAL`): answering `lt` kept
    // the null `??` removed (D1693). The default is kept unwidened, so a pin whose non-null face
    // is a literal union holding it answers that union rather than `string`.
    let cdDft = litTyOfExpr(n.binRight)
    if cdDft < 0 { cdDft = rt }
    const cd = mkDerivedHole(HD_COAL, "", cdDft, -1, lt)
    if cd >= 0 {
      noteCoalResultHole(cd)
      return cd
    }
    return lt
  }
  // Equality: result bool; requires mutual compatibility.
  if op == "==" || op == "!=" {
    noteCmpConstLit(n.binLeft)
    noteCmpConstLit(n.binRight)
    // A void operand leaves nothing to compare (a call to a `: void` function or extern).
    if voidValueSlotErr(lt, n.binLeft, "`" + op + "`", n.binLeft) {
      return TY_BOOL
    }
    if voidValueSlotErr(rt, n.binRight, "`" + op + "`", n.binRight) {
      return TY_BOOL
    }
    // A null test asks about the storage, not the flow-narrowed type — a narrowing does not
    // change storage, so `isAsgNarrowedName` exempts exactly the bindings an assignment narrowed.
    if isNullTy(lt) || isNullTy(rt) {
      if isAsgNarrowedName(n.binLeft) || isAsgNarrowedName(n.binRight) {
        return TY_BOOL
      }
      // A value proved non-null makes the test dead: a warning, and the emitter folds it.
      if isNullTy(rt) && !isNullTy(lt) && tyProvesNonNull(lt) {
        recordDeadNullTest(ix, n.binLeft, lt, op)
        return TY_BOOL
      }
      if isNullTy(lt) && !isNullTy(rt) && tyProvesNonNull(rt) {
        recordDeadNullTest(ix, n.binRight, rt, op)
        return TY_BOOL
      }
    }
    // Closed set (literal unions): comparing a literal-union place against a literal outside
    // its set can never be true — reject rather than compile an always-false test.
    if isLitBearing(lt) {
      const eqR = cmpLitTyOf(n.binRight)
      if eqR >= 0 {
        if !assignable(eqR, lt) {
          tErr(
            "cannot compare "
              + tyToStr(lt)
              + " with "
              + tyToStr(eqR)
              + " — not a member of the union",
            ix,
          )
        }
        // A member compare is always a valid discrimination (`v == 7` over `"x" | 7`) — the
        // mixed union's softened sides aren't mutually assignable, so it must not fall through.
        return TY_BOOL
      }
    } else if isLitBearing(rt) {
      const eqL = cmpLitTyOf(n.binLeft)
      if eqL >= 0 {
        if !assignable(eqL, rt) {
          tErr(
            "cannot compare "
              + tyToStr(eqL)
              + " with "
              + tyToStr(rt)
              + " — not a member of the union",
            ix,
          )
        }
        return TY_BOOL
      }
    }
    // A nominal newtype compared with a literal is compatible (`id == 0`) — the literal adopts
    // the brand, as in every other position; the genuine-mix reject already fired above.
    const nomEqLit = nomNameOfTy(lt) != nomNameOfTy(rt)
      && !nomBinMixes(lt, rt, n.binLeft, n.binRight)
    const eqMutual = assignable(lt, rt) || assignable(rt, lt) || nomEqLit
    if !eqMutual {
      tErr("cannot compare " + tyToStr(lt) + " with " + tyToStr(rt), ix)
    }
    // Both `==` gates share one home (`eqRefusals`): structural soundness (field-by-field
    // compare needs every component comparable) and emitter-capability (no compare core exists).
    const eqMsgs: string[] = []
    const eqChan: i32[] = []
    eqRefusals(op, lt, rt, eqMutual, eqMsgs, eqChan)
    let eqM = 0
    while eqM < eqMsgs.length {
      if eqChan[eqM] == 1 {
        tErrUnsupported(eqMsgs[eqM], ix)
      } else {
        tErr(eqMsgs[eqM], ix)
      }
      eqM = eqM + 1
    }
    if eqMsgs.length == 0 && !isNullTy(lt) && !isNullTy(rt) {
      let eqTy = lt
      let eqPath = eqListFieldPath(lt, [])
      if eqPath == "" {
        eqTy = rt
        eqPath = eqListFieldPath(rt, [])
      }
      if eqPath != "" { recordDeepRecordEq(ix, eqTy, eqPath, op) }
    }
    return TY_BOOL
  }
  // A gradual union operand is checked at its concrete members; the constraint noted above
  // re-checks the whole union at each pin.
  if op != "&&" && op != "||" {
    if T.tys[lt] is TyUnion {
      const glt = tpGradualView(lt)
      if glt >= 0 && glt < T.tys.length { lt = glt }
    }
    if rt >= 0 && rt < T.tys.length && T.tys[rt] is TyUnion {
      const grt = tpGradualView(rt)
      if grt >= 0 && grt < T.tys.length { rt = grt }
    }
  }
  // Operator dispatch on a struct (B13 + B14): a free `self`-function named for the operator
  // is checked first, then an operator closure field — equality/logicals/`=`/`??` already returned.
  if op != "&&" && op != "||" {
    const odsp = T.tys[lt]
    // A `new v128` brand has no arithmetic of the language's own, so it dispatches like an
    // object: its declaring module's operator is the only meaning `a + b` can have.
    if tyIsV128Brand(lt) {
      const vsf = opSelfFnTy(op, lt, rt, n.binRight, ix)
      if vsf >= 0 {
        opBinSiteTook(op, true)
        noteCallInvalidations(ix)
        return vsf
      }
    }
    if odsp is TyObj {
      const osf = opSelfFnTy(op, lt, rt, n.binRight, ix)
      if osf >= 0 {
        opBinSiteTook(op, true)
        noteCallInvalidations(ix)
        return osf
      }
      const ofld = objFieldType(odsp, op)
      if ofld >= 0 {
        const oft = T.tys[ofld]
        if oft is TyFunc {
          if oft.fnParamTypes.length == 1 {
            if !assignableExpr(n.binRight, rt, oft.fnParamTypes[0]) {
              tErr(
                "operator '"
                  + op
                  + "': expected "
                  + tyToStr(oft.fnParamTypes[0])
                  + ", got "
                  + tyToStr(rt),
                ix,
              )
            }
            crOpOpaque[ix] = true
            noteCallInvalidations(ix)
            return oft.fnRet
          }
        }
      }
    } else {
      // A hole on the LEFT never reached the operator table at all: the lookup above is gated
      // on the left operand ALREADY being an object, and it is `opSelfFnTy`'s own trailing
      // `assignableExpr` that seeds a hole on the RIGHT. Record the mirror flow so the
      // parameter solve binds it too — inert outside the solve, as `noteHoleFlow` is (D1891).
      if tyIsHole(lt) { noteHoleFlow(lt, opSelfParamTy(op), -1) }
      // The site's own decision, recorded (D491): a non-object left operand takes the
      // language's own lowering with no declaration consulted — recorded for the declaration side.
      opBinSiteTook(op, false)
    }
  }
  // Ordering comparison: result bool, requires matching numeric types. A literal/litunion
  // operand is its base scalar here (`0 | 1 | 2` compares as i32).
  if op == "<" || op == ">" || op == "<=" || op == ">=" {
    const olt = softenLitOpTy(lt)
    const ort = softenLitOpTy(rt)
    // String ordering: a lexicographic compare of two strings yields a bool.
    if isStringTy(olt) && isStringTy(ort) { return TY_BOOL }
    // One concrete string against a hole defers rather than forcing numeric — `noteBinCstr`
    // records the constraint and `validateBinCstrs` adjudicates it at the call, mirroring `+`'s deferral.
    if isStringTy(olt) && tyIsHole(ort) { return TY_BOOL }
    if tyIsHole(olt) && isStringTy(ort) { return TY_BOOL }
    // A hole operand reaching a numeric comparison is used numerically — record the demand.
    if !isNumeric(olt) || !isNumeric(ort) {
      tErr(
        "comparison expects numeric operands, got "
          + tyToStr(olt)
          + " and "
          + tyToStr(ort),
        ix,
      )
    } else if (
      !sameNumeric(olt, ort)
      && !mixesNumeric(olt, ort)
      && !cmpF32LitAdopts(n, olt, ort)
    ) {
      // Mixed numerics may be compared when one side widens to the other; the f32-with-a-literal
      // pair is admitted separately (`cmpF32LitAdopts`) so comparison agrees with arithmetic's `+`.
      tErr("comparison mixes " + tyToStr(olt) + " and " + tyToStr(ort), ix)
    }
    return TY_BOOL
  }
  // `+` also concatenates strings.
  if op == "+" {
    // String concat needs an operand that concatenates AS a string — a hole is permissively
    // assignable to string, so this defers a two-hole `a + b` to the call site (`substTyDeep`),
    // and a NUMERIC member set softens to its own base and falls to the arithmetic tail.
    if concatsAsStr(lt) || concatsAsStr(rt) {
      if assignable(lt, TY_STR) && assignable(rt, TY_STR) { return TY_STR }
      // A `new string` newtype concatenates (with a same-brand value or a literal) and keeps
      // the brand — otherwise it would be the one newtype whose values could never be joined.
      if nomNameOfTy(lt) != "" || nomNameOfTy(rt) != "" {
        if assignable(nomBaseTyIx(lt), TY_STR) {
          if assignable(nomBaseTyIx(rt), TY_STR) {
            if nomNameOfTy(lt) != "" { return lt }
            return rt
          }
        }
      }
    }
    // List concat `a + b` → a new `T[]` (collections-design §VL.4); the two
    // element types must agree (an empty `[]` adopts the other side's).
    const lta = T.tys[lt]
    if lta is TyArray {
      const rta = T.tys[rt]
      if rta is TyArray {
        constrainEmpty(rt, lt)
        constrainEmpty(lt, rt)
        // No emitter-capability gate here any more: one concat lowering exists per list rep
        // (`emitListConcatG`); any residue is an emitter fact caught loudly at the emit site (D721).
        if assignable(rt, lt) { return lt }
        if assignable(lt, rt) { return rt }
        tErr("cannot concat " + tyToStr(lt) + " and " + tyToStr(rt), ix)
        return TY_ERR
      }
    }
  }
  // Remaining arithmetic: numeric-only, both the same numeric type (no implicit i32<->f64).
  // A literal/all-literal-union operand softens to its base scalar first. The refusal below
  // renders the pair the user WROTE: softening is how the operand is checked, not what it is,
  // and a message naming the base leaves a member set looking like a contradiction (D1739).
  const ltWrote = lt
  const rtWrote = rt
  lt = softenLitOpTy(lt)
  rt = softenLitOpTy(rt)
  // A hole operand reaching arithmetic is used numerically — record the demand so the call-arg
  // check enforces a numeric (or operator-overloaded) argument (`isNumeric(TyVar)` passes below).
  if !isNumeric(lt) || !isNumeric(rt) {
    // Reached only after string-concat and array-concat are ruled out above, so this is a
    // genuine operand-type mismatch, not a claim that `+` is numeric-only.
    tErr(
      "operator '"
        + op
        + "' is not defined for "
        + tyToStr(ltWrote)
        + " and "
        + tyToStr(rtWrote),
      ix,
    )
    return TY_ERR
  }
  // Bitwise/shift are integer-only — a float has no bits to shift. `%` is not in this family
  // any more (D1586): float remainder now lowers exactly via the `__f64_rem__` intrinsic.
  if binIntOnlyOp(op) {
    if binFloatOperandPair(lt, rt) {
      tErr(
        "operator '"
          + op
          + "' is integer-only, got "
          + tyToStr(lt)
          + " and "
          + tyToStr(rt),
        ix,
      )
      return TY_ERR
    }
  }
  // A literal operand adopts the other side's f32 type (a literal re-encodes exactly at f32),
  // checked before the general mixed rule so `x + 1` stays f32 rather than widening to f64.
  if primNameOf(lt) == "f32" && f32AdoptingOperand(n.binRight, lt) { return lt }
  if primNameOf(rt) == "f32" && f32AdoptingOperand(n.binLeft, rt) { return rt }
  // The f64 twin, integer half only — a `.`-literal already types f64 and needs no arm. Without
  // it `fv + 9000000000` is the mixed-numeric refusal while the same literal ASSIGNED to an f64
  // is admitted, so the two faces of one grant would disagree (D1890).
  if primNameOf(lt) == "f64" && isExactF64IntLitExpr(n.binRight) {
    cexFloatUse(n.binRight)
    return lt
  }
  if primNameOf(rt) == "f64" && isExactF64IntLitExpr(n.binLeft) {
    cexFloatUse(n.binLeft)
    return rt
  }
  // A mixed-numeric op widens the narrower operand to the wider one (`i32 op i64` -> i64, ...),
  // done before the same-type check so a compatible mixed pair is accepted (B2).
  if mixesNumeric(lt, rt) { return widerNumeric(lt, rt) }
  if !sameNumeric(lt, rt) {
    // A compound assignment's operand the target's defaulted literal does not mix with.
    if ix == nlCmpdInner {
      nlAsgTgt = nlCmpdTgt
      nlAsgGot = rt
    }
    tErr(
      "operator '" + op + "' mixes " + tyToStr(lt) + " and " + tyToStr(rt),
      ix,
    )
    nlAsgTgt = -1
    return TY_ERR
  }
  return lt
}
// ── let declaration ────────────────────────────────────────────────────────

function checkLetDeclNodeIn(n: LetDecl, ix: i32) {
  if curFnDeclIx >= 0 { letDeclFnPut(ix, curFnDeclIx) }
  if n.letInit >= 0 { wrDstDeclPut(n.letInit, ix) }
  if n.letType < 0 && n.letInit >= 0 && !inferQuiet {
    const lp = cwPeel(n.letInit)
    if lp >= 0 {
      const li = P.nodes[lp]
      if li is IfStmt { letJoinCandidates.push(ix) }
      if li is BinExpr {
        if li.binOp == "??" { letJoinCandidates.push(ix) }
      }
    }
  }
  // Resolve the annotation (if any) by reading the TypeRef child inline.
  let annot = -1
  // D1048's second hint: did the annotation collapse a subsumed literal arm? Read immediately
  // after resolution and compared against THIS annotation's own answer.
  let annotCollapsedHere = false
  if n.letType >= 0 {
    const tn = P.nodes[n.letType]
    if tn is TypeRef {
      // A binding the list-union rewrite minted is typed as the rewrite typed it, since a
      // written `T[] | i32[]` resolves to one list (D2876).
      const lua = luAnnTy[n.letType] ?? -1
      if lua >= 0 {
        annot = lua
      } else {
        annot = nameToTyAt(tn.tyName, n.letType)
      }
      if annot >= 0 && annot == collapsedTy { annotCollapsedHere = true }
      if tn.tyName.length > 0 && tn.tyName.slice(0, 1) == "{" {
        recAnnObjs.push(annot)
      }
      if annot < 0 {
        // A map shape whose key is neither `string` nor `i32` has no hash in the map rep —
        // report that directly (with the supported set) rather than a bare "unknown type".
        const mapKeyIx = tsMapKeyNodeOf(annTsOf(n.letType))
        let badKey = ""
        if mapKeyIx >= 0 { badKey = tsText[mapKeyIx] }
        if badKey != "" && !mapKeyTySupported(tsLeafTy(badKey)) {
          mapKeyUnsupportedErr(badKey, initMapCtorName(n.letInit), n.letType)
        } else {
          unknownTyErr(tn.tyName, "", n.letType)
        }
        annot = TY_ERR
      }
      // Record the resolved type on the `let`'s type-annotation node so the emitter can
      // classify it structurally from the `Ty` arena rather than re-parsing `tyNameOf` — C1.
      if !inferQuiet && annot >= 0 {
        if n.letType < nodeTyIx.length { nodeTySet(n.letType, annot) }
      }
    }
  }
  let initTy = -1
  // Bidirectional: an annotated `const f: (i32) => i32 = (x) => ...` infers each un-annotated
  // lambda param from the annotation before the initializer is checked.
  const seedMark = cbSeedUsed
  if n.letInit >= 0 && annot >= 0 { seedExpected(n.letInit, annot) }
  // An un-annotated binding to a bare lambda: mark it so its un-annotated params type as
  // inference holes rather than being rejected as uninferable.
  if annot < 0 && n.letInit >= 0 {
    const liN = P.nodes[n.letInit]
    if liN is FuncDecl {
      if liN.fnName == "" { noteValBindLambda(n.letInit) }
    }
  }
  if n.letInit >= 0 {
    if tpEnvNames.length > 0 { tpIfMarkOk(n.letInit) }
    initTy = checkNode(n.letInit)
  }
  // A `void` initializer has no value to bind — reject with a source-located message,
  // poisoning `initTy`. Exempted: an if-expression init, whose false path is implicit `null`.
  // A minted scrutinee binding (D1991) keeps the `void`, so the `match` reports it in its own words.
  if n.letInit >= 0 && isVoidTy(initTy) && !symNameIsMinted(n.letName) {
    if !voidSlotExemptExpr(n.letInit) {
      tErr(
        "cannot bind the void result of '"
          + n.letName
          + "' — a void function returns no value",
        ix,
      )
      initTy = TY_ERR
    }
  }
  // An initializer whose type includes `void` has no value to store: refused at the if or match arm
  // that yields none, else at the initializer (D4071).
  if (
    n.letInit >= 0
    && annot < 0
    && initTy >= 0
    && !isVoidTy(initTy)
    && tyMentionsVoid(initTy, 8)
    && !symNameIsMinted(n.letName)
  ) {
    const arm = ifNoValueArmAt(n.letInit)
    if arm != n.letInit {
      const kw = valueBranchKeyword(n.letInit)
      tErr(
        "this arm yields no value, but the `"
          + kw
          + "` is the value of `"
          + n.letName
          + "`: end the arm with a value, or make the `"
          + kw
          + "` a statement",
        arm,
      )
    } else {
      tErr(
        "`"
          + n.letName
          + "` would take the type "
          + tyToStr(initTy)
          + ", and a value that may be `void` cannot be stored: test it before binding "
          + "it, or bind it only where it holds a value",
        n.letInit,
      )
    }
    initTy = TY_ERR
  }
  // A `never` initializer leaves nothing to bind, and an un-annotated binding would take a type
  // no value has; a declared type gives the dead binding a real one (D1972).
  if n.letInit >= 0 && annot < 0 && initTy == TY_NEVER && initTy >= 0 {
    tErr(
      "`"
        + n.letName
        + "` would hold a `never` value, and none exists: its initializer never returns — call it as a statement, or declare the binding's type",
      ix,
    )
    initTy = TY_ERR
  }
  // Redundant explicit annotation: skipped when checking the initializer consumed a contextual
  // seed the annotation supplied (an un-annotated lambda param) — comparing then would be circular (D1442).
  if (
    annot >= 0
    && initTy >= 0
    && n.letInit >= 0
    && cbSeedUsed == seedMark
    && !lbiIsSynth(n.letType, ix)
  ) {
    if exprIsNumLit(n.letInit) && lbiNumTy(annot) {
      lbiDeferRedundant(ix, initTy)
    } else if !lbiReadsPinned(n.letInit) {
      recordRedundantAnnot(n, ix, initTy, annot)
    }
  }
  let bound = TY_ERR
  if annot >= 0 {
    bound = annot
    if initTy >= 0 {
      // An annotated empty-collection initializer pins the source binding's open holes from
      // the annotation (`const ys: i32[] = zs` resolves `zs`'s element) in place.
      constrainEmptyExpr(n.letInit, initTy, annot)
      // A `never`-typed annotation is already reported at its declaration — don't cascade a
      // second "cannot assign ... of type <empty>" at every use site.
      const neverAnnot = isNeverTy(annot)
      if !neverAnnot && !assignableExpr(n.letInit, initTy, annot) {
        // Three sentences, one home: `letAssignMsg` picks between the object-literal-into-a-map,
        // lossy-numeric and opaque forms; the pin calls the same function on the substituted pair.
        tErrWant(
          letAssignMsg(n.letInit, initTy, annot, n.letName, n.letType),
          n.letInit,
          annot,
        )
      } else if !neverAnnot {
        // The check above is vacuous whenever a side is a hole — record the pair for the pin to
        // re-ask under substitution, only on the PASSING side (a failing one already reported, D572).
        noteLetCstr(coalPinTy(n.letInit, initTy), annot, n.letInit, n.letName)
        // And the slots of a literal source too, but only when the pair above carried no hole —
        // that is exactly when the literal's own element join dropped one, so nothing is recorded.
        if !tyHasHole(initTy) {
          if !tyHasHole(annot) { noteLitElemCstrs(n.letInit, annot, 6) }
        }
      }
    }
  } else if initTy >= 0 {
    bound = constStrLitBound(n, initTy)
    if tpIfJoinAt.length > 0 { bound = tpIfBindTy(n.letInit, bound) }
    // A-infer-null: an un-annotated `let x = null` binds a nullable with an open inner hole;
    // the first non-null assignment fills it in place (the `=` arm), so `x` becomes `T | null`.
    if isNullTy(initTy) {
      bound = mkNullableTy(-1)
      // ...and record the hole, so scope close can say whether anything ever filled it. A
      // hole nothing fills is the `null` type and has a rep (D1576).
      noteNullHole(bound, ix)
    }
    // Un-inferred empty-collection floor: a still-open hole may yet be pinned by a downstream
    // `.push`/`.set`/`.add` — recorded for the scope-close re-check (`flushUninferred`).
    if unresolvedHole(bound) { notePending(n.letName, bound, ix) }
    // Exports an un-annotated if-expression binding's inferred value-union type for the
    // emitter. Gated to if-expr/`?.` inits only — rendering via `tyToStr` is costly on the hot path.
    let initIf = n.letInit
    if initIf >= 0 {
      const ini0 = P.nodes[initIf]
      if ini0 is Paren { initIf = ini0.parInner }
    }
    let isIfInit = false
    if initIf >= 0 {
      const ini1 = P.nodes[initIf]
      if ini1 is IfStmt { isIfInit = true }
      // A standalone optional chain (`const t = a?.w`) is the other init shape whose union the
      // emitter can learn about from nowhere else — as rare as an if-expression init.
      if ini1 is OptMember { isIfInit = true }
      // …and a `??`, whose result is a join the program spells nowhere else (D1709).
      if ini1 is BinExpr {
        if ini1.binOp == "??" { isIfInit = true }
      }
      // …and an optional CALL (`const t = p?.f()`), whose `| null` comes from the guard and
      // so appears in neither the callee's type nor the call's own spelling (D1814).
      if ini1 is Call {
        const iniCallee = P.nodes[ini1.callFn]
        if iniCallee is OptMember { isIfInit = true }
      }
    }
    if isIfInit {
      const lvn = valueUnionRetName(bound)
      if lvn != "" {
        inferLetIx.push(ix)
        inferLetTy.push(lvn)
      } else if tyIsStructBearingUnion(bound) {
        // A MIXED union renders "" above — a struct member is not a value ATOM — and still reps
        // as the box, so its row is minted from the arena type instead of from a name. Its
        // struct members register as ARMS here, the one place the join is named (D1746).
        inferRegisterVariantMembers(bound)
        inferLetIx.push(ix)
        inferLetTy.push("")
      } else if isNulStringTy(bound) {
        // `string | null` is a niche (not a value-union box) so `valueUnionRetName`
        // renders "" — record it separately for the kind-16 slot classification.
        inferLetNulStrIx.push(ix)
      } else if isNulBoolTy(bound) {
        // `boolean | null` is the other niche (the i32 sentinel-2 rep) — same story,
        // recorded for the niche slot classification (`isInferLetNulBool`).
        inferLetNulBoolIx.push(ix)
      }
    }
  } else {
    tErr("'" + n.letName + "' needs a type annotation or initializer", ix)
  }
  // Same-scope redeclaration (B16): a second `let`/`const` of a name already bound in the
  // innermost frame errors; shadowing an outer name in a nested block is legal.
  const dtop = T.scopes.length - 1
  // A module global is pre-declared by the pass-1.5 hoist, so its own pass-2 declaration
  // would falsely trip the same-frame check — skip it there (top-level dups are caught in the hoist).
  const preHoisted = dtop == 0 && (moduleGlobals[n.letName] ?? false)
  if crWidenedInTop(n.letName) {
    crUnwidenTop(n.letName)
  } else if !preHoisted && T.scopes[dtop].has(n.letName) {
    tErr("redeclared " + n.letName, ix)
  }
  // The same reservation the `function` path enforces: a `const` of the emitter-intrinsic name
  // is called through the inline arm exactly like `function`, so the lambda never runs.
  checkNotEmitterIntrinsic(n.letName, ix)
  declare(n.letName, bound)
  if recAdOrigDecl.length > 0 && (recAdPinned[ix] ?? false) {
    recAdBound.push(bound)
  }
  if npKeys.length > 0 { narShadowPaths(n.letName, ix) }
  crNoteSoleRef(n)
  getLetBank(ix, bound)
  // The module hoist already recorded a global's row at depth 0; a second one would say the
  // same thing at the same depth (D1609).
  if !preHoisted && letDeclIsUnannotObjLit(ix) {
    markObjLitBinding(n.letName, T.scopes.length - 1)
  }
  if !preHoisted && letDeclIsUnannotCtnLit(ix) {
    markCtnLitBinding(n.letName, T.scopes.length - 1, n.letInit)
  }
  if !preHoisted && numLitBindCandidateTy(bound) {
    markNumLitBinding(n.letName, T.scopes.length - 1, ix)
  }
  if !preHoisted { lbiMark(n.letName, T.scopes.length - 1, ix, bound) }
  if !preHoisted { markFnLitBinding(n.letName, T.scopes.length - 1, ix) }
  fsbMark(n.letName, T.scopes.length - 1, ix, bound)
  // D1048's second hint: marks a binding whose type came from a spelling that collapsed a
  // subsumed literal arm. A bare call initializer is the whole rung, deliberately narrow.
  if annotCollapsedHere {
    markCollapsedBinding(n.letName)
  } else if n.letType < 0 && n.letInit >= 0 {
    const cInit = P.nodes[n.letInit]
    if cInit is Call {
      const cFn = P.nodes[cInit.callFn]
      if cFn is Ident {
        const cDecl = fnDeclIx[cFn.identName] ?? lookupFnDeclNode(cFn.identName)
        if fnRetCollapsed(cDecl) { markCollapsedBinding(n.letName) }
      }
    }
  }
  // `const f = addT` — records which declaration this binding aliases, for deferred-constraint
  // ownership alone. A bare Ident initializer naming a declared function is the whole rung.
  if n.letInit >= 0 {
    const aInit = P.nodes[parenPeelIx(n.letInit)]
    if aInit is Ident {
      const aDecl = fnDeclIx[aInit.identName]
        ?? lookupFnDeclNode(aInit.identName)
      if aDecl >= 0 {
        const atop = fnAliasScopes.length - 1
        if atop >= 0 { fnAliasScopes[atop][n.letName] = aDecl }
      }
    }
  }
  symDecl(n.letName, ix, bound, 0)
  if n.letKw == "const" {
    const ctop = constScopes.length - 1
    if ctop >= 0 { constScopes[ctop][n.letName] = ix }
  }
  // Definite-assignment: an uninitialized `let x` starts unassigned; a later read before a
  // write is an error. An initialized `let`/`const` is assigned from the start and never tracked.
  daMarkAssigned(n.letName)
  if (moduleBeforeDecl[n.letName] ?? -1) == ix {
    moduleBeforeDecl[n.letName] = -1
  }
  // An `extern let` is assigned by whoever provides the import, before any code here runs.
  if n.letInit < 0 && externGlobalLinkOfNode(ix) < 0 { daAdd(n.letName) }
  return TY_VOID
}
// ── match ──────────────────────────────────────────────────────────────────

// One integer-literal arm pattern: type-checks it against the scrutinee and claims its value,
// reporting a mismatch or a duplicate at the pattern. `claimed` holds the values already
// claimed, keyed `hi:lo` so a match of any arm count stays linear (D1990). Answers false only
// for a type mismatch — the one refusal that makes the pattern cover nothing.
function checkIntArmLit(
  patIx: i32,
  numIx: i32,
  neg: boolean,
  st: i32,
  claimed: {[string]: boolean},
) {
  // Checked as the expression it is, so `nodeTyIx` is filled for the `==` the desugar builds
  // over it — an `i32` literal reaches an `i64` scrutinee by the widening lattice, never the reverse.
  const pt = checkNode(patIx)
  if !assignable(pt, st) {
    tErr(
      "match pattern type mismatch: expected "
        + tyToStr(st)
        + ", found "
        + tyToStr(pt),
      patIx,
    )
    return false
  }
  // A hole scrutinee can't decide the compare's form here — record the deferred `==` the
  // desugared chain emits, so the call that pins the parameter adjudicates it later.
  noteBinCstr(st, "==", pt)
  if numIx < 0 { return true }
  const key = matchIntPatValue(numIx, neg)
  if key.length != 2 { return true }
  const k = i32ToStr(key[0]) + ":" + i32ToStr(key[1])
  if claimed.has(k) {
    tErr(
      "redundant match arm: `"
        + matchPatLabel(patIx, matchIntPatLexeme(numIx, neg))
        + " is already covered",
      patIx,
    )
    return true
  }
  claimed.set(k, true)
  true
}

// `match` over an integer scrutinee (D1572, VL-020): arms are integer literals of the
// scrutinee's type plus a mandatory `_`, since 2^32 cases is not a member set to be complete
// over. Duplicate arms and an arm after the `_` are errors. No emitter path of its own —
// `desugarMatchAt` already turns a non-`IsExpr` pattern into `scrut == pat`.
function checkMatchIntArms(n: MatchExpr, ix: i32, st: i32) {
  // The literal values already claimed, keyed by the 64-bit value's `hi:lo` halves.
  const claimed: {[string]: boolean} = Map()
  let hasWild = false
  let wildArm = -1
  // A pattern that is not an integer literal covers nothing — report it at the pattern and
  // suppress the missing-`_` report below, which would mis-blame coverage for it.
  let sawBadPat = false
  // -1 is the "unset" join seed (`joinTys` returns the other operand); the positive TY_ERR
  // sentinel would poison the join, so never seed with it.
  let matchTy = -1
  const matchArmTys: i32[] = []
  const mValArms: i32[] = []
  const mValTys: i32[] = []
  let matchValAcc = matchTallyBegin(ix)
  let mArmsLit = true
  const nArms = n.matchArmStart.length
  let ai = 0
  while ai < nArms {
    let pj = 0
    while pj < n.matchArmCount[ai] {
      const patIx = n.matchPats[n.matchArmStart[ai] + pj]
      const valIx = matchPatValNode(patIx)
      if matchPatIsWild(patIx) {
        hasWild = true
        if wildArm < 0 { wildArm = ai }
      } else if matchPatWasRefused(patIx) {
        sawBadPat = true
      } else {
        const numIx = matchPatIntNumOf(valIx)
        if valIx != patIx && numIx < 0 {
          // A constant whose literal is no integer: its read is checked for the mismatch.
          sawBadPat = true
          checkIntArmLit(patIx, -1, false, st, claimed)
        } else if numIx < 0 {
          // Any other pattern is another vocabulary's arm (a type pattern, a member string,
          // or a parse-recovery node) — named here rather than read as a missing member.
          sawBadPat = true
          tErr(intArmRejectMsg(st), patIx)
        } else if (!checkIntArmLit(patIx, numIx, numIx != valIx, st, claimed)) {
          sawBadPat = true
        }
      }
      pj = pj + 1
    }
    // An arm after the `_` is dead, and silently reordered if allowed: the wildcard
    // becomes the chain's bare `else`, so a later arm would test first — rejected, not reordered.
    if wildArm >= 0 && ai > wildArm {
      tErr(
        "unreachable match arm — the `_` wildcard must be the last arm",
        n.matchPats[n.matchArmStart[ai]],
      )
    }
    const body = n.matchBodies[ai]
    const svArm = valueArmAt
    if matchValued { valueArmAtSet(body) }
    if matchOnSpine { spineAtSet(body) }
    const bt = checkNode(body)
    valueArmAtSet(svArm)
    let armTy = bt
    const bn = P.nodes[body]
    if bn is Block {
      armTy = blockTailTy
      // A statement-tail block has `blockTailTy == -1` ("no value") — that is void, not the
      // sentinel TY_ERR (both are -1), so a void-arm `match` must not be read as an error.
      if armTy < 0 { armTy = TY_VOID }
    }
    if !matchArmExits(ix, body, armTy) {
      const bodyLit = armLit(armTy, body)
      matchTy = joinArmLit(
        matchTy,
        mArmsLit,
        f32ArmPlainTy(body, armTy),
        bodyLit,
      )
      if tpEnvNames.length > 0 { matchArmTys.push(f32ArmPlainTy(body, armTy)) }
      mValArms.push(body)
      mValTys.push(f32ArmPlainTy(body, armTy))
      matchValAcc = matchArmTally(
        ix,
        body,
        armTy,
        matchValAcc,
        mArmsLit,
        bodyLit,
      )
      mArmsLit = mArmsLit && bodyLit
    }
    ai = ai + 1
  }
  if matchTy < 0 { matchTy = TY_VOID }
  const mf32 = matchF32Join(ix, matchTy)
  const mlj = litJoinOf(ix, matchTy, mValArms, mValTys)
  if mf32 >= 0 {
    matchTy = mf32
    matchValAcc = mf32
  } else if mlj >= 0 {
    matchTy = mlj
    matchValAcc = mlj
  } else {
    noteTpJoinRow(ix, tpApartJoinOf(matchArmTys), matchTy, tpMatchOk)
  }
  matchTallyEnd(ix, matchValAcc)
  // Exhaustiveness is the wildcard, and it is required — an integer has no closed member set,
  // so there is no arm list that could stand in for one.
  if !hasWild && !sawBadPat {
    tErr("non-exhaustive match — an integer `match` needs a `_` arm", ix)
  }
  // Lower to an if/else chain in place (real pass only) so lint + emit see only if-chains.
  if !inferQuiet {
    desugarMatchAt(ix)
    if !sawBadPat { noteIntMatchHead(ix) }
  }
  matchTy
}

// Checks a clause's `const` decls inside the arm's narrowing scope, so `const x = scrut.x`
// reads the field off the narrowed member and the name is visible to the following body.
// A duplicate binding is skipped rather than checked — `checkMatchBindNames` already reported
// it, and declaring it twice would stack a terse `redeclared x` on the explanatory message.
function checkMatchBindDecls(bIx: i32) {
  if bIx < 0 { return 0 }
  const bn = P.nodes[bIx]
  if bn is Block {
    let i = 0
    while i < bn.blkStmts.length {
      let dup = false
      const st = P.nodes[bn.blkStmts[i]]
      if st is LetDecl {
        let j = 0
        while j < i {
          const pv = P.nodes[bn.blkStmts[j]]
          if pv is LetDecl {
            if pv.letName == st.letName { dup = true }
          }
          j = j + 1
        }
      }
      if !dup { checkNode(bn.blkStmts[i]) }
      i = i + 1
    }
  }
  0
}

function checkMatchTypeArms(n: MatchExpr, ix: i32, st: i32, uMems: i32[]) {
  // `uMems` is the scrutinee's variant list (a nullable contributes its inner variants plus
  // `null`) — a data structure, never a re-split of a rendered spelling. `covered` is parallel.
  const covered: i32[] = []
  let ci = 0
  while ci < uMems.length {
    covered.push(0)
    ci = ci + 1
  }
  let hasWild = false
  // A pattern that names no member covers nothing — report it at the pattern and suppress the
  // exhaustiveness report below (the bad pattern is the root cause; don't cascade).
  let sawBadPat = false
  const nArms = n.matchArmStart.length
  // ── pass 1 (SOURCE order): resolve + validate every pattern, bank its check type, mark cover.
  let ai = 0
  while ai < nArms {
    let pj = 0
    while pj < n.matchArmCount[ai] {
      const patIx = n.matchPats[n.matchArmStart[ai] + pj]
      const pn = P.nodes[patIx]
      if matchPatIsWild(patIx) {
        hasWild = true
      } else if pn is IsExpr {
        const pt = isTypeTy(pn.isVariant, patIx)
        if pt < 0 {
          sawBadPat = true
          tErr(matchUnknownTypeMsg(pn.isVariant, st), patIx)
        } else if tyIsCompositePat(pt) {
          sawBadPat = true
          tErr(
            "match pattern `"
              + pn.isVariant
              + "` names a union — list its members as separate arms (`A | B => …`)",
            patIx,
          )
        } else {
          // Banks the resolved check type on the pattern node (the `isVarTyIx` row the emitter's
          // narrowing stack reads) instead of re-checking, which would duplicate the scrutinee's diagnostics.
          if patIx < isVarTyIxCap {
            while isVarTyIx.length <= patIx { isVarTyIxPush(-1) }
            isVarTyIxSetAt(patIx, pt)
          }
          if patIx < nodeTyIx.length { nodeTySet(patIx, TY_BOOL) }
          const hit = markUnionCover(uMems, covered, pt)
          if hit == 0 {
            tErr(
              "match pattern `"
                + pn.isVariant
                + "` is not a member of "
                + tyToStr(st),
              patIx,
            )
          } else if hit < 0 {
            tErr(
              "redundant match arm: `" + pn.isVariant + "` is already covered",
              patIx,
            )
          }
          const twin = mapTwinTestMsg(uMems, pt, "a `match` arm")
          if twin != "" { tErr(twin, patIx) }
        }
      } else if pn is StrLit {
        // A string-literal pattern discriminates a litunion's member text; over a value union
        // the arms discriminate types, so name the difference instead of a phantom missing member.
        sawBadPat = true
        tErr(
          "invalid match pattern "
            + pn.strText
            + " — a pattern over a value union is a member type or the `_` wildcard",
          patIx,
        )
      } else {
        sawBadPat = true
        tErr(
          "invalid match pattern — a pattern over a value union is a member type or the `_` wildcard",
          patIx,
        )
      }
      pj = pj + 1
    }
    // An or-pattern arm may not carry a payload binding: it gets no then-narrowing
    // (`collectThenNarrows` reports none for the `||` condition), so `scrut.x` would not type.
    if n.matchArmCount[ai] > 1 {
      if matchArmHasBinds(n, ai) {
        tErr(
          "payload binding is not allowed on an or-pattern arm — give each type its own arm",
          n.matchPats[n.matchArmStart[ai]],
        )
      }
    } else {
      checkMatchBindNames(matchArmBindsOf(n, ai), n.matchBodies[ai])
    }
    ai = ai + 1
  }
  // Whether every member is named (or a `_` stands in for the rest) — settled by pass 1, and
  // read by pass 3 as well as by the exhaustiveness report at the end.
  let exhaustive = hasWild
  if !hasWild {
    let ec = 0
    let allCov = true
    while ec < covered.length {
      if covered[ec] == 0 { allCov = false }
      ec = ec + 1
    }
    exhaustive = allCov
  }
  // Pass 2 (chain order): the progressive else narrowings. `armAcc[k]` is how much of the
  // accumulator holds when the chain enters arm `k` — `collectElseNarrows`' fold, same order.
  const elseArm = matchElseArmOf(n.matchPats, n.matchArmStart, n.matchArmCount)
  const accNames: string[] = []
  const accTys: i32[] = []
  const armAcc: i32[] = []
  let z = 0
  while z < nArms {
    armAcc.push(0)
    z = z + 1
  }
  let ck = 0
  while ck < nArms {
    if ck != elseArm {
      armAcc[ck] = accNames.length
      let pj = 0
      while pj < n.matchArmCount[ck] {
        collectElseNarrows(
          n.matchPats[n.matchArmStart[ck] + pj],
          accNames,
          accTys,
        )
        pj = pj + 1
      }
    }
    ck = ck + 1
  }
  if elseArm >= 0 { armAcc[elseArm] = accNames.length }
  // Pass 3 (source order): check each arm body under its branch's narrowing, joining arm value
  // types. -1 is the "unset" join seed; the positive TY_ERR sentinel would poison the join.
  let matchTy = -1
  const matchArmTys: i32[] = []
  const mValArms: i32[] = []
  const mValTys: i32[] = []
  let matchValAcc = matchTallyBegin(ix)
  let mArmsLit = true
  let bi = 0
  while bi < nArms {
    const nmz: string[] = []
    const tyz: i32[] = []
    let q = 0
    while q < armAcc[bi] {
      nmz.push(accNames[q])
      tyz.push(accTys[q])
      q = q + 1
    }
    // The arm's own then-fact, pushed after the accumulated complement (order matters —
    // `applyNarrows` binds in order, so the arm's own type wins over the complement).
    if bi != elseArm || !exhaustive {
      if n.matchArmCount[bi] == 1 {
        collectThenNarrows(n.matchPats[n.matchArmStart[bi]], nmz, tyz)
      }
    }
    // The scope is pushed for the payload clause too, not just the narrowing — an arm can
    // bind without narrowing, and its `const`s must still be arm-local.
    const bindIx = matchArmBindsOf(n, bi)
    const scoped = nmz.length > 0 || bindIx >= 0
    if scoped {
      pushScope(-1)
      applyNarrows(nmz, tyz)
      checkMatchBindDecls(bindIx)
    }
    const body = n.matchBodies[bi]
    const svArm = valueArmAt
    if matchValued { valueArmAtSet(body) }
    if matchOnSpine { spineAtSet(body) }
    const bt = checkNode(body)
    valueArmAtSet(svArm)
    let armTy = bt
    const bn = P.nodes[body]
    if bn is Block {
      armTy = blockTailTy
      // A statement-tail block has `blockTailTy == -1` ("no value") — that is void, not the
      // sentinel TY_ERR (both are -1), so a void-arm `match` must not be mistaken for an error.
      if armTy < 0 { armTy = TY_VOID }
    }
    if scoped { popScope() }
    if !matchArmExits(ix, body, armTy) {
      const bodyLit = armLit(armTy, body)
      matchTy = joinArmLit(
        matchTy,
        mArmsLit,
        f32ArmPlainTy(body, armTy),
        bodyLit,
      )
      if tpEnvNames.length > 0 { matchArmTys.push(f32ArmPlainTy(body, armTy)) }
      mValArms.push(body)
      mValTys.push(f32ArmPlainTy(body, armTy))
      matchValAcc = matchArmTally(
        ix,
        body,
        armTy,
        matchValAcc,
        mArmsLit,
        bodyLit,
      )
      mArmsLit = mArmsLit && bodyLit
    }
    bi = bi + 1
  }
  if matchTy < 0 { matchTy = TY_VOID }
  const mf32 = matchF32Join(ix, matchTy)
  const mlj = litJoinOf(ix, matchTy, mValArms, mValTys)
  if mf32 >= 0 {
    matchTy = mf32
    matchValAcc = mf32
  } else if mlj >= 0 {
    matchTy = mlj
    matchValAcc = mlj
  } else {
    noteTpJoinRow(ix, tpApartJoinOf(matchArmTys), matchTy, tpMatchOk)
  }
  matchTallyEnd(ix, matchValAcc)
  // Exhaustiveness: `_` is allowed but never required — a match naming every member is
  // complete without one. Missing members render from the arena types, not a re-split spelling.
  if !hasWild && !sawBadPat {
    let missing = ""
    let mk = 0
    while mk < uMems.length {
      if covered[mk] == 0 {
        if missing != "" { missing = missing + ", " }
        missing = missing + tyToStr(uMems[mk])
      }
      mk = mk + 1
    }
    if missing != "" {
      tErr(
        "non-exhaustive match — missing " + missing + " (add the arm or a `_`)",
        ix,
      )
    }
  }
  // Lower to an if/else chain in place (real pass only) so lint + emit see only if-chains.
  if !inferQuiet { desugarMatchAt(ix) }
  matchTy
}

// ── a `const` as a match arm (D3271) ─────────────────────────────────────────
// A bare name in pattern position that names no type is a constant, compared by value: the
// pattern node becomes a read of it, so the desugared test is the hand-written `scrut == K`,
// and its literal is where the arm's value is read for duplicates, members and the jump table.

// Extracted from `checkNodeReal`'s `MatchExpr` arm (C3: thin the dispatcher).
function checkMatchExprNode(n: MatchExpr, ix: i32) {
  // A discarded `match` lowers its arms as statements, as a spine one does, and so do the
  // blocks, `if`s and `match`es at their tails.
  const savedOnSpine = matchOnSpine
  const savedValued = matchValued
  const savedSpine = spineAt
  matchValuedSet(!valDiscarded(ix))
  matchOnSpineSet(spineAt == ix || !matchValued)
  const r = checkMatchExprNodeIn(n, ix)
  if lpColAt(nestedExitFirstAt, ix) == 1 { refuseNestedExitFirst(ix, r) }
  matchOnSpineSet(savedOnSpine)
  matchValuedSet(savedValued)
  spineAtSet(savedSpine)
  r
}

function checkMatchExprNodeIn(n: MatchExpr, ix: i32) {
  // Three arm vocabularies, decided by the scrutinee: an integer dispatches on literals
  // (D1572), a litunion on member strings, any other union on member types.
  const mTail = retTailPos
  const savedMatchTail = matchInRetTail
  matchInRetTailSet(matchTailNode == ix)
  retTailPosSet(false)
  const st = checkNode(n.matchScrut)
  tpMatchOkSet(mTail || tpIfOkAt.has(ix))
  // The scrutinee and arm bodies are NOT in return-tail position — restore the flag on every
  // exit so a `match` subexpression stays transparent to a sibling in the same statement.
  const nulLit = tyIsNullableLitUnion(st)
  if tyIsIntMatchScrut(st) || tyIsLitUnion(st) || nulLit {
    resolveMatchConstPats(n, false)
  } else if tyIsHole(st) {
    resolveMatchConstPats(n, true)
  }
  if tyIsIntMatchScrut(st) || (tyIsHole(st) && matchArmsAreIntLits(n)) {
    const ri = checkMatchIntArms(n, ix, st)
    matchInRetTailSet(savedMatchTail)
    retTailPosSet(mTail)
    return ri
  }
  // D1898 — a NULLABLE literal union takes the member-string vocabulary too, with `null` as
  // one more member: it is the same interned i32 atom as the bare set, `null` riding the spare
  // `-1`, so the desugared `k is null` / `k == "a"` chain is what already lowers.
  if !tyIsLitUnion(st) && !nulLit {
    // A third arm vocabulary (D1572): an integer scrutinee dispatches on literals, asked before
    // the union tests (which have no member set for one). A hole takes it too when arms are int literals.
    const uMems: i32[] = []
    flattenVariantsInto(st, uMems)
    if uMems.length > 1 && !unionHasLitMember(uMems) {
      const r = checkMatchTypeArms(n, ix, st, uMems)
      matchInRetTailSet(savedMatchTail)
      retTailPosSet(mTail)
      return r
    }
    // An error-typed scrutinee's own diagnostic is already raised; refusing it again is a cascade.
    if st < 0 || !(T.tys[st] is TyErr) {
      tErr(matchScrutRejectMsg(st, uMems), ix)
    }
    matchInRetTailSet(savedMatchTail)
    retTailPosSet(mTail)
    return TY_ERR
  }
  // The member texts (inner, no quotes), and a parallel covered-flag. `K | null` interns as a
  // `TyNullable` over the set while the expanded `"a" | "b" | null` interns as a `TyUnion` with
  // a null member, so both forms are read here and the `null` member rides `nulCovered`.
  const members: string[] = []
  let styIx = st
  const styN = T.tys[st]
  if styN is TyNullable { styIx = styN.nInner }
  const sty = T.tys[styIx]
  if sty is TyUnion {
    let mi = 0
    while mi < sty.uMembers.length {
      const mm = T.tys[sty.uMembers[mi]]
      if mm is TyLit { members.push(mm.litText) }
      mi = mi + 1
    }
  }
  const covered: i32[] = []
  let ci = 0
  while ci < members.length {
    covered.push(0)
    ci = ci + 1
  }
  let nulCovered = false
  let hasWild = false
  // A pattern that is neither a member string literal nor the `_` wildcard covers nothing —
  // report it at the pattern and suppress the exhaustiveness error below (don't cascade).
  let sawBadPat = false
  // -1 is the "unset" join seed (`joinTys` returns the other operand); the positive TY_ERR
  // sentinel would poison the join (every arm joins back to error), so never seed with it.
  let matchTy = -1
  const matchArmTys: i32[] = []
  const mValArms: i32[] = []
  const mValTys: i32[] = []
  let matchValAcc = matchTallyBegin(ix)
  let mArmsLit = true
  let ai = 0
  while ai < n.matchArmStart.length {
    // Patterns of arm `ai`.
    let pj = 0
    while pj < n.matchArmCount[ai] {
      const patIx = n.matchPats[n.matchArmStart[ai] + pj]
      const pn = P.nodes[matchPatValNode(patIx)]
      if matchPatIsWild(patIx) {
        hasWild = true
      } else if matchPatWasRefused(patIx) {
        sawBadPat = true
      } else if pn is IsExpr {
        // D1898 — `null` is the one type pattern this vocabulary takes, and only where the
        // scrutinee carries it; on a bare set it is not a member and keeps the wording below.
        if nulLit && pn.isVariant == "null" {
          if nulCovered {
            tErr("redundant match arm: `null` is already covered", patIx)
          } else {
            nulCovered = true
          }
        } else {
          // A type pattern over a literal union: an identifier naming no type reaches this same
          // arm too, so the wording must not silently claim to cover every member.
          sawBadPat = true
          tErr(
            "invalid match pattern `"
              + pn.isVariant
              + "` — a pattern is a member string literal, a `const` with a literal value"
              + matchNulPatHint(nulLit)
              + " or the `_` wildcard",
            patIx,
          )
        }
      } else if pn is StrLit {
        // A constant's read is checked so the desugared `==` has its operand's type.
        if matchConstPatLitAt(patIx) >= 0 { checkNode(patIx) }
        // The member name is the pattern's inner text (quotes stripped) — an expression
        // lexeme, not `tyname.groupInnerOf`'s home (a degenerate lexeme stays whole here).
        const raw = pn.strText
        let inner = raw
        if raw.length >= 2 { inner = raw.slice(1, raw.length - 1) }
        let found = -1
        let fi = 0
        while fi < members.length {
          if members[fi] == inner { found = fi }
          fi = fi + 1
        }
        if found < 0 {
          tErr(
            "match pattern "
              + matchStrPatLabel(patIx, inner)
              + " is not a member of "
              + tyToStr(st),
            patIx,
          )
        } else if covered[found] == 1 {
          tErr(
            "redundant match arm: "
              + matchStrPatLabel(patIx, inner)
              + " is already covered",
            patIx,
          )
        } else {
          covered[found] = 1
        }
      } else if matchConstPatLitAt(patIx) >= 0 {
        // A constant holding a number: the read is checked for the mismatch it is.
        sawBadPat = true
        tErr(
          "match pattern type mismatch: expected "
            + tyToStr(st)
            + ", found "
            + tyToStr(checkNode(patIx)),
          patIx,
        )
      } else {
        // Any other node kind (a parse-recovered pattern, a future literal form):
        // same story — it covers nothing, so name it rather than mis-blame coverage.
        sawBadPat = true
        tErr(
          "invalid match pattern — a pattern is a member string literal, a `const` with a literal value or the `_` wildcard",
          patIx,
        )
      }
      pj = pj + 1
    }
    // Body value type. (Arm bodies are not checked in return-tail position; the match's joined
    // value seeds the function return once, below — avoids a per-arm void/err mis-seed.)
    const body = n.matchBodies[ai]
    const svArm = valueArmAt
    if matchValued { valueArmAtSet(body) }
    if matchOnSpine { spineAtSet(body) }
    const bt = checkNode(body)
    valueArmAtSet(svArm)
    let armTy = bt
    const bn = P.nodes[body]
    if bn is Block {
      armTy = blockTailTy
      // A statement-tail block has `blockTailTy == -1` ("no value") — that is void, not the
      // sentinel TY_ERR (both are -1), so a void-arm `match` must not be mistaken for an error.
      if armTy < 0 { armTy = TY_VOID }
    }
    if !matchArmExits(ix, body, armTy) {
      const bodyLit = armLit(armTy, body)
      matchTy = joinArmLit(
        matchTy,
        mArmsLit,
        f32ArmPlainTy(body, armTy),
        bodyLit,
      )
      if tpEnvNames.length > 0 { matchArmTys.push(f32ArmPlainTy(body, armTy)) }
      mValArms.push(body)
      mValTys.push(f32ArmPlainTy(body, armTy))
      matchValAcc = matchArmTally(
        ix,
        body,
        armTy,
        matchValAcc,
        mArmsLit,
        bodyLit,
      )
      mArmsLit = mArmsLit && bodyLit
    }
    ai = ai + 1
  }
  // A void-armed match leaves the join unset (-1) or void; normalize to void so the function-
  // body-tail seeding (`noteInferredRet`) does not mistake it for the error sentinel.
  if matchTy < 0 { matchTy = TY_VOID }
  const mf32 = matchF32Join(ix, matchTy)
  const mlj = litJoinOf(ix, matchTy, mValArms, mValTys)
  if mf32 >= 0 {
    matchTy = mf32
    matchValAcc = mf32
  } else if mlj >= 0 {
    matchTy = mlj
    matchValAcc = mlj
  } else {
    noteTpJoinRow(ix, tpApartJoinOf(matchArmTys), matchTy, tpMatchOk)
  }
  matchTallyEnd(ix, matchValAcc)
  // Exhaustiveness: every member covered, or a wildcard. Skipped after an invalid pattern —
  // that arm covers nothing, so a missing-member report would mis-blame what the pattern already explained.
  if !hasWild && !sawBadPat {
    let missing = ""
    let mk = 0
    while mk < members.length {
      if covered[mk] == 0 {
        if missing != "" { missing = missing + ", " }
        missing = missing + "\"" + members[mk] + "\""
      }
      mk = mk + 1
    }
    // The `null` member is named last, so the sentence reads in the order the spelling does.
    if nulLit && !nulCovered {
      if missing != "" { missing = missing + ", " }
      missing = missing + "null"
    }
    if missing != "" {
      tErr(
        "non-exhaustive match — missing " + missing + " (add the arm or a `_`)",
        ix,
      )
    }
  }
  // Lower to an if/else chain in place (real pass only) so lint + emit see only if-chains.
  if !inferQuiet { desugarMatchAt(ix) }
  matchInRetTailSet(savedMatchTail)
  retTailPosSet(mTail)
  return matchTy
}

// An `else if` chain is checked along its spine: every link's head runs outermost-first, then
// every tail innermost-first, with `checkNode`'s own bookkeeping for each inner link between, so
// the chain's depth costs no stack (D1990).
function checkIfStmtNode(ix: i32) {
  const savedChainSpine = ifChainSpine
  ifChainSpineSet(spineAt == ix)
  const frames: IfChk[] = []
  const savedTails: boolean[] = []
  let cur = ix
  let elseRes = TY_VOID
  while cur >= 0 {
    const c = P.nodes[cur]
    const at = cur
    cur = -1
    if c is IfStmt {
      frames.push(checkIfHead(c, at))
      // A discarded chain discards every link and arm under it.
      if c.ifElse >= 0 && valDiscarded(at) { markValDiscard(c.ifElse) }
      if c.ifElse >= 0 {
        if P.nodes[c.ifElse] is IfStmt {
          // `checkNode`'s entry for the inner link; an `if` is a tail-spine node.
          savedTails.push(retTailPos)
          cur = c.ifElse
        } else {
          const elseSpine = spineAt
          const elseArm = valueArmAt
          if !valDiscarded(at) { valueArmAtSet(c.ifElse) }
          if ifChainSpine { spineAtSet(c.ifElse) }
          elseRes = checkNode(c.ifElse)
          spineAtSet(elseSpine)
          valueArmAtSet(elseArm)
        }
      }
    }
  }
  const savedOnTail = ifChainOnFnTail
  ifChainOnFnTailSet(ifChainSpine)
  const savedVloOn = vloMemoOn
  const savedVlo = vloMemo
  vloMemoOnSet(frames.length > 1)
  if vloMemoOn { vloMemoSet(Map()) }
  let k = frames.length - 1
  let res = checkIfTailAt(frames[k], elseRes, false)
  while k > 0 {
    const inner = frames[k]
    k = k - 1
    checkNodeDone(inner.ifIx, res, savedTails[k])
    res = checkIfTailAt(frames[k], res, inner.exits)
  }
  vloMemoOnSet(savedVloOn)
  vloMemoSet(savedVlo)
  ifChainOnFnTailSet(savedOnTail)
  ifChainSpineSet(savedChainSpine)
  res
}

// The head of one link: everything up to checking its else arm.
function checkIfHead(n: IfStmt, ix: i32): IfChk {
  // Am I the else arm of an enclosing `if`? Read and cleared here, so the flag reaches
  // exactly one callee and every `if` inside a branch body sees `-1` (`pgUpKeys`).
  const isElseArm = ix >= 0 && ix == pgUpArmIx
  pgUpArmIxSet(-1)
  const pgUpMark = pgUpKeys.length
  // What this `if`'s own subtree writes; read by the post-guard leg below (D1736).
  const clobMark = narClobKeys.length
  // Where its places stood on entry, for a key the join first meets inside an arm (`narHeadTy`).
  const ipMark = narIpAt.length
  const headDepth = T.scopes.length
  const headNp = npKeys.length
  // An `if`/`else` in value position is an expression whose value is the join of its branch
  // tail values — capture whether THIS `if` sits in the function's return-tail position.
  const ifTail = retTailPos
  const ifInRetArg = inRetArg
  retTailPosSet(false)
  // Where the inferred return stood before this `if`'s arms seeded it (`dropTailIfSeeds`).
  const seedLogMark = inferRetLogTy.length
  const seedObsMark = inferObserved
  const seedObsLit = inferObservedLit
  const condTy = checkNode(n.ifCond)
  if !assignable(condTy, TY_BOOL) {
    tErr("if-condition must be boolean, got " + tyToStr(condTy), n.ifCond)
  }
  // Narrowing over a simple identifier: `is T` refines to the variant, `!= null`/`== null`
  // refine a nullable. Union-complement narrowing after `is T` is deliberately excluded — it missed real errors.
  const tnNames: string[] = []
  const tnTys: i32[] = []
  collectThenNarrows(n.ifCond, tnNames, tnTys)
  const enNames: string[] = []
  const enTys: i32[] = []
  collectElseNarrows(n.ifCond, enNames, enTys)
  // What each tested place held on entry, before either arm's fact: the arm join's start for a
  // path that carries no fact of its own.
  const tnEnt = narKeysNowTys(tnNames)
  const enEnt = narKeysNowTys(enNames)
  // Definite-assignment fork/join: each branch forks off the if-entry state and they join
  // after — assigned only if assigned on every surviving path; a diverging branch contributes nothing.
  const daFork = daMark()
  // `is`-guard alternatives over a hole: a then-narrow refining a hole is an alternative the
  // body handles on its own branch, not an extra field demand — registered before the scope pushes.
  const altRows: i32[] = []
  // The rows this guard tests, including ones a previous pass already registered — the
  // guarded-return marking must fire on every pass, since the real pass witnesses the call site.
  const guardRows: i32[] = []
  let ai = 0
  while ai < tnNames.length {
    if !isPathKey(tnNames[ai]) {
      const curIx = lookup(tnNames[ai])
      if curIx >= 0 {
        const cur = T.tys[curIx]
        if cur is TyVar {
          const row = noteHoleAlt(curIx, cur.tvName, tnTys[ai])
          if row >= 0 {
            altRows.push(row)
            guardRows.push(row)
          } else {
            const seen = holeAltRowOf(cur.tvName, tnTys[ai])
            if seen >= 0 { guardRows.push(seen) }
          }
        }
      }
    }
    ai = ai + 1
  }
  if tnNames.length > 0 {
    pushScope(-1)
    applyNarrows(tnNames, tnTys)
  }
  retTailPosSet(ifTail)
  // Every `return` under this branch is reached only by an argument satisfying the guard's
  // alternative — mark the branch so `noteInferredRet` records it as a guarded member.
  const guardedRet = guardRows.length > 0
  if guardedRet { guardAltStackPush(guardRows[guardRows.length - 1]) }
  // The arm's OWN statement depth: its block pushes one scope, so a write recorded at exactly
  // this depth runs whenever the arm does and a deeper one is conditional (D1846).
  const thenOwnDepth = T.scopes.length + 1
  const thenLo = narClobKeys.length
  const thenArm = valueArmAt
  if valDiscarded(ix) {
    markValDiscard(n.ifThen)
  } else {
    valueArmAtSet(n.ifThen)
  }
  const thenSpine = spineAt
  if ifChainSpine { spineAtSet(n.ifThen) }
  const neMark = neEnter(n.ifCond, curFnDeclIx)
  checkNode(n.ifThen)
  neLeave(neMark)
  spineAtSet(thenSpine)
  valueArmAtSet(thenArm)
  const thenHi = narClobKeys.length
  // The guard-clause divergence test, asked once the arm is checked so a `never` call in it is
  // marked (D1972): the post-guard leg, the `else if` hand-up and the emitter's
  // `pushPostGuardNarrow` all ask the same predicate.
  const thenExits = stmtAlwaysExits(n.ifThen)
  if guardedRet { guardAltStackPop() }
  retTailPosSet(false)
  const thenTy = blockTailTy
  const thenIx = blockTailIx
  if tnNames.length > 0 { popScope() }
  // Seeds the inferred return from the then-branch value before the else is checked, so a
  // recursive call in the else resolves against the base case — only from a genuine value-`if`.
  if ifTail && n.ifElse >= 0 {
    if thenTy != TY_VOID && thenTy != TY_ERR {
      // The then-arm's implicit-return value is guarded exactly like an explicit
      // `return` inside it (`if v is T { v.foo } else { v.bar }`).
      if guardedRet { guardAltStackPush(guardRows[guardRows.length - 1]) }
      // The arm, not the arms' join: a tail `if`/`else` whose one arm is an open `[]` needs
      // the sibling arm's shape, and the join is a third arena row (D1591).
      noteInferRetWitness(thenIx, thenTy)
      const seedThen = ifArmValTy(n.ifThen, thenTy)
      noteInferredSeed(seedThen, armLit(seedThen, n.ifThen))
      if guardedRet { guardAltStackPop() }
    }
  }
  // Surviving paths' end-states, each as the DELTA its arm made against the fork point: the
  // ids it assigned and the ids it declared and left unwritten.
  const daThenSid: i32[] = []
  const daThenWas: i32[] = []
  daTouchedSince(daFork, daThenSid, daThenWas)
  daRollbackTo(daFork)
  const daThenAdds: i32[] = []
  const daThenRems: i32[] = []
  daSplitDelta(daThenSid, daThenWas, daThenAdds, daThenRems)
  // The else arm's own depth and row range, read by the arm join below. An absent else leaves
  // them at their no-rows defaults, which is what says the fall-through wrote nothing.
  let elseOwnDepth = -1
  let elseLo = 0
  const daHasElse = n.ifElse >= 0
  if daHasElse {
    if enNames.length > 0 {
      pushScope(-1)
      applyNarrows(enNames, enTys)
    }
    // An `else if` chain: the else node's VALUE is its own branch join, since `blockTailTy`
    // holds only the innermost block's tail and under-joins a mixed chain.
    const enElse = P.nodes[n.ifElse]
    // A chain link post-narrows the PARENT's fall-through, not its own — marked so its own
    // `checkIfStmtNode` banks into `pgUpKeys` instead of a scope that is about to be popped.
    if enElse is IfStmt { pgUpArmIxSet(n.ifElse) }
    retTailPosSet(ifTail)
    elseOwnDepth = T.scopes.length + 1
    elseLo = narClobKeys.length
  }
  return {
    ifIx: ix,
    isElseArm: isElseArm,
    pgUpMark: pgUpMark,
    clobMark: clobMark,
    ipMark: ipMark,
    headDepth: headDepth,
    headNp: headNp,
    ifTail: ifTail,
    ifInRetArg: ifInRetArg,
    seedLogMark: seedLogMark,
    seedObsMark: seedObsMark,
    seedObsLit: seedObsLit,
    thenExits: thenExits,
    tnNames: tnNames,
    tnTys: tnTys,
    tnEnt: tnEnt,
    enNames: enNames,
    enTys: enTys,
    enEnt: enEnt,
    altRows: altRows,
    thenOwnDepth: thenOwnDepth,
    thenLo: thenLo,
    thenHi: thenHi,
    thenTy: thenTy,
    daFork: daFork,
    daThenAdds: daThenAdds,
    daThenRems: daThenRems,
    daHasElse: daHasElse,
    elseOwnDepth: elseOwnDepth,
    elseLo: elseLo,
    exits: false,
  }
}

function checkCastNode(n: AsExpr, ix: i32) {
  let arg = checkNode(n.asObj)
  let target = nameToTyAt(n.asTy, ix)
  const targetClash = if target < 0 { unkTyClash } else { "" }
  // `x as u8` is the i64->i32 narrowing with a different domain (D1587): `u8` is a storage
  // type resolving to nothing in value position, but narrows the number into 0..255, exactly-or-fail.
  const isU8Cast = target < 0 && n.asTy == "u8"
  if isU8Cast { target = TY_I32 }
  if target < 0 {
    // A reason the resolver banked (a float literal) is the whole diagnostic, as for `is`.
    if targetClash.length > 0 {
      tErr(targetClash, ix)
    } else {
      tErr("unknown type `" + n.asTy + "` in `as` cast", ix)
    }
    return TY_ERR
  }
  // A literal tree cast exactly to `i64` is computed there, as one delivered to an `i64` is
  // (D2709). The wrap cast keeps the 32-bit reading it names.
  if target == TY_I64 && arg == TY_I32 && n.asMode != "wrap" {
    if litTreeAdoptDst(parenPeelIx(n.asObj), TY_I64) >= 0 { arg = TY_I64 }
  }
  // A hole operand answers neither of the trio's type-level questions, so the numeric ladder
  // admits it on purpose — park both on the hole, re-asked at the call site that pins it (D1342).
  if arg >= 0 {
    const argH = T.tys[arg]
    if argH is TyVar {
      noteCastDemand(argH.tvName, n, ix, target)
      // A pin may make `as?` to a number miss (a union arm, a narrowing number, another type),
      // so over a type parameter or a hole it is `N | null` at every pin, as over a union
      // (D2754, D3654).
      if n.asMode == "null" && isNumericPrimTy(target) {
        return mkNullableTy(target)
      }
    }
  }
  // Union-operand `as` is the ruled propagation cast: `x as T` over `x: A|B|...` names the arm
  // wanted, everything else is the error. A nullable operand is a union operand — one arm, no second ladder.
  let argU = arg
  if arg >= 0 {
    const argN = T.tys[arg]
    if argN is TyNullable {
      if argN.nInner >= 0 {
        const nulU = mkUnionTy([argN.nInner, TY_NULL])
        if nulU >= 0 { argU = nulU }
      }
    }
  }
  // `as%` picks no arm — it is the wrap cast over two integer widths, so a union operand is
  // simply not a number and takes the numeric ladder's own refusal below.
  if argU >= 0 && n.asMode != "wrap" {
    const argT = T.tys[argU]
    if argT is TyUnion {
      // `as u8` narrows a number, it does not pick an arm (D1587) — a union operand taking
      // the arm ladder would hand back the arm's own `i32` with no range test.
      if isU8Cast {
        tErr(
          "`as u8` narrows a number into 0..255, and "
            + tyToStr(argU)
            + " is a union — take the numeric arm first, then the range (`(x as! i32) as! u8`)",
          ix,
        )
        return TY_ERR
      }
      // A numeric union converts at whichever member it holds when no member's conversion
      // can fail, as each member alone would.
      if numUnionAsConverts(argU, target) && !njExprHeld(n.asObj) {
        return target
      }
      if !unionCoversTy(argT, target) {
        // A gradual union's parameter may hold the target at a pin: the cast is parked on the
        // parameter and re-asked there, as over a bare one (D2906).
        if unionHasDeclaredParam(argT.uMembers) {
          noteBinCstr(argU, OP_AS, target)
          if n.asMode == "null" { return mkNullableTy(target) }
          return target
        }
        tErr(
          "`as "
            + n.asTy
            + "` names a type that is not a member of "
            + tyToStr(argU),
          ix,
        )
        return TY_ERR
      }
      const twin = mapTwinTestMsg([argU], target, "`as`")
      if twin != "" {
        tErr(twin, ix)
        return TY_ERR
      }
      const rest = subtractTy(argU, target)
      if rest < 0 {
        tErr(
          "`as` cannot compute the propagated remainder of " + tyToStr(argU),
          ix,
        )
        return TY_ERR
      }
      // `as!` traps on a miss, so nothing is propagated and the enclosing return is not
      // consulted at all — that is the whole point of the form.
      if n.asMode == "trap" { return target }
      // `as?` coalesces to null, so the expression is `T | null` — again nothing propagates.
      // Whether `T | null` has a rep at all is the emitter's question, not this checker's.
      if n.asMode == "null" { return mkNullableTy(target) }
      // The propagated remainder must fit the enclosing return, because that is where it
      // goes. A pending return (-2) is refused rather than joined into.
      if !castPropagationFits(rest, n.asTy, ix, T.curRet, -1) { return TY_ERR }
      return target
    }
  }
  // A v128 to a v128 (a `new v128` brand on either side, or both) re-brands the same 128 bits:
  // no conversion, cannot fail, so every mode but `as%` answers the target itself.
  if primNameOf(target) == "v128" && arg >= 0 && primNameOf(arg) == "v128" {
    if n.asMode != "wrap" { return target }
  }
  const tn = primNameOf(target)
  const targetIsScalar = tn == "i32"
    || tn == "i64"
    || tn == "f32"
    || tn == "f64"
  // A `boolean` converts to any numeric target as 1 or 0: exact, so it never fails and every
  // mode answers the target. `as%` names a wrap between integer widths, which a boolean is not.
  if targetIsScalar && arg >= 0 && primNameOf(softenLitTy(arg)) == "boolean" {
    if n.asMode == "wrap" {
      tErr(AS_WRAP_BOOL_MSG, ix)
      return TY_ERR
    }
    return target
  }
  if !isNumeric(arg) || !targetIsScalar {
    if redundantCastRaise(n, arg, target, ix) { return TY_ERR }
    tErr(
      "`as` supports numeric conversions only" + emptyArrCastHint(n.asObj, target),
      ix,
    )
    return TY_ERR
  }
  // `as%` keeps the low bits and cannot fail, so it owes none of the trio's sad-path answers
  // and the target type is the whole result (`DECISIONS.md` §"`as%` is the wrap cast").
  if n.asMode == "wrap" {
    if wrapCastFloatRefused(arg, target, ix) { return TY_ERR }
    return target
  }
  const constCast = castConstDecide(n, ix, arg, target)
  if constCast == 1 { return target }
  if constCast == 2 { return TY_ERR }
  if castBoundDecide(n, ix, arg, target) { return target }
  // The numeric arm honours the trio too: a cast that can fail owes the same three answers
  // the union arm gives, from the same words — the suffix went unchecked and silently ignored (D1041).
  const castDom = numCastDomainName(n.asTy, target)
  if numCastCanFail(primNameStr(primNameOf(arg)), castDom) {
    // `as!` traps on a miss, so nothing is propagated and the enclosing return is not
    // consulted — the same reading as the union arm's trap mode.
    if n.asMode == "trap" { return target }
    // `as?` re-wraps to `T | null` and the null stays local to the expression.
    if n.asMode == "null" { return mkNullableTy(target) }
    // A bare `as` propagates `null`, so the enclosing return must carry it.
    if !castPropagationFits(TY_NULL, n.asTy, ix, T.curRet, arg) {
      return TY_ERR
    }
  }
  target
}

// Extracted from `checkNodeReal`'s `Unary` arm (C3: thin the dispatcher).
function checkUnaryNode(n: Unary, ix: i32) {
  const arg = checkNode(n.unArg)
  if n.unOp == "!" {
    if !assignable(arg, TY_BOOL) {
      tErr("operator '!' expects boolean, got " + tyToStr(arg), ix)
    }
    return TY_BOOL
  }
  // Postfix `x++`/`x--`: `unArg` is the `x = x +- 1` assignment, already fully checked
  // above (const-reassign, arithmetic, assignability). The postfix type is the operand's.
  if n.unOp == "p+" || n.unOp == "p-" {
    if numUnionMinted && tyIsNumUnion(arg) {
      tErr(
        "'++'/'--' over the numeric union "
          + tyToStr(arg)
          + " is not supported; write `x += 1`",
        ix,
      )
      return TY_ERR
    }
    if !isNumeric(arg) {
      tErr("'++'/'--' expects a numeric variable, got " + tyToStr(arg), ix)
      return TY_ERR
    }
    return arg
  }
  // The negation of an unpinned intrinsic element takes the default its binary siblings
  // take (D1566), asked here (not above `!`) since `!a[0]` is admitted over an open operand today.
  let arg2 = arg
  if arg2 < 0 {
    const peekU = arrDefOperandElemPeek(n.unArg)
    if peekU >= 0 { arg2 = peekU }
  }
  // A hole operand is numeric only at a pin that says so; the pin re-asks it (`OP_NEG`, or
  // `OP_BNOT` for `~`, which a float pin cannot satisfy).
  if arg2 >= 0 && !(T.tys[arg2] is TyPrim) && tyHasHole(arg2) {
    let unCstr = OP_NEG
    if n.unOp == "~" { unCstr = OP_BNOT }
    noteBinCstr(arg2, unCstr, arg2)
    arg2 = tpGradualView(arg2)
  }
  // A numeric union negates at each member's own type.
  if (
    numUnionMinted
    && n.unOp == "-"
    && tyIsNumUnion(arg2)
    && !njExprHeld(n.unArg)
  ) {
    return arg2
  }
  // A literal set negates at its base, as `x - 1` computes over it.
  if n.unOp == "-" && !isNumeric(arg2) && isNumeric(softenLitOpTy(arg2)) {
    arg2 = softenLitOpTy(arg2)
  }
  if !isNumeric(arg2) {
    tErr(
      "unary '" + n.unOp + "' expects a numeric type, got " + tyToStr(arg2),
      ix,
    )
    return TY_ERR
  }
  // `~` flips bits and a float has none, the binary bitwise family's rule (D3629).
  if n.unOp == "~" && binFloatOperandPair(arg2, arg2) {
    tErr("operator '~' is integer-only, got " + tyToStr(arg2), ix)
    return TY_ERR
  }
  // Host parity: the host folds `-lit` into a signed literal before defaulting, so
  // `-2147483648` sits at I32_MIN and is i32 even though the bare literal alone types i64.
  // A chain a wide destination adopted keeps its 64-bit leaf on a re-check.
  if n.unOp == "-" {
    if isNegI32MinLit(n.unArg) && litTreeTyOf(parenPeelIx(n.unArg)) != TY_I64 {
      return TY_I32
    }
  }
  arg2
}
// ── getters `get p(self: T): R` (property-access-design.md §D3a) ──────────────

// `recv.length` over a union of lists: i32, or -1 when `objTy` is not one the rewrite names.
function luLengthAt(n: Member, ix: i32, objTy: i32): i32 {
  if luOwnRecv(n.memObj) || (luWriteTgt[ix] ?? false) { return -1 }
  const ms = luMembers(objTy)
  if ms.length == 0 || !luRecvLowers(n.memObj, ms) { return -1 }
  if inferQuiet { return symMem(ix, TY_I32) }
  if !luAllSpell(objTy, ms) { return -1 }
  const recv = "$lu" + i32ToStr(ix)
  const stmts: i32[] = []
  stmts.push(luDecl("const", recv, objTy, n.memObj, ix, n.pos))
  stmts.push(luChain(ms, 0, recv, "", -1, ix, n.pos))
  luValueAt(ix, stmts, n.pos)
  checkNode(ix)
}

// `recv[i]` read over a union of lists: the element union, or -1 as `luLengthAt`. A write
// through the index is not rewritten, since storing one arm's element in another is unsound.
function luIndexAt(n: Index, ix: i32, arrTy: i32): i32 {
  if luWriteTgt[ix] ?? false { return -1 }
  if luOwnRecv(n.idxArr) { return -1 }
  const ms = luMembers(arrTy)
  if ms.length == 0 || !luRecvLowers(n.idxArr, ms) { return -1 }
  const elem = luElemTy(ms)
  if elem < 0 { return -1 }
  if inferQuiet { return elem }
  if !luAllSpell(arrTy, ms) || luSpell(elem) == "" { return -1 }
  const recv = "$lu" + i32ToStr(ix)
  const idx = "$li" + i32ToStr(ix)
  const stmts: i32[] = []
  stmts.push(luDecl("const", recv, arrTy, n.idxArr, ix, n.pos))
  stmts.push(luDecl("const", idx, -1, n.idxIndex, ix, n.pos))
  stmts.push(luChain(ms, 0, recv, idx, elem, ix, n.pos))
  luValueAt(ix, stmts, n.pos)
  checkNode(ix)
}

// `for v[, i] in recv { body }` over a union of lists, rewritten in place to
// `{ const $lu = recv; let $li = 0; while true { if $li >= <len> { break }; let i = $li;
// $li = $li + 1; let v: E = <$lu[i]>; body } }`, which re-reads the length every pass as a
// list's own loop does. -1 when a member or the element union has no spelling.
function luForInAt(n: ForIn, ix: i32, iterTy: i32, ms: i32[], elem: i32): i32 {
  if !luAllSpell(iterTy, ms) || luSpell(elem) == "" { return -1 }
  const pos = n.pos
  const recv = "$lu" + i32ToStr(ix)
  const ctr = "$li" + i32ToStr(ix)
  let at = n.fiVar2
  if at == "" { at = "$lk" + i32ToStr(ix) }
  const outer: i32[] = []
  outer.push(luDecl("const", recv, iterTy, n.fiIter, ix, pos))
  outer.push(luDecl("let", ctr, -1, luAt(mkNum("0", pos), ix), ix, pos))
  const lenCond = luAt(
    mkBinary(
      ">=",
      luRef(ctr, ix, pos),
      valueIfAdd(luChain(ms, 0, recv, "", -1, ix, pos)),
      pos,
    ),
    ix,
  )
  const brk: i32[] = []
  brk.push(luAt(mkBreak("break", "", pos), ix))
  const loop: i32[] = []
  loop.push(luAt(mkIf(lenCond, luAt(mkBlock(brk, pos), ix), -1, pos), ix))
  const atDecl = luDecl("let", at, -1, luRef(ctr, ix, pos), ix, pos)
  luDeclPosPut(atDecl, n.fiIter)
  loop.push(atDecl)
  const inc = luAt(
    mkBinary("+", luRef(ctr, ix, pos), luAt(mkNum("1", pos), ix), pos),
    ix,
  )
  loop.push(luAt(mkBinary("=", luRef(ctr, ix, pos), inc, pos), ix))
  const val = valueIfAdd(luChain(ms, 0, recv, at, elem, ix, pos))
  const vDecl = luDecl("let", n.fiVar, elem, val, ix, pos)
  luDeclPosPut(vDecl, n.fiIter)
  loop.push(vDecl)
  const bn = P.nodes[n.fiBody]
  if bn is Block {
    let i = 0
    while i < bn.blkStmts.length {
      loop.push(bn.blkStmts[i])
      i = i + 1
    }
  } else {
    loop.push(n.fiBody)
  }
  const cond = luAt(mkBool(1, -1), ix)
  const body = luAt(mkBlock(loop, pos), ix)
  outer.push(luAt(mkWhile(cond, body, n.fiLabel, pos, 0), ix))
  // `if true { … }` rather than a bare block, the statement form every walk descends.
  const once = luAt(mkBool(1, -1), ix)
  const w: Node = {
    ifCond: once,
    ifThen: luAt(mkBlock(outer, pos), ix),
    ifElse: -1,
    pos: pos,
  }
  arenaSetNode(ix, w)
  luGrow()
  checkNode(ix)
}

// ── a function value at another function type (D3073) ──────────────────────
// A function value keeps the `$fnsig` it carries, so a call through a function type of another
// rep traps. The delivery is rewritten in place into `(p…): R => f(p…)` at the destination's
// type and checked as written code; a conversion that code cannot make is refused there.

// Rewrites the function value at `srcExpr`, of type `srcTy`, into an adapter at `dstTy`'s
// function type, when the two may differ in rep. True when the delivery is settled here,
// rewritten or refused; false leaves it to the caller unchanged.
function fvaAdapt(srcExpr: i32, srcTy: i32, dstTy: i32): boolean {
  fvaNoteNameDecl(srcExpr)
  if srcTy == dstTy || inferQuiet || monoRecheckDepth > 0 { return false }
  if srcExpr < 0 || srcTy < 0 || dstTy < 0 { return false }
  if srcTy >= T.tys.length || dstTy >= T.tys.length { return false }
  if !tyMayHoldFn(dstTy, 0) { return false }
  // A literal delivers each element or field at the destination's own type, one seam down.
  const lit = P.nodes[parenPeelIx(srcExpr)]
  if lit is ArrayLit {
    const da = T.tys[nonNullTy(dstTy)]
    if da is TyArray {
      for el in lit.arrElems {
        if spreadArgOf(el) < 0 { fvaAdapt(el, nodeTyIxOf(el), da.aElem) }
      }
    }
    return false
  }
  if lit is ObjLit {
    const dob = T.tys[nonNullTy(dstTy)]
    if dob is TyObj {
      for fi in lit.objFields {
        const f = P.nodes[fi]
        if f is FieldInit {
          const ft = objFieldType(dob, f.fiName)
          if ft >= 0 { fvaAdapt(f.fiValue, nodeTyIxOf(f.fiValue), ft) }
        }
      }
    }
    return false
  }
  const dt = nonNullTy(dstTy)
  if dt < 0 { return false }
  const d = T.tys[dt]
  const s = T.tys[srcTy]
  if s is TyFunc && d is TyUnion {
    // A function delivered into a union lands in the one function arm it converts to.
    const arm = fvaUnionArm(d, srcTy)
    if arm >= 0 { return fvaAdapt(srcExpr, srcTy, arm) }
    if arm == -2 {
      fvaRefuse(
        srcExpr,
        srcTy,
        dt,
        "it converts into more than one function arm of the union",
      )
      return true
    }
  }
  if !(s is TyFunc) || !(d is TyFunc) {
    // A function inside a container is not rewritten on the way, so a call through the
    // destination's function type would reach it at another signature.
    if fvaNestedFnDiffers(srcTy, dstTy, 0, 8) {
      fvaRefuseNested(srcExpr, srcTy, dstTy)
      return true
    }
    return false
  }
  if s.fnRet < 0 || d.fnRet < 0 { return false }
  if tyHasTyVar(dt) || s.fnParamTypes.length != d.fnParamTypes.length {
    return false
  }
  const site = srcExpr
  const pe = P.nodes[parenPeelIx(site)]
  // A generic function named as a value is instantiated by the adapter's direct call, whatever
  // type the checker gave the name (D3112); any other type parameter in the source is an
  // enclosing generic's, pinned per instance.
  if fvaDone[site] ?? false { return false }
  if tyReachesHole(dt, 8) { return false }
  if !fvaNamesGeneric(pe, parenPeelIx(site)) {
    // A hole is pinned later, where the value's use decides it.
    if fnTyHasHole(srcTy) || tyHasTyVar(srcTy) || tyReachesHole(srcTy, 8) {
      return false
    }
    if !fvaFnMayDiffer(srcTy, dt, 8) { return false }
  }
  const pos = nodePos(site)
  const params: i32[] = []
  const args: i32[] = []
  let i = 0
  while i < d.fnParamTypes.length {
    const pt = fvaAnnot(d.fnParamTypes[i], site, pos)
    if pt < 0 {
      fvaRefuse(srcExpr, srcTy, dt, "")
      return true
    }
    const pn = "$fp" + i32ToStr(i)
    params.push(luAt(mkParam(pn, pt, -1, 0, 0, pos), site))
    args.push(luRef(pn, site, pos))
    i = i + 1
  }
  const rt = fvaAnnot(d.fnRet, site, pos)
  if rt < 0 {
    fvaRefuse(srcExpr, srcTy, dt, "")
    return true
  }
  // A function declaration or a `const` is stable; any other value is read once, as the
  // argument of an enclosing lambda called in place, so the adapter calls the delivered value
  // rather than what a `let` later holds.
  const stable = fvaStableName(pe, parenPeelIx(site))
  let callee = -1
  let fvParam = -1
  if stable {
    if pe is Ident { callee = luRef(pe.identName, site, pos) }
  } else {
    const st = fvaAnnot(srcTy, site, pos)
    if st < 0 {
      fvaRefuse(srcExpr, srcTy, dt, "")
      return true
    }
    const fv = "$fv" + i32ToStr(site)
    fvParam = luAt(mkParam(fv, st, -1, 0, 0, pos), site)
    callee = luRef(fv, site, pos)
  }
  const lam = fvaLambda(
    params,
    rt,
    luAt(mkCall(callee, args, pos), site),
    site,
    pos,
  )
  fvaDone.set(site, true)
  const mark = T.diags.length
  if stable {
    arenaSetNode(site, lam)
  } else {
    const moved = addNode(P.nodes[site])
    adoptNodeTok(moved, site)
    const li = luAt(addNode(lam), site)
    const outerPs: i32[] = []
    outerPs.push(fvParam)
    const outer = luAt(addNode(fvaLambda(outerPs, -1, li, site, pos)), site)
    const outerArgs: i32[] = []
    outerArgs.push(moved)
    const names: string[] = []
    const c: Node = {
      callFn: outer,
      callArgs: outerArgs,
      callArgNames: names,
      pos: pos,
    }
    arenaSetNode(site, c)
  }
  luGrow()
  const t = checkNode(site)
  if T.diags.length > mark || !assignable(t, dstTy) {
    let why = ""
    if T.diags.length > mark { why = T.diags[mark].tmsg }
    while T.diags.length > mark { T.diags.pop() }
    fvaRefuse(site, srcTy, dt, why)
  }
  true
}

// Extracted from `checkNodeReal`'s `Member` arm (C3: thin the dispatcher).
function checkMemberNode(n: Member, ix: i32) {
  // Flat layout constant (webcraft P1.2): answered before the receiver is checked, since the
  // receiver is a TYPE name and checking it as an expression would be "undeclared identifier".
  const fl = flatMemberFold(n, ix)
  // The receiver of a folded layout member names a type, which no value binding declares.
  if fl == 1 || fl == 3 { identSet(n.memObj, IDENT_BUILTIN) }
  if fl == 1 { return TY_I32 }
  if fl == 2 { return TY_ERR }
  // A layout member on a type parameter: an `i32` whose value the monomorphizer
  // supplies per instance. The node stays a `Member` until then.
  if fl == 3 { return TY_I32 }
  // A flow-narrowed property path (`if o.v is T { … }`) overrides the stored
  // field type within the branch (the host's `narrowedPaths` overlay).
  const mKey = placeKeyOf(ix)
  if mKey != "" {
    const mOv = narrowedPathTy(mKey)
    if mOv >= 0 {
      identNotePlace(n.memObj)
      crNoteLoopRead(mKey, ix)
      crNoteCaptureRead(mKey)
      return symMem(ix, mOv)
    }
    crNoteLostRead(mKey, ix)
    const mInv = narrowedPathInvBy(mKey)
    if (
      mInv >= 0
      && !(luWriteTgt[ix] ?? false)
      && !pathReadsDeclared(mKey, mInv, ix)
    ) {
      return pathInvalidatedErr(mKey, mInv, ix)
    }
    if mInv < 0 { crPathDropRead(mKey, ix) }
  }
  const objTy0 = strLitRecvTy(checkNode(n.memObj))
  // A negative receiver type is an unpinned inference hole, not an arena index — indexing
  // `T.tys` with it would crash. Already reported elsewhere, so don't cascade.
  if objTy0 < 0 { return TY_ERR }
  let objTy = objTy0
  if T.tys[objTy0] is TyUnion {
    const gObj = tpGradualRecv(objTy0, n.memProp, ix)
    if gObj >= 0 && gObj < T.tys.length { objTy = gObj }
  }
  // A getter on the receiver's nominal type, when no field or built-in member shares its name.
  const gFn = getterFnFor(objTy, n.memProp)
  if gFn != "" { return getterReadTy(gFn, n, ix) }
  const ot = T.tys[objTy]
  if ot is TyObj {
    const ft = objFieldType(ot, n.memProp)
    if ft < 0 {
      memberFloorErr(objTy, n.memProp, ix)
      return TY_ERR
    }
    return symMem(ix, ft)
  }
  if ot is TyErr { return TY_ERR }
  // Shared-field access over a struct union — a field every member carries at the same
  // type; an unshared field still needs an `is` narrowing.
  if ot is TyUnion {
    const sf = sharedUnionFieldTy(ot, n.memProp)
    if sf >= 0 {
      sharedFieldJoinWidens(ot, n.memProp, sf, ix)
      return symMem(ix, sf)
    }
    if n.memProp == "length" {
      // A string-literal union is a string: its length is the member's (D3423).
      if tyIsLitUnion(objTy) {
        if lengthWriteRefused(n, ix, 2) { return TY_ERR }
        return symMem(ix, TY_I32)
      }
      const lul = luLengthAt(n, ix, objTy)
      if lul >= 0 { return lul }
    }
    // The field is on some but not all members — unsafe until narrowed to a member that
    // has it. Names the offending member so a reader need not diff a four-arm union by hand.
    memberFloorErr(objTy, n.memProp, ix)
    return TY_ERR
  }
  // `.length` on an array, a map, or a string is an i32.
  if ot is TyArray {
    if lengthWriteRefused(n, ix, 0) { return TY_ERR }
    if n.memProp == "length" { return symMem(ix, TY_I32) }
    memberFloorErr(objTy, n.memProp, ix)
    return TY_ERR
  }
  if ot is TyMap {
    // `.length` is the live-entry count (an i32), the one name every collection answers;
    // `.size` is refused with a redirect to it (`lengthSpellNote`).
    if lengthWriteRefused(n, ix, 1) { return TY_ERR }
    if n.memProp == "length" { return symMem(ix, TY_I32) }
    memberFloorErr(objTy, n.memProp, ix)
    return TY_ERR
  }
  if ot is TyPrim {
    if ot.primName == "string" {
      if lengthWriteRefused(n, ix, 2) { return TY_ERR }
      if n.memProp == "length" { return symMem(ix, TY_I32) }
      memberFloorErr(objTy, n.memProp, ix)
      return TY_ERR
    }
  }
  // Member access on an inference hole records the demanded field and yields its derived
  // hole; the call site pins both (A13).
  if ot is TyVar {
    // D14-L/D691: `.length` on a type parameter is admitted here and re-asked at the pin —
    // a bounded type parameter reads its members from its bound first, checked before `.length` (OQ-5).
    const bmTy = boundMemberTy(ot.tvName, n.memProp, false)
    if bmTy == BOUND_UNRESOLVED {
      tErr(boundMemberUnknownMsg(ot.tvName, n.memProp), ix)
      return TY_ERR
    }
    if bmTy >= 0 { return symMem(ix, bmTy) }
    const bmMsg = boundMemberFloorMsg(ot.tvName, n.memProp)
    if bmMsg != "" {
      tErr(bmMsg, ix)
      return TY_ERR
    }
    if n.memProp == "length" {
      noteMemCstr(objTy, n.memProp, ix, false)
      return symMem(ix, TY_I32)
    }
    // A place holding a written type-parameter value reads its members as the parameter does:
    // each pin re-asks the read of the member it lands on, a nullable one included (D3240).
    if tyIsWriteLandRead(objTy) {
      noteMemCstr(objTy, n.memProp, ix, false)
      const twFld = mkDerivedHole(HD_FLD, n.memProp, -1, -1, objTy)
      if twFld >= 0 { return symMem(ix, twFld) }
    }
    if ot.tvName.length > 0 {
      if ot.tvName[0] == '?' {
        noteNullReadCstr(objTy, n.memProp, ix, n.memObj)
        // A read off a parameter's derivation after a write or call ended its narrowing is
        // re-asked at its pin, as the direct spelling's read is (D3233); off an un-annotated
        // parameter's, only an `is` remainder every pin sees ended (D3420).
        if (
          narrowingEndedAt(n.memObj)
          && (tyIsDeclaredParam(hdRootTy(objTy))
            || holeRemainderEndedSure(n.memObj))
        ) {
          noteMemCstr(objTy, n.memProp, ix, false)
        }
        // `.length` is the i32 length an array/string/map exposes — treat it as that (not a
        // struct field), so a collection-shaped hole infers without growing a bogus `{length}` shape.
        return symMem(ix, holeMemberTy(objTy, ot.tvName, n.memProp))
      }
    }
    // An unbounded `<T>` is an entirely open hole: the member read derives its type as the
    // `?`-hole does, keyed by the receiver's arena type so each generic adjudicates its own calls (D1431).
    if tpBoundOfName(ot.tvName) < 0 {
      noteMemCstr(objTy, n.memProp, ix, true)
      const tpFld = mkDerivedHole(HD_FLD, n.memProp, -1, -1, objTy)
      if tpFld >= 0 { return symMem(ix, tpFld) }
    }
  }
  memberFloorErr(objTy, n.memProp, ix)
  return TY_ERR
}
// ── array literal ───────────────────────────────────────────────────────────
// `[e, e, ...]` types as `T[]` where `T` is the first element's type (the rest must be
// assignable to it). An empty `[]` is `T[]` with an unknown element (`-1`), assignable to any
// array — its concrete element is pinned by the binding's annotation.

// Extracted from `checkNodeReal`'s `ArrayLit` arm (C3: thin the dispatcher).
function checkArrayLitNode(n: ArrayLit, _ix: i32) {
  const elems = n.arrElems
  if elems.length < 1 { return mkArrayTy(-1) }
  if hasSpreadItem(elems) { return checkSpreadArrayLit(elems) }
  // A `void` element has no value to store — poisoned to `TY_ERR` rather than joined, so an
  // annotated literal keeps one "cannot assign" message instead of a second one.
  let elemTy = widenLitTy(checkNode(elems[0]))
  if voidValueSlotErr(elemTy, elems[0], "list element", elems[0]) {
    elemTy = TY_ERR
  }
  const ets: i32[] = [elemTy]
  let ei = 1
  while ei < elems.length {
    let et = widenLitTy(checkNode(elems[ei]))
    if voidValueSlotErr(et, elems[ei], "list element", elems[ei]) {
      et = TY_ERR
    }
    ets.push(et)
    // Host parity: the element type is the union of every element's type (flattened/deduped)
    // — mixed struct variants type as `(A | B | C)[]`; an annotation then checks structurally.
    elemTy = joinTys(elemTy, et)
    ei = ei + 1
  }
  const apart = listJoinApart(elems, ets)
  if apart >= 0 { elemTy = apart }
  // An f32 element beside literal ones types the list `f32[]`, as it does an `if` join.
  if (
    apart < 0
    && elemTy >= 0
    && primNameOf(elemTy) != "f32"
    && elems.length > 1
    && f32JoinRetypesRunning()
  ) {
    const f32El = f32LitJoinOf(elems, ets)
    if f32El >= 0 { elemTy = f32El }
  }
  if neverValueSlotErr(elemTy, "a list element", elems[0]) { elemTy = TY_ERR }
  if elemTy == TY_NULL { nolLitsPush(_ix) }
  if elemTy >= 0 && T.tys[elemTy] is TyUnion { ulLitNSet(ulLitN + 1) }
  return mkArrayTy(elemTy)
}

// `[...a, e, ...b]` — the element type joins every plain element's type with every spread
// source's ELEMENT type. A spread of an empty list contributes nothing, so `[...[]]` stays an
// unpinned `T[]` exactly as `[]` does, and a literal that is only spreads of empty lists is
// pinned by its destination like any other empty one.
function checkSpreadArrayLit(elems: i32[]) {
  let elemTy = -1
  let ei = 0
  while ei < elems.length {
    let et = -1
    if spreadArgOf(elems[ei]) >= 0 {
      et = spreadElemTy(elems[ei])
    } else {
      et = widenLitTy(checkNode(elems[ei]))
      if voidValueSlotErr(et, elems[ei], "list element", elems[ei]) {
        et = TY_ERR
      }
    }
    if et >= 0 {
      if elemTy < 0 { elemTy = et } else { elemTy = joinTys(elemTy, et) }
    }
    ei = ei + 1
  }
  mkArrayTy(elemTy)
}
// ── index `a[i]` ────────────────────────────────────────────────────────────

// Extracted from `checkNodeReal`'s `Index` arm (C3: thin the dispatcher).
function checkIndexNode(n: Index, ix: i32) {
  const arrTy0 = strLitRecvTy(checkNode(n.idxArr))
  const idxTy = checkNode(n.idxIndex)
  // Guard the unpinned-hole receiver (`-1` — see the Member-arm note).
  if arrTy0 < 0 { return TY_ERR }
  let arrTy = arrTy0
  if T.tys[arrTy0] is TyUnion {
    const gArr = tpGradualRecv(arrTy0, OP_INDEX_GET, ix)
    if gArr >= 0 && gArr < T.tys.length { arrTy = gArr }
  }
  lbiNoteIndex(arrTy, n.idxIndex)
  if !inferQuiet { strIdxRecord(ix, arrTy) }
  // A flow-narrowed constant-index place overrides the element type within the branch — asked
  // after the receiver/subscript check (unlike the member arm) since the subscript node needs banking.
  const xKey = placeKeyOf(ix)
  if xKey != "" {
    const xOv = narrowedPathTy(xKey)
    if xOv >= 0 {
      crNoteLoopRead(xKey, ix)
      crNoteCaptureRead(xKey)
      return xOv
    }
    crNoteLostRead(xKey, ix)
    const xInv = narrowedPathInvBy(xKey)
    if (
      xInv >= 0
      && !(luWriteTgt[ix] ?? false)
      && !pathReadsDeclared(xKey, xInv, ix)
    ) {
      return pathInvalidatedErr(xKey, xInv, ix)
    }
    if xInv < 0 { crPathDropRead(xKey, ix) }
  }
  const at = T.tys[arrTy]
  // A map index: the key must match the map's key type; a read yields the nullable value
  // (`V | null`), and an assignment target accepts a plain `V`.
  if at is TyMap {
    // A set has no index: membership is `has`, insertion `add`.
    if at.mSet == 1 {
      tErr(
        "a Set has no index — test membership with `.has(x)` and insert with `.add(x)`",
        ix,
      )
      return TY_ERR
    }
    // The expression form, for the same reason `m.get`'s does: `m["green"]` on a
    // literal-union-keyed map is a member of that union, and `checkNode` types a string
    // literal as the widened `string` with no destination to narrow it against (D1748).
    if !assignableExpr(n.idxIndex, idxTy, at.mKey) {
      tErr(
        "map key must be " + tyToStr(at.mKey) + ", got " + tyToStr(idxTy),
        n.idxIndex,
      )
    }
    return mkNullableTy(at.mVal)
  }
  // Indexing a hole constrains it to an array: demand an i32 index and return the element as
  // a derived hole (`HD_ELEM`), resolved per call site — mirrors `holeMemberTy` for `self.x`.
  if at is TyVar {
    if !assignable(idxTy, TY_I32) {
      // A non-i32 index can only be a map — constrain the hole to its demanded map and pin
      // the key from the index (the index-spelling twin of the `.set` arm's pin).
      if mapKeyTySupported(idxTy) {
        if tyIsWriteLandRead(arrTy) {
          noteMemCstr(arrTy, MC_NULL_READ_MARK + OP_INDEX_GET, ix, false)
        }
        const hmi = holeMapDemandTy(at.tvName, false)
        const hmt = T.tys[hmi]
        if hmt is TyMap {
          if hmt.mKey < 0 {
            hmt.mKey = idxTy
            tyMutEpoch = tyMutEpoch + 1 // hole index-read pinned the demanded key in place
          }
          return mkNullableTy(hmt.mVal)
        }
      }
      tErr("array index must be i32, got " + tyToStr(idxTy), n.idxIndex)
    }
    noteArrayDemand(arrayDemandKey(arrTy))
    // Admitted here and re-asked at the pin (D691): `noteArrayDemand` only reaches a bound
    // receiver and refuses scalars/maps — a record/nullable/function/union pinned reaches the emitter unruled.
    noteMemCstr(arrTy, OP_INDEX_GET, ix, false)
    return mkDerivedHole(HD_ELEMV, "", -1, -1, arrTy)
  }
  // Free index operator (B14): `x[i]` on a non-indexable receiver resolves to a declared
  // `"[]"` function by type. Checked before the closure-field trap, mirroring the `a op b` order.
  if opIdxDeclared() {
    if !tyBuiltinIndexable(arrTy) {
      const rfn = opIdxFnFor(OP_INDEX_GET, arrTy)
      if rfn != "" {
        const bNames: string[] = []
        const bTys: i32[] = []
        opIdxBindGen(rfn, arrTy, idxTy, bNames, bTys)
        const kt = opIdxParamTy(rfn, 1)
        if kt >= 0 {
          const ktb = substTyDeep(kt, bNames, bTys)
          if !assignableExpr(n.idxIndex, idxTy, ktb) {
            tErr(
              "index: expected " + tyToStr(ktb) + ", got " + tyToStr(idxTy),
              ix,
            )
          }
        }
        opIdxBank(ix, rfn)
        noteCallInvalidations(ix)
        const rty = opIdxRetTy(rfn)
        if bNames.length > 0 { return substTyDeep(rty, bNames, bTys) }
        return rty
      }
      // A write operator with no read operator is not a usable type: the assignment form
      // checks the target as an ordinary index and would name the wrong half — say which is missing.
      const wOnly = opIdxFnFor(OP_INDEX_SET, arrTy)
      if wOnly != "" {
        tErr(
          "operator "
            + opDeclLabel(wOnly)
            + " needs a matching \""
            + OP_INDEX_GET
            + "\" operator — an index that cannot be READ cannot be written either",
          ix,
        )
        return TY_ERR
      }
    }
  }
  // Index trap (B13): a user object declaring `"[]"` handles `o[k]` itself — the key checks
  // against the method's parameter, checked before the native i32-index rule. Write traps use `"[]="`.
  if at is TyObj {
    const trap = objFieldType(at, "[]")
    if trap >= 0 {
      const tt = T.tys[trap]
      if tt is TyFunc {
        if tt.fnParamTypes.length == 1 {
          if !assignableExpr(n.idxIndex, idxTy, tt.fnParamTypes[0]) {
            tErr(
              "index: expected "
                + tyToStr(tt.fnParamTypes[0])
                + ", got "
                + tyToStr(idxTy),
              ix,
            )
          }
          return tt.fnRet
        }
      }
    }
    tErr(indexFloorMsg(arrTy), ix)
    return TY_ERR
  }
  if !assignable(idxTy, TY_I32) {
    tErr("array index must be i32, got " + tyToStr(idxTy), n.idxIndex)
  } else if tyHasTyVar(idxTy) {
    // A hole passes vacuously; the pin asks again at the type it binds (D3584).
    noteArgCstr(idxTy, TY_I32, "", ACF_INDEX, -1)
  }
  if at is TyUnion {
    // An index that is not an `i32` is already reported above.
    if !assignable(idxTy, TY_I32) && luMembers(arrTy).length > 0 {
      return TY_ERR
    }
    const lui = luIndexAt(n, ix, arrTy)
    if lui >= 0 { return lui }
    // A read rewrites; a write is refused by design, since the stored value would have to
    // fit every member's element at once.
    if (luWriteTgt[ix] ?? false) && luMembers(arrTy).length > 0 {
      tErr(
        "cannot write through an index of "
          + tyToStr(arrTy)
          + ": the value would have to fit every member's element — narrow with `is` first",
        ix,
      )
      return TY_ERR
    }
  }
  if at is TyArray {
    const ev = elemEveryReadTy(ix)
    if ev >= 0 { return ev }
    // The element's value type — a `u8[]` read is an `i32`, never a `u8`. Same shape as the
    // string arm below: `string` is `(array i32)` with no `char` type above it (DECISIONS A7).
    return arrElemValueTy(at.aElem)
  }
  if at is TyErr { return TY_ERR }
  // Indexing a string yields the UTF-8 byte at that position, as an `i32`.
  if at is TyPrim {
    if at.primName == "string" { return TY_I32 }
  }
  tErr(indexFloorMsg(arrTy), ix)
  return TY_ERR
}

// Extracted from `checkNodeReal`'s `ObjLit` arm (C3: thin the dispatcher).
function checkObjLitNode(n: ObjLit, ix: i32) {
  const fields = n.objFields
  if fields.length == 0 {
    // A `{}` statement is an empty block, refused by the parser, or for a block's last
    // statement by `bareBraceDeliver` / `bareBraceUndelivered`; the error type keeps it at one.
    if i32ListHas(stmtBraceNodes, ix) {
      bareBraceCountSet(bareBraceCount + 1)
      if i32ListHas(stmtBraceTails, ix) { bareBraceLits.push(ix) }
      return TY_ERR
    }
    bareBraceLits.push(ix)
  }
  const fnames: string[] = []
  const ftys: i32[] = []
  let i = 0
  while i < fields.length {
    const fnode = P.nodes[fields[i]]
    if fnode is FieldInit {
      fnames.push(fnode.fiName)
      // A `void` field initializer has no value to store — poisoned to `TY_ERR` so an
      // annotated literal keeps one message, instead of an uninterned-shape reject naming nothing.
      let fty = widenLitTy(checkNode(fnode.fiValue))
      const fslot = "field '" + fnode.fiName + "'"
      if voidValueSlotErr(fty, fnode.fiValue, fslot, fnode.fiValue) {
        fty = TY_ERR
      }
      if neverValueSlotErr(fty, fslot, fnode.fiValue) { fty = TY_ERR }
      ftys.push(fty)
    }
    i = i + 1
  }
  objLitDupKeyErrs(fields)
  return mkObjTy(fnames, ftys)
}

function checkIsExprNode(n: IsExpr, ix: i32) {
  // The tested place is a test, not a use: its lowering reads the field's own rep.
  const savedIsObj = crIsObj
  crIsObjSet(n.isObj)
  let objTy = checkNode(n.isObj)
  crIsObjSet(savedIsObj)
  const chkTy = isTypeTy(n.isVariant, ix)
  const chkClash = if chkTy < 0 { unkTyClash } else { "" }
  // A literal set that only overlaps the operand's tests as the overlap (D2205), and a base
  // scalar tests the literal members it is the base of (D3522).
  let meet = litSetMeetTy(objTy, chkTy)
  if meet == -1 && n.isVariant != "null" { meet = litBaseMeetTy(objTy, chkTy) }
  if meet == -1 { meet = litPrimMeetTy(objTy, chkTy) }
  if meet == -1 { meet = recFitMeetTy(objTy, chkTy) }
  // A `const` literal tests as the compare does: against a literal it never equals the
  // test is refused, and against anything else it is the `string` it is (D2198).
  if chkTy >= 0 && isWideLitJoin(objTy) {
    if allStrLitMembers(chkTy) {
      if strLitSetsDisjoint(objTy, chkTy) {
        tErr(
          constLitNeverMsg(n.isObj, objTy, chkTy, "test is always false"),
          ix,
        )
        return TY_BOOL
      }
      // Sets that meet test as their overlap (`meet`, D2205): `"debug"` may be tested
      // against `"debug" | "x"`, and a subset keeps its literal type (D2204).
      if !assignable(chkTy, objTy) { objTy = widenLitTy(objTy) }
    } else {
      objTy = widenLitTy(objTy)
    }
  }
  // Bank the resolved check type on the `is` node so the emitter's narrowing stack carries
  // it as an arena index, instead of re-classifying the spelling at every read of the binding.
  if chkTy >= 0 {
    if ix >= 0 {
      if ix < isVarTyIxCap {
        while isVarTyIx.length <= ix { isVarTyIxPush(-1) }
        isVarTyIxSetAt(ix, if meet >= 0 { meet } else { chkTy })
      }
    }
  }
  if chkTy < 0 {
    // A reason the resolver banked (a float literal, `u8`) is the whole diagnostic.
    if chkClash.length > 0 {
      tErr(chkClash, ix)
    } else {
      unknownTyErr(n.isVariant, " in 'is'", ix)
    }
    // `objTy < 0` is the operand's own "no answer", not a type — indexing `T.tys` with it
    // would trap the compiler (D1462); an unresolved operand is freely testable, same as `TyErr`.
  } else if n.isVariant != "null" && objTy >= 0 {
    // A record test over a hole is re-asked at each pin (D3109).
    if tyIsParamHole(objTy) { noteIsCstr(objTy, chkTy, n.isVariant, ix) }
    // Soundness: `x is T` is meaningful only when `T` is assignable to `x`'s type, since the
    // then branch narrows verbatim — an ungated test would launder invalid wasm through a newtype.
    const ot = T.tys[objTy]
    let baseTy = objTy
    let inUnion = false
    if ot is TyUnion {
      inUnion = true
    } else if ot is TyNullable {
      inUnion = true
      baseTy = ot.nInner
    }
    // A nullable whose inner is still open carries the in-band `-1` too (a bare `Map()`
    // read is `V | null` unpinned) — answered freely-testable, the same as an unresolved `TyErr`.
    if baseTy < 0 { return TY_BOOL }
    // The deep-`is` route, asked before the arm gate (D1035): `r is string[]` over a `Json`
    // passes assignability below (widens into `Json[]`) and would answer false for every value.
    const jwDeep = jsonDeepIsSite(ix, chkTy, n.isObj, objTy)
    if jwDeep == 1 { return TY_BOOL }
    if meet == LIT_MEET_NONE {
      tErr(litSetNeverMsg(n.isObj, objTy, chkTy), ix)
    } else if meet >= 0 {
      0
    } else if !assignable(chkTy, baseTy) || isWidenNotVariant(chkTy, baseTy) {
      if jwBadMsg != "" {
        tErr(
          "`is` check type '"
            + n.isVariant
            + "' is not a JSON shape — "
            + jwBadMsg,
          ix,
        )
      } else if inUnion {
        tErr(
          "`is` check type '"
            + n.isVariant
            + "' is not a variant of "
            + tyToStr(objTy),
          ix,
        )
      } else {
        tErr(
          "`is` check type '"
            + n.isVariant
            + "' can never match a value of type "
            + tyToStr(objTy),
          ix,
        )
      }
    } else {
      const twin = mapTwinTestMsg([objTy], chkTy, "`is`")
      if twin != "" { tErr(twin, ix) }
      recordCollapsedIsAt(n, ix, objTy, chkTy)
      recordContainedIsAt(n, ix, objTy, chkTy)
    }
  }
  return TY_BOOL
}

// Extracted from `checkNodeReal`'s `OptMember` arm (C3: thin the dispatcher).
function checkOptMemberNode(n: OptMember, ix: i32) {
  // `x?.y` keys the same narrowed place as `x.y` (host `placeKey`).
  const omKey = placeKeyOf(ix)
  if omKey != "" {
    const omOv = narrowedPathTy(omKey)
    if omOv >= 0 {
      identNotePlace(n.omObj)
      omGuardSet(ix, nonNullTy(omOv))
      crNoteLoopRead(omKey, ix)
      crNoteCaptureRead(omKey)
      return symMem(ix, omOv)
    }
    crNoteLostRead(omKey, ix)
    const omInv = narrowedPathInvBy(omKey)
    if omInv >= 0 && !pathReadsDeclared(omKey, omInv, ix) {
      omGuardSet(-1, -1)
      return pathInvalidatedErr(omKey, omInv, ix)
    }
  }
  omGuardSet(-1, -1)
  const recv = checkNode(n.omObj)
  // Guard the unpinned-hole receiver (`-1` — see the Member-arm note).
  if recv < 0 {
    omGuardSet(-1, -1)
    return TY_ERR
  }
  const eff = omRecvTy(n.omObj, recv)
  if eff < 0 {
    omGuardSet(-1, -1)
    return TY_ERR
  }
  // A `.` that inherited the chain's guard reads through it, so a field that is nullable in
  // its own right is a plain member access on a nullable value — the same refusal, and the
  // same fix (`o?.y?.z`), the direct spelling gives.
  if n.omDot {
    const de = T.tys[eff]
    if de is TyNullable {
      omGuardSet(-1, -1)
      memberFloorErr(eff, n.omProp, ix)
      return TY_ERR
    }
  }
  const rcv = T.tys[recv]
  let wasNullable = false
  let baseTy = eff
  if rcv is TyNullable { wasNullable = true }
  const et = T.tys[eff]
  if et is TyNullable {
    baseTy = et.nInner
    // Peels a second nullable layer too: the host's `flattenType` collapses `T??` to `T?`,
    // so a doubly-nullable receiver still reads its field with one `?.`.
    if baseTy >= 0 {
      const rcv2 = T.tys[baseTy]
      if rcv2 is TyNullable { baseTy = rcv2.nInner }
    }
  }
  if baseTy < 0 {
    omGuardSet(-1, -1)
    return TY_ERR
  }
  // `?.` reads a declared struct field, as it refuses a built-in `.length`, so a getter is
  // refused by name rather than as a missing field (property-access-design.md §D3a).
  const omGet = getterFnFor(baseTy, n.omProp)
  if omGet != "" {
    omGuardSet(-1, -1)
    tErr(
      "`?."
        + n.omProp
        + "` reads the "
        + getDeclLabel(omGet)
        + ", and `?.` reads only a declared struct field — narrow the receiver instead, e.g. `if v != null { v."
        + n.omProp
        + " }`",
      ix,
    )
    return TY_ERR
  }
  const bt = T.tys[baseTy]
  if bt is TyObj {
    const oft = objFieldType(bt, n.omProp)
    if oft < 0 {
      omGuardSet(-1, -1)
      tErr("no field '" + n.omProp + "' on " + tyToStr(baseTy), ix)
      return TY_ERR
    }
    omGuardSet(ix, oft)
    if wasNullable { return symMem(ix, mkNullableTy(oft)) }
    return symMem(ix, oft)
  }
  if bt is TyErr {
    omGuardSet(-1, -1)
    return TY_ERR
  }
  // Shared union field through `?.` — same rule as the plain member read.
  if bt is TyUnion {
    const osf = sharedUnionFieldTy(bt, n.omProp)
    if osf >= 0 {
      if sharedFieldJoinWidens(bt, n.omProp, osf, ix) {
        omGuardSet(-1, -1)
        return TY_ERR
      }
      omGuardSet(ix, osf)
      if wasNullable { return symMem(ix, mkNullableTy(osf)) }
      return symMem(ix, osf)
    }
  }
  omGuardSet(-1, -1)
  // A nullable receiver here is not "a non-object" — it is an object-less base behind a
  // `| null`. `?.` reaches declared struct fields only; builtins (`.length`) are unreachable through it.
  if wasNullable {
    tErr(
      "`"
        + omDotStr(n)
        + n.omProp
        + "` is not available on "
        + tyToStr(recv)
        + " — `?.` reads a declared struct field, and "
        + tyToStr(baseTy)
        + " has none; narrow the receiver instead, e.g. `if v != null { v."
        + n.omProp
        + " }`",
      ix,
    )
    return TY_ERR
  }
  tErr(
    "member access '"
      + omDotStr(n)
      + n.omProp
      + "' on non-object "
      + tyToStr(recv),
    ix,
  )
  return TY_ERR
}

// Extracted from `checkNodeReal`'s `WhileStmt` arm (C3: thin the dispatcher).
function checkWhileStmtNode(n: WhileStmt, ix: i32) {
  crLoopPreRetire(ix)
  // The barrier opens before the condition, which runs again after the body: its reads are
  // among the loop's re-run reads, and a write in it re-runs like one in the body.
  pushReBarrier(crLoopRdSlots.length)
  const wc = checkNode(n.whileCond)
  if !assignable(wc, TY_BOOL) {
    tErr("while-condition must be boolean, got " + tyToStr(wc), n.whileCond)
  }
  // Definite-assignment: a loop body may run zero times, so an in-body assignment is not
  // guaranteed to reach the fall-through — check the body live, then restore the pre-loop state.
  const daLoopMark = daMark()
  // The body is a narrowing scope like an `if` then-arm, re-tested every iteration — every fact
  // the condition proves, for a property path as much as a bare name and an `is T` pin as much
  // as a null strip. What could falsify a path fact mid-body retires it: a write through
  // `retireNarrowingsForWrite`, a call through `noteCallInvalidations` (D1736, D1845).
  const wnNames: string[] = []
  const wnTys: i32[] = []
  collectThenNarrows(n.whileCond, wnNames, wnTys)
  if wnNames.length > 0 {
    pushScope(-1)
    applyNarrows(wnNames, wnTys)
  }
  const blk = n.whileBlk == 1
  // A labelled block's tail is its value, so its body is discarded only when the block is.
  if !blk || valDiscarded(ix) { markValDiscard(n.whileBody) }
  lpPush(n.whileLabel)
  let neMark = neKeys.length
  if !blk { neMark = neEnter(n.whileCond, curFnDeclIx) }
  checkNode(n.whileBody)
  neLeave(neMark)
  let tailTy = -1
  let tailIx = -1
  let runsOut = lpOn && !condLitTrue(n.whileCond)
  if blk {
    runsOut = false
    if blockTailTy >= 0 && !isVoidTy(blockTailTy) && blockTailIx >= 0 {
      tailTy = blockTailTy
      tailIx = blockTailIx
    } else if !stmtAlwaysExits(n.whileBody) {
      runsOut = true
    }
  }
  const res = lpPopResult(ix, tailTy, tailIx, runsOut)
  if wnNames.length > 0 { popScope() }
  popReBarrier()
  daRollbackTo(daLoopMark)
  daRelease(daLoopMark)
  return res
}

// Extracted from `checkNodeReal`'s `ForRange` arm (C3: thin the dispatcher).
function checkForRangeNode(n: ForRange, ix: i32) {
  crLoopPreRetire(ix)
  // A range over `const` bounds keeps them as names: its constant-range refusals and the emitter's
  // step floor are about bounds the author wrote as literals.
  lbiKeepName = lbiKeepName + 1
  const frFrom = checkNode(n.frFrom)
  const frTo = checkNode(n.frTo)
  lbiKeepName = lbiKeepName - 1
  lbiNoteDelivery(n.frFrom, TY_I32, -1)
  lbiNoteDelivery(n.frTo, TY_I32, -1)
  if !assignable(frFrom, TY_I32) || !assignable(frTo, TY_I32) {
    if forRangeFloatish(frFrom) || forRangeFloatish(frTo) {
      tErr(
        "a `for` range counts in i32, so "
          + tyToStr(frFrom)
          + " and "
          + tyToStr(frTo)
          + " bounds have no step — count with an integer and scale: `for i in 0 to 10 { const x = i / 10.0 }`",
        ix,
      )
    } else {
      tErr(
        "for-range bounds must be i32, got "
          + tyToStr(frFrom)
          + " and "
          + tyToStr(frTo),
        ix,
      )
    }
  }
  if n.frStep >= 0 {
    lbiKeepName = lbiKeepName + 1
    const frStep = checkNode(n.frStep)
    lbiKeepName = lbiKeepName - 1
    lbiNoteDelivery(n.frStep, TY_I32, -1)
    if !assignable(frStep, TY_I32) {
      if forRangeFloatish(frStep) {
        tErr(
          "a `for` range counts in i32, so a "
            + tyToStr(frStep)
            + " step has no iteration count — count with an integer and scale: `for i in 0 to 10 { const x = i / 10.0 }`",
          ix,
        )
      } else {
        tErr("for-range step must be i32, got " + tyToStr(frStep), ix)
      }
    }
  }
  checkRangeNeverRuns(n.frFrom, n.frTo, n.frStep, n.frExcl)
  // A `for` body re-executes with no condition to re-establish anything, so every
  // narrowing live here predates it — see `pushReBarrier`.
  pushReBarrier(crLoopRdSlots.length)
  pushScope(ix)
  declare(n.frVar, TY_I32)
  symDecl(n.frVar, ix, TY_I32, 0)
  // Loop body may run zero times — see `WhileStmt` (A-definite-assign).
  const daFrMark = daMark()
  // The loop variable is always assigned in the body — clear it from the dead-zone so a body
  // read isn't flagged when it shadows a still-uninitialized module global of the same name.
  daMarkAssigned(n.frVar)
  markValDiscard(n.frBody)
  lpPush(n.frLabel)
  checkNode(n.frBody)
  const res = lpPopResult(ix, -1, -1, true)
  daRollbackTo(daFrMark)
  daRelease(daFrMark)
  popScope()
  popReBarrier()
  return res
}
// ── for v in iterable ───────────────────────────────────────────────────────
// A for-in loop over an array: the loop variable binds to the element type.

// Extracted from `checkNodeReal`'s `ForIn` arm (C3: thin the dispatcher).
function checkForInNode(n: ForIn, ix: i32) {
  crLoopPreRetire(ix)
  let iterTy = checkNode(n.fiIter)
  if iterTy >= 0 { iterTy = strLitRecvTy(iterTy) }
  let elemTy = forInBindTy(iterTy, false)
  let elem2Ty = forInBindTy(iterTy, true)
  const it = T.tys[iterTy]
  let luMs = luMembers(iterTy)
  if !luRecvLowers(n.fiIter, luMs) { luMs = [] }
  const luElem = if luMs.length > 0 { luElemTy(luMs) } else { -1 }
  if luElem >= 0 {
    if !inferQuiet {
      const luf = luForInAt(n, ix, iterTy, luMs, luElem)
      if luf >= 0 { return TY_VOID }
    }
    elemTy = luElem
    elem2Ty = TY_I32
  }
  if luElem >= 0 && inferQuiet {
    // Typed as the rewrite will type it; the real pass rewrites the loop.
  } else if it is TyArray || it is TyMap || isStringTy(iterTy) || it is TyErr {
    // Iterable (or already reported): `forInBindTy` has typed both bindings.
  } else if it is TyObj {
    // A struct is a NOMINAL record whose fields have different types, so a loop variable over
    // one has no type to bind, and the field read the author wants needs a key no operation
    // accepts. The map is the collection with keyed iteration (`open-rulings.md` §B8-for-struct).
    tErr(
      "a struct's fields are not a sequence, so `for … in "
        + tyToStr(iterTy)
        + "` has nothing to iterate — use a map (`{[string]: i32}`) for keyed iteration, or read the fields by name",
      n.fiIter,
    )
  } else {
    tErr(
      "for-in expects an array, a map or a string, got " + tyToStr(iterTy),
      n.fiIter,
    )
  }
  // See ForRange: a `for` body re-executes with nothing to re-establish a narrowing.
  pushReBarrier(crLoopRdSlots.length)
  pushScope(ix)
  declare(n.fiVar, elemTy)
  symDecl(n.fiVar, ix, elemTy, 0)
  // Every element read under an element-only narrowing fits its leaf: a write in the loop that
  // may leave it ended it before the loop (`crLoopPreRetire`).
  efLeaf[ix] = -1
  if it is TyArray {
    const fk = elemOnlyKeyOf(n.fiIter)
    if fk != "" { elemFactFor(ix, elemRecvPrefix(n.fiIter), fk) }
    narrowFreshBinding(n.fiVar, ix)
  }
  if n.fiVar2 != "" {
    declare(n.fiVar2, elem2Ty)
    symDecl(n.fiVar2, ix, elem2Ty, 0)
  }
  // Loop body may run zero times — see `WhileStmt` (A-definite-assign).
  const daFiMark = daMark()
  // See ForRange: clear the loop var from the dead-zone for the body so it can't
  // collide with a shadowed, still-uninitialized module global of the same name.
  daMarkAssigned(n.fiVar)
  if n.fiVar2 != "" { daMarkAssigned(n.fiVar2) }
  markValDiscard(n.fiBody)
  lpPush(n.fiLabel)
  checkNode(n.fiBody)
  const res = lpPopResult(ix, -1, -1, true)
  daRollbackTo(daFiMark)
  daRelease(daFiMark)
  popScope()
  popReBarrier()
  return res
}
// ── return ─────────────────────────────────────────────────────────────────

// Extracted from `checkNodeReal`'s `RetStmt` arm (C3: thin the dispatcher).
function checkRetStmtNode(n: RetStmt, ix: i32) {
  const want = T.curRet
  if tpEnvNames.length > 0 { tpIfMarkOk(n.retArg) }
  // `T.curRet` is only ever `-1` at its `initChecker` reset, never written by a
  // function-body check (`checkFuncDeclNode` always saves/restores a real return type or
  // the `-2` inferring sentinel) — so `-1` here means this `return` is not inside any
  // function, lambda, method or getter body (PL-028, D2262).
  if want == -1 {
    tErr(
      "`return` is only valid inside a function; to end the program early use `exit(code)` from `std:process`, or restructure with `else`",
      ix,
    )
    return TY_VOID
  }
  // Only a call that itself never returns may stand in a `never` function's `return` (D1972).
  if want == TY_NEVER && want >= 0 {
    if n.retArg < 0 || checkNode(n.retArg) != TY_NEVER {
      tErr(
        "a function declared `never` cannot return — end the path in a call that never returns, such as `__trap__()`",
        ix,
      )
    }
    return TY_VOID
  }
  if n.retArg < 0 {
    // `tyIsHole` because `assignable` waves a `TyVar` past any destination, so a declared
    // `: T` accepted the bare return here and the emitter refused the instance (D1600).
    if want >= 0 && (tyIsHole(want) || !assignable(TY_VOID, want)) {
      // Both route-arounds, because either can be intended: the annotation is what makes this
      // return illegal, so dropping it is as valid a fix as supplying a value.
      tErr(
        "return needs a value of type "
          + tyToStr(want)
          + " — return a value, or annotate this function `: void`",
        ix,
      )
    }
    return TY_VOID
  }
  // Under a pending return type (-2: this function's return is being inferred),
  // record the returned type as a witness instead of checking a mismatch.
  if want == -2 {
    // A returned call whose deferred join this site could not decide contributes the
    // whole join, not the lossy collapse the emitter gets (`inferRetTyOf`).
    const savedInRetArg = inRetArg
    inRetArgSet(true)
    const cbArg = cycleBreakCount
    const rArgTy = checkNode(n.retArg)
    inRetArgSet(savedInRetArg)
    // `return <void expr>` evaluates the expression and returns nothing, so it is a void
    // return; the function's finish refuses it if the function returns a value. A void that is
    // only a recursive cycle's provisional answer is still a value return position (D2635).
    if (
      isVoidTy(rArgTy)
      && cycleBreakCount == cbArg
      && !voidSlotExemptExpr(n.retArg)
    ) {
      inferVoidRetSites.push(ix)
      inferVoidRetBlks.push(chkStmtBlk)
      return TY_VOID
    }
    fnSawValueRetSet(true)
    // `return <void call>` names a value to return and has none — reported here rather than
    // left to the mismatch check below, which never sees this path (the return type is still inferred).
    if voidValueSlotErr(rArgTy, n.retArg, "return", ix) { return TY_VOID }
    // D1045 — a body-scoped nominal type may not escape through an inferred return.
    refuseLocalNomEscape(rArgTy, ix)
    // An empty-collection hole returned here has a destination not final until the body ends
    // — the pin is deferred to `flushInferRetHoles` rather than skipped (D1591).
    noteInferRetWitness(n.retArg, rArgTy)
    inferRetNextLitSet(armLit(rArgTy, n.retArg))
    noteInferredRet(inferRetTyOf(n.retArg, rArgTy))
    return TY_VOID
  }
  // Bidirectional: `function mk(): (i32) => i32 { return (x) => … }` infers the returned
  // lambda's param from the declared return type (also through a composite return shape).
  if want >= 0 { seedExpected(n.retArg, want) }
  const cbGot = cycleBreakCount
  const got = checkNode(n.retArg)
  // Under a void return `assignable` passes anything void-bearing, so this gate refuses a union
  // that mentions void. A wholly void value is a void return: `return g()` calls, then returns (D2635).
  if isVoidTy(want) {
    if isVoidTy(got) && cycleBreakCount == cbGot {
      voidRetRwRet.push(ix)
      voidRetRwBlk.push(chkStmtBlk)
      return TY_VOID
    }
    if voidValueSlotErr(got, n.retArg, "return", ix) { return TY_VOID }
  }
  // Redundant-return rule: witness the explicit return's natural type (before
  // constrainEmpty); an annotation-influenced return disqualifies the function.
  if retInfluencedByAnnot(n.retArg) || retSiteTypedByAnnot(n.retArg, got) {
    retNaturalErrSet(true)
  }
  noteNaturalRet(got)
  // An explicit `return inner` of an empty collection pins its element from the
  // declared return type — usage-driven inference clearing the floor.
  constrainEmptyExpr(n.retArg, got, want)
  if want >= 0 && !assignableExpr(n.retArg, got, want) {
    tErrWant(
      "return type mismatch: expected "
        + tyToStr(want)
        + ", got "
        + tyToStr(got)
        + bareRetVoidNote(want)
        + charLitForStringNote(n.retArg, want)
        + boolForNumberNote(got, want)
        + storageListNote(n.retArg, got, want)
        + litMemberNote(n.retArg, want, 8),
      n.retArg,
      want,
    )
  } else if want >= 0 {
    // The check above is vacuous whenever a side is a hole — record the pair for the pin to
    // re-ask under substitution, only on the passing side (D551 body / D561 declared side).
    noteRetCstr(coalPinTy(n.retArg, got), want, n.retArg)
  }
  return TY_VOID
}
// ── block ─────────────────────────────────────────────────────────────────

// Extracted from `checkNodeReal`'s `Block` arm (C3: thin the dispatcher).
function checkBlockNode(n: Block, ix: i32) {
  const blkOnSpine = spineAt == ix
  const savedStmtBlk = chkStmtBlk
  chkStmtBlkSet(ix)
  pushScope(ix)
  const stmts = n.blkStmts
  const blkDiscard = valDiscarded(ix)
  const savedRTP = retTailPos
  let tailTy = TY_VOID
  let tailIx = -1
  let i = 0
  while i < stmts.length {
    // Only the last statement is the block's value (and inherits tail position); the
    // rest are not the block's value, so they never carry the return tail.
    if i == stmts.length - 1 {
      retTailPosSet(savedRTP)
    } else {
      retTailPosSet(false)
    }
    if (
      (blkDiscard || i < stmts.length - 1)
      && !(lpOn && breakValueAt(stmts, i))
    ) {
      markValDiscard(stmts[i])
    }
    crStmtEnter(stmts[i])
    let sty = TY_VOID
    if blkOnSpine && i == stmts.length - 1 {
      spineAtSet(stmts[i])
      sty = checkNode(stmts[i])
      spineAtSet(ix)
    } else {
      sty = checkNode(stmts[i])
    }
    crStmtLeave()
    if lpOn { brkPrevTySet(sty) }
    if i == stmts.length - 1 {
      // A value-producing trailing expression is the block's value; a trailing
      // statement (return / let / assignment / loop) leaves the block valueless.
      if !isStmtNode(stmts[i]) {
        tailTy = sty
        tailIx = stmts[i]
      } else {
        // An if-expression tail IS the block's value even though `IfStmt` is otherwise a
        // statement node — non-void only for a genuine value-`if` with an else.
        const lastN2 = P.nodes[stmts[i]]
        if lastN2 is IfStmt {
          // A discarded tail keeps its value here, typed on no node, for an enclosing arm's join.
          const ity = discardedValTyOf(stmts[i], sty)
          if lastN2.ifElse >= 0 {
            if ity != TY_VOID && ity != TY_ERR {
              tailTy = ity
              tailIx = stmts[i]
            }
          } else {
            // An else-less `if` ending a block is its `T | null` value, as a tail one is, when
            // its then-arm completes with a value (D1995's ruling); a then-arm that always
            // exits yields nothing here, and its fall-through meets the function's own `null`.
            if (
              ity != TY_VOID
              && ity != TY_ERR
              && !stmtAlwaysExits(lastN2.ifThen)
            ) {
              tailTy = ity
              tailIx = stmts[i]
            }
          }
        }
      }
    }
    i = i + 1
  }
  retTailPosSet(savedRTP)
  popScope()
  chkStmtBlkSet(savedStmtBlk)
  blockTailTySet(tailTy)
  blockTailIxSet(tailIx)
  return TY_VOID
}
