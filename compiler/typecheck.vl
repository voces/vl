// ── type-arena variants ──────────────────────────────────────────────────────
// One struct per type kind, prefixed field names so `is` discriminates the union (the
// AST's convention). A nested type is always an `i32` index into `T.tys`.

// The `initChecker` then `checkProgram` protocol, enforced rather than stated: every table
// `checkProgram` fills is emptied in `initChecker`, so a second walk on an unarmed instance
// reads the previous program's rows. `initChecker` arms this, `checkProgram` consumes it,
// and consuming it when it is already clear is an `internal:` diagnostic, never a trap.
let checkerArmed = false

// ── arena-mutation generations (the emit-side `repOf` memo invalidation) ─────

// D-GAPARAM — the declared type-parameter names, as a flat column plus a (start, count)
// slice per alias, the shape the spelling arena uses for its kids. `parseTypeDecl` folds
// the parameter tokens into the declared name, so the `<` scan and slice happen once here
// at registration and the binding loop reads `gaParamNames[start + k]` directly.
let gaParamNames: string[] = []
let gaParamStart: i32[] = []
let gaParamCount: i32[] = []

// ── constraints phase 1: the bound environment and the coherence ledger ──────

// One row per (generic function, instantiation type, bound member) some site resolved; a
// second site resolving the same key to a different witness is the refusal, and it names
// both sites. The key is `tyToStr` — `tyEq`'s exact string equivalent, nominality folded
// in — never an arena index, which is append-only, nor the emit-side `canon`/`tyToEmitName`.
let cohKeys: string[] = []
let cohWitness: string[] = []
let cohSiteLine: i32[] = []
let cohSiteCol: i32[] = []

// Unions minted by `joinTys` that carry at least one hole member. `substTyDeep` re-folds
// such a union under a call's bindings (`refoldJoinUnion`): members that resolve are
// re-joined, and one still unresolved is dropped once some member did, naming a branch the
// pinned argument can never reach. Without the re-fold `A | B` surfaces where one arm is live.
let joinHoleUnions: i32[] = []
// The generic whose instance the emitter is building, -1 outside one (`joinPinnedArmLit`).
let njPinFn = -1
export function njSetPinFn(fx: i32): i32 {
  const was = njPinFn
  njPinFn = fx
  was
}
// The deferred return joins of runtime witnesses, which re-join apart wherever they collapse.
let apartHoleJoins: {[i32]: boolean} = Map()

// The operator a deferred unary negation is recorded under, both operands its argument.
const OP_NEG = "unary -"
// The same for a deferred bitwise not `~`, which also refuses a float.
const OP_BNOT = "unary ~"
// The operator a deferred `as` over a gradual union is recorded under, the target on the right.
const OP_AS = "as"
// The constraint an operator records when a 64-bit integer constant meets a type-parameter
// operand: the pin refuses a type narrower than the constant (D2712).
const OP_LITFIT = "constant width"

const ACF_PLAIN = 0
const ACF_TPL = -1
// A composite argument carrying a hole (`xs: T[]`, `[x]`, `[...xs]`), re-asked at the pin by
// its own node, as a binding's is, so a literal still adapts element-wise (D3253).
const ACF_COMP = -2
// A list index carrying a hole, held at the pin to the direct spelling's `i32` rule (D3584).
const ACF_INDEX = -3

// D1470 — every `__array_new_default__(n)` call, its node and the array-hole row it returned.
// `array.new_default` writes each slot's zero, so the element type is decided by what pins the
// hole and neither answer exists where the call is checked. `flushUninferred` defaults an
// unpinned hole to `i32`; `checkArrayNewDefaultElems` refuses a pinned element with no zero.
let arrDefCallIx: i32[] = []

// The `memCstr.prop` a call through a hole records: not a field name, so no member row shares it.
const OP_CALL_PIN = "()"
// A call under a null test of its callee: a pin of the `null` type leaves the branch dead, so
// the call is not refused there, though the direct spelling refuses it (D3197).
const OP_CALL_GUARDED_PIN = "?()"

// The element narrowing a `map`/`filter` callback's parameter or a `for` variable starts with,
// keyed on the callback or the loop (`elemFactFor`); a leaf of -1 is none.
let efLeaf: {[i32]: i32} = Map()
let efSteps: {[i32]: i32} = Map()

const SUBST_DECLARED = 1
let argPinChecking = false
// Per hole-carrying function type: the same signature with each hole at its banked pin,
// minted once however many classifiers ask for it (D1794).
let pinFnTy: {[i32]: i32} = Map()
// Declarations whose solve has been attempted, keyed by decl node index — a body is probed at
// most once, whether or not the probe found anything to solve.
let paramSolveTried: {[string]: boolean} = Map()
// Set while pass 1.9 walks a generic body only to record its deferred constraints, so the
// walk takes no memo and patches no return (`cstrPrePass`).
let cstrProbe = false

// D1591 — empty-collection holes delivered to an inferred return. At a declared return
// `constrainEmptyExpr` pins on the spot; under inference the destination is the join of every
// return and is not final until the body ends. `irhMarks` scopes the recorded rows to one body,
// and `irhConcrete` banks the first concrete witness, since the join can keep the open side.
const irhExprs: i32[] = []
const irhTys: i32[] = []
const irhMarks: i32[] = []
const irhConcrete: i32[] = []

// Every value delivered to the inferred return of the bodies being checked, with its type, one
// frame per body: `inferRetF32Join` reads them to type an f32 value beside literals f32.
const irwExprs: i32[] = []
const irwTys: i32[] = []
const irwMarks: i32[] = []

// The container null holes (D2506): an un-annotated list element or map value pinned by a bare
// `null` write holds an open `_ | null` a later write or a destination fills. One row
// per hole: its arena index, the write that minted it, the container's spelling, whether it is a
// map value, and whether it is a param-hole map demand's, whose value each call site fills.
let cnhTys: i32[] = []
let cnhAts: i32[] = []
let cnhNames: string[] = []
let cnhIsVal: boolean[] = []
let cnhDemand: boolean[] = []
// Post-guard narrowings handed up by an `if` that is itself the else arm of another `if`. Such
// an `if` has no enclosing block of its own — the rest of its block is the rest of the parent's
// — so it cannot `declare` its own fall-through narrowing. The parent consumes these only when
// its own then diverges. Bare names only; pushed in post-order and applied in reverse.
let pgUpKeys: string[] = []
let pgUpTys: i32[] = []

// The node index of the `if` currently being checked as the else arm of a chain, or `-1`. Set
// by a link's head immediately before the next link's head runs, and read-and-cleared at the
// very top of `checkIfHead`, so only that link sees it: an `if` nested inside an arm's body
// has a block of its own and declares normally.
let pgUpArmIx = -1

// The place type a trailing chain saw, banked at the instant the post-guard subtraction replaced
// it. `ifChainExhausts` asks whether a chain's arms cover its place's union, and by then the
// chain has already subtracted them, so asking `lookup` is circular. Keyed by the chain head's
// node index — a head that does not post-narrow writes nothing, and a miss falls back to `lookup`.
let pgPreIx = -1
let pgPreKeys: string[] = []
let pgPreTys: i32[] = []

// The join of two types a place may hold after an `if`. A place holds a member of its declared
// type, so a numeric member is never absorbed by one it widens to: `i32` and `f64` join to
// `i32 | f64`, not `f64`, which is how the value is stored (D2627). Otherwise `joinTys`.
function narJoinTys(a: i32, b: i32): i32 {
  if a < 0 || b < 0 { return joinTys(a, b) }
  if numericVariantUncovered(a, b) || numericVariantUncovered(b, a) {
    return joinVariantTys(a, b)
  }
  joinTys(a, b)
}

// Per `if` node and written key, the type the key holds after that `if`, as its arm join found
// it: what an enclosing `if` whose `else` is this one reads as that arm's end.
let narIfEnds: {[string]: i32} = Map()

function narNoteChainEnd(ifIx: i32, key: string, ty: i32) {
  if ty < 0 { return 0 }
  narIfEnds[i32ToStr(ifIx) + "#" + key] = ty
  0
}

// The end type of the `else if` link of the `if` at `ifIx` for `key`, or -1 when its `else` is
// no `if`, or the link's own join recorded nothing for `key`.
function narChainEndTy(ifIx: i32, key: string): i32 {
  const n = P.nodes[ifIx]
  if n is IfStmt {
    if n.ifElse >= 0 && P.nodes[n.ifElse] is IfStmt {
      return narIfEnds[i32ToStr(n.ifElse) + "#" + key] ?? -1
    }
  }
  -1
}

// The type a place holds after ledger row `i` on the arm whose own statement depth is `ownDepth`:
// a row at that depth runs whenever the arm does and replaces `cur`; a deeper one is conditional,
// so the two join (D1846).
function narFoldRow(cur: i32, i: i32, ownDepth: i32): i32 {
  // A kill (a call or alias that may write, an unkeyable write) leaves the place unknown, which
  // only a later write at the arm's own depth replaces.
  if narClobRetired[i] == 2 { return NAR_UNKNOWN }
  if narClobDepths[i] == ownDepth { return narClobTys[i] }
  if cur == NAR_UNKNOWN { return NAR_UNKNOWN }
  narJoinTys(cur, narClobTys[i])
}

// A path's state after a kill no later write replaced: the join cannot narrow over it (D3285).
const NAR_UNKNOWN = -3

// The last index of `name` in `names`, or -1.
function strListLastIx(names: string[], name: string): i32 {
  let i = names.length - 1
  while i >= 0 {
    if names[i] == name { return i }
    i = i - 1
  }
  -1
}

// What each place key holds here, parallel to `keys`: the arm join's start for a path through an
// `if` that carries no condition fact about it. -1 where the key does not resolve.
function narKeysNowTys(keys: string[]): i32[] {
  const out: i32[] = []
  let i = 0
  while i < keys.length {
    out.push(narKeyNowTy(keys[i]))
    i = i + 1
  }
  out
}

// What the place `key` reads at here: a bare name's binding, a path's live overlay, else its
// field or cell type off the prefix it hangs from.
function narKeyNowTy(key: string): i32 {
  if !isPathKey(key) { return lookup(key) }
  const ov = narrowedPathTy(key)
  if ov >= 0 { return ov }
  const steps = keySteps(key)
  if steps.length == 0 { return -1 }
  const pres = keyStepPrefixTys(key, steps)
  const last = steps.length - 1
  const pt = pres[last]
  if pt < 0 { return -1 }
  if steps[last][0] == '.' {
    return placeFieldTy(pt, steps[last].slice(1, steps[last].length), false)
  }
  placeElemTy(pt)
}

// What `key` read at the head of the `if` behind `f`: its type now with every in-place write
// since then undone, then redone. -1 where the key does not resolve.
function narHeadTy(f: IfChk, key: string): i32 {
  let j = narIpAt.length - 1
  while j >= f.ipMark {
    narIpApply(f, j, true)
    j = j - 1
  }
  const t = narKeyNowTy(key)
  j = f.ipMark
  while j < narIpAt.length {
    narIpApply(f, j, false)
    j = j + 1
  }
  t
}

// The flow-narrowing join at the end of an `if` (DECISIONS.md, "Flow narrowing: per-path facts
// meet at joins"). Each path through the `if` starts at the condition's fact for a key, or at its
// entry type, and folds its arm's ledger rows; the key reads at the meet of the surviving paths
// below the `if`. `sum*` receives one summary row per key joined, for `narCompactIf`.
function applyArmJoins(
  f: IfChk,
  elseHi: i32,
  thenDiverges: boolean,
  elseDiverges: boolean,
  condIx: i32,
  sumKeys: string[],
  sumTys: i32[],
  sumPrev: i32[],
  sumRet: i32[],
) {
  // Both arms diverging leaves no code below to describe.
  if thenDiverges && elseDiverges { return 0 }
  const ix = f.ifIx
  const keys: string[] = []
  const slot: {[string]: i32} = Map()
  const kEnt: i32[] = []
  const kThen: i32[] = []
  const kElse: i32[] = []
  const kCond: boolean[] = []
  const kOk: boolean[] = []
  const kRet: i32[] = []
  const kElseSeen: boolean[] = []
  // One pass over the subtree's rows, in order, folding each into its key's two paths.
  let i = f.clobMark
  const end = narClobKeys.length
  while i < end {
    const nm = narClobKeys[i]
    if narClobHits(i, nm) {
      let k = slot[nm] ?? -1
      if k < 0 {
        k = keys.length
        slot[nm] = k
        keys.push(nm)
        // A key the condition tests starts each arm at that arm's fact, from the entry the head
        // saw. Any other key enters both arms at what it held on entry, which a row inside an
        // arm's own narrowing cannot tell (D4198).
        const ti = strListLastIx(f.tnNames, nm)
        const ei = strListLastIx(f.enNames, nm)
        let ent = narHeadTy(f, nm)
        if ent < 0 { ent = narClobPrev[i] }
        let ts = ent
        let es = ent
        const cond = ti >= 0 || ei >= 0
        if cond {
          if ti >= 0 { ent = f.tnEnt[ti] } else { ent = f.enEnt[ei] }
          ts = ent
          es = ent
          if ti >= 0 { ts = f.tnTys[ti] }
          if ei >= 0 { es = f.enTys[ei] }
        }
        kEnt.push(ent)
        kThen.push(ts)
        kElse.push(es)
        kCond.push(cond)
        // A condition fact over a path one arm leaves is the post-guard rule's, not this join's.
        kOk.push(
          ent >= 0
            && !crCondRetired(condIx, nm)
            && !(cond && (thenDiverges || elseDiverges)),
        )
        kRet.push(0)
        kElseSeen.push(false)
      }
      // A call that can write the place leaves it unknown, and a merged entry would hand the
      // fact back (D1849).
      const r = narClobRetired[i]
      if r == 1 { kRet[k] = 1 }
      if i < f.thenLo {
        // A write in the condition may or may not have run on either path.
        if kCond[k] || r == 2 {
          kOk[k] = false
        } else {
          kThen[k] = narJoinTys(kThen[k], narClobTys[i])
          kElse[k] = narJoinTys(kElse[k], narClobTys[i])
        }
      } else if i < f.thenHi {
        kThen[k] = narFoldRow(kThen[k], i, f.thenOwnDepth)
      } else if i >= f.elseLo && i < elseHi {
        kElse[k] = narFoldRow(kElse[k], i, f.elseOwnDepth)
        kElseSeen[k] = true
      }
    }
    i = i + 1
  }
  let k = 0
  while k < keys.length {
    const nm = keys[k]
    // This pass's answer replaces an earlier check's, which may have been at other types.
    narIfEnds[i32ToStr(ix) + "#" + nm] = -1
    // A path fact over a type variable or a hole meets per instance, and the join is banked
    // once per node, so such a key keeps the type the arms left it at (D3286).
    if tyHasHole(kEnt[k]) || tyHasHole(kThen[k]) || tyHasHole(kElse[k]) {
      kOk[k] = false
    }
    if kOk[k] {
      // An `else if` link has no block of its own: its end type is its own chain's join,
      // which counts the path where none of its arms ran (D2627).
      let chainEnd = -1
      if kElseSeen[k] { chainEnd = narChainEndTy(ix, nm) }
      let jt = -1
      // No else arm is still a path through the `if`: the fall-through, at the else fact.
      let ee = kElse[k]
      if chainEnd >= 0 { ee = chainEnd }
      const te = kThen[k]
      // A kill on any surviving path survives the meet.
      if thenDiverges {
        if ee != NAR_UNKNOWN { jt = ee }
      } else if elseDiverges {
        if te != NAR_UNKNOWN { jt = te }
      } else if ee != NAR_UNKNOWN && te != NAR_UNKNOWN {
        // The ELSE side first, so a one-armed join renders in the declaration's own order
        // (`i64 | boolean`, not `boolean | i64`) — the diagnostic below reads it.
        jt = narJoinTys(ee, te)
      }
      narNoteChainEnd(ix, nm, jt)
      if jt >= 0 {
        sumKeys.push(nm)
        sumTys.push(jt)
        sumPrev.push(kEnt[k])
        sumRet.push(kRet[k])
        // A chain link's code below is its parent's, which joins it through `chainEnd`. An
        // `if` in value position installs when its statement ends, the boundary the
        // emitter's push follows, and only as that statement's whole value.
        if !f.isElseArm {
          if narIfIsStmt(ix) {
            narInstallJoin(ix, nm, jt, chainEnd >= 0)
          } else {
            narDeferJoin(ix, nm, jt, chainEnd >= 0)
          }
        }
      }
    }
    k = k + 1
  }
  0
}

// Whether the `if` at `ix` is itself the statement being checked, the unit the emitter pushes a
// join after (`pushPostGuardNarrow`).
function narIfIsStmt(ix: i32): boolean {
  const top = crStmtIxs.length - 1
  top >= 0 && crStmtIxs[top] == ix
}

// Install the joins held for statement `st`, which has just been checked.
function narApplyDeferred(st: i32) {
  while narDefStmt.length > 0 && narDefStmt[narDefStmt.length - 1] == st {
    const k = narDefStmt.length - 1
    narInstallJoin(st, narDefKey[k], narDefTy[k], narDefChain[k])
    narDefStmtPop()
    narDefKeyPop()
    narDefTyPop()
    narDefChainPop()
  }
  0
}

// Install the join `jt` of `key` for the code below the `if` at `ix`, in the block holding the
// `if` — the lifetime the emitter's push after the statement has — and bank it for that push.
function narInstallJoin(ix: i32, key: string, jt: i32, viaChain: boolean) {
  if isPathKey(key) {
    // Against what the path reads at now, not at entry: an arm's write may have retired the
    // entry narrowing in place. A retired innermost entry is replaced even by an equal join, so
    // the reads and writes below resolve through a live one (D3316).
    const inner = narrowedPathIx(key)
    const retired = inner >= 0 && narrowedPathTyRaw(key) < 0
    if jt != narKeyNowTy(key) || retired {
      npKeysPush(key)
      npTysPush(jt)
      npInvByPush(-1)
      npEpochsPush(narFnEpoch)
      npSettlePush(-2)
      npCapByPush(-1)
      npAsgPush(0)
      recordArmJoin(ix, key, jt)
    }
    return 0
  }
  const cur = lookup(key)
  if cur >= 0 && jt != cur {
    // Banked like the post-guard fall-through, so a write below is checked against storage
    // and a call that may write the name ends it (D2390).
    noteNarShadow(key, cur, NAR_KIND_POSTGUARD)
    declare(key, jt)
    narFitCompanions(key, cur, jt)
    recordArmJoin(ix, key, jt)
  } else if viaChain {
    // The `else if` chain's join reaches the emitter only at this statement (D2627).
    recordArmJoin(ix, key, jt)
  }
  0
}

// Retire in place every narrowing layer of `name` in the current function, inside the loop
// barrier, that does not admit `now`, the type the write left it at: each reads `store` after.
function narRetireLayers(name: string, now: i32, store: i32) {
  const ds = scopeDepthsOf[name]
  if ds == null { return 0 }
  const base = crFnBase()
  let bar = 0
  if reScopeBases.length > 0 { bar = reScopeBases[reScopeBases.length - 1] }
  let j = ds.length - 1
  while j >= 0 {
    const d = ds[j]
    if d < base || d < bar || crFirstBank(name, d) < 0 { return 0 }
    const t = T.scopes[d][name] ?? -1
    if t >= 0 && !assignable(now, t) { narSetScope(d, name, store) }
    j = j - 1
  }
  0
}

// The type a write of a value typed `rt` leaves a narrowed name at: the member of `store` it
// re-narrows to, or `pre`, what the name held, when the write names no single member and `pre`
// admits it. `store` when neither holds.
function writeNarrowAfter(store: i32, pre: i32, rt: i32): i32 {
  const rn = writeMemberTy(store, rt)
  if rn == store && rt >= 0 && pre >= 0 && writeLandsWithin(store, rt, pre) {
    return pre
  }
  rn
}

// Re-derive every pending `??` over the hole `ty`, now that its inner is known. Runs at the fill,
// the first moment the answer exists, and validates as much as it re-banks: the read is already
// checked against `given`, so a fill whose inner does not fit is a disagreement to name, not to
// bank over. The derivation is the `??` arm's own tail, re-asked through `assignableExpr`.
function fillCoalHoleNodes(ty: i32) {
  let i = 0
  while i < chPendNodes.length {
    if chPendTys[i] == ty {
      const cn = chPendNodes[i]
      const nd = P.nodes[cn]
      if nd is BinExpr {
        const inner = nonNullTy(ty)
        const dft = nodeTyIxOf(nd.binRight)
        let res = inner
        if dft >= 0 {
          if !assignableExpr(nd.binRight, dft, inner) {
            res = joinTys(inner, dft)
          }
        }
        const given = chPendGiven[i]
        if assignable(res, given) {
          if cn < nodeTyIx.length { nodeTySet(cn, res) }
        } else {
          tErr(
            "`??` here was typed "
              + tyToStr(given)
              + " — the assignment below makes the binding "
              + tyToStr(ty)
              + ", so the read is "
              + tyToStr(res)
              + "; annotate the binding",
            cn,
          )
        }
      }
    }
    i = i + 1
  }
  0
}

// The type an open container slot takes from its first write `vt`: the literal-widened value,
// or for a bare `null` a fresh open `_ | null` recorded against the write `at` (D2506).
function cnhPinTy(
  vt: i32,
  at: i32,
  recv: i32,
  isVal: boolean,
  demand: boolean,
): i32 {
  if !isNullTy(vt) { return widenLitTy(vt) }
  const h = mkNullableTy(-1)
  cnhTys.push(h)
  cnhAts.push(at)
  let nm = ""
  if recv >= 0 { nm = placeKeyOf(recv) }
  cnhNames.push(nm)
  cnhIsVal.push(isVal)
  cnhDemand.push(demand)
  h
}

// Whether `ty` is a still-open container null hole.
function cnhIsOpen(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    if t.nInner >= 0 { return false }
  } else {
    return false
  }
  let i = 0
  while i < cnhTys.length {
    if cnhTys[i] == ty { return true }
    i = i + 1
  }
  false
}

// Fill the open container null hole `slot` from a write or destination of type `vt`: its
// non-null part becomes `T`, as the `=` arm fills a `let x = null`. A no-op on any other slot.
function cnhFill(slot: i32, vt: i32) {
  if vt < 0 || vt == TY_ERR || vt == TY_VOID { return 0 }
  if !cnhIsOpen(slot) { return 0 }
  if nhOpen(vt) { return nhLink(slot, vt) }
  let inner = vt
  const v = T.tys[vt]
  if v is TyNullable { inner = v.nInner }
  if inner < 0 || isNullTy(inner) { return 0 }
  nhFillLinked(slot, widenLitTy(inner))
}

// Fill the open null hole `h` with `inner` in place, and every hole linked to it. A hole already
// filled stops the walk, which is what bounds it.
function nhFillLinked(h: i32, inner: i32) {
  const t = T.tys[h]
  if t is TyNullable {
    if t.nInner >= 0 { return 0 }
    t.nInner = inner
    tyMutEpoch = tyMutEpoch + 1 // a null hole filled in place
    fillCoalHoleNodes(h)
  } else {
    return 0
  }
  let i = 0
  while i < nhLinkA.length {
    if nhLinkA[i] == h { nhFillLinked(nhLinkB[i], inner) }
    if nhLinkB[i] == h { nhFillLinked(nhLinkA[i], inner) }
    i = i + 1
  }
  0
}

// Refuse every container null hole nothing filled: the program never said what else it holds.
function flushContainerNullHoles() {
  let i = 0
  while i < cnhTys.length {
    if !cnhDemand[i] && cnhIsOpen(cnhTys[i]) {
      let what = "the element type of "
      if cnhIsVal[i] { what = "the value type of " }
      let nm = "this container"
      if cnhNames[i] != "" { nm = "`" + cnhNames[i] + "`" }
      tErr(what + nm + " is only ever null — annotate it", cnhAts[i])
    }
    i = i + 1
  }
  0
}

// Refuse a call to a generic or hole-parameter function that passes a container whose element
// or value is still an open `_ | null`: the instance is chosen here, before `T` exists, and a
// later fill cannot reach it (D2506).
function refuseOpenNullHoleArg(argIx: i32, who: string) {
  if argIx < 0 { return 0 }
  const seen: i32[] = []
  if !tyHoldsOpenNullHole(nodeTyIxOf(argIx), seen) { return 0 }
  let nm = placeKeyOf(argIx)
  if nm == "" { nm = "this argument" } else { nm = "`" + nm + "`" }
  let what = "the element type of "
  const at = T.tys[nodeTyIxOf(argIx)]
  if at is TyMap { what = "the value type of " }
  let callee = "this call"
  if who != "" { callee = "`" + who + "`" }
  tErr(
    what
      + nm
      + " is still open here — fill or annotate it before passing it to "
      + callee,
    argIx,
  )
  0
}

// Does type-arena index `ty` still reach an unresolved collection hole — an empty `[]` element
// (`aElem < 0`) or a bare `Map()`/`Set()` key/value (`mKey`/`mVal < 0`) that no annotation and
// no downstream use ever pinned?
function unresolvedHole(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyArray { return t.aElem < 0 }
  if t is TyMap { return t.mKey < 0 || t.mVal < 0 }
  false
}

// Usage-driven inference through a typed context: an empty `[]` / bare `Map()`/`Set()` flowing
// into a slot with a concrete shape (a `T[]` param at a call site, an annotated assignment, a
// `T[]`-returning tail) has its open holes pinned to the destination's, in place. A no-op
// unless the shapes match. Depth-bounded: a recursive struct would otherwise recur forever.
function constrainEmpty(srcTy: i32, dstTy: i32) {
  constrainEmptyD(srcTy, dstTy, 12)
}

// `constrainEmpty` at a position that holds the source expression — the form every site that
// pins and then asks `assignableExpr` must use. The pin erases its own trigger, since
// `recordRepTyAdopt` records a literal's destination rep only while `tyReachesEmptyHole` holds,
// so the recording happens on that same condition and before the pin.
function constrainEmptyExpr(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if !inferQuiet && srcExpr >= 0 && tyReachesEmptyHole(srcTy, 8) {
    recordRepTyAdopt(srcExpr, dstTy, 6)
  }
  constrainEmpty(srcTy, dstTy)
}

// Open the deferred-pin frame for one function body (D1591). Pushed and popped with the
// body scope, so the rows a nested body records are its own.
function pushInferRetHoles() {
  irhMarks.push(irhExprs.length)
  irhConcrete.push(-1)
  irwMarks.push(irwExprs.length)
  0
}

// Record a value delivered to an inferred return — a `return e`, the body's trailing expression,
// or a tail `if`/`else` arm. One that still reaches an open collection hole becomes a row to
// pin; the first one that does not is this body's destination witness, which is what the rows
// are pinned against at the flush (D1591).
function noteInferRetWitness(srcExpr: i32, srcTy: i32) {
  if irhMarks.length == 0 { return 0 }
  if srcTy < 0 { return 0 }
  // A chain link names no node here; its caller records the link itself.
  if srcExpr >= 0 { noteInferRetValue(srcExpr, srcTy) }
  if tyReachesEmptyHole(srcTy, 8) {
    irhExprs.push(srcExpr)
    irhTys.push(srcTy)
    return 0
  }
  const top = irhConcrete.length - 1
  if irhConcrete[top] < 0 && tyPinsEmptyHoles(srcTy, 8) {
    irhConcrete[top] = srcTy
  }
  0
}

// Record the value `srcExpr`, typed `srcTy`, delivered to the inferred return of the body being
// checked, for `inferRetF32Join`.
function noteInferRetValue(srcExpr: i32, srcTy: i32) {
  if irwMarks.length == 0 || srcTy < 0 { return 0 }
  irwExprs.push(srcExpr)
  irwTys.push(srcTy)
  0
}

// Pin every delivery this body recorded against the shape a concrete return witness named, and
// retire the frame. With no such witness nothing is pinned — the program never said what the
// element type is, so the binding keeps its own `cannot infer a type` floor (D1591).
function flushInferRetHoles() {
  if irhMarks.length == 0 { return 0 }
  const top = irhMarks.length - 1
  const mark = irhMarks[top]
  const dst = irhConcrete[top]
  irhMarks.pop()
  irhConcrete.pop()
  let i = mark
  while i < irhTys.length {
    if dst >= 0 { constrainEmptyExpr(irhExprs[i], irhTys[i], dst) }
    i = i + 1
  }
  while irhTys.length > mark {
    irhExprs.pop()
    irhTys.pop()
  }
  0
}

// The inferred return `observed` of the body whose witness frame is on top, re-typed f32 when
// some witness is an f32 value and every other is a float literal, as an
// `if` join does (`joinF32LitTails`). Retires the frame whether or not it re-types.
function inferRetF32Join(inferring: boolean, observed: i32): i32 {
  if irwMarks.length == 0 { return observed }
  const mark = irwMarks[irwMarks.length - 1]
  irwMarks.pop()
  let res = observed
  if (
    inferring
    && observed >= 0
    && primNameOf(observed) != "f32"
    && f32JoinRetypesRunning()
  ) {
    const fTy = inferRetF32Of(mark)
    if fTy >= 0 { res = fTy }
  }
  while irwExprs.length > mark {
    irwExprs.pop()
    irwTys.pop()
  }
  res
}

// Whether an inferred return and a list literal adopt f32 as an `if` join does. Off: each reads
// f64 today and runs where an f64 is accepted, so adopting changes values (D2774).
function f32JoinRetypesRunning(): boolean { false }

// The f32 type the witnesses from `mark` on join to when they are f32 values and literals.
function inferRetF32Of(mark: i32): i32 {
  const es: i32[] = []
  const ts: i32[] = []
  let i = mark
  while i < irwExprs.length {
    const t = irwTys[i]
    // A value-less or diverging path delivers nothing to the join.
    if t != TY_VOID && primNameOf(t) != "never" {
      es.push(irwExprs[i])
      ts.push(t)
    }
    i = i + 1
  }
  f32LitJoinOf(es, ts)
}

// The f32 type a join of the values `exprs`, typed `tys`, takes when some are f32 values and
// every other is a float literal or a join of them (`floatLitTails`); else -1. The
// literals' `if` and `match` nodes are re-typed f32 only when the whole join qualifies.
function f32LitJoinOf(exprs: i32[], tys: i32[]): i32 {
  // The common join has no f32 member; it is answered by type tests alone.
  let j = 0
  while j < tys.length && primNameOf(tys[j]) != "f32" { j = j + 1 }
  if j == tys.length { return -1 }
  let fTy = -1
  let lits = 0
  const savedQuiet = inferQuiet
  inferQuiet = true
  let i = 0
  while i < exprs.length && lits >= 0 {
    if primNameOf(tys[i]) == "f32" { fTy = joinTys(fTy, tys[i]) }
    else if floatLitTails(exprs[i]) { lits = lits + 1 }
    else { lits = -1 }
    i = i + 1
  }
  inferQuiet = savedQuiet
  if lits <= 0 || fTy < 0 || primNameOf(fTy) != "f32" { return -1 }
  if !inferQuiet {
    let k = 0
    while k < exprs.length {
      if primNameOf(tys[k]) != "f32" { f32LitTailsAdopt(exprs[k], TY_F32) }
      k = k + 1
    }
  }
  fTy
}

function constrainEmptyD(srcTy: i32, dstTy: i32, depth: i32) {
  if srcTy < 0 || dstTy < 0 || depth <= 0 { return 0 }
  const s = T.tys[srcTy]
  const d = T.tys[dstTy]
  // A container null hole delivered to a nullable slot takes the slot's `T` (D2506).
  if d is TyNullable {
    if d.nInner >= 0 && cnhIsOpen(srcTy) { return cnhFill(srcTy, dstTy) }
  }
  // A nullable destination pins the same holes its inner shape does: a `string[] | null` field
  // or map value accepts a non-null `[]`, and the hole behind it needs the element rep either
  // way. Unwrapped on the source side too, so a nullable producer flowing into a nullable slot
  // lines its inner shapes up rather than stopping at the wrapper.
  if d is TyNullable { return constrainEmptyD(srcTy, d.nInner, depth - 1) }
  if s is TyNullable { return constrainEmptyD(s.nInner, dstTy, depth - 1) }
  // An open `[]` delivered to a union is built as its first list member, the arm
  // `recordRepTyAdopt` records for a literal, so a call returning one pins the same way.
  if s is TyArray {
    if s.aElem < 0 {
      if d is TyUnion {
        let ui = 0
        while ui < d.uMembers.length {
          const um = T.tys[d.uMembers[ui]]
          if um is TyArray {
            return constrainEmptyD(srcTy, d.uMembers[ui], depth - 1)
          }
          ui = ui + 1
        }
        return 0
      }
    }
  }
  if s is TyArray {
    if d is TyArray {
      if s.aElem < 0 {
        // Both sides open is not a pin but a link — `s.aElem = d.aElem` would write the `-1`
        // back and lose the fact that these two rows must agree, which `arrDefHoleToI32` needs
        // once an unpinned hole acquires a default. D1470.
        if d.aElem < 0 {
          noteHoleLink(srcTy, dstTy)
        } else {
          s.aElem = d.aElem
          tyMutEpoch = tyMutEpoch + 1 // in-place element pin — canonical keys change
        }
      } else {
        constrainEmptyD(s.aElem, d.aElem, depth - 1)
      }
    }
    return 0
  }
  if s is TyMap {
    if d is TyMap {
      if s.mKey < 0 {
        s.mKey = d.mKey
        tyMutEpoch = tyMutEpoch + 1 // in-place key pin
      }
      if s.mVal < 0 {
        s.mVal = d.mVal
        tyMutEpoch = tyMutEpoch + 1 // in-place value pin
      } else {
        constrainEmptyD(s.mVal, d.mVal, depth - 1)
      }
    }
    return 0
  }
  // A struct destination pins field-wise, by name. The source is an object literal's own
  // inferred shape, so its field order is the literal's, not the declaration's — matching
  // positionally would pin `{ b: fq(), a: [1] }` from the wrong field.
  if s is TyObj {
    if d is TyObj {
      let i = 0
      while i < s.objFieldNames.length {
        if i < s.objFieldTypes.length {
          const dft = objFieldType(d, s.objFieldNames[i])
          if dft >= 0 { constrainEmptyD(s.objFieldTypes[i], dft, depth - 1) }
        }
        i = i + 1
      }
    }
    return 0
  }
  0
}

// D1470 — an `__array_new_default__` hole that nothing pinned, defaulted to `i32` in place;
// false for every other unresolved hole. `array.new_default` promises the element's zero and
// says nothing about which element, so `i32` is honest here where `const xs = []` is not.
// Asked from `flushUninferred`, after every pin has had its chance.
function arrDefHoleToI32(ty: i32) {
  if !arrDefRowIsCall(ty) { return false }
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem < 0 {
      arrDefPinHoleElem(ty)
      return true
    }
  }
  false
}

// D1566 — an operator operand cannot wait for the flush, so it peeks the default rather than
// taking it. Every other position tolerates the in-band `-1` an unpinned element reads back as,
// but the operator arms index `T.tys` with the operand type and `T.tys[-1]` traps the compiler.
// Peeking leaves the row open, so a later store can still decide the element.
function arrDefOperandElemPeek(exprIx: i32) {
  if exprIx < 0 { return -1 }
  let cur = exprIx
  let hops = 0
  while hops < 4 {
    const p = P.nodes[cur]
    if p is Paren {
      cur = p.parInner
      hops = hops + 1
    } else {
      hops = 4
    }
  }
  const e = P.nodes[cur]
  if e is Index {
    const at = nodeTyIxOf(e.idxArr)
    if at < 0 { return -1 }
    const t = T.tys[at]
    if t is TyArray {
      if t.aElem < 0 {
        if arrDefRowServed(at) {
          // The element `arrDefPinHoleElem` would write, read without writing this row: the
          // same link fixpoint it runs (`resolveHoleLinks` propagates only an element some pin
          // already decided, never a default), then `i32` if nothing reached the row.
          resolveHoleLinks()
          const t2 = T.tys[at]
          let el = TY_I32
          if t2 is TyArray {
            if t2.aElem >= 0 { el = t2.aElem }
          }
          // The read's own recorded type, not the row's: `checkNode` banked the `-1` this read
          // answered a moment ago and the emitter reads that, so a stale entry makes
          // `print(a[0] ?? 1)` refuse at emit. The row stays open, so a later store re-decides
          // it.
          if !inferQuiet {
            if cur < nodeTyIx.length { nodeTySet(cur, el) }
          }
          return el
        }
      }
    }
  }
  -1
}

// Pin `asgOpenElemRow`'s open element from a store's value type `vt` when `exprIx` reads that same
// row, and answer the element's value type; -1 when it is some other read. A store whose value
// reads the place it writes (`xs[i] += v`, or that spelled out) has no other moment to pin: the
// read answers `-1`, the operator floor turns that into `TY_ERR`, and the store banks it. D1603.
function asgReadElemPin(exprIx: i32, vt: i32) {
  if asgOpenElemRow < 0 || exprIx < 0 { return -1 }
  if vt < 0 || vt == TY_ERR || vt == TY_VOID { return -1 }
  if tyHasHole(vt) { return -1 }
  const e = P.nodes[exprIx]
  if e is Index {
    if nodeTyIxOf(e.idxArr) != asgOpenElemRow { return -1 }
    const t = T.tys[asgOpenElemRow]
    if t is TyArray {
      if t.aElem >= 0 { return -1 }
      t.aElem = widenLitTy(vt)
      tyMutEpoch = tyMutEpoch + 1 // the store's own value pinned the element in place
      const el = arrElemValueTy(vt)
      // The read's recorded type too, for `arrDefOperandElemPeek`'s reason: `checkNode` banked
      // the `-1` a moment ago and the emitter reads that entry.
      if !inferQuiet {
        if exprIx < nodeTyIx.length { nodeTySet(exprIx, el) }
      }
      return el
    }
  }
  -1
}

// D1512 — the one place an unpinned intrinsic hole acquires its element: whatever the link graph
// can still reach (`resolveHoleLinks`, run first), else the `i32` default. Returns the row's
// element after the pin, or -1 when the row is not an array. Both sites that default such a hole
// go through here, so an intrinsic delivered into a plain `v = …` cannot take `i32` on its own.
function arrDefPinHoleElem(ty: i32) {
  if ty < 0 { return -1 }
  resolveHoleLinks()
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem < 0 {
      // A literal-union element is stored at its base primitive, whose zero the intrinsic
      // writes; the `i32` default only when no callee wrote the row.
      let el = litMembersBaseTy(calleeWrittenElem(ty))
      if el < 0 { el = TY_I32 }
      t.aElem = el
      tyMutEpoch = tyMutEpoch + 1 // in-place element pin — canonical keys change
    }
    return t.aElem
  }
  -1
}

// The element a hole callee's first write gives an open list row handed to it as a binding,
// directly or through a chain of hole links, or -1 when no callee wrote it (D3746).
function calleeWrittenElem(ty: i32): i32 {
  if calleeWriteRow.length == 0 { return -1 }
  const rows = holeLinkClosure(ty)
  let i = 0
  while i < calleeWriteRow.length {
    if i32ListHas(rows, calleeWriteRow[i]) {
      return widenLitTy(calleeWriteGot[i])
    }
    i = i + 1
  }
  -1
}

// Pin a still-open list binding at scope close to the element a hole callee's write gave it;
// false when no callee wrote it, which leaves the binding's own diagnostic standing (D3746).
function calleeWritePin(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem >= 0 { return false }
    const el = calleeWrittenElem(ty)
    if el < 0 { return false }
    t.aElem = el
    tyMutEpoch = tyMutEpoch + 1 // in-place element pin — canonical keys change
    return true
  }
  false
}

// Before a caller's write of `got` pins open list row `ty`, give the row an earlier hole callee's
// element when `got`'s element cannot hold that callee's write: the first write decides, as at
// the direct spelling, and the caller's write is checked against it. A callee write it can hold
// (a literal `1` beside a later `2.5`) leaves the caller's write to decide (D3775).
function calleeWritePrePin(ty: i32, got: i32) {
  if ty < 0 || got < 0 || calleeWriteRow.length == 0 { return 0 }
  if got == TY_ERR || tyHasHole(got) { return 0 }
  const el = widenLitTy(got)
  const rows = holeLinkClosure(ty)
  let i = 0
  while i < calleeWriteRow.length {
    if i32ListHas(rows, calleeWriteRow[i]) {
      if !assignable(calleeWriteGot[i], el) {
        calleeWritePin(ty)
        return 0
      }
    }
    i = i + 1
  }
  0
}

// Refuse every hole callee's write into a binding's list that the list's final element cannot
// hold: the callee's instance is built over that element (D3775).
function checkCalleeWrites() {
  let i = 0
  while i < calleeWriteRow.length {
    const el = linkedRowElem(calleeWriteRow[i])
    const got = calleeWriteGot[i]
    if el >= 0 && got >= 0 && !tyHasHole(got) && !tyHasHole(el) {
      if !assignable(got, el) {
        tErr(
          "the callee's body writes "
            + tyToStr(widenLitTy(got))
            + " into the list passed here, whose element is "
            + tyToStr(el),
          calleeWriteAt[i],
        )
      }
    }
    i = i + 1
  }
  0
}

// Hand `src`'s resolved element to `dst`'s open one, enforcing the link's own invariant that the
// two rows carry the same element. True when the pin moved, which is what the fixpoint below
// iterates on.
function holeLinkPinFrom(src: i32, dst: i32) {
  if src < 0 || dst < 0 { return false }
  const s = T.tys[src]
  if s is TyArray {
    if s.aElem >= 0 {
      const d = T.tys[dst]
      if d is TyArray {
        if d.aElem < 0 {
          d.aElem = s.aElem
          tyMutEpoch = tyMutEpoch + 1 // in-place element pin — canonical keys change
          return true
        }
      }
    }
  }
  false
}

// D1565 — every link pair, to a fixpoint: a resolved row hands its element to its open partner
// and the sweep repeats until no row moves. A one-hop consult reads a partner that has not
// resolved yet and takes `i32` while the rest of the chain lands on `f64`. A component nothing
// pins is untouched; the bound is structural, since a sweep that changes anything pins a row.
function resolveHoleLinks() {
  if holeLinkA.length == 0 { return 0 }
  const bound = holeLinkA.length * 2 + 1
  let sweeps = 0
  let changed = true
  while changed {
    changed = false
    sweeps = sweeps + 1
    if sweeps > bound {
      // Unreachable by the bound above, and stated rather than assumed: a sweep only ever turns
      // an open element into a resolved one, never back. A named failure beats a `while` that
      // spins, since a hang is the one outcome a checker must never have.
      tErr("internal: __array_new_default__ hole links did not converge", -1)
      return 0
    }
    let i = 0
    while i < holeLinkA.length {
      if holeLinkPinFrom(holeLinkA[i], holeLinkB[i]) { changed = true }
      if holeLinkPinFrom(holeLinkB[i], holeLinkA[i]) { changed = true }
      i = i + 1
    }
  }
  0
}

// An element type this pass must not judge: a `TyErr`, whose own diagnostic is already raised
// and a second one on the same expression is the cascade `TyErr` exists to stop, or a `TyVar`,
// a generic body's hole the instance decides. Both answer `false` to `elemHasZero`, which is
// why they need naming ahead of it.
function arrDefElemDeferred(el: i32) {
  if el < 0 { return true }
  const t = T.tys[el]
  if t is TyErr { return true }
  t is TyVar
}

// D965 — grade every `__array_new_default__` call once the pins are all in: an element with no
// zero is refused here, at the checker, because the emitter reaching it would build the i32
// backing under a destination of some other rep. A still-open hole is pinned to `i32` so the
// arena says what the emitter builds. Keyed by the call, so one pass covers every position.
function checkArrayNewDefaultElems() {
  let i = 0
  while i < arrDefCallTy.length {
    const t = T.tys[arrDefCallTy[i]]
    if t is TyArray {
      // Pin first, then grade — one order, not two paths: defaulting an unpinned hole and
      // skipping the grade leaves the link unread and never asks an element a partner supplies
      // for its zero. D1512.
      const el = arrDefPinHoleElem(arrDefCallTy[i])
      if arrDefElemDeferred(el) {
        // An error element already has its own diagnostic and a hole element is a generic
        // body's, where this question has no answer until the pin — the same deferral every
        // other floor in this file makes over a `TyVar` (see `notePrintCstr`).
      } else if !elemHasZero(el) {
        tErr(
          "__array_new_default__ fills every slot with the element's default value, and "
            + tyToStr(el)
            + " has none — use __array_new__(n, fill)",
          arrDefCallIx[i],
        )
      }
    }
    i = i + 1
  }
  0
}

// Flush every pending binding recorded at scope `depth`, called just before the scope is popped
// and for the global scope at program end. A binding whose hole is still open at this point
// will never be pinned, so it takes the unified "cannot infer a type" diagnostic.
function flushUninferred(depth: i32) {
  flushNullHoles(depth)
  const keepN: string[] = []
  const keepT: i32[] = []
  const keepA: i32[] = []
  const keepD: i32[] = []
  let i = 0
  while i < pendNames.length {
    if pendDepths[i] == depth {
      if unresolvedHole(pendTys[i]) {
        if !arrDefHoleToI32(pendTys[i]) && !calleeWritePin(pendTys[i]) {
          tErr(
            "cannot infer a type for '"
              + pendNames[i]
              + "' — "
              + uninferredFixText(pendNames[i], pendTys[i]),
            pendAts[i],
          )
        }
      }
    } else {
      keepN.push(pendNames[i])
      keepT.push(pendTys[i])
      keepA.push(pendAts[i])
      keepD.push(pendDepths[i])
    }
    i = i + 1
  }
  pendNamesSet(keepN)
  pendTysSet(keepT)
  pendAtsSet(keepA)
  pendDepthsSet(keepD)
  0
}

// ── definite-assignment flow ─────────────────────────────────────────────────
// Check a read of `name`: if it is still unassigned on this path, report it and drop it so the
// same hole does not re-fire on every later read.
function daCheckRead(name: string, at: i32) {
  if daLive.length == 0 { return 0 }
  const sid = sidOf(name)
  if daIsUnassignedSid(sid) {
    daMarkAssignedSid(sid)
    tErr("`" + name + "` is used before it is assigned", at)
  }
  0
}

// The joins `paramNullJoin` kept a null in (D3497): re-folding one at a call keeps the null even
// when the bound members absorb it, as a caller's own holes do.
let paramNullJoins: {[i32]: i32} = Map()
// Whether any join has made one record of two (`joinObjFieldwise`). Only ever set, so the
// emitter passes that build a join's arms at its row can skip a program with none (D2731).
let recordJoinMinted = false

// The emitter's read of `recordJoinMinted`.
export function recordJoinSeen(): boolean { recordJoinMinted }

// The `__memory_shared__()` Call nodes that denote the build intrinsic rather than a local of
// that name; `foldMemShared` folds an `if` only on one of these. Reset by `initChecker`.
export let memSharedCalls: i32[] = []
// The `Member` node an assignment is about to write, so a getter there is refused as a write
// rather than resolved as a read. -1 outside an assignment target.
let getWriteTarget = -1
// Every `+` the real pass checked, by anchor token, and whether its left operand concatenates
// as a string — no operator declaration takes one as receiver, so the link is the built-in
// concat. Read by the `prefer-interpolation` lint, which has no types: a link rechecked with
// another left operand type (a generic pin) records twice, and any `0` among its rows wins.
let plusLinkTok: i32[] = []
let plusLinkStr: i32[] = []
// Every index read the real pass checked, by anchor token, and whether its receiver checked
// as a `string`, so the element is a UTF-8 byte. Read by the `byte-as-code-point` lint under
// `plusLinkStr`'s rule: a site rechecked with another receiver type records twice.
let strIdxTok: i32[] = []
let strIdxStr: i32[] = []
// ── the type-parameter `self` operator, banked from both ends ────────────────

let inferObserved = -1
let inferSawErr = false
let inferObservedLit = true
// Whether the witness `noteInferredRet` is handed next is a literal, set by its caller.
let inferRetNextLit = false
// The `return <void expr>` statements of the functions being inferred, per inference frame, and
// the block each sits in: a void return, refused if its function returns a value (D2635).
let inferVoidRetSites: i32[] = []
let inferVoidRetBlks: i32[] = []
// The innermost block whose statements are being checked: the block a `return` sits in.
let chkStmtBlk = -1
// The void returns settled in void functions, and their blocks, which `voidRetRewrite` splits
// into the expression statement and a bare `return` once every body is checked.
let voidRetRwRet: i32[] = []
let voidRetRwBlk: i32[] = []
let inferRetSeeding = false
// The seeds `dropTailIfSeeds` removed, per inference frame: re-joined when the function turns
// out to return a value anyway, since then the tail's value arms return (`clearTailVerdict`).
let inferDroppedTy: i32[] = []
let inferDroppedLit: boolean[] = []
// True while an explicit `return`'s argument is checked: an `if` there is a value slot, so its
// verdict never rewinds the inferred return (the slot's own void check refuses it instead).
let inRetArg = false
// The value type of the most recently checked `Block` — its trailing expression's type, or
// `TY_VOID` when the block ends in a statement. `checkNode(Block)` itself returns `TY_VOID`, so
// this carries the tail value out of band for an `if … { v } else { w }` expression to join its
// branch values. Read immediately after a `checkNode(block)`.
let blockTailTy = -1
// The node `blockTailTy` came from, or -1 for a valueless block. Written in the same place and
// read in the same breath, so a tail `if`/`else` arm can hand its own expression to
// `constrainEmptyExpr` rather than the arms' join, which is a different arena row (D1591).
let blockTailIx = -1
// True while checking a node whose value is the enclosing function's return — the body's tail
// statement, and by propagation the tail of each branch of a tail `if`/`else`. It gates seeding
// `inferObserved` from a branch value, so a base-case branch pins the type before a recursive
// sibling is checked, without a non-tail `if`'s branch values polluting the inferred return.
let retTailPos = false

// Whether the `match` being checked is in return-tail position, where its join seeds the
// inferred return and so keeps the reading it has today (D2774).
let matchInRetTail = false
// The `match` `checkNode` last entered in return-tail position, which it leaves as a non-spine node.
let matchTailNode = -1

// Each top-level `let`/`const` by name to its node, or -1 once pass 2 has reached the
// declaration: a top-level write to one still mapped is a write before its initializer (D2654).
let moduleBeforeDecl: {[string]: i32} = Map()
// Recursive return-type inference (binding-group fixpoint). A function whose return becomes
// knowable only after a recursive cycle resolves cannot be inferred in one demand pass, since the
// cycle-break commits a provisional `void`. A suppressed pre-pass resolves every un-annotated
// return first, iterating to a fixpoint; `bodyChecked` lets the real pass still check each once.
let topUnannotFns: i32[] = []
// An un-annotated function whose returns disagree and join to one list type, keyed as
// `inferRetIdx` is: the joined `Ty` index, which no single return's own list rep names (D2716).
let inferJoinListIdx: {[string]: i32} = Map()
let bodyChecked: {[string]: boolean} = Map()
// Un-annotated bindings whose initializer is a `??` or an `if` join, the only ones the emitter
// may pin to a list union (D2844). Appended per checked binding; a repeat is harmless.
export let letJoinCandidates: i32[] = []
// The arm patterns a `const`-pattern refusal already reported, so the vocabulary does not again.
let matchPatRefused: {[i32]: boolean} = Map()
// The delivery sites the function-value adapter rewrote, so a second delivery of one does not
// wrap the adapter again.
let fvaDone: {[i32]: boolean} = Map()
// The function declaration a name delivered as a value resolves to in its own scope, or -1,
// banked for a deferred re-check, which runs outside that scope (D3918).
let fvaNameDecl: {[i32]: i32} = Map()
// The discriminant bank, parallel to `isVarTyIx` and sized with it. At an `is` test whose receiver
// is a member path over a struct union, it records the type the receiver narrows to in the then
// branch (`pushDiscrimParentFact`'s answer), which the emitter cannot cheaply re-derive: an arm's
// tag identity lives in a different column depending on how the tag is written. Then branch only.
let isParentTyIx: i32[] = []
// The else twin of `isParentTyIx`. One table per branch rather than one table plus a direction
// flag: both facts are keyed on the same condition node, and the emitter reads them from two sites
// (`setNarrowFromCond` and `setNarrowFromCondElse`) that never run together for one branch, so a
// flag would be set by whichever site asked last.
let isParentElseTyIx: i32[] = []
// Context-resolved type sidecar, parallel to `nodeTyIx`: at the arena-pure adoption sites it
// records the destination type a literal node widened into, which is the rep the emitter builds.
// `nodeTyIx` keeps the checker's self-inferred type for its existing consumers; the emitter's rep
// keying reads `nodeRepTyIxOf`, which falls back to `nodeTyIxOf` when nothing is recorded.
let nodeRepTyIx: i32[] = []
// Per node, the map type a union of maps is delivered as (D2692): the members share that map's
// storage, so the emitter unboxes the union's payload there. -1 where nothing is recorded.
let mapUnboxTyIx: i32[] = []
// The shift nodes whose count is a literal, graded once every width is in (`checkShiftCounts`).
let shiftCountNodes: i32[] = []
// Whether the checker has typed an identifier naming an `extern` anywhere but as a callee: the
// one case the emitter's `synthExternValues` has work for, so a program that only calls its
// externs skips it (D2618). `ckCalleeIx` is the callee node the general call arm is typing, or -1.
let extValueSeen = false
let ckCalleeIx = -1
// The arena types externs are declared at, by index: the cheap filter in front of the name.
let extFnTy: boolean[] = []

// The least of them, so a read at any earlier-interned type (every primitive) is one compare.
let extFnTyMin = 2147483647

function extFnTyMark(ty: i32) {
  if ty < 0 { return 0 }
  while extFnTy.length <= ty { extFnTy.push(false) }
  extFnTy[ty] = true
  if ty < extFnTyMin { extFnTyMin = ty }
  0
}
export function externValueSeen(): boolean { extValueSeen }
let cFillActive = false
// The declaration's arena node, so the cycle report — which is discovered in the fixpoint, long
// after the statement walk that found the declaration — can still anchor on the right line.
let flDeclNodes: i32[] = []
// Depth counter for the literal-adoption window (`nomLitAdopts`): while positive, `assignableGo`'s
// brand test stands down. Only ever raised around a walk whose source is a scalar literal, which
// is what makes waiving the whole walk equivalent to waiving the destination's own brand.
let nomLitRelax = 0
// A single placeholder `TyFunc` arena index for monomorphizer `=>sigkey` closure pins (C1 endgame).
let cFuncPinTyIx = -1
// A single placeholder `TyObj` arena index for interned anonymous-shape `#anonN` names (C1 endgame).
let cObjPinTyIx = -1
// ── the pin column ───────────────────────────────────────────────────────────

let cycleBreakCount = 0
// Bare `{}` literals refused so far (D2223): a body holding one has already been reported, so
// its return inference owes no second message.
let bareBraceCount = 0
// D2223: every value-position `{}` checked, and per node whether a delivery gave it a record
// type to complete (1). `bareBraceUndelivered` refuses the rest once every body is checked.
let bareBraceLits: i32[] = []
let bareBraceMark: i32[] = []
// Nesting depth of a speculative `assignableExpr` (one union member tried of several): a `{}`
// is judged once, by the outer delivery that sees every member.
let bareBraceSpec = 0
let unresolvedFns: string[] = []
let fnSawValueRet = false

// Redundant return-type annotation rule: `retNatural` is the body's natural inferred return — the
// first non-void, non-error one, mirroring `noteInferredRet` — accumulated for an annotated
// function so the rule can compare it against the explicit `: T`. A match means removing the
// annotation yields the identical inferred return. Saved, reset and restored per function.
let retNatural = -1
let retNaturalErr = false

// The contextual expected return type per lambda node, the return-side dual of the param seeding:
// a lambda whose body infers a narrower numeric than the expected return adopts it, so the
// widening happens inside the body at the return seam rather than riding function-type variance.
// `cbSeedUsed` counts seeds that changed an inference, so `checkLetDecl` cannot call it redundant (D1442).
let cbSeedUsed = 0
// The empty answer of a call no destination binds, shared and never written.
const NO_DST_NAMES: string[] = []

// The field walk of `objRetWidenAdopt`: `litIx` is an ObjLit whose inferred `sTyIx` adopts the
// expected `dTyIx` field-wise, appending each re-encodable value node and its adopted field type
// to `recNodes`/`recTys`. False on any proven mismatch, in which case the caller keeps the
// inferred shape. Adoption is sound only where the literal body can re-encode at the wider rep.
function objLitWidenFields(
  litIx: i32,
  sTyIx: i32,
  dTyIx: i32,
  recNodes: i32[],
  recTys: i32[],
): boolean {
  const lit = P.nodes[litIx]
  if !(lit is ObjLit) { return false }
  const s = T.tys[sTyIx]
  const d = T.tys[dTyIx]
  if !(s is TyObj) { return false }
  if !(d is TyObj) { return false }
  if s.objFieldNames.length != d.objFieldNames.length { return false }
  let i = 0
  while i < d.objFieldNames.length {
    const dty = d.objFieldTypes[i]
    const sty = objFieldType(s, d.objFieldNames[i])
    if sty < 0 { return false }
    // The field's value expression in the literal body, shared by the numeric-widen and the
    // float-literal-to-f32 arms below.
    let fv = -1
    const fl = lit.objFields
    let fi = 0
    while fi < fl.length {
      const fn = P.nodes[fl[fi]]
      if fn is FieldInit {
        if fn.fiName == d.objFieldNames[i] { fv = fn.fiValue }
      }
      fi = fi + 1
    }
    if numWidens(sty, dty) {
      // The widening field's value must be a small int literal in the literal body.
      if fv < 0 { return false }
      const fvn = P.nodes[fv]
      if fvn is NumLit {
        if numLexIsFloat(fvn.numText) { return false }
        if !numLexFitsI32(fvn.numText) { return false }
        recNodes.push(fv)
        recTys.push(dty)
      } else {
        return false
      }
    } else if primNameOf(dty) == "f32" && isF32AdoptingLitExpr(fv) {
      // A literal into an f32 field (`() => ({a: 3.5, …})` against `{a: f32, …}`): the field infers
      // f64 or i32 but the literal re-encodes exactly at f32, the field dual of the scalar arm.
      // Record f32 on the value node so `anonFieldCode` interns the f32 field slot rather than
      // coding the literal's default.
      recNodes.push(fv)
      recTys.push(dty)
    } else if assignable(sty, dty) && !assignable(dty, sty) {
      // The field widens by boxing — a bare scalar or struct arm into a union or nullable field
      // (`{f: false}` against `{f: boolean | {w: i32}}`). Adopt when the literal value re-encodes
      // at the wider field type, and record that type so the emitter boxes the field slot;
      // `synthRetAnnots` then pins the lambda's `fnRet` to the whole struct shape.
      if fv < 0 { return false }
      let fvIn = fv
      let fvDone = false
      while !fvDone {
        const fvp = P.nodes[fvIn]
        if fvp is Paren { fvIn = fvp.parInner } else { fvDone = true }
      }
      const fvNode = P.nodes[fvIn]
      // The recursion targets a nested-struct destination only: an ObjLit value against a union
      // field is a member of that union, an arm rather than a field-wise widening target, and
      // descending into it refutes the whole adoption, leaving the emitter to key the outer
      // literal onto a same-field-name-set twin. A non-`TyObj` dest takes the member-flow check.
      let dtyIsObj = false
      const dtyT = T.tys[dty]
      if dtyT is TyObj { dtyIsObj = true }
      if fvNode is ObjLit && dtyIsObj {
        if !objLitWidenFields(fvIn, sty, dty, recNodes, recTys) { return false }
        recNodes.push(fvIn)
        recTys.push(dty)
      } else {
        if !assignableExpr(fv, sty, dty) { return false }
        recNodes.push(fv)
        recTys.push(dty)
      }
    } else if tyIsLitUnion(dty) {
      // A litunion field (`f: "8"` against `f: K0 = "xz" | "8"`): the body value is a bare string
      // literal that is a member of the expected literal union. It infers the softened `string`
      // but re-encodes as the litunion's i32 atom, so record the litunion field type and
      // `anonFieldCode` interns the atom slot rather than the string.
      if fv < 0 { return false }
      if !assignableExpr(fv, sty, dty) { return false }
      recNodes.push(fv)
      recTys.push(dty)
    } else {
      // A non-widening field must match exactly (mutual assignability) — a shape
      // difference beyond numeric widening is not an adoption, it is a mismatch.
      if !assignable(sty, dty) { return false }
      if !assignable(dty, sty) { return false }
    }
    i = i + 1
  }
  true
}

function objRetWidenAdopt(bodyIx: i32, inferredTy: i32, expRetTy: i32) {
  if inferredTy < 0 || expRetTy < 0 { return false }
  let u = lambdaBodyTail(bodyIx)
  if u < 0 { return false }
  let done = false
  while !done {
    const pn = P.nodes[u]
    if pn is Paren { u = pn.parInner } else { done = true }
  }
  const lit = P.nodes[u]
  if !(lit is ObjLit) { return false }
  const s = T.tys[inferredTy]
  // A nullable expected result (`() => {f: K0} | null`, spelled directly or through the
  // nullable-closure wrapper): adopt against the inner struct. The caller still adopts the full
  // nullable expected, so the lambda's `$fnsig` result keys the nullable struct exactly as the
  // annotation-side consumer does; without the unwrap the two sides key different structs.
  let expInnerTy = expRetTy
  const dn = T.tys[expRetTy]
  if dn is TyNullable { expInnerTy = dn.nInner }
  const d = T.tys[expInnerTy]
  if s is TyObj {
    if d is TyObj {
      const recNodes: i32[] = []
      const recTys: i32[] = []
      if !objLitWidenFields(u, inferredTy, expInnerTy, recNodes, recTys) {
        return false
      }
      if recNodes.length == 0 { return false }
      if !inferQuiet {
        let r = 0
        while r < recNodes.length {
          const rn = recNodes[r]
          while nodeTyIx.length <= rn { nodeTyIx.push(-1) }
          nodeTySet(rn, recTys[r])
          r = r + 1
        }
        // Rep sidecar: `nodeTyIx` above stamps the widening field values, but the top-level return
        // literal `u` keeps its naive self-inferred type, and `structIndexOfObjCtx` keys on the
        // literal node. Record the destination struct there, recursing into fields, so the rep
        // layer resolves the union-field / i64-field / nullable-niche shape the emitter builds.
        recordRepTyAdopt(u, expInnerTy, 6)
      }
      return true
    }
  }
  false
}

// ── deep `is` over a `Json` value ────────────────────────────────────────────

// The last "not a JSON shape" reason, banked rather than raised — see `jsonDeepIsSite`.
let jwBadMsg = ""

// Reset all checker module state, then intern the well-known primitives and the global
// scope. Call once before checking: `checkProgram` assumes it, and this is the only reset
// surface, so a new checker module table belongs here and nowhere else.
export function initChecker() {
  mimpClear()
  identColReset()
  sideRowsReset()
  jwReset()
  redunReset()
  rcoalReset()
  isvalReset()
  covarWriteReset()
  cursorReset()
  holeRowsReset()
  joinRowsReset()
  inferRowsReset()
  expectedReset()
  cbSeedUsed = 0
  T.tys = []
  tpJoinUnions = Map()
  listUnionReset()
  paramNullJoins = Map()
  substFoldReset()
  holeTpJoinNames = Map()
  genFnCstrBusy = false
  ifValueReset()
  recordJoinMinted = false
  T.scopes = []
  scopeDepthsOf = Map()
  T.diags = []
  T.curRet = -1
  cUserTypes = Map()
  // The arena is re-minted for this program: advance both generations so no emit-side memo
  // stamped under a previous program can be consulted on a shared instance. Advance, never
  // reset — a reset could collide with a stamp an earlier program left behind.
  tyMutEpoch = tyMutEpoch + 1
  cUserTypesVer = cUserTypesVer + 1
  genAliasAnnsReset()
  gaParamNames = []
  gaParamStart = []
  gaParamCount = []
  annotNameMemo = Map()
  annotNameMemoNegVer = Map()
  annotPart = Map()
  annotClash = Map()
  declScanReset()
  tpBoundReset()
  cohKeys = []
  cohWitness = []
  cohSiteLine = []
  cohSiteCol = []
  asgRowsReset()
  substReset()
  holeLinksReset()
  coalReset()
  narPathsReset()
  hdReset()
  guardReset()
  joinHoleUnions = []
  njGateReset()
  njJoinReset()
  njPinFn = -1
  apartHoleJoins = Map()
  binCstr.lt = []
  binCstr.op = []
  binCstr.rt = []
  binCstr.fn = []
  cvViaAt = Map()
  cvNow = -1
  argCstr.at = []
  argCstr.exp = []
  argCstr.who = []
  argCstr.fn = []
  argCstr.node = []
  argCstr.form = []
  printCstr.ty = []
  printCstr.ix = []
  printCstr.fn = []
  nestCstr.ty = []
  nestCstr.ix = []
  nestCstr.fn = []
  nestCstrSeen = Map()
  isCstr.ty = []
  isCstr.chk = []
  isCstr.name = []
  isCstr.ix = []
  isCstr.fn = []
  arrDefCallIx = []
  retCstr.got = []
  retCstr.want = []
  retCstr.ix = []
