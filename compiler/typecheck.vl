// A type-checker for a meaningful subset of VL, written in VL — the stage between the
// parser and the emitter. It consumes the parser's node arena (`P.nodes`) directly: it
// lexes nothing and parses nothing itself. Checker state lives in the global `T`, like
// the parser's `P`.
//
// A `type` union alias cannot self- or forward-reference its own members, so a recursive
// `VLType` is not expressible in VL. Types live in a flat arena `T.tys: Ty[]` and every
// place a type would nest another holds an `i32` index into it (`TyObj.objFieldTypes`,
// `TyFunc.fnRet`, `TyUnion.uMembers`, `TyNullable.nInner`) — the AST node arena's own
// workaround, applied to the type algebra. The visitor is factored: per-kind helpers
// (`checkCallNode`, `checkFuncDeclNode`, `checkProgramNode`) take the narrowed variant
// as a struct parameter and recurse back through `checkNode`.

import {
  f32LitOverflows,
  f64LitOverflows,
  intLexemeIsExactF32,
  numLexIsFloat,
  numLexRadixBits,
  parseI32,
  parseI64Pair,
} from "./emit_bignum"
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  ErrExpr,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  ImportDecl,
  Index,
  IsExpr,
  LetDecl,
  MatchExpr,
  Member,
  Node,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  Param,
  Paren,
  Program,
  RetStmt,
  StrLit,
  TPL_RENDER_LOCAL,
  TypeDecl,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
  mkBinary,
  mkBlock,
  mkIf,
  mkNum,
  mkParen,
  nodeIsTplHole,
} from "./ast"
import {
  CALLSITE_NAME,
  P,
  declNameTokOf,
  fillArgDefaults,
  fnRequiredArity,
  hasNamedArgs,
  i32ToStr,
  isDefaultGlobalRef,
  markDefaultGlobalRef,
  nodeToks,
  orderArgsByParamNames,
  paramDefaultIsCallsite,
  tsMentionsAnyName,
  ufcsAliasAtSite,
  ufcsAliasInScope,
  ufcsImpMangled,
  ufcsImpName,
  ufcsImpSpec,
  ufcsSpecAlreadyImported,
} from "./ast"
// The free index-operator declaration-name encoding (B14).
import { OP_INDEX_GET, OP_INDEX_SET, opDeclLabel, opDeclOpOf } from "./ast"
// A node's start offset and the token sitting at it — the `argument N` mismatch anchor
// for a function-literal argument (`tErrAtNodeStart`), whose `nodeToks` last-token anchor
// is its closing brace.
import { nodePos, tokIndexAt } from "./fmt_util"
import { sidArrGet, sidArrPut, sidOf } from "./symbols"
import { isBinOpFuncName } from "./ast"
// The extern manifest: parsed in any module, declared here, imported by the emitter.
import {
  extDeclLink,
  extDeclPos,
  extDeclSig,
  extDeclVl,
  extNames,
  extPoss,
  extSigs,
  externArityAt,
  externCount,
  externDeclCount,
  externLinkOf,
  externNameAt,
  externParamAt,
  externRetAt,
} from "./ast"
// The parser's spelling tree — what `parseTypeName` saw, before it concatenated it into a
// name. `tsToTy` resolves from this instead of re-parsing the concatenation.
import { PIN_ANON, PIN_NONE, PIN_SIGKEY } from "./ast"
import {
  TS_APP,
  TS_ARR,
  TS_ERR,
  TS_FIELD,
  TS_FUNC,
  TS_ISECT,
  TS_LITNUM,
  TS_LITSTR,
  TS_MAP,
  TS_METHOD,
  TS_NAME,
  TS_NEG,
  TS_NULL,
  TS_OBJ,
  TS_PAREN,
  TS_UNION,
  annTsOf,
  clearAnnTs,
  clearUdTs,
  declBoundOf,
  declGpBaseOf,
  declGpParamsOf,
  fnHasTpBound,
  fnTpBoundOf,
  isBodyTyDecl,
  tsKidCount,
  tsKidStart,
  tsKids,
  tsKind,
  tsText,
  tsToName,
  udTsRootAt,
} from "./ast"
import {
  SYM_MEM_METHOD,
  isvalCol,
  isvalLine,
  isvalLit,
  isvalName,
  isvalTok,
  isvalType,
  rcoalCol,
  rcoalLine,
  rcoalTok,
  rcoalType,
  redunECol,
  redunELine,
  redunName,
  redunSCol,
  redunSLine,
  redunTok,
  redunType,
  scopeResKind,
  scopeResName,
  scopeResType,
  symBindKind,
  symBindNode,
  symBindType,
  symEnabled,
  symMemCol,
  symMemEndCol,
  symMemLine,
  symMemNode,
  symMemTy,
  symOccDecl,
  symOccIsDecl,
  symOccTok,
  symOccTy,
  symVisEC,
  symVisEL,
  symVisKind,
  symVisName,
  symVisNode,
  symVisSC,
  symVisSL,
} from "./check_state"

// The pure character grammars over a type-name string live in `compiler/tyname.vl`, a leaf
// with zero imports. Nothing re-exports them — no `export … from "./tyname"` line stands
// in the tree — so every consumer is one hop from the home and this is a plain `import`.
// Background: `docs/internals/destringify-types-program.md`.
import {
  annGenAppSpanEnds,
  arrElemNameRaw,
  demangleSpelling,
  fieldNameOf,
  fieldTypeTextOf,
  fnParamsTextOf,
  fnRetTextOf,
  gaeArgsTextOf,
  gaeHeadNameOf,
  gaeLtAt,
  groupInnerOf,
  listElemNameOf,
  mapSpellKeyEnd,
  mapSpellKeyName,
  mapSpellValName,
  nameIsArray,
  nameIsBareIdent,
  nameIsBraceSpanEnds,
  nameIsFuncTypeAtom,
  nameIsMapOpen,
  nameIsMapSpanEnds,
  nameIsParenOpen,
  nameIsParenSpanEnds,
  nameIsQuotedLeaf,
  nameMentionsIdent,
  parenEnclosesWhole,
  spanEqAt,
  splitUnionAtoms,
  tyTopIndexOf,
  tyTopLevelSplit,
  unionMemberCount,
} from "./tyname"
// The generic AST child walker, shared with the lint pass rather than duplicated: the
// write-effect summary behind the aliased-write invalidation needs the same total
// traversal the lint rules do, and a second copy is a second thing to keep in step with
// the node roster.
import { nodeChildren } from "./ast"

// ── type-arena variants ──────────────────────────────────────────────────────
// One struct per type kind, prefixed field names so `is` discriminates the union (the
// AST's convention). A nested type is always an `i32` index into `T.tys`.

// The primitive vocabulary: a closed set spelled in the source, so every
// `primName == "i32"` is an `i32.eq` against an interned atom and a name outside the set
// is a hard type error rather than a silently false comparison.
export type PrimName = "i32"
  | "i64"
  | "f32"
  | "f64"
  | "boolean"
  | "string"
  | "void"
  | "null"
  | "never"
  // A storage type, not a value type — the one member of this union that may not appear
  // as the type of a local, param, return, binding, map value, union member or generic
  // argument. See `TY_U8`.
  | "u8"

// A primitive.
export type TyPrim = { primName: PrimName }
// The error/unknown type — produced on a type failure so checking continues without
// cascading; assignable to and from anything. `errKind` is write-only and exists only
// because `is` discriminates the arena union on field names, so the variant needs one
// field to be distinguishable; an `i32` carries that for no allocation.
export type TyErr = { errKind: i32 }
// A structural object: parallel arrays of field names and their type-arena
// indices. (Constructed by the harness to seed object-typed bindings; the parser
// subset has no object-type literal syntax yet, so it is not built from source.)
export type TyObj = { objFieldNames: string[], objFieldTypes: i32[] }
// A function: parameter type indices and a return type index.
export type TyFunc = { fnParamTypes: i32[], fnRet: i32 }
// A union `A | B | …`: member type-arena indices.
export type TyUnion = { uMembers: i32[] }
// A nullable `T?` / `T | null`: the inner type-arena index.
export type TyNullable = { nInner: i32 }
// A growable array `T[]`: the element type-arena index (`-1` for an empty `[]`
// whose element is not yet known — assignable to any array, like a hole).
export type TyArray = { aElem: i32 }
// A string-keyed map `{[K]: V}` or a set over it: key and value type-arena indices (`-1`
// for the holes of a bare `Map()`/`Set()`, pinned by the binding annotation or the first
// `.set`/`.add`). `mSet` is 1 for the set flavor, which is internally a boolean-valued map
// but exposes only `.add`/`.has`/`.delete`/`.length`/`.values()`.
export type TyMap = { mKey: i32, mVal: i32, mSet: i32 }
// A generic type parameter (`T` in `function id<T>(x: T): T`): opaque inside the generic
// body (assignable both ways, like the err hole); at a call site each TyVar param binds to
// its argument's type and the return substitutes through.
export type TyVar = { tvName: string }
// The literal-member vocabulary — a closed set, so every producer is a literal
// `mkLitTy("str"/"int"/"flt", …)` and a member outside it is a hard type error.
export type LitKind = "str" | "int" | "flt"

// The comparability vocabulary — which lowering a `==`/`!=` operand's rep takes. `""` and
// `"none"` are different answers and both are load-bearing: the checker rejects `"none"`
// (`has no lowering`) while `""` means "not a niche", so absence is not folded into one.
export type EqCmpKind = ""
  | "str"
  | "scalar"
  | "closure"
  | "struct"
  | "none"
  | "list"
  | "strlist"
  | "reflist"
  | "glist"
  | "nulglist"
  | "nulstr"
  | "nulclosure"
  | "nulstruct"
  | "nullist"
  | "nulstrlist"
  | "nulreflist"

// A literal type: a single-inhabitant type (`"a"`, `0`, `1.5`), the member unit of a
// literal union. `litText` is the raw characters between the quotes for "str" (escapes
// unresolved — annotation and literal expression carry the same raw lexeme, so membership
// compares consistently), the numeric lexeme for "int"/"flt".
export type TyLit = { litKind: LitKind, litText: string }
// A negation `!T` — "anything but `T`". Almost always consumed by `intersectTy`
// (`A & !B` subtracts); a residual standalone negation accepts any source not assignable
// to its inner type.
export type TyNeg = { negTy: i32 }

// The unified type. Declared after its members (a union alias can't forward-
// reference). Discriminated with `is`, exactly like the AST `Node`.
export type Ty = TyPrim |
  TyErr |
  TyObj |
  TyFunc |
  TyUnion |
  TyNullable |
  TyArray |
  TyMap |
  TyVar |
  TyLit |
  TyNeg

// A type diagnostic: a message plus the AST node it is raised at (VL has no exceptions,
// so errors accumulate on `T.diags`). `tline`/`tcol` are the anchor token's source
// position — 1-based line, 0-based column, `0` meaning "no position"; `tcode` is the
// stable category code, `""` for a type-soundness rejection; `tdata` the structured payload.
type TDiag = {
  tmsg: string,
  tat: i32,
  tline: i32,
  tcol: i32,
  tcode: string,
  tdata: string,
}

// The data channel's encoding, documented here and nowhere else: `tdata` is a flat
// sequence of netstrings — `<byte-length> ":" <bytes> ","` — read as alternating key and
// value. The length is authoritative, so a value may hold any byte and nothing is escaped
// or order-dependent; a repeated key is the list. Decoder: `compiler/diagnostics.ts`.
function diagDataField(key: string, val: string) {
  i32ToStr(key.length) +
    ":" +
    key +
    "," +
    i32ToStr(val.length) +
    ":" +
    val +
    ","
}

// The stable category code for emitter-capability rejections: the construct is type-valid
// but codegen cannot lower it yet. Machine-distinguishable from a type-soundness verdict
// (the LSP reads it through `diagCodeLen`/`diagCodeByte`), yet still an error — a program
// that cannot build must not pass `vl check`.
const CODE_UNSUPPORTED_LOWERING = "unsupported-lowering"

// D1230 — a bare category code whose answer rides the data channel
// (`ufcsNotImportedData`): `member` (the property as written), `modules` (one field per
// candidate module, spelled as the file can write it today, dependency-first, deduplicated)
// and `recv` (the receiver type, demangled). A quick-fix reads the keys, never the sentence.
const CODE_UFCS_NOT_IMPORTED = "ufcs-not-imported"

// D1570 — the name is a function in scope and is not a method. Its answer rides the data
// channel under `member`, `recv`, `reason` (`self-name` / `arity` / `receiver`: which gate
// refused), `param` (the first parameter's declared name, `self-name` only) and
// `declLine`/`declCol` — that parameter's position in its declaring module, `0` when none.
const CODE_UFCS_NOT_METHOD = "ufcs-not-method"

// D1588 — a constant range descriptor that cannot complete as written. Its answer rides
// the data channel under `from`/`to` (the folded bounds, decimal; absent when a bound is
// not constant) and `step` (the folded step, `1` when defaulted). A quick-fix reads
// `step`: a non-zero one flips sign, a `0` has no such fix; it never parses the sentence.
const CODE_RANGE_NEVER_RUNS = "range-never-runs"

// ── checker state (one struct, held in the global `T`) ───────────────────────

// `tys` is the type arena; `scopes` the scope chain of `name → type-index` maps (index 0
// global, innermost-wins lookup, a block or function pushing and popping its own); `diags`
// the accumulated diagnostics; `curRet` the enclosing function's return type while its
// body is checked, `-1` outside any function.
export type Checker = {
  tys: Ty[],
  scopes: {[string]: i32}[],
  diags: TDiag[],
  curRet: i32,
}

// The single checker instance. The harness calls `initChecker()` then the entry
// point `checkProgram(root)` and reads `T.diags`.
export let T: Checker = { tys: [], scopes: [], diags: [], curRet: -1 }

// The `initChecker` then `checkProgram` protocol, enforced rather than stated: every table
// `checkProgram` fills is emptied in `initChecker`, so a second walk on an unarmed instance
// reads the previous program's rows. `initChecker` arms this, `checkProgram` consumes it,
// and consuming it when it is already clear is an `internal:` diagnostic, never a trap.
let checkerArmed = false

let symDeclScope: {[string]: i32}[] = []

// The open-scope span stack, pushed and popped in lockstep with `symDeclScope`: the top is
// the span of the scope a `symDecl` binds into, and a narrowing-only scope pushes a
// full-file sentinel. `SCOPE_EOF` is past any real source line, so the global scope holds
// every in-file position while staying the loosest, and an inner scope always shadows it.
const SCOPE_EOF = 1000000000
let scopeSL: i32[] = []
let scopeSC: i32[] = []
let scopeEL: i32[] = []
let scopeEC: i32[] = []

// `cUserTypes` — declared struct/union types, `name → type-arena index`, built in a
// pre-pass over the program's `type` declarations so a struct name in an annotation or in
// a later struct's field resolves. A module global rather than a `Checker` field because
// the emitter handles a bare-map global but not a bare-map struct field. `initChecker` resets it.
export let cUserTypes: {[string]: i32} = Map()

// ── arena-mutation generations (the emit-side `repOf` memo invalidation) ─────

// `tyMutEpoch` advances on every in-place mutation of an existing `T.tys` entry — any
// event that can change a type's canonical structural key (`repCanonKey`, `emit_rep.vl`),
// whose memos are stamped with it. A bump is always safe and a missed one is a soundness
// bug; minting a new index needs none. `cUserTypesVer` does the same for `cUserTypes` writes.
export let tyMutEpoch = 0
export let cUserTypesVer = 0

// Generic type aliases: a parameterized `type Box<T> = { value: T }` registers here and not
// in `cUserTypes`, having no concrete type until applied. Parallel per-alias arrays of base
// name and `TypeDecl` node, whose fields are re-resolved per application under a type-param
// binding environment; applications memoize into `cUserTypes` under `Box<i32>`.
let gaNames: string[] = []
let gaDeclIxs: i32[] = []

// D-GAPARAM — the declared type-parameter names, as a flat column plus a (start, count)
// slice per alias, the shape the spelling arena uses for its kids. `parseTypeDecl` folds
// the parameter tokens into the declared name, so the `<` scan and slice happen once here
// at registration and the binding loop reads `gaParamNames[start + k]` directly.
let gaParamNames: string[] = []
let gaParamStart: i32[] = []
let gaParamCount: i32[] = []

// The type-param binding environment consulted by `nameToTy` (innermost last): a generic
// function's `<T>` names bind to their TyVars while its annotations resolve
// (`resolveAnnot`), and an alias application's params bind to the argument types while the
// alias body resolves (`applyGenAlias`).
let tpEnvNames: string[] = []
let tpEnvTys: i32[] = []

// ── constraints phase 1: the bound environment and the coherence ledger ──────

// `cBoundDecls` — every `type Showable = { toString(): string }` in the program, name → the
// declaration's bound-body annotation node. Registered in pass 0a instead of `cUserTypes`:
// a bound constrains a type parameter and has no values, so it is not a type, and
// `declaredTyOfName` turns a value-position use into a sentence rather than into a struct.
let cBoundDecls: {[string]: i32} = Map()

// `tpBound*` — the bounds live while a bounded body is checked, pushed beside the `tpEnv`
// stack by `checkFuncDeclNode` and popped with it. A separate stack rather than a third
// `tpEnv` column because `tpEnv` is pushed from four places and only the body can host a
// member access on a `T`, so aligning a third column at the other three buys nothing.
let tpBoundNames: string[] = []
let tpBoundAnns: i32[] = []

// The bound annotation live for type-parameter `name`, or -1 — innermost wins, so
// a nested generic's `<T>` shadows an enclosing one exactly as `tpEnvTyOfName` does.
function tpBoundOfName(name: string) {
  let i = tpBoundNames.length - 1
  while i >= 0 {
    if tpBoundNames[i] == name { return tpBoundAnns[i] }
    i = i - 1
  }
  -1
}

// ── the coherence ledger ─────────────────────────────────────────────────────

// One row per (generic function, instantiation type, bound member) some site resolved; a
// second site resolving the same key to a different witness is the refusal, and it names
// both sites. The key is `tyToStr` — `tyEq`'s exact string equivalent, nominality folded
// in — never an arena index, which is append-only, nor the emit-side `canon`/`tyToEmitName`.
let cohKeys: string[] = []
let cohWitness: string[] = []
let cohSiteLine: i32[] = []
let cohSiteCol: i32[] = []

// Demanded hole shapes: a member access on an inference-hole param (`self.x` where `self`
// is the hole `?add.0`) records field `x` on the hole's demanded shape, a TyObj that grows
// one derived hole (`?fld.x.?add.0`) per accessed field. Each call site checks its argument
// against the shape, and `substTyDeep` resolves the derived holes against the bindings.
let holeShapeNames: string[] = []
let holeShapeTys: i32[] = []
// Hole names the body indexed (`self[i]`), so the hole demands an array: the call site
// rejects a non-indexable scalar argument bound to such a param (`head(5)` where the body
// read `self[0]`).
let holeArrayDemand: string[] = []
// Hole names whose body applied an `as` cast to the hole itself (`a as i32`), one row per
// cast site. Both type-level obligations — a bare `as` needs a declared home for what it
// propagates, and `as?` yields `T | null` exactly when the cast can fail — are decided from
// the operand's type, which a hole does not carry, so the pinning call site re-asks them. D1342.
let holeCastNames: string[] = []
// The cast's mode ("prop" / "trap" / "null"), its target arena row and spelling, the node,
// and `T.curRet` as seen at the cast — the enclosing return the propagation must fit, which
// by the time the call is checked may have been inferred into something the cast never saw.
let holeCastMode: string[] = []
// The operand's own ident, which must be the parameter's name at the call site: a hole read
// through anything else (`const b = a ?? 0`) carries a type the pin does not describe.
let holeCastVar: string[] = []
// `<holeName>.<ident>` for every hole binding the body assigns to — a write replaces the
// value the call site's pin describes, so a cast on it afterwards has no adjudicable operand.
let holeCastClob: string[] = []
let holeCastTgtTy: i32[] = []
let holeCastTgtName: string[] = []
let holeCastIx: i32[] = []
let holeCastRet: i32[] = []
// D1371 — the parked cast's argument destination: the parameter position and the concrete
// type the body handed the cast's value to, or -1 when it went somewhere else. The body
// validated that hand-over at the pre-pin type, so the pin is the first moment the
// operand's type exists and is where the compare has to be asked again.
let holeCastArgN: i32[] = []
let holeCastArgExp: i32[] = []
let holeCastArgIx: i32[] = []
// Hole names whose body used the map/set surface (`self.set(k, v)`, `.get`, `.has`,
// `.delete`, `.add`, `.keys()`, `.values()`), so the hole demands a map; the parallel
// `holeMapTys` entry is that map — an open `{[?]: ?}` the body's own operations pin in
// place. The map dual of `holeArrayDemand`, carrying a type rather than only a flag.
let holeMapNames: string[] = []
let holeMapTys: i32[] = []

// Alternative hole constraints contributed by an `is` guard over the hole itself: the
// tested types are alternatives, not extra fields, so the call-arg check accepts an
// argument satisfying the demanded shape or one of them. `holeAltPreN[k]` counts the shape
// fields reached before the guard, `holeAltTailN[k]` those at its end, -1 when it diverges.
let holeAltNames: string[] = []
let holeAltTys: i32[] = []
let holeAltPreN: i32[] = []
let holeAltTailN: i32[] = []
// The arena index of the hole each alternative constrains, the same hole `holeAltNames[k]`
// names. `mkGuardedRetTy` needs a handle on that hole, not just its name, to build a
// guarded-member derivation whose base points at it.
let holeAltHoleIx: i32[] = []

// ── derived-hole derivations ─────────────────────────────────────────────────

// A derived hole names a read off another hole — field-of, return-of, element-of,
// guarded-alternative-of, binop-of — held as one row per derivation: `hdKind`, `hdField`
// (the property, or the operator for `HD_BINOP`), `hdInner`/`hdAlt`, `hdBase` (the hole
// read from) and `hdDepth` (the re-basing budget). The minted name stays the hole's identity.
const HD_FLD = 0
const HD_RET = 1
const HD_ELEM = 2
const HD_GALT = 3
const HD_BINOP = 4
// The guard's complement: the hole minus the type an `is` tested for, which is what the
// else arm of `if a is T` reads. `subtractTy` cannot answer at a hole — there is no member
// list to remove from — so the remainder is deferred to the pin. D1243.
const HD_GNOT = 5
let hdKind: i32[] = []
let hdField: string[] = []
let hdInner: i32[] = []
let hdAlt: i32[] = []
let hdBase: i32[] = []
let hdDepth: i32[] = []
// Arena index → derivation row, grown on demand: a derived hole's arena index is dense
// enough in practice that a sparse `i32` sidecar beats a scan. `-1` or past the end means
// not a derived hole.
let hdRowOfTy: i32[] = []

// The `is`-guard alternative rows (indices into `holeAlt*`) whose then-branch is currently
// being checked. A `return` inside one is reached only by an argument that satisfies the
// alternative, so the type it contributes to the inferred return is recorded as a guarded
// member (`?galt.`, see `mkGuardedRetTy`) rather than an unconditional one; innermost wins.
let guardAltStack: i32[] = []

// Unions minted by `joinTys` that carry at least one hole member. `substTyDeep` re-folds
// such a union under a call's bindings (`refoldJoinUnion`): members that resolve are
// re-joined, and one still unresolved is dropped once some member did, naming a branch the
// pinned argument can never reach. Without the re-fold `A | B` surfaces where one arm is live.
let joinHoleUnions: i32[] = []

// The uncollapsed deferred join a call site could not decide, parked under that call's node
// index. `collapseDeferredJoin` hands the emitter-safe collapse out as the call's type — a
// deferred join has no runtime shape — but that collapse is lossy, so the return-inference
// path reads the parked join back (`inferRetTyOf`). Only that path reads it.
let dJoinNode: i32[] = []
let dJoinTy: i32[] = []

// Deferred joins that escaped a call site lossily — the collapse handed out one arm while the
// join still named holes this site could not pin. Parallel arrays: the uncollapsed join, the
// call node to anchor a diagnostic on, and the callee's name. `validateEscJoins` re-folds each
// at the pinning call and rejects loudly when the arms really do disagree.
let escJoinTy: i32[] = []
let escJoinIx: i32[] = []
let escJoinWho: string[] = []

// Deferred binary-op constraints over un-annotated-param holes: with a hole operand, `a + b` /
// `s + "!"` / `n < 2` cannot be decided in the body, a hole being permissively assignable to
// both string and numeric. Record `(lt, op, rt)` as arena type indices; the generic call site
// re-validates each under the substituted argument types via `binOpDefinedFor`.
let binCstrLt: i32[] = []
let binCstrOp: string[] = []
let binCstrRt: i32[] = []
// The `FuncDecl` node that owns each constraint — the body recording it, or -1 at module
// scope. Without it the list is keyed on the TyVar name alone and every generic in the program
// shares one namespace, so an unrelated generic's refusal fires at a call that never adds or
// compares. `validateBinCstrs` / `binCstrsHold` filter on it, falling back to the whole list at -1.
let binCstrFn: i32[] = []
// The `FuncDecl` node whose body is being checked, innermost last — the owner stamped onto each
// recorded constraint. Only top-level registered decls are pushed (`fnDeclIx`), so a constraint
// recorded inside a nested lambda is owned by the enclosing named function, which is the decl a
// call site can name.
let cstrOwnerStack: i32[] = []
// How much a call site knows about its callee, for `cstrOwnedBy`: a declared callee is its own
// node index; `CSTR_NODECL` is a name with no declaration (a closure parameter called inside a
// generic body); `CSTR_ANYFN` is no callee at all (a function value instantiated from its type
// by `genericFnAssignable`).
const CSTR_NODECL = -1
const CSTR_ANYFN = -2

// Deferred call-argument constraints over un-annotated-param holes: inside a generic body a
// hole flowed as an argument into a concrete parameter (`function f(x) { g(x) }` with
// `g(n: i32)`). The body cannot judge it, so the demand is recorded (hole type, expected param
// type, callee name) and the generic call site re-validates it under the substituted types.
let argCstrAt: i32[] = []
let argCstrExp: i32[] = []
let argCstrWho: string[] = []

// D401 — deferred `print` constraints over un-annotated-param and type-parameter holes.
// `print` takes one value of `printDomainStr()`, and the two floors that say so
// (`tyPrintsAsRef`, `tyPrintsAsUnionBox`) both answer false at a hole, so the body admits the
// call. Record the printed type and the argument node; the pin re-asks both floors substituted.
let printCstrTy: i32[] = []
let printCstrIx: i32[] = []
let printCstrFn: i32[] = []

// D1470 — every `__array_new_default__(n)` call, its node and the array-hole row it returned.
// `array.new_default` writes each slot's zero, so the element type is decided by what pins the
// hole and neither answer exists where the call is checked. `flushUninferred` defaults an
// unpinned hole to `i32`; `checkArrayNewDefaultElems` refuses a pinned element with no zero.
let arrDefCallIx: i32[] = []
let arrDefCallTy: i32[] = []

// D1470 — two open array holes that met at a store (`b = a` between two un-annotated bindings,
// and every other position `constrainEmpty` covers). Neither pins the other, and a later use
// pins only one of the two rows, so a default applied to the other would silently disagree.
// Recorded as an unordered pair and read by `arrDefHoleToI32` before it reaches for `i32`.
let holeLinkA: i32[] = []
let holeLinkB: i32[] = []

// D551 — deferred return-type constraints, the declared return re-asked at the pin because
// neither layer owns the question in the body: `assignable(T, V)` is vacuous over a hole, and
// `substTyDeep` hands the declared return out without comparing it against the body type. The
// answer is `assignableExpr` on the substituted pair — the same function the body asked.
let retCstrGot: i32[] = []
let retCstrWant: i32[] = []
// The returned expression's node — the handle `assignableExpr` needs at the pin, not a position
// for the diagnostic (that is the call, like every other pin report).
let retCstrIx: i32[] = []
let retCstrFn: i32[] = []
// D571 — which side carries the hole, 1 for the declared side alone. The two are not
// one constraint: a hole on the body side sits under a concrete declaration the author can
// name, so `return x as A1` is writable and the pin holds the author to it, while a hole on the
// declared side alone is a destination with no cast to write. Only that column is exempt below.
let retCstrWOnly: i32[] = []

// ── the destination seam ─────────────────────────────────────────────────────

// D572 — the mirror of `retCstrGot` one node over: every other place a value lands inside a
// generic body (a local declaration, a re-assignment, a struct-field write, an element write).
// A separate table because `validateRetCstrs` cannot see these — in `const r: T = n + 1` the
// i32 enters at the `const`, where `assignable(i32, T)` is vacuous. No newtype exemption here.
let letCstrGot: i32[] = []
let letCstrWant: i32[] = []
// The source expression's node — the handle `assignableExpr` needs at the pin, not a position
// for the diagnostic (that is the call, like every other pin report).
let letCstrIx: i32[] = []
let letCstrFn: i32[] = []
// The binding's name, or "" for a destination that has none of its own. It selects which of the
// two direct spellings' sentences the pin repeats: a declaration says `cannot assign i32 to 'r'
// of type string` and can also say the object-literal-into-a-map and lossy-numeric forms; a
// write to an already-declared place says only `cannot assign i32 to string`. `letAssignMsg` forks.
let letCstrName: string[] = []

// D582 — deferred builtin-method argument constraints, for the one reason `argCstr*` cannot
// serve this position: that table is adjudicated against a callee it can name, and a builtin
// method has no `FuncDecl` at all. Its argument check is the builtin's own arm, and inside a
// generic body every one of those arms is vacuous. `bmArgMsg` and `bmArgPred` are its one home.
let bmCstrGot: i32[] = []
let bmCstrWant: i32[] = []
// The type the sentence needs that is neither side of the comparison: the receiver array for
// `push` (`cannot add i32 to string[]`), the other bound for a string `slice`. -1 when the form
// does not use one. Substituted at the pin like the two real sides.
let bmCstrCtx: i32[] = []
// The argument expression's node — the handle `assignableExpr` / `nomSlotAccepts` need at the
// pin, not a position for the diagnostic (that is the call, like every other pin report).
let bmCstrIx: i32[] = []
let bmCstrFn: i32[] = []
let bmCstrForm: i32[] = []
let bmCstrLabel: string[] = []

// The sentence forms, one per (wording, predicate) pair the fourteen arms use. Separate values
// even where two share a wording — `set`'s key retries the newtype rule while its value asks
// the expression predicate — so `bmArgPred` keys off the form alone and the two can never be
// confused for each other.
const BM_PUSH = 0
const BM_SETVAL = 1
const BM_SETKEY = 2
const BM_ADDKEY = 3
const BM_KEYMUST = 4
const BM_INDEXMUST = 5
const BM_BOUNDMUST = 6
const BM_EXPECTSA = 7
const BM_IDXPHRASE = 8
const BM_BYTEOFF = 9
const BM_BOUNDS0 = 10
const BM_BOUNDS1 = 11

// D691 — deferred receiver-classification constraints. `checkMemberNode`'s `TyVar` arm admits
// `.length` on every type variable and `checkIndexNode`'s admits `x[i]`, both deliberately: a
// `T` pinned to a list / string / map / set has both, and refusing them in the body refuses
// every rep that works. This table re-asks at the pin, in `memberFloorMsg`/`indexFloorMsg`'s words.

// D1431 — `memCstrDem` separates the two things a row can ask, because they refuse in different
// words. A `.length` / `x[i]` row asks a classification (is this rep a collection at all) and
// keeps the direct spelling's sentence; a row from an unbounded `<T>`'s member read asks a
// demand and refuses in the inference hole's words. Stored, not sniffed off `memCstrProp`.
let memCstrTy: i32[] = []
let memCstrProp: string[] = []
let memCstrIx: i32[] = []
let memCstrFn: i32[] = []
let memCstrDem: boolean[] = []

// D1005 — deferred UFCS-receiver constraints, the receiver's half of what `memCstrTy` asks.
// `ufcsCallTy` gates dispatch on `assignable(recvTy, params[0])`, true for a `TyVar` on either
// side, so a generic body selects by name alone. `ufcsCstrP0` banks the selected function's
// parameter-0 type; the pin asks `tyFieldTyOf` first, a callable field of that name winning.
let ufcsCstrTy: i32[] = []
let ufcsCstrProp: string[] = []
let ufcsCstrIx: i32[] = []
let ufcsCstrFn: i32[] = []
let ufcsCstrP0: i32[] = []

// D1230 — the missing-import answer, banked at the callee member node by the call site that
// computed it and read back by the member arm that raises the sentence: only the call knows the
// argument count deciding whether a candidate's arity fits, only `checkMemberNode` reaches the
// arm that names the receiver. `ufcsMissSpecs[i]` is the `,`-joined list; a node is banked once.
let ufcsMissAt: i32[] = []
let ufcsMissSpecs: string[] = []

// D1570 — the "the function exists and is not a method" answer, banked the same way and for the
// same reason: the call knows the argument count, the member arm raises the sentence. The
// message is banked rather than the ingredients `ufcsMissSpecs` banks, because three arms of one
// mirror produce it and re-deriving the arm at the raise would be the ladder written twice.
let ufcsWhyAt: i32[] = []
let ufcsWhyMsg: string[] = []
let ufcsWhyData: string[] = []

// Solved un-annotated parameter types — the parameter's own body usage, read back as its type.
// A hole is permissively assignable both ways, so a usage that requires a concrete type rejects
// nothing in the body and leaves the parameter's rep to whatever the call's argument supplied.
// Solving the hole to what its usage demands makes it match the annotated spelling exactly.
let solvedParamTys: {[string]: i32} = Map()
// D1412 — the pin a hole took at the call that resolved it, keyed by the hole's own name: the
// un-softened arena type the emitter's literal complement cannot re-derive, since the union
// registry renders `i32 | "err"` as `i32|string`. `-2` marks a hole two calls pinned
// differently — one wasm function serves both, so the reader must decline to narrow.
let holePinTys: {[string]: i32} = Map()
// Declarations whose solve has been attempted, keyed by decl node index — a body is probed at
// most once, whether or not the probe found anything to solve.
let paramSolveTried: {[string]: boolean} = Map()
// Hole → concrete destination, recorded only while `paramSolveProbe` is set. `assignableExpr`
// is the one seam every binding / argument / return / field / element / store flows through, so
// a single hook there sees every such usage.
let holeFlowSrc: i32[] = []
let holeFlowDst: i32[] = []
let paramSolveProbe = false

// The const-binding chain, parallel to `T.scopes`: each frame records which of its names carry
// `const` — an immutable name, not immutable data, so a field write through a const stays
// legal. Kept module-level rather than a `Checker` field so the exported struct shape is
// unchanged.
let constScopes: {[string]: boolean}[] = []

// The function-declaration chain, parallel to `T.scopes`: each frame records the arena node of
// every `FuncDecl` declared in it. `fnDeclIx` answers that for top-level functions only; this
// answers it for a nested one too, under the scope chain's shadowing rule, which is what a call
// needs to recover the callee's parameter list and the defaults a call site may omit.
let fnDeclScopes: {[string]: i32}[] = []

// The function-alias chain, parallel to `T.scopes`: for a binding whose initializer is a bare
// ident naming a declared function (`const f = addT`), the arena node of that declaration.
// `fnDeclScopes` deliberately answers -1 there, a function value keeping the exact-arity gate a
// value call has. Its one consumer is constraint ownership; a closure parameter is left out.
let fnAliasScopes: {[string]: i32}[] = []

// D1048 — the collapsed-binding marks: bindings whose declared type dropped a subsumed literal
// arm, and function declarations whose declared return did. Read at an `is <literal>` to decide
// whether the test is a tag test or a value compare. Depth-tagged sparse rows: `popScope` drops
// the rows it retires, and a read pairs the row's depth with `lookupDepth`, so shadowing works.
let collBindDepth: i32[] = []
let collBindName: string[] = []
// The `FuncDecl` nodes whose return annotation collapsed. Module-scoped rather than
// depth-tagged: a decl node is unique for the whole program, and pass 1 hoists every top-level
// signature before any body runs, so a forward call is already covered.
let collRetFnNodes: i32[] = []

// D1609 — the un-annotated object-literal bindings: names a `let`/`const` binds, with no type
// annotation, to an object literal. The nested-width-pair exemption asks which binding a source
// name resolves to, and only a scope answers that; a whole-arena name scan takes an unrelated
// function's binding. Depth-tagged sparse rows, read through `lookupDepth` exactly like `collBind`.
let objLitBindDepth: i32[] = []
let objLitBindName: string[] = []

// The un-inferred empty-collection floor: an un-annotated empty `[]` / `Map()` / `Set()` whose
// element/key/value hole is never pinned — by an annotation or a downstream `.push`/`.set`/
// `.add` — has a genuinely unknown type, and a later use may still pin it, so the question
// waits. `flushUninferred(depth)` grades each at scope close: a still-open hole needs an annotation.
let pendNames: string[] = []
let pendTys: i32[] = []
let pendAts: i32[] = []
let pendDepths: i32[] = []

// D1591 — empty-collection holes delivered to an inferred return. At a declared return
// `constrainEmptyExpr` pins on the spot; under inference the destination is the join of every
// return and is not final until the body ends. `irhMarks` scopes the recorded rows to one body,
// and `irhConcrete` banks the first concrete witness, since the join can keep the open side.
const irhExprs: i32[] = []
const irhTys: i32[] = []
const irhMarks: i32[] = []
const irhConcrete: i32[] = []

// D1576 — the never-filled A-infer-null hole. `let x = null` binds `mkNullableTy(-1)` and the
// first non-null assignment fills the inner in place, so at the declaration nobody can say
// whether the binding is `T | null` or just `null`. `flushUninferred` re-reads `nInner` at scope
// close; a hole still open there has type `null`, whose rep is `nullref`.
let nhPendIxs: i32[] = []
let nhPendTys: i32[] = []
let nhPendDepths: i32[] = []
let nhUnfilledIxs: i32[] = []

// D1589 — a `??` typed against an open hole is a promise, not an answer: `x ?? d` read before
// the fill takes `nonNullTy` of a `nInner == -1` nullable, which is the hole itself. These
// arrays hold the `??` node, the hole's arena index and the answer handed back at the read;
// `fillCoalHoleNodes` re-derives each against the resolved inner and refuses a fill that differs.
let chPendNodes: i32[] = []
let chPendTys: i32[] = []
let chPendGiven: i32[] = []

// Flow-narrowed property paths: a stack of `key → type-arena index` entries (`"o.v" → i32`)
// overlaid while a branch body is checked, with per-scope frame marks so `popScope` unwinds what
// that scope pushed; bare-name narrowings ride the scope chain instead. `npInvBy` is the
// invalidation slot, written in place, since a shadowing push would resurrect the narrowing.
let npKeys: string[] = []
let npTys: i32[] = []
let npInvBy: i32[] = []
let npEpochs: i32[] = []
let npFrames: i32[] = []

// Post-guard narrowings handed up by an `if` that is itself the else arm of another `if`. Such
// an `if` has no enclosing block of its own — the rest of its block is the rest of the parent's
// — so it cannot `declare` its own fall-through narrowing. The parent consumes these only when
// its own then diverges. Bare names only; pushed in post-order and applied in reverse.
let pgUpKeys: string[] = []
let pgUpTys: i32[] = []

// The node index of the `if` currently being checked as the else arm of a chain, or `-1`. Set
// immediately before `checkNode(n.ifElse)` and read-and-cleared at the very top of
// `checkIfStmtNode`, so only the immediate callee sees it: an `if` nested inside an arm's body
// has a block of its own and declares normally.
let pgUpArmIx = -1

// The place type a trailing chain saw, banked at the instant the post-guard subtraction replaced
// it. `ifChainExhausts` asks whether a chain's arms cover its place's union, and by then the
// chain has already subtracted them, so asking `lookup` is circular. Keyed by the chain head's
// node index — a head that does not post-narrow writes nothing, and a miss falls back to `lookup`.
let pgPreIx = -1
let pgPreKeys: string[] = []
let pgPreTys: i32[] = []

// Cycle-guard stacks for `assignable` over recursive named types: a (src, dst) pair already
// being compared higher in the recursion is assumed assignable — coinductive, so a
// self-referential `left: Tree | null` terminates instead of expanding.
let asgSrcStack: i32[] = []
let asgDstStack: i32[] = []

// Cycle-guard stacks for the generic call-site binding walk (`bindGenWalk`) and the deep
// substitution (`substTyDeep`) — a recursive named type is cyclic in the arena, so both walks
// remember what they are already visiting.
let bgSrcStack: i32[] = []
let bgDstStack: i32[] = []
let stSeenStack: i32[] = []

// Depth guard for `tyToStr` on recursive named types: a cyclic arena shape would otherwise
// render forever — past a fixed depth it prints `…`.
let tyToStrDepth = 0

// The top-level atom width of the render the last `tyToStrAt` returned, produced by the renderer
// rather than re-derived by scanning the finished string: a render gains a top-level `|` at
// exactly two places, the union arm's join and the nullable arm's ` | null` suffix. It exists so
// this renderer can reach `arrElemRender`, the shared array-grouping home, which needs the width.
let tyStrAtoms = 1

// Narrowed bare-name bindings: name → its declared type, banked before a narrowing shadows
// it, with per-scope frame marks. Two kinds ride one bank because one question is asked of both
// — what the storage can hold — and an entry answers only while its own `declare` is the
// innermost binding. `narFnEpoch` counts bodies checked, so a captured narrowing keeps refusing.
const NAR_KIND_ASG = 0
const NAR_KIND_GUARD = 1
// The post-guard fall-through's shadow, banked under a kind of its own. `if r is JsonError
// { return }` narrows the rest of the block by a plain `declare`, with no `NAR_KIND_GUARD` row,
// and the deep-`is` walker needs that shadow banked to spell its parameter with the declared
// union. A third kind, so `narGuardSlot` and dead-`??` keep seeing exactly the rows they had.
const NAR_KIND_POSTGUARD = 2
let narFnEpoch = 0
let asgDeclKeys: string[] = []
let asgDeclTys: i32[] = []
let asgDeclDepths: i32[] = []
let asgDeclKinds: i32[] = []
let asgDeclEpochs: i32[] = []
let asgDeclFrames: i32[] = []

// The scope-chain depth of the innermost binding of `name`, or -1 when undeclared. `lookup` is
// the same walk reading the type out; this one reads the frame it came from, which is what the
// narrowing bank validates its entries against.
function lookupDepth(name: string) {
  let i = T.scopes.length - 1
  while i >= 0 {
    if T.scopes[i].has(name) { return i }
    i = i - 1
  }
  -1
}

// The declared type banked for narrowed `name`, or -1 when no live entry of a matching kind
// still shadows the name. `kind` is `NAR_KIND_ASG` / `NAR_KIND_GUARD`, or -1 for either. Entries
// of the wrong kind are skipped rather than stopping the walk, so a guard narrowing layered over
// an assignment narrowing does not hide it from the assignment-kind question.
function narDeclaredTy(name: string, kind: i32) {
  const d = lookupDepth(name)
  if d < 0 { return -1 }
  let i = asgDeclKeys.length - 1
  while i >= 0 {
    if asgDeclKeys[i] == name && asgDeclDepths[i] == d {
      if kind < 0 || asgDeclKinds[i] == kind { return asgDeclTys[i] }
    }
    i = i - 1
  }
  -1
}

// The declared type of an assignment-narrowed name, or -1.
function asgDeclaredTy(name: string) { narDeclaredTy(name, NAR_KIND_ASG) }

// The bank slot of the live guard-kind narrowing of `name`, or -1. Retirement writes through
// this slot, so it must find exactly the entry `narDeclaredTy` reads.
function narGuardSlot(name: string) {
  const d = lookupDepth(name)
  if d < 0 { return -1 }
  let i = asgDeclKeys.length - 1
  while i >= 0 {
    if asgDeclKeys[i] == name && asgDeclDepths[i] == d {
      if asgDeclKinds[i] == NAR_KIND_GUARD { return i }
    }
    i = i - 1
  }
  -1
}

// Bank `name`'s declared type before a narrowing shadows it, at the scope depth the shadowing
// `declare` writes to. Idempotent per (name, depth, kind): a second `x = e` must not re-bank the
// already-narrowed type as the declaration.
function noteNarShadow(name: string, declTy: i32, kind: i32) {
  const d = T.scopes.length - 1
  let i = asgDeclKeys.length - 1
  while i >= 0 {
    if (
      asgDeclKeys[i] == name &&
      asgDeclDepths[i] == d &&
      asgDeclKinds[i] == kind
    ) {
      return 0
    }
    i = i - 1
  }
  asgDeclKeys.push(name)
  asgDeclTys.push(declTy)
  asgDeclDepths.push(d)
  asgDeclKinds.push(kind)
  asgDeclEpochs.push(narFnEpoch)
  0
}

// True when `ix` names a place whose current non-nullable type came from a narrowing rather than
// from its declaration — the exemption the dead-`??` finding needs, so a defensive `??` inside a
// guard is never reported. A bare name answers from the narrowing bank (either kind); a member or
// index place answers true unconditionally, over-exempting being the safe direction here.
function coalNarrowedPlace(ix: i32) {
  if ix < 0 { return false }
  const n = P.nodes[ix]
  if n is Paren { return coalNarrowedPlace(n.parInner) }
  if n is Ident { return narDeclaredTy(n.identName, -1) >= 0 }
  if n is Member { return true }
  if n is Index { return true }
  false
}

// True when `ix` is a bare name that an assignment narrowed away from a declared type — a place
// whose storage can still hold null even though its current flow type cannot. The null-test
// legality question, and nothing else.
function isAsgNarrowedName(ix: i32) {
  const n = P.nodes[ix]
  if n is Ident { return asgDeclaredTy(n.identName) >= 0 }
  false
}

// Inferred type-guard functions: a named function whose body is exactly
// `return <null-test-on-a-param>` becomes a guard, so calling it in a condition narrows the
// argument's null-ness. Parallel arrays: the guard's name, the tested param's index, and 1 when
// the non-null branch is the then arm (`self != null`), 0 when it is the else (`p == null`).
let guardNames: string[] = []
let guardParamIdxs: i32[] = []
let guardThens: i32[] = []

// Record an A-infer-null hole for the deferred scope-close re-read (D1576).
function noteNullHole(ty: i32, at: i32) {
  nhPendIxs.push(at)
  nhPendTys.push(ty)
  nhPendDepths.push(T.scopes.length - 1)
  0
}

// May a `??` over an open hole answer with its default's type (D1589)? Only for a default that
// is itself a settled non-null type: a nullable default keeps the whole `??` nullable, and a
// hole-bearing or error default has no answer to borrow. Everything else falls through to the
// pre-existing `nonNullTy` path unchanged.
function coalHoleDeferOk(rt: i32) {
  if rt < 0 { return false }
  if rt == TY_ERR { return false }
  if isNullTy(rt) { return false }
  if tyHasHole(rt) { return false }
  const r = T.tys[rt]
  if r is TyNullable { return false }
  true
}

// Record a `??` whose left operand is still an open A-infer-null hole at typing time, with
// the answer it received (D1589).
function noteCoalHole(at: i32, ty: i32, given: i32) {
  chPendNodes.push(at)
  chPendTys.push(ty)
  chPendGiven.push(given)
  0
}

// Re-derive every pending `??` over the hole `ty`, now that its inner is known. Runs at the fill,
// the first moment the answer exists, and validates as much as it re-banks: the read is already
// checked against `given`, so a fill whose inner does not fit is a disagreement to name, not to
// bank over. The derivation is the `??` arm's own tail, re-asked through `assignableExpr`.
function fillCoalHoleNodes(ty: i32) {
  let i = 0
  while i < chPendNodes.length {
    if chPendTys[i] == ty {
      const cn = chPendNodes[i]
      const nd = P.nodes[cn]
      if nd is BinExpr {
        const inner = nonNullTy(ty)
        const dft = nodeTyIxOf(nd.binRight)
        let res = inner
        if dft >= 0 {
          if !assignableExpr(nd.binRight, dft, inner) {
            res = joinTys(inner, dft)
          }
        }
        const given = chPendGiven[i]
        if assignable(res, given) {
          if cn < nodeTyIx.length { nodeTyIx[cn] = res }
        } else {
          tErr(
            "`??` here was typed " +
              tyToStr(given) +
              " — the assignment below makes the binding " +
              tyToStr(ty) +
              ", so the read is " +
              tyToStr(res) +
              "; annotate the binding",
            cn,
          )
        }
      }
    }
    i = i + 1
  }
  0
}

// Is the binding at LetDecl node `letIx` an A-infer-null hole nothing ever filled — a
// `let x = null` / `const x = null` whose only value is `null`? Its type is the `null` type,
// and the emitter reps it `nullref`. Answered only after the declaring scope has closed,
// which is where `flushUninferred` banks it (D1576).
export function letNullHoleUnfilled(letIx: i32): boolean {
  if letIx < 0 { return false }
  let i = 0
  while i < nhUnfilledIxs.length {
    if nhUnfilledIxs[i] == letIx { return true }
    i = i + 1
  }
  false
}

// Record an un-annotated empty-collection binding for the deferred scope-close check.
function notePending(name: string, ty: i32, at: i32) {
  pendNames.push(name)
  pendTys.push(ty)
  pendAts.push(at)
  pendDepths.push(T.scopes.length - 1)
  0
}

// Does type-arena index `ty` still reach an unresolved collection hole — an empty `[]` element
// (`aElem < 0`) or a bare `Map()`/`Set()` key/value (`mKey`/`mVal < 0`) that no annotation and
// no downstream use ever pinned?
function unresolvedHole(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyArray { return t.aElem < 0 }
  if t is TyMap { return t.mKey < 0 || t.mVal < 0 }
  false
}

// Does `ty` reach an unresolved empty-collection hole through struct fields, arrays, maps or
// nullable wrappers — the deep analogue of `unresolvedHole`. It gates `recordRepTyAdopt`: an
// object/array literal carrying such a hole is plainly `assignable` to a concrete destination,
// so the short-circuit would skip the adoption block that records the destination rep.
function tyReachesEmptyHole(ty: i32, depth: i32): boolean {
  if ty < 0 || depth <= 0 { return false }
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem < 0 { return true }
    return tyReachesEmptyHole(t.aElem, depth - 1)
  }
  if t is TyMap {
    if t.mKey < 0 || t.mVal < 0 { return true }
    return tyReachesEmptyHole(t.mVal, depth - 1)
  }
  if t is TyObj {
    let i = 0
    while i < t.objFieldTypes.length {
      if tyReachesEmptyHole(t.objFieldTypes[i], depth - 1) { return true }
      i = i + 1
    }
    return false
  }
  if t is TyNullable { return tyReachesEmptyHole(t.nInner, depth - 1) }
  false
}

// True when `ty` contains a `TyUnion` reachable through struct fields, array elements, map
// values or nullable inners. Gates `recordRepTyAdopt` for the union-softening case: an ObjLit
// field value narrower than a destination union field softens the recorded rep, so a
// same-fieldset twin resolves wrong; re-stamping the rep to the destination corrects it.
function tyReachesUnion(ty: i32, depth: i32): boolean {
  if ty < 0 || depth <= 0 { return false }
  const t = T.tys[ty]
  if t is TyUnion { return true }
  if t is TyArray { return tyReachesUnion(t.aElem, depth - 1) }
  if t is TyMap { return tyReachesUnion(t.mVal, depth - 1) }
  if t is TyNullable { return tyReachesUnion(t.nInner, depth - 1) }
  if t is TyObj {
    let i = 0
    while i < t.objFieldTypes.length {
      if tyReachesUnion(t.objFieldTypes[i], depth - 1) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// Usage-driven inference through a typed context: an empty `[]` / bare `Map()`/`Set()` flowing
// into a slot with a concrete shape (a `T[]` param at a call site, an annotated assignment, a
// `T[]`-returning tail) has its open holes pinned to the destination's, in place. A no-op
// unless the shapes match. Depth-bounded: a recursive struct would otherwise recur forever.
function constrainEmpty(srcTy: i32, dstTy: i32) {
  constrainEmptyD(srcTy, dstTy, 12)
}

// `constrainEmpty` at a position that holds the source expression — the form every site that
// pins and then asks `assignableExpr` must use. The pin erases its own trigger, since
// `recordRepTyAdopt` records a literal's destination rep only while `tyReachesEmptyHole` holds,
// so the recording happens on that same condition and before the pin.
function constrainEmptyExpr(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if !inferQuiet && srcExpr >= 0 && tyReachesEmptyHole(srcTy, 8) {
    recordRepTyAdopt(srcExpr, dstTy, 6)
  }
  constrainEmpty(srcTy, dstTy)
}

// The shapes `constrainEmptyD` descends — a destination witness worth banking for the
// deferred inferred-return pin. A scalar witness would occupy the slot and pin nothing.
function tyPinsEmptyHoles(ty: i32, depth: i32): boolean {
  if ty < 0 || depth <= 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable { return tyPinsEmptyHoles(t.nInner, depth - 1) }
  t is TyArray || t is TyMap || t is TyObj
}

// Open the deferred-pin frame for one function body (D1591). Pushed and popped with the
// body scope, so the rows a nested body records are its own.
function pushInferRetHoles() {
  irhMarks.push(irhExprs.length)
  irhConcrete.push(-1)
  0
}

// Record a value delivered to an inferred return — a `return e`, the body's trailing expression,
// or a tail `if`/`else` arm. One that still reaches an open collection hole becomes a row to
// pin; the first one that does not is this body's destination witness, which is what the rows
// are pinned against at the flush (D1591).
function noteInferRetWitness(srcExpr: i32, srcTy: i32) {
  if irhMarks.length == 0 { return 0 }
  if srcTy < 0 { return 0 }
  if tyReachesEmptyHole(srcTy, 8) {
    irhExprs.push(srcExpr)
    irhTys.push(srcTy)
    return 0
  }
  const top = irhConcrete.length - 1
  if irhConcrete[top] < 0 && tyPinsEmptyHoles(srcTy, 8) {
    irhConcrete[top] = srcTy
  }
  0
}

// Pin every delivery this body recorded against the shape a concrete return witness named, and
// retire the frame. With no such witness nothing is pinned — the program never said what the
// element type is, so the binding keeps its own `cannot infer a type` floor (D1591).
function flushInferRetHoles() {
  if irhMarks.length == 0 { return 0 }
  const top = irhMarks.length - 1
  const mark = irhMarks[top]
  const dst = irhConcrete[top]
  irhMarks.pop()
  irhConcrete.pop()
  let i = mark
  while i < irhTys.length {
    if dst >= 0 { constrainEmptyExpr(irhExprs[i], irhTys[i], dst) }
    i = i + 1
  }
  while irhTys.length > mark {
    irhExprs.pop()
    irhTys.pop()
  }
  0
}

function constrainEmptyD(srcTy: i32, dstTy: i32, depth: i32) {
  if srcTy < 0 || dstTy < 0 || depth <= 0 { return 0 }
  const s = T.tys[srcTy]
  const d = T.tys[dstTy]
  // A nullable destination pins the same holes its inner shape does: a `string[] | null` field
  // or map value accepts a non-null `[]`, and the hole behind it needs the element rep either
  // way. Unwrapped on the source side too, so a nullable producer flowing into a nullable slot
  // lines its inner shapes up rather than stopping at the wrapper.
  if d is TyNullable { return constrainEmptyD(srcTy, d.nInner, depth - 1) }
  if s is TyNullable { return constrainEmptyD(s.nInner, dstTy, depth - 1) }
  if s is TyArray {
    if d is TyArray {
      if s.aElem < 0 {
        // Both sides open is not a pin but a link — `s.aElem = d.aElem` would write the `-1`
        // back and lose the fact that these two rows must agree, which `arrDefHoleToI32` needs
        // once an unpinned hole acquires a default. D1470.
        if d.aElem < 0 {
          noteHoleLink(srcTy, dstTy)
        } else {
          s.aElem = d.aElem
          tyMutEpoch = tyMutEpoch + 1 // in-place element pin — canonical keys change
        }
      } else {
        constrainEmptyD(s.aElem, d.aElem, depth - 1)
      }
    }
    return 0
  }
  if s is TyMap {
    if d is TyMap {
      if s.mKey < 0 {
        s.mKey = d.mKey
        tyMutEpoch = tyMutEpoch + 1 // in-place key pin
      }
      if s.mVal < 0 {
        s.mVal = d.mVal
        tyMutEpoch = tyMutEpoch + 1 // in-place value pin
      } else {
        constrainEmptyD(s.mVal, d.mVal, depth - 1)
      }
    }
    return 0
  }
  // A struct destination pins field-wise, by name. The source is an object literal's own
  // inferred shape, so its field order is the literal's, not the declaration's — matching
  // positionally would pin `{ b: fq(), a: [1] }` from the wrong field.
  if s is TyObj {
    if d is TyObj {
      let i = 0
      while i < s.objFieldNames.length {
        if i < s.objFieldTypes.length {
          const dft = objFieldType(d, s.objFieldNames[i])
          if dft >= 0 { constrainEmptyD(s.objFieldTypes[i], dft, depth - 1) }
        }
        i = i + 1
      }
    }
    return 0
  }
  0
}

// D1470 — an `__array_new_default__` hole that nothing pinned, defaulted to `i32` in place;
// false for every other unresolved hole. `array.new_default` promises the element's zero and
// says nothing about which element, so `i32` is honest here where `const xs = []` is not.
// Asked from `flushUninferred`, after every pin has had its chance.
function arrDefHoleToI32(ty: i32) {
  if !arrDefRowIsCall(ty) { return false }
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem < 0 {
      arrDefPinHoleElem(ty)
      return true
    }
  }
  false
}

// Is `ty` the row an `__array_new_default__` call returned? That membership is the whole licence
// to default an open element to `i32`: it says `array.new_default` already promised every slot
// its zero, which a bare `[]` never did — that hole is genuinely under-determined and gets a
// diagnostic instead. D1470.
function arrDefRowIsCall(ty: i32) {
  if ty < 0 { return false }
  let j = 0
  while j < arrDefCallTy.length {
    if arrDefCallTy[j] == ty { return true }
    j = j + 1
  }
  false
}

// …or one hop from such a row through a recorded hole link, which is what `let b = a` between
// two open bindings leaves behind (`noteHoleLink`): `b`'s row is not the call's, and the default
// it is entitled to arrives through the pair. This is the licence question, not the propagation
// `resolveHoleLinks` performs — a row it cannot reach is exactly a row no pin decided.
function arrDefRowServed(ty: i32) {
  if arrDefRowIsCall(ty) { return true }
  let i = 0
  while i < holeLinkA.length {
    if holeLinkA[i] == ty {
      if arrDefRowIsCall(holeLinkB[i]) { return true }
    }
    if holeLinkB[i] == ty {
      if arrDefRowIsCall(holeLinkA[i]) { return true }
    }
    i = i + 1
  }
  false
}

// D1566 — an operator operand cannot wait for the flush, so it peeks the default rather than
// taking it. Every other position tolerates the in-band `-1` an unpinned element reads back as,
// but the operator arms index `T.tys` with the operand type and `T.tys[-1]` traps the compiler.
// Peeking leaves the row open, so a later store can still decide the element.
function arrDefOperandElemPeek(exprIx: i32) {
  if exprIx < 0 { return -1 }
  let cur = exprIx
  let hops = 0
  while hops < 4 {
    const p = P.nodes[cur]
    if p is Paren {
      cur = p.parInner
      hops = hops + 1
    } else {
      hops = 4
    }
  }
  const e = P.nodes[cur]
  if e is Index {
    const at = nodeTyIxOf(e.idxArr)
    if at < 0 { return -1 }
    const t = T.tys[at]
    if t is TyArray {
      if t.aElem < 0 {
        if arrDefRowServed(at) {
          // The element `arrDefPinHoleElem` would write, read without writing this row: the
          // same link fixpoint it runs (`resolveHoleLinks` propagates only an element some pin
          // already decided, never a default), then `i32` if nothing reached the row.
          resolveHoleLinks()
          const t2 = T.tys[at]
          let el = TY_I32
          if t2 is TyArray {
            if t2.aElem >= 0 { el = t2.aElem }
          }
          // The read's own recorded type, not the row's: `checkNode` banked the `-1` this read
          // answered a moment ago and the emitter reads that, so a stale entry makes
          // `print(a[0] ?? 1)` refuse at emit. The row stays open, so a later store re-decides
          // it.
          if !inferQuiet {
            if cur < nodeTyIx.length { nodeTyIx[cur] = el }
          }
          return el
        }
      }
    }
  }
  -1
}

// The array row an enclosing index store is about to pin, live only while that store's value is
// checked; -1 everywhere else.
let asgOpenElemRow = -1

// The row of an index store's receiver when its element is still open — the row a value in the
// store's own right-hand side may pin. -1 for every other target.
function asgOpenElemRowOf(tgtIx: i32) {
  if tgtIx < 0 { return -1 }
  const g = P.nodes[tgtIx]
  if g is Index {
    const at = nodeTyIxOf(g.idxArr)
    if at < 0 { return -1 }
    const t = T.tys[at]
    if t is TyArray {
      if t.aElem < 0 { return at }
    }
  }
  -1
}

// Pin `asgOpenElemRow`'s open element from a store's value type `vt` when `exprIx` reads that same
// row, and answer the element's value type; -1 when it is some other read. A store whose value
// reads the place it writes (`xs[i] += v`, or that spelled out) has no other moment to pin: the
// read answers `-1`, the operator floor turns that into `TY_ERR`, and the store banks it. D1603.
function asgReadElemPin(exprIx: i32, vt: i32) {
  if asgOpenElemRow < 0 || exprIx < 0 { return -1 }
  if vt < 0 || vt == TY_ERR || vt == TY_VOID { return -1 }
  if tyHasHole(vt) { return -1 }
  const e = P.nodes[exprIx]
  if e is Index {
    if nodeTyIxOf(e.idxArr) != asgOpenElemRow { return -1 }
    const t = T.tys[asgOpenElemRow]
    if t is TyArray {
      if t.aElem >= 0 { return -1 }
      t.aElem = vt
      tyMutEpoch = tyMutEpoch + 1 // the store's own value pinned the element in place
      const el = arrElemValueTy(vt)
      // The read's recorded type too, for `arrDefOperandElemPeek`'s reason: `checkNode` banked
      // the `-1` a moment ago and the emitter reads that entry.
      if !inferQuiet {
        if exprIx < nodeTyIx.length { nodeTyIx[exprIx] = el }
      }
      return el
    }
  }
  -1
}

// D1512 — the one place an unpinned intrinsic hole acquires its element: whatever the link graph
// can still reach (`resolveHoleLinks`, run first), else the `i32` default. Returns the row's
// element after the pin, or -1 when the row is not an array. Both sites that default such a hole
// go through here, so an intrinsic delivered into a plain `v = …` cannot take `i32` on its own.
function arrDefPinHoleElem(ty: i32) {
  if ty < 0 { return -1 }
  resolveHoleLinks()
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem < 0 {
      t.aElem = TY_I32
      tyMutEpoch = tyMutEpoch + 1 // in-place element pin — canonical keys change
    }
    return t.aElem
  }
  -1
}

// Record that the two array rows `a` and `b` must carry the same element. Deduped, because
// one `b = a` inside a loop body is checked once but a repeated store spelling is not.
function noteHoleLink(a: i32, b: i32) {
  if a < 0 || b < 0 || a == b { return 0 }
  let i = 0
  while i < holeLinkA.length {
    if holeLinkA[i] == a && holeLinkB[i] == b { return 0 }
    if holeLinkA[i] == b && holeLinkB[i] == a { return 0 }
    i = i + 1
  }
  holeLinkA.push(a)
  holeLinkB.push(b)
  0
}

// Hand `src`'s resolved element to `dst`'s open one, enforcing the link's own invariant that the
// two rows carry the same element. True when the pin moved, which is what the fixpoint below
// iterates on.
function holeLinkPinFrom(src: i32, dst: i32) {
  if src < 0 || dst < 0 { return false }
  const s = T.tys[src]
  if s is TyArray {
    if s.aElem >= 0 {
      const d = T.tys[dst]
      if d is TyArray {
        if d.aElem < 0 {
          d.aElem = s.aElem
          tyMutEpoch = tyMutEpoch + 1 // in-place element pin — canonical keys change
          return true
        }
      }
    }
  }
  false
}

// D1565 — every link pair, to a fixpoint: a resolved row hands its element to its open partner
// and the sweep repeats until no row moves. A one-hop consult reads a partner that has not
// resolved yet and takes `i32` while the rest of the chain lands on `f64`. A component nothing
// pins is untouched; the bound is structural, since a sweep that changes anything pins a row.
function resolveHoleLinks() {
  if holeLinkA.length == 0 { return 0 }
  const bound = holeLinkA.length * 2 + 1
  let sweeps = 0
  let changed = true
  while changed {
    changed = false
    sweeps = sweeps + 1
    if sweeps > bound {
      // Unreachable by the bound above, and stated rather than assumed: a sweep only ever turns
      // an open element into a resolved one, never back. A named failure beats a `while` that
      // spins, since a hang is the one outcome a checker must never have.
      tErr("internal: __array_new_default__ hole links did not converge", -1)
      return 0
    }
    let i = 0
    while i < holeLinkA.length {
      if holeLinkPinFrom(holeLinkA[i], holeLinkB[i]) { changed = true }
      if holeLinkPinFrom(holeLinkB[i], holeLinkA[i]) { changed = true }
      i = i + 1
    }
  }
  0
}

// D1470 — does the element type `el` have a zero, a default value that is itself a member of
// `el`? The scalars do (`0` / `0.0` / `false`) and nothing else in the language does: `string`
// has no empty default the language recognises, and a struct / variant / closure / map / nested
// list / union / nullable element would get a null or a niche outside its own type.
function elemHasZero(el: i32) {
  const p = primNameOf(el)
  if p == "i32" { return true }
  if p == "boolean" { return true }
  if p == "u8" { return true }
  if p == "f64" { return true }
  if p == "i64" { return true }
  if p == "f32" { return true }
  if p == "string" { return false }
  // `void` / `null` / `never` cannot be an element type at all, so they arrive here the way
  // a struct or a closure element does — through the `null` a non-primitive answers.
  if p == "void" { return false }
  if p == "null" { return false }
  if p == "never" { return false }
  false
}

// An element type this pass must not judge: a `TyErr`, whose own diagnostic is already raised
// and a second one on the same expression is the cascade `TyErr` exists to stop, or a `TyVar`,
// a generic body's hole the instance decides. Both answer `false` to `elemHasZero`, which is
// why they need naming ahead of it.
function arrDefElemDeferred(el: i32) {
  if el < 0 { return true }
  const t = T.tys[el]
  if t is TyErr { return true }
  t is TyVar
}

// D965 — grade every `__array_new_default__` call once the pins are all in: an element with no
// zero is refused here, at the checker, because the emitter reaching it would build the i32
// backing under a destination of some other rep. A still-open hole is pinned to `i32` so the
// arena says what the emitter builds. Keyed by the call, so one pass covers every position.
function checkArrayNewDefaultElems() {
  let i = 0
  while i < arrDefCallTy.length {
    const t = T.tys[arrDefCallTy[i]]
    if t is TyArray {
      // Pin first, then grade — one order, not two paths: defaulting an unpinned hole and
      // skipping the grade leaves the link unread and never asks an element a partner supplies
      // for its zero. D1512.
      const el = arrDefPinHoleElem(arrDefCallTy[i])
      if arrDefElemDeferred(el) {
        // An error element already has its own diagnostic and a hole element is a generic
        // body's, where this question has no answer until the pin — the same deferral every
        // other floor in this file makes over a `TyVar` (see `notePrintCstr`).
      } else if !elemHasZero(el) {
        tErr(
          "__array_new_default__ fills every slot with the element's default value, and " +
            tyToStr(el) +
            " has none — use __array_new__(n, fill)",
          arrDefCallIx[i],
        )
      }
    }
    i = i + 1
  }
  0
}

// D1576 — every pin gets its chance, then the hole is answered. At the close of the scope that
// declared it, an A-infer-null hole with `nInner` still `-1` is one no assignment ever filled,
// so the binding's only value is `null` and its type is the `null` type. Banked rather than
// reported: this is an inference that succeeded, and the emitter lowers it as `nullref`.
function flushNullHoles(depth: i32) {
  const keepI: i32[] = []
  const keepT: i32[] = []
  const keepD: i32[] = []
  let i = 0
  while i < nhPendIxs.length {
    if nhPendDepths[i] == depth {
      const ty = nhPendTys[i]
      if ty >= 0 && ty < T.tys.length {
        const t = T.tys[ty]
        if t is TyNullable {
          if t.nInner < 0 { nhUnfilledIxs.push(nhPendIxs[i]) }
        }
      }
    } else {
      keepI.push(nhPendIxs[i])
      keepT.push(nhPendTys[i])
      keepD.push(nhPendDepths[i])
    }
    i = i + 1
  }
  nhPendIxs = keepI
  nhPendTys = keepT
  nhPendDepths = keepD
  0
}

// D1591 — the fix clause of the uninferable-binding diagnostic: what the binding is missing and
// the two ways to supply it. `add a type annotation` alone reads as though the annotation is
// the only route, while delivering the value where its type is known is what every usage-driven
// pin serves. Spelled with the binding's own name and the constructor its flavor uses.
function uninferredFixText(name: string, ty: i32) {
  const useIt = " until it is used; use it where its type is known, or annotate the binding ("
  if ty >= 0 {
    const t = T.tys[ty]
    if t is TyMap {
      if t.mSet == 1 {
        return "an empty Set has no element type" +
          useIt +
          "`const " +
          name +
          ": {[string]: boolean} = Set()`)"
      }
      return "an empty Map has no key or value type" +
        useIt +
        "`const " +
        name +
        ": {[string]: i32} = Map()`)"
    }
  }
  "an empty array literal has no element type" +
    useIt +
    "`const " +
    name +
    ": i32[] = []`)"
}

// Flush every pending binding recorded at scope `depth`, called just before the scope is popped
// and for the global scope at program end. A binding whose hole is still open at this point
// will never be pinned, so it takes the unified "cannot infer a type" diagnostic.
function flushUninferred(depth: i32) {
  flushNullHoles(depth)
  const keepN: string[] = []
  const keepT: i32[] = []
  const keepA: i32[] = []
  const keepD: i32[] = []
  let i = 0
  while i < pendNames.length {
    if pendDepths[i] == depth {
      if unresolvedHole(pendTys[i]) {
        if !arrDefHoleToI32(pendTys[i]) {
          tErr(
            "cannot infer a type for '" +
              pendNames[i] +
              "' — " +
              uninferredFixText(pendNames[i], pendTys[i]),
            pendAts[i],
          )
        }
      }
    } else {
      keepN.push(pendNames[i])
      keepT.push(pendTys[i])
      keepA.push(pendAts[i])
      keepD.push(pendDepths[i])
    }
    i = i + 1
  }
  pendNames = keepN
  pendTys = keepT
  pendAts = keepA
  pendDepths = keepD
  0
}

// ── definite-assignment flow ─────────────────────────────────────────────────

// An uninitialized `let x: T` starts unassigned and is non-null, so a read before it is provably
// written on every preceding path is a "used before it is assigned" error. `daLive` is the live
// set of binding ids still un-written on the current path, forked and joined explicitly at
// `if`/`else` and loops; `daWriteTarget` exempts a plain-`=` left-hand ident.
const daLive: i32[] = []
// `daPos` is `daLive`'s sid-keyed inverse: the id's index in `daLive`, or -1 when it is assigned.
// Membership, add and mark are one array read each, so a module whose pass-1 dead zone holds
// every top-level binding is linear in them rather than quadratic.
const daPos: i32[] = []
let daWriteTarget = -1

// True if the interned id `sid` is currently in the live unassigned set.
function daIsUnassignedSid(sid: i32) { sidArrGet(daPos, sid) >= 0 }

// Mark the interned id `sid` unassigned on the current path.
function daAddSid(sid: i32) {
  if sid < 0 { return 0 }
  if sidArrGet(daPos, sid) >= 0 { return 0 }
  sidArrPut(daPos, sid, daLive.length)
  daLive.push(sid)
  0
}

// Mark `name` unassigned on the current path (a `let x: T` with no initializer).
function daAdd(name: string) { daAddSid(sidOf(name)) }

// Mark the interned id `sid` assigned, removing it from the live set by swapping the last entry
// into its slot. Order is unobservable: nothing reads the set except as a membership test and as
// a snapshot fed back through `daAddSid`.
function daMarkAssignedSid(sid: i32) {
  const at = sidArrGet(daPos, sid)
  if at < 0 { return 0 }
  const moved = daLive[daLive.length - 1]
  daLive[at] = moved
  sidArrPut(daPos, moved, at)
  daLive.pop()
  sidArrPut(daPos, sid, -1)
  0
}

// Mark `name` assigned on the current path (a write or a checked read). An empty live set
// answers without interning, which is every read and write inside a body that declares no
// uninitialized binding.
function daMarkAssigned(name: string) {
  if daLive.length == 0 { return 0 }
  daMarkAssignedSid(sidOf(name))
}

// Empty the live set in place; it never reassigns the global reference. Clearing through
// `daLive` restores `daPos` to all -1, which is what makes the column safe across a `sidReset`.
function daClear() {
  // The self-host emitter lowers `.pop()` (and `.length`) as statements but not
  // `.clear()`, so empty the array in place by popping until empty.
  while daLive.length > 0 {
    sidArrPut(daPos, daLive[daLive.length - 1], -1)
    daLive.pop()
  }
  0
}

// Check a read of `name`: if it is still unassigned on this path, report it and drop it so the
// same hole does not re-fire on every later read.
function daCheckRead(name: string, at: i32) {
  if daLive.length == 0 { return 0 }
  const sid = sidOf(name)
  if daIsUnassignedSid(sid) {
    daMarkAssignedSid(sid)
    tErr("`" + name + "` is used before it is assigned", at)
  }
  0
}

// Snapshot the live unassigned set (a copy of its ids), for forking and joining paths.
function daSnapshot() {
  const snap: i32[] = []
  let i = 0
  while i < daLive.length {
    snap.push(daLive[i])
    i = i + 1
  }
  snap
}

// Restore the live set from a snapshot (in place — never reassigns the global).
function daRestore(snap: i32[]) {
  daClear()
  let i = 0
  while i < snap.length {
    daAddSid(snap[i])
    i = i + 1
  }
  0
}

// Join two surviving paths into the live set: a name is assigned after the merge only if it is
// assigned on both, equivalently still unassigned if it is unassigned on either. So the joined
// live set is the union of the two paths' unassigned sets, the current live set standing for
// `a` and `b` folded in.
function daJoinInto(b: i32[]) {
  let i = 0
  while i < b.length {
    daAddSid(b[i])
    i = i + 1
  }
  0
}

// True if the statement at node `ix` always exits its enclosing path, so its end is unreachable
// and it contributes nothing to a definite-assignment join. A `return`/`break`/`continue`
// diverges; a `Block` diverges if its last statement does; an `if … else …` diverges only if
// both arms do, a chain recursing through its `ifElse`.
function daBranchDiverges(ix: i32) {
  if ix < 0 { return false }
  const s = P.nodes[ix]
  if s is RetStmt {
    return true
  } else if s is BreakStmt {
    return true
  } else if s is ContinueStmt {
    return true
  } else if s is Block {
    const st = s.blkStmts
    if st.length > 0 { return daBranchDiverges(st[st.length - 1]) }
    return false
  } else if s is IfStmt {
    if s.ifElse < 0 { return false }
    return daBranchDiverges(s.ifThen) && daBranchDiverges(s.ifElse)
  }
  false
}

// ── missing-return totality (soundness) ──────────────────────────────────────
// The condition node under any `Paren` wrappers (`((x is T))` → `x is T`). The condition-shape
// matchers (chain discrimination, exhaustiveness) peel through this so a parenthesized guard
// classifies exactly like the bare spelling, keeping them in step with the narrowing collectors.
function condUnderParens(ix: i32) {
  const n = P.nodes[ix]
  if n is Paren { return condUnderParens(n.parInner) }
  ix
}

// True if the `if`-condition at `ifCondIx` opens a discriminating chain — `x is T`, or a
// `place == <literal>` over a literal-union-bearing place. Such an else-less chain may be
// exhaustive, which the dedicated exhaustiveness check adjudicates; the general missing-return
// rule defers to it rather than double-flagging.
function ifCondIsDiscriminating(ifCondIx: i32) {
  const fc = P.nodes[condUnderParens(ifCondIx)]
  if fc is IsExpr { return true }
  if fc is BinExpr {
    if fc.binOp == "==" {
      let eqPlace = -1
      if litTyOfExpr(fc.binRight) >= 0 { eqPlace = fc.binLeft }
      else if litTyOfExpr(fc.binLeft) >= 0 { eqPlace = fc.binRight }
      if eqPlace >= 0 {
        const eqObj = P.nodes[eqPlace]
        if eqObj is Ident {
          if isLitBearing(lookup(eqObj.identName)) { return true }
        }
      }
    }
  }
  false
}

// True if executing the node at `ix` always produces a return value or diverges — control never
// falls off its end without a value. Unlike `daBranchDiverges`, a bare trailing value expression
// counts as an implicit return. A `Block` is total iff its last statement is, an `if`/`else` iff
// both arms are, and a `while true { … }` is; every other loop or statement is not.
function nodeIsTotal(ix: i32) {
  if ix < 0 { return false }
  const n = P.nodes[ix]
  if n is Block {
    const st = n.blkStmts
    if st.length == 0 { return false }
    return nodeIsTotal(st[st.length - 1])
  }
  if n is RetStmt { return true }
  if n is BreakStmt { return true }
  if n is ContinueStmt { return true }
  if n is IfStmt {
    if n.ifElse < 0 {
      // An else-less `if`: a discriminating `is` / literal-equality chain may be exhaustive, so
      // this defers to the dedicated exhaustiveness check, which knows the union's variants. A
      // plain else-less `if` always has a fall-through and is not total.
      if ifCondIsDiscriminating(n.ifCond) { return true }
      return false
    }
    return nodeIsTotal(n.ifThen) && nodeIsTotal(n.ifElse)
  }
  if n is WhileStmt {
    // `while true { … }` never completes normally — it diverges or returns inside.
    const c = P.nodes[n.whileCond]
    if c is BoolLit { return c.boolVal != 0 }
    return false
  }
  // A bare trailing value expression is the implicit return.
  return !isStmtNode(ix)
}

// True if `name` resolves (innermost-first) to a `const` binding.
function isConstName(name: string) {
  let i = T.scopes.length - 1
  while i >= 0 {
    if T.scopes[i].has(name) {
      if i < constScopes.length { return constScopes[i].has(name) }
      return false
    }
    i = i - 1
  }
  false
}

// Well-known primitive type-arena indices, pinned by `initChecker` so the hot
// primitives are interned once (not re-pushed per use). `-1` until initialized.
export let TY_I32 = -1
let TY_I64 = -1
let TY_F64 = -1
let TY_F32 = -1
let TY_BOOL = -1
let TY_STR = -1
let TY_VOID = -1
let TY_ERR = -1
let TY_NULL = -1
// `never` — the empty type: what an intersection of disjoint concrete types folds to. The bottom
// type, assignable to anything, with nothing but itself and err assignable to it.
let TY_NEVER = -1
// `u8` — a storage type. Wasm has no 8-bit value type, but WasmGC has packed storage types and
// VL mirrors that: a `u8` value would be an i32 with nothing enforcing 0..255, while a `u8` slot
// is backed by one byte, so the store truncates and every read yields 0..255. Legal only as an
// array element, so `primTyOfName` declines it and `tyVarMayBind` refuses it as a `T` binding.
let TY_U8 = -1

// ── type-arena constructors ──────────────────────────────────────────────────
// Each appends a variant to `T.tys` and returns its index — the same shape as the AST's `mk*`
// constructors, for the parallel arena.

function addTy(t: Ty) {
  T.tys.push(t)
  T.tys.length - 1
}

function mkPrim(name: PrimName) {
  const t: Ty = { primName: name }
  addTy(t)
}

function mkErrTy() {
  const t: Ty = { errKind: 0 }
  addTy(t)
}

function mkObjTy(names: string[], typeIxs: i32[]) {
  const t: Ty = { objFieldNames: names, objFieldTypes: typeIxs }
  addTy(t)
}

function mkFuncTy(params: i32[], ret: i32) {
  const t: Ty = { fnParamTypes: params, fnRet: ret }
  addTy(t)
}

function mkUnionTy(members: i32[]) {
  const t: Ty = { uMembers: members }
  addTy(t)
}

function mkNullableTy(inner: i32) {
  // D1026 — nullable is idempotent: `(T | null) | null` is `T | null`. The language has no second
  // null, so a nested nullable is an artefact of composing an already-nullable alias (`type P =
  // null | f64` stored as `TyNullable(f64)`, then `P | null`) — a shape no arm of the return-seed
  // ladder recognizes. Folding at this one home makes the two spellings the same type again.
  if inner >= 0 {
    const innerT = T.tys[inner]
    if innerT is TyNullable { return inner }
  }
  const t: Ty = { nInner: inner }
  addTy(t)
}

export function mkArrayTy(elem: i32) {
  const t: Ty = { aElem: elem }
  addTy(t)
}

function mkMapTy(key: i32, val: i32, isSet: i32) {
  const t: Ty = { mKey: key, mVal: val, mSet: isSet }
  addTy(t)
}

// The one home of which hash a `Map`/`Set` key takes: the rep has exactly two, `string`
// (element-wise, `__str_hash__`) and `i32` (the integer mix). Answers the arena type the keys
// hash as, or -1 for a key the rep cannot hold, and every gate projects this answer. The test is
// the lowering — a newtype hashes as its base, and a literal union is refused as ambiguous.
export function mapKeyRepTy(k: i32) {
  if tyIsPrimNamed(k, "i32") { return TY_I32 }
  if tyIsPrimNamed(k, "string") { return TY_STR }
  -1
}

// The decision form of `mapKeyRepTy` — can the map rep hash this key at all. The caller that says
// no resolves the annotation to -1 and reports the unsupported-key diagnostic
// (`checkLetDeclNode`, `checkInferredMapKey`).
function mapKeyTySupported(k: i32) { mapKeyRepTy(k) >= 0 }

function mkTyVar(name: string) {
  const t: Ty = { tvName: name }
  addTy(t)
}

// The canonical decimal form of an integer literal lexeme (`0x10` → `16`, `1_000` → `1000`,
// `007` → `7`), so literal-type identity compares values rather than raw spellings and `0x10` is
// a member of `16 | 32`. A lexeme whose value exceeds the i32 range keeps its raw spelling, an
// i64-sized literal never denoting a literal-union member.
function canonIntLexeme(t: string) {
  if !intLexemeFitsI32(t) { return t }
  let v = 0
  let i = 0
  let base = 10
  if t.length >= 2 && t[0] == '0' {
    const p = t[1]
    if p == 'x' || p == 'X' {
      base = 16
      i = 2
    } else if p == 'b' || p == 'B' {
      base = 2
      i = 2
    } else if p == 'o' || p == 'O' {
      base = 8
      i = 2
    }
  }
  while i < t.length {
    const c = t[i]
    if c != '_' {
      let d = 0
      if c >= '0' && c <= '9' { d = c - '0' }
      else if c >= 'a' && c <= 'f' { d = c - 'a' + 10 }
      else { d = c - 'A' + 10 }
      v = v * base + d
    }
    i = i + 1
  }
  i32ToStr(v)
}

function mkLitTy(kind: LitKind, text: string) {
  let canon = text
  if kind == "int" { canon = canonIntLexeme(text) }
  const t: Ty = { litKind: kind, litText: canon }
  addTy(t)
}

// The arena type of one literal-member lexeme — `"a"` → the `str` literal type, `1.5` → `flt`,
// `0x10` → `int` — or -1 when `name` does not begin a literal member at all. The one home for
// that lexeme grammar, so `nameToTy`'s annotation resolver and `canonEmitName`'s literal arm both
// ask for the type and let the renderer name it rather than each carrying the rule.
function litMemberTy(name: string) {
  if name.length == 0 { return -1 }
  // A string-literal type `"a"`: the quoted lexeme is the member, and the raw inner text is kept,
  // since the literal expression side keeps its raw lexeme too and membership compares the same
  // characters. The quote test (`tyname.nameIsQuotedLeaf`) stays here because the group-interior
  // cut at its home is delimiter-blind by design; its bound is the length test two lines up.
  if nameIsQuotedLeaf(name) { return mkLitTy("str", groupInnerOf(name)) }
  // A numeric-literal type (`0`, `1.5`, `1e3`): int or float by the lexeme's own shape — a `.` or
  // a scientific exponent, `numLexIsFloat` being the one home.
  if name[0] >= '0' && name[0] <= '9' {
    if numLexIsFloat(name) { return mkLitTy("flt", name) }
    return mkLitTy("int", name)
  }
  -1
}

function mkNegTy(inner: i32) {
  const t: Ty = { negTy: inner }
  addTy(t)
}

// ── return-type inference state (module globals, reset by `initChecker`) ─────

// An un-annotated function's hoisted return type is the pending sentinel `-2` until its body is
// checked. `fnDeclIx` maps a top-level function name to its FuncDecl arena index so a forward
// call can infer the callee on demand; `inferStack` is the in-progress set for cycle detection;
// `inferObserved` / `inferSawErr` accumulate what a pending body yielded, first concrete wins.
let fnDeclIx: {[string]: i32} = Map()
// ── free index operators (B14) ───────────────────────────────────────────────

// Every `function "[]"(self: T, …)` / `function "[]="(self: T, …)` the program declares, as the
// operator it implements and the possibly merge-mangled name it declared under, collected by the
// top-level hoist so the registry describes the merged program. Dispatch is by the receiver's
// type: a candidate wins when the receiver is `assignable` to its `self` parameter.
let opIdxOps: string[] = []
let opIdxFns: string[] = []
// The resolved operator function for one index site, keyed by the node the checker resolved it at
// (an `Index` for a read, the assignment `BinExpr` for a write) and read back by the emitter's
// dispatch rewrite, so the two never re-derive the choice independently. Sparse: a program that
// declares no index operator banks nothing.
let opIdxSiteNode: i32[] = []
let opIdxSiteFn: string[] = []
// ── the type-parameter `self` operator, banked from both ends ────────────────

// D491 — `binOpDeadSelf` refuses a binary-operator declaration whose `self` can never be an
// object and subtracts the hole, since `function "+"<T>(self: T, other: T)` is silent at an i32
// site and dispatches at an object one. The missing input is at the sites, so this banks what
// each `a op b` site did; a declaration with no site anywhere is not this class and stays legal.
let opBinHoleDeclName: string[] = []
let opBinHoleDeclNode: i32[] = []
let opBinHoleDeclAnn: boolean[] = []
let opBinDispatched: string[] = []
let opBinDeclined: string[] = []
let inferStack: string[] = []
let inferObserved = -1
let inferSawErr = false
// The value type of the most recently checked `Block` — its trailing expression's type, or
// `TY_VOID` when the block ends in a statement. `checkNode(Block)` itself returns `TY_VOID`, so
// this carries the tail value out of band for an `if … { v } else { w }` expression to join its
// branch values. Read immediately after a `checkNode(block)`.
let blockTailTy = -1
// The node `blockTailTy` came from, or -1 for a valueless block. Written in the same place and
// read in the same breath, so a tail `if`/`else` arm can hand its own expression to
// `constrainEmptyExpr` rather than the arms' join, which is a different arena row (D1591).
let blockTailIx = -1
// True while checking a node whose value is the enclosing function's return — the body's tail
// statement, and by propagation the tail of each branch of a tail `if`/`else`. It gates seeding
// `inferObserved` from a branch value, so a base-case branch pins the type before a recursive
// sibling is checked, without a non-tail `if`'s branch values polluting the inferred return.
let retTailPos = false

// Every top-level `let`/`const` name, hoisted in pass 1.5 so a function body — checked in pass 2
// or pulled early by demand-inference — resolves it regardless of source order, exactly as it
// already resolves a top-level function. Membership also drives the pass-2 redeclare-error skip,
// the hoist owning the canonical declaration.
let moduleGlobals: {[string]: boolean} = Map()

// Recursive return-type inference (binding-group fixpoint). A function whose return becomes
// knowable only after a recursive cycle resolves cannot be inferred in one demand pass, since the
// cycle-break commits a provisional `void`. A suppressed pre-pass resolves every un-annotated
// return first, iterating to a fixpoint; `bodyChecked` lets the real pass still check each once.
let topUnannotFns: i32[] = []
// The top-level statement list, captured at `checkProgram` entry so the return-inference floor
// can reverse-map an inferred struct-union's object members to named types
// (`structUnionRetName`). The floor must accept exactly the unions the emitter can lower, all
// members named, so it uses the same predicate as the export.
let gRootStmts: i32[] = []
// Parallel arrays (name → inferred concrete return-type name) for each un-annotated top-level
// function, exported so the emitter classifies a return from the inferred type rather than
// re-deriving it from the return expression, which misses a plain-variable return. Kept out of the
// AST `fnRet` so `fmt` never re-adds the annotation; arrays, because a string-valued map mis-lowers.
let inferRetFn: string[] = []
let inferRetTy: string[] = []
// The top-level atom count of the recorded name, parallel to `inferRetTy`: the emitter's
// anonymous-nominal residual asks whether a recorded name spells a union, and the recorder banks
// the answer so the consumer is a lookup. The count belongs to the name producer — how many atoms
// it joined — not to a walk of the type it rendered, which disagrees at a litunion member.
let inferRetAtomCount: i32[] = []
// The top-level atom count of the name the last inferred-return name producer returned — the
// number `unionMemberCount` would report for it, produced by the producer that joined it. Every
// producer writes it immediately before each non-empty return (`irAtoms` / `irRendered` do both
// in one expression), so the last rung to answer non-empty owns the recorded name and width.
let inferRetNameAtoms = 1

// ── the rung column ──────────────────────────────────────────────────────────

// Which producer answered for a recorded inferred-return row. The cascade is a run of
// short-circuiting producers and the one that answers non-empty is the decision, so the producer
// records it rather than every consumer re-deriving it from the name. The fall-through is not a
// producer and takes `IR_RUNG_NONE`; its three admitted shapes carry their own `IR_REC_*` codes.
const IR_RUNG_NONE = 0 // the `recordable` fall-through — determines nothing
const IR_RUNG_SFB = 28 // `structFieldBoxRetName`, the cascade's initializer
// Rungs 1..27 are the `if unm == ""` producers in source order; 28 and 29 are out of band — 28 is
// the cascade's initializer, not an `if unm == ""` rung at all, and 29 is a second leg of rung 8's
// producer. A new cascade producer takes the next in-band number by renaming, never by
// renumbering: the predicate below is a positional claim about which rungs 6 and 7 are.
const IR_RUNG_STRUCT_MAP_FIELD = 1
const IR_RUNG_STRUCT_PLAIN = 2
const IR_RUNG_VALUE_UNION = 3
const IR_RUNG_LITUNION_ARR_VU = 4
const IR_RUNG_STRUCT_UNION = 5
const IR_RUNG_NULLABLE = 6
const IR_RUNG_NUL_LITUNION = 7
const IR_RUNG_NUL_ELEM_LIST = 8
// `nulElemListRetName` is two producers in one body, and this is the second. Its numeric leg
// (`(f64|null)[]` and friends) renders a value-union box claimed by `synthRetAnnots`' arm 4; its
// niche legs (`(boolean|null)[]`, `(string|null)[]`, `(K|null)[]`) render shapes that arm's
// predicate rejects, so they reach no arm and stay unpinned. The split lets each leg say which.
const IR_RUNG_NUL_ELEM_LIST_NICHE = 29
// D1062 — `nulListRetName`, out of band (30) because it is not a cascade position at all: it is
// reached only by the named-function loop (`elaborateInferRets`), never by the lambda cascade, so
// an in-band number would assert a position it does not occupy. The named loop asks it after
// `nullableRetName` declines, and the two never both answer, one claiming the i32-backed inners.
const IR_RUNG_NUL_LIST_RET = 30
const IR_RUNG_NUL_STRUCT_ELEM_LIST = 9
const IR_RUNG_NUL_MAP_ELEM_LIST = 10
const IR_RUNG_NUL_LIST_ELEM_LIST = 11
const IR_RUNG_ELEM_VU_LIST = 12
const IR_RUNG_ELEM_VARIANT_BOX_LIST = 13
const IR_RUNG_ELEM_MAP_UNION_LIST = 14
const IR_RUNG_ELEM_REFARM_VU_LIST = 15
const IR_RUNG_NESTED_ELEM_UNION_LIST = 16
const IR_RUNG_STRUCT_FIELD_BOX_ELEM_LIST = 17
const IR_RUNG_STRUCT_ELEM_LIST = 18
const IR_RUNG_NUL_CLOSURE_ELEM_LIST = 19
const IR_RUNG_CLO_ARM_VU = 20
const IR_RUNG_MAP_UNION = 21
const IR_RUNG_REFARM_UNION = 22
const IR_RUNG_VARIANT_BOX = 23
const IR_RUNG_NESTED_LEAF_LIST = 24
const IR_RUNG_MAP_ELEM_LIST = 25
const IR_RUNG_LITUNION_ELEM_LIST = 26
const IR_RUNG_LITUNION_ALIAS = 27

// ── the fall-through's three gates ───────────────────────────────────────────

// Not producers, which is why they are not rungs: `recordable` admits three unrelated shapes
// through one `||`, and these name which gate admitted the row. The three admitted sets are
// pairwise disjoint on every input, so the `||` order is not load-bearing — widen a gate and
// disjointness has to be re-argued rather than assumed.
const IR_REC_CLASSIFIABLE = 40 // `isClassifiableRetName` — NOT "scalar": it admits `i32[]`/`string[]` too
const IR_REC_OBJ_SHAPE = 41 // `isObjShapeName`
const IR_REC_SCALAR_LIST = 42 // `isScalarListRetName`
// D1567 — the `null` type, which is not a nullable of anything: a function whose every returned
// value is a bare `null` types `TyPrim:null`, so no other producer here answers.
const IR_REC_NULL_ONLY = 43
// The named-function loop is a second cascade over the same producers and banks the same codes:
// a rung identifies the producer, not the cascade it is reached through. Left unbanked, every
// named row reads `IR_RUNG_NONE` — "no producer answered" where one plainly did — which is
// unobservable while `synthRetAnnots` keys named rows by function name, and a trap once it does not.

let inferRetNameRung = IR_RUNG_NONE
// `let`, not `const` — it is reset per program beside the other `inferRet*` columns. As a `const`
// it survives `initChecker`, so row indices from an earlier program shift every lookup, which
// shows only where one compiler instance compiles many programs.
let inferRetRung: i32[] = []

// Record the rung that answered. Applied to the result so the cascade stays short-circuiting —
// the producers have side effects (several register unions) and must not be called eagerly.
function irRung(rung: i32, nm: string): string {
  if nm != "" { inferRetNameRung = rung }
  nm
}

// `irAtoms` for a producer that reports its own rung — used where one function body is really two
// producers and the cascade's single `irRung` wrap cannot tell them apart. The cascade must not
// also wrap such a producer, or its code would overwrite the leg's.
function irAtomsRung(nm: string, atoms: i32, rung: i32): string {
  inferRetNameAtoms = atoms
  inferRetNameRung = rung
  nm
}

function irAtoms(nm: string, atoms: i32): string {
  inferRetNameAtoms = atoms
  return nm
}

// `irAtoms` for a name that is a `tyToEmitName` render: adopt the renderer's own reported width
// (`tyNameAtoms`). Written as a call so the render is evaluated before `tyNameAtoms` is read,
// with no dependence on argument evaluation order.
function irRendered(nm: string): string {
  inferRetNameAtoms = tyNameAtoms
  return nm
}
// The arena-index sibling of `inferRetTy`: the `Ty`-arena index of each recorded inferred return
// type, so the emitter's inferred-return loop drives the structural arena walks off the resolved
// type, covering unions and closures the rendered-name walk does not surface. `-1` when the
// recorder had no arena index, which falls through the walks harmlessly.
let inferRetTyIx: i32[] = []
// Name → its first index in the arrays, so the hot `inferRetNameOf` is an O(1) map lookup rather
// than a linear scan. An i32-valued map kept in sync by `recordInferRet`, first-wins. The arrays
// stay for the emitter's indexed access (`inferRetCount`/`inferRetTyAt`) and to hold the string
// type the map cannot.
let inferRetIdx: {[string]: i32} = Map()
// The binding analogue of `inferRetFn`/`inferRetTy`: an un-annotated `const`/`let` whose inferred
// type is a value union, recorded by its LetDecl node index so the emitter classifies and lowers
// it like an annotated value-union binding even when the initializer is one it cannot statically
// classify. Captured during the check, with the scope still live.
let inferLetIx: i32[] = []
let inferLetTy: string[] = []
// The niche analogue of `inferLetIx`: an un-annotated `const x = if c { "hi" } else null` infers
// `string | null`, a niche ref rep rather than a value-union box, so `valueUnionRetName` renders
// "" and `inferLetIx` skips it. Recorded by LetDecl node index so `letIsNulString` classifies the
// slot as the kind-16 nullable-string rep and reuses the annotated lowering.
let inferLetNulStrIx: i32[] = []
// The `boolean | null` companion of `inferLetNulStrIx` — the other niche scalar nullable, an i32
// 0/1 with sentinel 2 for null. Same recording discipline: an un-annotated
// `const x = if c { true } else { null }` by LetDecl node index, so the emitter classifies the
// slot as the niche i32 rep and reuses the annotated lowering.
let inferLetNulBoolIx: i32[] = []
let bodyChecked: {[string]: boolean} = Map()
// Typed-IR foundation: node index → resolved type-arena index, recorded for every node on the
// real (non-quiet) check pass so the emitter consumes the checker's computed type instead of
// re-deriving it syntactically. A flat table sized to the node arena at `checkProgram`; nodes the
// emitter synthesizes later fall past the end and read -1, so a consumer falls back syntactically.
let nodeTyIx: i32[] = []
// D951 — the `is`-test type sidecar: the arena type an `IsExpr`'s check type resolves to, keyed by
// the `IsExpr` node, so the emitter's narrowing stack banks the answer instead of re-deriving the
// narrowed type from the tested spelling. Sized with `nodeTyIx` and read through `isVarTyIxOf`; a
// monomorphized `is T` must bank through `recordClonedIsVarTy` or the emitter reads a `TyVar`.
let isVarTyIx: i32[] = []
// The discriminant bank, parallel to `isVarTyIx` and sized with it. At an `is` test whose receiver
// is a member path over a struct union, it records the type the receiver narrows to in the then
// branch (`pushDiscrimParentFact`'s answer), which the emitter cannot cheaply re-derive: an arm's
// tag identity lives in a different column depending on how the tag is written. Then branch only.
let isParentTyIx: i32[] = []
// The else twin of `isParentTyIx`. One table per branch rather than one table plus a direction
// flag: both facts are keyed on the same condition node, and the emitter reads them from two sites
// (`setNarrowFromCond` and `setNarrowFromCondElse`) that never run together for one branch, so a
// flag would be set by whichever site asked last.
let isParentElseTyIx: i32[] = []
// Context-resolved type sidecar, parallel to `nodeTyIx`: at the arena-pure adoption sites it
// records the destination type a literal node widened into, which is the rep the emitter builds.
// `nodeTyIx` keeps the checker's self-inferred type for its existing consumers; the emitter's rep
// keying reads `nodeRepTyIxOf`, which falls back to `nodeTyIxOf` when nothing is recorded.
let nodeRepTyIx: i32[] = []
// Literal-width sidecar, parallel to `nodeTyIx`: true at a radix `NumLit` whose destination is a
// 64-bit slot, so its bit pattern is read at 64 bits rather than at the width its digits imply.
// `checkNodeReal` consults it so a re-check keeps the adopted width, and the emitter reads the
// re-stamped `nodeTyIx` — DECISIONS.md §"A hex literal is a bit pattern".
let litWide64: boolean[] = []
// Annotation atom-count sidecar: how many top-level union atoms the annotation node's emit-time
// spelling is joined from, banked by `canonEmitTypeNames`, the producer of that spelling. The
// count cannot be recovered from the arena — an annotation over two same-shape declared structs
// dedups to a plain `TyObj`. One entry per node, -1 at a non-`TypeRef`, sized to the node arena.
let annUnionAtoms: i32[] = []
// Nominal-identity sidecar: the `Ty`-arena indices of declared struct types (`cStructTyIxs`) and
// of union-variant member types (`cVariantMemberTyIxs`). `nodeTyIsStruct` reads them as "its
// recorded type is a declared struct and not a variant member". The arena stays purely
// structural — `TyObj` has no name — so nominal-ness is checker metadata, not a `Ty`.
let cStructTyIxs: i32[] = []
let cStructTyIxSet: boolean[] = []
// The declared name of each `cStructTyIxs` entry, so a declared-struct arena index resolves back
// to its alias name, as `cUnionTyIxs`/`cUnionNames` already do for unions. The name-faithful
// renderer (`tyToNominalName`) uses it to render a nominal struct as its name rather than a
// structural expansion, so an arena walk reproduces the name walk's registration keys.
let cStructNames: string[] = []
let cVariantMemberTyIxs: i32[] = []
let cVariantMemberTyIxSet: boolean[] = []
// The annotation route's candidate variant members, held until `annCommitVariantMembers` runs at
// the end of checking — `annRegisterVariantMembers` records why the decision cannot be made at
// the moment the annotation resolves.
let annPendingVariantTyIxs: i32[] = []
let annPendingVariantTyIxSet: boolean[] = []
// Declared union-alias `Ty` indices (`type T = A | B`), for the emitter's `isUName`.
let cUnionTyIxs: i32[] = []
let cUnionTyIxSet: boolean[] = []
// The declared name of each `cUnionTyIxs` entry, so a union type index resolves back to its alias
// name, which pins an anonymous lambda's litunion return as the alias, an inline litunion
// spelling repping as a string ref.
let cUnionNames: string[] = []
// Generic-application nominal sidecar, the third reverse map in the `cStructTyIxs`/`cUnionTyIxs`
// family: the arena knows what `Box<i32>` expands to and nothing about an application having been
// written, so the nominal renderer would produce the structural `{value: i32}`. Recorded at
// `applyGenAliasArgs`; the head is a name, the arguments are arena indices the renderer recurses.
let gaAppTyIxs: i32[] = []
let gaAppTyIxSet: boolean[] = []
let gaAppHeads: string[] = []
// The arguments of each `gaAppTyIxs` entry, flattened: entry `i` owns
// `gaAppArgFlat[gaAppArgStart[i] .. + gaAppArgCount[i]]`. Same flat-slice shape as the
// `gaParamNames`/`gaParamStart`/`gaParamCount` triple this file already uses for the
// declaration side.
let gaAppArgStart: i32[] = []
let gaAppArgCount: i32[] = []
let gaAppArgFlat: i32[] = []
// Per-row finiteness memo for the reader's cycle guard: -1 unknown, 0 the expansion is cyclic
// (decline, see `tyReachesSelf`), 1 finite.
let gaAppFinite: i32[] = []
// The names of one-member `type N = A` aliases whose single variant is spelled as a bare type name
// or a generic application, recorded syntactically in pass 0a before any variant resolves. The
// arena cannot tell such an alias from a canonicalized object intersection, also a one-member
// union over one `TyObj` — the intersection keeps its alias name, the plain alias is transparent.
let cPlainAliasNames: string[] = []

// ── the declaration fill registry (pass 0a / 0b) ─────────────────────────────

// `cUserTypes` gets a declaration's placeholder in pass 0a and its shape in pass 0b, so a name
// resolved between the two answers from an empty arena entry — a wrong type, not a missing
// diagnostic. These columns make the fill demand-ordered: `cFillStmtIx` maps a name to its
// declaration statement (last wins), `cFillDoneAt` flags filled arena indices, `cFillActive` gates.
let cFillStmtIx: {[string]: i32} = Map()
let cFillDoneAt: i32[] = []
let cFillActive = false
// Nominal newtype sidecar, the fourth member of the `cStructTyIxs`/`cUnionTyIxs`/`gaAppTyIxs`
// family, built to the same rule: the arena stays structural and nominal-ness is a column beside
// it. A brand is a name and that is the whole representation — a branded index is a second index
// over the same `Ty` payload, so only `assignable`/`tyEq` and the operator rule consult the column.
let nwDeclNames: string[] = []
let nwTyIxs: i32[] = []
let nwNames: string[] = []
let nwBaseTyIxs: i32[] = []
// D1045 — the nominal declarations declared inside a block, keyed by their mangled name. A nominal
// type is its name, so one whose name goes out of scope takes the nominal identity with it:
// nothing can spell the return of `function fresh() { type Id = new i32; return 7 as Id }`, and
// the checker refuses the inferred return. Only nominal rows; a local struct escapes freely.
let nwBodyScopedNames: {[string]: i32} = Map()
// The enclosing function's name while its body is checked, for that refusal's
// sentence. Saved and restored beside `T.curRet` in `checkFuncDeclNode`; "" at
// module scope and for an anonymous lambda.
let curFnEscName = ""
// Is the enclosing function's void return the bare-`return` pin rather than an annotation?
// Read only to explain a `return <expr>` mismatch no written `: void` accounts for. Saved
// and restored beside `curFnEscName`.
let curFnBareRetVoid = false
// Flat-record sidecar: the layout of every `flat type N = { … }`, built by `resolveFlatLayouts`
// and read by the `N.size` / `N.field` fold in `checkMemberNode`. Offsets are the running sum of
// the declared field widths and the compiler never inserts a byte — no alignment, no pad, no
// reordering. `flSizes[d]` is the total, `FL_UNRESOLVED` mid-fixpoint, `FL_INVALID` if rejected.
let flNames: string[] = []
let flSizes: i32[] = []
let flFStart: i32[] = []
let flFCount: i32[] = []
// The declaration's arena node, so the cycle report — which is discovered in the fixpoint, long
// after the statement walk that found the declaration — can still anchor on the right line.
let flDeclNodes: i32[] = []
// Per field, in declaration order: the name, the width (or `-1` when the field is a nested flat
// record, in which case `flFNest` is that record's index here), and the byte offset once the
// declaration resolves.
let flFNames: string[] = []
let flFWidth: i32[] = []
let flFNest: i32[] = []
let flFOff: i32[] = []
// Depth counter for the literal-adoption window (`nomLitAdopts`): while positive, `assignableGo`'s
// brand test stands down. Only ever raised around a walk whose source is a scalar literal, which
// is what makes waiving the whole walk equivalent to waiving the destination's own brand.
let nomLitRelax = 0
// Litunion alias provenance: the narrowing, join and intersection algebra re-mints a declared
// litunion alias as a fresh arena copy — a `TyUnion` sharing the alias's `TyLit` members at an
// index the union-alias registry cannot recognize. These arrays record (copy index → source alias
// index) at the mint sites; only a copy whose member set is contained in the alias's records.
let cLitUnionCopyTyIxs: i32[] = []
let cLitUnionCopyAliasIxs: i32[] = []
// A single placeholder `TyFunc` arena index for monomorphizer `=>sigkey` closure pins (C1 endgame).
let cFuncPinTyIx = -1
// A single placeholder `TyObj` arena index for interned anonymous-shape `#anonN` names (C1 endgame).
let cObjPinTyIx = -1
// ── the pin column ───────────────────────────────────────────────────────────

// A synthesized annotation node's provenance in its own column: the `PIN_*` kind and, for
// `PIN_SIGKEY`, the `$fnsig` key that is its payload. Keyed by node index, exactly like `nodeTyIx`
// beside it and reset with it, so no consumer decodes a prefix off the `tyName` column. Only the
// mint still bridges from the legacy string form (`synthPinKindOf`).
let nodePinKind: i32[] = []
let nodePinPay: string[] = []
let inferQuiet = false
let cycleBreakCount = 0
let inferTentative: string[] = []
let unresolvedFns: string[] = []
let fnSawValueRet = false

// Redundant return-type annotation rule: `retNatural` is the body's natural inferred return — the
// first non-void, non-error one, mirroring `noteInferredRet` — accumulated for an annotated
// function so the rule can compare it against the explicit `: T`. A match means removing the
// annotation yields the identical inferred return. Saved, reset and restored per function.
let retNatural = -1
let retNaturalErr = false

// Contextual (bidirectional) inference for un-annotated function-literal params: an expression
// checked in a position with a known expected type lets a lambda sitting there infer its params
// from the expected function type, even nested inside a composite. `seedExpected` walks expected
// type and expression in lockstep and records them per lambda node, so no seed leaks into a body.
let cbExpNode: i32[] = [] // lambda node index
let cbExpOff: i32[] = []  // offset of its param-type run in `cbExpPool`
let cbExpLen: i32[] = []  // run length (param count)
let cbExpPool: i32[] = [] // flattened expected param-type arena indices

// The contextual expected return type per lambda node, the return-side dual of the param seeding:
// a lambda whose body infers a narrower numeric than the expected return adopts it, so the
// widening happens inside the body at the return seam rather than riding function-type variance.
// `cbSeedUsed` counts seeds that changed an inference, so `checkLetDecl` cannot call it redundant (D1442).
let cbSeedUsed = 0
let cbExpRetNode: i32[] = []
let cbExpRetTy: i32[] = []

// Record `retTy` as the expected return type of the lambda at `nodeIx` (latest wins).
function recordCbExpectedRet(nodeIx: i32, retTy: i32) {
  cbExpRetNode.push(nodeIx)
  cbExpRetTy.push(retTy)
  0
}

// The expected return type recorded for the lambda at `nodeIx` — the last recorded one, the real
// pass overriding the pre-inference pass — or -1 when none.
function cbExpectedRetFor(nodeIx: i32) {
  let found = -1
  let i = 0
  while i < cbExpRetNode.length {
    if cbExpRetNode[i] == nodeIx { found = cbExpRetTy[i] }
    i = i + 1
  }
  found
}

// Lambda nodes that are the init of an un-annotated `const`/`let` binding (`const add = (a, b) =>
// a + b`). Such a lambda's un-annotated params are inference holes, monomorphized per use exactly
// like a named generic function, rather than rejected as uninferable. Any other no-context
// anonymous lambda stays a clean rejection.
let valBindLambda: i32[] = []
function noteValBindLambda(nodeIx: i32) { valBindLambda.push(nodeIx) }
function isValBindLambda(nodeIx: i32) {
  let i = 0
  while i < valBindLambda.length {
    if valBindLambda[i] == nodeIx { return true }
    i = i + 1
  }
  false
}

// ── void-context discard ─────────────────────────────────────────────────────

// The two node ledgers below are the checker-to-emitter channel for the void-discard rule, both
// keyed on the context being void, never on a tail's shape. `voidCtxLambdaNodes` holds lambda
// literal nodes checked against an expected `(…) => void`: such a lambda adopts the void return,
// so an explicit `return expr` inside it mismatches and a value-bearing tail is discarded.
let voidCtxLambdaNodes: i32[] = []
function noteVoidCtxLambda(nodeIx: i32) {
  if !listHasI32(voidCtxLambdaNodes, nodeIx) { voidCtxLambdaNodes.push(nodeIx) }
  0
}
export function lambdaVoidAdoptedAt(nodeIx: i32) {
  listHasI32(voidCtxLambdaNodes, nodeIx)
}

// `voidCoerceValNodes`: expression nodes (paren-peeled idents naming a module-scope `function`)
// whose `(P…) => T` value is granted wholesale coercion into an expected `(P…) => void` slot
// (`fnValVoidCoerce`). The emitter mints one void twin per coerced target and swaps the closure
// build at exactly these nodes; `voidCoerceValNames` carries the target's name for that mint.
let voidCoerceValNodes: i32[] = []
let voidCoerceValNames: string[] = []
function noteVoidCoerceVal(nodeIx: i32, name: string) {
  if !listHasI32(voidCoerceValNodes, nodeIx) {
    voidCoerceValNodes.push(nodeIx)
    voidCoerceValNames.push(name)
  }
  0
}
export function voidCoerceValAt(nodeIx: i32) {
  listHasI32(voidCoerceValNodes, nodeIx)
}
export function voidCoerceValCount() { voidCoerceValNodes.length }
export function voidCoerceValNameAt(i: i32) { voidCoerceValNames[i] }

function listHasI32(xs: i32[], v: i32) {
  let i = 0
  while i < xs.length {
    if xs[i] == v { return true }
    i = i + 1
  }
  false
}

// Record `paramTys` as the expected param types of the lambda at `nodeIx` (latest wins).
function recordCbExpected(nodeIx: i32, paramTys: i32[]) {
  cbExpNode.push(nodeIx)
  cbExpOff.push(cbExpPool.length)
  cbExpLen.push(paramTys.length)
  let i = 0
  while i < paramTys.length {
    cbExpPool.push(paramTys[i])
    i = i + 1
  }
  0
}

// The expected param types recorded for the lambda at `nodeIx` — the last recorded run, the real
// pass overriding the pre-inference pass — or `[]` when none.
function cbExpectedFor(nodeIx: i32) {
  let found = -1
  let i = 0
  while i < cbExpNode.length {
    if cbExpNode[i] == nodeIx { found = i }
    i = i + 1
  }
  const out: i32[] = []
  if found >= 0 {
    let j = 0
    while j < cbExpLen[found] {
      out.push(cbExpPool[cbExpOff[found] + j])
      j = j + 1
    }
  }
  out
}

// The body's tail expression of a lambda, its implicit-return value — the last statement's return
// argument, or a bare trailing-expression statement. A lambda body is always a (possibly synthetic
// one-statement) `Block`, and -1 means no tail value. It lets `seedExpected` flow an expected
// result type into a body, so a curried `(a) => (b) => …` reaches its inner lambda.
function lambdaBodyTail(bodyIx: i32) {
  if bodyIx < 0 { return -1 }
  const b = P.nodes[bodyIx]
  if b is Block {
    const stmts = b.blkStmts
    if stmts.length == 0 { return -1 }
    const last = stmts[stmts.length - 1]
    const ln = P.nodes[last]
    if ln is RetStmt { return ln.retArg }
    return last
  }
  -1
}

// The field walk of `objRetWidenAdopt`: `litIx` is an ObjLit whose inferred `sTyIx` adopts the
// expected `dTyIx` field-wise, appending each re-encodable value node and its adopted field type
// to `recNodes`/`recTys`. False on any proven mismatch, in which case the caller keeps the
// inferred shape. Adoption is sound only where the literal body can re-encode at the wider rep.
function objLitWidenFields(
  litIx: i32,
  sTyIx: i32,
  dTyIx: i32,
  recNodes: i32[],
  recTys: i32[],
): boolean {
  const lit = P.nodes[litIx]
  if !(lit is ObjLit) { return false }
  const s = T.tys[sTyIx]
  const d = T.tys[dTyIx]
  if !(s is TyObj) { return false }
  if !(d is TyObj) { return false }
  if s.objFieldNames.length != d.objFieldNames.length { return false }
  let i = 0
  while i < d.objFieldNames.length {
    const dty = d.objFieldTypes[i]
    const sty = objFieldType(s, d.objFieldNames[i])
    if sty < 0 { return false }
    // The field's value expression in the literal body, shared by the numeric-widen and the
    // float-literal-to-f32 arms below.
    let fv = -1
    const fl = lit.objFields
    let fi = 0
    while fi < fl.length {
      const fn = P.nodes[fl[fi]]
      if fn is FieldInit {
        if fn.fiName == d.objFieldNames[i] { fv = fn.fiValue }
      }
      fi = fi + 1
    }
    if numWidens(sty, dty) {
      // The widening field's value must be a small int literal in the literal body.
      if fv < 0 { return false }
      const fvn = P.nodes[fv]
      if fvn is NumLit {
        if numLexIsFloat(fvn.numText) { return false }
        if !intLexemeFitsI32(fvn.numText) { return false }
        recNodes.push(fv)
        recTys.push(dty)
      } else {
        return false
      }
    } else if primNameOf(dty) == "f32" && isF32AdoptingLitExpr(fv) {
      // A literal into an f32 field (`() => ({a: 3.5, …})` against `{a: f32, …}`): the field infers
      // f64 or i32 but the literal re-encodes exactly at f32, the field dual of the scalar arm.
      // Record f32 on the value node so `anonFieldCode` interns the f32 field slot rather than
      // coding the literal's default.
      recNodes.push(fv)
      recTys.push(dty)
    } else if assignable(sty, dty) && !assignable(dty, sty) {
      // The field widens by boxing — a bare scalar or struct arm into a union or nullable field
      // (`{f: false}` against `{f: boolean | {w: i32}}`). Adopt when the literal value re-encodes
      // at the wider field type, and record that type so the emitter boxes the field slot;
      // `synthRetAnnots` then pins the lambda's `fnRet` to the whole struct shape.
      if fv < 0 { return false }
      let fvIn = fv
      let fvDone = false
      while !fvDone {
        const fvp = P.nodes[fvIn]
        if fvp is Paren { fvIn = fvp.parInner } else { fvDone = true }
      }
      const fvNode = P.nodes[fvIn]
      // The recursion targets a nested-struct destination only: an ObjLit value against a union
      // field is a member of that union, an arm rather than a field-wise widening target, and
      // descending into it refutes the whole adoption, leaving the emitter to key the outer
      // literal onto a same-field-name-set twin. A non-`TyObj` dest takes the member-flow check.
      let dtyIsObj = false
      const dtyT = T.tys[dty]
      if dtyT is TyObj { dtyIsObj = true }
      if fvNode is ObjLit && dtyIsObj {
        if !objLitWidenFields(fvIn, sty, dty, recNodes, recTys) { return false }
        recNodes.push(fvIn)
        recTys.push(dty)
      } else {
        if !assignableExpr(fv, sty, dty) { return false }
        recNodes.push(fv)
        recTys.push(dty)
      }
    } else if tyIsLitUnion(dty) {
      // A litunion field (`f: "8"` against `f: K0 = "xz" | "8"`): the body value is a bare string
      // literal that is a member of the expected literal union. It infers the softened `string`
      // but re-encodes as the litunion's i32 atom, so record the litunion field type and
      // `anonFieldCode` interns the atom slot rather than the string.
      if fv < 0 { return false }
      if !assignableExpr(fv, sty, dty) { return false }
      recNodes.push(fv)
      recTys.push(dty)
    } else {
      // A non-widening field must match exactly (mutual assignability) — a shape
      // difference beyond numeric widening is not an adoption, it is a mismatch.
      if !assignable(sty, dty) { return false }
      if !assignable(dty, sty) { return false }
    }
    i = i + 1
  }
  true
}

function objRetWidenAdopt(bodyIx: i32, inferredTy: i32, expRetTy: i32) {
  if inferredTy < 0 || expRetTy < 0 { return false }
  let u = lambdaBodyTail(bodyIx)
  if u < 0 { return false }
  let done = false
  while !done {
    const pn = P.nodes[u]
    if pn is Paren { u = pn.parInner } else { done = true }
  }
  const lit = P.nodes[u]
  if !(lit is ObjLit) { return false }
  const s = T.tys[inferredTy]
  // A nullable expected result (`() => {f: K0} | null`, spelled directly or through the
  // nullable-closure wrapper): adopt against the inner struct. The caller still adopts the full
  // nullable expected, so the lambda's `$fnsig` result keys the nullable struct exactly as the
  // annotation-side consumer does; without the unwrap the two sides key different structs.
  let expInnerTy = expRetTy
  const dn = T.tys[expRetTy]
  if dn is TyNullable { expInnerTy = dn.nInner }
  const d = T.tys[expInnerTy]
  if s is TyObj {
    if d is TyObj {
      const recNodes: i32[] = []
      const recTys: i32[] = []
      if !objLitWidenFields(u, inferredTy, expInnerTy, recNodes, recTys) {
        return false
      }
      if recNodes.length == 0 { return false }
      if !inferQuiet {
        let r = 0
        while r < recNodes.length {
          const rn = recNodes[r]
          while nodeTyIx.length <= rn { nodeTyIx.push(-1) }
          nodeTyIx[rn] = recTys[r]
          r = r + 1
        }
        // Rep sidecar: `nodeTyIx` above stamps the widening field values, but the top-level return
        // literal `u` keeps its naive self-inferred type, and `structIndexOfObjCtx` keys on the
        // literal node. Record the destination struct there, recursing into fields, so the rep
        // layer resolves the union-field / i64-field / nullable-niche shape the emitter builds.
        recordRepTyAdopt(u, expInnerTy, 6)
      }
      return true
    }
  }
  false
}

// The union member index of `u`'s function arm whose parameter arity is `arity` (`(() => i64) |
// {w:i32}` with a 0-arg lambda → the `() => i64` member), or -1 when no function arm matches. It
// lets `seedExpected` adopt a bare lambda into a union's closure arm, the checker seam that
// widens `f: () => 5` to the `() => i64` member. The first matching arm wins.
function unionFuncArmForArity(u: TyUnion, arity: i32) {
  const members = u.uMembers
  let i = 0
  while i < members.length {
    const m = members[i]
    const mt = T.tys[m]
    if mt is TyFunc {
      if mt.fnParamTypes.length == arity { return m }
    }
    i = i + 1
  }
  -1
}
// True if the union object arm `tyIx` can be both boxed into the union's `{tag, value}` rep and
// have its narrowed fields read back with valid wasm — the safety gate for seeding a struct
// literal into this arm. A scalar, nested struct or closure field has a sound variant-struct rep;
// an array, union or nullable field has none, so an arm carrying one stays an un-seeded reject.
function unionArmSeedSafe(tyIx: i32) {
  const t = T.tys[tyIx]
  if !(t is TyObj) { return false }
  const ftys = t.objFieldTypes
  let i = 0
  while i < ftys.length {
    const ft = T.tys[ftys[i]]
    if ft is TyPrim {
      // scalar / string / boolean field — boxes + reads cleanly
    } else if ft is TyFunc {
      // a closure field — boxes into the variant struct; a narrowed call is a loud reject
    } else if ft is TyObj {
      if !unionArmSeedSafe(ftys[i]) { return false }
    } else if ft is TyArray {
      // A closure-array field (`f: ((i32) => K0)[]`): the reflist field boxes into the variant
      // struct and a narrowed indexed call reads back the closure element, and the seed is what
      // lets the element lambdas infer their params and result from the arm. Every other element
      // rep keeps the un-seeded clean reject.
      if ft.aElem < 0 { return false }
      const aet = T.tys[ft.aElem]
      if !(aet is TyFunc) { return false }
    } else {
      return false // other array / union / nullable field — no sound narrowed-read rep yet
    }
    i = i + 1
  }
  true
}
// The union member index of `u`'s object arm whose shape covers the object literal `objIx` — every
// literal field name is a field of the arm — and whose fields are seed-safe, or -1. The object dual
// of `unionFuncArmForArity`, so a bare field lambda infers its params from the arm's field types;
// the literal is still gated by the normal assignability check. First match wins.
function unionObjArmForLit(u: TyUnion, objIx: i32) {
  const on = P.nodes[objIx]
  if on is ObjLit {
    const members = u.uMembers
    let i = 0
    while i < members.length {
      const m = members[i]
      const mt = T.tys[m]
      if mt is TyObj && unionArmSeedSafe(m) {
        let ok = true
        let j = 0
        while j < on.objFields.length {
          const fnode = P.nodes[on.objFields[j]]
          if fnode is FieldInit {
            if objFieldType(mt, fnode.fiName) < 0 { ok = false }
          }
          j = j + 1
        }
        if ok { return m }
      }
      i = i + 1
    }
  }
  -1
}
// The union member index of `u`'s array arm covering the array literal `arrIx`, or -1, so
// `seedExpected` can descend an array literal flowing into a union into that arm. Two admitted
// element shapes, both with a sound narrowed read: a closure element, and a struct element whose
// fields are seed-safe and cover the literal's element field names. First match wins.
function unionArrayArmForLit(u: TyUnion, arrIx: i32) {
  const an = P.nodes[arrIx]
  if an is ArrayLit {
    const members = u.uMembers
    let i = 0
    while i < members.length {
      const m = members[i]
      const mt = T.tys[m]
      // The hole declines this arm and the scan moves to the next member (`tyArrayElemIx`): an
      // array arm whose element the arena has not resolved carries `aElem == -1`, and reading it
      // is an out-of-bounds `array.get` in the compiler. Declining is the same answer the seed
      // already gives a scalar-element arm.
      const aeIx = tyArrayElemIx(m)
      if mt is TyArray && aeIx >= 0 {
        const aet = T.tys[aeIx]
        if aet is TyFunc { return m }
        if aet is TyObj && unionArmSeedSafe(aeIx) {
          // Every literal element that is an ObjLit must field-check against the arm's struct
          // element (mirrors `unionObjArmForLit`), so a wrong-shaped arm is not seeded.
          let ok = true
          let j = 0
          while j < an.arrElems.length {
            let ei = an.arrElems[j]
            let peeled = false
            while !peeled {
              const ep = P.nodes[ei]
              if ep is Paren { ei = ep.parInner } else { peeled = true }
            }
            const en = P.nodes[ei]
            if en is ObjLit {
              let k = 0
              while k < en.objFields.length {
                const fnode = P.nodes[en.objFields[k]]
                if fnode is FieldInit {
                  if objFieldType(aet, fnode.fiName) < 0 { ok = false }
                }
                k = k + 1
              }
            }
            j = j + 1
          }
          if ok { return m }
        }
      }
      i = i + 1
    }
  }
  -1
}
// Returns 1 when the seed actually reached a lambda and pinned its params or result, i.e. when
// the expected type is load-bearing for what the expression infers to. `recordRedundantAnnot`
// needs the answer: an annotation that seeded its own initializer cannot be judged redundant by
// comparing the two, the comparison being circular (D1442). Every other arm only recurses.
function seedExpected(exprIx: i32, expectedTy: i32) {
  if exprIx < 0 || expectedTy < 0 { return 0 }
  let u = exprIx
  let done = false
  while !done {
    const node = P.nodes[u]
    if node is Paren { u = node.parInner } else { done = true }
  }
  let did = 0
  const en = P.nodes[u]
  const et = T.tys[expectedTy]
  // A nullable expected type (`(i32) => i32 | null`, e.g. a map value slot, which is `V | null`)
  // seeds its inner: the right-hand lambda or literal still wants the non-null shape.
  if et is TyNullable { return seedExpected(u, et.nInner) }
  if en is FuncDecl {
    if en.fnName == "" {
      if et is TyFunc {
        recordCbExpected(u, et.fnParamTypes)
        recordCbExpectedRet(u, et.fnRet)
        did = 1
        // Recurse into the lambda's body against the expected result type, the dual of the
        // array/object recursion below. A curried `(a) => (b) => …` against `(i32) => ((i32) =>
        // i32)` then types its inner lambda's params from the result type, at any depth.
        seedExpected(lambdaBodyTail(en.fnBody), et.fnRet)
      } else if et is TyUnion {
        // A lambda flowing into a union with a bare-closure arm (`f: (() => i64) | {w:i32}`):
        // seed it against the arity-matching function arm, so `() => 5` widens to `() => i64` and
        // adopts the union. Without it the lambda infers its own `() => i32` and the assignment
        // is a loud type error. Arity-matched, so a wrong-arity arm falls to assignability.
        const arm = unionFuncArmForArity(et, en.fnParams.length)
        if arm >= 0 { did = seedExpected(u, arm) }
      }
    }
  } else if en is ArrayLit {
    if et is TyArray {
      let i = 0
      while i < en.arrElems.length {
        if seedExpected(en.arrElems[i], et.aElem) != 0 { did = 1 }
        i = i + 1
      }
    } else if et is TyUnion {
      // An array literal flowing into a union with a closure-array arm, or a struct-array arm
      // with closure-bearing element fields: descend into the matching array arm so a bare
      // element lambda infers its params and result from that arm's element type. Without the
      // seed a nested field lambda self-infers narrower and the boxed producer and consumer part.
      const arm = unionArrayArmForLit(et, u)
      if arm >= 0 { did = seedExpected(u, arm) }
    }
  } else if en is ObjLit {
    if et is TyObj {
      const fields = en.objFields
      let i = 0
      while i < fields.length {
        const fnode = P.nodes[fields[i]]
        if fnode is FieldInit {
          const fty = objFieldType(et, fnode.fiName)
          if fty >= 0 {
            if seedExpected(fnode.fiValue, fty) != 0 { did = 1 }
          }
        }
        i = i + 1
      }
    } else if et is TyUnion {
      // A struct literal flowing into a union (`{f: (i32) => i32, …} | boolean`): descend into
      // the matching struct arm so a bare field lambda infers its params from that arm's field
      // types. Without it an un-annotated field lambda has no contextual seed and fails "cannot
      // infer a type for parameter". Assignability still gates the literal against the union.
      const arm = unionObjArmForLit(et, u)
      if arm >= 0 { did = seedExpected(u, arm) }
    }
  }
  did
}

// ── deep `is` over a `Json` value ────────────────────────────────────────────

// D1035 — `r is T` where `r`'s type is a JSON-shaped union and `T` is not one of its arms is a
// runtime shape walk, not a tag test. The checker cannot lower one, so it records the site and
// the target here and `json_walk.vl` turns each distinct target into one generated VL walker.
// `jwTgt*` is deduped by (target spelling, receiver spelling), which is the walker's identity.
export let jwTgtSpell: string[] = []
export let jwTgtRecv: string[] = []
export let jwTgtTy: i32[] = []
// The canonical `Json` the walk is written against, which is not always the walker's parameter
// type: `parseJson` answers `Json | JsonError`, a value of which is not assignable to `Json`, so
// the walker takes the wider union and tests its container arms directly. The root is what the
// shape predicate, the wildcard leaf and the two arm spellings are read from.
export let jwTgtRootTy: i32[] = []
// One row per admitted site: the `IsExpr` arena index, and the `jwTgt*` row it walks.
export let jwSiteNode: i32[] = []
export let jwSiteTgt: i32[] = []
// The last "not a JSON shape" reason, banked rather than raised — see `jsonDeepIsSite`.
let jwBadMsg = ""
// The first token of the generated walkers, or -1 before the driver appends them. The walker
// fragment is parsed onto the end of the token stream, so one comparison separates a finding
// about the user's source from one about code they never wrote. The style tier is filtered out;
// errors are not, since a diagnostic inside a walker means the generator emitted something bad.
let jwGenTokStart = -1
export function jwSetGenTokStart(t: i32): i32 {
  jwGenTokStart = t
  0
}
function jwTokIsGenerated(tok: i32): boolean {
  if jwGenTokStart < 0 { return false }
  tok >= jwGenTokStart
}

function jwReset() {
  jwGenTokStart = -1
  jwTgtSpell = []
  jwTgtRecv = []
  jwTgtTy = []
  jwTgtRootTy = []
  jwSiteNode = []
  jwSiteTgt = []
  0
}

// Reset all checker module state, then intern the well-known primitives and the global
// scope. Call once before checking: `checkProgram` assumes it, and this is the only reset
// surface, so a new checker module table belongs here and nowhere else.
export function initChecker() {
  jwReset()
  redunReset()
  rcoalReset()
  isvalReset()
  covarWriteReset()
  cbExpNode = []
  cbExpOff = []
  cbExpLen = []
  cbExpPool = []
  cbSeedUsed = 0
  cbExpRetNode = []
  cbExpRetTy = []
  valBindLambda = []
  voidCtxLambdaNodes = []
  voidCoerceValNodes = []
  voidCoerceValNames = []
  T.tys = []
  T.scopes = []
  T.diags = []
  T.curRet = -1
  cUserTypes = Map()
  // The arena is re-minted for this program: advance both generations so no emit-side memo
  // stamped under a previous program can be consulted on a shared instance. Advance, never
  // reset — a reset could collide with a stamp an earlier program left behind.
  tyMutEpoch = tyMutEpoch + 1
  cUserTypesVer = cUserTypesVer + 1
  gaNames = []
  gaDeclIxs = []
  gaParamNames = []
  gaParamStart = []
  gaParamCount = []
  annotNameMemo = Map()
  annotNameMemoNegVer = Map()
  annotPart = Map()
  annotClash = Map()
  tpEnvNames = []
  tpEnvTys = []
  cBoundDecls = Map()
  tpBoundNames = []
  tpBoundAnns = []
  cohKeys = []
  cohWitness = []
  cohSiteLine = []
  cohSiteCol = []
  bgSrcStack = []
  bgDstStack = []
  stSeenStack = []
  holeShapeNames = []
  holeShapeTys = []
  holeArrayDemand = []
  holeCastNames = []
  holeCastMode = []
  holeCastVar = []
  holeCastClob = []
  holeCastTgtTy = []
  holeCastTgtName = []
  holeCastIx = []
  holeCastRet = []
  holeCastArgN = []
  holeCastArgExp = []
  holeCastArgIx = []
  holeMapNames = []
  holeMapTys = []
  holeAltNames = []
  holeAltTys = []
  holeAltPreN = []
  holeAltTailN = []
  holeAltHoleIx = []
  // The derivation rows are arena-parallel, so they reset exactly where the arena does: a row
  // surviving the re-mint would describe a type index the re-mint discarded.

  hdKind = []
  hdField = []
  hdInner = []
  hdAlt = []
  hdBase = []
  hdDepth = []
  hdRowOfTy = []
  guardAltStack = []
  joinHoleUnions = []
  dJoinNode = []
  dJoinTy = []
  escJoinTy = []
  escJoinIx = []
  escJoinWho = []
  binCstrLt = []
  binCstrOp = []
  binCstrRt = []
  binCstrFn = []
  cstrOwnerStack = []
  argCstrAt = []
  argCstrExp = []
  argCstrWho = []
  printCstrTy = []
  printCstrIx = []
  printCstrFn = []
  arrDefCallIx = []
  arrDefCallTy = []
  holeLinkA = []
  holeLinkB = []
  retCstrGot = []
  retCstrWant = []
  retCstrIx = []
  retCstrFn = []
  retCstrWOnly = []
  letCstrGot = []
  letCstrWant = []
  letCstrIx = []
  letCstrFn = []
  letCstrName = []
  bmCstrGot = []
  bmCstrWant = []
  bmCstrCtx = []
  bmCstrIx = []
  bmCstrFn = []
  bmCstrForm = []
  bmCstrLabel = []
  memCstrTy = []
  memCstrProp = []
  memCstrIx = []
  memCstrFn = []
  memCstrDem = []
  ufcsCstrTy = []
  ufcsCstrProp = []
  ufcsCstrIx = []
  ufcsCstrFn = []
  ufcsCstrP0 = []
  ufcsMissAt = []
  ufcsMissSpecs = []
  ufcsWhyAt = []
  ufcsWhyMsg = []
  ufcsWhyData = []
  solvedParamTys = Map()
  holePinTys = Map()
  paramSolveTried = Map()
  holeFlowSrc = []
  holeFlowDst = []
  paramSolveProbe = false
  fnDeclIx = Map()
  opIdxOps = []
  opIdxFns = []
  opIdxSiteNode = []
  opIdxSiteFn = []
  opBinHoleDeclName = []
  opBinHoleDeclNode = []
  opBinHoleDeclAnn = []
  opBinDispatched = []
  opBinDeclined = []
  moduleGlobals = Map()
  topUnannotFns = []
  gRootStmts = []
  inferRetFn = []
  inferRetTy = []
  inferRetAtomCount = []
  inferRetTyIx = []
  inferRetRung = []
  inferRetIdx = Map()
  inferLetIx = []
  inferLetTy = []
  inferLetNulStrIx = []
  inferLetNulBoolIx = []
  bodyChecked = Map()
  nodeTyIx = []
  isVarTyIx = []
  isParentTyIx = []
  isParentElseTyIx = []
  nodeRepTyIx = []
  litWide64 = []
  annUnionAtoms = []
  cFuncPinTyIx = -1
  cObjPinTyIx = -1
  nodePinKind = []
  nodePinPay = []
  inferQuiet = false
  cycleBreakCount = 0
  inferTentative = []
  unresolvedFns = []
  fnSawValueRet = false
  retNatural = -1
  retNaturalErr = false
  daClear()
  daWriteTarget = -1
  inferStack = []
  inferObserved = -1
  inferSawErr = false
  // Pass 0 and pass 1's collect tables, reset here with everything else: every
  // `checkProgram` reaches its walk through a caller that ran `initChecker` first
  // (`compileSrc`, `checkSrc`, `checkSrcSym`, `jwSecondPass`), so this is the one
  // reset surface, and a new checker module table has one place to go.
  cStructTyIxs = []
  cStructTyIxSet = []
  cStructNames = []
  cVariantMemberTyIxs = []
  cVariantMemberTyIxSet = []
  annPendingVariantTyIxs = []
  annPendingVariantTyIxSet = []
  cUnionTyIxs = []
  cUnionTyIxSet = []
  cUnionNames = []
  gaAppTyIxs = []
  gaAppTyIxSet = []
  gaAppHeads = []
  gaAppArgStart = []
  gaAppArgCount = []
  gaAppArgFlat = []
  gaAppFinite = []
  cPlainAliasNames = []
  cFillStmtIx = Map()
  cFillDoneAt = []
  cFillActive = false
  nwDeclNames = []
  nwTyIxs = []
  nwNames = []
  nwBaseTyIxs = []
  nwBodyScopedNames = Map()
  flNames = []
  flSizes = []
  flFStart = []
  flFCount = []
  flDeclNodes = []
  flFNames = []
  flFWidth = []
  flFNest = []
  flFOff = []
  cLitUnionCopyTyIxs = []
  cLitUnionCopyAliasIxs = []
  checkerArmed = true
  TY_I32 = mkPrim("i32")
  TY_I64 = mkPrim("i64")
  TY_F64 = mkPrim("f64")
  TY_F32 = mkPrim("f32")
  TY_BOOL = mkPrim("boolean")
  TY_STR = mkPrim("string")
  TY_VOID = mkPrim("void")
  TY_ERR = mkErrTy()
  TY_NULL = mkPrim("null")
  TY_NEVER = mkPrim("never")
  TY_U8 = mkPrim("u8")
  T.scopes.push(Map())
  constScopes = []
  constScopes.push(Map())
  fnDeclScopes = []
  fnDeclScopes.push(Map())
  fnAliasScopes = []
  fnAliasScopes.push(Map())
  pendNames = []
  pendTys = []
  pendAts = []
  pendDepths = []
  nhPendIxs = []
  nhPendTys = []
  nhPendDepths = []
  nhUnfilledIxs = []
  chPendNodes = []
  chPendTys = []
  chPendGiven = []
  npKeys = []
  npTys = []
  npInvBy = []
  npEpochs = []
  npFrames = []
  pgUpKeys = []
  pgUpTys = []
  pgUpArmIx = -1
  pgPreIx = -1
  pgPreKeys = []
  pgPreTys = []
  weSums = Map()
  weOpen = []
  weRoots = []
  weFnDecls = Map()
  weCut = 0
  asgSrcStack = []
  asgDstStack = []
  tyToStrDepth = 0
  asgDeclKeys = []
  asgDeclTys = []
  asgDeclDepths = []
  asgDeclKinds = []
  asgDeclEpochs = []
  asgDeclFrames = []
  narFnEpoch = 0
  reScopeBases = []
  reNpBases = []
  guardNames = []
  guardParamIdxs = []
  guardThens = []
  // LSP symbol-table data, cleared every check; the `symEnabled` mode flag is the driver's to
  // set, so it is not reset here. The global scope's decl frame is seeded to parallel the global
  // type scope `T.scopes` already pushed below.
  symOccTok = []
  symOccDecl = []
  symOccIsDecl = []
  symOccTy = []
  // Token-membership set mirroring `symOccTok` — reset in lockstep (see `symOccHasTok`).
  symOccTokSet = Map()
  symDeclScope = []
  symBindNode = []
  symBindType = []
  symBindKind = []
  symMemNode = []
  symMemTy = []
  symMemLine = []
  symMemCol = []
  symMemEndCol = []
  symVisName = []
  symVisNode = []
  symVisKind = []
  symVisSL = []
  symVisSC = []
  symVisEL = []
  symVisEC = []
  scopeSL = []
  scopeSC = []
  scopeEL = []
  scopeEC = []
  scopeResName = []
  scopeResKind = []
  scopeResType = []
  if symEnabled != 0 {
    symDeclScope.push(Map())
    // The global scope spans the whole file (looser than any nested scope).
    scopeSL.push(1)
    scopeSC.push(0)
    scopeEL.push(SCOPE_EOF)
    scopeEC.push(0)
  }
  // Memory intrinsics (host `defaultScope`): raw linear-memory stores/loads and
  // the `__log__` host hook used by low-level corpus programs.
  declare("__store_i32__", mkFuncTy([TY_I32, TY_I32], TY_VOID))
  declare("__store_i64__", mkFuncTy([TY_I32, TY_I64], TY_VOID))
  declare("__store_f32__", mkFuncTy([TY_I32, TY_F32], TY_VOID))
  declare("__store_f64__", mkFuncTy([TY_I32, TY_F64], TY_VOID))
  declare("__store_i8__", mkFuncTy([TY_I32, TY_I32], TY_VOID))
  declare("__store_i16__", mkFuncTy([TY_I32, TY_I32], TY_VOID))
  declare("__load_i32__", mkFuncTy([TY_I32], TY_I32))
  declare("__store_string__", mkFuncTy([TY_I32, TY_STR], TY_I32))
  declare("__log_string__", mkFuncTy([TY_I32, TY_I32], TY_VOID))
  declare("__log__", mkFuncTy([TY_I32, TY_I32], TY_VOID))
  declare("__memory_grow__", mkFuncTy([TY_I32], TY_I32))
  const noParams: i32[] = []
  declare("__memory_size__", mkFuncTy(noParams, TY_I32))
  declare("__memory_copy__", mkFuncTy([TY_I32, TY_I32, TY_I32], TY_VOID))
  declare("__memory_fill__", mkFuncTy([TY_I32, TY_I32, TY_I32], TY_VOID))
  // The load-width matrix (`buffer-design.md` §C2). Each VL signature is the wasm instruction's
  // signature, so there is nothing to choose beyond the name: the narrow loads all result in i32
  // because that is what the instruction does, and the `_s`/`_u` split is why both spellings
  // exist. The narrow stores truncate, so there is no `__store_u8__`/`__store_u16__` twin.
  declare("__load_i8__", mkFuncTy([TY_I32], TY_I32))
  declare("__load_u8__", mkFuncTy([TY_I32], TY_I32))
  declare("__load_i16__", mkFuncTy([TY_I32], TY_I32))
  declare("__load_u16__", mkFuncTy([TY_I32], TY_I32))
  declare("__load_i64__", mkFuncTy([TY_I32], TY_I64))
  declare("__load_f32__", mkFuncTy([TY_I32], TY_F32))
  declare("__load_f64__", mkFuncTy([TY_I32], TY_F64))
  // The filesystem floor (`std:fs`): ten host imports, which unlike everything above them do
  // not lower to instructions — a syscall is the one thing wasm cannot express. Bytes, not
  // strings, in both directions, so a payload crosses as one packed `u8[]` GC object. Errors are
  // out of band: a failing call answers an empty `u8[]` and `__fs_errno__()` carries WASI errno.
  const u8Arr = mkArrayTy(TY_U8)
  declare("__fs_read__", mkFuncTy([u8Arr], u8Arr))
  declare("__fs_write__", mkFuncTy([u8Arr, u8Arr], TY_I32))
  declare("__fs_list__", mkFuncTy([u8Arr], u8Arr))
  declare("__fs_stat__", mkFuncTy([u8Arr], TY_I32))
  declare("__fs_read_range__", mkFuncTy([u8Arr, TY_I64, TY_I32], u8Arr))
  declare("__fs_size__", mkFuncTy([u8Arr], TY_I64))
  declare("__fs_read_into__", mkFuncTy([u8Arr, TY_I64, TY_I32, TY_I32], TY_I32))
  declare("__args_count__", mkFuncTy(noParams, TY_I32))
  declare("__args_get__", mkFuncTy([TY_I32], u8Arr))
  declare("__fs_errno__", mkFuncTy(noParams, TY_I32))
  0
}

// The intrinsic names the emitter dispatches on at the call site, by name, before it looks up a
// declaration: each lowers to instructions inline. A user function of one of these names never
// runs — the call site is rewritten and the body silently discarded — so the rule is the name:
// reject the definition, where the author can see it. Exported because `capScan` needs the set.
export function nameIsEmitterIntrinsic(name: string) {
  if name == "__store_i32__" { return true }
  if name == "__load_i32__" { return true }
  if name == "__log__" { return true }
  if name == "__trap__" { return true }
  if name == "__array_new__" { return true }
  if name == "__array_new_default__" { return true }
  if name == "__array_copy__" { return true }
  // The load-width matrix and the two memory-size ops, lowered inline the same way — reserved
  // the same day they acquired an emitter arm, per this function's own rule.
  if nameIsMemLoadIntrinsic(name) { return true }
  // The five other store widths (three wide, two narrow), likewise reserved the day
  // each acquired its arm.
  if nameIsMemStoreIntrinsic(name) { return true }
  if name == "__memory_size__" { return true }
  if name == "__memory_grow__" { return true }
  // The bulk pair, reserved the day they acquired their arm.
  if nameIsMemBulkIntrinsic(name) { return true }
  // The filesystem floor. These lower to a `call` of a host import rather than to instructions,
  // but the reservation reason is identical and is about the call site, not the lowering:
  // `emitCall` matches these names before it looks up a declaration, so a user
  // `function __fs_read__(p: u8[]) { … }` would be discarded and every call become a syscall.
  if nameIsFsIntrinsic(name) { return true }
  false
}

// The bulk pair (`buffer-design.md` §C3): `__memory_copy__(dst, src, len)` → `memory.copy` and
// `__memory_fill__(dst, byte, len)` → `memory.fill`. All six operands are i32 and both results
// void, so unlike the store widths there is no width dispatch. Two semantics the signature does
// not show, both the instruction's: `len` is unsigned, so a negative one traps, and copy is memmove.
export function nameIsMemBulkIntrinsic(name: string) {
  if name == "__memory_copy__" { return true }
  if name == "__memory_fill__" { return true }
  false
}

// The seven new load widths. `__load_i32__` predates them and keeps its own arm at every call
// site, so it is deliberately not in this set. One list, consulted by the checker's definition
// reservation, the emitter's dispatch and the import scan, so the three cannot drift: a width
// missing from any one of them is a silent wrong answer.
export function nameIsMemLoadIntrinsic(name: string) {
  if name == "__load_i8__" { return true }
  if name == "__load_u8__" { return true }
  if name == "__load_i16__" { return true }
  if name == "__load_u16__" { return true }
  if name == "__load_i64__" { return true }
  if name == "__load_f32__" { return true }
  if name == "__load_f64__" { return true }
  false
}

// The five store widths that are not `__store_i32__` — the three wide duals of
// `__load_i64__`/`__load_f32__`/`__load_f64__`, and the two narrow ones, which truncate and so
// have no signed/unsigned split. Their value operand is an i32, unlike the wide three, so it
// takes the ordinary `emitMemIntrinArg` spine. One list, so its five consumers cannot drift.
export function nameIsMemStoreIntrinsic(name: string) {
  if name == "__store_i64__" { return true }
  if name == "__store_f32__" { return true }
  if name == "__store_f64__" { return true }
  if name == "__store_i8__" { return true }
  if name == "__store_i16__" { return true }
  false
}

// ── the filesystem floor: one ordered list, six readers ──────────────────────

// The slot is the identity of an fs intrinsic everywhere downstream, and the order below is the
// only place it is written, so a name added here appears in all six consumers or in none. The
// order is append-only: slot k's import index is assigned by counting the used slots below k, so
// inserting a name would move every later import's wasm function index. -1 for every other name.
export function fsIntrinsicSlot(name: string): i32 {
  if name == "__fs_read__" { return 0 }
  if name == "__fs_write__" { return 1 }
  if name == "__fs_list__" { return 2 }
  if name == "__fs_stat__" { return 3 }
  if name == "__args_count__" { return 4 }
  if name == "__args_get__" { return 5 }
  if name == "__fs_errno__" { return 6 }
  if name == "__fs_read_range__" { return 7 }
  if name == "__fs_size__" { return 8 }
  if name == "__fs_read_into__" { return 9 }
  -1
}

// How many fs slots exist. Every parallel table the emitter keeps (`gFsUse`, `gFsIdx`) is exactly
// this long, and every read of one is bound-checked against it — `emitFail` does not halt
// emission, so an out-of-bounds read here would trap a compiler that had already decided to fail.
export function fsIntrinsicCount(): i32 { 10 }

// The name at slot `k` — the inverse of `fsIntrinsicSlot`, used by the import and name
// sections, which iterate slots rather than spelling names. `""` for a slot out of
// range, which every caller treats as "emit nothing" rather than writing an empty name.
export function fsIntrinsicNameAt(k: i32): string {
  if k == 0 { return "__fs_read__" }
  if k == 1 { return "__fs_write__" }
  if k == 2 { return "__fs_list__" }
  if k == 3 { return "__fs_stat__" }
  if k == 4 { return "__args_count__" }
  if k == 5 { return "__args_get__" }
  if k == 6 { return "__fs_errno__" }
  if k == 7 { return "__fs_read_range__" }
  if k == 8 { return "__fs_size__" }
  if k == 9 { return "__fs_read_into__" }
  ""
}

// True when `name` is one of the ten. A projection of `fsIntrinsicSlot`, deliberately not a
// second `if`-chain: the two could not then disagree.
export function nameIsFsIntrinsic(name: string) { fsIntrinsicSlot(name) >= 0 }

// True when slot `k` takes a `u8[]` in argument position `a` (0-based). Drives the call lowering's
// per-argument context seeding — a `u8[]` operand threads the packed-list build kind so an empty
// `[]` literal argument builds the packed wrapper, while an i32 operand (`__args_get__`'s index)
// takes the ordinary width-cleared spine.
export function fsArgIsU8List(k: i32, a: i32) {
  if k == 0 { return a == 0 }
  if k == 1 { return a == 0 || a == 1 }
  if k == 2 { return a == 0 }
  if k == 3 { return a == 0 }
  if k == 7 { return a == 0 }
  if k == 8 { return a == 0 }
  if k == 9 { return a == 0 }
  false
}

// The declared arity of slot `k`. The emitter checks it before lowering, so a wrong-arity call is
// a named diagnostic rather than a stack shape that happens to validate.
export function fsIntrinsicArity(k: i32): i32 {
  if k == 1 { return 2 }
  if k == 4 { return 0 }
  if k == 6 { return 0 }
  if k == 5 { return 1 }
  if k == 7 { return 3 }
  if k == 8 { return 1 }
  if k == 9 { return 4 }
  if k >= 0 && k <= 3 { return 1 }
  -1
}

// True when slot `k` returns a `u8[]` (the packed wrapper) rather than an i32 — the split the type
// section's functype shapes and the emitter's result classification both turn on.
export function fsRetIsU8List(k: i32) { k == 0 || k == 2 || k == 5 || k == 7 }

// True when slot `k` takes an i64 in argument position `a` — a range read's byte offset into the
// FILE, which an i32 cannot address past 2 GiB. Read beside `fsArgIsU8List` by the functype
// writer and the call lowering, so every position is a packed list, an i64, or an i32.
export function fsArgIsI64(k: i32, a: i32) {
  if k == 7 { return a == 1 }
  if k == 9 { return a == 1 }
  false
}

// True when slot `k` returns an i64 rather than an i32 or the packed wrapper — a file size, for
// the same addressing reason. Read beside `fsRetIsU8List` by the same two.
export function fsRetIsI64(k: i32) { k == 8 }

// True when slot `k` writes into linear memory, so the module needs the memory emitted and
// exported even when it contacts it nowhere else. Without this a program whose only memory
// use is `__fs_read_into__` names a memory that does not exist, and the host has nowhere to
// write. Read by the use scan beside the memory intrinsics, which force it the same way.
export function fsSlotWritesMemory(k: i32) { k == 9 }

// The declared-but-unlowered memory intrinsics: names that pass `vl check` and then die at emit
// with `emitProgram: call to unknown function`, which reads like a mistyped identifier when the
// identifier is real and the implementation is what is missing. Two remain, `__store_string__`
// and `__log_string__`; each needs a design, not a table entry (`memory-gc-design.md` §1.2).
export function nameIsUnimplementedIntrinsic(name: string) {
  if name == "__store_string__" { return true }
  if name == "__log_string__" { return true }
  false
}

// The shared rejection for a definition that binds an emitter-intrinsic name. The reason half of
// the message is per-family, because the two families fail the same way for different reasons:
// the memory tier lowers to instructions, the filesystem tier to a `call` of a host import. Both
// discard the user's body, which is the part the author needs, but only one lowers inline.
function checkNotEmitterIntrinsic(name: string, at: i32) {
  // `__callsite__` is reserved for the same reason by a different mechanism: it is matched by
  // spelling in parameter-default position (`ast.paramDefaultIsCallsite`), before anything looks
  // up a declaration, so a module `const __callsite__` would look like a legal const default
  // while meaning the intrinsic. Not in `nameIsEmitterIntrinsic`: this name is never a callee.
  if name == CALLSITE_NAME {
    tErr(
      "'" +
        CALLSITE_NAME +
        "' is a compiler intrinsic and cannot be redefined — it is matched by name as a parameter default value, so this definition would never be read there",
      at,
    )
    return 0
  }
  // An extern name is a host import name: `emitCall` routes the call to the import, so a
  // definition of that name would never run — the same reason the fs floor is reserved.
  if externLinkOf(name) >= 0 {
    tErr(
      "'" +
        name +
        "' is declared `extern` — every call to it lowers to a host import, so this definition would never run",
      at,
    )
    return 0
  }
  if nameIsEmitterIntrinsic(name) {
    let how = "every call to it lowers to instructions inline"
    if nameIsFsIntrinsic(name) {
      how = "every call to it lowers to a host import"
    }
    tErr(
      "'" +
        name +
        "' is a compiler intrinsic and cannot be redefined — " +
        how +
        ", so this definition would never run",
      at,
    )
  }
  0
}

// D541 — a binary operator declared below module scope can never dispatch, the twin of the check
// directly above: a definition that would never run, refused at the definition rather than
// silently meaning something else at the site. `opSelfFnTy` resolves through `lookup(op)` and a
// nested `function "+"` binds in a node table, so this is a position rule, not a type rule.
function checkNotNestedBinOpDecl(name: string, at: i32) {
  if !isBinOpFuncName(name) { return 0 }
  if isTopLevelStmt(at) { return 0 }
  tErr(
    "operator `" +
      name +
      "` can never dispatch: a binary operator must be declared at MODULE SCOPE, and " +
      "this one is nested inside a function body or block — move it to the top level",
    at,
  )
  0
}

// Is `ix` one of the program's own top-level statements? `gRootStmts` is the `Program` node's
// statement list, stamped at the head of `checkProgram`, so this is the exact population the
// pass-1 hoist walks rather than a scope-depth heuristic. Scanned only for an operator-named
// declaration, which is why a linear walk is the right shape.
function isTopLevelStmt(ix: i32) {
  let i = 0
  while i < gRootStmts.length {
    if gRootStmts[i] == ix { return true }
    i = i + 1
  }
  false
}

// ── scope chain ──────────────────────────────────────────────────────────────

// ── flow narrowing (condition collectors) ────────────────────────────────────

// The canonical narrowing key for a place — a bare name (`x`), a property path rooted at one
// (`o.v`, `o.v.w`), or a constant-index element of either (`xs[0]`) — or "" for anything else.
// `x?.y` keys the same place as `x.y`, and a constant index names one storage cell for as long as
// nothing writes `xs` or that cell. Parentheses are not part of a place; that arm sits at the head.
function placeKeyOf(ix: i32) {
  const n = P.nodes[ix]
  if n is Paren { return placeKeyOf(n.parInner) }
  if n is Ident { return n.identName }
  if n is Member {
    const base = placeKeyOf(n.memObj)
    if base == "" { return "" }
    return base + "." + n.memProp
  }
  if n is OptMember {
    const base = placeKeyOf(n.omObj)
    if base == "" { return "" }
    return base + "." + n.omProp
  }
  if n is Index {
    const base = placeKeyOf(n.idxArr)
    if base == "" { return "" }
    const lit = subscriptKeyTextOf(n.idxIndex)
    if lit == "" { return "" }
    return base + "[" + lit + "]"
  }
  ""
}

// D1025 — the key text of a literal subscript: the digits of an integer literal, the raw lexeme
// (quotes and all) of a string literal, or `""` when the node is neither. The spelling is the key,
// so `xs[0]` and `xs[00]` are different keys — over-conservative in the harmless direction. The
// quotes keep the two grammars from colliding: `m[0]` and `m["0"]` are two different places.
function subscriptKeyTextOf(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return "" }
  const n = P.nodes[ix]
  if n is Paren { return subscriptKeyTextOf(n.parInner) }
  if n is NumLit {
    const t = n.numText
    if t.length < 1 { return "" }
    let i = 0
    while i < t.length {
      if t[i] < '0' || t[i] > '9' { return "" }
      i = i + 1
    }
    return t
  }
  if n is StrLit { return n.strText }
  ""
}

// The narrowing key of the receiver an index place is taken from — `"xs"` for `xs[i]`, `"o.xs"`
// for `o.xs[i]` — or `""` when the node is not an index or the receiver is not itself a place. It
// answers for a variable subscript too, which is the point: the write side needs to know which
// array a `xs[i] = …` may have hit even though it cannot say which cell.
function indexRootKeyOf(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return "" }
  const n = P.nodes[ix]
  if n is Paren { return indexRootKeyOf(n.parInner) }
  if n is Index { return placeKeyOf(n.idxArr) }
  ""
}

// The overlay slot of the innermost narrowing of `key`, or -1 when no live scope narrowed it. The
// single walk the three overlay questions share — the type, the invalidator, and how the slot
// sits relative to a loop barrier.
function narrowedPathIx(key: string) {
  let i = npKeys.length - 1
  while i >= 0 {
    if npKeys[i] == key { return i }
    i = i - 1
  }
  -1
}

// The innermost narrowed-path overlay entry for `key`, or -1, which means either "never narrowed"
// or "narrowed and since invalidated by an aliasing write or a falsifying assignment". One
// function answers "is this narrowing in force", so the member read arms and `placeCurTy`'s fact
// collection cannot disagree: after `clr(o)` a fresh guard re-derives from the declared type.
function narrowedPathTy(key: string) {
  const i = narrowedPathIx(key)
  if i < 0 { return -1 }
  if npInvBy[i] >= 0 { return -1 }
  npTys[i]
}

// The node that invalidated the innermost narrowing of `key`, or -1 when `key` is narrowed and in
// force, or never narrowed at all. The two states `narrowedPathTy` folds into -1 are told apart
// here, and only for the diagnostic: an unguarded nullable read keeps its existing message, an
// invalidated one names the call or the write.
function narrowedPathInvBy(key: string) {
  const i = narrowedPathIx(key)
  if i < 0 { return -1 }
  npInvBy[i]
}

// Whether `s` begins with `pfx`. The slice is bound before it is compared: a bare member call in
// tail position is not a lowerable statement — see `format.vl`'s note.
function keyHasPrefix(s: string, pfx: string) {
  if pfx.length > s.length { return false }
  const head = s.slice(0, pfx.length)
  head == pfx
}

// The sub-path of the place at `ix` below root name `root` — `o.v` under `o` is `"v"`, `o.a.v`
// under `o` is `"a.v"`. `""` when the place is not rooted at `root`, is `root` itself, or is not a
// keyable place at all. A cell below a field is a sub-path (`o.xs[0]`) and rides the
// `,`-terminated vocabulary untouched; a cell of the root itself answers `""` (inventory-2 D452).
function placeSubPath(ix: i32, root: string) {
  const k = placeKeyOf(ix)
  if k == "" || k == root { return "" }
  const pfx = root + "."
  if !keyHasPrefix(k, pfx) { return "" }
  const sub = k.slice(pfx.length, k.length)
  sub
}

// Write-effect summaries for the effect-based invalidation rule, keyed `"<fn-node-ix>#<param-ix>"`.
// A value is either the opaque token `"*"` — assume the callee writes everything reachable through
// that parameter — or a `,`-terminated list of the field sub-paths it may write. A recursive cycle
// answers `"*"`: a summary that guesses must guess closed. `""` is a value, so presence uses `has`.
let weSums: {[string]: string} = Map()
let weOpen: string[] = []

// The function bodies currently being summarised, innermost last. A call inside a callee body may
// name a function declared in that body, or in a sibling frame of it, and `lookupFnDeclNode` reads
// the caller's scope chain, where neither is visible — answering "not a function" there makes the
// whole nested-write route fail open.
let weRoots: i32[] = []

// Counts cycles cut during the walk, so a provisional summary is not cached. Cutting a cycle at ⊥
// and iterating is the least fixpoint of a may-write analysis, and for the key queried the first
// pass already reaches it. An inner key on the cycle does not: `g` computed while `f` is open is
// missing `f`'s own writes, so caching it would answer a later query with too small a summary.
let weCut = 0

// Answer a recursive cycle opaque instead of ⊥ — the strictly-fail-closed reading. It is sound but
// costs every read-only recursive callee, newly rejecting correct programs of that one shape where
// the fixpoint rejects none. Kept as a switch, the conservative fallback if the fixpoint argument
// above is ever found wanting.
const ALIAS_CYCLE_OPAQUE = false

// Set to make every statically-known callee answer opaque — the broad rule, "any call receiving
// the object invalidates every narrowing rooted at it" — kept as one switch so the two candidate
// rules are one code path and one measurement harness. The effect-based rule is what ships;
// `docs/internals/open-rulings.md`.
const ALIAS_RULE_BROAD = false

// Split a `,`-terminated effect summary into its sub-paths.
function weSplit(s: string) {
  const out: string[] = []
  let start = 0
  let i = 0
  while i < s.length {
    if s[i] == ',' {
      if i > start { out.push(s.slice(start, i)) }
      start = i + 1
    }
    i = i + 1
  }
  out
}

// The write-effect summary of parameter `paramIx` of the `FuncDecl` at `fnIx`.
function fnWriteEffects(fnIx: i32, paramIx: i32) {
  const key = i32ToStr(fnIx) + "#" + i32ToStr(paramIx)
  // One probe, not two — see `fnWriteFreePaths` for the note.
  const weHit = weSums[key]
  if weHit is string { return weHit }
  if weIsOpen(key) { return weCycleAnswer() }
  const fd = P.nodes[fnIx]
  if fd is FuncDecl {
    const ps = fd.fnParams
    if paramIx >= 0 && paramIx < ps.length {
      const p = P.nodes[ps[paramIx]]
      if p is Param {
        const cutBefore = weCut
        weOpen.push(key)
        weRoots.push(fd.fnBody)
        const acc = weScan(fd.fnBody, p.parName)
        weRoots.pop()
        weOpen.pop()
        weCache(key, acc, cutBefore)
        return acc
      }
    }
  }
  "*"
}

// Whether a summary for `key` is already being computed higher in the recursion.
function weIsOpen(key: string) {
  let i = 0
  while i < weOpen.length {
    if weOpen[i] == key { return true }
    i = i + 1
  }
  false
}

// What a cut cycle answers: ⊥ for the fixpoint reading, opaque for the strict one.
function weCycleAnswer() {
  weCut = weCut + 1
  if ALIAS_CYCLE_OPAQUE { return "*" }
  ""
}

// Cache a summary unless it is provisional — computed with a cycle cut while another summary is
// still open, which is the one case the first pass leaves too small.
function weCache(key: string, acc: string, cutBefore: i32) {
  if weCut != cutBefore && weOpen.length > 0 { return 0 }
  weSums[key] = acc
  0
}

// The `FuncDecl` named `name` declared inside any body currently being summarised,
// innermost frame first, or -1.
function findFnDeclInRoots(name: string) {
  let i = weRoots.length - 1
  while i >= 0 {
    const d = findFnDeclIn(weRoots[i], name)
    if d >= 0 { return d }
    i = i - 1
  }
  -1
}

// The subtree walk, memoised on `(rootIx, name)`: every query inside one summary asks the same
// root, and an intrinsic call asks a name no root holds, so the uncached walk makes one summary
// quadratic in the body's call count. The negative answer is the one worth banking. Keying on the
// root is load-bearing — a name-only memo can answer a declaration this walk would never reach.
function findFnDeclIn(rootIx: i32, name: string) {
  if rootIx < 0 || rootIx >= P.nodes.length { return -1 }
  const key = i32ToStr(rootIx) + "#" + name
  const wfHit = weFnDecls[key]
  if wfHit is i32 { return wfHit }
  const d = findFnDeclWalk(rootIx, name)
  weFnDecls[key] = d
  d
}

// Memo bank for `findFnDeclIn`, keyed `"<subtree-root-node-ix>#<name>"`.
let weFnDecls: {[string]: i32} = Map()

// The uncached pre-order walk: the first `FuncDecl` named `name` in the subtree, the root itself
// included, or -1.
function findFnDeclWalk(rootIx: i32, name: string) {
  if rootIx < 0 || rootIx >= P.nodes.length { return -1 }
  const n = P.nodes[rootIx]
  if n is FuncDecl {
    if n.fnName == name { return rootIx }
  }
  const kids = nodeChildren(rootIx)
  let i = 0
  while i < kids.length {
    const d = findFnDeclWalk(kids[i], name)
    if d >= 0 { return d }
    i = i + 1
  }
  -1
}

// Accumulate the field sub-paths a subtree may write through the parameter named `pname`, or `"*"`
// for opaque: the parameter escaping into a field, an element or a return, an indirect call whose
// target is not statically one `FuncDecl`, or a call whose declaration does not resolve at all.
// Nested `FuncDecl`s are descended, and one shadowing `pname` over-approximates, the safe direction.
function weScan(ix: i32, pname: string) {
  if ix < 0 || ix >= P.nodes.length { return "" }
  let acc = ""
  const n = P.nodes[ix]
  if n is BinExpr {
    if n.binOp == "=" {
      const sub = placeSubPath(n.binLeft, pname)
      if sub != "" { acc = acc + sub + "," }
      // the parameter itself stored into the heap — it escapes
      if placeKeyOf(n.binRight) == pname { return "*" }
    }
  } else if n is RetStmt {
    if n.retArg >= 0 {
      if placeKeyOf(n.retArg) == pname { return "*" }
    }
  } else if n is Call {
    const inner = callEffectsOn(ix, pname)
    if inner == "*" { return "*" }
    acc = acc + inner
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    const sub = weScan(kids[i], pname)
    if sub == "*" { return "*" }
    acc = acc + sub
    i = i + 1
  }
  acc
}

// The field sub-paths a call inside a callee body may write through `pname`, by composing the
// nested callee's own summary: passing `pname.a` where the nested callee writes `v` through that
// parameter is a write of `a.v` here.
function callEffectsOn(callIx: i32, pname: string) {
  const cn = P.nodes[callIx]
  if cn is Call { return callEffectsOnReal(cn, pname) }
  ""
}

function callEffectsOnReal(cn: Call, pname: string) {
  const declIx = callDeclFnIx(cn)
  // An intrinsic cannot write a field of anything handed to it, so a body whose only use of the
  // parameter is `print(p.v)` has no write effect. Distinguishing this from the opaque `-1` keeps
  // a read-only callee from invalidating its caller's narrowings — the false positive that
  // decides whether the rule is usable at all.
  if declIx == -2 { return "" }
  const args = callArgPlaces(cn)
  let acc = ""
  let i = 0
  while i < args.length {
    const ak = placeKeyOf(args[i])
    let rooted = ak == pname
    let below = ""
    if !rooted {
      const s = placeSubPath(args[i], pname)
      if s != "" {
        rooted = true
        below = s + "."
      }
    }
    if rooted {
      if declIx < 0 {
        return "*" // indirect / unresolvable callee
      }
      const sum = fnWriteEffects(declIx, i)
      if sum == "*" { return "*" }
      const parts = weSplit(sum)
      let j = 0
      while j < parts.length {
        acc = acc + below + parts[j] + ","
        j = j + 1
      }
    }
    i = i + 1
  }
  acc
}

// A call's argument places in callee-parameter order. A UFCS or method callee (`o.m(a)`) puts the
// receiver at parameter 0, which is how `m(o, a)` declares it; every other shape is the written
// argument list.
function callArgPlaces(cn: Call) {
  const out: i32[] = []
  const cf = P.nodes[cn.callFn]
  if cf is Member {
    if lookupFnDeclNode(cf.memProp) >= 0 { out.push(cf.memObj) }
  }
  let i = 0
  while i < cn.callArgs.length {
    out.push(cn.callArgs[i])
    i = i + 1
  }
  out
}

// The callee classification behind every invalidation decision: `>= 0` is the `FuncDecl` the call
// resolves to statically, with a UFCS receiver at parameter 0; `-1` is opaque — a function value,
// a struct field holding one, or an unresolved receiver — so assume it writes anything reachable;
// `-2` is an intrinsic, which writes no field of an object handed to it.
function callDeclFnIx(cn: Call) {
  const cf = P.nodes[cn.callFn]
  if cf is Ident {
    const d = lookupFnDeclNode(cf.identName)
    if d >= 0 { return d }
    const nd = findFnDeclInRoots(cf.identName)
    if nd >= 0 { return nd }
    if lookup(cf.identName) >= 0 {
      return -1 // a function VALUE: target unknown
    }
    return -2 // an intrinsic named by a bare identifier
  }
  if cf is Member {
    const d = lookupFnDeclNode(cf.memProp)
    if d >= 0 { return d }
    const nd = findFnDeclInRoots(cf.memProp)
    if nd >= 0 { return nd }
    return memberCalleeKind(cf)
  }
  -1
}

// A non-UFCS member callee: a struct field holding a function is opaque, the value it holds not
// being statically one body; anything else is a collection or string method.
function memberCalleeKind(cf: Member) {
  const rt = nodeTyOf(cf.memObj)
  if rt < 0 {
    return -1 // receiver type unresolved → fail closed
  }
  const t = T.tys[rt]
  if t is TyObj {
    if objFieldType(t, cf.memProp) >= 0 { return -1 }
  }
  -2
}

// The type recorded for a node by the check that already visited it, or -1.
function nodeTyOf(ix: i32) {
  if ix < 0 || ix >= nodeTyIx.length { return -1 }
  nodeTyIx[ix]
}

// The names a function binds: its parameters, every `let`/`const` in its body at any depth, both
// `for` variables, and every nested function's parameters and name. A write rooted at one of these
// is local business; a write rooted at anything else is a write through a free variable, which is
// the caller's binding.
function fnBoundNames(fnIx: i32, out: string[]) {
  const n = P.nodes[fnIx]
  if n is FuncDecl {
    let i = 0
    while i < n.fnParams.length {
      const p = P.nodes[n.fnParams[i]]
      if p is Param { out.push(p.parName) }
      i = i + 1
    }
  }
  if n is LetDecl { out.push(n.letName) }
  if n is ForRange { out.push(n.frVar) }
  if n is ForIn { out.push(n.fiVar) }
  const kids = nodeChildren(fnIx)
  let k = 0
  while k < kids.length {
    if kids[k] >= 0 { fnBoundNames(kids[k], out) }
    k = k + 1
  }
  0
}

function nameIn(names: string[], name: string) {
  let i = 0
  while i < names.length {
    if names[i] == name { return true }
    i = i + 1
  }
  false
}

// The full place keys a function writes through a free variable — a captured local or a
// module-level binding — `,`-terminated, or `"*"` for opaque. This channel exists because the
// parameter channel is keyed on arguments, so a callee that takes none is invisible to it:
// `function zap() { o.v = null }` inside a guard is exactly as falsifying as `clr(o)`.
function fnWriteFreePaths(fnIx: i32) {
  const key = i32ToStr(fnIx) + "#free"
  // One probe, not two: a `.has` guard does not narrow a later `m[k]`, since `m[k]` is not a stable
  // place, so the guarded form probes the map twice. Binding once and narrowing the binding is the
  // fix the `map-has-guard-reread` lint names, and this is a memo lookup on the write-effect path,
  // so it is the hot shape rather than an incidental one.
  const weHit = weSums[key]
  if weHit is string { return weHit }
  if weIsOpen(key) { return weCycleAnswer() }
  const fd = P.nodes[fnIx]
  if fd is FuncDecl {
    const bound: string[] = []
    fnBoundNames(fnIx, bound)
    const cutBefore = weCut
    weOpen.push(key)
    weRoots.push(fd.fnBody)
    const acc = weScanFree(fd.fnBody, bound)
    weRoots.pop()
    weOpen.pop()
    weCache(key, acc, cutBefore)
    return acc
  }
  "*"
}

// Accumulate the free-variable place keys a subtree writes, composing a nested known
// callee's own free writes. An opaque nested callee makes the whole answer opaque.
function weScanFree(ix: i32, bound: string[]) {
  if ix < 0 || ix >= P.nodes.length { return "" }
  let acc = ""
  const n = P.nodes[ix]
  if n is BinExpr {
    if n.binOp == "=" {
      const k = placeKeyOf(n.binLeft)
      if k != "" && isPathKey(k) {
        if !nameIn(bound, placeRootOf(k)) { acc = acc + k + "," }
      }
    }
  } else if n is Call {
    const inner = callFreeEffects(ix)
    if inner == "*" { return "*" }
    acc = acc + inner
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    const sub = weScanFree(kids[i], bound)
    if sub == "*" { return "*" }
    acc = acc + sub
    i = i + 1
  }
  acc
}

// The free-variable writes a nested call contributes. An intrinsic contributes none; an opaque
// callee makes the answer opaque.
function callFreeEffects(callIx: i32) {
  const cn = P.nodes[callIx]
  if cn is Call {
    const d = callDeclFnIx(cn)
    if d == -2 { return "" }
    if d < 0 { return "*" }
    return fnWriteFreePaths(d)
  }
  ""
}

// The root name of a place key (`"o.a.v"` → `"o"`, `"xs[0].v"` → `"xs"`). Both separators, because
// the one caller asks whether the root is bound in the callee, and a key whose root split answered
// `"xs[0]"` matches no binding, so a nested function's own `xs` would not shadow the free one.
function placeRootOf(key: string) {
  let i = 0
  while i < key.length {
    if key[i] == '.' || key[i] == '[' {
      const head = key.slice(0, i)
      return head
    }
    i = i + 1
  }
  key
}

// The one place that decides whether the call at `callIx` invalidates the path narrowing keyed
// `key`. The rule is effect-based: `key` dies only when some argument place of the call is a prefix
// of `key` and the callee may write, through that parameter, a sub-path that is a prefix of the
// rest. It fails closed at every edge, and it is keyed on the syntactic argument, so aliases live.
function callInvalidatesNarrowedPath(callIx: i32, key: string) {
  const cn = P.nodes[callIx]
  if cn is Call { return callInvalidatesReal(cn, key) }
  false
}

// The collection methods that can remove a cell — the only intrinsic calls that falsify a narrowing
// of a cell of their own receiver. Deliberately not `cwMutatesList`'s whole set: `push` appends and
// `set`/`add` insert, none of which can take `xs[0]` or `m["a"]` away, and retiring on those would
// end a narrowing the guard still proves.
function cellRemovingMethod(p: string): boolean {
  if p == "delete" { return true }
  if p == "clear" { return true }
  if p == "pop" { return true }
  false
}

// The cell a `delete(<literal>)` names, as its key text, or "" when the call names no single cell
// (`clear` / `pop` take no key; a variable key names none). Same rule as a write target: a literal
// subscript names its cell and nothing else, anything else may have hit any of them.
function removedCellKeyText(cn: Call, prop: string): string {
  if prop != "delete" { return "" }
  if cn.callArgs.length != 1 { return "" }
  subscriptKeyTextOf(cn.callArgs[0])
}

function callInvalidatesReal(cn: Call, key: string) {
  const declIx = callDeclFnIx(cn)
  // A cell-removing collection method retires that cell's narrowings, and it has to be asked
  // first because it reaches neither leg below: an intrinsic answers `-2` on the next line, and
  // `callArgPlaces` puts a receiver in the argument list only for a UFCS call. The key argument
  // is read exactly as a write target is — a literal names its cell, anything else may hit any.
  const rmRecv = P.nodes[cn.callFn]
  if rmRecv is Member {
    if cellRemovingMethod(rmRecv.memProp) {
      const rmRoot = placeKeyOf(rmRecv.memObj)
      if rmRoot != "" {
        const rmLit = removedCellKeyText(cn, rmRecv.memProp)
        if rmLit == "" {
          if keyHasPrefix(key, rmRoot + "[") { return true }
        } else {
          const rmCell = rmRoot + "[" + rmLit + "]"
          if key == rmCell { return true }
          if keyHasPrefix(key, rmCell + ".") { return true }
          if keyHasPrefix(key, rmCell + "[") { return true }
        }
      }
    }
  }
  // An intrinsic writes no object field. The broad rule as filed does not make that distinction
  // — "any call that receives the object" includes `print(o)` — so the switch bypasses this too,
  // and the two measurements compare the filed rules rather than a hybrid.
  if declIx == -2 && !ALIAS_RULE_BROAD { return false }
  // An opaque callee invalidates every live narrowing, not only the ones rooted at its arguments:
  // a closure that captured the object takes no argument, so an argument-keyed fallback would
  // fail open on exactly the construct that has no statically known body.
  if declIx < 0 { return true }
  // Writes through a free variable, which likewise need no argument.
  const free = fnWriteFreePaths(declIx)
  if free == "*" { return true }
  if pathHitsAny(key, free, "") { return true }
  const args = callArgPlaces(cn)
  let i = 0
  while i < args.length {
    const ak = placeKeyOf(args[i])
    if ak != "" {
      if key == ak { return true }
      // An index cell of an argument dies to any call that receives the array, with no effect
      // refinement — the deliberately blunt half of this rule. The summaries are `,`-terminated
      // field sub-paths and an index write records nothing in one, so consulting them here would
      // read "writes nothing" for the callee that nulls the cell (inventory-2 D452).
      if keyHasPrefix(key, ak + "[") { return true }
      const pfx = ak + "."
      if keyHasPrefix(key, pfx) {
        if ALIAS_RULE_BROAD { return true }
        const sum = fnWriteEffects(declIx, i)
        if sum == "*" { return true }
        const rest = key.slice(pfx.length, key.length)
        if pathHitsAny(rest, sum, "") { return true }
      }
    }
    i = i + 1
  }
  false
}

// Whether any written sub-path in the `,`-terminated summary `sum` (each optionally carried under
// `under`) is `path` itself or a prefix of it. Writing `o.a` replaces the sub-object, so it kills
// `o.a.v` as surely as writing `o.a.v` does.
function pathHitsAny(path: string, sum: string, under: string) {
  const parts = weSplit(sum)
  let j = 0
  while j < parts.length {
    const w = under + parts[j]
    if path == w || keyHasPrefix(path, w + ".") { return true }
    j = j + 1
  }
  false
}

// Re-execution barriers: the scope depth and overlay height at entry to each open loop body and
// nested-function body, innermost last. A narrowing retires at a falsifying write because the
// statements after the write run with it gone — a statement-order fact a loop body breaks, since
// the reads textually before the write run again after it. Below the mark a write keeps its reject.
let reScopeBases: i32[] = []
let reNpBases: i32[] = []

// Enter or leave a re-execution barrier. Call before the body's narrowing scope is pushed, so a
// narrowing the loop's own condition contributes counts as inside.
function pushReBarrier() {
  reScopeBases.push(T.scopes.length)
  reNpBases.push(npKeys.length)
  0
}
function popReBarrier() {
  if reScopeBases.length > 0 {
    reScopeBases.pop()
    reNpBases.pop()
  }
  0
}

// Whether a bare-name narrowing shadowing at scope depth `depth` sits inside the innermost open
// barrier — i.e. is re-established every time the write runs.
function narInsideBarrier(depth: i32) {
  if reScopeBases.length == 0 { return true }
  depth >= reScopeBases[reScopeBases.length - 1]
}

// The same question for a property-path narrowing, by overlay slot.
function npInsideBarrier(npIx: i32) {
  if reNpBases.length == 0 { return true }
  npIx >= reNpBases[reNpBases.length - 1]
}

// Whether a live narrowing does overlay the write target but sits below the innermost re-execution
// barrier — the one reason `writeStorageTy` answers -1 for a place a narrowing covers. Asked only
// to choose the diagnostic: the write is refused either way, but "cannot assign null to i32" says
// nothing about why the same write one block out is fine.
function writeBarredByLoop(ix: i32) {
  const n = P.nodes[ix]
  if n is Ident {
    if narDeclaredTy(n.identName, NAR_KIND_GUARD) < 0 { return false }
    return !narInsideBarrier(lookupDepth(n.identName))
  }
  if n is Member || n is Index {
    const key = placeKeyOf(ix)
    if key == "" { return false }
    const slot = narrowedPathIx(key)
    if slot < 0 || npInvBy[slot] >= 0 { return false }
    return !npInsideBarrier(slot)
  }
  false
}

// The diagnostic for a write the re-execution barrier refuses. It names the loop rather
// than the type, because the type is fine: the same write one block further out is
// accepted, and so is this one under a guard the loop itself re-tests.
function writeBarredErr(place: string, at: i32) {
  tErr(
    "'" +
      place +
      "' was narrowed by a guard OUTSIDE this loop, so this write would leave the " +
      "reads before it reading null on the next iteration — move the write out of " +
      "the loop, or make the guard on '" +
      place +
      "' the loop's own condition",
    at,
  )
  0
}

// The storage type of an assignment target — what the place can hold, as against what a narrowing
// currently proves it holds — or -1 when no live narrowing overlays the place and the flow type is
// the storage type. A bare name reads the narrowing bank, since the guard's `declare` hid the
// declaration; a property path reads the field off the receiver's type. -1 across a barrier.
function writeStorageTy(ix: i32) {
  const n = P.nodes[ix]
  if n is Ident {
    // An assignment narrowing's null write is accepted today, barrier or not — and
    // `let x: i32 | null = null` / `x = 5` / `while c { use(x)   x = null }` is a correct program
    // for a single-iteration loop, so barring it would newly reject working code. Only the
    // guard-kind acceptance is bounded.
    const gSlot = narGuardSlot(n.identName)
    if gSlot >= 0 {
      if asgDeclEpochs[gSlot] != narFnEpoch { return -1 }
      if !narInsideBarrier(lookupDepth(n.identName)) { return -1 }
      return asgDeclTys[gSlot]
    }
    return narDeclaredTy(n.identName, NAR_KIND_ASG)
  }
  if n is Member {
    const key = placeKeyOf(ix)
    if key == "" { return -1 }
    const slot = narrowedPathIx(key)
    if slot < 0 { return -1 }
    // An already-retired narrowing still answers, and bailing on `npInvBy[slot] >= 0` here is an
    // ordering bug inside one statement: `lt` is read off the target before the right-hand side is
    // checked, so a callee that retires the path mid-statement would leave `asgLt` at a type the
    // storage never had. A retired narrowing means the place reads at its declared type.
    if npEpochs[slot] != narFnEpoch { return -1 }
    if !npInsideBarrier(slot) { return -1 }
    const noNames: string[] = []
    const noTys: i32[] = []
    return placeFieldTy(placeCurTy(n.memObj, noNames, noTys), n.memProp, false)
  }
  // An index cell is storage too, and this arm is not optional once a cell can be narrowed:
  // `if xs[0] != null { xs[0] = null }` runs when no narrowing covers the target, and without this
  // it would newly reject `cannot assign null to i32[]` — a working program lost to a rule whose
  // whole point is that it never shrinks what storage holds. Same three guards as the member arm.
  if n is Index {
    const key = placeKeyOf(ix)
    if key == "" { return -1 }
    const slot = narrowedPathIx(key)
    if slot < 0 { return -1 }
    if npEpochs[slot] != narFnEpoch { return -1 }
    if !npInsideBarrier(slot) { return -1 }
    const noNames: string[] = []
    const noTys: i32[] = []
    return placeElemTy(placeCurTy(n.idxArr, noNames, noTys))
  }
  -1
}

// Does a write to `tgtKey` of a value typed `rt` retire the narrowing `(key, npTy)`? The one home
// for that question, so the bare-name and property-path sides cannot disagree. An exact match
// consults `rt` — a write the narrowing still admits keeps it — while a prefix match, in either
// separator, retires unconditionally. An unkeyable target keys "" and its caller handles it.
function writeRetiresNarrowing(
  tgtKey: string,
  rt: i32,
  key: string,
  npTy: i32,
) {
  if tgtKey == "" { return false }
  if key == tgtKey { return !assignable(rt, npTy) }
  if keyHasPrefix(key, tgtKey + ".") { return true }
  keyHasPrefix(key, tgtKey + "[")
}

// Retire every narrowing the accepted write at `atIx` falsifies, in place — never by pushing a
// shadowing entry, which would unwind at the end of whatever inner block holds the write and
// resurrect the narrowing for the statements after it. A property path is marked in `npInvBy`; a
// bare name's narrowing is a shadowing `declare`, so retiring it writes the declared type back.
function retireNarrowingsForWrite(tgtIx: i32, rt: i32, atIx: i32) {
  const tgtKey = placeKeyOf(tgtIx)
  // A variable-index write names no cell and therefore may have hit any of them. `xs[i] = null`
  // keys "" and the loop below would retire nothing at all, which is a soundness hole the moment
  // a narrowing can name a cell. Retire every live narrowing under the receiver; the cell keys
  // (`xs[0].v` as well as `xs[0]`) go with it through the same prefix.
  if tgtKey == "" {
    const root = indexRootKeyOf(tgtIx)
    if root == "" { return 0 }
    const pfx = root + "["
    let r = 0
    while r < npKeys.length {
      if keyHasPrefix(npKeys[r], pfx) { npInvBy[r] = atIx }
      r = r + 1
    }
    return 0
  }
  let i = 0
  while i < npKeys.length {
    // The write's attribution wins over a call's, and the overwrite is what makes the read below
    // legible: `w.f = mk()` is one statement whose right-hand side is checked first, so an opaque
    // `mk` marks the path and the write would otherwise be reported as the call's. The cause is
    // what `pathRetiredByAssign` reads to decide whether the emitter can see the retirement.
    if writeRetiresNarrowing(tgtKey, rt, npKeys[i], npTys[i]) {
      npInvBy[i] = atIx
    }
    i = i + 1
  }
  const tn = P.nodes[tgtIx]
  if tn is Ident {
    const nm = tn.identName
    const dcl = narDeclaredTy(nm, -1)
    if dcl >= 0 {
      if writeRetiresNarrowing(nm, rt, nm, lookup(nm)) {
        // The declared type goes back into the scope the narrowing shadowed, so a later write to
        // the same name is checked against the storage again.
        const d = lookupDepth(nm)
        if d >= 0 { T.scopes[d][nm] = dcl }
      }
    }
  }
  0
}

// Mark every live narrowing the call at `callIx` invalidates. Runs after the call's own arguments
// are checked, so `f(o.v.length, o)` still reads `o.v` under the narrowing in force as that
// argument is evaluated.
function noteCallInvalidations(callIx: i32) {
  if npKeys.length == 0 { return 0 }
  let i = 0
  while i < npKeys.length {
    if npInvBy[i] < 0 {
      if callInvalidatesNarrowedPath(callIx, npKeys[i]) { npInvBy[i] = callIx }
    }
    i = i + 1
  }
  0
}

// The source line of a node, or 0 when it has no anchor token.
function nodeLineOf(at: i32) {
  if at >= 0 && at < nodeToks.length {
    const tk = nodeToks[at]
    if tk >= 0 && tk < P.toks.length { return P.toks[tk].line }
  }
  0
}

// The callee's written name, for the diagnostic. `"?"` when the callee is neither a
// bare name nor a member access (a parenthesised or computed callee).
function calleeNameOf(callIx: i32) {
  const cn = P.nodes[callIx]
  if cn is Call {
    const cf = P.nodes[cn.callFn]
    if cf is Ident { return cf.identName }
    if cf is Member { return cf.memProp }
  }
  "?"
}

// Did an assignment, rather than a call, retire this narrowing? Both causes write the same
// `npInvBy` column and need different answers, so the question has one home. A direct `w.f = e` is
// a statement the emit walk passes over exactly as it passes `f = e`, and the emit half retires
// it, so the call cause keeps the refusal and the assignment cause reads at the declared type.
function pathRetiredByAssign(byIx: i32) {
  if byIx < 0 { return false }
  !(P.nodes[byIx] is Call)
}

// The diagnostic for reading a path whose narrowing a write retired. It names the write, not
// merely the nullness, because the write is what the reader has to act on — the guard above and
// the read below are both correct, and only their separation is wrong. An aliasing call and a
// direct assignment are the two ways a path narrowing dies, and the message says which.
function pathInvalidatedErr(key: string, byIx: i32, at: i32) {
  const by = P.nodes[byIx]
  let what = "the assignment"
  let after = "the assignment"
  if by is Call {
    what = "the call to '" + calleeNameOf(byIx) + "'"
    after = "the call"
  }
  tErr(
    "'" +
      key +
      "' was narrowed by a guard, but " +
      what +
      " on line " +
      i32ToStr(nodeLineOf(byIx)) +
      " can write it — re-test '" +
      key +
      "' after " +
      after,
    at,
  )
  TY_ERR
}

// The node index of the place compared against `null` in a `x == null` /
// `x != null` / `null == x` comparison, or -1 (not a null compare).
function nullCmpPlace(condIx: i32) {
  const cond = P.nodes[condIx]
  if cond is BinExpr {
    const lhs = P.nodes[cond.binLeft]
    const rhs = P.nodes[cond.binRight]
    if rhs is NullLit { return cond.binLeft }
    if lhs is NullLit { return cond.binRight }
  }
  -1
}

// Whether `ty` is the `null` primitive (compared structurally — `null` may be
// interned more than once across annotations).
function isNullTy(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyPrim { return t.primName == "null" }
  false
}

// Whether `ty` is the `void` primitive, compared structurally — like `null`, `void` may be
// interned at more than one arena index, so `== TY_VOID` is not reliable.
function isVoidTy(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyPrim { return t.primName == "void" }
  false
}

// Whether `ty` carries a `void` — the primitive itself, or a `void` member of a union or nullable.
// No value has such a type: `void | i32` is what an if-expression with one void arm and one value
// arm joins to, and it reaches a value slot exactly where a plain `void` does. Depth-bounded, and
// composites are deliberately not descended: a `void` inside one is refused at its own slot.
function tyMentionsVoid(ty: i32, depth: i32) {
  if ty < 0 { return false }
  if depth <= 0 { return false }
  if isVoidTy(ty) { return true }
  const t = T.tys[ty]
  if t is TyUnion {
    const ms = t.uMembers
    let mi = 0
    while mi < ms.length {
      if tyMentionsVoid(ms[mi], depth - 1) { return true }
      mi = mi + 1
    }
    return false
  }
  if t is TyNullable { return tyMentionsVoid(t.nInner, depth - 1) }
  false
}

// Whether the expression at `exprIx` (peeled through parens) is a `match` — the void-typed
// expression form every void-in-value-slot gate exempts, and the one predicate all of them ask.
// An if-expression is not exempt: an else-less `if` used as a value is `T | null` in every value
// position, so an `if` that still types `void` here has a void arm, which is what the gates catch.
function voidSlotExemptExpr(exprIx: i32) {
  if exprIx < 0 { return false }
  let vi = exprIx
  const vp = P.nodes[vi]
  if vp is Paren { vi = vp.parInner }
  const vn = P.nodes[vi]
  if vn is MatchExpr { return true }
  false
}

// A `void` expression has no value, so a slot that demands one is a type error. This is the one
// home for that verdict on the positions whose demanded type comes from inference: with no written
// type there is nothing for `assignable` to compare against. `slot` names the demanding position,
// and the answer says whether the slot is refused, so the caller can substitute `TY_ERR`.
function voidValueSlotErr(ty: i32, exprIx: i32, slot: string, at: i32) {
  if !tyMentionsVoid(ty, 8) { return false }
  // The provisional-void exemption covers a wholly void if/match only: a union that mentions void
  // is a mixed arm join (`if c { f() } else { 1 }`), where the void is one arm's real type and no
  // position resolves it away.
  if isVoidTy(ty) {
    if voidSlotExemptExpr(exprIx) { return false }
  }
  tErr(slot + " expects a value, got " + tyToStr(ty), at)
  true
}

// Whether `ty` is exactly `string | null` — a `TyNullable` wrapping the `string` primitive. Cheap,
// with no `tyToStr`; it records an inferred niche if-binding.
function isNulStringTy(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    const inr = t.nInner
    if inr < 0 { return false }
    const it = T.tys[inr]
    if it is TyPrim { return it.primName == "string" }
  }
  false
}

// Whether `ty` admits null — a `TyNullable`, the bare `null` prim, or a union with a `null` member.
// Gates the completion coercion: an object literal may omit a field whose declared type admits
// null, since it is materialized as `null` at construction.
function tyAdmitsNull(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable { return true }
  if t is TyPrim { return t.primName == "null" }
  if t is TyUnion {
    const ms = t.uMembers
    let i = 0
    while i < ms.length {
      if isNullTy(ms[i]) { return true }
      i = i + 1
    }
  }
  false
}

// Whether `ty` is a union whose every member is a structural object (`Cat | Dog`) — the
// variant-boxed struct-union rep the emitter lowers through its expression-based `exprUnion`
// fallback. A mixed union, a struct together with a scalar or string, is not this: it has no
// single rep, so it stays floored.
function isStructUnionTy(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyUnion {
    const members = t.uMembers
    if members.length < 2 { return false }
    let i = 0
    while i < members.length {
      const m = T.tys[members[i]]
      if !(m is TyObj) { return false }
      i = i + 1
    }
    return true
  }
  false
}

// Whether `ty` is exactly `boolean | null` — a `TyNullable` wrapping the `boolean` primitive, the
// niche scalar nullable (an i32 0/1 with sentinel 2 for null). Cheap, with no `tyToStr`; it records
// an inferred niche if-binding.
function isNulBoolTy(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    const inr = t.nInner
    if inr < 0 { return false }
    const it = T.tys[inr]
    // The canonical boolean prim interns as `mkPrim("boolean")` (`TY_BOOL`); an annotation
    // may also name it "boolean" — accept both, like the inferred-return niche path.
    if it is TyPrim { return it.primName == "boolean" }
  }
  false
}

// The non-null part of `ty`: a nullable peels to its inner type, anything else is already non-null,
// and -1 propagates. Nested nullables collapse, since reading a map whose value is already nullable
// mints `mkNullableTy(T | null)` and a single peel would leave an inner `T?` a narrowed field
// access rejects. A one-member union around a nullable is not peeled here — the emitter boxes it.
function nonNullTy(ty: i32) {
  if ty < 0 { return -1 }
  let cur = ty
  while true {
    const t = T.tys[cur]
    if t is TyNullable {
      if t.nInner < 0 { return cur }
      cur = t.nInner
    } else {
      return cur
    }
  }
  cur
}

// A place's current type during fact collection: facts already collected into `names`/`tys`
// (innermost-last wins) override the path overlay, which overrides the scope or field lookup, so
// successive narrowings compose. Read-only — collection must never raise a diagnostic. Parens peel
// here too (D352), in the tail's own arm, or `(t).v` would key `t.v`, find no fact and answer -1.
function placeCurTy(ix: i32, names: string[], tys: i32[]) {
  const key = placeKeyOf(ix)
  if key != "" {
    let i = names.length - 1
    while i >= 0 {
      if names[i] == key { return tys[i] }
      i = i - 1
    }
    const ov = narrowedPathTy(key)
    if ov >= 0 { return ov }
  }
  const n = P.nodes[ix]
  if n is Paren { return placeCurTy(n.parInner, names, tys) }
  if n is Ident { return lookup(n.identName) }
  if n is Member {
    return placeFieldTy(placeCurTy(n.memObj, names, tys), n.memProp, false)
  }
  if n is OptMember {
    return placeFieldTy(placeCurTy(n.omObj, names, tys), n.omProp, true)
  }
  if n is Index { return placeElemTy(placeCurTy(n.idxArr, names, tys)) }
  -1
}

// The value type of an array element type `et`: `et` itself, except that the `u8` storage type
// widens to `i32` (D1211). One home for the widened-read rule the index arm already applies — a
// `u8[]` read is the zero-extended byte `array.get_u` produces, and `u8` may not stand in a value
// position at all. `.pop()` / `.get(i)` are that read one nullable out.
function arrElemValueTy(et: i32): i32 {
  if primNameOf(et) == "u8" { return TY_I32 }
  et
}

// The type of an element read off `baseTy` for narrowing purposes (no diagnostics) —
// `placeFieldTy`'s index twin. -1 when unresolvable, which is how "no fact" is spelled. Arrays
// only, and the omission is chosen: a map read is already `V | null` whatever the key, so keying
// `m[0]` would narrow a nullability the storage never dropped (inventory-2 D451).
function placeElemTy(baseTy: i32) {
  if baseTy < 0 { return -1 }
  const bt = T.tys[baseTy]
  if bt is TyArray {
    if primNameOf(bt.aElem) == "u8" { return -1 }
    return bt.aElem
  }
  -1
}

// The type of field `prop` read off `baseTy` for narrowing purposes (no diagnostics): an optional
// hop peels a nullable receiver and re-wraps the result nullable; the field resolves off a struct,
// or as a shared union field. -1 when unresolvable, and no narrowing is recorded then.
function placeFieldTy(baseTy: i32, prop: string, optional: boolean) {
  if baseTy < 0 { return -1 }
  const bt = T.tys[baseTy]
  let wasNullable = false
  let core = baseTy
  if bt is TyNullable {
    if !optional { return -1 }
    wasNullable = true
    core = bt.nInner
  }
  if core < 0 { return -1 }
  const ct = T.tys[core]
  let ft = -1
  if ct is TyObj { ft = objFieldType(ct, prop) }
  else if ct is TyUnion { ft = sharedUnionFieldTy(ct, prop) }
  if ft < 0 { return -1 }
  if wasNullable { return mkNullableTy(ft) }
  ft
}

// Shared-field access over a struct union: a field present on every member is readable on the
// union directly and its type is the join of the per-member field types. -1 when a member lacks
// the field or is not a struct. The join is what admits a discriminated union, whose arms carry
// the tag at mutually unassignable literal types; whether the read lowers is `sharedUnionFieldPlan`'s.
function sharedUnionFieldTy(u: TyUnion, prop: string) {
  const members = u.uMembers
  if members.length < 1 { return -1 }
  let shared = -1
  let i = 0
  while i < members.length {
    const mIx = members[i]
    if mIx < 0 { return -1 }
    const m = T.tys[mIx]
    if m is TyObj {
      const ft = objFieldType(m, prop)
      if ft < 0 { return -1 }
      if shared < 0 { shared = ft } else { shared = joinTys(shared, ft) }
    } else {
      return -1
    }
    i = i + 1
  }
  shared
}

// The parenthetical the unshared-field diagnostic appends: the first member of `u` that blocks the
// read — a non-object member, or an object without `prop`. "" when every member carries the field
// and the refusal came from the join instead (`{n: i32} | {n: f64}`), where there is no single
// member to name and the loud emit reject is the next stop.
function unionFieldGapNote(u: TyUnion, prop: string) {
  const members = u.uMembers
  let i = 0
  while i < members.length {
    const mIx = members[i]
    if mIx < 0 { return "" }
    const m = T.tys[mIx]
    if m is TyObj {
      if objFieldType(m, prop) < 0 {
        return " (no '" + prop + "' on " + tyToStr(mIx) + ")"
      }
    } else {
      return " (" + tyToStr(mIx) + " is not an object)"
    }
    i = i + 1
  }
  ""
}

// Flatten a union/nullable into its variant list (`null` becomes the null
// type), mirroring the host's `flattenVariants`.
export function flattenVariantsInto(ty: i32, out: i32[]) {
  if ty < 0 {
    out.push(ty)
    return 0
  }
  const t = T.tys[ty]
  if t is TyUnion {
    const members = t.uMembers
    let i = 0
    while i < members.length {
      flattenVariantsInto(members[i], out)
      i = i + 1
    }
    return 0
  }
  if t is TyNullable {
    flattenVariantsInto(t.nInner, out)
    out.push(TY_NULL)
    return 0
  }
  out.push(ty)
  0
}

// Two arena types denoting the same variant (mutually assignable). A generic
// type variable is never "the same variant" as anything — the host's hole
// guard (`isHole`) — so narrowing never pins an un-instantiated parameter.
function sameVariantTy(a: i32, b: i32) {
  if a < 0 || b < 0 { return false }
  const ta = T.tys[a]
  if ta is TyVar { return false }
  const tb = T.tys[b]
  if tb is TyVar { return false }
  // Named variants resolve to one canonical arena entry (`cUserTypes`), so
  // the common same-variant case is index equality — skip both traversals.
  if a == b { return true }
  if !assignable(a, b) { return false }
  assignable(b, a)
}

// The declared litunion alias `src` derives from, or -1: a nullable wrapper unwraps to its inner,
// since narrowing a `K | null` subtracts from the nullable, and a copy's own recorded provenance
// chains. The stamp itself is `noteLitUnionCopy`; the rep layers read it at emit.
function litUnionProvSrcAlias(src: i32): i32 {
  if src < 0 { return -1 }
  const t = T.tys[src]
  if t is TyNullable { return litUnionProvSrcAlias(t.nInner) }
  tyLitUnionAliasIx(src)
}

// Stamp `res` as a copy of the litunion alias `src` derives from. Records only when `res` is an
// alias-less litunion and every member of it is a member of that alias — narrowing, subtraction
// and dedup only ever keep members, so a copy is contained, while a join that widened past the
// alias is not the alias. A miss records nothing and the index simply stays alias-less.
function noteLitUnionCopy(res: i32, src: i32) {
  if res < 0 { return 0 }
  if !tyIsLitUnion(res) { return 0 }
  if tyLitUnionAliasIx(res) >= 0 { return 0 }
  const alias = litUnionProvSrcAlias(src)
  if alias < 0 { return 0 }
  const rt = T.tys[res]
  const at = T.tys[alias]
  if rt is TyUnion {
    if at is TyUnion {
      let i = 0
      while i < rt.uMembers.length {
        let hit = false
        let j = 0
        while j < at.uMembers.length {
          if sameVariantTy(rt.uMembers[i], at.uMembers[j]) { hit = true }
          j = j + 1
        }
        if !hit { return 0 }
        i = i + 1
      }
      cLitUnionCopyTyIxs.push(res)
      cLitUnionCopyAliasIxs.push(alias)
    }
  }
  0
}

// Remove a variant from a union or nullable, returning the residual type — the else-branch
// narrowing of `if x is A { … } else { … }`, where `x` is `U − A`. Returns -1 both when nothing
// concrete is removed (open-world negation is not tracked) and when nothing remains, a dead branch
// the caller does not overlay.
function subtractTy(ty: i32, removed: i32) {
  if ty < 0 || removed < 0 { return -1 }
  const drop: i32[] = []
  flattenVariantsInto(removed, drop)
  const vars: i32[] = []
  flattenVariantsInto(ty, vars)
  const kept: i32[] = []
  let i = 0
  while i < vars.length {
    const v = vars[i]
    let hit = false
    let j = 0
    while j < drop.length {
      if sameVariantTy(v, drop[j]) { hit = true }
      j = j + 1
    }
    if !hit { kept.push(v) }
    i = i + 1
  }
  if kept.length == vars.length { return -1 }
  if kept.length == 0 { return -1 }
  // Reassemble the residual: a surviving `null` folds back into a nullable.
  let hasNull = false
  const core: i32[] = []
  let k = 0
  while k < kept.length {
    if isNullTy(kept[k]) { hasNull = true } else { core.push(kept[k]) }
    k = k + 1
  }
  if core.length == 0 { return TY_NULL }
  let res = core[0]
  if core.length > 1 {
    res = mkUnionTy(core)
    // A narrowed litunion alias (`K` minus some members, `K | null` minus the null) is a fresh
    // copy of the alias — stamp its provenance.
    noteLitUnionCopy(res, ty)
  }
  if hasNull { return mkNullableTy(res) }
  res
}

// Whether `ix` is the `never` primitive (the empty type).
function isNeverTy(ix: i32) {
  if ix < 0 { return false }
  const t = T.tys[ix]
  if t is TyPrim { return t.primName == "never" }
  // An empty union (no surviving members — e.g. a degenerate `type D = D` or an
  // empty intersection `A & B`) is uninhabited, i.e. `never`. The declaration
  // already reported it; treating it as `never` keeps use sites from cascading.
  if t is TyUnion { return t.uMembers.length == 0 }
  false
}

// A prose description of a type's underlying shape, for explaining why two intersection operands
// cannot overlap (`A & B` → "an object and a string literal"). A single-member union (a
// `type B = "foo"` alias) peels to its member, so it reads "a string literal", not "a union".
function operandKind(ix: i32) {
  if ix < 0 { return "a type" }
  const t = T.tys[ix]
  if t is TyUnion {
    if t.uMembers.length == 1 { return operandKind(t.uMembers[0]) }
    return "a union"
  }
  if t is TyLit {
    if t.litKind == "str" { return "a string literal" }
    return "a number literal"
  }
  if t is TyObj { return "an object" }
  if t is TyFunc { return "a function" }
  if t is TyPrim { return "the type `" + t.primName + "`" }
  if t is TyArray { return "an array" }
  if t is TyMap { return "a map" }
  "a type"
}

// The base scalar a literal type softens to: a string literal to `string`, a real to `f64`, an
// integer to its magnitude-defaulted integer type. An integer literal past the i32 range softens
// to i64, so the literal-aware assignability path never sneaks an out-of-range literal into an
// i32 slot.
export function litBaseTy(t: TyLit) {
  if t.litKind == "str" { return TY_STR }
  if t.litKind == "flt" { return TY_F64 }
  if intLexemeFitsI32(t.litText) { return TY_I32 }
  TY_I64
}

// The emit name of that base scalar — `litBaseTy` rendered. One home for the four-way rule, so no
// renderer's `TyLit` arm re-derives `str`/`flt` from the characters. The prim test is total by
// `litBaseTy`'s own arms: every one of them returns a `TyPrim`.
function tyLitBasePrim(t: TyLit): PrimName | null {
  const bt = T.tys[litBaseTy(t)]
  if bt is TyPrim { return bt.primName }
  null
}

// The same answer as text, for the renderers that spell it. Declaring the return `string` is what
// widens the atom into a materialized string, so the atom form above is the one every deciding
// caller should ask.
function tyLitBaseName(t: TyLit) { primNameStr(tyLitBasePrim(t)) }

// Whether `ty` carries literal members — a literal type, or a union or nullable with a literal
// member. These are the closed-set types whose membership rules the literal-union checks enforce.
function isLitBearing(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyLit { return true }
  if t is TyNullable { return isLitBearing(t.nInner) }
  if t is TyUnion {
    const members = t.uMembers
    let i = 0
    while i < members.length {
      if isLitBearing(members[i]) { return true }
      i = i + 1
    }
  }
  false
}

// Soften a literal or all-literal union operand to its base scalar: a numeric-literal union is its
// base type for arithmetic and ordering, the union constraining what may be assigned rather than
// what may be computed. A mixed union — different bases, or any non-literal member — is left alone.
function softenLitTy(ty: i32) {
  if ty < 0 { return ty }
  const t = T.tys[ty]
  if t is TyLit { return litBaseTy(t) }
  if t is TyUnion {
    const members = t.uMembers
    let base = -1
    let i = 0
    while i < members.length {
      const m = members[i]
      if m < 0 { return ty }
      const mt = T.tys[m]
      if mt is TyLit {
        const b = litBaseTy(mt)
        if base < 0 { base = b }
        else if base != b { return ty }
      } else {
        return ty
      }
      i = i + 1
    }
    if base >= 0 { return base }
  }
  ty
}

// The literal type of a literal expression, or -1 when the expression is not a bare literal. Peels
// parens. The string text is the raw lexeme between the quotes — the same characters a literal-type
// annotation keeps — so membership compares consistently. The quote peel here is deliberately not
// `tyname.groupInnerOf`: that is the type-name grammar's cut, and this lexeme is an expression's.
function litTyOfExpr(ix: i32) {
  if ix < 0 { return -1 }
  const e = P.nodes[ix]
  if e is Paren { return litTyOfExpr(e.parInner) }
  if e is StrLit {
    const raw = e.strText
    return mkLitTy("str", raw.slice(1, raw.length - 1))
  }
  if e is NumLit {
    if numLexIsFloat(e.numText) { return mkLitTy("flt", e.numText) }
    return mkLitTy("int", e.numText)
  }
  -1
}

// `A & !B` under an intersection fold: drop B's variants from A. It differs from the narrowing
// `subtractTy` in its edges — nothing concrete dropped leaves A unchanged (open-world negation,
// `i32 & !2`), everything dropped folds to `never`, an empty intersection.
function isectSubtract(ty: i32, removed: i32) {
  if ty < 0 || removed < 0 { return -1 }
  const drop: i32[] = []
  flattenVariantsInto(removed, drop)
  const vars: i32[] = []
  flattenVariantsInto(ty, vars)
  const kept: i32[] = []
  let i = 0
  while i < vars.length {
    const v = vars[i]
    let hit = false
    let j = 0
    while j < drop.length {
      if sameVariantTy(v, drop[j]) { hit = true }
      j = j + 1
    }
    if !hit { kept.push(v) }
    i = i + 1
  }
  if kept.length == vars.length { return ty }
  if kept.length == 0 { return TY_NEVER }
  let hasNull = false
  const core: i32[] = []
  let k = 0
  while k < kept.length {
    if isNullTy(kept[k]) { hasNull = true } else { core.push(kept[k]) }
    k = k + 1
  }
  if core.length == 0 { return TY_NULL }
  let res = core[0]
  if core.length > 1 {
    res = mkUnionTy(core)
    // `K & !"a"` — an intersection-subtracted litunion alias is a copy.
    noteLitUnionCopy(res, ty)
  }
  if hasNull { return mkNullableTy(res) }
  res
}

// Fold `A & B`: a negation operand subtracts, a union operand distributes (`(0|1|2) & !2` →
// `0 | 1`), two object types merge field-wise (`{a} & {b}` is `{a, b}`, a shared field refining to
// the meet), a subtype pair keeps the narrower side, and a disjoint concrete pair folds to `never`,
// there being no common values. -1, unresolved, poisons the fold.
function intersectTy(a: i32, b: i32) {
  if a < 0 || b < 0 { return -1 }
  const tb = T.tys[b]
  if tb is TyNeg { return isectSubtract(a, tb.negTy) }
  const ta = T.tys[a]
  if ta is TyNeg { return isectSubtract(b, ta.negTy) }
  if ta is TyUnion {
    const du = isectDistribute(ta.uMembers, b)
    // A distributed litunion alias (`K & <lit>`) re-mints a subset copy.
    noteLitUnionCopy(du, a)
    return du
  }
  if tb is TyUnion {
    const du2 = isectDistribute(tb.uMembers, a)
    noteLitUnionCopy(du2, b)
    return du2
  }
  if ta is TyObj {
    if tb is TyObj {
      // Structural field-wise merge: the value that is both carries every field of each side, and
      // a shared field is the meet of the two.
      const mnames: string[] = []
      const mtys: i32[] = []
      const anames = ta.objFieldNames
      const atys = ta.objFieldTypes
      let ai = 0
      while ai < anames.length {
        mnames.push(anames[ai])
        mtys.push(atys[ai])
        ai = ai + 1
      }
      const bnames = tb.objFieldNames
      const btys = tb.objFieldTypes
      let bi = 0
      while bi < bnames.length {
        let at2 = -1
        let mi = 0
        while mi < mnames.length {
          if mnames[mi] == bnames[bi] { at2 = mi }
          mi = mi + 1
        }
        if at2 >= 0 {
          mtys[at2] = intersectTy(mtys[at2], btys[bi])
        } else {
          mnames.push(bnames[bi])
          mtys.push(btys[bi])
        }
        bi = bi + 1
      }
      return mkObjTy(mnames, mtys)
    }
  }
  if assignable(a, b) { return a }
  if assignable(b, a) { return b }
  TY_NEVER
}

// Distribute an intersection over a union operand: `(A | B) & C` is
// `(A & C) | (B & C)`, dropping members that fold to `never`.
function isectDistribute(members: i32[], other: i32) {
  const kept: i32[] = []
  let i = 0
  while i < members.length {
    const r = intersectTy(members[i], other)
    if r >= 0 && !isNeverTy(r) {
      let dup = false
      let j = 0
      while j < kept.length {
        if sameVariantTy(r, kept[j]) { dup = true }
        j = j + 1
      }
      if !dup { kept.push(r) }
    }
    i = i + 1
  }
  if kept.length == 0 { return TY_NEVER }
  if kept.length == 1 { return kept[0] }
  mkUnionTy(kept)
}

// Append one narrowing fact (place key → type) when the place is stable and
// the narrowed type resolved (-1 means "no fact" and is skipped).
function pushNarrowFact(placeIx: i32, ty: i32, names: string[], tys: i32[]) {
  if ty < 0 { return 0 }
  const key = placeKeyOf(placeIx)
  if key == "" { return 0 }
  names.push(key)
  tys.push(ty)
  0
}

// How a discriminant fact selects surviving arms. `"intersect"` keeps an arm whose field type can
// still be the fact — the rule for a positive test, and for the complement of an `is`, where the
// fact is already the subtracted remainder. `"exclude"` keeps an arm whose field type is not wholly
// the fact — the complement of an equality, where only an arm pinned to that literal is ruled out.
type DiscrimMode = "intersect" | "exclude"

// The discriminant rule: a test on a struct union's field refines the union itself, which is why a
// tag is written at all — the arms differ in it precisely so that reading it says which arm you
// have. A member survives when its own field type is still inhabitable under the fact. Four
// refusals: a `?.` hop, a member without the field, zero survivors, and all survivors.
function pushDiscrimParentFact(
  placeIx: i32,
  fieldTy: i32,
  names: string[],
  tys: i32[],
  bankIx: i32,
  elseBank: boolean,
  mode: DiscrimMode,
) {
  if fieldTy < 0 { return 0 }
  const n = P.nodes[placeIx]
  if !(n is Member) { return 0 }
  if placeHasOptionalHop(placeIx) { return 0 }
  const recvTy = placeCurTy(n.memObj, names, tys)
  if recvTy < 0 { return 0 }
  const rt = T.tys[recvTy]
  if !(rt is TyUnion) { return 0 }
  const ms = rt.uMembers
  const kept: i32[] = []
  let i = 0
  while i < ms.length {
    if ms[i] < 0 { return 0 }
    const m = T.tys[ms[i]]
    if !(m is TyObj) { return 0 }
    const ft = objFieldType(m, n.memProp)
    if ft < 0 { return 0 }
    if mode == "exclude" {
      // The complement of an equality: `s.kind == "circle"` being false rules out exactly the arms
      // whose tag can only be `"circle"` — `assignable(ft, fact)` says every value of that field is
      // the literal. An arm whose tag is a wider set survives, since it can hold something else.
      // That asymmetry is why this is not the intersect test negated.
      if !assignable(ft, fieldTy) { kept.push(ms[i]) }
    } else if assignable(fieldTy, ft) || assignable(ft, fieldTy) {
      kept.push(ms[i])
    }
    i = i + 1
  }
  if kept.length == 0 { return 0 }
  if kept.length == ms.length { return 0 }
  let res = kept[0]
  if kept.length > 1 { res = mkUnionTy(kept) }
  // Bank the answer for the emitter's narrowing stack (`isParentTyIxOf` / `isParentElseTyIxOf`),
  // which cannot re-derive it from the tested spelling. Guarded on the node being in range: an
  // emitter-synthesized `is` falls past the end and reads -1, which is the "push nothing" answer.
  if bankIx >= 0 {
    if elseBank {
      if bankIx < isParentElseTyIx.length { isParentElseTyIx[bankIx] = res }
    } else {
      if bankIx < isParentTyIx.length { isParentTyIx[bankIx] = res }
    }
  }
  pushNarrowFact(n.memObj, res, names, tys)
}

// Whether the place runs through a `?.` hop — its negation is then not a sound else-branch
// refinement, the chain being possibly null because a receiver is. The paren arm here is a safety
// rung, not a capability one (D352): without it `if (x?.y) is string { … } else { … }` answers
// false, and the else branch narrows a place that may be null because its receiver is.
function placeHasOptionalHop(ix: i32) {
  const n = P.nodes[ix]
  if n is Paren { return placeHasOptionalHop(n.parInner) }
  if n is OptMember { return true }
  if n is Member { return placeHasOptionalHop(n.memObj) }
  false
}

// For a guard on an optional chain (`x?.y is T`), the truthy branch also implies every `?.`
// receiver is non-null — push those facts innermost-first, each resolving against an
// already-narrowed receiver, so the body's regular `x.y` reads resolve. Then branch only.
function pushOptChainThenFacts(placeIx: i32, names: string[], tys: i32[]) {
  const n = P.nodes[placeIx]
  if n is Member {
    pushOptChainThenFacts(n.memObj, names, tys)
    return 0
  }
  if n is OptMember {
    pushOptChainThenFacts(n.omObj, names, tys)
    const cur = placeCurTy(n.omObj, names, tys)
    const inner = nonNullTy(cur)
    if inner >= 0 && inner != cur { pushNarrowFact(n.omObj, inner, names, tys) }
    return 0
  }
  0
}

// The argument place a guard call narrows in the branch where its non-null side is `wantThen`
// (1 for then, 0 for else), or -1: not a registered guard call, wrong direction, or no stable
// argument. Handles the inline form (`present(v)`) and the UFCS form (`v.present()`, where the
// receiver fills the guard's `self` param 0).
function guardCallPlace(cond: Call, wantThen: i32) {
  const cfn = P.nodes[cond.callFn]
  let gname = ""
  let gRecv = -1
  if cfn is Ident {
    gname = cfn.identName
  } else if cfn is Member {
    gname = cfn.memProp
    gRecv = cfn.memObj
  }
  if gname == "" { return -1 }
  const gi = guardIndexOf(gname)
  if gi < 0 { return -1 }
  if guardThens[gi] != wantThen { return -1 }
  const pIdx = guardParamIdxs[gi]
  const cargs = cond.callArgs
  if gRecv >= 0 {
    if pIdx == 0 { return gRecv }
    if pIdx - 1 < cargs.length { return cargs[pIdx - 1] }
    return -1
  }
  if pIdx < cargs.length { return cargs[pIdx] }
  -1
}

// The place side of a `<place> == <literal>` comparison, either operand order, or -1 when the
// condition is not one. The literal side must be a syntactic literal: a comparison against a
// variable that merely happens to hold `"circle"` proves nothing about the place. `litTyOfExpr` is
// the reader both sides use, and it owns the quote strip, so the two cannot disagree.
function litCmpPlace(condIx: i32) {
  const c = P.nodes[condIx]
  if !(c is BinExpr) { return -1 }
  if litTyOfExpr(c.binRight) >= 0 { return condUnderParens(c.binLeft) }
  if litTyOfExpr(c.binLeft) >= 0 { return condUnderParens(c.binRight) }
  -1
}

// The literal type a `<place> == <literal>` comparison tests for, or -1. Numeric literals come
// through as well as string ones and are load-bearing: a numeric tag is constructible, so
// `if s.kind == 0` over `{kind: 0, …} | {kind: 1, …}` discriminates exactly as the string form
// does. A plain `i32` field stays unrefined — every integer literal fits, so every arm survives.
function litCmpTy(condIx: i32) {
  const c = P.nodes[condIx]
  if !(c is BinExpr) { return -1 }
  const r = litTyOfExpr(c.binRight)
  if r >= 0 { return r }
  litTyOfExpr(c.binLeft)
}

// Collect the narrowings that hold when `cond` is true into the parallel `names`/`tys` arrays,
// keyed by place path: `x != null` strips x's null, `x is T` pins x to T (`is null` pins to the
// null type), `a && b` contributes both conjuncts, `!(e)` contributes e's false narrowings, and
// parens recurse. A guard over an optional chain also narrows each `?.` receiver non-null.
function collectThenNarrows(condIx: i32, names: string[], tys: i32[]) {
  const cond = P.nodes[condIx]
  if cond is Paren { return collectThenNarrows(cond.parInner, names, tys) }
  if cond is Unary {
    if cond.unOp == "!" { return collectElseNarrows(cond.unArg, names, tys) }
    return 0
  }
  if cond is IsExpr {
    pushOptChainThenFacts(cond.isObj, names, tys)
    if cond.isVariant == "null" {
      pushNarrowFact(cond.isObj, TY_NULL, names, tys)
    } else {
      const tIdx = isTypeTyRead(cond.isVariant, condIx)
      if tIdx >= 0 {
        pushNarrowFact(cond.isObj, tIdx, names, tys)
        pushDiscrimParentFact(
          cond.isObj,
          tIdx,
          names,
          tys,
          condIx,
          false,
          "intersect",
        )
      }
    }
    return 0
  }
  if cond is BinExpr {
    if cond.binOp == "&&" {
      collectThenNarrows(cond.binLeft, names, tys)
      collectThenNarrows(cond.binRight, names, tys)
      return 0
    }
    if cond.binOp == "!=" {
      const placeIx = nullCmpPlace(condIx)
      if placeIx >= 0 {
        pushOptChainThenFacts(placeIx, names, tys)
        const cur = placeCurTy(placeIx, names, tys)
        const inner = nonNullTy(cur)
        if inner >= 0 && inner != cur {
          pushNarrowFact(placeIx, inner, names, tys)
        }
      }
    }
    // `s.kind == "circle"` — the discriminant in the spelling a user reaches for without
    // declaring a tag alias first, since `is KC` needs a name to test against. Only the parent is
    // narrowed, not the tested field: pinning `s.kind` to a bare `TyLit` would put a literal type
    // where the field's own rep — an interned atom, or a plain string — is what consumers read.
    if cond.binOp == "==" {
      const eqPlace = litCmpPlace(condIx)
      if eqPlace >= 0 {
        const eqTy = litCmpTy(condIx)
        if eqTy >= 0 {
          pushDiscrimParentFact(
            eqPlace,
            eqTy,
            names,
            tys,
            condIx,
            false,
            "intersect",
          )
        }
      }
    }
    return 0
  }
  // Inferred type-guard call: `if present(v)` narrows `v` the way the guard's body narrows its
  // parameter — non-null here when the guard's non-null branch is the then arm.
  if cond is Call {
    const gArg = guardCallPlace(cond, 1)
    if gArg >= 0 {
      pushOptChainThenFacts(gArg, names, tys)
      const gCur = placeCurTy(gArg, names, tys)
      const gInner = nonNullTy(gCur)
      if gInner >= 0 && gInner != gCur {
        pushNarrowFact(gArg, gInner, names, tys)
      }
    }
    return 0
  }
  0
}

// May the else arm of `if <hole> is T` carry a deferred remainder (`HD_GNOT`)? Two exclusions,
// neither a design rule. A literal-bearing `T` is the emitter's reach: `litElseNarrow` reads the
// pin's softened spelling, so the literal matches no member and the arm reads the raw box (D1412).
// A shape `T` would re-base the hole's field demands onto a derived hole no argument check sees.
function holeElseRemainderOk(tIdx: i32): boolean {
  if tIdx < 0 { return false }
  const t = T.tys[tIdx]
  if t is TyObj { return false }
  true
}

// Collect the narrowings that hold when `cond` is false: `x == null` strips the null in the else
// branch, `x is null` false means non-null, `x is T` false leaves the union complement `U − T`,
// `a || b` contributes both disjuncts (neither held), `!(e)` contributes e's true narrowings, and
// parens recurse. A place behind a `?.` hop is never else-narrowed, the chain being possibly null.
function collectElseNarrows(condIx: i32, names: string[], tys: i32[]) {
  const cond = P.nodes[condIx]
  if cond is Paren { return collectElseNarrows(cond.parInner, names, tys) }
  if cond is Unary {
    if cond.unOp == "!" { return collectThenNarrows(cond.unArg, names, tys) }
    return 0
  }
  if cond is IsExpr {
    if placeHasOptionalHop(cond.isObj) { return 0 }
    const cur = placeCurTy(cond.isObj, names, tys)
    if cond.isVariant == "null" {
      let inner = nonNullTy(cur)
      // The null face of the same hole (D1243): `nonNullTy` peels a `TyNullable` and a hole is
      // not one, so `if a is null { … } else { … }` would lose the else arm exactly as the typed
      // complement below does. `TY_NULL` is what the pin subtracts.
      if inner == cur {
        if tyIsHole(cur) {
          inner = mkDerivedHole(HD_GNOT, "", -1, TY_NULL, cur)
        }
      }
      if inner >= 0 && inner != cur {
        pushNarrowFact(cond.isObj, inner, names, tys)
      }
    } else {
      const tIdx = isTypeTyRead(cond.isVariant, condIx)
      if tIdx >= 0 {
        let sub = subtractTy(cur, tIdx)
        // A hole has no member list to subtract from, so the remainder is deferred to the pin
        // rather than lost. Without it the `else` arm of `if a is string` over an un-annotated
        // parameter reads `a` at the full pinned union and `a * 2` refuses a program whose
        // annotated twin runs (D1243). `holeElseRemainderOk` says which types it may mint for.
        if sub < 0 && holeElseRemainderOk(tIdx) {
          sub = mkDerivedHole(HD_GNOT, "", -1, tIdx, cur)
        }
        pushNarrowFact(cond.isObj, sub, names, tys)
        // The complement, banked into the else table. `setNarrowFromCondElse` declines to
        // else-narrow a struct union, so a checker-only complement would type `else { s.w }` clean
        // for an emitter still seeing the full union — trading an accurate `field 'w' is not on
        // every member` for an obscure emit reject. Both layers carry it, so they agree.
        pushDiscrimParentFact(
          cond.isObj,
          sub,
          names,
          tys,
          condIx,
          true,
          "intersect",
        )
      }
    }
    return 0
  }
  if cond is BinExpr {
    if cond.binOp == "||" {
      collectElseNarrows(cond.binLeft, names, tys)
      collectElseNarrows(cond.binRight, names, tys)
      return 0
    }
    if cond.binOp == "==" {
      const placeIx = nullCmpPlace(condIx)
      if placeIx >= 0 {
        if !placeHasOptionalHop(placeIx) {
          const cur = placeCurTy(placeIx, names, tys)
          const inner = nonNullTy(cur)
          if inner >= 0 && inner != cur {
            pushNarrowFact(placeIx, inner, names, tys)
          }
        }
      }
      // `if s.kind == "circle" { … } else { … }` — the else arm of the discriminant. The test
      // being false rules out exactly the arms whose tag can only be that literal, so the fact is
      // the literal and the mode is `"exclude"`; see its header for why that is not the positive
      // test negated.
      const eqPlace = litCmpPlace(condIx)
      if eqPlace >= 0 {
        const eqTy = litCmpTy(condIx)
        if eqTy >= 0 {
          pushDiscrimParentFact(
            eqPlace,
            eqTy,
            names,
            tys,
            condIx,
            true,
            "exclude",
          )
        }
      }
    }
    return 0
  }
  // Inferred type-guard call: `if absent(p) { … } else { /* p != null */ }` — non-null in the else
  // branch when the guard's non-null branch is the else.
  if cond is Call {
    const gArg = guardCallPlace(cond, 0)
    if gArg >= 0 {
      if !placeHasOptionalHop(gArg) {
        const gCur = placeCurTy(gArg, names, tys)
        const gInner = nonNullTy(gCur)
        if gInner >= 0 && gInner != gCur {
          pushNarrowFact(gArg, gInner, names, tys)
        }
      }
    }
    return 0
  }
  0
}

// Whether a narrowing key is a path (`o.v`, `xs[0]`, `o.xs[1].v`) rather than a bare name — which
// is what decides overlay entry against scope shadow in `applyNarrows`. `[` counts: with only `.`
// tested, a fact keyed `xs[0]` installs as a bare-name scope shadow under the name `"xs[0]"`, a
// binding no reader looks up, since every reader of an index place asks the `npKeys` overlay.
function isPathKey(s: string) {
  let i = 0
  while i < s.length {
    if s[i] == 46 {
      return true // '.'
    }
    if s[i] == 91 {
      return true // '['
    }
    i = i + 1
  }
  false
}

// Apply collected narrowings around a branch: a bare name shadows through the scope chain (the
// caller pushes a scope first), a property path rides the `npKeys`/`npTys` overlay, whose entries
// the matching `popScope` unwinds. A bare name's shadow carries its declared type across, banked
// for `writeStorageTy`, and its constness, without which the `const` reject vanishes in a guard.
function applyNarrows(names: string[], tys: i32[]) {
  let i = 0
  while i < names.length {
    if isPathKey(names[i]) {
      npKeys.push(names[i])
      npTys.push(tys[i])
      npInvBy.push(-1)
      npEpochs.push(narFnEpoch)
    } else {
      const wasConst = isConstName(names[i])
      const declTy = lookup(names[i])
      if declTy >= 0 && declTy != tys[i] {
        noteNarShadow(names[i], declTy, NAR_KIND_GUARD)
      }
      declare(names[i], tys[i])
      if wasConst {
        const ctop = constScopes.length - 1
        if ctop >= 0 { constScopes[ctop][names[i]] = true }
      }
    }
    i = i + 1
  }
  0
}

// The start char offset of a scope-owning node (the `{`/`for` token), or `-1`. Only the node kinds
// that open a lexical scope are handled — block bodies and the two `for` forms; another owner
// falls back to "no start", i.e. a full-file sentinel.
function scopeStartOff(owner: i32) {
  if owner < 0 || owner >= P.nodes.length { return -1 }
  const n = P.nodes[owner]
  if n is Block { return n.pos }
  if n is ForRange { return n.pos }
  if n is ForIn { return n.pos }
  if n is FuncDecl { return n.pos }
  -1
}

// The token index whose start offset is exactly `off`, or `-1`. A scope owner's `pos` is a token
// boundary (`{`/`for`), so this recovers its line and column.
function tokIxAtStart(off: i32) {
  if off < 0 { return -1 }
  // The lexer appends tokens in scan order, so `start` offsets are strictly
  // increasing — binary search (this runs per scope push in LSP mode, and a
  // linear scan over all tokens made scope collection quadratic).
  let lo = 0
  let hi = P.toks.length - 1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const s = P.toks[mid].start
    if s == off { return mid }
    if s < off { lo = mid + 1 } else { hi = mid - 1 }
  }
  -1
}

// Push the open-scope span for `owner`, the scope-owning node, in lockstep with the decl-scope
// map. The end is the owner's anchor (last) token — the closing `}` for a block — and the start
// its first token. `owner < 0`, a narrowing-only scope that never holds a binding, pushes a
// full-file sentinel.
function pushScopeSpan(owner: i32) {
  let startL = 1
  let startC = 0
  let endL = SCOPE_EOF
  let endC = 0
  if owner >= 0 {
    const so = scopeStartOff(owner)
    const stk = tokIxAtStart(so)
    if stk >= 0 {
      const st = P.toks[stk]
      startL = st.line
      startC = st.col
    }
    if owner < nodeToks.length {
      const etk = nodeToks[owner]
      if etk >= 0 && etk < P.toks.length {
        const et = P.toks[etk]
        endL = et.line
        endC = et.col + et.text.length
      }
    }
  }
  scopeSL.push(startL)
  scopeSC.push(startC)
  scopeEL.push(endL)
  scopeEC.push(endC)
  0
}

// Enter a new lexical scope (push a fresh name→type map). Marks the current
// narrowed-path overlay depth so `popScope` unwinds entries pushed inside.
// `owner` is the scope-owning node (its source span bounds visibility for the
// LSP scope query); `-1` for a narrowing-only overlay that holds no binding.
function pushScope(owner: i32) {
  T.scopes.push(Map())
  constScopes.push(Map())
  fnDeclScopes.push(Map())
  fnAliasScopes.push(Map())
  npFrames.push(npKeys.length)
  asgDeclFrames.push(asgDeclKeys.length)
  if symEnabled != 0 {
    symDeclScope.push(Map())
    pushScopeSpan(owner)
  }
  0
}

// Leave the innermost scope, unwinding what it pushed.
function popScope() {
  flushUninferred(T.scopes.length - 1)
  T.scopes.pop()
  constScopes.pop()
  fnDeclScopes.pop()
  fnAliasScopes.pop()
  // The collapsed-binding marks go with the frame their bindings did (D1048). One length test
  // when the list is empty, which is nearly every program.
  collBindPopTo(T.scopes.length)
  if npFrames.length > 0 {
    const base = npFrames[npFrames.length - 1]
    npFrames.pop()
    while npKeys.length > base {
      npKeys.pop()
      npTys.pop()
      npInvBy.pop()
      npEpochs.pop()
    }
  }
  if asgDeclFrames.length > 0 {
    const abase = asgDeclFrames[asgDeclFrames.length - 1]
    asgDeclFrames.pop()
    while asgDeclKeys.length > abase {
      asgDeclKeys.pop()
      asgDeclTys.pop()
      asgDeclDepths.pop()
      asgDeclKinds.pop()
      asgDeclEpochs.pop()
    }
  }
  if symEnabled != 0 {
    if symDeclScope.length > 0 { symDeclScope.pop() }
    if scopeSL.length > 0 {
      scopeSL.pop()
      scopeSC.pop()
      scopeEL.pop()
      scopeEC.pop()
    }
  }
  0
}

// ── LSP symbol-table recording (no-ops when `symEnabled == 0`) ───────────────
// A binding's type-arena index, retained by `bindingId` (its decl node index) so hover can render
// it after the scope closed. The last write for a node wins — a re-check during demand-inference
// overwrites with the resolved type.
function symRetainType(declNode: i32, ty: i32, kind: i32) {
  let i = 0
  while i < symBindNode.length {
    if symBindNode[i] == declNode {
      symBindType[i] = ty
      symBindKind[i] = kind
      return 0
    }
    i = i + 1
  }
  symBindNode.push(declNode)
  symBindType.push(ty)
  symBindKind.push(kind)
  0
}

// A declaration's anchor token: its own name token from the parser's side table, falling back to
// the node anchor when unset. The one place the three recorders agree on which token a binding
// answers at, so a test about that token (`jwTokIsGenerated`) reads the same value everywhere.
function symDeclTok(declNode: i32) {
  const named = declNameTokOf(declNode)
  if named >= 0 { return named }
  if declNode >= 0 && declNode < nodeToks.length { return nodeToks[declNode] }
  -1
}

// Stamp a binding's visibility scope for the position query, from open-scope span `spanIx`, a
// `scope*` stack index; skipped when the index is out of range. The first stamp per binding wins,
// so a demand-inference re-entry — which runs the body from an artificially deep stack — cannot
// clobber a top-level function's correct global span.
function symStampVis(name: string, declNode: i32, kind: i32, spanIx: i32) {
  if spanIx < 0 || spanIx >= scopeSL.length { return 0 }
  if jwTokIsGenerated(symDeclTok(declNode)) { return 0 }
  let k = 0
  while k < symVisNode.length {
    if symVisNode[k] == declNode { return 0 }
    k = k + 1
  }
  symVisName.push(name)
  symVisNode.push(declNode)
  symVisKind.push(kind)
  symVisSL.push(scopeSL[spanIx])
  symVisSC.push(scopeSC[spanIx])
  symVisEL.push(scopeEL[spanIx])
  symVisEC.push(scopeEC[spanIx])
  0
}

// Record a declaration: bind `name → declNode` in the innermost decl scope, emit the declaration's
// own occurrence anchored at its name token, and retain its type. `declNode` is the bindingId and
// `nameTok` its identifier token, from the parser's `declNameTok` side table, falling back to the
// node anchor when unset.
function symDecl(name: string, declNode: i32, ty: i32, kind: i32) {
  if symEnabled == 0 { return 0 }
  if symDeclScope.length > 0 {
    const top = symDeclScope.length - 1
    symDeclScope[top][name] = declNode
  }
  symRetainType(declNode, ty, kind)
  // Visibility for completion: a binding is visible across its own innermost scope. Stamped
  // before the occurrence dedup so a demand-inference re-check refreshes the span.
  symStampVis(name, declNode, kind, scopeSL.length - 1)
  const tok = symDeclTok(declNode)
  // Idempotent by token: a function body re-checked during demand-inference would
  // otherwise stamp the same source identifier twice.
  if symOccSkipTok(tok) { return 0 }
  symOccTok.push(tok)
  symOccRecordTok(tok)
  symOccDecl.push(declNode)
  symOccIsDecl.push(1)
  // A declaration is never narrowed — it is the binding, and its type is the one `symRetainType`
  // just banked. See `symOccTy` in `check_state`.
  symOccTy.push(-1)
  0
}

// Token-keyed membership set mirroring `symOccTok`, so the dedup guard is O(1)
// instead of a linear scan over every prior occurrence (which made recording the
// occurrence list O(n²)). Reset in lockstep with `symOccTok` (see the check
// preamble) and inserted into at every occurrence append (`symOccRecordTok`).
let symOccTokSet: {[string]: boolean} = Map()

// Record token `tok` into the membership set (mirrors a `symOccTok.push(tok)`).
// Negative tokens are never deduped, matching `symOccHasTok`, so they are skipped.
function symOccRecordTok(tok: i32) {
  if tok < 0 { return 0 }
  symOccTokSet[i32ToStr(tok)] = true
  0
}

// Whether an occurrence at token `tok` must NOT be recorded: it is already recorded (the dedup),
// or the token is GENERATED. The deep-`is` second pass splices walkers onto the token stream and
// re-checks, and the editor must not colour, hint or complete over code the author never wrote —
// the same rule the style tier applies through `jwTokIsGenerated`.
function symOccSkipTok(tok: i32) {
  if jwTokIsGenerated(tok) { return true }
  symOccHasTok(tok)
}

// Whether an occurrence at token `tok` is already recorded (the dedup guard).
// O(1) via `symOccTokSet`, kept in sync with `symOccTok` at every append/reset.
function symOccHasTok(tok: i32) {
  if tok < 0 { return false }
  // A member-call cannot be a bare tail expression (the emitter rejects it as a
  // statement) — bind the `.has` result first (see `sliceNode` in format.vl).
  const present = symOccTokSet.has(i32ToStr(tok))
  present
}

// Like `symDecl`, but binds into the enclosing decl scope, one level out from the innermost. A
// function name lives in the scope surrounding its body, yet its body scope is already pushed when
// the params and name are processed, so its binding must land one frame up to resolve recursive
// and sibling references.
function symDeclInOuter(name: string, declNode: i32, ty: i32, kind: i32) {
  if symEnabled == 0 { return 0 }
  const outer = symDeclScope.length - 2
  if outer >= 0 {
    symDeclScope[outer][name] = declNode
  } else if symDeclScope.length > 0 {
    symDeclScope[symDeclScope.length - 1][name] = declNode
  }
  symRetainType(declNode, ty, kind)
  // A function name is visible in the enclosing scope, where it binds, not its body — the
  // decl-scope frame is one out, so its span is one below the top. Stamped before the occurrence
  // dedup, as in `symDecl`.
  let outerSpan = scopeSL.length - 2
  if outerSpan < 0 { outerSpan = scopeSL.length - 1 }
  symStampVis(name, declNode, kind, outerSpan)
  const tok = symDeclTok(declNode)
  if symOccSkipTok(tok) { return 0 }
  symOccTok.push(tok)
  symOccRecordTok(tok)
  symOccDecl.push(declNode)
  symOccIsDecl.push(1)
  symOccTy.push(-1) // a declaration is never narrowed (see `symDecl`)
  0
}

// Resolve `name` to its binding's decl node through the decl-scope chain
// (innermost first — mirrors `lookup`), or `-1` if it is not a tracked binding
// (a builtin/intrinsic, or an import seeded with no decl node).
function symResolve(name: string) {
  let i = symDeclScope.length - 1
  while i >= 0 {
    if symDeclScope[i].has(name) { return symDeclScope[i][name] ?? (-1) }
    i = i - 1
  }
  -1
}

// Record a use occurrence of the identifier node `useNode`, whose anchor token is the identifier.
// It resolves through the decl-scope chain, and a name with no tracked binding records nothing.
// `curTy` is retained per occurrence (`symOccTy`) so a position query can render the narrowed type
// — only under a live narrowing shadow, so an un-narrowed use stores -1 and hovers as its final type.
function symUse(useNode: i32, name: string, curTy: i32) {
  if symEnabled == 0 { return 0 }
  const decl = symResolve(name)
  if decl < 0 { return 0 }
  let tok = -1
  if useNode >= 0 && useNode < nodeToks.length { tok = nodeToks[useNode] }
  if symOccSkipTok(tok) { return 0 }
  symOccTok.push(tok)
  symOccRecordTok(tok)
  symOccDecl.push(decl)
  symOccIsDecl.push(0)
  let occTy = -1
  if curTy >= 0 {
    if narDeclaredTy(name, -1) >= 0 { occTy = curTy }
  }
  symOccTy.push(occTy)
  0
}

// Whether `ty` is an unresolved hole an inlay hint should suppress: a generic type variable, an
// error placeholder, or a union whose members are all holes — `any | any` is not a type VL can
// spell, and a union with any resolved member keeps its hint. Deliberately not extended to
// `TyNullable`, whose `_ | null` is determined. Depth-bounded; exhausting the budget keeps it.
export function inlayHole(ty: i32) { inlayHoleDeep(ty, 16) }

function inlayHoleDeep(ty: i32, depth: i32): boolean {
  if ty < 0 { return true }
  if depth <= 0 { return false }
  const t = T.tys[ty]
  if t is TyVar { return true }
  if t is TyErr { return true }
  if t is TyUnion {
    const ms = t.uMembers
    // An empty member list is not a union of holes but a degenerate arena entry, and answering
    // "hole" for it would suppress on a shape this rule has nothing to say about.
    if ms.length == 0 { return false }
    let i = 0
    while i < ms.length {
      if !inlayHoleDeep(ms[i], depth - 1) { return false }
      i = i + 1
    }
    return true
  }
  false
}

// ── the dead-`??` finding ────────────────────────────────────────────────────
// A multi-module compile merges every module's AST, so `modOfTok` resolves which file a finding
// is in; the CLI keeps only the entry module's (`redunModuleAt`).

function rcoalReset() {
  rcoalLine = []
  rcoalCol = []
  rcoalTok = []
  rcoalType = []
  0
}

// Record `x ?? d` whose left operand's type admits no `null`: the default is dead.
// Anchored at the `??` node, exactly where every other diagnostic on that node lands.
function recordDeadCoalesce(ix: i32, lt: i32) {
  if ix < 0 || ix >= nodeToks.length { return 0 }
  const tk = nodeToks[ix]
  if tk < 0 || tk >= P.toks.length { return 0 }
  if jwTokIsGenerated(tk) { return 0 }
  const t = P.toks[tk]
  // An exact repeat (same anchor) is the re-check of one node, not a second finding — the same
  // de-duplication `tErrCoded` applies to the error tier.
  let i = 0
  while i < rcoalTok.length {
    if rcoalTok[i] == tk { return 0 }
    i = i + 1
  }
  rcoalLine.push(t.line)
  rcoalCol.push(t.col)
  rcoalTok.push(tk)
  // User-facing (the finding's message quotes it) — the user render, not the raw one.
  rcoalType.push(tyToStrUser(lt))
  0
}

function rcoalTruncate(n: i32) {
  while rcoalLine.length > n { rcoalLine.pop() }
  while rcoalCol.length > n { rcoalCol.pop() }
  while rcoalTok.length > n { rcoalTok.pop() }
  while rcoalType.length > n { rcoalType.pop() }
  0
}

// ── `is <literal>` over a collapsed operand (D1048) ──────────────────────────

function isvalReset() {
  isvalLine = []
  isvalCol = []
  isvalTok = []
  isvalName = []
  isvalType = []
  isvalLit = []
  collBindDepth = []
  collBindName = []
  objLitBindDepth = []
  objLitBindName = []
  collRetFnNodes = []
  collapsedAliases = Map()
  annotCollapsed = Map()
  collapsedTy = -1
  0
}

function isvalTruncate(n: i32) {
  while isvalLine.length > n { isvalLine.pop() }
  while isvalCol.length > n { isvalCol.pop() }
  while isvalTok.length > n { isvalTok.pop() }
  while isvalName.length > n { isvalName.pop() }
  while isvalType.length > n { isvalType.pop() }
  while isvalLit.length > n { isvalLit.pop() }
  0
}

// Record `name` in a depth-tagged mark table at `depth`. The shared half of every such table:
// a sparse row per marked binding, so an unmarked program pays one length test.
function bindMarkPush(
  depths: i32[],
  names: string[],
  name: string,
  depth: i32,
) {
  depths.push(depth)
  names.push(name)
  0
}

// Does a row of this table name the binding `name` currently resolves to? The depth pairing is
// what makes it exact under shadowing: an inner binding that records nothing still answers
// false, because `lookupDepth` names its own frame and no row carries that depth.
function bindMarkHas(depths: i32[], names: string[], name: string): boolean {
  if names.length == 0 { return false }
  const d = lookupDepth(name)
  if d < 0 { return false }
  let i = names.length - 1
  while i >= 0 {
    if names[i] == name && depths[i] == d { return true }
    i = i - 1
  }
  false
}

// Drop the rows the scope just popped retired. `T.scopes` has already shrunk, so a row recorded
// at a depth the chain has dropped is gone with its binding.
function bindMarkPopTo(depths: i32[], names: string[], depth: i32) {
  while depths.length > 0 {
    if depths[depths.length - 1] < depth { return 0 }
    depths.pop()
    names.pop()
  }
  0
}

// Mark the binding just declared at the innermost scope as one whose declared type collapsed a
// subsumed literal arm. Called right after `declare`, so the depth it records is the frame
// `lookupDepth` answers with at every use.
function markCollapsedBinding(name: string) {
  bindMarkPush(collBindDepth, collBindName, name, T.scopes.length - 1)
}

// Did `name` resolve to a binding whose declared type collapsed (D1048)?
function bindingCollapsed(name: string) {
  bindMarkHas(collBindDepth, collBindName, name)
}

// Mark the binding just declared at `depth` as un-annotated with an object-literal initializer.
// The module hoist records its globals at depth 0 before any body is checked, so a body that
// reads a global declared later resolves it the same way straight-line code does (D1609).
function markObjLitBinding(name: string, depth: i32) {
  bindMarkPush(objLitBindDepth, objLitBindName, name, depth)
}

// Did `name` resolve to an un-annotated object-literal binding (D1609)?
function bindingIsObjLit(name: string) {
  bindMarkHas(objLitBindDepth, objLitBindName, name)
}

// Is `ix` a `let`/`const` with no annotation and an object-literal initializer? The one shape
// `markObjLitBinding` records, asked at both the hoist and the pass-2 declaration.
function letDeclIsUnannotObjLit(ix: i32): boolean {
  const n = P.nodes[ix]
  if n is LetDecl {
    if n.letType >= 0 { return false }
    if n.letInit < 0 { return false }
    const iv = P.nodes[n.letInit]
    if iv is ObjLit { return true }
  }
  false
}

// Drop the marks the scope just popped retired, for every depth-tagged table at once.
function collBindPopTo(depth: i32) {
  bindMarkPopTo(collBindDepth, collBindName, depth)
  bindMarkPopTo(objLitBindDepth, objLitBindName, depth)
}

// Mark or test a function declaration whose return annotation collapsed. Deduped: pass 1 hoists
// the signature, `checkFuncDeclNode` resolves it again, and a probe re-check runs the whole body
// a third time.
function markCollapsedRet(fnIx: i32) {
  if fnIx < 0 { return 0 }
  if fnRetCollapsed(fnIx) { return 0 }
  collRetFnNodes.push(fnIx)
  0
}

function fnRetCollapsed(fnIx: i32) {
  if fnIx < 0 { return false }
  let i = 0
  while i < collRetFnNodes.length {
    if collRetFnNodes[i] == fnIx { return true }
    i = i + 1
  }
  false
}

// Record the finding at an `is <literal>` whose operand's declared type collapsed.
// `ix` is the `IsExpr` node; `name` the operand binding; `objTy` its (collapsed) type;
// `lit` the tested spelling exactly as the author wrote it.
function recordCollapsedIs(ix: i32, name: string, objTy: i32, lit: string) {
  if ix < 0 || ix >= nodeToks.length { return 0 }
  const tk = nodeToks[ix]
  if tk < 0 || tk >= P.toks.length { return 0 }
  const t = P.toks[tk]
  // An exact repeat (same anchor) is the re-check of one node, not a second finding — the
  // de-duplication `recordDeadCoalesce` and `tErrCoded` both apply.
  let i = 0
  while i < isvalTok.length {
    if isvalTok[i] == tk { return 0 }
    i = i + 1
  }
  isvalLine.push(t.line)
  isvalCol.push(t.col)
  isvalTok.push(tk)
  isvalName.push(demangleName(name))
  // User-facing (the finding's message quotes it) — the user render, not the raw one.
  isvalType.push(tyToStrUser(objTy))
  isvalLit.push(lit)
  0
}

function redunReset() {
  redunSLine = []
  redunSCol = []
  redunELine = []
  redunECol = []
  redunName = []
  redunType = []
  redunTok = []
  0
}

// Record `let <name>: T = init` as redundant when init's own type == the annotation.
// `declIx` is the LetDecl node (for its name token); `n` carries letName/letInit.
function recordRedundantAnnot(
  n: LetDecl,
  declIx: i32,
  initTy: i32,
  annot: i32,
) {
  // Only a concrete init type that renders identically to the annotation. A hole (an empty
  // `[]`/`Map()`, a lone `null`), an error, or `never` is never redundant.
  if inlayHole(initTy) { return 0 }
  if isNeverTy(initTy) { return 0 }
  if annot == TY_ERR { return 0 }
  if !tyEq(initTy, annot) { return 0 }
  const nameTok = declNameTokOf(declIx)
  if nameTok < 0 { return 0 }
  if jwTokIsGenerated(nameTok) { return 0 }
  // The fix deletes the annotation, so the span runs from just after the name to the assignment
  // `=`. That `=` is found by scanning the tokens between, the annotation being multi-token: it is
  // the first `EQUAL` at bracket depth 0 that is not part of `=>`, i.e. not followed by `>`.
  let eqTok = -1
  let depth = 0
  let t = nameTok + 1
  while t < P.toks.length {
    if eqTok < 0 {
      const kd = P.toks[t].kind
      if kd == "LPAREN" || kd == "LBRACK" || kd == "LBRACE" {
        depth = depth + 1
      } else if kd == "RPAREN" || kd == "RBRACK" || kd == "RBRACE" {
        depth = depth - 1
      } else if depth == 0 && kd == "EQUAL" {
        let isArrow = false
        if t + 1 < P.toks.length {
          if P.toks[t + 1].kind == "GT" { isArrow = true }
        }
        if !isArrow { eqTok = t }
      }
    }
    t = t + 1
  }
  if eqTok < 0 { return 0 }
  // The span starts at the `:` token, always `nameTok + 1` for an annotated decl. Using the
  // colon's own position rather than `nameTok.col + name.length` is robust to the module merge
  // mangling the binding name (`local$m0`), which would otherwise push the start into the type.
  const colonTok = nameTok + 1
  if colonTok >= P.toks.length { return 0 }
  redunSLine.push(P.toks[colonTok].line)
  redunSCol.push(P.toks[colonTok].col)
  redunELine.push(P.toks[eqTok].line)
  redunECol.push(P.toks[eqTok].col)
  redunName.push(demangleName(n.letName))
  // User-facing (the finding's message quotes it) — the user render, not the raw one.
  redunType.push(tyToStrUser(initTy))
  redunTok.push(nameTok)
  0
}

// Does a return expression's type get pinned by the return annotation rather than inferred on its
// own? An empty `[]`/`{}`/`Map()`/`Set()` or a bare `null` resolves from the declared return
// through `T.curRet`, so the annotation is load-bearing.
function retInfluencedByAnnot(ix: i32) {
  if ix < 0 { return false }
  const nd = P.nodes[ix]
  if nd is ArrayLit { return nd.arrElems.length == 0 }
  if nd is ObjLit { return nd.objFields.length == 0 }
  if nd is NullLit { return true }
  if nd is Call {
    const cn = P.nodes[nd.callFn]
    if cn is Ident {
      if cn.identName == "Map" || cn.identName == "Set" {
        return nd.callArgs.length == 0
      }
    }
  }
  false
}

// Record a redundant return-type annotation (`function f(): T { … }` whose body's inferred return
// already is T) into the same finding stream the `let` rule uses. The fix deletes the `: T` between
// the params `)` and the body `{`; both span ends are token-index scans, robust in a merged
// multi-module compile. An object return is excluded — equal by render, not always by rep.
function recordRedundantRet(n: FuncDecl, fnIx: i32, ret: i32) {
  // Only scalar and string returns — the categories the emitter default and the inferred-return
  // elaboration classify for an un-annotated function. Object / array / union / nullable returns
  // can mis-lower, the emitter re-deriving them from the return expression, so keep those.
  const rnm = tyToStructStr(ret)
  if !isClassifiableRetName(rnm) { return 0 }
  // Skip generic functions: an un-annotated param is a per-call-site hole the inferred-return
  // elaboration does not cover, so a removed string return could mis-lower.
  let gi = 0
  while gi < n.fnParams.length {
    const gpn = P.nodes[n.fnParams[gi]]
    if gpn is Param {
      if gpn.parType < 0 { return 0 }
    }
    gi = gi + 1
  }
  const nameTok = declNameTokOf(fnIx)
  if nameTok < 0 { return 0 }
  const bn = P.nodes[n.fnBody]
  if !(bn is Block) { return 0 }
  if bn.pos < 0 { return 0 }
  let braceTok = -1
  let bi = nameTok + 1
  while bi < P.toks.length && braceTok < 0 {
    if P.toks[bi].start == bn.pos { braceTok = bi }
    bi = bi + 1
  }
  if braceTok < 0 { return 0 }
  // The return annotation's colon, found by scanning backward from the body `{`. Forward from the
  // name finds the wrong one: a type-parameter bound's colon (`<T: Showable>`) is also at bracket
  // depth 0, because `<`/`>` are not brackets, and the fix then wrote source that does not parse
  // (D1441). Backward, the return's colon is the first depth-0 one.
  let colonTok = -1
  let depth = 0
  let ci = braceTok - 1
  while ci > nameTok && colonTok < 0 {
    const kd = P.toks[ci].kind
    if kd == "RPAREN" || kd == "RBRACK" || kd == "RBRACE" {
      depth = depth + 1
    } else if kd == "LPAREN" || kd == "LBRACK" || kd == "LBRACE" {
      depth = depth - 1
    } else if depth == 0 && kd == "COLON" {
      colonTok = ci
    }
    ci = ci - 1
  }
  if colonTok < 0 { return 0 }
  if jwTokIsGenerated(nameTok) { return 0 }
  redunSLine.push(P.toks[colonTok].line)
  redunSCol.push(P.toks[colonTok].col)
  redunELine.push(P.toks[braceTok].line)
  redunECol.push(P.toks[braceTok].col)
  redunName.push(opDeclLabel(demangleName(n.fnName)))
  // User-facing (the finding's message quotes it) — the user render, not the raw one.
  redunType.push(tyToStrUser(ret))
  redunTok.push(nameTok)
  0
}

// Record a member-access node's resolved type + its property-name span, keyed by
// the node (last write wins — a re-check during demand-inference overwrites the
// hole with the pinned type). A no-op unless `symEnabled` and the type resolved.
// Returns `ty` so it can wrap a member arm's return: `return symMem(ix, ft)`.
function symMem(ix: i32, ty: i32) {
  if symEnabled == 0 { return ty }
  if ty < 0 { return ty }
  if ix < 0 || ix >= nodeToks.length { return ty }
  const tk = nodeToks[ix]
  if tk < 0 || tk >= P.toks.length { return ty }
  // Generated walker code, on the same rule as `symOccSkipTok`.
  if jwTokIsGenerated(tk) { return ty }
  const t = P.toks[tk]
  // Property-name length, to bound the span the cursor must fall within.
  let pl = 0
  const nd = P.nodes[ix]
  if nd is Member { pl = nd.memProp.length }
  else if nd is OptMember { pl = nd.omProp.length }
  let i = 0
  while i < symMemNode.length {
    if symMemNode[i] == ix {
      symMemTy[i] = ty
      return ty
    }
    i = i + 1
  }
  symMemNode.push(ix)
  symMemTy.push(ty)
  symMemLine.push(t.line)
  symMemCol.push(t.col)
  symMemEndCol.push(t.col + pl)
  ty
}

// Record a method-call callee member name (`xs.push`, `m.set`, `s.slice`) for semantic tokens. A
// method call's callee never flows through the member-read arm, the builtin arms typing and
// returning it directly, so `symMem` never sees it; this records its property-name span as a
// `method`. A later `symMem` for the same node overwrites the type, so member hover still works.
function symMemMethod(ix: i32) {
  if symEnabled == 0 { return ix }
  if ix < 0 || ix >= nodeToks.length { return ix }
  const tk = nodeToks[ix]
  if tk < 0 || tk >= P.toks.length { return ix }
  // Generated walker code, on the same rule as `symOccSkipTok`.
  if jwTokIsGenerated(tk) { return ix }
  const t = P.toks[tk]
  let pl = 0
  const nd = P.nodes[ix]
  if nd is Member { pl = nd.memProp.length }
  else if nd is OptMember { pl = nd.omProp.length }
  let i = 0
  while i < symMemNode.length {
    if symMemNode[i] == ix { return ix }
    i = i + 1
  }
  symMemNode.push(ix)
  symMemTy.push(SYM_MEM_METHOD)
  symMemLine.push(t.line)
  symMemCol.push(t.col)
  symMemEndCol.push(t.col + pl)
  ix
}

// Strip a module-merge mangling suffix (`add$m1` → `add`) so an imported name shows under its
// source name in completion. The merge appends `$m<N>`, N being the module table index, to every
// cross-module name, and `$` is not a legal identifier char, so the first `$` marks the suffix. A
// name without a `$` is returned unchanged.
export function demangleName(nm: string) {
  let i = 0
  while i < nm.length {
    if nm[i] == '$' { return nm.slice(0, i) }
    i = i + 1
  }
  nm
}

// Strip every `$m<digits>` module-merge and `$b<digits>` block-scope mangle suffix from a free-form
// diagnostic message: the merge renames a module's declarations and the parser renames a
// body-scoped `type` (D1045), both internal names that must not surface. The two suffixes compose,
// and the scan handles that by restarting after the digits. One home, in `tyname.demangleSpelling`.
export function demangleMsg(s: string) { demangleSpelling(s) }

// Bind `name` to type-arena index `ty` in the innermost scope.
export function declare(name: string, ty: i32) {
  const top = T.scopes.length - 1
  T.scopes[top][name] = ty
  0
}

// Record `nodeIx` as the `FuncDecl` that `name` declares in the current scope.
function declareFnDeclNode(name: string, nodeIx: i32) {
  const top = fnDeclScopes.length - 1
  if top >= 0 { fnDeclScopes[top][name] = nodeIx }
  0
}

// The declaration a binding of `name` aliases, or -1 — `fnAliasScopes` read under the scope chain's
// own shadowing rule, exactly like `isConstName` and `lookupFnDeclNode`. Its one consumer is
// deferred-constraint ownership; see the table's header for why it is separate.
function lookupFnAliasNode(name: string) {
  let i = T.scopes.length - 1
  while i >= 0 {
    if T.scopes[i].has(name) {
      if i < fnAliasScopes.length { return fnAliasScopes[i][name] ?? -1 }
      return -1
    }
    i = i - 1
  }
  -1
}

// The `FuncDecl` node `name` currently resolves to, or -1 when it resolves to something that is not
// a function declaration. The walk stops at the first scope that binds `name` at all and asks only
// that frame — the scope chain's own shadowing rule — so a local binding that shadows a function
// name answers -1, and the call keeps the exact-arity gate a function value must have.
function lookupFnDeclNode(name: string) {
  let i = T.scopes.length - 1
  while i >= 0 {
    if T.scopes[i].has(name) {
      if i < fnDeclScopes.length { return fnDeclScopes[i][name] ?? -1 }
      return -1
    }
    i = i - 1
  }
  -1
}

// Look `name` up through the scope chain, innermost first. Returns its type-arena
// index, or `-1` if undeclared (innermost-wins, so shadowing works).
export function lookup(name: string) {
  let i = T.scopes.length - 1
  while i >= 0 {
    if T.scopes[i].has(name) { return T.scopes[i][name] ?? -1 }
    i = i - 1
  }
  -1
}

// Raise a diagnostic at AST node `at`, resolving its source position — the node's anchor token
// through the `nodeToks` side table — eagerly, so the driver can render `line:col: message`. Every
// lookup is bounds-checked: a harness that builds `P.nodes` by hand yields an out-of-range index,
// which degrades to "no position" (`tline == 0`) rather than trapping.
export function tErr(msg: string, at: i32) { tErrCoded(msg, at, "") }

// The emitter-capability channel: raise an error for a construct the type system accepts but
// codegen cannot lower yet, under the stable `unsupported-lowering` category code. Both are errors,
// an unbuildable program not being allowed to pass, but tooling can tell them apart by code.
// Message convention: name the type-valid construct, then the workaround after an em dash.
function tErrUnsupported(msg: string, at: i32) {
  tErrCoded(msg, at, CODE_UNSUPPORTED_LOWERING)
}

function tErrCoded(msg: string, at: i32, code: string) {
  tErrCodedData(msg, at, code, "")
}

// `tErrCoded` plus the structured payload — the only raise that fills `tdata`. The code stays a
// bare category and the answer rides `data` (`diagDataField`), so no consumer has to split a code
// string and no value's characters can bite.
function tErrCodedData(msg: string, at: i32, code: string, data: string) {
  let ln = 0
  let co = 0
  if at >= 0 && at < nodeToks.length {
    const tk = nodeToks[at]
    if tk >= 0 && tk < P.toks.length {
      const t = P.toks[tk]
      ln = t.line
      co = t.col
    }
  }
  tErrPush(msg, at, ln, co, code, data)
}

// `tErr`, positioned at node `at`'s start token instead of its `nodeToks` last-token anchor — for a
// multiline construct whose last token is a closing brace a whole body away from what the message
// names. `tat` still records the node, so the repeat-dedupe key is unchanged, and both consumers
// clamp an end that lands before this start. Falls back to the plain anchor when there is no start.
function tErrAtNodeStart(msg: string, at: i32) {
  tErrAtNodeStartCoded(msg, at, "")
}

// `tErrAtNodeStart` on the category-coded channel — the start-anchor twin of `tErrCoded`, so a
// capability refusal can also point at the construct's first token. D1045's body-scope `type` needs
// both halves at once: it is a "type-valid but cannot build" refusal whose last token is the
// closing brace of its field list, a line or more below the `type` keyword the message names.
function tErrAtNodeStartCoded(msg: string, at: i32, code: string) {
  const sp = nodePos(at)
  if sp >= 0 {
    const tk = tokIndexAt(sp)
    if tk >= 0 && tk < P.toks.length {
      return tErrPush(msg, at, P.toks[tk].line, P.toks[tk].col, code, "")
    }
  }
  tErrCoded(msg, at, code)
}

// D1585 — the reserved-name refusal, raised from one place by both faces: a single file's
// declaration and a module's (`driver.modCheckBuiltinTyDecls`, the only reader that still sees the
// pre-merge name). Message, channel and anchor are shared, so the two faces cannot drift in
// wording. Anchored at the declaration's name token, the `nodeToks` anchor being a closing brace.
export function tErrBuiltinTyDecl(name: string, at: i32): i32 {
  const msg = "a `type` declaration may not take the built-in type name `" +
    name +
    "` — every annotation resolves that name to the primitive, so the declaration " +
    "can never be referred to; rename it"
  const tk = declNameTokOf(at)
  if tk >= 0 && tk < P.toks.length {
    return tErrPush(msg, at, P.toks[tk].line, P.toks[tk].col, "", "")
  }
  tErr(msg, at)
  0
}

function tErrPush(
  msg: string,
  at: i32,
  ln: i32,
  co: i32,
  code: string,
  data: string,
) {
  // An exact repeat (same message, same anchor) is noise, not information — two passes can resolve
  // the same annotation, the pass-1.5 hoist and the real pass both reporting a generic-alias arity
  // error at the same position. Drop the repeat; the diagnostic count stays small, so the scan is
  // cheap.
  let di = 0
  while di < T.diags.length {
    const d = T.diags[di]
    if d.tat == at && d.tmsg == msg { return 0 }
    di = di + 1
  }
  T.diags.push(
    { tmsg: msg, tat: at, tline: ln, tcol: co, tcode: code, tdata: data },
  )
  0
}

// ── small numeric / string helpers (no union narrowing) ──────────────────────

// Is type-arena index `ix` the `string` primitive?
function isStringTy(ix: i32) {
  if ix < 0 { return false }
  const t = T.tys[ix]
  if t is TyPrim { return t.primName == "string" }
  false
}

// Is type-arena index `ix` a numeric primitive (i32/i64/f32/f64)? A `TyErr` or
// `TyVar` placeholder also counts, so a checking failure or unresolved hole
// doesn't cascade a spurious "not a number" error.
function isNumeric(ix: i32) {
  if ix < 0 { return false }
  const t = T.tys[ix]
  if t is TyErr { return true }
  if t is TyVar { return true }
  if t is TyPrim {
    return t.primName == "i32" ||
      t.primName == "i64" ||
      t.primName == "f64" ||
      t.primName == "f32"
  }
  false
}

// The bare primitive name of type-arena index `ix`, or `null` when it is not a primitive. Absence
// is `null` rather than `""`: nothing compares this against `""`, it only has to lose every
// `== "i32"` comparison, and `T | null` is the absence idiom the language already commits to.
export function primNameOf(ix: i32): PrimName | null {
  if ix < 0 { return null }
  const t = T.tys[ix]
  if t is TyPrim { return t.primName }
  null
}

// The primitive name as text, for the few consumers that spell it into a string rather than decide
// on it — a rep key builder, and the `as`-target spelling the canon pass writes back onto the node.
// Absence renders empty, which is what those sites read.
export function primNameStr(p: PrimName | null): string {
  if p == null { return "" }
  p
}

// Numeric widening lattice: may a value of primitive type `sn` implicitly flow into a `dn`-typed
// slot? Only the lossless edges — `i32 → i64`, `i32 → f64`, `f32 → f64`, plus every type to itself
// — since each preserves the value exactly and codegen inserts the convert at the boundary.
// `i32 → f32` and `i64 → f64` are rejected as lossy, as is every narrowing and float-to-integer.
function numWidensName(sn: PrimName | null, dn: PrimName | null) {
  if sn == dn { return false }
  if sn == "i32" {
    if dn == "i64" || dn == "f64" { return true }
  }
  if sn == "f32" {
    if dn == "f64" { return true }
  }
  false
}

// True when `src`→`dst` is an implicit numeric widening (see `numWidensName` —
// the lossless edges only; i32→f32 / i64→f64 are rejected as lossy).
function numWidens(src: i32, dst: i32) {
  numWidensName(primNameOf(src), primNameOf(dst))
}

// Are `a` and `b` two numeric operands of different but compatible types, so a mixed arithmetic or
// comparison widens the narrower side to the wider one? True exactly when one operand widens to
// the other, in either direction. The shared op type is then the wider of the two (`widerNumeric`).
function mixesNumeric(a: i32, b: i32) {
  if numWidens(a, b) { return true }
  if numWidens(b, a) { return true }
  false
}

// The wider of two mixed numeric operands, which is the result and op type: whichever the other
// widens into. The caller guarantees `mixesNumeric(a, b)`.
function widerNumeric(a: i32, b: i32) {
  if numWidens(a, b) { return b }
  a
}

// Do two numeric type indices denote the same numeric type?
function sameNumeric(a: i32, b: i32) {
  const ta = T.tys[a]
  const tb = T.tys[b]
  if ta is TyErr { return true }
  if tb is TyErr { return true }
  if ta is TyVar { return true }
  if tb is TyVar { return true }
  if ta is TyPrim {
    if tb is TyPrim { return ta.primName == tb.primName }
  }
  false
}

// Is the expression at `ix` a bare scalar literal — a number, a string, a boolean, or one of those
// behind parens or a unary sign? These are the expressions a nominal newtype destination adopts
// without an explicit conversion: a literal carries no prior identity, so it is not a candidate for
// the brand confusion the type exists to prevent. Deliberately syntactic, unlike `litTyOfExpr`.
function exprIsBrandAdoptingLiteral(ix: i32) {
  if ix < 0 { return false }
  const e = P.nodes[ix]
  if e is Paren { return exprIsBrandAdoptingLiteral(e.parInner) }
  if e is Unary {
    if e.unOp == "-" { return exprIsBrandAdoptingLiteral(e.unArg) }
    return false
  }
  if e is NumLit { return true }
  if e is StrLit { return true }
  if e is BoolLit { return true }
  false
}

// Is the expression at `ix`, peeling parens, a float number literal — one spelled with a `.` or
// with a scientific exponent? A float literal is polymorphic across the float types: it types f64
// by default but re-encodes exactly into an f32 slot, so it is accepted there and the demote a
// general f64 value would need is never performed. Integer literals ride the widening lattice.
function isFloatLitExpr(ix: i32) {
  if ix < 0 { return false }
  const e = P.nodes[ix]
  if e is Paren { return isFloatLitExpr(e.parInner) }
  // A unary minus over a float literal (`-1.5`) is still a float literal — negation is exact in
  // IEEE-754, so it re-encodes at f32 and flows into any f32 position the positive literal would.
  // Without this a leading `-` makes the value a plain f64 expression, rejected as a lossy demote.
  if e is Unary {
    if e.unOp == "-" { return isFloatLitExpr(e.unArg) }
  }
  // A literal whose magnitude overflows f32 does not re-encode at f32 — it would encode ±infinity
  // — so it gets no f32 grant and takes the normal f64-into-f32 lossy-demote rejection at the flow
  // site.
  if e is NumLit {
    if !numLexIsFloat(e.numText) { return false }
    return !f32LitOverflows(e.numText)
  }
  false
}

// Is the expression at `ix`, peeling parens and a unary sign, an integer literal whose value f32
// holds exactly? The integer half of the contextual-f32-literal rule, exactness-gated where the
// float half is context-typed: turning `16777217` into `16777216` is the lossy implicit conversion
// VL forbids. A char literal is not admitted — a code point in a float slot is a category confusion.
function isExactF32IntLitExpr(ix: i32) {
  if ix < 0 { return false }
  const e = P.nodes[ix]
  if e is Paren { return isExactF32IntLitExpr(e.parInner) }
  if e is Unary {
    if e.unOp == "-" { return isExactF32IntLitExpr(e.unArg) }
  }
  if e is NumLit {
    if numLexIsFloat(e.numText) { return false }
    return intLexemeIsExactF32(e.numText)
  }
  false
}

// Does the expression at `ix` adopt an f32 context as a literal — either half of the
// contextual-f32-literal rule? The single predicate every f32 grant site asks, so the float and
// integer halves can never drift apart position by position.
function isF32AdoptingLitExpr(ix: i32) {
  if isFloatLitExpr(ix) { return true }
  isExactF32IntLitExpr(ix)
}

// Is this ordering comparison an f32 operand against an f32-adopting literal? The comparison twin
// of `binOpType`'s literal-adopt arm: `fv > 1` / `1 > fv` compare at f32 exactly as `fv + 1`
// computes at f32. Comparison needs its own site because it yields `TY_BOOL` and never consults
// `widerNumeric`, so the arithmetic arm cannot cover it.
function cmpF32LitAdopts(n: BinExpr, olt: i32, ort: i32) {
  if primNameOf(olt) == "f32" && isF32AdoptingLitExpr(n.binRight) {
    return true
  }
  primNameOf(ort) == "f32" && isF32AdoptingLitExpr(n.binLeft)
}

// The least upper bound used by `??` (host: `flatten(Union(nonNull(l), r))`):
// mutually-assignable types collapse to the wider; otherwise a two-member union.
function joinTys(a: i32, b: i32) {
  if a < 0 { return b }
  if b < 0 { return a }
  if assignable(b, a) { return a }
  if assignable(a, b) { return b }
  // Distinct variants: a flattened, deduped union, with nullability folding back into a `?`
  // wrapper.
  const vars: i32[] = []
  flattenVariantsInto(a, vars)
  flattenVariantsInto(b, vars)
  const kept: i32[] = []
  let hasNull = false
  let i = 0
  while i < vars.length {
    const v = vars[i]
    if isNullTy(v) {
      hasNull = true
    } else {
      let dup = false
      let j = 0
      while j < kept.length {
        if kept[j] == v { dup = true }
        if sameVariantTy(kept[j], v) { dup = true }
        j = j + 1
      }
      if !dup { kept.push(v) }
    }
    i = i + 1
  }
  if kept.length == 0 { return TY_NULL }
  let res = kept[0]
  if kept.length > 1 {
    res = mkUnionTy(kept)
    // A joined litunion alias (`if c { k1 } else { k2 }`, `k ?? "a"`, both sides the same alias or
    // a member of it) re-mints the alias as a copy; the subset gate inside the stamp rejects a
    // join that widened past it.
    noteLitUnionCopy(res, a)
    noteLitUnionCopy(res, b)
  }
  if hasNull { return mkNullableTy(res) }
  res
}

// The return-inference join, for `noteInferredRet` alone — not the general `joinTys`. A hole must
// not collapse here: it is permissively assignable both ways, so the mutual-assignability collapse
// picks one side and drops the other. Keeping both as a deferred join hands the choice to the call
// site; such a join has no runtime shape, so every path to the emitter must collapse it again.
function joinRetTys(a: i32, b: i32) {
  if a < 0 { return b }
  if b < 0 { return a }
  if a == b { return a }
  if !tyIsHole(a) && !tyIsHole(b) { return joinTys(a, b) }
  const kept: i32[] = []
  flattenVariantsInto(a, kept)
  flattenVariantsInto(b, kept)
  const uniq: i32[] = []
  let i = 0
  while i < kept.length {
    let dup = false
    let j = 0
    while j < uniq.length {
      if uniq[j] == kept[i] { dup = true }
      j = j + 1
    }
    if !dup { uniq.push(kept[i]) }
    i = i + 1
  }
  if uniq.length == 1 { return uniq[0] }
  const res = mkUnionTy(uniq)
  joinHoleUnions.push(res)
  res
}

// Collapse a deferred join about to escape the checker — a call's result type, which becomes a node
// type the emitter reads. Re-joining through the ordinary `joinTys` means an unresolvable join,
// whose members name a hole this site does not bind, behaves as an ordinary join rather than
// reaching codegen as a union the emitter has no rep for. Anything else passes through.
function collapseDeferredJoin(tyIx: i32) {
  if !tyIsDeferredJoin(tyIx) { return tyIx }
  const t = T.tys[tyIx]
  if t is TyUnion {
    let res = -1
    let i = 0
    while i < t.uMembers.length {
      res = joinTys(res, t.uMembers[i])
      i = i + 1
    }
    if res >= 0 { return res }
  }
  tyIx
}

// Park the uncollapsed deferred join `tyIx` under call node `nodeIx`, last write winning — the
// checker re-walks a body once per inference pass, and the pass whose witnesses reach the call site
// is the last one. Never from the parameter-solve probe: that probe observes a body, and this table
// is keyed by call node, so a probe row would block the real pass's re-park.
function noteDeferredJoinNode(nodeIx: i32, tyIx: i32) {
  if paramSolveProbe { return 0 }
  if nodeIx < 0 { return 0 }
  let k = 0
  while k < dJoinNode.length {
    if dJoinNode[k] == nodeIx {
      dJoinTy[k] = tyIx
      return 0
    }
    k = k + 1
  }
  dJoinNode.push(nodeIx)
  dJoinTy.push(tyIx)
  0
}

// The type the return accumulator should see for node `nodeIx`, whose checked type came back as
// `t`: the parked uncollapsed deferred join when this node is a call whose join the site could not
// decide, else `t` itself. The one consumer allowed to see a deferred join outside `substTyDeep`,
// `elaborateInferRets` treating such a return as generic, like the bare `TyVar` it stands in for.
function inferRetTyOf(nodeIx: i32, t: i32) {
  if nodeIx < 0 { return t }
  let k = 0
  while k < dJoinNode.length {
    if dJoinNode[k] == nodeIx {
      if dJoinTy[k] >= 0 { return dJoinTy[k] }
      return t
    }
    k = k + 1
  }
  t
}

function isJoinHoleUnion(tyIx: i32) {
  let k = 0
  while k < joinHoleUnions.length {
    if joinHoleUnions[k] == tyIx { return true }
    k = k + 1
  }
  false
}

// A type that is, or wraps, a deferred join — a union still carrying a hole member. It denotes no
// runtime shape of its own: each call site re-folds it to the single arm that site's pinned
// argument reaches, so the codegen-support floors that reject a genuine inferred union skip it.
function tyIsDeferredJoin(tyIx: i32) {
  if tyIx < 0 { return false }
  const t = T.tys[tyIx]
  if t is TyNullable { return tyIsDeferredJoin(t.nInner) }
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if tyIsHole(t.uMembers[i]) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// The base hole a derived member-read hole reads from: a field read and a guarded alternative both
// bottom out at the hole they read, and nest — a field of a field. Any other hole (a plain param
// hole, an `HD_RET` or `HD_ELEM` derivation) comes back unchanged, which is how `holeMemberDeadAt`
// tells "this member is a read off a pinned argument" from "this member is an argument".
function holeBaseTy(tyIx: i32) {
  const row = hdRowOf(tyIx)
  if row < 0 { return tyIx }
  const k = hdKind[row]
  if k == HD_FLD {
    // An empty property name never bottoms out: a `?fld..<h>` from a parser error-recovery `""`
    // member name has no first dot to cut at, so it is not a derived read.
    if hdField[row].length == 0 { return tyIx }
    return holeBaseTy(hdBase[row])
  }
  if k == HD_GALT { return holeBaseTy(hdBase[row]) }
  if k == HD_GNOT { return holeBaseTy(hdBase[row]) }
  tyIx
}

// Soundness gate on the re-fold: is deferred-join member `mIx` provably dead under these bindings,
// a branch the pinned argument can never take? Only a derived member-read hole can be proven dead,
// and only against a concrete pin. Everything else is live — in particular a member that merely
// resolved to another hole is still undecided, and calling that dead is itself a soundness hole.
function holeMemberDeadAt(mIx: i32, bNames: string[], bTys: i32[]) {
  if mIx < 0 { return false }
  const t = T.tys[mIx]
  if !(t is TyVar) { return false }
  const base = holeBaseTy(mIx)
  if base == mIx {
    return false // not a derived read — never provably dead
  }
  const pin = substHoleTy(base, bNames, bTys)
  if pin < 0 {
    return false // the base is not pinned here — defer
  }
  if tyIsHole(pin) {
    return false // pinned to another hole — still undecided
  }
  // The base is concrete, yet the derived read does not resolve: this branch cannot be reached by
  // this argument.
  substHoleTy(mIx, bNames, bTys) < 0
}

// Re-fold a deferred join under a call's bindings: drop every provably dead member and re-join the
// rest, so a call site where exactly one arm is live sees that arm's type rather than a spurious
// `A | B`. A merely unresolved member survives, and the join re-folds again at the site that pins
// it. The re-join goes through `joinRetTys`, so a surviving hole member is not collapsed away.
function refoldJoinUnion(
  tyIx: i32,
  orig: i32[],
  subst: i32[],
  changed: boolean,
  bNames: string[],
  bTys: i32[],
) {
  let anyDead = false
  let i = 0
  while i < orig.length {
    if holeMemberDeadAt(orig[i], bNames, bTys) { anyDead = true }
    i = i + 1
  }
  if !anyDead && !changed { return tyIx }
  let res = -1
  let live = 0
  let j = 0
  while j < orig.length {
    if !holeMemberDeadAt(orig[j], bNames, bTys) {
      res = joinRetTys(res, subst[j])
      live = live + 1
    }
    j = j + 1
  }
  // Every arm proven dead is not a type — keep the union rather than invent one.
  if live == 0 || res < 0 { return mkUnionTy(subst) }
  res
}

// Whether the expression is a bare `true`/`false` literal (through parens) —
// excluded from the A7 boolean→i32 value coercion (a literal in an i32 slot is
// more likely a mistake; write `1`/`0`).
export function isBoolLitExpr(ix: i32) {
  if ix < 0 { return false }
  const e = P.nodes[ix]
  if e is Paren { return isBoolLitExpr(e.parInner) }
  if e is BoolLit { return true }
  false
}

// True if `dstTy` has an f32 position a float literal can re-encode into: a bare `f32`, a nullable
// `f32?` (its inner), or any f32 member of a union, recursively.
function dstAdmitsF32(dstTy: i32) {
  if dstTy < 0 { return false }
  if primNameOf(dstTy) == "f32" { return true }
  const t = T.tys[dstTy]
  if t is TyNullable { return dstAdmitsF32(t.nInner) }
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if dstAdmitsF32(t.uMembers[i]) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// Does function type `tyIx` carry an inference hole — a `TyVar` param or return? Such a type is a
// generic, capability-bounded function value (`(a, b) => a + b`), not a concrete signature.
function fnTyHasHole(tyIx: i32) {
  const t = T.tys[tyIx]
  if t is TyFunc {
    const ps = t.fnParamTypes
    let i = 0
    while i < ps.length {
      if tyIsHole(ps[i]) { return true }
      i = i + 1
    }
    return tyIsHole(t.fnRet)
  }
  false
}

// Do every deferred binary-op constraint this binding resolves hold — the capability check as a
// pure boolean, `validateBinCstrs` being the diagnostic-emitting twin? A constraint still touching
// an unbound hole defers, answering true.
function binCstrsHold(bNames: string[], bTys: i32[], calleeFn: i32) {
  let ci = 0
  while ci < binCstrOp.length {
    if cstrOwnedBy(binCstrFn[ci], calleeFn) {
      const clt = substTyDeep(binCstrLt[ci], bNames, bTys)
      const crt = substTyDeep(binCstrRt[ci], bNames, bTys)
      if !tyHasHole(clt) {
        if !tyHasHole(crt) {
          if !binOpDefinedFor(binCstrOp[ci], clt, crt) { return false }
        }
      }
    }
    ci = ci + 1
  }
  true
}

// Is a generic function value of type `srcTy` (hole params or return) assignable to the concrete
// function type `dstTy`? Instantiate it at `dstTy`'s param types, require the body's capability to
// hold there and the substituted return to match — the per-call-site instantiation driven by the
// target type. The permissive structural `assignable` would accept a mismatch that cannot lower.
function genericFnAssignable(srcTy: i32, dstTy: i32) {
  const s = T.tys[srcTy]
  const d = T.tys[dstTy]
  if s is TyFunc {
    if d is TyFunc {
      const sp = s.fnParamTypes
      const dp = d.fnParamTypes
      if sp.length != dp.length { return false }
      const bNames: string[] = []
      const bTys: i32[] = []
      let i = 0
      while i < sp.length {
        bindGenWalk(sp[i], dp[i], bNames, bTys)
        if !assignable(dp[i], sp[i]) { return false }
        i = i + 1
      }
      // -1: a function value names no declaration here, so every constraint is still consulted —
      // `cstrOwnedBy`'s unknown-callee fallback, rather than guessing an owner from a `TyFunc`.
      if !binCstrsHold(bNames, bTys, CSTR_ANYFN) { return false }
      if !argCstrsHold(bNames, bTys) { return false }
      // No `retCstrsHold` rung here, and its absence is deliberate. A function value names no
      // declaration, so `cstrOwnedBy`'s fallback puts every generic's return constraint in scope,
      // and `substTyDeep` matches TyVars by name, so it can refuse an unrelated instantiation.
      // The `assignable` on the next line already compares the instance's return to the target's.
      return assignable(substTyDeep(s.fnRet, bNames, bTys), d.fnRet)
    }
  }
  false
}

// Whether a struct type is sound to box into a value union through a widening struct literal
// (`{f: 97.5}` into `{f: f32} | {w: i32}`, where the checker adopts the arm and the emitter boxes
// the plain struct). Restricted to structs whose fields the emitter boxes into a union today; a
// field with no union-boxed rep would emit invalid wasm, so those arms stay a loud reject.
function unionArmBoxSafe(tyIx: i32) {
  const t = T.tys[tyIx]
  if !(t is TyObj) { return false }
  const ftys = t.objFieldTypes
  let i = 0
  while i < ftys.length {
    const ft = T.tys[ftys[i]]
    if ft is TyPrim {
      // scalar / string / boolean field — boxes cleanly
    } else if ft is TyObj {
      if !unionArmBoxSafe(ftys[i]) { return false }
    } else if tyIsLitUnion(ftys[i]) {
      // A literal-union field (`f: K0`) boxes as its interned i32 atom: the variant tables record
      // the union name (`uFieldElemName`, the `sFieldElemName` twin) and the variant construct path
      // lowers a member literal as its atom id — the same rep the plain struct field carries.
    } else if ft is TyLit && ft.litKind == "str" {
      // A one-member inline literal field (`kind: "circle"`) — the discriminated-union tag, written
      // the way every other typed language spells it. It is not the litunion arm above, which
      // requires a `TyUnion`. It boxes as a plain string field rather than an atom, because that is
      // the rep a bare literal annotation already has, so this arm claims no new emitter capability.
    } else if numLitUnionHasBase(ftys[i]) {
      // A numeric literal tag — `kind: 0`, `kind: 1.5`, or a named numeric litunion. The string arm
      // above admits its family through `tyIsLitUnion`, which is string-only by construction. It
      // boxes as its base scalar, the same rep a plain `kind: i32` / `kind: f64` field has. Two arms
      // differing only by a numeric tag arrive distinguished, `variantFieldIdText` recording every `TyLit`.
    } else if T.tys[ftys[i]] is TyFunc {
      // A bare function-typed field (`f: (i32) => K0`) boxes as the closure fat-pointer (code 14):
      // the variant construct passes the lambda through and the narrowed member call routes to
      // `call_ref`. A nullable closure field stays out, its arm rep being unproven here.
    } else if ft is TyNullable {
      // A nullable-litunion field (`f: K0 | null`, the code-30 i32 niche with the -1 sentinel) and a
      // nullable-f32 field (`f: f32 | null`, the code-16 value box the plain struct field already
      // carries) both box: the variant construct threads the same per-code arms the plain
      // struct-literal path uses. Other nullable field types keep their loud reject.
      const nfi = ft.nInner
      if nfi < 0 { return false }
      if !(tyIsLitUnion(nfi) || primNameOf(nfi) == "f32") { return false }
    } else if ft is TyArray {
      // A list field (`xs: i32[]`, `ps: P[]`, `ss: string[]`): one reference slot in the arm's
      // struct, exactly as a nested `TyObj` field is. The variant box holds a ref to the arm struct
      // and the arm struct a ref to the array, so the element rep is not something the variant needs
      // to know — which is why there is no recursion into `aElem`. An empty hole is still one slot.
    } else if ft is TyMap {
      // A map or set field (`m: {[string]: V}`, `m: {[i32]: V}`). Same argument as the list arm
      // above and graded the same way: the rep is present, and the refusal is the arm-pick's alone.
      // Neither key spelling has anything to do with it — a plain list field fails identically, all
      // of them falling to this function's closing `return false`.
    } else {
      return false
    }
    i = i + 1
  }
  true
}
// Record the destination array type on an ArrayLit source whose element target reps differently
// from the literal's own inference — a niche-nullable scalar element, or a plain `string` element
// over an all-literal-union literal — peeling a nullable destination wrapper and grouping parens.
// Runs before `assignableExpr`'s plain-assignable short-circuit, which such a literal takes.
function recordElemRepArrayLit(srcExpr: i32, dstTy: i32, depth: i32) {
  if inferQuiet || srcExpr < 0 || dstTy < 0 || depth <= 0 { return 0 }
  let dtix = dstTy
  const dN = T.tys[dtix]
  if dN is TyNullable { dtix = dN.nInner }
  // An unfilled A-infer-null hole (`let x = null`) peels to no inner — nothing to record, and
  // indexing the arena at -1 traps the compiler.
  if dtix < 0 { return 0 }
  const d = T.tys[dtix]
  const e = P.nodes[srcExpr]
  if e is Paren {
    // Record on the wrapping `Paren` too, not only the inner literal: the emitter's typed-IR fast
    // paths (`exprStringArray` and siblings) consult whichever node a consumer holds, and a Paren
    // keeping its stale pre-adoption record would re-claim the wrong rep at classification.
    if recordElemRepArrayLit(e.parInner, dtix, depth) == 1 {
      while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
      nodeTyIx[srcExpr] = dtix
      return 1
    }
    return 0
  }
  if d is TyArray {
    if tyIsNicheNulScalarElem(d.aElem) {
      if e is ArrayLit {
        while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
        nodeTyIx[srcExpr] = dtix
        return 1
      }
    }
    // The other direction of the same disagreement: a `string[]` destination over a literal whose
    // own element is a literal union (`const ys: string[] = [k]`). The two reps genuinely differ —
    // an atom is an interned i32 id, the destination's element a `(ref $array)` — and it belongs on
    // this side of the short-circuit, `K[]` being covariantly assignable. Gated on the disagreement.
    if tyIsPrimNamed(d.aElem, "string") {
      if e is ArrayLit {
        if tyIsLitUnionArray(nodeTyIxOf(srcExpr)) {
          while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
          nodeTyIx[srcExpr] = dtix
          return 1
        }
      }
    }
    // The element-wise descent, the `TyObj` arm below written for the sibling container. An array
    // destination has the identical short-circuit, so `const c: (K | null)[][] = [[null]]` would
    // leave the inner `[null]` at its self-inferred `null[]`, and every emitter probe that seeds a
    // niche element reads that type (D117). Only the elements re-stamp; `depth - 1` bounds the walk.
    if e is ArrayLit {
      if !tyDeeperThan(dtix, 16) {
        let ai = 0
        while ai < e.arrElems.length {
          recordElemRepArrayLit(e.arrElems[ai], d.aElem, depth - 1)
          ai = ai + 1
        }
      }
    }
    return 0
  }
  // A niche-nul-elem array nested in a struct-field literal value (`{f: [null]}` against
  // `{f: (K | null)[] | null}`): the whole ObjLit is covariantly `assignable`, so
  // `assignableExpr`'s field-wise recursion is never reached — descend here, mirroring
  // `recordNullHoleObjAdopt`. Only the inner niche array re-stamps; `tyDeeperThan` guards recursion.
  if d is TyObj {
    if e is ObjLit {
      if tyDeeperThan(dstTy, 16) { return 0 }
      const dfn = d.objFieldNames
      const dft = d.objFieldTypes
      let k = 0
      while k < e.objFields.length {
        const f = P.nodes[e.objFields[k]]
        if f is FieldInit {
          let dj = -1
          let j = 0
          while j < dfn.length {
            if dfn[j] == f.fiName { dj = j }
            j = j + 1
          }
          if dj >= 0 { recordElemRepArrayLit(f.fiValue, dft[dj], depth - 1) }
        }
        k = k + 1
      }
    }
    return 0
  }
  0
}
// True when the type at `ti` carries a bare-`null` hole in a struct-field or array-element position
// (`{f: null}`, `{f: {f: null}}`, `null[]` inside a field): such a render is a literal's own
// structural inference, never a spellable annotation, so no registered shape row can match it and a
// name-keyed consumer mis-keys. Walks `TyObj`/`TyArray` only; depth-capped against recursive types.
function tyHasNullHole(ti: i32, depth: i32): boolean {
  if ti < 0 || depth <= 0 { return false }
  const t = T.tys[ti]
  if t is TyPrim { return t.primName == "null" }
  if t is TyObj {
    const fts = t.objFieldTypes
    let i = 0
    while i < fts.length {
      if tyHasNullHole(fts[i], depth - 1) { return true }
      i = i + 1
    }
    return false
  }
  if t is TyArray { return tyHasNullHole(t.aElem, depth - 1) }
  false
}

// True when the type structure reachable from `ti` nests deeper than `budget` levels of
// obj/array/nullable/union wrappers — in particular a recursive type (`type L = {n: L | null}`)
// exceeds every finite budget. `recordNullHoleObjAdopt` skips such destinations: a recursive
// re-stamp would send `tyToEmitName`, which has no back-edge vocabulary, into unbounded recursion.
function tyDeeperThan(ti: i32, budget: i32): boolean {
  if ti < 0 { return false }
  if budget <= 0 { return true }
  const t = T.tys[ti]
  if t is TyObj {
    const fts = t.objFieldTypes
    let i = 0
    while i < fts.length {
      if tyDeeperThan(fts[i], budget - 1) { return true }
      i = i + 1
    }
    return false
  }
  if t is TyArray { return tyDeeperThan(t.aElem, budget - 1) }
  if t is TyNullable { return tyDeeperThan(t.nInner, budget - 1) }
  if t is TyUnion {
    const ms = t.uMembers
    let i = 0
    while i < ms.length {
      if tyDeeperThan(ms[i], budget - 1) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// Record the destination type on an ObjLit (or ArrayLit-of-ObjLit) source whose own checked type
// carries a bare-`null` hole: that type is covariantly assignable, so the literal-aware adoption
// block is never reached, yet the recorded type is `structIndexOfObjCtx`'s ambiguity signal and a
// null-hole render matches no row. Nested field values re-stamp; returns 1 when this node does.
function recordNullHoleObjAdopt(srcExpr: i32, dstTy: i32, depth: i32) {
  if inferQuiet || srcExpr < 0 || dstTy < 0 || depth <= 0 { return 0 }
  // A recursive destination (`type L = {n: L | null}`, whose `{n: null, v: 7}` tail literal is
  // exactly a null-hole source) must not re-stamp: see `tyDeeperThan`.
  if tyDeeperThan(dstTy, 16) { return 0 }
  let dtix = dstTy
  const dN = T.tys[dtix]
  if dN is TyNullable { dtix = dN.nInner }
  if dtix < 0 { return 0 }
  const d = T.tys[dtix]
  const e = P.nodes[srcExpr]
  if e is Paren {
    if recordNullHoleObjAdopt(e.parInner, dtix, depth) == 1 {
      while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
      nodeTyIx[srcExpr] = dtix
      return 1
    }
    return 0
  }
  if d is TyArray {
    if e is ArrayLit {
      let any = 0
      let i = 0
      while i < e.arrElems.length {
        if recordNullHoleObjAdopt(e.arrElems[i], d.aElem, depth - 1) == 1 {
          any = 1
        }
        i = i + 1
      }
      if any == 1 {
        while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
        nodeTyIx[srcExpr] = dtix
      }
      return any
    }
    return 0
  }
  if d is TyObj {
    if e is ObjLit {
      // Only a literal whose own recorded type carries a null hole re-stamps — a fully classified
      // literal keeps its structural record untouched.
      let own = -1
      if srcExpr < nodeTyIx.length { own = nodeTyIx[srcExpr] }
      if !tyHasNullHole(own, 6) { return 0 }
      // Every literal field must exist on the destination, or this is not an adoption and the
      // assignability error path owns it. Validate the full field set first, so a late miss leaves
      // no partial re-stamp behind.
      const dfn = d.objFieldNames
      const djs: i32[] = []
      let k = 0
      while k < e.objFields.length {
        const f = P.nodes[e.objFields[k]]
        if f is FieldInit {
          let dj = -1
          let j = 0
          while j < dfn.length {
            if dfn[j] == f.fiName { dj = j }
            j = j + 1
          }
          if dj < 0 { return 0 }
          djs.push(dj)
        } else {
          djs.push(-1)
        }
        k = k + 1
      }
      k = 0
      while k < e.objFields.length {
        const f = P.nodes[e.objFields[k]]
        if f is FieldInit {
          if djs[k] >= 0 {
            recordNullHoleObjAdopt(
              f.fiValue,
              d.objFieldTypes[djs[k]],
              depth - 1,
            )
          }
        }
        k = k + 1
      }
      while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
      nodeTyIx[srcExpr] = dtix
      return 1
    }
    return 0
  }
  0
}

// A literal container's slot-by-slot constraints, for the one case where a container-level
// constraint cannot exist at all: `checkArrayLitNode` joins its element types, and a hole is
// permissively assignable both ways, so `[true, self]` inside a generic keeps `boolean`, drops the
// hole and records nothing. The ask is the slot, not the collection, and no binding name is given.
function noteLitElemCstrs(srcExpr: i32, dstTy: i32, depth: i32) {
  if depth <= 0 || srcExpr < 0 || dstTy < 0 { return 0 }
  const e = P.nodes[srcExpr]
  if e is Paren { return noteLitElemCstrs(e.parInner, dstTy, depth - 1) }
  // The unfilled A-infer-null hole is why this loop tests the index before reading it. `let x =
  // null` binds `mkNullableTy(-1)` — a nullable whose inner is not yet a type — and `tyHasHole`
  // answers false for it, a `-1` not being a `TyVar`, so it reaches here. One peel takes `dtix` to
  // `-1`, and a second read of `T.tys[-1]` traps the compiler.
  let dtix = dstTy
  let peel = true
  while peel {
    if dtix < 0 {
      peel = false
    } else {
      const dn = T.tys[dtix]
      if dn is TyNullable { dtix = dn.nInner } else { peel = false }
    }
  }
  if dtix < 0 { return 0 }
  const d = T.tys[dtix]
  if e is ArrayLit {
    if d is TyArray {
      let i = 0
      while i < e.arrElems.length {
        noteLitElemCstrs(e.arrElems[i], d.aElem, depth - 1)
        i = i + 1
      }
    }
    return 0
  }
  if e is ObjLit {
    if d is TyObj {
      const fl = e.objFields
      let k = 0
      while k < fl.length {
        const fn = P.nodes[fl[k]]
        if fn is FieldInit {
          const ft = objFieldType(d, fn.fiName)
          if ft >= 0 { noteLitElemCstrs(fn.fiValue, ft, depth - 1) }
        }
        k = k + 1
      }
    }
    return 0
  }
  const vt = nodeTyIxOf(srcExpr)
  if tyHasHole(vt) { noteLetCstr(vt, dtix, srcExpr, "") }
  0
}

// D581 — the element's source type for the array-literal recursion, and the one place this function
// reads the container instead of the element node. The element node's own recorded type is the
// precise answer at the body's first ask, but at the pin it is stale — it still says `T`, so
// `assignable(T, string)` waves every element past. Gated on the element's record being hole-bearing.
function litElemSrcTy(elemIx: i32, srcTy: i32) {
  const nt = nodeTyIxOf(elemIx)
  if nt < 0 { return nt }
  if !tyHasHole(nt) { return nt }
  if srcTy < 0 { return nt }
  const s = T.tys[srcTy]
  if s is TyArray {
    if s.aElem >= 0 {
      if !tyHasHole(s.aElem) { return s.aElem }
    }
  }
  nt
}

// D591 — did the element join produce a rep the destination does not have? A literal types as the
// join of its elements, and `assignableExpr`'s array-literal recursion then accepts it element-wise
// against a destination the join is not assignable to, leaving the literal node at the joined type.
// Keyed on the mismatch, not the destination; a destination that is itself a union is excluded.
function arrLitJoinUnionElem(srcExpr: i32, dtix: i32): boolean {
  if srcExpr < 0 || dtix < 0 { return false }
  const st = nodeTyIxOf(srcExpr)
  if st < 0 { return false }
  const s = T.tys[st]
  if !(s is TyArray) { return false }
  if s.aElem < 0 { return false }
  const se = T.tys[s.aElem]
  if !(se is TyUnion) { return false }
  const d = T.tys[dtix]
  if !(d is TyArray) { return false }
  if d.aElem < 0 { return false }
  const de = T.tys[d.aElem]
  if de is TyUnion { return false }
  true
}
// The function-value into void-slot grant (see its call site in `assignableExpr`). True — and the
// seam recorded for the emitter's twin mint — when `dstTy` is a `TyFunc` returning `void`, `srcTy`
// is a concrete `TyFunc` with a resolved non-void return, the param lists match pairwise under
// `fnSlotAssignable`, and `srcExpr` names an unshadowed module-scope `function` declaration.
function fnValVoidCoerce(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if srcExpr < 0 || srcTy < 0 || dstTy < 0 { return false }
  const d = T.tys[dstTy]
  if !(d is TyFunc) { return false }
  if !isVoidTy(d.fnRet) { return false }
  const s = T.tys[srcTy]
  if !(s is TyFunc) { return false }
  if fnTyHasHole(srcTy) { return false }
  // The source's return must be resolved and non-void: a `-2` pending return is still being
  // inferred, and a void source needs no coercion, taking the plain assignable path.
  if s.fnRet < 0 { return false }
  if isVoidTy(s.fnRet) { return false }
  const sp = s.fnParamTypes
  const dp = d.fnParamTypes
  if sp.length != dp.length { return false }
  let i = 0
  while i < sp.length {
    if !fnSlotAssignable(dp[i], sp[i]) { return false }
    i = i + 1
  }
  // The expression form: a paren-peeled Ident naming an unshadowed module-scope
  // `function` declaration.
  let u = srcExpr
  let done = false
  while !done {
    const pn = P.nodes[u]
    if pn is Paren { u = pn.parInner } else { done = true }
  }
  const en = P.nodes[u]
  if en is Ident {
    if (fnDeclIx[en.identName] ?? -1) < 0 { return false }
    if lookupDepth(en.identName) != 0 { return false }
    if !inferQuiet { noteVoidCoerceVal(u, en.identName) }
    return true
  }
  false
}

// Has this radix literal node adopted a 64-bit destination? Read by `checkNodeReal` so a re-check
// keeps the adopted width, and by the emitter's union-atom picker.
function litWide64Of(ix: i32) {
  if ix >= 0 {
    if ix < litWide64.length { return litWide64[ix] }
  }
  false
}

// The integer width a destination pins on a radix literal delivered to it: 64 for an `i64` slot,
// 32 for an `i32` one, -1 when it has no opinion — `u8` reports through its own arm in
// `assignableExpr`, and a float or literal-union slot leaves the literal its default width.
// Nullable wrappers peel; a union pins 64 only when `i64` is its sole integer atom.
function dstIntWidth(dstTy: i32, depth: i32) {
  if dstTy < 0 || depth <= 0 { return -1 }
  const dtix = nonNullTy(dstTy)
  if dtix < 0 { return -1 }
  const pn = primNameOf(dtix)
  if pn == "i64" { return 64 }
  if pn == "i32" { return 32 }
  if pn != null { return -1 }
  const d = T.tys[dtix]
  if d is TyUnion {
    const members: i32[] = []
    flattenVariantsInto(dtix, members)
    let sawI64 = false
    let sawNarrow = false
    let mi = 0
    while mi < members.length {
      const mw = dstIntWidth(members[mi], depth - 1)
      if mw == 64 { sawI64 = true }
      if mw == 32 { sawNarrow = true }
      if primNameOf(members[mi]) == "u8" { sawNarrow = true }
      mi = mi + 1
    }
    if sawI64 && !sawNarrow { return 64 }
  }
  -1
}

// The sentence a radix lexeme gets when its pattern is wider than the destination. One home so the
// no-destination report (64 bits, the widest VL has) and the pinned one read alike.
function radixLitTooWideMsg(lex: string, width: i32) {
  let kind = "a hex literal"
  if lex.length >= 2 {
    const p = lex[1]
    if p == 'b' || p == 'B' { kind = "a binary literal" }
    else if p == 'o' || p == 'O' { kind = "an octal literal" }
  }
  if width >= 64 {
    return lex +
      " does not fit a 64-bit destination — " +
      kind +
      " is a bit pattern of the destination's width, and 64 bits is the widest VL has"
  }
  lex +
    " does not fit a " +
    i32ToStr(width) +
    "-bit destination — " +
    kind +
    " is a bit pattern of the destination's width; write it in decimal for its value, or give it an i64 destination"
}

// Pin the radix literal at `litIx` to `width`. Answers 2 when this reported (the caller then
// answers the flow true, so the opaque width mismatch is not said twice), else 1 when the literal
// adopted 64 bits, else 0. A pattern past 64 bits reported at the literal itself, so it is silent
// here.
function radixLitAdoptWidth(litIx: i32, width: i32) {
  const t = P.nodes[litIx]
  if t is NumLit {
    const bits = numLexRadixBits(t.numText)
    if bits > 64 { return 2 }
    if width == 64 {
      while litWide64.length <= litIx { litWide64.push(false) }
      litWide64[litIx] = true
      if litIx < nodeTyIx.length { nodeTyIx[litIx] = TY_I64 }
      return 1
    }
    if bits > width {
      if !inferQuiet { tErr(radixLitTooWideMsg(t.numText, width), litIx) }
      return 2
    }
  }
  0
}

// The innermost node `ix` peels to through parentheses, or `ix` itself.
function parenPeelIx(ix: i32) {
  if ix < 0 { return ix }
  const e = P.nodes[ix]
  if e is Paren { return parenPeelIx(e.parInner) }
  ix
}

// Pin the radix literal `srcExpr` delivers into `dstTy` to the destination's width. An object
// literal's fields and an array literal's elements reach their own destination sub-type through
// `assignableExpr`'s field-wise and element-wise recursion, which re-enters here. A unary minus is
// not peeled: it makes the literal an operand rather than the delivered value.
function radixLitAdoptDst(srcExpr: i32, dstTy: i32) {
  if inferQuiet || srcExpr < 0 || dstTy < 0 { return 0 }
  const lix = parenPeelIx(srcExpr)
  const e = P.nodes[lix]
  if e is NumLit {
    if numLexRadixBits(e.numText) < 0 { return 0 }
    const w = dstIntWidth(dstTy, 3)
    if w < 0 { return 0 }
    return radixLitAdoptWidth(lix, w)
  }
  0
}

// A radix literal takes the OTHER operand's width, so `x >= 0x80000000` over an `i64` compares the
// 64-bit pattern rather than the i32 one its digits imply. Upward only: a 32-bit peer leaves a
// wide literal alone, so `x + 0x1_0000_0000` still widens the expression to i64.
function radixLitAdoptPeer64(exprIx: i32, peerTy: i32) {
  if dstIntWidth(peerTy, 3) != 64 { return 0 }
  radixLitAdoptDst(exprIx, peerTy)
}

export function assignableExpr(srcExpr: i32, srcTy: i32, dstTy: i32) {
  // A generic function value meeting a concrete function type is decided by instantiation inside
  // `assignable`'s `TyFunc` case (`genericFnAssignable`), so it governs nested positions like an
  // array element too, not just this expression-level entry.
  recordElemRepArrayLit(srcExpr, dstTy, 6)
  recordNullHoleObjAdopt(srcExpr, dstTy, 6)
  // A hex / binary / octal literal is a bit pattern of the destination's width, and this seam is
  // where every binding / argument / return / field / element / store position delivers one.
  if radixLitAdoptDst(srcExpr, dstTy) == 2 { return true }
  // Rep sidecar: an ObjLit/ArrayLit whose source type reaches an unresolved empty-collection hole
  // (`{nodes: []}`, `{m: Map()}`) is plainly `assignable` to its concrete destination, so the
  // short-circuit below returns before the adoption block. Record the destination here so the
  // emitter's row resolver keys the element-resolved shape. Writes only `nodeRepTyIx`.
  if !inferQuiet && srcExpr >= 0 && tyReachesEmptyHole(srcTy, 8) {
    recordRepTyAdopt(srcExpr, dstTy, 6)
  } else if !inferQuiet && srcExpr >= 0 && tyReachesUnion(dstTy, 8) {
    // Union-softening adoption (see `tyReachesUnion`): an ObjLit/ArrayLit whose field value
    // narrowed a destination union field leaves the recorded rep type softened, mis-resolving a
    // same-fieldset twin. Re-stamp the destination rep so the emitter's structural row resolver
    // keys the union-bearing shape. Writes only `nodeRepTyIx`.
    recordRepTyAdopt(srcExpr, dstTy, 6)
  }
  // The flow hook for the un-annotated-parameter solve. It sits above the `assignable`
  // short-circuit because a hole source always returns there, so this is the only point in the
  // function a hole reaches — and every binding / argument / return / field / element / store
  // position flows through here. Inert unless the parameter-solve probe is running.
  noteHoleFlow(srcTy, dstTy)
  if assignable(srcTy, dstTy) {
    // The object-shape floor. `assignable` accepts structural subtyping between two object shapes
    // and the emitter has no adapter for it (`objShapeAdapterless`), so the pair would reach codegen
    // and fail there on a file `vl check` reports clean. It belongs at this seam, the one every
    // delivery flows through. Reported here and answered true, the program being type-valid.
    if !inferQuiet && srcExpr >= 0 {
      // The `Writable` floor (D793). A covariant list assignment whose value is written through
      // cannot be lowered by either answer the language has — an alias admits a type-confused read,
      // and a converting copy gives one handle a private list. The assignment itself is illegal,
      // reported at this seam and answered true, the program being type-valid.
      const cwCode = covarWriteThrough(srcExpr, srcTy, dstTy)
      if cwCode == 1 {
        covarWriteThroughErr(srcExpr, srcTy, dstTy)
        return true
      }
      // D853 — the second arm is a different unsoundness and says so. Two declared unions over one
      // written-through list share one box, so nothing is copied and "the two element storages
      // differ" would be false. The message names the arms rather than the storages.
      if cwCode == 2 {
        covarTwoUnionsErr(srcExpr, srcTy, dstTy)
        return true
      }
      if objShapeAdapterless(srcExpr, srcTy, dstTy, 12, true) {
        objShapeAdapterlessErr(srcExpr, srcTy, dstTy)
      }
    }
    return true
  }
  // Nominal newtype: a syntactic literal is brand-polymorphic and adopts the destination's brand
  // (`const e: EntityId = 1`). A literal has no prior identity, so it cannot be the confusion a
  // newtype exists to catch. Only the destination's own brand is waived, by retrying against the
  // base index; an object literal needs no arm, its field-wise block re-applying the rule per field.
  if nomLitAdopts(srcExpr, srcTy, dstTy) { return true }
  // Function value into a void slot: a `(P…) => T` value is assignable where `(P…) => void` is
  // expected — the coercion that keeps "extract the inline lambda to a named function" from breaking
  // the call that worked. Keyed on the expected type's return being void, and granted only for the
  // set `synthVoidTwins` can mint a capture-free void twin for; other values keep the mismatch.
  if fnValVoidCoerce(srcExpr, srcTy, dstTy) { return true }
  // A `u8` storage slot — an array element, the only position `u8` is legal in — accepts any `i32`
  // value: the storage is one byte, `array.set` truncating to the low 8 bits and `array.get_u`
  // widening back into 0..255. The one error is an out-of-range non-negative integer literal. This
  // lives at the expression seam, `assignable(i32, u8)` staying false so an `i32[]` cannot flow in.
  if primNameOf(dstTy) == "u8" {
    if srcExpr >= 0 {
      const u8e = P.nodes[srcExpr]
      if u8e is Paren { return assignableExpr(u8e.parInner, srcTy, dstTy) }
      if u8e is NumLit {
        if numLexIsFloat(u8e.numText) { return false }
        if u8LexValue(u8e.numText) > 255 {
          if !inferQuiet {
            tErr(
              "the literal " +
                u8e.numText +
                " does not fit a `u8` element (0..255) — a computed value truncates to its low 8 bits, but a literal this size is a mistake the compiler can see",
              srcExpr,
            )
          }
          // Reported here and answered true, the same discipline `objShapeAdapterlessErr` follows:
          // the position is otherwise well-typed, so a second "cannot assign" from the caller
          // would contradict this message.
          return true
        }
        return true
      }
    }
    const u8s = primNameOf(srcTy)
    return u8s == "i32" || u8s == "u8" || u8s == "boolean"
  }
  // A literal re-encodes exactly at f32, so it flows into any destination whose f32 position it
  // fits: a bare `f32`, a nullable `f32?`, or an f32 member of a union. An arbitrary f64 or i32
  // value is not covered. Destination first, and that order is load-bearing for compile time: the
  // integer half folds the lexeme into a bignum, while `dstAdmitsF32` is a short arena walk.
  if dstAdmitsF32(dstTy) {
    if isF32AdoptingLitExpr(srcExpr) { return true }
  }
  // A `boolean` value flows into an i32 slot as 1/0 (A7) — a no-op in codegen, boolean riding in an
  // i32. One-directional, and a bare `true`/`false` literal is excluded. A float-literal array into
  // `f32[]` is the `ArrayLit` recursion in the literal-aware block below, not this arm.
  if primNameOf(dstTy) == "i32" {
    if primNameOf(srcTy) == "boolean" && !isBoolLitExpr(srcExpr) { return true }
  }
  // A literal-typed destination: a bare literal flows wherever its literal type is a member (`"a"`
  // into `"a" | "b"`), even though its softened base (`string`) does not.
  if srcExpr >= 0 {
    const lTy = litTyOfExpr(srcExpr)
    if lTy >= 0 {
      if assignable(lTy, dstTy) { return true }
    }
    // An object literal checks field-wise against a literal-bearing object target, so a field's
    // bare literal can match a literal-union field (`{tag: "circle", r: 5}` against
    // `{tag: "circle" | "square", r: i32}`).
    const e = P.nodes[srcExpr]
    if e is Paren { return assignableExpr(e.parInner, srcTy, dstTy) }
    if e is ObjLit {
      const s = T.tys[srcTy]
      if s is TyObj {
        // A nullable struct target (`S | null`, or a `V?` map value) peels its wrapper so an object
        // literal still adapts field-wise into the inner struct — the ObjLit dual of the ArrayLit
        // peel below. The peel iterates: a nullable-value map slot stacks two wrappers, and a
        // single unwrap leaves the literal against `S | null`.
        let dtix = dstTy
        let dPeel = true
        while dPeel {
          const dNW = T.tys[dtix]
          if dNW is TyNullable { dtix = dNW.nInner } else { dPeel = false }
        }
        const d = T.tys[dtix]
        if d is TyObj {
          const dnames = d.objFieldNames
          const dtys = d.objFieldTypes
          let i = 0
          let ok = true
          while i < dnames.length {
            const sft = objFieldType(s, dnames[i])
            if sft < 0 {
              // Completion coercion: an object literal may omit a field whose declared type admits
              // null — the field is materialized as `null` at construction. A non-nullable omitted
              // field is still required. Scoped to this expression-aware path, not to general
              // structural assignability, so it never widens through a container or variance.
              if !tyAdmitsNull(dtys[i]) { ok = false }
            } else {
              // The field's value expression, for the literal-aware recursion.
              let fexpr = -1
              const fl = e.objFields
              let fi = 0
              while fi < fl.length {
                const fn = P.nodes[fl[fi]]
                if fn is FieldInit {
                  if fn.fiName == dnames[i] { fexpr = fn.fiValue }
                }
                fi = fi + 1
              }
              if !assignableExpr(fexpr, sft, dtys[i]) { ok = false }
            }
            i = i + 1
          }
          // Rep sidecar: a field-wise-adopted ObjLit builds the destination struct rep (a boxed
          // union field, an i64/f32 field, an omitted nullable field), so record it on the literal
          // node and the emitter's row resolver keys the shape it builds, not the self-inference.
          if ok { recordRepTyAdopt(srcExpr, dstTy, 6) }
          return ok
        }
        // A struct literal flowing into a union adopts the first struct arm it adapts into
        // field-wise (`{f: 97.5}` into `{f: f32} | {w: i32}`). The emitter already boxes a struct
        // literal into a union slot at a direct binding; this is the checker seam that lets a
        // widening field reach that same rep. The concrete arm is recorded on the literal node.
        if d is TyUnion {
          // Flattened, because a union member may itself be a union: `type Shape = Circle | Rect`
          // used as an arm of `Shape | ParseError` leaves a `TyUnion` in `uMembers`, which the
          // `mt is TyObj` test skips. Each candidate is still gated by `unionArmBoxSafe` and still
          // recorded as the concrete arm; canon's union-alias flatten covers both spellings.
          const members: i32[] = []
          flattenVariantsInto(dstTy, members)
          let mi = 0
          while mi < members.length {
            const mt = T.tys[members[mi]]
            if mt is TyObj && unionArmBoxSafe(members[mi]) {
              if assignableExpr(srcExpr, srcTy, members[mi]) {
                if !inferQuiet {
                  while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
                  nodeTyIx[srcExpr] = members[mi]
                  // Rep sidecar: the struct literal builds the concrete arm struct's rep — record
                  // it, recursing into fields, for the row resolver.
                  recordRepTyAdopt(srcExpr, members[mi], 6)
                }
                return true
              }
            }
            mi = mi + 1
          }
        }
      }
    }
    // An array literal checks element-wise against the target's element type, so a bare element
    // adapts exactly as it would at a binding — the array analogue of the ObjLit recursion above.
    // This subsumes the scalar float-literal into `f32[]` rule at any element type and nesting
    // depth. An empty `[]` fits any element; a non-literal element still rejects a lossy demote.
    if e is ArrayLit {
      // A map value or niche slot is `V?` (`{[string]: f32[]}` seeds `f32[]?`) — peel the nullable
      // wrappers so a literal array still adapts into the inner element type; a nullable-value map
      // slot stacks two, so the peel iterates like the ObjLit one above.
      let dtix = dstTy
      let dPeel = true
      while dPeel {
        const dNW = T.tys[dtix]
        if dNW is TyNullable { dtix = dNW.nInner } else { dPeel = false }
      }
      const d = T.tys[dtix]
      if d is TyArray {
        let i = 0
        let ok = true
        while i < e.arrElems.length {
          if (
            !assignableExpr(
              e.arrElems[i],
              litElemSrcTy(e.arrElems[i], srcTy),
              d.aElem,
            )
          ) {
            ok = false
          }
          i = i + 1
        }
        // Context adoption (atom lists): a literal array accepted by a literal-union element target
        // is that atom list (`const ks: VK[] = ["aa", "bb"]`), so the destination array type is
        // recorded on the literal node and the emitter classifies it as the i32 atom-id list. The
        // niche-nullable scalar elements record the same way — `[null]` carries no other signal.
        if (
          ok &&
          !inferQuiet &&
          (tyIsLitUnion(d.aElem) ||
            tyIsNicheNulScalarElem(d.aElem) ||
            arrLitJoinUnionElem(srcExpr, dtix))
        ) {
          if srcExpr < nodeTyIx.length { nodeTyIx[srcExpr] = dtix }
        }
        // Rep sidecar: a literal array adopted element-wise (a struct-element list widened, an
        // i64/f32 element) builds the destination element rep — recurse into the elements so each
        // element ObjLit resolves the shape the emitter builds.
        if ok { recordRepTyAdopt(srcExpr, dstTy, 6) }
        return ok
      }
      // An array literal flowing into a union adopts the first array arm it adapts into
      // element-wise (`["a"]` into `K0[] | {w: i32}`, `[1.5]` into `f32[] | i64`) — the array dual
      // of the ObjLit union-arm adoption above. The concrete arm is recorded on the literal node so
      // the emitter classifies the list with the arm's element rep, not the literal's softened one.
      if d is TyUnion {
        const members = d.uMembers
        let mi = 0
        while mi < members.length {
          const mt = T.tys[members[mi]]
          if mt is TyArray {
            // An `f32[]` arm adopts like any other list arm: the f32-list value atom
            // (kind 12) gives the box a real rep, and the emitter's coerce re-encodes
            // the literal's f64-classified elements at f32 (`coerceListKind` 7).
            if assignableExpr(srcExpr, srcTy, members[mi]) {
              if !inferQuiet {
                while nodeTyIx.length <= srcExpr { nodeTyIx.push(-1) }
                nodeTyIx[srcExpr] = members[mi]
                // Rep sidecar: record the concrete array arm, recursing into elements, so the row
                // resolver keys the arm the checker picked.
                recordRepTyAdopt(srcExpr, members[mi], 6)
              }
              return true
            }
          }
          mi = mi + 1
        }
      }
    }
  }
  false
}

// The value of an integer lexeme, saturated at 256 — "256" means "above the `u8` range", whatever
// the lexeme is. Saturating rather than folding keeps this free of the bignum path
// `intLexemeFitsI32` needs: the walk stops the moment the accumulator passes 255. Radix prefixes
// and `_` separators are honoured; a lexeme with a digit its radix does not admit saturates too.
function u8LexValue(t: string) {
  let base = 10
  let i = 0
  if t.length >= 2 && t[0] == '0' {
    const p = t[1]
    if p == 'x' || p == 'X' {
      base = 16
      i = 2
    } else if p == 'b' || p == 'B' {
      base = 2
      i = 2
    } else if p == 'o' || p == 'O' {
      base = 8
      i = 2
    }
  }
  let v = 0
  while i < t.length {
    const c = t[i]
    if c != '_' {
      let d = -1
      if c >= '0' && c <= '9' { d = c - '0' }
      else if c >= 'a' && c <= 'f' { d = c - 'a' + 10 }
      else if c >= 'A' && c <= 'F' { d = c - 'A' + 10 }
      if d < 0 || d >= base { return 256 }
      v = v * base + d
      if v > 255 { return 256 }
    }
    i = i + 1
  }
  v
}

// Does the non-negative integer lexeme `t` default to i32? A DECIMAL lexeme denotes a value and
// defaults by its magnitude, widening to i64 rather than silently wrapping. A RADIX lexeme
// (`0x`, `0b`, `0o`) denotes a bit pattern and defaults by its width (`numLexRadixBits`), which
// is the ruled literal rule — DECISIONS.md §"A hex literal is a bit pattern".
export function intLexemeFitsI32(t: string) {
  const rb = numLexRadixBits(t)
  if rb >= 0 { return rb <= 32 }
  let v = 0
  let i = 0
  const base = 10
  while i < t.length {
    const c = t[i]
    if c == '_' {
      i = i + 1
    } else {
      const d = c - '0'
      if v > (2147483647 - d) / base { return false }
      v = v * base + d
      i = i + 1
    }
  }
  true
}

// Is the integer lexeme's magnitude exactly 2^31 (2147483648)? The parser folds a negated literal
// into a signed literal before defaulting, so `-2147483648` sits at I32_MIN and defaults to i32
// even though the bare magnitude is one past I32_MAX; the unary `-` arm uses this for parity.
// Compares the significant digits against 2^31 written in the lexeme's own base.
export function intLexemeIs2Pow31(t: string) {
  let digits = "2147483648"
  let i = 0
  if t.length >= 2 && t[0] == '0' {
    const p = t[1]
    if p == 'x' || p == 'X' {
      digits = "80000000"
      i = 2
    } else if p == 'b' || p == 'B' {
      digits = "10000000000000000000000000000000"
      i = 2
    } else if p == 'o' || p == 'O' {
      digits = "20000000000"
      i = 2
    }
  }
  let started = false
  let j = 0
  while i < t.length {
    const c = t[i]
    if c == '_' {
      i = i + 1
    } else if !started && c == '0' {
      i = i + 1
    } else {
      started = true
      if j >= digits.length { return false }
      if c != digits[j] { return false }
      i = i + 1
      j = j + 1
    }
  }
  j == digits.length
}

// Is the expression at `ix`, peeling parens, an integer literal of magnitude exactly 2^31 — the one
// operand whose negation fits i32 while the bare literal does not? Companion of
// `intLexemeIs2Pow31` for the unary `-` arm.
function isNegI32MinLit(ix: i32) {
  if ix < 0 { return false }
  const e = P.nodes[ix]
  if e is Paren { return isNegI32MinLit(e.parInner) }
  if e is NumLit {
    if numLexIsFloat(e.numText) { return false }
    return intLexemeIs2Pow31(e.numText)
  }
  false
}

// True if the type name contains the top-level separator `sep` — `|` for an inline-union synthetic
// name `A|B|null`, `&` for an intersection `A&B`.
function nameHasSep(name: string, sep: i32) {
  tyTopIndexOf(name, sep, 0, 0) >= 0
}

function nameHasPipe(name: string) { nameHasSep(name, '|') }

// D-ARRGROUP — the one home of the array-element grouping rule, shared by all three renderers.
// The element is wrapped in grouping parens before the `[]` exactly when the suffix would
// otherwise re-bind: a function element, where the trailing `[]` binds into the closure's result,
// or a union element, parenthesized so its `|`s stop being top-level. The width is the producer's.
function arrElemRender(el: string, elTy: i32, elAtoms: i32): string {
  if tyIxIsFunc(elTy) { return "(" + el + ")[]" }
  if elAtoms > 1 { return "(" + el + ")[]" }
  el + "[]"
}

// Is arena index `ix` a function type? Total in `ix`, and that is the whole reason it exists: `-1`
// is the declared hole an empty `[]` element or an unresolved lambda result carries, and
// `T.tys[-1]` is an out-of-bounds `array.get` that traps the compiler. The display renderer must
// render every type it is handed, holes included, so it reaches the test with `-1` in hand.
function tyIxIsFunc(ix: i32): boolean {
  if ix < 0 || ix >= T.tys.length { return false }
  const t = T.tys[ix]
  if t is TyFunc { return true }
  false
}

// The index of a top-level `=>` in `name`, or -1 — the function-type marker the parser emits for
// `(params) => ret`. An arrow nested in a param or return group (`((i32) => i32) => void`) or in a
// generic argument (`Box<(i32) => i32>`) is not the top one; `'='` is the scanner's arrow token,
// so the `>` lookahead lives in the home.
function topLevelArrowIndex(name: string) { tyTopIndexOf(name, '=', 0, 0) }

// The top-level arrow index the last `isTopLevelFuncTypeName` call scanned for, produced by the
// predicate instead of re-derived by a caller that needs the index as well as the answer.
// Meaningful only when that call returned true; a false answer can come from any of the three
// conjuncts and leaves whatever the scan found.
let funcArrowAt = -1

// True if `name` is a top-level function type `(params)=>ret` — a top-level `=>` with the leading
// `(...)` param group closing right before it. The `=>` binds looser than `|`/`&`, so
// `(i32) => A | B` is a function returning a union, and this guards the union and intersection
// splits from grabbing a separator that belongs to the return.
export function isTopLevelFuncTypeName(name: string) {
  const arrowAt = topLevelArrowIndex(name)
  funcArrowAt = arrowAt
  if arrowAt < 1 { return false }
  // The paren grammar's open half at its home in `tyname.vl`. The close half stays inline and must:
  // this is the arrow-relative spelling — the param list closes right before the `=>`, so the last
  // character of the whole name belongs to the return type, and `nameIsParenSpanEnds` would answer
  // about a different position entirely.
  if !nameIsParenOpen(name) { return false }
  if name[arrowAt - 1] != ')' { return false }
  true
}

// ── the top-level split lives in `tyname.tyTopLevelSplit` ───────────────────
// It cannot live in `emit_base.vl`, which imports this file — a call from here would cycle the
// module graph. `tyname.vl` is the zero-import leaf that already holds `tyTopIndexOf`.

// The registry slot of a generic alias base name ("Box"), or -1.
function gaIndexOf(name: string) {
  let i = 0
  while i < gaNames.length {
    if gaNames[i] == name { return i }
    i = i + 1
  }
  -1
}

// The AST node — a `TypeRef` or annotation child — that diagnostics raised inside name resolution
// anchor to: the generic-alias arity error and the bare-generic-use error. Resolution is name-keyed
// and no node flows through it, so the positioned entry points bank their `TypeRef` node here
// through `nameToTyAt` / `resolveAnnotAt`; -1 outside them, as in the emitter's re-resolutions.
let annotDiagAt = -1

// Resolve an annotation from the parser's spelling tree where the annotation node carries one, and
// from the concatenated name where it does not. `annTsOf` answers -1 for exactly two populations,
// neither a checker-time annotation: an emitter-synthesized `TypeRef`, and a name a later pass
// rewrote without the node. Both reach `nameToTy` through the unpositioned entries.
function annotResolve(name: string, root: i32) {
  if root >= 0 { return tsToTy(root) }
  nameToTy(name)
}

// Resolve annotation `name` with resolution diagnostics anchored at node `at`, reading the spelling
// tree banked on annotation node `ann`. The two are the same node at three of the four callers;
// they differ at a struct field, whose "unknown type" diagnostic anchors on the `FieldDef` so the
// message points at the field, while the spelling is banked on the `TypeRef` child.
function nameToTyAnn(name: string, at: i32, ann: i32) {
  const saved = annotDiagAt
  annotDiagAt = at
  const r = annotResolve(name, annTsOf(ann))
  annotDiagAt = saved
  r
}

// The same, where the diagnostic anchor IS the annotation node.
function nameToTyAt(name: string, at: i32) { nameToTyAnn(name, at, at) }

// The type on the right of an `is` / `!is` test, and of a `match` type pattern, which
// `parseMatchPattern` mints as a real `IsExpr`. Resolved from the parser's spelling tree, banked on
// the `IsExpr` node itself. Diagnostics anchoring is deliberately not `nameToTyAt`'s: an `is` type
// has never set `annotDiagAt`, and `annotResolve`'s name leg is structurally dead here.
function isTypeTy(name: string, isIx: i32) { annotResolve(name, annTsOf(isIx)) }

// The same type, for the three readers of an `is` node that has already been checked — the two
// narrowing collectors and the if-chain exhaustiveness scan. Where the spelling is a bare name the
// bank is the answer. A composite spelling resolves instead, and for the arena's sake rather than
// the answer's: `T.tys` is not hash-consed, so the reader's index differs by construction.
function isTypeTyRead(name: string, isIx: i32) {
  const banked = isVarTyIxOf(isIx)
  if banked >= 0 {
    const root = annTsOf(isIx)
    if root >= 0 {
      if tsKind[root] == TS_NAME { return banked }
    }
  }
  isTypeTy(name, isIx)
}

// Apply a generic alias (`Box<i32>`, `Pair<i32,string>`, `Box<T>` under a live type-param env):
// resolve the arguments, check the arity, bind the declared parameter names to them, and resolve
// the declaration's fields under those bindings. Memoizes into `cUserTypes` under a resolved key,
// registered as a placeholder first so recursion terminates. -1 for an unknown base or argument.
export function applyGenAlias(head: string, inner: string) {
  applyGenAliasArgs(head, inner, -1)
}

// The body of `applyGenAlias`, with the argument list taken from either source: `appIx >= 0` is a
// `TS_APP` spelling node whose kids are the arguments, and `inner` is then unused; `appIx < 0`
// splits `inner` at its top-level commas. Everything after the argument list is one body precisely
// because the two routes must not be able to drift.
function applyGenAliasArgs(head: string, inner: string, appIx: i32) {
  const gi = gaIndexOf(head)
  // D1582 — `Map<string, i32>` reaches the alias-application door, not the leaf
  // ladder, so the same hint has to be banked here too or the spelling a consumer
  // is most likely to try is the one that stays unhelpful.
  if gi < 0 { return builtinCtorTyLeafFail(head) }
  // The declared parameter names, read as a slice of the flat column — split once when the alias
  // registered (D-GAPARAM), not re-split here per application. `pcount` is the declared arity.
  const pstart = gaParamStart[gi]
  const pcount = gaParamCount[gi]
  const argTys: i32[] = []
  if appIx >= 0 {
    const astart = tsKidStart[appIx]
    const acnt = tsKidCount[appIx]
    let ti = 0
    while ti < acnt {
      const kid = tsKids[astart + ti]
      // The recovery leaf renders `""`, which `splitGenArgs` drops — so `Box<>` is an arity
      // error on both routes, not an unresolved argument.
      if tsKind[kid] != TS_ERR {
        const a = tsToTy(kid)
        if a < 0 { return -1 }
        argTys.push(a)
      }
      ti = ti + 1
    }
  } else {
    const argNames: string[] = []
    tyTopLevelSplit(inner, ',', true, argNames)
    let ai = 0
    while ai < argNames.length {
      const a = nameToTy(argNames[ai])
      if a < 0 { return -1 }
      argTys.push(a)
      ai = ai + 1
    }
  }
  if argTys.length != pcount {
    tErr(
      "`" +
        head +
        "` expects " +
        i32ToStr(pcount) +
        " type arguments but got " +
        i32ToStr(argTys.length),
      annotDiagAt,
    )
    return TY_ERR
  }
  let memoKey = head + "<#"
  let mi = 0
  while mi < argTys.length {
    memoKey = memoKey + i32ToStr(argTys[mi]) + ","
    mi = mi + 1
  }
  const cuHit = cUserTypes[memoKey]
  if cuHit is i32 { return cuHit }
  const fnames: string[] = []
  const ftys: i32[] = []
  const resIx = mkObjTy(fnames, ftys)
  cUserTypes[memoKey] = resIx
  cUserTypesVer = cUserTypesVer + 1 // new declared-name resolution registered
  // Bank the fact that this arena index is the application `head<argTys>`. Recorded on the memo
  // miss, so exactly one row exists per distinct application — the same population `cUserTypes`
  // keys, and the same index every later hit returns.
  cTyIxSetAdd(gaAppTyIxs, gaAppTyIxSet, resIx)
  gaAppHeads.push(head)
  gaAppArgStart.push(gaAppArgFlat.length)
  gaAppArgCount.push(argTys.length)
  gaAppFinite.push(-1)
  let gaf = 0
  while gaf < argTys.length {
    gaAppArgFlat.push(argTys[gaf])
    gaf = gaf + 1
  }
  let bi = 0
  while bi < pcount {
    tpEnvNames.push(gaParamNames[pstart + bi])
    tpEnvTys.push(argTys[bi])
    bi = bi + 1
  }
  const decl = P.nodes[gaDeclIxs[gi]]
  if decl is TypeDecl {
    const dfields = decl.tdFields
    let fi = 0
    while fi < dfields.length {
      const fd = P.nodes[dfields[fi]]
      if fd is FieldDef {
        fnames.push(fd.fdName)
        let fty = TY_ERR
        if fd.fdType >= 0 {
          const ftn = P.nodes[fd.fdType]
          if ftn is TypeRef {
            // The alias body's field annotation is a parsed `TypeRef` like any
            // other, so it resolves from its own spelling tree — under the `<T>`
            // bindings pushed above, which both routes read from `tpEnvNames`.
            const r = annotResolve(ftn.tyName, annTsOf(fd.fdType))
            if r >= 0 {
              fty = r
              // Record the resolved type on the field's type-annotation node so the emitter
              // classifies a field type structurally from the `Ty` arena, not a re-parsed name.
              if !inferQuiet && fd.fdType < nodeTyIx.length {
                nodeTyIx[fd.fdType] = r
              }
            } else {
              tErr(
                unknownTyTextIn(ftn.tyName, " for field '" + fd.fdName + "'"),
                dfields[fi],
              )
            }
          }
        }
        ftys.push(fty)
      }
      fi = fi + 1
    }
  }
  // The placeholder registered above is now filled in place (its field arrays are `fnames`/`ftys`)
  // — an existing arena entry changed shape.
  tyMutEpoch = tyMutEpoch + 1
  let pj = 0
  while pj < pcount {
    tpEnvNames.pop()
    tpEnvTys.pop()
    pj = pj + 1
  }
  resIx
}

// ── the three leaf rungs both resolvers bottom out at ────────────────────────

// `nameToTy` (the character-surgery resolver) and `tsToTy` (the structural one) differ only in how
// they take a composition apart — a union, an array suffix, an inline object. Where the spelling is
// a bare identifier there is nothing to take apart and both must answer identically, so the three
// leaf rungs live here once. Each is a nominal lookup and inspects no character of its argument.

// The primitive spellings. -1 means "not a primitive" — every hit is a fixed arena index, all >= 0,
// so the sentinel cannot collide with an answer. Exported because the emit side's name bridge
// (`emit_rep.declTyIxOfName`) asks it directly, and the answers are the arena's seeded indices, so
// the emit-side rung and this resolver's leaf are the same value by construction.
export function primTyOfName(name: string) {
  if name == "i32" { return TY_I32 }
  if name == "i64" { return TY_I64 }
  if name == "f64" { return TY_F64 }
  if name == "f32" { return TY_F32 }
  if name == "boolean" { return TY_BOOL }
  if name == "string" { return TY_STR }
  if name == "void" { return TY_VOID }
  // The `null` type itself — the check type of `x is null` (host: an Alias
  // named "null"); union members spell it through the `|`-split / `TS_NULL`.
  if name == "null" { return TY_NULL }
  -1
}

// The set of type names an annotation resolves with no declaration in sight: `primTyOfName`'s
// spellings plus `u8`, the storage type it deliberately withholds. One home, because a second copy
// is a second answer. A list and not a predicate, because the `did you mean` suggester has to
// enumerate the names in scope rather than test one; a spelling missing here stops being reserved.
const builtinTyNames = [
  "i32",
  "i64",
  "f64",
  "f32",
  "boolean",
  "string",
  "void",
  "null",
  "u8",
]

// Read by the merge's type-position rename and by `tErrBuiltinTyDecl`'s two callers.
export function isBuiltinTyName(name: string) {
  let i = 0
  while i < builtinTyNames.length {
    if builtinTyNames[i] == name { return true }
    i = i + 1
  }
  false
}

// A live type-parameter binding — a generic function's `<T>` while its annotations resolve, or a
// generic alias application's params while its body resolves — innermost wins. `tpEnvTys` only ever
// receives `mkTyVar` results and already-resolved argument types, both >= 0, so -1 unambiguously
// means "not bound".
function tpEnvTyOfName(name: string) {
  let tpi = tpEnvNames.length - 1
  while tpi >= 0 {
    if tpEnvNames[tpi] == name { return tpEnvTys[tpi] }
    tpi = tpi - 1
  }
  -1
}

// The one wording for a method member written where a value type belongs, raised by both annotation
// routes (`nameToTyReal`'s rendered-name arm and `tsToTyReal`'s spelling-tree arm). `member` is the
// member's own text as the author spelled it. A design refusal, not a capability gap: a method
// member demands that a call type-check, while a value type describes what a value carries.
function methodInValuePosMsg(member: string) {
  "a method member `" +
    member +
    "` may only appear in a BOUND — it demands that a call type-checks, which is not something a value carries. For a stored closure write the field form `name: (…) => R`; to constrain a type parameter write `<T: { " +
    member +
    " }>`"
}

function declaredTyOfName(name: string) {
  // A bound in value position: a design refusal, not a capability gap. `{ toString(): string }` as
  // a parameter type would be an existential needing dynamic dispatch, and everything in VL
  // monomorphizes. The sentence names the position it is legal in. A body-scope `type` needs no arm
  // here — the parser hoists it under a unique name, so pass 0a registers it like any other (D1045).
  if cBoundDecls.has(name) {
    tErr(
      "`" +
        name +
        "` is a BOUND, not a type — it declares method members, which constrain a type parameter and have no values. Use it as a constraint: `function f<T: " +
        name +
        ">(x: T)`",
      annotDiagAt,
    )
    return TY_ERR
  }
  if cUserTypes.has(name) {
    // Order-independence, at the one entry point every route to a declared type comes through
    // (`tsLeafTy` and `nameToTyReal`'s last rung both bottom out here). Pass 0a minted this entry as
    // an empty placeholder and pass 0b fills it; a name resolved in between reads the placeholder,
    // which is a different type and not merely a missing one. Inert outside pass 0b.
    forceDeclFill(name)
    const ut = cUserTypes[name] ?? -1
    let res = ut
    if ut >= 0 {
      const utt = T.tys[ut]
      if utt is TyUnion {
        // Collapse a primitive-scalar single member, and an object member reached through a plain
        // alias reference (`type MyCat = Cat`, `type Y = Box<i32>`). The one-member object case that
        // stays opaque is the canonicalized intersection, which the emitter interns as a named
        // struct. `singleAliasMemberTyIx` is the single rule both sides read.
        const sm = singleAliasMemberTyIx(ut, name)
        // A nominal newtype keeps the collapse and adds a brand on top of it — `nwBrand` is the
        // identity for every name not declared `new`. The collapse must stay: it is what the
        // emitter's `singleMemberAliasTyIx` twin does with the same annotation, and the brand is
        // invisible to it, which is precisely why the newtype costs nothing to emit.
        if sm >= 0 { res = sm }
      }
    }
    const answer = nwBrand(name, res)
    // D1048's second-hint provenance, re-banked at the reference. The declaration route recorded
    // that `type R = string | "err"` dropped an arm, and every later `: R` resolves through here.
    // It banks the index the reference actually answers, which is what makes an enclosing spelling
    // (`R[]`, `R | i32`) decline on its own. `forceDeclFill` above makes it order-independent.
    if collapsedAliases.has(name) {
      if answer >= 0 { collapsedTy = answer }
    }
    return answer
  }
  // A bare reference to a generic alias has no concrete type: its parameters are never supplied.

  if gaIndexOf(name) >= 0 {
    tErr(
      "Generic type `" +
        name +
        "` expects type arguments but was used without any",
      annotDiagAt,
    )
    return TY_ERR
  }
  -1
}

// The leaf a spelling node with nothing to decompose resolves to: `TS_NAME`'s identifier,
// `TS_MAP`'s key token, and `TS_ERR`'s `""`. All three are single tokens the lexer produced, so the
// composition arms `nameToTy` runs between the primitive check and the type-param check provably
// cannot fire on them — an ident lexeme holds no `[`, `{`, `<` or `|`.
function tsLeafTy(name: string) {
  if name == "u8" { return storageTyLeafFail() }
  const pv = primTyOfName(name)
  if pv >= 0 { return pv }
  const tv = tpEnvTyOfName(name)
  if tv >= 0 { return tv }
  const dv = declaredTyOfName(name)
  if dv >= 0 { return dv }
  builtinCtorTyLeafFail(name)
}

// D-MAPKEYDIAG — the spelling node whose key the unsupported-map-key diagnostic names, or -1 when
// this annotation opens no map spelling. The structural dual of `tyname.mapSpellKeyName`'s gate,
// which is deliberately wider than a whole map span: a list of boolean-keyed maps and a nullable
// one are the same mistake. Read structurally, that width is a descent down the left spine.
function tsMapKeyNodeOf(root: i32) {
  let ix = root
  let out = -1
  let going = true
  while going {
    going = false
    if ix >= 0 {
      const k = tsKind[ix]
      if k == TS_MAP {
        out = ix
      } else if k == TS_ARR || k == TS_UNION || k == TS_ISECT {
        if tsKidCount[ix] > 0 {
          ix = tsKids[tsKidStart[ix]]
          going = true
        }
      }
    }
  }
  out
}

// ── `tsToTy` — the structural dual of `nameToTy` ─────────────────────────────

// `nameToTy` below is the compiler's second recursive-descent type parser; the first is
// `parseTypeName`, which returned a concatenated string. This consumes the flat spelling tree that
// parser keeps — arm for arm, in `nameToTy`'s order, with the same constructors in the same
// sequence, because the arena is not hash-consed and a dual that allocates differently is not one.

// The unknown-type component bank: both resolvers answer -1 and -1 propagates out of every
// composite arm, so the caller only ever held the whole annotation. `unkTyPart` banks the first
// failing component — the innermost frame to fail writes its spelling, enclosing frames leave a
// non-empty bank alone, and `unkTyDepth`'s outermost frame clears it. One shared counter.
let unkTyPart = ""
let unkTyDepth = 0

// The second bank on the same wire: a union member list the emitter cannot separate
// (`nomUnionRepClashMsg`) is a resolution failure with a diagnostic of its own, so
// `annUnionInnerTy` poisons the annotation to -1 exactly as an unresolved member does and banks
// why. Every `unknownTyText` caller then reports the specific reason without gaining an arm.
let unkTyClash = ""

// ── the subsumed-arm collapse's provenance (D1048) ───────────────────────────

// The third bank on the same wire, and it exists because the collapse is invisible in its own
// result: `string | "err"` resolves to `string`, so nothing about the answer distinguishes it from
// a `string` nobody wrote a union for. `collapsedTy` is the arena index the resolution in flight
// collapsed to, or -1; a consumer compares it against its own resolved type. Memoized alongside.
let collapsedTy = -1
// The declared aliases whose union spelling collapsed (`type R = string | "err"`). The declaration
// route builds its member list itself and never reaches the annotation home, so it records here and
// `declaredTyOfName` re-banks on every later reference — which is what carries the provenance
// across `function f(): R`.
let collapsedAliases: {[string]: boolean} = Map()
// `annotNameMemo`'s companion: the `collapsedTy` a name's resolution banked.
let annotCollapsed: {[string]: i32} = Map()

// A storage type named where a value type is required. Banks the reason on the `unkTyClash` wire —
// the same channel the union rep-clash uses — so every `unknownTyText` caller reports why without
// gaining an arm, and returns the -1 that poisons the enclosing annotation exactly as an unresolved
// name does. The message names the rule: wasm has i8 as a storage type only, and VL mirrors that.
function storageTyLeafFail() {
  unkTyClash = "`u8` is a storage type, not a value type — it may be an array element (`u8[]`), but a local, parameter, return, field, map value or generic argument is a value, and values are `i32`"
  -1
}

// `Map`/`Set` name a constructor, never a type — the type is spelled with the index
// signature, so this banks the suggestion on `unkTyClash` rather than adding an arm.
// Reached only after the declared-name lookup, so a user `type Map = …` still wins
// (D1582).
function builtinCtorTyLeafFail(name: string) {
  if name == "Map" {
    unkTyClash = "`Map` is not a type name — `Map()` is the constructor and the map TYPE is spelled `{[K]: V}`, e.g. `{[string]: i32}`"
  } else if name == "Set" {
    unkTyClash = "`Set` is not a type name — `Set()` is the constructor and the set TYPE is spelled `{[K]: boolean}`, e.g. `{[string]: boolean}`"
  }
  -1
}

// Other-language spellings of VL's primitives (`Boolean`, `String`, `Number`, …) — a
// suggestion table, not aliases: none of these becomes a type. Matched ASCII
// case-folded. Positional pair: `tySpellTo[i]` answers `tySpellFrom[i]`.
const tySpellFrom = [
  "bool",
  "boolean",
  "int",
  "integer",
  "int32",
  "i32_t",
  "long",
  "int64",
  "float",
  "double",
  "number",
  "str",
  "string",
  "byte",
]
const tySpellTo = [
  "boolean",
  "boolean",
  "i32",
  "i32",
  "i32",
  "i32",
  "i64",
  "i64",
  "f64",
  "f64",
  "f64",
  "string",
  "string",
  "u8",
]

// `a` equals `b` with ASCII case folded; `b` is assumed already lower-case, which is
// what lets one table answer `bool`, `Bool` and `BOOL`.
function tyFoldedEq(a: string, b: string) {
  if a.length != b.length { return false }
  let i = 0
  while i < a.length {
    let c = a[i]
    if c >= 'A' && c <= 'Z' { c = c + 32 }
    if c != b[i] { return false }
    i = i + 1
  }
  true
}

// Levenshtein with adjacent transposition (optimal string alignment): plain Levenshtein
// charges `i23`→`i32` two edits, over the budget a three-character name has. Runs once
// per unresolved name on the diagnostic path, so the cost is never felt during a compile.
function tyEditDist(a: string, b: string) {
  const n = a.length
  const m = b.length
  if n == 0 { return m }
  if m == 0 { return n }
  const w = m + 1
  const d: i32[] = []
  let k = 0
  while k < (n + 1) * w {
    d.push(0)
    k = k + 1
  }
  let j0 = 0
  while j0 <= m {
    d[j0] = j0
    j0 = j0 + 1
  }
  let i = 1
  while i <= n {
    d[i * w] = i
    let j = 1
    while j <= m {
      let cost = 1
      if a[i - 1] == b[j - 1] { cost = 0 }
      let best = d[(i - 1) * w + j] + 1
      const ins = d[i * w + j - 1] + 1
      if ins < best { best = ins }
      const sub = d[(i - 1) * w + j - 1] + cost
      if sub < best { best = sub }
      if i > 1 && j > 1 && a[i - 1] == b[j - 2] && a[i - 2] == b[j - 1] {
        const tr = d[(i - 2) * w + j - 2] + 1
        if tr < best { best = tr }
      }
      d[i * w + j] = best
      j = j + 1
    }
    i = i + 1
  }
  d[n * w + m]
}

// How far a suggestion may sit from the typed spelling: one edit up to four characters, two
// up to eight, three beyond. Scales because a fixed budget is wrong at both ends — at 1 it
// mutes `Cricle` → `Circle`, at 3 a three-letter name would reach half the built-ins.
function tySuggestBudget(len: i32) {
  if len <= 4 { return 1 }
  if len <= 8 { return 2 }
  3
}

// The suggestion for unresolved spelling `name`, or "" for none: first `tySpellFrom`/
// `tySpellTo`, then edit distance over `builtinTyNames` and declared types, built-ins
// first so ties keep the earlier candidate. Offered under `demangleName`'s source
// spelling; a composite key is never offered.
function tySuggestFor(name: string) {
  if name.length < 2 { return "" }
  if !nameIsBareIdent(name) { return "" }
  let si = 0
  while si < tySpellFrom.length {
    if tyFoldedEq(name, tySpellFrom[si]) { return tySpellTo[si] }
    si = si + 1
  }
  const budget = tySuggestBudget(name.length)
  let best = ""
  let bestD = budget + 1
  let bi = 0
  while bi < builtinTyNames.length {
    const bn = builtinTyNames[bi]
    const bd = tyEditDist(name, bn)
    if bd < bestD {
      bestD = bd
      best = bn
    }
    bi = bi + 1
  }
  for k in cUserTypes.keys() {
    const un = demangleName(k)
    if un.length >= 2 && un != name && nameIsBareIdent(un) {
      const ud = tyEditDist(name, un)
      if ud < bestD {
        bestD = ud
        best = un
      }
    }
  }
  best
}

// The `; did you mean '<name>'?` clause, or "" when nothing is near enough. A suffix by
// construction, so a consumer matching the `unknown type '<name>'` prefix keeps matching;
// callers with a clause of their own route through `unknownTyTextIn` instead of
// concatenating after this.
function tyDidYouMean(name: string) {
  const s = tySuggestFor(name)
  if s.length == 0 { return "" }
  "; did you mean '" + s + "'?"
}

// The `unknown type` diagnostic text for the whole annotation `name`, naming the
// offending component when the bank holds one that is not the whole name. Read
// immediately after the failing resolution — every call site is a resolve/`tErr` pair.
function unknownTyText(name: string) { unknownTyTextIn(name, "") }

// The same text with the caller's own trailing clause (`… for field 'a'`, `… in union
// 'U'`) placed before the suggestion, so `did you mean` always ends the sentence.
function unknownTyTextIn(name: string, tail: string) {
  if unkTyClash.length > 0 { return unkTyClash + tail }
  const part = unkTyPart
  if part.length == 0 {
    return "unknown type '" + name + "'" + tail + tyDidYouMean(name)
  }
  if part == name {
    return "unknown type '" + name + "'" + tail + tyDidYouMean(name)
  }
  // "within", not "in": some call sites already append their own `in …` clause, and
  // "unknown type 'T' in 'T&S' in union 'Both<T>'" would read as one clause too many.
  "unknown type '" +
    part +
    "' within '" +
    name +
    "'" +
    tail +
    tyDidYouMean(part)
}

// The method twin of `tySpellFrom`/`tySpellTo`, one table per receiver kind: a list, a
// string and a map answer the same typo with a different name. A target whose arguments
// differ from the call written (`charAt` takes an index, `slice` a range) is stored as the
// whole call shape, never a bare name.
const strMethodSpellFrom = [
  "charat",
  "substring",
  "substr",
  "touppercase",
  "tolowercase",
  "size",
  "count",
]
const strMethodSpellTo = [
  "slice(i, i + 1)",
  "slice",
  "slice",
  "toUpperAscii",
  "toLowerAscii",
  "length",
  "length",
]
const listMethodSpellFrom = ["append", "add", "size", "count", "contains"]
const listMethodSpellTo = ["push", "push", "length", "length", "includes"]
const mapMethodSpellFrom = ["put", "containskey", "size"]
const mapMethodSpellTo = ["set", "has", "length"]

// The intrinsic call-able names `checkCallNode` tests for a string/array receiver, in
// that order — a tie in the edit distance below keeps the earlier (intrinsic) candidate.
const strMethodNames = [
  "slice",
  "indexOf",
  "includes",
  "charCodeAt",
  "cpAt",
  "cpLen",
  "isCharBoundary",
  "bytes",
  "length",
]
const listMethodNames = [
  "push",
  "map",
  "filter",
  "pop",
  "get",
  "clear",
  "slice",
  "length",
]

// Map/set intrinsic names, gated exactly as `checkCallNode`'s own arms gate them: `set`/
// `get`/`keys` are a map surface a set must not leak, and `add` is admitted by the value
// type rather than by flavor.
function mapMethodNames(recvTy: i32) {
  const out = ["has", "delete", "values", "length", "size"]
  const rt = T.tys[recvTy]
  if rt is TyMap {
    if rt.mSet == 0 {
      out.push("set")
      out.push("get")
      out.push("keys")
    }
    if rt.mSet == 1 || tyIsPrimNamed(rt.mVal, "boolean") { out.push("add") }
  }
  out
}

// Free `self`-functions dispatchable on `recvTy` — the in-scope half of the edit-distance
// pool, mirroring `ufcsCallTy`'s own lookup without its arity gate: a name search asks
// whether the function exists, not how many arguments it takes.
function selfFnNamesFor(recvTy: i32) {
  const out: string[] = []
  for name in fnDeclIx.keys() {
    if declFirstParamIsSelf(name) {
      const fnTy = lookup(name)
      if fnTy >= 0 {
        const ft = T.tys[fnTy]
        if ft is TyFunc {
          if ft.fnParamTypes.length > 0 {
            if assignable(recvTy, ft.fnParamTypes[0]) {
              const un = demangleName(name)
              if un.length >= 2 && nameIsBareIdent(un) { out.push(un) }
            }
          }
        }
      }
    }
  }
  out
}

// One receiver kind's two-source lookup: the newcomer map above (exact, case-folded)
// first, then an edit distance (`tyEditDist`, D1590's budget) over `names` plus every
// in-scope self-function `recvTy` could dispatch to.
function methodSuggestFrom(
  spellFrom: string[],
  spellTo: string[],
  names: string[],
  recvTy: i32,
  prop: string,
) {
  let si = 0
  while si < spellFrom.length {
    if tyFoldedEq(prop, spellFrom[si]) { return spellTo[si] }
    si = si + 1
  }
  const budget = tySuggestBudget(prop.length)
  let best = ""
  let bestD = budget + 1
  let ni = 0
  while ni < names.length {
    const nd = tyEditDist(prop, names[ni])
    if nd < bestD {
      bestD = nd
      best = names[ni]
    }
    ni = ni + 1
  }
  const cand = selfFnNamesFor(recvTy)
  let ci = 0
  while ci < cand.length {
    if cand[ci].length >= 2 && cand[ci] != prop {
      const ud = tyEditDist(prop, cand[ci])
      if ud < bestD {
        bestD = ud
        best = cand[ci]
      }
    }
    ci = ci + 1
  }
  best
}

// The name to offer for a missed method call `prop` on `recvTy`, or "" for none —
// dispatched by receiver kind (string / array / map). A kind with no table (struct,
// union, an unresolved generic) still gets the edit distance over its self-functions.
function methodSuggestFor(recvTy: i32, prop: string) {
  if recvTy < 0 { return "" }
  if prop.length < 2 { return "" }
  if !nameIsBareIdent(prop) { return "" }
  const rt = T.tys[recvTy]
  if rt is TyPrim {
    if rt.primName == "string" {
      return methodSuggestFrom(
        strMethodSpellFrom,
        strMethodSpellTo,
        strMethodNames,
        recvTy,
        prop,
      )
    }
  }
  if rt is TyArray {
    return methodSuggestFrom(
      listMethodSpellFrom,
      listMethodSpellTo,
      listMethodNames,
      recvTy,
      prop,
    )
  }
  if rt is TyMap {
    // `put`/`containsKey` name the MAP surface — offering them on a set would suggest a
    // call `checkCallNode`'s own arm refuses, so a set gets the edit distance alone.
    if rt.mSet == 1 {
      return methodSuggestFrom([], [], mapMethodNames(recvTy), recvTy, prop)
    }
    return methodSuggestFrom(
      mapMethodSpellFrom,
      mapMethodSpellTo,
      mapMethodNames(recvTy),
      recvTy,
      prop,
    )
  }
  methodSuggestFrom([], [], [], recvTy, prop)
}

// The `; did you mean '.<name>'?` clause for a missed method call, or "" when nothing is
// near enough — the method twin of `tyDidYouMean`, a SUFFIX so `no method '.<prop>' on
// <type>` stays the prefix every consumer matches on (glean VL-045, D1599).
function methodDidYouMean(recvTy: i32, prop: string) {
  const s = methodSuggestFor(recvTy, prop)
  if s.length == 0 { return "" }
  "; did you mean '." + s + "'?"
}

// The spelling-tree resolver, wrapped: bank this subtree's spelling if it is the
// innermost frame that failed. `tsToName` re-renders the parser's tree, so the quoted
// part matches the whole name's canonical spacing.
function tsToTy(ix: i32) {
  unkTyDepth = unkTyDepth + 1
  if unkTyDepth == 1 {
    unkTyPart = ""
    unkTyClash = ""
    collapsedTy = -1
  }
  const r = tsToTyReal(ix)
  if r < 0 {
    if unkTyPart.length == 0 { unkTyPart = tsToName(ix) }
  }
  unkTyDepth = unkTyDepth - 1
  r
}

// The name resolver, wrapped the same way — unpositioned entries and the emitter's
// re-resolutions come through here.
function nameToTy(name: string) {
  unkTyDepth = unkTyDepth + 1
  if unkTyDepth == 1 {
    unkTyPart = ""
    unkTyClash = ""
    collapsedTy = -1
  }
  // A bare identifier cannot enter any composite arm of `nameToTyReal`, so its answer is
  // the shared leaf ladder: `tsLeafTy`, already the tree route's leaf, rather than a
  // second copy of the prim/type-parameter/declared lookup. Arena-neutral by construction
  // — all three leaf rungs are lookups of an index someone else already minted.
  let r = -1
  if nameIsBareIdent(name) {
    r = tsLeafTy(name)
  } else {
    r = nameToTyReal(name)
  }
  if r < 0 {
    if unkTyPart.length == 0 { unkTyPart = name }
  }
  unkTyDepth = unkTyDepth - 1
  r
}

// —— literal-union flatten, shared by the annotation and declaration routes ——
// "A union whose members are all literal unions is one" (`litunion-compact-rep-design.md`
// §8.3), stated once because the annotation (`annUnionInnerTy`) and declaration
// (`fillTypeDeclAt`'s `UnionDecl` arm) routes build a union's member list separately.

// Push `ty` onto `out` unless a member already there is the same variant — the dedup both
// the flatten and non-flatten legs need, so an overlapping pair keeps a shared member
// exactly once.
function pushDistinctVariantTy(out: i32[], ty: i32) {
  let i = 0
  while i < out.length {
    if sameVariantTy(ty, out[i]) { return 0 }
    i = i + 1
  }
  out.push(ty)
  0
}

// The base scalar of a homogeneous literal union — a `TyUnion` whose members are all
// `TyLit` over one base (`"aa"|"bb"` → string, `1|2` → i32) — or -1 otherwise. A
// projection of `softenLitTy`, not a second answer. `tyIsLitUnion` cannot serve here: it
// is string-only (a string litunion's alias name is its interned-atom identity).
function homogLitUnionBase(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyUnion {
    if t.uMembers.length < 1 { return -1 }
    const soft = softenLitTy(ty)
    if soft != ty { return soft }
  }
  -1
}

// The base scalar an arm's value set sits inside when the arm denotes only literals — a
// bare literal or a homogeneous literal union — else -1. Must move together with canon's
// own arm spelling, or the arena says a plain scalar while canon still spells a union and
// the emitter reserves a box for it (D1048).
function armLiteralBaseTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  // `Kind | string` is `string`, the same as `"a" | string` — `homogLitUnionBase` answers
  // for the union-arm leg, the `TyLit` leg below for a bare literal. Must stay paired with
  // canon's `canonDropSubsumedParts`, which drops the same arm from the spelling (D1048).
  const hb = homogLitUnionBase(ty)
  if hb >= 0 { return hb }
  const t = T.tys[ty]
  if t is TyLit { return litBaseTy(t) }
  -1
}

// Does `members` carry `base` as an arm, after flattening through aliases (a union-alias
// member contributes its own arms, a nullable its inner plus `null`)? Compares by index
// equality against `base`, not `sameVariantTy` — the loose test would also match a sibling
// `TyLit`, which `"a" | "b" | "err"` must not collapse against.
function unionMembersCarryBaseArm(members: i32[], base: i32): boolean {
  let i = 0
  while i < members.length {
    const flat: i32[] = []
    flattenVariantsInto(members[i], flat)
    let f = 0
    while f < flat.length {
      if flat[f] == base { return true }
      f = f + 1
    }
    i = i + 1
  }
  false
}

// Is `ty`'s value set already carried by an arm of `members`? Both union routes filter by
// this — the annotation route over its member list, the declaration route also over the
// wider `declMemberIxs` registration list.
function unionArmSubsumedBy(ty: i32, members: i32[]): boolean {
  const base = armLiteralBaseTy(ty)
  if base < 0 { return false }
  unionMembersCarryBaseArm(members, base)
}

// Drops a subsumed literal arm (a union is a set of values: `string | "err"` is `string`),
// decided per arm after flattening through aliases so both union routes agree. Always
// fills `out` with the survivors and reports whether it dropped anything — a type rule,
// not an emitter one, since a union box's tags are positional and must never be deduped (D1024).
function unionDropSubsumedArms(members: i32[], out: i32[]): boolean {
  let dropped = false
  let i = 0
  while i < members.length {
    if members.length >= 2 && unionArmSubsumedBy(members[i], members) {
      dropped = true
    } else {
      out.push(members[i])
    }
    i = i + 1
  }
  if out.length == 0 { return false }
  dropped
}

// Flattens `members` into `out` and answers true only when every member is a literal or a
// homogeneous literal union over one common base; otherwise leaves `out` untouched and
// answers false. A bare literal of the common base is a member of that set, not a reason to
// decline (D1043) — this is not the subsumption collapse, it adds a value rather than dropping one.
function litUnionFlatMembers(members: i32[], out: i32[]): boolean {
  if members.length < 2 { return false }
  let base = -1
  let sawUnion = false
  let i = 0
  while i < members.length {
    let b = homogLitUnionBase(members[i])
    if b >= 0 { sawUnion = true } else { b = armLiteralBaseTy(members[i]) }
    if b < 0 { return false }
    if base < 0 { base = b }
    if base != b { return false }
    i = i + 1
  }
  if !sawUnion { return false }
  i = 0
  while i < members.length {
    const mt = T.tys[members[i]]
    if mt is TyUnion {
      let ml = 0
      while ml < mt.uMembers.length {
        pushDistinctVariantTy(out, mt.uMembers[ml])
        ml = ml + 1
      }
    } else {
      pushDistinctVariantTy(out, members[i])
    }
    i = i + 1
  }
  true
}

// Registers an inline union's declared-struct members into `cVariantMemberTyIxs` — the
// annotation route's half of what the declaration route already fills in pass 0b. Needed
// because the emitter's `uVariants` is fed by both spellings while the checker's registry
// is not, so an inline union's struct member disagrees with the emitter about its own kind.
function annRegisterVariantMembers(ms: i32[]) {
  let i = 0
  while i < ms.length {
    const m = ms[i]
    if m >= 0 {
      if !cTyIxSetHas(annPendingVariantTyIxSet, m) {
        cTyIxSetAdd(annPendingVariantTyIxs, annPendingVariantTyIxSet, m)
      }
    }
    i = i + 1
  }
  0
}

// The annotation routes' member dedup, and the one place that records what a dropped
// duplicate collapsed with: `type A = {v: i32}` and `type B = {v: i32}` mint distinct arena
// nodes that `sameVariantTy` calls one variant, so `A | B` keeps one member but both names
// must register here — `sameVariantTy` is mutual, so a match can hold across either index.
function annUnionPushDistinctMember(members: i32[], m: i32) {
  let dup = false
  let dj = 0
  while dj < members.length {
    const kept = members[dj]
    if sameVariantTy(m, kept) {
      dup = true
      if m != kept { annRegisterVariantMembers([m, kept]) }
    }
    dj = dj + 1
  }
  if !dup { members.push(m) }
  0
}

// Commits the annotation route's candidates into `cVariantMemberTyIxs`, once at the end of
// `checkProgramNode` — the filter needs the whole program, since only a declared struct is
// at issue (`cStructTyIxs`, the set `collectS` refuses a row to) and a forward-referenced
// `type` fills its entry only after the annotation naming it resolves.
function annCommitVariantMembers() {
  let i = 0
  while i < annPendingVariantTyIxs.length {
    const m = annPendingVariantTyIxs[i]
    if cTyIxSetHas(cStructTyIxSet, m) {
      if !cTyIxSetHas(cVariantMemberTyIxSet, m) {
        cTyIxSetAdd(cVariantMemberTyIxs, cVariantMemberTyIxSet, m)
      }
    }
    i = i + 1
  }
  0
}

// —— the annotation union's member list, shared by both annotation routes ——
// `tsToTyReal` (the tree route) and `nameToTyReal` (the string route) build the same union
// from the same members, through one shared home per rule rather than a copy per route.

// The union type an annotation's kept `members` denote, with the literal-union flatten: a
// union of literal unions is a literal union, so without flattening `is K` const-folds to a
// guard that can never fire (`litunion-compact-rep-design.md` §8.3). Shares
// `litUnionFlatMembers` with the declaration route; a one-member list returns unchanged.
function annUnionInnerTy(members: i32[], hasNull: boolean): i32 {
  if members.length == 0 { return TY_ERR }
  if members.length == 1 { return members[0] }
  // Two members the emitter cannot separate poison the annotation (-1), reason banked —
  // ahead of the `null` early-out, since `N | i32 | null` is the same union.
  const nwClash = nomUnionRepClashMsg(members)
  if nwClash.length > 0 {
    unkTyClash = nwClash
    return -1
  }
  // The subsumed-arm collapse, ahead of the `null` wrap — `string | "err" | null` is
  // `string?` for the same reason `string | "err"` is `string`, else the duplicate atom
  // would carry into the niche. Re-enters on the survivors so a one-member result collapses exactly once.
  const kept: i32[] = []
  if unionDropSubsumedArms(members, kept) {
    const collapsed = annUnionInnerTy(kept, hasNull)
    // Banks the provenance, since the result itself carries no trace of a dropped arm.
    // Written after the recursion, so a double collapse banks the final index (D1048).
    if collapsed >= 0 { collapsedTy = collapsed }
    return collapsed
  }
  if hasNull {
    annRegisterVariantMembers(members)
    return mkUnionTy(members)
  }
  // Every member must be a literal union — a litunion member of a mixed union keeps its own
  // arena node, since that mixed shape is load-bearing elsewhere
  // (`closure-result-union-composed-carrier.vl` miscompiles if flattened). Shares
  // `litUnionFlatMembers` with the declaration route's `UnionDecl` arm.
  const flat: i32[] = []
  if !litUnionFlatMembers(members, flat) {
    let i = 0
    while i < members.length {
      pushDistinctVariantTy(flat, members[i])
      i = i + 1
    }
  }
  if flat.length == 1 { return flat[0] }
  annRegisterVariantMembers(flat)
  // A declared alias with exactly these literal members owns the arena index
  // (`litUnionAliasTyOfMembers`) — minting a twin instead is invisible to the index-identity
  // classifiers. Asked of the non-flattened list too: a pure inline `"aa"|"bb"` beside `type
  // K = "aa"|"bb"` must resolve to the same index canon spells `K`, or the two producers disagree.
  const lal = litUnionAliasTyOfMembers(flat)
  if lal >= 0 { return lal }
  mkUnionTy(flat)
}

// The whole union type an `A | B | null` spelling denotes: `annUnionInnerTy` over the
// non-`null` members, wrapped in the null niche when `null` is present (a poisoned -1
// propagates unwrapped, since `mkNullableTy(-1)` would lose the sentinel). A declared union
// alias with a `null` member must resolve to this same niche rep, not a plain `TyUnion`.
function annUnionTy(members: i32[], hasNull: boolean): i32 {
  const inner = annUnionInnerTy(members, hasNull)
  if inner < 0 { return -1 }
  if hasNull {
    const wrapped = mkNullableTy(inner)
    // Carries the collapse bank through the niche wrap: `string | "err" | null` is
    // `string?`, and without this the bank would still name the unwrapped `string`.
    if collapsedTy == inner { collapsedTy = wrapped }
    return wrapped
  }
  inner
}

function tsToTyReal(ix: i32) {
  if ix < 0 { return -1 }
  const k = tsKind[ix]
  const start = tsKidStart[ix]
  const cnt = tsKidCount[ix]
  // An inline union `A | B | null`: a `null` member makes the result nullable, duplicate
  // members collapse, and an unresolved member poisons the whole union (-1) rather than
  // let `assignable` treat the negative sentinel as "accept anything".
  if k == TS_UNION {
    const members: i32[] = []
    let hasNull = false
    let pi = 0
    while pi < cnt {
      const kid = tsKids[start + pi]
      const kk = tsKind[kid]
      if kk == TS_NULL {
        hasNull = true
      } else if kk != TS_ERR {
        // renders "" for the string arm's `part.length > 0` check
        const m = tsToTy(kid)
        if m < 0 { return -1 }
        annUnionPushDistinctMember(members, m)
      }
      pi = pi + 1
    }
    return annUnionTy(members, hasNull)
  }
  // An intersection `A & B` — fold the operands through `intersectTy` so a finite
  // annotation simplifies to a concrete type (`(0|1|2) & !2` → `0 | 1`).
  if k == TS_ISECT {
    let acc = -1
    let ii = 0
    while ii < cnt {
      const operand = tsToTy(tsKids[start + ii])
      if operand < 0 { return -1 }
      if ii == 0 { acc = operand } else { acc = intersectTy(acc, operand) }
      ii = ii + 1
    }
    return acc
  }
  // A prefix negation `!A`: "anything but A".
  if k == TS_NEG {
    const negd = tsToTy(tsKids[start])
    if negd < 0 { return -1 }
    return mkNegTy(negd)
  }
  // A parenthesized group `(A)`: strip the parens and re-enter, so a comma group
  // `(A, B)` re-enters on `"A,B"`, matches no arm, and resolves to -1 — a group is a
  // single type or it is nothing.
  if k == TS_PAREN {
    if cnt == 1 { return tsToTy(tsKids[start]) }
    return -1
  }
  // A function type `(params)=>ret` — the children are the parameters in order, then
  // the return last (`parseTypeAtom`'s contract).
  if k == TS_FUNC {
    const ptys: i32[] = []
    let pn = cnt - 1
    // A lone recovery param renders `""`, so the string arm sees `paramsStr` empty and
    // builds a zero-parameter function; two of them render `","` and do not collapse.
    if pn == 1 {
      if tsKind[tsKids[start]] == TS_ERR { pn = 0 }
    }
    let pk = 0
    while pk < pn {
      const pt = tsToTy(tsKids[start + pk])
      if pt < 0 { return -1 }
      ptys.push(pt)
      pk = pk + 1
    }
    const rty = tsToTy(tsKids[start + cnt - 1])
    if rty < 0 { return -1 }
    return mkFuncTy(ptys, rty)
  }
  // A string-literal type `"a"`: `tsText` keeps the quoted lexeme, so `tsToName`
  // reproduces the annotation exactly, and the member is the raw inner text — the same
  // rule as the literal-expression side. `ast.tsToName` returns `tsText[ix]` verbatim for
  // a `TS_LITSTR` node, matching the string the parser also concatenates into `TypeRef.tyName`.
  if k == TS_LITSTR {
    const lex = tsText[ix]
    return mkLitTy("str", groupInnerOf(lex))
  }
  // A numeric-literal type (`0`, `1.5`): int vs float by the `.` in the lexeme.
  if k == TS_LITNUM {
    if numLexIsFloat(tsText[ix]) { return mkLitTy("flt", tsText[ix]) }
    return mkLitTy("int", tsText[ix])
  }
  if k == TS_NULL { return TY_NULL }
  // An array type `T[]`. An unresolved element poisons the annotation: `mkArrayTy(-1)`
  // would leak the empty-`[]` element hole as the type of every `xs[i]` read, and a member
  // access on that hole indexes the arena at -1 — a checker crash (`type-alias-nested.vl`).
  if k == TS_ARR {
    // `u8[]` — the one position `u8` is legal in. Matched on the element spelling rather
    // than by resolving it, since `u8` deliberately never resolves as a leaf (`TY_U8`) —
    // this keeps the storage type out of every value position with no context flag threaded through.
    const aeKid = tsKids[start]
    if tsKind[aeKid] == TS_NAME && tsText[aeKid] == "u8" {
      return mkArrayTy(TY_U8)
    }
    const aeTy = tsToTy(aeKid)
    if aeTy < 0 { return -1 }
    return mkArrayTy(aeTy)
  }
  // A map `{[K]: V}` — the key is a bare identifier token, not a parsed type, so it rides
  // `tsText`; only `string`/`i32` keys are supported (`mapKeyTySupported`), any other
  // resolves to -1. An unresolved value also poisons the annotation: `mkMapTy(str, -1)`
  // would be indistinguishable from the empty-`Map()` inference hole.
  if k == TS_MAP {
    const mk = tsLeafTy(tsText[ix])
    if !mapKeyTySupported(mk) { return -1 }
    const mvTy = tsToTy(tsKids[start])
    if mvTy < 0 { return -1 }
    return mkMapTy(mk, mvTy, 0)
  }
  // An inline object type `{x: T, y: U}`. A field whose name failed to parse renders
  // `":T"` and drops here too, since its first top-level colon sits at index 0
  // (`colonAt > 0`). An unresolved field type also poisons the annotation (-1) — storing
  // it in `objFieldTypes` would crash a consumer that assumes resolution succeeded.
  if k == TS_OBJ {
    const fnames: string[] = []
    const ftys: i32[] = []
    let fi = 0
    while fi < cnt {
      const fdIx = tsKids[start + fi]
      // A method member in value position — the tree route's half of the refusal
      // `nameToTyReal`'s brace arm raises, so both routes reach one wording. A design
      // rule enforced on only one route is one a re-render can walk around.
      if tsKind[fdIx] == TS_METHOD {
        tErr(methodInValuePosMsg(tsToName(fdIx)), annotDiagAt)
        return TY_ERR
      }
      if tsKind[fdIx] == TS_FIELD {
        if tsText[fdIx].length > 0 {
          const fdTy = tsToTy(tsKids[tsKidStart[fdIx]])
          if fdTy < 0 { return -1 }
          fnames.push(tsText[fdIx])
          ftys.push(fdTy)
        }
      }
      fi = fi + 1
    }
    return mkObjTy(fnames, ftys)
  }
  // A generic alias application `Box<i32>` / `Pair<i32,string>` — substitute the
  // arguments into the declared body. The head is the identifier the parser read,
  // never a slice of a rendered name.
  if k == TS_APP { return applyGenAliasArgs(tsText[ix], "", ix) }
  // `TS_NAME` (a bare identifier), and `TS_ERR`, whose `""` text falls through
  // every leaf rung to -1 exactly as `nameToTy("")` does.
  tsLeafTy(tsText[ix])
}

function nameToTyReal(name: string) {
  // An inline union `A | B | null` — the parser joins members with `|` into one synthetic
  // name. Split on top-level `|`s (depth-aware), resolve each member, and build the union
  // (a `null` member makes it nullable). Checked first so a member's `[]`/map shape isn't
  // read as a suffix of the whole union name; duplicate members collapse.
  if nameHasPipe(name) && !isTopLevelFuncTypeName(name) {
    const parts: string[] = []
    tyTopLevelSplit(name, '|', false, parts)
    const members: i32[] = []
    let hasNull = false
    let pi = 0
    while pi < parts.length {
      const part = parts[pi]
      if part == "null" {
        hasNull = true
      } else if part.length > 0 {
        // An unresolved member poisons the whole union (-1): pushing it into the member
        // list would let `assignable` treat the negative sentinel as "accept anything".
        const m = nameToTy(part)
        if m < 0 { return -1 }
        annUnionPushDistinctMember(members, m)
      }
      pi = pi + 1
    }
    // The litunion flatten and the `null` niche wrap at their shared home — the tree
    // route's mirror of `tsToTyReal`'s `TS_UNION` arm. Three routes, one rule.
    return annUnionTy(members, hasNull)
  }
  // An intersection `A & B` — fold the operands through `intersectTy` so a finite
  // annotation simplifies to a concrete type (`(0|1|2) & !2` → `0 | 1`). An unresolvable
  // operand poisons the whole name (-1).
  if nameHasSep(name, '&') && !isTopLevelFuncTypeName(name) {
    const iparts: string[] = []
    tyTopLevelSplit(name, '&', false, iparts)
    let acc = -1
    let ii = 0
    while ii < iparts.length {
      const operand = nameToTy(iparts[ii])
      if operand < 0 { return -1 }
      if ii == 0 { acc = operand } else { acc = intersectTy(acc, operand) }
      ii = ii + 1
    }
    return acc
  }
  if name.length > 0 {
    // A prefix negation `!A`: "anything but A" — almost always consumed by the `&`
    // fold, where `A & !B` subtracts B's variants from A.
    if name[0] == '!' {
      const negd = nameToTy(name.slice(1, name.length))
      if negd < 0 { return -1 }
      return mkNegTy(negd)
    }
    // A parenthesized group `(A | B)`: peel only when `tyname.parenEnclosesWhole` says the
    // leading `(` closes at the final character — not `emit_base.tyGroupWrapsWhole`, which
    // disagrees on a group that never closes (returns true where this needs false, since
    // `groupInnerOf` would otherwise take a real closer for one that doesn't exist).
    if nameIsParenSpanEnds(name) {
      if parenEnclosesWhole(name) { return nameToTy(groupInnerOf(name)) }
    }
    // A function type `(params)=>ret` (the parser's synthetic name for `(i32) => i32`):
    // builds a `TyFunc` so a function-typed binding/param/field type-checks. Matches
    // `isTopLevelFuncTypeName`; `funcArrowAt` banks the arrow index and must be read
    // immediately, since the recursion below (`nameToTy`) reaches the predicate again and overwrites it.
    if isTopLevelFuncTypeName(name) {
      const arrowAt = funcArrowAt
      const paramsStr = fnParamsTextOf(name, arrowAt)
      const retStr = fnRetTextOf(name, arrowAt)
      const ptys: i32[] = []
      if paramsStr.length > 0 {
        const pparts: string[] = []
        tyTopLevelSplit(paramsStr, ',', false, pparts)
        let pk = 0
        while pk < pparts.length {
          const pt = nameToTy(pparts[pk])
          if pt < 0 { return -1 }
          ptys.push(pt)
          pk = pk + 1
        }
      }
      const rty = nameToTy(retStr)
      if rty < 0 { return -1 }
      return mkFuncTy(ptys, rty)
    }
    // A string- or numeric-literal type (`"a"`, `0`, `1.5`), at the lexeme grammar's
    // home — shared with `canonEmitName`'s literal arm.
    const lmt = litMemberTy(name)
    if lmt >= 0 { return lmt }
  }
  if name == "u8" { return storageTyLeafFail() }
  const pv = primTyOfName(name)
  if pv >= 0 { return pv }
  // An array type `T[]`: the parser appends a literal `[]` per array suffix to the type
  // name (`i32[]`, `Tok[]`, `i32[][]`). Strip one suffix and wrap the element.
  const nlen = name.length
  // The array-name grammar's test then its cut, both at their home in `tyname.vl`. Not
  // `arrElemNameRaw(name) != ""`: the degenerate `"[]"` is an array whose element is "",
  // and this arm must still enter for it — the one-call form would skip it.
  if nameIsArray(name) {
    // `u8[]` through the rendered-name path, the twin of `tsToTyReal`'s `TS_ARR` arm — the
    // same element-spelling door, so an answer only one route knows never diverges.
    const aeName = arrElemNameRaw(name)
    if aeName == "u8" { return mkArrayTy(TY_U8) }
    // An unresolved element name poisons the whole array annotation (-1): `mkArrayTy(-1)`
    // would leak the empty-`[]` element hole, and a member access on it crashes the checker.
    const aeTy = nameToTy(aeName)
    if aeTy < 0 { return -1 }
    return mkArrayTy(aeTy)
  }
  // A map `{[K]:V}` (the parser's synthetic index-signature name) — span and cuts live in
  // `tyname.vl`. Supported keys are `string`/`i32` (`mapKeyTySupported`); any other key, or
  // an unresolved value, resolves to -1 rather than building `mkMapTy(str, -1)`, which would
  // be indistinguishable from the empty-`Map()` inference hole.
  if nameIsMapSpanEnds(name) && mapSpellKeyEnd(name) >= 0 {
    const mk = nameToTy(mapSpellKeyName(name))
    if !mapKeyTySupported(mk) { return -1 }
    const mv = nameToTy(mapSpellValName(name))
    if mv < 0 { return -1 }
    return mkMapTy(mk, mv, 0)
  }
  // An inline object type `{x:T,y:U}` (starts `{` but not `{[`). Split top-level commas
  // (depth-aware), then each field at its first top-level `:`, and build the structural
  // `TyObj`. An unresolved field type poisons the whole annotation (-1) — the sentinel stored
  // in `objFieldTypes` would crash a consumer that assumes resolution succeeded.
  if nameIsBraceSpanEnds(name) {
    const fnames: string[] = []
    const ftys: i32[] = []
    // Fields are the top-level commas of the brace's interior, scanned from index 1 so
    // the opening `{` doesn't count; the run ends at the closing brace, not the name's end.
    let fstart = 1
    let fgoing = true
    while fgoing {
      let fend = tyTopIndexOf(name, ',', 0, fstart)
      if fend < 0 {
        fend = nlen - 1
        fgoing = false
      }
      const field = name.slice(fstart, fend)
      if field.length > 0 {
        const colonAt = tyTopIndexOf(field, ':', 0, 0)
        // A method member in value position (`function f(x: { m(): string })`). The
        // refusal belongs here, not the grammar, since the grammar cannot see which
        // position it is in — the same rule `declaredTyOfName`'s alias arm applies.
        if colonAt > 1 {
          if field[colonAt - 1] == ')' {
            tErr(methodInValuePosMsg(field), annotDiagAt)
            // `TyErr`, not -1: this diagnosis already stands, and -1 would make the caller
            // append a misleading `unknown type` — the type is known, just not a value type.
            return TY_ERR
          }
        }
        if colonAt > 0 {
          // Field-colon cut at its home (`tyname.fieldTypeTextOf`/`fieldNameOf`), given the
          // top-level colon already found; the emitter's own copies use a depth-blind `indexOf(":")`.
          const fdTy = nameToTy(fieldTypeTextOf(field, colonAt))
          if fdTy < 0 { return -1 }
          fnames.push(fieldNameOf(field, colonAt))
          ftys.push(fdTy)
        }
      }
      fstart = fend + 1
    }
    return mkObjTy(fnames, ftys)
  }
  // A live type-parameter binding (a generic function's `<T>` while its annotations
  // resolve via `resolveAnnot`, or a generic alias application's params while its body
  // resolves via `applyGenAlias`) — innermost wins.
  const tv = tpEnvTyOfName(name)
  if tv >= 0 { return tv }
  // A generic alias application `Box<i32>` / `Pair<i32,string>` — the parser folds the
  // arguments into the synthetic name; substitute them into the declared body. Span test at
  // its home in `tyname.vl` (`annGenAppSpanEnds`); a name failing it falls through to
  // `declaredTyOfName`. Slices are `tyname.gaeHeadNameOf`/`gaeArgsTextOf`, given `gaeLtAt`'s index.
  if annGenAppSpanEnds(name) {
    const ltAt = gaeLtAt(name)
    return applyGenAlias(gaeHeadNameOf(name, ltAt), gaeArgsTextOf(name, ltAt))
  }
  const dvn = declaredTyOfName(name)
  if dvn >= 0 { return dvn }
  builtinCtorTyLeafFail(name)
}

// The collection flavor of a binding initializer: "Set" when the init is a `Set()`
// call, else "Map". Lets the i32-keyed diagnostic name the right constructor.
function initMapCtorName(initIx: i32) {
  if initIx < 0 { return "Map" }
  const inode = P.nodes[initIx]
  if inode is Call {
    const cn = P.nodes[inode.callFn]
    if cn is Ident {
      if cn.identName == "Set" { return "Set" }
    }
  }
  return "Map"
}

// The one wording for a key the map rep cannot hash (`mapKeyTySupported` has exactly two
// hashes). Both the annotation gate (`checkLetDeclNode`) and the usage-driven pin
// (`checkInferredMapKey`) raise it, so the annotated and inferred spellings of one
// program reject in the same channel with the same words.
function mapKeyUnsupportedErr(keyText: string, ctor: string, at: i32) {
  tErrUnsupported(
    "A " +
      keyText +
      "-keyed " +
      ctor +
      " isn't supported yet — `Map`/`Set` keys must be `string` or `i32`",
    at,
  )
}

// Adjudicates the key a usage-driven pin (`m.set(k, v)`, `s.add(k)`, `m[k] = v`) just
// wrote into an open `mKey` hole — a bare `Map()` has no annotation for the checker's
// static gate to read, so without this an inferred unsupported key checks clean and dies
// in codegen instead. A hole key is still unsolved and left to call-site re-validation.
function checkInferredMapKey(k: i32, isSet: i32, at: i32) {
  if k < 0 { return 0 }
  if mapKeyTySupported(k) { return 0 }
  const kt = T.tys[k]
  if kt is TyVar { return 0 }
  if kt is TyErr { return 0 }
  let ctor = "Map"
  if isSet == 1 { ctor = "Set" }
  mapKeyUnsupportedErr(tyToStr(k), ctor, at)
  0
}

// —— type → string (for diagnostics) ——
// Renders a type-arena index as a readable name. The `nominal` bit: true renders a
// declared type by its name (`Cat`, `Box<i32>`); false is the structural spelling the
// emitter's name-keyed tables need — both spell composites as VL source does (`=>`, `T | null`).
export function tyToStr(ix: i32) { tyToStrAt(ix, true) }

// The structural render — `tyToStr`'s recursion with the nominal legs off. Read by the
// checker's emitter-facing name producers, whose result is a key into an emitter table
// keyed by structural spelling (`structIndexOfTypeName` matches a `{…}` shape by field
// set) — a nominal name there is a key those tables do not hold.
export function tyToStructStr(ix: i32) { tyToStrAt(ix, false) }

// —— the user-facing render pathway (demangle → render) ——
// Every type string a person reads is rendered here and nowhere else, since the module
// merge renames every declaration `name` → `name$mN` and a raw render would leak it.
// `tyToStr`/`tyToStructStr` stay raw, since those strings are spelling-dependent table keys.
export function tyToStrUser(ix: i32) { demangleMsg(tyToStr(ix)) }
export function tyToStructStrUser(ix: i32) { demangleMsg(tyToStructStr(ix)) }

function tyToStrAt(ix: i32, nominal: boolean) {
  // Both bail-outs return single tokens — one atom, like every arm that writes no
  // top-level `|`.
  tyStrAtoms = 1
  // No arena entry (`ix < 0`) — an empty `[]`/`Map()`/`Set()` nothing constrained — renders
  // `_`, the same token the `TyVar` hole arm uses: both mean "no type is known here".
  // Angle brackets are reserved for an error that already happened (`<error>` for `TyErr`);
  // collapsing the two would send a reader with a rejected annotation to hunt a missing one.
  if ix < 0 { return "_" }
  if tyToStrDepth > 8 { return "…" }
  tyToStrDepth = tyToStrDepth + 1
  const s = tyToStrGo(ix, nominal)
  tyToStrDepth = tyToStrDepth - 1
  s
}

function tyToStrGo(ix: i32, nominal: boolean) {
  // A nominal newtype renders as its name — the only renderer that must, since "cannot
  // assign i32 to i32" for `const e: EntityId = n` hides the very distinction the type
  // exists to draw. The emit renderers (`tyToEmitName`, `canonEmitName`) deliberately lack
  // this arm: a newtype must be erased in the emitter's vocabulary (`newtype-design.md` §3).
  const nwn = nomNameOfTy(ix)
  if nwn != "" { return nwn }
  // Nominal-first, in the same order `tyToNameGo`/`transparentMemberEmitName` use:
  // declared struct, generic application, declared union alias — application before union,
  // since an application expands to the `TyObj`/`TyUnion` this exists to replace. Each leg
  // declines with "" for a type it cannot name, so an unnamed type still renders structurally.
  if nominal {
    const sdn = structNameOfTy(ix)
    if sdn != "" { return sdn }
    const gan = genAppNameOfTy(ix)
    if gan != "" { return gan }
    const udn = unionAliasDeclNameOfTy(ix)
    if udn != "" { return udn }
  }
  const t = T.tys[ix]
  // Exhaustive over `Ty`, deliberately without a `_` arm: a new variant breaks the
  // self-compile here instead of silently printing `<?>` in a diagnostic.
  match t {
    TyPrim => {
      return t.primName
    }
    TyErr => {
      return "<error>"
    }
    TyObj => {
      // `.length`/index chained directly on an array field of an `is`-narrowed value
      // miscompiles, so the array fields are bound to locals first.
      const names = t.objFieldNames
      const ftys = t.objFieldTypes
      let s = "{"
      let i = 0
      while i < names.length {
        if i > 0 { s = s + ", " }
        s = s + names[i] + ": " + tyToStrAt(ftys[i], nominal)
        i = i + 1
      }
      // Every field separator sits inside the braces — one atom. Set explicitly rather
      // than inherited, since a field's own render leaves its last width behind.
      tyStrAtoms = 1
      return s + "}"
    }
    TyFunc => {
      const ptys = t.fnParamTypes
      let s = "("
      let i = 0
      while i < ptys.length {
        if i > 0 { s = s + ", " }
        s = s + tyToStrAt(ptys[i], nominal)
        i = i + 1
      }
      let rs = tyToStrAt(t.fnRet, nominal)
      // A function type is one atom: params are parenthesized and everything after the
      // top-level arrow belongs to the result. Set explicitly, since the param/result
      // renders leave their own widths behind.
      tyStrAtoms = 1
      // VL writes a function type `(params) => ret`. A function result that is itself a
      // function keeps grouping parens — the same rule `arrElemRender` carries for array
      // elements.
      if tyIxIsFunc(t.fnRet) { rs = "(" + rs + ")" }
      return s + ") => " + rs
    }
    TyUnion => {
      const members = t.uMembers
      let s = ""
      // The render's atom count, accumulated as members join: a member is not always one
      // atom (a nullable member renders `X | null`), so this is summed rather than read
      // off `members.length`.
      let psum = 0
      let i = 0
      while i < members.length {
        if i > 0 { s = s + " | " }
        let ms = tyToStrAt(members[i], nominal)
        let mw = tyStrAtoms
        // A function-type member renders parenthesized (`((i32) => f64) | string`) —
        // bare, the closure's result would swallow the union's sibling members
        // (`(i32) => f64 | string` returns `f64 | string`, a different type).
        if tyIxIsFunc(members[i]) {
          ms = "(" + ms + ")"
          mw = 1
        }
        s = s + ms
        psum = psum + mw
        i = i + 1
      }
      tyStrAtoms = psum
      return s
    }
    TyNullable => {
      const inner = tyToStrAt(t.nInner, nominal)
      const innerAtoms = tyStrAtoms
      // VL has no `T?` suffix — a nullable is written `T | null`. A nullable function
      // type keeps grouping parens (`((i32) => string) | null`), else ` | null` binds
      // into the closure's result and spells a different type.
      if tyIxIsFunc(t.nInner) {
        // The grouped closure is one atom; `null` is the second.
        tyStrAtoms = 2
        return "(" + inner + ") | null"
      }
      // A union inner keeps its own top-level `|`s (`A | B | null`), so the `null` arm
      // adds to the inner render's width rather than making the whole render two atoms.
      tyStrAtoms = innerAtoms + 1
      return inner + " | null"
    }
    TyArray => {
      const el = tyToStrAt(t.aElem, nominal)
      const elw = tyStrAtoms
      // A list render is one atom in every form — a wide element is parenthesized so its
      // `|`s stop being top-level. Set explicitly, since the element render left its own width behind.
      tyStrAtoms = 1
      return arrElemRender(el, t.aElem, elw)
    }
    TyMap => {
      const mk = tyToStrAt(t.mKey, nominal)
      const mv = tyToStrAt(t.mVal, nominal)
      // The key/value separators sit inside the braces — one atom.
      tyStrAtoms = 1
      return "{[" + mk + "]: " + mv + "}"
    }
    TyVar => {
      // An inference hole (`?fn.N`) renders as the blank `_` — deliberately not an
      // identifier-shaped word, since a bareword spelling reads as a type name to write. `_`
      // must never join the LSP's absence filter (`ABSENT_TYPE_MARKERS`): as a substring of
      // ordinary identifiers it would delete hints from healthy code (`{foo_bar: i32}`).
      if t.tvName[0] == '?' { return "_" }
      return t.tvName
    }
    TyLit => {
      // A literal type renders as its member text — quoted for a string literal
      // (host `stringifyType`: `expected "a" | "b", got "c"`).
      if t.litKind == "str" { return "\"" + t.litText + "\"" }
      return t.litText
    }
    TyNeg => {
      const ns = tyToStrAt(t.negTy, nominal)
      // A residual negation has no source spelling at all, so its width is nominal — one
      // atom, like every other non-`|`-writing arm.
      tyStrAtoms = 1
      return "!" + ns
    }
  }
  // Unreachable by construction: every arena variant has an arm above and every arm
  // returns. Stays as the trailing value — the token a 12th variant would print if the
  // `match` ever got a `_`.
  "<?>"
}

// Is arena type `ix` a nullable value-union box — a `TyUnion` with a `null` member and two
// or more non-null members? That is the rep whose `??` has no emit lowering: its null is a
// tag in the box's field 0 rather than a `ref.null`, so `br_on_non_null` cannot serve it. A
// one-member nullable (`T | null`) is the niche and keeps its own lowering (D962).
export function tyIsNulValueUnionBox(ix: i32): boolean {
  if ix < 0 { return false }
  const t0 = T.tys[ix]
  // `string | i32 | null` can arrive as a union carrying a `null` member or as a
  // `TyNullable` over the two-member union — the checker normalises some spellings to the
  // second, and peeling here makes the predicate answer about the rep, not the spelling.
  if t0 is TyNullable {
    // A literal union is excluded here: `K | null` is a `TyNullable` over a 2-member
    // `TyUnion` by shape, but its rep is the interned i32 atom with `-1` for null — a
    // niche, not a box. `t0.nInner` can be the unfilled `let x = null` hole (`-1`), so every
    // reader here bound-tests before indexing the arena or the compiler traps (D1575).
    if t0.nInner < 0 || t0.nInner >= T.tys.length { return false }
    if tyIsLitUnion(t0.nInner) { return false }
    const inner = T.tys[t0.nInner]
    if inner is TyUnion { return inner.uMembers.length >= 2 }
    return false
  }
  const t = T.tys[ix]
  if t is TyUnion {
    let hasNull = false
    let others = 0
    let i = 0
    while i < t.uMembers.length {
      const m = T.tys[t.uMembers[i]]
      let isNull = false
      if m is TyPrim {
        if m.primName == "null" { isNull = true }
      }
      if isNull { hasNull = true } else { others = others + 1 }
      i = i + 1
    }
    return hasNull && others >= 2
  }
  false
}

// The primitive name arena type `ix` renders as (`tyToStr`), or "" when it renders as
// anything else — `tyEq`'s discipline for the one-primitive case, read off the arena rather
// than a built string. Unwraps a single-member union too, since `tyToStr`'s union arm
// prints one member bare.
export function tyPrimNameOf(ix: i32): PrimName | null {
  if ix < 0 { return null }
  const t = T.tys[ix]
  if t is TyPrim { return t.primName }
  if t is TyUnion {
    if t.uMembers.length == 1 { return tyPrimNameOf(t.uMembers[0]) }
  }
  null
}

// Whether arena type `ix` is the primitive `nm` — the decision form of `tyPrimNameOf`,
// replacing `tyToStr(ix) == "i32"` at sites asking a structural question ("is the inner
// the string primitive?") by rendering.
function tyIsPrimNamed(ix: i32, nm: PrimName): boolean {
  tyPrimNameOf(ix) == nm
}

// —— the element row of an array type, empty-`[]` hole answered once ——
// The element arena index of `TyArray` `ix`, or `-1` when `ix` isn't an array or its
// element is still the unconstrained-`[]` hole — a declared state, not a corruption.
// `T.tys[t.aElem]` without this check is an out-of-bounds `array.get` inside the compiler.
function tyArrayElemIx(ix: i32): i32 {
  if ix < 0 || ix >= T.tys.length { return -1 }
  const t = T.tys[ix]
  if t is TyArray {
    if t.aElem < 0 || t.aElem >= T.tys.length { return -1 }
    return t.aElem
  }
  -1
}

// ── structural type equality ──
// Whether two arena types render identically (`tyToStr(a) == tyToStr(b)`), decided
// structurally — mirrors the render rules (union layers flatten, holes compare equal,
// field order matters), not mutual assignability, which `sameVariantTy` keeps separate.
const tyEqAStack: i32[] = []
const tyEqBStack: i32[] = []

function tyEq(a: i32, b: i32) {
  if a == b { return true }
  if a < 0 || b < 0 { return false }
  // A pair already being compared higher in the recursion is assumed equal — the cycle
  // guard for recursive named types, like `assignable`'s.
  let gi = tyEqAStack.length - 1
  while gi >= 0 {
    if tyEqAStack[gi] == a && tyEqBStack[gi] == b { return true }
    gi = gi - 1
  }
  tyEqAStack.push(a)
  tyEqBStack.push(b)
  const ok = tyEqGo(a, b)
  tyEqAStack.pop()
  tyEqBStack.pop()
  ok
}

// Flattens nested union layers only — a nullable renders `T?` here, not `T | null`, so
// (unlike `flattenVariantsInto`) it stays opaque rather than being inlined.
function unionMembersInto(ty: i32, out: i32[]) {
  if ty >= 0 {
    const t = T.tys[ty]
    if t is TyUnion {
      const ms = t.uMembers
      let i = 0
      while i < ms.length {
        unionMembersInto(ms[i], out)
        i = i + 1
      }
      return 0
    }
  }
  out.push(ty)
  0
}

// Union render-equality: the flattened member sequences match pairwise.
function unionEq(a: i32, b: i32) {
  const av: i32[] = []
  unionMembersInto(a, av)
  const bv: i32[] = []
  unionMembersInto(b, bv)
  if av.length != bv.length { return false }
  let i = 0
  while i < av.length {
    if !tyEq(av[i], bv[i]) { return false }
    i = i + 1
  }
  true
}

function tyEqGo(a: i32, b: i32) {
  // `tyEq` answers "do these render identically", and a nominal newtype renders as its
  // name — so two brands, or a brand and its base, are not equal here either, keeping the
  // predicate consistent with `tyToStr`.
  if nomNameOfTy(a) != nomNameOfTy(b) { return false }
  const ta = T.tys[a]
  const tb = T.tys[b]
  // Either side being a union routes to the same member-sequence comparison, so this
  // asymmetric pre-test sits ahead of the exhaustive dispatch on `ta` — that dispatch's
  // own `TyUnion` arm would otherwise shadow the `b`-side case.
  if tb is TyUnion { return unionEq(a, b) }
  // Exhaustive over `Ty`, deliberately without a `_` arm: a new variant breaks the
  // self-compile here instead of silently answering `false` ("these types differ"),
  // which every caller reads as a settled verdict.
  match ta {
    TyUnion => {
      return unionEq(a, b)
    }
    TyPrim => {
      if tb is TyPrim { return ta.primName == tb.primName }
      return false
    }
    TyErr => {
      if tb is TyErr { return true }
      return false
    }
    TyVar => {
      if tb is TyVar {
        // An inference hole renders `_` regardless of its internal name.
        if ta.tvName[0] == '?' { return tb.tvName[0] == '?' }
        return ta.tvName == tb.tvName
      }
      return false
    }
    TyLit => {
      if tb is TyLit {
        return ta.litKind == tb.litKind && ta.litText == tb.litText
      }
      return false
    }
    TyNullable => {
      if tb is TyNullable { return tyEq(ta.nInner, tb.nInner) }
      return false
    }
    TyArray => {
      if tb is TyArray { return tyEq(ta.aElem, tb.aElem) }
      return false
    }
    TyMap => {
      if tb is TyMap {
        if ta.mSet != tb.mSet { return false }
        return tyEq(ta.mKey, tb.mKey) && tyEq(ta.mVal, tb.mVal)
      }
      return false
    }
    TyFunc => {
      if tb is TyFunc {
        const ap = ta.fnParamTypes
        const bp = tb.fnParamTypes
        if ap.length != bp.length { return false }
        if !tyEq(ta.fnRet, tb.fnRet) { return false }
        let i = 0
        while i < ap.length {
          if !tyEq(ap[i], bp[i]) { return false }
          i = i + 1
        }
        return true
      }
      return false
    }
    TyObj => {
      if tb is TyObj {
        const an = ta.objFieldNames
        const bn = tb.objFieldNames
        if an.length != bn.length { return false }
        const aty = ta.objFieldTypes
        const bty = tb.objFieldTypes
        let i = 0
        while i < an.length {
          if an[i] != bn[i] { return false }
          if !tyEq(aty[i], bty[i]) { return false }
          i = i + 1
        }
        return true
      }
      return false
    }
    TyNeg => {
      if tb is TyNeg { return tyEq(ta.negTy, tb.negTy) }
      return false
    }
  }
  // Unreachable by construction: every arena variant has an arm above and every arm
  // returns. The per-arm `tb` tests are same-variant guards, not a second dispatch —
  // `return false` is the right answer for every other variant, so they stay `if`s.
  false
}

// The type-arena index of object `o`'s field `name`, or `-1` if absent — takes a concrete
// `TyObj` already narrowed by the caller. The `tyStep*` peel family's object arm, exported
// because the shape interner's descent needs the matching arena field for a shape's field
// text. Declines on a non-`TyObj` or a missing name; the caller then takes the name leg unchanged.
export function tyFieldTyOf(ty: i32, name: string): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyObj { return objFieldType(t, name) }
  -1
}

function objFieldType(o: TyObj, name: string) {
  const names = o.objFieldNames
  const ftys = o.objFieldTypes
  let i = 0
  while i < names.length {
    if names[i] == name { return ftys[i] }
    i = i + 1
  }
  -1
}

// ── emit-name canonicalization ──
// The emitter classifies annotations by synthetic name, and the literal/intersection
// algebra above is checker-only — a same-base literal union is its base scalar at runtime.
// `canonEmitTypeNames` rewrites every annotation name into that vocabulary at the end of `checkProgram`.

// Whether `name` contains a construct the emitter can't classify: a quoted string-literal
// member, an `&` intersection, a `!` negation, a parenthesized group, or a numeric-literal
// member (a digit at a member-start position — after `|`/`:`/`,` or at the very start; a
// digit inside an identifier like `i32` never starts a member).
function nameNeedsCanon(name: string) {
  let i = 0
  while i < name.length {
    const c = name[i]
    if c == '"' || c == '&' || c == '!' || c == '(' { return true }
    // A composite (`Id[]`, `{[string]: Id}`, `{x: Id}`) may embed a single-member alias in its
    // element/value/field, which `canonEmitName`'s recursion resolves — so it must run even
    // with no other canon trigger present. Idempotent for an already-canon composite, so this
    // only broadens which names recurse, not the result of a name that already canon'd.
    if c == '[' || c == '{' { return true }
    // A top-level union (`AB | null`) must be processed so a union-alias member expands to
    // its flattened members (an inline `(A|B)|null` already trips the parenthesized-group
    // test). Idempotent for an already-flat union, so this is a no-op there.
    if c == '|' { return true }
    if c >= '0' && c <= '9' {
      if i == 0 { return true }
      const p = name[i - 1]
      if p == '|' || p == ':' || p == ',' { return true }
    }
    i = i + 1
  }
  false
}

// Whether `ix` has an emitter-classifiable synthetic name (`tyToEmitName(ix) != ""`),
// decided structurally without building the name and paying its allocation. Same arms in
// the same order as `tyToEmitName`; the litunion-alias legs aren't mirrored since they only
// change the spelling, never the answer. Has no cycle guard, matching `tyToEmitName`.
function tyIsEmitRepresentable(ix: i32): boolean {
  if ix < 0 { return false }
  const t = T.tys[ix]
  // Exhaustive over `Ty`, deliberately without a `_` arm: a new variant breaks the
  // self-compile here instead of silently answering `false`, sending every caller down
  // its fallback path.
  match t {
    TyPrim => {
      return t.primName != "never"
    }
    TyLit => {
      return true
    }
    TyUnion => {
      const members = t.uMembers
      // An empty union produces no parts, and `tyToEmitName` returns "" for it.
      if members.length == 0 { return false }
      let i = 0
      while i < members.length {
        if !tyIsEmitRepresentable(members[i]) { return false }
        i = i + 1
      }
      return true
    }
    TyNullable => {
      return tyIsEmitRepresentable(t.nInner)
    }
    TyObj => {
      // A field-less shape renders `{}` — non-empty, so representable.
      const ftys = t.objFieldTypes
      let i = 0
      while i < ftys.length {
        if !tyIsEmitRepresentable(ftys[i]) { return false }
        i = i + 1
      }
      return true
    }
    TyArray => {
      return tyIsEmitRepresentable(t.aElem)
    }
    TyMap => {
      if !tyIsEmitRepresentable(t.mKey) { return false }
      return tyIsEmitRepresentable(t.mVal)
    }
    TyFunc => {
      const ps = t.fnParamTypes
      let i = 0
      while i < ps.length {
        if !tyIsEmitRepresentable(ps[i]) { return false }
        i = i + 1
      }
      return tyIsEmitRepresentable(t.fnRet)
    }
    TyVar => {
      // An unsolved type parameter has no emitter name.
    }
    TyNeg => {
      // A residual negation — `intersectTy` folds the rest — has no emitter name.
    }
    TyErr => {
      // The error/unknown hole has no emitter name.
    }
  }
  // The type-parameter, negation and error arms land here: `tyToEmitName` spells "" for
  // each, so the capability answer is false.
  false
}

// Whether `ix`'s emitter-classifiable name is exactly `string` (`tyToEmitName(ix) ==
// "string"`), decided structurally. Only three arms can spell a bare `string`: the `string`
// prim, a softened string literal, and a union whose parts all render `string` (the render
// dedups them to one part). Every other arm renders a composite or a declared alias name.
function tyEmitNameIsString(ix: i32): boolean {
  if ix < 0 { return false }
  const t = T.tys[ix]
  if t is TyPrim { return t.primName == "string" }
  if t is TyLit { return t.litKind == "str" }
  if t is TyUnion {
    const members = t.uMembers
    if members.length == 0 { return false }
    // Mirrors `tyToNameGo`'s union arm: the flattened-alias regroup and the per-member
    // litunion-alias lookup can substitute a declared alias name for a literal run, and a
    // name that isn't `string` makes this predicate's answer false — dual-written
    // deliberately, since `tyToEmitName(ix) == "string"` is a contract only if both move together.
    const rgTexts: string[] = []
    let rgNonLit = false
    let rg = 0
    while rg < members.length {
      const rm = T.tys[members[rg]]
      if rm is TyLit {
        if rm.litKind == "str" { rgTexts.push(rm.litText) }
      } else {
        let rmNull = false
        if rm is TyPrim {
          if rm.primName == "null" { rmNull = true }
        }
        if !rmNull { rgNonLit = true }
      }
      rg = rg + 1
    }
    let rgAlias = ""
    if rgNonLit && rgTexts.length >= 2 {
      rgAlias = litUnionAliasOfLitTexts(rgTexts)
    }
    if rgAlias != "" && rgAlias != "string" { return false }
    let i = 0
    while i < members.length {
      const rgm = T.tys[members[i]]
      let skip = false
      if rgAlias != "" && rgm is TyLit { skip = true }
      if !skip {
        // A closure member renders parenthesized (`(()=>i32)`) — never bare.
        if rgm is TyFunc { return false }
        // A member that is a registered litunion alias contributes its name.
        const al = litUnionAliasNameOfTy(members[i])
        if al != "" {
          if al != "string" { return false }
        } else if !tyEmitNameIsString(members[i]) {
          return false
        }
      }
      i = i + 1
    }
    return true
  }
  false
}

// The render-context vocabulary — the `ctx` half of the one agreed emit renderer
// (`renderEmit(ty, ctx)`). A parameter at all because the policy is not global: a litunion
// alias softens in a direct union but is preserved in a closure result, map value, array
// element or struct field — the position decides. Bits, not an enum: rules quantify over sets of positions.
const RC_ROOT = 0        // a top-level render: no enclosing position at all
const RC_UNION_MEM = 1   // a member of a union
const RC_NULLABLE = 2    // under a nullable — see the STICKY note below
const RC_FIELD = 4       // an object field's type
const RC_ELEM = 8        // an array element's type
const RC_MAP_KEY = 16    // a map key's type
const RC_MAP_VAL = 32    // a map value's type
const RC_FN_PARAM = 64   // a function type's parameter
const RC_FN_RES = 128    // a function type's result
const RC_UNION_KEY = 256 // a member of a union being spelled as the registry KEY

// `RC_NULLABLE` is sticky across a union join, and has to be: structurally `A | B | null` is
// a `TyNullable` over a `TyUnion` so `A` sits two levels down, while the string spelling
// splits `null` as a sibling — a rule asking "am I under a nullable" must agree either way.
// Every other bit is replaced at each descent (a struct field that is itself an array element is a field, not both).

// The top-level atom count of the name the last render returned, at either face, produced
// by the renderer rather than re-derived by scanning the finished string. A name gains a
// top-level `|` at exactly two places (the union join, the nullable `|null` suffix); every
// other arm is one atom. Meaningful only for a non-empty render, never carried between calls.
let tyNameAtoms = 1

// The ancestor stack of the render in progress, `isEquatable`'s `seen` guard applied to the
// renderer: a recursive type is a cycle in the arena, and rendering one structurally without
// this is an infinite string that traps the compiler's call stack. Push/pop balanced around
// the recursive entry, so a shape mentioning one struct twice as siblings still renders both.
const emitNameSeen: i32[] = []

// Renders a resolved arena type as an emitter-classifiable synthetic name, or "" when it
// has none (a `TyVar`, a residual negation, err/never, or a recursive type). Ask
// `tyIsEmitRepresentable` for "does it have one at all", not this for "". The position-free
// entry: every outside caller asks about a type standing on its own (`RC_ROOT` by definition).
export function tyToEmitName(ix: i32) { tyToEmitNameAt(ix, RC_ROOT) }

// The same render, told the position it occupies in its parent — the cycle guard lives
// here so the recursive calls, the only ones that can close a cycle, pass through it. On a
// revisit it answers a declared alias's own name (any revisited one, not just the
// outermost), else "" as for an anonymous shape (D1021).
function aliasNameOfTyIx(ix: i32): string {
  for k in cUserTypes.keys() {
    if (cUserTypes[k] ?? -1) == ix { return k }
  }
  ""
}

function tyToEmitNameAt(ix: i32, ctx: i32) {
  let si = 0
  while si < emitNameSeen.length {
    if emitNameSeen[si] == ix {
      tyNameAtoms = 1
      const selfNm = aliasNameOfTyIx(ix)
      if selfNm != "" { return selfNm }
      return ""
    }
    si = si + 1
  }
  emitNameSeen.push(ix)
  const r = tyToNameGo(ix, ctx, false)
  emitNameSeen.pop()
  // An empty render is not an answer, and a declared name always beats it: `type J = null |
  // f64 | JO` folds to a one-member `TyUnion` whose member is a `TyNullable`, so the cycle
  // guard cannot name that index and `J` would otherwise get no emit name at all. Gated on
  // `r == ""`, since "" is not a spelling any consumer can use (D1037).
  if r == "" {
    const fnm = nulFoldAliasNameOf(ix)
    if fnm != "" { return fnm }
  }
  r
}

// The declared name whose 0a placeholder holds `ix` as its single nullable member — the
// shape `type X = … | null` leaves behind (D1037), "" when `ix` is not such a member.
// Arity one and a nullable member are both required: a one-member union also wraps a
// transparent alias, and naming that member would re-spell an already-working render.
function nulFoldAliasNameOf(ix: i32): string {
  if nulFoldWrapperTyIxOf(ix) >= 0 { return nulFoldWrapperNameOf(ix) }
  ""
}

// The same lookup, returning the wrapper's arena index rather than its name — the mv layer
// needs the index, since its `is` test resolves a map arm's slot by arena type while the
// store interned it by name, and under the fold those are the member and the wrapper
// respectively. Without a way back the two tag the same arm differently (D1037).
export function nulFoldWrapperTyIxOf(ix: i32): i32 {
  if ix < 0 { return -1 }
  const it = T.tys[ix]
  if !(it is TyNullable) { return -1 }
  for k in cUserTypes.keys() {
    const wx = cUserTypes[k] ?? -1
    if wx >= 0 {
      const wt = T.tys[wx]
      if wt is TyUnion {
        const wm = wt.uMembers
        if wm.length == 1 && wm[0] == ix { return wx }
      }
    }
  }
  -1
}

function nulFoldWrapperNameOf(ix: i32): string {
  for k in cUserTypes.keys() {
    const wx = cUserTypes[k] ?? -1
    if wx >= 0 {
      const wt = T.tys[wx]
      if wt is TyUnion {
        const wm = wt.uMembers
        if wm.length == 1 && wm[0] == ix { return k }
      }
    }
  }
  ""
}

// The position a composite's interior stands at, for the structural renderer — normally the
// interior's own position, but `RC_ROOT` when `ix` is a registered generic-application
// instance. Canon spells the application's argument at `RC_ROOT`, so this renderer must
// agree or the same argument gets two positions and two names — invalid wasm.
function appKidCtx(ix: i32, ctx: i32): i32 {
  if cTyIxSetHas(gaAppTyIxSet, ix) { return RC_ROOT }
  ctx
}

// The kid position the two faces disagree about: the structural face re-roots a registered
// generic application's interior, the nominal face leaves the position alone. Nominal only
// reaches a registered application when `genAppNameOfTy` declined or `RC_UNION_KEY` held its
// arm back, and re-rooting there would respell a member the union key already banked.
function nameKidCtx(ix: i32, ctx: i32, nominal: boolean): i32 {
  if nominal { return ctx }
  appKidCtx(ix, ctx)
}

// The recursive entry of the face being rendered. The two `At`s keep their own bodies: the
// structural one answers a revisited alias's own name and retries the null-fold, the nominal
// one records the cut in `nomNameCycle`.
function tyToNameAt(ix: i32, ctx: i32, nominal: boolean): string {
  if nominal { return tyToNominalNameAt(ix, ctx) }
  tyToEmitNameAt(ix, ctx)
}

// The structural render, at one of two faces: `nominal` turns on the nominal-first prelude
// (a declared struct, generic application or union alias spells as its own name) and selects
// the recursion's face. One body because the two faces and canon must spell one arena type
// one way, or the name-keyed registries hold a row per spelling; `tyToStrGo` is the precedent.
function tyToNameGo(ix: i32, ctx: i32, nominal: boolean): string {
  tyNameAtoms = 1
  if ix < 0 { return "" }
  if nominal {
    // Nominal-first: a declared struct or union alias renders as its name — one identifier,
    // so one atom.
    const sdn = structNameOfTy(ix)
    if sdn != "" { return sdn }
    // …and a generic application renders as the application (`Box<i32>`), ahead of the union
    // arm for the same reason `structNameOfTy` is. Declines ("") for an uninstantiated or
    // cyclic argument. Not taken at `RC_UNION_KEY`, though: a generic application standing as
    // a union member is spelled by its shape on the annotation side (`unionMemberGenAppShape`).
    if (ctx & RC_UNION_KEY) == 0 {
      const gan = genAppNameOfTy(ix)
      if gan != "" { return gan }
    }
    const udn = unionAliasDeclNameOfTy(ix)
    if udn != "" {
      // …except a declared alias for a numeric literal union (`type Z = 0 | 1`), which
      // denotes its base scalar, never the alias name — the emitter cannot classify that
      // name, so `isUName` would otherwise claim a union box while every read lowers as a
      // plain scalar. `canonEmitName` reaches this by name, this renderer by arena index.
      const nlb = numLitUnionBaseName(ix)
      if nlb != "" { return nlb }
      return udn
    }
  }
  const t = T.tys[ix]
  // Exhaustive over `Ty`, deliberately without a `_` arm: a new variant breaks the
  // self-compile here instead of silently rendering "" — which every name-keyed registry
  // downstream reads as a settled answer.
  match t {
    TyPrim => {
      if t.primName == "never" { return "" }
      return t.primName
    }
    TyLit => {
      // A literal renders as its base scalar, at the one home that answers that
      // (`tyLitBaseName`).
      return tyLitBaseName(t)
    }
    TyUnion => {
      const members = t.uMembers
      // A pure inline literal union keeps its members — canon's `litUnionPreserve`/
      // `nulLitUnionPreserve` pair, mirrored off the arena. Without it every `TyLit` member
      // renders its base and dedups away, so `{tag: "a"|"b"}` would render `{tag:string}`
      // while the annotation spells `{tag:"a"|"b"}` — one arena type, two names.
      const luiN = litUnionInlineNameOfTy(ix)
      if luiN != "" {
        if luiHasNull {
          tyNameAtoms = luiAtoms + 1
          return luiN + "|null"
        }
        if ctxKeepsLitUnion(ctx) {
          tyNameAtoms = luiAtoms
          return luiN
        }
      }
      // The mixed-union preserve: a string-litunion alias as a union member keeps its alias
      // name (`K0 | f64` renders `K0|f64`, not `string|f64`) — the flattened spelling fails
      // `nameIsLitUnionType` and the box loses its string arm. Mirrored by
      // `canonEmitNameAt`'s `mixedUnionLitAliasRegroup`, so the annotation side agrees.
      let rgAlias = ""
      const rgTexts: string[] = []
      let rgNonLit = false
      let rg = 0
      while rg < members.length {
        const rm = T.tys[members[rg]]
        if rm is TyLit {
          if rm.litKind == "str" { rgTexts.push(rm.litText) }
        } else {
          let rmNull = false
          if rm is TyPrim {
            if rm.primName == "null" { rmNull = true }
          }
          if !rmNull { rgNonLit = true }
        }
        rg = rg + 1
      }
      if rgNonLit && rgTexts.length >= 2 {
        rgAlias = litUnionAliasOfLitTexts(rgTexts)
      }
      const parts: string[] = []
      // The render's atom count, accumulated as parts are kept: a part is not always one
      // atom (a nullable member renders `X|null`), so this is summed rather than read off
      // `parts.length`, and a duplicate part contributes nothing.
      let psum = 0
      let rgDone = false
      let i = 0
      while i < members.length {
        // A member that is a registered litunion alias (`K0 | i64`) keeps its alias name
        // rather than softening to `string`: the alias reps as the i32 atom in the union
        // box, and every `$fnsig`/slot key derived here must agree with the annotation side's spelling.
        const rgm = T.tys[members[i]]
        if rgAlias != "" && rgm is TyLit {
          if !rgDone {
            rgDone = true
            parts.push(rgAlias)
            psum = psum + 1
          }
          i = i + 1
          continue
        }
        // An alias name is one identifier — one atom. Only the render leg can be wider,
        // and it reports its own width in `tyNameAtoms`.
        let sc = 1
        let s = litUnionAliasNameOfTy(members[i])
        if s == "" {
          // A union member, carrying the sticky nullable bit down so this arm agrees with
          // canon's flat `A|B|null` split about what "under a nullable" means.
          s = tyToNameAt(
            members[i],
            RC_UNION_MEM | (ctx & RC_NULLABLE),
            nominal,
          )
          sc = tyNameAtoms
        }
        if s == "" { return "" }
        // A function-type member renders parenthesized (`(()=>f32|null)|{w:i32}`) — bare,
        // the closure's result would swallow the union's sibling members, producing a
        // divergent `ref.cast` functype at the value call. Grouping parens keep it one atom.
        if rgm is TyFunc {
          s = "(" + s + ")"
          sc = 1
        }
        let dup = false
        let j = 0
        while j < parts.length {
          if parts[j] == s { dup = true }
          j = j + 1
        }
        if !dup {
          parts.push(s)
          psum = psum + sc
        }
        i = i + 1
      }
      if parts.length == 0 { return "" }
      let out = parts[0]
      let k = 1
      while k < parts.length {
        out = out + "|" + parts[k]
        k = k + 1
      }
      tyNameAtoms = psum
      return out
    }
    TyNullable => {
      // A nullable litunion-alias (`K0 | null`) keeps its alias rather than softening to
      // `string|null` — the two spell different reps (the alias niche is the i32 atom with
      // a `-1` sentinel; `string|null` is the nullable string ref).
      const nal = litUnionAliasNameOfTy(t.nInner)
      if nal != "" {
        // An alias identifier plus the `null` arm — two atoms.
        tyNameAtoms = 2
        return nal + "|null"
      }
      // …and an un-aliased one keeps its members, at every position: canon's
      // `nulLitUnionPreserve` has no `ctxKeepsLitUnion` gate. The same preference
      // `litUnionInlineNameOfTy` applies internally, so the two cannot disagree.
      const nlui = litUnionInlineNameOfTy(t.nInner)
      if nlui != "" {
        tyNameAtoms = luiAtoms + 1
        return nlui + "|null"
      }
      // At the nominal face this is where a nullable declared struct or union keeps its
      // name (`S|null`, `U|null`) — the prelude claims it one recursion down.
      const inner = tyToNameAt(t.nInner, RC_NULLABLE, nominal)
      const innerAtoms = tyNameAtoms
      if inner == "" { return "" }
      // A nullable function type keeps grouping parens (`((i32)=>string)|null`) — bare,
      // the render would spell a closure returning `string|null` instead, the same
      // swallowed-arm ambiguity as the union-member case.
      const nfn = T.tys[t.nInner]
      if nfn is TyFunc {
        // The grouped closure is one atom; `null` is the second.
        tyNameAtoms = 2
        return "(" + inner + ")|null"
      }
      // A union inner keeps its own top-level `|`s (`A|B|null`), so the `null` arm adds to
      // the inner render's width rather than making the whole name two atoms.
      tyNameAtoms = innerAtoms + 1
      return inner + "|null"
    }
    TyObj => {
      const names = t.objFieldNames
      const ftys = t.objFieldTypes
      let out = "{"
      let fi = 0
      while fi < names.length {
        // A field preserves a literal-union alias (`{f: K0}`, `{f: K0 | null}`) rather
        // than the softened `string`, so a rendered shape resolves the same struct index
        // the annotation side interned — the field dual of the `TyFunc`-result preservation.
        let fs = ""
        const ftn = T.tys[ftys[fi]]
        if ftn is TyNullable {
          const fal = litUnionAliasNameOfTy(ftn.nInner)
          if fal != "" { fs = fal + "|null" }
        }
        if fs == "" {
          const fbal = litUnionAliasNameOfTy(ftys[fi])
          if fbal != "" { fs = fbal }
        }
        if fs == "" {
          fs = tyToNameAt(ftys[fi], nameKidCtx(ix, RC_FIELD, nominal), nominal)
        }
        if fs == "" { return "" }
        if fi > 0 { out = out + "," }
        out = out + names[fi] + ":" + fs
        fi = fi + 1
      }
      // Every field separator sits inside the braces — one atom. Set explicitly, since a
      // field's own render leaves `tyNameAtoms` holding its last width.
      tyNameAtoms = 1
      return out + "}"
    }
    TyArray => {
      // A litunion-alias element (`K0[]`) keeps its alias name rather than softening to
      // `string[]` — the two spell different reps (the alias array is the interned-i32 atom
      // list; `string[]` is the string-ref list), so widening it would mint a twin mv slot.
      let el = litUnionAliasNameOfTy(t.aElem)
      // The element's own atom width, as its producer reported it — an alias identifier is
      // one atom, the render leg reports its own.
      let elw = 1
      if el == "" {
        el = tyToNameAt(t.aElem, nameKidCtx(ix, RC_ELEM, nominal), nominal)
        elw = tyNameAtoms
      }
      if el == "" { return "" }
      // A list name is one atom in every form — a union element is parenthesized so its
      // `|`s stop being top-level. Set explicitly, since the element render leaves its own
      // width behind; the grouping itself is `arrElemRender`'s.
      tyNameAtoms = 1
      return arrElemRender(el, t.aElem, elw)
    }
    TyMap => {
      const mk = tyToNameAt(t.mKey, RC_MAP_KEY, nominal)
      // A litunion-alias map value (`{[string]: K0}`) keeps its alias name rather than
      // softening to `string` — an atom-valued map is the mono i32 map, and every
      // `$fnsig`/mv-slot key derived here must agree with the annotation side's spelling.
      let mv = litUnionAliasNameOfTy(t.mVal)
      if mv == "" {
        mv = tyToNameAt(t.mVal, nameKidCtx(ix, RC_MAP_VAL, nominal), nominal)
      }
      if mk == "" || mv == "" { return "" }
      // The key/value separators sit inside the braces — one atom.
      tyNameAtoms = 1
      return "{[" + mk + "]:" + mv + "}"
    }
    TyFunc => {
      // A function type renders the emitter's closure-annotation form `(p1, p2) => ret`, so
      // an inferred closure value recovers a name `annSigKey` can key. "" if any param or
      // the result is unrenderable.

      const ps = t.fnParamTypes
      let out = "("
      let i = 0
      while i < ps.length {
        const ps1 = tyToNameAt(ps[i], RC_FN_PARAM, nominal)
        if ps1 == "" { return "" }
        if i > 0 { out = out + "," }
        out = out + ps1
        i = i + 1
      }
      // A function result preserves a literal-union alias (`() => K0`, `() => K0 | null`)
      // rather than the softened `string`, so an inferred closure value keys the litunion's
      // i32-atom token, byte-matching the constructed lambda's `$fnsig`.
      let rs = ""
      const rtn = T.tys[t.fnRet]
      if rtn is TyNullable {
        const nal = litUnionAliasNameOfTy(rtn.nInner)
        if nal != "" { rs = nal + "|null" }
      }
      if rs == "" {
        const bal = litUnionAliasNameOfTy(t.fnRet)
        if bal != "" { rs = bal }
      }
      if rs == "" {
        rs = tyToNameAt(t.fnRet, nameKidCtx(ix, RC_FN_RES, nominal), nominal)
      }
      if rs == "" { return "" }
      // A function-type result keeps grouping parens so the outer `$fnsig` producers see a
      // single result token (`(i32)=>((i32)=>i32)`), matching the source-annotation form.
      const rt = T.tys[t.fnRet]
      if rt is TyFunc { rs = "(" + rs + ")" }
      // A function type is one atom: params are parenthesized and everything after the
      // top-level `=>` belongs to the result — `unionMemberCount` implements this by
      // stopping at a top-level arrow, so `(i32)=>A|B` counts 1, not 2.
      tyNameAtoms = 1
      return out + ")=>" + rs
    }
    TyVar => {
      // An unsolved type parameter has no name at either face — the monomorphizer names
      // the instance.
    }
    TyNeg => {
      // A residual negation — `intersectTy` folds the rest — has no name at either face.
    }
    TyErr => {
      // The error/unknown hole has no name at either face; a rejected program never
      // reaches the emitter that would need one.
    }
  }
  // The type-parameter, negation and error arms land here: "" is the renderer's own
  // signal, which `tyIsEmitRepresentable` predicts structurally arm-for-arm.
  ""
}

// The declared name of declared-struct arena index `ty` (`type S = {…}` → "S"), or "" when
// `ty` is not a registered declared struct — the reverse of `cUserTypes` via the parallel
// `cStructTyIxs`/`cStructNames` arrays. First-match wins: a redeclared name shares the last
// arena index with its predecessor, so either name is interchangeable.
export function structNameOfTy(ty: i32): string {
  if ty < 0 { return "" }
  let i = 0
  while i < cStructTyIxs.length {
    if cStructTyIxs[i] == ty { return cStructNames[i] }
    i = i + 1
  }
  ""
}

// The declared alias name of declared-union arena index `ty` (`type U = A | B` → "U"), or
// "" when `ty` is not a registered union alias — `litUnionAliasNameOfTy`'s index-match leg,
// generalized to value unions.
export function unionAliasDeclNameOfTy(ty: i32): string {
  if ty < 0 { return "" }
  let i = 0
  while i < cUnionTyIxs.length {
    if cUnionTyIxs[i] == ty { return cUnionNames[i] }
    i = i + 1
  }
  ""
}

// Does arena type `ix` reach itself — is its expansion cyclic? The guard the nominal
// short-circuit needs: `type L<T> = {head: T, tail: L<T>[]}` at `i32` mints a `TyObj`
// whose `tail` element is that same index, so the application has a finite nominal name
// while its expansion does not, and `guardFiniteUserTypes` rejects such a program by this.
function tyReachesSelf(ix: i32): boolean {
  if ix < 0 { return false }
  const seen: i32[] = []
  tyReachesGo(ix, ix, seen, 0)
}

function tyReachesGo(cur: i32, target: i32, seen: i32[], depth: i32): boolean {
  if cur < 0 { return false }
  if depth > 64 { return false }
  const kids: i32[] = []
  tyChildrenOf(cur, kids)
  let i = 0
  while i < kids.length {
    const k = kids[i]
    if k == target { return true }
    if k >= 0 {
      let dup = false
      let j = 0
      while j < seen.length {
        if seen[j] == k { dup = true }
        j = j + 1
      }
      if !dup {
        seen.push(k)
        if tyReachesGo(k, target, seen, depth + 1) { return true }
      }
    }
    i = i + 1
  }
  false
}

// The direct child type indices of arena entry `ix`, appended to `out`. The leaf
// constructors (`TyPrim`/`TyLit`/`TyVar`/`TyErr`) have none.
function tyChildrenOf(ix: i32, out: i32[]) {
  if ix < 0 { return 0 }
  const t = T.tys[ix]
  if t is TyArray {
    out.push(t.aElem)
    return 0
  }
  if t is TyNullable {
    out.push(t.nInner)
    return 0
  }
  if t is TyNeg {
    out.push(t.negTy)
    return 0
  }
  if t is TyUnion {
    const ms = t.uMembers
    let i = 0
    while i < ms.length {
      out.push(ms[i])
      i = i + 1
    }
    return 0
  }
  if t is TyObj {
    const fs = t.objFieldTypes
    let i = 0
    while i < fs.length {
      out.push(fs[i])
      i = i + 1
    }
    return 0
  }
  if t is TyFunc {
    const ps = t.fnParamTypes
    let i = 0
    while i < ps.length {
      out.push(ps[i])
      i = i + 1
    }
    out.push(t.fnRet)
    return 0
  }
  if t is TyMap {
    out.push(t.mKey)
    out.push(t.mVal)
    return 0
  }
  0
}

// The generic application `ty` traces back to, rendered nominally (`Box<i32>`,
// `Pair<i32,string>`), or "" when `ty` is not a recorded application. Arguments render
// through `tyToNominalNameAt` in field position, so a nested application spells in full;
// the separator is `,` with no space, matching `gaeArgsTextOf`/`canonEmitName` byte-for-byte.
export function genAppNameOfTy(ty: i32): string {
  if ty < 0 { return "" }
  let i = 0
  while i < gaAppTyIxs.length {
    if gaAppTyIxs[i] == ty {
      // Cyclic expansion: decline, so the caller descends and the cycle bank fills as it
      // did before this arm existed. Memoized per row (`-1` unknown / `0` cyclic / `1`
      // finite) — the answer cannot change once `applyGenAliasArgs` has filled the shape.
      if gaAppFinite[i] < 0 {
        if tyReachesSelf(ty) { gaAppFinite[i] = 0 } else { gaAppFinite[i] = 1 }
      }
      if gaAppFinite[i] == 0 { return "" }
      const st = gaAppArgStart[i]
      const cn = gaAppArgCount[i]
      // A zero-argument row cannot arise (`applyGenAliasArgs` rejects an arity mismatch
      // before the memo), but a head with no arguments would render `Box<>` — not a
      // spelling anything can resolve. Bail to "" so the caller keeps its own route.
      if cn <= 0 { return "" }
      let s = ""
      let a = 0
      while a < cn {
        // `RC_ROOT` — an argument stands where the parameter it binds stands, a position
        // this rewrite has no way to know, so it must use the same context every other
        // whole-annotation entry uses. A different context here is invisible until the
        // inline litunion leg reads it, splitting one arena type into two rendered names.
        const an = tyToNominalNameAt(gaAppArgFlat[st + a], RC_ROOT)
        // An argument with no nominal name (a `TyVar`, or a cycle) makes the whole
        // application unspellable. Decline rather than emit `Box<>` or a partial name.
        if an == "" { return "" }
        if a > 0 { s = s + "," }
        s = s + an
        a = a + 1
      }
      // The application is one top-level atom, whatever the recursion left in the bank.
      tyNameAtoms = 1
      return gaAppHeads[i] + "<" + s + ">"
    }
    i = i + 1
  }
  ""
}

// The ancestor stack of the nominal render in progress, `emitNameSeen`'s twin: nominal-first
// tames a declared recursive struct by short-circuiting to its name, but not a recursive
// generic alias — `type L<T> = {head: T, tail: L<T> | null}` resolves to a genuinely cyclic,
// anonymous arena entry, and without this the render traps the compiler's call stack.
const nomNameSeen: i32[] = []

// True when the last top-level `tyToNominalName` call is cut by the ancestor stack. ""
// alone cannot carry that: this renderer also returns "" for a `TyVar`, `never`, or any arm
// with no name, none of which is a cycle — testing the string would reject every generic alias.
let nomNameCycle = false

// The name-faithful face: a declared struct renders as its name, a declared union alias as
// its alias name, rather than the structural expansion — which tames recursion too, since a
// declared type short-circuits before its fields re-enter. Position-free, as on the
// structural sibling; the cycle bank is per top-level render, so it resets here.
export function tyToNominalName(ix: i32): string {
  nomNameCycle = false
  tyToNominalNameAt(ix, RC_ROOT)
}

// Did the last `tyToNominalName` hit a cycle — i.e. does that type have no finite nominal
// name at all? Read by `emit_collect.vl`'s `guardFiniteUserTypes`, which rejects such a
// program by name instead of letting any renderer trap on it.
export function tyNomNameCycled(): boolean { nomNameCycle }

function tyToNominalNameAt(ix: i32, ctx: i32): string {
  tyNameAtoms = 1
  if ix < 0 { return "" }
  let si = 0
  while si < nomNameSeen.length {
    if nomNameSeen[si] == ix {
      tyNameAtoms = 1
      nomNameCycle = true
      return ""
    }
    si = si + 1
  }
  nomNameSeen.push(ix)
  const r = tyToNameGo(ix, ctx, true)
  nomNameSeen.pop()
  r
}

// Canonicalizes one inline `{…}` shape name (an object or a map): each field/key/value type
// recurses through `canonEmitName`, rebuilt with the parser's exact conventions (no spaces),
// so a shape with no literal field is reproduced unchanged. Takes no `ctx` of its own and
// needs none — a field is a field and a map value is a map value regardless of the shape's own position.
function canonShapeName(name: string) {
  // A map `{[K]:V}` — the open, key-end walk and two cuts are the map-name grammar's, at
  // its home. The caller has already established the closing `}` (`canonEmitNameAt`'s
  // brace arm), which is what makes `mapSpellValName`'s span gate a no-op here.
  if mapSpellKeyEnd(name) >= 0 {
    return "{[" +
      canonEmitNameAt(mapSpellKeyName(name), RC_MAP_KEY) +
      "]:" +
      canonEmitNameAt(mapSpellValName(name), RC_MAP_VAL) +
      "}"
  }
  // The `{…}` shape body, cut at the group-interior home (`tyname.groupInnerOf`). The guard
  // is the caller's — `canonEmitNameAt`'s brace arm has already established the closing `}`.
  const inner = groupInnerOf(name)
  // A `{[`-opening name whose key never closes into a `]:` is not a map and not an object
  // shape either — returned untouched.
  if nameIsMapOpen(name) { return name }
  // An object shape `{f:T,…}`: split the interior at its top-level commas, canon
  // each field's type past its first top-level `:`.
  let out = "{"
  let start = 0
  let going = true
  while going {
    let end = tyTopIndexOf(inner, ',', 0, start)
    if end < 0 {
      end = inner.length
      going = false
    }
    const field = inner.slice(start, end)
    const colonAt = tyTopIndexOf(field, ':', 0, 0)
    if start > 0 { out = out + "," }
    if colonAt >= 0 {
      // The field-colon cut at its home (`tyname.fieldNameOf`/`fieldTypeTextOf`), the one
      // writing that keeps the delimiter: rebuilding the shape text needs the `:` back, so
      // the name half is taken at `colonAt + 1` — the same home at a different index.
      out = out +
        fieldNameOf(field, colonAt + 1) +
        canonEmitNameAt(fieldTypeTextOf(field, colonAt), RC_FIELD)
    } else {
      out = out + field
    }
    start = end + 1
  }
  out + "}"
}

// Rewrites one synthetic annotation name into the emitter's vocabulary — the emit-name
// canonicalization pass. Structure-preserving: only literal members, `&` folds and
// whole-name parens change; a name without those (`nameNeedsCanon`) returns unchanged. For a
// declared union alias, its flattened member-set emit name; "" for anything else, which keeps its own name.
export function unionAliasMembers(name: string) {
  const ix = cUserTypes[name] ?? -1
  if ix < 0 { return "" }
  const t = T.tys[ix]
  if t is TyUnion {
    // The declared member spellings first (`declaredStructUnionMembers`). "" from it means
    // "not a union of declared structs", which keeps every other alias on the structural render.
    const dsm = declaredStructUnionMembers(name)
    if dsm != "" { return dsm }
    // Renders a self-reference as the alias name rather than letting the cycle guard answer
    // "" — `Json`'s own members mention `Json`, so without this the flatten declined the
    // alias entirely (D1021).
    return tyToEmitName(ix)
  }
  // A nullable alias is a union alias too: `type P = null | f64` is stored as
  // `TyNullable(f64)`, not `TyUnion`, so without expanding it to `<inner>|null` the outer
  // union never sees the null it already contains — the emitter meets a return type with
  // `null` twice (D1026). Declines exactly as the `TyUnion` arm when the inner has no emit name.
  if t is TyNullable {
    const inner = tyToEmitName(t.nInner)
    if inner == "" { return "" }
    return inner + "|null"
  }
  ""
}

// The `|`-joined declared member spellings of union alias `name` (`type Shape = Circle |
// Rect` → "Circle|Rect"), when every member names a declared struct or is `null`; "" for
// anything else. Needed since `tyToNameGo`'s `TyObj` arm has no nominal rung — it
// renders a member as an anonymous shape, unrelated to the real declared structs.
function declaredStructUnionMembers(name: string) {
  let si = 0
  while si < gRootStmts.length {
    const s = P.nodes[gRootStmts[si]]
    if s is UnionDecl {
      if s.udName == name {
        const vs = s.udVariants
        if vs.length < 2 { return "" }
        let out = ""
        let i = 0
        while i < vs.length {
          const m = vs[i]
          if m != "null" {
            const mi = cUserTypes[m] ?? (-1)
            if mi < 0 { return "" }
            const mt = T.tys[mi]
            if mt is TyObj {} else { return "" }
          }
          if i > 0 { out = out + "|" }
          out = out + m
          i = i + 1
        }
        // The join's own atom width, for the caller that reads `tyNameAtoms` after a
        // flatten: one atom per member, since each is a bare name.
        tyNameAtoms = vs.length
        return out
      }
    }
    si = si + 1
  }
  ""
}

// True if the one-member alias body at spelling root `root` is a bare type name or a
// generic application — the two spellings that make `type N = …` a plain alias reference.
// Asks the parser (`parseVariantName`'s `udTsRootAt` bank), not the rendered string, since a
// string scanner cannot tell `type X = null` apart from a bare name. A root of -1 answers false.
function aliasRefIsPlainRoot(root: i32) {
  if root < 0 { return false }
  const k = tsKind[root]
  k == TS_NAME || k == TS_APP || k == TS_NULL
}

// ── flat record layouts ──
// The whole feature is these functions plus one interception at the top of
// `checkMemberNode`. Nothing in `emit_*.vl` changes: layout constants are folded into
// `NumLit` nodes in the arena before the emitter runs (`flat-records-design.md`).

// `flSizes[d]` sentinels. Negative so they can never collide with a real size
// (which is a sum of non-negative widths).
const FL_UNRESOLVED = -1
const FL_INVALID = -2

// The index of `name` in the flat-layout sidecar, or -1 when no `flat type name = { … }`
// declaration names it.
function flatIndexOf(name: string) {
  let i = 0
  while i < flNames.length {
    if flNames[i] == name { return i }
    i = i + 1
  }
  -1
}

// The byte width of a scalar flat field type, or -1 for anything else. Reads the resolved
// arena type rather than the spelling, so a nominal newtype over a scalar works with no code
// for it. `boolean` is deliberately absent: it is an i32 at the wasm level, but this tier
// exists to match foreign layouts byte for byte, and C's `bool` is one byte, not four.
function flatScalarWidth(tyIx: i32) {
  if tyIx < 0 { return -1 }
  const t = T.tys[tyIx]
  if t is TyPrim {
    if t.primName == "i32" { return 4 }
    if t.primName == "f32" { return 4 }
    if t.primName == "i64" { return 8 }
    if t.primName == "f64" { return 8 }
  }
  -1
}

// The declared type spelling of a `FieldDef`'s annotation, or "" when it has none. The
// nested-record test must ask the spelling, not the arena: a resolved `TyObj` carries no
// name, so it cannot say whether the record it describes is declared `flat`.
function flatFieldTyName(fdIx: i32) {
  if fdIx < 0 { return "" }
  const fd = P.nodes[fdIx]
  if fd is FieldDef {
    if fd.fdType >= 0 {
      const tr = P.nodes[fd.fdType]
      if tr is TypeRef { return tr.tyName }
    }
  }
  ""
}

// —— pass 0d: a union's arms must be tellable apart ——
// The base scalar of a literal-set type — `TY_STR` for `"a"|"b"`, a numeric `TY_I32`/
// `TY_I64`/`TY_F64` — or -1 when `ty` is not a literal set, lifted from one member to the
// whole set since two arms are discriminable at a field only when both sets are comparable (D1023).
function litSetBaseTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  if tyLitSetMemberLexes(ty).length == 0 { return -1 }
  const t = T.tys[ty]
  if t is TyLit { return litBaseTy(t) }
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      const m = T.tys[t.uMembers[i]]
      if m is TyLit { return litBaseTy(m) }
      i = i + 1
    }
  }
  -1
}

// Do arms `a` and `b` carry the same field names in the same order — the checker's reading
// of `variantSig`, which is the emitter's tag key. Order-sensitive on purpose: two arms
// spelling fields in different orders get different tags, so nothing needs telling apart.
function objSigSame(a: TyObj, b: TyObj): boolean {
  if a.objFieldNames.length != b.objFieldNames.length { return false }
  let i = 0
  while i < a.objFieldNames.length {
    if objFieldType(b, a.objFieldNames[i]) < 0 { return false }
    i = i + 1
  }
  true
}

// `b`'s type for the field `a` holds at index `i`, or -1 — the by-name pairing every
// comparison here uses, not by index: the arena keeps a `TyObj`'s fields in source order
// while the emitter's `variantSig` (the tag key) sees them sorted, so `{v: i32, w: string}`
// and `{w: string, v: boolean}` collide on a tag though an index-paired comparison would miss it.
function objPairedTy(a: TyObj, b: TyObj, i: i32): i32 {
  objFieldType(b, a.objFieldNames[i])
}

// Is some field a comparable literal set in both arms — the discriminant the ruling requires?
function objArmsDiscriminable(a: TyObj, b: TyObj): boolean {
  let i = 0
  while i < a.objFieldTypes.length {
    const fa = a.objFieldTypes[i]
    const fb = objPairedTy(a, b, i)
    const ba = litSetBaseTy(fa)
    const bb = litSetBaseTy(fb)
    // Both arms carry a literal set, and the sets are comparable.
    if ba >= 0 && ba == bb { return true }
    // A literal set beside its own base: `{kind: "x"|"y"}` beside `{kind: string}` is the
    // overlapping-set case where the second arm's set is the whole base, so `is A` tests
    // membership and `else` after it narrows to B — the value discriminates where the tag
    // cannot. The base must be the one this set softens to, not merely another primitive.
    if ba >= 0 && tySame(fb, ba) { return true }
    if bb >= 0 && tySame(fa, bb) { return true }
    i = i + 1
  }
  false
}

// Are `a` and `b` the same type — every field equal, structurally? Two declared names (or a
// declared name beside its inline `{…}` form) reaching one type structurally are exempted:
// the checker accepts either wherever the other is expected, the twin machinery folds them
// onto one heap type, and there is nothing to tell apart. The checker's reading of `variantFieldTysEq`.
function objArmsSameType(a: TyObj, b: TyObj): boolean {
  if a.objFieldTypes.length != b.objFieldTypes.length { return false }
  let i = 0
  while i < a.objFieldTypes.length {
    if !tySame(a.objFieldTypes[i], objPairedTy(a, b, i)) { return false }
    i = i + 1
  }
  true
}

// The design rule `docs/guide/unions.md` promises, owed by the checker: VL's structural
// unions discriminate on the field-name set, so two arms sharing that set need a literal-typed
// field to part them, or the pair is refused. "" when `ty` is fine, or the message — a check
// error, not an emit one, since it is a rule, not a gap (D1023). One message per union, not per pair.
function unionDiscrimMsgNamed(ty: i32, spellings: string[]): string {
  if ty < 0 { return "" }
  const pt = T.tys[ty]
  if pt is TyUnion {
    const ms = pt.uMembers
    const named = spellings.length == ms.length
    let i = 1
    while i < ms.length {
      let j = 0
      while j < i {
        const mi = T.tys[ms[i]]
        const mj = T.tys[ms[j]]
        if mi is TyObj {
          if mj is TyObj {
            if (
              objSigSame(mi, mj) &&
              !objArmsSameType(mi, mj) &&
              !objArmsDiscriminable(mi, mj)
            ) {
              let na = tyToStrUser(ms[j])
              let nb = tyToStrUser(ms[i])
              if named {
                na = spellings[j]
                nb = spellings[i]
              }
              return "arms `" +
                na +
                "` and `" +
                nb +
                "` share a field-name set and no literal-typed field " +
                "distinguishes them — add a discriminant field"
            }
          }
        }
        j = j + 1
      }
      i = i + 1
    }
  }
  ""
}

// The no-spellings form, for a caller holding only the arena type (an inline `A | B`
// annotation, which has no declaration to read arm names off).
function unionDiscrimMsg(ty: i32): string {
  const none: string[] = []
  unionDiscrimMsgNamed(ty, none)
}

// Reports `msg` unless already reported, at any anchor — `tErrPush`'s own dedupe keys on
// `(message, anchor)`, too weak here since one bad union is reachable from its declaration
// and every annotation naming it. The message alone is the key. First writer wins: pass 0d
// runs before any annotation resolves, naming arms from the declaration's own spellings.
function tErrOncePerMsg(msg: string, at: i32) {
  let di = 0
  while di < T.diags.length {
    if T.diags[di].tmsg == msg { return 0 }
    di = di + 1
  }
  tErr(msg, at)
}

function checkUnionDiscriminable(stmts: i32[]) {
  let si = 0
  while si < stmts.length {
    const sd = P.nodes[stmts[si]]
    if sd is UnionDecl {
      const declIx = cUserTypes[sd.udName] ?? -1
      if declIx >= 0 {
        const m = unionDiscrimMsgNamed(declIx, sd.udVariants)
        if m != "" { tErrOncePerMsg(m, stmts[si]) }
      }
    }
    si = si + 1
  }
  0
}
// Measures every `flat type` in the program, after the declaration passes have filled each
// record's field types. Two phases, kept separate so an invalid declaration is never also
// reported as a recursive one: (A) validate and stage each declaration's fields, deferring a
// nested flat record; (B) a fixpoint, reporting anything still unresolved as a cycle by name.

function resolveFlatLayouts(stmts: i32[]) {
  // ── phase A: validate and stage ──
  // Two sweeps, since a flat record may nest one declared later in the source: register
  // every flat name first, then validate fields against the full set.
  let ri = 0
  while ri < stmts.length {
    const sd = P.nodes[stmts[ri]]
    if sd is TypeDecl {
      if sd.tdFlat == 1 {
        // A generic flat type has no layout: a type parameter has no width, and there is no
        // instantiation to measure at a declaration. Rejected here rather than staged, so it
        // never enters the sidecar and `Box<T>.size` stays an undeclared-identifier error.
        if declGpBaseOf(stmts[ri]) != "" {
          tErr(
            "a `flat` type cannot be generic — `" +
              sd.tdName +
              "` has type parameters, which have no byte width",
            stmts[ri],
          )
        } else if flatIndexOf(sd.tdName) < 0 {
          flNames.push(sd.tdName)
          flSizes.push(FL_UNRESOLVED)
          flFStart.push(0)
          flFCount.push(0)
          flDeclNodes.push(stmts[ri])
        }
      }
    }
    ri = ri + 1
  }
  let si = 0
  while si < stmts.length {
    const sd2 = P.nodes[stmts[si]]
    if sd2 is TypeDecl {
      if sd2.tdFlat == 1 {
        const d = flatIndexOf(sd2.tdName)
        if d >= 0 && flFCount[d] == 0 { flatStageDecl(d, sd2) }
      }
    }
    si = si + 1
  }
  // ── phase B: size the nest, by fixpoint ──
  let progress = true
  while progress {
    progress = false
    let d2 = 0
    while d2 < flNames.length {
      if flSizes[d2] == FL_UNRESOLVED {
        if flatTrySize(d2) { progress = true }
      }
      d2 = d2 + 1
    }
  }
  // Whatever is still unresolved cannot be sized at any depth: every remaining
  // declaration is waiting on another remaining declaration, which is a cycle.
  let d3 = 0
  while d3 < flNames.length {
    if flSizes[d3] == FL_UNRESOLVED {
      tErr(
        "`flat type " +
          flNames[d3] +
          "` is recursive — a flat record is stored INLINE, so a cycle has no " +
          "finite size",
        flDeclNodes[d3],
      )
      flSizes[d3] = FL_INVALID
    }
    d3 = d3 + 1
  }
  0
}

// Validate one flat declaration's fields and stage their widths. Every rejected field marks
// the whole declaration invalid, so a later `N.size` reports nothing (the field error is the
// actionable one) and phase B never reports a cycle for it.
function flatStageDecl(d: i32, sd: TypeDecl) {
  const declTyIx = cUserTypes[sd.tdName] ?? -1
  const dfields = sd.tdFields
  flFStart[d] = flFNames.length
  let bad = false
  let fi = 0
  while fi < dfields.length {
    const fd = P.nodes[dfields[fi]]
    if fd is FieldDef {
      const fname = fd.fdName
      // `N.size` is the record's total size, so a field of that name makes the spelling
      // ambiguous. Rejected rather than resolved either way: "field wins" hides the size,
      // "size wins" hides the field's offset, both silent wrong answers in address arithmetic.
      if fname == "size" {
        tErr(
          "a `flat` type cannot have a field named 'size' — that spelling is " +
            "the record's total byte size (`" +
            sd.tdName +
            ".size`); rename the field",
          dfields[fi],
        )
        bad = true
      }
      const fty = flatFieldTyOf(declTyIx, fi)
      const w = flatScalarWidth(fty)
      if w > 0 {
        flFNames.push(fname)
        flFWidth.push(w)
        flFNest.push(-1)
        flFOff.push(0)
      } else {
        const nest = flatIndexOf(flatFieldTyName(dfields[fi]))
        if nest >= 0 {
          // A nested flat record inlines: its bytes sit at the offset the running sum has
          // reached, and reaching one of its fields is `Outer.k + Inner.a` — which is why
          // the constant surface needs only one level of access.
          flFNames.push(fname)
          flFWidth.push(-1)
          flFNest.push(nest)
          flFOff.push(0)
        } else {
          // A field whose type failed to resolve at all is already reported by
          // the declaration pass; do not cascade a second message onto it.
          if !flatTyAlreadyErrored(fty) {
            tErr(
              "field '" +
                fname +
                "' cannot be in a `flat` type: " +
                flatWhyNot(fty, flatFieldTyName(dfields[fi])) +
                " — a flat field must be i32/i64/f32/f64, a newtype over one of " +
                "those, or another `flat` type",
              dfields[fi],
            )
          }
          bad = true
        }
      }
    }
    fi = fi + 1
  }
  flFCount[d] = flFNames.length - flFStart[d]
  if bad { flSizes[d] = FL_INVALID }
  0
}

// The resolved arena type of field `fi` of the record registered at `declTyIx`. The
// declaration pass pushed field types in declaration order into the same arrays the
// placeholder holds, so the index lines up with `tdFields`.
function flatFieldTyOf(declTyIx: i32, fi: i32) {
  if declTyIx < 0 { return -1 }
  const pt = T.tys[declTyIx]
  if pt is TyObj {
    const ftys = pt.objFieldTypes
    if fi < ftys.length { return ftys[fi] }
  }
  -1
}

// Whether an unusable field type is one the declaration pass already reported (an
// unresolvable annotation lands as the error type). Suppresses a second message on the same field.
function flatTyAlreadyErrored(tyIx: i32) {
  if tyIx < 0 { return true }
  const t = T.tys[tyIx]
  if t is TyErr { return true }
  false
}

// The clause naming why a field type has no place in a flat record. Every arm names a
// representation fact, because that is the thing the programmer has to work around.
function flatWhyNot(tyIx: i32, spelling: string) {
  if tyIx < 0 { return "its type has no byte width" }
  const t = T.tys[tyIx]
  // Exhaustive over `Ty`, deliberately without a `_` arm: a new variant breaks the
  // self-compile here instead of silently printing a representation fact about a shape
  // nobody classified.
  match t {
    TyPrim => {
      if t.primName == "boolean" {
        return "`boolean` has no declared byte width (use i32 — C's `bool` is 1 " +
          "byte and VL's is 4, so this tier will not guess)"
      }
      if t.primName == "string" { return "a string is a heap reference" }
      return "`" + t.primName + "` has no byte width"
    }
    TyArray => {
      return "an array is a heap reference"
    }
    TyMap => {
      return "a map/set is a heap reference"
    }
    TyFunc => {
      return "a function value is a reference"
    }
    TyNullable => {
      return "a nullable has no in-memory discriminant in this tier"
    }
    TyUnion => {
      return "a union is boxed on the heap"
    }
    TyObj => {
      if spelling == "" { return "an inline record is not a `flat` type" }
      return "`" + spelling + "` is a record but is not declared `flat`"
    }
    TyLit => {
      // A literal type — its base scalar is what the field would hold, and that base is
      // already named by the `TyPrim` arm, so the generic clause is the honest one here.
    }
    TyVar => {
      // An unsolved type parameter: the monomorphizer folds a `flat` layout
      // per-instance (`monoFoldTyParamLayout`), so no rep fact exists yet.
    }
    TyNeg => {
      // A residual negation — no representation to name.
    }
    TyErr => {
      // Suppressed one caller earlier by `flatTyAlreadyErrored`, so this clause is
      // never the message a programmer sees for the error type.
    }
  }
  // The literal, type-parameter, negation and error arms land here: no representation fact
  // to name, so the clause states only the width consequence.
  "its type has no byte width"
}

// Try to size declaration `d`: succeeds once every nested record it holds has a size. Fills
// the per-field byte offsets as a running sum — no alignment, no padding, no reordering (§2).
function flatTrySize(d: i32) {
  const start = flFStart[d]
  const count = flFCount[d]
  let k = 0
  while k < count {
    if flFWidth[start + k] < 0 {
      const nest = flFNest[start + k]
      if nest < 0 { return false }
      if flSizes[nest] == FL_UNRESOLVED { return false }
      // A nested record that is invalid makes this one unsizeable too, but the error is
      // already on the page — take the declaration out of the fixpoint silently rather
      // than reporting a cycle for it.
      if flSizes[nest] == FL_INVALID {
        flSizes[d] = FL_INVALID
        return true
      }
    }
    k = k + 1
  }
  let off = 0
  let j = 0
  while j < count {
    flFOff[start + j] = off
    let w = flFWidth[start + j]
    if w < 0 { w = flSizes[flFNest[start + j]] }
    off = off + w
    j = j + 1
  }
  flSizes[d] = off
  true
}

// The i32 value of the layout constant `name.prop`, or -1 when `prop` names neither the
// record's size nor one of its fields. Only ever asked about a name already known to be a
// sized flat type.
function flatConstOf(d: i32, prop: string) {
  if prop == "size" { return flSizes[d] }
  const start = flFStart[d]
  const count = flFCount[d]
  let k = 0
  while k < count {
    if flFNames[start + k] == prop { return flFOff[start + k] }
    k = k + 1
  }
  -1
}

// The layout constant `name.prop` by name, for the monomorphizer's per-instance fold of a
// type parameter's layout members (`monoFoldTyParamLayout`): -1 when `name` is not a usable
// `flat` type, -2 when it is one but has no member `prop` — different mistakes, named
// separately against the binding that made them.
export function flatConstOfNameProp(name: string, prop: string) {
  const d = flatIndexOf(name)
  if d < 0 { return -1 }
  // A rejected or cyclic declaration: its error is already on the page.
  if flSizes[d] < 0 { return -1 }
  const v = flatConstOf(d, prop)
  if v < 0 { return -2 }
  v
}

// The `N.size`/`N.field` interception at the top of `checkMemberNode`, the only place the
// layout sidecar is read. Answers 0 for an ordinary field access, 1 when folded to its
// constant, 2 when it reported an error, 3 when the receiver is a live type parameter whose
// fold belongs to the monomorphizer. The fold is an idempotent in-place arena rewrite to a `NumLit`.
function flatMemberFold(n: Member, ix: i32) {
  const obj = P.nodes[n.memObj]
  if obj is Ident {
    const nm = obj.identName
    if lookup(nm) >= 0 { return 0 }
    // A live type parameter (`T.size`): the layout isn't knowable here, since `T` is
    // abstract for the checker's one pass over a generic body, so the fold defers to the
    // monomorphizer, which rewrites this node once per instance. The member's type is `i32`
    // under every binding; whether the binding names a usable `flat` type is checked there instead.
    if tpEnvTyOfName(nm) >= 0 { return 3 }
    const d = flatIndexOf(nm)
    if d < 0 {
      if (cUserTypes[nm] ?? -1) >= 0 {
        tErr(
          "`" +
            nm +
            "` is not a `flat` type, so it has no byte layout — only a " +
            "`flat type " +
            nm +
            " = { … }` has `.size` and per-field offsets",
          ix,
        )
        return 2
      }
      return 0
    }
    // A declaration rejected, or part of a cycle, has its error already on
    // the page — fail quietly rather than cascade onto every use site.
    if flSizes[d] < 0 { return 2 }
    const v = flatConstOf(d, n.memProp)
    if v < 0 {
      tErr(
        "`flat type " +
          nm +
          "` has no field '" +
          n.memProp +
          "' — its layout members are `.size` and one offset per declared field",
        ix,
      )
      return 2
    }
    P.nodes[ix] = P.nodes[mkNum(i32ToStr(v), n.pos)]
    return 1
  }
  0
}

// ── nominal newtypes ──
// The whole feature is these five functions plus one test each in `assignableGo`, `tyEqGo`
// and `checkBinExprNode`. Nothing in `emit_*.vl` changes: `canonEmitTypeNames` rewrites
// every newtype annotation to its base's spelling before the emitter runs (`newtype-design.md` §3).

// True if `name` is declared `type N = new …`.
function isNewtypeName(name: string) {
  let i = 0
  while i < nwDeclNames.length {
    if nwDeclNames[i] == name { return true }
    i = i + 1
  }
  false
}

// The brand arena index `ix` carries, or "" when it is an ordinary structural type. The
// single reader of the sidecar; every nominal decision in the checker asks it.
export function nomNameOfTy(ix: i32) {
  if ix < 0 { return "" }
  let i = 0
  while i < nwTyIxs.length {
    if nwTyIxs[i] == ix { return nwNames[i] }
    i = i + 1
  }
  ""
}

// The UN-branded arena index a branded index stands for (itself, when unbranded).
// Read by the literal-adoption arm, which needs a destination whose own brand is
// waived while everything below it still checks.
function nomBaseTyIx(ix: i32) {
  if ix < 0 { return ix }
  let i = 0
  while i < nwTyIxs.length {
    if nwTyIxs[i] == ix { return nwBaseTyIxs[i] }
    i = i + 1
  }
  ix
}

// The arena index `ix` erases to at run time: `nomBaseTyIx` iterated to a fixpoint, so a
// brand over a brand (`type N2 = new N`) reaches the same base its outermost brand does.
// The bound is a cycle guard, not a depth policy — the sidecar is append-only and a brand
// is always minted over an index that already exists, so a chain cannot be long.
function nomErasedTyIx(ix: i32) {
  let cur = ix
  let steps = 0
  while steps < 8 {
    const b = nomBaseTyIx(cur)
    if b == cur { return cur }
    cur = b
    steps = steps + 1
  }
  cur
}

// —— unions whose arms share one runtime representation ——
// The diagnostic for a union two of whose members are distinct to the checker but one value
// shape to the emitter, or "" when every member is separable — a nominal brand is a second
// index erased before the emitter runs, so a brand and its base reach a union box's tag identically.
function nomUnionRepClashMsg(members: i32[]) {
  if nwTyIxs.length == 0 { return "" }
  let i = 1
  while i < members.length {
    let j = 0
    while j < i {
      if sameVariantTy(nomErasedTyIx(members[i]), nomErasedTyIx(members[j])) {
        return "union members '" +
          tyToStr(members[j]) +
          "' and '" +
          tyToStr(members[i]) +
          "' have the same runtime representation, so `is` cannot tell " +
          "them apart — a nominal newtype is erased to its base at run time"
      }
      j = j + 1
    }
    i = i + 1
  }
  ""
}

// Would `srcExpr : srcTy -> dstTy` succeed if the nominal brands in `dstTy` are ignored?
// True only for a syntactic scalar literal source: it carries no prior identity, so it
// adopts whatever brand the destination wears at any depth. An object/array literal is not
// admitted — it adapts element-wise through `assignableExpr` instead.
function nomLitAdopts(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if nwTyIxs.length == 0 { return false }
  if srcExpr < 0 { return false }
  if !exprIsBrandAdoptingLiteral(srcExpr) { return false }
  nomLitRelax = nomLitRelax + 1
  const ok = assignable(srcTy, dstTy)
  nomLitRelax = nomLitRelax - 1
  ok
}

// Does `dstTy` carry a nominal brand at or under its wrappers? The gate for the
// expression-aware retry `nomLitAdopts` uses: shallow on purpose, since a slot check meets
// only the type itself or one or two wrappers over it (`V?`, `V[]`, `V | null`).
function tyReachesBrand(ty: i32, d: i32) {
  if ty < 0 { return false }
  if d <= 0 { return false }
  if nomNameOfTy(ty) != "" { return true }
  const t = T.tys[ty]
  if t is TyNullable { return tyReachesBrand(t.nInner, d - 1) }
  if t is TyArray { return tyReachesBrand(t.aElem, d - 1) }
  if t is TyUnion {
    const ms = t.uMembers
    let i = 0
    let any = false
    while i < ms.length {
      if tyReachesBrand(ms[i], d - 1) { any = true }
      i = i + 1
    }
    return any
  }
  false
}

// The expression-aware retry for a slot checked with the bare structural `assignable` — the
// map `.set` key. `assignableExpr` covers both scalar-literal brand adoption and object-literal
// field-wise adaptation, which `nomLitAdopts` alone cannot supply. Gated on the destination
// actually carrying a brand, so a brand-free program keeps its bare structural check unchanged.
function nomSlotAccepts(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if nwTyIxs.length == 0 { return false }
  if srcExpr < 0 { return false }
  if !tyReachesBrand(dstTy, 6) { return false }
  assignableExpr(srcExpr, srcTy, dstTy)
}

// The branded arena index for newtype `name` over base `base` — minted once per (name, base)
// pair and reused, so `assignable`'s `src == dst` fast path still fires. A second index over
// the same `Ty` value, not a deep copy: a forward reference through the newtype name sees the
// finished shape once pass 0b fills it. Nominal sidecars are mirrored onto it for the same reason.
export function nameIsNewtypeBrand(nm: string): boolean {
  if nm == "" { return false }
  let i = 0
  while i < nwNames.length {
    if nwNames[i] == nm { return true }
    i = i + 1
  }
  false
}
export function tyIsNewtypeBrand(ty: i32): boolean {
  if ty < 0 { return false }
  let i = 0
  while i < nwTyIxs.length {
    if nwTyIxs[i] == ty { return true }
    i = i + 1
  }
  false
}

function nwBrand(name: string, base: i32) {
  if base < 0 { return base }
  if !isNewtypeName(name) { return base }
  let i = 0
  while i < nwTyIxs.length {
    if nwNames[i] == name && nwBaseTyIxs[i] == base { return nwTyIxs[i] }
    i = i + 1
  }
  const ix = addTy(T.tys[base])
  nwTyIxs.push(ix)
  nwNames.push(name)
  nwBaseTyIxs.push(base)
  const sdn = structNameOfTy(base)
  if sdn != "" {
    cTyIxSetAdd(cStructTyIxs, cStructTyIxSet, ix)
    cStructNames.push(sdn)
  }
  const udn = unionAliasDeclNameOfTy(base)
  if udn != "" {
    cTyIxSetAdd(cUnionTyIxs, cUnionTyIxSet, ix)
    cUnionNames.push(udn)
  }
  ix
}

// True if `name` is a one-member `type N = A` alias whose body is a plain type reference
// (`aliasRefIsPlainRoot`, recorded syntactically in pass 0a).
function isPlainAliasRef(name: string) {
  let i = 0
  while i < cPlainAliasNames.length {
    if cPlainAliasNames[i] == name { return true }
    i = i + 1
  }
  false
}

// True if the one-member alias `name` (arena index `ti`, a `TyUnion`) denotes its member
// transparently. `nameToTy` and `singleMemberAliasTyIx` must agree exactly, or the checker
// and emitter diverge on the same annotation. Not transparent for a canonicalized object
// intersection, which is interned as a named struct instead.
function singleAliasMemberTyIx(ti: i32, name: string) {
  const t = T.tys[ti]
  if t is TyUnion {
    if t.uMembers.length == 1 {
      const m0 = t.uMembers[0]
      const mt = T.tys[m0]
      if mt is TyPrim { return m0 }
      if mt is TyFunc { return m0 }
      if mt is TyArray {
        if arrSpineIsScalar(m0) { return m0 }
        // The nominal leaf `arrSpineIsScalar` excludes, admitted through the renderer that
        // keeps the name: `tyToEmitName` re-renders an array's element, so `Cat[]` becomes
        // `{n:i32}[]` and the declared name is gone, but `tyToNominalName` renders `Cat[]`
        // character for character, so the route is kept rather than lost.
        if arrSpineIsNominal(m0) { return m0 }
        // The map leaf, admitted for the reason the bare `TyMap` arm is admitted with no
        // gate (`arrSpineIsMap`): `{[K]:V}` renders as itself and the array layers on top
        // re-render their element, so the answer cannot differ by depth.
        if arrSpineIsMap(m0) { return m0 }
        // The inline object-shape leaf (`arrSpineIsObj`): faithful under the same renderer
        // as the scalar leaf for plain fields, and the nominal one for a declared struct.
        if arrSpineIsObj(m0) { return m0 }
        // The leaf that is itself a declared alias (`arrSpineIsNominal`) — the same gate a
        // bare union member applies (`unionAliasDeclNameOfTy` != ""), one array constructor out.
        if arrSpineIsUnionAlias(m0) { return m0 }
      }
      if mt is TyMap { return m0 }
      if mt is TyObj {
        if isPlainAliasRef(name) { return m0 }
      }
      // A union member (`type A = K` over a litunion, or `type A = U` over a declared value
      // union): a litunion reps as an interned i32 atom, so without this the union row this
      // alias minted made `isUName` claim the slot for a box while every read lowered the
      // atom — invalid wasm at every position (`transparentMemberEmitName`'s legs, read backwards).
      if unionAliasDeclNameOfTy(m0) != "" { return m0 }
      if unionAliasMembersFaithful(m0) { return m0 }
      // A nullable member — `type A = (K | null)` and the un-parenthesized `type A = K |
      // null` intern as the same one-member wrapper over a `TyNullable`, since `null`
      // normalizes into the niche. Same defect as the union case: the alias's union row
      // would claim the slot while the read lowers the niche. Ungated in the inner, unlike the array and union arms.
      if nulAliasMemberFaithful(m0) { return m0 }
    }
  }
  -1
}

// True when the emit render of un-named union type `ty` is name-faithful — a property of
// the members, not the wrapper. A declared struct member is the exception: without this
// gate a one-member alias over `(Cat | Dog)` drops the variant names `emitIs` dispatches
// on, and `x is Cat` fails where the alias-free spelling runs.
function unionAliasMembersFaithful(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyUnion {
    const ms = t.uMembers
    if ms.length < 1 { return false }
    let i = 0
    while i < ms.length {
      const mt = T.tys[ms[i]]
      let ok = false
      if mt is TyLit { ok = true }
      if mt is TyPrim { ok = true }
      // A litunion member of a mixed union (`(K | f64)`, kept nested rather than flattened)
      // is rendered by its alias on the union arm — faithful for the same reason a `TyLit` is.
      if tyIsLitUnion(ms[i]) { ok = true }
      if !ok { return false }
      i = i + 1
    }
    return true
  }
  false
}

// True when a one-member alias over nullable member `ty` denotes that member — no gate on
// the inner. `type T = (S | null)` interns `TyUnion[S?]`, so the alias denotes `S?`; both the
// checker (`declaredTyOfName`) and emitter (`singleMemberAliasTyIx`) must read that from
// here, or the alias's union row claims a box slot while every read lowers the niche.
function nulAliasMemberFaithful(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    // Gated in the inner, unlike the plain nullable-member arm: `type J = null | string |
    // J[]` interns as a wrapper over `TyNullable(string | J[])`, and calling that
    // transparent made the emitter's collection loop skip the declaration, so `J` never
    // got variant rows (D982). A literal or non-recursive inner stays transparent.
    const it = T.tys[t.nInner]
    if it is TyUnion {
      if it.uMembers.length > 1 {
        if !tyIsLitUnion(t.nInner) {
          if tyReachesSelf(ty) {
            // …except through a map arm: registering a self-referential map arm walks
            // `registerInlineUnion` → `registerMapValUnion` → `registerInlineUnion` by name
            // with no depth bound and exhausts the wasm stack (D984). Self-referential array
            // arms have no such loop and stay un-transparent. Lift this clause only once D984's recursion is bounded.
            return false
          }
        }
      }
    }
    return true
  }
  // The un-normalized shape — a `TyUnion` of literal members beside `null`, which a `type A
  // = B` wrapper sees only when `B`'s own `| null` declaration kept the raw survivor list
  // via a poisoned fold (`annUnionTy` answers -1 for an unseparable nominal pair).
  tyIsNullableLitUnion(ty)
}

// True when `ty` is an array (of arrays…) whose leaf element is a primitive — the exact
// condition under which `tyToEmitName` renders the type name-faithfully, since every rung
// it walks is the spelling the annotation had. Other leaf kinds are claimed by sibling
// predicates faithful under a different renderer (`arrSpineIsNominal`, `arrSpineIsMap`).
function arrSpineIsScalar(ty: i32) {
  const leaf = arrSpineLeafTy(ty)
  if leaf < 0 { return false }
  const t = T.tys[leaf]
  if t is TyPrim { return true }
  false
}

// The spine peel itself, with the leaf test lifted out — the one walk every `arrSpineIs*`
// predicate shares. Returns the arena index of the element reached by removing every
// `TyArray` layer, `ty` itself when `ty` is not an array, or -1 for an absent type. Bounded
// by the arena walk itself: an array's element is always a strictly earlier construction, so the spine cannot cycle.
function arrSpineLeafTy(ty: i32) {
  let cur = ty
  let going = true
  while going {
    if cur < 0 {
      going = false
    } else {
      const t = T.tys[cur]
      if t is TyArray { cur = t.aElem } else { going = false }
    }
  }
  cur
}

// True when `ty` is an array (of arrays…) whose leaf element is a declared struct — the
// exact condition under which `tyToNominalName` renders the type name-faithfully,
// `arrSpineIsScalar`'s twin one renderer over. Same walk, same bound; only the leaf test
// differs. A union-alias leaf is deliberately not claimed here — `arrSpineIsUnionAlias` claims it instead (D362).
function arrSpineIsNominal(ty: i32) {
  const leaf = arrSpineLeafTy(ty)
  if leaf < 0 { return false }
  structNameOfTy(leaf) != ""
}

// True when `ty` is an array (of arrays…) whose leaf element is a map — the third twin, and
// a leaf kind `singleAliasMemberTyIx` claims with no gate at all, since a map alias has no
// nominal route to lose. Left unclaimed here, `collectU` minted the alias a one-variant
// union row so `isUName` claimed every annotated binding for the box while the initializer lowered a list wrapper (D181).
function arrSpineIsMap(ty: i32) {
  const leaf = arrSpineLeafTy(ty)
  if leaf < 0 { return false }
  const t = T.tys[leaf]
  if t is TyMap { return true }
  false
}

// True when `ty` is an array (of arrays…) whose leaf element is an inline object shape — the
// fourth twin (D188). Takes the nominal leg too: an inline shape has no declared name of its
// own to drop, but a field inside it can (`type L = {p: Cat}[]` re-renders structurally).
// Tested independently of the declared-struct leaf, since each stays a statement about one leaf kind.
function arrSpineIsObj(ty: i32) {
  const leaf = arrSpineLeafTy(ty)
  if leaf < 0 { return false }
  const t = T.tys[leaf]
  if t is TyObj { return structNameOfTy(leaf) == "" }
  false
}

// True when `ty` is an array (of arrays…) whose leaf element is itself a declared alias —
// the fifth and last twin. `parseTypeDecl` encodes every non-struct-bodied `type N = …` as
// a one-member `UnionDecl`, so such a leaf is a `TyUnion` carrying the alias's name, not the
// leaf's own constructor — a litunion, value union, or intersection all read the same row (D362).
function arrSpineIsUnionAlias(ty: i32) {
  const leaf = arrSpineLeafTy(ty)
  if leaf < 0 { return false }
  unionAliasDeclNameOfTy(leaf) != ""
}

// The arena type a declared one-member union alias denotes transparently (`type Id = i32`),
// or -1 when `name` is not such an alias — the emitter resolves it to the member's own
// vocabulary rather than registering a one-variant union box. A type index, not a name: each
// consumer renders the member once, at its own position, rather than re-parsing a rendered answer.
function singleMemberAliasTyIx(name: string) {
  if !cUserTypes.has(name) { return -1 }
  const ti = cUserTypes[name] ?? -1
  if ti < 0 { return -1 }
  singleAliasMemberTyIx(ti, name)
}

// True when the declared name `name` is a transparent one-member alias, in any arm of
// `singleAliasMemberTyIx` — the object arm is gated on `isPlainAliasRef`, so a canonicalized
// intersection is not claimed. Exported for `collectU`'s skip, without which the alias
// registers as a one-variant union and the name classifies as a box for a type that denotes its member transparently.
export function isTransparentAlias(name: string) {
  singleMemberAliasTyIx(name) >= 0
}

// The emit spelling of a transparent alias's member — the one producer read by both the
// annotation rewriter and the `is` rewriter, so the two cannot spell the union's variant and
// the test that names it differently. Nominal-first for an object member: with `collectU`'s
// skip, the member interns under its own name rather than falling through to the inline shape.
function transparentMemberEmitName(smt: i32, ctx: i32): string {
  const mt = T.tys[smt]
  if mt is TyObj {
    const sdn = structNameOfTy(smt)
    if sdn != "" {
      // A declared name is one identifier, so one atom — the same bank `tyToEmitNameAt`
      // fills for its own renders, set here since this arm returns without calling it.
      tyNameAtoms = 1
      return sdn
    }
    // The application spelling is likewise one top-level atom, on `genAppNameOfTy`'s own
    // bank. Declines for an uninstantiated or cyclic argument, so a member with no finite
    // application name still falls through to the structural render.
    const gan = genAppNameOfTy(smt)
    if gan != "" {
      tyNameAtoms = 1
      return gan
    }
  }
  // A declared union member renders as its own alias name at every position, the same
  // nominal-first rule the object arm applies — the structural render would drop the
  // declared name the emitter's tables key on. A numeric litunion alias is deliberately not
  // nominal, though: `numLitUnionAliasName` rewrites it to its base scalar instead.
  const uan = unionAliasDeclNameOfTy(smt)
  if uan != "" {
    if numLitUnionAliasName(uan) == "" {
      // An alias name is one identifier — one atom, as on the object and union arms.
      tyNameAtoms = 1
      return uan
    }
  }
  // An array member over a declared-struct leaf renders through the nominal renderer, one
  // constructor out from the object arm: the structural render drops the declared name the
  // emitter's element tables key on, while `tyToNominalName` keeps the direct spelling.
  // Gated on the same predicate `singleAliasMemberTyIx` uses, so the two agree about which arrays are claimed.
  if mt is TyArray {
    const nomLeaf = arrSpineIsNominal(smt) ||
      arrSpineIsMap(smt) ||
      arrSpineIsObj(smt)
    if nomLeaf || arrSpineIsUnionAlias(smt) {
      const anr = tyToNominalNameAt(smt, ctx)
      if anr != "" {
        // The nominal render's width stands where it left it — one bank serves both faces,
        // so there is no hand-over. An array is one atom: its `|`s, if any, sit inside the
        // element's grouping parens.
        return anr
      }
    }
  }
  tyToEmitNameAt(smt, ctx)
}

// The base-scalar emit name of a numeric literal-union type (`0 | 1` → "i32"), or "" for
// anything else — a projection of the checker's own algebra (`softenLitTy`). The string base
// is excluded on purpose: a string litunion keeps its alias name as its atom identity, while
// a numeric one has none, since its members are plain i32/i64/f64 values.
export function numLitUnionBaseTy(ty: i32): i32 {
  let cur = ty
  let peels = 0
  while peels < 8 {
    if cur < 0 { return -1 }
    const t = T.tys[cur]
    let inner = -1
    if t is TyUnion {
      if t.uMembers.length == 1 { inner = t.uMembers[0] }
    }
    if inner < 0 {
      peels = 8
    } else {
      cur = inner
      peels = peels + 1
    }
  }
  if cur < 0 { return -1 }
  const soft = softenLitTy(cur)
  if soft == cur { return -1 }
  if soft < 0 { return -1 }
  const st = T.tys[soft]
  if st is TyPrim {
    const pn = st.primName
    if pn == "i32" || pn == "i64" || pn == "f64" { return soft }
  }
  -1
}

// The base as the atom: `PrimName` is a literal union, so this stays an interned atom and a
// caller's `== "i64"` is an `i32.eq`; declaring it `string` would widen it.
function numLitUnionBasePrim(ty: i32): PrimName | null {
  const b = numLitUnionBaseTy(ty)
  if b < 0 { return null }
  const bt = T.tys[b]
  if bt is TyPrim { return bt.primName }
  null
}

// Does `ty` have a numeric-litunion base? The `!= ""` most callers are really asking, with
// no name built to ask it.
export function numLitUnionHasBase(ty: i32): boolean {
  numLitUnionBaseTy(ty) >= 0
}

// The base as text — for the callers that genuinely propagate a name upward (the nominal
// renderers), where the widening belongs at that boundary rather than on every ask.
export function numLitUnionBaseName(ty: i32): string {
  primNameStr(numLitUnionBasePrim(ty))
}

// The single base numeric scalar every value of `ty` reps as at emit, or "" when not
// uniformly one of the three. The receiver side of the numeric-litunion `is` membership
// test, so it must answer for a mixed spelling like `K | i32`, which collapses to that base
// with no union box — `numLitUnionBaseName` cannot, since `softenLitTy` stops at a non-`TyLit` member.
function tyNumScalarBaseName(ty: i32): string {
  const work: i32[] = [ty]
  let wi = 0
  let base = ""
  while wi < work.length {
    if wi >= 64 { return "" }
    const cur = work[wi]
    wi = wi + 1
    if cur < 0 { return "" }
    const t = T.tys[cur]
    if t is TyUnion {
      let i = 0
      while i < t.uMembers.length {
        work.push(t.uMembers[i])
        i = i + 1
      }
    } else {
      let nm = ""
      if t is TyPrim { nm = t.primName }
      if t is TyLit { nm = tyLitBaseName(t) }
      if nm != "i32" && nm != "i64" && nm != "f64" { return "" }
      if base == "" { base = nm }
      else if base != nm { return "" }
    }
  }
  base
}

// The base scalar type `ty` reps as, or `null` for anything that isn't a scalar rep — the
// kind-agnostic sibling of `tyNumScalarBaseName`. Three arena shapes rep as one base scalar
// and the emitter cannot tell them apart at a param cell: a `TyPrim`, a single-member
// `TyLit`, and a `TyUnion` of `TyLit`s over one base — the one home for this question.
export function tyScalarBasePrim(ty: i32): PrimName | null {
  let cur = ty
  let peels = 0
  while peels < 8 {
    if cur < 0 { return null }
    const t = T.tys[cur]
    if t is TyPrim { return t.primName }
    if t is TyLit { return tyLitBasePrim(t) }
    if t is TyUnion {
      if t.uMembers.length == 1 {
        cur = t.uMembers[0]
        peels = peels + 1
        continue
      }
      // Every member a literal over one base, or this is not a scalar rep.
      let base: PrimName | null = null
      let i = 0
      while i < t.uMembers.length {
        const m = T.tys[t.uMembers[i]]
        let nm: PrimName | null = null
        if m is TyLit { nm = tyLitBasePrim(m) }
        if nm == null { return null }
        if base == null { base = nm }
        else if base != nm { return null }
        i = i + 1
      }
      return base
    }
    return null
  }
  null
}

// The decision form — `tyIsPrimNamed`'s shape, over the peeling base. No string exists at
// any point on this path.
export function tyScalarBaseIs(ty: i32, nm: PrimName): boolean {
  tyScalarBasePrim(ty) == nm
}

// The decision form as the node query — `tyScalarBaseIs` where the emitter holds a node.
export function nodeScalarBaseIs(ix: i32, nm: PrimName): boolean {
  tyScalarBasePrim(nodeTyIxOf(ix)) == nm
}

// The value-atom kind of the non-null member of a `<numeric scalar> | null` arena type — `0`
// i32, `3` i64, `4` f64, `5` f32 — else -1. Only these four reps have every bit pattern
// already taken by a real value (unlike `boolean`/`string`/litunion/struct, each of which
// has a spare bit or its own niche), so `i32 | null` is the box. A plain `TyPrim` inner only.
export function tyNulNumScalarValKind(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyNullable {
    const ii = t.nInner
    if ii < 0 { return -1 }
    const it = T.tys[ii]
    if it is TyPrim {
      if it.primName == "i32" { return 0 }
      if it.primName == "i64" { return 3 }
      if it.primName == "f64" { return 4 }
      if it.primName == "f32" { return 5 }
    }
  }
  -1
}

// True when a nullable type's non-null member is a literal union (a singleton `TyLit`
// counts too). That rep's absence rides the `-1` sentinel below every interned atom id, not
// the `{tag, anyref}` box, so a checked list read at this rep needs the sentinel arm —
// without one the read stays unchecked and an out-of-range `.get` traps (D1281).
export function tyNulLitUnionInner(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable { return tyIsLitUnionOrLit(t.nInner) }
  false
}

// The pipe-joined union name these value-union kinds register under
// (`registerValueUnionName` keys on the member-set spelling), or "" for every other type —
// one home, so the collect pass's registration and the emitter's box lowering cannot disagree.
export function nulNumScalarUnionName(ty: i32): string {
  const k = tyNulNumScalarValKind(ty)
  if k == 0 { return "i32|null" }
  if k == 3 { return "i64|null" }
  if k == 4 { return "f64|null" }
  if k == 5 { return "f32|null" }
  ""
}

// The base numeric scalar node `ix`'s recorded type reps as, or "" — `tyNumScalarBaseName`
// as the node query the emitter asks (it holds nodes, not arena indices, and reads every
// other type fact of an `is` receiver through a wrapper of exactly this shape).
export function nodeNumScalarBaseName(ix: i32) {
  tyNumScalarBaseName(nodeTyIxOf(ix))
}

// The member literal texts (raw lexemes) of a numeric literal-union type `ty`, in source
// order. Empty for anything `numLitUnionBaseName` does not claim, so a string litunion
// answers empty here and a numeric one answers empty in `tyLitMemberTexts` — the two
// extractors partition the literal kinds exactly as the two reps do.
export function tyNumLitMemberTexts(ty: i32) {
  const out: string[] = []
  if !numLitUnionHasBase(ty) { return out }
  let cur = ty
  let peels = 0
  while peels < 8 {
    if cur < 0 { return out }
    const t = T.tys[cur]
    let inner = -1
    if t is TyUnion {
      if t.uMembers.length == 1 { inner = t.uMembers[0] }
    }
    if inner < 0 {
      peels = 8
    } else {
      cur = inner
      peels = peels + 1
    }
  }
  if cur < 0 { return out }
  const ct = T.tys[cur]
  if ct is TyUnion {
    let i = 0
    while i < ct.uMembers.length {
      const m = T.tys[ct.uMembers[i]]
      if m is TyLit { out.push(m.litText) }
      i = i + 1
    }
    return out
  }
  if ct is TyLit { out.push(ct.litText) }
  out
}

// The emit name of a declared alias for a numeric literal union, or "". Exported for the
// registered-row reader `numLitUnionBaseName`'s note names.
export function numLitUnionAliasName(name: string) {
  if !cUserTypes.has(name) { return "" }
  const ti = cUserTypes[name] ?? -1
  if ti < 0 { return "" }
  numLitUnionBaseName(ti)
}

// True if `name` is an application of a declared generic alias whose argument list closes
// the whole name (`Box<i32>`), not `Box<i32>[]` or `Box<i32>|Tag`, whose suffix a caller
// peels first. Checked against the generic-alias registry (`gaIndexOf`), not taken on the
// spelling's word, so an unrelated name merely ending in `>` never matches.
function nameIsGenAppOfDecl(name: string) {
  // The whole spelling test is `annGenAppSpanEnds` at its home in `tyname.vl`. Only the
  // registry lookup is this function's own, taking the head cut from `gaeLtAt` through
  // `tyname.gaeHeadNameOf`.
  if !annGenAppSpanEnds(name) { return false }
  gaIndexOf(gaeHeadNameOf(name, gaeLtAt(name))) >= 0
}

// The structural emit name of a generic-alias application standing as one member of a
// multi-member declared union (`type U = Box<i32> | Tag` → "{v:i32}"), or "" otherwise —
// without it `collectU`'s `isStructAtom` check (which reads `TypeDecl` names, never
// `Box<i32>`) drops the member from `uVariants` while the alias still registers, silent invalid wasm at every construction site.
function unionMemberGenAppShape(member: string) {
  if !nameIsGenAppOfDecl(member) { return "" }
  const ti = nameToTy(member)
  if ti < 0 { return "" }
  const t = T.tys[ti]
  if t is TyObj { return tyToEmitName(ti) }
  ""
}

// The top-level atom count of the name the last `canonEmitName` call returned, and its
// `nulLitUnionPreserve` sibling — read by `canonEmitTypeNames` instead of re-splitting the
// string it just joined. A canon'd name gains a top-level `|` at exactly two places (the
// union join, `nulLitUnionPreserve`'s `|null` suffix); every other arm recurses or is one atom.
let canonAtoms = 1
let nluAtoms = 1
let lupAtoms = 1

// The pre-canon spelling of every annotation inside a generic declaration, as a node-index
// column and the name each node carried before `canonEmitTypeNames` rewrote it — read by
// `emit_collect.gaeCollectDecls` and `emit_mono`. Needed since canon's rewrite has no scope:
// inside `type Box<Id> = { v: Id }`, `Id` is the alias's own type parameter, not a resolvable name.
let cgpFieldNodes: i32[] = []
let cgpFieldRaw: string[] = []

// A nullable literal-union's preserved canonical name, or "" if `parts` are not one. `K |
// null` must keep the litunion members intact, or the generic union soften collapses each
// quoted literal to `string` and mis-routes the type to the `string | null` ref box instead
// of the i32 atom niche. Reconstructs as `<litunion-core>|null`.
function nulLitUnionPreserve(parts: string[], ctx: i32) {
  let hasNull = false
  const rest: string[] = []
  let i = 0
  while i < parts.length {
    if parts[i] == "null" { hasNull = true } else { rest.push(parts[i]) }
    i = i + 1
  }
  if !hasNull { return "" }
  if rest.length == 0 { return "" }
  let core = rest[0]
  let j = 1
  while j < rest.length {
    core = core + "|" + rest[j]
    j = j + 1
  }
  if nameIsLitUnionType(core) {
    // The reconstructed name's atom count, banked for `canonEmitName`: `rest` holds
    // top-level members of the original split and the `null` arm adds one — duplicate
    // `null` members collapse into the single suffix, so this is `rest.length + 1`, not `parts.length`.
    nluAtoms = rest.length + 1
    return core + "|null"
  }
  // The same question through one grouping paren. A top-level `|` split hands out a part
  // still carrying its grouper: `(("a"|"b")|null)[]` splits its element into `("a"|"b")` +
  // `null`, so `core` arrives grouped and `nameIsLitUnionType` declines it by construction.
  // Without this, `("a"|"b")[]|null` and `(("a"|"b")|null)[]` canon'd to different spellings for one arena type.
  if nameIsParenSpanEnds(core) && !isTopLevelFuncTypeName(core) {
    const iparts: string[] = []
    tyTopLevelSplit(groupInnerOf(core), '|', false, iparts)
    const lup = litUnionPreserve(iparts)
    if lup != "" {
      // `litUnionPreserve` banks its own width (1 for an alias, one per kept member
      // otherwise); the `null` arm adds one, exactly as the ungrouped path does.
      nluAtoms = lupAtoms + 1
      return lup + "|null"
    }
  }
  // …and through one transparent alias, the third spelling of the same question: `type K2 =
  // K` denotes the litunion, but `nameIsLitUnionType` reads the alias's own one-member
  // wrapper, not a litunion, so it declines and canon softened `K2 | null` to `string |
  // null` — a `{[string]: K2|null}` map built a ref-typed slot while every read lowered the i32 atom, invalid wasm.
  if isTransparentAlias(core) {
    const cCore = canonEmitNameAt(core, ctx)
    if nameIsLitUnionType(cCore) {
      nluAtoms = canonAtoms + 1
      return cCore + "|null"
    }
  }
  // A nullable union of literal unions (`K | K2 | null`) deliberately does not flatten
  // here: `annUnionInnerTy` declines a `null`-carrying annotation, so flattening the
  // spelling alone would have canon naming an atom niche the arena classifies otherwise.
  ""
}

// True at the render positions where a literal union keeps its members — the positive half
// of the policy `tyToNameGo`'s array/object/map arms already apply. False at `RC_ROOT`,
// `RC_FN_PARAM` and `RC_FN_RES`: a container's slot really does hold the interned atom, but
// a function result is the same scalar position a declaration's return occupies.
function ctxKeepsLitUnion(ctx: i32) {
  if (ctx & RC_ELEM) != 0 { return true }
  if (ctx & RC_FIELD) != 0 { return true }
  if (ctx & RC_MAP_VAL) != 0 { return true }
  false
}

// The mixed-union spelling has no position gate: the emitter holds a third copy of the
// soften rule (`canonLitUnionArms`) that rewrites a litunion atom to `string` while the
// union row registers under the canon'd annotation. A position gate here would mint two
// rows for one type, since the registry is keyed by name and blind to position.
function litUnionPreserve(parts: string[]) {
  const kept: string[] = []
  let i = 0
  while i < parts.length {
    let dup = false
    let j = 0
    while j < kept.length {
      if kept[j] == parts[i] { dup = true }
      j = j + 1
    }
    if !dup { kept.push(parts[i]) }
    i = i + 1
  }
  if kept.length < 2 { return "" }
  let core = kept[0]
  let k = 1
  while k < kept.length {
    core = core + "|" + kept[k]
    k = k + 1
  }
  if nameIsLitUnionType(core) {
    // A declared alias with exactly these members wins the spelling — the same preference
    // `litUnionAliasNameOfTy` gives the structural renderer, since an intern key must be one
    // name per type. Without it two spellings of one litunion map type mint two shape slots,
    // invalid wasm whether preserved or softened. Member texts are recovered by dropping each kept member's quotes.
    const texts: string[] = []
    let q = 0
    while q < kept.length {
      texts.push(groupInnerOf(kept[q]))
      q = q + 1
    }
    const al = litUnionAliasOfLitTexts(texts)
    if al != "" {
      // An alias name is one identifier — one atom.
      lupAtoms = 1
      return al
    }
    // Each kept member is a top-level member of the original split, so none carries a
    // top-level `|` of its own and the join writes exactly `kept.length - 1` separators.
    lupAtoms = kept.length
    return core
  }
  // A union of literal unions is a literal union — the preceding leg answers only when
  // every part is a quoted lexeme, so `K | K2` falls past it into `litUnionFlatten`.
  litUnionFlatten(parts)
}

// —— the flatten: a union whose members are all literal unions is a literal union ——
// `K | K2` spells the litunion union of `K`'s and `K2`'s members, or "" when some part is
// not literal-derived — mirrors `annUnionInnerTy`'s arena rule on the string side, since
// canon has no arena to read. A neutral (numeric) part is not enough, or the member would silently drop.
function litUnionFlatten(parts: string[]) {
  const texts: string[] = []
  let i = 0
  while i < parts.length {
    const c = litRunPartTexts(parts[i], texts)
    if c != LRP_LITS { return "" }
    i = i + 1
  }
  const kept: string[] = []
  let t = 0
  while t < texts.length {
    let dup = false
    let j = 0
    while j < kept.length {
      if kept[j] == texts[t] { dup = true }
      j = j + 1
    }
    if !dup { kept.push(texts[t]) }
    t = t + 1
  }
  // Fewer than two distinct members has no inline spelling — `nameIsInlineLitUnion`
  // requires 2+ quoted atoms. The identical guard sits in `litUnionPreserve` and its arena twin.
  if kept.length < 2 { return "" }
  const al = litUnionAliasOfLitTexts(kept)
  if al != "" {
    // An alias name is one identifier — one atom.
    lupAtoms = 1
    return al
  }
  let out = "\"" + kept[0] + "\""
  let k = 1
  while k < kept.length {
    out = out + "|\"" + kept[k] + "\""
    k = k + 1
  }
  lupAtoms = kept.length
  out
}

// —— the mixed-union literal-run regroup, canon's side ——
// `tyToNameGo`'s union arm regroups the flattened string-literal members of a mixed
// union back into their registered alias (`K0 | f64` renders `K0|f64`); canon must spell the
// same union the same way, so this classifies member spellings by the same three-way rule the renderer applies to arena members.

// A member spelling that is not literal-derived: the member that makes a union mixed.
const LRP_OTHER = 0
// The `null` arm, or a numeric literal — the renderer's walk counts neither as a run text
// nor as a mix-maker, so neither does this.
const LRP_NEUTRAL = 1
// A member that flattens to one or more string literals: a quoted leaf, a registered
// litunion alias, or an inline litunion spelling.
const LRP_LITS = 2

// Appends the string-literal member texts union-member spelling `p` contributes to the
// enclosing union's flattened literal run, and reports which of the three classes it is in.
// A member classifying "other" pushes nothing, so a caller's `out` holds exactly the texts of the members it counted.
function litRunPartTexts(p: string, out: string[]): i32 {
  if p.length == 0 { return LRP_OTHER }
  if p == "null" { return LRP_NEUTRAL }
  // A grouper is not a member: `("a"|"b")` contributes exactly what its interior does.
  if nameIsParenSpanEnds(p) && !isTopLevelFuncTypeName(p) {
    return litRunPartTexts(groupInnerOf(p), out)
  }
  // An inline union spelling — reached through the grouper strip, since a top-level `|`
  // split never hands out a part that still carries one.
  if nameHasPipe(p) && !isTopLevelFuncTypeName(p) {
    const sub: string[] = []
    tyTopLevelSplit(p, '|', false, sub)
    const local: string[] = []
    let anyLit = false
    let si = 0
    while si < sub.length {
      const sc = litRunPartTexts(sub[si], local)
      if sc == LRP_OTHER { return LRP_OTHER }
      if sc == LRP_LITS { anyLit = true }
      si = si + 1
    }
    if !anyLit { return LRP_NEUTRAL }
    let li = 0
    while li < local.length {
      out.push(local[li])
      li = li + 1
    }
    return LRP_LITS
  }
  // A literal member lexeme, through the one home for that grammar. `litMemberTy` returns
  // -1 without allocating for every ordinary name, so this costs a `[0]` read on the
  // members that are not literals at all.
  const lmt = litMemberTy(p)
  if lmt >= 0 {
    const lt = T.tys[lmt]
    if lt is TyLit {
      if lt.litKind == "str" {
        out.push(lt.litText)
        return LRP_LITS
      }
    }
    return LRP_NEUTRAL
  }
  // A registered litunion alias (`K0`) contributes its own members' texts — this is the
  // member the arena has already flattened away by the time the renderer sees it, which is
  // why the renderer needs a regroup and this needs an expansion.
  const ai = cUserTypes[p] ?? -1
  if ai >= 0 {
    if tyIsLitUnion(ai) {
      const at = T.tys[ai]
      if at is TyUnion {
        let mi = 0
        while mi < at.uMembers.length {
          const mt = T.tys[at.uMembers[mi]]
          if mt is TyLit { out.push(mt.litText) }
          mi = mi + 1
        }
        return LRP_LITS
      }
    }
  }
  LRP_OTHER
}

// —— the subsumed-arm collapse, canon's side ——
// The arena drops a union arm that adds no values; canon must drop the same arm or the two
// producers agree about the type and disagree about the rep — the arena saying `string`
// while canon spells `Kind|string` reserves a union box for a plain-string binding (D1048).

// Does the union-member spelling `p` denote a set of string literals and nothing else? The
// canon-side twin of `homogLitUnionBase` over the `string` base. The union leg is not
// decoration: `(K | K2) | string` reaches the arena as one flattened litunion, so without
// recursing here canon would keep an arm the arena had already dropped.
function partIsStrLitSet(p: string): boolean {
  if p.length == 0 { return false }
  if nameIsParenSpanEnds(p) && !isTopLevelFuncTypeName(p) {
    return partIsStrLitSet(groupInnerOf(p))
  }
  if nameIsLitUnionType(p) { return true }
  if nameHasPipe(p) && !isTopLevelFuncTypeName(p) {
    const sub: string[] = []
    tyTopLevelSplit(p, '|', false, sub)
    let si = 0
    while si < sub.length {
      if !partIsStrLitSet(sub[si]) { return false }
      si = si + 1
    }
    return true
  }
  const lm = litMemberTy(p)
  if lm >= 0 {
    const lt = T.tys[lm]
    if lt is TyLit { return lt.litKind == "str" }
  }
  false
}

// The survivors of the collapse over a union spelling's top-level `parts`, and whether any
// arm is dropped. `out` is filled unconditionally, the same contract
// `unionDropSubsumedArms` keeps. The `string` arm is looked for among non-literal parts
// only, since flattening a literal member yields its literals, never the base prim.
function canonDropSubsumedParts(parts: string[], out: string[]): boolean {
  if parts.length < 2 { return false }
  const isLit: boolean[] = []
  let anyLit = false
  let i = 0
  while i < parts.length {
    const l = partIsStrLitSet(parts[i])
    isLit.push(l)
    if l { anyLit = true }
    i = i + 1
  }
  // The cheap reject: no literal arm, nothing to subsume. Keeps the extra render that
  // follows off every ordinary union spelling.
  if !anyLit { return false }
  let hasStrArm = false
  i = 0
  while i < parts.length {
    if !isLit[i] {
      if canonEmitNameAt(parts[i], RC_ROOT) == "string" { hasStrArm = true }
    }
    i = i + 1
  }
  if !hasStrArm { return false }
  let dropped = false
  i = 0
  while i < parts.length {
    if isLit[i] { dropped = true } else { out.push(parts[i]) }
    i = i + 1
  }
  // A list that collapses to nothing cannot arise (a dropped arm needs the surviving
  // `string` arm that subsumed it), but the guard keeps the degenerate case out of the
  // rejoin — the same length guard `unionDropSubsumedArms` keeps.
  if out.length == 0 { return false }
  dropped
}

// The registered litunion alias that a mixed union spelling's string-literal run regroups
// into, or "" when the spelling isn't mixed, carries no run of 2+ literals, or matches no
// registered alias. Fills `cls` with one class per part so the substitution doesn't
// re-derive it — the same three guards, in the same order, as the renderer's own regroup.
function mixedUnionLitAliasRegroup(parts: string[], cls: i32[]) {
  const texts: string[] = []
  let nonLit = false
  let i = 0
  while i < parts.length {
    const c = litRunPartTexts(parts[i], texts)
    cls.push(c)
    if c == LRP_OTHER { nonLit = true }
    i = i + 1
  }
  if !nonLit { return "" }
  if texts.length < 2 { return "" }
  litUnionAliasOfLitTexts(texts)
}

// True if any top-level member of a `|`-split union spelling is the bare `null` arm. The
// string side's only way to ask what `TyNullable` answers structurally: canon splits
// `A|B|null` into three flat siblings, so nullability must be read off a sibling. Feeds the
// sticky `RC_NULLABLE` bit so members carry the same position the structural renderer gives them.
function partsHaveNull(parts: string[]) {
  let i = 0
  while i < parts.length {
    if parts[i] == "null" { return true }
    i = i + 1
  }
  false
}

// The position-free entry, as `tyToEmitName`'s: `emit_collect.vl` canons a whole render,
// which is `RC_ROOT` and holds no parser tree by construction.
export function canonEmitName(name: string) { canonEmitNameAt(name, RC_ROOT) }

// ── the union registry's rep key, minted here and nowhere else (`registry-by-type-id.md`
// §3) ── neither existing key works: an arena index is not an identity, and `repCanonId`
// both merges disjoint literal unions of the same arity and splits a nested union from its
// flattening. Canon's own softened, flattened rendering is the equivalence the registry needs.
const cukTexts: string[] = []
const cukIds: {[string]: i32} = Map()

// The member sequence `name` denotes, in the registry's ABI order — `collectU`'s own
// expansion rule: a union-alias atom is replaced by its members only when the expansion is
// multi-atom, since a litunion alias renders as its softened base and taking that would
// delete an arm. Not deduped or reordered: a union's box tags are positional over it.
function canonUnionKeyText(name: string): string {
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  let out = ""
  let i = 0
  while i < atoms.length {
    let m = atoms[i]
    const exp = unionAliasMembers(m)
    if exp.length > 0 {
      const ea: string[] = []
      splitUnionAtoms(exp, ea)
      if ea.length > 1 { m = exp }
    }
    if out.length > 0 { out = out + "|" }
    out = out + m
    i = i + 1
  }
  out
}

// The key for a spelling, -1 for the empty name, which the registry never holds. The flatten
// is the key and the softening is not: the flatten is what makes `J | E` and
// `boolean|f64|string|E` one key, while the softening collapses `"aa"|"bb"` and `61|62` to
// `string`/`i32` (`registry-by-type-id.md` §3 measures the gap against `repCanonId`).
export function canonUnionKeyOfName(name: string): i32 {
  if name.length == 0 { return -1 }
  const text = canonUnionKeyText(name)
  if text.length == 0 { return -1 }
  const at = cukIds[text] ?? -1
  if at >= 0 { return at }
  const id = cukTexts.length
  cukTexts.push(text)
  cukIds[text] = id
  id
}

// The key for an arena type — the entry point for a producer holding a type rather than a
// spelling. Routes through the spelling-side renderer rather than deriving a second
// identity, so the two entry points can disagree only where `tyToEmitName` and the caller's own spelling already do.
export function canonUnionKey(ty: i32): i32 {
  if ty < 0 { return -1 }
  canonUnionKeyOfName(tyToEmitName(ty))
}

// One member of the key's sequence, spelled the way the declaration spelled it — the
// name-faithful renderer at the key's own position, never the structural one (a declared
// struct comes back `Circle`, not `{r:i32}`). A function member is parenthesized, the
// annotation's own atom spelling, or a bare closure result would swallow the union's siblings.
function canonUnionKeyAtomOfTy(m: i32): string {
  if m < 0 { return "" }
  // The cycle bank is per top-level render (`tyToNominalName`'s contract), and this is a
  // top-level render — the entry that resets it is bypassed to pass the position bit.
  nomNameCycle = false
  const s = tyToNominalNameAt(m, RC_UNION_KEY)
  if s == "" { return "" }
  const t = T.tys[m]
  if t is TyFunc { return "(" + s + ")" }
  s
}

// The member sequence of an arena type, in the registry's ABI order —
// `canonUnionKeyText`'s arena-side twin. Not deduped or reordered, exactly as the text side.
// The null-fold is unwrapped with `null` first, since pass 0b folds `type J = null | A | B`
// into a one-member `TyUnion` holding a `TyNullable`, one level down from what the row records.
function canonUnionKeyTextOfTy(ty: i32): string {
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyUnion {
    const ms = t.uMembers
    if ms.length == 0 { return "" }
    if ms.length == 1 {
      const mt = T.tys[ms[0]]
      if mt is TyNullable {
        let inr = canonUnionKeyTextOfTy(mt.nInner)
        if inr == "" { inr = canonUnionKeyAtomOfTy(mt.nInner) }
        if inr != "" { return "null|" + inr }
      }
    }
    let out = ""
    let i = 0
    while i < ms.length {
      const a = canonUnionKeyAtomOfTy(ms[i])
      if a == "" { return "" }
      if i > 0 { out = out + "|" }
      out = out + a
      i = i + 1
    }
    return out
  }
  if t is TyNullable {
    // A nullable union contributes its own members before the `null` arm; a nullable scalar
    // (`i32|null`) is one atom plus it, and reaching only the first leaves the whole
    // nullable-scalar family of rows unrendered.
    let inr = canonUnionKeyTextOfTy(t.nInner)
    if inr == "" { inr = canonUnionKeyAtomOfTy(t.nInner) }
    if inr == "" { return "" }
    return inr + "|null"
  }
  ""
}

// The key for an arena type, obtained rather than rendered — the route a querier holding
// only a type takes to the row a producer minted from a spelling, closing the gap
// `canonUnionKey`'s structural render leaves. -1 when `ty` is not a union shape at all — a
// different answer from a key, since a coverage hole reading as a disagreement picks the wrong row.
export function canonUnionKeyOfTy(ty: i32): i32 {
  const text = canonUnionKeyTextOfTy(ty)
  if text.length == 0 { return -1 }
  canonUnionKeyOfName(text)
}

// The same rewrite, told the position the name occupies in the annotation around it, and
// holding no tree — every recursion into a sub-spelling enters here, since a canon arm cuts
// a substring and the parser banked a root only for the whole one.
function canonEmitNameAt(name: string, ctx: i32) {
  canonEmitNameTs(name, ctx, -1)
}

// The same rewrite, told the parser's spelling root for `name` — `canonEmitTypeNames`'s two
// rewrite sites are the only callers holding one. Consumed by exactly one arm, the
// intersection fold, since that is the only place canon still asks the checker to resolve a
// whole annotation spelling; everything else is a leaf question or a recursion with no root to hand.
function canonEmitNameTs(name: string, ctx: i32, root: i32) {
  canonAtoms = 1
  if name.length == 0 { return name }
  // A single-member union alias is transparent — render its member first, ahead of the
  // `nameNeedsCanon` early-out that would otherwise return the bare alias name unchanged.
  // Transparency doesn't move the name, so this can render at `ctx` rather than at `RC_ROOT`.
  const smt = singleMemberAliasTyIx(name)
  if smt >= 0 {
    // A declared union of declared structs renders as its member spellings, never as their
    // shapes (`declaredStructUnionMembers`), reached both from an inline `Shape | null`
    // annotation and from a `null`-inside-declaration form. Without it the structural render
    // drops the arm names, so an inline object literal falls to a global field-set scan (D1172).
    const dsu = declaredStructUnionMembers(name)
    if dsu != "" {
      canonAtoms = tyNameAtoms
      return dsu
    }
    const smr = transparentMemberEmitName(smt, ctx)
    // The emptiness guard the predecessor carried implicitly: it tested its own render for
    // "" and fell through when the member had no emit name at all. Same test, one render
    // later, so an unnameable member still reaches the arms that follow.
    if smr != "" {
      // The render's own atom width, as its producer reported it — the hand-off the
      // second renderer needs for exactly this purpose.
      canonAtoms = tyNameAtoms
      return smr
    }
  }
  // A declared alias for a numeric literal union (`type Z = 0 | 1`) denotes its base scalar
  // here, ahead of the `nameNeedsCanon` early-out that would otherwise return the bare alias
  // name untouched. Untouched, `collectU` registers it in `unNames` so `isUName` claims a
  // union box while every read lowers the plain i32 — silent invalid wasm, `vl check` clean.
  if annGenAppSpanEnds(name) {
    const gLt = gaeLtAt(name)
    const gArgs: string[] = []
    // Both cuts are `tyname.gaeHeadNameOf`/`gaeArgsTextOf`, writing both halves.
    tyTopLevelSplit(gaeArgsTextOf(name, gLt), ',', false, gArgs)
    let gOut = gaeHeadNameOf(name, gLt) + "<"
    let gi2 = 0
    while gi2 < gArgs.length {
      if gi2 > 0 { gOut = gOut + "," }
      // An argument stands where the parameter it binds stands, a position this rewrite has
      // no way to know — `RC_ROOT` is what every other whole-annotation entry uses and what
      // the argument text arrived carrying.
      gOut = gOut + canonEmitNameAt(gArgs[gi2], RC_ROOT)
      gi2 = gi2 + 1
    }
    // An application is one atom — its separators all sit inside the `<>`. Set explicitly,
    // since the argument recursions leave their own widths behind.
    canonAtoms = 1
    return gOut + ">"
  }
  const nla = numLitUnionAliasName(name)
  if nla != "" {
    canonAtoms = 1
    return nla
  }
  if !nameNeedsCanon(name) { return name }
  // A top-level union: canon each member and collapse duplicates (a mixed-base union keeps
  // each softened member). A top-level function type is not a union — its `=>` binds looser
  // than `|`, so `(i32) => A | B` is a function returning a union, left for the
  // function-type pass-through, not split here.
  if nameHasPipe(name) && !isTopLevelFuncTypeName(name) {
    const parts: string[] = []
    tyTopLevelSplit(name, '|', false, parts)
    // The subsumed-arm collapse, ahead of every other arm — the mirror of where
    // `annUnionInnerTy` puts it: `K | string | null` is `string?` exactly as `K | string`
    // is `string`, so the `| null` preserve must not claim it first. Re-enters on the
    // survivors (D1048).
    const dsKept: string[] = []
    if canonDropSubsumedParts(parts, dsKept) {
      let dsJoin = dsKept[0]
      let dsI = 1
      while dsI < dsKept.length {
        dsJoin = dsJoin + "|" + dsKept[dsI]
        dsI = dsI + 1
      }
      return canonEmitNameTs(dsJoin, ctx, -1)
    }
    // A nullable literal-union (`K | null`) keeps its litunion members — see `nulLitUnionPreserve`.
    const nlu = nulLitUnionPreserve(parts, ctx)
    if nlu != "" {
      canonAtoms = nluAtoms
      return nlu
    }
    // A pure literal union (`"a" | "b"`) keeps its members too, exactly as the `| null`
    // sibling does. Without this every member softens to `string` and dedups to one base
    // scalar, so an inline spelling names a `string` while its `K` alias spelling keeps the
    // litunion name — two spellings of one type carrying two reps.
    const lup = litUnionPreserve(parts)
    // …and a preserve whose answer is a declared alias name is kept at every position
    // (`ctxKeepsLitUnion`): an ungated preserve reddens a bare inline litunion spelling as a
    // function param or struct field, whose valtype ladders have an arm for the alias name
    // and none for the inline spelling. Also required since `annUnionInnerTy` gives `K | K2` the alias's own arena index.
    if lup != "" {
      const lupAlias = !nameHasPipe(lup)
      if ctxKeepsLitUnion(ctx) || lupAlias {
        canonAtoms = lupAtoms
        return lup
      }
    }
    const kept: string[] = []
    // The mixed-union literal-run regroup, on the annotation side: `tyToNameGo`'s union
    // arm spells a mixed union's string-literal run by its registered alias (`K0 | f64` →
    // `K0|f64`); without this the same union canon'd to `string|f64` here, since a `K0`
    // member expands through `unionAliasMembers` and its pure-litunion arena type softens.
    const rgCls: i32[] = []
    const rgAlias = mixedUnionLitAliasRegroup(parts, rgCls)
    let rgDone = false
    // The position every member below is rendered at. `RC_NULLABLE` is re-derived from a
    // `null` sibling here, since the flat split has no enclosing nullable node to inherit it
    // from, and it is or'd with the inherited bit so a nested nullable union stays one.
    let memCtx = RC_UNION_MEM | (ctx & RC_NULLABLE)
    if partsHaveNull(parts) { memCtx = memCtx | RC_NULLABLE }
    // The kept members' atom counts, summed — not `kept.length`. A kept member is normally
    // one atom, but the union-alias expansion substitutes a whole rendered member set for
    // one member (`AB` → `A|B`), so `AB | null` joins to a three-atom name.
    let atoms = 0
    let i = 0
    while i < parts.length {
      // The regrouped run stands at the first literal-derived member's position and the
      // rest drops — character-for-character what the renderer's `rgDone` does over the
      // arena's members.
      if rgAlias != "" && rgCls[i] == LRP_LITS {
        if !rgDone {
          rgDone = true
          // An alias name is one identifier — one atom.
          kept.push(rgAlias)
          atoms = atoms + 1
        }
        i = i + 1
        continue
      }
      let c = canonEmitNameAt(parts[i], memCtx)
      let ca = canonAtoms
      // A union-alias member flattens into this outer union (`AB | null` → `A | B | null`):
      // a union of unions is one union, so expand the alias to its members, matching the
      // inline `(A | B) | null` form. A bare `AB` annotation has no top-level `|`, so it
      // never reaches here.
      const exp = unionAliasMembers(c)
      if exp != "" {
        c = exp
        // `unionAliasMembers` renders through `tyToEmitName`, which reports the render's
        // own atom width — the flattened member set is as wide as the alias's union.
        ca = tyNameAtoms
      }
      // A function-type member keeps grouping parens (`((i32) => i32) | null`), so the
      // rejoined name stays distinct from a function returning a nullable. `canonEmitName`
      // strips a member's own wrapping parens, so re-add them.
      if isTopLevelFuncTypeName(c) {
        c = "(" + c + ")"
        ca = 1
      }
      // Dedupe at the atom, not at the member (D1026): the alias expansion substitutes a
      // whole member set for one member, so a flattened member can hold several top-level
      // atoms — comparing whole members cannot see that `"f64|null"` and `"null"` share one.
      const cAtoms: string[] = []
      splitUnionAtoms(c, cAtoms)
      let ci2 = 0
      while ci2 < cAtoms.length {
        const cAtom = cAtoms[ci2]
        let dup = false
        let j = 0
        while j < kept.length {
          if kept[j] == cAtom { dup = true }
          j = j + 1
        }
        if !dup {
          kept.push(cAtom)
          if cAtoms.length == 1 {
            atoms = atoms + ca
          } else {
            atoms = atoms + 1
          }
        }
        ci2 = ci2 + 1
      }
      i = i + 1
    }
    let out = kept[0]
    let k = 1
    while k < kept.length {
      out = out + "|" + kept[k]
      k = k + 1
    }
    canonAtoms = atoms
    return out
  }
  // A top-level intersection: fold through `intersectTy`, then render the fold, unchanged
  // if unrenderable. The fold asks the parser's spelling tree where one is banked for
  // `name` (`annotResolve`), re-parsing only where none is. A recursion enters with `root =
  // -1` and takes the name leg unchanged.
  if (nameHasSep(name, '&')) {
    const folded = annotResolve(name, root)
    if folded >= 0 {
      // The fold stands exactly where the intersection spelling stood, so the position
      // passes straight through — `nameToTy` then render, converting by deleting a string
      // round-trip rather than inventing one.
      const r = tyToEmitNameAt(folded, ctx)
      // The fold's render carries its own width — `(0|1|2) & !2` folds to the one-atom
      // `i32`, but a fold that stays a union renders as one.
      const ra = tyNameAtoms
      if r != "" {
        canonAtoms = ra
        return r
      }
    }
    // The unchanged name: it reached here with no top-level `|` at all (the union arm
    // claims every name that has one, bar a top-level function type), so it is one atom.
    canonAtoms = 1
    return name
  }
  // A trailing `[]`: canon the element (no top-level `|`/`&` here, so the suffix binds the
  // whole core); a union element keeps its grouping parens. Not for a top-level function
  // type (`(i32) => i32[]`) — there the `[]` binds the return type, so it is a function
  // returning a list, handled by the function-type pass-through, not an array of functions.
  const arrCore = arrElemNameRaw(name)
  if arrCore != "" && !isTopLevelFuncTypeName(name) {
    const core = canonEmitNameAt(arrCore, RC_ELEM)
    // The element's own atom width, as the element's producer reported it. A wide element
    // (more than one top-level atom) is exactly a union element.
    const coreAtoms = canonAtoms
    // A list name is one atom in every form — a union element is parenthesized so its
    // `|`s stop being top-level. Set explicitly, since the element recursion leaves its
    // width in `canonAtoms`.
    canonAtoms = 1
    // A union element (`(A|B)[]`) or a function-type element (`((i32) => i32)[]`, distinct
    // from `(i32) => i32[]`) keeps grouping parens; `canonEmitName` strips a member's own
    // wrapping parens, so re-add them. Width and `nameHasPipe` disagree on exactly one
    // shape — a function type whose result is a union — but that shape is claimed by the second test first.
    if coreAtoms > 1 { return "(" + core + ")[]" }
    if isTopLevelFuncTypeName(core) { return "(" + core + ")[]" }
    return core + "[]"
  }
  // A parenthesized group wrapping the whole (no top-level `|`/`&`/`[]` left): strip and
  // canon the inside. Not for a top-level function type whose return is parenthesized
  // (`(i32) => ((i32) => i32)`) — its leading `(` wraps only the param list, so a blind
  // strip corrupts it; such a name keeps its top-level arrow instead.
  if nameIsParenSpanEnds(name) && !isTopLevelFuncTypeName(name) {
    // A grouper is not a position: `(X)` stands wherever `X` would, so the ctx rides
    // through the strip.
    return canonEmitNameAt(groupInnerOf(name), ctx)
  }
  // A top-level function type — any one: canon the param list and the result, re-render
  // with the result's grouping parens when it is itself a function. Leaving the interior
  // verbatim forks the two spellings of one closure, since `annRetKind` would make the
  // `$fnsig` result a union box while the declaration's own softened annotation stays a scalar.
  if isTopLevelFuncTypeName(name) {
    // The arrow index the guard just scanned for, not a second scan of the same name for
    // the same position — nothing runs between the predicate's return and this read.
    // Both cuts are `tyname.fnParamsTextOf`/`fnRetTextOf`, given that banked index.
    const fa = funcArrowAt
    const psStr = fnParamsTextOf(name, fa)
    let out = "("
    if psStr.length > 0 {
      const parts: string[] = []
      tyTopLevelSplit(psStr, ',', false, parts)
      let pi = 0
      while pi < parts.length {
        if pi > 0 { out = out + "," }
        out = out + canonEmitNameAt(parts[pi], RC_FN_PARAM)
        pi = pi + 1
      }
    }
    let rc = canonEmitNameAt(fnRetTextOf(name, fa), RC_FN_RES)
    if isTopLevelFuncTypeName(rc) { rc = "(" + rc + ")" }
    // A function type is one atom (params parenthesized, result behind the top-level `=>`
    // where `unionMemberCount` stops). Set explicitly, since the param/result recursions
    // leave their own widths behind.
    canonAtoms = 1
    return out + ")=>" + rc
  }
  // A literal member — its base scalar, rendered from the arena rather than by a second
  // spelling rule. Its dual is the checker's own `softenLitTy`; canon lacked a way to get
  // an arena type at a leaf, which `litMemberTy` now supplies. Total here, since
  // `softenLitTy` of a `TyLit` is never `never`, the only prim this renderer has no name for.
  const lmt = litMemberTy(name)
  if lmt >= 0 {
    const lbn = tyToEmitNameAt(softenLitTy(lmt), ctx)
    // A softened literal is a base scalar — one atom. Set explicitly, since the render
    // leaves its own width behind in `tyNameAtoms`.
    canonAtoms = 1
    return lbn
  }
  // A residual negation (only meaningful under `&`) — leave for the emitter.
  if name[0] == '!' { return name }
  // An inline `{…}` shape: canon its field/value types. The wide brace-endpoint span at its
  // home in `tyname.vl` is deliberately wide, since `canonShapeName` also handles a map name
  // (on `{[`), so a tighter test would leave a map's value type un-canonicalized.
  if nameIsBraceSpanEnds(name) {
    const shp = canonShapeName(name)
    // Every separator sits inside the braces — one atom. Set explicitly, since the field
    // recursions inside `canonShapeName` leave their own widths behind.
    canonAtoms = 1
    return shp
  }
  name
}

// Banks every annotation node inside a generic declaration with the name it carries right
// now, before the rewrite loop runs, so the banked spelling is the declared one. A generic
// alias's field annotations and a generic function's parameter/return annotations share the
// bank and reader, since both ask what this annotation said before canon resolved it.
function collectGenAliasFieldAnns() {
  cgpFieldNodes = []
  cgpFieldRaw = []
  let gi = 0
  while gi < gaNames.length {
    const decl = P.nodes[gaDeclIxs[gi]]
    if decl is TypeDecl {
      const fields = decl.tdFields
      let fi = 0
      while fi < fields.length {
        // The parser's bodyless sentinel is `tdFields == [-1]`; skip it rather than index
        // the arena with it.
        if fields[fi] >= 0 {
          const fnode = P.nodes[fields[fi]]
          if fnode is FieldDef {
            if fnode.fdType >= 0 {
              const tr = P.nodes[fnode.fdType]
              if tr is TypeRef {
                cgpFieldNodes.push(fnode.fdType)
                cgpFieldRaw.push(tr.tyName)
              }
            }
          }
        }
        fi = fi + 1
      }
    }
    gi = gi + 1
  }
  // The generic-function half: every `<T>`-carrying `FuncDecl`'s parameter and return
  // annotations. Signature only — a `LetDecl` in the body carries the same hazard and is
  // not banked here, since the only consumers today are the parameter and return pins.
  let fx = 0
  while fx < P.nodes.length {
    const fnd = P.nodes[fx]
    if fnd is FuncDecl {
      if fnd.fnTyParams.length > 0 {
        const ps = fnd.fnParams
        let pi = 0
        while pi < ps.length {
          const pnd = P.nodes[ps[pi]]
          if pnd is Param {
            if pnd.parType >= 0 {
              const ptr = P.nodes[pnd.parType]
              if ptr is TypeRef {
                cgpFieldNodes.push(pnd.parType)
                cgpFieldRaw.push(ptr.tyName)
              }
            }
          }
          pi = pi + 1
        }
        if fnd.fnRet >= 0 {
          const rtr = P.nodes[fnd.fnRet]
          if rtr is TypeRef {
            cgpFieldNodes.push(fnd.fnRet)
            cgpFieldRaw.push(rtr.tyName)
          }
        }
      }
    }
    fx = fx + 1
  }
  0
}

// The declared spelling of the annotation at `nodeIx`, or "" when `nodeIx` is not a banked
// one. The emitter's route back to a type-parameter name that alias transparency (or
// numeric-literal-union softening) resolved out of the arena.
export function declAnnRawTyName(nodeIx: i32) {
  let i = 0
  while i < cgpFieldNodes.length {
    if cgpFieldNodes[i] == nodeIx { return cgpFieldRaw[i] }
    i = i + 1
  }
  ""
}

// The post-check sweep: rewrites every `TypeRef` annotation and every `UnionDecl` variant
// name in the arena, once at the end of `checkProgram` — the same arena `emitProgram` sees.
// Asks directly whether a node's recorded type still describes its spelling, rather than
// through `annTs`, since canon is not a rename and a surviving tree is not a reliable signal either way.
let canonCleared: i32[] = []

// The arena type each rewritten node's new spelling denotes, parallel to `canonCleared`.
// `nodeTyIx` is untouched, so no existing consumer changes; the only reader is the
// emitter's collect-site gate.
export let canonTyIxCol: i32[] = []

export function canonTyIxOf(ix: i32): i32 {
  let lo = 0
  let hi = canonCleared.length - 1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = canonCleared[mid]
    if at == ix { return canonTyIxCol[mid] }
    if at < ix { lo = mid + 1 } else { hi = mid - 1 }
  }
  -1
}

// Did `canonEmitTypeNames` rewrite node `ix` in place (and drop its spelling tree)?
export function canonRewroteNode(ix: i32): boolean {
  let lo = 0
  let hi = canonCleared.length - 1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const at = canonCleared[mid]
    if at == ix { return true }
    if at < ix { lo = mid + 1 } else { hi = mid - 1 }
  }
  false
}

export function canonEmitTypeNames() {
  // Reset with `annUnionAtoms`, for the same reason: a second program on this instance
  // must not inherit the first one's node indices.
  canonCleared = []
  canonTyIxCol = []
  annUnionAtoms = []
  // Before the rewrite loop — the bank holds the declared spellings, which is the whole
  // point of it.
  collectGenAliasFieldAnns()
  let i = 0
  while i < P.nodes.length {
    // The atom-count bank: one entry pushed per node, in node order, so the column is
    // exactly `P.nodes.length` long and index == node index. A non-`TypeRef` node banks -1;
    // a `TypeRef` banks the count `canonEmitName` reported directly, not re-derived by
    // scanning the finished string. Pushing, not pre-sizing, makes the reset load-bearing.
    let atoms = -1
    const n = P.nodes[i]
    if n is TypeRef {
      // This site holds the parser's root for the spelling it is about to rewrite, so it
      // hands it over instead of leaving the intersection fold — the one arm that still
      // takes a whole annotation apart — to re-parse it. Read before the rewrite.
      const c = canonEmitNameTs(n.tyName, RC_ROOT, annTsOf(i))
      // The rewrite invalidates the parser's spelling tree for this node: canon is not a
      // rename, so a tree kept past it would describe a different type, not a different
      // spelling of the same one. Dropped before the assignment so the two never disagree.
      if c != n.tyName {
        clearAnnTs(i)
        canonCleared.push(i)
        canonTyIxCol.push(nameToTy(c))
        n.tyName = c
      }
      atoms = canonAtoms
    } else if n is UnionDecl {
      const vs = n.udVariants
      let vi = 0
      while vi < vs.length {
        // A member spelling is banked on this node in member order (`setUdTs`), so the
        // intersection fold reads the member's own tree rather than re-parsing the
        // concatenation — the same read `checkProgram`'s union registration already makes.
        let c2 = canonEmitNameTs(vs[vi], RC_ROOT, udTsRootAt(i, vi))
        // A generic-alias application member of a multi-member union resolves to its
        // structural shape (`unionMemberGenAppShape`), since the emitter has no route to it
        // under the application name. A one-member union is excluded: that alias is already
        // transparent on both sides, and expanding it here would double-register the shape.
        if vs.length >= 2 {
          const gs = unionMemberGenAppShape(c2)
          if gs != "" { c2 = gs }
        }
        // …and the rewrite drops that root too (`ast.clearUdTs`, `clearAnnTs`'s twin over
        // the member table).
        if c2 != vs[vi] {
          clearUdTs(i, vi)
          vs[vi] = c2
        }
        vi = vi + 1
      }
    } else if n is IsExpr {
      // `u is Box<i32>` against a union operand: the union's own member rewrites to its
      // structural shape, so the tested name must follow or the emitter resolves no
      // variant. Gated on the operand's type being a `TyUnion` (a nullable is excluded); the
      // same repair applies to a transparent one-member alias, where a stale `is L` names none.
      const opTy = nodeTyIxOf(n.isObj)
      if opTy >= 0 {
        const ot = T.tys[opTy]
        if ot is TyUnion {
          const gis = unionMemberGenAppShape(n.isVariant)
          if gis != "" { n.isVariant = gis }
          const sit = singleMemberAliasTyIx(n.isVariant)
          if sit >= 0 {
            const sir = transparentMemberEmitName(sit, RC_ROOT)
            if sir != "" { n.isVariant = sir }
          }
          // …and the application rewrite runs after the transparency render too, since the
          // member arm applies the two in that order: a member spelled `Y` for `type Y =
          // Box<i32>` lands in `uVariants` as `{v:i32}`, so the `is` test must travel the
          // same two rungs or it names `Box<i32>` against a variant table holding `{v:i32}`.
          const gis2 = unionMemberGenAppShape(n.isVariant)
          if gis2 != "" { n.isVariant = gis2 }
        }
      }
    } else if n is AsExpr {
      // `x as W` where `W` is a user alias of a numeric scalar (`type W = f64`). Four emit
      // consumers compare this string to the four primitive spellings, so an alias fell
      // through every one and the cast emitted invalid wasm for i64/f32/f64 targets. Not
      // re-derived from the string: `checkCastNode` already banked the checked type on this node.

      // `u8` keeps its spelling: `x as u8` types as `i32`, so canonicalizing the string
      // would lose the cast's domain and the emitter would lower a full-width narrowing
      // with no 0..255 test. It is a range inside `i32`, not an alias of it (D1587).
      const at = primNameOf(nodeTyIxOf(i))
      const atCanon = at == "i32" || at == "i64" || at == "f32" || at == "f64"
      if n.asTy != "u8" && atCanon {
        // `n.asTy` is the author's spelling, a plain string on the node, so the atom is
        // materialized here rather than the node's field changing type.
        const ats = primNameStr(at)
        if ats != n.asTy { n.asTy = ats }
      }
    }
    annUnionAtoms.push(atoms)
    i = i + 1
  }
  0
}

// ── value-comparability: may `ty` be compared with the default structural `==`? ──
// Sound only when every component is itself value-comparable: a function field compares by
// reference and does not make its object non-equatable; an array is equatable iff its
// element is, an object iff all fields are. A non-discriminated union, nullable or map field is not.
function isEquatable(ty: i32, seen: i32[]) {
  if ty < 0 { return true }
  const t = T.tys[ty]
  if t is TyPrim {
    // Every scalar primitive (incl. string, bool) is value-comparable; `void`/`null`
    // never reach a structural compare (a nullness test short-circuits earlier).
    return true
  }
  if t is TyErr { return true }
  if t is TyVar { return true }
  if t is TyFunc { return true }
  if t is TyArray { return isEquatable(t.aElem, seen) }
  if t is TyObj {
    let si = 0
    while si < seen.length {
      if seen[si] == ty { return true }
      si = si + 1
    }
    seen.push(ty)
    const ftys = t.objFieldTypes
    let i = 0
    let ok = true
    while i < ftys.length {
      if !isEquatable(ftys[i], seen) { ok = false }
      i = i + 1
    }
    seen.pop()
    return ok
  }
  // A literal union is value-comparable: `type K = "a" | "b"` reps as one interned i32 atom
  // and `type N = 1 | 2` as its base scalar — a single cell with nothing to be
  // non-comparable about (D45). Narrower than the `+` home's predicate, which also accepts
  // a mixed-base union (a value-union box, not one cell). An i32-sentinel nullable is value-comparable the same way (D101).
  if t is TyNullable {
    if tyIsI32SentinelNullable(ty) { return true }
    // Every other `T | null` is comparable exactly when `T` is: `null == null` is true,
    // one-sided null is false, otherwise it is `T`'s own compare — nothing needs
    // discriminating first. A genuinely undefined inner still refuses through the
    // recursion: a map, a struct union, a mixed-base union (D1180).
    return isEquatable(t.nInner, seen)
  }
  // The emitter-capability half is separate: `eqCmpKindOfArrayElem` decides whether a list
  // of these has a compare core (an i64/f64-based numeric union has none). This gate
  // answers only the soundness question.
  if t is TyUnion {
    if tyUnionIsOneLitCell(ty) { return true }
    // The expanded sentinel spelling — `"a" | "b" | null` written inline or through an
    // alias is a `TyUnion` with a null member rather than a `TyNullable`, and it is the
    // same one i32 cell. An un-annotated `["a", null]` is not this shape (it infers as
    // `string | null`, the ref niche).
    if tyIsI32SentinelNullable(ty) { return true }
  }
  // A single literal type (`type S = "a"`) reps as its base scalar, so it is
  // value-comparable for the same reason its union is, and cannot be mixed-base since it
  // has one member.
  if t is TyLit { return true }
  // TyUnion / TyNullable / TyMap: not structurally value-comparable.
  false
}

// —— `==`/`!=` lowerability: the one home for "can these operands be compared, and how" ——
// `isEquatable` answers whether an object/array's components are value-comparable, a
// soundness rule; this answers which compare core, if any, exists for the operand's own
// rep. "" is opaque; "none" is no lowering; a bare name is a non-null core; `nul*` is a ref niche running that core under a null guard.
export function eqCmpKindOfTy(ty: i32): EqCmpKind {
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyPrim {
    if t.primName == "string" { return "str" }
    // `void` / `null` / `never` never reach a value compare — a null test decides first.
    return "scalar"
  }
  if t is TyErr { return "" }
  if t is TyVar { return "" }
  if t is TyNeg { return "" }
  if t is TyLit { return "" }
  if t is TyFunc { return "closure" }
  if t is TyObj { return "struct" }
  if t is TyMap { return "none" }
  if t is TyArray { return eqCmpKindOfArrayElem(t.aElem) }
  if t is TyNullable { return eqCmpKindOfNulInner(t.nInner) }
  if t is TyUnion {
    // A declared nullable alias (`type L = i32[] | null`) resolves through `UnionDecl` and
    // lands here as `TyUnion[i32[], null]`, while the inline spelling is a `TyNullable` —
    // the same rep, two arena shapes. Both must reach the niche answer.
    const uInner = unionSoleNonNullMember(ty)
    if uInner >= 0 { return eqCmpKindOfNulInner(uInner) }
    return ""
  }
  ""
}

// The single non-null member of a two-member `X | null` union, or -1 when `ty` is not that
// shape (a wider value union, or one with no `null` member).
function unionSoleNonNullMember(ty: i32) {
  const t = T.tys[ty]
  if t is TyUnion {
    if t.uMembers.length != 2 { return -1 }
    if isNullTy(t.uMembers[0]) { return t.uMembers[1] }
    if isNullTy(t.uMembers[1]) { return t.uMembers[0] }
  }
  -1
}

// Every member of the union at `ty` is a literal and they all share one backing — the
// single cell an `==` compares. Two shapes qualify: an all-string union (interned i32
// atoms) and an all-numeric one (one base scalar). Wider than `tyLitUnionIsI32Backed`,
// which is the lowering question and cares which scalar it is. `type M = "a" | 1` fails both — a value-union box, not one cell (D45).
function tyUnionIsOneLitCell(ty: i32) {
  if tyIsLitUnion(ty) { return true }
  numLitUnionHasBase(ty)
}

// The `==` token for an array whose element type is `elem`. The emitter has exactly three
// list-compare cores, so this is a closed list and every other element rep is "none". A
// hole element (`-1`) takes the i32 core, matching `exprArray`'s empty-literal
// classification. Deliberately the tighter mirror of `eqgStructElemFlat`, so a disagreement is a refusal, never an invalid module.
function eqStructElemFlatTy(ty: i32, depth: i32): boolean {
  if ty < 0 { return false }
  if depth > 8 { return false }
  const t = T.tys[ty]
  if t is TyObj {
    const ftys = t.objFieldTypes
    // A fieldless struct is not admitted. Its compare is a constant 1, correct — but "no
    // fields" is also what an unresolved shape looks like from here.
    if ftys.length == 0 { return false }
    let i = 0
    let ok = true
    while i < ftys.length {
      if !eqStructFieldFlatTy(ftys[i], depth + 1) { ok = false }
      i = i + 1
    }
    return ok
  }
  false
}

// One field of a flat record: a native scalar, or a nested struct that is itself flat.
function eqStructFieldFlatTy(ty: i32, depth: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyPrim {
    if t.primName == "i32" { return true }
    if t.primName == "boolean" { return true }
    if t.primName == "f64" { return true }
    return false
  }
  if t is TyObj { return eqStructElemFlatTy(ty, depth) }
  false
}

function eqCmpKindOfArrayElem(elem: i32): EqCmpKind {
  if elem < 0 { return "list" }
  const e = T.tys[elem]
  if e is TyVar { return "" }
  if e is TyErr { return "" }
  if e is TyPrim {
    if e.primName == "i32" { return "list" }
    if e.primName == "boolean" { return "list" }
    if e.primName == "string" { return "strlist" }
    // The wide-scalar backings: `f64[]`, `i64[]`, `f32[]` and `u8[]` are one wasm array of
    // one scalar each, exactly as `i32[]` is — lacking only a core, since
    // `emitListEqICore` is hard-wired to `i32.ne`. `emitListEqGCore` takes the wrapper,
    // backing and opcode as arguments, so the element axis decides only with what (D751).
    if e.primName == "f64" { return "glist" }
    if e.primName == "i64" { return "glist" }
    if e.primName == "f32" { return "glist" }
    if e.primName == "u8" { return "glist" }
    return "none"
  }
  if e is TyArray {
    const ie = e.aElem
    if ie < 0 { return "reflist" }
    const i2 = T.tys[ie]
    // A hole one hop down is unanswered, not refused — this arm answered "none" while the
    // element arm one level up answers "" for the same `TyVar`, a false reject:
    // `function eqT<T>(a: T[][], b: T[][])` at `T = i32` refused naming a type variable to a
    // caller who wrote neither. "" defers to the pin, where the substituted type lives (D422).
    if i2 is TyVar { return "" }
    if i2 is TyErr { return "" }
    if i2 is TyPrim {
      if i2.primName == "i32" { return "reflist" }
      if i2.primName == "boolean" { return "reflist" }
    }
    // `K[][]` is a ref list of i32 lists — the same shape `i32[][]` is, since the atom /
    // i32-base backing makes the inner `K[]` that very list. Asked with the same two tests as `i32`/`boolean`.
    if i2 is TyUnion {
      if tyLitUnionIsI32Backed(ie) { return "reflist" }
      // The expanded `("a" | "b" | null)[][]` spelling, whose inner element is a `TyUnion`
      // with a null member rather than a `TyNullable`.
      if tyIsI32SentinelNullable(ie) { return "reflist" }
    }
    // `(K | null)[][]` and `(boolean | null)[][]` are ref lists of i32 lists for the same
    // reason `K[][]` is — the sentinel niche makes the inner list that very i32 list (D101).
    if i2 is TyNullable {
      if tyIsI32SentinelNullable(ie) { return "reflist" }
    }
    // Every other nested list, by recursion: the arms above cover exactly the shapes
    // `emitListEqRCore` happens to handle, a ref list whose element is an i32 list.
    // Everything else nested answers "none" for no reason but that. Asked of `ie`, not of `e`:
    // `e` here is the element `ie[]`, so what decides a list of `e` is whether `e` itself can be compared.
    const inner = eqCmpKindOfArrayElem(ie)
    if inner == "" { return "" }
    if inner != "none" { return "glist" }
    return "none"
  }
  // An i32-sentinel nullable element rides the same i32 list its base does (D101):
  // `tyScalarBackedListKind` has answered `"list"` for `K[]`, `(K | null)[]` and
  // `(boolean | null)[]` all along. The box- and ref-niche nullables stay "none". A struct
  // element, field-wise, is the flat subset D752 answers.
  if e is TyObj {
    if eqStructElemFlatTy(elem, 0) { return "glist" }
    return "none"
  }
  if e is TyNullable {
    if tyIsI32SentinelNullable(elem) { return "list" }
    return "none"
  }
  // A literal-union element rides the same i32 list `i32[]`/`boolean[]` do — a string union
  // as its interned atom id, a numeric one as its base scalar — so `emitListEqICore` is its
  // core (D45). Only the `i32` base rides that list; an `i64`/`f64` base rides its own
  // wrapper with no core. No `f32` arm, and it is unreachable: `litBaseTy` never answers `f32`.
  if e is TyUnion {
    if tyLitUnionIsI32Backed(elem) { return "list" }
    // The expanded `("a" | "b" | null)[]` spelling of the sentinel niche (D101).
    if tyIsI32SentinelNullable(elem) { return "list" }
    // A numeric literal union on a wide base reps as that base's list, and now has that
    // base's core: `type F = 1.5 | 2.5` is one f64 cell per element and `F[]` is the f64
    // list — the honest half stays, though: a mixed-base union is a value-union box, not one cell (D751).
    if numLitUnionHasBase(elem) { return "glist" }
    return "none"
  }
  "none"
}

// The `==` token for a nullable `inner | null`. The box- and sentinel-repped nullables
// answer "" (already correct on every runtime input, comparing tag-first); every remaining
// nullable is a `(ref null …)` niche, needing the null guard only when its non-null rep has a core.
function eqCmpKindOfNulInner(inner: i32): EqCmpKind {
  if inner < 0 { return "" }
  const it = T.tys[inner]
  if it is TyPrim {
    if it.primName == "string" { return "nulstr" }
    return ""
  }
  if it is TyLit { return "" }
  if it is TyUnion { return "" }
  if it is TyErr { return "" }
  if it is TyVar { return "" }
  if it is TyNeg { return "" }
  if it is TyNullable { return eqCmpKindOfNulInner(it.nInner) }
  if it is TyFunc { return "nulclosure" }
  if it is TyObj { return "nulstruct" }
  if it is TyMap { return "none" }
  if it is TyArray {
    const ak = eqCmpKindOfArrayElem(it.aElem)
    if ak == "list" { return "nullist" }
    if ak == "strlist" { return "nulstrlist" }
    if ak == "reflist" { return "nulreflist" }
    // The generic list core under the same null guard. Named here rather than falling
    // through as `"glist"`, since `eqKindIsNulNiche` reads this token to decide whether the
    // compare gets a guard at all — a nullable reaching the plain path would recover with
    // `ref.as_non_null`, a trap on the very null the compare answers for.
    if ak == "glist" { return "nulglist" }
    return ak
  }
  ""
}

// The `==` lowering token for the value AST node `ix` reads — `eqCmpKindOfTy` of the type the
// checker banked for it. The emitter's whole view of the comparability question.
export function nodeEqCmpKind(ix: i32): EqCmpKind {
  eqCmpKindOfTy(nodeTyIxOf(ix))
}

// One `eqCmpKindOfTy` token → its compare core. The nullable niche and its non-null base
// share a core by construction, so both map to one number; a token with no core of its own
// is -1. Moved here from `emit_classify` so the checker and the emitter read one map instead
// of two guesses about "which core".
export function eqCoreKindOfTyToken(k: EqCmpKind) {
  if k == "list" || k == "nullist" { return 0 }
  if k == "strlist" || k == "nulstrlist" { return 3 }
  if k == "reflist" || k == "nulreflist" { return 4 }
  if k == "glist" || k == "nulglist" { return 7 }
  if k == "str" || k == "nulstr" { return 5 }
  if k == "closure" || k == "nulclosure" { return 6 }
  -1
}

// —— is this `==` refusal a map, i.e. a domain rule rather than a missing lowering? ——
// True when the reason `eqCmpKindOfTy` answered "none" is a map, is nullable/`| null` over
// one, or a list bottoming out at one. This is that domain rule, not a gap: a VL map's
// insertion order is observable, so structural `==` must choose order-sensitive vs set-like, neither a lowering question.
function tyEqNoneIsMap(ty: i32, depth: i32): boolean {
  if ty < 0 { return false }
  if depth > 8 { return false }
  const t = T.tys[ty]
  if t is TyMap { return true }
  if t is TyNullable { return tyEqNoneIsMap(t.nInner, depth + 1) }
  if t is TyArray { return tyEqNoneIsMap(t.aElem, depth + 1) }
  if t is TyUnion {
    const inner = unionSoleNonNullMember(ty)
    if inner >= 0 { return tyEqNoneIsMap(inner, depth + 1) }
  }
  false
}

// —— the one home for "may these two operands be `==`/`!=`, and if not, what do we say" ——
// Two gates, in order: the structural soundness gate (`isEquatable`) and the
// emitter-capability gate (`eqCmpKindOfTy`); both refusals are appended. A function, not two
// inline gates, since `binOpDefinedFor`/`validateBinCstrs` ask the same question at the call site (D35).
export function eqRefusals(
  op: string,
  lt: i32,
  rt: i32,
  structural: boolean,
  msgs: string[],
  unsup: i32[],
) {
  // How many sentences the soundness gate produced, so the capability gate below can tell
  // whether a map operand has already been spoken for. Two sentences about one design rule
  // read as two separate problems.
  const msgsBefore = msgs.length
  if structural && lt >= 0 {
    const lT = T.tys[lt]
    let isStruct = false
    if lT is TyObj { isStruct = true }
    else if lT is TyArray { isStruct = true }
    if isStruct {
      const seen: i32[] = []
      if !isEquatable(lt, seen) {
        // The remedy clause names something that exists: naming an unimplemented operator
        // changed nothing, since the declaration parsed and got discarded. `==` is now
        // refused at the declaration itself, so the two sentences have to agree or the trap
        // has only moved (D46).
        msgs.push(
          tyToStr(lt) +
            " isn't equatable (a field is not value-comparable) — compare a projection whose components are value-comparable, and only one that no two distinct values share",
        )
        unsup.push(0)
      }
    }
  }
  // A null test is exempt — it is not a value compare, and `emitNulIsNullTest` owns it for
  // every rep.
  if !isNullTy(lt) && !isNullTy(rt) {
    const eqLk = eqCmpKindOfTy(lt)
    const eqRk = eqCmpKindOfTy(rt)
    if eqLk == "none" || eqRk == "none" {
      let eqBad = lt
      if eqLk != "none" { eqBad = rt }
      if tyEqNoneIsMap(eqBad, 0) {
        // A map: the domain rule, off the unsupported-lowering channel, said once — the
        // soundness gate already says it for the container spelling, and this is the bare
        // one it could not reach.
        if msgs.length == msgsBefore {
          msgs.push(
            tyToStr(eqBad) +
              " isn't equatable — a map has no defined value equality: its entries are insertion-ORDERED and observable that way (`for k in m`, `m.keys()`), so `==` would have to pick between order-sensitive and set-like and neither is what both callers mean — compare `m.size`, or the values at the keys you name",
          )
          unsup.push(0)
        }
      } else {
        msgs.push("`" + op + "` over " + tyToStr(eqBad) + " has no lowering")
        unsup.push(1)
      }
    } else {
      // The pair, not each operand: both answering a token is not the same as both
      // answering the SAME token. `emitEqNonNullCore` runs one core chosen from the left
      // operand, falling back to the right, so a mutually assignable pair whose reps take
      // two different cores lowers one over the other's storage — check-clean invalid wasm without this (D45).
      const eqLc = eqCoreKindOfTyToken(eqLk)
      const eqRc = eqCoreKindOfTyToken(eqRk)
      if eqLc >= 0 && eqRc >= 0 && eqLc != eqRc {
        msgs.push(
          "`" +
            op +
            "` over " +
            tyToStr(lt) +
            " and " +
            tyToStr(rt) +
            " has no lowering: the two are mutually assignable but store their elements " +
            "differently, and one compare core cannot read both — compare two values of the " +
            "same type, or convert one container to the other's element type first",
        )
        unsup.push(1)
      }
    }
  }
  0
}

// —— the one home for "is this `+` a list concat", the `+` twin of the `==` home above ——
// The element axis does not decide a concat: `emitListConcatG` allocates one backing and
// moves storage with two `array.copy`s, needing only the `{backing, len, cap}` wrapper every
// list rep has. An emitter floor (`binConcatRepUnresolved`) replaced the old element refusal (D721).
export function binPlusIsListByTy(lt: i32, rt: i32) {
  // Bound-checked before the arena read, since the emitter floor hands it an index
  // documented to be absent: `nodeTyIxOf` answers -1 for a node the checker banked nothing
  // on, and `T.tys[-1]` is an out-of-bounds read — a compiler trap with no diagnostic.
  if (lt < 0 || rt < 0) { return false }
  const lA = T.tys[lt]
  if lA is TyArray {
    const rA = T.tys[rt]
    if rA is TyArray { return true }
  }
  false
}

// —— structural assignability: is `src` assignable to `dst`? ——
// The error type is assignable both ways (so one failure doesn't cascade). An object is
// assignable when it has at least every target field, each assignable (width + depth
// subtyping); a union source needs every member assignable, a union target needs some member to accept it.
function fnSlotAssignable(src: i32, dst: i32) {
  if numWidens(src, dst) { return false }
  if objNumWidens(src, dst) { return false }
  if containerElemClassDiffers(src, dst) { return false }
  if fnSlotNulDiffers(src, dst) { return false }
  assignable(src, dst)
}

// The half of a function slot's valtype `elemStoreClassOf` deliberately does not carry:
// nullability. `(ref null $str)` and `(ref $str)` are different wasm valtypes, so a
// `$fnsig` built at one is not the `$fnsig` a call site built at the other — the slot asks
// this extra question rather than changing what the shared classifier means for arrays and maps.
function fnSlotNulDiffers(src: i32, dst: i32) {
  if elemStoreClassOf(src, 8) == ESC_UNKNOWN { return false }
  if elemStoreClassOf(dst, 8) == ESC_UNKNOWN { return false }
  tyBearsNull(src) != tyBearsNull(dst)
}

// A struct type with a numerically wider field on the destination side (`{f: i32}` vs
// `{f: i64}`): assignable as a value (construction converts at the field store) but not as
// a function-type slot, since a function value's functype fixes the field rep. The object
// dual of the scalar invariance in `fnSlotAssignable`; a literal still works, since the checker adopts the wider field type for a literal.
function objNumWidens(src: i32, dst: i32) {
  if src < 0 || dst < 0 { return false }
  const s = T.tys[src]
  const d = T.tys[dst]
  if s is TyObj {
    if d is TyObj {
      let i = 0
      while i < d.objFieldNames.length {
        const sf = objFieldType(s, d.objFieldNames[i])
        if sf >= 0 {
          if numWidens(sf, d.objFieldTypes[i]) { return true }
          if objNumWidens(sf, d.objFieldTypes[i]) { return true }
        }
        i = i + 1
      }
    }
  }
  false
}

// The object pair the last `objShapeAdapterless` walk stopped on. Entered with the pair the
// author wrote (`Cat[]` into `Animal[]`) while the reason lives at a nested pair (`Cat` into
// `Animal`); the diagnostic names both, so the container is never mistaken for the unsupported thing.
let shapeAdaptSrcTy = -1
let shapeAdaptDstTy = -1
// The source expression of that same stopped-on pair, `(…)`-peeled — banked beside the two
// types since the walk is entered on the expression the author wrote while the pair lives
// one or more containers in. `{ pet: aCat }` into `{pet: Animal}` has a claimed pair that is
// a pinned `Cat` field value; reading the outer expression would get it backwards.
let shapeAdaptSrcExpr = -1
// Which rule claimed the stopped-on pair: the object-shape one (false) or the
// container-element storage-class one (true). They need different wordings, and the pair
// banked above does not say which on its own.
let shapeAdaptElemPair = false
// The claimed pair is a nested width pair (agreeing field names, differing inside a field)
// — selects the design-refusal wording instead of a capability concession (D938).
let shapeAdaptWidthField = false

// The expression at `ix` with `(…)` peeled — the syntactic form, for the constructor
// exemption in `objShapeAdapterless`. -1 stays -1.
function ctorExprOf(ix: i32) {
  let cur = ix
  let peel = true
  while peel {
    if cur < 0 { return -1 }
    const e = P.nodes[cur]
    if e is Paren { cur = e.parInner } else { peel = false }
  }
  cur
}

// Whether every field name of `dst` is a field name of `src` and the two have the same
// field count — the shapes agree on which fields exist, whatever their order or types. The
// emitter can rebuild a value field-by-field exactly when this holds.
function objFieldNameSetsEq(src: i32, dst: i32): boolean {
  const s = T.tys[src]
  const d = T.tys[dst]
  if s is TyObj {
    if d is TyObj {
      if s.objFieldNames.length != d.objFieldNames.length { return false }
      let i = 0
      while i < d.objFieldNames.length {
        if objFieldType(s, d.objFieldNames[i]) < 0 { return false }
        i = i + 1
      }
      return true
    }
  }
  false
}

// The wasm element storage class a container's element (or map key/value) type lowers to.
// Two element types in different classes make two unrelated container wasm types, so there
// is no element-converting copy to insert; widening is free whenever the class holds (a ref
// or niche-nullable element costs nothing), but a class change has no lowering. `ESC_UNKNOWN` always declines.
const ESC_UNKNOWN = 0
const ESC_I32 = 1
const ESC_I64 = 2
const ESC_F32 = 3
const ESC_F64 = 4
const ESC_BOOL = 5
const ESC_STRING = 6
const ESC_REF = 7  // object / array / map / function, and any nullable or union of them
const ESC_BOX = 8  // a value union the emitter boxes — a scalar beside another atom
const ESC_ATOM = 9 // a literal union: one interned i32 id

function elemStoreClassOf(ty: i32, depth: i32): i32 {
  if ty < 0 { return ESC_UNKNOWN }
  if depth <= 0 { return ESC_UNKNOWN }
  if tyReachesHole(ty, 8) { return ESC_UNKNOWN }
  // A niche-nullable scalar reps exactly as its base does: the `| null` is a sentinel
  // inside the element, not a second element type.
  if tyIsNicheNulScalarElem(ty) {
    if tyIsNullableLitUnion(ty) { return ESC_ATOM }
    const n = T.tys[ty]
    if n is TyNullable { return elemStoreClassOf(n.nInner, depth - 1) }
    return ESC_UNKNOWN
  }
  if tyIsLitUnion(ty) { return ESC_ATOM }
  const t = T.tys[ty]
  if t is TyPrim {
    const p = t.primName
    if p == "i32" { return ESC_I32 }
    if p == "i64" { return ESC_I64 }
    if p == "f32" { return ESC_F32 }
    if p == "f64" { return ESC_F64 }
    if p == "boolean" { return ESC_BOOL }
    if p == "string" { return ESC_STRING }
    return ESC_UNKNOWN
  }
  if t is TyObj { return ESC_REF }
  if t is TyArray { return ESC_REF }
  if t is TyMap { return ESC_REF }
  if t is TyFunc { return ESC_REF }
  if t is TyNullable {
    if tyPrintsAsRef(t.nInner, 8) { return ESC_REF }
    return ESC_BOX
  }
  if t is TyUnion {
    if tyPrintsAsRef(ty, 8) { return ESC_REF }
    return ESC_BOX
  }
  ESC_UNKNOWN
}

// Do a container's source and destination element types land in different storage
// classes? Neither side may be unknown. The three lossless scalar element widenings the
// converting copy serves are the only pairs where a differing class stops being a refusal
// (D965). The map arms below must keep refusing: `emitScalarListWidenSite` copies a list, and a map has no such copy built.
function scalarElemWidenServed(se: i32, de: i32): boolean {
  const sc = elemStoreClassOf(se, 8)
  if sc == ESC_UNKNOWN { return false }
  const dc = elemStoreClassOf(de, 8)
  if dc == ESC_UNKNOWN { return false }
  if sc == ESC_I32 {
    if dc == ESC_I64 { return true }
    if dc == ESC_F64 { return true }
    return false
  }
  if sc == ESC_F32 {
    if dc == ESC_F64 { return true }
  }
  false
}

function containerElemClassDiffers(se: i32, de: i32): boolean {
  const sc = elemStoreClassOf(se, 8)
  if sc == ESC_UNKNOWN { return false }
  const dc = elemStoreClassOf(de, 8)
  if dc == ESC_UNKNOWN { return false }
  sc != dc
}

// —— written-through covariance: the per-value half of D791's write scan (D821) ——
// D791 lowered a read-only covariant list assignment as an element-converting copy, licensed
// by a rep-scoped predicate that declines on an unrelated list sharing an element rep — a
// false reject clause 2 forbids. A per-value `Writable` answer instead (D793): 0 = safe to copy, 1 = refuse, 2 = unknown, fall back to the rep-scoped scan.

// The alias-closure memo, keyed by the root name that seeded the analysis. The arena does
// not change between `check` and `emit`, so the two answers are literally the same row;
// `cwArenaLen` drops the memo once the monomorphizer clones nodes into it.
let cwRootNames: string[] = []
let cwAnswers: i32[] = []
// Parallel to `cwAnswers`: 1 where the alias set demands two element storages
// (`cwSplitStorage`), 0 otherwise. Meaningful only where the closure actually ran.
let cwSplits: i32[] = []
let cwArenaLen = -1
// -1 = not computed, 0 = this program contains no list write at all, 1 = it contains one.
let cwAnyWrite = -1
// The function-name -> declaration index table the argument->parameter edge reads. Built
// once per program, because the edge is asked inside a fixpoint over the whole arena.
let cwFnNames: string[] = []
let cwFnDecls: i32[] = []
let cwFnBuilt = false

export function covarWriteReset() {
  cwRootNames = []
  cwAnswers = []
  cwSplits = []
  cwArenaLen = -1
  cwAnyWrite = -1
  cwFnNames = []
  cwFnDecls = []
  cwFnBuilt = false
}

// `unwrapParen`'s twin — that one lives in `emit_base`, which is downstream of this file.
function cwPeel(ix: i32): i32 {
  let cur = ix
  let done = false
  while !done {
    if cur < 0 || cur >= P.nodes.length { return cur }
    const n = P.nodes[cur]
    if n is Paren { cur = n.parInner } else { done = true }
  }
  cur
}

// The name an expression roots at — a bare (possibly parenthesised) identifier — or "". A
// member read, index, call result or literal roots at nothing on purpose: those forms'
// provenance this analysis does not follow, and "" routes them to the `2` answer.
export function covarRootName(ix: i32): string {
  const p = cwPeel(ix)
  if p < 0 || p >= P.nodes.length { return "" }
  const n = P.nodes[p]
  if n is Ident { return n.identName }
  ""
}

function cwHas(set: string[], nm: string): boolean {
  let i = 0
  while i < set.length {
    if set[i] == nm { return true }
    i = i + 1
  }
  false
}

// The mutating list methods, `rlSlotWrittenScan`'s own set. `set`/`add`/`delete` are map
// and Set operations; naming them costs a decline on a map sharing a member name and keeps
// the list honest if a list ever grows one.
function cwMutatesList(p: string): boolean {
  if p == "push" { return true }
  if p == "pop" { return true }
  if p == "clear" { return true }
  if p == "set" { return true }
  if p == "add" { return true }
  if p == "delete" { return true }
  false
}

function cwBuildFnTable() {
  if cwFnBuilt { return 0 }
  cwFnBuilt = true
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is FuncDecl {
      if n.fnName != "" {
        cwFnNames.push(n.fnName)
        cwFnDecls.push(i)
      }
    }
    i = i + 1
  }
  0
}

// The parameter name at position `argIx` of the top-level function `fnName`, or "" when the
// callee names no declared function or the position is past its parameter list. "" is a
// decline, not "no parameter" — the caller turns it into the `2` answer.
function cwParamName(fnName: string, argIx: i32): string {
  cwBuildFnTable()
  let i = 0
  while i < cwFnNames.length {
    if cwFnNames[i] == fnName {
      const d = P.nodes[cwFnDecls[i]]
      if d is FuncDecl {
        if argIx < d.fnParams.length {
          const p = P.nodes[d.fnParams[argIx]]
          if p is Param { return p.parName }
        }
      }
      return ""
    }
    i = i + 1
  }
  ""
}

// A call with named arguments binds by name, not by position, so the positional
// argument->parameter edge below would read the wrong parameter. Decline instead.
function cwCallNamed(names: string[]): boolean {
  let i = 0
  while i < names.length {
    if names[i] != "" { return true }
    i = i + 1
  }
  false
}

// —— the container-field edge (D852) ——
// The field name a member of `set` is stored into by an object literal — the shape the
// three name-to-name edges have neither end of: `{ xs: b }` puts the list inside a struct
// and `bx.xs` takes it back out under a name the closure never saw, keyed by the container's name plus the field name.
function cwEscapedFields(set: string[], owners: string[], flds: string[]) {
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is LetDecl {
      if n.letInit >= 0 {
        const lit = P.nodes[cwPeel(n.letInit)]
        if lit is ObjLit {
          if cwBoundOnce(n.letName) {
            let k = 0
            while k < lit.objFields.length {
              const fn = P.nodes[lit.objFields[k]]
              if fn is FieldInit {
                const rn = covarRootName(fn.fiValue)
                if rn != "" {
                  if cwHas(set, rn) {
                    owners.push(n.letName)
                    flds.push(fn.fiName)
                  }
                }
              }
              k = k + 1
            }
          }
        }
      }
    }
    i = i + 1
  }
  0
}

// Is `nm` bound exactly once in the whole program and never assigned? The guard that makes
// a binding name usable as a container identity — a name that can be re-pointed by `bx =
// other` is not an identity at all.
function cwBoundOnce(nm: string): boolean {
  let binds = 0
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is LetDecl {
      if n.letName == nm { binds = binds + 1 }
    }
    if n is Param {
      if n.parName == nm { binds = binds + 1 }
    }
    if n is BinExpr {
      if n.binOp == "=" {
        if covarRootName(n.binLeft) == nm { return false }
      }
    }
    i = i + 1
  }
  binds == 1
}

// Is `ix` a read of an escaped field (`<owner>.<f>` for a recorded pair)? Such a read is a
// handle on the value with no name of its own; the three edges bind it exactly as they bind
// a member name, so `const c = bx.xs` joins `c` and `bx.xs.push(…)` is a write.
function cwIsEscapedHandle(ix: i32, owners: string[], flds: string[]): boolean {
  if flds.length == 0 { return false }
  const p = cwPeel(ix)
  if p < 0 || p >= P.nodes.length { return false }
  const n = P.nodes[p]
  if n is Member {
    return cwEscapedPairHas(covarRootName(n.memObj), n.memProp, owners, flds)
  }
  if n is OptMember {
    return cwEscapedPairHas(covarRootName(n.omObj), n.omProp, owners, flds)
  }
  false
}

function cwEscapedPairHas(
  onm: string,
  prop: string,
  owners: string[],
  flds: string[],
): boolean {
  if onm == "" { return false }
  let i = 0
  while i < owners.length {
    if owners[i] == onm {
      if flds[i] == prop { return true }
    }
    i = i + 1
  }
  false
}

// The alias closure: grows `set` until no new name joins, over three edges that carry a
// list value from one name to another without putting it inside anything (a passthrough
// binding, an assignment to a plain identifier, a call argument reaching a declared
// function's parameter). Returns 0 when the closure completed, 2 when it hit a form it does not model.
function cwGrow(set: string[]): i32 {
  let changed = true
  let rounds = 0
  while changed {
    changed = false
    rounds = rounds + 1
    const fowners: string[] = []
    const flds: string[] = []
    cwEscapedFields(set, fowners, flds)
    // The set grows by at least one name per round or the loop ends, so the bound is the
    // number of names in the program — cheaper than proving it, and turns any surprise into
    // a decline rather than a hang.
    if rounds > 256 { return 2 }
    let i = 0
    while i < P.nodes.length {
      const n = P.nodes[i]
      if n is LetDecl {
        if n.letInit >= 0 {
          const rn = covarRootName(n.letInit)
          let carries = false
          if rn != "" {
            if cwHas(set, rn) { carries = true }
          }
          if cwIsEscapedHandle(n.letInit, fowners, flds) { carries = true }
          if carries {
            if !cwHas(set, n.letName) {
              set.push(n.letName)
              changed = true
            }
          }
        }
      }
      if n is BinExpr {
        if n.binOp == "=" {
          const rn = covarRootName(n.binRight)
          let carries = false
          if rn != "" {
            if cwHas(set, rn) { carries = true }
          }
          if cwIsEscapedHandle(n.binRight, fowners, flds) { carries = true }
          if carries {
            const ln = covarRootName(n.binLeft)
            // `m[k] = b` / `o.f = b` — the value goes inside something, and a later read
            // out of that container is a handle this analysis cannot name.
            if ln == "" { return 2 }
            if !cwHas(set, ln) {
              set.push(ln)
              changed = true
            }
          }
        }
      }
      if n is Call {
        let anyMember = false
        let k = 0
        while k < n.callArgs.length {
          const an = covarRootName(n.callArgs[k])
          if an != "" {
            if cwHas(set, an) { anyMember = true }
          }
          if cwIsEscapedHandle(n.callArgs[k], fowners, flds) {
            anyMember = true
          }
          k = k + 1
        }
        if anyMember {
          if cwCallNamed(n.callArgNames) { return 2 }
          const cn = covarRootName(n.callFn)
          // A method or a lambda-valued callee (`xs.push(b)`, `fp(b)`): the body that
          // receives the value is not a declared parameter list this can read.
          if cn == "" { return 2 }
          let k2 = 0
          while k2 < n.callArgs.length {
            const a2 = covarRootName(n.callArgs[k2])
            let carries2 = false
            if a2 != "" {
              if cwHas(set, a2) { carries2 = true }
            }
            if cwIsEscapedHandle(n.callArgs[k2], fowners, flds) {
              carries2 = true
            }
            if carries2 {
              const pn = cwParamName(cn, k2)
              if pn == "" { return 2 }
              if !cwHas(set, pn) {
                set.push(pn)
                changed = true
              }
            }
            k2 = k2 + 1
          }
        }
      }
      i = i + 1
    }
  }
  0
}

// Mark `ix` (paren-peeled) as a use this analysis accounts for.
function cwMark(idents: i32[], flags: i32[], ix: i32) {
  const p = cwPeel(ix)
  let i = 0
  while i < idents.length {
    if idents[i] == p { flags[i] = 1 }
    i = i + 1
  }
  0
}

// The accounting pass, a whitelist rather than a list of escapes — the only sound shape of
// this test, since a form nobody thought of is silently treated as safe under the other
// shape. Every occurrence of a member name must be a binding initializer, either side of an
// assignment, a call argument, a member-access object, or an index array; anything else is left unclaimed, the `2` answer.
function cwClaimed(set: string[]): boolean {
  const idents: i32[] = []
  const flags: i32[] = []
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is Ident {
      if cwHas(set, n.identName) {
        idents.push(i)
        flags.push(0)
      }
    }
    i = i + 1
  }
  i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is LetDecl {
      if n.letInit >= 0 { cwMark(idents, flags, n.letInit) }
    }
    if n is BinExpr {
      if n.binOp == "=" {
        cwMark(idents, flags, n.binLeft)
        cwMark(idents, flags, n.binRight)
      }
    }
    if n is Call {
      let k = 0
      while k < n.callArgs.length {
        cwMark(idents, flags, n.callArgs[k])
        k = k + 1
      }
    }
    if n is Member { cwMark(idents, flags, n.memObj) }
    if n is OptMember { cwMark(idents, flags, n.omObj) }
    if n is Index { cwMark(idents, flags, n.idxArr) }
    i = i + 1
  }
  i = 0
  while i < flags.length {
    if flags[i] == 0 { return false }
    i = i + 1
  }
  true
}

// Does this program contain any list write at all? The O(1) gate that keeps the closure
// off every program with nothing to separate.
function cwProgramHasWrite(): boolean {
  if cwAnyWrite >= 0 { return cwAnyWrite == 1 }
  let found = false
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is BinExpr {
      if n.binOp == "=" {
        const l = cwPeel(n.binLeft)
        if l >= 0 && l < P.nodes.length {
          const ln = P.nodes[l]
          if ln is Index { found = true }
        }
      }
    }
    if n is Call {
      const cf = cwPeel(n.callFn)
      if cf >= 0 && cf < P.nodes.length {
        const cn = P.nodes[cf]
        if cn is Member {
          if cwMutatesList(cn.memProp) { found = true }
        }
        if cn is Ident {
          if cn.identName == "__array_copy__" { found = true }
        }
      }
    }
    i = i + 1
  }
  if found { cwAnyWrite = 1 } else { cwAnyWrite = 0 }
  found
}

// The write pass over a completed alias set. A write whose receiver roots at a member is a
// definite hit (1); one rooting at nothing (`m["k"][0] = v`, `f()[0] = v`) could be any list
// and is a decline (2). An escaped-field receiver (`p.xs.push(…)`, D852) is tested before the decline, since that shape has no name.
function cwWrites(set: string[], owners: string[], flds: string[]): i32 {
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is BinExpr {
      if n.binOp == "=" {
        const l = cwPeel(n.binLeft)
        if l >= 0 && l < P.nodes.length {
          const ln = P.nodes[l]
          if ln is Index {
            const rn = covarRootName(ln.idxArr)
            if rn == "" {
              if cwIsEscapedHandle(ln.idxArr, owners, flds) { return 1 }
              return 2
            }
            if cwHas(set, rn) { return 1 }
          }
        }
      }
    }
    if n is Call {
      const cf = cwPeel(n.callFn)
      if cf >= 0 && cf < P.nodes.length {
        const cn = P.nodes[cf]
        if cn is Member {
          if cwMutatesList(cn.memProp) {
            const rn = covarRootName(cn.memObj)
            if rn == "" {
              if cwIsEscapedHandle(cn.memObj, owners, flds) { return 1 }
              return 2
            }
            if cwHas(set, rn) { return 1 }
          }
        }
        // `__array_copy__` writes into a destination array through an intrinsic whose
        // receiver this walk does not read, so it declines rather than being reasoned about.
        if cn is Ident {
          if cn.identName == "__array_copy__" { return 2 }
        }
      }
    }
    i = i + 1
  }
  0
}

// The element storage a declared list annotation fixes: 1 = a value union's `{tag,
// payload}` box, 2 = a plain struct row, 0 = neither, or an annotation whose type the
// checker has not recorded yet.
function cwElemKindOfAnn(annIx: i32): i32 {
  if annIx < 0 { return 0 }
  const ty = nodeTyIxOf(annIx)
  if ty < 0 || ty >= T.tys.length { return 0 }
  const t = T.tys[ty]
  if t is TyArray {
    const e = t.aElem
    if e < 0 || e >= T.tys.length { return 0 }
    const et = T.tys[e]
    if et is TyUnion {
      if covarNonNullArms(et.uMembers) >= 2 { return 1 }
      return 0
    }
    if et is TyObj { return 2 }
  }
  0
}

// Does this value have to be stored two ways? A converting copy — and the divergence a
// write would expose — exists only where one list value is demanded at both a union-box
// element row and a plain struct row; where every handle is a union it is built at the box
// and every handle aliases it (D381). Also asks whether any element is read: reading only `a.length` is correct and refusing it is a clause-2 false reject.
function cwElemRead(set: string[]): boolean {
  const stores: i32[] = []
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is BinExpr {
      if n.binOp == "=" { stores.push(cwPeel(n.binLeft)) }
    }
    i = i + 1
  }
  i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is Index {
      let isStore = false
      let k = 0
      while k < stores.length {
        if stores[k] == i { isStore = true }
        k = k + 1
      }
      if !isStore {
        const rn = covarRootName(n.idxArr)
        if rn != "" {
          if cwHas(set, rn) { return true }
        }
      }
    }
    if n is ForIn {
      const fn2 = covarRootName(n.fiIter)
      if fn2 != "" {
        if cwHas(set, fn2) { return true }
      }
    }
    if n is Call {
      const cf = cwPeel(n.callFn)
      if cf >= 0 && cf < P.nodes.length {
        const cn = P.nodes[cf]
        if cn is Member {
          if cn.memProp == "pop" || cn.memProp == "get" {
            const rn2 = covarRootName(cn.memObj)
            if rn2 != "" {
              if cwHas(set, rn2) { return true }
            }
          }
        }
      }
    }
    i = i + 1
  }
  false
}

// The element type index a declared list annotation fixes when that element is a value
// union the emitter boxes, else -1 — the identity half of `cwElemKindOfAnn`.
function cwUnionElemTyOfAnn(annIx: i32): i32 {
  if annIx < 0 { return -1 }
  const ty = nodeTyIxOf(annIx)
  if ty < 0 || ty >= T.tys.length { return -1 }
  const t = T.tys[ty]
  if t is TyArray {
    const e = t.aElem
    if e < 0 || e >= T.tys.length { return -1 }
    const et = T.tys[e]
    if et is TyUnion {
      if covarNonNullArms(et.uMembers) >= 2 { return e }
    }
  }
  -1
}

// —— the two-different-unions rule (D853) ——
// Do the declared handles on this value demand two different value unions, and is an
// element read? Both want the program's one box, but a store through one puts an arm the
// other's type does not name. Compared with `tySame`, so two aliases of one member set count as one union.
function cwTwoUnions(set: string[]): boolean {
  const seen: i32[] = []
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    let ann = -1
    if n is LetDecl {
      if n.letType >= 0 {
        if cwHas(set, n.letName) { ann = n.letType }
      }
    }
    if n is Param {
      if n.parType >= 0 {
        if cwHas(set, n.parName) { ann = n.parType }
      }
    }
    if ann >= 0 {
      const ue = cwUnionElemTyOfAnn(ann)
      if ue >= 0 {
        let found = false
        let k = 0
        while k < seen.length {
          if tySame(seen[k], ue) { found = true }
          k = k + 1
        }
        if !found { seen.push(ue) }
      }
    }
    i = i + 1
  }
  if seen.length < 2 { return false }
  cwElemRead(set)
}

function cwSplitStorage(set: string[]): boolean {
  let sawBox = false
  let sawRow = false
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is LetDecl {
      if n.letType >= 0 {
        if cwHas(set, n.letName) {
          const k = cwElemKindOfAnn(n.letType)
          if k == 1 { sawBox = true }
          if k == 2 { sawRow = true }
        }
      }
    }
    if n is Param {
      if n.parType >= 0 {
        if cwHas(set, n.parName) {
          const k = cwElemKindOfAnn(n.parType)
          if k == 1 { sawBox = true }
          if k == 2 { sawRow = true }
        }
      }
    }
    i = i + 1
  }
  if sawBox { return sawRow }
  false
}

// Does the alias set of `root` demand two element storages, or two different value unions
// (and read an element)? Only meaningful once `covarValueWriteState` has run the closure.
// Recomputed rather than memoised beside `cwSplits`: this runs mid-check, so the answer at
// the first assignment cannot see a later handle's annotation — a memo would decide by check order.
function covarValueTwoUnions(root: string): boolean {
  if root == "" { return false }
  const set: string[] = []
  set.push(root)
  cwGrow(set)
  cwTwoUnions(set)
}

function covarValueSplitStorage(root: string): boolean {
  let m = 0
  while m < cwRootNames.length {
    if cwRootNames[m] == root { return cwSplits[m] == 1 }
    m = m + 1
  }
  false
}

// The predicate. 0 = nothing writes this value, 1 = something does, 2 = unknown.
export function covarValueWriteState(root: string): i32 {
  if root == "" { return 2 }
  if P.nodes.length != cwArenaLen {
    // The monomorphizer clones nodes into the arena after `check`, so an answer computed
    // over the smaller arena describes a program that has since changed. Drop and
    // recompute: this analysis reads every `Ident` in the arena and a clone adds Idents.
    cwRootNames = []
    cwAnswers = []
    cwSplits = []
    cwAnyWrite = -1
    cwFnNames = []
    cwFnDecls = []
    cwFnBuilt = false
    cwArenaLen = P.nodes.length
  }
  let m = 0
  while m < cwRootNames.length {
    if cwRootNames[m] == root { return cwAnswers[m] }
    m = m + 1
  }
  let ans = 0
  let split = 0
  if cwProgramHasWrite() {
    const set: string[] = []
    set.push(root)
    ans = cwGrow(set)
    // The write pass runs before the claim pass (D852): a write to a member of the closed
    // set is a positive fact about this value, which the claim pass's `2` had been
    // discarding wherever both fired. The reorder can only move a `2` to a `1`, and only
    // where a definite write exists — such a program is already an invalid module today.
    const wowners: string[] = []
    const wflds: string[] = []
    cwEscapedFields(set, wowners, wflds)
    if ans == 0 { ans = cwWrites(set, wowners, wflds) }
    if ans == 0 {
      if !cwClaimed(set) { ans = 2 }
    }
    if ans != 2 {
      if cwSplitStorage(set) { split = 1 }
    }
  }
  cwRootNames.push(root)
  cwAnswers.push(ans)
  cwSplits.push(split)
  ans
}

// —— the checker's `Writable` rule (DECISIONS.md A9, D793) ——
// A covariant list assignment is legal exactly where it is read-only: where the value is
// written through, the two element storages cannot both be honoured, so the assignment
// itself is illegal. A niche destination is out (D792); the source must be a named handle, since a fresh literal creates no alias.
function covarWriteThrough(srcExpr: i32, srcTy: i32, dstTy: i32): i32 {
  if srcExpr < 0 { return 0 }
  if srcTy < 0 || dstTy < 0 { return 0 }
  if srcTy >= T.tys.length || dstTy >= T.tys.length { return 0 }
  const s = T.tys[srcTy]
  if s is TyArray {
    const d = T.tys[dstTy]
    if d is TyArray {
      const se = s.aElem
      const de = d.aElem
      if se < 0 || de < 0 { return 0 }
      if se >= T.tys.length || de >= T.tys.length { return 0 }
      const st = T.tys[se]
      // A plain struct row on the source side — `rlElemKindTbl == 1`, the only element
      // kind the widening reads from.
      if st is TyObj {
        const dt = T.tys[de]
        if dt is TyUnion {
          // A union the emitter boxes, not a nullable niche: one non-null member beside
          // `null` reps as its base with a null slot (D771), not a `{tag, payload}`
          // destination, so the widening declines it write or no write (D792).
          if covarNonNullArms(dt.uMembers) < 2 { return 0 }
          const root = covarRootName(srcExpr)
          if root == "" { return 0 }
          if covarValueWriteState(root) != 1 { return 0 }
          if covarValueSplitStorage(root) { return 1 }
          if covarValueTwoUnions(root) { return 2 }
        }
      }
    }
  }
  0
}

// How many members of a union are not `null`.
function covarNonNullArms(ms: i32[]): i32 {
  let n = 0
  let i = 0
  while i < ms.length {
    if !isNullTy(ms[i]) { n = n + 1 }
    i = i + 1
  }
  n
}

// Reported at the assignment rather than the write, since the assignment is what the
// author can change. Not a capability concession: the copy exists (D791), this program is
// the one shape it is not allowed to run in.
function covarWriteThroughErr(srcExpr: i32, srcTy: i32, dstTy: i32) {
  tErr(
    "a " +
      tyToStr(srcTy) +
      " cannot be assigned to " +
      tyToStr(dstTy) +
      " here: the list is WRITTEN THROUGH somewhere in this program, and a covariant list " +
      "assignment is read-only. The two element storages differ, so the destination would " +
      "have to hold a converted copy, and a store through either handle would not be seen " +
      "through the other. Declare the source as " +
      tyToStr(dstTy) +
      " so both handles share one element storage, or drop the write",
    srcExpr,
  )
}

// The second sentence (D853), reported at the assignment like its sibling but deliberately
// not sharing its wording: nothing is copied here — both declared views rep as the
// program's one box and every handle aliases one list — so what is wrong is that two
// declared views of one written-through list disagree about which arms the elements may be.
function covarTwoUnionsErr(srcExpr: i32, srcTy: i32, dstTy: i32) {
  tErr(
    "a " +
      tyToStr(srcTy) +
      " cannot be assigned to " +
      tyToStr(dstTy) +
      " here: this list is ALSO declared with a DIFFERENT element union elsewhere in this " +
      "program, and it is written through. VL lists alias, so the two declarations describe " +
      "one storage: a store admitted by one of them can put an element the other has no arm " +
      "for, and a read through that other one has no correct value. Give every handle on this " +
      "list the same element type, or drop the write",
    srcExpr,
  )
}

// Does reaching `dst` from `src` need an object-shape adapter that codegen does not have?
// `assignable`'s `TyObj` arm walks the destination's field names only, so a source carrying
// extra fields is accepted, while the emitter interns a struct's own field list — two
// unrelated wasm types with no conversion. An object literal is exempt from a shape mismatch, but not from an excess field's dropped initializer.
function objWidthPrefix(src: i32, dst: i32): boolean {
  if src < 0 || dst < 0 || src == dst { return false }
  const s = T.tys[src]
  if s is TyObj {
    const d = T.tys[dst]
    if d is TyObj {
      const sn = s.objFieldNames
      const dn = d.objFieldNames
      if dn.length == 0 { return false }
      if dn.length >= sn.length { return false }
      const so = objFieldNameOrder(sn)
      const dord = objFieldNameOrder(dn)
      let k = 0
      while k < dn.length {
        if sn[so[k]] != dn[dord[k]] { return false }
        if !tyEq(s.objFieldTypes[so[k]], d.objFieldTypes[dord[k]]) {
          return false
        }
        k = k + 1
      }
      return true
    }
  }
  false
}

// The emitter's `fieldNameOrder`, restated for the checker's own field lists — two
// spellings of one rule that must not drift, both a stable insertion sort on the field name alone.
function objFieldNameOrder(names: string[]): i32[] {
  const ord: i32[] = []
  let i = 0
  while i < names.length {
    ord.push(i)
    i = i + 1
  }
  let a = 1
  while a < ord.length {
    let b = a
    while b > 0 && names[ord[b - 1]] > names[ord[b]] {
      const t = ord[b - 1]
      ord[b - 1] = ord[b]
      ord[b] = t
      b = b - 1
    }
    a = a + 1
  }
  ord
}

// Is `srcExpr` a name bound, without an annotation, to an object literal? An un-annotated
// binding has no pinned wasm type of its own, so the emitter lays it out at the shape it flows
// into, which is what makes a nested width pair sound; an annotated source keeps its type and
// the pair is unsound (D938). Resolved through the scope chain, never by arena order (D1609).
function srcIsUnannotatedObjBinding(srcExpr: i32): boolean {
  if srcExpr < 0 { return false }
  const e = P.nodes[srcExpr]
  if e is Paren { return srcIsUnannotatedObjBinding(e.parInner) }
  if e is Ident { return bindingIsObjLit(e.identName) }
  false
}

// Does some shared field name carry a width pair of object shapes? Asked only of a pair
// whose field names already agree — whether they disagree through a field. At a `direct`
// value position that width lift is free; inside a mutable struct field it is not available
// at all (WasmGC field invariance), so silence here hands the validator a program it already accepted (D938).
function objFieldWidthPair(src: i32, dst: i32): boolean {
  const s = T.tys[src]
  const d = T.tys[dst]
  if s is TyObj {
    if d is TyObj {
      const dnames = d.objFieldNames
      const dtys = d.objFieldTypes
      let i = 0
      while i < dnames.length {
        const sft = objFieldType(s, dnames[i])
        if sft >= 0 && dtys[i] >= 0 {
          if !tyEq(sft, dtys[i]) {
            if objWidthPrefix(sft, dtys[i]) { return true }
          }
        }
        i = i + 1
      }
    }
  }
  false
}

// `direct` — is the destination a slot a `(ref $src)` can be written into as it stands?
// True at a value flow, where a declared WasmGC supertype makes the reference fit. False
// wherever the pair sits under something whose own wasm type has to relate by identity — an
// array or map element, a function signature — since a struct-level `sub` edge does not reach those.
function objShapeAdapterless(
  srcExpr: i32,
  src: i32,
  dst: i32,
  depth: i32,
  direct: boolean,
): boolean {
  if src < 0 || dst < 0 || depth <= 0 { return false }
  if src == dst { return false }
  const s = T.tys[src]
  const d = T.tys[dst]
  // Nullable pairs peel exactly as `assignableGo`'s nullable arm does, and in its order.
  if d is TyNullable {
    if s is TyNullable {
      return objShapeAdapterless(-1, s.nInner, d.nInner, depth - 1, direct)
    }
    return objShapeAdapterless(srcExpr, src, d.nInner, depth - 1, direct)
  }
  // A union source is assignable when every member is, so any member needing an adapter
  // makes the whole flow one.
  if s is TyUnion {
    const sms = s.uMembers
    let si = 0
    while si < sms.length {
      if objShapeAdapterless(-1, sms[si], dst, depth - 1, false) { return true }
      si = si + 1
    }
    return false
  }
  // A union target accepts the source at some member. It is adapterless only when no
  // accepting member is: one clean member is a lowering.
  if d is TyUnion {
    const dms = d.uMembers
    let di = 0
    let anyClean = false
    let anyAdapts = false
    while di < dms.length {
      if assignable(src, dms[di]) {
        if objShapeAdapterless(srcExpr, src, dms[di], depth - 1, false) {
          anyAdapts = true
        } else {
          anyClean = true
        }
      }
      di = di + 1
    }
    if anyClean { return false }
    return anyAdapts
  }
  const cx = ctorExprOf(srcExpr)
  if s is TyObj {
    if d is TyObj {
      // A cost early-out, not a decision: `tyEq` is render-equality, so two equal object
      // types have equal ordered field-name lists, which `objFieldNameSetsEq` declines
      // anyway. Here because the identical pair is the overwhelmingly common one.
      if tyEq(src, dst) { return false }
      // A pair reaching an inference hole is not a pair of shapes yet. An un-annotated
      // parameter used only as `o.x` demands `{x: _}`, which looks like a width-subtyped
      // destination beside a two-field argument and is not one — the solve pins it from the
      // argument and it lowers.
      if tyReachesHole(src, 8) || tyReachesHole(dst, 8) { return false }
      if cx >= 0 {
        const ce = P.nodes[cx]
        if ce is ObjLit {
          // The literal itself is rebuilt at `dst`; its field values still have to fit
          // the destination field types, judged with their own expressions.
          const dnames = d.objFieldNames
          const dtys = d.objFieldTypes
          let li = 0
          while li < dnames.length {
            const sft = objFieldType(s, dnames[li])
            if sft >= 0 {
              let fexpr = -1
              const fl = ce.objFields
              let fi = 0
              while fi < fl.length {
                const fn = P.nodes[fl[fi]]
                if fn is FieldInit {
                  if fn.fiName == dnames[li] { fexpr = fn.fiValue }
                }
                fi = fi + 1
              }
              if objShapeAdapterless(fexpr, sft, dtys[li], depth - 1, true) {
                return true
              }
            }
            li = li + 1
          }
          // Falls through to the dropped-field decision: the exemption covers what "built
          // at the destination shape" buys, and a field the destination does not declare is
          // not in it. `emitObj` walks the destination's field list, so a lacked field is
          // never visited — its initializer never runs, a silently wrong evaluation count.
        }
      }
      // Agreeing field names, differing through a field — still adapterless, and one case
      // is worse than a hole: a field width pair (`{n: Wide}` into `{n: Narrow}`) is unsound
      // rather than unsupported, since a struct field is mutable. Not withdrawn here, since
      // the identical pair is correct for an un-annotated literal — the verdict turns on the source's provenance (D622).
      if objFieldNameSetsEq(src, dst) {
        // …except where a field pair is itself a width pair and the source is not a
        // rebuilt literal — withdrawing on the types alone would redden the un-annotated
        // literal case, which is correct, so the axis is the source's provenance
        // (`litShapeDropSrcExpr`). A struct's mutable field is WasmGC-invariant, so this is a clause-1 soundness violation with no sound lowering to build (D938).
        if (
          !litShapeDropSrcExpr(cx) &&
          !srcIsUnannotatedObjBinding(srcExpr) &&
          objFieldWidthPair(src, dst)
        ) {
          shapeAdaptSrcTy = src
          shapeAdaptDstTy = dst
          shapeAdaptSrcExpr = cx
          shapeAdaptElemPair = false
          shapeAdaptWidthField = true
          return true
        }
        return false
      }
      // The width lift (D622): a `Wide` flowing into a `Narrow` whose fields are the first
      // of `Wide`'s, in the canonical layout order with identical types, needs no
      // conversion — `emitTypeSection` declares a `(sub)` edge, only at a `direct` position.
      // An object literal is not lifted: `emitObj` builds it at the destination's field list, so an excess field's initializer never runs.
      if direct && !litShapeDropSrcExpr(cx) && objWidthPrefix(src, dst) {
        return false
      }
      shapeAdaptSrcTy = src
      shapeAdaptDstTy = dst
      shapeAdaptSrcExpr = cx
      shapeAdaptElemPair = false
      shapeAdaptWidthField = false
      return true
    }
    return false
  }
  if s is TyArray {
    if d is TyArray {
      if cx >= 0 {
        const ae = P.nodes[cx]
        if ae is ArrayLit {
          const els = ae.arrElems
          let ei = 0
          while ei < els.length {
            if (
              objShapeAdapterless(
                els[ei],
                nodeTyIxOf(els[ei]),
                d.aElem,
                depth - 1,
                true,
              )
            ) {
              return true
            }
            ei = ei + 1
          }
          return false
        }
      }
      // The nested pair first, so a container carrying an object pair keeps the precise
      // object wording; only then the element's own storage class — what makes
      // `i32[][]` -> `(i32 | null)[][]` report the inner array pair rather than the outer.
      if objShapeAdapterless(-1, s.aElem, d.aElem, depth - 1, false) {
        return true
      }
      if containerElemClassDiffers(s.aElem, d.aElem) {
        // The converting copy (D965) admits three of these pairs, under the licence the ref
        // copy already runs on: the copy is a snapshot, sound only where nothing writes the
        // value. An unknown write state (2) keeps the refusal.
        if scalarElemWidenServed(s.aElem, d.aElem) {
          if covarValueWriteState(covarRootName(cx)) == 0 { return false }
        }
        shapeAdaptSrcTy = src
        shapeAdaptDstTy = dst
        shapeAdaptSrcExpr = cx
        shapeAdaptElemPair = true
        shapeAdaptWidthField = false
        return true
      }
      return false
    }
    return false
  }
  if s is TyMap {
    if d is TyMap {
      if objShapeAdapterless(-1, s.mKey, d.mKey, depth - 1, false) {
        return true
      }
      if objShapeAdapterless(-1, s.mVal, d.mVal, depth - 1, false) {
        return true
      }
      if containerElemClassDiffers(s.mKey, d.mKey) {
        shapeAdaptSrcTy = src
        shapeAdaptDstTy = dst
        shapeAdaptSrcExpr = cx
        shapeAdaptElemPair = true
        shapeAdaptWidthField = false
        return true
      }
      if containerElemClassDiffers(s.mVal, d.mVal) {
        shapeAdaptSrcTy = src
        shapeAdaptDstTy = dst
        shapeAdaptSrcExpr = cx
        shapeAdaptElemPair = true
        shapeAdaptWidthField = false
        return true
      }
      return false
    }
    return false
  }
  if s is TyFunc {
    if d is TyFunc {
      const sp = s.fnParamTypes
      const dp = d.fnParamTypes
      if sp.length != dp.length { return false }
      if objShapeAdapterless(-1, s.fnRet, d.fnRet, depth - 1, false) {
        return true
      }
      let pi = 0
      while pi < sp.length {
        // Parameters compare contravariantly in `assignable`'s `TyFunc` arm; keep the
        // same operand order so the pair examined is the pair it accepted.
        if objShapeAdapterless(-1, dp[pi], sp[pi], depth - 1, false) {
          return true
        }
        pi = pi + 1
      }
      return false
    }
    return false
  }
  false
}

// The field names `src` carries that `dst` does not, rendered `` `a`, `b` ``.
function objDroppedFieldList(src: i32, dst: i32) {
  const s = T.tys[src]
  const d = T.tys[dst]
  let out = ""
  if s is TyObj {
    if d is TyObj {
      let i = 0
      while i < s.objFieldNames.length {
        if objFieldType(d, s.objFieldNames[i]) < 0 {
          if out != "" { out = out + ", " }
          out = out + "`" + s.objFieldNames[i] + "`"
        }
        i = i + 1
      }
    }
  }
  out
}

// The message for an `objShapeAdapterless` pair. Names the object pair that has no lowering
// and the fields that make it one, not the container that carried it (reported separately),
// then the two ways out: a constructor is built at the shape it flows into, or the source
// can be spelled at the target's shape.
function objShapeAdapterlessErr(srcExpr: i32, src: i32, dst: i32) {
  let sT = shapeAdaptSrcTy
  let dT = shapeAdaptDstTy
  let sX = shapeAdaptSrcExpr
  if sT < 0 || dT < 0 {
    sT = src
    dT = dst
    sX = srcExpr
  }
  let through = ""
  if !tyEq(sT, src) || !tyEq(dT, dst) {
    through = " (reached through " +
      tyToStr(src) +
      " into " +
      tyToStr(dst) +
      ")"
  }
  // An object literal gets its own wording: "construct at the destination shape" is what
  // the author already did, but what actually happens is silent — dropping the excess
  // field's initializer unevaluated. The container-element wording instead names what
  // changed: how the element is stored — not a capability gap, since a struct field is WasmGC-invariant (D938).
  if shapeAdaptWidthField {
    tErr(
      "an object of type " +
        tyToStr(sT) +
        " cannot flow into " +
        tyToStr(dT) +
        through +
        ": they agree on field names but differ INSIDE a field, and a struct field is " +
        "mutable — writing through the narrower view would leave the original holding a " +
        "value of the wrong type, so the two are unrelated by design and not by a missing " +
        "lowering. Give the source exactly " +
        tyToStr(dT) +
        "'s field types, or read the field out and rebuild",
      srcExpr,
    )
    return 0
  }
  if shapeAdaptElemPair {
    tErrUnsupported(
      "a value of type " +
        tyToStr(sT) +
        " flowing into " +
        tyToStr(dT) +
        through +
        " changes how the ELEMENT is stored: type-valid (the element type widens) but " +
        "not yet supported by codegen — a container's wasm type is fixed by its element's " +
        "storage, so these are unrelated types and no element-converting copy exists. " +
        "Build the container at " +
        tyToStr(dT) +
        " (a literal is built at the type it flows into), or declare the source as " +
        tyToStr(dT),
      srcExpr,
    )
    return 0
  }
  if litShapeDropSrcExpr(sX) {
    tErr(
      "this object literal sets " +
        objDroppedFieldList(sT, dT) +
        ", which " +
        tyToStr(dT) +
        " does not declare" +
        through +
        ": a literal is built at the shape it flows into, so the extra field would be " +
        "dropped and its initializer never evaluated — a call there would never run. " +
        "Remove the field, or declare it on " +
        tyToStr(dT),
      srcExpr,
    )
  } else {
    tErrUnsupported(
      "an object value of shape " +
        tyToStr(sT) +
        " flowing into " +
        tyToStr(dT) +
        through +
        " drops the field " +
        objDroppedFieldList(sT, dT) +
        ": type-valid (structural width subtyping) but not yet supported by codegen — a " +
        "struct's wasm type is its own field list, so these are unrelated types and no " +
        "field-dropping conversion exists. Construct the value at " +
        tyToStr(dT) +
        " (an object literal is built at the shape it flows into), or declare the source " +
        "with exactly " +
        tyToStr(dT) +
        "'s fields",
      srcExpr,
    )
  }
}

// Is the claimed pair's source (`shapeAdaptSrcExpr`, already peeled) an object literal?
// That is the whole difference between the two wordings, and it must be asked of the pair
// the walk stopped on, not the outer expression, which answers both cases the wrong way.
function litShapeDropSrcExpr(claimedExpr: i32) {
  if claimedExpr < 0 { return false }
  const ce = P.nodes[claimedExpr]
  if ce is ObjLit { return true }
  false
}

// Exported for the LSP query layer's UFCS candidate scan, which asks exactly the question
// `ufcsCallTy` asks of a written call — of every declared `self`-function — so the editor
// can offer the ones whose import is missing. The export is a visibility change, not a new answer.
export function assignable(src: i32, dst: i32) {
  if src < 0 || dst < 0 { return true }
  if src == dst { return true }
  let gi = asgSrcStack.length - 1
  while gi >= 0 {
    if asgSrcStack[gi] == src && asgDstStack[gi] == dst { return true }
    gi = gi - 1
  }
  asgSrcStack.push(src)
  asgDstStack.push(dst)
  const ok = assignableGo(src, dst)
  asgSrcStack.pop()
  asgDstStack.pop()
  ok
}

function assignableGo(src: i32, dst: i32) {
  const s = T.tys[src]
  const d = T.tys[dst]
  // A second, never-narrowed name for the same source variant, bound where `s` is still
  // the whole `Ty` union. The `s is X` guards below each subtract their variant from `s`
  // for the rest of the body, so a structural tail wanting the declared union needs `sTail`
  // instead — bound at the top so it is provably the same variant as `s`.
  const sTail = s
  if s is TyErr { return true }
  if d is TyErr { return true }
  if s is TyVar { return true }
  if d is TyVar { return true }
  // `never` (the empty type) is the bottom type: assignable anywhere. As a target it
  // accepts nothing — no concrete source reaches `s.primName == d.primName` with "never" on only one side.
  if s is TyPrim {
    if s.primName == "never" { return true }
  }
  // Nullable target: accepts `null` itself, the inner, or another nullable's inner.
  if d is TyNullable {
    if src == TY_NULL { return true }
    if s is TyNullable { return assignable(s.nInner, d.nInner) }
    return assignable(src, d.nInner)
  }
  // A nullable source is not assignable to a non-nullable target unless the target already
  // admits `null` (D1030): `T | null` is assignable to `D` iff `T` is and `null` is. A
  // self-referential union with a `null` arm interns as `TyUnion[TyNullable(rest)]`, so
  // without this `Json` is not assignable to its own superset `Json | JsonError`.
  if s is TyNullable {
    if assignable(TY_NULL, dst) { return assignable(s.nInner, dst) }
    return false
  }
  // Union source: every member must be assignable to the target.
  if s is TyUnion {
    const members = s.uMembers
    let i = 0
    let ok = true
    while i < members.length {
      if !assignable(members[i], dst) { ok = false }
      i = i + 1
    }
    return ok
  }
  // Union target: the source must be assignable to some member.
  if d is TyUnion {
    const members = d.uMembers
    let i = 0
    let ok = false
    while i < members.length {
      if assignable(src, members[i]) { ok = true }
      i = i + 1
    }
    return ok
  }
  // Literal types: a literal source is assignable to the same literal, or anywhere its base
  // scalar flows (`0` → i32, `"a"` → string). A non-literal source is never assignable to a
  // literal target — `string` does not flow into `"a" | "b"`, a closed set, not an open string type.
  if s is TyLit {
    if d is TyLit { return s.litKind == d.litKind && s.litText == d.litText }
    return assignable(litBaseTy(s), dst)
  }
  if d is TyLit { return false }
  // A negation target `!T` (residual, usually folded away by `intersectTy`): accepts a
  // source not assignable to the negated type.
  if d is TyNeg { return !assignable(src, d.negTy) }
  if s is TyNeg { return false }
  // Nominal newtype: a brand and its base — or two different brands — do not flow into each
  // other, though every structural rule below would accept them. `assignable` is the single
  // chokepoint every position goes through, so no position can be taught half the rule.
  // Placement is load-bearing: after the holes, `never`, and the nullable/union/literal/negation arms, all of which destructure and recurse.
  if nomLitRelax == 0 {
    if nomNameOfTy(src) != nomNameOfTy(dst) { return false }
  }
  // The structural tail, exhaustive over `Ty` and deliberately `_`-less: a 12th arena
  // variant breaks the self-compile here instead of silently answering `false`, a spurious
  // loud reject of a valid program. Scrutinised on `sTail`, not `s`: `s` has had every
  // guarded variant above subtracted from it, while `sTail` carries the full declared `Ty`.
  match sTail {
    TyPrim => {
      if d is TyPrim {
        // Lossless numeric widening: a narrower numeric value flows into a wider slot along
        // the lattice i32→{i64,f32,f64}, i64→f64, f32→f64; the reverse is not assignable,
        // since it is lossy and must be made explicit. Codegen inserts the matching wasm
        // convert at the boundary; the binding takes the wider type.
        if numWidensName(sTail.primName, d.primName) { return true }
        return sTail.primName == d.primName
      }
      return false
    }
    TyObj => {
      if d is TyObj {
        const dnames = d.objFieldNames
        const dtys = d.objFieldTypes
        let i = 0
        let ok = true
        while i < dnames.length {
          const srcIx = objFieldType(sTail, dnames[i])
          if srcIx < 0 { ok = false }
          else if !assignable(srcIx, dtys[i]) { ok = false }
          i = i + 1
        }
        return ok
      }
      return false
    }
    TyArray => {
      if d is TyArray {
        // An empty `[]` (element `-1`) is assignable to any array; otherwise the
        // element types must be assignable.
        return assignable(sTail.aElem, d.aElem)
      }
      return false
    }
    TyMap => {
      if d is TyMap {
        // A bare `Map()`/`Set()` (key/value holes, `-1`) is assignable to any map.
        return assignable(sTail.mKey, d.mKey) && assignable(sTail.mVal, d.mVal)
      }
      return false
    }
    TyFunc => {
      if d is TyFunc {
        // A generic function value (hole params/return) is assignable to a concrete
        // function type only by instantiation — its body's capability must hold at the
        // target's param types and yield the target's return, not the structural rule
        // below, which a hole passes unconditionally.
        if fnTyHasHole(src) { return genericFnAssignable(src, dst) }
        const sp = sTail.fnParamTypes
        const dp = d.fnParamTypes
        if sp.length != dp.length { return false }
        let i = 0
        let ok = fnSlotAssignable(sTail.fnRet, d.fnRet)
        while i < sp.length {
          if !fnSlotAssignable(dp[i], sp[i]) { ok = false }
          i = i + 1
        }
        return ok
      }
      return false
    }
    TyErr => {
      // Claimed by `s is TyErr` at the top, which returns true.
    }
    TyVar => {
      // Claimed by `s is TyVar` at the top, which returns true.
    }
    TyNullable => {
      // Claimed by the nullable pair above: the `d is TyNullable` arm peels both
      // sides, and the bare `s is TyNullable` guard right after it returns false.
    }
    TyUnion => {
      // Claimed by the union-SOURCE arm above, which returns its `ok`.
    }
    TyLit => {
      // Claimed by the literal-SOURCE arm above, which returns on both legs.
    }
    TyNeg => {
      // Claimed by `s is TyNeg` above, which returns false.
    }
  }
  // Unreachable by construction: each empty arm is claimed by an earlier `s`-test that
  // returns, and the five real arms return on every leg.
  false
}

// ── per-kind helpers (take a narrowed variant; recurse back through checkNode) ──
// These helpers receive an already-narrowed `Node` variant as a struct parameter, narrow
// further children themselves, and call back into `checkNode` — a host miscompile once
// prohibited this shape, fixed and pinned by `union-two-visitors.vl`.

// Look up a generic binding by type-param name in the parallel bind arrays.
function bindOf(bNames: string[], bTys: i32[], name: string) {
  let i = 0
  while i < bNames.length {
    if bNames[i] == name { return bTys[i] }
    i = i + 1
  }
  -1
}

// The demanded shape (TyObj arena index) of hole `name`, or -1.
function holeShapeOf(name: string) {
  let i = 0
  while i < holeShapeNames.length {
    if holeShapeNames[i] == name { return holeShapeTys[i] }
    i = i + 1
  }
  -1
}

// How many fields hole `name`'s demanded shape carries right now (0 when it has no shape
// yet). The shape's `TyObj` grows in place, so an alternative records a count, not a snapshot type.
function holeShapeFieldCount(name: string) {
  const shape = holeShapeOf(name)
  if shape < 0 { return 0 }
  const st = T.tys[shape]
  if st is TyObj { return st.objFieldNames.length }
  0
}

// The `holeAlt*` row hole `name` already carries for tested type `ty`, or -1. Matched
// structurally (`tyEq`) rather than by arena index, since every pass over the body
// re-resolves the `is` annotation to a fresh arena entry — the index differs while the type
// does not.
function holeAltRowOf(name: string, ty: i32) {
  if ty < 0 { return -1 }
  let i = 0
  while i < holeAltNames.length {
    if holeAltNames[i] == name && tyEq(holeAltTys[i], ty) { return i }
    i = i + 1
  }
  -1
}

// Registers an `is`-guard alternative `ty` for hole `name`, with the fields demanded so far
// pinned as its required prefix. Returns the new row's index so the guard can patch
// `holeAltTailN` once its arms are checked, or -1 when there is nothing to patch.
function noteHoleAlt(holeIx: i32, name: string, ty: i32) {
  if ty < 0 { return -1 }
  // A body is checked more than once (the return-inference pre-pass, then the real pass)
  // and the demanded shape accumulates across them — never cleared — so only the first walk
  // sees it grow from empty. A re-check keeps the existing row verbatim (returning -1, so
  // the guard does not re-patch its tail) rather than appending a duplicate.
  let i = 0
  while i < holeAltNames.length {
    if holeAltNames[i] == name && tyEq(holeAltTys[i], ty) { return -1 }
    i = i + 1
  }
  const pre = holeShapeFieldCount(name)
  holeAltNames.push(name)
  holeAltTys.push(ty)
  holeAltPreN.push(pre)
  holeAltTailN.push(-1)
  holeAltHoleIx.push(holeIx)
  holeAltNames.length - 1
}

// The demanded-shape fields an argument satisfying alternative `k` still reaches: the
// prefix demanded before the guard, plus (when the guard's then-branch does not diverge)
// the suffix demanded after it. Returns -1 when nothing is required.
function holeAltResidualTy(shape: i32, k: i32) {
  if shape < 0 { return -1 }
  const st = T.tys[shape]
  if st is TyObj {
    const names: string[] = []
    const tys: i32[] = []
    const all = st.objFieldNames
    const allTys = st.objFieldTypes
    let i = 0
    while i < holeAltPreN[k] && i < all.length {
      names.push(all[i])
      tys.push(allTys[i])
      i = i + 1
    }
    const tail = holeAltTailN[k]
    if tail >= 0 {
      let j = tail
      while j < all.length {
        names.push(all[j])
        tys.push(allTys[j])
        j = j + 1
      }
    }
    if names.length == 0 { return -1 }
    return mkObjTy(names, tys)
  }
  -1
}

// `srcExpr < 0` (a dispatch probe with no argument node — a UFCS receiver, an operator
// operand) checks the type alone, so the literal-aware / rep-sidecar recording in
// `assignableExpr` is not driven by a node index it does not have.
function holeAssignOk(srcExpr: i32, at: i32, dst: i32) {
  if srcExpr < 0 { return assignable(at, dst) }
  assignableExpr(srcExpr, at, dst)
}

// Does `at` (the argument expression `srcExpr`) satisfy hole `name`'s demand? The
// accumulated shape satisfies it, and so does any `is`-guard alternative whose still-
// reachable demanded fields (`holeAltResidualTy`) are satisfied too. True when the hole demands nothing.
function holeDemandOk(name: string, srcExpr: i32, at: i32) {
  // A map demand is checked first, and it is a hard requirement, not one arm of a
  // disjunction: a hole the body used the map surface on is a map. Both pins run on the way
  // through: `constrainEmpty(at, hm)` pins an argument still open at the call; the reverse
  // pins a demand the callee left open from a concrete argument.
  const hm = holeMapOf(name)
  if hm >= 0 {
    if !holeAssignOk(srcExpr, at, hm) { return false }
    constrainEmpty(at, hm)
    // A demand the callee's own operations left open is not satisfiable here, and the
    // reason is order, not assignability: the body has already been checked against the
    // open type, so its recorded node types are stale, and pinning the demand now would
    // emit against those. Bidirectional inference (roadmap), not a pin — refuse instead.
    if holeMapDemandOpen(hm) { return false }
  }
  const shape = holeShapeOf(name)
  if shape < 0 { return true }
  if holeAssignOk(srcExpr, at, shape) { return true }
  let k = 0
  while k < holeAltNames.length {
    if holeAltNames[k] == name {
      if holeAssignOk(srcExpr, at, holeAltTys[k]) {
        const resid = holeAltResidualTy(shape, k)
        if resid < 0 { return true }
        if holeAssignOk(srcExpr, at, resid) { return true }
      }
    }
    k = k + 1
  }
  false
}

// Membership test over a small arena-type list, by structural type identity — the second
// dedup of the same alternatives `noteHoleAlt`/`holeAltIndex` already dedup by `tyEq`,
// rather than the render-equality `tyToStr(m)` keys on: that truncates at depth and renders
// `Nullable(TyFunc)`/`TyFunc(→ Nullable)` alike, so `tyEq` decides structurally instead.
function tyArrHasEq(xs: i32[], v: i32) {
  let i = 0
  while i < xs.length {
    if tyEq(xs[i], v) { return true }
    i = i + 1
  }
  false
}

// Alternative `k` as the caller actually experiences it: the `is`-tested type conjoined
// with the demanded fields a guard-taking argument still reaches. `holeDemandOk` requires
// both, so rendering the tested type alone produced a self-contradictory diagnostic that
// named an arm the rejected argument appears to satisfy.
function holeAltRenderTy(shape: i32, k: i32) {
  const alt = holeAltTys[k]
  const resid = holeAltResidualTy(shape, k)
  if resid < 0 { return alt }
  const at = T.tys[alt]
  const rt = T.tys[resid]
  if at is TyObj {
    if rt is TyObj {
      const names: string[] = []
      const tys: i32[] = []
      let i = 0
      while i < rt.objFieldNames.length {
        if objFieldType(at, rt.objFieldNames[i]) < 0 {
          names.push(rt.objFieldNames[i])
          tys.push(rt.objFieldTypes[i])
        }
        i = i + 1
      }
      let j = 0
      while j < at.objFieldNames.length {
        names.push(at.objFieldNames[j])
        tys.push(at.objFieldTypes[j])
        j = j + 1
      }
      return mkObjTy(names, tys)
    }
  }
  alt
}

// The full expectation for hole `name` as one type: the demanded shape alone, or — when the
// body also `is`-tested the hole — the disjunction of every accepted arm, so the diagnostic
// and hover both name all of them. Each alternative renders with its still-required
// residual folded in. -1 when the hole demands nothing.
function holeDemandTy(name: string) {
  // A map demand is the whole expectation on its own — `holeDemandOk` requires it
  // unconditionally, so it is not one arm of the disjunction.
  const hmd = holeMapOf(name)
  if hmd >= 0 { return hmd }
  const shape = holeShapeOf(name)
  const members: i32[] = []
  let k = 0
  while k < holeAltNames.length {
    if holeAltNames[k] == name {
      const m = holeAltRenderTy(shape, k)
      if !tyArrHasEq(members, m) { members.push(m) }
    }
    k = k + 1
  }
  if shape >= 0 {
    if !tyArrHasEq(members, shape) { members.push(shape) }
  }
  if members.length == 0 { return -1 }
  if members.length == 1 { return members[0] }
  mkUnionTy(members)
}

// `holeDemandTy` rendered — the `expected …` half of a failed hole-demand check.
function holeDemandStr(name: string) {
  const d = holeDemandTy(name)
  // "Demands nothing" is the same blank `tyToStrAt` writes for an absent arena entry,
  // and it must stay the same token: this string lands in the `expected …` half of a
  // message whose `got …` half comes from that renderer.
  if d < 0 { return "_" }
  tyToStr(d)
}

// Records that hole `name` is indexed (so it demands an array). Idempotent.
function noteArrayDemand(name: string) {
  let i = 0
  while i < holeArrayDemand.length {
    if holeArrayDemand[i] == name { return 0 }
    i = i + 1
  }
  holeArrayDemand.push(name)
  0
}

// The array builtin methods that constrain an un-annotated-param hole receiver to an array
// (rather than growing a `{method: any}` struct shape). Element-bearing and array-specific —
// a map exposes `set`/`add`/`has`/`delete`/`keys`/`values`, never these — so recognizing them
// on a hole can't hijack a genuine map/struct use.
function holeArrMethod(name: string) {
  name == "map" || name == "filter" || name == "push" || name == "pop"
}

// The map/set builtin methods that constrain an un-annotated-param hole receiver to a map —
// the exact dual of `holeArrMethod`. Disjoint from the array methods and from every string
// method; `length`/`size` are not here because they are member reads shared by all three
// collections and already special-cased at the member arm.
function holeMapMethod(name: string) {
  name == "set" ||
    name == "get" ||
    name == "has" ||
    name == "delete" ||
    name == "add" ||
    name == "keys" ||
    name == "values"
}

// The demanded map type of hole `name` (the arena index of a `TyMap` whose key/value the
// callee's own map operations pin in place, exactly as `.push` pins an empty `[]`'s
// element), or -1 when the hole has no map demand. Parallel columns, like `holeShape*`.
function holeMapOf(name: string) {
  let i = 0
  while i < holeMapNames.length {
    if holeMapNames[i] == name { return holeMapTys[i] }
    i = i + 1
  }
  -1
}

// Get-or-create hole `name`'s demanded map: an open `{[?]: ?}` on first use, then the same
// arena entry for every later map operation, accumulating onto one type. `isSet` mints the
// Set flavor, the only thing `.add` on a hole can mean. True if the demand still has an open
// half — the callee only reads the map, pinning neither key nor value.
function holeMapDemandOpen(ty: i32) {
  if ty < 0 { return true }
  const t = T.tys[ty]
  if t is TyMap {
    // A hole in either half counts as open, not just the `-1` no-type-yet: `q[k] = v`
    // inside a callee whose `k`/`v` are themselves un-annotated params pins the demand to
    // those holes, a non-negative index that is still undecided.
    if t.mKey < 0 || t.mVal < 0 { return true }
    return tyIsHole(t.mKey) || tyIsHole(t.mVal)
  }
  true
}

// Reports a failed hole-argument demand — one home for the wording, shared by the general
// call path and the UFCS one. An open map demand gets its own sentence, since the generic
// `expected …, got …` would render the unpinned demand and read as a mismatch.
function holeArgDemandErr(name: string, argN: i32, at: i32, ix: i32) {
  const hmE = holeMapOf(name)
  if hmE >= 0 {
    if holeMapDemandOpen(hmE) {
      tErr(
        "argument " +
          i32ToStr(argN) +
          ": parameter is used as a map but nothing in the body pins its key or value" +
          " — add a type annotation",
        ix,
      )
      return 0
    }
  }
  tErr(
    "argument " +
      i32ToStr(argN) +
      ": expected " +
      holeDemandStr(name) +
      ", got " +
      tyToStr(at),
    ix,
  )
  0
}

// Reports an argument an indexed hole cannot take — one home for the wording, shared by the
// general call path and the UFCS one. A map argument gets its own sentence: `q[i]` with an
// i32 index is ambiguous between an array and an i32-keyed map, so "expected an array"
// alone would send the reader to change the argument when the fix is to annotate the parameter.
function holeArgArrayErr(argN: i32, at: i32, ix: i32) {
  if at >= 0 {
    const t = T.tys[at]
    if t is TyMap {
      tErr(
        "argument " +
          i32ToStr(argN) +
          ": parameter is indexed with an i32, which is ambiguous between an array and" +
          " an i32-keyed map — add a type annotation",
        ix,
      )
      return 0
    }
  }
  tErr(
    "argument " + i32ToStr(argN) + ": expected an array, got " + tyToStr(at),
    ix,
  )
  0
}

// The first value-bearing return site in a function-literal body, in source order — walking
// blocks, if-arms and loop bodies but never descending into a nested function literal. `-1`
// when every return is bare, so the value came from the body's tail expression instead.
function firstValueRetIn(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = P.nodes[ix]
  if n is RetStmt {
    if n.retArg >= 0 { return n.retArg }
    return -1
  }
  if n is Block {
    let i = 0
    while i < n.blkStmts.length {
      const hit = firstValueRetIn(n.blkStmts[i])
      if hit >= 0 { return hit }
      i = i + 1
    }
    return -1
  }
  if n is IfStmt {
    const hit = firstValueRetIn(n.ifThen)
    if hit >= 0 { return hit }
    return firstValueRetIn(n.ifElse)
  }
  if n is WhileStmt { return firstValueRetIn(n.whileBody) }
  if n is ForRange { return firstValueRetIn(n.frBody) }
  if n is ForIn { return firstValueRetIn(n.fiBody) }
  -1
}

// A template hole's delivery, decided by the hole's type. True when the call is finished
// with (the caller yields `string`), false to let the ordinary argument check run. `string`
// is delivered directly — the render call becomes a `Paren` around the hole, since the
// renderer doesn't take a string. Otherwise a hole-shaped refusal names the domain, read off the renderer, never hard-coded.
function tplHoleHandled(
  callIx: i32,
  callPos: i32,
  holeIx: i32,
  at: i32,
  expected: i32,
) {
  if isStringTy(at) {
    P.nodes[callIx] = P.nodes[mkParen(holeIx, callPos)]
    return true
  }
  if at < 0 { return false }
  const t = T.tys[at]
  if t is TyErr { return false }
  if tyIsHole(at) { return false }
  if assignable(at, expected) { return false }
  tErr(
    "an interpolation hole is `string` or " +
      tyToStr(expected) +
      " — this one is " +
      tyToStr(at),
    holeIx,
  )
  true
}

// Reports an `argument N: expected …, got …` mismatch — one home for the wording and the
// anchor policy, shared by the general call path and the UFCS one. The anchor is the
// argument node, not the call, whose closing-paren anchor is a whole call away. A
// function-literal argument anchors at its first value-bearing return site when only the return type offends; otherwise at the literal's start token.
function argMismatchErr(argN: i32, expected: i32, at: i32, argIx: i32) {
  const msg = "argument " +
    i32ToStr(argN) +
    ": expected " +
    tyToStr(expected) +
    ", got " +
    tyToStr(at) +
    charLitForStringNote(argIx, expected)
  if argIx >= 0 && argIx < P.nodes.length {
    const n = P.nodes[argIx]
    if n is FuncDecl {
      const site = fnLitRetMismatchSite(n, expected, at)
      if site >= 0 { return tErr(msg, site) }
      return tErrAtNodeStart(msg, argIx)
    }
  }
  tErr(msg, argIx)
}

// The offending return site of function-literal `fn` for an `expected` vs `at`
// function-type mismatch, or -1 when no site is provably the offender (a param
// type also disagrees, or the inferred return is a join whose sites may
// disagree — a union, a deferred join, a hole).
function fnLitRetMismatchSite(fn: FuncDecl, expected: i32, at: i32) {
  if expected < 0 || at < 0 { return -1 }
  const et = T.tys[expected]
  if !(et is TyFunc) { return -1 }
  const gt = T.tys[at]
  if !(gt is TyFunc) { return -1 }
  if et.fnParamTypes.length != gt.fnParamTypes.length { return -1 }
  let i = 0
  while i < et.fnParamTypes.length {
    if !tyEq(et.fnParamTypes[i], gt.fnParamTypes[i]) { return -1 }
    i = i + 1
  }
  if tyEq(et.fnRet, gt.fnRet) { return -1 }
  if !isVoidTy(et.fnRet) {
    // Not the void demand (where any value-bearing site offends): the first
    // site is the offender only when every site agreed on one plain type.
    if gt.fnRet < 0 { return -1 }
    const gr = T.tys[gt.fnRet]
    if gr is TyUnion { return -1 }
    if tyIsDeferredJoin(gt.fnRet) { return -1 }
    if tyIsHole(gt.fnRet) { return -1 }
  }
  const site = firstValueRetIn(fn.fnBody)
  if site >= 0 { return site }
  // No explicit value-bearing `return`: the type came from the body's tail
  // expression — its last statement.
  if fn.fnBody >= 0 && fn.fnBody < P.nodes.length {
    const b = P.nodes[fn.fnBody]
    if b is Block {
      if b.blkStmts.length > 0 { return b.blkStmts[b.blkStmts.length - 1] }
    }
  }
  -1
}

function holeMapDemandTy(name: string, isSet: boolean) {
  const have = holeMapOf(name)
  if have >= 0 { return have }
  let mv = -1
  let ms = 0
  if isSet {
    mv = TY_BOOL
    ms = 1
  }
  const ty = mkMapTy(-1, mv, ms)
  holeMapNames.push(name)
  holeMapTys.push(ty)
  ty
}

// Whether any `is` guard in the body tested hole `name` — `holeAltNames` is the record, and
// this is the boolean half. The alternatives are what the guard's branch handles on its own
// path, so a rung that decides from the pin alone must decline (D1342).
function holeHasIsAlt(name: string) {
  let a = 0
  while a < holeAltNames.length {
    if holeAltNames[a] == name { return true }
    a = a + 1
  }
  false
}

function holeIsArrayDemanded(name: string) {
  let i = 0
  while i < holeArrayDemand.length {
    if holeArrayDemand[i] == name { return true }
    i = i + 1
  }
  false
}

// A type that is still an inference hole (`TyVar`): an un-annotated param, or a derived hole.
function tyIsHole(tyIx: i32) {
  if tyIx < 0 { return false }
  const t = T.tys[tyIx]
  if t is TyVar { return true }
  false
}

// —— "is a hole" vs "contains a hole", and the deferred-constraint machinery needs the second ——
// `tyIsHole` answers about the type itself, so `function eqT<T>(a: T, b: T)` deferred the
// constraint while the `T[]` spelling did not — a `TyArray` over a hole is not a hole (D35).
// Depth-bounded rather than cycle-tracked, in the safe direction: a recursive named type returns false at the floor.
function tyHasHole(tyIx: i32) { tyHasHoleAt(tyIx, 0) }

function tyHasHoleAt(tyIx: i32, depth: i32) {
  if tyIx < 0 { return false }
  if depth > 8 { return false }
  const t = T.tys[tyIx]
  if t is TyVar { return true }
  if t is TyArray { return tyHasHoleAt(t.aElem, depth + 1) }
  if t is TyNullable { return tyHasHoleAt(t.nInner, depth + 1) }
  if t is TyMap {
    if tyHasHoleAt(t.mKey, depth + 1) { return true }
    return tyHasHoleAt(t.mVal, depth + 1)
  }
  if t is TyObj {
    const ofts = t.objFieldTypes
    let i = 0
    while i < ofts.length {
      if tyHasHoleAt(ofts[i], depth + 1) { return true }
      i = i + 1
    }
    return false
  }
  if t is TyFunc {
    const pts = t.fnParamTypes
    let k = 0
    while k < pts.length {
      if tyHasHoleAt(pts[k], depth + 1) { return true }
      k = k + 1
    }
    return tyHasHoleAt(t.fnRet, depth + 1)
  }
  if t is TyUnion {
    const ums = t.uMembers
    let u = 0
    while u < ums.length {
      if tyHasHoleAt(ums[u], depth + 1) { return true }
      u = u + 1
    }
    return false
  }
  false
}

// The body whose constraints are being recorded — the innermost top-level declaration on
// the checking stack, or -1 at module scope.
function cstrOwnerTop() {
  if cstrOwnerStack.length == 0 { return -1 }
  cstrOwnerStack[cstrOwnerStack.length - 1]
}

// Does constraint `owner` belong to the body a call to `calleeFn` will instantiate? A
// declared callee adjudicates its own body's constraints and nobody else's; an owner-less
// constraint always applies; a call that cannot name its callee consults everything.
// Scoping the unnamed callee to the enclosing body is wrong: `const f = addT; f(c, c)` has holes that are `addT`'s, not the caller's.
function cstrOwnedBy(owner: i32, calleeFn: i32) {
  if owner < 0 { return true }
  if calleeFn == CSTR_ANYFN { return true }
  if calleeFn == CSTR_NODECL { return true }
  owner == calleeFn
}

// Records a deferred binary-op constraint when either operand is a hole — the body can't
// yet decide the operator's form, so the generic call site validates it under substitution.
// Stamped with the owning declaration, since a `T` in some other generic is a different `T`
// even though `substTyDeep` matches on the name.
function noteBinCstr(lt: i32, op: string, rt: i32) {
  if tyHasHole(lt) || tyHasHole(rt) {
    const owner = cstrOwnerTop()
    let k = 0
    while k < binCstrOp.length {
      if binCstrLt[k] == lt && binCstrOp[k] == op && binCstrRt[k] == rt {
        if binCstrFn[k] == owner { return 0 }
      }
      k = k + 1
    }
    binCstrLt.push(lt)
    binCstrOp.push(op)
    binCstrRt.push(rt)
    binCstrFn.push(owner)
  }
  0
}

// Records a deferred return-type constraint when either side carries a hole — the body
// cannot decide it then. The generic call site re-asks it under substitution, stamped with
// the owning declaration for the same reason `noteBinCstr` is: an unowned list would let
// one generic's declared return adjudicate a sibling's call.
function noteRetCstr(got: i32, want: i32, ix: i32) {
  const gotHole = tyHasHole(got)
  if gotHole || tyHasHole(want) {
    const owner = cstrOwnerTop()
    let k = 0
    while k < retCstrGot.length {
      if retCstrGot[k] == got && retCstrWant[k] == want {
        if retCstrFn[k] == owner { return 0 }
      }
      k = k + 1
    }
    retCstrGot.push(got)
    retCstrWant.push(want)
    retCstrIx.push(ix)
    retCstrFn.push(owner)
    if gotHole { retCstrWOnly.push(0) } else { retCstrWOnly.push(1) }
  }
  0
}

// Records a deferred destination constraint when either side carries a hole — the body
// cannot decide it then. Stamped with the owning declaration, for the same reason
// `noteBinCstr` is. No `wOnly` column: that column exists at the return seam only to gate
// D561's newtype exemption, and this seam has no exemption to gate.
function noteLetCstr(got: i32, want: i32, ix: i32, name: string) {
  if tyHasHole(got) || tyHasHole(want) {
    const owner = cstrOwnerTop()
    let k = 0
    while k < letCstrGot.length {
      if letCstrGot[k] == got && letCstrWant[k] == want {
        if letCstrFn[k] == owner { return 0 }
      }
      k = k + 1
    }
    letCstrGot.push(got)
    letCstrWant.push(want)
    letCstrIx.push(ix)
    letCstrFn.push(owner)
    letCstrName.push(name)
  }
  0
}

// The direct spelling's sentence for a value that does not fit its destination, in one home
// because two sites have to say it and must not drift: `checkLetDeclNode`'s own gate and
// `validateLetCstrs`' pin. `name` is the fork: a declaration can name the binding, a write
// to an already declared place cannot. The single-quote-into-`string` footnote lives here too.
function charLitForStringNote(srcIx: i32, want: i32): string {
  if !isStringTy(want) { return "" }
  if srcIx < 0 || srcIx >= P.nodes.length { return "" }
  const n = P.nodes[srcIx]
  if n is CharLit {
    let inner = n.charText
    if inner.length >= 2 { inner = inner.slice(1, inner.length - 1) }
    let quotable = true
    let i = 0
    while i < inner.length {
      if inner[i] == '"' || inner[i] == '\\' { quotable = false }
      i = i + 1
    }
    const lead = " — a char literal is its i32 code point; use double quotes for a string"
    if quotable { return lead + ": \"" + inner + "\"" }
    return lead
  }
  ""
}

function letAssignMsg(srcIx: i32, got: i32, want: i32, name: string) {
  if name == "" {
    return "cannot assign " +
      tyToStr(got) +
      " to " +
      tyToStr(want) +
      charLitForStringNote(srcIx, want)
  }
  // An object literal (`{}` / `{x: 1}`) assigned to a map type is a category error, not a
  // width mismatch — point at the fix (`Map()`) rather than the opaque
  // "cannot assign {} to … of type {[string]: …}".
  const wantT = T.tys[want]
  let objToMap = false
  if wantT is TyMap {
    if srcIx >= 0 {
      const srcN = P.nodes[srcIx]
      if srcN is ObjLit { objToMap = true }
    }
  }
  if objToMap {
    return "An object literal isn't a map value — construct a map with " +
      "`Map()` (or a set with `Set()`), e.g. `let m: {[string]: i32} = Map()`"
  }
  // Both sides numeric but not assignable ⇒ a lossy/narrowing edge the lossless-only
  // implicit-widening rule won't take silently. Explain the lossiness rather than
  // the opaque "cannot assign i32 to f32".
  if isNumeric(got) && isNumeric(want) {
    return tyToStr(got) +
      " doesn't fit in " +
      tyToStr(want) +
      " — the conversion is lossy and must be made explicit with `as` " +
      "(write `x as " +
      tyToStr(want) +
      "`)"
  }
  "cannot assign " +
    tyToStr(got) +
    " to '" +
    name +
    "' of type " +
    tyToStr(want) +
    charLitForStringNote(srcIx, want)
}

// A builtin method argument's sentence, in one home because the arm and the pin
// (`validateBmCstrs`) both have to say it and must not drift. `ctx` is the type a form
// needs that is neither side of the comparison (the receiver array; the other bound of a string `slice`).
function bmArgMsg(form: i32, label: string, got: i32, want: i32, ctx: i32) {
  if form == BM_PUSH {
    return label + ": cannot add " + tyToStr(got) + " to " + tyToStr(ctx)
  }
  if form == BM_SETVAL || form == BM_SETKEY || form == BM_ADDKEY {
    return label + ": expected " + tyToStr(want) + ", got " + tyToStr(got)
  }
  if form == BM_KEYMUST {
    return label + ": key must be " + tyToStr(want) + ", got " + tyToStr(got)
  }
  if form == BM_INDEXMUST {
    return label + ": index must be " + tyToStr(want) + ", got " + tyToStr(got)
  }
  if form == BM_BOUNDMUST {
    return label + ": bound must be " + tyToStr(want) + ", got " + tyToStr(got)
  }
  if form == BM_EXPECTSA {
    return label + " expects a " + tyToStr(want) + ", got " + tyToStr(got)
  }
  if form == BM_IDXPHRASE {
    return label + " expects an i32 index, got " + tyToStr(got)
  }
  if form == BM_BYTEOFF {
    return label + " expects an i32 byte offset, got " + tyToStr(got)
  }
  if form == BM_BOUNDS0 {
    return label +
      " expects i32 bounds, got " +
      tyToStr(got) +
      " and " +
      tyToStr(ctx)
  }
  label + " expects i32 bounds, got " + tyToStr(ctx) + " and " + tyToStr(got)
}

// The predicate that arm asks, in one home with a sharper consequence: the pin has to ask
// exactly what the body asked or it disagrees with the direct spelling in one of two ways.
// Asking the plain predicate where the arm asks the expression invents a false reject — the
// boolean-into-i32 coercion and float-literal-into-f32 rule live at the expression seam (D551).
function bmArgPred(form: i32, got: i32, want: i32, argIx: i32) {
  if form == BM_PUSH || form == BM_SETVAL {
    return assignableExpr(argIx, got, want)
  }
  if form == BM_SETKEY {
    if assignable(got, want) { return true }
    return nomSlotAccepts(argIx, got, want)
  }
  assignable(got, want)
}

// Records a deferred builtin-method argument constraint when either side carries a hole —
// the body cannot decide it then. The generic call site re-asks it under substitution,
// stamped with the owning declaration for the same reason `noteBinCstr` is.
function noteBmCstr(
  form: i32,
  label: string,
  got: i32,
  want: i32,
  ctx: i32,
  argIx: i32,
) {
  if tyHasHole(got) || tyHasHole(want) {
    const owner = cstrOwnerTop()
    let k = 0
    while k < bmCstrGot.length {
      if bmCstrGot[k] == got && bmCstrWant[k] == want && bmCstrForm[k] == form {
        if bmCstrFn[k] == owner && bmCstrLabel[k] == label { return 0 }
      }
      k = k + 1
    }
    bmCstrGot.push(got)
    bmCstrWant.push(want)
    bmCstrCtx.push(ctx)
    bmCstrIx.push(argIx)
    bmCstrFn.push(owner)
    bmCstrForm.push(form)
    bmCstrLabel.push(label)
  }
  0
}

// The one gate every builtin argument arm asks. True when the position is accepted or
// deferred; false when it is a reject the arm reports with `bmArgMsg`. Deferring returns
// true since a body that already reported its own mismatch has a loud diagnostic, and a
// second one at every call site would repeat it in vaguer words.
function bmArgOk(
  form: i32,
  label: string,
  got: i32,
  want: i32,
  ctx: i32,
  argIx: i32,
) {
  if tyHasHole(got) || tyHasHole(want) {
    noteBmCstr(form, label, got, want, ctx, argIx)
    return true
  }
  bmArgPred(form, got, want, argIx)
}

// The member arm's own sentence, for a receiver type that is not a hole: "" when
// `recv.prop` is a legal read (or deferred), otherwise the exact words `checkMemberNode`
// raises. Mirrors that arm arm-for-arm, in its order — load-bearing, since the pin's whole
// soundness argument is that it refuses only what the direct spelling already refuses.
function memberFloorMsg(objTy: i32, prop: string) {
  if objTy < 0 { return "" }
  const ot = T.tys[objTy]
  if ot is TyObj {
    if objFieldType(ot, prop) >= 0 { return "" }
    return "no field '" + prop + "' on " + tyToStr(objTy)
  }
  if ot is TyErr { return "" }
  if ot is TyUnion {
    if sharedUnionFieldTy(ot, prop) >= 0 { return "" }
    return "field '" +
      prop +
      "' is not on every member of " +
      tyToStr(objTy) +
      " — narrow with `is` first" +
      unionFieldGapNote(ot, prop)
  }
  if ot is TyArray {
    if prop == "length" { return "" }
    return "no field '" + prop + "' on array " + tyToStr(objTy)
  }
  if ot is TyMap {
    if prop == "length" { return "" }
    if prop == "size" { return "" }
    return "no field '" + prop + "' on map " + tyToStr(objTy)
  }
  if ot is TyPrim {
    if ot.primName == "string" {
      if prop == "length" { return "" }
      return "no field '" + prop + "' on string"
    }
  }
  if ot is TyVar { return tpMemberFloorMsg(ot.tvName, prop) }
  // The receiver is a scalar, so `.toString`/`.toStr` on it is almost certainly the
  // migration, not a typo — `stdFmtMovedNote` says which import brings the name back.
  // Deliberately only on this arm: a struct missing a `.toString` field is a different mistake.
  "member access '." +
    prop +
    "' on non-object " +
    tyToStr(objTy) +
    stdFmtMovedNote(prop)
}

// The two spellings a program can reach for and fail to find, and the one import that
// answers both, appended to whatever sentence the lookup failed with. `toString` is an
// ambient builtin and `toStr` is `std:fmt`'s export name, until the rename; both spellings
// stop resolving on the same day. A note on the existing diagnostic, keyed on the spelling alone.
function stdFmtMovedNote(name: string) {
  if name == "toString" {
    return " — `toString` is not a builtin any more, it is `std:fmt`'s: add `import { toString } from \"std:fmt\"`"
  }
  if name == "toStr" {
    return " — `toStr` was renamed to `toString`: add `import { toString } from \"std:fmt\"`"
  }
  ""
}

// Raises the member arm's sentence at node `ix` — `memberFloorMsg`'s words, unless the call
// site banked a missing-import answer for this node, in which case D1230's sentence and its
// `ufcs-not-imported` code replace them. One home for the raise, since `checkMemberNode`
// refuses from seven arms and a per-arm enrichment would silently miss most of them.
function memberFloorErr(objTy: i32, prop: string, ix: i32) {
  const specs = ufcsMissSpecsAt(ix)
  if specs != "" {
    return tErrCodedData(
      ufcsNotImportedMsg(prop, specs, objTy),
      ix,
      CODE_UFCS_NOT_IMPORTED,
      ufcsNotImportedData(prop, specs, objTy),
    )
  }
  // The name is a function in scope that is not a method. Second, so D1230 keeps winning
  // wherever it applies: a name not in scope at all cannot reach this bank (D1570).
  const whyRow = ufcsWhyRow(ix)
  if whyRow >= 0 {
    return tErrCodedData(
      ufcsWhyMsg[whyRow],
      ix,
      CODE_UFCS_NOT_METHOD,
      ufcsWhyData[whyRow],
    )
  }
  // Never raise a wordless diagnostic. `memberFloorMsg`'s "" means "this read is fine or
  // is deferred" — a sentinel its two constraint-pin callers test, and this one, the only
  // one that raises, formatted unconditionally. A rung that answered "" while its own arm
  // went on to refuse printed nothing but a caret (D1004, D1221).
  const msg = memberFloorMsg(objTy, prop)
  if msg == "" {
    return tErr("member access '." + prop + "' on " + tyToStr(objTy), ix)
  }
  tErr(msg, ix)
}

// The exact line to paste, appended below when there is exactly ONE candidate module —
// with two or more the fix is a CHOICE and no one line is right, so the sentence ends
// at "from there" unchanged. Extends the entry's own import (`ufcsSpecAlreadyImported`)
// rather than proposing a second, colliding one.
function ufcsImportEditSuffix(prop: string, specs: string): string {
  if specs == "" { return "" }
  let i = 0
  while i < specs.length {
    if specs[i] == ',' { return "" }
    i = i + 1
  }
  if ufcsSpecAlreadyImported(specs) {
    return " — add `" +
      prop +
      "` to the existing `import { … } from \"" +
      specs +
      "\"`"
  }
  " — add `import { " + prop + " } from \"" + specs + "\"`"
}

// D1230's sentence. The fault is the missing import, so the sentence leads with it — "no
// field 'toEqual' on Expectation<i32>" is true and tells a reader nothing they can act on,
// while the compiler knew `toEqual` is a free `self`-function in a module the file already
// names. The closing clause is the rule, not a hedge: UFCS in this language is explicit by ruling.
function ufcsNotImportedMsg(prop: string, specs: string, objTy: i32) {
  "'" +
    prop +
    "' is not imported — a free `" +
    prop +
    "(self: …)` accepting " +
    tyToStr(objTy) +
    " is exported by " +
    specListQuoted(specs) +
    "; a UFCS call resolves only names in scope, so import `" +
    prop +
    "` from there" +
    ufcsImportEditSuffix(prop, specs)
}

// D1230's payload, the machine half, on the data channel `CODE_UFCS_NOT_IMPORTED` documents.
// `specs` arrives `,`-joined and is split back into one `modules` field per specifier.
// Demangles its own receiver, since the message is demangled downstream once for every
// diagnostic while the data never passes through that renderer — a quick-fix would otherwise read a mangled name no source file contains.
function ufcsNotImportedData(prop: string, specs: string, objTy: i32) {
  let out = diagDataField("member", prop)
  let start = 0
  let i = 0
  while i < specs.length {
    if specs[i] == ',' {
      out = out + diagDataField("modules", specs.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  out = out + diagDataField("modules", specs.slice(start, specs.length))
  out + diagDataField("recv", demangleMsg(tyToStr(objTy)))
}

// D1570's gate classifier — which arm of the UFCS rule refused `recv.prop(argc args)`, given
// that `prop` names a function in scope. 0 = no answer, 1 = the `self`-name rule, 2 = the
// arity range, 3 = the receiver type. Mirrors `ufcsWouldDispatch` arm for arm, and stops
// where that one stops, since this runs on a call that has already failed.
function ufcsNotMethodKind(name: string, recvTy: i32, argc: i32) {
  if (fnDeclIx[name] ?? -1) < 0 { return 0 }
  const fnTy = lookup(name)
  if fnTy < 0 { return 0 }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    const params = ft.fnParamTypes
    if params.length < 1 { return 1 }
    if !declFirstParamIsSelf(name) { return 1 }
    const uDecl = declParamsAfterSelf(name)
    let uRequired = params.length - 1
    if uDecl.length == params.length - 1 { uRequired = fnRequiredArity(uDecl) }
    if argc < uRequired || argc + 1 > params.length { return 2 }
    if !assignable(recvTy, params[0]) { return 3 }
    return 0
  }
  0
}

// The token spelling the first parameter's name in `name`'s declaration, or -1. The
// identifier's own start, not the `Param` node's `nodeToks` anchor — that anchor is the
// annotation's last token, so a rename quick-fix built on it would edit `Cursor`, not `c`.
function ufcsDeclParamTok(name: string) {
  const dIx = fnDeclIx[name] ?? -1
  if dIx < 0 { return -1 }
  const d = P.nodes[dIx]
  if d is FuncDecl {
    if d.fnParams.length == 0 { return -1 }
    const sp = nodePos(d.fnParams[0])
    if sp >= 0 { return tokIndexAt(sp) }
  }
  -1
}

function ufcsDeclParamLine(name: string) {
  const tk = ufcsDeclParamTok(name)
  if tk >= 0 && tk < P.toks.length { return P.toks[tk].line }
  0
}

function ufcsDeclParamCol(name: string) {
  const tk = ufcsDeclParamTok(name)
  if tk >= 0 && tk < P.toks.length { return P.toks[tk].col }
  0
}

// D1570's sentence, one per gate. The fault is never "no such field" — the function the
// author wrote exists, in scope, and the compiler knew which rule turned it down — so each
// sentence names the rule, the offending ingredient, and the edit that fixes it. The
// `self`-name rule stands; only the diagnostic sent readers to hunt a nonexistent field (glean VL-021).
function ufcsNotMethodMsg(
  prop: string,
  name: string,
  recvTy: i32,
  argc: i32,
  kind: i32,
) {
  const plain = demangleMsg(name)
  if kind == 1 {
    const pns = fnParamNamesOf(name)
    if pns.length == 0 {
      return "'" +
        prop +
        "' is not a method — it takes no parameters, and a UFCS call `x." +
        prop +
        "(…)` dispatches only to a function whose FIRST parameter is named `self`; call `" +
        plain +
        "(…)` directly"
    }
    return "'" +
      prop +
      "' is not a method — its first parameter is named `" +
      pns[0] +
      "`, not `self`, and a UFCS call `x." +
      prop +
      "(…)` dispatches only to a `self` first parameter; rename it to `self`, or call `" +
      plain +
      "(…)` directly"
  }
  if kind == 2 {
    const ft2 = T.tys[lookup(name)]
    if ft2 is TyFunc {
      const uDecl2 = declParamsAfterSelf(name)
      let lo = ft2.fnParamTypes.length - 1
      if uDecl2.length == ft2.fnParamTypes.length - 1 {
        lo = fnRequiredArity(uDecl2)
      }
      return "`" +
        plain +
        "` expects " +
        arityWantText(lo, ft2.fnParamTypes.length - 1) +
        " arguments after `self`, got " +
        i32ToStr(argc) +
        " — a UFCS call `x." +
        prop +
        "(…)` passes the receiver as `self`"
    }
  }
  const p0Str = ufcsSelfParamStr(name)
  "no method '" +
    prop +
    "' for " +
    tyToStr(recvTy) +
    " — the free function `" +
    plain +
    "` takes `self: " +
    p0Str +
    "`"
}

// The rendered type of `name`'s `self` parameter — the half of the receiver-mismatch sentence
// that says which type it is a method on. "?" only for a callee this ladder never reaches.
function ufcsSelfParamStr(name: string) {
  const fnTy = lookup(name)
  if fnTy >= 0 {
    const ft = T.tys[fnTy]
    if ft is TyFunc {
      if ft.fnParamTypes.length > 0 { return tyToStr(ft.fnParamTypes[0]) }
    }
  }
  "?"
}

// The machine-readable payload for `CODE_UFCS_NOT_METHOD` (D1570): `reason` names which of
// the three refusal kinds fired, so a quick-fix can offer the `self`-name rename without
// parsing the message text; `declLine`/`declCol` locate where that rename lands.
function ufcsNotMethodData(prop: string, name: string, recvTy: i32, kind: i32) {
  let reason = "receiver"
  if kind == 1 { reason = "self-name" }
  if kind == 2 { reason = "arity" }
  let pn = ""
  const pns = fnParamNamesOf(name)
  if pns.length > 0 { pn = pns[0] }
  let out = diagDataField("member", prop)
  out = out + diagDataField("recv", demangleMsg(tyToStr(recvTy)))
  out = out + diagDataField("reason", reason)
  out = out + diagDataField("param", pn)
  out = out + diagDataField("declLine", i32ToStr(ufcsDeclParamLine(name)))
  out + diagDataField("declCol", i32ToStr(ufcsDeclParamCol(name)))
}

// Records `memberFloorErr`'s answer, computed here because only the call site knows `argc`.
// No-ops when no gate claims the call — every member access that is really a missing field
// must stay untouched.
function noteUfcsNotMethod(
  memIx: i32,
  prop: string,
  name: string,
  recvTy: i32,
  argc: i32,
) {
  const kind = ufcsNotMethodKind(name, recvTy, argc)
  if kind == 0 { return 0 }
  noteUfcsWhy(
    memIx,
    ufcsNotMethodMsg(prop, name, recvTy, argc, kind),
    ufcsNotMethodData(prop, name, recvTy, kind),
  )
}

// The banked row for member node `memIx`, or -1. A node is banked at most once.
function ufcsWhyRow(memIx: i32) {
  let i = 0
  while i < ufcsWhyAt.length {
    if ufcsWhyAt[i] == memIx { return i }
    i = i + 1
  }
  -1
}

function noteUfcsWhy(memIx: i32, msg: string, data: string) {
  if memIx < 0 { return 0 }
  if msg == "" { return 0 }
  if ufcsWhyRow(memIx) >= 0 { return 0 }
  ufcsWhyAt.push(memIx)
  ufcsWhyMsg.push(msg)
  ufcsWhyData.push(data)
  0
}

// The index arm's own sentence: "" when `recv[i]` resolves or defers, otherwise
// `checkIndexNode`'s `cannot index non-array …`. The write-only operator case also answers
// "" rather than borrow that arm's sentence — its diagnostic names a missing declaration,
// not this receiver, and repeating it at a call site the reader never wrote it at would mislead.
function indexFloorMsg(arrTy: i32) {
  if arrTy < 0 { return "" }
  if tyBuiltinIndexable(arrTy) { return "" }
  if opIdxDeclared() {
    if opIdxFnFor(OP_INDEX_GET, arrTy) != "" { return "" }
    if opIdxFnFor(OP_INDEX_SET, arrTy) != "" { return "" }
  }
  const at = T.tys[arrTy]
  if at is TyObj {
    // The index trap: gated exactly as the arm gates it — a `"[]"` field of any shape
    // other than a one-parameter function falls through there and must fall through here too.
    const trap = objFieldType(at, OP_INDEX_GET)
    if trap >= 0 {
      const tt = T.tys[trap]
      if tt is TyFunc {
        if tt.fnParamTypes.length == 1 { return "" }
      }
    }
  }
  "cannot index non-array " + tyToStr(arrTy)
}

// `memberFloorMsg` / `indexFloorMsg` in one call, keyed the way the table stores the
// operation: `OP_INDEX_GET` is the index form, anything else is that member name.
function memCstrMsg(recv: i32, prop: string) {
  if prop == OP_INDEX_GET { return indexFloorMsg(recv) }
  memberFloorMsg(recv, prop)
}

// Records a deferred receiver-classification constraint when the receiver still carries a
// hole, so the generic call site re-asks whether `T` is a collection under substitution.
// Stamped with the owning declaration — `substTyDeep` matches `TyVar`s by name, so an
// unowned row would let one generic's `.length` adjudicate a sibling's call.
function noteMemCstr(recv: i32, prop: string, ix: i32, dem: boolean) {
  if recv < 0 { return 0 }
  if tyHasHole(recv) {
    const owner = cstrOwnerTop()
    let k = 0
    while k < memCstrTy.length {
      if memCstrTy[k] == recv && memCstrProp[k] == prop {
        if memCstrFn[k] == owner { return 0 }
      }
      k = k + 1
    }
    memCstrTy.push(recv)
    memCstrProp.push(prop)
    memCstrIx.push(ix)
    memCstrFn.push(owner)
    memCstrDem.push(dem)
  }
  0
}

// Records a deferred UFCS-receiver constraint when the receiver still carries a hole, so
// the generic call site re-asks whether it is a receiver this `self`-function takes, under
// substitution. Stamped with the owning declaration for the by-name `TyVar` reason
// `noteMemCstr` needs it.
function noteUfcsCstr(recv: i32, prop: string, ix: i32, p0: i32) {
  if recv < 0 { return 0 }
  if tyHasHole(recv) {
    const owner = cstrOwnerTop()
    let k = 0
    while k < ufcsCstrTy.length {
      if ufcsCstrTy[k] == recv && ufcsCstrProp[k] == prop {
        if ufcsCstrFn[k] == owner && ufcsCstrP0[k] == p0 { return 0 }
      }
      k = k + 1
    }
    ufcsCstrTy.push(recv)
    ufcsCstrProp.push(prop)
    ufcsCstrIx.push(ix)
    ufcsCstrFn.push(owner)
    ufcsCstrP0.push(p0)
  }
  0
}

// The bitwise ops and the shifts, in one list read by both `checkBinary`'s reject and
// `binOpDefinedFor`'s pin mirror — the two homes must agree about the operator set, so this
// predicate is their single source. `%` is excluded: float remainder has a lowering
// (`fmod`), and every other operator here is a pure bit-pattern operation.
function binIntOnlyOp(op: string) {
  op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" || op == ">>>"
}

// Is either operand a float primitive? The other half of the integer-only rule, kept in
// one home for the same reason. Asked of the softened types at both call sites, so a float
// literal union answers as its base scalar.
function binFloatOperandPair(lt: i32, rt: i32) {
  primNameOf(lt) == "f64" ||
    primNameOf(lt) == "f32" ||
    primNameOf(rt) == "f64" ||
    primNameOf(rt) == "f32"
}

// Whether an object left operand has an operator dispatch for `op` (a free `self`-function
// named for the operator, or an operator field), asked from types alone since `opSelfFnTy`
// needs the right operand's node and can report diagnostics. Deliberately the weaker
// question: a false true costs nothing extra, a false false rejects a program that runs.
function objOpDispatchTy(op: string, lt: i32) {
  const ot = T.tys[lt]
  if ot is TyObj {
    if objFieldType(ot, op) >= 0 { return true }
  } else {
    return false
  }
  objOpSelfFnRetTy(op, lt) >= 0
}

// `checkBinary`'s dispatch arm as a type question: does `lt op …` resolve to a free
// `self`-function overload, and to what result type (-1 = no dispatch)? The `is TyObj` gate
// is load-bearing since a non-object receiver takes the language's own lowering and consults
// no declaration. Shared by `binOpDefinedFor`'s pin gate and `substHoleTy`'s `HD_BINOP` result, which must agree.
function objOpSelfDispatchTy(op: string, lt: i32) {
  const ot = T.tys[lt]
  if !(ot is TyObj) { return -1 }
  objOpSelfFnRetTy(op, lt)
}

// The self-function half of `objOpDispatchTy`, answering with the overload's return type
// (-1 = no dispatch) instead of a boolean. `objOpDispatchTy` also admits the operator-field
// route since a false true there is free; this one must not, because `monoPinBinOps` only
// rewrites through `drwSelfFnOf(op, 2)` and has no struct-table row for a field closure.
function objOpSelfFnRetTy(op: string, lt: i32) {
  const fnTy = lookup(op)
  if fnTy < 0 { return -1 }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    if ft.fnParamTypes.length != 2 { return -1 }
    const dIx = fnDeclIx[op] ?? -1
    if dIx < 0 { return -1 }
    const d = P.nodes[dIx]
    if d is FuncDecl {
      if d.fnParams.length == 2 {
        const p0 = P.nodes[d.fnParams[0]]
        if p0 is Param {
          if p0.parName == "self" {
            if assignable(lt, ft.fnParamTypes[0]) { return ft.fnRet }
          }
        }
      }
    }
  }
  -1
}

// Whether the emitter can lower `lt op rt` for two concrete operand types — the soundness
// criterion a generic call site checks after substituting a hole to its argument type. A
// still-unresolved operand defers (true — the outer call validates it). Mirrors
// `checkBinary`'s accepted forms and its arm order; operators not modelled here return true.
function binOpDefinedFor(op: string, lt0: i32, rt0: i32) {
  const lt = softenLitTy(lt0)
  const rt = softenLitTy(rt0)
  if tyHasHole(lt) || tyHasHole(rt) { return true }
  if op == "==" || op == "!=" {
    // Mutual compatibility (no cross-type equality) with two exemptions: a nullness test
    // defers to `checkBinary`'s null arms, and a nominal brand is erased before comparing.
    if isNullTy(lt) || isNullTy(rt) { return true }
    const eqL = nomErasedTyIx(lt)
    const eqR = nomErasedTyIx(rt)
    if !assignable(eqL, eqR) && !assignable(eqR, eqL) { return false }
    // Pinned equality is held to the same two gates as the direct spelling — inside a
    // generic body `T` looks equatable (a `TyVar` is opaque) with nobody left to ask (D35).
    const pinMsgs: string[] = []
    const pinChan: i32[] = []
    eqRefusals(op, lt, rt, true, pinMsgs, pinChan)
    return pinMsgs.length == 0
  }
  // The object-dispatch gate, positioned exactly where `checkBinary`'s own arm order
  // puts it — self-function overloads only; the operator-field route is `objOpDispatchTy`'s.
  if objOpSelfDispatchTy(op, lt0) >= 0 { return true }
  if op == "+" {
    // Unsoftened types on purpose: `checkBinary`'s `+` arm concatenates strings and lists
    // before softening a literal union, and mirroring that order matters for what it accepts.
    if isStringTy(lt0) && isStringTy(rt0) {
      return true // string concat
    }
    const lArr0 = T.tys[lt0]
    if lArr0 is TyArray {
      const rArr0 = T.tys[rt0]
      if rArr0 is TyArray {
        // Element agreement is `checkBinary`'s to report; lowering does not depend on
        // element type at all, so every list pair the direct spelling admits lowers here too.
        return true
      }
    }
    return isNumeric(lt) && isNumeric(rt)
  }
  if op == "-" || op == "*" || op == "/" {
    return isNumeric(lt) && isNumeric(rt)
  }
  if op == "%" {
    // `%` shares the arithmetic rule rather than the integer-only one below so it still
    // reaches the operator-field dispatch route `checkBinary` checks before any numeric rule.
    if objOpDispatchTy(op, lt) { return true }
    return isNumeric(lt) && isNumeric(rt)
  }
  if binIntOnlyOp(op) {
    // Mirrors `checkBinary`'s arm order, not just its predicates: the object-dispatch defer
    // above must run first, or an object receiver with a real dispatch is falsely rejected here.
    if objOpDispatchTy(op, lt) { return true }
    if !isNumeric(lt) || !isNumeric(rt) { return false }
    return !binFloatOperandPair(lt, rt)
  }
  if op == "<" || op == ">" || op == "<=" || op == ">=" {
    if isStringTy(lt) && isStringTy(rt) { return true }
    return isNumeric(lt) && isNumeric(rt)
  }
  true
}

// Records a deferred call-argument constraint: hole-typed argument `at` flowed into the
// concrete param type `exp` of callee `who`. Idempotent per `(at, exp)`. An `exp` still
// carrying a hole is not recorded — after substitution at the inner call it can only be one
// of the enclosing body's own holes, which surfaces through that hole's own bindings instead.
function noteArgCstr(at: i32, exp: i32, who: string) {
  if tyIsDeferredJoin(exp) { return 0 }
  let k = 0
  while k < argCstrAt.length {
    if argCstrAt[k] == at && argCstrExp[k] == exp { return 0 }
    k = k + 1
  }
  argCstrAt.push(at)
  argCstrExp.push(exp)
  argCstrWho.push(who)
  0
}

// Records a deferred `print` constraint when the printed type still carries a hole, so the
// generic call site adjudicates the printed rep under substitution. Stamped with the owning
// declaration for the same by-name `TyVar` reason `noteBinCstr` needs it — an unscoped list
// would make every `<T>` in the program share one namespace.
function notePrintCstr(pt: i32, argIx: i32) {
  if pt < 0 { return 0 }
  if tyHasHole(pt) {
    const owner = cstrOwnerTop()
    let k = 0
    while k < printCstrTy.length {
      if printCstrTy[k] == pt && printCstrIx[k] == argIx {
        if printCstrFn[k] == owner { return 0 }
      }
      k = k + 1
    }
    printCstrTy.push(pt)
    printCstrIx.push(argIx)
    printCstrFn.push(owner)
  }
  0
}

// Re-validates every deferred `print` constraint this call resolves, holding the substituted
// type to the same two floors the direct spelling is held to. A type still touching an
// unresolved hole is re-recorded under the caller's hole and defers. The diagnostic is the
// direct spelling's, verbatim, reported at the call — the only position that knows the instance.
function validatePrintCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
) {
  const nOrigP = printCstrTy.length
  let ci = 0
  while ci < nOrigP {
    if cstrOwnedBy(printCstrFn[ci], calleeFn) {
      const cpt = substTyDeep(printCstrTy[ci], bNames, bTys)
      if calleeFn >= 0 {
        if cpt != printCstrTy[ci] {
          if tyHasHole(cpt) { notePrintCstr(cpt, printCstrIx[ci]) }
        }
      }
      if !tyHasHole(cpt) {
        // The two floors use different channels: a domain rejection (`tErr`, checked first,
        // as at the direct site) versus a capability reject for a union the emitter can't classify.
        let pMsg = ""
        let pUnsup = false
        if tyPrintsAsRef(cpt, 24) {
          pMsg = printRefRefusal(cpt)
        } else {
          pMsg = printUnionRefusal(cpt)
          if pMsg != "" { pUnsup = true }
        }
        if pMsg != "" {
          let pWho = "a type parameter is printed here: "
          if who != "" {
            pWho = "`" + who + "` prints its type parameter here: "
          }
          if pUnsup {
            tErrUnsupported(pWho + pMsg, ix)
          } else {
            tErr(pWho + pMsg, ix)
          }
        }
      }
    }
    ci = ci + 1
  }
  0
}

// Whether `ty` reaches an inference hole (a `TyVar`) anywhere in its tree — through an array
// element, a map key/value, a struct field, a nullable inner, a union member, or a function
// type's params/return. Unlike `tyIsHole`, a demanded shape (`{bar: _}`) counts too, since it
// carries no answer either. Depth-bounded: a recursive type is cyclic in the arena.
function tyReachesHole(ty: i32, depth: i32): boolean {
  if ty < 0 { return true }
  if depth <= 0 { return true }
  const t = T.tys[ty]
  if t is TyVar { return true }
  if t is TyArray { return tyReachesHole(t.aElem, depth - 1) }
  if t is TyMap {
    if tyReachesHole(t.mKey, depth - 1) { return true }
    return tyReachesHole(t.mVal, depth - 1)
  }
  if t is TyNullable { return tyReachesHole(t.nInner, depth - 1) }
  if t is TyObj {
    let i = 0
    while i < t.objFieldTypes.length {
      if tyReachesHole(t.objFieldTypes[i], depth - 1) { return true }
      i = i + 1
    }
    return false
  }
  if t is TyUnion {
    let m = 0
    while m < t.uMembers.length {
      if tyReachesHole(t.uMembers[m], depth - 1) { return true }
      m = m + 1
    }
    return false
  }
  if t is TyFunc {
    let p = 0
    while p < t.fnParamTypes.length {
      if tyReachesHole(t.fnParamTypes[p], depth - 1) { return true }
      p = p + 1
    }
    if t.fnRet == -2 { return true }
    return tyReachesHole(t.fnRet, depth - 1)
  }
  false
}

// Records a hole's flow into a concrete destination while the parameter-solve probe runs.
// The destination must be fully concrete — anything still reaching a `TyVar` carries no
// answer and is skipped. A demanded shape (`{bar: _}`, accumulated from field usage) is a
// lower bound collected from usage, never adopted as the parameter's exact type.
function noteHoleFlow(src: i32, dst: i32) {
  if !paramSolveProbe { return 0 }
  noteHoleFlowGo(src, dst, 6)
}

// The parallel src/dst walk `noteHoleFlow` records through: a bare hole meeting a concrete
// destination is the answer, and a composite source (`{f: u}`, `[u]`, a map store) descends
// into the matching destination position so the per-position hole is reached instead of
// short-circuited by `assignable`. Only matching shapes descend — a mismatch stays a diagnostic.
function noteHoleFlowGo(src: i32, dst: i32, depth: i32) {
  if depth <= 0 { return 0 }
  if src < 0 || dst < 0 { return 0 }
  if tyIsHole(src) {
    if tyIsDeferredJoin(dst) { return 0 }
    if isNeverTy(dst) { return 0 }
    if tyReachesHole(dst, 8) { return 0 }
    const dt = T.tys[dst]
    if dt is TyErr { return 0 }
    // A multi-arm union destination is a choice, not an answer (D1520) — adopting it whole
    // makes the body reject its own operators. A literal union is one rep and stays solvable.
    if dt is TyUnion {
      if !tyIsLitUnion(dst) && numLitUnionBaseTy(dst) < 0 { return 0 }
    }
    holeFlowSrc.push(src)
    holeFlowDst.push(dst)
    return 0
  }
  const s = T.tys[src]
  const d = T.tys[dst]
  if s is TyArray {
    if d is TyArray { return noteHoleFlowGo(s.aElem, d.aElem, depth - 1) }
    return 0
  }
  if s is TyMap {
    if d is TyMap { return noteHoleFlowGo(s.mVal, d.mVal, depth - 1) }
    return 0
  }
  if s is TyNullable {
    if d is TyNullable { return noteHoleFlowGo(s.nInner, d.nInner, depth - 1) }
    return 0
  }
  if s is TyObj {
    if d is TyObj {
      let i = 0
      while i < s.objFieldNames.length {
        let j = 0
        while j < d.objFieldNames.length {
          if d.objFieldNames[j] == s.objFieldNames[i] {
            noteHoleFlowGo(s.objFieldTypes[i], d.objFieldTypes[j], depth - 1)
          }
          j = j + 1
        }
        i = i + 1
      }
    }
    return 0
  }
  0
}

// The hole name of parameter `pi` — the parameter's identity across the pass-1 hoist, the
// body check, and the solve table. A named function keys on its name and position, so the
// hoisted signature and the body bind the identical hole; an anonymous lambda keys on its
// node index instead.
function paramHoleName(fnName: string, fnIx: i32, pi: i32) {
  if fnName != "" { return "?" + fnName + "." + i32ToStr(pi) }
  "?#L" + i32ToStr(fnIx) + "." + i32ToStr(pi)
}

// The type an un-annotated parameter takes — the single source of truth. A parameter whose
// own body pinned it takes that type as if annotated; one nothing pinned takes a fresh
// inference hole. Every producer (the pass-1 hoist, `checkFuncDeclNode`, the emitter's
// synthesized annotation) reads through here, so none of them can drift apart.
function unannotParamTy(holeName: string) {
  const s = solvedParamTys[holeName] ?? -1
  if s >= 0 { return s }
  mkTyVar(holeName)
}

// Is `name` the hole name of one of `fnIx`'s own parameters? A probe's body reaches
// other functions' holes too (a callee's un-annotated parameter, a nested function's),
// and those are not this declaration's to solve.
function holeNameIsParamOf(
  name: string,
  fnName: string,
  fnIx: i32,
  nParams: i32,
) {
  let k = 0
  while k < nParams {
    if paramHoleName(fnName, fnIx, k) == name { return true }
    k = k + 1
  }
  false
}

// Solves every un-annotated parameter of top-level function `fnIx` from its body's usage:
// probes the body once (diagnostics and symbols suppressed) and records the first concrete
// destination per parameter. Top-level only, from pass 1.8 — a statement carries no
// contextual callback type, so the probe's answer is independent of source order.
function solveUnannotParams(fnIx: i32) {
  if paramSolveProbe { return 0 }
  const key = i32ToStr(fnIx)
  if paramSolveTried[key] ?? false { return 0 }
  const fd = P.nodes[fnIx]
  if fd is FuncDecl {
    const ps = fd.fnParams
    let anyHole = false
    let pi = 0
    while pi < ps.length {
      const pn = P.nodes[ps[pi]]
      if pn is Param {
        if pn.parType < 0 {
          if (solvedParamTys[paramHoleName(fd.fnName, fnIx, pi)] ?? -1) < 0 {
            anyHole = true
          }
        }
      }
      pi = pi + 1
    }
    if !anyHole { return 0 }
    paramSolveTried[key] = true
    // Mirrors `inferReturnsPrePass`'s save/restore shape, plus the two deferred-constraint
    // tables whose rows the real pass re-records for itself.
    const savedDiag = T.diags.length
    const savedSym = symEnabled
    const savedRedun = redunName.length
    const savedRcoal = rcoalTok.length
    const savedIsval = isvalTok.length
    const savedQuiet = inferQuiet
    const savedBinN = binCstrOp.length
    const savedArgN = argCstrAt.length
    const savedPrintN = printCstrTy.length
    const savedJoinN = dJoinNode.length
    const nFlow = holeFlowSrc.length
    symEnabled = 0
    inferQuiet = true
    paramSolveProbe = true
    checkFuncDeclNode(fd, fnIx)
    paramSolveProbe = false
    inferQuiet = savedQuiet
    symEnabled = savedSym
    while T.diags.length > savedDiag { T.diags.pop() }
    redunTruncate(savedRedun)
    rcoalTruncate(savedRcoal)
    isvalTruncate(savedIsval)
    while binCstrOp.length > savedBinN {
      binCstrLt.pop()
      binCstrOp.pop()
      binCstrRt.pop()
      binCstrFn.pop()
    }
    while argCstrAt.length > savedArgN {
      argCstrAt.pop()
      argCstrExp.pop()
      argCstrWho.pop()
    }
    while printCstrTy.length > savedPrintN {
      printCstrTy.pop()
      printCstrIx.pop()
      printCstrFn.pop()
    }
    // Keyed by call node rather than by hole name, so a probe's row is not idempotently
    // reused — it blocks the real pass from re-parking the same escaped-join reject.
    while dJoinNode.length > savedJoinN {
      dJoinNode.pop()
      dJoinTy.pop()
    }
    let fi = nFlow
    while fi < holeFlowSrc.length {
      const st = T.tys[holeFlowSrc[fi]]
      if st is TyVar {
        if (solvedParamTys[st.tvName] ?? -1) < 0 {
          if holeNameIsParamOf(st.tvName, fd.fnName, fnIx, ps.length) {
            solvedParamTys[st.tvName] = holeFlowDst[fi]
          }
        }
      }
      fi = fi + 1
    }
    while holeFlowSrc.length > nFlow {
      holeFlowSrc.pop()
      holeFlowDst.pop()
    }
    // Patches the hoisted `TyFunc` in place, gated on this node being the registered
    // top-level declaration — a nested namesake is not hoisted and would corrupt it.
    if fd.fnName != "" && (fnDeclIx[fd.fnName] ?? -1) == fnIx {
      const bound = lookup(fd.fnName)
      if bound >= 0 {
        const bt = T.tys[bound]
        if bt is TyFunc {
          const bpt = bt.fnParamTypes
          let k = 0
          while k < ps.length {
            if k < bpt.length {
              const sv = solvedParamTys[paramHoleName(fd.fnName, fnIx, k)] ?? -1
              if sv >= 0 {
                bpt[k] = sv
                tyMutEpoch = tyMutEpoch + 1 // solved parameter patched in place
              }
            }
            k = k + 1
          }
        }
      }
    }
  }
  0
}

// Records a deferred join that escaped call `ix` to callee `who` lossily — the collapse kept
// one arm and dropped the rest because the join still named unpinned holes. Idempotent per
// `(ty, ix)`. Never recorded from a quiet probe body, since a probe's tables are truncated
// but a constraint validated later, outside the probe, is not.
function noteEscJoin(ty: i32, ix: i32, who: string) {
  if inferQuiet { return 0 }
  if ty < 0 || ix < 0 { return 0 }
  let k = 0
  while k < escJoinTy.length {
    if escJoinTy[k] == ty && escJoinIx[k] == ix { return 0 }
    k = k + 1
  }
  escJoinTy.push(ty)
  escJoinIx.push(ix)
  escJoinWho.push(who)
  0
}

// Re-validates every escaped deferred join this call's bindings decide. A join that re-folds
// to a single type collapsed faithfully — the common case where every arm agrees for this
// argument. One that re-folds to a genuine multi-member union did not, and rejects at the
// inner call, naming both the callee and the union its arms resolve to.
function validateEscJoins(bNames: string[], bTys: i32[]) {
  let ci = 0
  while ci < escJoinTy.length {
    const rj = substTyDeep(escJoinTy[ci], bNames, bTys)
    if rj != escJoinTy[ci] && !tyIsHole(rj) && !tyIsDeferredJoin(rj) {
      const rt = T.tys[rj]
      if rt is TyUnion {
        if rt.uMembers.length > 1 {
          let who = escJoinWho[ci]
          if who == "" { who = "a call" } else { who = "`" + who + "`" }
          tErrUnsupported(
            "the returns of " +
              who +
              " join to " +
              tyToStr(rj) +
              " for this argument — type-valid, but an inferred union return through an" +
              " un-annotated parameter is not yet supported by codegen; annotate the return type",
            escJoinIx[ci],
          )
        }
      }
    }
    ci = ci + 1
  }
  0
}

// Re-validates every deferred call-argument constraint this call resolves: substitutes the
// hole to the call's concrete argument type and checks it against the recorded param type. A
// hole that substitutes to another hole (the callee's hole re-based to the caller's) is
// re-recorded under that hole, or nothing re-checks it once the outer call finally pins it.
function validateArgCstrs(bNames: string[], bTys: i32[], ix: i32) {
  const nOrig = argCstrAt.length
  let ci = 0
  while ci < nOrig {
    const rat = substTyDeep(argCstrAt[ci], bNames, bTys)
    const rexp = substTyDeep(argCstrExp[ci], bNames, bTys)
    if rat != argCstrAt[ci] {
      if tyIsHole(rat) || tyIsDeferredJoin(rat) {
        if !tyIsHole(rexp) { noteArgCstr(rat, rexp, argCstrWho[ci]) }
      }
    }
    // A side still carrying a hole — bare, or as a deferred-join arm — is undecided at this
    // site and defers to the call that pins it.
    if !tyIsHole(rat) && !tyIsDeferredJoin(rat) {
      if !tyIsHole(rexp) && !tyIsDeferredJoin(rexp) {
        if !assignable(rat, rexp) {
          let who = argCstrWho[ci]
          if who == "" { who = "a call" } else { who = "`" + who + "`" }
          tErr(
            "argument of type " +
              tyToStr(rat) +
              " flows into " +
              who +
              " expecting " +
              tyToStr(rexp) +
              " (the call's argument types)",
            ix,
          )
        }
      }
    }
    ci = ci + 1
  }
  0
}

// Whether a return-type mismatch is nominal-only, at a destination the author has no syntax
// to spell: the hole sits on the declared side alone (`wOnly`), the destination is a newtype
// brand, and the body type already fits the brand's unbranded base — the repair would be `x
// as A`, which the language has no form for (`wOnly` is what keeps a body-side hole under a concrete declaration a loud reject, D551).
function retNomOnlyAtHole(wOnly: i32, ix: i32, rg: i32, rw: i32) {
  if wOnly != 1 { return false }
  if !tyIsNewtypeBrand(rw) { return false }
  const b = nomBaseTyIx(rw)
  if b < 0 { return false }
  if b == rw { return false }
  assignableExpr(ix, rg, b)
}

// Re-validates every deferred return-type constraint this call resolves: substitutes the
// call's bindings into the body's returned type and the declared return type, and asks the
// mismatch question the body could only answer vacuously. Re-defers like `validateArgCstrs`
// when a hole substitutes to another hole; the message is the direct spelling's, verbatim.
function validateRetCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
) {
  const nOrigR = retCstrGot.length
  let ci = 0
  while ci < nOrigR {
    if cstrOwnedBy(retCstrFn[ci], calleeFn) {
      const rg = substTyDeep(retCstrGot[ci], bNames, bTys)
      const rw = substTyDeep(retCstrWant[ci], bNames, bTys)
      // Re-records only when the callee is named — an unnamed call cannot reassign ownership
      // — and gates on either side still holding a hole, not just the body side.
      if calleeFn >= 0 {
        if rg != retCstrGot[ci] || rw != retCstrWant[ci] {
          if tyHasHole(rg) || tyHasHole(rw) {
            noteRetCstr(rg, rw, retCstrIx[ci])
          }
        }
      }
      if !tyHasHole(rg) {
        if (
          !tyHasHole(rw) &&
          !retNomOnlyAtHole(retCstrWOnly[ci], retCstrIx[ci], rg, rw)
        ) {
          if !assignableExpr(retCstrIx[ci], rg, rw) {
            let rWho = "the callee's return"
            if who != "" { rWho = "the return of `" + who + "`" }
            tErr(
              "return type mismatch: expected " +
                tyToStr(rw) +
                ", got " +
                tyToStr(rg) +
                " (" +
                rWho +
                " at the call's argument types)",
              ix,
            )
          }
        }
      }
    }
    ci = ci + 1
  }
  0
}

// Whether the deferred destination constraints this binding resolves hold — the twin of
// `validateRetCstrs` for a `let`/`const` binding rather than a return (D572 is why the two
// need separate tables). Same re-deferral rule; the message is `letAssignMsg`'s, verbatim,
// with the attribution appended since the reader wrote no assignment.
function validateLetCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
) {
  const nOrigL = letCstrGot.length
  let ci = 0
  while ci < nOrigL {
    if cstrOwnedBy(letCstrFn[ci], calleeFn) {
      const lg = substTyDeep(letCstrGot[ci], bNames, bTys)
      const lw = substTyDeep(letCstrWant[ci], bNames, bTys)
      // Re-records only when the callee is named, for the same ownership reason
      // `validateRetCstrs` gates on; also gated on either side holding a hole.
      if calleeFn >= 0 {
        if lg != letCstrGot[ci] || lw != letCstrWant[ci] {
          if tyHasHole(lg) || tyHasHole(lw) {
            noteLetCstr(lg, lw, letCstrIx[ci], letCstrName[ci])
          }
        }
      }
      if !tyHasHole(lg) {
        if !tyHasHole(lw) {
          if !assignableExpr(letCstrIx[ci], lg, lw) {
            let lWho = "the callee's body"
            if who != "" { lWho = "the body of `" + who + "`" }
            tErr(
              letAssignMsg(letCstrIx[ci], lg, lw, letCstrName[ci]) +
                " (" +
                lWho +
                " at the call's argument types)",
              ix,
            )
          }
        }
      }
    }
    ci = ci + 1
  }
  0
}

// Whether the deferred builtin-method-argument constraints this binding resolves hold — the
// twin of `validateLetCstrs` for a `.push`/`.set`/`.add` argument rather than an assignment
// (D582 is why `argCstr*` cannot serve this position). Same re-deferral rule, gated on either
// side; the message is the arm's own (`bmArgMsg`), verbatim, with the attribution appended.
function validateBmCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
) {
  const nOrigB = bmCstrGot.length
  let ci = 0
  while ci < nOrigB {
    if cstrOwnedBy(bmCstrFn[ci], calleeFn) {
      const bg = substTyDeep(bmCstrGot[ci], bNames, bTys)
      const bw = substTyDeep(bmCstrWant[ci], bNames, bTys)
      let bc = bmCstrCtx[ci]
      if bc >= 0 { bc = substTyDeep(bc, bNames, bTys) }
      // Re-records only when the callee is named — an unnamed call cannot reassign
      // ownership of the constraint.
      if calleeFn >= 0 {
        if bg != bmCstrGot[ci] || bw != bmCstrWant[ci] {
          if tyHasHole(bg) || tyHasHole(bw) {
            noteBmCstr(
              bmCstrForm[ci],
              bmCstrLabel[ci],
              bg,
              bw,
              bc,
              bmCstrIx[ci],
            )
          }
        }
      }
      if !tyHasHole(bg) {
        if !tyHasHole(bw) {
          if !bmArgPred(bmCstrForm[ci], bg, bw, bmCstrIx[ci]) {
            let bWho = "the callee's body"
            if who != "" { bWho = "the body of `" + who + "`" }
            tErr(
              bmArgMsg(bmCstrForm[ci], bmCstrLabel[ci], bg, bw, bc) +
                " (" +
                bWho +
                " at the call's argument types)",
              ix,
            )
          }
        }
      }
    }
    ci = ci + 1
  }
  0
}

// Whether the deferred UFCS-receiver constraints this binding resolves hold, in three steps
// mirroring the language's own dispatch precedence: a receiver still carrying a hole
// re-defers; a receiver with a field of that name (any field, `drwWalk`'s `sFieldIndex` test)
// is a field call this constraint does not speak about; otherwise it must fit `self`, in the direct spelling's own words (`memberFloorMsg`).
function validateUfcsCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
) {
  const nOrigU = ufcsCstrTy.length
  let ci = 0
  while ci < nOrigU {
    if cstrOwnedBy(ufcsCstrFn[ci], calleeFn) {
      const ur = substTyDeep(ufcsCstrTy[ci], bNames, bTys)
      if calleeFn >= 0 {
        if ur != ufcsCstrTy[ci] {
          if tyHasHole(ur) {
            noteUfcsCstr(ur, ufcsCstrProp[ci], ufcsCstrIx[ci], ufcsCstrP0[ci])
          }
        }
      }
      if !tyHasHole(ur) {
        // A same-named field takes precedence over the `self`-fit check below.
        if tyFieldTyOf(ur, ufcsCstrProp[ci]) < 0 {
          if !assignable(ur, ufcsCstrP0[ci]) {
            let uMsg = memberFloorMsg(ur, ufcsCstrProp[ci])
            let uSuggest = ""
            if uMsg == "" {
              uMsg = "no method '." + ufcsCstrProp[ci] + "' on " + tyToStr(ur)
              uSuggest = methodDidYouMean(ur, ufcsCstrProp[ci])
            }
            let uWho = "the callee's body"
            if who != "" { uWho = "the body of `" + who + "`" }
            tErr(
              uMsg +
                " — the `" +
                ufcsCstrProp[ci] +
                "` in scope takes " +
                tyToStr(ufcsCstrP0[ci]) +
                " (" +
                uWho +
                " at the call's argument types)" +
                uSuggest,
              ix,
            )
          }
        }
      }
    }
    ci = ci + 1
  }
  0
}

// The demanded shape an unbounded `<T>` accumulated, as one type: every member the owning
// body read off that same receiver, each typed `_`. The twin of `holeDemandTy`, built from
// the deferred rows instead of the hole-shape table, since a declared parameter has no global
// hole name the way an inference hole does (two declarations may both spell theirs `T`).
function tpDemandTy(recv: i32, calleeFn: i32) {
  const names: string[] = []
  const tys: i32[] = []
  let k = 0
  while k < memCstrTy.length {
    if memCstrTy[k] == recv && memCstrDem[k] {
      if cstrOwnedBy(memCstrFn[k], calleeFn) {
        if !listHasStr(names, memCstrProp[k]) {
          names.push(memCstrProp[k])
          tys.push(mkTyVar("?"))
        }
      }
    }
    k = k + 1
  }
  if names.length == 0 { return -1 }
  mkObjTy(names, tys)
}

// Whether the deferred receiver-classification constraints this binding resolves hold — see
// `memCstrTy`'s header for why the index and UFCS arms cannot decide it in the body (D651 /
// D691). The index form defers to the argument-flow gate where it already speaks; a receiver
// that is not the bare parameter is uncovered by either gate, a known bound rather than a defect.
function validateMemCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
  hNames: string[],
  hArgNo: i32[],
  hArgNode: i32[],
) {
  const nOrigM = memCstrTy.length
  let ci = 0
  while ci < nOrigM {
    if cstrOwnedBy(memCstrFn[ci], calleeFn) {
      const mr = substTyDeep(memCstrTy[ci], bNames, bTys)
      if calleeFn >= 0 {
        if mr != memCstrTy[ci] {
          if tyHasHole(mr) {
            noteMemCstr(mr, memCstrProp[ci], memCstrIx[ci], memCstrDem[ci])
          }
        }
      }
      if !tyHasHole(mr) {
        let skip = false
        if memCstrProp[ci] == OP_INDEX_GET {
          if tyRefusesArrayDemand(mr) { skip = true }
        }
        if !skip {
          const mMsg = memCstrMsg(mr, memCstrProp[ci])
          if mMsg != "" {
            // Refuses in the hole's own words, attributed to the argument only when exactly
            // one parameter is spelled with this type variable — otherwise naming one would guess.
            let told = false
            if memCstrDem[ci] {
              const dNo = cstrArgNoOf(memCstrTy[ci], hNames, hArgNo)
              if dNo > 0 && cstrArgCountOf(memCstrTy[ci], hNames) == 1 {
                const dTy = tpDemandTy(memCstrTy[ci], calleeFn)
                if dTy >= 0 {
                  argMismatchErr(
                    dNo,
                    dTy,
                    mr,
                    cstrArgNodeOf(dNo, hArgNo, hArgNode),
                  )
                  told = true
                }
              }
            }
            if !told {
              let mWho = "the callee's body"
              if who != "" { mWho = "the body of `" + who + "`" }
              tErr(mMsg + " (" + mWho + " at the call's argument types)", ix)
            }
          }
        }
      }
    }
    ci = ci + 1
  }
  0
}

// Do every deferred call-argument constraint THIS binding resolves hold (the pure-boolean
// twin of `validateArgCstrs`, for `genericFnAssignable`)? An unresolved hole defers.
function argCstrsHold(bNames: string[], bTys: i32[]) {
  let ci = 0
  while ci < argCstrAt.length {
    const rat = substTyDeep(argCstrAt[ci], bNames, bTys)
    const rexp = substTyDeep(argCstrExp[ci], bNames, bTys)
    if !tyIsHole(rat) && !tyIsDeferredJoin(rat) {
      if !tyIsHole(rexp) && !tyIsDeferredJoin(rexp) {
        if !assignable(rat, rexp) { return false }
      }
    }
    ci = ci + 1
  }
  true
}

// The argument each bare-hole parameter came from, as three parallel arrays keyed by the
// parameter's type-variable name — a deferred constraint is reported at the call but is about
// one argument, which only the call site knows. `selfOff` is 1 for the UFCS spelling, whose
// receiver contributes no entry; only a bare type-variable parameter is recorded, since a hole reached through a shape (`xs: T[]`) is not the argument's own type.
function holeArgOrigins(
  params: i32[],
  args: i32[],
  selfOff: i32,
  hNames: string[],
  hArgNo: i32[],
  hArgNode: i32[],
) {
  let p = selfOff
  while p < params.length {
    if p - selfOff < args.length {
      const t = T.tys[params[p]]
      if t is TyVar {
        hNames.push(t.tvName)
        hArgNo.push(p + 1 - selfOff)
        hArgNode.push(args[p - selfOff])
      }
    }
    p = p + 1
  }
  0
}

// The FIRST 1-based argument number whose parameter is spelled with the operand's own type
// variable, or 0 when none is — a concrete operand (`a + 1`), a UFCS receiver, or a hole
// reached through a shape.
function cstrArgNoOf(tyIx: i32, hNames: string[], hArgNo: i32[]): i32 {
  if tyIx < 0 || tyIx >= T.tys.length { return 0 }
  const t = T.tys[tyIx]
  if t is TyVar {
    let k = 0
    while k < hNames.length {
      if hNames[k] == t.tvName { return hArgNo[k] }
      k = k + 1
    }
  }
  0
}

// How many parameters share that type variable — the guard on naming which argument an
// operand is. `function g<T>(a: T, b: T) { a ^ b }` records `T ^ T` for both `a ^ b` and
// `a ^ a`, so naming one argument would be a guess and "uses it on both sides" would be
// false; a shared type variable keeps the un-attributed sentence.
function cstrArgCountOf(tyIx: i32, hNames: string[]): i32 {
  if tyIx < 0 || tyIx >= T.tys.length { return 0 }
  const t = T.tys[tyIx]
  let n = 0
  if t is TyVar {
    let k = 0
    while k < hNames.length {
      if hNames[k] == t.tvName { n = n + 1 }
      k = k + 1
    }
  }
  n
}

// The argument EXPRESSION node for 1-based argument `argNo`, or -1.
function cstrArgNodeOf(argNo: i32, hArgNo: i32[], hArgNode: i32[]): i32 {
  let k = 0
  while k < hArgNo.length {
    if hArgNo[k] == argNo { return hArgNode[k] }
    k = k + 1
  }
  -1
}

// Re-validates every deferred binary-op constraint this call resolves: substitutes the holes
// to the call's concrete argument types and checks the operator is defined for them — the one
// rule numeric, string and relational operators all reduce to. Re-defers when a hole
// substitutes to another hole; scoped to the callee (`cstrOwnedBy`) for the same by-name reason `noteMemCstr` needs it.
function validateBinCstrs(
  bNames: string[],
  bTys: i32[],
  ix: i32,
  calleeFn: i32,
  who: string,
  hNames: string[],
  hArgNo: i32[],
  hArgNode: i32[],
) {
  const nOrigB = binCstrOp.length
  let ci = 0
  while ci < nOrigB {
    if cstrOwnedBy(binCstrFn[ci], calleeFn) {
      const clt = substTyDeep(binCstrLt[ci], bNames, bTys)
      const crt = substTyDeep(binCstrRt[ci], bNames, bTys)
      // Re-records only when the callee is named — an unnamed call cannot reassign ownership,
      // or a HOF's own element hole could adopt a sibling generic's constraint as its own.
      if calleeFn >= 0 {
        if clt != binCstrLt[ci] || crt != binCstrRt[ci] {
          if tyHasHole(clt) || tyHasHole(crt) {
            noteBinCstr(clt, binCstrOp[ci], crt)
          }
        }
      }
      if !tyHasHole(clt) {
        if !tyHasHole(crt) {
          // The equality refusal (in the direct spelling's own words) replaces the generic
          // sentence here, with the attribution placed in front since it ends on a remedy clause.
          const pMsgs: string[] = []
          const pChan: i32[] = []
          if binCstrOp[ci] == "==" || binCstrOp[ci] == "!=" {
            eqRefusals(binCstrOp[ci], clt, crt, true, pMsgs, pChan)
          }
          if pMsgs.length > 0 {
            let pWho = "a type parameter is compared with `" +
              binCstrOp[ci] +
              "` here: "
            if who != "" {
              pWho = "`" +
                who +
                "` compares its type parameter with `" +
                binCstrOp[ci] +
                "` here: "
            }
            let pm = 0
            while pm < pMsgs.length {
              const pTxt = pWho + pMsgs[pm]
              if pChan[pm] == 1 {
                tErrUnsupported(pTxt, ix)
              } else {
                tErr(pTxt, ix)
              }
              pm = pm + 1
            }
          } else if !binOpDefinedFor(binCstrOp[ci], clt, crt) {
            // The refusal sentence is the direct spelling's, verbatim; the anchor moves to
            // the first argument (not the call's last token) so a one-line call carets correctly.
            const lNo = cstrArgNoOf(binCstrLt[ci], hNames, hArgNo)
            const rNo = cstrArgNoOf(binCstrRt[ci], hNames, hArgNo)
            const lN = cstrArgCountOf(binCstrLt[ci], hNames)
            const rN = cstrArgCountOf(binCstrRt[ci], hNames)
            const refusal = "operator '" +
              binCstrOp[ci] +
              "' is not defined for " +
              tyToStr(clt) +
              " and " +
              tyToStr(crt)
            let anchorNo = lNo
            if anchorNo == 0 { anchorNo = rNo }
            let msg = refusal + " (the call's argument types)"
            if lN <= 1 && rN <= 1 && anchorNo > 0 {
              let bodyWho = "the callee's body"
              if who != "" { bodyWho = "the body of `" + who + "`" }
              // One argument responsible gets the `argument N:` head every other diagnostic
              // uses; two get no head (it would blame one) and the tail names both instead.
              let head = "argument " + i32ToStr(anchorNo) + ": "
              let tail = " (" +
                bodyWho +
                " applies '" +
                binCstrOp[ci] +
                "' to this argument)"
              if lNo != 0 && rNo != 0 {
                if lNo == rNo {
                  tail = " (" +
                    bodyWho +
                    " uses it on both sides of '" +
                    binCstrOp[ci] +
                    "')"
                } else {
                  head = ""
                  tail = " (" +
                    bodyWho +
                    " applies '" +
                    binCstrOp[ci] +
                    "' to arguments " +
                    i32ToStr(lNo) +
                    " and " +
                    i32ToStr(rNo) +
                    ")"
                }
              }
              msg = head + refusal + tail
            }
            const aNode = cstrArgNodeOf(anchorNo, hArgNo, hArgNode)
            if aNode >= 0 {
              // The argument's START, not its `nodeToks` last-token anchor: an argument that
              // is a composite (`{ foo: "bar" }`) would otherwise caret its closing brace.
              tErrAtNodeStart(msg, aNode)
            } else {
              tErr(msg, ix)
            }
          }
        }
      }
    }
    ci = ci + 1
  }
  0
}

// A type that definitively CANNOT be indexed `[i]`: a scalar primitive (i32 / f64 / i64 /
// f32 / boolean / null / …) — anything but a `string`. An array / string / struct (may carry
// a `"[]"` trap) / map / hole / error is NOT rejected here (it resolves or defers).
function tyIsNonIndexableScalar(tyIx: i32) {
  if tyIx < 0 { return false }
  const t = T.tys[tyIx]
  if t is TyPrim { return t.primName != "string" }
  false
}

// A type an indexed hole (`self[i]`, so the body demanded an array) cannot take. A
// non-indexable scalar cannot be indexed at all; a map can, but by its key and to a nullable
// value — a discipline the body's own array-typed read does not assume, so accepting a map
// here would mismatch it. Ambiguity between `i32[]` and `{[i32]: V}` is rejected rather than guessed (ROADMAP E5).
function tyRefusesArrayDemand(tyIx: i32) {
  if tyIsNonIndexableScalar(tyIx) { return true }
  if tyIx < 0 { return false }
  const t = T.tys[tyIx]
  t is TyMap
}

// Member access on an inference hole: records the field on the hole's demanded shape and
// returns the field's derived hole. Takes both `holeIx` and `holeName` since the caller has
// already narrowed the receiver — do not collapse to one parameter: re-deriving from the name
// alone miscompiles a field bound through a negated `is` + early return into a `const`.
function holeMemberTy(holeIx: i32, holeName: string, prop: string) {
  if holeIx < 0 { return TY_ERR }
  let shape = holeShapeOf(holeName)
  if shape < 0 {
    const fnames: string[] = []
    const ftys: i32[] = []
    shape = mkObjTy(fnames, ftys)
    holeShapeNames.push(holeName)
    holeShapeTys.push(shape)
  }
  const st = T.tys[shape]
  if st is TyObj {
    const f = objFieldType(st, prop)
    if f >= 0 { return f }
    const d = mkDerivedHole(HD_FLD, prop, -1, -1, holeIx)
    if d < 0 { return TY_ERR }
    st.objFieldNames.push(prop)
    st.objFieldTypes.push(d)
    tyMutEpoch = tyMutEpoch + 1 // hole shape gained a field in place
    return d
  }
  TY_ERR
}

// A guarded return member (`HD_GALT`): the type a `return` inside an `is`-guard's
// then-branch contributes, reachable only by an argument that satisfies the guard's tested
// type. The branch and tested types are stable arena indices on the derivation row, so the
// member survives the `holeAlt*` table being truncated. Minted only for a concrete branch type.
function mkGuardedRetTy(t: i32) {
  if t < 0 { return t }
  if tyIsHole(t) { return t }
  if guardAltStack.length == 0 { return t }
  const row = guardAltStack[guardAltStack.length - 1]
  if row < 0 { return t }
  if row >= holeAltNames.length { return t }
  const altTy = holeAltTys[row]
  if altTy < 0 { return t }
  const g = mkDerivedHole(HD_GALT, "", t, altTy, holeAltHoleIx[row])
  if g < 0 { return t }
  g
}

// The derivation row of an arena type, or -1 when it is not a derived hole.
function hdRowOf(tyIx: i32) {
  if tyIx < 0 { return -1 }
  if tyIx >= hdRowOfTy.length { return -1 }
  hdRowOfTy[tyIx]
}

// How many derived-read layers a hole stacks over its base param hole — a stored count,
// computed once per mint, used only to cap the re-basing below.
function hdDepthOf(tyIx: i32) {
  const r = hdRowOf(tyIx)
  if r < 0 { return 0 }
  hdDepth[r]
}

// The hole NAME a derivation renders to. This is the one direction that stays
// stringly: the name is the hole's IDENTITY — generic bindings, demanded shapes,
// array demands and alternative rows are all keyed by it — and rendering a type is
// allowed. Nothing parses it back.
function hdRenderName(
  kind: i32,
  field: string,
  inner: i32,
  alt: i32,
  baseName: string,
) {
  if kind == HD_FLD { return "?fld." + field + "." + baseName }
  if kind == HD_RET { return "?ret." + baseName }
  if kind == HD_ELEM { return "?elem." + baseName }
  // The fallback type rides the name, like the guarded form's two arena indices: two sites
  // over the same hole reaching different no-dispatch answers are different holes.
  if kind == HD_BINOP {
    return "?binop." + field + "." + i32ToStr(inner) + "." + baseName
  }
  // The tested type rides the name because it is the derivation: two `else` arms over one
  // hole testing different types are different remainders.
  if kind == HD_GNOT { return "?gnot." + i32ToStr(alt) + "." + baseName }
  "?galt." + i32ToStr(inner) + "." + i32ToStr(alt) + "." + baseName
}

// MINT a derived hole: a fresh `TyVar` plus the derivation row that says what it
// derives. `base` must be a hole (every derivation reads off one); -1 when it is
// not, which every caller treats as "no derived hole here".
function mkDerivedHole(
  kind: i32,
  field: string,
  inner: i32,
  alt: i32,
  base: i32,
) {
  if base < 0 { return -1 }
  const bt = T.tys[base]
  if !(bt is TyVar) { return -1 }
  const ix = mkTyVar(hdRenderName(kind, field, inner, alt, bt.tvName))
  const row = hdKind.length
  hdKind.push(kind)
  hdField.push(field)
  hdInner.push(inner)
  hdAlt.push(alt)
  hdBase.push(base)
  hdDepth.push(hdDepthOf(base) + 1)
  while hdRowOfTy.length <= ix { hdRowOfTy.push(-1) }
  hdRowOfTy[ix] = row
  ix
}

// Re-basing budget: a derived hole re-based onto an outer hole at every call hop grows its
// name by one layer per hop, and a self-recursive generic body would grow it without bound.
// Past this depth re-basing stops and the name stays unresolved, so the cap can only lose
// diagnostics — an unresolved hole still records its demand and blocks nothing.
const HOLE_REBASE_MAX = 8

// Re-bases derivation `row` onto the hole its base resolved to: "field `bar` of `<hInner>`"
// under a binding `<hInner> := <hOuter>` is "field `bar` of `<hOuter>`" — the same read, now
// named by the caller's hole. Returning the re-based hole (not -1) lets a constraint recorded
// inside a generic body survive the hop out and be re-validated when the caller's hole pins.
function rebaseDerivedHole(row: i32, innerTy: i32) {
  if innerTy < 0 { return -1 }
  const it = T.tys[innerTy]
  if it is TyVar {
    if hdDepthOf(innerTy) >= HOLE_REBASE_MAX { return -1 }
    return mkDerivedHole(
      hdKind[row],
      hdField[row],
      hdInner[row],
      hdAlt[row],
      innerTy,
    )
  }
  -1
}

// Banks the pin `ty` a hole named `name` took. First pin wins; a disagreeing second pin
// poisons the row to `-2`, which `pinnedHoleTyOf` reads as "no answer" — the emitter lowers
// one body for every call, so a rep read off one call's pin would miscompile at the other.
// Never banked from a quiet probe: `solveUnannotParams` truncates its tables afterward.
function notePinnedHole(name: string, ty: i32) {
  if inferQuiet { return 0 }
  if ty < 0 { return 0 }
  const cur = holePinTys[name] ?? -1
  if cur == -1 {
    holePinTys[name] = ty
    return 0
  }
  if cur == ty { return 0 }
  if cur >= 0 {
    if tySame(cur, ty) { return 0 }
  }
  holePinTys[name] = -2
  0
}

// The pin behind arena type `tyIx` when it is a HOLE, or -1 for anything else — a
// non-hole, an unpinned hole, or one two calls pinned differently. The emitter's route to
// the un-softened member set a hole parameter's own recorded type never carries (D1412).
export function pinnedHoleTyOf(tyIx: i32): i32 {
  if tyIx < 0 { return -1 }
  const t = T.tys[tyIx]
  if !(t is TyVar) { return -1 }
  holePinTys[t.tvName] ?? -1
}

// Resolves a (possibly derived) hole against a call's bindings: a direct binding on its name
// wins; a return derivation collapses to the pinned function's return; a field derivation to
// the pinned object's field. A base that resolves to another hole re-bases onto it
// (`rebaseDerivedHole`) instead of going unresolved — the two-level chain where dropping the link let an i32 reach a `string` param with no diagnostic. -1 = unresolved.
function substHoleTy(tyIx: i32, bNames: string[], bTys: i32[]) {
  if tyIx < 0 { return -1 }
  const t = T.tys[tyIx]
  if !(t is TyVar) { return -1 }
  const b = bindOf(bNames, bTys, t.tvName)
  if b >= 0 {
    notePinnedHole(t.tvName, b)
    return b
  }
  const row = hdRowOf(tyIx)
  if row < 0 { return -1 }
  const kind = hdKind[row]
  // A guarded return member (`mkGuardedRetTy`): the pin decides reachability — satisfying the
  // guard's tested type makes the branch live, otherwise it stays unresolved and drops out.
  if kind == HD_GALT {
    const gInner = hdInner[row]
    const gAlt = hdAlt[row]
    if gInner < 0 || gAlt < 0 { return -1 }
    const gPin = substHoleTy(hdBase[row], bNames, bTys)
    if gPin < 0 { return -1 }
    if tyIsHole(gPin) { return rebaseDerivedHole(row, gPin) }
    if holeAssignOk(-1, gPin, gAlt) { return gInner }
    return -1
  }
  // The guard's complement (`else` on a hole): the pin is the first place a remainder exists
  // (`subtractTy` needs a member list); a pin it cannot reduce keeps itself, as the un-narrowed `else` already meant.
  if kind == HD_GNOT {
    const nAlt = hdAlt[row]
    if nAlt < 0 { return -1 }
    const nPin = substHoleTy(hdBase[row], bNames, bTys)
    if nPin < 0 { return -1 }
    if tyIsHole(nPin) { return rebaseDerivedHole(row, nPin) }
    const nRest = subtractTy(nPin, nAlt)
    if nRest >= 0 { return nRest }
    return nPin
  }
  if kind == HD_RET {
    const inner = substHoleTy(hdBase[row], bNames, bTys)
    if inner >= 0 {
      const it = T.tys[inner]
      if it is TyFunc { return it.fnRet }
      return rebaseDerivedHole(row, inner)
    }
    return -1
  }
  // A deferred binary-op result (`mkBinOpRetTy`): an object pin with a `self`-function
  // overload takes the overload's return type; every other pin keeps the body's own answer, mirroring `checkBinExprNode`'s dispatch arm exactly, including its `is TyObj` gate.
  if kind == HD_BINOP {
    const innerB = substHoleTy(hdBase[row], bNames, bTys)
    if innerB < 0 { return -1 }
    if tyIsHole(innerB) { return rebaseDerivedHole(row, innerB) }
    const dTy = objOpSelfDispatchTy(hdField[row], innerB)
    if dTy >= 0 { return dTy }
    // No dispatch: the body's own answer, which may itself name this hole (`return lt` for
    // the arithmetic tail) or be concrete (`TY_BOOL` for an ordering comparison).
    return substTyDeep(hdInner[row], bNames, bTys)
  }
  // The element of an indexed hole (`self[i]`): resolve the hole to its pinned
  // argument; an array yields its element, a string an i32 code point. Mirrors the
  // FIELD read for indexing.
  if kind == HD_ELEM {
    const innerE = substHoleTy(hdBase[row], bNames, bTys)
    if innerE >= 0 {
      const itE = T.tys[innerE]
      if itE is TyArray { return itE.aElem }
      if itE is TyPrim {
        if itE.primName == "string" { return TY_I32 }
      }
      return rebaseDerivedHole(row, innerE)
    }
    return -1
  }
  // HD_FLD. An empty property name never resolves — the string form's `dot > 0`
  // guard, kept verbatim (see `holeBaseTy`).
  if hdField[row].length == 0 { return -1 }
  const inner2 = substHoleTy(hdBase[row], bNames, bTys)
  if inner2 >= 0 {
    const it2 = T.tys[inner2]
    if it2 is TyObj {
      const f = objFieldType(it2, hdField[row])
      if f >= 0 { return f }
    }
    return rebaseDerivedHole(row, inner2)
  }
  -1
}

// Generic call-site binding, deep: walks an expected parameter type against the argument's
// actual type and binds every `TyVar` leaf on first use. Later uses are checked by the caller
// against the substituted expected type, so disagreeing uses still error. Nested positions
// bind too — a `Box<T>` param pins `T` from the argument's field, a callback's from its signature.
export function bindGenWalk(
  expIx: i32,
  atIx: i32,
  bNames: string[],
  bTys: i32[],
) {
  if expIx < 0 || atIx < 0 { return 0 }
  const e = T.tys[expIx]
  if e is TyVar {
    // `T` ranges over value types; `u8` is a storage type with no value rep, so binding it
    // would instantiate an i32-list over a one-byte backing — declined here so `assignable` reports it at the argument instead.
    if primNameOf(atIx) == "u8" { return 0 }
    if bindOf(bNames, bTys, e.tvName) < 0 {
      bNames.push(e.tvName)
      bTys.push(atIx)
    }
    return 0
  }
  let gi = bgSrcStack.length - 1
  while gi >= 0 {
    if bgSrcStack[gi] == expIx && bgDstStack[gi] == atIx { return 0 }
    gi = gi - 1
  }
  bgSrcStack.push(expIx)
  bgDstStack.push(atIx)
  const a = T.tys[atIx]
  if e is TyArray {
    if a is TyArray { bindGenWalk(e.aElem, a.aElem, bNames, bTys) }
  } else if e is TyNullable {
    if a is TyNullable { bindGenWalk(e.nInner, a.nInner, bNames, bTys) }
    else if atIx != TY_NULL { bindGenWalk(e.nInner, atIx, bNames, bTys) }
  } else if e is TyObj {
    if a is TyObj {
      const enames = e.objFieldNames
      const etys = e.objFieldTypes
      let i = 0
      while i < enames.length {
        const sf = objFieldType(a, enames[i])
        if sf >= 0 { bindGenWalk(etys[i], sf, bNames, bTys) }
        i = i + 1
      }
    }
  } else if e is TyFunc {
    if a is TyFunc {
      const ep = e.fnParamTypes
      const ap = a.fnParamTypes
      let i = 0
      while i < ep.length {
        if i < ap.length { bindGenWalk(ep[i], ap[i], bNames, bTys) }
        i = i + 1
      }
      bindGenWalk(e.fnRet, a.fnRet, bNames, bTys)
    }
  } else if e is TyMap {
    // A map/set param (`{[string]: T}`) pins `T` from the argument's value
    // type (the key position walks too, for symmetry).
    if a is TyMap {
      bindGenWalk(e.mKey, a.mKey, bNames, bTys)
      bindGenWalk(e.mVal, a.mVal, bNames, bTys)
    }
  }
  bgSrcStack.pop()
  bgDstStack.pop()
  0
}

// Banks `newTy` as the same generic application `origTy` is, with the arguments substituted
// (D949) — a no-op when `origTy` is not an application, when nothing changed, or when `newTy`
// is already banked (the memo can hand back an index this walk has already seen).
function genAppCarry(origTy: i32, newTy: i32, bNames: string[], bTys: i32[]) {
  if origTy < 0 || newTy < 0 { return 0 }
  if origTy == newTy { return 0 }
  let k = 0
  while k < gaAppTyIxs.length {
    if gaAppTyIxs[k] == newTy { return 0 }
    k = k + 1
  }
  let j = 0
  while j < gaAppTyIxs.length {
    if gaAppTyIxs[j] == origTy {
      const st = gaAppArgStart[j]
      const cn = gaAppArgCount[j]
      // Reads the substituted arguments before pushing the row: `substTyDeep` can bank rows
      // of its own, and a half-written row would be visible to it.
      const subbed: i32[] = []
      let a = 0
      while a < cn {
        subbed.push(substTyDeep(gaAppArgFlat[st + a], bNames, bTys))
        a = a + 1
      }
      cTyIxSetAdd(gaAppTyIxs, gaAppTyIxSet, newTy)
      gaAppHeads.push(gaAppHeads[j])
      gaAppArgStart.push(gaAppArgFlat.length)
      gaAppArgCount.push(cn)
      gaAppFinite.push(0 - 1)
      let b = 0
      while b < subbed.length {
        gaAppArgFlat.push(subbed[b])
        b = b + 1
      }
      return 0
    }
    j = j + 1
  }
  0
}

// Deep substitution of a call's bindings into a type: a bound `TyVar` becomes its binding; a
// derived return hole collapses to the pinned function's return. Composites rebuild only when
// a child actually changed, so a concrete type keeps its arena identity (and the in-place
// pinning semantics that ride on it). A cyclic arena (a recursive named type) returns itself unchanged.
export function substTyDeep(tyIx: i32, bNames: string[], bTys: i32[]) {
  if tyIx < 0 || bNames.length == 0 { return tyIx }
  const t = T.tys[tyIx]
  if t is TyVar {
    const b = substHoleTy(tyIx, bNames, bTys)
    if b >= 0 { return b }
    return tyIx
  }
  let si = stSeenStack.length - 1
  while si >= 0 {
    if stSeenStack[si] == tyIx { return tyIx }
    si = si - 1
  }
  stSeenStack.push(tyIx)
  let res = tyIx
  if t is TyArray {
    const e2 = substTyDeep(t.aElem, bNames, bTys)
    if e2 != t.aElem { res = mkArrayTy(e2) }
  } else if t is TyNullable {
    const n2 = substTyDeep(t.nInner, bNames, bTys)
    if n2 != t.nInner { res = mkNullableTy(n2) }
  } else if t is TyObj {
    const onames = t.objFieldNames
    const otys = t.objFieldTypes
    const out: i32[] = []
    let changed = false
    let i = 0
    while i < otys.length {
      const f2 = substTyDeep(otys[i], bNames, bTys)
      if f2 != otys[i] { changed = true }
      out.push(f2)
      i = i + 1
    }
    if changed {
      const nn: string[] = []
      let j = 0
      while j < onames.length {
        nn.push(onames[j])
        j = j + 1
      }
      res = mkObjTy(nn, out)
    }
  } else if t is TyFunc {
    const ps = t.fnParamTypes
    const out2: i32[] = []
    let changed2 = false
    let k = 0
    while k < ps.length {
      const p2 = substTyDeep(ps[k], bNames, bTys)
      if p2 != ps[k] { changed2 = true }
      out2.push(p2)
      k = k + 1
    }
    const r2 = substTyDeep(t.fnRet, bNames, bTys)
    if r2 != t.fnRet { changed2 = true }
    if changed2 { res = mkFuncTy(out2, r2) }
  } else if t is TyUnion {
    const ms = t.uMembers
    const out3: i32[] = []
    let changed3 = false
    let u = 0
    while u < ms.length {
      const m2 = substTyDeep(ms[u], bNames, bTys)
      if m2 != ms[u] { changed3 = true }
      out3.push(m2)
      u = u + 1
    }
    // A deferred join re-folds: every provably dead member drops and the rest re-joins,
    // checked even when nothing changed — an unresolved member is dead precisely because it did not resolve.
    if isJoinHoleUnion(tyIx) {
      res = refoldJoinUnion(tyIx, ms, out3, changed3, bNames, bTys)
    } else if changed3 {
      // Dedupes by arena-index identity only (not `sameVariantTy`) then rebuilds: substitution
      // can make two members the same type, and matching structurally here would merge members this walk must leave alone (the mixed-union arena shape is load-bearing).
      const uniq: i32[] = []
      let q = 0
      while q < out3.length {
        let seen = false
        let w = 0
        while w < uniq.length {
          if uniq[w] == out3[q] { seen = true }
          w = w + 1
        }
        if !seen { uniq.push(out3[q]) }
        q = q + 1
      }
      // The third union-construction site needing the same subsumed-arm collapse
      // (`unionArmSubsumedBy`) as `annUnionInnerTy` and `fillTypeDeclAt`'s `UnionDecl` arm —
      // the index dedup above cannot see a value-level duplicate like `T | "err"` at `T :=
      // string`. `out` is read unconditionally; treating it as optional would double the member list.
      const kept3: i32[] = []
      unionDropSubsumedArms(uniq, kept3)
      if kept3.length == 1 { res = kept3[0] } else { res = mkUnionTy(kept3) }
    }
  } else if t is TyMap {
    const k2 = substTyDeep(t.mKey, bNames, bTys)
    const v2 = substTyDeep(t.mVal, bNames, bTys)
    if k2 != t.mKey || v2 != t.mVal { res = mkMapTy(k2, v2, t.mSet) }
  } else if t is TyNeg {
    const g2 = substTyDeep(t.negTy, bNames, bTys)
    if g2 != t.negTy { res = mkNegTy(g2) }
  }
  stSeenStack.pop()
  // Carries the application provenance across substitution (D949): the rebuilt type is a
  // fresh arena index the provenance bank does not know about unless re-banked here, or the same type renders under two different names depending which door it came through.
  genAppCarry(tyIx, res, bNames, bTys)
  res
}

// ── free index-operator resolution (B14) ─────────────────────────────────────

// The tail of the parameter list an index operator wants, for the arity error.
function opIdxArityTail(op: string) {
  if op == OP_INDEX_SET { return ", value" }
  ""
}

// Does the program declare ANY index operator? The single inertness gate: false
// for every program that declares none, and then no index expression anywhere
// does any extra work and nothing is banked.
function opIdxDeclared() { opIdxFns.length > 0 }

// A type whose indexing is the language's own, not a user operator's: arrays, maps, strings,
// an un-pinned inference hole, and the error type — the swallow that reaches the built-in
// arms exactly as with no operator declared. A newtype over one of these is deliberately
// included, since a brand renames a type without re-opening a primitive's syntax.
function tyBuiltinIndexable(ty: i32) {
  if ty < 0 { return true }
  const t = T.tys[ty]
  if t is TyArray { return true }
  if t is TyMap { return true }
  if t is TyVar { return true }
  if t is TyErr { return true }
  if t is TyPrim { return t.primName == "string" }
  false
}

// A `self` annotation whose index expression the language always answers itself, so an index
// operator declared over it can never dispatch (D445). Routed through `tyBuiltinIndexable`
// rather than re-listing its arms, so the reject and the swallow cannot drift — minus an
// un-pinned hole (a live receiver) and the error type (already reported at the annotation).
function opIdxDeadRecv(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyVar { return false }
  if t is TyErr { return false }
  tyBuiltinIndexable(ty)
}

// Whether `ty` denotes an object — the one left-operand shape `checkBinary`'s operator
// dispatch admits — looking through a one-member alias box `declaredTyOfName` otherwise keeps
// opaque for the emitter's naming (D425). The look-through happens only at the declaration:
// doing it at the call site would collapse the box the emitter's own twin still reads (D402).
function tyDenotesObj(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyObj { return true }
  if t is TyUnion {
    if t.uMembers.length == 1 {
      const m = T.tys[t.uMembers[0]]
      if m is TyObj { return true }
    }
  }
  false
}

// A `self` annotation that can never be the left operand of an operator dispatch, so a binary
// operator declared over it can never fire (D425's third gate, after D444's arity and D445's
// index receiver). Derived from the dispatch gate rather than restated, so the two cannot
// drift: it subtracts any hole-carrying annotation (a live dispatch receiver) and the error type (already reported at the annotation).
function binOpDeadSelf(ty: i32) {
  if ty < 0 { return false }
  if tyHasHole(ty) { return false }
  const t = T.tys[ty]
  if t is TyErr { return false }
  !tyDenotesObj(ty)
}

// The index-operator function `op` dispatches to for a receiver of type `recvTy` — the first
// declaration whose `self` parameter accepts it, or "" when none does. First-declared wins,
// reachable only when two declared receivers both accept one value (one structurally
// assignable to the other); a nominal newtype is never in that position, since a brand accepts only itself.
function opIdxFnFor(op: string, recvTy: i32) {
  if recvTy < 0 { return "" }
  let i = 0
  while i < opIdxFns.length {
    if opIdxOps[i] == op {
      const nm = opIdxFns[i]
      const fnTy = lookup(nm)
      if fnTy >= 0 {
        // Forces an un-annotated return past its pending sentinel here, exactly as the UFCS
        // and `a op b` resolutions do, so a call ahead of the declaration reads a real type.
        const preFt = T.tys[fnTy]
        if preFt is TyFunc {
          if preFt.fnRet == -2 {
            if !onInferStack(nm) {
              const dIx = fnDeclIx[nm] ?? -1
              if dIx >= 0 { checkNode(dIx) }
            }
          }
        }
        const ft = T.tys[fnTy]
        if ft is TyFunc {
          const ps = ft.fnParamTypes
          if ps.length > 0 {
            if assignable(recvTy, ps[0]) { return nm }
          }
        }
      }
    }
    i = i + 1
  }
  ""
}

// BANK the resolved operator function on its site node, for the emitter's
// dispatch rewrite to read back. Only on the REAL pass — a quiet inference probe
// may resolve against a hole that later pins elsewhere.
function opIdxBank(siteIx: i32, fn: string) {
  if inferQuiet { return 0 }
  if siteIx < 0 { return 0 }
  let i = 0
  while i < opIdxSiteNode.length {
    if opIdxSiteNode[i] == siteIx {
      opIdxSiteFn[i] = fn
      return 0
    }
    i = i + 1
  }
  opIdxSiteNode.push(siteIx)
  opIdxSiteFn.push(fn)
  0
}

// The operator function the checker resolved at index site `ix`, or "" — the
// emitter's read of the bank above.
export function opIdxFnAtNode(ix: i32) {
  if ix < 0 { return "" }
  let i = 0
  while i < opIdxSiteNode.length {
    if opIdxSiteNode[i] == ix { return opIdxSiteFn[i] }
    i = i + 1
  }
  ""
}

// The declared type of parameter `pi` of the operator function `fn`, or -1.
function opIdxParamTy(fn: string, pi: i32) {
  const fnTy = lookup(fn)
  if fnTy < 0 { return -1 }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    const ps = ft.fnParamTypes
    if pi < ps.length { return ps[pi] }
  }
  -1
}

// The declared RETURN type of the operator function `fn` (TY_ERR while pending).
function opIdxRetTy(fn: string) {
  const fnTy = lookup(fn)
  if fnTy < 0 { return TY_ERR }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    if ft.fnRet == -2 { return TY_ERR }
    return ft.fnRet
  }
  TY_ERR
}

// Binds the index operator's declared type parameters from the receiver and key types, the
// way `opSelfFnTy` binds a binary operator's. One `"[]"` function serves every instantiation,
// so its declared types are a template, not the site's own — taken verbatim, an unbound type
// variable would be check-clean and invalid at emit. `keyTy < 0` binds the receiver alone (the write arm).
function opIdxBindGen(
  fn: string,
  recvTy: i32,
  keyTy: i32,
  bNames: string[],
  bTys: i32[],
) {
  const fnTy = lookup(fn)
  if fnTy >= 0 {
    const ft = T.tys[fnTy]
    if ft is TyFunc {
      const ps = ft.fnParamTypes
      if ps.length > 0 { bindGenWalk(ps[0], recvTy, bNames, bTys) }
      if ps.length > 1 {
        if keyTy >= 0 { bindGenWalk(ps[1], keyTy, bNames, bTys) }
      }
    }
  }
}

// Operator dispatch `a op b` over a struct left operand through the free `self`-function
// named for the operator: the function must exist, take exactly `(self, right)`, with its
// first parameter named `self`. Binds the operands into the function's holes like any call
// and substitutes the return; -1 means no such function fits, and the caller falls through to the operator-field lookup or the native numeric paths.
function opSelfFnTy(op: string, lt: i32, rt: i32, rightIx: i32, ix: i32) {
  const fnTy = lookup(op)
  if fnTy < 0 { return -1 }
  const preFt = T.tys[fnTy]
  if preFt is TyFunc {
    if preFt.fnRet == -2 {
      if !onInferStack(op) {
        const dIx = fnDeclIx[op] ?? -1
        if dIx >= 0 { checkNode(dIx) }
      }
    }
  } else {
    return -1
  }
  const dIx2 = fnDeclIx[op] ?? -1
  if dIx2 < 0 { return -1 }
  const d = P.nodes[dIx2]
  let selfOk = false
  if d is FuncDecl {
    if d.fnParams.length == 2 {
      const p0 = P.nodes[d.fnParams[0]]
      if p0 is Param {
        if p0.parName == "self" { selfOk = true }
      }
    }
  }
  if !selfOk { return -1 }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    let retTy = ft.fnRet
    if retTy == -2 { retTy = TY_ERR }
    const params = ft.fnParamTypes
    if params.length != 2 { return -1 }
    if !assignable(lt, params[0]) { return -1 }
    const bNames: string[] = []
    const bTys: i32[] = []
    const p0t = T.tys[params[0]]
    if p0t is TyVar {
      if !holeDemandOk(p0t.tvName, -1, lt) { return -1 }
    }
    bindGenWalk(params[0], lt, bNames, bTys)
    bindGenWalk(params[1], rt, bNames, bTys)
    const expected = substTyDeep(params[1], bNames, bTys)
    const p1t = T.tys[params[1]]
    if p1t is TyVar {
      if !holeDemandOk(p1t.tvName, rightIx, rt) {
        tErr(
          "operator '" +
            op +
            "': expected " +
            holeDemandStr(p1t.tvName) +
            ", got " +
            tyToStr(rt),
          ix,
        )
      }
    }
    if !assignableExpr(rightIx, rt, expected) {
      tErr(
        "operator '" +
          op +
          "': expected " +
          tyToStr(expected) +
          ", got " +
          tyToStr(rt),
        ix,
      )
    }
    if bNames.length > 0 { retTy = substTyDeep(retTy, bNames, bTys) }
    return retTy
  }
  -1
}

// The parameter NAMES of the declaration nodes `ps`, in order, skipping any the parser did not
// recover as a `Param`. The caller supplies the declaration it resolved, so a callee whose name
// the scope chain answers with a binding contributes no names.
function paramNamesOfNodes(ps: i32[]) {
  const out: string[] = []
  let i = 0
  while i < ps.length {
    const p = P.nodes[ps[i]]
    if p is Param { out.push(p.parName) }
    i = i + 1
  }
  out
}

// The declaration nodes `ps` minus the receiver — the list a UFCS call's explicit arguments
// align with, and therefore the list its defaults are read from.
function paramsAfterFirst(ps: i32[]) {
  const out: i32[] = []
  let i = 1
  while i < ps.length {
    out.push(ps[i])
    i = i + 1
  }
  out
}

// The parameter nodes of the top-level `FuncDecl` named `name`, or the empty list. Resolved by
// name with no scope walk, so it answers a diagnostic about a free function; a call site asks the
// scope chain instead (`calleeDeclParams`, `declParamsInScope`), or an unrelated declaration of
// the name decides whether the call checks (D1604).
function fnDeclParamsOf(name: string) {
  const none: i32[] = []
  const dIx = fnDeclIx[name] ?? -1
  if dIx >= 0 {
    const d = P.nodes[dIx]
    if d is FuncDecl { return d.fnParams }
  }
  none
}

// The parameter nodes of the `FuncDecl` that `name` denotes under the scope chain, or the empty
// list when it denotes a binding instead. The UFCS callee is a member property with no callee
// node, which is why this is keyed by name where `calleeDeclParams` takes a node.
function declParamsInScope(name: string) {
  const none: i32[] = []
  const dIx = lookupFnDeclNode(name)
  if dIx >= 0 {
    const d = P.nodes[dIx]
    if d is FuncDecl { return d.fnParams }
  }
  none
}

// The declared parameter NAMES of the top-level function `name`, or an empty list. By name: for
// a diagnostic about the free function, never for a call site (`fnDeclParamsOf`).
function fnParamNamesOf(name: string) {
  paramNamesOfNodes(fnDeclParamsOf(name))
}

// The declared parameter nodes behind a call's callee, when the call is direct — an `Ident`
// the scope chain resolves to a `FuncDecl` (top-level or nested). A closure-valued callee has
// no declaration to read defaults from, so it answers the empty list and every default-driven
// relaxation is off for it: a function value keeps full arity.
function calleeDeclParams(calleeIx: i32) {
  const none: i32[] = []
  const cf = P.nodes[calleeIx]
  if cf is Ident {
    const dIx = lookupFnDeclNode(cf.identName)
    if dIx >= 0 {
      const d = P.nodes[dIx]
      if d is FuncDecl { return d.fnParams }
    }
  }
  none
}

// Whether `name` is a declared function whose first parameter is named `self` — the UFCS
// reachability rule, asked of the declaration. UFCS in VL is exactly the `self`-function
// rule, so a callee that fails this is a program the design forbids; returning -1 falls
// through to the caller's own member-access error, naming the receiver and the property.
function declFirstParamIsSelf(name: string) {
  const ps = fnDeclParamsOf(name)
  if ps.length == 0 { return false }
  const p0 = P.nodes[ps[0]]
  if p0 is Param { return p0.parName == "self" }
  false
}

// The DECLARED parameter nodes of the free `self`-function `name`, MINUS the
// receiver — the list a UFCS call's explicit arguments align with, and therefore
// the list its defaults are read from. Empty when `name` is not a declared
// function (a UFCS callee always is, by the time this is asked).
function declParamsAfterSelf(name: string) {
  paramsAfterFirst(fnDeclParamsOf(name))
}

// The "expected …" half of an arity diagnostic. A parameter list with no
// defaults has `lo == hi` and renders exactly as it always did; a list with
// defaults renders the accepted RANGE, so the reader sees which calls are legal
// rather than only which one is not.
function arityWantText(lo: i32, hi: i32) {
  if lo >= hi { return i32ToStr(hi) }
  i32ToStr(lo) + " to " + i32ToStr(hi)
}

// Is `name` bound at MODULE scope by a `const`? `T.scopes[0]` is the module
// frame, and asking IT rather than walking the chain is the point: a parameter
// default's names resolve at the DECLARATION, and the declaration's own
// parameters and locals are exactly what must NOT answer here.
function isModuleScopeConst(name: string) {
  if T.scopes.length == 0 { return false }
  if !T.scopes[0].has(name) { return false }
  if constScopes.length == 0 { return false }
  // Bound, not returned as a bare tail: a member-call cannot be a tail
  // expression (`emitProgram: unsupported member-call statement`).
  const isC = constScopes[0].has(name)
  isC
}

// Whether `ty` has the `__callsite__` shape (`{ file: string, line: i32, col: i32 }`).
// Structural on purpose: a std alias of this shape resolves to the same `TyObj`, so a
// parameter typed with the alias satisfies this without the compiler ever learning the std
// name. Field order is not part of the test, but the field set is exact.
function tyIsCallerLoc(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyObj {
    if t.objFieldNames.length != 3 { return false }
    let seen = 0
    let i = 0
    while i < t.objFieldNames.length {
      const nm = t.objFieldNames[i]
      const ft = t.objFieldTypes[i]
      if nm == "file" {
        if isStringTy(ft) { seen = seen + 1 }
      } else if nm == "line" {
        if ft == TY_I32 { seen = seen + 1 }
      } else if nm == "col" {
        if ft == TY_I32 { seen = seen + 1 }
      }
      i = i + 1
    }
    return seen == 3
  }
  false
}

// Whether `dIx` is a form allowed as a parameter default. A default is substituted into each
// direct call site that omits the argument, so its expression resolves names at the
// declaration but evaluates in the caller's frame — v1 admits only a literal, a module
// `const` (marked so no caller-local can capture it), and `__callsite__`; anything else needs evaluating inside the callee, which is an ABI change.
function paramDefaultIsLiteral(dIx: i32) {
  if dIx < 0 { return false }
  const d = P.nodes[dIx]
  if d is NumLit { return true }
  if d is StrLit { return true }
  if d is CharLit { return true }
  if d is BoolLit { return true }
  if d is NullLit { return true }
  if d is Unary {
    // A SIGNED numeric literal (`-1`): the sign is a `Unary` over the literal,
    // and it is still name-free.
    if d.unOp == "-" || d.unOp == "+" {
      // Bound-tested: `unArg` is a node index, and an unbounded `P.nodes[…]` read on one is a
      // compiler trap rather than a diagnostic (D1440's shape).
      if d.unArg >= 0 && d.unArg < P.nodes.length {
        const inner = P.nodes[d.unArg]
        if inner is NumLit { return true }
      }
    }
  }
  if d is Ident {
    if isModuleScopeConst(d.identName) {
      markDefaultGlobalRef(dIx)
      return true
    }
  }
  false
}

// Declaration-side validation of parameter defaults (`paramTys` aligns 1:1 with `params`).
// Defaults are direct-call-site sugar — substituted into an omitting call before emit, so the
// ABI stays untouched — enforced as four rules: trailing-only (a defaulted parameter may not
// precede one without), annotated (disjoint from inference holes), non-generic, and literal.
function checkParamDefaults(n: FuncDecl, params: i32[], paramTys: i32[]) {
  let sawDefault = false
  let pi = 0
  while pi < params.length {
    const p = P.nodes[params[pi]]
    if p is Param {
      const dIx = p.parDefault
      if dIx < 0 {
        if sawDefault {
          tErr(
            "parameter `" +
              p.parName +
              "` has no default but follows one that does — defaults must be the LAST parameters",
            params[pi],
          )
        }
      } else {
        sawDefault = true
        if p.parType < 0 {
          tErr(
            "a default value needs a type annotation — write `" +
              p.parName +
              ": T = …`",
            params[pi],
          )
        } else if tsMentionsAnyName(annTsOf(p.parType), n.fnTyParams) {
          tErr(
            "parameter `" +
              p.parName +
              "` cannot have a default: its type names a type parameter of `" +
              n.fnName +
              "`, which an omitted argument would leave unbound",
            params[pi],
          )
        }
        let pt = TY_ERR
        if pi < paramTys.length { pt = paramTys[pi] }
        if paramDefaultIsCallsite(dIx) {
          // `__callsite__` is never checked as an expression — what is checked is the
          // destination, so the error surfaces here rather than at somebody else's call site.
          if pt >= 0 && !tyIsCallerLoc(pt) {
            tErr(
              "parameter `" +
                p.parName +
                "` is `__callsite__`, so its type must be `{ file: string, line: i32, col: i32 }` — got " +
                tyToStr(pt),
              dIx,
            )
          }
        } else if !paramDefaultIsLiteral(dIx) {
          tErr(
            "a default value must be a literal, a module-level `const`, or `__callsite__` — `" +
              p.parName +
              "`'s default is substituted at each call site, so it cannot name a parameter, a local, or a call",
            dIx,
          )
        } else {
          seedExpected(dIx, pt)
          const dt = checkNode(dIx)
          if pt >= 0 && !assignable(dt, pt) {
            tErr(
              "parameter `" +
                p.parName +
                "` default: expected " +
                tyToStr(pt) +
                ", got " +
                tyToStr(dt),
              dIx,
            )
          }
        }
      }
    }
    pi = pi + 1
  }
  0
}

// Binds a call's arguments into parameter order when any is named (`f(b: 1, a: 2)`): named
// args fill their parameter's slot, positionals fill what remains in order. Returns the
// value-node indices in parameter order, or an empty list on a binding failure (an
// unknown/duplicate name, diagnosed here). A slot with neither an argument nor a default names the parameter it is missing.
function orderNamedCallArgs(
  paramNames: string[],
  args: i32[],
  argNames: string[],
  ix: i32,
  declParams: i32[],
) {
  const bad: i32[] = []
  if paramNames.length < args.length {
    // Arity is diagnosed by the caller; just refuse to reorder.
    tErr("named arguments require a declared function with matching arity", ix)
    return bad
  }
  const ordered = orderArgsByParamNames(paramNames, args, argNames)
  if ordered.length != paramNames.length {
    tErr("named argument does not match a parameter", ix)
    return bad
  }
  const missing = fillArgDefaults(ordered, declParams, ix)
  if missing >= 0 {
    let who = ""
    if missing < paramNames.length { who = paramNames[missing] }
    tErr("missing argument for parameter `" + who + "`", ix)
    return bad
  }
  ordered
}

// —— constraints phase 1: bounds ————————————————————————————————————————————
// A validation layer over machinery that already lowers: the body resolves a generic bound
// member against the bound, the instantiation site resolves it against the argument, and the
// two must agree — a mismatch is check-clean invalid wasm without this layer (D1001).

// The spelling root of the bound `annIx` names: an inline object literal directly, or one hop
// through a bound-alias name. -1 when the annotation is not a bound. One hop, not a chain — a
// bound alias's body is always a `{ … }` with a method member, so there is nothing for a
// second hop to reach; `type S2 = Showable` is not a bound alias (it parses as a union alias).
function boundObjRootOf(annIx: i32) {
  if annIx < 0 { return -1 }
  const root = annTsOf(annIx)
  if root < 0 { return -1 }
  if tsKind[root] == TS_OBJ { return root }
  if tsKind[root] == TS_NAME {
    const hit = cBoundDecls[tsText[root]] ?? -1
    if hit >= 0 { return annTsOf(hit) }
  }
  -1
}

// The bound's members, as three parallel columns filled in source order: `names[i]`, `tys[i]`
// (the call's function type for a method, or the field's declared type for a colon member),
// and `isMethod[i]`. A zero-ary closure field satisfies a method bound by construction, but not
// the converse — a UFCS-satisfied value carries no closure (`docs/constraints-design.md` OQ-1).
function boundMembersOf(
  root: i32,
  names: string[],
  tys: i32[],
  isMethod: boolean[],
) {
  if root < 0 { return 0 }
  const start = tsKidStart[root]
  const cnt = tsKidCount[root]
  let i = 0
  while i < cnt {
    const kid = tsKids[start + i]
    const k = tsKind[kid]
    if k == TS_METHOD {
      const ks = tsKidStart[kid]
      const kc = tsKidCount[kid]
      const ptys: i32[] = []
      let p = 0
      while p < kc - 1 {
        ptys.push(tsToTy(tsKids[ks + p]))
        p = p + 1
      }
      names.push(tsText[kid])
      tys.push(mkFuncTy(ptys, tsToTy(tsKids[ks + kc - 1])))
      isMethod.push(true)
    } else if k == TS_FIELD {
      names.push(tsText[kid])
      tys.push(tsToTy(tsKids[tsKidStart[kid]]))
      isMethod.push(false)
    }
    i = i + 1
  }
  0
}

// How a bound names itself in a diagnostic: the alias name when the author wrote
// one, else the literal they wrote. Never the synthetic re-render — a reader
// searching for the sentence should find the text in their own file.
function boundText(annIx: i32) {
  if annIx < 0 { return "" }
  const t = P.nodes[annIx]
  if t is TypeRef { return t.tyName }
  ""
}

// The member list a bound offers, rendered for a diagnostic: `toString(), n`.
function boundMemberList(root: i32) {
  const bn: string[] = []
  const bt: i32[] = []
  const bm: boolean[] = []
  boundMembersOf(root, bn, bt, bm)
  let out = ""
  let i = 0
  while i < bn.length {
    if i > 0 { out = out + ", " }
    out = out + bn[i]
    if bm[i] { out = out + "()" }
    i = i + 1
  }
  out
}

// —— the witness: satisfaction is the existing call resolution ————————————————
// `x.m(a)` under a bound resolves by the same order every method call uses — a field of the
// receiver first, then a free `self`-function in scope. Returns a stable string naming which
// won (`"field"`, the mangled `self`-function name, or `""`) — the coherence key's value and the words the disagreement diagnostic prints (resolved in the instantiation site's own module scope, D1191).
function witnessOf(memberName: string, wantTy: i32, concTy: i32, ix: i32) {
  if concTy < 0 || wantTy < 0 { return "" }
  const ct = T.tys[concTy]
  if ct is TyObj {
    const ft = objFieldType(ct, memberName)
    if ft >= 0 {
      if assignable(ft, wantTy) { return "field" }
      return ""
    }
  }
  const mangled = ufcsAliasInScope(ix, memberName)
  const fnTy = lookup(mangled)
  if fnTy < 0 { return "" }
  const ft2 = T.tys[fnTy]
  if ft2 is TyFunc {
    const wt = T.tys[wantTy]
    if wt is TyFunc {
      // The receiver occupies slot 0 and the bound's arguments fill the rest —
      // the arity `ufcsCallTy` enforces, asked here of a type rather than of a
      // node so it can be asked before any call exists.
      if ft2.fnParamTypes.length != wt.fnParamTypes.length + 1 { return "" }
      if !assignable(concTy, ft2.fnParamTypes[0]) { return "" }
      let i = 0
      while i < wt.fnParamTypes.length {
        if !assignable(wt.fnParamTypes[i], ft2.fnParamTypes[i + 1]) {
          return ""
        }
        i = i + 1
      }
      // A callee whose return is still pending (-2) has not been inferred yet; force it,
      // exactly as `ufcsCallTy` does, so an un-annotated std export's real type is known here rather than guessed.
      let retTy = ft2.fnRet
      if retTy == (-2) {
        if !onInferStack(mangled) {
          const dIx = fnDeclIx[mangled] ?? -1
          if dIx >= 0 {
            checkNode(dIx)
            const re = T.tys[lookup(mangled)]
            if re is TyFunc { retTy = re.fnRet }
          }
        }
      }
      if !assignable(retTy, wt.fnRet) { return "" }
      return mangled
    }
  }
  ""
}

// Record this site's witness for (generic, instantiation type, member) and refuse
// a DISAGREEMENT, naming both sites and both witnesses. Returns true when the row
// is coherent (including the first time it is written).
function cohRecord(
  who: string,
  tyKey: string,
  memberName: string,
  wit: string,
  ix: i32,
) {
  const key = who + "#" + tyKey + "#" + memberName
  let i = 0
  while i < cohKeys.length {
    if cohKeys[i] == key {
      if cohWitness[i] == wit { return true }
      tErr(
        "incoherent bound: `" +
          who +
          "` instantiated at `" +
          tyKey +
          "` resolves `" +
          memberName +
          "` to `" +
          cohWitness[i] +
          "` at line " +
          i32ToStr(cohSiteLine[i]) +
          ":" +
          i32ToStr(cohSiteCol[i] + 1) +
          " and to `" +
          wit +
          "` here — one generic at one type must have ONE witness across the whole program",
        ix,
      )
      return false
    }
    i = i + 1
  }
  cohKeys.push(key)
  cohWitness.push(wit)
  let ln = 0
  let co = 0
  if ix >= 0 && ix < nodeToks.length {
    const tk = nodeToks[ix]
    if tk >= 0 && tk < P.toks.length {
      ln = P.toks[tk].line
      co = P.toks[tk].col
    }
  }
  cohSiteLine.push(ln)
  cohSiteCol.push(co)
  true
}

// Subsumption: does the bound on `srcTp` grant everything the callee's bound `dstAnn`
// demands? Every member of the callee's bound must appear in the caller's with an assignable
// type and the same kind — a colon member is a layout demand, a method a callability demand,
// and a method does not satisfy a field. A caller parameter with no bound grants nothing.
function checkBoundSubsumes(
  srcTp: string,
  dstTp: string,
  dstAnn: i32,
  who: string,
  ix: i32,
) {
  const dstRoot = boundObjRootOf(dstAnn)
  if dstRoot < 0 { return 0 }
  const dn: string[] = []
  const dt: i32[] = []
  const dm: boolean[] = []
  boundMembersOf(dstRoot, dn, dt, dm)
  const srcAnn = tpBoundOfName(srcTp)
  const srcRoot = boundObjRootOf(srcAnn)
  const sn: string[] = []
  const st: i32[] = []
  const sm: boolean[] = []
  boundMembersOf(srcRoot, sn, st, sm)
  let d = 0
  while d < dn.length {
    let ok = false
    let s = 0
    while s < sn.length {
      if sn[s] == dn[d] && sm[s] == dm[d] {
        if st[s] >= 0 && dt[d] >= 0 {
          if assignable(st[s], dt[d]) { ok = true }
        }
      }
      s = s + 1
    }
    if !ok {
      let has = "`" + srcTp + "` is unbounded"
      if srcAnn >= 0 {
        has = "`" +
          srcTp +
          "`'s bound `" +
          boundText(srcAnn) +
          "` grants `" +
          boundMemberList(srcRoot) +
          "`"
      }
      let want = dn[d]
      if dm[d] { want = dn[d] + "()" }
      tErr(
        "`" +
          who +
          "` needs `" +
          dstTp +
          ": " +
          boundText(dstAnn) +
          "`, which demands `" +
          want +
          "` — but " +
          has +
          ". Add it to `" +
          srcTp +
          "`'s bound",
        ix,
      )
      return 0
    }
    d = d + 1
  }
  0
}

// The instantiation-site check: for each bounded type parameter the call actually bound,
// resolves every bound member against the concrete type in this site's scope and refuses
// what nothing satisfies. The bound's own member types resolve with the parameter bound to
// the concrete type, which is what makes `{ eq(T): boolean }` mean "eq takes another one of me" at each instantiation with no self-type machinery.
function checkBoundsAtCall(
  who: string,
  declIx: i32,
  bNames: string[],
  bTys: i32[],
  ix: i32,
) {
  if declIx < 0 { return 0 }
  if !fnHasTpBound(declIx) { return 0 }
  const dn = P.nodes[declIx]
  if !(dn is FuncDecl) { return 0 }
  let k = 0
  while k < dn.fnTyParams.length {
    const bAnn = fnTpBoundOf(declIx, k)
    if bAnn >= 0 {
      const tpName = dn.fnTyParams[k]
      let conc = -1
      let bi = 0
      while bi < bNames.length {
        if bNames[bi] == tpName { conc = bTys[bi] }
        bi = bi + 1
      }
      // Chaining through another generic's own type parameter has no instantiation type to
      // resolve a witness against, so it is decided by subsumption instead — statically,
      // which lands the error on the declaration that is wrong rather than a distant caller.
      // Bounds are free at emit once substitution has run; the check is what needs this, since a bounded generic relayed through an unbounded one has no pin left to ask (`vl check`-clean and invalid).
      if conc >= 0 {
        const ct0 = T.tys[conc]
        if ct0 is TyVar {
          if ct0.tvName.length > 0 {
            if ct0.tvName[0] != '?' {
              checkBoundSubsumes(ct0.tvName, tpName, bAnn, who, ix)
              k = k + 1
              continue
            }
          }
        }
      }
      if conc >= 0 && !tyHasHole(conc) {
        const root = boundObjRootOf(bAnn)
        if root < 0 {
          tErr(
            "`" +
              boundText(bAnn) +
              "` is not a bound — a bound is a type with method members (`type " +
              boundText(bAnn) +
              " = { m(): R }`) or an inline `{ m(): R }`",
            ix,
          )
        } else {
          // Bind the parameter to the CONCRETE type while the bound's member
          // types resolve, so a self-referential member means what it says here.
          tpEnvNames.push(tpName)
          tpEnvTys.push(conc)
          const bn: string[] = []
          const bt: i32[] = []
          const bm: boolean[] = []
          boundMembersOf(root, bn, bt, bm)
          tpEnvNames.pop()
          tpEnvTys.pop()
          const tyKey = tyToStr(conc)
          let m = 0
          while m < bn.length {
            let wit = ""
            // An unresolved member type is the alias-self-reference case, reported at the
            // declaration (the body's own use raised it) rather than adding a second voice here.
            if bt[m] < 0 {
              m = m + 1
              continue
            }
            if bm[m] {
              wit = witnessOf(bn[m], bt[m], conc, ix)
            } else {
              // A COLON member is a layout demand and stays one: the value must
              // carry the field, which is ordinary structural assignability.
              const ct = T.tys[conc]
              if ct is TyObj {
                const ft = objFieldType(ct, bn[m])
                if ft >= 0 {
                  if assignable(ft, bt[m]) { wit = "field" }
                }
              }
            }
            if wit == "" {
              let what = bn[m]
              if bm[m] { what = bn[m] + "(): " + tyToStr(retOfFuncTy(bt[m])) }
              tErr(
                tyKey +
                  " does not satisfy `" +
                  boundText(bAnn) +
                  "`: no `" +
                  what +
                  "` — the bound needs a field of that type or a `" +
                  bn[m] +
                  "(self: " +
                  tyKey +
                  ", …)` function in scope at this call",
                ix,
              )
            } else {
              cohRecord(who, tyKey, bn[m], wit, ix)
            }
            m = m + 1
          }
        }
      }
    }
    k = k + 1
  }
  0
}

// The result type of a `TyFunc`, or `TY_ERR` — the one place a bound member's
// declared result is read out for a message.
function retOfFuncTy(tyIx: i32) {
  if tyIx < 0 { return TY_ERR }
  const t = T.tys[tyIx]
  if t is TyFunc { return t.fnRet }
  TY_ERR
}

// The strict body (OQ-5, as ruled): inside `function f<T: B>(x: T)`, a member use on `x`
// resolves against `B`'s members and nothing else — `-1` when the bound has no such member,
// so the caller raises the refusal naming `B`. An unbounded `<T>` never reaches here; operator
// use is untouched, since the implicit `HD_BINOP` machinery is a separate mechanism (OQ-2).
function boundMemberTy(tvName: string, prop: string, wantCall: boolean) {
  const bAnn = tpBoundOfName(tvName)
  if bAnn < 0 { return -1 }
  const root = boundObjRootOf(bAnn)
  if root < 0 { return -1 }
  const bn: string[] = []
  const bt: i32[] = []
  const bm: boolean[] = []
  boundMembersOf(root, bn, bt, bm)
  let i = 0
  while i < bn.length {
    if bn[i] == prop {
      // Distinct from "no such member" (-1): `assignable` reads a negative side as "accept
      // anything", so feeding -1 here would make an unresolved bound silently accept every argument.
      if bt[i] < 0 { return BOUND_UNRESOLVED }
      // A method member is call-only (`x.m` alone has no closure to hand back); a field
      // member serves both spellings, since a field is a value and calling it calls the closure it holds.
      if bm[i] && !wantCall { return -1 }
      return bt[i]
    }
    i = i + 1
  }
  -1
}

// `boundMemberTy`'s third answer: the member EXISTS but its own annotation did not
// resolve. Kept apart from -1 ("no such member") because the two need different
// sentences and only one of them is the author's spelling mistake.
const BOUND_UNRESOLVED = -2

// A bound member whose own annotation does not resolve in the scope that reads it. The live
// case is a self-referential member in an alias bound (`type Eq = { eq(T): boolean }`): the
// alias body resolves in the alias's own scope, where `T` is an ordinary type name, not the
// using function's parameter — phase 1 has no F-bounded generic bound aliases, so this reads as inline.
function boundMemberUnknownMsg(tvName: string, prop: string) {
  const bAnn = tpBoundOfName(tvName)
  "the bound member `" +
    prop +
    "` on `" +
    tvName +
    "` names a type that does not resolve here — a bound alias body resolves in its OWN scope, so it cannot name `" +
    tvName +
    "`. Spell a self-referential member inline: `<" +
    tvName +
    ": { " +
    prop +
    "(" +
    tvName +
    "): … }>` (the bound as written is `" +
    boundText(bAnn) +
    "`)"
}

// The refusal a strict body raises, naming the bound and what it offers. Returns
// "" when the receiver is not a bounded type parameter, so the caller keeps its
// existing (unbounded) answer.
function boundMemberFloorMsg(tvName: string, prop: string) {
  const bAnn = tpBoundOfName(tvName)
  if bAnn < 0 { return "" }
  const root = boundObjRootOf(bAnn)
  if root < 0 { return "" }
  const offers = boundMemberList(root)
  let has = "nothing"
  if offers.length > 0 { has = "`" + offers + "`" }
  "no `" +
    prop +
    "` on `" +
    tvName +
    "` — its bound `" +
    boundText(bAnn) +
    "` grants " +
    has
}

// Every type-parameter receiver's floor (`memberFloorMsg`'s `TyVar` rung). The domain is
// exactly "the annotation is not a bound" — `boundObjRootOf` answering -1 — since an unbounded
// `<T>` routes to inference before this rung and a real bound missing the member is answered
// one line up. Says only that: "…is not a type with members" is false of a field-member alias, which has members and simply declares no method ones.
function tpMemberFloorMsg(tvName: string, prop: string) {
  const bMsg = boundMemberFloorMsg(tvName, prop)
  if bMsg != "" { return bMsg }
  // An inference HOLE is not a declared parameter and owns no bound to name: it carries a
  // minted `?`-name the author never wrote, and `checkMemberNode` grows its shape rather
  // than reaching this floor. `memberFloorErr`'s own floor words it if one ever does.
  if tvName.length == 0 { return "" }
  if tvName[0] == '?' { return "" }
  "no `" +
    prop +
    "` on `" +
    tvName +
    "` — `" +
    boundText(tpBoundOfName(tvName)) +
    "` is not a bound"
}

// Whether a UFCS call with `argc` explicit arguments on `recvTy` would dispatch to the free
// self-function merged as `mangled` (D1230) — mirrors `ufcsCallTy`'s gate arm for arm, and
// deliberately nothing after it, since this runs speculatively over every same-named candidate
// for a call that already failed and must not raise diagnostics or mutate inference state. A true answer is not a promise the call would compile, only the promise the message makes.
function ufcsWouldDispatch(mangled: string, recvTy: i32, argc: i32) {
  const fnTy = lookup(mangled)
  if fnTy < 0 { return false }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    const params = ft.fnParamTypes
    if params.length < 1 { return false }
    if !declFirstParamIsSelf(mangled) { return false }
    const uDecl = declParamsAfterSelf(mangled)
    let uRequired = params.length - 1
    if uDecl.length == params.length - 1 { uRequired = fnRequiredArity(uDecl) }
    if argc < uRequired || argc + 1 > params.length { return false }
    return assignable(recvTy, params[0])
  }
  false
}

// The comma-joined module specifiers that would make `recv.prop(argc args)` resolve, or ""
// when no module in the graph offers one (D1230). Deduplicated, in the registry's own
// dependency-first order. Empty is the common answer: a single-file program has no registry
// rows at all, and a genuinely missing function keeps the direct sentence it has today.
function ufcsMissingImportSpecs(prop: string, recvTy: i32, argc: i32) {
  const specs: string[] = []
  let i = 0
  while i < ufcsImpName.length {
    if ufcsImpName[i] == prop {
      if ufcsWouldDispatch(ufcsImpMangled[i], recvTy, argc) {
        if !listHasStr(specs, ufcsImpSpec[i]) { specs.push(ufcsImpSpec[i]) }
      }
    }
    i = i + 1
  }
  let out = ""
  let j = 0
  while j < specs.length {
    if j > 0 { out = out + "," }
    out = out + specs[j]
    j = j + 1
  }
  out
}

// The `,`-joined payload list, rendered for the SENTENCE: `a,b` → `"a", "b"`.
// The two forms are built from the one string so the message and the code can
// never name different modules.
function specListQuoted(list: string) {
  let out = ""
  let start = 0
  let i = 0
  while i < list.length {
    if list[i] == ',' {
      if out != "" { out = out + ", " }
      out = out + "\"" + list.slice(start, i) + "\""
      start = i + 1
    }
    i = i + 1
  }
  if out != "" { out = out + ", " }
  out + "\"" + list.slice(start, list.length) + "\""
}

// Bank the callee MEMBER node's missing-import answer for `memberFloorErr`.
function noteUfcsMiss(memIx: i32, specs: string) {
  if memIx < 0 { return 0 }
  if specs == "" { return 0 }
  let i = 0
  while i < ufcsMissAt.length {
    if ufcsMissAt[i] == memIx { return 0 }
    i = i + 1
  }
  ufcsMissAt.push(memIx)
  ufcsMissSpecs.push(specs)
  0
}

// The banked answer for member node `memIx`, or "" when the call site banked none.
function ufcsMissSpecsAt(memIx: i32) {
  let i = 0
  while i < ufcsMissAt.length {
    if ufcsMissAt[i] == memIx { return ufcsMissSpecs[i] }
    i = i + 1
  }
  ""
}

function ufcsCallTy(plainName: string, recvTy: i32, n: Call, ix: i32) {
  // Maps the callee's plain source name to its merge-mangled function, after field precedence
  // has already been checked — resolved at this call's own site (D1120), since two merged
  // modules may each export the same-named `self`-function.
  const name = ufcsAliasAtSite(ix, plainName)
  const fnTy = lookup(name)
  if fnTy < 0 { return -1 }
  const preFt = T.tys[fnTy]
  if preFt is TyFunc {
    if preFt.fnRet == -2 {
      if !onInferStack(name) {
        const dIx = fnDeclIx[name] ?? -1
        if dIx >= 0 { checkNode(dIx) }
      }
    }
  } else {
    return -1
  }
  const ft = T.tys[fnTy]
  if ft is TyFunc {
    let retTy = ft.fnRet
    if retTy == -2 { retTy = TY_ERR }
    const params = ft.fnParamTypes
    let args = n.callArgs
    // The `self`-NAME rule, asked here because the REWRITE asks it and the two
    // must not disagree about what dispatches (see `declFirstParamIsSelf`).
    if !declFirstParamIsSelf(name) { return -1 }
    // The arity range the direct spelling takes: the receiver fills `self` and the defaults fill
    // the tail of the declaration the scope chain gives this callee, empty for a binding (D1604).
    const uDecl = paramsAfterFirst(declParamsInScope(name))
    let uRequired = params.length - 1
    // `fnRequiredArity` over the TAIL alone: `self` is never defaulted (it is
    // the receiver), so the tail's own required count IS the answer.
    if uDecl.length == params.length - 1 { uRequired = fnRequiredArity(uDecl) }
    if args.length < uRequired || args.length + 1 > params.length { return -1 }
    if !assignable(recvTy, params[0]) { return -1 }
    // The vacuous half of that gate, deferred: `assignable` answers true for a `TyVar` on
    // either side, so this row makes a hole receiver's pass mean something once resolved (see `ufcsCstrTy`'s header).
    noteUfcsCstr(recvTy, plainName, ix, params[0])
    // Named arguments bind against the parameter names after `self` (the receiver is an
    // unnamed slot-0 positional), in parameter order — the full list with the receiver unnamed.
    if hasNamedArgs(n.callArgNames) {
      const uNames = paramNamesOfNodes(declParamsInScope(name))
      if uNames.length != params.length {
        tErr("named arguments require a declared function", ix)
        return TY_ERR
      }
      const restNames: string[] = []
      let rn = 1
      while rn < uNames.length {
        restNames.push(uNames[rn])
        rn = rn + 1
      }
      args = orderNamedCallArgs(restNames, args, n.callArgNames, ix, uDecl)
      if args.length != restNames.length { return TY_ERR }
    } else if args.length + 1 < params.length {
      // Pads trailing positional omissions with the declaration's defaults into a copy, so
      // the loop below covers the whole parameter list; `n.callArgs` stays untouched since `emit_rewrite` re-derives its own fill after the receiver is injected.
      const uPadded: i32[] = []
      let up = 0
      while up + 1 < params.length {
        if up < args.length { uPadded.push(args[up]) } else { uPadded.push(-1) }
        up = up + 1
      }
      if fillArgDefaults(uPadded, uDecl, ix) >= 0 { return TY_ERR }
      args = uPadded
    }
    // Generic dispatch binds the receiver into the `self` param's holes first — a receiver
    // missing a field the body demanded is not this method and falls through — then binds and checks the explicit arguments and substitutes the return.
    const bNames: string[] = []
    const bTys: i32[] = []
    const p0 = T.tys[params[0]]
    if p0 is TyVar {
      if !holeDemandOk(p0.tvName, -1, recvTy) { return -1 }
    }
    bindGenWalk(params[0], recvTy, bNames, bTys)
    // The receiver's half of the `u8[]`-meets-a-generic rule the direct-call spelling already
    // enforces: `bindGenWalk` above declined to bind `T` to storage type `u8`, so the
    // substituted `self` param still carries the unsolved hole the arity gate's `assignable`
    // passed vacuously — needed here because `self` arrives ahead of the argument loop that rule normally sits in.
    if !inferQuiet {
      if tyIsU8ArrayTy(recvTy) {
        if tyReachesHole(substTyDeep(params[0], bNames, bTys), 8) {
          tErr(
            "`u8[]` cannot be passed to a generic parameter — `u8` is a storage type, so a type parameter never binds it and a `u8[]` is not a `T[]`",
            ix,
          )
          return TY_ERR
        }
      }
    }
    let i = 0
    while i < args.length {
      const at = checkNode(args[i])
      bindGenWalk(params[i + 1], at, bNames, bTys)
      const expected = substTyDeep(params[i + 1], bNames, bTys)
      const pHole = T.tys[params[i + 1]]
      if pHole is TyVar {
        if !holeDemandOk(pHole.tvName, args[i], at) {
          holeArgDemandErr(pHole.tvName, i + 1, at, args[i])
        }
        if holeIsArrayDemanded(pHole.tvName) {
          if tyRefusesArrayDemand(at) { holeArgArrayErr(i + 1, at, args[i]) }
        }
        // The `as` cast the body parked on this hole, re-asked under the argument. D1342.
        holeCastPinCheck(pHole.tvName, at, declParamNameAt(uDecl, i))
      }
      constrainEmptyExpr(args[i], at, expected)
      if !assignableExpr(args[i], at, expected) {
        // Anchored at the offending argument (or its offending return site),
        // never at the call node — see `argMismatchErr`.
        argMismatchErr(i + 1, expected, at, args[i])
      }
      i = i + 1
    }
    // The UFCS half of the deferred-constraint re-validation, which lived in the direct-call
    // path alone: `xs.indexOf(nd)` and `indexOf(xs, nd)` are the same call and must answer the
    // same way, so the UFCS spelling needs its own re-validation of the callee's recorded
    // constraints too — the same self-arrives-ahead-of-the-argument-loop asymmetry as above.
    if !inferQuiet {
      if bNames.length > 0 {
        // `params[0]` is the RECEIVER here, so the origins skip it (`selfOff` 1) and the
        // remaining parameters number from 1 — `xs.plus(y)` blames `argument 1`, not 2.
        const uhNames: string[] = []
        const uhArgNo: i32[] = []
        const uhArgNode: i32[] = []
        holeArgOrigins(params, args, 1, uhNames, uhArgNo, uhArgNode)
        validateBinCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
          uhNames,
          uhArgNo,
          uhArgNode,
        )
        // The print capability rides the same pin and the same UFCS/direct symmetry as
        // above — `xs.show()` and `show(xs)` must answer the same way (D401).
        validatePrintCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
        )
        // The declared return, at the UFCS half for the same symmetry: `p.g()` and `g(p)`
        // must answer the same way, or the method spelling of D551's family stays silent beside a loud direct one.
        validateRetCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
        )
        // Every other destination inside the body — a local, a re-assignment, a field or
        // element write — at the UFCS half for the same symmetry (D572).
        validateLetCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
        )
        // Every builtin-collection-method argument inside the body, at the UFCS half for the
        // same symmetry (D582).
        validateBmCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
        )
        // The receiver classification of a `.length` / `x[i]` inside the body, at the UFCS
        // half for the same symmetry (D651 / D691).
        validateMemCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
          uhNames,
          uhArgNo,
          uhArgNode,
        )
        // The receiver of a UFCS `self`-method resolved inside the body, at the UFCS half
        // for the same symmetry (D1005).
        validateUfcsCstrs(
          bNames,
          bTys,
          ix,
          fnDeclIx[name] ?? CSTR_NODECL,
          plainName,
        )
      }
    }
    if bNames.length > 0 { retTy = substTyDeep(retTy, bNames, bTys) }
    return retTy
  }
  -1
}

// The innermost guard registration for `name`, or -1 (not a guard).
function guardIndexOf(name: string) {
  let i = guardNames.length - 1
  while i >= 0 {
    if guardNames[i] == name { return i }
    i = i - 1
  }
  -1
}

// The A6b guard fact of a function body's result expression over the params: the index of
// the param whose null-ness it tests, or -1. Encodes the branch direction in the result —
// `paramIndex * 2 + 1` when the non-null branch is `then` (`x != null`, `x is T`), `paramIndex
// * 2` when it is `else` (`x == null`, `x is null`) — mirroring the host's `conditionNarrowing`.
function guardFactOf(exprIx: i32, paramNames: string[]) {
  const e = P.nodes[exprIx]
  if e is Paren { return guardFactOf(e.parInner, paramNames) }
  if e is IsExpr {
    const obj = P.nodes[e.isObj]
    if obj is Ident {
      let gi = 0
      while gi < paramNames.length {
        if paramNames[gi] == obj.identName {
          if e.isVariant == "null" { return gi * 2 }
          return gi * 2 + 1
        }
        gi = gi + 1
      }
    }
    return -1
  }
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" {
      const placeIx = nullCmpPlace(exprIx)
      if placeIx >= 0 {
        const p = P.nodes[placeIx]
        if p is Ident {
          let gj = 0
          while gj < paramNames.length {
            if paramNames[gj] == p.identName {
              if e.binOp == "!=" { return gj * 2 + 1 }
              return gj * 2
            }
            gj = gj + 1
          }
        }
      }
    }
  }
  -1
}

// —— numeric-opcode intrinsics ————————————————————————————————————————————————
// Operations that are a single wasm instruction, not a library: bitcasts, float ops (`sqrt
// abs floor ceil trunc nearest`, `min max copysign`), and integer ops (`clz ctz popcnt`,
// `rotl rotr divU remU`, unsigned comparisons over the same signed `i32`/`i64`). Transcendentals are absent: no wasm opcode computes one, so `sin` would be a policy choice, not a primitive.

// Whether `name` is bound by the program — a declared function (hoisted, so a forward
// reference counts) or any in-scope binding. A user definition wins over the intrinsic of the
// same name, so adding an intrinsic can never capture a call that already resolves to the
// program's own function; the emitter reads the same rule off its own function table.
function numIntrShadowed(name: string) {
  if (fnDeclIx[name] ?? -1) >= 0 { return true }
  lookup(name) >= 0
}

// The ARGUMENT type of the bitcast named `name`, or -1 when it is not a bitcast.
function bitcastArgTy(name: string) {
  if name == "f32bits" { return TY_F32 }
  if name == "f64bits" { return TY_F64 }
  if name == "f32fromBits" { return TY_I32 }
  if name == "f64fromBits" { return TY_I64 }
  -1
}

// The RESULT type of the bitcast named `name` — the SAME 32/64 bit width read at the
// other type, which is the whole point: no value conversion, only a reinterpretation.
function bitcastRetTy(name: string) {
  if name == "f32bits" { return TY_I32 }
  if name == "f64bits" { return TY_I64 }
  if name == "f32fromBits" { return TY_F32 }
  if name == "f64fromBits" { return TY_F64 }
  -1
}

// Type the bitcast call `name(arg)`, or -1 when `name` is not a bitcast. Arity and the
// argument type are checked here; `assignableExpr` (not bare `assignable`) so a float
// LITERAL argument re-encodes into an `f32` parameter, matching every other f32 position.
function bitcastCallTy(name: string, n: Call, ix: i32) {
  const want = bitcastArgTy(name)
  if want < 0 { return -1 }
  const args = n.callArgs
  if args.length != 1 {
    tErr(name + " expects 1 argument, got " + i32ToStr(args.length), ix)
  } else {
    const got = checkNode(args[0])
    if !assignableExpr(args[0], got, want) {
      tErr(name + " expects " + tyToStr(want) + ", got " + tyToStr(got), ix)
    }
  }
  bitcastRetTy(name)
}

// Is `name` one of the numeric-opcode intrinsics at all? The emitter's import scan asks
// this: an intrinsic RESULT type appears nowhere as an annotation (`f64bits(x)` is an
// i64, `f32fromBits(b)` an f32), so the scan that decides the `__print_*__` imports has
// to recognize the call itself and read its recorded type.
export function isNumIntrinsicName(name: string) {
  if bitcastArgTy(name) >= 0 { return true }
  if floatIntrArity(name) > 0 { return true }
  intIntrArity(name) > 0
}

// How many arguments the FLOAT intrinsic `name` takes, or 0 when it is not one.
function floatIntrArity(name: string) {
  if name == "sqrt" { return 1 }
  if name == "abs" { return 1 }
  if name == "floor" { return 1 }
  if name == "ceil" { return 1 }
  if name == "trunc" { return 1 }
  if name == "nearest" { return 1 }
  if name == "min" { return 2 }
  if name == "max" { return 2 }
  if name == "copysign" { return 2 }
  0
}

// How many arguments the INTEGER intrinsic `name` takes, or 0 when it is not one.
function intIntrArity(name: string) {
  if name == "clz" { return 1 }
  if name == "ctz" { return 1 }
  if name == "popcnt" { return 1 }
  if name == "rotl" { return 2 }
  if name == "rotr" { return 2 }
  if name == "divU" { return 2 }
  if name == "remU" { return 2 }
  if name == "ltU" { return 2 }
  if name == "leU" { return 2 }
  if name == "gtU" { return 2 }
  if name == "geU" { return 2 }
  0
}

// Is `name` one of the unsigned COMPARISONS? Those yield a boolean; every other
// integer intrinsic yields the operand width (the wasm instructions do exactly this —
// `i64.lt_u` leaves an i32, `i64.clz` an i64).
function intIntrIsCompare(name: string) {
  if name == "ltU" { return true }
  if name == "leU" { return true }
  if name == "gtU" { return true }
  name == "geU"
}

// Does the argument at `argIx`, of type `ty`, force the whole operation to f64? A genuine f64
// does; a bare float literal does not, since it re-encodes exactly at f32 and adapts down to
// an f32 operand — the same rule the binary operators run on (`f32var + 1.0` stays f32,
// `f32var + f64var` widens), so an intrinsic and an operator on the same operands agree.
function argForcesF64(argIx: i32, ty: i32) {
  if primNameOf(ty) != "f64" { return false }
  !isFloatLitExpr(argIx)
}

// The WIDTH a float intrinsic call computes at: f32 when an operand is genuinely f32 and
// none is genuinely f64, else f64. All-integer operands therefore land on f64, where they
// widen losslessly — `sqrt(2)` is the f64 square root, as `2 / 1.0` is f64 division.
function floatIntrWidth(argIxs: i32[], argTys: i32[]) {
  let sawF32 = false
  let i = 0
  while i < argTys.length {
    if argForcesF64(argIxs[i], argTys[i]) { return TY_F64 }
    if primNameOf(argTys[i]) == "f32" { sawF32 = true }
    i = i + 1
  }
  if sawF32 { return TY_F32 }
  TY_F64
}

// The WIDTH an integer intrinsic call computes at: i64 when an operand is i64 (the i32
// side widens losslessly), else i32 — the selection rule the i64 binary operators use.
function intIntrWidth(argTys: i32[]) {
  let i = 0
  while i < argTys.length {
    if primNameOf(argTys[i]) == "i64" { return TY_I64 }
    i = i + 1
  }
  TY_I32
}

// Type the float / integer intrinsic call `name(args…)`, or -1 when `name` is not one.
// The operand width is decided from the arguments and every argument is then checked
// against it, so a mixed call reports the width it actually computes at.
function numIntrCallTy(name: string, n: Call, ix: i32) {
  const isFloat = floatIntrArity(name) > 0
  let arity = intIntrArity(name)
  if isFloat { arity = floatIntrArity(name) }
  if arity == 0 { return -1 }
  const args = n.callArgs
  if args.length != arity {
    let want = i32ToStr(arity) + " arguments"
    if arity == 1 { want = "1 argument" }
    tErr(name + " expects " + want + ", got " + i32ToStr(args.length), ix)
    // Still yield a type so the call site does not cascade: the width is unknowable
    // from a wrong-arity call, so take the family's default.
    if isFloat { return TY_F64 }
    if intIntrIsCompare(name) { return TY_BOOL }
    return TY_I32
  }
  const argTys: i32[] = []
  let i = 0
  while i < args.length {
    argTys.push(checkNode(args[i]))
    i = i + 1
  }
  let width = intIntrWidth(argTys)
  if isFloat { width = floatIntrWidth(args, argTys) }
  let j = 0
  while j < args.length {
    if !assignableExpr(args[j], argTys[j], width) {
      tErr(
        name + " expects " + tyToStr(width) + ", got " + tyToStr(argTys[j]),
        ix,
      )
    }
    j = j + 1
  }
  if !isFloat {
    if intIntrIsCompare(name) { return TY_BOOL }
  }
  width
}

// Method call on a member callee (`xs.push(e)`, `m.get(k)`, `s.slice(a)`): types the
// builtin receiver kinds directly, never as a struct field read. Returns the call type,
// or `-1` when no builtin arm claims it and the caller falls through to the field/UFCS
// path — the same "no answer" spelling `ufcsCallTy` and `arrayUnionCallTy` already use.
function checkMemberCallNode(n: Call, ix: i32, cfn: Member): i32 {
  // A member-access callee is always function-typed for semantic tokens; the builtin arms
  // below type it directly and never revisit the member-read arm, so its name is recorded here (a struct field holding a function falls through to `checkNode` and overwrites it for hover).
  symMemMethod(n.callFn)
  let recvTy = checkNode(cfn.memObj)
  let rt = T.tys[recvTy]
  // An un-annotated hole receiving an array method (`self.map`/`.push`/…) is constrained to
  // an array — synthesizing one over a derived element hole and falling into the array-method
  // arm below, which pins the concrete element per call shape. Without this the hole would
  // grow a `{map: any}` struct shape no array argument could satisfy.
  if rt is TyVar {
    if holeArrMethod(cfn.memProp) {
      noteArrayDemand(rt.tvName)
      const elemHole = mkDerivedHole(HD_ELEM, "", -1, -1, recvTy)
      recvTy = mkArrayTy(elemHole)
    } else if holeMapMethod(cfn.memProp) {
      // The dual for a hole receiving a map/set method: becomes the hole's demanded map
      // (`{[?]: ?}`) and falls into the map-method arm below, which pins the open key/value
      // from the method's own arguments — `.add` mints the Set flavor. Without this the hole
      // would grow a `{set: any}` struct shape no map argument could satisfy.
      recvTy = holeMapDemandTy(rt.tvName, cfn.memProp == "add")
    }
  }
  rt = T.tys[recvTy]
  if rt is TyArray {
    const margs = n.callArgs
    if cfn.memProp == "push" {
      if margs.length != 1 {
        tErr("push expects 1 argument, got " + i32ToStr(margs.length), ix)
      } else {
        // Contextual param inference for a pushed callback: `fs.push((n) => n + 1)` over a
        // `((i32) => i32)[]` seeds the lambda's param from the element function type, so an
        // un-annotated lambda infers `n` instead of erroring (mirrors the `.map`/`.filter`
        // seeding). A non-function element / non-lambda arg is left untouched by `seedExpected`.
        if rt.aElem >= 0 { seedExpected(margs[0], rt.aElem) }
        const pat = checkNode(margs[0])
        // The first `.push(v)` on a bare empty `[]` pins its element type to `typeof v` in
        // place — the usage-driven inference that resolves an un-annotated `const xs = []`; a later conflicting push is then a clean type error.
        if rt.aElem < 0 {
          rt.aElem = pat
          tyMutEpoch = tyMutEpoch + 1 // `.push` pinned the element in place
        } else {
          // The pushed value's own open holes pin from the element slot — the same rule
          // `.set` / `m[k] = v` / `xs = e` apply at their own store positions.
          constrainEmptyExpr(margs[0], pat, rt.aElem)
          // Uses `assignableExpr`, not bare `assignable`, so a float-literal argument
          // re-encodes into an `f32` element exactly as it does at a binding, and defers to
          // the pin when a side is a hole (D582).
          if !bmArgOk(BM_PUSH, "push", pat, rt.aElem, recvTy, margs[0]) {
            tErr(bmArgMsg(BM_PUSH, "push", pat, rt.aElem, recvTy), ix)
          }
        }
      }
      return TY_I32
    }
    // `.map(fn)` / `.filter(pred)`: the callback is a 1-arg function over the
    // element type; map yields an array of the callback's return, filter the
    // same array type (its predicate must yield bool).
    if cfn.memProp == "map" || cfn.memProp == "filter" {
      const cargs = n.callArgs
      if cargs.length != 1 {
        tErr(
          cfn.memProp + " expects 1 argument, got " + i32ToStr(cargs.length),
          ix,
        )
        return TY_ERR
      }
      // Seeds the callback's expected param type from the receiver's element type, so an
      // un-annotated function-literal argument infers its param instead of erroring — only
      // when the arg is an anonymous literal and the element type is known, else cleared below.
      const cbArg = P.nodes[cargs[0]]
      if cbArg is FuncDecl {
        if cbArg.fnName == "" && rt.aElem >= 0 {
          recordCbExpected(cargs[0], [rt.aElem])
        }
      }
      const cbTy = checkNode(cargs[0])
      const cb = T.tys[cbTy]
      if cb is TyFunc {
        const cbParams = cb.fnParamTypes
        if cbParams.length != 1 {
          tErr(
            cfn.memProp +
              " callback expects 1 parameter, got " +
              i32ToStr(cbParams.length),
            ix,
          )
        } else if !assignable(rt.aElem, cbParams[0]) {
          tErr(
            cfn.memProp +
              " callback: parameter expects " +
              tyToStr(cbParams[0]) +
              ", got " +
              tyToStr(rt.aElem),
            ix,
          )
        }
        if cfn.memProp == "filter" {
          if !assignable(cb.fnRet, TY_BOOL) {
            tErr(
              "filter predicate must yield boolean, got " + tyToStr(cb.fnRet),
              ix,
            )
          }
          return recvTy
        }
        return mkArrayTy(cb.fnRet)
      }
      tErr(cfn.memProp + " expects a function, got " + tyToStr(cbTy), ix)
      return TY_ERR
    }
    // `.pop()` / `.get(i)` yield `T | null` (an empty pop / out-of-range get is
    // normal absence); `.clear()` empties in place and yields nothing. The element is
    // its VALUE type (`arrElemValueTy`), so a `u8[]` answers `i32 | null` — the same
    // widening `xs[i]` takes, and the rep `emitPopNulBox` already builds (D1211).
    if cfn.memProp == "pop" {
      if margs.length != 0 {
        tErr("pop expects 0 arguments, got " + i32ToStr(margs.length), ix)
      }
      return mkNullableTy(arrElemValueTy(rt.aElem))
    }
    if cfn.memProp == "get" {
      if margs.length != 1 {
        tErr("get expects 1 argument, got " + i32ToStr(margs.length), ix)
      } else {
        const gat = checkNode(margs[0])
        if !bmArgOk(BM_INDEXMUST, "get", gat, TY_I32, -1, margs[0]) {
          tErr(bmArgMsg(BM_INDEXMUST, "get", gat, TY_I32, -1), ix)
        }
      }
      return mkNullableTy(arrElemValueTy(rt.aElem))
    }
    if cfn.memProp == "clear" {
      if margs.length != 0 {
        tErr("clear expects 0 arguments, got " + i32ToStr(margs.length), ix)
      }
      return TY_VOID
    }
    // `.slice(start, end?)` yields a NEW array of the SAME element type — the bounds
    // are i32 (a missing `end` defaults to the length; negatives count from the end).
    if cfn.memProp == "slice" {
      if margs.length != 1 && margs.length != 2 {
        tErr(
          "slice expects 1 or 2 arguments, got " + i32ToStr(margs.length),
          ix,
        )
      } else {
        let si = 0
        while si < margs.length {
          const sat = checkNode(margs[si])
          if !bmArgOk(BM_BOUNDMUST, "slice", sat, TY_I32, -1, margs[si]) {
            tErr(bmArgMsg(BM_BOUNDMUST, "slice", sat, TY_I32, -1), ix)
          }
          si = si + 1
        }
      }
      return recvTy
    }
    // UFCS `self`-method on an array receiver (`parts.join(sep)`): an array
    // carries no user FIELD, so a matching free `self`-function resolves
    // directly — the array dual of the string/struct/union UFCS paths.
    const au = ufcsCallTy(cfn.memProp, recvTy, n, ix)
    if au >= 0 { return au }
    tErr(
      "no method '." +
        cfn.memProp +
        "' on array " +
        tyToStr(recvTy) +
        methodDidYouMean(recvTy, cfn.memProp),
      ix,
    )
    return TY_ERR
  }
  // Map/Set methods over the `{[K]: V}` rep, gated by flavor: a map exposes `.set`/`.get`/
  // `.has`/`.delete`/`.keys`/`.values`; a set exposes only `.add`/`.has`/`.delete`/`.values`.
  // `.add` alone gates on the value's TYPE rather than the flavor bit (see its own arm). The
  // first `.set`/`.add` on a bare `Map()`/`Set()` pins its key/value holes in place.
  if rt is TyMap {
    const mp = cfn.memProp
    const margs2 = n.callArgs
    if mp == "set" && rt.mSet == 0 {
      if margs2.length != 2 {
        tErr("set expects 2 arguments, got " + i32ToStr(margs2.length), ix)
      } else {
        const k0 = checkNode(margs2[0])
        // The value argument is a store into the map's value slot, taking the same
        // contextual steps `xs.push(v)` and `m[k] = v` take: `seedExpected` first, then the
        // expression-aware `assignableExpr` — the one home the assignment path also calls, so `.set` and `m[k] = v` cannot drift apart.
        if rt.mVal >= 0 { seedExpected(margs2[1], rt.mVal) }
        const v0 = checkNode(margs2[1])
        if rt.mKey < 0 {
          rt.mKey = k0
          tyMutEpoch = tyMutEpoch + 1 // `.set` pinned the key in place
          checkInferredMapKey(k0, rt.mSet, ix)
        } else if !bmArgOk(BM_SETKEY, "set", k0, rt.mKey, -1, margs2[0]) {
          tErr(bmArgMsg(BM_SETKEY, "set", k0, rt.mKey, -1), ix)
        }
        if rt.mVal < 0 {
          rt.mVal = v0
          tyMutEpoch = tyMutEpoch + 1 // `.set` pinned the value in place
        } else {
          // The value argument's own open holes pin from the slot, the third step
          // this store shares with `m[k] = v` (which pins in `checkBinExprNode`'s
          // `=` arm) — without it, `m.set("a", fq())` over a `{[string]: f64[]}` reaches the emitter with an unpinned `[]`.
          constrainEmptyExpr(margs2[1], v0, rt.mVal)
          // `assignableExpr` already covers the newtype literal-adoption case (`m.set("k",
          // 1)` over `{[string]: EntityId}` fires), deferring to the pin under a hole (D582).
          if !bmArgOk(BM_SETVAL, "set", v0, rt.mVal, -1, margs2[1]) {
            tErr(bmArgMsg(BM_SETVAL, "set", v0, rt.mVal, -1), ix)
          }
        }
      }
      return TY_VOID
    }
    if mp == "get" && rt.mSet == 0 {
      if margs2.length != 1 {
        tErr("get expects 1 argument, got " + i32ToStr(margs2.length), ix)
      } else {
        const k1 = checkNode(margs2[0])
        if !bmArgOk(BM_KEYMUST, "get", k1, rt.mKey, -1, margs2[0]) {
          tErr(bmArgMsg(BM_KEYMUST, "get", k1, rt.mKey, -1), ix)
        }
      }
      return mkNullableTy(rt.mVal)
    }
    // `.add(x)`, the membership insert (`m[x] = true` as the Set surface): admitted on any
    // map whose VALUE is `boolean`, not only one whose provenance is a `Set()` call — `mSet`
    // is a one-way refinement written only by `Set()`, so gating on it would make `.add`
    // depend on how the value is spelled at its binding rather than on its type.
    if mp == "add" && (rt.mSet == 1 || tyIsPrimNamed(rt.mVal, "boolean")) {
      if margs2.length != 1 {
        tErr("add expects 1 argument, got " + i32ToStr(margs2.length), ix)
      } else {
        const ka = checkNode(margs2[0])
        if rt.mKey < 0 {
          rt.mKey = ka
          tyMutEpoch = tyMutEpoch + 1 // `.add` pinned the Set key in place
          checkInferredMapKey(ka, rt.mSet, ix)
        } else if !bmArgOk(BM_ADDKEY, "add", ka, rt.mKey, -1, margs2[0]) {
          tErr(bmArgMsg(BM_ADDKEY, "add", ka, rt.mKey, -1), ix)
        }
      }
      return TY_VOID
    }
    if mp == "has" || mp == "delete" {
      if margs2.length != 1 {
        tErr(mp + " expects 1 argument, got " + i32ToStr(margs2.length), ix)
      } else {
        const k2 = checkNode(margs2[0])
        if !bmArgOk(BM_KEYMUST, mp, k2, rt.mKey, -1, margs2[0]) {
          tErr(bmArgMsg(BM_KEYMUST, mp, k2, rt.mKey, -1), ix)
        }
      }
      return TY_BOOL
    }
    if mp == "keys" && rt.mSet == 0 {
      if margs2.length != 0 { tErr("keys expects no arguments", ix) }
      return mkArrayTy(rt.mKey)
    }
    if mp == "values" {
      if margs2.length != 0 { tErr("values expects no arguments", ix) }
      // A set's `.values()` yields its ELEMENTS (the keys); a map's its values.
      if rt.mSet == 1 { return mkArrayTy(rt.mKey) }
      return mkArrayTy(rt.mVal)
    }
    tErr(
      "unknown property `" +
        mp +
        "` on " +
        tyToStr(recvTy) +
        methodDidYouMean(recvTy, mp),
      ix,
    )
    return TY_ERR
  }
  // String methods: `.slice`/`.indexOf`/`.includes`/`.charCodeAt`, and the stage 2c trio
  // `.cpAt`/`.cpLen`/`.isCharBoundary` (`.length` is a `Member`, `s[i]` an `Index`). The trio
  // lives in the core rather than `std:str` (OQ-3) because each needs the UTF-8 storage directly
  // — a byte-offset decode, a continuation-byte scan, a lead-bit test — which the surface exposes no other way to reach.
  if rt is TyPrim {
    if rt.primName == "string" {
      const sp = cfn.memProp
      const sargs = n.callArgs
      if sp == "slice" {
        if sargs.length != 2 {
          tErr("slice expects 2 arguments, got " + i32ToStr(sargs.length), ix)
        } else {
          const s0 = checkNode(sargs[0])
          const s1 = checkNode(sargs[1])
          // Two constraints, one sentence: each bound defers on its own (either can be the
          // hole), but the message names both types, so each form carries the other bound as its `ctx` and renders the identical sentence whichever side failed.
          const sb0 = bmArgOk(BM_BOUNDS0, "slice", s0, TY_I32, s1, sargs[0])
          const sb1 = bmArgOk(BM_BOUNDS1, "slice", s1, TY_I32, s0, sargs[1])
          if !sb0 {
            tErr(bmArgMsg(BM_BOUNDS0, "slice", s0, TY_I32, s1), ix)
          } else if !sb1 {
            tErr(bmArgMsg(BM_BOUNDS1, "slice", s1, TY_I32, s0), ix)
          }
        }
        return TY_STR
      }
      if sp == "indexOf" {
        if sargs.length != 1 {
          tErr("indexOf expects 1 argument, got " + i32ToStr(sargs.length), ix)
        } else {
          const a0 = checkNode(sargs[0])
          if !bmArgOk(BM_EXPECTSA, "indexOf", a0, TY_STR, -1, sargs[0]) {
            tErr(bmArgMsg(BM_EXPECTSA, "indexOf", a0, TY_STR, -1), ix)
          }
        }
        return TY_I32
      }
      if sp == "includes" {
        if sargs.length != 1 {
          tErr("includes expects 1 argument, got " + i32ToStr(sargs.length), ix)
        } else {
          const a0 = checkNode(sargs[0])
          if !bmArgOk(BM_EXPECTSA, "includes", a0, TY_STR, -1, sargs[0]) {
            tErr(bmArgMsg(BM_EXPECTSA, "includes", a0, TY_STR, -1), ix)
          }
        }
        return TY_BOOL
      }
      if sp == "charCodeAt" {
        if sargs.length != 1 {
          tErr(
            "charCodeAt expects 1 argument, got " + i32ToStr(sargs.length),
            ix,
          )
        } else {
          const a0 = checkNode(sargs[0])
          if !bmArgOk(BM_IDXPHRASE, "charCodeAt", a0, TY_I32, -1, sargs[0]) {
            tErr(bmArgMsg(BM_IDXPHRASE, "charCodeAt", a0, TY_I32, -1), ix)
          }
        }
        return TY_I32
      }
      // `s.cpAt(i)` — the code point whose UTF-8 sequence begins at byte offset `i`,
      // O(1) (§Codepoints). Not "the i-th code point": the argument is in the one
      // coordinate system `slice`, `indexOf` and `.length` share.
      if sp == "cpAt" {
        if sargs.length != 1 {
          tErr("cpAt expects 1 argument, got " + i32ToStr(sargs.length), ix)
        } else {
          const a0 = checkNode(sargs[0])
          if !bmArgOk(BM_BYTEOFF, "cpAt", a0, TY_I32, -1, sargs[0]) {
            tErr(bmArgMsg(BM_BYTEOFF, "cpAt", a0, TY_I32, -1), ix)
          }
        }
        return TY_I32
      }
      // `s.cpLen()` — the code-point count, O(n) and NAMED so the cost is visible at the
      // call site rather than hidden in a `.length` that is O(1) on some data and O(n)
      // on other data (§Codepoints: "a subscript should mean O(1), always").
      if sp == "cpLen" {
        if sargs.length != 0 {
          tErr("cpLen expects no arguments, got " + i32ToStr(sargs.length), ix)
        }
        return TY_I32
      }
      // `s.isCharBoundary(i)` — Rust's primitive, O(1): a single lead/continuation bit
      // test. Slicing off a boundary is LEGAL under Go-lean validity (§Validity), so this
      // is the tool for code that wants to check rather than a guard the language imposes.
      if sp == "isCharBoundary" {
        if sargs.length != 1 {
          tErr(
            "isCharBoundary expects 1 argument, got " + i32ToStr(sargs.length),
            ix,
          )
        } else {
          const a0 = checkNode(sargs[0])
          if (
            !bmArgOk(BM_BYTEOFF, "isCharBoundary", a0, TY_I32, -1, sargs[0])
          ) {
            tErr(bmArgMsg(BM_BYTEOFF, "isCharBoundary", a0, TY_I32, -1), ix)
          }
        }
        return TY_BOOL
      }
      // `s.bytes()` — the string's UTF-8 storage as a `u8[]`. A COPY, not a view:
      // see `emitStrBytesFnCode` for why a `u8[]` cannot express a non-zero `start`,
      // and `strings-design.md` §Byte view for the withdrawn zero-copy claim.
      if sp == "bytes" {
        if sargs.length != 0 {
          tErr("bytes expects no arguments, got " + i32ToStr(sargs.length), ix)
        }
        return mkArrayTy(TY_U8)
      }
      // UFCS `self`-method on a string receiver (`"hello".first()`).
      const su = ufcsCallTy(sp, recvTy, n, ix)
      if su >= 0 { return su }
      // D1230 on a STRING receiver. This arm answers before the general one and
      // raises its own sentence at the CALL node, so it asks and raises here
      // rather than banking — `memberFloorErr` never sees a string method call.
      const suSpecs = ufcsMissingImportSpecs(sp, recvTy, n.callArgs.length)
      if suSpecs != "" {
        tErrCodedData(
          ufcsNotImportedMsg(sp, suSpecs, recvTy),
          ix,
          CODE_UFCS_NOT_IMPORTED,
          ufcsNotImportedData(sp, suSpecs, recvTy),
        )
        return TY_ERR
      }
      // D1570 on a STRING receiver, raised here for the reason D1230's arm is: this arm
      // answers before the general one, so `memberFloorErr` never sees a string method call
      // and there is nothing to bank for.
      const suName = ufcsAliasAtSite(ix, sp)
      const suKind = ufcsNotMethodKind(suName, recvTy, n.callArgs.length)
      if suKind != 0 {
        tErrCodedData(
          ufcsNotMethodMsg(sp, suName, recvTy, n.callArgs.length, suKind),
          ix,
          CODE_UFCS_NOT_METHOD,
          ufcsNotMethodData(sp, suName, recvTy, suKind),
        )
        return TY_ERR
      }
      tErr(
        "no method '." + sp + "' on string" + methodDidYouMean(recvTy, sp),
        ix,
      )
      return TY_ERR
    }
  }
  // UFCS `self`-method on any other receiver: `o.f(args)` lowers to `f(o, args)` when the
  // receiver has no such field (a callable field keeps precedence) and a matching free
  // function exists. The field-first test is `tyFieldTyOf`, the same predicate the emitter's
  // `drwWalk` calls on the receiver's recorded type, so the two cannot disagree (D1070).
  const ufcsHasField = tyFieldTyOf(recvTy, cfn.memProp) >= 0
  const urt = T.tys[recvTy]
  // A bounded type parameter as the receiver (OQ-5, strict bodies): the bound answers, and
  // only the bound — arguments check against its declared members and the result is what it
  // promised. No dispatch happens here; the witness is chosen per instantiation site
  // (`checkBoundsAtCall`) and baked by the monomorphizer.
  if urt is TyVar {
    const bcTy = boundMemberTy(urt.tvName, cfn.memProp, true)
    if bcTy == BOUND_UNRESOLVED {
      tErr(boundMemberUnknownMsg(urt.tvName, cfn.memProp), ix)
      return TY_ERR
    }
    if bcTy >= 0 {
      const bcT = T.tys[bcTy]
      if bcT is TyFunc {
        const bcArgs = n.callArgs
        if bcArgs.length != bcT.fnParamTypes.length {
          tErr(
            "`" +
              cfn.memProp +
              "` on `" +
              urt.tvName +
              "` expects " +
              i32ToStr(bcT.fnParamTypes.length) +
              " arguments, got " +
              i32ToStr(bcArgs.length),
            ix,
          )
          return TY_ERR
        }
        let bca = 0
        while bca < bcArgs.length {
          const bcat = checkNode(bcArgs[bca])
          const bcWant = bcT.fnParamTypes[bca]
          // An UNRESOLVED member type (`-1`) is a bound whose own annotation
          // named something this scope has no answer for. Reported once, at the
          // call, rather than fed to `assignable` — which reads a negative side
          // as "accept anything" and would silently pass every argument.
          if bcWant < 0 {
            tErr(boundMemberUnknownMsg(urt.tvName, cfn.memProp), ix)
            return TY_ERR
          }
          if !assignableExpr(bcArgs[bca], bcat, bcWant) {
            argMismatchErr(bca + 1, bcWant, bcat, bcArgs[bca])
          }
          bca = bca + 1
        }
        if bcT.fnRet < 0 {
          tErr(boundMemberUnknownMsg(urt.tvName, cfn.memProp), ix)
          return TY_ERR
        }
        return bcT.fnRet
      }
    }
    const bcMsg = boundMemberFloorMsg(urt.tvName, cfn.memProp)
    if bcMsg != "" {
      tErr(bcMsg, ix)
      return TY_ERR
    }
  }
  if !ufcsHasField {
    const uu = ufcsCallTy(cfn.memProp, recvTy, n, ix)
    if uu >= 0 { return uu }
    // The name is a self-function, just not one in scope (D1230) — asked here since only
    // the call knows the argument count, banked on the callee member node where the sentence is raised (`memberFloorErr`).
    noteUfcsMiss(
      n.callFn,
      ufcsMissingImportSpecs(cfn.memProp, recvTy, n.callArgs.length),
    )
    // When the name is already in scope, which gate declined (D1570) — banked beside
    // D1230's answer and read after it, since `argc` is known here and raised there.
    noteUfcsNotMethod(
      n.callFn,
      cfn.memProp,
      ufcsAliasAtSite(ix, cfn.memProp),
      recvTy,
      n.callArgs.length,
    )
  }
  -1
}

// A memory intrinsic declared in the default scope but with no emitter arm
// (`nameIsUnimplementedIntrinsic`) is reported here rather than as the emitter's generic "call
// to unknown function", which would misread a missing implementation as a typo. Gated on the
// callee still denoting that binding, so a shadowing declaration or parameter keeps it (D1604).
function checkUnimplementedIntrinsicCall(cfn: Ident, ix: i32) {
  if (
    nameIsUnimplementedIntrinsic(cfn.identName) &&
    (fnDeclIx[cfn.identName] ?? -1) < 0 &&
    lookupDepth(cfn.identName) == 0
  ) {
    tErrUnsupported(
      "'" +
        cfn.identName +
        "' is declared but has no implementation yet — it type-checks and then has nothing to lower (see `docs/internals/memory-gc-design.md` §1.2)",
      ix,
    )
  }
}

// Calls to a compiler builtin named by the callee identifier — `print`, `Map`/`Set`, the
// codepoint constructors and the `__array_*` / bitcast / numeric intrinsics. None has a
// declaration to check against, so arity and argument types are checked here. Returns the
// call type, or `-1` when the name is none of them and the caller checks it as a value.
function checkBuiltinIdentCall(n: Call, ix: i32, cfn: Ident): i32 {
  // `print(x)` is a compiler builtin (no module/import system yet): it accepts a
  // single value of any printable type and yields void. Special-cased so a program
  // that prints does not trip "undeclared identifier 'print'". Each argument is
  // still checked so a type error inside it surfaces.
  if cfn.identName == "print" {
    const pargs = n.callArgs
    let pj = 0
    while pj < pargs.length {
      const pt = checkNode(pargs[pj])
      // `print` demands a value to render, and a `void` call has none — the emitter's
      // print ladder ends in `call __print_i32__` with nothing on the stack.
      voidValueSlotErr(pt, pargs[pj], "print", pargs[pj])
      // A domain rejection, asked first (the ruling): `print` takes one value of
      // `printDomainStr()`'s reps, and an array/struct/map/function value (bare, behind
      // `| null`, or inside a union) is not one — an ordinary domain error (`tErr`, no
      // code), not a capability admission, since the language never defined what such a print outputs (D711).
      if tyPrintsAsRef(pt, 24) {
        tErr(printRefRefusal(pt), pargs[pj])
      } else {
        // The BOXED value-union residue. `print(<i32 | string>)` now LOWERS — every arm
        // is inside the domain and the emitter dispatches on the box tag, the same
        // dispatch it performs for `is` (D712) — so what is left here is a box whose
        // arms that dispatch cannot classify, and only that keeps the concession.
        const puMsg = printUnionRefusal(pt)
        if puMsg != "" { tErrUnsupported(puMsg, pargs[pj]) }
      }
      // A printed type that still carries a HOLE answers FALSE to both floors above — it
      // is neither a ref nor a box YET — so the two of them together admit every generic
      // `print`. Defer it to the pin, the only position that knows the instance.
      // (`silent-class-inventory` D401; the recorder's header has the measurement.)
      notePrintCstr(pt, pargs[pj])
      pj = pj + 1
    }
    return TY_VOID
  }
  // `Map()` / `Set()` construct an empty string-keyed map: key/value HOLES (-1)
  // assignable to any map annotation (`const m: {[string]: i32} = Map()`).
  if cfn.identName == "Map" || cfn.identName == "Set" {
    if n.callArgs.length != 0 {
      tErr(cfn.identName + " expects no arguments", ix)
    }
    if cfn.identName == "Set" {
      // A set's VALUE type is the membership boolean; the element (key) is a
      // hole pinned by the annotation or the first `.add`.
      return mkMapTy(-1, TY_BOOL, 1)
    }
    return mkMapTy(-1, -1, 0)
  }
  // `toString(x)` resolves through the ordinary scope as `std:fmt`'s export now, and an
  // un-imported use gets the migration hint `undeclaredIdentMsg` appends.
  // `fromCodePoints(xs)` is a builtin: an `i32[]` of code points to a string, in one bulk
  // copy (the amortized alternative to per-char concat).
  if cfn.identName == "fromCodePoints" {
    const pargs = n.callArgs
    if pargs.length != 1 {
      tErr(
        "fromCodePoints expects 1 argument, got " + i32ToStr(pargs.length),
        ix,
      )
    } else {
      const p0 = checkNode(pargs[0])
      const p0t = T.tys[p0]
      let pOk = false
      if p0t is TyArray {
        // An empty `[]` literal's element hole (-1) pins to i32 here.
        if p0t.aElem < 0 || assignable(p0t.aElem, TY_I32) { pOk = true }
      }
      if p0t is TyErr { pOk = true }
      if !pOk {
        tErr("fromCodePoints expects an i32[], got " + tyToStr(p0), ix)
      }
    }
    return TY_STR
  }
  // `fromCodePoint(code)` is a builtin: an i32 code point -> a length-1 string.
  if cfn.identName == "fromCodePoint" {
    const fargs = n.callArgs
    if fargs.length != 1 {
      tErr(
        "fromCodePoint expects 1 argument, got " + i32ToStr(fargs.length),
        ix,
      )
    } else {
      const f0 = checkNode(fargs[0])
      if !assignable(f0, TY_I32) {
        tErr("fromCodePoint expects an i32, got " + tyToStr(f0), ix)
      }
    }
    return TY_STR
  }
  // The array-intrinsic floor (std-design D1 / collections-design §LS.2),
  // host parity: `defaultScope.ts`. `__array_new__(n, fill)` allocates `n`
  // slots each set to `fill`, typing as `T[]` with `T` = the fill's type.
  if cfn.identName == "__array_new__" {
    const anArgs = n.callArgs
    if anArgs.length != 2 {
      tErr(
        "__array_new__ expects 2 arguments, got " + i32ToStr(anArgs.length),
        ix,
      )
      return mkArrayTy(-1)
    }
    const anLen = checkNode(anArgs[0])
    if !assignable(anLen, TY_I32) {
      tErr("__array_new__ expects an i32 length, got " + tyToStr(anLen), ix)
    }
    return mkArrayTy(checkNode(anArgs[1]))
  }
  // `__array_new_default__(n)`: `n` zeroed/default slots. The element type is a hole (-1)
  // pinned by the destination — the empty-`[]` mechanism — and the emitter reads the same
  // pinned row back off this node (`arrNewDefaultKind`), so the two cannot disagree about
  // the rep. Two questions this arm cannot answer yet are recorded here and asked late (`arrDefCallIx`).
  if cfn.identName == "__array_new_default__" {
    const adArgs = n.callArgs
    if adArgs.length != 1 {
      tErr(
        "__array_new_default__ expects 1 argument, got " + i32ToStr(adArgs.length),
        ix,
      )
    } else {
      const adLen = checkNode(adArgs[0])
      if !assignable(adLen, TY_I32) {
        tErr(
          "__array_new_default__ expects an i32 length, got " + tyToStr(adLen),
          ix,
        )
      }
    }
    const adTy = mkArrayTy(-1)
    arrDefCallIx.push(ix)
    arrDefCallTy.push(adTy)
    return adTy
  }
  // `__array_copy__(dst, dstAt, src, srcAt, count)`: bulk-moves `count` elements from
  // `src[srcAt..]` into `dst[dstAt..]`; void. Both must be arrays; the element correlation
  // between them is deliberately not enforced here, matching the host's own leniency (a
  // mismatched pair fails loudly at the emit stage in both compilers).
  if cfn.identName == "__array_copy__" {
    const acArgs = n.callArgs
    if acArgs.length != 5 {
      tErr(
        "__array_copy__ expects 5 arguments, got " + i32ToStr(acArgs.length),
        ix,
      )
      return TY_VOID
    }
    let acI = 0
    while acI < 5 {
      const acT = checkNode(acArgs[acI])
      if acI == 0 || acI == 2 {
        const acTy = T.tys[acT]
        let acOk = false
        if acTy is TyArray { acOk = true }
        if acTy is TyErr { acOk = true }
        if !acOk {
          tErr("__array_copy__ expects a T[], got " + tyToStr(acT), ix)
        }
      } else {
        if !assignable(acT, TY_I32) {
          tErr("__array_copy__ expects an i32, got " + tyToStr(acT), ix)
        }
      }
      acI = acI + 1
    }
    return TY_VOID
  }
  // `__trap__()`: the deliberate abort primitive — lowered to `unreachable`.
  // `__trap__("reason")`: an OPTIONAL single string message, printed to the
  // host boundary (the print-of-string path) before the abort — so the trap
  // carries a human-readable reason. Either form still "never returns".
  if cfn.identName == "__trap__" {
    if n.callArgs.length > 1 {
      tErr("__trap__ takes an optional string message", ix)
    } else if n.callArgs.length == 1 {
      const trapMsgTy = checkNode(n.callArgs[0])
      if !assignable(trapMsgTy, TY_STR) {
        tErr(
          "__trap__ takes an optional string message, got " + tyToStr(trapMsgTy),
          ix,
        )
      }
    }
    return TY_VOID
  }
  // The numeric-opcode intrinsics: each lowers to exactly one wasm instruction, so
  // the checker only has to type them. A user binding of the same name shadows the
  // intrinsic (`numIntrShadowed`), and the emitter gates on the same rule — the
  // intrinsic arm is a fallback for a name the program did not define itself.
  if !numIntrShadowed(cfn.identName) {
    const bcTy = bitcastCallTy(cfn.identName, n, ix)
    if bcTy >= 0 { return bcTy }
    const niTy = numIntrCallTy(cfn.identName, n, ix)
    if niTy >= 0 { return niTy }
  }
  -1
}

// The ordinary call: the callee evaluates to a function type, so the arguments are checked
// against its parameter list — named arguments reordered, an omitted trailing one filled
// from the declaration default, and type-parameter bindings solved from the argument types.
// Always answers; the caller's remaining arms cover an error or still-unsolved callee.
function checkCallOnFuncTy(n: Call, ix: i32, cfn: Node, ft: TyFunc): i32 {
  let args = n.callArgs
  // PENDING return (-2): the un-annotated callee hasn't been inferred yet (a
  // forward call). Demand-infer it now — check its FuncDecl, which patches this
  // very TyFunc in place — unless it is already on the in-progress stack (an
  // in-cycle call: contribute TY_ERR so the cycle can be detected at the root).
  if ft.fnRet == -2 {
    if cfn is Ident {
      if !onInferStack(cfn.identName) {
        const dIx = fnDeclIx[cfn.identName] ?? -1
        if dIx >= 0 { checkNode(dIx) }
      }
    }
  }
  let retTy = ft.fnRet
  if retTy == -2 {
    retTy = TY_ERR
    // A direct self-recursive call resolves to the function's own provisional inferred
    // type (`inferObserved`, already holding the base case since it is checked first) —
    // without this, `TY_ERR` makes `assignable(TY_ERR, string)` vacuously true and a `+`
    // over the recursive call pollutes the inferred return. Mutual recursion keeps `TY_ERR` for the fixpoint to settle.
    if cfn is Ident {
      if inferStack.length > 0 {
        if inferStack[inferStack.length - 1] == cfn.identName {
          if inferObserved >= 0 { retTy = inferObserved }
        }
      }
    }
  }
  const params = ft.fnParamTypes
  // Defaults are direct-call-site sugar: a call naming a declared function may omit
  // trailing arguments whose parameters carry a default, so the accepted arity is the
  // range [`fnRequiredArity`, `params.length`]. A call through a function value has no
  // declaration to read defaults from and keeps its exact-arity gate.
  const dParams = calleeDeclParams(n.callFn)
  let required = params.length
  if dParams.length == params.length { required = fnRequiredArity(dParams) }
  if args.length < required || args.length > params.length {
    tErr(
      "wrong number of arguments: expected " +
        arityWantText(required, params.length) +
        ", got " +
        i32ToStr(args.length),
      ix,
    )
    return retTy
  }
  // Named arguments bind to parameters by name, then positionally — source order is
  // irrelevant for named args. `TyFunc` carries no parameter names, so the names resolve
  // against the declaration the scope chain gives this callee; a closure-valued binding has
  // none and cannot take named arguments, whatever a same-named declaration says (D1604).
  if hasNamedArgs(n.callArgNames) {
    const cNames = paramNamesOfNodes(dParams)
    if cNames.length != params.length {
      tErr("named arguments require a declared function", ix)
      return retTy
    }
    args = orderNamedCallArgs(cNames, args, n.callArgNames, ix, dParams)
    if args.length != params.length { return retTy }
  } else if args.length < params.length {
    // Trailing positional omission: check the defaults against their
    // parameters alongside the supplied arguments, so one loop below covers
    // the whole parameter list. (`args` is rebound to a COPY — `n.callArgs`
    // stays the source list; the emit-side normalization is `emit_rewrite`'s.)
    const padded: i32[] = []
    let pj = 0
    while pj < params.length {
      if pj < args.length { padded.push(args[pj]) } else { padded.push(-1) }
      pj = pj + 1
    }
    if fillArgDefaults(padded, dParams, ix) >= 0 { return retTy }
    args = padded
  }
  // Generic call-site inference: a `TyVar` param (or `T[]`) binds its type-param to
  // the argument's type (first use wins; later uses must agree), and the return
  // type substitutes through the binding — so `id("s")` is `string`, and
  // `let n: i32 = id("s")` is a genuine type error downstream.
  const bNames: string[] = []
  const bTys: i32[] = []
  let i = 0
  while i < args.length {
    // Contextual param inference for a function-value argument: propagates the expected
    // param type into it so an un-annotated literal param infers from the signature
    // (matching `.map`/`.filter`), substituting type-param bindings from earlier arguments
    // first — `mapArr(xs: T[], f: (T) => R)` called with `[1,2,3]` binds `T = i32` before seeding `f`'s param as `i32`.
    seedExpected(args[i], substTyDeep(params[i], bNames, bTys))
    const at = checkNode(args[i])
    // A template hole meeting its injected renderer. This line is the first
    // moment the hole's type exists, which is why the type-directed half of
    // the template lowering lives here and not in the parser's desugar.
    if nodeIsTplHole(args[i]) {
      if tplHoleHandled(ix, n.pos, args[i], at, params[i]) { return TY_STR }
    }
    // Bind every TyVar reachable in the expected param position from the
    // argument's shape (first use wins), then check the argument against the
    // SUBSTITUTED expected type — a later disagreeing use errors here.
    bindGenWalk(params[i], at, bNames, bTys)
    const expected = substTyDeep(params[i], bNames, bTys)
    // A `u8[]` argument meeting a generic parameter: `bindGenWalk` above declined to bind
    // `T` to storage type `u8`, so `expected` still carries the unsolved hole and
    // `assignable` answers true vacuously — needing its own message here, or the
    // monomorphizer builds i32-list machinery over a one-byte backing. `u8[]` is not an instantiation of `T[]`, since `T` ranges over value types and `u8` is storage.
    if !inferQuiet {
      if tyIsU8ArrayTy(at) && tyReachesHole(expected, 8) {
        tErr(
          "`u8[]` cannot be passed to a generic parameter — `u8` is a storage type, so a type parameter never binds it and a `u8[]` is not a `T[]`",
          args[i],
        )
      }
    }
    // A hole or deferred-join argument passes `assignable` vacuously, so the demand is
    // recorded here and re-validated at the generic call site that pins it under the
    // substituted argument types — without this, `function f(x) { g(x) }` with `g(n: i32)`
    // type-checks `f("s")` clean and dies at wasm validation. Recorded on the argument's uncollapsed type, since a join's collapsed arm can later prove unreachable.
    const atCstr = inferRetTyOf(args[i], at)
    if tyIsHole(atCstr) || tyIsDeferredJoin(atCstr) {
      if !tyIsHole(expected) {
        let ccWho = ""
        if cfn is Ident { ccWho = cfn.identName }
        noteArgCstr(atCstr, expected, ccWho)
      }
    }
    // A hole param whose body DEMANDED fields (member access on the hole)
    // checks the argument against the demanded shape, so `getx(5)` rejects
    // when the body read `o.x` (host: the grown `Infer<{x,…}>` pin).
    const pHole = T.tys[params[i]]
    if pHole is TyVar {
      if !holeDemandOk(pHole.tvName, args[i], at) {
        holeArgDemandErr(pHole.tvName, i + 1, at, args[i])
      }
      // A hole the body INDEXED (`self[i]`) demands an array — a scalar argument can't be
      // indexed, so reject it here (`head(5)`) instead of deferring to an emit failure.
      if holeIsArrayDemanded(pHole.tvName) {
        if tyRefusesArrayDemand(at) { holeArgArrayErr(i + 1, at, args[i]) }
      }
      // The `as` cast the body parked on this hole, re-asked under the argument. D1342.
      holeCastPinCheck(pHole.tvName, at, declParamNameAt(dParams, i))
    }
    // The cast this argument itself is (`id(a as? i32)`), whose destination the pin has to
    // re-ask (D1371) — but only when the parameter is not a hole: for a hole parameter,
    // `expected` is the pre-pin answer rather than a declared demand, and holding the cast to it would refuse a program whose annotated twin runs.
    if !tyIsHole(params[i]) { noteCastArgDest(args[i], i + 1, expected) }
    // Passing an empty-collection argument into a concrete `T[]` / map param pins
    // its element type from the param (`len(empty)` resolves `empty` to `i32[]`),
    // clearing its uninferred floor — pure downstream-usage inference, no push.
    constrainEmptyExpr(args[i], at, expected)
    if !assignableExpr(args[i], at, expected) {
      // Anchored at the offending argument (or its offending return site),
      // never at the call node — see `argMismatchErr`.
      argMismatchErr(i + 1, expected, at, args[i])
    }
    i = i + 1
  }
  // Substitutes the binding into a generic return type — deep, so a structural return
  // (`{first: B, second: A}`, a generic alias body, a function-typed field) concretizes
  // per call site; a derived `?ret.` hole collapses to the pinned callee's return
  // (`substTyDeep`).
  if bNames.length > 0 {
    const dBeforeC = T.diags.length
    let cstrCallee = CSTR_NODECL
    let cstrWho = ""
    if cfn is Ident {
      cstrCallee = fnDeclIx[cfn.identName] ?? CSTR_NODECL
      // A local bound to a declared generic names that declaration — without this rung the
      // call falls to `CSTR_NODECL` and adjudicates every generic in the program, since
      // `substTyDeep` matches `TyVar`s by name and `const g = idT  g(structList)` would
      // otherwise report a sibling's refusal.
      if cstrCallee == CSTR_NODECL {
        const aliasIx = lookupFnAliasNode(cfn.identName)
        if aliasIx >= 0 { cstrCallee = aliasIx }
      }
      cstrWho = cfn.identName
    }
    // The direct spelling has no receiver, so every parameter is an argument (`selfOff` 0)
    // and `params`/`args` are already 1:1 (named arguments reordered, defaults padded).
    const dhNames: string[] = []
    const dhArgNo: i32[] = []
    const dhArgNode: i32[] = []
    holeArgOrigins(params, args, 0, dhNames, dhArgNo, dhArgNode)
    validateBinCstrs(
      bNames,
      bTys,
      ix,
      cstrCallee,
      cstrWho,
      dhNames,
      dhArgNo,
      dhArgNode,
    )
    validatePrintCstrs(bNames, bTys, ix, cstrCallee, cstrWho)
    validateArgCstrs(bNames, bTys, ix)
    // The declared return rides the same pin: the body's mismatch check is vacuous under
    // a hole, and this is the first position that knows the instance (D551).
    validateRetCstrs(bNames, bTys, ix, cstrCallee, cstrWho)
    // The destination seam, for the same reason: a value landing in a hole-typed local /
    // field / element inside the body is a mismatch the body's own gate cannot decide (D572).
    validateLetCstrs(bNames, bTys, ix, cstrCallee, cstrWho)
    // A builtin collection method's argument inside the body, for the same reason at a
    // callee kind the deferred-argument table cannot name: a builtin has no `FuncDecl`, so its own arm is the whole check and is vacuous under a hole (D582).
    validateBmCstrs(bNames, bTys, ix, cstrCallee, cstrWho)
    // The receiver classification of a `.length` / `x[i]` inside the body: both arms admit
    // the operation on a type variable correctly (a `T` pinned to a collection has it), and
    // this is the first position that knows which rep `T` became (D651 / D691).
    validateMemCstrs(
      bNames,
      bTys,
      ix,
      cstrCallee,
      cstrWho,
      dhNames,
      dhArgNo,
      dhArgNode,
    )
    validateUfcsCstrs(bNames, bTys, ix, cstrCallee, cstrWho)
    // The bounds the callee declared, judged here in this site's own scope against the
    // types this site bound — not deferred, since a bound is written at the declaration:
    // there is nothing to record on the way in, only something to check on the way out.
    checkBoundsAtCall(cstrWho, cstrCallee, bNames, bTys, ix)
    // The escaped-join reject is a fallback, not an additional voice: when this site
    // already reported a precise operand/argument-flow diagnostic, a join report would only repeat it in vaguer words.
    if T.diags.length == dBeforeC { validateEscJoins(bNames, bTys) }
    retTy = substTyDeep(retTy, bNames, bTys)
  }
  // A deferred join the re-fold could not decide here (the callee's arms name a hole this
  // site does not bind) must not escape as this call's type — the emitter has no rep for a
  // placeholder union. Collapses to one arm, but parks the uncollapsed join first so a
  // `return h(w)` relay body can carry the whole join to its own call sites (`inferRetTyOf`).
  const cRetTy = collapseDeferredJoin(retTy)
  if cRetTy != retTy {
    noteDeferredJoinNode(ix, retTy)
    let ejWho = ""
    if cfn is Ident { ejWho = cfn.identName }
    noteEscJoin(retTy, ix, ejWho)
  }
  return cRetTy
}

// A call expression, dispatched on the callee's shape: a member callee to
// `checkMemberCallNode`, a bare identifier to `checkUnimplementedIntrinsicCall` and
// `checkBuiltinIdentCall`, a function-typed value to `checkCallOnFuncTy`. The type-answering
// three return `-1` for "no arm claimed it"; an unclaimed callee is reported here as `TY_ERR`.
function checkCallNode(n: Call, ix: i32) {
  const cfn = P.nodes[n.callFn]
  if cfn is Member {
    const mt = checkMemberCallNode(n, ix, cfn)
    if mt >= 0 { return mt }
  }
  if cfn is Ident { checkUnimplementedIntrinsicCall(cfn, ix) }
  if cfn is Ident {
    const bt = checkBuiltinIdentCall(n, ix, cfn)
    if bt >= 0 { return bt }
  }
  const fnTy = checkNode(n.callFn)
  const ft = T.tys[fnTy]
  if ft is TyFunc { return checkCallOnFuncTy(n, ix, cfn, ft) }
  if ft is TyErr { return TY_ERR }
  if ft is TyVar {
    // Calling an inference-hole value — an un-annotated parameter used as a function inside
    // its own generic body (`function apply(fn, a, b) { fn(a, b) }`): the arguments are
    // checked on their own and the call yields a fresh hole, resolved once an outer call
    // binds the generic signature (the emitter compiles each instance concretely).
    const hargs = n.callArgs
    let hj = 0
    while hj < hargs.length {
      checkNode(hargs[hj])
      hj = hj + 1
    }
    return mkDerivedHole(HD_RET, "", -1, -1, fnTy)
  }
  tErr("called value is not a function (" + tyToStr(fnTy) + ")", ix)
  TY_ERR
}

// Resolves a written annotation name in the context of generic type-parameter names: params
// bind to their `TyVar`s in the type-param environment `nameToTy` consults, so a bare `T`, a
// `T[]` suffix, a structural shape, and a generic alias application all resolve through one
// name grammar. Memoized only for the env-free case (a live `tpEnv` bypasses, since one spelling means different types under different bindings), and only once resolution succeeds.
let annotNameMemo: {[string]: i32} = Map()
// Failed resolutions memoize too, under the version that failed (`cUserTypesVer`): a name
// unresolvable now may resolve once later declarations register, so the negative hit is
// honored only while no new declared-name resolution has registered since. `nameToTy` mints
// partial types before failing, so an un-memoized failure re-probed in a loop would still grow the arena.
let annotNameMemoNegVer: {[string]: i32} = Map()
// The component the failure banked also restores from a negative memo hit (`unkTyPart`) —
// without it a diagnostic would quote whichever name failed last anywhere in the program,
// since pass 1 hoists every signature (priming the negative memo) before pass 2 reports.
let annotPart: {[string]: string} = Map()

// The unseparable-member reason (`unkTyClash`) restores the same way and for the same
// mechanism: a negative memo hit returns -1 without re-entering the resolver, so a hoisted
// pass-1 signature reported in pass 2 would otherwise fall back to the generic wording. Kept
// as a separate map from `annotPart` since the two are different bank fields, each restored on its own.
let annotClash: {[string]: string} = Map()

// The component banked for the failing spelling `name`, or "".
function annotPartOf(name: string) { return annotPart[name] ?? "" }

// The unseparable-member reason banked for the failing spelling `name`, or "".
function annotClashOf(name: string) { return annotClash[name] ?? "" }

export function resolveAnnot(name: string, typarams: string[]) {
  resolveAnnotTs(name, typarams, -1)
}

// `resolveAnnot`, with the annotation's spelling root threaded to the three legs that
// actually resolve. `root < 0` is the name route — what the exported entry point (and its
// `emit_rep.vl` callers) get, since a post-canon emit-time name has no live tree. The memo
// stays keyed on the name regardless: a hit returns the same index whichever route minted it, and only a miss re-reads the tree.
function resolveAnnotTs(name: string, typarams: string[], root: i32) {
  if typarams.length == 0 {
    if tpEnvNames.length == 0 {
      const hit = annotNameMemo[name] ?? -2
      if hit != -2 {
        // Restores the collapse bank (D1048), for the same reason the negative leg restores
        // `unkTyPart`: a memo hit never re-enters the resolver, so a spelling whose first
        // resolution collapsed would answer "no collapse" at every later site.
        collapsedTy = annotCollapsed[name] ?? -1
        return hit
      }
      const negVer = annotNameMemoNegVer[name] ?? -1
      if negVer == cUserTypesVer {
        // Restore the component this name banked when it actually resolved, so the
        // caller's `unknownTyText` reads THIS name's leaf and not the last one anywhere.
        unkTyPart = annotPartOf(name)
        unkTyClash = annotClashOf(name)
        return -1
      }
      const r = annotResolve(name, root)
      if r >= 0 {
        annotNameMemo[name] = r
        // Banks the collapse alongside the index, only when there is one — the read
        // above defaults to -1, so the absent key means "this spelling collapses nothing".
        if collapsedTy >= 0 { annotCollapsed[name] = collapsedTy }
      } else {
        annotNameMemoNegVer[name] = cUserTypesVer
        annotPart[name] = unkTyPart
        annotClash[name] = unkTyClash
      }
      return r
    }
    return annotResolve(name, root)
  }
  let i = 0
  while i < typarams.length {
    tpEnvNames.push(typarams[i])
    tpEnvTys.push(mkTyVar(typarams[i]))
    i = i + 1
  }
  const r = annotResolve(name, root)
  let j = 0
  while j < typarams.length {
    tpEnvNames.pop()
    tpEnvTys.pop()
    j = j + 1
  }
  r
}

// `resolveAnnot` with resolution diagnostics anchored at node `at` (the
// annotation's TypeRef) — see `annotDiagAt`.
function resolveAnnotAt(name: string, typarams: string[], at: i32) {
  const saved = annotDiagAt
  annotDiagAt = at
  const r = resolveAnnotTs(name, typarams, annTsOf(at))
  annotDiagAt = saved
  // D1023 at the inline spelling: pass 0d catches a union with a declaration to walk, but an
  // inline `function f(): A | B` has none, so the arm-discriminability rule is asked again
  // here, at the annotation — the checker's own route, which keeps this out of the emit
  // phase. `tErrOncePerMsg` dedups the case where a declared union reaches it from both routes.
  const dm = unionDiscrimMsg(r)
  if dm != "" { tErrOncePerMsg(dm, at) }
  r
}

// Is `name` currently being inferred (on the in-progress stack)?
function onInferStack(name: string) {
  let i = 0
  while i < inferStack.length {
    if inferStack[i] == name { return true }
    i = i + 1
  }
  false
}

// Record a type a PENDING body produced (a `return e` or the trailing expression):
// the first CONCRETE type wins; an error type only notes that something err-ish
// flowed back (an in-cycle call), which distinguishes "void body" from "no basis".
function noteInferredRet(t: i32) {
  if t < 0 { return 0 }
  const tt = T.tys[t]
  if tt is TyErr {
    inferSawErr = true
    return 0
  }
  if tt is TyPrim {
    if tt.primName == "void" { return 0 }
  }
  // Joins every non-void return, not just the first: a function whose returns disagree
  // (`return 5` … `return null`) infers the flattened union/nullable of them, so the caller
  // sees the true type — first-wins alone silently dropped later branches. A return reached
  // only through an `is`-guard over a hole param contributes a guarded member instead (`mkGuardedRetTy`).
  const g = mkGuardedRetTy(t)
  if inferObserved < 0 {
    inferObserved = g
  } else {
    inferObserved = joinRetTys(inferObserved, g)
  }
  0
}

// The natural-return accumulator for the redundant-return rule (annotated funcs):
// the FIRST non-void/non-error return observed, mirroring noteInferredRet so the
// captured type IS what an unannotated version would infer.
function noteNaturalRet(t: i32) {
  if t < 0 { return 0 }
  const tt = T.tys[t]
  if tt is TyErr {
    retNaturalErr = true
    return 0
  }
  if tt is TyPrim {
    if tt.primName == "void" { return 0 }
  }
  // JOIN, mirroring noteInferredRet (above) so the captured "natural" return IS what
  // an unannotated version would infer — a multi-return function joins to a union.
  if retNatural < 0 {
    retNatural = t
  } else {
    retNatural = joinTys(retNatural, t)
  }
  0
}

// Records what one `a op b` site did with the operator name (D491): `dispatched` true means
// a user declaration fired, false means the language's own lowering took it. Guarded on
// `inferQuiet` for the same hazard `opIdxBank` guards on — a quiet inference probe resolves
// against a hole that may pin elsewhere later, so its answer is not a site's answer.
function opBinSiteTook(op: string, dispatched: boolean) {
  if inferQuiet { return 0 }
  if dispatched {
    if !listHasStr(opBinDispatched, op) { opBinDispatched.push(op) }
    return 0
  }
  if !listHasStr(opBinDeclined, op) { opBinDeclined.push(op) }
  0
}

// The whole-program verdict on a type-parameter `self` (D491), run once at the end of
// `checkProgram` when every site has been visited: a banked hole-`self` declaration with no
// site that dispatched to its name, and at least one site that took the language's own
// lowering. Neither a declaration-site nor call-site rule alone can state this — a call-site version would also refuse `40 + 2` in an unrelated function.
function checkProgramEndOpDecls() {
  let i = 0
  while i < opBinHoleDeclName.length {
    const nm = opBinHoleDeclName[i]
    if !listHasStr(opBinDispatched, nm) {
      if listHasStr(opBinDeclined, nm) {
        let why = "`self` has NO ANNOTATION, so its type is inferred and whether it fires is "
        if opBinHoleDeclAnn[i] {
          why = "`self` is a TYPE PARAMETER, so whether it fires is "
        }
        tErr(
          "operator `" +
            nm +
            "` never dispatches: " +
            why +
            "decided at each site — and every `" +
            nm +
            "` site in this program took the language's own lowering. Annotate `self` " +
            "with the object type the operator is for, or remove the declaration",
          opBinHoleDeclNode[i],
        )
      }
    }
    i = i + 1
  }
  0
}

function listHasStr(xs: string[], v: string) {
  let i = 0
  while i < xs.length {
    if xs[i] == v { return true }
    i = i + 1
  }
  false
}

// Whether `ix` is a statement node, not a value-producing expression. A body whose last node
// / `return` argument is a value expression has a value-return position; one ending in a bare
// statement is genuinely void. The redundant-return fixpoint defers only value-return
// functions poisoned by a cycle, so genuine void recursion is never mis-flagged.
function isStmtNode(ix: i32) {
  const nd = P.nodes[ix]
  if nd is LetDecl { return true }
  if nd is IfStmt { return true }
  if nd is WhileStmt { return true }
  if nd is BreakStmt { return true }
  if nd is ContinueStmt { return true }
  if nd is RetStmt { return true }
  if nd is ForRange { return true }
  if nd is ForIn { return true }
  // A body-scoped `type` is a declaration (D1045), so a block ending in one is valueless,
  // exactly as one ending in a `let` is — otherwise the trailing declaration would be read as the block's value.
  if nd is TypeDecl { return true }
  if nd is UnionDecl { return true }
  false
}

function resetReturnPending(name: string) {
  const h = lookup(name)
  if h >= 0 {
    const ht = T.tys[h]
    if ht is TyFunc {
      ht.fnRet = -2
      tyMutEpoch = tyMutEpoch + 1 // return-inference fixpoint reset in place
    }
  }
  0
}

// Demand-infer one top-level function's return, but only if still pending (the
// memoization guard already short-circuits a resolved one; the fixpoint resets to
// pending first to force a fresh re-inference once neighbours have settled).
function preInferOne(dIx: i32) {
  const dn = P.nodes[dIx]
  if dn is FuncDecl {
    const h = lookup(dn.fnName)
    let pending = true
    if h >= 0 {
      const ht = T.tys[h]
      if ht is TyFunc {
        if ht.fnRet != -2 { pending = false }
      }
    }
    if pending { checkFuncDeclNode(dn, dIx) }
  }
  0
}

// The return-inference pre-pass: resolves every un-annotated return with diagnostics, symbol
// recording and the redundant-type stream suppressed, so the real check pass runs against
// final return types. Non-cycle functions resolve in the first demand sweep; cycle-poisoned
// ones iterate to a fixpoint until the tentative set stops shrinking, and what remains is genuinely base-case-less.
function inferReturnsPrePass() {
  if topUnannotFns.length == 0 { return 0 }
  inferQuiet = true
  const savedDiag = T.diags.length
  const savedSym = symEnabled
  const savedRedun = redunName.length
  const savedRcoal = rcoalTok.length
  const savedIsval = isvalTok.length
  symEnabled = 0
  let i = 0
  while i < topUnannotFns.length {
    preInferOne(topUnannotFns[i])
    i = i + 1
  }
  let shrinking = true
  let rounds = 0
  while shrinking && rounds < 2000 {
    rounds = rounds + 1
    const work = inferTentative
    inferTentative = []
    let r = 0
    while r < work.length {
      resetReturnPending(work[r])
      r = r + 1
    }
    let q = 0
    while q < work.length {
      const dIx = fnDeclIx[work[q]] ?? -1
      if dIx >= 0 { preInferOne(dIx) }
      q = q + 1
    }
    if inferTentative.length >= work.length { shrinking = false }
  }
  unresolvedFns = []
  let u = 0
  while u < inferTentative.length {
    unresolvedFns.push(inferTentative[u])
    u = u + 1
  }
  symEnabled = savedSym
  while T.diags.length > savedDiag { T.diags.pop() }
  redunTruncate(savedRedun)
  rcoalTruncate(savedRcoal)
  isvalTruncate(savedIsval)
  inferQuiet = false
  0
}

function redunTruncate(n: i32) {
  while redunSLine.length > n { redunSLine.pop() }
  while redunSCol.length > n { redunSCol.pop() }
  while redunELine.length > n { redunELine.pop() }
  while redunECol.length > n { redunECol.pop() }
  while redunName.length > n { redunName.pop() }
  while redunType.length > n { redunType.pop() }
  while redunTok.length > n { redunTok.pop() }
  0
}

// The uncovered union members of the last non-exhaustive `is`-chain `ifChainExhausts`
// analyzed (rendered, comma-joined), so the diagnostic can name what is missing. "" when the
// chain is exhaustive, or non-exhaustive for a reason other than member coverage (a
// non-coverable arm shape, an uncovered `null` path) — there is no member list to name then.
let chainMissing = ""

// Soundness: does the else-less `is`-chain rooted at `ifIx` cover every variant of `p`'s
// union type? If so, fall-through is unreachable and needs no `else`; if not, a value falls
// off the end. Decided over the discriminated place's declared union members, requiring every
// arm test the same place — any arm that is not a bare `place is T` makes it non-exhaustive, never wrongly exhaustive.
function ifChainExhausts(ifIx: i32) {
  chainMissing = ""
  let havePlace = false
  let placeName = "?"
  const testedTys: i32[] = []
  // `allIsArms` stays true only while every arm seen is a bare `<sameIdent> is T`
  // (the only shape we can prove exhaustive by union-member coverage).
  let allIsArms = true
  let node = P.nodes[ifIx]
  let walking = true
  while walking {
    if node is IfStmt {
      // Classify this arm's condition. Only a single `<ident> is T` (not null)
      // contributes to coverage; anything else makes the chain non-coverable.
      // A parenthesized arm (`else if (p is B)`) classifies like the bare one.
      const condIx = condUnderParens(node.ifCond)
      const cond = P.nodes[condIx]
      if cond is IsExpr {
        if cond.isVariant == "null" {
          allIsArms = false
        } else {
          const obj = P.nodes[cond.isObj]
          if obj is Ident {
            if !havePlace {
              placeName = obj.identName
              havePlace = true
            } else if placeName != obj.identName {
              allIsArms = false
            }
            const tIx = isTypeTyRead(cond.isVariant, condIx)
            if tIx < 0 { allIsArms = false } else { testedTys.push(tIx) }
          } else {
            allIsArms = false
          }
        }
      } else if cond is BinExpr {
        // A literal-equality arm `place == <lit>` discriminates a literal
        // union the same way an `is` arm does (host: literal narrowing via
        // `atomFact` + `subtractType`) — contribute the tested literal type.
        let armLit = -1
        let armObj = -1
        if cond.binOp == "==" {
          armLit = litTyOfExpr(cond.binRight)
          armObj = cond.binLeft
          if armLit < 0 {
            armLit = litTyOfExpr(cond.binLeft)
            armObj = cond.binRight
          }
        }
        if armLit >= 0 {
          const eobj = P.nodes[armObj]
          if eobj is Ident {
            if !havePlace {
              placeName = eobj.identName
              havePlace = true
            } else if placeName != eobj.identName {
              allIsArms = false
            }
            testedTys.push(armLit)
          } else {
            allIsArms = false
          }
        } else {
          allIsArms = false
        }
      } else {
        allIsArms = false
      }
      if node.ifElse < 0 {
        // No `else`: the chain ends here — decide by coverage below.
        walking = false
      } else {
        const nxt = P.nodes[node.ifElse]
        if nxt is IfStmt {
          node = nxt
        } else {
          // A real (block) `else` covers the fall-through outright — exhaustive
          // regardless of the arm shapes.
          return true
        }
      }
    } else {
      return false
    }
  }
  // No `else`. Only a pure `is`-chain over one place can be exhaustive by member
  // coverage; any other shape genuinely falls through.
  if !allIsArms { return false }
  // No place is discriminated (shouldn't happen) — not exhaustive.
  if !havePlace { return false }
  // Uses the pre-subtraction type first (`pgPreIx`): this chain's own post-guard narrowing
  // has already replaced the place's binding with the residue of the arms being counted, so
  // `lookup` alone would report "covered" for every chain whose arms actually diverge. The
  // bank is keyed by this chain's node, so it answers only when this chain did the subtracting; `lookup` is the fallback otherwise.
  let pty = -1
  if pgPreIx == ifIx {
    let pk = 0
    while pk < pgPreKeys.length {
      if pgPreKeys[pk] == placeName { pty = pgPreTys[pk] }
      pk = pk + 1
    }
  }
  if pty < 0 { pty = lookup(placeName) }
  if pty < 0 { return false }
  const pt = T.tys[pty]
  if pt is TyNullable {
    // A nullable place needs an explicit `is null` (or `else`) arm to be covered;
    // an else-less `is`-chain over the inner variants always leaves the null path.
    return false
  }
  if pt is TyUnion {
    // Cover each union member against the tested set; collect the uncovered
    // ones (rendered) so the diagnostic can name exactly what is missing.
    const members = pt.uMembers
    let mi = 0
    let allCovered = true
    while mi < members.length {
      let covered = false
      let ti = 0
      while ti < testedTys.length {
        if assignable(members[mi], testedTys[ti]) { covered = true }
        ti = ti + 1
      }
      if !covered {
        allCovered = false
        if chainMissing != "" { chainMissing = chainMissing + ", " }
        chainMissing = chainMissing + tyToStr(members[mi])
      }
      mi = mi + 1
    }
    return allCovered
  }
  // A non-union place: an `is`-chain over it is degenerate; treat as covered
  // (a single concrete type is "exhausted" by any always-true branch).
  true
}

// Does the block hold a bare `return`, recursing into if/while/for bodies but never into a
// nested function, whose returns are its own? A bare `return` is legal only where nothing is
// owed, so one anywhere in a body is the author writing `: void`; the checker pins the return
// type from it and `computeVoidFns` asks this same predicate for the functype (D1600).
export function blockHasBareReturn(blockIx: i32): boolean {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      const st = P.nodes[stmts[i]]
      if st is RetStmt {
        if st.retArg < 0 { return true }
      } else if st is IfStmt {
        if ifChainHasBareReturn(stmts[i]) { return true }
      } else if st is WhileStmt {
        if blockHasBareReturn(st.whileBody) { return true }
      } else if st is ForRange {
        if blockHasBareReturn(st.frBody) { return true }
      } else if st is ForIn {
        if blockHasBareReturn(st.fiBody) { return true }
      }
      i = i + 1
    }
  }
  false
}

// The `else if` hop of `blockHasBareReturn`: a chain's arms are the same question.
function ifChainHasBareReturn(ifIx: i32): boolean {
  const st = P.nodes[ifIx]
  if st is IfStmt {
    if blockHasBareReturn(st.ifThen) { return true }
    if st.ifElse >= 0 {
      const els = P.nodes[st.ifElse]
      if els is Block {
        if blockHasBareReturn(st.ifElse) { return true }
      } else if els is IfStmt {
        if ifChainHasBareReturn(st.ifElse) { return true }
      }
    }
  }
  false
}

// The un-annotated return, decided after the body is checked and its scope popped: the
// observed returns join into one type, a contextual expected return may adopt it, and the
// hoisted `TyFunc` is patched so existing references see the result. Restores the
// inference accumulators its caller saved, and hands back the return type to finalize.
function finishInferredReturn(
  n: FuncDecl,
  fnIx: i32,
  paramTys: i32[],
  paramUninferable: boolean,
  cbBefore: i32,
  savedObserved: i32,
  savedSawErr: boolean,
  savedValueRet: boolean,
  bodyTotalForRet: boolean,
): i32 {
  let ret = -2
  inferStack.pop()
  let inferred = TY_VOID
  // Set when the object-shaped contextual adoption fires (`objRetWidenAdopt` below):
  // gates the plain-struct canonical record — a lambda whose self-inference already
  // matches its context keeps the established un-pinned route (pinning every
  // plain-struct lambda regresses `.map`-collapse / factory / generic-HOF cases).
  let objRetAdopted = false
  const sawCycle = cycleBreakCount > cbBefore
  if inferObserved >= 0 {
    inferred = inferObserved
  } else if sawCycle && fnSawValueRet {
    // A value return position resolved to `void` only because a recursive-cycle member
    // is still pending: defer, so the binding-group fixpoint re-infers this once the
    // cycle's resolvable members settle. Genuine void recursion has no value return
    // position (`fnSawValueRet` is false), so it is never deferred this way.
    if !listHasStr(inferTentative, n.fnName) { inferTentative.push(n.fnName) }
    inferred = TY_VOID
  } else if inferSawErr {
    // Only err-ish types flowed back: no basis. A param that is itself uninferable
    // already reported the root cause, so suppress the redundant message.
    if !paramUninferable {
      tErr(
        "cannot infer a return type for '" +
          n.fnName +
          "' — annotate a return type",
        n.fnBody,
      )
    }
    inferred = TY_ERR
  }
  // Contextual return adoption: an anonymous lambda whose body infers a narrower numeric
  // than the contextual expected return takes the expected return as its own, so the
  // widening lands at the lambda's return seam (`emitReturnValue`). Numeric widening through
  // function-type variance is rejected instead (`fnSlotAssignable`), since a function value's rep is fixed.
  if n.fnName == "" && inferred >= 0 {
    // A contextual adoption below means the seed changed what this lambda infers, so an
    // annotation that supplied it is load-bearing and cannot be judged redundant by
    // comparing the two (D1442). Snapshot/compare rather than marking each arm, since there are twenty of them and a new one must not have to remember.
    const preAdopt = inferred
    const expRet = cbExpectedRetFor(fnIx)
    if expRet >= 0 {
      if numWidens(inferred, expRet) { inferred = expRet }
      // The f32 dual of the numeric widen: a literal-bodied lambda whose contextual return
      // is f32 infers f64/i32 by default, but the literal re-encodes exactly at f32 — the
      // same grant a direct `const v: f32 = 5.5` binding makes. Adopts f32 so the functype
      // result is f32 and `emitReturnValue` encodes the literal at f32 in the body.
      if inferred != expRet && primNameOf(expRet) == "f32" {
        if isF32AdoptingLitExpr(lambdaBodyTail(n.fnBody)) { inferred = expRet }
      }
      // Object-shaped dual: `() => ({f: 5})` against `() => {f: i64}` — adopt the
      // expected shape when every widening field is a re-encodable literal
      // (`objRetWidenAdopt` also records the field types for the emitter's interner).
      if objRetWidenAdopt(n.fnBody, inferred, expRet) {
        inferred = expRet
        objRetAdopted = true
      }
      // The litunion dual: a bare string-literal body that is a member of the expected
      // literal-union adopts it. Its inferred type is the softened `string`; the direct
      // `const k: K = "b"` binding grants the member flow via `assignableExpr`, but the
      // lambda-return path only had the numeric/object arms until this one.
      if inferred != expRet && tyIsLitUnion(expRet) {
        const luTail = lambdaBodyTail(n.fnBody)
        if luTail >= 0 && assignableExpr(luTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // A nullable-string result: a lambda body inferring a bare `string` member of an
      // expected `string | null` closure result adopts the nullable — its functype result is
      // the string-ref `ref.null` niche, and `emitReturnValue` niches the value exactly as
      // the named-function value spelling lowers. Covers the string/boolean niches only; a nullable numeric scalar boxes through `valueUnionRetName` instead.
      if inferred != expRet {
        const etU = T.tys[expRet]
        if etU is TyNullable {
          // The boolean-niche dual of the string niche: a lambda body inferring a bare
          // `boolean`/`null` member of an expected `boolean | null` adopts the niche — its
          // functype result is the i32 sentinel (2 = null), exactly as the annotated
          // `: boolean | null` return and the named-function value lower.
          if (
            tyIsPrimNamed(etU.nInner, "string") ||
            tyIsPrimNamed(etU.nInner, "boolean")
          ) {
            const nsTail = lambdaBodyTail(n.fnBody)
            if nsTail >= 0 && assignableExpr(nsTail, inferred, expRet) {
              inferred = expRet
            }
          }
          // The nullable-list dual: a lambda body inferring the bare i32-backed list member
          // of an expected `T[] | null` adopts the niche — its functype result is the
          // nullable i32-list wrapper, exactly as the annotated form lowers. Distinct-backing
          // leaves (`i64[] | null`, …) are not adopted and stay loud checker rejects.
          if inferred != expRet && tyIsNulI32BackedListInner(etU.nInner) {
            const nlTail = lambdaBodyTail(n.fnBody)
            if nlTail >= 0 && assignableExpr(nlTail, inferred, expRet) {
              inferred = expRet
            }
          }
          // The nullable-closure dual: a lambda body inferring `null` (or a closure) against
          // an expected nullable-closure result adopts the niche — its functype result is
          // `(ref null $cloStruct)`, and `emitReturnValue`'s `retNulClosure` arm niches a
          // `return null` exactly as the annotated form already lowers.
          const etInnerTy = T.tys[etU.nInner]
          if etInnerTy is TyFunc {
            const ncTail = lambdaBodyTail(n.fnBody)
            if ncTail >= 0 && assignableExpr(ncTail, inferred, expRet) {
              inferred = expRet
            }
          }
          // The nullable-struct dual: a lambda body inferring the bare struct member (or
          // `null`) of an expected `S | null` closure result adopts the nullable — its
          // functype result is the `(ref null $S)` niche, exactly as the annotated
          // named-function value spelling already lowers.
          if etInnerTy is TyObj {
            const nsoTail = lambdaBodyTail(n.fnBody)
            if nsoTail >= 0 && assignableExpr(nsoTail, inferred, expRet) {
              inferred = expRet
            }
          }
          // The nullable-litunion dual: a lambda body inferring a bare `string` member of
          // the expected `K | null` litunion adopts the niche — its functype result is the
          // i32 atom (`-1` = null), and `emitReturnValue`'s `retNulLitUnion` arm encodes it
          // exactly as the annotated `: () => K | null` form already does.
          if tyIsLitUnion(etU.nInner) {
            const nluTail = lambdaBodyTail(n.fnBody)
            if nluTail >= 0 && assignableExpr(nluTail, inferred, expRet) {
              inferred = expRet
            }
          }
        }
      }
      // A value-union result: a lambda body inferring a bare scalar arm of the expected
      // value-union box result adopts the union, so the widening lands at the return seam —
      // `emitReturnValue` boxes the scalar and the functype result is the box itself
      // (`synthRetAnnots` pins `fnRet`). Checked after the niche arms, so a `T | null` niche is never swallowed as a value union.
      if inferred != expRet && valueUnionRetName(expRet) != "" {
        const vuTail = lambdaBodyTail(n.fnBody)
        if vuTail >= 0 && assignableExpr(vuTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The litunion-array dual of the value-union result: a lambda body inferring the bare
      // scalar arm of the expected `litunion-array | scalar` box adopts the union, boxing at
      // the return seam. `valueUnionRetName` declines this union (its render flattens the
      // litunion-array atom), so it needs its own alias-preserving arm.
      if inferred != expRet && litUnionArrayValueUnionRetName(expRet) != "" {
        const laTail = lambdaBodyTail(n.fnBody)
        // Gates on strict `assignable` of the body's inferred type, not the expression-level
        // `assignableExpr` the other arms use: the litunion-array arm reps as the kind-7
        // i32-atom list, but a bare array literal self-infers the softened `string[]`, whose
        // element re-typing would box the wrong tag. Only a body already at the union's own rep is adopted.
        if laTail >= 0 && assignable(inferred, expRet) { inferred = expRet }
      }
      // The closure-arm dual of the value-union result: a lambda body inferring one arm (a
      // closure or a scalar) of the expected closure-arm value union adopts it, boxing at
      // the return seam — a closure member is the kind-11 ref atom riding the box's anyref
      // value, and the functype result is the box (`synthRetAnnots` pins `fnRet`).
      if inferred != expRet && cloArmValueUnionRetName(expRet) != "" {
        const cvTail = lambdaBodyTail(n.fnBody)
        if cvTail >= 0 && assignableExpr(cvTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The map-member-union dual: a lambda body inferring one struct arm of the expected
      // map-member-union box result adopts the union, boxing the struct/map arm into the
      // #865/#868 map-union box at the return seam, exactly as the annotated form exposes
      // this rep already.
      if inferred != expRet && mapUnionRetName(expRet) != "" {
        const muTail = lambdaBodyTail(n.fnBody)
        if muTail >= 0 && assignableExpr(muTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The ref-arm dual: a lambda body inferring one arm (a ref list or a struct) of the
      // expected ref-arm union adopts it, boxing at the return seam so the functype result is
      // the box rather than the raw reflist a narrowed call site would then cast — a
      // guaranteed runtime trap or invalid wasm otherwise. Nominal-gated (`refArmUnionRetName` declines an anonymous-element array arm), so those shapes stay loud.
      if inferred != expRet && refArmUnionRetName(expRet, gRootStmts) != "" {
        const raTail = lambdaBodyTail(n.fnBody)
        if raTail >= 0 && assignableExpr(raTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The variant-box dual with an inline-struct arm: a lambda body inferring one arm of
      // the expected union adopts the whole union, boxing at the return seam so the
      // functype result is the box, matching the value call's `annSigKey`. Checked after
      // `refArmUnionRetName`, whose ref-array arms carry a slot render this arm declines.
      if inferred != expRet && variantBoxUnionRetName(expRet) != "" {
        const vbTail = lambdaBodyTail(n.fnBody)
        if vbTail >= 0 && assignableExpr(vbTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-nullable-list result: a lambda body array literal assignable to the
      // expected value-union-box list adopts it, so `emitReturnValue` seeds each nullable
      // element through the same rep the annotated `(f64|null)[]` form already lowers
      // (`synthRetAnnots` pins `fnRet`).
      if inferred != expRet && nulElemListRetName(expRet) != "" {
        const elTail = lambdaBodyTail(n.fnBody)
        if elTail >= 0 && assignableExpr(elTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-nullable-struct-list dual: a lambda body array literal (non-null
      // structs, or `null`) assignable to the expected nullable-struct-element list adopts
      // it, building each element through the kind-1 struct niche the annotated form already
      // lowers. Un-pinned, the body's structs would self-classify onto a different reflist slot than the annotation side.
      if inferred != expRet && nulStructElemListRetName(expRet) != "" {
        const nseTail = lambdaBodyTail(n.fnBody)
        if nseTail >= 0 && assignableExpr(nseTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-nullable-map-list dual: a lambda body array literal (non-null maps, or
      // `null`) assignable to the expected nullable-map-element list adopts it, building each
      // element through the kind-3 map niche the annotated form already lowers. Un-pinned,
      // the body's maps would self-classify onto a different reflist slot than the annotation side.
      if inferred != expRet && nulMapElemListRetName(expRet) != "" {
        const nmeTail = lambdaBodyTail(n.fnBody)
        if nmeTail >= 0 && assignableExpr(nmeTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-nullable-scalar-list dual: a lambda body array literal (non-null inner
      // lists, or `null`) assignable to the expected nullable-list-element list adopts it,
      // building each element through the nullable inner-wrapper niche the annotated form
      // already lowers. Un-pinned, the body's lists would self-classify onto a different reflist slot than the annotation side.
      if inferred != expRet && nulListElemListRetName(expRet) != "" {
        const nleTail = lambdaBodyTail(n.fnBody)
        if nleTail >= 0 && assignableExpr(nleTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-value-union-list dual: a lambda body array literal assignable to the
      // expected value-union-box list adopts it, boxing each element through the same
      // element-kind-2 rep the annotated form already lowers.
      if inferred != expRet && elemValueUnionListRetName(expRet) != "" {
        const evTail = lambdaBodyTail(n.fnBody)
        if evTail >= 0 && assignableExpr(evTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-variant-box-union-list dual: a lambda body array literal assignable to
      // the expected variant-box-element list adopts it, boxing each element through the
      // same element-kind-2 rep the annotated named-function value form already lowers.
      if inferred != expRet && elemVariantBoxListRetName(expRet) != "" {
        const vbeTail = lambdaBodyTail(n.fnBody)
        if vbeTail >= 0 && assignableExpr(vbeTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-map-union-list dual: a lambda body array literal assignable to the
      // expected map-union-element list adopts it, boxing each element through the same
      // element-kind-2 map-union box rep the annotated form already lowers. Un-pinned, the
      // body's array would self-classify onto a different reflist slot than the annotation side.
      if inferred != expRet && elemMapUnionListRetName(expRet) != "" {
        const meTail = lambdaBodyTail(n.fnBody)
        if meTail >= 0 && assignableExpr(meTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The element-refarm-value-union-list dual: a lambda body array literal assignable to
      // the expected list of (union-element-array | scalar) boxes adopts it, boxing each
      // element through the same element-kind-2 box the annotated form already lowers.
      // Un-pinned, the body's array would key onto a different `$fnsig` slot than the annotation side.
      if inferred != expRet && elemRefArmValueUnionListRetName(expRet) != "" {
        const raeTail = lambdaBodyTail(n.fnBody)
        if raeTail >= 0 && assignableExpr(raeTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The nested (2-D+) union-element array dual: a lambda body nested array literal
      // assignable to the expected 2-D+ box-element list adopts it, building the nested
      // lists through the same element-kind-2 box the annotated form already lowers
      // (`synthRetAnnots` pins `fnRet` off this producer's rung, `IR_RUNG_NESTED_ELEM_UNION_LIST`).
      if inferred != expRet && nestedElemUnionListRetName(expRet) != "" {
        const nueTail = lambdaBodyTail(n.fnBody)
        if nueTail >= 0 && assignableExpr(nueTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The union-field-struct-element-list dual: a lambda body array literal assignable to
      // the expected list of boxed-field structs adopts it, building each element's boxed
      // field slot exactly as the annotated form lowers (`synthRetAnnots` pins `fnRet` via
      // `nameIsStructWithUnionField`).
      if inferred != expRet && structFieldBoxElemListRetName(expRet) != "" {
        const sfeTail = lambdaBodyTail(n.fnBody)
        if sfeTail >= 0 && assignableExpr(sfeTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The nullable-closure-element-list dual: a lambda body array literal assignable to
      // the expected kind-5 niche list adopts it, seeding each element (a `null` to
      // `ref.null $cloStruct`) through the same rep the annotated form already lowers.
      if inferred != expRet && nulClosureElemListRetName(expRet) != "" {
        const nceTail = lambdaBodyTail(n.fnBody)
        if nceTail >= 0 && assignableExpr(nceTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The nested-list result: a lambda body array literal assignable to the expected
      // nested scalar-leaf array adopts it, building under the pinned return's threading
      // (`synthRetAnnots` pins `fnRet`); the `$fnsig` result keys the reflist slot on both
      // producers, unlike the 1-D scalar-list arm below (R4).
      if inferred != expRet && nestedLeafListRetName(expRet) != "" {
        const nlTail = lambdaBodyTail(n.fnBody)
        if nlTail >= 0 && assignableExpr(nlTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The scalar-leaf-list result: a lambda body array literal assignable to the expected
      // distinct-backing scalar-leaf list adopts it — elements re-encode at the leaf
      // (`assignableExpr`'s `ArrayLit` arm, the grant a direct `const xs: f32[] = [1.5]`
      // binding makes), and `synthRetAnnots` pins `fnRet` to the adopted name (`isScalarListRetName`).
      if inferred != expRet && scalarLeafListRetName(expRet) != "" {
        const slTail = lambdaBodyTail(n.fnBody)
        if slTail >= 0 && assignableExpr(slTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The litunion-element-list result: a lambda body array literal whose elements are
      // members of the expected litunion-element list adopts it — `assignableExpr`'s
      // `ArrayLit` arm records the destination array type, so the body builds the i32 atom
      // list; the `>a` result token already byte-matches the annotation side, so no pin is needed.
      if inferred != expRet && litUnionElemListRetName(expRet) != "" {
        const lulTail = lambdaBodyTail(n.fnBody)
        if lulTail >= 0 && assignableExpr(lulTail, inferred, expRet) {
          inferred = expRet
        }
      }
      // The struct-element-list result: a lambda body array literal's element structs
      // coerce field-wise into the expected shape and adopt it — `assignableExpr`'s
      // per-element `ObjLit` coercion records the coerced field types for the emitter's
      // interner. Gated on plainly-lowerable element fields, so a map/union/nullable field stays a loud reject.
      if inferred != expRet && structElemListRetName(expRet) != "" {
        const seTail = lambdaBodyTail(n.fnBody)
        if seTail >= 0 && assignableExpr(seTail, inferred, expRet) {
          inferred = expRet
          objRetAdopted = true
        }
      }
      // The loud floor, last rung of this ladder: an empty-`[]` result no arm above adopted
      // is the absence of a rep, not a narrower version of one — leaving `fnRet` a hole would
      // cast-trap the value call or disagree with the body's list at emit. Exempt only the
      // i32-backed elements (`i32`/`boolean`), which share the one i32-list backing with the annotation and so are already correct un-adopted.
      if inferred != expRet && unresolvedHole(inferred) {
        const ehT = T.tys[expRet]
        if ehT is TyArray {
          if (
            !tyIsPrimNamed(ehT.aElem, "i32") &&
            !tyIsPrimNamed(ehT.aElem, "boolean")
          ) {
            tErrUnsupported(
              "a lambda returning an empty `[]` cannot build the " +
                tyToStr(expRet) +
                " result its annotation asks for — type-valid, but the element type has no" +
                " rep to build from; return the literal from a named function" +
                " (`function f(): " +
                tyToStr(expRet) +
                " { return [] }`), which lowers this",
              n.fnBody,
            )
          }
        }
      }
    }
    if inferred != preAdopt { cbSeedUsed = cbSeedUsed + 1 }
  }
  // Permissive fall-through (totality): an un-annotated function that can fall off the end
  // implicitly yields `null` there, so its inferred return widens to `T | null`. A box-able
  // value type lowers un-annotated via the `uBoxIdx` box; a niche (`boolean`/`string`) widens
  // too but stays floored below until A20 carries the niche seed. A void/error return is exempt.
  if (
    !bodyTotalForRet &&
    inferred >= 0 &&
    !isVoidTy(inferred) &&
    inferred != TY_ERR
  ) {
    const inT = T.tys[inferred]
    if !(inT is TyNullable) { inferred = mkNullableTy(inferred) }
  }
  // Robustness floor: an un-annotated function whose returns join to a union/nullable now
  // infers the correct type, but must still be annotated when the emitter cannot yet lower
  // it un-annotated — a value union/nullable already lowers via the `uBoxIdx` box and does
  // not floor; a deferred join (a per-call-site placeholder) is not a shape to floor either, since it collapses to one arm at each call site.
  if (
    !inferQuiet &&
    n.fnName != "" &&
    inferred >= 0 &&
    !tyIsDeferredJoin(inferred) &&
    valueUnionRetName(inferred) == ""
  ) {
    const itt = T.tys[inferred]
    // A variant-box union (`{w: i32} | i32`, and its nullable form) lowers un-annotated: the
    // A20 loop records `variantBoxUnionRetName` and the emitter boxes it exactly like the
    // annotated spelling. Checked before the `TyUnion`/`TyNullable` arms below (it spans
    // both), so the floor accepts exactly the box the emitter registers.
    if litUnionAliasNameOfTy(inferred) != "" {
      // A pure literal union with a declared alias (`type K = "a" | "b"`) lowers
      // un-annotated as the interned i32 atom: the A20 loop records the alias name and the
      // emitter's return classification reads the same rep the annotated `: K` spelling
      // reaches. An inline litunion (no alias to record) still floors below.
    } else if variantBoxUnionRetName(inferred) != "" {
      // lowers un-annotated — no floor
    } else if tyIsLitUnion(inferred) {
      // A pure un-named literal union lowers un-annotated as a string ref, the same rep its
      // annotated twin carries — `collectF` records `retPrim = "string"` for this shape and
      // the return site widens an atom-repped value into it. The alias form above reps as
      // the atom instead, so the two never collide.
    } else if numLitUnionHasBase(inferred) {
      // A numeric literal union has no union rep at all: every member softens to one base
      // scalar, so the recorder banks the base (`numLitUnionBaseTy`, the same rule
      // `softenLitTy` states everywhere) and this arm accepts exactly what it banks. The
      // string litunion two arms up is the shape that keeps an identity (the interned atom), which is why it is a separate question.
    } else if itt is TyUnion {
      // A pure struct-union whose every member maps to a named type lowers un-annotated via
      // the variant-boxed rep, exactly like the annotated form — so it does not floor. The
      // export uses the same `structUnionRetName` predicate, so the floor accepts exactly
      // what the emitter can register.
      if structUnionRetName(inferred, gRootStmts) == "" {
        tErrUnsupported(
          "'" +
            n.fnName +
            "' infers the union return type " +
            tyToStr(inferred) +
            " — type-valid, but an inferred return of this shape is not yet supported by codegen; annotate the return type",
          n.fnBody,
        )
      }
    } else if itt is TyNullable {
      // The niche nullables (`boolean | null` / `string | null` / `K | null`), a nullable
      // struct, a nullable list at every element type, and a never-filled infer-null hole
      // (`nInner < 0`, whose only value is `null`) all lower un-annotated — each named by its
      // own recorder for the emitter to seed from — so none of them floor (D1576).
      if (
        itt.nInner >= 0 &&
        !tyIsPrimNamed(itt.nInner, "boolean") &&
        !tyIsPrimNamed(itt.nInner, "string") &&
        litUnionAliasNameOfTy(itt.nInner) == "" &&
        nullableRetName(inferred, gRootStmts) == "" &&
        nulListRetName(inferred) == ""
      ) {
        tErrUnsupported(
          "'" +
            n.fnName +
            "' infers the nullable return type " +
            tyToStr(inferred) +
            " — type-valid, but an inferred return of this shape is not yet supported by codegen; annotate the return type",
          n.fnBody,
        )
      }
    }
  }
  ret = inferred
  // Patches the hoisted `TyFunc` in place so existing references see the result; a nested
  // (un-hoisted) named function declares fresh, and an anonymous lambda just carries its
  // type as the expression value. The parameter-solve probe observes this body and must not
  // decide the return, so patching here would deny pass 1.7 a fresh re-derivation.
  if n.fnName != "" && !paramSolveProbe {
    const bound = lookup(n.fnName)
    let patched = false
    if bound >= 0 {
      const bt = T.tys[bound]
      if bt is TyFunc {
        bt.fnRet = inferred
        tyMutEpoch = tyMutEpoch + 1 // inferred return patched in place
        patched = true
      }
    }
    if !patched { declare(n.fnName, mkFuncTy(paramTys, inferred)) }
    // Re-retains the symbol-table type with the inferred return: the entry stamped while
    // checking the signature carried the `-2` infer-later sentinel, and the in-place patch
    // above only touches the scope-bound copy. Without this, hover / inlay on an
    // unannotated function renders `-> _`.
    if symEnabled != 0 { symRetainType(fnIx, mkFuncTy(paramTys, inferred), 2) }
  } else if !inferQuiet {
    // An anonymous lambda is lifted to a top-level function under a synthesized
    // `__lambda_N` name the checker never saw, so the name-keyed inferred-return table
    // can't reach it. Records the inferred scalar/string/list return under a node-index
    // sentinel key (`#<nodeIx>`) instead, read back by `inferRetNameByNode`.
    const anm = tyToStructStr(inferred)
    // A struct-with-boxed-field contextual return the checker adopted at the lambda
    // boundary (`objRetWidenAdopt`'s boxing-widen arm), recorded under the canonical emit
    // name (not the spaced `tyToStr` render) so `synthRetAnnots`'s pin and
    // `internShapeDeep`'s intern resolve. Takes precedence over `recordable`.
    const sfbNm = structFieldBoxRetName(inferred)
    // A map-carrying struct return, recorded under the canonical emit name too — the spaced
    // `recordable` render never pins, and an un-pinned body literal's nested map field would
    // otherwise resolve by field-name set and mint a wrong-layout twin. Checked after `sfbNm` (a boxed-field struct keeps its established pin).
    let smfNm = ""
    if sfbNm == "" { smfNm = structMapFieldRetName(inferred) }
    // A plain struct return, recorded canonically too: the spaced `recordable` render never
    // pins, and an un-pinned lambda's body literal fieldset-matches — a same-fieldset twin
    // row in scope can resolve the wrong row otherwise. Composite fields (map/union/closure/list) keep their own recorder arms below.
    let spfNm = ""
    if sfbNm == "" && smfNm == "" && objRetAdopted {
      spfNm = structPlainRetName(inferred)
    }
    // A single struct-shape inferred return is recorded too — a lambda that collapses to
    // one union variant types as that variant's shape, so the emitter resolves it to the
    // concrete variant rather than the box. The gates run only when all three canonical
    // recorders declined, each at most once, in source order — `recordable` is bit-identical to the disjunction it replaces.
    let recCode = IR_RUNG_NONE
    if sfbNm == "" && smfNm == "" && spfNm == "" {
      if isClassifiableRetName(anm) { recCode = IR_REC_CLASSIFIABLE }
      else if isObjShapeName(anm) { recCode = IR_REC_OBJ_SHAPE }
      else if isScalarListRetName(anm) { recCode = IR_REC_SCALAR_LIST }
    }
    const recordable = recCode != IR_RUNG_NONE
    // A union inferred/contextual return exports its emitter-format name (value-union or
    // struct-union) under the same node sentinel, mirroring the named-function A20 loop —
    // the contextual return the checker proved for the lambda at its own boundary, pinned
    // position-independently (`synthRetAnnots`) rather than re-derived per boundary.
    let unm = ""
    // Not the only writer since the r8 split: `nulElemListRetName` sets the rung itself, and
    // the contextual-adoption gate above calls that producer too, so a write can land before
    // this reset — safe since the reset is unconditional and precedes the cascade. The
    // global's lifetime is exactly one cascade run: cleared here, written once, read once.
    inferRetNameRung = IR_RUNG_NONE
    if !recordable {
      unm = irRung(IR_RUNG_SFB, sfbNm)
      if unm == "" { unm = irRung(IR_RUNG_STRUCT_MAP_FIELD, smfNm) }
      if unm == "" { unm = irRung(IR_RUNG_STRUCT_PLAIN, spfNm) }
      if unm == "" {
        unm = irRung(IR_RUNG_VALUE_UNION, valueUnionRetName(inferred))
      }
      // The litunion-array value-union dual (adopted above): records its alias-preserving
      // emit name so `collectU` registers the union and `synthRetAnnots`'s `isValueUnionName`
      // arm pins `fnRet` to it, keying the `$fnsig` result `>u` to match the value call.
      if unm == "" {
        unm = irRung(
          IR_RUNG_LITUNION_ARR_VU,
          litUnionArrayValueUnionRetName(inferred),
        )
      }
      if unm == "" {
        unm = irRung(
          IR_RUNG_STRUCT_UNION,
          structUnionRetName(inferred, gRootStmts),
        )
      }
      // A NULLABLE-ref contextual return (`P | null`, `string | null`) — recorded under the same
      // node sentinel so `synthRetAnnots` pins a nullable-returning closure value position-
      // independently (the nullable dual of the union pin).
      if unm == "" {
        unm = irRung(IR_RUNG_NULLABLE, nullableRetName(inferred, gRootStmts))
      }
      // The nullable-litunion contextual return (adopted above): records the alias name so
      // `synthRetAnnots` pins the lambda's `fnRet` as the nullable litunion (an i32 atom with
      // `-1` = null), whose member-encoding `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(IR_RUNG_NUL_LITUNION, nulLitUnionRetName(inferred))
      }
      // The element-nullable-list contextual return (adopted above): records its emitter
      // name so `synthRetAnnots` pins the lambda's `fnRet` as the value-union-box list, whose
      // `[null]` element seeding `emitReturnValue` already performs for the annotated form.
      if unm == "" { unm = nulElemListRetName(inferred) }
      // The element-nullable-struct-list contextual return (adopted above): records its
      // canonical emit name so `synthRetAnnots` pins `fnRet` as the nullable-struct-element
      // list, whose kind-1 struct-niche element seeding `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(
          IR_RUNG_NUL_STRUCT_ELEM_LIST,
          nulStructElemListRetName(inferred),
        )
      }
      // The element-nullable-map-list contextual return (adopted above): records its
      // canonical emit name so `synthRetAnnots` pins `fnRet` as the nullable-map-element
      // list, whose kind-3 map-niche element seeding `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(IR_RUNG_NUL_MAP_ELEM_LIST, nulMapElemListRetName(inferred))
      }
      // The element-nullable-scalar-list contextual return (adopted above): records its
      // canonical emit name so `synthRetAnnots` pins `fnRet` as the nullable-list-element
      // list, whose inner-wrapper element seeding `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(
          IR_RUNG_NUL_LIST_ELEM_LIST,
          nulListElemListRetName(inferred),
        )
      }
      // The element-value-union-list contextual return (adopted above): records its emitter
      // name so `synthRetAnnots` pins `fnRet` as the value-union-box list, whose element
      // boxing `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(IR_RUNG_ELEM_VU_LIST, elemValueUnionListRetName(inferred))
      }
      // The element-variant-box-union-list contextual return (adopted above): records its
      // emitter name so `synthRetAnnots` pins `fnRet` as the variant-box-element list, whose
      // element boxing `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(
          IR_RUNG_ELEM_VARIANT_BOX_LIST,
          elemVariantBoxListRetName(inferred),
        )
      }
      // The element-map-union-list contextual return (adopted above): records its emitter
      // name so `synthRetAnnots` pins `fnRet` as the map-union-box element list, whose
      // element boxing `emitReturnValue` already performs.
      if unm == "" {
        unm = irRung(
          IR_RUNG_ELEM_MAP_UNION_LIST,
          elemMapUnionListRetName(inferred),
        )
      }
      // The element-refarm-value-union-list contextual return (adopted above): records its
      // emitter name so `synthRetAnnots` pins `fnRet` as the box-list, whose element boxing
      // `emitReturnValue` already performs for the annotated form.
      if unm == "" {
        unm = irRung(
          IR_RUNG_ELEM_REFARM_VU_LIST,
          elemRefArmValueUnionListRetName(inferred),
        )
      }
      // The nested (2-D+) union-element array contextual return (adopted above): records its
      // emitter name so `synthRetAnnots` pins `fnRet` as the nested box-element array, whose
      // return-position threading + `$fnsig` reflist-slot keying already performs.
      if unm == "" {
        unm = irRung(
          IR_RUNG_NESTED_ELEM_UNION_LIST,
          nestedElemUnionListRetName(inferred),
        )
      }
      // The union-field-struct-element-list contextual return (adopted above): records its
      // emitter name so `synthRetAnnots` pins `fnRet` as the boxed-field-element list, whose
      // element boxing the annotated spelling already performs.
      if unm == "" {
        unm = irRung(
          IR_RUNG_STRUCT_FIELD_BOX_ELEM_LIST,
          structFieldBoxElemListRetName(inferred),
        )
      }
      // The plain-struct-element-list return: records its canonical name so
      // `synthRetAnnots` pins the lambda and the element literals build under the annotated
      // threading instead of fieldset-matching a wrong same-fieldset twin. Adoption-gated
      // like the plain-struct record above, since un-gating regressed the closure-value ref-list ABI suite.
      if unm == "" && objRetAdopted {
        unm = irRung(IR_RUNG_STRUCT_ELEM_LIST, structElemListRetName(inferred))
      }

      // The nullable-closure-element-list contextual return (adopted above): records its
      // emitter name so `synthRetAnnots` pins `fnRet` (`parenUnionArrElemName`), whose kind-5
      // ref-list slot and `[null]` seeding `emitReturnValue` already threads.
      if unm == "" {
        unm = irRung(
          IR_RUNG_NUL_CLOSURE_ELEM_LIST,
          nulClosureElemListRetName(inferred),
        )
      }
      // The closure-arm value-union contextual return (adopted above): records its emitter
      // name so `collectU` registers the union and `synthRetAnnots` pins `fnRet` to it; the
      // `$fnsig` result then keys `>u`, matching the value call.
      if unm == "" {
        unm = irRung(IR_RUNG_CLO_ARM_VU, cloArmValueUnionRetName(inferred))
      }
      // The map-member-union contextual return (adopted above): records its emitter name so
      // `synthRetAnnots` pins `fnRet` as the map-union box (#865/#868), whose arm boxing
      // `emitReturnValue` already performs for the annotated form.
      if unm == "" {
        unm = irRung(IR_RUNG_MAP_UNION, mapUnionRetName(inferred))
      }
      // The ref-arm value-union contextual return (adopted above; repOf item (d)): records
      // its nominal render so `collectU` registers the union and `synthRetAnnots`'s `isUName`
      // arm pins `fnRet` to the same spelling the emitter's binding resolution uses.
      if unm == "" {
        unm = irRung(
          IR_RUNG_REFARM_UNION,
          refArmUnionRetName(inferred, gRootStmts),
        )
      }
      // The variant-box union contextual return with an inline-struct arm (adopted above):
      // records its emitter name so `collectU` registers the union and `synthRetAnnots`'s
      // `isUName` arm pins `fnRet` to it; the `$fnsig` result keys `>u`.
      if unm == "" {
        unm = irRung(IR_RUNG_VARIANT_BOX, variantBoxUnionRetName(inferred))
      }
      // The nested-list contextual return (adopted above): records its emitter name so
      // `synthRetAnnots` pins `fnRet` as the nested array, whose return-position threading
      // and `$fnsig` reflist-slot keying already performs (R4).
      if unm == "" {
        unm = irRung(IR_RUNG_NESTED_LEAF_LIST, nestedLeafListRetName(inferred))
      }
      // The map-element-list contextual return: records its emitter name so
      // `synthRetAnnots` pins `fnRet` as the map-element array, whose kind-3 slot keying the
      // annotated named-function form already performs.
      if unm == "" {
        unm = irRung(IR_RUNG_MAP_ELEM_LIST, mapElemListRetName(inferred))
      }
      // The litunion-alias-element-list contextual return (adopted above): records the
      // name so `synthRetAnnots` pins `fnRet` and the body member literals build the i32
      // atom list the annotated return does.
      if unm == "" {
        unm = irRung(
          IR_RUNG_LITUNION_ELEM_LIST,
          litUnionElemListRetName(inferred),
        )
      }
      // The literal-union contextual return (adopted above): records the alias name so
      // `synthRetAnnots` pins `fnRet` as the litunion, whose functype result reps as an i32
      // atom — the `$fnsig` result keys `>i` and `emitReturnValue` encodes the member literal
      // as its atom id (`retLitUnion`, #1115).
      if unm == "" {
        unm = irRung(
          IR_RUNG_LITUNION_ALIAS,
          irAtoms(litUnionAliasNameOfTy(inferred), 1),
        )
      }
    }
    // The width of the name this ladder settled on, handed over by the producer that
    // joined it rather than re-derived by splitting it (#1115). The rungs short-circuit, so
    // the last producer to answer non-empty is the one that wrote `inferRetNameAtoms`. The
    // `recordable` name is not a producer's join: its three gates admit only one-atom spellings.
    let rAtoms = 1
    if !recordable { rAtoms = inferRetNameAtoms }
    // The rung, on the identical footing as the width above: read from the cascade only on
    // the path that ran it. A `recordable` row cannot carry a producer rung — it never runs
    // the cascade — but it carries the gate code that admitted it instead, which the arm-9
    // conversion reads; gate codes never write to `inferRetNameRung`, so they cannot leak.
    let rRung = recCode
    if !recordable { rRung = inferRetNameRung }
    // A deferred join is a per-call-site placeholder, not a shape the emitter can
    // classify a return by — see the named-function twin in `elaborateInferRets`.
    if recordable || unm != "" {
      if !tyIsDeferredJoin(inferred) {
        const nodeKey = "#" + i32ToStr(fnIx)
        if inferRetNameOf(nodeKey) == "" {
          let rty = unm
          if recordable { rty = anm }
          recordInferRet(nodeKey, rty, inferred, rAtoms, rRung)
        }
      }
    }
  }
  inferObserved = savedObserved
  inferSawErr = savedSawErr
  fnSawValueRet = savedValueRet
  ret
}

// A function declaration: resolves param/return annotations, binds the signature, and checks
// the body in a fresh scope. An un-annotated return is inferred from the body's returns and
// trailing expression (`noteInferredRet`, under a `-2` pending `curRet`), then patched into
// the hoisted `TyFunc` in place so every caller sees it. A base-case-less cycle has nothing to latch onto and reports "cannot infer a return type".
function checkFuncDeclNode(n: FuncDecl, fnIx: i32) {
  // A `function` (top-level OR nested) whose name the emitter dispatches on inline is a
  // definition that can never run — reject it at the definition, not at the call site
  // that silently means something else. Anchored on the decl node, so the pass-1 hoist
  // and this pass report the SAME (message, anchor) pair and `tErrCoded` dedups them.
  checkNotEmitterIntrinsic(n.fnName, fnIx)
  checkNotNestedBinOpDecl(n.fnName, fnIx)
  // Binds the name to this declaration node in the enclosing scope (the body's own scope is
  // pushed further down), so a call inside that scope can recover the parameter list and its
  // defaults. A top-level function is already recorded by the pass-1 hoist under the same
  // name; a nested one has no hoist and is recorded here, which is also the point it becomes callable.
  if n.fnName != "" { declareFnDeclNode(n.fnName, fnIx) }
  let inferring = n.fnRet < 0
  // Void-context lambda adoption: an un-annotated lambda literal whose contextual expected
  // return is `void` is checked as if annotated `: void` rather than inferred, so an explicit
  // `return expr` fails the same anchored mismatch a named `: void` spelling produces, and a
  // value-bearing tail is silently discarded by the emitter. Keyed on the context's expected return, never on the tail's own shape.
  if inferring && n.fnName == "" {
    if isVoidTy(cbExpectedRetFor(fnIx)) {
      inferring = false
      noteVoidCtxLambda(fnIx)
    }
  }
  // The same flip for the same reason: a bare `return` writes `: void`, so stop inferring and
  // take the `!inferring` ladder's `TY_VOID` default, which already discards a valued tail.
  let bareRetVoid = false
  if inferring {
    if blockHasBareReturn(n.fnBody) {
      inferring = false
      bareRetVoid = true
    }
  }
  // The infer-stack key: a named function uses its name (so self-recursion is detected); an
  // anonymous lambda has no name and keys by node index instead — else two nested anonymous
  // lambdas would both key on "" and the inner would falsely trip the recursive-cycle guard, mis-inferring its return as `void`.
  let inferKey = n.fnName
  if inferKey == "" { inferKey = "#L" + i32ToStr(fnIx) }
  // Already inferred on demand (a forward call checked this body before pass 2
  // reached it)? Skip the re-check so diagnostics aren't duplicated.
  if inferring {
    // Recursive cycle: this function is already on the inference stack. Break with a
    // provisional `void` (the binding-group fixpoint re-infers it once the cycle's
    // resolvable members settle), and COUNT the break so the completion below knows
    // the result is tentative rather than final.
    if onInferStack(inferKey) {
      cycleBreakCount = cycleBreakCount + 1
      return TY_VOID
    }
    if inferQuiet && !paramSolveProbe {
      // Suppressed pre-pass: memoize a resolved return (a `-2` reset by the fixpoint
      // forces a fresh re-inference). The PARAMETER-solve probe never takes the memo:
      // it needs the body walked for the flow constraints, not the return.
      const hoisted = lookup(n.fnName)
      if hoisted >= 0 {
        if (fnDeclIx[n.fnName] ?? -1) >= 0 {
          const ht = T.tys[hoisted]
          if ht is TyFunc {
            if ht.fnRet != -2 { return TY_VOID }
          }
        }
      }
    } else {
      // Real check pass: returns are already resolved by the pre-pass, so skip only a
      // top-level body already diagnostic-checked (a forward call reached it before pass 2
      // did). Gated on `fnIx` matching the registered top-level decl, so a nested function
      // sharing a name (e.g. two `add` closures) is never skipped.
      if (fnDeclIx[n.fnName] ?? -1) == fnIx {
        if bodyChecked[n.fnName] ?? false { return TY_VOID }
      }
    }
  }
  // Solves this declaration's un-annotated parameters from its body usage. A no-op for a
  // top-level function (already done in pass 1.6) and inside a probe; this reach is the
  // nested `function` and the value-bound lambda, whose first observer is this call. A
  // parameter the receiver already pinned contextually is not a hole here, so `cbExpect` below still wins — one answer, not two.
  solveUnannotParams(fnIx)
  const params = n.fnParams
  // The contextual expected param types recorded for THIS lambda node (`seedExpected` at a
  // call arg, a `.map`/`.filter` receiver, or an annotated let/return/field/element). Keyed by
  // node index, so a composite's many lambdas each read their own — no single-shot leak.
  const cbExpect = cbExpectedFor(fnIx)
  const cbExpectUsable = cbExpect.length == params.length
  const paramTys: i32[] = []
  // Parallel to `paramTys`: did THIS parameter's annotation collapse a subsumed literal
  // arm (D1048's second hint)? Recorded here, where the annotation resolves, and read in
  // the declare loop below, which is where the binding — and so the scope depth the mark
  // is keyed by — comes into existence.
  const paramCollapsed: boolean[] = []
  let paramUninferable = false
  let pi = 0
  while pi < params.length {
    const pNode = P.nodes[params[pi]]
    let pt = TY_ERR
    let ptCollapsed = false
    if pNode is Param {
      if pNode.parType >= 0 {
        const ptn = P.nodes[pNode.parType]
        if ptn is TypeRef {
          pt = resolveAnnotAt(ptn.tyName, n.fnTyParams, pNode.parType)
          if pt >= 0 && pt == collapsedTy { ptCollapsed = true }
          if pt < 0 {
            tErr(unknownTyText(ptn.tyName), pNode.parType)
            pt = TY_ERR
          }
          // Records the resolved type on the param's type-annotation node too (not just the
          // param node), so the emitter can classify a param annotation structurally from the
          // `Ty` arena instead of re-parsing its synthetic name (`tyNameOf`) — C1.
          if !inferQuiet && pt >= 0 {
            if pNode.parType < nodeTyIx.length { nodeTyIx[pNode.parType] = pt }
          }
        }
      } else if cbExpectUsable && cbExpect[pi] >= 0 {
        // Contextual inference: the expected callback type pins this un-annotated param
        // (`xs.map(function(n) …)` over `i32[]` ⇒ `n: i32`). The seed is the only source of
        // this param's type, so an annotation that supplied it is load-bearing — count it
        // (D1442), or `recordRedundantAnnot` calls it redundant and `--fix` deletes it.
        pt = cbExpect[pi]
        cbSeedUsed = cbSeedUsed + 1
      } else if n.fnName != "" {
        // A named function's un-annotated parameter is a fresh inference hole — a synthetic
        // `TyVar` per param, named by declaration and position so the hoisted signature and
        // the body bind the same hole. Each call site pins it independently, and the emitter
        // monomorphizes one instance per shape; the body sees it as opaque unless its own usage pinned it (`unannotParamTy`).
        pt = unannotParamTy(paramHoleName(n.fnName, fnIx, pi))
      } else if isValBindLambda(fnIx) {
        // A lambda bound to an UN-annotated `const`/`let` (`const add = (a, b) => a + b`): its
        // un-annotated param is a fresh inference HOLE, exactly like a named function's — the
        // emitter value-flow-monomorphizes one instance per call shape (env and all). Keyed by NODE
        // index (the lambda is anonymous), the dual of the named branch above.
        pt = unannotParamTy(paramHoleName("", fnIx, pi))
      } else {
        // An ANONYMOUS literal with no annotation and no contextual type is genuinely uninferable —
        // its value-typed binding demands a concrete signature NOW (host parity).
        tErr(
          "cannot infer a type for parameter `" + pNode.parName + "`",
          params[pi],
        )
        // The body can't be typed once a param is unknown — don't also cascade a "cannot infer a
        // return type" from the resulting error-only return.
        paramUninferable = true
      }
    }
    // Records the param node's resolved type so the emitter can recover a
    // contextually-inferred callback param's type (`xs.map((x) => …)` over `f64[]` ⇒ x: f64)
    // and synthesize its annotation, instead of defaulting an un-annotated param to i32.
    // Gated on the real pass; a generic hole stays a `TyVar` and is excluded by the emitter's reader (`nodeTyName`).
    if !inferQuiet && pt >= 0 {
      if params[pi] < nodeTyIx.length { nodeTyIx[params[pi]] = pt }
    }
    paramTys.push(pt)
    paramCollapsed.push(ptCollapsed)
    pi = pi + 1
  }
  // Parameter DEFAULTS (`a: i32 = 0`, and the `a?: T` spelling the parser
  // desugars into one), checked once the annotations have resolved.
  checkParamDefaults(n, params, paramTys)
  // Resolve the return-type annotation (or the pending sentinel when inferring).
  let ret = -2
  if !inferring {
    ret = TY_VOID
    // A VOID-adopted lambda has NO annotation node (`n.fnRet` is -1) — the guard
    // leaves `ret` at the `TY_VOID` default, which IS its adopted return.
    if n.fnRet >= 0 {
      const rtn = P.nodes[n.fnRet]
      if rtn is TypeRef {
        ret = resolveAnnotAt(rtn.tyName, n.fnTyParams, n.fnRet)
        // D1048's second hint: a declared return whose spelling collapsed marks the
        // DECLARATION, so an un-annotated `const r = f(…)` can inherit the provenance.
        // The pass-1 hoist below records the same fact for a top-level function; this
        // arm is what covers a NESTED one, which the hoist never walks.
        if ret >= 0 && ret == collapsedTy { markCollapsedRet(fnIx) }
        if ret < 0 {
          tErr(unknownTyText(rtn.tyName), n.fnRet)
          ret = TY_ERR
        }
        // Records the resolved return type on the return-annotation node so the emitter can
        // classify it structurally from the `Ty` arena rather than re-parsing `tyNameOf` — C1.
        if !inferQuiet && ret >= 0 {
          if n.fnRet < nodeTyIx.length { nodeTyIx[n.fnRet] = ret }
        }
      }
    }
    // `f` is hoisted in the outer scope (checkProgram pre-pass), but re-declaring
    // it here covers nested function decls and is an idempotent rebind otherwise.
    // (An anonymous function EXPRESSION has no name to bind.)
    if n.fnName != "" { declare(n.fnName, mkFuncTy(paramTys, ret)) }
  }
  // Save the inference accumulators (a demand-inference can nest inside another
  // function's body check) and the enclosing return type.
  const savedObserved = inferObserved
  const savedSawErr = inferSawErr
  const cbBefore = cycleBreakCount
  const savedValueRet = fnSawValueRet
  const savedRetNatural = retNatural
  const savedRetNaturalErr = retNaturalErr
  retNatural = -1
  retNaturalErr = false
  if inferring {
    inferStack.push(inferKey)
    inferObserved = -1
    inferSawErr = false
    fnSawValueRet = false
  }
  // A function body checked here can capture whatever narrowings are live around it, and
  // it runs later — so a narrowing installed before this point and retired after it would
  // be retired behind the capture's back. `narFnEpoch` is how the write side tells the two
  // apart (`writeStorageTy`).
  narFnEpoch = narFnEpoch + 1
  // Check the body in a fresh scope sharing the parameters.
  pushScope(n.fnBody)
  // Paired with the `flushInferRetHoles` below, which must run while this scope is still
  // live — `popScope` is what raises the uninferable-binding floor (D1591).
  pushInferRetHoles()
  // Owns the deferred constraints this body records, so a call site can tell whose type
  // parameters they speak about (`cstrOwnedBy`). Only a registered top-level declaration is
  // pushed: a nested function or lambda has no `fnDeclIx` entry for a call site to match
  // against, so its constraints stay owned by the enclosing named function.
  let cstrOwnerPushed = false
  if n.fnName != "" {
    if (fnDeclIx[n.fnName] ?? -1) == fnIx {
      cstrOwnerStack.push(fnIx)
      cstrOwnerPushed = true
    }
  }
  // Keeps the function's type parameters in scope for the whole body, so a body annotation
  // that names one — a local `const out: T[]`, `const x: T` — resolves to an opaque `TyVar`
  // instead of failing "unknown type 'T'"; `resolveAnnot` alone only scopes typarams around
  // a single param/return annotation. The emitter substitutes the concrete type per instance (`monoCloneBody`).
  let tpBody = 0
  while tpBody < n.fnTyParams.length {
    tpEnvNames.push(n.fnTyParams[tpBody])
    tpEnvTys.push(mkTyVar(n.fnTyParams[tpBody]))
    // The parameter's bound, for the same span (OQ-5, strict bodies). A row is pushed even
    // when the parameter is unbounded (-1), so the two stacks stay one-to-one with
    // `fnTyParams` and an unbounded `<T>` shadows an enclosing bounded `T` rather than
    // inheriting its bound — `tpEnv`'s own innermost-wins rule.
    tpBoundNames.push(n.fnTyParams[tpBody])
    tpBoundAnns.push(fnTpBoundOf(fnIx, tpBody))
    tpBody = tpBody + 1
  }
  // Definite-assignment: a function body is its own flow context — it runs at call time,
  // not at the declaration site, so a nested function capturing an outer still-unassigned
  // `let x` must not be flagged (the call may happen after `x` is written). Saves and clears the live unassigned set for the body, then restores the enclosing path.
  const daSavedUnassigned = daSnapshot()
  daClear()
  const savedRet = T.curRet
  T.curRet = ret
  // D1045: the name the nominal-escape refusal puts in its sentence. An anonymous
  // lambda keeps the ENCLOSING function's name, which is the scope the declaration
  // is actually inside.
  const savedEscName = curFnEscName
  if n.fnName != "" { curFnEscName = n.fnName }
  // Why this body's return type is void, for the return that disagrees with it: nobody wrote
  // `: void`, so the mismatch has to name the bare `return` that decided it.
  const savedBareRetVoid = curFnBareRetVoid
  curFnBareRetVoid = bareRetVoid
  // LSP: the function name binds in the OUTER scope (decl-scope chain), but its
  // body — params + statements — is checked under this pushed scope. Record the
  // name occurrence against the enclosing decl scope before descending.
  if symEnabled != 0 {
    if n.fnName != "" && fnIx >= 0 {
      symDeclInOuter(n.fnName, fnIx, mkFuncTy(paramTys, ret), 2)
    }
  }
  let dj = 0
  while dj < params.length {
    const pNode2 = P.nodes[params[dj]]
    if pNode2 is Param {
      declare(pNode2.parName, paramTys[dj])
      // D1048's second hint: the parameter's annotation collapsed, so the binding the
      // body sees carries the loss. Marked HERE and not at the resolution because the
      // mark is keyed by the scope frame, and that frame is this one.
      if paramCollapsed[dj] { markCollapsedBinding(pNode2.parName) }
      if symEnabled != 0 {
        symDecl(pNode2.parName, params[dj], paramTys[dj], 1)
      }
    }
    dj = dj + 1
  }
  const body = P.nodes[n.fnBody]
  if body is Block {
    const stmts = body.blkStmts
    let s = 0
    while s < stmts.length {
      // The LAST statement's value is this function's implicit return. Under inference,
      // mark it as the return-tail position so a tail `if`/`else`'s base-case branch
      // seeds `inferObserved` before a recursive sibling branch is checked.
      const savedRTPbody = retTailPos
      if s == stmts.length - 1 && inferring {
        retTailPos = true
      } else {
        retTailPos = false
      }
      // The implicit return is seeded with the declared type, exactly as the explicit one is
      // (`checkRetStmtNode`) — otherwise a narrower literal types at its default instead. An
      // unreachable tail (`return 1  print(9)`, two statements on one line) is not the implicit
      // return, so neither seeding nor checking may treat it as the returned expression.
      let tailIsReturn = s == stmts.length - 1
      if tailIsReturn && s > 0 {
        if daBranchDiverges(stmts[s - 1]) { tailIsReturn = false }
      }
      if tailIsReturn && !inferring && ret >= 0 && !isStmtNode(stmts[s]) {
        seedExpected(stmts[s], ret)
      }
      const stTy = checkNode(stmts[s])
      retTailPos = savedRTPbody
      // The trailing expression is the implicit return; under inference it is a
      // return-type witness. With a CONCRETE annotated return, a trailing empty
      // collection (`mk(): i32[] { … inner }`) pins its element from the return
      // type here — before the body scope is popped (and `inner`'s floor checked).
      if s == stmts.length - 1 {
        // Checked against the return type through `assignableExpr`, not bare `assignable`, so
        // the same coercions a declared-type binding grants (a literal widening, boolean meeting
        // i32) apply here too, matching an explicit `return <expr>` — the bare trailing
        // expression, which is the implicit return, needs the identical check.
        if !inferring && tailIsReturn {
          if ret >= 0 {
            if !isStmtNode(stmts[s]) {
              if !isVoidTy(ret) {
                if !assignableExpr(stmts[s], stTy, ret) {
                  tErr(
                    "expected " + tyToStr(ret) + ", got " + tyToStr(stTy),
                    stmts[s],
                  )
                }
              }
            }
          }
        }
        if inferring {
          // A value-producing trailing expression is a value return POSITION (vs a
          // bare trailing statement); the redundant-return fixpoint defers only these.
          if !isStmtNode(stmts[s]) { fnSawValueRet = true }
          // D1045 — the IMPLICIT return of the same rule: the trailing expression
          // is what a caller receives, so a body-scoped nominal escapes here too.
          if !isStmtNode(stmts[s]) { refuseLocalNomEscape(stTy, stmts[s]) }
          // The IMPLICIT return of the deferred pin, for the reason the explicit one
          // states: under inference the destination is the join, not this witness (D1591).
          noteInferRetWitness(stmts[s], stTy)
          noteInferredRet(inferRetTyOf(stmts[s], stTy))
        } else {
          // Redundant-return rule: witness the trailing expression's NATURAL type
          // (before constrainEmpty pins a hole); an annotation-influenced trailing
          // (empty `[]`/`Map()`, `null`) disqualifies the function.
          if retInfluencedByAnnot(stmts[s]) { retNaturalErr = true }
          noteNaturalRet(stTy)
          constrainEmptyExpr(stmts[s], stTy, ret)
          // Soundness — missing-return / non-exhaustive fall-through: when the body's last
          // statement is an else-less `is`-chain that does not cover every variant, a value
          // falls off the end (typed `| null`), which is a soundness hole for a non-void
          // declared return. Skipped when the return type is itself nullable or the error type.
          const lastN = P.nodes[stmts[s]]
          if lastN is IfStmt {
            // Only a discriminating chain is subject to this rule — a trailing `if` over `is`
            // arms, or a literal-equality chain over a literal-union place (the uncovered
            // member leaves a `| null` fall-through). A plain `if cond {…}` over a non-literal
            // place keeps the existing per-branch checks.
            const firstCond = P.nodes[condUnderParens(lastN.ifCond)]
            let isChain = false
            if firstCond is IsExpr {
              isChain = true
            } else if firstCond is BinExpr {
              if firstCond.binOp == "==" {
                let eqPlace = -1
                if litTyOfExpr(firstCond.binRight) >= 0 {
                  eqPlace = firstCond.binLeft
                } else if litTyOfExpr(firstCond.binLeft) >= 0 {
                  eqPlace = firstCond.binRight
                }
                if eqPlace >= 0 {
                  const eqObj = P.nodes[eqPlace]
                  if eqObj is Ident {
                    if isLitBearing(lookup(eqObj.identName)) { isChain = true }
                  }
                }
              }
            }
            const retT = T.tys[ret]
            let retNullable = false
            if retT is TyNullable { retNullable = true }
            if isChain && !isVoidTy(ret) && ret != TY_ERR && !retNullable {
              if !ifChainExhausts(stmts[s]) {
                // Name the uncovered variants when member coverage computed
                // them (the `match` sibling's courtesy); a chain that is
                // non-exhaustive for a SHAPE reason (a non-coverable arm, an
                // uncovered `null` path) has no member list, so stay generic.
                let chainFix = "add the missing variant(s) or an `else` (expected " +
                  tyToStr(ret) +
                  ")"
                if chainMissing != "" {
                  chainFix = "missing " +
                    chainMissing +
                    " (add the arm(s) or an `else`; expected " +
                    tyToStr(ret) +
                    ")"
                }
                tErr(
                  "non-exhaustive `is`-chain falls through with no `else` — " +
                    chainFix,
                  stmts[s],
                )
              }
            }
          }
        }
      }
      s = s + 1
    }
  }
  // Hover over an un-annotated param: the body has now recorded everything it demands of the
  // param hole, so re-retains the binding's type as that demand (the same disjunction the
  // call-arg diagnostic names) instead of the bare hole, which renders as an uninformative `_`.
  // Holes the body never constrained keep the `TyVar`, still skipped by the inlay-hint scan.
  if symEnabled != 0 && !inferQuiet {
    let hp = 0
    while hp < params.length {
      const hpNode = P.nodes[params[hp]]
      if hpNode is Param && paramTys[hp] >= 0 {
        const hpTy = T.tys[paramTys[hp]]
        if hpTy is TyVar {
          const hpDemand = holeDemandTy(hpTy.tvName)
          if hpDemand >= 0 { symRetainType(params[hp], hpDemand, 1) }
        }
      }
      hp = hp + 1
    }
  }
  // Capture body TOTALITY (missing-return soundness) while the body scope is still LIVE
  // — `ifCondIsDiscriminating` looks up a discriminated param/local's type, which the
  // `popScope` below would drop. The flag is consumed after `ret` is finalized.
  const bodyTotalForRet = nodeIsTotal(n.fnBody)
  T.curRet = savedRet
  curFnEscName = savedEscName
  curFnBareRetVoid = savedBareRetVoid
  daRestore(daSavedUnassigned)
  let tpPop = 0
  while tpPop < n.fnTyParams.length {
    tpEnvNames.pop()
    tpEnvTys.pop()
    tpBoundNames.pop()
    tpBoundAnns.pop()
    tpPop = tpPop + 1
  }
  if cstrOwnerPushed { cstrOwnerStack.pop() }
  // Every return witness is in, so the inferred return type is final — pin the empty
  // collections this body delivered to it, BEFORE `popScope` grades their bindings. An
  // ANNOTATED body recorded nothing (those positions pin at the delivery) (D1591).
  flushInferRetHoles()
  popScope()
  if !inferQuiet {
    // Marks only the registered top-level decl (not a nested/shadowing namesake).
    if n.fnName != "" && (fnDeclIx[n.fnName] ?? -1) == fnIx {
      bodyChecked[n.fnName] = true
    }
  }
  if inferring {
    ret = finishInferredReturn(
      n,
      fnIx,
      paramTys,
      paramUninferable,
      cbBefore,
      savedObserved,
      savedSawErr,
      savedValueRet,
      bodyTotalForRet,
    )
  }
  // Soundness — missing return: a function whose body can fall off the end without yielding a
  // value on some path implicitly produces `null`, sound only when `null` is part of the
  // return type. Asks whether the whole type admits `null` (`tyBearsNull`, recursive), not
  // just its top node — a union that reaches `null` through a member needs this too. Suppressed in the pre-pass and on a void/error return.
  let retNullableNow = false
  if ret >= 0 { retNullableNow = tyBearsNull(ret) }
  if (
    !inferQuiet &&
    !isVoidTy(ret) &&
    ret != TY_ERR &&
    !bodyTotalForRet &&
    !retNullableNow
  ) {
    tErr(
      "not all code paths return a value in '" +
        n.fnName +
        "' — add a `return`, or annotate the return type `| null` to fall through",
      n.fnBody,
    )
  }
  // Redundant return annotation: the body's natural inferred return already equals the
  // explicit `: T`, so removing it yields the identical type. Conservative: a single
  // concrete observed return rendering identically to `ret`; a hole / error / `never` /
  // an annotation-influenced return is skipped, and this never fires under the pre-pass.
  if (
    !inferring &&
    !inferQuiet &&
    n.fnRet >= 0 &&
    retNatural >= 0 &&
    !retNaturalErr
  ) {
    if !inlayHole(retNatural) && !isNeverTy(retNatural) && ret != TY_ERR {
      // A bare `return` in the body makes the un-annotated spelling void, so the annotation
      // is load-bearing however well its type matches the tail (D1600).
      if tyEq(retNatural, ret) && !blockHasBareReturn(n.fnBody) {
        recordRedundantRet(n, fnIx, ret)
      }
    }
  }
  retNatural = savedRetNatural
  retNaturalErr = savedRetNaturalErr
  // Inferred type guard (A6b, host parity — degenerate case): a NAMED function
  // whose body's RESULT is exactly a null-test on one of its params registers
  // as a guard, so calling it in a condition narrows the argument (inline,
  // UFCS, and the guard-clause form).
  if n.fnName != "" {
    const gBody = P.nodes[n.fnBody]
    if gBody is Block {
      const gStmts = gBody.blkStmts
      if gStmts.length > 0 {
        const gLastIx = gStmts[gStmts.length - 1]
        const gLast = P.nodes[gLastIx]
        let gResIx = gLastIx
        if gLast is RetStmt { gResIx = gLast.retArg }
        if gResIx >= 0 {
          const gParamNames: string[] = []
          let gp = 0
          while gp < params.length {
            const gpn = P.nodes[params[gp]]
            if gpn is Param {
              gParamNames.push(gpn.parName)
            } else {
              gParamNames.push("")
            }
            gp = gp + 1
          }
          const gFact = guardFactOf(gResIx, gParamNames)
          if gFact >= 0 {
            const gThen = gFact - gFact / 2 * 2
            guardNames.push(n.fnName)
            guardParamIdxs.push(gFact / 2)
            guardThens.push(gThen)
          }
        }
      }
    }
  }
  // The function's own type — a FuncDecl in EXPRESSION position (a lambda, or a
  // named function referenced as a value) evaluates to it.
  mkFuncTy(paramTys, ret)
}

// Resolves declaration statement `sx`'s fields/variants and fills them into the placeholder
// pass 0a minted for it. Two callers make the fill order-independent: pass 0b's source-order
// driver, and `declaredTyOfName`'s on-demand `forceDeclFill` when a body names a declaration
// the driver has not reached yet. Marks done before the body resolves, so a recursive declaration lands on its own empty placeholder.
function fillTypeDeclAt(sx: i32) {
  const sd = P.nodes[sx]
  if sd is TypeDecl {
    const declIx = cUserTypes[sd.tdName] ?? -1
    if declIx >= 0 && !fillDone(declIx) {
      markFillDone(declIx)
      const pt = T.tys[declIx]
      if pt is TyObj {
        const fnames = pt.objFieldNames
        const ftys = pt.objFieldTypes
        const dfields = sd.tdFields
        let fi = 0
        while fi < dfields.length {
          const fd = P.nodes[dfields[fi]]
          if fd is FieldDef {
            fnames.push(fd.fdName)
            let fty = TY_ERR
            if fd.fdType >= 0 {
              const ftn = P.nodes[fd.fdType]
              if ftn is TypeRef {
                // The diagnostic anchors on the FIELD (`dfields[fi]`); the
                // spelling tree is banked on its `TypeRef` child.
                const r = nameToTyAnn(ftn.tyName, dfields[fi], fd.fdType)
                if r >= 0 {
                  fty = r
                  // Record the resolved type on the field's annotation node so the emitter
                  // classifies a struct field structurally from the arena, not the name (C1).
                  if !inferQuiet && fd.fdType < nodeTyIx.length {
                    nodeTyIx[fd.fdType] = r
                  }
                } else {
                  tErr(
                    unknownTyTextIn(ftn.tyName, " for field '" + fd.fdName + "'"),
                    dfields[fi],
                  )
                }
              }
            }
            ftys.push(fty)
          }
          fi = fi + 1
        }
        // The 0a placeholder is just filled in place (its field arrays are
        // the ones pushed above) — an existing arena entry changed shape.
        tyMutEpoch = tyMutEpoch + 1
      }
    }
  } else if sd is UnionDecl {
    // A union's variants are type NAMES; resolve each into the member
    // type-arena indices (forward references hit the 0a placeholders).
    const declIx = cUserTypes[sd.udName] ?? -1
    if declIx >= 0 && !fillDone(declIx) {
      markFillDone(declIx)
      const pt = T.tys[declIx]
      if pt is TyUnion {
        const members = pt.uMembers
        const variants = sd.udVariants
        // A degenerate self-cycle — `type D = D`, a body that is nothing but
        // the alias itself — has no base case, so nothing can inhabit it.
        // Reported at the declaration (host parser parity), so an unused
        // `type D = D` still flags; the members stay empty (host: `Never`).
        if variants.length == 1 && variants[0] == sd.udName {
          tErr(
            "Type `" +
              sd.udName +
              "` is defined in terms of itself " +
              "with no base type, so it can never have a value",
            sx,
          )
        } else {
          let vi = 0
          let resolvedAny = false
          const declMemberIxs: i32[] = []
          // The surviving members, and the two lists the NICHE fold below needs:
          // every non-`null` survivor, and whether a `null` variant is among them.
          // Filled here instead of straight into `members` (the live arena array)
          // because the fold replaces the whole list with one wrapped member.
          const surviving: i32[] = []
          const nonNull: i32[] = []
          let sawNull = false
          while vi < variants.length {
            // A union member is a parser spelling, banked on this declaration node in member
            // order (`setUdTs`) — resolves the tree via `annotResolve`, the shared ladder every
            // positioned annotation and the `is` test already climb, not the concatenated name.
            let m = annotResolve(variants[vi], udTsRootAt(sx, vi))
            // D1022 — a member blocked by a declaration cycle falls back to its placeholder
            // rather than being dropped: `annotResolve` answers -1 while the fill is still in
            // progress, and dropping the arm silently narrowed the declared union to a type
            // the program never wrote. Pass 0a's placeholder exists precisely for this forward reference, so the fallback reaches it instead of losing the member.
            if m < 0 {
              const phName = variants[vi]
              const ph = cUserTypes[phName] ?? -1
              if ph >= 0 { m = ph }
            }
            if m >= 0 {
              declMemberIxs.push(m)
              resolvedAny = true
              // A member that folds to `never` (an empty intersection) drops from the union; a
              // declaration with no surviving member is the never-value error below. D1022 — an
              // unfilled placeholder is not `never`: dropping it as one let declaration ORDER
              // decide a type, since an empty union reads as `never`. The never-drop is only for a resolved empty intersection, not a placeholder still mid-fill.
              let mPlaceholder = false
              const mDecl = cFillStmtIx[variants[vi]] ?? -1
              if mDecl >= 0 {
                if !fillDone(mDecl) { mPlaceholder = true }
              }
              if !isNeverTy(m) || mPlaceholder {
                surviving.push(m)
                if m == TY_NULL { sawNull = true } else { nonNull.push(m) }
              }
            } else {
              tErr(
                unknownTyTextIn(variants[vi], " in union '" + sd.udName + "'"),
                sx,
              )
            }
            vi = vi + 1
          }
          // The declaration route's copy of `annUnionInnerTy`'s unseparable-member rule: this
          // loop builds its member list itself, so `type U = N | i32` never reaches the shared
          // annotation home. The union still fills — one diagnostic at the declaration is the
          // whole report, since poisoning the arena entry would turn every use into a worse one.
          const nwClash = nomUnionRepClashMsg(surviving)
          if nwClash.length > 0 {
            tErr(nwClash + " in union '" + sd.udName + "'", sx)
          }
          // The subsumed-arm collapse on the declaration side (`unionDropSubsumedArms`), the
          // same shared rule `annUnionInnerTy` applies — the two routes are one language, so
          // `type R = string | "err"` must collapse to `string` for the same reason the inline
          // spelling does. The registration list is filtered by the same predicate rather than rebuilt from the survivors, since `declMemberIxs` is a superset pushed before the never-drop.
          const survU: i32[] = []
          const nonNullU: i32[] = []
          const declU: i32[] = []
          // The declaration route's half of D1048's second-hint provenance: the annotation
          // route banks the arena index it collapsed to, while a declared alias banks its name
          // instead, since the index it produces is re-derived at every later `: R` through
          // `declaredTyOfName`. Recorded from the return value, not a length compare.
          if unionDropSubsumedArms(surviving, survU) {
            collapsedAliases[sd.udName] = true
          }
          let cu = 0
          while cu < survU.length {
            if survU[cu] != TY_NULL { nonNullU.push(survU[cu]) }
            cu = cu + 1
          }
          cu = 0
          while cu < declMemberIxs.length {
            if !unionArmSubsumedBy(declMemberIxs[cu], surviving) {
              declU.push(declMemberIxs[cu])
            }
            cu = cu + 1
          }
          // The `null` niche fold: an un-parenthesized `type T = X | null` denotes `X?`,
          // exactly as the inline annotation and the parenthesized declaration already do
          // (`annUnionTy`, the shared home) — without it `null` stayed a sibling variant,
          // breaking the one-member wrapper shape every niche consumer expects. Ungated on the inner, so this is `annUnionTy` and not a second copy of it.
          let folded = -1
          if sawNull && nonNullU.length > 0 {
            folded = annUnionTy(nonNullU, true)
          }
          // The literal-union flatten, on the declaration side (`litUnionFlatMembers`, the
          // same transform `annUnionInnerTy` climbs): this arm builds its member list itself,
          // so `type U = A | B` over two litunion aliases would otherwise fill the placeholder
          // with a union of unions, disagreeing with every channel that softens it. Gated on `!sawNull` since the null fold above already owns that list.
          const flatU: i32[] = []
          let flattened = false
          if folded >= 0 {
            members.push(folded)
          } else {
            if !sawNull { flattened = litUnionFlatMembers(survU, flatU) }
            if flattened {
              let fi = 0
              while fi < flatU.length {
                members.push(flatU[fi])
                fi = fi + 1
              }
            } else {
              let mi = 0
              while mi < survU.length {
                members.push(survU[mi])
                mi = mi + 1
              }
            }
          }
          // Variant-member registration is arity-aware (Stage B b1): only a real (2+
          // surviving member) union registers its members as variants, since the emitter
          // lowers a single-member union as the member itself, never as a variant box. A
          // flattened union registers the flattened members, not the source aliases — marking an alias itself a variant would box it at every other use in the module.
          if members.length >= 2 {
            if flattened {
              let fr = 0
              while fr < flatU.length {
                cTyIxSetAdd(
                  cVariantMemberTyIxs,
                  cVariantMemberTyIxSet,
                  flatU[fr],
                )
                fr = fr + 1
              }
            } else {
              let ri = 0
              while ri < declU.length {
                cTyIxSetAdd(
                  cVariantMemberTyIxs,
                  cVariantMemberTyIxSet,
                  declU[ri],
                )
                ri = ri + 1
              }
            }
          }
          // The 0a placeholder union is just filled in place (`members` is
          // its `uMembers` array) — an existing arena entry changed shape.
          tyMutEpoch = tyMutEpoch + 1
          if resolvedAny && members.length == 0 {
            // Explains the empty intersection in source terms: names the two operands and
            // their kinds, or calls out a self-reference — falling back to generic wording for
            // a non-binary/non-intersection never. Reads the intersection's operands from the
            // member's `TS_ISECT` spelling node directly, rather than re-splitting the parser's concatenated name.
            const opRoots: i32[] = []
            const ops: string[] = []
            const isectRoot = udTsRootAt(sx, 0)
            if isectRoot >= 0 {
              if tsKind[isectRoot] == TS_ISECT {
                const opStart = tsKidStart[isectRoot]
                let opk = 0
                while opk < tsKidCount[isectRoot] {
                  opRoots.push(tsKids[opStart + opk])
                  ops.push(tsToName(tsKids[opStart + opk]))
                  opk = opk + 1
                }
              }
            }
            let didDetail = false
            if variants.length == 1 && ops.length == 2 {
              const expr = ops[0] + " & " + ops[1]
              const selfRef = ops[0] == sd.udName || ops[1] == sd.udName
              if selfRef {
                tErr(
                  "Type `" +
                    sd.udName +
                    "` refers to itself inside an intersection (`" +
                    expr +
                    "`), so it reduces to `never`",
                  sx,
                )
              } else {
                tErr(
                  "Type `" +
                    sd.udName +
                    "` is `never` (an empty type — `" +
                    expr +
                    "`, " +
                    operandKind(tsToTy(opRoots[0])) +
                    " and " +
                    operandKind(tsToTy(opRoots[1])) +
                    ", have no common values), so it has no values",
                  sx,
                )
              }
              didDetail = true
            }
            if !didDetail {
              tErr(
                "Type `" +
                  sd.udName +
                  "` is `never` (an empty type — " +
                  "its operands have no common values), so it has no values",
                sx,
              )
            }
          }
        }
      }
    }
  }
  0
}

// Is the arena entry `declIx` already filled? Keyed by arena index, not by name, so two
// declarations sharing one placeholder (a redeclaration) fill it exactly once. One
// bounds-checked read of the flag column; an index past its end is simply not yet marked.
function fillDone(declIx: i32) {
  if declIx < 0 || declIx >= cFillDoneAt.length { return false }
  cFillDoneAt[declIx] == 1
}

// True when every member spelling of a `UnionDecl` is a quoted string literal and there are
// at least two — the shape `litUnionAliasTyOfMembers` can adopt. The pre-fill in pass 0b is
// scoped to exactly that set: a numeric literal union is not adoptable by member set, and a
// union with any other member kind gains nothing from filling early.
function udVariantsAllStrLit(vs: string[]): boolean {
  if vs.length < 2 { return false }
  let i = 0
  while i < vs.length {
    if !nameIsQuotedLeaf(vs[i]) { return false }
    i = i + 1
  }
  true
}

// Mark arena entry `declIx` filled, extending the flag column to cover it. The column only
// ever grows, so the extension costs O(highest arena index marked) across the whole pass.
function markFillDone(declIx: i32) {
  if declIx < 0 { return 0 }
  while cFillDoneAt.length <= declIx { cFillDoneAt.push(0) }
  cFillDoneAt[declIx] = 1
  0
}

// Fills declaration `name` now, when pass 0b is running and has not reached it yet. Inert
// outside pass 0b, which keeps every later re-resolution a plain lookup. Saves the
// unknown-type bank across the nested fill, so a nested failure raises at its own
// declaration with a fresh frame rather than renaming the caller's diagnostic.
function forceDeclFill(name: string) {
  if !cFillActive { return 0 }
  const sx = cFillStmtIx[name] ?? (-1)
  if sx < 0 { return 0 }
  const svDepth = unkTyDepth
  const svPart = unkTyPart
  const svClash = unkTyClash
  unkTyDepth = 0
  fillTypeDeclAt(sx)
  unkTyDepth = svDepth
  unkTyPart = svPart
  unkTyClash = svClash
  0
}

// The program root: pass 0 registers `type` declarations (structs, then unions over
// them), pass 1 hoists function signatures (call-before-decl + mutual recursion),
// pass 2 checks every top-level statement.
function checkProgramNode(n: Program) {
  const stmts = n.progStmts
  // Pass 0: registers top-level struct `type` declarations before anything else, so a struct
  // name in a param/return/let annotation or a later struct's field resolves via `nameToTy`.
  // Pass 0a pre-registers every top-level `type` name with an empty placeholder (struct or
  // union) so self- and forward-references inside field annotations and union variants resolve, filled in pass 0b.
  let t0 = 0
  while t0 < stmts.length {
    const sd0 = P.nodes[stmts[t0]]
    // A `type` declaration may not take a built-in type name: the checker resolves a bare
    // name through `tsLeafTy`, which asks `primTyOfName` first, so `f64` in an annotation is
    // the primitive while nothing screened the declaration side — a reject, not a resolution
    // change, since making one side win would silently redefine a keyword inside one file (D1585).
    if sd0 is TypeDecl {
      if isBuiltinTyName(sd0.tdName) {
        tErrBuiltinTyDecl(sd0.tdName, stmts[t0])
      }
    }
    if sd0 is UnionDecl {
      if isBuiltinTyName(sd0.udName) {
        tErrBuiltinTyDecl(sd0.udName, stmts[t0])
      }
    }
    if sd0 is TypeDecl {
      // A bound alias (`type Showable = { toString(): string }`) registers in
      // `cBoundDecls`, not `cUserTypes` — it constrains a type parameter and has no
      // values, so a type-arena entry would make it spellable in value position, which
      // the trait-object design rules out. `declaredTyOfName` turns such a use into a sentence instead.
      const bAnn0 = declBoundOf(stmts[t0])
      if bAnn0 >= 0 {
        cBoundDecls[sd0.tdName] = bAnn0
        t0 = t0 + 1
        continue
      }
      // A generic alias (`type Box<T> = …`) registers in the generic-alias registry, not
      // `cUserTypes`, since it has no concrete type until applied — pass 0b skips it, and each
      // application resolves its fields under the param→argument bindings (`applyGenAlias`).
      // The nominal-newtype declaration fact is recorded now regardless, honoured only on the concrete arm below.
      const gBase = declGpBaseOf(stmts[t0])
      if gBase != "" {
        gaNames.push(gBase)
        gaDeclIxs.push(stmts[t0])
        // D-GAPARAM: the parameter list is banked ONCE, here, into the flat
        // column. Master re-split the joined string inside `applyGenAliasArgs`,
        // i.e. once per APPLICATION of the alias; the list is a property of the
        // DECLARATION and cannot change between applications.
        const gps = declGpParamsOf(stmts[t0])
        gaParamStart.push(gaParamNames.length)
        gaParamCount.push(gps.length)
        let gpi = 0
        while gpi < gps.length {
          gaParamNames.push(gps[gpi])
          gpi = gpi + 1
        }
      } else {
        // A bodyless alias (parser sentinel `tdFields == [-1]`) registers as the error type,
        // since the parser already reported it; a real body builds an object placeholder pass
        // 0b fills. Banked in the fill registry so a forward reference can demand its shape
        // early — absent for a generic alias, which resolves under its own bindings instead.
        cFillStmtIx[sd0.tdName] = stmts[t0]
        const df0 = sd0.tdFields
        const bodyless0 = df0.length == 1 && df0[0] == (-1)
        if bodyless0 {
          cUserTypes[sd0.tdName] = TY_ERR
          cUserTypesVer = cUserTypesVer + 1
        } else {
          const fnames0: string[] = []
          const ftys0: i32[] = []
          const sIx0 = mkObjTy(fnames0, ftys0)
          cUserTypes[sd0.tdName] = sIx0
          cUserTypesVer = cUserTypesVer + 1
          cTyIxSetAdd(cStructTyIxs, cStructTyIxSet, sIx0)
          cStructNames.push(sd0.tdName)
          if sd0.tdNew == 1 {
            nwDeclNames.push(sd0.tdName)
            if isBodyTyDecl(stmts[t0]) { nwBodyScopedNames[sd0.tdName] = 1 }
          }
        }
      }
    } else if sd0 is UnionDecl {
      // A one-member alias whose body is a plain type reference is transparent — decided
      // here in pass 0a since the question is syntactic (the arena cannot tell it from a
      // canonicalized intersection) and both readers run later. A self-cycle (`type D = D`)
      // is excluded: it is the degenerate never-type pass 0b reports, and resolving it transparently would chase its own placeholder.
      const uvs0 = sd0.udVariants
      if uvs0.length == 1 && uvs0[0] != sd0.udName {
        if aliasRefIsPlainRoot(udTsRootAt(stmts[t0], 0)) {
          cPlainAliasNames.push(sd0.udName)
        }
      }
      cFillStmtIx[sd0.udName] = stmts[t0]
      const members0: i32[] = []
      const uIx0 = mkUnionTy(members0)
      cUserTypes[sd0.udName] = uIx0
      cUserTypesVer = cUserTypesVer + 1
      cTyIxSetAdd(cUnionTyIxs, cUnionTyIxSet, uIx0)
      cUnionNames.push(sd0.udName)
      if sd0.udNew == 1 {
        nwDeclNames.push(sd0.udName)
        if isBodyTyDecl(stmts[t0]) { nwBodyScopedNames[sd0.udName] = 1 }
      }
    }
    t0 = t0 + 1
  }
  // Pass 0b: resolves each declaration's fields/variants into the placeholder, in demand
  // order rather than source order — `fillTypeDeclAt` re-enters from `declaredTyOfName`
  // whenever a body names a declaration the walk has not reached, so a forward reference
  // resolves against the filled shape regardless of which declaration came first.
  cFillDoneAt = []
  cFillActive = true
  // A pure string-literal union alias fills ahead of the driver, because the reference to it
  // is by member set, not by name (D1151): an inline `{ k: "a" | "b" }` reaches for the alias
  // through `litUnionAliasTyOfMembers`, which scans for a filled litunion with exactly these
  // members — so an un-filled placeholder would mint a second, unregistered union for the same spelling.
  let li = 0
  while li < stmts.length {
    const ls = P.nodes[stmts[li]]
    if ls is UnionDecl {
      if udVariantsAllStrLit(ls.udVariants) { fillTypeDeclAt(stmts[li]) }
    }
    li = li + 1
  }
  let ti = 0
  while ti < stmts.length {
    fillTypeDeclAt(stmts[ti])
    ti = ti + 1
  }
  cFillActive = false
  // Pass 0c: MEASURE every `flat type` (webcraft P1.2). Runs here because it needs
  // pass 0b's resolved field types (a scalar's width is read off the arena, which
  // is what makes a newtype over a scalar work for free) and must precede any
  // expression checking, since `N.size` / `N.field` fold against this sidecar.
  resolveFlatLayouts(stmts)
  // Pass 0d: REFUSE a union whose arms nothing can tell apart (D1023). Runs here, after 0b
  // has filled every arm's `TyObj`, because the rule reads field names and field TYPES and a
  // declaration cycle can still leave a member an empty placeholder inside the fill itself.
  checkUnionDiscriminable(stmts)
  // Pass 1: hoist top-level function signatures so call-before-decl and mutual
  // recursion type-check.
  let hi = 0
  while hi < stmts.length {
    const s = P.nodes[stmts[hi]]
    if s is FuncDecl {
      // A SECOND top-level `function` of the same name is a redeclaration error,
      // exactly like a duplicate `let`/`const` (B16). Without this the later
      // hoist silently overwrites the earlier one and the last body wins.
      if (fnDeclIx[s.fnName] ?? -1) >= 0 {
        // `opDeclLabel` is the identity on an ordinary name; an index operator
        // reads back as `"[]" for F32View` rather than as its minted spelling.
        tErr("redeclared " + opDeclLabel(s.fnName), stmts[hi])
      }
      const hp = s.fnParams
      const hpt: i32[] = []
      let k = 0
      while k < hp.length {
        const hpn = P.nodes[hp[k]]
        let t = TY_ERR
        if hpn is Param {
          if hpn.parType >= 0 {
            const hptn = P.nodes[hpn.parType]
            if hptn is TypeRef {
              const r = resolveAnnotAt(hptn.tyName, s.fnTyParams, hpn.parType)
              if r >= 0 { t = r }
            }
          } else {
            // An un-annotated param hoists as its inference hole (the same declaration+
            // position name `checkFuncDeclNode` mints, so a forward call binds the identical
            // hole by name) — or as the type pass 1.8's solve pinned it to, via
            // `unannotParamTy`, which keeps this hoist and the body from disagreeing.
            t = unannotParamTy(paramHoleName(s.fnName, stmts[hi], k))
          }
        }
        hpt.push(t)
        k = k + 1
      }
      // An UN-ANNOTATED return hoists as the PENDING sentinel (-2): the real type
      // is inferred from the body in pass 2 (or on demand at a forward call site),
      // then PATCHED into this same TyFunc in place.
      let hret = -2
      if s.fnRet >= 0 {
        const hrtn = P.nodes[s.fnRet]
        if hrtn is TypeRef {
          const r = resolveAnnotAt(hrtn.tyName, s.fnTyParams, s.fnRet)
          // D1048's second hint, recorded order-independently: this hoist is the only pass
          // that resolves every top-level return before any body runs, so a `const r = f(…)`
          // written above `function f(): R` still inherits the provenance.
          if r >= 0 && r == collapsedTy { markCollapsedRet(stmts[hi]) }
          if r >= 0 { hret = r } else { hret = TY_VOID }
        }
      }
      declare(s.fnName, mkFuncTy(hpt, hret))
      fnDeclIx[s.fnName] = stmts[hi]
      declareFnDeclNode(s.fnName, stmts[hi])
      // REGISTER a free index operator (B14). Its ARITY is fixed by the operator
      // — `"[]"` is (self, index), `"[]="` is (self, index, value) — and checking
      // it here means a malformed declaration is reported once, at itself, rather
      // than at every use site that fails to resolve.
      const opk = opDeclOpOf(s.fnName)
      if opk != "" {
        let want = 2
        if opk == OP_INDEX_SET { want = 3 }
        if hp.length != want {
          tErr(
            "operator " +
              opDeclLabel(s.fnName) +
              " takes " +
              i32ToStr(want) +
              " parameters (self, index" +
              opIdxArityTail(opk) +
              "), got " +
              i32ToStr(hp.length),
            stmts[hi],
          )
        } else if opIdxDeadRecv(hpt[0]) {
          // The swallow, said out loud (D445): indexing an array, a map or a string is the
          // language's, never a user operator's, so a declaration over one of them is not a
          // dispatch that fails to happen — it is one the language already decided will never
          // happen, named here at the declaration rather than silently at every use site.
          tErr(
            "operator " +
              opDeclLabel(s.fnName) +
              " can never dispatch: indexing " +
              tyToStr(hpt[0]) +
              " is the language's own, never a user operator's",
            stmts[hi],
          )
        } else {
          opIdxOps.push(opk)
          opIdxFns.push(s.fnName)
        }
      }
      // The swallow at the binary operators, said out loud (D425) — the twin of the index
      // gate above: `checkBinary` reaches `opSelfFnTy` only when the left operand is an
      // object, so a declaration whose `self` is not one is not a dispatch that fails, it is
      // one the language already decided will never happen. Disjoint from D471's first-parameter-name gate (checked in the parser), so a declaration failing both gets the name diagnostic only.
      if isBinOpFuncName(s.fnName) {
        if hp.length == 2 {
          let selfNamed = false
          // Whether `self` carries an ANNOTATION at all (D491) — read inside the `is
          // Param` narrowing, which is the only place the field exists.
          let selfAnn = false
          const bp0 = P.nodes[hp[0]]
          if bp0 is Param {
            if bp0.parName == "self" { selfNamed = true }
            if bp0.parType >= 0 { selfAnn = true }
          }
          if selfNamed {
            if binOpDeadSelf(hpt[0]) {
              tErr(
                "operator `" +
                  s.fnName +
                  "` can never dispatch: `self` is the LEFT OPERAND and dispatch needs an object, but " +
                  tyToStr(hpt[0]) +
                  " is not one",
                stmts[hi],
              )
            } else {
              // The hole this gate subtracts (D491) is banked, not judged — whether this
              // declaration fires is decided at the sites (`checkProgramEndOpDecls`). Both hole
              // spellings are banked as one population: `function "+"(self, other)` hoists its
              // parameter as a fresh type variable, so `tyHasHole` is true of it exactly as of `self: T` (D521).
              if hpt[0] >= 0 {
                if tyHasHole(hpt[0]) {
                  opBinHoleDeclName.push(s.fnName)
                  opBinHoleDeclNode.push(stmts[hi])
                  opBinHoleDeclAnn.push(selfAnn)
                }
              }
            }
          }
        }
      }
      // Collect un-annotated returns (hoisted as the `-2` pending sentinel) for the
      // return-inference pre-pass.
      if hret == (-2) { topUnannotFns.push(stmts[hi]) }
      // Completion visibility: a top-level function is global. Stamped here (only
      // the global scope is open) so it wins over any later demand-inference
      // re-entry, which would run the body from a deeper stack (see `symStampVis`).
      if symEnabled != 0 {
        symStampVis(s.fnName, stmts[hi], 2, scopeSL.length - 1)
      }
    }
    hi = hi + 1
  }
  // Pass 1.5 hoists top-level value bindings (names + types) so a function body sees every
  // module-level value regardless of source order, making the module scope order-independent.
  // Initialization order still matters for straight-line top-level code — each global joins
  // the definite-assignment dead-zone here — but a function body runs at call time, so a deferred read from inside one is correctly not flagged.
  let mi = 0
  while mi < stmts.length {
    const sm = P.nodes[stmts[mi]]
    if sm is LetDecl {
      if moduleGlobals[sm.letName] ?? false {
        // A genuine top-level redeclaration — reported here (pass 2 skips its own
        // redeclare check for module globals, since the hoist owns the declaration).
        tErr("redeclared " + sm.letName, stmts[mi])
      } else {
        let mty = TY_ERR
        if sm.letType >= 0 {
          const mtn = P.nodes[sm.letType]
          if mtn is TypeRef {
            const r = nameToTyAt(mtn.tyName, sm.letType)
            if r >= 0 { mty = r }
          }
        } else if sm.letInit >= 0 {
          // Un-annotated: peeks only at a literal initializer (side-effect free). A `checkNode`
          // here would prematurely demand-infer callees and patch their hoisted return types,
          // corrupting the real pass-2 result, so a non-literal init stays an error placeholder
          // that pass 2 overwrites with its real type.
          const initN = P.nodes[sm.letInit]
          if initN is NumLit {
            if numLexIsFloat(initN.numText) { mty = TY_F64 }
            else if intLexemeFitsI32(initN.numText) { mty = TY_I32 }
            else { mty = TY_I64 }
          } else if initN is StrLit {
            mty = TY_STR
          } else if initN is CharLit {
            mty = TY_I32
          } else if initN is BoolLit {
            mty = TY_BOOL
          }
        }
        declare(sm.letName, mty)
        if letDeclIsUnannotObjLit(stmts[mi]) {
          markObjLitBinding(sm.letName, 0)
        }
        moduleGlobals[sm.letName] = true
        // TDZ: in the dead-zone until pass 2 reaches the initializer.
        daAdd(sm.letName)
      }
    }
    mi = mi + 1
  }
  // Pass 1.6: solve every un-annotated PARAMETER from its body's usage, BEFORE any
  // expression is checked — so a call site binds the solved parameter type whatever
  // the source order, and before pass 1.7 infers returns against it. See
  // `solvedParamTys`.
  let sp = 0
  while sp < stmts.length {
    const sps = P.nodes[stmts[sp]]
    if sps is FuncDecl { solveUnannotParams(stmts[sp]) }
    sp = sp + 1
  }
  // Pass 1.7: return-inference pre-pass — resolve every un-annotated return (cycles
  // included, via the binding-group fixpoint) BEFORE checking bodies, so pass 2 sees
  // final return types and a recursive function needs no return annotation.
  inferReturnsPrePass()
  // Pass 2: check every top-level statement (bodies included).
  let j = 0
  while j < stmts.length {
    checkNode(stmts[j])
    j = j + 1
  }
  // A function whose return never resolved (a genuinely base-case-less recursive
  // cycle) — the fixpoint found no concrete basis. Reported here, after the real
  // pass (the pre-pass suppressed it).
  let uf = 0
  while uf < unresolvedFns.length {
    const ufIx = fnDeclIx[unresolvedFns[uf]] ?? -1
    if ufIx >= 0 {
      const ufn = P.nodes[ufIx]
      if ufn is FuncDecl {
        tErr(
          "cannot infer a return type for '" +
            unresolvedFns[uf] +
            "' — annotate a return type",
          ufn.fnBody,
        )
      }
    }
    uf = uf + 1
  }
  // LAST, because both of its filters read state this pass fills — see its header.
  annCommitVariantMembers()
  TY_VOID
}

// Wraps a match arm body as a `Block` (a bare-expression body becomes a one-statement block).
function matchBlockOf(bodyIx: i32) {
  const b = P.nodes[bodyIx]
  if b is Block { return bodyIx }
  const one: i32[] = []
  one.push(bodyIx)
  mkBlock(one, -1)
}

// The arm's block with its payload bindings (phase 2b): `matchBlockOf` plus the clause's
// `const x = scrut.x` decls prepended — node-for-node the hand-written `if scrut is Move {
// const x = cmd.x; … }` twin. A `Block` body is rewritten in place rather than replaced by a
// fresh index, since the body already carries a checked `nodeTyIx` row a new node would lose.
function matchArmBlockOf(bodyIx: i32, bindIx: i32) {
  if bindIx < 0 { return matchBlockOf(bodyIx) }
  const stmts: i32[] = []
  const bn = P.nodes[bindIx]
  if bn is Block {
    let i = 0
    while i < bn.blkStmts.length {
      stmts.push(bn.blkStmts[i])
      i = i + 1
    }
  }
  const b = P.nodes[bodyIx]
  if b is Block {
    let j = 0
    while j < b.blkStmts.length {
      stmts.push(b.blkStmts[j])
      j = j + 1
    }
    const spliced = mkBlock(stmts, b.pos)
    P.nodes[bodyIx] = P.nodes[spliced]
    return bodyIx
  }
  stmts.push(bodyIx)
  mkBlock(stmts, -1)
}

// `scrut == p0 [|| scrut == p1 …]` over match arm `k`'s or-patterns. A type pattern is
// already the test: the parser minted it as an `IsExpr` over this scrutinee, so the arm's
// condition is the pattern node itself — the chain built is byte-for-byte what a hand-written
// `if scrut is A {…} else if scrut is B {…}` guard chain would produce, so every arm narrows.
function matchArmCond(
  scrut: i32,
  pats: i32[],
  armStart: i32[],
  armCount: i32[],
  k: i32,
  pos: i32,
) {
  let cond = -1
  let pj = 0
  while pj < armCount[k] {
    const pat = pats[armStart[k] + pj]
    let term = -1
    const pn = P.nodes[pat]
    if pn is IsExpr {
      term = pat
    } else {
      term = mkBinary("==", scrut, pat, pos)
    }
    if cond < 0 { cond = term } else { cond = mkBinary("||", cond, term, pos) }
    pj = pj + 1
  }
  cond
}

// Arm `k`'s payload-binding clause (phase 2b) — the `Block` of `const x = scrut.x` decls the
// parser banked on the arm's pattern — or -1 when it binds nothing. Only a single-pattern arm
// may carry a clause (a multi-pattern arm gets no then-narrowing, so the field read would not
// type); reading -1 there avoids stacking a second, misleading diagnostic on the or-pattern reject.
function matchArmBindsOf(n: MatchExpr, k: i32) {
  if n.matchArmCount[k] != 1 { return -1 }
  n.matchBinds[n.matchArmStart[k]]
}

// Whether ANY of arm `k`'s patterns carries a clause — the or-pattern reject reads this, not
// `matchArmBindsOf`, so `A | B{x} => …` is caught as well as `A{x} | B => …`.
function matchArmHasBinds(n: MatchExpr, k: i32) {
  let j = 0
  while j < n.matchArmCount[k] {
    if n.matchBinds[n.matchArmStart[k] + j] >= 0 { return true }
    j = j + 1
  }
  false
}

// The arm that becomes the desugared chain's bare `else`: the `_` wildcard arm when there is
// one, otherwise the last arm (the match is exhaustive, so it is the only case left). Taken
// from the pattern columns rather than the node, so the checker can ask the same question
// before the desugar runs and never drifts from it (`checkMatchTypeArms`).
function matchElseArmOf(pats: i32[], armStart: i32[], armCount: i32[]) {
  const nArms = armStart.length
  let wildArm = -1
  let ai = 0
  while ai < nArms {
    let pj = 0
    while pj < armCount[ai] {
      const p = P.nodes[pats[armStart[ai] + pj]]
      if p is Ident { wildArm = ai }
      pj = pj + 1
    }
    ai = ai + 1
  }
  if wildArm >= 0 { return wildArm }
  nArms - 1
}

// Lowers the checked, exhaustive `MatchExpr` at `ix` to an if/else chain, overwriting the
// arena slot in place, so lint and emit see only if-chains. The wildcard arm (or the last arm)
// becomes the bare `else`. A zero-arm `match` has no body for that else — `elseArm == -1` traps
// the compiler on an unbounded read — but the checker has already reported it non-exhaustive, so a type-erroring program never reaches this, where a surviving `MatchExpr` would matter.
function desugarMatchAt(ix: i32) {
  const n = P.nodes[ix]
  if n is MatchExpr {
    const scrut = n.matchScrut
    const pats = n.matchPats
    const armStart = n.matchArmStart
    const armCount = n.matchArmCount
    const bodies = n.matchBodies
    const mpos = n.pos
    const nArms = armStart.length
    if nArms > 0 {
      const elseArm = matchElseArmOf(pats, armStart, armCount)
      let chain = matchArmBlockOf(bodies[elseArm], matchArmBindsOf(n, elseArm))
      let k = nArms - 1
      while k >= 0 {
        if k != elseArm {
          const cond = matchArmCond(scrut, pats, armStart, armCount, k, mpos)
          const thenB = matchArmBlockOf(bodies[k], matchArmBindsOf(n, k))
          chain = mkIf(cond, thenB, chain, mpos)
        }
        k = k - 1
      }
      P.nodes[ix] = P.nodes[chain]
    }
  }
  0
}

// D1580 — the return tail is a spine, not a subtree: `retTailPos` may follow only the chain
// of nodes whose own value is the function's return (a block's last statement, an
// if-expression's arms, a `return`'s argument, a paren). Every other parent — an object
// field, a list element, a call argument — merely contains the expression, so its `if` arms belong to that container's type, not the function's.
function tailSpineNode(ix: i32) {
  if ix < 0 { return false }
  const nd = P.nodes[ix]
  nd is Block || nd is IfStmt || nd is RetStmt || nd is Paren
}

// —— the Node visitor (dispatch; per-kind helpers above take narrowed variants) ——
// Thin recording wrapper around `checkNodeReal`: on the real (non-quiet) pass, stores each
// node's resolved type-arena index into the typed-IR table. Recording the arena index, not a
// snapshot, means a hole pinned later in place is reflected when the emitter reads it back — last write wins.
function checkNode(ix: i32) {
  const savedTail = retTailPos
  if retTailPos {
    if !tailSpineNode(ix) { retTailPos = false }
  }
  const t = checkNodeReal(ix)
  retTailPos = savedTail
  if !inferQuiet {
    if ix >= 0 {
      if ix < nodeTyIx.length { nodeTyIx[ix] = t }
    }
  }
  t
}

// Dispatches every node kind — expressions and statements — and returns the node's
// type-arena index (statements yield `TY_VOID`). Every per-variant body is inlined here,
// including the nested `TypeRef`/`Param`/`Block` narrowing, since no other function may
// narrow `Node`. On a type error it raises a diagnostic and returns `TY_ERR` so checking continues.
function checkNodeReal(ix: i32) {
  if ix < 0 { return TY_ERR }
  const n = P.nodes[ix]

  // ── literals & identifiers ────────────────────────────────────────────────
  if n is NumLit {
    // A literal with a "." is f64. An integer literal defaults to the NARROWEST
    // type that holds it exactly — i32 if its magnitude fits, else i64 — the
    // host's `defaultIntegerType` rule (`intLexemeFitsI32`).
    if numLexIsFloat(n.numText) {
      // A literal whose magnitude rounds past the largest finite double names a value f64
      // cannot represent — and VL has no infinity spelling to encode it honestly, so it is an
      // error (a silent ±inf would be a lossy implicit conversion). Runtime arithmetic still
      // yields ±inf per IEEE-754; this rejects only literal text.
      if f64LitOverflows(n.numText) { tErr("float literal overflows f64", ix) }
      return TY_F64
    }
    // A radix literal that adopted a 64-bit destination keeps that width across re-checks; one
    // wider than 64 bits has no destination at all, and says so here rather than wrapping.
    if litWide64Of(ix) { return TY_I64 }
    if numLexRadixBits(n.numText) > 64 {
      tErr(radixLitTooWideMsg(n.numText, 64), ix)
      return TY_I64
    }
    if intLexemeFitsI32(n.numText) { return TY_I32 }
    return TY_I64
  } else if n is StrLit {
    return TY_STR
  } else if n is CharLit {
    // A char literal `'x'` is its i32 code point (composes with arithmetic / `==` /
    // string indexing exactly like a bare int literal), not a string.
    return TY_I32
  } else if n is BoolLit {
    return TY_BOOL
  } else if n is NullLit {
    return TY_NULL
  } else if n is Ident {
    // A marked parameter default resolves in the declaration's scope — for the one name form
    // v1 admits, the module frame. Checked once at the declaration and again at every call
    // site that omits the argument; the second reading is why the mark exists, so a
    // caller-local binding sharing the const's name cannot capture the substituted reference.
    if isDefaultGlobalRef(ix) {
      if T.scopes.length > 0 {
        if T.scopes[0].has(n.identName) {
          return T.scopes[0][n.identName] ?? TY_ERR
        }
      }
      return TY_ERR
    }
    const ty = lookup(n.identName)
    if ty < 0 {
      // `__callsite__` is legal — as a parameter default value, and nowhere else.
      // Reaching the undeclared-identifier floor means it appears in an expression, so
      // say which position it belongs in rather than that the name does not exist
      // (it does; `checkParamDefaults` accepts it).
      if n.identName == CALLSITE_NAME {
        tErr(
          "`__callsite__` is legal only as a parameter default value — write `caller: { file: string, line: i32, col: i32 } = __callsite__`",
          ix,
        )
        return TY_ERR
      }
      // The interpolation renderer's floor: `$tpl$render` is minted by the parser and
      // rewritten to the merged `toString$mN` by `modBuildRename`, so reaching here means
      // `std:fmt` never entered the module graph. Named, since the generic
      // undeclared-identifier message would point at a name the author cannot have written.
      if n.identName == TPL_RENDER_LOCAL {
        tErr(
          "internal: an interpolation hole's renderer was not merged — `std:fmt` is missing from this program's module graph",
          ix,
        )
        return TY_ERR
      }
      tErr(
        "undeclared identifier '" +
          n.identName +
          "'" +
          stdFmtMovedNote(n.identName),
        ix,
      )
      return TY_ERR
    }
    // `ty` is this use's type as the checker resolved it — narrowed when the use
    // sits inside a guarded arm. Threaded in so the occurrence retains it.
    if symEnabled != 0 { symUse(ix, n.identName, ty) }
    // Definite-assignment read gate: a bare-name read of a still-unassigned binding is "used
    // before assigned". The LHS of a plain `=` is a write, not a read (the `BinExpr` `=` arm
    // marks it `daWriteTarget` before evaluating the target), so it is skipped here; a
    // compound `x += …` desugars to `x = x + (…)`, whose RHS read does reach this gate.
    if ix != daWriteTarget { daCheckRead(n.identName, ix) }
    return ty
  } else if n is Paren {
    return checkNode(n.parInner)
    // ── explicit numeric cast `x as T` ──────────────────────────────────────────
  } else if n is AsExpr {
    return checkCastNode(n, ix)
    // ── unary ─────────────────────────────────────────────────────────────────
  } else if n is Unary {
    return checkUnaryNode(n, ix)
  } else if n is BinExpr {
    return checkBinExprNode(n, ix)
  } else if n is Call {
    const callTy = checkCallNode(n, ix)
    // A call is where a path narrowing can be falsified by a write the guarded
    // scope never spells. Asked after the arguments are checked so the call's own
    // operands still read under the narrowing that holds at their own evaluation.
    noteCallInvalidations(ix)
    return callTy
    // ── member access ───────────────────────────────────────────────────────────
  } else if n is Member {
    return checkMemberNode(n, ix)
  } else if n is ArrayLit {
    return checkArrayLitNode(n, ix)
  } else if n is Index {
    return checkIndexNode(n, ix)
  } else if n is ObjLit {
    return checkObjLitNode(n, ix)
  } else if n is IsExpr {
    return checkIsExprNode(n, ix)
  } else if n is OptMember {
    return checkOptMemberNode(n, ix)
  } else if n is ErrExpr {
    return TY_ERR
    // ── let / const ─────────────────────────────────────────────────────────────
  } else if n is LetDecl {
    return checkLetDeclNode(n, ix)
  } else if n is FuncDecl {
    return checkFuncDeclNode(n, ix)
    // ── while ─────────────────────────────────────────────────────────────────
  } else if n is WhileStmt {
    return checkWhileStmtNode(n, ix)
    // Accepted unconditionally: valid only inside a loop, but loop-nesting is
    // not tracked yet (a misplaced `break`/`continue` is a parser concern).
  } else if n is BreakStmt {
    return TY_VOID
  } else if n is ContinueStmt {
    return TY_VOID
    // ── for v in A to B [step S] ────────────────────────────────────────────────
    // A numeric range loop: the bounds (and step, if present) must be i32; the loop
    // variable is i32 in the body's scope.
  } else if n is ForRange {
    return checkForRangeNode(n, ix)
  } else if n is ForIn {
    return checkForInNode(n, ix)
  } else if n is MatchExpr {
    return checkMatchExprNode(n, ix)
  } else if n is IfStmt {
    return checkIfStmtNode(n, ix)
  } else if n is RetStmt {
    return checkRetStmtNode(n, ix)
  } else if n is Block {
    return checkBlockNode(n, ix)
  } else if n is Program {
    return checkProgramNode(n)
  } else if n is Param {
    return TY_VOID
  } else if n is TypeRef {
    return TY_VOID
  } else if n is TypeDecl {
    // Registered by the Program pass-0 pre-pass; nothing to do when visited.
    return TY_VOID
  } else if n is UnionDecl {
    // Registered by the Program pass-0 pre-pass; nothing to do when visited.
    return TY_VOID
  } else if n is ImportDecl {
    // A tooling node (the lint tier reads it): import binding/resolution
    // happened in the module front end (the driver's token-level `modScan` +
    // merge), so the checker has nothing to verify here.
    return TY_VOID
  }
  TY_ERR
}

// Flattens a (possibly nested) union/nullable type into its leaf atom names, pushing each
// into `out` ("null" for the nullable slot). `joinTys` can nest a nullable around a union, so
// this recurses. Builds the emitter-format `a|b|null` union name for an inferred return
// (`splitUnionAtoms` splits on a bare `|`, not `tyToStr`'s ` | `).
function collectRetAtoms(er: i32, out: string[]) {
  if er < 0 { return 0 }
  const t = T.tys[er]
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      collectRetAtoms(t.uMembers[i], out)
      i = i + 1
    }
  } else if t is TyNullable {
    collectRetAtoms(t.nInner, out)
    out.push("null")
  } else {
    out.push(tyToStructStr(er))
  }
  0
}

// The canonical emitter name for an inferred return `er` if it is a bare struct whose every
// field is emit-nameable and at least one field is a union or nullable (a boxed/niche field
// slot), else "". A closure-result body literal self-infers the plain field shape, so
// `synthRetAnnots` pins `fnRet` to this canonical name, matching the annotated form (the struct-field dual of `valueUnionRetName`/`mapUnionRetName`).
function structFieldBoxRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if !(t is TyObj) { return "" }
  let hasBox = false
  let i = 0
  while i < t.objFieldTypes.length {
    const ft = T.tys[t.objFieldTypes[i]]
    if ft is TyUnion {
      // Every member must be a scalar / string-literal / object (a boxable value or
      // struct-mixed union). A closure / map / list / nullable member is not lowerable as a
      // boxed struct-field slot — the annotated form itself rejects those, so pinning would
      // turn a working shape into a new loud reject. Declines the whole struct then.
      let m = 0
      let uClo = 0
      let uObj = 0
      while m < ft.uMembers.length {
        const mt = T.tys[ft.uMembers[m]]
        if mt is TyObj { uObj = uObj + 1 }
        if !(mt is TyPrim) && !(mt is TyLit) && !(mt is TyObj) {
          // A litunion-alias member kept nested in the arena (`K0 | boolean`): rides the box
          // as the i32 atom / string ref, `tyToEmitName` renders the alias, and the annotated
          // spelling lowers — admitted. Without this the whole struct declined and the
          // closure-field lambda recorded the spaced self render instead of the canonical pin.
          if mt is TyFunc {
            // One closure member beside a struct sibling (`(() => i64) | {w: i32}`): rides the
            // box anyref as the kind-11 ref atom (#965), and the annotated spelling lowers. A
            // second closure member is declined conservatively — discriminable in principle
            // (each tags its own interned signature slot), but untested on this naming path.
            uClo = uClo + 1
            if uClo > 1 { return "" }
          } else if mt is TyMap {
            // A map member (`{[string]: {a, f, z}} | i32`): rides the box tagged by
            // `mapSlotTag` (the #865/#868 map-union rep), and the annotated spelling of such a
            // field lowers fully. Requires the canonical render to succeed first (the
            // `vbUnionMemberName` map-admission twin), or the struct declines instead of mis-pinning.
            if !tyIsEmitRepresentable(ft.uMembers[m]) { return "" }
          } else if !tyIsLitUnion(ft.uMembers[m]) {
            return ""
          }
        }
        m = m + 1
      }
      if uClo > 0 && uObj == 0 { return "" }
      hasBox = true
    } else if ft is TyNullable {
      // A nullable struct field (`{f: f64 | null}`, `{f: S | null}`) — a niche slot the
      // annotated form already lowers. Recorded as box-bearing (so the pin fires) when the
      // inner is a prim/literal/object; an unlowerable inner (closure/map/list) declines the
      // whole struct as before, so the lambda takes the proven annotated-form path.
      const nin = T.tys[ft.nInner]
      if !(nin is TyPrim) && !(nin is TyLit) && !(nin is TyObj) {
        // A nullable struct-element-list field (`{f: {f: string}[] | null}` — the code-28
        // nul-ref-list slot the annotated form already lowers): admitted so the lambda pins to
        // the canonical render, rather than keeping the `?`-spelled shape no pin arm matches.
        // Other inners (closure/map/scalar-backed lists) keep the decline, since their nullable field slots are not all lowerable.
        let nulListOk = false
        if nin is TyArray {
          if nin.aElem >= 0 {
            const nel = T.tys[nin.aElem]
            if nel is TyObj { nulListOk = true }
          }
        }
        if !nulListOk { return "" }
      }
      hasBox = true
    } else if ft is TyObj {
      // A nested struct field (`{f: {f: i32 | string}}`): the boxed slot may sit one level
      // down, so this recurses to fire the pin for a lambda whose nested literal field adopted
      // a union-field shape. A nested shape with no box contributes nothing — the "" is a
      // plain no-box, not a decline, since its own unlowerable unions still fail loudly elsewhere.
      if structFieldBoxRetName(t.objFieldTypes[i]) != "" { hasBox = true }
    }
    i = i + 1
  }
  if !hasBox { return "" }
  irRendered(tyToEmitName(er))
}

// The canonical emitter name for an inferred return `er` if it is a bare struct carrying a
// map field anywhere in its (recursively nested-struct) field tree, else "". A map-carrying
// struct a lambda body literal builds has no field-set anchor for its nested literals, so
// `synthRetAnnots` pins `fnRet` to this name, matching the annotated form's own threading.
function structMapFieldRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if !(t is TyObj) { return "" }
  if !tyObjHasMapField(er) { return "" }
  irRendered(tyToEmitName(er))
}

// True if struct-arena entry `er` (a `TyObj`) carries a `TyMap` field directly or inside a
// nested `TyObj` field (any depth). The `structMapFieldRetName` gate.
function tyObjHasMapField(er: i32) {
  const t = T.tys[er]
  if t is TyObj {
    let i = 0
    while i < t.objFieldTypes.length {
      const ft = T.tys[t.objFieldTypes[i]]
      if ft is TyMap { return true }
      if ft is TyObj {
        if tyObjHasMapField(t.objFieldTypes[i]) { return true }
      }
      i = i + 1
    }
  }
  false
}

// The canonical emitter name for an inferred return `er` if it is a list whose element is a
// `structFieldBoxRetName` struct (a struct with a boxed union/nullable field slot), else "".
// A closure-result array literal of such structs self-infers the plain element shape, so
// `synthRetAnnots` pins `fnRet` to this name, matching the annotated form's boxed-field elements.
function structFieldBoxElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if !(t is TyArray) { return "" }
  if t.aElem < 0 { return "" }
  if structFieldBoxRetName(t.aElem) == "" { return "" }
  irRendered(tyToEmitName(er))
}

// Whether every leaf atom of the (possibly nested) union/nullable type `er` renders to a
// short name `valueAtomKind` could admit — a prim/literal/type-var leaf, or a prim-element
// list. A composite leaf (struct, map, closure, nested list) always renders to a `-1`-kind
// atom, so the whole union declines here, structurally, before `collectRetAtoms` renders anything — a recursive struct's render is exponential in the depth cap and must never run.
function retAtomsCheap(er: i32) {
  if er < 0 { return true }
  const t = T.tys[er]
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if !retAtomsCheap(t.uMembers[i]) { return false }
      i = i + 1
    }
    return true
  }
  if t is TyNullable { return retAtomsCheap(t.nInner) }
  if t is TyPrim { return true }
  if t is TyLit { return true }
  if t is TyVar { return true }
  if t is TyErr { return true }
  if t is TyArray {
    // Only a prim-element list renders short AND can classify (`i32[]`, `string[]`);
    // a composite-element list (`S[]`, `i32[][]`) renders big and always declines.
    if t.aElem < 0 { return true }
    const et = T.tys[t.aElem]
    return et is TyPrim
  }
  false
}

// The value-atom kind of one leaf of an inferred return type — the structural dual of
// `valueAtomKind(tyToStr(leaf))`, read off the arena instead of a rendering. Only two leaf
// shapes classify: a primitive (its own `primName` identity) and a prim-element list. Every
// other leaf renders to a name `valueAtomKind` rejects, so it is -1 here.
function retAtomKindOf(er: i32) {
  if er < 0 { return -1 }
  const t = T.tys[er]
  if t is TyPrim { return valueAtomKind(t.primName) }
  if t is TyArray {
    if t.aElem < 0 { return -1 }
    const et = T.tys[t.aElem]
    if et is TyPrim {
      const en = et.primName
      // `i32[]` / `boolean[]` are matched by exact name AHEAD of `valueAtomKind`'s
      // litunion-array arm; the other list atoms sit BEHIND it, so a declared litunion
      // alias spelled like a primitive would claim them — ask the same question here.
      if en == "i32" || en == "boolean" { return 7 }
      if nameIsLitUnionType(en) { return 7 }
      if en == "f64" { return 8 }
      if en == "string" { return 9 }
      if en == "i64" { return 10 }
      if en == "f32" { return 12 }
    }
    return -1
  }
  if t is TyVar {
    // An inference hole renders `any` — never an atom; a declared type param carries its
    // own source name, which classifies exactly as the rendered atom would.
    if t.tvName.length > 0 {
      if t.tvName[0] == '?' { return -1 }
    }
    return valueAtomKind(t.tvName)
  }
  -1
}

// Push the value-atom KIND of every leaf of `er`, in `collectRetAtoms` order — `6` (the
// `null` atom) for a nullable slot. The kind-valued dual of `collectRetAtoms`: same walk,
// same order, no strings built.
function collectRetAtomKinds(er: i32, out: i32[]) {
  if er < 0 { return 0 }
  const t = T.tys[er]
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      collectRetAtomKinds(t.uMembers[i], out)
      i = i + 1
    }
  } else if t is TyNullable {
    collectRetAtomKinds(t.nInner, out)
    out.push(6)
  } else {
    out.push(retAtomKindOf(er))
  }
  0
}

// —— the print gate's boxing question, with the literal softening applied ————————
// The value-atom kind of one leaf for the print gate: `retAtomKindOf`, plus the literal arm
// it deliberately lacks. A literal member softens to its base scalar in the name the emitter
// keys on, so a classifier answering -1 for a literal would call boxed a union the emitter does box; `retAtomKindOf` itself must not learn this arm, since it also feeds `valueUnionRetName`.
function printAtomKindOf(er: i32) {
  if er < 0 { return -1 }
  const t = T.tys[er]
  if t is TyLit { return retAtomKindOf(litBaseTy(t)) }
  retAtomKindOf(er)
}

// Pushes the print-gate kind of every leaf of `er`, in `collectRetAtomKinds` order, with the
// scalar-prim dedup `canonEmitName` performs on the softened name — `"a" | string` is one atom
// (both soften to `string`), `"a" | 1` is two. Only kinds 0-5 dedup; the list kinds
// deliberately share one code and collapsing there would fold a genuine two-arm union into one.
function collectPrintAtomKinds(er: i32, out: i32[]) {
  if er < 0 { return 0 }
  const t = T.tys[er]
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      collectPrintAtomKinds(t.uMembers[i], out)
      i = i + 1
    }
  } else if t is TyNullable {
    collectPrintAtomKinds(t.nInner, out)
    out.push(6)
  } else {
    const k = printAtomKindOf(er)
    if k >= 0 && k <= 5 {
      let j = 0
      while j < out.length {
        if out[j] == k { return 0 }
        j = j + 1
      }
    }
    out.push(k)
  }
  0
}

// Scratch for the print-gate leaf scan — module level like `vuAtomKinds`, drained by its
// only consumer.
const pgAtomKinds: i32[] = []

// Whether `print(x)` would be handed the emitter's boxed value-union rep (`uBoxIdx`), which
// `print` cannot lower. Strictly wider than `valueUnionRetName(pt) != ""` on literal-bearing
// unions only: with no literal leaf the softening and dedup are no-ops, so every union that
// gate claimed is still claimed; this adds the unions whose members the emitter softens.
function tyPrintsAsUnionBox(pt: i32) {
  if pt < 0 { return false }
  // Decline a union with any composite leaf WITHOUT rendering it, exactly as
  // `valueUnionRetName` does — the render of a recursive struct leaf is exponential.
  if !retAtomsCheap(pt) { return false }
  collectPrintAtomKinds(pt, pgAtomKinds)
  const ok = valueUnionFromAtomKinds(pgAtomKinds)
  while pgAtomKinds.length > 0 { pgAtomKinds.pop() }
  ok
}

// Whether every arm of the boxed value union `pt` is a value `print` renders on its own —
// will the emitter's per-arm tag dispatch claim it? Reads the same leaves off the arena as
// the emitter's box row does, through `printAtomKindOf`, arm for arm; a declared literal-union
// alias arm is walked into like any member. Depth-bounded like `tyPrintsAsRef`.
function tyPrintUnionArmsInDomain(pt: i32, depth: i32): boolean {
  if pt < 0 { return false }
  if depth <= 0 { return false }
  const t = T.tys[pt]
  if t is TyNullable { return tyPrintUnionArmsInDomain(t.nInner, depth - 1) }
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if !tyPrintUnionArmsInDomain(t.uMembers[i], depth - 1) { return false }
      i = i + 1
    }
    return true
  }
  const k = printAtomKindOf(pt)
  k >= 0 && k <= 6
}

// The BOXED-value-union refusal that survives the dispatch: a union the emitter boxes whose
// arms it cannot all print. Empty when the program is fine.
function printUnionRefusal(pt: i32): string {
  if !tyPrintsAsUnionBox(pt) { return "" }
  if tyPrintUnionArmsInDomain(pt, 24) { return "" }
  "print of a union value (" +
    tyToStr(pt) +
    ") is type-valid but not yet supported by codegen — narrow it first, e.g. `if v is i32 { print(v) }`"
}

// `print`'s DOMAIN, spelled once. `driver.builtinScan` renders the LSP completion detail
// from this (`(<domain>) => void`) and `tyPrintsAsRef`'s refusal quotes it, so the type the
// compiler advertises and the type it enforces cannot drift into two answers — which is
// what the hand-written completion string next to a hand-written message invited.
export function printDomainStr(): string {
  "i32 | i64 | f32 | f64 | boolean | string"
}

// The domain refusal `tyPrintsAsRef` raises, written once so the direct spelling and the
// generic pin cannot say it differently. Named type first (the subject the reader wrote),
// then the domain, then the workaround after an em dash — `tErrUnsupported`'s message
// convention, on a plain `tErr` channel now.
function printRefRefusal(pt: i32): string {
  "print expects one scalar or string value (" +
    printDomainStr() +
    "), got " +
    tyToStr(pt) +
    " — print the elements or fields individually, e.g. `print(xs[0])`"
}

// Whether `x` is outside `print`'s domain by being a WasmGC reference: an array, a struct, a
// map/set, a function value, a union carrying one of those, and any of them behind `| null`.
// A domain rule, not a lowering gap (D711): the language has never defined how a container
// renders, not merely failed to implement it yet. A `TyVar` answers false since it has no rep yet; `validatePrintCstrs` asks again at the pin (D401).
function tyPrintsAsRef(pt: i32, depth: i32) {
  if pt < 0 { return false }
  if depth <= 0 { return false }
  const t = T.tys[pt]
  if t is TyArray { return true }
  if t is TyObj { return true }
  if t is TyMap { return true }
  if t is TyFunc { return true }
  if t is TyNullable { return tyPrintsAsRef(t.nInner, depth - 1) }
  if t is TyUnion {
    const ms = t.uMembers
    let i = 0
    while i < ms.length {
      if tyPrintsAsRef(ms[i], depth - 1) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// `isValueUnionName`'s verdict over an already-classified atom-kind sequence: 2+ atoms,
// every atom a value atom, and either 2+ non-null atoms or exactly one NUMERIC scalar
// beside `null` (a boolean/ref + null stays a niche, not a box).
function valueUnionFromAtomKinds(kinds: i32[]) {
  if kinds.length < 2 { return false }
  let nonNull = 0
  let hasNull = false
  let soloKind = -1
  let i = 0
  while i < kinds.length {
    const k = kinds[i]
    if k < 0 { return false }
    if k == 6 {
      hasNull = true
    } else {
      nonNull = nonNull + 1
      soloKind = k
    }
    i = i + 1
  }
  if nonNull >= 2 { return true }
  if nonNull == 1 && hasNull {
    return soloKind == 0 || soloKind == 3 || soloKind == 4 || soloKind == 5
  }
  false
}

// Scratch for the leaf-kind scan — module level (like `tyEqAStack`) so the checker's
// hottest decline path allocates nothing; drained by its only consumer.
const vuAtomKinds: i32[] = []

// Whether the inferred return `er` is a value union the emitter boxes — the structural dual
// of `isValueUnionName(<er's joined atom render>)`, decided from the arena before anything
// is rendered. The join is transparent: under `retAtomsCheap` every admitted leaf renders to
// a single top-level atom, so the name's `splitUnionAtoms` atoms are exactly this walk's leaves.
function tyIsValueUnion(er: i32) {
  collectRetAtomKinds(er, vuAtomKinds)
  const ok = valueUnionFromAtomKinds(vuAtomKinds)
  while vuAtomKinds.length > 0 { vuAtomKinds.pop() }
  ok
}

// The emitter-format union name (`i32|string`, `i32|null`) for an inferred return type `er`
// if it is a value union the emitter can box (≥2 non-null value atoms, or one numeric scalar
// + null), else "". Drives `registerValueUnionName`, the `"union"` return kind, and
// `emitUnionCoerce` at the return site, exactly like the annotated path — built only for unions that are value unions, to avoid a render-join-resplit of every non-union return.
function valueUnionRetName(er: i32) {
  if er < 0 { return "" }
  // Decline a union with any composite leaf WITHOUT rendering it (`retAtomsCheap`) —
  // its atom cannot classify anyway, and the render of a recursive struct leaf is
  // exponential in the `tyToStr` depth cap.
  if !retAtomsCheap(er) { return "" }
  if !tyIsValueUnion(er) { return "" }
  const atoms: string[] = []
  collectRetAtoms(er, atoms)
  let nm = ""
  let i = 0
  while i < atoms.length {
    if i > 0 { nm = nm + "|" }
    nm = nm + atoms[i]
    i = i + 1
  }
  // One atom per LEAF, exactly: `tyIsValueUnion`'s own invariant is that under
  // `retAtomsCheap` every admitted leaf renders to a single top-level atom (no `|`, no
  // `=>`, balanced groupers), so the join's width is the leaf count. (#1115.)
  irAtoms(nm, atoms.length)
}

// Whether union `er` has a litunion-array member (`K0[]`, `("a"|"b")[]`) — the arm
// `litUnionArrayValueUnionRetName` exists for, decided from the arena instead of from
// `litUnionArrayElemOf` over a rendered member name.
function tyUnionHasLitUnionArrayMember(er: i32) {
  if er < 0 { return false }
  const t = T.tys[er]
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      const m = T.tys[t.uMembers[i]]
      if m is TyArray {
        if tyIsLitUnion(m.aElem) { return true }
      }
      i = i + 1
    }
  }
  false
}

// The emitter-format union name (`K0[]|i64`) for an inferred return `er` that is a value
// union with a litunion-array member and a scalar sibling. `valueUnionRetName` declines
// because rendering the array member flattens its litunion element, but `K0[]` is a value
// atom and boxes like `i32[] | i64`, so this renders each member with `tyToEmitName` instead.
function litUnionArrayValueUnionRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if !(t is TyUnion) { return "" }
  const members = t.uMembers
  if members.length < 2 { return "" }
  // No litunion-array member, no name to build: decline from the arena before the per-member
  // `tyToEmitName` render. The loop below still recomputes `hasLitArr` as the actual verdict.
  if !tyUnionHasLitUnionArrayMember(er) { return "" }
  let hasLitArr = false
  let name = ""
  // A member's render can be wider than one atom (`tyToEmitName`'s nullable arm spells
  // `X|null`), so the join width is the sum of member widths, not the member count (#1115).
  let psum = 0
  let i = 0
  while i < members.length {
    const mn = tyToEmitName(members[i])
    const mw = tyNameAtoms
    if mn == "" { return "" }
    if litUnionArrayElemOf(mn) != "" { hasLitArr = true }
    if i > 0 { name = name + "|" }
    name = name + mn
    psum = psum + mw
    i = i + 1
  }
  if !hasLitArr { return "" }
  if isValueUnionName(name) { return irAtoms(name, psum) }
  ""
}

// The nominal type name for object type `ty`, found by structural (bidirectional
// `assignable`) match against the program's declared types — not by arena-index identity
// like `structNameOfTy`, which answers "" for an inline shape that merely equals a declared
// struct. This is the equality the emitter's variant tables are built under.
export function nominalStructNameOfTy(ty: i32): string {
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyObj { return nominalNameOfObj(ty, gRootStmts) }
  ""
}

// The declared type name whose shape structurally equals object type `obj`, found by
// scanning the program's `TypeDecl`s (`cUserTypes` is a `Map` the compiler subset cannot
// iterate). Structural equality is bidirectional assignability, so a 1-field `{meow}` does
// not match a 2-field `Cat = {meow, foo}`. "" if no named type matches.
function nominalNameOfObj(obj: i32, stmts: i32[]) {
  let i = 0
  while i < stmts.length {
    const s = P.nodes[stmts[i]]
    if s is TypeDecl {
      const nm = s.tdName
      const nmHit = cUserTypes[nm]
      if nmHit is i32 {
        const ti = nmHit
        if ti >= 0 {
          const tt = T.tys[ti]
          if tt is TyObj {
            if assignable(obj, ti) && assignable(ti, obj) { return nm }
          }
        }
      }
    }
    i = i + 1
  }
  ""
}

// The emitter-format name of an inferred struct-union return `er` — `Cat|Dog`, each member
// reverse-mapped (`nominalNameOfObj`) to its user-type name. The emitter's union machinery is
// keyed on these nominal names, not `tyToStr`'s structural render. "" unless `er` is an
// all-object union of two or more members that all resolve to a named type.
function structUnionRetName(er: i32, stmts: i32[]) {
  if er < 0 { return "" }
  if !isStructUnionTy(er) { return "" }
  const t = T.tys[er]
  if t is TyUnion {
    const members = t.uMembers
    let name = ""
    let i = 0
    while i < members.length {
      const nm = nominalNameOfObj(members[i], stmts)
      if nm == "" { return "" }
      if i > 0 { name = name + "|" }
      name = name + nm
      i = i + 1
    }
    // Every member is a declared type name — one identifier, one atom — so the join width
    // is the member count (#1115).
    return irAtoms(name, members.length)
  }
  ""
}

// Whether nullable-inner type `it` is an array of a plain `i32`/`boolean` element — the
// `T[] | null` shape that reps as the `nullist` niche and carries the `>o` value-call result
// token. A distinct-backing leaf (`i64`/`f64`/`f32`/`string`) is not this, and a litunion
// element is excluded because its lambda adoption still mis-keys the sig producers.
function tyIsNulI32BackedListInner(itIx: i32) {
  if itIx < 0 { return false }
  const it = T.tys[itIx]
  if it is TyArray {
    if it.aElem < 0 { return false }
    const el = T.tys[it.aElem]
    if el is TyPrim { return el.primName == "i32" || el.primName == "boolean" }
    // A niche-nullable boolean element (`(boolean | null)[] | null`) rides its null in the
    // shared i32 sentinel, so it keeps the same backing and this recognizes it too.
    if el is TyNullable {
      if el.nInner < 0 || el.nInner >= T.tys.length { return false }
      const ei = T.tys[el.nInner]
      if ei is TyPrim { return ei.primName == "boolean" }
    }
  }
  false
}

// The emitter-format name of an inferred nullable-ref return `er` — `P | null` (the struct
// inner reverse-mapped to its user-type name) or `string | null`. `synthRetAnnots` pins a
// nullable-returning closure to this so its `$fnsig` result keys the nullable token and the
// value call's `ref.cast` resolves. "" unless `er` is a nullable whose inner the emitter lowers.
function nullableRetName(er: i32, stmts: i32[]) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyNullable {
    if t.nInner < 0 || t.nInner >= T.tys.length { return "" }
    const it = T.tys[t.nInner]
    if it is TyObj {
      const nm = nominalNameOfObj(t.nInner, stmts)
      // Non-spaced (`P|null`) — the emitter's internal convention (`nullablePartOf`), not the
      // spaced `tyToStr` render. A declared name is one atom, `null` the second (#1115).
      if nm != "" { return irAtoms(nm + "|null", 2) }
      // An inline shape with no matching `TypeDecl` renders as emitter-format shape text, so
      // `structIndexOfTypeName` resolves it by field set to the struct index the annotation keys.
      const inm = tyToEmitName(t.nInner)
      // The enclosing `it is TyObj` arm already rules out a map, so testing whether the render
      // came back at all is enough — no need to re-parse it for shape-openness.
      if inm != "" {
        // The `{…}` shape's separators all sit inside the braces (the renderer reports
        // its own width); `null` adds one atom (#1115).
        return irAtoms(inm + "|null", tyNameAtoms + 1)
      }
    } else if it is TyFunc {
      // A nullable-closure return (kind 19): the fat-pointer made nullable, rendered
      // parenthesized and non-spaced so `nullablePartOf` recognizes it (`((i32)=>K0)|null`).
      let ips = ""
      const pts = it.fnParamTypes
      let pj = 0
      while pj < pts.length {
        const pn = tyToEmitName(pts[pj])
        if pn == "" { return "" }
        if pj > 0 { ips = ips + "," }
        ips = ips + pn
        pj = pj + 1
      }
      let irs = litUnionAliasNameOfTy(it.fnRet)
      if irs == "" { irs = tyToEmitName(it.fnRet) }
      // The grouped closure is one atom (its separators and its `=>` sit inside the parens);
      // `null` is the second (#1115).
      if irs != "" { return irAtoms("((" + ips + ")=>" + irs + ")|null", 2) }
    } else if tyIsNulI32BackedListInner(t.nInner) {
      // The nullable i32-backed list (kind 15) reps as the shared list wrapper made nullable;
      // rendered non-spaced so `nullablePartOf` and `synthRetAnnots`'s pin both recognize it.
      const lnm = tyToEmitName(t.nInner)
      return irAtoms(lnm + "|null", tyNameAtoms + 1)
    } else if it is TyMap {
      // The nullable map (kind 3 struct made nullable) admits any string-keyed non-`Set` map,
      // not just the mono i32-valued shape (D956) — resolved through `inferredRetMapSlot`.
      let mapOk = false
      if it.mSet == 0 { mapOk = tyIsPrimNamed(it.mKey, "string") }
      const mnm = tyToEmitName(t.nInner)
      if mapOk && mnm != "" { return irAtoms(mnm + "|null", tyNameAtoms + 1) }
    } else if tyIsPrimNamed(t.nInner, "string") {
      return irAtoms("string|null", 2)
    } else if tyIsPrimNamed(t.nInner, "boolean") {
      // The boolean niche (`boolean | null`): the i32 sentinel rep (2 = null), matching what
      // `emitReturnValue`'s `tyIsNulBool` arm expects for a `return null` / `return <bool>`.
      return irAtoms("boolean|null", 2)
    }
  }
  ""
}

// D1062 — the emitter-format name of an inferred nullable-list return `er`: a `TyNullable`
// whose inner is an array of any element type. Rendered non-spaced so `nullablePartOf`
// recognizes it. A separate producer from `nullableRetName`'s i32-backed arm — that one also
// serves the lambda pin and must match the value-call token; this one serves only the named-fn pin.
function nulListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyNullable {
    if t.nInner < 0 || t.nInner >= T.tys.length { return "" }
    const it = T.tys[t.nInner]
    if it is TyArray {
      const lnm = tyToEmitName(t.nInner)
      // The array's separators sit inside its element render; `null` adds one atom (#1115).
      if lnm != "" { return irAtoms(lnm + "|null", tyNameAtoms + 1) }
    }
  }
  ""
}

// The emitter-format name of an inferred nullable-litunion return `er` (`() => K0 | null`):
// niched as the i32 atom with `-1` = null, so `synthRetAnnots` routes an anonymous lambda
// through the same rep the annotated form lowers. Renders the litunion by its alias; an
// alias-less inline litunion has no name and stays "". "" for any non-nullable-litunion.
function nulLitUnionRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyNullable {
    const alias = litUnionAliasNameOfTy(t.nInner)
    // An alias identifier plus the `null` arm — two atoms (#1115).
    if alias != "" { return irAtoms(alias + "|null", 2) }
  }
  ""
}

// The emitter-format name of an inferred element-nullable list return `er` — `(f64|null)[]`
// etc: a `TyArray` whose element is a nullable numeric scalar. Elements are value-union
// `{tag, payload}` boxes, the same rep the annotated return uses, so `synthRetAnnots` can pin
// a lambda to it. "" unless `er` is such an array (a struct/string/boolean element differs).
function nulElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    // The hole declines here (`tyArrayElemIx`): an un-annotated lambda returning a bare `[]`
    // reached this ladder with element index `-1`, an out-of-bounds `array.get`.
    const ei = tyArrayElemIx(er)
    if ei < 0 { return "" }
    const et = T.tys[ei]
    if et is TyNullable {
      // The inner's primitive name is read off the arena (`tyPrimNameOf`) rather than a
      // `tyToStr` render — the decision here is structural, the name only spells the payload.
      const inner = tyPrimNameOf(et.nInner)
      if inner == "f64" || inner == "i32" || inner == "i64" || inner == "f32" {
        // The box leg — a value union, claimed by `synthRetAnnots`'s arm 4.
        return irAtomsRung(
          "(" + primNameStr(inner) + "|null)[]",
          1,
          IR_RUNG_NUL_ELEM_LIST,
        )
      }
      // The niche leaves — `(boolean|null)[]`, `(string|null)[]`, `(K|null)[]` — each ride an
      // existing non-box list rep the annotated return already lowers.
      if inner == "boolean" || inner == "string" {
        // A niche leg: arm 4's `nameIsNulBool`/`nameIsNulString` guards reject these and no
        // later arm claims them, so they are recorded and left unpinned.
        return irAtomsRung(
          "(" + primNameStr(inner) + "|null)[]",
          1,
          IR_RUNG_NUL_ELEM_LIST_NICHE,
        )
      }
      const alias = litUnionAliasNameOfTy(et.nInner)
      if alias != "" {
        // The third leg, and a niche for the same reason (`nameIsNulLitUnion`).
        return irAtomsRung(
          "(" + alias + "|null)[]",
          1,
          IR_RUNG_NUL_ELEM_LIST_NICHE,
        )
      }
    }
  }
  ""
}

// The emitter-format name of a nullable-closure-element list return `er` —
// `(((i32)=>K0)|null)[]`: a `TyArray` whose element is a nullable function type. Elements are
// the kind-5 niche over the shared closure fat-pointer, rendered through `nullableRetName`'s
// `TyFunc` arm so a litunion result keeps its alias. "" otherwise.
function nulClosureElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyNullable {
      if et.nInner < 0 || et.nInner >= T.tys.length { return "" }
      const it = T.tys[et.nInner]
      if it is TyFunc {
        const en = nullableRetName(t.aElem, gRootStmts)
        if en != "" { return irAtoms("(" + en + ")[]", 1) }
      }
    }
  }
  ""
}

// The emitter-format name of a distinct-backing scalar-leaf list return `er` — `i64[]`,
// `f64[]`, `f32[]`: a `TyArray` whose element has its own list backing. `synthRetAnnots` pins
// a lambda to it so the body literal builds the leaf's wrapper and the value-call index finds
// it collected. An `i32[]`/`boolean[]`/`string[]`/litunion element is excluded (shared backing).
function scalarLeafListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyPrim {
      const pn = et.primName
      if pn == "i64" || pn == "f64" || pn == "f32" { return pn + "[]" }
    }
  }
  ""
}

// The emitter-format name of a litunion-alias-element list return `er` — `K0[]`: the adoption
// gate for a member-literal-bodied lambda. `synthRetAnnots` pins the lambda's `fnRet` to it so
// the body literal builds the i32 atom list instead of self-classifying a string list into the
// i32-list functype result (invalid wasm). An alias-less inline litunion element declines.
function litUnionElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    if tyIsLitUnion(t.aElem) {
      const an = litUnionAliasNameOfTy(t.aElem)
      if an != "" { return irAtoms(an + "[]", 1) }
    }
  }
  ""
}

// The emitter-format name of a struct-element list return `er` (`{f: f32}[]`) whose fields
// are all plainly lowerable (a scalar/string/boolean prim, or a litunion alias) — the shape
// the named-function spelling already round-trips, so a lambda may adopt it. A map/union/
// nullable/list/closure/nested-struct field is not this (those stay loud rejects). "" otherwise.
function structElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyObj {
      if !structElemFieldsPlain(t.aElem, 4) { return "" }
      return irRendered(tyToEmitName(er))
    }
  }
  ""
}

// The emitter-format name of a nullable-struct-element list return `er` —
// `({a: string, f: i32, z: boolean} | null)[]`: elements are the kind-1 struct niche, the
// same rep the annotated named-function-value spelling already lowers, so `synthRetAnnots`
// can pin a lambda to it. The nullable-struct sibling of `nulElemListRetName`. "" otherwise.
function nulStructElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyNullable {
      if et.nInner < 0 || et.nInner >= T.tys.length { return "" }
      const it = T.tys[et.nInner]
      if it is TyObj {
        // A boxed-union-field element isn't `structElemFieldsPlain`, but the annotated form
        // lowers it too — admit it when `structFieldBoxRetName` proves every field lowerable.
        if !structElemFieldsPlain(et.nInner, 4) {
          if structFieldBoxRetName(et.nInner) == "" { return "" }
        }
        return irRendered(tyToEmitName(er))
      }
    }
  }
  ""
}

// The emitter-format name of a nullable-map-element list return `er` —
// `({[string]: boolean} | null)[]`: elements are the kind-3 map struct made nullable, the
// same rep the annotated named-function-value spelling already lowers, so `synthRetAnnots`
// can pin a lambda to it. The nullable-map sibling of `nulStructElemListRetName`. "" otherwise.
function nulMapElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyNullable {
      if et.nInner < 0 || et.nInner >= T.tys.length { return "" }
      const it = T.tys[et.nInner]
      if it is TyMap { return irRendered(tyToEmitName(er)) }
    }
  }
  ""
}

// The emitter-format name of a nullable-scalar-list-element list return `er` —
// `(f64[] | null)[]`: elements are the inner list's wrapper kept nullable, the rep the
// annotated spelling already lowers, so `synthRetAnnots` can pin a lambda to it. A box-element
// inner list admits too (below); a nested or other composite-element inner list stays declined.
function nulListElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyNullable {
      if et.nInner < 0 || et.nInner >= T.tys.length { return "" }
      const it = T.tys[et.nInner]
      if it is TyArray {
        if it.aElem < 0 { return "" }
        const lt = T.tys[it.aElem]
        if lt is TyPrim { return irRendered(tyToEmitName(er)) }
        // A box-element inner list (`((i32|boolean)[] | null)[]`) rides the union box too — its
        // wrapper made nullable — so admit it the same way as the scalar-leaf arm above.
        if elemValueUnionListRetName(et.nInner) != "" {
          return irRendered(tyToEmitName(er))
        }
        if elemVariantBoxListRetName(et.nInner) != "" {
          return irRendered(tyToEmitName(er))
        }
      }
    }
  }
  ""
}

// The canonical emitter name for a plain struct inferred return (`{f: f32}`) whose fields
// all pass `structElemFieldsPlain` — the bare-struct sibling of `structElemListRetName`,
// feeding the recorder's `spfNm` canon record so `synthRetAnnots`'s whole-span-shape arm
// pins the lambda.
function structPlainRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if !(t is TyObj) { return "" }
  if !structElemFieldsPlain(er, 4) { return "" }
  irRendered(tyToEmitName(er))
}

// The field gate for `structElemListRetName`: every field is a scalar/string/boolean prim, a
// litunion alias, or (recursively) a nested plain struct. The nested-struct admission is
// load-bearing — an un-pinned lambda self-resolves each element by field-name set, and a
// same-fieldset twin type in scope can box the wrong row as invalid wasm without this gate.
function structElemFieldsPlain(objTy: i32, depth: i32): boolean {
  if depth <= 0 { return false }
  const et = T.tys[objTy]
  if !(et is TyObj) { return false }
  let i = 0
  while i < et.objFieldTypes.length {
    const fty = et.objFieldTypes[i]
    if fty < 0 { return false }
    const ft = T.tys[fty]
    let ok = false
    if ft is TyPrim { ok = true }
    if tyIsLitUnion(fty) { ok = true }
    if ft is TyObj {
      if structElemFieldsPlain(fty, depth - 1) { ok = true }
    }
    // A map field admits when its value is emit-representable — the annotated form lowers a
    // string-keyed map field, and un-admitted the whole struct loses the canon record.
    if ft is TyMap {
      if tyIsEmitRepresentable(fty) { ok = true }
    }
    // A closure field admits the same way (emit-representable), for the same reason: without
    // it, a sibling composite field on an un-pinned struct can mis-code as invalid wasm.
    if ft is TyFunc {
      if tyIsEmitRepresentable(fty) { ok = true }
    }
    if ft is TyArray {
      // A plain-struct-element list field (`f: {...}[]`) admits recursively, using the same
      // annotated-form argument as the outer element — checked only after `feIx >= 0`.
      const feIx = tyArrayElemIx(fty)
      if feIx >= 0 {
        const aet = T.tys[feIx]
        if aet is TyPrim { ok = true }
        if !ok {
          if tyIsLitUnion(feIx) { ok = true }
          if aet is TyObj {
            if structElemFieldsPlain(feIx, depth - 1) { ok = true }
          }
          // A box-element-union list field (`f: (i64|string|{q:i64})[]`) rides the same union
          // box as a bare `(...)[]` return, so it admits through the same two predicates.
          if !ok {
            if elemValueUnionListRetName(fty) != "" { ok = true }
            if !ok && elemVariantBoxListRetName(fty) != "" { ok = true }
          }
          // A map-element list field admits when its value is emit-representable — the kind-3
          // map-element ref-list rep the annotated form already lowers.
          if !ok && aet is TyMap {
            if tyIsEmitRepresentable(ft.aElem) { ok = true }
          }
        }
      }
    }
    if !ok { return false }
    i = i + 1
  }
  true
}

// The emitter-format name of a map-element list return `er` — `{[string]: f32}[]`: elements
// are a string-keyed map, the same kind-3 ref-list rep the annotated form lowers, so
// `synthRetAnnots` can pin a lambda's `fnRet` to it. A map value the emitter cannot lower
// keeps rejecting loudly on the annotated path itself. "" otherwise.
function mapElemListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyMap { return irRendered(tyToEmitName(er)) }
  }
  ""
}

// The emitter-format name of an inferred element-value-union list return `er` —
// `(i64|boolean)[]`: elements are value-union `{tag, payload}` boxes, the same rep the
// annotated form lowers, so `synthRetAnnots` can pin a lambda to it. The value-union sibling
// of `nulElemListRetName` (which owns the `(scalar|null)[]` niche). "" otherwise.
function elemValueUnionListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    // `tyIsValueUnion` is the structural dual of `isValueUnionName` over the joined atom
    // render, decided from the arena before anything is rendered.
    if tyIsValueUnion(t.aElem) { return irRendered(tyToEmitName(er)) }
  }
  ""
}

// The emitter-format name of an inferred element-variant-box-union list return `er` —
// `({a:boolean,...}|i64)[]`: elements are `variantBoxUnionRetName`'s `{tag, payload}` boxes,
// the same rep the annotated form lowers, so `synthRetAnnots` can pin a lambda to it. The
// variant-box sibling of `elemValueUnionListRetName`. "" otherwise.
function elemVariantBoxListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const en = variantBoxUnionRetName(t.aElem)
    if en != "" { return irAtoms("(" + en + ")[]", 1) }
  }
  ""
}

// The emitter-format name of an inferred element-map-union list return `er` —
// `({[string]: string} | f64)[]`: elements are `mapUnionRetName`'s `{tag, payload}` boxes,
// the same rep the annotated form lowers. The map-union sibling of
// `elemVariantBoxListRetName` (which declines map members). "" otherwise.
function elemMapUnionListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const en = mapUnionRetName(t.aElem)
    if en != "" { return irAtoms("(" + en + ")[]", 1) }
  }
  ""
}

// The emitter-format name of an inferred element-refarm-value-union list return `er` —
// `((i32|boolean)[] | i32)[]`: a union mixing a box-list-element array arm with scalar
// siblings, both boxed as `{tag, payload}` — the rep the annotated form lowers, so
// `synthRetAnnots` can pin a lambda to it. The array-arm sibling of `elemValueUnionListRetName`.
function elemRefArmValueUnionListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if !(t is TyArray) { return "" }
  if t.aElem < 0 { return "" }
  const et = T.tys[t.aElem]
  if !(et is TyUnion) { return "" }
  const members = et.uMembers
  if members.length < 2 { return "" }
  let hasArr = false
  let mi = 0
  while mi < members.length {
    const m = T.tys[members[mi]]
    if m is TyArray {
      // The array arm must itself render as a box-list element (a value union, or a
      // variant-box union) — a niche or map/closure element is not this family.
      const eln = tyToEmitName(m.aElem)
      if eln == "" { return "" }
      if !isValueUnionName(eln) && variantBoxUnionRetName(m.aElem) == "" {
        return ""
      }
      hasArr = true
    } else if m is TyPrim {
      // A scalar-prim sibling boxes as a value atom (`i32`) — fine.
    } else {
      // A struct / map / closure / nested-array sibling widens the family beyond the sound
      // annotated box; decline so those stay on their established routes.
      return ""
    }
    mi = mi + 1
  }
  if !hasArr { return "" }
  irRendered(tyToEmitName(er))
}

// The emitter-format name of an inferred nested (2-D+) union-element array return `er` —
// `(i64 | boolean)[][]`: an array whose innermost 1-D leaf is a recognized box-element list
// (value-union / variant-box / map-union). Elements bottom out at the same `{tag, payload}`
// box the annotated form lowers, so `synthRetAnnots` can pin a lambda to it.
function nestedElemUnionListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if !(t is TyArray) { return "" }
  if t.aElem < 0 { return "" }
  const inner = T.tys[t.aElem]
  if !(inner is TyArray) { return "" }
  // Peel to the innermost (leaf) 1-D array.
  let leafArr = t.aElem
  let done = false
  while !done {
    const la = T.tys[leafArr]
    if la is TyArray {
      if la.aElem < 0 { return "" }
      const le = T.tys[la.aElem]
      if le is TyArray { leafArr = la.aElem } else { done = true }
    } else {
      done = true
    }
  }
  if (
    elemValueUnionListRetName(leafArr) != "" ||
    elemVariantBoxListRetName(leafArr) != "" ||
    elemMapUnionListRetName(leafArr) != ""
  ) {
    return irRendered(tyToEmitName(er))
  }
  ""
}

// The emitter-format name of a closure-arm value union return `er` (`(()=>string)|i64`): a
// union mixing at least one function-type member with scalar prims. A closure member is the
// kind-11 ref atom; the render preserves a litunion result's alias so the inner value call's
// `$fnsig` token agrees. "" for any other shape.
function cloArmValueUnionRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  // A nullable closure-arm value union normalizes to `TyNullable` over the union — the box
  // already carries a null member atom, so render the inner union and append `|null`.
  if t is TyNullable {
    const inner = cloArmValueUnionRetName(t.nInner)
    // The inner union keeps its own top-level `|`s, so `null` adds one atom to the width
    // the recursion just reported (#1115).
    if inner != "" { return irAtoms(inner + "|null", inferRetNameAtoms + 1) }
    return ""
  }
  if t is TyUnion {
    const members = t.uMembers
    if members.length < 2 { return "" }
    let hasClo = false
    let name = ""
    let i = 0
    while i < members.length {
      const m = T.tys[members[i]]
      let mn = ""
      if m is TyFunc {
        let ips = ""
        const pts = m.fnParamTypes
        let pj = 0
        while pj < pts.length {
          const pn = tyToEmitName(pts[pj])
          if pn == "" { return "" }
          if pj > 0 { ips = ips + "," }
          ips = ips + pn
          pj = pj + 1
        }
        let irs = litUnionAliasNameOfTy(m.fnRet)
        if irs == "" { irs = tyToEmitName(m.fnRet) }
        if irs == "" { return "" }
        mn = "((" + ips + ")=>" + irs + ")"
        hasClo = true
      } else if m is TyPrim {
        mn = m.primName
      } else {
        return ""
      }
      if i > 0 { name = name + "|" }
      name = name + mn
      i = i + 1
    }
    if !hasClo { return "" }
    // Every member render is ONE atom — a prim's own name, or a closure PARENTHESIZED
    // (which puts its separators and its `=>` inside a grouper) — so the join's width is
    // the member count (#1115).
    if isValueUnionName(name) { return irAtoms(name, members.length) }
  }
  ""
}

// The emitter-format name of an inferred nested-list return `er` with a scalar/string leaf —
// `i64[][]`, `string[][]`, or deeper. `synthRetAnnots` pins a lambda's `fnRet` to this so the
// body literal builds under the return-position seed instead of self-classifying an i32
// default. An `i32[][]`/`boolean[][]` leaf is excluded (already agrees with no pin needed).
function nestedLeafListRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = T.tys[t.aElem]
    if et is TyArray {
      if et.aElem < 0 { return "" }
      const lt = T.tys[et.aElem]
      if lt is TyPrim {
        const pn = lt.primName
        if pn == "i64" || pn == "f64" || pn == "f32" || pn == "string" {
          return irRendered(tyToEmitName(er))
        }
        return ""
      }
      if lt is TyArray {
        // Deeper nesting: the leaf decides — recurse on the inner array.
        if nestedLeafListRetName(t.aElem) != "" {
          return irRendered(tyToEmitName(er))
        }
      }
    }
  }
  ""
}

// The emitter-format name of an inferred map-member union return `er` (`{[string]:f32}|{w:i32}`):
// a union with at least one map member and every member a map, object or scalar/string prim.
// Rendered in the emitter's map-first vocabulary (`nameIsMap`) so `synthRetAnnots` can pin a
// lambda to it, routing it through `registerInlineUnion`'s box path. "" for any other shape.
function mapUnionRetName(er: i32) {
  if er < 0 { return "" }
  // A nullable map-member union unwraps to its inner union for the member gate; the final
  // render still uses the original (possibly-nullable) `er`, keeping the `|null` spelling.
  let uIx = er
  const tn = T.tys[er]
  if tn is TyNullable { uIx = tn.nInner }
  // `uIx` can be an unfilled infer-null hole (`-1`) reached only through a lambda's return, so
  // it must be bounds-checked before indexing `T.tys` (D1576).
  if uIx < 0 || uIx >= T.tys.length { return "" }
  const t = T.tys[uIx]
  if t is TyUnion {
    const members = t.uMembers
    if members.length < 2 { return "" }
    // At least one map member, and every member a map, object, or scalar/string prim (riding
    // the box as its value atom). A litunion/array/closure/nullable member declines.
    let hasMap = false
    // non-null count — `TY_NULL` is a `TyPrim`; see the gate after the loop.
    let muNonNull = 0
    let i = 0
    while i < members.length {
      const m = T.tys[members[i]]
      // The non-null count, taken before the shape arms so it narrows nothing.
      if !tyIsPrimNamed(members[i], "null") { muNonNull = muNonNull + 1 }
      if m is TyMap {
        hasMap = true
      } else if !(m is TyObj) {
        if !(m is TyPrim) { return "" }
      }
      i = i + 1
    }
    if !hasMap { return "" }
    // At least two non-null members: `TY_NULL` is a `TyPrim`, so a single-real-member union
    // like `null|{[string]:f32}` reaches here but is never registered under this name.
    if muNonNull < 2 { return "" }
    return irRendered(tyToEmitName(er))
  }
  ""
}

// The emitter-format name of a ref-arm value union `er` (`T[] | {w: i32}`): a union with at
// least one ref-array member and every member an object shape or an array of object shapes.
// Members render nominally when a declared type matches, else structurally. One renderer
// feeds `collectU`, `synthRetAnnots` and `nodeUnionName`, so all three byte-match.
function refArmUnionRetName(er: i32, stmts: i32[]) {
  if er < 0 { return "" }
  const t = T.tys[er]
  if t is TyUnion {
    const members = t.uMembers
    if members.length < 2 { return "" }
    // Structural pre-gate before any render (#494): every member an object or an
    // array-of-object, at least one array.
    let hasList = false
    // Non-null count, because `TY_NULL` is a `TyPrim` and the scalar-sibling arm below admits
    // one — see the `>= 2` gate after the loop.
    let rauNonNull = 0
    let gi = 0
    while gi < members.length {
      const m = T.tys[members[gi]]
      // The non-null count, taken before the shape arms so it cannot narrow `m` out from under
      // the `!(m is TyPrim)` scalar-sibling arm below.
      if !tyIsPrimNamed(members[gi], "null") { rauNonNull = rauNonNull + 1 }
      if m is TyArray {
        // The hole declines with every other non-object element (`tyArrayElemIx`): an
        // unresolved array element carries `aElem == -1`, an out-of-bounds `array.get`.
        const meIx = tyArrayElemIx(members[gi])
        if meIx < 0 { return "" }
        const et = T.tys[meIx]
        if !(et is TyObj) { return "" }
        hasList = true
      } else if !(m is TyObj) && !(m is TyPrim) {
        // A scalar sibling (`{f: string}[] | f64`) rides the box as a value atom — the
        // annotated named-fn spelling lowers it; anything else here still declines.
        return ""
      }
      gi = gi + 1
    }
    if !hasList { return "" }
    // At least two non-null members: `S[] | null` (one real member) is not registrable —
    // `registerInlineUnion` diverts a `<refarray>|null` to its non-null part alone.
    if rauNonNull < 2 { return "" }
    let name = ""
    let i = 0
    while i < members.length {
      const m = T.tys[members[i]]
      let mn = ""
      if m is TyArray {
        let en = nominalNameOfObj(m.aElem, stmts)
        // An anonymous-shape element (`{f: string}[]`) renders canonically: the interner keys
        // the inline spelling, and the annotated form already lowers it.
        if en == "" { en = tyToEmitName(m.aElem) }
        if en == "" { return "" }
        mn = en + "[]"
      } else if m is TyPrim {
        mn = m.primName
      } else {
        mn = nominalNameOfObj(members[i], stmts)
        if mn == "" { mn = tyToEmitName(members[i]) }
        if mn == "" { return "" }
      }
      if i > 0 { name = name + "|" }
      name = name + mn
      i = i + 1
    }
    // Every member render is one atom — the pre-gate above admits only an array-of-object,
    // an object shape, or a scalar prim, each spelling its separators inside a grouper (#1115).
    return irAtoms(name, members.length)
  }
  ""
}

// The emitter-format name of a variant-box union `er` with an inline-struct arm and a
// scalar/string sibling (`i32 | {w: i32}`): every member an object shape or scalar/string
// prim, at least one object. `synthRetAnnots` pins a lambda's `fnRet` to this, routing it
// through the same `>u` box the annotated form interns. "" for a map/array/nullable member.
function variantBoxUnionRetName(er: i32) {
  if er < 0 { return "" }
  const t = T.tys[er]
  // A nullable variant-box union normalizes to `TyNullable` over the union — the box already
  // carries a null member atom, so render the inner union and append `|null`.
  if t is TyNullable {
    const inner = variantBoxUnionRetName(t.nInner)
    // The inner union keeps its own top-level `|`s, so `null` adds one atom to the width
    // the recursion just reported (#1115).
    if inner != "" { return irAtoms(inner + "|null", inferRetNameAtoms + 1) }
    return ""
  }
  if t is TyUnion {
    const members = t.uMembers
    if members.length < 2 { return "" }
    // A litunion-alias member's literals flatten into sibling `TyLit` members, so no single
    // member names the alias — regroup them and resolve as one alias by exact member-set match.
    const litTexts: string[] = []
    let i0 = 0
    while i0 < members.length {
      const m0 = T.tys[members[i0]]
      if m0 is TyLit {
        if m0.litKind != "str" { return "" }
        litTexts.push(m0.litText)
      }
      i0 = i0 + 1
    }
    let litAlias = ""
    if litTexts.length > 0 {
      litAlias = litUnionAliasOfLitTexts(litTexts)
      if litAlias == "" { return "" }
    }
    let hasComposite = litAlias != ""
    let hasClo = false
    let hasObj = false
    let name = ""
    // The append count, not `members.length`: the litunion regroup below contracts a run of
    // `TyLit` members into one alias atom, so iteration count and atom count differ (#1115).
    let psum = 0
    let litDone = false
    let i = 0
    while i < members.length {
      const m = T.tys[members[i]]
      let mn = ""
      if m is TyLit {
        if litDone {
          i = i + 1
          continue
        }
        litDone = true
        mn = litAlias
      } else if m is TyFunc {
        // A closure arm beside a struct arm rides the box anyref as the kind-11 ref atom — at
        // most one closure arm; a struct sibling routes it through this same sound box.
        if hasClo { return "" }
        const cn = tyToEmitName(members[i])
        if cn == "" { return "" }
        mn = "(" + cn + ")"
        hasClo = true
        hasComposite = true
      } else {
        mn = vbUnionMemberName(members[i])
        if mn == "" { return "" }
        // A bare `null` member declines here on purpose — the `TyNullable` arm above owns
        // null and appends it itself; un-excluded this would render a false two-atom niche.
        if mn == "null" { return "" }
        if m is TyObj { hasObj = true }
        if mn != "i32" && mn != "i64" && mn != "f64" && mn != "f32" {
          if mn != "boolean" && mn != "string" { hasComposite = true }
        }
      }
      if name != "" { name = name + "|" }
      name = name + mn
      psum = psum + 1
      i = i + 1
    }
    // One atom is not a union: a pure literal union contracts to a single alias atom here,
    // which is the i32-atom rep, not this box — `psum` (post-contraction) catches it.
    if psum < 2 { return "" }
    if hasClo && !hasObj { return "" }
    if !hasComposite { return "" }
    return irAtoms(name, psum)
  }
  ""
}

// One member's render for `variantBoxUnionRetName`: a scalar/string prim by name, a
// litunion alias by its alias token (not `tyToEmitName`'s softened `string`), and an object
// shape field-wise. "" for a map/array/closure/nullable/inline-litunion member — those stay
// on their own paths.
function vbUnionMemberName(mIx: i32): string {
  const alias = litUnionAliasNameOfTy(mIx)
  if alias != "" { return alias }
  const m = T.tys[mIx]
  if m is TyPrim { return m.primName }
  // A scalar-leaf array member (`i64[] | boolean`) rides the box as a plain wrapper ref, the
  // same rep the annotated form lowers fully — an object-element array member stays declined.
  if m is TyArray {
    let leaf = m.aElem
    let vguard = 0
    let scalarLeaf = false
    while vguard < 8 {
      vguard = vguard + 1
      if leaf < 0 { break }
      const lt = T.tys[leaf]
      if lt is TyArray {
        leaf = lt.aElem
      } else {
        let leafPrim = leaf
        // A nullable-scalar element leaf (`(i64 | null)[]`) admits too — the annotated
        // named-fn spelling of such a union lowers fully, both arms round-tripping.
        if lt is TyNullable { leafPrim = lt.nInner }
        const lp = T.tys[leafPrim]
        if lp is TyPrim {
          const pn = lp.primName
          if (
            pn == "i32" ||
            pn == "i64" ||
            pn == "f64" ||
            pn == "f32" ||
            pn == "boolean" ||
            pn == "string"
          ) {
            scalarLeaf = true
          }
        }
        break
      }
    }
    if scalarLeaf {
      const en = tyToEmitName(mIx)
      if en != "" { return en }
    }
    return ""
  }
  if m is TyObj {
    // A nominal struct arm renders its declared type name so the registered variant matches
    // the annotation; falls through to the inline field-wise render when no type matches.
    const nom = nominalNameOfObj(mIx, gRootStmts)
    if nom != "" { return nom }
    const names = m.objFieldNames
    const ftys = m.objFieldTypes
    let out = "{"
    let fi = 0
    while fi < names.length {
      let fs = litUnionAliasNameOfTy(ftys[fi])
      if fs == "" {
        const ft = T.tys[ftys[fi]]
        // Exhaustive over `Ty`, deliberately without a `_` arm: a new arena variant must break
        // the self-compile here rather than silently decline the whole union arm.
        match ft {
          TyPrim => {
            fs = ft.primName
          }
          TyMap => {
            // A map field renders canonically (`tyToEmitName`): the annotated spelling of a
            // union carrying such an arm lowers fully, so the pin routes through the same path.
            fs = tyToEmitName(ftys[fi])
            if fs == "" { return "" }
          }
          TyObj => {
            // A nested-struct field (code 15) admits the same way — the annotated spelling
            // lowers it, and un-admitted the whole arm would leave the lambda un-pinned.
            fs = tyToEmitName(ftys[fi])
            if fs == "" { return "" }
          }
          TyNullable => {
            // A nullable field admits the same way: every nullable spelling the annotation
            // grammar allows has a field code, and the annotated union lowers it fully.
            fs = tyToEmitName(ftys[fi])
            if fs == "" { return "" }
          }
          TyArray => {
            // A list field admits the same way — the annotated spelling lowers it, and
            // un-admitted the whole arm would leave the lambda un-pinned to a raw scalar.
            fs = tyToEmitName(ftys[fi])
            if fs == "" { return "" }
          }
          TyFunc => {
            // A closure field admits the same way, rendered as the bare arrow — a field
            // position carries no trailing `|` ambiguity, since fields split at commas.
            fs = tyToEmitName(ftys[fi])
            if fs == "" { return "" }
          }
          TyUnion => {
            // A value-union field admits the same way: `tyToEmitName` preserves member order
            // and litunion aliases, with the inner `|` brace-scoped like the nullable arm's.
            fs = tyToEmitName(ftys[fi])
            if fs == "" { return "" }
          }
          TyErr => {
            // The error/unknown hole has no field code — decline the whole arm.
            return ""
          }
          TyVar => {
            // An unsolved type parameter has no field code — decline the whole arm.
            return ""
          }
          TyLit => {
            // A bare `TyLit` field reached without its litunion alias (already claimed above)
            // has no field code — decline the whole arm.
            return ""
          }
          TyNeg => {
            // A residual negation has no field code — decline the whole arm.
            return ""
          }
        }
      }
      if fi > 0 { out = out + "," }
      out = out + names[fi] + ":" + fs
      fi = fi + 1
    }
    return out + "}"
  }
  ""
}

// True if node `ix`'s recorded type is a pure literal union (every member a `TyLit`): it reps
// as the interned i32 atom or the string ref, never the value-union box, so the emitter's
// union-box classifiers must not claim it. Gates `exprUnion`'s checker-typed `Call` fallback,
// without which a litunion-result call classified as a box and the atom store mismatched.
export function nodeTyIsPureLitUnion(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyUnion {
    if t.uMembers.length < 2 { return false }
    let i = 0
    while i < t.uMembers.length {
      if !(T.tys[t.uMembers[i]] is TyLit) { return false }
      i = i + 1
    }
    return true
  }
  false
}

// True when at least one union member is not an object shape — the cheap no-render pre-gate
// for `nodeUnionName`'s variant-box fallback. A mixed union boxes value-union style and its
// narrowed read needs the name to unbox; a pure-object union narrows via the variant alone,
// so declining here keeps the costly member renders off that path.
function mixedVariantBoxGate(members: i32[]): boolean {
  let i = 0
  while i < members.length {
    if !(T.tys[members[i]] is TyObj) { return true }
    i = i + 1
  }
  false
}

// The public entry point: checks the program rooted at node `rootIx`, returning the number
// of diagnostics raised (diagnostics also accumulate on `T.diags`).
// ── extern declarations ──────────────────────────────────────────────────────

// A diagnostic anchored at an extern's own name TOKEN. Externs mint no AST node, so `tErr`'s
// node-to-token resolution has nothing to read and the position is supplied directly.
function externErr(msg: string, tok: i32) {
  if tok >= 0 && tok < P.toks.length {
    return tErrPush(msg, -1, P.toks[tok].line, P.toks[tok].col, "", "")
  }
  tErrPush(msg, -1, 0, 0, "", "")
}

// The type-arena index an `extern function` parameter or return spelling resolves to — the
// closed set that crosses a host boundary in both hosts (`docs/internals/extern-design.md` §2).
// Every other spelling is refused here and answers `TY_ERR`, so the declaration still gets a
// type and no caller holds a sentinel it could forget.
function externScalarTy(
  name: string,
  what: string,
  spelling: string,
  tok: i32,
): i32 {
  if spelling == "i32" { return TY_I32 }
  if spelling == "i64" { return TY_I64 }
  if spelling == "f32" { return TY_F32 }
  if spelling == "f64" { return TY_F64 }
  if spelling == "boolean" { return TY_BOOL }
  externBadTy(name, what, spelling, tok)
  TY_ERR
}

// The one refusal for a type that cannot cross, naming the workaround the design settles on:
// bytes travel as a `Buf`'s two i32s through the module's exported `memory`.
function externBadTy(name: string, what: string, spelling: string, tok: i32) {
  externErr(
    "extern `" +
      name +
      "` " +
      what +
      " `" +
      spelling +
      "`, which cannot cross a host boundary — an extern carries i32, i64, f32, f64 and boolean " +
      "only; pass bytes as a `Buf`'s `base` and `length` (two i32s) and read them through the " +
      "module's exported `memory`",
    tok,
  )
  0
}

// Declare every `extern function` the module graph carries, and refuse the two shapes that
// cannot become one import: a type that does not cross, and two declarations of one link name
// whose signatures disagree. Runs before `checkNode` so a call in any module resolves.
function checkExternDecls() {
  // The link rows first: one type check per IMPORT, so an extern declared in two modules is
  // graded once. `linkTys` is parallel to the link table and read by the declaration loop.
  const linkTys: i32[] = []
  let k = 0
  while k < externCount() {
    const nm = externNameAt(k)
    const tok = extPoss[k]
    if nm == "" {
      externErr(
        "`extern function` needs a name — it is the host import's name",
        tok,
      )
    }
    const ptys: i32[] = []
    let p = 0
    const ar = externArityAt(k)
    while p < ar {
      ptys.push(externScalarTy(nm, "takes", externParamAt(k, p), tok))
      p = p + 1
    }
    const rs = externRetAt(k)
    // No return annotation is a VOID import, not a missing one — the reading a `function` with
    // no annotation does not get, because an extern has no body to infer one from.
    let rt = TY_VOID
    if rs != "" { rt = externScalarTy(nm, "returns", rs, tok) }
    linkTys.push(mkFuncTy(ptys, rt))
    k = k + 1
  }
  // Then one binding per DECLARATION, under the name the merge left it — so a module-private
  // extern is private to name lookup while the link it points at stays shared. A declaration
  // whose signature disagrees with its link row is reported at its own site: same signature is
  // the supported shape, and only a disagreement has no import section that satisfies both.
  let d = 0
  while d < externDeclCount() {
    const link = extDeclLink[d]
    if link >= 0 && link < linkTys.length {
      if extSigs[link] != extDeclSig[d] {
        externErr(
          "extern `" +
            extNames[link] +
            "` is declared `" +
            extDeclSig[d] +
            "` here and `" +
            extSigs[link] +
            "` elsewhere — one name is one host import, so every declaration of it must agree",
          extDeclPos[d],
        )
      }
      if extDeclVl[d] != "" { declare(extDeclVl[d], linkTys[link]) }
    }
    d = d + 1
  }
  0
}

// The checker's entry point; `initChecker()` must have run first. Every module table this
// walk fills is emptied there, so a walk over a stale one reads another program's rows.
export function checkProgram(rootIx: i32) {
  if !checkerArmed {
    tErr(
      "internal: checkProgram without initChecker since the previous program",
      -1,
    )
  }
  checkerArmed = false
  const rootN0 = P.nodes[rootIx]
  if rootN0 is Program { gRootStmts = rootN0.progStmts }
  // Size the typed-IR table to the (now fully parsed) node arena, all holes (-1).
  nodeTyIx = []
  isVarTyIx = []
  isParentTyIx = []
  isParentElseTyIx = []
  cFuncPinTyIx = -1
  cObjPinTyIx = -1
  nodePinKind = []
  nodePinPay = []
  let ntz = 0
  while ntz < P.nodes.length {
    nodeTyIx.push(-1)
    isVarTyIx.push(-1)
    isParentTyIx.push(-1)
    isParentElseTyIx.push(-1)
    ntz = ntz + 1
  }
  checkExternDecls()
  checkNode(rootIx)
  // The global scope (depth 0) is never popped, so flush its un-annotated
  // empty-collection bindings here: any still-open hole is genuinely uninferable.
  flushUninferred(0)
  // …and with every pin now in, grade what `__array_new_default__` needed to default.
  checkArrayNewDefaultElems()
  // Rewrite literal/intersection annotation names into the emitter's runtime vocabulary —
  // membership is already enforced above; names without those constructs are untouched.
  canonEmitTypeNames()
  // A20: records each un-annotated function's inferred concrete return name for the emitter
  // (never the AST, so `fmt` stays oblivious).
  let ei = 0
  while ei < topUnannotFns.length {
    const efn = P.nodes[topUnannotFns[ei]]
    if efn is FuncDecl {
      const eft = lookup(efn.fnName)
      if eft >= 0 {
        const eftt = T.tys[eft]
        if eftt is TyFunc {
          const er = eftt.fnRet
          // Generic functions skip (a `self` marker, an un-annotated param, or a deferred-join
          // return) — their type is per-call-site and would export a misleading or wrong name.
          let generic = false
          const ert0 = T.tys[er]
          if ert0 is TyVar { generic = true }
          if tyIsDeferredJoin(er) { generic = true }
          // D970 — an un-annotated param alone does not make a concrete union return generic;
          // the skip is for a per-call-site return, which a deferred join still is.
          let retIsConcreteUnion = false
          if !generic {
            const ertU = T.tys[er]
            if ertU is TyUnion {
              // Only when the body genuinely returns two different concrete types — a join
              // over the function's own TyVars must still skip (admitting it produces invalid wasm).
              if a20RetSetDisagrees(efn.fnBody) { retIsConcreteUnion = true }
            }
          }
          let gp = 0
          while gp < eftt.fnParamTypes.length {
            const pt = T.tys[eftt.fnParamTypes[gp]]
            if pt is TyVar {
              if !retIsConcreteUnion { generic = true }
            }
            if tyIsDeferredJoin(eftt.fnParamTypes[gp]) { generic = true }
            gp = gp + 1
          }
          if !generic && er >= 0 && er != TY_VOID && er != TY_ERR {
            // Only scalar/string returns are recorded — a structural name (`{x:i32}`, `A|B`,
            // `Tok[]`) can mis-classify, and the emitter's expression-based fallback covers those.
            const enm = tyToStructStr(er)
            // A branded newtype (`type NS = new string`) is minted as a copy of its base `Ty`,
            // so it renders as its own brand name and is not classifiable without erasure below.
            let recNm = enm
            let recTy = er
            if !isClassifiableRetName(recNm) {
              const erased = nomErasedTyIx(er)
              if erased != er {
                const ernm = tyToStructStr(erased)
                if isClassifiableRetName(ernm) {
                  recNm = ernm
                  recTy = erased
                }
              }
            }
            // A numeric literal union (`NK = 0 | 1 | 2`) erases to its base scalar the same
            // way a brand does — its rep is the base's. `NK[]` is untouched (declined as an array).
            if !isClassifiableRetName(recNm) {
              const nlb = numLitUnionBaseTy(er)
              if nlb >= 0 {
                const nlnm = tyToStructStr(nlb)
                if isClassifiableRetName(nlnm) {
                  recNm = nlnm
                  recTy = nlb
                }
              }
            }
            // D1576 — a never-filled infer-null hole returned is the `null` type too: `let x =
            // null; return x` hands on `TyNullable(-1)`, which the rung below must also catch.
            let enmNull = enm == "null"
            const erNH = T.tys[er]
            if erNH is TyNullable {
              if erNH.nInner < 0 { enmNull = true }
            }
            if enmNull {
              // D1567 — a return whose only value is bare `null` is the `null` type (reps as
              // `nullref`), checked ahead of the erasure rungs since `null` has no classifiable name.

              // The recorded arena type is `TY_NULL`, not `er`: the hole spelling's `er` is
              // `TyNullable(-1)` itself, and a downstream `T.tys[-1]` read would be out of bounds.
              recordInferRet(efn.fnName, "null", TY_NULL, 1, IR_REC_NULL_ONLY)
            } else if isClassifiableRetName(recNm) {
              // `isClassifiableRetName`'s admitted set is six scalar spellings plus
              // `i32[]`/`string[]` — every one of them a single atom (#1115).
              recordInferRet(efn.fnName, recNm, recTy, 1, IR_REC_CLASSIFIABLE)
            } else {
              // A value union/nullable inferred return lowers through the same `uBoxIdx`
              // machinery as an annotation — export its name so the return site picks it up.
              const un = valueUnionRetName(er)
              if un != "" {
                recordInferRet(
                  efn.fnName,
                  un,
                  er,
                  inferRetNameAtoms,
                  IR_RUNG_VALUE_UNION,
                )
              } else if structUnionRetName(er, gRootStmts) != "" {
                // A struct union lowers via the same variant-boxed rep as an annotated union;
                // the width is read from a local AFTER the render (#1115), not argument order.
                const sun = structUnionRetName(er, gRootStmts)
                recordInferRet(
                  efn.fnName,
                  sun,
                  er,
                  inferRetNameAtoms,
                  IR_RUNG_STRUCT_UNION,
                )
              } else if litUnionAliasNameOfTy(er) != "" {
                // A pure literal-union inferred return reps as the interned i32 atom, like the
                // annotated spelling — export the alias name so classification reaches that atom.
                recordInferRet(
                  efn.fnName,
                  litUnionAliasNameOfTy(er),
                  er,
                  1,
                  IR_RUNG_LITUNION_ALIAS,
                )
              } else if variantBoxUnionRetName(er) != "" {
                // A variant-box union (`{w:i32} | i32`) lowers un-annotated via the same `>u`
                // box an annotated spelling interns — export the render so `collectU` registers it.
                const vbn = variantBoxUnionRetName(er)
                recordInferRet(
                  efn.fnName,
                  vbn,
                  er,
                  inferRetNameAtoms,
                  IR_RUNG_VARIANT_BOX,
                )
              } else {
                // A niche nullable (`boolean | null`, `string | null`) lowers via its sentinel
                // rep, not the box, so `valueUnionRetName` declines it — export the niche name instead.
                const ert = T.tys[er]
                if ert is TyNullable {
                  // Two atoms, written out literally right here (#1115).
                  if tyIsPrimNamed(ert.nInner, "boolean") {
                    recordInferRet(
                      efn.fnName,
                      "boolean|null",
                      er,
                      2,
                      IR_RUNG_NULLABLE,
                    )
                  } else if tyIsPrimNamed(ert.nInner, "string") {
                    recordInferRet(
                      efn.fnName,
                      "string|null",
                      er,
                      2,
                      IR_RUNG_NULLABLE,
                    )
                  } else if litUnionAliasNameOfTy(ert.nInner) != "" {
                    // The literal-union niche (`K | null`): an i32 atom with `-1` for null, the
                    // same rep an annotated `: K | null` spelling reaches.
                    recordInferRet(
                      efn.fnName,
                      litUnionAliasNameOfTy(ert.nInner) + "|null",
                      er,
                      2,
                      IR_RUNG_NUL_LITUNION,
                    )
                  } else {
                    // D887 — the nullable struct ref (`{r:i32} | null`, `P | null`) already has a
                    // rep (`ref.null $S`); `nullableRetName` is the same renderer the lambda ladder uses.
                    const nsn = nullableRetName(er, gRootStmts)
                    if nsn != "" {
                      recordInferRet(
                        efn.fnName,
                        nsn,
                        er,
                        inferRetNameAtoms,
                        IR_RUNG_NULLABLE,
                      )
                    } else {
                      // D1062 — a nullable list at an element type the arm above does not name.
                      // Recorded so `synthNulListRetAnns` can pin the function's own annotation.
                      const nln = nulListRetName(er)
                      if nln != "" {
                        recordInferRet(
                          efn.fnName,
                          nln,
                          er,
                          inferRetNameAtoms,
                          IR_RUNG_NUL_LIST_RET,
                        )
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    ei = ei + 1
  }
  checkProgramEndOpDecls()
  T.diags.length
}

// A20: the emitter reads this to classify an un-annotated function's return from its
// inferred type name rather than re-deriving from the return expression. Records an
// inferred-return entry: pushes the parallel arrays and the by-name map (first-wins).
// Every producer push goes through here so the map stays in sync.
function recordInferRet(
  name: string,
  ty: string,
  tyIx: i32,
  atoms: i32,
  rung: i32,
) {
  if !inferRetIdx.has(name) { inferRetIdx[name] = inferRetFn.length }
  inferRetFn.push(name)
  inferRetTy.push(ty)
  // Banks the recorded name's top-level atom count from `atoms` — the caller's own join
  // width, never re-scanned from the string (a litunion member is one atom, several in the arena).
  inferRetAtomCount.push(atoms)
  inferRetTyIx.push(tyIx)
  // An explicit parameter, not a global read: two gates sit between the cascade and this
  // call, either of which could leave a stale global armed for an unrelated next row.
  inferRetRung.push(rung)
  0
}

// The top-level atom count of the inferred-return name at row `i` (`inferRetTyAt`'s
// sibling): >= 1 for every recorded row, -1 only for an out-of-range index.
export function inferRetAtomCountAt(i: i32) {
  if i < 0 || i >= inferRetAtomCount.length { return -1 }
  inferRetAtomCount[i]
}

// The inferred-return null question, asked of the arena type `recordInferRet` banked beside
// the name, not of the rendered spelling (which only ever split on `|`). `ty < 0` returns
// false because every name-keyed row carries a real arena index; the node-keyed `#`-prefixed
// rows are the exception and are not read through this function.
export function inferRetBearsNull(name: string): boolean {
  const ty = inferRetTyIxOf(name)
  if ty < 0 { return false }
  tyBearsNull(ty)
}

// D1062 — is the row recorded for `name` a nullable list (`T[] | null`)? Asked of the arena
// index beside the name, never of the render: the emitter's pin (`synthNulListRetAnns`) needs
// the shape, and the two producers that can bank such a row spell it two different ways, so a
// name test would have to know both spellings while the type is one answer.
export function inferRetIsNulList(name: string): boolean {
  const ty = inferRetTyIxOf(name)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    const it = T.tys[t.nInner]
    if it is TyArray { return true }
  }
  false
}

export function inferRetNameOf(name: string) {
  const irHit = inferRetIdx[name]
  if irHit is i32 {
    const i = irHit
    if i >= 0 { return inferRetTy[i] }
  }
  ""
}

// The inferred-return name of an anonymous lambda, keyed by its `FuncDecl` node index (the
// emitter passes `fnStmts[i]`). Anonymous lambdas are recorded under a `#<nodeIx>` sentinel
// key (they have no real name); the emitter consults this when the name-keyed lookup misses.
export function inferRetNameByNode(nodeIx: i32) {
  return inferRetNameOf("#" + i32ToStr(nodeIx))
}

// The arena sibling of `inferRetNameOf` / `inferRetNameByNode`: the `Ty` index the recorder
// banked for the same row the name comes from, so a consumer needing the type does not
// re-parse the name to get it. `-1` where the recorder had no arena index.
export function inferRetTyIxOf(name: string) {
  const irxHit = inferRetIdx[name]
  if irxHit is i32 {
    const i = irxHit
    if i >= 0 { return inferRetTyIx[i] }
  }
  -1
}

export function inferRetTyIxByNode(nodeIx: i32) {
  return inferRetTyIxOf("#" + i32ToStr(nodeIx))
}

// Whether an inferred return type name is one the emitter's A20 classifier carries directly
// (a scalar/string/simple list) — the set the inferred-return table records. The two list
// names go through `arrElemNameRaw`'s array-grammar cut plus a leaf-name check rather than a
// raw string match, so the array `[]` and the leaf name are decided at one shared seam.
function isClassifiableRetName(nm: string) {
  if (
    nm == "i32" ||
    nm == "i64" ||
    nm == "f32" ||
    nm == "f64" ||
    nm == "boolean" ||
    nm == "string"
  ) {
    return true
  }
  const elem = arrElemNameRaw(nm)
  elem == "i32" || elem == "string"
}

// A scalar-list inferred-return name the emitter's closure-result classifier carries (the
// `f64list`/`i64list`/`f32list` kinds) but which `isClassifiableRetName` deliberately omits —
// those array names must not reach the redundant-return lint. Recorded for an anonymous
// lambda since the checker's per-node f32[] typing is unreliable (a float literal types f64).
function isScalarListRetName(nm: string) {
  const elem = arrElemNameRaw(nm)
  elem == "i64" || elem == "f32" || elem == "f64"
}

// Whether a rendered type name is a single object shape (`{meow: i32}`) — `tyToStr` of a
// `TyObj`. The emitter resolves it to a concrete union variant by field-set match. A nullable
// `{...}?` / union `{...} | {...}` is not a single shape.
function isObjShapeName(nm: string) {
  // Stays wide (`nameIsBraceSpanEnds`, not the tighter `nameIsShapeOpen`): a `TyMap` also
  // renders `{[string]:i32}`, and this function accepts that shape too.
  if !nameIsBraceSpanEnds(nm) { return false }
  // Uses `tyTopIndexOf` (quote-aware, escape-aware) rather than a naive brace-depth counter:
  // a literal member like `{a:"}|{"}` can hide a `}` inside a string and mis-close early.
  tyTopIndexOf(nm, '|', 0, 0) < 0
}

// Iteration over the inferred-return table: the emitter's `collectU` registers any value-union
// names here so their box reps are interned even when an inferred return is the program's only
// value union. `inferRetTyAt` is the rendered type name.
export function inferRetCount() { inferRetFn.length }
// The row index, resolved once — so a consumer that wants both the recorded name and the
// recorded type reads one lookup and two columns instead of two lookups that happen to agree.
// Every `recordInferRet` call site passes both, so no row can carry a name without a type.
export function inferRetRowOf(name: string): i32 {
  const irrHit = inferRetIdx[name]
  if irrHit is i32 { return irrHit }
  -1
}

export function inferRetRowByNode(nodeIx: i32): i32 {
  inferRetRowOf("#" + i32ToStr(nodeIx))
}

// Did the checker's adoption ladder settle this inferred return on a value-union producer?
// Three rungs mint one — the plain value union, the litunion-array value union, and the
// closure-arm value union — bucketing every reach by banked rung shows the separation is
// exact, with no mixed rung; the checker already knew, the emitter only asked the render.
export function inferRetRungIsValueUnion(i: i32): boolean {
  const r = inferRetRungAt(i)
  if r == IR_RUNG_VALUE_UNION { return true }
  if r == IR_RUNG_LITUNION_ARR_VU { return true }
  r == IR_RUNG_CLO_ARM_VU
}

function inferRetRungAt(i: i32): i32 {
  if i < 0 || i >= inferRetRung.length { return -1 }
  inferRetRung[i]
}

// —— the rung predicates ——————————————————————————————————————————————————
// One predicate per converted arm, exported so the rung numbering stays this file's business.
// Safe against named rows only because `#` cannot open an identifier — `synthRetAnnots` keys
// by node (`"#" + nodeIx`) while the named loop keys by function name, disjoint by construction.

// Rung 16 — `nestedElemUnionListRetName`.
export function inferRetRungIsNestedElemUnionList(i: i32): boolean {
  inferRetRungAt(i) == IR_RUNG_NESTED_ELEM_UNION_LIST
}

// Rung 24 — `nestedLeafListRetName`.
export function inferRetRungIsNestedLeafList(i: i32): boolean {
  inferRetRungAt(i) == IR_RUNG_NESTED_LEAF_LIST
}

// Rung 26 — `litUnionElemListRetName`.
export function inferRetRungIsLitUnionElemList(i: i32): boolean {
  inferRetRungAt(i) == IR_RUNG_LITUNION_ELEM_LIST
}

// Rung 25 — `mapElemListRetName`.
export function inferRetRungIsMapElemList(i: i32): boolean {
  inferRetRungAt(i) == IR_RUNG_MAP_ELEM_LIST
}

// Arm 4's set — every producer whose render is a paren-grouped value-union array. Nine rungs,
// including `nulElemListRetName`'s box leg but not its niche legs (`IR_RUNG_NUL_ELEM_LIST_NICHE`).
export function inferRetRungIsParenUnionElemList(i: i32): boolean {
  const r = inferRetRungAt(i)
  if r == IR_RUNG_NUL_ELEM_LIST { return true }
  if r == IR_RUNG_NUL_STRUCT_ELEM_LIST { return true }
  if r == IR_RUNG_NUL_MAP_ELEM_LIST { return true }
  if r == IR_RUNG_NUL_LIST_ELEM_LIST { return true }
  if r == IR_RUNG_ELEM_VU_LIST { return true }
  if r == IR_RUNG_ELEM_VARIANT_BOX_LIST { return true }
  if r == IR_RUNG_ELEM_MAP_UNION_LIST { return true }
  if r == IR_RUNG_ELEM_REFARM_VU_LIST { return true }
  if r == IR_RUNG_NUL_CLOSURE_ELEM_LIST { return true }
  false
}

// Arm 1's set — every producer whose render is a union the emitter boxes. Closes a cross-pass
// dependence: `mapUnionRetName`/`refArmUnionRetName` now carry the same `>= 2 non-null` gate
// `variantBoxUnionRetName` already had, so admission does not depend on a later pass's union
// registry (`isUName`) — the cost is losing that registry's interlock as a safety net.
export function inferRetRungIsStructElemList(i: i32): boolean {
  inferRetRungAt(i) == IR_RUNG_STRUCT_ELEM_LIST
}

export function inferRetRungIsBoxedUnion(i: i32): boolean {
  const r = inferRetRungAt(i)
  if r == IR_RUNG_VALUE_UNION { return true }
  if r == IR_RUNG_LITUNION_ARR_VU { return true }
  if r == IR_RUNG_STRUCT_UNION { return true }
  if r == IR_RUNG_CLO_ARM_VU { return true }
  if r == IR_RUNG_MAP_UNION { return true }
  if r == IR_RUNG_REFARM_UNION { return true }
  if r == IR_RUNG_VARIANT_BOX { return true }
  if r == IR_RUNG_LITUNION_ALIAS { return true }
  false
}

// The fall-through's scalar-list leg. `isScalarListRetName`'s admitted set is exactly
// `{"i64[]", "f32[]", "f64[]"}` — `arrElemNameRaw` rejects anything not ending `[]` and
// otherwise drops exactly those two characters, so the two predicates share one cut.
export function inferRetRungIsScalarListRet(i: i32): boolean {
  inferRetRungAt(i) == IR_REC_SCALAR_LIST
}

// Rungs 6 and 7 — `nullableRetName` and `nulLitUnionRetName`, the only producers that mint a
// top-level nullable name. Both mint `<part> + "|null"` and nothing else, so asking "is this
// row's name a nullable" is asking exactly which producer answered.
export function inferRetRungIsNullable(i: i32): boolean {
  const r = inferRetRungAt(i)
  r == IR_RUNG_NULLABLE || r == IR_RUNG_NUL_LITUNION
}

export function inferRetTyAt(i: i32) {
  if i < 0 || i >= inferRetTy.length { return "" }
  inferRetTy[i]
}
// The `Ty`-arena index of the `i`th recorded inferred return (`-1` if none) — the emitter's
// `collectU` drives the structural arena walks off this so an inferred return's reachable
// unions/closures register/intern exactly like an annotated one.
export function inferRetTyIxAt(i: i32) {
  if i < 0 || i >= inferRetTyIx.length { return -1 }
  inferRetTyIx[i]
}

// The emitter reads this to classify an un-annotated binding (`const x = if c { v } else
// null`) from its inferred value-union type name, keyed by `LetDecl` node index, rather than
// re-deriving it from the initializer. "" when the binding is not an inferred value union.
export function inferLetNameOf(letIx: i32) {
  let i = 0
  while i < inferLetIx.length {
    if inferLetIx[i] == letIx { return inferLetTy[i] }
    i = i + 1
  }
  ""
}
export function inferLetCount() { inferLetIx.length }
export function inferLetIxAt(i: i32) { inferLetIx[i] }
// D970 — does this body return two different concrete types? The A20 gate uses it to tell a
// join over the function's own literals (which every instantiation shares) from a per-call-site
// result (which must not register a box). A return whose type carries a type variable is
// ignored, which is what keeps the deferred-join family on the old path.
function a20RetSetDisagrees(blockIx: i32): boolean {
  const rets: i32[] = []
  a20CollectRets(blockIx, rets)
  let seen = -1
  let i = 0
  while i < rets.length {
    const rt = nodeTyIxOf(rets[i])
    if rt >= 0 {
      if !tyHasTyVar(rt) {
        if seen < 0 { seen = rt }
        else if seen != rt { return true }
      }
    }
    i = i + 1
  }
  false
}

function a20CollectRets(blockIx: i32, out: i32[]) {
  if blockIx < 0 { return 0 }
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      const st = P.nodes[stmts[i]]
      if st is RetStmt {
        if st.retArg >= 0 { out.push(st.retArg) }
      } else if st is IfStmt {
        a20CollectRets(st.ifThen, out)
        a20CollectRets(st.ifElse, out)
      }
      if i == stmts.length - 1 {
        if !(st is RetStmt) {
          if !(st is IfStmt) { out.push(stmts[i]) }
        }
      }
      i = i + 1
    }
  }
  0
}

// D969 — carries a checked type onto a node the checker never saw. A rewrite that synthesizes
// a node is type-blind as well as node-erasing (`nodeTyIx` has no entry for it), so a
// meaning-preserving rewrite must hand the old node's type to the new one. The one place that
// writes the column, so its growth discipline (`push(-1)` up to the index) lives here.
export function nodeTyCarry(dst: i32, src: i32) {
  if dst < 0 { return 0 }
  const ty = nodeTyIxOf(src)
  if ty < 0 { return 0 }
  while nodeTyIx.length <= dst { nodeTyIx.push(-1) }
  nodeTyIx[dst] = ty
  0
}

// The resolved type-arena index the checker recorded for AST node `ix`, or -1 if none (an
// emitter-synthesized node, or a node never checked). The emitter reads the `Ty` at this
// index to lower the node by its checked type rather than re-deriving it syntactically.
export function nodeTyIxOf(ix: i32) {
  if ix >= 0 {
    if ix < nodeTyIx.length { return nodeTyIx[ix] }
  }
  -1
}
// Annotation atom count (#1055): how many top-level `|`-joined atoms the annotation node
// `ix`'s emit-time spelling has, banked by `canonEmitTypeNames`. -1 for a node that is not a
// `TypeRef` or that postdates the bank (an emitter-synthesized annotation); >= 1 otherwise.
export function annUnionAtomsOf(ix: i32) {
  if ix >= 0 {
    if ix < annUnionAtoms.length { return annUnionAtoms[ix] }
  }
  -1
}
// The arena type the `is` test at node `ix` checks AGAINST — what the narrowing binds the
// tested place to — or -1 for a node the checker never resolved (an emitter-synthesized
// `is`, or a non-`IsExpr` node). Recorded by `checkIsExprNode`.
export function isVarTyIxOf(ix: i32) {
  if ix >= 0 {
    if ix < isVarTyIx.length { return isVarTyIx[ix] }
  }
  -1
}
// The type the receiver of a member-path `is` test narrows to in the then branch — the
// discriminant rule's answer, banked at the `is` node. -1 when the test does not discriminate
// a parent union, which is when the emitter should push nothing.
export function isParentTyIxOf(ix: i32) {
  if ix >= 0 {
    if ix < isParentTyIx.length { return isParentTyIx[ix] }
  }
  -1
}
// The else-branch twin: the type the receiver of a member-path test narrows to when the test
// is false. -1 when the complement does not refine the parent, which is when the emitter
// should push nothing.
export function isParentElseTyIxOf(ix: i32) {
  if ix >= 0 {
    if ix < isParentElseTyIx.length { return isParentElseTyIx[ix] }
  }
  -1
}
// The context-resolved companion of `nodeTyIxOf`: returns the destination type recorded by
// `recordRepTyAdopt` at an adoption site when present, else the naive `nodeTyIxOf`. The
// emitter's rep/layer resolvers key on this so a widened literal's row resolves to the shape
// the emitter actually builds.
export function nodeRepTyIxOf(ix: i32) {
  if ix >= 0 {
    if ix < nodeRepTyIx.length {
      const r = nodeRepTyIx[ix]
      if r >= 0 { return r }
    }
  }
  nodeTyIxOf(ix)
}
// Stamps the context (destination) type `dstTy` onto a literal source `srcExpr` (recursively,
// into `ObjLit` fields / `ArrayLit` elements) into the `nodeRepTyIx` sidecar, at arena-pure
// adoption sites — reads only `T.tys`/`P.nodes`, writes only `nodeRepTyIx`. Nullable wrappers
// are peeled; a destination deeper than 16 declines, to avoid unbounded recursion.
function recordRepTyAdopt(srcExpr: i32, dstTy: i32, depth: i32) {
  if inferQuiet || srcExpr < 0 || dstTy < 0 || depth <= 0 { return 0 }
  if tyDeeperThan(dstTy, 16) { return 0 }
  let dtix = dstTy
  let peel = true
  while peel {
    const dN = T.tys[dtix]
    if dN is TyNullable {
      if dN.nInner < 0 { return 0 }
      dtix = dN.nInner
    } else {
      peel = false
    }
  }
  const d = T.tys[dtix]
  const e = P.nodes[srcExpr]
  if e is Paren {
    recordRepTyAdopt(e.parInner, dtix, depth)
    while nodeRepTyIx.length <= srcExpr { nodeRepTyIx.push(-1) }
    nodeRepTyIx[srcExpr] = dtix
    return 1
  }
  if e is ObjLit {
    if d is TyObj {
      const dfn = d.objFieldNames
      const dft = d.objFieldTypes
      let k = 0
      while k < e.objFields.length {
        const f = P.nodes[e.objFields[k]]
        if f is FieldInit {
          let j = 0
          while j < dfn.length {
            if dfn[j] == f.fiName {
              recordRepTyAdopt(f.fiValue, dft[j], depth - 1)
            }
            j = j + 1
          }
        }
        k = k + 1
      }
      while nodeRepTyIx.length <= srcExpr { nodeRepTyIx.push(-1) }
      nodeRepTyIx[srcExpr] = dtix
      return 1
    }
    // A nested `ObjLit` whose destination is a union: recurse against the first member whose
    // field-name set corresponds (best-effort, keeps the recorder side-effect free).
    if d is TyUnion {
      const members = d.uMembers
      let mi = 0
      while mi < members.length {
        const mt = T.tys[members[mi]]
        if mt is TyObj {
          if objLitFieldsCorrespond(e, mt) {
            return recordRepTyAdopt(srcExpr, members[mi], depth)
          }
        }
        mi = mi + 1
      }
      return 0
    }
    return 0
  }
  if e is ArrayLit {
    if d is TyArray {
      let i = 0
      while i < e.arrElems.length {
        recordRepTyAdopt(e.arrElems[i], d.aElem, depth - 1)
        i = i + 1
      }
      while nodeRepTyIx.length <= srcExpr { nodeRepTyIx.push(-1) }
      nodeRepTyIx[srcExpr] = dtix
      return 1
    }
    // An array literal boxed into a union arm — recurse against the first array member.
    if d is TyUnion {
      const members = d.uMembers
      let mi = 0
      while mi < members.length {
        const mt = T.tys[members[mi]]
        if mt is TyArray {
          return recordRepTyAdopt(srcExpr, members[mi], depth)
        }
        mi = mi + 1
      }
      return 0
    }
    return 0
  }
  0
}
// True when the `ObjLit` `e`'s field-name set corresponds one-to-one with the struct type
// `mt`'s declared field names (order-independent) — `recordRepTyAdopt`'s light dual of
// `objLitWidenFields`'s correspondence check, without the assignability re-entry.
function objLitFieldsCorrespond(e: ObjLit, mt: TyObj): boolean {
  const dfn = mt.objFieldNames
  if e.objFields.length != dfn.length { return false }
  let k = 0
  while k < e.objFields.length {
    const f = P.nodes[e.objFields[k]]
    if f is FieldInit {
      let found = false
      let j = 0
      while j < dfn.length {
        if dfn[j] == f.fiName { found = true }
        j = j + 1
      }
      if !found { return false }
    } else {
      return false
    }
    k = k + 1
  }
  true
}
// Copies the type the checker already recorded on `srcNode` onto a synthesized annotation
// node `destNode` — for a synthesis name the emitter's `nameToTy` can't resolve (an interned
// anonymous shape `#anonN`), where the source node still carries the real arena type.
export function recordNodeTyFrom(destNode: i32, srcNode: i32) {
  if destNode < 0 { return 0 }
  const ty = nodeTyIxOf(srcNode)
  while nodeTyIx.length <= destNode { nodeTyIx.push(-1) }
  nodeTyIx[destNode] = ty
  0
}
// The lazily-built placeholder `TyFunc` for closure pins — only its `is TyFunc`-ness is read
// (via `nodeTyIsFunc`); the real signature rides the pin column's payload. Reset per program.
function funcPinTyIx() {
  if cFuncPinTyIx < 0 {
    const ps: i32[] = []
    cFuncPinTyIx = mkFuncTy(ps, -1)
  }
  cFuncPinTyIx
}
// The lazily-built placeholder `TyObj` for interned anonymous shapes — only its `is TyObj`-ness
// is read (`nodeTyIsStruct`); the real layout rides the `#anonN` name (the emitter's `sNames` table).
function objPinTyIx() {
  if cObjPinTyIx < 0 {
    const ns: string[] = []
    const ts: i32[] = []
    cObjPinTyIx = mkObjTy(ns, ts)
  }
  cObjPinTyIx
}
// The pin column's writer. `kind`/`payload` describe node `nodeIx`'s provenance; a `PIN_NONE`
// write is a no-op that keeps an ordinary synthesized annotation out of the column entirely,
// so a reader's "" / `PIN_NONE` answer is unambiguously "not a pin".
export function recordNodePin(nodeIx: i32, kind: i32, payload: string) {
  if nodeIx < 0 { return 0 }
  if kind == PIN_NONE { return 0 }
  while nodePinKind.length <= nodeIx {
    nodePinKind.push(PIN_NONE)
    nodePinPay.push("")
  }
  nodePinKind[nodeIx] = kind
  nodePinPay[nodeIx] = payload
  0
}
// The pin payload recorded for node `ix` — for `PIN_SIGKEY`, the `$fnsig` key the
// monomorphizer resolved for the closure argument that pinned this parameter. "" when the
// node carries no pin. The read `emit_classify.paramCloSigKey` makes instead of slicing the
// marker off the node's name.
export function nodePinPayloadOf(ix: i32) {
  if ix < 0 { return "" }
  if ix >= nodePinPay.length { return "" }
  nodePinPay[ix]
}
// Whether `nm` mentions any of the module's generic-alias type-parameter names
// (`nameMentionsIdent`'s whole-token match, not a substring test).
export function nameMentionsGenAliasParam(nm: string): boolean {
  let i = 0
  while i < gaParamNames.length {
    if nameMentionsIdent(nm, gaParamNames[i]) { return true }
    i = i + 1
  }
  false
}

// The monomorphizer clones a generic instance's body, minting fresh annotation nodes whose
// type-param names are substituted to concrete ones — those nodes fall past the
// checker-sized `nodeTyIx`, so resolve the substituted `name` and record it here,
// idempotently, so the emitter's arena-reading classifiers cover monomorphized instances too.
export function recordClonedNodeTy(nodeIx: i32, name: string, pin: i32) {
  recordClonedNodeTyKnown(nodeIx, name, pin, -1)
}

// `recordClonedNodeTyKnown` with the handed type as a fallback instead of an override: the
// name resolves first and wins wherever it can, `tyFb` fills in only where it can't. Feeds
// `emit_mono`'s `pinnedTyIx` column, re-checked against the generic body, so a changed
// answer here can move emitted bytes — not confined to one node's sidecar.
export function recordClonedNodeTyFb(
  nodeIx: i32,
  name: string,
  pin: i32,
  tyFb: i32,
) {
  if nodeIx < 0 { return -1 }
  let ty = nameToTy(name)
  if ty < 0 {
    // `PIN_SIGKEY` only, deliberately excluding `PIN_ANON`: a `$fnsig` key is a pure encoding
    // with no identity, but `#anonN` names a specific interned row the arena cannot recover.
    if pin == PIN_SIGKEY { ty = tyFb }
  }
  if ty < 0 {
    if pin == PIN_SIGKEY { ty = funcPinTyIx() }
    else if pin == PIN_ANON { ty = objPinTyIx() }
  }
  while nodeTyIx.length <= nodeIx { nodeTyIx.push(-1) }
  nodeTyIx[nodeIx] = ty
  ty
}

// The hand-over form: `tyIn >= 0` means the caller already holds the arena index, so the
// parse is skipped entirely; `-1` keeps the name-parsing route for callers with only a name.
// `recordClonedNodeTyFb` has the identical signature and the opposite precedence (name wins
// there); passing one where the other is meant compiles silently and inverts the resolution.
export function recordClonedNodeTyKnown(
  nodeIx: i32,
  name: string,
  pin: i32,
  tyIn: i32,
) {
  if nodeIx < 0 { return -1 }
  let ty = tyIn
  if ty < 0 { ty = nameToTy(name) }
  if ty < 0 {
    if pin == PIN_SIGKEY { ty = funcPinTyIx() }
    else if pin == PIN_ANON { ty = objPinTyIx() }
  }
  while nodeTyIx.length <= nodeIx { nodeTyIx.push(-1) }
  nodeTyIx[nodeIx] = ty
  ty
}
// The `isVarTyIx` twin of `recordClonedNodeTy`: `checkIsExprNode` banks the resolved check
// type at every `is` node the checker sees, but a node the monomorphizer mints postdates
// that pass and reads -1 forever. For a substituted test (`is T` at `T := i32`) this resolves
// the row the new spelling names, via the same `nameToTy` route. Returns the banked row, or -1.
export function recordClonedIsVarTyIx(nodeIx: i32, ty: i32) {
  if nodeIx < 0 { return -1 }
  if ty < 0 { return -1 }
  while isVarTyIx.length <= nodeIx { isVarTyIx.push(-1) }
  isVarTyIx[nodeIx] = ty
  ty
}
export function recordClonedIsVarTy(nodeIx: i32, name: string) {
  recordClonedIsVarTyIx(nodeIx, nameToTy(name))
}
// The arena index of the `i32` primitive. The monomorphizer's all-i32 param arm mints no
// annotation node at all (`parType` stays -1), so it has no `recordClonedNodeTy` return to
// bank; this is the one type it needs and the constant is here rather than exported mutable.
export function i32TyIx() { TY_I32 }
// The primitive-type name the checker recorded for node `ix` — `T.tys[nodeTyIx[ix]]`'s
// `primName` when it resolved to a `TyPrim`, else "". A structural query over the `Ty` arena,
// so a scalar rep is decided from the checked type rather than a re-parsed annotation name.
export function nodeTyPrimName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyPrim { return t.primName }
  ""
}
// Whether node `ix`'s recorded type is a function type (`TyFunc`). Structural, so a func
// array (`((i32)=>i32)[]`, a `TyArray`) or a nullable closure (a `TyNullable`) is excluded
// for free, unlike a depth-aware `=>` test on the rendered name.
export function nodeTyIsFunc(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyFunc { return true }
  false
}
// Whether node `ix`'s recorded type is a NULLABLE function (`TyNullable` over `TyFunc`) —
// the niche twin of `nodeTyIsFunc`, for the `nulclosure` rep. `nInner` is bound-tested
// against the arena rather than trusted: an unresolved element is the hole `-1` and reading
// `T.tys[-1]` is a compiler trap rather than a refusal (D1440).
export function nodeTyIsNulFunc(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    if t.nInner < 0 { return false }
    if t.nInner >= T.tys.length { return false }
    const inner = T.tys[t.nInner]
    if inner is TyFunc { return true }
  }
  false
}
// The `primName` of `ty`'s array element, or "" unless `ty` is a `TyArray` whose element is a
// bare `TyPrim` — the arena twin of the `arrElemNameRaw(name) == "<scalar>"` cut, factored
// here so its consumers read one line. Deliberately unfiltered (answers `boolean` too); a
// caller that must stay narrower than the name cut applies its own whitelist.
export function tyArrayElemPrim(ty: i32): PrimName | null {
  if ty < 0 { return null }
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem >= 0 {
      const el = T.tys[t.aElem]
      if el is TyPrim { return el.primName }
    }
  }
  null
}

// The decision form — `tyIsPrimNamed`'s shape over the array element.
function tyArrayElemPrimIs(ty: i32, nm: PrimName): boolean {
  tyArrayElemPrim(ty) == nm
}

// The element prim as text, for the one consumer that carries it onward as a name.
export function tyArrayElemPrimName(ty: i32): string {
  primNameStr(tyArrayElemPrim(ty))
}

// The wasm element-rep name of the array type recorded for node `ix`, normalized to the
// emitter's list-rep vocabulary — "i32" (`i32[]`, `boolean[]`, or a litunion `K[]`, all
// sharing the i32 atom backing), "f64"/"f32"/"i64", "string", or "" when `ix` is not a
// recorded array or its element is a ref/nested list. Mirrors `nameIsI32Array`/etc.
export function nodeTyArrayElemRepName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyArray {
    const e = t.aElem
    if e >= 0 {
      const et = T.tys[e]
      if et is TyPrim {
        if et.primName == "boolean" { return "i32" }
        return et.primName
      }
      // A `(boolean | null)[]` element (the boolean sentinel niche) shares the i32 backing
      // (0/1, spare 2 = null); only the `null -> 2` coercion and the sentinel read/print differ.
      if et is TyNullable {
        if et.nInner < 0 || et.nInner >= T.tys.length { return "" }
        const en = T.tys[et.nInner]
        if en is TyPrim {
          if en.primName == "boolean" { return "i32" }
          // A `(string | null)[]` element is the string ref made nullable — `string[]` is
          // already `(ref null $aTypeIdx)`, so only construct/read of the null case differs.
          if en.primName == "string" { return "string" }
        }
      }
      if tyIsLitUnion(e) { return "i32" }
      // A numeric literal-union element (`type K = 1.5 | 2.5`) has no atom — its members are
      // plain scalar values, so its list is the base scalar's list, not a second rep.
      const nb = numLitUnionBaseName(e)
      if nb != "" { return nb }
      // A `(K | null)[]` element (the litunion atom niche) shares the i32 backing (ids >= 0,
      // spare `-1` = null) exactly like the non-null `K[]` case above.
      if tyIsNullableLitUnion(e) { return "i32" }
    }
  }
  ""
}
// The widened scalar rep of node `ix`'s type — like `nodeTyPrimName`, but a string literal
// union (`"a"|"b"`) reports "string" (its one-way widening). "" for a non-prim/non-litunion,
// letting the `string` classifier read the arena without misclassifying a litunion.
export function nodeTyWidenedRepName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyPrim { return t.primName }
  if tyIsLitUnion(ty) { return "string" }
  // A single literal or homogeneous numeric literal union widens to its base scalar here too,
  // matching `canonEmitName`'s softening — a mixed `"a"|7` stays the value-union box instead.
  const soft = softenLitTy(ty)
  if soft != ty {
    const st = T.tys[soft]
    if st is TyPrim { return st.primName }
  }
  ""
}
// Whether node `ix`'s type is `string | null` (kind 16, nullable raw-array ref) — a
// `TyNullable` over the bare `string` prim; a `K | null` litunion niche is not this.
// Paired with `nodeTyIsNullableString`, which answers a wider question (also accepts a
// `TyLit` string or an all-string `TyUnion`) — using the wrong one of the pair narrows silently.
export function nodeTyIsNulString(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    if t.nInner < 0 || t.nInner >= T.tys.length { return false }
    const inner = T.tys[t.nInner]
    if inner is TyPrim { return inner.primName == "string" }
  }
  false
}
// Whether node `ix`'s recorded type contains a type variable — it is one, or one sits under
// a constructor (`T[]`, `T | null`, `{v: T}`). Inside a monomorphized instance the operand
// nodes are shared with the generic template, so the banked type is still `T` and this is
// correct about the type variable and useless about the instance (D42).
export function nodeTyHasTyVar(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  tyHasHole(ty)
}
// `nodeTyHasTyVar` minus the one position a type variable can sit in without deciding the
// value's rep: a closure parameter's valtype is the fat pointer at every instantiation, so a
// `T` under a `=>` does not decide the rep the way a bare `T` parameter's annotation does
// (D426).
export function nodeTyHasRepTyVar(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  tyHasRepHoleAt(ty, 0)
}
function tyHasRepHoleAt(tyIx: i32, depth: i32) {
  if tyIx < 0 { return false }
  if depth > 8 { return false }
  const t = T.tys[tyIx]
  if t is TyVar { return true }
  if t is TyArray { return tyHasRepHoleAt(t.aElem, depth + 1) }
  if t is TyNullable { return tyHasRepHoleAt(t.nInner, depth + 1) }
  if t is TyMap {
    if tyHasRepHoleAt(t.mKey, depth + 1) { return true }
    return tyHasRepHoleAt(t.mVal, depth + 1)
  }
  if t is TyObj {
    const ofts = t.objFieldTypes
    let i = 0
    while i < ofts.length {
      if tyHasRepHoleAt(ofts[i], depth + 1) { return true }
      i = i + 1
    }
    return false
  }
  if t is TyUnion {
    const ums = t.uMembers
    let u = 0
    while u < ums.length {
      if tyHasRepHoleAt(ums[u], depth + 1) { return true }
      u = u + 1
    }
    return false
  }
  // A `TyFunc` is deliberately not descended into — a closure parameter's rep does not
  // depend on what its own params/return contain (see `nodeTyHasRepTyVar`).
  false
}

// D1045's nominal-escape rule (DECISIONS.md): the source name of a body-scoped nominal type
// reachable inside `tyIx`, or "". Descends `TyFunc` (unlike `tyHasRepHoleAt` above) because
// this asks whether a caller could write the type down, not what rep a slot needs. Demangled,
// since the name goes into a diagnostic a person reads.
function localNomEscapeAt(tyIx: i32, depth: i32): string {
  if tyIx < 0 { return "" }
  if depth > 8 { return "" }
  const nwn = nomNameOfTy(tyIx)
  if nwn != "" {
    if nwBodyScopedNames.has(nwn) { return demangleName(nwn) }
  }
  const t = T.tys[tyIx]
  if t is TyArray { return localNomEscapeAt(t.aElem, depth + 1) }
  if t is TyNullable { return localNomEscapeAt(t.nInner, depth + 1) }
  if t is TyMap {
    const k = localNomEscapeAt(t.mKey, depth + 1)
    if k != "" { return k }
    return localNomEscapeAt(t.mVal, depth + 1)
  }
  if t is TyObj {
    const ofts = t.objFieldTypes
    let i = 0
    while i < ofts.length {
      const f = localNomEscapeAt(ofts[i], depth + 1)
      if f != "" { return f }
      i = i + 1
    }
    return ""
  }
  if t is TyUnion {
    const ums = t.uMembers
    let u = 0
    while u < ums.length {
      const m = localNomEscapeAt(ums[u], depth + 1)
      if m != "" { return m }
      u = u + 1
    }
    return ""
  }
  if t is TyFunc {
    const ps = t.fnParamTypes
    let p = 0
    while p < ps.length {
      const a = localNomEscapeAt(ps[p], depth + 1)
      if a != "" { return a }
      p = p + 1
    }
    return localNomEscapeAt(t.fnRet, depth + 1)
  }
  ""
}

// Refuses an inferred return that carries a body-scoped nominal type. Called from the two
// sites that witness a pending function's result (the explicit `return` and the trailing
// expression), so the diagnostic lands on the return. A declared return is untouched — writing
// `: Id` is the author saying they meant it.
function refuseLocalNomEscape(t: i32, at: i32) {
  if t < 0 { return 0 }
  const nm = localNomEscapeAt(t, 0)
  if nm == "" { return 0 }
  // Anchored at the node's start: `nodeToks`'s default is its last token, which would report
  // at the closing identifier of a lambda expression, away from the `return` to annotate.
  tErrAtNodeStart(
    "return type `" +
      nm +
      "` is declared inside `" +
      demangleName(curFnEscName) +
      "` and no caller can name it; annotate the return or move `" +
      nm +
      "` to module scope",
    at,
  )
  0
}
// Whether node `ix`'s type is `boolean | null` (the i32 sentinel-2 niche). Lets `exprNulBool`
// recover the niche from the checker's recorded type for an expression whose syntactic form
// it can't trace (a `(boolean | null)[]` element read, an inferred `const`), routing `!=
// null`/`?? d`/print to the sentinel compare. Mirrors `nodeTyIsNulString`.
export function nodeTyIsNulBool(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    // `nInner` is -1 while the inner type is still a hole (a bare `null` element whose list
    // never pinned one); unguarded this traps the compiler on a check-clean program (D1440).
    if t.nInner < 0 || t.nInner >= T.tys.length { return false }
    const inner = T.tys[t.nInner]
    if inner is TyPrim { return inner.primName == "boolean" }
  }
  false
}
// Whether node `ix`'s type is a nullable numeric scalar (`i32|null`, `i64|null`, `f64|null`,
// `f32|null`) — its inner has no spare value to niche into, so it reps as the value-union
// `{tag, value}` box. The niche nullables (`string`/`boolean`/litunion/struct/closure/list
// `| null`) are structurally excluded — they are not box values.
export function nodeTyIsNulScalarBox(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    // D1575 — `nInner` is -1 while the a-infer-null hole is open (`let x = null`); unguarded
    // this traps the compiler on a check-clean program. An open hole is no prim, so false.
    if t.nInner < 0 || t.nInner >= T.tys.length { return false }
    const inner = T.tys[t.nInner]
    if inner is TyPrim {
      return (inner.primName == "i32" ||
        inner.primName == "i64" ||
        inner.primName == "f64" ||
        inner.primName == "f32")
    }
  }
  false
}
// Whether node `ix`'s type is `i32[] | null` / `boolean[] | null` (kind 15, nullable i32-list)
// — a `TyNullable` whose inner is an array of the `i32`/`boolean` prim (both i32-repped). A
// litunion array is excluded, matching `nameIsNulI32List` (which tests only those two names).
export function nodeTyIsNulI32List(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    if t.nInner < 0 || t.nInner >= T.tys.length { return false }
    const it = T.tys[t.nInner]
    if it is TyArray {
      const e = it.aElem
      if e >= 0 {
        const et = T.tys[e]
        if et is TyPrim {
          return et.primName == "i32" || et.primName == "boolean"
        }
        // A literal-union element (`K[] | null`) shares the i32-list backing exactly like
        // `i32[]` (the arena dual of `nameIsI32Array`'s litunion arm).
        if tyIsLitUnion(e) { return true }
        // A niche-nullable i32-backed element (`(K | null)[] | null`) rides its null in the
        // same i32 sentinel and the outer `| null` is the same niche, matching the non-null case.
        if tyIsNullableLitUnion(e) { return true }
        if et is TyNullable {
          if et.nInner < 0 || et.nInner >= T.tys.length { return false }
          const ei = T.tys[et.nInner]
          if ei is TyPrim { return ei.primName == "boolean" }
        }
      }
    }
  }
  false
}
// Whether node `ix`'s type is an array of functions (`((i32)=>i32)[]`) — a `TyArray` whose
// element is a `TyFunc` (a closure-element ref list, kind 5). Mirrors `nameIsClosureArray`.
export function nodeTyIsClosureArray(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyArray {
    const e = t.aElem
    if e >= 0 {
      const et = T.tys[e]
      if et is TyFunc { return true }
    }
  }
  false
}
// —— dense membership over the `Ty`-arena index sets ————————————————————————
// Each nominal-identity sidecar set is membership-tested through a parallel `boolean[]`
// indexed by the arena index itself, since the emitter probes membership on nearly every
// typed node. Some sets are also iterated in order — write only through `cTyIxSetAdd`.

// Appends `v` to `xs` and marks it present in `xs`'s parallel dense flag array. A negative
// `v` is appended but not flagged — it is not an arena index, and `cTyIxSetHas` refuses one
// on the way in, so there is nowhere to record it.
function cTyIxSetAdd(xs: i32[], flags: boolean[], v: i32) {
  xs.push(v)
  if v >= 0 {
    // Grown lazily to the largest member index, never to `T.tys.length`: the arena keeps
    // growing long after the last member is recorded, and an out-of-range read is already right.
    while flags.length <= v { flags.push(false) }
    flags[v] = true
  }
  0
}
// Membership in the set `flags` indexes. Out of range answers false and never traps, which
// covers both a negative index and an arena that outgrew the set.
function cTyIxSetHas(flags: boolean[], v: i32) {
  if v < 0 { return false }
  if v >= flags.length { return false }
  flags[v]
}
// Whether node `ix`'s recorded type is a declared struct and not a union-variant member — the
// nominal analogue of `isSName(tyNameOf(ix))`, read from the checker's arena-index sets
// instead of an AST scan. Under-approximates (an uncovered struct reads false), so callers
// keep the name test as a fallback.
export function nodeTyIsStruct(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  if cTyIxSetHas(cVariantMemberTyIxSet, ty) { return false }
  if cTyIxSetHas(cStructTyIxSet, ty) { return true }
  const t = T.tys[ty]
  if t is TyObj { return true }
  if t is TyUnion {
    // A struct-alias union — a canonicalized `{a} & {b}` intersection wraps its merged object
    // shape in a one-member union; the emitter interns it as a struct (`isSName`), so match it.
    if t.uMembers.length == 1 {
      const m = T.tys[t.uMembers[0]]
      if m is TyObj { return true }
    }
  }
  false
}
// Whether node `ix`'s recorded type is an object union-variant member — the nominal analogue
// of `variantIndexOf(tyNameOf(ix)) >= 0`. The `is TyObj` guard excludes a transparent
// single-member primitive alias (`type Id = i32`), whose member lands in the set but denotes
// the scalar, not a variant box.
export function nodeTyIsVariant(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  if !cTyIxSetHas(cVariantMemberTyIxSet, ty) { return false }
  const t = T.tys[ty]
  if t is TyObj { return true }
  false
}

export function nodeTyIsNulStruct(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    const inner = t.nInner
    if inner < 0 { return false }
    if cTyIxSetHas(cVariantMemberTyIxSet, inner) { return false }
    if cTyIxSetHas(cStructTyIxSet, inner) { return true }
    const it = T.tys[inner]
    if it is TyObj { return true }
    return false
  }
  false
}
// Whether node `ix`'s recorded type is a union box — a `TyUnion` of more than one member, or a
// `TyNullable`. A literal union is excluded (an interned i32 atom, not a box). The arena twin
// of `isUName`, which tests a spelling-keyed registry whose member lists do not correspond to
// the arena's — asking the type directly needs no identity, only shape.
export function nodeTyIsUnionish(ix: i32): boolean {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  if tyIsLitUnion(ty) { return false }
  const t = T.tys[ty]
  if t is TyUnion {
    if t.uMembers.length > 1 { return true }
    // The same one-member wrapper `nodeTyIsUnionAlias` unwraps: a self-referential union with a
    // `null` arm. The gate and the lowering must agree, or the parameter lowers as `i32` (invalid wasm).
    if t.uMembers.length == 1 {
      const m = T.tys[t.uMembers[0]]
      if m is TyNullable { return true }
    }
    return false
  }
  if t is TyNullable { return true }
  false
}

// Whether node `ix`'s recorded type denotes a struct (`TyObj`), seeing through the parser's
// one-member `UnionDecl` wrapper. The arena twin of `isSName`, needing shape and no identity —
// every gap in the name registry (generic instances, `#anon0` shapes) stops mattering. The
// peel is load-bearing: a canonicalized object intersection (`{a} & {b}`) arrives as `TyUnion[TyObj]`.
export function nodeTyIsStructish(ix: i32): boolean {
  let cur = nodeTyIxOf(ix)
  let peels = 0
  while peels < 8 {
    if cur < 0 { return false }
    const t = T.tys[cur]
    if t is TyObj { return true }
    if t is TyUnion {
      if t.uMembers.length == 1 { cur = t.uMembers[0] } else { return false }
    } else {
      return false
    }
    peels = peels + 1
  }
  false
}

// Whether arena type `ty` is a `u8[]` — a `TyArray` whose element is the `u8` storage prim.
// The arena answers this without the caveat its f32 sibling carries: no literal defaults to
// `u8[]` (a bare `[1, 2]` types `i32[]`), so the recorded type says `u8[]` exactly when an
// annotation did — which is what lets the emitter's receiver classifier be short.
export function tyIsU8ArrayTy(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem < 0 || t.aElem >= T.tys.length { return false }
    return primNameOf(t.aElem) == "u8"
  }
  false
}

// Whether node `ix`'s recorded type denotes an array (`TyArray`), seeing through the parser's
// one-member `UnionDecl` wrapper (the same transparency `nodeTyIsStructish` needs). The arena
// twin of `nameIsArray`, which tested the rendering for a trailing `]` — that test also
// claimed a union whose last arm is an array, which `nodeTyIsUnionish` now claims first.
export function nodeTyIsArrayish(ix: i32): boolean {
  let cur = nodeTyIxOf(ix)
  let peels = 0
  while peels < 8 {
    if cur < 0 { return false }
    const t = T.tys[cur]
    if t is TyArray { return true }
    if t is TyUnion {
      if t.uMembers.length == 1 { cur = t.uMembers[0] } else { return false }
    } else {
      return false
    }
    peels = peels + 1
  }
  false
}

// Whether node `ix`'s recorded type is a nullable-boolean list — `TyArray` over a
// `TyNullable` over `TyPrim("boolean")`, the `(boolean | null)[]` seed kind. The arena twin of
// `nameIsNulBoolList`. The element here is a niche (0/1, spare 2 for null), not a box, so the
// elem-rep readers that answer for a plain `boolean[]` do not claim it.
export function nodeTyIsNulBoolList(ix: i32): boolean {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyArray {
    const e = t.aElem
    if e < 0 { return false }
    const et = T.tys[e]
    if et is TyNullable {
      const inner = et.nInner
      if inner < 0 { return false }
      const it = T.tys[inner]
      if it is TyPrim { return it.primName == "boolean" }
    }
  }
  false
}

// Whether type `ty` reaches a closure — as itself, through a nullable wrapper, an array
// element, an object field, a union arm, or a map value. The arena form of
// `collectFnValUse`'s closure-field scan; wider than the name walk it replaced (itself
// alias-blind), safely so because `fnValUsed` is monotone — an extra true changes nothing.
export function tyReachesClosure(ty: i32, depth: i32): boolean {
  if ty < 0 || depth <= 0 { return false }
  const t = T.tys[ty]
  if t is TyFunc { return true }
  if t is TyNullable { return tyReachesClosure(t.nInner, depth - 1) }
  if t is TyArray { return tyReachesClosure(t.aElem, depth - 1) }
  if t is TyObj {
    let i = 0
    while i < t.objFieldTypes.length {
      if tyReachesClosure(t.objFieldTypes[i], depth - 1) { return true }
      i = i + 1
    }
    return false
  }
  if t is TyUnion {
    let j = 0
    while j < t.uMembers.length {
      if tyReachesClosure(t.uMembers[j], depth - 1) { return true }
      j = j + 1
    }
    return false
  }
  if t is TyMap { return tyReachesClosure(t.mVal, depth - 1) }
  false
}

// `tyReachesClosure` over node `ix`'s recorded type, at the emitter's standard peel bound.
export function nodeTyReachesClosure(ix: i32): boolean {
  tyReachesClosure(nodeTyIxOf(ix), 8)
}

// Whether node `ix`'s recorded type is an array of a declared struct (`S[]`) — the clean base
// case of the emitter's recursive `nameIsRefArray`. Confirms only the plain struct-element
// list (element in `cStructTyIxs`, not a variant member); other ref arrays fall to the name path.
export function nodeTyIsStructArray(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyArray {
    const e = t.aElem
    if e < 0 { return false }
    if cTyIxSetHas(cVariantMemberTyIxSet, e) { return false }
    if cTyIxSetHas(cStructTyIxSet, e) { return true }
    const et = T.tys[e]
    if et is TyObj { return true }
    return false
  }
  false
}
// Whether node `ix`'s recorded type is a nullable literal union — the per-node form of
// `tyIsNullableLitUnion`, the one home of this question. Canon preserves a nullable litunion's
// members in both the `TyNullable` and the expanded `TyUnion` spelling, so both must classify
// here, or a niche cell builds as a union box while every read lowers the atom (D-NULLITHOME).
export function nodeTyIsNulLitUnion(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable { return tyIsNullableLitUnion(ty) }
  if t is TyUnion { return tyIsNullableLitUnion(ty) }
  false
}

// The declared alias name of litunion type index `ty` (`type K = "a" | "b"` -> "K"), or "" when
// `ty` is not a registered litunion alias. Reverse of `cUserTypes` via the parallel
// `cUnionTyIxs`/`cUnionNames` arrays — pins an anonymous lambda's adopted litunion return
// as its alias (the alias reps as an i32 atom; the inline member spelling would rep as a string).
export function litUnionAliasNameOfTy(ty: i32) {
  if ty < 0 { return "" }
  if !tyIsLitUnion(ty) { return "" }
  let i = 0
  while i < cUnionTyIxs.length {
    if cUnionTyIxs[i] == ty { return cUnionNames[i] }
    i = i + 1
  }
  // Structural fallback: an annotation position may rebuild the alias's member union at a
  // fresh arena index, so matching by member-literal set (not index) is exact, not a guess.
  const tu = T.tys[ty]
  if tu is TyUnion {
    const texts: string[] = []
    let m0 = 0
    while m0 < tu.uMembers.length {
      const mt = T.tys[tu.uMembers[m0]]
      if mt is TyLit { texts.push(mt.litText) }
      m0 = m0 + 1
    }
    return litUnionAliasOfLitTexts(texts)
  }
  ""
}

// The registered litunion ALIAS whose member-literal set is EXACTLY `texts` (`["pd",
// "42"]` -> "K0"), or "" — shared by the structural fallback above and the
// flattened-member regroup in `variantBoxUnionRetName`.
export function litUnionAliasOfLitTexts(texts: string[]): string {
  if texts.length == 0 { return "" }
  let a = 0
  while a < cUnionTyIxs.length {
    if tyIsLitUnion(cUnionTyIxs[a]) {
      const rt = T.tys[cUnionTyIxs[a]]
      if rt is TyUnion {
        if rt.uMembers.length == texts.length {
          let all = true
          let m = 0
          while m < texts.length {
            let found = false
            let r = 0
            while r < rt.uMembers.length {
              const rm = T.tys[rt.uMembers[r]]
              if rm is TyLit {
                if rm.litText == texts[m] { found = true }
              }
              r = r + 1
            }
            if !found { all = false }
            m = m + 1
          }
          if all { return cUnionNames[a] }
        }
      }
    }
    a = a + 1
  }
  ""
}
// The registered litunion alias's own arena index whose member set is exactly the str-literal
// types `members`, or -1 — the arena twin of `litUnionAliasOfLitTexts`, needed because an
// identity-based classifier (`nodeTyIsLitUnionAlias`) compares by index, not name, so a
// freshly-minted union with `K`'s exact members is not `K` to it without this lookup.
export function litUnionAliasTyOfMembers(members: i32[]): i32 {
  if members.length < 2 { return -1 }
  const texts: string[] = []
  let i = 0
  while i < members.length {
    const m = T.tys[members[i]]
    if m is TyLit {
      if m.litKind != "str" { return -1 }
      texts.push(m.litText)
    } else {
      return -1
    }
    i = i + 1
  }
  let a = 0
  while a < cUnionTyIxs.length {
    const ti = cUnionTyIxs[a]
    if tyIsLitUnion(ti) {
      const rt = T.tys[ti]
      if rt is TyUnion {
        // An exact set, both directions: `>=` here would be a silent type widening — a
        // 2-member annotation could adopt a 4-member alias's index and narrow wrongly.
        if rt.uMembers.length == texts.length {
          let all = true
          let mi = 0
          while mi < texts.length {
            let found = false
            let r = 0
            while r < rt.uMembers.length {
              const rm = T.tys[rt.uMembers[r]]
              if rm is TyLit {
                if rm.litText == texts[mi] { found = true }
              }
              r = r + 1
            }
            if !found { all = false }
            mi = mi + 1
          }
          if all { return ti }
        }
      }
    }
    a = a + 1
  }
  -1
}

// The atom width of the last `litUnionInlineNameOfTy` answer, and whether that union
// carried a `null` member — the arena twin of canon's `lupAtoms` / `nulLitUnionPreserve`'s
// `hasNull`. Banked rather than returned because a VL function has one result.
let luiAtoms = 1
let luiHasNull = false

// The inline spelling of the string-literal run of union `ty`, from its arena members
// (`"a"|"b"`), or "" when `ty` is not a string-literal union — the un-aliased sibling of
// `litUnionAliasNameOfTy` and the arena twin of canon's `litUnionPreserve`. A `null` member
// does not disqualify the run; `luiHasNull` reports whether the caller's union carried one.
export function litUnionInlineNameOfTy(ty: i32): string {
  luiAtoms = 1
  luiHasNull = false
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyUnion {
    const texts: string[] = []
    let sawNull = false
    let i = 0
    while i < t.uMembers.length {
      const m = T.tys[t.uMembers[i]]
      if m is TyLit {
        if m.litKind != "str" { return "" }
        let dup = false
        let d = 0
        while d < texts.length {
          if texts[d] == m.litText { dup = true }
          d = d + 1
        }
        if !dup { texts.push(m.litText) }
      } else if m is TyPrim {
        if m.primName != "null" { return "" }
        sawNull = true
      } else {
        return ""
      }
      i = i + 1
    }
    if texts.length < 2 { return "" }
    luiHasNull = sawNull
    const al = litUnionAliasOfLitTexts(texts)
    if al != "" {
      // An alias name is one identifier — one atom.
      luiAtoms = 1
      return al
    }
    // A quoted member holds no top-level `|` of its own, so the join writes exactly
    // `texts.length - 1` separators — canon's `lupAtoms = kept.length`.
    let out = "\"" + texts[0] + "\""
    let k = 1
    while k < texts.length {
      out = out + "|\"" + texts[k] + "\""
      k = k + 1
    }
    luiAtoms = texts.length
    return out
  }
  ""
}

export function nodeTyIsLitUnionAlias(ix: i32) {
  tyIsLitUnionAlias(nodeTyIxOf(ix))
}

// The type-taking twin of `nodeTyIsLitUnionAlias`, written in terms of it — the one question
// "does this literal union rep as the interned i32 atom": a registered union type does, an
// unregistered fresh join does not (reps as a string ref). Not the same question as
// `litUnionAliasNameOfTy(ty) != ""`, which consults a different table and can disagree.
export function tyIsLitUnionAlias(ty: i32): boolean {
  if ty < 0 { return false }
  if !cTyIxSetHas(cUnionTyIxSet, ty) { return false }
  tyIsLitUnion(ty)
}
// Structural type equality over the arena, depth-bounded: two indices are the same type when
// their rows have the same variant and their components are recursively the same. The arena
// is an append log, so index equality is construction identity, not type identity — not a
// replacement for index equality where identity is nominal (a declared union's is its declaration).
export function tySame(a: i32, b: i32): boolean { tySameAt(a, b, 24) }

function tySameAt(a: i32, b: i32, depth: i32): boolean {
  if a == b { return true }
  if a < 0 || b < 0 { return false }
  if depth <= 0 { return false }
  const x = T.tys[a]
  const y = T.tys[b]
  if x is TyPrim {
    if y is TyPrim { return x.primName == y.primName }
    return false
  }
  if x is TyArray {
    if y is TyArray { return tySameAt(x.aElem, y.aElem, depth - 1) }
    return false
  }
  if x is TyNullable {
    if y is TyNullable { return tySameAt(x.nInner, y.nInner, depth - 1) }
    return false
  }
  if x is TyUnion {
    if y is TyUnion {
      if x.uMembers.length != y.uMembers.length { return false }
      let i = 0
      while i < x.uMembers.length {
        if !tySameAt(x.uMembers[i], y.uMembers[i], depth - 1) { return false }
        i = i + 1
      }
      return true
    }
    return false
  }
  // Compares fields by name set, not position (`{a,b}` and `{b,a}` are the same type) — safe by
  // construction since field names within one object are unique, making a name-keyed lookup exact.
  if x is TyObj {
    if y is TyObj {
      if x.objFieldNames.length != y.objFieldNames.length { return false }
      let f = 0
      while f < x.objFieldNames.length {
        let hit = false
        let g = 0
        while g < y.objFieldNames.length {
          if y.objFieldNames[g] == x.objFieldNames[f] {
            if tySameAt(x.objFieldTypes[f], y.objFieldTypes[g], depth - 1) {
              hit = true
            }
          }
          g = g + 1
        }
        if !hit { return false }
        f = f + 1
      }
      return true
    }
    return false
  }
  if x is TyMap {
    if y is TyMap {
      if !tySameAt(x.mKey, y.mKey, depth - 1) { return false }
      return tySameAt(x.mVal, y.mVal, depth - 1)
    }
    return false
  }
  // A FUNCTION member: same parameter list and same result. Unions of closures
  // (`((i32)=>i32) | ((i32)=>string)`) are ordinary inline unions and reach here.
  if x is TyFunc {
    if y is TyFunc {
      if x.fnParamTypes.length != y.fnParamTypes.length { return false }
      let q = 0
      while q < x.fnParamTypes.length {
        if !tySameAt(x.fnParamTypes[q], y.fnParamTypes[q], depth - 1) {
          return false
        }
        q = q + 1
      }
      return tySameAt(x.fnRet, y.fnRet, depth - 1)
    }
    return false
  }
  false
}

// Whether a type bears null — structurally, without rendering it and splitting on `|`. Two
// shapes, and missing the first is the trap this replaced: a `TyNullable` over a scalar bears
// null exactly as a `TyUnion` with a null member does, so a predicate that only walked
// `uMembers` answered false for `i32 | null`, leaving a `return null` unboxed.
export function tyBearsNull(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable { return true }
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      const mi = t.uMembers[i]
      const m = T.tys[mi]
      if m is TyPrim {
        if m.primName == "null" { return true }
      }
      // Recurses into nested union/nullable members (the arena nests them, e.g. `i32 | (string |
      // null)`) — but not into an array/object member, which is a leaf here just as it is there.
      if tyBearsNull(mi) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// Node-taking wrapper over `tyBearsNull`.
export function nodeTyBearsNull(ix: i32): boolean {
  tyBearsNull(nodeTyIxOf(ix))
}

// A value/struct union box (`isUName`'s registry) or a nullable-numeric-literal-union base
// (`nulNumLitUnionBaseName`) or a same-shape-collapsed struct union (`annUnionAtomsOf(ix) >=
// 2`) — wider than "excludes a nullable niche and a literal union" alone suggests. Keep this
// and `isUName(nm) && !nodeTyIsLitUnionAlias(ix)` in sync; they are not interchangeable.
export function nodeTyIsUnionAlias(ix: i32) {
  const ty0 = nodeTyIxOf(ix)
  if ty0 < 0 { return false }
  // A one-member union wrapper is transparent here — a self-referential union with a `null`
  // arm interns one level deeper than the non-recursive spelling, so unwrap to ask the same question.
  let ty = ty0
  const tw = T.tys[ty0]
  if tw is TyUnion {
    if tw.uMembers.length == 1 { ty = tw.uMembers[0] }
  }
  const t = T.tys[ty]
  // A value/struct union box (inline or declared) — the emitter registers both in `unNames`
  // (`isUName`). Excludes a nullable niche and a literal union (an interned atom, not a box).
  if isValueUnionBox(ty) { return true }
  // D1027 — a nullable over a union that already boxes is still that box: the niche exclusion
  // above is wrong once the inner is a value-union box, since the composition IS the union.
  if t is TyNullable {
    // Peels to a fixpoint: `Json | null` interns as nested `TyNullable`/one-member-`TyUnion`
    // wrappers, so one unwrap is not always enough to reach the underlying box.
    let nin = t.nInner
    let guard = 0
    while nin >= 0 && guard < 8 {
      const nw = T.tys[nin]
      if nw is TyNullable {
        nin = nw.nInner
      } else if nw is TyUnion {
        if nw.uMembers.length == 1 { nin = nw.uMembers[0] } else { guard = 8 }
      } else {
        guard = 8
      }
      guard = guard + 1
    }
    if nin >= 0 {
      if isValueUnionBox(nin) { return true }
    }
  }
  // A same-shape union (`A | B`, structurally identical) collapses to one `TyObj` in the arena,
  // losing its union-ness — recovered from the annotation's banked atom count (`annUnionAtomsOf`).
  if t is TyObj {
    if annUnionAtomsOf(ix) >= 2 { return true }
  }
  if t is TyNullable {
    const inner = t.nInner
    if inner >= 0 {
      const it = T.tys[inner]
      if it is TyPrim {
        const pn = it.primName
        if pn == "i32" || pn == "f64" || pn == "i64" || pn == "f32" {
          return true
        }
      }
      if isValueUnionBox(inner) { return true }
    }
  }
  // A nullable numeric literal union (`1 | 2 | null`) is the box too — its rep is `<base scalar>
  // | null`, matched via `nulNumLitUnionBaseName` since inline/declared forms intern differently.
  nulNumLitUnionBaseName(ty) != ""
}
// A `{tag, value}` value/struct union box: `TyUnion`, 2+ members, not a pure literal union.
function isValueUnionBox(tyix: i32) {
  if tyix < 0 { return false }
  const t = T.tys[tyix]
  if t is TyUnion {
    if t.uMembers.length < 2 { return false }
    // A homogeneous literal union (all members the same `litKind`) is an interned atom, not a
    // box; a mixed-kind literal union (`"x"|7`) can't share one atom rep, so it boxes.
    let allSameLit = true
    // `null` is "no member seen yet" — the vocabulary is a literal union now, so the
    // empty-string sentinel it used has no spelling in the type.
    let litKind: LitKind | null = null
    let i = 0
    while i < t.uMembers.length {
      const m = T.tys[t.uMembers[i]]
      if m is TyLit {
        if litKind == null { litKind = m.litKind }
        else if litKind != m.litKind { allSameLit = false }
      } else {
        allSameLit = false
      }
      i = i + 1
    }
    return !allSameLit
  }
  false
}
// Whether node `ix`'s type is `((...) => ...) | null` (kind 19, nullable closure) — a
// `TyNullable` whose inner is a `TyFunc`. Mirrors `nameIsNulClosure`; the structure excludes
// a nullable non-closure for free.
export function nodeTyIsNulClosure(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    if t.nInner < 0 || t.nInner >= T.tys.length { return false }
    const inner = T.tys[t.nInner]
    if inner is TyFunc { return true }
  }
  false
}
// —— arena-level (Ty-index-keyed) nominal queries ——————————————————————————
// The emitter's `repOf` descriptor derivation classifies types (`Ty`-arena indices), where the
// `nodeTy*` twins above classify a node's recorded type. These expose only the
// checker-private nominal-identity sidecar sets that a structural walk cannot re-derive.
export function tyIxIsVariantMember(ty: i32) {
  if ty < 0 { return false }
  cTyIxSetHas(cVariantMemberTyIxSet, ty)
}
// The declared litunion alias a litunion arena index denotes, or -1: the index itself when it
// is a declared alias, else the recorded source alias when it is a checker-minted copy of one
// (`cLitUnionCopyTyIxs`), else -1 (a genuinely-inline litunion, position-decided by canon). The
// rep layers read this instead of a copy-blind registry test.
export function tyLitUnionAliasIx(ty: i32): i32 {
  if ty < 0 { return -1 }
  if !tyIsLitUnion(ty) { return -1 }
  if cTyIxSetHas(cUnionTyIxSet, ty) { return ty }
  let i = 0
  while i < cLitUnionCopyTyIxs.length {
    if cLitUnionCopyTyIxs[i] == ty { return cLitUnionCopyAliasIxs[i] }
    i = i + 1
  }
  -1
}
// A `{tag, value}` value/struct union BOX at arena level — `isValueUnionBox`,
// exposed under the `ty*` naming for the emitter's descriptor arms.
export function tyIsValueUnionBox(ty: i32) { isValueUnionBox(ty) }
// The nested-array element gate: true when a nested-array element (the `i32[]` in `i32[][]`)
// has a render at all. Asked by both `nodeArrayElemName`'s nested arm and
// `arrLitNestedElemName`'s interning decision, so the annotation and the intern agree on the
// same leaf set (D702).
export function tyNestedArrLeafRenders(elemTy: i32): boolean {
  if elemTy < 0 { return false }
  const el = T.tys[elemTy]
  if el is TyArray {
    if el.aElem < 0 { return false }
    return tyToEmitName(elemTy) != ""
  }
  false
}

// Whether node `ix`'s recorded array element is the `boolean` primitive — structurally, with
// no render and no compare. Replaces `nodeArrayElemName(ix) == "boolean"`, whose `TyPrim` arm
// is a `tyToStructStr` call with no other consumer than that compare.
export function nodeTyArrayElemIsBoolPrim(ix: i32): boolean {
  tyArrayElemPrimIs(nodeTyIxOf(ix), "boolean")
}

// The nested form: an array of arrays whose leaf element is the `boolean` primitive. Replaces
// two grammar cuts over a render (`arrElemNameRaw(arrElemNameRaw(...))`) with two direct
// `TyArray` hops.
export function nodeTyNestedElemIsBoolPrim(ix: i32): boolean {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyArray { return tyArrayElemPrimIs(t.aElem, "boolean") }
  false
}

// The element type name of the array the checker recorded for node `ix` (e.g. `"f64"`, an
// inline `{v: i32}` shape), or "" when `ix` has no recorded concrete array type. A generic
// element (a `TyVar`) returns "" — a generic build's annotation is substituted by the
// monomorphizer per instance. The emitter synthesizes an `<elem>[]` annotation from this.
export function nodeArrayElemName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyArray {
    if t.aElem >= 0 {
      const el = T.tys[t.aElem]
      if el is TyVar { return "" }
      if el is TyPrim { return tyToStructStr(t.aElem) }
      // A STRUCT element renders its inline shape name (`{v: i32}`), which
      // `structIndexOfTypeName` matches to the interned struct by field-set.
      if el is TyObj { return tyToStructStr(t.aElem) }
      // A map element renders the emit name (spaceless `{[K]:V}`), matching the annotated
      // spelling so both intern the same kind-3 ref-list row; the key rides this spelling.
      if el is TyMap { return tyToEmitName(t.aElem) }
      // A value-union element renders the nominal composite (the `unNames` key), so an
      // un-annotated literal of union elements recovers the same box slot; a literal union is excluded.
      if el is TyUnion {
        const aeMems = el.uMembers
        if aeMems.length >= 2 {
          if !tyIsLitUnion(t.aElem) {
            const aeu = tyToNominalName(t.aElem)
            if unionAliasDeclNameOfTy(t.aElem) == "" {
              if structNameOfTy(aeMems[0]) == "" {
                const aer = structUnionRetName(t.aElem, gRootStmts)
                if aer != "" { return aer }
              }
            }
            return aeu
          }
        }
      }
      // A function element renders the closure-element table key (wrapped in parens), matching
      // `refArrElemName`'s form so an un-annotated literal of function values recovers the same slot.
      if el is TyFunc {
        const fn = tyToEmitName(t.aElem)
        if fn == "" { return "" }
        return "(" + fn + ")"
      }
      // A nullable-closure element renders the full `(<fn>)|null` table key via
      // `nullableRetName`, matching `refArrElemName`'s annotated form for the same niche slot.
      if el is TyNullable {
        if el.nInner < 0 || el.nInner >= T.tys.length { return "" }
        const ni = T.tys[el.nInner]
        if ni is TyFunc {
          const stmts: i32[] = []
          return nullableRetName(t.aElem, stmts)
        }
      }
      // A nested-array element renders the inner array's emit name — without it, pushing an
      // array into an inferred empty `[]` stores a ref into an i32 element: check-clean invalid wasm.
      if el is TyArray {
        if !tyNestedArrLeafRenders(t.aElem) { return "" }
        return tyToEmitName(t.aElem)
      }
    }
  }
  ""
}
export function inferLetTyAt(i: i32) { inferLetTy[i] }

// The canonical emit render of node `ix`'s recorded struct type (`tyToEmitName` — spaceless,
// litunion-alias preserving), or "" when not a `TyObj` or unrepresentable. Tried before
// `nodeTyName`'s spaced render, which flattens an alias field and can match the wrong
// same-fieldset row. Scoped to the resolution site so annotation-synthesis keeps its own spelling.
export function nodeTyCanonObjName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyObj {
    // A recursive type (`type L = {n: L | null}`) has no finite canonical render — `tyToEmitName`
    // carries no back-edge vocabulary, so this declines past depth 16 rather than recursing unboundedly.
    if tyDeeperThan(ty, 16) { return "" }
    return tyToEmitName(ty)
  }
  ""
}

// Whether node `ix`'s recorded type is the `string` primitive — asked of the arena instead of
// `nodeTyName(ix) == "string"`, which rendered a spelling only to compare it against a
// constant. `TyPrim`-only, deliberately: a literal union canon-softens to `string` at several
// positions, and a caller that wants the softened answer should read the render instead.
export function nodeTyIsStringPrim(ix: i32): boolean {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyPrim { return t.primName == "string" }
  false
}

// The rendered name of the scalar/string type the checker recorded for node `ix` (`"f64"`,
// `"string"`, `"i32"`, ...), or "" when none, generic, or composite. The emitter reads this for
// an un-annotated callback param (`xs.map((x) => ...)`) to synthesize its annotation, so the
// param's valtype follows the contextually-inferred element instead of defaulting to i32.
export function nodeTyName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyPrim {
    if t.primName == "void" { return "" }
    return tyToStructStr(ty)
  }
  // A struct type renders its inline shape; `synthParamAnnots` resolves that to the declared
  // struct's nominal name, so an un-annotated struct-element callback param gets the same annotation.
  if t is TyObj { return tyToStructStr(ty) }
  // A FUNCTION type renders its closure-annotation name (`(i32) => i32`) so an un-annotated
  // closure VALUE from a call result (`const g = f(4)`) recovers a sig-keyable name.
  if t is TyFunc { return tyToEmitName(ty) }
  // A ref-list type renders its recursive emit name so an un-annotated ref-list callback param
  // recovers a name `synthParamAnnots` resolves — without it the param defaulted silently to i32.
  if t is TyArray { return tyToEmitName(ty) }
  ""
}

// Whether node `ix`'s recorded type is a value union (`Cat | Dog`, 2+ members) — a `TyNullable`
// is excluded. Lets `synthParamAnnots` give an un-annotated union-element callback param a
// union annotation. This is the checker's view, distinct from `exprUnion` (the emitter's rep
// classification) — the two disagree wherever a rep classifier has a gap.
export function nodeTyIsUnion(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyUnion { return t.uMembers.length >= 2 }
  false
}

// Completeness of a substitution: does `ty` still contain an unresolved `TyVar` anywhere
// inside it? `substTyDeep` rebuilds only children that changed, so an unbound type parameter
// is left in place rather than reported — recording a partly-substituted return type on a
// monomorphized instance is a wrong type. Depth-bounded; running out of depth returns true.
export function tyHasTyVar(ty: i32) { tyHasTyVarGo(ty, 12) }

function tyHasTyVarGo(ty: i32, depth: i32) {
  if ty < 0 { return false }
  if depth <= 0 { return true }
  const t = T.tys[ty]
  if t is TyVar { return true }
  if t is TyArray { return tyHasTyVarGo(t.aElem, depth - 1) }
  if t is TyNullable { return tyHasTyVarGo(t.nInner, depth - 1) }
  if t is TyNeg { return tyHasTyVarGo(t.negTy, depth - 1) }
  if t is TyMap {
    if tyHasTyVarGo(t.mKey, depth - 1) { return true }
    return tyHasTyVarGo(t.mVal, depth - 1)
  }
  if t is TyObj {
    const fs = t.objFieldTypes
    let i = 0
    while i < fs.length {
      if tyHasTyVarGo(fs[i], depth - 1) { return true }
      i = i + 1
    }
    return false
  }
  if t is TyFunc {
    const ps = t.fnParamTypes
    let k = 0
    while k < ps.length {
      if tyHasTyVarGo(ps[k], depth - 1) { return true }
      k = k + 1
    }
    return tyHasTyVarGo(t.fnRet, depth - 1)
  }
  if t is TyUnion {
    const ms = t.uMembers
    let u = 0
    while u < ms.length {
      if tyHasTyVarGo(ms[u], depth - 1) { return true }
      u = u + 1
    }
    return false
  }
  false
}

// Whether `ty` carries a literal anywhere in its member tree, so its `RC_ROOT` emit render is
// lossy: `ctxKeepsLitUnion` is false at `RC_ROOT`, so `"pp" | "qq"`, `1 | 2` and `K | string`
// all render as the base scalar their members soften to. Two such types render alike without
// denoting the same value set, so any equality test over `tyToEmitName` must decline them.
export function tyRenderSoftensLits(ty: i32) { tyRenderSoftensLitsGo(ty, 8) }

function tyRenderSoftensLitsGo(ty: i32, depth: i32) {
  if ty < 0 || depth <= 0 { return false }
  const t = T.tys[ty]
  if t is TyLit { return true }
  if t is TyUnion {
    const ms = t.uMembers
    let i = 0
    while i < ms.length {
      if tyRenderSoftensLitsGo(ms[i], depth - 1) { return true }
      i = i + 1
    }
  }
  false
}

// `tyIsLitUnion` including its one-member spelling — a bare string `TyLit`, which is not a
// `TyUnion` and so answers no there. Deliberately a second predicate rather than a widening of
// `tyIsLitUnion`, which decides the rep of a declared type at a dozen sites where a bare
// `"aa"` annotation reps as a real string today. Only the conversion seam asks this one.
export function tyIsLitUnionOrLit(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyLit { return t.litKind == "str" }
  tyIsLitUnion(ty)
}

// Whether `ty` is a union whose members are all string-literal types (`"a" | "b"`) — a
// "literal union", which the emitter lowers as an interned i32 atom, one id per member string.
export function tyIsLitUnion(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyUnion {
    if t.uMembers.length < 1 { return false }
    let i = 0
    while i < t.uMembers.length {
      const m = T.tys[t.uMembers[i]]
      if m is TyLit {
        if m.litKind != "str" { return false }
      } else {
        return false
      }
      i = i + 1
    }
    return true
  }
  false
}

// Whether type-arena entry `ty` is an array whose element is a literal union (`K[]`, an
// inline `("a"|"b")[]`) — `nameIsLitUnionArray`'s structural dual. Exactly one `TyArray` hop is
// taken; a 2-D `K[][]`, a `(K | null)[]`, and a `("a"|"b"|null)[]` all answer false here just
// as the name path does.
export function tyIsLitUnionArray(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyArray {
    const r = tyIsLitUnion(t.aElem)
    return r
  }
  false
}

// The base scalar (`"i32"`/`"i64"`/`"f64"`) an array's numeric literal-union element reps as,
// or "" when `ty` is not an array over one — the numeric twin of `tyIsLitUnionArray`, a value
// rather than a predicate because the three bases pick three different list wrappers (unlike
// the string family, which has one rep and so a plain yes/no answers it).
export function numLitUnionArrayBaseName(ty: i32): string {
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyArray { return numLitUnionBaseName(t.aElem) }
  ""
}

// Whether the named type `name` (a `type K = "a" | "b"` alias) is a literal union — the
// emitter's annotation-side query (the checker preserves literal members even though the
// emit-side `udVariants` are widened to `"string"`).
export function nameIsLitUnionType(name: string) {
  const luHit = cUserTypes[name]
  if luHit is i32 {
    const ti = luHit
    const r = tyIsLitUnion(ti)
    return r
  }
  // An inline (un-aliased) literal union carries its members directly in the synthetic name
  // (no `cUserTypes` entry) — 2+ top-level members, every one a quoted string literal.
  const inl = nameIsInlineLitUnion(name)
  inl
}

// Whether the synthetic type name `name` is an inline literal union: 2+ top-level
// `|`-separated members, each a quoted string literal. A mixed member or a single literal
// fails — those are value unions / nullables / single-literal types, not atom unions.
export function nameIsInlineLitUnion(name: string) {
  // A cheap reject before the allocating split: an inline literal-union name always begins
  // with a quoted member, which skips every ordinary name without allocating.
  if name.length < 1 { return false }
  if !nameIsQuotedLeaf(name) { return false }
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  if atoms.length < 2 { return false }
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    if a.length < 2 { return false }
    if !nameIsQuotedLeaf(a) { return false }
    i = i + 1
  }
  true
}

// Whether `ti` is a `TyMap` whose value — at any map-nesting depth, one nullable wrapper
// peeled per level — is a literal union. The map-value usage arm of `anyLitUnionUsed`.
function tyMapValIsLitUnion(ti: i32, depth: i32): boolean {
  if ti < 0 || depth <= 0 { return false }
  const t = T.tys[ti]
  if t is TyMap {
    let v = t.mVal
    if v < 0 { return false }
    const vt = T.tys[v]
    if vt is TyNullable { v = vt.nInner }
    if v < 0 { return false }
    if tyIsLitUnion(v) { return true }
    return tyMapValIsLitUnion(v, depth - 1)
  }
  false
}

// Whether the program uses any literal-union type — a single `P.nodes` pass, run once, so the
// emitter's per-node atom detectors can early-out when none exists. Every usage surfaces as a
// `TypeRef` annotation, so one scan via `nameIsLitUnionType` covers both named and inline forms.
export function anyLitUnionUsed() {
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is TypeRef {
      // A litunion used only as a map value counts too — without detecting it here, compare/print
      // classifiers would treat the interned atom id as a string, invalid wasm at the read.
      if tyMapValIsLitUnion(nodeTyIxOf(i), 4) { return true }
    }
    // A litunion used only as an array element (or any expression the checker typed as one)
    // also counts — checked on the recorded type, not the annotation name, at every node.
    if nodeTyIsLitUnion(i) { return true }
    if nodeTyIsNulLitUnion(i) { return true }
    if nodeArrayElemIsLitUnion(i) { return true }
    i = i + 1
  }
  false
}

// The element type of node `ix`'s array type, or -1 — the public reader of
// `nodeArrayElemPeelTy` for callers that need the element type itself rather than a
// yes/no about it (the emitter's atom-widening path needs the members).
export function nodeArrayElemTyIx(ix: i32) {
  const pty = nodeArrayElemPeelTy(ix)
  if pty < 0 { return -1 }
  const t = T.tys[pty]
  if t is TyArray { return t.aElem }
  -1
}

// Whether node `ix` has a recorded array type whose element is a literal union (`K[]`) — a
// direct `Ty` check, no name round-trip (a rendered `"a" | "b"` would not re-parse).
export function nodeArrayElemIsLitUnion(ix: i32) {
  const pty = nodeArrayElemPeelTy(ix)
  if pty < 0 { return false }
  const t = T.tys[pty]
  if t is TyArray {
    const r = tyIsLitUnion(t.aElem)
    return r
  }
  false
}

// The recorded type of node `ix` with one nullable wrapper peeled — a nullable-list receiver
// (`(K | null)[] | null`) indexed in its checker-proved non-null branch still records the
// nullable type on the receiver node, so the element probes below must see through the
// wrapper. -1 (out-of-arena) when unrecorded.
function nodeArrayElemPeelTy(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyNullable { return t.nInner }
  ty
}

// Whether node `ix` has a recorded array type whose element is `boolean | null` (a
// `(boolean | null)[]` literal). The emitter seeds `pendingNulBool` for such a literal's
// elements so a `null` element lowers as the sentinel 2.
export function nodeArrayElemIsNulBool(ix: i32) {
  const pty = nodeArrayElemPeelTy(ix)
  if pty < 0 { return false }
  const t = T.tys[pty]
  if t is TyArray {
    const e = t.aElem
    if e >= 0 {
      const et = T.tys[e]
      if et is TyNullable {
        if et.nInner < 0 || et.nInner >= T.tys.length { return false }
        const en = T.tys[et.nInner]
        if en is TyPrim { return en.primName == "boolean" }
      }
    }
  }
  false
}

// Whether node `ix` has a recorded array type whose element is a plain `string` — the
// non-null twin of `nodeArrayElemIsNulStr`. Needed because `arrLitIsStr` classifies a literal
// by its first element, so an atom-first literal under a `string[]` annotation built the atom
// list while the binding's slot held the string wrapper (check-clean invalid wasm without this).
export function nodeArrayElemIsStr(ix: i32) {
  const pty = nodeArrayElemPeelTy(ix)
  if pty < 0 { return false }
  const t = T.tys[pty]
  if t is TyArray {
    const e = t.aElem
    if e >= 0 {
      const et = T.tys[e]
      if et is TyPrim { return et.primName == "string" }
    }
  }
  false
}

// Whether node `ix` has a recorded array type whose element is a bare string literal — the
// one-member spelling `nodeArrayElemIsLitUnion` declines, since that asks `tyIsLitUnion` and a
// `"a"` is a `TyLit`, not a `TyUnion` (D1460). The list this reps as is the string one, not the
// atom one, so it is a sibling of `nodeArrayElemIsStr` rather than of the litunion exclusion.
export function nodeArrayElemIsBareStrLit(ix: i32) {
  const pty = nodeArrayElemPeelTy(ix)
  if pty < 0 { return false }
  const t = T.tys[pty]
  if t is TyArray {
    const e = t.aElem
    if e >= 0 {
      const et = T.tys[e]
      if et is TyLit { return et.litKind == "str" }
    }
  }
  false
}

// Whether node `ix` has a recorded array type whose element is `string | null`. The element is
// stored `(ref null $sTypeIdx)`, so a read `p[i]` stays nullable rather than recovering
// non-null the way a plain `string[]` element does. Mirrors `nodeArrayElemIsNulBool`.
export function nodeArrayElemIsNulStr(ix: i32) {
  const pty = nodeArrayElemPeelTy(ix)
  if pty < 0 { return false }
  const t = T.tys[pty]
  if t is TyArray {
    const e = t.aElem
    if e >= 0 {
      const et = T.tys[e]
      if et is TyNullable {
        if et.nInner < 0 || et.nInner >= T.tys.length { return false }
        const en = T.tys[et.nInner]
        if en is TyPrim { return en.primName == "string" }
      }
    }
  }
  false
}

// Whether node `ix` has a recorded array type whose element is `K | null` (a literal union
// made nullable). The emitter seeds `pendingLitUnion` (member literals lower as their interned
// ids) and `pendingNulLitUnion` (a `null` element lowers as the sentinel `-1`) — the atom-niche
// analogue of `nodeArrayElemIsNulBool`.
export function nodeArrayElemIsNulLitUnion(ix: i32) {
  const pty = nodeArrayElemPeelTy(ix)
  if pty < 0 { return false }
  const t = T.tys[pty]
  if t is TyArray { return tyIsNullableLitUnion(t.aElem) }
  false
}
// Whether type `ty` is a nullable literal union — either the two-part form `K | null` (a
// `TyNullable` over a litunion) or the expanded member form `"a" | "b" | null` (a `TyUnion`
// with a null member and every other member a string literal). Both must classify as the atom
// niche, since an adopted annotation gives one form and an inferred element type the other.
export function tyIsNullableLitUnion(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable { return tyIsLitUnion(t.nInner) }
  if t is TyUnion {
    if t.uMembers.length < 2 { return false }
    let sawNull = false
    let sawLit = false
    let i = 0
    while i < t.uMembers.length {
      const m = T.tys[t.uMembers[i]]
      if m is TyPrim {
        if m.primName != "null" { return false }
        sawNull = true
      } else if m is TyLit {
        if m.litKind != "str" { return false }
        sawLit = true
      } else {
        return false
      }
      i = i + 1
    }
    return sawNull && sawLit
  }
  false
}

// —— the one home for "does a value of this type occupy one i32 cell" ——————————
// Two questions, decided by different machinery, both asked by three call sites
// (`eqCmpKindOfArrayElem`, `concatElemIsI32Backed`, `tyScalarBackedListKind`) that share one
// function rather than three private copies — disagreement between them writes a module the engine refuses.

// Whether a `| null` reps as an i32 sentinel niche rather than a `(ref null ...)` niche or a
// value box — `boolean | null` (spare 2) or a string literal union `K | null` (spare -1).
// Asked here so the rep home and the comparability home read one function. Not the numeric
// literal unions: `repOfNullable` asks the string-only `tyIsLitUnion`, so those stay a box.
export function tyIsI32SentinelNullable(ty: i32): boolean {
  if tyIsNullableLitUnion(ty) { return true }
  isNulBoolTy(ty)
}

// Whether a literal union reps as one i32 cell: an all-string union (interned atoms) or an
// all-numeric one whose single base is `i32`. No `f32` arm: `litBaseTy` never answers `f32` for
// a pure literal union, so this predicate cannot be asked about one. An `i64`/`f64`-based union
// is a different wrapper and must NOT match, or `+` writes a module the engine refuses (D102).
export function tyLitUnionIsI32Backed(ty: i32): boolean {
  if tyIsLitUnion(ty) { return true }
  numLitUnionBaseName(ty) == "i32"
}

// Whether type `ty` is a nullable numeric literal union — `1 | 2 | null`, or `Z | null` over
// `type Z = 1 | 2` — and if so, which base scalar its non-null members rep as; "" otherwise.
// The numeric twin of `tyIsNullableLitUnion` (string-only). Asked separately from
// `numLitUnionBaseName`, which declines the moment a member is not a `TyLit` (the `null` is one).
export function nulNumLitUnionBaseName(ty: i32): string {
  if ty < 0 { return "" }
  const t = T.tys[ty]
  // The two-part spelling: `TyNullable` over a homogeneous numeric litunion.
  if t is TyNullable { return numLitUnionBaseName(t.nInner) }
  if t is TyUnion {
    if t.uMembers.length < 2 { return "" }
    let sawNull = false
    let base = -1
    let i = 0
    while i < t.uMembers.length {
      const m = T.tys[t.uMembers[i]]
      if m is TyPrim {
        if m.primName != "null" { return "" }
        sawNull = true
      } else if m is TyLit {
        if m.litKind == "str" { return "" }
        // The per-member soften and one-base requirement mirror `softenLitTy`'s union arm minus
        // its all-`TyLit` precondition; a mixed-width member set (`1 | 2.5 | null`) answers "".
        const b = litBaseTy(m)
        if base < 0 { base = b }
        else if base != b { return "" }
      } else {
        return "" // a non-literal non-null member is an ordinary heterogeneous box
      }
      i = i + 1
    }
    if !sawNull { return "" }
    if base < 0 { return "" }
    const bt = T.tys[base]
    if bt is TyPrim {
      const bn = bt.primName
      if bn == "i32" || bn == "i64" || bn == "f64" { return bn }
    }
    return ""
  }
  ""
}

// The emitter's per-NODE query for the rule above: node `ix`'s recorded type is a nullable
// numeric literal union, so its cell is the value-union box.
export function nodeTyIsNulNumLitUnion(ix: i32) {
  nulNumLitUnionBaseName(nodeTyIxOf(ix)) != ""
}

// The emitter's per-node query: node `ix` has a recorded literal-union type.
export function nodeTyIsLitUnion(ix: i32) {
  const r = tyIsLitUnion(nodeTyIxOf(ix))
  return r
}

// Whether array-element type `ty` is a niche-nullable scalar the emitter reps without a box —
// `K | null` (litunion atom, sentinel `-1`), `boolean | null` (sentinel 2), `string | null`
// (`(ref null $sTypeIdx)`). Gates the ArrayLit context-adoption recording: a literal accepted
// by such an element target is the niche list.
function tyIsNicheNulScalarElem(ty: i32): boolean {
  if tyIsNullableLitUnion(ty) { return true }
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    if t.nInner < 0 || t.nInner >= T.tys.length { return false }
    const inn = T.tys[t.nInner]
    if inn is TyPrim {
      return inn.primName == "boolean" || inn.primName == "string"
    }
  }
  false
}

// Whether node `ix`'s recorded type is a map whose value is a numeric literal union
// (`{[string]: 1.5 | 2.5}`). Needed separately because `tyIsLitUnion` is string-only by
// construction, and the kind table can't answer either — a numeric litunion reps as its base
// scalar, interning an ordinary f64/i32 slot whose nullable is the `-1` niche, not a value box.
export function nodeTyMapValIsNumLitUnion(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyMap { return numLitUnionHasBase(t.mVal) }
  false
}

// Whether node `ix`'s recorded type is a string-keyed map whose value is a literal union — the
// atom-valued mono map (each value is the interned atom id, a plain i32). The map store /
// `??`-default sites read this off the receiver to seed the atom context.
export function nodeTyMapValIsLitUnion(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyMap { return tyIsLitUnion(t.mVal) }
  false
}

// Whether node `ix`'s recorded type is a string-keyed map whose value is a nullable literal
// union (`{[string]: K | null}`): each value is the interned atom id with the `-1` null
// sentinel — still the mono i32 map. Admits a bare `null` alongside the member literals.
export function nodeTyMapValIsNulLitUnion(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyMap { return tyIsNullableLitUnion(t.mVal) }
  false
}

// Whether node `ix`'s recorded type is a string-keyed map whose value is `boolean | null`:
// each value is 0/1 with the `2` null sentinel — still the mono i32 map. The `??`-default
// emitter reads this to coalesce a stored null as well as a missing key.
export function nodeTyMapValIsNulBool(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if !(t is TyMap) { return false }
  const mv = T.tys[t.mVal]
  if mv is TyNullable { return primNameOf(mv.nInner) == "boolean" }
  if mv is TyUnion {
    if mv.uMembers.length != 2 { return false }
    let sawNull = false
    let sawBool = false
    let i = 0
    while i < mv.uMembers.length {
      const m = T.tys[mv.uMembers[i]]
      if m is TyPrim {
        if m.primName == "null" { sawNull = true }
        else if m.primName == "boolean" { sawBool = true }
      }
      i = i + 1
    }
    return sawNull && sawBool
  }
  false
}

// Whether node `ix`'s recorded type is a map whose value is a plain `boolean` — the mono i32
// map with 0/1 values and the `2` niche still spare. A bare read `m[k]` types `boolean | null`
// (a missing key is null), so its miss arm must yield that spare sentinel — the
// non-nullable-value dual of `nodeTyMapValIsNulBool`, read beside it.
export function nodeTyMapValIsBool(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyMap { return primNameOf(t.mVal) == "boolean" }
  false
}

// The map receiver node of a fused map read — `m[k]` and its method spelling `m.get(k)` are
// the same fused get, so every rule keying a `??` on the receiver's value type must see both
// or it is taught half a set. Returns the receiver node index, or -1 when `lhsIx` is not a
// read shape — deliberately a pure shape query; the caller still asks the receiver's own type.
export function fusedMapReadRecvIx(lhsIx: i32) {
  if lhsIx < 0 { return -1 }
  const l = P.nodes[lhsIx]
  if l is Index { return l.idxArr }
  if l is Call {
    const c = P.nodes[l.callFn]
    if c is Member {
      if c.memProp == "get" {
        if l.callArgs.length == 1 { return c.memObj }
      }
    }
  }
  -1
}

// The member literal texts (raw lexeme, no quotes) of the value literal union of node `ix`'s
// recorded map type — the atom-map dual of `nodeLitUnionMemberTexts`. Empty if `ix` is not an
// atom-valued map. The `??`-default gate checks the default literal is a member.
export function nodeTyMapValLitUnionTexts(ix: i32) {
  const out: string[] = []
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return out }
  const t = T.tys[ty]
  if t is TyMap {
    if !tyIsLitUnion(t.mVal) && !tyIsNullableLitUnion(t.mVal) { return out }
    let mv = t.mVal
    const mvN = T.tys[mv]
    if mvN is TyNullable { mv = mvN.nInner }
    const v = T.tys[mv]
    if v is TyUnion {
      let i = 0
      while i < v.uMembers.length {
        const m = T.tys[v.uMembers[i]]
        if m is TyLit {
          if m.litKind == "str" { out.push(m.litText) }
        }
        i = i + 1
      }
    }
  }
  out
}

// The member lexemes of a literal set — a bare `TyLit`, or a `TyUnion` whose members are all
// `TyLit` — in declaration order, empty for every other type (D1023's discriminant query).
// Lexemes, not texts: a string member comes back quoted, a numeric one bare, matching what
// `emitLitMemberEq` reads to pick string vs numeric equality. A mixed set (`"a" | 1`) returns too.
export function tyLitSetMemberLexes(ty: i32) {
  const out: string[] = []
  if ty < 0 { return out }
  const t = T.tys[ty]
  if t is TyLit {
    if t.litKind == "str" {
      out.push("\"" + t.litText + "\"")
    } else {
      out.push(t.litText)
    }
    return out
  }
  if t is TyUnion {
    if t.uMembers.length < 1 { return out }
    let i = 0
    while i < t.uMembers.length {
      const m = T.tys[t.uMembers[i]]
      if m is TyLit {
        if m.litKind == "str" {
          out.push("\"" + m.litText + "\"")
        } else {
          out.push(m.litText)
        }
      } else {
        // Not a literal set: one non-literal member disqualifies the whole type, or a caller
        // could build a membership chain answering false for every legal non-literal value.
        return emptyTextList()
      }
      i = i + 1
    }
    return out
  }
  out
}

// True if `ty` denotes a literal SET — the predicate half of `tyLitSetMemberLexes`, for a
// caller that only needs the yes/no (the variant field row's `-1` decision).
export function tyIsLitSet(ty: i32): boolean {
  tyLitSetMemberLexes(ty).length > 0
}

// The member literal texts (raw lexeme, no quotes) of atom-repped type `ty`, in source order:
// every string-literal member of a union, or the single text of a bare literal type. Empty for
// anything else, including a nullable (`K | null`) — the null arm has no member text, so a
// caller reading an empty list off a nullable must say so, not emit a chain matching nothing.
export function tyLitMemberTexts(ty: i32) {
  const out: string[] = []
  if ty < 0 { return out }
  const t = T.tys[ty]
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      const m = T.tys[t.uMembers[i]]
      if m is TyLit {
        if m.litKind == "str" { out.push(m.litText) }
      }
      i = i + 1
    }
    return out
  }
  if t is TyLit {
    if t.litKind == "str" { out.push(t.litText) }
  }
  out
}

// The member literal texts of node `ix`'s literal-union type, in source order — for widening
// an atom to its member `string`. Empty if `ix`'s recorded type is not a union, which
// deliberately excludes both a bare literal and a `K | null` nullable.
export function nodeLitUnionMemberTexts(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return emptyTextList() }
  const t = T.tys[ty]
  if t is TyUnion { return tyLitMemberTexts(ty) }
  emptyTextList()
}

// The member literal texts of node `ix`'s nullable literal-union type — both spellings (`K |
// null`, and the expanded `"a" | "b" | null`). The null arm contributes no text, so the list is
// exactly the widenable members. Empty when `ix` is not the nullable niche — how `print`'s
// dispatch tells the two widening chains apart, asked first since the expanded spelling satisfies both.
export function nodeNulLitUnionMemberTexts(ix: i32) {
  const ty = nulLitUnionPeelTy(nodeTyIxOf(ix))
  if ty < 0 { return emptyTextList() }
  tyLitMemberTexts(ty)
}

// Peels every nullable wrapper off `ty` and answers the arena index of the litunion
// underneath, or -1 when `ty` is not the nullable niche (a bare litunion included — it needs
// no sentinel arm). Depth matters: a bare read over `{[string]: K | null}` types `K | null |
// null`, so a one-wrapper peel would misread a value that IS the niche as "not a niche".
function nulLitUnionPeelTy(ty: i32): i32 {
  if ty < 0 { return 0 - 1 }
  const t = T.tys[ty]
  if t is TyNullable {
    if tyIsLitUnion(t.nInner) { return t.nInner }
    return nulLitUnionPeelTy(t.nInner)
  }
  if tyIsNullableLitUnion(ty) { return ty }
  0 - 1
}

// A fresh empty `string[]` — `nodeLitUnionMemberTexts`'s two decline arms, which must each hand back a
// list the caller may keep (the emitter's widening loops read `.length` on it).
function emptyTextList() {
  const out: string[] = []
  out
}

// Whether node `ix`'s recorded type has at least one string-literal member and every one also
// appears in `texts` — the question `k is T` folds to a constant true on. A nullable node
// answers false by construction (`tyLitMemberTexts` declines it): its null arm is a member of
// no tested set, so `K | null is K` is a runtime test, not a constant.
export function nodeLitMembersWithin(ix: i32, texts: string[]) {
  const mine = tyLitMemberTexts(nodeTyIxOf(ix))
  if mine.length == 0 { return false }
  let i = 0
  while i < mine.length {
    let found = false
    let j = 0
    while j < texts.length {
      if texts[j] == mine[i] { found = true }
      j = j + 1
    }
    if !found { return false }
    i = i + 1
  }
  true
}

// Whether node `ix` has a recorded object (struct) type — a cheap, no-render variant-tag
// check. Gates the emitter's `nodeTyName`-rendering struct fallback so the costly `tyToStr`
// runs only on a confirmed struct receiver the syntactic cases missed.
export function nodeTyIsObj(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  t is TyObj
}

// Whether node `ix`'s recorded type reaches a map — through a `TyNullable` hop or as a member
// of a `TyUnion`, not only as a bare `TyMap`. The span twin of `nameIsMap`, which accepts
// `{[string]:i32} | null` and `{[string]:V} | i64` alike. The exact twin (`nodeTyIsMap`) is not
// interchangeable — substituting it moved corpus rows at `fnHasMapParam`.
export function nodeTyReachesMap(ix: i32): boolean {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  tyReachesMap(ty)
}

function tyReachesMap(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyMap { return true }
  if t is TyNullable { return tyReachesMap(t.nInner) }
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if tyReachesMap(t.uMembers[i]) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// Whether node `ix` has a recorded map type (`{[K]: V}`) — a cheap, no-render variant-tag
// check, the map dual of `nodeTyIsObj`. Gates the emitter's map classifiers so a map-returning
// closure value call whose callee they miss still routes through the map lowering.
export function nodeTyIsMap(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  t is TyMap
}

// The emitter-format value type name of node `ix`'s recorded map type (`string` for
// `{[string]: string}`), or "" if `ix` is not a map. Renders the value type, so the emitter
// calls it only as a map-shape fallback (`mapShapeOfExpr`), never on the hot path.
export function nodeTyMapValName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyMap { return tyToEmitName(t.mVal) }
  ""
}

// The whole map spelling of node `ix`'s recorded map type — `{[K]:V}`, character-for-character
// the synthetic name `parseType` builds for an annotated map. "" when `ix` is not a map or
// either half is still a hole. The key-and-value twin of `nodeTyMapValName`, for consumers
// (`emit_mono.monoArgTyName`) that need the map's own identity, not its value's.
export function nodeTyMapName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyMap { return tyToEmitName(ty) }
  ""
}

// Whether node `ix`'s recorded type is an i32-keyed map (`{[i32]: V}`), one `| null` wrapper
// tolerated — the span form `nameIsI32KeyedMap` has (accepting `{[i32]: V}[]` too). Kept wider
// than the exact twin `nodeTyMapKeyIsI32` deliberately: its callers are type-minting flags,
// where under-answering leaves a needed type unminted and the module invalid.
export function nodeTyMapKeyIsI32Span(ix: i32): boolean {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  tyMapKeyIsI32Span(ty)
}

function tyMapKeyIsI32Span(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyMap { return mapKeyRepTy(t.mKey) == TY_I32 }
  if t is TyNullable { return tyMapKeyIsI32Span(t.nInner) }
  if t is TyArray { return tyMapKeyIsI32Span(t.aElem) }
  false
}

export function nodeTyMapKeyIsI32(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    if t.nInner < 0 || t.nInner >= T.tys.length { return false }
    const it = T.tys[t.nInner]
    if it is TyMap { return mapKeyRepTy(it.mKey) == TY_I32 }
    return false
  }
  if t is TyMap { return mapKeyRepTy(t.mKey) == TY_I32 }
  false
}

// Whether node `ix` has a recorded nullable-struct type (`P | null`) — a cheap, no-render
// check. The nullable dual of `nodeTyIsObj`: gates the emitter's nullable consumer
// classifiers so a nullable-struct-returning closure value call whose callee they miss still classifies.
export function nodeTyIsNullableStruct(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    if t.nInner < 0 || t.nInner >= T.tys.length { return false }
    const it = T.tys[t.nInner]
    return it is TyObj
  }
  false
}

// Whether node `ix`'s recorded type is `T | null` for one rep — a `TyNullable` whose inner is
// not a value union. The gate the emitter's if-expression rep rung reads (D1560): `joinTys`
// folds two nullable arms of different shapes into a union box, whose rep is neither arm's
// niche — a rung that took its rep from one arm would name a heap type the other member can't hold.
export function nodeTyIsNullableOneRep(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    // D1575 — an open hole is not "one rep", it is no rep at all: answer false so the `??`
    // rewrite declines and the loud refusal it already owes lands, rather than reading arena -1.
    if t.nInner < 0 || t.nInner >= T.tys.length { return false }
    if tyIsLitUnion(t.nInner) { return true }
    if T.tys[t.nInner] is TyUnion { return false }
    return true
  }
  false
}

// True if node `ix` has a recorded NULLABLE type (`TyNullable`, any inner). The emitter
// uses it to decide whether a `??` result stays nullable — a `?? null` (or a nullable-typed
// default) leaves the coalesce result nullable, so the ref-value recover must be skipped.
export function nodeTyIsNullable(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  T.tys[ty] is TyNullable
}

// Whether node `ix`'s recorded type provably admits no `null` — not `!nodeTyIsNullable(ix)`,
// since an unrecorded node, an inference hole, or a `TyVar` all answer "not nullable" there
// while being unknown here. Every "don't know" answers false, since the one consumer (`??`
// over a non-nullable lhs) turns a wrong true into a rep mismatch, invalid wasm.
export function nodeTyExcludesNull(ix: i32) { tyExcludesNull(nodeTyIxOf(ix)) }

// The type-level half of `nodeTyExcludesNull` — shared so the CHECKER (which holds a
// type, not a node) and the emit-time fold (which holds a node) cannot disagree about
// which left operands make a `??` redundant.
export function tyExcludesNull(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable { return false }
  if t is TyErr { return false }
  if t is TyVar { return false }
  if t is TyNeg { return false }
  // The bare `null` literal is a `TyPrim` — `null ?? d` IS `d`, the one shape where a
  // non-`TyNullable` type is entirely null.
  if isNullTy(ty) { return false }
  if t is TyUnion {
    const ms = t.uMembers
    let i = 0
    while i < ms.length {
      if isNullTy(ms[i]) { return false }
      if T.tys[ms[i]] is TyNullable { return false }
      i = i + 1
    }
  }
  true
}

// Whether node `ix` has a recorded `string | null` type — the niche-string (kind 16) dual of
// `nodeTyIsNullableStruct`. A nullable litunion (`K0 | null`) is excluded first: its emit name
// is also `string` (members dedup to it), but it reps as an i32 atom/`-1` sentinel, not a
// string ref — claiming it kind-16 would store an i32 into a `(ref null $array)` local.
export function nodeTyIsNullableString(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    if tyIsLitUnion(t.nInner) { return false }
    return tyEmitNameIsString(t.nInner)
  }
  false
}

// The emitter-format shape name of a nullable-struct node `ix`'s inner struct (`{x:i32}` for a
// `P | null`), or "" otherwise. Renders, so the emitter calls it only as a struct-index
// fallback — never on the hot path. The nullable sibling of `nodeTyName`, resolving via
// `structIndexOfTypeName`.
export function nodeNulStructInnerName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyNullable {
    if t.nInner < 0 || t.nInner >= T.tys.length { return "" }
    const it = T.tys[t.nInner]
    if it is TyObj { return tyToEmitName(t.nInner) }
  }
  ""
}

// The emitter-format union name of node `ix` (a value union or a struct union), or "" if its
// recorded type is not a 2+-member union. Renders the union (the #494-costly op), so the
// emitter calls it only as a fallback for a union-valued call result whose callee its
// syntactic resolution misses — never on the hot path (annotation-resolved unions are cheap).
export function nodeUnionName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if t is TyUnion {
    if t.uMembers.length >= 2 {
      // Cheaply gates to a value union (all members scalar/literal atoms) before rendering, so
      // a struct union (object members) declines without paying the #494 render cost for nothing.
      let allValue = true
      let i = 0
      while i < t.uMembers.length {
        const mt = T.tys[t.uMembers[i]]
        if !(mt is TyPrim) {
          if !(mt is TyLit) { allValue = false }
        }
        i = i + 1
      }
      if allValue { return valueUnionRetName(ty) }
      // A ref-arm value union (`T[] | {w: i32}`): render its nominal name so a binding narrowed
      // from this fallback unboxes like any annotated union — declines for an anonymous-element arm.
      const ran = refArmUnionRetName(ty, gRootStmts)
      if ran != "" { return ran }
      // A map-member union: render the same spelling `mapUnionRetName` pins on an adopted
      // lambda, so a narrowed map-arm read unboxes exactly like the annotated-binding path.
      const mun = mapUnionRetName(ty)
      if mun != "" { return mun }
      // A mixed variant-box union (>=1 non-object arm): render the same spelling
      // `variantBoxUnionRetName` pins, so a narrowed read unboxes like the annotated path.
      if mixedVariantBoxGate(t.uMembers) {
        const vbn = variantBoxUnionRetName(ty)
        if vbn != "" { return vbn }
        // A closure-arm value union: render the same spelling `cloArmValueUnionRetName` pins,
        // so a narrowed read unboxes exactly like the annotated-binding path.
        const can = cloArmValueUnionRetName(ty)
        if can != "" { return can }
      }
    }
  }
  // A nullable value scalar (`i32 | null`) is a `TyNullable`, not a `TyUnion`, yet reps as the
  // value-union box — `isValueUnionName` admits only the numeric nullables, so niches stay "".
  if t is TyNullable {
    const nvn = valueUnionRetName(ty)
    if nvn != "" { return nvn }
    // A nullable variant-box union (`{a,f,z} | i32 | null`): render the same spelling
    // `variantBoxUnionRetName` pins, so the narrowed read unboxes like the annotated path.
    if t.nInner < 0 || t.nInner >= T.tys.length { return "" }
    const nit = T.tys[t.nInner]
    if nit is TyUnion {
      if mixedVariantBoxGate(nit.uMembers) {
        const nvb = variantBoxUnionRetName(ty)
        if nvb != "" { return nvb }
      }
    }
    return ""
  }
  ""
}

// Rolls the inferred-return table back to `mark` — all five columns `recordInferRet` pushes,
// not two. The index (`inferRetIdx`) is deliberately not rolled back: a `.delete()` would be
// costly, and the readers are bounds-checked instead, the same defence at a fraction of the
// cost. Unreachable from the name-keyed recorder — only the node-keyed re-check path calls it.
function rollbackInferRet(mark: i32) {
  while inferRetFn.length > mark { inferRetFn.pop() }
  while inferRetTy.length > mark { inferRetTy.pop() }
  while inferRetTyIx.length > mark { inferRetTyIx.pop() }
  while inferRetAtomCount.length > mark { inferRetAtomCount.pop() }
  while inferRetRung.length > mark { inferRetRung.pop() }
  0
}

// Monomorphic body inference: lifts the element-hole ceiling for an un-annotated param by
// re-checking the shared body with each param bound to `paramTyIxs` (arena indices), fully
// isolated (`inferQuiet`, every append-only table truncated back). Returns the resolved list
// type name of `localName`, or "" when it is not an inferred list or stays generic.
export function monoInferListElem(
  declIx: i32,
  paramTyIxs: i32[],
  localName: string,
  outTy: i32[],
) {
  const noTpN: string[] = []
  const noTpT: i32[] = []
  const sv: i32[] = []
  if !monoRecheckBegin(declIx, paramTyIxs, noTpN, noTpT, sv) { return "" }
  // Read the resolved local: a fully-pinned `T[]` (element not a `TyVar`) renders its
  // list type name; anything else (not a list, or still generic) yields "".
  let listName = ""
  const lt = lookup(localName)
  if lt >= 0 {
    const ltt = T.tys[lt]
    if ltt is TyArray {
      if ltt.aElem >= 0 {
        const el = T.tys[ltt.aElem]
        if !(el is TyVar) {
          listName = tyToStructStr(lt)
          // Hands the arena row out beside the render: `lt` IS the list type, and without this
          // the caller would re-run `nameToTy` on the print, minting a duplicate for composite spellings.
          outTy.push(lt)
        }
      }
    }
  }
  monoRecheckEnd(sv)
  listName
}

// The pinned re-check itself, in one home, opened and closed around the caller's read.
// `monoInferListElem`, `monoInferLocalScalar` and `monoInferRetExprTy` ask the same question,
// differing only in what they read back. Split into begin/end rather than a result selector
// because the read must happen inside the isolation, scope and suppression flags still active.
function monoRecheckBegin(
  declIx: i32,
  paramTyIxs: i32[],
  tpNames: string[],
  tpTys: i32[],
  sv: i32[],
): boolean {
  if declIx < 0 { return false }
  const dn = P.nodes[declIx]
  if !(dn is FuncDecl) { return false }
  const body = P.nodes[dn.fnBody]
  if !(body is Block) { return false }
  // Snapshot the suppression flags and every append-only inference/diagnostic table. The
  // order is the contract `monoRecheckEnd` reads back; keep the two in step.
  let q = 0
  if inferQuiet { q = 1 }
  sv.push(q)
  sv.push(symEnabled)
  sv.push(T.diags.length)
  sv.push(holeShapeNames.length)
  sv.push(holeShapeTys.length)
  sv.push(holeArrayDemand.length)
  sv.push(holeMapNames.length)
  sv.push(holeAltNames.length)
  sv.push(binCstrOp.length)
  sv.push(printCstrTy.length)
  sv.push(inferLetIx.length)
  sv.push(inferLetNulStrIx.length)
  sv.push(inferLetNulBoolIx.length)
  sv.push(inferRetFn.length)
  sv.push(inferStack.length)
  sv.push(inferTentative.length)
  sv.push(redunName.length)
  sv.push(tpEnvNames.length)
  inferQuiet = true
  symEnabled = 0
  // Binds the type parameters too, not only the value ones: `checkFuncDecl` keeps them in
  // scope as an opaque hole, so a body annotation naming one would otherwise stay a hole forever.
  let tpb = 0
  while tpb < tpNames.length {
    if tpb < tpTys.length {
      if tpTys[tpb] >= 0 {
        tpEnvNames.push(tpNames[tpb])
        tpEnvTys.push(tpTys[tpb])
      }
    }
    tpb = tpb + 1
  }
  // Checks the body statements directly in the pushed scope (not via `checkNode` on the
  // block), which would push/pop its own scope and drop the local before it can be read back.
  pushScope(dn.fnBody)
  const params = dn.fnParams
  let pi = 0
  while pi < params.length {
    const p = P.nodes[params[pi]]
    if p is Param {
      let pty = TY_ERR
      if pi < paramTyIxs.length {
        if paramTyIxs[pi] >= 0 { pty = paramTyIxs[pi] }
      }
      declare(p.parName, pty)
    }
    pi = pi + 1
  }
  const stmts = body.blkStmts
  let s = 0
  while s < stmts.length {
    checkNode(stmts[s])
    s = s + 1
  }
  true
}

// The closing half: pops the scope and the type-parameter bindings, truncates every
// append-only table back to `sv`'s saved length, then restores the flags and the diagnostic
// stream — so the global checker state the emitter still reads matches its original values.
function monoRecheckEnd(sv: i32[]) {
  popScope()
  while tpEnvNames.length > sv[17] {
    tpEnvNames.pop()
    tpEnvTys.pop()
  }
  while holeShapeNames.length > sv[3] { holeShapeNames.pop() }
  while holeShapeTys.length > sv[4] { holeShapeTys.pop() }
  while holeArrayDemand.length > sv[5] { holeArrayDemand.pop() }
  while holeMapNames.length > sv[6] {
    holeMapNames.pop()
    holeMapTys.pop()
  }
  while holeAltNames.length > sv[7] {
    holeAltNames.pop()
    holeAltTys.pop()
    holeAltPreN.pop()
    holeAltTailN.pop()
    holeAltHoleIx.pop()
  }
  while binCstrOp.length > sv[8] {
    binCstrOp.pop()
    binCstrLt.pop()
    binCstrRt.pop()
    binCstrFn.pop()
  }
  while printCstrTy.length > sv[9] {
    printCstrTy.pop()
    printCstrIx.pop()
    printCstrFn.pop()
  }
  while inferLetIx.length > sv[10] { inferLetIx.pop() }
  while inferLetTy.length > sv[10] { inferLetTy.pop() }
  while inferLetNulStrIx.length > sv[11] { inferLetNulStrIx.pop() }
  while inferLetNulBoolIx.length > sv[12] { inferLetNulBoolIx.pop() }
  rollbackInferRet(sv[13])
  while inferStack.length > sv[14] { inferStack.pop() }
  while inferTentative.length > sv[15] { inferTentative.pop() }
  redunTruncate(sv[16])
  while T.diags.length > sv[2] { T.diags.pop() }
  symEnabled = sv[1]
  inferQuiet = sv[0] == 1
  0
}

// The scalar sibling of `monoInferListElem`: re-checks the body with params pinned to
// `paramTyIxs` and reads local `localName`'s resolved type, returning its prim name when it
// settles on a concrete non-i32 scalar (`string`/`f64`/`i64`/`f32`), else "". Lets the
// monomorphizer type an un-annotated `return <local>` whose typed-IR the checker left stale.
export function monoInferLocalScalar(
  declIx: i32,
  paramTyIxs: i32[],
  localName: string,
  outTy: i32[],
) {
  const noTpN: string[] = []
  const noTpT: i32[] = []
  const sv: i32[] = []
  if !monoRecheckBegin(declIx, paramTyIxs, noTpN, noTpT, sv) { return "" }
  // Read the resolved local: a concrete non-i32 scalar prim renders its name; anything else
  // (i32/boolean/non-scalar/still-generic) yields "", leaving the inferred-return path untouched.
  let scalarName = ""
  const lt = lookup(localName)
  if lt >= 0 {
    const ltt = T.tys[lt]
    if ltt is TyPrim {
      const pn = ltt.primName
      if monoRetScalarKind(pn) {
        scalarName = pn
        // Hands the arena row out alongside the name: without it, the caller would re-run
        // `nameToTy` on the rendered name to get back the row already held here.
        outTy.push(lt)
      }
    }
  }
  monoRecheckEnd(sv)
  scalarName
}

// The prim names an un-annotated return cannot ride the i32 default for. `i32`, `boolean` and
// `u8` are the i32 valtype the un-annotated functype already defaults to, so naming them here
// would mint an annotation that changes nothing but the emitted bytes.
function monoRetScalarKind(pn: string): boolean {
  pn == "string" || pn == "f64" || pn == "i64" || pn == "f32"
}

// D592 — the un-annotated return's own type, asked of the expression rather than guessed from
// its shape. Without an annotation, `monoMakeInstance` walked a hand-written whitelist of
// return-expression shapes; anything outside it kept the functype result at the `"i32"`
// default. Filtered to the reps that default gets wrong; a still-generic or error type answers "".
export function monoInferRetExprTy(
  declIx: i32,
  paramTyIxs: i32[],
  tpNames: string[],
  tpTys: i32[],
  retIx: i32,
  outTy: i32[],
) {
  if retIx < 0 { return "" }
  const sv: i32[] = []
  if !monoRecheckBegin(declIx, paramTyIxs, tpNames, tpTys, sv) { return "" }
  let retName = ""
  const rt = checkNode(retIx)
  if rt >= 0 {
    if rt != TY_VOID && rt != TY_ERR && !tyHasHole(rt) {
      const rtt = T.tys[rt]
      if rtt is TyPrim {
        if monoRetScalarKind(rtt.primName) {
          retName = rtt.primName
          outTy.push(rt)
        }
      }
      // The struct arm: a struct is no more the i32 default than a `string` is. The render
      // stays inside the isolation; what is printed here is not what gets minted (`monoRetRowName`).
      if rtt is TyObj {
        retName = tyToStructStr(rt)
        outTy.push(rt)
      }
    }
  }
  monoRecheckEnd(sv)
  retName
}

// D1521 — the whole return set at this pin, joined, in the emitter's union vocabulary.
// `monoInferRetExprTy`'s sibling: same isolation, same render-inside-it rule, but reads every
// valued return instead of the singular one. The pin makes the answer legitimate, so the
// name-keyed table must not hold it — one function differs across calls by its pinned types.
export function monoInferRetSetUnionName(
  declIx: i32,
  paramTyIxs: i32[],
  tpNames: string[],
  tpTys: i32[],
  outTy: i32[],
) {
  if declIx < 0 { return "" }
  const dn0 = P.nodes[declIx]
  if !(dn0 is FuncDecl) { return "" }
  const rets: i32[] = []
  a20CollectRets(dn0.fnBody, rets)
  if rets.length < 2 { return "" }
  const sv: i32[] = []
  if !monoRecheckBegin(declIx, paramTyIxs, tpNames, tpTys, sv) { return "" }
  let joined = -1
  let ok = true
  let i = 0
  while i < rets.length {
    const rt = checkNode(rets[i])
    if rt < 0 || rt == TY_VOID || rt == TY_ERR || tyHasHole(rt) { ok = false }
    else if joined < 0 { joined = rt }
    else { joined = joinTys(joined, rt) }
    i = i + 1
  }
  let name = ""
  if ok && joined >= 0 {
    const jt = T.tys[joined]
    if jt is TyUnion {
      if jt.uMembers.length >= 2 {
        name = valueUnionRetName(joined)
        if name == "" { name = structUnionRetName(joined, gRootStmts) }
        if name == "" { name = variantBoxUnionRetName(joined) }
        if name != "" { outTy.push(joined) }
      }
    }
  }
  monoRecheckEnd(sv)
  name
}
// Whether the LetDecl at `letIx` is recorded as an inferred `string | null` niche
// if-binding (the niche analogue of `inferLetNameOf`). The emitter's `letIsNulString`
// consults this so the slot classifies as kind 16 and reuses the annotated lowering.
export function isInferLetNulStr(letIx: i32) {
  let i = 0
  while i < inferLetNulStrIx.length {
    if inferLetNulStrIx[i] == letIx { return true }
    i = i + 1
  }
  false
}

// The `boolean | null` companion of `isInferLetNulStr`: whether the LetDecl at `letIx`
// is recorded as an inferred `boolean | null` niche if-binding. The emitter's
// `letNulBool` consults this so the slot classifies as the niche i32 rep.
export function isInferLetNulBool(letIx: i32) {
  let i = 0
  while i < inferLetNulBoolIx.length {
    if inferLetNulBoolIx[i] == letIx { return true }
    i = i + 1
  }
  false
}

// —— value-union name classification (moved from wasmEmit to break the typecheck<->emitter
// import cycle) ——————————————————————————————————————————————————————————
// An inline union annotation's synthetic name (`"A|B"`) has no `unNames` entry the way a
// named alias does — register it as a union alias too, so the same tables/tags/lookups apply.

// The value-atom kind of a niche-nullable scalar-element list member name — `(boolean |
// null)[]`/`(K | null)[]` share the i32-list backing (kind 7), `(string | null)[]` the
// string-list backing (kind 9); -1 otherwise. Decided over `elem`'s member spans with no
// split and no per-member slice, mirroring the three arms of the splitting form it replaces.

function nulElemListAtomKind(name: string): i32 {
  if name.length < 5 { return -1 }
  const elem = listElemNameOf(name)
  if elem == "" { return -1 }
  if unionMemberCount(elem) < 2 { return -1 }
  let sawNull = false
  let nonNull = 0
  let soloFrom = -1
  let soloTo = -1
  let allQuoted = true
  let st = 0
  let go = true
  while go {
    const at = tyTopIndexOf(elem, '|', '=', st)
    let en = elem.length
    if at >= 0 && elem[at] != '=' { en = at } else { go = false }
    if spanEqAt(elem, st, en, "null") {
      sawNull = true
    } else {
      nonNull = nonNull + 1
      soloFrom = st
      soloTo = en
      if en - st < 2 { allQuoted = false }
      else if elem[st] != '"' { allQuoted = false }
    }
    if go { st = at + 1 }
  }
  if !sawNull { return -1 }
  if nonNull == 0 { return -1 }
  if nonNull == 1 {
    if spanEqAt(elem, soloFrom, soloTo, "boolean") { return 7 }
    if spanEqAt(elem, soloFrom, soloTo, "string") { return 9 }
    if nameIsLitUnionType(elem.slice(soloFrom, soloTo)) { return 7 }
    return -1
  }
  if !allQuoted { return -1 }
  7
}

// Whether `name` is a value union carrying a literal-union alias arm (`K0 | i64`): 2+
// top-level atoms, every atom a value atom/`null`/a declared litunion alias, at least one
// alias arm and 2+ non-null arms. Such a union boxes like a value union — the litunion arm
// rides the box as its member-string atom, so `isValueUnionName` (which declines it) is not enough.
export function nameIsLitUnionArmValueUnion(name: string) {
  // A member the span form recognises as a plain scalar needs no string for either arm — no
  // declaration can be spelled with a primitive keyword, so both questions decide from the span.
  if unionMemberCount(name) < 2 { return false }
  let hasAlias = false
  let nonNull = 0
  let start = 0
  let going = true
  while going {
    const at = tyTopIndexOf(name, '|', '=', start)
    let end = name.length
    if at >= 0 && name[at] != '=' { end = at } else { going = false }
    const sk = valueAtomKindSpan(name, start, end)
    if sk == 6 {
      // the `null` member
    } else if sk >= 0 {
      // A plain scalar span cannot be a declared litunion alias (no declaration is spelled
      // with a primitive keyword) nor an inline one (needs 2+ quoted members) — decided without materializing.
      nonNull = nonNull + 1
    } else {
      const a = name.slice(start, end)
      nonNull = nonNull + 1
      if nameIsLitUnionType(a) { hasAlias = true }
      else if valueAtomKind(a) < 0 { return false }
    }
    if going { start = at + 1 }
  }
  hasAlias && nonNull >= 2
}

// The literal-union element name of a `K[]` / `("a"|"b")[]` array type-name, or "" when
// `name` is not a litunion array. The checker-side twin of the emitter's `nameIsLitUnionArray`
// (which typecheck cannot import): strips the trailing `[]`, peels one grouping-paren layer,
// and requires a litunion. Cheap-rejects any name not ending in `[]`.
function litUnionArrayElemOf(name: string) {
  // Array test + `[]` cut + one naive paren strip = `listElemNameOf` at its home in
  // `tyname.vl`. The `n < 3` cheap reject also makes "not an array" and `"[]"` both answer "".
  if name.length < 3 { return "" }
  const elem = listElemNameOf(name)
  if elem == "" { return "" }
  if nameIsLitUnionType(elem) { return elem }
  ""
}

// The atom kind of a value-union member type name: 0 i32, 1 boolean, 2 string, 3 i64, 4 f64,
// 5 f32, 6 null, 11 closure (a ref atom), 7-10/12/13 scalar-element lists — or -1 for anything
// else (a struct name, an inline shape, a ref-element array). Doubles as the atom's tag offset.
export function valueAtomKind(name: string) {
  if name == "i32" { return 0 }
  if name == "boolean" { return 1 }
  if name == "string" { return 2 }
  if name == "i64" { return 3 }
  if name == "f64" { return 4 }
  if name == "f32" { return 5 }
  if name == "null" { return 6 }
  // A list member of a value union (`i32[] | string`) is a ref atom — the union box's `value`
  // field holds the wrapper ref directly, so each list type needs its own distinct tag code.
  const elem = arrElemNameRaw(name)
  if elem == "i32" || elem == "boolean" { return 7 }
  // A literal-union array (`K[]`) shares the exact `i32[]` backing and rides the same kind-7
  // atom; a real `i32[]`/`boolean[]` member cannot coexist with it in one union (same tag).
  if litUnionArrayElemOf(name) != "" { return 7 }
  if elem == "f64" { return 8 }
  if elem == "string" { return 9 }
  if elem == "i64" { return 10 }
  // The f32 list rides its own atom, distinct from the f64 list's kind 8. Code 12 sits above
  // the closure kind 11 since codes are append-only (each doubles as a tag offset).
  if elem == "f32" { return 12 }
  // The packed byte list `u8[]` rides its own atom over a distinct backing no other list
  // shares; its tag needs the band above it to move (`uAtomBandTop` in `emit_classify`).
  if elem == "u8" { return 13 }
  // A niche-nullable scalar-element list's null rides in the element rep, so the list IS its
  // leaf backing's atom — one kind per backing keeps the `is`-compare tag consistent.
  const nk = nulElemListAtomKind(name)
  if nk >= 0 { return nk }
  // A closure member is a ref atom (kind 11) — the fat-pointer struct rides the box's anyref
  // directly. Checked last so no concrete scalar/list name (none carry a top-level `=>`) reaches it.
  if nameIsFuncTypeAtom(name) { return 11 }
  -1
}

// The value-atom kind of an arena row — `valueAtomKind`'s twin, arm for arm, for callers
// that hold a type instead of a piece of a spelling. Codes are identical and append-only.
// `-2` means the arena declines (a shape this twin does not claim), distinct from `-1`
// (`valueAtomKind`'s own "not a value atom") — a caller must treat -2 as "ask the name".
export function valueRowKind(ty: i32): i32 {
  if ty < 0 { return -2 }
  const t = T.tys[ty]
  if t is TyPrim {
    const pn = t.primName
    if pn == "i32" { return 0 }
    if pn == "boolean" { return 1 }
    if pn == "string" { return 2 }
    if pn == "i64" { return 3 }
    if pn == "f64" { return 4 }
    if pn == "f32" { return 5 }
    if pn == "null" { return 6 }
    return -1 // void / never — not a value atom
  }
  // A closure member rides the box's anyref `value` directly (kind 11).
  if t is TyFunc { return 11 }
  if t is TyArray { return valueRowListKind(t.aElem) }
  // A struct / map is not a value atom; a union row here is an alias arm (`K0` in
  // `K0 | i64`), which `valueAtomKind` answers -1 for by name as well.
  if t is TyObj { return -1 }
  if t is TyMap { return -1 }
  if t is TyLit { return -1 }
  if t is TyUnion { return -1 }
  -2
}

// The list arms of `valueAtomKind`, over the element row rather than the cut spelling.
function valueRowListKind(elem: i32): i32 {
  if elem < 0 { return -2 }
  const e = T.tys[elem]
  if e is TyPrim {
    const en = e.primName
    if en == "i32" || en == "boolean" { return 7 }
    if en == "f64" { return 8 }
    if en == "string" { return 9 }
    if en == "i64" { return 10 }
    if en == "f32" { return 12 }
    // The packed byte list, arm for arm with `valueAtomKind`'s `u8` cut.
    if en == "u8" { return 13 }
    return -1
  }
  // A literal-union ELEMENT list shares the `i32[]` backing (its members are interned
  // atom ids) — `litUnionArrayElemOf`'s arm.
  if tyIsLitUnion(elem) { return 7 }
  // A niche-nullable scalar-element list: the null rides in the element rep, so the list IS
  // its leaf backing's atom — `nulElemListAtomKind`'s arms.
  if e is TyNullable { return valueRowNulElemKind(e.nInner) }
  if e is TyUnion { return valueRowNulElemKind(unionSoleNonNullMember(elem)) }
  -2
}

// The non-null leaf of a niche-nullable list element -> the backing's atom kind.
function valueRowNulElemKind(inner: i32): i32 {
  if inner < 0 { return -2 }
  const it = T.tys[inner]
  if it is TyPrim {
    if it.primName == "boolean" { return 7 }
    if it.primName == "string" { return 9 }
    return -2
  }
  if tyIsLitUnion(inner) { return 7 }
  -2
}

// `isValueUnionName`'s twin over a row. Declines (-1 => "ask the name") whenever any
// member row declines, so a shape this walk does not claim never manufactures an answer.
// Returns 1 = yes, 0 = no, -1 = decline.
export function isValueUnionTyOr(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyUnion { return valueUnionVerdict(t.uMembers, false) }
  // `T | null` is a `TyNullable` wrapper in the arena and two atoms in the spelling — not a
  // mismatch to work around, since the wrapper carries the same verdict with null as a flag.
  if t is TyNullable {
    const inner = t.nInner
    if inner < 0 { return -1 }
    const it = T.tys[inner]
    if it is TyUnion { return valueUnionVerdict(it.uMembers, true) }
    const one: i32[] = [inner]
    return valueUnionVerdict(one, true)
  }
  -1
}

// The counting half of `isValueUnionName`, over member rows. `nullSeen` supplies the null
// a `TyNullable` spells as a wrapper rather than a member. -1 = decline, 1 = yes, 0 = no.
function valueUnionVerdict(ms: i32[], nullSeen: boolean): i32 {
  let nonNull = 0
  let hasNull = nullSeen
  let soloKind = -1
  let i = 0
  while i < ms.length {
    const k = valueRowKind(ms[i])
    if k == -2 { return -1 }
    if k < 0 { return 0 }
    if k == 6 {
      hasNull = true
    } else {
      nonNull = nonNull + 1
      soloKind = k
    }
    i = i + 1
  }
  // `unionMemberCount(name) < 2` — the name predicate's first gate, in atoms.
  let atoms = nonNull
  if hasNull { atoms = atoms + 1 }
  if atoms < 2 { return 0 }
  if nonNull >= 2 { return 1 }
  if nonNull == 1 && hasNull {
    // Only a numeric scalar boxes with null; boolean|null / string|null are niches.
    if soloKind == 0 || soloKind == 3 || soloKind == 4 || soloKind == 5 {
      return 1
    }
    return 0
  }
  0
}

// The scalar arms of `valueAtomKind`, decided over a span of `name` with no slice. Returns
// `-2` for "not one of these — materialize and ask the full ladder", distinct from
// `valueAtomKind`'s own `-1` ("not a value atom"). The list, litunion-array,
// niche-nullable-list and closure arms all need the materialized string.
function valueAtomKindSpan(name: string, from: i32, to: i32): i32 {
  if spanEqAt(name, from, to, "i32") { return 0 }
  if spanEqAt(name, from, to, "boolean") { return 1 }
  if spanEqAt(name, from, to, "string") { return 2 }
  if spanEqAt(name, from, to, "i64") { return 3 }
  if spanEqAt(name, from, to, "f64") { return 4 }
  if spanEqAt(name, from, to, "f32") { return 5 }
  if spanEqAt(name, from, to, "null") { return 6 }
  -2
}

// Whether `name` is a value union this emitter boxes: 2+ top-level atoms, every atom a
// scalar/string/null name, and either 2+ non-null atoms, or exactly one non-null numeric atom
// plus `null` (`i32 | null` boxes; `boolean | null` keeps its sentinel niche; a single ref
// member plus null, like `string | null`, stays a niche nullable ref — neither is a box).
export function isValueUnionName(name: string) {
  if unionMemberCount(name) < 2 { return false }
  // Walks spans and materializes only what the ladder needs (most members are plain scalars
  // `valueAtomKindSpan` decides with no slice at all); the `< 2` guard rejects the common case first.
  let nonNull = 0
  let hasNull = false
  let soloKind = -1
  let start = 0
  let going = true
  while going {
    const at = tyTopIndexOf(name, '|', '=', start)
    let end = name.length
    if at >= 0 && name[at] != '=' { end = at } else { going = false }
    let k = valueAtomKindSpan(name, start, end)
    if k == -2 { k = valueAtomKind(name.slice(start, end)) }
    if k < 0 { return false }
    if k == 6 {
      hasNull = true
    } else {
      nonNull = nonNull + 1
      soloKind = k
    }
    if going { start = at + 1 }
  }
  if nonNull >= 2 { return true }
  if nonNull == 1 && hasNull {
    return soloKind == 0 || soloKind == 3 || soloKind == 4 || soloKind == 5
  }
  false
}

// Whether a binary operator's two operands carry incompatible nominal brands (P1.5). Equal
// brands — including two un-branded operands, the overwhelming case — are compatible. A
// syntactic literal on the un-branded side adopts, so only a branded operand meeting a
// base-typed or differently-branded value reports.
function nomBinMixes(lt: i32, rt: i32, lx: i32, rx: i32) {
  // A `null` operand against nullable storage is not a brand mix (a newtype over a nullable
  // admits it). Gated on `tyAdmitsNull` — load-bearing, since this predicate is read twice.
  if isNullTy(lt) && tyAdmitsNull(rt) { return false }
  if isNullTy(rt) && tyAdmitsNull(lt) { return false }
  const ln = nomNameOfTy(lt)
  const rn = nomNameOfTy(rt)
  if ln == rn { return false }
  if ln == "" {
    if exprIsBrandAdoptingLiteral(lx) { return false }
  }
  if rn == "" {
    if exprIsBrandAdoptingLiteral(rx) { return false }
  }
  true
}

// The one place a binary expression's type is handed out, so the one place the answer can be
// deferred to a pin. `ltOut` carries the left operand's type out rather than re-reading
// `nodeTyIx[n.binLeft]`: `checkNode` records a node type only when `!inferQuiet`, and a nested
// binary on the right could have overwritten a module-level slot before this returns.
function checkBinExprNode(n: BinExpr, ix: i32) {
  const ltOut: i32[] = []
  const bTy = checkBinExprNodeReal(n, ix, ltOut)
  if ltOut.length == 0 { return bTy }
  mkBinOpRetTy(n, bTy, ltOut[0])
}

// A binary operator's result type, deferred to the pin when the body cannot decide it
// (D532). The gate is the exact precondition of the correction, not a heuristic: the hole can
// resolve to anything but `bTy` only through a declared top-level `self`-function named for
// the operator, so a program declaring no overload records exactly what it recorded before.
function mkBinOpRetTy(n: BinExpr, bTy: i32, lt: i32) {
  if bTy < 0 { return bTy }
  if bTy == TY_ERR { return bTy }
  // A compound assignment shares its target node between the read and the write, and is left
  // whole — an overload has no second answer for a form the direct spelling doesn't lower either.
  if n.binCompound != "" { return bTy }
  const op = n.binOp
  // Only an operator a user can declare can carry an overload, so nothing else has a second
  // answer at a pin (`ast.vl:isBinOpFuncName`, the ten names a declaration admits).
  if !isBinOpFuncName(op) { return bTy }
  if (fnDeclIx[op] ?? -1) < 0 { return bTy }
  if !tyIsHole(lt) { return bTy }
  // An annotated body is not excluded: D551 re-checks the annotation against the
  // resolved body type at each pin (`noteRetCstr`/`validateRetCstrs`), so a per-pin deferral is safe.
  const d = mkDerivedHole(HD_BINOP, op, bTy, -1, lt)
  if d < 0 { return bTy }
  d
}

// Extracted from `checkNodeReal`'s `BinExpr` arm (C3: thin the dispatcher).
function checkBinExprNodeReal(n: BinExpr, ix: i32, ltOut: i32[]) {
  const op = n.binOp
  // `a && b` / `a || b`: the left side's narrowings hold while checking the right (`&&`
  // narrows on true, `||` on false — the right is reached only in that branch).
  if op == "&&" || op == "||" {
    const clt = checkNode(n.binLeft)
    const cnames: string[] = []
    const ctys: i32[] = []
    if op == "&&" {
      collectThenNarrows(n.binLeft, cnames, ctys)
    } else {
      collectElseNarrows(n.binLeft, cnames, ctys)
    }
    let cpushed = 0
    if cnames.length > 0 {
      pushScope(-1)
      applyNarrows(cnames, ctys)
      cpushed = 1
    }
    const crt = checkNode(n.binRight)
    if cpushed == 1 { popScope() }
    if !assignable(clt, TY_BOOL) || !assignable(crt, TY_BOOL) {
      tErr("operator '" + op + "' expects boolean operands", ix)
    }
    return TY_BOOL
  }
  // Definite-assignment: a plain `=` with a bare-name target is a pure write — flag it so
  // the `Ident` arm skips use-before-assign. A compound `x += ...` desugars, so its read isn't the target.
  const savedWriteTarget = daWriteTarget
  if op == "=" {
    const wtgt = P.nodes[n.binLeft]
    if wtgt is Ident { daWriteTarget = n.binLeft }
  }
  let lt = checkNode(n.binLeft)
  daWriteTarget = savedWriteTarget
  // An unpinned intrinsic element answers with the default it will get (D1566), except under
  // `=`, whose Index case pins the element from the RHS instead — answering here would pre-empt that.
  if op != "=" {
    if lt < 0 {
      const peekL = arrDefOperandElemPeek(n.binLeft)
      if peekL >= 0 { lt = peekL }
    }
  }
  ltOut.push(lt)
  // Contextual typing for an assignment RHS: seed the LHS type so an un-annotated lambda
  // param infers from the target, matching let-init/arg/return seeding.
  if op == "=" { seedExpected(n.binRight, lt) }
  // Contextual typing for a `??` default: seed it with the LHS's non-null shape so an
  // un-annotated default-lambda param infers, mirroring the `=` seeding.
  if op == "??" { seedExpected(n.binRight, lt) }
  // Name the row an index store is about to pin, for the length of that store's value only, so a
  // read of the same place inside the value can pin the element rather than answer `TY_ERR`.
  const savedAsgRow = asgOpenElemRow
  asgOpenElemRow = -1
  if op == "=" { asgOpenElemRow = asgOpenElemRowOf(n.binLeft) }
  let rt = checkNode(n.binRight)
  asgOpenElemRow = savedAsgRow
  // The right operand takes the same answer, for the same reason: without it, an operator's
  // annotated face runs while the un-annotated one is check-clean invalid wasm (D1566).
  if op != "=" {
    if rt < 0 {
      const peekR = arrDefOperandElemPeek(n.binRight)
      if peekR >= 0 { rt = peekR }
    }
    // A store's value reading the place it writes: the value is what the program said the
    // element is, and the read has no answer of its own until this pins one.
    if lt < 0 {
      const asgPin = asgReadElemPin(n.binLeft, rt)
      if asgPin >= 0 {
        lt = asgPin
        ltOut[0] = asgPin // the out-column is the left operand's exact type, pin included
      }
    }
  }
  // The `??` default is the value produced when the LHS is null, so a `void` default leaves
  // nothing to produce — the other operators reject void through their own shape-demanding arms.
  if op == "??" {
    if voidValueSlotErr(rt, n.binRight, "`??` default", ix) { rt = TY_ERR }
    // The default's destination is the LHS's non-null shape — the one position where a typed
    // slot sits on the LEFT of the operator, which is why this needed its own pin (D1591).
    constrainEmptyExpr(n.binRight, rt, nonNullTy(lt))
  }
  // A radix literal operand takes the other side's width (the ruled literal rule). Assignment is
  // excluded: its destination is `assignableExpr`'s, which pins the narrowing direction too.
  if op != "=" && op != "&&" && op != "||" {
    if radixLitAdoptPeer64(n.binLeft, rt) == 1 { lt = TY_I64 }
    if radixLitAdoptPeer64(n.binRight, lt) == 1 { rt = TY_I64 }
  }
  // A binary op with a hole operand can't decide its form until the hole is bound at the call —
  // record the deferred constraint (skipping assignment / logical, handled by their own arms).
  if op != "=" && op != "&&" && op != "||" { noteBinCstr(lt, op, rt) }
  // Nominal newtype (P1.5): every non-assignment binary operator's operands must carry the
  // same brand — structural rules can't see it (`sameNumeric` compares `primName`, ordering skips `assignable`).
  if op != "=" && op != "&&" && op != "||" && op != "??" {
    if nomBinMixes(lt, rt, n.binLeft, n.binRight) {
      if op == "==" || op == "!=" {
        tErr("cannot compare " + tyToStr(lt) + " and " + tyToStr(rt), ix)
        return TY_BOOL
      }
      tErr(
        "operator '" + op + "' mixes " + tyToStr(lt) + " and " + tyToStr(rt),
        ix,
      )
      return TY_ERR
    }
  }
  // Assignment: RHS must be assignable to the LHS's (already-bound) type.
  if op == "=" {
    // A `const` name cannot be rebound (`x = ...`, and the `x++`/`x += ...`
    // desugarings). Data behind it stays mutable (a Member/Index target).
    const tgt = P.nodes[n.binLeft]
    if tgt is Ident {
      if isConstName(tgt.identName) {
        tErr("cannot reassign `const` " + tgt.identName, ix)
      }
      // This write makes the binding definitely assigned on the current path.
      daMarkAssigned(tgt.identName)
    }
    // An index-set into an empty `[]` pins its element type to `typeof v` in place —
    // usage-driven inference, clearing the uninferred floor.
    if tgt is Index {
      // The whole left-hand side is already checked as `lt` above — read the recorded type
      // instead of re-checking, so a diagnostic inside the receiver subtree isn't reported twice.
      let arrTy0 = nodeTyIxOf(tgt.idxArr)
      if arrTy0 < 0 { arrTy0 = checkNode(tgt.idxArr) }
      // An un-annotated-param hole receiver stands for its demanded map, so the map pin below
      // is the same arm the concrete receiver takes, not a second copy of it.
      const arrH0 = T.tys[arrTy0]
      if arrH0 is TyVar {
        const hmw = holeMapOf(arrH0.tvName)
        if hmw >= 0 { arrTy0 = hmw }
      }
      const arrT0 = T.tys[arrTy0]
      if arrT0 is TyArray {
        if arrT0.aElem < 0 {
          arrT0.aElem = rt
          tyMutEpoch = tyMutEpoch + 1 // index-write pinned the element in place
        }
        // A `u8[]` store checks against the element type directly: `checkIndexNode` types a
        // `u8[]` read as `i32` (the widened value), so `lt` above can't see the out-of-range rule.
        if primNameOf(arrT0.aElem) == "u8" {
          assignableExpr(n.binRight, rt, arrT0.aElem)
        }
      }
      // An index-set into a bare `Map()` pins its key and value holes the same way `.set(k, v)`
      // does — the two write spellings of one program must infer identically.
      if arrT0 is TyMap {
        if arrT0.mKey < 0 {
          let kt0 = nodeTyIxOf(tgt.idxIndex)
          if kt0 < 0 { kt0 = checkNode(tgt.idxIndex) }
          if kt0 >= 0 {
            arrT0.mKey = kt0
            tyMutEpoch = tyMutEpoch + 1 // index-write pinned the key in place
            checkInferredMapKey(kt0, arrT0.mSet, ix)
          }
        }
        if arrT0.mVal < 0 {
          arrT0.mVal = rt
          tyMutEpoch = tyMutEpoch + 1 // index-write pinned the value in place
        }
      }
      // Free index-write operator (B14): banked on THIS assignment node, not the target —
      // the target keeps its read resolution, which `x[i] += v` needs (its desugaring re-reads it).
      if opIdxDeclared() {
        if !tyBuiltinIndexable(arrTy0) {
          const wfn = opIdxFnFor(OP_INDEX_SET, arrTy0)
          if wfn != "" {
            const wbNames: string[] = []
            const wbTys: i32[] = []
            opIdxBindGen(wfn, arrTy0, nodeTyIxOf(tgt.idxIndex), wbNames, wbTys)
            const vt0 = opIdxParamTy(wfn, 2)
            let vt = vt0
            if vt0 >= 0 {
              if wbNames.length > 0 { vt = substTyDeep(vt0, wbNames, wbTys) }
            }
            if vt >= 0 {
              if !assignableExpr(n.binRight, rt, vt) {
                tErr(
                  "index write: expected " + tyToStr(vt) + ", got " + tyToStr(rt),
                  ix,
                )
              }
            }
            opIdxBank(ix, wfn)
            return rt
          }
          // A read operator with no write one: name the missing half, exactly as
          // the closure-field trap does below.
          const rOnly = opIdxFnFor(OP_INDEX_GET, arrTy0)
          if rOnly != "" {
            tErr(
              "no \"" +
                OP_INDEX_SET +
                "\" operator for index assignment on " +
                tyToStr(arrTy0),
              ix,
            )
            return TY_ERR
          }
        }
      }
      // Index write trap (B13, host `indexTrap` "[]="): an object with only a read trap
      // rejects the write (the host's missing-method error).
      if arrT0 is TyObj {
        const wtrap = objFieldType(arrT0, "[]=")
        if wtrap >= 0 {
          const wt = T.tys[wtrap]
          if wt is TyFunc {
            if wt.fnParamTypes.length == 2 {
              if !assignableExpr(n.binRight, rt, wt.fnParamTypes[1]) {
                tErr(
                  "index write: expected " +
                    tyToStr(wt.fnParamTypes[1]) +
                    ", got " +
                    tyToStr(rt),
                  ix,
                )
              }
              return rt
            }
          }
        } else if objFieldType(arrT0, "[]") >= 0 {
          tErr(
            "no \"[]=\" method for index assignment on " + tyToStr(arrTy0),
            ix,
          )
          return TY_ERR
        }
      }
    }
    // A place accepts its storage type, not its current flow (narrowed) type — a narrowing
    // must never shrink what the storage can hold, so a write is checked against storage.
    let asgLt = lt
    let asgBarred = false
    const rtN = T.tys[rt]
    let rhsNullBearing = isNullTy(rt)
    if rtN is TyNullable { rhsNullBearing = true }
    if rhsNullBearing {
      const asgDcl = writeStorageTy(n.binLeft)
      if asgDcl >= 0 {
        asgLt = asgDcl
      } else {
        asgBarred = writeBarredByLoop(n.binLeft)
      }
    }
    // A plain assignment pins the source's open holes, exactly as an annotated let-init, call
    // argument, or typed return already does — runs before `assignableExpr` so the pin applies first.
    constrainEmptyExpr(n.binRight, rt, asgLt)
    const asgOk = assignableExpr(n.binRight, rt, asgLt)
    if !asgOk {
      if asgBarred {
        writeBarredErr(placeKeyOf(n.binLeft), ix)
      } else {
        tErr(letAssignMsg(n.binRight, rt, asgLt, ""), ix)
      }
    } else {
      // The same vacuous-gate check covers three write spellings (`r = e`, `b.v = e`,
      // `xs[0] = e`) — records the pair for the pin using `asgLt`, the storage type actually asked.
      noteLetCstr(rt, asgLt, n.binRight, "")
      // And the slots of a literal source too: an array literal whose element join dropped a
      // hole reaches this gate hole-free, so the slots (not the pair) are the real question.
      if !tyHasHole(rt) {
        if !tyHasHole(asgLt) { noteLitElemCstrs(n.binRight, asgLt, 6) }
      }
    }
    // A-infer-null: a nullable binding's open inner hole fills from the first non-null
    // assignment in place; a straight-line non-null write narrows for the rest of the block.
    const asgTgt = P.nodes[n.binLeft]
    if asgTgt is Ident {
      const asgCur = lookup(asgTgt.identName)
      if asgCur >= 0 {
        // A write to a hole binding ends the pin's jurisdiction over it: the call site pins the
        // parameter, this write replaces the value, so a cast after it is not the pin's to adjudicate (D1342).
        const asgHole = T.tys[asgCur]
        if asgHole is TyVar {
          noteCastClobber(asgHole.tvName + "." + asgTgt.identName)
        }
        const rtT = T.tys[rt]
        let rhsNullable = false
        if rtT is TyNullable { rhsNullable = true }
        const rhsNonNull = !rhsNullable && !isNullTy(rt) && rt >= 0
        const asgCt = T.tys[asgCur]
        if asgCt is TyNullable {
          if rhsNonNull {
            if asgCt.nInner < 0 {
              asgCt.nInner = rt
              tyMutEpoch = tyMutEpoch + 1 // nullable inner pinned in place
              // D1589 — a read typed before the fill banked the hole itself: re-derive
              // every such `??` here, the moment its non-null part exists.
              fillCoalHoleNodes(asgCur)
            }
            // Bank the declared type before shadowing it — the narrowing itself is unchanged,
            // which is what the `let x: T | null = null` / `x = mk()` / `x.f` pattern rides.
            noteNarShadow(asgTgt.identName, asgCur, NAR_KIND_ASG)
            declare(asgTgt.identName, nonNullTy(asgCur))
          }
        }
      }
    }
    // The narrowing is a path fact, and a falsifying write ends the path — only an accepted
    // write retires it, since a rejected write did not happen and would cascade a second diagnostic.
    if asgOk { retireNarrowingsForWrite(n.binLeft, rt, ix) }
    // Assignment is an expression yielding its right-hand side (host parity;
    // DECISIONS: assignment-as-expression).
    return rt
  }
  // An unpinned element hole is `-1`, and every arm below indexes `T.tys` with it — guarded
  // here, below both the `=` arm's own pin and the operand peek, rather than trapping (D1462).
  if lt < 0 { return TY_ERR }
  // Nullish coalescing peels the FULL nullability of the merged type (`nonNullTy`), not one
  // layer — a stored null in a nullable-valued map read is a double nullable, just like a miss.
  if op == "??" {
    // A `??` whose left operand can never be null has a dead default — recorded (a lint), not
    // rejected, since `emit_rewrite` folds it. A narrowed place is exempt: its storage still admits null.
    if tyExcludesNull(lt) {
      // A parked hole cast has no answer yet: `a as? i32` inside a hole's body types `i32`
      // until the call pins the operand, so a `??` over it looks dead here and is not (D1371).
      if !coalNarrowedPlace(n.binLeft) && !coalParkedHoleCast(n.binLeft) {
        recordDeadCoalesce(ix, lt)
      }
    }
    const lt2 = T.tys[lt]
    if lt2 is TyNullable {
      // D1589 — an open hole has no non-null part yet, so `nonNullTy` hands back the nullable
      // and the default's type is the safe answer: `fillCoalHoleNodes` re-derives it once the fill arrives.
      if lt2.nInner < 0 {
        if coalHoleDeferOk(rt) {
          noteCoalHole(ix, lt, rt)
          return rt
        }
      }
      const innerFull = nonNullTy(lt)
      // A literal default re-encodes at f32, so keep the result f32 — else `joinTys` widens
      // `f32 + f64`/`f32 + i32` and a downstream f32 slot rejects the demote.
      if primNameOf(innerFull) == "f32" && isF32AdoptingLitExpr(n.binRight) {
        return innerFull
      }
      // A litunion inner with a member-literal default stays the union (an i32 atom) — else
      // the bare literal types `string` and `joinTys` widens the result, divorcing it from the atom rep.
      if isLitBearing(innerFull) {
        const dl = litTyOfExpr(n.binRight)
        if dl >= 0 {
          if assignable(dl, innerFull) { return innerFull }
        }
        // An atom-valued map get's default must itself be an atom — a member literal or a
        // value of the same litunion; the method spelling `m.get(k) ?? d` is rejected here too.
        const mgRecv = fusedMapReadRecvIx(n.binLeft)
        if mgRecv >= 0 {
          if nodeTyMapValIsLitUnion(mgRecv) {
            if !assignable(rt, innerFull) {
              tErrUnsupported(
                "`??` over an atom-valued map needs a member-literal (or atom) default",
                ix,
              )
            }
          }
        }
      }
      // When the default fits the non-null LHS type (with contextual coercion), the `??` result
      // IS that LHS type, not `joinTys`' LUB — which would widen a litunion field to `string`.
      if assignableExpr(n.binRight, rt, innerFull) { return innerFull }
      return joinTys(innerFull, rt)
    }
    return lt
  }
  // Equality: result bool; requires mutual compatibility.
  if op == "==" || op == "!=" {
    // A null test asks about the storage, not the flow-narrowed type — a narrowing does not
    // change storage, so `isAsgNarrowedName` exempts exactly the bindings an assignment narrowed.
    if isNullTy(lt) || isNullTy(rt) {
      if isAsgNarrowedName(n.binLeft) || isAsgNarrowedName(n.binRight) {
        return TY_BOOL
      }
    }
    // Closed set (literal unions): comparing a literal-union place against a literal outside
    // its set can never be true — reject rather than compile an always-false test.
    if isLitBearing(lt) {
      const eqR = litTyOfExpr(n.binRight)
      if eqR >= 0 {
        if !assignable(eqR, lt) {
          tErr(
            "cannot compare " +
              tyToStr(lt) +
              " with " +
              tyToStr(eqR) +
              " — not a member of the union",
            ix,
          )
        }
        // A member compare is always a valid discrimination (`v == 7` over `"x" | 7`) — the
        // mixed union's softened sides aren't mutually assignable, so it must not fall through.
        return TY_BOOL
      }
    } else if isLitBearing(rt) {
      const eqL = litTyOfExpr(n.binLeft)
      if eqL >= 0 {
        if !assignable(eqL, rt) {
          tErr(
            "cannot compare " +
              tyToStr(eqL) +
              " with " +
              tyToStr(rt) +
              " — not a member of the union",
            ix,
          )
        }
        return TY_BOOL
      }
    }
    // A nominal newtype compared with a literal is compatible (`id == 0`) — the literal adopts
    // the brand, as in every other position; the genuine-mix reject already fired above.
    const nomEqLit = nomNameOfTy(lt) != nomNameOfTy(rt) &&
      !nomBinMixes(lt, rt, n.binLeft, n.binRight)
    const eqMutual = assignable(lt, rt) || assignable(rt, lt) || nomEqLit
    if !eqMutual {
      tErr("cannot compare " + tyToStr(lt) + " with " + tyToStr(rt), ix)
    }
    // Both `==` gates share one home (`eqRefusals`): structural soundness (field-by-field
    // compare needs every component comparable) and emitter-capability (no compare core exists).
    const eqMsgs: string[] = []
    const eqChan: i32[] = []
    eqRefusals(op, lt, rt, eqMutual, eqMsgs, eqChan)
    let eqM = 0
    while eqM < eqMsgs.length {
      if eqChan[eqM] == 1 {
        tErrUnsupported(eqMsgs[eqM], ix)
      } else {
        tErr(eqMsgs[eqM], ix)
      }
      eqM = eqM + 1
    }
    return TY_BOOL
  }
  // Operator dispatch on a struct (B13 + B14): a free `self`-function named for the operator
  // is checked first, then an operator closure field — equality/logicals/`=`/`??` already returned.
  if op != "&&" && op != "||" {
    const odsp = T.tys[lt]
    if odsp is TyObj {
      const osf = opSelfFnTy(op, lt, rt, n.binRight, ix)
      if osf >= 0 {
        opBinSiteTook(op, true)
        return osf
      }
      const ofld = objFieldType(odsp, op)
      if ofld >= 0 {
        const oft = T.tys[ofld]
        if oft is TyFunc {
          if oft.fnParamTypes.length == 1 {
            if !assignableExpr(n.binRight, rt, oft.fnParamTypes[0]) {
              tErr(
                "operator '" +
                  op +
                  "': expected " +
                  tyToStr(oft.fnParamTypes[0]) +
                  ", got " +
                  tyToStr(rt),
                ix,
              )
            }
            return oft.fnRet
          }
        }
      }
    } else {
      // The site's own decision, recorded (D491): a non-object left operand takes the
      // language's own lowering with no declaration consulted — recorded for the declaration side.
      opBinSiteTook(op, false)
    }
  }
  // Ordering comparison: result bool, requires matching numeric types. A literal/litunion
  // operand is its base scalar here (`0 | 1 | 2` compares as i32).
  if op == "<" || op == ">" || op == "<=" || op == ">=" {
    const olt = softenLitTy(lt)
    const ort = softenLitTy(rt)
    // String ordering: a lexicographic compare of two strings yields a bool.
    if isStringTy(olt) && isStringTy(ort) { return TY_BOOL }
    // One concrete string against a hole defers rather than forcing numeric — `noteBinCstr`
    // records the constraint and `validateBinCstrs` adjudicates it at the call, mirroring `+`'s deferral.
    if isStringTy(olt) && tyIsHole(ort) { return TY_BOOL }
    if tyIsHole(olt) && isStringTy(ort) { return TY_BOOL }
    // A hole operand reaching a numeric comparison is used numerically — record the demand.
    if !isNumeric(olt) || !isNumeric(ort) {
      tErr(
        "comparison expects numeric operands, got " +
          tyToStr(olt) +
          " and " +
          tyToStr(ort),
        ix,
      )
    } else if (
      !sameNumeric(olt, ort) &&
      !mixesNumeric(olt, ort) &&
      !cmpF32LitAdopts(n, olt, ort)
    ) {
      // Mixed numerics may be compared when one side widens to the other; the f32-with-a-literal
      // pair is admitted separately (`cmpF32LitAdopts`) so comparison agrees with arithmetic's `+`.
      tErr("comparison mixes " + tyToStr(olt) + " and " + tyToStr(ort), ix)
    }
    return TY_BOOL
  }
  // `+` also concatenates strings.
  if op == "+" {
    // String concat needs an operand that actually IS a string — a hole is permissively
    // assignable to string, so this defers a two-hole `a + b` to the call site (`substTyDeep`).
    if isStringTy(lt) || isStringTy(rt) {
      if assignable(lt, TY_STR) && assignable(rt, TY_STR) { return TY_STR }
      // A `new string` newtype concatenates (with a same-brand value or a literal) and keeps
      // the brand — otherwise it would be the one newtype whose values could never be joined.
      if nomNameOfTy(lt) != "" || nomNameOfTy(rt) != "" {
        if assignable(nomBaseTyIx(lt), TY_STR) {
          if assignable(nomBaseTyIx(rt), TY_STR) {
            if nomNameOfTy(lt) != "" { return lt }
            return rt
          }
        }
      }
    }
    // List concat `a + b` → a new `T[]` (collections-design §VL.4); the two
    // element types must agree (an empty `[]` adopts the other side's).
    const lta = T.tys[lt]
    if lta is TyArray {
      const rta = T.tys[rt]
      if rta is TyArray {
        constrainEmpty(rt, lt)
        constrainEmpty(lt, rt)
        // No emitter-capability gate here any more: one concat lowering exists per list rep
        // (`emitListConcatG`); any residue is an emitter fact caught loudly at the emit site (D721).
        if assignable(rt, lt) { return lt }
        if assignable(lt, rt) { return rt }
        tErr("cannot concat " + tyToStr(lt) + " and " + tyToStr(rt), ix)
        return TY_ERR
      }
    }
  }
  // Remaining arithmetic: numeric-only, both the same numeric type (no implicit i32<->f64).
  // A literal/all-literal-union operand softens to its base scalar first.
  lt = softenLitTy(lt)
  rt = softenLitTy(rt)
  // A hole operand reaching arithmetic is used numerically — record the demand so the call-arg
  // check enforces a numeric (or operator-overloaded) argument (`isNumeric(TyVar)` passes below).
  if !isNumeric(lt) || !isNumeric(rt) {
    // Reached only after string-concat and array-concat are ruled out above, so this is a
    // genuine operand-type mismatch, not a claim that `+` is numeric-only.
    tErr(
      "operator '" +
        op +
        "' is not defined for " +
        tyToStr(lt) +
        " and " +
        tyToStr(rt),
      ix,
    )
    return TY_ERR
  }
  // Bitwise/shift are integer-only — a float has no bits to shift. `%` is not in this family
  // any more (D1586): float remainder now lowers exactly via the `__f64_rem__` intrinsic.
  if binIntOnlyOp(op) {
    if binFloatOperandPair(lt, rt) {
      tErr(
        "operator '" +
          op +
          "' is integer-only, got " +
          tyToStr(lt) +
          " and " +
          tyToStr(rt),
        ix,
      )
      return TY_ERR
    }
  }
  // A literal operand adopts the other side's f32 type (a literal re-encodes exactly at f32),
  // checked before the general mixed rule so `x + 1` stays f32 rather than widening to f64.
  if primNameOf(lt) == "f32" && isF32AdoptingLitExpr(n.binRight) { return lt }
  if primNameOf(rt) == "f32" && isF32AdoptingLitExpr(n.binLeft) { return rt }
  // A mixed-numeric op widens the narrower operand to the wider one (`i32 op i64` -> i64, ...),
  // done before the same-type check so a compatible mixed pair is accepted (B2).
  if mixesNumeric(lt, rt) { return widerNumeric(lt, rt) }
  if !sameNumeric(lt, rt) {
    tErr(
      "operator '" + op + "' mixes " + tyToStr(lt) + " and " + tyToStr(rt),
      ix,
    )
    return TY_ERR
  }
  return lt
}
// ── let declaration ────────────────────────────────────────────────────────

// Extracted from `checkNodeReal`'s `LetDecl` arm (C3: thin the dispatcher).
function checkLetDeclNode(n: LetDecl, ix: i32) {
  // Resolve the annotation (if any) by reading the TypeRef child inline.
  let annot = -1
  // D1048's second hint: did the annotation collapse a subsumed literal arm? Read immediately
  // after resolution and compared against THIS annotation's own answer.
  let annotCollapsedHere = false
  if n.letType >= 0 {
    const tn = P.nodes[n.letType]
    if tn is TypeRef {
      annot = nameToTyAt(tn.tyName, n.letType)
      if annot >= 0 && annot == collapsedTy { annotCollapsedHere = true }
      if annot < 0 {
        // A map shape whose key is neither `string` nor `i32` has no hash in the map rep —
        // report that directly (with the supported set) rather than a bare "unknown type".
        const mapKeyIx = tsMapKeyNodeOf(annTsOf(n.letType))
        let badKey = ""
        if mapKeyIx >= 0 { badKey = tsText[mapKeyIx] }
        if badKey != "" && !mapKeyTySupported(tsLeafTy(badKey)) {
          mapKeyUnsupportedErr(badKey, initMapCtorName(n.letInit), n.letType)
        } else {
          tErr(unknownTyText(tn.tyName), n.letType)
        }
        annot = TY_ERR
      }
      // Record the resolved type on the `let`'s type-annotation node so the emitter can
      // classify it structurally from the `Ty` arena rather than re-parsing `tyNameOf` — C1.
      if !inferQuiet && annot >= 0 {
        if n.letType < nodeTyIx.length { nodeTyIx[n.letType] = annot }
      }
    }
  }
  let initTy = -1
  // Bidirectional: an annotated `const f: (i32) => i32 = (x) => ...` infers each un-annotated
  // lambda param from the annotation before the initializer is checked.
  const seedMark = cbSeedUsed
  if n.letInit >= 0 && annot >= 0 { seedExpected(n.letInit, annot) }
  // An un-annotated binding to a bare lambda: mark it so its un-annotated params type as
  // inference holes rather than being rejected as uninferable.
  if annot < 0 && n.letInit >= 0 {
    const liN = P.nodes[n.letInit]
    if liN is FuncDecl {
      if liN.fnName == "" { noteValBindLambda(n.letInit) }
    }
  }
  if n.letInit >= 0 { initTy = checkNode(n.letInit) }
  // A `void` initializer has no value to bind — reject with a source-located message,
  // poisoning `initTy`. Exempted: an if-expression init, whose false path is implicit `null`.
  if n.letInit >= 0 && isVoidTy(initTy) {
    if !voidSlotExemptExpr(n.letInit) {
      tErr(
        "cannot bind the void result of '" +
          n.letName +
          "' — a void function returns no value",
        ix,
      )
      initTy = TY_ERR
    }
  }
  // Redundant explicit annotation: skipped when checking the initializer consumed a contextual
  // seed the annotation supplied (an un-annotated lambda param) — comparing then would be circular (D1442).
  if annot >= 0 && initTy >= 0 && n.letInit >= 0 && cbSeedUsed == seedMark {
    recordRedundantAnnot(n, ix, initTy, annot)
  }
  let bound = TY_ERR
  if annot >= 0 {
    bound = annot
    if initTy >= 0 {
      // An annotated empty-collection initializer pins the source binding's open holes from
      // the annotation (`const ys: i32[] = zs` resolves `zs`'s element) in place.
      constrainEmptyExpr(n.letInit, initTy, annot)
      // A `never`-typed annotation is already reported at its declaration — don't cascade a
      // second "cannot assign ... of type <empty>" at every use site.
      const neverAnnot = isNeverTy(annot)
      if !neverAnnot && !assignableExpr(n.letInit, initTy, annot) {
        // Three sentences, one home: `letAssignMsg` picks between the object-literal-into-a-map,
        // lossy-numeric and opaque forms; the pin calls the same function on the substituted pair.
        tErr(letAssignMsg(n.letInit, initTy, annot, n.letName), ix)
      } else if !neverAnnot {
        // The check above is vacuous whenever a side is a hole — record the pair for the pin to
        // re-ask under substitution, only on the PASSING side (a failing one already reported, D572).
        noteLetCstr(initTy, annot, n.letInit, n.letName)
        // And the slots of a literal source too, but only when the pair above carried no hole —
        // that is exactly when the literal's own element join dropped one, so nothing is recorded.
        if !tyHasHole(initTy) {
          if !tyHasHole(annot) { noteLitElemCstrs(n.letInit, annot, 6) }
        }
      }
      // A `Set()` initializer keeps its Set flavor even under a map-shaped annotation — the
      // binding exposes the Set surface (`.add`, no `.set`/`.get`/`.keys`) with the annotation's key/value.
      const it2 = T.tys[initTy]
      if it2 is TyMap {
        if it2.mSet == 1 {
          const an2 = T.tys[annot]
          if an2 is TyMap { bound = mkMapTy(an2.mKey, an2.mVal, 1) }
        }
      }
    }
  } else if initTy >= 0 {
    bound = initTy
    // A-infer-null: an un-annotated `let x = null` binds a nullable with an open inner hole;
    // the first non-null assignment fills it in place (the `=` arm), so `x` becomes `T | null`.
    if isNullTy(initTy) {
      bound = mkNullableTy(-1)
      // ...and record the hole, so scope close can say whether anything ever filled it. A
      // hole nothing fills is the `null` type and has a rep (D1576).
      noteNullHole(bound, ix)
    }
    // Un-inferred empty-collection floor: a still-open hole may yet be pinned by a downstream
    // `.push`/`.set`/`.add` — recorded for the scope-close re-check (`flushUninferred`).
    if unresolvedHole(bound) { notePending(n.letName, bound, ix) }
    // Exports an un-annotated if-expression binding's inferred value-union type for the
    // emitter. Gated to if-expr/`?.` inits only — rendering via `tyToStr` is costly on the hot path.
    let initIf = n.letInit
    if initIf >= 0 {
      const ini0 = P.nodes[initIf]
      if ini0 is Paren { initIf = ini0.parInner }
    }
    let isIfInit = false
    if initIf >= 0 {
      const ini1 = P.nodes[initIf]
      if ini1 is IfStmt { isIfInit = true }
      // A standalone optional chain (`const t = a?.w`) is the other init shape whose union the
      // emitter can learn about from nowhere else — as rare as an if-expression init.
      if ini1 is OptMember { isIfInit = true }
    }
    if isIfInit {
      const lvn = valueUnionRetName(bound)
      if lvn != "" {
        inferLetIx.push(ix)
        inferLetTy.push(lvn)
      } else if isNulStringTy(bound) {
        // `string | null` is a niche (not a value-union box) so `valueUnionRetName`
        // renders "" — record it separately for the kind-16 slot classification.
        inferLetNulStrIx.push(ix)
      } else if isNulBoolTy(bound) {
        // `boolean | null` is the other niche (the i32 sentinel-2 rep) — same story,
        // recorded for the niche slot classification (`isInferLetNulBool`).
        inferLetNulBoolIx.push(ix)
      }
    }
  } else {
    tErr("'" + n.letName + "' needs a type annotation or initializer", ix)
  }
  // Same-scope redeclaration (B16): a second `let`/`const` of a name already bound in the
  // innermost frame errors; shadowing an outer name in a nested block is legal.
  const dtop = T.scopes.length - 1
  // A module global is pre-declared by the pass-1.5 hoist, so its own pass-2 declaration
  // would falsely trip the same-frame check — skip it there (top-level dups are caught in the hoist).
  const preHoisted = dtop == 0 && (moduleGlobals[n.letName] ?? false)
  if !preHoisted && T.scopes[dtop].has(n.letName) {
    tErr("redeclared " + n.letName, ix)
  }
  // The same reservation the `function` path enforces: a `const` of the emitter-intrinsic name
  // is called through the inline arm exactly like `function`, so the lambda never runs.
  checkNotEmitterIntrinsic(n.letName, ix)
  declare(n.letName, bound)
  // The module hoist already recorded a global's row at depth 0; a second one would say the
  // same thing at the same depth (D1609).
  if !preHoisted && letDeclIsUnannotObjLit(ix) {
    markObjLitBinding(n.letName, T.scopes.length - 1)
  }
  // D1048's second hint: marks a binding whose type came from a spelling that collapsed a
  // subsumed literal arm. A bare call initializer is the whole rung, deliberately narrow.
  if annotCollapsedHere {
    markCollapsedBinding(n.letName)
  } else if n.letType < 0 && n.letInit >= 0 {
    const cInit = P.nodes[n.letInit]
    if cInit is Call {
      const cFn = P.nodes[cInit.callFn]
      if cFn is Ident {
        const cDecl = fnDeclIx[cFn.identName] ?? lookupFnDeclNode(cFn.identName)
        if fnRetCollapsed(cDecl) { markCollapsedBinding(n.letName) }
      }
    }
  }
  // `const f = addT` — records which declaration this binding aliases, for deferred-constraint
  // ownership alone. A bare Ident initializer naming a declared function is the whole rung.
  if n.letInit >= 0 {
    const aInit = P.nodes[n.letInit]
    if aInit is Ident {
      const aDecl = fnDeclIx[aInit.identName] ??
        lookupFnDeclNode(aInit.identName)
      if aDecl >= 0 {
        const atop = fnAliasScopes.length - 1
        if atop >= 0 { fnAliasScopes[atop][n.letName] = aDecl }
      }
    }
  }
  if symEnabled != 0 { symDecl(n.letName, ix, bound, 0) }
  if n.letKw == "const" {
    const ctop = constScopes.length - 1
    if ctop >= 0 { constScopes[ctop][n.letName] = true }
  }
  // Definite-assignment: an uninitialized `let x` starts unassigned; a later read before a
  // write is an error. An initialized `let`/`const` is assigned from the start and never tracked.
  daMarkAssigned(n.letName)
  if n.letInit < 0 { daAdd(n.letName) }
  return TY_VOID
}
// ── match ──────────────────────────────────────────────────────────────────

// Marks the union members that arm pattern type `pt` covers, in the `covered` flag column
// parallel to `uMems`. Returns 1 when it covered at least one new member, -1 when every member
// it names is already covered (a redundant arm), 0 when it names no member at all. Coverage is
// decided by arena type (`sameVariantTy`), so two structurally-identical declared types are one member.
function markUnionCover(uMems: i32[], covered: i32[], pt: i32) {
  let found = 0
  let fresh = 0
  let j = 0
  while j < uMems.length {
    if sameVariantTy(uMems[j], pt) {
      found = found + 1
      if covered[j] == 0 {
        covered[j] = 1
        fresh = fresh + 1
      }
    }
    j = j + 1
  }
  if found == 0 { return 0 }
  if fresh == 0 { return -1 }
  1
}

// Whether arm pattern type `pt` is a composite (a union or a nullable) rather than one
// variant. An arm tests its type with a single `is`, and `x is A | B` is a shape the emitter
// does not lower, so a pattern resolving to one is rejected at the pattern, with the spelling
// that does work named.
function tyIsCompositePat(pt: i32) {
  const t = T.tys[pt]
  if t is TyUnion { return true }
  if t is TyNullable { return true }
  false
}

// Whether any variant in `mems` is a literal type. An arm tests its member with `is`, and
// `x is 0` over a value union does not lower, so such a union has no arm spelling that works —
// the whole scrutinee is refused, with the shape that does work named.
function unionHasLitMember(mems: i32[]) {
  let i = 0
  while i < mems.length {
    const t = T.tys[mems[i]]
    if t is TyLit { return true }
    i = i + 1
  }
  false
}

// Why a scrutinee is refused, named for the type it actually is. A `match` needs a closed
// member SET to be complete over, and every member must have an arm spelling that lowers —
// or it is an INTEGER, which has no member set and takes a `_` instead (D1572).
function matchScrutRejectMsg(st: i32, mems: i32[]) {
  if unionHasLitMember(mems) {
    return "match over a union with literal members is not supported — compare them with `==` in an if-chain, got " +
      tyToStr(st)
  }
  "match scrutinee must be a union or an integer, got " + tyToStr(st)
}

// An integer `match` (D1572, VL-020): the scrutinee types whose arms are integer literals
// rather than member types or member strings. `i32` and `i64` only — `u8` is a storage type
// no local/parameter/return may hold, and a float is excluded since dispatching on `==` over
// one is a trap rather than a feature.
function tyIsIntMatchScrut(st: i32) {
  const p = primNameOf(st)
  p == "i32" || p == "i64"
}

// Whether every pattern reads as an integer literal or the `_` wildcard, with at least one
// literal — the question a hole scrutinee is dispatched on: an un-annotated parameter's type
// is a `TyVar` no vocabulary can be chosen from, so the arms choose and each defers a `==`
// constraint the call adjudicates.
function matchArmsAreIntLits(n: MatchExpr) {
  let lits = 0
  let i = 0
  while i < n.matchPats.length {
    const patIx = n.matchPats[i]
    const num = matchPatIntNumOf(patIx)
    if num >= 0 {
      lits = lits + 1
    } else {
      // The parser mints an `Ident` pattern only for `_`.
      let wild = false
      const pn = P.nodes[patIx]
      if pn is Ident { wild = true }
      if !wild { return false }
    }
    i = i + 1
  }
  lits > 0
}

// What an integer scrutinee refuses in pattern position, named for the type it actually is.
// Two callers — a node kind that is no literal at all, and a `Unary` that is not `-` over one.
function intArmRejectMsg(st: i32) {
  "invalid match pattern — a pattern over " +
    tyToStr(st) +
    " is an integer literal or the `_` wildcard"
}

// The `NumLit` an integer-literal pattern delivers — the pattern node itself, or the operand
// of the `Unary "-"` the negative spelling mints — or -1 for any other pattern. `patIx` back
// means positive, anything else negative, which is the `neg` flag every reader below takes.
function matchPatIntNumOf(patIx: i32) {
  if patIx < 0 { return -1 }
  const pn = P.nodes[patIx]
  if pn is NumLit { return patIx }
  matchNegPatNum(patIx)
}

// The `NumLit` a negative integer pattern negates, or -1 when the `Unary` is not that shape.
// `parseMatchPattern` mints a `Unary` in pattern position only as `-` over a number, so the
// miss is a defensive floor rather than a reachable spelling — and the operand read is
// bound-tested (an unbounded `P.nodes[...]` would trap the compiler instead of diagnosing).
function matchNegPatNum(patIx: i32) {
  const pn = P.nodes[patIx]
  if pn is Unary {
    if pn.unOp == "-" && pn.unArg >= 0 && pn.unArg < P.nodes.length {
      const inner = P.nodes[pn.unArg]
      if inner is NumLit { return pn.unArg }
    }
  }
  -1
}

// An integer-literal pattern's lexeme, sign included, for a diagnostic that quotes it back.
function matchIntPatLexeme(numIx: i32, neg: boolean) {
  const nn = P.nodes[numIx]
  if nn is NumLit {
    if neg { return "-" + nn.numText }
    return nn.numText
  }
  ""
}

// An integer-literal pattern's 64-bit value as `[hi, lo]`, or an empty list when it has none.
// Two arms are duplicates iff their pairs agree, so `0x10` and `16` are one arm and `-1` is not
// `1` — a lexeme compare would miss both. The negative spelling takes its two's complement,
// which also makes `-0` and `0` one key, as the emitted compare chain would.
function matchIntPatValue(numIx: i32, neg: boolean) {
  const empty: i32[] = []
  const nn = P.nodes[numIx]
  if nn is NumLit {
    if numLexIsFloat(nn.numText) { return empty }
    const pair = parseI64Pair(nn.numText)
    if !neg { return pair }
    const hi0 = pair[0]
    const lo0 = pair[1]
    let negHi = ~hi0
    if lo0 == 0 { negHi = ~hi0 + 1 }
    const out: i32[] = []
    out.push(negHi)
    out.push(~lo0 + 1)
    return out
  }
  empty
}

// One integer-literal arm pattern: type-checks it against the scrutinee and claims its value,
// reporting a mismatch or a duplicate at the pattern. `keyHi`/`keyLo` are the values already
// claimed (VL arrays are references, so the push is the caller's). Answers false only for a
// type mismatch — the one refusal that makes the pattern cover nothing.
function checkIntArmLit(
  patIx: i32,
  numIx: i32,
  neg: boolean,
  st: i32,
  keyHi: i32[],
  keyLo: i32[],
) {
  // Checked as the expression it is, so `nodeTyIx` is filled for the `==` the desugar builds
  // over it — an `i32` literal reaches an `i64` scrutinee by the widening lattice, never the reverse.
  const pt = checkNode(patIx)
  if !assignable(pt, st) {
    tErr(
      "match pattern type mismatch: expected " +
        tyToStr(st) +
        ", found " +
        tyToStr(pt),
      patIx,
    )
    return false
  }
  // A hole scrutinee can't decide the compare's form here — record the deferred `==` the
  // desugared chain emits, so the call that pins the parameter adjudicates it later.
  noteBinCstr(st, "==", pt)
  const key = matchIntPatValue(numIx, neg)
  if key.length != 2 { return true }
  let ki = 0
  while ki < keyHi.length {
    if keyHi[ki] == key[0] && keyLo[ki] == key[1] {
      tErr(
        "redundant match arm: `" +
          matchIntPatLexeme(numIx, neg) +
          "` is already covered",
        patIx,
      )
      return true
    }
    ki = ki + 1
  }
  keyHi.push(key[0])
  keyLo.push(key[1])
  true
}

// `match` over an integer scrutinee (D1572, VL-020): arms are integer literals of the
// scrutinee's type plus a mandatory `_`, since 2^32 cases is not a member set to be complete
// over. Duplicate arms and an arm after the `_` are errors. No emitter path of its own —
// `desugarMatchAt` already turns a non-`IsExpr` pattern into `scrut == pat`.
function checkMatchIntArms(n: MatchExpr, ix: i32, st: i32) {
  // The literal values already claimed, as parallel high/low halves of the 64-bit key.
  const keyHi: i32[] = []
  const keyLo: i32[] = []
  let hasWild = false
  let wildArm = -1
  // A pattern that is not an integer literal covers nothing — report it at the pattern and
  // suppress the missing-`_` report below, which would mis-blame coverage for it.
  let sawBadPat = false
  // -1 is the "unset" join seed (`joinTys` returns the other operand); the positive TY_ERR
  // sentinel would poison the join, so never seed with it.
  let matchTy = -1
  const nArms = n.matchArmStart.length
  let ai = 0
  while ai < nArms {
    let pj = 0
    while pj < n.matchArmCount[ai] {
      const patIx = n.matchPats[n.matchArmStart[ai] + pj]
      const pn = P.nodes[patIx]
      if pn is Ident {
        // The parser mints an `Ident` pattern only for `_`, so this arm is the wildcard.
        hasWild = true
        if wildArm < 0 { wildArm = ai }
      } else {
        const numIx = matchPatIntNumOf(patIx)
        if numIx < 0 {
          // Any other pattern is another vocabulary's arm (a type pattern, a member string,
          // or a parse-recovery node) — named here rather than read as a missing member.
          sawBadPat = true
          tErr(intArmRejectMsg(st), patIx)
        } else if (
          !checkIntArmLit(patIx, numIx, numIx != patIx, st, keyHi, keyLo)
        ) {
          sawBadPat = true
        }
      }
      pj = pj + 1
    }
    // An arm after the `_` is dead, and silently reordered if allowed: the wildcard
    // becomes the chain's bare `else`, so a later arm would test first — rejected, not reordered.
    if wildArm >= 0 && ai > wildArm {
      tErr(
        "unreachable match arm — the `_` wildcard must be the last arm",
        n.matchPats[n.matchArmStart[ai]],
      )
    }
    const body = n.matchBodies[ai]
    const bt = checkNode(body)
    let armTy = bt
    const bn = P.nodes[body]
    if bn is Block {
      armTy = blockTailTy
      // A statement-tail block has `blockTailTy == -1` ("no value") — that is void, not the
      // sentinel TY_ERR (both are -1), so a void-arm `match` must not be read as an error.
      if armTy < 0 { armTy = TY_VOID }
    }
    matchTy = joinTys(matchTy, armTy)
    ai = ai + 1
  }
  if matchTy < 0 { matchTy = TY_VOID }
  // Exhaustiveness is the wildcard, and it is required — an integer has no closed member set,
  // so there is no arm list that could stand in for one.
  if !hasWild && !sawBadPat {
    tErr("non-exhaustive match — an integer `match` needs a `_` arm", ix)
  }
  // Lower to an if/else chain in place (real pass only) so lint + emit see only if-chains.
  if !inferQuiet { desugarMatchAt(ix) }
  matchTy
}

// `match` over a value union desugars to the `is`-chain `desugarMatchAt` already builds (each
// type pattern parses as an `IsExpr`), so there is no second narrowing or tag test. What match
// adds is completeness: every member must be named or a `_` must be present. Three passes run
// in different orders (pattern diagnostics in source order, narrowing in chain order).
function matchBodyDeclares(bodyIx: i32, name: string) {
  if bodyIx < 0 { return false }
  const b = P.nodes[bodyIx]
  if b is Block {
    let i = 0
    while i < b.blkStmts.length {
      const st = P.nodes[b.blkStmts[i]]
      if st is LetDecl {
        if st.letName == name { return true }
      } else if st is FuncDecl {
        if st.fnName == name { return true }
      }
      i = i + 1
    }
  }
  false
}

// The two clause-level rejects that exist because the desugar splices rather than wraps: a name
// bound twice by one clause, and a name the arm body redeclares. Both would be accepted here and
// decided by the emitter's local allocator; both are reported at the binding.
function checkMatchBindNames(bIx: i32, bodyIx: i32) {
  if bIx < 0 { return 0 }
  const bn = P.nodes[bIx]
  if bn is Block {
    let i = 0
    while i < bn.blkStmts.length {
      const st = P.nodes[bn.blkStmts[i]]
      if st is LetDecl {
        let j = 0
        while j < i {
          const pv = P.nodes[bn.blkStmts[j]]
          if pv is LetDecl {
            if pv.letName == st.letName {
              tErr(
                "duplicate payload binding `" + st.letName + "`",
                bn.blkStmts[i],
              )
            }
          }
          j = j + 1
        }
        if matchBodyDeclares(bodyIx, st.letName) {
          tErr(
            "payload binding `" +
              st.letName +
              "` is redeclared in the arm body — rename one",
            bn.blkStmts[i],
          )
        }
      }
      i = i + 1
    }
  }
  0
}

// Checks a clause's `const` decls inside the arm's narrowing scope, so `const x = scrut.x`
// reads the field off the narrowed member and the name is visible to the following body.
// A duplicate binding is skipped rather than checked — `checkMatchBindNames` already reported
// it, and declaring it twice would stack a terse `redeclared x` on the explanatory message.
function checkMatchBindDecls(bIx: i32) {
  if bIx < 0 { return 0 }
  const bn = P.nodes[bIx]
  if bn is Block {
    let i = 0
    while i < bn.blkStmts.length {
      let dup = false
      const st = P.nodes[bn.blkStmts[i]]
      if st is LetDecl {
        let j = 0
        while j < i {
          const pv = P.nodes[bn.blkStmts[j]]
          if pv is LetDecl {
            if pv.letName == st.letName { dup = true }
          }
          j = j + 1
        }
      }
      if !dup { checkNode(bn.blkStmts[i]) }
      i = i + 1
    }
  }
  0
}

function checkMatchTypeArms(n: MatchExpr, ix: i32, st: i32, uMems: i32[]) {
  // `uMems` is the scrutinee's variant list (a nullable contributes its inner variants plus
  // `null`) — a data structure, never a re-split of a rendered spelling. `covered` is parallel.
  const covered: i32[] = []
  let ci = 0
  while ci < uMems.length {
    covered.push(0)
    ci = ci + 1
  }
  let hasWild = false
  // A pattern that names no member covers nothing — report it at the pattern and suppress the
  // exhaustiveness report below (the bad pattern is the root cause; don't cascade).
  let sawBadPat = false
  const nArms = n.matchArmStart.length
  // ── pass 1 (SOURCE order): resolve + validate every pattern, bank its check type, mark cover.
  let ai = 0
  while ai < nArms {
    let pj = 0
    while pj < n.matchArmCount[ai] {
      const patIx = n.matchPats[n.matchArmStart[ai] + pj]
      const pn = P.nodes[patIx]
      if pn is Ident {
        // The parser mints an `Ident` pattern only for `_` (every other name is a type
        // pattern), so this arm is the wildcard.
        hasWild = true
      } else if pn is IsExpr {
        const pt = isTypeTy(pn.isVariant, patIx)
        if pt < 0 {
          sawBadPat = true
          tErr("unknown type '" + pn.isVariant + "' in match pattern", patIx)
        } else if tyIsCompositePat(pt) {
          sawBadPat = true
          tErr(
            "match pattern `" +
              pn.isVariant +
              "` names a union — list its members as separate arms (`A | B => …`)",
            patIx,
          )
        } else {
          // Banks the resolved check type on the pattern node (the `isVarTyIx` row the emitter's
          // narrowing stack reads) instead of re-checking, which would duplicate the scrutinee's diagnostics.
          if patIx < isVarTyIx.length { isVarTyIx[patIx] = pt }
          if patIx < nodeTyIx.length { nodeTyIx[patIx] = TY_BOOL }
          const hit = markUnionCover(uMems, covered, pt)
          if hit == 0 {
            tErr(
              "match pattern `" +
                pn.isVariant +
                "` is not a member of " +
                tyToStr(st),
              patIx,
            )
          } else if hit < 0 {
            tErr(
              "redundant match arm: `" + pn.isVariant + "` is already covered",
              patIx,
            )
          }
        }
      } else if pn is StrLit {
        // A string-literal pattern discriminates a litunion's member text; over a value union
        // the arms discriminate types, so name the difference instead of a phantom missing member.
        sawBadPat = true
        tErr(
          "invalid match pattern " +
            pn.strText +
            " — a pattern over a value union is a member type or the `_` wildcard",
          patIx,
        )
      } else {
        sawBadPat = true
        tErr(
          "invalid match pattern — a pattern over a value union is a member type or the `_` wildcard",
          patIx,
        )
      }
      pj = pj + 1
    }
    // An or-pattern arm may not carry a payload binding: it gets no then-narrowing
    // (`collectThenNarrows` reports none for the `||` condition), so `scrut.x` would not type.
    if n.matchArmCount[ai] > 1 {
      if matchArmHasBinds(n, ai) {
        tErr(
          "payload binding is not allowed on an or-pattern arm — give each type its own arm",
          n.matchPats[n.matchArmStart[ai]],
        )
      }
    } else {
      checkMatchBindNames(matchArmBindsOf(n, ai), n.matchBodies[ai])
    }
    ai = ai + 1
  }
  // Whether every member is named (or a `_` stands in for the rest) — settled by pass 1, and
  // read by pass 3 as well as by the exhaustiveness report at the end.
  let exhaustive = hasWild
  if !hasWild {
    let ec = 0
    let allCov = true
    while ec < covered.length {
      if covered[ec] == 0 { allCov = false }
      ec = ec + 1
    }
    exhaustive = allCov
  }
  // Pass 2 (chain order): the progressive else narrowings. `armAcc[k]` is how much of the
  // accumulator holds when the chain enters arm `k` — `collectElseNarrows`' fold, same order.
  const elseArm = matchElseArmOf(n.matchPats, n.matchArmStart, n.matchArmCount)
  const accNames: string[] = []
  const accTys: i32[] = []
  const armAcc: i32[] = []
  let z = 0
  while z < nArms {
    armAcc.push(0)
    z = z + 1
  }
  let ck = 0
  while ck < nArms {
    if ck != elseArm {
      armAcc[ck] = accNames.length
      let pj = 0
      while pj < n.matchArmCount[ck] {
        collectElseNarrows(
          n.matchPats[n.matchArmStart[ck] + pj],
          accNames,
          accTys,
        )
        pj = pj + 1
      }
    }
    ck = ck + 1
  }
  if elseArm >= 0 { armAcc[elseArm] = accNames.length }
  // Pass 3 (source order): check each arm body under its branch's narrowing, joining arm value
  // types. -1 is the "unset" join seed; the positive TY_ERR sentinel would poison the join.
  let matchTy = -1
  let bi = 0
  while bi < nArms {
    const nmz: string[] = []
    const tyz: i32[] = []
    let q = 0
    while q < armAcc[bi] {
      nmz.push(accNames[q])
      tyz.push(accTys[q])
      q = q + 1
    }
    // The arm's own then-fact, pushed after the accumulated complement (order matters —
    // `applyNarrows` binds in order, so the arm's own type wins over the complement).
    if bi != elseArm || !exhaustive {
      if n.matchArmCount[bi] == 1 {
        collectThenNarrows(n.matchPats[n.matchArmStart[bi]], nmz, tyz)
      }
    }
    // The scope is pushed for the payload clause too, not just the narrowing — an arm can
    // bind without narrowing, and its `const`s must still be arm-local.
    const bindIx = matchArmBindsOf(n, bi)
    const scoped = nmz.length > 0 || bindIx >= 0
    if scoped {
      pushScope(-1)
      applyNarrows(nmz, tyz)
      checkMatchBindDecls(bindIx)
    }
    const body = n.matchBodies[bi]
    const bt = checkNode(body)
    let armTy = bt
    const bn = P.nodes[body]
    if bn is Block {
      armTy = blockTailTy
      // A statement-tail block has `blockTailTy == -1` ("no value") — that is void, not the
      // sentinel TY_ERR (both are -1), so a void-arm `match` must not be mistaken for an error.
      if armTy < 0 { armTy = TY_VOID }
    }
    if scoped { popScope() }
    matchTy = joinTys(matchTy, armTy)
    bi = bi + 1
  }
  if matchTy < 0 { matchTy = TY_VOID }
  // Exhaustiveness: `_` is allowed but never required — a match naming every member is
  // complete without one. Missing members render from the arena types, not a re-split spelling.
  if !hasWild && !sawBadPat {
    let missing = ""
    let mk = 0
    while mk < uMems.length {
      if covered[mk] == 0 {
        if missing != "" { missing = missing + ", " }
        missing = missing + tyToStr(uMems[mk])
      }
      mk = mk + 1
    }
    if missing != "" {
      tErr(
        "non-exhaustive match — missing " + missing + " (add the arm or a `_`)",
        ix,
      )
    }
  }
  // Lower to an if/else chain in place (real pass only) so lint + emit see only if-chains.
  if !inferQuiet { desugarMatchAt(ix) }
  matchTy
}

// Extracted from `checkNodeReal`'s `MatchExpr` arm (C3: thin the dispatcher).
function checkMatchExprNode(n: MatchExpr, ix: i32) {
  // Three arm vocabularies, decided by the scrutinee: an integer dispatches on literals
  // (D1572), a litunion on member strings, any other union on member types.
  const mTail = retTailPos
  retTailPos = false
  const st = checkNode(n.matchScrut)
  // The scrutinee and arm bodies are NOT in return-tail position — restore the flag on every
  // exit so a `match` subexpression stays transparent to a sibling in the same statement.
  if tyIsIntMatchScrut(st) || (tyIsHole(st) && matchArmsAreIntLits(n)) {
    const ri = checkMatchIntArms(n, ix, st)
    retTailPos = mTail
    return ri
  }
  if !tyIsLitUnion(st) {
    // A third arm vocabulary (D1572): an integer scrutinee dispatches on literals, asked before
    // the union tests (which have no member set for one). A hole takes it too when arms are int literals.
    const uMems: i32[] = []
    flattenVariantsInto(st, uMems)
    if uMems.length > 1 && !unionHasLitMember(uMems) {
      const r = checkMatchTypeArms(n, ix, st, uMems)
      retTailPos = mTail
      return r
    }
    tErr(matchScrutRejectMsg(st, uMems), ix)
    retTailPos = mTail
    return TY_ERR
  }
  // The member texts (inner, no quotes), and a parallel covered-flag.
  const members: string[] = []
  const sty = T.tys[st]
  if sty is TyUnion {
    let mi = 0
    while mi < sty.uMembers.length {
      const mm = T.tys[sty.uMembers[mi]]
      if mm is TyLit { members.push(mm.litText) }
      mi = mi + 1
    }
  }
  const covered: i32[] = []
  let ci = 0
  while ci < members.length {
    covered.push(0)
    ci = ci + 1
  }
  let hasWild = false
  // A pattern that is neither a member string literal nor the `_` wildcard covers nothing —
  // report it at the pattern and suppress the exhaustiveness error below (don't cascade).
  let sawBadPat = false
  // -1 is the "unset" join seed (`joinTys` returns the other operand); the positive TY_ERR
  // sentinel would poison the join (every arm joins back to error), so never seed with it.
  let matchTy = -1
  let ai = 0
  while ai < n.matchArmStart.length {
    // Patterns of arm `ai`.
    let pj = 0
    while pj < n.matchArmCount[ai] {
      const patIx = n.matchPats[n.matchArmStart[ai] + pj]
      const pn = P.nodes[patIx]
      if pn is Ident {
        // The parser mints an `Ident` pattern only for `_` (D-MATCHTY: every other name now
        // parses as a type pattern, handled below), so this arm is the wildcard.
        hasWild = true
      } else if pn is IsExpr {
        // A type pattern over a literal union: an identifier naming no type reaches this same
        // arm too, so the wording must not silently claim to cover every member.
        sawBadPat = true
        tErr(
          "invalid match pattern `" +
            pn.isVariant +
            "` — a pattern is a member string literal or the `_` wildcard",
          patIx,
        )
      } else if pn is StrLit {
        // The member name is the pattern's inner text (quotes stripped) — an expression
        // lexeme, not `tyname.groupInnerOf`'s home (a degenerate lexeme stays whole here).
        const raw = pn.strText
        let inner = raw
        if raw.length >= 2 { inner = raw.slice(1, raw.length - 1) }
        let found = -1
        let fi = 0
        while fi < members.length {
          if members[fi] == inner { found = fi }
          fi = fi + 1
        }
        if found < 0 {
          tErr(
            "match pattern \"" + inner + "\" is not a member of " + tyToStr(st),
            patIx,
          )
        } else if covered[found] == 1 {
          tErr(
            "redundant match arm: \"" + inner + "\" is already covered",
            patIx,
          )
        } else {
          covered[found] = 1
        }
      } else {
        // Any other node kind (a parse-recovered pattern, a future literal form):
        // same story — it covers nothing, so name it rather than mis-blame coverage.
        sawBadPat = true
        tErr(
          "invalid match pattern — a pattern is a member string literal or the `_` wildcard",
          patIx,
        )
      }
      pj = pj + 1
    }
    // Body value type. (Arm bodies are not checked in return-tail position; the match's joined
    // value seeds the function return once, below — avoids a per-arm void/err mis-seed.)
    const body = n.matchBodies[ai]
    const bt = checkNode(body)
    let armTy = bt
    const bn = P.nodes[body]
    if bn is Block {
      armTy = blockTailTy
      // A statement-tail block has `blockTailTy == -1` ("no value") — that is void, not the
      // sentinel TY_ERR (both are -1), so a void-arm `match` must not be mistaken for an error.
      if armTy < 0 { armTy = TY_VOID }
    }
    matchTy = joinTys(matchTy, armTy)
    ai = ai + 1
  }
  // A void-armed match leaves the join unset (-1) or void; normalize to void so the function-
  // body-tail seeding (`noteInferredRet`) does not mistake it for the error sentinel.
  if matchTy < 0 { matchTy = TY_VOID }
  // Exhaustiveness: every member covered, or a wildcard. Skipped after an invalid pattern —
  // that arm covers nothing, so a missing-member report would mis-blame what the pattern already explained.
  if !hasWild && !sawBadPat {
    let missing = ""
    let mk = 0
    while mk < members.length {
      if covered[mk] == 0 {
        if missing != "" { missing = missing + ", " }
        missing = missing + "\"" + members[mk] + "\""
      }
      mk = mk + 1
    }
    if missing != "" {
      tErr(
        "non-exhaustive match — missing " + missing + " (add the arm or a `_`)",
        ix,
      )
    }
  }
  // Lower to an if/else chain in place (real pass only) so lint + emit see only if-chains.
  if !inferQuiet { desugarMatchAt(ix) }
  retTailPos = mTail
  return matchTy
}

function checkIfStmtNode(n: IfStmt, ix: i32) {
  // Am I the else arm of an enclosing `if`? Read and cleared here, so the flag reaches
  // exactly one callee and every `if` inside a branch body sees `-1` (`pgUpKeys`).
  const isElseArm = ix >= 0 && ix == pgUpArmIx
  pgUpArmIx = -1
  const pgUpMark = pgUpKeys.length
  // An `if`/`else` in value position is an expression whose value is the join of its branch
  // tail values — capture whether THIS `if` sits in the function's return-tail position.
  const ifTail = retTailPos
  retTailPos = false
  const condTy = checkNode(n.ifCond)
  if !assignable(condTy, TY_BOOL) {
    tErr("if-condition must be boolean, got " + tyToStr(condTy), ix)
  }
  // Narrowing over a simple identifier: `is T` refines to the variant, `!= null`/`== null`
  // refine a nullable. Union-complement narrowing after `is T` is deliberately excluded — it missed real errors.
  const tnNames: string[] = []
  const tnTys: i32[] = []
  collectThenNarrows(n.ifCond, tnNames, tnTys)
  const enNames: string[] = []
  const enTys: i32[] = []
  collectElseNarrows(n.ifCond, enNames, enTys)
  // The guard-clause divergence test, hoisted: the post-guard leg and the `else if`
  // hand-up decision both ask it — deliberately the last-statement test, not the broader one.
  let thenExits = false
  const tnDiv = P.nodes[n.ifThen]
  if tnDiv is Block {
    const tdst = tnDiv.blkStmts
    if tdst.length > 0 {
      const tdlast = P.nodes[tdst[tdst.length - 1]]
      if tdlast is RetStmt { thenExits = true }
      else if tdlast is BreakStmt { thenExits = true }
      else if tdlast is ContinueStmt { thenExits = true }
    }
  }
  // Definite-assignment fork/join: each branch forks off the if-entry state and they join
  // after — assigned only if assigned on every surviving path; a diverging branch contributes nothing.
  const daEntry = daSnapshot()
  const daThenDiverges = daBranchDiverges(n.ifThen)
  // `is`-guard alternatives over a hole: a then-narrow refining a hole is an alternative the
  // body handles on its own branch, not an extra field demand — registered before the scope pushes.
  const altRows: i32[] = []
  // The rows this guard tests, including ones a previous pass already registered — the
  // guarded-return marking must fire on every pass, since the real pass witnesses the call site.
  const guardRows: i32[] = []
  let ai = 0
  while ai < tnNames.length {
    if !isPathKey(tnNames[ai]) {
      const curIx = lookup(tnNames[ai])
      if curIx >= 0 {
        const cur = T.tys[curIx]
        if cur is TyVar {
          const row = noteHoleAlt(curIx, cur.tvName, tnTys[ai])
          if row >= 0 {
            altRows.push(row)
            guardRows.push(row)
          } else {
            const seen = holeAltRowOf(cur.tvName, tnTys[ai])
            if seen >= 0 { guardRows.push(seen) }
          }
        }
      }
    }
    ai = ai + 1
  }
  if tnNames.length > 0 {
    pushScope(-1)
    applyNarrows(tnNames, tnTys)
  }
  retTailPos = ifTail
  // Every `return` under this branch is reached only by an argument satisfying the guard's
  // alternative — mark the branch so `noteInferredRet` records it as a guarded member.
  const guardedRet = guardRows.length > 0
  if guardedRet { guardAltStack.push(guardRows[guardRows.length - 1]) }
  checkNode(n.ifThen)
  if guardedRet { guardAltStack.pop() }
  retTailPos = false
  const thenTy = blockTailTy
  const thenIx = blockTailIx
  if tnNames.length > 0 { popScope() }
  // Seeds the inferred return from the then-branch value before the else is checked, so a
  // recursive call in the else resolves against the base case — only from a genuine value-`if`.
  if ifTail && n.ifElse >= 0 {
    if thenTy != TY_VOID && thenTy != TY_ERR {
      // The then-arm's implicit-return value is guarded exactly like an explicit
      // `return` inside it (`if v is T { v.foo } else { v.bar }`).
      if guardedRet { guardAltStack.push(guardRows[guardRows.length - 1]) }
      // The arm, not the arms' join: a tail `if`/`else` whose one arm is an open `[]` needs
      // the sibling arm's shape, and the join is a third arena row (D1591).
      noteInferRetWitness(thenIx, thenTy)
      noteInferredRet(thenTy)
      if guardedRet { guardAltStack.pop() }
    }
  }
  // Surviving paths' end-states, each as an unassigned snapshot. Seed with the
  // then-branch end if it survived.
  const daThenEnd = daSnapshot()
  daRestore(daEntry)
  let daElseDiverges = false
  let daElseEnd = daEntry
  let elseTy = TY_VOID
  const daHasElse = n.ifElse >= 0
  if daHasElse {
    daElseDiverges = daBranchDiverges(n.ifElse)
    if enNames.length > 0 {
      pushScope(-1)
      applyNarrows(enNames, enTys)
    }
    // An `else if` chain: the else node's VALUE is its own branch join, since `blockTailTy`
    // holds only the innermost block's tail and under-joins a mixed chain.
    const enElse = P.nodes[n.ifElse]
    // A chain link post-narrows the PARENT's fall-through, not its own — marked so its own
    // `checkIfStmtNode` banks into `pgUpKeys` instead of a scope that is about to be popped.
    if enElse is IfStmt { pgUpArmIx = n.ifElse }
    retTailPos = ifTail
    const elseRes = checkNode(n.ifElse)
    pgUpArmIx = -1
    retTailPos = false
    elseTy = blockTailTy
    let elseIx = blockTailIx
    // A chain link's value is the whole inner `if`'s join, and `blockTailIx` then names the
    // innermost block's tail — a node the join did not come from, so it names none (D1591).
    if enElse is IfStmt {
      elseTy = elseRes
      elseIx = -1
    }
    if enNames.length > 0 { popScope() }
    if ifTail {
      if elseTy != TY_VOID && elseTy != TY_ERR {
        noteInferRetWitness(elseIx, elseTy)
        noteInferredRet(elseTy)
      }
    }
    daElseEnd = daSnapshot()
  }
  // Closes each `is`-guard alternative: a diverging then-branch leaves the code after this
  // `if` unreachable for that argument (nothing required); otherwise record where the reached suffix starts.
  if !daThenDiverges {
    let ac = 0
    while ac < altRows.length {
      const row = altRows[ac]
      holeAltTailN[row] = holeShapeFieldCount(holeAltNames[row])
      ac = ac + 1
    }
  }
  // Joins the surviving paths from the empty set: unassigned on some surviving path. The
  // else path (or the entry fall-through with no else) always counts unless it diverges.
  daClear()
  if !daThenDiverges { daJoinInto(daThenEnd) }
  if daHasElse {
    if !daElseDiverges { daJoinInto(daElseEnd) }
  } else {
    daJoinInto(daEntry)
  }
  // Guard clause: a then that always exits applies the false narrowings to the rest of the
  // block. Subtractions accumulate over a sequence of guards; restricted to bare names only.
  if thenExits {
    let gi2 = 0
    while gi2 < enNames.length {
      const gKey = enNames[gi2]
      const gTy = enTys[gi2]
      if isPathKey(gKey) {
        // Paths keep the no-`else` gate, and an else arm never hands one up either — an
        // `npKeys` entry is retired in place by a call/write inside the arm.
        if !daHasElse && !isElseArm {
          npKeys.push(gKey)
          npTys.push(gTy)
          npInvBy.push(-1)
          npEpochs.push(narFnEpoch)
        }
      } else if isElseArm {
        pgUpKeys.push(gKey)
        pgUpTys.push(gTy)
      } else {
        // Banks what the place held before this subtraction, for the exhaustiveness check
        // after a trailing chain — the one line that makes `lookup` stop answering that question.
        if pgPreIx != ix {
          pgPreIx = ix
          pgPreKeys = []
          pgPreTys = []
        }
        pgPreKeys.push(gKey)
        pgPreTys.push(lookup(gKey))
        // ...and bank the shadowed declaration under the post-guard kind, so a consumer
        // needing the emitter's union can find it (D1035) — idempotent, banking the widest first.
        noteNarShadow(gKey, lookup(gKey), NAR_KIND_POSTGUARD)
        // One leg for both kinds: a null strip and a union subtraction are the same shadowing
        // `declare` — split only so the strip could skip the subtraction bank, now gone.
        declare(gKey, gTy)
      }
      gi2 = gi2 + 1
    }
    // The chain below this `if`, banked by every `else if` arm whose own then diverged —
    // applied in reverse push order, since the deepest arm's residual must win.
    if !isElseArm {
      let pu = pgUpKeys.length
      while pu > pgUpMark {
        pu = pu - 1
        noteNarShadow(pgUpKeys[pu], lookup(pgUpKeys[pu]), NAR_KIND_POSTGUARD)
        declare(pgUpKeys[pu], pgUpTys[pu])
      }
    }
  }
  // Retires this subtree's hand-ups, unless THIS `if` is a chain link whose then diverged —
  // then its entry rides up to the parent, which asks the same question.
  if !isElseArm || !thenExits {
    while pgUpKeys.length > pgUpMark {
      pgUpKeys.pop()
      pgUpTys.pop()
    }
  }
  retTailPos = ifTail
  // The `if`-expression's value type: with an `else`, the join of the two branch tail
  // values.
  if daHasElse { return joinTys(thenTy, elseTy) }
  // An else-less `if` used as a value is `T | null` in every position — the false fall-through
  // yields `null`. One rule asked once, replacing the old per-position gates (DECISIONS.md).
  if thenTy != TY_VOID && thenTy != TY_ERR { return mkNullableTy(thenTy) }
  return TY_VOID
}
// ── explicit numeric cast `x as T` ──────────────────────────────────────────

// `x as T` (B2) is an explicit, checked numeric conversion — unlike the implicit
// lossless-widening rule, it permits every numeric-scalar direction (plus narrowings and
// int/float conversions); the float->int forms trap at runtime on NaN/out-of-range. The
// propagation obligation a bare `as` takes on: the one home shared by the union and numeric arms.
function castPropagationFits(
  rest: i32,
  asTy: string,
  ix: i32,
  curRet: i32,
): boolean {
  // A pending return (-2, still inferring) is refused rather than joined into — a cast that
  // silently widens the function's own signature defeats the point of an explicit cast.
  if curRet == -2 {
    tErr(
      "`as " +
        asTy +
        "` propagates " +
        tyToStr(rest) +
        " — annotate the enclosing function's return type so the propagation has a declared home",
      ix,
    )
    return false
  }
  // At module scope there is nowhere to propagate to, and "the enclosing function cannot
  // return it" would name a function that does not exist — its own sentence, its own fix.
  if curRet < 0 {
    tErr(
      "`as " +
        asTy +
        "` propagates " +
        tyToStr(rest) +
        " out of the enclosing function, and there is none here — at module scope, use `as!` to trap or `as?` to take a nullable",
      ix,
    )
    return false
  }
  if !assignable(rest, curRet) {
    tErr(
      "`as " +
        asTy +
        "` propagates " +
        tyToStr(rest) +
        ", which the enclosing function cannot return (it returns " +
        tyToStr(curRet) +
        ") — use `as!` to trap instead, or `as?` to take the null here",
      ix,
    )
    return false
  }
  true
}

// Parks an `as` cast whose operand is still a hole: both of the trio's type-level questions
// depend on the operand, and a hole answers neither, so the numeric ladder admits the cast and
// types it `T`. One row per cast site, re-asked by `holeCastPinCheck` at the call that pins
// the hole (D1342).
function noteCastDemand(name: string, n: AsExpr, ix: i32, target: i32) {
  if name == "" { return 0 }
  // The pin describes the parameter, so the demand may only speak for a direct read of it —
  // `const b = a ?? 0` retypes `b`, so a rung reading the pin there must not fire on `b`.
  const vn = castOperandIdent(n.asObj)
  if vn == "" { return 0 }
  // A narrowing in force over the operand's place is the operand's type, not the pin's:
  // `a = 7` ahead of the cast leaves the parameter pinned while the cast reads a value that can't fail.
  if narrowedPathTy(vn) >= 0 { return 0 }
  // ...and a write to the hole binding is the same fact with no overlay to carry it: a hole
  // has nothing to narrow from, so only the write's own record says the pin has stopped describing it.
  if castClobbered(name + "." + vn) { return 0 }
  // An `is` guard over the hole means the same thing one statement out — declining is the
  // safe direction (never adds a refusal); this rung exists to close exactly that divergence.
  if holeHasIsAlt(name) { return 0 }
  let i = 0
  while i < holeCastIx.length {
    if holeCastIx[i] == ix { return 0 }
    i = i + 1
  }
  holeCastNames.push(name)
  holeCastMode.push(n.asMode)
  holeCastVar.push(vn)
  holeCastTgtTy.push(target)
  holeCastTgtName.push(n.asTy)
  holeCastIx.push(ix)
  holeCastRet.push(T.curRet)
  holeCastArgN.push(0 - 1)
  holeCastArgExp.push(0 - 1)
  holeCastArgIx.push(0 - 1)
  0
}

// The argument the body delivered a parked cast to, recorded so the pin can re-ask the compare
// the body already passed. `argIx` is the argument node — the cast itself, through parens — so
// the re-ask anchors exactly where the annotated twin's `argument N:` does. Last write wins.
function noteCastArgDest(argIx: i32, argN: i32, exp: i32) {
  // Free when nothing is parked, which is every call in almost every program — this runs once
  // per argument of every call, so the peel must sit behind the emptiness test, not in front.
  if holeCastIx.length < 1 { return 0 }
  if exp < 0 { return 0 }
  if tyIsHole(exp) { return 0 }
  let cix = argIx
  let peeled = false
  while !peeled {
    const cn = P.nodes[cix]
    if cn is Paren { cix = cn.parInner } else { peeled = true }
  }
  let i = 0
  while i < holeCastIx.length {
    if holeCastIx[i] == cix {
      holeCastArgN[i] = argN
      holeCastArgExp[i] = exp
      holeCastArgIx[i] = argIx
    }
    i = i + 1
  }
  0
}

// True when `ix` is (through parens) an `as` cast this body parked on a hole — a cast whose
// result type the pin can still widen to `T | null`, so no reader may treat it as settled.
function coalParkedHoleCast(ix: i32): boolean {
  if holeCastIx.length < 1 { return false }
  let cix = ix
  let peeled = false
  while !peeled {
    const cn = P.nodes[cix]
    if cn is Paren { cix = cn.parInner } else { peeled = true }
  }
  let i = 0
  while i < holeCastIx.length {
    if holeCastIx[i] == cix { return true }
    i = i + 1
  }
  false
}

// Record / read a hole binding the body wrote to, by `<holeName>.<ident>`. Idempotent.
function noteCastClobber(key: string) {
  if castClobbered(key) { return 0 }
  holeCastClob.push(key)
  0
}
function castClobbered(key: string): boolean {
  let i = 0
  while i < holeCastClob.length {
    if holeCastClob[i] == key { return true }
    i = i + 1
  }
  false
}

// The cast operand's identifier name, through parens, or "" for any other expression shape.
function castOperandIdent(ix: i32): string {
  if ix < 0 || ix >= P.nodes.length { return "" }
  const n = P.nodes[ix]
  if n is Paren { return castOperandIdent(n.parInner) }
  if n is Ident { return n.identName }
  ""
}

// The declared name of parameter `i` in a `Param`-node list, or "" — the call site's half of
// the direct-read rule above. A call through a function value has no declaration to read, and
// answers "", which declines every parked cast rather than adjudicating one blind.
function declParamNameAt(dParams: i32[], i: i32): string {
  if i < 0 || i >= dParams.length { return "" }
  const pn = P.nodes[dParams[i]]
  if pn is Param { return pn.parName }
  ""
}

// Every parked cast on hole `name`, re-asked under the type this call site pinned it to. The
// same shape `holeIsArrayDemanded` uses: the body records what it needs to know, and the
// argument is the first place the answer exists. Gated on the real pass because the `as?` half
// writes a node type, which a probe's save/restore does not cover.
function holeCastPinCheck(name: string, at: i32, pName: string) {
  if inferQuiet { return 0 }
  if at < 0 { return 0 }
  if pName == "" { return 0 }
  if tyIsHole(at) { return 0 }
  let k = 0
  while k < holeCastNames.length {
    if holeCastNames[k] == name && holeCastVar[k] == pName {
      castPinAdjudicate(k, at)
    }
    k = k + 1
  }
  0
}

// One parked cast, adjudicated against the pinned operand type `at`. The ladder is
// `checkCastNode`'s own, minus the arms a hole already answered — this rung must never be the
// first place a cast is rejected for a reason the direct spelling reports differently.
function castPinAdjudicate(k: i32, at: i32) {
  const target = holeCastTgtTy[k]
  if target < 0 { return 0 }
  const mode = holeCastMode[k]
  if mode == "trap" { return 0 }
  const castIx = holeCastIx[k]
  // `as%` picks no arm and cannot fail, so the pin answers only the two questions a hole hid:
  // is the pinned operand a number at all, and is either side a float.
  if mode == "wrap" { return castPinWrapCheck(at, target, castIx) }
  // A nullable operand is a union operand, expanded exactly as `checkCastNode`'s arm expands
  // it — one rule, two entry points, so the hole and the annotation cannot disagree.
  let argU = at
  const argN = T.tys[at]
  if argN is TyNullable {
    if argN.nInner >= 0 {
      const nulU = mkUnionTy([argN.nInner, TY_NULL])
      if nulU >= 0 { argU = nulU }
    }
  }
  const argT = T.tys[argU]
  const dom = numCastDomainName(holeCastTgtName[k], target)
  if argT is TyUnion {
    // `as u8` over a union, refused at the pin in `checkCastNode`'s own words (D1587) — the
    // hole is where the operand's union first becomes visible; declining silently would diverge.
    if dom == "u8" {
      tErr(
        "`as u8` narrows a number into 0..255, and " +
          tyToStr(argU) +
          " is a union — take the numeric arm first, then the range (`(x as! i32) as! u8`)",
        castIx,
      )
      return 0
    }
    if !unionCoversTy(argT, target) { return 0 }
    const rest = subtractTy(argU, target)
    if rest < 0 { return 0 }
    if mode == "null" { return castPinNullLand(k, castIx, target) }
    castPropagationFits(rest, holeCastTgtName[k], castIx, holeCastRet[k])
    return 0
  }
  const sn = primNameStr(primNameOf(at))
  if !numCastCanFail(sn, dom) { return 0 }
  if mode == "null" { return castPinNullLand(k, castIx, target) }
  castPropagationFits(TY_NULL, holeCastTgtName[k], castIx, holeCastRet[k])
  0
}

// D1341 — `as?` yields `T | null` exactly when the cast can fail, and at a hole operand
// `numCastCanFail` answered false, so the node typed the bare arm while the monomorphizer
// pinned the operand to a box. Re-records the result from the pinned answer; the cell that
// must not move is one where the pin makes the cast infallible.
function castPinNullResult(castIx: i32, target: i32) {
  const nt = mkNullableTy(target)
  if nt < 0 { return 0 }
  if castIx >= 0 && castIx < nodeTyIx.length { nodeTyIx[castIx] = nt }
  0
}

// D1371 — the re-record is not the whole answer: the body already handed the cast's value
// somewhere, at the pre-pin type, so it must be re-asked here through `argMismatchErr` — the
// one home of both the wording and the anchor, so the hole reports character-for-character
// what the annotated twin reports at the same position.
function castPinNullLand(k: i32, castIx: i32, target: i32) {
  castPinNullResult(castIx, target)
  const exp = holeCastArgExp[k]
  if exp < 0 { return 0 }
  const nt = nodeTyIxOf(castIx)
  if nt < 0 { return 0 }
  if assignable(nt, exp) { return 0 }
  argMismatchErr(holeCastArgN[k], exp, nt, holeCastArgIx[k])
  0
}

// Whether a numeric cast can fail, under the owner's ruling: a cast to an integer target is
// exact-or-fail, a cast to a float target rounds and cannot. `u8` is a domain, not a target
// type (D1587) — `x as u8` produces an `i32`, and what `u8` names is the range 0..255, so
// every numeric source (i32 included) can fail it. The nine pairs are closed, matching the emitter (D965).

export function numCastCanFail(src: string, tgt: string): boolean {
  if tgt == "f64" || tgt == "f32" { return false }
  if tgt == "u8" {
    return src == "i32" || src == "i64" || src == "f32" || src == "f64"
  }
  if tgt == "i32" { return src == "f64" || src == "f32" || src == "i64" }
  if tgt == "i64" { return src == "f64" || src == "f32" }
  false
}

// The exactness domain a numeric cast narrows into — the target's primitive name, except
// where the author wrote `u8` (D1587), whose value type is `i32` but this returns "u8"
// instead. Two names for one cast: the rep target decides the conversion opcode and the box
// row, the domain decides the range test and the `as!` message.
export function numCastDomainName(asTy: string, target: i32): string {
  if asTy == "u8" { return "u8" }
  primNameStr(primNameOf(target))
}

// Reports and answers true when a wrap cast names a float on either side. `as%` is integers
// only by ruling, and the refusal names the family that does convert a float. One home for the
// wording, because a hole operand re-asks it at the call site that pins the width.
function wrapCastFloatRefused(argTy: i32, target: i32, ix: i32): boolean {
  const sn = primNameStr(primNameOf(argTy))
  const tn = primNameStr(primNameOf(target))
  let bad = ""
  if sn == "f32" || sn == "f64" { bad = sn }
  if tn == "f32" || tn == "f64" { bad = tn }
  if bad == "" { return false }
  tErr(
    "`as%` wraps between integer widths, and " +
      bad +
      " is a float — use the exact family (`as!` traps, `as?` yields null)",
    ix,
  )
  true
}

// One parked `as%` cast, re-asked under the type its call site pinned the hole to. Reported in
// `checkCastNode`'s own words, so the pin and the direct spelling cannot disagree.
function castPinWrapCheck(at: i32, target: i32, castIx: i32) {
  if !isNumeric(at) {
    tErr("`as` supports numeric conversions only", castIx)
    return 0
  }
  if wrapCastFloatRefused(at, target, castIx) { return 0 }
  0
}

function checkCastNode(n: AsExpr, ix: i32) {
  const arg = checkNode(n.asObj)
  let target = nameToTyAt(n.asTy, ix)
  // `x as u8` is the i64->i32 narrowing with a different domain (D1587): `u8` is a storage
  // type resolving to nothing in value position, but narrows the number into 0..255, exactly-or-fail.
  const isU8Cast = target < 0 && n.asTy == "u8"
  if isU8Cast { target = TY_I32 }
  if target < 0 {
    tErr("unknown type `" + n.asTy + "` in `as` cast", ix)
    return TY_ERR
  }
  // A hole operand answers neither of the trio's type-level questions, so the numeric ladder
  // admits it on purpose — park both on the hole, re-asked at the call site that pins it (D1342).
  if arg >= 0 {
    const argH = T.tys[arg]
    if argH is TyVar { noteCastDemand(argH.tvName, n, ix, target) }
  }
  // Union-operand `as` is the ruled propagation cast: `x as T` over `x: A|B|...` names the arm
  // wanted, everything else is the error. A nullable operand is a union operand — one arm, no second ladder.
  let argU = arg
  if arg >= 0 {
    const argN = T.tys[arg]
    if argN is TyNullable {
      if argN.nInner >= 0 {
        const nulU = mkUnionTy([argN.nInner, TY_NULL])
        if nulU >= 0 { argU = nulU }
      }
    }
  }
  // `as%` picks no arm — it is the wrap cast over two integer widths, so a union operand is
  // simply not a number and takes the numeric ladder's own refusal below.
  if argU >= 0 && n.asMode != "wrap" {
    const argT = T.tys[argU]
    if argT is TyUnion {
      // `as u8` narrows a number, it does not pick an arm (D1587) — a union operand taking
      // the arm ladder would hand back the arm's own `i32` with no range test.
      if isU8Cast {
        tErr(
          "`as u8` narrows a number into 0..255, and " +
            tyToStr(argU) +
            " is a union — take the numeric arm first, then the range (`(x as! i32) as! u8`)",
          ix,
        )
        return TY_ERR
      }
      if !unionCoversTy(argT, target) {
        tErr(
          "`as " +
            n.asTy +
            "` names a type that is not a member of " +
            tyToStr(argU),
          ix,
        )
        return TY_ERR
      }
      const rest = subtractTy(argU, target)
      if rest < 0 {
        tErr(
          "`as` cannot compute the propagated remainder of " + tyToStr(argU),
          ix,
        )
        return TY_ERR
      }
      // `as!` traps on a miss, so nothing is propagated and the enclosing return is not
      // consulted at all — that is the whole point of the form.
      if n.asMode == "trap" { return target }
      // `as?` coalesces to null, so the expression is `T | null` — again nothing propagates.
      // Whether `T | null` has a rep at all is the emitter's question, not this checker's.
      if n.asMode == "null" { return mkNullableTy(target) }
      // The propagated remainder must fit the enclosing return, because that is where it
      // goes. A pending return (-2) is refused rather than joined into.
      if !castPropagationFits(rest, n.asTy, ix, T.curRet) { return TY_ERR }
      return target
    }
  }
  const tn = primNameOf(target)
  const targetIsScalar = tn == "i32" ||
    tn == "i64" ||
    tn == "f32" ||
    tn == "f64"
  if !isNumeric(arg) || !targetIsScalar {
    tErr("`as` supports numeric conversions only", ix)
    return TY_ERR
  }
  // `as%` keeps the low bits and cannot fail, so it owes none of the trio's sad-path answers
  // and the target type is the whole result (`DECISIONS.md` §"`as%` is the wrap cast").
  if n.asMode == "wrap" {
    if wrapCastFloatRefused(arg, target, ix) { return TY_ERR }
    return target
  }
  // The numeric arm honours the trio too: a cast that can fail owes the same three answers
  // the union arm gives, from the same words — the suffix went unchecked and silently ignored (D1041).
  const castDom = numCastDomainName(n.asTy, target)
  if numCastCanFail(primNameStr(primNameOf(arg)), castDom) {
    // `as!` traps on a miss, so nothing is propagated and the enclosing return is not
    // consulted — the same reading as the union arm's trap mode.
    if n.asMode == "trap" { return target }
    // `as?` re-wraps to `T | null` and the null stays local to the expression.
    if n.asMode == "null" { return mkNullableTy(target) }
    // A bare `as` propagates `null`, so the enclosing return must carry it.
    if !castPropagationFits(TY_NULL, n.asTy, ix, T.curRet) { return TY_ERR }
  }
  target
}

// Whether `ty` is one of the union's members, by arena identity or by `tySame` — the same two
// rungs `isStructOfTy` uses, and for the same reason: an arm reached through an alias is a
// different index for one type.
function unionHasMemberTy(u: TyUnion, ty: i32): boolean {
  if ty < 0 { return false }
  const ms = u.uMembers
  let i = 0
  while i < ms.length {
    if ms[i] == ty { return true }
    if tySame(ms[i], ty) { return true }
    i = i + 1
  }
  false
}

// Whether the union covers `ty` — `ty` is one of its arms, or a sub-union of them. A program
// often keeps a domain union and an error type apart and joins them at one boundary
// (`parse(...): Circle | Rect | ParseError` wants `as Shape`), so requiring a single arm
// rejected exactly that. A sub-union target is also cheaper: the same box at a narrower type, no unbox.
function unionCoversTy(u: TyUnion, ty: i32): boolean {
  if ty < 0 { return false }
  if unionHasMemberTy(u, ty) { return true }
  const t = T.tys[ty]
  if !(t is TyUnion) { return false }
  const want: i32[] = []
  flattenVariantsInto(ty, want)
  if want.length < 1 { return false }
  let i = 0
  while i < want.length {
    if !unionHasMemberTy(u, want[i]) { return false }
    i = i + 1
  }
  true
}

// ── unary ──────────────────────────────────────────────────────────────────

// Extracted from `checkNodeReal`'s `Unary` arm (C3: thin the dispatcher).
function checkUnaryNode(n: Unary, ix: i32) {
  const arg = checkNode(n.unArg)
  if n.unOp == "!" {
    if !assignable(arg, TY_BOOL) {
      tErr("operator '!' expects boolean, got " + tyToStr(arg), ix)
    }
    return TY_BOOL
  }
  // Postfix `x++`/`x--`: `unArg` is the `x = x +- 1` assignment, already fully checked
  // above (const-reassign, arithmetic, assignability). The postfix type is the operand's.
  if n.unOp == "p+" || n.unOp == "p-" {
    if !isNumeric(arg) {
      tErr("'++'/'--' expects a numeric variable, got " + tyToStr(arg), ix)
      return TY_ERR
    }
    return arg
  }
  // The negation of an unpinned intrinsic element takes the default its binary siblings
  // take (D1566), asked here (not above `!`) since `!a[0]` is admitted over an open operand today.
  let arg2 = arg
  if arg2 < 0 {
    const peekU = arrDefOperandElemPeek(n.unArg)
    if peekU >= 0 { arg2 = peekU }
  }
  if !isNumeric(arg2) {
    tErr("unary '-' expects a numeric type, got " + tyToStr(arg2), ix)
    return TY_ERR
  }
  // Host parity: the host folds `-lit` into a signed literal before defaulting, so
  // `-2147483648` sits at I32_MIN and is i32 even though the bare literal alone types i64.
  if n.unOp == "-" {
    if isNegI32MinLit(n.unArg) { return TY_I32 }
  }
  arg2
}
// ── member `o.field` ───────────────────────────────────────────────────────

// Extracted from `checkNodeReal`'s `Member` arm (C3: thin the dispatcher).
function checkMemberNode(n: Member, ix: i32) {
  // Flat layout constant (webcraft P1.2): answered before the receiver is checked, since the
  // receiver is a TYPE name and checking it as an expression would be "undeclared identifier".
  const fl = flatMemberFold(n, ix)
  if fl == 1 { return TY_I32 }
  if fl == 2 { return TY_ERR }
  // A layout member on a type parameter: an `i32` whose value the monomorphizer
  // supplies per instance. The node stays a `Member` until then.
  if fl == 3 { return TY_I32 }
  // A flow-narrowed property path (`if o.v is T { … }`) overrides the stored
  // field type within the branch (the host's `narrowedPaths` overlay).
  const mKey = placeKeyOf(ix)
  if mKey != "" {
    const mOv = narrowedPathTy(mKey)
    if mOv >= 0 { return symMem(ix, mOv) }
    const mInv = narrowedPathInvBy(mKey)
    if mInv >= 0 && !pathRetiredByAssign(mInv) {
      return pathInvalidatedErr(mKey, mInv, ix)
    }
  }
  const objTy = checkNode(n.memObj)
  // A negative receiver type is an unpinned inference hole, not an arena index — indexing
  // `T.tys` with it would crash. Already reported elsewhere, so don't cascade.
  if objTy < 0 { return TY_ERR }
  const ot = T.tys[objTy]
  if ot is TyObj {
    const ft = objFieldType(ot, n.memProp)
    if ft < 0 {
      memberFloorErr(objTy, n.memProp, ix)
      return TY_ERR
    }
    return symMem(ix, ft)
  }
  if ot is TyErr { return TY_ERR }
  // Shared-field access over a struct union — a field every member carries at the same
  // type; an unshared field still needs an `is` narrowing.
  if ot is TyUnion {
    const sf = sharedUnionFieldTy(ot, n.memProp)
    if sf >= 0 { return symMem(ix, sf) }
    // The field is on some but not all members — unsafe until narrowed to a member that
    // has it. Names the offending member so a reader need not diff a four-arm union by hand.
    memberFloorErr(objTy, n.memProp, ix)
    return TY_ERR
  }
  // `.length` on an array, a map, or a string is an i32.
  if ot is TyArray {
    if n.memProp == "length" { return symMem(ix, TY_I32) }
    memberFloorErr(objTy, n.memProp, ix)
    return TY_ERR
  }
  if ot is TyMap {
    // `.length` and `.size` are both the live-entry count (an i32) — `.size` is the
    // JS Map/Set name, `.length` the list-consistent alias; both read the same field.
    if n.memProp == "length" { return symMem(ix, TY_I32) }
    if n.memProp == "size" { return symMem(ix, TY_I32) }
    memberFloorErr(objTy, n.memProp, ix)
    return TY_ERR
  }
  if ot is TyPrim {
    if ot.primName == "string" {
      if n.memProp == "length" { return symMem(ix, TY_I32) }
      memberFloorErr(objTy, n.memProp, ix)
      return TY_ERR
    }
  }
  // Member access on an inference hole records the demanded field and yields its derived
  // hole; the call site pins both (A13).
  if ot is TyVar {
    // D14-L/D691: `.length` on a type parameter is admitted here and re-asked at the pin —
    // a bounded type parameter reads its members from its bound first, checked before `.length` (OQ-5).
    const bmTy = boundMemberTy(ot.tvName, n.memProp, false)
    if bmTy == BOUND_UNRESOLVED {
      tErr(boundMemberUnknownMsg(ot.tvName, n.memProp), ix)
      return TY_ERR
    }
    if bmTy >= 0 { return symMem(ix, bmTy) }
    const bmMsg = boundMemberFloorMsg(ot.tvName, n.memProp)
    if bmMsg != "" {
      tErr(bmMsg, ix)
      return TY_ERR
    }
    if n.memProp == "length" {
      noteMemCstr(objTy, n.memProp, ix, false)
      return symMem(ix, TY_I32)
    }
    if ot.tvName.length > 0 {
      if ot.tvName[0] == '?' {
        // `.length` is the i32 length an array/string/map exposes — treat it as that (not a
        // struct field), so a collection-shaped hole infers without growing a bogus `{length}` shape.
        return symMem(ix, holeMemberTy(objTy, ot.tvName, n.memProp))
      }
    }
    // An unbounded `<T>` is an entirely open hole: the member read derives its type as the
    // `?`-hole does, keyed by the receiver's arena type so each generic adjudicates its own calls (D1431).
    if tpBoundOfName(ot.tvName) < 0 {
      noteMemCstr(objTy, n.memProp, ix, true)
      const tpFld = mkDerivedHole(HD_FLD, n.memProp, -1, -1, objTy)
      if tpFld >= 0 { return symMem(ix, tpFld) }
    }
  }
  memberFloorErr(objTy, n.memProp, ix)
  return TY_ERR
}
// ── array literal ───────────────────────────────────────────────────────────
// `[e, e, ...]` types as `T[]` where `T` is the first element's type (the rest must be
// assignable to it). An empty `[]` is `T[]` with an unknown element (`-1`), assignable to any
// array — its concrete element is pinned by the binding's annotation.

// Extracted from `checkNodeReal`'s `ArrayLit` arm (C3: thin the dispatcher).
function checkArrayLitNode(n: ArrayLit, _ix: i32) {
  const elems = n.arrElems
  if elems.length < 1 { return mkArrayTy(-1) }
  // A `void` element has no value to store — poisoned to `TY_ERR` rather than joined, so an
  // annotated literal keeps one "cannot assign" message instead of a second one.
  let elemTy = checkNode(elems[0])
  if voidValueSlotErr(elemTy, elems[0], "list element", elems[0]) {
    elemTy = TY_ERR
  }
  let ei = 1
  while ei < elems.length {
    let et = checkNode(elems[ei])
    if voidValueSlotErr(et, elems[ei], "list element", elems[ei]) {
      et = TY_ERR
    }
    // Host parity: the element type is the union of every element's type (flattened/deduped)
    // — mixed struct variants type as `(A | B | C)[]`; an annotation then checks structurally.
    elemTy = joinTys(elemTy, et)
    ei = ei + 1
  }
  return mkArrayTy(elemTy)
}
// ── index `a[i]` ────────────────────────────────────────────────────────────

// Extracted from `checkNodeReal`'s `Index` arm (C3: thin the dispatcher).
function checkIndexNode(n: Index, ix: i32) {
  const arrTy = checkNode(n.idxArr)
  const idxTy = checkNode(n.idxIndex)
  // Guard the unpinned-hole receiver (`-1` — see the Member-arm note).
  if arrTy < 0 { return TY_ERR }
  // A flow-narrowed constant-index place overrides the element type within the branch — asked
  // after the receiver/subscript check (unlike the member arm) since the subscript node needs banking.
  const xKey = placeKeyOf(ix)
  if xKey != "" {
    const xOv = narrowedPathTy(xKey)
    if xOv >= 0 { return xOv }
    const xInv = narrowedPathInvBy(xKey)
    if xInv >= 0 && !pathRetiredByAssign(xInv) {
      return pathInvalidatedErr(xKey, xInv, ix)
    }
  }
  const at = T.tys[arrTy]
  // A map index: the key must match the map's key type; a read yields the nullable value
  // (`V | null`), and an assignment target accepts a plain `V`.
  if at is TyMap {
    if !assignable(idxTy, at.mKey) {
      tErr(
        "map key must be " + tyToStr(at.mKey) + ", got " + tyToStr(idxTy),
        ix,
      )
    }
    return mkNullableTy(at.mVal)
  }
  // Indexing a hole constrains it to an array: demand an i32 index and return the element as
  // a derived hole (`HD_ELEM`), resolved per call site — mirrors `holeMemberTy` for `self.x`.
  if at is TyVar {
    if !assignable(idxTy, TY_I32) {
      // A non-i32 index can only be a map — constrain the hole to its demanded map and pin
      // the key from the index (the index-spelling twin of the `.set` arm's pin).
      if mapKeyTySupported(idxTy) {
        const hmi = holeMapDemandTy(at.tvName, false)
        const hmt = T.tys[hmi]
        if hmt is TyMap {
          if hmt.mKey < 0 {
            hmt.mKey = idxTy
            tyMutEpoch = tyMutEpoch + 1 // hole index-read pinned the demanded key in place
          }
          return mkNullableTy(hmt.mVal)
        }
      }
      tErr("array index must be i32, got " + tyToStr(idxTy), ix)
    }
    noteArrayDemand(at.tvName)
    // Admitted here and re-asked at the pin (D691): `noteArrayDemand` only reaches a bound
    // receiver and refuses scalars/maps — a record/nullable/function/union pinned reaches the emitter unruled.
    noteMemCstr(arrTy, OP_INDEX_GET, ix, false)
    return mkDerivedHole(HD_ELEM, "", -1, -1, arrTy)
  }
  // Free index operator (B14): `x[i]` on a non-indexable receiver resolves to a declared
  // `"[]"` function by type. Checked before the closure-field trap, mirroring the `a op b` order.
  if opIdxDeclared() {
    if !tyBuiltinIndexable(arrTy) {
      const rfn = opIdxFnFor(OP_INDEX_GET, arrTy)
      if rfn != "" {
        const bNames: string[] = []
        const bTys: i32[] = []
        opIdxBindGen(rfn, arrTy, idxTy, bNames, bTys)
        const kt = opIdxParamTy(rfn, 1)
        if kt >= 0 {
          const ktb = substTyDeep(kt, bNames, bTys)
          if !assignableExpr(n.idxIndex, idxTy, ktb) {
            tErr(
              "index: expected " + tyToStr(ktb) + ", got " + tyToStr(idxTy),
              ix,
            )
          }
        }
        opIdxBank(ix, rfn)
        const rty = opIdxRetTy(rfn)
        if bNames.length > 0 { return substTyDeep(rty, bNames, bTys) }
        return rty
      }
      // A write operator with no read operator is not a usable type: the assignment form
      // checks the target as an ordinary index and would name the wrong half — say which is missing.
      const wOnly = opIdxFnFor(OP_INDEX_SET, arrTy)
      if wOnly != "" {
        tErr(
          "operator " +
            opDeclLabel(wOnly) +
            " needs a matching \"" +
            OP_INDEX_GET +
            "\" operator — an index that cannot be READ cannot be written either",
          ix,
        )
        return TY_ERR
      }
    }
  }
  // Index trap (B13): a user object declaring `"[]"` handles `o[k]` itself — the key checks
  // against the method's parameter, checked before the native i32-index rule. Write traps use `"[]="`.
  if at is TyObj {
    const trap = objFieldType(at, "[]")
    if trap >= 0 {
      const tt = T.tys[trap]
      if tt is TyFunc {
        if tt.fnParamTypes.length == 1 {
          if !assignableExpr(n.idxIndex, idxTy, tt.fnParamTypes[0]) {
            tErr(
              "index: expected " +
                tyToStr(tt.fnParamTypes[0]) +
                ", got " +
                tyToStr(idxTy),
              ix,
            )
          }
          return tt.fnRet
        }
      }
    }
    tErr(indexFloorMsg(arrTy), ix)
    return TY_ERR
  }
  if !assignable(idxTy, TY_I32) {
    tErr("array index must be i32, got " + tyToStr(idxTy), ix)
  }
  if at is TyArray {
    // The element's value type — a `u8[]` read is an `i32`, never a `u8`. Same shape as the
    // string arm below: `string` is `(array i32)` with no `char` type above it (DECISIONS A7).
    return arrElemValueTy(at.aElem)
  }
  if at is TyErr { return TY_ERR }
  // Indexing a string yields the i32 code point at that position.
  if at is TyPrim {
    if at.primName == "string" { return TY_I32 }
  }
  tErr(indexFloorMsg(arrTy), ix)
  return TY_ERR
}
// ── object literal ──────────────────────────────────────────────────────────
// `{x: e, y: e}` types as a structural `TyObj` whose fields carry each value's checked type.
// Assignability against an annotation/param/return then matches it to a declared struct by
// structure, so field order need not match the declaration.

// Extracted from `checkNodeReal`'s `ObjLit` arm (C3: thin the dispatcher).
function checkObjLitNode(n: ObjLit, _ix: i32) {
  const fields = n.objFields
  const fnames: string[] = []
  const ftys: i32[] = []
  let i = 0
  while i < fields.length {
    const fnode = P.nodes[fields[i]]
    if fnode is FieldInit {
      fnames.push(fnode.fiName)
      // A `void` field initializer has no value to store — poisoned to `TY_ERR` so an
      // annotated literal keeps one message, instead of an uninterned-shape reject naming nothing.
      let fty = checkNode(fnode.fiValue)
      const fslot = "field '" + fnode.fiName + "'"
      if voidValueSlotErr(fty, fnode.fiValue, fslot, fnode.fiValue) {
        fty = TY_ERR
      }
      ftys.push(fty)
    }
    i = i + 1
  }
  return mkObjTy(fnames, ftys)
}
// ── type guard `x is T` ─────────────────────────────────────────────────────
// Always a `bool`. Checks the operand and that `T` names a known type. The actual narrowing of
// `x` to `T` happens in the then branch of an enclosing `if`; used elsewhere it is a boolean test.

// D228 — a numeric widening (`assignable`'s lattice) is a conversion, not a variant: codegen
// inserts a real instruction at the boundary, so the slot's value is not the source type and
// no runtime tag says it is. The hole is the whole lattice, not one spelling — every edge is
// admitted, through a nullable inner and a union member alike.
function widenScanFinds(
  cn: PrimName,
  chkTy: i32,
  ty: i32,
  depth: i32,
): boolean {
  if depth <= 0 { return false }
  if ty < 0 { return false }
  if chkTy == ty { return true }
  if cn == primNameOf(ty) { return true }
  const t = T.tys[ty]
  if t is TyNullable { return widenScanFinds(cn, chkTy, t.nInner, depth - 1) }
  if t is TyUnion {
    const ms = t.uMembers
    let i = 0
    while i < ms.length {
      if widenScanFinds(cn, chkTy, ms[i], depth - 1) { return true }
      i = i + 1
    }
  }
  false
}

function isWidenNotVariant(chkTy: i32, baseTy: i32) {
  const cn = primNameOf(chkTy)
  if cn == null { return false }
  if chkTy == baseTy { return false }
  const b = T.tys[baseTy]
  if b is TyUnion {
    const ms = b.uMembers
    let i = 0
    while i < ms.length {
      if widenScanFinds(cn, chkTy, ms[i], 8) { return false }
      i = i + 1
    }
    // `assignable` said yes and no member is this primitive, so the route it found is a
    // widening edge into one of them.
    return true
  }
  if cn == primNameOf(baseTy) { return false }
  numWidens(chkTy, baseTy)
}

// Extracted from `checkNodeReal`'s `IsExpr` arm (C3: thin the dispatcher).
// ── the deep-`is` predicates (D1035) ────────────────────────────────────────
// The array arm's element (`want` 0) or the string-keyed map arm's value (`want` 1) of a
// union, or -1 when it has none.
function jsonArmElemOf(ix: i32, want: i32): i32 {
  const ms = jsonUnionMembers(ix)
  let i = 0
  while i < ms.length {
    const m = T.tys[ms[i]]
    if m is TyArray {
      if want == 0 { return m.aElem }
    } else if m is TyMap {
      if want == 1 {
        if m.mSet == 0 {
          if primNameOf(m.mKey) == "string" { return m.mVal }
        }
      }
    }
    i = i + 1
  }
  -1
}

// The canonical `Json` a receiver type is a view of, or -1 when it is not a JSON tree at all.
// A receiver is often a complement narrowing of `Json` rather than `Json` itself (`if r is
// boolean { return }` leaves later reads typed `Json` minus boolean) — the walk resolves the
// complement to the union its arms are made of, so the memo key stays one per real target.
function jsonUnionRootOf(ix: i32): i32 {
  const e = jsonArmElemOf(ix, 0)
  const v = jsonArmElemOf(ix, 1)
  if e < 0 { return -1 }
  if v < 0 { return -1 }
  if !jsonSelfRef(e, v) {
    if !tySame(e, v) { return -1 }
  }
  if jsonSelfRef(e, ix) { return ix }
  const e2 = jsonArmElemOf(e, 0)
  if e2 < 0 { return -1 }
  if jsonSelfRef(e2, e) { return e }
  -1
}

// `jsonUnionRootOf` with the wider receiver admitted: `Json | JsonError` holds no container
// arm of its own, so the direct question answers -1 and the tree is found one member in.
// Bounded to one hop deliberately — a union of two JSON trees has no single root to guess at.
function jsonUnionRootIn(ix: i32): i32 {
  const direct = jsonUnionRootOf(ix)
  if direct >= 0 { return direct }
  const ms = jsonUnionMembers(ix)
  let i = 0
  while i < ms.length {
    const r = jsonUnionRootOf(ms[i])
    if r >= 0 { return r }
    i = i + 1
  }
  -1
}

// The member list of a union type, peeling a `TyNullable` wrapper. `type Json = null |
// boolean | ...` normalizes to a nullable over the five non-null arms, so a predicate that
// only reads `TyUnion.uMembers` answers false for the very type it is about.
export function jsonUnionMembers(ix: i32): i32[] {
  const none: i32[] = []
  if ix < 0 { return none }
  let cur = ix
  let g = 0
  while g < 8 {
    if cur < 0 { return none }
    const t = T.tys[cur]
    if t is TyNullable {
      cur = t.nInner
    } else if t is TyUnion {
      if t.uMembers.length == 1 {
        cur = t.uMembers[0]
      } else {
        return t.uMembers
      }
    } else {
      return none
    }
    g = g + 1
  }
  none
}

// Does `m` denote the union `ix` itself — the recursion that makes `Json` a tree? The
// nullable peel above means the arm's element type is the outer index while the member
// scan reads the inner union, so identity alone is not enough.
export function jsonSelfRef(m: i32, ix: i32): boolean {
  if m < 0 { return false }
  let cur = ix
  let g = 0
  while g < 8 {
    if cur < 0 { return tySame(m, ix) }
    if m == cur { return true }
    const t = T.tys[cur]
    if t is TyNullable {
      cur = t.nInner
    } else if t is TyUnion {
      if t.uMembers.length == 1 {
        cur = t.uMembers[0]
      } else {
        return tySame(m, ix)
      }
    } else {
      return tySame(m, ix)
    }
    g = g + 1
  }
  tySame(m, ix)
}

// Whether `mt` is one of `ut`'s members by identity. The membership question `is` asks today
// is answered by assignability, which admits a refinement of an arm and then answers false for
// it (D1035). The deep route needs the exact question: an arm is a tag, and only an arm has one.
function jsonExactMemberOf(ut: i32, mt: i32): boolean {
  if ut < 0 || mt < 0 { return false }
  // `null` is an arm of every nullable spelling and is tested by the ordinary route.
  if primNameOf(mt) == "null" { return true }
  const ms = jsonUnionMembers(ut)
  let i = 0
  while i < ms.length {
    if ms[i] == mt { return true }
    if tySame(ms[i], mt) { return true }
    i = i + 1
  }
  false
}

// A `seen` membership test for the recursion guard below (VL lists carry no `.has`).
function jwSeenHas(seen: i32[], ix: i32): boolean {
  let i = 0
  while i < seen.length {
    if seen[i] == ix { return true }
    i = i + 1
  }
  false
}

// The target side. "" when `ix` is a JSON shape the walker can build; otherwise the offending
// component, in words that name what the author wrote — the refusal blames the `is` site's `T`,
// never a std file. Vocabulary is `docs/serde-design.md`'s: prims, `T[]`, `{[string]: T}`,
// structs of those, `T | null`, and the JSON union itself (a wildcard, copied by reference).
export function jsonShapeBad(ix: i32, recvTy: i32, seen: i32[]): string {
  if ix < 0 { return "an unresolved type" }
  // The JSON union itself is the wildcard leaf: `x is Json` inside a shape is trivially true
  // and the value is taken by reference — asked first so a recursive `Json` skips the cycle guard.
  if jsonSelfRef(ix, recvTy) { return "" }
  const nw = nomNameOfTy(ix)
  if nw != "" {
    return "`" + nw + "` is a newtype; a JSON shape carries no brand"
  }
  if jwSeenHas(seen, ix) {
    return "`" +
      tyToStr(ix) +
      "` is recursive; a recursive JSON shape has no walker yet"
  }
  const t = T.tys[ix]
  if t is TyPrim {
    const p = t.primName
    if p == "boolean" { return "" }
    if p == "f64" { return "" }
    if p == "i32" { return "" }
    if p == "i64" { return "" }
    if p == "string" { return "" }
    if p == "null" { return "" }
    return "`" + p + "` has no JSON shape"
  }
  if t is TyErr { return "an unresolved type" }
  if t is TyFunc {
    return "`" + tyToStr(ix) + "` is a closure; a JSON shape cannot hold one"
  }
  if t is TyVar {
    return "`" +
      tyToStr(ix) +
      "` is a type parameter; a JSON shape must be concrete"
  }
  if t is TyLit {
    return "`" +
      tyToStr(ix) +
      "` is a literal type; a JSON shape has no literal walker yet"
  }
  if t is TyNeg { return "`" + tyToStr(ix) + "` is a negation" }
  seen.push(ix)
  if t is TyNullable {
    const r = jsonShapeBad(t.nInner, recvTy, seen)
    seen.pop()
    return r
  }
  if t is TyArray {
    if t.aElem < 0 {
      seen.pop()
      return "an array whose element type is unknown"
    }
    const r = jsonShapeBad(t.aElem, recvTy, seen)
    seen.pop()
    return r
  }
  if t is TyMap {
    if t.mSet == 1 {
      seen.pop()
      return "`" + tyToStr(ix) + "` is a Set; a JSON object is a map"
    }
    if primNameOf(t.mKey) != "string" {
      seen.pop()
      return "`" +
        tyToStr(ix) +
        "` has a non-string map key; a JSON object's keys are strings"
    }
    const r = jsonShapeBad(t.mVal, recvTy, seen)
    seen.pop()
    return r
  }
  if t is TyObj {
    const ftys = t.objFieldTypes
    const fnames = t.objFieldNames
    let i = 0
    while i < ftys.length {
      const r = jsonShapeBad(ftys[i], recvTy, seen)
      if r != "" {
        seen.pop()
        return "field `" + fnames[i] + "`: " + r
      }
      i = i + 1
    }
    seen.pop()
    return ""
  }
  if t is TyUnion {
    // `T | null` spelled as a two-member union is the one union shape the walker reads
    // unambiguously; every wider union refuses by naming the ambiguity rather than guessing an arm.
    const ms = t.uMembers
    if ms.length == 2 {
      if primNameOf(ms[0]) == "null" {
        const r = jsonShapeBad(ms[1], recvTy, seen)
        seen.pop()
        return r
      }
      if primNameOf(ms[1]) == "null" {
        const r = jsonShapeBad(ms[0], recvTy, seen)
        seen.pop()
        return r
      }
    }
    seen.pop()
    // The structural render, not the nominal one: the reader needs to see the arms to see
    // why they cannot be told apart, and `Amb` on its own names nothing.
    return "`" +
      tyToStructStr(ix) +
      "` is an ambiguous union of shapes; a JSON walker can only tell `T | null` apart"
  }
  seen.pop()
  "`" + tyToStr(ix) + "` has no JSON shape"
}

// The deduping record: one `jwTgt*` row per (target, receiver) pair, one `jwSite*` row per
// admitted site. Returns the target row.
function jwRecordSite(ix: i32, chkTy: i32, recv: string, rootTy: i32): i32 {
  const spell = tyToStr(chkTy)
  let ti = -1
  let i = 0
  while i < jwTgtSpell.length {
    if jwTgtSpell[i] == spell && jwTgtRecv[i] == recv { ti = i }
    i = i + 1
  }
  if ti < 0 {
    ti = jwTgtSpell.length
    jwTgtSpell.push(spell)
    jwTgtRecv.push(recv)
    jwTgtTy.push(chkTy)
    jwTgtRootTy.push(rootTy)
  }
  // One row per site, however many times the checker visits it: an un-annotated return is
  // checked more than once, and the rewrite is in-place, so a second visit must not re-add a row.
  let j = 0
  while j < jwSiteNode.length {
    if jwSiteNode[j] == ix { return ti }
    j = j + 1
  }
  jwSiteNode.push(ix)
  jwSiteTgt.push(ti)
  ti
}

// `x is T` over a JSON-shaped union where `T` is not one of its arms: 1 when the site is an
// admitted deep walk, -1 when it is not a deep site (the ordinary arm-membership gate runs),
// 0 when it IS a deep site with no JSON shape — diagnosed here. Uses the receiver's declared
// union, not the guard's narrowed view, since the emitter only holds the declared one.
function jsonReceiverDeclTy(objIx: i32, objTy: i32): i32 {
  if objIx < 0 { return objTy }
  let cur = objIx
  let g = 0
  while g < 4 {
    const n = P.nodes[cur]
    if n is Paren { cur = n.parInner }
    else if n is Ident { return jsonWidestDeclTy(n.identName, objTy) }
    else { return objTy }
    g = g + 1
  }
  objTy
}

// The outermost live shadow banked for `name`, or `objTy`. Not `narDeclaredTy` (which answers
// the innermost, possibly already-narrowed shadow), and not "the one with the most members" —
// a complement narrowing is the flattened union, so a most-members rule picks it every time,
// which is backwards. `popScope`/the epoch keep every row this walks live.
function jsonWidestDeclTy(name: string, objTy: i32): i32 {
  let i = 0
  while i < asgDeclKeys.length {
    if asgDeclKeys[i] == name {
      if asgDeclEpochs[i] == narFnEpoch {
        if asgDeclTys[i] >= 0 { return asgDeclTys[i] }
      }
    }
    i = i + 1
  }
  objTy
}

function jsonDeepIsSite(ix: i32, chkTy: i32, objIx: i32, objTy0: i32): i32 {
  jwBadMsg = ""
  if chkTy < 0 { return -1 }
  const objTy = jsonReceiverDeclTy(objIx, objTy0)
  const root = jsonUnionRootIn(objTy)
  if root < 0 { return -1 }
  // `x is Json` is the whole union and is trivially true — left to the ordinary route.
  // Membership is asked of the ROOT, not the receiver's possibly-narrowed view.
  if jsonSelfRef(chkTy, root) { return -1 }
  if jsonExactMemberOf(root, chkTy) { return -1 }
  // And an arm of the RECEIVER, not the same set when it is wider than the tree — a union
  // of `Json | Payload` makes `x is Payload` a tag test, not a walk.
  if jsonExactMemberOf(objTy, chkTy) { return -1 }
  const seen: i32[] = []
  const bad = jsonShapeBad(chkTy, root, seen)
  if bad != "" {
    // Not an error on its own: a JSON-shaped union is still an ordinary union, and the
    // ordinary route answers plenty of non-shape spellings — banked, used only if that gate rejects too.
    jwBadMsg = bad
    return 0
  }
  jwRecordSite(ix, chkTy, jsonParamSpell(objTy, root), root)
  1
}

// The walker's parameter, spelled through names the program already carries — the root, plus
// any arms the receiver reaches beyond the tree (a wider receiver like `Json | JsonError`).
// Not `tyToStr(objTy)`: a narrowed receiver's arena type renders as the union flattened, which
// mints a spelling nothing registered — an emit reject on a check-clean program.
function jsonParamSpell(objTy: i32, root: i32): string {
  if assignable(objTy, root) { return tyToStr(root) }
  let s = tyToStr(root)
  const ms = jsonUnionMembers(objTy)
  let i = 0
  while i < ms.length {
    if !jsonSelfRef(ms[i], root) {
      if !jsonExactMemberOf(root, ms[i]) {
        const m = tyToStr(ms[i])
        if !jsonSpellHas(s, m) { s = s + " | " + m }
      }
    }
    i = i + 1
  }
  s
}

// Whether `m` is already one of the ` | `-joined members of `s`. A flattened receiver can
// name the same arm twice, and a duplicated member is a different union to the tables that
// hold one — dedupes the spelling before any registration happens.
function jsonSpellHas(s: string, m: string): boolean {
  let i = 0
  while i + m.length <= s.length {
    if s.slice(i, i + m.length) == m {
      let leftOk = i == 0
      if i >= 3 {
        if s.slice(i - 3, i) == " | " { leftOk = true }
      }
      let rightOk = i + m.length == s.length
      if i + m.length + 3 <= s.length {
        if s.slice(i + m.length, i + m.length + 3) == " | " { rightOk = true }
      }
      if leftOk && rightOk { return true }
    }
    i = i + 1
  }
  false
}

function checkIsExprNode(n: IsExpr, ix: i32) {
  const objTy = checkNode(n.isObj)
  const chkTy = isTypeTy(n.isVariant, ix)
  // Bank the resolved check type on the `is` node so the emitter's narrowing stack carries
  // it as an arena index, instead of re-classifying the spelling at every read of the binding.
  if chkTy >= 0 {
    if ix >= 0 {
      if ix < isVarTyIx.length { isVarTyIx[ix] = chkTy }
    }
  }
  if chkTy < 0 {
    tErr("unknown type '" + n.isVariant + "' in 'is'", ix)
    // `objTy < 0` is the operand's own "no answer", not a type — indexing `T.tys` with it
    // would trap the compiler (D1462); an unresolved operand is freely testable, same as `TyErr`.
  } else if n.isVariant != "null" && objTy >= 0 {
    // Soundness: `x is T` is meaningful only when `T` is assignable to `x`'s type, since the
    // then branch narrows verbatim — an ungated test would launder invalid wasm through a newtype.
    const ot = T.tys[objTy]
    let baseTy = objTy
    let inUnion = false
    if ot is TyUnion {
      inUnion = true
    } else if ot is TyNullable {
      inUnion = true
      baseTy = ot.nInner
    }
    // A nullable whose inner is still open carries the in-band `-1` too (a bare `Map()`
    // read is `V | null` unpinned) — answered freely-testable, the same as an unresolved `TyErr`.
    if baseTy < 0 { return TY_BOOL }
    // The deep-`is` route, asked before the arm gate (D1035): `r is string[]` over a `Json`
    // passes assignability below (widens into `Json[]`) and would answer false for every value.
    const jwDeep = jsonDeepIsSite(ix, chkTy, n.isObj, objTy)
    if jwDeep == 1 { return TY_BOOL }
    if !assignable(chkTy, baseTy) || isWidenNotVariant(chkTy, baseTy) {
      if jwBadMsg != "" {
        tErr(
          "`is` check type '" +
            n.isVariant +
            "' is not a JSON shape — " +
            jwBadMsg,
          ix,
        )
      } else if inUnion {
        tErr(
          "`is` check type '" +
            n.isVariant +
            "' is not a variant of " +
            tyToStr(objTy),
          ix,
        )
      } else {
        tErr(
          "`is` check type '" +
            n.isVariant +
            "' can never match a value of type " +
            tyToStr(objTy),
          ix,
        )
      }
    } else {
      recordCollapsedIsAt(n, ix, objTy, chkTy)
    }
  }
  return TY_BOOL
}

// D1048's second hint — `is <literal>` over an operand whose union collapsed (`string | "err"`
// canon-collapses to `string`), which costs the discrimination the author thought they wrote:
// `r is "err"` now asks `r == "err"`. Asks the provenance (`bindingCollapsed`), never the type —
// the collapsed operand IS a plain `string`, so a type-based rule would fire on every legitimate use.
function recordCollapsedIsAt(n: IsExpr, ix: i32, objTy: i32, chkTy: i32) {
  if collBindName.length == 0 { return 0 }
  if chkTy < 0 || objTy < 0 { return 0 }
  const ct = T.tys[chkTy]
  if !(ct is TyLit) { return 0 }
  const on = P.nodes[n.isObj]
  if !(on is Ident) { return 0 }
  if !bindingCollapsed(on.identName) { return 0 }
  recordCollapsedIs(ix, on.identName, objTy, n.isVariant)
  0
}
// ── optional member `o?.field` ─────────────────────────────────────────────
// Null-safe access: a nullable receiver reads the field off its inner type and re-wraps the
// result nullable (`{x: i32} | null` ?. x -> `i32 | null`); a non-null receiver reads plainly.

// Extracted from `checkNodeReal`'s `OptMember` arm (C3: thin the dispatcher).
function checkOptMemberNode(n: OptMember, ix: i32) {
  // `x?.y` keys the same narrowed place as `x.y` (host `placeKey`).
  const omKey = placeKeyOf(ix)
  if omKey != "" {
    const omOv = narrowedPathTy(omKey)
    if omOv >= 0 { return symMem(ix, omOv) }
    const omInv = narrowedPathInvBy(omKey)
    if omInv >= 0 && !pathRetiredByAssign(omInv) {
      return pathInvalidatedErr(omKey, omInv, ix)
    }
  }
  const recv = checkNode(n.omObj)
  // Guard the unpinned-hole receiver (`-1` — see the Member-arm note).
  if recv < 0 { return TY_ERR }
  const rcv = T.tys[recv]
  let wasNullable = false
  let baseTy = recv
  if rcv is TyNullable {
    wasNullable = true
    baseTy = rcv.nInner
    // Peels a second nullable layer too: the host's `flattenType` collapses `T??` to `T?`,
    // so a doubly-nullable receiver still reads its field with one `?.`.
    if baseTy >= 0 {
      const rcv2 = T.tys[baseTy]
      if rcv2 is TyNullable { baseTy = rcv2.nInner }
    }
  }
  if baseTy < 0 { return TY_ERR }
  const bt = T.tys[baseTy]
  if bt is TyObj {
    const oft = objFieldType(bt, n.omProp)
    if oft < 0 {
      tErr("no field '" + n.omProp + "' on " + tyToStr(baseTy), ix)
      return TY_ERR
    }
    if wasNullable { return symMem(ix, mkNullableTy(oft)) }
    return symMem(ix, oft)
  }
  if bt is TyErr { return TY_ERR }
  // Shared union field through `?.` — same rule as the plain member read.
  if bt is TyUnion {
    const osf = sharedUnionFieldTy(bt, n.omProp)
    if osf >= 0 {
      if wasNullable { return symMem(ix, mkNullableTy(osf)) }
      return symMem(ix, osf)
    }
  }
  // A nullable receiver here is not "a non-object" — it is an object-less base behind a
  // `| null`. `?.` reaches declared struct fields only; builtins (`.length`) are unreachable through it.
  if wasNullable {
    tErr(
      "`?." +
        n.omProp +
        "` is not available on " +
        tyToStr(recv) +
        " — `?.` reads a declared struct field, and " +
        tyToStr(baseTy) +
        " has none; narrow the receiver instead, e.g. `if v != null { v." +
        n.omProp +
        " }`",
      ix,
    )
    return TY_ERR
  }
  tErr("member access '?." + n.omProp + "' on non-object " + tyToStr(recv), ix)
  return TY_ERR
}

// Extracted from `checkNodeReal`'s `WhileStmt` arm (C3: thin the dispatcher).
function checkWhileStmtNode(n: WhileStmt, ix: i32) {
  const wc = checkNode(n.whileCond)
  if !assignable(wc, TY_BOOL) {
    tErr("while-condition must be boolean, got " + tyToStr(wc), ix)
  }
  // Definite-assignment: a loop body may run zero times, so an in-body assignment is not
  // guaranteed to reach the fall-through — check the body live, then restore the pre-loop state.
  const daLoopEntry = daSnapshot()
  // The body is a narrowing scope like an `if` then-arm, re-tested every iteration. Only a
  // null strip re-narrows (never an `is T` pin), and only bare names (property paths can alias).
  const wnNames: string[] = []
  const wnTys: i32[] = []
  collectThenNarrows(n.whileCond, wnNames, wnTys)
  const wbNames: string[] = []
  const wbTys: i32[] = []
  let wi = 0
  while wi < wnNames.length {
    if !isPathKey(wnNames[wi]) {
      if wnTys[wi] == nonNullTy(lookup(wnNames[wi])) {
        wbNames.push(wnNames[wi])
        wbTys.push(wnTys[wi])
      }
    }
    wi = wi + 1
  }
  pushReBarrier()
  if wbNames.length > 0 {
    pushScope(-1)
    applyNarrows(wbNames, wbTys)
  }
  checkNode(n.whileBody)
  if wbNames.length > 0 { popScope() }
  popReBarrier()
  daRestore(daLoopEntry)
  return TY_VOID
}
// ── for range ──────────────────────────────────────────────────────────────
// Whether the expression at `ix` is an integer literal this pass folds — a `NumLit` fitting
// i32, a unary `+`/`-` over one, or either in parens. A `const` binding is not folded: the
// checker keeps no constant-value scope, so folding one would widen "constant" for no reader (D1588).
function constIntExprIs(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return false }
  const e = P.nodes[ix]
  if e is Paren { return constIntExprIs(e.parInner) }
  if e is Unary {
    if e.unOp == "-" || e.unOp == "+" { return constIntExprIs(e.unArg) }
    return false
  }
  constIntLeafIs(ix)
}

// The leaf the sign/paren peel above delegates to: a `NumLit` answers from its lexeme, and a
// name, call, operator or index is simply not constant — "no compile-time value" is the whole
// answer, not a hole, since the direction rule then does not apply and the range keeps its
// runtime contract (D1588).
function constIntLeafIs(ix: i32) {
  const e = P.nodes[ix]
  if e is NumLit {
    if numLexIsFloat(e.numText) { return false }
    return intLexemeFitsI32(e.numText)
  }
  false
}

// The folded i32 value of a `constIntExprIs` node. Asks the predicate first: every i32 is a
// legal bound and step, so no value here could mean "not constant" — an in-band sentinel
// would make each caller-side guard dead code. Anything else folds to 0 and must not be
// reached (D1588).
function constIntExprVal(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const e = P.nodes[ix]
  if e is Paren { return constIntExprVal(e.parInner) }
  if e is Unary {
    if e.unOp == "-" { return 0 - constIntExprVal(e.unArg) }
    if e.unOp == "+" { return constIntExprVal(e.unArg) }
    return 0
  }
  constIntLeafVal(ix)
}

// `constIntLeafIs`'s value twin, paired arm for arm: the `NumLit` its predicate accepted
// folds through the lexeme's own base, and every other kind answers 0 — a real bound, so
// reachable only by a caller that skipped the predicate (D1588).
function constIntLeafVal(ix: i32) {
  const e = P.nodes[ix]
  if e is NumLit { return parseI32(e.numText) }
  0
}

// The soft `to` keyword's token index, recovered from the end bound's own start: `parseFor`
// advances past `to` and parses the bound right after, so the keyword is the token before the
// bound's first (the same recovery `exportPrefix` makes for a dropped `export`). Verified at
// the token, not assumed — a mismatch falls back to the bound's own anchor (D1588).
function forToKwTok(toIx: i32) {
  const p = nodePos(toIx)
  if p < 0 { return -1 }
  const i = tokIndexAt(p)
  if i <= 0 || i - 1 >= P.toks.length { return -1 }
  const t = P.toks[i - 1]
  if t.kind == "IDENT" && t.text == "to" { return i - 1 }
  -1
}

// The refusal's sentence. `stepWritten` is false for a defaulted step, so the quoted range
// stays spelled as written while the parenthetical still names the deciding step. The
// suggested fix flips the step's sign, dropping it when the flip is the default `+1`, so the
// advice is always something the author could type (D1588).
function rangeNeverRunsMsg(
  from: i32,
  to: i32,
  step: i32,
  stepWritten: boolean,
) {
  const bounds = i32ToStr(from) + " to " + i32ToStr(to)
  let written = bounds
  if stepWritten { written = bounds + " step " + i32ToStr(step) }
  const flipped = 0 - step
  let fix = bounds
  if flipped != 1 { fix = bounds + " step " + i32ToStr(flipped) }
  let dir = "down"
  let rel = "below"
  let other = "up"
  if step > 0 {
    dir = "up"
    rel = "above"
    other = "down"
  }
  "this range never runs: `" +
    written +
    "` counts " +
    dir +
    " (step " +
    i32ToStr(step) +
    ") from a start " +
    rel +
    " its end — write `" +
    fix +
    "` to count " +
    other +
    ", or swap the bounds"
}

// The direction rule (D1588, VL-038). A range whose bounds and step are all compile-time
// constants and whose step contradicts its direction can never iterate; so can `step 0`. Both
// refused on one category — a constant descriptor that cannot complete as written. Runtime
// semantics are untouched: a non-constant wrong-order range still runs zero times, its contract.
function checkRangeNeverRuns(fromIx: i32, toIx: i32, stepIx: i32) {
  let stepK = 1
  const stepWritten = stepIx >= 0
  if stepWritten {
    if !constIntExprIs(stepIx) { return 0 }
    stepK = constIntExprVal(stepIx)
  }
  // Anchored at the step, not the `to`: this sentence names `step 0`, so the caret
  // belongs on the token the reader has to change. Fires whatever the bounds are.
  if stepK == 0 {
    return tErrCodedData(
      "a range with `step 0` never advances",
      stepIx,
      CODE_RANGE_NEVER_RUNS,
      diagDataField("step", "0"),
    )
  }
  if !constIntExprIs(fromIx) || !constIntExprIs(toIx) { return 0 }
  const from = constIntExprVal(fromIx)
  const to = constIntExprVal(toIx)
  if stepK > 0 && from <= to { return 0 }
  if stepK < 0 && from >= to { return 0 }
  const msg = rangeNeverRunsMsg(from, to, stepK, stepWritten)
  const data = diagDataField("from", i32ToStr(from)) +
    diagDataField("to", i32ToStr(to)) +
    diagDataField("step", i32ToStr(stepK))
  const tk = forToKwTok(toIx)
  if tk >= 0 {
    return tErrPush(
      msg,
      toIx,
      P.toks[tk].line,
      P.toks[tk].col,
      CODE_RANGE_NEVER_RUNS,
      data,
    )
  }
  tErrCodedData(msg, toIx, CODE_RANGE_NEVER_RUNS, data)
}

// Extracted from `checkNodeReal`'s `ForRange` arm (C3: thin the dispatcher).
function checkForRangeNode(n: ForRange, ix: i32) {
  const frFrom = checkNode(n.frFrom)
  const frTo = checkNode(n.frTo)
  if !assignable(frFrom, TY_I32) || !assignable(frTo, TY_I32) {
    tErr(
      "for-range bounds must be i32, got " +
        tyToStr(frFrom) +
        " and " +
        tyToStr(frTo),
      ix,
    )
  }
  if n.frStep >= 0 {
    const frStep = checkNode(n.frStep)
    if !assignable(frStep, TY_I32) {
      tErr("for-range step must be i32, got " + tyToStr(frStep), ix)
    }
  }
  checkRangeNeverRuns(n.frFrom, n.frTo, n.frStep)
  // A `for` body re-executes with no condition to re-establish anything, so every
  // narrowing live here predates it — see `pushReBarrier`.
  pushReBarrier()
  pushScope(ix)
  declare(n.frVar, TY_I32)
  if symEnabled != 0 { symDecl(n.frVar, ix, TY_I32, 0) }
  // Loop body may run zero times — see `WhileStmt` (A-definite-assign).
  const daFrEntry = daSnapshot()
  // The loop variable is always assigned in the body — clear it from the dead-zone so a body
  // read isn't flagged when it shadows a still-uninitialized module global of the same name.
  daMarkAssigned(n.frVar)
  checkNode(n.frBody)
  daRestore(daFrEntry)
  popScope()
  popReBarrier()
  return TY_VOID
}
// ── for v in iterable ───────────────────────────────────────────────────────
// A for-in loop over an array: the loop variable binds to the element type.

// Extracted from `checkNodeReal`'s `ForIn` arm (C3: thin the dispatcher).
function checkForInNode(n: ForIn, ix: i32) {
  const iterTy = checkNode(n.fiIter)
  let elemTy = TY_ERR
  const it = T.tys[iterTy]
  if it is TyArray {
    elemTy = it.aElem
    // A `u8[]` loop var binds an `i32`, never a `u8` — one iteration is one element read,
    // and a `u8` in a value position is exactly what `u8` may not be (same rule as an index read).
    if primNameOf(it.aElem) == "u8" { elemTy = TY_I32 }
  } else if it is TyMap {
    // `for k in m` over a map / set iterates its keys (the key type) — like
    // `for k in m.keys()`.
    elemTy = it.mKey
  } else if isStringTy(iterTy) {
    // `for ch in s` iterates a string's code units, each an i32, exactly as `s[i]` reads
    // one — a string is a `{backing, start, len}` view over an i32 array (Stage 2b).
    elemTy = TY_I32
  } else if it is TyErr {
    elemTy = TY_ERR
  } else {
    tErr("for-in expects an array or map, got " + tyToStr(iterTy), ix)
  }
  // See ForRange: a `for` body re-executes with nothing to re-establish a narrowing.
  pushReBarrier()
  pushScope(ix)
  declare(n.fiVar, elemTy)
  if symEnabled != 0 { symDecl(n.fiVar, ix, elemTy, 0) }
  // Loop body may run zero times — see `WhileStmt` (A-definite-assign).
  const daFiEntry = daSnapshot()
  // See ForRange: clear the loop var from the dead-zone for the body so it can't
  // collide with a shadowed, still-uninitialized module global of the same name.
  daMarkAssigned(n.fiVar)
  checkNode(n.fiBody)
  daRestore(daFiEntry)
  popScope()
  popReBarrier()
  return TY_VOID
}
// ── return ─────────────────────────────────────────────────────────────────

// Where an "expected void" comes from when nobody wrote `: void`: the bare `return`
// elsewhere in the body, which pins the return type (D1600). Empty for every other want.
function bareRetVoidNote(want: i32): string {
  if !curFnBareRetVoid { return "" }
  if !isVoidTy(want) { return "" }
  " — a bare `return` in this body makes the function void; drop it, or return no value here"
}

// Extracted from `checkNodeReal`'s `RetStmt` arm (C3: thin the dispatcher).
function checkRetStmtNode(n: RetStmt, ix: i32) {
  const want = T.curRet
  if n.retArg < 0 {
    // `tyIsHole` because `assignable` waves a `TyVar` past any destination, so a declared
    // `: T` accepted the bare return here and the emitter refused the instance (D1600).
    if want >= 0 && (tyIsHole(want) || !assignable(TY_VOID, want)) {
      // Both route-arounds, because either can be intended: the annotation is what makes this
      // return illegal, so dropping it is as valid a fix as supplying a value.
      tErr(
        "return needs a value of type " +
          tyToStr(want) +
          " — return a value, or annotate this function `: void`",
        ix,
      )
    }
    return TY_VOID
  }
  // Under a pending return type (-2: this function's return is being inferred),
  // record the returned type as a witness instead of checking a mismatch.
  if want == -2 {
    // `return <expr>` is always a value return position.
    fnSawValueRet = true
    // A returned call whose deferred join this site could not decide contributes the
    // whole join, not the lossy collapse the emitter gets (`inferRetTyOf`).
    const rArgTy = checkNode(n.retArg)
    // `return <void call>` names a value to return and has none — reported here rather than
    // left to the mismatch check below, which never sees this path (the return type is still inferred).
    if voidValueSlotErr(rArgTy, n.retArg, "return", ix) { return TY_VOID }
    // D1045 — a body-scoped nominal type may not escape through an inferred return.
    refuseLocalNomEscape(rArgTy, ix)
    // An empty-collection hole returned here has a destination not final until the body ends
    // — the pin is deferred to `flushInferRetHoles` rather than skipped (D1591).
    noteInferRetWitness(n.retArg, rArgTy)
    noteInferredRet(inferRetTyOf(n.retArg, rArgTy))
    return TY_VOID
  }
  // Bidirectional: `function mk(): (i32) => i32 { return (x) => … }` infers the returned
  // lambda's param from the declared return type (also through a composite return shape).
  if want >= 0 { seedExpected(n.retArg, want) }
  const got = checkNode(n.retArg)
  // The same gate under an explicit `: void`: `assignable(void, void)` holds, so a void flowed
  // into a module with nothing to return — every other declared type already reports its own mismatch.
  if isVoidTy(want) {
    if voidValueSlotErr(got, n.retArg, "return", ix) { return TY_VOID }
  }
  // Redundant-return rule: witness the explicit return's natural type (before
  // constrainEmpty); an annotation-influenced return disqualifies the function.
  if retInfluencedByAnnot(n.retArg) { retNaturalErr = true }
  noteNaturalRet(got)
  // An explicit `return inner` of an empty collection pins its element from the
  // declared return type — usage-driven inference clearing the floor.
  constrainEmptyExpr(n.retArg, got, want)
  if want >= 0 && !assignableExpr(n.retArg, got, want) {
    tErr(
      "return type mismatch: expected " +
        tyToStr(want) +
        ", got " +
        tyToStr(got) +
        bareRetVoidNote(want) +
        charLitForStringNote(n.retArg, want),
      ix,
    )
  } else if want >= 0 {
    // The check above is vacuous whenever a side is a hole — record the pair for the pin to
    // re-ask under substitution, only on the passing side (D551 body / D561 declared side).
    noteRetCstr(got, want, n.retArg)
  }
  return TY_VOID
}
// ── block ─────────────────────────────────────────────────────────────────

// Extracted from `checkNodeReal`'s `Block` arm (C3: thin the dispatcher).
function checkBlockNode(n: Block, ix: i32) {
  pushScope(ix)
  const stmts = n.blkStmts
  const savedRTP = retTailPos
  let tailTy = TY_VOID
  let tailIx = -1
  let i = 0
  while i < stmts.length {
    // Only the last statement is the block's value (and inherits tail position); the
    // rest are not the block's value, so they never carry the return tail.
    if i == stmts.length - 1 {
      retTailPos = savedRTP
    } else {
      retTailPos = false
    }
    const sty = checkNode(stmts[i])
    if i == stmts.length - 1 {
      // A value-producing trailing expression is the block's value; a trailing
      // statement (return / let / assignment / loop) leaves the block valueless.
      if !isStmtNode(stmts[i]) {
        tailTy = sty
        tailIx = stmts[i]
      } else {
        // An if-expression tail IS the block's value even though `IfStmt` is otherwise a
        // statement node — non-void only for a genuine value-`if` with an else.
        const lastN2 = P.nodes[stmts[i]]
        if lastN2 is IfStmt {
          if lastN2.ifElse >= 0 {
            if sty != TY_VOID && sty != TY_ERR {
              tailTy = sty
              tailIx = stmts[i]
            }
          }
        }
      }
    }
    i = i + 1
  }
  retTailPos = savedRTP
  popScope()
  blockTailTy = tailTy
  blockTailIx = tailIx
  return TY_VOID
}
