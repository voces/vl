import { checkProgramNode } from "./check_top_level"
import {
  T,
  TY_BOOL,
  TY_ERR,
  TY_F64,
  TY_I32,
  TY_I64,
  TY_NULL,
  TY_STR,
  TY_VOID,
  TyFunc,
  tyAt,
} from "./check_types"
import { numUnionMinted } from "./check_union_mint"
import { wsValueRead } from "./check_width"
import { fnDeclIx } from "./check_write_scan"
import {
  f64LitOverflows,
  numLexFitsI32,
  numLexIsFloat,
  numLexRadixBits,
} from "./emit_bignum"

// Thin recording wrapper around `checkNodeReal`: on the real (non-quiet) pass, stores each
// node's resolved type-arena index into the typed-IR table. Recording the arena index, not a
// snapshot, means a hole pinned later in place is reflected when the emitter reads it back — last write wins.
export function checkNode(ix: i32) {
  const savedTail = retTailPos
  if retTailPos {
    if !tailSpineNode(ix) {
      if nodeAt(ix) is MatchExpr { matchTailNodeSet(ix) }
      retTailPosSet(false)
    }
  }
  const t = checkNodeReal(ix)
  if expObsFn >= 0 { expObsRead(ix, t) }
  checkNodeDone(ix, t, savedTail)
  letDeclBoundRecord(ix)
  t
}

// A list literal or value `if` or `match` at `ix`, checked at `t`: its literals take the width
// it joined to. Called from its own `checkNodeReal` arm, which an `else if` link never reaches,
// so one walk covers a whole chain. Answers `t`.
function joinAdoptLits(ix: i32, t: i32): i32 {
  numLitAdoptJoin(ix, widenLitTy(t))
  t
}

// A value `if` or `match` at `ix`, checked at `t`: each arm's value is delivered to the join.
// Answers `t`.
function joinLeavesAt(ix: i32, t: i32): i32 {
  recordLeafCtxTy(ix, t)
  t
}

// The undeclared-identifier floor for the read `n` at `ix`: names the one position
// `__callsite__` is legal in, the unmerged interpolation renderer, or a moved or unimported
// name, before the generic message. Always answers `TY_ERR`.
function checkIdentUndeclared(n: Ident, ix: i32): i32 {
  // `__callsite__` is legal — as a parameter default value, and nowhere else.
  // Reaching the undeclared-identifier floor means it appears in an expression, so
  // say which position it belongs in rather than that the name does not exist
  // (it does; `checkParamDefaults` accepts it).
  if n.identName == CALLSITE_NAME {
    tErr(
      "`__callsite__` is legal only as a parameter default value — write `caller: { file: string, line: i32, col: i32 } = __callsite__`",
      ix,
    )
    return TY_ERR
  }
  // The interpolation renderer's floor: `$tpl$render` is minted by the parser and
  // rewritten to the merged `toString$mN` by `modBuildRename`, so reaching here means
  // `std:fmt` never entered the module graph. Named, since the generic
  // undeclared-identifier message would point at a name the author cannot have written.
  if n.identName == TPL_RENDER_LOCAL {
    tErr(
      "internal: an interpolation hole's renderer was not merged — `std:fmt` is missing from this program's module graph",
      ix,
    )
    return TY_ERR
  }
  const moved = stdFmtMovedNote(n.identName)
  if moved == "" && undeclaredImportRaise(n.identName, ix) { return TY_ERR }
  tErr(
    "undeclared identifier '"
      + n.identName
      + "'"
      + moved
      + arrayCtorCallNote(n.identName, ix),
    ix,
  )
  TY_ERR
}

// A numeric literal's type: f64 for a float lexeme (refusing one past the largest finite
// double), else the adopted or narrowest integer type that holds it exactly.
function checkNumLitNode(n: NumLit, ix: i32): i32 {
  // A literal with a "." is f64. An integer literal defaults to the NARROWEST
  // type that holds it exactly — i32 if its magnitude fits, else i64 — the
  // host's `defaultIntegerType` rule (`numLexFitsI32`).
  if numLexIsFloat(n.numText) {
    // A literal whose magnitude rounds past the largest finite double names a value f64
    // cannot represent — and VL has no infinity spelling to encode it honestly, so it is an
    // error (a silent ±inf would be a lossy implicit conversion). Runtime arithmetic still
    // yields ±inf per IEEE-754; this rejects only literal text.
    if f64LitOverflows(n.numText) { tErr("float literal overflows f64", ix) }
    return TY_F64
  }
  // A radix literal that adopted a 64-bit destination keeps that width across re-checks; one
  // wider than 64 bits has no destination at all, and says so here rather than wrapping.
  if n.numText.length >= 19 { cexNoteWideLit(ix, n.numText) }
  if litWide64Of(ix) { return TY_I64 }
  const ltt = litTreeTyOf(ix)
  if ltt >= 0 { return ltt }
  if numLexRadixBits(n.numText) > 64 {
    if !cexIsDerived(ix) { tErr(radixLitTooWideMsg(n.numText, 64), ix) }
    return TY_I64
  }
  if numLexFitsI32(n.numText) { return TY_I32 }
  TY_I64
}

// A bare-name read's type: a parameter default's module-frame read, a literal `const`'s
// literal, or the scope's binding with its use, capture and definite-assignment notes.
// An unbound name is the undeclared-identifier floor.
function checkIdentNode(n: Ident, ix: i32): i32 {
  // A marked parameter default resolves in the declaration's scope — for the one name form
  // v1 admits, the module frame. Checked once at the declaration and again at every call
  // site that omits the argument; the second reading is why the mark exists, so a
  // caller-local binding sharing the const's name cannot capture the substituted reference.
  if isDefaultGlobalRef(ix) {
    // A literal `const` is its literal here too, taken at the parameter's type.
    const dlit = lbiModLit[n.identName] ?? -1
    if dlit >= 0 {
      lbiInlineLit(ix, dlit, n.pos, n.identName)
      return checkNodeReal(ix)
    }
    const gd = identConstDeclOf(ix)
    if gd >= 0 {
      const gt = narTyAtDepth(gd, 0)
      if gt >= 0 { return gt }
    }
    return TY_ERR
  }
  // A literal `const` has no single type: each read is its literal, typed by where it stands.
  const lit = lbiConstLitAt(ix, n.identName)
  if lit >= 0 {
    lbiInlineLit(ix, lit, n.pos, n.identName)
    return checkNodeReal(ix)
  }
  // A dispatch arm's callee names no function: it is bound to its member's declaration, and
  // reads the type the arm recorded for it, else that declaration's.
  if n.identName == "" {
    const ad = identDeclOf(ix)
    if ad >= 0 && nodeAt(ad) is FuncDecl {
      const at = nodeTyIxOf(ix)
      return if at >= 0 { at } else { nodeTyIxOf(ad) }
    }
  }
  const ty = identTyOf(ix, n.identName)
  // A module name declared as both a function and a value is refused as redeclared; which
  // of the two a read means is unknowable, so the read is that error's cascade.
  if (
    identDepthOf(ix, n.identName) == 0
    && (modClashNames[n.identName] ?? false)
  ) {
    return TY_ERR
  }
  // Only a read at an extern's own type can name one, so the name lookup is asked of those alone.
  if ty >= extFnTyMin && ty < extFnTy.length && !extValueSeen {
    if extFnTy[ty] && ix != ckCalleeIx {
      if externLinkOf(n.identName) >= 0 { extValueSeenSet(true) }
    }
  }
  if ty < 0 { return checkIdentUndeclared(n, ix) }
  if (
    ix != ckCalleeIx
    && ty < T.tys.length
    && T.tys[ty] is TyFunc
    && stampsStand()
  ) {
    elabFnValNote(ty, identFnDeclOf(ix))
  }
  // `ty` is this use's type as the checker resolved it — narrowed when the use
  // sits inside a guarded arm. Threaded in so the occurrence retains it.
  if symEnabled != 0 { symUse(ix, n.identName, ty) }
  if ovSetMod.length > 0 && ix != ckCalleeIx {
    ovNoteFnValue(ix, n.identName, ty)
  }
  if ix != daWriteTarget {
    if crCapLossAny { crNoteLostName(n.identName, ix) }
    const crr = crReadHook(n.identName, ix)
    if crr >= 0 { return crr }
  }
  // Definite-assignment read gate: a bare-name read of a still-unassigned binding is "used
  // before assigned". The LHS of a plain `=` is a write, not a read (the `BinExpr` `=` arm
  // marks it `daWriteTarget` before evaluating the target), so it is skipped here; a
  // compound `x += …` desugars to `x = x + (…)`, whose RHS read does reach this gate.
  if ix != daWriteTarget { daCheckRead(n.identName, ix) }
  if lbiBindName.length > 0 && ix != daWriteTarget {
    lbiNoteRead(ix, n.identName)
  }
  // A top-level function read as a value keeps its declared parameters (D3992).
  if ix != ckCalleeIx && identDepthOf(ix, n.identName) == 0 {
    if fnDeclIx.has(n.identName) { wsValueRead[n.identName] = true }
  }
  // A pending function read as a value is inferred first, as a call to it would be.
  if (
    ix != ckCalleeIx
    && ty < T.tys.length
    && identDepthOf(ix, n.identName) == 0
  ) {
    const ft = tyAt(ty)
    if ft is TyFunc && ft.fnRet == -2 && !onInferStack(n.identName) {
      const dIx = fnDeclIx[n.identName] ?? -1
      if dIx >= 0 { checkNode(dIx) }
    }
  }
  ty
}

// Dispatches every node kind — expressions and statements — and returns the node's
// type-arena index (statements yield `TY_VOID`). The constant literals answer inline; every
// other kind goes to its per-kind checker with the narrowed variant.
// On a type error it raises a diagnostic and returns `TY_ERR` so checking continues.
function checkNodeReal(ix: i32) {
  if ix < 0 { return TY_ERR }
  if symEnabled != 0 && lbiInlinedName.length > 0 { lbiSymRead(ix) }
  const n = nodeAt(ix)

  // ── literals & identifiers ────────────────────────────────────────────────
  match n {
    NumLit => {
      return checkNumLitNode(n, ix)
    }
    StrLit => {
      return TY_STR
    }
    CharLit => {
      // A char literal `'x'` is its i32 code point (composes with arithmetic / `==` /
      // string indexing exactly like a bare int literal), not a string.
      return TY_I32
    }
    BoolLit => {
      return TY_BOOL
    }
    NullLit => {
      return TY_NULL
    }
    Ident => {
      return checkIdentNode(n, ix)
    }
    Paren => {
      return checkNode(n.parInner)
      // ── explicit numeric cast `x as T` ──────────────────────────────────────────
    }
    AsExpr => {
      return checkCastNode(n, ix)
      // ── unary ─────────────────────────────────────────────────────────────────
    }
    Unary => {
      if n.unOp == "-" || n.unOp == "~" {
        const uf = cexTryFold(ix)
        if uf == 1 { return checkNodeReal(ix) }
        if uf == 2 { return TY_ERR }
        if n.unOp == "-" { cexNoteNegOperand(n.unArg) }
      }
      return checkUnaryNode(n, ix)
    }
    BinExpr => {
      if n.binCompound.length == 0 && cexOp(n.binOp) {
        const bf = cexTryFoldBin(n, ix)
        if bf == 1 { return checkNodeReal(ix) }
        if bf == 2 { return TY_ERR }
      }
      const bt = checkBinExprNode(n, ix)
      if neKeys.length > 0 && n.binOp == "=" { neAssigned(n, curFnDeclIx) }
      return bt
    }
    Call => {
      // Named arguments run in parameter order, so no fact may reach a pop among them (D3558).
      if neKeys.length > 0 && crIsNamedCall(ix) { neKill("", curFnDeclIx) }
      const callTy = checkCallNode(n, ix)
      // An instance types the member calls a tagged call dispatches between at its own arguments.
      if elabCapLive() {
        for arm in fnTagInstanceArms(ix) { checkNode(arm) }
      }
      if numUnionMinted { njNoteHeldCall(n, ix, callTy) }
      // A call can falsify a path narrowing by a write the guarded scope never spells. Asked
      // after the arguments, so they read under the narrowing that holds there. A string hole's
      // render call that became a `Paren` around the hole runs nothing (D7765).
      if !(nodeAt(ix) is Paren) { noteCallInvalidations(ix) }
      return callTy
      // ── member access ───────────────────────────────────────────────────────────
    }
    Member => {
      return checkMemberNode(n, ix)
    }
    ArrayLit => {
      return joinAdoptLits(ix, checkArrayLitNode(n, ix))
    }
    // A loop variable declaration is never an expression; reading one is a malformed tree.
    LoopVar => {
      return TY_ERR
    }
    Spread => {
      // A spread the call and list-literal paths both declined — nothing here can unpack it.
      // The operand is still checked, so an error inside it is reported rather than swallowed.
      checkNode(n.spdArg)
      tErr(spreadNoRestMsg(""), ix)
      return TY_ERR
    }
    Index => {
      return checkIndexNode(n, ix)
    }
    ObjLit => {
      return checkObjLitNode(n, ix)
    }
    IsExpr => {
      return checkIsExprNode(n, ix)
    }
    OptMember => {
      return checkOptMemberNode(n, ix)
    }
    ErrExpr => {
      return TY_ERR
      // ── let / const ─────────────────────────────────────────────────────────────
    }
    LetDecl => {
      const lr = checkLetDeclNodeIn(n, ix)
      if neKeys.length > 0 { neKill(n.letName, curFnDeclIx) }
      if lpOn || exitFirstAt.length > 0 { noteExitFirstLet(n, ix) }
      return lr
    }
    FuncDecl => {
      const ft = checkFuncDeclNode(n, ix)
      if n.fnName == "" { elabFnValNote(ft, ix) }
      return ft
      // ── while ─────────────────────────────────────────────────────────────────
    }
    WhileStmt => {
      // A loop re-runs what a fact proved once (D3558), and so does a for loop below.
      if neKeys.length > 0 { neKill("", curFnDeclIx) }
      return checkWhileStmtNode(n, ix)
      // A `break` joins its value into the loop or block it leaves; a misplaced one is the
      // parser's and the emitter's to report.
    }
    BreakStmt => {
      return checkBreakNode(n, ix)
    }
    ContinueStmt => {
      return TY_VOID
      // ── for v in A to B [step S] ────────────────────────────────────────────────
      // A numeric range loop: the bounds (and step, if present) must be i32; the loop
      // variable is i32 in the body's scope.
    }
    ForRange => {
      if neKeys.length > 0 { neKill("", curFnDeclIx) }
      return checkForRangeNode(n, ix)
    }
    ForIn => {
      if neKeys.length > 0 { neKill("", curFnDeclIx) }
      return checkForInNode(n, ix)
    }
    MatchExpr => {
      return joinLeavesAt(ix, joinAdoptLits(ix, checkMatchExprNode(n, ix)))
    }
    IfStmt => {
      return joinLeavesAt(ix, joinAdoptLits(ix, checkIfStmtNode(ix)))
    }
    RetStmt => {
      return checkRetStmtNode(n, ix)
    }
    Block => {
      return checkBlockNode(n, ix)
    }
    Program => {
      return checkProgramNode(n)
    }
    Param => {
      return TY_VOID
    }
    TypeRef => {
      return TY_VOID
    }
    TypeDecl => {
      // Registered by the Program pass-0 pre-pass; nothing to do when visited.
      return TY_VOID
    }
    UnionDecl => {
      // Registered by the Program pass-0 pre-pass; nothing to do when visited.
      return TY_VOID
    }
    ImportDecl => {
      // A tooling node (the lint tier reads it): import binding/resolution
      // happened in the module front end (the driver's token-level `modScan` +
      // merge), so the checker has nothing to verify here.
      return TY_VOID
    }
    // a field row is checked by its owning literal or declaration
    FieldDef | FieldInit => {}
  }
  TY_ERR
}
