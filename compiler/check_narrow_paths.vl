// Narrowed paths: the narrowing slot of each place key with its epoch and invalidation, the
// writes that clobber a narrowing, and the capture rows a nested function reads through.
// Emptied by `narPathsReset`. Does not import the checker.
import {
  declDepthOf,
  declIsConst,
  declTyOf,
  identDepthOf,
  identSlotOf,
  scopeFramePush,
  slotLayerDepth,
  slotLayerPrev,
  slotLayerTop,
  slotLayerTy,
  slotNameOf,
  slotTyAt,
  slotTySetAt,
} from "./check_scopes"
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  ErrExpr,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  ImportDecl,
  Index,
  IsExpr,
  LetDecl,
  LoopVar,
  MatchExpr,
  Member,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  Program,
  RetStmt,
  Spread,
  StrLit,
  TypeDecl,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
  elseIfLink,
  i32ToStr,
  nodeAt,
  nodeSpineChildren,
  nodeToks,
  opDeclOpOf,
} from "./ast"
import { symEnabled } from "./check_state"
import { i32ListHas, strListHas } from "./listutil"
import { T, TyObj, tyAt, tyIsHole, tyReachesEmptyHole } from "./check_types"
import { LIST_EVERY_STEP, keyHasPrefix, placeKeyOf } from "./check_places"
import {
  placeAt,
  placeDecl,
  placeIdsReset,
  placeIntern,
  placeIsPath,
  placeText,
} from "./check_place_ids"
import { crLostPopTo, crLostPush } from "./check_capture_loss"
import {
  crAliasNestDepths,
  crAliasNestSlots,
  crAliasWr,
  crAskProg,
  crCapLossAny,
  crCapLossBank,
  crCapRecCount,
  crCapRecDepths,
  crCapRecFns,
  crCapRecHandles,
  crCapRecNames,
  crCapRecSlots,
  crCapRecTys,
  crFnBases,
  crFnIxs,
  crFnNpBases,
  crFnReBases,
  crFnRoots,
  crHandleMemo,
  crInfoMemo,
  crNestCallRet,
  crOpCall,
  crPendCalls,
  crPendDepths,
  crPendNames,
  crPendNarTys,
  crProgRoot,
  crRdIx,
  crRdRet,
  crRetCalls,
  crRetLoops,
  crRetNames,
  crRetNarTys,
  crRetRoots,
  crRetWideTys,
  crStmtFns,
  crStmtIxs,
  npKillSure,
} from "./check_capture_rows"
import {
  crNoNames,
  crOpOf,
  crwEnsure,
  crwFnHandle,
  crwFns,
  crwKeyText,
  crwKeysMeet,
  crwMentionsAny,
  crwRoot,
  crwUseKeyOf,
  crwUseKeys,
  crwUseKinds,
  crwWrites,
  crwWritten,
} from "./check_capture_walks"
import { cwKeyOfDecl, cwPeel, fnDeclIx } from "./check_write_scan"
import { memberDeclOf, sidLookup } from "./symbols"
import { calleeNameOf } from "./check_callee"
import { weUnresDrop } from "./check_write_effects"
import { hdReadNullAsked, hdRowOf } from "./check_hole_pins"
import { curFnDeclIx, inferQuiet } from "./check_cursor"
import { noteMemCstr } from "./check_cstr_rows"
import { holeShapeOf } from "./check_hole_rows"
import {
  NAR_KIND_GUARD,
  NAR_KIND_POSTGUARD,
  asgDeclDepths,
  asgDeclKinds,
  asgDeclTys,
  narBankPushFrame,
  narBankRowsOf,
  narDeclaredTy,
} from "./check_nar_bank"
import { SCOPE_EOF, symScopePush, symSpanPush } from "./check_sym_occ"
import {
  crBindDepthOfSlot,
  crCallBenign,
  crCurRoot,
  crFirstBank,
  crFnBase,
  crIsNarrowLayer,
  crNameAssignedInRoot,
  crSlotKey,
  crWidenedAt,
} from "./check_capture_widen"

// Flow-narrowed property paths: a stack of `key → type-arena index` entries (`"o.v" → i32`)
// overlaid while a branch body is checked, with per-scope frame marks so `popScope` unwinds what
// that scope pushed; bare-name narrowings ride the scope chain instead. `npInvBy` is the
// invalidation slot, written in place, since a shadowing push would resurrect the narrowing.
export let npKeys: string[] = []
export function npKeysPop(): string | null {
  npPlace.pop()
  npKeys.pop()
}
export function npKeysPush(p: i32) {
  npPlace.push(p)
  npKeys.push(placeText(p))
}

// Per slot, the place it narrows: a place is rooted at one binding, so an inner binding of the
// same name is a different place and hides nothing it should not.
export let npPlace: i32[] = []

// The innermost slot at or above `base` narrowing place `p`, or -1.
export function npSlotOf(p: i32, base: i32): i32 {
  if p < 0 { return -1 }
  let i = npPlace.length - 1
  while i >= base {
    if npPlace[i] == p { return i }
    i = i - 1
  }
  -1
}

export let npTys: i32[] = []
export function npTysPop() {
  npTys.pop()
  0
}
export function npTysPush(v: i32) { npTys.push(v) }

export let npInvBy: i32[] = []
export function npInvByPop() {
  npInvBy.pop()
  0
}
export function npInvByPush(v: i32) { npInvBy.push(v) }

export let npEpochs: i32[] = []
export function npEpochsPop() {
  npEpochs.pop()
  0
}
export function npEpochsPush(v: i32) { npEpochs.push(v) }

// Where the emitter retires a slot a CALL invalidated: the statement it retires after, -1 before
// the loop holding the call, -2 not at all, which keeps every later read refused (D2405).
export let npSettle: i32[] = []
export function npSettlePop() {
  npSettle.pop()
  0
}
export function npSettlePush(v: i32) { npSettle.push(v) }
export function npSettleSetAt(k: i32, v: i32) { npSettle[k] = v }

// The nested function that first read a slot's narrowing, or -1 (D2402).
export let npCapBy: i32[] = []
export function npCapByPop() {
  npCapBy.pop()
  0
}
export function npCapByPush(v: i32) { npCapBy.push(v) }
export function npCapBySetAt(k: i32, v: i32) { npCapBy[k] = v }

// 1 when the slot is an assignment's strip of `null` (D1848) rather than a guard's: a nested
// function reads the place at its declared type, and a write after one is checked against it.
export let npAsg: i32[] = []
export function npAsgPop() {
  npAsg.pop()
  0
}
export function npAsgPush(v: i32) { npAsg.push(v) }

export let npFrames: i32[] = []
export function npFramesPop() {
  npFrames.pop()
  0
}

// Places a write re-narrowed AWAY from the narrowing that covered them. A post-guard
// residual claims the fall-through path holds the else narrowing, and an arm that wrote a
// different member falsifies exactly that claim — which under the reads-only rule no type
// check on the write itself can catch (D1736).
export let narClobPlace: i32[] = []
export function narClobPlacePush(v: i32) { narClobPlace.push(v) }
export function narClobPlaceSet(v: i32[]) { narClobPlace = v }

// What each clobbering write left the name at, the type it held just before, and the scope depth
// it ran at. `checkIfStmtNode` folds them per arm and joins: a write at the arm's OWN depth runs
// whenever the arm does and decides alone, a deeper one is conditional (D1846).
export let narClobTys: i32[] = []
export function narClobTysPush(v: i32) { narClobTys.push(v) }
export function narClobTysSet(v: i32[]) { narClobTys = v }

export let narClobPrev: i32[] = []
export function narClobPrevPush(v: i32) { narClobPrev.push(v) }
export function narClobPrevSet(v: i32[]) { narClobPrev = v }

export let narClobDepths: i32[] = []
export function narClobDepthsPush(v: i32) { narClobDepths.push(v) }
export function narClobDepthsSet(v: i32[]) { narClobDepths = v }

// Whether the write RETIRED the narrowing, as against writing a member it already allowed. Only
// a retiring write can falsify a post-guard residual; the arm join reads every row (D1846).
export let narClobRetired: i32[] = []
export function narClobRetiredPush(v: i32) { narClobRetired.push(v) }
export function narClobRetiredSet(v: i32[]) { narClobRetired = v }

// Did a write at or after `mark` re-narrow place `p` away from its narrowing? `checkIfStmtNode`
// asks it of its own subtree before handing a residual down (D1736).
export function narClobberedSince(mark: i32, p: i32) {
  let i = mark
  while i < narClobPlace.length {
    if narClobPlace[i] == p && narClobRetired[i] == 1 { return true }
    i = i + 1
  }
  false
}

// The in-place writes a join has to see past: a scope binding retired in place (`atScope`, at
// depth `narIpAt`) or a path slot's invalidation (`npInvBy[narIpAt]`), with both values.
export let narIpScope: boolean[] = []

export let narIpAt: i32[] = []

export let narIpSlot: i32[] = []

export let narIpOld: i32[] = []

export let narIpNew: i32[] = []

// Rebinds slot `s` at scope depth `d` in place, journalled for `narHeadTy`.
export function narSetScope(d: i32, s: i32, ty: i32) {
  narIpScope.push(true)
  narIpAt.push(d)
  narIpSlot.push(s)
  narIpOld.push(slotTyAt(s, d))
  narIpNew.push(ty)
  slotTySetAt(s, d, ty)
  0
}

// Sets path slot `i`'s invalidation in place, journalled for `narHeadTy`.
export function narSetInv(i: i32, by: i32) {
  narIpScope.push(false)
  narIpAt.push(i)
  narIpSlot.push(-1)
  narIpOld.push(npInvBy[i])
  narIpNew.push(by)
  npInvBy[i] = by
  0
}

// Applies journal row `j`'s old value (`undo`) or its new one, when it touches a scope or slot
// that existed at `f`'s head.
export function narIpApply(f: IfChk, j: i32, undo: boolean) {
  let v = narIpNew[j]
  if undo { v = narIpOld[j] }
  const at = narIpAt[j]
  if narIpScope[j] {
    if at < f.headDepth && v >= 0 { slotTySetAt(narIpSlot[j], at, v) }
  } else if at < f.headNp {
    npInvBy[at] = v
  }
  0
}

// Replace the rows of each place the `if` whose rows start at `mark` joined by its summary row,
// at the `if`'s own statement depth. An enclosing join then folds one row per place per `if`,
// which keeps the ledger linear in the function however deep the nesting.
export function narCompactIf(
  mark: i32,
  sumPlaces: i32[],
  sumTys: i32[],
  sumPrev: i32[],
  sumRet: i32[],
) {
  if sumPlaces.length == 0 { return 0 }
  const joined: {[i32]: boolean} = Map()
  let s = 0
  while s < sumPlaces.length {
    joined[sumPlaces[s]] = true
    s = s + 1
  }
  let w = mark
  let i = mark
  while i < narClobPlace.length {
    const nm = narClobPlace[i]
    if !(joined[nm] ?? false) {
      narClobPlace[w] = nm
      narClobTys[w] = narClobTys[i]
      narClobPrev[w] = narClobPrev[i]
      narClobDepths[w] = narClobDepths[i]
      narClobRetired[w] = narClobRetired[i]
      w = w + 1
    }
    i = i + 1
  }
  while narClobPlace.length > w {
    narClobPlace.pop()
    narClobTys.pop()
    narClobPrev.pop()
    narClobDepths.pop()
    narClobRetired.pop()
  }
  s = 0
  while s < sumPlaces.length {
    narClobPlace.push(sumPlaces[s])
    narClobTys.push(sumTys[s])
    narClobPrev.push(sumPrev[s])
    narClobDepths.push(T.frames.length)
    narClobRetired.push(sumRet[s])
    s = s + 1
  }
  0
}

// The bank row of the live guard or post-guard narrowing of slot `s`, or -1: the narrowings under
// which a write the declaration admits is accepted and re-narrows the binding.
export function narGuardSlot(s: i32) {
  const d = declDepthOf(s)
  if d < 0 { return -1 }
  const rows = narBankRowsOf(s)
  let r = rows.length - 1
  while r >= 0 {
    const i = rows[r]
    if asgDeclDepths[i] == d {
      const k = asgDeclKinds[i]
      if k == NAR_KIND_GUARD || k == NAR_KIND_POSTGUARD { return i }
    }
    r = r - 1
  }
  -1
}

// The type a write to the guard-narrowed slot `s` is checked against: the widest layer of its
// narrowing chain in the current function. A loop barrier caps it at the type the binding had
// when the loop began, since the reads before the write run again; -1 when every layer is outside.
export function narWriteStorage(s: i32): i32 {
  if s == -1 { return -1 }
  const base = crFnBase()
  let bar = 0
  if reScopeBases.length > 0 { bar = reScopeBases[reScopeBases.length - 1] }
  let widest = -1
  let e = slotLayerTop(s)
  while e >= 0 {
    const d = slotLayerDepth(e)
    if d < base { return widest }
    const row = crFirstBank(s, d)
    if row < 0 { return widest }
    if d < bar {
      if widest < 0 { return -1 }
      return slotLayerTy(e)
    }
    widest = asgDeclTys[row]
    e = slotLayerPrev(e)
  }
  widest
}

// The overlay slot of the innermost narrowing of `key`, or -1 when no live scope narrowed it. The
// single walk the three overlay questions share — the type, the invalidator, and how the slot
// sits relative to a loop barrier.
export function narrowedPathIx(p: i32) { npSlotOf(p, 0) }

// `narrowedPathTy` without the capture question, for reading a prefix's type while a call's
// write summary is being matched — which that question itself asks.
export function narrowedPathTyRaw(p: i32) {
  const i = narrowedPathIx(p)
  if i < 0 { return -1 }
  if npInvBy[i] >= 0 { return -1 }
  npTys[i]
}

// Re-execution barriers: the scope depth and overlay height at entry to each open loop body and
// nested-function body, innermost last. A narrowing retires at a falsifying write because the
// statements after the write run with it gone — a statement-order fact a loop body breaks, since
// the reads textually before the write run again after it. Below the mark a write keeps its reject.
export let reScopeBases: i32[] = []

export let reNpBases: i32[] = []

// Per barrier, where `crLoopRdSlots` stood when its loop began: the path reads the loop may re-run.
export let reRdMarks: i32[] = []

// The operand of the `is` test being checked, whose read is a test rather than a use.
export let crIsObj = -1
export function crIsObjSet(v: i32) { crIsObj = v }

export let crLoopRdSlots: i32[] = []

export let crLoopRdNodes: i32[] = []

// Enter or leave a re-execution barrier. Call before the body's narrowing scope is pushed, so a
// narrowing the loop's own condition contributes counts as inside.
// `rdMark` is where the loop's re-run reads begin: before a `while` condition, which runs again.
export function pushReBarrier(rdMark: i32) {
  reScopeBases.push(T.frames.length)
  reNpBases.push(npKeys.length)
  reRdMarks.push(rdMark)
  0
}

export function popReBarrier() {
  if reScopeBases.length > 0 {
    reScopeBases.pop()
    reNpBases.pop()
    // An inner loop's reads run again with every iteration of the loops around it, so they
    // stay logged until the function's outermost loop closes.
    const m = reRdMarks[reRdMarks.length - 1]
    reRdMarks.pop()
    if reRdMarks.length <= crFnReBase() {
      while crLoopRdSlots.length > m {
        crLoopRdSlots.pop()
        crLoopRdNodes.pop()
      }
    }
  }
  0
}

// Whether a bare-name narrowing shadowing at scope depth `depth` sits inside the innermost open
// barrier — i.e. is re-established every time the write runs.
function narInsideBarrier(depth: i32) {
  if reScopeBases.length == 0 { return true }
  depth >= reScopeBases[reScopeBases.length - 1]
}

// The same question for a property-path narrowing, by overlay slot.
export function npInsideBarrier(npIx: i32) {
  if reNpBases.length == 0 { return true }
  npIx >= reNpBases[reNpBases.length - 1]
}

// Whether a live narrowing does overlay the write target but sits below the innermost re-execution
// barrier — the one reason `writeStorageTy` answers -1 for a place a narrowing covers. Asked only
// to choose the diagnostic: the write is refused either way, but "cannot assign null to i32" says
// nothing about why the same write one block out is fine.
export function writeBarredByLoop(ix: i32) {
  const n = nodeAt(ix)
  match n {
    Ident => {
      const s = identSlotOf(ix, n.identName)
      if narGuardSlot(s) < 0 { return false }
      if !narInsideBarrier(declDepthOf(s)) { return true }
      // A layer inside the loop over one outside it: the loop's entry type is what refused.
      const w = narWriteStorage(s)
      const depths: i32[] = []
      return w >= 0 && w != crChainWidest(s, depths)
    }
    Member | Index => {
      const slot = narrowedPathIx(placeAt(ix))
      if slot < 0 || npInvBy[slot] >= 0 { return false }
      return !npInsideBarrier(slot)
    }
    // no other node is a narrowed place
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// Per `key|hole`, the type `T` whose `is T` else arm left the hole as the path's fact.
export let holeElseTested: {[string]: i32} = Map()
export function holeElseTestedSetAt(k: string, v: i32) { holeElseTested[k] = v }

// Whether a read of the path in overlay slot `slot`, whose narrowing a call ends, reads the
// declared type: the emitter retires it before the loop, or after a statement that has closed.
function npSettledAt(slot: i32): boolean {
  const st = npSettle[slot]
  if st == -1 { return true }
  if st < 0 { return false }
  !i32ListHas(crStmtIxs, st)
}

// The overlay slot a read of place `p` resolves through when a call has ended its narrowing and the
// read may proceed at the declared type, or -1 when the read is refused or not so ended.
function pathCallSettledSlot(p: i32): i32 {
  const i = narrowedPathIx(p)
  if i < 0 { return -1 }
  const by = npInvBy[i]
  if by < 0 || pathRetiredByAssign(by) { return -1 }
  if npSettledAt(i) { return i }
  -1
}

// Whether the read at `ix` of place `p`, whose narrowing the node `by` ended, reads the declared
// type. A read a call's retirement let through is remembered for the misuse note.
export function pathReadsDeclared(p: i32, by: i32, ix: i32): boolean {
  if pathRetiredByAssign(by) { return true }
  // A hole's field reads its own hole after the narrowing ends, which the pin then re-asks (D3197).
  const hs = narrowedPathIx(p)
  if hs >= 0 && tyIsHole(npTys[hs]) { return true }
  const slot = pathCallSettledSlot(p)
  if slot < 0 { return false }
  const key = placeText(p)
  let r = crRetNames.length - 1
  while r >= 0 && crStmtIxs.length > 0 {
    if crRetNames[r] == key && crRetCalls[r] == by {
      crRdRet.push(r)
      crRdIx.push(ix)
      return true
    }
    r = r - 1
  }
  true
}

// A path read under a narrowing made outside an enclosing loop, logged while inside the loop so a
// call later in the loop that may write the path can find the reads it would falsify on the next
// iteration.
export function crNoteLoopRead(p: i32, ix: i32) {
  if reScopeBases.length <= crFnReBase() { return 0 }
  if ix == crIsObj { return 0 }
  const slot = narrowedPathIx(p)
  if slot < 0 { return 0 }
  if slot >= reNpBases[reNpBases.length - 1] { return 0 }
  crLoopRdSlots.push(slot)
  crLoopRdNodes.push(ix)
  0
}

// A read of a bare name whose captured narrowing `crCaptureLosesNarrowing` dropped (D2529).
export function crNoteLostName(name: string, ix: i32) {
  if !crCapLossAny || crFnIxs.length == 0 { return 0 }
  const fnIx = crFnIxs[crFnIxs.length - 1]
  const lost = crCapLossBank[fnIx] ?? crNoNames
  if !strListHas(lost, name) { return 0 }
  // Only a captured binding: a local of the same name is the function's own.
  const ls = identSlotOf(ix, name)
  const bd = crBindDepthOfSlot(ls)
  if bd >= crFnBase() && !crWidenedAt(ls, bd) { return 0 }
  crLostPush(name, ix, fnIx, crFnBases.length, true)
  0
}

// Enter a function body, before its scope is pushed. A registered top-level function is its own
// root; a nested function or a lambda reads the closures of the root it sits in.
export function crFnEnter(fnIx: i32) {
  weUnresDrop()
  crFnIxs.push(fnIx)
  crFnBases.push(T.frames.length)
  crFnNpBases.push(npKeys.length)
  crFnReBases.push(reScopeBases.length)
  let root = crProgRoot
  if crFnRoots.length > 0 { root = crFnRoots[crFnRoots.length - 1] }
  const fd = nodeAt(fnIx)
  if fd is FuncDecl {
    if fd.fnName != "" && (fnDeclIx[fd.fnName] ?? -1) == fnIx { root = fnIx }
  }
  crFnRoots.push(root)
  0
}

export function crFnLeave() {
  weUnresDrop()
  if crFnBases.length > 0 {
    crFnIxs.pop()
    crFnBases.pop()
    crFnRoots.pop()
    crFnNpBases.pop()
    crFnReBases.pop()
  }
  while (
    crAliasNestDepths.length > 0
    && crAliasNestDepths[crAliasNestDepths.length - 1] > crFnBases.length
  ) {
    const ns = crAliasNestSlots[crAliasNestSlots.length - 1]
    if ns >= 0 && ns < npInvBy.length {
      const nb = npInvBy[ns]
      if (crAliasWr[nb] ?? false) || (crNestCallRet[nb] ?? false) {
        narSetInv(ns, -1)
      }
    }
    crAliasNestSlots.pop()
    crAliasNestDepths.pop()
  }
  while (
    crCapRecDepths.length > 0
    && crCapRecDepths[crCapRecDepths.length - 1] > crFnBases.length
  ) {
    const ph = crCapRecHandles[crCapRecHandles.length - 1]
    crCapRecCount[ph] = (crCapRecCount[ph] ?? 1) - 1
    crCapRecDepths.pop()
    crCapRecHandles.pop()
    crCapRecNames.pop()
    crCapRecSlots.pop()
    crCapRecTys.pop()
    crCapRecFns.pop()
  }
  crLostPopTo(crFnBases.length)
  0
}

export function crFnNpBase(): i32 {
  if crFnNpBases.length == 0 { return 0 }
  crFnNpBases[crFnNpBases.length - 1]
}

export function crFnReBase(): i32 {
  if crFnReBases.length == 0 { return 0 }
  crFnReBases[crFnReBases.length - 1]
}

// Whether a closure of the current root writes `name`, and whether one that can reach such a
// writer escaped: 0 / 1 / 2 as `crInfoMemo` documents. A reacher is a function that writes the
// name or mentions a reacher's name; it escapes when it is unbound, or its name is used other
// than as a callee or an assignment target, inside another reacher or not.
function crInfoOf(s: i32): i32 {
  const root = crCurRoot()
  if root == crProgRoot { crAskProg("w", slotNameOf(s)) }
  const wk = crSlotKey(s)
  // A binding no nested function writes has no reacher: the cheap answer.
  if root == crwRoot && !crwWritten(wk) { return 0 }
  let memo = crInfoMemo[root]
  if memo == null {
    const fresh: {[i32]: i32} = Map()
    crInfoMemo[root] = fresh
    crHandleMemo[root] = Map()
    memo = fresh
  }
  const m = memo ?? crNoInfo
  const hit = m[wk]
  if hit is i32 { return hit }
  crwEnsure(root)
  let info = 0
  const handles: i32[] = []
  const reach: boolean[] = []
  let any = false
  let j = 0
  if !crwWritten(wk) { j = crwFns.length }
  while j < crwFns.length {
    const w = crwWrites(j, wk)
    reach.push(w)
    if w {
      any = true
      crHandleAdd(handles, crwFnHandle[j])
    }
    j = j + 1
  }
  if any {
    info = 1
    let changed = true
    while changed {
      changed = false
      let q = 0
      while q < crwFns.length {
        if !reach[q] && crwMentionsAny(q, handles) {
          reach[q] = true
          changed = true
          crHandleAdd(handles, crwFnHandle[q])
        }
        q = q + 1
      }
    }
    let e = 0
    while e < crwFns.length && info == 1 {
      if reach[e] && crwFnHandle[e] == -1 { info = 2 }
      e = e + 1
    }
    let u = 0
    while u < crwUseKeys.length && info == 1 {
      if crwUseKinds[u] == 0 && crwKeysMeet(handles, crwUseKeys[u]) { info = 2 }
      u = u + 1
    }
  }
  m[wk] = info
  const hm = crHandleMemo[root]
  if hm != null { hm[wk] = handles }
  info
}

const crNoInfo: {[i32]: i32} = Map()

// Add binding key `h` to `hs` unless it is there or is no key.
function crHandleAdd(hs: i32[], h: i32) {
  if h != -1 && !i32ListHas(hs, h) { hs.push(h) }
  0
}

// The keys of the bindings holding a function that can reach a writer of slot `s`, under the
// current root (`crInfoOf`).
function crHandlesOf(s: i32): i32[] {
  const hm = crHandleMemo[crCurRoot()]
  if hm == null { return crNoKeys }
  (hm ?? crNoHandles)[crSlotKey(s)] ?? crNoKeys
}

const crNoKeys: i32[] = []
const crNoHandles: {[i32]: i32[]} = Map()

// The bare-name half of `callMayWrite`: the call names a function that can reach a writer of
// slot `s`, or a writer escaped and the call is not one that provably runs none of it. An operator
// that dispatched to a declaration is a call naming no function, so only an escape reaches.
export function crCallReaches(callIx: i32, s: i32): boolean {
  if crCallReachesInRoot(callIx, s) { return true }
  crGlobalReaches(callIx, s)
}

// A module binding narrowed inside a function can be written by any function of the program,
// so the reachability rule is asked again with the whole module as the root (D2401).
function crGlobalReaches(callIx: i32, s: i32): boolean {
  if !crNameIsGlobal(s) { return false }
  crFnRoots.push(crProgRoot)
  const r = crCallReachesInRoot(callIx, s)
  crFnRoots.pop()
  r
}

// Whether slot `s`, under its narrowing layers, is declared outside every function body being
// checked — a module binding, while the root is a function.
function crNameIsGlobal(s: i32): boolean {
  if crFnBases.length == 0 || crCurRoot() == crProgRoot { return false }
  if s == -1 { return false }
  // A narrowing layer, or the declared-type layer `crDeclareWidened` binds, is not a binding.
  let e = slotLayerTop(s)
  while e >= 0 {
    const d = slotLayerDepth(e)
    if d < crFnBases[0] { return true }
    if !crIsNarrowLayer(s, d) { return false }
    e = slotLayerPrev(e)
  }
  false
}

// Whether any function may write slot `s`: a closure of the root, or any function of the module
// for a module binding (D2401). A path's writers are anywhere, so its callers ask per call.
export function crMayBeWritten(s: i32): boolean {
  if declIsConst(s) { return false }
  if crInfoOf(s) > 0 { return true }
  if !crNameIsGlobal(s) { return false }
  crFnRoots.push(crProgRoot)
  const info = crInfoOf(s)
  crFnRoots.pop()
  info > 0
}

function crCallReachesInRoot(callIx: i32, s: i32): boolean {
  if callIx < 0 || callIx >= P.nodes.length { return false }
  const cn = nodeAt(callIx)
  if cn is Call { return crCallNodeReaches(cn, callIx, s) }
  const info = crInfoOf(s)
  if info == 0 { return false }
  if info == 2 { return true }
  crOpIsReacher(crOpOf(callIx), s)
}

// Is a declaration of operator `op` (`+`, or a receiver-keyed `+@P`) a reacher of slot `s`?
// Asked of every declaration of `op`, since which one dispatched is the receiver's business.
function crOpIsReacher(op: string, s: i32): boolean {
  if op == "" { return true }
  const hs = crHandlesOf(s)
  let i = 0
  while i < hs.length {
    const nm = crwKeyText(hs[i])
    if nm == op || opDeclOpOf(nm) == op { return true }
    i = i + 1
  }
  false
}

// `crCallReaches` for a `Call`: its callee naming a reacher's binding (bare or as a method), a
// function written in place and called at once, or an escape the call does not rule out.
function crCallNodeReaches(cn: Call, callIx: i32, s: i32): boolean {
  const info = crInfoOf(s)
  if info == 0 { return false }
  if crwKeysMeet(crHandlesOf(s), crCalleeKey(cn, callIx)) { return true }
  if cn.callFn >= 0 && nodeAt(cn.callFn) is FuncDecl { return true }
  info == 2 && !crCallBenign(cn, callIx, slotNameOf(s))
}

// The key of the binding the callee of call `callIx` names: a bare name's (`crwUseKeyOf`), or for
// a method call the declaration its spelling recorded, else the key standing for every binding of
// the method's name. -1 for a callee with no written name (`calleeNameOf`).
function crCalleeKey(cn: Call, callIx: i32): i32 {
  const nm = calleeNameOf(callIx)
  if nm == "?" || cn.callFn < 0 { return -1 }
  if nodeAt(cn.callFn) is Ident { return crwUseKeyOf(cn.callFn) }
  const d = memberDeclOf(cn.callFn)
  if d >= 0 { return cwKeyOfDecl(d) }
  const sid = sidLookup(nm)
  if sid < 0 { return -1 }
  -2 - sid
}

// The type `name` reads at once every narrowing layer of the current function is gone, or -1
// when the innermost binding is not a narrowing. Fills `depths` with the layers to rewrite.
export function crChainWidest(s: i32, depths: i32[]): i32 {
  if s == -1 { return -1 }
  const base = crFnBase()
  let widest = -1
  let e = slotLayerTop(s)
  while e >= 0 {
    const d = slotLayerDepth(e)
    if d < base { return widest }
    const row = crFirstBank(s, d)
    if row < 0 { return widest }
    widest = asgDeclTys[row]
    depths.push(d)
    e = slotLayerPrev(e)
  }
  widest
}

// End the narrowing of slot `s` because of the call at `callIx`, in place, as a falsifying write
// does. `atLoop` false refuses a read later in the statement being checked; true retires it
// before a loop that has not begun.
export function crRetire(s: i32, callIx: i32, atLoop: boolean) {
  crRetireAt(s, callIx, atLoop, !atLoop)
}

// `crRetire`, before a loop when `atLoop`, and a later read in the statement being checked
// refused only when `pend`.
export function crRetireAt(
  s: i32,
  callIx: i32,
  atLoop: boolean,
  pend: boolean,
) {
  const depths: i32[] = []
  const wide = crChainWidest(s, depths)
  if wide < 0 { return 0 }
  const cur = declTyOf(s)
  const name = slotNameOf(s)
  if cur < 0 { return 0 }
  const pl = placeIntern(s, name, false)
  if cur == wide {
    // Already wide here, typically because a sibling arm retired it in place; the path this
    // call is on still ends wide, and the join has to see that (D3285).
    narClobPlace.push(pl)
    narClobTys.push(wide)
    narClobPrev.push(wide)
    narClobDepths.push(T.frames.length)
    narClobRetired.push(0)
    return 0
  }
  let k = 0
  while k < depths.length {
    narSetScope(depths[k], s, wide)
    k = k + 1
  }
  // The arm join and the post-guard residual read this row exactly as a retiring write's. Its
  // entry type is the widest, not `cur`: a call in a condition retires a narrowing that only
  // part of the condition held, which is no type the `if` itself begins at.
  narClobPlace.push(pl)
  narClobTys.push(wide)
  narClobPrev.push(wide)
  narClobDepths.push(T.frames.length)
  narClobRetired.push(1)
  crRetNames.push(name)
  crRetCalls.push(callIx)
  crRetNarTys.push(cur)
  crRetWideTys.push(wide)
  crRetRoots.push(crCurRoot())
  crRetLoops.push(atLoop)
  if !atLoop && pend {
    crPendNames.push(name)
    crPendCalls.push(callIx)
    crPendNarTys.push(cur)
    crPendDepths.push(crStmtIxs.length)
  }
  0
}

// Overlay slots holding a field of a bare name narrowed to a record, with that name: the
// narrowing holds only while the field does, so a write that ends the path ends the name.
export let nfSlots: i32[] = []
export function nfSlotsPop() {
  nfSlots.pop()
  0
}
export function nfSlotsPush(v: i32) { nfSlots.push(v) }

export let nfNames: string[] = []
export function nfNamesPop(): string | null { nfNames.pop() }
export function nfNamesPush(v: string) { nfNames.push(v) }

// Whether overlay slot `slot` is a field entry of a narrowed name: the place stores what the
// name's declared type does, which its narrowed type does not say.
export function narFitSlot(slot: i32): boolean { narFitNameOf(slot) != "" }

// Whether the overlay key `k` is a companion entry of the bare name `name`: a field or an element.
function narFitKeyOf(k: string, name: string): boolean {
  keyHasPrefix(k, name + ".") || keyHasPrefix(k, name + LIST_EVERY_STEP)
}

// The bare name whose field entry overlay slot `slot` is, or "" when it is a written path.
export function narFitNameOf(slot: i32): string {
  let j = nfSlots.length - 1
  while j >= 0 {
    if (
      nfSlots[j] == slot
      && slot < npKeys.length
      && narFitKeyOf(npKeys[slot], nfNames[j])
    ) {
      return nfNames[j]
    }
    j = j - 1
  }
  ""
}

// End the bare name a field entry in overlay slot `slot` stands for, as the write or call at
// `atIx` ended the entry: before the loop `loopIx` when it is not -1, else after the open statement.
export function narFitRetire(slot: i32, atIx: i32, loopIx: i32) {
  let j = nfSlots.length - 1
  while j >= 0 {
    if (
      nfSlots[j] == slot
      && slot < npKeys.length
      && narFitKeyOf(npKeys[slot], nfNames[j])
    ) {
      if loopIx >= 0 {
        crRetire(placeDecl(npPlace[slot]), atIx, true)
      } else if (
        crStmtIxs.length > 0
        && crStmtFns[crStmtFns.length - 1] == crFnBases.length
      ) {
        crRetire(placeDecl(npPlace[slot]), atIx, false)
      }
    }
    j = j - 1
  }
  0
}

// Whether slot `s`'s name is the target of an assignment anywhere in the current root, or anywhere
// in the program for a module binding.
export function crNameAssigned(s: i32): boolean {
  if crNameAssignedInRoot(s) { return true }
  if !crNameIsGlobal(s) { return false }
  crFnRoots.push(crProgRoot)
  const r = crNameAssignedInRoot(s)
  crFnRoots.pop()
  r
}

// Whether the subtree at `ix` assigns the place keyed `key` or a place it lies below.
export function crSubtreeAssigns(ix: i32, key: string): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if n is BinExpr {
    if n.binOp == "=" {
      const tk = placeKeyOf(n.binLeft)
      if tk == "" && isPathKey(key) { return true }
      if tk != "" {
        if (
          key == tk
          || keyHasPrefix(key, tk + ".")
          || keyHasPrefix(key, tk + "[")
        ) {
          return true
        }
      }
    }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      if crSubtreeAssigns(kids[k], key) { return true }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  false
}

// Did an assignment, rather than a call, retire this narrowing? Both causes write the same
// `npInvBy` column and need different answers, so the question has one home. A direct `w.f = e` is
// a statement the emit walk passes over exactly as it passes `f = e`, and the emit half retires
// it, so the call cause keeps the refusal and the assignment cause reads at the declared type.
export function pathRetiredByAssign(byIx: i32) {
  if byIx < 0 { return false }
  // An operator that dispatched to a declaration is a call, whatever node spells it (D2400), and
  // so is a write through an alias, which the emitter retires as it retires a call's (D2584).
  if crOpCall[byIx] ?? false { return false }
  if crAliasWr[byIx] ?? false { return false }
  !(nodeAt(byIx) is Call)
}

// Whether the path at `placeIx` is already held at `inner` by a live overlay: the else arm of a
// null test restates it as its own fact, so a then arm that retires the overlay in place does not
// leave the else arm reading at storage while the emitter's else push still narrows (D3318).
export function narPathHeldNonNull(placeIx: i32, inner: i32): boolean {
  const p = placeAt(placeIx)
  if !placeIsPath(p) { return false }
  narrowedPathTyRaw(p) == inner
}

// Whether a narrowing key is a path (`o.v`, `xs[0]`, `o.xs[1].v`) rather than a bare name — which
// is what decides overlay entry against scope shadow in `applyNarrows`. `[` counts: with only `.`
// tested, a fact keyed `xs[0]` installs as a bare-name scope shadow under the name `"xs[0]"`, a
// binding no reader looks up, since every reader of an index place asks the `npKeys` overlay.
export function isPathKey(s: string) {
  let i = 0
  while i < s.length {
    if s[i] == 46 {
      return true // '.'
    }
    if s[i] == 91 {
      return true // '['
    }
    i = i + 1
  }
  false
}

// The start char offset of a scope-owning node (the `{`/`for` token), or `-1`. Only the node kinds
// that open a lexical scope are handled — block bodies and the two `for` forms; another owner
// falls back to "no start", i.e. a full-file sentinel.
function scopeStartOff(owner: i32) {
  if owner < 0 || owner >= P.nodes.length { return -1 }
  const n = nodeAt(owner)
  match n {
    Block => {
      return n.pos
    }
    ForRange => {
      return n.pos
    }
    ForIn => {
      return n.pos
    }
    FuncDecl => {
      return n.pos
    }
    // no other node opens a lexical scope
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// The token index whose start offset is exactly `off`, or `-1`. A scope owner's `pos` is a token
// boundary (`{`/`for`), so this recovers its line and column.
function tokIxAtStart(off: i32) {
  if off < 0 { return -1 }
  // The lexer appends tokens in scan order, so `start` offsets are strictly
  // increasing — binary search (this runs per scope push in LSP mode, and a
  // linear scan over all tokens made scope collection quadratic).
  let lo = 0
  let hi = P.toks.length - 1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const s = P.toks[mid].start
    if s == off { return mid }
    if s < off { lo = mid + 1 } else { hi = mid - 1 }
  }
  -1
}

// Push the open-scope span for `owner`, the scope-owning node, in lockstep with the decl-scope
// map. The end is the owner's anchor (last) token — the closing `}` for a block — and the start
// its first token. `owner < 0`, a narrowing-only scope that never holds a binding, pushes a
// full-file sentinel.
function pushScopeSpan(owner: i32) {
  let startL = 1
  let startC = 0
  let endL = SCOPE_EOF
  let endC = 0
  if owner >= 0 {
    const so = scopeStartOff(owner)
    const stk = tokIxAtStart(so)
    if stk >= 0 {
      const st = P.toks[stk]
      startL = st.line
      startC = st.col
    }
    if owner < nodeToks.length {
      const etk = nodeToks[owner]
      if etk >= 0 && etk < P.toks.length {
        const et = P.toks[etk]
        endL = et.line
        endC = et.col + et.text.length
      }
    }
  }
  symSpanPush(startL, startC, endL, endC)
}

// Enter a new lexical scope (push a fresh frame). Marks the current
// narrowed-path overlay depth so `popScope` unwinds entries pushed inside.
// `owner` is the scope-owning node (its source span bounds visibility for the
// LSP scope query); `-1` for a narrowing-only overlay that holds no binding.
export function pushScope(owner: i32) {
  scopeFramePush()
  npFrames.push(npKeys.length)
  narBankPushFrame()
  symScopePush()
  if symEnabled != 0 { pushScopeSpan(owner) }
  0
}

// Does the return value `ix`, of natural type `t`, have the annotated type only by something the
// un-annotated spelling builds differently: an open collection hole the annotation pins, a read
// through a narrowing, a call of the function itself, or a call through a binding the body
// reassigns (D3800)?
export function retSiteTypedByAnnot(ix: i32, t: i32): boolean {
  if t >= 0 && tyReachesEmptyHole(t, 8) { return true }
  const p = cwPeel(ix)
  if p < 0 || p >= P.nodes.length || curFnDeclIx < 0 { return false }
  if narDeclaredTy(identSlotAt(p), -1) >= 0 { return true }
  const f = nodeAt(curFnDeclIx)
  const callee = callIdentName(p)
  if callee == "" || !(f is FuncDecl) { return false }
  if callee == f.fnName { return true }
  const pn = nodeAt(p)
  if pn is Call {
    return identDepthOf(pn.callFn, callee) >= 0
      && crSubtreeAssigns(f.fnBody, callee)
  }
  false
}

// The name a bare identifier at `ix` reads, or "".
export function identNameAt(ix: i32): string {
  const n = nodeAt(ix)
  if n is Ident { return n.identName }
  ""
}

// The slot a bare identifier at `ix` reads, or -1.
function identSlotAt(ix: i32): i32 {
  const n = nodeAt(ix)
  if n is Ident { return identSlotOf(ix, n.identName) }
  -1
}

// The name a call at `ix` calls when its callee is a bare identifier, or "".
function callIdentName(ix: i32): string {
  const n = nodeAt(ix)
  if n is Call { return identNameAt(n.callFn) }
  ""
}

// The `memCstr.prop` of a member read off a derived hole (`hdReadNullAsked`), before the
// member's name. The pin asks only whether the receiver admits `null`; any other floor stays
// unasked, since an `is` test on such a hole does not narrow it in the body (D3216).
export const MC_NULL_READ_MARK = "?."

// The `memCstr.prop` of an optional-chain read `h?.f` off a hole, before `f`: the pin asks that its
// non-null face carries the field, as the direct `?.` does (D3215).
export const MC_OPT_READ_MARK = "?opt:"

// Records a member read off a derived hole a `null` could reach, so the pin refuses `.v` on
// `H | null` as the direct spelling does (D3287). A null test narrows the read to the hole's
// non-null face (`HD_GNOT`), which is not recorded, so a guarded read still runs.
export function noteNullReadCstr(recv: i32, prop: string, ix: i32, place: i32) {
  if inferQuiet || !killedNarrowingSure(place) { return 0 }
  if hdReadNullAsked(hdRowOf(recv)) {
    noteMemCstr(recv, MC_NULL_READ_MARK + prop, ix, false)
  }
  0
}

// A hole's field, element or result passed to a parameter whose body reads its members: the
// pin asks the argument about `null`, as `holeDemandOk` asks a concrete one (D3300).
export function noteHoleArgNullRead(name: string, at: i32, ix: i32) {
  const shape = holeShapeOf(name)
  if shape < 0 { return 0 }
  const st = tyAt(shape)
  if st is TyObj {
    if st.objFieldNames.length > 0 {
      noteNullReadCstr(at, st.objFieldNames[0], ix, ix)
    }
  }
  0
}

// The innermost slot this function pushed narrowing the place the node `place` reads, or -1.
function npFnSlotOf(place: i32): i32 {
  let base = crFnNpBase()
  if base < 0 { base = 0 }
  npSlotOf(placeAt(place), base)
}

// Whether the place at node `place` is not a narrowing this function ended by a verdict a pin
// could overturn. A place never narrowed, or narrowed and still live, answers true.
function killedNarrowingSure(place: i32): boolean {
  if place < 0 || place >= P.nodes.length { return true }
  const s = npFnSlotOf(place)
  if s < 0 || npInvBy[s] < 0 { return true }
  npKillSure[i32ToStr(npInvBy[s]) + "|" + npKeys[s]] ?? false
}

// Whether a write or a call ended the innermost narrowing of the place `place` in this
// function; false when none covers it.
export function narrowingEndedAt(place: i32): boolean {
  const s = npFnSlotOf(place)
  s >= 0 && npInvBy[s] >= 0
}

// Whether any narrowing of the place `place`, live or ended, is recorded in this function.
export function placeIsNarrowed(place: i32): boolean { npFnSlotOf(place) >= 0 }

// Whether the innermost narrowing of the place `place` in this function is the remainder of an
// `is` test on a hole (`holeElseTested`) that a write, a call `callKillSure` settles, or a write
// through an alias ended; false when none covers it.
export function holeRemainderEndedSure(place: i32): boolean {
  const s = npFnSlotOf(place)
  if s < 0 { return false }
  const key = npKeys[s]
  const by = npInvBy[s]
  if by < 0 { return false }
  if (holeElseTested[key + "|" + i32ToStr(npTys[s])] ?? -1) < 0 { return false }
  if crAliasWr[by] ?? false { return true }
  npKillSure[i32ToStr(by) + "|" + key] ?? false
}

// One `if` link's checker state, carried from its head (condition, narrowing, then arm) to its
// tail (else arm join, definite assignment, post-guard legs) across the links below it.
export type IfChk = {
  ifIx: i32,
  isElseArm: boolean,
  pgUpMark: i32,
  clobMark: i32,
  ipMark: i32,
  headDepth: i32,
  headNp: i32,
  ifTail: boolean,
  ifInRetArg: boolean,
  seedLogMark: i32,
  seedObsMark: i32,
  seedObsLit: boolean,
  thenExits: boolean,
  tnPlaces: i32[],
  tnTys: i32[],
  tnEnt: i32[],
  enPlaces: i32[],
  enTys: i32[],
  enEnt: i32[],
  altRows: i32[],
  thenOwnDepth: i32,
  thenLo: i32,
  thenHi: i32,
  thenTy: i32,
  thenUndoLo: i32, // the in-place journal rows lifting the then arm's writes, or -1
  thenUndoHi: i32,
  daFork: i32,
  daThenAdds: i32[],
  daThenRems: i32[],
  daHasElse: boolean,
  elseOwnDepth: i32,
  elseLo: i32,
  exits: boolean, // `stmtAlwaysExits` of this link, set by its tail
}

export function narPathsReset() {
  placeIdsReset()
  holeElseTested = Map()
  npKeys = []
  npPlace = []
  npTys = []
  npInvBy = []
  narIpScope = []
