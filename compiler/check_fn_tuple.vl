// `check_fn_tuple.vl` — the call-tuple set of an un-annotated list binding whose elements are a
// set of functions: the closed function types the calls through its elements are made at. When
// they agree on one, that type's list is written as the binding's annotation and checked by the
// literal phase like any adopted type, so the elements are built at it. A binding whose members
// are called at two types anywhere, or in the body of an instance, keeps its open element type and
// is listed in `fnTupMany`.

import {
  ArrayLit,
  Call,
  ForIn,
  FuncDecl,
  Ident,
  Index,
  LetDecl,
  P,
  Param,
  Spread,
  nodeAt,
  tsListOf,
} from "./ast"
import {
  fnTagCallFtHas,
  fnTagCallFtOf,
  fnTagCallSetOf,
  fnTagCalls,
  fnTagMembers,
  fnTagSetOfTy,
} from "./check_elab_cap"
import { cstrOwnerStack, curFnDeclIx } from "./check_cursor"
import { fnDeclParent } from "./check_decl_scan"
import { nodeTyIxOf } from "./check_node_tys"
import { pinRefusedAt } from "./check_pin_refusals"
import { parenPeelIx } from "./check_places"
import {
  recAdLoose,
  recAdNoAdopt,
  recAdPinDecl,
  recAdPinTs,
  recAdPinTy,
  recAdPinned,
} from "./check_rec_adopt_rows"
import {
  T,
  TyArray,
  mkArrayTy,
  tyAt,
  tySame,
  tyToStr,
  tyToTs,
} from "./check_types"
import { i32ListHas } from "./listutil"
import { identDeclOf } from "./symbols"

// The bindings the last solve found called at two or more types, or at an open one.
export let fnTupMany: i32[] = []
// The adopted bindings a re-check found reached by a call at another type than the one
// they are written at.
export let fnTupBlame: i32[] = []

// One solve's tuples, by a binding's declaration: the one closed function type its calls agree
// on, -1 when they do not, and absent when no call is made through it.
let fnTupDeclBy: {[i32]: i32} = Map()
// For the whole check: each call through a set as first checked, with the type it is made at and
// the binding it is placed on or -1; and each written binding's type. Types are kept as
// their text, since a re-check rebuilds the type table.
let fnTupSeenFt: {[i32]: string} = Map()
let fnTupSeenRoot: {[i32]: i32} = Map()
let fnTupSeen: i32[] = []
let fnTupWritDecl: i32[] = []
let fnTupWritFt: string[] = []
// The bindings a solve wrote and a settle then unwrote, which no later solve writes again.
let fnTupNoStamp: i32[] = []
// The calls through a set made in the body of a generic function or one with an un-annotated
// parameter, whose tuple each instance closes on its own.
let fnTupInInst: {[i32]: boolean} = Map()
// The bindings the last solve left open because a call through them is in such a body.
export let fnTupInst: i32[] = []

// Drop everything, before a program's first pass.
export function fnTupReset() {
  fnTupInInst = Map()
  fnTupSeenFt = Map()
  fnTupSeenRoot = Map()
  fnTupSeen = []
  fnTupWritDecl = []
  fnTupWritFt = []
  fnTupNoStamp = []
  0
}

// Frees each binding a settle unwrote from the refusal the undo leaves on it, so other adoptions
// treat it as they would had it never been written, and keeps it from being written again; true
// when it freed any.
export function fnTupUnmark(): boolean {
  let any = false
  for d in fnTupWritDecl {
    if (
      !(recAdPinned[d] ?? false)
      && recAdNoAdopt.has(d)
      && !i32ListHas(fnTupNoStamp, d)
    ) {
      recAdNoAdopt.delete(d)
      fnTupNoStamp.push(d)
      any = true
    }
  }
  any
}

// Notes that call `ix`, being checked through a set, is in an instance body when the function
// whose body is being checked, or one it is checked inside, is generic or has an un-annotated
// parameter.
export function fnTupSiteNote(ix: i32) {
  let f = curFnDeclIx
  let hops = 0
  while f >= 0 && hops < 64 {
    if fnTupOpenFn(f) {
      fnTupInInst[ix] = true
      return 0
    }
    f = fnDeclParent[f] ?? -1
    hops = hops + 1
  }
  if f == -2 { fnTupInInst[ix] = true }
  for o in cstrOwnerStack {
    if fnTupOpenFn(o) { fnTupInInst[ix] = true }
  }
  0
}

// Whether function `f` is generic or takes a parameter with no annotation.
function fnTupOpenFn(f: i32): boolean {
  if f < 0 || f >= P.nodes.length { return false }
  const fd = nodeAt(f)
  if !(fd is FuncDecl) { return false }
  if fd.fnTyParams.length > 0 { return true }
  for p in fd.fnParams {
    if p >= 0 && p < P.nodes.length {
      const pn = nodeAt(p)
      if pn is Param && pn.parType < 0 { return true }
    }
  }
  false
}

// Writes the one call type of each candidate binding as its pending annotation, read by the
// literal phase with the record adoptions, and blames an adopted binding that a call first made
// through its set at another type now reaches at the written one.
export function fnTupSolve() {
  fnTupMany = []
  fnTupInst = []
  fnTupBlame = []
  fnTupDeclBy = Map()
  const byMember: {[i32]: i32} = Map()
  const decls: i32[] = []
  for ix in fnTagCalls() {
    const s = fnTagCallSetOf(ix)
    if s >= 0 && fnTagCallFtHas(ix) {
      const ft = fnTagCallFtOf(ix)
      const d = fnTupRoot(ix)
      const ms = if d >= 0 { fnTupLitMembers(d) } else { fnTagMembers(s) }
      if !fnTupSeenFt.has(ix) {
        fnTupSeen.push(ix)
        fnTupSeenFt[ix] = if ft < 0 { "" } else { tyToStr(ft) }
        fnTupSeenRoot[ix] = d
      }
      if d >= 0 && (fnTupInInst[ix] ?? false) {
        fnTupAddMembers(byMember, ms, -1)
        if !i32ListHas(fnTupInst, d) { fnTupInst.push(d) }
      } else if d >= 0 {
        fnTupAdd(fnTupDeclBy, d, ft)
        fnTupAddMembers(byMember, ms, ft)
        if !i32ListHas(decls, d) { decls.push(d) }
      } else {
        fnTupAddMembers(byMember, ms, ft)
      }
    }
  }
  fnTupVerify()
  let i = 0
  while i < decls.length {
    const d = decls[i]
    const own = fnTupDeclBy[d] ?? -1
    const ft = if own >= 0 && !fnTupMembersAt(byMember, fnTupLitMembers(d), own) { -1 } else { own }
    if ft < 0 {
      fnTupMany.push(d)
    } else if (
      !i32ListHas(recAdPinDecl, d)
      && !(recAdPinned[d] ?? false)
      && !recAdNoAdopt.has(d)
      && !pinRefusedAt("recAd", d)
      && !i32ListHas(fnTupNoStamp, d)
    ) {
      recAdPinDecl.push(d)
      recAdPinTy.push(tyToStr(mkArrayTy(ft)))
      recAdPinTs.push(tsListOf(tyToTs(ft)))
      fnTupWritDecl.push(d)
      fnTupWritFt.push(tyToStr(ft))
    }
    i = i + 1
  }
  if fnTupBlame.length > 0 { recAdLoose = recAdLoose + 1 }
  0
}

// A call first made through a set that this pass checks through a closed type instead reaches
// its callee at a written binding's type. When that type is not the type the call first checked
// at, the binding written at it is blamed, or every one it could have come from when no written
// type matches. A binding is blamed only by a call placed on it or by one placed on none.
function fnTupVerify() {
  for ix in fnTupSeen {
    const was = fnTupSeenFt[ix] ?? ""
    const now = fnTupCalleeTy(ix)
    if !fnTagCallFtHas(ix) && now != was {
      const at = fnTupSeenRoot[ix] ?? -1
      const named = fnTupWritAt(now)
      let k = 0
      while k < fnTupWritDecl.length {
        const d = fnTupWritDecl[k]
        if (
          (at < 0 || at == d)
          && (recAdPinned[d] ?? false)
          && fnTupWritFt[k] != was
          && (!named || fnTupWritFt[k] == now)
          && !i32ListHas(fnTupBlame, d)
        ) {
          fnTupBlame.push(d)
        }
        k = k + 1
      }
    }
  }
  0
}

// Whether a binding stands written at the type spelled `t`.
function fnTupWritAt(t: string): boolean {
  let k = 0
  while k < fnTupWritDecl.length {
    if fnTupWritFt[k] == t && (recAdPinned[fnTupWritDecl[k]] ?? false) {
      return true
    }
    k = k + 1
  }
  false
}

// The spelling of the type call `ix`'s callee has in this pass, or "".
function fnTupCalleeTy(ix: i32): string {
  if ix < 0 || ix >= P.nodes.length { return "" }
  const c = nodeAt(ix)
  if !(c is Call) { return "" }
  const t = nodeTyIxOf(parenPeelIx(c.callFn))
  if t < 0 || t >= T.tys.length { return "" }
  tyToStr(t)
}

// Adds call type `ft` to the tuples of `key` in `by`.
function fnTupAdd(by: {[i32]: i32}, key: i32, ft: i32) {
  const was = by[key] ?? -2
  if was == -2 || was >= 0 && ft >= 0 && tySame(was, ft) {
    by[key] = ft
  } else {
    by[key] = -1
  }
  0
}

// Adds call type `ft` to the tuples of every function in `ms`.
function fnTupAddMembers(by: {[i32]: i32}, ms: i32[], ft: i32) {
  for m in ms { fnTupAdd(by, m, ft) }
  0
}

// Whether every function in `ms` is called at `ft` alone: a function also held by another binding
// or value is built once, at one type, only when all its calls agree.
function fnTupMembersAt(by: {[i32]: i32}, ms: i32[], ft: i32): boolean {
  for m in ms {
    const t = by[m] ?? -2
    if t != -2 && (t < 0 || !tySame(t, ft)) { return false }
  }
  true
}

// The set the elements of list type `t` hold, or -1.
function fnTupElemSet(t: i32): i32 {
  if t < 0 || t >= T.tys.length { return -1 }
  const la = tyAt(t)
  if !(la is TyArray) { return -1 }
  fnTagSetOfTy(la.aElem)
}

// The un-annotated list binding whose element call `ix` calls through: `xs[i](…)`, or `f(…)` for
// the variable of a `for f in xs`; -1 for any other callee.
function fnTupRoot(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const c = nodeAt(ix)
  if !(c is Call) { return -1 }
  const cx = parenPeelIx(c.callFn)
  if cx < 0 || cx >= P.nodes.length { return -1 }
  const cn = nodeAt(cx)
  let list = -1
  if cn is Index {
    list = parenPeelIx(cn.idxArr)
  } else if cn is Ident {
    const v = identDeclOf(cx)
    if v < 0 || v >= P.nodes.length { return -1 }
    const fi = nodeAt(v)
    if !(fi is ForIn) || fi.fiVar != cn.identName { return -1 }
    list = parenPeelIx(fi.fiIter)
  }
  if list < 0 || list >= P.nodes.length || !(nodeAt(list) is Ident) {
    return -1
  }
  const d = identDeclOf(list)
  if d < 0 || d >= P.nodes.length { return -1 }
  const ld = nodeAt(d)
  if !(ld is LetDecl) || ld.letType >= 0 || !fnTupFresh(ld.letInit) {
    return -1
  }
  // The binding holds the set the call goes through as its element, not a list of lists.
  if fnTupElemSet(nodeTyIxOf(list)) != fnTagCallSetOf(ix) { return -1 }
  d
}

// Whether initialiser `x` builds the list it is bound to: a list literal with no spread. A binding
// initialised from another value shares that value's list, and its calls count as the set's.
function fnTupFresh(x: i32): boolean {
  const e = parenPeelIx(x)
  if e < 0 || e >= P.nodes.length { return false }
  const a = nodeAt(e)
  if !(a is ArrayLit) { return false }
  for el in a.arrElems {
    if (
      el >= 0
      && el < P.nodes.length
      && (nodeAt(el) is Spread || fnTupLetRead(el))
    ) {
      return false
    }
  }
  true
}

// Whether element `el` reads a `let`, whose other values reach its element through writes the
// tuple does not see.
function fnTupLetRead(el: i32): boolean {
  const e = parenPeelIx(el)
  if e < 0 || e >= P.nodes.length || !(nodeAt(e) is Ident) { return false }
  const d = identDeclOf(e)
  if d < 0 || d >= P.nodes.length { return false }
  const ld = nodeAt(d)
  ld is LetDecl && ld.letKw == "let"
}

// The functions the list literal binding `d` is initialised with may hold: the members of each
// element's set, which the list's element type need not carry whole.
function fnTupLitMembers(d: i32): i32[] {
  const ms: i32[] = []
  if d < 0 || d >= P.nodes.length { return ms }
  const ld = nodeAt(d)
  if !(ld is LetDecl) { return ms }
  const e = parenPeelIx(ld.letInit)
  if e < 0 || e >= P.nodes.length { return ms }
  const a = nodeAt(e)
  if !(a is ArrayLit) { return ms }
  for el in a.arrElems {
    for m in fnTagMembers(fnTagSetOfTy(nodeTyIxOf(el))) {
      if !i32ListHas(ms, m) { ms.push(m) }
    }
  }
  ms
}
