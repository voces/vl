// A top-level function's captured narrowings (D2529): `crRootCaptureWiden` rebinds, at its
// declared type, each module binding the body reads whose narrowing a write elsewhere may end
// before the function runs. With it go the steps the capture-retire analysis shares: the current
// root and body base (`crCurRoot`, `crFnBase`), the writer key of a slot (`crSlotKey`), the
// narrowing bank lookups (`crFirstBank`, `crInnerRowBelow`, `crOuterWidest`), the widened-binding
// rows, the names a body reads, and whether a call or subtree runs user code (`crCallBenign`,
// `crSubtreeBenign`). The checker owns the steps that report; nothing here imports it.
import {
  BinExpr,
  Call,
  FuncDecl,
  Ident,
  P,
  Program,
  elseIfLink,
  i32ToStr,
  nodeAt,
  nodeSpineChildren,
} from "./ast"
import { callDeclFnIx, crIsDispatchSite } from "./check_callee"
import {
  crAsgMemo,
  crAskProg,
  crCapLossAny,
  crCapLossBank,
  crCapWidenBank,
  crFnBases,
  crFnRoots,
  crProgRoot,
  crReadLists,
  crReadMemo,
  crWideDepths,
  crWideNames,
  crWideSlots,
} from "./check_capture_rows"
import {
  crAssignTarget,
  crKeyHit,
  crNoNames,
  crNodeTok,
  crNulledBuilt,
  crNulledKeys,
  crNulledSids,
  crNulledWalk,
  crRhsNonNull,
  crwBinds,
  crwEnsure,
  crwUseKeyOf,
  crwUseKeys,
  crwUseKinds,
} from "./check_capture_walks"
import { inferQuiet } from "./check_cursor"
import {
  NAR_KIND_ASG,
  asgDeclDepths,
  asgDeclFrames,
  asgDeclKinds,
  asgDeclSlots,
  narBankRowsOf,
  narRowTy,
} from "./check_nar_bank"
import {
  declTyOf,
  declareSlot,
  identSlotOf,
  slotLayerDepth,
  slotLayerPrev,
  slotLayerTop,
  slotNameOf,
  slotVisibleOf,
} from "./check_scopes"
import { T } from "./check_types"
import { crArgMayBeFn, crIsScalarRender } from "./check_write_effects"
import { strListWith } from "./listutil"
import { sidLookup } from "./symbols"
import { cwFrameOfDecl, cwKeyOfDecl, cwKeySame } from "./check_write_scan"

export function crFnBase(): i32 {
  if crFnBases.length == 0 { return 0 }
  crFnBases[crFnBases.length - 1]
}

export function crCurRoot(): i32 {
  if crFnRoots.length == 0 { return crProgRoot }
  crFnRoots[crFnRoots.length - 1]
}

// The binding key the writer analysis answers slot `s` under: its declaration's `cwKeyOfDecl`,
// or for an ambient slot the key standing for every binding of its name.
export function crSlotKey(s: i32): i32 {
  if s >= 0 { return cwKeyOfDecl(s) }
  const sid = sidLookup(slotNameOf(s))
  if sid < 0 { return -1 }
  -2 - sid
}

// A call that runs no user code and whose function-valued arguments, if any, are lambdas written
// in place that call only such calls and do not write `name`. A callee named by a binding of the
// root counts as user code even before that binding is in scope.
export function crCallBenign(cn: Call, callIx: i32, name: string): boolean {
  if crIsScalarRender(cn) { return true }
  if cn.callFn >= 0 {
    if nodeAt(cn.callFn) is Ident {
      if crwBinds(crwUseKeyOf(cn.callFn)) { return false }
    }
  }
  if callDeclFnIx(cn, callIx) != -2 { return false }
  let i = 0
  while i < cn.callArgs.length {
    const a = cn.callArgs[i]
    if a >= 0 && a < P.nodes.length {
      const an = nodeAt(a)
      if an is FuncDecl {
        if !crSubtreeBenign(an.fnBody, name) { return false }
      } else if crArgMayBeFn(a) {
        return false
      }
    }
    i = i + 1
  }
  true
}

// Whether the subtree at `ix` neither writes `name` nor makes a call `crCallBenign` refuses.
function crSubtreeBenign(ix: i32, name: string): boolean {
  if ix < 0 || ix >= P.nodes.length { return true }
  const n = nodeAt(ix)
  if n is BinExpr {
    if n.binOp == "=" {
      const l = nodeAt(n.binLeft)
      if l is Ident {
        if l.identName == name { return false }
      }
    }
  } else if n is Call {
    if !crCallBenign(n, ix, name) { return false }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      if !crSubtreeBenign(kids[k], name) { return false }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  true
}

// The first bank row of slot `s` at depth `d`: the widest type banked there.
export function crFirstBank(s: i32, d: i32): i32 {
  // A row is banked at the scope on top when it is noted, so depth `d`'s rows are its own
  // frame's span (`pushScope`); the whole bank is read only when `d` has no frame.
  const f = d - (T.frames.length - asgDeclFrames.length)
  if f >= 0 && f < asgDeclFrames.length {
    let hi = asgDeclSlots.length
    if f + 1 < asgDeclFrames.length { hi = asgDeclFrames[f + 1] }
    let j = asgDeclFrames[f]
    while j < hi {
      if asgDeclSlots[j] == s && asgDeclDepths[j] == d { return j }
      j = j + 1
    }
    return -1
  }
  const rows = narBankRowsOf(s)
  let k = 0
  while k < rows.length {
    if asgDeclDepths[rows[k]] == d { return rows[k] }
    k = k + 1
  }
  -1
}

// A top-level function may be called anywhere, after any write, so its body reads a module
// binding that some code assigns at the declared type, whatever narrowing surrounds it (D2529).
// Bind slot `s` at its declared type `wide` in the body scope. The binding stands in for the
// captured one, so a declaration of the same name in the body shadows it rather than clashing.
export function crDeclareWidened(s: i32, wide: i32) {
  const name = slotNameOf(s)
  declareSlot(s, wide)
  crWideNames.push(name)
  crWideDepths.push(T.frames.length - 1)
  crWideSlots.push(s)
  0
}

// Whether slot `s`'s layer at depth `d` is a `crDeclareWidened` binding.
export function crWidenedAt(s: i32, d: i32): boolean {
  let i = crWideSlots.length - 1
  while i >= 0 && crWideDepths[i] >= d {
    if crWideDepths[i] == d && crWideSlots[i] == s { return true }
    i = i - 1
  }
  false
}

// Whether slot `s`'s layer at depth `d` is a narrowing rather than its declaration.
export function crIsNarrowLayer(s: i32, d: i32): boolean {
  crFirstBank(s, d) >= 0 || crWidenedAt(s, d)
}

// The depth of slot `s`'s declaration under its narrowing layers; the outermost layer when every
// one is banked, since the declaration's own scope may bank a narrowing too. -1 when unbound.
export function crBindDepthOfSlot(s: i32): i32 {
  if s == -1 { return -1 }
  let e = slotLayerTop(s)
  if e < 0 { return -1 }
  while slotLayerPrev(e) >= 0 && crIsNarrowLayer(s, slotLayerDepth(e)) {
    e = slotLayerPrev(e)
  }
  slotLayerDepth(e)
}

export function crRootCaptureWiden(fnIx: i32) {
  if !inferQuiet { crCapWidenBank[fnIx] = [] }
  const base = crFnBase()
  // Rows sit in scope order, so the first is the outermost: none below `base` means no capture.
  if asgDeclSlots.length == 0 || asgDeclDepths[0] >= base { return 0 }
  const reads = crBodyReads(fnIx)
  let r = 0
  while r < reads.length {
    const s = crReadSlot(reads[r])
    const nm = slotNameOf(s)
    const i = crInnerRowBelow(s, base)
    if i >= 0 && crNameIsModuleTop(s) {
      const wide = crOuterWidest(s, base)
      if (
        wide >= 0
        && wide != declTyOf(s)
        && crRootLoses(fnIx, s, asgDeclKinds[i])
      ) {
        crDeclareWidened(s, wide)
        crCapWidenBank[fnIx] = strListWith(
          crCapWidenBank[fnIx] ?? crNoNames,
          nm,
        )
        crCapLossBank[fnIx] = strListWith(crCapLossBank[fnIx] ?? crNoNames, nm)
        crCapLossAny = true
      }
    }
    r = r + 1
  }
  0
}

// Whether top-level function `fnIx` loses the narrowing of module binding `s`, whose innermost
// layer has bank kind `kind`. An assignment's narrowing, which only removed `null`, is kept when
// no write can store `null` and nothing can call the function ahead of the narrowing write.
function crRootLoses(fnIx: i32, s: i32, kind: i32): boolean {
  if kind != NAR_KIND_ASG { return crNameAssignedInProgram(s) }
  const name = slotNameOf(s)
  crNameNulledInProgram(s) || !crRootMayKeep(fnIx, name)
}

// The frame declaring slot `s`'s binding, as `crCaptureByRef` walks it: its function, else the
// program.
export function crSlotFrame(s: i32): i32 {
  if s < 0 { return crProgRoot }
  const fr = cwFrameOfDecl(s)
  if fr < 0 { return crProgRoot }
  fr
}

// Whether slot `s`'s binding is the target of an assignment in the current root.
export function crNameAssignedInRoot(s: i32): boolean {
  const root = crCurRoot()
  if root == crProgRoot { crAskProg("w", slotNameOf(s)) }
  const key = crSlotKey(s)
  let memo = crAsgMemo[root]
  if memo == null {
    const fresh: {[i32]: boolean} = Map()
    crAsgMemo[root] = fresh
    memo = fresh
  }
  const m = memo ?? crNoAsg
  const hit = m[key]
  if hit is boolean { return hit }
  crwEnsure(root)
  let found = false
  let u = 0
  while u < crwUseKeys.length && !found {
    if crwUseKinds[u] == 2 && cwKeySame(crwUseKeys[u], key) { found = true }
    u = u + 1
  }
  m[key] = found
  found
}

const crNoAsg: {[i32]: boolean} = Map()

// Whether slot `s` is declared at module scope, looking through its narrowing layers.
export function crNameIsModuleTop(s: i32): boolean {
  if s == -1 { return false }
  let e = slotLayerTop(s)
  while e >= 0 {
    const d = slotLayerDepth(e)
    if d == 0 { return true }
    if crFirstBank(s, d) < 0 { return false }
    e = slotLayerPrev(e)
  }
  false
}

function crNameAssignedInProgram(s: i32): boolean {
  crFnRoots.push(crProgRoot)
  const r = crNameAssignedInRoot(s)
  crFnRoots.pop()
  r
}

// Whether an assignment anywhere in the program may store `null` into the module binding `name`:
// one whose right side is not a non-null literal, and whose target does not resolve to a binding
// local to a function. One walk of the program answers every binding.
export function crNameNulledInProgram(s: i32): boolean {
  crAskProg("w", slotNameOf(s))
  if !crNulledBuilt {
    crNulledBuilt = true
    crNulledWalk(crProgRoot)
  }
  crKeyHit(crNulledKeys, crNulledSids, crSlotKey(s))
}

// Whether a top-level function `fnIx` may keep an assignment narrowing of module binding `name`:
// the program's first top-level write of it stores a non-null literal, and no call runs before
// that write, so nothing can call the function while the binding still holds `null`.
function crRootMayKeep(fnIx: i32, name: string): boolean {
  crAskProg("o", name)
  const pr = nodeAt(crProgRoot)
  if !(pr is Program) { return false }
  const stmts = pr.progStmts
  const fnTok = crNodeTok(fnIx)
  let sawCall = false
  let s = 0
  while s < stmts.length {
    if crNodeTok(stmts[s]) >= fnTok { return false }
    if crAssignTarget(stmts[s]) == name {
      const a = nodeAt(stmts[s])
      if a is BinExpr {
        if crRhsNonNull(a.binRight) { return !sawCall }
      }
      return false
    }
    if !sawCall && crHasCall(stmts[s]) { sawCall = true }
    s = s + 1
  }
  false
}

// Whether evaluating the statement or expression `ix` may run user code: a call anywhere in it,
// outside a nested function's body, that `crCallBenign` does not clear, or an operator or index
// that may dispatch to a declaration.
function crHasCall(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if n is FuncDecl { return false }
  if n is Call {
    if !crCallBenign(n, ix, "") { return true }
  }
  if crIsDispatchSite(ix) { return true }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      if crHasCall(kids[k]) { return true }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  false
}

// The first read of each distinct bare name in the body of function `fnIx`, nested functions
// included, as `Ident` nodes.
export function crBodyReads(fnIx: i32): i32[] {
  const hit = crReadLists[fnIx]
  if hit is i32[] { return hit }
  crReadAcc = []
  const fd = nodeAt(fnIx)
  if fd is FuncDecl { crReadWalk(fd.fnBody, i32ToStr(fnIx) + "#") }
  crReadLists[fnIx] = crReadAcc
  crReadAcc
}

// The innermost narrowing bank row of slot `s` below scope depth `base`, or -1.
export function crInnerRowBelow(s: i32, base: i32): i32 {
  const rows = narBankRowsOf(s)
  let r = rows.length - 1
  while r >= 0 {
    if asgDeclDepths[rows[r]] < base { return rows[r] }
    r = r - 1
  }
  -1
}

function crReadWalk(ix: i32, pre: string) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is Ident {
    const key = pre + n.identName
    if !crReadMemo.has(key) {
      crReadMemo[key] = true
      crReadAcc.push(ix)
    }
    return 0
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      crReadWalk(kids[k], pre)
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  0
}

let crReadAcc: i32[] = []

// The binding the name read at `Ident` `ix` reaches at the body's entry: where the body's own
// declaration of it hides it, the one that declaration hides.
export function crReadSlot(ix: i32): i32 {
  const n = nodeAt(ix)
  if n is Ident { return slotVisibleOf(identSlotOf(ix, n.identName)) }
  -1
}

// The type slot `s` reads at under no narrowing, when its innermost layer is a narrowing of a
// function enclosing the one whose body starts at scope depth `base`; -1 otherwise.
export function crOuterWidest(s: i32, base: i32): i32 {
  if s == -1 { return -1 }
  let e = slotLayerTop(s)
  if e < 0 || slotLayerDepth(e) >= base { return -1 }
  let widest = -1
  while e >= 0 {
    const row = crFirstBank(s, slotLayerDepth(e))
    if row < 0 { return widest }
    widest = narRowTy(row)
    e = slotLayerPrev(e)
  }
  widest
}
