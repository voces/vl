// True, having reported, when a rest parameter's element is an unbound HOLE and the packed
// list's element joined to a union that BOXES. `T` would pin to that union and the instance
// the monomorphizer mints for it misbuilds — check-clean invalid wasm, the worst outcome
// there is — so it is refused at the pin, naming the concrete spelling that runs (D1851).
function restHoleUnionErr(pTy: i32, packIx: i32, ix: i32): boolean {
  const pe = tyArrayElemIx(pTy)
  if pe < 0 || pe >= T.tys.length { return false }
  const pt = T.tys[pe]
  if pt is TyVar {
    const at = tyArrayElemIx(checkNodeHook(packIx))
    if at < 0 || at >= T.tys.length { return false }
    const a = T.tys[at]
    if a is TyUnion {
      if unionRidesI32Spine(at) { return false }
      tErr(
        "a rest parameter's element is inferred from the arguments, and these join to "
          + tyToStr(at)
          + " — a boxed union a type parameter cannot be pinned to. Spell the element out, "
          + "`...xs: ("
          + tyToStr(at)
          + ")[]`, or pass one element type",
        ix,
      )
      return true
    }
  }
  false
}

// —— the witness: satisfaction is the existing call resolution ————————————————
// `x.m(a)` under a bound resolves by the same order every method call uses — a field of the
// receiver first, then a free `self`-function in scope. Returns a stable string naming which
// won (`"field"`, the mangled `self`-function name, or `""`) — the coherence key's value and the words the disagreement diagnostic prints (resolved in the instantiation site's own module scope, D1191).
function witnessOf(memberName: string, wantTy: i32, concTy: i32, ix: i32) {
  if concTy < 0 || wantTy < 0 { return "" }
  const ct = T.tys[concTy]
  if ct is TyObj {
    const ft = objFieldType(ct, memberName)
    if ft >= 0 {
      if assignable(ft, wantTy) { return "field" }
      return ""
    }
  }
  const mangled = ufcsAliasInScope(ix, memberName)
  const fnTy = lookup(mangled)
  if fnTy < 0 { return "" }
  const ft2 = T.tys[fnTy]
  if ft2 is TyFunc {
    const wt = T.tys[wantTy]
    if wt is TyFunc {
      // The receiver occupies slot 0 and the bound's arguments fill the rest —
      // the arity `ufcsCallTy` enforces, asked here of a type rather than of a
      // node so it can be asked before any call exists.
      if ft2.fnParamTypes.length != wt.fnParamTypes.length + 1 { return "" }
      if !assignable(concTy, ft2.fnParamTypes[0]) { return "" }
      let i = 0
      while i < wt.fnParamTypes.length {
        if !assignable(wt.fnParamTypes[i], ft2.fnParamTypes[i + 1]) {
          return ""
        }
        i = i + 1
      }
      // A callee whose return is still pending (-2) has not been inferred yet; force it,
      // exactly as `ufcsCallTy` does, so an un-annotated std export's real type is known here rather than guessed.
      let retTy = ft2.fnRet
      if retTy == (-2) {
        if !onInferStack(mangled) {
          const dIx = fnDeclIx[mangled] ?? -1
          if dIx >= 0 {
            checkNodeHook(dIx)
            const re = T.tys[lookup(mangled)]
            if re is TyFunc { retTy = re.fnRet }
          }
        }
      }
      if !assignable(retTy, wt.fnRet) { return "" }
      return mangled
    }
  }
  ""
}

// The instantiation-site check: for each bounded type parameter the call actually bound,
// resolves every bound member against the concrete type in this site's scope and refuses
// what nothing satisfies. The bound's own member types resolve with the parameter bound to
// the concrete type, which is what makes `{ eq(T): boolean }` mean "eq takes another one of me" at each instantiation with no self-type machinery.
function checkBoundsAtCall(
  who: string,
  declIx: i32,
  bNames: string[],
  bTys: i32[],
  ix: i32,
) {
  if declIx < 0 { return 0 }
  if !fnHasTpBound(declIx) { return 0 }
  const dn = P.nodes[declIx]
  if !(dn is FuncDecl) { return 0 }
  let k = 0
  while k < dn.fnTyParams.length {
    const bAnn = fnTpBoundOf(declIx, k)
    if bAnn >= 0 {
      const tpName = dn.fnTyParams[k]
      let conc = -1
      let bi = 0
      while bi < bNames.length {
        if bNames[bi] == tpName { conc = bTys[bi] }
        bi = bi + 1
      }
      // Chaining through another generic's own type parameter has no instantiation type to
      // resolve a witness against, so it is decided by subsumption instead — statically,
      // which lands the error on the declaration that is wrong rather than a distant caller.
      // Bounds are free at emit once substitution has run; the check is what needs this, since a bounded generic relayed through an unbounded one has no pin left to ask (`vl check`-clean and invalid).
      if conc >= 0 {
        const ct0 = T.tys[conc]
        if ct0 is TyVar {
          if ct0.tvName.length > 0 {
            if ct0.tvName[0] != '?' {
              checkBoundSubsumes(ct0.tvName, tpName, bAnn, who, ix)
              k = k + 1
              continue
            }
          }
        }
      }
      if conc >= 0 && !tyHasHole(conc) {
        const root = boundObjRootOf(bAnn)
        if root < 0 {
          tErr(
            "`"
              + boundText(bAnn)
              + "` is not a bound — a bound is a type with method members (`type "
              + boundText(bAnn)
              + " = { m(): R }`) or an inline `{ m(): R }`",
            ix,
          )
        } else {
          // Bind the parameter to the CONCRETE type while the bound's member
          // types resolve, so a self-referential member means what it says here.
          tpEnvNames.push(tpName)
          tpEnvTys.push(conc)
          const bn: string[] = []
          const bt: i32[] = []
          const bm: boolean[] = []
          boundMembersOf(root, bn, bt, bm)
          tpEnvNames.pop()
          tpEnvTys.pop()
          const tyKey = tyToStr(conc)
          const bCovs: string[] = []
          let m = 0
          while m < bn.length {
            let wit = ""
            // An unresolved member type is the alias-self-reference case, reported at the
            // declaration (the body's own use raised it) rather than adding a second voice here.
            if bt[m] < 0 {
              m = m + 1
              continue
            }
            if bm[m] {
              wit = witnessOf(bn[m], bt[m], conc, ix)
            } else {
              // A COLON member is a layout demand and stays one: the value must
              // carry the field, which is ordinary structural assignability.
              const ct = T.tys[conc]
              if ct is TyObj {
                const ft = objFieldType(ct, bn[m])
                if ft >= 0 {
                  if assignable(ft, bt[m]) {
                    wit = "field"
                    rcwCovs(ft, bt[m], "." + bn[m], bCovs, 0)
                  }
                }
              }
            }
            const gBound = getterFnFor(conc, bn[m])
            if wit == "" && gBound != "" {
              tErr(
                tyKey
                  + " does not satisfy `"
                  + boundText(bAnn)
                  + "`: "
                  + getterBoundNote(gBound, bm[m]),
                ix,
              )
            } else if wit == "" && !bm[m] {
              tErr(
                tyKey
                  + " does not satisfy `"
                  + boundText(bAnn)
                  + "`: no field `"
                  + bn[m]
                  + ": "
                  + tyToStr(bt[m])
                  + "` — a field bound is satisfied only by a stored field; to accept a `"
                  + bn[m]
                  + "(self: "
                  + tyKey
                  + ")` function, bound on `{ "
                  + bn[m]
                  + "(): "
                  + tyToStr(bt[m])
                  + " }`",
                ix,
              )
            } else if wit == "" {
              let what = bn[m]
              if bm[m] { what = bn[m] + "(): " + tyToStr(retOfFuncTy(bt[m])) }
              tErr(
                tyKey
                  + " does not satisfy `"
                  + boundText(bAnn)
                  + "`: no `"
                  + what
                  + "` — the bound needs a field of that type or a `"
                  + bn[m]
                  + "(self: "
                  + tyKey
                  + ", …)` function in scope at this call",
                ix,
              )
            } else {
              cohRecord(who, tyKey, bn[m], wit, ix)
            }
            m = m + 1
          }
          // D2060 — a colon member wider than the argument's field is the covariant delivery
          // of a record, and the body writes through the bound's type.
          if bCovs.length > 0 && !inferQuiet {
            rcwBdDecl.push(declIx)
            rcwBdTp.push(tpName)
            rcwBdConc.push(conc)
            rcwBdCovs.push(bCovs)
            rcwBdCall.push(ix)
          }
        }
      }
    }
    k = k + 1
  }
  0
}

// Type the bitcast call `name(arg)`, or -1 when `name` is not a bitcast. Arity and the
// argument type are checked here; `assignableExpr` (not bare `assignable`) so a float
// LITERAL argument re-encodes into an `f32` parameter, matching every other f32 position.
function bitcastCallTy(name: string, n: Call, ix: i32) {
  const want = bitcastArgTy(name)
  if want < 0 { return -1 }
  const args = n.callArgs
  if args.length != 1 {
    tErr(name + " expects 1 argument, got " + i32ToStr(args.length), ix)
  } else {
    const got = checkNodeHook(args[0])
    if !assignableExpr(args[0], got, want) {
      tErr(name + " expects " + tyToStr(want) + ", got " + tyToStr(got), ix)
    }
  }
  bitcastRetTy(name)
}

// Type the float / integer intrinsic call `name(args…)`, or -1 when `name` is not one.
// The operand width is decided from the arguments and every argument is then checked
// against it, so a mixed call reports the width it actually computes at.
function numIntrCallTy(name: string, n: Call, ix: i32) {
  const isFloat = floatIntrArity(name) > 0
  let arity = intIntrArity(name)
  if isFloat { arity = floatIntrArity(name) }
  if arity == 0 { return -1 }
  const args = n.callArgs
  if args.length != arity {
    let want = i32ToStr(arity) + " arguments"
    if arity == 1 { want = "1 argument" }
    tErr(name + " expects " + want + ", got " + i32ToStr(args.length), ix)
    // Still yield a type so the call site does not cascade: the width is unknowable
    // from a wrong-arity call, so take the family's default.
    if isFloat { return TY_F64 }
    if intIntrIsCompare(name) { return TY_BOOL }
    return TY_I32
  }
  const argTys: i32[] = []
  let i = 0
  while i < args.length {
    argTys.push(checkNodeHook(args[i]))
    i = i + 1
  }
  const holeTy = minMaxHoleOperand(name, argTys)
  if holeTy >= 0 {
    noteBinCstr(argTys[0], name, argTys[argTys.length - 1])
    return holeTy
  }
  let width = intIntrWidth(argTys)
  if isFloat && !intMinMaxOperands(name, argTys) {
    width = floatIntrWidth(args, argTys)
  }
  // An operand is no delivery: `ltU(a, b)` computes at the width `a` and `b` give it.
  const savedNoDest = lbiNoDest
  lbiNoDest = true
  let j = 0
  while j < args.length {
    if !assignableExpr(args[j], argTys[j], width) {
      tErr(
        name + " expects " + tyToStr(width) + ", got " + tyToStr(argTys[j]),
        ix,
      )
    }
    j = j + 1
  }
  lbiNoDest = savedNoDest
  if !isFloat {
    if intIntrIsCompare(name) { return TY_BOOL }
  }
  width
}

// A memory intrinsic called with one argument more than it declares: the offset form, whose
// second argument is the memarg offset. Checks the offset (`memOffsetArgCheck`) and every other
// argument against the declared parameter it stands for; answers the call's type, or -1 when
// the call is not this form (a shadowed name, a named argument, any other arity).
function checkMemOffsetCall(n: Call, cfn: Ident): i32 {
  const nm = cfn.identName
  const base = memOffsetBaseArity(nm)
  if base < 0 || n.callArgs.length != base + 1 { return -1 }
  if hasNamedArgs(n.callArgNames) { return -1 }
  if (fnDeclIx[nm] ?? -1) >= 0 || lookupDepth(nm) != 0 { return -1 }
  const ft = T.tys[checkNodeHook(n.callFn)]
  if ft is TyFunc {
    const ps = ft.fnParamTypes
    if ps.length != base { return -1 }
    memOffsetArgCheck(nm, n.callArgs[1])
    let k = 0
    while k < base {
      let pos = k
      if k >= 1 { pos = k + 1 }
      const a = n.callArgs[pos]
      seedExpected(a, ps[k])
      const at = checkNodeHook(a)
      if !assignableExpr(a, at, ps[k]) { argMismatchErr(pos + 1, ps[k], at, a) }
      k = k + 1
    }
    return ft.fnRet
  }
  -1
}

// Reports unless the offset argument at `argIx` is a compile-time integer in
// `0..MEM_OFFSET_MAX`: a literal, a top-level `const` bound to one that no nearer binding
// shadows, or a sum of those.
function memOffsetArgCheck(nm: string, argIx: i32) {
  checkNodeHook(argIx)
  if memOffsetCheckedValue(argIx) >= 0 { return 0 }
  tErr(
    nm
      + " takes its offset (argument 2) as a compile-time integer in 0..4294967295 — a literal, a top-level `const` bound to one, or a sum of those — since it is the instruction's memarg immediate, not a runtime operand",
    argIx,
  )
  0
}

// Calls to a compiler builtin named by the callee identifier — `print`, `Map`/`Set`, the
// codepoint constructors and the `__array_*` / bitcast / numeric intrinsics. None has a
// declaration to check against, so arity and argument types are checked here. Returns the
// call type, or `-1` when the name is none of them and the caller checks it as a value.
function checkBuiltinIdentCall(n: Call, ix: i32, cfn: Ident): i32 {
  if cfn.identName == "print" { return checkPrintCall(n, ix) }
  // `Map()` / `Set()` construct an empty string-keyed map: key/value HOLES (-1)
  // assignable to any map annotation (`const m: {[string]: i32} = Map()`).
  if cfn.identName == "Map" || cfn.identName == "Set" {
    if n.callArgs.length != 0 {
      tErr(cfn.identName + " expects no arguments", ix)
    }
    if callHasTyArgs(ix) { return collCtorTyArgsTy(cfn.identName, ix) }
    if cfn.identName == "Set" {
      // A set's VALUE type is the membership boolean; the element (key) is a
      // hole pinned by the annotation or the first `.add`.
      return mkMapTy(-1, TY_BOOL, 1)
    }
    return mkMapTy(-1, -1, 0)
  }
  // `toString(x)` resolves through the ordinary scope as `std:fmt`'s export now, and an
  // un-imported use gets the migration hint `undeclaredIdentMsg` appends.
  if cfn.identName == "fromCodePoints" { return checkFromCodePointsCall(n, ix) }
  // `fromCodePoint(code)` is a builtin: an i32 code point -> a length-1 string.
  if cfn.identName == "fromCodePoint" {
    const fargs = n.callArgs
    if fargs.length != 1 {
      tErr(
        "fromCodePoint expects 1 argument, got " + i32ToStr(fargs.length),
        ix,
      )
    } else {
      const f0 = checkNodeHook(fargs[0])
      if !assignable(f0, TY_I32) {
        tErr("fromCodePoint expects an i32, got " + tyToStr(f0), ix)
      }
    }
    return TY_STR
  }
  if cfn.identName == "__str_from_bytes__" {
    return checkStrFromBytesCall(n, ix)
  }
  // The array-intrinsic floor (std-design D1 / collections-design §LS.2),
  // host parity: `defaultScope.ts`. `__array_new__(n, fill)` allocates `n`
  // slots each set to `fill`, typing as `T[]` with `T` = the fill's type.
  if cfn.identName == "__array_new__" {
    const anArgs = n.callArgs
    if anArgs.length != 2 {
      tErr(
        "__array_new__ expects 2 arguments, got " + i32ToStr(anArgs.length),
        ix,
      )
      return mkArrayTy(-1)
    }
    const anLen = checkNodeHook(anArgs[0])
    if !assignable(anLen, TY_I32) {
      tErr("__array_new__ expects an i32 length, got " + tyToStr(anLen), ix)
    }
    return mkArrayTy(checkNodeHook(anArgs[1]))
  }
  if cfn.identName == "__array_new_default__" {
    return checkArrayNewDefaultCall(n, ix)
  }
  if cfn.identName == "__array_copy__" { return checkArrayCopyCall(n, ix) }
  // `__trap__()`: the deliberate abort primitive — lowered to `unreachable`.
  // `__trap__("reason")`: an OPTIONAL single string message, printed to the
  // host boundary (the print-of-string path) before the abort — so the trap
  // carries a human-readable reason. Either form still "never returns".
  if cfn.identName == "__trap__" {
    if n.callArgs.length > 1 {
      tErr("__trap__ takes an optional string message", ix)
    } else if n.callArgs.length == 1 {
      const trapMsgTy = checkNodeHook(n.callArgs[0])
      if !assignable(trapMsgTy, TY_STR) {
        tErr(
          "__trap__ takes an optional string message, got " + tyToStr(trapMsgTy),
          ix,
        )
      }
    }
    return TY_NEVER
  }
  // The numeric-opcode intrinsics: each lowers to exactly one wasm instruction, so
  // the checker only has to type them. A user binding of the same name shadows the
  // intrinsic (`numIntrShadowed`), and the emitter gates on the same rule — the
  // intrinsic arm is a fallback for a name the program did not define itself.
  if !numIntrShadowed(cfn.identName) {
    const bcTy = bitcastCallTy(cfn.identName, n, ix)
    if bcTy >= 0 { return bcTy }
    const niTy = numIntrCallTy(cfn.identName, n, ix)
    if niTy >= 0 { return niTy }
  }
  -1
}

// `print(x)` is a compiler builtin (no module/import system yet): it accepts a
// single value of any printable type and yields void. Special-cased so a program
// that prints does not trip "undeclared identifier 'print'". Each argument is
// still checked so a type error inside it surfaces.
function checkPrintCall(n: Call, ix: i32): i32 {
  const pargs = n.callArgs
  if pargs.length != 1 {
    tErr("print expects 1 argument, got " + i32ToStr(pargs.length), ix)
  }
  let pj = 0
  while pj < pargs.length {
    const pt = checkNodeHook(pargs[pj])
    // `print` demands a value to render, and a `void` call has none — the emitter's
    // print ladder ends in `call __print_i32__` with nothing on the stack.
    voidValueSlotErr(pt, pargs[pj], "print", pargs[pj])
    // A domain rejection, asked first (the ruling): `print` takes one value of
    // `printDomainStr()`'s reps, and an array/struct/map/function value (bare, behind
    // `| null`, or inside a union) is not one — an ordinary domain error (`tErr`, no
    // code), not a capability admission, since the language never defined what such a print outputs (D711).
    if tyPrintsAsRef(pt, 24) {
      tErr(printRefRefusal(pt), pargs[pj])
    } else {
      // The BOXED value-union residue. `print(<i32 | string>)` now LOWERS — every arm
      // is inside the domain and the emitter dispatches on the box tag, the same
      // dispatch it performs for `is` (D712) — so what is left here is a box whose
      // arms that dispatch cannot classify, and only that keeps the concession.
      const puMsg = printUnionRefusal(pt)
      if puMsg != "" { tErrUnsupported(puMsg, pargs[pj]) }
    }
    // A printed type that still carries a HOLE answers FALSE to both floors above — it
    // is neither a ref nor a box YET — so the two of them together admit every generic
    // `print`. Defer it to the pin, the only position that knows the instance.
    // (`silent-class-inventory` D401; the recorder's header has the measurement.)
    notePrintCstr(pt, pargs[pj])
    pj = pj + 1
  }
  return TY_VOID
}

// `fromCodePoints(xs)` is a builtin: an `i32[]` of code points to a string, in one bulk
// copy (the amortized alternative to per-char concat).
function checkFromCodePointsCall(n: Call, ix: i32): i32 {
  const pargs = n.callArgs
  if pargs.length != 1 {
    tErr("fromCodePoints expects 1 argument, got " + i32ToStr(pargs.length), ix)
  } else {
    const p0 = checkNodeHook(pargs[0])
    let pOk = false
    if p0 >= 0 && p0 < T.tys.length {
      const p0t = T.tys[p0]
      if p0t is TyArray {
        // An empty `[]` literal's element hole (-1) pins to i32 here.
        if p0t.aElem < 0 || assignable(p0t.aElem, TY_I32) { pOk = true }
      }
      if p0t is TyErr { pOk = true }
    }
    if !pOk { tErr("fromCodePoints expects an i32[], got " + tyToStr(p0), ix) }
  }
  return TY_STR
}

// `__str_from_bytes__(src, at, count)` (D4784): the bytes `src[at .. at + count]` as a fresh
// string; the caller guarantees UTF-8. A builtin, not a declaration, so a call is no opaque
// function value to the narrowing rule (`callDeclFnIx`).
function checkStrFromBytesCall(n: Call, ix: i32): i32 {
  const sbArgs = n.callArgs
  if sbArgs.length != 3 {
    tErr(
      "__str_from_bytes__ expects 3 arguments, got " + i32ToStr(sbArgs.length),
      ix,
    )
    return TY_STR
  }
  const sbSrc = checkNodeHook(sbArgs[0])
  if !assignable(sbSrc, mkArrayTy(TY_U8)) {
    tErr("__str_from_bytes__ expects a u8[] source, got " + tyToStr(sbSrc), ix)
  }
  let sbI = 1
  while sbI < 3 {
    const sbT = checkNodeHook(sbArgs[sbI])
    if !assignable(sbT, TY_I32) {
      tErr("__str_from_bytes__ expects an i32 bound, got " + tyToStr(sbT), ix)
    }
    sbI = sbI + 1
  }
  return TY_STR
}

// `__array_new_default__(n)`: `n` zeroed/default slots. The element type is a hole (-1)
// pinned by the destination — the empty-`[]` mechanism — and the emitter reads the same
// pinned row back off this node (`arrNewDefaultKind`), so the two cannot disagree about
// the rep. Two questions this arm cannot answer yet are recorded here and asked late (`arrDefCallIx`).
function checkArrayNewDefaultCall(n: Call, ix: i32): i32 {
  const adArgs = n.callArgs
  if adArgs.length != 1 {
    tErr(
      "__array_new_default__ expects 1 argument, got " + i32ToStr(adArgs.length),
      ix,
    )
  } else {
    const adLen = checkNodeHook(adArgs[0])
    if !assignable(adLen, TY_I32) {
      tErr(
        "__array_new_default__ expects an i32 length, got " + tyToStr(adLen),
        ix,
      )
    }
  }
  const adTy = mkArrayTy(-1)
  arrDefCallIx.push(ix)
  arrDefCallTy.push(adTy)
  return adTy
}

// `__array_copy__(dst, dstAt, src, srcAt, count)`: bulk-moves `count` elements from
// `src[srcAt..]` into `dst[dstAt..]`; void. Both must be arrays; the element correlation
// between them is deliberately not enforced here, matching the host's own leniency (a
// mismatched pair fails loudly at the emit stage in both compilers).
function checkArrayCopyCall(n: Call, ix: i32): i32 {
  const acArgs = n.callArgs
  if acArgs.length != 5 {
    tErr(
      "__array_copy__ expects 5 arguments, got " + i32ToStr(acArgs.length),
      ix,
    )
    return TY_VOID
  }
  let acI = 0
  while acI < 5 {
    const acT = checkNodeHook(acArgs[acI])
    if acI == 0 || acI == 2 {
      let acOk = false
      if acT >= 0 && acT < T.tys.length {
        const acTy = T.tys[acT]
        if acTy is TyArray { acOk = true }
        if acTy is TyErr { acOk = true }
      }
      if !acOk { tErr("__array_copy__ expects a T[], got " + tyToStr(acT), ix) }
    } else {
      if !assignable(acT, TY_I32) {
        tErr("__array_copy__ expects an i32, got " + tyToStr(acT), ix)
      }
    }
    acI = acI + 1
  }
  return TY_VOID
}

// A call through a binding whose type an annotation or a lambda's parameters wrote binds each
// enclosing type parameter that type names to itself, since `k: (x: T) => void` takes the body's
// `T`; an argument of another type parameter is then judged at each instance (D6483).
function bindCalleeScopeTyParams(
  cfn: Node,
  cfnIx: i32,
  ft: TyFunc,
  bNames: string[],
  bTys: i32[],
) {
  if tpEnvNames.length == 0 || !calleeTyIsScoped(cfn, cfnIx) { return 0 }
  let i = tpEnvNames.length - 1
  while i >= 0 {
    const nm = tpEnvNames[i]
    if !strListHas(bNames, nm) && ftParamsMentionTyVar(ft, nm) {
      bNames.push(nm)
      bTys.push(tpEnvTys[i])
    }
    i = i - 1
  }
  0
}

// Whether a parameter of `ft` names type variable `nm`; a result alone does not, since a
// lambda's inferred result names the body's parameters without taking them.
function ftParamsMentionTyVar(ft: TyFunc, nm: string): boolean {
  for p in ft.fnParamTypes {
    if tyMentionsTyVarNamed(p, nm, 8) { return true }
  }
  false
}

// Whether the callee name at `cfnIx` is a binding or parameter declared with a type, one bound
// to a lambda, or a function declaring no type parameters, so its type variables are the
// enclosing scope's and not its own.
function calleeTyIsScoped(cfn: Node, cfnIx: i32): boolean {
  if !(cfn is Ident) { return false }
  const fr = covarRootFrame(cfnIx)
  const b = cwSoleBinderOf(cfn.identName, fr)
  if b < 0 {
    const d = cwFnDeclOf(cfn.identName)
    if d < 0 || d >= P.nodes.length { return false }
    if fr != CW_FR_UNKNOWN && cwFrameOfDecl(d) != fr { return false }
    const dn = P.nodes[d]
    return dn is FuncDecl && dn.fnTyParams.length == 0
  }
  const bn = P.nodes[b]
  if bn is Param { return bn.parType >= 0 }
  if !(bn is LetDecl) { return false }
  if bn.letType >= 0 { return true }
  const init = cwPeel(bn.letInit)
  if init < 0 || init >= P.nodes.length { return false }
  const ln = P.nodes[init]
  ln is FuncDecl && ln.fnTyParams.length == 0
}

// The ordinary call: the callee evaluates to a function type, so the arguments are checked
// against its parameter list — named arguments reordered, an omitted trailing one filled
// from the declaration default, and type-parameter bindings solved from the argument types.
// Always answers; the caller's remaining arms cover an error or still-unsolved callee.
function checkCallOnFuncTy(n: Call, ix: i32, cfn: Node, ft: TyFunc): i32 {
  let args = n.callArgs
  // PENDING return (-2): the un-annotated callee hasn't been inferred yet (a
  // forward call). Demand-infer it now — check its FuncDecl, which patches this
  // very TyFunc in place — unless it is already on the in-progress stack (an
  // in-cycle call: contribute TY_ERR so the cycle can be detected at the root).
  if ft.fnRet == -2 {
    if cfn is Ident {
      if !onInferStack(cfn.identName) {
        const dIx = fnDeclIx[cfn.identName] ?? -1
        if dIx >= 0 { checkNodeHook(dIx) }
      }
    }
  }
  let retTy = ft.fnRet
  if retTy == -2 {
    retTy = TY_ERR
    // A direct self-recursive call resolves to the function's own provisional inferred
    // type (`inferObserved`, already holding the base case since it is checked first) —
    // without this, `TY_ERR` makes `assignable(TY_ERR, string)` vacuously true and a `+`
    // over the recursive call pollutes the inferred return. Mutual recursion keeps `TY_ERR` for the fixpoint to settle.
    if cfn is Ident {
      if inferStack.length > 0 {
        if inferStack[inferStack.length - 1] == cfn.identName {
          if inferObserved >= 0 { retTy = inferObserved }
        }
      }
    }
  }
  const params = ft.fnParamTypes
  // Defaults are direct-call-site sugar: a call naming a declared function may omit
  // trailing arguments whose parameters carry a default, so the accepted arity is the
  // range [`fnRequiredArity`, `params.length`]. A call through a function value has no
  // declaration to read defaults from and keeps its exact-arity gate.
  const dParams = calleeDeclParams(n.callFn)
  const naOk: boolean[] = [false]
  args = callFtyNormArgs(n, ix, cfn, params, dParams, args, naOk)
  if !naOk[0] { return retTy }
  // Generic call-site inference: a `TyVar` param (or `T[]`) binds its type-param to
  // the argument's type (first use wins; later uses must agree), and the return
  // type substitutes through the binding — so `id("s")` is `string`, and
  // `let n: i32 = id("s")` is a genuine type error downstream.
  const bNames: string[] = []
  const bTys: i32[] = []
  const uNames: string[] = []
  const uTys: i32[] = []
  // Explicit type arguments bind first, so every argument is checked against them.
  const explicitTa = callHasTyArgs(ix)
  if explicitTa {
    if !bindExplicitTyArgs(cfn, ix, bNames, bTys) { return TY_ERR }
  }
  bindCalleeScopeTyParams(cfn, n.callFn, ft, bNames, bTys)
  let dstNames = NO_DST_NAMES
  if !explicitTa && callDstTyOf(ix) >= 0 {
    dstNames = []
    dstBindLitTyParams(ix, ft.fnRet, params, args, bNames, bTys, dstNames)
  }
  const argOrder = lambdaLastOrder(params, args)
  // Each argument's destination as its own turn saw it, for the literals re-delivered below.
  const argExp: i32[] = []
  while argExp.length < args.length { argExp.push(-1) }
  let oi = 0
  while oi < argOrder.length {
    const aRet = callFtyCheckArg(
      n,
      ix,
      cfn,
      params,
      dParams,
      args,
      argOrder[oi],
      bNames,
      bTys,
      uNames,
      uTys,
      argExp,
    )
    if aRet >= 0 { return aRet }
    oi = oi + 1
  }
  const hNames: string[] = []
  const hTys: i32[] = []
  callFtyNoteLateArgCstrs(cfn, params, args, argExp, bNames, bTys, hNames, hTys)
  // A list or record literal holding a generic function, met before a later argument bound the
  // type parameter its element type rides, is delivered again at the bound type (D3923).
  if !inferQuiet {
    let li = 0
    while li < args.length && li < params.length {
      if (
        argExp[li] >= 0
        && tyHasTyVar(argExp[li])
        && argIsLitAggregate(args[li])
      ) {
        const fin = substTyDeep(params[li], bNames, bTys)
        if fin != argExp[li] {
          genFnValueCstrs(args[li], nodeTyOf(args[li]), fin)
        }
      }
      li = li + 1
    }
  }
  if dstNames.length > 0 && !inferQuiet {
    dstRetypeLitArgs(dstNames, params, args, bNames, bTys)
  }
  // After the arguments, so a mismatched argument gets the more specific diagnostic first;
  // the answer itself is the callee's declaration, not this site's bindings.
  if cfn is Ident {
    let rtpDecl = fnDeclIx[cfn.identName] ?? CSTR_NODECL
    if rtpDecl == CSTR_NODECL { rtpDecl = lookupFnAliasNode(cfn.identName) }
    if !explicitTa {
      checkRetTyParamBound(rtpDecl, cfn.identName, ix, ft.fnRet)
    }
  }
  // Substitutes the binding into a generic return type — deep, so a structural return
  // (`{first: B, second: A}`, a generic alias body, a function-typed field) concretizes
  // per call site; a derived `?ret.` hole collapses to the pinned callee's return
  // (`substTyDeep`).
  const vNames: string[] = []
  const vTys: i32[] = []
  withUnionArmBinds(bNames, bTys, uNames, uTys, vNames, vTys)
  if vNames.length > 0 {
    retTy = callFtyPinCstrs(
      n,
      ix,
      cfn,
      ft,
      params,
      args,
      bNames,
      bTys,
      vNames,
      vTys,
      retTy,
    )
  }
  if hNames.length > 0 { retTy = substTyDeep(retTy, hNames, hTys) }
  // A deferred join this site cannot decide has no rep, so it collapses to one arm, parked
  // whole for a `return h(w)` relay (`inferRetTyOf`); in a body the gate does not hold, one of
  // that body's own parameters is kept as a union instead, which its pins re-join (D3589).
  let kept = -1
  if tyIsDeferredJoin(retTy) && !njFnReached(njFnIx) {
    const keep = (apartHoleJoins.get(retTy) ?? false) || calleeRetDeclared(cfn)
    kept = keptParamUnion(retTy, keep)
  }
  let cRetTy = kept
  if kept < 0 { cRetTy = collapseDeferredJoin(retTy) }
  if cRetTy != retTy {
    noteDeferredJoinNode(ix, retTy)
    let ejWho = ""
    if cfn is Ident { ejWho = cfn.identName }
    if kept < 0 { noteEscJoin(retTy, ix, ejWho) }
  }
  return cRetTy
}

// The arguments of an ordinary call made index-parallel with `params`: a rest tail packed,
// named arguments reordered, omitted trailing ones padded with their declared defaults.
// `ok[0]` turns true only when they line up; otherwise the arity or spelling is refused
// here and the caller answers its pending return.
function callFtyNormArgs(
  n: Call,
  ix: i32,
  cfn: Node,
  params: i32[],
  dParams: i32[],
  args0: i32[],
  ok: boolean[],
): i32[] {
  let args = args0
  // A rest parameter is the one thing that makes the accepted arity unbounded above, and the
  // pack below is what puts it back: after it the argument list is index-parallel with the
  // parameter list again, which is the invariant everything from here down is written around.
  let restIx = -1
  if dParams.length == params.length { restIx = restParamIndex(dParams) }
  if restIx >= 0 {
    if !callIsRestPacked(ix) {
      const lo = restRequiredArity(dParams, restIx)
      if args.length < lo {
        tErr(
          "wrong number of arguments: expected at least "
            + i32ToStr(lo)
            + ", got "
            + i32ToStr(args.length),
          ix,
        )
        return args
      }
      if !restCallPack(n, ix, restIx) { return args }
    }
    args = n.callArgs
    // Written type arguments already say what the element is, which is the refusal's remedy.
    if restIx < args.length && !callHasTyArgs(ix) {
      if restHoleUnionErr(params[restIx], args[restIx], ix) { return args }
    }
  } else if hasSpreadItem(args) {
    tErr(spreadNoRestMsg(calleeIdentName(cfn)), ix)
    return args
  }
  let required = params.length
  if dParams.length == params.length { required = fnRequiredArity(dParams) }
  if args.length < required || args.length > params.length {
    tErr(
      "wrong number of arguments: expected "
        + arityWantText(required, params.length)
        + ", got "
        + i32ToStr(args.length)
        + tyArgReadHintIfAny(args)
        + ovPlainHint(ix),
      ix,
    )
    return args
  }
  // Named arguments bind to parameters by name, then positionally — source order is
  // irrelevant for named args. `TyFunc` carries no parameter names, so the names resolve
  // against the declaration the scope chain gives this callee; a closure-valued binding has
  // none and cannot take named arguments, whatever a same-named declaration says (D1604).
  if hasNamedArgs(n.callArgNames) {
    const cNames = paramNamesOfNodes(dParams)
    if cNames.length != params.length {
      tErr(
        "named arguments work only on declared functions, not on a function value",
        ix,
      )
      return args
    }
    args = orderNamedCallArgs(cNames, args, n.callArgNames, ix, dParams)
    if args.length != params.length { return args }
  } else if args.length < params.length {
    // Trailing positional omission: check the defaults against their
    // parameters alongside the supplied arguments, so one loop below covers
    // the whole parameter list. (`args` is rebound to a COPY — `n.callArgs`
    // stays the source list; the emit-side normalization is `emit_rewrite`'s.)
    const padded: i32[] = []
    let pj = 0
    while pj < params.length {
      if pj < args.length { padded.push(args[pj]) } else { padded.push(-1) }
      pj = pj + 1
    }
    if fillArgDefaults(padded, dParams, ix) >= 0 { return args }
    args = padded
  }
  ok[0] = true
  args
}

// Arguments whose turn met a type parameter no earlier argument bound, asked again once every
// argument has bound what it can; a parameter that only a hole reaches under a list binds to
// that hole's element, so `g(a, b)` at `T[]` holds `b` to `a`'s instance (D6502).
function callFtyNoteLateArgCstrs(
  cfn: Node,
  params: i32[],
  args: i32[],
  argExp: i32[],
  bNames: string[],
  bTys: i32[],
  hNames: string[],
  hTys: i32[],
) {
  const hSrc: i32[] = []
  let i = 0
  while i < args.length && i < params.length {
    if argExp[i] >= 0 && tyHasTyVar(argExp[i]) {
      const hb: HoleBinds = { names: hNames, tys: hTys, src: hSrc, arg: i }
      bindHoleElemWalk(params[i], nodeTyOf(args[i]), bNames, bTys, hb, 0)
    }
    i = i + 1
  }
  let li = 0
  while li < args.length && li < params.length {
    if argExp[li] >= 0 && tyHasTyVar(argExp[li]) {
      const hb: HoleBinds = { names: hNames, tys: hTys, src: hSrc, arg: li }
      noteLateArgCstr(cfn, params[li], args[li], argExp[li], bNames, bTys, hb)
    }
    li = li + 1
  }
}

// The type-parameter bindings `bindHoleElemWalk` makes from hole arguments, each with the
// argument that supplied it; `arg` is the argument being walked or asked.
type HoleBinds = { names: string[], tys: i32[], src: i32[], arg: i32 }

// Argument `arg` of type parameter `param` asked at the final bindings, leaving out the hole
// bindings it supplied itself; nothing is noted when that changes nothing it met.
function noteLateArgCstr(
  cfn: Node,
  param: i32,
  arg: i32,
  exp: i32,
  bNames: string[],
  bTys: i32[],
  hb: HoleBinds,
) {
  let at = inferRetTyOf(arg, nodeTyOf(arg))
  if coalDefHole.length > 0 { at = coalPinTy(arg, at) }
  if !tyIsHole(at) && !tyIsDeclaredParam(at) { return 0 }
  const names: string[] = []
  const tys: i32[] = []
  let k = 0
  while k < bNames.length {
    names.push(bNames[k])
    tys.push(bTys[k])
    k = k + 1
  }
  k = 0
  while k < hb.names.length {
    if hb.src[k] != hb.arg {
      names.push(hb.names[k])
      tys.push(hb.tys[k])
    }
    k = k + 1
  }
  const fin = substTyDeep(param, names, tys)
  if fin < 0 || tyIsHole(fin) || tyEqSameHoles(fin, exp) { return 0 }
  let who = ""
  if cfn is Ident { who = cfn.identName }
  noteArgCstr(at, fin, who, ACF_PLAIN, -1)
}

// Binds each type parameter `exp` holds under a list, and no binding set has yet, to the
// element of the hole or type parameter `at` holds there, minted as a derived hole. Walks list
// shapes only; a bare parameter is the ordinary walk's (`bindGenWalk`).
function bindHoleElemWalk(
  exp: i32,
  at: i32,
  bNames: string[],
  bTys: i32[],
  hb: HoleBinds,
  depth: i32,
) {
  if (
    exp < 0
    || at < 0
    || exp >= T.tys.length
    || at >= T.tys.length
    || depth > 8
  ) {
    return 0
  }
  const e = T.tys[exp]
  if e is TyVar {
    if depth == 0 { return 0 }
    if bindOf(bNames, bTys, e.tvName) >= 0 { return 0 }
    if bindOf(hb.names, hb.tys, e.tvName) >= 0 { return 0 }
    hb.names.push(e.tvName)
    hb.tys.push(at)
    hb.src.push(hb.arg)
    return 0
  }
  const el = tyArrayElemIx(exp)
  if el < 0 { return 0 }
  const ael = tyArrayElemIx(at)
  if ael >= 0 { return bindHoleElemWalk(el, ael, bNames, bTys, hb, depth + 1) }
  if !(T.tys[at] is TyVar) { return 0 }
  const elemHole = mkDerivedHole(HD_ELEM, "", -1, -1, at)
  bindHoleElemWalk(el, elemHole, bNames, bTys, hb, depth + 1)
}

// Whether an argument and the callee parameter `param` it meets hold type parameters that an
// instance may bind apart; a hole callee's parameter is no type parameter of its own, so a
// function value called on its own result keeps its instances (D6251, D6482).
function argParamsApart(at: i32, exp: i32, param: i32): boolean {
  (!tyIsHole(param) || tyIsDeclaredParam(param))
    && (tyParamsApart(at, exp) || tyArithMeetsParam(at, exp))
}

// Argument `i` of an ordinary call: seeded from its parameter under the bindings so far,
// checked, and bound into `bNames`/`bTys` and `uNames`/`uTys`, its expected type kept in
// `argExp[i]`. -1 to go on; otherwise the call's own answer (a handled template hole, or
// `TY_ERR` for a void argument at a generic parameter).
function callFtyCheckArg(
  n: Call,
  ix: i32,
  cfn: Node,
  params: i32[],
  dParams: i32[],
  args: i32[],
  i: i32,
  bNames: string[],
  bTys: i32[],
  uNames: string[],
  uTys: i32[],
  argExp: i32[],
): i32 {
  // Contextual param inference for a function-value argument: propagates the expected
  // param type into it so an un-annotated literal param infers from the signature
  // (matching `.map`/`.filter`), substituting type-param bindings from earlier arguments
  // first — `mapArr(xs: T[], f: (T) => R)` called with `[1,2,3]` binds `T = i32` before seeding `f`'s param as `i32`.
  const seedTy = callFtyArgSeedTy(cfn, params, args, i, bNames, bTys)
  seedExpected(args[i], seedTy)
  if tpEnvNames.length > 0 { tpIfMarkOk(args[i]) }
  const at = checkNodeHook(args[i])
  // A template hole meeting its injected renderer. This line is the first
  // moment the hole's type exists, which is why the type-directed half of
  // the template lowering lives here and not in the parser's desugar.
  if nodeIsTplHole(args[i]) {
    if tplHoleHandled(ix, n.pos, args[i], at, params[i]) { return TY_STR }
  }
  // A hole lambda handed by name to a hole the callee never reads takes D5934's default (D6112).
  if tyIsHole(seedTy) && !(P.nodes[parenPeelIx(args[i])] is FuncDecl) {
    const nl = holeLambdaNodeOf(at)
    if nl >= 0 {
      let owner = -1
      if cfn is Ident { owner = fnDeclIx[cfn.identName] ?? -1 }
      if holeParamUse(cfn, owner, params[i], i) == 1 {
        noteHoleArgNamed(ix, nl)
      }
    }
  }
  // A void argument would bind a type parameter to `void`, which no instance can carry; a
  // concrete parameter already refuses it through `assignable`, with its own message.
  if tyHasTyVar(params[i]) || tyIsHole(params[i]) {
    if isVoidTy(at) && !voidSlotExemptExpr(args[i]) {
      tErr(
        "argument " + i32ToStr(i + 1) + " expects a value, got void",
        args[i],
      )
      return TY_ERR
    }
  }
  // Bind every TyVar reachable in the expected param position from the
  // argument's shape (first use wins), then check the argument against the
  // SUBSTITUTED expected type — a later disagreeing use errors here.
  bindGenWalk(params[i], at, bNames, bTys)
  bindGenUnionArm(params[i], at, uNames, uTys)
  if tyHasTyVar(params[i]) || tyIsHole(params[i]) {
    checkFnValueRetTyParamBound(args[i], at)
  }
  const expected = substTyDeep(params[i], bNames, bTys)
  argExp[i] = expected
  // A `u8[]` argument meeting a generic parameter: `bindGenWalk` above declined to bind
  // `T` to storage type `u8`, so `expected` still carries the unsolved hole and
  // `assignable` answers true vacuously — needing its own message here, or the
  // monomorphizer builds i32-list machinery over a one-byte backing. `u8[]` is not an instantiation of `T[]`, since `T` ranges over value types and `u8` is storage.
  if !inferQuiet {
    if tyIsU8ArrayTy(at) && tyReachesHole(expected, 8) {
      tErr(
        "`u8[]` cannot be passed to a generic parameter — `u8` is a storage type, so a type parameter never binds it and a `u8[]` is not a `T[]`",
        args[i],
      )
    }
  }
  callFtyNoteArgCstr(cfn, args, i, at, expected, params[i])
  callFtyHoleParamDemands(n, cfn, params, dParams, args, i, at)
  // The cast this argument itself is (`id(a as? i32)`), whose destination the pin has to
  // re-ask (D1371) — but only when the parameter is not a hole: for a hole parameter,
  // `expected` is the pre-pin answer rather than a declared demand, and holding the cast to it would refuse a program whose annotated twin runs.
  if !tyIsHole(params[i]) { noteCastArgDest(args[i], i + 1, expected) }
  // Passing an empty-collection argument into a concrete `T[]` / map param pins
  // its element type from the param (`len(empty)` resolves `empty` to `i32[]`),
  // clearing its uninferred floor — pure downstream-usage inference, no push.
  constrainEmptyExpr(args[i], at, expected)
  callFtyArgAssign(n, params, args, i, at, expected)
  -1
}

// The type argument `i` of an ordinary call is seeded with: its parameter under the bindings
// so far, or for a lambda at a hole the function type the callee's body hands it to (D5842).
function callFtyArgSeedTy(
  cfn: Node,
  params: i32[],
  args: i32[],
  i: i32,
  bNames: string[],
  bTys: i32[],
): i32 {
  let seedTy = substTyDeep(params[i], bNames, bTys)
  if tyIsHole(seedTy) && P.nodes[parenPeelIx(args[i])] is FuncDecl {
    let owner = -1
    if cfn is Ident { owner = fnDeclIx[cfn.identName] ?? -1 }
    const hs = holeLambdaSeedTy(owner, params[i], bNames, bTys)
    if hs >= 0 { seedTy = hs }
    // One the body hands on to a hole of the caller's is pinned with that hole (D5881); one it
    // calls, or never reads, is instanced at this call's pin (`pinHoleLambdaVals`).
    const lx = parenPeelIx(args[i])
    if hs < 0 && !isValBindLambda(lx) {
      if holeLambdaDefers(owner, params[i], bNames, bTys) {
        noteValBindLambda(lx)
      } else {
        const how = holeParamUse(cfn, owner, params[i], i)
        if how >= 0 {
          noteValBindLambda(lx)
          noteHoleArgLambda(lx, how)
        }
      }
    }
  }
  seedTy
}

// The constraint argument `i` of type `at` leaves for the pin to re-validate against
// `expected`: a hole, deferred-join or gradual-union argument, or a composite one. `param`
// is the callee's own parameter type the argument meets.
function callFtyNoteArgCstr(
  cfn: Node,
  args: i32[],
  i: i32,
  at: i32,
  expected: i32,
  param: i32,
) {
  // A hole or deferred-join argument passes `assignable` vacuously, so the demand is
  // recorded here and re-validated at the generic call site that pins it under the
  // substituted argument types — without this, `function f(x) { g(x) }` with `g(n: i32)`
  // type-checks `f("s")` clean and dies at wasm validation. Recorded on the argument's uncollapsed type, since a join's collapsed arm can later prove unreachable.
  let atCstr = inferRetTyOf(args[i], at)
  if coalDefHole.length > 0 { atCstr = coalPinTy(args[i], atCstr) }
  if (
    tyIsHole(atCstr)
    || tyIsDeferredJoin(atCstr)
    || (atCstr >= 0
      && atCstr < T.tys.length
      && T.tys[atCstr] is TyUnion
      && tpGradualView(atCstr) != atCstr)
  ) {
    if !tyIsHole(expected) || argParamsApart(atCstr, expected, param) {
      let ccWho = ""
      if cfn is Ident { ccWho = cfn.identName }
      let acForm = ACF_PLAIN
      if nodeIsTplHole(args[i]) { acForm = ACF_TPL }
      noteArgCstr(atCstr, expected, ccWho, acForm, -1)
    }
  } else if (
    compArgCstrOk(atCstr, expected)
    || argParamsApart(atCstr, expected, param)
  ) {
    let cpWho = ""
    if cfn is Ident { cpWho = cfn.identName }
    noteArgCstr(atCstr, expected, cpWho, ACF_COMP, args[i])
  }
}

// The demands a hole parameter's body made, asked of argument `i` of type `at`: its fields,
// an index or a write, and the `as` cast parked on the hole.
function callFtyHoleParamDemands(
  n: Call,
  cfn: Node,
  params: i32[],
  dParams: i32[],
  args: i32[],
  i: i32,
  at: i32,
) {
  // A hole param whose body DEMANDED fields (member access on the hole)
  // checks the argument against the demanded shape, so `getx(5)` rejects
  // when the body read `o.x` (host: the grown `Infer<{x,…}>` pin).
  const pHole = T.tys[params[i]]
  if pHole is TyVar {
    noteHoleArgNullRead(pHole.tvName, at, args[i])
    if !holeDemandOk(pHole.tvName, args[i], at) {
      holeArgDemandErr(pHole.tvName, i + 1, at, args[i])
    }
    // A hole the body INDEXED (`self[i]`) demands an array — a scalar argument can't be
    // indexed, so reject it here (`head(5)`) instead of deferring to an emit failure.
    if rowIsArrayDemanded(params[i]) {
      if tyRefusesArrayDemand(at) { holeArgArrayErr(i + 1, at, args[i]) }
      // An enclosing type parameter passed in takes the demand to its own pin.
      if at >= 0 && T.tys[at] is TyVar { noteArrayDemand(arrayDemandKey(at)) }
    }
    if holeIsArrayWriteDemanded(calleeIdentName(cfn), pHole.tvName) {
      if tyIxIsView(at) { holeArgViewErr(i + 1, at, args[i]) }
      if tyRefusesArrayWrite(at) { holeArgArrayErr(i + 1, at, args[i]) }
      // A hole of the caller's handed in is written by it too, so its own callers are asked.
      if at >= 0 && at < T.tys.length {
        const aw = T.tys[at]
        if aw is TyVar { noteArrayWriteDemand(aw.tvName) }
      }
    }
    // The `as` cast the body parked on this hole, re-asked under the argument. D1342.
    holeCastPinCheck(
      pHole.tvName,
      at,
      holeCastParamName(n.callFn, dParams, i, pHole.tvName),
    )
  }
}

// Argument `i` delivered to `expected` under the generic-argument and wider-record flags,
// a mismatch refused at the argument, and a passing hole-bearing function value parked (D1821).
function callFtyArgAssign(
  n: Call,
  params: i32[],
  args: i32[],
  i: i32,
  at: i32,
  expected: i32,
) {
  const savedGenArg = widenRetagGenArg
  widenRetagGenArgSet(tyWideUnionMinted && tyHasTyVar(params[i]))
  const savedLbiGen = lbiNoDest
  lbiNoDest = tyHasTyVar(params[i])
  // A wider record into a declared record parameter: a parameter already made generic is
  // still held to its declared type, and a new one is made generic after this pass (D3992).
  const wsOrig = wsOrigTyOf(n, i)
  if wsOrig >= 0 && i < args.length && args[i] >= 0 && !tyHasTyVar(at) {
    wsSuppress = true
    const savedOrigLit = argLitAt
    argLitAt = peelParenIx(args[i])
    const wsOk = assignableExpr(args[i], at, wsOrig)
    argLitAt = savedOrigLit
    wsSuppress = false
    if !wsOk { argMismatchErr(i + 1, wsOrig, at, args[i]) }
  }
  const wsNew = wsOrig < 0
    && !inferQuiet
    && i < args.length
    && wsCandidate(n, i, args[i], at, expected)
  if wsNew { wsNotePending(n, i) }
  wsSuppress = wsNew
  const savedArgLit = argLitAt
  argLitAt = peelParenIx(args[i])
  const argOk = assignableExpr(args[i], at, expected)
  argLitAt = savedArgLit
  wsSuppress = false
  lbiNoDest = savedLbiGen
  widenRetagGenArgSet(savedGenArg)
  if !argOk {
    // Anchored at the offending argument (or its offending return site),
    // never at the call node — see `argMismatchErr`.
    argMismatchErr(i + 1, expected, at, args[i])
  } else if !tyIsHole(params[i]) {
    // A hole passes any comparison, so the argument is parked and re-asked once the hole is
    // pinned (D1821). A generic's own signature, declared or un-annotated, is bound by this
    // delivery, not by a pin a direct call elsewhere gives it.
    if tyHasTyVar(at) && tyIsFuncArena(expected) {
      if (
        !argIsOwnGenericFnValue(args[i])
        && !tyIsForeignGenericSig(at)
        && !tyIsHoleGenericSig(at)
      ) {
        argPinPark(expected, at, args[i], i + 1)
      }
    }
  }
}

// The pins an ordinary call's type-parameter bindings `vNames`/`vTys` give its callee: every
// constraint the body deferred is validated under them, the declared bounds are judged, and
// the substituted return is answered (`retTy0` with the bindings applied).
function callFtyPinCstrs(
  n: Call,
  ix: i32,
  cfn: Node,
  ft: TyFunc,
  params: i32[],
  args: i32[],
  bNames: string[],
  bTys: i32[],
  vNames: string[],
  vTys: i32[],
  retTy0: i32,
): i32 {
  let retTy = retTy0
  const dBeforeC = T.diags.length
  let cstrCallee = CSTR_NODECL
  let cstrWho = ""
  if cfn is Ident {
    cstrCallee = fnDeclIx[cfn.identName] ?? CSTR_NODECL
    // A local bound to a declared generic names that declaration — without this rung the
    // call falls to `CSTR_NODECL` and adjudicates every generic in the program, since
    // `substTyDeep` matches `TyVar`s by name and `const g = idT  g(structList)` would
    // otherwise report a sibling's refusal.
    if cstrCallee == CSTR_NODECL {
      const aliasIx = lookupFnAliasNode(cfn.identName)
      if aliasIx >= 0 { cstrCallee = aliasIx }
    }
    cstrWho = cfn.identName
  }
  // The direct spelling has no receiver, so every parameter is an argument (`selfOff` 0)
  // and `params`/`args` are already 1:1 (named arguments reordered, defaults padded).
  const dhNames: string[] = []
  const dhArgNo: i32[] = []
  const dhArgNode: i32[] = []
  holeArgOrigins(params, args, 0, dhNames, dhArgNo, dhArgNode)
  const modeWas = substNestMode
  const declWas = substNestDecl
  let nestCallee = -1
  let namedFn = -1
  if cfn is Ident {
    // The declaration the callee names, directly or through an alias.
    namedFn = lookupFnDeclNode(cfn.identName)
    if namedFn < 0 { namedFn = lookupFnAliasNode(cfn.identName) }
    if nestParentOf.has(namedFn) { nestCallee = namedFn }
  }
  if nestCallee >= 0 {
    // A nested generic, named directly or through an alias, owns no constraint: they are its
    // enclosing function's, and a top-level function of the same name is another declaration.
    cstrCallee = CSTR_NODECL
    substNestModeSet(SUBST_NESTED)
    substNestDeclSet(nestCallee)
  } else if cstrCallee >= 0 {
    substNestModeSet(SUBST_DECLARED)
  } else if namesAllHoles(vNames) && tysHoldVar(vTys) {
    substNestModeSet(SUBST_HOLES)
  } else {
    substNestModeSet(SUBST_ALL)
  }
  const wsVd = T.diags.length
  adoptHoleLitArgs(vNames, vTys, cstrCallee, dhNames, dhArgNode)
  let opFn = cstrCallee
  if opFn < 0 { opFn = namedFn }
  const holeArgs = dhNames.length > 0
  if opFn < 0 && holeArgs { opFn = constLambdaOf(cfn, n.callFn) }
  let fnValue = ""
  if opFn < 0 && holeArgs { fnValue = calleeReassignedFnValue(cfn, n.callFn) }
  const noSplit = hasNamedArgs(n.callArgNames)
    || callLeavesDefault(n, cstrCallee)
  judgeFnArgHoleCalls(
    vNames,
    vTys,
    cstrCallee,
    opFn,
    fnValue,
    cstrWho,
    dhNames,
    dhArgNode,
    noSplit,
  )
  instGenFnHolePins(vNames, vTys, cstrCallee)
  pinUnreadGenFnArgs(vNames, vTys, cstrCallee, dhNames, dhArgNode)
  pinHoleLambdaVals(vNames, vTys, ix, cstrCallee, opFn, noSplit)
  if fsbName.length > 0 {
    fsbGenFnHolePins(fsbDeclAtNode(n.callFn), vNames, vTys, cstrCallee)
  }
  callBindNote(ix, vNames, vTys)
  pinBmCstrElems(vNames, vTys, ix, cstrCallee, args)
  if fsbName.length > 0 {
    fsbNoteCall(
      ix,
      fsbDeclAtNode(n.callFn),
      cstrCallee,
      cstrWho,
      dhNames,
      dhArgNo,
      dhArgNode,
      fsbArgTysOf(ft, vNames, vTys),
    )
  }
  validateBinCstrs(
    vNames,
    vTys,
    ix,
    cstrCallee,
    cstrWho,
    dhNames,
    dhArgNo,
    dhArgNode,
  )
  validatePrintCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
  validateNestCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
  validateIsCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
  validateArgCstrs(vNames, vTys, ix, cstrCallee, dhNames, dhArgNode)
  // The declared return rides the same pin: the body's mismatch check is vacuous under
  // a hole, and this is the first position that knows the instance (D551).
  validateRetCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
  // The destination seam, for the same reason: a value landing in a hole-typed local /
  // field / element inside the body is a mismatch the body's own gate cannot decide (D572).
  validateLetCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
  // A builtin collection method's argument inside the body, for the same reason at a
  // callee kind the deferred-argument table cannot name: a builtin has no `FuncDecl`, so its own arm is the whole check and is vacuous under a hole (D582).
  validateBmCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
  // After the pins above, which can leave an argument's element open (`cnhPinBmElem`).
  if !inferQuiet {
    let oa = 0
    while oa < args.length {
      refuseOpenNullHoleArg(args[oa], cstrWho)
      oa = oa + 1
    }
  }
  // The receiver classification of a `.length` / `x[i]` inside the body: both arms admit
  // the operation on a type variable correctly (a `T` pinned to a collection has it), and
  // this is the first position that knows which rep `T` became (D651 / D691).
  validateMemCstrs(
    vNames,
    vTys,
    ix,
    cstrCallee,
    cstrWho,
    dhNames,
    dhArgNo,
    dhArgNode,
  )
  validateUfcsCstrs(vNames, vTys, ix, cstrCallee, cstrWho)
  pinHoleLambdaArgs(vNames, vTys, ix, cstrCallee)
  validateRcwPins(vNames, vTys, cstrCallee)
  if T.diags.length > wsVd { wsNoteInstErr(cstrCallee) }
  substNestModeSet(modeWas)
  substNestDeclSet(declWas)
  // Not a validation: the `??` result holes are substituted here for their BANK, which is
  // the only route the emitter has to the type this call gave the expression (D1702).
  if bNames.length > 0 { bankCoalHoles(bNames, bTys, cstrCallee) }
  // The bounds the callee declared, judged here in this site's own scope against the
  // types this site bound — not deferred, since a bound is written at the declaration:
  // there is nothing to record on the way in, only something to check on the way out.
  checkBoundsAtCall(cstrWho, cstrCallee, bNames, bTys, ix)
  // The escaped-join reject is a fallback, not an additional voice: when this site
  // already reported a precise operand/argument-flow diagnostic, a join report would only repeat it in vaguer words.
  if T.diags.length == dBeforeC && bNames.length > 0 {
    validateEscJoins(bNames, bTys, cstrCallee)
  }
  retTy = substTyDeep(retTy, vNames, vTys)
  if tyHasTyVar(retTy) {
    const hr = holeRetTyOf(cstrCallee, vNames, vTys)
    if hr >= 0 { retTy = hr }
  }
  if tyHasTyVar(retTy) {
    retTy = holeFnArgRetAt(args, params, vNames, vTys, retTy)
  }
  // A call of a call result, a list element or a record field runs what that call, element or
  // field may hold (D9008, D9060).
  if (
    cfn is Call
    || cfn is Index
    || cfn is Member
    || cfn is OptMember
    || (cfn is Ident && holeFnArgDecls(n.callFn).length > 1)
    || (cfn is Ident && holeFnReadsSlot(n.callFn))
  ) {
    const pts: i32[] = []
    for a in args { pts.push(substTyDeep(nodeTyOf(a), vNames, vTys)) }
    holeLetWritesDisagree(n.callFn, pts)
  }
  if cfn is Ident {
    let hd = namedFn
    if hd < 0 { hd = constLambdaOf(cfn, n.callFn) }
    retTy = directHoleBodyRet(n, hd, vNames, vTys, retTy)
    // A fallback like the join reject above: an operand refusal already names this call.
    const mis = genericDeclRetMisfit(hd, vNames, vTys, retTy)
    if mis >= 0 && T.diags.length == dBeforeC {
      tErr(
        "`"
          + cfn.identName
          + "` returns "
          + tyToStr(mis)
          + " at this call's types, which its declared result "
          + tyToStr(retTy)
          + " cannot hold — the conversion is lossy and must be made explicit with `as`",
        ix,
      )
    }
  }
  if tpIfFn.length > 0 || tpIfReFn.length > 0 {
    const pinTys: i32[] = []
    let pp = 0
    while pp < params.length {
      pinTys.push(substTyDeep(params[pp], vNames, vTys))
      pp = pp + 1
    }
    validateTpIfJoins(vNames, vTys, pinTys, retTy, ix, cstrCallee)
  }
  retTy
}

// A lambda literal handed to a hole callee is pinned where the call binds that callee: its
// parameter holes take the parameter types of the function type it is delivered at, and its
// body's deferred demands are judged there, as a direct call through it would be (D5881).
function pinHoleLambdaArgs(
  vNames: string[],
  vTys: i32[],
  ix: i32,
  calleeFn: i32,
) {
  const done: string[] = []
  const n0 = argCstr.at.length
  let ci = 0
  while ci < n0 {
    if argCstr.form[ci] > 0 && cstrOwnedBy(argCstr.fn[ci], calleeFn) {
      pinHoleLambdaArg(ci, vNames, vTys, ix, done)
    }
    ci = ci + 1
  }
  0
}

// `pinHoleLambdaArgs` for demand `ci`; `done` holds the lambda holes already judged.
function pinHoleLambdaArg(
  ci: i32,
  vNames: string[],
  vTys: i32[],
  ix: i32,
  done: string[],
) {
  const rat = substTyDeep(argCstr.at[ci], vNames, vTys)
  const rexp = substTyDeep(argCstr.exp[ci], vNames, vTys)
  if rat < 0 || rexp < 0 || tyHasHole(rexp) { return 0 }
  const lf = T.tys[rat]
  const df = T.tys[rexp]
  if !(lf is TyFunc) || !(df is TyFunc) { return 0 }
  if lf.fnParamTypes.length != df.fnParamTypes.length { return 0 }
  const nm: string[] = []
  const ty: i32[] = []
  for v in vNames { nm.push(v) }
  for t in vTys { ty.push(t) }
  let fresh = 0
  let pi = 0
  while pi < lf.fnParamTypes.length {
    const pv = T.tys[lf.fnParamTypes[pi]]
    if pv is TyVar {
      if tyIsHole(lf.fnParamTypes[pi]) && pv.tvName.slice(0, 3) == "?#L" {
        if !strListHas(done, pv.tvName) {
          done.push(pv.tvName)
          fresh = fresh + 1
        }
        nm.push(pv.tvName)
        ty.push(df.fnParamTypes[pi])
      }
    }
    pi = pi + 1
  }
  if fresh == 0 { return 0 }
  judgeHoleLambdaAt(rat, rexp, nm, ty, ix)
}

// A lambda typed `lam` with hole parameters, delivered at the concrete function type `want`
// with its holes bound in `nm`/`ty`: its body's demands are judged at that type.
function judgeHoleLambdaAt(
  lam: i32,
  want: i32,
  nm: string[],
  ty: i32[],
  ix: i32,
) {
  const d0 = T.diags.length
  holeFnDeliveryDemands(lam, want, ix, "this lambda")
  if T.diags.length > d0 { return 0 }
  const none: string[] = []
  const noNo: i32[] = []
  const noNode: i32[] = []
  const modeWas = substNestMode
  substNestModeSet(SUBST_ALL)
  validateBinCstrs(nm, ty, ix, CSTR_NODECL, "", none, noNo, noNode)
  validatePrintCstrs(nm, ty, ix, CSTR_NODECL, "")
  validateIsCstrs(nm, ty, ix, CSTR_NODECL, "")
  validateArgCstrs(nm, ty, ix, CSTR_NODECL, none, noNode)
  validateRetCstrs(nm, ty, ix, CSTR_NODECL, "")
  validateLetCstrs(nm, ty, ix, CSTR_NODECL, "")
  validateBmCstrs(nm, ty, ix, CSTR_NODECL, "")
  validateMemCstrs(nm, ty, ix, CSTR_NODECL, "", none, noNo, noNode)
  validateUfcsCstrs(nm, ty, ix, CSTR_NODECL, "")
  substNestModeSet(modeWas)
  0
}

// A hole-generic function delivered to a hole of a marked written binding takes the instance the
// calls its written lambdas make on that hole, so mono pins it rather than refusing (D5933).
function fsbGenFnHolePins(
  decl: i32,
  vNames: string[],
  vTys: i32[],
  calleeFn: i32,
) {
  if decl < 0 { return 0 }
  const mode = substNestMode
  if mode == SUBST_HOLES { substNestModeSet(SUBST_DECLARED) }
  let k = 0
  while k < vNames.length {
    const vt = vTys[k]
    if !tyIsForeignGenericSig(vt) && tyIsHoleGenericSig(vt) {
      const own = genFnHoleInstance(vNames, vTys, k, vt, calleeFn)
      if own >= 0 { vTys[k] = own }
    }
    k = k + 1
  }
  substNestModeSet(mode)
  0
}

// How the callee's body uses its hole parameter `holeTy`, the `i`th: 0 when it calls it, 1 when
// it never reads it, -1 otherwise or for a callee with no declaration in reach.
function holeParamUse(cfn: Node, owner: i32, holeTy: i32, i: i32): i32 {
  if holeTy < 0 || !tyIsHole(holeTy) { return -1 }
  const hv = T.tys[holeTy]
  if !(hv is TyVar) { return -1 }
  let decl = owner
  if decl < 0 && cfn is Ident { decl = lookupFnAliasNode(cfn.identName) }
  let scope = CSTR_NODECL
  if owner >= 0 { scope = owner }
  if genFnHoleCalled(hv.tvName, scope) { return 0 }
  if decl < 0 || decl >= P.nodes.length { return -1 }
  const dn = P.nodes[decl]
  if !(dn is FuncDecl) || i < 0 || i >= dn.fnParams.length { return -1 }
  const pn = P.nodes[dn.fnParams[i]]
  if !(pn is Param) || pn.parRest != 0 { return -1 }
  if !holeParamUnreadIn(decl, i, 0) { return -1 }
  1
}

// How many declared functions a hole parameter is handed on through before it counts as read.
const HOLE_FWD_UNREAD_MAX = 8

// Whether function `decl`'s un-annotated `i`th parameter is never read, or only handed on bare
// to an un-annotated parameter of a declared function that never reads it, `depth` hops in (D6191).
function holeParamUnreadIn(decl: i32, i: i32, depth: i32): boolean {
  if decl < 0 || decl >= P.nodes.length || depth > HOLE_FWD_UNREAD_MAX {
    return false
  }
  const dn = P.nodes[decl]
  if !(dn is FuncDecl) || i < 0 || i >= dn.fnParams.length { return false }
  const pn = P.nodes[dn.fnParams[i]]
  if !(pn is Param) || pn.parRest != 0 || (depth > 0 && pn.parType >= 0) {
    return false
  }
  if !crSubtreeMentions(dn.fnBody, pn.parName) { return true }
  holeNameOnlyForwardedUnread(dn.fnBody, pn.parName, depth)
}

// Whether every read of `name` under `ix` is a bare positional argument of a call of a declared
// function whose parameter there is unread (`holeParamUnreadIn`).
function holeNameOnlyForwardedUnread(
  ix: i32,
  name: string,
  depth: i32,
): boolean {
  if ix < 0 || ix >= P.nodes.length { return true }
  const n = P.nodes[ix]
  if n is Ident { return n.identName != name }
  if n is FuncDecl {
    for p in n.fnParams {
      const pp = P.nodes[p]
      if pp is Param {
        if pp.parName == name { return false }
      }
    }
  }
  if n is Call {
    if n.callFn < 0 || n.callFn >= P.nodes.length { return false }
    const cf = P.nodes[n.callFn]
    let g = -1
    if cf is Ident { g = fnDeclIx[cf.identName] ?? -1 }
    const named = hasNamedArgs(n.callArgNames)
    if !holeNameOnlyForwardedUnread(n.callFn, name, depth) { return false }
    let j = 0
    while j < n.callArgs.length {
      const a = n.callArgs[j]
      const av = P.nodes[a]
      let fwd = false
      if av is Ident { fwd = av.identName == name }
      if fwd {
        if g < 0 || named || !holeParamUnreadIn(g, j, depth + 1) {
          return false
        }
      } else if !holeNameOnlyForwardedUnread(a, name, depth) {
        return false
      }
      j = j + 1
    }
    return true
  }
  for c in nodeChildren(ix) {
    if !holeNameOnlyForwardedUnread(c, name, depth) { return false }
  }
  true
}

// A function named as an argument to a hole the callee calls is judged at each instance those
// calls ask for (D6190); two mark the parameter for a split unless `noSplit` (D6280), and refuse
// when callee `fnVia` reads reassigned binding `fnValue`. `opFn` is the callee body whose
// operators are judged (D6330).
function judgeFnArgHoleCalls(
  vNames: string[],
  vTys: i32[],
  calleeFn: i32,
  opFn: i32,
  fnValue: string,
  fnVia: string,
  dhNames: string[],
  dhArgNode: i32[],
  noSplit: boolean,
) {
  if inferQuiet { return 0 }
  // Read under the other holes' own instances, so a call taking another hole parameter's
  // result asks for its own instance (D6250).
  const wTys: i32[] = []
  let j = 0
  while j < dhNames.length {
    const a = parenPeelIx(dhArgNode[j])
    if a < 0 || a >= P.nodes.length {
      j = j + 1
      continue
    }
    const an = P.nodes[a]
    if (an is Ident && holeFnArgDecls(a).length > 1) || holeFnReadsSlot(a) {
      // A re-pointed `let` or a list element or field handed to a hole the body calls is judged
      // at each call's argument types under this call's bindings (D9009, D9090).
      const k = strListIndexOf(vNames, dhNames[j])
      if k >= 0 {
        if wTys.length == 0 {
          for t in vTys { wTys.push(t) }
          instGenFnHolePins(vNames, wTys, calleeFn)
        }
        const linsts: i32[] = []
        genFnHoleCallInsts(vNames, wTys, k, vTys[k], calleeFn, linsts)
        // Calls moved out of a forwarding call are judged at the one instance they all ask.
        const sole = genFnHoleSoleInst(vNames, wTys, k, vTys[k], calleeFn)
        if sole >= 0 { linsts.push(sole) }
        for li in linsts {
          const lf = T.tys[li]
          if lf is TyFunc && holeLetWritesDisagree(a, lf.fnParamTypes) {
            return 0
          }
        }
      }
    }
    let gNames: string[] = []
    if an is Ident {
      gNames = [an.identName]
    } else {
      gNames = constRetFnNames(a)
    }
    for gName in gNames {
      const d = fnDeclIx[gName] ?? -1
      if d >= 0 && d < P.nodes.length && P.nodes[d] is FuncDecl {
        const k = strListIndexOf(vNames, dhNames[j])
        if k >= 0 {
          if wTys.length == 0 {
            for t in vTys { wTys.push(t) }
            instGenFnHolePins(vNames, wTys, calleeFn)
          }
          const insts: i32[] = []
          genFnHoleCallInsts(vNames, wTys, k, vTys[k], calleeFn, insts)
          if insts.length > 1 && !noSplit { holeFnSplitAt(opFn, dhNames[j]) }
          if insts.length > 1 { judgeHoleCallOps(opFn, vNames, wTys, a) }
          const d0 = T.diags.length
          for inst in insts {
            if T.diags.length == d0 { genFnValueCstrs(a, nodeTyOf(a), inst) }
            if T.diags.length == d0 { holeDeclCstrsAt(a, d, nodeTyOf(a), inst) }
          }
          if insts.length > 1 && fnValue != "" && T.diags.length == d0 {
            reassignedFnValueErr(fnVia, fnValue, gName, a)
          }
        }
      }
    }
    j = j + 1
  }
  0
}

// Refuses, at argument `a`, generic function `fnName` handed through callee `via`, which reads
// reassigned binding `held`: a function value carries one signature, so a parameter its body
// calls at two types cannot take a generic function (D6351, D6421).
function reassignedFnValueErr(
  via: string,
  held: string,
  fnName: string,
  a: i32,
) {
  let what = "it is reassigned"
  if via != held { what = "it aliases `" + held + "`, which is reassigned" }
  tErr(
    "cannot pass the generic function `"
      + fnName
      + "` through `"
      + via
      + "`: "
      + what
      + ", so it holds a function value with one signature, and the parameter this argument meets is called at two types — call a `const` or a declared function, or pass a function of one type",
    a,
  )
}

// The declared functions the `return`s of non-generic function call `c` name bare, its last
// statement among them, so the call always evaluates to one of them (D9540, D9596); empty
// when a `return` is anything else.
function constRetFnNames(c: i32): string[] {
  const none: string[] = []
  const cn = P.nodes[c]
  if !(cn is Call) { return none }
  const f = P.nodes[parenPeelIx(cn.callFn)]
  if !(f is Ident) { return none }
  const fd = fnDeclIx[f.identName] ?? -1
  if fd < 0 || fd >= P.nodes.length { return none }
  const fnd = P.nodes[fd]
  if !(fnd is FuncDecl) || fnd.fnTyParams.length > 0 || fnd.fnBody < 0 {
    return none
  }
  const b = P.nodes[fnd.fnBody]
  if !(b is Block) || b.blkStmts.length == 0 { return none }
  if !(P.nodes[b.blkStmts[b.blkStmts.length - 1]] is RetStmt) { return none }
  const gs: string[] = []
  const stack: i32[] = [fnd.fnBody]
  while stack.length > 0 {
    const x = stack.pop() ?? -1
    const xn = P.nodes[x]
    if xn is RetStmt {
      if xn.retArg < 0 { return none }
      const a = P.nodes[parenPeelIx(xn.retArg)]
      if !(a is Ident) || (fnDeclIx[a.identName] ?? -1) < 0 { return none }
      if strListIndexOf(gs, a.identName) < 0 { gs.push(a.identName) }
    } else if !(xn is FuncDecl) {
      for k in nodeChildren(x) {
        if k >= 0 { stack.push(k) }
      }
    }
  }
  gs
}

// Marks the parameter of declared function `fn` whose hole is `hole` as wanting a copy per
// instance its body calls it at.
function holeFnSplitAt(fn: i32, hole: string) {
  if fn < 0 || fn >= P.nodes.length { return 0 }
  const f = P.nodes[fn]
  if !(f is FuncDecl) { return 0 }
  let pi = 0
  while pi < f.fnParams.length {
    if paramHoleName(f.fnName, fn, pi) == hole {
      holeFnSplitSet(f.fnParams[pi])
    }
    pi = pi + 1
  }
  0
}

// A lambda with hole parameters bound to a hole the callee's body calls is instanced at the
// arguments of those calls, as a generic function there is (`instGenFnHolePins`), and its
// body's demands are judged at that instance (D5935); `opFn` and `noSplit` as
// `judgeFnArgHoleCalls` takes them.
function pinHoleLambdaVals(
  vNames: string[],
  vTys: i32[],
  ix: i32,
  calleeFn: i32,
  opFn: i32,
  noSplit: boolean,
) {
  let k = 0
  while k < vNames.length {
    const vt = vTys[k]
    const lx = holeLambdaNodeOf(vt)
    if lx >= 0 {
      const how = holeArgLambdaHowOf(lx)
      let inst = genFnHoleInstance(vNames, vTys, k, vt, calleeFn)
      // One the body never reads is never called, so the default is unobservable (D5934),
      // whether it arrives as a literal or by name (D6112).
      const unread = how == 1 || (how < 0 && holeArgNamedAt(ix, lx))
      const dflt = inst == GEN_FN_HOLE_UNCALLED && unread
      if dflt {
        inst = holeLambdaDefault(vt, vNames, vTys, ix)
      } else if inst >= 0 {
        const nm: string[] = []
        const ty: i32[] = []
        for v in vNames { nm.push(v) }
        for t in vTys { ty.push(t) }
        holeLambdaBinds(vt, inst, nm, ty)
        judgeHoleLambdaAt(vt, inst, nm, ty, ix)
      }
      if inst >= 0 {
        vTys[k] = inst
      } else if how >= 0 {
        if noSplit || !holeLambdaSplit(vNames, vTys, k, ix, calleeFn, opFn) {
          holeLambdaUninferable(lx)
        }
      } else {
        const insts: i32[] = []
        genFnHoleCallInsts(vNames, vTys, k, vt, calleeFn, insts)
        if insts.length > 1 { judgeHoleCallOps(opFn, vNames, vTys, ix) }
      }
    }
    k = k + 1
  }
  0
}

// A lambda literal handed to hole `vNames[k]`, which `opFn`'s body calls at several instances,
// is judged at each and the parameter marked for the split plan, which hands it one copy per
// instance (D6331). False when the calls ask for fewer than two.
function holeLambdaSplit(
  vNames: string[],
  vTys: i32[],
  k: i32,
  ix: i32,
  calleeFn: i32,
  opFn: i32,
): boolean {
  if opFn < 0 || k < 0 || k >= vTys.length { return false }
  const vt = vTys[k]
  const insts: i32[] = []
  genFnHoleCallInsts(vNames, vTys, k, vt, calleeFn, insts)
  if insts.length < 2 { return false }
  const d0 = T.diags.length
  judgeHoleCallOps(opFn, vNames, vTys, ix)
  for inst in insts {
    if T.diags.length == d0 {
      const nm: string[] = []
      const ty: i32[] = []
      for v in vNames { nm.push(v) }
      for t in vTys { ty.push(t) }
      holeLambdaBinds(vt, inst, nm, ty)
      judgeHoleLambdaAt(vt, inst, nm, ty, ix)
    }
  }
  holeFnSplitAt(opFn, vNames[k])
  true
}

// The lambda the callee name at `cfnIx` holds as its initializer, directly or through aliases:
// a `const`'s, or a `let`'s that is bound once and never assigned (D6351); -1 otherwise.
function constLambdaOf(cfn: Node, cfnIx: i32): i32 {
  if !(cfn is Ident) { return -1 }
  let f = -1
  const d = constDeclOf(cfn.identName)
  if d >= 0 && d < P.nodes.length {
    const l = P.nodes[d]
    if l is LetDecl && l.letInit >= 0 { f = parenPeelIx(l.letInit) }
  } else {
    f = cwLambdaDeclOf(cfn.identName, covarRootFrame(cfnIx))
  }
  // An alias, `const k = lap`, is followed to the binding it names.
  let hops = 0
  while f >= 0 && f < P.nodes.length && hops < 8 {
    const a = P.nodes[f]
    if !(a is Ident) { break }
    f = cwBoundInitOf(a.identName, covarRootFrame(f))
    hops = hops + 1
  }
  if f < 0 || f >= P.nodes.length { return -1 }
  const fn = P.nodes[f]
  if fn is FuncDecl && fn.fnName == "" { return f }
  -1
}

// The assigned binding the callee name at `cfnIx` reads, itself or through aliases bound once,
// so a call through it runs a function value whose one signature no copy of a body can split
// (D6351, D6421); "" when it reads none.
function calleeReassignedFnValue(cfn: Node, cfnIx: i32): string {
  if !(cfn is Ident) { return "" }
  let nm = cfn.identName
  let at = cfnIx
  let hops = 0
  while hops < 8 {
    const fr = covarRootFrame(at)
    if fr == CW_FR_UNKNOWN { return "" }
    if !cwBoundOnce(nm, fr) { return nm }
    const init = cwBoundInitOf(nm, fr)
    if init < 0 || init >= P.nodes.length { return "" }
    const a = P.nodes[init]
    if !(a is Ident) { return "" }
    nm = a.identName
    at = init
    hops = hops + 1
  }
  ""
}

// The lambda node whose parameter holes `ty` carries, -1 for a type with none.
function holeLambdaNodeOf(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  const f = T.tys[ty]
  if !(f is TyFunc) { return -1 }
  for p in f.fnParamTypes {
    const pv = T.tys[p]
    if pv is TyVar {
      if tyIsHole(p) && pv.tvName.slice(0, 3) == "?#L" {
        const dot = pv.tvName.indexOf(".")
        if dot > 3 { return weDigits(pv.tvName.slice(3, dot)) }
      }
    }
  }
  -1
}

// Whether call `n` of declared function `calleeFn` passes fewer arguments than it has parameters.
function callLeavesDefault(n: Call, calleeFn: i32): boolean {
  if calleeFn < 0 || calleeFn >= P.nodes.length { return false }
  const f = P.nodes[calleeFn]
  if f is FuncDecl { return n.callArgs.length < f.fnParams.length }
  false
}

// A declared generic handed by name to a parameter `calleeFn`'s body never reads is never called,
// so it takes the first unread default its body checks clean at, as a lambda does (D6213).
function pinUnreadGenFnArgs(
  vNames: string[],
  vTys: i32[],
  calleeFn: i32,
  dhNames: string[],
  dhArgNode: i32[],
) {
  if inferQuiet || calleeFn < 0 || calleeFn >= P.nodes.length { return 0 }
  if !(P.nodes[calleeFn] is FuncDecl) { return 0 }
  let j = 0
  while j < dhNames.length {
    const a = parenPeelIx(dhArgNode[j])
    const k = strListIndexOf(vNames, dhNames[j])
    if a >= 0 && a < P.nodes.length && k >= 0 {
      const an = P.nodes[a]
      let d = -1
      if an is Ident {
        // Named directly, or through a `const` alias of the declaration.
        d = fnDeclIx[an.identName] ?? lookupFnAliasNode(an.identName)
        if d >= 0 && !(P.nodes[d] is FuncDecl) { d = -1 }
      }
      const vt = vTys[k]
      const open = tyIsForeignGenericSig(vt) || tyIsHoleGenericSig(vt)
      if d >= 0 && open && holeParamUnreadAt(calleeFn, dhNames[j]) {
        let di = 0
        while di < UNREAD_HOLE_DEFAULTS {
          const inst = unreadHoleDefault(vt, di, false)
          if inst >= 0 {
            const d0 = T.diags.length
            const bNames: string[] = []
            const bTys: i32[] = []
            genFnValueCstrs(a, nodeTyOf(a), inst)
            if T.diags.length == d0 {
              holeDeclCstrsBind(a, d, nodeTyOf(a), inst, bNames, bTys)
            }
            const ok = T.diags.length == d0
            while T.diags.length > d0 { T.diags.pop() }
            // A result its parameters leave open is the one the body derives there.
            const at = substTyDeep(inst, bNames, bTys)
            if ok && at >= 0 && !tyHasTyVar(at) {
              vTys[k] = at
              di = UNREAD_HOLE_DEFAULTS
            }
          }
          di = di + 1
        }
      }
    }
    j = j + 1
  }
  0
}

// Whether the parameter of declared function `fn` whose hole is `hole` is never read, or every
// parameter naming type parameter `hole` is typed `hole` bare and never read, and the result
// does not name it (D6763).
function holeParamUnreadAt(fn: i32, hole: string): boolean {
  const f = P.nodes[fn]
  if !(f is FuncDecl) { return false }
  let pi = 0
  while pi < f.fnParams.length {
    if paramHoleName(f.fnName, fn, pi) == hole {
      return holeParamUnreadIn(fn, pi, 0)
    }
    pi = pi + 1
  }
  if !strListHas(f.fnTyParams, hole) || annNamesTyName(f.fnRet, hole) {
    return false
  }
  let seen = false
  pi = 0
  while pi < f.fnParams.length {
    const pn = P.nodes[f.fnParams[pi]]
    if pn is Param {
      if pn.parType >= 0 && annNamesTyName(pn.parType, hole) {
        const tn = P.nodes[pn.parType]
        if !(tn is TypeRef) || tn.tyName != hole { return false }
        if !holeParamUnreadIn(fn, pi, 0) { return false }
        seen = true
      }
    }
    pi = pi + 1
  }
  seen
}

// Whether the annotation at `ix` names the type `name` anywhere in it.
function annNamesTyName(ix: i32, name: string): boolean {
  ix >= 0 && tsMentionsAnyName(annTsOf(ix), [name])
}

// The types an unread hole's default is tried at, in order: whichever the body admits first
// is taken, and as nothing calls it no caller can observe which (D6301).
const UNREAD_HOLE_DEFAULTS = 3

// Function type `ft` with each parameter type variable (only the lambda's own holes when `lam`)
// at the `di`th unread default; -1 past the last or when that leaves a parameter open, or for a
// lambda its result.
function unreadHoleDefault(ft: i32, di: i32, lam: boolean): i32 {
  if di < 0 || di >= UNREAD_HOLE_DEFAULTS || ft < 0 || ft >= T.tys.length {
    return -1
  }
  const lf = T.tys[ft]
  if !(lf is TyFunc) { return -1 }
  let at = TY_I32
  if di == 1 { at = mkArrayTy(TY_I32) }
  if di == 2 { at = TY_STR }
  const nm: string[] = []
  const ty: i32[] = []
  for p in lf.fnParamTypes {
    const pv = T.tys[p]
    if pv is TyVar {
      if !lam || (tyIsHole(p) && pv.tvName.slice(0, 3) == "?#L") {
        // An indexed or pushed hole is judged at the call, not by a deferred constraint.
        if rowIsArrayDemanded(p) && tyRefusesArrayDemand(at) { return -1 }
        nm.push(pv.tvName)
        ty.push(at)
      }
    }
  }
  const inst = substTyDeep(ft, nm, ty)
  if inst < 0 { return -1 }
  const f = T.tys[inst]
  if !(f is TyFunc) { return -1 }
  if lam && tyHasTyVar(inst) { return -1 }
  for p in f.fnParamTypes {
    if tyHasTyVar(p) { return -1 }
  }
  inst
}

// The first unread default hole lambda `lam` judges clean at under the call's bindings, with
// every trial's diagnostics dropped; -1 when none does.
function holeLambdaDefault(
  lam: i32,
  vNames: string[],
  vTys: i32[],
  ix: i32,
): i32 {
  let di = 0
  while di < UNREAD_HOLE_DEFAULTS {
    const inst = unreadHoleDefault(lam, di, true)
    if inst >= 0 {
      const nm: string[] = []
      const ty: i32[] = []
      for v in vNames { nm.push(v) }
      for t in vTys { ty.push(t) }
      holeLambdaBinds(lam, inst, nm, ty)
      const d0 = T.diags.length
      judgeHoleLambdaAt(lam, inst, nm, ty, ix)
      const ok = T.diags.length == d0
      while T.diags.length > d0 { T.diags.pop() }
      if ok { return inst }
    }
    di = di + 1
  }
  -1
}

// The refusal an argument lambda takes when its pin decides none of its parameters.
function holeLambdaUninferable(lx: i32) {
  if lx < 0 || lx >= P.nodes.length { return 0 }
  const fd = P.nodes[lx]
  if !(fd is FuncDecl) { return 0 }
  for p in fd.fnParams {
    const pn = P.nodes[p]
    if pn is Param {
      if pn.parType < 0 {
        tErr("cannot infer a type for parameter `" + pn.parName + "`", p)
        return 0
      }
    }
  }
  0
}

// Pushes onto `nm`/`ty` each lambda parameter hole of `lam` with the parameter type of `inst`.
function holeLambdaBinds(lam: i32, inst: i32, nm: string[], ty: i32[]) {
  const lf = T.tys[lam]
  const xf = T.tys[inst]
  if !(lf is TyFunc) || !(xf is TyFunc) { return 0 }
  let pi = 0
  while pi < lf.fnParamTypes.length && pi < xf.fnParamTypes.length {
    const pv = T.tys[lf.fnParamTypes[pi]]
    if pv is TyVar {
      if tyIsHole(lf.fnParamTypes[pi]) && pv.tvName.slice(0, 3) == "?#L" {
        nm.push(pv.tvName)
        ty.push(xf.fnParamTypes[pi])
      }
    }
    pi = pi + 1
  }
  0
}

// `p?.f(args)` — one guard over the receiver covers the whole call, so the callee and the
// arguments resolve against the receiver's non-null type and the result is that call's own
// return re-wrapped nullable. `-1` when no arm claimed the callee, leaving the caller's
// "called value is not a function" to speak (D1814).
function checkOptCallNode(n: Call, ix: i32, cfn: OptMember): i32 {
  omGuardSet(-1, -1)
  const recv = checkNodeHook(cfn.omObj)
  if recv < 0 { return TY_ERR }
  const eff = omRecvTy(cfn.omObj, recv)
  if eff < 0 { return TY_ERR }
  // A `.` that inherited the chain's guard may not re-guard: same rule, same words, as the
  // member link's.
  if cfn.omDot {
    const de = T.tys[eff]
    if de is TyNullable {
      memberFloorErr(eff, cfn.omProp, ix)
      return TY_ERR
    }
  }
  const rcv = T.tys[recv]
  let wasNullable = false
  if rcv is TyNullable { wasNullable = true }
  const base = nonNullTy(eff)
  if base < 0 { return TY_ERR }
  let rt = checkMemberCallNode(n, ix, cfn.omObj, cfn.omProp, base)
  if rt < 0 {
    // No method arm claimed it: the callee is a VALUE on the receiver — a closure-typed
    // field. Its guarded type is the field's own function type, which is what the call
    // needs; the `?.` node's type is that same function behind a `| null`.
    const fnTy = checkNodeHook(n.callFn)
    const g = omGuardTyAt(n.callFn)
    let cft = fnTy
    if g >= 0 { cft = g }
    if cft < 0 { return TY_ERR }
    const ft = T.tys[cft]
    if ft is TyErr { return TY_ERR }
    if !(ft is TyFunc) { return -1 }
    rt = checkCallOnFuncTy(n, ix, cfn, ft)
    if rt < 0 { return -1 }
  }
  omGuardSet(ix, rt)
  if rt == TY_VOID {
    noteOptCallRet(ix, rt, "")
    return TY_VOID
  }
  if wasNullable {
    const ort = mkNullableTy(rt)
    noteOptCallRet(ix, rt, valueUnionRetName(ort))
    return ort
  }
  noteOptCallRet(ix, rt, "")
  rt
}

// A call expression, dispatched on the callee's shape: a member callee to
// `checkMemberCallNode`, a bare identifier to `checkUnimplementedIntrinsicCall` and
// `checkBuiltinIdentCall`, a function-typed value to `checkCallOnFuncTy`. The type-answering
// three return `-1` for "no arm claimed it"; an unclaimed callee is reported here as `TY_ERR`.
export function checkCallNode(n: Call, ix: i32) {
  if n.callFn < 0 { return TY_ERR }
  const cfn = P.nodes[n.callFn]
  if callHasTyArgs(ix) {
    if !callTyArgsCalleeOk(cfn, ix) { return TY_ERR }
  }
  if cfn is Member {
    const mt = checkMemberCallNode(n, ix, cfn.memObj, cfn.memProp, -1)
    if mt >= 0 { return mt }
  }
  // `p?.f(args)` — the receiver's guard covers the whole call. Answered before the callee is
  // typed as a value, which is what read a nullable closure field as "not a function" (D1814).
  if cfn is OptMember {
    const ot = checkOptCallNode(n, ix, cfn)
    if ot >= 0 { return ot }
  }
  // A built-in call below answers without checking its callee, so the callee's binding is
  // recorded here, before any of them.
  if cfn is Ident { identNoteUse(n.callFn, cfn.identName) }
  if cfn is Ident {
    checkUnimplementedIntrinsicCall(cfn, ix)
    if cfn.identName == "__memory_shared__" && lookupDepth(cfn.identName) == 0 {
      memSharedCalls.push(ix)
    }
  }
  if cfn is Ident {
    if nameIsSimdIntrinsic(cfn.identName) { v128SeenSet(true) }
    checkSimdLaneArg(n, cfn)
  }
  if cfn is Ident {
    const mo = checkMemOffsetCall(n, cfn)
    if mo >= 0 { return mo }
  }
  if cfn is Ident {
    const bt = checkBuiltinIdentCall(n, ix, cfn)
    if bt >= 0 { return bt }
    if foreignLenCall(n, cfn) { return TY_ERR }
  }
  const savedCallee = ckCalleeIx
  ckCalleeIxSet(n.callFn)
  const fnTy = checkNodeHook(n.callFn)
  ckCalleeIxSet(savedCallee)
  if fnTy >= 0 && fnTy < T.tys.length {
    const ft = T.tys[fnTy]
    if ft is TyFunc { return checkCallOnFuncTy(n, ix, cfn, ft) }
    if ft is TyErr {
      // A module global called above its declaration, which the hoist could not type: its
      // arguments are still checked on their own, as a hole callee's are (D3899).
      if cfn is Ident && globalBeforeDecl(cfn.identName) {
        for ga in n.callArgs { checkNodeHook(ga) }
      }
      return TY_ERR
    }
    if ft is TyVar {
      // Calling an inference-hole value — an un-annotated parameter used as a function inside
      // its own generic body (`function apply(fn, a, b) { fn(a, b) }`): the arguments are
      // checked on their own and the call yields a fresh hole, resolved once an outer call
      // binds the generic signature (the emitter compiles each instance concretely).
      const hargs = n.callArgs
      let hWho = ""
      if cfn is Ident { hWho = cfn.identName }
      const hpts: i32[] = []
      let hj = 0
      while hj < hargs.length {
        // A lambda handed to the hole types its un-annotated parameters as holes, as one bound
        // to an un-annotated `const` does; the pin then instances it (D5881).
        const hln = P.nodes[parenPeelIx(hargs[hj])]
        if hln is FuncDecl {
          if hln.fnName == "" && !isValBindLambda(parenPeelIx(hargs[hj])) {
            noteValBindLambda(parenPeelIx(hargs[hj]))
          }
        }
        const hat = checkNodeHook(hargs[hj])
        hpts.push(hat)
        // What the pinned function takes here, demanded of the argument at the pin (D3225).
        const hexp = mkDerivedHole(HD_PARAM, i32ToStr(hj), hj, -1, fnTy)
        if hat >= 0 && hexp >= 0 {
          noteArgCstr(hat, hexp, hWho, hj + 1, hargs[hj])
        }
        hj = hj + 1
      }
      // The parameter, or the slot read from it, runs each function a caller hands it, at
      // these argument types (D9007, D9280).
      if cfn is Ident || cfn is Index || cfn is Member || cfn is OptMember {
        holeLetWritesDisagree(n.callFn, hpts)
      }
      if tyIsNonNullHoleRead(fnTy) {
        noteMemCstr(fnTy, OP_CALL_GUARDED_PIN, ix, false)
      } else {
        noteMemCstr(fnTy, OP_CALL_PIN, ix, false)
      }
      // The call rides the derivation, so a generic pinned here is read at its own arguments.
      return mkDerivedHole(HD_RET, "", -1, ix, fnTy)
    }
  }
  // `v.d()` over a getter reads `v.d` and calls the result: say which getter it read.
  let calledGetter = getSiteFnOf(n.callFn)
  if calledGetter == "" && cfn is Member {
    calledGetter = getterFnFor(checkNodeHook(cfn.memObj), cfn.memProp)
  }
  if calledGetter != "" {
    tErr(
      "called value is not a function ("
        + tyToStr(fnTy)
        + ") — `."
        + getDeclPropOf(calledGetter)
        + "` reads the "
        + getDeclLabel(calledGetter)
        + "; drop the `()`",
      ix,
    )
    return TY_ERR
  }
  const shadow = builtinShadowMsg(n.callFn, fnTy)
  if shadow != "" {
    tErr(shadow, ix)
    return TY_ERR
  }
  tErr("called value is not a function (" + tyToStr(fnTy) + ")", ix)
  TY_ERR
}

// `len(x)` with no `len` in scope: refused at the callee with the VL spelling, `x.length`.
// True when it raised. A program that declares or imports its own `len` never reaches it.
function foreignLenCall(n: Call, cfn: Ident): boolean {
  if cfn.identName != "len" || n.callArgs.length != 1 { return false }
  if lookup("len") >= 0 { return false }
  const at = strLitRecvTy(checkNodeHook(n.callArgs[0]))
  if !strListHas(builtinMethodNamesOf(at), "length") {
    tErr("undeclared identifier 'len'", n.callFn)
    return true
  }
  const recv = placeKeyOf(n.callArgs[0])
  let fix = "'.length'"
  if recv != "" { fix = "'" + recv + ".length'" }
  tErr(
    "undeclared identifier 'len' — a length is a member in VL; did you mean "
      + fix
      + "?",
    n.callFn,
  )
  true
}
