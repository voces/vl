// True when the `.map` callback at `fe` produces an element riding the string list — a
// plain `string` or the `string | null` niche, which share one wrapper and backing pair.
// The collect-time twin of `mfResultKindOf`'s `"str"` answer; the two must name the same
// set, or the emitter picks the string wrapper for a list type collection never forced.
export function mfCbResultIsStrList(fe: i32) {
  cloRetIsString(fe) || cloRetValKind(fe) == "nulstr"
}

// Which position of `fe`'s signature has no `$fnsig` token — a named parameter and its
// type, or its result type, else "". It walks `cloSigKeyExt`'s own ladder in that order,
// so the two cannot disagree about the offender: params first, first fail winning, then
// the result; a void result is never it, since `>v` is a key.
export function cloSigRejectWhat(fe: i32): string {
  if fe < 0 || fe >= fnStmts.length { return "" }
  if fe >= fRetVoid.length { return "" }
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    const params = fn.fnParams
    let pi = 0
    while pi < params.length {
      if cloParamTok(params[pi]) == "" {
        const p = nodeAt(params[pi])
        if p is Param {
          // The declared spelling: for a lambda whose param the pin synthesized this is
          // the pinned nullable, which is exactly the type the token table declined. "" is
          // only a parameter with no annotation node, which `cloParamTok` never refuses.
          const pn = tyNameOf(p.parType)
          if pn != "" {
            return "parameter `" + p.parName + "` of type `" + pn + "`"
          }
          return "parameter `" + p.parName + "`"
        }
      }
      pi = pi + 1
    }
    if fRetVoid[fe] != 1 {
      if cloRetKeySuffix(fe) == "" { return "its result type" }
    }
  }
  // Total, so the reject is one message literal rather than two: a caller falling back to a
  // second sentence writes a second concession into the source. No reachable third case —
  // the floor fires only when the key build stopped, and this walk is that build's ladder.
  "its signature"
}

// The maker function (`fnStmts` position) whose tail object literal built the receiver
// expression at `recvIx`: a direct `make(...)` call, or an ident bound to one. -1 when the
// receiver's origin is not a maker call.
function recvMakerFnOf(recvIx: i32, fnIx: i32) {
  const e = nodeAt(unwrapParen(recvIx))
  let initIx = unwrapParen(recvIx)
  if e is Ident {
    let li = fnLetOfRead(fnIx, initIx)
    if li < 0 { li = globalLetOfRead(fnIx, initIx) }
    if li < 0 { return -1 }
    const d = nodeAt(li)
    if d is LetDecl { initIx = unwrapParen(d.letInit) } else { return -1 }
  }
  if initIx < 0 { return -1 }
  const ie = nodeAt(initIx)
  if ie is Call {
    if ie.callFn < 0 { return -1 }
    const callee = nodeAt(ie.callFn)
    if callee is Ident { return fnIndexOfNode(ie.callFn) }
  }
  -1
}

// The return expression of maker `mk`, seen through a `const` it binds to an object literal
// and returns (`const r = { ... }; return r`), so the record is read per instance (D2853).
function makerRetObjLitOf(mk: i32): i32 {
  const rx = fnRetExprOf(fnStmts[mk])
  if rx < 0 { return rx }
  const ux = unwrapParen(rx)
  if ux < 0 { return rx }
  const re = nodeAt(ux)
  if re is Ident {
    const fd = nodeAt(fnStmts[mk])
    if fd is FuncDecl {
      const li = bodyLetOfRead(fd.fnBody, ux)
      if li >= 0 {
        const ld = nodeAt(li)
        if ld is LetDecl {
          // A `let` is followed only when the return is the very next statement, so nothing
          // can reassign it in between (D2862).
          if (
            (ld.letKw == "const" || stmtPrecedesTail(fd.fnBody, li))
            && ld.letInit >= 0
          ) {
            if nodeAt(unwrapParen(ld.letInit)) is ObjLit { return ld.letInit }
          }
        }
      }
    }
  }
  rx
}

// Boolean-ness of a field-closure trap call `recv.prop(...)`. Monomorphized maker instances
// share the closure body, so its inferred return kind cannot distinguish `wrap(true)` from
// `wrap(99)`; follow the receiver to its maker instance and read the closure's tail through
// that instance's pinned param annotations, falling back to the shared closure's `fRetBool`.
function fieldCloCallIsBool(recvIx: i32, prop: string, fnIx: i32) {
  const mk = recvMakerFnOf(recvIx, fnIx)
  if mk >= 0 {
    const rx = makerRetObjLitOf(mk)
    if rx >= 0 {
      const re = nodeAt(unwrapParen(rx))
      if re is ObjLit {
        const v = objFieldVal(unwrapParen(rx), prop)
        if v >= 0 {
          const vf = nodeAt(v)
          if vf is FuncDecl {
            const vRet = vf.fnRet
            // The arena: `nodeTyPrimName` reads `T.tys[ty].primName`, so an aliased
            // `type B = boolean` return answers `"boolean"` where the spelling reads `"B"`.
            // The `>= 0` guard decides whether this returns and the predicate only what, so
            // a wider answer cannot suppress the fallbacks below.
            if vRet >= 0 { return nodeTyPrimName(vRet) == "boolean" }
            const tx = fnRetExprOf(v)
            if tx >= 0 {
              const te = nodeAt(unwrapParen(tx))
              if te is Ident {
                const ptn = feParamTyName(mk, te.identName)
                if ptn != "" { return ptn == "boolean" }
              }
              return exprIsBool(tx, v)
            }
          }
        }
      }
    }
  }
  const bfe = fieldClosureFeOfRecv(recvIx, prop, fnIx)
  if bfe >= 0 {
    const bfn = nodeAt(fnStmts[bfe])
    if bfn is FuncDecl {
      if bfn.fnRet >= 0 { return nodeTyPrimName(bfn.fnRet) == "boolean" }
    }
    if bfe < fRetBool.length { return fRetBool[bfe] == 1 }
  }
  false
}

// The `$fnsig` type index for lifted function `fe`'s own signature, or -1 when it is not
// value-eligible or not interned. `cloSigKeyExt` equals the value-ABI key for an eligible
// sig; a void or struct-returning field closure resolves its interned extended sig, so its
// function-section type is that `$fnsig` and the trap call site's `ref.cast` accepts it.
export function fnSigIdxOfFn(fe: i32) {
  const key = cloSigKeyExt(fe)
  if key == "" { return -1 }
  cloSigTypeIdxAt(cloSigPosOfKey(key))
}

// After the inference that follows mono: un-annotated function `i`, returning another call's
// record of members, has that record's row, which mono's bundle pin mints; a named refusal when it
// does not, so a pass moved ahead of mono fails loudly rather than declaring a closure result.
export function criRecordRowCheck(i: i32): i32 {
  if i < 0 || i >= fnStmts.length { return 0 }
  const fn = nodeAt(fnStmts[i])
  if !(fn is FuncDecl) || fn.fnRet >= 0 { return 0 }
  const rec = calleeReturnsRecord(fnStmts[i])
  if rec.length < 2 || bundleRecordRowOfSigs(rec) >= 0 { return 0 }
  emitFailAt(
    "emitProgram: a function returning a record of members has no row for the record after monomorphization",
    fnStmts[i],
  )
}

// True if function `fe`'s env-leading signature matches an interned `$fnsig`. Such a
// function is declared with `fnSigIdxOfFn` as its functype, so its actual type is that
// `$fnsig` and the call site's `call_indirect` signature check accepts it. A function
// outside the eligible kinds keeps its own functype and cannot be used as a value.
export function fnSigIsClosure(fe: i32) { fnSigIdxOfFn(fe) >= 0 }

// The refusal a call `callIx` in instance `fnIx` owes when its callee is a closure reading a
// field of the instance's parameter (`localCloPinFieldTail`), or "". The lifted closure is
// shared by every pin, and a list element or an argument cannot follow a niche or box read
// per pin (D2879).
export function cloTailRefusal(callIx: i32, fnIx: i32): string {
  const c = nodeAt(callIx)
  if !(c is Call) { return "" }
  // The closures this reads take no argument; most calls pass one.
  if c.callArgs.length != 0 { return "" }
  if c.callFn < 0 { return "" }
  if !(nodeAt(c.callFn) is Ident) { return "" }
  // A named function is no local closure, and most calls name one.
  if fnIndexOfNode(c.callFn) >= 0 { return "" }
  const t = localCloPinFieldTail(c.callFn, fnIx)
  if t < 0 { return "" }
  const code = memberFieldCode(t, fnIx)
  const perPin = code == FC_NUL_BOOL
    || code == FC_NUL_LIT_UNION
    || code == FC_UNION
  if perPin && callIsElemOrArgIn(fnIx, callIx) {
    return "emitProgram: a closure in a function with an un-annotated parameter delivers a record field read per pin into a list or an argument"
  }
  ""
}

// Whether `target` is an element of a list literal, or an argument `argTakesPerPin` accepts,
// anywhere in the body of the function at `fnIx`.
function callIsElemOrArgIn(fnIx: i32, target: i32): boolean {
  const fd = nodeAt(fnIx)
  if fd is FuncDecl { return nodeHoldsAsElemOrArg(fd.fnBody, target) }
  false
}

// The walk `callIsElemOrArgIn` makes from node `ix`.
function nodeHoldsAsElemOrArg(ix: i32, target: i32): boolean {
  if ix < 0 { return false }
  const n = nodeAt(ix)
  if n is ArrayLit {
    if i32ListHas(n.arrElems, target) { return true }
  }
  if n is Call {
    let ai = 0
    while ai < n.callArgs.length {
      if n.callArgs[ai] == target { return argTakesPerPin(n, ai) }
      ai = ai + 1
    }
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if nodeHoldsAsElemOrArg(kids[i], target) { return true }
    i = i + 1
  }
  false
}

// Whether argument `ai` of call `c` is delivered where a per-pin read cannot follow: a
// parameter left to inference or naming a type parameter, or any callee this cannot resolve.
// `print` and a concretely annotated parameter convert at the boundary.
function argTakesPerPin(c: Call, ai: i32): boolean {
  if c.callFn < 0 { return true }
  const f = nodeAt(c.callFn)
  if !(f is Ident) { return true }
  if f.identName == "print" { return false }
  const fe = fnIndexOfNode(c.callFn)
  if fe < 0 || fe >= fnStmts.length { return true }
  const fd = nodeAt(fnStmts[fe])
  if fd is FuncDecl {
    if ai >= fd.fnParams.length { return true }
    const pn = nodeAt(fd.fnParams[ai])
    if pn is Param {
      if pn.parType < 0 { return true }
      return tyHasTyVar(nodeTyIxOf(pn.parType))
    }
  }
  true
}

// The value-atom kind the concrete (non-box) side of a union `==` compares under — the
// same ladder `emitUnionCoerce` uses — or -1 when the operand has no atom rep (a struct,
// a map, a void call). -1 is a real "cannot classify" answer, never an in-band `"i32"`
// guess (D1071); the fall-through asks the operand's own arena row first.
export function unionEqAtomKindOf(
  otherIx: i32,
  unionName: string,
  uSet: i32,
  fnIx: i32,
): i32 {
  let k = 0
  // A literal-union atom compares under the box's string arm (`msSetTakesAtomAsStr`) since
  // that's the rep it rides as; checked ahead of `exprString` because an atom isn't a
  // string ref until `emitUnionEqOther`'s kind-2 arm widens it.
  if exprIsLitAtom(otherIx, fnIx) {
    k = 2
  } else if exprString(otherIx, fnIx) {
    k = 2
  } else if exprIsF32(otherIx, fnIx) {
    k = 5
  } else if exprIsF64(otherIx, fnIx) {
    k = 4
  } else if exprIsI64(otherIx, fnIx) {
    k = 3
  } else if exprIsBool(otherIx, fnIx) {
    k = 1
  } else {
    // The operand's own row first: `-1` states the shape has no atom rep at all; `-2` is
    // the arena declining, which leaves this ladder's own default answer in force. A row
    // naming a type parameter is read at the binding the instance `fnIx` gives it.
    const oty = nodeTyInOf(unwrapParen(otherIx), fnIx)
    const ork = valueRowKind(oty)
    if ork == -1 { return -1 }
    // A nullable record (`P | null` at a pin) has no atom rep either.
    if oty >= 0 && oty < T.tys.length {
      const on = tyAt(oty)
      if (
        on is TyNullable
        && on.nInner >= 0
        && on.nInner < T.tys.length
        && tyAt(on.nInner) is TyObj
      ) {
        return -1
      }
    }
    // A container or closure atom (codes 7+) rides the box's `value` field directly with
    // no scalar value box, so it's answered as itself rather than promoted.
    if ork >= 7 { return ork }
    // The union's own promotion, asked of the same ladder the store uses
    // (`unionStoreAtomKind`) rather than re-derived here — so a read and a write agree on
    // which numeric arm the union promotes to (D291).
    const eqw = unionStoreAtomKindOfSet(uSet, unionName, 0)
    if eqw >= 0 { k = eqw }
    if numLitWidth(unwrapParen(otherIx), fnIx) == "i64" { k = 3 }
  }
  // The f64-to-f32 re-encode: a float literal against a union whose only float arm is `f32` is
  // stored in the f32 box, so the compare must select that arm too. An `f64` value is compared at
  // `f64`, the arm widened to it (D15090).
  if k == 4 && eqOtherIsNumLit(otherIx) {
    const eqw4 = unionStoreAtomKindOfSet(uSet, unionName, 4)
    if eqw4 >= 0 { k = eqw4 }
  }
  k
}

// Whether `ix` is a number literal, or one negated.
function eqOtherIsNumLit(ix: i32): boolean {
  const u = unwrapParen(ix)
  if u < 0 || u >= P.nodes.length { return false }
  const n = nodeAt(u)
  match n {
    NumLit => {
      return true
    }
    Unary => {
      return n.unOp == "-" && eqOtherIsNumLit(n.unArg)
    }
    // no other node is a number literal
    StrLit | CharLit | BoolLit | NullLit | Ident | BinExpr | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// Whether `ix` is a list of booleans: typed `boolean[]`, or a literal whose first element is one.
export function exprIsBoolList(ix: i32, fnIx: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  if primNameOf(tyArrayElemIx(nodeTyAt(ix, fnIx))) == "boolean" { return true }
  const n = nodeAt(ix)
  if n is ArrayLit {
    if n.arrElems.length > 0 { return exprIsBool(n.arrElems[0], fnIx) }
  }
  // Any other node typed as no boolean list is not one.
  false
}

// The single-byte blocktype valtype for a value-position if-expression: the widest
// numeric rep across its arms (checked f64 → f32 → i64, else the i32 default).
export function ifExprValtype(ifIx: i32, fnIx: i32) {
  // A join over an instance's type parameters takes the width of the number they pin, and a
  // literal arm adapts to it (D3528).
  const pjt = nodeTyIxOf(ifIx)
  if pjt >= 0 && tyHasTyVar(pjt) {
    const pjn = tyPrimNameOf(elabClosedTyAt(ifIx, fnIx))
    if pjn == "f64" { return 124 }
    if pjn == "f32" { return 125 }
    if pjn == "i64" { return 126 }
  }
  if exprIsV128(ifIx, fnIx) {
    return 123 // 0x7b v128
  }
  if exprIsF64(ifIx, fnIx) {
    return 124 // 0x7c f64
  }
  if exprIsF32(ifIx, fnIx) {
    return 125 // 0x7d f32
  }
  if exprIsI64(ifIx, fnIx) {
    return 126 // 0x7e i64
  }
  127 // 0x7f i32
}

export function exprIsBool(ix: i32, fnIx: i32) {
  if ix < 0 { return false }
  // Typed-IR fast path (additive, mirroring exprIsF64): boolean shares the i32 rep
  // everywhere, so the syntactic derivations below still cover paths that lose the tag
  // (a struct-field read, a map `??` result, a closure-value call, a `boolean[]` param).
  if nodeTyWidenedRepName(ix) == "boolean" { return true }
  // A node the generic body shares, typed at a hole this instance pins to `boolean` (D2919).
  if tyPrimNameOf(holeOperandTyOf(ix, fnIx)) == "boolean" { return true }
  if tyPrimNameOf(loopVarPinTyOf(ix, fnIx)) == "boolean" { return true }
  // Before mono the rungs below would read the generic template; the typed rungs above answer.
  if !emitPhaseReached("monomorphized") { return false }
  const e = nodeAt(ix)
  match e {
    BoolLit => {
      return true
    }
    IsExpr => {
      return true
    }
    Paren => {
      return exprIsBool(e.parInner, fnIx)
    }
    Index => {
      const iuk = indexUnionReadKind(ix, fnIx)
      if iuk != -3 { return iuk == 1 }
      // A `(boolean | null)[]` element narrowed past null is the boolean (D2397).
      if nodeArrayElemIsNulBool(e.idxArr) && nodeTyProvesNonNull(ix) {
        return true
      }
      // An element read over a boolean-element list prints as true/false: a `.map` result
      // whose callback returns boolean, or a directly declared `boolean[]`.
      if mfArrElemIsBool(e.idxArr, fnIx) { return true }
      if listElemIsBool(e.idxArr, fnIx) { return true }
      // An element typed at a type parameter an enclosing instance binds to `boolean`, read in
      // a nested generic's instance that binds only its own (D3831).
      if elabReadIsBool(ix, fnIx) { return true }
      return false
    }
    Unary => {
      return e.unOp == "!"
    }
    Ident => {
      // A value-union ident narrowed to `boolean` unboxes to the bool rep and prints
      // true/false (see exprIsI64 for the classification rule).
      const uk = unionIdentReadKind(ix, fnIx)
      if uk != -3 { return uk == 1 }
      // A `boolean|null` niche binding read (narrowed non-null in its branch) prints
      // true/false. Plain `boolean` idents stay unclassified (existing rule).
      if exprNulBool(ix, fnIx) { return true }
      // A captured boolean (a closure returning its maker's `x: boolean` param) — the
      // closure's inferred return kind (`fRetBool`) sees the bool-ness through the env.
      if capturedIsBool(fnIx, e.identName) { return true }
      // A capture typed at a type parameter this lambda's instance pins to `boolean`: an
      // un-annotated copy of a parameter has no annotation to recover it from (D3520).
      if capturedKindOf(fnIx, e.identName) != null {
        if elabReadIsBool(ix, fnIx) { return true }
      }
      // A plain boolean local/param/global — recovered from the binding's annotation
      // or initializer, since a boolean local registers identically to an i32.
      if boundBoolOfRead(ix, fnIx) { return true }
    }
    BinExpr => {
      const op = e.binOp
      if op == "==" || op == "!=" { return true }
      if op == "<" || op == ">" || op == "<=" || op == ">=" { return true }
      if op == "&&" || op == "||" { return true }
      // `lhs ?? d` over a boolean-list `.get`/`.pop` (or a binding seeded by one) yields a
      // boolean — render true/false. Other `??` reads keep i32 (map gets).
      if op == "??" {
        const lhs = nodeAt(unwrapParen(e.binLeft))
        if lhs is Call {
          if lhs.callFn < 0 { return false }
          const lcallee = nodeAt(lhs.callFn)
          if lcallee is Member {
            if lcallee.memProp == "get" || lcallee.memProp == "pop" {
              if !exprMap(lcallee.memObj, fnIx) {
                return listElemIsBool(lcallee.memObj, fnIx)
              }
            }
          }
        }
        if lhs is Ident {
          if identNullableBoolPop(unwrapParen(e.binLeft), fnIx) { return true }
        }
        // A `boolean | null` niche with a boolean default is a boolean, whatever spelled the
        // niche: a hole parameter's pin carries it only as the instance's annotation (D2593).
        return exprNulBool(e.binLeft, fnIx) && exprIsBool(e.binRight, fnIx)
      }
      return false
    }
    Call => {
      if e.callFn < 0 { return false }
      const callee = nodeAt(e.callFn)
      // A field-closure call (an index-trap dispatch) classifies by the field function's
      // return: the receiver's origin resolves the exact monomorphized instance, since bool-
      // ness lives in the instance's own pinned param annotation, not the shared closure body.
      if callee is Member && !callTyClosedIn(ix, fnIx) {
        if (
          drwFieldClosure(
            structIndexOfExpr(callee.memObj, fnIx),
            callee.memProp,
          )
        ) {
          return fieldCloCallIsBool(callee.memObj, callee.memProp, fnIx)
        }
      }
      if callee is Ident {
        const lct = localCloPinFieldTail(e.callFn, fnIx)
        if lct >= 0 && exprIsBool(lct, fnIx) { return true }
        const target = fnIndexOfAt(sidOfNode(e.callFn), fnIx, e.callFn)
        if target >= 0 {
          const fn = nodeAt(fnStmts[target])
          if fn is FuncDecl {
            if fn.fnRet >= 0 {
              // The arena also drops the `rt is TypeRef` gate the name form needed: a return
              // annotation that isn't a bare `TypeRef` still has a recorded type to read.
              if nodeTyPrimName(fn.fnRet) == "boolean" { return true }
              const rt = nodeAt(fn.fnRet)
              if rt is TypeRef { return false }
            } else {
              // Un-annotated: `fnRetColsFromRecorded` classifies the callee's first valued
              // return into `fRetBool` (a fixed point, so mutual recursion resolves).
              return fRetBool[target] == 1
            }
          }
        }
      }
      // A map membership test `m.has(k)` and `m.delete(k)` both yield a boolean (print
      // true/false): `.has` reports presence, `.delete` reports whether it removed anything.
      if callee is Member {
        if callee.memProp == "has" { return exprMap(callee.memObj, fnIx) }
        if callee.memProp == "delete" { return exprMap(callee.memObj, fnIx) }
        // A string `s.includes(sub)` yields a boolean (print true/false).
        if callee.memProp == "includes" {
          return exprString(callee.memObj, fnIx)
        }
      }
    }
    Member => {
      // D931 — a generic carrier's boolean field, read in a monomorphized instance: a mono
      // clone shares its leaf nodes, so the checker's bank on `self.actual` still carries the
      // original's `T`, and the struct table alone can't answer since a boolean field is code
      // 0, layout-shared with i32. The instance's own row (`sTyIx`) still holds the precise type.
      const pft = anonParamPinFieldTy(e.memObj, e.memProp, fnIx)
      if pft >= 0 { return tyEmitPrimOf(pft) == "boolean" }
      const msi = structIndexOfExpr(e.memObj, fnIx)
      if msi >= 0 && msi < sTyIx.length {
        const mfty = tyFieldTyOf(sTyIx[msi], e.memProp)
        if mfty >= 0 && tyEmitPrimOf(mfty) == "boolean" { return true }
      }
    }
    // No other expression is known boolean by its spelling.
    NumLit | StrLit | CharLit | NullLit | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// The literal-union parameter flavour of value call `callIx`'s parameter `idx`: `1` a `K`
// atom param, `2` a `K | null` niche param, `0` neither, read off `fnIx`'s pin of the callee
// (D4352). Can't come from the `$fnsig` key: a litunion param's token is `i`, as an i32's is.
export function cloCallParamLitUnion(callIx: i32, idx: i32, fnIx: i32) {
  const c = nodeAt(callIx)
  if c is Call {
    const ft = cloCallParamFnTyOf(callIx, fnIx)
    if ft < 0 { return 0 }
    const t = tyAt(ft)
    if t is TyFunc {
      if idx < 0 || idx >= t.fnParamTypes.length { return 0 }
      const pty = t.fnParamTypes[idx]
      // A string literal union, aliased or inline, is the interned i32 atom.
      if tyIsLitUnion(pty) { return 1 }
      // The niche claims both spellings, exactly as `nodeTyIsNulLitUnion` does: inline and
      // aliased alike rep as the i32 atom with the `-1` null sentinel.
      if tyIsNullableLitUnion(pty) { return 2 }
    }
  }
  0
}

// The function type value call `callIx`'s parameters are read off in instance `fnIx`: the
// callee's recorded type when it is one, else the pin of the hole or type parameter it reads
// (through `const` aliases); -1 when none is a function type.
function cloCallParamFnTyOf(callIx: i32, fnIx: i32): i32 {
  const c = nodeAt(callIx)
  if c is Call {
    const ct = nodeTyAt(c.callFn, fnIx)
    if ct >= 0 && tyAt(ct) is TyFunc { return ct }
    const hft = cloCallHoleFnTyOf(callIx, fnIx)
    if hft >= 0 { return hft }
    const pt = valueReadPinTy(c.callFn, fnIx, 0)
    if pt >= 0 && pt < T.tys.length && tyAt(pt) is TyFunc { return pt }
    return ct
  }
  -1
}

// The producer (concrete-lambda) `$fnsig` key of the function-value binding the read `readIx`
// resolves to — the functype the lambda value actually carries (`cloSigKeyExt` of the resolved
// lambda), chasing a plain copy to its source read. "" when it holds no concrete lambda.
function producerCloSigKeyOfRead(readIx: i32, fnIx: i32) {
  const fe = identClosureFeOfRead(readIx, fnIx)
  if fe >= 0 { return cloSigKeyExt(fe) }
  const src = identCopySourceNodeOfRead(readIx, fnIx)
  if src >= 0 && sidOfNode(src) != sidOfNode(readIx) {
    return producerCloSigKeyOfRead(src, fnIx)
  }
  ""
}

// Soundness floor: a function-value call whose resolved cast `$fnsig` and its concrete
// producer lambda's `$fnsig` are both ref-list results on different, non-layout-twin
// element slots — array elements are invariant, so the `ref.cast` to the annotation's
// wrapper traps on the producer's. Rejects loudly rather than emit the latent trap (#875).
export function cloCallReflistElemTwin(callIx: i32, fnIx: i32): boolean {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return false }
    const cre = nodeAt(c.callFn)
    if cre is Ident {
      const castK = cloCallSigKey(callIx, fnIx)
      if castK == "" { return false }
      const prodK = producerCloSigKeyOfRead(c.callFn, fnIx)
      if prodK == "" { return false }
      if prodK == castK { return false }
      if cloSigPosOfKey(castK) < 0 { return false }
      if cloSigPosOfKey(prodK) < 0 { return false }
      const crk = sigKeyRetKind(castK)
      const prk = sigKeyRetKind(prodK)
      if crk == null || prk == null { return false }
      if crk == "reflist" && prk == "reflist" {
        const cs = sigKeyRetSlot(castK)
        const ps = sigKeyRetSlot(prodK)
        if cs >= 0 && ps >= 0 && cs != ps {
          if rlSlotsLayoutTwin(cs, ps) == 0 { return true }
        }
      }
    }
  }
  false
}

// The declared list type-name of the expression at `ix`, or "" — an annotation, not a rep.
// Covers all four storage classes a list binding can have (param, function-scoped
// let/const, module global, one level of index), because inside a monomorphized instance
// the checker never typed the cloned body, so only the substituted annotation is left.
function listAnnNameOf(ix: i32, fnIx: i32) {
  if ix < 0 { return "" }
  const e = nodeAt(unwrapParen(ix))
  match e {
    Ident => {
      const ptn = paramTypeNodeOfRead(fnIx, unwrapParen(ix))
      if ptn >= 0 {
        const pt = nodeAt(ptn)
        if pt is TypeRef { return pt.tyName }
      }
      let li = fnLetOfRead(fnIx, unwrapParen(ix))
      if li < 0 { li = globalLetOfRead(fnIx, unwrapParen(ix)) }
      if li >= 0 {
        const d = nodeAt(li)
        if d is LetDecl {
          if d.letType >= 0 {
            const lt = nodeAt(d.letType)
            if lt is TypeRef { return lt.tyName }
          }
        }
      }
      return ""
    }
    Index => {
      const outer = listAnnNameOf(e.idxArr, fnIx)
      if outer != "" { return arrElemNameRaw(outer) }
    }
    // A direct call's declared return: inside a generic instance the call node keeps the
    // template's type, and only the callee instance's return names the pinned list (D2820).
    Call => {
      if e.callFn >= 0 && nodeAt(e.callFn) is Ident {
        const target = fnIndexOfNode(e.callFn)
        if target >= 0 && target < fnStmts.length {
          const fn = nodeAt(fnStmts[target])
          if fn is FuncDecl {
            if fn.fnRet >= 0 {
              const rt = nodeAt(fn.fnRet)
              if rt is TypeRef { return rt.tyName }
            }
          }
        }
      }
    }
    // No other expression carries a declared list annotation.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  ""
}

// True if the list at `arrIx` carries boolean elements: a `[true, ...]` literal, a
// `boolean[]` annotation on any storage class, a name tracing to either through its
// initializer, or a `.map`/`.filter` callback returning boolean. Rides the i32 list rep
// (0/1), with spare value 2 encoding a checked `.pop()`'s `boolean | null` niche sentinel.
export function listElemIsBool(arrIx: i32, fnIx: i32) {
  if arrIx < 0 { return false }
  const inner = unwrapParen(arrIx)
  if inner < 0 { return false }
  const e = nodeAt(inner)
  if e is ArrayLit {
    if e.arrElems.length > 0 { return exprIsBool(e.arrElems[0], fnIx) }
    return false
  }
  // The array grammar's one cut (`arrElemNameRaw`) plus the bare leaf name — deliberately
  // not `nameIsI32Array`, which is rep-wide (also accepts `i32[]`, litunion `K[]`, niche
  // arrays) where this site is about the element's print formatting specifically.
  const annElem = arrElemNameRaw(listAnnNameOf(inner, fnIx))
  // Stays on the name rather than the arena twin (`tyArrayElemPrimName`) on purpose: inside
  // a monomorphized instance the body is a clone the checker never typed, so the node-type
  // bank has nothing and only the substituted annotation carries the boolean-ness.
  // Substituting the arena twin breaks `generics/bool-list-arg-print.vl` (B77).
  if annElem == "boolean" { return true }
  // A numeric declared element outranks the initializer-derived kind below: a declared
  // `i32[]` prints its elements as numbers whatever type its initializer's elements have.
  if annElem == "i32" || annElem == "u8" { return false }
  // The instance's own pin, for a receiver the body typed only as a hole: the substituted
  // annotation the rungs above read is the generic's, so this is the first rung with a
  // concrete element. Below them, since a declared `i32[]` still outranks it.
  if tyArrayElemPrimName(nodeTyInOf(inner, fnIx)) == "boolean" { return true }
  if e is Ident {
    let li = fnLetOfRead(fnIx, inner)
    if li < 0 { li = globalLetOfRead(fnIx, inner) }
    if li >= 0 {
      const d = nodeAt(li)
      if d is LetDecl {
        if d.letInit >= 0 {
          if unwrapParen(d.letInit) != inner {
            return listElemIsBool(d.letInit, fnIx)
          }
        }
      }
    }
    return false
  }
  mfArrElemIsBool(arrIx, fnIx)
}

// True if the read `readIx` names a binding whose initializer is a checked `.pop()` over a
// BOOLEAN-element list — its i32 cell holds 0/1 or the niche sentinel 2 (`null`),
// so a later `x ?? d` must compare against 2, not test a ref.
export function identNullableBoolPop(readIx: i32, fnIx: i32) {
  let li = fnLetOfRead(fnIx, readIx)
  if li < 0 { li = globalLetOfRead(fnIx, readIx) }
  if li >= 0 {
    const d = nodeAt(li)
    if d is LetDecl {
      if d.letInit >= 0 {
        const ini = nodeAt(unwrapParen(d.letInit))
        if ini is Call {
          if ini.callFn < 0 { return false }
          const callee = nodeAt(ini.callFn)
          if callee is Member {
            if callee.memProp == "pop" {
              return listElemIsBool(callee.memObj, fnIx)
            }
          }
        }
      }
    }
  }
  false
}

// True if the read `atIx` resolves (param / local / module global) to a boolean
// binding: a `: boolean` annotation, or an un-annotated `const`/`let` with a boolean
// initializer. A boolean local registers as kind 0 (== i32), so bool-ness must be recovered
// from the binding here, not the local registry.
function boundBoolOfRead(atIx: i32, fnIx: i32) {
  if fnIx >= 0 {
    const fn = nodeAt(fnIx)
    if fn is FuncDecl {
      // The read's own declaration decides: a parameter takes the frame's own copy of it, whose
      // type an instance pinned, and a body `let` its annotation or initializer (D3236).
      let dl = -1
      if atIx >= 0 && atIx < P.nodes.length { dl = identDeclOf(atIx) }
      if dl >= 0 && dl < P.nodes.length {
        const d = nodeAt(dl)
        if d is Param {
          const pt = paramTypeNodeOfRead(fnIx, atIx)
          if pt >= 0 { return tyIsBool(pt) }
          return tyIsBool(d.parType)
        }
        if !(d is LetDecl) { return false }
        if globalLetOfSid(sidOfNode(atIx)) != dl {
          // An instance's read names the generic's `let`; the frame's own copy is typed at the pin.
          const li = readLetDeclOf(atIx, fnIx)
          if li >= 0 {
            const l = nodeAt(li)
            if l is LetDecl {
              if l.letType >= 0 { return tyIsBool(l.letType) }
              return exprIsBool(l.letInit, fnIx)
            }
          }
          return false
        }
      }
    }
  }
  const gi = globalLetOfRead(fnIx, atIx)
  if gi >= 0 {
    const g = nodeAt(gi)
    if g is LetDecl {
      if g.letType >= 0 { return tyIsBool(g.letType) }
      return exprIsBool(g.letInit, -1)
    }
  }
  false
}

// The boolean-list atom code of the value `ix` builds (`tyBoolListCode`): its recorded type's,
// else inside a generic instance the pinned type's, else for a list literal its first
// element's; -1 for any other value.
export function exprBoolListCode(ix: i32, fnIx: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const bix = unwrapParen(ix)
  if bix < 0 || bix >= P.nodes.length { return -1 }
  const c = tyBoolListCode(nodeTyAt(bix, fnIx))
  if c >= 0 { return c }
  const ec = tyBoolListCode(exactOperandTyOf(bix, fnIx))
  if ec >= 0 { return ec }
  const pc = tyBoolListCode(nodeTyInOf(bix, fnIx))
  if pc >= 0 { return pc }
  // A name or call read inside an instance: a parameter's substituted annotation, or the callee
  // instance's declared return (D2820's rung).
  const an = listAnnNameOf(bix, fnIx)
  if an != "" { return boolListCodeOfName(an) }
  const init = frameLetInitOf(bix, fnIx)
  if init >= 0 { return exprBoolListCode(init, fnIx) }
  arrLitBoolListCode(bix, fnIx)
}

// The boolean-list code a list literal `ix` builds from its first element; -1 for any other.
function arrLitBoolListCode(ix: i32, fnIx: i32): i32 {
  const n = nodeAt(ix)
  if !(n is ArrayLit) { return -1 }
  if n.arrElems.length == 0 { return -1 }
  const e = n.arrElems[0]
  if exprIsBool(e, fnIx) { return 17 }
  const sc = exprBoolListCode(e, fnIx)
  if sc == 17 { return 19 }
  if sc >= 19 { return sc + 1 }
  -1
}

// The box tag of the ref-element list `ix` built at reflist slot `slot` into union `un`: a
// boolean-leaf list's own code where `un` has that arm, else the slot's tag.
export function refArrBoxTagOf(
  ix: i32,
  fnIx: i32,
  slot: i32,
  un: string,
  unTy: i32,
): i32 {
  const c = exprBoolListCode(ix, fnIx)
  if c >= 19 && unionHasBoolLeafArm(un, c - 18) {
    return boolListArmTag(c - 18)
  }
  if vbAtomListTop >= 1 {
    const ad = exprAtomLeafListDepth(ix, fnIx)
    if ad >= 1 && unionHasAtomLeafArm(un, unTy, ad) {
      return atomLeafListArmTag(ad)
    }
  }
  refArrSlotTag(slot)
}

// `atomLeafListDepthOfTy` of the value `ix` builds: its recorded type's, else its operand or
// pinned type's, else for a list literal one more than its first element's; -1 otherwise.
function exprAtomLeafListDepth(ix: i32, fnIx: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const bix = unwrapParen(ix)
  if bix < 0 || bix >= P.nodes.length { return -1 }
  const d = atomLeafListDepthOfTy(nodeTyIxOf(bix))
  if d >= 0 { return d }
  const ed = atomLeafListDepthOfTy(exactOperandTyOf(bix, fnIx))
  if ed >= 0 { return ed }
  const pd = atomLeafListDepthOfTy(nodeTyInOf(bix, fnIx))
  if pd >= 0 { return pd }
  const init = frameLetInitOf(bix, fnIx)
  if init >= 0 { return exprAtomLeafListDepth(init, fnIx) }
  const n = nodeAt(bix)
  if !(n is ArrayLit) || n.arrElems.length == 0 { return -1 }
  const e = n.arrElems[0]
  if exprIsLitAtom(e, fnIx) { return 0 }
  const sd = exprAtomLeafListDepth(e, fnIx)
  if sd >= 0 { return sd + 1 }
  -1
}

// True if the CAPTURED variable `name` of the capturing lifted function `fnIx`
// is BOOLEAN-typed in the parent frame (a `boolean` param annotation, a
// `boolean`-annotated let, or a bool-literal init). Bool rides in an i32, so
// `capturedKindOf` cannot carry it — this is the print/`fRetBool` side channel.
function capturedIsBool(fnIx: i32, name: string) {
  if fnIx < 0 { return false }
  if !fnNestUsed { return false }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return false }
  const caps = captureNamesOf(fe)
  let isCap = false
  let ci = 0
  while ci < caps.length {
    if caps[ci] == name { isCap = true }
    ci = ci + 1
  }
  if !isCap { return false }
  const b = parentBindingOf(fe, name)
  if b < 0 { return false }
  const bn = nodeAt(b)
  // `tyIsBool` IS this test — `tyNameOf` returns "" for a negative index and for a non-`TypeRef`,
  // which is that function's `false`. Two hand-written copies of one predicate, now one call each;
  // the destringification rides in `tyIsBool` alone.
  match bn {
    Param => {
      return tyIsBool(bn.parType)
    }
    LetDecl => {
      if bn.letType >= 0 { return tyIsBool(bn.letType) }
      if bn.letInit >= 0 {
        const iv = nodeAt(unwrapParen(bn.letInit))
        if iv is BoolLit { return true }
      }
    }
    // Any other binding is not a captured boolean.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// True when value call `callIx`'s callee type has a parameter or result with no `$fnsig`
// token and no derived i32 rep: the all-i32 arity functype would then be called at the wrong
// type, so the caller refuses instead of falling back (D2810).
export function cloCallArityFallbackUnsound(callIx: i32, fnIx: i32): boolean {
  const c = nodeAt(callIx)
  if c is Call {
    // A hole callee bound to a function type in this instance that `cloCallSigKey` left
    // unkeyed: the all-i32 functype is sound only where every slot rides an i32 (D3165).
    const hft = cloCallHoleFnTyOf(callIx, fnIx)
    if hft >= 0 {
      const h = tyAt(hft)
      if h is TyFunc {
        let k = 0
        while k < h.fnParamTypes.length {
          if cloArityRepIsWide(h.fnParamTypes[k]) { return true }
          k = k + 1
        }
        return cloArityRepIsWide(h.fnRet)
      }
    }
    const fty = nodeTyAt(c.callFn, fnIx)
    if fty >= 0 {
      const t = tyAt(fty)
      if t is TyFunc {
        let i = 0
        while i < t.fnParamTypes.length {
          if repSigTokOfTy(t.fnParamTypes[i]) == "" {
            if cloArityRepIsWide(t.fnParamTypes[i]) { return true }
          }
          i = i + 1
        }
        if repSigRetTokOfTy(t.fnRet) == "" { return cloArityRepIsWide(t.fnRet) }
      }
    }
  }
  false
}

// The function type a value call's callee the checker left a hole is bound to in the instance
// `fnIx`, or a capture of one; -1 when the callee has a type of its own or no such binding.
function cloCallHoleFnTyOf(callIx: i32, fnIx: i32): i32 {
  const c = nodeAt(callIx)
  if c is Call {
    const ct = nodeTyAt(c.callFn, fnIx)
    if ct >= 0 && tyAt(ct) is TyFunc { return -1 }
    const hft = holeOrCapturedTyOf(c.callFn, fnIx)
    if hft >= 0 && tyAt(hft) is TyFunc { return hft }
  }
  -1
}

// Why a value call `callIx` found no `$fnsig`: the first parameter or the result of the
// callee's function type that has no token, walked in `sigKeyOfTy`'s order, else the whole
// signature, which then has a key that no function value of that type interned.
export function cloCallSigRejectWhat(callIx: i32, fnIx: i32): string {
  const c = nodeAt(callIx)
  if c is Call {
    const hft = cloCallHoleFnTyOf(callIx, fnIx)
    if hft >= 0 {
      return "the callee is an un-annotated value this instance binds to `"
        + tyToEmitName(hft)
        + "`, and such a call is keyed only for a scalar or string result"
    }
    const fty = nodeTyAt(c.callFn, fnIx)
    if fty >= 0 {
      const t = tyAt(fty)
      if t is TyFunc {
        let i = 0
        while i < t.fnParamTypes.length {
          if repSigTokOfTy(t.fnParamTypes[i]) == "" {
            return "parameter "
              + i32ToStr(i + 1)
              + " of type `"
              + tyToEmitName(t.fnParamTypes[i])
              + "` has no representation in the function-value ABI"
          }
          i = i + 1
        }
        if repSigRetTokOfTy(t.fnRet) == "" {
          return "its result type `"
            + tyToEmitName(t.fnRet)
            + "` has no representation in the function-value ABI"
        }
        return "no function value of type `"
          + tyToEmitName(fty)
          + "` reaches this call to intern its signature"
      }
    }
  }
  "the callee has no function type to key a signature from"
}

// True when a closure value call's declared result is a value union but the resolved
// closure `$fnsig` reps its result as a non-union (the lambda self-infers its one concrete
// arm while the checker types the whole union) — rejects loudly here rather than leaking
// invalid wasm at the narrow that consumes it. A supported union result (keying `>u`) returns false.
export function cloCallUnionResultUnrepresentable(
  callIx: i32,
  fnIx: i32,
): boolean {
  // Case A: a nullable-closure-union result claims a box (`>u`) but no value union is
  // declared, so the box is never minted — reject here rather than trap on the tag read. #875.
  const ckeyA = cloCallSigKey(callIx, fnIx)
  if ckeyA != "" {
    const rkA = sigKeyRetKind(ckeyA)
    if rkA != null && rkA == "union" && !uDeclared { return true }
  }
  const ty = nodeTyAt(callIx, fnIx)
  if ty < 0 { return false }
  // A nullable numeric-scalar result reps as the same value-union box as a nullable-scalar
  // union arm, so it needs the identical rep-consistency tail; `string|null`/`boolean|null` don't.
  const tn = tyAt(ty)
  if tn is TyNullable {
    // A never-filled `let x = null` captured by a lambda gives it the open null-hole as its
    // inferred result, so `nInner` is -1 here — representable as `null`'s own rep, not a refusal. D1576.
    if tn.nInner < 0 || tn.nInner >= T.tys.length { return false }
    const nit = tyAt(tn.nInner)
    let nulBoxScalar = false
    if nit is TyPrim {
      const pn = nit.primName
      if pn == "i32" || pn == "f64" || pn == "i64" || pn == "f32" {
        nulBoxScalar = true
      }
    }
    if !nulBoxScalar {
      // A nullable value-union result wraps the union in `TyNullable`, bypassing the main
      // union branch — route the inner union through the same analysis so it floors, not traps.
      if nit is TyUnion { return cloCallUnionMixUnrep(tn.nInner, callIx, fnIx) }
      return false
    }
    const nkey = cloCallSigKey(callIx, fnIx)
    if nkey == "" { return true }
    const nrk = sigKeyRetKind(nkey)
    if nrk == null { return true }
    if nrk != "union" { return true }
    return cloSigPosOfKey(nkey) < 0
  }
  if !(tyAt(ty) is TyUnion) { return false }
  return cloCallUnionMixUnrep(ty, callIx, fnIx)
}

// The scalar+composite value-union analysis of `cloCallUnionResultUnrepresentable`, factored
// so both a direct `TyUnion` result and a nullable-wrapped union result (which bypasses the
// main branch) run the identical representability test. `ty` is the union type index;
// `callIx`/`fnIx` drive the `$fnsig` producer checks.
function cloCallUnionMixUnrep(ty: i32, callIx: i32, fnIx: i32): boolean {
  const t = tyAt(ty)
  if !(t is TyUnion) { return false }
  if t.uMembers.length < 2 { return false }
  // A "boxing" union needs at least one scalar member and one composite member — their reps
  // differ, so the closure result needs the shared box; a rep-uniform union already lowers.
  let hasScalar = false
  let hasComposite = false
  let i = 0
  while i < t.uMembers.length {
    const mt = tyAt(t.uMembers[i])
    if mt is TyPrim {
      hasScalar = true
    } else if mt is TyLit {
      // A litunion member reps as an i32 atom, so a litunion+composite mix is as
      // rep-heterogeneous as a scalar mix — it needs the box too; a pure litunion stays uniform.
      hasScalar = true
    } else if tyIsLitUnion(t.uMembers[i]) {
      hasScalar = true
    } else if mt is TyObj {
      hasComposite = true
    } else if mt is TyArray {
      hasComposite = true
    } else if mt is TyMap {
      hasComposite = true
    } else if mt is TyFunc {
      hasComposite = true
    }
    i = i + 1
  }
  if !hasComposite { return false }
  // Rep-consistent only when the resolved `$fnsig` result is the union box (`>u`); a concrete-
  // member result or no sig means the box read has nothing to recover — the deferred hole.
  const ckey = cloCallSigKey(callIx, fnIx)
  if ckey == "" { return hasScalar }
  const rk = sigKeyRetKind(ckey)
  if rk == null { return hasScalar }
  if rk != "union" { return hasScalar }
  // A `>u` key alone is not consistency — some producer must have actually interned that
  // box functype; an un-interned `>u` is the same deferred hole for the mix.
  if cloSigPosOfKey(ckey) < 0 { return hasScalar }
  // The `>u` box can be interned (e.g. by an outer nullable-closure annotation) while the
  // producer lambda self-inferred a non-union arm — an iso-recursive twin-cast trap. #938.
  const pk = callProducerCloSigKey(callIx, fnIx)
  if pk != "" && pk != ckey {
    const prk = sigKeyRetKind(pk)
    if prk != null && prk != "union" { return true }
  }
  // An indexed closure-array-element callee (`f[0]()`) whose result union has a value-union
  // element-array arm: a param-fed array has no producer to verify its actual arm. #1034.
  if tyUnionHasValueUnionElemArrayArm(ty) {
    if calleeIsIndexedRefArrayCall(callIx, fnIx) {
      if pk == "" { return true }
      const prkI = sigKeyRetKind(pk)
      if prkI == null || prkI != "union" { return true }
    }
  }
  false
}

// The concrete PRODUCER lambda's `$fnsig` key for a value-CALL whose callee is a plain
// Ident binding — the functype the closure VALUE actually carries. "" for a non-Ident
// callee or an unresolvable producer.
function callProducerCloSigKey(callIx: i32, fnIx: i32) {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return "" }
    const cre = nodeAt(c.callFn)
    if cre is Ident { return producerCloSigKeyOfRead(c.callFn, fnIx) }
  }
  ""
}

// True when a call's callee is an index into a ref (closure) array (`f[0]()`): the element
// sig comes from the array-element annotation, not a resolvable producer lambda. Used by
// the union-result floor to reject the deferred scalar+composite closure-result union in
// this spelling (the array element may hold a lambda that self-inferred a non-box arm).
function calleeIsIndexedRefArrayCall(callIx: i32, fnIx: i32): boolean {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return false }
    const cre = nodeAt(c.callFn)
    if cre is Index { return exprRefArray(cre.idxArr, fnIx) }
  }
  false
}

// True if an index read over the list at `arrIx` yields a boolean element. Today the
// only boolean-element list producer is a `.map` whose callback returns boolean
// (`xs.map(function(n: i32) n > 2)`); a `.filter` keeps its receiver's element
// bool-ness, and a module-global binding traces through its initializer.
function mfArrElemIsBool(arrIx: i32, fnIx: i32) {
  if arrIx < 0 { return false }
  const inner = unwrapParen(arrIx)
  if inner < 0 { return false }
  const e = nodeAt(inner)
  match e {
    Call => {
      if callIsMapFilter(inner, fnIx) {
        if e.callFn < 0 { return false }
        const callee = nodeAt(e.callFn)
        if callee is Member {
          if callee.memProp == "filter" {
            return mfArrElemIsBool(callee.memObj, fnIx)
          }
          return mfCbRetIsBool(mfCallbackFe(e.callArgs[0], fnIx))
        }
      }
      return false
    }
    Ident => {
      const li = globalLetOfRead(fnIx, inner)
      if li >= 0 {
        const d = nodeAt(li)
        if d is LetDecl {
          if d.letInit >= 0 {
            if unwrapParen(d.letInit) != inner {
              return mfArrElemIsBool(d.letInit, -1)
            }
          }
        }
      }
    }
    // No other expression is a boolean-element list producer.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// True if `ix` is a bare identifier naming a top-level or lifted function — the shape a
// `.map`/`.filter` callback takes by plain reference rather than as a closure literal.
export function exprIsBareFnName(ix: i32) {
  if ix < 0 { return false }
  const e = nodeAt(ix)
  if e is Ident { return fnIndexOfNode(ix) >= 0 }
  false
}

// Whether the instance `fnIx`'s elaboration types read `ix` as `boolean`; false where it leaves
// the read open.
function elabReadIsBool(ix: i32, fnIx: i32): boolean {
  const t = elabNodeTyAt(ix, fnIx)
  if t < 0 || t >= T.tys.length || tyHasTyVar(t) { return false }
  tyPrimNameOf(t) == "boolean"
}
