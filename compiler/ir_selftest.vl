// The verifier's own cases: hand-built IR breaking each of rules 1-7, more for rules 5, 2 and 8,
// the fused `pop ?? d`'s three, a stashed record's source order, the fused map read's four, a
// numeric union conversion's two, and one function that holds.
// A host test reads the ids (`irSelfTestIdAt`), calls `irVerifySelfTest(i)` once the checker's
// primitives exist (after any compile), and compares the rule named with its map keyed by id.
import {
  ArmUnboxRoute,
  IrFn,
  IrNode,
  MapProbe,
  Opnd,
  RArmUnbox,
  Rhs,
  armUnboxRoute,
  irCloFieldRetagNote,
  irFnNew,
  irGlobalNote,
  irGlobalStoreNote,
  irNodeNew,
  irRecHeapNote,
  irSigNote,
  irVarHeapNote,
  irVarNew,
  sIf,
} from "./ir"
import { irVerify } from "./ir_verify"
import { repClosureOfReps, repNodeKids, repNodeOfTy } from "./emit_rep"
import {
  TY_BOOL,
  TY_I32,
  TY_I64,
  TY_NEVER,
  TY_NULL,
  TY_STR,
  mkArrayTy,
  mkLitTy,
  mkMapTy,
  mkNullableTy,
  mkObjTy,
} from "./check_types"
import { CoalValArm, NULL_OWN_NONE } from "./emit_plan_null"
import { mkUnionTy } from "./check_union_mint"
import { BinExpr, Call, StrLit, addNode } from "./ast"
import { irBoundsRule } from "./ir_verify_bounds"
import { irTyI64 } from "./ir_helper"

function node(f: IrFn, n: IrNode, rep: i32): i32 {
  return irNodeNew(f, n, -1, rep, -1)
}

function v(x: i32): Opnd {
  const o: Opnd = { ov: x }
  return o
}

function imm(rep: i32, b: i64): Opnd {
  const o: Opnd = { oiRep: rep, oiBits: b }
  return o
}

// Every case's id, in no meaningful order; a new case adds its id here and its rule to the host
// test's map.
