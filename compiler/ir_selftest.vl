        {
          lDst: g,
          lRhs: { uaV: v(bx), uaAt: -1, uaCellNul: false, uaDst: named, uaAsg: false },
        },
        lands,
      ),
    )
  }
  // Rule 2: an assignment's arm unbox (`uaAsg`) names its destination; one naming none is refused.
  if id == "asg-arm-unbox-at-its-record" || id == "asg-arm-unbox-without-dest" {
    const ut = mkUnionTy([TY_I32, TY_STR])
    const bx = irVarNew(f, repNodeOfTy(ut), ut, "local", 1)
    const at = mkObjTy(["x"], [TY_I32])
    const named = repNodeOfTy(at)
    const ud = if id == "asg-arm-unbox-at-its-record" { named } else { -1 }
    const g = irVarNew(f, named, at, "temp", -1)
    f.irBody.push(
      node(
        f,
        {
          lDst: g,
          lRhs: { uaV: v(bx), uaAt: -1, uaCellNul: false, uaDst: ud, uaAsg: true },
        },
        named,
      ),
    )
  }
  // Rule 10: a box whose head the lowering writes ahead of a dispatch (`irBoxLeadFirst`) directly
  // follows the dispatch's nodes; a node between them is refused.
  if id == "led-box-follows-its-dispatch" || id == "led-box-past-a-node" {
    const u = irVarNew(f, i32r, TY_I32, "local", 1)
    const w = irVarNew(f, i32r, TY_I32, "local", 2)
    const first = node(
      f,
      {
        lDst: u,
        lRhs: { poOp: "add", poArgs: [v(p), imm(i32r, 2)] },
      },
      i32r,
    )
    f.irBody.push(first)
    if id == "led-box-past-a-node" {
      const z = irVarNew(f, i32r, TY_I32, "local", 3)
      f.irBody.push(
        node(
          f,
          { lDst: z, lRhs: { poOp: "add", poArgs: [v(p), imm(i32r, 3)] } },
          i32r,
        ),
      )
    }
    const bx = node(
      f,
      { lDst: w, lRhs: { poOp: "add", poArgs: [v(u), imm(i32r, 1)] } },
      i32r,
    )
    f.irBody.push(bx)
    f.irBoxLeadFirst.push(first)
    f.irBoxLeadBox.push(bx)
    f.irBoxLeadN.push(1)
  }
  // Rule 2 again: an arm unbox whose operand is an i32, not a box.
  if id == "arm-unbox-of-i32" {
    const sn = irVarNew(f, i32r, TY_I32, "temp", -1)
    f.irBody.push(
      node(
        f,
        {
          lDst: sn,
          lRhs: { uaV: v(p), uaAt: -1, uaCellNul: false, uaDst: -1, uaAsg: false },
        },
        i32r,
      ),
    )
  }
  // A list of boxed `i32 | null` retagged into an `i32[]` or into a list of niche records: neither
  // holds union boxes, so neither is that list as it stands (rule 2).
  if (
    id == "box-list-retag-into-i32-list"
    || id == "box-list-retag-into-niche-record-list"
  ) {
    const st = mkArrayTy(mkNullableTy(TY_I32))
    const nr = mkNullableTy(mkObjTy(["a"], [TY_I32]))
    const toI32 = id == "box-list-retag-into-i32-list"
    const dt = if toI32 { mkArrayTy(TY_I32) } else { mkArrayTy(nr) }
    const sl = irVarNew(f, repNodeOfTy(st), st, "local", 1)
    const dl = irVarNew(f, repNodeOfTy(dt), dt, "temp", -1)
    f.irBody.push(node(f, { lDst: dl, lRhs: { rgV: v(sl) } }, repNodeOfTy(dt)))
  }
  // A list of `i32[]` retagged into a list of `i32[] | null` is the list as it stands, its backing
  // already nullable (`listRetag`); one into a list of `boolean[] | null` is refused (rule 2).
  if (
    id == "list-of-lists-retag-into-nullable-lists"
    || id == "list-of-lists-retag-into-other-lists"
  ) {
    const st = mkArrayTy(mkArrayTy(TY_I32))
    const inner = if id == "list-of-lists-retag-into-nullable-lists" { TY_I32 } else { TY_BOOL }
    const dt = mkArrayTy(mkNullableTy(mkArrayTy(inner)))
    const sl = irVarNew(f, repNodeOfTy(st), st, "local", 1)
    const dl = irVarNew(f, repNodeOfTy(dt), dt, "temp", -1)
    f.irBody.push(node(f, { lDst: dl, lRhs: { rgV: v(sl) } }, repNodeOfTy(dt)))
  }
  // A nullable reference's `??` over an `i32`, over a non-null list, and over a nullable list into
  // an `i32` out that is neither the list nor a box.
  if (
    id == "nul-ref-of-i32"
    || id == "nul-ref-of-non-null-list"
    || id == "nul-ref-list-into-i32"
  ) {
    const lt = mkArrayTy(TY_I32)
    const l = irVarNew(f, repNodeOfTy(lt), lt, "local", 1)
    const o = irVarNew(f, i32r, TY_I32, "local", 2)
    const d: i32[] = [node(f, { asDst: o, asSrc: imm(i32r, 0) }, none)]
    const nt = mkNullableTy(lt)
    const nl = irVarNew(f, repNodeOfTy(nt), nt, "local", 3)
    const from = if id == "nul-ref-of-i32" { v(p) } else if id == "nul-ref-of-non-null-list" { v(l) } else { v(nl) }
    f.irBody.push(
      node(
        f,
        {
          cbL: from,
          cbLB: [],
          cbArm: "nulRef",
          cbNull: d,
          cbOut: o,
          cbAt: -1,
          cbMap: null,
          cbIdx: null,
        },
        i32r,
      ),
    )
  }
  // The bottom ref into a `boolean | null`, whose sentinel slot is an i32, and into a nullable list.
  if id == "null-none-into-bool-niche" || id == "null-none-into-ref-niche" {
    const nt = if id == "null-none-into-bool-niche" { mkNullableTy(TY_BOOL) } else { mkNullableTy(mkArrayTy(TY_I32)) }
    const nr = repNodeOfTy(nt)
    const nv = irVarNew(f, nr, nt, "temp", -1)
    const k = node(
      f,
      { lDst: nv, lRhs: { nuAt: -1, nuOwn: NULL_OWN_NONE, nuRead: [] } },
      nr,
    )
    // The fact the builder notes for it (`irNoteVerifyFacts`): the bottom ref.
    f.irFactInt[k] = 0
    f.irBody.push(k)
  }
  // Rule 10: a valued block outside a helper whose out is a temp, not a loop value's binding.
  if id == "valued-block-temp-out" {
    const bo = irVarNew(f, i32r, TY_I32, "temp", -1)
    f.irBody.push(node(f, { bkLabel: 3, bkBody: [], bkOut: bo }, none))
  }
  // A sole member's atom id into an `i32` temp, which is no atom.
  if id == "atom-sole-into-i32" {
    const at = irVarNew(f, i32r, TY_I32, "temp", -1)
    f.irBody.push(node(f, { lDst: at, lRhs: { asAt: -1 } }, i32r))
  }
  // An atom tower testing an `i32` read, which is no string, and one testing no read.
  if id == "atom-tower-i32-read" || id == "atom-tower-zero-reads" {
    const tw = irVarNew(f, i32r, TY_I32, "temp", -1)
    const reads: Opnd[] = if id == "atom-tower-i32-read" { [v(p)] } else { [] }
    f.irBody.push(
      node(f, { lDst: tw, lRhs: { saReads: reads, saAt: -1 } }, i32r),
    )
  }
  // A staged atom narrowing parking an `i32`, which is no string.
  if id == "atom-staged-of-i32" {
    const sg = irVarNew(f, i32r, TY_I32, "temp", -1)
    f.irBody.push(node(f, { lDst: sg, lRhs: { zsV: v(p), zsAt: -1 } }, i32r))
  }
  // A call handing a capture back to a variable it does not pass as one.
  if id == "call-write-back-not-a-capture" {
    irSigNote(f, 0, [i32r], i32r)
    const c: Rhs = {
      caCallee: 0,
      caArgs: [v(p)],
      caNever: false,
      caEnv: false,
      caCaps: [],
      caWb: [p],
    }
    f.irBody.push(node(f, { efRhs: c }, none))
  }
  // A string coalesce, and an atom one, whose default is an `i32`, at neither a literal nor the
  // result's string rep.
  if id == "coal-str-default-off-rep" || id == "coal-atom-str-default-off-rep" {
    const at = id == "coal-atom-str-default-off-rep"
    const lt = if at { mkUnionTy([mkLitTy("str", "a"), mkLitTy("str", "b")]) } else { TY_STR }
    const nt = mkNullableTy(lt)
    const l = irVarNew(f, repNodeOfTy(nt), nt, "param", 1)
    f.irParams.push(l)
    const sr = repNodeOfTy(TY_STR)
    const cz = irVarNew(f, sr, TY_STR, "temp", -1)
    const r: Rhs = if at { { zaL: v(l), zaD: v(p), zaAt: -1 } } else { { czL: v(l), czD: v(p), czAt: -1 } }
    f.irBody.push(node(f, { lDst: cz, lRhs: r }, sr))
  }
  // Rule 2: a `K | null` decoded into a plain string holds only where the plan writes no null,
  // which a node-less decode cannot show; into a `string | null` it holds.
  if (
    id == "atom-decode-nullable-into-string"
    || id == "atom-decode-nullable-into-nullable-string"
  ) {
    const lt = mkUnionTy([mkLitTy("str", "a"), mkLitTy("str", "b")])
    const nt = mkNullableTy(lt)
    const l = irVarNew(f, repNodeOfTy(nt), nt, "param", 1)
    f.irParams.push(l)
    const dt = if id == "atom-decode-nullable-into-string" { TY_STR } else { mkNullableTy(TY_STR) }
    const dr = repNodeOfTy(dt)
    const sx = irVarNew(f, dr, dt, "temp", -1)
    f.irBody.push(node(f, { lDst: sx, lRhs: { sxV: v(l), sxAt: -1 } }, dr))
  }
  // Rule 2: a nullable records' guarded compare (`RStructEq`'s `seNul`) holds over two nullable
  // records into a bool; over two plain records, which no guard can see null in, it is refused.
  if (
    id == "nullable-records-compared-nullable"
    || id == "plain-records-compared-nullable"
  ) {
    const ot = mkObjTy(["a"], [TY_I32])
    const nul = id == "nullable-records-compared-nullable"
    const nt = if nul { mkNullableTy(ot) } else { ot }
    const tr = repNodeOfTy(nt)
    const l = irVarNew(f, tr, nt, "local", 1)
    const r = irVarNew(f, tr, nt, "local", 2)
    const g = irVarNew(f, boolr, TY_BOOL, "temp", -1)
    const noIx: Opnd[] = []
    const cmp: Rhs = {
      seL: v(l),
      seR: v(r),
      seAt: -1,
      seRow: 0,
      seLIx: noIx,
      seRIx: noIx,
      seNul: true,
    }
    f.irBody.push(node(f, { lDst: g, lRhs: cmp }, boolr))
  }
  // Rule 3: a captured atom's lifted parameter is held at the atom and typed as its literal set,
  // not as the string its binding reads as; decoded at a string it holds.
  if (
    id == "captured-atom-param-decoded-at-string"
    || id == "captured-atom-param-typed-as-string"
  ) {
    const lt = mkUnionTy([mkLitTy("str", "x"), mkLitTy("str", "y")])
    const pt = if id == "captured-atom-param-decoded-at-string" { lt } else { TY_STR }
    const l = irVarNew(f, repNodeOfTy(lt), pt, "param", 1)
    f.irParams.push(l)
    const sr = repNodeOfTy(TY_STR)
    const sx = irVarNew(f, sr, TY_STR, "temp", -1)
    f.irBody.push(node(f, { lDst: sx, lRhs: { sxV: v(l), sxAt: -1 } }, sr))
  }
  // Rule 2: a list `.get` reads the element at an i32 index; a string index is refused.
  if id == "get-of-list" || id == "get-index-of-string" {
    const lt = mkArrayTy(TY_I32)
    const xs = irVarNew(f, repNodeOfTy(lt), lt, "local", 1)
    const k = if id == "get-of-list" { p } else { irVarNew(f, repNodeOfTy(TY_STR), TY_STR, "local", 2) }
    const nt = mkNullableTy(TY_I32)
    const nr = repNodeOfTy(nt)
    const gx = irVarNew(f, nr, nt, "temp", -1)
    f.irBody.push(
      node(f, { lDst: gx, lRhs: { lqV: v(xs), lqIx: [v(k)], lqAt: -1 } }, nr),
    )
  }
  // Rule 2: a string's bytes are a fresh `u8[]` read off a string: into an `i32[]` they are
  // refused, and an i32 receiver has none.
  if id == "bytes-into-i32-list" || id == "bytes-of-i32" {
    const into = id == "bytes-into-i32-list"
    const sr = repNodeOfTy(TY_STR)
    const src = if into { irVarNew(f, sr, TY_STR, "local", 1) } else { p }
    const bx = if into { irVarNew(f, repNodeOfTy(mkArrayTy(TY_I32)), mkArrayTy(TY_I32), "temp", -1) } else { irVarNew(f, sr, TY_STR, "temp", -1) }
    const br = f.irVars[bx].vRep
    f.irBody.push(
      node(
        f,
        { lDst: bx, lRhs: { soOp: "bytes", soArgs: [v(src)], soAt: -1 } },
        br,
      ),
    )
  }
  // Rule 2: a standalone `?.` read off a scalar base, which holds no record to test.
  if id == "opt-read-of-i32" {
    const ov = irVarNew(f, i32r, TY_I32, "temp", -1)
    f.irBody.push(
      node(f, { lDst: ov, lRhs: { orV: v(p), orAt: -1, orTag: -1 } }, i32r),
    )
  }
  f.irBody.push(node(f, { rtHas: true, rtV: v(t) }, none))
  return f
}

// A synthesized call node: a call has an effect, so an immediate cannot stand for it.
function callNode(): i32 {
  const c: Call = { callFn: -1, callArgs: [], callArgNames: [], pos: -1 }
  return addNode(c)
}

// The number of cases, and the code unit `j` of case `i`'s id, for the host to read the ids.
export function irSelfTestIdCount(): i32 { return selfTestIds.length }

export function irSelfTestIdLen(i: i32): i32 { return selfTestIds[i].length }

export function irSelfTestIdAt(i: i32, j: i32): i32 { return selfTestIds[i][j] }

// The rule the verifier names for case `i` of the id list: 0 for a function that holds.
export function irVerifySelfTest(i: i32): i32 {
  return irVerify(caseFn(selfTestIds[i])).vfRule
}

// Rule 8 over a string-literal receiver: case 0 checks and reads the same literal node and holds;
// case 1 checks one literal and reads another of equal text, and must not pair. The rule
// compares nodes and reps only, so the literal's rep is any fixed one.
export function irBoundsStrSelfTest(k: i32): boolean {
  const i32r = repNodeOfTy(TY_I32)
  const none = repNodeOfTy(TY_NEVER)
  const f = irFnNew(-1, "selftest")
  f.irRetRep = i32r
  f.irRetTy = TY_I32
  const p = irVarNew(f, i32r, TY_I32, "param", 0)
  f.irParams.push(p)
  const t = irVarNew(f, i32r, TY_I32, "temp", -1)
  const a = strNode()
  const b = if k == 1 { strNode() } else { a }
  const ca: Opnd = { osAt: a, osRep: i32r }
  const cb: Opnd = { osAt: b, osRep: i32r }
  f.irBody.push(node(f, { bcV: ca, bcIx: v(p) }, none))
  f.irBody.push(
    node(
      f,
      {
        lDst: t,
        lRhs: { lgV: cb, lgIx: v(p), lgAt: -1, lgStored: false, lgAgain: false },
      },
      i32r,
    ),
  )
  f.irBody.push(node(f, { rtHas: true, rtV: v(t) }, none))
  return irBoundsRule(f) == ""
}

// `armUnboxRoute` over a record arms unbox whose read is an assignment node: k 0 has no `uaAsg` and
// must take the record arms cast, k 1 has it and takes the assignment's, k 2 names no destination.
export function irArmUnboxRouteSelfTest(k: i32): boolean {
  const asgNode: BinExpr = {
    binOp: "=",
    binLeft: -1,
    binRight: -1,
    pos: -1,
    binCompound: "",
    binTpl: -1,
    binRegion: 0,
    binIdent: 0,
  }
  const ax = addNode(asgNode)
  const ud = if k == 2 { -1 } else { repNodeOfTy(TY_I32) }
  const o: Opnd = { oiRep: repNodeOfTy(TY_I32), oiBits: 0 }
  const r: RArmUnbox = {
    uaV: o,
    uaAt: ax,
    uaCellNul: false,
    uaDst: ud,
    uaAsg: k == 1,
  }
  const want: ArmUnboxRoute = if k == 0 { "recordArms" } else if k == 1 { "asg" } else { "arm" }
  return armUnboxRoute(r) == want
}

// A synthesized string literal node "s".
function strNode(): i32 {
  const s: StrLit = { strText: "s", pos: -1 }
  return addNode(s)
}
