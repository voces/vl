// Rule 1 for a result typed by its rep (`irRetFromRep`): `thunk(env, p) { t = call f0(p); return
// t }` holds; forwarding the env in `p`'s place, or the mark outside a thunk, is refused.
function repTypedThunkFn(id: string): IrFn {
  const i32r = repNodeOfTy(TY_I32)
  const f = irFnNew(-1, "selftest thunk")
  f.irThunk = id != "rep-typed-result-not-thunk"
  f.irRetFromRep = true
  f.irRetRep = i32r
  f.irRetTy = TY_I32
  const e = irVarNew(f, i32r, TY_I32, "param", 0)
  const p = irVarNew(f, i32r, TY_I32, "param", 1)
  f.irParams.push(e)
  f.irParams.push(p)
  irSigNote(f, 0, [i32r], i32r)
  const t = irVarNew(f, i32r, TY_I32, "temp", -1)
  const arg = if id == "rep-typed-thunk-forwards-env" { v(e) } else { v(p) }
  const c: Rhs = {
    caCallee: 0,
    caArgs: [arg],
    caNever: false,
    caEnv: false,
    caCaps: [],
    caWb: [],
  }
  f.irBody.push(node(f, { lDst: t, lRhs: c }, i32r))
  f.irBody.push(node(f, { rtHas: true, rtV: v(t) }, repNodeOfTy(TY_NEVER)))
  return f
}

// `f(p: i32): i32 { t = p + 1; return t }`, broken the way case `id` names ("holds": not broken).
function caseFn(id: string): IrFn {
  if id.slice(0, 10) == "rep-typed-" { return repTypedThunkFn(id) }
  const i32r = repNodeOfTy(TY_I32)
  const boolr = repNodeOfTy(TY_BOOL)
  const none = repNodeOfTy(TY_NEVER)
  const f = irFnNew(-1, "selftest")
  f.irRetRep = i32r
  f.irRetTy = TY_I32
  const p = irVarNew(f, i32r, TY_I32, "param", 0)
  f.irParams.push(p)
  const t = irVarNew(f, i32r, TY_I32, "temp", -1)
  // Rule 1: a variable whose rep is outside the tree.
  if id == "var-rep-outside-tree" { irVarNew(f, -7, TY_I32, "local", 1) }
  // Rule 3: a variable whose rep is not its type's.
  if id == "var-rep-not-its-type" { irVarNew(f, boolr, TY_I32, "local", 1) }
  // Rule 2: a comparison's bool result into an i32 destination.
  const op: Rhs = if id == "compare-into-i32" { { poOp: "lt", poArgs: [v(p), v(p)] } } else { { poOp: "add", poArgs: [v(p), imm(i32r, 1)] } }
  // Rule 4: the definition is left out, so the return reads `t` undefined.
  if id != "read-before-definition" {
    f.irBody.push(node(f, { lDst: t, lRhs: op }, i32r))
  }
  // Rule 10: a nullable print's opening blocks (`RPrintOpen`) pair with the print that closes them,
  // of its arm, in the same body, with no return between.
  if id.slice(0, 11) == "print-open-" || id == "print-opened-unopened" {
    const arm = if id == "print-open-arm-mismatch" { 1 } else { 0 }
    if id != "print-opened-unopened" {
      f.irBody.push(node(f, { efRhs: { poArm: arm } }, none))
    }
    if id == "print-open-left-by-return" {
      f.irBody.push(node(f, { rtHas: true, rtV: v(t) }, none))
    }
    if id != "print-open-unclosed" {
      f.irBody.push(
        node(f, { efRhs: { pnV: v(p), pnAt: -1, pnOpened: 0 } }, none),
      )
    }
  }
  // Rule 5: a branch to a label nothing encloses.
  if id == "branch-to-unenclosed-label" {
    f.irBody.push(node(f, { brLabel: 9, brHas: false, brVal: v(t) }, none))
  }
  // Rule 6: a call passing one argument to a callee that takes two.
  if id == "call-arity" {
    irSigNote(f, 0, [i32r, i32r], i32r)
    const c: Rhs = {
      caCallee: 0,
      caArgs: [v(p)],
      caNever: false,
      caEnv: false,
      caCaps: [],
      caWb: [],
    }
    f.irBody.push(node(f, { efRhs: c }, none))
  }
  // Rule 7: a switch over an i32, which has no arms.
  if id == "switch-over-i32" {
    f.irBody.push(node(f, { swOn: p, swArms: [], swOut: -1 }, none))
  }
  // Rule 5 again: the body ends in an `if` whose arms fall through, and nothing returns.
  // Rule 2 at a return: an `i32[]` result returned a `boolean[]` parameter, refused unless the
  // builder noted both reps stored at one valtype (`irRepValtype`), and refused where it noted two.
  if (
    id == "return-not-stored-alike"
    || id == "return-stored-alike"
    || id == "return-stored-unlike"
  ) {
    const la = mkArrayTy(TY_I32)
    const lb = mkArrayTy(TY_BOOL)
    f.irRetRep = repNodeOfTy(la)
    f.irRetTy = la
    const pb = irVarNew(f, repNodeOfTy(lb), lb, "param", 1)
    f.irParams.push(pb)
    const one: u8[] = [7]
    const two: u8[] = [8]
    if id != "return-not-stored-alike" {
      f.irRepValtype[f.irRetRep] = one
      f.irRepValtype[repNodeOfTy(lb)] = two
      if id == "return-stored-alike" { f.irRepValtype[repNodeOfTy(lb)] = one }
    }
    f.irBody.push(node(f, { rtHas: true, rtV: v(pb) }, none))
    return f
  }
  // Rule 2 at a return into a ref-niche nullable `i32[] | null`: a `boolean[]` parameter is refused
  // unless the builder noted it stored at the inner's valtype.
  if (
    id == "niche-return-not-stored-alike"
    || id == "niche-return-stored-alike"
  ) {
    const la = mkArrayTy(TY_I32)
    const lb = mkArrayTy(TY_BOOL)
    const nt = mkNullableTy(la)
    f.irRetRep = repNodeOfTy(nt)
    f.irRetTy = nt
    const pb = irVarNew(f, repNodeOfTy(lb), lb, "param", 1)
    f.irParams.push(pb)
    if id == "niche-return-stored-alike" {
      const one: u8[] = [7]
      f.irRepValtype[repNodeOfTy(la)] = one
      f.irRepValtype[repNodeOfTy(lb)] = one
    }
    f.irBody.push(node(f, { rtHas: true, rtV: v(pb) }, none))
    return f
  }
  if id == "if-falls-off-end" {
    f.irBody.push(node(f, sIf(imm(boolr, 1), [], [], -1, false), none))
    return f
  }
  // Rule 2 again: an i32 stored into a global recorded as a bool.
  if id == "i32-into-bool-global" {
    irGlobalNote(f, 0, boolr)
    f.irBody.push(node(f, { gsSym: 0, gsSrc: v(p) }, none))
  }
  // Rule 2: an assignment's unwidening (`RAsgUnwiden`) narrows its re-read by the opcode of that
  // pair: `i32.wrap_i64` of an i64 into an i32, or `ref.as_non_null` of a nullable record into the
  // record, holds; a truncation claimed for an i64, or a non-null cast of a plain record, fails.
  if id.slice(0, 12) == "asg-unwiden-" {
    const ot = mkObjTy(["a"], [TY_I32])
    const nt = mkNullableTy(ot)
    const ref = id == "asg-unwiden-non-null-of-nullable-record"
      || id == "asg-unwiden-non-null-of-record"
    const st = if !ref { irTyI64() } else if id == "asg-unwiden-non-null-of-record" { ot } else { nt }
    const c = irVarNew(f, repNodeOfTy(st), st, "local", 1)
    const dt = if ref { ot } else { TY_I32 }
    const g = irVarNew(f, repNodeOfTy(dt), dt, "temp", -1)
    const uop = if ref { 212 } else if id == "asg-unwiden-wrap-of-i64" { 167 } else { 170 }
    const uw: Rhs = { uwV: v(c), uwOp: uop, uwAt: -1 }
    f.irBody.push(node(f, { lDst: g, lRhs: uw }, repNodeOfTy(dt)))
  }
  // Rule 2: an identity compare (`RIdentityEq`) holds over two records into a bool; one over a
  // string or an i32, which have no identity, is refused.
  if id == "identity-eq-of-records" || id == "identity-eq-of-string" {
    const ot = mkObjTy(["a"], [TY_I32])
    const orep = repNodeOfTy(ot)
    const sr = repNodeOfTy(TY_STR)
    const str = id == "identity-eq-of-string"
    const l = if str { irVarNew(f, sr, TY_STR, "local", 1) } else { irVarNew(f, orep, ot, "local", 1) }
    const r = if str { irVarNew(f, sr, TY_STR, "local", 2) } else { irVarNew(f, orep, ot, "local", 2) }
    const g = irVarNew(f, boolr, TY_BOOL, "temp", -1)
    f.irBody.push(
      node(f, { lDst: g, lRhs: { ieL: v(l), ieR: v(r), ieAt: -1 } }, boolr),
    )
  }
  if id == "identity-eq-of-i32" {
    const g = irVarNew(f, boolr, TY_BOOL, "temp", -1)
    f.irBody.push(
      node(f, { lDst: g, lRhs: { ieL: v(p), ieR: v(p), ieAt: -1 } }, boolr),
    )
  }
  // Rule 2: a compare helper (`REqHelp`) compares two records into an i32; one of an i32, or into
  // a bool, is refused.
  if id.slice(0, 10) == "eq-helper-" {
    const ot = mkObjTy(["a"], [TY_I32])
    const orep = repNodeOfTy(ot)
    const l = irVarNew(f, orep, ot, "local", 1)
    const r = irVarNew(f, orep, ot, "local", 2)
    const into = id == "eq-helper-into-bool"
    const gr = if into { boolr } else { i32r }
    const gt = if into { TY_BOOL } else { TY_I32 }
    const g = irVarNew(f, gr, gt, "temp", -1)
    const lv = if id == "eq-helper-of-i32" { p } else { l }
    const cmp: Rhs = { ehL: v(lv), ehR: v(r), ehRow: 0 }
    f.irBody.push(node(f, { lDst: g, lRhs: cmp }, gr))
  }
  // Rule 2: a result pick (`RResultPick`) reads a member of a record into a closure; one of an
  // i32 or of a record into an i32, is refused.
  if id == "result-pick-of-i32" || id == "result-pick-record-into-i32" {
    const ot = mkObjTy(["c0", "c1"], [TY_I32, TY_I32])
    const orep = repNodeOfTy(ot)
    const rec = irVarNew(f, orep, ot, "local", 1)
    const from = if id == "result-pick-of-i32" { v(p) } else { v(rec) }
    const g = irVarNew(f, i32r, TY_I32, "temp", -1)
    f.irBody.push(
      node(f, { lDst: g, lRhs: { rkV: from, rkAt: -1, rkFe: -1 } }, i32r),
    )
  }
  // Rule 3: a field read typed `never` holds at the rep its record's row stores the field at,
  // and breaks the rule at any other.
  if (
    id == "never-field-read-at-its-storage"
    || id == "never-field-read-off-its-storage"
  ) {
    const ot = mkObjTy(["c0", "c1"], [TY_I32, TY_I32])
    const rec = irVarNew(f, repNodeOfTy(ot), ot, "param", 1)
    f.irParams.push(rec)
    const at = if id == "never-field-read-at-its-storage" { i32r } else { boolr }
    const g = irVarNew(f, at, TY_NEVER, "temp", -1)
    const gf: Rhs = {
      gfV: v(rec),
      gfIx: 0,
      gfAt: -1,
      gfStored: false,
      gfStr: false,
      gfShared: false,
    }
    f.irBody.push(node(f, { lDst: g, lRhs: gf }, at))
    f.irBody.push(node(f, { dpV: v(g) }, none))
  }
  // A literal set its layout family stores as a string is read at that string: delivered, it holds;
  // typed at the literal set, or decoded as an atom with no delivery, it is refused.
  if id.slice(0, 15) == "str-field-read-" {
    const kt = mkUnionTy([mkLitTy("str", "a"), mkLitTy("str", "b")])
    const ot = mkObjTy(["k"], [TY_STR])
    const rec = irVarNew(f, repNodeOfTy(ot), ot, "param", 1)
    f.irParams.push(rec)
    const sr = repNodeOfTy(TY_STR)
    const gt = if id == "str-field-read-typed-as-atom" { kt } else { TY_STR }
    const g = irVarNew(f, sr, gt, "temp", -1)
    const gf: Rhs = {
      gfV: v(rec),
      gfIx: 0,
      gfAt: -1,
      gfStored: false,
      gfStr: false,
      gfShared: false,
    }
    f.irBody.push(node(f, { lDst: g, lRhs: gf }, sr))
    if id == "str-field-read-into-atom-decode" {
      const sx = irVarNew(f, sr, TY_STR, "temp", -1)
      f.irBody.push(node(f, { lDst: sx, lRhs: { sxV: v(g), sxAt: -1 } }, sr))
    } else {
      f.irBody.push(node(f, { dpV: v(g) }, none))
    }
  }
  // A `boolean | null` field read narrowed to its boolean is that i32 at the boolean; at any other
  // rep it is refused.
  if id.slice(0, 20) == "nulbool-field-read-a" {
    const nb = mkNullableTy(TY_BOOL)
    const ot = mkObjTy(["f"], [nb])
    const rec = irVarNew(f, repNodeOfTy(ot), ot, "param", 1)
    f.irParams.push(rec)
    const at = if id == "nulbool-field-read-at-its-boolean" { TY_BOOL } else if id == "nulbool-field-read-at-i32" { TY_I32 } else { TY_STR }
    const ar = repNodeOfTy(at)
    const g = irVarNew(f, ar, at, "temp", -1)
    const gf: Rhs = {
      gfV: v(rec),
      gfIx: 0,
      gfAt: -1,
      gfStored: false,
      gfStr: false,
      gfShared: false,
    }
    f.irBody.push(node(f, { lDst: g, lRhs: gf }, ar))
    f.irBody.push(node(f, { dpV: v(g) }, none))
  }
  // Rule 2 for a map walk's variable: a values walk binds the receiver map's value, or an i32 or a
  // string; a keys walk binds the key rep it records (a map rep holds no key), which must be one a
  // key is held at: an i32 over a recorded i64 is refused, as is a record recorded as a key.
  if id.slice(0, 9) == "walk-map-" {
    const ot = mkObjTy(["c0", "c1"], [TY_I32, TY_I32])
    const i64r = repNodeOfTy(TY_I64)
    const onKeys = id.slice(0, 13) == "walk-map-key-"
    const mt = mkMapTy(TY_I32, ot, 0)
    const recv = irVarNew(f, repNodeOfTy(mt), mt, "local", 1)
    const k = if id == "walk-map-value-record" || id == "walk-map-key-record" { irVarNew(f, repNodeOfTy(ot), ot, "local", 2) } else if id == "walk-map-key-i32" || id == "walk-map-key-width-mismatch" { irVarNew(f, i32r, TY_I32, "local", 2) } else if id == "walk-map-key-i64" { irVarNew(f, i64r, TY_I64, "local", 2) } else { irVarNew(f, boolr, TY_BOOL, "local", 2) }
    const keyRep = if !onKeys { -1 } else if id == "walk-map-key-i64" || id == "walk-map-key-width-mismatch" { i64r } else if id == "walk-map-key-record" { repNodeOfTy(ot) } else { i32r }
    const body: i32[] = []
    f.irBody.push(
      node(
        f,
        {
          xfList: v(recv),
          xfVar: k,
          xfVar2: -1,
          xfBody: body,
          xfAt: -1,
          xfBrk: 7,
          xfCont: 8,
          xfMap: -1,
          xfMapNonNull: false,
          xfVals: !onKeys,
          xfKeyRep: keyRep,
          xfLu: false,
        },
        none,
      ),
    )
  }
  // Rule 2 and 3 for a walk's second name: a map walk binds its value at its type's rep, any rep;
  // one held at a rep its type does not name breaks rule 3. A string walk's is an i32 index, and
  // one of a `boolean` is refused.
  if id.slice(0, 10) == "walk-pair-" {
    const ot = mkObjTy(["c0", "c1"], [TY_I32, TY_I32])
    const orep = repNodeOfTy(ot)
    const onMap = id.slice(0, 19) == "walk-pair-map-value"
    const mt = mkMapTy(TY_I32, ot, 0)
    const recv = if onMap { irVarNew(f, repNodeOfTy(mt), mt, "local", 1) } else { irVarNew(f, repNodeOfTy(TY_STR), TY_STR, "local", 1) }
    const k = irVarNew(f, i32r, TY_I32, "local", 2)
    const v2 = if id == "walk-pair-map-value-record" { irVarNew(f, orep, ot, "local", 3) } else if id == "walk-pair-map-value-off-type" { irVarNew(f, orep, TY_I32, "local", 3) } else if id == "walk-pair-string-index" { irVarNew(f, i32r, TY_I32, "local", 3) } else { irVarNew(f, boolr, TY_BOOL, "local", 3) }
    const body: i32[] = []
    f.irBody.push(
      node(
        f,
        {
          xfList: v(recv),
          xfVar: k,
          xfVar2: v2,
          xfBody: body,
          xfAt: -1,
          xfBrk: 7,
          xfCont: 8,
          xfMap: -1,
          xfMapNonNull: false,
          xfVals: false,
          xfKeyRep: i32r,
          xfLu: false,
        },
        none,
      ),
    )
  }
  // Rule 2: a hand pick (`RHandPick`) reads a member of a bundle record into a closure; one of an
  // i32, or of a record into an i32, is refused.
  if id == "hand-pick-of-i32" || id == "hand-pick-record-into-i32" {
    const ot = mkObjTy(["c0", "c1"], [TY_I32, TY_I32])
    const orep = repNodeOfTy(ot)
    const rec = irVarNew(f, orep, ot, "local", 1)
    const from = if id == "hand-pick-of-i32" { v(p) } else { v(rec) }
    const g = irVarNew(f, i32r, TY_I32, "temp", -1)
    f.irBody.push(
      node(f, { lDst: g, lRhs: { hpV: from, hpAt: -1, hpArg: -1, hpI: 0 } }, i32r),
    )
  }
  // Rule 2: a holder pick (`RHolderPick`) reads a member of a bundle holder's record into a
  // closure; one of an i32, or of a record into an i32, is refused, one into a closure holds.
  if (
    id == "holder-pick-of-i32"
    || id == "holder-pick-record-into-i32"
    || id == "holder-pick-record-into-closure"
  ) {
    const ot = mkObjTy(["c0", "c1"], [TY_I32, TY_I32])
    const rec = irVarNew(f, repNodeOfTy(ot), ot, "local", 1)
    const from = if id == "holder-pick-of-i32" { v(p) } else { v(rec) }
    const clo = repClosureOfReps([i32r], i32r, false)
    const into = id == "holder-pick-record-into-closure"
    const dr = if into { clo } else { i32r }
    const g = if into { irVarNew(f, clo, -1, "temp", -1) } else { irVarNew(f, i32r, TY_I32, "temp", -1) }
    f.irBody.push(
      node(f, { lDst: g, lRhs: { hkV: from, hkAt: -1, hkArg: -1 } }, dr),
    )
  }
  // Rule 2: the start body's progress store (`RInitProgress`) is an effect; one bound to a value
  // is refused, one in statement position holds.
  if id == "init-progress-as-value" {
    const g = irVarNew(f, i32r, TY_I32, "temp", -1)
    f.irBody.push(node(f, { lDst: g, lRhs: { ipOrd: 0 } }, i32r))
  }
  if id == "init-progress-effect" {
    f.irBody.push(node(f, { efRhs: { ipOrd: 0 } }, repNodeOfTy(TY_NEVER)))
  }
  // Rule 2: a literal cast (`RAsTail`) stages a scalar or an atom id; one of a record is refused,
  // one of an i32 holds.
  if id == "literal-cast-of-record" || id == "literal-cast-of-i32" {
    const ot = mkObjTy(["c0", "c1"], [TY_I32, TY_I32])
    const rec = irVarNew(f, repNodeOfTy(ot), ot, "local", 1)
    const from = if id == "literal-cast-of-i32" { v(p) } else { v(rec) }
    const g = irVarNew(f, i32r, TY_I32, "temp", -1)
    f.irBody.push(node(f, { lDst: g, lRhs: { akV: from, akAt: -1 } }, i32r))
  }
  // Rule 2: a type parameter's cast box (`RHoleOptBox`) boxes a scalar into a value union's box;
  // one of a record is refused, one of an i32 holds.
  if id == "hole-opt-box-of-record" || id == "hole-opt-box-of-i32" {
    const ot = mkObjTy(["c0", "c1"], [TY_I32, TY_I32])
    const rec = irVarNew(f, repNodeOfTy(ot), ot, "local", 1)
    const from = if id == "hole-opt-box-of-i32" { v(p) } else { v(rec) }
    const ut = mkUnionTy([TY_I32, TY_STR])
    const g = irVarNew(f, repNodeOfTy(ut), ut, "temp", -1)
    f.irBody.push(
      node(f, { lDst: g, lRhs: { hxV: from, hxAt: -1 } }, repNodeOfTy(ut)),
    )
  }
  // Rule 2: a record retag (`RRetag`) stands one plain record for another on one struct heap the
  // builder noted, whose fields lower alike; one of an i32, into an i32, into a record whose field
  // lowers to a list, or across two noted heaps is refused; the same on one noted heap holds.
  if (
    id == "record-retag-of-i32"
    || id == "record-retag-into-i32"
    || id == "record-retag-field-other-valtype"
    || id == "record-retag-two-noted-heaps"
    || id == "record-retag-one-noted-heap"
  ) {
    const ot = mkObjTy(["c0", "c1"], [TY_I32, TY_I32])
    const orep = repNodeOfTy(ot)
    const rec = irVarNew(f, orep, ot, "local", 1)
    const wt = mkObjTy(
      ["c0", "c1"],
      [
        TY_I32,
        if id == "record-retag-two-noted-heaps" || id == "record-retag-one-noted-heap" { TY_BOOL } else { mkArrayTy(TY_I32) },
      ],
    )
    const dt = if id == "record-retag-into-i32" { TY_I32 } else { wt }
    const drep = repNodeOfTy(dt)
    const from = if id == "record-retag-of-i32" { v(p) } else { v(rec) }
    const g = irVarNew(f, drep, dt, "temp", -1)
    f.irRecHeap[orep] = 1
    f.irRecHeap[drep] = if id == "record-retag-two-noted-heaps" { 2 } else { 1 }
    f.irBody.push(node(f, { lDst: g, lRhs: { rgV: from } }, drep))
  }
  // Rule 2 for a record temp whose rep notes no heap but whose build heap is noted
  // (`irVarHeapNote`): at the destination's heap with fields that lower alike it holds; at another
  // heap, or into a record whose field lowers to a list, it is refused.
  if (
    id == "value-retag-built-heap"
    || id == "value-retag-other-heap"
    || id == "value-retag-field-other-valtype"
  ) {
    const ot = mkObjTy(["c0", "c1"], [TY_I32, TY_I32])
    const orep = repNodeOfTy(ot)
    const rec = irVarNew(f, orep, ot, "local", 1)
    const wt = mkObjTy(
      ["c0", "c1"],
      [
        TY_I32,
        if id == "value-retag-field-other-valtype" { mkArrayTy(TY_I32) } else { TY_BOOL },
      ],
    )
    const drep = repNodeOfTy(wt)
    const g = irVarNew(f, drep, wt, "temp", -1)
    irVarHeapNote(f, rec, if id == "value-retag-other-heap" { 2 } else { 1 })
    f.irRecHeap[drep] = 1
    f.irBody.push(node(f, { lDst: g, lRhs: { rgV: v(rec) } }, drep))
  }
  // A width retag stands a record at a supertype the builder noted, whose fields lead it by name:
  // `{c0}` of `{c0, c1}` holds; `{c1}`, which does not lead, and `{c0}` with no noted supertype
  // pair are refused under rule 2.
  if (
    id == "width-retag-noted-leading"
    || id == "width-retag-field-not-leading"
    || id == "width-retag-pair-unnoted"
  ) {
    const ot = mkObjTy(["c0", "c1"], [TY_I32, TY_I32])
    const orep = repNodeOfTy(ot)
    const rec = irVarNew(f, orep, ot, "local", 1)
    const nt = mkObjTy(
      [if id == "width-retag-field-not-leading" { "c1" } else { "c0" }],
      [TY_I32],
    )
    const nrep = repNodeOfTy(nt)
    const g = irVarNew(f, nrep, nt, "temp", -1)
    if id != "width-retag-pair-unnoted" {
      f.irRecSub.push(orep)
      f.irRecSub.push(nrep)
    }
    f.irBody.push(node(f, { lDst: g, lRhs: { rgV: v(rec) } }, nrep))
  }
  // Rule 2: a global the builder noted as holding a record whole is still read only at its noted
  // rep; an i32 read of one noted as a bool is refused.
  if id == "held-global-read-off-noted-rep" {
    irGlobalNote(f, 0, boolr)
    f.irGlobalHeld[0] = true
    const g = irVarNew(f, i32r, TY_I32, "temp", -1)
    f.irBody.push(
      node(f, { lDst: g, lRhs: { ggSym: 0, ggNonNull: false, ggNn: -1 } }, i32r),
    )
  }
  // Rule 2 for a global read off its checked type's rep: one noted at i32, read through an untyped
  // node, whose recorded store type is bool, so nothing justifies the i32 read.
  if id == "global-read-off-store-type" {
    irGlobalNote(f, 0, i32r)
    irGlobalStoreNote(f, 0, TY_BOOL)
    const at = callNode()
    const g = irVarNew(f, i32r, TY_I32, "temp", -1)
    const rd: Rhs = { ggSym: 0, ggNonNull: false, ggNn: -1 }
    f.irBody.push(irNodeNew(f, { lDst: g, lRhs: rd }, TY_I32, i32r, at))
  }
  // Rule 8 with the bounds rule uninstalled: a bounds check must not pass unverified.
  if id == "bounds-rule-uninstalled" {
    f.irBody.push(node(f, { bcV: v(p), bcIx: v(p) }, none))
  }
  // Rule 2 against the plan a node carries: a truncation from f64 of an i32, an atomic store of an
  // i32 at an i64 row, a memory store of an i32 at an f64 width, a SIMD op over an i32 at v128.
  if id == "trunc-sat-operand-off-plan" {
    const ts: Rhs = {
      tsV: v(p),
      tsAt: callNode(),
      tsOp: 0,
      tsFrom: "f64",
      tsTo: "i32",
    }
    f.irBody.push(node(f, { efRhs: ts }, none))
  }
  if id == "atomic-value-off-plan" {
    const am: Rhs = {
      amArgs: [v(p), v(p)],
      amAt: -1,
      amBase: 2,
      amValPrims: ["", "i64"],
      amResPrim: "",
    }
    f.irBody.push(node(f, { efRhs: am }, none))
  }
  if id == "memory-store-value-off-plan" {
    const mm: Rhs = {
      mmArgs: [v(p), v(p)],
      mmAt: -1,
      mmBase: 2,
      mmPrim: "f64",
      mmName: "__store_f64__",
    }
    f.irBody.push(node(f, { efRhs: mm }, none))
  }
  if id == "simd-operand-off-plan" {
    const sd: Rhs = {
      sdArgs: [v(p)],
      sdAt: -1,
      sdMemBase: 0,
      sdPrims: ["v128"],
      sdResPrim: "",
    }
    f.irBody.push(node(f, { efRhs: sd }, none))
  }
  // Rule 2 again: a box whose immediate stands for a call, whose effect would go unread.
  // Rule 2: a boxing spread is a list of boxes, never the literal's own scalar list.
  if id == "spread-boxed-at-box-list" || id == "spread-boxed-at-scalar-list" {
    const srcTy = mkArrayTy(TY_I32)
    const src = irVarNew(f, repNodeOfTy(srcTy), srcTy, "param", 1)
    f.irParams.push(src)
    const lt = if id == "spread-boxed-at-box-list" { mkArrayTy(mkUnionTy([TY_I32, TY_STR])) } else { srcTy }
    const lr = repNodeOfTy(lt)
    const sv = irVarNew(f, lr, lt, "temp", -1)
    f.irBody.push(
      node(
        f,
        {
          lDst: sv,
          lRhs: {
            spSrcs: [v(src)],
            spGroups: [-1],
            spKind: 0,
            spSlot: 0,
            spAt: -1,
            spBoxRow: 0,
            spOwn: [],
          },
        },
        lr,
      ),
    )
  }
  if id == "box-immediate-for-call" {
    const bt = irVarNew(f, i32r, TY_I32, "temp", -1)
    f.irBody.push(
      node(
        f,
        {
          lDst: bt,
          lRhs: { bxV: imm(i32r, 1), bxAt: callNode(), bxTy: -1, bxFree: false },
        },
        i32r,
      ),
    )
  }
  // Rule 2 again: a null-typed box whose payload is an i32, landing at an i32.
  if id == "nul-none-box-of-i32" {
    const sn = irVarNew(f, i32r, TY_I32, "temp", -1)
    f.irBody.push(
      node(f, { lDst: sn, lRhs: { nnV: v(p), nnPay: true, nnAt: -1 } }, i32r),
    )
  }
  // Rule 2 again: a box planned at a union type that lands at an i32.
  if id == "box-at-union-type-into-i32" {
    const sn = irVarNew(f, i32r, TY_I32, "temp", -1)
    f.irBody.push(
      node(
        f,
        {
          lDst: sn,
          lRhs: { bxV: v(p), bxAt: callNode(), bxTy: TY_I32, bxFree: false },
        },
        i32r,
      ),
    )
  }
  // Rule 2: a value `if` written at a box whose out is an i32, and one whose arm assigns its box
  // an i32 the lowering did not box.
  if id == "if-at-box-writes-i32" || id == "if-at-box-arm-delivers-i32" {
    const ut = mkUnionTy([TY_I32, TY_STR])
    const bad = id == "if-at-box-writes-i32"
    const o = if bad { irVarNew(f, i32r, TY_I32, "local", 1) } else { irVarNew(f, repNodeOfTy(ut), ut, "local", 1) }
    const w = if bad { irVarNew(f, i32r, TY_I32, "local", 2) } else { irVarNew(f, repNodeOfTy(ut), ut, "local", 2) }
    const src = if bad { v(w) } else { v(p) }
    const thenB = [node(f, { asDst: o, asSrc: src }, none)]
    const elseB = [node(f, { asDst: o, asSrc: v(w) }, none)]
    const s = sIf(imm(boolr, 1), thenB, elseB, o, true)
    s.siAtDst = true
    f.irBody.push(node(f, s, none))
  }
  // A call's effect ends its path only when the call never returns: a bare return after a call
  // that returns (rule 5) or never does, and a `pop ?? d` default that is a returning call, which
  // leaves the out unwritten (rule 5), or a never-returning one.
  if (
    id == "dead-return-after-returning-call"
    || id == "pop-or-default-returning-call"
    || id == "pop-or-default-never-call"
    || id == "dead-return-after-never-call"
  ) {
    irSigNote(f, 0, [i32r], i32r)
    const c: Rhs = {
      caCallee: 0,
      caArgs: [v(p)],
      caNever: id == "pop-or-default-never-call"
        || id == "dead-return-after-never-call",
      caEnv: false,
      caCaps: [],
      caWb: [],
    }
    if (
      id == "dead-return-after-returning-call"
      || id == "dead-return-after-never-call"
    ) {
      f.irBody.push(node(f, { efRhs: c }, none))
      f.irBody.push(node(f, { rtHas: false, rtV: v(-1) }, none))
      return f
    }
    const lt = mkArrayTy(TY_I32)
    const l = irVarNew(f, repNodeOfTy(lt), lt, "local", 1)
    const o = irVarNew(f, i32r, TY_I32, "local", 2)
    const d: i32[] = [node(f, { efRhs: c }, none)]
    f.irBody.push(
      node(
        f,
        {
          cbL: v(l),
          cbLB: [],
          cbArm: "popOr",
          cbNull: d,
          cbOut: o,
          cbAt: -1,
          cbMap: null,
          cbIdx: null,
        },
        i32r,
      ),
    )
  }
  // A never call's value at its consumer's rep holds; a returning call's temp typed `never` breaks
  // A dead never read's value (`RDeadNever`) is a temp of type `never` at its consumer's rep, as a
  // never call's is (rule 3 holds); bound to a local of that type at an `i32` rep it breaks rule 3.
  if (
    id == "dead-never-temp-at-consumer-rep"
    || id == "dead-never-bound-to-non-temp"
  ) {
    const temp = id == "dead-never-temp-at-consumer-rep"
    const g = if temp { irVarNew(f, i32r, TY_NEVER, "temp", -1) } else { irVarNew(f, i32r, TY_NEVER, "local", 1) }
    f.irBody.push(node(f, { lDst: g, lRhs: { dnAt: -1, dnPad: false } }, i32r))
    const h = irVarNew(f, i32r, TY_I32, "temp", -1)
    const add: Rhs = { poOp: "add", poArgs: [v(g), imm(i32r, 1)] }
    f.irBody.push(node(f, { lDst: h, lRhs: add }, i32r))
    f.irBody.push(node(f, { dpV: v(h) }, none))
  }
  // rule 3, and the never value assigned into a bool breaks rule 2 at that consumer.
  if (
    id == "never-call-value-at-consumer-rep"
    || id == "returning-call-temp-typed-never"
    || id == "never-call-value-into-bool"
  ) {
    const nv = id != "returning-call-temp-typed-never"
    irSigNote(f, 0, [i32r], if nv { none } else { i32r })
    const g = irVarNew(f, i32r, TY_NEVER, "temp", -1)
    const c: Rhs = {
      caCallee: 0,
      caArgs: [v(p)],
      caNever: nv,
      caEnv: false,
      caCaps: [],
      caWb: [],
    }
    f.irBody.push(node(f, { lDst: g, lRhs: c }, i32r))
    if id == "never-call-value-into-bool" {
      const bl = irVarNew(f, boolr, TY_BOOL, "local", 1)
      f.irBody.push(node(f, { asDst: bl, asSrc: v(g) }, none))
    } else {
      const h = irVarNew(f, i32r, TY_I32, "temp", -1)
      const add: Rhs = { poOp: "add", poArgs: [v(g), imm(i32r, 1)] }
      f.irBody.push(node(f, { lDst: h, lRhs: add }, i32r))
      f.irBody.push(node(f, { dpV: v(h) }, none))
    }
  }
  // A union cast's operand is a box or a boxed nullable's null-tagged box; a niche nullable or an
  // i32 breaks rule 2.
  if (
    id == "union-cast-of-box"
    || id == "union-cast-of-boxed-nullable"
    || id == "union-cast-of-niche-nullable"
    || id == "union-cast-of-i32"
  ) {
    const ut = mkUnionTy([TY_I32, TY_STR])
    const ot = if id == "union-cast-of-box" { ut } else if id == "union-cast-of-boxed-nullable" { mkNullableTy(ut) } else if id == "union-cast-of-niche-nullable" { mkNullableTy(mkObjTy(["a"], [TY_I32])) } else { TY_I32 }
    const o = irVarNew(f, repNodeOfTy(ot), ot, "local", 1)
    const g = irVarNew(f, i32r, TY_I32, "temp", -1)
    f.irBody.push(node(f, { lDst: g, lRhs: { auV: v(o), auAt: -1 } }, i32r))
    f.irBody.push(node(f, { dpV: v(g) }, none))
  }
  // The same through a closure: a never closure call's temp at its consumer's rep holds, and a
  // returning one's temp typed `never` breaks rule 3.
  if (
    id == "never-closure-call-value-at-consumer-rep"
    || id == "returning-closure-call-temp-typed-never"
  ) {
    const cr = repClosureOfReps([i32r], i32r, false)
    const cv = irVarNew(f, cr, -1, "local", 1)
