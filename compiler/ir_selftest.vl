// The verifier's own cases: hand-built IR breaking each of rules 1-7, more for rules 5, 2 and 8,
// the fused `pop ?? d`'s three, and one function that holds.
// A host test calls `irVerifySelfTest(k)` once the checker's primitives exist (after any
// compile) and compares the rule the verifier names with `k`.
import {
  IrFn,
  IrNode,
  Opnd,
  Rhs,
  irFnNew,
  irGlobalNote,
  irNodeNew,
  irSigNote,
  irVarNew,
} from "./ir"
import { irVerify } from "./ir_verify"
import { repNodeOfTy } from "./emit_rep"
import { TY_BOOL, TY_I32, TY_NEVER, mkArrayTy } from "./check_types"
import { Call, addNode } from "./ast"
import { CoalValArm } from "./emit_plan_null"

function node(f: IrFn, n: IrNode, rep: i32): i32 {
  return irNodeNew(f, n, -1, rep, -1)
}

function v(x: i32): Opnd {
  const o: Opnd = { ov: x }
  return o
}

function imm(rep: i32, b: i64): Opnd {
  const o: Opnd = { oiRep: rep, oiBits: b }
  return o
}

// `f(p: i32): i32 { t = p + 1; return t }`, broken the way case `k` names (0: not broken).
function caseFn(k: i32): IrFn {
  const i32r = repNodeOfTy(TY_I32)
  const boolr = repNodeOfTy(TY_BOOL)
  const none = repNodeOfTy(TY_NEVER)
  const f = irFnNew(-1, "selftest")
  f.irRetRep = i32r
  f.irRetTy = TY_I32
  const p = irVarNew(f, i32r, TY_I32, "param", 0)
  f.irParams.push(p)
  const t = irVarNew(f, i32r, TY_I32, "temp", -1)
  // Rule 1: a variable whose rep is outside the tree.
  if k == 1 { irVarNew(f, -7, TY_I32, "local", 1) }
  // Rule 3: a variable whose rep is not its type's.
  if k == 3 { irVarNew(f, boolr, TY_I32, "local", 1) }
  // Rule 2: a comparison's bool result into an i32 destination.
  const op: Rhs = if k == 2 { { poOp: "lt", poArgs: [v(p), v(p)] } } else { { poOp: "add", poArgs: [v(p), imm(i32r, 1)] } }
  // Rule 4: the definition is left out, so the return reads `t` undefined.
  if k != 4 { f.irBody.push(node(f, { lDst: t, lRhs: op }, i32r)) }
  // Rule 5: a branch to a label nothing encloses.
  if k == 5 {
    f.irBody.push(node(f, { brLabel: 9, brHas: false, brVal: v(t) }, none))
  }
  // Rule 6: a call passing one argument to a callee that takes two.
  if k == 6 {
    irSigNote(f, 0, [i32r, i32r], i32r)
    const c: Rhs = {
      caCallee: 0,
      caArgs: [v(p)],
      caNever: false,
      caEnv: false,
      caCaps: [],
    }
    f.irBody.push(node(f, { efRhs: c }, none))
  }
  // Rule 7: a switch over an i32, which has no arms.
  if k == 7 { f.irBody.push(node(f, { swOn: p, swArms: [], swOut: -1 }, none)) }
  // Rule 5 again: the body ends in an `if` whose arms fall through, and nothing returns.
  if k == 8 {
    f.irBody.push(
      node(
        f,
        {
          siCond: imm(boolr, 1),
          siThen: [],
          siElse: [],
          siOut: -1,
          siElseKw: false,
        },
        none,
      ),
    )
    return f
  }
  // Rule 2 again: an i32 stored into a global recorded as a bool.
  if k == 9 {
    irGlobalNote(f, 0, boolr)
    f.irBody.push(node(f, { gsSym: 0, gsSrc: v(p) }, none))
  }
  // Rule 8 with the bounds rule uninstalled: a bounds check must not pass unverified.
  if k == 10 { f.irBody.push(node(f, { bcV: v(p), bcIx: v(p) }, none)) }
  // Rule 2 again: a box whose immediate stands for a call, whose effect would go unread.
  if k == 11 {
    const bt = irVarNew(f, i32r, TY_I32, "temp", -1)
    f.irBody.push(
      node(f, { lDst: bt, lRhs: { bxV: imm(i32r, 1), bxAt: callNode() } }, i32r),
    )
  }
  // Rules for a fused `pop ?? d`: case 12 pops an i32, case 13 yields a bool from an `i32[]`, and
  // case 14's default never writes the out.
  if k >= 12 && k <= 14 {
    const lt = mkArrayTy(TY_I32)
    const l = irVarNew(f, repNodeOfTy(lt), lt, "local", 1)
    const or = if k == 13 { boolr } else { i32r }
    const o = irVarNew(
      f,
      or,
      if k == 13 { TY_BOOL } else { TY_I32 },
      "local",
      2,
    )
    const d: i32[] = []
    if k != 14 { d.push(node(f, { asDst: o, asSrc: imm(or, 0) }, none)) }
    const from = if k == 12 { v(p) } else { v(l) }
    f.irBody.push(
      node(f, { cbL: from, cbArm: "popOr", cbNull: d, cbOut: o, cbAt: -1 }, or),
    )
  }
  // Rules for a record field's `??`: case 15 keeps the box into an i32 out, and case 16 re-reads an
  // immediate receiver.
  if k == 15 || k == 16 {
    const o = irVarNew(f, i32r, TY_I32, "local", 1)
    const d: i32[] = [node(f, { asDst: o, asSrc: imm(i32r, 0) }, none)]
    const from = if k == 15 { v(p) } else { imm(i32r, 1) }
    const arm: CoalValArm = if k == 15 { "fieldBox" } else { "fieldScalar" }
    f.irBody.push(
      node(f, { cbL: from, cbArm: arm, cbNull: d, cbOut: o, cbAt: -1 }, i32r),
    )
  }
  f.irBody.push(node(f, { rtHas: true, rtV: v(t) }, none))
  return f
}

// A synthesized call node: a call has an effect, so an immediate cannot stand for it.
function callNode(): i32 {
  const c: Call = { callFn: -1, callArgs: [], callArgNames: [], pos: -1 }
  return addNode(c)
}

// The rule the verifier names for case `k`: 0 for the function that holds, `k` for cases 1 to 7,
// 5 for case 8 (a fall-through), 2 for cases 9, 11, 12 and 13 (a global store, a box's effectful
// immediate, a pop of no list or at no element), 8 for case 10 (a bounds check with no bounds
// rule installed), 5 for case 14 (a default that leaves the out unwritten) and 2 for cases 15 and
// 16 (a field `??` keeping a box into a scalar, or re-reading no variable).
export function irVerifySelfTest(k: i32): i32 {
  return irVerify(caseFn(k)).vfRule
}
