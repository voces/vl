// A module's interface hash: what its dependents can observe of it, so a module whose hash and
// whose imports' hashes are unchanged leaves every dependent's check and emit unchanged (S5 in
// incremental-compilation-design.md, steps 4 and 5). A declaration is exposed when a dependent
// can reach it: an export, a top-level `let` or statement (the entry's start runs them), or a
// name an exposed declaration's tokens or checked type spell. An exposed declaration gives its
// tokens, with every body cut that no caller checks, and its checked type; a function reached
// only by a call from a cut body gives just the names its body mentions and how. Armed only by
// a test or a probe; the build never reads it.
import { declTyOf } from "./check_nar_store"
import {
  AsExpr,
  Call,
  FieldDef,
  FieldInit,
  FuncDecl,
  IsExpr,
  LetDecl,
  Member,
  ObjLit,
  OptMember,
  P,
  Param,
  Program,
  TypeDecl,
  TypeRef,
  UnionDecl,
  nodeAt,
} from "./ast"
import { i32ToStr, nodeToks } from "./ast"
import { nodeLastTok, nodeStartTok } from "./fmt_util"
import { TokKind, isIdPart } from "./lexer"
import {
  T,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  cUserTypes,
  tyAt,
  tyMayHoldFn,
  tyToStr,
} from "./check_types"
import { nodeTyIxOf } from "./check_node_tys"
import { tyHasTyVar, tyReachesHole } from "./tyquery"
import { strListHas } from "./listutil"
import { recFnValueLeaves } from "./check_type_shape"
import { cwPeel } from "./check_write_scan"

let ihArmed = false
// Ingredients a mutation check removes, one bit each (see `ifaceHashDrop`).
let ihDrop = 0
const IH_KEEP_GENERIC = 1
const IH_KEEP_UNTYPED_PARAM = 2
const IH_SHOW_INFERRED_RET = 4
const IH_NO_TYPES = 8
const IH_NO_MENTIONS = 16
const IH_NO_DEEP = 32
const IH_NO_INFERRED_TYPE = 64
const IH_NO_ELIDED_GUARD = 128
const IH_ALL_EXPOSED = 256
const IH_NO_TYPE_NAMES = 512
const IH_NO_LET_ROOTS = 1024
const IH_NO_CALLEES = 2048
const IH_NO_TOKEN_NAMES = 4096
const IH_NO_CROSS = 8192
const IH_NO_AMBIENT = 16384
const IH_NO_DECOR = 131072
const IH_NO_IMPORT_MAP = 262144
const IH_NO_AMB_FIELDS = 524288
const IH_NO_AMB_NAMES = 1048576
const IH_NO_AMB_RECV = 2097152
const IH_NO_AMB_NEAR = 4194304
const IH_NO_AMB_GENERIC = 8388608
const IH_NO_REACH_TOKENS = 16777216
const IH_NO_AMB_ARENA = 33554432
const IH_NO_AMB_SHADOW = 67108864

// Statement kinds.
const IH_ST_ROOT = 0
const IH_ST_FN = 1
const IH_ST_LET = 2
const IH_ST_TYPE = 3

// Per module table index, filled by one compile.
let ihKeys: string[] = []
let ihOwn: i32[] = []
let ihDeepOf: i32[] = []
let ihSpan: i32[] = []
let ihCut: i32[] = []
let ihFns: i32[] = []
let ihExposedFns: i32[] = []
// Per top-level statement, in source order; tokens outside every statement are a root of their own.
let ihStMod: i32[] = []
let ihStKind: i32[] = []
let ihStName: string[] = []
let ihStMerged: string[] = []
// The declaration a `fn` or `let` row binds, from its own statement node; -1 for any other row.
let ihStDecl: i32[] = []
let ihStExported: boolean[] = []
let ihStTok: i32[] = []
let ihStSpan: i32[] = []
let ihStCutRet: boolean[] = []
let ihStCutAny: boolean[] = []
let ihStBody: i32[] = []
let ihStMen: i32[] = []
// The top-level names a statement's hashed tokens spell (`ihStIdLo`..`ihStIdHi` into `ihIds`),
// and the names its body mentions (`ihStCallLo`..`ihStCallHi` into `ihCalls`).
let ihStIdLo: i32[] = []
let ihStIdHi: i32[] = []
let ihIds: string[] = []
let ihStCallLo: i32[] = []
let ihStCallHi: i32[] = []
let ihCalls: string[] = []
// Import edges: module `ihEdgeFrom[e]` reads module `ihEdgeTo[e]`.
let ihEdgeFrom: i32[] = []
let ihEdgeTo: i32[] = []
// A statement's whole token range and its hash, whether it declares something another
// module's check reads without importing it (`ihAmbientScan`).
let ihStLo: i32[] = []
let ihStHi: i32[] = []
let ihStCutLo: i32[] = []
let ihStCutHi: i32[] = []
let ihStFull: i32[] = []
let ihStFullOk: boolean[] = []
// Whether this run keeps only what the ambient and write-question reads use: no statement text or
// position hash, and each statement's full-token hash on first read (`ihFullOf`).
let ihLean = false
let ihStAmb: boolean[] = []
// Ambient keys, per statement `ihAkSt[k]`: a declared name, a method's or getter's name, one
// record level's field names, or the `new` type an operator takes, as `ihAkW[ihAkLo[k],
// ihAkHi[k])`. An ambient statement that no key bounds is wild. `ihDeclsOf` holds each type
// name's declarations.
const IH_AK_NAME = 0
const IH_AK_RECV = 1
const IH_AK_FIELDS = 2
const IH_AK_OPER = 3
let ihStWild: boolean[] = []
// Per statement: whether it declares a type a render may name another type by.
let ihStNames: boolean[] = []
let ihAkSt: i32[] = []
let ihAkKind: i32[] = []
let ihAkLo: i32[] = []
let ihAkHi: i32[] = []
let ihAkW: string[] = []
let ihAkName: string[] = []
// Per key: whether it is a `self` method's name, which only a member call `.name(` or `.name<` reaches.
let ihAkCall: boolean[] = []
// Per key: the ordered field names and built-in field types of the record a plain declaration
// declares, or 0 when the key is not such a declaration's (`ihTwinShape`).
let ihAkShape: i32[] = []
// Per key: a declared record's field types aligned with its names, a primitive's name or "" for
// any other type, or [] when the key is no declaration's.
let ihAkTys: string[][] = []
let ihDeclsOf: {[string]: i32[]} = Map()
// Object literals: statement `ihLitSt[k]` builds one whose field-name set is `ihLitKey[k]`,
// with `ihLitRep[k]` when it repeats a name.
let ihLitSt: i32[] = []
let ihLitKey: string[] = []
let ihLitRep: boolean[] = []
// Per literal: 1 when it is an argument of a member call `x.m(`, 2 of a plain call, else 0.
let ihLitArg: i32[] = []
// Per literal: 2 when a non-generic function with a declared result returns it as it stands, 1
// when another function does and `IH_LOOSE_SETTLED` is on, else 0.
let ihLitSettled: i32[] = []
// Import rows: module `ihImpMod[k]` binds `ihImpLocal[k]` to `ihImpOName[k]` of module
// `ihImpOMod[k]`, the declaring one; an empty name is a namespace import.
let ihImpMod: i32[] = []
let ihImpLocal: string[] = []
let ihImpOMod: i32[] = []
let ihImpOName: string[] = []
// Per module: the digest of its ambient statements, the digest of every
// top-level declaration with bodies cut, and the digest of its import rows.
let ihAmb: i32[] = []
let ihDecor: i32[] = []
let ihImpMap: i32[] = []
// From the last `ihFinish`: each statement's rendered type, and statements by module and name.
let ihShown: string[] = []
let ihByName: {[string]: i32[]} = Map()
let ihByAny: {[string]: i32[]} = Map()
// `ihReachOf`'s marks, stamped per call so a call costs its closure, not the table.
let ihExpStamp: i32[] = []
let ihStamp = 0
let ihImpAt: {[string]: i32} = Map()
let ihImpRowsOf: i32[][] = []
// The mask `ihTokDigests` last folded under, or -1 before it runs.
let ihDigMask = -1
// Per statement, built on first reach: its exposed successors as a range of `ihSucc`, and its
// exposed row.
let ihSucc: i32[] = []
let ihSuccMark: i32[] = []
let ihSuccGen = 0
let ihQLo: i32[] = []
let ihQHi: i32[] = []
let ihQDone: boolean[] = []
let ihQMemo: i32[] = []
// Per module, the import adjacency and, built on first reach, the modules below it.
let ihAdj: i32[][] = []
let ihDownMemo: boolean[][] = []

// Arm the hash for later module compiles (`on` 1), or disarm it (0).
export function ifaceHashArm(on: i32): i32 {
  ihArmed = on != 0
  0
}

export function ifaceHashArmed(): boolean { ihArmed }

// Drop ingredients from later hashes, a bit mask; the soundness suite's mutation check.
export function ifaceHashDrop(mask: i32): i32 {
  ihDrop = mask
  0
}

// Fold the last armed check's rows again under `mask`, so one check yields every mask's hashes.
export function ifaceHashRefold(mask: i32): i32 {
  ihDrop = mask
  ihFinish()
}

function ihOn(bit: i32): boolean { (ihDrop & bit) != 0 }

function ihMixByte(h: i32, b: i32): i32 { (h ^ b) * 16777619 }

function ihMixInt(h: i32, v: i32): i32 {
  let x = ihMixByte(h, v & 255)
  x = ihMixByte(x, (v >> 8) & 255)
  x = ihMixByte(x, (v >> 16) & 255)
  ihMixByte(x, (v >> 24) & 255)
}

// An order-free digest of a set of texts: its size and the sum of their hashes.
export function ihTextSetHash(xs: string[]): i32 {
  let sum = 0
  for x in xs { sum = sum + ihMixStr(IH_SEED, x) }
  ihMixInt(sum, xs.length)
}

function ihMixStr(h: i32, s: string): i32 {
  let x = ihMixInt(h, s.length)
  let i = 0
  while i < s.length {
    x = ihMixByte(x, s[i])
    i = i + 1
  }
  x
}

const IH_SEED = -2128831035

// Forget the previous graph and size the tables to `keys`, the module table.
export function ihBegin(keys: string[]): i32 {
  ihKeys = keys
  ihOwn = []
  ihDeepOf = []
  ihSpan = []
  ihCut = []
  ihFns = []
  ihExposedFns = []
  ihStMod = []
  ihStKind = []
  ihStName = []
  ihStMerged = []
  ihStDecl = []
  ihStExported = []
  ihStTok = []
  ihStSpan = []
  ihStCutRet = []
  ihStCutAny = []
  ihStBody = []
  ihStMen = []
  ihStIdLo = []
  ihStIdHi = []
  ihIds = []
  ihStCallLo = []
  ihStCallHi = []
  ihCalls = []
  ihEdgeFrom = []
  ihEdgeTo = []
  ihStLo = []
  ihStHi = []
  ihStCutLo = []
  ihStCutHi = []
  ihStFull = []
  ihStFullOk = []
  ihStAmb = []
  ihImpMod = []
  ihImpLocal = []
  ihImpOMod = []
  ihImpOName = []
  ihAmb = []
  ihDecor = []
  ihImpMap = []
  ihShown = []
  ihByName = Map()
  ihByAny = Map()
  ihExpStamp = []
  ihImpAt = Map()
  ihImpRowsOf = []
  ihDigMask = -1
  let i = 0
  while i < keys.length {
    ihOwn.push(IH_SEED)
    ihDeepOf.push(IH_SEED)
    ihSpan.push(IH_SEED)
    ihCut.push(0)
    ihFns.push(0)
    ihExposedFns.push(0)
    ihAmb.push(IH_SEED)
    ihDecor.push(IH_SEED)
    ihImpMap.push(IH_SEED)
    i = i + 1
  }
  0
}

// Module `m` binds `local` to `name` of module `origin`, the module declaring it; an empty
// `name` binds the whole of `origin`.
export function ihImport(
  m: i32,
  local: string,
  origin: i32,
  name: string,
): i32 {
  ihImpMod.push(m)
  ihImpLocal.push(local)
  ihImpOMod.push(origin)
  ihImpOName.push(name)
  0
}

export function ihEdge(from: i32, to: i32): i32 {
  ihEdgeFrom.push(from)
  ihEdgeTo.push(to)
  0
}

// Whether a caller's check reads the function's body: it has a type parameter or an
// unannotated parameter. An inferred return is read through the checked type instead.
function ihBodyVisible(fd: FuncDecl): boolean {
  if fd.fnTyParams.length > 0 && !ihOn(IH_KEEP_GENERIC) { return true }
  let i = 0
  while i < fd.fnParams.length {
    const pn = nodeAt(fd.fnParams[i])
    if pn is Param {
      if pn.parType < 0 && !ihOn(IH_KEEP_UNTYPED_PARAM) { return true }
    }
    i = i + 1
  }
  false
}

// The token index of the `{` that opens the block whose `}` is token `close`, or -1.
function ihOpenOf(close: i32, lo: i32): i32 {
  if close < lo || close >= P.toks.length { return -1 }
  if P.toks[close].kind != "RBRACE" { return -1 }
  let depth = 0
  let i = close
  while i >= lo {
    const k = P.toks[i].kind
    const closes = k == "RBRACE"
    const opens = k == "LBRACE"
    if closes { depth = depth + 1 }
    if opens {
      depth = depth - 1
      if depth == 0 { return i }
    }
    i = i - 1
  }
  -1
}

function ihIsAssignOp(k: TokKind): boolean {
  k == "EQUAL"
    || k == "PLUSEQ"
    || k == "MINUSEQ"
    || k == "STAREQ"
    || k == "SLASHEQ"
    || k == "PERCENTEQ"
    || k == "AMPEQ"
    || k == "PIPEEQ"
    || k == "CARETEQ"
    || k == "SHLEQ"
    || k == "SHREQ"
    || k == "USHREQ"
    || k == "PLUSPLUS"
    || k == "MINUSMINUS"
}

// How the mention at token `i` uses its name: `w` written through, `c` called, `m` a method
// called on it, `d` a member of something else, `r` read.
function ihMentionKind(i: i32, hi: i32): string {
  if i > 0 {
    const pk = P.toks[i - 1].kind
    if pk == "DOT" || pk == "QUESTION_DOT" { return "d" }
  }
  let j = i + 1
  let path = 0
  let more = true
  while more && j < hi {
    const k = P.toks[j].kind
    if (
      (k == "DOT" || k == "QUESTION_DOT")
      && j + 1 < hi
      && P.toks[j + 1].kind == "IDENT"
    ) {
      j = j + 2
      path = path + 1
    } else if k == "LBRACK" {
      let depth = 0
      let stop = false
      while !stop && j < hi {
        const bk = P.toks[j].kind
        if bk == "LBRACK" { depth = depth + 1 }
        if bk == "RBRACK" {
          depth = depth - 1
          if depth == 0 { stop = true }
        }
        j = j + 1
      }
      path = path + 1
    } else {
      more = false
    }
  }
  if j >= hi { return "r" }
  const nk = P.toks[j].kind
  if ihIsAssignOp(nk) { return "w" }
  if nk == "LPAREN" {
    if path == 0 { return "c" }
    return "m"
  }
  "r"
}

// The order-free hash of the names body `[lo, hi)` mentions out of `seen` and its own
// parameters `ps`, with how; each top-level name it mentions is pushed on `ihCalls`.
function ihMentions(
  lo: i32,
  hi: i32,
  seen: {[string]: boolean},
  ps: string[],
): i32 {
  const got: {[string]: boolean} = Map()
  let sum = 0
  let i = lo
  while i < hi {
    const t = P.toks[i]
    if t.kind == "IDENT" {
      const top = seen.has(t.text)
      if top || strListHas(ps, t.text) {
        const row = ihMentionKind(i, hi) + ":" + t.text
        if !got.has(row) {
          got[row] = true
          sum = sum + ihMixStr(IH_SEED, row)
          if top { ihCalls.push(t.text) }
        }
      }
    }
    i = i + 1
  }
  sum
}

// The source spelling of a merged top-level name: `name$mN` without its suffix.
export function ihSourceName(name: string): string {
  let i = name.length - 1
  while i > 0 {
    if name[i] == '$' && i + 1 < name.length && name[i + 1] == 'm' {
      return name.slice(0, i)
    }
    i = i - 1
  }
  name
}

// The tokens `[a, b)` minus the cut `[cutLo, cutHi)` (none when `cutLo` < 0) into the
// current statement: its text hash, its position hash, and the top-level names it spells.
function ihTokens(
  a: i32,
  b: i32,
  cutLo: i32,
  cutHi: i32,
  tops: {[string]: boolean},
) {
  let h = IH_SEED
  let sp = IH_SEED
  let cut = cutLo
  let i = a
  while i < b && ihLean {
    const t = P.toks[i]
    if t.kind == "IDENT" && tops.has(t.text) { ihIds.push(t.text) }
    i = i + 1
  }
  while i < b {
    // The cut fires once: an empty body has `cutLo == cutHi`, and the jump lands on it again.
    if i == cut {
      h = ihMixStr(h, "{cut}")
      cut = -1
      i = cutHi
    } else {
      const t = P.toks[i]
      h = ihMixStr(h, t.text)
      sp = ihMixInt(ihMixInt(sp, t.line), t.col)
      if t.kind == "IDENT" && tops.has(t.text) { ihIds.push(t.text) }
      i = i + 1
    }
  }
  ihStTok.push(h)
  ihStSpan.push(sp)
  ihStLo.push(a)
  ihStHi.push(b)
  ihStCutLo.push(cutLo)
  ihStCutHi.push(cutHi)
  ihStFull.push(if ihLean { 0 } else { ihTokHash(a, b) })
  ihStFullOk.push(!ihLean)
}

// Statement `s`'s full-token hash, hashed on first read under `ihLean`.
function ihFullOf(s: i32): i32 {
  if !ihStFullOk[s] {
    ihStFull[s] = ihTokHash(ihStLo[s], ihStHi[s])
    ihStFullOk[s] = true
  }
  ihStFull[s]
}

// Keep only what the ambient and write-question reads use, from the next `ihModule` on.
export function ihSetLean(on: boolean): i32 {
  ihLean = on
  0
}

// Open a statement row of module `m`; `ihTokens` and `ihStClose` complete it.
function ihStOpen(
  m: i32,
  kind: i32,
  merged: string,
  decl: i32,
  exported: boolean,
) {
  ihStMod.push(m)
  ihStKind.push(kind)
  ihStMerged.push(merged)
  ihStDecl.push(decl)
  ihStName.push(ihSourceName(merged))
  ihStExported.push(exported)
  ihStIdLo.push(ihIds.length)
  ihStCallLo.push(ihCalls.length)
}

function ihStClose(cutRet: boolean, cutAny: boolean, body: i32, men: i32) {
  ihStCutRet.push(cutRet)
  ihStCutAny.push(cutAny)
  ihStBody.push(body)
  ihStMen.push(men)
  ihStIdHi.push(ihIds.length)
  ihStCallHi.push(ihCalls.length)
}

// The tokens `[a, b)` that belong to no top-level statement (an import, a re-export) as a root.
function ihOrphans(m: i32, a: i32, b: i32, tops: {[string]: boolean}) {
  if a >= b { return 0 }
  ihStOpen(m, IH_ST_ROOT, "", -1, false)
  ihTokens(a, b, -1, -1, tops)
  ihStClose(false, false, IH_SEED, 0)
  0
}

function ihAkRow(at: i32, kind: i32, ws: string[]): void {
  ihAkSt.push(at)
  ihAkKind.push(kind)
  ihAkLo.push(ihAkW.length)
  for w in ws { ihAkW.push(w) }
  ihAkHi.push(ihAkW.length)
  ihAkName.push(ihSetName(ws))
  ihAkCall.push(false)
  ihAkShape.push(0)
  ihAkTys.push([])
  if kind == IH_AK_FIELDS && ihHasRepeat(ws) { ihMarkWild(at) }
}

// An order-free name of a set of names: its members sorted and joined by `,`, so two sets
// share a name only when they hold the same names.
function ihSetName(ws: string[]): string {
  const s: string[] = []
  for w in ws {
    let i = s.length
    s.push(w)
    while i > 0 && ihStrAfter(s[i - 1], w) {
      s[i] = s[i - 1]
      i = i - 1
    }
    s[i] = w
  }
  let out = ""
  let j = 0
  while j < s.length {
    if j > 0 { out = out + "," }
    out = out + s[j]
    j = j + 1
  }
  out
}

// Whether `a` sorts after `b` byte by byte, a prefix first.
function ihStrAfter(a: string, b: string): boolean {
  let i = 0
  while i < a.length && i < b.length {
    if a[i] != b[i] { return a[i] > b[i] }
    i = i + 1
  }
  a.length > b.length
}

function ihHasRepeat(ws: string[]): boolean {
  let i = 0
  while i < ws.length {
    let j = i + 1
    while j < ws.length {
      if ws[i] == ws[j] { return true }
      j = j + 1
    }
    i = i + 1
  }
  false
}

// A declared type's name without its parameters or its block-scope suffix.
function ihDeclBase(name: string): string {
  let i = 0
  while i < name.length {
    if name[i] == '<' || name[i] == '$' { return name.slice(0, i) }
    i = i + 1
  }
  name
}

// The keys a generic application of `head` adds to statement `at`: every record level of every
// declaration of that name, or wild when none is declared.
function ihHeadKeys(head: string, at: i32, seen: string[]): void {
  for h in seen {
    if h == head { return }
  }
  seen.push(head)
  const ds = ihDeclsOf[ihDeclBase(head)] ?? []
  if ds.length == 0 { ihStWild[at] = true }
  for d in ds { ihDeclKeys(d, at, seen) }
}

// Declaration `x`'s record levels as keys of statement `at`.
function ihDeclKeys(x: i32, at: i32, seen: string[]): void {
  const nd = nodeAt(x)
  if nd is TypeDecl {
    const ws: string[] = []
    const tys: string[] = []
    let ok = true
    for f in nd.tdFields {
      let typed = false
      if f >= 0 {
        const fd = nodeAt(f)
        if fd is FieldDef {
          ws.push(fd.fdName)
          if fd.fdType >= 0 {
            const ft = nodeAt(fd.fdType)
            if ft is TypeRef {
              ihSpellKeys(ft.tyName, at, seen)
              typed = true
              tys.push(ihSpellClass(ft.tyName))
            }
          }
        }
      }
      if !typed { ok = false }
    }
    if ok {
      ihAkRow(at, IH_AK_FIELDS, ws)
      ihAkTys[ihAkTys.length - 1] = tys
    } else {
      ihMarkWild(at)
    }
  } else if nd is UnionDecl {
    for v in nd.udVariants { ihSpellKeys(v, at, seen) }
  } else {
    ihMarkWild(at)
  }
}

// A hash of a plain record declaration's ordered field names and field types when every type is
// a built-in scalar no module redeclares, else 0. Two declarations of one shape are one type.
function ihTwinShape(nd: TypeDecl): i32 {
  if nd.tdNew != 0 || nd.tdFlat != 0 || nd.tdName.indexOf("<") >= 0 { return 0 }
  let h = IH_SEED
  for f in nd.tdFields {
    if f < 0 { return 0 }
    const fd = nodeAt(f)
    if !(fd is FieldDef) || fd.fdType < 0 { return 0 }
    const ft = nodeAt(fd.fdType)
    if !(ft is TypeRef) || !ihScalarName(ft.tyName) { return 0 }
    h = ihMixStr(ihMixStr(h, fd.fdName), ft.tyName)
  }
  if h == 0 { 1 } else { h }
}

function ihScalarName(n: string): boolean {
  const scalar = n == "i32"
    || n == "i64"
    || n == "f32"
    || n == "f64"
    || n == "u8"
    || n == "u32"
    || n == "u64"
    || n == "boolean"
    || n == "string"
  scalar && !ihDeclsOf.has(n)
}

// Whether `n` names a primitive the check stores by that name, which no module redeclares.
function ihPrimName(n: string): boolean {
  const prim = n == "i32"
    || n == "i64"
    || n == "f32"
    || n == "f64"
    || n == "boolean"
    || n == "string"
  prim && !ihDeclsOf.has(n)
}

// Whether `head` is the built-in `Map` or `Set` and no module declares that name. Its instance
// holds no record level of its own, and its arguments are keyed where they are spelled.
function ihBuiltinHead(head: string): boolean {
  const base = ihDeclBase(head)
  if base != "Map" && base != "Set" { return false }
  ihOn(IH_NO_AMB_SHADOW) || !ihDeclsOf.has(base)
}

// A statement no key bounds: any check may read it.
function ihMarkWild(at: i32): void { ihStWild[at] = true }

// The index past the quoted literal opening at `s[i]`.
function ihSkipQuoted(s: string, i: i32): i32 {
  const q = s[i]
  let j = i + 1
  while j < s.length && s[j] != q {
    if s[j] == '\\' { j = j + 1 }
    j = j + 1
  }
  j + 1
}

// The index past a field's type spelling starting at `s[i]`: the first `,` or closing bracket
// outside any bracket or quote.
function ihFieldTyEnd(s: string, i: i32): i32 {
  let depth = 0
  let j = i
  while j < s.length {
    const c = s[j]
    if c == '"' || c == '\'' {
      j = ihSkipQuoted(s, j)
    } else if c == '=' && j + 1 < s.length && s[j + 1] == '>' {
      j = j + 2
    } else {
      if c == '{' || c == '(' || c == '[' || c == '<' { depth = depth + 1 }
      if c == '}' || c == ')' || c == ']' || c == '>' {
        if depth == 0 { return j }
        depth = depth - 1
      }
      if c == ',' && depth == 0 { return j }
      j = j + 1
    }
  }
  s.length
}

// Whether a type spelling holds a record level or a generic application, which a literal in
// another module's check can adopt; each record level's field names become a key of `at`.
function ihSpellKeys(s: string, at: i32, seen: string[]): boolean {
  let amb = false
  const kinds: boolean[] = []
  const words: string[][] = []
  const tys: string[][] = []
  let i = 0
  while i < s.length {
    const c = s[i]
    if isIdPart(c) {
      let j = i
      while j < s.length && (isIdPart(s[j]) || s[j] == '$') { j = j + 1 }
      let k = j
      while k < s.length && (s[k] == ' ' || s[k] == '?') { k = k + 1 }
      const top = kinds.length - 1
      if k < s.length && s[k] == ':' && top >= 0 && kinds[top] {
        words[top].push(s.slice(i, j))
        const opt = s.slice(j, k).indexOf("?") >= 0
        tys[top].push(
          if opt { "" } else { ihSpellClass(s.slice(k + 1, ihFieldTyEnd(s, k + 1))) },
        )
      } else if j < s.length && s[j] == '<' && !ihOn(IH_NO_AMB_GENERIC) {
        const head = s.slice(i, j)
        if !ihBuiltinHead(head) {
          amb = true
          ihHeadKeys(head, at, seen)
        }
      }
      i = j
    } else if c == '"' || c == '\'' {
      i = ihSkipQuoted(s, i)
    } else if c == '=' && i + 1 < s.length && s[i + 1] == '>' {
      i = i + 2
    } else if c == '{' || c == '(' || c == '[' || c == '<' {
      let k = i + 1
      while k < s.length && s[k] == ' ' { k = k + 1 }
      const rec = c == '{' && !(k < s.length && s[k] == '[')
      if rec { amb = true }
      kinds.push(rec)
      const none: string[] = []
      words.push(none)
      const noTys: string[] = []
      tys.push(noTys)
      i = i + 1
    } else if c == '}' || c == ')' || c == ']' || c == '>' {
      const rec = kinds.pop() ?? false
      const ws = words.pop() ?? []
      const ts = tys.pop() ?? []
      if rec {
        ihAkRow(at, IH_AK_FIELDS, ws)
        ihAkTys[ihAkTys.length - 1] = ts
      }
      i = i + 1
    } else {
      i = i + 1
    }
  }
  amb
}

// Whether `fd` is found by a call that does not name it through an import: a method on its
// first parameter `self`, a getter, or an operator. A getter's name becomes a key of `at`, and
// a method's one only a member call meets, since only a call resolves a method; so does the
// `new` type an operator takes, and any other operator makes `at` wild.
function ihReceiverFn(fd: FuncDecl, at: i32): boolean {
  let nm = ihSourceName(fd.fnName)
  let recv = false
  let i = 0
  while i < nm.length {
    if nm[i] == '.' {
      recv = true
      nm = nm.slice(i + 1, nm.length)
      i = 0
    } else if !isIdPart(nm[i]) {
      if at >= 0 {
        const nt = ihNewOperand(fd, at)
        if nt == "" {
          ihStWild[at] = true
        } else {
          ihAkRow(at, IH_AK_OPER, [nt])
        }
      }
      return true
    } else {
      i = i + 1
    }
  }
  const getter = recv
  if !recv && fd.fnParams.length > 0 {
    const pn = nodeAt(fd.fnParams[0])
    recv = pn is Param && pn.parName == "self"
  }
  if recv && at >= 0 {
    ihAkRow(at, IH_AK_RECV, [nm])
    ihAkCall[ihAkCall.length - 1] = !getter
  }
  recv
}

// A parameter type of `fd`, at statement `at`, that names a `new` type its own module declares,
// or "". A value of a `new` type enters a check only where it spells the name or calls an
// ambient function that meets, so an operator on one is bounded by that word; on a structural
// type it applies to any record of the shape.
function ihNewOperand(fd: FuncDecl, at: i32): string {
  for p in fd.fnParams {
    if p >= 0 && p < P.nodes.length {
      const pn = nodeAt(p)
      if pn is Param && pn.parType >= 0 && pn.parType < P.nodes.length {
        const tn = nodeAt(pn.parType)
        if tn is TypeRef && ihNewHere(ihDeclBase(tn.tyName), ihStMod[at]) {
          return ihDeclBase(tn.tyName)
        }
      }
    }
  }
  ""
}

// Whether module `m` declares the plain type name `n` as a `new` type.
function ihNewHere(n: string, m: i32): boolean {
  let i = 0
  while i < n.length {
    if !isIdPart(n[i]) { return false }
    i = i + 1
  }
  for d in ihDeclsOf[n] ?? [] {
    const dn = nodeAt(d)
    const ds = ihStAt(nodeLastTok(d))
    if ds >= 0 && ihStMod[ds] == m && dn is TypeDecl { return dn.tdNew != 0 }
  }
  false
}

// The statement row holding token `t`, or -1.
function ihStAt(t: i32): i32 {
  if t < 0 { return -1 }
  let lo = 0
  let hi = ihStLo.length
  while lo < hi {
    const mid = (lo + hi) / 2
    if ihStLo[mid] <= t { lo = mid + 1 } else { hi = mid }
  }
  const s = lo - 1
  if s < 0 || t >= ihStHi[s] { return -1 }
  s
}

// `ihStAt` of every token of `P.toks`, by one sweep, for a pass that asks it of every node. Empty
// when the rows' starts are not in order, where only the search defines the answer.
function ihStTable(): i32[] {
  const out: i32[] = []
  let k = 1
  while k < ihStLo.length {
    if ihStLo[k] < ihStLo[k - 1] { return out }
    k = k + 1
  }
  let s = -1
  let t = 0
  while t < P.toks.length {
    while s + 1 < ihStLo.length && ihStLo[s + 1] <= t { s = s + 1 }
    if s < 0 || t >= ihStHi[s] { out.push(-1) } else { out.push(s) }
    t = t + 1
  }
  out
}

// `ihStAt(t)`, read from `tab` (an `ihStTable`) where it covers `t`.
function ihStAtIn(tab: i32[], t: i32): i32 {
  if t >= 0 && t < tab.length { return tab[t] }
  ihStAt(t)
}

// After every module's rows: mark the statements that hold a type declaration, a structural
// type spelling, or a receiver-found function, anywhere in their tokens, bodies included, and
// key each by the names and record levels a check reading it unimported could match.
export function ihAmbientScan(): i32 {
  ihStAmb = []
  ihStWild = []
  ihStNames = []
  ihAkSt = []
  ihAkKind = []
  ihAkLo = []
  ihAkHi = []
  ihAkW = []
  ihAkName = []
  ihAkCall = []
  ihAkShape = []
  ihAkTys = []
  ihLitSt = []
  ihLitKey = []
  ihLitRep = []
  ihLitArg = []
  ihLitSettled = []
  ihDeclsOf = Map()
  ihUnionAt = []
  ihLitSets = Map()
  ihLitSetsBuilt = false
  ihLitSetsWild = false
  let s = 0
  while s < ihStMod.length {
    ihStAmb.push(ihStKind[s] == IH_ST_TYPE)
    ihStWild.push(false)
    ihStNames.push(false)
    s = s + 1
  }
  let x = 0
  while x < P.nodes.length {
    const nd = nodeAt(x)
    let nm = ""
    if nd is TypeDecl { nm = ihDeclBase(nd.tdName) }
    if nd is UnionDecl {
      nm = ihDeclBase(nd.udName)
      ihUnionAt.push(x)
    }
    if nm != "" { ihListPush(ihDeclsOf, nm, x) }
    x = x + 1
  }
  x = 0
  const stAt = ihStTable()
  const argOf = ihLitArgs()
  const settled = ihSettledLits()
  while x < P.nodes.length {
    const nd = nodeAt(x)
    const at = ihStAtIn(stAt, nodeLastTok(x))
    const seen: string[] = []
    let amb = false
    if at >= 0 {
      if nd is TypeRef { amb = ihSpellKeys(nd.tyName, at, seen) }
      if nd is IsExpr { amb = ihSpellKeys(nd.isVariant, at, seen) }
      if nd is AsExpr { amb = ihSpellKeys(nd.asTy, at, seen) }
      if nd is TypeDecl {
        amb = true
        ihAkRow(at, IH_AK_NAME, [ihDeclBase(nd.tdName)])
        const sh = ihTwinShape(nd)
        ihDeclKeys(x, at, seen)
        if sh != 0 { ihAkShape[ihAkShape.length - 1] = sh }
        ihStNames[at] = nd.tdNew != 0
          || nd.tdFlat != 0
          || nd.tdName.indexOf("<") >= 0
      }
      if nd is UnionDecl {
        amb = true
        ihStNames[at] = true
        ihAkRow(at, IH_AK_NAME, [ihDeclBase(nd.udName)])
        ihDeclKeys(x, at, seen)
      }
      if nd is FuncDecl { amb = ihReceiverFn(nd, at) }
      if nd is ObjLit {
        const ws = ihLitNames(nd.objFields)
        ihLitSt.push(at)
        ihLitKey.push(ihSetName(ws))
        ihLitRep.push(ihHasRepeat(ws))
        ihLitArg.push(argOf[x])
        ihLitSettled.push(settled[x])
      }
      if amb { ihStAmb[at] = true }
    }
    x = x + 1
  }
  ihWildUnkeyed()
}

// Per node, 2 when it is an object literal a non-generic function with a declared result returns
// as it stands, which the check delivers to that result and never to a record of its names; 1
// when another function returns it so and `IH_LOOSE_SETTLED` asks.
function ihSettledLits(): i32[] {
  const out: i32[] = []
  for _ in P.nodes { out.push(0) }
  let x = 0
  for nd in P.nodes {
    const settles = nd is FuncDecl && nd.fnRet >= 0 && nd.fnTyParams.length == 0
    if nd is FuncDecl && (settles || ihLoose(IH_LOOSE_SETTLED)) {
      const kind = if settles { 2 } else { 1 }
      for lf in recFnValueLeaves(x) {
        const l = cwPeel(lf)
        if l >= 0 && l < out.length && nodeAt(l) is ObjLit && out[l] == 0 {
          out[l] = kind
        }
      }
    }
    x = x + 1
  }
  out
}

// Per node, 1 when it is an argument of a member call such as `xs.push(`, 2 of a plain call.
function ihLitArgs(): i32[] {
  const out: i32[] = []
  for _ in P.nodes { out.push(0) }
  for nd in P.nodes {
    if nd is Call && nd.callFn >= 0 && nd.callFn < P.nodes.length {
      const f = nodeAt(nd.callFn)
      const kind = if f is Member || f is OptMember { 1 } else { 2 }
      for a in nd.callArgs {
        if a >= 0 && a < out.length { out[a] = kind }
      }
    }
  }
  out
}

// Every ambient statement that holds no key is wild.
function ihWildUnkeyed(): i32 {
  const keyed: boolean[] = []
  let s = 0
  while s < ihStMod.length {
    keyed.push(false)
    s = s + 1
  }
  for a in ihAkSt { keyed[a] = true }
  s = 0
  while s < ihStMod.length {
    if ihStAmb[s] && !keyed[s] { ihMarkWild(s) }
    s = s + 1
  }
  0
}

function ihLitNames(fs: i32[]): string[] {
  const ws: string[] = []
  for f in fs {
    if f >= 0 && f < P.nodes.length {
      const fi = nodeAt(f)
      if fi is FieldInit { ws.push(fi.fiName) }
    }
  }
  ws
}

// Per module: whether it holds an ambient statement, the declarations an error of a check that
// left the module out may miss as a near-name suggestion.
export function ihAmbientNear(): boolean[] {
  const out: boolean[] = []
  for _ in ihKeys { out.push(false) }
  if ihOn(IH_NO_AMBIENT) || ihOn(IH_NO_AMB_NEAR) { return out }
  let s = 0
  while s < ihStMod.length {
    const m = ihStMod[s]
    if ihStAmb[s] && m >= 0 && m < out.length { out[m] = true }
    s = s + 1
  }
  out
}

// The words, literal field sets and record types of the whole check, by module, so many module
// sets can each be asked `ihAmbientMeetsIn`'s question without reading their tokens again.
type IhIndex = {
  xWord: {[string]: i32[]},
  xMember: {[string]: i32[]},
  xCall: {[string]: i32[]},
  xField: {[string]: i32[]},
  xLit: {[string]: i32[]},
  xLitBare: {[string]: i32[]},
  xLitLeaf: {[string]: i32[]},
  xRep: i32[],
  xArena: {[string]: i32},
  xArenaW: string[][],
  xArenaM: i32[][],
  xArenaRep: i32[],
  xArenaS: i32[][],
  xSig: {[string]: i32},
  xSigC: string[][],
  xSigM: i32[][],
  xWild: boolean[],
  xNames: boolean[],
  xShape: {[i32]: i32[]},
}
let ihIx: IhIndex = ihIndexEmpty()

function ihIndexEmpty(): IhIndex {
  const ix: IhIndex = {
    xWord: Map(),
    xMember: Map(),
    xCall: Map(),
    xField: Map(),
    xLit: Map(),
    xLitBare: Map(),
    xLitLeaf: Map(),
    xRep: [],
    xArena: Map(),
    xArenaW: [],
    xArenaM: [],
    xArenaRep: [],
    xArenaS: [],
    xSig: Map(),
    xSigC: [],
    xSigM: [],
    xWild: [],
    xNames: [],
    xShape: Map(),
  }
  ix
}

function ihIxPush(rows: i32[], m: i32): void {
  if rows.length == 0 || rows[rows.length - 1] != m { rows.push(m) }
}

// Index the parse for `ihAmbientMeetsIn` without the arena, which a check that has not run lacks.
export function ihAmbientIndexParse(): i32 {
  const ix = ihIndexEmpty()
  let d = 0
  while d < ihKeys.length {
    ix.xWild.push(false)
    ix.xNames.push(false)
    d = d + 1
  }
  let k = 0
  while k < ihAkSt.length {
    const m = ihStMod[ihAkSt[k]]
    if ihAkShape[k] != 0 && m >= 0 {
      const rows = ix.xShape[ihAkShape[k]] ?? []
      ihIxPush(rows, m)
      ix.xShape[ihAkShape[k]] = rows
    }
    k = k + 1
  }
  k = 0
  while k < ihLitSt.length {
    const m = ihStMod[ihLitSt[k]]
    if m >= 0 {
      if ihLitRep[k] { ihIxPush(ix.xRep, m) }
      // The check builds a record by its field names only from what a plain call hands back,
      // and never from a literal a declared result settles.
      const open = ihLitSettled[k] != 2 || ihLitRep[k]
      const plain = ihLitArg[k] != 1 || ihLitRep[k]
      if open && plain { ihIxRow(ix.xLit, ihLitKey[k], m) }
      if open && (ihLitArg[k] == 0 || ihLitRep[k]) {
        ihIxRow(ix.xLitBare, ihLitKey[k], m)
      }
      if (ihLitSettled[k] == 0 || ihLitRep[k]) && plain {
        ihIxRow(ix.xLitLeaf, ihLitKey[k], m)
      }
    }
    k = k + 1
  }
  let s = 0
  while s < ihStMod.length {
    const m = ihStMod[s]
    if m >= 0 {
      if ihStAmb[s] && m < ix.xWild.length {
        if ihStWild[s] { ix.xWild[m] = true }
        if ihStNames[s] { ix.xNames[m] = true }
      }
      // The open brackets around token `t`, so a name inside `(` or `[` is not read as a field.
      const open: TokKind[] = []
      let t = ihStLo[s]
      while t < ihStHi[s] && t < P.toks.length {
        const w = P.toks[t].text
        ihIxWord(ix, w, m)
        let pk: TokKind = ""
        if t > ihStLo[s] { pk = P.toks[t - 1].kind }
        let nk: TokKind = ""
        if t + 1 < ihStHi[s] && t + 1 < P.toks.length {
          nk = P.toks[t + 1].kind
        }
        const member = pk == "DOT" || pk == "QUESTION_DOT"
        if member { ihIxRow(ix.xMember, w, m) }
        if member && (nk == "LPAREN" || nk == "LT") { ihIxRow(ix.xCall, w, m) }
        let inBrace = true
        if open.length > 0 { inBrace = open[open.length - 1] == "LBRACE" }
        const lead = pk == "LBRACE" || pk == "COMMA"
        const ends = nk == "RBRACE" || nk == "COMMA" || nk == "EQUAL"
        // A name a `const` or `let` binds is never a field, typed or not.
        const binds = pk == "CONST" || pk == "LET"
        const named = !binds && (nk == "COLON" || nk == "QUESTION")
          || lead && ends
        const field = member || (inBrace && named)
        if field { ihIxRow(ix.xField, w, m) }
        const tk = P.toks[t].kind
        if tk == "LBRACE" || tk == "LPAREN" || tk == "LBRACK" { open.push(tk) }
        if (
          (tk == "RBRACE" || tk == "RPAREN" || tk == "RBRACK")
          && open.length > 0
        ) {
          open.pop()
        }
        if w.length >= 2 && (w[0] == '"' || w[0] == '\'') {
          const q = w.slice(1, w.length - 1)
          ihIxWord(ix, q, m)
          if field { ihIxRow(ix.xField, q, m) }
        }
        t = t + 1
      }
    }
    s = s + 1
  }
  ihIx = ix
  0
}

// After the check: index it for `ihAmbientMeetsIn`, the arena's records with the parse.
export function ihAmbientIndex(): i32 {
  ihAmbientIndexParse()
  ihAmbientIndexArena()
}

// After `ihAmbientIndexParse` and the check it indexes: add the records the check's arena holds.
export function ihAmbientIndexArena(): i32 {
  if !ihOn(IH_NO_AMB_ARENA) { ihIxArena(ihIx) }
  0
}

// Per record field-name set, the modules whose own check holds a record of it: every record
// level they spell, and every record their checked nodes' types reach.
function ihIxArena(ix: IhIndex): i32 {
  let k = 0
  while k < ihAkSt.length {
    if ihAkKind[k] == IH_AK_FIELDS {
      ihIxRec(
        ix,
        ihAkW.slice(ihAkLo[k], ihAkHi[k]),
        ihAkTys[k],
        ihStMod[ihAkSt[k]],
      )
    }
    k = k + 1
  }
  const seen: i32[] = []
  for _ in T.tys { seen.push(-1) }
  const stAt = ihStTable()
  let x = 0
  while x < P.nodes.length {
    const at = ihStAtIn(stAt, nodeLastTok(x))
    if at >= 0 { ihIxReach(ix, nodeTyIxOf(x), ihStMod[at], seen) }
    x = x + 1
  }
  0
}

// Every record level type `ty` reaches, held by module `m`; `seen[ty] == m` once visited for it.
function ihIxReach(ix: IhIndex, ty: i32, m: i32, seen: i32[]): void {
  if ty < 0 || ty >= seen.length || m < 0 || seen[ty] == m { return }
  seen[ty] = m
  const t = tyAt(ty)
  match t {
    TyObj => {
      ihIxRec(ix, t.objFieldNames, ihFieldClasses(t), m)
      for f in t.objFieldTypes { ihIxReach(ix, f, m, seen) }
    }
    TyFunc => {
      for p in t.fnParamTypes { ihIxReach(ix, p, m, seen) }
      ihIxReach(ix, t.fnRet, m, seen)
    }
    TyUnion => {
      for u in t.uMembers { ihIxReach(ix, u, m, seen) }
    }
    TyNullable => ihIxReach(ix, t.nInner, m, seen)
    TyArray => ihIxReach(ix, t.aElem, m, seen)
    TyMap => {
      ihIxReach(ix, t.mKey, m, seen)
      ihIxReach(ix, t.mVal, m, seen)
    }
    TyNeg => ihIxReach(ix, t.negTy, m, seen)
    TyPrim => {}
    TyErr => {}
    TyVar => {}
    TyLit => {}
  }
}

// Module `m` holds a record with field names `ws`, whose field types `cls` names as
// `ihAkTys` does ([] when none is known).
function ihIxRec(ix: IhIndex, ws: string[], cls: string[], m: i32): void {
  if m < 0 { return }
  const key = ihSetName(ws)
  let a = ix.xArena[key] ?? -1
  if a >= 0 {
    ihIxPush(ix.xArenaM[a], m)
  } else {
    a = ix.xArenaW.length
    ix.xArenaW.push(ws)
    ix.xArenaM.push([m])
    ix.xArenaS.push([])
    if ihHasRepeat(ws) { ix.xArenaRep.push(a) }
    ix.xArena[key] = a
  }
  // The storage, in entry `a`'s field order.
  const at = ix.xArenaW[a]
  const sig: string[] = []
  let sk = key + "|"
  for w in at {
    let c = ""
    let j = 0
    while j < ws.length && j < cls.length {
      if ws[j] == w { c = cls[j] }
      j = j + 1
    }
    sig.push(c)
    sk = sk + c + ","
  }
  let s = ix.xSig[sk] ?? -1
  if s < 0 {
    s = ix.xSigC.length
    ix.xSigC.push(sig)
    ix.xSigM.push([])
    ix.xArenaS[a].push(s)
    ix.xSig[sk] = s
  }
  ihIxPush(ix.xSigM[s], m)
}

// The field types of record `t` aligned with its names, as `ihTyClass` names them; every field is
// `*` when one reaches a hole, since the check then shares the record's storage with any record.
function ihFieldClasses(t: TyObj): string[] {
  const out: string[] = []
  let hole = false
  for f in t.objFieldTypes {
    if tyReachesHole(f, 8) { hole = true }
    out.push(ihTyClass(f, 4))
  }
  let i = 0
  while hole && i < out.length {
    out[i] = "*"
    i = i + 1
  }
  out
}

// A storage class: a primitive's name, `i32` for an integer literal (stored as one), a class
// with `[]` for a list of it, and "" for any other type, whose storage stays unknown.
function ihTyClass(f: i32, depth: i32): string {
  if f < 0 || f >= T.tys.length || depth <= 0 { return "" }
  const ft = tyAt(f)
  match ft {
    TyPrim => ft.primName
    TyLit => if ft.litKind == "int" { "i32" } else { "" }
    TyArray => {
      const e = ihTyClass(ft.aElem, depth - 1)
      if e == "" { "" } else { e + "[]" }
    }
    // a storage the arena does not compare stays unknown
    TyErr | TyObj | TyFunc | TyUnion | TyNullable | TyMap | TyVar | TyNeg => ""
  }
}

// The storage class a field's type spelling names, as `ihTyClass` does: a primitive no module
// redeclares, with any `[]`s, or "".
function ihSpellClass(s: string): string {
  let t = ""
  let i = 0
  while i < s.length {
    if s[i] != ' ' { t = t + s.slice(i, i + 1) }
    i = i + 1
  }
  let n = 0
  while t.length >= 2 && t.slice(t.length - 2, t.length) == "[]" {
    t = t.slice(0, t.length - 2)
    n = n + 1
  }
  if !ihPrimName(t) && !(t == "u8" && !ihDeclsOf.has(t)) { return "" }
  while n > 0 {
    t = t + "[]"
    n = n - 1
  }
  t
}

// Whether a module of `inS` holds a record of entry `a` whose storage can equal key `k`'s
// declaration, and one whose storage can differ from it: a literal is built at a declared record
// only when it is delivered to a record of its names stored apart from that one.
function ihIxStoreHolds(a: i32, k: i32, inS: boolean[]): boolean {
  const tys = ihAkTys[k]
  if tys.length == 0 { return ihIxIn(ihIx.xArenaM[a], inS) }
  const at = ihIx.xArenaW[a]
  let fits = false
  let apart = false
  for s in ihIx.xArenaS[a] {
    if ihIxIn(ihIx.xSigM[s], inS) {
      if ihSigFits(ihIx.xSigC[s], at, k, tys) { fits = true }
      if !ihSigSame(ihIx.xSigC[s], at, k, tys) { apart = true }
    }
  }
  fits && apart
}

// Whether storage `sig` of fields `at` can equal key `k`'s declared field types `tys`. A record
// with a field reaching a hole (`*`) shares storage with any record.
function ihSigFits(
  sig: string[],
  at: string[],
  k: i32,
  tys: string[],
): boolean {
  if strListHas(sig, "*") { return true }
  let i = 0
  while i < at.length && i < sig.length {
    let j = 0
    while j < tys.length && ihAkLo[k] + j < ihAkHi[k] {
      const d = tys[j]
      if (
        ihAkW[ihAkLo[k] + j] == at[i]
        && d != ""
        && sig[i] != ""
        && d != sig[i]
      ) {
        return false
      }
      j = j + 1
    }
    i = i + 1
  }
  true
}

// Whether storage `sig` of fields `at` is surely key `k`'s declared storage `tys`: every field's
// class is known on both sides and agrees, or a field reaches a hole, which no storage differs from.
function ihSigSame(
  sig: string[],
  at: string[],
  k: i32,
  tys: string[],
): boolean {
  if strListHas(sig, "*") { return true }
  if sig.length != at.length { return false }
  let i = 0
  while i < at.length {
    let d = ""
    let j = 0
    while j < tys.length && ihAkLo[k] + j < ihAkHi[k] {
      if ihAkW[ihAkLo[k] + j] == at[i] { d = tys[j] }
      j = j + 1
    }
    if d == "" || d != sig[i] { return false }
    i = i + 1
  }
  true
}

function ihIxWord(ix: IhIndex, w: string, m: i32): void {
  ihIxRow(ix.xWord, w, m)
}

// A row the table already holds is pushed in place: one probe per token, not a read and a write.
function ihIxRow(tab: {[string]: i32[]}, w: string, m: i32): void {
  const rows = tab[w]
  if rows == null {
    tab[w] = [m]
    return
  }
  ihIxPush(rows, m)
}

function ihIxIn(rows: i32[], inS: boolean[]): boolean {
  for m in rows {
    if m >= 0 && m < inS.length && inS[m] { return true }
  }
  false
}

// Whether `inS` spells every name of `ws` where a field is named: after `.`, or inside `{` before
// `:` or `?`, or alone between `{` or `,` and `}`, `,` or `=`.
function ihIxSpells(ws: string[], inS: boolean[]): boolean {
  for w in ws {
    if !ihIxIn(ihIx.xField[w] ?? [], inS) { return false }
  }
  true
}

// Whether a module of `inS` holds record entry `a` and `inS` spells each of its field names.
function ihIxHolds(a: i32, inS: boolean[]): boolean {
  ihIxIn(ihIx.xArenaM[a], inS) && ihIxSpells(ihIx.xArenaW[a], inS)
}

// Per module, whether an ambient statement of it meets a check of `inS`: a wild one always, a
// getter after `.` or `?.`, a method call only when `dirty`, a type's name only with `rows`. With
// `arena`, a record also counts when `inS` holds and spells it; with `twin`, a declaration adds
// nothing when `inS` declares its shape.
export function ihAmbientMeetsIn(
  inS: boolean[],
  dirty: boolean,
  arena: boolean,
  rows: boolean,
  twin: boolean,
): boolean[] {
  const out: boolean[] = []
  let d = 0
  while d < ihKeys.length {
    out.push(false)
    d = d + 1
  }
  if ihOn(IH_NO_AMBIENT) { return out }
  let any = ihIxIn(ihIx.xRep, inS)
  if arena && !any {
    for a in ihIx.xArenaRep {
      if ihIxHolds(a, inS) { any = true }
    }
  }
  ihMeetWhy = []
  for _ in out { ihMeetWhy.push("") }
  d = 0
  while d < out.length && d < ihIx.xWild.length {
    if ihIx.xWild[d] { ihMeetWhy[d] = "wild" }
    if rows && ihIx.xNames[d] { ihMeetWhy[d] = "rows" }
    if ihIx.xWild[d] || (rows && ihIx.xNames[d]) { out[d] = true }
    d = d + 1
  }
  let k = 0
  while k < ihAkSt.length {
    const m = ihStMod[ihAkSt[k]]
    if m >= 0 && m < out.length && !out[m] {
      const kind = ihAkKind[k]
      let all = true
      if kind == IH_AK_FIELDS {
        ihViaArena = false
        let lits = if ihLoose(IH_LOOSE_ARGS) { ihIx.xLitBare } else { ihIx.xLit }
        if ihLoose(IH_LOOSE_SETTLED) { lits = ihIx.xLitLeaf }
        all = any || ihIxIn(lits[ihAkName[k]] ?? [], inS)
        if !all && arena {
          const a = ihIx.xArena[ihAkName[k]] ?? -1
          const held = a >= 0 && ihIxStoreHolds(a, k, inS)
          if held && ihIxSpells(ihIx.xArenaW[a], inS) {
            all = true
            ihViaArena = true
          }
        }
      } else {
        let w = ihAkLo[k]
        while w < ihAkHi[k] {
          let hits = ihIx.xWord[ihAkW[w]] ?? []
          if kind == IH_AK_RECV { hits = ihIx.xMember[ihAkW[w]] ?? [] }
          if ihAkCall[k] || kind == IH_AK_RECV && ihLoose(IH_LOOSE_GETTER) {
            hits = ihIx.xCall[ihAkW[w]] ?? []
          }
          if !ihIxIn(hits, inS) { all = false }
          w = w + 1
        }
      }
      if kind == IH_AK_NAME && (!rows || ihOn(IH_NO_AMB_NAMES)) { all = false }
      if kind == IH_AK_RECV && ihOn(IH_NO_AMB_RECV) { all = false }
      if (
        kind == IH_AK_RECV
        && ihAkCall[k]
        && (!dirty || ihLoose(IH_LOOSE_CALLS))
      ) {
        all = false
      }
      if kind == IH_AK_FIELDS && ihOn(IH_NO_AMB_FIELDS) { all = false }
      if all && twin && ihAkShape[k] != 0 {
        if ihIxIn(ihIx.xShape[ihAkShape[k]] ?? [], inS) { all = false }
      }
      if all {
        out[m] = true
        ihMeetWhy[m] = ihAkWhy(k, any)
      }
    }
    k = k + 1
  }
  out
}

// Guards `ihAmbientMeetsIn` loosens, for the suite's mask witnesses: stop meeting at a literal
// handed to any call (`IH_LOOSE_ARGS`), a literal any function returns (`IH_LOOSE_SETTLED`) or a
// dirty check's method call (`IH_LOOSE_CALLS`); a getter meets only a member call
// (`IH_LOOSE_GETTER`).
const IH_LOOSE_ARGS = 1
const IH_LOOSE_GETTER = 2
const IH_LOOSE_SETTLED = 4
const IH_LOOSE_CALLS = 8
let ihLooseMask = 0

export function ihAmbientLoose(mask: i32): i32 {
  ihLooseMask = mask
  0
}

function ihLoose(bit: i32): boolean { (ihLooseMask & bit) != 0 }

// Per module, after `ihAmbientMeetsIn`: the key that met, for the check's trace.
let ihMeetWhy: string[] = []
let ihViaArena = false

// Whether a type or union named `w` is declared in a module outside `inS` (or in no module).
export function ihNameDeclaredOut(w: string, inS: boolean[]): boolean {
  for x in ihDeclsOf[w] ?? [] {
    const at = ihStAt(nodeLastTok(x))
    if at < 0 { return true }
    const m = ihStMod[at]
    if m < 0 || m >= inS.length || !inS[m] { return true }
  }
  false
}

// Whether a union named `w` holds a string literal member at any depth of unions and nullables
// (an unresolved name counts): such a set renders by whichever spelling the check interned first.
export function ihNameIsLitUnion(w: string): boolean {
  for x in ihDeclsOf[w] ?? [] {
    const nd = nodeAt(x)
    if nd is UnionDecl {
      const ty = cUserTypes[nd.udName] ?? -1
      if ty < 0 || ihBearsStrLit(ty, 8) { return true }
    }
  }
  false
}

// Whether literal union alias `w` may render under another name: it is declared more than once,
// its type is unknown, or another alias in the program names the same member set, since a set
// renders by whichever of its aliases the check interned first.
export function ihLitUnionTwinned(w: string): boolean {
  const ds = ihDeclsOf[w] ?? []
  if ds.length != 1 { return true }
  const nd = nodeAt(ds[0])
  let ty = -1
  if nd is UnionDecl { ty = cUserTypes[nd.udName] ?? -1 }
  const own = ihLitSetKey(ty)
  if own == "" { return true }
  if !ihLitSetsBuilt {
    ihLitSetsBuilt = true
    for x in ihUnionAt {
      const ud = nodeAt(x)
      if ud is UnionDecl {
        if (ihDeclsOf[ihDeclBase(ud.udName)] ?? []).length != 1 {
          ihLitSetsWild = true
        }
        const key = ihLitSetKey(cUserTypes[ud.udName] ?? -1)
        if key != "" { ihLitSets[key] = (ihLitSets[key] ?? 0) + 1 }
      }
    }
  }
  ihLitSetsWild || (ihLitSets[own] ?? 0) > 1
}

// How many union aliases name each sorted member set, filled by the first `ihLitUnionTwinned`;
// wild when a union name is declared twice, since the check keeps the type of one of them.
let ihLitSets: {[string]: i32} = Map()
let ihLitSetsBuilt = false
let ihLitSetsWild = false
// The parse nodes of every union declaration, filled by `ihAmbientScan`.
let ihUnionAt: i32[] = []

// The member set of union type `ty` as sorted member spellings, or "" when `ty` is not a union.
function ihLitSetKey(ty: i32): string {
  if ty < 0 || ty >= T.tys.length { return "" }
  const t = tyAt(ty)
  const ms: string[] = []
  if t is TyUnion {
    for m in t.uMembers { ms.push(tyToStr(m)) }
  }
  if ms.length == 0 { "" } else { ihSetName(ms) }
}

function ihBearsStrLit(ty: i32, depth: i32): boolean {
  if ty < 0 || ty >= T.tys.length || depth == 0 { return true }
  const t = tyAt(ty)
  match t {
    TyLit => t.litKind == "str"
    TyNullable => ihBearsStrLit(t.nInner, depth - 1)
    TyUnion => {
      let hit = false
      for m in t.uMembers {
        if ihBearsStrLit(m, depth - 1) { hit = true }
      }
      hit
    }
    // a member of any other kind does not make the alias a literal atom
    TyPrim | TyErr | TyObj | TyFunc | TyArray | TyMap | TyVar | TyNeg => false
  }
}

export function ihAmbientWhy(m: i32): string {
  if m >= 0 && m < ihMeetWhy.length { return ihMeetWhy[m] }
  ""
}

// Per module, each ambient statement in order as its full-token hash, then per key a kind (`n`
// name, `r` receiver, `f` field set, `o` operator) followed by its words, each after `.`, then
// `*` when it is wild: what `ihAmbEntryMeets` asks of another module's tokens.
export function ihAmbEntries(): string[][][] {
  const out: string[][][] = []
  for _ in ihKeys {
    const none: string[][] = []
    out.push(none)
  }
  if ihStAmb.length != ihStMod.length { return out }
  const atoms: string[][] = []
  for _ in ihStMod {
    const none: string[] = []
    atoms.push(none)
  }
  let k = 0
  while k < ihAkSt.length {
    const at = atoms[ihAkSt[k]]
    let kind = "n"
    if ihAkKind[k] == IH_AK_RECV { kind = "r" }
    if ihAkKind[k] == IH_AK_FIELDS { kind = "f" }
    if ihAkKind[k] == IH_AK_OPER { kind = "o" }
    at.push(kind)
    let w = ihAkLo[k]
    while w < ihAkHi[k] {
      at.push("." + ihAkW[w])
      w = w + 1
    }
    k = k + 1
  }
  let s = 0
  while s < ihStMod.length {
    const m = ihStMod[s]
    if ihStAmb[s] && m >= 0 && m < out.length {
      const e: string[] = [i32ToStr(ihFullOf(s))]
      for a in atoms[s] { e.push(a) }
      if ihStWild[s] { e.push("*") }
      out[m].push(e)
    }
    s = s + 1
  }
  out
}

// Whether a check of `inS` could read the ambient statement entry `e` describes: it is wild, or
// `inS` spells a name or operator word, a member `.name`, or every field of a set where a field
// is named (or builds a literal repeating a name), without asking whether the check calls it.
export function ihAmbEntryMeets(e: string[], inS: boolean[]): boolean {
  let i = 1
  while i < e.length {
    const kind = e[i]
    if kind == "*" { return true }
    const ws: string[] = []
    i = i + 1
    while i < e.length && e[i].length > 0 && e[i][0] == '.' {
      ws.push(e[i].slice(1, e[i].length))
      i = i + 1
    }
    let all = true
    if kind == "f" {
      all = ihIxIn(ihIx.xRep, inS) || ihIxSpells(ws, inS)
    } else {
      for w in ws {
        const tab = if kind == "r" { ihIx.xMember } else { ihIx.xWord }
        if !ihIxIn(tab[w] ?? [], inS) { all = false }
      }
    }
    if all { return true }
  }
  false
}

function ihAkWhy(k: i32, any: boolean): string {
  let s = "name:"
  if ihAkKind[k] == IH_AK_RECV { s = "recv:" }
  if ihAkKind[k] == IH_AK_OPER { s = "oper:" }
  if ihAkKind[k] == IH_AK_FIELDS { s = "fields:" }
  if ihAkKind[k] == IH_AK_FIELDS && any { s = "rep:" }
  if ihAkKind[k] == IH_AK_FIELDS && ihViaArena { s = "arena:" }
  let w = ihAkLo[k]
  while w < ihAkHi[k] {
    if w > ihAkLo[k] { s = s + "," }
    s = s + ihAkW[w]
    w = w + 1
  }
  s
}

function ihTokHash(a: i32, b: i32): i32 {
  let h = IH_SEED
  let i = a
  while i < b {
    h = ihMixStr(h, P.toks[i].text)
    i = i + 1
  }
  h
}

// Module `m`'s token-side rows, from its parse `root` (tokens `[lo, hi)`) before the check
// pins anything; `visible` holds the local names its imports bind and `exported` the names
// it declares with `export`.
export function ihModule(
  m: i32,
  root: i32,
  lo: i32,
  hi: i32,
  visible: string[],
  exported: string[],
): i32 {
  if m < 0 || m >= ihOwn.length { return 0 }
  const rn = nodeAt(root)
  if rn is Program {
    const ss = rn.progStmts
    // `seen` holds what a body mention may name; `tops` adds the module's type names.
    const seen: {[string]: boolean} = Map()
    const tops: {[string]: boolean} = Map()
    const isExp: {[string]: boolean} = Map()
    let v = 0
    while v < visible.length {
      seen[visible[v]] = true
      v = v + 1
    }
    for e in exported { isExp[e] = true }
    let si = 0
    while si < ss.length {
      const st = nodeAt(ss[si])
      if st is FuncDecl {
        seen[ihSourceName(st.fnName)] = true
        tops[ihSourceName(st.fnName)] = true
      }
      if st is LetDecl {
        seen[ihSourceName(st.letName)] = true
        tops[ihSourceName(st.letName)] = true
      }
      if st is TypeDecl { tops[ihSourceName(st.tdName)] = true }
      if st is UnionDecl { tops[ihSourceName(st.udName)] = true }
      si = si + 1
    }
    let at = lo
    si = 0
    while si < ss.length {
      const sx = ss[si]
      const st = nodeAt(sx)
      let start = nodeStartTok(sx)
      let end = -1
      if sx >= 0 && sx < nodeToks.length { end = nodeToks[sx] + 1 }
      if start < at || start >= hi || end <= start || end > hi {
        si = si + 1
        continue
      }
      // The `export` before a declaration's own first token stays with it.
      while start > at && P.toks[start - 1].kind == "EXPORT" {
        start = start - 1
      }
      ihOrphans(m, at, start, tops)
      let kind = IH_ST_ROOT
      let merged = ""
      let decl = -1
      if st is FuncDecl {
        kind = IH_ST_FN
        merged = st.fnName
        decl = sx
      }
      if st is LetDecl {
        kind = IH_ST_LET
        merged = st.letName
        decl = sx
      }
      if st is TypeDecl {
        kind = IH_ST_TYPE
        merged = st.tdName
      }
      if st is UnionDecl {
        kind = IH_ST_TYPE
        merged = st.udName
      }
      ihStOpen(m, kind, merged, decl, isExp[ihSourceName(merged)] ?? false)
      let cutLo = -1
      let cutHi = -1
      let cutRet = false
      let body = IH_SEED
      let men = 0
      if st is FuncDecl {
        ihFns[m] = ihFns[m] + 1
        if st.fnBody >= 0 && st.fnBody < nodeToks.length {
          const close = nodeToks[st.fnBody]
          const open = ihOpenOf(close, start)
          if open >= start && close < end {
            const ps: string[] = []
            let pi = 0
            while pi < st.fnParams.length {
              const pn = nodeAt(st.fnParams[pi])
              if pn is Param { ps.push(pn.parName) }
              pi = pi + 1
            }
            men = ihMentions(open + 1, close, seen, ps)
            if !ihBodyVisible(st) {
              cutLo = open + 1
              cutHi = close
              cutRet = st.fnRet < 0
              body = ihTokHash(cutLo, cutHi)
              ihCut[m] = ihCut[m] + 1
            }
          }
        }
      }
      ihTokens(start, end, cutLo, cutHi, tops)
      ihStClose(cutRet, cutLo >= 0, body, men)
      at = end
      si = si + 1
    }
    ihOrphans(m, at, hi, tops)
  }
  0
}

// The identifier runs of a rendered type, by source spelling.
function ihTypeNames(shown: string): string[] {
  const out: string[] = []
  let i = 0
  while i < shown.length {
    const c = shown[i]
    const isStart = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
    if !isStart {
      i = i + 1
      continue
    }
    let j = i + 1
    let more = true
    while more && j < shown.length {
      const d = shown[j]
      more = (d >= 'a' && d <= 'z')
        || (d >= 'A' && d <= 'Z')
        || (d >= '0' && d <= '9')
        || d == '_'
        || d == '$'
      if more { j = j + 1 }
    }
    out.push(ihSourceName(shown.slice(i, j)))
    i = j
  }
  out
}

// Whether a rendered type elided part of itself, so the rendering does not determine the type.
function ihElided(shown: string): boolean {
  let i = 0
  while i < shown.length {
    // The UTF-8 encoding of the ellipsis `tyToStr` elides with.
    if (
      shown[i] == 226
      && i + 2 < shown.length
      && shown[i + 1] == 128
      && shown[i + 2] == 166
    ) {
      return true
    }
    i = i + 1
  }
  false
}

// Whether the declaration `decl`'s checked type is determined by its rendering and holds no
// function or type variable, so a dependent's uses of it read nothing but that type.
export function ihPlainBinding(decl: i32): boolean {
  const ix = declTyOf(decl)
  if ix < 0 || tyMayHoldFn(ix, 0) || tyHasTyVar(ix) { return false }
  !ihElided(tyToStr(ix))
}

// Mark every statement of module `m` spelled `name` with `mark`, queueing the ones it newly marks.
function ihReach(
  byName: {[string]: i32[]},
  m: i32,
  name: string,
  marks: boolean[],
  queue: i32[],
) {
  const key = ihKeys[m] + "\n" + name
  const ss = byName[key] ?? []
  let i = 0
  while i < ss.length {
    if !marks[ss[i]] {
      marks[ss[i]] = true
      queue.push(ss[i])
    }
    i = i + 1
  }
  0
}

// After the check: close each module's exposed set, fold its rows into its hash, then the deep
// hash of every module over its imports'. A cycle-free graph is the driver's invariant.
export function ihFinish(): i32 {
  const n = ihStMod.length
  const byName: {[string]: i32[]} = Map()
  const shown: string[] = []
  const exposed: boolean[] = []
  const called: boolean[] = []
  const queue: i32[] = []
  let s = 0
  while s < n {
    let ty = ""
    if ihStKind[s] == IH_ST_FN || ihStKind[s] == IH_ST_LET {
      const ix = declTyOf(ihStDecl[s])
      ty = "?"
      if ix >= 0 { ty = tyToStr(ix) }
    }
    shown.push(ty)
    called.push(false)
    if ihStKind[s] != IH_ST_ROOT {
      ihListPush(byName, ihKeys[ihStMod[s]] + "\n" + ihStName[s], s)
    }
    const root = ihOn(IH_ALL_EXPOSED)
      || ihStKind[s] == IH_ST_ROOT
      || ihStExported[s]
      || (ihStKind[s] == IH_ST_LET && !ihOn(IH_NO_LET_ROOTS))
    exposed.push(root)
    if root { queue.push(s) }
    s = s + 1
  }
  ihKeep(byName, shown)
  // Exposure follows the names an exposed statement's tokens and checked type spell.
  let q = 0
  while q < queue.length {
    const x = queue[q]
    const m = ihStMod[x]
    if !ihOn(IH_NO_TOKEN_NAMES) {
      let i = ihStIdLo[x]
      while i < ihStIdHi[x] {
        ihReach(byName, m, ihIds[i], exposed, queue)
        i = i + 1
      }
    }
    if !ihOn(IH_NO_TYPE_NAMES) && shown[x] != "" {
      const ns = ihTypeNames(shown[x])
      let i = 0
      while i < ns.length {
        ihReach(byName, m, ns[i], exposed, queue)
        i = i + 1
      }
    }
    q = q + 1
  }
  // A function only a cut body calls gives its mentions: what it writes reaches its callers.
  const cq: i32[] = []
  s = 0
  while s < n {
    if exposed[s] && ihStKind[s] == IH_ST_FN {
      called[s] = true
      cq.push(s)
    }
    s = s + 1
  }
  q = 0
  while q < cq.length {
    const x = cq[q]
    if !ihOn(IH_NO_CALLEES) {
      let i = ihStCallLo[x]
      while i < ihStCallHi[x] {
        ihReach(byName, ihStMod[x], ihCalls[i], called, cq)
        i = i + 1
      }
    }
    q = q + 1
  }
  const men: i32[] = []
  let d = 0
  while d < ihOwn.length {
    ihOwn[d] = IH_SEED
    ihSpan[d] = IH_SEED
    ihExposedFns[d] = 0
    men.push(0)
    d = d + 1
  }
  s = 0
  while s < n {
    const m = ihStMod[s]
    if exposed[s] {
      ihOwn[m] = ihMixInt(ihOwn[m], ihStTok[s])
      ihSpan[m] = ihMixInt(ihSpan[m], ihStSpan[s])
      if ihStKind[s] == IH_ST_FN { ihExposedFns[m] = ihExposedFns[m] + 1 }
      const keepTy = !ihOn(IH_NO_TYPES)
        && !(ihStCutRet[s] && ihOn(IH_NO_INFERRED_TYPE))
      if shown[s] != "" && keepTy {
        ihOwn[m] = ihMixStr(ihMixStr(ihOwn[m], ihStMerged[s]), shown[s])
      }
      const guard = !ihOn(IH_NO_ELIDED_GUARD) && ihElided(shown[s])
      if ihStCutRet[s] && (guard || ihOn(IH_SHOW_INFERRED_RET)) {
        ihOwn[m] = ihMixInt(ihOwn[m], ihStBody[s])
      }
      if ihStCutAny[s] && !ihOn(IH_NO_MENTIONS) {
        men[m] = men[m] + ihMixInt(ihMixStr(IH_SEED, ihStMerged[s]), ihStMen[s])
      }
    } else if called[s] && ihStKind[s] == IH_ST_FN && !ihOn(IH_NO_MENTIONS) {
      men[m] = men[m] + ihMixInt(ihMixStr(IH_SEED, ihStMerged[s]), ihStMen[s])
    }
    s = s + 1
  }
  const done: boolean[] = []
  d = 0
  while d < ihOwn.length {
    ihOwn[d] = ihMixInt(ihOwn[d], men[d])
    done.push(false)
    ihDeepOf[d] = ihOwn[d]
    d = d + 1
  }
  if ihOn(IH_NO_DEEP) { return 0 }
  let m = 0
  while m < ihOwn.length {
    ihDeepVisit(m, done)
    m = m + 1
  }
  0
}

function ihDeepVisit(m: i32, done: boolean[]): i32 {
  if done[m] { return ihDeepOf[m] }
  done[m] = true
  let sum = 0
  let e = 0
  while e < ihEdgeFrom.length {
    if ihEdgeFrom[e] == m && ihEdgeTo[e] != m {
      sum = sum + ihMixInt(IH_SEED, ihDeepVisit(ihEdgeTo[e], done))
    }
    e = e + 1
  }
  ihDeepOf[m] = ihMixInt(ihOwn[m], sum)
  ihDeepOf[m]
}

// Keep what `ihReachOf` reads, folding the token-side digests again only under a new mask.
function ihKeep(byName: {[string]: i32[]}, shown: string[]) {
  const n = ihStMod.length
  ihByName = byName
  ihShown = shown
  ihByAny = Map()
  ihExpStamp = []
  ihStamp = 0
  ihSucc = []
  ihSuccMark = []
  ihSuccGen = 0
  ihQLo = []
  ihQHi = []
  ihQDone = []
  ihQMemo = []
  ihAdj = []
  ihDownMemo = []
  if ihDigMask != ihDrop { ihTokDigests() }
  let s = 0
  while s < n {
    ihExpStamp.push(0)
    ihSuccMark.push(0)
    ihQLo.push(-1)
    ihQHi.push(-1)
    ihQDone.push(false)
    ihQMemo.push(0)
    if ihStKind[s] != IH_ST_ROOT {
      const prev = ihByAny[ihStName[s]] ?? []
      prev.push(s)
      ihByAny[ihStName[s]] = prev
    }
    s = s + 1
  }
  0
}

// After `ihAmbientScan`, before the check: fold each module's token-side digests, its ambient
// statements, every statement's kind, name and tokens, and where its imports resolve.
export function ihTokDigests(): i32 {
  const n = ihStMod.length
  ihDigMask = ihDrop
  ihImpAt = Map()
  ihImpRowsOf = []
  let d = 0
  while d < ihKeys.length {
    ihAmb[d] = IH_SEED
    ihDecor[d] = IH_SEED
    ihImpMap[d] = IH_SEED
    const none: i32[] = []
    ihImpRowsOf.push(none)
    d = d + 1
  }
  let s = 0
  while s < n {
    const m = ihStMod[s]
    if s < ihStAmb.length && ihStAmb[s] && !ihOn(IH_NO_AMBIENT) {
      ihAmb[m] = ihMixInt(ihAmb[m], ihFullOf(s))
    }
    if !ihOn(IH_NO_DECOR) {
      let ex = 0
      if ihStExported[s] { ex = 1 }
      const k = ihMixInt(
        ihMixStr(ihMixInt(ihDecor[m], ihStKind[s]), ihStName[s]),
        ex,
      )
      ihDecor[m] = ihMixInt(k, ihStTok[s])
    }
    s = s + 1
  }
  let r = 0
  while r < ihImpMod.length {
    const m = ihImpMod[r]
    if m >= 0 && m < ihImpMap.length {
      ihImpAt[ihKeys[m] + "\n" + ihImpLocal[r]] = r
      ihImpRowsOf[m].push(r)
      let ok = "?"
      if ihImpOMod[r] >= 0 && ihImpOMod[r] < ihKeys.length {
        ok = ihKeys[ihImpOMod[r]]
      }
      if !ihOn(IH_NO_IMPORT_MAP) {
        const row = ihMixStr(
          ihMixStr(ihMixStr(IH_SEED, ihImpLocal[r]), ok),
          ihImpOName[r],
        )
        ihImpMap[m] = ihImpMap[m] + row
      }
    }
    r = r + 1
  }
  0
}

// The modules `o` reaches through its imports, itself included, kept per `o`.
function ihDownOf(o: i32): boolean[] {
  if ihAdj.length != ihKeys.length {
    ihAdj = []
    ihDownMemo = []
    let d = 0
    while d < ihKeys.length {
      const none: i32[] = []
      ihAdj.push(none)
      const no: boolean[] = []
      ihDownMemo.push(no)
      d = d + 1
    }
    let e = 0
    while e < ihEdgeFrom.length {
      const from = ihEdgeFrom[e]
      const to = ihEdgeTo[e]
      if from >= 0 && from < ihAdj.length && to >= 0 && to < ihAdj.length {
        ihAdj[from].push(to)
      }
      e = e + 1
    }
  }
  if ihDownMemo[o].length == ihKeys.length { return ihDownMemo[o] }
  const down: boolean[] = []
  let d = 0
  while d < ihKeys.length {
    down.push(false)
    d = d + 1
  }
  down[o] = true
  const queue = [o]
  let q = 0
  while q < queue.length {
    const out = ihAdj[queue[q]]
    let k = 0
    while k < out.length {
      if !down[out[k]] {
        down[out[k]] = true
        queue.push(out[k])
      }
      k = k + 1
    }
    q = q + 1
  }
  ihDownMemo[o] = down
  down
}

// Stamp statement `s` into `stamps` and `queue` once per reach.
function ihVisit(s: i32, stamps: i32[], queue: i32[]) {
  if stamps[s] != ihStamp {
    stamps[s] = ihStamp
    queue.push(s)
  }
  0
}

// Visit every statement of module `m` spelled `name`, or all of `m`'s when `name` is empty;
// the count it names.
function ihVisitName(m: i32, name: string, stamps: i32[], queue: i32[]): i32 {
  if name == "" {
    let s = 0
    let got = 0
    while s < ihStMod.length {
      if ihStMod[s] == m {
        ihVisit(s, stamps, queue)
        got = got + 1
      }
      s = s + 1
    }
    return got
  }
  const ss = ihByName[ihKeys[m] + "\n" + name] ?? []
  let i = 0
  while i < ss.length {
    ihVisit(ss[i], stamps, queue)
    i = i + 1
  }
  ss.length
}

// Add every statement of module `m` spelled `name` (all of `m`'s when empty) to the
// successor list being built, once each.
function ihSuccName(m: i32, name: string) {
  if name == "" {
    let s = 0
    while s < ihStMod.length {
      if ihStMod[s] == m { ihSuccAdd(s) }
      s = s + 1
    }
    return 0
  }
  const ss = ihByName[ihKeys[m] + "\n" + name] ?? []
  let i = 0
  while i < ss.length {
    ihSuccAdd(ss[i])
    i = i + 1
  }
  0
}

function ihSuccAdd(s: i32) {
  if ihSuccMark[s] != ihSuccGen {
    ihSuccMark[s] = ihSuccGen
    ihSucc.push(s)
  }
  0
}

// Add what the name `t` denotes in module `m`: its own statements, and the declaration an
// import binding it resolves to.
function ihSuccRef(m: i32, t: string) {
  ihSuccName(m, t)
  if ihOn(IH_NO_CROSS) { return 0 }
  const r = ihImpAt[ihKeys[m] + "\n" + t] ?? -1
  if r >= 0 {
    const om = ihImpOMod[r]
    if om >= 0 && om < ihKeys.length { ihSuccName(om, ihImpOName[r]) }
  }
  0
}

// Append what statement `x`'s tokens and checked type name to the successor list being built;
// a cut body's names never: the driver banks what a body writes by its answers.
function ihExpSucc(x: i32) {
  const m = ihStMod[x]
  ihSuccGen = ihSuccGen + 1
  if !ihOn(IH_NO_TOKEN_NAMES) {
    let k = ihStIdLo[x]
    while k < ihStIdHi[x] {
      ihSuccName(m, ihIds[k])
      k = k + 1
    }
    if !ihOn(IH_NO_CROSS) {
      let t = ihStLo[x]
      while t < ihStHi[x] {
        if t == ihStCutLo[x] && ihStCutHi[x] > t {
          t = ihStCutHi[x]
        } else {
          if P.toks[t].kind == "IDENT" { ihSuccRef(m, P.toks[t].text) }
          t = t + 1
        }
      }
    }
  }
  if !ihOn(IH_NO_TYPE_NAMES) && ihShown[x] != "" {
    const ns = ihTypeNames(ihShown[x])
    let k = 0
    while k < ns.length {
      const ss = ihByAny[ns[k]] ?? []
      let j = 0
      while j < ss.length {
        ihSuccAdd(ss[j])
        j = j + 1
      }
      k = k + 1
    }
  }
  0
}

// Build statement `x`'s exposed successors once, as if its body wrote nothing. A reach filters
// them by the modules below its origin.
function ihSuccOf(x: i32) {
  if ihQLo[x] >= 0 { return 0 }
  ihQLo[x] = ihSucc.length
  ihExpSucc(x)
  ihQHi[x] = ihSucc.length
  0
}

// The row an exposed statement gives an importer's reach, kept per statement: its name, tokens
// and type, without what only a question about its body's writes reads.
function ihExpRow(x: i32): i32 {
  if ihQDone[x] { return ihQMemo[x] }
  const m = ihStMod[x]
  let h = ihMixStr(ihMixStr(IH_SEED, ihKeys[m]), ihStName[x])
  if !ihOn(IH_NO_REACH_TOKENS) { h = ihMixInt(h, ihStTok[x]) }
  const shown = ihShown[x]
  const keepTy = !ihOn(IH_NO_TYPES)
    && !(ihStCutRet[x] && ihOn(IH_NO_INFERRED_TYPE))
  if shown != "" && keepTy { h = ihMixStr(h, shown) }
  const guard = !ihOn(IH_NO_ELIDED_GUARD) && ihElided(shown)
  if ihStCutRet[x] && (guard || ihOn(IH_SHOW_INFERRED_RET)) {
    h = ihMixInt(h, ihStBody[x])
  }
  ihQDone[x] = true
  ihQMemo[x] = h
  h
}

// Close `queue` over exposed successors below the origin (`down`), summing each statement's
// row once.
function ihClose(queue: i32[], down: boolean[]): i32 {
  let sum = 0
  let q = 0
  while q < queue.length {
    const x = queue[q]
    sum = sum + ihExpRow(x)
    ihSuccOf(x)
    let k = ihQLo[x]
    while k < ihQHi[x] {
      const s = ihSucc[k]
      if down[ihStMod[s]] { ihVisit(s, ihExpStamp, queue) }
      k = k + 1
    }
    q = q + 1
  }
  sum
}

// What importer `i`'s check can observe of origin `o` and the modules below it through what
// they expose: the statements its imports from `o` name, closed over the names their tokens
// and checked types spell. What a call's body writes the driver banks by its answers.
export function ihReachOf(i: i32, o: i32): i32 {
  if i < 0 || o < 0 || i >= ihKeys.length || o >= ihKeys.length { return 0 }
  if ihExpStamp.length != ihStMod.length { return 0 }
  ihStamp = ihStamp + 1
  const down = ihDownOf(o)
  const queue: i32[] = []
  let sum = 0
  const rows = ihImpRowsOf[i]
  let r = 0
  while r < rows.length {
    const row = rows[r]
    if ihImpOMod[row] == o {
      const got = ihVisitName(o, ihImpOName[row], ihExpStamp, queue)
      const h = ihMixStr(ihMixStr(IH_SEED, ihImpLocal[row]), ihImpOName[row])
      sum = sum + ihMixInt(h, got)
    }
    r = r + 1
  }
  sum + ihClose(queue, down)
}

// The key of the top-level statement holding each token of `toks`, in order: its module's key, a
// newline and its source name, behind a "!" when that name is not one statement's; "" for none.
export function ihStKeysOf(toks: i32[]): string[] {
  const owner: i32[] = []
  let t = 0
  while t < P.toks.length {
    owner.push(-1)
    t = t + 1
  }
  let s = 0
  while s < ihStMod.length {
    t = ihStLo[s]
    while t < ihStHi[s] && t < owner.length {
      owner[t] = s
      t = t + 1
    }
    s = s + 1
  }
  const out: string[] = []
  for k in toks {
    let key = ""
    if k >= 0 && k < owner.length && owner[k] >= 0 {
      const x = owner[k]
      key = ihKeys[ihStMod[x]] + "\n" + ihStName[x]
      if ihStName[x] == "" || (ihByName[key] ?? []).length != 1 {
        key = "!" + key
      }
    }
    out.push(key)
  }
  out
}

// For each builder key (a declaring module's key, a newline, a top-level source name): its
// declaring statement's tokens at `key + "\n"`, and at `key + "\n" + module key` a digest of
// the statements of that module (of the modules `only` selects, all when empty) whose tokens
// spell the name, merged or plain, other than its declaration. A key the tables lack is left out.
export function ihOccDigests(
  builders: string[],
  only: boolean[],
): {[string]: i32} {
  const out: {[string]: i32} = Map()
  const want: {[string]: i32[]} = Map()
  const declOf: i32[] = []
  const at: {[string]: i32} = Map()
  let x = 0
  while x < ihStMod.length {
    if ihStKind[x] != IH_ST_ROOT {
      at[ihKeys[ihStMod[x]] + "\n" + ihStName[x]] = x
    }
    x = x + 1
  }
  let b = 0
  while b < builders.length {
    const d = at[builders[b]] ?? -1
    declOf.push(d)
    if d >= 0 {
      out[builders[b] + "\n"] = ihFullOf(d)
      const names = [ihStMerged[d], ihStName[d]]
      let n = 0
      while n < names.length {
        if n == 0 || names[1] != names[0] { ihListPush(want, names[n], b) }
        n = n + 1
      }
    }
    b = b + 1
  }
  x = 0
  while x < ihStMod.length {
    const m = ihStMod[x]
    if only.length == 0 || (m < only.length && only[m]) {
      const met: {[i32]: boolean} = Map()
      const skipped: {[i32]: boolean} = Map()
      let i = ihStLo[x]
      while i < ihStHi[x] && i < P.toks.length {
        const t = P.toks[i]
        if t.kind == "IDENT" {
          for w in want[t.text] ?? [] {
            if declOf[w] == x && !skipped.has(w) {
              skipped[w] = true
            } else if !met.has(w) {
              met[w] = true
              const key = builders[w] + "\n" + ihKeys[m]
              out[key] = ihMixInt(out[key] ?? IH_SEED, ihFullOf(x))
            }
          }
        }
        i = i + 1
      }
    }
    x = x + 1
  }
  out
}

// Whether the identifier at token `i` of tokens `[lo, hi)` is rebound there: assigned or
// stepped by name, not through a member and not declared.
function ihRebindsAt(i: i32, lo: i32, hi: i32): boolean {
  if i > lo {
    const pk = P.toks[i - 1].kind
    if pk == "PLUSPLUS" || pk == "MINUSMINUS" { return true }
    if (pk == "DOT" || pk == "QUESTION_DOT" || pk == "LET" || pk == "CONST") {
      return false
    }
  }
  i + 1 < hi && ihIsAssignOp(P.toks[i + 1].kind)
}

// The spellings, as `module key + "\n" + text`, that may name top-level `name` of module `m`:
// its own, each import binding it, and its source name in each module importing all of `m`.
function ihSpellings(m: i32, name: string): string[] {
  const out = [ihKeys[m] + "\n" + name]
  let r = 0
  while r < ihImpMod.length {
    const im = ihImpMod[r]
    if ihImpOMod[r] == m && im >= 0 && im < ihKeys.length {
      if ihImpOName[r] == name { out.push(ihKeys[im] + "\n" + ihImpLocal[r]) }
      else if ihImpOName[r] == "" { out.push(ihKeys[im] + "\n" + name) }
    }
    r = r + 1
  }
  out
}

// Whether statement `x` is a run of imports or re-exports rather than code.
function ihImportRun(x: i32): boolean {
  if ihStKind[x] != IH_ST_ROOT || ihStLo[x] >= P.toks.length { return false }
  const k = P.toks[ihStLo[x]].kind
  k == "IMPORT" || k == "EXPORT"
}

// Appends statement `x` to the list `m` holds at `k`, starting one where `k` is absent.
function ihListPush(m: {[string]: i32[]}, k: string, x: i32) {
  const prev = m[k] ?? []
  prev.push(x)
  m[k] = prev
  0
}

// `ihListPush` unless `x` is already the last statement of that list.
function ihListPushNew(m: {[string]: i32[]}, k: string, x: i32) {
  const prev = m[k] ?? []
  if prev.length == 0 || prev[prev.length - 1] != x {
    prev.push(x)
    m[k] = prev
  }
  0
}

// Appends `y` to `set` unless `inSet` already holds it.
function ihStmtAdd(inSet: {[i32]: boolean}, set: i32[], y: i32) {
  if !inSet.has(y) {
    inSet[y] = true
    set.push(y)
  }
  0
}

// Sets `out[k]` to 1 when statement `y` is code (not an import) in a module `sel` selects.
function ihMarkSel(out: {[string]: i32}, k: string, sel: boolean[], y: i32) {
  const ym = ihStMod[y]
  if ym < sel.length && sel[ym] && !ihImportRun(y) { out[k] = 1 }
  0
}

// Per key (module key, newline, source name): `\nW` digests its writer closure and `\nE` the
// statements naming it, `\nw`/`\ne` mark one (not an import) in a module `only` selects.
// `"\nO"` digests every top-level `let` and root statement, `"\no"` marks one in a module
// `before` selects. A key the tables lack is left out.
export function ihWriterDigests(
  keys: string[],
  only: boolean[],
  before: boolean[],
): {[string]: i32} {
  const out: {[string]: i32} = Map()
  const kix: {[string]: i32} = Map()
  let m = 0
  while m < ihKeys.length {
    kix[ihKeys[m]] = m
    m = m + 1
  }
  // Only a top-level name or an import binding can be a spelling, so other tokens are skipped.
  const named: {[string]: boolean} = Map()
  let x = 0
  while x < ihStName.length {
    if ihStName[x] != "" { named[ihStName[x]] = true }
    if ihStKind[x] == IH_ST_LET {
      let k = ihStIdLo[x]
      while k < ihStIdHi[x] {
        named[ihIds[k]] = true
        k = k + 1
      }
    }
    x = x + 1
  }
  for l in ihImpLocal { named[l] = true }
  const men: {[string]: i32[]} = Map()
  const wr: {[string]: i32[]} = Map()
  let ord = IH_SEED
  x = 0
  while x < ihStMod.length {
    const sm = ihStMod[x]
    if ihStKind[x] == IH_ST_ROOT || ihStKind[x] == IH_ST_LET {
      ord = ord + ihFullOf(x)
      ihMarkSel(out, "\no", before, x)
    }
    const lo = ihStLo[x]
    const hi = ihStHi[x]
    let i = lo
    while i < hi && i < P.toks.length {
      const t = P.toks[i]
      if t.kind == "IDENT" && named.has(t.text) {
        const k = ihKeys[sm] + "\n" + t.text
        ihListPushNew(men, k, x)
        if ihRebindsAt(i, lo, hi) { ihListPushNew(wr, k, x) }
      }
      i = i + 1
    }
    x = x + 1
  }
  out["\nO"] = ord
  for key in keys {
    const nl = key.indexOf("\n")
    const d = kix[key.slice(0, nl)] ?? -1
    if nl > 0 && d >= 0 {
      const seeds = ihSpellings(d, key.slice(nl + 1, key.length))
      const inSet: {[i32]: boolean} = Map()
      const set: i32[] = []
      for s in seeds {
        for y in wr[s] ?? [] { ihStmtAdd(inSet, set, y) }
      }
      let q = 0
      while q < set.length {
        const y = set[q]
        if ihStKind[y] != IH_ST_ROOT && ihStName[y] != "" {
          for s in ihSpellings(ihStMod[y], ihStName[y]) {
            for z in men[s] ?? [] { ihStmtAdd(inSet, set, z) }
          }
        }
        q = q + 1
      }
      let w = IH_SEED
      const kw = key + "\nw"
      for y in set {
        w = w + ihFullOf(y)
        ihMarkSel(out, kw, only, y)
      }
      out[key + "\nW"] = w
      const seen: {[i32]: boolean} = Map()
      const naming: i32[] = []
      for s in seeds {
        for y in men[s] ?? [] { ihStmtAdd(seen, naming, y) }
      }
      let e = IH_SEED
      const ke = key + "\ne"
      for y in naming {
        e = e + ihFullOf(y)
        ihMarkSel(out, ke, only, y)
      }
      out[key + "\nE"] = e
    }
  }
  out
}

// Readers over the last armed module compile, by module table index (0 is the entry).
export function ifaceHashCount(): i32 { ihOwn.length }

export function ifaceHashKeyLen(i: i32): i32 {
  if i < 0 || i >= ihKeys.length { return 0 }
  ihKeys[i].length
}

export function ifaceHashKeyAt(i: i32, j: i32): i32 {
  if i < 0 || i >= ihKeys.length { return 0 }
  if j < 0 || j >= ihKeys[i].length { return 0 }
  ihKeys[i][j]
}

// `which` 0 the module's own hash, 1 its deep hash over its imports, 2 its declaration
// positions, 3 its count of cut bodies, 4 its count of top-level functions, 5 of exposed ones,
// 6 its ambient statements, 7 every statement's kind, name and tokens, 8 where its imports resolve.
export function ifaceHashOf(i: i32, which: i32): i32 {
  if i < 0 || i >= ihOwn.length { return 0 }
  if which == 0 { return ihOwn[i] }
  if which == 1 { return ihDeepOf[i] }
  if which == 2 { return ihSpan[i] }
  if which == 3 { return ihCut[i] }
  if which == 4 { return ihFns[i] }
  if which == 5 { return ihExposedFns[i] }
  if which == 6 { return ihAmb[i] }
  if which == 7 { return ihDecor[i] }
  if which == 8 { return ihImpMap[i] }
  0
}

// A hash of the line and column of every token in `[a, b)`, bodies included.
export function ihPosHash(a: i32, b: i32): i32 {
  let sp = IH_SEED
  let i = a
  while i < b {
    const t = P.toks[i]
    sp = ihMixInt(ihMixInt(sp, t.line), t.col)
    i = i + 1
  }
  sp
}

// The mask the current hashes are folded under, so a skipped check compares like with like.
export function ihMask(): i32 { ihDrop }

// Module `m`'s nine readings, served from a check that did not re-check it (`checkSkipArm`).
export function ihCarry(m: i32, vals: i32[]): i32 {
  if m < 0 || m >= ihOwn.length || vals.length < 9 { return 0 }
  ihOwn[m] = vals[0]
  ihDeepOf[m] = vals[1]
  ihSpan[m] = vals[2]
  ihCut[m] = vals[3]
  ihFns[m] = vals[4]
  ihExposedFns[m] = vals[5]
  ihAmb[m] = vals[6]
  ihDecor[m] = vals[7]
  ihImpMap[m] = vals[8]
  0
}
