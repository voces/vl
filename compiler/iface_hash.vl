// A module's interface hash: what its dependents can observe of it, so a module whose hash and
// whose imports' hashes are unchanged leaves every dependent's check and emit unchanged (S5 in
// incremental-compilation-design.md, steps 4 and 5). A declaration is exposed when a dependent
// can reach it: an export, a top-level `let` or statement (the entry's start runs them), or a
// name an exposed declaration's tokens or checked type spell. An exposed declaration gives its
// tokens, with every body cut that no caller checks, and its checked type; a function reached
// only by a call from a cut body gives just the names its body mentions and how. Armed only by
// a test or a probe; the build never reads it.
import {
  AsExpr,
  FuncDecl,
  IsExpr,
  LetDecl,
  P,
  Param,
  Program,
  TypeDecl,
  TypeRef,
  UnionDecl,
} from "./ast"
import { nodeToks } from "./ast"
import { nodeLastTok, nodeStartTok } from "./fmt_util"
import { TokKind } from "./lexer"
import { lookup } from "./check_scopes"
import { tyMayHoldFn, tyToStr } from "./check_types"
import { tyHasTyVar } from "./tyquery"

let ihArmed = false
// Ingredients a mutation check removes, one bit each (see `ifaceHashDrop`).
let ihDrop = 0
const IH_KEEP_GENERIC = 1
const IH_KEEP_UNTYPED_PARAM = 2
const IH_SHOW_INFERRED_RET = 4
const IH_NO_TYPES = 8
const IH_NO_MENTIONS = 16
const IH_NO_DEEP = 32
const IH_NO_INFERRED_TYPE = 64
const IH_NO_ELIDED_GUARD = 128
const IH_ALL_EXPOSED = 256
const IH_NO_TYPE_NAMES = 512
const IH_NO_LET_ROOTS = 1024
const IH_NO_CALLEES = 2048
const IH_NO_TOKEN_NAMES = 4096
const IH_NO_CROSS = 8192
const IH_NO_AMBIENT = 16384
const IH_NO_LIVE = 32768
const IH_NO_FRESH = 65536
const IH_NO_DECOR = 131072
const IH_NO_IMPORT_MAP = 262144

// Statement kinds.
const IH_ST_ROOT = 0
const IH_ST_FN = 1
const IH_ST_LET = 2
const IH_ST_TYPE = 3

// Per module table index, filled by one compile.
let ihKeys: string[] = []
let ihOwn: i32[] = []
let ihDeepOf: i32[] = []
let ihSpan: i32[] = []
let ihCut: i32[] = []
let ihFns: i32[] = []
let ihExposedFns: i32[] = []
// Per top-level statement, in source order; tokens outside every statement are a root of their own.
let ihStMod: i32[] = []
let ihStKind: i32[] = []
let ihStName: string[] = []
let ihStMerged: string[] = []
let ihStExported: boolean[] = []
let ihStTok: i32[] = []
let ihStSpan: i32[] = []
let ihStCutRet: boolean[] = []
let ihStCutAny: boolean[] = []
let ihStBody: i32[] = []
let ihStMen: i32[] = []
// The top-level names a statement's hashed tokens spell (`ihStIdLo`..`ihStIdHi` into `ihIds`),
// and the names its body mentions (`ihStCallLo`..`ihStCallHi` into `ihCalls`).
let ihStIdLo: i32[] = []
let ihStIdHi: i32[] = []
let ihIds: string[] = []
let ihStCallLo: i32[] = []
let ihStCallHi: i32[] = []
let ihCalls: string[] = []
// Import edges: module `ihEdgeFrom[e]` reads module `ihEdgeTo[e]`.
let ihEdgeFrom: i32[] = []
let ihEdgeTo: i32[] = []
// A statement's whole token range and its hash, whether it declares something another
// module's check reads without importing it (`ihAmbientScan`), whether its body assigns or
// calls a method, and whether a parameter's declared type may hold a reference.
let ihStLo: i32[] = []
let ihStHi: i32[] = []
let ihStFull: i32[] = []
let ihStAmb: boolean[] = []
let ihStWrites: boolean[] = []
let ihStRefParam: boolean[] = []
// Import rows: module `ihImpMod[k]` binds `ihImpLocal[k]` to `ihImpOName[k]` of module
// `ihImpOMod[k]`, the declaring one; an empty name is a namespace import.
let ihImpMod: i32[] = []
let ihImpLocal: string[] = []
let ihImpOMod: i32[] = []
let ihImpOName: string[] = []
// Per module: the digest of its ambient statements and their count, the digest of every
// top-level declaration with bodies cut, and the digest of its import rows.
let ihAmb: i32[] = []
let ihAmbN: i32[] = []
let ihDecor: i32[] = []
let ihImpMap: i32[] = []
// From the last `ihFinish`: each statement's rendered type, and statements by module and name.
let ihShown: string[] = []
let ihByName: {[string]: i32[]} = Map()
let ihByAny: {[string]: i32[]} = Map()
// `ihReachOf`'s marks, stamped per call so a call costs its closure, not the table.
let ihExpStamp: i32[] = []
let ihCalStamp: i32[] = []
let ihStamp = 0
let ihFreshHit = false
let ihImpAt: {[string]: i32} = Map()
let ihImpRowsOf: i32[][] = []
// Per statement, built on first reach: its exposed and callee successors as ranges of
// `ihSucc`, and its exposed row with whether that row is a fresh builder.
let ihSucc: i32[] = []
let ihSuccMark: i32[] = []
let ihSuccGen = 0
let ihExpLo: i32[] = []
let ihExpHi: i32[] = []
let ihCalLo: i32[] = []
let ihCalHi: i32[] = []
let ihExpDone: boolean[] = []
let ihExpMemo: i32[] = []
let ihExpFresh: boolean[] = []
// Per module, the import adjacency and, built on first reach, the modules below it.
let ihAdj: i32[][] = []
let ihDownMemo: boolean[][] = []

// Arm the hash for later module compiles (`on` 1), or disarm it (0).
export function ifaceHashArm(on: i32): i32 {
  ihArmed = on != 0
  0
}

export function ifaceHashArmed(): boolean { ihArmed }

// Drop ingredients from later hashes, a bit mask; the soundness suite's mutation check.
export function ifaceHashDrop(mask: i32): i32 {
  ihDrop = mask
  0
}

// Fold the last armed check's rows again under `mask`, so one check yields every mask's hashes.
export function ifaceHashRefold(mask: i32): i32 {
  ihDrop = mask
  ihFinish()
}

function ihOn(bit: i32): boolean { (ihDrop & bit) != 0 }

function ihMixByte(h: i32, b: i32): i32 { (h ^ b) * 16777619 }

function ihMixInt(h: i32, v: i32): i32 {
  let x = ihMixByte(h, v & 255)
  x = ihMixByte(x, (v >> 8) & 255)
  x = ihMixByte(x, (v >> 16) & 255)
  ihMixByte(x, (v >> 24) & 255)
}

function ihMixStr(h: i32, s: string): i32 {
  let x = ihMixInt(h, s.length)
  let i = 0
  while i < s.length {
    x = ihMixByte(x, s[i])
    i = i + 1
  }
  x
}

const IH_SEED = -2128831035

// Forget the previous graph and size the tables to `keys`, the module table.
export function ihBegin(keys: string[]): i32 {
  ihKeys = keys
  ihOwn = []
  ihDeepOf = []
  ihSpan = []
  ihCut = []
  ihFns = []
  ihExposedFns = []
  ihStMod = []
  ihStKind = []
  ihStName = []
  ihStMerged = []
  ihStExported = []
  ihStTok = []
  ihStSpan = []
  ihStCutRet = []
  ihStCutAny = []
  ihStBody = []
  ihStMen = []
  ihStIdLo = []
  ihStIdHi = []
  ihIds = []
  ihStCallLo = []
  ihStCallHi = []
  ihCalls = []
  ihEdgeFrom = []
  ihEdgeTo = []
  ihStLo = []
  ihStHi = []
  ihStFull = []
  ihStAmb = []
  ihStWrites = []
  ihStRefParam = []
  ihImpMod = []
  ihImpLocal = []
  ihImpOMod = []
  ihImpOName = []
  ihAmb = []
  ihAmbN = []
  ihDecor = []
  ihImpMap = []
  ihShown = []
  ihByName = Map()
  ihByAny = Map()
  ihExpStamp = []
  ihCalStamp = []
  ihImpAt = Map()
  let i = 0
  while i < keys.length {
    ihOwn.push(IH_SEED)
    ihDeepOf.push(IH_SEED)
    ihSpan.push(IH_SEED)
    ihCut.push(0)
    ihFns.push(0)
    ihExposedFns.push(0)
    ihAmb.push(IH_SEED)
    ihAmbN.push(0)
    ihDecor.push(IH_SEED)
    ihImpMap.push(IH_SEED)
    i = i + 1
  }
  0
}

// Module `m` binds `local` to `name` of module `origin`, the module declaring it; an empty
// `name` binds the whole of `origin`.
export function ihImport(
  m: i32,
  local: string,
  origin: i32,
  name: string,
): i32 {
  ihImpMod.push(m)
  ihImpLocal.push(local)
  ihImpOMod.push(origin)
  ihImpOName.push(name)
  0
}

export function ihEdge(from: i32, to: i32): i32 {
  ihEdgeFrom.push(from)
  ihEdgeTo.push(to)
  0
}

// Whether a caller's check reads the function's body: it has a type parameter or an
// unannotated parameter. An inferred return is read through the checked type instead.
function ihBodyVisible(fd: FuncDecl): boolean {
  if fd.fnTyParams.length > 0 && !ihOn(IH_KEEP_GENERIC) { return true }
  let i = 0
  while i < fd.fnParams.length {
    const pn = P.nodes[fd.fnParams[i]]
    if pn is Param {
      if pn.parType < 0 && !ihOn(IH_KEEP_UNTYPED_PARAM) { return true }
    }
    i = i + 1
  }
  false
}

// The token index of the `{` that opens the block whose `}` is token `close`, or -1.
function ihOpenOf(close: i32, lo: i32): i32 {
  if close < lo || close >= P.toks.length { return -1 }
  if P.toks[close].kind != "RBRACE" { return -1 }
  let depth = 0
  let i = close
  while i >= lo {
    const k = P.toks[i].kind
    const closes = k == "RBRACE"
    const opens = k == "LBRACE"
    if closes { depth = depth + 1 }
    if opens {
      depth = depth - 1
      if depth == 0 { return i }
    }
    i = i - 1
  }
  -1
}

function ihIsAssignOp(k: TokKind): boolean {
  k == "EQUAL"
    || k == "PLUSEQ"
    || k == "MINUSEQ"
    || k == "STAREQ"
    || k == "SLASHEQ"
    || k == "PERCENTEQ"
    || k == "AMPEQ"
    || k == "PIPEEQ"
    || k == "CARETEQ"
    || k == "SHLEQ"
    || k == "SHREQ"
    || k == "USHREQ"
    || k == "PLUSPLUS"
    || k == "MINUSMINUS"
}

// How the mention at token `i` uses its name: `w` written through, `c` called, `m` a method
// called on it, `d` a member of something else, `r` read.
function ihMentionKind(i: i32, hi: i32): string {
  if i > 0 {
    const pk = P.toks[i - 1].kind
    if pk == "DOT" || pk == "QUESTION_DOT" { return "d" }
  }
  let j = i + 1
  let path = 0
  let more = true
  while more && j < hi {
    const k = P.toks[j].kind
    if (
      (k == "DOT" || k == "QUESTION_DOT")
      && j + 1 < hi
      && P.toks[j + 1].kind == "IDENT"
    ) {
      j = j + 2
      path = path + 1
    } else if k == "LBRACK" {
      let depth = 0
      let stop = false
      while !stop && j < hi {
        const bk = P.toks[j].kind
        if bk == "LBRACK" { depth = depth + 1 }
        if bk == "RBRACK" {
          depth = depth - 1
          if depth == 0 { stop = true }
        }
        j = j + 1
      }
      path = path + 1
    } else {
      more = false
    }
  }
  if j >= hi { return "r" }
  const nk = P.toks[j].kind
  if ihIsAssignOp(nk) { return "w" }
  if nk == "LPAREN" {
    if path == 0 { return "c" }
    return "m"
  }
  "r"
}

function ihHasName(names: string[], name: string): boolean {
  let i = 0
  while i < names.length {
    if names[i] == name { return true }
    i = i + 1
  }
  false
}

// The order-free hash of the names body `[lo, hi)` mentions out of `seen` and its own
// parameters `ps`, with how; each top-level name it mentions is pushed on `ihCalls`.
function ihMentions(
  lo: i32,
  hi: i32,
  seen: {[string]: boolean},
  ps: string[],
): i32 {
  const got: {[string]: boolean} = Map()
  let sum = 0
  let i = lo
  while i < hi {
    const t = P.toks[i]
    if t.kind == "IDENT" {
      const top = seen.has(t.text)
      if top || ihHasName(ps, t.text) {
        const row = ihMentionKind(i, hi) + ":" + t.text
        if !got.has(row) {
          got[row] = true
          sum = sum + ihMixStr(IH_SEED, row)
          if top { ihCalls.push(t.text) }
        }
      }
    }
    i = i + 1
  }
  sum
}

// The source spelling of a merged top-level name: `name$mN` without its suffix.
function ihSourceName(name: string): string {
  let i = name.length - 1
  while i > 0 {
    if name[i] == '$' && i + 1 < name.length && name[i + 1] == 'm' {
      return name.slice(0, i)
    }
    i = i - 1
  }
  name
}

// The tokens `[a, b)` minus the cut `[cutLo, cutHi)` (none when `cutLo` < 0) into the
// current statement: its text hash, its position hash, and the top-level names it spells.
function ihTokens(
  a: i32,
  b: i32,
  cutLo: i32,
  cutHi: i32,
  tops: {[string]: boolean},
) {
  let h = IH_SEED
  let sp = IH_SEED
  let cut = cutLo
  let i = a
  while i < b {
    // The cut fires once: an empty body has `cutLo == cutHi`, and the jump lands on it again.
    if i == cut {
      h = ihMixStr(h, "{cut}")
      cut = -1
      i = cutHi
    } else {
      const t = P.toks[i]
      h = ihMixStr(h, t.text)
      sp = ihMixInt(ihMixInt(sp, t.line), t.col)
      if t.kind == "IDENT" && tops.has(t.text) { ihIds.push(t.text) }
      i = i + 1
    }
  }
  ihStTok.push(h)
  ihStSpan.push(sp)
  ihStLo.push(a)
  ihStHi.push(b)
  ihStFull.push(ihTokHash(a, b))
}

// Open a statement row of module `m`; `ihTokens` and `ihStClose` complete it.
function ihStOpen(m: i32, kind: i32, merged: string, exported: boolean) {
  ihStMod.push(m)
  ihStKind.push(kind)
  ihStMerged.push(merged)
  ihStName.push(ihSourceName(merged))
  ihStExported.push(exported)
  ihStIdLo.push(ihIds.length)
  ihStCallLo.push(ihCalls.length)
}

function ihStClose(
  cutRet: boolean,
  cutAny: boolean,
  body: i32,
  men: i32,
  writes: boolean,
  refParam: boolean,
) {
  ihStWrites.push(writes)
  ihStRefParam.push(refParam)
  ihStCutRet.push(cutRet)
  ihStCutAny.push(cutAny)
  ihStBody.push(body)
  ihStMen.push(men)
  ihStIdHi.push(ihIds.length)
  ihStCallHi.push(ihCalls.length)
}

// The tokens `[a, b)` that belong to no top-level statement (an import, a re-export) as a root.
function ihOrphans(m: i32, a: i32, b: i32, tops: {[string]: boolean}) {
  if a >= b { return 0 }
  ihStOpen(m, IH_ST_ROOT, "", false)
  ihTokens(a, b, -1, -1, tops)
  ihStClose(false, false, IH_SEED, 0, false, false)
  0
}

// Whether body tokens `[lo, hi)` assign or call a method, the two ways a body writes through
// a reference it is handed or reads.
function ihBodyWrites(lo: i32, hi: i32): boolean {
  let i = lo
  while i < hi {
    const k = P.toks[i].kind
    if ihIsAssignOp(k) { return true }
    if (
      (k == "DOT" || k == "QUESTION_DOT")
      && i + 2 < hi
      && P.toks[i + 1].kind == "IDENT"
      && P.toks[i + 2].kind == "LPAREN"
    ) {
      return true
    }
    i = i + 1
  }
  false
}

// Whether a parameter of `fd` is declared at a type that may hold a reference.
function ihRefParam(fd: FuncDecl): boolean {
  for p in fd.fnParams {
    const pn = P.nodes[p]
    if pn is Param && pn.parType >= 0 {
      const tn = P.nodes[pn.parType]
      if !(tn is TypeRef) || !ihScalarSpelling(tn.tyName) { return true }
    }
  }
  false
}

function ihWordCode(c: i32): boolean {
  (c >= 'a' && c <= 'z')
    || (c >= 'A' && c <= 'Z')
    || (c >= '0' && c <= '9')
    || c == '_'
}

function ihScalarName(w: string): boolean {
  w == "i8"
    || w == "i16"
    || w == "i32"
    || w == "i64"
    || w == "u8"
    || w == "u16"
    || w == "u32"
    || w == "u64"
    || w == "f32"
    || w == "f64"
    || w == "boolean"
    || w == "string"
    || w == "null"
    || w == "true"
    || w == "false"
}

// Whether a type spelling names only scalars and literals: no record, list, map, function or
// named type, so nothing of that type is shared by reference.
function ihScalarSpelling(s: string): boolean {
  let i = 0
  while i < s.length {
    const c = s[i]
    if c == 34 || c == 39 {
      let j = i + 1
      while j < s.length && s[j] != c {
        if s[j] == 92 { j = j + 1 }
        j = j + 1
      }
      i = j + 1
    } else if ihWordCode(c) {
      let j = i + 1
      while j < s.length && (ihWordCode(s[j]) || s[j] == '$') { j = j + 1 }
      const w = ihSourceName(s.slice(i, j))
      const digit = c >= '0' && c <= '9'
      if !digit && !ihScalarName(w) { return false }
      i = j
    } else if c == '{' || c == '[' || c == '(' || c == '<' || c == '=' {
      return false
    } else {
      i = i + 1
    }
  }
  true
}

// Whether a type spelling holds a record, which a literal in another module's check can adopt.
function ihAmbSpelling(s: string): boolean {
  let i = 0
  while i < s.length {
    if s[i] == '{' { return true }
    i = i + 1
  }
  false
}

// Whether `fd` is found by a call that does not name it through an import: a method on its
// first parameter `self`, a getter, or an operator.
function ihReceiverFn(fd: FuncDecl): boolean {
  const nm = ihSourceName(fd.fnName)
  let i = 0
  while i < nm.length {
    if !ihWordCode(nm[i]) { return true }
    i = i + 1
  }
  if fd.fnParams.length == 0 { return false }
  const pn = P.nodes[fd.fnParams[0]]
  pn is Param && pn.parName == "self"
}

// The statement row holding token `t`, or -1.
function ihStAt(t: i32): i32 {
  if t < 0 { return -1 }
  let lo = 0
  let hi = ihStLo.length
  while lo < hi {
    const mid = (lo + hi) / 2
    if ihStLo[mid] <= t { lo = mid + 1 } else { hi = mid }
  }
  const s = lo - 1
  if s < 0 || t >= ihStHi[s] { return -1 }
  s
}

// After every module's rows: mark the statements that hold a type declaration, a structural
// type spelling, or a receiver-found function, anywhere in their tokens, bodies included.
export function ihAmbientScan(): i32 {
  ihStAmb = []
  let s = 0
  while s < ihStMod.length {
    ihStAmb.push(ihStKind[s] == IH_ST_TYPE)
    s = s + 1
  }
  let x = 0
  while x < P.nodes.length {
    const nd = P.nodes[x]
    let amb = false
    if nd is TypeRef { amb = ihAmbSpelling(nd.tyName) }
    if nd is IsExpr { amb = ihAmbSpelling(nd.isVariant) }
    if nd is AsExpr { amb = ihAmbSpelling(nd.asTy) }
    if nd is TypeDecl { amb = true }
    if nd is UnionDecl { amb = true }
    if nd is FuncDecl { amb = ihReceiverFn(nd) }
    if amb {
      const at = ihStAt(nodeLastTok(x))
      if at >= 0 { ihStAmb[at] = true }
    }
    x = x + 1
  }
  0
}

function ihTokHash(a: i32, b: i32): i32 {
  let h = IH_SEED
  let i = a
  while i < b {
    h = ihMixStr(h, P.toks[i].text)
    i = i + 1
  }
  h
}

// Module `m`'s token-side rows, from its parse `root` (tokens `[lo, hi)`) before the check
// pins anything; `visible` holds the local names its imports bind and `exported` the names
// it declares with `export`.
export function ihModule(
  m: i32,
  root: i32,
  lo: i32,
  hi: i32,
  visible: string[],
  exported: string[],
): i32 {
  if m < 0 || m >= ihOwn.length { return 0 }
  const rn = P.nodes[root]
  if rn is Program {
    const ss = rn.progStmts
    // `seen` holds what a body mention may name; `tops` adds the module's type names.
    const seen: {[string]: boolean} = Map()
    const tops: {[string]: boolean} = Map()
    let v = 0
    while v < visible.length {
      seen[visible[v]] = true
      v = v + 1
    }
    let si = 0
    while si < ss.length {
      const st = P.nodes[ss[si]]
      if st is FuncDecl {
        seen[ihSourceName(st.fnName)] = true
        tops[ihSourceName(st.fnName)] = true
      }
      if st is LetDecl {
        seen[ihSourceName(st.letName)] = true
        tops[ihSourceName(st.letName)] = true
      }
      if st is TypeDecl { tops[ihSourceName(st.tdName)] = true }
      if st is UnionDecl { tops[ihSourceName(st.udName)] = true }
      si = si + 1
    }
    let at = lo
    si = 0
    while si < ss.length {
      const sx = ss[si]
      const st = P.nodes[sx]
      let start = nodeStartTok(sx)
      let end = -1
      if sx >= 0 && sx < nodeToks.length { end = nodeToks[sx] + 1 }
      if start < at || start >= hi || end <= start || end > hi {
        si = si + 1
        continue
      }
      // The `export` before a declaration's own first token stays with it.
      while start > at && P.toks[start - 1].kind == "EXPORT" {
        start = start - 1
      }
      ihOrphans(m, at, start, tops)
      let kind = IH_ST_ROOT
      let merged = ""
      if st is FuncDecl {
        kind = IH_ST_FN
        merged = st.fnName
      }
      if st is LetDecl {
        kind = IH_ST_LET
        merged = st.letName
      }
      if st is TypeDecl {
        kind = IH_ST_TYPE
        merged = st.tdName
      }
      if st is UnionDecl {
        kind = IH_ST_TYPE
        merged = st.udName
      }
      ihStOpen(m, kind, merged, ihHasName(exported, ihSourceName(merged)))
      let cutLo = -1
      let cutHi = -1
      let cutRet = false
      let body = IH_SEED
      let men = 0
      if st is FuncDecl {
        ihFns[m] = ihFns[m] + 1
        if st.fnBody >= 0 && st.fnBody < nodeToks.length {
          const close = nodeToks[st.fnBody]
          const open = ihOpenOf(close, start)
          if open >= start && close < end {
            const ps: string[] = []
            let pi = 0
            while pi < st.fnParams.length {
              const pn = P.nodes[st.fnParams[pi]]
              if pn is Param { ps.push(pn.parName) }
              pi = pi + 1
            }
            men = ihMentions(open + 1, close, seen, ps)
            if !ihBodyVisible(st) {
              cutLo = open + 1
              cutHi = close
              cutRet = st.fnRet < 0
              body = ihTokHash(cutLo, cutHi)
              ihCut[m] = ihCut[m] + 1
            }
          }
        }
      }
      let writes = false
      let refParam = false
      if st is FuncDecl && cutLo >= 0 {
        writes = ihBodyWrites(cutLo, cutHi)
        refParam = ihRefParam(st)
      }
      ihTokens(start, end, cutLo, cutHi, tops)
      ihStClose(cutRet, cutLo >= 0, body, men, writes, refParam)
      at = end
      si = si + 1
    }
    ihOrphans(m, at, hi, tops)
  }
  0
}

// The identifier runs of a rendered type, by source spelling.
function ihTypeNames(shown: string): string[] {
  const out: string[] = []
  let i = 0
  while i < shown.length {
    const c = shown[i]
    const isStart = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
    if !isStart {
      i = i + 1
      continue
    }
    let j = i + 1
    let more = true
    while more && j < shown.length {
      const d = shown[j]
      more = (d >= 'a' && d <= 'z')
        || (d >= 'A' && d <= 'Z')
        || (d >= '0' && d <= '9')
        || d == '_'
        || d == '$'
      if more { j = j + 1 }
    }
    out.push(ihSourceName(shown.slice(i, j)))
    i = j
  }
  out
}

// Whether a rendered type elided part of itself, so the rendering does not determine the type.
function ihElided(shown: string): boolean {
  let i = 0
  while i < shown.length {
    // The UTF-8 encoding of the ellipsis `tyToStr` elides with.
    if (
      shown[i] == 226
      && i + 2 < shown.length
      && shown[i + 1] == 128
      && shown[i + 2] == 166
    ) {
      return true
    }
    i = i + 1
  }
  false
}

// Whether the binding `merged`'s checked type is determined by its rendering and holds no
// function or type variable, so a dependent's uses of it read nothing but that type.
export function ihPlainBinding(merged: string): boolean {
  const ix = lookup(merged)
  if ix < 0 || tyMayHoldFn(ix, 0) || tyHasTyVar(ix) { return false }
  !ihElided(tyToStr(ix))
}

// Mark every statement of module `m` spelled `name` with `mark`, queueing the ones it newly marks.
function ihReach(
  byName: {[string]: i32[]},
  m: i32,
  name: string,
  marks: boolean[],
  queue: i32[],
) {
  const key = ihKeys[m] + "\n" + name
  const ss = byName[key] ?? []
  let i = 0
  while i < ss.length {
    if !marks[ss[i]] {
      marks[ss[i]] = true
      queue.push(ss[i])
    }
    i = i + 1
  }
  0
}

// After the check: close each module's exposed set, fold its rows into its hash, then the deep
// hash of every module over its imports'. A cycle-free graph is the driver's invariant.
export function ihFinish(): i32 {
  const n = ihStMod.length
  const byName: {[string]: i32[]} = Map()
  const shown: string[] = []
  const exposed: boolean[] = []
  const called: boolean[] = []
  const queue: i32[] = []
  let s = 0
  while s < n {
    let ty = ""
    if ihStKind[s] == IH_ST_FN || ihStKind[s] == IH_ST_LET {
      const ix = lookup(ihStMerged[s])
      ty = "?"
      if ix >= 0 { ty = tyToStr(ix) }
    }
    shown.push(ty)
    called.push(false)
    if ihStKind[s] != IH_ST_ROOT {
      const key = ihKeys[ihStMod[s]] + "\n" + ihStName[s]
      const prev = byName[key] ?? []
      prev.push(s)
      byName[key] = prev
    }
    const root = ihOn(IH_ALL_EXPOSED)
      || ihStKind[s] == IH_ST_ROOT
      || ihStExported[s]
      || (ihStKind[s] == IH_ST_LET && !ihOn(IH_NO_LET_ROOTS))
    exposed.push(root)
    if root { queue.push(s) }
    s = s + 1
  }
  ihKeep(byName, shown)
  // Exposure follows the names an exposed statement's tokens and checked type spell.
  let q = 0
  while q < queue.length {
    const x = queue[q]
    const m = ihStMod[x]
    if !ihOn(IH_NO_TOKEN_NAMES) {
      let i = ihStIdLo[x]
      while i < ihStIdHi[x] {
        ihReach(byName, m, ihIds[i], exposed, queue)
        i = i + 1
      }
    }
    if !ihOn(IH_NO_TYPE_NAMES) && shown[x] != "" {
      const ns = ihTypeNames(shown[x])
      let i = 0
      while i < ns.length {
        ihReach(byName, m, ns[i], exposed, queue)
        i = i + 1
      }
    }
    q = q + 1
  }
  // A function only a cut body calls gives its mentions: what it writes reaches its callers.
  const cq: i32[] = []
  s = 0
  while s < n {
    if exposed[s] && ihStKind[s] == IH_ST_FN {
      called[s] = true
      cq.push(s)
    }
    s = s + 1
  }
  q = 0
  while q < cq.length {
    const x = cq[q]
    if !ihOn(IH_NO_CALLEES) {
      let i = ihStCallLo[x]
      while i < ihStCallHi[x] {
        ihReach(byName, ihStMod[x], ihCalls[i], called, cq)
        i = i + 1
      }
    }
    q = q + 1
  }
  const men: i32[] = []
  let d = 0
  while d < ihOwn.length {
    ihOwn[d] = IH_SEED
    ihSpan[d] = IH_SEED
    ihExposedFns[d] = 0
    men.push(0)
    d = d + 1
  }
  s = 0
  while s < n {
    const m = ihStMod[s]
    if exposed[s] {
      ihOwn[m] = ihMixInt(ihOwn[m], ihStTok[s])
      ihSpan[m] = ihMixInt(ihSpan[m], ihStSpan[s])
      if ihStKind[s] == IH_ST_FN { ihExposedFns[m] = ihExposedFns[m] + 1 }
      const keepTy = !ihOn(IH_NO_TYPES)
        && !(ihStCutRet[s] && ihOn(IH_NO_INFERRED_TYPE))
      if shown[s] != "" && keepTy {
        ihOwn[m] = ihMixStr(ihMixStr(ihOwn[m], ihStMerged[s]), shown[s])
      }
      const guard = !ihOn(IH_NO_ELIDED_GUARD) && ihElided(shown[s])
      if ihStCutRet[s] && (guard || ihOn(IH_SHOW_INFERRED_RET)) {
        ihOwn[m] = ihMixInt(ihOwn[m], ihStBody[s])
      }
      if ihStCutAny[s] && !ihOn(IH_NO_MENTIONS) {
        men[m] = men[m] + ihMixInt(ihMixStr(IH_SEED, ihStMerged[s]), ihStMen[s])
      }
    } else if called[s] && ihStKind[s] == IH_ST_FN && !ihOn(IH_NO_MENTIONS) {
      men[m] = men[m] + ihMixInt(ihMixStr(IH_SEED, ihStMerged[s]), ihStMen[s])
    }
    s = s + 1
  }
  const done: boolean[] = []
  d = 0
  while d < ihOwn.length {
    ihOwn[d] = ihMixInt(ihOwn[d], men[d])
    done.push(false)
    ihDeepOf[d] = ihOwn[d]
    d = d + 1
  }
  if ihOn(IH_NO_DEEP) { return 0 }
  let m = 0
  while m < ihOwn.length {
    ihDeepVisit(m, done)
    m = m + 1
  }
  0
}

function ihDeepVisit(m: i32, done: boolean[]): i32 {
  if done[m] { return ihDeepOf[m] }
  done[m] = true
  let sum = 0
  let e = 0
  while e < ihEdgeFrom.length {
    if ihEdgeFrom[e] == m && ihEdgeTo[e] != m {
      sum = sum + ihMixInt(IH_SEED, ihDeepVisit(ihEdgeTo[e], done))
    }
    e = e + 1
  }
  ihDeepOf[m] = ihMixInt(ihOwn[m], sum)
  ihDeepOf[m]
}

// Keep what `ihReachOf` reads, and fold each module's token-side digests: its ambient
// statements, every statement's kind, name and tokens, and where its imports resolve.
function ihKeep(byName: {[string]: i32[]}, shown: string[]) {
  const n = ihStMod.length
  ihByName = byName
  ihShown = shown
  ihByAny = Map()
  ihExpStamp = []
  ihCalStamp = []
  ihStamp = 0
  ihSucc = []
  ihSuccMark = []
  ihSuccGen = 0
  ihExpLo = []
  ihExpHi = []
  ihCalLo = []
  ihCalHi = []
  ihExpDone = []
  ihExpMemo = []
  ihExpFresh = []
  ihAdj = []
  ihDownMemo = []
  ihImpRowsOf = []
  let d = 0
  while d < ihKeys.length {
    ihAmb[d] = IH_SEED
    ihAmbN[d] = 0
    ihDecor[d] = IH_SEED
    ihImpMap[d] = IH_SEED
    const none: i32[] = []
    ihImpRowsOf.push(none)
    d = d + 1
  }
  let s = 0
  while s < n {
    ihExpStamp.push(0)
    ihCalStamp.push(0)
    ihSuccMark.push(0)
    ihExpLo.push(-1)
    ihExpHi.push(-1)
    ihCalLo.push(-1)
    ihCalHi.push(-1)
    ihExpDone.push(false)
    ihExpMemo.push(0)
    ihExpFresh.push(false)
    const m = ihStMod[s]
    if ihStKind[s] != IH_ST_ROOT {
      const prev = ihByAny[ihStName[s]] ?? []
      prev.push(s)
      ihByAny[ihStName[s]] = prev
    }
    if s < ihStAmb.length && ihStAmb[s] && !ihOn(IH_NO_AMBIENT) {
      ihAmb[m] = ihMixInt(ihAmb[m], ihStFull[s])
      ihAmbN[m] = ihAmbN[m] + 1
    }
    if !ihOn(IH_NO_DECOR) {
      let ex = 0
      if ihStExported[s] { ex = 1 }
      const k = ihMixInt(
        ihMixStr(ihMixInt(ihDecor[m], ihStKind[s]), ihStName[s]),
        ex,
      )
      ihDecor[m] = ihMixInt(k, ihStTok[s])
    }
    s = s + 1
  }
  let r = 0
  while r < ihImpMod.length {
    const m = ihImpMod[r]
    if m >= 0 && m < ihImpMap.length {
      ihImpAt[ihKeys[m] + "\n" + ihImpLocal[r]] = r
      ihImpRowsOf[m].push(r)
      let ok = "?"
      if ihImpOMod[r] >= 0 && ihImpOMod[r] < ihKeys.length {
        ok = ihKeys[ihImpOMod[r]]
      }
      if !ihOn(IH_NO_IMPORT_MAP) {
        const row = ihMixStr(
          ihMixStr(ihMixStr(IH_SEED, ihImpLocal[r]), ok),
          ihImpOName[r],
        )
        ihImpMap[m] = ihImpMap[m] + row
      }
    }
    r = r + 1
  }
  0
}

// Whether a statement's body may write through a reference: it writes or calls a method, and
// it is handed a reference or names a top-level binding.
function ihLive(s: i32): boolean {
  if ihOn(IH_NO_LIVE) || !ihStWrites[s] { return false }
  ihStRefParam[s] || ihStCallHi[s] > ihStCallLo[s]
}

// Whether a rendered function type returns something other than a scalar.
function ihFreshRet(shown: string): boolean {
  let depth = 0
  let i = 0
  while i + 1 < shown.length {
    const c = shown[i]
    if c == '(' || c == '{' || c == '[' || c == '<' { depth = depth + 1 }
    if c == ')' || c == '}' || c == ']' { depth = depth - 1 }
    if c == '>' && (i == 0 || shown[i - 1] != '=') { depth = depth - 1 }
    if depth == 0 && c == '=' && shown[i + 1] == '>' {
      return !ihScalarSpelling(shown.slice(i + 2, shown.length))
    }
    i = i + 1
  }
  false
}

// The modules `o` reaches through its imports, itself included, kept per `o`.
function ihDownOf(o: i32): boolean[] {
  if ihAdj.length != ihKeys.length {
    ihAdj = []
    ihDownMemo = []
    let d = 0
    while d < ihKeys.length {
      const none: i32[] = []
      ihAdj.push(none)
      const no: boolean[] = []
      ihDownMemo.push(no)
      d = d + 1
    }
    let e = 0
    while e < ihEdgeFrom.length {
      const from = ihEdgeFrom[e]
      const to = ihEdgeTo[e]
      if from >= 0 && from < ihAdj.length && to >= 0 && to < ihAdj.length {
        ihAdj[from].push(to)
      }
      e = e + 1
    }
  }
  if ihDownMemo[o].length == ihKeys.length { return ihDownMemo[o] }
  const down: boolean[] = []
  let d = 0
  while d < ihKeys.length {
    down.push(false)
    d = d + 1
  }
  down[o] = true
  const queue = [o]
  let q = 0
  while q < queue.length {
    const out = ihAdj[queue[q]]
    let k = 0
    while k < out.length {
      if !down[out[k]] {
        down[out[k]] = true
        queue.push(out[k])
      }
      k = k + 1
    }
    q = q + 1
  }
  ihDownMemo[o] = down
  down
}

// Stamp statement `s` into `stamps` and `queue` once per reach.
function ihVisit(s: i32, stamps: i32[], queue: i32[]) {
  if stamps[s] != ihStamp {
    stamps[s] = ihStamp
    queue.push(s)
  }
  0
}

// Visit every statement of module `m` spelled `name`, or all of `m`'s when `name` is empty;
// the count it names.
function ihVisitName(m: i32, name: string, stamps: i32[], queue: i32[]): i32 {
  if name == "" {
    let s = 0
    let got = 0
    while s < ihStMod.length {
      if ihStMod[s] == m {
        ihVisit(s, stamps, queue)
        got = got + 1
      }
      s = s + 1
    }
    return got
  }
  const ss = ihByName[ihKeys[m] + "\n" + name] ?? []
  let i = 0
  while i < ss.length {
    ihVisit(ss[i], stamps, queue)
    i = i + 1
  }
  ss.length
}

// Add every statement of module `m` spelled `name` (all of `m`'s when empty) to the
// successor list being built, once each.
function ihSuccName(m: i32, name: string) {
  if name == "" {
    let s = 0
    while s < ihStMod.length {
      if ihStMod[s] == m { ihSuccAdd(s) }
      s = s + 1
    }
    return 0
  }
  const ss = ihByName[ihKeys[m] + "\n" + name] ?? []
  let i = 0
  while i < ss.length {
    ihSuccAdd(ss[i])
    i = i + 1
  }
  0
}

function ihSuccAdd(s: i32) {
  if ihSuccMark[s] != ihSuccGen {
    ihSuccMark[s] = ihSuccGen
    ihSucc.push(s)
  }
  0
}

// Add what the name `t` denotes in module `m`: its own statements, and the declaration an
// import binding it resolves to.
function ihSuccRef(m: i32, t: string) {
  ihSuccName(m, t)
  if ihOn(IH_NO_CROSS) { return 0 }
  const r = ihImpAt[ihKeys[m] + "\n" + t] ?? -1
  if r >= 0 {
    const om = ihImpOMod[r]
    if om >= 0 && om < ihKeys.length { ihSuccName(om, ihImpOName[r]) }
  }
  0
}

// Build statement `x`'s successor lists once: what its tokens and checked type name, and
// what its body calls. A reach filters them by the modules below its origin.
function ihSuccOf(x: i32) {
  if ihExpLo[x] >= 0 { return 0 }
  const m = ihStMod[x]
  ihSuccGen = ihSuccGen + 1
  ihExpLo[x] = ihSucc.length
  if !ihOn(IH_NO_TOKEN_NAMES) {
    let k = ihStIdLo[x]
    while k < ihStIdHi[x] {
      ihSuccName(m, ihIds[k])
      k = k + 1
    }
    if !ihOn(IH_NO_CROSS) {
      let t = ihStLo[x]
      while t < ihStHi[x] {
        if P.toks[t].kind == "IDENT" { ihSuccRef(m, P.toks[t].text) }
        t = t + 1
      }
    }
  }
  if !ihOn(IH_NO_TYPE_NAMES) && ihShown[x] != "" {
    const ns = ihTypeNames(ihShown[x])
    let k = 0
    while k < ns.length {
      const ss = ihByAny[ns[k]] ?? []
      let j = 0
      while j < ss.length {
        ihSuccAdd(ss[j])
        j = j + 1
      }
      k = k + 1
    }
  }
  ihExpHi[x] = ihSucc.length
  ihSuccGen = ihSuccGen + 1
  ihCalLo[x] = ihSucc.length
  if !ihOn(IH_NO_CALLEES) {
    let k = ihStCallLo[x]
    while k < ihStCallHi[x] {
      ihSuccRef(m, ihCalls[k])
      k = k + 1
    }
    if ihStKind[x] == IH_ST_LET {
      k = ihStIdLo[x]
      while k < ihStIdHi[x] {
        ihSuccName(m, ihIds[k])
        k = k + 1
      }
    }
  }
  ihCalHi[x] = ihSucc.length
  0
}

// The row an exposed statement gives an importer's reach, kept per statement.
function ihExpRow(x: i32): i32 {
  if ihExpDone[x] {
    if ihExpFresh[x] { ihFreshHit = true }
    return ihExpMemo[x]
  }
  const m = ihStMod[x]
  let h = ihMixStr(ihMixStr(IH_SEED, ihKeys[m]), ihStName[x])
  if ihLive(x) {
    h = ihMixInt(h, ihStFull[x])
  } else {
    h = ihMixInt(h, ihStTok[x])
  }
  const shown = ihShown[x]
  const keepTy = !ihOn(IH_NO_TYPES)
    && !(ihStCutRet[x] && ihOn(IH_NO_INFERRED_TYPE))
  if shown != "" && keepTy { h = ihMixStr(h, shown) }
  const guard = !ihOn(IH_NO_ELIDED_GUARD) && ihElided(shown)
  if ihStCutRet[x] && (guard || ihOn(IH_SHOW_INFERRED_RET)) {
    h = ihMixInt(h, ihStBody[x])
  }
  if ihStCutAny[x] && !ihOn(IH_NO_MENTIONS) { h = ihMixInt(h, ihStMen[x]) }
  const fresh = ihStCutRet[x] && !ihOn(IH_NO_FRESH) && ihFreshRet(shown)
  ihExpDone[x] = true
  ihExpMemo[x] = h
  ihExpFresh[x] = fresh
  if fresh { ihFreshHit = true }
  h
}

function ihHasArrow(s: string): boolean {
  let i = 0
  while i + 1 < s.length {
    if s[i] == '=' && s[i + 1] == '>' { return true }
    i = i + 1
  }
  false
}

// The row a statement only a body calls gives: a function's mentions, or its whole tokens
// when it may write; a function-valued binding's whole tokens.
function ihCalRow(x: i32): i32 {
  const h = ihMixStr(ihMixStr(IH_SEED, ihKeys[ihStMod[x]]), ihStName[x])
  if ihStKind[x] == IH_ST_FN {
    if ihLive(x) { return ihMixInt(h, ihStFull[x]) }
    if ihOn(IH_NO_MENTIONS) { return h }
    return ihMixInt(h, ihStMen[x])
  }
  if ihStKind[x] == IH_ST_LET && ihHasArrow(ihShown[x]) {
    return ihMixInt(h, ihStFull[x])
  }
  h
}

// What importer `i`'s check can observe of origin `o` and the modules below it: the
// statements its imports from `o` name, closed over the names their tokens and checked types
// spell, then over what their bodies call. `ihReachFresh` after it says whether it met an
// inferred return that is not a scalar.
export function ihReachOf(i: i32, o: i32): i32 {
  ihFreshHit = false
  if i < 0 || o < 0 || i >= ihKeys.length || o >= ihKeys.length { return 0 }
  if ihExpStamp.length != ihStMod.length { return 0 }
  ihStamp = ihStamp + 1
  const down = ihDownOf(o)
  const queue: i32[] = []
  let sum = 0
  const rows = ihImpRowsOf[i]
  let r = 0
  while r < rows.length {
    const row = rows[r]
    if ihImpOMod[row] == o {
      const got = ihVisitName(o, ihImpOName[row], ihExpStamp, queue)
      const h = ihMixStr(ihMixStr(IH_SEED, ihImpLocal[row]), ihImpOName[row])
      sum = sum + ihMixInt(h, got)
    }
    r = r + 1
  }
  let q = 0
  while q < queue.length {
    const x = queue[q]
    sum = sum + ihExpRow(x)
    ihSuccOf(x)
    let k = ihExpLo[x]
    while k < ihExpHi[x] {
      const s = ihSucc[k]
      if down[ihStMod[s]] { ihVisit(s, ihExpStamp, queue) }
      k = k + 1
    }
    q = q + 1
  }
  // A body the exposed statements do not show still runs at the importer's call.
  const cq: i32[] = []
  q = 0
  while q < queue.length {
    ihVisit(queue[q], ihCalStamp, cq)
    q = q + 1
  }
  q = 0
  while q < cq.length {
    const x = cq[q]
    if q >= queue.length { sum = sum + ihCalRow(x) }
    ihSuccOf(x)
    let k = ihCalLo[x]
    while k < ihCalHi[x] {
      const s = ihSucc[k]
      if down[ihStMod[s]] { ihVisit(s, ihCalStamp, cq) }
      k = k + 1
    }
    q = q + 1
  }
  sum
}

export function ihReachFresh(): boolean { ihFreshHit }

// How many of module `m`'s statements another module's check may read without importing them.
export function ihAmbientCount(m: i32): i32 {
  if m < 0 || m >= ihAmbN.length { return 0 }
  ihAmbN[m]
}

// Readers over the last armed module compile, by module table index (0 is the entry).
export function ifaceHashCount(): i32 { ihOwn.length }

export function ifaceHashKeyLen(i: i32): i32 {
  if i < 0 || i >= ihKeys.length { return 0 }
  ihKeys[i].length
}

export function ifaceHashKeyAt(i: i32, j: i32): i32 {
  if i < 0 || i >= ihKeys.length { return 0 }
  if j < 0 || j >= ihKeys[i].length { return 0 }
  ihKeys[i][j]
}

// `which` 0 the module's own hash, 1 its deep hash over its imports, 2 its declaration
// positions, 3 its count of cut bodies, 4 its count of top-level functions, 5 of exposed ones,
// 6 its ambient statements, 7 every statement's kind, name and tokens, 8 where its imports resolve.
export function ifaceHashOf(i: i32, which: i32): i32 {
  if i < 0 || i >= ihOwn.length { return 0 }
  if which == 0 { return ihOwn[i] }
  if which == 1 { return ihDeepOf[i] }
  if which == 2 { return ihSpan[i] }
  if which == 3 { return ihCut[i] }
  if which == 4 { return ihFns[i] }
  if which == 5 { return ihExposedFns[i] }
  if which == 6 { return ihAmb[i] }
  if which == 7 { return ihDecor[i] }
  if which == 8 { return ihImpMap[i] }
  0
}

// A hash of the line and column of every token in `[a, b)`, bodies included.
export function ihPosHash(a: i32, b: i32): i32 {
  let sp = IH_SEED
  let i = a
  while i < b {
    const t = P.toks[i]
    sp = ihMixInt(ihMixInt(sp, t.line), t.col)
    i = i + 1
  }
  sp
}

// The mask the current hashes are folded under, so a skipped check compares like with like.
export function ihMask(): i32 { ihDrop }

// Module `m`'s nine readings, served from a check that did not re-check it (`checkSkipArm`).
export function ihCarry(m: i32, vals: i32[]): i32 {
  if m < 0 || m >= ihOwn.length || vals.length < 9 { return 0 }
  ihOwn[m] = vals[0]
  ihDeepOf[m] = vals[1]
  ihSpan[m] = vals[2]
  ihCut[m] = vals[3]
  ihFns[m] = vals[4]
  ihExposedFns[m] = vals[5]
  ihAmb[m] = vals[6]
  ihDecor[m] = vals[7]
  ihImpMap[m] = vals[8]
  0
}
