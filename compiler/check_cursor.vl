// `check_cursor.vl` — where in the program the checker is.
// The function declaration whose body is being checked, the stack of top-level declarations
// whose constraints are being recorded, how many lambda bodies (and of those, deferred-return
// re-folds) enclose the current node, and the type parameters bound while an annotation
// resolves. The checker sets them as it enters and leaves a body; everything else only reads
// them. `cursorReset` clears them per program and `tpEnvTruncate` rolls the bindings back.

// The `FuncDecl` node whose body is being checked, innermost last — the owner stamped onto each
// recorded constraint. Only top-level registered decls are pushed (`fnDeclIx`), so a constraint
// recorded inside a nested lambda is owned by the enclosing named function, which is the decl a
// call site can name.
export let cstrOwnerStack: i32[] = []

// The function declaration whose own body is being checked, -1 at module scope; a lambda's.
export let curFnDeclIx = -1

// How many lambda bodies the checker is inside, their inference probes included (D3358).
export let lamCheckDepth = 0

// How many of the `lamCheckDepth` levels are a call re-folding a deferred return.
export let lamRefoldDepth = 0

// The type-param binding environment consulted by `nameToTy` (innermost last): a generic
// function's `<T>` names bind to their TyVars while its annotations resolve
// (`resolveAnnot`), and an alias application's params bind to the argument types while the
// alias body resolves (`applyGenAlias`).
export let tpEnvNames: string[] = []
export let tpEnvTys: i32[] = []

// `njFnIx` saved across each `monoRecheckBegin`/`monoRecheckEnd` pair.
export let njFnStack: i32[] = []

// A live type-parameter binding — a generic function's `<T>` while its annotations resolve, or a
// generic alias application's params while its body resolves — innermost wins. `tpEnvTys` only ever
// receives `mkTyVar` results and already-resolved argument types, both >= 0, so -1 unambiguously
// means "not bound".
export function tpEnvTyOfName(name: string) {
  let tpi = tpEnvNames.length - 1
  while tpi >= 0 {
    if tpEnvNames[tpi] == name { return tpEnvTys[tpi] }
    tpi = tpi - 1
  }
  -1
}

// Drops every type-parameter binding from `n` on, both columns together.
export function tpEnvTruncate(n: i32) {
  while tpEnvNames.length > n {
    tpEnvNames.pop()
    tpEnvTys.pop()
  }
  0
}

// Clears the owner stack, the current declaration and the bindings for a new program.
export function cursorReset() {
  cstrOwnerStack = []
  curFnDeclIx = -1
  tpEnvNames = []
  tpEnvTys = []
  njFnStack = []
  0
}
