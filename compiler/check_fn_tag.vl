// Decides every set from scratch over the program at `rootIx`, then raises the refusal each
// call through a set left a closure owes.
// Types each `if` or `match` at a tail of another set's join, whose members that set holds, at
// the outer join's type: the nested join is part of that choice, so it carries its set (D14425).
function ftNestedJoinsFollow() {
  let j = P.nodes.length - 1
  while j >= 0 {
    const jn = nodeAt(j)
    const jt = nodeTyIxOf(j)
    const o = if jn is IfStmt || jn is MatchExpr { fnTagSetOfTy(jt) } else { -1 }
    if o >= 0 {
      const sp: i32[] = []
      const ls: i32[] = []
      valueTailSplit(j, sp, ls)
      for n in sp {
        const s = if n != j { fnTagSetOfTy(nodeTyIxOf(n)) } else { -1 }
        if s >= 0 && s != o && fnTagMembersWithin(s, o) { nodeTySetGrow(n, jt) }
      }
    }
    j = j - 1
  }
  return 0
}

// The lambda literals every call of which is an arm's: one whose one position is a list element,
// written by a list's `push` or an index store, or a value of a written `let`, its initializer or
// an `=` store into it.
let ftArmOnlyLams: {[i32]: boolean} = Map()

// Fills `ftArmOnlyLams` by one walk from `rootIx`, the shape `ftScan` walks the program in.
function ftArmOnlyLamsNote(rootIx: i32) {
  ftArmOnlyLams = Map()
  const written: {[i32]: boolean} = Map()
  const lets: i32[] = []
  const todo: i32[] = [rootIx]
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      ftArmOnlyPushNote(x)
      ftArmOnlyIndexStoreNote(x)
      ftArmOnlyLetStoreNote(x, written)
      const n = nodeAt(x)
      if n is LetDecl && n.letKw == "let" && n.letInit >= 0 { lets.push(x) }
      nodeChildrenPush(x, todo)
    }
  }
  for d in lets {
    const n = nodeAt(d)
    if n is LetDecl && (written[d] ?? false) { ftArmOnlyLamMark(n.letInit) }
  }
  return 0
}

// Marks the lambdas call `x`, a list's `push`, appends.
function ftArmOnlyPushNote(x: i32) {
  const n = nodeAt(x)
  if !(n is Call) { return 0 }
  const fn = nodeAt(parenPeelIx(n.callFn))
  if !(fn is Member) || fn.memProp != "push" { return 0 }
  const ht = nodeTyIxOf(fn.memObj)
  if ht >= 0 && ht < T.tys.length && tyAt(ht) is TyArray {
    for a in n.callArgs { ftArmOnlyLamMark(a) }
  }
  return 0
}

// Marks the lambda store `x` writes into a list's slot.
function ftArmOnlyIndexStoreNote(x: i32) {
  const n = nodeAt(x)
  if !(n is BinExpr) || !ftIsStore(n) { return 0 }
  const l = parenPeelIx(n.binLeft)
  if l < 0 || l >= P.nodes.length { return 0 }
  const ln = nodeAt(l)
  if !(ln is Index) { return 0 }
  const ht = nodeTyIxOf(ln.idxArr)
  if ht >= 0 && ht < T.tys.length && tyAt(ht) is TyArray {
    ftArmOnlyLamMark(n.binRight)
  }
  return 0
}

// Marks the lambda store `x` writes to a `let`, and adds the `let` to `written`.
function ftArmOnlyLetStoreNote(x: i32, written: {[i32]: boolean}) {
  const n = nodeAt(x)
  if !(n is BinExpr) || !ftIsStore(n) { return 0 }
  const l = parenPeelIx(n.binLeft)
  if l < 0 || l >= P.nodes.length || !(nodeAt(l) is Ident) { return 0 }
  const d = identDeclOf(l)
  if d < 0 || d >= P.nodes.length || !(nodeAt(d) is LetDecl) { return 0 }
  written[d] = true
  ftArmOnlyLamMark(n.binRight)
  return 0
}

// Marks `v` in `ftArmOnlyLams` when it is a lambda literal.
function ftArmOnlyLamMark(v: i32) {
  const x = parenPeelIx(v)
  if x < 0 || x >= P.nodes.length { return 0 }
  const f = nodeAt(x)
  if f is FuncDecl && f.fnName == "" { ftArmOnlyLams[x] = true }
  return 0
}

export function fnTagDecide(rootIx: i32) {
  ftRetJoinFns = Map()
  ftArmOnlyLamsNote(rootIx)
  ftParamOwners = Map()
  ftParamOwnersBuilt = false
  ftDirectLen = 0
  ftDirectRefs = Map()
  ftDirectCalls = Map()
  ftHandedAt = Map()
  ftParamRefs = Map()
  ftParamCalls = Map()
  ftListedAt = Map()
  ftLitLet = Map()
  ftLetRefs = Map()
  ftLetElemCalls = Map()
  if !ftLate {
    ftCheckLen = P.nodes.length
    ftRetryRefused = []
    ftFactDecided = []
    ftLateRan = false
    ftCheckTagged = []
    ftRecsCheck = 0
  }
  ftDecideRoot = rootIx
  fnTagUndecide()
  ftNestedJoinsFollow()
  ftLeafTys = Map()
  ftShapeBuilt = false
  const calls = fnTagCalls()
  const mint = mintFactRows()
  const sbTry = if ftLate { [] } else { setBindTrySets(P.nodes.length) }
  // The arrow rule's facts read the set-binding rows `setBindTrySets` just built.
  ftCheckFacts = []
  ftCheckFactSets = Map()
  if !ftLate {
    arrowFactsBuild()
    ftCheckFacts = arrowFacts()
    for f in ftCheckFacts { ftCheckFactSets[arrowFactSetOf(f)] = true }
  }
  // The decision after the elaboration sees the deliveries the check's decision took.
  ftEscapes = if ftLate { ftEscLast } else { fnTagEscapesTake() }
  ftLateCloXs = []
  const escTys = if ftLate { ftEscTyLast } else { fnTagEscapeTysTake() }
  const escDsts = if ftLate { ftEscDstLast } else { fnTagEscapeDstsTake() }
  ftEscLast = ftEscapes.slice(0, ftEscapes.length)
  ftEscTyLast = escTys.slice(0, escTys.length)
  ftEscDstLast = escDsts.slice(0, escDsts.length)
  // Sets of two or more first: a one-member set whose member is a leaf of one of their joins
  // follows that set's decision.
  const seen: i32[] = []
  // After the elaboration, a set the check tagged keeps the check's plan, applied at the round's
  // instance calls; a set a later round tagged is decided again each round.
  if ftLate {
    while ftRecs.length > ftRecsCheck { ftRecs.pop() }
    const recs = ftRecs.slice(0, ftRecs.length)
    for r in recs {
      if r.s.length > 0 && !fnTagSetIsTagged(r.s[0]) {
        for s0 in r.s { seen.push(s0) }
        ftP = r
        ftApply(rootIx, calls, mint)
      }
    }
  } else {
    ftRecs = []
  }
  let pass = 0
  while pass < 2 {
    for c in calls {
      const s = fnTagCallSetOf(c)
      const one = fnTagMembers(s).length == 1
      if s >= 0 && one == (pass == 1) && !i32ListHas(seen, s) {
        seen.push(s)
        ftTry(rootIx, s, calls, mint)
      }
    }
    // A call an instance makes through a set its parameter is bound to calls that set too.
    for r in mint {
      const s = mintFactSetOf(r)
      const one = fnTagMembers(s).length == 1
      if s >= 0 && one == (pass == 1) && !i32ListHas(seen, s) {
        seen.push(s)
        ftTry(rootIx, s, calls, mint)
      }
    }
    // A set a read hands to a generic's function-typed parameter: each instance coerces the id
    // at its own instantiated parameter type (D16832, D16833). Check-time only.
    if !ftLate {
      let ei = 0
      while ei < escTys.length && ei < ftEscapes.length {
        const s = fnTagSetOfTy(escTys[ei])
        const one = fnTagMembers(s).length == 1
        if (
          s >= 0
          && one == (pass == 1)
          && !i32ListHas(seen, s)
          && !ftHandPartial(s)
          && ftGenFnParamHand(ftEscapes[ei])
          && ftHandFits(s, if ei < escDsts.length { escDsts[ei] } else { -1 })
        ) {
          seen.push(s)
          ftTry(rootIx, s, calls, mint)
        }
        ei = ei + 1
      }
    }
    // A set the check's own rows find a call through, where a parameter is bound to it
    // (`check_set_bind.vl`).
    for s in sbTry {
      const one = fnTagMembers(s).length == 1
      // A partial set is tried only on the arrow rule's facts, every call closed, and only where
      // no parameter it reaches belongs to a function called through a set.
      const openP = setBindSetPartial(s)
        && (arrowSetOpen(s)
        || !(ftCheckFactSets[s] ?? false)
        || ftParamOwnerCalledThroughSet(s))
      if s >= 0 && !openP && one == (pass == 1) && !i32ListHas(seen, s) {
        seen.push(s)
        ftTry(rootIx, s, calls, mint)
      }
    }
    // A set the facts of every call row reaching it close, all agreeing (STORE B2a).
    if !ftLate {
      for f in ftCheckFacts {
        const s = arrowFactSetOf(f)
        const one = fnTagMembers(s).length == 1
        // A set reaching a stored parameter (S, B2b's), handed by a set's members (V) or
        // delivered as a closure (C) is left as before.
        const cls = setBindTryClass(s)
        const kept = cls.indexOf("S") >= 0
          || cls.indexOf("V") >= 0
          || cls.indexOf("C") >= 0
          || cls.indexOf("G") >= 0 && !arrowSetOneShape(s)
          || ftParamOwnerCalledThroughSet(s)
        if (
          s >= 0
          && one == (pass == 1)
          && !kept
          && !arrowSetOpen(s)
          && !arrowSetRowOpen(s)
          && !i32ListHas(seen, s)
        ) {
          seen.push(s)
          ftTry(rootIx, s, calls, mint)
        }
      }
    }
    // After the elaboration, a set every instance binds a parameter to, which a copy of it may
    // store (D15432).
    if ftLate && pass == 1 {
      for s in mintParamHeldSets() {
        if !i32ListHas(seen, s) {
          seen.push(s)
          ftTry(rootIx, s, calls, mint)
        }
      }
      // And a set an instance calls through a field of a record its callers forward a hole into.
      for s in mintFwdFieldSetsOf() {
        if !i32ListHas(seen, s) {
          seen.push(s)
          ftTry(rootIx, s, calls, mint)
        }
      }
    }
    // After the elaboration, a set an instance delivers to a closed function type, called or not.
    if ftLate && pass == 1 {
      let r = 0
      while r < mintCloRows() {
        const s = mintCloSetOf(r)
        r = r + 1
        if s >= 0 && !i32ListHas(seen, s) {
          seen.push(s)
          ftTry(rootIx, s, calls, mint)
        }
      }
    }
    pass = pass + 1
  }
  // A set of declared functions is called through where a function taking or returning its value
  // is delivered; a value of the set delivered to a closed function type is the closure built
  // there, unless the set has one member, or a generic or un-annotated one, and so needs a dispatch.
  let xi = 0
  while xi < escTys.length {
    const et = escTys[xi]
    const own = fnTagSetOfTy(et) >= 0
    // An element or field read holds no binding a veto could re-type.
    const sx = if xi < ftEscapes.length { nodeAt(parenPeelIx(ftEscapes[xi])) } else { nodeAt(0) }
    const slotRead = sx is Index || sx is Member
    // A widened `let` read could be vetoed, so its tag also needs every member's result to fit.
    const sd = if sx is Ident && xi < ftEscapes.length { identDeclOf(parenPeelIx(ftEscapes[xi])) } else { -1 }
    const sdn = if sd >= 0 && sd < P.nodes.length { nodeAt(sd) } else { nodeAt(0) }
    const letRead = sdn is LetDecl && sdn.letKw == "let"
    const edt = if xi < escDsts.length { escDsts[xi] } else { -1 }
    const dstPts: i32[] = []
    let dstRet = -1
    if edt >= 0 && edt < T.tys.length {
      const edf = tyAt(edt)
      if edf is TyFunc {
        for dp in edf.fnParamTypes { dstPts.push(dp) }
        dstRet = edf.fnRet
      }
    }
    xi = xi + 1
    for s in ftEscSets(et) {
      // A value of generic members has no one closure signature, so its delivery dispatches too;
      // nor has an element or field of un-annotated members whose results differ at the
      // destination's parameters (D16093), nor such a `let` whose results fit its result (D16098).
      let gen = false
      for m in fnTagMembers(s) {
        if ftNamedDecl(m) && !ftPlainDecl(m) { gen = true }
      }
      let plain = !own
        || fnTagMembers(s).length == 1
        || gen
        || slotRead && ftWideEscOk(s) && holeSetSplitsAt(s, dstPts)
        || letRead
        && ftWideEscOk(s)
        && holeSetSplitsAt(s, dstPts)
        && holeSetFitsRetAt(s, dstPts, dstRet)
      for m in fnTagMembers(s) {
        if !ftNamedDecl(m) && !ftHoleLambdaAlone(s, m) { plain = false }
      }
      if plain && !i32ListHas(seen, s) {
        seen.push(s)
        ftTry(rootIx, s, calls, mint)
      }
    }
  }
  // A written binding of generic members delivered through an adapter the last check built is
  // the id that adapter dispatches on, so its set is decided again.
  for s in fnTagEtaBuiltSets() {
    if ftWideEscOk(s) && !i32ListHas(seen, s) {
      seen.push(s)
      ftTry(rootIx, s, calls, mint)
    }
  }
  // A delivery of a tagged set, or to a function type taking or returning one, is built by the
  // next check.
  let ei = 0
  while ei < ftEscapes.length && ei < escTys.length {
    const et = escTys[ei]
    if fnTagSetIsTagged(fnTagSetOfTy(et)) || ftSigTagged(et) {
      fnTagEtaWant(ftEscapes[ei], fnTagSetOfTy(et))
    }
    // After the elaboration no check builds that adapter, so a one-member set delivered to a
    // closed function type is recorded for the emitter, which builds its member's closure there.
    // Only in the generic pass, and only at a closed type: the record is per node, not per pin.
    const s1 = fnTagSetOfTy(et)
    const dt = if ei < escDsts.length { escDsts[ei] } else { -1 }
    if (
      ftLate
      && fnTagSetIsTagged(s1)
      && (ftLateCloAt(s1, dt, -1) || i32ListHas(ftLateCloXs, ftEscapes[ei]))
    ) {
      fnCloCoerceNote(ftEscapes[ei], dt)
    }
    ei = ei + 1
  }
  // Each such delivery of a set now tagged is its one member's closure at the closed type.
  if ftLate {
    let r = 0
    while r < mintCloRows() {
      const s = mintCloSetOf(r)
      if s >= 0 && fnTagSetIsTagged(s) {
        fnCloCoerceSetNote(mintCloAtOf(r), mintCloTyOf(r), s)
      }
      r = r + 1
    }
  }
  ftEscapes = []
  for c in calls {
    const msg = fnTagCallMsgOf(c)
    if msg != "" && !fnTagSetIsTagged(fnTagCallSetOf(c)) {
      tErr(msg, fnTagCallMsgAtOf(c))
    }
  }
  return 0
}

// The deliveries and their types the last decision saw.
let ftEscLast: i32[] = []
let ftEscTyLast: i32[] = []
let ftEscDstLast: i32[] = []

// Whether the decision is the one after the elaboration, and the sets the check's had tagged.
let ftLate = false
let ftWas: i32[] = []

// Decides again once the elaboration has noted each instance's calls through a set (`elabMintFacts`),
// the check's sets kept: 0 when it tags no more sets, 1 when it tags more, 10 more when it tags a
// set the check refused with every call's facts (a second decider), 20 when an instance call
// through a tagged set lacks an arm, 40 when one meets a key the check's facts lacked.
export function fnTagRedecide(rootIx: i32): i32 {
  ftWas = fnTagTaggedSets()
  if !ftLateRan {
    ftCheckTagged = ftWas
    ftRecsCheck = ftRecs.length
    ftLateRan = true
  }
  ftLate = true
  const d0 = T.diags.length
  fnTagDecide(rootIx)
  ftLate = false
  while T.diags.length > d0 { T.diags.pop() }
  const now = fnTagTaggedSets()
  if !ftFactsCoverInstances(mintFactRows()) { return 40 }
  if !ftArmsCovered(mintFactRows()) { return 20 }
  const second = if ftLateOutsideExclusions() >= 0 { 10 } else { 0 }
  return second + (if now.length > ftWas.length { 1 } else { 0 })
}

// The sets the check decided from the arrow rule's facts.
let ftFactDecided: i32[] = []

// Whether each instance call through a set the check decided from the arrow facts meets the fact
// the check read for its source call, at the same member results: else the check lacked its key.
function ftFactsCoverInstances(mint: i32[]): boolean {
  for r in mint {
    const s = mintFactSetOf(r)
    if s >= 0 && i32ListHas(ftFactDecided, s) {
      const f = arrowFactAt(mintFactCallOf(r), s)
      if f < 0 || !i32ListEq(arrowFactRsOf(f), mintFactRsOf(r)) { return false }
    }
  }
  return true
}

// Whether each instance call through a tagged set has an arm per member (`ftBuildArmsAt`).
function ftArmsCovered(mint: i32[]): boolean {
  for fr in mint {
    const s = ftFactSetOf(fr)
    const c = ftFactCallOf(fr)
    if (
      s >= 0
      && fnTagSetIsTagged(s)
      && c >= 0
      && c < P.nodes.length
      && nodeAt(c) is Call
      && fnTagArmsAt(c, s).length != fnTagMembers(s).length
    ) {
      return false
    }
  }
  return true
}

// The sets the check tagged, as the first decision after the elaboration found them.
let ftCheckTagged: i32[] = []
let ftLateRan = false

// One row per set the decisions after the elaboration tagged beyond the check's:
// `tag <class> <members>`, the class `setBindTryClass`'s.
export function fnTagLateRows(): string[] {
  const out: string[] = []
  if !ftLateRan { return out }
  const now = fnTagTaggedSets()
  for s in now {
    if !i32ListHas(ftCheckTagged, s) { out.push("tag " + ftLateRowOf(s)) }
  }
  return out
}

function ftLateRowOf(s: i32): string {
  let names = ""
  for m in fnTagMembers(s) {
    const mn = nodeAt(m)
    const nm = if mn is FuncDecl && !fnNameIsLambda(mn.fnName) { mn.fnName } else { "<lambda>" }
    names = if names == "" { nm } else { names + "," + nm }
  }
  return setBindTryClass(s) + " {" + names + "}"
}

// Whether a declaration a parameter of which takes set `s` is itself a member of a set some call
// goes through: the rows do not follow those calls, so other values may reach that parameter.
function ftParamOwnerCalledThroughSet(s: i32): boolean {
  const ds = setBindParamDeclsOf(s)
  if ds.length == 0 { return false }
  for c in fnTagCalls() {
    const cs = fnTagCallSetOf(c)
    if cs >= 0 {
      for m in fnTagMembers(cs) {
        if i32ListHas(ds, m) { return true }
      }
    }
  }
  return false
}

// Whether, after the elaboration, record literal `v` is written into a binding an instance holds
// set `s` in (`mintStoreNote`), or a set the plan decides `s` with, so its function fields are
// leaves of that set (D16137).
function ftStoredAt(v: i32, s: i32): boolean {
  if !ftLate { return false }
  const st = mintStoreSetOf(parenPeelIx(v))
  return st == s
    || st >= 0 && i32ListHas(ftAssume, st) && fnTagMembersWithin(s, st)
}

// Tags set `s` when every node carrying it is a place an id can stand, and builds each call's
// member calls. A read of a smaller set stored where `s` is held is decided with it: both are
// tagged or neither, since the store hands the smaller set's id on as one of `s`.
function ftTry(rootIx: i32, s: i32, calls: i32[], mint: i32[]) {
  ftTryWith(rootIx, s, calls, mint)
  // Before the elaboration, a set its own reading leaves undecided is asked again with the
  // arrow rule's facts, which stand for the instances' calls the elaboration has not yet made.
  const handed = i32ListHas(setBindHandedSets(), s)
  if (
    !ftLate
    && !fnTagSetIsTagged(s)
    && ((ftCheckFactSets[s] ?? false) || handed)
  ) {
    ftUseArrow = true
    ftFactRefused = false
    ftTryWith(rootIx, s, calls, ftCheckFacts)
    ftUseArrow = false
    if fnTagSetIsTagged(s) {
      for x in ftP.s { ftFactDecided.push(x) }
    }
    // Refused by the facts themselves, with every call's in hand: the late decision must leave it
    // too, or the two deciders disagree about the same set.
    if (
      ftFactRefused
      && !fnTagSetIsTagged(s)
      && !arrowSetOpen(s)
      && !arrowSetSplit(s)
      && !i32ListHas(ftRetryRefused, s)
    ) {
      ftRetryRefused.push(s)
    }
  }
  return 0
}

// `ftTry` reading facts `mint`.
function ftTryWith(rootIx: i32, s: i32, calls: i32[], mint: i32[]) {
  if fnTagSetIsTagged(s) { return 0 }
  ftP = ftRecNew()
  ftSubNeed = []
  ftAssume = [s]
  let ok = ftPlan(rootIx, s, calls, mint)
  let q = 0
  while ok && q < ftSubNeed.length {
    const o = ftSubNeed[q]
    if !i32ListHas(ftAssume, o) && !fnTagSetIsTagged(o) {
      ftAssume.push(o)
      ok = ftPlan(rootIx, o, calls, mint)
    }
    q = q + 1
  }
  ftAssume = []
  if !ok || !ftPlLeafTysFill() { return 0 }
  ftRecs.push(ftP)
  ftApply(rootIx, calls, mint)
  return 0
}

// A plan in progress, then one that tagged its sets, kept so the decision after the elaboration
// applies the check's plans at the round's instance calls instead of planning their sets again.
type FtRec = {
  // One planned set per row: its leaves and their ids, each member's leaf type, the joins
  // re-typed to it, the `let`s it is held by, and the list literals and `let`s it is held by.
  s: i32[],
  leaves: i32[][],
  ids: i32[][],
  leafTy: i32[][],
  resp: i32[][],
  respTy: i32[][],
  binds: i32[][],
  held: i32[][],
  // The deliveries built as the closure of the set's one member, and their types.
  cloAt: i32[],
  cloTy: i32[],
  // The record literals written into a map of the set's records, the map read, and its function.
  mapLit: i32[],
  mapMap: i32[],
  mapFn: i32[],
  // The record literals written into a holder of the set (`ftStoredAt`), and the holder's type.
  storeLits: i32[],
  storeTys: i32[],
  // List literals written whole into a held list of lists, each beside the holder's declaration.
  whole: i32[],
  // Record literals holding a list of lists written whole over a held binding, each beside that
  // binding's declaration (D16920).
  fieldWhole: i32[],
  // The record literals held through a field naming a function.
  named: i32[],
  // The record literals written into a holder's slot or pushed onto one.
  written: i32[],
  // Each `let` initialiser a record written whole over its binding is built beside, then that
  // written literal: the initialiser is built at the written record's type too (D15391).
  inits: i32[],
}

function ftRecNew(): FtRec {
  return {
    s: [],
    leaves: [],
    ids: [],
    leafTy: [],
    resp: [],
    respTy: [],
    binds: [],
    held: [],
    cloAt: [],
    cloTy: [],
    mapLit: [],
    mapMap: [],
    mapFn: [],
    storeLits: [],
    storeTys: [],
    whole: [],
    fieldWhole: [],
    named: [],
    written: [],
    inits: [],
  }
}

let ftP: FtRec = ftRecNew()
let ftRecs: FtRec[] = []
// How many of `ftRecs` the check's decision made.
let ftRecsCheck = 0

// Tags the planned sets, builds their arms at `calls` and the instance calls of `mint`, and
// stamps every holder and literal the plan wrote.
function ftApply(rootIx: i32, calls: i32[], mint: i32[]) {
  let k = 0
  while k < ftP.s.length {
    ftCommit(rootIx, k, calls, mint)
    k = k + 1
  }
  let ci = 0
  while ci < ftP.cloAt.length {
    fnCloCoerceNote(ftP.cloAt[ci], ftP.cloTy[ci])
    ci = ci + 1
  }
  // Every holder's rep, once each planned set is tagged.
  // Twice, so a binding of a read of another holder sees that holder's stamp (D15350).
  for _pass in [0, 1] {
    for hs in ftP.held {
      for h in hs { fnTagHeldNote(h) }
    }
  }
  // A record literal `set` into a held map nesting the set's records is built at the map's storage
  // row, its nested records too (D16829).
  for hs in ftP.held {
    for h in hs { ftStampMapSetLits(h) }
  }
  // A record literal written into a map of the set's records is built at the map's record rep.
  let mr = 0
  while mr < ftP.mapLit.length {
    const rr = ftMapRecRep(ftP.mapMap[mr], ftP.mapFn[mr])
    if rr >= 0 { repStampHeldRead(ftP.mapLit[mr], rr) }
    mr = mr + 1
  }
  // A record literal an instance writes into a holder of the set is built at the holder's rep.
  let sl = 0
  while sl < ftP.storeLits.length {
    repStampHeldRead(ftP.storeLits[sl], fnTagRepTyOf(ftP.storeTys[sl]))
    sl = sl + 1
  }
  // A list literal written whole into a held list of lists is built at the holder's element.
  let ww = 0
  while ww + 1 < ftP.whole.length {
    const hr = fnTagHeldRepOf(ftP.whole[ww + 1])
    const ho = if hr >= 0 && hr < T.tys.length { tyAt(hr) } else { null }
    if ho is TyArray { fnTagHeldWrittenInner(ftP.whole[ww], tyElemOf(ho), 0) }
    ww = ww + 2
  }
  // A record literal of an inner list is built at that list's record, so it shares its row.
  let q2 = 0
  while q2 + 1 < fnTagHeldRecs.length {
    repStampHeldRead(fnTagHeldRecs[q2], fnTagHeldRecs[q2 + 1])
    q2 = q2 + 2
  }
  while fnTagHeldRecs.length > 0 { fnTagHeldRecs.pop() }
  for l in ftP.named { repStampHeldRead(l, fnTagRepTyOf(nodeTyIxOf(l))) }
  // A record literal written into a holder is built at the record its stamped rep holds there.
  for l in ftP.written {
    const t = recAsgFnWidenedTy(l)
    if t >= 0 { recLitFnFieldsRestamp(l, t) }
  }
  let wi = 0
  while wi + 1 < ftP.inits.length {
    const t = recAsgFnWidenedTy(ftP.inits[wi + 1])
    if t >= 0 { recLitFnFieldsRestamp(ftP.inits[wi], t) }
    wi = wi + 2
  }
  // A record holding a list of lists written whole over a held binding is built at the binding's
  // rep, its lists at that rep's fields, as its initialiser is (D16821, D16920).
  let fw = 0
  while fw + 1 < ftP.fieldWhole.length {
    const hr = fnTagHeldRepOf(ftP.fieldWhole[fw + 1])
    if hr >= 0 { ftRecListsAtRep(ftP.fieldWhole[fw], hr) }
    fw = fw + 2
  }
  return 0
}

// Builds record literal `l` at record rep `hr`, and each list-of-lists literal in its fields at
// that field of `hr`.
function ftRecListsAtRep(l: i32, hr: i32) {
  const ln = nodeAt(l)
  if !(ln is ObjLit) { return 0 }
  repStampHeldRead(l, hr)
  for f in ln.objFields {
    const fn = nodeAt(f)
    const v = if fn is FieldInit { parenPeelIx(fn.fiValue) } else { -1 }
    if fn is FieldInit && v >= 0 && ftWholeListOfLists(v) {
      const ft = tyFieldTyOf(hr, fn.fiName)
      if ft >= 0 { fnTagHeldWrittenInner(v, ft, 0) }
    }
  }
  return 0
}

// Notes the record literal initialising `x`'s `let`, beside `wl` written whole over it.
function ftWrittenInitNote(x: i32, wl: i32) {
  const d = if nodeAt(x) is Ident { identDeclOf(x) } else { -1 }
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if !(dn is LetDecl) || dn.letType >= 0 || dn.letInit < 0 { return 0 }
  const il = parenPeelIx(dn.letInit)
  if il < 0 || il >= P.nodes.length || !(nodeAt(il) is ObjLit) || il == wl {
    return 0
  }
  if !i32ListHas(ftP.inits, il) {
    ftP.inits.push(il)
    ftP.inits.push(wl)
  }
  return 0
}

// Whether `x` is a list literal of record literals, or of such lists, written whole (D15357).
function ftWholeRecListLit(x: i32): boolean {
  const n = if x >= 0 && x < P.nodes.length { nodeAt(x) } else { null }
  if !(n is ArrayLit) || n.arrElems.length == 0 { return false }
  for el in n.arrElems {
    const ex = parenPeelIx(el)
    const en = if ex >= 0 && ex < P.nodes.length { nodeAt(ex) } else { null }
    if !(en is ObjLit) && !ftWholeRecListLit(ex) { return false }
  }
  return true
}

// Notes list literal `l` as written whole into holder `h`, a read of a held `let`.
function ftWrittenWholeNote(l: i32, h: i32) {
  const d = if h >= 0 && h < P.nodes.length && nodeAt(h) is Ident { identDeclOf(h) } else { -1 }
  if d >= 0 && !i32ListHas(ftP.whole, l) {
    ftP.whole.push(l)
    ftP.whole.push(d)
  }
  return 0
}

// Notes record literal `l`, written whole over the binding `x` reads, when a field holds a list
// of lists: it is built at the binding's rep.
function ftWrittenFieldListsNote(l: i32, x: i32) {
  const ln = if l >= 0 && l < P.nodes.length { nodeAt(l) } else { null }
  const d = if x >= 0 && x < P.nodes.length && nodeAt(x) is Ident { identDeclOf(x) } else { -1 }
  if !(ln is ObjLit) || d < 0 { return 0 }
  for f in ln.objFields {
    const fn = nodeAt(f)
    const v = if fn is FieldInit { parenPeelIx(fn.fiValue) } else { -1 }
    if (
      fn is FieldInit
      && v >= 0
      && ftWholeListOfLists(v)
      && !i32ListHas(ftP.fieldWhole, l)
    ) {
      ftP.fieldWhole.push(l)
      ftP.fieldWhole.push(d)
      return 0
    }
  }
  return 0
}

// Whether list literal `v` holds only list literals.
function ftWholeListOfLists(v: i32): boolean {
  const n = nodeAt(v)
  if !(n is ArrayLit) || n.arrElems.length == 0 { return false }
  for el in n.arrElems {
    if !(nodeAt(parenPeelIx(el)) is ArrayLit) { return false }
  }
  return true
}

// Notes record literal `l` as written into a holder of the plan in progress.
function ftWrittenNote(l: i32) {
  if recAsgFnWidenedTy(l) >= 0 && !i32ListHas(ftP.written, l) {
    ftP.written.push(l)
  }
  return 0
}

// The sets the decision in progress takes as tagged, and the smaller sets its stores read.
let ftAssume: i32[] = []
let ftSubNeed: i32[] = []

// The `let` declarations, and the list literals and `let`s, the scan in progress found holding
// its set.
let ftBindsCur: i32[] = []
let ftHeldCur: i32[] = []

// Gives each planned member with no leaf of its own the type of its leaf in another row; false
// when some member has none in any row.
function ftPlLeafTysFill(): boolean {
  let k = 0
  while k < ftP.s.length {
    const ds = fnTagMembers(ftP.s[k])
    const lt = ftP.leafTy[k]
    let i = 0
    while i < lt.length && i < ds.length {
      if lt[i] < 0 {
        let t = -1
        let j = 0
        while j < ftP.s.length && t < 0 {
          const ls = ftP.leaves[j]
          const lids = ftP.ids[j]
          let m = 0
          while m < ls.length && m < lids.length && t < 0 {
            if lids[m] == ds[i] { t = nodeTyIxOf(ls[m]) }
            m = m + 1
          }
          j = j + 1
        }
        // Else the type a set this decision already tagged gives the member (D15625).
        if t < 0 { t = ftTaggedLeafTy(ds[i]) }
        if t < 0 { return false }
        lt[i] = t
      }
      i = i + 1
    }
    k = k + 1
  }
  return true
}

// The leaf type of member `d` in some tagged set, or -1.
function ftTaggedLeafTy(d: i32): i32 {
  for o in ftLeafTys.keys() {
    const ms = fnTagMembers(o)
    const lt = ftLeafTys[o] ?? []
    let i = 0
    while i < ms.length && i < lt.length {
      if ms[i] == d && lt[i] >= 0 && fnTagSetIsTagged(o) { return lt[i] }
      i = i + 1
    }
  }
  return -1
}

// Tags the set planned in row `k` and builds each call's member calls.
function ftCommit(rootIx: i32, k: i32, calls: i32[], mint: i32[]) {
  if k < 0 || k >= ftP.s.length { return 0 }
  const s = ftP.s[k]
  const ds = fnTagMembers(s)
  const leafTy = ftP.leafTy[k]
  fnTagMark(s, ftP.leaves[k], ftP.ids[k])
  for b in ftP.binds[k] { fnTagBindNote(b, s) }
  ftLeafTys[s] = leafTy
  const rs = ftP.resp[k]
  const rt = ftP.respTy[k]
  let ri = 0
  while ri < rs.length && ri < rt.length {
    nodeTySetGrow(rs[ri], rt[ri])
    ri = ri + 1
  }
  const r = nodeAt(rootIx)
  if r is Program {
    for d in r.progStmts {
      if nodeAt(d) is FuncDecl && ftRetCarries(d, s) { fnTagRetMark(d) }
    }
  }
  for c in calls {
    if fnTagCallSetOf(c) == s { ftBuildArms(c, s, ds, leafTy) }
  }
  for fr in mint {
    if ftFactSetOf(fr) == s {
      ftBuildArmsAt(ftFactCallOf(fr), s, ds, leafTy, ftFactRsOf(fr))
    }
  }
  return 0
}

// Whether member `d`'s name is in scope at every call its set `s` builds arms at: a lambda or a
// function its name resolves to everywhere is, another nested one only where its parent's body
// holds both.
function ftMemberSeenAtArms(
  d: i32,
  s: i32,
  calls: i32[],
  mint: i32[],
): boolean {
  const dn = nodeAt(d)
  if !(dn is FuncDecl) || dn.fnName == "" || (fnDeclIx[dn.fnName] ?? -1) == d {
    return true
  }
  const pf = fnDeclParent[d] ?? -1
  if pf == -1 { return true }
  const pn = if pf >= 0 && pf < P.nodes.length { nodeAt(pf) } else { null }
  if !(pn is FuncDecl) || pn.fnBody < 0 || pn.fnBody >= P.nodes.length {
    return false
  }
  const b = nodeAt(pn.fnBody)
  if !(b is Block) || !i32ListHas(b.blkStmts, d) { return false }
  const sites: i32[] = []
  for c in calls {
    if fnTagCallSetOf(c) == s { sites.push(c) }
  }
  for r in mint {
    if ftFactSetOf(r) == s { sites.push(ftFactCallOf(r)) }
  }
  const under: Map<i32, boolean> = Map()
  const todo: i32[] = [pn.fnBody]
  while todo.length > 0 {
    const y = todo.pop() ?? -1
    if y >= 0 && y < P.nodes.length && !(under[y] ?? false) {
      under[y] = true
      nodeChildrenPush(y, todo)
    }
  }
  for c in sites {
    if !(under[c] ?? false) { return ftNestedCaptureFree(d) }
  }
  return true
}

// Whether nested function `d` reads no binding of a function enclosing it, so an arm built where
// its name is out of scope can call it by its declaration.
function ftNestedCaptureFree(d: i32): boolean {
  const own = ftSubtree(d)
  let a = fnDeclParent[d] ?? -1
  while a >= 0 {
    const enc = ftSubtree(a)
    const todo: i32[] = [d]
    while todo.length > 0 {
      const y = todo.pop() ?? -1
      if y >= 0 && y < P.nodes.length {
        const yn = nodeAt(y)
        if yn is Ident {
          const k = identDeclOf(y)
          if k >= 0 && !(own[k] ?? false) && (enc[k] ?? false) { return false }
        }
        nodeChildrenPush(y, todo)
      }
    }
    a = fnDeclParent[a] ?? -1
  }
  return a != -2
}

// The nodes under node `r`, `r` included.
function ftSubtree(r: i32): Map<i32, boolean> {
  const under: Map<i32, boolean> = Map()
  const todo: i32[] = [r]
  while todo.length > 0 {
    const y = todo.pop() ?? -1
    if y >= 0 && y < P.nodes.length && !(under[y] ?? false) {
      under[y] = true
      nodeChildrenPush(y, todo)
    }
  }
  return under
}

// The values written to seeded binding `b`, or for a record literal's binding, to each of its
// fields (D15455).
function ftSeedBindValues(b: i32): i32[] {
  const bn = if b >= 0 && b < P.nodes.length { nodeAt(b) } else { null }
  const li = if bn is LetDecl { parenPeelIx(bn.letInit) } else { -1 }
  const ol = if li >= 0 && li < P.nodes.length { nodeAt(li) } else { null }
  if !(ol is ObjLit) { return cwBindingWrittenValues(b) }
  const out: i32[] = []
  for fi in ol.objFields {
    const f = nodeAt(fi)
    const vals: i32[] = []
    const ats: i32[] = []
    if (
      f is FieldInit
      && cwSlotWrittenValues(cwKeyOfDecl(b), [f.fiName], vals, ats) >= 0
    ) {
      for v in vals { out.push(v) }
    }
  }
  return out
}

// Whether set `s` may be tagged, planning it in a new row when so.
function ftPlan(rootIx: i32, s: i32, calls: i32[], mint: i32[]): boolean {
  const ds = fnTagMembers(s)
  // A member the elaboration closed at its delivery is built as a closure, so no id stands for it.
  if ftLate {
    for d in ds {
      if mintLamClosed(d) { return false }
    }
  }
  const leaves: i32[] = []
  const ids: i32[] = []
  ftRespine = []
  ftRespineTy = []
  ftWideSeen = false
  ftBindsCur = []
  ftHeldCur = []
  // Before the elaboration, a set some call reaches at open argument types, or at results that
  // differ by caller, has no fact to build that call's arms from.
  if ftUseArrow && (arrowSetOpen(s) || arrowSetSplit(s)) { return false }
  if !ftScan(rootIx, s, ds, leaves, ids) { return false }
  // A function a member's tail returns into `s` returns each member it names as `s`'s id, though
  // nothing calls it (D15457).
  for rf in ftRetJoinFns[s] ?? [] {
    const fd = nodeAt(rf)
    const rv: i32[] = []
    if fd is FuncDecl && fd.fnBody >= 0 { collectRetValues(fd.fnBody, rv) }
    for v in rv {
      const vx = parenPeelIx(v)
      const vd = if vx >= 0 && vx < P.nodes.length && nodeAt(vx) is Ident { identDeclOf(vx) } else { -1 }
      if vd >= 0 && i32ListHas(ds, vd) && !i32ListHas(leaves, vx) {
        leaves.push(vx)
        ids.push(vd)
      }
    }
  }
  // A written `let` a parameter initialises holds `s` only in an instance, so the members written
  // to it are the set's leaves, and the parameter's own set is decided with it.
  for b in if ftLate { mintSeedBindsOf(s) } else { arrowSeedBindsOf(s) } {
    cwIxWant()
    for v in ftSeedBindValues(b) {
      const vx = parenPeelIx(v)
      const vn = if vx >= 0 && vx < P.nodes.length { nodeAt(vx) } else { null }
      const vd = if vn is Ident { identDeclOf(vx) } else { -1 }
      if vd >= 0 && i32ListHas(ds, vd) && !i32ListHas(leaves, vx) {
        leaves.push(vx)
        ids.push(vd)
      }
      // A parameter written to it hands the member each call names there: that argument node
      // delivers the member's id, a closed function's too, which carries no set of its own (D15456).
      const pn = if vd >= 0 && vd < P.nodes.length { nodeAt(vd) } else { null }
      if pn is Param {
        const fd = recEnclosingFn(vd)
        const fn = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { null }
        const pi = if fn is FuncDecl { i32ListIndexOf(fn.fnParams, vd) } else { -1 }
        if pi >= 0 {
          for ax in fnParamHandArgsOf(fd, pi) {
            const ad = if ax >= 0 && ax < P.nodes.length && nodeAt(ax) is Ident { identFnDeclOf(ax) } else { -1 }
            if ad >= 0 && i32ListHas(ds, ad) && !i32ListHas(leaves, ax) {
              leaves.push(ax)
              ids.push(ad)
            }
          }
        }
      }
    }
  }
  // A written parameter bound at the join of its hands and its writes holds each, so every
  // function a call hands it or its body writes to it is a leaf (D15011).
  for pd in fnTagParamWriteJoinsOf(s) {
    const fd = recEnclosingFn(pd)
    const fn = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { null }
    const pi = if fn is FuncDecl { i32ListIndexOf(fn.fnParams, pd) } else { -1 }
    const vs: i32[] = []
    if pi >= 0 {
      for a in fnParamHandArgsOf(fd, pi) { vs.push(a) }
    }
    for w in cwDeclWriteValues(pd) { vs.push(w) }
    for v in vs {
      const vx = parenPeelIx(v)
      const ad = if vx >= 0 && vx < P.nodes.length && nodeAt(vx) is Ident { identFnDeclOf(vx) } else { -1 }
      if ad >= 0 && i32ListHas(ds, ad) && !i32ListHas(leaves, vx) {
        leaves.push(vx)
        ids.push(ad)
      }
    }
  }
  for o in if ftLate { mintSeedHeldOf(s) } else { arrowSeedHeldOf(s) } {
    if o != s && fnTagMembersWithin(o, s) && !i32ListHas(ftSubNeed, o) {
      ftSubNeed.push(o)
    }
  }
  // A union a shared type parameter is bound to holds each argument's id, so the arguments'
  // sets are decided with it.
  for o in fnTagJoinFromOf(s) {
    if fnTagMembersWithin(o, s) && !i32ListHas(ftSubNeed, o) {
      ftSubNeed.push(o)
    }
  }
  // A list or record widened to `s` from a copy of a smaller set's holds that set's ids, so the
  // two are decided together.
  for o in fnWidenedSourceSets(s) {
    if fnTagMembersWithin(o, s) && !i32ListHas(ftSubNeed, o) {
      ftSubNeed.push(o)
    }
  }
  // A parameter whose calls go through `s` holds what each parameter handed on to it is handed, so
  // the smaller sets those hands carry are decided with it (D15610).
  if ftLate || ftUseArrow {
    for r in mint {
      if ftFactSetOf(r) == s { ftFwdInSubsets(ftFactCallOf(r), s, leaves, ids) }
    }
  }
  // A member call names the member as its leaves do, so each member needs one.
  const leafTy: i32[] = []
  for d in ds {
    let t = -1
    let k = 0
    while k < leaves.length && t < 0 {
      if ids[k] == d { t = nodeTyIxOf(leaves[k]) }
      k = k + 1
    }
    // A member written into a container of the set, through a callee's parameter included, has
    // each write as a leaf too, however else it is read (D14648, D15531), typed as the container's
    // slot.
    const wvs: i32[] = []
    const wsets: i32[] = []
    const et = fnTagWriteLeavesOf(d, s, ftHeldCur, wvs, wsets)
    // The write's own value is the leaf's id too, so the set it carries is decided with `s`.
    for o in wsets {
      if fnTagMembersWithin(o, s) && !i32ListHas(ftSubNeed, o) {
        ftSubNeed.push(o)
      }
    }
    if et >= 0 {
      for wv in wvs {
        if !i32ListHas(leaves, wv) {
          leaves.push(wv)
          ids.push(d)
        }
      }
      if t < 0 { t = et }
    }
    // A member only a smaller set's read brings has its leaf in that set's plan.
    if t < 0 && ftSubNeed.length == 0 { return false }
    leafTy.push(t)
  }
  for d in ds {
    if !ftMemberSeenAtArms(d, s, calls, mint) { return false }
  }
  // One member's call evaluates its arguments once, so after the elaboration a singleton's
  // arguments may allocate.
  const once = ftLate && ds.length == 1
  // A written `let`'s type makes its members agree on each parameter, so a record literal
  // handed through it is built at one row whichever member runs.
  for c in calls {
    if (
      fnTagCallSetOf(c) == s
      && !ftPlainArgsIn(c, once || ftLitArgsAgree(c, s), ftWideSeen, s)
    ) {
      return false
    }
  }
  for r in mint {
    if (
      ftFactSetOf(r) == s
      && !ftPlainArgsIn(ftFactCallOf(r), once, false, s)
    ) {
      return ftFactRefusal()
    }
  }
  for r in mint {
    if ftFactSetOf(r) == s && !ftMintComplete(r, s) { return ftFactRefusal() }
  }
  // After the elaboration, a set the check left a closure is tagged only where every instance
  // of a function calling through it binds it there.
  if ftLate && !i32ListHas(ftWas, s) && mintSetPartial(s) { return false }
  ftP.s.push(s)
  ftP.leaves.push(leaves)
  ftP.ids.push(ids)
  ftP.leafTy.push(leafTy)
  const rs: i32[] = []
  const rt: i32[] = []
  for x in ftRespine { rs.push(x) }
  for t in ftRespineTy { rt.push(t) }
  ftP.resp.push(rs)
  ftP.respTy.push(rt)
  ftP.binds.push(ftBindsCur.slice(0, ftBindsCur.length))
  ftP.held.push(ftHeldCur.slice(0, ftHeldCur.length))
  return true
}

// Whether every call through the parameter fact row `r`'s call names has a fact of set `s` in
// `r`'s instance: a call the instance's typing never reached has no arms, so its set stays as is.
function ftMintComplete(r: i32, s: i32): boolean {
  const c = ftFactCallOf(r)
  if c < 0 || c >= P.nodes.length { return false }
  const n = nodeAt(c)
  if !(n is Call) { return false }
  const cf = parenPeelIx(n.callFn)
  const hf = ftHandBackParam(cf)
  if hf >= 0 { return ftHandBackCallsComplete(r, s, hf) }
  const root = ftSlotRoot(cf)
  const hb = ftHandBackParam(root)
  if hb >= 0 { return ftHandBackCallsComplete(r, s, hb) }
  const pd = identDeclOf(root)
  if pd < 0 || pd >= P.nodes.length { return false }
  const p = nodeAt(pd)
  // The callee is a parameter, or an alias of one the elaboration took as it: a `const`, a
  // `let` nothing re-points, or a `let` only ever written with such parameters.
  let name = ""
  if p is Param { name = p.parName }
  if (
    p is LetDecl
    && (p.letKw == "const" || cwLetUnwritten(pd) || mintAliasHas(pd))
  ) {
    name = p.letName
  }
  if name == "" { return false }
  if root != cf { return ftChainCallsComplete(r, s, pd) }
  const ow = cwOccWalkSpelled(pd, name)
  while cwOccNext(ow) {
    if cwIxKind[ow.row] == CW_OCC_CALL {
      const at = cwIxNode[ow.row]
      const m = nodeAt(at)
      if m is Call && identDeclOf(m.callFn) == pd {
        if ftFactSetOf(ftFactInScope(r, at)) != s { return false }
      }
    }
  }
  return true
}

// The parameter callee `c` reads where a callee hands it back: a call, made with no arguments, of a
// closure that only hands it back (`handBackCallParam`), or a record field holding it
// (`handBackFieldParam`); -1 otherwise.
function ftHandBackParam(c: i32): i32 {
  const fd = if c >= 0 && c < P.nodes.length { recEnclosingFn(c) } else { -1 }
  const fn = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { nodeAt(0) }
  if !(fn is FuncDecl) { return -1 }
  const own = handBackCallParam(c, fn)
  return if own >= 0 { own } else { handBackFieldParam(c, fn) }
}

// `ftMintComplete` for a call through a closure handing back parameter `pd`: every call whose
// callee reads `pd` that way has a fact of set `s` in fact row `r`'s instance.
function ftHandBackCallsComplete(r: i32, s: i32, pd: i32): boolean {
  const fd = recEnclosingFn(pd)
  const fn = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { nodeAt(0) }
  if !(fn is FuncDecl) { return false }
  const todo: i32[] = [fn.fnBody]
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      const xn = nodeAt(x)
      if xn is Call && ftHandBackParam(parenPeelIx(xn.callFn)) == pd {
        if ftFactSetOf(ftFactInScope(r, x)) != s { return false }
      }
      for k in nodeChildren(x) { todo.push(k) }
    }
  }
  return true
}

// The root an element chain (`r[i]`, `r[i][j]`) read `x` starts from.
function ftSlotRoot(x: i32): i32 {
  let r = x
  let depth = 0
  while r >= 0 && r < P.nodes.length && depth < 16 {
    const n = nodeAt(r)
    if n is Index { r = parenPeelIx(n.idxArr) }
    else if n is Member { r = parenPeelIx(n.memObj) }
    else if ftForInIterOf(r) >= 0 { r = ftForInIterOf(r) }
    else { return r }
    depth = depth + 1
  }
  return r
}

// The list a `for` loop walks when `x` reads that loop's element, which is an element of it; -1
// for any other read.
function ftForInIterOf(x: i32): i32 {
  if x < 0 || x >= P.nodes.length || !(nodeAt(x) is Ident) { return -1 }
  const lp = loopVarLoop(identDeclOf(x))
  const l = if lp >= 0 && lp < P.nodes.length { nodeAt(lp) } else { null }
  return if l is ForIn && l.fiDecl1 == identDeclOf(x) { parenPeelIx(l.fiIter) } else { -1 }
}

// `ftMintComplete` for a call through an element chain off parameter `pd`: every call
// in fact row `r`'s function whose callee chain starts at `pd` has a fact of set `s` there.
function ftChainCallsComplete(r: i32, s: i32, pd: i32): boolean {
  const fn = ftFactFnOf(r)
  if fn < 0 || fn >= P.nodes.length { return false }
  const f = nodeAt(fn)
  if !(f is FuncDecl) { return false }
  const c = ftFactCallOf(r)
  const cn = if c >= 0 && c < P.nodes.length { nodeAt(c) } else { null }
  const path = if cn is Call { ftChainFields(parenPeelIx(cn.callFn)) } else { "" }
  const todo: i32[] = [f.fnBody]
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      const m = nodeAt(x)
      if !(m is FuncDecl) {
        if (
          m is Call
          && identDeclOf(ftSlotRoot(parenPeelIx(m.callFn))) == pd
          && !ftPushOntoParamList(m, pd, f)
          && ftChainFields(parenPeelIx(m.callFn)) == path
        ) {
          if ftFactSetOf(ftFactInScope(r, x)) != s { return false }
        }
        nodeChildrenPush(x, todo)
      }
    }
  }
  return true
}

// The field names element chain `x` reads, root first, each followed by `.`: a record's fields
// hold sets of their own, where a list's elements share one (D15641).
function ftChainFields(x: i32): string {
  let r = x
  let out = ""
  let depth = 0
  while r >= 0 && r < P.nodes.length && depth < 16 {
    const n = nodeAt(r)
    if n is Index {
      r = parenPeelIx(n.idxArr)
    } else if n is Member {
      out = n.memProp + "." + out
      r = parenPeelIx(n.memObj)
    } else if ftForInIterOf(r) >= 0 {
      r = ftForInIterOf(r)
    } else {
      return out
    }
    depth = depth + 1
  }
  return out
}

// Whether call `m` pushes onto list binding `pd`, which `elabListParamSource` takes as one of
// `f`'s parameters: a slot write, not a call through an element.
function ftPushOntoParamList(m: Call, pd: i32, f: FuncDecl): boolean {
  const cf = parenPeelIx(m.callFn)
  const cm = if cf >= 0 && cf < P.nodes.length { nodeAt(cf) } else { null }
  if !(cm is Member) || cm.memProp != "push" { return false }
  return parenPeelIx(cm.memObj) >= 0
    && identDeclOf(parenPeelIx(cm.memObj)) == pd
    && elabListParamSource(pd, f) >= 0
}

// Each tagged set's member types, as its leaves name them.
let ftLeafTys: Map<i32, i32[]> = Map()

// The member calls call `ix` dispatches between at the instance being checked, built for the
// tagged set its callee carries there; each instance of a generic body may see its own set.
export function fnTagInstanceArms(ix: i32): i32[] {
  const none: i32[] = []
  const cn = nodeAt(ix)
  if !(cn is Call) { return none }
  const cf = parenPeelIx(cn.callFn)
  if cf < 0 { return fnTagCallArms(ix) }
  // A member call names its member.
  const cd = identDeclOf(cf)
  if cd >= 0 && nodeAt(cd) is FuncDecl { return fnTagCallArms(ix) }
  // A callee read off a list the instance types at its rep is the set its call's facts name.
  let s = fnTagSetOfTy(nonNullTy(elabLiveTyOf(cf)))
  // So is a `const` bound to such a read.
  const viaConst = cd >= 0 && cd < P.nodes.length && nodeAt(cd) is LetDecl
  if (
    s < 0
    && (ftSlotRoot(cf) != cf || viaConst)
    && fnTagSetIsTagged(mintCallSoleSet(ix))
  ) {
    s = mintCallSoleSet(ix)
  }
  // The template's arms are built for its own set; an instance holding another dispatches none.
  if (s < 0 || !fnTagSetIsTagged(s)) && s != fnTagCallSetOf(ix) { return none }
  if s < 0 || !fnTagSetIsTagged(s) { return fnTagCallArms(ix) }
  const have = fnTagArmsAt(ix, s)
  if have.length > 0 { return have }
  if !ftPlainArgs(ix, s) { return none }
  const leafTy = ftLeafTys[s] ?? []
  const ds = fnTagMembers(s)
  if leafTy.length != ds.length { return none }
  if fnTagCallSetOf(ix) < 0 { fnTagCallNote(ix, s, "", false, none) }
  ftBuildArms(ix, s, ds, leafTy)
  return fnTagArmsAt(ix, s)
}

// Builds, or re-types, the direct call of each member of `ds`, set `s`, at call `c`'s arguments.
function ftBuildArms(c: i32, s: i32, ds: i32[], leafTy: i32[]) {
  const none: i32[] = []
  ftBuildArmsAt(
    c,
    s,
    ds,
    leafTy,
    if s == fnTagCallSetOf(c) { fnTagCallRsOf(c) } else { none },
  )
}

// `ftBuildArms` with each member's result at the call given as `rs`, in set order.
function ftBuildArmsAt(c: i32, s: i32, ds: i32[], leafTy: i32[], rs: i32[]) {
  let arms = fnTagArmsAt(c, s)
  const cn = nodeAt(c)
  if !(cn is Call) { return 0 }
  if arms.length != ds.length {
    arms = []
    for d in ds {
      const f = nodeAt(d)
      let nm = ""
      if f is FuncDecl { nm = f.fnName }
      const id = mkIdent(nm, cn.pos)
      arms.push(mkCallN(id, cn.callArgs, cn.callArgNames, cn.pos))
    }
    fnTagArmsAtSet(c, s, arms)
  }
  let k = 0
  while k < arms.length {
    const an = nodeAt(arms[k])
    // A restarted walk empties the decl column and keeps the arms, so each re-use re-binds.
    if an is Call {
      // A re-used arm may stand for another member when the set's members come in another
      // order; its callee is named after the member it calls.
      const cf = if an.callFn >= 0 && an.callFn < P.nodes.length { nodeAt(an.callFn) } else { null }
      const md = nodeAt(ds[k])
      if cf is Ident && md is FuncDecl { cf.identName = md.fnName }
      identFromDecl(an.callFn, ds[k])
      nodeTySetGrow(an.callFn, leafTy[k])
      fnTagArmMemberNote(arms[k], ds[k])
    }
    const armTy = if k < rs.length { rs[k] } else { nodeTyIxOf(c) }
    nodeTySetGrow(arms[k], armTy)
    numDeliverStamp(arms[k], armTy, nodeTyIxOf(c))
    // Each member's result is boxed into the call's joined result where that is a union.
    recordBoxTy(arms[k], nodeTyIxOf(c))
    k = k + 1
  }
  return 0
}

// Whether lambda `x` of set `s` stands at `p` as a list element, a binding's initializer, or an
// argument its callee does not hand back, of a call through a set or of a declared function, so
// each call reaching it is an arm the arrow facts give.
function ftLamPlainAt(x: i32, p: i32, s: i32): boolean {
  const pn = if p >= 0 && p < P.nodes.length { nodeAt(p) } else { null }
  if pn is ArrayLit || pn is LetDecl { return true }
  if !(pn is Call) || !i32ListHas(pn.callArgs, x) || ftArgHandedBack(pn, x) {
    return false
  }
  if fnTagSetOfTy(nodeTyIxOf(parenPeelIx(pn.callFn))) >= 0 { return true }
  // A declared callee's un-annotated parameter is bound per call, so its calls are arms the facts
  // give, when they are at one signature: a lambda called at two is one closure per signature.
  const d = ftNamedFn(pn.callFn)
  const f = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  const i = i32ListIndexOf(pn.callArgs, x)
  if !(f is FuncDecl) || i >= f.fnParams.length { return false }
  const pr = nodeAt(f.fnParams[i])
  if !(pr is Param) || pr.parType >= 0 { return false }
  // At several signatures each call is its own arm, so only a parameter read as nothing but a
  // callee at scalar arguments: one handed on or stored is a slot, one closure per signature (D3975).
  return arrowSetOneShape(s)
    || arrowSetScalarArgs(s) && ftParamOnlyCalled(f, f.fnParams[i])
}

// Whether every read of parameter `par` in `f`'s body, nested functions included, is the callee
// of a call.
function ftParamOnlyCalled(f: FuncDecl, par: i32): boolean {
  const todo: i32[] = [f.fnBody]
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      const n = nodeAt(x)
      if n is Call {
        const cf = parenPeelIx(n.callFn)
        if cf >= 0 && nodeAt(cf) is Ident && identDeclOf(cf) == par {
          for a in n.callArgs { todo.push(a) }
          continue
        }
      }
      if n is Ident && identDeclOf(x) == par { return false }
      nodeChildrenPush(x, todo)
    }
  }
  return true
}

// Whether call `c`'s arguments are safe to emit in each member call, of which one runs: none holds
// a function, a literal that allocates, an assignment, or a block.
function ftPlainArgs(c: i32, s: i32): boolean {
  return ftPlainArgsIn(c, false, false, s)
}

// Whether every member of set `s` takes each positional argument of call `c` at one rep: its
// parameter is shaped only by type variables, which each arm instances at the argument's own
// type, or is that argument's closed type. A literal argument is then built alike in every arm.
function ftLitArgsAgree(c: i32, s: i32): boolean {
  const cn = nodeAt(c)
  if !(cn is Call) { return false }
  for nm in cn.callArgNames {
    if nm != "" { return false }
  }
  for m in fnTagMembers(s) {
    const f = nodeAt(m)
    if !(f is FuncDecl) || f.fnParams.length < cn.callArgs.length {
      return false
    }
    let i = 0
    while i < cn.callArgs.length {
      const pt = nodeTyIxOf(f.fnParams[i])
      const at = nodeTyIxOf(cn.callArgs[i])
      if (
        !ftTyVarShaped(pt)
        && (at < 0 || pt < 0 || !tySame(widenLitTy(at), pt))
      ) {
        return false
      }
      i = i + 1
    }
  }
  return true
}

// Whether type `t` is a type variable, or a list of what this answers true for.
function ftTyVarShaped(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const n = tyAt(t)
  match n {
    TyVar => {
      return true
    }
    TyArray => {
      return ftTyVarShaped(tyElemOf(n))
    }
    // A closed kind, or one a type variable inside does not shape alone.
    TyNullable | TyNeg | TyMap | TyObj | TyUnion | TyFunc | TyPrim | TyErr | TyLit => {
      return false
    }
  }
}

// `ftPlainArgs`, where `lits` also admits the literals that allocate and nothing they hold calls,
// and `recs` the record literals.
function ftPlainArgsIn(c: i32, lits: boolean, recs: boolean, s: i32): boolean {
  const cn = nodeAt(c)
  if !(cn is Call) { return false }
  const todo: i32[] = []
  for a in cn.callArgs { todo.push(a) }
  while todo.length > 0 {
    const x = todo.pop()
    if x < 0 || x >= P.nodes.length { return false }
    const n = nodeAt(x)
    match n {
      Ident | NumLit | StrLit | BoolLit => {}
      Unary | Paren | Member => {
        nodeChildrenPush(x, todo)
      }
      BinExpr => {
        if n.binOp == "=" || n.binCompound != "" { return false }
        nodeChildrenPush(x, todo)
      }
      ArrayLit => {
        if !lits { return false }
        nodeChildrenPush(x, todo)
      }
      ObjLit | FieldInit => {
        if !lits && !recs { return false }
        nodeChildrenPush(x, todo)
      }
      CharLit | NullLit => {
        if !lits { return false }
      }
      Call => {
        nodeChildrenPush(x, todo)
      }
      // A lambda every member calls at one closed signature is one closure whichever member
      // takes it; one whose type an arm's instance fixes is the bundle's (D14841).
      FuncDecl => {
        if !ftLamArgOk(c, x, s) { return false }
      }
      // Anything else may call, allocate, bind or loop.
      OptMember | ErrExpr | LetDecl | Param | TypeRef | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {
        return false
      }
    }
  }
  return true
}

// Whether lambda `x`, a positional argument of call `ci` through set `s`, has one signature in every
// member: each takes it as an un-annotated parameter it only calls, all at one closed argument list.
function ftLamArgOk(ci: i32, x: i32, s: i32): boolean {
  const c = nodeAt(ci)
  const lam = nodeAt(x)
  if !(c is Call) || !(lam is FuncDecl) || lam.fnName != "" || s < 0 {
    return false
  }
  const i = i32ListIndexOf(c.callArgs, x)
  if !ftArgIsParam(c, i) { return false }
  const at: i32[] = []
  for m in fnTagMembers(s) {
    const f = if m >= 0 && m < P.nodes.length { nodeAt(m) } else { null }
    if !(f is FuncDecl) || i >= f.fnParams.length { return false }
    const q = nodeAt(f.fnParams[i])
    if !(q is Param) || q.parType >= 0 { return false }
    if !ftParamOnlyCalledAt(f.fnBody, f.fnParams[i], lam.fnParams.length, at) {
      return false
    }
  }
  return at.length > 0
}

// Whether `b` is a plain `=`.
function ftIsStore(b: BinExpr): boolean {
  return b.binOp == "=" && b.binCompound == ""
}

// Whether the result type of function `f` carries set `s`.
function ftRetCarries(f: i32, s: i32): boolean {
  if f < 0 { return false }
  return fnTagSetOfTy(rcwInferredRetTy(f)) == s
}

// Whether binding `d` is a copy of a parameter of function `fn` (`fnTagParamCopyOf`).
function ftParamCopyAt(d: i32, fn: i32): boolean {
  if fn < 0 || fn >= P.nodes.length { return false }
  const f = nodeAt(fn)
  return f is FuncDecl && fnTagParamCopyOf(f, d) >= 0
}

// Whether the result type of function `f` is `void`.
function ftRetVoid(f: i32): boolean {
  return f >= 0 && rcwInferredRetTy(f) == TY_VOID
}

// The set of the slot that call `c` writes value `x` into: an element `xs.push(x)` appends, or the
// entry `m.set(k, x)` stores; -1 for any other call.
function ftSlotWriteSet(c: Call, x: i32): i32 {
  const fn = nodeAt(parenPeelIx(c.callFn))
  if !(fn is Member) { return -1 }
  const ht = nodeTyIxOf(fn.memObj)
  if ht < 0 || ht >= T.tys.length { return -1 }
  const h = tyAt(ht)
  match h {
    TyArray => {
      return if fn.memProp == "push" { fnTagSetOfTy(tyElemOf(h)) } else { -1 }
    }
    TyMap => {
      const isVal = c.callArgs.length == 2 && c.callArgs[1] == x
      return if fn.memProp == "set" && isVal { fnTagSetOfTy(tyValOf(h)) } else { -1 }
    }
    // Only a list's `push` and a map's `set` write a slot.
    TyObj | TyPrim | TyErr | TyFunc | TyUnion | TyNullable | TyVar | TyLit | TyNeg => {
      return -1
    }
  }
}

// Whether the rows found set `s` partial: a place it reaches is reached through a parameter they
// cannot follow, so the hand-off candidate leaves it to the decision after the elaboration.
function ftHandPartial(s: i32): boolean {
  return setBindTryClass(s).indexOf("P") >= 0
}

// Whether every member of set `s` returns, at the parameter types of destination type `edt`, a
// value its result takes; a set one member of which does not is left to the write's refusal.
function ftHandFits(s: i32, edt: i32): boolean {
  if edt < 0 || edt >= T.tys.length { return false }
  const edf = tyAt(edt)
  if !(edf is TyFunc) { return false }
  return holeSetFitsRetAt(s, edf.fnParamTypes, edf.fnRet)
}

function ftGenFnParamHand(site: i32): boolean {
  cwIxBuild()
  const x = parenPeelIx(site)
  if x < 0 || !cwIxCovers(x) { return false }
  const p = cwIxUp[x]
  const c = if p >= 0 && p < P.nodes.length { nodeAt(p) } else { null }
  if !(c is Call) { return false }
  const fd = identFnDeclOf(parenPeelIx(c.callFn))
  const f = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { null }
  if !(f is FuncDecl) || f.fnTyParams.length == 0 { return false }
  let i = 0
  while i < c.callArgs.length && i < f.fnParams.length {
    if parenPeelIx(c.callArgs[i]) == x {
      return tyHasTyVar(nodeTyIxOf(f.fnParams[i]))
    }
    i = i + 1
  }
  return false
}

// Whether node `x` carries set `s`.
function ftIsS(x: i32, s: i32): boolean {
  return x >= 0 && fnTagSetOfTy(nodeTyIxOf(x)) == s
}

// Per wider set a member's `return` joins, the functions returning it, whose returned members
// are its leaves when nothing calls them (D15457).
let ftRetJoinFns: {[i32]: i32[]} = Map()

// The set other than `s` that a join carries, when member name `x` is an element of list literal
// `p`, a value call `p` writes into a list or map slot, the tail of block `p` of join `g`, or
// returned by `fn`; -1 otherwise. That set's own decision builds the leaf, and its rep is the
// join's.
function ftOtherTail(x: i32, p: i32, g: i32, fn: i32, s: i32, ds: i32[]): i32 {
  if p < 0 || ftLeafMember(x, ds) < 0 { return -1 }
  const pn = nodeAt(p)
  if pn is RetStmt {
    if fn < 0 || pn.retArg != x || ftFnNeverNamed(fn) { return -1 }
    const o = fnTagSetOfTy(rcwInferredRetTy(fn))
    if o == s { return -1 }
    if o >= 0 {
      const have = ftRetJoinFns[o] ?? []
      if !i32ListHas(have, fn) { have.push(fn) }
      ftRetJoinFns[o] = have
    }
    return o
  }
  if pn is Call && pn.callFn != x {
    const o = ftSlotWriteSet(pn, x)
    if o == s { return -1 }
    return o
  }
  if pn is ArrayLit {
    const lt = nodeTyIxOf(p)
    if lt < 0 || lt >= T.tys.length { return -1 }
    const at = tyAt(lt)
    if !(at is TyArray) { return -1 }
    const o = fnTagSetOfTy(tyElemOf(at))
    if o == s { return -1 }
    return o
  }
  if g < 0 { return -1 }
  const gn = nodeAt(g)
  // A field of a record literal built at a record of another tagged set holds that set's id
  // (D16749).
  if pn is FieldInit && gn is ObjLit && pn.fiValue == x {
    const o = fnTagSetOfTy(tyFieldTyOf(nodeRepTyIxOf(g), pn.fiName))
    return if o >= 0 && o != s && fnTagSetIsTagged(o) { o } else { -1 }
  }
  if !(pn is Block) || !(gn is IfStmt || gn is MatchExpr) { return -1 }
  const st = pn.blkStmts
  if st.length == 0 || st[st.length - 1] != x { return -1 }
  const o = fnTagSetOfTy(nodeTyIxOf(g))
  if o == s { return -1 }
  return o
}

// Whether no read, call or method call of function `fn`'s spelling may stand for it and it is not
// exported, so no call ever runs it.
function ftFnNeverNamed(fn: i32): boolean {
  if fn < 0 || fn >= P.nodes.length || declIsExportedFn(fn) { return false }
  const f = nodeAt(fn)
  if !(f is FuncDecl) || f.fnName == "" { return false }
  cwIxWant()
  const w = cwOccWalkSpelled(fn, demangleName(f.fnName))
  while cwOccNext(w) {
    if cwIxNode[w.row] != fn { return false }
  }
  return true
}

// Walks the program for every node carrying set `s`, pushing each member name it reaches to
// `leaves` with the member it names to `ids`; false at the first node an id cannot stand at.
function ftScan(
  rootIx: i32,
  s: i32,
  ds: i32[],
  leaves: i32[],
  ids: i32[],
): boolean {
  const xs: i32[] = [rootIx]
  const ps: i32[] = [-1]
  const gs: i32[] = [-1]
  const fs: i32[] = [-1]
  const oks: boolean[] = [true]
  while xs.length > 0 {
    const x = xs.pop()
    const p = ps.pop() ?? -1
    const g = gs.pop() ?? -1
    let fn = fs.pop() ?? -1
    let ok = oks.pop() ?? false
    if x >= 0 && x < P.nodes.length {
      // A function read as a value whose signature holds the set takes or hands ids, so it is
      // called, or delivered only where the destination's type is its own.
      if ftSigValue(x, s) {
        const cn = nodeAt(p)
        if (
          !ftRetAtOwn(x, p, g, fn)
          && !ftConstFnOnlyCalled(x, p)
          && !ftMakerTwinServes(x)
          && (!(cn is Call)
            || cn.callFn != x
            && (ftArgDstTy(cn, x) != nodeTyIxOf(x) || !ftValueSigned(x)))
        ) {
          return false
        }
      }
      // A member leaf of another set's join is an id only when that set is tagged too, since
      // the join and its leaves share one rep. A join of a wider set is decided with `s`
      // (D15036).
      const ot = if ftIsS(x, s) { ftOtherTail(x, p, g, fn, s, ds) } else { -1 }
      if ot >= 0 && !fnTagSetIsTagged(ot) && !i32ListHas(ftAssume, ot) {
        if !fnTagMembersWithin(s, ot) { return false }
        if !i32ListHas(ftSubNeed, ot) { ftSubNeed.push(ot) }
      }
      // A function nothing names never returns, so a member it returns is no leaf (D15070).
      const deadRet = p >= 0 && nodeAt(p) is RetStmt && ftFnNeverNamed(fn)
      if ftIsS(x, s) && ot < 0 && !deadRet && !ftNamedAtClosed(x, p, g, s) {
        if !ok || !ftNodeOk(x, p, s, ds, leaves, ids) { return false }
        if !ftCtxOk(x, p, g, fn, s) { return false }
        const pn = nodeAt(p)
        // A written binding is read as a callee, a binding, a join's value, a delivery to a
        // closed function type, which the adapter built there reads once (a function it is
        // captured into sees later writes), or a hand to an open parameter, which takes the id.
        const xn = nodeAt(x)
        if xn is Ident && fnLetIsWide(nodeTyIxOf(x)) {
          const esc = i32ListHas(ftEscapes, x) || fnTagEtaAt(x)
          if esc && !ftWideEscOk(s) { return false }
          if pn is Call && pn.callFn != x && !esc && !fnLetOpenHandAt(x) {
            return false
          }
          ftWideSeen = true
        }
        // A binding of the set written: what the write stores is an id of it.
        if pn is BinExpr && ftIsStore(pn) && pn.binLeft == x {
          const wv = ftWrittenNamedSource(pn.binRight, nodeTyIxOf(x))
          if !ftJoinAt(wv, nodeTyIxOf(x), s, ds, leaves, ids) { return false }
        }
      }
      // A record literal written whole into a binding the field widener widened, or a field or
      // element slot of one, stores ids at its fields; the record solve builds the literal at that
      // place's record (`recAsgFnWidenedTy`, D15306, D15307).
      // A value `if` or `match` writes each of its tail literals (D15390).
      const rw = if p >= 0 && p < P.nodes.length { nodeAt(p) } else { null }
      if ftHolds(x, s) && rw is BinExpr && ftIsStore(rw) && rw.binLeft == x {
        const wls: i32[] = []
        const soleLits: i32[] = []
        tailValueLeaves(rw.binRight, wls)
        // A read of a binding read nowhere else writes its initialiser's literals (D15308).
        let wi = 0
        while wi < wls.length && wi < 64 {
          const bi = cwSoleReadInit(wls[wi])
          const bl: i32[] = []
          if bi >= 0 { tailValueLeaves(bi, bl) }
          let fw = false
          for b in bl {
            if recAsgFnWidenedTy(parenPeelIx(b)) >= 0 { fw = true }
            // A record literal only this write reads, of another set, is stored here whole: its
            // fields hold this binding's ids too.
            if ftSoleRecLitOther(b, nodeTyIxOf(x)) { fw = true }
          }
          if fw {
            ftWrittenSourceAt(wls[wi], nodeTyIxOf(x))
            for b in bl {
              wls.push(b)
              if ftSoleRecLitOther(b, nodeTyIxOf(x)) {
                soleLits.push(parenPeelIx(b))
              }
            }
          }
          wi = wi + 1
        }
        for wl in wls {
          const wx = parenPeelIx(wl)
          // A record binding read elsewhere too keeps its own row, which a write of it here
          // cannot re-type: the set stays a closure where that record's differs (D16919).
          if ftRecSourceKeepsRow(wx, nodeTyIxOf(x)) { return false }
          if (
            (recAsgFnWidenedTy(wx) >= 0
              || ftStoredAt(wx, s)
              || i32ListHas(soleLits, wx))
            && !ftRecWriteJoins(wx, nodeTyIxOf(x), s, ds, leaves, ids)
          ) {
            return false
          }
          if ftStoredAt(wx, s) || i32ListHas(soleLits, wx) {
            ftP.storeLits.push(wx)
            ftP.storeTys.push(nodeTyIxOf(x))
          }
          ftWrittenNote(wx)
          if recAsgFnWidenedTy(wx) >= 0 {
            ftWrittenInitNote(x, wx)
            ftWrittenFieldListsNote(wx, x)
          }
          // A list literal of records stored at an element of a held list of lists is built at
          // that element, as a pushed one is (D16858).
          const lx = nodeAt(x)
          if lx is Index && ftWholeRecListLit(wx) {
            ftWrittenWholeNote(wx, parenPeelIx(lx.idxArr))
          }
        }
      }
      // A written slot of a holder of the set's ids stores an id of it, whatever type the slot
      // read had before the holder's first write pinned it.
      const st = ftSlotStoreTy(x, p, s)
      if st >= 0 {
        const sn = nodeAt(p)
        if sn is BinExpr && !ftJoinAt(sn.binRight, st, s, ds, leaves, ids) {
          return false
        }
      }
      // A value join of maps of the set holds each tail's map; a tail of a smaller set within it
      // is decided with it, as a list literal's element is (D15393).
      ftJoinMapTailsNote(x, s)
      // A holder read as the set's ids, not coerced to closures and not annotated, is stamped.
      const n0 = nodeAt(x)
      // A record literal holding a list of lists in a field is built at its rep, as a bound
      // one is (D16821).
      const held = n0 is ArrayLit
        || n0 is LetDecl && n0.letType < 0
        || n0 is ObjLit && fnTagRecHoldsListOfLists(nodeTyIxOf(x))
      if (
        held
        && ftHolds(x, s)
        && !ftHolderCoerced(x, s)
        && !i32ListHas(ftHeldCur, x)
      ) {
        ftHeldCur.push(x)
      }
      // A list holding the set's ids is read by index only, outside an instance body.
      if (
        ftHolds(x, s)
        && !ftHolderCoerced(x, s)
        && !ftHoldCtxOk(x, p, g, fn, s)
      ) {
        return false
      }
      // A value a slot method writes into the holder is an id of the set, as a store's is.
      for v in ftSlotWrites(x, p, g, s) {
        const xti = nodeTyIxOf(x)
        const xt = if xti >= 0 && xti < T.tys.length { tyAt(xti) } else { null }
        const hk = ftHoldKind(xti, s)
        const rec = hk == 6 && xt is TyArray || hk == 8 && xt is TyMap
        // A list's or a map's record slot takes the written record's fields as its own.
        const recTy = if xt is TyArray { tyElemOf(xt) } else if xt is TyMap { tyValOf(xt) } else { -1 }
        // A map's entry literal, a record or a list of records, is built at the map's value row.
        if (
          rec
          && xt is TyMap
          && !ftMapEntryLitJoins(v, recTy, s, ds, leaves, ids)
        ) {
          return false
        }
        if (
          rec
          && !(xt is TyMap)
          && !ftRecWriteJoins(v, recTy, s, ds, leaves, ids)
        ) {
          return false
        }
        if hk == 7 && xt is TyArray {
          if !ftMapElemOk(v, s) { return false }
        } else if hk == 4 && xt is TyArray {
          // A list written into a list of lists is an inner literal of the set, or of a smaller
          // set re-typed to the element, as the literal's own elements are (D16805).
          if !ftListElemOk(v, tyElemOf(xt), s, ds, leaves, ids) { return false }
        } else if (
          !rec
          && !ftJoinAt(v, ftSlotTyOf(nodeTyIxOf(x), s), s, ds, leaves, ids)
        ) {
          return false
        }
      }
      const n = nodeAt(x)
      if (
        n is ArrayLit
        && !ftHolderCoerced(x, s)
        && !ftLitJoin(x, n, s, ds, leaves, ids)
      ) {
        return false
      }
      if n is FuncDecl {
        fn = x
        ok = if ftClosedLambda(n) { ok } else { ftFnOk(x) }
      }
      const kids: i32[] = []
      nodeChildrenPush(x, kids)
      for k in kids {
        xs.push(k)
        ps.push(x)
        gs.push(p)
        fs.push(fn)
        oks.push(ok)
      }
    }
  }
  return true
}

// Whether parameter `i` of `f` (declared at `d`) is annotated by an own type parameter `T` the
// instance binds to one set (`fnTagOwnTyParamJoins`), or by one the result names bare too, that
// every parameter naming it annotates bare, each handed the same named function by `args` when
// several do, with `f` handing one of them back: the result is an argument's value.
export function ftOwnTyParamJoins(
  d: i32,
  f: FuncDecl,
  i: i32,
  args: i32[],
): boolean {
  if fnTagOwnTyParamJoins(f, i, args) { return true }
  if f.fnRet < 0 || i < 0 || i >= f.fnParams.length { return false }
  const pn = nodeAt(f.fnParams[i])
  if !(pn is Param) || pn.parType < 0 { return false }
  const tn = nodeAt(pn.parType)
  const rn = nodeAt(f.fnRet)
  if !(tn is TypeRef) || !(rn is TypeRef) || rn.tyName != tn.tyName {
    return false
  }
  if !strListHas(f.fnTyParams, tn.tyName) { return false }
  const nm: string[] = [tn.tyName]
  let ad = -1
  let back = false
  let k = 0
  while k < f.fnParams.length {
    const q = nodeAt(f.fnParams[k])
    if (
      q is Param
      && q.parType >= 0
      && tsMentionsAnyName(annTsOf(q.parType), nm)
    ) {
      const qt = nodeAt(q.parType)
      if !(qt is TypeRef) || qt.tyName != tn.tyName { return false }
      if k != i {
        if k >= args.length || i >= args.length { return false }
        if ad < 0 { ad = fnTagSharedArgDecl(args[i]) }
        if ad < 0 || !fnTagJoinsWith(ad, fnTagSharedArgDecl(args[k])) {
          return false
        }
      }
      if i32ListHas(ftRetParamsOf(d), k) { back = true }
    }
    k = k + 1
  }
  if !back { return false }
  // Nor anything in the body that names a type, but a copy of a parameter, which holds its id.
  const todo: i32[] = [f.fnBody]
  while todo.length > 0 {
    const x = todo.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      const xn = nodeAt(x)
      if xn is LetDecl && fnTagParamCopyOf(f, x) >= 0 {
        todo.push(xn.letInit)
      } else {
        if ftNamesTyIn(x, nm) { return false }
        nodeChildrenPush(x, todo)
      }
    }
  }
  return true
}

// Whether node `x` names a type mentioning one of `nm`: an annotation of a binding, parameter
// or result, an `as` cast, or a call's explicit type arguments (refused whatever they name).
function ftNamesTyIn(x: i32, nm: string[]): boolean {
  const n = nodeAt(x)
  match n {
    TypeRef => {
      return tsMentionsAnyName(annTsOf(x), nm)
    }
    LetDecl => {
      return n.letType >= 0 && tsMentionsAnyName(annTsOf(n.letType), nm)
    }
    Param => {
      return n.parType >= 0 && tsMentionsAnyName(annTsOf(n.parType), nm)
    }
    FuncDecl => {
      return n.fnRet >= 0 && tsMentionsAnyName(annTsOf(n.fnRet), nm)
    }
    AsExpr => {
      return ftSpellingNames(n.asTy, nm)
    }
    Call => {
      return callTyArgsOf(x).length > 0
    }
    // No other node names a type of its own; its annotated children are walked separately.
    ArrayLit | BinExpr | Block | BoolLit | BreakStmt | CharLit | ContinueStmt | ErrExpr | FieldDef | FieldInit | ForIn | ForRange | Ident | IfStmt | ImportDecl | Index | IsExpr | LoopVar | MatchExpr | Member | NullLit | NumLit | ObjLit | OptMember | Paren | Program | RetStmt | Spread | StrLit | TypeDecl | Unary | UnionDecl | WhileStmt => {
      return false
    }
  }
}

// Whether type spelling `t` contains one of `nm` as a whole identifier.
function ftSpellingNames(t: string, nm: string[]): boolean {
  let i = 0
  while i < t.length {
    let j = i
    while j < t.length && ftIdentChar(t[j]) { j = j + 1 }
    if j > i && strListHas(nm, t.slice(i, j)) { return true }
    i = if j > i { j } else { i + 1 }
  }
  return false
}

function ftIdentChar(c: i32): boolean {
  return c >= 48 && c <= 57
    || c >= 65 && c <= 90
    || c >= 97 && c <= 122
    || c == 95
}

// Whether call `c` of declared function `d` hands a value of set `s` to a parameter `d` returns,
// or one of a smaller set to a parameter whose shared type parameter joins to `s`, which that
// set is then decided with.
function ftHandsBack(d: i32, c: Call, s: i32): boolean {
  const f = nodeAt(d)
  for i in ftRetParamsOf(d) {
    if ftArgIsParam(c, i) && ftIsS(c.callArgs[i], s) { return true }
    const j = if f is FuncDecl && ftArgIsParam(c, i) { fnTagSharedJoinSet(f, i, c.callArgs) } else { -1 }
    const o = if j == s { fnTagSetOfTy(nodeTyIxOf(c.callArgs[i])) } else { -1 }
    if o >= 0 && fnTagMembersWithin(o, s) {
      if !i32ListHas(ftSubNeed, o) { ftSubNeed.push(o) }
      return true
    }
  }
  return false
}

// Whether `x` is a function name or lambda whose type holds set `s` in a parameter or result.
function ftSigValue(x: i32, s: i32): boolean {
  const n = nodeAt(x)
  if !(n is Ident) && !(n is FuncDecl && n.fnName == "") { return false }
  return ftSigCarriesIn(nodeTyIxOf(x), s, [])
}

// Whether `x` names a maker delivered to a closed function type whose result a maker row banks:
// the maker's twin at that result hands back its own member's closure, not an id of the set.
function ftMakerTwinServes(x: i32): boolean {
  if !(nodeAt(x) is Ident) { return false }
  const d = identDeclOf(x)
  const t = nodeCtxTyIxOf(x)
  if d < 0 || t < 0 || t >= T.tys.length || !ftClosedFnTy(t) { return false }
  const ft = tyAt(t)
  return ft is TyFunc && elabMakerRowHas(d, ft.fnRet)
}

// Whether `x`, with parent `p` and grandparent `g`, is the value function `fn` returns at
// `fn`'s own result type, so it is delivered where `fn`'s result is.
function ftRetAtOwn(x: i32, p: i32, g: i32, fn: i32): boolean {
  const t = nodeTyIxOf(fn)
  if p < 0 || t < 0 || t >= T.tys.length || !ftValueSigned(x) { return false }
  const ft = tyAt(t)
  if !(ft is TyFunc) || ft.fnRet != nodeTyIxOf(x) { return false }
  const pn = nodeAt(p)
  if pn is RetStmt { return pn.retArg == x }
  const f = nodeAt(fn)
  if !(pn is Block) || g != fn || !(f is FuncDecl) || f.fnBody != p {
    return false
  }
  return pn.blkStmts.length > 0 && pn.blkStmts[pn.blkStmts.length - 1] == x
}

// Whether function value `x` has one signature to be built at: a function with no type
// parameters and every parameter declared, or a value that is not a declaration.
function ftValueSigned(x: i32): boolean {
  const n = nodeAt(x)
  const d = if n is Ident { identDeclOf(x) } else { x }
  if d < 0 || d >= P.nodes.length { return true }
  const f = nodeAt(d)
  if !(f is FuncDecl) || f.fnTyParams.length > 0 { return !(f is FuncDecl) }
  for q in f.fnParams {
    if !ftParamClosed(q) { return false }
  }
  return true
}

// Whether parameter `q` has one type where it is written: declared, or seeded closed by the
// callback context it is delivered to.
function ftParamClosed(q: i32): boolean {
  const pn = nodeAt(q)
  if !(pn is Param) { return false }
  return pn.parType >= 0 || elabTyClosed(nodeTyIxOf(q))
}

// Whether `x`, the child of `p` in `g`, names a member of set `s` delivered to a closed function
// type: a parameter of a declared callee annotated so, a binding annotated so, or a field of a
// record literal built at a record whose field is so. The name is its own instance there, not a
// value of the set, as a generic member's is.
function ftNamedAtClosed(x: i32, p: i32, g: i32, s: i32): boolean {
  if x < 0 || p < 0 || !(nodeAt(x) is Ident) { return false }
  const d = identDeclOf(x)
  if d < 0 || !i32ListHas(fnTagMembers(s), d) { return false }
  const pn = nodeAt(p)
  if pn is LetDecl {
    return pn.letInit == x && pn.letType >= 0 && ftClosedFnTy(nodeTyIxOf(p))
  }
  // A field of a record literal the record solve builds at a record whose field is closed.
  if pn is FieldInit {
    if pn.fiValue != x || g < 0 || !(nodeAt(g) is ObjLit) { return false }
    const bt = ftLitBuiltAt(g)
    const rt = if bt >= 0 { bt } else { ftLitAnnotAt(g) }
    return ftClosedFnTy(tyFieldTyOf(rt, pn.fiName))
  }
  if !(pn is Call) || pn.callFn == x { return false }
  const i = i32ListIndexOf(pn.callArgs, x)
  const cd = ftCalleeFn(ftCalleeSource(pn))
  if i < 0 || cd < 0 { return false }
  const f = nodeAt(cd)
  if !(f is FuncDecl) || i >= f.fnParams.length { return false }
  const q = nodeAt(f.fnParams[i])
  return q is Param && q.parType >= 0 && ftClosedFnTy(nodeTyIxOf(f.fnParams[i]))
}

// Whether list literal `x`, bound at an annotation, holds set `s` only as members named as its
// elements or in fields of its record literals, each built at a closed function type there: each
// is its member's closure and the list holds no id.
function ftLitAtClosed(x: i32, s: i32): boolean {
  if x < 0 || x >= P.nodes.length { return false }
  const n = nodeAt(x)
  if !(n is ArrayLit) || n.arrElems.length == 0 { return false }
  // The binding's annotation, not the literal's own type, is where the records are built, and it
  // must hold no set decided with `s`.
  cwIxBuild()
  if !cwIxCovers(x) || cwIxUpKind[x] != CW_UP_LETINIT { return false }
  const b = cwIxUp[x]
  const bn = if b >= 0 && b < P.nodes.length { nodeAt(b) } else { null }
  if !(bn is LetDecl) || bn.letType < 0 || ftTyHoldsDecided(nodeTyIxOf(b), s) {
    return false
  }
  for e in n.arrElems {
    const o = nodeAt(e)
    // A member's name, or the adapter the check built over one, is a closure at a closed type.
    if o is Ident || o is FuncDecl {
      const m = if o is Ident { identDeclOf(e) } else { -1 }
      if o is Ident && !i32ListHas(fnTagMembers(s), m) { return false }
      if o is FuncDecl && i32ListHas(fnTagMembers(s), e) { return false }
      if !ftClosedFnTy(ftLitAnnotAt(e)) { return false }
      continue
    }
    if !(o is ObjLit) { return false }
    for fx in o.objFields {
      const f = nodeAt(fx)
      if !(f is FieldInit) { return false }
      if ftHolds(f.fiValue, s) || ftIsS(f.fiValue, s) {
        const fv = f.fiValue
        if fv < 0 || fv >= P.nodes.length || !(nodeAt(fv) is Ident) {
          return false
        }
        if !i32ListHas(fnTagMembers(s), identDeclOf(fv)) { return false }
        if !ftClosedFnTy(tyFieldTyOf(ftLitAnnotAt(e), f.fiName)) {
          return false
        }
      }
    }
  }
  return true
}

// The record a record literal `x` is built at, bound by an annotated binding directly or as an
// element of one list literal (`const ys: R[] = [{ f: m }]`, or the annotation a lone use gives
// it), or -1 (D15338). A list of lists of such records is not built at its closures yet.
function ftLitAnnotAt(x: i32): i32 {
  cwIxBuild()
  let cur = x
  let depth = 0
  while depth < 2 {
    if cur < 0 || !cwIxCovers(cur) { return -1 }
    const up = cwIxUp[cur]
    if up < 0 || up >= P.nodes.length { return -1 }
    const un = nodeAt(up)
    if cwIxUpKind[cur] == CW_UP_ELEM && un is ArrayLit {
      cur = up
      depth = depth + 1
    } else if (
      cwIxUpKind[cur] == CW_UP_LETINIT
      && un is LetDecl
      && un.letType >= 0
    ) {
      let t = nodeTyIxOf(up)
      let k = 0
      while k < depth {
        if t < 0 || t >= T.tys.length { return -1 }
        const tt = tyAt(t)
        if !(tt is TyArray) { return -1 }
        t = tyElemOf(tt)
        k = k + 1
      }
      return t
    } else {
      return -1
    }
  }
  return -1
}

// Whether `x` is a call handing back one of its arguments (`ftHandBackArg`), the initialiser of
// `p`, a binding annotated with a closed function type.
function ftHandBackAtClosed(x: i32, p: i32): boolean {
  if x < 0 || p < 0 || ftHandBackArg(x) < 0 { return false }
  const pn = nodeAt(p)
  return pn is LetDecl
    && pn.letInit == x
    && pn.letType >= 0
    && ftClosedFnTy(nodeTyIxOf(p))
}

// Whether set `s` has one member, a generic declaration.
function ftOneGenericMember(s: i32): boolean {
  const ms = fnTagMembers(s)
  return ms.length == 1 && ftNamedDecl(ms[0]) && !ftPlainDecl(ms[0])
}

// The argument call `x` hands back, by the elaboration's hand-back fact for its declared callee:
// a positional argument naming a function; -1 for any other node.
function ftHandBackArg(x: i32): i32 {
  if x < 0 || x >= P.nodes.length { return -1 }
  const c = nodeAt(x)
  if !(c is Call) { return -1 }
  const d = ftNamedFn(c.callFn)
  if d < 0 { return -1 }
  const rp = ftRetParamsOf(d)
  if rp.length != 1 || !ftArgIsParam(c, rp[0]) { return -1 }
  const a = parenPeelIx(c.callArgs[rp[0]])
  return if a >= 0 && nodeAt(a) is Ident && identFnDeclOf(a) >= 0 { a } else { -1 }
}

// Whether `t` is a function type with no type parameter or hole in it.
function ftClosedFnTy(t: i32): boolean {
  return t >= 0
    && t < T.tys.length
    && tyAt(t) is TyFunc
    && !tyHasTyVar(t)
    && !tyHoldsHole(t)
}

// Whether node `d` declares a named function with no type parameters.
function ftPlainDecl(d: i32): boolean {
  if d < 0 || d >= P.nodes.length { return false }
  const f = nodeAt(d)
  return f is FuncDecl && f.fnName != "" && f.fnTyParams.length == 0
}

// Whether a written binding of set `s` may be delivered through an adapter: each member is a named
// declaration or a lambda whose id can stand for it, and one is generic or has a parameter with no
// annotation, so no one closure signature holds the binding's value.
function ftWideEscOk(s: i32): boolean {
  let gen = false
  for m in fnTagMembers(s) {
    if ftNamedDecl(m) {
      if !ftPlainDecl(m) || ftHoleLambda(m) { gen = true }
    } else if (
      ftLambdaIdOk(m)
      && (!ftWithinInstancedFn(m) || ftInstLeafOk(m, -1))
    ) {
      if ftHoleLambda(m) { gen = true }
    } else {
      return false
    }
  }
  return gen
}

// Whether function `m` has a parameter with no annotation, so each call instances it anew.
function ftHoleLambda(m: i32): boolean {
  const f = nodeAt(m)
  if !(f is FuncDecl) { return false }
  for pi in f.fnParams {
    const p = nodeAt(pi)
    if p is Param && p.parType < 0 { return true }
  }
  return false
}

// Whether `x` is a delivery of set `s` that the last check built as an adapter.
function ftWideEtaAt(x: i32, s: i32): boolean {
  return fnTagEtaAt(x) && fnTagEtaSetOf(x) == s && ftWideEscOk(s)
}

// Whether `m` is the one member of set `s` and a lambda with an open parameter that can stand as
// an id: it has no one closure signature, so its delivery to a closed function type is built there
// from its id, as a generic declaration's is (D14884).
function ftHoleLambdaAlone(s: i32, m: i32): boolean {
  if fnTagMembers(s).length != 1 || m < 0 || m >= P.nodes.length {
    return false
  }
  const f = nodeAt(m)
  return f is FuncDecl
    && f.fnName == ""
    && !ftClosedLambda(f)
    && ftLambdaIdOk(m)
}

// Whether node `d` declares a named function, generic or not.
function ftNamedDecl(d: i32): boolean {
  if d < 0 || d >= P.nodes.length { return false }
  const f = nodeAt(d)
  return f is FuncDecl && f.fnName != ""
}

// The sets an escape of type `t` delivers: its own, or those of its parameters and result.
function ftEscSets(t: i32): i32[] {
  const out: i32[] = []
  if t < 0 || t >= T.tys.length { return out }
  const own = fnTagSetOfTy(t)
  if own >= 0 {
    out.push(own)
    return out
  }
  const ft = tyAt(t)
  if !(ft is TyFunc) { return out }
  const slots = ft.fnParamTypes.slice(0, ft.fnParamTypes.length)
  slots.push(ft.fnRet)
  for q in slots {
    const s = fnTagSetOfTy(q)
    if s >= 0 { out.push(s) }
  }
  return out
}

// Whether function type `t` takes or returns a tagged set.
function ftSigTagged(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const ft = tyAt(t)
  if !(ft is TyFunc) { return false }
  if fnTagSetIsTagged(fnTagSetOfTy(ft.fnRet)) { return true }
  for q in ft.fnParamTypes {
    if fnTagSetIsTagged(fnTagSetOfTy(q)) { return true }
  }
  return false
}

// Whether function type `t` holds set `s` in a parameter or result, through signatures not in
// `seen`.
function ftSigCarriesIn(t: i32, s: i32, seen: i32[]): boolean {
  if t < 0 || t >= T.tys.length || i32ListHas(seen, t) { return false }
  seen.push(t)
  const ft = tyAt(t)
  if !(ft is TyFunc) { return false }
  if fnTagSetOfTy(ft.fnRet) == s || ftSigCarriesIn(ft.fnRet, s, seen) {
    return true
  }
  for q in ft.fnParamTypes {
    if fnTagSetOfTy(q) == s || ftSigCarriesIn(q, s, seen) { return true }
  }
  return false
}

// Whether `f` is a lambda with every parameter annotated: one instance, typed where it is
// written, so a call through a set inside it is typed as its enclosing function types it.
function ftClosedLambda(f: FuncDecl): boolean {
  if f.fnName != "" || f.fnTyParams.length > 0 { return false }
  for p in f.fnParams {
    if !ftParamClosed(p) { return false }
  }
  return true
}

// Whether a node of a tagged set may sit in function `fn`: the program's top level, or a named
// function at any depth, whose instances each type its calls through the set.
function ftFnOk(fn: i32): boolean {
  if fn < 0 { return true }
  const f = nodeAt(fn)
  return f is FuncDecl && f.fnName != ""
}

// Whether lambda `x` can stand as an id: it reads only its own bindings and the module's, so a
// call by its declaration needs no environment, and calls none of its parameters, whose instance
// is chosen by the function a caller hands it rather than by the one arm an id calls, unless every
// call of it is an arm's (`ftArmOnlyLams`).
function ftLambdaIdOk(x: i32): boolean {
  const f = nodeAt(x)
  if !(f is FuncDecl) { return false }
  const inside: Map<i32, boolean> = Map()
  const sub: i32[] = []
  const todo: i32[] = [x]
  while todo.length > 0 {
    const y = todo.pop() ?? -1
    if y >= 0 && y < P.nodes.length && !(inside[y] ?? false) {
      inside[y] = true
      sub.push(y)
      nodeChildrenPush(y, todo)
    }
  }
  for y in sub {
    const yn = nodeAt(y)
    if yn is Ident {
      const d = identDeclOf(y)
      if d >= 0 && !(inside[d] ?? false) && cwUseCaptures(y) { return false }
    }
    if (
      yn is Call
      && i32ListHas(f.fnParams, identDeclOf(parenPeelIx(yn.callFn)))
      && !(ftArmOnlyLams[x] ?? false)
    ) {
      return false
    }
  }
  return true
}

// Whether node `x`, carrying set `s`, is a kind an id can be, recording the member names whose
// values it is made of.
function ftNodeOk(
  x: i32,
  p: i32,
  s: i32,
  ds: i32[],
  leaves: i32[],
  ids: i32[],
): boolean {
  const n = nodeAt(x)
  match n {
    Ident => {
      const d = ftLeafMember(x, ds)
      if d >= 0 && !i32ListHas(leaves, x) {
        leaves.push(x)
        ids.push(d)
      }
      return true
    }
    // A `let` written with other members holds the set its initialiser is one of.
    LetDecl => {
      if !i32ListHas(ftBindsCur, x) { ftBindsCur.push(x) }
      if n.letInit < 0 || ftIsS(n.letInit, s) { return true }
      return ftJoinAt(n.letInit, nodeTyIxOf(x), s, ds, leaves, ids)
    }
    Paren | Block => {
      return true
    }
    // A parameter of a set's type is bound by the call that hands it its argument, an
    // un-annotated one at that call's instance.
    Param => {
      return true
    }
    // An annotation holds no value.
    TypeRef => {
      return true
    }
    Call => {
      if fnTagCallSetOf(x) == s { return true }
      // A nested function's call hands back what it returns, whatever it captures: only a
      // member's id needs no environment (`ftNamedFn`).
      const nd = ftNamedFn(n.callFn)
      const d = if nd >= 0 { nd } else { ftNestedCalleeDecl(n.callFn) }
      // A function an instance found to hand back its parameter gives this call that argument.
      if (ftLate || ftUseArrow) && d >= 0 && ftHandsBack(d, n, s) {
        return true
      }
      // In the retry, a callee the check's facts say hands a parameter back, yet not this set's,
      // is the facts refusing.
      if ftUseArrow && d >= 0 && ftRetParamsOf(d).length > 0 { ftFactRefusal() }
      const ld = if d >= 0 { d } else { ftConstFnOf(n.callFn) }
      // A method call on a holder of the set, standing as a statement, hands its value nowhere.
      if ld < 0 && ftDiscardedAt(p, x) && ftMethodRecvHolds(x, s) {
        return true
      }
      if ld < 0 || !ftRetCarries(ld, s) { return false }
      const f = nodeAt(ld)
      if !(f is FuncDecl) { return false }
      const vs: i32[] = []
      collectRetValues(f.fnBody, vs)
      return ftValuesOk(vs, s, ds, leaves, ids)
    }
    IfStmt => {
      if n.ifElse < 0 { return false }
      return ftJoinOk(x, s, ds, leaves, ids)
    }
    MatchExpr => {
      return ftJoinOk(x, s, ds, leaves, ids)
    }
    // A loop's value is the join of what its `break`s and its tail hand it.
    WhileStmt | ForIn | ForRange => {
      if lpExitsOf(x).length == 0 { return false }
      return ftJoinOk(x, s, ds, leaves, ids)
    }
    // A write gives the value it stores; `m ?? f` a map entry's id, else what `f` gives.
    BinExpr => {
      if n.binOp == "??" {
        if !ftNulOfS(nodeTyIxOf(n.binLeft), s) { return false }
        return ftIsS(n.binRight, s)
          || ftJoinAt(n.binRight, nodeTyIxOf(x), s, ds, leaves, ids)
      }
      if !ftIsStore(n) { return false }
      if ftIsS(n.binRight, s) { return true }
      return ftJoinAt(n.binRight, nodeTyIxOf(x), s, ds, leaves, ids)
    }
    // An element read of a list holding the set's ids is one of them.
    Index => {
      return true
    }
    // A field read of a record holding the set's id is that id.
    Member => {
      return ftHoldKind(nodeTyIxOf(n.memObj), s) == 2
    }
    // A call's `?.` callee is its guard's plain field read (`drwOptGuard`), so it reads the id
    // as `Member` does.
    OptMember => {
      const pc = if p >= 0 && p < P.nodes.length { nodeAt(p) } else { null }
      return pc is Call
        && pc.callFn == x
        && ftHoldKind(nonNullTy(nodeTyIxOf(n.omObj)), s) == 2
    }
    // A lambda member is its own leaf where its id can stand for it: after the elaboration, beside
    // a declared member, or written straight into the binding, where the elaboration instances
    // each call's arm at its arguments.
    FuncDecl => {
      if (
        !(ftLate
          || ftUseArrow && ftLamPlainAt(x, p, s)
          || ftDeclaredBeside(ds)
          || ftWrittenAt(x, p))
        || !i32ListHas(ds, x)
        || !ftLambdaIdOk(x)
      ) {
        return false
      }
      if ftWithinInstancedFn(x) && !ftInstLeafOk(x, p) { return false }
      if !i32ListHas(leaves, x) {
        leaves.push(x)
        ids.push(x)
      }
      return true
    }
    // No other node of a set's type is lowered as an id.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | ErrExpr | BreakStmt | ContinueStmt | RetStmt | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ImportDecl | Spread | LoopVar => {
      return false
    }
  }
}

// Whether the read `v`, or the call `v`, is of a set other than `s` whose members are all members
// of `s`, noting that set for the decision in progress (`ftSubNeed`).
function ftSubsetRead(v: i32, s: i32): boolean {
  if (
    v < 0
    || v >= P.nodes.length
    || !(nodeAt(v) is Ident || nodeAt(v) is Call)
  ) {
    return false
  }
  const o = fnTagSetOfTy(nodeTyIxOf(v))
  if o < 0 || o == s || !fnTagMembersWithin(o, s) { return false }
  if !i32ListHas(ftSubNeed, o) { ftSubNeed.push(o) }
  return true
}

// Whether a place of type `t` holds a set other than `s` with every member of `s`: tagged, or
// decided with `s`, as a join's tail is.
function ftHeldWider(t: i32, s: i32): boolean {
  const o = fnTagSetOfTy(t)
  if o < 0 || o == s || !fnTagMembersWithin(s, o) { return false }
  if fnTagSetIsTagged(o) || i32ListHas(ftAssume, o) { return true }
  if !i32ListHas(ftSubNeed, o) { ftSubNeed.push(o) }
  return true
}

// Whether write value `x` is a leaf `fnTagWriteLeavesOf` takes for `s`, or took for a wider set
// planned with it or tagged: the write stores that set's id, and its own value is the same id.
function ftWriteLeafOf(x: i32, s: i32): boolean {
  let k = 0
  while k < ftP.s.length {
    const o = ftP.s[k]
    if o != s && fnTagMembersWithin(s, o) && i32ListHas(ftP.leaves[k], x) {
      return true
    }
    k = k + 1
  }
  const t = fnTagLeafSetOf(x)
  if t >= 0 && t != s && fnTagSetIsTagged(t) && fnTagMembersWithin(s, t) {
    return true
  }
  const d = cwFnValueDeclOf(x)
  const out: i32[] = []
  const with: i32[] = []
  return d >= 0
    && fnTagWriteLeavesOf(d, s, ftHeldCur, out, with) >= 0
    && i32ListHas(out, x)
}

// Whether `x` is a list literal whose elements each carry set `s` or name one of its members
// `ds`, with `t`, the row it is re-typed to, a list of the set's ids; the names go to `leaves`.
// Where `t` is a list of such lists, each element is such a literal one level down, or a list
// literal already holding the set.
function ftInnerLeaves(
  x: i32,
  t: i32,
  s: i32,
  ds: i32[],
  leaves: i32[],
  ids: i32[],
): boolean {
  if x < 0 || x >= P.nodes.length || t < 0 || t >= T.tys.length { return false }
  const n = nodeAt(x)
  const tt = tyAt(t)
  if !(n is ArrayLit) || !(tt is TyArray) { return false }
  if fnTagSetOfTy(tyElemOf(tt)) == s {
    if !ftValuesOk(n.arrElems, s, ds, leaves, ids) { return false }
  } else if ftHoldKind(t, s) == 4 {
    for el in n.arrElems {
      const ek = ftHoldKind(nodeTyIxOf(el), s)
      const inner = if ek == 1 || ek == 4 { ftInnerLit(parenPeelIx(el)) } else { ftInnerLeaves(parenPeelIx(el), tyElemOf(tt), s, ds, leaves, ids) }
      if !inner { return false }
    }
  } else {
    return false
  }
  if !i32ListHas(ftRespine, x) {
    ftRespine.push(x)
    ftRespineTy.push(t)
  }
  return true
}

// Whether `el`, an element of a list of lists of set `s` whose element type is `et`, holds the
// set's ids itself or is a list literal of a smaller set re-typed to `et`.
function ftListElemOk(
  el: i32,
  et: i32,
  s: i32,
  ds: i32[],
  leaves: i32[],
  ids: i32[],
): boolean {
  const ek = ftHoldKind(nodeTyIxOf(el), s)
  if ek == 1 || ek == 4 { return ftInnerLit(parenPeelIx(el)) }
  const px = parenPeelIx(el)
  if px >= 0 && px < P.nodes.length && nodeAt(px) is ArrayLit {
    return ftInnerLeaves(px, et, s, ds, leaves, ids)
  }
  // A named or returned list of a smaller set within `s`, of the element's shape, holds ids
  // of that set decided with `s`, which are `s`'s (D16812).
  if !ftInnerLit(px) { return false }
  const ws: i32[] = []
  ftTySetsHeld(nodeTyIxOf(el), ws)
  if ws.length != 1 { return false }
  const o = ws[0]
  if (
    o == s
    || !fnTagMembersWithin(o, s)
    || ftHoldKind(nodeTyIxOf(el), o) != ftHoldKind(et, s)
  ) {
    return false
  }
  if i32ListHas(ftAssume, o) { return true }
  if fnTagSetIsTagged(o) { return false }
  if !i32ListHas(ftSubNeed, o) { ftSubNeed.push(o) }
  return true
}

// Whether `x` is a list literal, names a `const` bound to one, or calls a function returning one.
function ftInnerLit(x: i32): boolean {
  if x < 0 || x >= P.nodes.length { return false }
  if nodeAt(x) is ArrayLit { return true }
  const xn = nodeAt(x)
  // A call of a closed function whose inferred result is a list literal it returns directly hands
  // that literal on.
  if xn is Call {
    const fd = identDeclOf(parenPeelIx(xn.callFn))
    if fd < 0 || fd >= P.nodes.length { return false }
    const f = nodeAt(fd)
    if !(f is FuncDecl) || f.fnRet >= 0 || f.fnTyParams.length > 0 {
      return false
    }
    for q in f.fnParams {
      const qn = nodeAt(q)
      if !(qn is Param) || qn.parType < 0 { return false }
    }
    const vs: i32[] = []
    collectRetValues(f.fnBody, vs)
    if vs.length == 0 { return false }
    for v in vs {
      if v < 0 || v >= P.nodes.length || !(nodeAt(parenPeelIx(v)) is ArrayLit) {
        return false
      }
    }
    return rcwInferredRetTy(fd) == nodeTyIxOf(x)
  }
  if !(xn is Ident) { return false }
  const d = identDeclOf(x)
  if d < 0 || d >= P.nodes.length { return false }
  const dn = nodeAt(d)
  return dn is LetDecl
    && dn.letKw == "const"
    && dn.letInit >= 0
    && nodeAt(parenPeelIx(dn.letInit)) is ArrayLit
}

// Whether every tail of join `x` carries set `s` or names a member of it. A nested join of fewer
// members joins into `x`'s set, as its type does, and is re-typed there once `s` is tagged.
function ftJoinOk(
  x: i32,
  s: i32,
  ds: i32[],
  leaves: i32[],
  ids: i32[],
): boolean {
  return ftJoinAt(x, nodeTyIxOf(x), s, ds, leaves, ids)
}

// `ftJoinAt` over each field of the record literal `lit` stored as `dst`, a record holding set
// `s`: a field `dst` types at `s` joins there, a nested literal at its own field. True when `lit`
// is no literal.
function ftRecWriteJoins(
  lit: i32,
  dst: i32,
  s: i32,
  ds: i32[],
  leaves: i32[],
  ids: i32[],
): boolean {
  const lx = parenPeelIx(lit)
  const ln = if lx >= 0 && lx < P.nodes.length { nodeAt(lx) } else { null }
  if (!(ln is ObjLit || ln is ArrayLit) || dst < 0 || dst >= T.tys.length) {
    return true
  }
  const dt = tyAt(dst)
  // A list literal of records written whole stores each at the list's element (D15357).
  if ln is ArrayLit && dt is TyArray {
    if !i32ListHas(ftRespine, lx) {
      ftRespine.push(lx)
      ftRespineTy.push(dst)
    }
    // A list whose elements are the set's ids, however deep in the literal, stores each element
    // as one of them, as a field's list does one level up.
    const fe = ftListElemOfSet(dst, s)
    for el in ln.arrElems {
      if fe >= 0 {
        if !ftJoinAt(el, fe, s, ds, leaves, ids) { return false }
      } else if !ftRecWriteJoins(el, tyElemOf(dt), s, ds, leaves, ids) {
        return false
      }
    }
    return true
  }
  if !(dt is TyObj) || !(ln is ObjLit) { return true }
  for fx in ln.objFields {
    const f = nodeAt(fx)
    if f is FieldInit {
      const fi = strListIndexOf(dt.objFieldNames, f.fiName)
      const ft = if fi >= 0 { dt.objFieldTypes[fi] } else { -1 }
      const fe = ftListElemOfSet(ft, s)
      const fl = parenPeelIx(f.fiValue)
      const fln = if fl >= 0 && fl < P.nodes.length { nodeAt(fl) } else { null }
      if ft >= 0 && fnTagSetOfTy(ft) == s {
        if !ftJoinAt(f.fiValue, ft, s, ds, leaves, ids) { return false }
      } else if fe >= 0 && fln is ArrayLit {
        // A list literal of the set's ids stores each element as one of them (D15351), at any
        // depth: the binding's own literal is built at its rep, so the rows agree (D15391).
        if !i32ListHas(ftRespine, fl) {
          ftRespine.push(fl)
          ftRespineTy.push(ft)
        }
        for el in fln.arrElems {
          if !ftJoinAt(el, fe, s, ds, leaves, ids) { return false }
        }
      } else if (
        ft >= 0
        && !ftRecWriteJoins(f.fiValue, ft, s, ds, leaves, ids)
      ) {
        return false
      }
    }
  }
  return true
}

// `ftRecWriteJoins` over the literal `v` a map entry of value type `vt` takes, a record or a list
// of records, each literal re-typed to its place in `vt`.
function ftMapEntryLitJoins(
  v: i32,
  vt: i32,
  s: i32,
  ds: i32[],
  leaves: i32[],
  ids: i32[],
): boolean {
  const vx = parenPeelIx(v)
  if vx < 0 || vx >= P.nodes.length || vt < 0 || vt >= T.tys.length {
    return true
  }
  const n = nodeAt(vx)
  const t = tyAt(vt)
  if n is ArrayLit && t is TyArray {
    for el in n.arrElems {
      if !ftMapEntryLitJoins(el, tyElemOf(t), s, ds, leaves, ids) {
        return false
      }
    }
  } else if !ftRecWriteJoins(vx, vt, s, ds, leaves, ids) {
    return false
  }
  if (n is ArrayLit || n is ObjLit) && !i32ListHas(ftRespine, vx) {
    ftRespine.push(vx)
    ftRespineTy.push(vt)
  }
  return true
}

// The element of list type `t` where that element is a function of set `s`, else -1.
function ftListElemOfSet(t: i32, s: i32): i32 {
  const o = if t >= 0 && t < T.tys.length { tyAt(t) } else { null }
  return if o is TyArray && !tyElemOpen(o) && fnTagSetOfTy(tyElemOf(o)) == s { tyElemOf(o) } else { -1 }
}

// `ftJoinOk` over the value `x` a node of type `t` takes: each nested join not yet of set `s`
// is re-typed to `t`.
function ftJoinAt(
  x: i32,
  t: i32,
  s: i32,
  ds: i32[],
  leaves: i32[],
  ids: i32[],
): boolean {
  const sp: i32[] = []
  const vs: i32[] = []
  ftJoinSplit(x, sp, vs)
  for j in sp {
    if !ftIsS(j, s) && !i32ListHas(ftRespine, j) {
      ftRespine.push(j)
      ftRespineTy.push(t)
    }
  }
  return ftValuesOk(vs, s, ds, leaves, ids)
}

// The value a write of `v` into a binding of type `t` stores: where `v` reads a binding read
// nowhere else (`cwSoleReadInit`) that names a top-level function, that name, with the read and
// the binding re-typed to `t` (D15308); else `v`. Only outside an instanced function, and where
// the read and the binding are in one function, so no instance or capture sees the binding.
function ftWrittenNamedSource(v: i32, t: i32): i32 {
  let x = parenPeelIx(v)
  const own = if x >= 0 && x < P.nodes.length { recEnclosingFn(x) } else { -2 }
  if own < -1 || own >= 0 && ftInstancedFnOrIn(own) { return v }
  let hops = 0
  while hops < 8 {
    const bi = cwSoleReadInit(x)
    const xd = if bi >= 0 { identDeclOf(x) } else { -1 }
    if bi < 0 || recEnclosingFn(xd) != own {
      hops = 8
    } else if ftNamedFn(bi) >= 0 {
      ftWrittenSourceAt(v, t)
      return bi
    } else if bi < P.nodes.length && nodeAt(bi) is Ident {
      x = bi
    } else {
      hops = 8
    }
    hops = hops + 1
  }
  return v
}

// Whether function `f` is generic or open, or declared inside one (`ftWithinInstancedFn`).
function ftInstancedFnOrIn(f: i32): boolean {
  const fd = nodeAt(f)
  return fd is FuncDecl && fd.fnTyParams.length > 0
    || ftOpenFn(f)
    || ftWithinInstancedFn(f)
}

// Re-types the read `v` of a binding `cwSoleReadInit` answers, and that binding, to `t`, through
// bindings of bindings. True.
function ftWrittenSourceAt(v: i32, t: i32): boolean {
  let x = parenPeelIx(v)
  let hops = 0
  while hops < 8 && x >= 0 && x < P.nodes.length && nodeAt(x) is Ident {
    const bi = cwSoleReadInit(x)
    if bi < 0 { return true }
    for j in [x, identDeclOf(x)] {
      if !i32ListHas(ftRespine, j) {
        ftRespine.push(j)
        ftRespineTy.push(t)
      }
    }
    x = bi
    hops = hops + 1
  }
  return true
}

// Whether the value `wx` written whole into a record binding of type `t` is a read of a record
// binding no single write owns (`cwSoleReadInit` answers none) holding another function set at a
// field `t` holds one at.
function ftRecSourceKeepsRow(wx: i32, t: i32): boolean {
  if (
    wx < 0
    || wx >= P.nodes.length
    || !(nodeAt(wx) is Ident)
    || cwSoleReadInit(wx) >= 0
  ) {
    return false
  }
  return ftRecFieldSetsDiffer(nodeTyIxOf(wx), t)
}

// Whether record type `at` holds another function set than record type `t` at a field `t` holds
// one at, each field's lists peeled.
function ftRecFieldSetsDiffer(at: i32, t: i32): boolean {
  const a = if at >= 0 && at < T.tys.length { tyAt(at) } else { null }
  const b = if t >= 0 && t < T.tys.length { tyAt(t) } else { null }
  if !(a is TyObj) || !(b is TyObj) { return false }
  let i = 0
  while i < b.objFieldNames.length {
    const j = strListIndexOf(a.objFieldNames, b.objFieldNames[i])
    const bs = fnTagSetOfTy(ftListLeafOf(b.objFieldTypes[i]))
    if (
      j >= 0
      && bs >= 0
      && fnTagSetOfTy(ftListLeafOf(a.objFieldTypes[j])) != bs
    ) {
      return true
    }
    i = i + 1
  }
  return false
}

// Whether `b` is a record literal holding another function set than record type `t` at a field.
function ftSoleRecLitOther(b: i32, t: i32): boolean {
  const bx = parenPeelIx(b)
  if bx < 0 || bx >= P.nodes.length || !(nodeAt(bx) is ObjLit) { return false }
  return ftRecFieldSetsDiffer(nodeTyIxOf(bx), t)
}

// Type `t` with every list level peeled.
function ftListLeafOf(t: i32): i32 {
  let c = t
  const seen: i32[] = []
  while c >= 0 && c < T.tys.length && !i32ListHas(seen, c) {
    const a = tyAt(c)
    if !(a is TyArray) || tyElemOpen(a) { return c }
    seen.push(c)
    c = tyElemOf(a)
  }
  return c
}

// Splits join `x` into the joins it is made of, `sp`, and the values they hand on, `vs`: the arms
// of an `if` or `match`, a block's tail, and what each `break` of a loop gives it. An arm that
// exits hands this join nothing.
function ftJoinSplit(x: i32, sp: i32[], vs: i32[]) {
  const todo: i32[] = [x]
  while todo.length > 0 {
    const ls: i32[] = []
    valueTailSplit(todo.pop(), sp, ls)
    for v in ls {
      const lv = nodeAt(v)
      const xs = lpExitsOf(v)
      if (lv is WhileStmt || lv is ForIn || lv is ForRange) && xs.length > 0 {
        sp.push(v)
        for e in xs { todo.push(e) }
      } else if !(lv is BreakStmt || lv is ContinueStmt || lv is RetStmt) {
        vs.push(v)
      }
    }
  }
  return 0
}

// Whether `v` reads an un-annotated parameter of a function every call reaching which
// (`ftReachHandSets`) hands it a value of `s` or of a set within it, so a write of `v` stores one
// of `s`'s ids (D15053). A smaller set is decided with `s`.
function ftParamHandedWithin(v: i32, s: i32): boolean {
  if v < 0 || v >= P.nodes.length || !(nodeAt(v) is Ident) { return false }
  const pd = identDeclOf(v)
  if pd < 0 || pd >= P.nodes.length { return false }
  const pn = nodeAt(pd)
  if !(pn is Param) || pn.parType >= 0 { return false }
  const fd = ftParamOwner(ftDecideRoot, pd)
  if fd < 0 || fd >= P.nodes.length { return false }
  const f = nodeAt(fd)
  if !(f is FuncDecl) || ftReadInNestedFn(f.fnBody, pd) { return false }
  // A body that never runs stores nothing.
  if ftNeverRuns(fd) { return true }
  const sets = ftReachHandSets(fd, i32ListIndexOf(f.fnParams, pd), 0)
  if sets.length == 0 { return false }
  for st in sets {
    if st < 0 || st != s && !fnTagMembersWithin(st, s) { return false }
  }
  for st in sets {
    if st != s && !i32ListHas(ftSubNeed, st) { ftSubNeed.push(st) }
  }
  return true
}

// The set of the value each call reaching function `fd` hands its parameter `pi`, -1 for a value
// of no set, or [] when a reference to `fd` is neither a direct call nor handed to an un-annotated
// parameter only ever called, whose calls are read the same way (D15017).
function ftReachHandSets(fd: i32, pi: i32, depth: i32): i32[] {
  const none: i32[] = []
  if depth > 4 || fd < 0 || fd >= P.nodes.length || declIsExportedFn(fd) {
    return none
  }
  ftDirectCountsGrow()
  const at = ftHandedAt[fd] ?? []
  const calls = ftDirectCalls[fd] ?? 0
  const refs = ftDirectRefs[fd] ?? 0
  const lits = ftListedAt[fd] ?? []
  if refs == 0 || refs != calls + at.length / 2 + lits.length { return none }
  // A call in a named function nothing references and nothing exports never runs, so it hands
  // nothing; one handing on its caller's un-annotated parameter hands what reaches that one.
  const out: i32[] = []
  const hs = fnParamHandSets(fd, pi)
  const froms = fnParamHandFromsOf(fd, pi)
  const args = fnParamHandArgsOf(fd, pi)
  let hi = 0
  while hi < hs.length {
    const fr = if hi < froms.length { froms[hi] } else { -1 }
    const q = if hs[hi] < 0 && hi < args.length { ftParamIndexIn(fr, args[hi]) } else { -1 }
    if ftNeverRuns(fr) {
      hi = hi + 1
      continue
    }
    if q >= 0 {
      const sub = ftReachHandSets(fr, q, depth + 1)
      if sub.length == 0 { return none }
      for st in sub { out.push(st) }
    } else {
      out.push(hs[hi])
    }
    hi = hi + 1
  }
  if calls > 0 && hs.length == 0 { return none }
  // A `const` list literal holding `fd`, read only as the callee of a call through an element,
  // hands each such call's argument (D15053's stored spelling).
  for lit in lits {
    const ld = ftLitLet[lit] ?? -1
    const ln = if ld >= 0 && ld < P.nodes.length { nodeAt(ld) } else { nodeAt(lit) }
    if !(ln is LetDecl) || ln.letKw != "const" || declHasExportKw(ld) {
      return none
    }
    const ecs = ftLetElemCalls[ld] ?? []
    if ecs.length == 0 || (ftLetRefs[ld] ?? 0) != ecs.length { return none }
    for ec in ecs {
      const cn = nodeAt(ec)
      if !(cn is Call) || pi >= cn.callArgs.length { return none }
      const ax = parenPeelIx(cn.callArgs[pi])
      const ad = if ax >= 0 && ax < P.nodes.length && nodeAt(ax) is Ident { identDeclOf(ax) } else { -1 }
      if ad >= 0 && ad < P.nodes.length && nodeAt(ad) is Param { return none }
      out.push(fnTagSetOfTy(nodeTyIxOf(ax)))
    }
  }
  // Each parameter `fd` is handed to, `[function, index, ...]`, read once.
  const seen: i32[] = []
  let k = 0
  while k + 1 < at.length {
    const c = nodeAt(at[k])
    const h = if c is Call { identFnDeclOf(c.callFn) } else { -1 }
    let dup = false
    let m = 0
    while m + 1 < seen.length {
      if seen[m] == h && seen[m + 1] == at[k + 1] { dup = true }
      m = m + 2
    }
    if dup {
      k = k + 2
      continue
    }
    seen.push(h)
    seen.push(at[k + 1])
    const hf = nodeAt(if h >= 0 { h } else { at[k] })
    if !(hf is FuncDecl) || at[k + 1] >= hf.fnParams.length { return none }
    const pj = hf.fnParams[at[k + 1]]
    const pn = nodeAt(pj)
    if !(pn is Param) || pn.parType >= 0 || ftReadInNestedFn(hf.fnBody, pj) {
      return none
    }
    const pcs = ftParamCalls[pj] ?? []
    if pcs.length == 0 || (ftParamRefs[pj] ?? 0) != pcs.length { return none }
    for pc in pcs {
      const cn = nodeAt(pc)
      if !(cn is Call) || pi >= cn.callArgs.length { return none }
      const ax = parenPeelIx(cn.callArgs[pi])
      const ad = if ax >= 0 && nodeAt(ax) is Ident { identDeclOf(ax) } else { -1 }
      const q = if ad >= 0 { i32ListIndexOf(hf.fnParams, ad) } else { -1 }
      const qn = nodeAt(if q >= 0 { ad } else { pc })
      if qn is Param && qn.parType < 0 {
        const sub = ftReachHandSets(h, q, depth + 1)
        if sub.length == 0 { return none }
        for st in sub { out.push(st) }
      } else {
        out.push(fnTagSetOfTy(nodeTyIxOf(ax)))
      }
    }
    k = k + 2
  }
  return out
}

// The position of the un-annotated parameter of declaration `fr` that read `a` names, or -1.
function ftParamIndexIn(fr: i32, a: i32): i32 {
  if fr < 0 || fr >= P.nodes.length || a < 0 || a >= P.nodes.length {
    return -1
  }
  const f = nodeAt(fr)
  if !(f is FuncDecl) || !(nodeAt(a) is Ident) { return -1 }
  const ad = identDeclOf(a)
  // A `const` copy of the parameter hands on the parameter's value.
  const cp = if ad >= 0 && ad < P.nodes.length { fnTagParamCopyOf(f, ad) } else { -1 }
  const pd = if cp >= 0 { cp } else { ad }
  const pn = if pd >= 0 && pd < P.nodes.length { nodeAt(pd) } else { f }
  if (
    !(pn is Param)
    || pn.parType >= 0
    || ftReadInNestedFn(f.fnBody, pd)
    || cp >= 0 && ftReadInNestedFn(f.fnBody, ad)
  ) {
    return -1
  }
  return i32ListIndexOf(f.fnParams, pd)
}

// Whether `fr` is a named function no name reads and that is not exported, so its body never
// runs.
function ftNeverRuns(fr: i32): boolean {
  if fr < 0 || fr >= P.nodes.length || declIsExportedFn(fr) { return false }
  const f = nodeAt(fr)
  if !(f is FuncDecl) || f.fnName == "" { return false }
  ftDirectCountsGrow()
  return (ftDirectRefs[fr] ?? 0) == 0
}

// Per function, the names reading it, the calls naming it as their callee, and each call handing
// it as an argument with the argument's position (`[call, index, ...]`); per parameter, the names
// reading it and the calls naming it as their callee. Counted over the arena's first
// `ftDirectLen` nodes; the decision in progress starts them again.
let ftDirectLen = 0
let ftDirectRefs: {[i32]: i32} = Map()
let ftDirectCalls: {[i32]: i32} = Map()
let ftHandedAt: {[i32]: i32[]} = Map()
let ftParamRefs: {[i32]: i32} = Map()
let ftParamCalls: {[i32]: i32[]} = Map()
// Per function, the list literals naming it as an element; per list literal, the `let` it
// initialises; per `let`, the names reading it and the calls through an element of it.
let ftListedAt: {[i32]: i32[]} = Map()
let ftLitLet: {[i32]: i32} = Map()
let ftLetRefs: {[i32]: i32} = Map()
let ftLetElemCalls: {[i32]: i32[]} = Map()

let ftCheckLen = -1

// The arena's length at the check's own tag decision, -1 before one ran.
export function fnTagCheckLen(): i32 { return ftCheckLen }

// Counts the nodes added since `ftDirectLen` into the tables above.
function ftDirectCountsGrow() {
  let x = ftDirectLen
  while x < P.nodes.length {
    const n = nodeAt(x)
    match n {
      Ident => {
        const d = identFnDeclOf(x)
        if d >= 0 { ftDirectRefs[d] = (ftDirectRefs[d] ?? 0) + 1 }
        const pd = identDeclOf(x)
        if pd >= 0 && pd < P.nodes.length && nodeAt(pd) is Param {
          ftParamRefs[pd] = (ftParamRefs[pd] ?? 0) + 1
        }
        if pd >= 0 && pd < P.nodes.length && nodeAt(pd) is LetDecl {
          ftLetRefs[pd] = (ftLetRefs[pd] ?? 0) + 1
        }
      }
      Call => {
        const cf = n.callFn
        const isId = cf >= 0 && cf < P.nodes.length && nodeAt(cf) is Ident
        const d = if isId { identFnDeclOf(cf) } else { -1 }
        if d >= 0 { ftDirectCalls[d] = (ftDirectCalls[d] ?? 0) + 1 }
        const pd = if isId { identDeclOf(cf) } else { -1 }
        if pd >= 0 && pd < P.nodes.length && nodeAt(pd) is Param {
          const pcs = ftParamCalls[pd] ?? []
          pcs.push(x)
          ftParamCalls[pd] = pcs
        }
        // A call through an element of a `let`: `fs[i](...)`.
        const ixn = if cf >= 0 && cf < P.nodes.length { nodeAt(parenPeelIx(cf)) } else { n }
        const base = if ixn is Index { parenPeelIx(ixn.idxArr) } else { -1 }
        const bd = if base >= 0 && base < P.nodes.length && nodeAt(base) is Ident { identDeclOf(base) } else { -1 }
        if bd >= 0 && bd < P.nodes.length && nodeAt(bd) is LetDecl {
          const ecs = ftLetElemCalls[bd] ?? []
          ecs.push(x)
          ftLetElemCalls[bd] = ecs
        }
        let i = 0
        while d >= 0 && i < n.callArgs.length {
          const a = n.callArgs[i]
          const ad = if a >= 0 && a < P.nodes.length && nodeAt(a) is Ident { identFnDeclOf(a) } else { -1 }
          if ad >= 0 {
            const at = ftHandedAt[ad] ?? []
            at.push(x)
            at.push(i)
            ftHandedAt[ad] = at
          }
          i = i + 1
        }
      }
      ArrayLit => {
        for e in n.arrElems {
          const ed = if e >= 0 && e < P.nodes.length && nodeAt(e) is Ident { identFnDeclOf(e) } else { -1 }
          if ed >= 0 {
            const ls = ftListedAt[ed] ?? []
            ls.push(x)
            ftListedAt[ed] = ls
          }
        }
      }
      LetDecl => {
        const li = parenPeelIx(n.letInit)
        if li >= 0 && li < P.nodes.length && nodeAt(li) is ArrayLit {
          ftLitLet[li] = x
        }
      }
      // No other node names a function.
      NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Member | OptMember | Paren | ErrExpr | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
    }
    x = x + 1
  }
  ftDirectLen = x
  return 0
}

// Whether a function nested in the body at `body` reads declaration `pd`.
function ftReadInNestedFn(body: i32, pd: i32): boolean {
  const xs: i32[] = [body]
  const ins: boolean[] = [false]
  while xs.length > 0 {
    const x = xs.pop() ?? -1
    const inFn = ins.pop() ?? false
    if x >= 0 && x < P.nodes.length {
      const n = nodeAt(x)
      if inFn && n is Ident && identDeclOf(x) == pd { return true }
      const deeper = inFn || n is FuncDecl
      for c in nodeChildren(x) {
        xs.push(c)
        ins.push(deeper)
      }
    }
  }
  return false
}

// Each parameter under the root → the function declaring it, built once per decision.
let ftParamOwners: {[i32]: i32} = Map()
let ftParamOwnersBuilt = false
// The root the decision in progress walks, for a question asked without it.
let ftDecideRoot = 0 - 1

// The function under `rootIx` declaring parameter `pd`, or -1.
function ftParamOwner(rootIx: i32, pd: i32): i32 {
  if !ftParamOwnersBuilt {
    ftParamOwnersBuilt = true
    const todo: i32[] = [rootIx]
    while todo.length > 0 {
      const x = todo.pop() ?? -1
      if x >= 0 && x < P.nodes.length {
        const n = nodeAt(x)
        if n is FuncDecl {
          for q in n.fnParams { ftParamOwners[q] = x }
        }
        nodeChildrenPush(x, todo)
      }
    }
  }
  return ftParamOwners[pd] ?? -1
}

// Whether the set being decided is held by a written `let`, whose writes a call must agree on.
let ftWideSeen = false

// The nested joins the set being decided re-types, with the type each takes.
let ftRespine: i32[] = []
let ftRespineTy: i32[] = []

// Whether each value in `vs` carries set `s` itself or names one of its members `ds`; the
// member names go to `leaves`, once each.
function ftValuesOk(
  vs: i32[],
  s: i32,
  ds: i32[],
  leaves: i32[],
  ids: i32[],
): boolean {
  for v in vs {
    if !ftIsS(v, s) {
      // A lambda member written is its own leaf, as `ftNodeOk` takes one read.
      const d = if ftLambdaLeaf(v, ds) { v } else { ftLeafMember(v, ds) }
      if d < 0 && ftSubsetRead(v, s) { continue }
      if d < 0 && ftParamHandedWithin(v, s) { continue }
      if d < 0 { return false }
      if !i32ListHas(leaves, v) {
        leaves.push(v)
        ids.push(d)
      }
    }
  }
  return true
}

// Whether `v`, a value a write, a join or a return gives the set, is a lambda member whose id can
// stand for it, each call's arm instanced by the elaboration. One written inside a generic or
// hole function is a value per instance, which one id cannot name.
function ftLambdaLeaf(v: i32, ds: i32[]): boolean {
  return i32ListHas(ds, v)
    && nodeAt(v) is FuncDecl
    && ftLambdaIdOk(v)
    && (!ftWithinInstancedFn(v) || ftInstLeafOk(v, -1))
}

// Whether lambda `x`, written by `p` (-1: by any write) into a `let` of the function declaring it,
// is a value only that function's instance holds: the binding is written only in that function's
// own body and every read of it is a call, so each instance makes and dispatches its own ids.
function ftInstLeafOk(x: i32, p: i32): boolean {
  if x < 0 || x >= P.nodes.length { return false }
  const f = fnDeclParent[x] ?? -1
  if f < 0 || f >= P.nodes.length { return false }
  const fd = nodeAt(f)
  if !(fd is FuncDecl) { return false }
  const b = ftLeafBinding(x, p, fd.fnBody)
  if b < 0 { return false }
  const xs: i32[] = [fd.fnBody]
  const ps: i32[] = [-1]
  const ins: boolean[] = [false]
  // The body's own `let`s, and the bindings a read of `b` is copied into.
  const own: Map<i32, boolean> = Map()
  const into: i32[] = []
  while xs.length > 0 {
    const c = xs.pop() ?? -1
    const cp = ps.pop() ?? -1
    const inFn = ins.pop() ?? false
    if c >= 0 && c < P.nodes.length {
      const n = nodeAt(c)
      if c == b && inFn { return false }
      if n is LetDecl && n.letKw == "let" && !inFn { own[c] = true }
      const cpn = if cp >= 0 { nodeAt(cp) } else { n }
      const copied = if (n is Ident
        && identDeclOf(c) == b
        && !inFn
        && cpn is BinExpr
        && ftIsStore(cpn)
        && cpn.binRight == c
        && nodeAt(parenPeelIx(cpn.binLeft)) is Ident) { identDeclOf(parenPeelIx(cpn.binLeft)) } else { -1 }
      // A read seeding a `let` of this body copies the id into that `let` (D15434).
      const seeded = if n is Ident
        && identDeclOf(c) == b
        && !inFn
        && cpn is LetDecl
        && cpn.letKw == "let"
        && parenPeelIx(cpn.letInit) == c
        && !cwLetWrittenInClosure(cp) { cp } else { -1 }
      if seeded >= 0 { into.push(seeded) }
      if copied >= 0 { into.push(copied) }
      if (
        n is Ident
        && identDeclOf(c) == b
        && copied < 0
        && seeded < 0
        && !ftInstLeafReadOk(c, cp, inFn)
        && !(!inFn && ftSeedsCellAt(c, cp))
      ) {
        return false
      }
      // A function declared in this body whose every use is a call runs in this instance only, so
      // its reads and writes of the binding are the instance's own (slice 4b-ii, D15436).
      const deeper = inFn || n is FuncDecl && !ftWriterStays(c, f)
      for k in nodeChildren(c) {
        xs.push(k)
        ps.push(c)
        ins.push(deeper)
      }
    }
  }
  // A copy into another binding keeps the id in the instance only when that binding is the body's.
  for t in into {
    if t != b && !(own[t] ?? false) { return false }
  }
  return true
}

// Whether nested declaration `w`, declared directly in `f`'s body, is used only as a callee there:
// no value of it leaves the instance of `f` that declares it.
function ftWriterStays(w: i32, f: i32): boolean {
  const wn = nodeAt(w)
  if !(wn is FuncDecl) || wn.fnName == "" || (elabEncl[w] ?? -1) != f {
    return false
  }
  cwIxWant()
  const ow = cwOccWalk(w)
  while cwOccNext(ow) {
    const u = cwIxNode[ow.row]
    if cwIxKind[ow.row] == CW_OCC_USE {
      const q = if u >= 0 && u < cwIxParent.length { cwIxParent[u] } else { -1 }
      const qn = if q >= 0 && q < P.nodes.length { nodeAt(q) } else { null }
      if !(qn is Call) || qn.callFn != u { return false }
    }
  }
  return true
}

// The `let` lambda `x` is written into by `p`, or by the first write of it under `body` when `p`
// is -1; -1 for none.
function ftLeafBinding(x: i32, p: i32, body: i32): i32 {
  if p >= 0 && p < P.nodes.length {
    const pn = nodeAt(p)
    if (
      pn is LetDecl
      && pn.letInit == x
      && (pn.letKw == "let" || ftConstSeedsCell(p) || ftConstSeedsLets(p))
    ) {
      return p
    }
    if (
      pn is BinExpr
      && ftIsStore(pn)
      && pn.binRight == x
      && nodeAt(pn.binLeft) is Ident
    ) {
      return identDeclOf(pn.binLeft)
    }
    return -1
  }
  const xs: i32[] = [body]
  while xs.length > 0 {
    const c = xs.pop() ?? -1
    if c >= 0 && c < P.nodes.length {
      for k in nodeChildren(c) {
        if k == x { return ftLeafBinding(x, c, body) }
        xs.push(k)
      }
    }
  }
  return -1
}

// Whether read `r` of the binding, under parent `p`, keeps its id in the instance: a call through
// it, or a write of it outside any nested function.
function ftInstLeafReadOk(r: i32, p: i32, inFn: boolean): boolean {
  if p < 0 || p >= P.nodes.length { return false }
  const pn = nodeAt(p)
  if pn is Call { return pn.callFn == r }
  if !(pn is BinExpr) || !ftIsStore(pn) || inFn { return false }
  // A write of the binding, or a write of its own value back into it.
  if pn.binLeft == r { return true }
  const l = parenPeelIx(pn.binLeft)
  if l < 0 || l >= P.nodes.length { return false }
  return pn.binRight == r
    && nodeAt(l) is Ident
    && identDeclOf(l) == identDeclOf(r)
}

// Whether lambda `x` is the value its parent `p` writes into a binding: a `let`'s initialiser or
// a store's right side, so the binding's reads are the only names it has. A `const`'s counts where
// it seeds a `let` a nested function writes, whose cell the lambda is a peer of (D15435).
function ftWrittenAt(x: i32, p: i32): boolean {
  if p < 0 || p >= P.nodes.length { return false }
  const pn = nodeAt(p)
  match pn {
    LetDecl => {
      return pn.letInit == x && (pn.letKw == "let" || ftConstSeedsCell(p))
    }
    BinExpr => {
      return ftIsStore(pn) && pn.binRight == x
    }
    // Any other parent names the lambda some other way, or reads it.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | Call | Member | OptMember | Paren | ErrExpr | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {
      return false
    }
  }
}

// Whether set members `ds` include a declared function, beside which a lambda reached through
// another name is a leaf before the elaboration's decision too.
function ftDeclaredBeside(ds: i32[]): boolean {
  for d in ds {
    if ftNamedDecl(d) { return true }
  }
  return false
}

// Whether `x` is declared inside a generic or hole function, whose body each instance re-checks.
export function ftWithinInstancedFn(x: i32): boolean {
  let f = fnDeclParent[x] ?? -1
  let hops = 0
  while f >= 0 && hops < 64 {
    const fd = if f < P.nodes.length { nodeAt(f) } else { null }
    if fd is FuncDecl && fd.fnTyParams.length > 0 { return true }
    if ftOpenFn(f) { return true }
    f = fnDeclParent[f] ?? -1
    hops = hops + 1
  }
  return false
}

// The member of `ds` the name at `v` reads, or -1; a local `const` reads its initialiser, a
// lambda member among them where its id can stand for it.
function ftLeafMember(v: i32, ds: i32[]): i32 {
  const src = ftConstSource(v, 8)
  const d = ftNamedFn(src)
  if d >= 0 { return if i32ListHas(ds, d) { d } else { -1 } }
  if src != v && src >= 0 && ftLambdaLeaf(src, ds) { return src }
  // A function declared inside another names a member where its id can stand for it.
  const r = if src >= 0 && nodeAt(src) is Ident { identDeclOf(src) } else { -1 }
  const f = if r >= 0 && i32ListHas(ds, r) { nodeAt(r) } else { null }
  if !(f is FuncDecl) || f.fnName == "" || !ftLambdaIdOk(r) { return -1 }
  return r
}

// The node a name at `v` takes its value from: the initialiser of the local `const` it reads,
// followed at most `depth` times, else `v` itself.
function ftConstSource(v: i32, depth: i32): i32 {
  if depth <= 0 || v < 0 || v >= P.nodes.length || !(nodeAt(v) is Ident) {
    return v
  }
  const r = identDeclOf(v)
  if r < 0 || r >= P.nodes.length { return v }
  const rn = nodeAt(r)
  if !(rn is LetDecl) || rn.letInit < 0 { return v }
  if rn.letKw != "const" && !cwLetUnwritten(r) { return v }
  return ftConstSource(parenPeelIx(rn.letInit), depth - 1)
}

// The node call `c`'s callee takes its value from, through local `const` aliases: the instance an
// alias's call reaches is keyed as the named call's is.
function ftCalleeSource(c: Call): i32 {
  const f = parenPeelIx(c.callFn)
  return ftConstSource(f, 8)
}

// The function callee `v` names: any declared one, since a nested declaration's calls are noted
// under it as a top-level's are; else `ftNamedFn`.
function ftCalleeFn(v: i32): i32 {
  if v >= 0 && v < P.nodes.length && nodeAt(v) is Ident {
    const nd = identDeclOf(v)
    if nd >= 0 && nd < P.nodes.length && nodeAt(nd) is FuncDecl { return nd }
  }
  return ftNamedFn(v)
}

// The top-level function the name at `v` reads, or -1 when it is no name of one.
function ftNamedFn(v: i32): i32 {
  if v < 0 || v >= P.nodes.length { return -1 }
  const n = nodeAt(v)
  if !(n is Ident) { return -1 }
  const r = identDeclOf(v)
  // A function nested in another, capturing nothing, is found by the name's own declaration.
  if r >= 0 && r < P.nodes.length {
    const rn = nodeAt(r)
    if (
      rn is FuncDecl
      && rn.fnName == n.identName
      && !(fnDeclIx.has(n.identName))
      && ftLambdaIdOk(r)
    ) {
      return r
    }
  }
  const d = fnDeclIx[n.identName] ?? -1
  if d < 0 { return -1 }
  if r >= 0 && r != d { return -1 }
  if r < 0 && elabFnIdOf(nodeTyIxOf(v)) != d { return -1 }
  return d
}

// The named function the callee read `v` declares, nested or not, capturing or not; -1 for any
// other callee.
function ftNestedCalleeDecl(v: i32): i32 {
  const x = parenPeelIx(v)
  if x < 0 || x >= P.nodes.length { return -1 }
  const n = nodeAt(x)
  if !(n is Ident) { return -1 }
  const r = identDeclOf(x)
  if r < 0 || r >= P.nodes.length { return -1 }
  const rn = nodeAt(r)
  return if rn is FuncDecl && rn.fnName == n.identName { r } else { -1 }
}

// The lambda, or the named function an un-annotated `const` aliases, that a `const` read `v` is
// bound to, whose calls run it (D15471); -1 otherwise.
function ftConstFnOf(v: i32): i32 {
  const r = parenPeelIx(v)
  if r < 0 || r >= P.nodes.length || !(nodeAt(r) is Ident) { return -1 }
  const bd = identDeclOf(r)
  if bd < 0 || bd >= P.nodes.length { return -1 }
  const b = nodeAt(bd)
  if !(b is LetDecl) || b.letKw != "const" || b.letInit < 0 { return -1 }
  const li = parenPeelIx(b.letInit)
  if li < 0 || li >= P.nodes.length { return -1 }
  const f = nodeAt(li)
  if f is FuncDecl && f.fnName == "" { return li }
  if !(f is Ident) || b.letType >= 0 { return -1 }
  const fd = identDeclOf(li)
  return if fd >= 0 && fd < P.nodes.length && nodeAt(fd) is FuncDecl { fd } else { -1 }
}

// Whether function `x` (a lambda or a named function's read) initialises the un-annotated `const`
// node `p`, and every read of that binding is a call's callee: what a call hands back is the
// function's result, and nothing holds the function itself (D15457).
function ftConstFnOnlyCalled(x: i32, p: i32): boolean {
  if p < 0 || p >= P.nodes.length { return false }
  const b = nodeAt(p)
  if !(b is LetDecl) || b.letKw != "const" || b.letType >= 0 { return false }
  if parenPeelIx(b.letInit) != x { return false }
  const f = nodeAt(x)
  const named = f is Ident
    && identDeclOf(x) >= 0
    && nodeAt(identDeclOf(x)) is FuncDecl
  if !named && (!(f is FuncDecl) || f.fnName != "") { return false }
  cwIxWant()
  const callees: i32[] = []
  const cw = cwOccWalk(p)
  while cwOccNext(cw) {
    const m = nodeAt(cwIxNode[cw.row])
    if cwIxKind[cw.row] == CW_OCC_CALL && m is Call {
      callees.push(parenPeelIx(m.callFn))
    }
  }
  const uw = cwOccWalk(p)
  while cwOccNext(uw) {
    if (
      cwIxKind[uw.row] == CW_OCC_USE
      && !i32ListHas(callees, cwIxNode[uw.row])
    ) {
      return false
    }
  }
  return true
}

// Whether argument `x` of call `c` binds a parameter of set `s` itself, of a lambda called in
// place, or an un-annotated parameter of a named function, whose instance at the call takes the
// set as that parameter's type: a binding, as a `let` is.
function ftParamOfSet(c: Call, x: i32, s: i32): boolean {
  const f = parenPeelIx(c.callFn)
  if ftHoleParamOf(c, x, s) { return true }
  if f < 0 || !(nodeAt(f) is FuncDecl) { return false }
  const fty = nodeTyIxOf(f)
  if fty < 0 || fty >= T.tys.length { return false }
  const ft = tyAt(fty)
  if !(ft is TyFunc) { return false }
  let i = 0
  while i < c.callArgs.length && i < ft.fnParamTypes.length {
    if c.callArgs[i] == x { return fnTagSetOfTy(ft.fnParamTypes[i]) == s }
    i = i + 1
  }
  return false
}

// Whether `x` is an argument of call `c` through an element of a `const` list literal of named
// functions, each taking it at an un-annotated parameter that only `s` reaches: each member's
// instance binds it to what the call hands, as a direct call's does (`ftLateParamOk` after the
// elaboration).
function ftListCallHoleArg(c: Call, x: i32, s: i32): boolean {
  const cf = parenPeelIx(c.callFn)
  if cf < 0 || cf >= P.nodes.length { return false }
  const cn = nodeAt(cf)
  if !(cn is Index) { return false }
  const b = parenPeelIx(cn.idxArr)
  if b < 0 || b >= P.nodes.length || !(nodeAt(b) is Ident) { return false }
  const ld = identDeclOf(b)
  const ln = if ld >= 0 && ld < P.nodes.length { nodeAt(ld) } else { cn }
  if !(ln is LetDecl) || ln.letKw != "const" || declHasExportKw(ld) {
    return false
  }
  // Read only as the base of a call through an element: nothing else adds to or reads the list.
  ftDirectCountsGrow()
  const ecs = ftLetElemCalls[ld] ?? []
  if ecs.length == 0 || (ftLetRefs[ld] ?? 0) != ecs.length { return false }
  const li = parenPeelIx(ln.letInit)
  const lit = if li >= 0 && li < P.nodes.length { nodeAt(li) } else { cn }
  if !(lit is ArrayLit) || lit.arrElems.length == 0 { return false }
  const i = i32ListIndexOf(c.callArgs, x)
  if i < 0 || i < c.callArgNames.length && c.callArgNames[i] != "" {
    return false
  }
  for e in lit.arrElems {
    const d = if e >= 0 && e < P.nodes.length && nodeAt(e) is Ident { identFnDeclOf(e) } else { -1 }
    const f = if d >= 0 { nodeAt(d) } else { cn }
    if !(f is FuncDecl) || f.fnName == "" || i >= f.fnParams.length {
      return false
    }
    const pn = nodeAt(f.fnParams[i])
    if !(pn is Param) || pn.parType >= 0 { return false }
    // No call reaching the member hands that parameter a set outside `s`, so the element's one
    // closure signature holds `s`'s id (D15019).
    const hs = ftReachHandSets(d, i, 0)
    if hs.length == 0 { return false }
    for st in hs {
      if st < 0 || st != s && !fnTagMembersWithin(st, s) { return false }
    }
  }
  return true
}

// Whether argument `x` of call `c`, carrying set `s`, binds a positional, un-annotated parameter
// of the named top-level function `c` calls.
function ftHoleParamOf(c: Call, x: i32, s: i32): boolean {
  const d = ftCalleeFn(ftCalleeSource(c))
  if d < 0 { return false }
  const f = nodeAt(d)
  if !(f is FuncDecl) { return false }
  let i = 0
  while i < c.callArgs.length && i < f.fnParams.length {
    if c.callArgs[i] == x {
      if i < c.callArgNames.length && c.callArgNames[i] != "" { return false }
      const pn = nodeAt(f.fnParams[i])
      // A parameter the body writes into a holder's slot lands in that holder's rep, which an
      // instance types and this decision does not see (D15065).
      if (
        pn is Param
        && pn.parType < 0
        && ftParamStored(f, f.fnParams[i], d, i, c, s)
      ) {
        return false
      }
      return pn is Param
        && (pn.parType < 0
        || ftOwnTyParamJoins(d, f, i, c.callArgs)
        || ftArgIsParam(c, i) && ftTyParamOfHeldList(f, i, c.callArgs, s))
    }
    i = i + 1
  }
  return false
}

// Whether parameter `i` of `f` is annotated with a bare own type parameter `T` that another
// parameter annotates `T[]`, handed in `args` (the call's arguments in parameter order, all
// positional) a list whose element carries set `s`: the call binds `T` to `s`, so the argument at
// `i` lands as one of its ids.
function ftTyParamOfHeldList(
  f: FuncDecl,
  i: i32,
  args: i32[],
  s: i32,
): boolean {
  if i < 0 || i >= f.fnParams.length || i >= args.length { return false }
  const pn = nodeAt(f.fnParams[i])
  const tn = if pn is Param && pn.parType >= 0 { nodeAt(pn.parType) } else { null }
  if !(tn is TypeRef) || !strListHas(f.fnTyParams, tn.tyName) { return false }
  let k = 0
  while k < f.fnParams.length && k < args.length {
    const q = nodeAt(f.fnParams[k])
    const qt = if k != i && q is Param && q.parType >= 0 { nodeAt(q.parType) } else { null }
    if qt is TypeRef && qt.tyName == tn.tyName + "[]" {
      const t = nodeTyIxOf(args[k])
      const h = if t >= 0 && t < T.tys.length { tyAt(t) } else { null }
      if h is TyArray && fnTagSetOfTy(tyElemOf(h)) == s { return true }
    }
    k = k + 1
  }
  return false
}

// The arguments of call `cx` in its declared callee's parameter order, a method call's receiver
// first; [] when one is named or spread, or the callee is not resolved.
function ftParamOrderArgs(cx: i32): i32[] {
  const none: i32[] = []
  if cx < 0 || cx >= P.nodes.length { return none }
  const c = nodeAt(cx)
  if !(c is Call) { return none }
  let j = 0
  while j < c.callArgs.length {
    if !ftArgIsParam(c, j) { return none }
    j = j + 1
  }
  const cf = nodeAt(parenPeelIx(c.callFn))
  if !(cf is Member) { return c.callArgs }
  const d = elabCallDeclOf(cx)
  const f = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if !(f is FuncDecl) || f.fnParams.length != c.callArgs.length + 1 {
    return none
  }
  const out: i32[] = [parenPeelIx(cf.memObj)]
  for a in c.callArgs { out.push(a) }
  return out
}

// Whether `f`'s body writes a read of parameter `par`, or of a `const` copy of it, into a holder's
// slot, as a `push` or `set` argument or through a list literal a copy reads element by element:
// the holder's rep is an instance's, which a binding or literal of the body is not (D15130,
// D15131).
function ftParamStored(
  f: FuncDecl,
  par: i32,
  fd: i32,
  pi: i32,
  c: Call,
  s: i32,
): boolean {
  // The `const` lists whose literal holds a read of `par`.
  const lists: i32[] = []
  const ls: i32[] = [f.fnBody]
  while ls.length > 0 {
    const x = ls.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      const xn = nodeAt(x)
      if xn is LetDecl && ftLitHoldsParam(f, xn.letInit, par) { lists.push(x) }
      nodeChildrenPush(x, ls)
    }
  }
  const xs: i32[] = [f.fnBody]
  const ps: i32[] = [-1]
  const gs: i32[] = [-1]
  while xs.length > 0 {
    const x = xs.pop() ?? -1
    const p = ps.pop() ?? -1
    const g = gs.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      const xn = nodeAt(x)
      if xn is Ident && p >= 0 && p < P.nodes.length {
        const d = identDeclOf(x)
        const pn = nodeAt(p)
        if d == par || fnTagParamCopyOf(f, d) == par {
          // A record literal whose row is built with a closure at this field stores the
          // member's closure, which an id handed in is not (D16738).
          if (
            pn is FieldInit
            && pn.fiValue == x
            && ftLitFieldClosure(g, pn.fiName)
          ) {
            return true
          }
          if pn is Call && i32ListHas(pn.callArgs, x) {
            const cm = nodeAt(parenPeelIx(pn.callFn))
            if cm is Member && (cm.memProp == "push" || cm.memProp == "set") {
              // A store into a holder call `c` hands this set's holder of ids is an id, as is a
              // push onto the parameter's own list.
              if (
                !ftStoreIntoHandedSet(f, cm, c, s)
                && !ftPushIntoParamList(f, cm, par)
              ) {
                return true
              }
            }
          }
        }
        // A list holding it, copied element by element into a closed holder (D15131).
        // One every call reaching it binds to one set is copied through its adapter's call, at
        // each instance's own id (D15432).
        if (
          i32ListHas(lists, d)
          && pn is Member
          && fvaListCopyAt(p)
          && ftReachHandsOne(fd, pi) < 0
        ) {
          return true
        }
      }
      for k in nodeChildren(x) {
        xs.push(k)
        ps.push(x)
        gs.push(p)
      }
    }
  }
  return false
}

// Whether field `name` of record literal `g` is, in the record its row is built at, a function
// type carrying no set: a closure field.
function ftLitFieldClosure(g: i32, name: string): boolean {
  if g < 0 || g >= P.nodes.length || !(nodeAt(g) is ObjLit) { return false }
  const ft = tyFieldTyOf(nodeRepTyIxOf(g), name)
  return ft >= 0
    && ft < T.tys.length
    && tyAt(ft) is TyFunc
    && fnTagSetOfTy(ft) < 0
}

// Whether slot write `cm` pushes onto a list of `f`'s that holds reads of parameter `par` alone
// (`elabListParamSource`): its slots are the literal's, which this decision types with the set.
function ftPushIntoParamList(f: FuncDecl, cm: Member, par: i32): boolean {
  if cm.memProp != "push" { return false }
  const o = parenPeelIx(cm.memObj)
  if o < 0 || o >= P.nodes.length || !(nodeAt(o) is Ident) { return false }
  return elabListParamSource(identDeclOf(o), f) == par
}

// Whether the receiver of slot write `cm` (`push` or `set`) in `f` is a parameter of `f` that call
// `c` hands, positionally, a list or map whose element or value carries set `s`.
function ftStoreIntoHandedSet(
  f: FuncDecl,
  cm: Member,
  c: Call,
  s: i32,
): boolean {
  const o = parenPeelIx(cm.memObj)
  if o < 0 || !(nodeAt(o) is Ident) { return false }
  const j = i32ListIndexOf(f.fnParams, identDeclOf(o))
  if j < 0 || !ftArgIsParam(c, j) { return false }
  const t = nodeTyIxOf(c.callArgs[j])
  if t < 0 || t >= T.tys.length { return false }
  const h = tyAt(t)
  if cm.memProp == "push" && h is TyArray {
    return fnTagSetOfTy(tyElemOf(h)) == s
  }
  if cm.memProp == "set" && h is TyMap { return fnTagSetOfTy(tyValOf(h)) == s }
  return false
}

// Whether `f`'s body copies a `const` list literal holding a read of parameter `par` element by
// element into a closed holder (D15131), the store D15432's adapter makes through each element.
export function ftParamListCopied(f: FuncDecl, par: i32): boolean {
  const lists: i32[] = []
  const xs: i32[] = [f.fnBody]
  while xs.length > 0 {
    const x = xs.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      const xn = nodeAt(x)
      if xn is LetDecl && ftLitHoldsParam(f, xn.letInit, par) { lists.push(x) }
      nodeChildrenPush(x, xs)
    }
  }
  if lists.length == 0 { return false }
  const ys: i32[] = [f.fnBody]
  while ys.length > 0 {
    const y = ys.pop() ?? -1
    if y >= 0 && y < P.nodes.length {
      const yn = nodeAt(y)
      if yn is Member && fvaListCopyAt(y) {
        const o = parenPeelIx(yn.memObj)
        if o >= 0 && nodeAt(o) is Ident && i32ListHas(lists, identDeclOf(o)) {
          return true
        }
      }
      nodeChildrenPush(y, ys)
    }
  }
  return false
}

// Whether `init` is a list literal with an element reading parameter `par` of `f`, or a copy of it.
function ftLitHoldsParam(f: FuncDecl, init: i32, par: i32): boolean {
  const li = parenPeelIx(init)
  if li < 0 || li >= P.nodes.length { return false }
  const lit = nodeAt(li)
  if !(lit is ArrayLit) { return false }
  for e in lit.arrElems {
    const pe = parenPeelIx(e)
    if pe >= 0 && pe < P.nodes.length && nodeAt(pe) is Ident {
      const d = identDeclOf(pe)
      if d == par || fnTagParamCopyOf(f, d) == par { return true }
    }
  }
  return false
}

// Whether parameter `i` of `d` is read only as a positional argument of calls through a set of
// functions every member of which takes set `s` at that position, after the elaboration.
function ftParamForwardsSet(d: i32, i: i32, s: i32): boolean {
  if d < 0 || d >= P.nodes.length { return false }
  const f = nodeAt(d)
  if !(f is FuncDecl) || i < 0 || i >= f.fnParams.length { return false }
  const par = f.fnParams[i]
  // A nested function's read is one body for every instance (D14842).
  if ftReadInNestedFn(f.fnBody, par) { return false }
  let seen = false
  const xs: i32[] = [f.fnBody]
  const ps: i32[] = [-1]
  while xs.length > 0 {
    const x = xs.pop() ?? -1
    const p = ps.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      const xd = if nodeAt(x) is Ident { identDeclOf(x) } else { -1 }
      const pn = if p >= 0 { nodeAt(p) } else { nodeAt(x) }
      // A `const` copy's seed is the parameter's value under another name, read where it lands.
      const seed = pn is LetDecl
        && pn.letInit == x
        && fnTagParamCopyOf(f, p) == par
      if xd >= 0 && !seed && (xd == par || fnTagParamCopyOf(f, xd) == par) {
        if xd != par && ftReadInNestedFn(f.fnBody, xd) { return false }
        if !(pn is Call) || !i32ListHas(pn.callArgs, x) { return false }
        const at = i32ListIndexOf(pn.callArgs, x)
        // A set left a closure has no arms to key the id it is handed.
        const cs = fnTagSetOfTy(nodeTyIxOf(parenPeelIx(pn.callFn)))
        const ms = fnTagMembers(cs)
        if (
          ftArgIsParam(pn, at)
          && (ftForwardsToListJoin(pn, at, s) || ftForwardsToFwd(pn, at, s))
        ) {
          seen = true
        } else {
          if !ftArgIsParam(pn, at) || ms.length == 0 || !fnTagSetIsTagged(cs) {
            return false
          }
          for m in ms {
            if !ftParamTakes(m, at, s) { return false }
          }
          seen = true
        }
      }
      for k in nodeChildren(x) {
        xs.push(k)
        ps.push(x)
      }
    }
  }
  return seen
}

// Whether direct call `c` to a named function takes set `s` at argument `at` where a list of the
// callee's body joins that parameter with others: the callee is decided with the join (D15573).
function ftForwardsToListJoin(c: Call, at: i32, s: i32): boolean {
  const g = ftCalleeFn(ftCalleeSource(c))
  const gf = if g >= 0 { nodeAt(g) } else { null }
  if !(gf is FuncDecl) { return false }
  const ats: i32[] = []
  for a in c.callArgs {
    ats.push(
      if ats.length == at { fnTagSetTy(s) } else { nodeTyIxOf(parenPeelIx(a)) },
    )
  }
  const j = fnTagListJoinSet(g, gf, at, ats)
  if j < 0 || j == s || !fnTagMembersWithin(s, j) || ftFwdDepth > 8 {
    return false
  }
  if !i32ListHas(ftSubNeed, j) { ftSubNeed.push(j) }
  ftFwdDepth = ftFwdDepth + 1
  const ok = ftLateParamTakes(c, g, at, j)
  ftFwdDepth = ftFwdDepth - 1
  return ok
}

// How many `ftForwardsToListJoin` frames are open, so a recursive forward ends.
let ftFwdDepth = 0

// Whether direct call `c` to a named function hands argument `at` to a parameter that is itself
// only forwarded on to a list join (`ftParamForwardsSet`), so a chain of forwarders is decided with
// the join it ends in (D15579).
function ftForwardsToFwd(c: Call, at: i32, s: i32): boolean {
  const g = ftCalleeFn(ftCalleeSource(c))
  if g < 0 || !(nodeAt(g) is FuncDecl) || ftFwdDepth > 8 { return false }
  ftFwdDepth = ftFwdDepth + 1
  const ok = ftParamForwardsSet(g, at, s)
  ftFwdDepth = ftFwdDepth - 1
  return ok
}

// Whether parameter `i` of the function declared at `d` is read nowhere in its body but as a
// direct argument handed to another such parameter of a named function, `depth` hops in.
function ftParamInert(d: i32, i: i32, depth: i32): boolean {
  const seen: i32[] = []
  return ftParamInertIn(d, i, depth, seen)
}

// `ftParamInert`, where `seen` holds the (declaration, index) pairs already being asked, two
// entries each: a parameter handed only around a cycle of hand-ons reaches no use (D15405).
function ftParamInertIn(d: i32, i: i32, depth: i32, seen: i32[]): boolean {
  if ftParamUnread(d, i) { return true }
  if depth > 4 || d < 0 || d >= P.nodes.length { return false }
  let k = 0
  while k + 1 < seen.length {
    if seen[k] == d && seen[k + 1] == i { return true }
    k = k + 2
  }
  const f = nodeAt(d)
  if !(f is FuncDecl) || i < 0 || i >= f.fnParams.length { return false }
  seen.push(d)
  seen.push(i)
  const par = f.fnParams[i]
  const xs: i32[] = [f.fnBody]
  const ps: i32[] = [-1]
  while xs.length > 0 {
    const x = xs.pop() ?? -1
    const p = ps.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      if nodeAt(x) is Ident && identDeclOf(x) == par {
        const pn = if p >= 0 { nodeAt(p) } else { nodeAt(x) }
        if !(pn is Call) || !i32ListHas(pn.callArgs, x) { return false }
        const to = ftNamedFn(parenPeelIx(pn.callFn))
        const at = i32ListIndexOf(pn.callArgs, x)
        if !ftArgIsParam(pn, at) || !ftParamInertIn(to, at, depth + 1, seen) {
          return false
        }
      }
      for c in nodeChildren(x) {
        xs.push(c)
        ps.push(x)
      }
    }
  }
  return true
}

// Whether parameter `i` of the function declared at `d` is read nowhere in its body.
function ftParamUnread(d: i32, i: i32): boolean {
  if d < 0 || d >= P.nodes.length { return false }
  const f = nodeAt(d)
  if !(f is FuncDecl) || i < 0 || i >= f.fnParams.length { return false }
  const pn = nodeAt(f.fnParams[i])
  if !(pn is Param) { return false }
  const w = cwOccWalkSpelled(f.fnParams[i], pn.parName)
  while cwOccNext(w) {
    const o = cwIxNode[w.row]
    if o != f.fnParams[i] && identDeclOf(o) == f.fnParams[i] { return false }
  }
  return true
}

// Whether callee `x` names a member of set `s` by its declaration, or by a `const` of the bare
// name: a direct call, whatever the set's rep, so it reads no id of the set (D15338, D15926).
function ftMemberDirectCall(x: i32, s: i32): boolean {
  const d = ftLocalAliasedFn(identDeclOf(x))
  return d >= 0
    && d < P.nodes.length
    && nodeAt(d) is FuncDecl
    && i32ListHas(fnTagMembers(s), d)
}

// Whether argument `x` of call `c` to a named function may hold set `s`'s id: after the
// elaboration, for a set the check left a closure, only where the callee's calls through that
// parameter all take `s`, since a parameter handed on is typed where it lands.
function ftLateParamOk(c: Call, x: i32, s: i32): boolean {
  if !ftLate || i32ListHas(ftWas, s) { return true }
  const d = ftCalleeFn(ftCalleeSource(c))
  if d < 0 { return true }
  const i = i32ListIndexOf(c.callArgs, x)
  // A type parameter two generic arguments share binds their union, decided with `s`.
  const f = nodeAt(d)
  const j0 = if f is FuncDecl { fnTagSharedJoinSet(f, i, c.callArgs) } else { -1 }
  // So do un-annotated parameters one list of the callee's body joins (D15572).
  const ats: i32[] = []
  for a in c.callArgs { ats.push(nodeTyIxOf(parenPeelIx(a))) }
  const j = if j0 < 0 && f is FuncDecl { fnTagListJoinSet(d, f, i, ats) } else { j0 }
  if j < 0 || j == s {
    if ftLateParamTakes(c, d, i, s) { return true }
    // A parameter handed on to calls through a wider set decided with `s` holds `s`'s id as one of
    // that set's (D15610).
    for w in ftAssume {
      if w != s && fnTagMembersWithin(s, w) && ftParamTakes(d, i, w) {
        return true
      }
    }
    // So does one whose every wider set holds `s`, each decided with it.
    const ws = ftParamTakesSets(d, i)
    if ws.length == 0 { return false }
    for w in ws {
      if w == s || !fnTagMembersWithin(s, w) { return false }
    }
    for w in ws {
      if !fnTagSetIsTagged(w) && !i32ListHas(ftSubNeed, w) { ftSubNeed.push(w) }
    }
    return true
  }
  if !fnTagMembersWithin(s, j) { return false }
  if !i32ListHas(ftSubNeed, j) { ftSubNeed.push(j) }
  return ftLateParamTakes(c, d, i, j)
}

// Notes for the decision of `s` each smaller set handed to a parameter that is handed on to the
// parameter call `c` calls through, at any depth, and as leaves each member named directly by a
// list literal handed to the parameter `c` reads its callee off (D15625).
function ftFwdInSubsets(c: i32, s: i32, leaves: i32[], ids: i32[]) {
  const cn = if c >= 0 && c < P.nodes.length { nodeAt(c) } else { null }
  if !(cn is Call) { return 0 }
  const pd = identDeclOf(ftSlotRoot(parenPeelIx(cn.callFn)))
  if pd < 0 || pd >= P.nodes.length || !(nodeAt(pd) is Param) { return 0 }
  const fd = recEnclosingFn(pd)
  const fn = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { null }
  const pi = if fn is FuncDecl { i32ListIndexOf(fn.fnParams, pd) } else { -1 }
  if pi < 0 { return 0 }
  const todo: i32[] = [fd, pi]
  const ds = fnTagMembers(s)
  const st = fnTagSetTy(s)
  // Only a list the call reads its callee off is a list of the set's ids.
  const cf = parenPeelIx(cn.callFn)
  const lt = if st >= 0 && ftSlotRoot(cf) != cf { mkArrayTy(st) } else { -1 }
  let q = 0
  while q + 1 < todo.length && q < 64 {
    for a in if q == 0 { fnParamHandArgsOf(fd, pi) } else { [] } {
      const ax = if a >= 0 && a < P.nodes.length { parenPeelIx(a) } else { -1 }
      // A literal not every element of which is a leaf keeps none of them.
      const n0 = leaves.length
      if (
        lt >= 0
        && ax >= 0
        && nodeAt(ax) is ArrayLit
        && !ftInnerLeaves(ax, lt, s, ds, leaves, ids)
      ) {
        while leaves.length > n0 {
          leaves.pop()
          ids.pop()
        }
      }
    }
    const ins = mintParamFwdInsOf(todo[q], todo[q + 1])
    let k = 0
    while k + 1 < ins.length {
      for o in fnParamHandSets(ins[k], ins[k + 1]) {
        if (
          o >= 0
          && o != s
          && fnTagMembersWithin(o, s)
          && !i32ListHas(ftSubNeed, o)
        ) {
          ftSubNeed.push(o)
        }
      }
      todo.push(ins[k])
      todo.push(ins[k + 1])
      k = k + 2
    }
    q = q + 2
  }
  return 0
}

// Whether parameter `i` of `d`, handed `s` by call `c`, takes it as the elaboration's facts read.
function ftLateParamTakes(c: Call, d: i32, i: i32, s: i32): boolean {
  // A written binding the parameter initialises is decided with `s` however else it takes `s`,
  // since the binding holds the id the parameter is handed.
  const seeds = ftParamSeedsWider(d, i, s)
  return seeds
    || ftParamTakes(d, i, s)
    || ftParamUnread(d, i)
    || ftArgIsParam(c, i) && ftParamForwardsSet(d, i, s)
    || ftArgIsParam(c, i) && ftParamInert(d, i, 0)
    || ftArgIsParam(c, i) && i32ListHas(ftRetParamsOf(d), i)
    || ftListedHandsOne(d, i, s)
}

// Whether parameter `i` of `d` is listed into a copy (`ftParamListCopied`) and every call reaching
// `d` hands it `s`: the copy's adapter calls through each element at the instance's id (D15432).
function ftListedHandsOne(d: i32, i: i32, s: i32): boolean {
  const f = nodeAt(d)
  if !(f is FuncDecl) || i < 0 || i >= f.fnParams.length { return false }
  return ftParamListCopied(f, f.fnParams[i]) && ftReachHandsOne(d, i) == s
}

// The one set every call reaching `fd` hands its parameter `pi` (`ftReachHandSets`); -1 where
// some call hands a value of no set, two calls hand different sets, or a reference is no call
// (D15432).
function ftReachHandsOne(fd: i32, pi: i32): i32 {
  const hs = ftReachHandSets(fd, pi, 0)
  if hs.length == 0 || hs[0] < 0 { return -1 }
  for h in hs {
    if h != hs[0] { return -1 }
  }
  return hs[0]
}

// Whether `x` names a written binding a parameter initialises, which holds `s` or a wider set
// in every instance, the wider one decided with `s`.
function ftSeededHolds(x: i32, s: i32): boolean {
  if x < 0 || x >= P.nodes.length || !(nodeAt(x) is Ident) { return false }
  return ftWiderWith(mintSeedWideOfBind(identDeclOf(x)), s)
}

// Whether parameter `i` of `d`, holding set `s`, initialises written bindings that hold `s` or a
// wider set decided with it, so the id an argument hands is what they hold.
function ftParamSeedsWider(d: i32, i: i32, s: i32): boolean {
  return ftWiderWith(mintSeedWideOfParam(d, i, s), s)
}

// Whether `ws` is not empty and each set in it is `s` or holds `s`, queueing each wider one to
// be decided with `s`.
function ftWiderWith(ws: i32[], s: i32): boolean {
  if ws.length == 0 { return false }
  for w in ws {
    if w != s && !fnTagMembersWithin(s, w) { return false }
  }
  for w in ws {
    if w != s && !i32ListHas(ftSubNeed, w) { ftSubNeed.push(w) }
  }
  return true
}

// Whether, after the elaboration, argument `x` of call `c` through a set of functions lands in a
// parameter every member's calls through take as set `s`, so the id is what each member reads.
// Only a value read off a binding, element or field is such a callee.
function ftLateArgOfSet(c: Call, x: i32, s: i32): boolean {
  if !ftLate && !ftUseArrow { return false }
  if ftLate && mintSetPartial(s) { return false }
  const i = i32ListIndexOf(c.callArgs, x)
  if i < 0 || (i < c.callArgNames.length && c.callArgNames[i] != "") {
    return false
  }
  const cf = parenPeelIx(c.callFn)
  const cd = identDeclOf(cf)
  // A parameter hands the id to each member of the sets its calls go through.
  if cd >= 0 && cd < P.nodes.length && nodeAt(cd) is Param {
    return ftParamSetsTake(cd, i, s)
  }
  // A declared function is no holder of the set; a binding, element or field is.
  const held = cd >= 0
    && cd < P.nodes.length
    && !(nodeAt(cd) is Param)
    && !(nodeAt(cd) is FuncDecl)
  if cf < 0 || !(nodeAt(cf) is Index || nodeAt(cf) is Member || held) {
    return false
  }
  const cs = fnTagSetOfTy(nodeTyIxOf(cf))
  const ds = fnTagMembers(cs)
  if ds.length == 0 { return false }
  // A member that never reads the parameter takes any id, as `ftLateParamTakes` lets it (D15038).
  for d in ds {
    if !ftParamTakes(d, i, s) && !ftParamUnread(d, i) {
      // A parameter the set-binding rows bring `s` to, which arrow rows reach yet none with `s`,
      // is the facts refusing; otherwise the facts are missing, not refusing.
      if (
        ftUseArrow
        && arrowParamSeen(d, i)
        && i32ListHas(setBindSetsOf(d, i), s)
      ) {
        return ftFactRefusal()
      }
      return false
    }
  }
  // A call through a closure of named functions takes the closure's one signature, which holds
  // `s`'s id only where no instance hands the members' parameter another set; else the callee's
  // set is decided with `s`, so the call is a dispatch (D15019).
  if (
    cs != s
    && !fnTagSetIsTagged(cs)
    && ftAllNamed(ds)
    && ftParamTakesOther(ds, i, s)
  ) {
    if !i32ListHas(ftSubNeed, cs) { ftSubNeed.push(cs) }
  }
  return true
}

// Whether every declaration in `ds` is a named function.
function ftAllNamed(ds: i32[]): boolean {
  for d in ds {
    const m = nodeAt(d)
    if !(m is FuncDecl) || m.fnName == "" { return false }
  }
  return true
}

// Whether some instance's calls through parameter `i` of a member of `ds` go through a set other
// than `s`.
function ftParamTakesOther(ds: i32[], i: i32, s: i32): boolean {
  for d in ds {
    for o in ftParamSetsOf(d, i) {
      if o != s { return true }
    }
  }
  return false
}

// Whether every call through parameter `par` goes through sets of named functions each of which
// takes set `s` at its parameter `i`, so the id is what every member reads. A lambda member takes
// a bundle of closures instead (D14841).
function ftParamSetsTake(par: i32, i: i32, s: i32): boolean {
  const fd = ftParamOwner(ftDecideRoot, par)
  if fd < 0 { return false }
  const f = nodeAt(fd)
  if !(f is FuncDecl) { return false }
  const j = i32ListIndexOf(f.fnParams, par)
  const sets = ftParamSetsOf(fd, j)
  if j < 0 || sets.length == 0 { return false }
  for ss in sets {
    const ds = fnTagMembers(ss)
    if ds.length == 0 { return false }
    for d in ds {
      const m = nodeAt(d)
      if !(m is FuncDecl) || m.fnName == "" || !ftParamTakes(d, i, s) {
        return false
      }
    }
  }
  return true
}

// The deliveries of a choice to a closed function type noted by this check.
let ftEscapes: i32[] = []

// Whether delivery `x` of set `s` to a closed function type has its adapter built: by the next
// check, which the decision after the elaboration has only for a set the check's decision tagged;
// else as the closure the elaboration noted there, or a lone hole lambda's built at that type
// (`fnCloCoerceNote` in `fnTagDecide`) (D15641).
function ftEscBuilt(x: i32, s: i32, p: i32): boolean {
  if !ftLate || i32ListHas(ftWas, s) { return true }
  const ei = i32ListIndexOf(ftEscapes, x)
  const dt = if ei >= 0 && ei < ftEscDstLast.length { ftEscDstLast[ei] } else { -1 }
  if ftLateCloAt(s, dt, p) {
    ftLateCloXs.push(x)
    return true
  }
  let r = 0
  while r < mintCloRows() {
    if mintCloAtOf(r) == x && mintCloSetOf(r) == s { return true }
    r = r + 1
  }
  return false
}

// The deliveries `ftLateCloAt` admitted at a parent, by the decision after the elaboration.
let ftLateCloXs: i32[] = []

// Whether the emitter builds set `s`'s delivery to closed function type `dt` under parent `p`
// after the elaboration: a lone hole lambda's closure, or the closure of the named member the id
// names (`fnCloCoerceNote`). A builtin callback other than `.map`/`.filter`'s is lowered at its own
// signature, so is not one; nor is a delivery with no parent (`p` is -1).
function ftLateCloAt(s: i32, dt: i32, p: i32): boolean {
  const ms = fnTagMembers(s)
  if (
    !coerceRecordOpen()
    || ms.length == 0
    || dt < 0
    || dt >= T.tys.length
    || !(tyAt(dt) is TyFunc)
    || tyHasTyVar(dt)
  ) {
    return false
  }
  if ms.length == 1 && ftHoleLambdaAlone(s, ms[0]) { return true }
  if p < 0 { return false }
  const pn = nodeAt(p)
  if pn is Call {
    if pn.callFn < 0 { return false }
    const cf = nodeAt(pn.callFn)
    if cf is Member {
      if cf.memProp != "map" && cf.memProp != "filter" { return false }
    }
  }
  for m in ms {
    if !ftNamedDecl(m) { return false }
    if ftPlainDecl(m) && !ftHoleLambda(m) && !tySame(nodeTyIxOf(m), dt) {
      return false
    }
  }
  return true
}

// Whether node `x` of set `s`, the child of `p` (itself the child of `g`) inside function `fn`,
// sits where its value is a binding, a return, an arm, or a callee through `s`.
function ftCtxOk(x: i32, p: i32, g: i32, fn: i32, s: i32): boolean {
  if p < 0 { return false }
  if i32ListHas(ftEscapes, x) { return ftEscBuilt(x, s, p) }
  if ftWideEtaAt(x, s) { return true }
  const pn = nodeAt(p)
  match pn {
    Program | Paren => {
      return true
    }
    Call => {
      if pn.callFn == x {
        return fnTagCallSetOf(p) == s || ftMemberDirectCall(x, s)
      }
      return (ftParamOfSet(pn, x, s) && ftLateParamOk(pn, x, s))
        || ftMethodTyParamArg(p, x, s)
        || ftListCallHoleArg(pn, x, s)
        || ftSlotWriteArg(pn, x, s)
        || ftLateArgOfSet(pn, x, s)
    }
    // A binding's annotation delivers the value to a declared function type, a closure.
    // So does a `const` copy of a parameter annotated with the function's type parameter.
    LetDecl => {
      // A call handing back the one generic member, bound to a closed function type, delivers
      // that member's closure there, built from the id the call hands back.
      if ftHandBackAtClosed(x, p) && ftOneGenericMember(s) {
        ftP.cloAt.push(x)
        ftP.cloTy.push(nodeTyIxOf(p))
        return true
      }
      return pn.letInit == x && (pn.letType < 0 || ftParamCopyAt(p, fn))
    }
    RetStmt => {
      return ftRetCarries(fn, s)
    }
    IfStmt => {
      return x != pn.ifCond && ftIsS(p, s)
    }
    MatchExpr => {
      return x != pn.matchScrut && i32ListHas(pn.matchBodies, x) && ftIsS(p, s)
    }
    Block => {
      const st = pn.blkStmts
      if st.length == 0 || st[st.length - 1] != x { return true }
      // A declaration as the last statement hands the block no value, and nor does the tail of a
      // block the check types `void`: its value is discarded.
      if x >= 0 && x < P.nodes.length && nodeAt(x) is LetDecl { return true }
      if nodeTyIxOf(p) == TY_VOID { return true }
      if ftIsS(p, s) { return true }
      if g >= 0 {
        const gn = nodeAt(g)
        if (gn is IfStmt || gn is MatchExpr) && ftIsS(g, s) { return true }
        // A function whose result is `void` discards its tail's value, so no id leaves it.
        if (
          gn is FuncDecl
          && gn.fnBody == p
          && (ftRetCarries(g, s) || ftRetVoid(g))
        ) {
          return true
        }
        if gn is WhileStmt && gn.whileBody == p && ftIsS(g, s) { return true }
      }
      return false
    }
    Param => {
      return pn.parType == x
    }
    // A loop's value is the last statement of its body, or what a `break` hands it.
    WhileStmt => {
      return pn.whileBody == x
    }
    // A write to a binding of the set stores one of its ids.
    BinExpr => {
      if pn.binOp == "??" { return pn.binRight == x && ftIsS(p, s) }
      // Two ids of one set are equal when they name one member.
      if pn.binOp == "==" || pn.binOp == "!=" {
        return ftIsS(pn.binLeft, s) && ftIsS(pn.binRight, s)
      }
      if !ftIsStore(pn) { return false }
      if pn.binLeft == x {
        if x < 0 || x >= P.nodes.length { return false }
        const xn = nodeAt(x)
        if xn is Index { return ftSlotHoldsSet(xn.idxArr, "", s) }
        // A record field is a slot too, whose own type says whether it holds an id (D15117).
        if xn is Member { return ftSlotHoldsSet(xn.memObj, xn.memProp, s) }
        return xn is Ident
      }
      if pn.binRight != x { return false }
      if ftIsS(pn.binLeft, s) { return true }
      if ftSeededHolds(pn.binLeft, s) { return true }
      if ftHeldWider(nodeTyIxOf(pn.binLeft), s) { return true }
      if ftWriteLeafOf(x, s) { return true }
      const ln = nodeAt(pn.binLeft)
      // `h[k] = v` stores into the slot `h.set(k, v)` does, so the holder's type decides (D15116).
      if ln is Member { return ftSlotHoldsSet(ln.memObj, ln.memProp, s) }
      return ln is Index
        && (ftSlotHoldsSet(ln.idxArr, "", s)
        || ftNamedFnValue(x) && ftParamHolderHolds(ln.idxArr, s, fn))
    }
    FuncDecl => {
      if i32ListHas(pn.fnParams, x) { return true }
      return pn.fnBody == x && ftRetCarries(p, s)
    }
    // A list literal holds the id as its element, unless its elements join to a function type
    // that carries no set: it then holds closures. A one-generic-member set's value is that
    // member's closure at the closed type an annotation builds the literal at; no other id fits.
    ArrayLit => {
      const lt = nodeTyIxOf(p)
      const la = if lt >= 0 && lt < T.tys.length { tyAt(lt) } else { null }
      const e0 = if la is TyArray { tyElemOf(la) } else { -1 }
      const en = nonNullTy(e0)
      if en < 0 || fnTagSetOfTy(e0) >= 0 || fnTagSetOfTy(en) >= 0 {
        return true
      }
      if !(tyAt(en) is TyFunc) { return true }
      const et = ftLitAnnotAt(x)
      if !ftClosedFnTy(et) || fnTagSetOfTy(et) >= 0 || !ftOneGenericMember(s) {
        return false
      }
      ftP.cloAt.push(x)
      ftP.cloTy.push(et)
      return true
    }
    // A record literal holds the id as the field's value.
    FieldInit => {
      const held = pn.fiValue == x
        && (ftRecHolds(g, s) || ftOpenFieldHolds(g, pn.fiName, s))
      // Its literal is built at the record of the set's ids, whatever rep check adopted.
      if held && ftLate && ftNamedFnValue(x) && !i32ListHas(ftP.named, g) {
        ftP.named.push(g)
      }
      return held
    }
    // Any other parent reads the value as a closure.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | Member | OptMember | ErrExpr | TypeRef | BreakStmt | ContinueStmt | FieldDef | TypeDecl | ObjLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | ImportDecl | Spread | LoopVar => {
      return false
    }
  }
}

// Whether list literal `x` joins every element into set `s`, the set its element type carries.
function ftLitJoin(
  x: i32,
  n: ArrayLit,
  s: i32,
  ds: i32[],
  leaves: i32[],
  ids: i32[],
): boolean {
  const lt = nodeTyIxOf(x)
  if lt < 0 || lt >= T.tys.length { return true }
  const at = tyAt(lt)
  if !(at is TyArray) { return true }
  // A list of lists is built from inner literals, or names of them, that hold the set. An inner
  // literal of fewer members holds their ids too, and is re-typed to the list's element row.
  if ftHoldKind(lt, s) == 4 {
    for el in n.arrElems {
      if !ftListElemOk(el, tyElemOf(at), s, ds, leaves, ids) { return false }
    }
    return true
  }
  // A list of maps of the set holds only maps whose own value is the set (D15187), or a smaller
  // set decided with this one, whose ids are this set's (D15234).
  if ftHoldKind(lt, s) == 7 {
    for el in n.arrElems {
      if !ftMapElemOk(el, s) { return false }
    }
    return true
  }
  // A list of records of a set whose members' results differ at a call stores each record
  // literal's fields as ids, as a record written into a holder of them does: no one closure
  // signature runs every member.
  if ftHoldKind(lt, s) == 6 && fnTagSetSplits(s) {
    for el in n.arrElems {
      if !ftRecWriteJoins(el, tyElemOf(at), s, ds, leaves, ids) { return false }
    }
    return true
  }
  if fnTagSetOfTy(tyElemOf(at)) != s { return true }
  for el in n.arrElems {
    if !ftIsS(el, s) && !ftJoinAt(el, tyElemOf(at), s, ds, leaves, ids) {
      return false
    }
  }
  return true
}

// Whether `el`, an element of a list of maps of set `s`, is a map of `s` itself, or of a smaller set
// decided with `s`, whose ids are `s`'s; the smaller set is noted as needed.
function ftMapElemOk(el: i32, s: i32): boolean {
  const et = nodeTyIxOf(el)
  const ek = ftHoldKind(et, s)
  if ek == 3 || ek == 7 { return true }
  const em = if et >= 0 && et < T.tys.length { tyAt(et) } else { null }
  const es = if em is TyMap { fnTagSetOfTy(tyValOf(em)) } else { -1 }
  if es < 0 || es == s || !fnTagMembersWithin(es, s) { return false }
  if !i32ListHas(ftSubNeed, es) { ftSubNeed.push(es) }
  return true
}

// Whether literal `x` holds set `s` only through values whose deliveries into it the decision
// coerces to a closure (`fnCloCoerceNote`): after the elaboration, each such value is built as
// its member's closure, so the literal holds closures and no id (D14884). A written binding
// delivered into a closed slot through an adapter is such a value too.
function ftHolderCoerced(x: i32, s: i32): boolean {
  if x < 0 || x >= P.nodes.length { return false }
  // A copy `fvaListSetCopy` built is a fresh list of adapters, which holds no id (D15132).
  if fvaListCopyAt(x) { return true }
  // A list literal an annotation builds at its closures holds none either (D15338).
  if ftLitAtClosed(x, s) { return true }
  const n = nodeAt(x)
  // A record literal the record solve builds at a place holding no set decided with `s` holds
  // that place's closures.
  if n is ObjLit {
    const r = ftLitBuiltAt(x)
    if r >= 0 && !ftTyHoldsDecided(r, s) { return true }
  }
  // An annotated binding of such a literal, and a write of one, hold what the literal holds.
  if n is LetDecl {
    return n.letType >= 0
      && n.letInit >= 0
      && ftHolderCoerced(parenPeelIx(n.letInit), s)
  }
  if n is BinExpr {
    return ftIsStore(n) && ftHolderCoerced(parenPeelIx(n.binRight), s)
  }
  const vs: i32[] = []
  if n is ObjLit {
    for fx in n.objFields {
      const f = nodeAt(fx)
      if f is FieldInit { vs.push(f.fiValue) }
    }
  } else if n is ArrayLit {
    for e in n.arrElems { vs.push(e) }
  } else {
    return false
  }
  let any = false
  for v in vs {
    // A literal nested in it is judged the same way.
    const vn = nodeAt(parenPeelIx(v))
    if fvaListCopyAt(parenPeelIx(v)) {
      any = true
    } else if vn is ArrayLit || vn is ObjLit {
      if ftHolds(parenPeelIx(v), s) && !ftHolderCoerced(parenPeelIx(v), s) {
        return false
      }
      if ftHolds(parenPeelIx(v), s) { any = true }
    } else if fnTagSetOfTy(nodeTyIxOf(v)) == s {
      const wide = (i32ListHas(ftEscapes, v) || fnTagEtaAt(v)) && ftWideEscOk(s)
      if !wide { return false }
      any = true
    } else if fnTagEtaAt(v) && fnTagEtaSetOf(v) == s {
      // The adapter the last check built there holds a closure.
      any = true
    }
  }
  return any
}

// Whether node `x` is a list whose element carries set `s`, or a record with a field that holds
// one.
function ftHolds(x: i32, s: i32): boolean {
  return x >= 0 && ftHoldKind(nodeTyIxOf(x), s) > 0
}

// `ftHolds` for the record literal `x` a field value sits in, asked of the type its row is built
// at (its adopted rep, else its own), which may hold a set decided with `s`: a field that carries
// no such set there is a closure field, so its value cannot be an id (D15205).
function ftRecHolds(x: i32, s: i32): boolean {
  return x >= 0 && ftTyHoldsDecided(nodeRepTyIxOf(x), s)
}

// Whether the other record literals of `x`'s field names can be decided with set `s` at field
// `name`: they share one row, whose rep holds ids at that field for all of them or none (D15641),
// so each set they hold there is decided with `s`. An open field is bound per instance, after the
// elaboration, so none is decided before it.
function ftShapeFieldDecidedWith(x: i32, name: string, s: i32): boolean {
  for l in ftShapeLitsOf(x) {
    const ft = if l != x { tyFieldTyOf(nodeTyIxOf(l), name) } else { -1 }
    if ft >= 0 && ft < T.tys.length && tyAt(ft) is TyVar { return false }
    const o = fnTagSetOfTy(ft)
    if (
      o >= 0
      && o != s
      && !fnTagSetIsTagged(o)
      && !i32ListHas(ftAssume, o)
      && !i32ListHas(ftSubNeed, o)
    ) {
      ftSubNeed.push(o)
    }
  }
  return true
}

// The record literals sharing record literal `x`'s field names, `x` included.
function ftShapeLitsOf(x: i32): i32[] {
  if !ftShapeBuilt {
    ftShapeBuilt = true
    ftShapeLits = Map()
    const todo: i32[] = [ftDecideRoot]
    while todo.length > 0 {
      const i = todo.pop() ?? -1
      if i >= 0 && i < P.nodes.length {
        if nodeAt(i) is ObjLit {
          const k = ftLitShapeKey(i)
          const was = ftShapeLits[k] ?? []
          was.push(i)
          ftShapeLits[k] = was
        }
        nodeChildrenPush(i, todo)
      }
    }
  }
  return ftShapeLits[ftLitShapeKey(x)] ?? []
}

// Record literal `x`'s field names, in order, joined by commas.
function ftLitShapeKey(x: i32): string {
  const n = nodeAt(x)
  let k = ""
  if n is ObjLit {
    for f in n.objFields {
      const fn = nodeAt(f)
      k = k + "," + (if fn is FieldInit { fn.fiName } else { "?" })
    }
  }
  return k
}

// Per field-name key, the record literals under the current decision's root.
let ftShapeLits: {[string]: i32[]} = Map()
let ftShapeBuilt = false

// Whether field `name` of record literal `x`, adopted at a hole parameter's record whose field is
// open, holds set `s` in the literal's own type: after the elaboration the literal is built at
// that type, which the instance binds the parameter to. Its other fields' sets are decided with
// `s`, since the record's rep holds ids at all of them or none (D15641).
function ftOpenFieldHolds(x: i32, name: string, s: i32): boolean {
  if !(ftLate || ftUseArrow) || x < 0 { return false }
  if !ftLate && !ftShapeFieldDecidedWith(x, name, s) { return false }
  const ft = tyFieldTyOf(nodeRepTyIxOf(x), name)
  const lt = nodeTyIxOf(x)
  if (
    ft < 0
    || ft >= T.tys.length
    || !(tyAt(ft) is TyVar)
    || fnTagSetOfTy(tyFieldTyOf(lt, name)) != s
  ) {
    return false
  }
  const lo = if lt >= 0 && lt < T.tys.length { tyAt(lt) } else { null }
  if lo is TyObj {
    for f in lo.objFieldTypes {
      const o = fnTagSetOfTy(f)
      if (
        o >= 0
        && o != s
        && !fnTagSetIsTagged(o)
        && !i32ListHas(ftAssume, o)
        && !i32ListHas(ftSubNeed, o)
      ) {
        ftSubNeed.push(o)
      }
    }
  }
  return true
}

// 1: a list whose element carries set `s`; 2: a record with a field of any kind within `depth`
// records; 3: a map whose value carries `s`; 4: a list of kind-1 or kind-4 lists; 5: a map whose
// value is such a list; 6: a list of kind-2 records or kind-6 lists; 7: a list of kind-3 maps or
// kind-7 lists; 8: a map whose value is a kind-2 record or a kind-6 or kind-8 holder; else 0.
function ftHoldKind(t: i32, s: i32): i32 {
  const seen: i32[] = []
  return ftHoldKindIn(t, s, seen)
}

// `ftHoldKind`, 0 for a type in `seen`: one already walked held nothing, or is on a cycle.
function ftHoldKindIn(t: i32, s: i32, seen: i32[]): i32 {
  if t < 0 || t >= T.tys.length || i32ListHas(seen, t) { return 0 }
  seen.push(t)
  const a = tyAt(t)
  match a {
    TyArray => {
      if fnTagSetOfTy(tyElemOf(a)) == s { return 1 }
      const ek = ftHoldKindIn(tyElemOf(a), s, seen)
      if ek == 1 || ek == 4 { return 4 }
      if ek == 2 || ek == 6 { return 6 }
      if ek == 3 || ek == 7 { return 7 }
      return 0
    }
    TyObj => {
      for f in a.objFieldTypes {
        const fk = ftHoldKindIn(f, s, seen)
        if fnTagSetOfTy(f) == s || fk > 0 { return 2 }
      }
      return 0
    }
    TyMap => {
      if fnTagSetOfTy(tyValOf(a)) == s { return 3 }
      const vk = ftHoldKindIn(tyValOf(a), s, seen)
      if vk == 1 || vk == 4 { return 5 }
      if vk == 2 || vk == 6 || vk == 8 { return 8 }
      return 0
    }
    // A map read's `| null` holds what its value holds: a list of records or of lists (D15801).
    TyNullable => {
      const ik = ftHoldKindIn(a.nInner, s, seen)
      if ik == 4 || ik == 6 { return ik }
      return 0
    }
    // No other kind holds a set's ids as a container.
    TyPrim | TyErr | TyFunc | TyUnion | TyVar | TyLit | TyNeg => {
      return 0
    }
  }
}

// The value type of the map entry `x` writes, `m[k]` over a map whose value holds set `s`, or -1.
function ftMapEntryOf(x: i32, s: i32): i32 {
  if x < 0 || x >= P.nodes.length { return -1 }
  const n = nodeAt(x)
  if !(n is Index) { return -1 }
  const mt = nodeTyIxOf(n.idxArr)
  const mk = if mt >= 0 && mt < T.tys.length { ftHoldKind(mt, s) } else { 0 }
  if mk != 5 && mk != 8 { return -1 }
  const m = tyAt(mt)
  if m is TyMap { return tyValOf(m) }
  return -1
}

// Whether type `t` is `V | null` over a `V` of set `s`: what a map of the set's ids reads.
function ftNulOfS(t: i32, s: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const a = tyAt(t)
  return a is TyNullable && fnTagSetOfTy(a.nInner) == s
}

// The slot type of the holder `x` indexes when `x` is the target of store `p` and is not itself
// read at set `s` while the holder's slot is: a map entry, or a slot written before its holder's
// first write pinned it. -1 otherwise.
function ftSlotStoreTy(x: i32, p: i32, s: i32): i32 {
  if x < 0 || p < 0 || ftIsS(x, s) { return -1 }
  const pn = nodeAt(p)
  if !(pn is BinExpr && ftIsStore(pn) && pn.binLeft == x) { return -1 }
  const n = nodeAt(x)
  if !(n is Index) { return -1 }
  return ftSlotTyOf(nodeTyIxOf(n.idxArr), s)
}

// The values call `g`, through field read `p` of holder `x` of set `s`, writes into the holder's
// slots: what `xs.push(v...)` or `m.set(k, v)` stores. Empty for any other read.
function ftSlotWrites(x: i32, p: i32, g: i32, s: i32): i32[] {
  const none: i32[] = []
  if p < 0 || g < 0 { return none }
  const pn = nodeAt(p)
  const gn = nodeAt(g)
  // An entry store into a map of records writes the record as `set` does.
  if (
    pn is Index
    && pn.idxArr == x
    && gn is BinExpr
    && ftIsStore(gn)
    && gn.binLeft == p
  ) {
    const xt = nodeTyIxOf(x)
    const mt = if xt >= 0 && xt < T.tys.length { tyAt(xt) } else { null }
    if mt is TyMap && ftHoldKind(xt, s) == 8 { return [gn.binRight] }
    // So does an element store into a list of lists, writing a list (D16805).
    if mt is TyArray && ftHoldKind(xt, s) == 4 { return [gn.binRight] }
    return none
  }
  if (
    !(pn is Member && pn.memObj == x && gn is Call && parenPeelIx(gn.callFn) == p)
  ) {
    return none
  }
  if !ftSlotOp(pn, x, g, s) { return none }
  // A map of lists of ids takes a list, which its own literal and context rules type.
  if ftHoldKind(nodeTyIxOf(x), s) == 5 { return none }
  if pn.memProp == "push" { return gn.callArgs }
  if pn.memProp == "set" && gn.callArgs.length == 2 { return [gn.callArgs[1]] }
  return none
}

// The slot type of `ht`, a list or map type whose slot carries set `s`; -1 for any other type.
function ftSlotTyOf(ht: i32, s: i32): i32 {
  if ht < 0 || ht >= T.tys.length { return -1 }
  const h = tyAt(ht)
  match h {
    TyArray => {
      return if fnTagSetOfTy(tyElemOf(h)) == s { tyElemOf(h) } else { -1 }
    }
    TyMap => {
      return if fnTagSetOfTy(tyValOf(h)) == s { tyValOf(h) } else { -1 }
    }
    // Only a list's element or a map's value is a slot.
    TyObj | TyPrim | TyErr | TyFunc | TyUnion | TyNullable | TyVar | TyLit | TyNeg => {
      return -1
    }
  }
}

// The record literal a pushed argument `ax` writes: a `const` it names is built at its literal,
// which the record solve widens as it widens the literal pushed in place (D16998).
function ftPushedRecLit(ax: i32): i32 {
  const an = if ax >= 0 && ax < P.nodes.length { nodeAt(ax) } else { null }
  if !(an is Ident) { return ax }
  const d = identDeclOf(ax)
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if dn is LetDecl && dn.letKw == "const" && dn.letInit >= 0 {
    const lit = parenPeelIx(dn.letInit)
    if lit >= 0 && lit < P.nodes.length && nodeAt(lit) is ObjLit { return lit }
  }
  return ax
}

// Whether `p`, a field read of holder `x`, names a method a call reads or writes one slot of
// the holder through: a map's entry methods (a map of records' too), a list's `push`, `pop` and `get`, or a list's `map` and `filter`
// handing each element to a callback whose parameter is closed or is the set, so an adapter can
// be built or is already in place.
function ftSlotOp(p: Member, x: i32, g: i32, s: i32): boolean {
  if g < 0 || !(nodeAt(g) is Call) { return false }
  const k = ftHoldKind(nodeTyIxOf(x), s)
  const op = p.memProp
  if k == 1 && (op == "map" || op == "filter") {
    const c = nodeAt(g)
    if !(c is Call) || c.callArgs.length != 1 { return false }
    const cb = nodeTyIxOf(c.callArgs[0])
    if cb < 0 { return false }
    const ft = tyAt(cb)
    if !(ft is TyFunc) || ft.fnParamTypes.length == 0 { return false }
    const pt = ft.fnParamTypes[0]
    if pt < 0 { return false }
    return fnTagSetOfTy(pt) == s
      || !tyHasTyVar(pt) && !tyHoldsHole(pt)
      || ftHoleCallback(c.callArgs[0])
  }
  // A list of records rooted at a binding the field widener widened takes a pushed literal the
  // record solve builds at its element (D15336).
  if k == 6 && op == "push" {
    const c = nodeAt(g)
    if !(c is Call) || c.callArgs.length == 0 { return false }
    for a in c.callArgs {
      const ax = ftPushedRecLit(parenPeelIx(a))
      if recAsgFnWidenedTy(ax) < 0 && !ftWholeRecListLit(ax) { return false }
    }
    for a in c.callArgs {
      const ax = ftPushedRecLit(parenPeelIx(a))
      if ftWholeRecListLit(ax) {
        ftWrittenWholeNote(ax, x)
      } else {
        ftWrittenNote(ax)
      }
    }
    return true
  }
  // A slice of such a list of records copies its records, built at the holder's record; a `get`
  // reads one of them.
  if k == 6 && (op == "slice" || op == "get") && fnTagSetSplits(s) {
    return true
  }
  // A list of maps of the set takes a pushed map as its literal takes an element (D15395).
  if k == 7 && op == "push" { return true }
  // A list of lists of the set takes a pushed list as its literal takes an element, and its
  // copies and removals hand out lists of the same set (D16805).
  if k == 4 {
    return op == "push" || op == "slice" || op == "pop" || op == "get"
  }
  // A slice copies the list's ids into a list of the same set, read as the holder is (D14931).
  if k == 1 {
    return op == "push" || op == "slice" || op == "pop" || op == "get"
  }
  // A map's `keys()` hands out no value, so it reads none of the set's ids.
  return (k == 3 || k == 5 || k == 8)
    && (op == "get"
    || op == "set"
    || op == "has"
    || op == "delete"
    || op == "keys")
}

// Whether callback `v` names a top-level function whose first parameter is un-annotated: the
// built-in hands it each element, so its instance there takes the set, as a direct call's does.
function ftHoleCallback(v: i32): boolean {
  const d = ftNamedFn(parenPeelIx(v))
  if d < 0 { return false }
  const f = nodeAt(d)
  if !(f is FuncDecl) || f.fnParams.length == 0 { return false }
  const pn = nodeAt(f.fnParams[0])
  return pn is Param && pn.parType < 0
}

// Whether argument `x` of call `c` is a value `m.set(k, v)` or `xs.push(v)` stores into a
// holder of set `s`.
function ftSlotWriteArg(c: Call, x: i32, s: i32): boolean {
  const f = parenPeelIx(c.callFn)
  if f < 0 { return false }
  const fn = nodeAt(f)
  if !(fn is Member) { return false }
  const k = ftHoldKind(nodeTyIxOf(fn.memObj), s)
  if k == 1 && fn.memProp == "push" { return i32ListHas(c.callArgs, x) }
  return (ftSlotHoldsSet(fn.memObj, "", s) || k == 5 || ftWriteLeafOf(x, s))
    && fn.memProp == "set"
    && c.callArgs.length == 2
    && c.callArgs[1] == x
}

// Whether `x` names a declared function, a value whose set is the same at every call of the
// function it is written in.
function ftNamedFnValue(x: i32): boolean {
  const v = parenPeelIx(x)
  return v >= 0
    && v < P.nodes.length
    && nodeAt(v) is Ident
    && identFnDeclOf(v) >= 0
}

// Whether `h` reads an un-annotated parameter of `fd`, the function the read is in, that every call
// hands, positionally, a list or map whose element or value carries set `s` or a wider one decided
// with it: a write into its slot lands in that holder, as the same write at each call site would.
function ftParamHolderHolds(h: i32, s: i32, fd: i32): boolean {
  const v = parenPeelIx(h)
  if v < 0 || v >= P.nodes.length || !(nodeAt(v) is Ident) { return false }
  const pd = identDeclOf(v)
  const pn = if pd >= 0 && pd < P.nodes.length { nodeAt(pd) } else { null }
  if !(pn is Param) || pn.parType >= 0 { return false }
  const f = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { null }
  if !(f is FuncDecl) { return false }
  const pi = i32ListIndexOf(f.fnParams, pd)
  if pi < 0 { return false }
  const args = fnParamHandArgsOf(fd, pi)
  if args.length == 0 { return false }
  // A holder of a wider set takes the write as one of its ids, the wider set decided with `s`.
  const wider: i32[] = []
  for a in args {
    const t = nodeTyIxOf(a)
    const at = if t >= 0 && t < T.tys.length { tyAt(t) } else { null }
    const slot = if at is TyArray { tyElemOf(at) } else if at is TyMap { tyValOf(at) } else { -1 }
    // A slot of records holding `s` takes a record literal of the set's ids.
    const sk = ftHoldKind(slot, s)
    const o = if sk == 2 { s } else { fnTagSetOfTy(slot) }
    if o < 0 || o != s && !fnTagMembersWithin(s, o) { return false }
    if o != s && !i32ListHas(wider, o) { wider.push(o) }
  }
  for o in wider {
    if !i32ListHas(ftSubNeed, o) { ftSubNeed.push(o) }
  }
  return true
}

// Whether a slot of holder `h` holds set `s`'s ids itself: with `prop` "" a list's element or a
// map's value (`ftHoldKind` 1 or 3), else the record field `prop`, read at the type the record is
// built at, as `ftRecHolds` reads it. Every spelling of a write into that slot stores an id.
function ftSlotHoldsSet(h: i32, prop: string, s: i32): boolean {
  if prop == "" {
    const k = ftHoldKind(nodeTyIxOf(h), s)
    return k == 1 || k == 3
  }
  if h < 0 { return false }
  const rr = nodeRepTyIxOf(h)
  const rt = if rr >= 0 { rr } else { nodeTyIxOf(h) }
  if rt < 0 || rt >= T.tys.length { return false }
  const ro = tyAt(rt)
  if !(ro is TyObj) { return false }
  let i = 0
  while i < ro.objFieldNames.length && i < ro.objFieldTypes.length {
    if ro.objFieldNames[i] == prop {
      return fnTagSetOfTy(ro.objFieldTypes[i]) == s
    }
    i = i + 1
  }
  return false
}

// The value type of the map `m.set(k, x)` writes `x` into, when that map's value holds set `s`
// in a list or a record (kinds 5 and 8); -1 otherwise.
function ftMapSetValTy(c: Call, x: i32, s: i32): i32 {
  if c.callArgs.length != 2 || c.callArgs[1] != x { return -1 }
  const f = parenPeelIx(c.callFn)
  if f < 0 || f >= P.nodes.length { return -1 }
  const fn = nodeAt(f)
  if !(fn is Member) || fn.memProp != "set" { return -1 }
  const mt = nodeTyIxOf(fn.memObj)
  const mk = if mt >= 0 && mt < T.tys.length { ftHoldKind(mt, s) } else { 0 }
  if mk != 5 && mk != 8 { return -1 }
  const m = tyAt(mt)
  if m is TyMap { return tyValOf(m) }
  return -1
}

// Whether holder `x` of set `s`, the child of `p` in function `fn`, is only read there or is
// delivered where the destination's type is the holder's own: a holder has one rep and no
// converting copy, so a destination of any other type can neither carry it nor be adapted to it.
function ftHoldCtxOk(x: i32, p: i32, g: i32, fn: i32, s: i32): boolean {
  const n = nodeAt(x)
  // A declaration's own node is placed by its value's parent; a spelled type never names a set.
  // A map it is initialised with of a set within `s` is decided with it (D15535).
  if n is LetDecl {
    const it = if n.letInit >= 0 { tyAt(nodeTyIxOf(n.letInit)) } else { null }
    if n.letType < 0 && it is TyMap { ftDstTakes(nodeTyIxOf(x), n.letInit, s) }
    return n.letType < 0
  }
  if n is FieldInit { return ftRecHolds(p, s) }
  if p < 0 { return false }
  const tx = nodeTyIxOf(x)
  const pn = nodeAt(p)
  // A list of lists of ids is read in place: indexed, walked, bound, nested in a literal, a
  // record's field or a map entry, or returned where the function's inferred result is its type.
  if (
    ftHoldKind(tx, s) == 4
    && !(pn is Index
      || pn is ForIn
      || pn is LetDecl
      || pn is ArrayLit
      || pn is Program
      || pn is RetStmt
      || pn is FuncDecl
      || pn is Block
      || pn is FieldInit
      || pn is Member
      || pn is BinExpr
      || pn is Call)
  ) {
    return false
  }
  match pn {
    // Reads of the holder's slots and fields, and a loop binding each of its ids.
    Index => {
      // An entry of a map of records read through `?.` to a record nested in it is a guarded call
      // no member call is built for; one to the entry's own field of the set is (D16743).
      const opt = g >= 0
        && nodeAt(g) is OptMember
        && ftHoldKind(tx, s) == 8
        && fnTagSetOfTy(nonNullTy(nodeTyIxOf(g))) != s
      return pn.idxArr == x && !opt
    }
    Member => {
      if pn.memObj != x { return false }
      // The receiver of a copy `fvaListSetCopy` built hands each element to an adapter.
      return ftHoldKind(tx, s) == 2
        || ftSlotOp(pn, x, g, s)
        || g >= 0 && nodeAt(g) is Call && ftTyParamListTakes(g, x, s)
        || pn.memProp == "length"
        || pn.memProp == "map" && fvaListCopyAt(g)
    }
    ForIn => {
      return pn.fiIter == x
    }
    // A record of the set's ids, maybe null, whose field a `?.` call reads: its guard reads the
    // field plainly (`drwOptGuard`).
    OptMember => {
      const gc = if g >= 0 && g < P.nodes.length { nodeAt(g) } else { null }
      return pn.omObj == x
        && gc is Call
        && gc.callFn == p
        && ftHoldKind(nonNullTy(tx), s) == 2
    }
    Program => {
      return true
    }
    // Deliveries: the destination's type is the holder's.
    LetDecl => {
      return pn.letInit == x && pn.letType < 0
    }
    // A returned holder is the result's, where the result holds its set or one decided with it.
    RetStmt => {
      if fn >= 0 { ftRetMapSubsNote(fn, s) }
      return fn >= 0
        && (rcwInferredRetTy(fn) == tx
        || ftTyHoldsDecided(rcwInferredRetTy(fn), s))
    }
    FuncDecl => {
      return pn.fnBody == x && rcwInferredRetTy(p) == tx
    }
    Call => {
      // A list seeded with fewer of the set's members than the set, handed to a hole parameter
      // whose callee writes into it, holds a wider set in that instance than its own; one whose
      // members agree there stays closures (`mintSetPartial`).
      if (
        ftHoleArg(pn, x)
        && !fnTagSetSplits(s)
        && ftSeededNarrower(x, s)
        && ftArgSlotWritten(pn, x)
      ) {
        return false
      }
      // A binding, or a named function's result, handed to a hole parameter binds it to that
      // value's own type, and the callee's writes through it join this set (D14648, D15430).
      // A literal is held so only where the callee does not hand it back.
      const ok = ftDstTakes(ftArgDstTy(pn, x), x, s)
        || ftDstTakes(ftMapSetValTy(pn, x, s), x, s)
        || ftPushRecvOf(pn, x) >= 0
        && ftMapListOfWider(ftPushRecvOf(pn, x), x, s)
        || ftPushRecvOf(pn, x) >= 0
        && ftListListOfWider(ftPushRecvOf(pn, x), x, s)
        || ftPushRecvOf(pn, x) >= 0
        && ftDstTakes(ftArrElemTy(ftPushRecvOf(pn, x)), x, s)
        || ftRecIntoMapSet(x, pn, s, fn)
        || ftTyParamListTakes(p, x, s)
        || ftTyParamMapTakes(p, x, s)
        || ftHoleArg(pn, x)
        && ftHandedHolder(x)
        && ftDeclsOnly(s)
        && !mintSetPartial(s)
        && !ftArgHandedBack(pn, x)
      // A field or element read, or a named call's result, handed on is held, so its place's
      // rep is stamped on it.
      const xp = parenPeelIx(x)
      const xn = if xp >= 0 && xp < P.nodes.length { nodeAt(xp) } else { null }
      const place = xn is Member
        || xn is Index
        || xn is Call && ftNamedCallOf(xp)
      if ok && place && !i32ListHas(ftHeldCur, x) { ftHeldCur.push(x) }
      // In the retry, a literal handed to a hole parameter is read at the call's binding; a
      // refusal there is the facts refusing, unless the callee hands it back (`ftArgDstTy`).
      if (
        !ok
        && ftUseArrow
        && ftLiteralArg(x)
        && ftHoleArg(pn, x)
        && !ftArgHandedBack(pn, x)
      ) {
        ftFactRefusal()
      }
      return ok
    }
    BinExpr => {
      if ftIsStore(pn) && pn.binRight == x {
        // A record literal into a map of the set's records is noted first, for its row.
        return ftRecIntoMapSlot(x, pn.binLeft, s, fn)
          || ftDstTakes(nodeTyIxOf(pn.binLeft), x, s)
          || ftStoredAt(x, s)
          || ftDstTakes(ftMapEntryOf(pn.binLeft, s), x, s)
      }
      if ftIsStore(pn) && pn.binLeft == x {
        // An element of a list of lists is written as its holder's slot (`ftSlotWrites`).
        const xn = if x >= 0 && x < P.nodes.length { nodeAt(x) } else { null }
        const elemOfLists = xn is Index
          && ftHoldKind(nodeTyIxOf(xn.idxArr), s) == 4
        return elemOfLists
          || ftDstTakes(tx, pn.binRight, s)
          || ftStoredAt(pn.binRight, s)
      }
      // A holder compared with `null` is read for presence alone.
      if pn.binOp == "==" || pn.binOp == "!=" {
        const other = if pn.binLeft == x { pn.binRight } else { pn.binLeft }
        return other >= 0 && nodeAt(parenPeelIx(other)) is NullLit
      }
      if pn.binOp != "??" { return false }
      return nodeTyIxOf(p) == tx
    }
    // A value's own position whose type is the holder's is a holder too, placed where it sits.
    // An `else if` link is its outer choice's value, as an arm's tail is.
    Paren | IfStmt | MatchExpr => {
      return nodeTyIxOf(p) == tx
        || pn is IfStmt && pn.ifElse == x && ftHoldsDecided(p, s)
    }
    // A function body's last statement is its result, delivered as a `return`'s value is (D15208),
    // unless the function's result is `void`, which discards it.
    // A value `if` or `match` arm's is the choice's value, which is the holder in its place.
    // A statement before a block's last hands nothing on: its value is discarded.
    Block => {
      return ftStmtDiscarded(p, x)
        || nodeTyIxOf(p) == tx
        || ftFnBodyTail(p, x, fn) && tySame(rcwInferredRetTy(fn), tx)
        || ftFnBodyTail(p, x, fn) && ftRetVoid(fn)
        || ftArmTail(p, x, g) && ftHoldsDecided(g, s)
        || ftArmTail(p, x, g) && ftJoinWiderNeed(g, s)
        || ftArmTail(p, x, g) && ftStoreInNoElse(x, g)
        || ftLoopBodyStmt(p, x, g)
    }
    // A container slot of the holder's type is a holder of holders, which `ftHoldKind` names.
    ArrayLit => {
      // A list of maps of a wider set decided with this one holds this set's maps (D15234), a
      // list of records of one holds this set's records (D15924), and a list of lists of one
      // holds this set's lists (D16804).
      if (
        ftMapListOfWider(p, x, s)
        || ftRecListOfWider(p, x, s)
        || ftListListOfWider(p, x, s)
      ) {
        return true
      }
      if !ftHolds(p, s) { return false }
      const pk = ftHoldKind(nodeTyIxOf(p), s)
      return ftDstTakes(ftArrElemTy(p), x, s) || pk == 4 || pk == 6
    }
    FieldInit => {
      return pn.fiValue == x && ftHolds(g, s)
    }
    // A spelled type, a condition, an operand or a copy into a literal names no set.
    Param | WhileStmt | NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | ErrExpr | TypeRef | BreakStmt | ContinueStmt | FieldDef | TypeDecl | ObjLit | UnionDecl | IsExpr | AsExpr | ForRange | ImportDecl | Spread | LoopVar => {
      return false
    }
  }
}

// Whether `x`, handed to a hole parameter, is a holder the parameter's instance binds as it binds
// a name of it: a binding, a named call, a literal (after the elaboration, or on the arrow rule's
// facts), or a value `if` or `match` each of whose tails is one.
function ftHandedHolder(x: i32): boolean {
  const v = parenPeelIx(x)
  if v < 0 || v >= P.nodes.length { return false }
  const vn = nodeAt(v)
  if vn is IfStmt || vn is MatchExpr {
    const ts: i32[] = []
    tailValueLeaves(v, ts)
    if ts.length == 0 { return false }
    for t in ts {
      if t == v || !ftHandedHolder(t) { return false }
    }
    return true
  }
  // A field or element of a handed holder is the place it reads, rooted as that holder is.
  if vn is Member { return ftHandedHolder(vn.memObj) }
  if vn is Index { return ftHandedHolder(vn.idxArr) }
  return vn is Ident
    || ftNamedCallOf(v)
    || (ftLate || ftUseArrow) && (ftInnerLit(v) || vn is ObjLit)
}

// The record the record solve builds literal `x` at where a write or push places it, or -1:
// `recAsgFnWidenedTy`'s answer, or the stamp a pushed literal took at a list's element that
// differs from its own record in function fields alone.
function ftLitBuiltAt(x: i32): i32 {
  const r = recAsgFnWidenedTy(x)
  if r >= 0 { return r }
  cwIxBuild()
  if x < 0 || !cwIxCovers(x) || cwIxUpKind[x] != CW_UP_ARG { return -1 }
  const c = nodeAt(cwIxUp[x])
  const f = if c is Call && c.callFn >= 0 { nodeAt(parenPeelIx(c.callFn)) } else { null }
  if !(f is Member) || f.memProp != "push" { return -1 }
  const rt = nodeRepTyIxOf(x)
  return if rt != nodeTyIxOf(x) && recFnFieldsWiden(nodeTyIxOf(x), rt) { rt } else { -1 }
}

// Whether node `x` holds set `s`, or a set the decision in progress takes as tagged with every
// member of `s`: a choice joining arms of smaller sets holds each arm's ids.
function ftHoldsDecided(x: i32, s: i32): boolean {
  return x >= 0 && ftTyHoldsDecided(nodeTyIxOf(x), s)
}

// Whether the value join `g` holds a set wider than `s` that is not yet decided, which is then
// decided with `s`: a member's id is the same in either set, so the arm hands it on (D15643).
function ftJoinWiderNeed(g: i32, s: i32): boolean {
  const ws: i32[] = []
  ftTySetsHeld(nodeTyIxOf(g), ws)
  for w in ws {
    if w != s && !fnTagSetIsTagged(w) && fnTagMembersWithin(s, w) {
      if !i32ListHas(ftAssume, w) && !i32ListHas(ftSubNeed, w) {
        ftSubNeed.push(w)
      }
      return true
    }
  }
  return false
}

// Appends to `out` each set a list, record or map type `t` holds, at any depth.
function ftTySetsHeld(t: i32, out: i32[]) {
  const seen: i32[] = []
  return ftTySetsHeldIn(t, out, seen)
}

// `ftTySetsHeld`, walking no type in `seen` twice.
function ftTySetsHeldIn(t: i32, out: i32[], seen: i32[]) {
  if t < 0 || t >= T.tys.length || i32ListHas(seen, t) { return 0 }
  seen.push(t)
  const a = tyAt(t)
  const parts: i32[] = []
  if a is TyArray { parts.push(tyElemOf(a)) }
  if a is TyMap { parts.push(tyValOf(a)) }
  if a is TyObj {
    for f in a.objFieldTypes { parts.push(f) }
  }
  for e in parts {
    const es = fnTagSetOfTy(e)
    if es >= 0 && !i32ListHas(out, es) { out.push(es) }
    ftTySetsHeldIn(e, out, seen)
  }
  return 0
}

// `ftHoldsDecided` for a type `t`.
function ftTyHoldsDecided(t: i32, s: i32): boolean {
  if ftHoldKind(t, s) > 0 { return true }
  for o in ftAssume {
    if (o != s && fnTagMembersWithin(s, o) && ftHoldKind(t, o) > 0) {
      return true
    }
  }
  return false
}

// The receiver of `xs.push(…)` call `c` where `x` is one of its arguments, else -1.
function ftPushRecvOf(c: Call, x: i32): i32 {
  const f = parenPeelIx(c.callFn)
  const fn = if f >= 0 && f < P.nodes.length { nodeAt(f) } else { null }
  if !(fn is Member) || fn.memProp != "push" || !i32ListHas(c.callArgs, x) {
    return -1
  }
  return fn.memObj
}

// Whether `p`, a list literal or a list a map is pushed onto, is a list of maps of a set decided
// with `s` that `s` is within, and `x` a map whose value carries `s`: its ids are that set's
// (D15234, D15395). A wider set not yet decided is noted to be decided with `s`, as a join's is,
// so a smaller set two such lists share is decided with both (D15394).
function ftMapListOfWider(p: i32, x: i32, s: i32): boolean {
  return ftHolderListOfWider(p, x, s, 3, 7)
}

// `ftMapListOfWider` for a record `x` whose field carries `s`, in a list of records of a wider
// set (D15924).
function ftRecListOfWider(p: i32, x: i32, s: i32): boolean {
  return ftHolderListOfWider(p, x, s, 2, 6)
}

// `ftMapListOfWider` for a list `x` of set `s`'s ids, or of such lists, in a list of lists of a
// wider set.
function ftListListOfWider(p: i32, x: i32, s: i32): boolean {
  return ftHolderListOfWider(p, x, s, 1, 4)
    || ftHolderListOfWider(p, x, s, 4, 4)
}

// Whether `x`, a holder of hold kind `xk` of set `s`, sits in `p`, a list of hold kind `pk` of a
// set decided with `s` that `s` is within; a wider set not yet decided is noted with `s`.
function ftHolderListOfWider(
  p: i32,
  x: i32,
  s: i32,
  xk: i32,
  pk: i32,
): boolean {
  if (x < 0 || x >= P.nodes.length || ftHoldKind(nodeTyIxOf(x), s) != xk) {
    return false
  }
  for o in ftAssume {
    if (
      o != s
      && fnTagMembersWithin(s, o)
      && ftHoldKind(nodeTyIxOf(p), o) == pk
    ) {
      return true
    }
  }
  const ws: i32[] = []
  ftTySetsHeld(nodeTyIxOf(p), ws)
  for w in ws {
    if (
      w != s
      && !fnTagSetIsTagged(w)
      && fnTagMembersWithin(s, w)
      && ftHoldKind(nodeTyIxOf(p), w) == pk
    ) {
      if !i32ListHas(ftSubNeed, w) { ftSubNeed.push(w) }
      return true
    }
  }
  return false
}

// Whether holder `x`, a list whose element carries set `s`, is handed by call `cx` (a method
// call's receiver included) to a parameter annotated `T[]`, `T` its declared callee's own type
// parameter, where every argument at a parameter annotated `T` or `T[]` carries `s`: the call
// binds `T` to `s`.
function ftTyParamListTakes(cx: i32, x: i32, s: i32): boolean {
  const args = ftParamOrderArgs(cx)
  const c = nodeAt(cx)
  const d = if !(c is Call) || args.length == 0 { -1 } else if nodeAt(parenPeelIx(c.callFn)) is Member { elabCallDeclOf(cx) } else { ftCalleeFn(ftCalleeSource(c)) }
  const f = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if !(f is FuncDecl) { return false }
  const i = i32ListIndexOf(args, x)
  if i < 0 || i >= f.fnParams.length { return false }
  const pn = nodeAt(f.fnParams[i])
  const tn = if pn is Param && pn.parType >= 0 { nodeAt(pn.parType) } else { null }
  if !(tn is TypeRef) { return false }
  let tp = ""
  for t in f.fnTyParams {
    if tn.tyName == t + "[]" { tp = t }
  }
  if tp == "" { return false }
  let k = 0
  while k < f.fnParams.length {
    const q = nodeAt(f.fnParams[k])
    const qt = if q is Param && q.parType >= 0 { nodeAt(q.parType) } else { null }
    if qt is TypeRef && (qt.tyName == tp || qt.tyName == tp + "[]") {
      if k >= args.length { return false }
      const t = nodeTyIxOf(args[k])
      const h = if t >= 0 && t < T.tys.length { tyAt(t) } else { null }
      const at = if qt.tyName == tp { t } else if h is TyArray { tyElemOf(h) } else { -1 }
      if fnTagSetOfTy(at) != s { return false }
    }
    k = k + 1
  }
  return true
}

// Whether holder `x`, a map whose value carries set `s`, is handed by call `cx` to a parameter
// declared a map of its callee's own type parameter `V`, where every argument at a parameter
// declared `V`, `V[]` or a map of `V` carries `s` there: the call binds `V` to `s` (D14433).
function ftTyParamMapTakes(cx: i32, x: i32, s: i32): boolean {
  const args = ftParamOrderArgs(cx)
  const c = nodeAt(cx)
  const d = if !(c is Call) || args.length == 0 { -1 } else { ftCalleeFn(ftCalleeSource(c)) }
  const f = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if !(f is FuncDecl) { return false }
  const i = i32ListIndexOf(args, x)
  if i < 0 || i >= f.fnParams.length { return false }
  const tp = ftMapOfTyParam(nodeTyIxOf(f.fnParams[i]), f)
  if tp == "" { return false }
  let k = 0
  while k < f.fnParams.length {
    const qt = nodeTyIxOf(f.fnParams[k])
    const q = if qt >= 0 && qt < T.tys.length { tyAt(qt) } else { null }
    const bare = q is TyVar && q.tvName == tp
    const list = q is TyArray && ftTyVarNamed(tyElemOf(q), tp)
    const map = ftMapOfTyParam(qt, f) == tp
    if bare || list || map {
      if k >= args.length { return false }
      const t = nodeTyIxOf(args[k])
      const h = if t >= 0 && t < T.tys.length { tyAt(t) } else { null }
      const at = if bare { t } else if list && h is TyArray { tyElemOf(h) } else if map && h is TyMap { tyValOf(h) } else { -1 }
      if fnTagSetOfTy(at) != s { return false }
    }
    k = k + 1
  }
  return true
}

// The name of `f`'s own type parameter type `t` is a map of, else "".
function ftMapOfTyParam(t: i32, f: FuncDecl): string {
  const m = if t >= 0 && t < T.tys.length { tyAt(t) } else { null }
  if !(m is TyMap) { return "" }
  const v = tyValOf(m)
  const vn = if v >= 0 && v < T.tys.length { tyAt(v) } else { null }
  return if vn is TyVar && vn.tvKind == "param" && strListHas(f.fnTyParams, vn.tvName) { vn.tvName } else { "" }
}

// Whether type `t` is the type variable `name`.
function ftTyVarNamed(t: i32, name: string): boolean {
  const v = if t >= 0 && t < T.tys.length { tyAt(t) } else { null }
  return v is TyVar && v.tvName == name
}

// Whether `x` is a statement of `p` whose value nothing reads: a module statement, or one before a
// block's last.
function ftDiscardedAt(p: i32, x: i32): boolean {
  return p >= 0
    && p < P.nodes.length
    && (nodeAt(p) is Program || ftStmtDiscarded(p, x))
}

// Whether method call `cx`'s receiver is handed to its declared callee's `T[]` parameter, every
// `T` and `T[]` argument carrying set `s` (`ftTyParamListTakes`).
function ftMethodRecvHolds(cx: i32, s: i32): boolean {
  const c = nodeAt(cx)
  if !(c is Call) { return false }
  const cf = nodeAt(parenPeelIx(c.callFn))
  return cf is Member && ftTyParamListTakes(cx, parenPeelIx(cf.memObj), s)
}

// Whether argument `x` of method call `cx` binds a parameter its declared callee annotates with a
// bare own type parameter, beside the receiver's `T[]` holding set `s` (`ftTyParamOfHeldList`).
function ftMethodTyParamArg(cx: i32, x: i32, s: i32): boolean {
  const c = nodeAt(cx)
  if !(c is Call) || !(nodeAt(parenPeelIx(c.callFn)) is Member) { return false }
  const args = ftParamOrderArgs(cx)
  const d = elabCallDeclOf(cx)
  const f = if args.length > 0 && d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if !(f is FuncDecl) { return false }
  const i = i32ListIndexOf(args, x)
  return i > 0 && ftTyParamOfHeldList(f, i, args, s)
}

// `ftRecIntoMap` for record literal `x` stored by index into slot `slot`.
function ftRecIntoMapSlot(x: i32, slot: i32, s: i32, fd: i32): boolean {
  const sn = if slot >= 0 && slot < P.nodes.length { nodeAt(slot) } else { null }
  return sn is Index && ftRecIntoMap(x, sn.idxArr, s, fd)
}

// `ftRecIntoMapSlot` for `m.set(k, x)`, call `c` storing record literal `x` into `m`'s slot.
function ftRecIntoMapSet(x: i32, c: Call, s: i32, fd: i32): boolean {
  const f = parenPeelIx(c.callFn)
  const fn = if f >= 0 && f < P.nodes.length { nodeAt(f) } else { null }
  return fn is Member
    && fn.memProp == "set"
    && c.callArgs.length == 2
    && c.callArgs[1] == x
    && ftRecIntoMap(x, fn.memObj, s, fd)
}

// Whether record literal `x`, holding set `s`, is stored into a slot of map read `m`, a map of the
// set's records (`ftHoldKind` 8), or of a wider set's decided with `s` (D16749), or a parameter
// of `fd` every call hands one, its function fields naming declared functions; the literal is
// noted for its row.
function ftRecIntoMap(x: i32, m: i32, s: i32, fd: i32): boolean {
  const lx = parenPeelIx(x)
  const ln = if lx >= 0 && lx < P.nodes.length { nodeAt(lx) } else { null }
  if !(ln is ObjLit) || m < 0 { return false }
  const direct = ftHoldKind(nodeTyIxOf(m), s) == 8
    || ftHolderListOfWider(m, lx, s, 2, 8)
  if (!direct && !(ftRecFieldsNamed(ln, s) && ftParamHolderHolds(m, s, fd))) {
    return false
  }
  ftP.mapLit.push(lx)
  ftP.mapMap.push(m)
  ftP.mapFn.push(fd)
  return true
}

// Stamps each record literal nesting a record that `set` writes into map binding `h`'s slots at the
// map's storage rep of its value (D16829).
function ftStampMapSetLits(h: i32) {
  const n = if h >= 0 && h < P.nodes.length { nodeAt(h) } else { null }
  if !(n is LetDecl) { return 0 }
  const mt = nodeTyIxOf(h)
  const m = if mt >= 0 && mt < T.tys.length { tyAt(mt) } else { null }
  if !(m is TyMap) { return 0 }
  const vt = tyValOf(m)
  const vo = if vt >= 0 && vt < T.tys.length { tyAt(vt) } else { null }
  if !(vo is TyObj) { return 0 }
  let nested = false
  for ft in vo.objFieldTypes {
    if ft >= 0 && ft < T.tys.length && tyAt(ft) is TyObj { nested = true }
  }
  if !nested { return 0 }
  const vals: i32[] = []
  const ats: i32[] = []
  if cwSlotWrittenValues(cwKeyOfDecl(h), ["[]"], vals, ats) < 0 { return 0 }
  const rt = fnTagRepTyDeepOf(vt)
  for v in vals {
    const vx = parenPeelIx(v)
    if vx >= 0 && vx < P.nodes.length && nodeAt(vx) is ObjLit {
      ftStampRecLitAt(vx, rt)
    }
  }
  return 0
}

// Stamps record literal `x` at record rep `rt`, and each record literal in its fields at that
// field's rep.
function ftStampRecLitAt(x: i32, rt: i32) {
  repStampHeldRead(x, rt)
  const n = if x >= 0 && x < P.nodes.length { nodeAt(x) } else { null }
  if !(n is ObjLit) { return 0 }
  for fx in n.objFields {
    const f = nodeAt(fx)
    if f is FieldInit {
      const v = parenPeelIx(f.fiValue)
      const ft = tyFieldTyOf(rt, f.fiName)
      if v >= 0 && v < P.nodes.length && nodeAt(v) is ObjLit && ft >= 0 {
        ftStampRecLitAt(v, ft)
      }
    }
  }
  return 0
}

// Whether every field of record literal `n` that carries set `s` names a declared function: the
// literal's set is the same at every call of the function it is written in.
function ftRecFieldsNamed(n: ObjLit, s: i32): boolean {
  for fx in n.objFields {
    const f = nodeAt(fx)
    if (
      f is FieldInit
      && fnTagSetOfTy(nodeTyIxOf(f.fiValue)) == s
      && !ftNamedFnValue(f.fiValue)
    ) {
      return false
    }
  }
  return true
}

// The record rep of the map read `m` holds: its binding's stamped map rep's value, or, for a
// parameter of `fd`, that of the first binding a call hands it; -1 where none is stamped.
function ftMapRecRep(m: i32, fd: i32): i32 {
  const v = parenPeelIx(m)
  if v < 0 || v >= P.nodes.length || !(nodeAt(v) is Ident) { return -1 }
  let d = identDeclOf(v)
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if dn is Param {
    const f = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { null }
    const pi = if f is FuncDecl { i32ListIndexOf(f.fnParams, d) } else { -1 }
    const args = if pi >= 0 { fnParamHandArgsOf(fd, pi) } else { [] }
    const a0 = if args.length > 0 { parenPeelIx(args[0]) } else { -1 }
    d = if a0 >= 0 && a0 < P.nodes.length && nodeAt(a0) is Ident { identDeclOf(a0) } else { -1 }
  }
  const r = if d >= 0 { fnTagHeldRepOf(d) } else { -1 }
  const rm = if r >= 0 && r < T.tys.length { tyAt(r) } else { null }
  return if rm is TyMap { tyValOf(rm) } else { -1 }
}
// Whether a destination of type `dst` takes the holder `x` of set `s` as it is: its own type, or a
// record of the storage `x` is built at that holds `s` or a set decided with it, so the holder's
// one rep is the destination's. A list's storage is its element's, so only its own type takes it.
function ftDstTakes(dst: i32, x: i32, s: i32): boolean {
  if dst < 0 || x < 0 || x >= P.nodes.length { return false }
  const tx = nodeTyIxOf(x)
  if dst == tx { return true }
  // Two lists nested alike whose function leaves both carry the set store the same ids (D15562).
  if ftListLeavesOfSet(dst, tx, s, 0) { return true }
  // Two maps of one key whose values carry the set have one storage, a map of its ids (D15233),
  // as does a map of a set within it, decided with it (D15535).
  const dm = if dst < T.tys.length { tyAt(dst) } else { null }
  const xm = if tx >= 0 && tx < T.tys.length { tyAt(tx) } else { null }
  if (
    dm is TyMap
    && xm is TyMap
    && tySame(tyKeyOf(dm), tyKeyOf(xm))
    && (fnTagSetOfTy(tyValOf(dm)) == s
      && (fnTagSetOfTy(tyValOf(xm)) == s
      || ftSubsetNote(fnTagSetOfTy(tyValOf(xm)), s))
      || fnTagSetOfTy(tyValOf(xm)) == s
      && ftSetDecidedWith(fnTagSetOfTy(tyValOf(dm)), s))
  ) {
    return true
  }
  const bt = nodeRepTyIxOf(x)
  return bt >= 0
    && bt < T.tys.length
    && dst < T.tys.length
    && tyAt(dst) is TyObj
    && tyAt(bt) is TyObj
    && fieldStorageEq(dst, bt)
    && ftTyHoldsDecided(dst, s)
}

// Whether set `o` is `s`, or a set the plan in progress decides with `s` that `s` is within.
function ftSetDecidedWith(o: i32, s: i32): boolean {
  if o == s { return true }
  return o >= 0 && i32ListHas(ftAssume, o) && fnTagMembersWithin(s, o)
}

// Whether set `o` is a set other than `s` within it, noting it for the decision in progress.
function ftSubsetNote(o: i32, s: i32): boolean {
  if o < 0 || o == s || !fnTagMembersWithin(o, s) { return false }
  if !i32ListHas(ftSubNeed, o) { ftSubNeed.push(o) }
  return true
}

// Notes, for function `fn` whose result is a map of set `s`, each returned map's set within `s`:
// its returns join as a value join's tails do (D15393).
function ftRetMapSubsNote(fn: i32, s: i32) {
  if ftHoldKind(rcwInferredRetTy(fn), s) != 3 { return 0 }
  const fd = nodeAt(fn)
  if !(fd is FuncDecl) || fd.fnBody < 0 { return 0 }
  const rv: i32[] = []
  collectRetValues(fd.fnBody, rv)
  for v in rv {
    const vt = nodeTyIxOf(v)
    const vm = if vt >= 0 && vt < T.tys.length { tyAt(vt) } else { null }
    if vm is TyMap { ftSubsetNote(fnTagSetOfTy(tyValOf(vm)), s) }
  }
  return 0
}

// Notes, for value `if` or `match` `x` holding maps of set `s`, each tail map's set within `s`;
// holding `s` in a record or list, each set within `s` a record or list literal tail carries
// (D15303), so the tails' sets are decided with the join's.
function ftJoinMapTailsNote(x: i32, s: i32) {
  const xn = if x >= 0 && x < P.nodes.length { nodeAt(x) } else { null }
  if !(xn is IfStmt) && !(xn is MatchExpr) { return 0 }
  const map = ftHoldKind(nodeTyIxOf(x), s) == 3
  if !map && !ftHolds(x, s) { return 0 }
  const ls: i32[] = []
  tailValueLeaves(x, ls)
  for l in ls {
    const lt = nodeTyIxOf(l)
    const lm = if lt >= 0 && lt < T.tys.length { tyAt(lt) } else { null }
    const lx = parenPeelIx(l)
    const lit = lx >= 0
      && lx < P.nodes.length
      && (nodeAt(lx) is ObjLit || nodeAt(lx) is ArrayLit)
    if map && lm is TyMap { ftSubsetNote(fnTagSetOfTy(tyValOf(lm)), s) }
    else if !map && lit { ftSubsetsNoteIn(lt, s, []) }
  }
  return 0
}

// Notes each set within `s` other than it that a function inside type `t` carries, as
// `ftSubsetNote` does; true, so it can close a test.
function ftSubsetsNoteIn(t: i32, s: i32, seen: i32[]): boolean {
  if t < 0 || t >= T.tys.length || i32ListHas(seen, t) { return true }
  seen.push(t)
  const o = tyAt(t)
  match o {
    TyFunc => {
      ftSubsetNote(fnTagSetOfTy(t), s)
    }
    TyArray => {
      ftSubsetsNoteIn(tyElemOf(o), s, seen)
    }
    TyObj => {
      for f in o.objFieldTypes { ftSubsetsNoteIn(f, s, seen) }
    }
    // A map's value is held as its own holder's (`ftDstTakes`'s map rule); no other kind holds a set.
    TyMap | TyPrim | TyErr | TyUnion | TyNullable | TyVar | TyLit | TyNeg => {}
  }
  return true
}

// Whether `a` and `b` are lists nested to one depth whose function leaves store alike: `b`'s
// carrying set `s` and `a`'s that set or one decided with it, or `a`'s carrying `s` and `b`'s a
// set within it, which is then decided with `s`; or whose records store alike and hold a decided set.
function ftListLeavesOfSet(a: i32, b: i32, s: i32, depth: i32): boolean {
  const ao = if a >= 0 && a < T.tys.length { tyAt(a) } else { null }
  const bo = if b >= 0 && b < T.tys.length { tyAt(b) } else { null }
  if !(ao is TyArray) || !(bo is TyArray) { return false }
  const ae = if !tyElemOpen(ao) && tyElemOf(ao) < T.tys.length { tyAt(tyElemOf(ao)) } else { null }
  const be = if !tyElemOpen(bo) && tyElemOf(bo) < T.tys.length { tyAt(tyElemOf(bo)) } else { null }
  // A flat list of functions is its own type's or a decided set's (`ftHoldsDecided`).
  if ae is TyFunc && be is TyFunc {
    if depth == 0 { return false }
    const as = fnTagSetOfTy(tyElemOf(ao))
    const bs = fnTagSetOfTy(tyElemOf(bo))
    return bs == s && ftSetDecidedWith(as, s) || as == s && ftSubsetNote(bs, s)
  }
  if ae is TyObj && be is TyObj {
    return fieldStorageEq(tyElemOf(ao), tyElemOf(bo))
      && ftTyHoldsDecided(tyElemOf(ao), s)
      && ftSubsetsNoteIn(tyElemOf(bo), s, [])
  }
  return ftListLeavesOfSet(tyElemOf(ao), tyElemOf(bo), s, depth + 1)
}

// Whether `x` is a statement of block `b` other than its last.
function ftStmtDiscarded(b: i32, x: i32): boolean {
  const bn = nodeAt(b)
  return bn is Block
    && bn.blkStmts.length > 0
    && bn.blkStmts[bn.blkStmts.length - 1] != x
    && i32ListHas(bn.blkStmts, x)
}

// Whether `x` is a statement of block `b`, the body of loop `g`, whose value is discarded.
function ftLoopBodyStmt(b: i32, x: i32, g: i32): boolean {
  const bn = nodeAt(b)
  const gn = if g >= 0 && g < P.nodes.length { nodeAt(g) } else { null }
  return bn is Block
    && i32ListHas(bn.blkStmts, x)
    && (gn is ForIn && gn.fiBody == b
    || gn is ForRange && gn.frBody == b
    || gn is WhileStmt && gn.whileBlk == 0 && gn.whileBody == b)
}

// Whether `x` is a store ending the arm of `if` `g` with no `else`, whose value no read takes.
function ftStoreInNoElse(x: i32, g: i32): boolean {
  const xn = nodeAt(x)
  const gn = nodeAt(g)
  return xn is BinExpr && ftIsStore(xn) && gn is IfStmt && gn.ifElse < 0
}

// Whether `x` is the last statement of block `b`, an arm of the `if` or `match` `g`.
function ftArmTail(b: i32, x: i32, g: i32): boolean {
  if g < 0 || g >= P.nodes.length { return false }
  const bn = nodeAt(b)
  if (
    !(bn is Block)
    || bn.blkStmts.length == 0
    || bn.blkStmts[bn.blkStmts.length - 1] != x
  ) {
    return false
  }
  const gn = nodeAt(g)
  return gn is IfStmt && (gn.ifThen == b || gn.ifElse == b)
    || gn is MatchExpr && i32ListHas(gn.matchBodies, b)
}

// Whether `x` is the last statement of block `b`, the body of function declaration `fn`.
function ftFnBodyTail(b: i32, x: i32, fn: i32): boolean {
  if fn < 0 || fn >= P.nodes.length { return false }
  const f = nodeAt(fn)
  const bn = nodeAt(b)
  return f is FuncDecl
    && f.fnBody == b
    && bn is Block
    && bn.blkStmts.length > 0
    && bn.blkStmts[bn.blkStmts.length - 1] == x
}

// The parameter type the callee of `c` declares for argument `x`, or -1.
function ftArgDstTy(c: Call, x: i32): i32 {
  if c.callFn == x { return -1 }
  const cb = ftListCallbackDst(c, x)
  if cb >= 0 { return cb }
  const ft = nodeTyIxOf(c.callFn)
  if ft < 0 || ft >= T.tys.length { return -1 }
  const f = tyAt(ft)
  if !(f is TyFunc) { return -1 }
  let i = 0
  while i < c.callArgs.length {
    if c.callArgs[i] == x {
      if i >= f.fnParamTypes.length { return -1 }
      // In the check's retry, a hole parameter a list or record literal is handed straight to is
      // bound at the call to the literal's own type, which keys the callee's instance. A parameter
      // the callee hands back reaches the call's result, which that binding does not type.
      const pt = f.fnParamTypes[i]
      if (
        ftUseArrow
        && tyHasTyVar(pt)
        && ftLiteralArg(x)
        && !ftArgHandedBack(c, x)
      ) {
        return nodeTyIxOf(x)
      }
      return pt
    }
    i = i + 1
  }
  return -1
}

// The callback type a list's `map` or `filter` call `c` declares for argument `x`, or -1: the
// built-in calls it with each element, so a callback taking the element type is delivered at its own.
function ftListCallbackDst(c: Call, x: i32): i32 {
  const f = parenPeelIx(c.callFn)
  if f < 0 || c.callArgs.length != 1 || c.callArgs[0] != x { return -1 }
  const m = nodeAt(f)
  if !(m is Member) || m.memProp != "map" && m.memProp != "filter" { return -1 }
  const lt = nodeTyIxOf(m.memObj)
  const xt = nodeTyIxOf(x)
  if lt < 0 || lt >= T.tys.length || xt < 0 || xt >= T.tys.length { return -1 }
  const l = tyAt(lt)
  const xf = tyAt(xt)
  if !(l is TyArray) || !(xf is TyFunc) || xf.fnParamTypes.length != 1 {
    return -1
  }
  if xf.fnParamTypes[0] == tyElemOf(l) { return xt }
  return -1
}

// The element type of list literal `p`, or -1.
function ftArrElemTy(p: i32): i32 {
  const t = nodeTyIxOf(p)
  if t < 0 || t >= T.tys.length { return -1 }
  const a = tyAt(t)
  if a is TyArray { return tyElemOf(a) }
  return -1
}

// Whether `x` is an argument of call `c` to a declared function whose parameter there has no
// annotation, which each instance types; the elaboration marks partial a set an instance reads
// other than through calls.
function ftHoleArg(c: Call, x: i32): boolean {
  const d = ftCallDeclOf(c)
  if d < 0 || d >= P.nodes.length { return false }
  const fd = nodeAt(d)
  if !(fd is FuncDecl) { return false }
  let i = 0
  while i < c.callArgs.length && i < fd.fnParams.length {
    if c.callArgs[i] == x {
      const pn = nodeAt(fd.fnParams[i])
      return pn is Param && pn.parType < 0 && pn.parRest == 0
    }
    i = i + 1
  }
  return false
}

// The declaration call `c` names, through a module-scope `const` holding a lambda; -1 for none.
function ftCallDeclOf(c: Call): i32 {
  const cf = parenPeelIx(c.callFn)
  const d0 = identDeclOf(cf)
  // A lambda a module-scope `const` holds is called through that binding (D15775).
  const atTop = d0 >= 0
    && d0 < P.nodes.length
    && nodeAt(d0) is LetDecl
    && recEnclosingFn(d0) < 0
  return if atTop { cwCalleeDeclOf(cf) } else { d0 }
}

// Whether every member of set `s` is a declared function. A flat list of one member is handed on
// by name, as the function alone is.
function ftDeclsOnly(s: i32): boolean {
  for m in fnTagMembers(s) {
    if m < 0 || m >= P.nodes.length || !(nodeAt(m) is FuncDecl) { return false }
  }
  return true
}

// Whether function `f` takes a parameter with no annotation.
function ftOpenFn(f: i32): boolean {
  if f < 0 || f >= P.nodes.length { return false }
  const fd = nodeAt(f)
  if !(fd is FuncDecl) { return false }
  for p in fd.fnParams {
    if p >= 0 && p < P.nodes.length {
      const pn = nodeAt(p)
      if pn is Param && pn.parType < 0 { return true }
    }
  }
  return false
}

// Whether `x` is a call of a named top-level function with no type parameter and no
// un-annotated parameter, whose one result is the value of every such call.
function ftNamedCallOf(x: i32): boolean {
  const c = nodeAt(parenPeelIx(x))
  if !(c is Call) { return false }
  const d = ftNamedFn(parenPeelIx(c.callFn))
  const f = if d >= 0 { nodeAt(d) } else { null }
  return f is FuncDecl && f.fnTyParams.length == 0 && !ftOpenFn(d)
}

// Whether read `r` under parent `q` is the initialiser of a `let` written from another function
// than the one declaring it: a capture cell the read's lambda is a peer of (D15435).
function ftSeedsCellAt(r: i32, q: i32): boolean {
  const qn = if q >= 0 && q < P.nodes.length { nodeAt(q) } else { null }
  return qn is LetDecl
    && qn.letKw == "let"
    && parenPeelIx(qn.letInit) == r
    && cwLetWrittenInClosure(q)
}

// Whether every read of the un-annotated `const` declared at `c` is the initialiser of a `let`, so
// its value is that `let`'s, as the `let` spelling's is (D15434).
function ftConstSeedsLets(c: i32): boolean {
  const cn = nodeAt(c)
  if !(cn is LetDecl) || cn.letKw != "const" || cn.letType >= 0 { return false }
  cwIxWant()
  let any = false
  const ow = cwOccWalk(c)
  while cwOccNext(ow) {
    const u = cwIxNode[ow.row]
    if cwIxKind[ow.row] == CW_OCC_USE {
      const q = if u >= 0 && cwIxCovers(u) { cwIxParent[u] } else { -1 }
      const qn = if q >= 0 && q < P.nodes.length { nodeAt(q) } else { null }
      if !(qn is LetDecl) || qn.letKw != "let" || parenPeelIx(qn.letInit) != u {
        return false
      }
      any = true
    }
  }
  return any
}

// Whether some read of the `const` declared at `c` is the initialiser of a `let` written from
// another function than the one declaring it.
function ftConstSeedsCell(c: i32): boolean {
  cwIxWant()
  const ow = cwOccWalk(c)
  while cwOccNext(ow) {
    const u = cwIxNode[ow.row]
    const q = if cwIxKind[ow.row] == CW_OCC_USE && u >= 0 && u < cwIxParent.length { cwIxParent[u] } else { -1 }
    if ftSeedsCellAt(u, q) { return true }
  }
  return false
}

// The function an un-annotated `const` declared at `d` names bare, which a call through it calls
// directly; `d` itself otherwise (D15441, D15926).
function ftLocalAliasedFn(d: i32): i32 {
  if d < 0 || d >= P.nodes.length { return d }
  const n = nodeAt(d)
  if !(n is LetDecl) || n.letKw != "const" || n.letType >= 0 || n.letInit < 0 {
    return d
  }
  const v = parenPeelIx(n.letInit)
  if v < 0 || v >= P.nodes.length || !(nodeAt(v) is Ident) { return d }
  const f = identDeclOf(v)
  return if f >= 0 && f < P.nodes.length && nodeAt(f) is FuncDecl { f } else { d }
}

// The check's facts (`check_arrow_facts.vl`), and whether the plan reads them in place of the
// elaboration's mint facts: only on a retry of a set the check's own reading left undecided.
let ftCheckFacts: i32[] = []
// The sets the check's retry refused with complete facts (none open, none split).
let ftRetryRefused: i32[] = []
// Whether the retry in progress met a refusal that reads the facts.
let ftFactRefused = false

// Notes, during the retry, that a test reading the facts refused; false, for the caller to return.
function ftFactRefusal(): boolean {
  if ftUseArrow { ftFactRefused = true }
  return false
}
let ftCheckFactSets: {[i32]: boolean} = Map()
let ftUseArrow = false

// Fact `r`'s set.
function ftFactSetOf(r: i32): i32 {
  return if ftUseArrow { arrowFactSetOf(r) } else { mintFactSetOf(r) }
}

// Fact `r`'s call node.
function ftFactCallOf(r: i32): i32 {
  return if ftUseArrow { arrowFactCallOf(r) } else { mintFactCallOf(r) }
}

// What each member of fact `r`'s set returns at its call.
function ftFactRsOf(r: i32): i32[] {
  return if ftUseArrow { arrowFactRsOf(r) } else { mintFactRsOf(r) }
}

// The declared function of fact `r`'s call.
function ftFactFnOf(r: i32): i32 {
  return if ftUseArrow { arrowFactFnOf(r) } else { mintFactFnOf(r) }
}

// The fact standing for call `at` where fact `r` stands: in its instance after the elaboration,
// through its set before it, since an instance is keyed by the set.
function ftFactInScope(r: i32, at: i32): i32 {
  return if ftUseArrow { arrowFactAt(at, arrowFactSetOf(r)) } else { mintFactInScope(r, at) }
}

// Whether some call through parameter `i` of `decl` goes through set `s`.
function ftParamTakes(decl: i32, i: i32, s: i32): boolean {
  return if ftUseArrow { arrowParamTakes(decl, i, s) } else { mintParamTakes(decl, i, s) }
}

// Every set `ftParamTakes` finds parameter `i` of `decl` taking.
function ftParamTakesSets(decl: i32, i: i32): i32[] {
  return if ftUseArrow { arrowParamTakesSets(decl, i) } else { mintParamTakesSets(decl, i) }
}

// The sets calls through parameter `i` of `decl` go through.
function ftParamSetsOf(decl: i32, i: i32): i32[] {
  return if ftUseArrow { arrowParamTakesSets(decl, i) } else { mintParamSetsOf(decl, i) }
}

// A set the decision after the elaboration tagged though the check refused it with every call's
// facts in hand, or -1. The late decision admits only the sets the facts exclude (open argument
// types, a lambda or generic body, a lambda member, split results); any other is a second decider.
function ftLateOutsideExclusions(): i32 {
  for s in ftRetryRefused {
    if fnTagSetIsTagged(s) { return s }
  }
  return -1
}

// The parameters declaration `d` hands back: the elaboration's after it, the check's own reading
// of the body (`check_hand_back.vl`) during the check's retry, by the elaboration's rules: one
// parameter handed back, else several one bare type parameter annotates (D15461).
function ftRetParamsOf(d: i32): i32[] {
  if !ftUseArrow { return mintRetParamsOf(d) }
  const f = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if !(f is FuncDecl) || f.fnBody < 0 { return [] }
  const i = handBackHoleIx(f, 0)
  return if i >= 0 { [i] } else { handBackShared(d, f) }
}

// Whether the callee of call `c` hands back the parameter argument `x` is passed to.
function ftArgHandedBack(c: Call, x: i32): boolean {
  const back = ftRetParamsOf(ftCallDeclOf(c))
  let i = 0
  while i < c.callArgs.length {
    if c.callArgs[i] == x { return i32ListHas(back, i) }
    i = i + 1
  }
  return false
}

// Whether the callee of call `c` writes an element or a field of the binding argument `x` reads,
// through the parameter it is handed to (`cwSlotWrittenValues`, which follows the alias).
function ftArgSlotWritten(c: Call, x: i32): boolean {
  const v = parenPeelIx(x)
  const b = if v >= 0 && v < P.nodes.length && nodeAt(v) is Ident { identDeclOf(v) } else { -1 }
  const callee = identFnDeclOf(parenPeelIx(c.callFn))
  if b < 0 || callee < 0 { return false }
  const paths: string[] = ["[]"]
  const t = nodeTyIxOf(v)
  const tt = if t >= 0 && t < T.tys.length { tyAt(t) } else { null }
  if tt is TyObj {
    for nm in tt.objFieldNames { paths.push(nm) }
  }
  for nm in paths {
    const vals: i32[] = []
    const ats: i32[] = []
    cwSlotWrittenValues(cwKeyOfDecl(b), [nm], vals, ats)
    for at in ats {
      if ftWithinDecl(at, callee) { return true }
    }
  }
  return false
}

// Whether `x` names a binding initialised with a list literal whose elements name fewer of set
// `s`'s members than `s` has.
function ftSeededNarrower(x: i32, s: i32): boolean {
  const v = parenPeelIx(x)
  const b = if v >= 0 && v < P.nodes.length && nodeAt(v) is Ident { identDeclOf(v) } else { -1 }
  const bn = if b >= 0 && b < P.nodes.length { nodeAt(b) } else { null }
  const li = if bn is LetDecl { parenPeelIx(bn.letInit) } else { -1 }
  const ln = if li >= 0 && li < P.nodes.length { nodeAt(li) } else { null }
  if !(ln is ArrayLit) { return false }
  const named: i32[] = []
  for e in ln.arrElems {
    const ex = parenPeelIx(e)
    const ed = if ex >= 0 && ex < P.nodes.length && nodeAt(ex) is Ident { identFnDeclOf(ex) } else { -1 }
    if ed < 0 { return false }
    if !i32ListHas(named, ed) { named.push(ed) }
  }
  return named.length > 0 && named.length < fnTagMembers(s).length
}

// Whether node `x` sits in the body of declaration `d`.
function ftWithinDecl(x: i32, d: i32): boolean {
  let p = if x >= 0 && x < cwIxParent.length { cwIxParent[x] } else { -1 }
  while p >= 0 && p < P.nodes.length {
    if p == d { return true }
    p = if p < cwIxParent.length { cwIxParent[p] } else { -1 }
  }
  return false
}

// Whether `x` is a list or record literal.
function ftLiteralArg(x: i32): boolean {
  const v = parenPeelIx(x)
  const n = if v >= 0 && v < P.nodes.length { nodeAt(v) } else { null }
  return n is ArrayLit || n is ObjLit
}
