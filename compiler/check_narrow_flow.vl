// The join of two types a place may hold after an `if`. A place holds a member of its declared
// type, so a numeric member is never absorbed by one it widens to: `i32` and `f64` join to
// `i32 | f64`, not `f64`, which is how the value is stored (D2627). Otherwise `joinTys`.
function narJoinTys(a: i32, b: i32): i32 {
  if a < 0 || b < 0 { return joinTys(a, b) }
  if numericVariantUncovered(a, b) || numericVariantUncovered(b, a) {
    return joinVariantTys(a, b)
  }
  joinTys(a, b)
}

// The type a place holds after ledger row `i` on the arm whose own statement depth is `ownDepth`:
// a row at that depth runs whenever the arm does and replaces `cur`; a deeper one is conditional,
// so the two join (D1846).
function narFoldRow(cur: i32, i: i32, ownDepth: i32): i32 {
  // A kill (a call or alias that may write, an unkeyable write) leaves the place unknown, which
  // only a later write at the arm's own depth replaces.
  if narClobRetired[i] == 2 { return NAR_UNKNOWN }
  if narClobDepths[i] == ownDepth { return narClobTys[i] }
  if cur == NAR_UNKNOWN { return NAR_UNKNOWN }
  narJoinTys(cur, narClobTys[i])
}

// What each place holds here, parallel to `places`: the arm join's start for a path through an
// `if` that carries no condition fact about it. -1 where the place does not resolve.
export function narKeysNowTys(places: i32[]): i32[] {
  const out: i32[] = []
  let i = 0
  while i < places.length {
    out.push(narKeyNowTy(places[i]))
    i = i + 1
  }
  out
}

// What the place `p` reads at here: a bare name's binding, a path's live overlay, else its
// field or cell type off the prefix it hangs from.
function narKeyNowTy(p: i32): i32 {
  if !placeIsPath(p) { return declTyOf(placeDecl(p)) }
  const ov = narrowedPathTy(p)
  if ov >= 0 { return ov }
  const steps = keySteps(placeText(p))
  if steps.length == 0 { return -1 }
  const pres = keyStepPrefixTys(p, steps)
  const last = steps.length - 1
  const pt = pres[last]
  if pt < 0 { return -1 }
  if steps[last][0] == '.' {
    return placeFieldTy(pt, steps[last].slice(1, steps[last].length), false)
  }
  placeElemTy(pt)
}

// What place `p` read at the head of the `if` behind `f`: its type now with every in-place
// write since then undone, then redone. -1 where the place does not resolve.
function narHeadTy(f: IfChk, p: i32): i32 {
  let j = narIpAt.length - 1
  while j >= f.ipMark {
    narIpApply(f, j, true)
    j = j - 1
  }
  const t = narKeyNowTy(p)
  j = f.ipMark
  while j < narIpAt.length {
    narIpApply(f, j, false)
    j = j + 1
  }
  t
}

// Undo in place, newest first and journalled, the in-place rows from `lo` that touch a scope
// below depth `headDepth` or a path slot below `headNp`: the else arm, and the code after a then
// arm that exits, start at the state the condition saw (D6690). The undo rows start at the
// journal's length on entry, which `narIpRedoArm` reads.
export function narIpUndoArm(lo: i32, headDepth: i32, headNp: i32) {
  let j = narIpAt.length - 1
  while j >= lo {
    const at = narIpAt[j]
    if narIpScope[j] {
      if at < headDepth && narIpOld[j] >= 0 {
        narSetScope(at, narIpSlot[j], narIpOld[j])
      }
    } else if at < headNp {
      narSetInv(at, narIpOld[j])
    }
    j = j - 1
  }
  0
}

// Re-apply the then arm's in-place writes that the undo rows `lo` to `hi` lifted, once the else
// arm is checked. A place the else arm also widened keeps the wider of the two.
export function narIpRedoArm(lo: i32, hi: i32) {
  let j = hi - 1
  while j >= lo {
    const at = narIpAt[j]
    const was = narIpOld[j]
    if narIpScope[j] {
      const s = narIpSlot[j]
      const now = slotTyAt(s, at)
      if now == narIpNew[j] || (now >= 0 && assignable(now, was)) {
        narSetScope(at, s, was)
      }
    } else if npInvBy[at] == narIpNew[j] || was >= 0 {
      narSetInv(at, was)
    }
    j = j - 1
  }
  0
}

// The flow-narrowing join at the end of an `if` (DECISIONS.md, "Flow narrowing: per-path facts
// meet at joins"). Each path through the `if` starts at the condition's fact for a key, or at its
// entry type, and folds its arm's ledger rows; the key reads at the meet of the surviving paths
// below the `if`. `sum*` receives one summary row per key joined, for `narCompactIf`.
export function applyArmJoins(
  f: IfChk,
  elseHi: i32,
  thenDiverges: boolean,
  elseDiverges: boolean,
  condIx: i32,
  sumPlaces: i32[],
  sumTys: i32[],
  sumPrev: i32[],
  sumRet: i32[],
) {
  // Both arms diverging leaves no code below to describe.
  if thenDiverges && elseDiverges { return 0 }
  const ix = f.ifIx
  const keys: i32[] = []
  const slot: {[i32]: i32} = Map()
  const kEnt: i32[] = []
  const kThen: i32[] = []
  const kElse: i32[] = []
  const kCond: boolean[] = []
  const kOk: boolean[] = []
  const kRet: i32[] = []
  const kElseSeen: boolean[] = []
  // One pass over the subtree's rows, in order, folding each into its key's two paths.
  let i = f.clobMark
  const end = narClobPlace.length
  while i < end {
    const pl = narClobPlace[i]
    if narClobHits(i, pl) {
      let k = slot[pl] ?? -1
      if k < 0 {
        k = keys.length
        slot[pl] = k
        keys.push(pl)
        // A key the condition tests starts each arm at that arm's fact, from the entry the head
        // saw. Any other key enters both arms at what it held on entry, which a row inside an
        // arm's own narrowing cannot tell (D4198).
        const ti = i32ListLastIx(f.tnPlaces, pl)
        const ei = i32ListLastIx(f.enPlaces, pl)
        let ent = narHeadTy(f, pl)
        if ent < 0 { ent = narClobPrev[i] }
        let ts = ent
        let es = ent
        const cond = ti >= 0 || ei >= 0
        if cond {
          if ti >= 0 { ent = f.tnEnt[ti] } else { ent = f.enEnt[ei] }
          ts = ent
          es = ent
          if ti >= 0 { ts = f.tnTys[ti] }
          if ei >= 0 { es = f.enTys[ei] }
        }
        kEnt.push(ent)
        kThen.push(ts)
        kElse.push(es)
        kCond.push(cond)
        // A condition fact over a path one arm leaves is the post-guard rule's, not this join's.
        kOk.push(
          ent >= 0
            && !crCondRetired(condIx, placeText(pl))
            && !(cond && (thenDiverges || elseDiverges)),
        )
        kRet.push(0)
        kElseSeen.push(false)
      }
      // A call that can write the place leaves it unknown, and a merged entry would hand the
      // fact back (D1849).
      const r = narClobRetired[i]
      if r == 1 { kRet[k] = 1 }
      if i < f.thenLo {
        // A write in the condition may or may not have run on either path.
        if kCond[k] || r == 2 {
          kOk[k] = false
        } else {
          kThen[k] = narJoinTys(kThen[k], narClobTys[i])
          kElse[k] = narJoinTys(kElse[k], narClobTys[i])
        }
      } else if i < f.thenHi {
        kThen[k] = narFoldRow(kThen[k], i, f.thenOwnDepth)
      } else if i >= f.elseLo && i < elseHi {
        kElse[k] = narFoldRow(kElse[k], i, f.elseOwnDepth)
        kElseSeen[k] = true
      }
    }
    i = i + 1
  }
  let k = 0
  while k < keys.length {
    const pl = keys[k]
    const nm = placeText(pl)
    // This pass's answer replaces an earlier check's, which may have been at other types.
    narIfEnds[i32ToStr(ix) + "#" + nm] = -1
    // A path fact over a type variable or a hole meets per instance, and the join is banked
    // once per node, so such a key keeps the type the arms left it at (D3286).
    if tyHasHole(kEnt[k]) || tyHasHole(kThen[k]) || tyHasHole(kElse[k]) {
      kOk[k] = false
    }
    if kOk[k] {
      // An `else if` link has no block of its own: its end type is its own chain's join,
      // which counts the path where none of its arms ran (D2627).
      let chainEnd = -1
      if kElseSeen[k] { chainEnd = narChainEndTy(ix, nm) }
      let jt = -1
      // No else arm is still a path through the `if`: the fall-through, at the else fact.
      let ee = kElse[k]
      if chainEnd >= 0 { ee = chainEnd }
      const te = kThen[k]
      // A kill on any surviving path survives the meet.
      if thenDiverges {
        if ee != NAR_UNKNOWN { jt = ee }
      } else if elseDiverges {
        if te != NAR_UNKNOWN { jt = te }
      } else if ee != NAR_UNKNOWN && te != NAR_UNKNOWN {
        // The ELSE side first, so a one-armed join renders in the declaration's own order
        // (`i64 | boolean`, not `boolean | i64`) — the diagnostic below reads it.
        jt = narJoinTys(ee, te)
      }
      narNoteChainEnd(ix, nm, jt)
      if jt >= 0 {
        sumPlaces.push(pl)
        sumTys.push(jt)
        sumPrev.push(kEnt[k])
        sumRet.push(kRet[k])
        // A chain link's code below is its parent's, which joins it through `chainEnd`. An
        // `if` in value position installs when its statement ends, the boundary the
        // emitter's push follows, and only as that statement's whole value.
        if !f.isElseArm {
          if narIfIsStmt(ix) {
            narInstallJoin(ix, pl, jt, chainEnd >= 0)
          } else {
            narDeferJoin(ix, pl, jt, chainEnd >= 0)
          }
        }
      }
    }
    k = k + 1
  }
  0
}

// Install the joins held for statement `st`, which has just been checked.
function narApplyDeferred(st: i32) {
  while narDefStmt.length > 0 && narDefStmt[narDefStmt.length - 1] == st {
    const k = narDefStmt.length - 1
    narInstallJoin(st, narDefKey[k], narDefTy[k], narDefChain[k])
    narDefStmtPop()
    narDefKeyPop()
    narDefTyPop()
    narDefChainPop()
  }
  0
}

// Install the join `jt` of place `p` for the code below the `if` at `ix`, in the block holding
// the `if` — the lifetime the emitter's push after the statement has — and bank it for that push.
function narInstallJoin(ix: i32, p: i32, jt: i32, viaChain: boolean) {
  const key = placeText(p)
  if placeIsPath(p) {
    // Against what the path reads at now, not at entry: an arm's write may have retired the
    // entry narrowing in place. A retired innermost entry is replaced even by an equal join, so
    // the reads and writes below resolve through a live one (D3316).
    const inner = narrowedPathIx(p)
    const retired = inner >= 0 && narrowedPathTyRaw(p) < 0
    if jt != narKeyNowTy(p) || retired {
      npKeysPush(p)
      npTysPush(jt)
      npInvByPush(-1)
      npEpochsPush(narFnEpoch)
      npSettlePush(-2)
      npCapByPush(-1)
      npAsgPush(0)
      recordArmJoin(ix, key, jt)
    }
    return 0
  }
  const s = placeDecl(p)
  const cur = declTyOf(s)
  if cur >= 0 && jt != cur {
    // Banked like the post-guard fall-through, so a write below is checked against storage
    // and a call that may write the name ends it (D2390).
    noteNarShadow(s, cur, NAR_KIND_POSTGUARD)
    declareSlot(s, jt)
    narFitCompanions(p, cur, jt)
    recordArmJoin(ix, key, jt)
  } else if viaChain {
    // The `else if` chain's join reaches the emitter only at this statement (D2627).
    recordArmJoin(ix, key, jt)
  }
  0
}

// Retire in place every narrowing layer of `name` in the current function, inside the loop
// barrier, that does not admit `now`, the type the write left it at: each reads `store` after.
function narRetireLayers(s: i32, now: i32, store: i32) {
  const base = crFnBase()
  let bar = 0
  if reScopeBases.length > 0 { bar = reScopeBases[reScopeBases.length - 1] }
  let e = slotLayerTop(s)
  while e >= 0 {
    const d = slotLayerDepth(e)
    if d < base || d < bar || crFirstBank(s, d) < 0 { return 0 }
    const t = slotLayerTy(e)
    if t >= 0 && !assignable(now, t) { narSetScope(d, s, store) }
    e = slotLayerPrev(e)
  }
  0
}

// The type a write of a value typed `rt` leaves a narrowed name at: the member of `store` it
// re-narrows to, or `pre`, what the name held, when the write names no single member and `pre`
// admits it. `store` when neither holds.
function writeNarrowAfter(store: i32, pre: i32, rt: i32): i32 {
  const rn = writeMemberTy(store, rt)
  if rn == store && rt >= 0 && pre >= 0 && writeLandsWithin(store, rt, pre) {
    return pre
  }
  rn
}

// D1470 — an `__array_new_default__` hole that nothing pinned, defaulted to `i32` in place;
// false for every other unresolved hole. `array.new_default` promises the element's zero and
// says nothing about which element, so `i32` is honest here where `const xs = []` is not.
// Asked from `flushUninferred`, after every pin has had its chance.
function arrDefHoleToI32(ty: i32) {
  if !arrDefRowIsCall(ty) { return false }
  const t = tyAt(ty)
  if t is TyArray {
    if t.aElem < 0 {
      arrDefPinHoleElem(ty)
      return true
    }
  }
  false
}

// Default to `i32`, after every pin, the element of each empty `[]` that is a record literal's
// field value (D5344) or an index store's value (D5471) and that nothing pinned: nothing stores
// an element into it, so no read can tell which element it holds, and the record or map gets a
// shape it can be built and stored at. A store's `[]` takes what its destination holds first.
export function objFieldHolesToI32() {
  const dstRows: i32[] = []
  const dstElems: i32[] = []
  // The record literals and index stores in arena order: a pin below adds no node and changes no
  // node's kind, so this walk finds every node the second loop acts on.
  const sites: i32[] = []
  let j = 0
  while j < P.nodes.length {
    const st = idxStoreOf(j)
    if st >= 0 {
      idxStoreNote(j, st, dstRows, dstElems)
      sites.push(j)
    } else if nodeAt(j) is ObjLit {
      sites.push(j)
    }
    j = j + 1
  }
  for i in sites {
    const n = nodeAt(i)
    if n is ObjLit {
      let f = 0
      while f < n.objFields.length {
        const fi = nodeAt(n.objFields[f])
        if fi is FieldInit {
          const v = fi.fiValue
          if v >= 0 && nodeAt(v) is ArrayLit && unresolvedHole(nodeTyIxOf(v)) {
            arrDefPinHoleElem(nodeTyIxOf(v))
          }
        }
        f = f + 1
      }
    }
    const st = idxStoreOf(i)
    if st >= 0 && nodeAt(st) is ArrayLit && unresolvedHole(nodeTyIxOf(st)) {
      const n2 = nodeAt(i)
      if n2 is BinExpr {
        idxStoreHolePin(
          nodeTyIxOf(st),
          idxStoreDstRow(n2.binLeft),
          dstRows,
          dstElems,
        )
      }
    }
  }
  0
}

// The value node of the index store `xs[k] = v` at `ix`, or -1 when `ix` is not one.
function idxStoreOf(ix: i32): i32 {
  const n = nodeAt(ix)
  if !(n is BinExpr) || n.binOp != "=" { return -1 }
  if !(nodeAt(n.binLeft) is Index) { return -1 }
  n.binRight
}

// The non-null list row of type `ty`, or -1 when it is not a list.
function listRowOf(ty: i32): i32 {
  if ty < 0 { return -1 }
  const d = nonNullTy(ty)
  if d < 0 || d >= T.tys.length { return -1 }
  if tyAt(d) is TyArray { d } else { -1 }
}

// The list row the store target `xs[k]` at `ix` writes into: a map receiver's value row, or a list
// receiver's element row; -1 when that is not a list.
function idxStoreDstRow(ix: i32): i32 {
  const t = nodeAt(ix)
  if !(t is Index) { return -1 }
  const recv = nodeTyIxOf(t.idxArr)
  if recv < 0 { return -1 }
  const r = nonNullTy(recv)
  const mv = tyMapValOf(r)
  if mv >= 0 { listRowOf(mv) } else { listRowOf(tyStepElem(r)) }
}

// Record the element the index store at `ix`, of value `st`, writes into its destination list
// row: one row per destination in `rows`, its element in `elems`, or -2 once two stores disagree
// or one is open.
function idxStoreNote(ix: i32, st: i32, rows: i32[], elems: i32[]) {
  const n = nodeAt(ix)
  const v = listRowOf(nodeTyIxOf(st))
  if v < 0 || !(n is BinExpr) { return 0 }
  const d = idxStoreDstRow(n.binLeft)
  const vt = tyAt(v)
  if d >= 0 && vt is TyArray && vt.aElem >= 0 {
    const el = if tyHasHole(vt.aElem) { -2 } else { vt.aElem }
    let k = 0
    while k < rows.length && rows[k] != d { k = k + 1 }
    if k == rows.length {
      rows.push(d)
      elems.push(el)
    } else if elems[k] != -2 && (el == -2 || !tySame(elems[k], el)) {
      elems[k] = -2
    }
  }
  0
}

// Pin list row `lit`, an index store's empty value, to the element its destination list row `d`
// holds: the destination's own when known, else the one `idxStoreNote` found every store into it
// writing, else `i32` when none writes one. Stores that disagree leave it open for the emitter.
function idxStoreHolePin(lit: i32, d: i32, rows: i32[], elems: i32[]) {
  if lit < 0 || d < 0 { return 0 }
  const lt = tyAt(lit)
  if !(lt is TyArray) { return 0 }
  const dt = tyAt(d)
  if !(dt is TyArray) { return 0 }
  let el = if dt.aElem >= 0 && !tyHasHole(dt.aElem) { dt.aElem } else { -1 }
  if el < 0 {
    let k = 0
    while k < rows.length && rows[k] != d { k = k + 1 }
    if k < rows.length { el = elems[k] }
  }
  if el == -2 { return 0 }
  if el < 0 {
    arrDefPinHoleElem(lit)
    return 0
  }
  lt.aElem = el
  tyMutEpoch = tyMutEpoch + 1 // in-place element pin — canonical keys change
  0
}

// Pin `asgOpenElemRow`'s open element from a store's value type `vt` when `exprIx` reads that same
// row, and answer the element's value type; -1 when it is some other read. A store whose value
// reads the place it writes (`xs[i] += v`, or that spelled out) has no other moment to pin: the
// read answers `-1`, the operator floor turns that into `TY_ERR`, and the store banks it. D1603.
export function asgReadElemPin(exprIx: i32, vt: i32) {
  if asgOpenElemRow < 0 || exprIx < 0 { return -1 }
  if vt < 0 || vt == TY_ERR || vt == TY_VOID { return -1 }
  if tyHasHole(vt) { return -1 }
  const e = nodeAt(exprIx)
  if e is Index {
    if nodeTyIxOf(e.idxArr) != asgOpenElemRow { return -1 }
    const t = tyAt(asgOpenElemRow)
    if t is TyArray {
      if t.aElem >= 0 { return -1 }
      t.aElem = widenLitTy(vt)
      tyMutEpoch = tyMutEpoch + 1 // the store's own value pinned the element in place
      // The read's recorded type is `resolveOpenElemReads`'s. A compound store's read is also
      // its write target, which `checkIndexNode` does not bank, so it is banked here.
      oerBank(exprIx, false, inferQuiet)
      return arrElemValueTy(vt)
    }
  }
  -1
}

// D1512 — the one place an unpinned intrinsic hole acquires its element: whatever the link graph
// can still reach (`resolveHoleLinks`, run first), else the `i32` default. Returns the row's
// element after the pin, or -1 when the row is not an array. Both sites that default such a hole
// go through here, so an intrinsic delivered into a plain `v = …` cannot take `i32` on its own.
export function arrDefPinHoleElem(ty: i32) {
  if ty < 0 { return -1 }
  resolveHoleLinks()
  const t = tyAt(ty)
  if t is TyArray {
    if t.aElem < 0 {
      // A literal-union element is stored at its base primitive, whose zero the intrinsic
      // writes; the `i32` default only when no callee wrote the row.
      let el = litMembersBaseTy(calleeWrittenElem(ty))
      if el < 0 { el = TY_I32 }
      t.aElem = el
      tyMutEpoch = tyMutEpoch + 1 // in-place element pin — canonical keys change
    }
    return t.aElem
  }
  -1
}

// The element a hole callee's first write gives an open list row handed to it as a binding,
// directly or through a chain of hole links, or -1 when no callee wrote it (D3746).
function calleeWrittenElem(ty: i32): i32 {
  if calleeWriteRow.length == 0 { return -1 }
  const rows = holeLinkClosure(ty)
  let i = 0
  while i < calleeWriteRow.length {
    if i32ListHas(rows, calleeWriteRow[i]) {
      return widenLitTy(calleeWriteGot[i])
    }
    i = i + 1
  }
  -1
}

// Pin a still-open list binding at scope close to the element a hole callee's write gave it;
// false when no callee wrote it, which leaves the binding's own diagnostic standing (D3746).
function calleeWritePin(ty: i32): boolean {
  if ty < 0 { return false }
  const t = tyAt(ty)
  if t is TyArray {
    if t.aElem >= 0 { return false }
    const el = calleeWrittenElem(ty)
    if el < 0 { return false }
    t.aElem = el
    tyMutEpoch = tyMutEpoch + 1 // in-place element pin — canonical keys change
    return true
  }
  false
}

// Before a caller's write of `got` pins open list row `ty`, give the row an earlier hole callee's
// element when `got`'s element cannot hold that callee's write: the first write decides, as at
// the direct spelling, and the caller's write is checked against it. A callee write it can hold
// (a literal `1` beside a later `2.5`) leaves the caller's write to decide (D3775).
export function calleeWritePrePin(ty: i32, got: i32) {
  if ty < 0 || got < 0 || calleeWriteRow.length == 0 { return 0 }
  if got == TY_ERR || tyHasHole(got) { return 0 }
  const el = widenLitTy(got)
  const rows = holeLinkClosure(ty)
  let i = 0
  while i < calleeWriteRow.length {
    if i32ListHas(rows, calleeWriteRow[i]) {
      if !assignable(calleeWriteGot[i], el) {
        calleeWritePin(ty)
        return 0
      }
    }
    i = i + 1
  }
  0
}

// Pin each open list recorded at scope `depth` under a binding's `| null` or record field
// to the element a hole callee wrote into it; a list no callee wrote stays open (D6270).
function flushNulListPins(depth: i32) {
  if pendNulListTys.length == 0 { return 0 }
  const keepT: i32[] = []
  const keepD: i32[] = []
  let i = 0
  while i < pendNulListTys.length {
    if pendNulListDepths[i] == depth {
      calleeWritePin(pendNulListTys[i])
    } else {
      keepT.push(pendNulListTys[i])
      keepD.push(pendNulListDepths[i])
    }
    i = i + 1
  }
  pendNulListTysSet(keepT)
  pendNulListDepthsSet(keepD)
  0
}

// Flush every pending binding recorded at scope `depth`, called just before the scope is popped
// and for the global scope at program end. A binding whose hole is still open at this point
// will never be pinned, so it takes the unified "cannot infer a type" diagnostic.
export function flushUninferred(depth: i32) {
  // A `let x = null` a later write filled stores its `null` as the filled `T | null`.
  let fi = nhFilledIxs.length
  flushNullHoles(depth)
  while fi < nhFilledIxs.length {
    const ld = nodeAt(nhFilledIxs[fi])
    if ld is LetDecl { recordRepTyAdopt(ld.letInit, nhFilledTys[fi], 6) }
    fi = fi + 1
  }
  flushNulListPins(depth)
  const keepN: string[] = []
  const keepT: i32[] = []
  const keepA: i32[] = []
  const keepD: i32[] = []
  let i = 0
  while i < pendNames.length {
    if pendDepths[i] == depth {
      if unresolvedHole(pendTys[i]) {
        if !arrDefHoleToI32(pendTys[i]) && !calleeWritePin(pendTys[i]) {
          tErr(
            "cannot infer a type for '"
              + pendNames[i]
              + "' — "
              + uninferredFixText(pendNames[i], pendTys[i]),
            pendAts[i],
          )
        }
      }
    } else {
      keepN.push(pendNames[i])
      keepT.push(pendTys[i])
      keepA.push(pendAts[i])
      keepD.push(pendDepths[i])
    }
    i = i + 1
  }
  pendNamesSet(keepN)
  pendTysSet(keepT)
  pendAtsSet(keepA)
  pendDepthsSet(keepD)
  0
}

// ── definite-assignment flow ─────────────────────────────────────────────────
// Check a read of `name`: if it is still unassigned on this path, report it and drop it so the
// same hole does not re-fire on every later read.
export function daCheckRead(name: string, at: i32) {
  if daLive.length == 0 { return 0 }
  const sid = sidOf(name)
  if daIsUnassignedSid(sid) {
    daMarkAssignedSid(sid)
    tErr("`" + name + "` is used before it is assigned", at)
  }
  0
}

// ── the type-parameter `self` operator, banked from both ends ────────────────

// ── the pin column ───────────────────────────────────────────────────────────

// The innermost narrowed-path overlay entry for place `p`, or -1, which means either "never narrowed"
// or "narrowed and since invalidated by an aliasing write or a falsifying assignment". One
// function answers "is this narrowing in force", so the member read arms and `placeCurTy`'s fact
// collection cannot disagree: after `clr(o)` a fresh guard re-derives from the declared type.
export function narrowedPathTy(p: i32) {
  const i = narrowedPathIx(p)
  if i < 0 { return -1 }
  if npInvBy[i] >= 0 { return -1 }
  if crPathCaptureLost(i, npKeys[i]) { return -1 }
  if i < crFnNpBase() { return writeLandNestedTy(npTys[i]) }
  npTys[i]
}

// The node that invalidated the innermost narrowing of place `p`, or -1 when it is narrowed and in
// force, or never narrowed at all. The two states `narrowedPathTy` folds into -1 are told apart
// here, and only for the diagnostic: an unguarded nullable read keeps its existing message, an
// invalidated one names the call or the write.
export function narrowedPathInvBy(p: i32) {
  const i = narrowedPathIx(p)
  if i < 0 { return -1 }
  if crPathCaptureLost(i, npKeys[i]) { return -1 }
  npInvBy[i]
}

// Whether the write shape `w` may write the key step `st`, whose container's cell tag is `tag`
// ("" for a field step, or when unknown). A cell shape and a step whose containers are both known
// hit only when they are the same kind and one element type is assignable to the other.
// The step `[*]` stands for every element of a list, which an append also writes.
function shapeHitsStep(w: string, st: string, tag: string): boolean {
  let s = w
  const appends = s.length > 0 && s[0] == '+'
  if appends && st != LIST_EVERY_STEP { return false }
  if s.length > 0 && (s[0] == '-' || appends) { s = s.slice(1, s.length) }
  let wtag = ""
  let h = s.length - 2
  while h >= 0 && !(s[h] == ']' && s[h + 1] == '#') { h = h - 1 }
  if h >= 0 {
    wtag = s.slice(h + 1, s.length)
    s = s.slice(0, h + 1)
  }
  const every = st == LIST_EVERY_STEP && s.length > 0 && s[0] == '['
  if s != st && !every && !(s == "[]" && st.length > 0 && st[0] == '[') {
    return false
  }
  cellTagsMayAlias(wtag, tag)
}

// Whether the cell shape `w` stores only what the element narrowing `nar` admits: its container
// is a list of a type every value of which is a `nar`, as the checker held each such store to.
function shapeStoresWithin(w: string, nar: i32): boolean {
  if nar < 0 { return false }
  let h = w.length - 2
  while h >= 0 && !(w[h] == ']' && w[h + 1] == '#') { h = h - 1 }
  if h < 0 { return false }
  const tag = w.slice(h + 1, w.length)
  if tag.length < 3 || tag[1] != 'a' { return false }
  const e = weDigits(tag.slice(2, tag.length))
  e >= 0 && !tyIsHole(e) && !tyHasTyVar(e) && assignable(e, nar)
}

// Whether a function with the write shapes `sum` may write the place `p` through some alias of
// an object on its path. A store into the place's own last step is harmless when the place
// stores exactly the narrowed type: whatever it writes, the narrowing still holds.
function shapesHitKey(sum: WeSet, p: i32): boolean {
  const key = placeText(p)
  if crAskOn {
    const st0 = keySteps(key)
    crAskUseShape(key, st0, keyStepTags(p, st0))
  }
  if sum.opaque || sum.at { return true }
  if sum.parts.length == 0 { return false }
  const steps = keySteps(key)
  const tags = keyStepTags(p, steps)
  const root = placeRootOf(key)
  let lastSafe = -1
  for id in sum.parts {
    const w = wePartTextOf(id)
    if w[0] == '=' {
      if w.slice(1, w.length) == root { return true }
    }
    let s = 0
    while s < steps.length {
      if shapeHitsStep(w, steps[s], tags[s]) {
        if s < steps.length - 1 || w[0] == '-' { return true }
        if steps[s] == LIST_EVERY_STEP {
          if !shapeStoresWithin(w, narrowedPathTyRaw(p)) { return true }
        } else if lastSafe < 0 {
          lastSafe = 0
          if keyStoresNarrowedTy(p) { lastSafe = 1 }
        }
        if lastSafe == 0 { return true }
      }
      s = s + 1
    }
  }
  false
}

// Per step of place `p`, the cell tag of the container a subscript step reads (`cellTagOfTy` of
// the type its prefix holds, through the narrowings over it), "" for a field step or when unknown.
function keyStepTags(p: i32, steps: string[]): string[] {
  if keyIsListEvery(placeText(p)) { return listEveryTags(p, steps) }
  const out: string[] = []
  const pres = keyStepPrefixTys(p, steps)
  let s = 0
  while s < steps.length {
    out.push(keyStepTag(steps[s], pres[s]))
    s = s + 1
  }
  out
}

// Whether the place `p` stores exactly the type its live narrowing reads it at.
function keyStoresNarrowedTy(p: i32): boolean {
  const slot = narrowedPathIx(p)
  if slot < 0 || narFitSlot(slot) { return false }
  const nar = npTys[slot]
  const st = keyStoreTy(p)
  if nar < 0 || st < 0 { return false }
  // Two holes both render `_`, which says nothing about whether they are one type (D3197).
  if tyIsHole(st) || tyIsHole(nar) { return false }
  st == nar || tyToStr(st) == tyToStr(nar)
}

// The type a store into the place `p` writes: the declared type of its last step, reached
// through the narrowings in force over its prefixes; -1 when unresolvable.
function keyStoreTy(p: i32): i32 {
  const key = placeText(p)
  const steps = keySteps(key)
  if steps.length == 0 { return -1 }
  let rootLen = 0
  while rootLen < key.length && key[rootLen] != '.' && key[rootLen] != '[' {
    rootLen = rootLen + 1
  }
  const d = placeDecl(p)
  let pre = key.slice(0, rootLen)
  let t = declTyOf(d)
  let s = 0
  while s < steps.length - 1 && t >= 0 {
    pre = pre + steps[s]
    const ov = narrowedPathTyRaw(placeFind(d, pre))
    if ov >= 0 {
      t = ov
    } else if steps[s][0] == '.' {
      t = placeFieldTy(t, steps[s].slice(1, steps[s].length), false)
    } else {
      t = placeElemTy(t)
    }
    s = s + 1
  }
  if t < 0 { return -1 }
  const last = steps[steps.length - 1]
  if last[0] == '.' {
    return placeFieldTy(t, last.slice(1, last.length), false)
  }
  placeCellStoreTy(t)
}

// The one place that decides whether the call at `callIx` invalidates the path narrowing of place
// `p`. The rule is effect-based: it dies only when some argument place of the call is a prefix of
// it and the callee may write, through that parameter, a sub-path that is a prefix of the rest.
// It fails closed at every edge, and it is keyed on the syntactic argument, so aliases live.
function callInvalidatesNarrowedPath(callIx: i32, p: i32) {
  const cn = nodeAt(callIx)
  if cn is Call { return callInvalidatesReal(cn, callIx, p) }
  // An operator that may dispatch to a declaration is a call of it, its operands the arguments.
  const ds = opSiteDecls(callIx)
  if ds.length == 0 { return false }
  const args = opSiteArgs(callIx)
  let i = 0
  while i < ds.length {
    if ds[i] < 0 { return true }
    if declWritesPath(ds[i], args, p) { return true }
    i = i + 1
  }
  false
}

function callInvalidatesReal(cn: Call, callIx: i32, p: i32) {
  const key = placeText(p)
  const declIx = callDeclFnIx(cn, callIx)
  // A cell-removing collection method retires that cell's narrowings, and it has to be asked
  // first because it reaches neither leg below: an intrinsic answers `-2` on the next line, and
  // `callArgPlaces` puts a receiver in the argument list only for a UFCS call. The key argument
  // is read exactly as a write target is — a literal names its cell, anything else may hit any.
  if cn.callFn >= 0 {
    const rmRecv = nodeAt(cn.callFn)
    if rmRecv is Member {
      if cellRemovingMethod(rmRecv.memProp) {
        const rmRoot = placeKeyOf(rmRecv.memObj)
        if rmRoot != "" {
          const rmLit = removedCellKeyText(cn, rmRecv.memProp)
          if rmLit == "" {
            if keyHasPrefix(key, rmRoot + "[") { return true }
          } else {
            const rmCell = rmRoot + "[" + rmLit + "]"
            if key == rmCell { return true }
            if keyHasPrefix(key, rmCell + ".") { return true }
            if keyHasPrefix(key, rmCell + "[") { return true }
          }
        }
      }
    }
  }
  if declIx == -2 && pushKeepsElemOnly(cn, p) { return false }
  // An intrinsic writes only through its own effect on a receiver that may alias the path, and
  // through the function values it is handed and may run.
  if declIx == -2 && !ALIAS_RULE_BROAD {
    return shapesHitKey(callWriteShapes(cn, callIx), p)
  }
  // An opaque callee invalidates every live narrowing, not only the ones rooted at its arguments:
  // a closure that captured the object takes no argument, so an argument-keyed fallback would
  // fail open on exactly the construct that has no statically known body. A binding whose every
  // stored function is known runs one of them (D5017).
  if declIx == -1 {
    const ts = callFnValueDecls(cn)
    if ts.length == 0 { return true }
    const args = callArgPlaces(cn, callIx)
    let i = 0
    while i < ts.length {
      if declWritesPath(ts[i], args, p) { return true }
      i = i + 1
    }
    return false
  }
  if declIx < 0 { return true }
  declWritesPath(declIx, callArgPlaces(cn, callIx), p)
}

// Whether the declaration at `declIx`, handed the argument places `args` in parameter order,
// may write the place `p`: through a free variable, or through an argument.
function declWritesPath(declIx: i32, args: i32[], p: i32): boolean {
  const key = placeText(p)
  // The write shapes see every write the name-keyed legs below do — through an argument, a free
  // variable, an alias — and each function value the callee runs is charged at its argument.
  if !ALIAS_RULE_BROAD {
    const sh = declWriteShapes(declIx, args)
    return shapesHitKey(sh, p)
  }
  // Writes through a free variable, which likewise need no argument.
  crAskUsePath(key)
  const free = fnWriteFreePaths(declIx)
  if pathHitsAny(key, free) { return true }
  let i = 0
  while i < args.length {
    const ak = placeKeyOf(args[i])
    if ak != "" {
      // An index cell of an argument dies to any call that receives the array, with no effect
      // refinement — the deliberately blunt half of this rule. The summaries are field sub-paths
      // and an index write records nothing in one, so consulting them here would read "writes
      // nothing" for the callee that nulls the cell (inventory-2 D452).
      if keyHasPrefix(key, ak + "[") { return true }
      const pfx = ak + "."
      if keyHasPrefix(key, pfx) {
        if ALIAS_RULE_BROAD { return true }
        const sum = fnWriteEffects(declIx, i)
        const rest = key.slice(pfx.length, key.length)
        if pathHitsAny(rest, sum) { return true }
      }
    }
    i = i + 1
  }
  false
}

// The diagnostic for a write the re-execution barrier refuses. It names the loop rather
// than the type, because the type is fine: the same write one block further out is
// accepted, and so is this one under a guard the loop itself re-tests.
export function writeBarredErr(place: string, at: i32) {
  tErr(
    "'"
      + place
      + "' was narrowed by a guard OUTSIDE this loop, so this write would leave the "
      + "reads before it reading the old narrowing on the next iteration — move the "
      + "write out of the loop, or make the guard on '"
      + place
      + "' the loop's own condition",
    at,
  )
  0
}

// The storage type of an assignment target — what the place can hold, as against what a narrowing
// currently proves it holds — or -1 when no live narrowing overlays the place and the flow type is
// the storage type. A bare name reads the narrowing bank, since the guard's `declare` hid the
// declaration; a property path reads the field off the receiver's type. -1 across a barrier.
export function writeStorageTy(ix: i32) {
  const n = nodeAt(ix)
  match n {
    Ident => {
      // A guard's write is bounded by a loop barrier, and a nested function that captured the
      // narrowing is checked at each call instead (D2402). An assignment narrowing's is not: its
      // null write in a single-iteration loop is a correct program barring would reject.
      const s = identSlotOf(ix, n.identName)
      if narGuardSlot(s) >= 0 { return narWriteStorage(s) }
      return narDeclaredTy(s, NAR_KIND_ASG)
    }
    Member => {
      const slot = narrowedPathIx(placeAt(ix))
      if slot < 0 { return -1 }
      // An already-retired narrowing still answers, and bailing on `npInvBy[slot] >= 0` here is an
      // ordering bug inside one statement: `lt` is read off the target before the right-hand side is
      // checked, so a callee that retires the path mid-statement would leave `asgLt` at a type the
      // storage never had. A retired narrowing means the place reads at its declared type.
      if npEpochs[slot] != narFnEpoch && npAsg[slot] != 1 { return -1 }
      if !npInsideBarrier(slot) { return -1 }
      const noPlaces: i32[] = []
      const noTys: i32[] = []
      return placeFieldTy(
        placeCurTy(n.memObj, noPlaces, noTys),
        n.memProp,
        false,
      )
    }
    // An index cell is storage too, and this arm is not optional once a cell can be narrowed:
    // `if xs[0] != null { xs[0] = null }` runs when no narrowing covers the target, and without this
    // it would newly reject `cannot assign null to i32[]` — a working program lost to a rule whose
    // whole point is that it never shrinks what storage holds. Same three guards as the member arm.
    Index => {
      const slot = narrowedPathIx(placeAt(ix))
      if slot < 0 { return -1 }
      if npEpochs[slot] != narFnEpoch && npAsg[slot] != 1 { return -1 }
      if !npInsideBarrier(slot) { return -1 }
      const noPlaces: i32[] = []
      const noTys: i32[] = []
      return placeCellStoreTy(placeCurTy(n.idxArr, noPlaces, noTys))
    }
    // Every other kind is not storage a write can land in.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// Whether a write of a value typed `rt` to the place at `tgtIx` would leave the narrowing it held
// when an enclosing loop began, where the loop cannot re-read it: a write the declaration admits
// still has to land within that narrowing, since the reads before it run again (D2609).
export function writeLeavesLoopEntry(tgtIx: i32, rt: i32): boolean {
  if rt < 0 { return false }
  const n = nodeAt(tgtIx)
  if n is Ident {
    const s = identSlotOf(tgtIx, n.identName)
    if narGuardSlot(s) < 0 { return false }
    const cap = narWriteStorage(s)
    const depths: i32[] = []
    const wide = crChainWidest(s, depths)
    if cap < 0 || wide < 0 || tySame(cap, wide) { return false }
    return !writeLandsWithin(wide, rt, cap)
  }
  // A field or cell answers by its path's narrowing; any other target keys "" and has none.
  pathWriteLeavesLoopEntry(tgtIx, rt)
}

// `writeLeavesLoopEntry` for a field or cell narrowed outside the innermost loop.
function pathWriteLeavesLoopEntry(tgtIx: i32, rt: i32): boolean {
  const slot = narrowedPathIx(placeAt(tgtIx))
  if slot < 0 || slot >= npKeys.length { return false }
  if npInvBy[slot] >= 0 || npInsideBarrier(slot) { return false }
  const store = placeStoreTy(tgtIx)
  if store < 0 { return false }
  !writeLandsWithin(store, rt, npTys[slot])
}

// Whether a value typed `rt` written into storage `store` lands on a member `cap` holds: each
// member of a union value lands where it would alone, and `null` needs `cap` to admit it.
function writeLandsWithin(store: i32, rt: i32, cap: i32): boolean {
  const rT = tyAt(rt)
  if rT is TyUnion {
    let k = 0
    while k < rT.uMembers.length {
      if !writeLandsWithin(store, rT.uMembers[k], cap) { return false }
      k = k + 1
    }
    return true
  }
  if isNullTy(rt) { return tyAdmitsNull(cap) }
  if rT is TyNullable {
    if !tyAdmitsNull(cap) || rT.nInner < 0 { return false }
    return writeLandsWithin(store, rT.nInner, cap)
  }
  const m = writeMemberTy(store, rt)
  if m == store { return assignable(rt, cap) }
  tyMemberWithin(m, cap)
}

// Whether `ix` is a cell of a map, `m[k]`.
function placeIsMapCell(ix: i32): boolean {
  const n = nodeAt(ix)
  if n is Index {
    const noPlaces: i32[] = []
    const noTys: i32[] = []
    const rt = placeCurTy(n.idxArr, noPlaces, noTys)
    if rt >= 0 {
      const nt = nonNullTy(rt)
      if nt >= 0 { return tyAt(nt) is TyMap }
    }
  }
  false
}

// The declared type of the field or cell at `ix`, whatever narrowing or loop covers it; -1 for
// any other node.
function placeStoreTy(ix: i32): i32 {
  const n = nodeAt(ix)
  if n is Member {
    const noPlaces: i32[] = []
    const noTys: i32[] = []
    return placeFieldTy(placeCurTy(n.memObj, noPlaces, noTys), n.memProp, false)
  }
  // A cell's declared type is its container's element; any other node has none.
  placeCellDeclTy(ix)
}

// The declared element type of the cell at `ix`, or -1 when `ix` is no cell.
function placeCellDeclTy(ix: i32): i32 {
  const n = nodeAt(ix)
  if n is Index {
    const noPlaces: i32[] = []
    const noTys: i32[] = []
    return placeCellStoreTy(placeCurTy(n.idxArr, noPlaces, noTys))
  }
  -1
}

// Does a write to `tgtKey` of a value typed `rt` retire the narrowing `(key, npTy)`? The one home
// for that question, so the bare-name and property-path sides cannot disagree. An exact match
// consults `rt` — a write the narrowing still admits keeps it — while a prefix match, in either
// separator, retires unconditionally. An unkeyable target keys "" and its caller handles it.
function writeRetiresNarrowing(
  tgtKey: string,
  rt: i32,
  key: string,
  npTy: i32,
) {
  if tgtKey == "" { return false }
  // A hole admits every write, so its narrowing is retired and re-derived from the value (D3197).
  if key == tgtKey && tyIsHole(npTy) { return true }
  if key == tgtKey { return !assignable(rt, npTy) }
  if keyHasPrefix(key, tgtKey + ".") { return true }
  keyHasPrefix(key, tgtKey + "[")
}

// Whether the write target at `tgtIx` is a field or a cell of a receiver typed as an inference
// hole, at any depth of a place (`b.a.v`, `b[0]`).
function writesHoleField(tgtIx: i32): boolean {
  const tn = nodeAt(tgtIx)
  let recv = -1
  if tn is Member { recv = tn.memObj }
  else if tn is Index { recv = tn.idxArr }
  else { return false }
  const on = nodeAt(recv)
  if on is Ident { return tyIsHole(identTyOf(recv, on.identName)) }
  const noPlaces: i32[] = []
  const noTys: i32[] = []
  if tyIsHole(placeCurTy(recv, noPlaces, noTys)) { return true }
  tyIsHole(nodeTyOf(recv))
}

// End every live path narrowing the write at `atIx` may reach through an alias: `q.f = null`
// after `const q = p` falsifies `p.f`. The write's shape is matched against each step of each
// key, as a call's write summary is; the target's own key and the paths under it are left to
// `writeRetiresNarrowing`. A write the narrowed type still admits keeps the narrowing (D2584).
function retireAliasedNarrowings(
  tgtIx: i32,
  tgtKey: string,
  rt: i32,
  atIx: i32,
) {
  if npKeys.length == 0 { return 0 }
  const shape = weTargetShape(tgtIx, crNoNames, crNoNames)
  if shape == "" || shape[0] == '=' { return 0 }
  const recv = aliasWriteRecvIx(tgtIx)
  let recvTy = -1
  let recvName = ""
  if recv >= 0 {
    recvTy = nodeTyOf(recv)
    const rn = nodeAt(recv)
    if rn is Ident { recvName = rn.identName }
  }
  let family = ""
  if tgtKey == "" { family = indexRootKeyOf(tgtIx) }
  const recvFresh = recvName != ""
    && crSoleRefHolds(
    slotVisibleOf(identSlotOf(recv, recvName)),
    recvName,
  )
  const n0 = npKeys.length
  let i = 0
  while i < n0 {
    const k = npKeys[i]
    const own = tgtKey != ""
      && (k == tgtKey
      || keyHasPrefix(k, tgtKey + ".")
      || keyHasPrefix(k, tgtKey + "["))
    const fam = family != "" && keyHasPrefix(k, family + "[")
    const kRoot = placeRootOf(k)
    // A receiver no other place refers to cannot be any object on another key's path; a key
    // root no other place refers to cannot be the receiver unless the receiver names it. Both
    // resolve names here, so neither holds for an entry an inner declaration hides (D3307).
    const hidden = !own && !fam && placeRootHidden(npPlace[i])
    const apart = recvFresh && kRoot != recvName && !hidden
    const skip0 = kRoot != recvName
      && !hidden
      && crSoleRefHolds(placeDecl(npPlace[i]), kRoot)
    const keeps = (!hidden
      && elemOnlyStoreKeeps(i, elemDepthOf(tgtIx), asgRhsIx(atIx), rt))
    const hits = !own
      && !fam
      && !apart
      && !keeps
      && aliasWriteHitsKey(
      shape,
      recvTy,
      skip0,
      rt,
      npPlace[i],
      npTys[i],
    )
    if hits && npInvBy[i] >= 0 && i >= crFnNpBase() {
      // Already retired, typically by a sibling arm's write: the kill still ends this path,
      // and a merged entry must not hand the fact back (D3285).
      narClobPlacePush(npPlace[i])
      narClobTysPush(-1)
      narClobPrevPush(-1)
      narClobDepthsPush(T.frames.length)
      narClobRetiredPush(2)
      narClobBindPush(-1)
      narClobDeclPush(-1)
    }
    if hits && npInvBy[i] < 0 {
      crAliasWr[atIx] = true
      narSetInv(i, atIx)
      if nfSlots.length > 0 && i >= crFnNpBase() { narFitRetire(i, atIx, -1) }
      if i < crFnNpBase() {
        crAliasNestSlots.push(i)
        crAliasNestDepths.push(crFnBases.length)
      } else {
        crPathCallRetire(i, atIx)
        narClobPlacePush(npPlace[i])
        narClobTysPush(-1)
        narClobPrevPush(npTys[i])
        narClobDepthsPush(T.frames.length)
        narClobRetiredPush(2)
        narClobBindPush(-1)
        narClobDeclPush(-1)
        mapCellStaysPresent(npPlace[i])
      }
    }
    i = i + 1
  }
  0
}

// Whether `root`, the root name of the narrowing place `p`, reads another binding here, an
// inner declaration hiding it, so a by-name test of its root cannot speak for it (D3307).
function placeRootHidden(p: i32): boolean {
  slotVisibleOf(placeDecl(p)) != placeDecl(p)
}

// A narrowed map cell a store through an alias may have written is present either way, so it
// reads the map's value type after, not the map read's `T | null`.
function mapCellStaysPresent(p: i32) {
  const steps = keySteps(placeText(p))
  if steps.length == 0 || steps[steps.length - 1][0] != '[' { return 0 }
  const pres = keyStepPrefixTys(p, steps)
  const ct = pres[pres.length - 1]
  if ct < 0 { return 0 }
  const nt = nonNullTy(ct)
  if nt < 0 { return 0 }
  const m = tyAt(nt)
  if m is TyMap {
    npKeysPush(p)
    npTysPush(m.mVal)
    npInvByPush(-1)
    npEpochsPush(narFnEpoch)
    npSettlePush(-2)
    npCapByPush(-1)
    npAsgPush(0)
  }
  0
}

// Whether a write of shape `shape` into an object typed `recvTy`, storing a value typed `rt`,
// may falsify the narrowing of place `p` to `npTy`. A field step matches only a receiver whose type
// may be the object's, the first step not at all when `skip0`; a store the narrowed type admits
// into the key's last step keeps it.
function aliasWriteHitsKey(
  shape: string,
  recvTy: i32,
  skip0: boolean,
  rt: i32,
  p: i32,
  npTy: i32,
): boolean {
  const key = placeText(p)
  const steps = keySteps(key)
  const pres = keyStepPrefixTys(p, steps)
  const tags = keyStepTags(p, steps)
  let s = 0
  while s < steps.length {
    if (
      shapeHitsStep(shape, steps[s], tags[s])
      && (steps[s][0] != '.' || objTysMayAlias(pres[s], recvTy))
      && !(s == 0 && skip0)
    ) {
      if s < steps.length - 1 { return true }
      if steps[s] == LIST_EVERY_STEP && shapeStoresWithin(shape, npTy) {
        return false
      }
      if rt < 0 || npTy < 0 || !assignable(rt, npTy) { return true }
      // A hole admits every write, which proves nothing about the pin's value (D3197). The
      // else arm of `is T` on one holds the pin's remainder, which a write of no `T` lands in.
      if tyIsHole(npTy) {
        const te = holeElseTested[key + "|" + i32ToStr(npTy)] ?? -1
        return te < 0 || tyMayHoldTy(rt, te)
      }
      // A numeric value the narrowing only widens to is stored as its own member (D2609).
      if numericVariantUncovered(rt, npTy) { return true }
    }
    s = s + 1
  }
  false
}

// Per step of place `p`, the type of the prefix the step reads from, -1 when unresolvable.
function keyStepPrefixTys(p: i32, steps: string[]): i32[] {
  const key = placeText(p)
  const d = placeDecl(p)
  const out: i32[] = []
  let rootLen = 0
  while rootLen < key.length && key[rootLen] != '.' && key[rootLen] != '[' {
    rootLen = rootLen + 1
  }
  let pre = key.slice(0, rootLen)
  let t = declTyOf(d)
  let s = 0
  while s < steps.length {
    out.push(t)
    if t >= 0 {
      pre = pre + steps[s]
      const ov = narrowedPathTyRaw(placeFind(d, pre))
      if ov >= 0 {
        t = ov
      } else if steps[s][0] == '.' {
        t = placeFieldTy(t, steps[s].slice(1, steps[s].length), false)
      } else {
        t = placeElemTy(t)
      }
    }
    s = s + 1
  }
  out
}

// Whether values of types `a` and `b` may be one object; true when either is unknown.
function objTysMayAlias(a: i32, b: i32): boolean {
  if a < 0 || b < 0 { return true }
  const na = nonNullTy(a)
  const nb = nonNullTy(b)
  if na < 0 || nb < 0 || na == nb { return true }
  if tyHasTyVar(na) || tyHasTyVar(nb) || tyIsHole(na) || tyIsHole(nb) {
    return true
  }
  assignable(na, nb) || assignable(nb, na)
}

// Retire every narrowing the accepted write at `atIx` falsifies, in place — never by pushing a
// shadowing entry, which would unwind at the end of whatever inner block holds the write and
// resurrect the narrowing for the statements after it. A property path is marked in `npInvBy`; a
// bare name's narrowing is a shadowing `declare`, so retiring it writes the declared type back.
export function retireNarrowingsForWrite(
  tgtIx: i32,
  rt0: i32,
  atIx: i32,
  preAsgTy: i32,
) {
  let rt = rt0
  // A re-check of the write (a hole body checked again at its pin) answers afresh: the answer
  // an earlier check banked at the hole's own type is not this one's.
  clearAsgNarTyIx(atIx)
  const tgtKey = placeKeyOf(tgtIx)
  // Found, not made: most writes are to places no narrowing names, and a push below makes it.
  let tgtPlace = placeAtKey(tgtIx, tgtKey)
  retireAliasedNarrowings(tgtIx, tgtKey, rt, atIx)
  // A variable-index write names no cell and therefore may have hit any of them. `xs[i] = null`
  // keys "" and the loop below would retire nothing at all, which is a soundness hole the moment
  // a narrowing can name a cell. Retire every live narrowing under the receiver; the cell keys
  // (`xs[0].v` as well as `xs[0]`) go with it through the same prefix.
  if tgtKey == "" {
    retireIndexedNarrowings(tgtIx, rt, atIx)
    return 0
  }
  // The path's own live fact before this write: the arm JOIN's entry type, and the tell that a
  // narrowing covers the place at all (D1849).
  const preSlot = narrowedPathIx(tgtPlace)
  let prePathTy = -1
  if preSlot >= 0 {
    // An entry a WRITE retired still seeds the ledger, at the storage type that write left the
    // place at: an earlier write on this path or a sibling arm's, whose own row the join folds.
    // Only a CALL's retirement stops the fold, since it leaves the place unknown (D1849, D3285).
    if npInvBy[preSlot] < 0 {
      prePathTy = npTys[preSlot]
    } else if pathRetiredByAssign(npInvBy[preSlot]) {
      prePathTy = placeStoreTy(tgtIx)
    }
  }
  // A literal stored into a literal union re-narrows by its own type, as for a bare name; and
  // the storage may hold `null` again, so a null test of the place is a real question.
  if preSlot >= 0 {
    const pst = placeStoreTy(tgtIx)
    rt = asgLitRhsTy(atIx, pst, rt)
    if tyAdmitsNull(pst) && !narWrittenPath(tgtKey) {
      narWrPaths.push(tgtKey)
      narWrPathDepths.push(T.frames.length - 1)
    }
  }
  let i = 0
  // The member the write re-narrows `tgtKey` to, or -1 when it names none. Pushed after the
  // walk below rather than inside it: a fresh entry would be re-tested by the same loop.
  let pathReTy = -1
  let pathReAsg = false
  let pathRetired = false
  while i < npKeys.length {
    // The write's attribution wins over a call's, and the overwrite is what makes the read below
    // legible: `w.f = mk()` is one statement whose right-hand side is checked first, so an opaque
    // `mk` marks the path and the write would otherwise be reported as the call's. The cause is
    // what `pathRetiredByAssign` reads to decide whether the emitter can see the retirement.
    let hit = writeRetiresNarrowing(tgtKey, rt, npKeys[i], npTys[i])
    // An enclosing function's narrowing a nested body writes ends where that body is CALLED,
    // which the call rule settles for both halves; the write runs later than this point.
    if i < crFnNpBase() { hit = false }
    // A write the narrowing admits still re-narrows the place to the member it stored, as it
    // does a bare name (`5` into an `f64` arm of `i32 | f64`).
    if (
      !hit
      && i >= crFnNpBase()
      && npInvBy[i] < 0
      && tgtPlace >= 0
      && npPlace[i] == tgtPlace
    ) {
      const pd = writeStorageTy(tgtIx)
      if pd >= 0 && !tySame(writeNarrowAfter(pd, npTys[i], rt), npTys[i]) {
        hit = true
      }
      if (pd >= 0 && tvPlaceWrite(pd, rt) && !tyIsTvWriteOf(npTys[i], pd, rt)) {
        hit = true
      }
    }
    narClobUnderWrite(i, tgtKey)
    if hit {
      narSetInv(i, atIx)
      noteKillSure(atIx, npKeys[i])
      // The target's OWN narrowing going is what the emitter has to mirror; a path below it
      // goes through the prefix rule both sides already apply. Reads-only narrowing states one
      // rule for every receiver, so the path re-narrows to the written member exactly as a bare
      // name does, and reads at its declaration when the write names none (D1736, D1847).
      if tgtPlace >= 0 && npPlace[i] == tgtPlace {
        pathRetired = true
        let pdcl = writeStorageTy(tgtIx)
        if pdcl < 0 { pdcl = placeStoreTy(tgtIx) }
        const prn = writeMemberTy(pdcl, rt)
        recordAsgNarTyIx(atIx, prn)
        // A map cell reads `T | null` at its declaration, since a read may miss; the write just
        // stored the key, so the reads after it hold the stored type.
        if prn != pdcl || placeIsMapCell(tgtIx) { pathReTy = prn }
        if tvPlaceWrite(pdcl, rt) {
          pathReTy = tvWriteTy(pdcl, rt, -1)
          pathReAsg = true
          recordAsgTvWrite(atIx, pdcl)
        }
      }
    }
    i = i + 1
  }
  // The assignment narrowing's path twin: a non-null write to a field or list cell no live
  // narrowing covers (none, or one a write, call or alias ended) strips `null` for the code after
  // it, as `x = 5` does a name (D1848, D3316). A map cell's `null` is the miss, so it is left out.
  if narrowedPathTyRaw(tgtPlace) < 0 && pathReTy < 0 && !placeIsMapCell(tgtIx) {
    const pst = placeStoreTy(tgtIx)
    if pst >= 0 && tvPlaceWrite(pst, rt) {
      pathReTy = tvWriteTy(pst, rt, -1)
      pathReAsg = true
      recordAsgTvWrite(atIx, pst)
    } else if pst >= 0 && rt >= 0 && tyAdmitsNull(pst) && !tyAdmitsNull(rt) {
      const nn = nonNullTy(pst)
      if nn >= 0 && !tySame(nn, pst) {
        pathReTy = nn
        pathReAsg = true
        recordAsgNarTyIx(atIx, nn)
      }
    }
  }
  // A hole's field reads what a write stored in it (`holeFieldWriteTy`), as after a null test,
  // whatever narrowing the write retired (D3197).
  if pathReTy < 0 && rt >= 0 && writesHoleField(tgtIx) {
    const hst = placeStoreTy(tgtIx)
    if hst >= 0 && tyIsHole(hst) {
      // A concrete value reads at the member of the pinned place it lands on.
      if !tyHasHole(rt) && !tyAdmitsNull(rt) && !isNullTy(rt) {
        pathReTy = mkDerivedHole(HD_HWR, "", rt, -1, hst)
        recordAsgTvWrite(atIx, hst)
      } else {
        pathReTy = holeFieldWriteTy(hst, rt)
      }
    }
  }
  if pathReTy >= 0 && tgtPlace < 0 { tgtPlace = placeOf(tgtIx) }
  if pathReTy >= 0 && tgtPlace >= 0 {
    npKeysPush(tgtPlace)
    npTysPush(pathReTy)
    npInvByPush(-1)
    npEpochsPush(narFnEpoch)
    npSettlePush(-2)
    npCapByPush(-1)
    if pathReAsg { npAsgPush(1) } else { npAsgPush(0) }
  }
  narClobPathWrite(
    tgtIx,
    tgtPlace,
    rt,
    preSlot,
    prePathTy,
    pathReTy,
    pathReAsg,
    pathRetired,
  )
  retireNameNarrowing(tgtIx, rt, atIx, preAsgTy)
  0
}

// A write to a prefix of narrowing `i`'s key replaces the object the key reads through, so the
// key is unknown after it on this path, whatever the write stored and whether or not a sibling
// arm already ended the narrowing in place (D3319). Pushes that clobber row.
function narClobUnderWrite(i: i32, tgtKey: string) {
  if (
    i >= crFnNpBase()
    && (keyHasPrefix(npKeys[i], tgtKey + ".")
      || keyHasPrefix(npKeys[i], tgtKey + "["))
  ) {
    let kprev = -1
    if npInvBy[i] < 0 { kprev = npTys[i] }
    narClobPlacePush(npPlace[i])
    narClobTysPush(-1)
    narClobPrevPush(kprev)
    narClobDepthsPush(T.frames.length)
    narClobRetiredPush(2)
    narClobBindPush(-1)
    narClobDeclPush(-1)
  }
}

// The join row of a write over path place `tgtPlace`: `prePathTy` is the path's live fact before it,
// `pathReTy` the member it re-narrows to (-1 for none), `pathReAsg` that a null strip made it,
// and `pathRetired` that the write retired the path's own narrowing. Pushes at most one row.
function narClobPathWrite(
  tgtIx: i32,
  tgtPlace: i32,
  rt: i32,
  preSlot: i32,
  prePathTy: i32,
  pathReTy: i32,
  pathReAsg: boolean,
  pathRetired: boolean,
) {
  // Every write over a narrowed path joins, retiring or not — the first arm's retirement is
  // what makes the second arm's flip look admitted, exactly as for a bare name. The row also
  // carries the post-guard residual's veto, which reads the retiring ones (D1846, D1849).
  if prePathTy >= 0 {
    let endTy = pathReTy
    if endTy < 0 {
      if pathRetired {
        endTy = writeStorageTy(tgtIx)
        if endTy < 0 { endTy = placeStoreTy(tgtIx) }
      } else {
        // The member the write lands on, which a narrowing that only widens to it does not
        // name (`5` under a second arm's `f64`, D2629).
        const pst = placeStoreTy(tgtIx)
        endTy = writeReNarrowTy(prePathTy, rt)
        if pst >= 0 { endTy = writeNarrowAfter(pst, prePathTy, rt) }
      }
    }
    if endTy < 0 { endTy = prePathTy }
    narClobPlacePush(tgtPlace)
    narClobTysPush(endTy)
    narClobPrevPush(prePathTy)
    narClobDepthsPush(T.frames.length)
    let prtd = 0
    if pathRetired { prtd = 1 }
    narClobRetiredPush(prtd)
    narClobBindPush(-1)
    narClobDeclPush(narPlaceBind(tgtPlace))
  } else if pathReAsg {
    // The null strip of a path no narrowing covered is a path fact the join meets too.
    narClobPlacePush(tgtPlace)
    narClobTysPush(pathReTy)
    narClobPrevPush(placeStoreTy(tgtIx))
    narClobDepthsPush(T.frames.length)
    narClobRetiredPush(0)
    narClobBindPush(-1)
    narClobDeclPush(narPlaceBind(tgtPlace))
  } else {
    // A write over a narrowing a sibling arm or a kill already ended in place still ends this
    // path at the member it stores, and the join must see that (D3315).
    // Only over a narrowing: elsewhere no join reads the place. A map cell is left out, its
    // read may miss whatever the write stored.
    const fst = placeStoreTy(tgtIx)
    if fst >= 0 && preSlot >= 0 && !placeIsMapCell(tgtIx) {
      narClobPlacePush(tgtPlace)
      narClobTysPush(writeMemberTy(fst, rt))
      narClobPrevPush(fst)
      narClobDepthsPush(T.frames.length)
      narClobRetiredPush(1)
      narClobBindPush(-1)
      narClobDeclPush(narPlaceBind(tgtPlace))
    }
  }
}

// The variable-index arm of `retireNarrowingsForWrite`: a write `atIx` of type `rt` to index
// place `tgtIx`, whose key is "", retires every live narrowing under the receiver's root.
// Answers nothing; a receiver with no root key retires none.
function retireIndexedNarrowings(tgtIx: i32, rt: i32, atIx: i32) {
  const root = indexRootKeyOf(tgtIx)
  if root == "" { return }
  const pfx = root + "["
  const depth = elemDepthOf(tgtIx)
  const val = asgRhsIx(atIx)
  let r = 0
  while r < npKeys.length {
    // A store through a list narrowed by name is checked against its narrowed element.
    if (
      keyHasPrefix(npKeys[r], pfx)
      && !(keyHasPrefix(npKeys[r], root + LIST_EVERY_STEP) && narFitNameOf(r) != "")
      && !(elemKeyBase(npKeys[r]) == root && elemOnlyStoreKeeps(r, depth, val, rt))
    ) {
      let rprev = -1
      if npInvBy[r] < 0 { rprev = npTys[r] }
      narSetInv(r, atIx)
      noteKillSure(atIx, npKeys[r])
      // Unknown after the write, which an arm join must not merge a fact back over.
      narClobPlacePush(npPlace[r])
      narClobTysPush(-1)
      narClobPrevPush(rprev)
      narClobDepthsPush(T.frames.length)
      narClobRetiredPush(2)
      narClobBindPush(-1)
      narClobDeclPush(-1)
    }
    r = r + 1
  }
}

// The bare-name arm of `retireNarrowingsForWrite`: a write `atIx` of type `rt` to `tgtIx`
// retires or keeps the name's narrowing, re-narrows it to the member stored, and pushes the
// join's row. `preAsgTy` is the name's type before the assignment, -1 when unknown.
function retireNameNarrowing(tgtIx: i32, rt: i32, atIx: i32, preAsgTy: i32) {
  const tn = nodeAt(tgtIx)
  if tn is Ident {
    const nm = tn.identName
    const s = identSlotOf(tgtIx, nm)
    let dcl = narDeclaredTy(s, -1)
    const guarded = dcl >= 0 && narGuardSlot(s) >= 0
    if guarded {
      const ws = narWriteStorage(s)
      if ws >= 0 { dcl = ws }
    }
    if dcl >= 0 {
      const pre = declTyOf(s)
      let rn = writeReNarrowTy(dcl, rt)
      // What the arm join reads a write that kept its narrowing as ending at.
      let keptEnd = rn
      let retires = writeRetiresNarrowing(nm, rt, nm, pre)
      // Under a guard the write re-narrows to what it stored, as a declaration-typed write
      // would, even when the narrowing already admitted it (`5` into an `f64` arm).
      if guarded {
        rn = writeNarrowAfter(dcl, pre, asgLitRhsTy(atIx, dcl, rt))
        retires = !tySame(rn, pre)
        if !retires { asgKeepNarrowSetAt(atIx, true) }
        // A kept write ends at the member it kept; a later null test of it is a dead-test
        // warning, not a refusal (DECISIONS.md, "A null test of a value proved non-null").
        keptEnd = rn
      }
      // A value typed at a declared type parameter into a declaration that admits null reads as
      // the parameter: whether it is null is its pin's question, which the body re-asks there.
      const tvWrite = tvPlaceWrite(dcl, rt)
      if tvWrite {
        rn = tvWriteTy(dcl, rt, pre)
        keptEnd = rn
        retires = pre != rn
        if guarded { asgKeepNarrowSetAt(atIx, false) }
      } else if retires && !guarded && tyIsTvWriteOf(pre, dcl, -1) {
        // A later write re-narrows from the declaration, as the first write's strip would.
        rn = writeMemberTy(dcl, asgLitRhsTy(atIx, dcl, rt))
      }
      if retires {
        // The RETIREMENT goes back in place, so it outlives whatever inner block holds the
        // write: a narrowing the write falsified must not resurrect at that block's `}`.
        const d = declDepthOf(s)
        if guarded { narRetireLayers(s, rn, dcl) }
        if d >= 0 { narSetScope(d, s, dcl) }
        // The RE-NARROW — the one member of the declaration the written value can be — is a
        // shadow in the CURRENT block instead, because that is exactly how long the emitter's
        // own push lives (its `restoreNarrow` unwinds at the same `}`). Banked at the
        // assignment node so both halves lower the reads after the write alike (D1736).
        if rn != dcl {
          noteNarShadow(s, dcl, NAR_KIND_GUARD)
          declareSlot(s, rn)
        }
        recordAsgNarTyIx(atIx, rn)
      }
      // The emitter reads the place at its declaration; the reads' own types carry the pin.
      if tvWrite { recordAsgTvWrite(atIx, dcl) }
      if guarded && tyAdmitsNull(dcl) { narNoteWritten(s) }
      // A kept write ends at the member of the declaration it stored, when that is narrower
      // than the narrowing it kept (a nullable union's inner member); else at that narrowing.
      if !retires && !guarded { keptEnd = writeMemberTy(dcl, rt) }
      if !retires && pre >= 0 && !assignable(keptEnd, pre) { keptEnd = pre }
      // Every write joins, retiring or not: an arm that wrote a member the narrowing already
      // allowed still ENDS at that member, and the first arm's in-place retirement is what
      // makes the second arm's flip look admitted (D1846). Its before-type is the name's as
      // the assignment found it, ahead of the null-strip shadow the assignment itself declared.
      const np = placeIntern(s, nm, false)
      narClobPlacePush(np)
      if retires { narClobTysPush(rn) } else { narClobTysPush(keptEnd) }
      if preAsgTy >= 0 {
        narClobPrevPush(preAsgTy)
      } else {
        narClobPrevPush(pre)
      }
      narClobDepthsPush(T.frames.length)
      let rtd = 0
      if retires { rtd = 1 }
      narClobRetiredPush(rtd)
      narClobBindPush(-1)
      narClobDeclPush(narPlaceBind(np))
    }
  }
}

// The type a bare name reads at after an accepted write retired its narrowing: the sole member
// of its declared type the written value is assignable to. The declared type when the write
// names no single member, which keeps every null-bearing write reading at the declaration —
// the rep the emitter's own retirement leaves in place (D1736).
function writeReNarrowTy(dcl: i32, rt: i32) {
  if rt < 0 || dcl < 0 { return dcl }
  if isNullTy(rt) { return dcl }
  const rtT = tyAt(rt)
  if rtT is TyNullable { return dcl }
  const d = tyAt(dcl)
  if d is TyUnion {
    let hit = -1
    let n = 0
    let i = 0
    while i < d.uMembers.length {
      if assignable(rt, d.uMembers[i]) {
        hit = d.uMembers[i]
        n = n + 1
      }
      i = i + 1
    }
    if n == 1 { return hit }
  }
  dcl
}

// Settle the path narrowing in overlay slot `slot` that the call at `callIx` just ended: bank
// its key for the emitter to retire after the open statement, so reads after that statement
// read the declared type and a re-test narrows afresh. A slot of an enclosing function, or a
// call with no statement of its own function open, stays unsettled and keeps refusing (D2405).
export function crPathCallRetire(slot: i32, callIx: i32) {
  if slot < crFnNpBase() { return 0 }
  crLoopReadCheck(slot, callIx)
  crCaptureCallCheck(slot, callIx)
  // A verdict an untyped receiver forced is the checker not knowing, not a write: it keeps the
  // refusal, so a re-check at the call's argument types decides rather than inheriting a
  // declared-type read this body never needed. A read each pin answers is that re-check (D3446).
  if crCalleeUnresolved(callIx) { return 0 }
  if crInHoleTemplate() && !tyIsWriteLandRead(npTys[slot]) { return 0 }
  const top = crStmtIxs.length - 1
  if top < 0 || crStmtFns[top] != crFnBases.length {
    // A monomorphization re-check opens no statement; the original check settled this call.
    if crCallSettled[callIx] ?? false { npSettleSetAt(slot, -1) }
    return 0
  }
  const st = crStmtIxs[top]
  npSettleSetAt(slot, st)
  // A quiet pass types the body before its receivers have types, so a method call there may
  // read as opaque; only the real pass's answer reaches the emitter.
  if inferQuiet { return 0 }
  crAfterBank[st] = strListWith(crAfterBank[st] ?? crNoNames, npKeys[slot])
  crCallSettled[callIx] = true
  crRetNames.push(npKeys[slot])
  crRetCalls.push(callIx)
  crRetNarTys.push(npTys[slot])
  crRetWideTys.push(-1)
  crRetRoots.push(crCurRoot())
  crRetLoops.push(false)
  0
}

// A path read under a narrowing an enclosing function made: the nested function may run after
// a call there has written the path.
export function crNoteCaptureRead(p: i32) {
  const slot = narrowedPathIx(p)
  if slot < 0 || slot >= crFnNpBase() { return 0 }
  const key = npKeys[slot]
  // An in-place `map`/`filter` callback of the function that made the narrowing has run by the
  // time any later call does.
  const nf = crFnNpBases.length
  if nf >= 2 && slot >= crFnNpBases[nf - 2] {
    if crCallbackKeeps(crFnIxs[crFnIxs.length - 1], p, key) { return 0 }
  }
  if npCapBy[slot] < 0 { npCapBySetAt(slot, crFnIxs[crFnIxs.length - 1]) }
  0
}

// A read of a path whose captured narrowing `crPathCaptureLost` dropped, for the note a refusal
// of that read gains: the function that dropped it, at the scope depth it is checked in.
export function crNoteLostRead(p: i32, ix: i32) {
  const slot = narrowedPathIx(p)
  if slot < 0 { return 0 }
  const key = npKeys[slot]
  if !crPathCaptureLost(slot, key) { return 0 }
  // The emitter replays no narrowing of this path into the body (`capWidenOf`, D3419).
  if crFnIxs.length > 0 {
    const fnIx = crFnIxs[crFnIxs.length - 1]
    crCapWidenBank[fnIx] = strListWith(crCapWidenBank[fnIx] ?? crNoNames, key)
  }
  if npInvBy[slot] >= 0 { return 0 }
  crLostPush(key, ix, crFnIxs[crFnIxs.length - 1], crFnBases.length, false)
  0
}

// Whether the path narrowing in overlay slot `slot` is lost to the nested function being checked:
// the slot belongs to an enclosing function, and a function between the two escapes — it may run
// after that function returns, when any holder of the object may have written the path (D2407).
function crPathCaptureLost(slot: i32, key: string): boolean {
  if (
    slot >= 0
    && slot < npAsg.length
    && slot < crFnNpBase()
    && npAsg[slot] == 1
  ) {
    return true
  }
  let lv = crFnNpBases.length - 1
  while lv >= 0 && slot < crFnNpBases[lv] {
    if crFnEscapesAt(lv, npPlace[slot], key) { return true }
    lv = lv - 1
  }
  false
}

// Whether the function checked at level `lv` of `crFnIxs` may run other than by a call of its
// handle in the body that makes it, or as a callback that runs inside the call it is handed to.
function crFnEscapesAt(lv: i32, p: i32, key: string): boolean {
  const fnIx = crFnIxs[lv]
  // A top-level function is its own root, and any code of the module may call it.
  const isRoot = crFnRoots[lv] == fnIx
  if isRoot { return true }
  const h = crLambdaHandle(fnIx)
  if h == "" { return !crCallbackKeeps(fnIx, p, key) }
  let body = crProgRoot
  if lv >= 1 {
    const pf = nodeAt(crFnIxs[lv - 1])
    if pf is FuncDecl { body = pf.fnBody }
  }
  crEscapesIn(body, h)
}

// A call that ends a path narrowing a nested function already read under is refused: that
// function may run after the call, reading the old narrowing (D2402).
export function crCaptureCallCheck(slot: i32, callIx: i32) {
  const rd = npCapBy[slot]
  if rd < 0 { return 0 }
  // Calling the reader itself runs it now, under the narrowing.
  crwEnsure(crCurRoot())
  let own = crwBindOf[rd] ?? ""
  let ownDecl = crwBindDeclOf[rd] ?? -1
  const rdn = nodeAt(rd)
  if rdn is FuncDecl {
    if rdn.fnName != "" {
      own = rdn.fnName
      ownDecl = rd
    }
  }
  if own != "" && calleeNameOf(callIx) == own { return 0 }
  // Nor can it run later once its only handle has gone out of scope without escaping.
  if own != "" && declDepthOf(ownDecl) < 0 && !crNameEscapesHere(own) {
    return 0
  }
  tErrCoded(
    "'"
      + npKeys[slot]
      + "' is read at its narrowed type by the function on line "
      + i32ToStr(nodeLineOf(rd))
      + ", which may run after "
      + crCallDesc(callIx, false)
      + " writes it — re-test '"
      + npKeys[slot]
      + "' inside that function",
    callIx,
    CODE_NARROWING_ENDED_BY_CALL,
  )
  0
}

// A call in a loop that ends a path narrowing made outside the loop is refused when the loop read
// the path under that narrowing before the call: the read runs again after the call (D2403).
export function crLoopReadCheck(slot: i32, callIx: i32) {
  const fb = crFnReBase()
  let b = fb
  while b < reNpBases.length && reNpBases[b] <= slot { b = b + 1 }
  if b >= reNpBases.length { return 0 }
  let r = reRdMarks[b]
  while r < crLoopRdSlots.length {
    if crLoopRdSlots[r] == slot {
      tErrCoded(
        "'"
          + npKeys[slot]
          + "' was narrowed by a guard outside this loop, and "
          + crCallDesc(callIx, false)
          + " can write it, so the read on line "
          + i32ToStr(nodeLineOf(crLoopRdNodes[r]))
          + " would see the old narrowing on the next iteration — re-test '"
          + npKeys[slot]
          + "' inside the loop",
        callIx,
        CODE_NARROWING_ENDED_BY_CALL,
      )
      return 0
    }
    r = r + 1
  }
  0
}

// ── a call that may reassign a narrowed binding ends the narrowing (D2390) ─────────────────

// May the call at `callIx` write the place `p` spelled `key` — a bare name, or a path such as
// `o.v` or `xs[0]`? Answers true when unsure. DECISIONS.md, "A call that may reassign a
// narrowed binding ends the narrowing".
export function callMayWrite(callIx: i32, p: i32, key: string): boolean {
  if isPathKey(key) { return p < 0 || callInvalidatesNarrowedPath(callIx, p) }
  const s = placeDecl(p)
  if s == -1 { return true }
  // Nothing reassigns a `const`, whatever a callee writes under its name (D3019).
  if declIsConst(s) { return false }
  crCallReaches(callIx, s)
}

export function crStmtLeave() {
  const top = crStmtIxs.length - 1
  if top < 0 { return 0 }
  if narDefStmt.length > 0 { narApplyDeferred(crStmtIxs[top]) }
  const pb = crStmtPend[top]
  while crPendNames.length > pb {
    crPendNames.pop()
    crPendCalls.pop()
    crPendNarTys.pop()
    crPendDepths.pop()
  }
  const rb = crStmtRd[top]
  while crRdRet.length > rb {
    crRdRet.pop()
    crRdIx.pop()
  }
  crStmtIxs.pop()
  crStmtFns.pop()
  crStmtPend.pop()
  crStmtRd.pop()
  crStmtScopes.pop()
  0
}

// Push a path entry `name.f` for each field the record `nt` stores narrower than the record
// `declTy` or another member of the union `declTy`, so the path rules decide when a write through
// another place ends `name` too. Members that cannot hold an `nt` need none. A list narrowed by
// its elements gets `name[*]` per nesting depth instead (`narFitElems`).
export function narFitCompanions(p: i32, declTy: i32, nt: i32) {
  while nfSlots.length > 0 && nfSlots[nfSlots.length - 1] >= npKeys.length {
    nfSlotsPop()
    nfNamesPop()
  }
  if nt < 0 || declTy < 0 { return 0 }
  const r = tyAt(nt)
  if r is TyObj { narFitFields(p, declTy, nt, r) }
  narFitElems(p, declTy, nt)
  0
}

function narFitFields(p: i32, declTy: i32, nt: i32, r: TyObj) {
  let wide = declTy
  const dt = tyAt(declTy)
  if dt is TyNullable { wide = dt.nInner }
  if wide < 0 { return 0 }
  const u = tyAt(wide)
  narFitMembers(p, nt, r, if u is TyUnion { u.uMembers } else { [wide] })
  0
}

// A list narrowed by its elements (`b is K[]`) narrows its reads only: delivered whole, or as a
// field or element of a literal, to a type its declared type does not fit, it would outlive the
// guard as a `K[]` the declared type still writes (D4928). Reports each such delivery and answers
// true when it reported one; a `map` copy is the conversion.
export function narListDeliveryErr(
  srcExpr: i32,
  srcTy: i32,
  dstTy: i32,
): boolean {
  if srcExpr < 0 || dstTy < 0 { return false }
  const ix = peelParenIx(srcExpr)
  if ix < 0 || ix >= P.nodes.length { return false }
  const s = nodeAt(ix)
  if s is ObjLit { return narListDeliveryFields(s, nonNullTy(dstTy)) }
  if s is ArrayLit {
    const dn = nonNullTy(dstTy)
    if dn < 0 { return false }
    const da = tyAt(dn)
    if !(da is TyArray) { return false }
    let hit = false
    for e in s.arrElems {
      if narListDeliveryErr(e, nodeTyOf(e), da.aElem) { hit = true }
    }
    return hit
  }
  // The list itself, or a row of it still a list (`b[0]` under `b is K[][]`, D4945).
  const pfx = elemRecvPrefix(ix)
  if pfx == "" { return false }
  const name = elemKeyBase(pfx)
  const rows = elemKeyDepth(pfx)
  const slot = elemEverySlotOf(name)
  if slot < 0 || npInvBy[slot] >= 0 { return false }
  const key = npKeys[slot]
  const leaf = npTys[slot]
  const depth = elemKeyDepth(key) - rows
  if depth <= 0 { return false }
  const byName = narFitNameOf(slot) != ""
  if byName && !assignable(srcTy, dstTy) { return false }
  if !byName && !listLeafFits(leaf, dstTy, depth) { return false }
  // A field or subscript place is typed as declared, the narrowing being on its elements alone.
  let decl = srcTy
  if !isPathKey(name) {
    const ns = slotVisibleOf(placeDecl(npPlace[slot]))
    decl = narDeclaredTy(ns, -1)
    if decl < 0 { decl = declTyOf(ns) }
    let r = 0
    while r < rows && decl >= 0 {
      decl = placeElemTy(listUnionWidest(nonNullTy(decl)))
      r = r + 1
    }
  }
  if decl < 0 { return false }
  if narDeclFitsDst(decl, dstTy) {
    narListDeclReads[ix] = true
    return false
  }
  const text = narRowText(ix)
  const copy = "'" + text + mapCopyText(depth) + "'"
  tErr(
    "'"
      + text
      + "' is narrowed by `is` only for reading its elements; it is still declared "
      + tyToStr(decl)
      + " and a later write may widen it, so it cannot be delivered as "
      + tyToStr(dstTy)
      + ". Copy it with "
      + copy,
    ix,
  )
  true
}

// Whether a narrowed list's declared type `decl` fits `dst` at every instantiation. A type
// parameter in `decl` is gradual to `assignable`, so it fits a concrete `dst` only at some
// instances, and a delivery there would hand the other instances a fresh list (D4928).
function narDeclFitsDst(decl: i32, dst: i32): boolean {
  if !assignable(decl, dst) { return false }
  !tyHasTyVar(decl) || tyHasTyVar(dst)
}

// `narListDeliveryErr` over the fields of a record literal delivered to the record type `dst`.
function narListDeliveryFields(o: ObjLit, dst: i32): boolean {
  let hit = false
  for fx in o.objFields {
    const f = nodeAt(fx)
    if f is FieldInit {
      const ft = tyFieldTyOf(dst, f.fiName)
      if ft >= 0 && narListDeliveryErr(f.fiValue, nodeTyOf(f.fiValue), ft) {
        hit = true
      }
    }
  }
  hit
}

// The fields of `r` (the record `nt`) a member of `mems` that holds every `nt` stores wider.
function narFitMembers(p: i32, nt: i32, r: TyObj, mems: i32[]) {
  let f = 0
  while f < r.objFieldNames.length {
    const ft = r.objFieldTypes[f]
    let wider = false
    for m in mems {
      if (
        !wider
        && m >= 0
        && m != nt
        && tyAt(m) is TyObj
        && assignable(nt, m)
        && !assignable(m, nt)
      ) {
        const mo = tyAt(m)
        if mo is TyObj {
          const mt = objFieldType(mo, r.objFieldNames[f])
          wider = mt >= 0 && ft >= 0 && !tySame(mt, ft)
        }
      }
    }
    if wider {
      nfSlotsPush(npKeys.length)
      nfNamesPush(placeText(p))
      npKeysPush(placeWith(p, "." + r.objFieldNames[f]))
      npTysPush(ft)
      npInvByPush(-1)
      npEpochsPush(narFnEpoch)
      npSettlePush(-2)
      npCapByPush(-1)
      npAsgPush(0)
    }
    f = f + 1
  }
  0
}

// A declaration in a block inside a narrowed binding's scope shadows it, and a call there may
// still write that binding. Its narrowing ends in the checker at once, since nothing in the block
// can read it, and in the emitter after the statement holding the block, where the name reaches it
// again. `loopIx` >= 0 asks of the loop there rather than of the call `callIx` (D3020).
function crRetireShadowed(v: i32, callIx: i32, loopIx: i32) {
  if v < 0 { return 0 }
  const base = crFnBase()
  // Each bound declaration `v` hides, innermost first; the narrowing may sit at the binding's
  // own depth (a straight-line write or a join installed there, D3306).
  let up = v
  let o = declShadowOf(v)
  let hops = 0
  while o >= 0 && hops < 64 {
    const e = slotLayerTop(o)
    if e >= 0 {
      const td = slotLayerDepth(e)
      if td < base { return 0 }
      const ud = crBindDepthOfSlot(up)
      if td < ud && crIsNarrowLayer(o, td) {
        crRetireHidden(o, ud, callIx, loopIx)
      }
      up = o
    }
    o = declShadowOf(o)
    hops = hops + 1
  }
  0
}

// Retires the narrowing of `hs`, hidden by a declaration at depth `ud`, at the call `callIx` or
// at the first call in the loop `loopIx` that may write it.
function crRetireHidden(hs: i32, ud: i32, callIx: i32, loopIx: i32) {
  const st = crStmtHolding(ud)
  const name = slotNameOf(hs)
  let c = callIx
  if loopIx >= 0 {
    c = -1
    if crMayBeWritten(hs) {
      c = crFirstWritingCall(loopIx, placeBare(hs), name)
    }
  } else if !callMayWrite(c, placeBare(hs), name) {
    c = -1
  }
  // The join row names this binding, which only the joins outside the shadow reach.
  if c >= 0 && st >= 0 {
    crRetireAt(hs, c, false, st, false, crBindDepthOfSlot(hs))
  }
  0
}

// A nested function runs when called, so a captured narrowing of a binding some function may
// write reads at its declared type in the body, bound in the body's own scope. A lambda passed
// straight to an array's `map` or `filter` runs inside that call and keeps the narrowing, unless
// its own body may write the binding (D2402).
export function crCaptureWiden(fnIx: i32) {
  if crCurRoot() == fnIx { return crRootCaptureWiden(fnIx) }
  // A body is checked more than once. The real pass decides alone, so it starts the bank over;
  // a quiet pass (return inference, a monomorphization re-check of a clone, whose root the
  // writer analysis cannot see) only adds, and widens what the bank already names.
  const prior = crCapWidenBank[fnIx] ?? crNoNames
  if !inferQuiet { crCapWidenBank[fnIx] = [] }
  // A name an enclosing body widened is widened here too: the emitter records a nested
  // function's captures from the frame the whole nest is written in.
  let f = 0
  while f < crFnIxs.length - 1 {
    const ups = crCapWidenBank[crFnIxs[f]] ?? crNoNames
    let u = 0
    while u < ups.length {
      crCapWidenBank[fnIx] = strListWith(
        crCapWidenBank[fnIx] ?? crNoNames,
        ups[u],
      )
      u = u + 1
    }
    f = f + 1
  }
  const base = crFnBase()
  if asgDeclSlots.length == 0 || asgDeclDepths[0] >= base { return 0 }
  let escapes = -1
  // Only a name the body reads needs an answer.
  const reads = crBodyReads(fnIx)
  let r = 0
  while r < reads.length {
    const s = crReadSlot(reads[r])
    const nm = slotNameOf(s)
    const i = crInnerRowBelow(s, base)
    if i >= 0 {
      const wide = crOuterWidest(s, base)
      if wide >= 0 && wide != declTyOf(s) {
        if inferQuiet && strListHas(prior, nm) {
          crDeclareWidened(s, wide)
        } else if crCaptureLosesNarrowing(fnIx, s, asgDeclKinds[i], wide) {
          crDeclareWidened(s, wide)
          crCapWidenBank[fnIx] = strListWith(
            crCapWidenBank[fnIx] ?? crNoNames,
            nm,
          )
          crCapLossBank[fnIx] = strListWith(
            crCapLossBank[fnIx] ?? crNoNames,
            nm,
          )
          crCapLossAny = true
        } else if (
          crElemNarrowLive(s, nm)
          && !crCallbackKeeps(fnIx, placeBare(s), nm)
        ) {
          crDeclareWidened(s, wide)
          crCapWidenBank[fnIx] = strListWith(
            crCapWidenBank[fnIx] ?? crNoNames,
            nm,
          )
        } else if crCaptureMayGoStale(fnIx, s) {
          if escapes < 0 { escapes = crLambdaEscapes(fnIx) }
          const fnWriter = crMayBeWritten(s)
          if escapes == 0 && !fnWriter && !crNameAssigned(s) {
            // Nothing can change it.
          } else if (
            escapes == 0
            && !crBodyMayWrite(fnIx, s)
            && !crBodyTests(fnIx, nm)
          ) {
            crCapRecDepths.push(crFnBases.length - 1)
            const hd = crLambdaHandle(fnIx)
            crCapRecHandles.push(hd)
            crCapRecCount[hd] = (crCapRecCount[hd] ?? 0) + 1
            crCapRecNames.push(nm)
            crCapRecSlots.push(s)
            crCapRecTys.push(declTyOf(s))
            crCapRecFns.push(fnIx)
          } else {
            crDeclareWidened(s, wide)
            crCapWidenBank[fnIx] = strListWith(
              crCapWidenBank[fnIx] ?? crNoNames,
              nm,
            )
          }
        }
      }
    }
    r = r + 1
  }
  0
}

// Whether the nested function `fnIx` may read a captured narrowing of slot `s` after it stopped
// holding: some function may write it, or it is ever assigned and the nested function
// escapes the body making it, so it may run after that assignment (D2462). A callback run inside
// the call it is handed to cannot.
function crCaptureMayGoStale(fnIx: i32, s: i32): boolean {
  if crCallbackKeeps(fnIx, placeBare(s), slotNameOf(s)) { return false }
  if crMayBeWritten(s) { return true }
  crNameAssigned(s)
}

// Whether a captured narrowing of slot `s` cannot outlive the capture: the nested function `fnIx`
// may run after a write that may store `null`, and its body then reads the storage at the
// declared type (D2529). A guard's narrowing refuses such a write under it, and a callback run
// inside the call it is handed to runs before any later write, so both are left to D2402.
function crCaptureLosesNarrowing(
  fnIx: i32,
  s: i32,
  kind: i32,
  wide: i32,
): boolean {
  if kind == NAR_KIND_GUARD { return false }
  const name = slotNameOf(s)
  if crCallbackKeeps(fnIx, placeBare(s), name) { return false }
  if crNameIsModuleTop(s) { return crNameNulledInProgram(s) }
  // A shared cell of a scalar box is read at the box, so any later write ends it there (D2555).
  crCaptureByRef(crSlotFrame(s), name, crTyIsScalarBox(wide))
}

// Whether running the nested function `fnIx` may itself write slot `s`.
function crBodyMayWrite(fnIx: i32, s: i32): boolean {
  const fd = nodeAt(fnIx)
  if fd is FuncDecl {
    const name = slotNameOf(s)
    if crSubtreeAssigns(fd.fnBody, name) { return true }
    return crFirstWritingCall(fd.fnBody, placeBare(s), name) >= 0
  }
  true
}

// A call of a nested function that kept a captured narrowing is refused unless the binding
// still holds the captured type there: a writer may have run since the function's creation.
export function crCapRecCheck(callIx: i32) {
  if crCapRecHandles.length == 0 { return 0 }
  const h = calleeNameOf(callIx)
  const cn = nodeAt(callIx)
  if !(cn is Call) || h == "?" { return 0 }
  if (crCapRecCount[h] ?? 0) <= 0 { return 0 }
  let r = 0
  while r < crCapRecHandles.length {
    if crCapRecHandles[r] == h && crCapRecDepths[r] == crFnBases.length {
      const nm = crCapRecNames[r]
      const cs = crCapRecSlots[r]
      if !tySame(declTyOf(cs), crCapRecTys[r]) {
        let by = "a write"
        if crMayBeWritten(cs) { by = "a call" }
        tErrCoded(
          "'"
            + h
            + "', made on line "
            + i32ToStr(nodeLineOf(crCapRecFns[r]))
            + ", reads '"
            + nm
            + "' as "
            + tyToStr(crCapRecTys[r])
            + ", a narrowing "
            + by
            + " since then may have ended — re-test '"
            + nm
            + "' before this call, or inside '"
            + h
            + "'",
          callIx,
          CODE_NARROWING_ENDED_BY_CALL,
        )
        return 0
      }
    }
    r = r + 1
  }
  0
}

// Whether the lambda `fnIx`, written in place as a call's argument, runs only inside that call
// and nothing then writes the place keyed `key`: the callee is an array's `map`/`filter`, or a
// declaration whose body only ever calls that parameter, and the call reaches no writer. Its
// own body must neither write `key` nor call what may.
function crCallbackKeeps(fnIx: i32, p: i32, key: string): boolean {
  if fnIx < 0 || fnIx >= P.nodes.length { return false }
  const fd = nodeAt(fnIx)
  if !(fd is FuncDecl) { return false }
  if (
    crSubtreeAssigns(fd.fnBody, key)
    || crFirstWritingCall(fd.fnBody, p, key) >= 0
  ) {
    return false
  }
  crwEnsure(crCurRoot())
  const c = crwArgCall[fnIx] ?? -1
  if c < 0 || c >= P.nodes.length { return false }
  const cn = nodeAt(c)
  if cn is Call {
    const d = callDeclFnIx(cn, c)
    if cn.callFn >= 0 {
      const cf = nodeAt(cn.callFn)
      if cf is Member {
        if (cf.memProp == "map" || cf.memProp == "filter") && d == -2 {
          return true
        }
      }
    }
    if d < 0 { return false }
    const args = callArgPlaces(cn, c)
    let at = -1
    let i = 0
    while i < args.length {
      if peelParenIx(args[i]) == fnIx { at = i }
      i = i + 1
    }
    if at < 0 || !crParamOnlyCalled(d, at) { return false }
    return !callMayWrite(c, p, key)
  }
  false
}

// The bare-name narrowings the call at `callIx` ends — a `Call`, or an operator that dispatched
// to a declaration. Runs after the call is checked, with the statement holding it still open.
export function crNoteCallBare(callIx: i32) {
  if asgDeclSlots.length == 0 || crStmtIxs.length == 0 { return 0 }
  // A body checked with no statement of its own open (a monomorphization re-check) banks
  // nothing: the open statement is its caller's.
  if crStmtFns[crStmtFns.length - 1] != crFnBases.length { return 0 }
  const slots = crCallCandidates()
  let i = 0
  while i < slots.length {
    const s = slots[i]
    const nm = slotNameOf(s)
    if s != -1 && callMayWrite(callIx, placeBare(s), nm) {
      crRetire(s, callIx, false, crStmtIxs[crStmtIxs.length - 1])
    }
    crRetireShadowed(s, callIx, -1)
    i = i + 1
  }
  0
}

// `crLiveSlots` less those no call can retire, which `callMayWrite` and `crRetireShadowed`
// leave alone: a bare name no nested function of the root writes, bound once, inside the
// function. Kept per nesting level across calls, so a call costs what changed since the last.
function crCallCandidates(): i32[] {
  const root = crCurRoot()
  if crwRoot != root { return crLiveSlots() }
  let fb0 = -1
  if crFnBases.length > 0 && root != crProgRoot { fb0 = crFnBases[0] }
  const base = crFnBase()
  const lv = crFnBases.length
  while ccLevels.length <= lv { ccLevels.push(ccFresh(-2, -1, -1, 0)) }
  let c = ccLevels[lv]
  if (
    c.root != root
    || c.gen != crwGen
    || c.fb0 != fb0
    || c.base != base
    || c.log > scopeDeclLog.length
  ) {
    c = ccFresh(root, fb0, base, ccFrameStart(base))
    ccLevels[lv] = c
  }
  ccTruncate(c)
  let i = c.rows
  while i < asgDeclSlots.length {
    const nm = slotNameOf(asgDeclSlots[i])
    if asgDeclDepths[i] >= base && (c.first[nm] ?? -1) < 0 {
      c.first[nm] = i
      c.names.push(nm)
      c.nameRows.push(i)
      if ccKeeps(asgDeclSlots[i], nm, fb0) { ccAddCand(c, nm, i) }
    }
    i = i + 1
  }
  c.rows = asgDeclSlots.length
  if c.rows > 0 { c.stamp = asgDeclStamps[c.rows - 1] }
  // A name declared again since may have become one a call retires.
  let g = c.log
  while g < scopeDeclLog.length {
    const nm = slotNameOf(scopeDeclLog[g])
    const r = c.first[nm] ?? -1
    if r >= 0 && !(c.isCand[nm] ?? false) && ccKeeps(asgDeclSlots[r], nm, fb0) {
      ccAddCand(c, nm, r)
    }
    g = g + 1
  }
  c.log = scopeDeclLog.length
  const out: i32[] = []
  for r in c.candRows { out.push(slotVisibleOf(asgDeclSlots[r])) }
  out
}

// One level's `crCallCandidates` state: its key, the bank prefix it has read (`rows`, whose
// last row's stamp is `stamp`) and the log prefix, each frame name's first row, and the
// candidates among them in row order.
type CallCands = {
  root: i32,
  gen: i32,
  fb0: i32,
  base: i32,
  rows: i32,
  stamp: i32,
  log: i32,
  first: {[string]: i32},
  names: string[],
  nameRows: i32[],
  isCand: {[string]: boolean},
  cands: string[],
  candRows: i32[],
}

const ccLevels: CallCands[] = []

function ccFresh(root: i32, fb0: i32, base: i32, rows: i32): CallCands {
  let stamp = 0
  if rows > 0 && rows <= asgDeclStamps.length {
    stamp = asgDeclStamps[rows - 1]
  }
  {
    root,
    gen: crwGen,
    fb0,
    base,
    rows,
    stamp,
    log: scopeDeclLog.length,
    first: Map(),
    names: [],
    nameRows: [],
    isCand: Map(),
    cands: [],
    candRows: [],
  }
}

// The first bank row at depth `base` or deeper; the bank's depths never fall along it.
function ccFrameStart(base: i32): i32 {
  let i = asgDeclSlots.length
  while i > 0 && asgDeclDepths[i - 1] >= base { i = i - 1 }
  i
}

// Drop what `c` read from bank rows popped since: the rows it saw that remain are those
// stamped no later than its last one.
function ccTruncate(c: CallCands) {
  if c.rows == 0 { return 0 }
  let keep = c.rows
  if keep > asgDeclSlots.length || asgDeclStamps[keep - 1] != c.stamp {
    let lo = 0
    let hi = keep
    if hi > asgDeclSlots.length { hi = asgDeclSlots.length }
    while lo < hi {
      const mid = (lo + hi) / 2
      if asgDeclStamps[mid] <= c.stamp { lo = mid + 1 } else { hi = mid }
    }
    keep = lo
  }
  while c.names.length > 0 && c.nameRows[c.nameRows.length - 1] >= keep {
    c.first[c.names[c.names.length - 1]] = -1
    c.names.pop()
    c.nameRows.pop()
  }
  while c.cands.length > 0 && c.candRows[c.candRows.length - 1] >= keep {
    c.isCand[c.cands[c.cands.length - 1]] = false
    c.cands.pop()
    c.candRows.pop()
  }
  c.rows = keep
  c.stamp = 0
  if keep > 0 { c.stamp = asgDeclStamps[keep - 1] }
  0
}

// Whether a call can retire live name `nm`, banked for slot `s`.
function ccKeeps(s: i32, nm: string, fb0: i32): boolean {
  const sl = slotNameSoleLayer(s)
  const keep = sl == -2 || (sl >= 0 && sl < fb0)
  if !keep && crCurRoot() == crProgRoot { crAskProg("w", nm) }
  keep || crwWritten(crSlotKey(s)) || isPathKey(nm)
}

// Add `nm`, first banked at row `r`, to `c`'s candidates in row order.
function ccAddCand(c: CallCands, nm: string, r: i32) {
  c.isCand[nm] = true
  c.cands.push(nm)
  c.candRows.push(r)
  let j = c.cands.length - 1
  while j > 0 && c.candRows[j - 1] > r {
    c.cands[j] = c.cands[j - 1]
    c.candRows[j] = c.candRows[j - 1]
    j = j - 1
  }
  c.cands[j] = nm
  c.candRows[j] = r
  0
}

// The first call in the subtree at `ix` that may write place `p` spelled `name`, or -1.
function crFirstWritingCall(ix: i32, p: i32, name: string): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = nodeAt(ix)
  if n is Call || crIsDispatchSite(ix) {
    if callMayWrite(ix, p, name) { return ix }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      const c = crFirstWritingCall(kids[k], p, name)
      if c >= 0 { return c }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  -1
}

// Whether a store of the value `valIx` (typed `rt` once checked, -1 before) into a cell `depth`
// subscripts below its list's name keeps the element-only entry in `slot` (`pushElemReadFact`):
// a store at the entry's own depth of a value its leaf admits.
function elemOnlyStoreKeeps(
  slot: i32,
  depth: i32,
  valIx: i32,
  rt: i32,
): boolean {
  if slot < 0 || slot >= npKeys.length || narFitNameOf(slot) != "" {
    return false
  }
  const key = npKeys[slot]
  const leaf = npTys[slot]
  if leaf < 0 || !keyIsListEvery(key) || elemKeyDepth(key) != depth {
    return false
  }
  let vt = loopWritePeekTy(valIx, leaf)
  if vt < 0 { vt = rt }
  vt >= 0 && !tyIsHole(vt) && !tyHasTyVar(vt) && assignable(vt, leaf)
}

// Whether the call `cn` is a `push` of values the element-only entry of place `p` admits onto a
// list at its depth (`elemOnlyStoreKeeps`), which keeps the entry.
function pushKeepsElemOnly(cn: Call, p: i32): boolean {
  const key = placeText(p)
  if cn.callFn < 0 { return false }
  const cf = nodeAt(cn.callFn)
  if !(cf is Member) || cn.callArgs.length == 0 || cf.memProp != "push" {
    return false
  }
  const slot = narrowedPathIx(p)
  const depth = elemDepthOf(cf.memObj)
  if slot < 0 || depth < 0 { return false }
  if elemKeyBase(elemRecvPrefix(cf.memObj)) != elemKeyBase(key) { return false }
  for a in cn.callArgs {
    if spreadArgOf(a) >= 0 { return false }
    if !elemOnlyStoreKeeps(slot, depth + 1, a, nodeTyOf(a)) { return false }
  }
  true
}

// `crFirstWritingCall` for the element entry of place `p`: a `push` on a list narrowed by name is
// checked against its narrowed element, so only its arguments are asked.
function crFirstElemWritingCall(ix: i32, p: i32): i32 {
  const key = placeText(p)
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = nodeAt(ix)
  let own = false
  if n is Call && n.callFn >= 0 {
    const cf = nodeAt(n.callFn)
    if cf is Member {
      const ro = nodeAt(peelParenIx(cf.memObj))
      if ro is Ident {
        own = (cf.memProp == "push"
          && key == ro.identName + LIST_EVERY_STEP
          && elemKeyStoresChecked(p))
      }
    }
    if !own { own = pushKeepsElemOnly(n, p) }
  }
  if !own && (n is Call || crIsDispatchSite(ix)) {
    if callMayWrite(ix, p, key) { return ix }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      const c = crFirstElemWritingCall(kids[k], p)
      if c >= 0 { return c }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  -1
}

// A loop re-runs the reads before a call after it, so a narrowing live at the loop that a call
// anywhere in the loop may end ends before the loop starts, in both halves.
export function crLoopPreRetire(loopIx: i32) {
  if npKeys.length > 0 {
    cbPendForLoop(loopIx)
    crLoopPathPreRetire(loopIx)
    cbPendClear()
  }
  if asgDeclSlots.length == 0 { return 0 }
  const slots = crLiveSlots()
  let i = 0
  while i < slots.length {
    const s = slots[i]
    const nm = slotNameOf(s)
    let c = -1
    if s != -1 && crMayBeWritten(s) {
      c = crFirstWritingCall(loopIx, placeBare(s), nm)
    }
    // So does a write in the loop that leaves a guard's narrowing (D2609), or a straight-line
    // null strip's: the reads at the loop's top run again after it (D3302).
    if c < 0 && s != -1 && narDeclaredTy(s, -1) >= 0 {
      c = crLoopLeavingWrite(loopIx, s)
    }
    if c >= 0 { crRetire(s, c, true, loopIx) }
    crRetireShadowed(s, -1, loopIx)
    i = i + 1
  }
  0
}

// The path twin: a live path narrowing a write in the loop may leave ends before the loop,
// in both halves, so the reads before that write read the place's declared type.
function crLoopPathPreRetire(loopIx: i32) {
  let s = crFnNpBase()
  if s < 0 { s = 0 }
  // The entries a map cell's presence pushes below are not walked again.
  const n0 = npKeys.length
  while s < n0 && s < npKeys.length {
    if (
      npInvBy[s] < 0
      && npEpochs[s] == narFnEpoch
      && narrowedPathIx(npPlace[s]) == s
    ) {
      let a = crLoopLeavingPathWrite(loopIx, npPlace[s], npTys[s])
      // A `for` over a list reads its next element at the loop's top, after the body's calls,
      // which no read check in the body sees; so an element narrowing a call may end ends here.
      let byCall = false
      if a < 0 && keyIsListEvery(npKeys[s]) {
        a = crFirstElemWritingCall(loopIx, npPlace[s])
        byCall = a >= 0
      }
      if a >= 0 {
        narSetInv(s, a)
        if nfSlots.length > 0 { narFitRetire(s, a, loopIx) }
        noteKillSure(a, npKeys[s])
        npSettleSetAt(s, -1)
        if !byCall { crAliasWr[a] = true }
        crLoopMapCellPresent(npPlace[s], a)
        crRetNames.push(npKeys[s])
        crRetCalls.push(a)
        crRetNarTys.push(npTys[s])
        crRetWideTys.push(-1)
        crRetRoots.push(crCurRoot())
        crRetLoops.push(true)
        crBeforeBank[loopIx] = strListWith(
          crBeforeBank[loopIx] ?? crNoNames,
          npKeys[s],
        )
        narClobPlacePush(npPlace[s])
        narClobTysPush(-1)
        narClobPrevPush(npTys[s])
        narClobDepthsPush(T.frames.length)
        narClobRetiredPush(2)
        narClobBindPush(-1)
        narClobDeclPush(-1)
      }
    }
    s = s + 1
  }
  0
}

// A map cell narrowed before the loop is present, and the loop's writes keep it so: after its
// narrowing ends it reads the stored type, not the map read's `T | null`.
function crLoopMapCellPresent(p: i32, asgIx: i32) {
  const an = nodeAt(asgIx)
  if an is BinExpr {
    if placeIsMapCell(an.binLeft) {
      const st = placeStoreTy(an.binLeft)
      if st >= 0 {
        npKeysPush(p)
        npTysPush(st)
        npInvByPush(-1)
        npEpochsPush(narFnEpoch)
        npSettlePush(-2)
        npCapByPush(-1)
        npAsgPush(0)
      }
    }
  }
  0
}

// The first assignment to the place `p`, narrowed to `pre`, in the loop subtree at `ix` whose
// value, typed before the loop runs, leaves that narrowing; -1 otherwise.
function crLoopLeavingPathWrite(ix: i32, p: i32, pre: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = nodeAt(ix)
  if n is FuncDecl { return -1 }
  if n is BinExpr {
    if n.binOp == "=" && placeAt(n.binLeft) == p {
      const store = writeStorageTy(n.binLeft)
      let vt = loopWritePeekTy(n.binRight, store)
      if vt >= 0 && store >= 0 {
        if !isLitBearing(store) { vt = litPeekBaseTy(vt) }
        if !writeLandsWithin(store, vt, pre) { return ix }
      }
    } else if (
      n.binOp == "="
      && loopWriteMayReach(n.binLeft, n.binRight, p, pre)
    ) {
      return ix
    }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      const a = crLoopLeavingPathWrite(kids[k], p, pre)
      if a >= 0 { return a }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  -1
}

// Whether a loop's write to `tgt` of `val` may end the narrowing of place `p` to `pre` on the next
// iteration though it names another place: a prefix of the key (`o = …` under `o.f`), a cell of
// its receiver at a computed index, or a same-named last step through another receiver, which may
// alias. An unknown value counts as leaving (D3308).
function loopWriteMayReach(tgt: i32, val: i32, p: i32, pre: i32): boolean {
  const key = placeText(p)
  const tk = placeKeyOf(tgt)
  if tk != "" && (keyHasPrefix(key, tk + ".") || keyHasPrefix(key, tk + "[")) {
    return true
  }
  const steps = keySteps(key)
  if steps.length == 0 { return false }
  const last = steps[steps.length - 1]
  const t = nodeAt(peelParenIx(tgt))
  let same = false
  if t is Member { same = last == "." + t.memProp }
  if t is Index {
    const ks = narrowedPathIx(p)
    if ks >= 0 && elemOnlyStoreKeeps(ks, elemDepthOf(tgt), val, -1) {
      return false
    }
    // A store through a list narrowed by name is checked against its narrowed element.
    if last == LIST_EVERY_STEP && steps.length == 1 {
      const ra = nodeAt(peelParenIx(t.idxArr))
      if ra is Ident {
        if ra.identName == placeRootOf(key) && elemKeyStoresChecked(p) {
          return false
        }
      }
    }
    // A literal subscript names its cell, as the straight-line rule reads it (D3317).
    if tk != "" {
      const tsteps = keySteps(tk)
      same = tsteps.length > 0 && tsteps[tsteps.length - 1] == last
      if last == LIST_EVERY_STEP { same = true }
    } else {
      same = last[0] == '['
    }
  }
  if !same { return false }
  // Another receiver's place carries no narrowing of its own, so it stores at its declaration.
  let store = writeStorageTy(tgt)
  if store < 0 { store = placeStoreTy(tgt) }
  let vt = loopWritePeekTy(val, store)
  if vt < 0 || store < 0 { return true }
  if !isLitBearing(store) { vt = litPeekBaseTy(vt) }
  !writeLandsWithin(store, vt, pre)
}

// The first assignment to slot `s` by name in the loop subtree at `ix` whose value, typed before
// the loop runs, leaves the narrowing `s` holds there, or -1. A value whose type
// needs the loop to decide is left to the write itself, which refuses what the loop's entry
// type does not admit.
function crLoopLeavingWrite(ix: i32, s: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = nodeAt(ix)
  if n is FuncDecl { return -1 }
  if n is BinExpr {
    if n.binOp == "=" && placeKeyOf(n.binLeft) == slotNameOf(s) {
      const store = narWriteStorage(s)
      const pre = declTyOf(s)
      let vt = loopWritePeekTy(n.binRight, store)
      if vt >= 0 && store >= 0 && pre >= 0 {
        if !isLitBearing(store) { vt = litPeekBaseTy(vt) }
        if !writeLandsWithin(store, vt, pre) { return ix }
      }
    }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      const a = crLoopLeavingWrite(kids[k], s)
      if a >= 0 { return a }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  -1
}

// Record at the `&&`/`||` node `ix` the left operand's facts its right operand retired, by a write
// or a call: the arm the whole condition guards must not hold them (D2589). Runs while the
// scope the facts live in is still open. A name faced twice is judged by its last fact, the one
// its scope holds.
export function crNoteRhsRetired(
  ix: i32,
  rhs: i32,
  places: i32[],
  tys: i32[],
  npBase: i32,
) {
  const out: string[] = []
  let i = 0
  while i < places.length {
    const p = places[i]
    const nm = placeText(p)
    let by = -1
    if placeIsPath(p) {
      let s = npBase
      while s < npKeys.length && by < 0 {
        if npPlace[s] == p && npInvBy[s] >= 0 { by = npInvBy[s] }
        s = s + 1
      }
    } else if !crNameFacedLater(places, i) && placeNameTy(p) != tys[i] {
      by = crFirstAssignOf(rhs, nm)
      if by < 0 { by = crFirstWritingCall(rhs, p, nm) }
      if by < 0 { by = rhs }
    }
    if by >= 0 {
      strListAdd(out, nm)
      crRhsOps.push(ix)
      crRhsNames.push(nm)
      crRhsBys.push(by)
    }
    i = i + 1
  }
  if out.length == 0 {
    if crRhsRetired.length > 0 { crRhsRetired[ix] = [] }
    return 0
  }
  crRhsRetired[ix] = out
  0
}

// Drop the facts collected since `mark` that a call inside the condition may falsify:
// the test ran before the call. Banked at the condition for the emitter's matching decline.
function crFilterCond(condIx: i32, places: i32[], tys: i32[], mark: i32) {
  if places.length <= mark { return 0 }
  let w = mark
  let i = mark
  while i < places.length {
    let keep = true
    const nm = placeText(places[i])
    if placeIsPath(places[i]) || crMayBeWritten(placeDecl(places[i])) {
      const wc = crFirstWritingCall(condIx, places[i], nm)
      if wc >= 0 {
        keep = false
        crCondDropBank[condIx] = strListWith(
          crCondDropBank[condIx] ?? crNoNames,
          nm,
        )
        crCondDropN = crCondDropN + 1
        crRetNames.push(nm)
        crRetCalls.push(wc)
        crRetNarTys.push(tys[i])
        crRetWideTys.push(placeNameTy(places[i]))
        crRetRoots.push(crCurRoot())
        crRetLoops.push(false)
      }
    }
    if keep {
      places[w] = places[i]
      tys[w] = tys[i]
      w = w + 1
    }
    i = i + 1
  }
  while places.length > w {
    places.pop()
    tys.pop()
  }
  0
}

// The read hook: a read of `name` after the call that retired it, in the same statement, is
// refused; any other read at the retired type is remembered for the misuse note. -1 lets the
// read through.
export function crReadHook(name: string, ix: i32): i32 {
  if crRetNames.length == 0 { return -1 }
  let p = crPendNames.length - 1
  while p >= 0 {
    if crPendNames[p] == name {
      let tail = " earlier in this statement may reassign it — read '"
        + name
        + "' in a statement after the call, and re-test it there"
      // Read inside a block the call's statement holds — an `if` arm the call's condition guards.
      if crStmtIxs.length > crPendDepths[p] {
        tail = ", in the statement that holds this one, may reassign it — '"
          + name
          + "' can be read again after that statement"
      }
      tErrCoded(
        "'"
          + name
          + "' is no longer narrowed to "
          + tyToStr(crPendNarTys[p])
          + ": "
          + crCallDesc(crPendCalls[p], false)
          + tail,
        ix,
        CODE_NARROWING_ENDED_BY_CALL,
      )
      return TY_ERR
    }
    p = p - 1
  }
  if crStmtIxs.length == 0 { return -1 }
  const cur = identTyOf(ix, name)
  const root = crCurRoot()
  let r = crRetNames.length - 1
  while r >= 0 {
    if crRetNames[r] == name && crRetRoots[r] == root {
      if crRetWideTys[r] == cur {
        crRdRet.push(r)
        crRdIx.push(ix)
      }
      return -1
    }
    r = r - 1
  }
  -1
}

// The diagnostic for reading a path whose narrowing a write retired. It names the write, not
// merely the nullness, because the write is what the reader has to act on — the guard above and
// the read below are both correct, and only their separation is wrong. An aliasing call and a
// direct assignment are the two ways a path narrowing dies, and the message says which.
export function pathInvalidatedErr(p: i32, byIx: i32, at: i32) {
  const key = placeText(p)
  const by = nodeAt(byIx)
  let what = "the assignment"
  let after = "the assignment"
  if crAliasWr[byIx] ?? false {
    what = crCallDesc(byIx, false)
  } else if by is Call || (crOpCall[byIx] ?? false) {
    what = crCallDesc(byIx, false)
    after = "the call"
  }
  // A write that stored a non-null value narrows too (D1848), and is not a guard.
  let cause = "a guard"
  const slot = narrowedPathIx(p)
  if slot >= 0 && slot < npAsg.length {
    if npAsg[slot] == 1 { cause = "a write of a non-null value" }
  }
  // A field entry of a narrowed name is the compiler's, not the user's: name the binding.
  let shown = key
  if slot >= 0 {
    const fitName = narFitNameOf(slot)
    if fitName != "" { shown = fitName }
  }
  tErr(
    "'"
      + shown
      + "' was narrowed by "
      + cause
      + ", but "
      + what
      + " on line "
      + i32ToStr(nodeLineOf(byIx))
      + " can write it — re-test '"
      + shown
      + "' after "
      + after,
    at,
  )
  TY_ERR
}

// The `_` arm's fact over a literal-union `match`: the scrutinee `scrut` holds what is left once
// the earlier arms' members `removed` are taken out, as the `else` of `==` does (D5284).
export function matchRestNarrows(
  scrut: i32,
  removed: i32[],
  places: i32[],
  tys: i32[],
) {
  if removed.length == 0 { return 0 }
  const place = asgTestedPlace(scrut)
  if place < 0 || placeHasOptionalHop(place) { return 0 }
  let cur = placeCurTy(place, places, tys)
  for r in removed {
    if cur < 0 { return 0 }
    cur = subtractTy(cur, r)
  }
  pushNarrowFact(place, cur, places, tys)
}

// A place's current type during fact collection: facts already collected into `places`/`tys`
// (innermost-last wins) override the path overlay, which overrides the scope or field lookup, so
// successive narrowings compose. Read-only — collection must never raise a diagnostic. Parens peel
// here too (D352), in the tail's own arm, or `(t).v` would key `t.v`, find no fact and answer -1.
function placeCurTy(ix: i32, places: i32[], tys: i32[]) {
  const p = placeAt(ix)
  if p >= 0 {
    let i = places.length - 1
    while i >= 0 {
      if places[i] == p { return tys[i] }
      i = i - 1
    }
    const ov = narrowedPathTy(p)
    if ov >= 0 { return ov }
  }
  if ix < 0 { return -1 }
  const n = nodeAt(ix)
  match n {
    Paren => {
      return placeCurTy(n.parInner, places, tys)
    }
    Ident => {
      return identTyOf(ix, n.identName)
    }
    Member => {
      return placeFieldTy(placeCurTy(n.memObj, places, tys), n.memProp, false)
    }
    OptMember => {
      return placeFieldTy(placeCurTy(n.omObj, places, tys), n.omProp, true)
    }
    Index => {
      return placeElemTy(placeCurTy(n.idxArr, places, tys))
    }
    // Every other kind is not a place.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// The type of field `prop` read off `baseTy` for narrowing purposes (no diagnostics): an optional
// hop peels a nullable receiver and re-wraps the result nullable; the field resolves off a struct,
// or as a shared union field. -1 when unresolvable, and no narrowing is recorded then.
function placeFieldTy(baseTy: i32, prop: string, optional: boolean) {
  if baseTy < 0 { return -1 }
  const bt = tyAt(baseTy)
  let wasNullable = false
  let core = baseTy
  if bt is TyNullable {
    if !optional { return -1 }
    wasNullable = true
    core = bt.nInner
  }
  if core < 0 { return -1 }
  const ct = tyAt(core)
  let ft = -1
  if ct is TyObj {
    ft = objFieldType(ct, prop)
  } else if ct is TyUnion {
    ft = sharedUnionFieldTy(ct, prop)
  } else if ct is TyVar {
    if !wasNullable { ft = holePlaceFieldTy(core, ct, prop) }
  }
  if ft < 0 { return -1 }
  if wasNullable { return mkNullableTy(ft) }
  ft
}

// The discriminant rule: a test on a struct union's field refines the union itself, which is why a
// tag is written at all — the arms differ in it precisely so that reading it says which arm you
// have. A member survives when its own field type is still inhabitable under the fact. Four
// refusals: a `?.` hop, a member without the field, zero survivors, and all survivors.
function pushDiscrimParentFact(
  placeIx: i32,
  fieldTy: i32,
  places: i32[],
  tys: i32[],
  bankIx: i32,
  elseBank: boolean,
  mode: DiscrimMode,
) {
  if fieldTy < 0 { return 0 }
  const n = nodeAt(placeIx)
  if !(n is Member) { return 0 }
  if placeHasOptionalHop(placeIx) { return 0 }
  const recvTy = placeCurTy(n.memObj, places, tys)
  if recvTy < 0 { return 0 }
  const rt = tyAt(recvTy)
  if !(rt is TyUnion) { return 0 }
  const ms = rt.uMembers
  const kept: i32[] = []
  let i = 0
  while i < ms.length {
    if ms[i] < 0 { return 0 }
    const m = tyAt(ms[i])
    if !(m is TyObj) { return 0 }
    const ft = objFieldType(m, n.memProp)
    if ft < 0 { return 0 }
    if mode == "exclude" {
      // The complement of an equality: `s.kind == "circle"` being false rules out exactly the arms
      // whose tag can only be `"circle"` — `assignable(ft, fact)` says every value of that field is
      // the literal. An arm whose tag is a wider set survives, since it can hold something else.
      // That asymmetry is why this is not the intersect test negated.
      if !assignable(ft, fieldTy) { kept.push(ms[i]) }
    } else if assignable(fieldTy, ft) || assignable(ft, fieldTy) {
      kept.push(ms[i])
    }
    i = i + 1
  }
  if kept.length == 0 { return 0 }
  if kept.length == ms.length { return 0 }
  let res = kept[0]
  if kept.length > 1 { res = mkUnionTy(kept) }
  // Bank the answer for the emitter's narrowing stack (`isParentTyIxOf` / `isParentElseTyIxOf`),
  // which cannot re-derive it from the tested spelling. Guarded on the node being in range: an
  // emitter-synthesized `is` falls past the end and reads -1, which is the "push nothing" answer.
  if bankIx >= 0 {
    if elseBank {
      if bankIx < isTyColCap {
        while isParentElseTyIx.length <= bankIx { isParentElseTyIx.push(-1) }
        isParentElseTyIx[bankIx] = res
      }
    } else if bankIx < isTyColCap {
      while isParentTyIx.length <= bankIx { isParentTyIx.push(-1) }
      isParentTyIx[bankIx] = res
    }
  }
  pushNarrowFact(n.memObj, res, places, tys)
}

// For a guard on an optional chain (`x?.y is T`), the truthy branch also implies every `?.`
// receiver is non-null — push those facts innermost-first, each resolving against an
// already-narrowed receiver, so the body's regular `x.y` reads resolve. Then branch only.
function pushOptChainThenFacts(placeIx: i32, places: i32[], tys: i32[]) {
  const n = nodeAt(placeIx)
  match n {
    Member => {
      pushOptChainThenFacts(n.memObj, places, tys)
      return 0
    }
    OptMember => {
      pushOptChainThenFacts(n.omObj, places, tys)
      const cur = placeCurTy(n.omObj, places, tys)
      const inner = nonNullNarrowTy(cur)
      if inner >= 0 && inner != cur {
        pushNarrowFact(n.omObj, inner, places, tys)
      }
      return 0
    }
    // Every other kind is the chain's root, which carries no hop to narrow.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  0
}

// `x == L` over a literal union narrows `x` as `x is L` does (Q10): to the literal where the test
// holds, to the union less the literal where it fails. `holds` names the side being collected.
function pushLitEqFact(condIx: i32, holds: boolean, places: i32[], tys: i32[]) {
  const lp = litCmpPlace(condIx)
  if lp < 0 { return 0 }
  const lit = litCmpTy(condIx)
  if lit < 0 { return 0 }
  // The tested literal, banked as an `is` node banks its type: the emitter narrows a boxed
  // receiver through the same `is` channel, keyed on this comparison node.
  if pushLitEqFactAt(asgTestedPlace(lp), lit, holds, places, tys) {
    recordClonedIsVarTyIx(condIx, lit)
  }
  0
}

// The fact `place == lit` gives on side `holds`; false when it gives none. A union narrows when
// every member is a literal, or when `lit` is a member no other member admits, with or without
// a `null` beside them (D5890); a plain `string` or `i32` stays as is.
function pushLitEqFactAt(
  place: i32,
  lit: i32,
  holds: boolean,
  places: i32[],
  tys: i32[],
): boolean {
  if place < 0 || lit < 0 { return false }
  if !holds && placeHasOptionalHop(place) { return false }
  const cur = placeCurTy(place, places, tys)
  if cur < 0 { return false }
  let base = cur
  const ct = tyAt(cur)
  if ct is TyNullable { base = ct.nInner }
  if !allLitMembers(base) && !litSoleHolderIn(base, lit) { return false }
  if isWideLitJoin(base) { return false }
  if holds {
    const meet = litSetMeetTy(cur, lit)
    if meet >= 0 {
      pushNarrowFact(place, meet, places, tys)
    } else if meet == -1 && assignable(lit, base) {
      pushNarrowFact(place, lit, places, tys)
    }
    return true
  }
  pushNarrowFact(place, subtractTy(cur, lit), places, tys)
  true
}

// The fact a `match` value pattern `lit` gives its scrutinee `scrut` on side `holds`: the one
// its desugared `scrut == lit` collects, gathered before that compare exists.
export function matchValPatFact(
  scrut: i32,
  lit: i32,
  holds: boolean,
  places: i32[],
  tys: i32[],
) {
  pushLitEqFactAt(asgTestedPlace(scrut), lit, holds, places, tys)
  0
}

// Whether the literal `lit` is a member of the union `u` that no other member admits, so a
// value equal to it is that member: `"a"` in `"a" | i32`, but not in `"a" | string`.
function litSoleHolderIn(u: i32, lit: i32): boolean {
  if !(tyAt(lit) is TyLit) { return false }
  const ut = tyAt(u)
  const rl = litRegularTy(lit)
  let found = false
  if ut is TyUnion {
    for m in ut.uMembers {
      if litRegularTy(m) == rl { found = true }
      else if !isNullTy(m) && assignable(lit, m) { return false }
    }
  }
  found
}

// Collect the narrowings that hold when `cond` is true into the parallel `places`/`tys` arrays,
// keyed by place path: `x != null` strips x's null, `x is T` pins x to T (`is null` pins to the
// null type), `a && b` contributes both conjuncts, `!(e)` contributes e's false narrowings, and
// parens recurse. A guard over an optional chain also narrows each `?.` receiver non-null.
export function collectThenNarrows(condIx: i32, places: i32[], tys: i32[]) {
  const mark = places.length
  collectThenNarrowsRaw(condIx, places, tys)
  crFilterCond(condIx, places, tys, mark)
}

function collectThenNarrowsRaw(condIx: i32, places: i32[], tys: i32[]) {
  const cond = nodeAt(condIx)
  match cond {
    Paren => {
      return collectThenNarrows(cond.parInner, places, tys)
    }
    Unary => {
      if cond.unOp == "!" { return collectElseNarrows(cond.unArg, places, tys) }
      return 0
    }
    IsExpr => {
      const isPl = asgTestedPlace(cond.isObj)
      pushOptChainThenFacts(cond.isObj, places, tys)
      if cond.isVariant == "null" {
        pushNarrowFact(isPl, TY_NULL, places, tys)
      } else {
        let tIdx = isTypeTyRead(cond.isVariant, condIx)
        // An overlapping literal set narrows to the overlap, as `checkIsExprNode` tests it.
        const isCur = placeCurTy(isPl, places, tys)
        let meet = litSetMeetTy(isCur, tIdx)
        if meet < 0 { meet = recFitMeetTy(isCur, tIdx) }
        if meet >= 0 { tIdx = meet }
        // A value that passed may be laid out as another arm (D4056): only `null` leaves.
        if (
          tIdx >= 0
          && (recIsFitsAcrossTags(isCur, tIdx) || listIsFitsAcrossReps(isCur, tIdx))
        ) {
          const nn = nonNullNarrowTy(isCur)
          if nn >= 0 && nn != isCur { pushNarrowFact(isPl, nn, places, tys) }
          // A list that keeps its storage still narrows its element reads (ruling (c), D4928).
          if (
            listIsFitsAcrossReps(isCur, tIdx)
            && recFitNarrowKeepsRep(isCur, tIdx)
          ) {
            pushElemReadFact(isPl, isCur, tIdx, places, tys)
          }
        } else if tIdx >= 0 && listNarrowsElemsOnly(isCur, tIdx) {
          // A list keeps its declared type and narrows its element reads (ruling (c), D4945).
          const nn = nonNullNarrowTy(isCur)
          if nn >= 0 && nn != isCur { pushNarrowFact(isPl, nn, places, tys) }
          pushElemReadFact(isPl, isCur, tIdx, places, tys)
        } else if (
          tIdx >= 0
          && recFitNarrowKeepsRep(isCur, tIdx)
          && listFitNarrowKeepsRep(isCur, tIdx)
        ) {
          pushNarrowFact(isPl, tIdx, places, tys)
          pushDiscrimParentFact(
            isPl,
            tIdx,
            places,
            tys,
            condIx,
            false,
            "intersect",
          )
        } else if tIdx >= 0 && recFitNarrowKeepsRep(isCur, tIdx) {
          pushElemReadFact(isPl, isCur, tIdx, places, tys)
        }
      }
      return 0
    }
    BinExpr => {
      if cond.binOp == "&&" {
        const lmark = places.length
        collectThenNarrows(cond.binLeft, places, tys)
        crFilterRhsRetired(condIx, places, tys, lmark)
        collectThenNarrows(cond.binRight, places, tys)
        return 0
      }
      if cond.binOp == "!=" {
        const placeIx = asgTestedPlace(nullCmpPlace(condIx))
        if placeIx >= 0 {
          pushOptChainThenFacts(placeIx, places, tys)
          const cur = placeCurTy(placeIx, places, tys)
          const inner = nonNullNarrowTy(cur)
          if inner >= 0 && inner != cur {
            pushNarrowFact(placeIx, inner, places, tys)
          }
        }
        pushLitEqFact(condIx, false, places, tys)
      }
      // `s.kind == "circle"` — the discriminant in the spelling a user reaches for without
      // declaring a tag alias first, since `is KC` needs a name to test against. Only the parent is
      // narrowed, not the tested field: pinning `s.kind` to a bare `TyLit` would put a literal type
      // where the field's own rep — an interned atom, or a plain string — is what consumers read.
      if cond.binOp == "==" {
        const eqPlace = litCmpPlace(condIx)
        if eqPlace >= 0 {
          const eqTy = litCmpTy(condIx)
          if eqTy >= 0 {
            pushDiscrimParentFact(
              eqPlace,
              eqTy,
              places,
              tys,
              condIx,
              false,
              "intersect",
            )
          }
        }
        pushLitEqFact(condIx, true, places, tys)
      }
      return 0
    }
    // Inferred type-guard call: `if present(v)` narrows `v` the way the guard's body narrows its
    // parameter — non-null here when the guard's non-null branch is the then arm.
    Call => {
      const gArg = guardCallPlace(cond, 1)
      if gArg >= 0 {
        pushOptChainThenFacts(gArg, places, tys)
        const gCur = placeCurTy(gArg, places, tys)
        const gInner = nonNullNarrowTy(gCur)
        if gInner >= 0 && gInner != gCur {
          pushNarrowFact(gArg, gInner, places, tys)
        }
      }
      return 0
    }
    // Every other kind narrows nothing.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Member | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  0
}

// `subtractTy` for an `is` test's else arm. A concrete tested type stays apart from a type
// parameter's list, as in a return set: the else of `is i32[]` over `T[] | i32[]` is `T[]`, the
// arm each instance's emitter reads there. The else of `is T[]` reads as the whole union here and
// as the remainder at each pin (`mkTvElseRemTy`), where the two lists are apart or one.
function elseRemainderTy(cur: i32, tIdx: i32): i32 {
  const open = tyHasTyVar(tIdx)
  if open {
    const sub = subtractTy(cur, tIdx)
    if sub >= 0 { return sub }
  }
  const saved = tpApartConcrete
  tpApartConcreteSet(true)
  const sub = subtractTy(cur, tIdx)
  tpApartConcreteSet(saved)
  if !open { return sub }
  if sub < 0 { return -1 }
  mkTvElseRemTy(cur, tIdx)
}

// Collect the narrowings that hold when `cond` is false: `x == null` strips the null in the else
// branch, `x is null` false means non-null, `x is T` false leaves the union complement `U − T`,
// `a || b` contributes both disjuncts (neither held), `!(e)` contributes e's true narrowings, and
// parens recurse. A place behind a `?.` hop is never else-narrowed, the chain being possibly null.
export function collectElseNarrows(condIx: i32, places: i32[], tys: i32[]) {
  const mark = places.length
  collectElseNarrowsRaw(condIx, places, tys)
  crFilterCond(condIx, places, tys, mark)
}

function collectElseNarrowsRaw(condIx: i32, places: i32[], tys: i32[]) {
  const cond = nodeAt(condIx)
  match cond {
    Paren => {
      return collectElseNarrows(cond.parInner, places, tys)
    }
    Unary => {
      if cond.unOp == "!" { return collectThenNarrows(cond.unArg, places, tys) }
      return 0
    }
    IsExpr => {
      const isPl = asgTestedPlace(cond.isObj)
      if placeHasOptionalHop(cond.isObj) { return 0 }
      const cur = placeCurTy(isPl, places, tys)
      if cond.isVariant == "null" {
        // The null face of the same hole (D1243), now the shared reader's — see its header.
        const inner = nonNullNarrowTy(cur)
        if inner >= 0 && (inner != cur || narPathHeldNonNull(isPl, inner)) {
          pushNarrowFact(isPl, inner, places, tys)
        }
      } else {
        const tIdx = isTypeTyRead(cond.isVariant, condIx)
        if tIdx >= 0 {
          let sub = elseRemainderTy(cur, tIdx)
          // A hole has no member list to subtract from, so the remainder is deferred to the pin
          // rather than lost. Without it the `else` arm of `if a is string` over an un-annotated
          // parameter reads `a` at the full pinned union and `a * 2` refuses a program whose
          // annotated twin runs (D1243). `holeElseRemainderOk` says which types it may mint for.
          if sub < 0 && holeElseRemainderOk(tIdx) {
            sub = mkDerivedHole(HD_GNOT, "", -1, tIdx, cur)
          }
          // On a hole's field, a shape `T` leaves the hole itself as the arm's fact, so a write
          // or call that ends the remainder the instance narrows to re-asks the reads after it
          // at the pin (D3420). A bare name keeps no fact, so it reads at its demand.
          const hk = placeKeyOf(isPl)
          if sub < 0 && tyIsHole(cur) && hk != "" && isPathKey(hk) {
            holeElseTestedSetAt(hk + "|" + i32ToStr(cur), tIdx)
            pushNarrowFact(isPl, cur, places, tys)
            return 0
          }
          pushNarrowFact(isPl, sub, places, tys)
          // The complement, banked into the else table. `setNarrowFromCondElse` declines to
          // else-narrow a struct union, so a checker-only complement would type `else { s.w }` clean
          // for an emitter still seeing the full union — trading an accurate `field 'w' is not on
          // every member` for an obscure emit reject. Both layers carry it, so they agree.
          pushDiscrimParentFact(
            isPl,
            sub,
            places,
            tys,
            condIx,
            true,
            "intersect",
          )
        }
      }
      return 0
    }
    BinExpr => {
      if cond.binOp == "||" {
        const lmark = places.length
        collectElseNarrows(cond.binLeft, places, tys)
        crFilterRhsRetired(condIx, places, tys, lmark)
        collectElseNarrows(cond.binRight, places, tys)
        return 0
      }
      if cond.binOp == "==" {
        const placeIx = asgTestedPlace(nullCmpPlace(condIx))
        if placeIx >= 0 {
          if !placeHasOptionalHop(placeIx) {
            const cur = placeCurTy(placeIx, places, tys)
            const inner = nonNullNarrowTy(cur)
            if (
              inner >= 0
              && (inner != cur || narPathHeldNonNull(placeIx, inner))
            ) {
              pushNarrowFact(placeIx, inner, places, tys)
            }
          }
        }
        // `if s.kind == "circle" { … } else { … }` — the else arm of the discriminant. The test
        // being false rules out exactly the arms whose tag can only be that literal, so the fact is
        // the literal and the mode is `"exclude"`; see its header for why that is not the positive
        // test negated.
        const eqPlace = litCmpPlace(condIx)
        if eqPlace >= 0 {
          const eqTy = litCmpTy(condIx)
          if eqTy >= 0 {
            pushDiscrimParentFact(
              eqPlace,
              eqTy,
              places,
              tys,
              condIx,
              true,
              "exclude",
            )
          }
        }
        pushLitEqFact(condIx, false, places, tys)
      }
      if cond.binOp == "!=" { pushLitEqFact(condIx, true, places, tys) }
      return 0
    }
    // Inferred type-guard call: `if absent(p) { … } else { /* p != null */ }` — non-null in the else
    // branch when the guard's non-null branch is the else.
    Call => {
      const gArg = guardCallPlace(cond, 0)
      if gArg >= 0 {
        if !placeHasOptionalHop(gArg) {
          const gCur = placeCurTy(gArg, places, tys)
          const gInner = nonNullNarrowTy(gCur)
          if gInner >= 0 && gInner != gCur {
            pushNarrowFact(gArg, gInner, places, tys)
          }
        }
      }
      return 0
    }
    // Every other kind narrows nothing.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Member | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  0
}

// Apply collected narrowings around a branch: a bare name shadows through the scope chain (the
// caller pushes a scope first), a property path rides the `npKeys`/`npTys` overlay, whose entries
// the matching `popScope` unwinds. A bare name's shadow carries its declared type across, banked
// for `writeStorageTy`, and its constness, without which the `const` reject vanishes in a guard.
export function applyNarrows(places: i32[], tys: i32[]) {
  let i = 0
  while i < places.length {
    const p = places[i]
    if placeIsPath(p) {
      npKeysPush(p)
      npTysPush(tys[i])
      npInvByPush(-1)
      npEpochsPush(narFnEpoch)
      npSettlePush(-2)
      npCapByPush(-1)
      npAsgPush(0)
    } else {
      const s = placeDecl(p)
      const declTy = declTyOf(s)
      if declTy >= 0 && declTy != tys[i] {
        noteNarShadow(s, declTy, NAR_KIND_GUARD)
      }
      declareSlot(s, tys[i])
      if declTy >= 0 && declTy != tys[i] { narFitCompanions(p, declTy, tys[i]) }
    }
    i = i + 1
  }
  0
}

// Leave the innermost scope, unwinding what it pushed.
export function popScope() {
  flushUninferred(T.frames.length - 1)
  while (
    crWideDepths.length > 0
    && crWideDepths[crWideDepths.length - 1] >= T.frames.length - 1
  ) {
    crWideDepths.pop()
    crWideNames.pop()
    crWideSlots.pop()
  }
  crPopSoleTo(T.frames.length - 1)
  if narWrSlots.length > 0 || narWrPaths.length > 0 {
    narWrPopTo(T.frames.length - 1)
  }
  scopeFramePop()
  // The collapsed-binding marks go with the frame their bindings did (D1048). One length test
  // when the list is empty, which is nearly every program.
  collBindPopTo(T.frames.length)
  if npFrames.length > 0 {
    const base = npFrames[npFrames.length - 1]
    npFramesPop()
    while npKeys.length > base {
      npKeysPop()
      npTysPop()
      npInvByPop()
      npEpochsPop()
      npSettlePop()
      npCapByPop()
      npAsgPop()
    }
    while nfSlots.length > 0 && nfSlots[nfSlots.length - 1] >= npKeys.length {
      nfSlotsPop()
      nfNamesPop()
    }
  }
  narBankPopFrame()
  symScopePop()
}

// The root binding of the narrowed place `ix` reads, noted as a use, and the place's types
// recorded: an overlay hit returns before the receiver is checked.
export function identNotePlace(ix: i32) {
  placeRecvTysNote(ix)
  0
}

// Each projection of the place `ix`, recorded at the type the read-only place walk gives it,
// which is the type a check of that node would record.
function placeRecvTysNote(ix: i32) {
  if inferQuiet || ix < 0 || ix >= nodeTyIx.length { return 0 }
  const n = nodeAt(ix)
  if n is Member { return placeRecvTyStep(ix, n.memObj) }
  if n is OptMember { return placeRecvTyStep(ix, n.omObj) }
  if n is Index {
    // The literal subscript is checked as any literal is, so it carries its width too.
    checkNodeHook(n.idxIndex)
    return placeRecvTyStep(ix, n.idxArr)
  }
  if n is Paren { return placeRecvTyStep(ix, n.parInner) }
  // The root `Ident`; any other node is no place, and the walk gives it no type.
  placeTyNote(ix)
}

// `placeRecvTysNote` at the projection `ix`, then at its receiver `recv`.
function placeRecvTyStep(ix: i32, recv: i32) {
  placeTyNote(ix)
  placeRecvTysNote(recv)
}

// Records at `ix` the type the place walk reads there, when it reads one.
function placeTyNote(ix: i32) {
  const noPlaces: i32[] = []
  const noTys: i32[] = []
  const t = placeCurTy(ix, noPlaces, noTys)
  if t >= 0 { nodeTySet(ix, widenLitTy(t)) }
  if t >= 0 { noteNarrowedRead(ix, t) }
  0
}

// The one writer of `narrowedFromTyIx`: at the read `ix`, typed `ty`, the storage type its binding,
// field or cell holds when a narrowing gave the read another type. An instance's re-check records it
// for that instance instead. A path read is narrowed only under a live path narrowing.
export function noteNarrowedRead(ix: i32, ty: i32) {
  const n = nodeAt(ix)
  let st = -1
  if n is Ident { st = identStoreTyOf(ix, n.identName) }
  else if npKeys.length > 0 { st = placeStoreTy(ix) }
  if elabCapLive() { return elabCapNarrowNote(ix, ty, st) }
  narrowedFromTySet(ix, ty, st)
}

// ── the node-anchored findings' span ─────────────────────────────────────────
// A multi-module compile merges every module's AST, so `modOfTok` resolves which file a finding
// is in; the CLI keeps only the entry module's (`redunModuleAt`).

// Whether an accepted assignment of right side `rhs`, a `rt` value, into a place of type
// `placeTy` yields the place's type: the two are one type in another spelling (a union's member
// order), or `rhs` is a literal built at the place's type because a `rt` value could reach the
// place only through an adapter. Leaves the diagnostic's claimed pair as found.
export function asgYieldsPlaceTy(rhs: i32, rt: i32, placeTy: i32): boolean {
  if rt < 0 || placeTy < 0 || rt == placeTy { return false }
  if tyHasHole(rt) || tyHasHole(placeTy) { return false }
  if tyAt(rt) is TyErr || tyAt(placeTy) is TyErr { return false }
  if assignable(rt, placeTy) && assignable(placeTy, rt) { return true }
  if !asgRhsBuiltAtPlace(rhs) { return false }
  const sT = shapeAdaptSrcTy
  const dT = shapeAdaptDstTy
  const sX = shapeAdaptSrcExpr
  const eP = shapeAdaptElemPair
  const wF = shapeAdaptWidthField
  const nC = shapeAdaptNulCopy
  const nN = shapeAdaptNestedCopy
  const mS = shapeAdaptMapShared
  const rF = shapeAdaptRecField
  const rS = shapeAdaptRecStorage
  const rN = shapeAdaptRecStorageField
  const r = objShapeAdapterlessAt(-1, rt, placeTy)
  shapeAdaptRecStorageSet(rS)
  shapeAdaptRecStorageFieldSet(rN)
  shapeAdaptSrcTySet(sT)
  shapeAdaptDstTySet(dT)
  shapeAdaptSrcExprSet(sX)
  shapeAdaptElemPairSet(eP)
  shapeAdaptWidthFieldSet(wF)
  shapeAdaptNulCopySet(nC)
  shapeAdaptNestedCopySet(nN)
  shapeAdaptMapSharedSet(mS)
  shapeAdaptRecFieldSet(rF)
  r
}

// A call's explicit type arguments are legal on `Map`/`Set` and on a direct call of a
// declared generic function. Anything else is reported here, with its arguments still
// checked, and the call types as an error so nothing cascades from it.
export function callTyArgsCalleeOk(cfn: Node, cfnIx: i32, ix: i32): boolean {
  if cfn is Ident {
    const nm = cfn.identName
    if (nm == "Map" || nm == "Set") && identDepthOf(cfnIx, nm) < 0 {
      return true
    }
    if (
      arrayCtorNote(nm) != ""
      && identDepthOf(cfnIx, nm) < 0
      && identFnDeclOf(cfnIx) < 0
    ) {
      tErr("explicit type arguments on `Array`" + arrayCtorNote(nm), ix)
      return false
    }
    const dIx = identFnDeclOf(cfnIx)
    if dIx >= 0 {
      const d = nodeAt(dIx)
      if d is FuncDecl {
        if d.fnTyParams.length > 0 { return true }
        tErr(
          "`"
            + nm
            + "` is not generic, so it takes no type arguments — drop the `<…>`"
            + TY_ARG_READ_HINT,
          ix,
        )
        return false
      }
    }
  }
  tErr(
    "explicit type arguments need a direct call of a declared generic function, or `Map<K, V>()` / `Set<T>()`"
      + TY_ARG_READ_HINT,
    ix,
  )
  false
}

// Rewinds the inferred return to `obsMark`, the value it had at log row `logMark`, and re-joins
// only the non-seed rows since: the `return`s stay, every tail-arm value below the mark leaves.
export function dropTailIfSeeds(logMark: i32, obsMark: i32, obsLit: boolean) {
  if logMark > inferRetLogTy.length { return 0 }
  const keepTy: i32[] = []
  const keepLit: boolean[] = []
  let i = logMark
  while i < inferRetLogTy.length {
    if inferRetLogSeed[i] {
      inferDroppedTy.push(inferRetLogTy[i])
      inferDroppedLit.push(inferRetLogLit[i])
    } else {
      keepTy.push(inferRetLogTy[i])
      keepLit.push(inferRetLogLit[i])
    }
    i = i + 1
  }
  while inferRetLogTy.length > logMark {
    inferRetLogTy.pop()
    inferRetLogSeed.pop()
    inferRetLogLit.pop()
  }
  inferObservedSet(obsMark)
  inferObservedLitSet(obsLit)
  let k = 0
  while k < keepTy.length {
    inferRetLogTy.push(keepTy[k])
    inferRetLogSeed.push(false)
    inferRetLogLit.push(keepLit[k])
    inferRetJoin(keepTy[k], keepLit[k])
    k = k + 1
  }
  0
}

// Mark the last arm's condition when reaching it PROVES the test: every member no EARLIER arm
// covers must be covered by this arm, and there must be at least one such member (an arm the
// earlier ones already cover is unreachable, not provably true, and is left alone).
function markChainLastArmProven(ifIx: i32, members: i32[], testedTys: i32[]) {
  const last = chainLastArmOf(ifIx)
  if last < 0 { return 0 }
  if testedTys.length < 2 { return 0 }
  const lastTy = testedTys[testedTys.length - 1]
  let residue = 0
  let mi = 0
  while mi < members.length {
    let earlier = false
    let ti = 0
    while ti < testedTys.length - 1 {
      if assignable(members[mi], testedTys[ti]) { earlier = true }
      ti = ti + 1
    }
    if !earlier {
      if !assignable(members[mi], lastTy) { return 0 }
      residue = residue + 1
    }
    mi = mi + 1
  }
  if residue == 0 { return 0 }
  const ln = nodeAt(last)
  if ln is IfStmt {
    const cix = condUnderParens(ln.ifCond)
    if cix < 0 { return 0 }
    const cnd = nodeAt(cix)
    // Only an `is` test is elided: the proof is about member coverage, and a literal `==`
    // arm's operand may be any expression the emitter must still evaluate.
    if cnd is IsExpr {
      if !condProvenTrue(ln.ifCond) { chainProvenCond.push(ln.ifCond) }
    }
  }
  0
}

// Soundness: does the else-less `is`-chain rooted at `ifIx` cover every variant of `p`'s
// union type? If so, fall-through is unreachable and needs no `else`; if not, a value falls
// off the end. Decided over the discriminated place's declared union members, requiring every
// arm test the same place — any arm that is not a bare `place is T` makes it non-exhaustive, never wrongly exhaustive.
export function ifChainExhausts(ifIx: i32) {
  chainMissingSet("")
  let havePlace = false
  let placeName = "?"
  let placeIx = -1
  const testedTys: i32[] = []
  // `allIsArms` stays true only while every arm seen is a bare `<sameIdent> is T`
  // (the only shape we can prove exhaustive by union-member coverage).
  let allIsArms = true
  let node = nodeAt(ifIx)
  let walking = true
  while walking {
    if node is IfStmt {
      // Classify this arm's condition. Only a single `<ident> is T` (not null)
      // contributes to coverage; anything else makes the chain non-coverable.
      // A parenthesized arm (`else if (p is B)`) classifies like the bare one.
      const condIx = condUnderParens(node.ifCond)
      if condIx < 0 { return false }
      const cond = nodeAt(condIx)
      if cond is IsExpr {
        if cond.isVariant == "null" {
          allIsArms = false
        } else {
          const obj = nodeAt(cond.isObj)
          if obj is Ident {
            if !havePlace {
              placeName = obj.identName
              placeIx = cond.isObj
              havePlace = true
            } else if placeName != obj.identName {
              allIsArms = false
            }
            const tIx = isTypeTyRead(cond.isVariant, condIx)
            if tIx < 0 { allIsArms = false } else { testedTys.push(tIx) }
          } else {
            allIsArms = false
          }
        }
      } else if cond is BinExpr {
        // A literal-equality arm `place == <lit>` discriminates a literal
        // union the same way an `is` arm does (host: literal narrowing via
        // `atomFact` + `subtractType`) — contribute the tested literal type.
        let litArm = -1
        let armObj = -1
        if cond.binOp == "==" {
          litArm = cmpLitTyOf(cond.binRight)
          armObj = cond.binLeft
          if litArm < 0 {
            litArm = cmpLitTyOf(cond.binLeft)
            armObj = cond.binRight
          }
        }
        if litArm >= 0 {
          const eobj = nodeAt(armObj)
          if eobj is Ident {
            if !havePlace {
              placeName = eobj.identName
              placeIx = armObj
              havePlace = true
            } else if placeName != eobj.identName {
              allIsArms = false
            }
            testedTys.push(litArm)
          } else {
            allIsArms = false
          }
        } else {
          allIsArms = false
        }
      } else {
        allIsArms = false
      }
      if node.ifElse < 0 {
        // No `else`: the chain ends here — decide by coverage below.
        walking = false
      } else {
        const nxt = nodeAt(node.ifElse)
        if nxt is IfStmt {
          node = nxt
        } else {
          // A real (block) `else` covers the fall-through outright — exhaustive
          // regardless of the arm shapes.
          return true
        }
      }
    } else {
      return false
    }
  }
  // No `else`. Only a pure `is`-chain over one place can be exhaustive by member
  // coverage; any other shape genuinely falls through.
  if !allIsArms { return false }
  // No place is discriminated (shouldn't happen) — not exhaustive.
  if !havePlace { return false }
  // Uses the pre-subtraction type first (`pgPreIx`): this chain's own post-guard narrowing
  // has already replaced the place's binding with the residue of the arms being counted, so
  // the binding alone would report "covered" for every chain whose arms actually diverge. The
  // bank is keyed by this chain's node, so it answers only when this chain did the subtracting; the binding is the fallback otherwise.
  let pty = -1
  if pgPreIx == ifIx {
    let pk = 0
    while pk < pgPreKeys.length {
      if placeText(pgPreKeys[pk]) == placeName { pty = pgPreTys[pk] }
      pk = pk + 1
    }
  }
  if pty < 0 { pty = identTyOf(placeIx, placeName) }
  if pty < 0 { return false }
  const pt = tyAt(pty)
  match pt {
    TyNullable => {
      // A nullable place needs an explicit `is null` (or `else`) arm to be covered;
      // an else-less `is`-chain over the inner variants always leaves the null path.
      return false
    }
    TyUnion => {
      // Cover each union member against the tested set; collect the uncovered
      // ones (rendered) so the diagnostic can name exactly what is missing.
      const members = pt.uMembers
      let mi = 0
      let allCovered = true
      while mi < members.length {
        let covered = false
        let ti = 0
        while ti < testedTys.length {
          if assignable(members[mi], testedTys[ti]) { covered = true }
          ti = ti + 1
        }
        if !covered {
          allCovered = false
          if chainMissing != "" { chainMissingSet(chainMissing + ", ") }
          chainMissingSet(chainMissing + tyToStr(members[mi]))
        }
        mi = mi + 1
      }
      if allCovered { markChainLastArmProven(ifIx, members, testedTys) }
      return allCovered
    }
    // Every other type is a non-union place, which the tail below treats as covered.
    TyPrim | TyErr | TyObj | TyFunc | TyArray | TyMap | TyVar | TyLit | TyNeg => {}
  }
  // A non-union place: an `is`-chain over it is degenerate; treat as covered
  // (a single concrete type is "exhausted" by any always-true branch).
  true
}

// Marks the union members that arm pattern type `pt` covers, in the `covered` flag column
// parallel to `uMems`. Returns 1 when it covered at least one new member, -1 when every member
// it names is already covered (a redundant arm), 0 when it names no member at all. Coverage is
// decided by arena type (`sameVariantTy`), so two structurally-identical declared types are one member.
export function markUnionCover(uMems: i32[], covered: i32[], pt: i32) {
  let found = 0
  let fresh = 0
  let j = 0
  while j < uMems.length {
    if sameVariantTy(uMems[j], pt) {
      found = found + 1
      if covered[j] == 0 {
        covered[j] = 1
        fresh = fresh + 1
      }
    }
    j = j + 1
  }
  if found == 0 { return 0 }
  if fresh == 0 { return -1 }
  1
}

// The type of a getter read `v.prop` at member node `ix`, banking the site for the rewrite
// into a call. A write through a getter, or a read of a getter another module did not export,
// is refused here and banks nothing.
export function getterReadTy(fn: string, n: Member, ix: i32) {
  if ix == getWriteTarget {
    tErr(
      "cannot assign to `."
        + n.memProp
        + "`: it reads the "
        + getDeclLabel(fn)
        + ", and a getter is read-only",
      ix,
    )
    return TY_ERR
  }
  const gi = getRowOf(fn)
  if gi < 0 { return TY_ERR }
  if !getterVisibleAt(gi, ix) {
    tErr(
      "the "
        + getDeclLabel(fn)
        + " is not exported by the module that declares it — write `export get "
        + n.memProp
        + "` there",
      ix,
    )
    return TY_ERR
  }
  getSiteBank(ix, fn)
  const fnTy = moduleNameTyOf(fn)
  if fnTy < 0 { return TY_ERR }
  const ft = tyAt(fnTy)
  if ft is TyFunc {
    if ft.fnRet < 0 { return TY_ERR }
    if symEnabled != 0 {
      symMemGetter.push(ix)
      symMemGetterDecl.push(getDecls[gi])
    }
    return symMem(ix, ft.fnRet)
  }
  TY_ERR
}

// ── the getter declaration and body contract (§D3a-contract) ──────────────────

// ── the per-function summary (function-effects-design.md §C1, D2135) ─────────

// ── the getter step budget (§D3a-contract, D2061) ────────────────────────────

// ── the summary in words (hover, the dump) ───────────────────────────────────

// ── a union of lists (D2874) ────────────────────────────────────────────────
// `.length`, `u[i]` and `for v in u` over a union whose every member is a list. The real pass
// rewrites each site in place into an `is` chain over a `const` holding the receiver, so it
// lowers as the narrowed spelling does; a quiet pass may see a partial union and only types it.

// The element a read `xs[i]…[j]` holds under an element-only narrowing of `xs` (a name, a field
// path or a literal subscript, `pushElemReadFact`), or -1. A store through the place is typed as
// declared and ends it.
export function elemEveryReadTy(ix: i32): i32 {
  if luWriteTgt[ix] ?? false { return -1 }
  const key = elemRecvPrefix(ix)
  if !keyIsListEvery(key) { return -1 }
  const p = placeFind(placeRootSlotOf(ix), key)
  const slot = narrowedPathIx(p)
  if slot < 0 || narFitNameOf(slot) != "" { return -1 }
  const t = narrowedPathTy(p)
  if t >= 0 { crNoteCaptureRead(p) } else { crPathDropRead(key, ix) }
  t
}

// The key (`s[*]`, `m[*][*]`) of the element-only narrowing in force on the list `recvIx` names
// or of a row of it still a list (`m[0]`), as `s is S[]` over a `string[]` pushes it
// (`pushElemReadFact`), as a place, or PLACE_NONE.
export function elemOnlyKeyOf(recvIx: i32): i32 {
  const pfx = elemRecvPrefix(recvIx)
  if pfx == "" { return PLACE_NONE }
  const slot = elemEverySlotOf(elemKeyBase(pfx))
  if slot < 0 || narFitNameOf(slot) != "" { return PLACE_NONE }
  const key = npPlace[slot]
  if npKeys[slot].length <= pfx.length || narrowedPathTy(key) < 0 {
    return PLACE_NONE
  }
  crNoteCaptureRead(key)
  key
}

// The narrowing an element of `recvIx` carries into the parameter of the callback literal `cbIx`
// handed to its `map`/`filter` (`elemOnlyKeyOf`), as `elemFactFor` banks it, or false. Only a
// callback that runs in place and, asked as a loop body is, writes no element of the receiver
// out of the leaf nor calls what may, is handed elements that all still fit.
export function cbElemNarrowFor(recvIx: i32, cbIx: i32): boolean {
  const key = elemOnlyKeyOf(recvIx)
  if key < 0 { return false }
  const pfx = elemRecvPrefix(recvIx)
  const root = placeRootOf(pfx)
  const fd = nodeAt(cbIx)
  if !(fd is FuncDecl) { return false }
  const leaf = narrowedPathTy(key)
  const bound: string[] = []
  fnBoundNames(cbIx, bound)
  cbPendClear()
  cbPendAdd(cbIx, nodeTyOf(recvIx), bound)
  cbPendCollect(fd.fnBody, bound)
  const writes = (!crCallbackKeeps(
    cbIx,
    placeIntern(placeDecl(key), root, false),
    root,
  )
    || crLoopLeavingPathWrite(fd.fnBody, key, leaf) >= 0
    || crFirstElemWritingCall(fd.fnBody, key) >= 0)
  cbPendClear()
  if writes { return false }
  elemFactFor(cbIx, pfx, key)
}

// Banks, under `at`, the fact an element of the list `pfx` reads (`elemRecvPrefix`) brings to a
// fresh binding from the element place `key`: its leaf, and how many element steps it narrows.
export function elemFactFor(at: i32, pfx: string, key: i32): boolean {
  efLeaf[at] = narrowedPathTy(key)
  efSteps[at] = (placeText(key).length - pfx.length) / LIST_EVERY_STEP.length
    - 1
  true
}

// Narrow the binding `name` of slot `s`, just declared in the current scope, by the fact banked
// under `at` (`elemFactFor`): the leaf itself at no steps, as a guard would, else every element.
export function narrowFreshBinding(s: i32, name: string, at: i32) {
  const leaf = efLeaf[at] ?? -1
  const steps = efSteps[at] ?? -1
  if leaf < 0 || steps < 0 || name == "" { return 0 }
  let key = placeIntern(s, name, false)
  if key < 0 { return 0 }
  if steps == 0 {
    const decl = declTyOf(s)
    if decl < 0 || tySame(decl, leaf) || !assignable(leaf, decl) { return 0 }
    return applyNarrows([key], [leaf])
  }
  let k = 0
  while k < steps {
    key = placeWith(key, LIST_EVERY_STEP)
    k = k + 1
  }
  applyNarrows([key], [leaf])
}

// ── object literal ──────────────────────────────────────────────────────────
// `{x: e, y: e}` types as a structural `TyObj` whose fields carry each value's checked type.
// Assignability against an annotation/param/return then matches it to a declared struct by
// structure, so field order need not match the declaration.

// Joins one exit value of type `ty` at node `ix` into loop entry `k`, by the rule an `if` or a
// `match` joins its arms with (`joinArmLit`): two runtime numbers of different types join apart.
export function lpJoinArm(k: i32, ty: i32, ix: i32) {
  const lit = armLit(ty, ix)
  lpJoinSetAt(k, joinArmLit(lpJoin[k], lpLit[k], ty, lit))
  lpLitSetAt(k, lpLit[k] && lit)
  lpArmPush(k, ix, ty)
  0
}

// Pops the innermost entry, for the loop `ix`: its value type from the `break` values, the
// block tail `tailTy` (-1 for none) and `runsOut` (an exit with no value), else void.
export function lpPopResult(
  ix: i32,
  tailTy: i32,
  tailIx: i32,
  runsOut: boolean,
): i32 {
  if !lpOn { return TY_VOID }
  const top = lpLabels.length - 1
  if top < 0 { return TY_VOID }
  let t = lpJoin[top]
  const bare = lpBare[top]
  lpLabelsPop()
  if tailTy >= 0 {
    lpJoinArm(top, tailTy, tailIx)
    t = lpJoin[top]
  }
  // A destination every exit value fits types the entry, as it types an `if`'s arms.
  const arms: i32[] = []
  const armTys: i32[] = []
  lpArmsTake(top, arms, armTys)
  lpExitsSet(ix, arms)
  if t >= 0 {
    const lj = litJoinOf(ix, t, arms, armTys)
    if lj >= 0 { t = lj }
  }
  lpJoinPop()
  lpBarePop()
  lpLitPop()
  if t < 0 {
    lpValTySet(ix, -1)
    return TY_VOID
  }
  if runsOut || bare { t = joinTys(t, TY_NULL) }
  lpValTySet(ix, t)
  lpValSeenSet(true)
  let used = 1
  if valDiscarded(ix) { used = 0 }
  lpColSet(lpValUsed, ix, used)
  let tl = -1
  if tailTy >= 0 { tl = tailIx }
  lpColSet(lpValTail, ix, tl)
  // A fresh tail is stored as the block's value.
  if used == 1 && tl >= 0 { recordRepTyAdopt(tl, t, 6) }
  t
}

// The value a discarded `if` would have had: its arms' join, or `T | null` without an else.
// A join clash is a value nobody reads, so it is not reported.
export function discardedIfValTy(
  hasElse: boolean,
  thenTy: i32,
  elseTy: i32,
): i32 {
  if hasElse {
    const savedClash = joinClashMsg
    const j = joinArmTys(thenTy, elseTy)
    joinClashMsgSet(savedClash)
    return j
  }
  if thenTy != TY_VOID && thenTy != TY_ERR { return mkNullableTy(thenTy) }
  TY_VOID
}
