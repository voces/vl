// Writes under a narrowing: the places a guarded write stored into, dropped as their scope
// closes.
// Does not import the checker.
import { Ident, nodeAt } from "./ast"
import { asgDeclaredTy } from "./check_nar_bank"
import { placeKeyOf } from "./check_places"
import { lookupDepth } from "./check_scopes"

// Bare names a write under a guard stored into, with the scope depth their binding reads at:
// their storage may hold `null` again, so a null test of them is a real question, as it is for
// an assignment's narrowing. Unwound with the scope.
export let narWrNames: string[] = []
export let narWrDepths: i32[] = []

function narWrittenName(name: string): boolean {
  const d = lookupDepth(name)
  if d < 0 { return false }
  let i = narWrNames.length - 1
  while i >= 0 {
    if narWrDepths[i] == d && narWrNames[i] == name { return true }
    i = i - 1
  }
  false
}

// Whether a write under a narrowing stored into the place keyed `key` in a scope still open.
export function narWrittenPath(key: string): boolean {
  if key == "" { return false }
  let i = narWrNames.length - 1
  while i >= 0 {
    if narWrNames[i] == key { return true }
    i = i - 1
  }
  false
}

// Record that a write under a guard stored into `name` (`narWrittenName`).
export function narNoteWritten(name: string) {
  const d = lookupDepth(name)
  if d < 0 || narWrittenName(name) { return 0 }
  narWrNames.push(name)
  narWrDepths.push(d)
  0
}

// Drop the records of the scope at depth `d`, which is closing.
export function narWrPopTo(d: i32) {
  let i = 0
  let k = 0
  while i < narWrNames.length {
    if narWrDepths[i] < d {
      narWrNames[k] = narWrNames[i]
      narWrDepths[k] = narWrDepths[i]
      k = k + 1
    }
    i = i + 1
  }
  while narWrNames.length > k {
    narWrNames.pop()
    narWrDepths.pop()
  }
  0
}

// True when `ix` is a bare name that an assignment narrowed away from a declared type — a place
// whose storage can still hold null even though its current flow type cannot. The null-test
// legality question, and nothing else.
export function isAsgNarrowedName(ix: i32) {
  const n = nodeAt(ix)
  if n is Ident {
    return asgDeclaredTy(n.identName) >= 0 || narWrittenName(n.identName)
  }
  // A field or cell keys by its path; any other node keys "", which no write recorded.
  narWrittenPath(placeKeyOf(ix))
}

// Clears this module's tables (called from `initChecker`).
export function narWrittenReset() {
  narWrNames = []
  narWrDepths = []
}
