// The regions of a `let` binding: the stretches of its declaring block that a whole reassignment
// at that block's own level starts. No value written before such a statement reaches a read after
// it, so each region can hold its value at its own type. A binding a nested function reads has
// one region: the function may run on either side of the reassignment.
import {
  BinExpr,
  Block,
  FuncDecl,
  Ident,
  LetDecl,
  P,
  nodeAt,
  nodeChildren,
} from "./ast"
import { ctnRootStmts, letDeclFn } from "./check_decl_scan"
import { identDeclOf } from "./symbols"

// The `let` that statement `stmt`, at index `pos` of block statements `sibs`, starts a new
// region of: `stmt` is `x = …` for a `let x` declared earlier in `sibs` that no function in
// `sibs` or `fns` (the program's functions, for a module binding) reads. -1 otherwise.
export function regionSplitOf(
  stmt: i32,
  sibs: i32[],
  pos: i32,
  fns: i32[],
): i32 {
  if stmt < 0 || stmt >= P.nodes.length || pos < 0 || pos >= sibs.length {
    return -1
  }
  const n = nodeAt(stmt)
  if !(n is BinExpr) || n.binOp != "=" || n.binCompound != "" { return -1 }
  if (
    n.binLeft < 0
    || n.binLeft >= P.nodes.length
    || !(nodeAt(n.binLeft) is Ident)
  ) {
    return -1
  }
  const d = identDeclOf(n.binLeft)
  if d < 0 || d >= P.nodes.length { return -1 }
  const ld = nodeAt(d)
  if !(ld is LetDecl) || ld.letKw != "let" { return -1 }
  let declared = false
  let k = 0
  while k < pos {
    if sibs[k] == d { declared = true }
    k = k + 1
  }
  if !declared { return -1 }
  for s in sibs {
    if fnReadsDecl(s, d, false) { return -1 }
  }
  for f in fns {
    if fnReadsDecl(f, d, false) { return -1 }
  }
  return d
}

// Whether a function under node `ix` (or `ix` itself when `inFn`) reads declaration `d`.
function fnReadsDecl(ix: i32, d: i32, inFn: boolean): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  const f = inFn || n is FuncDecl
  if f && n is Ident && identDeclOf(ix) == d { return true }
  for c in nodeChildren(ix) {
    if fnReadsDecl(c, d, f) { return true }
  }
  return false
}

// Whether assignment `w` starts a region of the `let` it writes (`regionSplitOf`), found from
// the binding's own declaring block: a block of its function's body, or the module's statements.
// `fns` are the program's functions, read for a module binding.
export function asgStartsRegion(w: i32, fns: i32[]): boolean {
  if w < 0 || w >= P.nodes.length { return false }
  const n = nodeAt(w)
  if !(n is BinExpr) || n.binLeft < 0 || n.binLeft >= P.nodes.length {
    return false
  }
  const d = identDeclOf(n.binLeft)
  if d < 0 || d >= P.nodes.length { return false }
  const fx = letDeclFn.get(d) ?? -1
  const fd = if fx >= 0 && fx < P.nodes.length { nodeAt(fx) } else { null }
  const sibs = if fd is FuncDecl { blockHolding(fd.fnBody, d) } else { ctnRootStmts }
  let pos = -1
  let k = 0
  while k < sibs.length {
    if sibs[k] == w { pos = k }
    k = k + 1
  }
  if pos < 0 { return false }
  return regionSplitOf(w, sibs, pos, if fd is FuncDecl { [] } else { fns }) == d
}

// The statements of the block under `ix` that holds statement `s` directly; [] when none does.
function blockHolding(ix: i32, s: i32): i32[] {
  const none: i32[] = []
  if ix < 0 || ix >= P.nodes.length { return none }
  const n = nodeAt(ix)
  if n is Block {
    for t in n.blkStmts {
      if t == s { return n.blkStmts }
    }
  }
  for c in nodeChildren(ix) {
    const got = blockHolding(c, s)
    if got.length > 0 { return got }
  }
  return none
}
