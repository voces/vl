// Where a record value comes from and where it lands, by syntax: the argument a generic call
// hands straight back, the parameter an argument pins (un-annotated, or of a generic), the
// declaration a read names past a loop's shadowing binder, and the joins, coalesce operands and
// index bases a value's tail passes through. The checker's record adoption and widening walks
// ask these; nothing here reads a type or the checker's tables.
// This module imports `./ast`, `./check_scopes`, `./check_write_scan` and `./listutil`.
import {
  ArrayLit,
  BinExpr,
  Block,
  Call,
  FuncDecl,
  Ident,
  IfStmt,
  Index,
  LetDecl,
  MatchExpr,
  P,
  Param,
  TypeRef,
  annTsOf,
  callHasTyArgs,
  nodeAt,
  tsMentionsAnyName,
} from "./ast"
import { identBoundFnDeclOf } from "./check_scopes"
import {
  CW_OCC_USE,
  CW_UP_ARG,
  CW_UP_ASG_RHS,
  CW_UP_ELEM,
  CW_UP_FIELD,
  CW_UP_LETINIT,
  CW_UP_SPREAD,
  cwIxBuild,
  cwIxKind,
  cwIxNode,
  cwIxUp,
  cwIxUpAux,
  cwIxUpKind,
  cwOccNext,
  cwOccWalkUse,
  cwPeelValue,
} from "./check_write_scan"
import { strListHas } from "./listutil"
import { identDeclOf } from "./symbols"

// The argument a call hands straight back: a generic function whose declared result is a bare
// type parameter `T` that exactly one parameter is declared as. -1 for any other call.
export function recPassThroughArg(x: i32): i32 {
  const c = nodeAt(x)
  if c is Call && c.callFn >= 0 {
    const cn = nodeAt(c.callFn)
    if cn is Ident {
      const fd = identBoundFnDeclOf(c.callFn)
      if fd < 0 { return -1 }
      const f = nodeAt(fd)
      if f is FuncDecl {
        if f.fnTyParams.length == 0 || f.fnRet < 0 { return -1 }
        const rt = nodeAt(f.fnRet)
        if rt is TypeRef {
          if !strListHas(f.fnTyParams, rt.tyName) { return -1 }
          let at = -1
          let i = 0
          while i < f.fnParams.length {
            const pn = nodeAt(f.fnParams[i])
            if pn is Param {
              if pn.parType >= 0 {
                const pt = nodeAt(pn.parType)
                if pt is TypeRef {
                  if pt.tyName == rt.tyName {
                    if at >= 0 { return -1 }
                    at = i
                  }
                }
              }
            }
            i = i + 1
          }
          if at >= 0 && at < c.callArgs.length { return c.callArgs[at] }
        }
      }
    }
  }
  -1
}

// `recPassThroughArg` when only that argument pins the type parameter: the call writes no type
// arguments and no other parameter's annotation names it, so the instance can be taken at the
// call's destination. -1 otherwise.
export function recSolePinArg(x: i32): i32 {
  const pa = recPassThroughArg(x)
  if pa < 0 || x >= P.nodes.length || callHasTyArgs(x) { return -1 }
  const c = nodeAt(x)
  if c is Call && c.callFn >= 0 {
    const cn = nodeAt(c.callFn)
    if cn is Ident {
      const fd = identBoundFnDeclOf(c.callFn)
      if fd < 0 || fd >= P.nodes.length { return -1 }
      const f = nodeAt(fd)
      if f is FuncDecl && f.fnRet >= 0 && f.fnRet < P.nodes.length {
        const rt = nodeAt(f.fnRet)
        if rt is TypeRef {
          let seen = 0
          for px in f.fnParams {
            const pn = nodeAt(px)
            if pn is Param {
              if (
                pn.parType >= 0
                && tsMentionsAnyName(annTsOf(pn.parType), [rt.tyName])
              ) {
                seen = seen + 1
              }
            }
          }
          if seen == 1 { return pa }
        }
      }
    }
  }
  -1
}

// The list literal argument of generic call `x` whose result is one of its elements: the callee
// returns a type parameter `T` that only one parameter names, annotated `T[]`, and the call writes
// no type arguments. -1 otherwise.
export function recElemPinLit(x: i32): i32 {
  if x < 0 || x >= P.nodes.length || callHasTyArgs(x) { return -1 }
  const c = nodeAt(x)
  if !(c is Call) || c.callFn < 0 || !(nodeAt(c.callFn) is Ident) { return -1 }
  const fd = identBoundFnDeclOf(c.callFn)
  const f = if fd >= 0 && fd < P.nodes.length { nodeAt(fd) } else { null }
  if !(f is FuncDecl) || f.fnRet < 0 || f.fnParams.length != c.callArgs.length {
    return -1
  }
  const rt = nodeAt(f.fnRet)
  if !(rt is TypeRef) || !strListHas(f.fnTyParams, rt.tyName) { return -1 }
  let at = -1
  let i = 0
  while i < f.fnParams.length {
    const pn = nodeAt(f.fnParams[i])
    if (
      pn is Param
      && pn.parType >= 0
      && tsMentionsAnyName(annTsOf(pn.parType), [rt.tyName])
    ) {
      const pt = nodeAt(pn.parType)
      if at >= 0 || !(pt is TypeRef) || pt.tyName != rt.tyName + "[]" {
        return -1
      }
      at = i
    }
    i = i + 1
  }
  const a = if at >= 0 { cwPeelValue(c.callArgs[at]) } else { -1 }
  if a >= 0 && a < P.nodes.length && nodeAt(a) is ArrayLit { a } else { -1 }
}

// The argument whose values a generic call hands back in the same shape: the call writes no type
// arguments, and exactly one parameter names a type parameter, spelled as the declared result.
// Every value of a type parameter in the result is then one of that argument's. -1 otherwise.
export function recShapePassArg(x: i32): i32 {
  if x < 0 || x >= P.nodes.length || callHasTyArgs(x) { return -1 }
  const c = nodeAt(x)
  if c is Call && c.callFn >= 0 {
    const cn = nodeAt(c.callFn)
    if cn is Ident {
      const fd = identBoundFnDeclOf(c.callFn)
      if fd < 0 || fd >= P.nodes.length { return -1 }
      const f = nodeAt(fd)
      if f is FuncDecl && f.fnTyParams.length > 0 && f.fnRet >= 0 {
        const rt = nodeAt(f.fnRet)
        if rt is TypeRef {
          let at = -1
          let i = 0
          while i < f.fnParams.length {
            const pn = nodeAt(f.fnParams[i])
            if pn is Param {
              if (
                pn.parType >= 0
                && tsMentionsAnyName(annTsOf(pn.parType), f.fnTyParams)
              ) {
                const pt = nodeAt(pn.parType)
                if at >= 0 || pn.parRest != 0 { return -1 }
                if pt is TypeRef {
                  if pt.tyName != rt.tyName { return -1 }
                } else {
                  return -1
                }
                at = i
              }
            }
            i = i + 1
          }
          if at >= 0 && at < c.callArgs.length { return c.callArgs[at] }
        }
      }
    }
  }
  -1
}

// The `let`/`const` declaration the read `x` names, or -1 when it names any other binding.
export function recBindDeclOf(x: i32): i32 {
  const d = identDeclOf(x)
  if d < 0 || d >= P.nodes.length || !(nodeAt(d) is LetDecl) { return -1 }
  d
}

// Is `u` an argument to a parameter that takes its type from the argument: an un-annotated one,
// or one of a generic function? Such a parameter is specialised at the value's own row.
export function recOwnIsPin(u: i32): boolean {
  if u < 0 || u >= cwIxUp.length || cwIxUpKind[u] != CW_UP_ARG { return false }
  const cn = nodeAt(cwIxUp[u])
  if cn is Call && cn.callFn >= 0 {
    const f = nodeAt(cn.callFn)
    if f is Ident {
      const fd = identBoundFnDeclOf(cn.callFn)
      if fd < 0 { return true }
      const fn = nodeAt(fd)
      if fn is FuncDecl {
        if fn.fnTyParams.length > 0 { return true }
        return recNumParamAt(cwIxUp[u], cwIxUpAux[u]) >= 0
      }
    }
  }
  false
}

// The un-annotated parameter at position `pos` of the function the call `c` names, or -1.
function recNumParamAt(c: i32, pos: i32): i32 {
  const cn = nodeAt(c)
  if cn is Call && cn.callFn >= 0 {
    const f = nodeAt(cn.callFn)
    if f is Ident {
      const fd = identBoundFnDeclOf(cn.callFn)
      if fd < 0 { return -1 }
      const fn = nodeAt(fd)
      if fn is FuncDecl {
        if pos < 0 || pos >= fn.fnParams.length { return -1 }
        const pn = nodeAt(fn.fnParams[pos])
        if pn is Param {
          if pn.parType < 0 { return fn.fnParams[pos] }
        }
      }
    }
  }
  -1
}

// How a refusal names the kept declaration `d`.
export function recKeptWhat(d: i32): string {
  const n = nodeAt(d)
  if n is LetDecl { return "`" + n.letName + "`, which holds only literals," }
  "this value"
}

// The container an element read `x` reads from, or -1 when `x` is no element read.
export function recIndexBase(x: i32): i32 {
  const n = nodeAt(x)
  if n is Index { return n.idxArr }
  -1
}

// The two operands of `x` when it is a `??`, else none.
export function recCoalesceOperands(x: i32): i32[] {
  const n = nodeAt(x)
  if n is BinExpr {
    if n.binOp == "??" { return [n.binLeft, n.binRight] }
  }
  []
}

// Is the returned value `lf` a binding that is also handed to another place (an argument, a
// store, a list or object literal, another binding), so another handle shares it?
export function recLeafEscapes(lf: i32): boolean {
  const p = cwPeelValue(lf)
  if p < 0 || p >= P.nodes.length { return false }
  const e = nodeAt(p)
  if e is Ident {
    // The rows resolving to this binding only, not those that resolve to no frame.
    const ow = cwOccWalkUse(p)
    ow.u = -1
    while cwOccNext(ow) {
      const r = ow.row
      const u = cwIxNode[r]
      if cwIxKind[r] == CW_OCC_USE && u != p && u < cwIxUpKind.length {
        const k = cwIxUpKind[u]
        if (
          k == CW_UP_ARG
          || k == CW_UP_ASG_RHS
          || k == CW_UP_ELEM
          || k == CW_UP_FIELD
          || k == CW_UP_LETINIT
          || k == CW_UP_SPREAD
        ) {
          return true
        }
      }
    }
  }
  false
}

// Is `x` a value `if`, `match` or block?
export function recIsJoin(x: i32): boolean {
  const n = nodeAt(x)
  n is IfStmt || n is MatchExpr || n is Block
}

// Is `at` an argument of a generic function or a method, whose parameter the call pins?
export function recAtPinnedArg(at: i32): boolean {
  cwIxBuild()
  if at < 0 || at >= cwIxUp.length || cwIxUpKind[at] != CW_UP_ARG {
    return false
  }
  const cn = nodeAt(cwIxUp[at])
  if cn is Call {
    if cn.callFn < 0 { return true }
    const f = nodeAt(cn.callFn)
    if f is Ident {
      const fd = identBoundFnDeclOf(cn.callFn)
      if fd < 0 { return true }
      const fn = nodeAt(fd)
      if fn is FuncDecl { return fn.fnTyParams.length > 0 }
    }
    return true
  }
  false
}

// The initializer of the declaration `d`, or -1.
export function recDeclInit(d: i32): i32 {
  const n = nodeAt(d)
  if n is LetDecl { return n.letInit }
  -1
}
