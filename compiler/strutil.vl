// ── string utilities that must survive the representation change ─────────────
//
// `s[i]` is a byte and `.length` a byte count, so two idioms fail silently: feeding
// `s[i]` to `fromCodePoints` re-encodes each byte as its own character, and
// `.length` read as a width (a column, a pad) rather than as an offset handed back
// to `slice` answers in the wrong unit — offsets cancel, widths do not.
// `docs/internals/str-byte-semantics.md`, `docs/guide/strings-design.md`.
//
// One place each answer is written, and a leaf so every module can reach it. Every
// function here is unit-stable: the same answer under the code-point and the byte
// representation, which the bootstrap ladder needs because this source is compiled
// by the previous compiler and a helper that disagreed would stop the fixpoint.

// Append `s`'s code points to a `fromCodePoints` buffer. `for cp in s` yields code
// points under both representations — its lowering decodes UTF-8, its surface is
// unchanged — so producer and consumer are a matched pair.
export function pushCps(buf: i32[], s: string) {
  for cp in s { buf.push(cp) }
}

// The code point count of `s` — `.length` when a width is meant rather than an
// offset, O(n) and so a name rather than a subscript. It does not call the core
// `s.cpLen()`: that intrinsic postdates the seed that compiles this source on the
// bootstrap rung. `cpLen()` is for `std/` and user code.
export function cpCount(s: string) {
  let n = 0
  for cp in s { n = n + 1 }
  n
}

// A host-fed code-point stream, held as strings of at most `CP_CHUNK` bytes plus an
// unflushed tail of UTF-8 bytes, encoded as each code point arrives so a flush is one
// copy. One list over a whole source outgrows the engine's largest single allocation
// (64 MiB) long before the source string itself does (D1975).
export type CpAcc = { tail: u8[], chunks: string[] }
const CP_CHUNK = 1048576

export function cpAccNew(): CpAcc { { tail: [], chunks: [] } }

export function cpAccPush(a: CpAcc, cp: i32) {
  if cp >= 0 && cp < 128 { a.tail.push(cp) } else { cpAccPushWide(a.tail, cp) }
  if a.tail.length >= CP_CHUNK { cpAccFlush(a) }
}

// Appends the bytes encoding `c`, the replacement character when it has no encoding, as `fromCodePoint` does.
function cpAccPushWide(t: u8[], c: i32) {
  let cp = c
  if cp < 0 || cp > 1114111 || (cp >= 55296 && cp <= 57343) { cp = 65533 }
  if cp < 128 {
    t.push(cp)
  } else if cp < 2048 {
    t.push(192 | (cp >> 6))
    t.push(128 | (cp & 63))
  } else if cp < 65536 {
    t.push(224 | (cp >> 12))
    t.push(128 | ((cp >> 6) & 63))
    t.push(128 | (cp & 63))
  } else {
    t.push(240 | (cp >> 18))
    t.push(128 | ((cp >> 12) & 63))
    t.push(128 | ((cp >> 6) & 63))
    t.push(128 | (cp & 63))
  }
}

// Appends the `count` UTF-32LE code points the host staged at linear memory 0 — the
// `<name>Load` half of the host's `StrIn` ABI (`driver.srcLoad`).
export function cpAccLoad(a: CpAcc, count: i32) {
  const t = a.tail
  let i = 0
  while i < count {
    const cp = __load_i32__(i * 4)
    if cp >= 0 && cp < 128 { t.push(cp) } else { cpAccPushWide(t, cp) }
    i = i + 1
  }
  if t.length >= CP_CHUNK { cpAccFlush(a) }
}

function cpAccFlush(a: CpAcc) {
  const bs = a.tail
  if bs.length == 0 { return }
  a.chunks.push(__str_from_bytes__(bs, 0, bs.length))
  a.tail = []
}

export function cpAccEmpty(a: CpAcc): boolean {
  a.tail.length == 0 && a.chunks.length == 0
}

// The whole stream as one string. Idempotent: the joined string replaces the chunks,
// so a second call copies nothing. Joined pairwise, so each byte is copied once per
// level (log2 of the chunk count) rather than once per chunk.
export function cpAccString(a: CpAcc): string {
  cpAccFlush(a)
  if a.chunks.length == 0 { return "" }
  let cur = a.chunks
  while cur.length > 1 {
    const next: string[] = []
    let i = 0
    while i + 1 < cur.length {
      next.push(cur[i] + cur[i + 1])
      i = i + 2
    }
    if i < cur.length { next.push(cur[i]) }
    cur = next
  }
  a.chunks = cur
  cur[0]
}

// `cpAccString`, leaving the accumulator empty for the next stream.
export function cpAccTake(a: CpAcc): string {
  const s = cpAccString(a)
  cpAccReset(a)
  s
}

export function cpAccReset(a: CpAcc) {
  a.tail = []
  a.chunks = []
}

// Whether `sub` occurs anywhere in `s`; an empty `sub` always does. A byte scan, which is
// unit-stable: a UTF-8 needle matches only at a code-point boundary of the haystack.
export function strContains(s: string, sub: string) {
  if sub.length == 0 { return true }
  if sub.length > s.length { return false }
  let i = 0
  while i + sub.length <= s.length {
    let j = 0
    let ok = true
    while j < sub.length {
      if s[i + j] != sub[j] {
        ok = false
        j = sub.length
      } else {
        j = j + 1
      }
    }
    if ok { return true }
    i = i + 1
  }
  false
}

// The value of hex-digit code point `c` (`0-9 a-f A-F`), or -1 when `c` is not one.
export function hexVal(c: i32) {
  if c >= '0' && c <= '9' { return c - '0' }
  if c >= 'a' && c <= 'f' { return c - 'a' + 10 }
  if c >= 'A' && c <= 'F' { return c - 'A' + 10 }
  -1
}

// The first `/`-separated segment of `path`: all of it when it holds no `/`.
export function topPathSeg(path: string): string {
  let i = 0
  while i < path.length && path[i] != '/' { i = i + 1 }
  path.slice(0, i)
}

// The value of decimal digits `t`, or -1 when it is empty or holds anything else.
export function decDigitsOf(t: string): i32 {
  if t.length == 0 { return -1 }
  let v = 0
  let i = 0
  while i < t.length {
    if t[i] < '0' || t[i] > '9' { return -1 }
    v = v * 10 + (t[i] - '0')
    i = i + 1
  }
  v
}
