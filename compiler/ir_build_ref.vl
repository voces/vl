// `ir_build_ref.vl` — the IR builder's reference values and list reads (ir-design-2026-11.md
// §5.3, I2's list half). A `str` or a list of unpacked primitives may be a variable, parameter
// or result. A list read on legacy's plain guarded path builds `SBoundsCheck` then `RListGet`
// over the same operands; the lowering takes its scratch slots from the shared lazy list frame.
// Every other element or member read is a named miss. `irRefInstall` sets the hooks.

import { BinExpr, Index, Member, nodeAt } from "./ast"
import { OVar, Opnd, StrOp, repPrim, repWhat } from "./ir"
import {
  irBBoxLocal,
  irBExpr,
  irBFnIx,
  irBLetTemp,
  irBMiss,
  irBNoValue,
  irBNode,
  irBNoteFieldReread,
  irBOpRep,
  irInPlaceHook,
  irIndexHook,
  irListEqHook,
  irMemberHook,
  irNodeInShadow,
  irStrBinHook,
  irUnionEqHook,
  irVarRepOkHook,
} from "./ir_build"
import {
  irLoopCloseHook,
  irLoopOpenHook,
  irLowerBoundsHook,
  irLowerEffectHook,
  irLowerListHook,
  irLowerListSetHook,
} from "./ir_lower"
import { irBoundsRuleHook } from "./ir_verify"
import {
  irLowerRefBounds,
  irLowerRefEffect,
  irLowerRefList,
  irLowerRefListSet,
  irLowerRefLoopClose,
  irLowerRefLoopOpen,
  listIdxPlainWhy,
} from "./ir_lower_ref"
import { irBoundsRule } from "./ir_verify_bounds"
import {
  RList,
  RRecord,
  repNodeAt,
  repNodeKids,
  repNodeOfTy,
  repRecordKidOf,
} from "./emit_rep"
import { nodeTyAt } from "./emit_capture_frames"
import {
  irNodeInShadowHook,
  listEqRouteOf,
  narrowedFieldPlain,
  strCatPartsOf,
  strEqFirstOf,
  strEqLitOf,
  strInPlaceMode,
  strOrderSwaps,
  strSiteOfRhs,
  structFieldPlain,
  unionUnionEqStagedOf,
  variantFieldPlain,
} from "./wasmEmit"
import { exprIsLitAtom, exprIsStrConcat } from "./emit_classify"
import { exprIsStrEq, exprIsStrOrder } from "./emit_fn_scans"

// The corrupt mode that drops every bounds check, rule 8's failing control, and the mode armed.
const CORRUPT_DROP_BOUNDS = 5
let refCorrupt = 0

// Arms corrupt mode `k` for the list builder (0 none), as `irShadowCorrupt` does for the shadow.
export function irRefCorrupt(k: i32) {
  refCorrupt = k
  return 0
}

// Whether rep `r` is a reference value this slice admits: a string or a list of any element.
// A list is an opaque ref here; each read, write and walk over it decides its own arm.
function refRepOk(r: i32, _ty: i32): boolean {
  if repPrim(r) == "str" { return true }
  return repNodeAt(r) is RList
}

function missed(o: Opnd): boolean { return o is OVar && o.ov < 0 }

function buildIndex(b: i32[], ix: i32, rep: i32): Opnd {
  const n = nodeAt(ix)
  if !(n is Index) { return irBMiss("expression") }
  const fnIx = irBFnIx()
  const why = listIdxPlainWhy(ix, fnIx)
  if why != "" { return irBMiss(why) }
  const v = irBExpr(b, n.idxArr)
  const i = irBExpr(b, n.idxIndex)
  if missed(v) || missed(i) { return irBMiss("index operand") }
  if !(v is OVar) { return irBMiss("index receiver") }
  const vr = repNodeAt(irBOpRep(v))
  if vr is RList && repPrim(vr.rlsElem) == "u8" {
    return irBMiss("index packed element")
  }
  // A read narrowed past its element's rep (an atom read as its string) converts on legacy's side.
  if vr is RList && vr.rlsElem != rep {
    return irBMiss("index element coercion")
  }
  const ixTy = nodeTyAt(n.idxIndex, fnIx)
  if repPrim(repNodeOfTy(ixTy)) != "i32" { return irBMiss("index rep") }
  if refCorrupt != CORRUPT_DROP_BOUNDS {
    irBNode(b, { bcV: v, bcIx: i }, -1, irBNoValue(), ix)
  }
  return irBLetTemp(b, { lgV: v, lgIx: i, lgAt: ix }, ix, rep)
}

// A member read, routed by its receiver's rep: a record's own `length` field never reaches a
// list or string arm.
function buildMember(b: i32[], ix: i32, rep: i32): Opnd {
  const n = nodeAt(ix)
  if !(n is Member) { return irBMiss("expression") }
  const r = repNodeOfTy(nodeTyAt(n.memObj, irBFnIx()))
  if repNodeAt(r) is RList {
    if n.memProp != "length" { return irBMiss("list member") }
    if !refRepOk(r, -1) { return irBMiss("list length rep") }
    const v = irBExpr(b, n.memObj)
    if missed(v) || !(v is OVar) { return irBMiss("list length receiver") }
    return irBLetTemp(b, { llV: v, llAt: ix }, ix, rep)
  }
  if repPrim(r) == "str" {
    if n.memProp != "length" { return irBMiss("string member " + n.memProp) }
    const sv = irBExpr(b, n.memObj)
    if missed(sv) || !(sv is OVar) { return irBMiss("string length receiver") }
    return irBLetTemp(b, { llV: sv, llAt: ix }, ix, rep)
  }
  // A plain field read off a struct or a bare variant.
  const fnIx = irBFnIx()
  const plain = variantFieldPlain(ix, fnIx) >= 0
    || structFieldPlain(ix, fnIx) >= 0
  if repNodeAt(r) is RRecord && plain {
    const k = repRecordKidOf(r, nodeTyAt(n.memObj, fnIx), n.memProp)
    if k < 0 { return irBMiss("field kid") }
    if repNodeKids(r)[k] != rep { return irBMiss("field read coercion") }
    const rv = irBExpr(b, n.memObj)
    if missed(rv) { return rv }
    irBNoteFieldReread(ix, k)
    return irBLetTemp(b, { gfV: rv, gfIx: k, gfAt: ix }, ix, rep)
  }
  // A field read off a box local narrowed to one variant.
  const idx = narrowedFieldPlain(ix, irBFnIx())
  if repNodeAt(r) is RRecord && idx >= 0 {
    const bv = irBBoxLocal(n.memObj)
    if missed(bv) { return bv }
    return irBLetTemp(b, { bfV: bv, bfAt: ix }, ix, rep)
  }
  return irBMiss("member " + repWhat(r))
}

// A string `+` chain, `==`/`!=` or ordering, its operands built in legacy's push order: an
// equality's quoted literal is its second operand, and an ordering may push right first.
function buildStrBin(b: i32[], ix: i32, rep: i32): Opnd {
  const n = nodeAt(ix)
  if !(n is BinExpr) { return irBMiss("expression") }
  const fnIx = irBFnIx()
  let op: StrOp = "concat"
  let at = ix
  let parts: i32[] = []
  if exprIsStrConcat(ix, fnIx) {
    parts = strCatPartsOf(ix, fnIx)
    // An armed site's right side joins in place; its node is keyed by the assignment.
    const site = strSiteOfRhs(ix, fnIx)
    if site >= 0 {
      op = "site"
      at = site
    }
  } else if exprIsStrEq(ix, fnIx) {
    op = "eq"
    const lit = strEqLitOf(ix, fnIx)
    // A quoted literal is the second operand; an atom-typed one widens in legacy's writer.
    if lit >= 0 && exprIsLitAtom(lit, fnIx) {
      return irBMiss("atom literal operand")
    }
    parts.push(strEqFirstOf(n, lit))
    parts.push(if lit < 0 { n.binRight } else { lit })
  } else if exprIsStrOrder(ix, fnIx) {
    op = "lt"
    const swap = strOrderSwaps(n)
    parts = if swap { [n.binRight, n.binLeft] } else { [n.binLeft, n.binRight] }
  } else {
    return irBMiss("operand at string")
  }
  const args: Opnd[] = []
  for p in parts {
    const a = irBExpr(b, p)
    if missed(a) { return a }
    if repPrim(irBOpRep(a)) != "str" {
      return irBMiss("string operand coercion")
    }
    args.push(a)
  }
  return irBLetTemp(b, { soOp: op, soArgs: args, soAt: at }, ix, rep)
}

function unionEqOf(ix: i32, fnIx: i32): boolean {
  const n = nodeAt(ix)
  return n is BinExpr && unionUnionEqStagedOf(n, fnIx)
}

function listEqOf(ix: i32, fnIx: i32): boolean {
  const n = nodeAt(ix)
  return n is BinExpr && listEqRouteOf(n, ix, fnIx)
}

// Installs the list builder, lowering and rule 8; run once before emit.
export function irRefInstall() {
  irVarRepOkHook = refRepOk
  irIndexHook = buildIndex
  irMemberHook = buildMember
  irStrBinHook = buildStrBin
  irInPlaceHook = strInPlaceMode
  irUnionEqHook = unionEqOf
  irListEqHook = listEqOf
  irLowerListHook = irLowerRefList
  irLowerEffectHook = irLowerRefEffect
  irNodeInShadowHook = irNodeInShadow
  irLowerListSetHook = irLowerRefListSet
  irLowerBoundsHook = irLowerRefBounds
  irLoopOpenHook = irLowerRefLoopOpen
  irLoopCloseHook = irLowerRefLoopClose
  irBoundsRuleHook = irBoundsRule
  return 0
}
