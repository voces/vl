// The corrupt mode that drops every bounds check, rule 8's failing control, and the mode armed.
const CORRUPT_DROP_BOUNDS = 5
let refCorrupt = 0

// Arms corrupt mode `k` for the list builder (0 none), as `irShadowCorrupt` does for the shadow.
export function irRefCorrupt(k: i32) {
  refCorrupt = k
  return 0
}

// Whether rep `r` is a reference value this slice admits: a string or a list of any element.
// A list is an opaque ref here; each read, write and walk over it decides its own arm.
function refRepOk(r: i32, _ty: i32): boolean {
  if repPrim(r) == "str" { return true }
  return repNodeAt(r) is RList
}

function missed(o: Opnd): boolean { return o is OVar && o.ov < 0 }

// Whether a tagged call's stash, a valued `if` or a staging `??` is among the receiver nodes `b`
// holds from `at`: legacy writes the receiver, of any expression, inside the element read it
// receives.
function receiverStmtLeads(f: IrFn, b: i32[], at: i32): boolean {
  let j = at
  while j < b.length {
    if tagStashAt(f, b[j]) || valuedIfAt(f, b[j]) || stagingCoalAt(f, b[j]) {
      return true
    }
    j = j + 1
  }
  return false
}

// Whether node `id` is a statement writing a tagged call's stash.
function tagStashAt(f: IrFn, id: i32): boolean {
  const n = f.irNodes[id]
  return n is SEffect && n.efRhs is RTagStash
}

// Whether node `id` is a valued `if`.
function valuedIfAt(f: IrFn, id: i32): boolean {
  const n = f.irNodes[id]
  return n is SIf && n.siOut >= 0
}

// Whether node `id` is a `??` that writes the operands staged before it below its `if`
// (`coalArmStagesLeads`), as a valued `if` does.
function stagingCoalAt(f: IrFn, id: i32): boolean {
  const n = f.irNodes[id]
  return n is SCoalBox && coalArmStagesLeads(n.cbArm)
}

// Legacy's row spans a whole element read `ix`, a receiver a fused coalesce, a valued `if` or a
// tagged call's stash (`receiverStmtLeads`) writes as a statement from `b[at]` included: notes
// that statement as its start.
function idxRowOpenNote(b: i32[], at: i32, ix: i32) {
  if b.length <= at { return 0 }
  const f = irBFn()
  const lead = f.irNodes[b[at]]
  if (lead is SCoalBox || receiverStmtLeads(f, b, at)) {
    f.irIdxRowAt[ix] = b[at]
    f.irRowOpens[b[at]] = true
    f.irHasRowOpens = true
  }
  return 0
}

function buildIndex(b: i32[], ix: i32, rep: i32): Opnd {
  const n = nodeAt(ix)
  if !(n is Index) { return irBMiss("expression") }
  const fnIx = irBFnIx()
  if armSiteReads(ix, fnIx) { return armSiteRead(b, ix, rep) }
  if exprMap(n.idxArr, fnIx) { return mapGetBare(b, ix, rep) }
  const why = listIdxPlainWhy(ix, fnIx)
  if why != "" { return irBMiss(why) }
  const at = b.length
  const v0 = irBExpr(b, n.idxArr)
  idxRowOpenNote(b, at, ix)
  const ia = b.length
  const i = irBExpr(b, n.idxIndex)
  if missed(v0) || missed(i) { return irBMiss("index operand") }
  // A receiver legacy writes ahead of a valued `if` in the index is staged below it.
  const leads: Opnd[] = [v0]
  const staged0 = b.length
  if !irBStageLeads(b, ia, [at], leads, [n.idxArr]) {
    return irBMiss("index valued-if operand")
  }
  // A staged receiver opens the read's row, as legacy's receiver does ahead of the `if`.
  if b.length > staged0 { idxRowOpenNote(b, at, ix) }
  const v = leads[0]
  // A string literal receiver is legacy's literal writer at its use, as any string operand is.
  const lit = v is OStr && idxArmOf(n, fnIx) == "string"
  if !(v is OVar) && !lit { return irBMiss("index receiver") }
  const vr = repNodeAt(irBOpRep(v))
  // A read narrowed past its element's rep (an atom read as its string) converts on legacy's side;
  // a sub-word element (`repSubWord`) reads into an i32, extended as its width is signed.
  const packed = vr is RList && repSubWord(vr.rlsElem) && repPrim(rep) == "i32"
  // A `(string | null)` element the checker types non-null is read recovered, at a string.
  const en = if vr is RList { repNodeAt(vr.rlsElem) } else { null }
  const recovered = en is RNullable
    && en.rnInner == rep
    && repPrim(rep) == "str"
    && idxArmOf(n, fnIx) == "nulstr"
    && strListReadsNonNull(ix, true)
  // A `K | null` or `boolean | null` element the checker narrowed past its null is the i32 its
  // niche holds, which `emitIndexScalarList` reads alike at either type.
  const nicheNarrowed = en is RNullable
    && en.rnInner == rep
    && (en.rnDisc == 3 || en.rnDisc == 2)
    && idxArmOf(n, fnIx) == "scalar"
  // A nullable ref element the place narrows non-null is read recovered (`refListGetTail`).
  const refRecovered = en is RNullable
    && en.rnInner == rep
    && idxArmOf(n, fnIx) == "ref"
    && listElemStaysNullable(n.idxArr, fnIx)
    && listReadProvedNonNull(ix)
  // An element read at an open type takes the element as it is stored (`openRepTakes`), as does
  // one of a list read at its declared storage (`storedReadOf`) or a ref element stored alike that
  // is no box pair (a box pair is `boxView`'s). A ref element is that storage's declaration too:
  // `array.get` reads it as stored where the open read's rep names no valtype.
  const ety = nodeTyAt(ix, fnIx)
  const declared = v is OVar && storedReadOf(n.idxArr) == v.ov
  const refUndeclared = idxArmOf(n, fnIx) == "ref"
    && vr is RList
    && !heldAsBox(vr.rlsElem)
    && undeclaredRepTakes(ety, rep, vr.rlsElem)
  const stored = vr is RList
    && vr.rlsElem != rep
    && (openRepTakes(ety, rep, vr.rlsElem)
    || (declared || refUndeclared)
    && undeclaredRepTakes(ety, rep, vr.rlsElem)
    || idxArmOf(n, fnIx) == "ref"
    && repStoresAs(rep, vr.rlsElem)
    && !(heldAsBox(vr.rlsElem) && heldAsBox(rep)))
  // A record element read at another record on its heap whose fields lower alike or widen is
  // that record as it stands (`recRowRetag`), legacy's plain `array.get`.
  const recTwin = vr is RList
    && vr.rlsElem != rep
    && idxArmOf(n, fnIx) == "ref"
    && (recRowRetag(vr.rlsElem, rep, irBFn().irRecHeap)
    || recRowRetagOn(
    vr.rlsElem,
    rep,
    listElemHeapOf(n.idxArr, fnIx),
    irBFn().irRecHeap,
  ))
  // A reference element read at its own nullable is that reference, its niche's value.
  const rn = repNodeAt(rep)
  const nicheView = vr is RList
    && vr.rlsElem != rep
    && idxArmOf(n, fnIx) == "ref"
    && rn is RNullable
    && rn.rnDisc == 1
    && rn.rnInner == vr.rlsElem
    && repPrim(vr.rlsElem) == null
  // A literal set's element stored as its string and read as its atom is read at the string it is,
  // as a field's is; its consumer takes the string.
  const strAtom = vr is RList
    && repPrim(vr.rlsElem) == "str"
    && repNodeAt(rep) is RAtom
    && idxArmOf(n, fnIx) == "str"
  // An atom element read as its literal's string is read at the atom; its consumer decodes it, as a
  // field's is.
  const atomStr = vr is RList
    && repNodeAt(vr.rlsElem) is RAtom
    && repPrim(rep) == "str"
    && exprIsLitAtom(ix, fnIx)
  // A nullable element the read narrows to the `null` unit is that unit: the element read as stored
  // and dropped, then the bottom ref (`RNullOf`).
  const nulDropped = en is RNullable
    && repPrim(rep) == "null"
    && nullOwnAt(ix, fnIx) == NULL_OWN_NONE
  // A union box element narrowed to string literal arms is the string legacy's tail unboxes
  // (`refListReadUnboxOf`'s string kind); its consumer takes the string.
  const boxStr = vr is RList
    && heldAsBox(vr.rlsElem)
    && repNodeAt(rep) is RAtom
    && idxArmOf(n, fnIx) == "ref"
    && !listElemStaysNullable(n.idxArr, fnIx)
    && refListReadUnboxOf(ix, fnIx) == 2
  // A nullable closure element the read narrows non-null is read as stored, then recovered to the
  // closure (`RRecover`), so a delivery to a non-null closure slot holds one.
  const cloStored = en is RNullable
    && en.rnInner == rep
    && repNodeAt(rep) is RClosure
    && idxArmOf(n, fnIx) == "ref"
    && !refRecovered
  // A map element read at a twin map's rep (values stored alike, or apart only in a closure's
  // openness) is read as stored, then retagged, as a record twin is.
  const mapTwin = vr is RList
    && vr.rlsElem != rep
    && repNodeAt(vr.rlsElem) is RMap
    && repNodeAt(rep) is RMap
    && idxArmOf(n, fnIx) == "ref"
    && (mapRetag(vr.rlsElem, rep)
    || cloHoleRetag(irBFn(), vr.rlsElem, rep))
  // A union box element read at a narrower union's box is the same box (`RStage`).
  const boxView = vr is RList
    && vr.rlsElem != rep
    && heldAsBox(vr.rlsElem)
    && heldAsBox(rep)
  if (
    vr is RList
    && vr.rlsElem != rep
    && !packed
    && !recovered
    && !nicheNarrowed
    && !refRecovered
    && !stored
    && !strAtom
    && !atomStr
    && !nulDropped
    && !boxStr
    && !cloStored
    && !boxView
    && !recTwin
    && !mapTwin
    && !nicheView
    && !refUnboxedAt(n, ix, fnIx, rep)
  ) {
    return irBMiss("index element coercion")
  }
  const ixTy = nodeTyAt(n.idxIndex, fnIx)
  if repPrim(repNodeOfTy(ixTy)) != "i32" { return irBMiss("index rep") }
  if refCorrupt != CORRUPT_DROP_BOUNDS {
    irBNode(b, { bcV: v, bcIx: i }, -1, irBNoValue(), ix)
  }
  const stRead = isStorageRead(ix)
  const r: Rhs = { lgV: v, lgIx: i, lgAt: ix, lgStored: stRead, lgAgain: false }
  // A read whose receiver and index are each an immediate, a variable, or a temp whose read is
  // written again as built can be written again as built; a stored element's read is the same.
  const vAgain = readsAgain(v)
    || v is OVar && recvReadsAgain(unwrapParen(n.idxArr))
  const iAgain = readsAgain(i)
    || i is OVar && recvReadsAgain(unwrapParen(n.idxIndex))
  if vAgain && iAgain {
    irBFn().irReadElem[ix] = {
      lgV: v,
      lgIx: i,
      lgAt: ix,
      lgStored: stRead,
      lgAgain: true,
    }
  }
  if cloStored && vr is RList {
    const ce = irBLetTempTy(b, r, ix, vr.rlsElem, repTyOf(vr.rlsElem))
    return irBLetTempTy(
      b,
      { rcV: ce, rcAt: ix, rcNn: 1 },
      ix,
      rep,
      repTyOf(rep),
    )
  }
  if nulDropped && vr is RList {
    const ne = irBLetTempTy(b, r, ix, vr.rlsElem, repTyOf(vr.rlsElem))
    // Read at its storage (a `print` of its nullable arm), it is the element as stored.
    if stRead { return ne }
    irBNode(b, { dpV: ne }, -1, irBNoValue(), ix)
    return irBLetTempTy(
      b,
      { nuAt: ix, nuOwn: NULL_OWN_NONE, nuRead: [] },
      ix,
      rep,
      repTyOf(rep),
    )
  }
  if boxStr { return irBLetTempTy(b, r, ix, irBStrRep(), repTyOf(irBStrRep())) }
  if (stored || strAtom || atomStr) && vr is RList {
    return irBLetTempTy(b, r, ix, vr.rlsElem, repTyOf(vr.rlsElem))
  }
  if (recTwin || mapTwin || nicheView) && vr is RList {
    const el = irBLetTempTy(b, r, ix, vr.rlsElem, repTyOf(vr.rlsElem))
    return irBLetTemp(b, { rgV: el }, ix, rep)
  }
  if boxView && vr is RList {
    const el = irBLetTempTy(b, r, ix, vr.rlsElem, repTyOf(vr.rlsElem))
    return irBLetTemp(b, { sgV: el }, ix, rep)
  }
  // A read asked at its element's storage, not its narrowing, is typed at that rep.
  if vr is RList && rep == vr.rlsElem && rep != repNodeOfTy(ety) {
    return irBLetTempTy(b, r, ix, rep, repTyOf(rep))
  }
  return irBLetTemp(b, r, ix, rep)
}

// The struct heap a record list `arr`'s elements are laid out on: the element of the ref-list row
// legacy's read takes (`refListSlotOfExpr`), or -1.
function listElemHeapOf(arr: i32, fnIx: i32): i32 {
  const slot = refListSlotOfExpr(arr, fnIx)
  if slot < 0 { return -1 }
  const si = rlElemStructIdxAt(slot)
  return if si >= 0 && si < sHeapIdx.length { sHeapIdx[si] } else { -1 }
}

// Plain field `n` of a nullable record receiver at rep `r` over record `inner`, read at the field's
// own rep `rep`: the receiver, recovered to its record with no `ref.as_non_null` (`RRecover`), then
// the field.
function nullRecvField(
  b: i32[],
  n: Member,
  ix: i32,
  rep: i32,
  r: i32,
  inner: i32,
): Opnd {
  const fnIx = irBFnIx()
  if structFieldPlain(ix, fnIx) < 0 { return irBMiss("member nullable") }
  const it = repTyOf(inner)
  const k = if it >= 0 { repRecordKidOf(inner, it, n.memProp) } else { -1 }
  if k < 0 || repNodeKids(inner)[k] != rep { return irBMiss("member nullable") }
  const rv = irBExpr(b, n.memObj)
  if missed(rv) { return rv }
  if irBOpRep(rv) != r { return irBMiss("member nullable receiver rep") }
  const rc = irBLetTempTy(
    b,
    { rcV: rv, rcAt: n.memObj, rcNn: 0 },
    n.memObj,
    inner,
    it,
  )
  if missed(rc) { return rc }
  const gf: Rhs = {
    gfV: rc,
    gfIx: k,
    gfAt: ix,
    gfStored: isStorageRead(ix),
    gfStr: false,
    gfShared: false,
  }
  return irBLetTemp(b, gf, ix, rep)
}

// Read `ix` through a box of lists or maps (`armSiteRecv`: an element, `.length`, `.has` or
// `.get`) on legacy's tag chain (`SArmSite`): the box, and an index or key each arm reads again, so
// a variable, an immediate, the key's literal, or a value set once; per arm, the read built over
// the arm's payload. A box no name holds is stashed once, as legacy's.
function armSiteRead(b: i32[], ix: i32, rep: i32): Opnd {
  const recv = armSiteRecv(ix)
  if recv < 0 || recv >= P.nodes.length { return irBMiss("arm site receiver") }
  const named = nodeAt(recv) is Ident
  const v0 = irBExpr(b, recv)
  if missed(v0) { return irBMiss("arm site receiver") }
  // A narrowed name read as the same box (`RStage`) is that name: legacy's arms re-read the name.
  const v = if named { stagedVar(b, v0) } else { v0 }
  // A global's read, the temp just built, is written again in each arm, as legacy's re-read is.
  if named && !(v is OVar && (readsAgain(v) || globalReadLast(b, v))) {
    return irBMiss("arm site operand")
  }
  const ops: Opnd[] = [v]
  const on = armSiteOpndNode(ix)
  if on >= 0 {
    const i = irBExpr(b, on)
    if missed(i) { return irBMiss("index operand") }
    // A map arm's key is written as its literal: a plain string key needs no conversion. An index
    // that calls and writes nothing is built once ahead of the chain, where legacy writes it again
    // in the one arm that runs (Q57: the same value, read before the tag test).
    const lit = i is OStr && i.osAt == on
    const once = !readsAgain(i)
      && !lit
      && exprEffectFree(on)
      && repPrim(irBOpRep(i)) == "i32"
    if !readsAgain(i) && !lit && !once { return irBMiss("arm site operand") }
    ops.push(i)
  }
  const ty = repTyOf(rep)
  if ty < 0 || irTyOpen(ty) { return irBMiss("open temp type") }
  // An index set once is read in the arms as a variable on legacy's index stash.
  let iv = -1
  const io: Opnd[] = []
  if ops.length == 2 {
    const i = ops[1]
    if i is OVar && irBFn().irVars[i.ov].vKind == "temp" {
      iv = irVarNew(irBFn(), irBOpRep(i), repTyOf(irBOpRep(i)), "local", -1)
      const o: Opnd = { ov: iv }
      io.push(o)
    } else {
      io.push(i)
    }
  }
  const arms = armSiteArmsOf(ix, irBFnIx())
  if arms.length == 0 { return irBMiss("arm site arms") }
  if !armSiteRepHolds(ix, irBFnIx()) { return irBMiss("arm site element rep") }
  const t = irVarNew(irBFn(), rep, ty, "local", -1)
  const bodies: i32[][] = []
  const vars: i32[] = []
  for m in arms {
    const e = armSiteElemTyOf(ix, m, irBFnIx())
    const pr = repNodeOfTy(m)
    if e < 0 || pr < 0 { return irBMiss("arm site arm") }
    const pv = irVarNew(irBFn(), pr, m, "local", -1)
    const ab: i32[] = []
    const d = irBArmSiteArm(ab, ix, m, e, pv, on, io, rep)
    if missed(d) { return d }
    if irBOpRep(d) != rep { return irBMiss("arm site arm rep") }
    irBNode(ab, { asDst: t, asSrc: d }, -1, irBNoValue(), ix)
    bodies.push(ab)
    vars.push(pv)
  }
  irBNode(
    b,
    {
      saOps: ops,
      saAt: ix,
      saStash: !named,
      saArms: bodies,
      saVars: vars,
      saIdx: iv,
      saOut: t,
    },
    ty,
    rep,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// Whether `o` is the temp the last node of `b` defines by a global's read (`RGlobalGet`).
function globalReadLast(b: i32[], o: Opnd): boolean {
  if !(o is OVar) || o.ov < 0 || b.length == 0 { return false }
  const nd = irBFn().irNodes[b[b.length - 1]]
  return nd is SLet && nd.lDst == o.ov && nd.lRhs is RGlobalGet
}

// Operand `o`, or the variable it stages where the last node of `b` is its `RStage` over a
// re-readable variable: that node is dropped, and the variable read in its place.
function stagedVar(b: i32[], o: Opnd): Opnd {
  if !(o is OVar) || b.length == 0 { return o }
  const nd = irBFn().irNodes[b[b.length - 1]]
  if !(nd is SLet) || nd.lDst != o.ov { return o }
  const r = nd.lRhs
  if !(r is RStage) || !readsAgain(r.sgV) { return o }
  b.pop()
  return r.sgV
}

// Whether operand `o` reads the same where it is written again: an immediate, or a variable's read.
function readsAgain(o: Opnd): boolean {
  if o is OImm { return true }
  return o is OVar && o.ov >= 0 && irBFn().irVars[o.ov].vKind != "temp"
}

// Whether ref list read `ix` leaves rep `rep` by the unbox legacy's tail writes after the element
// (`refListReadUnboxOf`): its narrowed container, the scalar of an atom kind, or a function arm's
// closure.
function refUnboxedAt(n: Index, ix: i32, fnIx: i32, rep: i32): boolean {
  if idxArmOf(n, fnIx) != "ref" || listElemStaysNullable(n.idxArr, fnIx) {
    return false
  }
  const u = refListReadUnboxOf(ix, fnIx)
  if u == REF_READ_CONTAINER {
    const rn = repNodeAt(rep)
    return rn is RList || rn is RMap
  }
  // A function arm's box tag unboxes to its closure: the payload cast to the closure's heap.
  if u >= 0 && repNodeAt(rep) is RClosure {
    return boxTagOfTy(nodeTyAt(ix, fnIx)) == u
  }
  return u >= 0 && irBAtomKindRep(u, rep)
}

// Whether a union-box field read `ix` of member `n` off variant record `r` leaves rep `rep` by the
// unbox legacy writes after it (`unionFieldNarrowUnboxOf`): the box itself, as a box or as the
// nullable boxed on that field's box (`boxedNullable`), or the atom it unboxes to.
function narrowUnboxRepIs(ix: i32, r: i32, n: Member, rep: i32): boolean {
  return match unionFieldNarrowUnboxOf(ix, irBFnIx()) {
    "container" => false
    "atom" | "unbox" => irBAtomKindRep(unionFieldUnboxKindOf(ix, irBFnIx()), rep)
    "none" => repNodeAt(rep) is RBox || boxedNullable(rep) && fieldBoxOf(r, n, rep)
  }
}

// Whether boxed nullable `rep` rides the box variant record `r` stores field `n` in.
function fieldBoxOf(r: i32, n: Member, rep: i32): boolean {
  const k = repRecordKidOf(r, nodeTyAt(n.memObj, irBFnIx()), n.memProp)
  const ks = repNodeKids(r)
  if k < 0 || k >= ks.length { return false }
  return ks[k] == rep || repBoxCore(ks[k]) == repBoxCore(rep)
}

// Whether a narrowed variant field `n` of record rep `r` reads at `rep` as its tail writes it: the
// field's kid rep, or a nullable kid's inner where the tail recovers it non-null.
function fieldReadsAt(r: i32, n: Member, rep: i32): boolean {
  const k = repRecordKidOf(r, nodeTyAt(n.memObj, irBFnIx()), n.memProp)
  const ks = repNodeKids(r)
  if k < 0 || k >= ks.length { return false }
  const kn = repNodeAt(ks[k])
  return ks[k] == rep || kn is RNullable && kn.rnInner == rep
}

// Whether field read `ix` at string `rep` is of an atom-typed field its row stores as a string
// beside its base's arm (`strReppedLitUnionAt`), which legacy reads as that string.
function strRowAtomRead(ix: i32, rep: i32): boolean {
  return repPrim(rep) == "str" && strReppedLitUnionAt(ix, irBFnIx())
}

// The atom kid rep of narrowed record `r`'s field `n` that read `ix` takes at string `rep` because
// the read is itself a literal atom (the plain read's `atomStr`), or -1.
function narrowedAtomKid(r: i32, n: Member, ix: i32, rep: i32): i32 {
  if repPrim(rep) != "str" || !exprIsLitAtom(ix, irBFnIx()) { return -1 }
  const k = repRecordKidOf(r, repTyOf(r), n.memProp)
  if k < 0 { return -1 }
  const kr = repNodeKids(r)[k]
  return if repNodeAt(kr) is RAtom { kr } else { -1 }
}

// The read of closure field `k` of member `n` (at `ix`) whose recorded type is a hole function's:
// at the kid rep of the record the receiver is built at, typed as that rep.
function holeCloFieldRead(b: i32[], n: Member, ix: i32, k: i32): Opnd {
  const rv = irBExpr(b, n.memObj)
  if missed(rv) { return rv }
  const bks = repNodeKids(irBOpRep(rv))
  if !(repNodeAt(irBOpRep(rv)) is RRecord) || k >= bks.length {
    return irBMiss("hole closure field receiver")
  }
  const bk = bks[k]
  if !(repNodeAt(bk) is RClosure) { return irBMiss("hole closure field rep") }
  irBNoteFieldReread(ix, k)
  return irBLetTempTy(
    b,
    {
      gfV: rv,
      gfIx: k,
      gfAt: ix,
      gfStored: isStorageRead(ix),
      gfStr: false,
      gfShared: false,
    },
    ix,
    bk,
    repTyOf(bk),
  )
}

// Field read `ix` at its storage, the box its declared union holds, as legacy reads a narrowed
// field's receiver.
function storedBoxRead(b: i32[], ix: i32): Opnd {
  const mark = storageReadEnter(ix)
  const v = irBExpr(b, ix)
  storageReadLeave(mark)
  if missed(v) { return v }
  // A storage read is the field's declared box itself: a box, or a boxed nullable, whose null is a
  // tag of the same `{tag, payload}` struct (`heldAsBox`).
  if !heldAsBox(irBOpRep(v)) { return irBMiss("narrowed field receiver rep") }
  return v
}

// The type receiver `o` is built at: an open-typed call, a field of one, or a name, at the type
// `irBExpr` builds it at (`exprTyOf`); else its own type.
function builtRecvTy(o: i32): i32 {
  const u = unwrapParen(o)
  const t = nodeTyAt(u, irBFnIx())
  if u < 0 || !irTyOpen(t) { return t }
  const un = nodeAt(u)
  return if un is Call || un is Member || un is Ident { exprTyOf(u) } else { t }
}

// A member read, routed by its receiver's rep: a record's own `length` field never reaches a
// list or string arm.
function buildMember(b: i32[], ix: i32, rep: i32): Opnd {
  const n = nodeAt(ix)
  if !(n is Member) { return irBMiss("expression") }
  // A `.length` legacy takes per arm of a box of lists or maps (`memberLengthArmOf`).
  if (
    n.memProp == "length"
    && memberLengthArmOf(n, ix, irBFnIx()) == "armSite"
    && armSiteReads(ix, irBFnIx())
  ) {
    return armSiteRead(b, ix, rep)
  }
  // A receiver held at legacy's declared row (`declRowReadTy`) is read at that row.
  const dt = declRowReadTy(n.memObj)
  const ot = if dt >= 0 { dt } else { builtRecvTy(n.memObj) }
  // A hole receiver is read at the rep its parameter is held at (`irBOpenLocalReadRep`).
  const r0 = repNodeOfTy(ot)
  const hr = if repNodeAt(r0) is RUnsup { holeRecvBox(irBOpenLocalReadRep(n.memObj)) } else { -1 }
  const r = if hr >= 0 { hr } else { r0 }
  // A call whose result type is open (an empty `[]`'s element) returns the list its callee's
  // result descriptor names (`resultFrameTy`): its `.length` reads the list as built.
  if (
    repNodeAt(r) is RUnsup
    && n.memProp == "length"
    && nodeAt(unwrapParen(n.memObj)) is Call
  ) {
    const cv = irBExpr(b, n.memObj)
    if missed(cv) || !(cv is OVar) {
      return irBMiss("open list length receiver")
    }
    const cr = irBOpRep(cv)
    if !(repNodeAt(cr) is RList) || !refRepOk(cr, -1) {
      return irBMiss("open list length rep")
    }
    return irBLetTemp(b, { llV: cv, llAt: ix }, ix, rep)
  }
  // A plain field read off a nullable record (a guarded compare's field read, `recEqTyped`) reads
  // the record inside: `struct.get` takes the nullable reference, whose null the guard rules out.
  const rn = repNodeAt(r)
  if rn is RNullable && repNodeAt(rn.rnInner) is RRecord {
    return nullRecvField(b, n, ix, rep, r, rn.rnInner)
  }
  if repNodeAt(r) is RList {
    if n.memProp != "length" { return irBMiss("list member") }
    if !refRepOk(r, -1) { return irBMiss("list length rep") }
    const v = irBExpr(b, n.memObj)
    if missed(v) || !(v is OVar) { return irBMiss("list length receiver") }
    return irBLetTemp(b, { llV: v, llAt: ix }, ix, rep)
  }
  // A map's `length` is its live entry count, read after the receiver as legacy reads it.
  if repNodeAt(r) is RMap && mapLengthPlain(n, ix, irBFnIx()) {
    const mv = irBExpr(b, n.memObj)
    if missed(mv) { return mv }
    return irBLetTemp(b, { mpOp: "size", mpArgs: [mv], mpAt: ix }, ix, rep)
  }
  // An atom's `.length` is its member string's: the atom decoded, then the string's length, as
  // legacy's `atomStr` arm widens it (`memberLengthArmOf`).
  if (
    repNodeAt(r) is RAtom
    && n.memProp == "length"
    && memberLengthArmOf(n, ix, irBFnIx()) == "atomStr"
  ) {
    const dv = deliverStr(b, n.memObj)
    if missed(dv) { return dv }
    if repPrim(irBOpRep(dv)) != "str" { return irBMiss("atom length decode") }
    return irBLetTemp(b, { llV: dv, llAt: ix }, ix, rep)
  }
  if repPrim(r) == "str" {
    if n.memProp != "length" { return irBMiss("string member " + n.memProp) }
    const sv = irBExpr(b, n.memObj)
    if missed(sv) || !(sv is OVar || sv is OStr) {
      return irBMiss("string length receiver")
    }
    return irBLetTemp(b, { llV: sv, llAt: ix }, ix, rep)
  }
  // A plain field read off a struct or a bare variant.
  const fnIx = irBFnIx()
  // A read whose recorded kind is not its field's (`structFieldAt`) is read at the field as stored.
  const unrec = structFieldAt(ix, fnIx) >= 0 && structFieldPlain(ix, fnIx) < 0
  const plain = variantFieldPlain(ix, fnIx) >= 0
    || structFieldPlain(ix, fnIx) >= 0
    || nulVariantFieldPlain(ix, fnIx) >= 0
    || structFieldAt(ix, fnIx) >= 0
    || ifJoinRecv(n.memObj)
  // A read legacy records no field arm for, and no narrowed one (`narrowedFieldPlain`), is read
  // off its receiver's row (`irOpRow`), where the receiver carries one that holds the field (D17666).
  const byRow = !plain
    && repNodeAt(r) is RRecord
    && repRecordKidOf(r, ot, n.memProp) >= 0
    && narrowedFieldPlain(ix, fnIx) < 0
  if repNodeAt(r) is RRecord && (plain || byRow) {
    const k = repRecordKidOf(r, ot, n.memProp)
    if k < 0 { return irBMiss("field kid") }
    // A union-box field's tail unboxes it to the read's own rep.
    const own = memFieldUnionBox(ix, fnIx)
      && rep == repNodeOfTy(nodeTyAt(ix, fnIx))
    const kr = repNodeKids(r)[k]
    const krn = repNodeAt(kr)
    // A `null` unit read is built for its effect and dropped (`nulUnitPlaceRead`).
    const dropped = repPrim(rep) == "null"
    if (
      unrec
      && kr != rep
      && !(krn is RNullable && krn.rnInner == rep)
      && !dropped
    ) {
      return irBMiss("unrecorded field read at another rep")
    }
    // A hole function's field reads at the closure rep the built record holds (`holeCloTy`).
    if holeCloTy(nodeTyAt(ix, fnIx)) && repNodeAt(kr) is RClosure {
      return holeCloFieldRead(b, n, ix, k)
    }
    // A nullable field the checker narrowed past its null reads at its inner rep: legacy's field
    // tail writes the read's recover (`readOwesNonNullRecover`), as for any member read.
    const kn = repNodeAt(kr)
    const narrowed = kn is RNullable && kn.rnInner == rep
    // An atom field read as its literal's string is read at the atom; its consumer decodes it.
    const atomStr = kn is RAtom
      && repPrim(rep) == "str"
      && !own
      && exprIsLitAtom(ix, fnIx)
    // A literal set stored as its string and read as its atom is read at the string it is.
    const strAtom = repPrim(kr) == "str" && repNodeAt(rep) is RAtom && !own
    // A sub-word field (`repSubWord`) reads into an i32, extended as its width is signed.
    const subWord = repSubWord(kr) && repPrim(rep) == "i32" && !own
    // A field whose stored kid rep is not the read's own is read at the kid, as legacy reads the
    // stored row; its consumer takes the temp at that rep.
    const atKid = kr != rep
      && !own
      && !narrowed
      && !atomStr
      && !strAtom
      && !subWord
    // The box read below, declined before its receiver is built where it reaches D17076.
    const nullBox = own
      && repPrim(rep) == "null"
      && unionBoxTailLeavesBox(ix, fnIx)
    if nullBox && letListElement(n.memObj) {
      return irBMiss("box field of a let list's element")
    }
    const rv = irBExpr(b, n.memObj)
    if missed(rv) { return rv }
    if byRow && irOpRow(irBFn(), rv) < 0 { return irBMiss("member record") }
    // The row the read's record value is laid out at: the receiver row's field target.
    const tgRow = irBRowFieldTarget(rv, n.memProp)
    // A receiver held at its storage row (D14426) reads that row's field, where it holds the read's
    // own rep or the union box the read unboxes, at the row's own slot (a twin may permute them).
    const sk = if irBOpRep(rv) == r { k } else { storedRowKid(n, irBOpRep(rv), fnIx) }
    const skr = if sk >= 0 { repNodeKids(irBOpRep(rv))[sk] } else { -1 }
    if sk < 0 { return irBMiss("field read of a stored row") }
    irBNoteFieldReread(ix, sk)
    const ur = if own { irBUnboxKindRep(unionFieldUnboxKindOf(ix, fnIx), rep) } else { rep }
    const sn = repNodeAt(skr)
    const boxRead = sn is RNullable
      && sn.rnDisc == 4
      && (rep == sn.rnInner || repPrim(rep) == "null")
    // A stored row's union box under a plain read of the same field: legacy's tail unboxes it.
    const boxUnbox = sn is RBox && kr == rep
    if skr != kr && own && !boxRead && !boxUnbox {
      return irBMiss("field read of a stored row's box")
    }
    // A read at its storage (an `is` receiver's raw slot) is the stored row's box; one the read's
    // type does not name is no box this read holds.
    if isStorageRead(ix) && repNodeAt(skr) is RBox && rep != skr {
      return irBMiss("storage read of a wider row's box")
    }
    const gf: Rhs = {
      gfV: rv,
      gfIx: sk,
      gfAt: ix,
      gfStored: isStorageRead(ix),
      gfStr: ur != rep,
      gfShared: false,
    }
    if ur != rep { return irBLetStrTemp(b, gf, ix) }
    // A box stored at a wider record's members is read rebuilt at the read's own union
    // (`memReadBoxNarrowTy`, D3006), which legacy's field tail writes after the field.
    const ownTy = nodeTyAt(ix, fnIx)
    if (
      !isStorageRead(ix)
      && memReadBoxNarrowTy(ix, fnIx) >= 0
      && repNodeAt(skr) is RBox
      && ownTy >= 0
      && repNodeAt(repNodeOfTy(ownTy)) is RBox
    ) {
      return irBLetTempTy(b, gf, ix, repNodeOfTy(ownTy), ownTy)
    }
    if atomStr || strAtom { return irBLetTempTy(b, gf, ix, kr, repTyOf(kr)) }
    // The read at the kid is at the operand's own stored row (`skr`), the row legacy reads.
    if atKid {
      return irBNoteRow(irBLetTempTy(b, gf, ix, skr, repTyOf(skr)), tgRow)
    }
    // A `null`-typed read whose field tail leaves the box writes nothing after it: the read is
    // that box, the `null` member nothing unboxes to.
    if (
      own
      && repPrim(rep) == "null"
      && (sn is RBox || boxRead)
      && unionBoxTailLeavesBox(ix, fnIx)
    ) {
      return irBLetTempTy(b, gf, ix, skr, repTyOf(skr))
    }
    if skr != kr && !own {
      return irBNoteRow(irBLetTempTy(b, gf, ix, skr, repTyOf(skr)), tgRow)
    }
    // A raw read at the field's storage (`rawFieldRepOf`) is typed at that rep.
    if rep == kr && rep != repNodeOfTy(nodeTyAt(ix, fnIx)) {
      return irBLetTempTy(b, gf, ix, rep, repTyOf(rep))
    }
    return irBNoteRow(irBLetTemp(b, gf, ix, rep), tgRow)
  }
  // A field read off a box local narrowed to one variant.
  const idx = narrowedFieldPlain(ix, irBFnIx())
  if repNodeAt(r) is RRecord && idx >= 0 {
    if narrowedFieldIsUnionBox(ix, irBFnIx()) {
      if !narrowUnboxRepIs(ix, r, n, rep) {
        // A boxed nullable on another box than the field's is the narrower refusal.
        if boxedNullable(rep) {
          return irBMiss("narrowed field unbox nullable disc")
        }
        return irBMiss("narrowed field unbox rep")
      }
    } else if (
      !fieldReadsAt(r, n, rep)
      && !strRowAtomRead(ix, rep)
      && narrowedAtomKid(r, n, ix, rep) < 0
    ) {
      return irBMiss("narrowed field read coercion")
    }
    const bv = if nodeAt(n.memObj) is Ident { irBBoxLocal(b, n.memObj) } else { storedBoxRead(b, n.memObj) }
    if missed(bv) { return bv }
    // A literal atom field read at its string is read at the atom, as the plain read's `atomStr`.
    const ak = narrowedAtomKid(r, n, ix, rep)
    if ak >= 0 && !fieldReadsAt(r, n, rep) {
      return irBLetTempTy(b, { bfV: bv, bfAt: ix }, ix, ak, repTyOf(ak))
    }
    // A raw read at the field's storage (`rawFieldRepOf`) is typed at that rep.
    if rep != repNodeOfTy(nodeTyAt(ix, irBFnIx())) {
      return irBLetTempTy(b, { bfV: bv, bfAt: ix }, ix, rep, repTyOf(rep))
    }
    return irBLetTemp(b, { bfV: bv, bfAt: ix }, ix, rep)
  }
  // A shared field read over an un-narrowed box local, on legacy's plain dispatch.
  if repNodeAt(r) is RBox && sharedReadPlainOf(ix, irBFnIx()) {
    const openRead = repNodeAt(repNodeOfTy(nodeTyAt(ix, irBFnIx()))) is RUnsup
      && rep == openMemberRep(ix)
    // A lone literal tag every arm stores as an atom is read at that atom (`exprTyOf`).
    const atomRead = repNodeAt(rep) is RAtom && rep == repNodeOfTy(exprTyOf(ix))
    if rep != repNodeOfTy(nodeTyAt(ix, irBFnIx())) && !openRead && !atomRead {
      return irBMiss("shared read rep")
    }
    // The tail decides the read's rep: an unbox leaves its atom's, nothing else changes the box.
    const vis: i32[] = []
    const fis: i32[] = []
    const code = sharedReadPlanOf(ix, irBFnIx(), vis, fis)
    const tail = sharedReadTailOf(code, vis, fis, ix, irBFnIx())
    if tail == SRT_NARROW { return irBMiss("shared read narrow unbox") }
    if tail >= 0 && !irBAtomKindRep(tail, rep) {
      return irBMiss("shared read tail rep")
    }
    const stash = sharedReadStashes(ix)
    // Unstashed, legacy pushes the receiver's box once per arm: a global's is its read again.
    if !stash && localIndexOf(irBFnIx(), n.memObj) < 0 {
      const g = irBGlobalBoxRecv(n.memObj)
      if g < 0 { return irBMiss("shared read global receiver") }
      const none: Opnd = { oiRep: irBNoValue(), oiBits: 0 }
      const gr: Rhs = {
        srV: none,
        srAt: ix,
        srStash: false,
        srGlobal: g,
        srGlobalNonNull: irBGlobalBoxRecovers(n.memObj),
      }
      // Legacy writes the whole dispatch again where it reads the field again.
      irBNoteReadAgain(ix, gr)
      return irBLetTemp(b, gr, ix, rep)
    }
    const sv = if stash { irBExpr(b, n.memObj) } else { irBBoxLocal(b, n.memObj) }
    if missed(sv) { return sv }
    if stash && !(repNodeAt(irBOpRep(sv)) is RBox) {
      return irBMiss("shared read receiver rep")
    }
    const sr: Rhs = {
      srV: sv,
      srAt: ix,
      srStash: stash,
      srGlobal: -1,
      srGlobalNonNull: false,
    }
    // Over a box variable, the whole dispatch is written again where the field is read again.
    if (
      !stash
      && sv is OVar
      && sv.ov >= 0
      && irBFn().irVars[sv.ov].vKind != "temp"
    ) {
      irBNoteReadAgain(ix, sr)
    }
    if openRead { return irBLetTempTy(b, sr, ix, rep, repTyOf(rep)) }
    return irBLetTemp(b, sr, ix, rep)
  }
  // A grow candidate's arm turns on legacy's emit-time stash read, which the IR never asks.
  if (
    n.memProp == "length"
    && memberLengthArmOf(n, ix, irBFnIx()) == "growCandidate"
  ) {
    return irBMiss("member length grow candidate")
  }
  return irBMiss("member " + repWhat(r))
}

// A string `+` chain, `==`/`!=` or ordering, its operands built in legacy's push order: an
// equality's quoted literal is its second operand, and an ordering may push right first.
function buildStrBin(b: i32[], ix: i32, rep: i32): Opnd {
  const n = nodeAt(ix)
  if !(n is BinExpr) { return irBMiss("expression") }
  const fnIx = irBFnIx()
  let op: StrOp = "concat"
  let at = ix
  let parts: i32[] = []
  if exprIsStrConcat(ix, fnIx) {
    parts = strCatPartsOf(ix, fnIx)
    // An armed site's right side joins in place; its node is keyed by the assignment.
    const site = strSiteOfRhsAsked(ix, fnIx)
    if site >= 0 {
      op = "site"
      at = site
    }
  } else if exprIsStrEq(ix, fnIx) {
    op = "eq"
    const lit = strEqLitOf(ix, fnIx)
    // A quoted literal is the second operand; an atom-typed one widens in legacy's writer.
    if lit >= 0 && exprIsLitAtom(lit, fnIx) {
      return irBMiss("atom literal operand")
    }
    parts.push(strEqFirstOf(n, lit))
    parts.push(if lit < 0 { n.binRight } else { lit })
  } else if exprIsStrOrder(ix, fnIx) {
    op = "lt"
    const swap = strOrderSwaps(n)
    parts = if swap { [n.binRight, n.binLeft] } else { [n.binLeft, n.binRight] }
  } else {
    return irBMiss("operand at string")
  }
  const args: Opnd[] = []
  const starts: i32[] = []
  for p in parts {
    const from = b.length
    // Each part arrives a string (`strPartAt`).
    const a = strPartAt(b, p)
    if missed(a) { return a }
    // Legacy writes every operand in place, so a valued `if` past the first sits above the others.
    if args.length > 0 && !irBStageLeads(b, from, starts, args, parts) {
      return irBMiss("string operand after another")
    }
    starts.push(from)
    if repPrim(irBOpRep(a)) != "str" {
      return irBMiss("string operand coercion")
    }
    args.push(a)
  }
  return irBLetTemp(b, { soOp: op, soArgs: args, soAt: at }, ix, rep)
}

// Whether compare `ix` is legacy's union compare over two boxes: its staged compare, or on
// `eqRouteOf`'s `unionUnion` over two named operands, the struct union arm of `unionUnionEqArmOf`.
// An identity compares two boxes only on that route; its other routes are by reference.
function unionEqOf(ix: i32, fnIx: i32): boolean {
  const n = nodeAt(ix)
  if !(n is BinExpr) { return false }
  if n.binIdent != 0 && eqRouteOf(n, ix, fnIx) != "unionUnion" { return false }
  if unionUnionEqStagedOf(n, fnIx) { return true }
  if eqRouteOf(n, ix, fnIx) != "unionUnion" { return false }
  if unionEqNameless(n.binLeft, fnIx) || unionEqNameless(n.binRight, fnIx) {
    return false
  }
  const arms: i32[] = []
  const vis: i32[] = []
  const aks: i32[] = []
  return unionUnionEqArmOf(n.binLeft, n.binRight, fnIx, arms, vis, aks)
    == "struct"
}

function listEqOf(ix: i32, fnIx: i32): boolean {
  const n = nodeAt(ix)
  return n is BinExpr && listEqRouteOf(n, ix, fnIx)
}

function listCatOf(ix: i32, fnIx: i32): string {
  const n = nodeAt(ix)
  return if n is BinExpr { listCatRouteOf(n, ix, fnIx) } else { "none" }
}

// Installs the list builder, lowering and rule 8; run once before emit.
export function irRefInstall() {
  irVarRepOkHook = refRepOk
  irIndexHook = buildIndex
  irMemberHook = buildMember
  irArmSiteHook = armSiteRead
  irOpenMemberRepHook = openMemberRep
  irStrBinHook = buildStrBin
  irInPlaceHook = strInPlaceModeAsked
  irUnionEqHook = unionEqOf
  irListEqHook = listEqOf
  irListCatHook = listCatOf
  irLowerListHook = irLowerRefList
  irLowerEffectHook = irLowerRefEffect
  irNodeInShadowHook = irNodeInShadow
  irLowerListSetHook = irLowerRefListSet
  irLowerBoundsHook = irLowerRefBounds
  irLoopOpenHook = irLowerRefLoopOpen
  irLoopCloseHook = irLowerRefLoopClose
  irBoundsRuleHook = irBoundsRule
  return 0
}

// The kid of stored row `sr` that member read `n` reads, or -1 where legacy reads another row:
// legacy reads the receiver's struct row (`structIndexOfExpr`), the row `sr` is stored under.
function storedRowKid(n: Member, sr: i32, fnIx: i32): i32 {
  if !(repNodeAt(sr) is RRecord) { return -1 }
  // A receiver whose own type has no row (`structIndexOfExpr` -1) is only ever held at its storage
  // row, so that row's field of the name is the one it reads.
  const si = structIndexOfExpr(n.memObj, fnIx)
  if si >= 0 && !repStructRowIsOrTwin(repTyOf(sr), si) { return -1 }
  return repRecordKidOf(sr, repTyOf(sr), n.memProp)
}

// The rep of shared field read `ix` off a hole parameter held as a box, where every arm stores the
// field at one scalar type and no tail changes it; -1 otherwise.
function openMemberRep(ix: i32): i32 {
  const n = nodeAt(ix)
  if !(n is Member) { return -1 }
  const r = holeRecvBox(irBOpenLocalReadRep(n.memObj))
  if r < 0 || !(repNodeAt(r) is RBox) || !sharedReadPlainOf(ix, irBFnIx()) {
    return -1
  }
  const vis: i32[] = []
  const fis: i32[] = []
  const code = sharedReadPlanOf(ix, irBFnIx(), vis, fis)
  if sharedReadTailOf(code, vis, fis, ix, irBFnIx()) != SRT_NONE { return -1 }
  const t = variantFieldTypeAt(vis[0], fis[0])
  let i = 1
  while i < vis.length {
    if variantFieldTypeAt(vis[i], fis[i]) != t { return -1 }
    i = i + 1
  }
  const fr = if t >= 0 { repNodeOfTy(t) } else { -1 }
  return if fr >= 0 && repPrim(fr) != null { fr } else { -1 }
}

// A hole receiver's rep `r` as a field read takes it: a nullable box is the box its read is narrowed
// to past the null (a `?.` operand), which the box read recovers; any other rep as it stands.
function holeRecvBox(r: i32): i32 {
  if r < 0 { return r }
  const n = repNodeAt(r)
  return if n is RNullable && repNodeAt(n.rnInner) is RBox { n.rnInner } else { r }
}

// Whether `ix` reads an element of a `let`-bound list, which a branch may reassign (D17076).
function letListElement(ix: i32): boolean {
  const e = nodeAt(unwrapParen(ix))
  if !(e is Index) || !(nodeAt(unwrapParen(e.idxArr)) is Ident) { return false }
  const d = identDeclOf(unwrapParen(e.idxArr))
  if d < 0 { return false }
  const dn = nodeAt(d)
  return dn is LetDecl && dn.letKw == "let"
}

// Whether receiver `ox` is a value `if`: a record join's field is read off the row its out is built
// at, where legacy's field plans name no struct for it.
function ifJoinRecv(ox: i32): boolean {
  return nodeAt(unwrapParen(ox)) is IfStmt
}
