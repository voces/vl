// The identity shadow's switch, its notes and its report (`$VL_ID_SHADOW`): which declaration
// or lambda each function-valued read would be the singleton `Fn#d` of, recorded beside the
// checker and read by no pass. Mode 0 records nothing, 1 records and reports, and 2 also keys
// callback specialization by it (`emit_id_shadow.vl`).

let idShadowMode = 0
let idShadowReads: {[i32]: boolean} = Map()
let idShadowRows: string[] = []

// Arms the shadow at mode `v` (0, 1 or 2) for this compile, emptying the last one's notes; 0 on
// success.
export function setIdShadow(v: i32): i32 {
  idShadowMode = v
  idShadowReads = Map()
  idShadowRows = []
  0
}

export function idShadowModeOf(): i32 { idShadowMode }

// Notes node `ix` as a function-valued read: a non-callee name or a lambda literal.
export function idShadowNote(ix: i32) {
  if idShadowMode > 0 && ix >= 0 { idShadowReads[ix] = true }
}

// The nodes noted as function-valued reads.
export function idShadowReadNodes(): i32[] {
  const out: i32[] = []
  for k in idShadowReads.keys() { out.push(k) }
  out
}

export function idShadowRow(s: string) {
  if idShadowMode > 0 { idShadowRows.push(s) }
}

// The report rows, read by the host one code unit at a time.
export function idShadowCount(): i32 { idShadowRows.length }

export function idShadowLen(i: i32): i32 { idShadowRows[i].length }

export function idShadowAt(i: i32, j: i32): i32 { idShadowRows[i][j] }
