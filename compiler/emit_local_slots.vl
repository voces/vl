import { nodeTyIxOf } from "./check_node_tys"
import { tySameSealed } from "./emit_ty_seal"
import { tySameKey } from "./check_types"
import { uVarTyIx, uVarTyIxResets, unVarCount, unVarStart } from "./emit_state"

// `emit_local_slots.vl` — the emitter's local slots: the declaration a slot binds, a read's
// module-level `let`, a variant spelling, and the push/pop bits a scope carries.

import { IfStmt, LetDecl, P, StrLit, nodeAt } from "./ast"
import { litUnionAliasNameOfTy } from "./check_types"
import { unwrapParen } from "./emit_base"
import { nodeTyAt } from "./emit_capture_frames"
import { ifArmValueExpr } from "./emit_query"
import {
  VKind,
  collectByNode,
  exprArmLocalsAny,
  globalIndexBySid,
  globalStmts,
  localByNode,
  localDeclIx,
  localFrameNote,
  localIsRef,
  localLoopIter,
  localLoopVar,
  localPairIter,
  localSlotOfDecl,
  localStructIdx,
  localUnset,
} from "./emit_state"
import { declOrigOf, identDeclOf, sidArrGet, sidOfNode } from "./symbols"

// The arena index of the `LetDecl` for the global symbol `sid`, or -1.
export function globalLetOfSid(sid: i32) {
  const gi = sidArrGet(globalIndexBySid, sid)
  if gi < 0 { return -1 }
  return globalStmts[gi]
}

// The module global the name read `readIx` denotes, or -1: the global its declaration is, or
// the one of its name when a rewrite minted the read with no declaration.
export function globalLetOfDeclRead(readIx: i32) {
  if readIx < 0 { return -1 }
  const li = globalLetOfSid(sidOfNode(readIx))
  if li < 0 { return -1 }
  const d = identDeclOf(readIx)
  if d < 0 || d == li || declOrigOf(d) == li { return li }
  return -1
}

// Append a fresh declared-local slot — one wasm local per lexical binding, so two same-named
// `let`s in disjoint branches get distinct slots and distinct valtypes. `structIdx` is the
// local's struct table index when it is a ref, else -1. Returns the new slot's position (its
// wasm index is `paramCount + pos`).
export function addLocalSlot(isRef: VKind, structIdx: i32) {
  const pos = localIsRef.length
  localFrameNote()
  localIsRef.push(isRef)
  localStructIdx.push(structIdx)
  localLoopVar.push(0)
  localLoopIter.push(-1)
  localPairIter.push(-1)
  localDeclIx.push(-1)
  localUnset.push(0)
  // Filled only while some arm local is allocated by node; empty, the cursor never steps over.
  if exprArmLocalsAny {
    let byNode = 0
    if collectByNode > 0 { byNode = 1 }
    localByNode.push(byNode)
  }
  return pos
}

// Pin the declaration (`LetDecl`, a for-in `LoopVar` or a `ForRange`) that declared the slot,
// both ways: the slot answers for its declaration, and a read finds its slot through it.
export function markLocalDecl(slot: i32, declIx: i32) {
  if (
    slot < 0
    || slot >= localDeclIx.length
    || declIx < 0
    || declIx >= P.nodes.length
  ) {
    return 0
  }
  localFrameNote()
  localDeclIx[slot] = declIx
  localSlotOfDecl[declIx] = slot
  const o = declOrigOf(declIx)
  if o >= 0 { localSlotOfDecl[o] = slot }
  const d = nodeAt(declIx)
  if d is LetDecl && d.letInit < 0 { localUnset[slot] = 1 }
  return 0
}

// The `LetDecl` local `slot` holds, or -1 for a loop variable, a temp or an out-of-range slot.
export function slotLetDecl(slot: i32): i32 {
  if slot < 0 || slot >= localDeclIx.length { return -1 }
  const d = localDeclIx[slot]
  if d < 0 || !(nodeAt(d) is LetDecl) { return -1 }
  return d
}

// Mark the declared-local slot as a loop variable. A loop var's scope is the loop: while it is
// live the scope stack resolves it, and once its loop closes it must not be resolvable again —
// and a read reaches its slot through its declaration, so the flag is for the readers that ask
// of a slot whether it is a loop variable.
export function markLoopVarSlot(slot: i32) {
  localLoopVar[slot] = 1
  return 0
}

// Mark the declared-local slot as a for-in element loop variable and pin the iterable node its
// loop iterates, so a question only the iterable can answer resolves from the slot the scope
// stack hands out rather than from the loop var's name. The `for`-counter form has no iterable
// and keeps the plain `markLoopVarSlot`.
export function markLoopVarIter(slot: i32, iterIx: i32) {
  localLoopVar[slot] = 1
  localLoopIter[slot] = iterIx
  return 0
}

// Pin the map a `for k, v in m` walk iterates on the slot its second name binds, so the
// value's union member set resolves from the map's vals slot as `.values()`'s would.
export function markPairVarIter(slot: i32, iterIx: i32) {
  if slot >= 0 { localPairIter[slot] = iterIx }
  return 0
}

// The `.push` and `.pop` element-kind selector threaded through the reservation walkers.
// `pop` only uses i32, ref and str.
export type PushKind = "i32" | "ref" | "str" | "f64" | "i64" | "f32" | "u8"

// True when the value `if` at `ix` meets an atom destination arm by arm: each arm's value is
// narrowed where it is produced, so no arm is widened to a string and narrowed back, and the
// join itself is never staged. An else-less `if` is a nullable value and is not a member.
export function ifJoinNarrowsPerArm(ix: i32): boolean {
  if ix < 0 { return false }
  const n = nodeAt(ix)
  if n is IfStmt { return n.ifElse >= 0 }
  return false
}

// True when every value of the `if` chain at `ix` is a string literal, as a generic body's join
// is that the checker typed `string` while its pin's destination is a literal union (D3423).
export function ifJoinArmsAllStrLit(ix: i32): boolean {
  if !ifJoinNarrowsPerArm(ix) { return false }
  const todo: i32[] = [ix]
  let guard = 0
  while todo.length > 0 {
    guard = guard + 1
    if guard > 64 { return false }
    const at = unwrapParen(todo.pop() ?? -1)
    if at < 0 { return false }
    const a = nodeAt(at)
    if a is IfStmt {
      if a.ifElse < 0 { return false }
      todo.push(ifArmValueExpr(a.ifThen))
      if nodeAt(a.ifElse) is IfStmt {
        todo.push(a.ifElse)
      } else {
        todo.push(ifArmValueExpr(a.ifElse))
      }
    } else if !(a is StrLit) {
      return false
    }
  }
  return true
}

// True when the value `if` at `ix` records a registered literal-union type, so it is an atom
// whatever its arms' own reps are: every arm is lowered in the atom context, and a binding of
// it takes the atom slot its type names (D2206). Asked by member set, as a binding's rep is: a
// join mints a fresh index even when its set is a declared alias's (D2208).
export function ifJoinTypedAtom(ix: i32, fnIx: i32): boolean {
  if !ifJoinNarrowsPerArm(ix) { return false }
  return litUnionAliasNameOfTy(nodeTyAt(ix, fnIx)) != ""
}

// The variant row of union row `u` whose member is exactly checked type `armTy`, or -1. A tag is
// keyed by the member's checked type within its union, never by the member's rep row.
export function unionArmRowOfTy(u: i32, armTy: i32): i32 {
  if u < 0 || u >= unVarStart.length || u >= unVarCount.length || armTy < 0 {
    return -1
  }
  let v = unVarStart[u]
  while v < unVarStart[u] + unVarCount[u] {
    if (
      v < uVarTyIx.length
      && uVarTyIx[v] >= 0
      && tySameSealed(uVarTyIx[v], armTy)
    ) {
      return v
    }
    v = v + 1
  }
  return -1
}

// `unionArmRowOfTy` for every arm in `arms`, appended to `rows` in order. Past a few rows, each
// arm is compared only with the rows whose `tySameKey` it shares, plus every row that has none,
// so a union of `n` record arms costs `n` keys rather than `n * n` comparisons.
export function unionArmRowsOfTys(u: i32, arms: i32[], rows: i32[]) {
  if (
    u < 0
    || u >= unVarStart.length
    || u >= unVarCount.length
    || unVarCount[u] <= 8
  ) {
    for a in arms { rows.push(unionArmRowOfTy(u, a)) }
    return 0
  }
  const byKey: {[i32]: i32[]} = Map()
  const wild: i32[] = []
  let v = unVarStart[u]
  while v < unVarStart[u] + unVarCount[u] {
    if v < uVarTyIx.length && uVarTyIx[v] >= 0 {
      const k = tySameKey(uVarTyIx[v])
      if k < 0 {
        wild.push(v)
      } else {
        const at = byKey[k] ?? []
        at.push(v)
        byKey[k] = at
      }
    }
    v = v + 1
  }
  for a in arms {
    const k = if a < 0 { -1 } else { tySameKey(a) }
    if k < 0 {
      rows.push(unionArmRowOfTy(u, a))
    } else {
      rows.push(armRowIn(byKey[k] ?? [], wild, a))
    }
  }
  return 0
}

// The first row, in row order across the two ascending lists, whose member is `tySame` as `a`.
function armRowIn(xs: i32[], ws: i32[], a: i32): i32 {
  let i = 0
  let j = 0
  while i < xs.length || j < ws.length {
    let v = -1
    if j >= ws.length || i < xs.length && xs[i] < ws[j] {
      v = xs[i]
      i = i + 1
    } else {
      v = ws[j]
      j = j + 1
    }
    if tySameSealed(uVarTyIx[v], a) { return v }
  }
  return -1
}

// The first variant row whose member is exactly checked type `ty`, or -1. Rows sharing that type
// share its heap, so this answers a heap question, never a tag.
export function exactArmRowOfTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  if (
    exactRowGen != uVarTyIxResets
    || exactRowUpTo != 0 && exactRowUpTo > uVarTyIx.length
  ) {
    exactRowMemo = Map()
    exactRowGen = uVarTyIxResets
    exactRowUpTo = 0
  }
  // Rows are only appended between resets: index each new row's type once, first row kept.
  while exactRowUpTo < uVarTyIx.length {
    const t = uVarTyIx[exactRowUpTo]
    if t >= 0 && !exactRowMemo.has(t) { exactRowMemo[t] = exactRowUpTo }
    exactRowUpTo = exactRowUpTo + 1
  }
  const firstRow = exactRowMemo[ty] ?? -1
  if firstRow >= 0 { return firstRow }
  let v = 0
  while v < uVarTyIx.length {
    if uVarTyIx[v] >= 0 && tySameSealed(uVarTyIx[v], ty) { return v }
    v = v + 1
  }
  return -1
}

// `exactArmRowOfTy`'s index: each type's first row, over rows below `exactRowUpTo`, valid while
// `exactRowGen` is `uVarTyIxResets`.
let exactRowMemo: {[i32]: i32} = Map()
let exactRowGen = -1
let exactRowUpTo = 0

// The variant row of the record annotation node `ann`, by its recorded type; -1 for a node with
// none.
export function annDeclVariantRow(ann: i32): i32 {
  return exactArmRowOfTy(nodeTyIxOf(ann))
}
