// Numeric operator typing over a numeric union, and literal adoption: the tails of a value
// join, an `f32` peer, and a literal tree taking its destination's width.
// Does not import the checker.
import {
  ArrayLit,
  BinExpr,
  Block,
  FieldInit,
  IfStmt,
  MatchExpr,
  NumLit,
  ObjLit,
  P,
  Paren,
  Spread,
  Unary,
  nodeAt,
} from "./ast"
import { inferQuiet } from "./check_cursor"
import {
  elabCapLive,
  elabCapNote,
  elabLiveTyOf,
  stampsStand,
} from "./check_elab_cap"
import { litPinN } from "./check_literals"
import { nodeTyIx, nodeTyOf, nodeTySet } from "./check_node_tys"
import {
  binFloatOperandPair,
  binIntOnlyOp,
  cexCountBelow,
  cmpF32LitAdopts,
  isExactF64IntLitExpr,
  isF32AdoptingLitExpr,
  litTreeOps,
  litTreeWideTy,
  numLitDstTy,
  numLitOwnTy,
  numUnionMembersOf,
  radixLitCastFloatTy,
  radixLitTreeAt,
} from "./check_num_lits"
import { parenPeelIx } from "./check_places"
import { cexEvalAt, cexKeptF32Tree } from "./check_num_lit_state"
import { cexDecText, cexOk } from "./const_exact"
import { numLexFitsI32 } from "./emit_bignum"
import { mixesNumeric, widerNumeric } from "./check_ty_relate"
import {
  isNumericPrimTy,
  nonNullTy,
  primNameOf,
  sameNumeric,
  tyHoldsNonI32Num,
} from "./tyquery"
import {
  T,
  TY_BOOL,
  TY_F64,
  TY_I64,
  TyArray,
  TyLit,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  objFieldType,
  tyAt,
  tyElemOf,
  tyMapMinted,
  tyNumScalarBaseName,
  tySame,
  tyWideUnionMinted,
} from "./check_types"
import {
  tailPushBlockTail,
  tailPushIfArms,
  tailPushMatchArms,
} from "./check_unconsumed"
import { mkUnionTy } from "./check_union_mint"
import { cwPeel } from "./check_write_scan"

// The type an integer literal of an operator tree adopted from its destination or a wide peer
// (`litTreeAdopt`), parallel to `nodeTyIx`; -1 where none did. Read by `checkNodeReal` so a
// re-check keeps the width (D2709).
export let litTreeTy: i32[] = []

// Whether `op` is a comparison, which answers boolean for every member pair.
export function numCmpOp(op: string): boolean {
  return op == "<"
    || op == ">"
    || op == "<="
    || op == ">="
    || op == "=="
    || op == "!="
}

// The type of `a op b` at one member pair, by the rule a scalar pair takes, or -1 when that
// rule refuses the pair. `n` supplies the operand nodes, so a literal adapts as it does alone.
export function numPairTy(n: BinExpr, a: i32, b: i32): i32 {
  const t = numPairOpTy(n, a, b)
  if t < 0 || !numCmpOp(n.binOp) { return t }
  return TY_BOOL
}

// Whether `a op b` pairs an `f64` with a radix tree computed at 64 bits, which converts to the
// `f64` (D16390).
export function radixTreeF64Pair(n: BinExpr, a: i32, b: i32): boolean {
  return primNameOf(a) == "f64" && b == TY_I64 && radixLitTreeAt(n.binRight)
    || primNameOf(b) == "f64" && a == TY_I64 && radixLitTreeAt(n.binLeft)
}

// Whether `a op b` is an integer shift, which is typed at its left operand: a count never types
// it, whatever the count's own width (owner ruling Q8).
export function shiftKeepsLeft(op: string, a: i32, b: i32): boolean {
  if !binShiftOp(op) { return false }
  const an = primNameOf(a)
  const bn = primNameOf(b)
  return (an == "i32" || an == "i64") && (bn == "i32" || bn == "i64")
}

// The type both operands of `a op b` are brought to at one member pair, which is the result
// for arithmetic, or -1 when the scalar rule refuses the pair.
export function numPairOpTy(n: BinExpr, a: i32, b: i32): i32 {
  const op = n.binOp
  if numCmpOp(op) {
    if radixTreeF64Pair(n, a, b) { return TY_F64 }
    if sameNumeric(a, b) { return a }
    if mixesNumeric(a, b) { return widerNumeric(a, b) }
    if !cmpF32LitAdopts(n, a, b) { return -1 }
    if primNameOf(a) == "f32" || primNameOf(a) == "f64" { return a }
    return b
  }
  if binIntOnlyOp(op) && binFloatOperandPair(a, b) { return -1 }
  if shiftKeepsLeft(op, a, b) { return a }
  if primNameOf(a) == "f32" && f32AdoptingOperand(n.binRight, a) { return a }
  if primNameOf(b) == "f32" && f32AdoptingOperand(n.binLeft, b) { return b }
  if primNameOf(a) == "f64" && isExactF64IntLitExpr(n.binRight) { return a }
  if primNameOf(b) == "f64" && isExactF64IntLitExpr(n.binLeft) { return b }
  if radixTreeF64Pair(n, a, b) { return TY_F64 }
  if mixesNumeric(a, b) { return widerNumeric(a, b) }
  if sameNumeric(a, b) { return a }
  return -1
}

// The type of `a op b` at operand types `lt`/`rt`, one a numeric union, as `numUnionBinTy`
// computes it, or -1 when a member pair has no scalar form. Reports nothing.
export function numUnionResultTy(n: BinExpr, lt: i32, rt: i32): i32 {
  let ls = numUnionMembersOf(lt)
  if ls.length == 0 { ls = [lt] }
  let rs = numUnionMembersOf(rt)
  if rs.length == 0 { rs = [rt] }
  const res: i32[] = []
  for a in ls {
    for b in rs {
      if !isNumericPrimTy(a) || !isNumericPrimTy(b) { return -1 }
      const p = numPairTy(n, a, b)
      if p < 0 { return -1 }
      let seen = false
      for r in res {
        if r == p || tySame(r, p) { seen = true }
      }
      if !seen { res.push(p) }
    }
  }
  if res.length == 1 { return res[0] }
  return mkUnionTy(res)
}

// Whether `dstTy` is a member of the number union `ct`, or `ct` is no number union.
export function coalUnionHolds(ct: i32, dstTy: i32): boolean {
  const ms = numUnionMembersOf(nonNullTy(ct))
  if ms.length == 0 { return true }
  const d = nonNullTy(dstTy)
  for m in ms {
    if m == d || tySame(m, d) { return true }
  }
  return false
}

// Splits the value `if`, `match` or block at `ix` into `spine`, its `if` and `match` nodes, and
// `leaves`, the tail values they yield.
export function valueTailSplit(ix: i32, spine: i32[], leaves: i32[]) {
  const todo: i32[] = [ix]
  while todo.length > 0 {
    const at = cwPeel(todo.pop() ?? -1)
    if at >= 0 && at < P.nodes.length {
      if tailPushIfArms(at, todo) || tailPushMatchArms(at, todo) {
        spine.push(at)
      } else if !tailPushBlockTail(at, todo) {
        leaves.push(at)
      }
    }
  }
  return 0
}

// Types each parenthesis the value `if`, `match` or block at `ix` yields a tail through as the
// node it wraps, which the emitter reads in the tail's place once the tail adopted (D16371).
// An instance's re-check notes each at the type its node has in that instance.
export function tailParensSync(ix: i32) {
  if inferQuiet && !elabCapLive() { return 0 }
  const todo: i32[] = [ix]
  while todo.length > 0 {
    const at = todo.pop() ?? -1
    const an = if at >= 0 && at < P.nodes.length { nodeAt(at) } else { null }
    if an is Paren {
      todo.push(an.parInner)
      if inferQuiet {
        const ct = elabLiveTyOf(cwPeel(at))
        if ct >= 0 { elabCapNote(at, ct) }
      } else {
        const it = nodeTyOf(cwPeel(at))
        if it >= 0 && at < nodeTyIx.length { nodeTySet(at, it) }
      }
    } else if at >= 0 && at < P.nodes.length {
      if !tailPushIfArms(at, todo) && !tailPushMatchArms(at, todo) {
        tailPushBlockTail(at, todo)
      }
    }
  }
  return 0
}

// `ix` past parentheses when it is a value `if`, `match` or block; else -1.
export function valueJoinAt(ix: i32): i32 {
  const lix = parenPeelIx(ix)
  if lix < 0 { return -1 }
  const e = nodeAt(lix)
  return if e is IfStmt || e is MatchExpr || e is Block { lix } else { -1 }
}

// A value `if`, `match` or block every tail of which adopts `f32` as a bare literal does, at an
// `f32` destination or its nullable. Its `if` and `match` nodes are re-typed `f32`, so the
// emitter builds the join there and each literal re-encodes at single precision (D2619).
export function f32LitTailsAdopt(srcExpr: i32, dstTy: i32): boolean {
  const fty = nonNullTy(dstTy)
  if srcExpr < 0 || primNameOf(fty) != "f32" { return false }
  const lix = valueJoinAt(srcExpr)
  if lix < 0 { return false }
  const spine: i32[] = []
  const leaves: i32[] = []
  valueTailSplit(lix, spine, leaves)
  if leaves.length == 0 { return false }
  let i = 0
  while i < leaves.length {
    if !isF32AdoptingLitExpr(leaves[i]) {
      if litTreeAdoptDst(leaves[i], fty) < 0 { return false }
    }
    i = i + 1
  }
  if !inferQuiet {
    let s = 0
    while s < spine.length {
      if spine[s] < nodeTyIx.length { nodeTySet(spine[s], fty) }
      s = s + 1
    }
  }
  tailParensSync(srcExpr)
  return true
}

// Whether the value at `ix`, or every tail of a value `if`, `match` or block at it, is a numeric
// literal the float `ft` takes beside a value of its type: at `f32` one an `f32` binding takes, at
// `f64` one it holds exactly (owner ruling 4.3).
export function litTailsTakeFloat(ix: i32, ft: i32): boolean {
  if numLitOwnTy(ix) >= 0 { return litTakesFloat(ix, ft) }
  const lix = valueJoinAt(ix)
  if lix < 0 { return false }
  const spine: i32[] = []
  const leaves: i32[] = []
  valueTailSplit(lix, spine, leaves)
  if leaves.length == 0 { return false }
  for lf in leaves {
    if !litTakesFloat(lf, ft) { return false }
  }
  return true
}

// Whether the bare literal at `ix` is one the float `ft` takes, as `litTailsTakeFloat` reads it.
export function litTakesFloat(ix: i32, ft: i32): boolean {
  if primNameOf(ft) == "f32" { return isF32AdoptingLitExpr(ix) }
  return primNameOf(ft) == "f64" && numLitDstTy(ix, ft) >= 0
}

// What `numPairOpTy` reads of `n` (at node `ix`) beyond its operator: which operands are
// literals that adapt. Two nodes with one shape answer every member pair alike; an operand
// that is a value `if`, `match` or block makes the shape `n`'s own.
export function binLitShape(n: BinExpr, ix: i32): i32 {
  const l = binOperandLitShape(n.binLeft)
  const r = binOperandLitShape(n.binRight)
  if l < 0 || r < 0 { return 4 * 4 + ix }
  return l + 4 * r
}

// `binLitShape`'s code for one operand: 0 none, 1 an exact-f64 integer literal, 2 an
// f32-adopting literal, 3 both, or -1 for a join whose tails decide.
function binOperandLitShape(ix: i32): i32 {
  if valueJoinAt(ix) >= 0 { return -1 }
  let s = 0
  if isExactF64IntLitExpr(ix) { s = s + 1 }
  if isF32AdoptingLitExpr(ix) { s = s + 2 }
  return s
}

// An operand beside an `f32` peer `peerTy` that adopts f32 as a literal does: a bare literal,
// or a value `if`, `match` or block whose every tail is one.
export function f32AdoptingOperand(ix: i32, peerTy: i32): boolean {
  if isF32AdoptingLitExpr(ix) { return true }
  return f32LitTailsAdopt(ix, peerTy)
}

// Whether the `i64` join at `srcExpr` (a `??`, or a value `if`, `match` or block) holds only
// values `f64` holds exactly: integer literals up to 2^53 and `i32`, `f32` or `f64` values. Such a
// join is `i64` only because a literal outgrew i32, so it converts into `f64` exactly (D5712).
export function f64ExactJoinLeaves(
  srcExpr: i32,
  srcTy: i32,
  dstTy: i32,
): boolean {
  if (
    srcTy < 0
    || dstTy < 0
    || primNameOf(srcTy) != "i64"
    || primNameOf(dstTy) != "f64"
  ) {
    return false
  }
  const lix = parenPeelIx(srcExpr)
  if lix < 0 { return false }
  const todo: i32[] = [lix]
  let n = 0
  while todo.length > 0 {
    const at = parenPeelIx(todo.pop())
    if at < 0 { return false }
    const e = nodeAt(at)
    if e is BinExpr && e.binOp == "??" {
      todo.push(e.binRight)
      if !f64ExactValue(nonNullTy(nodeTyOf(e.binLeft))) { return false }
      n = n + 1
    } else if e is IfStmt || e is MatchExpr || e is Block {
      const spine: i32[] = []
      const leaves: i32[] = []
      valueTailSplit(at, spine, leaves)
      if leaves.length == 0 { return false }
      for l in leaves { todo.push(l) }
    } else if at == lix {
      return false
    } else if !isExactF64IntLitExpr(at) && !f64ExactValue(nodeTyOf(at)) {
      return false
    } else {
      n = n + 1
    }
  }
  return n > 0
}

// Whether every value of type `t` is exact in `f64`: an `i32`, `f32` or `f64`.
function f64ExactValue(t: i32): boolean {
  if t < 0 { return false }
  const pn = primNameOf(t)
  return pn == "i32" || pn == "f32" || pn == "f64"
}

// Types every node of the literal tree at `ix` as `ty`, its literals through `litTreeTy` so a
// re-check keeps the width. Answers `ty`.
function litTreeAdopt(ix: i32, ty: i32): i32 {
  if ix < nodeTyIx.length { nodeTySet(ix, ty) }
  const e = nodeAt(ix)
  if e is Paren { return litTreeAdopt(e.parInner, ty) }
  // A value join of literal tails is built at the tree's width, its `if`s and parentheses too.
  if e is IfStmt || e is MatchExpr || e is Block {
    const spine: i32[] = []
    const leaves: i32[] = []
    valueTailSplit(ix, spine, leaves)
    for l in leaves { litTreeAdopt(l, ty) }
    for sp in spine {
      if sp < nodeTyIx.length { nodeTySet(sp, ty) }
    }
    tailParensSync(ix)
    return ty
  }
  if e is Unary { return litTreeAdopt(e.unArg, ty) }
  if e is BinExpr {
    litTreeAdopt(e.binLeft, ty)
    // A shift count is no operand of the tree's value, but a literal count is typed at the
    // width the shift computes at.
    if binShiftOp(e.binOp) {
      numLitAdoptDst(e.binRight, ty)
      return ty
    }
    return litTreeAdopt(e.binRight, ty)
  }
  return litTreeAdoptLeaf(ix, ty)
}

// Whether `ix` shifts a literal tree by a constant count of 32 to 63, which makes that untyped
// operand an `i64` (owner ruling Q8, D16378).
export function shiftWidensLit(ix: i32): boolean {
  const e = nodeAt(parenPeelIx(ix))
  if !(e is BinExpr) || !binShiftOp(e.binOp) || litTreeOps(e.binLeft, 32) < 0 {
    return false
  }
  const cv = cexEvalAt(e.binRight, 0)
  if !cexOk(cv) || cv.cxFloat || cv.cxNeg { return false }
  const lex = cexDecText(cv)
  return numLexFitsI32(lex) && cexCountBelow(lex, 64) && !cexCountBelow(lex, 32)
}

// The left operand of the shift at `ix` built at `ty`: `i64` where its count widens it, `i32` at
// an `i32` destination, where the count is then refused.
export function shiftLitAdopt(ix: i32, ty: i32): i32 {
  const sx = parenPeelIx(ix)
  if sx < 0 || sx >= P.nodes.length { return ty }
  const e = nodeAt(sx)
  if !(e is BinExpr) || inferQuiet { return ty }
  litTreeAdopt(e.binLeft, ty)
  nodeTySet(sx, ty)
  tailParensSync(ix)
  return ty
}

// A tree's other nodes are its literals (`litTreeOps` admits no other), each recorded so a
// re-check keeps the width.
function litTreeAdoptLeaf(ix: i32, ty: i32): i32 {
  while litTreeTy.length <= ix { litTreeTy.push(-1) }
  litTreeTy[ix] = ty
  return ty
}

// A tree of integer literals takes its destination's width, as a bare literal does, so
// `const a: i64 = 3 << 32` computes at 64 bits rather than wrapping at 32 first, and the operand
// beside a wide one takes that one's, so `x + (1 << 40)` over an `i64` adds 2^40 (D2709).
// Answers the adopted type, or -1; a speculative check answers without recording.
export function litTreeAdoptDst(ix: i32, dstTy: i32): i32 {
  if ix < 0 { return -1 }
  const ty = litTreeWideTy(ix, dstTy)
  if ty < 0 || inferQuiet { return ty }
  return litTreeAdopt(ix, ty)
}

// A float tree the fold kept whole (`1.0 / 0.0`) at an `f32` use computes there in IEEE `f32`
// arithmetic, as the same expression runs (E9.1, D16541). Answers the adopted type, or -1; a
// speculative check answers without recording.
export function floatTreeAdoptDst(ix: i32, dstTy: i32): i32 {
  if ix < 0 || dstTy < 0 || primNameOf(nonNullTy(dstTy)) != "f32" { return -1 }
  if !cexKeptF32Tree(ix) { return -1 }
  const ty = nonNullTy(dstTy)
  if inferQuiet { return ty }
  return litTreeAdopt(ix, ty)
}

export function litTreeTyOf(ix: i32): i32 {
  if ix >= 0 && ix < litTreeTy.length { return litTreeTy[ix] }
  return -1
}

export function binShiftOp(op: string): boolean {
  return op == "<<" || op == ">>" || op == ">>>"
}

// The values a delivery of `srcExpr` hands over: the value itself, or every tail of a value
// `if`, `match` or block, so a literal in an arm is walked as the bare literal is (D2730).
export function valueTailLeaves(srcExpr: i32): i32[] {
  const spine: i32[] = []
  const leaves: i32[] = []
  valueTailSplit(srcExpr, spine, leaves)
  return leaves
}

// The cheap gate ahead of `recordMapUnbox`: only a union (a box, or a value join typed as one)
// or a list or record literal, which is walked to its parts, can record anything.
export function mapDeliveryMayRecord(
  srcExpr: i32,
  srcTy: i32,
  dstTy: i32,
): boolean {
  if !tyMapMinted && !(tyWideUnionMinted && tyHoldsNonI32Num(dstTy, 8)) {
    return false
  }
  if srcTy >= 0 && srcTy < T.tys.length {
    const st = tyAt(srcTy)
    if st is TyUnion || st is TyNullable { return true }
  }
  if nodeIsCtorLit(srcExpr) { return true }
  if !nodeIsValueJoin(srcExpr) { return false }
  // Every tail of a value `if` or `match`, which joins record literals as one record rather
  // than a union (D2731).
  const ls = valueTailLeaves(srcExpr)
  let i = 0
  while i < ls.length {
    if nodeIsCtorLit(ls[i]) { return true }
    i = i + 1
  }
  return false
}

// Whether node `ix` is a list or record literal.
function nodeIsCtorLit(ix: i32): boolean {
  const n = nodeAt(ix)
  return n is ArrayLit || n is ObjLit
}

// Whether node `ix` is an `if` or a `match`, the two value joins with tails.
function nodeIsValueJoin(ix: i32): boolean {
  const n = nodeAt(ix)
  return n is IfStmt || n is MatchExpr
}

// A list literal's elements and a value `if` or `match`'s tails take the type `t` they join to,
// so `[1, 2.5]` holds an f64 `1`. Only a type holding a number other than `i32` moves one.
export function numLitAdoptJoin(ix: i32, t: i32): i32 {
  if ix < 0 || t < 0 || !stampsStand() || !tyHoldsNonI32Num(t, 8) { return 0 }
  if nodeAt(ix) is ArrayLit { return numLitAdoptBody(ix, t, 6) }
  const held = numLitJoinHeldLeaves(ix, t)
  for lf in valueTailLeaves(ix) {
    if !i32ArrHas(held, lf) { numLitAdoptPart(lf, t, 6) }
  }
  numLitJoinSpineSync(ix, t)
  tailParensSync(ix)
  return 0
}

// The tails of the joins nested in `ix` that keep their own type: one of their tails is typed
// other than `t` and is no literal, so the nested join is built at its type and is converted to
// `t` whole. Its literals stay at its width (D16496).
function numLitJoinHeldLeaves(ix: i32, t: i32): i32[] {
  const spine: i32[] = []
  const leaves: i32[] = []
  valueTailSplit(ix, spine, leaves)
  const held: i32[] = []
  for sp in spine {
    if sp != cwPeel(ix) && numLitJoinKeepsTy(sp, t) {
      for lf in valueTailLeaves(sp) { held.push(lf) }
    }
  }
  return held
}

// Whether join `sp` has a tail that is no literal or tree of them and is typed other than `t`.
function numLitJoinKeepsTy(sp: i32, t: i32): boolean {
  for lf in valueTailLeaves(sp) {
    if numLitDstTy(lf, t) < 0 && litTreeOps(lf, 8) < 0 && nodeTyOf(lf) != t {
      return true
    }
  }
  return false
}

function i32ArrHas(xs: i32[], v: i32): boolean {
  for x in xs {
    if x == v { return true }
  }
  return false
}

// Types each value `if` or `match` nested in join `ix` as `t` once every tail it yields holds `t`,
// so an inner join of literals is built at the width they adopted (D16491).
function numLitJoinSpineSync(ix: i32, t: i32) {
  if inferQuiet { return 0 }
  const spine: i32[] = []
  const leaves: i32[] = []
  valueTailSplit(ix, spine, leaves)
  for sp in spine {
    if sp != cwPeel(ix) && nodeTyOf(sp) != t {
      let all = true
      for lf in valueTailLeaves(sp) {
        if nodeTyOf(lf) != t { all = false }
      }
      if all && sp < nodeTyIx.length { nodeTySet(sp, t) }
    }
  }
  return 0
}

// Clears this module's tables (called from `initChecker`).
export function numAdoptReset() { return litTreeTy = [] }

// A bare literal delivered into a numeric destination, or met by a numeric operand, types at that
// primitive (`numLitDstTy`), every node from `ix` down to it, so `const a: i64 = 6` and `x * 2`
// over an `i64` hold an i64 literal; answers the type taken, or -1. A speculative check, and a
// non-quiet re-validation of a generic template (whose literals every instance shares), stamp nothing.
export function numLitAdoptDst(ix: i32, dstTy: i32): i32 {
  if !stampsStand() || litPinN.length > 0 { return -1 }
  const t = numLitDstTy(ix, dstTy)
  if t < 0 { return -1 }
  return numLitRetype(ix, t)
}

// `numLitAdoptDst` at a cast's target, where a radix literal the float does not hold exactly
// takes the float too and is rounded there (owner ruling 4.1).
export function numLitAdoptCastDst(ix: i32, dstTy: i32): i32 {
  if !stampsStand() || litPinN.length > 0 { return -1 }
  let t = numLitDstTy(ix, dstTy)
  if t < 0 { t = radixLitCastFloatTy(ix, dstTy) }
  if t < 0 { return -1 }
  return numLitRetype(ix, t)
}

// `numLitAdoptDst` over a literal, or over every tail of a value `if`, `match` or block when each
// holds its value at `prim`; the join's `if` and `match` nodes are then typed `prim` too, so it is
// built at the width its literals are.
export function numLitAdoptTails(ix: i32, prim: i32) {
  numLitTailsAt(ix, prim, false)
}

// `numLitAdoptTails` at a cast's target, each tail taking it as a bare literal cast there does.
export function numLitAdoptCastTails(ix: i32, prim: i32) {
  numLitTailsAt(ix, prim, true)
}

// The two above: `cast` reads each tail as `numLitAdoptCastDst` does, else as `numLitAdoptDst`.
function numLitTailsAt(ix: i32, prim: i32, cast: boolean) {
  const lix = valueJoinAt(ix)
  if lix < 0 {
    if cast { numLitAdoptCastDst(ix, prim) } else { numLitAdoptDst(ix, prim) }
    return
  }
  const spine: i32[] = []
  const leaves: i32[] = []
  valueTailSplit(lix, spine, leaves)
  for lf in leaves {
    let lt = numLitDstTy(lf, prim)
    if lt < 0 && cast { lt = radixLitCastFloatTy(lf, prim) }
    if lt < 0 { return }
  }
  if !stampsStand() || litPinN.length > 0 { return }
  for lf in leaves {
    if cast { numLitAdoptCastDst(lf, prim) } else { numLitAdoptDst(lf, prim) }
  }
  // The spine is typed where its leaves are: an instance's re-check notes it as it notes them.
  for sp in spine {
    if !inferQuiet {
      if sp < nodeTyIx.length { nodeTySet(sp, prim) }
    } else if elabCapLive() {
      elabCapNote(sp, prim)
    }
  }
  // From `ix`: the parentheses around the whole join are read in its place too (D16374).
  tailParensSync(ix)
}

// Types the parens and negations from `ix` down to its literal as `t`. Answers `t`.
function numLitRetype(ix: i32, t: i32): i32 {
  if inferQuiet {
    if elabCapLive() { elabCapNote(ix, t) }
  } else if ix < nodeTyIx.length {
    nodeTySet(ix, t)
  }
  const e = nodeAt(ix)
  if e is Paren { return numLitRetype(e.parInner, t) }
  if e is Unary { return numLitRetype(e.unArg, t) }
  return numLitRetypeLeaf(t)
}

// The literal itself, the one other node `numLitDstTy` admits, ends the walk.
function numLitRetypeLeaf(t: i32): i32 { return t }

// A literal a join widened past its own type (`-1` beside `3000000000`), delivered on its own
// into a numeric destination it fits, takes that destination instead. Answers whether it did.
export function numLitReadopt(ix: i32, srcTy: i32, dstTy: i32): boolean {
  const own = numLitOwnTy(ix)
  if own < 0 || srcTy == own || !isNumericPrimTy(srcTy) { return false }
  if numLitDstTy(ix, dstTy) < 0 { return false }
  return numLitAdoptDst(ix, dstTy) >= 0
}

// `numLitAdoptDst` through what a delivery hands over: every tail of a value `if`, `match` or
// block, and each element of a list literal and field of a record literal against its own
// destination, so `const g: i64[] = [7, 8]` holds i64 literals. `depth` bounds the walk.
export function numLitAdoptDeep(ix: i32, dstTy: i32, depth: i32): i32 {
  if ix < 0 || dstTy < 0 || depth <= 0 { return 0 }
  const at = cwPeel(ix)
  if at < 0 || at >= P.nodes.length { return 0 }
  // A value join or block splits into its tails; a literal, a negation, or a list or record
  // literal is its own one part.
  const e = nodeAt(at)
  if e is IfStmt || e is MatchExpr || e is Block {
    if stampsStand() { numLitAdoptDeepJoin(ix, dstTy, depth) }
    return 0
  }
  // A literal adopts from `ix`, so the parentheses around it are typed with it.
  if e is NumLit || e is Unary {
    if stampsStand() { numLitAdoptPart(ix, dstTy, depth) }
    return 0
  }
  if e is ArrayLit || e is ObjLit {
    if stampsStand() { numLitAdoptPart(at, dstTy, depth) }
    return 0
  }
  // A `??` over a union hands over its default when the left side is null, so the default is a
  // delivered part; a `??` of one number type builds its default at that type, and so does one
  // whose number union the destination is no member of: the union is built, then converted.
  if (
    e is BinExpr
    && e.binOp == "??"
    && !isNumericPrimTy(nonNullTy(nodeTyOf(at)))
    && coalUnionHolds(nodeTyOf(at), dstTy)
  ) {
    return numLitAdoptDeep(e.binRight, dstTy, depth - 1)
  }
  return numLitPartOpaque()
}

// The tails of value join `at` delivered to `dstTy`: when every one is a literal adopting one type
// there, the join is built at it with them (`numLitAdoptTails`, D16373); else a literal tail keeps
// the join's own type, and only a list or record literal's parts adopt their destinations.
function numLitAdoptDeepJoin(at: i32, dstTy: i32, depth: i32) {
  const leaves = valueTailLeaves(at)
  let t = -1
  let allLit = leaves.length > 0
  for lf in leaves {
    const lt = numLitDstTy(lf, dstTy)
    if lt < 0 || t >= 0 && lt != t { allLit = false }
    t = lt
  }
  if allLit {
    numLitAdoptTails(at, t)
    return 0
  }
  for lf in leaves {
    const ln = nodeAt(lf)
    if ln is ArrayLit || ln is ObjLit { numLitAdoptPart(lf, dstTy, depth) }
  }
  return 0
}

// One already-checked delivered value of `numLitAdoptDeep`. One whose recorded type is its
// destination holds its literals at that width: its own check or join adopted them.
function numLitAdoptPart(ix: i32, dstTy: i32, depth: i32): i32 {
  if nodeTyOf(ix) == dstTy { return 0 }
  return numLitAdoptBody(ix, dstTy, depth)
}

// A literal adopts; a list or record literal walks its parts against the destination's one
// list or record arm, when that arm holds a number other than `i32`.
function numLitAdoptBody(ix: i32, dstTy: i32, depth: i32): i32 {
  if numLitAdoptDst(ix, dstTy) >= 0 { return 0 }
  const e = nodeAt(ix)
  if e is ArrayLit {
    const at = numSoleArm(dstTy, true)
    if at < 0 { return 0 }
    const a = tyAt(at)
    if a is TyArray && tyHoldsNonI32Num(tyElemOf(a), 8) {
      for el in e.arrElems {
        const sp = nodeAt(el)
        if sp is Spread {
          numLitAdoptDeep(sp.spdArg, at, depth - 1)
        } else {
          numLitAdoptDeep(el, tyElemOf(a), depth - 1)
        }
      }
    }
    return 0
  }
  if e is ObjLit {
    const ot = numSoleArm(dstTy, false)
    if ot < 0 { return 0 }
    const o = tyAt(ot)
    if o is TyObj && tyHoldsNonI32Num(ot, 8) {
      for fx in e.objFields {
        const f = nodeAt(fx)
        if f is FieldInit {
          const ft = objFieldType(o, f.fiName)
          if ft >= 0 { numLitAdoptDeep(f.fiValue, ft, depth - 1) }
        }
      }
    }
  }
  return numLitPartOpaque()
}

// Any other delivered value holds no literal a destination reaches: its own check typed it.
function numLitPartOpaque(): i32 { return 0 }

// The one list (`list`) or record member of `dstTy`, peeling a nullable, or -1 when it has none
// or several; a list member whose element holds no number is no candidate.
function numSoleArm(dstTy: i32, list: boolean): i32 {
  const d = nonNullTy(dstTy)
  if d < 0 || d >= T.tys.length { return -1 }
  const t = tyAt(d)
  if list && t is TyArray { return d }
  if !list && t is TyObj { return d }
  if !(t is TyUnion) { return -1 }
  let one = -1
  for m0 in t.uMembers {
    const m = nonNullTy(m0)
    if m >= 0 && m < T.tys.length {
      const mt = tyAt(m)
      if (
        (list && mt is TyArray && !numNoNumber(tyElemOf(mt)))
        || (!list && mt is TyObj)
      ) {
        if one >= 0 { return -1 }
        one = m
      }
    }
  }
  return one
}

// Whether every value of `t` is a non-numeric scalar: a `boolean`, a `string` or a literal of one.
function numNoNumber(t: i32): boolean {
  const d = nonNullTy(t)
  if d < 0 || d >= T.tys.length { return false }
  const x = tyAt(d)
  if x is TyPrim { return !isNumericPrimTy(d) }
  if x is TyLit { return tyNumScalarBaseName(d) == "" }
  if !(x is TyUnion) { return false }
  for m in x.uMembers {
    if !numNoNumber(m) { return false }
  }
  return true
}
