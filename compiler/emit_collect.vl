// Scan the program's top-level statements into `fnStmts` (FuncDecls only, in order),
// skipping `TypeDecl`s and gathering top-level `LetDecl`s into `globalStmts` (module
// globals, declaration order = global index). Any other top-level statement fails
// loudly. Returns the function count, or -1 (via `emitFail`).

// A BOUNDED read of a parallel TYPE column beside a name array. These columns are
// padded lazily at their mint sites, so a row can exist in the name array before the
// column reaches it; -1 is the "no hint" value every hinted interner already handles,
// which makes a short column degrade to the unhinted call instead of trapping.

// The ARENA element row of the list expression at `ix`, or -1. The hint half of the
// ref-list interners' `(name, ty)` pair: `repElemIdOfNameTy` keys off the row when it
// gets one and parses the name when it does not, so -1 is exactly today's call.
//
// ONLY offered where the name it accompanies is the CHECKER's own recorded element
// (`arrLitUnionElemName` / `arrLitNestedElemName`, both `nodeArrayElemName`), which is
// the "type THIS VERY NAME resolved to" provenance `repElemIdOfNameTy`'s header
// requires. It is NOT offered at `refListElemNameOfExpr`, whose name is a DECLARED
// struct's — measured, that one disagrees on both its corpus firings (`nm=P` against a
// structural `{x: i32}`), because `repElemKey` keys a declared struct nominally.

// The FIELD-ANNOTATION node's row, routed through the canon column where canon rewrote
// the node. `canonEmitTypeNames` rewrites `TypeRef.tyName` in place and leaves `nodeTyIx`
// holding the type the CHECKER recorded BEFORE the rewrite, so on a rewritten node the
// recorded elem NAME is post-canon while `nodeTyIxOf` is pre-canon — measured, that is
// every one of this site's 4 disagreements (`i32|null` against a `1 | 2 | null` row).
// ARENA: could this functype's RESULT be a MIXED scalar+composite union? `false` is a
// DEFINITE no — the caller then knows `nulCloMixedUnionUnregistered` would return false
// without rendering the type to ask it.
//
// This is the guard's ANSWER, not its early-out. B258 tried four predicates for the
// early-out (`splitUnionAtoms(res).length < 2`) and none was exact, because an atom count
// is a fact about the SPELLING: a litunion alias `K0` is one atom and many `uMembers`, a
// nullable is one wrapper and two atoms. But the early-out is an OPTIMISATION inside the
// guard — the VERDICT is "scalar and composite both present", and that IS structural.
// `K0` counts as one atom by name and as many members here, and both routes conclude
// "not mixed" because every member is a literal.
//
// Measured against the full name guard: **1,123 definite-no of 1,133, 0 wrong, 10
// deferred**. The deferred ten render and take the name path unchanged.

// The LITUNION half of the inferred-return kind decision, asked of the ARENA row the same
// table entry records rather than of the rendered name.
//
// `recordInferRet` banks two columns beside a function name — the SPELLING the adoption
// ladder settled on, and `inferRetTyIx`, the arena type it was deciding ABOUT — and the
// column is fully populated: measured **rowGap = 0** over every reach that has an entry at
// all (the 11,748 reaches without one carry `inm == ""`, which every name predicate answers
// false for anyway).
//
// Dual-written against `nameIsLitUnionType(inm)` on the 3,576 reaches that have a row:
// **0 disagreements**. Its two neighbours on this ladder do NOT convert — `isValueUnionName`
// disagrees 6 times and `isUName` 179 — for the reasons B288 measured: canon softening makes
// the recorded NAME the lowering while the row is the precise type, and the arena is not
// hash-consed, so a row-identity scan misses duplicates. This arm is free of both because
// `tyIsLitUnion` is a structural test on the row itself, not a registry lookup.
// The REGISTRY-membership half of the inferred-return kind decision, off the row the same
// table entry records. `isUName` scans `unNames` comparing strings; the canon-keyed reverse
// index compares interned structural ids.
//
// B289 measured this arm with a row-IDENTITY scan and got 179 disagreements, and recorded it
// as unconvertible. That was the wrong index, not an unanswerable question: the arena is not
// hash-consed, so one spelling mints several rows. Re-measured with `unRowOfCanon`:
// **3,576 reaches, 0 disagreements.**
// The VALUE-UNION half of the inferred-return kind decision, read from the RUNG the checker
// banked rather than re-derived from the name it rendered.
//
// `recordInferRet` stores which arm of the adoption ladder minted the row. Three of its rungs
// are value-union producers (the plain one, the litunion-ARRAY one, the closure-ARM one), and
// bucketing every reach by rung shows the separation is exact — of the 31 rungs that occur,
// those three are all-true and the other 28 all-false, no mixed rung anywhere.
//
// This was the LAST disagreement in the whole render→decide surface: B288 measured it at 6 of
// 3,576 and called it canon softening; B294 tried softening the arena walk to match and made
// it 83. Both were re-deriving a decision that was already recorded as an i32.
// Dual-written: **3,576 reaches, 0 disagreements.**
function inferRetIsValueUnionAt(inRow: i32, inm: string): boolean {
  // NO ENTRY MEANS NO NAME, so do not scan the registry for one. `inm` is "" whenever
  // `inRow < 0` — its only producer at the call site is `inferRetTyAt(inRow)` — and the
  // union registry never holds an empty name: measured `emptyUn = 0` across every row of
  // every corpus program. The fallback below was scanning the whole table for "" and always
  // answering false.
  if inm == "" { return false }
  if inRow < 0 { return isValueUnionName(inm) }
  inferRetRungIsValueUnion(inRow)
}

function inferRetIsUnionAt(inRow: i32, inm: string): boolean {
  // The same empty-name short-circuit as `inferRetIsValueUnionAt` — see the note there.
  if inm == "" { return false }
  if inRow < 0 { return isUName(inm) }
  const row = inferRetTyIxAt(inRow)
  if row < 0 { return isUName(inm) }
  unRowOfCanon(row) >= 0
}

function inferRetIsLitUnionAt(inRow: i32, inm: string): boolean {
  if inRow < 0 { return nameIsLitUnionType(inm) }
  const row = inferRetTyIxAt(inRow)
  if row < 0 { return nameIsLitUnionType(inm) }
  tyIsLitUnion(row)
}

function cloResultMaybeMixed(tyIx: i32): boolean {
  if tyIx < 0 { return false }
  const t = T.tys[tyIx]
  if !(t is TyFunc) { return false }
  const fr = t.fnRet
  if fr < 0 { return false }
  const frt = T.tys[fr]
  if frt is TyUnion { return unionArmsMixed(frt.uMembers) }
  // A `| null` result is a WRAPPER here and an ATOM in the spelling; the mix question is
  // about what is INSIDE it.
  if frt is TyNullable {
    if frt.nInner < 0 { return false }
    const it = T.tys[frt.nInner]
    if it is TyUnion { return unionArmsMixed(it.uMembers) }
    return false
  }
  false
}

// Do these union members carry BOTH a scalar (prim / literal) and a composite
// (object / map / array / closure) arm? A closure counts composite, mirroring the name
// guard's `nameIsFuncTypeAtom` exception.
function unionArmsMixed(ms: i32[]): boolean {
  let hasScalar = false
  let hasComposite = false
  let i = 0
  while i < ms.length {
    if ms[i] >= 0 {
      const m = T.tys[ms[i]]
      if m is TyObj { hasComposite = true }
      else if m is TyMap { hasComposite = true }
      else if m is TyArray { hasComposite = true }
      else if m is TyFunc { hasComposite = true }
      else if m is TyPrim { hasScalar = true }
      else if m is TyLit { hasScalar = true }
    }
    i = i + 1
  }
  hasScalar && hasComposite
}

function fdRowOf(fdType: i32) {
  if canonRewroteNode(fdType) { return canonTyIxOf(fdType) }
  nodeTyIxOf(fdType)
}

// The variant IDENTITY column's literal rung. `uFieldTyText` is the column
// `variantFieldTysEq` uses to tell two same-field-NAME variants apart, and a bare literal
// annotation (`kind: "circle"`) renders through canon as the softened `string` — so
// `{kind: "circle", size: f64}` and `{kind: "rect", size: f64}` recorded a
// character-identical row, compared EQUAL, and were folded as the layout-equal twins that
// comparison exists to admit. The consequence is the worst outcome column there is: `is C`
// answered TRUE for a `rect`, rc 0, valid module, wrong branch. The NAMED spelling
// (`type KC = "circle"`) never had the hole, because a named litunion field carries `KC` /
// `KR` in both this column and the elem-name one.
//
// Restored into the IDENTITY column ONLY. This is not a rep change: the field still codes 3
// (a plain string slot), the elem name stays "", and no other column moves. The two
// variants simply stop claiming to be one variant, which routes them to the
// `cannot be discriminated` reject the named spelling already gets — the correct, loud
// column. Making such arms actually discriminable needs the tag to carry a runtime
// identity (the un-named-literal ATOM rep, A5c), which is a rep decision and not this.
//
// Every `TyLit` kind, not just `"str"`: a numeric tag (`kind: 0` / `kind: 1.5`) softens to
// its base scalar for exactly the same reason and would fold for exactly the same reason.
// The quotes are a disambiguator, not a rendering — they keep a literal `"i32"` tag from
// colliding with the type `i32` in a column that is compared as raw text.
function variantFieldIdText(txt: string, tyIx: i32) {
  if tyIx < 0 { return txt }
  const t = T.tys[tyIx]
  if t is TyLit { return "\"" + t.litText + "\"" }
  txt
}

// The hint for a field row pushed from a `FieldDef` NODE: the field's own row projected
// per CODE, declined for the names `repElemKey` keys nominally and for literal unions.
function fieldElemHintOf(fdType: i32, code: i32, elemNm: string) {
  if elemNm == "" { return -1 }
  if elemNameIsNominal(elemNm) { return -1 }
  if nameIsLitUnionType(elemNm) { return -1 }
  if nameIsLitUnionArray(elemNm) { return -1 }
  shapeFieldElemRow(fdRowOf(fdType), code)
}

function rlHintElemTy(ix: i32) {
  const rt = nodeRepTyIxOf(ix)
  if rt < 0 { return -1 }
  const t = T.tys[rt]
  if t is TyArray { return t.aElem }
  -1
}

// The arena ELEMENT type of the array node `ix`, read off the CHECKER's recorded type
// (`nodeTyIxOf`) rather than the rep one — the type `arrLitInferUnionElemName` renders its
// name from, so the members this feeds to `collectTyMembersReach` are that name's members.
function arrLitElemTyIxOf(ix: i32) {
  const at = nodeTyIxOf(ix)
  if at < 0 { return -1 }
  const t = T.tys[at]
  if t is TyArray { return t.aElem }
  -1
}

function rlColAt(col: i32[], i: i32) {
  if i < 0 { return -1 }
  if i >= col.length { return -1 }
  col[i]
}

// SYNTHESIZE the `<elem>[]` ANNOTATION of an un-annotated empty `[]` binding whose element a
// downstream `.push` pinned — the body of `collectLocals`' TYPED-IR arm, lifted so the MODULE
// scope can run the identical synthesis.
//
// ONE HOME, BECAUSE THE TWO STORAGE CLASSES ASK THE SAME QUESTION. `collectLocals` walks a
// FUNCTION BODY's block statements to type wasm LOCALS; a top-level binding is a GLOBAL and
// never reaches it, so `const outer = []  outer.push(inner)` at module scope took the i32-list
// default while the value pushed into it was a list ref — check-clean INVALID WASM, and the
// IN-FUNCTION form of the same program had been fixed and pinned
// (`arrays/nested-array-inferred-empty-push.vl`) for a release. Copying the arm would have put
// the two scopes one element kind apart at the next widening, which is the failure mode
// `declareForInLocals`' header describes for exactly this shape of duplication.
//
// Returns 0 always; the mutation is `s.letType`, in place.
export function synthEmptyListAnn(letIx: i32) {
  const s = P.nodes[letIx]
  if s is LetDecl {
    // TYPED-IR: an un-annotated empty `[]` whose element a downstream `.push` pinned —
    // synthesize the equivalent `<elem>[]` annotation from the checker's recorded type,
    // so the slot classifier below AND the later `[]`-seeding (`letAnnRefListKind`) and
    // every other annotation-reading path agree for ALL element types. This extends the
    // i32/string-only inferred build to f64/struct without per-rep usage predicates.
    // Emit-time (post-check), so `fmt` is untouched; the generic case is excluded by
    // `nodeArrayElemName` returning "" for a `TyVar` element.
    if s.letType < 0 {
      const synInit = unwrapParen(s.letInit)
      const synN = P.nodes[synInit]
      if synN is ArrayLit {
        if synN.arrElems.length == 0 {
          let synElem = nodeArrayElemName(synInit)
          // THE NICHE-NULLABLE ELEMENT `nodeArrayElemName` DOES NOT RENDER
          // (silent-class-inventory D772). Its `TyNullable` arm covers exactly one inner
          // kind — a closure, through `nullableRetName` — and every other nullable element
          // falls off the end as "". So `const xs = []` whose hole `constrainEmptyD` pinned
          // to a `(P | null)[]` / `(i32 | null)[]` / `(Circle | null)[]` destination
          // synthesized NO annotation, took the i32-list default, and stored that wrapper
          // into the destination's ref-list cell: `vl check` rc 0 and an invalid module.
          // The ANNOTATED twin of every one of those runs, which is what says this is a
          // missing render and not a missing rep.
          //
          // GATED ON THE ROW EXISTING, not on the shape. `tyToEmitName` renders the element
          // spaceless (`{r:i32}|null`), which is the key `collectA` interned the
          // destination's own annotation under — so `rlSlotByName` answering is the proof
          // that the two spellings land on ONE row, checked per program rather than argued.
          //
          // THE MEMBERSHIP TEST IS `unionSetHasNull`, NOT `nullablePartOf` (D813).
          // `nullablePartOf` splits at the FIRST depth-0 bar and demands that one of the two
          // halves be exactly `null`, so it answers "" for every union of THREE or more
          // members — `(Shape | null)[]` renders `{r:i32}|{s:i32}|null` and was declined by
          // the membership test while `rlSlotByName` answered its row perfectly well. The
          // question this gate is asking is "does the element carry a null member", which is
          // what `unionSetHasNull` decides structurally; the row test is what keeps it
          // honest, and it is unchanged.
          //
          // AND WHERE THE ELEMENT HAS NO REF-LIST ROW BY DESIGN, THE PROOF IS THE OTHER
          // BACKING'S OWN PREDICATE (D812). `(string | null)[]` rides the STRING-list
          // backing — `nameIsStringArray` is rep-wide over the niche, so the wrapper is
          // `$mkListIdx` and the ref-list table never interns a row to answer with. That is
          // not "no rep", it is a DIFFERENT rep, and `nameIsNulString` is the same kind of
          // positive proof for it that `rlSlotByName` is for a ref list: the spelling the
          // synthesis is about to write is the spelling the string-list machinery
          // recognises. Widening the gate to "any nullable element" is still refused — that
          // hands the synthesis a name with no backing behind it at all, which is how a loud
          // reject becomes a silent class.
          if synElem == "" {
            const nulEl = tyToEmitName(arrLitElemTyIxOf(synInit))
            if nulEl != "" && unionSetHasNull(nulEl) {
              if rlSlotByName(nulEl) >= 0 { synElem = nulEl }
              else if nameIsNulString(nulEl) { synElem = nulEl }
            }
          }
          if synElem != "" {
            // A STRUCT element renders as a structural shape (`{v: i32}`), but the
            // ref-list machinery (`nameIsRefArray`/`rlSlotByName`) keys on the DECLARED
            // struct name — so resolve the shape to its interned struct's name. A scalar
            // element (`f64`) is not a struct, so it passes through unchanged.
            // THE SHAPE-TO-ROW RESOLUTION ON THE ARENA. What stood here was
            // `structIndexOfTypeName(synElem)` — take the rendered element name, re-parse
            // its field set, match it against the struct table, then read the row's declared
            // name back out. `arrElemNominalOfTy` peels the `TyArray` and asks
            // `shapeNominalOfTy` (banked row, struct field set, variant field set) of the
            // ELEMENT TYPE, so only the resulting NAME is a string — and that name is the
            // artefact this block exists to build, since the ref-list machinery
            // (`nameIsRefArray` / `rlSlotByName`) keys on the declared spelling.
            //
            // Lockstep on the FINAL `synName` (B213 — not on the row index, which is an
            // intermediate): 0 disagreements. The arena arm answers on 1 corpus file
            // (`arrays/infer-build-struct.vl`, `{v: i32}` -> `P`), which is what makes the 0
            // a replacement rather than an inert arm.
            let synName = synElem
            const synNom = arrElemNominalOfTy(synInit)
            if synNom != "" { synName = synNom }
            // Re-forming an ARRAY name from an element name RE-GROUPS a union
            // element: `Cat|Dog[]` binds the `[]` to the last member, which is a
            // different type, so the annotation the source would have written is
            // `(Cat | Dog)[]`. Same rule, same test as `rlCanonLitUnionAtoms`'s
            // array descent and `ensureRefElemTy`'s paren branch — the three are
            // the array grammar's one re-wrap, asked at the three sites that
            // re-form a name. A bare element name is unaffected.
            let synArr = synName + "[]"
            if unionMemberCount(synName) > 1 { synArr = "(" + synName + ")[]" }
            // THE ARRAY'S OWN RECORDED TYPE, not a re-parse of the name just re-formed
            // from its element — but ONLY where the SPELLING DENOTES THE TYPE BEING
            // HANDED, which is `emit_rewrite`'s rule for this exact move and is stated
            // there as absolute. `nodeArrayElemName` above read `nodeTyIxOf(synInit)` to
            // get the element, so the array type is in hand; re-resolving `synArr`
            // through `nameToTy` mints a structurally duplicate row (it does not
            // hash-cons). That is the saving, and it is only collectable where the two
            // agree.
            //
            // THE STRUCT ARM IS EXACTLY WHERE THEY DO NOT. `synName != synElem` means the
            // three lines above swapped a struct element's structural rendering
            // (`{v: i32}`) for its DECLARED name because the ref-list tables key on that
            // spelling — so the NAME resolves to the declared `TypeDecl`'s arena row while
            // the recorded type is the object literal's OWN row. Those are structurally
            // equal and NOT interchangeable here: the rep layer keys a struct NOMINALLY
            // (`repSlotOfTyDecl` is an arena-index lookup with no structural bridge, and
            // `rlInternNameTy` records the consequence — "declared struct twins stay
            // apart"), so the handed row keys `HC_OBJ(fields…)` where the named row keys
            // `HC_SLOT(si)`.
            //
            // MEASURED, because "they are the same type" is the reading that made this
            // wrong: instrumenting the site to compare `repElemId` of the handed row
            // against `repElemId` of the name-resolved row over the corpus finds them
            // DISAGREEING on `arrays/infer-build-struct.vl` — `arr=[P[]] elem=[{v: i32}]`
            // — and agreeing everywhere else. The 2026-08 structural ruling settles that
            // they are one TYPE; it does not make them one ROW to a layer that keys
            // nominally on purpose.
            //
            // A UNION ELEMENT STILL HANDS OVER, and the gate lets it: the paren re-wrap
            // above changes the array's GROUPING (`Cat|Dog[]` would bind `[]` to the last
            // member) without touching the element spelling, so `synName == synElem` holds
            // and the re-wrapped name denotes exactly the handed array.
            let synTyIx = -1
            if synName == synElem { synTyIx = nodeTyIxOf(synInit) }
            const synTy = synthTypeRefTy(synArr, -1, synTyIx)
            // This synthesis postdates the last `collectA` run, so the intern pass
            // cannot bank the node's ref-list row — record it here, at the mint, on
            // the same predicate `collectA`'s arm uses. `rlSlotByName` (not
            // `ensureRefElem`) because a late intern would append a row past the
            // resolved heap tables; a spelling with no row stays uncovered.
            if nameIsRefArray(synArr) {
              recordAnnRlSlot(synTy, rlSlotByName(synName), 0)
            }
            s.letType = synTy
          }
        }
      }
    }
  }
  0
}

// SYNTHESIZE the `T | null` ANNOTATION of an un-annotated binding whose initializer is
// already nullable — the sibling of `synthEmptyListAnn` above, and it exists for the same
// reason: an annotation is the ONE input every downstream path reads, so writing the
// inferred type back as one makes the slot classifier agree without teaching it to
// re-infer.
//
// THE DEFECT. `const v = m["k"]` then `if v is i32` failed with `emitProgram: is test but
// no union type declared` on a two-line program with NO union anywhere. The ANNOTATED twin
// worked (#1901 made it correct as well as compiling), and so did an inferred binding off a
// FUNCTION returning `i32 | null` — because that function's return ANNOTATION is what the
// registration walk reads. A map read has an annotation on NEITHER side.
//
// IT FOLLOWED THE REP SPLIT: `string | null` (a nullable ref) and `boolean | null` (an i32
// sentinel) worked, because their `is` needs no box. The numeric widths and a list value
// rep as the BOX, and the box is what went unminted.
//
// THIS IS HALF THE FIX. `collectU` is the FIRST emit pass and reads the annotation node
// directly, so it cannot wait for a synthesis twelve passes later — it seeds its
// registration walk from the INITIALIZER's recorded type instead (see `collectInlineUnions`).
// Registration alone leaves ``is` names a type that is not a union variant`; this annotation
// alone is never seen. Both, and it lowers.
// Whether `initIx` is the one initializer shape this change claims: a bare read of a
// SCALAR-valued map, whose `V | null` result reps as the shared value box.
//
// SCOPED TO MAP READS, NOT TO "ANY NULLABLE OF A BOX REP", and the narrowing was forced
// by measurement rather than chosen. Claiming every box-rep nullable DIVERTED working
// bindings onto the annotated ladder — 9 corpus regressions, then 2 after excluding the
// niches by hand, and the survivors were nullable numeric LITUNIONS, which answer
// `tyScalarBaseIs(f64)` (they rep as their base scalar, #1866). The base-scalar question
// and the nullable-rep question have different answers there, so a predicate built from
// the first will keep mis-claiming.
//
// CORRECTED BY D6: this header used to finish that sentence "…while their NULLABLE reps as
// the -1 niche", and so did both `mapReadScalarBoxKind*` twins. That is false. The `-1`
// sentinel is the STRING litunion's — an interned atom ID leaves every negative spare —
// while a numeric litunion reps as THE NUMBER, so `1 | 2 | null` is the value-union BOX
// (`nulNumLitUnionBaseName`'s header states the rule the rest of this comment contradicted).
// The nullable numeric litunion belongs IN this claim, not outside it, and it is in it now.
//
// A map read is what this change is FOR and it is decidable directly
// (`mapReadScalarBoxKind` is the same predicate #1901's coerce arm uses, so the two
// halves of the map-read story cannot drift). Every other inferred nullable binding keeps
// exactly the lowering it has today.
function initNullableIsBoxScalar(initIx: i32) {
  if initIx < 0 { return false }
  mapReadScalarBoxKindTy(initIx) >= 0
}

export function synthNullableAnn(letIx: i32) {
  const s = P.nodes[letIx]
  if s is LetDecl {
    if s.letType >= 0 { return 0 }
    if s.letInit < 0 { return 0 }
    const nty = nodeTyIxOf(unwrapParen(s.letInit))
    if nty < 0 { return 0 }
    const nt = T.tys[nty]
    if nt is TyNullable {
      // An UNFILLED hole (`let x = null`, inner -1) is A-infer-null's business — it has its
      // own usage-driven inference (`nliInferLet`) and no type to render yet.
      if nt.nInner < 0 { return 0 }
      // ONLY THE BOX REPS. Every other `T | null` already has a niche that carries
      // "absent" — `boolean` and a STRING litunion ride an i32 sentinel (2 / -1), and a
      // string, struct, list, map or variant rides a nullable ref — and those bindings
      // CLASSIFY AND LOWER CORRECTLY TODAY without an annotation. Synthesizing one for them
      // does not add a path, it DIVERTS a working one onto the annotated ladder, which
      // expects a different slot: measured, that broke 9 corpus cases (`only i32 locals are
      // supported`, `is names a type that is not a union variant`) across nullable mono
      // maps, nullable litunions and union-valued reads.
      //
      // The four numeric widths were filed as the whole residue; the NUMERIC LITUNION is a
      // fifth (D6), because it too reps with no spare bit pattern — its rep is the number.
      // The word STRING above is load-bearing and was missing.
      if mapReadScalarBoxKindTy(s.letInit) < 0 { return 0 }
      const nm = tyToEmitName(nty)
      if nm == "" { return 0 }
      // Hand the RECORDED type over rather than re-parsing the rendered name — but ONLY
      // WHERE THE SPELLING DENOTES THE TYPE BEING HANDED, which is `emit_rewrite`'s rule
      // for this move and the same gate the inferred-array synthesis above applies. Where
      // it does, re-resolving would mint a structurally duplicate arena row.
      //
      // A NULLABLE NUMERIC LITUNION IS WHERE THEY DO NOT AGREE (D6). `tyToEmitName` renders
      // the REP, and a numeric litunion reps as its BASE SCALAR (#1866), so `N2 | null`
      // renders `i32|null` — a spelling that does not denote `TyNullable<1|2>`. Recording
      // the handed row under it left `unRowOfCanon(annRowOfNode(letType))` at -1, so
      // `letUnionNameOf` answered "" for a binding whose union NAME was registered
      // (`isUName` said yes; the CANON-keyed row lookup said no), `emitIdentNode`'s
      // narrowed-arm gate skipped the unbox, and the raw `(ref $uBox)` went straight into
      // `print`'s i32 parameter: `vl check` rc 0, invalid wasm.
      //
      // A SOURCE `const v: N2 | null` never hits this, and that is the tell — CANON rewrites
      // the annotation's spelling to `i32|null` and REBANKS its row in the same move, which
      // is what `annRowOfNode`'s canon leg reads. This is that rebanking, for a node canon
      // never sees.
      let synTyIx = nty
      if nulNumLitUnionBaseName(nty) != "" { synTyIx = -1 }
      s.letType = synthTypeRefTy(nm, -1, synTyIx)
    }
  }
  0
}

// The value spelling at the BOTTOM of a chain of map spellings — `Circle` for both
// `{[string]: Circle}` and `{[string]: {[string]: Circle}}` — or "" when `name` is not a map
// at all. `mapValNameOf` is one cut; this is the transitive closure of it, which is what the
// two arm-pin gates below need (silent-class-inventory D156).
//
// TERMINATION IS STRUCTURAL, not the bound: every cut strictly shortens the spelling. The
// hop limit is the same recursion guard `dstPinSrcIsAt` carries and for the same reason —
// the spelling is not this pass's to trust.
//
// `mapValNameOf`'s own documented hazard needs no extra fence: it accepts
// `{[string]:i32}|null` and returns the garbled `"i32}|nul"`, which is not a map spelling, so
// the loop stops on it and the `variantIndexOf` gate at every caller rejects it.
function mapLeafValName(name: string) {
  let cur = mapValNameOf(name)
  if cur == "" { return "" }
  let hops = 0
  while hops < 8 {
    const nxt = mapValNameOf(cur)
    if nxt == "" { return cur }
    cur = nxt
    hops = hops + 1
  }
  cur
}

// Does `name` — a spelling ONE cut below a map annotation — reach a union ARM through
// FURTHER map hops, at a depth the one-cut rung above cannot see, AND is that arm's layout
// UNCONTESTED?
//
// THE GATE IS MEASURED, NOT ARGUED (silent-class-inventory D171). Un-gated, the deeper rung
// moves 32 `loud emit reject` cells of the D156 position grid to `runs` with 0 backward
// where no layout twin is declared, and 20 silent cells to `runs` at the cost of 12
// `runs` -> check-clean invalid wasm where one is. The contested half is not a weaker
// version of the same win: it needs the pin CHAIN complete at every position, including
// across an un-annotated parameter and across a call, and a half-pinned chain is worse than
// an un-pinned one because the un-pinned one rides the arm/twin conflation the mv and
// ref-list layers still carry. `armLayoutContested` is D39's own channel question — "does
// this anonymous shape have two nominal claimants" — asked of the arm rather than of the
// literal.
function pinArmDeepUncontested(name: string) {
  if name == "" { return false }
  const leaf = mapLeafValName(name)
  if leaf == "" { return false }
  if variantIndexOf(leaf) < 0 { return false }
  !armLayoutContested(leaf)
}

// THE NAME-SIDE FORM of `armPinAnnName`'s ref-list rung below: "does this SPELLING name a
// ref-list of a union ARM" — `Circle[]` yes, `Circle` no (that is rung 1), `{[string]:
// Circle}` no (that is the map rung), `i32[]` no.
//
// IT EXISTS BECAUSE THE ELEMENT HAS NO NODE. `armPinAnnName` takes a type-annotation INDEX
// and asks `retRefArrFlag` / `retRefArrElemName` of it; `dstPinPushAnn`'s ELEMENT arm has
// already taken one `[]` cut off the destination and holds a bare STRING, so it cannot ask
// the node-keyed rung at all. Its own header says it is "`armPinAnnName`'s own ref-list
// rung, asked for the element instead of the container" — and the copy it made was rung 1
// (`variantIndexOf`), which answers only for a BARE arm. This is rung 2 in the form that
// arm can actually call.
//
// SILENT-CLASS-INVENTORY D184, and the whole defect is that one missing rung.
// `const c: Circle[][] = [lv1]` cuts to the element spelling `Circle[]`; the variant table
// holds `Circle` and can never claim `Circle[]`, so the copy declined and `en` came back
// `""`. Declining is not neutral there: `dstPinAnnIn` records `""` as a destination
// DISAGREEMENT (`:1307`), so the one delivery vetoes the pin — exactly the shape the
// nested-MAP half had before #1966. Un-pinned, `lv1` builds the layout twin's row
// (`structIndexOfObj` finds `Dot`, whose field set matches) while the annotated destination
// declares the arm's, and the module the engine refuses says `expected (ref null $type),
// found (ref $type)` at `vl check` rc 0. The flat `Circle[]` spelling of the same program
// RUNS, which is the control that says the pin already handles this element once it is
// asked the right question.
//
// `arrLeafNameOf` IS THE PEEL, not a sixth hand-rolled copy of it. Its header names the five
// copies of the one-level cut that already exist and the drift they risk; it is the exported
// fixpoint of `arrElemNameRaw` and the structural analogue of `mapLeafValName` above, with
// 15 callers in the monomorphizer and generics and — until here — none in this family. Taken
// to the LEAF rather than one cut so `Circle[][]` in element position answers too; that
// depth is not reachable from `armPinLitInit`'s producers today (see the decline recorded on
// `armPinAnnName`'s own rung), and the leaf peel is the spelling that cannot drift.
//
// NO `armLayoutContested` GATE, and the difference from the map rung above is deliberate.
// That gate is D171's MEASURED boundary on the DEEP MAP peel, where an un-pinned chain is
// internally consistent by accident and pinning only its outer level is worse than pinning
// none. The rung this is the name-side form OF has never carried the gate: it fires today
// for a `Circle[]` destination with `Dot` declared, which is D184's own `flat Circle[] RUNS`
// control. Gating the same rung asked by name would make the element position stricter than
// the container position it copies.
function pinArmListName(name: string) {
  if name == "" { return false }
  const leaf = arrLeafNameOf(name)
  if leaf == name { return false }
  variantIndexOf(leaf) >= 0
}

// THE ONE HOME for "does this type ANNOTATION name a concrete union ARM a literal must be
// pinned onto" — the gate `synthRetPinAnn` was written with, and `synthDstPinAnn` re-reads
// it for two more destinations. A bare arm (`Circle`) or a ref-list OF one (`Circle[]`);
// "" for everything else, which is the whole of "this seam does not apply".
//
// `retVariantFlag` is the predicate a variant PARAM/RESULT cell is emitted from (its own
// header: "feeds the `kind == 8` (concrete variant struct ref) branch of `pushVT`"), so
// gating on it is the same agreement-by-construction rule `fnRetVariantIndexSid` states:
// the pin fires exactly where the destination's own cell is the unboxed variant ref.
function armPinAnnName(tyIx: i32) {
  if tyIx < 0 { return "" }
  if retVariantFlag(tyIx) == 1 { return tyNameOf(tyIx) }
  if retRefArrFlag(tyIx) == 1 {
    const rae = retRefArrElemName(tyIx)
    if rae != "" {
      if variantIndexOf(rae) >= 0 { return tyNameOf(tyIx) }
      // NOT WIDENED TO `pinArmListName(rae)` HERE, and the decline is measured rather than
      // assumed (silent-class-inventory D184's own ablation). Widening this rung to accept a
      // `Circle[][]` ANNOTATION is reachable — the condition fires on three corpus fixtures —
      // and it moves NOTHING: 0 of the four filed witnesses, 0 corpus bytes against the rung
      // below it (1,989 modules re-built and `cmp`-identical), and 0 cells either way on
      // census blocks C and D. It cannot fire usefully either, by the shape of the caller:
      // `dstPinAnnIn` and `synthRetPinAnn` both require `armPinLitInit`, whose widest
      // producer is an ArrayLit with an OBJECT-LITERAL first element — a value of depth ONE,
      // which this rung already claims through `variantIndexOf`. A depth-2 annotation over a
      // depth-1 producer is a type error the checker refuses first.
      //
      // RE-MEASURED AGAINST THE DEEPER CUT (silent-class-inventory D243), because "0
      // witnesses today" is a fact about the population and D243 was the reason to suspect
      // the population had grown: `dstPinPushAnn`'s element scan now descends to any depth,
      // so a `Circle[][][]` destination really does reach the pin. It reaches it through
      // `dstPinElemAnnName`, the ELEMENT side, which carries `pinArmListName` already. This
      // rung is the WHOLE-VALUE side and its caller's producer set is unchanged, so the
      // decline still holds — and it is measured, not argued: with A+B+C in place, adding
      // `if pinArmListName(rae) { return tyNameOf(tyIx) }` here moves 0 of 3,200 cells on
      // the list-container block P, 0 of 160 on the box/arm block Q, and 0 of 2,332 corpus
      // modules (every one `cmp`-identical). Widen it only with a program that moves.
    }
  }
  // A MAP whose VALUE names an arm (`{[string]: Circle}`), the third container the seam
  // reaches — and the newest, because it only became reachable when #1954 taught the
  // arm-valued map to lower under the inline spelling. Before that an annotated
  // `const c: {[string]: Circle} = Map()` was itself a loud floor, so there was nothing
  // for a pin to land on; today that spelling RUNS and the un-annotated twin does not,
  // which is this whole family's signature (silent-class-inventory D87).
  //
  // `mapValNameOf` is the value cut and `variantIndexOf` the gate. That gate also fences
  // off the cut's own documented hazard — its header records that it accepts
  // `{[string]:i32}|null` and returns the garbled `"i32}|nul"`, a spelling the variant
  // table can never claim.
  const mvn = mapValNameOf(tyNameOf(tyIx))
  if mvn != "" {
    if variantIndexOf(mvn) >= 0 { return tyNameOf(tyIx) }
    // …AND AT EVERY DEPTH, not one (silent-class-inventory D156). `mapValNameOf` is a single
    // cut, so `{[string]: {[string]: Circle}}` answered `{[string]:Circle}` — a spelling the
    // variant table can never claim — and the rung DECLINED. Declining here is not neutral:
    // `dstPinPushAnn` records the "" as a destination DISAGREEMENT, so ONE nested-map
    // delivery vetoes the pin every other delivery of that binding agreed on. 36 of the D88
    // grid's 44 surviving silent cells were exactly that.
    if pinArmDeepUncontested(mvn) { return tyNameOf(tyIx) }
  }
  ""
}

// A LITERAL producer, bare or one list deep — the second half of the shared gate, for the
// reason `synthRetPinAnn`'s header gives: an object literal's row is chosen by a field-set
// SCAN, so it is the one producer an annotation may re-aim without contradicting a decision
// made elsewhere. A local initialized from a CALL, an IDENT or a param already carries its
// producer's committed rep, and re-pinning it would move a value rather than name it.
function armPinLitInit(initIx: i32) {
  if initIx < 0 { return false }
  const iv = P.nodes[unwrapParen(initIx)]
  if iv is ObjLit { return true }
  if iv is ArrayLit {
    if iv.arrElems.length >= 1 {
      const e0 = P.nodes[unwrapParen(iv.arrElems[0])]
      if e0 is ObjLit { return true }
    }
  }
  // A BARE `Map()` / `Set()` CONSTRUCTOR is a literal producer by the same rule the two
  // above satisfy, and the rule is what licenses it rather than the resemblance: an empty
  // map commits NO value rep at its initializer, so its slot is chosen by later use and an
  // annotation can re-aim it without contradicting a decision made elsewhere. A local
  // initialized from a CALL, an IDENT or a param already carries its producer's committed
  // rep — and a map-RETURNING call is exactly that, which is why this tests the
  // constructor NAME rather than asking `exprMap`.
  if iv is Call {
    const mc = P.nodes[unwrapParen(iv.callFn)]
    if mc is Ident {
      if mc.identName == "Map" || mc.identName == "Set" {
        if iv.callArgs.length == 0 { return true }
      }
    }
  }
  false
}

// SYNTHESIZE the RETURN ANNOTATION onto an un-annotated local that IS the function's
// returned value and whose initializer is an anonymous object literal — the third member of
// the `synthEmptyListAnn` / `synthNullableAnn` family, here for the reason their headers
// give: "an annotation is the ONE input every downstream path reads, so writing the inferred
// type back as one makes the slot classifier agree without teaching it to re-infer".
//
// THE DEFECT (silent-class-inventory D39). `function mk(n: i32): Circle { const o = { r: n }
// return o }`, in a program declaring `type Shape = Circle | Sq` beside an exact layout twin
// `type Dot = { r: i32 }`, is `vl check` rc 0 with NO diagnostics and a module the engine
// refuses: `type mismatch: expected (ref $type), found (ref $type)`. Eleven lines, no import,
// no generic, no lambda. The `[{ r: n }]` list spelling is the same row.
//
// AN ANONYMOUS SHAPE HAS TWO NOMINAL CLAIMANTS AND ONLY THE CONTEXT SEPARATES THEM.
// `structIndexOfObj` scans the STRUCT table by field set and finds `Dot`; `objVariantName`
// scans the VARIANT table and finds `Circle`; the ladder every consumer walks asks the struct
// table first, so the local builds `Dot`'s row while the RESULT boundary — driven by the
// annotation, which is nominal and unambiguous — declares `uVarHeap[Circle]`. Neither scan is
// wrong: with no annotation at all (`function mk(n: i32) { … }`) `Dot` is the right answer and
// the program RUNS, which is why this cannot be fixed by reordering the ladder. It is the
// ANNOTATION that decides, and the un-annotated local never saw it.
//
// SCOPED TO THE STRUCT/VARIANT SEAM, WHICH IS THE ONLY ONE THAT CANNOT BRIDGE. Two DECLARED
// structs of the same layout merge at the heap layer (`sTwin`), so `: Dot` over a literal that
// resolved to a same-shape `Circle` row runs today and is untouched here — measured as D39's
// own `Sq`/`Shape`-deleted control, which RUNS. A union ARM does not merge with a struct row
// and must not: `DECISIONS.md` records that seam as NOMINAL, and D32/D33/D34 are the three
// rungs already placed under that ruling. So the gate is exactly "the return annotation names
// a CONCRETE VARIANT, or a list of one" — the pin fires only where a structural bridge is
// unavailable by ruling.
//
// AND ONLY OVER A LITERAL. The initializer must be an object literal (or a list whose first
// element is one): those are the producers whose row is chosen by a field-set scan and so are
// the ones an annotation can re-aim without contradicting a decision made elsewhere. A local
// initialized from a CALL, an IDENT or a param already carries its producer's committed rep,
// and re-pinning it would move a value rather than name it.
//
// The synthesized node hands the annotation's OWN recorded type over (`synthTypeRefTy`)
// rather than re-resolving its spelling, which is `emit_rewrite`'s rule for this move: the
// spelling denotes exactly the type being handed, and `nameToTy` does not hash-cons, so a
// re-parse would mint a structurally duplicate row.
//
// Returns 0 always; the mutation is `s.letType`, in place — the same contract as its two
// siblings.
export function synthRetPinAnn(letIx: i32, fnIx: i32) {
  if fnIx < 0 { return 0 }
  const s = P.nodes[letIx]
  if s is LetDecl {
    if s.letType >= 0 { return 0 }
    if s.letInit < 0 { return 0 }
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      if fn.fnRet < 0 { return 0 }
      // THE GATE: a concrete-variant return, bare or as a ref-list element. Anything else
      // either bridges structurally already or is not this seam. `armPinAnnName` is the
      // one home for it, shared with `synthDstPinAnn` below — the two syntheses differ in
      // WHICH annotation they read, never in which annotations qualify.
      const pinName = armPinAnnName(fn.fnRet)
      if pinName == "" { return 0 }
      // THE RETURNED LOCAL: the function's tail value (or its first valued `return`) is a
      // bare ident that resolves — through an UN-ANNOTATED alias chain — to THIS binding.
      // `retLocalLetOfBlock` is the same lookup `criRetLocalLet` makes for the result-valtype
      // pass, shared rather than copied so the two cannot disagree about which binding
      // supplies the returned value. The chain is what puts the pin on the let that holds the
      // LITERAL rather than on an intermediate that merely names it: `const o0 = { r: n }
      // const o = o0  return o` needs `o0` pinned, since annotating `o` alone would ask for
      // a coercion between two heap types that has no adapter.
      const rx = fnRetExprOf(fnIx)
      if rx < 0 { return 0 }
      if retLocalLetOfBlock(fn.fnBody, rx) != letIx { return 0 }
      // A LITERAL producer, bare or one list deep.
      if !armPinLitInit(s.letInit) { return 0 }
      // D501 — the same decline as `dstPinAnnIn`'s, at the pin that has no
      // destination-agreement gate at all. `synthRetPinAnn` reads ONLY the return
      // annotation, so a second destination of the other element kind cannot make it
      // disagree; `dstPinAnnIn` declines these cells on its own gate and this one then
      // pins them anyway from `collectLocals`. 8 of D501's 28 cells.
      if letListDestKindConflict(letIx, fnIx) { return 0 }
      const pinTy = synthTypeRefTy(pinName, -1, nodeTyIxOf(fn.fnRet))
      // The ref-list ROW, banked on the new node at its mint — this synthesis postdates
      // the last `collectA` run, exactly as `synthEmptyListAnn`'s does, so the intern
      // pass cannot cover the node. The row is the one the RETURN annotation already
      // interned for the same spelling, which is what makes the local's wrapper and the
      // function's result wrapper one slot rather than two.
      const pinSlot = tyAnnRefListSlot(fn.fnRet)
      if pinSlot > 0 { recordAnnRlSlot(pinTy, pinSlot, 0) }
      s.letType = pinTy
    }
  }
  0
}

// SYNTHESIZE THE DESTINATION'S ANNOTATION onto an un-annotated local whose initializer is
// an anonymous object literal — `synthRetPinAnn`'s sibling at the destinations a `return`
// is not (silent-class-inventory D81).
//
// THE DEFECT. Twelve lines, no import, no generic, no lambda, no list:
//
//     type Circle = { r: i32 }   type Sq = { s: i32 }
//     type Shape = Circle | Sq   type Dot = { r: i32 }
//     let gsto: Circle = { r: 0 }
//     function mk(n: i32) { const c = { r: n }  gsto = c  return n }
//     mk(7)   print((gsto).r)
//
// `vl check` rc 0 with one redundant-annotation HINT and no error, and a module the engine
// refuses: `type mismatch: expected (ref $type), found (ref $type)`.
//
// IT IS D39'S CHANNEL PROBLEM AND THE ANSWER IS THE SAME ONE. An anonymous `{ r: n }` has
// TWO nominal claimants — `structIndexOfObj` scans the STRUCT table by field set and finds
// `Dot`, `objVariantName` scans the VARIANT table and finds `Circle` — and NEITHER SCAN IS
// WRONG: delete `Dot` and the same program is a LOUD `ref valtype with no interned shape`,
// delete the union and it RUNS on `Dot`'s row. So this cannot be fixed by reordering the
// ladder and it cannot be fixed by finding an un-called complement; only the CONTEXT
// separates the two claimants, and the context is an annotation the literal never sees.
// That is the one exception the eight preceding rungs of this family did not need, and
// `synthRetPinAnn`'s header states the test it is recognised by.
//
// FOUR DESTINATIONS, NOT TWO, AND THE ROW ONLY HAD THE TWO ITS GRID VARIED. D81 filed the
// module GLOBAL (48 cells) and the callee PARAM (40) because the D52 grid's `cons` axis
// had exactly those two levels. Measured on the same master seed, an ANNOTATED LOCAL is
// the same sentence at the same class in both its spellings — `const o: Circle = c` and
// `let o: Circle = { r: 0 }` … `o = c`. All four are one question asked of one node kind
// or the other, so they are one scan:
//
//     gsto = c            a module GLOBAL assignment      -> the global's `letType`
//     thru(c)             a callee PARAM                  -> that parameter's `parType`
//     const o: Circle = c an annotated LOCAL binding      -> the binding's `letType`
//     o = c               an annotated LOCAL assignment   -> that binding's `letType`
//
// A STRUCT FIELD is NOT among them and that is measured, not assumed: `const b: Box = { c: c }`
// over `type Box = { c: Circle }` is the LOUD `only i32 / boolean / string / array struct
// fields are supported` on master — a different floor, a different row, and re-aiming the
// literal would not reach it.
//
// EVERY DESTINATION MUST AGREE, WHICH IS THE SAFETY PROPERTY. VL is structurally typed, so
// one `{ r: n }` may legally be delivered to a `Circle` global AND to a `Dot`-annotated
// parameter; pinning either spelling would break the other. The scan therefore collects
// EVERY delivery of the binding and declines unless all of them name the same arm — a
// destination whose annotation is a plain struct answers "" through `armPinAnnName` and so
// disagrees by construction. A binding with no delivery at all is left exactly as master
// has it.
//
// SCOPED TO THE STRUCT/VARIANT SEAM, the same scoping `synthRetPinAnn` carries and for the
// same reason: two DECLARED structs of one layout merge at the heap layer (`sTwin`), so a
// `: Dot` destination over a literal that resolved to a same-shape row runs today; a union
// ARM does not merge with a struct row and must not, because `DECISIONS.md` records that
// seam as NOMINAL. `armPinAnnName` is that gate, shared with `synthRetPinAnn` so the two
// syntheses cannot drift about which annotations qualify.
//
// Returns 0 always; the mutation is `s.letType`, in place — the family's contract.
export function synthDstPinAnn(letIx: i32, fnIx: i32, rootIx: i32) {
  if fnIx < 0 { return 0 }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    // THE ENCLOSING FUNCTION'S DECLARED RESULT IS A DESTINATION TOO, and it is handed to
    // the shared body rather than recorded in `dstPinScan` because it is one annotation
    // for the whole body however many `return`s reach it. It exists for the DISAGREEMENT
    // gate, not to pin: `function mk(n: i32): Dot { const c = { r: n }  gsto = c
    // return c }` has an arm-typed global destination and a plain-struct RESULT, and
    // pinning either spelling breaks the other. Without this the scan pinned `Circle` and
    // moved the failure from the `global.set` to the return — silent to silent, which an
    // outcome-class grader scores as no change and only a message diff catches (the
    // offset moved 191 -> 195). An UN-annotated result records nothing: an inferred
    // return is not a nominal claim, it is what D52's rung derives FROM the binding, and
    // recording -1 here would veto every ordinary cell in this row's own population.
    return dstPinAnnIn(letIx, fn.fnBody, fn.fnRet, fnIx, rootIx)
  }
  0
}

// THE MODULE-SCOPE TWIN (silent-class-inventory D139). A top-level binding is delivered to
// exactly the same four destinations a function-scoped one is, and the scan that finds them
// needs only a SCOPE to resolve identifiers in — so this is the same body with the PROGRAM
// node as that scope and no result annotation, not a second implementation.
//
// WHY IT IS A SEPARATE ENTRY POINT AND NOT A `fnIx < 0` ARM ON THE ONE ABOVE: the scope is
// a node the caller holds and the callee cannot derive. `fnStmts` has no row for the module
// and `globalStmts` holds the BINDINGS, not the statement list the deliveries live in.
//
// THERE IS NO RESULT DESTINATION AT MODULE SCOPE, hence the first `-1`: the module does
// not return, and its start function's result is synthesized rather than declared, so
// there is no annotation to disagree with. AND A GLOBAL IS RETURNED BY NOTHING, hence the
// second: `dstPinCallerDests` is gated on the binding being some function's tail value,
// and a top-level binding is not one, so there is no enclosing function to hand it.
function synthGlobalDstPinAnn(letIx: i32, rootIx: i32) {
  dstPinAnnIn(letIx, rootIx, -1, -1, rootIx)
}

// The shared body of both entry points: pin `letIx`'s annotation from the destinations it
// is delivered to WITHIN the scope `bodyIx`, with `retIx` the scope's declared result
// annotation (-1 where the scope has none). Split out for D139 — the two scopes differ in
// nothing but those two arguments, and a copy would be the second place the disagreement
// gate could drift.
function dstPinAnnIn(
  letIx: i32,
  bodyIx: i32,
  retIx: i32,
  fnIx: i32,
  rootIx: i32,
) {
  const s = P.nodes[letIx]
  if s is LetDecl {
    if s.letType >= 0 { return 0 }
    if !armPinLitInit(s.letInit) { return 0 }
    const dstN: string[] = []
    const dstT: i32[] = []
    if retIx >= 0 { dstPinRetDest(bodyIx, retIx, letIx, dstN, dstT) }
    dstPinScan(bodyIx, bodyIx, letIx, dstN, dstT)
    dstPinCallerDests(letIx, fnIx, rootIx, dstN, dstT)
    if dstN.length == 0 { return 0 }
    const pinName = dstN[0]
    if pinName == "" { return 0 }
    let i = 1
    while i < dstN.length {
      if dstN[i] != pinName { return 0 }
      i = i + 1
    }
    // D501 — DECLINE where the binding's own list literal has a SECOND declared
    // destination of the other element kind. The pin would commit the plain-struct row
    // and hide a program the emitter cannot lower either way; declined, the binding
    // reaches `letRefListDestSlot` and D411's positioned reject names it. 20 of D501's
    // 28 cells are pinned here (every one whose union destination is a map value or a
    // struct field — the two deliveries `dstPinScan` has no leg for — plus the four
    // that pair one of those with a `return`).
    if letListDestKindConflict(letIx, fnIx) { return 0 }
    // The annotation's OWN recorded type is handed over rather than re-resolved from the
    // spelling (`emit_rewrite`'s rule, and `synthRetPinAnn`'s): the spelling denotes
    // exactly the type being handed, and `nameToTy` does not hash-cons, so a re-parse
    // would mint a structurally duplicate arena row. `-1` is the ELEMENT pin, where the
    // spelling is a CUT of the destination's annotation rather than the annotation
    // itself — `synthTypeRefTy(n, p, -1)` is exactly `synthTypeRef`, its own header.
    let pinTyIx = -1
    if dstT[0] >= 0 { pinTyIx = nodeTyIxOf(dstT[0]) }
    const pinTy = synthTypeRefTy(pinName, -1, pinTyIx)
    // The ref-list ROW for a `Circle[]` destination, banked at the mint for the reason
    // `synthRetPinAnn` banks its own: this synthesis postdates the last `collectA` run,
    // so the intern pass cannot cover the node, and the row must be the one the
    // DESTINATION's annotation already interned or the two wrappers are two slots.
    if dstT[0] >= 0 {
      const pinSlot = tyAnnRefListSlot(dstT[0])
      if pinSlot > 0 { recordAnnRlSlot(pinTy, pinSlot, 0) }
    }
    s.letType = pinTy
    dstPinFired = dstPinFired + 1
  }
  0
}

// THE CALL SITE IS A DESTINATION TOO, for a binding its function RETURNS
// (silent-class-inventory D155). `function mkm() { const c = Map()  c["o"] = { r: 7 }
// return c }` with `thru(mkm())` beside it has NO destination inside `mkm` at all — the
// scan above collects nothing, `dstN.length == 0`, and the binding reaches the mv layer
// un-annotated while its directly-bound sibling (D139's repro) reaches it pinned. The
// deciding annotation exists and sits one scope out.
//
// THREE GATES, AND EACH ONE IS WHAT KEEPS THIS FROM BEING A WHOLE-PROGRAM SCAN PER
// BINDING:
//   · the enclosing function's result is UN-ANNOTATED — a declared result is the
//     destination, already recorded by `dstPinRetDest`, and a caller must not overrule it;
//   · the binding IS the value that function hands back (`retLocalLetOfBlock`, through an
//     un-annotated alias chain, exactly as every other rung of this family reads it);
//   · a scope is scanned only for a binding that passed both.
//
// EVERY CALLER SCOPE, NOT ONLY THE MODULE. `mkm` may be called from another function as
// easily as from top level, and D155's own last control — "wrap the call site in a
// function" — is silent at both, which is precisely what separates this row from D139
// (whose function-scope sibling RAN). The scan is the same `dstPinScan`, with each scope
// as its own `bodyIx`, so identifier resolution stays local to the scope being walked and
// a same-named binding in the caller cannot be mistaken for this one: `letIx` is an arena
// index, and `retLocalLetOfBlock(callerBody, ident)` answers with the CALLER's node.
//
// THE DISAGREEMENT GATE IS UNCHANGED AND DOES THE SAFETY WORK. Two call sites delivering
// `mkm()` to two differently-annotated destinations push two names and the pin declines,
// which is the same rule that already covers one binding delivered to two destinations
// inside one body. Measured: `thru(mkm())` beside `thrud(x: {[string]: Dot})` is
// check-clean invalid wasm at the SAME message and the SAME offset as master — untouched.
//
// AND THE COST IS MEASURED, NOT ASSUMED, because the shape of this scan is quadratic if the
// gates ever stop biting: self-compiling `compiler/entry.vl` takes 10.6s with this and 10.9s
// without it, i.e. inside the noise. The gates are why — a binding must be an un-annotated
// function's tail value AND pass `armPinLitInit` before any other scope is walked.
function dstPinCallerDests(
  letIx: i32,
  fnIx: i32,
  rootIx: i32,
  outN: string[],
  outT: i32[],
) {
  if fnIx < 0 { return 0 }
  if rootIx < 0 { return 0 }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    if fn.fnRet >= 0 { return 0 }
    const rx = fnRetExprOf(fnIx)
    if rx < 0 { return 0 }
    if retLocalLetOfBlock(fn.fnBody, rx) != letIx { return 0 }
    let fe = 0
    while fe < fnStmts.length {
      const ofx = fnStmts[fe]
      if ofx != fnIx {
        const ofn = P.nodes[ofx]
        if ofn is FuncDecl {
          dstPinScan(ofn.fnBody, ofn.fnBody, letIx, outN, outT)
        }
      }
      fe = fe + 1
    }
    // The MODULE's own statements, with the program node as the scope — the same shape
    // `synthGlobalDstPinAnn` uses and for the same reason: `dstPinScan` skips a `FuncDecl`
    // child, so the top-level walk sees the module's statements and no function's body
    // twice.
    dstPinScan(rootIx, rootIx, letIx, outN, outT)
  }
  0
}

// Collect, into the parallel `outN` / `outT`, the pin NAME every destination inside `ix`
// demands of the binding at `letIx`, and the annotation node to source its recorded type
// from (-1 = mint from the name). `bodyIx` is the enclosing function body — the scope
// identifier chains resolve in, and the recursion's root.
//
// A destination that carries NO nominal claim pushes `""`, which the caller reads as a
// DISAGREEMENT and declines on. That is the conservative direction on purpose: VL is
// structurally typed, so one `{ r: n }` may legally reach a `Circle` global and a
// `Dot`-annotated parameter, and pinning either spelling would break the other.
//
// IT DOES NOT DESCEND INTO A NESTED `FuncDecl`. `parentLetOf` resolves against `bodyIx`, so
// an identifier inside a nested function that SHADOWS the outer binding would resolve to
// the outer one and register a delivery that does not exist. The cost is that a delivery
// made from inside a lambda is not seen; the alternative is a false pin, and this family's
// standing rule is that the coarse direction must be the safe one (`monoNameIsAssigned`).
//
// `nodeChildren` is `ast.vl`'s one home for "the child arena indices of this node", which
// is what makes the walk total: a node kind added to the AST is covered here the moment it
// is covered there, rather than being silently skipped by a hand-written child set.
function dstPinScan(
  ix: i32,
  bodyIx: i32,
  letIx: i32,
  outN: string[],
  outT: i32[],
) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = P.nodes[ix]
  if ix != bodyIx {
    if n is FuncDecl { return 0 }
  }
  // FOUR LEGS, FOUR FUNCTIONS, and the split is what the ablation is run over: each was
  // built as its own compiler and swept against one grid, so "these are one root" is a
  // measurement here rather than a resemblance (the D39/D40/D41 precedent is that a
  // resemblance in this family is refuted as often as confirmed). The measurement says
  // they are THREE: the three moved sets are pairwise disjoint and their union is the
  // composed branch's exactly, so no leg closes another's cells and no cell needs two.
  dstPinGlobalAssign(ix, bodyIx, letIx, outN, outT)
  dstPinLocalDest(ix, bodyIx, letIx, outN, outT)
  dstPinCallArgs(ix, bodyIx, letIx, outN, outT)
  dstPinMapValue(ix, bodyIx, letIx, outN, outT)
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    dstPinScan(kids[k], bodyIx, letIx, outN, outT)
    k = k + 1
  }
  0
}

// Does any `return` inside `bodyIx` hand back the binding at `letIx`? If so, record the
// enclosing function's declared result `retIx` as one of its destinations.
//
// `fnRetExprOf` is not enough here: it answers with the function's TAIL value, and a
// binding can reach an earlier `return` instead. This walks every `RetStmt` in the body,
// which is the same totality `dstPinScan` gets from `nodeChildren` and for the same reason.
function dstPinRetDest(
  bodyIx: i32,
  retIx: i32,
  letIx: i32,
  outN: string[],
  outT: i32[],
) {
  dstPinRetWalk(bodyIx, bodyIx, retIx, letIx, outN, outT)
}

function dstPinRetWalk(
  ix: i32,
  bodyIx: i32,
  retIx: i32,
  letIx: i32,
  outN: string[],
  outT: i32[],
) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = P.nodes[ix]
  if ix != bodyIx {
    if n is FuncDecl { return 0 }
  }
  if n is RetStmt { dstPinPushAnn(retIx, n.retArg, bodyIx, letIx, outN, outT) }
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    dstPinRetWalk(kids[k], bodyIx, retIx, letIx, outN, outT)
    k = k + 1
  }
  0
}

// Record what the destination annotated `annIx` demands of `letIx`, given that `srcExpr`
// is the expression delivered to it. Nothing is recorded unless the binding actually
// reaches this destination — a destination fed by something else is not this binding's
// business and must not veto its pin.
//
// TWO DELIVERY SHAPES, and the second is why this is a function rather than a push. A
// WHOLE-VALUE delivery (`gsto = c`) wants the destination's own spelling. An ELEMENT
// delivery (`const xs: Circle[] = [c]`) wants the ELEMENT's: the binding holds the element
// and the LIST is built at the destination, so pinning `Circle[]` onto a local holding one
// object would be a different program. `retRefArrElemName` is the cut, gated on the
// element actually naming an arm — which is `armPinAnnName`'s own ref-list rung, asked for
// the element instead of the container.
function dstPinPushAnn(
  annIx: i32,
  srcExpr: i32,
  bodyIx: i32,
  letIx: i32,
  outN: string[],
  outT: i32[],
) {
  if srcExpr < 0 { return 0 }
  if dstPinSrcIs(bodyIx, srcExpr, letIx) {
    outN.push(armPinAnnName(annIx))
    outT.push(annIx)
    return 0
  }
  // THE ELEMENT DELIVERY, AT WHATEVER DEPTH THE BINDING ACTUALLY SITS AT
  // (silent-class-inventory D243). This arm used to iterate `av.arrElems` ONCE and ask
  // `dstPinSrcIs` of each, so it saw exactly one list level: `const c: Circle[][][] =
  // [[lv1]]` has the single element `[lv1]`, which is not the binding, the loop found
  // nothing, NO destination was recorded, and the pin never ran. The predicate was already
  // right — `pinArmListName` answers `true` for the element spelling `Circle[][]` — so the
  // cut is the SCAN's depth and not the gate's, which is why D184's one-cut fix could not
  // reach it.
  //
  // A DEPTH AND NOT A BOOLEAN, because the pinned SPELLING has to match the level the
  // binding is at: at depth 1 the destination's element is `Circle[][]`, at depth 2 it is
  // `Circle[]`, and pinning either onto a value holding the other is a different program.
  const ed = dstPinElemDepthAt(bodyIx, srcExpr, letIx, 0)
  if ed > 0 {
    outN.push(dstPinElemAnnName(annIx, ed))
    outT.push(-1)
  }
  0
}

// How many LIST levels below `ex` the binding at `letIx` sits, or -1 when it is not among
// its elements at any depth. Never 0: the WHOLE-VALUE delivery is the caller's own first
// question, and asking it twice would pay for `dstPinSrcIs`'s alias walk twice.
//
// TWO WAYS DOWN A LEVEL, AND THE SECOND IS THE ONE WITH NO GRID BEHIND IT. A nested
// `ArrayLit` (`[[lv1]]`) is the obvious one. The other is an UN-ANNOTATED BINDING whose
// initializer is a list literal (`const mid = [lv1]` … `const c: Circle[][] = [mid]`) —
// the same "an un-annotated binding is a LINK in the chain, not the end of it" rule
// `dstPinLocalDest` already applies to a whole-value alias and `retLocalLetOfBlock`
// implements for it, asked one container out. `dstPinLocalDest`'s `letType >= 0` guard
// already keeps such a binding from recording a "" DISAGREEMENT; without this rung it also
// contributed no destination, so the binding it links had none at all.
//
// AN ANNOTATED intermediate is NOT followed, and that is the same boundary the alias walk
// stops at: an annotation is its own nominal claim about the value, so it is a destination
// to agree with rather than a level to descend through.
//
// Depth-bounded for `dstPinSrcIsAt`'s reason — the arena is not this pass's to trust, and
// four levels is far past any spelling measured. The IDENT rung recurses at the SAME depth
// (the binding is not itself a container level; its initializer's elements are), so the
// bound is still consumed only by real `[]` levels and a `const a = [b]  const b = [a]`
// pair terminates on it.
function dstPinElemDepthAt(bodyIx: i32, ex: i32, letIx: i32, depth: i32): i32 {
  if ex < 0 { return -1 }
  if depth > 4 { return -1 }
  if depth > 0 {
    if dstPinSrcIs(bodyIx, ex, letIx) { return depth }
  }
  const u = unwrapParen(ex)
  const n = P.nodes[u]
  if n is ArrayLit {
    let i = 0
    while i < n.arrElems.length {
      const d = dstPinElemDepthAt(bodyIx, n.arrElems[i], letIx, depth + 1)
      if d > 0 { return d }
      i = i + 1
    }
    return -1
  }
  if n is Ident {
    const li = dstPinUnannListLet(bodyIx, n.identName)
    if li >= 0 && li != letIx {
      const ld = P.nodes[li]
      if ld is LetDecl {
        return dstPinElemDepthAt(bodyIx, ld.letInit, letIx, depth)
      }
    }
  }
  -1
}

// The binding `name` resolves to, when it is UN-ANNOTATED and its initializer is a list
// LITERAL — the one shape the depth walk above may descend through — else -1. Local first
// then global, which is the order every storage-class dispatch in this family uses so a
// binding SHADOWING a same-named global answers for the cell that actually holds the value.
function dstPinUnannListLet(bodyIx: i32, name: string): i32 {
  let li = parentLetOf(bodyIx, name)
  if li < 0 { li = globalLetOf(name) }
  if li < 0 { return -1 }
  const d = P.nodes[li]
  if d is LetDecl {
    if d.letType >= 0 { return -1 }
    if d.letInit < 0 { return -1 }
    const iv = P.nodes[unwrapParen(d.letInit)]
    if iv is ArrayLit { return li }
  }
  -1
}

// The destination annotation's ELEMENT spelling `dep` list levels in, gated on that
// spelling naming an arm — bare, or a ref-list of one — exactly as the one-level rung this
// generalises was. "" is the DISAGREEMENT the caller records, not a decline: a destination
// that cannot name the element's arm must veto the pin, which is what makes every-
// destination-agrees the safety property (`dstPinAnnIn`).
//
// `retRefArrElemName` TAKES THE FIRST CUT AND `arrElemNameRaw` THE REST, and the split is
// forced rather than stylistic: the first cut has a NODE to read (the annotation), and
// every cut after it holds only a string. `arrElemNameRaw` is the one home of that cut
// (`emit_base`'s array-name grammar header), so the deeper levels cannot drift from the
// first.
function dstPinElemAnnName(annIx: i32, dep: i32) {
  if retRefArrFlag(annIx) != 1 { return "" }
  let nm = retRefArrElemName(annIx)
  let k = 1
  while k < dep {
    if nm == "" { return "" }
    nm = arrElemNameRaw(nm)
    k = k + 1
  }
  if nm == "" { return "" }
  if variantIndexOf(nm) >= 0 { return nm }
  // The ELEMENT is itself a ref-list of an arm (`Circle[]` cut from a `Circle[][]`
  // destination) — the rung this is a hand-inlined copy of, at depth (D184). `const c:
  // Circle[][] = [lv1]` delivers `lv1` as an ELEMENT, and the element spelling `Circle[]`
  // is exactly the one that row's `flat Circle[] RUNS` control shows the pin already
  // handles once it is written down.
  if pinArmListName(nm) { return nm }
  ""
}

// Does the value of `ex` COME FROM the binding at `letIx`?
//
// `retLocalLetOfBlock` is the SAME "which binding actually supplies this value" lookup
// `criRetLocalLet` and `synthRetPinAnn` make, shared rather than copied: it walks an
// UN-ANNOTATED alias chain and stops at the first annotated link, which is what puts the
// question on the let that holds the LITERAL rather than on an intermediate that merely
// names it.
//
// AN IDENTITY-FORWARDING GENERIC IS TRANSPARENT, and it has to be or the channel stops one
// hop short of its own population: `gsto = idg(c)` over `function idg<T>(x: T): T` is the
// identical defect with a conduit in the middle, and it was 24 of the grid's residue cells
// until this rung. `dstPinFwdArg` is the test — the callee's RESULT annotation is one of
// its own type parameters and some parameter is annotated with that SAME parameter — so
// the conduit is recognised by its signature rather than by its name, and a callee that
// transforms its argument is not one. Depth-bounded because the arena is not this pass's
// to trust; four hops is far past any spelling measured.
function dstPinSrcIs(bodyIx: i32, ex: i32, letIx: i32) {
  dstPinSrcIsAt(bodyIx, ex, letIx, 0)
}

function dstPinSrcIsAt(bodyIx: i32, ex: i32, letIx: i32, depth: i32) {
  if ex < 0 { return false }
  if depth > 4 { return false }
  if retLocalLetOfBlock(bodyIx, ex) == letIx { return true }
  const u = unwrapParen(ex)
  const n = P.nodes[u]
  if n is Call {
    const j = dstPinFwdArg(u)
    if j >= 0 && j < n.callArgs.length {
      return dstPinSrcIsAt(bodyIx, n.callArgs[j], letIx, depth + 1)
    }
    // AN ORDINARY CALL IS TRANSPARENT TO THE BINDING IT HANDS BACK
    // (silent-class-inventory D155). `mkm()` is not an identity-forwarding generic and
    // `dstPinFwdArg` is right to decline it, but the value it produces IS this binding:
    // `mkm`'s result is un-annotated, so nothing in the callee restates the value's type
    // and the only nominal claim on it is the one at the CALL SITE. Gated on the callee's
    // result being un-annotated because a DECLARED result is its own destination — it is
    // recorded by `dstPinRetDest` inside the callee and would be the annotation to
    // disagree with, not a hop to see through.
    if dstPinCalleeRetLet(u) == letIx { return true }
  }
  // AN ELEMENT-PRESERVING CONDUIT, READ BACK WITH AN INDEX (silent-class-inventory D157).
  // `reverse([c])[0]` hands back the very object `c` holds, through a callee whose result
  // is spelled exactly as one of its parameters and whose spelling mentions a type
  // parameter — `rv<T>(xs: T[]): T[]`, and `std:array`'s `reverse` is that signature. The
  // value at the index IS this binding, so the destination the index is delivered to is
  // this binding's destination.
  //
  // ONLY AN `Index` MAY CONSUME IT, and that gate is the whole difference from widening
  // `dstPinFwdArg`. That predicate answers "the CALL's own value comes from argument j";
  // this one answers "the call's ELEMENTS come from argument j's elements", which is a
  // different claim about a different value. Read without the index, `reverse([c])` is a
  // `Circle[]` and pinning `c` — one object — from a `Circle[]` destination would be a
  // different program.
  if n is Index {
    const ia = P.nodes[unwrapParen(n.idxArr)]
    if ia is Call {
      const ej = dstPinElemFwdArg(unwrapParen(n.idxArr))
      if ej >= 0 && ej < ia.callArgs.length {
        return dstPinElemIsAt(bodyIx, ia.callArgs[ej], letIx, depth + 1)
      }
    }
  }
  false
}

// Does the LIST at `ex` have this binding among its ELEMENTS? The element half of
// `dstPinSrcIsAt`, and it is deliberately narrow: an `ArrayLit` whose elements the whole-
// value test claims, or a further element-preserving conduit. A bare identifier naming a
// list is NOT one — `const xs = [c]  rv(xs)[0]` reaches the binding through a list BINDING
// whose own row is already committed, which is the control D157 files as RUNNING and which
// this must not re-aim.
function dstPinElemIsAt(bodyIx: i32, ex: i32, letIx: i32, depth: i32): boolean {
  if ex < 0 { return false }
  if depth > 4 { return false }
  const u = unwrapParen(ex)
  const n = P.nodes[u]
  if n is ArrayLit {
    let i = 0
    while i < n.arrElems.length {
      if dstPinSrcIsAt(bodyIx, n.arrElems[i], letIx, depth + 1) { return true }
      i = i + 1
    }
    return false
  }
  if n is Call {
    const ej = dstPinElemFwdArg(u)
    if ej >= 0 && ej < n.callArgs.length {
      return dstPinElemIsAt(bodyIx, n.callArgs[ej], letIx, depth + 1)
    }
  }
  false
}

// The argument position a CALL forwards its ELEMENTS from, or -1: the callee's return
// annotation is spelled EXACTLY as one of its parameters' and that spelling MENTIONS one of
// the callee's own type parameters (`function rv<T>(xs: T[]): T[]`, and `std:array`'s
// `reverse`, `sorted`, `filtered`). First match wins.
//
// THE ELEMENT TWIN of `dstPinFwdArg`, and the difference is one line: that one requires the
// result to BE a type parameter (`(x: T): T`, a whole-value identity), this one requires
// only that the two spellings AGREE and mention one. A callee that returns a DIFFERENT
// container of the same element (`(xs: T[]): T`) is not one — the spellings differ — and
// neither is a concrete `(xs: Circle[]): Circle[]`, whose result is its own nominal claim.
function dstPinElemFwdArg(callIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const cf = P.nodes[unwrapParen(c.callFn)]
    if cf is Ident {
      const cfe = fnIndexOf(cf.identName)
      if cfe >= 0 && cfe < fnStmts.length {
        const cfn = P.nodes[fnStmts[cfe]]
        if cfn is FuncDecl {
          if cfn.fnRet < 0 { return -1 }
          const rn = tyNameOf(cfn.fnRet)
          if rn == "" { return -1 }
          if !monoAnnHasTyParam(rn, cfn.fnTyParams) { return -1 }
          // A WHOLE-VALUE conduit is `dstPinFwdArg`'s and not this one's: it is already
          // crossed above, and claiming it here too would let an `Index` read one hop it
          // has no business reading.
          if dstPinIsTyParam(rn, cfn.fnTyParams) { return -1 }
          let j = 0
          while j < cfn.fnParams.length {
            const pp = P.nodes[cfn.fnParams[j]]
            if pp is Param {
              if pp.parType >= 0 {
                if tyNameOf(pp.parType) == rn { return j }
              }
            }
            j = j + 1
          }
        }
      }
    }
  }
  -1
}

// The binding an ordinary UN-ANNOTATED callee hands back, or -1 (silent-class-inventory
// D155). `retLocalLetOfBlock` is the same "which binding actually supplies this value"
// lookup `dstPinSrcIsAt` and `synthRetPinAnn` make of a body's tail value, asked of the
// CALLEE's body instead of the caller's — so an alias chain inside the callee is walked
// by the same rule, and a callee whose tail value is anything but a binding answers -1.
//
// A DECLARED RESULT ANSWERS -1 rather than the binding. That case is not a hop: the
// annotation IS the destination, `dstPinRetDest` already records it from inside the
// callee, and reading through it would let a caller's annotation overrule a nominal
// claim the callee makes about its own result.
function dstPinCalleeRetLet(callIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const cf = P.nodes[unwrapParen(c.callFn)]
    if cf is Ident {
      const cfe = fnIndexOf(cf.identName)
      if cfe >= 0 && cfe < fnStmts.length {
        const cix = fnStmts[cfe]
        const cfn = P.nodes[cix]
        if cfn is FuncDecl {
          if cfn.fnRet >= 0 { return -1 }
          const crx = fnRetExprOf(cix)
          if crx < 0 { return -1 }
          return retLocalLetOfBlock(cfn.fnBody, crx)
        }
      }
    }
  }
  -1
}

// The argument position a CALL forwards its own value from, or -1: the callee's return
// annotation names one of its own type PARAMETERS, and some parameter is annotated with
// that same one (`function idg<T>(x: T): T`). First match wins.
function dstPinFwdArg(callIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const cf = P.nodes[unwrapParen(c.callFn)]
    if cf is Ident {
      const cfe = fnIndexOf(cf.identName)
      if cfe >= 0 && cfe < fnStmts.length {
        const cfn = P.nodes[fnStmts[cfe]]
        if cfn is FuncDecl {
          if cfn.fnRet < 0 { return -1 }
          const rn = tyNameOf(cfn.fnRet)
          if rn == "" { return -1 }
          if !dstPinIsTyParam(rn, cfn.fnTyParams) { return -1 }
          let j = 0
          while j < cfn.fnParams.length {
            const pp = P.nodes[cfn.fnParams[j]]
            if pp is Param {
              if pp.parType >= 0 {
                if tyNameOf(pp.parType) == rn { return j }
              }
            }
            j = j + 1
          }
        }
      }
    }
  }
  -1
}

function dstPinIsTyParam(name: string, typarams: string[]) {
  let i = 0
  while i < typarams.length {
    if typarams[i] == name { return true }
    i = i + 1
  }
  false
}

// LEG 1 — `gsto = c`, a module GLOBAL assignment. The target must NOT resolve to a
// function-scoped binding: a local of the same name SHADOWS the global, which is the
// order `monoGlobalLetOf` declines in for exactly this reason, and leg 2 owns that case.
function dstPinGlobalAssign(
  ix: i32,
  bodyIx: i32,
  letIx: i32,
  outN: string[],
  outT: i32[],
) {
  const n = P.nodes[ix]
  if n is BinExpr {
    if n.binOp == "=" {
      const tg = P.nodes[unwrapParen(n.binLeft)]
      if tg is Ident {
        if parentLetOf(bodyIx, tg.identName) < 0 {
          const gli = globalLetOf(tg.identName)
          if gli >= 0 {
            const gd = P.nodes[gli]
            if gd is LetDecl {
              dstPinPushAnn(gd.letType, n.binRight, bodyIx, letIx, outN, outT)
            }
          }
        }
      }
    }
  }
  0
}

// LEG 2 — an ANNOTATED LOCAL destination, in both its spellings: the binding
// `const o: Circle = c` and the assignment `let o: Circle = { r: 0 }` … `o = c`. One leg
// because both read the same node's `letType`, and the D52 grid varied neither.
function dstPinLocalDest(
  ix: i32,
  bodyIx: i32,
  letIx: i32,
  outN: string[],
  outT: i32[],
) {
  const n = P.nodes[ix]
  if n is BinExpr {
    if n.binOp == "=" {
      const tg = P.nodes[unwrapParen(n.binLeft)]
      if tg is Ident {
        const lli = parentLetOf(bodyIx, tg.identName)
        if lli >= 0 {
          const ld = P.nodes[lli]
          if ld is LetDecl {
            dstPinPushAnn(ld.letType, n.binRight, bodyIx, letIx, outN, outT)
          }
        }
      }
    }
  }
  if n is LetDecl {
    // AN UN-ANNOTATED BINDING IS A LINK IN THE CHAIN, NOT A DESTINATION, and skipping it
    // is not the same conservatism as vetoing. `retLocalLetOfBlock` walks THROUGH an
    // un-annotated alias to the binding that actually supplies the value — that is the
    // whole reason `synthRetPinAnn` uses it — so `const alias = c` sits on the path from
    // the literal to its real destination. Recorded as a destination it would answer ""
    // through `armPinAnnName` and veto the pin the link exists to carry: `const c = { r: n }
    // const alias = c  gsto = alias` was silent for exactly that reason.
    //
    // THE ASSIGNMENT ARM ABOVE IS DELIBERATELY NOT SYMMETRIC. `let o = { r: 0 }` … `o = c`
    // over an UN-annotated `o` is a genuine destination whose cell is already committed by
    // its own literal initializer, so re-aiming `c` without re-aiming `o` would break the
    // store. There the veto is the right answer and here it is not.
    if ix != letIx && n.letType >= 0 {
      dstPinPushAnn(n.letType, n.letInit, bodyIx, letIx, outN, outT)
    }
  }
  0
}

// LEG 4 — `m["k"] = c`, an ARM-VALUED MAP's value slot, and it is the newest destination
// of the four rather than one the row filed. On `8bf0f20f` this shape was a LOUD floor and
// so was not in D81's silent population at all; #1954 taught the arm-valued map to lower
// under the inline spelling, which removed the floor and left these 18 grid cells
// check-clean invalid wasm on master. Same channel, one destination further out: annotating
// the local `: Circle` makes them run on `922d52eb`, which is what says the literal's row is
// what is wrong and not the map's slot.
//
// The VALUE spelling is cut from the map annotation by `mapValNameOf` and then gated on
// naming an arm. That gate is also what keeps the cut's own hazard out — its header records
// that it accepts `{[string]:i32}|null` and returns the garbled `"i32}|nul"`, a spelling
// `variantIndexOf` can never claim.
//
// The pin's TYPE index is -1 (mint from the name) for the reason the ELEMENT pin uses it:
// the spelling is a CUT of the destination's annotation rather than the annotation node
// itself, so there is no recorded type on that node to hand over.
function dstPinMapValue(
  ix: i32,
  bodyIx: i32,
  letIx: i32,
  outN: string[],
  outT: i32[],
) {
  const n = P.nodes[ix]
  if n is BinExpr {
    if n.binOp == "=" {
      const tg = P.nodes[unwrapParen(n.binLeft)]
      if tg is Index {
        const recv = P.nodes[unwrapParen(tg.idxArr)]
        if recv is Ident {
          if dstPinSrcIs(bodyIx, n.binRight, letIx) {
            let mapAnn = -1
            const mli = parentLetOf(bodyIx, recv.identName)
            if mli >= 0 {
              const md = P.nodes[mli]
              if md is LetDecl { mapAnn = md.letType }
            } else {
              const mgi = globalLetOf(recv.identName)
              if mgi >= 0 {
                const mgd = P.nodes[mgi]
                if mgd is LetDecl { mapAnn = mgd.letType }
              }
            }
            if mapAnn >= 0 {
              // The VALUE cut of the receiver's annotation, gated on the value naming an
              // arm OR reaching one through further map hops — the D156 peel, needed on this
              // side too: `c["o"] = i0` over `c: {[string]: {[string]: Circle}}` delivers a
              // MAP to the value cell, and the inner binding's pin is that map's spelling.
              const vn = mapValNameOf(tyNameOf(mapAnn))
              if vn != "" {
                if variantIndexOf(vn) >= 0 || pinArmDeepUncontested(vn) {
                  outN.push(vn)
                  outT.push(-1)
                }
              }
            }
          }
        }
      }
    }
  }
  0
}

// LEG 3 — `thru(c)`, a callee PARAMETER. Positional, and a call with more arguments than
// the callee declares contributes nothing rather than reading past the parameter list.
//
// AN OPEN POSITION IS SKIPPED RATHER THAN VETOED. A parameter annotated with the callee's
// own type PARAMETER, or not annotated at all, carries no NOMINAL claim — the
// monomorphizer pins it FROM the argument, so re-aiming the argument re-aims the instance
// with it. Recording `""` for such a position would make every generic hop disagree with
// the real destination beyond it and the channel would decline on its own conduit.
function dstPinCallArgs(
  ix: i32,
  bodyIx: i32,
  letIx: i32,
  outN: string[],
  outT: i32[],
) {
  const n = P.nodes[ix]
  if n is Call {
    const cf = P.nodes[unwrapParen(n.callFn)]
    if cf is Ident {
      const cfe = fnIndexOf(cf.identName)
      if cfe >= 0 && cfe < fnStmts.length {
        const cfn = P.nodes[fnStmts[cfe]]
        if cfn is FuncDecl {
          const ps = cfn.fnParams
          let j = 0
          while j < n.callArgs.length {
            if j < ps.length {
              const pp = P.nodes[ps[j]]
              if pp is Param {
                let open = pp.parType < 0
                if !open {
                  // A POSITION IS OPEN WHEN ITS SPELLING *MENTIONS* A TYPE PARAMETER, not
                  // only when it IS one (silent-class-inventory D157). `xs: T[]` carries no
                  // more nominal claim than `x: T` does — the monomorphizer pins both FROM
                  // the argument — yet the narrow test read it as CONCRETE, cut the element
                  // `T` through `armPinAnnName`, found no variant of that name and pushed
                  // `""`. That is a destination DISAGREEMENT, so an element-preserving
                  // conduit VETOED the pin every other delivery of the binding agreed on.
                  // `monoAnnHasTyParam` is the monomorphizer's OWN predicate for the rule
                  // this leg's header already states, and it covers the array, map, union
                  // and function-type grammars this one never learned.
                  open = monoAnnHasTyParam(tyNameOf(pp.parType), cfn.fnTyParams)
                }
                if !open {
                  dstPinPushAnn(
                    pp.parType,
                    n.callArgs[j],
                    bodyIx,
                    letIx,
                    outN,
                    outT,
                  )
                }
              }
            }
            j = j + 1
          }
        }
      }
    }
  }
  0
}

// How many bindings THIS round of `synthDstPinAnns` pinned — the fixpoint counter, and the
// reason the pass below is a loop rather than a single walk (silent-class-inventory D171).
//
// A DESTINATION READS THE RECEIVER'S ANNOTATION, so a pin can CREATE a destination for a
// binding the same walk already passed over: `const i0 = Map()  const c = Map()` with
// `c["o"] = i0` and `thru(c)` is the shape — in source order `i0` is visited while `c` is
// still un-annotated and records no destination, then `c` is pinned from `thru`'s parameter.
//
// IT MOVES 0 CELLS ON ITS OWN, ON ALL THREE GRIDS, AND IT IS LOAD-BEARING. Measured against
// `1559d80c`: the loop alone is 0 forward / 0 backward on the 2,850-cell D88/D100 grid, the
// 1,114-cell D112 grid and the 1,188-cell D156 position grid alike, while the D156 peel alone
// is +16 / **-4** on the position grid — four `bindann x param x arm x notwin` cells that
// RUN on master and do not with a chain the single walk leaves half-pinned. Together they are
// +32 / 0 there. That is the D111 finding in its other direction: a composition is a
// DIRECTION, not a cell count, and a candidate whose own column is all zeroes can still be
// the half that makes the other one safe.
let dstPinFired = 0

// ── scanArrLitCommit — the list literal's element row, keyed off the element's own
// COMMITTED rep rather than off the checker's shape (silent-class-inventory D163) ────────
//
// THE DEFECT. `arrLitElemName` names a literal's element row from the checker's recorded
// `TyArray.aElem` whenever the first element is not itself a literal, and that record is a
// STRUCTURAL shape. `shapeNominalOfTy` resolves one by asking the struct table before the
// variant table, so with `type Dot = {r:i32}` declared beside a `Circle` arm of the same
// layout the row keys `Dot` — while the element EXPRESSION builds the arm. Disassembled:
// `array.new_fixed` pushes a `(ref <Circle's heap>)` into an `(array (mut (ref null
// <Dot's heap>)))`, from a module `vl check` passes with no diagnostics at all.
//
// IT IS D39's CHANNEL AT A REP-INTERNING KEY, so the answer is not another pin: the
// deciding information is at the ELEMENT, and the row is keyed at the LIST. What this pass
// does is carry the one to the other, once, in a scope.
//
// A SEPARATE PASS AND NOT A RUNG, and the reason is the classifiers' own contract. The
// three of them (`arrLitElemName`, `arrLitElemKind`, `arrLitElemHintTy`) "must agree per
// slot", and they are called from TWO places with different information: `collectA`'s
// arena walk has no enclosing scope, `wasmEmit`'s literal lowering has one. A rung that
// asked `parentLetOf` would answer at the second and decline at the first, and one literal
// would key two rows — the exact failure this row is about, in the other direction.
//
// THE GATE IS D39's OWN QUESTION, asked of the committed name: it is banked only when the
// name reaches a union ARM, bare or through the map grammar. Everything else keeps the
// classification it had, so the blast radius is the contested seam and not every list
// literal in the language.
//
// BEFORE `monomorphize`, which is the same requirement `synthDstPinAnns` has and for a
// stronger reason: the destination pin runs there, so the committed name must be read
// AFTER it, and a generic conduit cloned first would have its parameter pinned off the very
// row the un-annotated literal resolved. Node indices are the originals, and a body the
// monomorphizer clones is simply not banked — a decline, which is the conservative
// direction at a rep key.
export function scanArrLitCommit(rootIx: i32) {
  let fe = 0
  while fe < fnStmts.length {
    const fnIx = fnStmts[fe]
    const fn = P.nodes[fnIx]
    if fn is FuncDecl { alcWalk(fn.fnBody, fn.fnBody, fnIx) }
    fe = fe + 1
  }
  // The module's own statements, with the program node as the scope — the shape
  // `synthGlobalDstPinAnn` uses, and for its reason: `plScanStmt` has a `Program` arm and
  // no `FuncDecl` one, so a function's locals cannot leak into the module's map.
  if rootIx >= 0 { alcWalk(rootIx, rootIx, -1) }
  0
}

// Every `ArrayLit` lexically inside one scope, NOT descending into a nested `FuncDecl`
// (which has its own `fnStmts` row and is walked as its own body — the same totality
// `dstPinSynthWalk` gets from `nodeChildren`, and the same reason).
function alcWalk(ix: i32, bodyIx: i32, fnIx: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = P.nodes[ix]
  if ix != bodyIx {
    if n is FuncDecl { return 0 }
  }
  if n is ArrayLit {
    if n.arrElems.length >= 1 {
      // EVERY element must commit to the SAME name, and the gate is not fastidiousness —
      // `const xs = [c, d]` over two ARMS of one union is a UNION-BOX list, and reading only
      // the first element would key it under one arm and emit `unknown variant field in
      // field access` for the other. `arrLitObjElemBoxVariant` already widens the literal
      // arm of the classifier for exactly that reason; this is the same rule at the
      // committed-rep rung. A heterogeneous literal has no single committed rep, so the
      // bank stays empty and the checker-typed union rung — which is the right answer
      // there — keeps it.
      const cn = alcCommitName(n.arrElems[0], bodyIx, fnIx, 0)
      let agree = alcNamesArm(cn)
      let ei = 1
      while ei < n.arrElems.length {
        if alcCommitName(n.arrElems[ei], bodyIx, fnIx, 0) != cn {
          agree = false
        }
        ei = ei + 1
      }
      if agree { recordArrLitCommitName(ix, cn) }
    }
  }
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    alcWalk(kids[k], bodyIx, fnIx)
    k = k + 1
  }
  0
}

// Does `name` reach a union ARM — bare, or through the map grammar at any depth? The gate,
// and it is `armPinAnnName`'s question asked of a NAME instead of an annotation node:
// D39's "this anonymous shape has two nominal claimants" is the only seam where the
// checker's structural record and the element's committed rep can name different heaps.
function alcNamesArm(name: string): boolean {
  if name == "" { return false }
  if variantIndexOf(name) >= 0 { return true }
  const leaf = mapLeafValName(name)
  if leaf == "" { return false }
  variantIndexOf(leaf) >= 0
}

// The type-NAME the expression at `ex` has already COMMITTED its rep to, or "".
//
// FOUR SOURCES, and every one of them is an ANNOTATION a user wrote or a pin synthesized —
// never an inference, because an inference is the structural record this pass exists to
// stop trusting. A bound local (its annotation, the destination pin's included), a
// PARAMETER, a callee's DECLARED result, and a callee's inferred result read through the
// binding that supplies it — the same `retLocalLetOfBlock` hop `dstPinCalleeRetLet` makes,
// asked here for a spelling rather than for a binding.
//
// Depth-bounded for `dstPinSrcIsAt`'s reason: the arena is not this pass's to trust, and
// four hops is far past any spelling measured.
function alcCommitName(ex: i32, bodyIx: i32, fnIx: i32, depth: i32): string {
  if ex < 0 { return "" }
  if depth > 4 { return "" }
  const u = unwrapParen(ex)
  const n = P.nodes[u]
  if n is Ident {
    const lli = parentLetOf(bodyIx, n.identName)
    if lli >= 0 {
      const ld = P.nodes[lli]
      if ld is LetDecl {
        if ld.letType >= 0 { return tyNameOf(ld.letType) }
        // AN UN-ANNOTATED BINDING IS A LINK IN THE CHAIN, NOT THE END OF IT —
        // `dstPinLocalDest`'s own rule, and `retLocalLetOfBlock` is the family's shared
        // implementation of it. `function thru(x: {[string]: Circle}) { const y = x
        // return y }` commits its result through `x`, and stopping at `y` loses that for
        // no reason: the alias RE-NAMES a value, it does not re-rep one.
        return alcCommitName(ld.letInit, bodyIx, fnIx, depth + 1)
      }
      return ""
    }
    const pn = alcParamAnnName(fnIx, n.identName)
    if pn != "" { return pn }
    const gli = globalLetOf(n.identName)
    if gli >= 0 {
      const gd = P.nodes[gli]
      if gd is LetDecl {
        if gd.letType >= 0 { return tyNameOf(gd.letType) }
      }
    }
    return ""
  }
  if n is Call {
    const cf = P.nodes[unwrapParen(n.callFn)]
    if cf is Ident {
      const cfe = fnIndexOf(cf.identName)
      if cfe >= 0 && cfe < fnStmts.length {
        const cix = fnStmts[cfe]
        const cfn = P.nodes[cix]
        if cfn is FuncDecl {
          // A DECLARED result is the commitment; nothing inside the callee can overrule
          // the claim it makes about its own result.
          if cfn.fnRet >= 0 { return tyNameOf(cfn.fnRet) }
          const crx = fnRetExprOf(cix)
          if crx < 0 { return "" }
          return alcCommitName(crx, cfn.fnBody, cix, depth + 1)
        }
      }
    }
    return ""
  }
  ""
}

// The annotation spelling of parameter `name` of the function at `fnIx`, or "". The
// parameter half of the lookup above: `parentLetOf` answers for a function's LOCALS and a
// parameter is not one, yet it is the commitment an identity conduit's body hands back.
function alcParamAnnName(fnIx: i32, name: string): string {
  if fnIx < 0 { return "" }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    let j = 0
    while j < fn.fnParams.length {
      const pp = P.nodes[fn.fnParams[j]]
      if pp is Param {
        if pp.parName == name {
          if pp.parType >= 0 { return tyNameOf(pp.parType) }
          return ""
        }
      }
      j = j + 1
    }
  }
  ""
}

// The PRE-MONOMORPHIZATION run of `synthDstPinAnn`, over every function body — and the
// ordering is a requirement, not a convenience.
//
// `synthRetPinAnn`'s home is `collectLocals`, which runs LONG after `monomorphize`. That is
// fine for a destination the value reaches directly, and wrong the moment a hand-written
// generic sits between the literal and its destination: by then `idg<T>(x: T): T` has
// already been cloned as `idg$m0(x: Dot): Dot`, pinned off the very row the un-annotated
// literal resolved to. The conduit then reads as a CONCRETE `Dot` destination — it vetoes
// the real one, and even if it did not, the instance's own signature is already wrong.
// 30 of the grid's residue cells were exactly that shape (`route=gen`, every destination),
// and they close here and nowhere else.
//
// The pass sits BEFORE `monomorphize` and after `collectU` / `buildFnMap`, which are the
// three edges it actually has: `variantIndexOf` reads `uVariants` (collectU), `fnIndexOf`
// and `globalLetOf` read the function/global maps (collectFns, via buildFnMap). Being
// pre-`collectA#2` is a bonus rather than a hazard — the annotation nodes it mints are
// covered by that intern pass instead of having to bank their own row, which is the one
// thing `synthRetPinAnn`'s late position forces it to do by hand.
//
// `collectLocals` STILL CALLS IT, and the second call is not redundant: that walk reaches
// the START function's blocks and the bodies monomorphization mints, and every binding this
// pass already pinned is declined there by the `letType >= 0` guard on entry.
//
// AND IT RUNS OVER THE MODULE TOO (silent-class-inventory D139), which is the half D81 did
// not have. `fnStmts` has no row for module scope and `collectLocals` never sees a global —
// the same structural gap `synthGlobalEmptyListAnns` exists to close one family over — so a
// top-level `const c = Map()` delivered to `thru(x: {[string]: Circle})` reached the mv
// layer with NO annotation while its function-scoped sibling reached it pinned. Probed on
// `54780e0b`, the two programs intern the SAME two mv slots over the SAME two ref-list rows
// (`rl=0 nm=Circle heap=1 wrap=9`, `rl=1 nm=Dot heap=0 wrap=11`) and emit byte-identical
// type sections; the ONLY difference is `letMapShapeOf`'s input — `letType=37`
// (`{[string]:Circle}`, this pin) at function scope against `letType=-1` at module scope,
// which sends the un-annotated global down `mapShapeOfExpr`'s recorded-type leg where the
// literal's own arena type is the anonymous `{r:i32}` and resolves the RENDER's slot
// (`struct.new 16`) where the local resolves the ARM's (`struct.new 15`). That is why the
// residue is a binding-RESOLUTION problem: the mint is identical on both sides.
//
// AND IT RUNS TO A FIXPOINT (silent-class-inventory D171), which is what makes the D156 peel
// above safe rather than merely bigger. See `dstPinFired`.
export function synthDstPinAnns(rootIx: i32) {
  // TO A FIXPOINT. The bound is a guard, not a policy — each round either pins at least
  // one binding or stops, and a binding is pinned at most once (the `letType >= 0` guard
  // on entry), so the loop cannot run more rounds than the module has un-annotated
  // bindings, and a round that pins nothing exits immediately.
  //
  // 32 AND NOT 8, AND THE NUMBER IS DERIVED RATHER THAN PICKED. A round is consumed per
  // level of the pin DEPENDENCY chain — for a nested map that is one per container — and
  // TRUNCATING the loop is exactly the half-pinned chain this whole change exists to avoid
  // (D171): the outer levels annotated, the inner one not, which is measurably worse than
  // pinning none of them. The deepest chain the gates can pin at all is bounded by
  // `mapLeafValName`'s own 8-cut cap, so anything past ~10 rounds is already declining for
  // a different reason; 32 puts the loop's ceiling far above the rung's and makes the
  // truncation unreachable rather than merely unlikely. It costs nothing when it is not
  // needed — the `dstPinFired == 0` exit fires on round 2 for every cell of all seven grids,
  // and the bound-8 variant this row's numbers were first taken on measures identically on
  // every one of them.
  let round = 0
  while round < 32 {
    dstPinFired = 0
    let fe = 0
    while fe < fnStmts.length {
      const fnIx = fnStmts[fe]
      const fn = P.nodes[fnIx]
      if fn is FuncDecl { dstPinSynthWalk(fn.fnBody, fn.fnBody, fnIx, rootIx) }
      fe = fe + 1
    }
    // The module run walks `globalStmts` rather than the statement list, for the reason
    // `synthGlobalEmptyListAnns` does: those ARE the module's bindings, already collected,
    // and a top-level `let` nested in an `if` is not one (it is a start-function local, and
    // `collectLocals` reaches it).
    let gi = 0
    while gi < globalStmts.length {
      synthGlobalDstPinAnn(globalStmts[gi], rootIx)
      gi = gi + 1
    }
    if dstPinFired == 0 { return 0 }
    round = round + 1
  }
  0
}

// Every `LetDecl` lexically inside one function body — nested `if` / loop blocks included,
// since a wasm local is function-scoped, and NOT descending into a nested `FuncDecl`, which
// has its own `fnStmts` row and is walked as its own body.
function dstPinSynthWalk(ix: i32, bodyIx: i32, fnIx: i32, rootIx: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = P.nodes[ix]
  if ix != bodyIx {
    if n is FuncDecl { return 0 }
  }
  if n is LetDecl { synthDstPinAnn(ix, fnIx, rootIx) }
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    dstPinSynthWalk(kids[k], bodyIx, fnIx, rootIx)
    k = k + 1
  }
  0
}

// The MODULE-SCOPE run of `synthEmptyListAnn`, over every top-level binding.
//
// A GLOBAL NEVER REACHES `collectLocals`, which is the whole of the defect this closes: that
// walk types wasm LOCALS from a function body's block statements, so `const outer = []` at
// top level kept its un-annotated `[]` and the global cell took the i32-list default while
// `outer.push(inner)` stored a list ref into it — `vl check` rc 0 and a module that does not
// instantiate. The other element kinds at top level rejected CLEANLY (a struct element hits
// `field access receiver is not a struct`, a union element `\`is\` receiver is not a union
// value`), which is what kept the hole narrow and quiet.
//
// ORDERED AFTER `collectA#2`, and that is a requirement rather than a convenience: the
// synthesis can only RESOLVE a ref-list row, never mint one (`rlSlotByName`, not
// `ensureRefElem` — a late intern would append a row past the resolved heap tables), so the
// intern pass has to have run. It is ordered BEFORE `emitModule` for the obvious reason: the
// global section reads `globalCellKind`, whose annotated ladder is what the synthesized
// annotation steers.
export function synthGlobalEmptyListAnns() {
  let i = 0
  while i < globalStmts.length {
    synthEmptyListAnn(globalStmts[i])
    synthNullableAnn(globalStmts[i])
    i = i + 1
  }
  0
}

// The CAPTURE-SCOPE run of `synthEmptyListAnn` — `synthGlobalEmptyListAnns`' argument, one
// storage class over, and it is the SAME argument verbatim: a section emitted BEFORE
// `collectLocals` reads the binding's annotated ladder, so the binding has to be annotated
// before that section, not during the code emit that follows it.
//
// THE SECTION IS THE TYPE SECTION AND THE CELL IS A CLOSURE ENV FIELD. `emitTypeSection`
// mints one env struct per capturing lifted function and types each field with
// `captureValKind` / `captureValStructIdx`, both of which resolve the capture to its
// enclosing frame's binding (`parentBindingOf`) and, for an UN-annotated one, classify the
// INITIALIZER. An empty `[]` has no element to classify — `arrLitIsRef` declines a literal
// with no elements BY CONSTRUCTION — so the field took the i32-list default while the
// enclosing frame's own local, typed later by `collectLocals` AFTER its
// `synthEmptyListAnn` call, took the real ref-list wrapper. `vl check` rc 0 and the engine
// refuses the module: `type mismatch: expected (ref $type), found (ref $type)`, the two
// wrappers printing under the same elided name (D613).
//
// THE POPULATION IS EXACTLY THE FIELDS THE TYPE SECTION TYPES, not "every function-scope
// binding": the walk is the type section's own — every capturing frame, every capture name,
// resolved by the very function the field is typed through. A binding no env field is typed
// from is not reached, so this pass cannot move a program with no capture in it.
//
// IT IS NOT A SECOND ANSWER, IT IS THE SAME ANSWER EARLIER. `collectLocals` runs
// `synthEmptyListAnn` on this identical binding a few passes later, and the synthesis is
// idempotent (`s.letType < 0` on entry), so the late call declines and the LOCAL's own
// classification is unchanged — measured, and it is why the code section is byte-identical
// on every program whose captures were already typed right.
export function synthCaptureEmptyListAnns() {
  if !fnValUsed { return 0 }
  let fe = 0
  while fe < fnStmts.length {
    const caps = captureNamesOf(fe)
    let ci = 0
    while ci < caps.length {
      const b = parentBindingOf(fe, caps[ci])
      if b >= 0 {
        synthEmptyListAnn(b)
        synthNullableAnn(b)
      }
      ci = ci + 1
    }
    fe = fe + 1
  }
  0
}

export function collectFns(stmts: i32[]) {
  fnStmts = []
  fnParent = []
  globalStmts = []
  globalNames = []
  globalIndexBySid = []
  gPromoOk = []
  gPromoSlot = []
  gCellIdx = []
  startStmts = []
  lambdaCtr = 0
  fnDispNames = []
  fnValUsed = false
  let i = 0
  while i < stmts.length {
    const s = P.nodes[stmts[i]]
    if s is FuncDecl {
      fnStmts.push(stmts[i])
      fnParent.push(-1)
      fnDispNames.push("")
    } else if s is LetDecl {
      // A top-level `let`/`const` — a module global; its position here is its index.
      globalStmts.push(stmts[i])
      // R6's BUILD POINT for `globalIndexBySid`: every key is interned here, which
      // is what makes `sid >= length ⇒ absent` exact for every later lookup. The id
      // comes from the CARRIER (`stmts[i]` is this `LetDecl`'s arena index), so the
      // build pays the same one intern per global the map paid one hash for.
      const gsid = sidOfNode(stmts[i])
      if sidArrGet(globalIndexBySid, gsid) < 0 {
        sidArrPut(globalIndexBySid, gsid, globalNames.length)
      }
      globalNames.push(s.letName)
      // G2c seeds: every binding starts life as a CELL at its own declaration index
      // (the identity `gCellIdx` `userGlobalIdx` translated through before promotion
      // existed). `computeGlobalPromotion` rewrites both arrays after the last pass
      // has finished mutating the arena.
      gPromoOk.push(0)
      gPromoSlot.push(-1)
      gCellIdx.push(globalStmts.length - 1)
    } else if nodeIsTypeDecl(stmts[i]) {
    } else if s is UnionDecl {
      // A `type N = A | B` union alias — collected by `collectU`, skipped here.
    } else if s is ImportDecl {
      // A tooling node (the lint tier reads it) — the module front end already
      // resolved and merged the import, so the emitter has nothing to lower.
    } else {
      // A top-level STATEMENT — runs in the synthetic start function (source order).
      startStmts.push(stmts[i])
    }
    i = i + 1
  }
  // Lift nested function declarations and anonymous `function(...)...` literals into
  // the flat `fnStmts` list (lambda support). Each lifted FuncDecl becomes a real
  // top-level wasm function with its own index. Scan the bodies of every function
  // already collected AND every top-level global init / start statement; the worklist
  // grows as nested functions are discovered (a closure inside a closure). Anonymous
  // literals (`fnName == ""`) get a synthesized `__lambda_N` name written into the node.
  let wi = 0
  while wi < fnStmts.length {
    const fn = P.nodes[fnStmts[wi]]
    if fn is FuncDecl { liftFnsInExpr(fn.fnBody, wi) }
    wi = wi + 1
  }
  // Also lift lambdas in top-level global initializers and start statements (parent -1).
  let gi = 0
  while gi < globalStmts.length {
    const g = P.nodes[globalStmts[gi]]
    if g is LetDecl {
      if g.letInit >= 0 {
        const before = fnStmts.length
        liftFnsInExpr(g.letInit, -1)
        recordLambdaDispName(before, g.letInit, g.letName)
      }
    }
    gi = gi + 1
  }
  let si = 0
  while si < startStmts.length {
    liftFnsInExpr(startStmts[si], -1)
    si = si + 1
  }
  // A lambda lifted from a GLOBAL initializer / start statement (the two loops just above)
  // is pushed WITHOUT its own body being descended — `liftFnsInExpr` lifts a bare `FuncDecl`
  // and returns, leaving the body-descent to the worklist, which already finished at the old
  // `fnStmts.length`. So a nested lambda inside a top-level `const g = () => (() => …)` (a
  // closure whose result is itself a closure) was never lifted, and its inner literal reached
  // emit unlifted (`function literal not lifted`). Resume the worklist from where it stopped
  // (`wi` still holds that index) to descend exactly the newly-lifted functions — order-
  // preserving (already-descended entries keep their `fnStmts` slot, so every existing
  // program's function indices are unchanged; only nested-of-global/start lambdas are appended).
  while wi < fnStmts.length {
    const gfn = P.nodes[fnStmts[wi]]
    if gfn is FuncDecl { liftFnsInExpr(gfn.fnBody, wi) }
    wi = wi + 1
  }
  // The `$fnsig` signature collection happens LATER (`collectCloSigs`, after
  // `computeRetInference`): a signature key reads each function's param AND return
  // kinds, and an un-annotated callback's return kind is only known once inference ran.
  cloSigKeys = []
  cloSigRepFn = []
  // The pool's twin column is rebuilt at the pool's own emit; clear it with the two
  // columns it parallels so a LONG-LIVED process (the LSP compiles on every keystroke)
  // can never read the previous module's folds through a same-length coincidence.
  cloSigTwin = []
  fnStmts.length
}

// True if function-result type NAME `r` ROUND-TRIPS through the nested-closure value-call
// ABI — i.e. a value call on a closure returning `r` recovers it correctly. Only a plain
// numeric/boolean SCALAR does: it is the closure `call_ref`'s literal result valtype, read
// straight off the stack. A COMPOSITE result (struct / union / litunion / map / string /
// nullable) is a box/atom/ref whose recovery through a CHAINED closure call is a separate,
// unfinished slice — its nested lambda body mis-lowers (an inner litunion arm keeps its
// string rep where the `>i` atom is expected; a union box traps on the narrow). Excluding
// them keeps those shapes a CLEAN REJECT (no interned sig) instead of INVALID-WASM / TRAP.
function cloResultIsPlainScalar(r: string) {
  r == "i32" || r == "boolean" || r == "f64" || r == "f32" || r == "i64"
}

// THE ONE HOME of the `$fnsig` INTERN. Append `key` to the signature table under
// representative lifted-function `rep` (a real `fnStmts` index for a concrete lambda,
// `-1` for a key synthesized from an annotation — `emitSynthCloSig` builds that
// functype from the key text alone). A "" key is the "not value-ABI" answer of every
// producer (`fnSigKeyOf` / `cloSigKeyExt` / `unionArmSigKey`) and interns nothing; an
// already-present key keeps its ORIGINAL slot, which is what makes every pass below
// idempotent and order-stable.
//
// This four-line sequence — the "" test, the `cloSigPosOfKey` dedup, and the PAIRED
// push into the two parallel columns — was hand-written NINE times in this file, and
// the two columns must stay the same length or `cloSigRepFn[i]` names another key's
// representative. That invariant now has one place to hold.
function internCloSigKey(key: string, rep: i32) {
  if key == "" { return 0 }
  if cloSigPosOfKey(key) >= 0 { return 0 }
  cloSigKeys.push(key)
  cloSigRepFn.push(rep)
  0
}

// THE ONE HOME of "intern the `$fnsig` of this type-ATOM spelling, synthesized". Five
// passes below reach a closure through a DIFFERENT structural position — a union arm, a
// union arm's closure-ARRAY element, a nulclosure annotation's inner type, a
// closure-array annotation's element, and the arena walk's `TyFunc` render — and each
// spelled out the identical three steps:
//
//   1. key the atom with `unionArmSigKey` (which peels the grouping parens a closure
//      carries in a composite position, yielding exactly the key the value CALL site
//      derives via `annSigKey` — the two producers must byte-match);
//   2. SKIP a mixed scalar+composite union RESULT that no registration path admitted
//      (`nulCloMixedUnionUnregistered`) — synthesizing that sig would satisfy the call
//      site's floor while the un-pinned producer lambda keeps its self-classified
//      functype, turning a clean REJECT into a runtime cast TRAP. Three separate
//      fuzz findings (seeds 113152631, 128038938, and the fuzz-nightly nulclosure
//      lead) each added this guard at ONE position; they are one rule at five;
//   3. intern with the -1 synth rep.
//
// The guard is evaluated only for an atom that KEYED, exactly as all five copies did —
// `unionArmSigKey` is the cheap arrow scan and `nulCloMixedUnionUnregistered` re-walks
// the result union, so the order is load-bearing for work, not just for behaviour.
function internCloSigOfAtom(atom: string) { internCloSigOfAtomTy(atom, "") }

// `internCloSigOfAtom` with the key already in hand. `kIn` of "" parses the atom exactly
// as before, so every unhinted caller is unchanged.
//
// THE GUARD STILL RUNS. `nulCloMixedUnionUnregistered(atom)` is a deliberate REJECT — a
// mixed-union unregistered result is skipped so the call fails loudly — and it is
// evaluated here on the atom whether or not the key came from the arena. B255 reverted a
// conversion that answered AROUND a guard of exactly this kind; this one answers only the
// KEY and leaves the guard in the path.
function internCloSigOfAtomTy(atom: string, kIn: string) {
  let k = kIn
  if k == "" { k = unionArmSigKey(atom) }
  if k == "" { return 0 }
  if nulCloMixedUnionUnregistered(atom) { return 0 }
  internCloSigKey(k, -1)
}

// Intern every closure `$fnsig` reachable through the RESULT chain of function-type name
// `tn` — a closure whose result is ITSELF a closure (`()=>((i32)=>f32)`), to any nesting
// depth (`()=>(()=>(i32)=>boolean)`). The concrete-lambda loop keys the OUTER sig as a
// collapsed `>c` (the shared fat-pointer, `repSigTokOfKind("closure")`) but never mints
// the INNER closure's own sig — the collector interns from concrete lifted lambdas, and a
// lambda RETURNING a closure has no lifted lambda of the RESULT type (or one whose
// self-inferred result kind — e.g. an f64 literal — disagrees with the annotated f32). So
// a value call on the RESULT (`g()(1)`, whose key the emitter re-derives from the CHECKER
// type via `nodeTyName`→`annSigKey`) finds no interned signature and rejects loudly. Walk
// the result chain and intern each result closure's key (`unionArmSigKey`, the SAME
// normalize+`annSigKey` the call site uses, so the keys byte-match) with the -1 synth rep;
// `emitSynthCloSig` builds its functype purely from the key. Idempotent via
// `cloSigPosOfKey` — dedups against a concrete closure of the same shape. The closure dual
// of the nullable-closure-result block above, generalized to the whole result spine.
//
// BOUNDED to results that ROUND-TRIP through a value call: a level's key is interned only
// when its RESULT is a nested closure (the shared fat-pointer, always valid) or a plain
// numeric/boolean SCALAR — `cloResultIsPlainScalar`, whose header carries the reason a
// composite result must stay a clean REJECT instead.
// THE CHECKER ENTRY, walked on the TYPE. Its caller had `nodeTyName(fnStmts[fe])` — a RENDER —
// and the spine below then recovered the structure by slicing that string apart again:
// `annRetNameOf` is "the `annArrowAt`-then-slice", one level per iteration. The arena holds that
// descent directly as `TyFunc.fnRet`.
//
// The intern KEY is not re-derived either: `sigKeyOfTy` is `annSigKey`'s type-taking twin and
// already live at three call sites, so each level's key comes off the type rather than off a
// name cut from the render.
//
// `cloResultIsPlainScalar` is copied by PARTITION (B193), not by intent: it is exactly
// i32/boolean/f64/f32/i64 — NOT string, which a paraphrase of "plain scalar" would have let in
// and which would have interned a level this walk has always refused.
function internCloResultChainTy(ty: i32) { internCloResultSpineTy(ty) }

function internCloResultSpineTy(ty: i32) {
  if ty < 0 { return 0 }
  let curTy = ty
  let guard = 0
  while guard < 64 {
    guard = guard + 1
    const ct = T.tys[curTy]
    if !(ct is TyFunc) { return 0 }
    const retTy = ct.fnRet
    if retTy < 0 { return 0 }
    const rt = T.tys[retTy]
    let retIsClosure = false
    if rt is TyFunc { retIsClosure = true }
    let takes = retIsClosure
    if !takes {
      if rt is TyPrim {
        const rp = rt.primName
        if (
          rp == "i32" ||
          rp == "boolean" ||
          rp == "f64" ||
          rp == "f32" ||
          rp == "i64"
        ) {
          takes = true
        }
      }
    }
    if takes { internCloSigKey(sigKeyOfTy(curTy), -1) }
    if !retIsClosure { return 0 }
    curTy = retTy
  }
  0
}

// THE ONE HOME of the closure RESULT-SPINE walk on a NAME — now with ONE caller, the
// nulclosure-ANNOTATION entry (`internNulCloResultSpine`, off the annotation's `| null` inner).
//
// The CHECKER-type entry that used to share it walks the ARENA instead (`internCloResultSpineTy`
// above). The two entries were the SAME loop with the SAME guard, the SAME
// `unionArmSigKey`/`cloSigPosOfKey` intern and the SAME descend-only-through-a-closure-result
// rule, differing in ONE disjunct — but they never had the same INPUT, and that is why only one
// of them moved. This one is fed an author's SPELLING, where a litunion alias is written and
// preserved. The checker entry was fed a `nodeTyName` RENDER, which print-widens that alias to
// `string`: measured in lockstep over the corpus, it keyed `S>i` for a callee that interns
// `i>i` (`literal-unions/fn-value-litunion-arg.vl`, whose header names that exact softening as
// the bug the other three `$fnsig` producers were already fixed for). A missing key is not
// loud — `wasmEmit`'s `call_ref` falls back to `fnSigIdxForArity`, the arity-only functype —
// so the render fed this seeder a key nothing would ever look up.
//
// `wideShape` is the disjunct: the ANNOTATION entry also interns a level whose result is a
// single-shape STRUCT (`>sN;` round-trips through a chained value call — the struct is a
// plain ref read off the `call_ref` result, and `unionArmSigKey` keys "" for a shape that
// never interned, so that level stays a clean reject). The checker entry did not, and the
// difference is load-bearing rather than incidental — sabotage S4 measures it. The arena twin
// therefore carries NO `wideShape` leg: nothing would exercise it.
function internCloResultSpine(tn: string, wideShape: boolean) {
  if tn == "" { return 0 }
  let cur = normTypeAtom(tn)
  let guard = 0
  while guard < 64 {
    guard = guard + 1
    // `annRetNameOf` IS the `annArrowAt`-then-slice this loop spelled out; "" is its
    // "no top-level arrow" answer, the spine's terminator.
    const rawRet = annRetNameOf(cur)
    if rawRet == "" { return 0 }
    const ret = normTypeAtom(rawRet)
    const retIsClosure = annArrowAt(ret) >= 0
    let takes = retIsClosure || cloResultIsPlainScalar(ret)
    // Evaluated ONLY when the two cheap disjuncts declined — the short-circuit the two
    // copies had, kept exactly (`nameIsWholeSpanShape` is the depth scanner, not a char test).
    //
    // DO NOT TAKE THE STANDING DELETION DIFF FOR `wideShape` (B75). It rests on a sabotage that
    // measured 0 on both channels and was labelled "measured DEAD". It is REDUNDANT, not dead,
    // and the sibling that covers it is COVERAGE-GATED: `collectTyReachCloSigs`'s roots come from
    // `nodeTyIxOf(retTy/pt/letTy/fdt)` and the function returns 0 on its first line for -1. On an
    // arena-uncovered nullable-closure annotation the arena walk does nothing at all and this
    // flag is the only cover. The corpus has zero uncovered instances, which is why the sabotage
    // read 0 — the same shape as the #1563 regression, which shipped on exactly that reading.
    if !takes && wideShape { takes = nameIsWholeSpanShape(ret) }
    // NO `nulCloMixedUnionUnregistered` guard, and it is INERT here rather than missing:
    // `takes` already restricts this level's RESULT to a nested closure, a plain scalar,
    // or (annotation entry) a whole-span shape — never a union — so the guard's mixed
    // scalar+composite test cannot fire on `cur`. Stated, not assumed.
    if takes { internCloSigKey(unionArmSigKey(cur), -1) }
    // Descend only THROUGH a nested-closure result — a scalar/composite result ends the spine.
    if !retIsClosure { return 0 }
    cur = ret
  }
  0
}

// The nulclosure-ANNOTATION dual of `internCloResultChain`: intern every closure `$fnsig`
// reachable through the RESULT chain of a NULLABLE closure annotation's inner function type
// (`(() => ((i32) => f32)) | null` → the inner `(i32) => f32`; `((i32) => (() =>
// {a: i64, f: i32, z: f64})) | null` → the inner `() => {a: …}`). The annotation may be the
// program's ONLY spelling of these types (the value only ever `null`, narrowed and called),
// so no concrete lambda ever mints them. `wideShape` true — see `internCloResultSpine` for
// what the single-shape STRUCT widening buys and why litunion / union-box / map / string
// results stay excluded.
function internNulCloResultSpine(tn: string) { internCloResultSpine(tn, true) }

// Collect the distinct `$fnsig` env-leading functypes — one per distinct eligible
// signature KEY across all lifted functions (any could be used as a value), in
// `fnStmts` order. Runs AFTER `computeRetInference` (the key reads inferred return
// kinds) and after `collectMapFilterUse` (which may flip `fnValUsed` for a program
// whose only function value is a named `.map`/`.filter` callback). Empty (zero new
// types) unless `fnValUsed` — the byte-identical-golden invariant.
export function collectCloSigs() {
  cloSigKeys = []
  cloSigRepFn = []
  // The pool's twin column is rebuilt at the pool's own emit; clear it with the two
  // columns it parallels so a LONG-LIVED process (the LSP compiles on every keystroke)
  // can never read the previous module's folds through a same-length coincidence.
  cloSigTwin = []
  if !fnValUsed { return 0 }
  let fe = 0
  while fe < fnStmts.length {
    let key = fnSigKeyOf(fe)
    // A VOID- (`>v`) or STRUCT-returning (`>sN;`) function used as a VALUE (bound,
    // passed, returned) needs its EXTENDED sig interned too — the value-eligible key
    // above excludes both. Mirrors the object-field-closure pass below, but for a
    // function reached through a binding / param rather than a struct field.
    // `cloSigKeyExt` yields "" for the kinds still outside the value ABI (string, i64),
    // so those stay unminted.
    if key == "" { key = cloSigKeyExt(fe) }
    // The CONCRETE-lambda rep: this key's representative is the lifted function itself,
    // not the -1 synth sentinel.
    internCloSigKey(key, fe)
    // A NULLABLE-CLOSURE result (`(i32) => ((i32) => K0) | null`, key `…>C`): intern the INNER
    // closure's `$fnsig` too. The inner closure is never CONSTRUCTED (the result is only ever
    // `null`, or narrowed and called), so a narrowed value-call `t0(1)` would find no interned
    // sig. The inner type rides the lambda's pinned `fnRet` nullable part (`((i32)=>K0)`);
    // `unionArmSigKey` yields the SAME key the narrowed call site derives (`narrowedClosureOf` →
    // `annSigKey`) — a litunion result keys `>i` (`annRetKind`'s litunion arm), matching a
    // constructed `(i32)=>K0` inner. Synthesized from the string (`emitSynthCloSig`, rep -1).
    // Usage-gated by `fnValUsed`; a program without a nulclosure result mints nothing new here.
    if cloRetValKind(fe) == "nulclosure" {
      const rfn = P.nodes[fnStmts[fe]]
      if rfn is FuncDecl {
        // THE MIXED-UNION SKIP BELONGS HERE TOO, and this is the one synth site where
        // its absence was NOT inert. #1174 filed it as "not provably inert" without a
        // witness; the witness exists and its population is exactly one shape — an
        // UN-INSTANTIATED GENERIC TEMPLATE. `inm` is the nullable part of a lifted
        // function's declared return, and for a template that spelling still carries the
        // TYPE PARAMETER (`((i32) => i32 | T)`). `T` is not a value atom and not a
        // litunion, so it counts as the COMPOSITE side of the guard's mix test while a
        // concrete `i32` supplies the scalar side — and NO registration pass ever
        // registers it, because `collectU` (which owns `collectTyReachRegister`) is
        // emit pass #1 while `monomorphize`/`synthRetAnnots` run later and there is no
        // `collectU#2`. So all four registration predicates decline and the guard fires.
        // That is why every cell #1174 built was inert: all four were CONCRETE, and a
        // concrete mixed union always registers (measured: 20 of 20 spellings answer
        // `isUName`). Unguarded, this site banks the key `i>u` — derived from a spelling
        // that mentions a TYPE PARAMETER, so it describes no value — and because
        // `internCloSigKey` keeps the FIRST rep for a key, a template reached before a
        // concrete lambda of the same key also STEALS that key's representative,
        // replacing the lambda's own functype with the `-1` synth one — the same
        // failure #1174's sabotage S2 named.
        //
        // HONEST BOUND: no program was found on which this changes RUN OUTPUT. The
        // divergence is in the emitted BYTES, measured two ways (a spurious 7-byte
        // functype, and a same-size rep swap), over 44 constructed programs, the full
        // corpus and the fuzz grid. It is a tightening, not a bug fix, and the pin for
        // it is a wasm-SHA pin (`generic-nulclosure-return-sig-skip.vl`), not a `@log`
        // one — `deno task test` compares OUTPUT and therefore cannot see it.
        const inm = nullablePartOf(tyNameOf(rfn.fnRet))
        if inm != "" { internCloSigOfAtom(inm) }
      }
    }
    // CLOSURE-RETURNING-CLOSURE result (`() => ((i32) => f32)`, `(i32) => (() => i64)`): a
    // lifted lambda whose result is ITSELF a closure keys its OWN sig as the collapsed `>c`
    // (via `cloSigKeyExt`) but the INNER closure's sig is never minted from a concrete lambda
    // — so a value call on the returned closure (`g()(1)`) has no interned signature. Walk the
    // result chain off the lambda's CHECKER type (`nodeTyName`, the same source the call site
    // reads) and synthesize each result closure's `$fnsig` from its key (rep -1). Recurses
    // through arbitrary nesting; idempotent via `cloSigPosOfKey`.
    if cloRetValKind(fe) == "closure" {
      internCloResultChainTy(nodeTyIxOf(fnStmts[fe]))
    }
    fe = fe + 1
  }
  // EXTENDED field-closure signatures (index/operator-trap dispatch): a closure
  // that is an OBJECT-FIELD VALUE may be void (`"[]=": function(k,v) {…}`) or
  // struct-returning (`"[]": function(i) row(i)`, an operator field returning a
  // struct) — sigs the value ABI above excludes. Intern each such field
  // closure's extended key (`>v` / `>sN;` results) so the member-call site can
  // `ref.cast` to the callee's REAL functype. Only fires for a field closure whose
  // sig is NOT already value-eligible.
  let ai = 0
  while ai < P.nodes.length {
    const an = P.nodes[ai]
    if an is ObjLit {
      const fs = an.objFields
      let fi = 0
      while fi < fs.length {
        const f = P.nodes[fs[fi]]
        if f is FieldInit {
          const ffe = fieldValueFeOf(f.fiValue)
          if ffe >= 0 {
            // The field closure is CONCRETE, so its rep is the lifted function `ffe`.
            if fnSigKeyOf(ffe) == "" { internCloSigKey(cloSigKeyExt(ffe), ffe) }
          }
        }
        fi = fi + 1
      }
    }
    ai = ai + 1
  }
  // CLOSURE-ARM union signatures: a union with a function-type arm (`(() => i64) | i64`)
  // whose program has NO concrete closure of that arm's type — the value is only ever
  // narrowed (`if x is () => i64`) and CALLED, never a real lambda — still needs the arm's
  // `$fnsig` interned, since the narrowed call `call_indirect`s at it. The two
  // concrete-closure loops above never see such a signature. Walk every registered union's
  // arms; for each function-type arm intern its annotation key (`unionArmSigKey`, which
  // normalizes the wrapped/spaced atom to the SAME key `narrowedClosureOf` → `annSigKey`
  // yields at the call site) with the -1 rep sentinel — the type-section emitter
  // (`emitSynthCloSig`) synthesizes its functype from the key. Gated by `fnValUsed`, which a
  // closure union arm flips.
  let ui = 0
  while ui < unMemberSet.length {
    // D-UNION set ADT — this walk iterates the ROW, so it reads the row's own
    // recorded member column directly (`recordUnMemTys` split the set ONCE, at the
    // mint, and the columns keep that exact atom order). No `msSetOfText` text
    // bridge is needed and the 31-member mask limit does not apply: the row index
    // IS the key. The split survives only for a row the recorder missed or one
    // whose slice outruns the reference columns (the self-heal reset).
    const atoms: string[] = []
    let uSt = -1
    if ui < unMemTyStart.length {
      uSt = unMemTyStart[ui]
      if uSt >= 0 {
        if uSt + unMemTyCount[ui] > unMemAtoms.length { uSt = -1 }
      }
    }
    const atomTys: i32[] = []
    if uSt >= 0 {
      let um = 0
      while um < unMemTyCount[ui] {
        atoms.push(unMemAtoms[uSt + um])
        atomTys.push(unMemTys[uSt + um])
        um = um + 1
      }
    } else {
      splitUnionAtoms(unMemberSet[ui], atoms)
    }
    let uj = 0
    while uj < atoms.length {
      // A FUNCTION-TYPE union arm (`(() => i64) | i64`): the arm's own closure sig. The
      // home's step-2 skip is this position's fuzz finding (fuzz-nightly seed 113152631 d4).
      // THE ROW DECIDES THE KEY, AND ALSO DECIDES THERE ISN'T ONE. `unMemTys` is recorded
      // in exactly `unMemAtoms` order, so slot `uj` holds this arm's arena type. A `TyFunc`
      // row hands `sigKeyOfTy` the key `unionArmSigKey` would have PARSED out of the arm
      // spelling (`normTypeAtom` + `annArrowAt` + `annSigKey`); a non-`TyFunc` row means
      // there is no arrow, which is the "" the parse would have returned after doing all of
      // that work — so both branches skip the parse entirely.
      //
      // The guard is untouched: `internCloSigOfAtomTy` still evaluates
      // `nulCloMixedUnionUnregistered(atom)` on the arm, and the no-arrow branch returns
      // before the guard exactly as `if k == "" { return 0 }` did.
      //
      // Measured over the corpus: 76 arrow arms, key-identical; 958 non-arrow arms, both
      // "" ; 0 disagreements.
      let armRow = -1
      if uj < atomTys.length { armRow = atomTys[uj] }
      if armRow >= 0 {
        const armT = T.tys[armRow]
        if armT is TyFunc {
          internCloSigOfAtomTy(atoms[uj], sigKeyOfTy(armRow))
        }
      } else {
        internCloSigOfAtom(atoms[uj])
      }
      // A CLOSURE-ARRAY ARM (`((i32, i32, i32) => boolean)[] | i32`) — plain or
      // nullable-element (`(((i32) => R) | null)[]`, the kind-5 niche): the arm's
      // ELEMENT closure sig is never interned by the function-arm branch above (a
      // closure array is not a bare function-type arm, `unionArmSigKey(atoms[uj])`
      // keys "") nor by `nameIsWholeSpanShape` (an array is not a single shape). The
      // TypeRef pass below interns a TOP-LEVEL closure-array annotation but never
      // one buried in a union (the node's `tyName` is the whole union). So a
      // narrowed `t0 is ((i32,i32,i32)=>boolean)[]` element call `t0[0](1,1,1)` on a
      // scalar-valued (no-lambda) union found NO interned element sig and fell to
      // `fnSigIdxForArity` — a "no interned signature" reject. The union-ARM dual of
      // the top-level closure-array pass (same `unionArmSigKey` element-key
      // normalization the call site derives via `cloArrSlotSigKey`).
      // THE ROW AGAIN, and again in both directions. A closure-ARRAY arm's element sig is
      // keyed off `cloArrElemNameOf`, which peels the element out of the arm SPELLING
      // (`nullClosureArrElem` / `nameIsClosureArray` / `arrElemNameRaw`). The row says
      // whether there is a closure element at all — `TyArray` whose `aElem` is a `TyFunc`,
      // or a `TyNullable` over one (the kind-5 niche the name form spells
      // `((i32) => R | null)[]`) — so 1,017 of 1,034 positions skip that peel entirely.
      //
      // The 17 that DO have one still compute the element NAME, because the guard needs it:
      // `internCloSigOfAtom` evaluates `nulCloMixedUnionUnregistered` on the element, and
      // that is a deliberate reject. The key comes from the arena; the guard keeps its input.
      // Measured: 17 element keys identical, 1,017 both "", 0 disagreements.
      let uCaRow = -1
      if uj < atomTys.length {
        const arow2 = atomTys[uj]
        if arow2 >= 0 {
          const at2 = T.tys[arow2]
          if at2 is TyArray {
            if at2.aElem >= 0 {
              const ee = T.tys[at2.aElem]
              if ee is TyFunc {
                uCaRow = at2.aElem
              } else if ee is TyNullable {
                if ee.nInner >= 0 {
                  const ei = T.tys[ee.nInner]
                  if ei is TyFunc { uCaRow = ee.nInner }
                }
              }
            }
          }
        }
      }
      if uCaRow >= 0 {
        const uCael = cloArrElemNameOf(atoms[uj])
        if uCael != "" { internCloSigOfAtomTy(uCael, sigKeyOfTy(uCaRow)) }
      } else if uj >= atomTys.length {
        const uCael = cloArrElemNameOf(atoms[uj])
        if uCael != "" { internCloSigOfAtom(uCael) }
      }
      uj = uj + 1
    }
    ui = ui + 1
  }
  // NULLABLE-CLOSURE annotations (`(() => f64) | null`, kind 19) whose value is only ever
  // `null` — a binding/param/global narrowed (`if f != null`) and CALLED, with NO concrete
  // lambda anywhere to intern the closure's `$fnsig` (the isNull draw of the rep fuzzer's
  // nullable-closure shapes): the null-narrowed call derives its key (`calleeCloSigKey` →
  // `cloNameSigKey`, which peels the `| null`) but found nothing interned and rejected
  // loudly. The nullable dual of the CLOSURE-ARM union pass above: walk every TypeRef and
  // intern the nulclosure annotation's INNER closure key (`unionArmSigKey` applies the SAME
  // trim+paren-peel+`annSigKey` normalization the call site uses, so the keys byte-match;
  // a result outside the value ABI keys "" and stays a loud reject) with the -1 synth rep
  // (`emitSynthCloSig`). Idempotent via `cloSigPosOfKey` — a live lambda of the same shape
  // dedups onto its key; a program without a nulclosure TypeRef pushes nothing.
  let ni = 0
  while ni < P.nodes.length {
    const nn = P.nodes[ni]
    if nn is TypeRef {
      const nm = nn.tyName
      if (nameIsNulClosure(nm)) {
        // The nulclosure's INNER function type, classified ONCE. Three sites in this
        // block asked `nullablePartOf(nm)` for the SAME answer; `nullablePartOf` is a
        // pure scan of `nm` and nothing between them writes `nm`, so the hoist is total
        // by construction (unlike D-RAKIND's, which straddled an intern and had to be
        // probed).
        const nInner = nullablePartOf(nm)
        // The nulclosure annotation's INNER closure sig — the home's step 2 is the
        // fuzz-nightly nulclosure lead's skip, which used to be spelled out here.
        internCloSigOfAtom(nInner)
        // A nulclosure whose RESULT is ITSELF a closure (`(() => ((i32) => f32)) | null`,
        // `((i32) => (() => {a: i64, f: i32, z: f64})) | null`): the intern above mints only
        // the OUTER sig (result collapsed to the shared `>c` fat-pointer), so the CHAINED
        // value call on the narrowed result (`t0()(1)`, `t0(1)()`) finds no interned sig for
        // the inner closure. Walk the annotation's result spine and synthesize each nested
        // result closure's `$fnsig` too.
        internNulCloResultSpine(nInner)
      }
      // A CLOSURE-ELEMENT array annotation — plain (`((i32) => R)[]`) or nullable-element
      // (`(((i32) => R) | null)[]`, the kind-5 niche) — whose value may carry NO concrete
      // lambda of the element type (a `[null]`-only construct, an empty literal): the
      // narrowed indexed / rebound call still `ref.cast`s to the ELEMENT's `$fnsig`, so
      // intern it from the annotation (the array dual of the nulclosure pass above).
      // `unionArmSigKey` peels the element's grouping parens to the SAME key the call
      // sites derive (`cloArrSlotSigKey` / `cloNameSigKey`); a live lambda of the same
      // shape dedups onto its key via `cloSigPosOfKey`.
      // The home's step 2 is this position's own fuzz finding (seed 128038938 d4).
      const cael = cloArrElemNameOf(nm)
      if cael != "" { internCloSigOfAtom(cael) }
    }
    ni = ni + 1
  }
  // ARENA CLOSURE-SIG WALK (runs LAST — after every name-walk pass above, so an already
  // interned sig keeps its slot). Descend the arena type of each annotation the union
  // registration walk recorded (`cloSigWalkRoots` — the SAFE top-level + body root set,
  // never the generic/monomorphized template `TypeRef` nodes a blind `P.nodes` scan hits)
  // and intern each reachable `TyFunc`'s `$fnsig`. This is the STRUCTURAL replacement for the
  // retired `internShapeFieldCloSigs` NAME walk (whose depth-0 `{…}`-field spelling split this
  // supersedes measurably — byte-identical corpus + a fresh-seed fuzz A/B with zero divergence):
  // a closure buried in a struct FIELD, a nested single-shape field, a closure/closure-array
  // union-arm field, or a closure FIELD of a CLOSURE-RESULT struct (`(i32) => {f: () => i32}` —
  // the TypeRef's whole name is the outer closure, no spelling-descent enumerates it) is
  // reachable in the arena regardless of nesting. Idempotent + order-stable via `cloSigPosOfKey`;
  // the `fnValUsed` gate at the top makes this loop unreachable for a program with no function
  // values.
  let ri = 0
  while ri < cloSigWalkRoots.length {
    if collectTyReachCloSigs(cloSigWalkRoots[ri], 16) < 0 { return -1 }
    ri = ri + 1
  }
  0
}

// Recursively walk the node at `ix` (a statement or expression subtree) and append
// every nested `FuncDecl` — whether a nested declaration statement or an arrow
// lambda in expression position — to `fnStmts` (lambda lifting). An anonymous
// lambda (`fnName == ""`) is given a synthesized unique name first, so it resolves
// like a named function. The function's OWN body is NOT descended here (the outer
// worklist loop in `collectFns` descends each lifted function once it is in
// `fnStmts`), preventing double-collection. Any function value's existence flips the
// module-wide `fnValUsed` flag.
//
// Record a directly-bound lambda's DEBUG display name (the `let`/`const` it is
// assigned to) for the name section. `initIx` is the initializer node and `slot` is
// the `fnStmts` index it lifted to (`fnStmts.length` captured BEFORE the lift call —
// a directly-bound lambda is the first and only push of that call). `fnName` is left
// as the synthesized `__lambda_N` so call resolution and `fnNameMap` are untouched —
// only a trap backtrace reads the friendlier name.
function recordLambdaDispName(slot: i32, initIx: i32, name: string) {
  if initIx < 0 || name.length == 0 || slot >= fnDispNames.length { return 0 }
  const iv = P.nodes[initIx]
  if iv is FuncDecl { fnDispNames[slot] = name }
  0
}

function liftFnsInExpr(ix: i32, parent: i32) {
  if ix < 0 { return 0 }
  const n = P.nodes[ix]
  if n is FuncDecl {
    if n.fnName == "" {
      n.fnName = "__lambda_" + i32ToStr(lambdaCtr)
      lambdaCtr = lambdaCtr + 1
      // THE ONE IN-PLACE `fnName` WRITE THAT LANDS AFTER THE NODE IS ALREADY IN THE ARENA,
      // and `emit_base.nameNamesFunction` folds the arena incrementally, so it may already
      // have read this node as the anonymous "" it was. Tell it the new name. (Everything
      // else reaches `P.nodes` fully built through `ast.addNode`; see that function's header
      // for the three facts the fold rests on, of which this is the third.)
      //
      // NO STANDING INSTRUMENT REDDENS IF THIS LINE IS DELETED, and that is recorded here
      // rather than left to be rediscovered: sabotaged to `noteFuncName("")`, the compiler
      // still self-compiles, is still a fixpoint of itself, and the whole 3,610-test suite
      // still passes. The reason is that the only names this write can ADD are
      // `__lambda_<n>`, which nothing ever ASKS `nameNamesFunction` about — a user cannot
      // reach the query with that spelling. The line is here because the fold's correctness
      // argument requires it the day a query can, not because a case exercises it. Do not
      // delete it on the strength of a green run.
      noteFuncName(n.fnName)
      // R4 writer 4 of 8 (`compiler/symbols.vl`). Unlike `noteFuncName` above, THIS
      // one is not vacuous: `fnIndexOfSid`'s dense array is keyed by the carrier, and
      // `buildFnMap` interns `s.fnName` for every lifted function — a stale carrier
      // slot here would key the lambda's own row under the anonymous "" it replaced.
      sidNoteNodeName(ix)
    }
    fnStmts.push(ix)
    fnParent.push(parent)
    fnDispNames.push("")
    fnValUsed = true
    return 0
  }
  if n is Block {
    const stmts = n.blkStmts
    let i = 0
    while i < stmts.length {
      liftFnsInExpr(stmts[i], parent)
      i = i + 1
    }
    return 0
  }
  if n is LetDecl {
    if n.letInit >= 0 {
      const before = fnStmts.length
      liftFnsInExpr(n.letInit, parent)
      recordLambdaDispName(before, n.letInit, n.letName)
    }
    return 0
  }
  if n is RetStmt {
    if n.retArg >= 0 { liftFnsInExpr(n.retArg, parent) }
    return 0
  }
  if n is IfStmt {
    liftFnsInExpr(n.ifCond, parent)
    liftFnsInExpr(n.ifThen, parent)
    if n.ifElse >= 0 { liftFnsInExpr(n.ifElse, parent) }
    return 0
  }
  if n is WhileStmt {
    liftFnsInExpr(n.whileCond, parent)
    liftFnsInExpr(n.whileBody, parent)
    return 0
  }
  if n is ForRange {
    liftFnsInExpr(n.frFrom, parent)
    liftFnsInExpr(n.frTo, parent)
    if n.frStep >= 0 { liftFnsInExpr(n.frStep, parent) }
    liftFnsInExpr(n.frBody, parent)
    return 0
  }
  if n is ForIn {
    liftFnsInExpr(n.fiIter, parent)
    liftFnsInExpr(n.fiBody, parent)
    return 0
  }
  if n is Call {
    liftFnsInExpr(n.callFn, parent)
    const args = n.callArgs
    let i = 0
    while i < args.length {
      liftFnsInExpr(args[i], parent)
      i = i + 1
    }
    return 0
  }
  if n is BinExpr {
    liftFnsInExpr(n.binLeft, parent)
    liftFnsInExpr(n.binRight, parent)
    return 0
  }
  if n is Unary {
    liftFnsInExpr(n.unArg, parent)
    return 0
  }
  if n is Paren {
    liftFnsInExpr(n.parInner, parent)
    return 0
  }
  if n is Member {
    liftFnsInExpr(n.memObj, parent)
    return 0
  }
  if n is Index {
    liftFnsInExpr(n.idxArr, parent)
    liftFnsInExpr(n.idxIndex, parent)
    return 0
  }
  if n is ObjLit {
    const fields = n.objFields
    let i = 0
    while i < fields.length {
      const f = P.nodes[fields[i]]
      if f is FieldInit { liftFnsInExpr(f.fiValue, parent) }
      i = i + 1
    }
    return 0
  }
  if n is ArrayLit {
    const elems = n.arrElems
    let i = 0
    while i < elems.length {
      liftFnsInExpr(elems[i], parent)
      i = i + 1
    }
    return 0
  }
  0
}

// ── function-index map ───────────────────────────────────────────────────────
// Map each function NAME to its wasm function index — its position in `fnStmts` — and record
// its return facts (voidness, struct index, ref-array element, boolean, kind). A `call` lowers
// a callee NAME through this map, so it is built over ALL top-level functions BEFORE any body
// is emitted: that makes forward references and (a function's own name being already mapped)
// recursion resolve for free. Two parallel module-global arrays — `fnNames[i]`'s function index
// is `fnIndices[i]`, which equals `i` here but is kept explicit. Arities differ, so each
// function gets its own functype (`emitModule`). Returns the function count.
export function buildFnMap(_stmts: i32[]) {
  fnNames = []
  fnIndexBySid = []
  nestedNameBySid = []
  fnIndices = []
  fRetVoid = []
  fRetStructIdx = []
  fRetRArrElem = []
  fRetBool = []
  fRetKind = []
  fRetLitAtom = []
  let i = 0
  while i < fnStmts.length {
    const s = P.nodes[fnStmts[i]]
    if s is FuncDecl {
      fnNames.push(s.fnName)
      // R6's BUILD POINT for `fnIndexBySid`/`nestedNameBySid` — see `collectFns`'
      // global row for the exactness argument the interning-as-we-build gives.
      const fsid = sidOfNode(fnStmts[i])
      // FIRST occurrence wins (mirrors the old linear `fnIndexOf`): a later lifted
      // function sharing a name does not overwrite the earlier slot.
      if sidArrGet(fnIndexBySid, fsid) < 0 { sidArrPut(fnIndexBySid, fsid, i) }
      // A nested (lifted) function's name — drives `fnIndexOfInScope`'s scan gate.
      if i < fnParent.length && fnParent[i] >= 0 {
        sidArrPut(nestedNameBySid, fsid, 1)
      }
      fnIndices.push(i)
      // A DECLARED `: void` return seeds the void classification directly — the
      // fixpoint below (`computeVoidFns`) covers only the UN-annotated half, and
      // an unseeded annotation left every `: void` function emitting `(result i32)`
      // (a trap or invalid wasm the moment it was called — see `retVoidAnnFlag`).
      fRetVoid.push(retVoidAnnFlag(s.fnRet))
      fRetStructIdx.push(retStructIndex(s.fnRet))
      fRetRArrElem.push(retRefArrElemName(s.fnRet))
      fRetBool.push(retBoolFlag(s.fnRet))
      // The stored return kind (the repOf fold): ONE `VKind` slot per function, seeded
      // from the annotation via the historical override chain (`retAnnKindChain`);
      // `computeRetInference` (the A20 name pass below + `criClassify`) writes the
      // un-annotated facts into the same slot, so `inferredRetKindCore` is a plain read.
      fRetKind.push(retAnnKindChain(s.fnRet))
      fRetLitAtom.push(0)
      // A20: an un-annotated SCALAR/STRING/array function's return is set DIRECTLY from
      // the checker's inferred return name — the emitter's expression-based fallback
      // below misses a return that is a plain variable (a `let`-bound string or list),
      // which then mis-classifies and fails codegen. Store the classifying kind from
      // the name; no AST node is synthesized (so `fmt` is untouched and the node arena
      // isn't grown mid-pass) and `i32` needs nothing (it is the default). `string[]`
      // stores `"strlist"` (the module-global string-list wrapper) — the
      // signature-emission path maps that kind to the right result valtype, where a bare
      // un-annotated return would otherwise fall back to i32.
      if s.fnRet < 0 {
        // An anonymous lambda's inferred return is keyed by NODE INDEX (the checker
        // recorded `#<nodeIx>`, since the lambda has no name the checker saw); fall back
        // to that when the name-keyed lookup misses (`__lambda_N` is unknown to the checker).
        // ONE row lookup, two columns. The name arms below and the arena arms above both need
        // this row, and resolving it once makes "they read the SAME row" structural rather than
        // a property of two readers agreeing — which is what a reviewer had to establish by hand.
        let inRow = inferRetRowOf(s.fnName)
        if inRow < 0 { inRow = inferRetRowByNode(fnStmts[i]) }
        let inm = ""
        if inRow >= 0 { inm = inferRetTyAt(inRow) }
        // The five LIST arms below used to match a WHOLE type spelling (`inm == "f64[]"`) —
        // one opaque compare fusing the `[]` (structure) with the leaf (a name), so neither
        // half could be seen or shared. The seam is the array grammar's ONE CUT plus a leaf
        // name; three of the five already had an exported one-line home THIS FILE ALREADY
        // IMPORTS (`nameIsF64Array` / `nameIsI64Array` / `nameIsF32Array`, each literally
        // `arrElemNameRaw(name) == "f64"`), and the `annRetNameOf` chain 1,800 lines below
        // calls two of them on exactly this kind of value. The `i32` / `string` arms take
        // the cut directly and compare the leaf, because their sibling homes
        // (`nameIsI32Array` / `nameIsStringArray`) are REP-wide, not spelling-exact:
        // `nameIsI32Array` also accepts `boolean[]`, a litunion `K[]`, `(boolean|null)[]` and
        // `(K|null)[]`, and `nameIsStringArray` also accepts `(string|null)[]`. Those share a
        // BACKING, not a `fRetKind`, so routing to them would WIDEN what this stores — the
        // faithful cut ships (the D-SHAPEFIELD precedent: unreached is not licensed).
        const li = fRetKind.length - 1
        // THE FIVE SCALAR ARMS ASK THE ARENA, not the render. Each was a WHOLE-SPELLING
        // equality against a name the compiler had just rendered from a type it held — the
        // plainest form of "render a type, then do type work on the render" — and the type is
        // in hand: `inferRetTyIx` banks it beside the name at the one recorder every producer
        // funnels through.
        //
        // SOUND, and the argument is NOT the obvious one — the obvious one is false in BOTH
        // directions, and a review caught both. Recorded because each names an invariant that
        // must not move.
        //
        // FALSE #1: "a non-`TyPrim` cannot render to a bare scalar name, every other
        // constructor carries its own syntax". A ONE-MEMBER `TyUnion` carries none — the join
        // writes its separator only for `i > 0`, so it renders as its member, bare — and
        // `type S = string` really does intern as one (the parser encodes every non-`{`-bodied
        // `type N = …` as a one-member `UnionDecl`). What actually closes it is the TRANSPARENCY
        // COLLAPSE: `declaredTyOfName` is the single bottom of every name-resolution route and
        // collapses a one-member union over a `TyPrim` unconditionally
        // (`singleAliasMemberTyIx`), so the wrapper is never handed out as a value's type. If
        // that collapse is ever gated, these five arms narrow with it.
        //
        // FALSE #2: "`tyToStructStr` of a `TyPrim` renders exactly its `primName`". A BRANDED
        // newtype (`type NS = new string`) is minted as a COPY of the base `Ty`, so it IS a
        // `TyPrim`, and `tyToStrGo`'s first act is a `nomNameOfTy` check that renders it `NS`.
        // It is inert here only because no recorder rung banks such a row —
        // `isClassifiableRetName("NS")` is false and every other rung needs a non-prim arena
        // shape — so neither column holds it and both sides no-op.
        //
        // THE ARMS THEREFORE REST ON `isClassifiableRetName`'s admitted set (bare scalars plus
        // `i32[]`/`string[]`), 20k lines away in `typecheck.vl`. Widen that gate, or add a rung
        // that banks a prim under a composite name, and the arena arms begin firing where the
        // name arms did not.
        //
        // i32 IS DELIBERATELY ABSENT and is not an oversight: it is the cascade's DEFAULT kind,
        // so it has no arm. A first probe that counted it reported 358 "disagreements" which
        // were all `name=[] arena=[i32]` — the comparison asked wrongly, not a defect.
        //
        // MEASURED — 177 files reach these arms, all five prims exercised (`string`, `i64`,
        // `f64`, `f32`, `boolean`), 0 disagreements either way — AND THE CORPUS COULD NOT HAVE
        // CONTAINED ONE. The only shape that produces a disagreement is the branded newtype
        // above, which is never banked, so it is absent from both columns regardless. The
        // agreement is consistent with the static argument and is not independent evidence for
        // it; read 0/177 as a smoke test, never as coverage.
        let retTyIx = -1
        if inRow >= 0 { retTyIx = inferRetTyIxAt(inRow) }
        let retPrim = ""
        if retTyIx >= 0 {
          const rpt = T.tys[retTyIx]
          if rpt is TyPrim { retPrim = rpt.primName }
          // AN INFERRED RETURN WHOSE JOIN IS AN UN-NAMED LITERAL UNION REPS AS A STRING REF,
          // which is the same rep its ANNOTATED twin (`: "circle" | "rect"`) already gets and
          // the contract `exprIsLitAtom`'s Call arm states. Without this the join fell past
          // every arm to the default i32 result while the value was a string ref.
          //
          // A NAMED alias (`type K = "a" | "b"`) is deliberately excluded: it reps as the
          // interned i32 ATOM, lowers un-annotated already, and forcing it to `"str"` here
          // would put a string-ref result on a function returning an id. That is the same
          // seam `retLitUnionInline` uses at the return site — one rule, asked twice, and it
          // has to be asked twice because the SIGNATURE and the VALUE are decided in
          // different passes.
          if retPrim == "" && tyIsLitUnion(retTyIx) {
            if !tyIsLitUnionAlias(retTyIx) { retPrim = "string" }
          }
        }
        // THE FIVE ARRAY ARMS, likewise from the arena. Each was a `[]`-CUT on the rendered name
        // (`arrElemNameRaw(inm) == "f64"`, and `nameIsF64Array` is literally that) — the same
        // render-then-parse the scalar arms were, one constructor out.
        //
        // NARROW BY CONSTRUCTION, which is the whole care here. The arms' own header explains
        // that they take the cut DIRECTLY rather than routing to `nameIsI32Array` /
        // `nameIsStringArray`, because those are REP-wide — they also accept `boolean[]`, a
        // litunion `K[]`, `(boolean|null)[]`, `(K|null)[]` — and those share a BACKING, not a
        // `fRetKind`. So this accepts exactly the five element names the cut admits and nothing
        // else.
        //
        // A `boolean` ELEMENT IS THE TRAP — #1511's i32 trap one constructor out. `boolean[]` is a
        // `TyArray` of `TyPrim`, so an arena test written the obvious way claims it, while the
        // cascade deliberately gives it NO arm (boolean rides i32, so it belongs to the default).
        // The first version of the probe here did exactly that.
        //
        // THE WHITELIST IS NOT WHAT MAKES TODAY'S CONVERSION SOUND, and saying otherwise would
        // overstate it: the `boolean[]` population is currently EMPTY. No recorder rung banks such
        // a row — `isClassifiableRetName` cuts to `"boolean"` and rejects, `isScalarListRetName`
        // admits only i64/f32/f64, and no `unm` rung takes a bare `TyPrim` element — so `retTyIx`
        // is -1 and `retElem` is "" with or without it. The whitelist protects against a future
        // widening of a gate 20k lines away, and is kept for exactly that.
        //
        // THE BRANDED-ELEMENT HAZARD, the array form of #1511's FALSE #2: `type NF = new f64` used
        // as `NF[]` IS a `TyArray` of `TyPrim f64` in the arena, while `tyToStrGo` renders it
        // `NF[]` and the cut declines. Inert for the same reason — no rung banks it. Add an array
        // rung that banks a bare `TyArray(TyPrim)`, or widen either gate, and these arms begin
        // firing where the name arms did not.
        //
        // AND FALSE #1 one constructor out: a one-member `TyUnion` element renders BARE, so
        // `type S = f64` used as `S[]` renders `f64[]`. Closed twice over — `singleAliasMemberTyIx`
        // collapses a `TyPrim` member unconditionally, and every residue it declines (a `TyLit`
        // member, a canonicalised intersection `TyObj`, a non-scalar-spine `TyArray`) renders as
        // something that is not a bare prim name.
        //
        // The recorded ARRAY type is read off the same row the name came from, so the two cannot
        // select different rows — see the `inRow` note above.
        //
        // Measured: 13 corpus files reach these arms, all five element kinds exercised, 0
        // disagreements — AND THE CORPUS COULD NOT HAVE CONTAINED ONE, for the same reason
        // #1511's 0/177 could not: the only shapes that disagree (branded element, one-member
        // union element) are never banked, so they are absent from both columns regardless. What
        // makes the conversion safe is the argument above, not the count.
        //
        // The population also splits: `i32[]`/`string[]` reach these arms from BOTH the named and
        // the lambda recorder, while `f64[]`/`i64[]`/`f32[]` reach them ONLY through the anonymous
        // lambda's `isScalarListRetName` rung — `isClassifiableRetName` gates named functions out,
        // which `wasmEmit`'s f32 reject already relies on.
        let retElem = ""
        // Five ATOM compares; the one widening happens only where the name is stored.
        const raePrim = tyArrayElemPrim(retTyIx)
        const raeOk = raePrim == "i32" ||
          raePrim == "string" ||
          raePrim == "f64" ||
          raePrim == "i64" ||
          raePrim == "f32"
        if raeOk { retElem = primNameStr(raePrim) }
        if retPrim == "string" {
          fRetKind[li] = "str"
        } else if retPrim == "i64" {
          fRetKind[li] = "i64"
        } else if retPrim == "f64" {
          fRetKind[li] = "f64"
        } else if retPrim == "f32" {
          fRetKind[li] = "f32"
        } else if retPrim == "boolean" {
          fRetBool[li] = 1
        } else if retElem == "i32" {
          fRetKind[li] = "list"
        } else if retElem == "string" {
          fRetKind[li] = "strlist"
        } else if retElem == "f64" {
          fRetKind[li] = "f64list"
        } else if retElem == "i64" {
          fRetKind[li] = "i64list"
        } else if retElem == "f32" {
          fRetKind[li] = "f32list"
        } else if nameIsMap(inm) && mapValNameOf(inm) == "i32" {
          // A mono `{[string]: i32}` map inferred return (a returned map local). `criClassify`'s
          // `exprMap` can miss it (a returned LOCAL's kind isn't collected during the global
          // return pass), so set it reliably from the checker's inferred return NAME.
          fRetKind[li] = "map"
        } else if nameIsNulString(inm) {
          // A `string | null` niche inferred return drives the kind-16 result valtype
          // (`ref null $array`) — same kind the annotated `: string | null` path stores, so
          // `fnRetNulString` and the signature emission both classify it. The `boolean |
          // null` niche stores NOTHING: its result valtype is plain i32 (the sentinel rides
          // an i32), so it falls through to the default.
          //
          // A NULLABLE, not an array: its seam is the depth- and quote-aware `|` split
          // (`nullablePartOf`) plus a leaf name, and that pair already has a home this file
          // imports and already calls on the ANNOTATION side (`collectA`) — `nameIsNulString` IS
          // `nullablePartOf(name) == "string"`. This was the FOURTH hand-written copy of that
          // niche's spelling; `inferNicheNullByName` (`emit_base`) retired the third in the
          // same way and reads the SAME `inferRetNameOf` value this arm does.
          //
          // The home also accepts `null|string`, where the whole-spelling compare did not.
          // That widening cannot fire here: every producer of a nullable inferred-return name
          // is `nullableRetName` / `nulLitUnionRetName` / the `TyNullable` arms in
          // `typecheck.vl`, and all of them mint `<part> + "|null"` — the non-null part is
          // always FIRST, so the reversed order is not a producible spelling of this column.
          fRetKind[li] = "nulstr"
        } else if (nameIsMap(nullablePartOf(inm))) {
          // D937 — THE NULLABLE MAP inferred return (`{[string]: i32} | null`), the sibling of
          // the mono-map arm above and of D887's nullable-struct arm below. Same pair the
          // ANNOTATED `: {[string]: i32} | null` path stores (`retNulMapFlag` -> `"nulmap"`),
          // read off the name the checker recorded instead of the annotation node there is
          // none of.
          //
          // D956 — ANY string-keyed map, not just the i32-valued one. D937 restricted this to
          // `i32` because its return-site seed assumed the MONO shape; that seed now asks
          // `inferredRetMapSlot`, the same home the signature side already reads, so the
          // restriction has nothing left to protect.
          //
          // AHEAD of `inferNulStructRow`, which would otherwise be asked to resolve a map
          // rendering as a struct row — it answers -1 and the name would fall through to the
          // union arms, but the order is stated rather than relied on.
          fRetKind[li] = "nulmap"
        } else if inferNulStructRow(inm) >= 0 {
          // D887 — A NULLABLE-STRUCT inferred return (`{r: i32} | null`, `P | null`), the arm
          // the niche comment above ends by excluding. It is the SAME pair the ANNOTATED
          // `: {r: i32} | null` path stores (`retNulRefFlag` -> `"nulstruct"` +
          // `retStructIndex`), read off the name the checker recorded instead of the
          // annotation node there is none of — so `emitOneFuncType`'s inferred arm mints
          // `(ref null $S)`, `fnRetStructIndexSid` answers the call site with the same row, and
          // `emitReturnValue` seeds a bare `return null` as `ref.null $S`. All four owners of a
          // return row (D871) therefore read one answer, which is the property that column
          // exists to keep.
          //
          // AHEAD of the two union arms below, because the row is a NULLABLE and neither of
          // them should see it: a `{r:i32}|null` name is not a value union (no second value
          // atom) and not a registered struct union, so both decline anyway — the order is
          // stated rather than relied on.
          fRetKind[li] = "nulstruct"
          fRetStructIdx[li] = inferNulStructRow(inm)
        } else if inferRetIsValueUnionAt(inRow, inm) {
          fRetKind[li] = "union"
        } else if (
          inferRetIsUnionAt(inRow, inm) &&
          !inferRetIsLitUnionAt(inRow, inm)
        ) {
          // A registered STRUCT-union inferred return (`Cat | Dog` — registered from this
          // same name in `collectU`): the variant-boxed rep rides the SAME union result
          // valtype as a value union (kind 4 box), so store `"union"`. The expression-based
          // fallback would NOT catch it (a single object-literal return is not itself a
          // union expression), so set it from the name here.
          //
          // A registered LITUNION alias (`type K = "a" | "b"`) is `isUName` too — every
          // litunion registers as a union NAME — but its rep is the interned i32 ATOM, which
          // is the default kind, NOT the box. The annotation side excludes it at the same
          // seam (`nodeTyIsLitUnionAlias`, `emitOneFuncType`'s `vtKindOfType`); this is that
          // exclusion asked of the inferred NAME, the only handle this side holds.
          fRetKind[li] = "union"
        }
      }
    }
    i = i + 1
  }
  // The scope-chain child index is derived from `fnParent`, which `collectFns` has just
  // rebuilt — drop the previous program's copy so the lazy build below cannot read it.
  fnChildHead = []
  fnChildNext = []
  fnStmts.length
}

// ── scope-aware callee resolution ────────────────────────────────────────────
// `fnParent` INVERTED — the child list of each frame, as two intrusive i32 columns:
// `fnChildHead[p]` is the `fnStmts` position of the FIRST function declared in frame
// `p` (-1 for a frame that declares none) and `fnChildNext[i]` the next sibling of `i`.
// A DERIVED index of `fnParent`, private to the one function below that reads it — it
// is not emitter state, so it does not belong in `emit_state.vl`; it is a cache of a
// column that file already owns.
//
// WHY IT EXISTS: `nestedFnDeclaredIn` answered "which function does frame `pp` declare
// under `name`?" by scanning ALL of `fnStmts` — so the scope-chain walk cost
// O(depth x functions) per resolved call, and the emitter resolves one per call site.
// #1207 shipped that walk and reported the cost honestly: QUADRATIC in the frame count.
// The remedy is to index by the pair the query is actually keyed on. Indexing by NAME
// alone does not fix it: the pathological shape is N frames that each declare the SAME
// nested name, so a name bucket holds N entries and the scan is quadratic again. The
// PARENT is the discriminating axis — a frame declares a handful of functions, and in
// the ladder exactly one.
//
// The two columns are RESET (not rebuilt) by `buildFnMap`, and rebuilt on first use
// below. The reset is LOAD-BEARING and pinned: the freshness test is a LENGTH, so without
// the reset a second program in the same `WebAssembly.Instance` — how
// `tests/cases_wasm_test.ts` and `vl check <dir>` compile a whole corpus — keeps the
// first program's parents whenever the two agree on `fnStmts.length`.
// `functions/scope-index-reset-{a,b}.vl` is that pair: drop the two lines below and `-b`
// prints 1001 for 21, rc=0.
let fnChildHead: i32[] = []
let fnChildNext: i32[] = []

// Rebuild both columns from `fnParent`. Walks DESCENDING so each head-push lands the
// LOWER position first: the list comes out in ascending `fnStmts` order, which is what
// keeps "the first declaration wins" byte-identical to the scan this replaces.
function buildFnChildIndex() {
  fnChildHead = []
  fnChildNext = []
  let i = 0
  while i < fnStmts.length {
    fnChildHead.push(-1)
    fnChildNext.push(-1)
    i = i + 1
  }
  let j = fnStmts.length - 1
  while j >= 0 {
    if j < fnParent.length {
      const p = fnParent[j]
      // A parent is always a `fnStmts` position captured before the child was pushed
      // (`liftFnsInExpr`'s `wi`), or -1 for a top-level / mono-cloned function; the
      // bound is a guard, not a filter.
      if p >= 0 && p < fnChildHead.length {
        fnChildNext[j] = fnChildHead[p]
        fnChildHead[p] = j
      }
    }
    j = j - 1
  }
  fnChildHead.length
}

// The `fnStmts` position of a lifted function named `name` whose PARENT frame is the
// `fnStmts` position `pp` — i.e. the function `pp`'s body DECLARES under that name — or
// -1 when that frame declares no such function. Visits `pp`'s children in `fnStmts`
// order, so the first declaration wins; a frame declaring one name twice is a checker
// error already.
//
// The length compare is the lazy build: the index is reset per program and minted on
// the first scope-aware resolution, so a module with no nested functions — every module
// the compiler itself compiles — never pays for it. It also re-mints after a late
// `fnStmts` push (`monomorphize` clones functions), which is why the freshness test is
// a LENGTH and not a flag.
function nestedFnDeclaredIn(name: string, pp: i32) {
  if fnChildHead.length != fnStmts.length { buildFnChildIndex() }
  if pp < 0 || pp >= fnChildHead.length { return -1 }
  let i = fnChildHead[pp]
  while i >= 0 {
    const s = P.nodes[fnStmts[i]]
    if s is FuncDecl {
      if s.fnName == name { return i }
    }
    i = fnChildNext[i]
  }
  -1
}

// Resolve a CALLEE name to its wasm function index through the calling frame's LEXICAL
// SCOPE CHAIN, instead of `fnIndexOf`'s flat first-occurrence-wins map.
//
// `buildFnMap` above keys lifted functions by NAME and keeps the FIRST — so the flat
// lookup hands EVERY frame the module's first function of that name. Two makers that
// each declare their own nested `inner` therefore both call the first maker's, which is
// a SILENT WRONG ANSWER whenever the two bodies happen to agree in shape and invalid
// wasm when they do not. The same first-wins rule also makes a TOP-LEVEL function beat a
// nested one unconditionally, because `collectFns` pushes every top-level function into
// `fnStmts` BEFORE it lifts anything.
//
// The lexical rule is: the INNERMOST enclosing scope that declares `name` wins. So walk
// outward from the calling frame and stop at the first hit — the calling frame's own
// nested declarations first (which is also what lands a nested function's RECURSIVE
// self-call on itself: the frame that declares it is its parent, exactly one step out),
// then each enclosing frame in turn. Running off the chain (`-1` = top level) means no
// nested binding is in scope, and the flat map's answer — a top-level function — is then
// the correct one.
//
// `fnIndexOfInScope` (emit_classify) is the DELIBERATE TWIN of this walk, wired to the
// function-VALUE path. It cannot delegate here: `emit_collect.vl` already imports 144
// names from `emit_classify.vl` and the reverse edge makes the compiler refuse to build
// itself. The dedup is one line — `fnIndexOfInScopeChain(name, fnIx)` in place of its
// body — for whoever moves one of the two files. FILED, not taken: its own frame scan is
// still the O(functions) one this file just retired, so the twin carries the quadratic
// cost on the function-VALUE path even now that the CALL path does not.
//
// Cost: gated on `nestedNameSet`, so a callee that is not a nested function name
// anywhere — every call in a module without nested functions, and nearly all of them in
// a module with some — costs exactly the one `fnIndexOf` map lookup it cost before.
// Past the gate the walk is O(chain depth) with a bounded probe per rung
// (`nestedFnDeclaredIn` visits one frame's children, not every function), where it used
// to be O(depth x functions) — the quadratic #1207 measured and filed rather than fixed.
//
// THE QUADRATIC TERM THIS WALK USED TO SIT NEXT TO IS `fnStmtsPosOf`'s (emit_classify),
// and it answers from `emitCurFnPos` for anything asked while a function body is being
// lowered — the ladder that made it visible (N functions each calling their own nested
// function) runs 252 -> 123 ms of CPU at N = 1,600, with `fnStmtsPosOf` 48.9% -> 3.7% of
// the compile's samples. What is left of it is the reaches from passes that run BEFORE
// `emitCodeSection`, this one included: there is no cursor to answer from yet, so the
// `fnStmtsPosOf` below is still the scan.
export function fnIndexOfInScopeChain(name: string, fnIx: i32) {
  fnIndexOfInScopeChainSid(sidLookup(name), name, fnIx)
}

// The sid-taking primitive (design R5). The callers that have the callee's arena
// index pass `sidOfNode(ix)` and pay NOTHING for the gate below; the string form
// above pays one `sidLookup` probe, which is what the `nestedNameSet` map probe it
// replaces cost. `name` still rides along because the scan the gate guards
// (`nestedFnDeclaredIn`) compares `FuncDecl.fnName` strings — converting THAT is a
// later slice, and it is off the hot path by construction (the gate is false for
// every callee in a module with no nested functions, this compiler included).
export function fnIndexOfInScopeChainSid(sid: i32, name: string, fnIx: i32) {
  if fnIx >= 0 && sidArrGet(nestedNameBySid, sid) == 1 {
    let pp = fnStmtsPosOf(fnIx)
    // `fnStmts.length` bounds the walk: a parent chain cannot be longer than the
    // function count, so this terminates even were `fnParent` ever to contain a cycle.
    let steps = 0
    while pp >= 0 && steps <= fnStmts.length {
      const hit = nestedFnDeclaredIn(name, pp)
      if hit >= 0 { return hit }
      if pp < fnParent.length { pp = fnParent[pp] } else { pp = -1 }
      steps = steps + 1
    }
  }
  fnIndexOfSid(sid)
}

// Classify each function's VOIDNESS as a monotone fixed point: a candidate (no
// return annotation) is void when its body has no valued `return` and no tail
// value. `stmtIsTailValue` consults `fRetVoid` for tail CALLS, so marking a
// callee void can make its CALLERS' tails non-values — iterate until stable
// (the void set only grows; bounded by the function count).
export function computeVoidFns() {
  let changed = true
  while changed {
    changed = false
    let i = 0
    while i < fnStmts.length {
      if fRetVoid[i] == 0 {
        const fn = P.nodes[fnStmts[i]]
        if fn is FuncDecl {
          if fn.fnRet < 0 {
            if !blockHasValuedReturn(fn.fnBody) {
              // An else-less tail `if` makes the return `T | null` (`function f(c) { if
              // c then 5 }`), but `blockTailIsValue` deliberately ignores else-less ifs
              // (they feed THIS fixpoint — a void procedure's recursive tail
              // `if n>0 { rec(n-1) }` must not look like a value). So also consult the
              // static checker classification: a NULLABLE inferred return (a name with a
              // `null` atom) is non-void. Gated to nullable specifically (not just
              // non-empty) so an i32-valued tail the emitter can't lower as a value — e.g.
              // a Member-target assignment `state.x = …`, which the checker reads as an
              // i32 expression but `stmtIsTailValue` rejects — still classifies void.
              // D1034 — AN EMPTY TAIL ARM OVERRIDES THE NULLABLE VETO. `if c { } else {
              // buf.push(1) }` makes the checker infer `i32 | null` — one arm's value, the
              // other's absence — and `inferRetBearsNull` then keeps the function non-void,
              // so the empty arm was floored with a compiler-emitted `unreachable`: check rc
              // 0 and a trap on whichever branch ran. An arm written EMPTY is the author
              // saying there is no value here, and the nullable inference is reading that
              // absence as a null the caller could receive. Both arms non-empty still
              // classifies exactly as before.
              // D1032 — A BARE `return` IN THE BODY IS THE SAME VETO, written by the
              // author rather than inferred. You cannot `return;` out of a function that
              // owes a value, so its presence settles the question the nullable inference
              // was guessing at.
              // ONE RULE, replacing the two ad-hoc vetoes this started as: the nullable
              // inference only keeps a function non-void where the tail `if`'s arms actually
              // end in VALUES — the shape `inferRetBearsNull` was written for. An empty arm,
              // a bare-`return` guard and an index-target assignment are all "not a value",
              // and each was a separate filed row before the rule was stated once.
              const d34Void = !tailIfNullableIsReal(fn.fnBody, fnStmts[i])
              if (
                !blockTailIsValue(fn.fnBody, fnStmts[i]) &&
                (d34Void || !inferRetBearsNull(fn.fnName)) &&
                !fnReturnsClosure(i)
              ) {
                // A function whose tail is a function VALUE (`(a) => (b) => …`) returns a
                // closure, NOT void — `blockTailIsValue` ignores a bare lambda tail, so guard
                // it here (else f's functype is `()->()` and `f(4)` reads as a void result).
                fRetVoid[i] = 1
                changed = true
              }
            }
          }
        }
      }
      i = i + 1
    }
  }
  0
}

// D887 — THE STRUCT ROW an inferred-return NAME's nullable part occupies, or -1.
//
// The name is the checker's own render (`nullableRetName`), so a DECLARED inner arrives as its
// nominal name and an INLINE shape as the emitter-format text — and `structIndexOfTypeName`
// resolves both, the second by FIELD SET, onto exactly the row the annotated spelling keys.
// Answers -1 for every non-nullable name, for a nullable whose part names no row, and for the
// niches above (`string|null` and friends are claimed before this arm is reached).
function inferNulStructRow(inm: string): i32 {
  const part = nullablePartOf(inm)
  if part == "" { return -1 }
  structIndexOfTypeName(part)
}

export function computeRetInference() {
  let changed = true
  while changed {
    changed = false
    let i = 0
    while i < fnStmts.length {
      const fn = P.nodes[fnStmts[i]]
      if fn is FuncDecl {
        if fn.fnRet < 0 && fRetVoid[i] == 0 {
          // Classify over EVERY valued return (tail value first — the same
          // preference `fnRetExprOf` had), not just the first: a function whose
          // first return is an unclassifiable narrowed path read (`if x?.y is
          // string { return x.y } return "-1"`) still types from its other
          // returns — the checker already proved all returns agree. The walk is
          // NARROWING-AWARE (`criWalkBlock` mirrors the emit loops' condition /
          // post-guard narrowing), so `if v !is i32 { return v }` classifies the
          // narrowed `v` as its complement (a string return, not the union box) —
          // the host's flow-sensitive return typing.
          criChanged = false
          // The classifier's half of the capture-narrowing replay (the emitter's is in
          // `emitFuncCode`): a closure whose value IS a narrowed captured read has to be
          // classified at the narrowed rep, or its inferred result type disagrees with the
          // bytes its body emits. Same table, same seed function, so they cannot drift.
          const savedCapNarrow = capNarrowSeed(i)
          const fnb = P.nodes[fnStmts[i]]
          if fnb is FuncDecl {
            const fb = P.nodes[fnb.fnBody]
            if fb is Block {
              const fbs = fb.blkStmts
              if fbs.length > 0 {
                const tailIx = fbs[fbs.length - 1]
                if stmtIsTailValue(tailIx, fnStmts[i]) {
                  criClassify(tailIx, i)
                } else {
                  // A tail VALUE-IF (`function pick(c) if c > 1 { mk(1) } else { mk(2) }`) is not a
                  // `stmtIsTailValue` (that predicate has no IfStmt case), so a NAMED function's
                  // inferred STRUCT return through an if-join went unclassified — the name path
                  // records only scalar/string/list returns and `criWalkBlock` classifies a tail
                  // value only for anonymous lambdas. Classify the whole `if` here: `exprStruct`/
                  // `exprString` see through it (then-arm rep), so the join's struct/string ref is
                  // picked up. A struct-UNION join is already `"union"` (name path) — the
                  // not-union guard in `criClassify` keeps it from being re-claimed a struct.
                  const tn = P.nodes[tailIx]
                  if tn is IfStmt {
                    if tn.ifElse >= 0 { criClassify(tailIx, i) }
                  }
                }
              }
            }
            criWalkBlock(fnb.fnBody, i)
          }
          restoreNarrow(savedCapNarrow)
          if criChanged { changed = true }
        }
      }
      i = i + 1
    }
  }
  // THE LITERAL-UNION ATOM RETURN, recorded once the kinds have settled.
  //
  // A SEPARATE PASS, not an arm inside `criClassify`, and the reason is measured: asking
  // `exprIsLitAtom` inside that classifier moved `unions/atom-string-join.vl` from green to
  // `print of a literal-union atom whose type carries no member texts`. `criClassify` runs to
  // a FIXPOINT and its arms feed each other through `criSetRetKind`/`criChanged`, so an extra
  // question asked inside it is not free of the loop it sits in. Asked once, afterwards, it
  // observes the settled state instead of participating in it.
  //
  // It needs no narrowing replay: the receiver of a shared TAG read resolves through
  // `unionNameOfIdent` — the PARAM's declared union — which `currentStructNarrowSetOf` falls
  // back to when nothing is narrowed. That is why this can live outside `criWalkBlock`.
  //
  // WHY A FLAG AND NOT A `fRetKind`: both reps ARE i32, so the kind cannot carry it. See
  // `fRetLitAtom`'s header for the wrong value that costs.
  let la = 0
  while la < fnStmts.length {
    const laFn = P.nodes[fnStmts[la]]
    if laFn is FuncDecl {
      // GATED ON THE SETTLED KIND BEING `i32`, which is what an atom return leaves it at. A
      // function whose returns JOIN an atom with a string (`if c { return k }  return "cc"`)
      // settles at `"str"` and WIDENS the atom at its own return — its result is a string
      // ref, and `fnRetExprOf` picks only one return, which may be the atom arm. Without this
      // gate that function was flagged and its callers widened a value already widened:
      // measured, `unions/atom-string-join.vl` went from green to `print of a literal-union
      // atom whose type carries no member texts`. The kind is the settled answer for ALL
      // returns; the expression test is what distinguishes an atom from a plain i32.
      if laFn.fnRet < 0 && fRetVoid[la] == 0 && fRetKind[la] == "i32" {
        const laRx = fnRetExprOf(fnStmts[la])
        if laRx >= 0 {
          if exprIsLitAtom(laRx, fnStmts[la]) {
            if la < fRetLitAtom.length { fRetLitAtom[la] = 1 }
          }
        }
      }
    }
    la = la + 1
  }
  0
}

// Declare the THREE locals a `for v in <iter>` needs, in the pre-order `emitForInStmt`
// consumes them: the element var `v` (its rep is `forInElemKind`'s answer), a hidden i32
// cursor `v#i`, and a hidden temp `v#l` holding the iterable (evaluated ONCE). The hidden
// names carry `#` so they can never collide with a user identifier. Leaves `v` bound in the
// current scope frame — the CALLER walks the body and `scopeUnbind`s, because the loop
// variable's scope is the loop.
//
// ONE HOME, BECAUSE THE MODULE-SCOPE AND FUNCTION-SCOPE WALKS MUST DECLARE THE SAME SLOTS.
// A top-level `for` lives in the START function and was collected by a hand-copied second
// version of this arm that had only the struct / string / f64 / i64 kinds — so a
// module-scope walk over any other ref-array element (a union box, a nullable-struct niche,
// a nested array, a closure, an f32) declared the `#l` temp as a plain i32 list, which is a
// different valtype than the one `emitForInStmt` reads it back at. The kind ladder and the
// `#l`-slot resolution are one question about one loop; asking it in two places is how the
// second copy silently lags every element kind the first one learns.
export function declareForInLocals(s: ForIn, fnIx: i32) {
  const fiEk = forInElemKind(s.fiIter, fnIx)
  if fiEk == null {
    return emitFail("emitProgram: unsupported for-in iterable")
  }
  // A struct element (`S[]`, code 1) binds the loop var as a struct local
  // carrying the element struct table index; the `#l` temp holds the ref-list
  // WRAPPER (code 5 + the ref-list slot). i32/string elements keep their slots.
  let fiVarIdx = -1
  let fiLk: VKind = "list"
  if fiEk == "struct" {
    fiVarIdx = forInRefArrayStructIdx(s.fiIter, fnIx)
    fiLk = "reflist"
  } else if fiEk == "variant" {
    // A UNION-ARM element (`Circle[]` / an arm-valued map's `.values()`, code 8): the loop
    // var carries the VARIANT-table row, so its cell is `(ref $(uVarHeap[vi]))` — exactly
    // what a `const c: Circle = …` local binds. The `#l` temp is the ref-list WRAPPER (code
    // 5), as for every other ref element. The resolver is the struct arm's arm-for-arm
    // twin; both halves of it were already written as REFUSALS in the struct one (D50).
    fiVarIdx = forInRefArrayVariantIdx(s.fiIter, fnIx)
    fiLk = "reflist"
  } else if fiEk == "nulstruct" {
    // A NULLABLE-struct element (`(P | null)[]`): the loop var is a kind-9 niche carrying
    // the element struct index; the `#l` temp is the ref-list WRAPPER (code 5).
    fiVarIdx = forInRefArrayStructIdx(s.fiIter, fnIx)
    fiLk = "reflist"
  } else if fiEk == "union" {
    // A union-box element list: the loop var is a kind-4 union box (no struct index);
    // the `#l` temp is the ref-list WRAPPER (code 5), like the struct case.
    fiLk = "reflist"
  } else if (
    fiEk == "list" ||
    fiEk == "nullist" ||
    fiEk == "strlist" ||
    fiEk == "f64list" ||
    fiEk == "i64list" ||
    fiEk == "f32list" ||
    fiEk == "nulstrlist" ||
    fiEk == "nulf64list" ||
    fiEk == "nuli64list" ||
    fiEk == "nulf32list"
  ) {
    // A NESTED-ARRAY loop var — the inner LIST (kind 2/7/12/20), or the NULLABLE niche a
    // `(T[] | null)[]` element binds (kind 15 for the shared i32 backing, 22/23/24/25 for the
    // four distinct-backing leaves). The `#l` temp is the OUTER ref-list WRAPPER (code 5) in
    // every case; each element is the inner list wrapper ref, nullable or not.
    fiLk = "reflist"
  } else if fiEk == "closure" {
    // A CLOSURE element (`((i32) => i32)[]`): the loop var is a kind-14 closure (no struct
    // index); the `#l` temp is the ref-list WRAPPER (code 5), like the struct case.
    fiLk = "reflist"
  } else if fiEk == "reflist" || fiEk == "nulreflist" {
    // A NESTED REF array (`S[][]`): the loop var is the inner REF LIST (kind 5) carrying its
    // ref-list slot; the `#l` temp is the OUTER ref-list wrapper (code 5). A `(S[] | null)[]`
    // element binds the kind-18 NULLABLE ref list off the SAME inner slot — the slot names the
    // wrapper heap type, the kind carries the nullability.
    const fiOuter = refListSlotOfExpr(s.fiIter, fnIx)
    fiVarIdx = rlElemInnerSlot(fiOuter)
    fiLk = "reflist"
  } else if fiEk == "str" || fiEk == "nulstr" {
    // A `(string | null)[]` iterable shares the string list's BACKING (`nulstr` is the
    // string-ref niche — a `(ref null $sTypeIdx)` element slot), so the `#l` temp is the
    // same string-list wrapper the non-null element uses. Only the loop VAR differs.
    fiLk = "strlist"
  } else if fiEk == "f64" {
    fiLk = "f64list" // f64 element → f64-list `#l` temp
  } else if fiEk == "i64" {
    fiLk = "i64list" // i64 element → i64-list `#l` temp
  } else if fiEk == "f32" {
    fiLk = "f32list" // f32 element → f32-list `#l` temp
  }
  // A STRING iterable (`for ch in s`): the `#l` temp holds the string itself (code 3, the
  // raw `(ref $aTypeIdx)` array), not an i32-list wrapper. The loop var stays code 0 (i32).
  if fiEk == "i32" && forInStringSrc(s.fiIter, fnIx) { fiLk = "str" }
  // A PACKED BYTE LIST (`for b in bs`, `bs: u8[]`): the `#l` temp is the `$bl8` wrapper over
  // the one-byte backing. The loop var stays code 0 — `array.get_u` widens each byte to an
  // i32 — so this is the THIRD i32-element iterable whose temp is not the i32 list, and the
  // one `forInU8Src` was added for. Ordered beside the string arm because it answers the same
  // shape of question; the two predicates are mutually exclusive (a string is not a `u8[]`).
  if fiEk == "i32" && forInU8Src(s.fiIter, fnIx) { fiLk = "u8list" }
  const fiSlot = addLocalName(s.fiVar, fiEk, fiVarIdx)
  // A literal-union array (`for k in xs`, `xs: K[]`): the loop var is an i32 atom (kind 0),
  // but flag it so `k`-as-atom (print widening, `==`, member compare) is recognized.
  //
  // THE NULLABLE ELEMENT NEEDS THE SAME FLAG. `xs: (K | null)[]` is the same i32 slot with `-1`
  // for null, and a loop var is the ONE storage class `exprNulLitUnion` cannot reach (it resolves
  // captures, params, `let`s and globals — a loop var is none of those, and has no LetDecl). With
  // only the non-null half asked here, nothing claimed the loop var as an atom and `print(k)` fell
  // through to `__print_i32__`: the raw interned id.
  if (
    nodeArrayElemIsLitUnion(s.fiIter) ||
    nodeArrayElemIsNulLitUnion(s.fiIter)
  ) {
    localLitUnion[fiSlot] = 1
  }
  markLoopVarIter(fiSlot, s.fiIter)
  scopeBind(s.fiVar, fiSlot)
  addLocalName(s.fiVar + "#i", "i32", -1)
  let fiLs = -1
  if (
    fiEk == "struct" ||
    fiEk == "variant" ||
    fiEk == "union" ||
    fiEk == "nulstruct" ||
    fiEk == "list" ||
    fiEk == "nullist" ||
    fiEk == "strlist" ||
    fiEk == "f64list" ||
    fiEk == "i64list" ||
    fiEk == "f32list" ||
    fiEk == "nulstrlist" ||
    fiEk == "nulf64list" ||
    fiEk == "nuli64list" ||
    fiEk == "nulf32list" ||
    fiEk == "closure" ||
    fiEk == "reflist" ||
    fiEk == "nulreflist"
  ) {
    const fiMvs = forInMapValsSlot(s.fiIter, fnIx)
    if fiMvs >= 0 {
      fiLs = mvRlSlot[fiMvs]
    } else {
      fiLs = refListSlotOfExpr(s.fiIter, fnIx)
    }
  }
  addLocalName(s.fiVar + "#l", fiLk, fiLs)
  return 0
}

// Recursively collect the declared-local names of the block at `blockIx` into
// `localNames`, descending into `if` then/else branches (wasm locals span the whole
// function, so a local declared inside a branch still needs a slot). Each declared
// local's init type is validated as i32-compatible here, so a non-i32 local fails
// loudly BEFORE any bytes are emitted. Returns 0, or -1 (via `emitFail`) on a
// non-block node, an out-of-scope statement (e.g. a loop), or a non-i32 local.
export function collectLocals(blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    // Enter this block's lexical scope: bindings appended below are live (and resolve
    // a same-named init expr to the RIGHT slot) only within it, and are dropped on exit.
    scopePush()
    const stmts = b.blkStmts
    // Post-guard complement narrowing, pushed at the foot of the loop below and rewound
    // here on exit — the same save/restore `emitStmts` and `blockHasStrOpScan` carry.
    // Without it a binding BELOW a divergent guard (`if !(t is S) { return … }` /
    // `if t is Other { return … }`) classifies its init with the union UN-narrowed, so
    // every `letIs*` declines and the slot falls through to the i32 default — while
    // `wasmEmit`, which does push it, stores the narrowed variant's field into that
    // cell. That disagreement is a module that does not validate.
    const savedGuardTop = narrowTop
    let i = 0
    while i < stmts.length {
      const s = P.nodes[stmts[i]]
      if s is LetDecl {
        synthEmptyListAnn(stmts[i])
        synthNullableAnn(stmts[i])
        synthRetPinAnn(stmts[i], fnIx)
        // `-1` for the program root: the LATE run has no module scope to hand over and
        // must not acquire one. It reaches the START function's blocks and the bodies
        // monomorphization minted, both of which are already past the point where a
        // caller's annotation could re-aim an instance's signature — which is the whole
        // reason `synthDstPinAnns` runs before `monomorphize`. Every binding the
        // pre-mono pass pinned is declined here by the `letType >= 0` guard on entry.
        synthDstPinAnn(stmts[i], fnIx, -1)
        // Classify the init type BEFORE binding the name, then allocate a fresh slot and
        // bind `name → slot` so a LATER reference (or a shadowing inner `let`) resolves to
        // THIS slot. `slot` is the new slot's declared-local position.
        let slot = -1
        if letIsLitUnion(stmts[i]) || letInitIsLitAtom(stmts[i], fnIx) {
          // A literal-union local — annotated `: K`, or UN-annotated off an atom init (`const sk =
          // xs[i]` over a `K[]`). It is an i32-backed interned ATOM, NOT a value-union box. FIRST: its
          // members register as value-union variants, so it must be intercepted before `letIsVariant`
          // / `letIsUnion`; AND before `letIsString` (its `string`-subtype checker type would else
          // pick the kind-3 ref slot and store the i32 atom into a `(ref $array)` cell — invalid wasm).
          slot = addLocalName(s.letName, "i32", -1)
          localLitUnion[slot] = 1
        } else if letNulLitUnion(stmts[i], fnIx) {
          // A `K | null` NICHE local (kind 0, plain i32): atom ids ≥ 0 with the spare `-1` = null.
          // BEFORE `letIsNulString` (a litunion softens to `string`, so `string | null` would else
          // claim it as the kind-16 ref). Marked `localLitUnion` so reads widen as atoms; the write
          // path seeds `-1` for a `null` assignment (`exprNulLitUnion`, an AST walk, not the slot kind).
          slot = addLocalName(s.letName, "i32", -1)
          localLitUnion[slot] = 1
        } else if letIsNulMap(stmts[i], fnIx) {
          // A NULLABLE map local (`{[string]: V} | null`, kind `nulmap`) — BEFORE `letIsMap`
          // (a nullable init/annotation must not collapse to the non-null kind `"map"`, whose
          // `(ref $mapStruct)` cell cannot hold `null`). Its `localStructIdx` carries the SAME
          // map SHAPE as the non-null map (mono ⇒ -1, mv slot for a typed value); the `(ref null
          // $mapStruct)` cell holds the map or null, narrowed non-null at every op site.
          slot = addLocalName(
            s.letName,
            "nulmap",
            nulMapShapeOf(stmts[i], fnIx),
          )
        } else if letNulMapReadValKind(stmts[i], fnIx) != null {
          // A bare `const t = m[k]` read of a LIST- or nested-MAP-valued map (`V | null`):
          // binds the value's ESTABLISHED nullable local kind (`nullist` / `nulstrlist` /
          // `nulf64list` / `nuli64list` / `nulf32list` / `nulreflist` / `nulmap`) — the
          // same kinds a direct `V | null` annotation produces, so the narrow + read
          // machinery lowers unchanged. BEFORE the union-read guard (which now covers only
          // the kind-2 box values) and the non-null kinds (a later `t = null`-free narrow
          // must see the nullable cell).
          const nmrK = letNulMapReadValKind(stmts[i], fnIx)
          if nmrK != null {
            slot = addLocalName(
              s.letName,
              nmrK,
              letNulMapReadSlotArg(stmts[i], fnIx),
            )
          }
        } else if letNulMapReadUnionBox(stmts[i], fnIx) {
          // A bare `const t = m[k]` read of a UNION-valued map (mv kind 2): `V | null`
          // binds the established `A | B | null` local rep — the shared box itself
          // (kind `"union"`), with `null` riding as the null-tagged atom. The init's
          // miss arm synthesizes that box (`emitLetDeclStmt`'s map-read arm); the
          // narrow machinery lowers unchanged. Beside the kind-6 arm for the same
          // ladder-order reason (an init fallback below must not claim the binding).
          slot = addLocalName(s.letName, "union", -1)
        } else if letIsMap(stmts[i], fnIx) {
          // The kind-6 parallel slot carries the map SHAPE: `-2` for a `Set()`
          // binding (its `.values()` walks the keys), an mv slot (>= 0) for a
          // ref-valued map, `-1` for the mono i32 map. AFTER the bare-map-read arm:
          // a `const t = m[k]` read of a nested-map value is `{[string]:V} | null`
          // (the nulmap kind), which this arm's init fallback would else claim as a
          // NON-null map local — the nullable vals element then stored into a
          // non-null cell (INVALID-WASM, the R1 survey's w2).
          slot = addLocalName(s.letName, "map", letMapShapeOf(stmts[i], fnIx))
        } else if letIsNulVariant(stmts[i], fnIx) {
          // Nullable union VARIANT (`Circle | null`, kind `nulvariant`) — the
          // `(ref null $uVarHeap[vi])` niche. BEFORE the `nulstruct` arm below for the
          // same reason that one precedes the struct case: the two are disjoint at the
          // producer, but the ORDER documents which table owns the name, and a variant
          // has no struct row for `nulRefStructIdxOfLet` to find (`collectS` skips it).
          slot = addLocalName(
            s.letName,
            "nulvariant",
            nulVariantIdxOfLet(stmts[i], fnIx),
          )
        } else if letIsNulRef(stmts[i], fnIx) {
          // Nullable struct (`S | null`, code 9): annotation-first, else the
          // initializer's nullable-returning call. BEFORE the struct case (a
          // nullable init must not collapse to the non-null kind 1).
          slot = addLocalName(
            s.letName,
            "nulstruct",
            nulRefStructIdxOfLet(stmts[i], fnIx),
          )
        } else if letIsNulListInfer(stmts[i], fnIx) {
          // Nullable i32 list (`i32[] | null`, kind 15): BEFORE the array case —
          // `letIsArray`'s init fallback would otherwise claim the binding as a
          // non-null kind 2, and a later `xs = null` write would be invalid.
          slot = addLocalName(s.letName, "nullist", -1)
        } else if letNulScalarListKind(stmts[i], fnIx) != null {
          // A DISTINCT-backing nullable scalar list local (`string[]|null`, `f64[]|null`,
          // `i64[]|null`, `f32[]|null`): its own `(ref null $wrapper)` slot — BEFORE the non-null
          // scalar-list arms (whose init fallback would else claim a bare list value non-null and a
          // later `xs = null` write would be invalid).
          const nulSLK = letNulScalarListKind(stmts[i], fnIx)
          if nulSLK != null { slot = addLocalName(s.letName, nulSLK, -1) }
          // The scalar-list checks gate on `!letIsUnion`: a `f64[] | string` (etc.) binding
          // whose INIT is a bare list literal would otherwise let `letIsF64Array`'s init
          // fallback claim it as an f64 list instead of the value-union box (kind 4). A plain
          // `f64[]` binding is not a union name, so the guard never blocks it.
        } else if (
          letIsStringArray(stmts[i], fnIx) &&
          !letIsUnion(stmts[i], fnIx) &&
          !letIsNulRefArray(stmts[i], fnIx)
        ) {
          // The `!letIsNulRefArray` gate: a NULLABLE union-element ref-array binding
          // (`(string | {w: i32})[] | null`) whose INIT is a bare string-list literal
          // (`["600"]`) would otherwise be claimed as a plain string list by the init
          // fallback — the union-box list value then stored into a string-list-wrapper
          // local (INVALID-WASM; fuzz-nightly seed 44422568 d4). The scalar-list
          // siblings below carry the same gate.
          slot = addLocalName(s.letName, "strlist", -1)
        } else if (
          letIsU8Array(stmts[i], fnIx) &&
          !letIsUnion(stmts[i], fnIx) &&
          !letIsNulRefArray(stmts[i], fnIx)
        ) {
          // PACKED byte-list local (`let b: u8[] = …`) — `(ref $bl8TypeIdx)`. Sits with
          // the scalar-list arms and carries their two gates for the same reasons.
          slot = addLocalName(s.letName, "u8list", -1)
        } else if (
          letIsF32Array(stmts[i], fnIx) &&
          !letIsUnion(stmts[i], fnIx) &&
          !letIsNulRefArray(stmts[i], fnIx)
        ) {
          // Scalar-f32-element list local (`let xs: f32[] = …`), kind 21 — `(ref $fl32TypeIdx)`.
          // BEFORE the f64 case: an `f32[]` annotation over a float-literal init would else be
          // claimed by `letIsF64Array`'s init fallback (a `[1.5]` is `exprF64Array`).
          slot = addLocalName(s.letName, "f32list", -1)
        } else if (
          letIsF64Array(stmts[i], fnIx) &&
          !letIsUnion(stmts[i], fnIx) &&
          !letIsNulRefArray(stmts[i], fnIx)
        ) {
          // Scalar-f64-element list local (`let xs: f64[] = …` / a float-literal array
          // init), kind 12 — its cell is `(ref $fl64TypeIdx)`. (Slice 4.)
          slot = addLocalName(s.letName, "f64list", -1)
        } else if (
          letIsI64Array(stmts[i], fnIx) &&
          !letIsUnion(stmts[i], fnIx) &&
          !letIsNulRefArray(stmts[i], fnIx)
        ) {
          // Scalar-i64-element list local (`let xs: i64[] = …`), kind 20 — `(ref $il64TypeIdx)`.
          slot = addLocalName(s.letName, "i64list", -1)
        } else if letIsNulRefArray(stmts[i], fnIx) {
          // A NULLABLE ref-array local (`i32[][] | null`, kind 18) — BEFORE the non-null ref-array case
          // (its init `v[i]` over a `(<ref-array>|null)[]` would otherwise be claimed as a non-null kind
          // 5). Stores the INNER ref-list slot in `localStructIdx`, like kind 5 (the analogue of kind 15).
          slot = addLocalName(
            s.letName,
            "nulreflist",
            nulRefArrayInnerSlotOfLet(stmts[i], fnIx),
          )
        } else if letIsRefArray(stmts[i], fnIx) && !letIsUnion(stmts[i], fnIx) {
          // The `!letIsUnion` gate mirrors the scalar-list branches above: a UNION-annotated local
          // whose INIT is a ref array (`const p: S[] | i64 = xs`) is a union-BOX local (kind 4), NOT
          // a reflist local — the init coerces into the box. Without the gate the ref-array INIT
          // wins the reflist valtype and the boxed init store is invalid wasm.
          slot = addLocalName(
            s.letName,
            "reflist",
            letRefListSlot(stmts[i], fnIx),
          )
        } else if (
          letIsNulClosure(stmts[i], fnIx) ||
          letInfersNulClosure(stmts[i], fnIx)
        ) {
          // A NULLABLE function-VALUE local (`let c: ((i32) => i32) | null`, kind 19), OR an
          // un-annotated `const f = m[k]` over a function-valued map (a bare map read is
          // nullable — `letInfersNulClosure`). Its cell is the NULLABLE closure fat-pointer
          // `(ref null $cloStructIdx)`, holding a function OR `null`. BEFORE `letIsUnion` (the
          // `fn | null` annotation reads as a union name) and the non-null closure (kind 14).
          slot = addLocalName(s.letName, "nulclosure", -1)
        } else if letIsVariant(stmts[i], fnIx) {
          // A CONCRETE union-variant local (`const c: Cat = …`), kind 8 — its cell is the
          // variant struct ref `(ref $(uVarHeap[vi]))`. BEFORE `letIsUnion`/`letIsStruct`:
          // a variant name is neither the union box nor a standalone struct.
          slot = addLocalName(
            s.letName,
            "variant",
            variantIndexOfLet(stmts[i], fnIx),
          )
        } else if letIsUnion(stmts[i], fnIx) {
          slot = addLocalName(s.letName, "union", -1)
        } else if letIsStruct(stmts[i], fnIx) {
          // `letIsStruct` also matches via the INIT object literal's field-name set — so an UN-INTERNABLE
          // inline-shape ANNOTATION (an unsupported field type, e.g. `{f: {g:i32}[] | null}` /
          // `{f: (i32|null)[][]}`) still lands here, but `structIndexOfLet` then resolves to a WRONG struct
          // (a same-field-named one) and emits its layout → invalid wasm. Reject cleanly when the
          // annotation shape itself could not be interned (the construct-side hole the read fuzzer masked).
          if letAnnIsUninternedShape(stmts[i]) {
            return emitFail(
              "emitProgram: binding's inline-shape type has an unsupported field",
            )
          }
          // THE LOCAL HALF OF D51, and it is the half `criClassify`'s return rung alone
          // cannot see. `const c = { r: n }` beside `type Shape = Circle | Sq` has NO struct
          // row for its field set (`collectS` skips a `type X = {…}` that is a union member —
          // D57's root), so `letIsVariant` declines (its init leg is `exprVariantIndex`, which
          // carries no object-literal field-set arm by design) and this arm mints the pair
          // `("struct", -1)` — `fbValtype`'s bounds guard, `emitProgram: ref valtype with no
          // interned shape`. Fixing only the RETURN moved the reject from the functype to the
          // LOCALS vector and changed nothing an outcome-class grader can see, which is D52's
          // half-fix lesson at the same row.
          //
          // GATED ON THE `-1`, so it can only fire on a pair that is a loud reject today: the
          // kind is unchanged wherever the struct table HAS the row, and `letObjLitVariantIdx`
          // re-states the "no struct claimant" precondition itself.
          const lsi = structIndexOfLet(stmts[i], fnIx)
          const lov = letObjLitVariantIdx(stmts[i])
          if lsi < 0 && lov >= 0 {
            slot = addLocalName(s.letName, "variant", lov)
          } else {
            slot = addLocalName(s.letName, "struct", lsi)
          }
        } else if letIsArray(stmts[i], fnIx) {
          slot = addLocalName(s.letName, "list", -1)
        } else if letIsNulString(stmts[i], fnIx) {
          // Nullable string (`string | null`, kind 16): BEFORE the string case so a
          // nullable annotation/init doesn't collapse to the non-null kind 3 (a later
          // `x = null` write would then be invalid).
          slot = addLocalName(s.letName, "nulstr", -1)
        } else if letIsString(stmts[i], fnIx) {
          slot = addLocalName(s.letName, "str", -1)
        } else if letIsI64(stmts[i], fnIx) {
          // Scalar i64 local (`let x: i64 = …`, kind 10, valtype 0x7e). Bypasses
          // `checkLocalI32` (which rejects a non-i32 annotation); the init literal
          // lowers as `i64.const` in `emitStmt`'s LetDecl path.
          slot = addLocalName(s.letName, "i64", -1)
        } else if letIsF32(stmts[i]) || letInfersF32(stmts[i], fnIx) {
          // Scalar f32 local (`let x: f32 = …`, kind 13, valtype 0x7d), OR an un-annotated
          // `let y = <f32 expr>` (`letInfersF32`: an f32 field/index/call/arith source — the
          // f32 dual of the init fallback `letIsF64`/`letIsI64` carry). An annotated float
          // literal lowers as `f32.const`; an inferred f32 init is already an f32 VALUE, so
          // the LetDecl emit's `else` arm pushes it as-is into this kind-13 slot. A BARE
          // un-annotated float literal stays f64 (`letIsF64` below). (Slice 5.)
          slot = addLocalName(s.letName, "f32", -1)
        } else if letIsF64(stmts[i], fnIx) {
          // Scalar f64 local (`let x: f64 = …` OR an un-annotated `.` literal init,
          // kind 11, valtype 0x7c). Bypasses `checkLocalI32`; the init literal lowers
          // as `f64.const` in `emitStmt`'s LetDecl path. (Slice 3.)
          slot = addLocalName(s.letName, "f64", -1)
        } else if letIsClosure(stmts[i], fnIx) {
          // A function-VALUE local (`const f = function(...)...` or `const g = namedFn`),
          // kind 14 — its cell is the closure fat-pointer struct `(ref $cloStructIdx)`.
          slot = addLocalName(s.letName, "closure", -1)
        } else if letNulBool(stmts[i], fnIx) {
          // `boolean | null` NICHE local (kind 17): the cell is a plain i32 holding 0/1,
          // with the spare value 2 encoding `null` (no box) — so `fbValtype` renders it
          // i32 (the default), same as a plain boolean. A DEDICATED kind so the annotation
          // / inferred-if init isn't rejected by `checkLocalI32` and the if-binding emit
          // routes it to the sentinel-2 rep (rep 2); a later `x = null` stays valid (the
          // write consults `exprNulBool`, an AST walk, not the slot kind).
          slot = addLocalName(s.letName, "nulbool", -1)
        } else {
          if checkLocalI32(stmts[i]) < 0 {
            scopePop()
            return -1
          }
          slot = addLocalName(s.letName, "i32", -1)
        }
        // Pin the DECLARATION to the slot, before the arm preludes below can allocate more.
        // In a MONOMORPHIZED instance the annotation on this node is the only CONCRETE type
        // its body carries (`localDeclIx`'s header), so a rep question about a read of this
        // local has nowhere else to go.
        markLocalDecl(slot, stmts[i])
        // An if-EXPRESSION initializer's arm PRELUDES declare locals of their own. They
        // are allocated AFTER this binding's own slot and BEFORE its name is bound,
        // because that is exactly the order `emitLetDeclStmt` walks (it takes
        // `emitLetCursor` for the binding, emits the init, then `scopeBind`s the name).
        if collectIfExprLocals(s.letInit, fnIx) < 0 {
          scopePop()
          return -1
        }
        scopeBind(s.letName, slot)
      } else if s is IfStmt {
        if collectLocalsIf(stmts[i], fnIx) < 0 {
          scopePop()
          return -1
        }
      } else if s is WhileStmt {
        // Wasm locals are function-scoped, so collect locals from the while body too.
        if collectLocals(s.whileBody, fnIx) < 0 {
          scopePop()
          return -1
        }
      } else if s is ForRange {
        // A range `for` introduces TWO i32 slots in pre-order: the loop variable and
        // a synthetic bound temp (the `to` expression is evaluated ONCE). The temp's
        // name carries a `#` so it can never collide with a user identifier.
        const fvSlot = addLocalName(s.frVar, "i32", -1)
        markLoopVarSlot(fvSlot)
        scopeBind(s.frVar, fvSlot)
        addLocalName(s.frVar + "#b", "i32", -1)
        if collectLocals(s.frBody, fnIx) < 0 {
          scopePop()
          return -1
        }
        // The loop variable's scope is the loop (see `scopeUnbind`).
        scopeUnbind()
      } else if s is ForIn {
        if declareForInLocals(s, fnIx) < 0 {
          scopePop()
          return -1
        }
        if collectLocals(s.fiBody, fnIx) < 0 {
          scopePop()
          return -1
        }
        // The loop variable's scope is the loop (see `scopeUnbind`).
        scopeUnbind()
      } else if s is RetStmt {
        // `return if c { … } else { … }` — the returned if-EXPRESSION's arm preludes are
        // the only locals a `return` can introduce, and `emitStmt`'s return path emits
        // them in this same order (nothing precedes the value).
        if collectIfExprLocals(s.retArg, fnIx) < 0 {
          scopePop()
          return -1
        }
      }
      // Post-guard complement narrowing (mirrors `emitStmts` / `blockHasStrOpScan`):
      // a guard `if` with no else whose then-branch always returns narrows the REST of
      // this block, so the bindings below it are classified under the SAME narrowing
      // the emit applies. The save above restores the depth at block exit.
      pushPostGuardNarrow(stmts[i], fnIx)
      i = i + 1
    }
    restoreNarrow(savedGuardTop)
    scopePop()
    return 0
  }
  emitFail("emitProgram: function has no block body")
}

// Collect the declared locals of the `IfStmt` at `ifIx`: its then-branch block, plus
// its else, which is either a `Block` (a plain `else { … }`) or another `IfStmt`
// (an `else if …`). The `else if` case recurses through THIS function, so an
// arbitrarily long `if / else if / else if / … / else` chain has EVERY arm walked —
// not just the first nested level. (Mirrors how `emitStmt` re-enters each arm via
// `emitStmts`/`emitStmt`, so the slots `collectLocals` allocates match the `let`s
// `emitStmt` stores into, at any nesting depth.) Returns 0, or -1 (via `emitFail`).
// Allocate the arm-PRELUDE locals of an if-EXPRESSION standing as a statement's whole
// VALUE expression — a binding initializer or a `return` operand. That is also where a
// `match` in value position lands (`const r = match u { A{a} => a … }` desugars to an
// if-chain whose arm blocks open with `const a = u.a`). Only this shape is walked: an
// if-expression nested DEEPER inside an expression is reached by the emitter in an order
// this pass does not replay, so it stays unwalked and `armPreludeBlocks` denies it.
function collectIfExprLocals(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  const bare = unwrapParen(exprIx)
  const n = P.nodes[bare]
  if n is IfStmt { return collectLocalsIf(bare, fnIx) }
  0
}

// Record that the arm block at `blockIx` had its prelude locals allocated here, so
// `emitIfArmOpen` may lower them (see `armPreludeBlocks`). Only a MULTI-statement arm
// carries a prelude; recording just those keeps the membership scan trivial. Idempotent —
// a node index is arena-unique, so a re-walk must not append a duplicate.
function markArmPrelude(blockIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    if b.blkStmts.length > 1 {
      let i = 0
      while i < armPreludeBlocks.length {
        if armPreludeBlocks[i] == blockIx { return 0 }
        i = i + 1
      }
      armPreludeBlocks.push(blockIx)
    }
  }
  0
}

export function collectLocalsIf(ifIx: i32, fnIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    markArmPrelude(s.ifThen)
    if s.ifElse >= 0 { markArmPrelude(s.ifElse) }
    // Narrow `n` to its variant across the THEN-branch (mirroring `emitStmt`), so a
    // `let x = n.arrField` over a narrowed union-variant ARRAY field is classified as
    // an array local here — `exprArray`/`memFieldTypeCode` resolve the variant field
    // type only while narrowing is active. Save/restore so the else-branch + nesting
    // are unaffected.
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const trc = collectLocals(s.ifThen, fnIx)
    if narrowed { restoreNarrow(savedTop) }
    if trc < 0 { return -1 }
    if s.ifElse >= 0 {
      // A union narrows to the COMPLEMENT set in the ELSE arm (mirroring `emitStmt`'s
      // else lowering and `ifChainHasStrOp`), so a binding of the narrowed variant's
      // field inside `else { … }` is classified under the narrowing the emit applies.
      // The then-arm has had this since the branch was first walked; the else arm had
      // the stack untouched, which is the second half of the same gap. Save/restore.
      const savedElseTop = narrowTop
      const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
      const els = P.nodes[s.ifElse]
      let erc = 0
      if els is Block {
        erc = collectLocals(s.ifElse, fnIx)
      } else if els is IfStmt {
        // `else if …` — walk the nested if (and its own else chain) recursively.
        erc = collectLocalsIf(s.ifElse, fnIx)
      }
      if narrowedElse { restoreNarrow(savedElseTop) }
      if erc < 0 { return -1 }
    }
    return 0
  }
  emitFail("emitProgram: collectLocalsIf: not an if statement")
}

// Validate the `LetDecl` at `letIx`: its initializer must exist and be an i32 value
// (this slice has i32 locals only). A missing init, or an init whose type annotation
// names a non-i32 type, fails loudly. Without a per-expr type checker the init's
// VALUE-type is approximated: a `let x: T = …` annotation must be `i32` if present;
// init expressions outside the i32 vocabulary (string/char/bool/float literals)
// fail loudly. Returns 0, or -1 (via `emitFail`).
function checkLocalI32(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letInit < 0 {
      // An UNINITIALIZED `let x: T` (A-definite-assign) is legal for a SCALAR
      // (i32/boolean) annotation: the checker guarantees write-before-read, and the
      // wasm local's implicit zero-init covers the declaration. A ref-typed or
      // un-annotated uninitialized local still fails (non-null refs have no default).
      if d.letType >= 0 {
        const ty = P.nodes[d.letType]
        if ty is TypeRef {
          // THE ARENA WHERE IT COVERS THE NODE. This is a DECLINE GATE — it decides whether an
          // uninitialized local is allowed to lean on wasm's implicit zero-init — so the
          // dangerous direction is under-answering, which rejects a valid program. The name
          // answers where the arena has no type for the node.
          //
          // MEASURED: 0 disagreements, INVERTED control firing on 4 files, 4 rows moved when the
          // gate is forced off. Thin, and the thinness is stated: this gate's whole population is
          // four corpus programs.
          const pz = nodeTyPrimName(d.letType)
          if nodeTyIxOf(d.letType) >= 0 {
            if pz == "i32" || pz == "boolean" { return 0 }
          } else if ty.tyName == "i32" || ty.tyName == "boolean" {
            return 0
          }
        }
      }
      return emitFail("emitProgram: local declaration needs an initializer")
    }
    if d.letType >= 0 {
      const ty = P.nodes[d.letType]
      if ty is TypeRef {
        // CANON'S BANKED TYPE, not canon's rendered name (B142). B129 declined this rung: the
        // structural reading disagreed on `const kMix: K | i32`, a litunion ALIAS mixed with its
        // own base, whose `TyUnion` members are not all `TyLit` — while canon softens the
        // SPELLING to `i32`, which is how it lowers. Four rungs reached that same verdict and
        // it looked like a rule: a slot-choosing rung wants the lowering, and only the name
        // carried it.
        //
        // It did not. `canonTyIxOf` is the arena type OF THE SOFTENED SPELLING, banked at the
        // rewrite — canon's answer without canon's string. Reading it where canon rewrote and
        // `nodeTyIx` where it did not takes the disagreement count to ZERO, `kMix` included.
        //
        // Measured: 13 corpus files reach this rung, both sources exercised (7 `nodeTy`,
        // 6 `canonTy`), 0 disagreements. Only the TRUE direction is represented — the false
        // branch is a reject and no corpus program is rejected here — so this rests on
        // agreement where asked, not on both answers being observed.
        //
        // `boolean` rides in an i32 (0/1), so a `boolean` local is the SAME i32 slot.
        let lcTy = nodeTyIxOf(d.letType)
        if canonRewroteNode(d.letType) { lcTy = canonTyIxOf(d.letType) }
        const lcBase = tyScalarBasePrim(lcTy)
        if lcBase != "i32" {
          if lcBase != "boolean" {
            if !nodeTyIsLitUnionAlias(d.letType) {
              return emitFail("emitProgram: only i32 locals are supported")
            }
          }
        }
      } else {
        return emitFail("emitProgram: local type is not a type name")
      }
    }
    return checkExprI32(d.letInit)
  }
  emitFail("emitProgram: not a local declaration")
}

// Reject init expressions that cannot yield an i32: a string literal, or a float
// `NumLit` whose lexeme has a `.`, fails loudly. `BoolLit` (true=1 / false=0) and
// `CharLit` (a code point) ARE i32 values — they ride in an i32 — so they pass. i32
// literals, identifiers, parens, unary/binary arithmetic and calls are all i32 in
// this slice, so they pass too (the per-node emitters re-check operand shapes).
// Returns 0, or -1.
function checkExprI32(exprIx: i32) {
  if exprIx < 0 {
    return emitFail("emitProgram: missing local initializer expression")
  }
  const e = P.nodes[exprIx]
  if e is StrLit {
    return emitFail("emitProgram: only i32 locals are supported")
  }
  if e is NumLit {
    // A float literal carries a "." in its lexeme — out of scope (i32 only).
    let i = 0
    while i < e.numText.length {
      if e.numText[i] == '.' {
        return emitFail("emitProgram: only i32 locals are supported")
      }
      i = i + 1
    }
    return 0
  }
  0
}

// Walk the block at `blockIx` (descending into `if` branches + `while` bodies, the scopes
// `collectLocals` walks) and collect every DISTINCT ref-list `.push` receiver slot into
// `fnRefPushSlots`. Parallel to the `blockPushPopBits` walk, but RECORDING the slot rather
// than just testing presence — so a function pushing onto `Tok[]` and `Diag[]` reserves a
// separately-typed scratch frame for each.
export function collectRefPushSlots(blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      if stmtIsPushKind(stmts[i], fnIx, "ref") {
        const s = P.nodes[stmts[i]]
        if s is Call {
          const callee = P.nodes[s.callFn]
          if callee is Member {
            recordRefPushSlot(refListSlotOfExpr(callee.memObj, fnIx))
          }
        }
      }
      const s = P.nodes[stmts[i]]
      if s is IfStmt { collectRefPushSlotsIf(stmts[i], fnIx) }
      else if s is WhileStmt { collectRefPushSlots(s.whileBody, fnIx) }
      else if s is ForRange { collectRefPushSlots(s.frBody, fnIx) }
      else if s is ForIn { collectRefPushSlots(s.fiBody, fnIx) }
      i = i + 1
    }
  }
  0
}

// Collect ref-push receiver slots from every arm of the `if` / `else if` chain at `ifIx`
// — the then-branch, an `else` block, and (RECURSIVELY) each chained `else if`. Mirrors
// `ifChainPushPopBits`'s recursion so a push under 2+ `else if` arms is recorded.
function collectRefPushSlotsIf(ifIx: i32, fnIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    collectRefPushSlots(s.ifThen, fnIx)
    if s.ifElse >= 0 {
      const els = P.nodes[s.ifElse]
      if els is Block { collectRefPushSlots(s.ifElse, fnIx) }
      else if els is IfStmt { collectRefPushSlotsIf(s.ifElse, fnIx) }
    }
  }
  0
}

// Record the ref-list table slot of every Member-receiver ref-list `.pop` in expression
// `exprIx` into `fnRefPushSlots` (so its typed scratch frame is reserved) — the pop-side
// analogue of `collectRefPushSlots`, descending VALUE positions (a `.pop` is a value).
export function collectMemberPopRefSlotsExpr(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  const e = P.nodes[exprIx]
  if e is Call {
    if callIsMemberPopKind(exprIx, fnIx, "ref") {
      const callee = P.nodes[e.callFn]
      if callee is Member {
        recordRefPushSlot(refListSlotOfExpr(callee.memObj, fnIx))
      }
    }
    const args = e.callArgs
    let i = 0
    while i < args.length {
      collectMemberPopRefSlotsExpr(args[i], fnIx)
      i = i + 1
    }
    return 0
  }
  if e is BinExpr {
    collectMemberPopRefSlotsExpr(e.binLeft, fnIx)
    collectMemberPopRefSlotsExpr(e.binRight, fnIx)
    return 0
  }
  if e is Member { return collectMemberPopRefSlotsExpr(e.memObj, fnIx) }
  if e is OptMember { return collectMemberPopRefSlotsExpr(e.omObj, fnIx) }
  if e is Index {
    collectMemberPopRefSlotsExpr(e.idxArr, fnIx)
    collectMemberPopRefSlotsExpr(e.idxIndex, fnIx)
    return 0
  }
  if e is Unary { return collectMemberPopRefSlotsExpr(e.unArg, fnIx) }
  if e is Paren { return collectMemberPopRefSlotsExpr(e.parInner, fnIx) }
  // The node set below is the one `exprHasCoalesceCall` (emit_query.vl) carries.
  // It was missing here, so a ref-list `.pop` in an `is` guard, an `as` operand,
  // an ARRAY-literal element, an OBJECT-literal field value or an if-EXPRESSION
  // arm recorded no slot — and since `fnUsesRefPush` is INERT in `fbBeginFunc`
  // (ref frames come from `fnRefPushSlots`, keyed by the receiver's ref-list
  // slot), teaching the scalar push/pop BITS does nothing for these. The frame
  // was simply never reserved: `vl check` rc 0, `vl build` rc 1 "unknown local N".
  if e is IsExpr { return collectMemberPopRefSlotsExpr(e.isObj, fnIx) }
  if e is AsExpr { return collectMemberPopRefSlotsExpr(e.asObj, fnIx) }
  if e is IfStmt { return collectMemberPopRefSlotsIf(exprIx, fnIx) }
  if e is ObjLit {
    const fs = e.objFields
    let fi = 0
    while fi < fs.length {
      const f = P.nodes[fs[fi]]
      if f is FieldInit { collectMemberPopRefSlotsExpr(f.fiValue, fnIx) }
      fi = fi + 1
    }
    return 0
  }
  if e is ArrayLit {
    const es = e.arrElems
    let ei = 0
    while ei < es.length {
      collectMemberPopRefSlotsExpr(es[ei], fnIx)
      ei = ei + 1
    }
    return 0
  }
  0
}

// Walk the block at `blockIx` (if/else + while) collecting Member-receiver ref-list
// `.pop` slots from statements + let-inits / returns / while-conds.
export function collectMemberPopRefSlots(blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      const s = P.nodes[stmts[i]]
      if s is LetDecl {
        collectMemberPopRefSlotsExpr(s.letInit, fnIx)
      } else if s is RetStmt {
        collectMemberPopRefSlotsExpr(s.retArg, fnIx)
      } else if s is IfStmt {
        collectMemberPopRefSlotsIf(stmts[i], fnIx)
      } else if s is WhileStmt {
        collectMemberPopRefSlotsExpr(s.whileCond, fnIx)
        collectMemberPopRefSlots(s.whileBody, fnIx)
      } else if s is ForIn {
        collectMemberPopRefSlotsExpr(s.fiIter, fnIx)
        collectMemberPopRefSlots(s.fiBody, fnIx)
      } else if s is ForRange {
        collectMemberPopRefSlotsExpr(s.frFrom, fnIx)
        collectMemberPopRefSlotsExpr(s.frTo, fnIx)
        collectMemberPopRefSlots(s.frBody, fnIx)
      } else {
        // Bare expression statement — a FALL-THROUGH, not the two shapes
        // (`BinExpr` / `Call`) this used to name. See `blockHasArrNew`.
        collectMemberPopRefSlotsExpr(stmts[i], fnIx)
      }
      i = i + 1
    }
  }
  0
}

// Collect Member-receiver ref-list `.pop` slots from every arm of the `if` chain —
// CONDITION included. The condition was skipped, so `if b.xs.pop() != null { … }`
// holding the function's only ref-list `.pop` recorded no slot and emitted against
// a local the vector never declared. `startScanIf` (emit_sections.vl) hand-scans a
// top-level `if`'s condition for the SCALAR bits but not for this recorder, so the
// module-scope twin of this cell is still open there.
function collectMemberPopRefSlotsIf(ifIx: i32, fnIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    collectMemberPopRefSlotsExpr(s.ifCond, fnIx)
    collectMemberPopRefSlots(s.ifThen, fnIx)
    if s.ifElse >= 0 {
      const els = P.nodes[s.ifElse]
      if els is Block { collectMemberPopRefSlots(s.ifElse, fnIx) }
      else if els is IfStmt { collectMemberPopRefSlotsIf(s.ifElse, fnIx) }
    }
  }
  0
}

// Reserve the LEQG frame for compare rep `(kind, slot)` AND for every level below it —
// the reservation twin of `emitListEqGCore`'s recursion, walked along the same one home
// (`eqgElemClass` / `eqgInnerKind` / `eqgInnerSlot`).
//
// A NESTED COMPARE HAS TWO LIVE LOOPS AT ONCE, which is why this recurses where the concat
// scan does not. `f64[][] == f64[][]` runs the outer ref-list loop and, inside it, the
// inner `f64[]` loop; both counters are live simultaneously, so the inner level needs a
// frame of its own. Reserving only the outer one is exactly the "a compare emitted against
// locals the function never declared" failure `eqCoreKindOfBin`'s header names.
//
// THE OLD THREE CORES RESERVE THROUGH THEIR OWN FLAGS, not through this. A level whose rep
// is the i32 list, the string list or an `i32[][]` ref list sets `fnUsesListEqI` /
// `fnUsesListEqS` / `fnListEqRSlots` and stops — `emitListEqAnyRep` routes it to that core,
// so a LEQG frame for it would be reserved and never written.
function leqgNoteRep(kind: i32, slot: i32, depth: i32) {
  if depth > 32 { return 0 }
  if kind == 0 {
    fnUsesListEqI = true
    return 0
  }
  if kind == 3 {
    fnUsesListEqS = true
    // The per-element string compares stage operands in the string-op frame.
    fnUsesStrOp = true
    return 0
  }
  if kind == 1 && slot >= 0 && slot < rlElemKindTbl.length {
    if rlElemKindTbl[slot] == 4 {
      // The `i32[][]` core, which recurses into the i32 one.
      fnUsesListEqI = true
      let ri = 0
      let rseen = false
      while ri < fnListEqRSlots.length {
        if fnListEqRSlots[ri] == slot { rseen = true }
        ri = ri + 1
      }
      if !rseen { fnListEqRSlots.push(slot) }
      return 0
    }
  }
  let seen = false
  let i = 0
  while i < fnListEqGKinds.length {
    if fnListEqGKinds[i] == kind && fnListEqGSlots[i] == slot { seen = true }
    i = i + 1
  }
  if !seen {
    fnListEqGKinds.push(kind)
    fnListEqGSlots.push(slot)
  }
  const cls = eqgElemClass(kind, slot)
  // A STRING leaf rides the shared `__str_eq__` helper, which stages nothing itself — but
  // an operand may still widen an atom into the string-op frame, the same reason
  // `leqNoteBin`'s `k == 5` arm sets it.
  if cls == 2 { fnUsesStrOp = true }
  if cls == 3 {
    return leqgNoteRep(eqgInnerKind(slot), eqgInnerSlot(slot), depth + 1)
  }
  0
}

// Note one BinExpr's list-op kind into the per-function frame flags. `listOpKindOfBin` decides
// `+` (concat has no `eqCoreKindOfBin` answer); a `==`/`!=` it does not claim falls to the ONE
// compare-core home, which is the same function `emitEqNonNullCore` reads — a core reserved here
// and a core emitted there are the same decision or the emitted core writes locals the function
// never declared.
function leqNoteBin(binIx: i32, fnIx: i32) {
  let k = listOpKindOfBin(binIx, fnIx)
  if k < 0 { k = eqCoreKindOfBin(binIx, fnIx) }
  if k == 0 { fnUsesListEqI = true }
  if k == 3 {
    fnUsesListEqS = true
    // The per-element string compares stage operands in the string-op frame.
    fnUsesStrOp = true
  }
  // The string-eq helper stages nothing itself, but a nullable-string compare the string-op
  // scan (`exprHasStrOp` → `exprIsStrEq`) does not claim still reaches this core through the
  // banked type, and its operands may widen an atom into the string-op frame.
  if k == 5 { fnUsesStrOp = true }
  if k == 4 {
    // The nested element compare recurses into the i32-list frame.
    fnUsesListEqI = true
    const e = P.nodes[binIx]
    if e is BinExpr {
      // Either operand may be the one whose rep resolves a slot — a MIXED pairing
      // (`i32[][] | null == i32[][]`) can have the nullable side unresolvable, and
      // `emitEqNonNullCore` falls back the same way, so both must.
      let slot = refListSlotOfExpr(e.binLeft, fnIx)
      if slot < 0 { slot = refListSlotOfExpr(e.binRight, fnIx) }
      if slot >= 0 {
        let seen = false
        let i = 0
        while i < fnListEqRSlots.length {
          if fnListEqRSlots[i] == slot { seen = true }
          i = i + 1
        }
        if !seen { fnListEqRSlots.push(slot) }
      }
    }
  }
  // A `==`/`!=` over a list rep with NO core of its own needs a 4-slot compare frame per
  // LEVEL. `eqgListKindOfBin` is the same home `emitBinExprNode`'s dispatch reads, so a
  // frame reserved here and a core emitted there are one decision.
  const gk = eqgListKindOfBin(binIx, fnIx)
  if gk >= 0 { leqgNoteRep(gk, eqgListSlotOfBin(binIx, fnIx), 0) }
  // A STRUCT equality whose FIELD is a list needs a compare frame too, and the lookups above
  // never note one: they read the BINARY'S OWN OPERANDS, which here are structs, so
  // `eqgListKindOfBin` answers -1. `emitListEqGCore` then refuses with "list compare frame
  // was not reserved for this rep" (D1017). Walk the row and note a frame per ref-list field.
  const eqRow = binEqStructRow(binIx, fnIx)
  if eqRow >= 0 {
    const fc = eqRowFieldCount(eqRow)
    let fj = 0
    while fj < fc {
      if eqRowFieldTypeAt(eqRow, fj) == 5 {
        const en = sFieldElemNameAt(eqRow, fj)
        if en != "" {
          const rs = rlSlotByNameKeyTy(en, -1)
          if rs >= 0 { leqgNoteRep(1, rs, 0) }
        }
      }
      // ...and a SCALAR-backed list field needs one for the same reason (D1020). Only
      // `i32[]` had a field-equality arm; `string[]`, `f64[]`, `i64[]`, `f32[]` and `u8[]`
      // fields all refused, while the same lists compare fine as VALUES. The cores exist —
      // what was missing was the frame here and the routing there.
      const eqSk = eqScalarListFieldKind(eqRowFieldTypeAt(eqRow, fj))
      if eqSk >= 0 { leqgNoteRep(eqSk, 0, 0) }
      fj = fj + 1
    }
  }
  // A `+` over a NON-i32 list rep needs its own 4-slot concat frame. The i32 list is
  // excluded because it rides LEQI's `out` slot, which `k == 0` above already reserved —
  // reserving a second frame for it would move every later frame's base and change the
  // bytes of every program that concatenates a list today.
  const ck = catListKindOfBin(binIx, fnIx)
  if ck > 0 {
    const cs = catListSlotOfBin(binIx, fnIx)
    let cseen = false
    let ci = 0
    while ci < fnListCatKinds.length {
      if fnListCatKinds[ci] == ck && fnListCatSlots[ci] == cs { cseen = true }
      ci = ci + 1
    }
    if !cseen {
      fnListCatKinds.push(ck)
      fnListCatSlots.push(cs)
    }
  }
  0
}

// Recursive expression walk noting every list `==`/`!=`/`+` site (and, riding the
// same walk, every function-identity equality site — `cloEqNoteBin`).
export function leqScanExpr(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  const e = P.nodes[exprIx]
  if e is BinExpr {
    leqNoteBin(exprIx, fnIx)
    cloEqNoteBin(exprIx, fnIx)
    leqScanExpr(e.binLeft, fnIx)
    return leqScanExpr(e.binRight, fnIx)
  }
  if e is Unary { return leqScanExpr(e.unArg, fnIx) }
  if e is Paren { return leqScanExpr(e.parInner, fnIx) }
  if e is Call {
    leqScanExpr(e.callFn, fnIx)
    const args = e.callArgs
    let i = 0
    while i < args.length {
      leqScanExpr(args[i], fnIx)
      i = i + 1
    }
    return 0
  }
  if e is Member { return leqScanExpr(e.memObj, fnIx) }
  if e is OptMember { return leqScanExpr(e.omObj, fnIx) }
  if e is Index {
    leqScanExpr(e.idxArr, fnIx)
    return leqScanExpr(e.idxIndex, fnIx)
  }
  if e is ArrayLit {
    const es = e.arrElems
    let i2 = 0
    while i2 < es.length {
      leqScanExpr(es[i2], fnIx)
      i2 = i2 + 1
    }
    return 0
  }
  if e is ObjLit {
    const fs = e.objFields
    let i3 = 0
    while i3 < fs.length {
      const f = P.nodes[fs[i3]]
      if f is FieldInit { leqScanExpr(f.fiValue, fnIx) }
      i3 = i3 + 1
    }
    return 0
  }
  if e is IsExpr { return leqScanExpr(e.isObj, fnIx) }
  if e is AsExpr { return leqScanExpr(e.asObj, fnIx) }
  // An if-EXPRESSION (`const b = if c { xs == ys } else { false }`) is an `IfStmt`
  // node sitting in a VALUE slot; `emitExpr` lowers its arms through the ordinary
  // path, so a list `==`/`!=`/`+` in an arm reaches the compare/concat lowering and
  // stages operands in `leqIScratchBase`/`leqSScratchBase`. Without this arm the
  // walk fell off the end of its dispatch, `fnUsesListEqI`/`fnUsesListEqS` stayed
  // false and neither frame was reserved — no floor, so silently INVALID WASM.
  // Hand it to the STATEMENT walker, which already covers condition + both arms.
  if e is IfStmt { return leqScanStmt(exprIx, fnIx) }
  0
}

// Statement-level walk (descends branch/loop bodies; a bare expression
// statement falls through to the expression walk).
export function leqScanStmt(stmtIx: i32, fnIx: i32) {
  if stmtIx < 0 { return 0 }
  const s = P.nodes[stmtIx]
  if s is LetDecl { return leqScanExpr(s.letInit, fnIx) }
  if s is RetStmt { return leqScanExpr(s.retArg, fnIx) }
  if s is IfStmt {
    leqScanExpr(s.ifCond, fnIx)
    leqScanBlock(s.ifThen, fnIx)
    return leqScanBlock(s.ifElse, fnIx)
  }
  if s is WhileStmt {
    leqScanExpr(s.whileCond, fnIx)
    return leqScanBlock(s.whileBody, fnIx)
  }
  if s is ForRange {
    leqScanExpr(s.frFrom, fnIx)
    leqScanExpr(s.frTo, fnIx)
    leqScanExpr(s.frStep, fnIx)
    return leqScanBlock(s.frBody, fnIx)
  }
  if s is ForIn {
    leqScanExpr(s.fiIter, fnIx)
    return leqScanBlock(s.fiBody, fnIx)
  }
  if s is Block { return leqScanBlock(stmtIx, fnIx) }
  leqScanExpr(stmtIx, fnIx)
}

export function leqScanBlock(ix: i32, fnIx: i32) {
  if ix < 0 { return 0 }
  const b = P.nodes[ix]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      leqScanStmt(stmts[i], fnIx)
      i = i + 1
    }
    return 0
  }
  leqScanStmt(ix, fnIx)
}

// Walk the statement/expression tree at `ix`, recording every `.map`/`.filter` call
// over a LIST receiver into the scratch-frame requirement lists above (and setting
// `fnUsesMapFilter`). Mirrors `blockHasCallRef`'s node coverage; a nested `FuncDecl`
// (a lifted callback literal) is NOT descended — its own body's sites are detected
// when that lifted function is emitted.
export function mfScan(ix: i32, fnIx: i32) {
  if ix < 0 { return 0 }
  const n = P.nodes[ix]
  if n is Call {
    const callee = P.nodes[n.callFn]
    if callee is Member {
      if callee.memProp == "map" || callee.memProp == "filter" {
        if n.callArgs.length == 1 {
          const rk = mfRecvKindOf(callee.memObj, fnIx)
          if rk != null {
            fnUsesMapFilter = true
            let slot = -1
            if rk == "ref" { slot = refListSlotOfExpr(callee.memObj, fnIx) }
            mfRecordSrc(rk, slot)
            const resK = mfResultKindOf(ix, fnIx)
            if resK != null { mfRecordDst(resK, mfResultSlotOf(ix, fnIx)) }
          }
        }
      }
      // `xs.slice(start, end?)` builds a NEW list of the SAME element type — it reserves
      // the same src wrapper + dst backing scratch locals as a `.filter` (result kind/slot
      // == receiver). `emitArrSlice` reads the source backing/len through `srcL` and writes
      // the copied range into a fresh `dstL` backing.
      if callee.memProp == "slice" {
        if n.callArgs.length == 1 || n.callArgs.length == 2 {
          const rk = mfRecvKindOf(callee.memObj, fnIx)
          if rk != null {
            fnUsesMapFilter = true
            let slot = -1
            if rk == "ref" { slot = refListSlotOfExpr(callee.memObj, fnIx) }
            mfRecordSrc(rk, slot)
            mfRecordDst(rk, slot)
          }
        }
      }
      // `m.keys()` builds a fresh LIVE-key string list — reserve its 6-slot frame.
      if callee.memProp == "keys" {
        if exprMap(callee.memObj, fnIx) { fnUsesMapKeys = true }
      }
      // `m.values()` builds a fresh LIVE-value list. A MONO map uses the self-contained
      // `mapValsBase` frame; an mv-slot (ref/scalar-valued) map uses its per-slot output
      // backing (`mvValsOutBase`) + the key-list frame for live/i/j/count.
      if callee.memProp == "values" {
        if exprMap(callee.memObj, fnIx) {
          const vsh = mapShapeOfExpr(callee.memObj, fnIx)
          if vsh == -1 {
            fnUsesMapVals = true
          } else if vsh == -4 {
            // The i32-keyed MAP's values are the mono i32 list — the same
            // self-contained `mapValsBase` frame the string-keyed mono map uses.
            fnUsesMapVals = true
          } else if vsh == -5 {
            // An i32-keyed SET's `.values()` ARE its keys, so the BOUND form
            // (`const xs = s.values()`) is built by the key-list path and needs THAT
            // frame. A Set's shape is neither the mono `-1` nor an mv slot, so the two
            // arms around this one both miss it — which is why the STRING-keyed Set's
            // bound `.values()` is a loud reject ("`.keys()` but string list type not
            // collected") and this arm is the i32-keyed twin's improvement rather than
            // its mirror. The string half is deliberately NOT taught here: this scan
            // fires on every `.values()` Call node including a `for v in s.values()`
            // iterable, which needs no frame, so teaching it would grow two existing
            // corpus modules (`sets/basics.vl`, `sets/infer-from-add.vl`) for no
            // behavior change — measured, +2 BYTES rows, run output identical.
            fnUsesMapKeys = true
          } else if vsh >= 0 {
            fnUsesMapVals = true
            fnUsesMapKeys = true
          }
        }
      }
    }
    mfScan(n.callFn, fnIx)
    const args = n.callArgs
    let i = 0
    while i < args.length {
      mfScan(args[i], fnIx)
      i = i + 1
    }
    return 0
  }
  if n is Block {
    const stmts = n.blkStmts
    let i = 0
    while i < stmts.length {
      mfScan(stmts[i], fnIx)
      i = i + 1
    }
    return 0
  }
  if n is LetDecl {
    if n.letInit >= 0 { mfScan(n.letInit, fnIx) }
    return 0
  }
  if n is RetStmt {
    if n.retArg >= 0 { mfScan(n.retArg, fnIx) }
    return 0
  }
  if n is IfStmt {
    mfScan(n.ifCond, fnIx)
    mfScan(n.ifThen, fnIx)
    if n.ifElse >= 0 { mfScan(n.ifElse, fnIx) }
    return 0
  }
  if n is WhileStmt {
    mfScan(n.whileCond, fnIx)
    mfScan(n.whileBody, fnIx)
    return 0
  }
  if n is ForRange {
    mfScan(n.frFrom, fnIx)
    mfScan(n.frTo, fnIx)
    if n.frStep >= 0 { mfScan(n.frStep, fnIx) }
    mfScan(n.frBody, fnIx)
    return 0
  }
  if n is ForIn {
    mfScan(n.fiIter, fnIx)
    mfScan(n.fiBody, fnIx)
    return 0
  }
  if n is BinExpr {
    mfScan(n.binLeft, fnIx)
    mfScan(n.binRight, fnIx)
    return 0
  }
  if n is Unary { return mfScan(n.unArg, fnIx) }
  if n is Paren { return mfScan(n.parInner, fnIx) }
  if n is Member { return mfScan(n.memObj, fnIx) }
  if n is Index {
    mfScan(n.idxArr, fnIx)
    mfScan(n.idxIndex, fnIx)
    return 0
  }
  if n is ObjLit {
    const fields = n.objFields
    let i = 0
    while i < fields.length {
      const f = P.nodes[fields[i]]
      if f is FieldInit { mfScan(f.fiValue, fnIx) }
      i = i + 1
    }
    return 0
  }
  if n is ArrayLit {
    const elems = n.arrElems
    let i = 0
    while i < elems.length {
      mfScan(elems[i], fnIx)
      i = i + 1
    }
    return 0
  }
  0
}

// Reset the interning counter (call once per module, before assigning indices).
function mResetTypeIntern() {
  mNextType = 0
  0
}

// Allocate the next heap-type index (interning in emit order): return the current
// counter, then advance it by one. This is the single auditable place a type index
// is minted — every `mIntern*` below funnels through here.
function mAllocType() {
  const idx = mNextType
  mNextType = mNextType + 1
  idx
}

// The mv slot whose value type-name is `vn`, or -1 when none — a mono map value (i32 /
// boolean / literal-union atom) is never interned, so a map ELEMENT (`{[string]:V}[]`, a
// nested-map value) resolves its struct heap to `mStructIdxPre` (mono) or `mvMapTypeIdx`
// (typed) by this lookup. A non-failing sibling of `mvSlotOfValNameFind` (which fails on a
// mono value): the element-heap resolver below must tolerate the mono case.
function mvSlotByValNameOrK(vn: string, keyI32: boolean): i32 {
  const aOr = mvSlotOfValNameTyK(vn, keyI32)
  if aOr >= 0 { return aOr }
  mvSlotByValNameK(vn, keyI32)
}

// The mv slot a MAP-element ref-list slot's VALUE occupies — the element-heap
// resolver's twin of `rlElemMapValMvSlot` (destringify D5-final (c)). ARENA first
// (`rlElemTyIx` → peel one `TyNullable` → the `TyMap`'s value → `mvSlotOfTy`), the
// element-NAME surgery as the untouched fall-through. `canon` picks which name leg:
// the second heap pass canonicalises the value name before its lookup (a mixed
// litunion-alias value `K0 | i64` interns as `string | i64`), the sig / first heap
// pass does not. The arena leg needs no such flag — `repMvValKey` performs that fold
// itself (#1094).
// SENTINEL DISCIPLINE (D3'): `mvSlotByValNameOrK` misses with -1, which every caller
// reads as "the MONO map"; the arena leg therefore answers ONLY a real slot (>= 0)
// and its own miss is swallowed here, never returned.
function rlMapElemValSlot(slot: i32, canon: boolean): i32 {
  const ar = rlElemMapValMvSlotAt(slot, true)
  if ar >= 0 { return ar }
  let en = rlElemName[slot]
  const enn = nulMapInnerName(en)
  if enn != "" { en = enn }
  let vn = mapValNameOf(en)
  if canon { vn = mvCanonValName(vn) }
  mvSlotByValNameOrK(vn, rlElemMapKeyI32(slot))
}

// The VARIANT struct heap index of ref-list slot `slot`'s element (`Cat[]` → the `Cat`
// variant's `uVarHeap`), or -1. `mAssignTypeIndices` asked this twice — once building the
// dedup SIGNATURE and once resolving the element HEAP — with the `| null` peel and the
// `variantIndexOf` lookup hand-copied at both. One home, so the two answers cannot drift
// apart (they are the same question by construction: the sig pass exists to predict the
// heap pass) and the DESTRINGIFY note below has one address instead of two.
//
// DESTRINGIFY — MEASURED UNVERIFIABLE (#1098, re-stated here): an arena reading (peel the
// recorded `TyNullable` off `rlElemTyIx`, gate on `tyIxIsVariantMember`, take the row by
// the peeled type's NOMINAL name) was built and swept. A reach marker enters this peel on
// 79 of the corpus files, but `variantIndexOf` answers on ZERO of them, and neither a
// hand-written `Cat[]` variant-element list nor a variant-returning `.map` collapse
// reaches it. A leg that cannot be sabotage-verified is not migrated (method note 6) — the
// peel stays until a reacher exists, and now it stays in ONE place.
function rlElemVariantHeap(slot: i32): i32 {
  const rsen = nonNulBaseOf(rlElemName[slot])
  const evi = variantIndexOf(rsen)
  if evi < 0 { return -1 }
  uVarHeap[evi]
}

// Walk the type-section emit order with the `mAllocType` counter, assigning each
// type's heap index into the module-global index state (`sHeapIdx`/`uVarHeap`/
// `uBoxIdx`/`aTypeIdx`/`lTypeIdx`/`rlBackIdx`/`rlWrapIdx`/`mkArrIdx`/`mkListIdx`/
// `mStructIdx`). Returns the functype base index (`typeOffset` — where the first
// functype lands). The order MUST match the type-section emission below EXACTLY:
// standalone structs → union variants → union box → raw i32 array → i32-list
// wrapper → ref-list (backing, wrapper) pairs → string-list (backing, wrapper) →
// map struct → functypes. An ABSENT type family mints nothing; its index globals
// still take the counter position they would have occupied (never emitted — the
// value only matters when the family is present).
export function mAssignTypeIndices(_n: i32) {
  mResetTypeIntern()

  // Standalone structs occupy the first indices (decl order), one heap type per
  // DISTINCT structure: structural twins (`type A={v:i32}` / `type B={v:i32}`) share
  // a slot's heap index rather than minting a fresh one, so a `B`-value and an
  // `A`-slot use the SAME `(ref $S)` (they are the same structural type). `sTwin[i] <
  // i` means slot `i` is a twin of an earlier slot — reuse its already-minted index;
  // the type-section emit (`emitTypeSection`) skips the same twins in lock-step, so
  // this counter and the emitted struct count stay in sync.
  buildStructTwins()
  // ASSIGNED IN `structEmitOrder`, NOT IN DECLARATION ORDER (D622). wasm requires a
  // declared SUPERTYPE to hold a LOWER type index than its subtype, and a supertype here
  // is a shorter field list — as likely to be declared second as first. The order function
  // holds a row back until every proper prefix of it has an index, and it degenerates to
  // declaration order for a module with no such pair, so nothing moves unless a pair
  // exists. `emitTypeSection` walks the SAME function, which is what keeps the counter and
  // the emitted struct list in lock-step.
  sHeapIdx = []
  let shi = 0
  while shi < sNames.length {
    sHeapIdx.push(-1)
    shi = shi + 1
  }
  const sOrd = structEmitOrder()
  let soi = 0
  while soi < sOrd.length {
    sHeapIdx[sOrd[soi]] = mAllocType()
    soi = soi + 1
  }
  // Twins take their representative's index, exactly as before; the representative is
  // always in `sOrd`, so it already has one.
  let stw = 0
  while stw < sNames.length {
    if sTwin[stw] < stw { sHeapIdx[stw] = sHeapIdx[sTwin[stw]] }
    stw = stw + 1
  }
  // Union variant structs (one heap type per DISTINCT variant layout) then the union
  // box. Variant slot dedup (roadmap repOf, slot layer — the struct table's `sTwin`
  // discipline): `uVarTwin[vi] < vi` means variant `vi` is a layout twin of an earlier
  // slot (`buildVariantTwins`: canonical variant key + per-field storage guard) —
  // reuse its heap index; the type-section emit skips the same twins in lock-step.
  // Covers BOTH the same variant name pushed by two unions (`Cat` in `Cat | Dog` and
  // `Cat | Bird`) and structural twins (`Cat`/`Kot`, a declared name vs its inline
  // `{…}` shape spelling), which each minted a duplicate — distinct — heap type before.
  uVarHeap = []
  uVarTwin = []
  if uDeclared {
    buildVariantTwins()
    let vi = 0
    while vi < uVariants.length {
      if uVarTwin[vi] < vi {
        uVarHeap.push(uVarHeap[uVarTwin[vi]])
      } else if uVarSTwinAt(vi) >= 0 {
        // The cross-table merge: this arm's layout IS a declared struct's, so it takes
        // that row's already-allocated heap index instead of minting a second one. The
        // type section skips it in lock-step (`emitTypeSection`'s variant loop).
        uVarHeap.push(sHeapIdx[uVarSTwinAt(vi)])
      } else {
        uVarHeap.push(mAllocType())
      }
      vi = vi + 1
    }
    uBoxIdx = mAllocType()
    // The per-rep VALUE BOXES (`{ i32 }` / `{ i64 }` / `{ f32 }` / `{ f64 }`),
    // in this fixed rep order — only the reps a registered value union uses.
    if vbI32Used { vbI32Idx = mAllocType() }
    if vbI64Used { vbI64Idx = mAllocType() }
    if vbF32Used { vbF32Idx = mAllocType() }
    if vbF64Used { vbF64Idx = mAllocType() }
  }
  // The raw i32 array (list/map backing), then `string`'s OWN backing array, then the string
  // HEADER struct `{backing, start, len}` (Stage 2b — see `sTypeIdx` in emit_state), then the
  // i32-list wrapper. ALL THREE string-side indices are minted from the ONE `aUsed` flag: it
  // is already forced by string use AND by list use, and every string lowering already guards
  // on it, so they are available exactly where they were when the two shared one. The type
  // section emits the triple in THIS order.
  if aUsed {
    aTypeIdx = mAllocType()
    sBackIdx = mAllocType()
    sTypeIdx = mAllocType()
  } else {
    aTypeIdx = mNextType
    sBackIdx = mNextType
    sTypeIdx = mNextType
  }
  if lUsed { lTypeIdx = mAllocType() } else { lTypeIdx = mNextType }
  // Ref-list slot dedup (roadmap Next#1, ref-list layer — the `sTwin` analogue). Two
  // ref-list slots emit BYTE-IDENTICAL (backing, wrapper) pairs iff they resolve to
  // the same element heap (`rlElemHeap`): the pair shape — `(array (mut (ref null
  // $elem)))` + `{backing, len, cap}` — is uniform across every element kind. After
  // struct dedup `A[]` and `B[]` already share an element heap (`sHeapIdx` collapsed),
  // so they SHOULD share one wrapper — else a `B[]` passed where an `A[]` is expected
  // mismatches the wrapper `(ref $S)`. `rlTwin[s]` is `s`'s representative slot, from
  // a signature that mirrors the `rlElemHeap` resolution below but is knowable UP
  // FRONT: heap-resolved kinds (struct / nullable-struct / variant / union-box /
  // i32-list element) key on the resolved heap; a nested-list kind whose element is a
  // post-loop SINGLETON (closure / string / f64 / f32 / i64 inner list) keys on its
  // KIND — every same-kind slot shares that one singleton; a struct-LIST element
  // (kind 9, `S[][]`) keys on its INNER slot's representative (equal reps ⟹ equal
  // inner wrapper ⟹ equal element heap); the map-array element (kind 3) and any
  // unresolved element stay UNIQUE (never merged — the map-struct index interlock).
  rlTwin = []
  const rlSig: string[] = []
  let rss = 0
  while rss < rlElemName.length {
    const rsk = rlElemKindTbl[rss]
    let sig = "u:" + i32ToStr(rss) // default: unique (no dedup)
    if rsk == 2 {
      sig = "h:" + i32ToStr(uBoxIdx)
    } else if rsk == 4 {
      sig = "h:" + i32ToStr(lTypeIdx)
    } else if rsk == 5 || rsk == 6 || rsk == 7 || rsk == 8 || rsk == 10 {
      sig = "k:" + i32ToStr(rsk)
    } else if rsk == 9 {
      const inner = rlElemInnerSlot(rss)
      if inner >= 0 { sig = "9:" + i32ToStr(rlTwin[inner]) }
    } else if rsk == 3 {
      // A MAP element. A MONO map element resolves the shared `mStructIdxPre` (every
      // such slot has the same element heap); a TYPED-value map element resolves its
      // value slot's `mvMapTypeIdx` (the second pass below) — which the mv mint further
      // down shares across `repMapValSlotsTwin` layout twins, so the twin decision is
      // knowable HERE from the CANONICAL value slot (`mvCanonRepOf`, timing-independent):
      // equal reps ⟹ equal map struct ⟹ equal element heap ⟹ byte-identical pairs.
      // A NULLABLE map element (`{[string]: {[string]: K0}} | null`) strips to its inner
      // map FIRST — exactly as both heap passes do. Un-stripped, `mapValNameOf` garbled
      // the `| null` spelling to a value-slot MISS, the sig collapsed to the mono "3:m",
      // and the nullable NESTED-map-element slot TWINNED onto a mono-map-element slot —
      // its backing then held inner-map refs where nested maps flow: INVALID-WASM (fuzz
      // sweep4 branching seed 353749292 + sweep5 declared seed 167105674 — the family's
      // 2nd independent draw).
      const mmv = rlMapElemValSlot(rss, false)
      if mmv < 0 {
        // MONO on BOTH key reps, and they are two DIFFERENT structs — so the mono sig
        // has to name the key or an `{[i32]: i32}` element would twin onto a
        // `{[string]: i32}` one and take its (string-ref keys) struct.
        sig = "3:m"
        if rlElemMapKeyI32(rss) { sig = "3:mi32" }
      } else {
        sig = "3:" + i32ToStr(mvCanonRepOf(mmv))
      }
    } else {
      // Struct / nullable-struct / variant element — the `else` heap resolution
      // below. `rlElemStructRow` peels the `| null` niche off the ARENA type it
      // resolves (the recorded element name is the fall-through), so an INLINE-SHAPE
      // element spelling (`{v:i32}`) keys the same post-twin heap its declared twin does.
      const esi = rlElemStructRow(rss)
      if esi >= 0 {
        sig = "h:" + i32ToStr(sHeapIdx[esi])
      } else {
        // The concrete-VARIANT fall-through — `rlElemVariantHeap`, which is also the
        // heap pass's, and which carries this leg's DESTRINGIFY note.
        const evh = rlElemVariantHeap(rss)
        if evh >= 0 { sig = "h:" + i32ToStr(evh) }
      }
    }
    rlSig.push(sig)
    let rep = rss
    let sj = 0
    while sj < rss {
      if rlSig[sj] == sig { rep = sj; sj = rss }
      sj = sj + 1
    }
    rlTwin.push(rep)
    rss = rss + 1
  }
  // Distinct pairs = slots that are their own representative (each mints 2 heap types).
  let rlDistinctPairs = 0
  let rdp = 0
  while rdp < rlElemName.length {
    if rlTwin[rdp] == rdp { rlDistinctPairs = rlDistinctPairs + 1 }
    rdp = rdp + 1
  }
  // The map struct index is needed BELOW to resolve a map-array ref-list element
  // (it references `(ref null $mStructIdx)`), yet the map struct lands AFTER the ref
  // pairs + string-list. It is computable up front from the counter: it follows the
  // DISTINCT ref-pair slots (two per emitted pair, post-dedup) plus the 2 string-list
  // slots.
  const mStructIdxPre = mNextType + rlDistinctPairs * 2 + 2
  // One (backing, wrapper) pair per DISTINCT ref-list element type, interleaved; a
  // twin (`rlTwin[rs] < rs`) reuses its representative's pair (no new heap type).
  let rs = 0
  while rs < rlElemName.length {
    if rlTwin[rs] < rs {
      rlBackIdx[rs] = rlBackIdx[rlTwin[rs]]
      rlWrapIdx[rs] = rlWrapIdx[rlTwin[rs]]
    } else {
      rlBackIdx[rs] = mAllocType()
      rlWrapIdx[rs] = mAllocType()
    }
    if rlElemKindTbl[rs] == 2 {
      rlElemHeap[rs] = uBoxIdx
    } else if rlElemKindTbl[rs] == 3 {
      // A map-struct element. The MONO map (i32 / boolean / atom value) is the shared
      // `mStructIdxPre`; a TYPED-value map element (`{[string]: f32}[]`, a nested
      // `{[string]: {[string]: f64}}`) has its OWN map struct (`mvMapTypeIdx`, minted
      // AFTER this loop) — deferred to the second pass below (heap 0 here). This is the
      // position-independent rep: a map element resolves the SAME struct a standalone
      // `{[string]: V}` binding does, whichever value type it carries.
      if rlMapElemValSlot(rs, false) < 0 {
        // The MONO map of the element's OWN key rep: the string-keyed struct, or its
        // i32-keyed twin one index later (`mStructI32Idx`, minted immediately after —
        // the same "computable up front from the counter" reasoning as `mStructIdxPre`).
        if rlElemMapKeyI32(rs) {
          rlElemHeap[rs] = mStructIdxPre + 1
        } else {
          rlElemHeap[rs] = mStructIdxPre
        }
      } else {
        rlElemHeap[rs] = 0
      }
    } else if rlElemKindTbl[rs] == 4 {
      // An `i32[][]` slot's element is the i32-list WRAPPER (interned just above,
      // so `lTypeIdx` is already assigned).
      rlElemHeap[rs] = lTypeIdx
    } else if (
      rlElemKindTbl[rs] == 6 ||
      rlElemKindTbl[rs] == 7 ||
      rlElemKindTbl[rs] == 8 ||
      rlElemKindTbl[rs] == 10
    ) {
      // string[][] / f64[][] / i64[][]: the element is the inner list's WRAPPER
      // (`mkListIdx` / `fl64TypeIdx` / `il64TypeIdx`) — but those wrappers are allocated AFTER
      // this loop, so a second pass (below) fills these heaps once they exist.
      rlElemHeap[rs] = 0
    } else if rlElemKindTbl[rs] == 9 {
      // A struct-LIST value (`S[]`): the element is the inner struct-list WRAPPER, the ref-list
      // wrapper of the inner `S` slot (interned at a LOWER index, so its `rlWrapIdx` is set).
      rlElemHeap[rs] = rlWrapIdx[rlElemInnerSlot(rs)]
    } else {
      // A NULLABLE-struct element (`(P | null)[]`, slot key "P | null"): the backing is a
      // `(ref null $P)` over the bare struct — `rlElemStructRow` peels the `| null`
      // (structurally) to resolve P's heap, and its name fall-through bridges an
      // inline-shape spelling to its declared twin.
      const esi = rlElemStructRow(rs)
      if esi >= 0 {
        rlElemHeap[rs] = sHeapIdx[esi]
      } else {
        // A concrete-VARIANT element (`Cat[]`): the element heap is the variant struct
        // `uVarHeap[vi]` (no standalone `sNames` entry — variants ride the union's structs).
        const evh = rlElemVariantHeap(rs)
        if evh >= 0 { rlElemHeap[rs] = evh } else { rlElemHeap[rs] = 0 }
      }
    }
    rs = rs + 1
  }
  // The legacy singletons alias slot 0 (or the next index when no ref list).
  if rlElemName.length >= 1 {
    raTypeIdx = rlBackIdx[0]
    rlTypeIdx = rlWrapIdx[0]
  } else {
    raTypeIdx = mNextType
    rlTypeIdx = mNextType
  }
  // The string-ref list (keys backing + keys wrapper), shared by the map's keys
  // list AND any `string[]` field (present when `slUsed || mUsed`).
  if slUsed || mUsed {
    mkArrIdx = mAllocType()
    mkListIdx = mAllocType()
  } else {
    mkArrIdx = mNextType
    mkListIdx = mNextType + 1
  }
  // The map struct (present only when `mUsed`); `mStructIdxPre` is this counter
  // position, precomputed above for the ref-pair loop.
  if mUsed { mStructIdx = mAllocType() } else { mStructIdx = mStructIdxPre }
  // The i32-KEYED map struct, immediately after its string-keyed twin (present only
  // when `mI32Used`, so no index moves in a program without one). Identical 7 fields
  // with `keys` re-typed to the i32 list wrapper — both of whose heap types are
  // already assigned above, so it needs no forward reference.
  if mI32Used {
    mStructI32Idx = mAllocType()
  } else {
    mStructI32Idx = mStructIdx
  }
  // The f64 array + list-wrapper pair (Slice 4), interned LAST among the heap types so no
  // existing index shifts. The `(array (mut f64))` backing first, then its `{backing,len,
  // cap}` wrapper struct (which references the backing). Present only when `fa64Used`.
  if fa64Used {
    fa64TypeIdx = mAllocType()
    fl64TypeIdx = mAllocType()
  } else {
    fa64TypeIdx = mNextType
    fl64TypeIdx = mNextType + 1
  }
  // The i64-list pair, immediately after the f64 pair (same "interned late so no existing
  // index shifts" discipline): the `(array (mut i64))` backing then its `{backing,len,cap}`
  // wrapper. Present only when `ia64Used`; aliases its slots otherwise (zero types minted).
  if ia64Used {
    ia64TypeIdx = mAllocType()
    il64TypeIdx = mAllocType()
  } else {
    ia64TypeIdx = mNextType
    il64TypeIdx = mNextType + 1
  }
  // The f32-list pair, immediately after the i64 pair (same "interned late" discipline): the
  // `(array (mut f32))` backing then its `{backing,len,cap}` wrapper. Present only when
  // `fa32Used`; aliases its slots otherwise (zero types minted).
  if fa32Used {
    fa32TypeIdx = mAllocType()
    fl32TypeIdx = mAllocType()
  } else {
    fa32TypeIdx = mNextType
    fl32TypeIdx = mNextType + 1
  }
  // The `u8[]` pair, immediately after the f32 pair and under the same "interned late"
  // discipline: the PACKED `(array (mut i8))` backing then its `{backing,len,cap}`
  // wrapper. Present only when `ba8Used`; aliases its slots otherwise, so a program with
  // no `u8[]` mints nothing and every earlier heap-type index is untouched.
  if ba8Used {
    ba8TypeIdx = mAllocType()
    bl8TypeIdx = mAllocType()
  } else {
    ba8TypeIdx = mNextType
    bl8TypeIdx = mNextType + 1
  }
  // Second pass: fill the NON-i32 nested-list ref-list element heaps now that the inner
  // string/f64/i64 list wrappers exist (a `string[]`/`f64[]`/`i64[]`-VALUED map's vals
  // ref-list — kinds 6/7/8). The wrappers are forced by `mvShapeOfValName` (slUsed / fa64Used
  // / ia64Used), so the index is real here.
  let rsfix = 0
  while rsfix < rlElemName.length {
    if rlElemKindTbl[rsfix] == 6 { rlElemHeap[rsfix] = mkListIdx }
    else if rlElemKindTbl[rsfix] == 7 { rlElemHeap[rsfix] = fl64TypeIdx }
    else if rlElemKindTbl[rsfix] == 10 { rlElemHeap[rsfix] = fl32TypeIdx }
    else if rlElemKindTbl[rsfix] == 8 { rlElemHeap[rsfix] = il64TypeIdx }
    rsfix = rsfix + 1
  }
  // The function-value closure types (lambdas), interned LAST among the heap types so no
  // existing index shifts. The closure fat-pointer struct `{ code: (ref $fnsig), env:
  // structref }` first, then the env-leading functype `$fnsig` `(structref, i32...) ->
  // i32`. Both reference each other (mutually recursive in the one rec group). Then one
  // env struct per CAPTURING lifted function (capture order = field order), interned
  // after `$fnsig`. Present only when `fnValUsed`; zero types minted otherwise.
  fnEnvIdx = []
  if fnValUsed {
    cloStructIdx = mAllocType()
    // A CLOSURE-element ref-list slot (kind 5, `((i32) => i32)[]`) backs onto the closure
    // fat-pointer struct. `cloStructIdx` is interned HERE (after the ref-pair loop above),
    // so backfill those slots' element heap type now — the backing array `(array (mut (ref
    // null $cloStructIdx)))` forward-references it within the shared rec group.
    let rcs = 0
    while rcs < rlElemName.length {
      if rlElemKindTbl[rcs] == 5 { rlElemHeap[rcs] = cloStructIdx }
      rcs = rcs + 1
    }
    // One `$fnsig` functype per distinct value-call signature (`cloSigKeys`).
    cloSigBase = mNextType
    let sa = 0
    while sa < cloSigKeys.length {
      mAllocType()
      sa = sa + 1
    }
    // One env struct per capturing lifted function (in `fnStmts` order). A
    // non-capturing function gets `-1` (its closure env is `ref.null structref`).
    let fe = 0
    while fe < fnStmts.length {
      const ncap = captureCountOf(fe)
      if ncap > 0 { fnEnvIdx.push(mAllocType()) } else { fnEnvIdx.push(-1) }
      fe = fe + 1
    }
  } else {
    cloStructIdx = mNextType
    cloSigBase = mNextType + 1
  }
  // The ref-valued map structs (one 7-field map struct per DISTINCT value layout),
  // interned LAST among the heap types so no existing index shifts; zero types when
  // no ref-valued map exists. Map-value slot dedup (roadmap repOf, slot layer — the
  // `sTwin`/`rlTwin` analogue): the 7-field map struct's ONLY varying field is the
  // vals-list wrapper, so two slots whose VALUE types are layout twins
  // (`repMapValSlotsTwin`: canonical value key + per-kind layout guard, resolved via
  // `mvCanonRepOf`) emit byte-identical structs and MUST share one heap index — a
  // `{[string]: B}` passed where its twin `{[string]: A}` (or the inline
  // `{[string]: {v: i32}}` spelling) is expected was invalid wasm. The type-section
  // emit skips twins in lock-step. The vals-wrapper interlock check makes a
  // predicate/`rlSig` drift LOUD (a claimed twin whose vals lists resolved different
  // wrappers would alias two different layouts under one index — a compiler bug,
  // never emitted silently).
  mvTwin = []
  let mvi = 0
  while mvi < mvValName.length {
    const mvRep = mvCanonRepOf(mvi)
    mvTwin.push(mvRep)
    if mvRep < mvi {
      const k6 = mvValKind[mvi]
      if k6 == 1 || k6 == 2 || k6 == 6 || k6 == 14 {
        if rlWrapIdx[mvRlSlot[mvi]] != rlWrapIdx[mvRlSlot[mvRep]] {
          return emitFail(
            "emitProgram: map-value layout twins resolved different vals wrappers",
          )
        }
      }
      mvMapTypeIdx[mvi] = mvMapTypeIdx[mvRep]
    } else {
      mvMapTypeIdx[mvi] = mAllocType()
    }
    mvi = mvi + 1
  }
  // Second pass for the TYPED-value map ref-list elements (kind 3, deferred above): now
  // that `mvMapTypeIdx` is minted, point each such element's heap at its own typed map
  // struct. A mono / atom map element kept `mStructIdxPre` in the first pass (slot -1).
  let rmf = 0
  while rmf < rlElemName.length {
    if rlElemKindTbl[rmf] == 3 {
      // `canon` = the value-NAME leg canonicalizes (`mvCanonValName`) BEFORE its lookup:
      // the mv table is keyed CANONICALLY (a mixed litunion-alias value `K0 | i64` interns
      // as `string | i64`), so a raw element-map name (the closure-result / tyToEmitName
      // render PRESERVES the `K0` alias — #945) would miss the slot and leave the element
      // heap at the shared MONO map (i32-backed vals) while the map's own binding uses the
      // box-backed struct — INVALID-WASM (fuzz-sweep.0ZaYSm branching p2c). Mirrors
      // `mvShapeOfValName`/`mvSlotOfValNameFind`. The ARENA leg folds that itself.
      const mmv = rlMapElemValSlot(rmf, true)
      if mmv >= 0 { rlElemHeap[rmf] = mvMapTypeIdx[mmv] }
    }
    rmf = rmf + 1
  }
  // The functypes follow; the first lands at the current counter (`typeOffset`).
  mNextType
}

// A generic APPLICATION's type ARGUMENTS are invisible to every branch of `collectA`'s
// `TypeRef` ladder: the whole spelling `Box<string>` is ONE name, and every classifier in that
// chain asks about the name's OWN shape (is it an array, a map, a string, a ref list) — none of
// which a `Head<…>` matches. So a `Box<string>` carrying the module's only string reserved no
// `aUsed`, and `mAssignTypeIndices` then leaves `aTypeIdx = mNextType`: a type index that is
// never allocated but is usually still IN RANGE, so it silently names whatever heap type
// happens to sit there. Measured on `231e137c`: `function _len(b: Box<string>) { return
// b.v.length }` emits the struct's string field as `(ref 1)` — a FUNC type — and `array.len`
// over it is INVALID WASM at `vl check` rc 0. Adding any other string to the program rescues
// the row (its bystander twin), which is what makes this a RESERVATION miss rather than a
// lowering one.
//
// FLAG-ONLY AND OUTSIDE THE LADDER, both deliberately.
//   · OUTSIDE — so the SWALLOW CLAIM IS PROVABLY EMPTY. It is not an `else if`, so it bypasses
//     no arm and steals no name; a spelling a branch already claimed (`Box<string>[]` is a ref
//     array) composes with whatever that branch forced. Same placement, and same reason, as
//     the two closure-result forcers that end the ladder.
//   · FLAG-ONLY — every write is an OR into a `*Used` PRESENCE flag; never an intern, a
//     table row, or a reject. The worst it can do is allocate a heap type the program did not
//     need, so no cell can move backward past "a few bytes larger", and the arms that would
//     need an intern to be useful (a map's mv slot, a ref-list element) are left to the
//     branches that already reach them.
// The per-argument arms mirror the ladder's own FLAG writes for the same leaf spellings; the
// i32/boolean array arm is the one-cut leaf compare its sibling arm (the top-level function
// type's RETURN, `arrElemNameRaw(frRet) == "i32"`) already uses, widened by `boolean` because
// that spelling rides the identical `lUsed`/`aUsed` pair.
//
// FUTURE ROUTE: the two sibling forcers live in `emit_classify.vl` next to
// `forceScalarListField`. This one stays here because it is `collectA`'s own reservation
// concern and because that file is held by a concurrent slice; moving it is a pure relocation.
// Whether an annotation spelling that MENTIONS an i32-keyed map is one the emitter can
// lower: 0 when it is, else the loud reject (-1) naming the POSITION that failed.
//
// THE VALUE HALF OF THIS GATE IS GONE (#1286), and its absence is the whole point of the
// (KEY,VALUE) slot identity: an i32-keyed map's value interns its OWN map struct exactly
// as the string-keyed twin's does (`mvShapeOfMapName` reads the key off the spelling), so
// every value type the string-keyed rep lowers, this one lowers too.
//
// THE ARRAY-ELEMENT HALF IS GONE TOO, and it cost this gate ONE peel. #1286 kept it
// rejecting DELIBERATELY and said why: the `{[string]: V}` spelling of a list of maps was
// itself invalid wasm for 12 of 15 value types, so opening the i32 half would have turned
// a clean reject into that. The string half is fixed (`rlElemMapShape` seeds the element
// `Map()`), and the i32 half then arrived for free exactly as that filing predicted — a
// ref-list ELEMENT row records the WHOLE `{[i32]: V}` spelling (unlike a field row, which
// erases the key), and `rlElemMapKeyI32` / `rlElemMapShape` read the key straight off it.
// No table gained a column here; the ONE line below is the entire i32-keyed half.
//
// THE FIELD POSITION IS OPEN THROUGH THE SHAPE ARM BELOW, and its two halves land in two
// different places, which is worth stating because the two failure modes look alike. The
// gate's half is that arm: an inline shape delegates to its FIELD texts. The COLLECT half
// is a map field's key column (`sFieldElemKeyI32` / `uFieldElemKeyI32`) for a code-19 map
// field, and `ensureRefElem`'s `k == 3` arm — which forces `mI32Used` along with the three
// type flags — for a map that is a ref-list ELEMENT, including a LIST-TYPED field's
// (`{m: {[i32]: V}[]}`). Passing this gate is not the same as being collected: a spelling
// this function accepts whose flag nothing sets still emits a module with no i32-key
// scratch frame, which is `vl check` rc 0 and invalid wasm.
//
// THE MESSAGE'S POSITION LIST IS WIDER THAN THIS LADDER: it names "a map value", and there
// is no map-value peel, so an i32-keyed map nested as a NON-i32-keyed map's value
// (`{[string]: {[i32]: V}}`) is a loud reject. `{[i32]: {[i32]: V}}` passes on its OUTER
// key before the value is looked at, which is why the gap reads as arbitrary. Filed in
// ROADMAP B6a with the measured one-line peel and the reason it is not landed here.
function i32MapSpellingLowerable(name: string) {
  let bare = name
  // A top-level function TYPE (`() => {[i32]: V}`) delegates to its RETURN spelling: the
  // closure-result boundary carries the map's SHAPE (`cloRetValSlot`), which is the same
  // key-paired slot every other boundary carries, so the position is supported by the
  // same mechanism the return position is. The arrow is TOP-LEVEL, so `(() => {[i32]:
  // i32})[]` (an ARRAY of such closures) is NOT peeled here and stays a loud reject.
  const fr = annRetNameOf(name)
  if fr != "" { bare = fr }
  // An ARRAY of maps (`{[i32]: V}[]`, and the `({[i32]: V} | null)[]` niche whose one
  // layer of grouping parens `listElemNameOf` strips): peel to the ELEMENT and ask the
  // same question of it. ONE `[]`, so `{[i32]: V}[][]` — a list of lists of maps, whose
  // inner-list element row is a ref-list slot of its own — keeps the loud reject rather
  // than a guess; the same discipline the closure-array note above states.
  const ae = listElemNameOf(bare)
  if ae != "" { bare = ae }
  const inner = nulMapInnerName(bare)
  if inner != "" { bare = inner }
  if nameIsMapSpanEnds(bare) && nameIsI32KeyedMap(bare) { return 0 }
  // A SHAPE spelling (B6b) — an INLINE struct annotation (`{m: {[i32]: V}}`) or an
  // inline union ARM — delegates to its FIELDS. This is the one position whose map is
  // invisible to the scan that reaches this gate: the whole shape is ONE `TypeRef` name,
  // so the field's own `{[i32]: V}` never arrives here alone the way a DECLARED
  // `type S = {m: {[i32]: V}}`'s field annotation does. Each field text is asked THIS
  // question, so the set a field may hold is exactly the set any other position may hold
  // — a bare map, its `| null` twin, an ARRAY of maps, a closure RETURNING one, and a
  // nested shape by recursion — and nothing wider is guessed at.
  if nameIsShapeSpanEnds(bare) { return i32MapShapeFieldsLowerable(bare) }
  // A UNION spelling (`{f: {[i32]: V}} | i32`): every member that MENTIONS an i32-keyed
  // map must be a struct ARM, asked as the shape above. A member that IS the map
  // (`{[i32]: V} | i32` — the map as a union MEMBER, boxed) is deliberately NOT peeled:
  // the box carries no map shape, so it stays the loud reject it has always been.
  if unionMemberCount(bare) > 1 {
    const atoms: string[] = []
    splitUnionAtoms(bare, atoms)
    let ai = 0
    while ai < atoms.length {
      if strContains(atoms[ai], "{[i32]:") {
        if !nameIsShapeSpanEnds(atoms[ai]) {
          return i32MapSpellingUnsupported(name)
        }
        if i32MapShapeFieldsLowerable(atoms[ai]) < 0 { return -1 }
      }
      ai = ai + 1
    }
    return 0
  }
  i32MapSpellingUnsupported(name)
}

// The gate's REJECT, named once: three sites raise it (the leaf test above, the union
// arm's non-shape member, and — through the recursion — a shape's field), and the message
// must not drift between them.
//
// THE POSITION LIST IS MEASURED, not aspirational. Each named position is exercised by a
// corpus case and lowers today; a MAP VALUE is deliberately absent, because
// `{[string]: {[i32]: boolean}}` reaches THIS reject — a message that lists a position and
// then declines it teaches the reader the wrong thing about their own program. Adding a
// position here without a case that runs re-creates that.
function i32MapSpellingUnsupported(name: string): i32 {
  emitFail(
    "emitProgram: an i32-keyed Map/Set is supported as a binding / parameter / " +
      "return / `| null` / an ARRAY ELEMENT / a closure result — not inside '" +
      name +
      "'. A STRING-keyed map lowers in every position; otherwise bind the i32-keyed " +
      "map on its own and pass it where you need it.",
  )
}

// Ask `i32MapSpellingLowerable` of every FIELD of the shape spelling `nm` that mentions
// an i32-keyed map. The FIELD ROW's key column (B6b) is what makes this legal: a map
// field records only its VALUE, and the key column is the other half of the mv slot's
// identity, so `{m: {[i32]: V}}` now names its OWN map struct at the type section, at the
// construct, and at every receiver read. Fields that do not mention the key rep are not
// examined — this gate answers for the i32-keyed rep and nothing else.
function i32MapShapeFieldsLowerable(nm: string): i32 {
  const fnames: string[] = []
  const ftexts: string[] = []
  // The GROUP-INTERIOR cut at its home (`tyname.groupInnerOf`, W1); the guard is the
  // caller's `nameIsShapeSpanEnds`.
  shapeInnerFieldSplit(groupInnerOf(nm), fnames, ftexts)
  let i = 0
  while i < ftexts.length {
    if strContains(ftexts[i], "{[i32]:") {
      if i32MapSpellingLowerable(ftexts[i]) < 0 { return -1 }
    }
    i = i + 1
  }
  0
}

function forceGenAppArgTypes(name: string): i32 {
  if !annGenAppSpanEnds(name) { return 0 }
  const args: string[] = []
  const head = annGenAppDecompose(name, args)
  if head == "" { return 0 }
  let i = 0
  while i < args.length {
    const a = args[i]
    // A NESTED application (`Box<Pair<i32, string>>`) is the same reservation one rung in.
    forceGenAppArgTypes(a)
    if nameIsStringArray(a) {
      slUsed = true
      aUsed = true
    } else if nameIsF64Array(a) {
      fa64Used = true
    } else if nameIsI64Array(a) {
      ia64Used = true
    } else if nameIsF32Array(a) {
      fa32Used = true
    } else if nameIsBareMap(a) {
      mUsed = true
      lUsed = true
      aUsed = true
    } else if nameIsNulI32List(a) {
      lUsed = true
      aUsed = true
    } else if arrElemIs(a, "i32") || arrElemIs(a, "boolean") {
      lUsed = true
      aUsed = true
    } else if nameIsString(a) || nameIsNulString(a) {
      aUsed = true
    } else if nulScalarListKind(a) != null {
      const nsk = nulScalarListKind(a)
      if nsk == "nulstrlist" {
        slUsed = true
        aUsed = true
      }
      if nsk == "nulf64list" { fa64Used = true }
      if nsk == "nuli64list" { ia64Used = true }
      if nsk == "nulf32list" { fa32Used = true }
      // The packed-byte backing a `u8[] | null` cell's VALUE needs. Its three siblings
      // above mark their backings here; this one did not, so the literal path's
      // `!ba8Used` floor refused a program whose cell was already typed `nulu8list`.
      if nsk == "nulu8list" { ba8Used = true }
    }
    i = i + 1
  }
  0
}

// Scan the whole arena for every use of a collection heap type, setting the PRESENCE flags
// (`aUsed`/`lUsed`/`raUsed`/`rlUsed`/`mUsed`/`slUsed`/the wide-scalar `*Used` trio — see the
// type tables in `emit_state.vl`) and re-minting the ref-list / map-value / annotation-node
// rows keyed against them. A string's three heap types (`$sBackIdx` + the `$sTypeIdx` header,
// and the shared `$aTypeIdx` a list needs) are ALL minted from the single `aUsed` flag, so a
// string literal / `string` annotation forces `aUsed` just as an array literal does. A single
// linear pass over `P.nodes` is exhaustive (every node, reachable or not, is checked) and
// stable: it fixes whether the program needs the array heap type BEFORE the type
// section is emitted. An array annotation no earlier arm claimed is validated by
// `checkArrName`, so an unsupported element type fails loudly up-front. Returns 0, or -1 (via
// `emitFail`).
// Gather every FuncDecl TYPE-PARAMETER name (a cheap standalone scan — a `T[]`
// annotation node precedes its FuncDecl in the arena, so a walk that gathered as it went
// would see the annotation too early). Consulted by `genTyParamArr` / `genTyParamLeaf` to
// skip a generic original's annotations. Empty for any program without `<T>` declarations.
//
// ITS OWN PASS, ahead of `collectS`, because the SHAPE interner is a consumer too and
// `collectS` runs first. While this gather lived inside `collectA`, an inline shape over a
// type parameter (`function f<T>(v: { g: T[] })`) was interned against an EMPTY registry:
// `genTyParamLeaf` short-circuits to false on one, so the field's element resolved through
// the nominal name path — "" (an un-interned ref-list slot, read out of bounds at
// `pushFieldStorage`: a compiler CRASH) or, with a real `type T` in scope, that unrelated
// type (check-clean INVALID WASM). Ordering was the whole of the bug; the classifier arms
// were already written.
//
// `collectA` still calls it, so the `collectA#2` re-run re-gathers over the instances
// monomorphization minted. Idempotent — it rebuilds the list from the arena each time.
export function collectTyParamNames() {
  genTyParamNames = []
  let gtp = 0
  while gtp < P.nodes.length {
    const gnd = P.nodes[gtp]
    if gnd is FuncDecl {
      const gtps = gnd.fnTyParams
      let gj = 0
      while gj < gtps.length {
        genTyParamNames.push(gtps[gj])
        gj = gj + 1
      }
    }
    gtp = gtp + 1
  }
  0
}

export function collectA(_stmts: i32[]) {
  collectTyParamNames()
  aUsed = false
  lUsed = false
  raUsed = false
  rlUsed = false
  rElemKind = 0
  rlElemName = []
  rlElemKey = []
  rlElemTyIx = []
  // The per-annotation-node row sidecar names ROWS this pass is about to re-mint, so
  // it is cleared with them and refilled by the walk below.
  annRlSlot = []
  annRlNul = []
  rlElemHeap = []
  rlBackIdx = []
  rlWrapIdx = []
  rlTwin = []
  rlElemKindTbl = []
  rlElemNullable = []
  // The read-only-covariance write memo is keyed by slot number, which the lines
  // above have just invalidated (D791).
  rlWrSlots = []
  rlWrAns = []
  pendingNulRefHeap = -1
  mUsed = false
  mI32Used = false
  slUsed = false
  fa64Used = false
  mvValName = []
  mvKeyI32 = []
  mvValTyIx = []
  mvValKind = []
  mvValStructIdx = []
  mvValVariantIdx = []
  mvValArmSig = []
  mvRlSlot = []
  mvMapTypeIdx = []
  mvTwin = []
  // Re-mark the list-type flags the REGISTERED value unions force: `collectU` set them at
  // registration (`markValueUnionAtoms`) but the resets above cleared them, and a union
  // annotation (`f64[] | boolean`) is none of the bare-name forms the walk below recognizes
  // — a scalar-list type mentioned ONLY as a union member lost its backing/wrapper, so the
  // adopted-atom construction (`emitUnionCoerce`) failed "list type not collected".
  let umk = 0
  while umk < unMemberSet.length {
    markValueUnionAtoms(unMemberSet[umk])
    // A REF-ARRAY union arm (`S[] | {w:i32}`) lost its interned reflist slot to the resets
    // above (the reflist tables were just cleared) — re-intern it here, the ref-array twin of
    // the value-atom re-mark, so its wrapper/backing/element heaps are re-allocated. This is
    // the AUTHORITATIVE ref-array-arm interning: `collectU`'s registration-time call is wiped
    // by these same resets, so the box payload's wrapper heap comes from here.
    markRefArrayArms(unMemberSet[umk])
    // The AUTHORITATIVE map-arm re-intern (`{[string]: string} | f64`): the mv tables were just
    // cleared, so re-intern each map arm's value slot here — its per-value map struct heap comes
    // from this pass (before `mAssignTypeIndices`), the map twin of the ref-array re-mark above.
    markMapUnionArms(unMemberSet[umk])
    umk = umk + 1
  }
  let i = 0
  while i < P.nodes.length {
    const nd = P.nodes[i]
    if nd is ArrayLit {
      // A `[…]` literal is a growable list. A literal with struct/union-variant
      // elements is a REF list (its backing is `(ref null $elem)`); an i32-element
      // or EMPTY literal contributes the i32 list (an empty `[]` over a REF type is
      // typed by its binding's annotation, collected via the TypeRef branch — so the
      // i32 list types it also forces are harmless presence, never wrong bytes).
      // An EMPTY literal whose ELEMENT the checker pinned to a registered UNION
      // (`const xs = []` followed by `xs.push(u)`): `arrLitIsRef` cannot see it — it
      // has no element to classify, which is exactly the case its header excludes —
      // and the `(<elem>)[]` annotation `collectLocals` synthesizes for such a binding
      // runs AFTER this pass, so the slot that annotation resolves has to be interned
      // HERE. Without the row the binding falls to the i32-list default and the union
      // box pushed into it is `expected i32, found (ref $type)`. Kind 2 — the same
      // slot the annotated `(Cat | Dog)[]` spelling interns, so the two spellings of
      // one list share one row.
      if nd.arrElems.length == 0 {
        const emptyElem = arrLitUnionElemName(i)
        if emptyElem != "" {
          rlUsed = true
          raUsed = true
          // Hinted with the literal's own recorded element row; 8 of 8 corpus
          // firings agree with the name path, hint available at every one.
          rlInternNameTy(emptyElem, 2, rlHintElemTy(i))
        }
        // THE SAME HOLE AT THE NESTED-ARRAY ELEMENT KIND. `const outer = []` followed by
        // `outer.push(inner)` with `inner: i32[]` reaches this pass with the element pinned
        // to an ARRAY and no row interned for it: `arrLitIsRef` declines an empty literal,
        // and the nested arms of `arrLitElemKind`/`arrLitElemName` key off the first element's
        // NODE, which an empty literal has none of. The binding then fell to the i32-list
        // default and the array pushed into it emitted `expected i32, found (ref $type)` from
        // a module that CHECKS CLEAN — the union arm above, at the one element kind that
        // still had it.
        //
        // The flags mirror the `arrLitIsRef` branch below arm for arm, because the row this
        // interns is the same row the ANNOTATED `i32[][]` spelling interns and it must force
        // the same inner wrapper/backing pair. Both other routes to this shape already run at
        // master (the annotation and the nested literal `[[1, 2, 3]]`); only the inferred
        // empty one was missing.
        const nestElem = arrLitNestedElemName(i)
        if nestElem != "" {
          rlUsed = true
          raUsed = true
          const nestKind = arrLitNestedElemKind(i)
          // A REF INNER LIST (kind 9 — a struct / map / union / closure LEAF, or another
          // nesting level) has to intern its INNER row FIRST, because the outer element's
          // heap IS that inner wrapper and the tables are read forward in this same pass.
          // `ensureRefElemTy` is the one home of that inner-first walk — it is what the
          // ANNOTATED `S[][]` spelling has always gone through — so the inferred literal
          // reaches the row the annotation would have interned, rather than a second one.
          // D702: this is the half the old allow-list was standing in for.
          if nestKind == 9 {
            ensureRefElemTy(nestElem, rlHintElemTy(i))
          } else {
            // Same hint, same provenance; 10 of 10 corpus firings agree.
            rlInternNameTy(nestElem, nestKind, rlHintElemTy(i))
            if nestKind == 4 {
              lUsed = true
              aUsed = true
            }
            if nestKind == 6 {
              slUsed = true
              aUsed = true
            }
            if nestKind == 7 { fa64Used = true }
            if nestKind == 8 { ia64Used = true }
            // The two leaf kinds the old six-leaf allow-list could not admit and this arm
            // therefore never had a flag for: an f32 inner list (10) rides `$fl32TypeIdx`,
            // and a MAP inner element (3) the map struct + the i32 list/array its `index` /
            // `vals` fields ride. Same flags, same reason, as the `arrLitIsRef` arm below.
            if nestKind == 10 { fa32Used = true }
            if nestKind == 3 {
              mUsed = true
              lUsed = true
              aUsed = true
            }
          }
        }
      }
      if arrLitIsRef(i) {
        rlUsed = true
        raUsed = true
        rElemKind = arrLitElemKind(i)
        // A REF INNER LIST (kind 9) interns inner-first through `ensureRefElemTy`, exactly
        // as the empty-literal arm above and the ANNOTATED spelling do — the outer element's
        // heap IS the inner wrapper, and this pass reads the tables forward. D702.
        //
        // ADDITIVE BY CONSTRUCTION: before D702 nothing reaching this arm could BE kind 9.
        // The first-element rung answers 4/6/7/8 for a nested `ArrayLit` and the arena rung
        // was bounded by a six-leaf allow-list that excluded every ref leaf, so no literal
        // classified 9 here — which is precisely why `const c = [lv1]` over a `{r: i32}[]`
        // fell to the i32-list default and was told "nested arrays are not supported".
        // Every other kind keeps master's path character for character.
        if arrLitElemKind(i) == 9 {
          ensureRefElemTy(arrLitElemName(i), arrLitElemHintTy(i))
        } else {
          // Hinted with the arm-for-arm arena twin. -1 on every arm whose answer is a
          // NAME by design or by measurement, which is exactly today's unhinted call.
          rlInternNameTy(
            arrLitElemName(i),
            arrLitElemKind(i),
            arrLitElemHintTy(i),
          )
          // A nested `[[…]]` literal's elements are i32-list wrappers — force the
          // i32 list + raw array types for them. A string / f64 / i64 leaf (kinds
          // 6/7/8, the self-classified nested literal) forces ITS inner list's
          // wrapper+backing pair, exactly as the `T[][]` annotation branch does.
          if arrLitElemKind(i) == 4 {
            lUsed = true
            aUsed = true
          }
          if arrLitElemKind(i) == 6 {
            slUsed = true
            aUsed = true
          }
          if arrLitElemKind(i) == 7 { fa64Used = true }
          if arrLitElemKind(i) == 8 { ia64Used = true }
          // A MAP element (kind 3) forces the map struct + the i32 list/array its `index` /
          // `vals` fields ride — the three flags an ANNOTATED map element gets from
          // `ensureRefElem`'s `k == 3` arm, which a bare LITERAL never reaches (there is no
          // annotation to intern an element slot from). `mI32Used`, that arm's fourth, is
          // already flipped for this shape by the `Map()` CONSTRUCTOR arm off the
          // constructor's own recorded key type — a literal element IS a constructor call.
          if arrLitElemKind(i) == 3 {
            mUsed = true
            lUsed = true
            aUsed = true
          }
          // The f32 inner list (kind 10), the leaf the old allow-list could not admit — its
          // element is the `$fl32TypeIdx` wrapper, so force that pair exactly as 6/7/8 above
          // force theirs. Beside kind 3 for the same reason: both are now reachable here.
          if arrLitElemKind(i) == 10 { fa32Used = true }
        }
      } else if arrLitIsStr(i, -1) {
        // A STRING-element literal is a string-ref list — the same wrapper/backing
        // a `string[]` annotation forces.
        slUsed = true
        aUsed = true
      } else if arrLitIsF64(i, -1) {
        // An f64-element literal is an f64 list — its own `(array (mut f64))` backing +
        // wrapper. Does NOT force `aUsed`/`lUsed` (those are the i32 array/list). (Slice 4.)
        fa64Used = true
      } else if arrLitIsI64(i, -1) {
        // An i64-MAGNITUDE-element literal (`[6000000000]` — e.g. an anon `{f: [6000000000]}`
        // field value) is an i64 list — force its wrapper/backing, like the f64 branch.
        ia64Used = true
      } else if arrLitIsF32(i, -1) {
        // An f32-element literal (`[fv]` over f32-typed values) is an f32 list — the arm
        // this ladder was missing, and the one `emitArrLit`'s own floor asks for
        // ("f32 array literal but f32 list type not collected"). AFTER the f64/i64 arms,
        // so every literal either of them claims keeps its answer.
        fa32Used = true
      } else {
        lUsed = true
        aUsed = true
      }
    } else if nd is StrLit {
      aUsed = true
    } else if nd is Call {
      // A `fromCodePoint(code)` call (H2) constructs a length-1 VL string — the shared
      // `(array i32)` heap type — so it forces `aUsed` just like a string literal, even
      // in a program with no other string. The callee is a bare `Ident`.
      const cf = P.nodes[nd.callFn]
      // `m.keys()` builds a fresh STRING list of the map's keys — force the string-list
      // wrapper/backing (`mkListIdx`/`mkArrIdx`) + the shared `(array i32)`. `.keys()` is
      // only valid on a map (checker-enforced), so any such call contributes the type.
      if cf is Member {
        if cf.memProp == "keys" {
          slUsed = true
          aUsed = true
        }
      }
      if cf is Ident {
        if cf.identName == "fromCodePoint" { aUsed = true }
        // `fromCodePoints(xs)` builds a fresh string from an i32 list.
        if cf.identName == "fromCodePoints" {
          aUsed = true
          lUsed = true
        }
        // An un-annotated `Map()` (usage-inferred binding) still constructs the map
        // struct — force the same types a `{[string]: i32}` annotation does. `Set()`
        // is the same 7-field map struct, so it forces the IDENTICAL types.
        if cf.identName == "Map" || cf.identName == "Set" {
          mUsed = true
          lUsed = true
          aUsed = true
          // An UN-annotated `Map()`/`Set()` whose key the checker inferred as i32
          // (`const m = Map()` then `m.set(1, 2)`) has no map spelling anywhere in the
          // arena for the `TypeRef` walk below to read, so the KEY comes off the
          // constructor call's own recorded type.
          if nodeTyMapKeyIsI32(i) { mI32Used = true }
          // …and so does the VALUE. The `TypeRef` walk's `mvShapeOfMapName` is the only
          // other mv MINT, so without this an un-annotated map with a ref/wide value
          // (`const m = Map()` then `m.set("a", "x")`) resolved its TYPE and never minted
          // its REP, and every op site's FIND rejected it as unsupported. Idempotent — an
          // annotated twin already interned the same (KEY, VALUE) slot. A `Set()` is a
          // boolean-valued map, so it mints nothing (boolean is mono); it is included
          // because the node type is what decides that, not the constructor spelling.
          mvShapeOfMapNodeTy(i)
        }
        // The array-intrinsic allocators (std-design D1) construct a list even
        // with no literal/annotation in sight: an f64 FILL forces the f64
        // array+wrapper pair, anything else the i32 list (wrapper + backing).
        if (
          cf.identName == "__array_new__" ||
          cf.identName == "__array_new_default__"
        ) {
          const ank = arrNewIntrKind(i, -1)
          if ank == 1 {
            fa64Used = true
          } else if ank == 4 {
            ia64Used = true // D963 — the i64 list pair, interned like the f64 one
          } else if ank == 2 {
            // String fill → the string list (wrapper/backing shared with `string[]`).
            slUsed = true
            aUsed = true
          } else if ank == 3 {
            // Ref fill → the ref list of the element (intern its slot).
            rlUsed = true
            raUsed = true
            // D966 — THE ELEMENT KIND IS NOT ALWAYS 1. This interned every ref fill as kind 1,
            // the STRUCT element, which was right while the arm only ran for structs. Widened
            // to closures / nested lists / string lists / maps, a nested-list element then got
            // a row whose rep is the raw BACKING array where the annotated path carries the
            // list WRAPPER — one wrong heap type, and the only difference between the two
            // disassemblies (`(ref $0)` vs `(ref $3)` on the element scratch).
            //
            // `ensureRefElemTy` is the type-CARRYING intern: it derives the kind from the
            // element itself and its kind-9 arm hands a nested array's row down to the inner
            // element instead of re-resolving the spelling. Every caller that gets this right
            // passes a type; this one passed only a name.
            const anFillTy = arrNewFillTyIx(i)
            if anFillTy >= 0 {
              ensureRefElemTy(refListElemNameOfExpr(i, -1), anFillTy)
            } else {
              rlInternName(refListElemNameOfExpr(i, -1), 1)
            }
          } else {
            lUsed = true
            aUsed = true
          }
        }
      }
      // A `<recv>.push("…")` (string-LITERAL argument) appends to a STRING list:
      // the usage-driven inference for an un-annotated empty `[]` binding makes
      // its receiver a `string[]`, so force the string-list types. Idempotent
      // when an annotation already forced them (a string push onto a non-string
      // list is a checker error, so this never fires spuriously).
      if cf is Member {
        if cf.memProp == "push" {
          if nd.callArgs.length == 1 {
            const spArg = P.nodes[nd.callArgs[0]]
            if spArg is StrLit {
              slUsed = true
              aUsed = true
            }
          }
        }
      }
    } else if nd is TypeRef {
      // THE i32-KEYED MAP's CAPABILITY GATE, asked of EVERY annotation name before the
      // type-forcing chain below reads it. The i32-keyed rep is the MONO map (`-4`/`-5`
      // shapes): its `vals` is the i32 list, and it has no per-value-type map struct and
      // no ref-list/field/element plumbing minted for it. So exactly two spellings lower
      // — a BARE `{[i32]: i32}` / `{[i32]: boolean}` and its `| null` twin — and every
      // other position an i32-keyed map could occupy (an ARRAY element, a STRUCT or
      // VARIANT field, a UNION member, a MAP VALUE, a closure result) is a LOUD reject
      // here rather than a mono-shaped lowering against the string-keyed struct, which is
      // invalid wasm that `vl check` cannot see. The parser writes the spelling with no
      // spaces (`"{[" + key + "]:" + val + "}"`), so the containment test is exact.
      if strContains(nd.tyName, "{[i32]:") {
        if i32MapSpellingLowerable(nd.tyName) < 0 { return -1 }
      }
      // A TOP-LEVEL function-type annotation (`(i32) => R`): the function-type name
      // itself needs no array/list type, but its RETURN `R` may (an `i32[]`/`string[]`/
      // `f64[]` result list, or a `string`). Force the return's backing types so the
      // closure `$fnsig` result valtype resolves even when the only `i32[]` in the
      // module rides this annotation. The arrow is TOP-LEVEL, so `((i32) => i32)[]` (a
      // NESTED arrow — an array OF functions) is NOT caught here; it falls through to
      // the array branches below. Checked FIRST so the trailing `[]` of a list-returning
      // function type (`(i32) => i32[]`) is never mis-read as an array name.
      // `annRetNameOf` is the arrow-scan + return-slice pair, and its "" IS the gate: a
      // name with a top-level arrow always has a return spelling after it.
      const frRet = annRetNameOf(nd.tyName)
      if frRet != "" {
        // The i32 arm's three siblings below are already NAMED classifiers; this one matched
        // the whole spelling `"i32[]"` instead — an ASYMMETRY inside one chain, and the kind
        // of drift a whole-spelling compare exists to cause. It takes the array grammar's ONE
        // CUT and compares the leaf. Deliberately NOT `nameIsI32Array`, which is REP-wide
        // (`boolean[]`, litunion `K[]`, `(boolean|null)[]`, `(K|null)[]` all ride the i32-list
        // backing): those already force their own types further down this same `TypeRef` arm,
        // so routing here would only widen what a top-level function-type RETURN forces.
        if arrElemIs(frRet, "i32") {
          lUsed = true
          aUsed = true
        } else if nameIsStringArray(frRet) {
          slUsed = true
          aUsed = true
        } else if nameIsF64Array(frRet) {
          fa64Used = true
        } else if nameIsString(frRet) {
          aUsed = true
        }
      } else if nameIsBareMap(nd.tyName) {
        // D-BAREMAP MOVED EVERY OTHER ANNOTATION-NODE CONSUMER OF THIS PREDICATE ONTO THE
        // ARENA (`nodeTyIsMap`) AND MEASURED THIS ONE AS THE EXCEPTION — kept, with the
        // witness. Five sibling sites read 0 uncovered-live over 713,000 twin invocations;
        // THIS site reads 2, because it is the only one that walks EVERY `TypeRef` in the
        // arena rather than a POSITIONED annotation. The witness is
        // `tests/cases/maps/map-value-union-struct-map-field.vl`: its `{[string]:boolean}`
        // occurs nested inside a union member's struct field and inside an `is` pattern —
        // interior nodes the checker records no type for — and the arena leg would silently
        // drop the map types they force. 260,650 invocations, 0 DISAGREEMENTS on the covered
        // 260,618; the gap is coverage, not correctness, and it closes when interior
        // `TypeRef`s get a `nodeTyIx`, not by adding a fall-through rung here.
        // A `{[string]: i32}` annotation (G8) is a string-keyed map: the map struct
        // + the keys list (string-ref backing) + the i32 VALS list (the existing
        // `lTypeIdx`/`aTypeIdx`). So it forces `aUsed` (string backing + vals backing)
        // and `lUsed` (the vals wrapper) alongside the three dedicated map types.
        mUsed = true
        lUsed = true
        aUsed = true
        // An i32-KEYED map (`{[i32]: V}`) additionally forces its own map struct (the
        // `keys` field is the i32 list, not the string-ref list) and the i32-keyed
        // probe helper. This walk sees EVERY `TypeRef`, so every annotated i32-keyed
        // map — local, param, return, global, nested — contributes the flag here,
        // before `mAssignTypeIndices` mints the type.
        // THE ARENA WHERE IT COVERS THE NODE, THE NAME WHERE IT DOES NOT — and the coverage
        // test is the whole point, not a hedge. `nodeTyMapKeyIsI32Span` answers FALSE two
        // different ways: "this type is not an i32-keyed map", and "I have no type for this
        // node". The second is not an answer, and `mI32Used` is a type-MINTING flag where
        // under-answering leaves the map struct unminted and the module invalid.
        //
        // THE UNCOVERED NODES ARE REAL AND THIS ARM REACHES THEM. `parser.vl` mints a
        // `TypeRef` per inline-object field, then re-encodes a `{…} | …` RHS into a
        // `UnionDecl` from synth text WITHOUT re-parsing — leaving those field nodes
        // orphaned, with no pass recording a `nodeTyIx`. `collectA` walks every node in
        // `P.nodes`, so an orphan arrives here with its spelling intact and its arena entry
        // absent. The D-BAREMAP note twenty lines up already names this population.
        if nodeTyIxOf(i) >= 0 {
          if nodeTyMapKeyIsI32Span(i) { mI32Used = true }
        } else if nameIsI32KeyedMap(nd.tyName) {
          mI32Used = true
        }
        // A REF value type (`{[string]: string}` / `{[i32]: {x:i32}}`) interns a
        // per-(KEY,VALUE) map slot (its own map struct over a ref vals list). All mv
        // interning happens HERE (collect scans every TypeRef), so the type-index
        // assignment in `emitModule` sees the full slot set; later resolutions are
        // idempotent lookups. `mvShapeOfMapName` reads the KEY off the spelling, which is
        // why the whole i32-keyed ref-value surface needed no second walk.
        //
        // NOT ROUTED ONTO THIS NODE'S BANKED MAP TYPE **AT THE FIND RUNG**, though it has
        // one: the call MINTS, and an arena lookup that answers where the name bridge does
        // not skips the mint (D-MAPNODETY — the rule and its invalid-wasm witness are on
        // `mvShapeOfValNameArmTy`). What IS routed is the value type as the ARM-ONLY hint,
        // which is consulted after the mint decision and cannot move it: the render this
        // path hands over spells a declared union arm exactly as it spells an anonymous
        // shape, and this node is where the two are still distinguishable (D34).
        mvShapeOfMapNameArmTy(nd.tyName, nodeMapValTyIx(i))
      } else if nulMapInnerName(nd.tyName) != "" {
        // A `{[string]: V} | null` (kind `nulmap`) annotation collects the SAME map types as its
        // non-null inner map — even when the program never `Map()`-constructs one (a nulmap PARAM
        // whose only caller passes `null`): `mUsed` must be set so the `$mapStruct` heap type
        // exists for the `(ref null $mapStruct)` cell and the narrowed map ops. Interns the inner
        // value's mv slot too (a `string`/struct-valued nullable map).
        mUsed = true
        lUsed = true
        aUsed = true
        // THE ARENA WHERE IT COVERS THE NODE, THE NAME WHERE IT DOES NOT — and the coverage
        // test is the whole point, not a hedge. `nodeTyMapKeyIsI32Span` answers FALSE two
        // different ways: "this type is not an i32-keyed map", and "I have no type for this
        // node". The second is not an answer, and `mI32Used` is a type-MINTING flag where
        // under-answering leaves the map struct unminted and the module invalid.
        //
        // THE UNCOVERED NODES ARE REAL AND THIS ARM REACHES THEM. `parser.vl` mints a
        // `TypeRef` per inline-object field, then re-encodes a `{…} | …` RHS into a
        // `UnionDecl` from synth text WITHOUT re-parsing — leaving those field nodes
        // orphaned, with no pass recording a `nodeTyIx`. `collectA` walks every node in
        // `P.nodes`, so an orphan arrives here with its spelling intact and its arena entry
        // absent. The D-BAREMAP note twenty lines up already names this population.
        if nodeTyIxOf(i) >= 0 {
          if nodeTyMapKeyIsI32Span(i) { mI32Used = true }
        } else if nameIsI32KeyedMap(nd.tyName) {
          mI32Used = true
        }
        mvShapeOfMapName(nulMapInnerName(nd.tyName))
      } else if nameIsStringArray(nd.tyName) {
        // STAYS ON THE NAME, and the reason is the CHAIN, not the predicate.
        // `nodeTyArrayElemRepName(i) == "string"` is the arena form and is WIDER: it also
        // answers for a `(string | null)[]` element, whose list shares this exact backing. That
        // looked safe — `slUsed`/`aUsed` are monotone MINTING flags, so over-answering mints a
        // type that goes unused.
        //
        // IT IS NOT SAFE, because these rungs are an `else if` CHAIN. An over-answering rung
        // does not merely set its own flags; it SUPPRESSES every rung below it. Converting this
        // one moved `generics/type-param-shadows-alias-funcdecl.vl` from rc 0 to rc 1
        // (`emitProgram: only i32[] arrays and struct/union element arrays are supported`) —
        // a `(string | null)[]` that had been falling through to a later rung stopped here.
        //
        // Monotonicity of the FLAGS is not monotonicity of the CHAIN. Converting a rung to a
        // wider predicate is only safe where the rungs are independent.
        slUsed = true
        aUsed = true
      } else if nameIsRefArray(nd.tyName) || nameIsNulRefList(nd.tyName) {
        // A `S[]`/`N[]` annotation is a ref list (wrapper + `(ref null $elem)` backing) — and so is its
        // NULLABLE form `S[] | null` (kind 18): force the wrapper/backing on the NON-null ref-array name,
        // so a bare local whose value does not self-collect the element (e.g. `(i32|null)[] | null = [5]`)
        // still emits the element's ref-list type.
        let ran = nd.tyName
        const ranp = nullablePartOf(ran)
        // "Is this the NULLABLE ref-list spelling" — asked ONCE, and read again twenty
        // lines down to set the banked row's null flag. The second read is by construction
        // the same answer: `ranp` is never rewritten and no intern runs between them.
        const ranIsNul = ranp != "" && nameIsRefArray(ranp)
        if ranIsNul { ran = ranp }
        // The element KIND, classified ONCE for the seven reads in this arm — which
        // straddle the `ensureRefElem` intern, the only call between them that mutates a
        // table the classifier reads. Measured (D-RAKIND probe): over the whole corpus and
        // 25,200 fuzz programs the hoisted value and a re-derivation after the intern NEVER
        // disagree, and the comparator is sane (inverting the hoist reddens it on the first
        // reaching file). `ran` is final here — the `| null` peel two lines up is its last
        // write.
        const raKind = refArrElemKind(ran)
        // The element NAME, resolved ONCE for the same reason: the kind-2 reject and the
        // UNCONDITIONAL `recordAnnRlSlot` bank below both need it, so hoisting strictly
        // REMOVES work (one resolution instead of two on every kind-2 element).
        const ren = refArrElemName(ran)
        // A kind-2 (union-box) element that is a NICHE nullable (`(boolean | null)[]`,
        // `(string | null)[]` — one non-null member + null, deliberately NOT a value
        // union) has no list rep: the box lowering would emit the element's raw value
        // (invalid wasm). Reject cleanly. A value-union element (`(i32 | null)[]`,
        // `(f64 | null)[]`) and a struct/heterogeneous element union box as usual.
        if raKind == 2 {
          const renNul = nullablePartOf(ren)
          if !isValueUnionName(ren) && renNul != "" {
            return emitFail(
              "emitProgram: a nullable-" +
                renNul +
                " list element has no rep; use a non-null element type",
            )
          }
        }
        rlUsed = true
        raUsed = true
        rElemKind = raKind
        // Bank the interned ROW on the annotation NODE (`annRlSlot`): this arm runs on
        // exactly the spellings the annotation-node consumers call a ref array, so the
        // row recorded here is the answer each of them needs — read back through
        // `annRefArrSlot` without re-deriving it from the rendering.
        let ranNul = 0
        if ranIsNul { ranNul = 1 }
        // The ref-list slot is interned from the annotation's own recorded ELEMENT ROW
        // where that row is what the name denotes, and from the name alone where it is
        // not (`elemNameIsNominal`). -1 is exactly today's unhinted call, so every
        // declined class is unchanged by construction.
        //
        // Measured over the corpus: 3184 firings hinted, 0 disagreements, 1022 declined.
        let renTy = -1
        if !elemNameIsNominal(ren) { renTy = annRefArrElemRow(i) }
        recordAnnRlSlot(i, ensureRefElemTy(ren, renTy), ranNul)
        // An `i32[][]` annotation's ELEMENTS are i32-list wrappers — force the
        // i32 list + raw array so `lTypeIdx`/`aTypeIdx` exist for the elements.
        if raKind == 4 {
          lUsed = true
          aUsed = true
        }
        // A nested NON-i32 scalar / string 2D array (`string[][]`/`f64[][]`/`i64[][]`, element
        // kinds 6/7/8) forces its INNER list's backing+wrapper, as the LIST-valued map path
        // does — else the element wrapper heap (`mkListIdx`/`fl64`/`il64`) is never allocated.
        if raKind == 6 {
          slUsed = true
          aUsed = true
        }
        if raKind == 7 { fa64Used = true }
        if raKind == 10 { fa32Used = true }
        if raKind == 8 { ia64Used = true }
        // A MAP element (`{[K]: V}[]`, `({[K]: V} | null)[]`) forces the map machinery —
        // `mUsed`/`lUsed`/`aUsed`, the element map's mv VALUE slot and `mI32Used` for an
        // i32 KEY — inside `ensureRefElem` above, whose `k == 3` arm is THE ONE HOME of
        // that forcing and reaches every map element in every position, not just the ones
        // an annotation `TypeRef` spells. This arm carried a fourth hand-written copy of
        // it (the bare-map arm above and the two field-table re-derivations being the
        // others), and the copy was one arm short: it set the three type flags and not
        // the KEY, so a module whose only i32-keyed map sat in a ref-list element
        // compiled with no i32-key scratch frame and aliased the store's key temporary
        // onto the map-REF temporary — `type mismatch: expected (ref $type), found i32`
        // at `vl check` rc 0. Measured subsumed rather than assumed: deleting it moves no
        // cell of the 72-cell key×position×value×op grid and no corpus case.
      } else if (
        nodeTyArrayElemRepName(i) == "f64" ||
        nameIsF64Array(nd.tyName)
      ) {
        // An `f64[]` annotation forces the f64 array + wrapper pair (Slice 4) — its own
        // `(array (mut f64))` backing, independent of the i32 array/list.
        //
        // THE NAME IS A SECOND OPINION, AND IT HAS TO BE — an `||`, deliberately, NOT the
        // `nodeTyIxOf(i) >= 0` coverage guard the map rungs above take. The two need different
        // shapes because their accessors go quiet for different reasons, and taking the map
        // form here would leave four shapes broken.
        //
        // `nodeTyArrayElemRepName` only answers for a `TyPrim` element. A COVERED node whose
        // `TyArray` element is a numeric literal-union (`type K = 1.5 | 2.5` — `tyIsLitUnion`
        // demands `litKind == "str"`, so the numeric ones match nothing) or a `TyParam` falls
        // out of it with `""` while `nodeTyIxOf(i)` is perfectly non-negative. "The arena has
        // no type" is NOT the only way this accessor goes silent, so a coverage test cannot
        // reach the cases where it does.
        //
        // WHAT THE SILENCE COSTS HERE IS A MIS-ROUTE, not an under-mint, which is why it is
        // worse than the map rungs: the node falls past this rung and its i64 twin into
        // `nameIsArray(nd.tyName)` below, where `checkArrName("f64[]")` REJECTS — "only i32[]
        // arrays and struct/union element arrays are supported". A module-wide minting flag can
        // be set by any other declaration in the file; a chain mis-route is about the node
        // itself and nothing can mask it.
        //
        // FOUR FAMILIES, all rejecting on master today: the orphaned field `TypeRef`
        // (`type B = { g: f64[] } | f64`), a float literal-union array, an i64 literal-union
        // array, and a type parameter SHADOWING a scalar alias (`type T = f64` +
        // `function at<T>(xs: T[])`, where scope-blind `canonEmitTypeNames` rewrites `T[]` to
        // `f64[]` and misleads `genTyParamArr` below). Only the FIRST is an orphan; the other
        // three are covered nodes the accessor cannot describe.
        fa64Used = true
      } else if (
        nodeTyArrayElemRepName(i) == "i64" ||
        nameIsI64Array(nd.tyName)
      ) {
        // An `i64[]` annotation forces the i64 array + wrapper pair (`ia64`/`il64`). Same
        // second opinion, for the same reason, with the same mis-route without it.
        ia64Used = true
      } else if (
        nodeTyArrayElemRepName(i) == "f32" ||
        nameIsF32Array(nd.tyName)
      ) {
        // THE ARENA FIRST, matching the f64 and i64 rungs above — f32 was the odd one out,
        // carrying only the name test while its two siblings lead with
        // `nodeTyArrayElemRepName` and keep the name as the documented second opinion.
        // Measured: 1387 corpus files reach this rung, both answers strongly represented
        // (1375 false, 12 true), 0 disagreements — so the arena never WIDENS here, which is
        // what matters in a minting chain where an over-answering rung suppresses every rung
        // below it. The name stays for the four element families the arena cannot describe.

        // An `f32[]` annotation forces the f32 array + wrapper pair (`fa32`/`fl32`).
        fa32Used = true
      } else if (
        nodeTyArrayElemRepName(i) == "u8" ||
        nameIsU8Array(nd.tyName)
      ) {
        // A `u8[]` annotation forces the PACKED byte array + wrapper pair
        // (`ba8`/`bl8`). Arena first then the name, exactly as the three scalar rungs
        // above do and for the same reason: without a forcing rung here the annotation
        // falls into `checkArrName` below and is rejected as a non-i32 element array.
        ba8Used = true
      } else if genTyParamArr(nd.tyName) {
        // A `T[]` over a FuncDecl TYPE PARAMETER — a generic ORIGINAL's
        // annotation. Its monomorphized instances carry concrete pinned names
        // (collected when `monomorphize` re-runs this pass); the original is
        // replaced by its first instance and never emitted, so nothing is
        // forced or validated here.
        // NO SPELLING IN THE UNION QUESTION (B99): `isUnionOfTy` matches a DECLARED union by arena
        // index and an INLINE one structurally, which is the identity each of them actually has.
      } else if annSpelledArray(i, nd.tyName) && !isUnionOfTy(nodeTyIxOf(i)) {
        // The `!isUName` guard: a UNION whose LAST arm is an array (`S[] | T[]`, `i64 | S[]`)
        // has a name ENDING in `]`, so `nameIsArray` matches it — but it is a union BOX, not a
        // plain array. Its ref-array arms are interned by `markRefArrayArms` (the union path),
        // so skip the array validation/forcing here (which would reject the union name as a
        // non-i32 array). An array-FIRST union (`S[] | i64`) ends in a non-`]` char and already
        // fell through harmlessly; this extends the same treatment to the array-last spelling.
        if checkArrName(nd.tyName) < 0 { return -1 }
        // An `i32[]` annotation is a list (wrapper struct + raw-array backing).
        lUsed = true
        aUsed = true
      } else if nodeTyPrimName(i) == "string" {
        aUsed = true
        // THE ARENA. `nodeTyIsNulString` reads `T.tys` directly — verified live, not a
        // `<helper>(x) == <const>` twin whose helper never produces that constant.
      } else if nodeTyIsNulString(i) {
        // A `string | null` annotation (kind 16) is a `(ref null $aTypeIdx)` slot — it still needs the
        // string backing forced, exactly like a plain `string`. Without this a bare `string | null = null`
        // (no other string in the module to force `aUsed`) left `$aTypeIdx` unallocated, so the slot
        // valtype + `ref.null` referenced a stale type index → invalid wasm at the read.
        aUsed = true
      } else if nodeTyIsNulI32List(i) {
        // An `i32[] | null` annotation still constructs/reads the i32 list — the
        // nullable wrapper changes only the slot's valtype, not the types needed.
        lUsed = true
        aUsed = true
      } else if nulScalarListKindOfNode(i) != null {
        // A DISTINCT-backing nullable scalar list annotation (`string[]|null`, `f64[]|null`,
        // `i64[]|null`, `f32[]|null`) constructs/reads the LEAF list — force its wrapper+backing
        // even when the module has no other such list (a bare `= null` never builds one).
        // THE ARENA. `nulScalarListKindOfNode` leads with `annRepKindOf` and falls back to
        // this same name ladder only for an annotation the rep layer does not cover, so the
        // minting flags cannot under-answer. It is also strictly MORE correct: its header
        // records that `canonEmitName` softens a bare inline literal union to its base scalar,
        // so `("a" | "b")[] | null` arrives here rendered `string[] | null` and the name ladder
        // codes it `nulstrlist` — a `(ref null $strListWrapper)` — while every construct and
        // read path builds the interned-atom i32 list its `K[] | null` alias spelling gets.
        //
        // Measured: 1319 corpus files reach this rung with four distinct answers represented
        // (null, nulstrlist, nuli64list, nulf64list), 0 disagreements.
        const nsk = nulScalarListKindOfNode(i)
        if nsk == "nulstrlist" {
          slUsed = true
          aUsed = true
        }
        if nsk == "nulf64list" { fa64Used = true }
        if nsk == "nuli64list" { ia64Used = true }
        if nsk == "nulf32list" { fa32Used = true }
        if nsk == "nulu8list" { ba8Used = true }
      } else if nodeTyIsLitUnionAlias(i) || nodeTyIsNulLitUnion(i) {
        // A literal-union annotation (`: K`): an atom WIDENS to its member `string` (`print(k)` etc.), so
        // force the string backing even when the module has no other string literal.
        //
        // The NULLABLE niche (`: K | null`) widens the same way and needs the same forcing — and it
        // cannot lean on the alias arm, because the INLINE spelling `("a" | "b") | null` has no alias
        // DECLARATION whose own TypeRef would force it. A `const g: ("a" | "b") | null = null` (no
        // string literal anywhere in the module) reached the widening chain with `$aTypeIdx`
        // unallocated. Same reason the `string | null` arm above forces it.
        aUsed = true
      }
      // A MAP reached only as a CLOSURE RESULT inside this annotation — a union arm
      // (`(() => {[string]: f64}) | {w: i32}`), the nullable-closure niche, or a
      // curried result — is invisible to every branch above (the whole spelling is
      // ONE name). Force its machinery + intern its value slot; self-gating. Runs
      // OUTSIDE the chain: an arm-position closure result composes with whatever
      // branch claimed the name.
      forceCloResultMapTypes(nd.tyName)
      // The LIST dual: a scalar-leaf/string list reached only as a CLOSURE RESULT inside
      // this annotation (`((i32) => f32[]) | null`, `(() => i32[]) | null`) — force its
      // wrapper/backing so the narrowed arm's value-call index read finds them even when
      // the program never constructs such a list. Same self-gating placement as the map
      // forcer above.
      forceCloResultListTypes(nd.tyName)
      // The GENERIC-APPLICATION dual of the two forcers above: a type ARGUMENT
      // (`Box<string>`, `Pair<i32, string[]>`) that no branch of the chain can see, because
      // the whole `Head<…>` is one name. Same self-gating placement and the same flag-only
      // contract — see the helper's header for the measured cell and the empty-swallow proof.
      forceGenAppArgTypes(nd.tyName)
    }
    i = i + 1
  }
  // Union-VARIANT nested-struct fields (code 15, `{f: {f: f32}} | {w: i32}`): intern each
  // field's target shape into the struct table — the intern `collectShapeVariantFields`'s
  // acceptance deferred (`collectU` ran before the struct table existed). Idempotent (an
  // inline union annotation's arms already interned via `internShapeDeep`'s recursion — this
  // covers the declared-`UnionDecl` spelling too), a no-op for a DECLARED target name (the
  // text is not a `{…}` shape). Runs BEFORE the struct-field pass below so a freshly
  // interned shape's own map / ref-list / niche fields get their slots from that pass.
  let ufn = 0
  while ufn < uFieldTypes.length {
    // …with the row's own arena type (D-INLINESHAPETY): `uFieldElemTyIx` was recorded
    // by `recordUFieldElemRow` from THIS cell, so the D0 index the intern banks for the
    // freshly-minted struct row is the index it would have re-resolved the spelling to.
    if uFieldTypes[ufn] == 15 {
      const si15 = internInlineShapeTy(
        uFieldElemName[ufn],
        uFieldElemTyIxRow(ufn),
      )
      // RE-KEY THE ROW TO THE INTERNED ROW'S OWN NAME — the discipline
      // `internInlineShapeTy`'s own nested-field arm already applies to ITS field texts
      // ("Store the interned struct's own `sNames` entry so both agree"), applied to the
      // one recorder that discarded the index instead. The intern DEDUPS, and a dedup can
      // land on a row spelled differently from the text recorded here: `annShapeIndexOf`
      // treats one wasm CODE as one layout, so `{b: boolean}` resolves to an existing
      // `{b: i32}` row (field name equal, code 0 equal, no elem name to part on) and no
      // row named `{b: boolean}` is ever minted. The row's one code-15 consumer looks the
      // element up BY NAME (`structIndexByName`), so the stale spelling read -1 and the
      // field reported `nested-struct field element type is not interned` — for a shape
      // whose layout WAS interned, under its twin's name. Storage-correct by construction:
      // the two spellings dedup precisely because they store identically.
      if si15 >= 0 { uFieldElemName[ufn] = sNames[si15] }
    }
    // A REF-LIST variant field (code 5, `{a, f: S[] / {g: f64}[], z} | i32`): the
    // variant-table twin of the struct-field pass's code-5 intern below. The recorded
    // element key may be DEFERRED (`shapeFieldElemName` recorded the stripped element
    // text before the struct table existed): intern an inline-SHAPE element first (the
    // code-15 discipline), then intern the element's ref-list slot so
    // `variantFieldRefSlot` (`rlSlotByName`) resolves at the type-section emit and the
    // narrowed field-read op sites.
    if uFieldTypes[ufn] == 5 {
      const en5 = uFieldElemName[ufn]
      // The same row's arena type serves BOTH interns on this line and the next
      // (D-INLINESHAPETY / D-REPELEMTY) — one cell, one recorder, two consumers.
      if nameIsShapeOpen(en5) {
        internInlineShapeTy(en5, uFieldElemTyIxRow(ufn))
      }
      rlUsed = true
      raUsed = true
      // THE ROW'S ARENA TYPE, threaded into the intern (D-REPELEMTY). `uFieldElemTyIx`
      // was recorded by `recordUFieldElemRow` from THIS cell's own `uFieldElemName`, so
      // the slot key the intern computes from it is the key it computed from the
      // spelling — the same arena index, one `resolveAnnot` fewer.
      ensureRefElemTy(en5, uFieldElemTyIxRow(ufn))
    }
    ufn = ufn + 1
  }
  // ── FIELD-TABLE RE-DERIVATION (struct table, then the variant table below) ──
  // TWO RULES run through every arm of both loops, so neither is restated per arm:
  //  (1) a field's own type is NEVER a standalone TypeRef the arena scan above sees — the
  //      whole `{m:{[string]:V}}` shape / whole union spelling is ONE name — so an
  //      inline-shape or variant field's needs are re-derived from the field TABLE here,
  //      after the resets, where the interned slot persists;
  //  (2) the field may be the module's ONLY mention of its rep, so the flags are forced
  //      even when nothing else does: a `{f: null}`-only construct never builds a literal,
  //      and a closure-result shape `() => {f: {[string]: V}}` is reached only through a
  //      union arm yet still emits the map read path.
  // Every intern below is idempotent (`mvShapeOfValName` / `ensureRefElem` dedupe), so a
  // NOMINAL field already interned via its own TypeRef is a no-op.
  //
  // Inline-struct MAP FIELDS (`const s: { m: {[string]: V} }`): `collectAnnShapes` registered
  // them as code-19 fields with the value name in `sFieldElemName`; intern each one's mv slot.
  let sfi = 0
  while sfi < sFieldTypes.length {
    if sFieldTypes[sfi] == 19 || sFieldTypes[sfi] == 29 {
      // (Code 29, the NULLABLE map field, interns the same mv value slot as its non-null
      // twin — the two arms were byte-identical copies and are now one.)
      mUsed = true
      lUsed = true
      aUsed = true
      // THE FIELD ROW'S KEY, threaded into the intern (B6b). An mv slot's identity is the
      // (KEY, VALUE) pair, so a `{[i32]: string}` field must intern the i32-keyed slot —
      // interning the string-keyed one and then RESOLVING the i32-keyed one is the loud
      // "map value type has no interned slot", and interning against the wrong key is the
      // silent wrong map struct.
      const sfk = sFieldRowKeyI32(sfi)
      // …AND THE ROW'S ARENA TYPE, the third column of the same push (D-MVSLOTFIND).
      // `recordSFieldElemRow` computed it by calling `fieldElemTyIxOfName` on the very
      // `sFieldElemName[sfi]` handed over here, so the intern's lookup rung takes the
      // answer instead of re-deriving it — the same thread `ensureRefElemTy` two arms
      // below already takes, now reaching the mv intern. Measured identical on 441 of
      // 441 corpus entries at the raw arena INDEX, which is what a MINT rung requires.
      mvShapeOfValNameRowTy(sFieldElemName[sfi], sfk, sFieldElemTyIxRow(sfi))
      // …AND THE FLAG. An INLINE shape (`const s: {m: {[i32]: i32}}`) is ONE `TypeRef`
      // name, so the annotation scan's bare-map arm — the site that sets `mI32Used` for
      // every other position — never sees this map. `mI32Used` gates the i32-keyed map
      // STRUCT, the i32 probe helper and the per-function 5-slot i32-KEY scratch frame,
      // so without it the store's key temporary aliases the map-REF temporary at the same
      // local index: `vl check` rc 0, invalid wasm. The module-wide flag means ANY other
      // i32-keyed map in the file covers the miss (#1287's lesson (a)) — the witness has
      // to be a fixture with nothing else in it.
      if sfk { mI32Used = true }
    }
    // A REF-LIST field (code 5) and its nullable twin (28): intern the element so
    // `sFieldRefSlot` (`rlSlotByName`) resolves.
    if sFieldTypes[sfi] == 5 || sFieldTypes[sfi] == 28 {
      rlUsed = true
      raUsed = true
      // …with the row's arena type (D-REPELEMTY) — see the variant-table twin above.
      ensureRefElemTy(sFieldElemName[sfi], sFieldElemTyIxRow(sfi))
    }
    // A `string | null` FIELD (code 20) is a `(ref null $aTypeIdx)` slot — force the string
    // backing. Without this a `{ f: null }` (no other string in the module) left `$aTypeIdx`
    // unallocated and the field read referenced a stale type → invalid wasm.
    //
    // AND ITS NON-NULL TWIN, code 3 — the PLAIN `string` field, which this arm was taught
    // WITHOUT. Every other string-carrying field code in this loop forces `aUsed` (20 here,
    // 6/31 the string list, 4/18 the i32 list's shared backing, 19/29 the map's keys), and the
    // one that names a string DIRECTLY did not. It is the same defect the `string | null` note
    // above describes, one nullable-marker away: `function _len(b: { v: string }) { return
    // b.v.length }` with no other string in the module left `$aTypeIdx` unallocated, so
    // `aTypeIdx = mNextType` named whatever heap type sat at that index — measured on
    // `231e137c` as a FUNC type — and `array.len` over it is INVALID WASM at `vl check` rc 0.
    // The bystander twin (add any other string) passes on master, so this is a RESERVATION
    // miss. Flag-only, so its swallow is provably empty: it is a separate `if`, not an arm of
    // any chain, and the write is an OR into a presence flag.
    if sFieldTypes[sfi] == 3 || sFieldTypes[sfi] == 20 { aUsed = true }
    // An i32/boolean-LIST field (code 4, atom-array elem name or plain) and its NULLABLE twin
    // (code 18, `i32[] | null`): force the wrapper/backing so the field valtype and any
    // narrowed read resolve.
    if sFieldTypes[sfi] == 4 || sFieldTypes[sfi] == 18 {
      lUsed = true
      aUsed = true
    }
    // A STRING-list field (code 6) and its NULLABLE twin (31, `string[] | null`), which rides
    // the SAME `$mkListIdx` wrapper: force that wrapper/backing pair.
    if sFieldTypes[sfi] == 6 || sFieldTypes[sfi] == 31 {
      slUsed = true
      aUsed = true
    }
    // A SCALAR-LIST field (f64[]/i64[]/f32[], codes 25/26/27): `internInlineShape` forced the
    // pair at intern time, but this pass's re-run resets the flags — re-derive from the table.
    forceScalarListField(sFieldTypes[sfi])
    sfi = sfi + 1
  }
  // The variant-table twins of the same arms (a shape-text variant records its map value name
  // via `shapeFieldElemName`); a mono map value (i32 / boolean / atom) is a no-op
  // (`mvShapeOfValName` returns -1, no intern).
  let ufi = 0
  while ufi < uFieldTypes.length {
    if uFieldTypes[ufi] == 4 || uFieldTypes[ufi] == 18 {
      lUsed = true
      aUsed = true
    }
    if uFieldTypes[ufi] == 6 || uFieldTypes[ufi] == 31 {
      slUsed = true
      aUsed = true
    }
    // The variant-table twin of the struct pass's code-3 / code-20 string-backing arm: a
    // union VARIANT whose field is a plain `string` (or a `string | null`) is the module's
    // only mention of the string rep just as often as a struct field is.
    if uFieldTypes[ufi] == 3 || uFieldTypes[ufi] == 20 { aUsed = true }
    forceScalarListField(uFieldTypes[ufi])
    // A NULLABLE ref-list variant field (code 28): re-intern its element so the field's
    // storage type + narrowed reads resolve the wrapper slot (`rlSlotByName`).
    if uFieldTypes[ufi] == 28 {
      rlUsed = true
      raUsed = true
      // …with the row's arena type (D-REPELEMTY) — see the code-5 arm above.
      ensureRefElemTy(uFieldElemName[ufi], uFieldElemTyIxRow(ufi))
    }
    if uFieldTypes[ufi] == 19 || uFieldTypes[ufi] == 29 {
      // CODE 29, THE NULLABLE MAP FIELD, BELONGS HERE TOO — the struct pass has carried both
      // since its two arms were folded, and this table has been writing 29 rows it never read
      // back. That is exactly the state the note below forbids: a variant row this file writes
      // must be collectable from this file's own column. Until now the flags for a nullable map
      // field on a union arm arrived only by accident, from the orphaned field `TypeRef`
      // reaching the `nulMapInnerName` rung in the annotation walk — so when that rung stopped
      // answering, nothing was left.
      //
      // Rule (2)'s witness on this side: a `({f: {[string]: string}} | string)[]` param whose
      // caller only ever passes the string arm. Without the flags the narrowed field's map
      // ops rejected "map type not collected" even though the field names a map.
      mUsed = true
      lUsed = true
      aUsed = true
      // The struct pass's KEY + FLAG rule, one table over (B6b) — see its header there.
      //
      // BOTH WRITES HERE ARE JOINTLY, NOT SEVERALLY, NECESSARY, and that is measured
      // rather than argued: sabotage either one ALONE and no fixture fails; sabotage it
      // together with the STRUCT pass's twin and `i32-keyed-inline-arm-field-collect.vl`
      // fails (the intern with "map value type has no interned slot", the flag with
      // invalid wasm). The reason is one accident: an inline union ARM must SPELL its
      // shape to be narrowed (`if v is {f: {[i32]: V}}`), and that spelling interns a
      // STRUCT row for the same shape, whose pass does both jobs over again. Kept rather
      // than deleted because that covering row belongs to another pass, not to this
      // table's invariant — a variant row this file writes must be collectable from this
      // file's own column.
      const ufk = uFieldRowKeyI32(ufi)
      // The struct pass's ROW-TYPE thread, one table over (D-MVSLOTFIND) — 56 of 56.
      mvShapeOfValNameRowTy(uFieldElemName[ufi], ufk, uFieldElemTyIxRow(ufi))
      if ufk { mI32Used = true }
    }
    ufi = ufi + 1
  }
  0
}

export function collectAnnShapes() {
  let ti = 0
  while ti < P.nodes.length {
    const tn = P.nodes[ti]
    if tn is TypeRef {
      // ONE GATE AND ONE SWITCH, each closing a measured disagreement class between the
      // recorded type and what the NAME resolves to in the emitter's context:
      //   • the GATE — no generic-alias type PARAMETER in the spelling. Inside such an
      //     alias the checker bound `K` to the argument while the emitter re-resolves it
      //     to the module-level alias of that name. This is the only leg that can leave
      //     `root` at -1 here.
      //   • the SWITCH — `canonRewroteNode(ti)` picks WHICH column to read, not whether
      //     to read one. Canon is not a rename, so a name it rewrote may denote a
      //     different TYPE than `nodeTyIx` holds; `canonTyIxOf` is the type of the
      //     REWRITTEN spelling, banked at the rewrite. Before that column existed this
      //     was a second gate and declined instead, which is why the sibling site in
      //     `collectNestedFieldShapes` still does — it has no `canonTyIx` to switch to.
      //
      // THE FIRST GATE USED TO ASK `annTsOf(ti) >= 0` AND THAT WAS SOUND IN ONE DIRECTION
      // ONLY. `clearAnnTs` does drop the spelling tree on exactly the rewritten nodes, so
      // a SURVIVING tree is proof; but a MISSING tree is not proof of a rewrite — an
      // emitter-synthesized `TypeRef` never had one and its recorded type is good.
      // Measured here: of 2,518 nodes the tree test rejected, **1,258 were rewritten by
      // canon and 1,260 were not**. Asking the question directly (`canonCleared`, the
      // column canon now keeps) recovers that half.
      let root = -1
      if !nameMentionsGenAliasParam(tn.tyName) {
        if canonRewroteNode(ti) {
          root = canonTyIxOf(ti)
        } else {
          root = nodeTyIxOf(ti)
        }
      }
      internShapeDeepTy(tn.tyName, root)
    }
    ti = ti + 1
  }
  0
}

// ANONYMOUS shapes: an object literal naming NO declared struct and NO union variant
// still constructs a WasmGC struct (`const p = { y: 4, x: 3 }` with no `type` in
// sight — the host interns every shape). Intern each distinct field-name SET as an
// unnamed struct (name "", field order = literal order, field types from the literal
// values), APPENDED after every declared struct so declared indices are unchanged —
// a program with no anonymous literal emits byte-identical bytes. A later literal
// with the same name set matches the interned shape via `structIndexOfObj`. A field
// value `anonFieldCode` can't type leaves the whole shape un-interned; that literal
// then fails loudly downstream (never a trap). Must run AFTER `collectU` (variant
// shapes are the union's, not standalone structs).
function collectAnonShapes() {
  // THE OWNER MAP: for every object literal that is another literal's FIELD VALUE, the
  // owning literal's node index. Built in one linear pass, and only when the program
  // DECLARES a union variant — with no variants `objVariantName` is "" everywhere, no
  // literal is skipped, and there is nothing for the gate below to rescue.
  const nestOwner: i32[] = []
  if uVariants.length > 0 {
    while nestOwner.length < P.nodes.length { nestOwner.push(0 - 1) }
    let pi = 0
    while pi < P.nodes.length {
      const pn = P.nodes[pi]
      if pn is ObjLit {
        let pk = 0
        while pk < pn.objFields.length {
          const pf = P.nodes[pn.objFields[pk]]
          if pf is FieldInit {
            const pv = unwrapParen(pf.fiValue)
            if pv >= 0 && pv < nestOwner.length {
              const pvn = P.nodes[pv]
              if pvn is ObjLit { nestOwner[pv] = pi }
            }
          }
          pk = pk + 1
        }
      }
      pi = pi + 1
    }
  }
  // RUNG N (D391) — the POLYMORPHIC nested rows are minted FIRST, before any owner row
  // exists, so the owner scan below can tell the owners apart. See `anonNestPolyPremint`.
  anonNestPolyPremint(nestOwner)
  // D833 — WHICH LITERALS A `??` JOINS INTO ONE VALUE, and which ROW each such join was already
  // claimed by. Marked here: after the premint (whose owners are variant-claimed nested literals
  // this shape never reaches, so leaving the rung inert there keeps it byte-identical) and
  // before the mint loop, so the row column is a snapshot the loop's own appends cannot move.
  anonLeafJoinedMark()
  // D924 — AND THE FAMILY MEMBER'S *OTHER* DESTINATION. See `anonLeafNarrowUseMark`.
  anonLeafNarrowUseMark()
  // D940 — AND THE CLOSURE-TYPED SLOT A MOVED FUNCTION IS DELIVERED TO. Last, because it
  // reads the ret/param marks the two above write. See `anonLeafCloSlotMark`.
  anonLeafCloSlotMark()
  let ai = 0
  while ai < P.nodes.length {
    const an = P.nodes[ai]
    if an is ObjLit {
      // D833 — A ROW THAT CLAIMS THIS LITERAL BUT IS NARROWER THAN ITS `??` JOIN NEEDS is not a
      // reason to skip the mint, and where the merged row ALREADY EXISTS the map delivering the
      // literal has to be redirected onto it. `anonLeafMergeField` is the whole of both and
      // answers "" for every literal outside that shape, so the second disjunct is inert
      // everywhere else. The claiming row is read BEFORE the mint, because the mint appends a
      // row and the scan's answer moves with it.
      const narrowSi = structIndexOfObj(ai)
      const mf = anonLeafMergeField(ai, narrowSi)
      // D953 — AND A LITERAL WHOSE NESTED FIELD'S VALUE IS A FAMILY MEMBER. `anonLeafMergeField`
      // asks whether THIS literal's own row is narrower than the join IT belongs to; this asks
      // the same question one layer down, about a literal that belongs to no join itself and
      // merely CARRIES one. Without it the carrier keeps a row whose nested field names the
      // narrow inner, and the value it builds cannot be handed to a callee whose return row has
      // already moved — `d913_ret_binding_of_field`.
      const nmf = anonLeafNestedMergedField(ai)
      if (
        (narrowSi < 0 || mf != "" || nmf != "") &&
        (objVariantName(ai) == "" || anonNestNeedsRow(ai, nestOwner))
      ) {
        const rowsBefore = sNames.length
        anonMintRowFor(ai)
        if mf != "" || nmf != "" {
          anonLeafRecordSupersede(narrowSi, sNames.length - 1)
        }
        // D872/D873 — AND THE ROW THE `??`'s LEFT OPERAND'S OWN CARRIER NAMES. With ONE row per
        // field set that is `narrowSi` again and this records nothing new; with a second
        // same-fieldset row it is the OTHER one, and it is the row the binding's cell
        // (`nulRefStructIdxOfLet`) and the callee's return actually resolve. Asked only where
        // the mint really appended a MERGED row — `anonMintRowFor` can decline, and a row it
        // did not add is not this family's.
        if sNames.length > rowsBefore {
          if anonLeafMergedFieldOf(ai) != "" {
            anonLeafRecordSupersede(anonLeafCarrierRowOf(ai), sNames.length - 1)
          }
        }
      }
    }
    ai = ai + 1
  }
  0
}

// D924 — THE FAMILY MEMBER'S *OTHER* DESTINATION: an EIGHTH owner of the merged row.
//
// EVERY READER SINCE D804 MAKES A LITERAL A FAMILY MEMBER, AND A MEMBER IS BUILT AT THE MERGED
// ROW. Nothing until now asked where else that value goes. `const q = {r: 7}; src(q) ?? {r:"s"};
// keep(q)` hands the very same value to a SECOND callee whose parameter is annotated with the
// NARROW shape, so the argument arrives as `(ref $merged)` where the functype says
// `(ref $narrow)` — check-clean invalid wasm, and on master too (with a different sentence).
// That is `d911_arg_ident_narrow_use`, filed as D916, and its row called the answer "a
// per-DESTINATION coercion, which is a rung of its own". It is not a coercion: the parameter is
// a SLOT, and D891 already built the machinery for moving one (`anonLeafParamMoved` →
// `anonLeafParamRowOf`). This marks the slots that receive a member, and the seventh owner's
// own redirect does the rest.
//
// THE POSITION HAS TO BE *ALL* MEMBERS, WHICH IS WHAT KEEPS THE CONTROL RUNNING. A slot fed by
// a member at one call site and by an ordinary literal at another cannot be at both rows, and
// moving it would break the ordinary one — `d911_narrow_sibling_param` is exactly that program
// and it RUNS on master. So a position qualifies only when every call site delivers a member
// (or `null`, which is valid at every row) and at least one really does. Where it does not, the
// mark is not taken and the program compiles precisely as it does today.
//
// THE SAME FIVE REFUTATIONS D891's CALL-SITE READER MAKES, and for its reasons exactly: a
// generic callee (the annotation is cloned per instance), two functions of one name (no single
// slot), the name used as a value where the program can call one (`call_ref` passes arguments
// no name scan sees), and a call whose arguments do not bind to this arity.
//
// AND IT EARLY-OUTS ON "IS THERE A FAMILY AT ALL", which is not tidiness: every rung below is a
// whole-arena scan and they nest, so an ungated pass is quadratic in the node count for every
// program in the language. The compiler's own source has no live `?? { … }` — the mark array is
// all zeros — and the ungated first cut of this pass took the seed's self-compile from 50
// seconds to past ten minutes. One O(n) read of the marks buys that back, and every program
// that HAS a family is small enough for the scans that follow.
function anonLeafNarrowUseMark() {
  let famAny = false
  let mi = 0
  while mi < anonLeafJoined.length {
    if anonLeafJoined[mi] == 1 { famAny = true }
    mi = mi + 1
  }
  if !famAny { return 0 }
  // Hoisted out of the declaration loop: the answer is a property of the PROGRAM, and asking it
  // per function made the pass cubic.
  const indirect = anonLeafAnyIndirectCall()
  let fi = 0
  while fi < P.nodes.length {
    const fd = P.nodes[fi]
    if fd is FuncDecl {
      if fd.fnTyParams.length == 0 && fd.fnParams.length > 0 {
        if anonLeafOneDeclNamed(fd.fnName) {
          const pNames: string[] = []
          let pj = 0
          while pj < fd.fnParams.length {
            const pnj = P.nodes[fd.fnParams[pj]]
            if pnj is Param {
              pNames.push(pnj.parName)
            } else {
              pNames.push("")
            }
            pj = pj + 1
          }
          let anyValue = false
          let vi = 0
          while vi < P.nodes.length {
            const vn = P.nodes[vi]
            if vn is Ident {
              if vn.identName == fd.fnName {
                if !anonLeafIsCalleePos(vi) { anyValue = true }
              }
            }
            vi = vi + 1
          }
          let ok = true
          if anyValue {
            if indirect { ok = false }
          }
          if ok {
            let pk = 0
            while pk < fd.fnParams.length {
              // D935 — OR A SLOT THIS CAN MAKE all-members, by enrolling the plain literals
              // beside the family ones. See `anonLeafSlotEnrolMembers`.
              if (
                anonLeafSlotAllMembers(fd.fnName, pNames, pk) ||
                anonLeafSlotEnrolMembers(fd.fnName, pNames, pk)
              ) {
                while anonLeafParamMoved.length <= fd.fnParams[pk] {
                  anonLeafParamMoved.push(0)
                }
                anonLeafParamMoved[fd.fnParams[pk]] = 1
              }
              pk = pk + 1
            }
          }
        }
      }
    }
    fi = fi + 1
  }
  0
}

// D924 — IS `nm` DECLARED EXACTLY ONCE? `anonLeafParamArgsOk`'s `decls != 1` refutation, split
// out because the narrow-use pass asks it of a declaration rather than of a read.
function anonLeafOneDeclNamed(nm: string): boolean {
  let n = 0
  let i = 0
  while i < P.nodes.length {
    const d = P.nodes[i]
    if d is FuncDecl {
      if d.fnName == nm { n = n + 1 }
    }
    i = i + 1
  }
  n == 1
}

// D924 — DOES EVERY CALL SITE DELIVER A `??` FAMILY MEMBER at parameter position `pos`?
//
// `null` counts as delivered (`ref.null` is valid at every row) but does not COUNT as the one
// real member the mark needs, so a slot every caller passes `null` to is not moved.
function anonLeafSlotAllMembers(
  fname: string,
  pNames: string[],
  pos: i32,
): boolean {
  let member = false
  let ci = 0
  while ci < P.nodes.length {
    const cn = P.nodes[ci]
    if cn is Call {
      const cf = unwrapParen(cn.callFn)
      if cf >= 0 {
        const cfn = P.nodes[cf]
        if cfn is Ident {
          // D925 — THROUGH THE BINDING HOP TOO, so a call spelled `f(…)` over `const f =
          // src` is the call site it is. See `anonLeafCalleeFnName`.
          if anonLeafCallMayTarget(cn.callFn, fname) {
            const slots = orderArgsByParamNames(
              pNames,
              cn.callArgs,
              cn.callArgNames,
            )
            if slots.length != pNames.length { return false }
            if pos >= slots.length { return false }
            if slots[pos] < 0 { return false }
            const av = unwrapParen(slots[pos])
            if av < 0 { return false }
            const avn = P.nodes[av]
            if avn is NullLit { 0 }
            else if anonLeafDeliversMember(av) { member = true }
            else { return false }
          }
        }
      }
    }
    ci = ci + 1
  }
  member
}

// D935 — A SLOT THAT RECEIVES *SOME* FAMILY MEMBERS: ENROL THE REST RATHER THAN DECLINE.
//
// `anonLeafSlotAllMembers` refuses the moment one call site hands the slot a literal that is
// not already at the merged row, and refusing is the right answer for a slot this cannot make
// uniform. But it is the WRONG answer when the odd argument is a bare object literal, because
// declining does not un-widen the members: `keep(q)` still passes a moved `q` into a slot that
// kept the narrow row, and the module is invalid wasm rather than a refusal. That is
// `d924_narrow_use_mixed_sites` — and note that NEITHER call site is a defect on its own, only
// the pair, which is why every single-site reader in this family walked past it.
//
// So the literal joins the family instead. It is enrolled at the members' own row and
// annotation — `anonLeafJoinedMark`'s three arrays, written exactly as a `??`'s own member is —
// and only when its field NAMES match a member's exactly. That last test is what keeps this
// from widening a shape the merge never covered: the param annotation admits both arguments,
// but the family row can be wider than the annotation, and a literal missing one of its fields
// would be enrolled at a row it cannot fill.
function anonLeafSlotEnrolMembers(
  fname: string,
  pNames: string[],
  pos: i32,
): boolean {
  const members: i32[] = []
  const plain: i32[] = []
  let ci = 0
  while ci < P.nodes.length {
    const cn = P.nodes[ci]
    if cn is Call {
      const cf = unwrapParen(cn.callFn)
      if cf >= 0 {
        const cfn = P.nodes[cf]
        if cfn is Ident {
          if anonLeafCallMayTarget(cn.callFn, fname) {
            const slots = orderArgsByParamNames(
              pNames,
              cn.callArgs,
              cn.callArgNames,
            )
            if slots.length != pNames.length { return false }
            if pos >= slots.length { return false }
            if slots[pos] < 0 { return false }
            const av = unwrapParen(slots[pos])
            if av < 0 { return false }
            const avn = P.nodes[av]
            if avn is NullLit { 0 }
            else if anonLeafDeliversMember(av) { members.push(av) }
            else if avn is ObjLit { plain.push(av) }
            else if anonLeafIdentAllObjLits(av, plain) { 0 }
            else { return false }
          }
        }
      }
    }
    ci = ci + 1
  }
  if members.length == 0 { return false }
  if plain.length == 0 { return false }
  // THE SHAPE TO MATCH AGAINST is a member's own literal — through the binding hop when the
  // member is an identifier, which is the ordinary case and was `d924_narrow_use_mixed_sites`
  // itself: there the family member reaching the slot is `q`, never a literal at the call site.
  let shape = 0 - 1
  let mi = 0
  while mi < members.length {
    if shape < 0 { shape = anonLeafMemberLit(members[mi]) }
    mi = mi + 1
  }
  if shape < 0 { return false }
  let pi = 0
  while pi < plain.length {
    if !anonLeafSameFieldNames(shape, plain[pi]) { return false }
    pi = pi + 1
  }
  // Every check has passed, so the writes happen together — a partial enrolment would leave
  // exactly the split this exists to close.
  let wi = 0
  while wi < plain.length {
    const w = plain[wi]
    if w >= 0 && w < anonLeafJoined.length {
      anonLeafJoined[w] = 1
      if anonLeafFamRow[w] < 0 { anonLeafFamRow[w] = anonLeafFamRowOf(shape) }
      if anonLeafAnnTy[w] < 0 { anonLeafAnnTy[w] = anonLeafAnnTyOf(shape) }
    }
    wi = wi + 1
  }
  true
}

// D935 — AN IDENTIFIER ARGUMENT WHOSE EVERY WRITE IS A PLAIN OBJECT LITERAL: append those
// literals to `plain` and answer true.
//
// The binding hop of the enrolment, and the ordinary spelling of it: `const z = { r: 3 };
// keep(z)` is the same call site as `keep({ r: 3 })` with a name in the way, and
// `anonLeafDeliversMember` answers false for it because the write is not yet joined. Without
// this arm the whole slot declines and the members stay widened beside a narrow slot — the
// defect `anonLeafSlotEnrolMembers` exists to close, reached by a different spelling.
//
// A name with NO write, or one write this cannot see, answers false: enrolling the literals it
// DOES name would move the slot's row while that unseen value keeps the old one.
function anonLeafIdentAllObjLits(av: i32, plain: i32[]): boolean {
  const avn = P.nodes[av]
  if avn is Ident {
    const lits: i32[] = []
    let li = 0
    while li < P.nodes.length {
      const lnn = P.nodes[li]
      let w = 0 - 1
      if lnn is LetDecl {
        if lnn.letName == avn.identName { w = unwrapParen(lnn.letInit) }
      }
      if lnn is BinExpr {
        if lnn.binOp == "=" {
          const tgt = unwrapParen(lnn.binLeft)
          if tgt >= 0 {
            const tn = P.nodes[tgt]
            if tn is Ident {
              if tn.identName == avn.identName { w = unwrapParen(lnn.binRight) }
            }
          }
        }
      }
      if w >= 0 {
        const wn = P.nodes[w]
        if wn is NullLit { 0 }
        else if wn is ObjLit { lits.push(w) }
        else { return false }
      }
      li = li + 1
    }
    if lits.length == 0 { return false }
    let ki = 0
    while ki < lits.length {
      plain.push(lits[ki])
      ki = ki + 1
    }
    return true
  }
  false
}

// D935 — THE OBJECT LITERAL A FAMILY MEMBER DELIVERS: itself, or the one written to its name.
//
// `anonLeafDeliversMember` has already proved every write of an identifier member is a joined
// literal, so the first one found is representative and the scan does not re-check them.
function anonLeafMemberLit(av: i32): i32 {
  if av < 0 { return 0 - 1 }
  const avn = P.nodes[av]
  if avn is ObjLit { return av }
  if avn is Ident {
    let li = 0
    while li < P.nodes.length {
      const lnn = P.nodes[li]
      let w = 0 - 1
      if lnn is LetDecl {
        if lnn.letName == avn.identName { w = unwrapParen(lnn.letInit) }
      }
      if lnn is BinExpr {
        if lnn.binOp == "=" {
          const tgt = unwrapParen(lnn.binLeft)
          if tgt >= 0 {
            const tn = P.nodes[tgt]
            if tn is Ident {
              if tn.identName == avn.identName { w = unwrapParen(lnn.binRight) }
            }
          }
        }
      }
      if w >= 0 {
        const wn = P.nodes[w]
        if wn is ObjLit { return w }
      }
      li = li + 1
    }
  }
  0 - 1
}

// D935 — DO TWO OBJECT LITERALS NAME THE SAME FIELDS, in any order?
function anonLeafSameFieldNames(a: i32, b: i32): boolean {
  const an = P.nodes[a]
  const bn = P.nodes[b]
  if an is ObjLit {
    if bn is ObjLit {
      if an.objFields.length != bn.objFields.length { return false }
      let i = 0
      while i < an.objFields.length {
        const af = P.nodes[an.objFields[i]]
        if af is FieldInit {
          let found = false
          let j = 0
          while j < bn.objFields.length {
            const bf = P.nodes[bn.objFields[j]]
            if bf is FieldInit {
              if bf.fiName == af.fiName { found = true }
            }
            j = j + 1
          }
          if !found { return false }
        } else {
          return false
        }
        i = i + 1
      }
      return true
    }
  }
  false
}

// D924 — IS THE ARGUMENT NODE `av` A FAMILY MEMBER, or a binding that only ever holds one?
//
// The two delivery forms D911's own argument reader recognises, asked in the other direction:
// there the question was "which literals reach this slot", here it is "is every literal that
// reaches it already at the merged row". A binding with no write at all, or one write this
// cannot name, is not a member — the mark is refused and nothing moves.
function anonLeafDeliversMember(av: i32): boolean {
  const avn = P.nodes[av]
  if avn is ObjLit { return anonLeafInJoin(av) }
  if avn is Ident {
    let hits = 0
    let li = 0
    while li < P.nodes.length {
      const lnn = P.nodes[li]
      let w = 0 - 1
      if lnn is LetDecl {
        if lnn.letName == avn.identName { w = unwrapParen(lnn.letInit) }
      }
      if lnn is BinExpr {
        if lnn.binOp == "=" {
          const tgt = unwrapParen(lnn.binLeft)
          if tgt >= 0 {
            const tn = P.nodes[tgt]
            if tn is Ident {
              if tn.identName == avn.identName { w = unwrapParen(lnn.binRight) }
            }
          }
        }
      }
      if w >= 0 {
        const wn = P.nodes[w]
        if wn is NullLit {
          0
        } else if wn is ObjLit {
          if !anonLeafInJoin(w) { return false }
          hits = hits + 1
        } else {
          return false
        }
      }
      li = li + 1
    }
    return hits > 0
  }
  false
}

// D833 — MARK EVERY OBJECT LITERAL A `??` JOINS INTO ONE VALUE, and record the row its join was
// already claimed by.
//
// `L ?? D`: `D` is one such literal, and so is every literal that flows into whatever `L` reads.
// TWO READERS are recognised: a MAP or list INDEX over an identifier (`(c)["k0"]` — the literals
// stored at `c[…] = { … }`, D833), and a BARE IDENTIFIER (`a` — the literals bound to `a`, D842).
// A left operand neither can read yields the DEFAULT alone; the rungs below then need two
// disagreeing atoms among literals no row claims, which is D804's own population, so an
// unrecognised reader costs nothing and claims nothing.
//
// THE BARE IDENTIFIER WAS BUILT AND MEASURED OUT AT D841, AND THE MEASUREMENT WAS RIGHT: alone
// it closes nothing. It mints the merged row and the binding's cell still names the narrow one,
// because a local resolves its struct index from its ANNOTATION and not through the map value
// slot D841's supersede redirects. What makes it load-bearing here is `anonLeafSupersedeOf` at
// `nulRefStructIdxOfLet` — the cell's own resolver — which is the other half of D842. Neither
// half moves a cell without the other, and the ablation grades them so.
function anonLeafJoinedMark() {
  while anonLeafJoined.length < P.nodes.length {
    anonLeafJoined.push(0)
    anonLeafFamRow.push(0 - 1)
    anonLeafAnnTy.push(0 - 1)
  }
  let qi = 0
  while qi < P.nodes.length {
    const qn = P.nodes[qi]
    if qn is BinExpr {
      if qn.binOp == "??" {
        const d = unwrapParen(qn.binRight)
        if d >= 0 {
          const dn = P.nodes[d]
          if dn is ObjLit {
            const mem: i32[] = []
            mem.push(d)
            anonLeafJoinSources(unwrapParen(qn.binLeft), mem)
            // THE FAMILY'S ROW is the one its members already matched — the row this join will
            // have to supersede. Taken from the first member that has one, because a `??`'s
            // operands are ONE value and cannot be sitting on two.
            let famRow = 0 - 1
            let mi = 0
            while mi < mem.length {
              if famRow < 0 { famRow = structIndexOfObj(mem[mi]) }
              mi = mi + 1
            }
            // D872 — AND THE LEFT OPERAND'S OWN DECLARED TYPE, the half of the family that
            // is not a literal. First `??` to claim a member wins, exactly as `famRow` does.
            const annTy = anonLeafJoinAnnTy(unwrapParen(qn.binLeft))
            let mj = 0
            while mj < mem.length {
              const m = mem[mj]
              if m >= 0 && m < anonLeafJoined.length {
                anonLeafJoined[m] = 1
                if anonLeafFamRow[m] < 0 { anonLeafFamRow[m] = famRow }
                if anonLeafAnnTy[m] < 0 { anonLeafAnnTy[m] = annTy }
              }
              mj = mj + 1
            }
          }
        }
      }
    }
    qi = qi + 1
  }
  0
}

// The object literals that reach a `??`'s LEFT operand — the other half of the one value.
// Appended to `mem`; a reader this does not recognise appends nothing.
function anonLeafJoinSources(lhs: i32, mem: i32[]) {
  if lhs < 0 { return 0 }
  const ln = P.nodes[lhs]
  if ln is Index {
    const base = unwrapParen(ln.idxArr)
    if base >= 0 {
      const bn = P.nodes[base]
      if bn is Ident {
        let ai = 0
        while ai < P.nodes.length {
          const an = P.nodes[ai]
          if an is BinExpr {
            if an.binOp == "=" {
              anonLeafJoinStore(an.binLeft, an.binRight, bn.identName, mem)
            }
          }
          ai = ai + 1
        }
      }
    }
  }
  // D842 — A BARE IDENTIFIER left operand (`a ?? { … }`): the literals that reach `a` are the
  // ones bound to it, its declaration's initializer and any later `a = { … }`. Read by NAME
  // over the whole program, exactly as the INDEX reader above reads its container's stores —
  // the two are the same question about two delivery forms, and a same-named binding in
  // another function can only ADD a member, which the atom gates then accept or refute on its
  // own spelling.
  // D871 — A CALL left operand (`src() ?? { … }`): the literals that reach the `??` are the
  // ones the CALLEE RETURNS. The same question the INDEX arm asks of a container's stores and
  // the IDENT arm of a binding's initializers, one delivery form further out.
  if ln is Call { anonLeafJoinCallee(ln.callFn, mem) }
  if ln is Ident {
    let li = 0
    while li < P.nodes.length {
      const lnn = P.nodes[li]
      if lnn is LetDecl {
        if lnn.letName == ln.identName {
          anonLeafJoinBound(lnn.letInit, mem)
          // D871 — AND WHERE THAT INITIALIZER IS A CALL, the callee's returns. ONE hop: a
          // callee whose own return is another call is a path `anonLeafJoinCallee` cannot
          // name, and it declines the whole callee rather than half-reading it.
          anonLeafJoinInitCall(lnn.letInit, mem)
        }
      }
      if lnn is BinExpr {
        if lnn.binOp == "=" {
          const tgt = unwrapParen(lnn.binLeft)
          if tgt >= 0 {
            const tn = P.nodes[tgt]
            if tn is Ident {
              if tn.identName == ln.identName {
                anonLeafJoinBound(lnn.binRight, mem)
                // D871 — and the same one hop the DECLARATION leg above takes. The two legs
                // are one question about two spellings of the same binding, and a call read
                // on one and not the other is the asymmetry that makes `a = src()` behave
                // unlike `const a = src()`.
                anonLeafJoinInitCall(lnn.binRight, mem)
              }
            }
          }
        }
      }
      li = li + 1
    }
  }
  0
}

// D842 — append `rhs` to `mem` when it is an object literal, deduped. The bare-identifier
// reader's twin of `anonLeafJoinStore`'s tail, split out for the same reason: the binding scan
// above reads as one question.
function anonLeafJoinBound(rhs: i32, mem: i32[]) {
  const rv = unwrapParen(rhs)
  if rv < 0 { return 0 }
  const rn = P.nodes[rv]
  if rn is ObjLit {
    let i = 0
    while i < mem.length {
      if mem[i] == rv { return 0 }
      i = i + 1
    }
    mem.push(rv)
  }
  0
}

// D872 — THE `??` LEFT OPERAND'S OWN DECLARED TYPE NODE, or -1. ONE form answers: a bare
// IDENTIFIER, whose annotated declaration says what its non-null value is.
//
// A CALL LEFT OPERAND IS DELIBERATELY NOT ONE, and the reason is a measured `loud -> silent`
// rather than caution. `src(): {r: i32} | null { const v = { r: 7 }; v }` has a declared return
// that names the atom perfectly — and its returned value is a BINDING, which
// `anonLeafJoinCallee` cannot name and so refuses to move. Taking the atom from the annotation
// there mints the merged row and redirects the callee's return to it while the literal `v`
// holds stays at the narrow one: `emitProgram: bare null needs a struct-typed context` became
// CHECK-CLEAN INVALID WASM. The reader is what licences a call's atom, and where the reader
// answers (`anonLeafJoinCallee` appended the callee's literals) the atom is already in the set
// from the literal itself — so this arm would buy nothing even when it is safe. Measured:
// removing the reader alone leaves the three `_direct` cells running off this arm, and every
// one of them runs off the reader with this arm gone.
//
// A container INDEX is not one either — D833/D841 read that operand through the map's value
// slot, which already carries the row.
//
// REFUSES ON DISAGREEMENT rather than taking the first. Two same-named bindings with the SAME
// annotation spelling name one row and one atom, so they answer together (which is what
// `d863_two_sets_nested_row`'s two `a`s are); with different spellings there is no single
// declared type for this operand and the rung declines, leaving the family to its literals.
function anonLeafJoinAnnTy(lhs: i32): i32 {
  if lhs < 0 { return 0 - 1 }
  const ln = P.nodes[lhs]
  // D911 — A CALL LEFT OPERAND IS ONE AFTER ALL, and the interlock the paragraph above asks
  // for is what makes it so. D872 measured the loud→silent price of taking a call's atom while
  // `anonLeafJoinCallee` was REFUSING to move that callee — "the reader is what licences a
  // call's atom" — and gated on the reader here it is licenced by construction: the read has
  // succeeded, so every literal the callee hands back is a member and its return row is marked.
  //
  // WHAT IT BUYS IS THE FAMILY WITH NO LITERAL AT ALL, AND THAT IS ALSO ITS FIRST GATE. An
  // empty callee body has no return path to refuse, and a parameter every call site passes
  // `null` to answers through D891's arm — in both the set is the DEFAULT's atom alone,
  // `atoms.length < 2` ends the rung, and the pair falls to D804's `i32`/`string` corner as
  // check-clean invalid wasm. The callee's declared return names the missing atom exactly.
  //
  // A CALLEE THAT DID HAND BACK A LITERAL STANDS DOWN, and the reason is NOT that the arm would
  // be a no-op there. It shipped once on exactly that reasoning — "the checker made those
  // literals agree with the annotation, so the atom is already in the set and the dedup drops
  // it" — and stamping `anonLeafAnnTy` for a CALL operand arms a SECOND reader that has nothing
  // to do with atoms: D873's post-mint `anonLeafCarrierRowOf`. With D901's fold in the tree the
  // family's mint is a plain scalar row rather than a box, and that rung then pointed the
  // CALLEE's declared `{r: f64}` return row at the row the DEFAULT literal had just minted —
  // `src` emitted `struct.new $i32row (f64.const 1.5)`, `expected i32, found f64`. Measured:
  // ungated, this arm cost the three `d892_box_*_f64_i32` cells and `d901_fold_f32_dest`, all
  // four `runs` on master. Where the reader answered, the LITERALS are the family.
  if ln is Call {
    const rlits: i32[] = []
    const rfns: string[] = []
    const rpars: i32[] = []
    if !anonLeafCalleeRead(ln.callFn, rlits, rfns, rpars, 0) { return 0 - 1 }
    if rlits.length > 0 { return 0 - 1 }
    const cf = unwrapParen(ln.callFn)
    if cf < 0 { return 0 - 1 }
    const cfn = P.nodes[cf]
    if cfn is Ident {
      let chit = 0 - 1
      let ci2 = 0
      while ci2 < P.nodes.length {
        const cd = P.nodes[ci2]
        if cd is FuncDecl {
          if cd.fnName == cfn.identName {
            if cd.fnRet < 0 { return 0 - 1 }
            if chit >= 0 {
              if tyNameOf(chit) != tyNameOf(cd.fnRet) { return 0 - 1 }
            } else {
              chit = cd.fnRet
            }
          }
        }
        ci2 = ci2 + 1
      }
      return chit
    }
    return 0 - 1
  }
  if ln is Ident {
    let hit = 0 - 1
    let li = 0
    while li < P.nodes.length {
      const lnn = P.nodes[li]
      if lnn is LetDecl {
        if lnn.letName == ln.identName {
          if lnn.letType < 0 { return 0 - 1 }
          if hit >= 0 {
            if tyNameOf(hit) != tyNameOf(lnn.letType) { return 0 - 1 }
          } else {
            hit = lnn.letType
          }
        }
      }
      li = li + 1
    }
    return hit
  }
  0 - 1
}

// D872 — THE DECLARED TYPE NODE stamped on `n`'s `??` family, or -1. See `anonLeafAnnTy`.
function anonLeafAnnTyOf(n: i32): i32 {
  if n < 0 { return 0 - 1 }
  if n >= anonLeafAnnTy.length { return 0 - 1 }
  anonLeafAnnTy[n]
}

// D872 — THE ATOM the `??` left operand's declared type spells at field `fname`, or "".
//
// READ OFF THE SPELLING AND NOT OFF THE ROW'S FIELD CODE, because the code cannot say it: a
// row's `{r: i32}` and `{r: boolean}` fields are BOTH code 0 (`fieldCodeOfSpelling`), as is a
// literal-union field, and a merged set built out of the wrong one names a union the box
// cannot hold. The six spellings admitted here are exactly `anonLeafAtomName`'s six, so a set
// this contributes to is one `nameFieldCode` can code; anything else answers "" and the rung
// declines, which is today's behaviour.
function anonLeafAnnAtomOf(tyIx: i32, fname: string): string {
  if tyIx < 0 { return "" }
  const arms: string[] = []
  splitUnionAtoms(tyNameOf(tyIx), arms)
  let shape = ""
  let k = 0
  while k < arms.length {
    if arms[k] != "null" {
      // More than one non-null arm: the operand's non-null value is not ONE shape.
      if shape != "" { return "" }
      shape = arms[k]
    }
    k = k + 1
  }
  // D922 — A DECLARED NAME IS THE SAME SHAPE, WRITTEN DOWN ONCE. `type R = {r: i32}` with
  // `: R | null` spells the identical operand as the inline `{r: i32} | null` this arm already
  // reads, and declining it was `d912_ann_named_ret`. The fields come off the DECLARATION's own
  // `FieldDef` nodes rather than off the spelling, because there is no spelling to split — and
  // the atom is then `anonLeafAtomOfText` of the field's type NAME, the same six-plus-one
  // vocabulary, so a set this contributes to is still one `nameFieldCode` can code.
  if !nameIsShapeSpanEnds(shape) { return anonLeafDeclFieldAtom(shape, fname) }
  const fnames: string[] = []
  const ftexts: string[] = []
  shapeInnerFieldSplit(groupInnerOf(shape), fnames, ftexts)
  let i = 0
  while i < fnames.length {
    if fnames[i] == fname { return anonLeafAtomOfText(ftexts[i]) }
    i = i + 1
  }
  ""
}

// D922 — THE ATOM A DECLARED STRUCT TYPE spells at field `fname`, or "".
//
// REFUSES ON DISAGREEMENT rather than taking the first, for `anonLeafJoinAnnTy`'s reason: two
// declarations of one name give the operand no single declared type, so the rung declines and
// the family is its literals. A GENERIC declaration (`type Box<T>`) is not a match either — its
// `tdName` carries the parameter span, so the plain-name compare never fires on one, and the
// atom it would spell is per-instance rather than declared.
function anonLeafDeclFieldAtom(shape: string, fname: string): string {
  if shape == "" { return "" }
  let hit = ""
  let seen = false
  let i = 0
  while i < P.nodes.length {
    const s = P.nodes[i]
    if s is TypeDecl {
      if s.tdName == shape {
        if seen { return "" }
        seen = true
        let fi = 0
        while fi < s.tdFields.length {
          if s.tdFields[fi] >= 0 {
            const fd = P.nodes[s.tdFields[fi]]
            if fd is FieldDef {
              if fd.fdName == fname {
                hit = anonLeafAtomOfText(tyNameOf(fd.fdType))
              }
            }
          }
          fi = fi + 1
        }
      }
    }
    i = i + 1
  }
  hit
}

// D911 — MAY AN ANNOTATION'S atom JOIN A SET OF VALUE ATOMS? Only when it does not WIDEN the
// family past every value in it, and the direction is the whole rule.
//
// An annotation atom describes a value that is ABSENT — that is the only reason this rung reads
// one (D872: `let a: {r: i32} | null = null` has no second literal at all). The atoms beside it
// come from values that will actually be BUILT. So the two directions are not symmetric:
//
//   NARROWER annotation, wider value (`a: {r: i32} | null` … `?? { r: 1.5 }`) — D901's fold
//       answers `f64`, which is the atom the one real literal already has, and it builds there
//       unchanged. That is `d862_ann_only_atom_f64` and `d872_module_ann_only_f64`, and they run.
//   WIDER annotation, narrower value (`a: {r: f64} | null` … `?? { r: 7 }`) — the fold answers
//       `f64` too, and now the row is a type NO value in the family has: the int literal has to
//       widen into it and does not. `expected f64, found i32`, ON MASTER — this arm's own
//       IDENT half has had that defect since D872, and the same shape one atom over
//       (`a: {r: f32} | null`) is not a fold edge at all, so a two-atom BOX mints where the
//       family has one value and the read is a `wasm trap: cast failure`, also on master.
//
// So the gate is a WIDTH comparison and not a "is it numeric" one, and it closes two shapes
// master gets wrong as well as keeping D912's CALL arm from creating a third. A NON-numeric
// annotation atom is a real disagreement no join folds and always joins — which is D912's own
// population, an `i32` or `f64` return beside a `string` default. So is any atom set with no
// numeric value in it to widen past.
//
// The lattice is `typecheck.numWidensName`'s, flattened to a rank because only the comparison
// is needed: `i32` widens into everything, `f32` and `i64` into `f64` and into nothing else.
function anonLeafAtomWidth(atom: string): i32 {
  if atom == "i32" { return 0 }
  if atom == "i64" { return 1 }
  if atom == "f32" { return 1 }
  if atom == "f64" { return 2 }
  0 - 1
}

function anonLeafAnnAtomJoins(annAtom: string, atoms: string[]): boolean {
  const aw = anonLeafAtomWidth(annAtom)
  if aw < 0 { return true }
  let best = 0 - 1
  let i = 0
  while i < atoms.length {
    const w = anonLeafAtomWidth(atoms[i])
    if w > best { best = w }
    i = i + 1
  }
  if best < 0 { return true }
  aw <= best
}

// D884 — MAY `atom` JOIN THE ATOMS ALREADY IN THE SET?
//
// THE SIX SCALARS ALWAYS MAY, and the seventh — a LITERAL-UNION alias — may join `null` and
// nothing else. `K | null` is the code-30 niche `nameFieldCode` spells for the declared twin;
// `K | string | null` is a spelling it has no code for, and a set the mint cannot code takes
// the field all the way back to `anonFieldCode`'s answer rather than merely declining to widen.
//
// THAT DIFFERENCE IS A `runs` CELL, MEASURED, NOT A CAUTION. `let a: {r: K} | null = {r: "b"}`
// beside `?? {r: null}` RUNS on master: the literal's atom is `string` (a value's atom is read
// off the VALUE), the set is `string|null`, and code 20 carries it. Letting the annotation's `K`
// in ungated made that set `K|string|null`, the mint declined, and the program went from `runs`
// to `emitProgram: bare null needs a struct-typed context`. `d884_litunion_beside_str` is that
// witness and `d884_litunion_ann_reads` is the other side of the bound.
//
// A wider rule — normalising `K` and `string` onto one atom — is a different question: they are
// different REPS (an interned i32 id against a string ref), so a set holding both would need a
// box the niche codes cannot give.
function anonLeafAtomAdmits(atom: string, atoms: string[]): boolean {
  if !nameIsLitUnionType(atom) { return true }
  let i = 0
  while i < atoms.length {
    if atoms[i] != "null" { return false }
    i = i + 1
  }
  true
}

// The atom NAME a field's annotation TEXT spells, or "" for everything else — the type-side
// twin of `anonLeafAtomName`, and deliberately the same six atoms and no more.
function anonLeafAtomOfText(t: string): string {
  if t == "i32" { return "i32" }
  if t == "boolean" { return "boolean" }
  if t == "string" { return "string" }
  if t == "f64" { return "f64" }
  if t == "i64" { return "i64" }
  if t == "f32" { return "f32" }
  // D884 — AND A LITERAL-UNION ALIAS (`type K = "a" | "b"`), whose merged set `K|null` is the
  // code-30 NICHE `nameFieldCode` already spells for the declared twin. It is the seventh atom
  // and not one of the six because it is not a valtype: the six name a rep directly, this one
  // names a REGISTERED type whose rep is the interned i32 atom. `anonLeafPolyFieldCode` is what
  // decides whether the set it joins is spellable, and it admits exactly `K|null`.
  if nameIsLitUnionType(t) { return t }
  ""
}

// D873 — THE ROW `n`'s `??` LEFT OPERAND'S OWN CARRIER RESOLVES TO, or -1.
//
// IT IS NOT ALWAYS `structIndexOfObj`'s ANSWER, and that is the whole of D873. Both resolvers
// match a field-name SET, so with ONE row per set they agree and the supersede recorded against
// the literal's row is the one the cell reads. Add a second same-fieldset row — a nested-struct
// field's inline shape beside a declared `type R`, say — and they part: the literals land on
// one, the binding's annotation on the other, and the merged row is minted with nothing naming
// it. Recording the supersede against BOTH is what makes the cell follow.
function anonLeafCarrierRowOf(n: i32): i32 {
  retNulRefIndex(anonLeafAnnTyOf(n))
}

// D871 — `rhs` is a binding's initializer: when it is a CALL, the callee's returned literals.
// Split from `anonLeafJoinBound` rather than folded into it so the recursion cannot chain — a
// returned value is read as a literal or not at all, never followed through a second call.
function anonLeafJoinInitCall(rhs: i32, mem: i32[]) {
  const rv = unwrapParen(rhs)
  if rv < 0 { return 0 }
  const rn = P.nodes[rv]
  if rn is Call { return anonLeafJoinCallee(rn.callFn, mem) }
  0
}

// D871 — THE OBJECT LITERALS A CALLEE RETURNS, appended to `mem`, or NOTHING AT ALL when any
// return path is one this cannot name.
//
// REFUTING AS A WHOLE, and that is what separates it from the other two readers. A container's
// stores and a binding's initializers are appended ONE AT A TIME: a store this cannot name is
// simply not a member and the atom gates decide the rest. Here the merged row also redirects
// the callee's RETURN ROW (`anonLeafSupersedeOf` at the three return-row resolvers), so a
// returned value the reader did NOT move would be built at the narrow row and handed back at
// the merged one — invalid wasm where today there is a loud reject. One unnameable path
// therefore declines the whole callee, the family is the default alone, `atoms.length < 2`
// ends the rung and the program compiles exactly as it does now.
//
// `null` is not an unnameable path: `ref.null` is valid at every row, so a `S | null` callee
// returning `null` on one branch and a literal on another stays readable.
//
// The callee is found by NAME over the whole arena, exactly as the IDENT arm finds a binding's
// declarations — `fnStmts` is not populated when `collectAnonShapes` runs (see
// `anonMintRowFor`), so the function map is not available here and a name scan is the only
// resolver there is. Two same-named functions therefore both contribute, and either one being
// unreadable declines both.
function anonLeafJoinCallee(callFn: i32, mem: i32[]) {
  // D882/D883 — READ INTO A SCRATCH PAIR AND COMMIT ONLY ON SUCCESS. With one frame the old
  // shape could refute before appending anything; a returned BINDING and a returned CALL both
  // read a second frame, so a nested success followed by an outer refutation would leave the
  // inner frame's literals in `mem` (a family member whose row never moves) and its callee
  // MARKED (a return row that moves with no member behind it). That is exactly the
  // `runs`-losing shape `anonLeafRetMoved` exists to prevent, so nothing is published until
  // the whole read succeeds.
  const lits: i32[] = []
  const fns: string[] = []
  // D891 — the third half of the scratch, for the same reason: a returned PARAMETER marks the
  // param's own slot as an owner of the merged row, and a mark published under an outer
  // refutation is a slot that follows a merge with no member behind it.
  const pars: i32[] = []
  if !anonLeafCalleeRead(callFn, lits, fns, pars, 0) { return 0 }
  let ri = 0
  while ri < lits.length {
    anonLeafJoinBound(lits[ri], mem)
    ri = ri + 1
  }
  // D871 — AND MARK THE CALLEES, so the four return-row resolvers redirect exactly the
  // functions whose literals this just made family members. See `anonLeafRetMoved`.
  let fj = 0
  while fj < fns.length {
    anonLeafMarkRetMoved(fns[fj])
    fj = fj + 1
  }
  // D891 — AND THE PARAMETERS whose slot the merge moves. See `anonLeafParamMoved`.
  let pj = 0
  while pj < pars.length {
    while anonLeafParamMoved.length <= pars[pj] { anonLeafParamMoved.push(0) }
    anonLeafParamMoved[pars[pj]] = 1
    pj = pj + 1
  }
  0
}

// ONE frame of the callee read: the literals `callFn`'s callee hands back, appended to `lits`,
// with every function name whose return row must follow appended to `fns`. False — and nothing
// published — the moment one return path is unnameable.
//
// `fns` DOUBLES AS THE VISITED SET, which is what keeps `f(): S|null { f() }` from recursing
// for ever. A name already on the path ANSWERS rather than refuting, and that is not laxity: the
// frame that pushed it is being read, so its return row is in `fns` and will be marked — a
// self-call hands back that same row, contributes no literal nobody has seen, and refuting it
// cost `src(n): S|null { if n <= 0 { return {r: 0} }; src(n - 1) }` its merge
// (`d885_self_recursive_ret`).
//
// D921 — AND `fns` IS THE WHOLE BOUND: THE DEPTH CAP WAS A SECOND ONE THAT REFUSED PROGRAMS.
// The header used to read "the depth cap is the second, independent bound and the only one a
// fresh name meets", and `depth > 1` was that cap. It is not a bound at all, it is a REFUSAL
// with a number in it: every recursive entry to this reader goes through the `fns` gate above
// (`anonLeafRetPathOk`'s Call arm, `anonLeafBoundValOk`'s Call arm and
// `anonLeafParamArgsOk`'s call-valued-argument arm all call THIS function), a name already on
// the path answers without re-reading, and each fresh name is pushed exactly once — so the
// number of frames a single read can open is the number of DISTINCT function names in the
// program, whatever `depth` says. What the cap actually did was decline `src(mk())` where
// `mk`'s own body hands back another call: two frames, one more than the number allowed.
// That is `d911_nested_arg_two_frames`, and `depth` is kept only because it is what a future
// COST bound would count.
function anonLeafCalleeRead(
  callFn: i32,
  lits: i32[],
  fns: string[],
  pars: i32[],
  depth: i32,
): boolean {
  if depth < 0 { return false }
  const c = unwrapParen(callFn)
  if c < 0 { return false }
  const cn = P.nodes[c]
  if cn is Ident {
    let k = 0
    while k < fns.length {
      if fns[k] == cn.identName { return true }
      k = k + 1
    }
    fns.push(cn.identName)
    let seen = false
    let fi = 0
    while fi < P.nodes.length {
      const fd = P.nodes[fi]
      if fd is FuncDecl {
        if fd.fnName == cn.identName {
          seen = true
          if (
            !anonLeafCalleeRets(
              fd.fnBody,
              lits,
              true,
              fd.fnBody,
              fns,
              pars,
              depth,
            )
          ) {
            return false
          }
        }
      }
      fi = fi + 1
    }
    return seen
  }
  false
}

// D926 — CARRY A `??` OWNER MARK ONTO A MONOMORPHIZED CLONE'S NODE.
//
// BOTH MARKS ARE ARENA-NODE KEYED AND THE MONOMORPHIZER MINTS NEW NODES. `collectAnonShapes`
// is pass 3 and `monomorphize` is pass 16, so every mark is final by the time an instance is
// built — but `monoMakeInstance` calls `mkParam` and `mkFunc`, and every reader of the marks
// (`emitOneFuncType`, `emitFuncCode`, `paramStructIdxOf`, `anonLeafRetRowOf`) resolves through
// the POST-mono declaration. The mark was therefore silently dropped for any callee mono
// clones, and the two sites had drifted to opposite wrong answers about it:
//
//   * `anonLeafParamArgsOk` refused a callee with `fnTyParams` OUTRIGHT — the refusal
//     `d911_generic_callee` pins. It is not the right test either way: `monoIsGenericDecl`
//     clones for an UN-ANNOTATED parameter too, and `function src(p: {r: i32}, t)` has an
//     empty `fnTyParams`, is marked, is cloned, and is CHECK-CLEAN INVALID WASM on master
//     (`d926_hole_param_clone`).
//   * `anonLeafMarkRetMoved` had no such guard at all, so a GENERIC callee returning a literal
//     into a `??` marks a `FuncDecl` that mono then replaces — also check-clean invalid wasm on
//     master, and unfiled until now (`d926_generic_ret_clone`).
//
// CARRYING THE MARK CLOSES ALL THREE and needs no guard, because `anonLeafSupersedeOf` is a
// bounds-checked identity outside the family: an instance whose parameter annotation was
// RE-SYNTHESISED per pin resolves to a row the merge never touched and the redirect is a no-op.
// Only a parameter whose pinned row IS the family's narrow row moves — which for a concrete
// annotation like `p: {r: i32}` is the same arena type node, shared with the original.
export function anonLeafCarryParamMark(origIx: i32, newIx: i32) {
  if origIx < 0 || newIx < 0 { return 0 }
  if origIx >= anonLeafParamMoved.length { return 0 }
  if anonLeafParamMoved[origIx] != 1 { return 0 }
  while anonLeafParamMoved.length <= newIx { anonLeafParamMoved.push(0) }
  anonLeafParamMoved[newIx] = 1
  0
}

// D926 — the return-row twin. See `anonLeafCarryParamMark`.
export function anonLeafCarryRetMark(origIx: i32, newIx: i32) {
  if origIx < 0 || newIx < 0 { return 0 }
  if origIx >= anonLeafRetMoved.length { return 0 }
  if anonLeafRetMoved[origIx] != 1 { return 0 }
  while anonLeafRetMoved.length <= newIx { anonLeafRetMoved.push(0) }
  anonLeafRetMoved[newIx] = 1
  0
}

// D871 — every `FuncDecl` named `nm` has its return row follow the merge. Split out of
// `anonLeafJoinCallee` because a nested read names more than one function.
function anonLeafMarkRetMoved(nm: string) {
  let already = false
  let mi = 0
  while mi < P.nodes.length {
    const md = P.nodes[mi]
    if md is FuncDecl {
      if md.fnName == nm {
        while anonLeafRetMoved.length <= mi { anonLeafRetMoved.push(0) }
        if anonLeafRetMoved[mi] == 1 { already = true }
        anonLeafRetMoved[mi] = 1
      }
    }
    mi = mi + 1
  }
  // D948 — AND EVERY FUNCTION THIS ONE SHARES A BINDING WITH. One binding holds one wasm
  // signature, so a moved return row that some other function is also written to leaves that
  // binding unable to hold both. Guarded on `already` because the co-move calls back into
  // this function for each sibling: the second visit finds the mark set and stops, which is
  // the whole of the recursion's bound.
  if !already { anonLeafCoMoveFnRets(nm) }
  0
}

// Every value a function body hands back: each `return e` and the body block's implicit TAIL
// expression. False the moment one of them is a path `anonLeafRetPathOk` cannot name. A NESTED
// function declaration is skipped — its returns are its own.
//
// `body` is the FRAME's own body block, carried unchanged through the recursion so the
// returned-binding arm can resolve an identifier against the bindings of the function that
// returned it (D882); `fns`/`depth` are the callee-read path (D883).
function anonLeafCalleeRets(
  ix: i32,
  out: i32[],
  tail: boolean,
  body: i32,
  fns: string[],
  pars: i32[],
  depth: i32,
): boolean {
  if ix < 0 { return true }
  const n = P.nodes[ix]
  if n is FuncDecl { return true }
  if n is RetStmt {
    if !anonLeafRetPathOk(n.retArg, out, body, fns, pars, depth) {
      return false
    }
  }
  if n is Block {
    if tail {
      if n.blkStmts.length > 0 {
        if (
          !anonLeafTailPathOk(
            n.blkStmts[n.blkStmts.length - 1],
            out,
            body,
            fns,
            pars,
            depth,
          )
        ) {
          return false
        }
      }
    }
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if !anonLeafCalleeRets(kids[i], out, false, body, fns, pars, depth) {
      return false
    }
    i = i + 1
  }
  true
}

// ONE returned expression. An object literal is a member; a `null` (or a bare `return`) is not
// a member and not a refutation, because `ref.null` is valid at every row. Everything else
// refutes — see `anonLeafJoinCallee` for why this arm is strict where the other readers are
// lenient.
//
// D882 — A RETURNED BINDING is the IDENT reader one frame in: `{ const v = { r: 7 }; v }` hands
// back a literal the caller can see, and refusing it left `d876_call_ret_is_binding` a loud
// reject. Resolved against THIS function's own bindings only, and every one of them has to be
// nameable — a binding written from a parameter or a field read refutes the whole callee,
// exactly as an unnameable `return` does.
//
// D883 — A RETURNED CALL is one more frame of the same read. `anonLeafCalleeRead` carries the
// visited set and the depth cap, so `src(): S|null { inner() }` reaches `inner`'s literals and
// marks BOTH return rows.
function anonLeafRetPathOk(
  argIx: i32,
  out: i32[],
  body: i32,
  fns: string[],
  pars: i32[],
  depth: i32,
): boolean {
  if argIx < 0 { return true }
  const a = unwrapParen(argIx)
  if a < 0 { return true }
  const an = P.nodes[a]
  if an is NullLit { return true }
  if an is ObjLit {
    out.push(a)
    return true
  }
  if an is Ident {
    // D911 — the NAME-visited set is minted here and carried through the whole ident
    // resolution, for `fns`'s reason one level down: a bound value that is itself an
    // identifier re-enters this resolver, and `let a = …; a = b; let b = …; b = a` is a cycle
    // no depth cap bounds (the cap counts CALL frames, and an ident chain opens none).
    const ids: string[] = []
    return anonLeafRetIdentOk(an.identName, body, out, fns, pars, depth, ids)
  }
  if an is Call {
    return anonLeafCalleeRead(an.callFn, out, fns, pars, depth + 1)
  }
  false
}

// D882 — THE LITERALS BOUND TO `nm` INSIDE THE FRAME THAT RETURNED IT, or a refutation.
//
// The IDENT reader `anonLeafJoinSources` asks this of the whole program for a `??`'s own left
// operand; here it is asked of ONE function body, because that is the scope a returned name
// resolves in. It is STRICT where that one is lenient, for `anonLeafJoinCallee`'s reason: an
// unmoved store handed back through a moved return row is invalid wasm, not a lost member.
//
// A name with NO binding in this body is a parameter, a capture or a global — none of them a
// path this can name — so an empty scan refutes rather than answering "no members".
//
// D911 — `ids` IS THE NAME-VISITED SET and a name already on it ANSWERS, on `fns`'s reasoning
// exactly: the frame that pushed it is being read, so its sources are already in the family and
// re-reading them adds nothing. Without it `a = b` / `b = a` recurses for ever, because the
// depth cap counts CALL frames and an identifier chain opens none.
function anonLeafRetIdentOk(
  nm: string,
  body: i32,
  out: i32[],
  fns: string[],
  pars: i32[],
  depth: i32,
  ids: string[],
): boolean {
  let vi2 = 0
  while vi2 < ids.length {
    if ids[vi2] == nm { return true }
    vi2 = vi2 + 1
  }
  ids.push(nm)
  const hits: i32[] = []
  if !anonLeafBindScan(body, nm, body, out, hits, fns, pars, depth, ids) {
    return false
  }
  // D891 — AND A PARAMETER, whose sources are the ARGUMENTS at every call site. Asked BESIDE
  // the binding scan and not instead of it: `function src(p: S|null) { p = { r: 9 }; p }` has
  // both, and reading only the assignment moves the return row while the param's incoming
  // value keeps the narrow one (that is `d891_param_reassigned`, check-clean invalid wasm on
  // master). Where the arm answers it is authoritative — a param with no readable call site
  // refutes the whole callee even when the body also assigns it.
  const pp = anonLeafParamNodeOf(body, nm)
  if pp >= 0 { return anonLeafParamArgsOk(body, pp, out, fns, pars, depth) }
  hits.length > 0
}

// D891 — THE `Param` NODE named `nm` of the function whose body block is `body`, or -1.
//
// `body` is the callee frame's own `fnBody`, carried unchanged through the read, so the owning
// `FuncDecl` is the one arena node whose `fnBody` is exactly it. A nested declaration's body is
// a different block, and `anonLeafCalleeRets` never descends into one, so the match is unique.
function anonLeafParamNodeOf(body: i32, nm: string): i32 {
  if body < 0 { return 0 - 1 }
  let fi = 0
  while fi < P.nodes.length {
    const fd = P.nodes[fi]
    if fd is FuncDecl {
      if fd.fnBody == body {
        let pi = 0
        while pi < fd.fnParams.length {
          const pn = P.nodes[fd.fnParams[pi]]
          if pn is Param {
            if pn.parName == nm { return fd.fnParams[pi] }
          }
          pi = pi + 1
        }
        return 0 - 1
      }
    }
    fi = fi + 1
  }
  0 - 1
}

// D891 — A RETURNED PARAMETER: THE LITERALS THAT REACH IT ARE THE ARGUMENTS AT EVERY CALL SITE,
// and marking the param's slot as an owner of the merged row is the other half.
//
// `anonLeafRetIdentOk` resolves a returned name against the BINDINGS of the frame that returned
// it, and a parameter has none — the scan finds nothing and, before this arm, the read refuted
// as a whole (`d888_ret_param`, check-clean invalid wasm). The sources are one frame OUT rather
// than one frame in, which is why no earlier reader reached them: the callee is already found
// by name over the whole arena, so its CALLERS are reachable the same way.
//
// EVERY CALL SITE HAS TO BE VISIBLE, and the arm refutes rather than half-reading:
//
//   * a GENERIC callee — the monomorphizer clones the param's type per instance, so the
//     annotation this marks is not the slot any instance emits;
//   * TWO functions of the same name — a call by name reaches both and neither owns the args;
//   * the name used as a VALUE (`const f = src`, `map(src)`) — a `call_ref` through a function
//     value passes an argument no name scan can see;
//   * a NAMED argument (`src(p: …)`) — the position this arm reads is the source one, and
//     `orderArgsByParamNames` is what reorders it;
//   * an argument that is neither an object literal nor `null`, or a call site that does not
//     pass this position at all;
//   * NO call site at all — a slot moved with nothing to match it is the disagreement this
//     exists to prevent, not an empty win.
//
// A `null` argument is not an unnameable path, for `anonLeafRetPathOk`'s reason: `ref.null` is
// valid at every row. A parameter DEFAULT is read on the same three-way split (a literal is a
// member, a `null` is neither, anything else refutes) — it is the one source that is not at a
// call site.
//
// D911 TOOK `fns` / `depth` BACK, and the header sentence above them was the prediction that
// said when: an argument that is a CALL opens exactly one more frame (`src(mk())`), so the
// visited set and the depth cap have something to bound again.
function anonLeafParamArgsOk(
  body: i32,
  pIx: i32,
  out: i32[],
  fns: string[],
  pars: i32[],
  depth: i32,
): boolean {
  // The owning declaration, its name and this param's POSITION — one scan, because a second
  // declaration of the same name makes the position meaningless.
  let fname = ""
  let pos = 0 - 1
  let decls = 0
  // D911 — AND ITS PARAMETER NAMES, so a call site's arguments bind to slots the way the
  // emitter binds them (`orderArgsByParamNames`) rather than by source position.
  const pNames: string[] = []
  let fi = 0
  while fi < P.nodes.length {
    const fd = P.nodes[fi]
    if fd is FuncDecl {
      if fd.fnBody == body {
        // D926 — THE GENERIC REFUSAL IS GONE, AND IT WAS NEVER THE RIGHT TEST. It read
        // `fd.fnTyParams.length > 0 { return false }` on the stated reason that "the
        // monomorphizer clones the param's type per instance, so the annotation this marks
        // is not the slot any instance emits". The clone is real; the mark not surviving it
        // is what was wrong, and it is fixed where it happens (`anonLeafCarryParamMark`).
        // The predicate was also strictly narrower than the cloning one
        // (`monoIsGenericDecl` clones for an UN-ANNOTATED parameter too), so it declined
        // `d911_generic_callee` while letting `d926_hole_param_clone` through to invalid
        // wasm — a guard that was neither necessary nor sufficient for its own reason.
        fname = fd.fnName
        let pj = 0
        while pj < fd.fnParams.length {
          if fd.fnParams[pj] == pIx { pos = pj }
          const pnj = P.nodes[fd.fnParams[pj]]
          if pnj is Param { pNames.push(pnj.parName) } else { pNames.push("") }
          pj = pj + 1
        }
      }
    }
    fi = fi + 1
  }
  if fname == "" { return false }
  if pos < 0 { return false }
  let fk = 0
  while fk < P.nodes.length {
    const fq = P.nodes[fk]
    if fq is FuncDecl {
      if fq.fnName == fname { decls = decls + 1 }
    }
    fk = fk + 1
  }
  if decls != 1 { return false }
  // The param's own DEFAULT, on the three-way split.
  const pn = P.nodes[pIx]
  if pn is Param {
    if pn.parDefault >= 0 {
      const dv = unwrapParen(pn.parDefault)
      if dv < 0 { return false }
      const dn = P.nodes[dv]
      if dn is ObjLit { out.push(dv) }
      else if dn is NullLit { 0 }
      else { return false }
    }
  }
  // THE NAME AS A VALUE: an `Ident` spelling `fname` that is not the callee of a call is a
  // function value, and the arguments a `call_ref` passes are not at any call site this can
  // read — the functype this moves is the DECLARATION's, while a call through the value types
  // its argument off the value's own arrow annotation, which no mark reaches.
  //
  // D911 — AND THAT SENTENCE IS ABOUT A `call_ref`, NOT ABOUT A FUNCTION VALUE. `const f = src`
  // with `f` never invoked passes no argument anywhere, and refusing it was
  // `d891_bound_fn_as_value` — a refusal whose stated reason the program does not contain. The
  // narrowed test is the reason itself: a value refutes only where the program can CALL one.
  // Conservative on purpose — one possibly-indirect call anywhere declines the whole family,
  // which is the bound `d891_bound_fn_val_called` pins.
  let anyValue = false
  let vi = 0
  while vi < P.nodes.length {
    const vn = P.nodes[vi]
    if vn is Ident {
      if vn.identName == fname {
        if !anonLeafIsCalleePos(vi) { anyValue = true }
      }
    }
    vi = vi + 1
  }
  if anyValue {
    if anonLeafAnyIndirectCall() { return false }
  }
  // D911 — THE PARAMETER'S OWN NAME, for the self-pass arm below. Read once; the `Param` arm
  // above already proved the node is one.
  let pName = ""
  const pnn = P.nodes[pIx]
  if pnn is Param { pName = pnn.parName }
  // Every call site's argument at this position.
  let seen = false
  let ci = 0
  while ci < P.nodes.length {
    const cn = P.nodes[ci]
    if cn is Call {
      const cf = unwrapParen(cn.callFn)
      if cf >= 0 {
        const cfn = P.nodes[cf]
        if cfn is Ident {
          // D925 — THROUGH THE BINDING HOP TOO, so a call spelled `f(…)` over `const f =
          // src` is the call site it is. See `anonLeafCalleeFnName`.
          if anonLeafCallMayTarget(cn.callFn, fname) {
            // D911 — BOUND BY NAME THEN POSITIONALLY, through the one binder the checker and
            // the emitter share. Refusing every named argument outright (`src(p: { r: 7 })`)
            // was `d891_bound_named_arg`: the position this loop reads is the SOURCE one, and
            // `orderArgsByParamNames` is what turns it into the parameter's. A leftover — an
            // unknown name, a collision, a surplus positional — means the call is not one the
            // checker accepted at this arity, so the slot binding is meaningless and the arm
            // refutes exactly as it did.
            const slots = orderArgsByParamNames(
              pNames,
              cn.callArgs,
              cn.callArgNames,
            )
            if slots.length != pNames.length { return false }
            if pos >= slots.length { return false }
            if slots[pos] < 0 { return false }
            const av = unwrapParen(slots[pos])
            if av < 0 { return false }
            const avn = P.nodes[av]
            if avn is ObjLit {
              out.push(av)
              seen = true
            } else if avn is NullLit {
              seen = true
            } else if avn is Call {
              // D911 — A NESTED ARGUMENT is one more frame of the callee read, and it is the
              // same question `anonLeafRetPathOk`'s Call arm asks of a returned expression:
              // `src(mk())` hands the parameter whatever `mk` returns. Marking `mk`'s return
              // row follows from `fns`, which is why the arm needed them back.
              if !anonLeafCalleeRead(avn.callFn, out, fns, pars, depth + 1) {
                return false
              }
              seen = true
            } else if avn is Ident {
              // D911 — AN IDENTIFIER ARGUMENT IS TWO QUESTIONS, asked in this order.
              //
              // FIRST, A SELF-PASSED PARAMETER CONTRIBUTES NOTHING and is skipped, not
              // refuted. `src(n - 1, p)` inside `src` hands on the very slot this merge is
              // moving, so there is no unmoved value behind it — D885's visited-set answer,
              // one position over onto the argument side. SHADOWING is what makes it a
              // question rather than a spelling: a `const p = …` in the same frame makes the
              // identifier a different binding, and skipping it would move a slot no value
              // reaches, so a rebinding of the name anywhere in the frame refutes. It is asked
              // FIRST because the reader below would resolve the parameter's own name against
              // the program's bindings and find none — a refutation, not a skip.
              //
              // OTHERWISE IT IS THE IDENT READER AT THE CALL SITE: `const q = {r: 7}; src(q)`
              // delivers the literal through a binding, which is D842's question asked of an
              // argument. STRICT, for `anonLeafJoinCallee`'s reason — a write this cannot name
              // is a value that reaches the moved slot unmoved — and read by NAME over the
              // whole program, exactly as that reader is.
              if (
                pName != "" &&
                avn.identName == pName &&
                anonLeafInFrame(body, av) &&
                !anonLeafFrameRebinds(body, pName)
              ) {
                0
              } else if (
                anonLeafArgIdentOk(avn.identName, out, fns, pars, depth)
              ) {
                seen = true
              } else {
                return false
              }
            } else {
              return false
            }
          }
        }
      }
    }
    ci = ci + 1
  }
  if !seen { return false }
  pars.push(pIx)
  true
}

// D911 — IS `target` INSIDE THE FRAME rooted at `root`, without crossing a nested `FuncDecl`?
// The containment test the self-pass arm needs: an argument spelling the parameter's name is
// only the parameter itself when the call that passes it is in the parameter's own body.
function anonLeafInFrame(root: i32, target: i32): boolean {
  if root < 0 { return false }
  if root == target { return true }
  const n = P.nodes[root]
  if n is FuncDecl { return false }
  const kids = nodeChildren(root)
  let i = 0
  while i < kids.length {
    if anonLeafInFrame(kids[i], target) { return true }
    i = i + 1
  }
  false
}

// D911 — DOES THE FRAME REBIND `nm`? Every binder the frame can introduce, nested `FuncDecl`s
// excluded (their bindings are their own, and `anonLeafInFrame` already refuses to reach into
// one). A `match` arm's payload binding is a minted `LetDecl`, so the first arm covers it.
function anonLeafFrameRebinds(root: i32, nm: string): boolean {
  if root < 0 { return false }
  const n = P.nodes[root]
  if n is FuncDecl { return false }
  if n is LetDecl {
    if n.letName == nm { return true }
  }
  if n is ForRange {
    if n.frVar == nm { return true }
  }
  if n is ForIn {
    if n.fiVar == nm { return true }
  }
  const kids = nodeChildren(root)
  let i = 0
  while i < kids.length {
    if anonLeafFrameRebinds(kids[i], nm) { return true }
    i = i + 1
  }
  false
}

// D911 — THE LITERALS BOUND TO AN ARGUMENT IDENTIFIER, or a refutation.
//
// `anonLeafRetIdentOk` asks this of ONE function body because a RETURNED name resolves in the
// frame that returned it; an ARGUMENT's name resolves in the caller's frame, and the caller is
// wherever the call site is — module scope included. So it is read by NAME over the whole
// program, exactly as `anonLeafJoinSources`' own IDENT arm reads a `??`'s left operand, and it
// is STRICT where that one is lenient for `anonLeafJoinCallee`'s reason: a write this cannot
// name is a value that reaches the moved parameter slot at the row the merge left behind.
//
// D921 — `body` IS THE BINDING SITE'S OWN FRAME, and it used to be -1.
//
// The header sentence it replaces read "`body` is -1 on purpose: a bound value that is itself
// an identifier has no frame to resolve against here, so it refutes rather than half-reading a
// chain". There IS a frame and it is not the one this scan is standing in: an argument's name
// resolves in the caller, and a value written to that name resolves in the frame holding THAT
// WRITE — which is `anonLeafFrameBodyOf` of the binding node, not of the call site and not of
// the callee. `const q = z; src(q)` inside `rd(z: {r:i32})` is the shape: `q`'s write lives in
// `rd`, `z` is `rd`'s own parameter, and D891's arm then reads `rd`'s call sites for it. That
// is `d911_arg_ident_unnameable`, and it composes two rungs that were already here rather than
// adding a reader.
//
// D934 — A MODULE-SCOPE binding used to answer -1 and refute, and that was NOT a real bound.
// The sentence here read "`anonLeafRetIdentOk` resolves against a function's bindings and a
// parameter list, and module scope has neither" — true, and the wrong resolver to have asked.
// See `anonLeafArgIdentSeen`. `d921_arg_ident_module_chain` was that cell.
function anonLeafArgIdentOk(
  nm: string,
  out: i32[],
  fns: string[],
  pars: i32[],
  depth: i32,
): boolean {
  const ids: string[] = []
  anonLeafArgIdentSeen(nm, out, fns, pars, depth, ids)
}

// D934 — THE SAME SCAN, CARRYING THE NAME-VISITED SET, so a module-scope chain can re-enter it.
//
// `anonLeafBoundValOk`'s ident arm resolves a bound name against a FRAME, and a module-scope
// binding has none — that is what refuted `d921_arg_ident_module_chain`. But this scan never
// needed a frame: it resolves by NAME over the whole arena, which is exactly the scope a
// module-level name resolves in. So the missing rung was not a reader, it was the recursion
// back into this function, and the recursion needs D911's visited set to be SHARED rather than
// minted per call — `const a = b` / `const b = a` at module scope is a cycle the depth cap does
// not bound, for the same reason an ident chain opens no call frame.
function anonLeafArgIdentSeen(
  nm: string,
  out: i32[],
  fns: string[],
  pars: i32[],
  depth: i32,
  ids: string[],
): boolean {
  let vi = 0
  while vi < ids.length {
    if ids[vi] == nm { return true }
    vi = vi + 1
  }
  ids.push(nm)
  const hits: i32[] = []
  let li = 0
  while li < P.nodes.length {
    const lnn = P.nodes[li]
    if lnn is LetDecl {
      if lnn.letName == nm {
        if (
          !anonLeafBoundValOk(
            lnn.letInit,
            anonLeafFrameBodyOf(li),
            out,
            hits,
            fns,
            pars,
            depth,
            ids,
          )
        ) {
          return false
        }
      }
    }
    if lnn is BinExpr {
      if lnn.binOp == "=" {
        const tgt = unwrapParen(lnn.binLeft)
        if tgt >= 0 {
          const tn = P.nodes[tgt]
          if tn is Ident {
            if tn.identName == nm {
              if (
                !anonLeafBoundValOk(
                  lnn.binRight,
                  anonLeafFrameBodyOf(li),
                  out,
                  hits,
                  fns,
                  pars,
                  depth,
                  ids,
                )
              ) {
                return false
              }
            }
          }
        }
      }
    }
    li = li + 1
  }
  hits.length > 0
}

// D921 — THE BODY BLOCK OF THE INNERMOST `FuncDecl` CONTAINING `n`, or -1 at module scope.
//
// `anonLeafInFrame` stops at a nested declaration, so the frames it tests PARTITION the arena
// and the first `FuncDecl` whose body contains `n` is the innermost one — the same containment
// the self-pass arm uses, asked in the other direction.
function anonLeafFrameBodyOf(n: i32): i32 {
  if n < 0 { return 0 - 1 }
  let i = 0
  while i < P.nodes.length {
    const fd = P.nodes[i]
    if fd is FuncDecl {
      if anonLeafInFrame(fd.fnBody, n) { return fd.fnBody }
    }
    i = i + 1
  }
  0 - 1
}

// D911 — COULD ANY CALL IN THIS PROGRAM GO THROUGH A FUNCTION VALUE? The question the
// name-as-value guard is really asking, and the only one that makes a function value dangerous
// to this rung: with no `call_ref` anywhere, a funcref can be built and bound and still never
// pass an argument.
//
// OVER-APPROXIMATES ON PURPOSE, in the safe direction. A callee that is not a bare identifier
// (`obj.f(…)`, `(g)(…)`) counts; so does an identifier a `LetDecl` or a `Param` declares
// anywhere — a callback parameter invoked inside its own callee is exactly the escape a
// per-call-site name scan cannot follow. A BUILTIN (`print`, `len`) declares neither and so
// costs nothing, which is why the test is "is the name bound to a value" rather than "does the
// name resolve to a `FuncDecl`".
//
// Asked ONLY where a function value was actually found, so a program without one pays nothing.
//
// D925 — AND A CALL THROUGH A BINDING THIS CAN RESOLVE IS NOT ONE OF THEM. The sentence above
// is about arguments a name scan cannot SEE, and `const f = src; f({r: 9})` puts its argument at
// a call site as plainly as `src({r: 9})` does — the callee is spelled with one name-hop, and
// the hop is a `LetDecl` the same scan already reads. Refusing it was `d911_fn_value_called`, a
// refusal whose stated reason the program does not contain (D911's own words for the guard this
// one sits behind, one hop further out). A name bound to something that is NOT one function —
// a parameter, two different functions, a value the scan cannot name — is still dangerous and
// still counts.
function anonLeafAnyIndirectCall(): boolean {
  let ci = 0
  while ci < P.nodes.length {
    const cn = P.nodes[ci]
    if cn is Call {
      const cf = unwrapParen(cn.callFn)
      if cf < 0 { return true }
      const cfn = P.nodes[cf]
      if cfn is Ident {
        if anonLeafNameIsBound(cfn.identName) {
          if anonLeafCalleeFnName(cn.callFn) == "" {
            // D948 — a binding whose every write is a known function is ATTRIBUTABLE even
            // when it names more than one; `anonLeafCallMayTarget` reads it for each.
            const kn: string[] = []
            if !anonLeafFnValueNames(cfn.identName, kn) { return true }
          }
        }
      } else {
        return true
      }
    }
    ci = ci + 1
  }
  false
}

// D939 — THE ONE FUNCTION EVERY CALLER PASSES TO THE PARAMETER NAMED `nm`, or "".
//
// Deliberately narrow, because the name is all this is given and a name does not scope: it
// answers only when EXACTLY ONE `Param` in the program carries the name, so there is no
// question which parameter is meant, and when every call site of its owning function passes
// the SAME single function at that position. Anything else — two parameters sharing a name, a
// caller passing something that is not a plain function name, a call site whose arguments do
// not line up, or no call site at all — answers "" and refuses exactly as before.
const anonLeafParamFnBusy: string[] = []

function anonLeafParamFnTarget(nm: string): string {
  // D939 — THE RE-ENTRY GUARD, and it is not defensive: this asks
  // `anonLeafCalleeFnName` of every call site, which asks `anonLeafFnValueTarget`, which asks
  // THIS — a cycle with no call frame between the two hops for a depth cap to count. Without
  // it `d925_fn_value_param_callback` exhausted the COMPILER's own stack (measured: a trap
  // inside the compiler, not a refusal). Exactly D934's lesson one resolver over, and the
  // second time this file has paid it, so the guard is minted at the entry rather than
  // threaded through the callee.
  let bi = 0
  while bi < anonLeafParamFnBusy.length {
    if anonLeafParamFnBusy[bi] == nm { return "" }
    bi = bi + 1
  }
  anonLeafParamFnBusy.push(nm)
  const ans = anonLeafParamFnTargetGo(nm)
  anonLeafParamFnBusy.pop()
  ans
}

function anonLeafParamFnTargetGo(nm: string): string {
  // The unique `Param` with this name, and the declaration that owns it.
  let pIx = 0 - 1
  let owner = 0 - 1
  let pos = 0 - 1
  let seen = 0
  let fi = 0
  while fi < P.nodes.length {
    const fd = P.nodes[fi]
    if fd is FuncDecl {
      let pj = 0
      while pj < fd.fnParams.length {
        const pn = P.nodes[fd.fnParams[pj]]
        if pn is Param {
          if pn.parName == nm {
            seen = seen + 1
            pIx = fd.fnParams[pj]
            owner = fi
            pos = pj
          }
        }
        pj = pj + 1
      }
    }
    fi = fi + 1
  }
  if seen != 1 || pIx < 0 || owner < 0 || pos < 0 { return "" }
  const od = P.nodes[owner]
  if od is FuncDecl {
    if !anonLeafOneDeclNamed(od.fnName) { return "" }
    const pNames: string[] = []
    let pk = 0
    while pk < od.fnParams.length {
      const pnk = P.nodes[od.fnParams[pk]]
      if pnk is Param { pNames.push(pnk.parName) } else { pNames.push("") }
      pk = pk + 1
    }
    let hit = ""
    let hits = 0
    let ci = 0
    while ci < P.nodes.length {
      const cn = P.nodes[ci]
      if cn is Call {
        if anonLeafCalleeFnName(cn.callFn) == od.fnName {
          const slots = orderArgsByParamNames(
            pNames,
            cn.callArgs,
            cn.callArgNames,
          )
          if slots.length != pNames.length { return "" }
          if pos >= slots.length { return "" }
          const av = unwrapParen(slots[pos])
          if av < 0 { return "" }
          const avn = P.nodes[av]
          if avn is Ident {
            if !anonLeafOneDeclNamed(avn.identName) { return "" }
            if hits > 0 {
              if hit != avn.identName { return "" }
            }
            hit = avn.identName
            hits = hits + 1
          } else {
            return ""
          }
        }
      }
      ci = ci + 1
    }
    if hits == 0 { return "" }
    return hit
  }
  ""
}

// D940 — THE CLOSURE-TYPED SLOT A MOVED FUNCTION IS DELIVERED TO. See `anonLeafCloSlotFn`.
//
// Runs once the ret/param marks are final, so a function this asks about has already been
// moved or has not. Only a slot whose deliveries AGREE is marked: `anonLeafParamFnTarget`
// answers "" the moment two call sites hand the parameter different functions, and that is
// the same refusal `anonLeafSlotAllMembers` makes about a mixed slot — one parameter is one
// wasm signature, so it cannot be at two rows.
function anonLeafCloSlotMark() {
  let fi = 0
  while fi < P.nodes.length {
    const fd = P.nodes[fi]
    if fd is FuncDecl {
      let pj = 0
      while pj < fd.fnParams.length {
        const pIx = fd.fnParams[pj]
        const pn = P.nodes[pIx]
        if pn is Param {
          // The function-type gate is not an optimisation: `anonLeafParamFnTarget` is a
          // whole-arena scan per parameter, and asking it of every scalar parameter in the
          // program is the cost this walk cannot pay.
          if pn.parType >= 0 && tyIsFuncType(pn.parType) {
            const tgt = anonLeafParamFnTarget(pn.parName)
            if tgt != "" {
              if anonLeafFnNameMoved(tgt) {
                while anonLeafCloSlotFn.length <= pIx {
                  anonLeafCloSlotFn.push("")
                }
                anonLeafCloSlotFn[pIx] = tgt
              }
            }
          }
        }
        pj = pj + 1
      }
    }
    fi = fi + 1
  }
  0
}

// D940 — did the merge move any row of a function named `nm`? Either half counts: the
// `$fnsig` key is built from BOTH the parameter tokens and the result token, so a move on
// either side is a key the annotation cannot reproduce.
function anonLeafFnNameMoved(nm: string): boolean {
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is FuncDecl {
      if n.fnName == nm {
        if i < anonLeafRetMoved.length {
          if anonLeafRetMoved[i] == 1 { return true }
        }
        let pj = 0
        while pj < n.fnParams.length {
          const px = n.fnParams[pj]
          if px < anonLeafParamMoved.length {
            if anonLeafParamMoved[px] == 1 { return true }
          }
          pj = pj + 1
        }
      }
    }
    i = i + 1
  }
  false
}

// D948 — EVERY FUNCTION A BINDING MAY HOLD, or false when it may hold something else.
//
// `anonLeafFnValueTarget` answers only for a binding written with ONE function name, because
// its callers need A name. This answers the weaker question its callers actually need — "is
// the set of functions this call can reach FULLY KNOWN" — and a set of two known functions is
// as attributable as a set of one. `let f = src; if n > 0 { f = other }` is that set.
//
// A `Param` refutes here (its value is the caller's, and D939's resolver is the arm for that);
// so does a write that is not a plain identifier, or one naming something no single `FuncDecl`
// declares. Names are appended without dedup — every caller only asks membership.
function anonLeafFnValueNames(nm: string, out: string[]): boolean {
  let found = false
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is Param {
      if n.parName == nm { return false }
    }
    let w = 0 - 1
    if n is LetDecl {
      if n.letName == nm { w = unwrapParen(n.letInit) }
    }
    if n is BinExpr {
      if n.binOp == "=" {
        const tgt = unwrapParen(n.binLeft)
        if tgt >= 0 {
          const tn = P.nodes[tgt]
          if tn is Ident {
            if tn.identName == nm { w = unwrapParen(n.binRight) }
          }
        }
      }
    }
    if w >= 0 {
      const wn = P.nodes[w]
      if wn is Ident {
        if !anonLeafOneDeclNamed(wn.identName) { return false }
        out.push(wn.identName)
        found = true
      } else {
        return false
      }
    }
    i = i + 1
  }
  found
}

// D948 — COULD THIS CALL SITE REACH THE FUNCTION NAMED `fname`?
//
// The membership form of `anonLeafCalleeFnName == fname`, which every argument reader in this
// file was spelling. A call through a binding that may hold TWO known functions is a call site
// of BOTH, and reading it for only the one the binding happens to name first is how
// `d925_fn_value_two_targets` had a source no reader saw.
function anonLeafCallMayTarget(callFn: i32, fname: string): boolean {
  if fname == "" { return false }
  if anonLeafCalleeFnName(callFn) == fname { return true }
  const cf = unwrapParen(callFn)
  if cf < 0 { return false }
  const cfn = P.nodes[cf]
  if cfn is Ident {
    if anonLeafOneDeclNamed(cfn.identName) { return false }
    const names: string[] = []
    if !anonLeafFnValueNames(cfn.identName, names) { return false }
    let i = 0
    while i < names.length {
      if names[i] == fname { return true }
      i = i + 1
    }
  }
  false
}

// D948 — THE OTHER FUNCTIONS `nm` SHARES A BINDING WITH: their return rows are COUPLED to its.
//
// One binding holds one wasm signature. Moving `src`'s return row while `other`'s stays narrow
// gives `let f = src; f = other` two functions it cannot both hold — invalid wasm, and exactly
// what `d925_fn_value_two_targets` was. So a merge that moves one moves the whole set.
function anonLeafCoMoveFnRets(nm: string) {
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    let bn = ""
    if n is LetDecl { bn = n.letName }
    if n is BinExpr {
      if n.binOp == "=" {
        const tgt = unwrapParen(n.binLeft)
        if tgt >= 0 {
          const tn = P.nodes[tgt]
          if tn is Ident { bn = tn.identName }
        }
      }
    }
    if bn != "" {
      const names: string[] = []
      if anonLeafFnValueNames(bn, names) {
        let hasNm = false
        let j = 0
        while j < names.length {
          if names[j] == nm { hasNm = true }
          j = j + 1
        }
        if hasNm {
          let k = 0
          while k < names.length {
            if names[k] != nm { anonLeafMarkRetMoved(names[k]) }
            k = k + 1
          }
        }
      }
    }
    i = i + 1
  }
  0
}

// D925 — THE FUNCTION A CALL'S CALLEE POSITION NAMES, through at most one binding hop, or "".
//
// A bare identifier that a `FuncDecl` declares is itself; otherwise the identifier is a value,
// and it names a function only when EVERY write to it is that same function's name. One hop and
// no more: `const g = f` where `f` is itself a binding is a chain this does not follow, and it
// answers "" so both callers refuse exactly as they do today.
function anonLeafCalleeFnName(callFn: i32): string {
  const cf = unwrapParen(callFn)
  if cf < 0 { return "" }
  const cfn = P.nodes[cf]
  if cfn is Ident {
    if anonLeafOneDeclNamed(cfn.identName) { return cfn.identName }
    return anonLeafFnValueTarget(cfn.identName)
  }
  ""
}

// D925 — THE ONE FUNCTION NAME `nm` IS EVER BOUND TO, or "". A `Param` named `nm` refutes
// outright: its value is whatever the caller passed, which is not at any write this can read.
function anonLeafFnValueTarget(nm: string): string {
  let hit = ""
  let hits = 0
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is Param {
      // D939 — A CALLBACK PARAMETER IS RESOLVABLE WHEN ITS OWN CALL SITES AGREE, which is
      // D891's rung one frame further out: a parameter's sources are the ARGUMENTS at every
      // call site of the function that declares it. The sentence this replaces read "a `Param`
      // named `nm` refutes outright: its value is whatever the caller passed" — true of a
      // parameter in general, and not of one whose every caller passes the same function name.
      if n.parName == nm { return anonLeafParamFnTarget(nm) }
    }
    let w = 0 - 1
    if n is LetDecl {
      if n.letName == nm { w = unwrapParen(n.letInit) }
    }
    if n is BinExpr {
      if n.binOp == "=" {
        const tgt = unwrapParen(n.binLeft)
        if tgt >= 0 {
          const tn = P.nodes[tgt]
          if tn is Ident {
            if tn.identName == nm { w = unwrapParen(n.binRight) }
          }
        }
      }
    }
    if w >= 0 {
      const wn = P.nodes[w]
      if wn is Ident {
        if !anonLeafOneDeclNamed(wn.identName) { return "" }
        if hits > 0 {
          if hit != wn.identName { return "" }
        }
        hit = wn.identName
        hits = hits + 1
      } else {
        return ""
      }
    }
    i = i + 1
  }
  if hits == 0 { return "" }
  hit
}

// D911 — IS `nm` BOUND TO A VALUE anywhere in the program (a `LetDecl` or a `Param`)? The
// cheap half of the indirect-call test above; a function DECLARATION is not a binding here,
// which is the whole distinction it draws.
function anonLeafNameIsBound(nm: string): boolean {
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is LetDecl {
      if n.letName == nm { return true }
    }
    if n is Param {
      if n.parName == nm { return true }
    }
    i = i + 1
  }
  false
}

// Is the arena node `n` the CALLEE position of some call? The reverse of `Call.callFn`, asked
// of an identifier so `anonLeafParamArgsOk` can tell `src(x)` from `const f = src`.
function anonLeafIsCalleePos(n: i32): boolean {
  let ci = 0
  while ci < P.nodes.length {
    const cn = P.nodes[ci]
    if cn is Call {
      if unwrapParen(cn.callFn) == n { return true }
    }
    ci = ci + 1
  }
  false
}

// The subtree scan behind `anonLeafRetIdentOk`: every `const nm = …` and every `nm = …` in this
// frame. A NESTED function declaration is skipped — its `nm` is a different binding.
function anonLeafBindScan(
  ix: i32,
  nm: string,
  body: i32,
  out: i32[],
  hits: i32[],
  fns: string[],
  pars: i32[],
  depth: i32,
  ids: string[],
): boolean {
  if ix < 0 { return true }
  const n = P.nodes[ix]
  if n is FuncDecl { return true }
  if n is LetDecl {
    if n.letName == nm {
      if (
        !anonLeafBoundValOk(n.letInit, body, out, hits, fns, pars, depth, ids)
      ) {
        return false
      }
    }
  }
  if n is BinExpr {
    if n.binOp == "=" {
      const tgt = unwrapParen(n.binLeft)
      if tgt >= 0 {
        const tn = P.nodes[tgt]
        if tn is Ident {
          if tn.identName == nm {
            if (
              !anonLeafBoundValOk(
                n.binRight,
                body,
                out,
                hits,
                fns,
                pars,
                depth,
                ids,
              )
            ) {
              return false
            }
          }
        }
      }
    }
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if !anonLeafBindScan(kids[i], nm, body, out, hits, fns, pars, depth, ids) {
      return false
    }
    i = i + 1
  }
  true
}

// ONE value written to a returned binding. The same three-way split `anonLeafRetPathOk` makes of
// a returned expression: a literal is a member, a `null` is neither, a CALL is the next frame,
// anything else refutes. The call arm is D882 and D883 composed — `{ const v = mid(); v }` is a
// binding whose value is a callee's return, and reading one without the other left
// `d886_ret_binding_of_call` check-clean invalid wasm.
//
// D911 — AND AN IDENTIFIER is the same resolver one name over: `{ const v = p; v }` binds a
// PARAMETER, whose sources are the arguments at every call site (D891), and `{ const v = w; v }`
// binds another local, whose sources are its own writes. Both were `false` here, so D882's
// binding arm and D891's parameter arm could not compose and `d894_ret_binding_of_param` was
// check-clean invalid wasm. `body` is threaded in for exactly this: a name resolves against the
// frame that returned it, and that is the argument `anonLeafCalleeRets` already carries.
function anonLeafBoundValOk(
  rhs: i32,
  body: i32,
  out: i32[],
  hits: i32[],
  fns: string[],
  pars: i32[],
  depth: i32,
  ids: string[],
): boolean {
  const v = unwrapParen(rhs)
  if v < 0 { return false }
  const vn = P.nodes[v]
  if vn is NullLit {
    hits.push(v)
    return true
  }
  if vn is ObjLit {
    out.push(v)
    hits.push(v)
    return true
  }
  if vn is Call {
    if !anonLeafCalleeRead(vn.callFn, out, fns, pars, depth + 1) {
      return false
    }
    hits.push(v)
    return true
  }
  // D953 — A FIELD READ OF A PARAMETER, projected through the parameter's own call sites.
  //
  // D923 built this reader, measured it, and DELETED it — correctly, because a reader without
  // its owner moves a return row while the value handed back is still built narrow. The owner
  // is now here (`anonMintRowFor`'s nested-field companion name), so the pair ships together,
  // which is D891's precedent stated as a rule.
  //
  // THE BASE IS READ INTO A SCRATCH, and that is the whole care in this arm. The base literal
  // (`{ r: { r: 7 } }`) does NOT itself move — only the field it carries does — so its owners
  // must not be published into `out`, or a slot moves with no member behind it. `bOut` is
  // discarded; only the PROJECTION reaches the family.
  if vn is Member {
    const mo = unwrapParen(vn.memObj)
    if mo >= 0 {
      const mon = P.nodes[mo]
      if mon is Ident {
        const pIx = anonLeafParamNodeOf(body, mon.identName)
        if pIx >= 0 {
          // THE OWNERS GO TO A SCRATCH, THE PARAMS DO NOT. D923's caution is about `out`:
          // the base literal itself does not move, so publishing its owners would move a slot
          // with no member behind it. The PARAM is the opposite case — its slot has to follow
          // the carrier's new row (`paramStructIdxFinal` redirects only a MARKED param), and
          // that is D923's third rung. So `bOut` is discarded and `pars` is the caller's.
          const bOut: i32[] = []
          const bFns: string[] = []
          if !anonLeafParamArgsOk(body, pIx, bOut, bFns, pars, depth) {
            return false
          }
          pars.push(pIx)
          let ai2 = 0
          while ai2 < bOut.length {
            const al = P.nodes[bOut[ai2]]
            if al is ObjLit {
              let found = 0 - 1
              let fj = 0
              while fj < al.objFields.length {
                const fn2 = P.nodes[al.objFields[fj]]
                if fn2 is FieldInit {
                  if fn2.fiName == vn.memProp {
                    found = unwrapParen(fn2.fiValue)
                  }
                }
                fj = fj + 1
              }
              if found < 0 { return false }
              const fv = P.nodes[found]
              if fv is ObjLit { out.push(found) }
              else if fv is NullLit { 0 }
              else { return false }
            } else {
              return false
            }
            ai2 = ai2 + 1
          }
          hits.push(v)
          return true
        }
      }
    }
    return false
  }
  if vn is Ident {
    // D934 — a MODULE-SCOPE binding has no frame, and `anonLeafRetIdentOk` resolves against a
    // frame's bindings and parameter list. The by-name whole-arena scan is the right scope for
    // that name, so it answers here instead of refuting.
    if body < 0 {
      if !anonLeafArgIdentSeen(vn.identName, out, fns, pars, depth, ids) {
        return false
      }
      hits.push(v)
      return true
    }
    if !anonLeafRetIdentOk(vn.identName, body, out, fns, pars, depth, ids) {
      return false
    }
    hits.push(v)
    return true
  }
  false
}

// The body block's LAST statement, which carries the implicit return. A statement in that
// position is not a value at all (the function's returns are then its `return`s alone), so it
// is skipped rather than refuted; anything that IS an expression goes through
// `anonLeafRetPathOk`.
function anonLeafTailPathOk(
  ix: i32,
  out: i32[],
  body: i32,
  fns: string[],
  pars: i32[],
  depth: i32,
): boolean {
  if ix < 0 { return true }
  const n = P.nodes[ix]
  if n is LetDecl { return true }
  if n is RetStmt { return true }
  if n is IfStmt { return true }
  if n is WhileStmt { return true }
  if n is ForRange { return true }
  if n is ForIn { return true }
  if n is Block { return true }
  if n is FuncDecl { return true }
  anonLeafRetPathOk(ix, out, body, fns, pars, depth)
}

// One `lhs = rhs` statement: append `rhs` to `mem` when it is an object literal stored into
// `name[…]`. Split out so the container scan above reads as one question.
function anonLeafJoinStore(lhs: i32, rhs: i32, name: string, mem: i32[]) {
  const tgt = unwrapParen(lhs)
  if tgt < 0 { return 0 }
  const tn = P.nodes[tgt]
  if tn is Index {
    const tb = unwrapParen(tn.idxArr)
    if tb >= 0 {
      const tbn = P.nodes[tb]
      if tbn is Ident {
        if tbn.identName == name {
          const rv = unwrapParen(rhs)
          if rv >= 0 {
            const rn = P.nodes[rv]
            if rn is ObjLit {
              let seen = false
              let i = 0
              while i < mem.length {
                if mem[i] == rv { seen = true }
                i = i + 1
              }
              if !seen { mem.push(rv) }
            }
          }
        }
      }
    }
  }
  0
}

// D833 — IS LITERAL `n` ONE OF A `??`'s JOINED VALUES? The O(1) read of the mark pass's answer.
function anonLeafInJoin(n: i32): boolean {
  if n < 0 { return false }
  if n >= anonLeafJoined.length { return false }
  anonLeafJoined[n] == 1
}

// D833 — THE ROW `n`'s `??` FAMILY was already claimed by, or -1. See `anonLeafFamRow`.
function anonLeafFamRowOf(n: i32): i32 {
  if n < 0 { return 0 - 1 }
  if n >= anonLeafFamRow.length { return 0 - 1 }
  anonLeafFamRow[n]
}

// D953 — THE FIELD at which `ow`'s own nested value is a `??` family member whose row has
// MOVED, or "". The carrier's half of `anonLeafMergeField`: that one asks whether the literal's
// row is narrower than the join the literal belongs to, and answers "" for a literal that
// belongs to no join. A carrier belongs to none — `{ r: { r: 7 } }` is not a `??` operand — and
// still has to follow, because the inner literal it holds is a member and builds at the merged
// row now.
function anonLeafNestedMergedField(ow: i32): string {
  const o = P.nodes[ow]
  if o is ObjLit {
    let i = 0
    while i < o.objFields.length {
      const f = P.nodes[o.objFields[i]]
      if f is FieldInit {
        const fv = unwrapParen(f.fiValue)
        if fv >= 0 {
          const fvn = P.nodes[fv]
          if fvn is ObjLit {
            if anonLeafInJoin(fv) {
              const ns = structIndexOfObj(fv)
              if ns >= 0 {
                if anonLeafSupersedeOf(ns) != ns { return f.fiName }
              }
            }
          }
        }
      }
      i = i + 1
    }
  }
  ""
}

// D833 — THE FIELD at which the row `narrowSi` already claiming `ow` is NARROWER than the `??`
// join `ow` belongs to, or "" when there is no such field. This is the whole of the new mint
// gate AND of the supersede's trigger: the literal matched a row, that row's leaf is not a box
// over the join's atoms, and D804's rung therefore has a merged row to reach that the
// `structIndexOfObj(ow) >= 0` skip was hiding.
//
// ASKED ONLY OF A CLAIMED LITERAL. An unclaimed one reaches `anonMintRowFor` on the gate's first
// disjunct exactly as it always did, so nothing here can change what that literal mints.
function anonLeafMergeField(ow: i32, narrowSi: i32): string {
  if narrowSi < 0 { return "" }
  if !anonLeafInJoin(ow) { return "" }
  const o = P.nodes[ow]
  if o is ObjLit {
    let i = 0
    while i < o.objFields.length {
      const f = P.nodes[o.objFields[i]]
      if f is FieldInit {
        if anonNestPolyUnionName(ow, f.fiName, unwrapParen(f.fiValue)) == "" {
          const set = anonLeafPolyUnionSetOpen(ow, f.fiName, f.fiValue)
          if set != "" {
            // THE MERGED ROW MAY ALREADY EXIST — a second `??` family over the same field set,
            // or the DECLARED spelling of the shape. Then there is nothing to mint and the only
            // thing owed is the redirect.
            const serv = anonLeafServingRow(ow, f.fiName, set)
            if serv >= 0 {
              anonLeafRecordSupersede(narrowSi, serv)
              // D881 — AND THE CARRIER'S ROW, which the post-mint rung below can no longer
              // reach because THIS family does not mint. `collectAnonShapes` records the
              // carrier supersede (D873) only where the mint really appended a row; a SECOND
              // `??` family over the same field set finds the merged row already standing,
              // takes this branch, and its carrier is left pointing at a row nobody merged.
              // Two competing same-fieldset rows are what make that visible: with one row the
              // carrier IS `narrowSi` and the line above already covered it. See D881.
              anonLeafRecordSupersede(anonLeafCarrierRowOf(ow), serv)
              return ""
            }
            return f.fiName
          }
        }
      }
      i = i + 1
    }
  }
  ""
}

// D872 — THE FIELD at which `ow`'s OWN mint carries a merged box, or "".
//
// `anonLeafMergeField` asks a narrower question — the field at which a row ALREADY CLAIMING
// this literal is narrower than its join needs — and so starts from `narrowSi >= 0`. A default
// whose atom no row can hold (`{r: "s"}` beside a `{r: i32}` row) is claimed by nothing, mints
// on the gate's FIRST disjunct, and still comes out carrying the box. That mint owes the
// carrier's row a supersede exactly as a claimed one does, and this is the predicate that says
// so without the precondition.
function anonLeafMergedFieldOf(ow: i32): string {
  if !anonLeafInJoin(ow) { return "" }
  const o = P.nodes[ow]
  if o is ObjLit {
    let i = 0
    while i < o.objFields.length {
      const f = P.nodes[o.objFields[i]]
      if f is FieldInit {
        if anonNestPolyUnionName(ow, f.fiName, unwrapParen(f.fiValue)) == "" {
          if anonLeafPolyUnionSetOpen(ow, f.fiName, f.fiValue) != "" {
            return f.fiName
          }
        }
      }
      i = i + 1
    }
  }
  ""
}

// D833 — ROW `mergedSi` SUPERSEDES `narrowSi` AS A MAP'S VALUE. See `anonLeafSupersede`.
function anonLeafRecordSupersede(narrowSi: i32, mergedSi: i32) {
  if narrowSi < 0 || mergedSi < 0 { return 0 }
  if narrowSi == mergedSi { return 0 }
  while anonLeafSupersede.length <= narrowSi { anonLeafSupersede.push(0 - 1) }
  anonLeafSupersede[narrowSi] = mergedSi
  0
}

// Mint ONE anonymous struct row for the object literal at `objIx`. The body of
// `collectAnonShapes`' main loop, extracted so RUNG N's pre-pass mints a row the SAME
// way rather than through a second copy of it — two mints that disagree would put two
// different layouts under one `#anonN` key.
function anonMintRowFor(objIx: i32) {
  const an = P.nodes[objIx]
  if an is ObjLit {
    const ai = objIx
    const fields = an.objFields
    // Does this literal carry a FUNCTION-valued field? An operator/index
    // TRAP MAKER (`{ "*": fn, x: x, y: y }`) mixes closures with plain
    // ident fields — classify the idents as i32 there (the host types them
    // exactly; a mis-typed non-i32 binding fails loudly at the validator).
    // A literal with NO function field keeps idents unclassifiable, so a
    // generic's structural-return literal (`{ first: b, second: a }`) stays
    // un-interned here and matches its instance-pinned ANNOTATION shape.
    let hasFnField = false
    let ffi = 0
    while ffi < fields.length {
      const ff = P.nodes[fields[ffi]]
      if ff is FieldInit {
        // (Direct node checks, not `fieldValueFeOf` — `fnStmts` is not yet
        // populated when `collectS`/`collectAnonShapes` run.)
        const fv = P.nodes[ff.fiValue]
        if fv is FuncDecl { hasFnField = true }
        if fv is Ident {
          if nameNamesFunction(fv.identName) { hasFnField = true }
        }
      }
      ffi = ffi + 1
    }
    const codes: i32[] = []
    const names: string[] = []
    const elemNames: string[] = []
    const elemKeys: boolean[] = []
    let ok = true
    let fi = 0
    while fi < fields.length {
      const f = P.nodes[fields[fi]]
      if f is FieldInit {
        let code = anonFieldCode(f.fiValue)
        // THE JOINED OWNER'S FIELD IS A UNION BOX, NOT A NESTED REF (D672). Where two
        // owner literals disagree at a nested field AND something joins them into one
        // value, the field's code is 16 and its companion name is the declared union — the
        // row `type Circle = { r: Shape2 }` would have declared, minted because nobody
        // declared it. `anonNestPolyUnionName` carries the whole gate and answers "" for
        // every other literal, so this is inert outside the shape it names.
        const boxU = anonNestPolyUnionName(ai, f.fiName, unwrapParen(f.fiValue))
        if boxU != "" { code = 16 }
        // THE LEAF TWIN (D804): the same join, one layer down — two `??`-joined
        // same-fieldset literals disagreeing at a SCALAR field need the merged row too, and
        // there the union is the two values' own atoms rather than a declared one, so the
        // CODE comes from the merged spelling instead of being 16 by construction.
        let leafSet = ""
        let leafCode = -1
        if boxU == "" {
          leafSet = anonLeafPolyUnionSet(ai, f.fiName, f.fiValue)
          if leafSet != "" {
            leafCode = anonLeafPolyFieldCode(leafSet)
            if leafCode >= 0 { code = leafCode }
          }
        }
        if code < 0 && hasFnField {
          const iv = P.nodes[f.fiValue]
          if iv is Ident {
            if !nameNamesFunction(iv.identName) { code = 0 }
          }
        }
        if code < 0 { ok = false }
        codes.push(code)
        names.push(f.fiName)
        if boxU != "" {
          elemNames.push(boxU)
        } else if leafCode == 16 {
          elemNames.push(leafSet) // the box's member set
        } else if leafCode == 30 {
          // D884 — the `K | null` niche records the NON-NULL alias, the same companion
          // `fieldRecElemName`'s code-30 arm gives the declared twin: `sFieldIsLitUnion`
          // recovers the atom rep and the membership off this column, and a `""` here
          // would leave the field an i32 slot with no atom table behind it.
          elemNames.push(nulLitUnionInnerName(leafSet))
        } else if leafCode >= 0 {
          elemNames.push("") // a bare niche (code 20) records no companion
        } else {
          // D953 — A NESTED FIELD WHOSE VALUE IS A `??` FAMILY MEMBER NAMES THE MERGED ROW.
          //
          // Two arms above already handle a joined nested field: D672 where two OWNER
          // literals disagree at it, and D804's leaf twin where the joined literals disagree
          // at a SCALAR. This is the third and the one neither reaches — ONE owner whose
          // field VALUE is itself a member of a `??` family, which is `{ r: { r: 7 } }`
          // flowing into `src(): {r: i32} | null` beside `?? { r: "s" }`.
          //
          // The companion name is what `sFieldTgtStructIdx` later resolves the field's target
          // row from, so naming the narrow row here is what made the call site build
          // `struct.new $outer (struct.new $inner_i32 …)` while `src`'s result had already
          // moved to the merged row. D923 recorded the reader for this and DELETED it because
          // "the owner is one layer out"; the owner is this line.
          //
          // NOT A REDIRECT AT `sFieldTgtStructIdx`, which D923 measured and rejected: that is
          // the one home for every nested-struct field's target, so superseding there moves
          // EVERY `{r: i32}`-typed nested field in the program, including a second
          // `{r: {r: 3}}` whose inner is no family member. Naming it per LITERAL, at the mint
          // that is already building this literal's own row, is the same answer scoped to the
          // one owner that earned it.
          let nestNm = anonFieldElemName(f.fiValue, code)
          if code == 15 {
            const nv = unwrapParen(f.fiValue)
            if anonLeafInJoin(nv) {
              const narrowSi = structIndexOfObj(nv)
              const mergedSi = anonLeafSupersedeOf(narrowSi)
              if mergedSi >= 0 && mergedSi != narrowSi {
                if mergedSi < sNames.length { nestNm = sNames[mergedSi] }
              }
            }
          }
          elemNames.push(nestNm)
        }
        elemKeys.push(anonFieldElemKeyI32(f.fiValue, code))
      } else {
        ok = false
      }
      fi = fi + 1
    }
    if ok && codes.length > 0 {
      sDeclared = true
      // A synthetic UNIQUE name (the `#` prefix can never collide with a user
      // identifier or annotation) — a real key, so a ref LIST of this element
      // shape interns a per-element-type slot (`rlInternName` treats the empty
      // string as its "not a ref element" sentinel). An `#anon` name never resolves
      // through the checker's annotation grammar, so `slotCanonId` cannot key it
      // off the name: the D0 arena-index sidecar records the literal's
      // CONTEXT-RESOLVED type index instead, and the key is derived at QUERY time so
      // it follows later arena mutation rather than freezing a render at intern time.
      sNames.push("#anon" + i32ToStr(sNames.length))
      recordSRowDeclOfName(sNames[sNames.length - 1])
      recordSTyIx(anonRowTyIx(ai))
      sFieldStart.push(sFieldNames.length)
      sFieldCount.push(codes.length)
      // THE CANONICAL FIELD ORDER (D622) — see `fieldNameOrder`. An `#anon` row's own
      // dedup (`anonRowMatches`/`anonValueFitsField`) is field-NAME keyed, so only the
      // emitted SEQUENCE moves; and an anon row that shares a declared row's shape now
      // shares its sequence too, which is the merge this ordering exists to make possible.
      const aOrd = fieldNameOrder(names)
      let pj = 0
      while pj < codes.length {
        const pi = aOrd[pj]
        sFieldNames.push(names[pi])
        sFieldTypes.push(codes[pi])
        sFieldElemName.push(elemNames[pi])
        // B6b: an anonymous literal's MAP field (code 19) carries a real key column —
        // an mv slot's identity is the (KEY, VALUE) pair, and both halves come off the
        // checker's recorded type since the literal has no annotation to read.
        recordSFieldElemRow(elemNames[pi], elemKeys[pi]) // D5
        // A function-valued field (code 14) interns a closure cell `(ref
        // $cloStruct)`; flag the module so the closure rec-group types are
        // emitted even when no lambda is otherwise lifted (e.g. a top-level
        // function used purely as a struct-field value, `{ f: inc }`).
        if codes[pi] == 14 { fnValUsed = true }
        // (A code-4 i32-list field always rides an ArrayLit value, which the
        // later `collectA` arena scan classifies — `lUsed`/`aUsed` set there.)
        pj = pj + 1
      }
      // A value-union field interns its box reps — the same parity rule `pushFieldRow`
      // states for the three DECLARED recorders, which this mint does not route through.
      // D672's `boxU` is a declared union `collectU` already registered; D804's LEAF set
      // (`i32|null`) is named nowhere else in the program, so without this the field's
      // per-rep value boxes are never interned and the construct `struct.new`s a raw scalar
      // where the box `(ref)` is required. AFTER the row loop, because registration can push
      // rows of its own into the union tables.
      let rj = 0
      while rj < codes.length {
        if codes[rj] == 16 { registerValueUnionName(elemNames[rj]) }
        rj = rj + 1
      }
    }
  }
  0
}

// RUNG N (D391) — MINT THE NESTED ROWS OF A *POLYMORPHIC* OWNER FIELD SET FIRST.
//
// THE DEFECT IS A CIRCULARITY, AND THE DISCRIMINATOR IT STARVES ALREADY EXISTS.
// `anonValueFitsField` already refuses to merge two same-fieldset literals whose code-15
// field points at DIFFERENT targets — that is its `vc == 15 && anonRow` arm. But that arm
// can only refute when BOTH target names are known, and a target name is
// `anonFieldElemName` → `sNames[structIndexOfObj(inner)]`, which is "" for a nested literal
// that has no row yet. So:
//
//   · `p = { r: { c2: 1 } }` is visited first; its nested `{c2:1}` gets `#anon0` and its
//     owner gets `#anon1` recording `r`'s target as `#anon0`.
//   · `q = { r: { s2: 1 } }`'s nested is visited next. `anonNestNeedsRow` asks
//     `structIndexOfObj(ow) >= 0` of q's OWNER — and q's owner already matches `#anon1`,
//     because q's nested has no row, so `anonFieldElemName` is "" and the code-15 arm
//     stays LENIENT. The nested literal is therefore skipped, which is what keeps its
//     name "" — the circle closes on itself.
//
// The result is `q`'s owner sharing `p`'s row and building `(struct.new $uBox …)` into a
// field typed `(ref null $anon0)` — check-clean INVALID WASM, which is why
// `anonNestFieldMono` declines the whole rung instead and the pair stays a loud reject.
//
// BREAKING THE CIRCLE NEEDS ORDER, NOT A NEW DISCRIMINATOR. Mint the nested rows of BOTH
// literals BEFORE any owner row exists; then both target names are known when the owner
// scan runs, the existing code-15 arm refutes, and each owner gets its OWN row. Measured:
// with no union declared at all the two owners ALREADY get separate rows today
// (`(ref null $1)` and `(ref null $2)` in the disassembly) — the union case differs only
// in that the arm-claimed nested literals are minted late.
//
// SCOPED TO EXACTLY THE CASE `anonNestFieldMono` DECLINES, which is what keeps the blast
// radius equal to the price this rung is paid out of. Where that condition HOLDS this
// pre-pass mints nothing, the main loop's `#anonN` numbering is untouched, and the module
// is byte-identical — verified by `cmp` over the corpus.
function anonNestPolyPremint(nestOwner: i32[]) {
  let xi = 0
  while xi < P.nodes.length {
    const xn = P.nodes[xi]
    if xn is ObjLit {
      // Only an ARM-CLAIMED nested literal — one the main loop would skip — and only
      // where the owner is a would-be anonymous row that this literal's absence would
      // otherwise absorb into a sibling's.
      if structIndexOfObj(xi) < 0 && objVariantName(xi) != "" {
        const ow = anonNestOwnerOf(xi, nestOwner)
        if ow >= 0 && structIndexOfObj(ow) < 0 && objVariantName(ow) == "" {
          const fname = anonNestFieldNameOf(ow, xi)
          // The POLYMORPHIC trigger, asked as the exact negation of the condition that
          // declines today: a sibling owner shares the field-name set and disagrees about
          // the nested layout. Both literals then need a row, and neither can borrow one.
          // …EXCEPT WHERE THE OWNERS ARE JOINED AND THE FIELD IS NOW A BOX (D672). Two
          // rows are the right answer for two SEPARATE owners; they are the wrong one for
          // a pair that has to be ONE value, and this rung's own header says so ("one mv
          // slot cannot hold two owner reps"). With the field coded 16 the nested literal
          // must NOT get an anonymous row — this rung's mint is what `emitObjLitNode`'s
          // `structIndexOfObj` arm would then claim, building a bare struct where a
          // `{tag, value}` box is expected.
          if (
            fname != "" &&
            !anonNestFieldMono(ow, fname, xi) &&
            anonNestPolyUnionName(ow, fname, xi) == ""
          ) {
            anonMintRowFor(xi)
          }
        }
      }
    }
    xi = xi + 1
  }
  0
}

// THE DECLARED UNION AN OWNER FIELD'S POLYMORPHIC NESTED VALUES ARE ARMS OF (D672), or ""
// when this literal is not that shape. When it answers, the owner's field is coded 16 (the
// union box) over that union.
//
// THE PROGRAM IS LEGAL AND ITS ROW ALREADY EXISTS — SOMEONE JUST HAS TO DECLARE IT. Add one
// line to the 16 census cells this closes and they run on master:
//
//     type Cir2 = { c2: i32 }        const c = Map()
//     type Sq2  = { s2: i32 }        c["k0"] = { r: { c2: 1 } }
//     type Shape2 = Cir2 | Sq2       const g = c["k0"] ?? { r: { s2: 1 } }
//     type Circle = { r: Shape2 }    if g.r is Cir2 { print(7) } else { print(0) }
//         ^ delete this line and it was `object literal is missing a struct field`
//
// That is silent-class-inventory D210, filed as a REFUTATION PIN and still running. With
// `Circle` declared, `structIndexOfObj` adopts BOTH literals onto its row, whose `r` is a
// box, and `emitObj` boxes each nested literal as its arm. Without it, `collectAnonShapes`
// gives each owner its own row with a MONOMORPHIC `r`, the map's value slot picks the
// first, and the `??` default is then lowered against a row whose `r` targets `{c2:i32}` —
// so `emitObj` reported a field the user never wrote. This mints the row `Circle` would
// have been.
//
// FOUR GATES, AND THE LAST ONE IS THE ONE THAT COSTS SOMETHING. Arm-claimed nested literal,
// no row of its own, the owner field POLYMORPHIC (`anonNestFieldMono` false — the exact
// condition D391's premint fires on), and the owners JOINED. Without the join gate this
// takes D391's `anon-nested-arm-layout-polymorphic.vl` from `runs` to
// `emitProgram: field access receiver is not a struct` — measured, a corpus module lost —
// because two SEPARATE owners read monomorphically (`p.r.c2`) need their own rows and a
// boxed field costs that read its receiver.
function anonNestPolyUnionName(ow: i32, fname: string, inner: i32): string {
  if inner < 0 { return "" }
  const iv = P.nodes[inner]
  if !(iv is ObjLit) { return "" }
  if structIndexOfObj(inner) >= 0 { return "" }
  const armNm = objVariantName(inner)
  if armNm == "" { return "" }
  if anonNestFieldMono(ow, fname, inner) { return "" }
  if !anonPolyOwnersJoined(ow, fname, inner) { return "" }
  const vi = variantIndexOf(armNm)
  if vi < 0 { return "" }
  let ui = 0
  while ui < unNames.length {
    if vi >= unVarStart[ui] && vi < unVarStart[ui] + unVarCount[ui] {
      return unNames[ui]
    }
    ui = ui + 1
  }
  ""
}

// ── the LEAF twin of the nested polymorphic rung (D804) ──────────────────────
// The ATOM SPELLING of an anonymous literal's LEAF field value — the member name it would
// carry inside a value union — or "" for a value this rung cannot name (a nested literal, a
// list, a map, a closure, an ident, a call). Deliberately narrow: it is a REFUTATION input,
// so anything unnameable declines the whole rung and keeps today's behaviour.
function anonLeafAtomName(valIx: i32): string {
  if valIx < 0 { return "" }
  const vi = unwrapParen(valIx)
  const v = P.nodes[vi]
  if v is NullLit { return "null" }
  const c = anonFieldCode(valIx)
  if c == 0 {
    // Code 0 folds booleans and integers together; the union needs them apart.
    if isBoolLitExpr(vi) { return "boolean" }
    return "i32"
  }
  if c == 3 { return "string" }
  if c == 17 { return "f64" }
  if c == 23 { return "i64" }
  if c == 24 { return "f32" }
  ""
}

// ARE THE LEAF OWNERS JOINED INTO ONE VALUE (D804)? The scalar twin of
// `anonPolyOwnersJoined`, and the same test for the same reason: a `??` makes its two
// operands ONE value, so a pair that disagrees at a field cannot keep two rows and the box
// is the only rep they share. Two literals that merely both exist are D391's shape — each
// read monomorphically, two rows the right answer — which is why the gate is on the JOIN.
function anonLeafOwnersJoined(ow: i32, fname: string, owAtom: string): boolean {
  let qi = 0
  while qi < P.nodes.length {
    const qn = P.nodes[qi]
    if qn is BinExpr {
      if qn.binOp == "??" {
        const d = unwrapParen(qn.binRight)
        // This literal IS the `??` default: whatever the other operand's shape came from
        // (a map value, a binding, a call), the coalesce has to deliver one row.
        if d == ow { return true }
        if d >= 0 {
          const dn = P.nodes[d]
          if dn is ObjLit {
            if anonObjFieldSetEq(d, ow) {
              if anonLeafAtomName(objFieldVal(d, fname)) != owAtom {
                return true
              }
            }
          }
        }
      }
    }
    qi = qi + 1
  }
  false
}

// THE VALUE-UNION MEMBER SET a `??`-JOINED family of same-field-set anonymous literals needs
// at the LEAF field `fname` (D804), or "" when this literal is not that shape. When it
// answers, the field is coded 16 over that set — the row `type Circle = { r: i32 | null }`
// would have declared, minted because nobody declared it.
//
// THE SAME DEFECT AS D672, ONE LAYER DOWN, AND ITS NULL CORNER IS THE ONLY LOUD ONE.
// `structIndexOfObj` matches a literal to a row by field-NAME set, so two same-fieldset
// literals merge and the loser's value is written through the WINNER's valtype. Ablated over
// the field VALUE PAIR of `c["k0"] = {r: A}` / `?? {r: B}`, master gives:
//
//     A=i32  B=null                      loud `bare null needs a struct-typed context`
//     A=string / boolean / f64  B=null    the same loud reject
//     A=null B=i32                       the same loud reject
//     A=i32  B=string   CHECK-CLEAN INVALID WASM  `expected i32, found (ref $type)`
//     A=i32  B=f64      CHECK-CLEAN INVALID WASM  `expected i32, found f64`
//     A=string B=i32    CHECK-CLEAN INVALID WASM  `expected (ref $type), found i32`
//     A=i32  B=i32      runs (the control)
//
// So the filed sentence was the NULL corner of a wider family: with `null` the loser has no
// rep at all and the reject is loud (`anonValueFitsField`'s `vc < 0` leniency merges the
// pair), while with a DIFFERENT scalar rep `anonValueFitsField` refutes, each literal gets
// its own row, and the `??` then joins two heap types — silent. One merged row closes both
// halves, which is why the set is built from EVERY same-fieldset sibling's atom rather than
// only the null one.
//
// EVERY SIBLING'S ATOM, not just the joined pair's, because a code-16 field accepts every
// atom by construction (`anonValueFitsField`'s `sc == 16` arm) — so once the field is a box
// each same-fieldset literal lands on this row and must be a member of its union.
//
// FOUR GATES, matching the nested rung's: an anonymous owner (no declared row, no variant
// claim), every field value NAMEABLE as an atom, at least two DISTINCT atoms, and the family
// JOINED by a `??`. Where any fails this answers "" and the mint is byte-identical.
function anonLeafPolyUnionSet(ow: i32, fname: string, val: i32): string {
  // D833 — A LITERAL A ROW ALREADY CLAIMS ASKS THE QUESTION TOO, when a `??` names it. Before
  // D833 this rung ended here: "a sibling a DECLARED row already claims never lands here — and
  // if one did, this literal would have matched that row too and no mint would be running."
  // Exactly true, and exactly the defect — an unused three-line `type R = {r: i32}` makes BOTH
  // operands match it, so nothing mints. The gate still ends the rung for a literal the JOIN
  // does not name: a same-fieldset literal with a destination of its own keeps its row.
  if structIndexOfObj(ow) >= 0 && !anonLeafInJoin(ow) { return "" }
  const set = anonLeafPolyUnionSetOpen(ow, fname, val)
  if set == "" { return "" }
  // A row that ALREADY holds this family — the declared spelling of the shape, or the row a
  // sibling family minted. Nothing to mint; `anonLeafMergeField` records the redirect.
  if anonLeafServingRow(ow, fname, set) >= 0 { return "" }
  set
}

// D901 — IS THE `??` THAT JOINS THIS FAMILY READING A CONTAINER? Then the merged row has a
// SECOND consumer wanting a different field type, and the box is the only rep that serves both.
//
// The map value slot is keyed by the CHECKER's value type, and the fold does not move that:
// `c["k1"] = { r: 7 }` beside `(c)["k0"] ?? { r: 1.5 }` leaves the map's values `{r: i32}`
// while the `??` result is `{r: f64}`. One row cannot hold one field at two codes, and
// D804/D833's whole argument is that the BOX is what lets it — so where a container read is
// the left operand the fold stands down and master's box stays. Measured both ways:
// `d833_none_i32_f64` lost its mv slot outright and `d833_genpin_i32_f64` built the `??`
// default's `f64.const` into the map's own i32 row (`expected i32, found f64`) — two `runs`
// cells, and this gate is what keeps them.
//
// The scan is `anonLeafOwnersJoined`'s, arm for arm, so the two cannot disagree about WHICH
// `??` names this family — the gate has to be asked of the same join the set was built from.
function anonLeafJoinLhsIndexed(
  ow: i32,
  fname: string,
  owAtom: string,
): boolean {
  let qi = 0
  while qi < P.nodes.length {
    const qn = P.nodes[qi]
    if qn is BinExpr {
      if qn.binOp == "??" {
        let names = false
        const d = unwrapParen(qn.binRight)
        if d == ow { names = true }
        if d >= 0 {
          const dn = P.nodes[d]
          if dn is ObjLit {
            if anonObjFieldSetEq(d, ow) {
              if anonLeafAtomName(objFieldVal(d, fname)) != owAtom {
                names = true
              }
            }
          }
        }
        if names {
          const lh = P.nodes[unwrapParen(qn.binLeft)]
          if lh is Index { return true }
        }
      }
    }
    qi = qi + 1
  }
  false
}

// D901 — THE ONE ATOM THE CHECKER'S JOIN LEAVES, or "" when the set really is a union.
//
// `joinTys` is `assignable`-driven, so a PAIR on the lossless widening lattice
// (`typecheck.numWidensName`) is ONE type to the checker and not a union at all: `{r: i32}`
// joined with `{r: f64}` is `{r: f64}`, and `g1.r` type-checks as `f64`. The mint built a
// `{tag, payload}` box over `i32|f64` anyway, and a box nothing agrees is a box is a
// mint/read DISAGREEMENT: the reader follows the CHECKER, unboxes the f64 arm with an
// UNCONDITIONAL `ref.cast`, and the value that arrives is the i32 one — `wasm trap: cast
// failure` at run time on a `vl check` rc 0 program. Fold it and the field is a plain f64
// that `emitObj`'s own code-17 arm widens the int literal into, exactly as a DECLARED
// `{r: f64}` field does.
//
// EXACTLY TWO ATOMS, ONE OF THEM `i32`, AND THE FOLD IS ONLY EVER OFF `i32` — not the whole
// lattice, and that bound is a MEASURED `runs`-lost cell rather than caution. `f32→f64` is a
// lattice edge too, and folding it broke `function src(): {r: f32} | null { { r: 2.5 } }`
// beside `?? { r: 7 }`, which RUNS on master: the atom column reads a bare float literal as
// `f64` unconditionally (`anonLeafAtomName` has no destination to consult), so in an f32
// destination the set is `f64|i32|f32` and the widest atom is NOT the checker's answer —
// which is `f32`, because the literals conform to the annotation. `Invalid input WebAssembly
// code … expected f32, found f64`. The `i32` edges have no such hazard: nothing else in the
// atom vocabulary reads as `i32`, so an `i32` atom is an int literal and the wider partner is
// what the checker names. A set of three or more keeps master's box, whatever it holds.
function anonLeafFoldedAtom(atoms: string[]): string {
  if atoms.length != 2 { return "" }
  if atoms[0] == "i32" {
    if atoms[1] == "i64" || atoms[1] == "f64" { return atoms[1] }
  }
  if atoms[1] == "i32" {
    if atoms[0] == "i64" || atoms[0] == "f64" { return atoms[0] }
  }
  ""
}

// The MERGED MEMBER SET itself, with no question asked about who already holds it — the half
// `anonLeafMergeField` needs before it can look for a holder, and the half the caller above
// needs after. See `anonLeafPolyUnionSet` for the gates.
function anonLeafPolyUnionSetOpen(ow: i32, fname: string, val: i32): string {
  const owAtom = anonLeafAtomName(val)
  if owAtom == "" { return "" }
  if objVariantName(ow) != "" { return "" }
  const owFam = anonLeafFamRowOf(ow)
  const atoms: string[] = []
  atoms.push(owAtom)
  let qi = 0
  while qi < P.nodes.length {
    if qi != ow {
      const qn = P.nodes[qi]
      if qn is ObjLit {
        if anonObjFieldSetEq(qi, ow) {
          // A sibling a row already claims contributes its atom ONLY when a `??` names it AND
          // its join was claimed by the SAME row as this one's. Two operands of a `??` are one
          // value, so a row holding one must hold both — and two `??` families over one field
          // set share a row exactly when they share the row they are superseding, which is what
          // keeps `{f: boolean}`'s map and `{f: K0}`'s map from being merged into each other.
          // Read as a mark and not as "is it claimed NOW", so the set cannot drift while this
          // loop's own mints append rows.
          if (
            structIndexOfObj(qi) < 0 ||
            (anonLeafInJoin(qi) && owFam >= 0 && anonLeafFamRowOf(qi) == owFam)
          ) {
            if objVariantName(qi) == "" {
              const qa = anonLeafAtomName(objFieldVal(qi, fname))
              if qa == "" { return "" }
              let seen = false
              let ai2 = 0
              while ai2 < atoms.length {
                if atoms[ai2] == qa { seen = true }
                ai2 = ai2 + 1
              }
              if !seen { atoms.push(qa) }
            }
          }
        }
      }
    }
    qi = qi + 1
  }
  // D872 — AND THE ATOM THE `??`'s LEFT OPERAND IS DECLARED TO HAVE, which for
  // `let a: {r: i32} | null = null` … `a ?? {r: null}` is the ONLY other atom there is: no
  // second literal exists, so without this the family is one member and the rung ends here.
  // Appended last and deduped like any other, so a family whose literals already spell it is
  // byte-identical.
  const annAtom = anonLeafAnnAtomOf(anonLeafAnnTyOf(ow), fname)
  if annAtom != "" {
    if (
      anonLeafAtomAdmits(annAtom, atoms) &&
      anonLeafAnnAtomJoins(annAtom, atoms)
    ) {
      let seenA = false
      let ak = 0
      while ak < atoms.length {
        if atoms[ak] == annAtom { seenA = true }
        ak = ak + 1
      }
      if !seenA { atoms.push(annAtom) }
    }
  }
  if atoms.length < 2 { return "" }
  if !anonLeafOwnersJoined(ow, fname, owAtom) { return "" }
  // D901 — A PAIR THE CHECKER'S JOIN FOLDS TO ONE TYPE IS NOT A UNION, and minting a box
  // over it is what traps. See `anonLeafFoldedAtom` for the bound and the `runs`-lost cell
  // that set it.
  const folded = anonLeafFoldedAtom(atoms)
  if folded != "" {
    if (
      !anonLeafJoinLhsIndexed(ow, fname, owAtom) &&
      !anonLeafFoldBlocked(ow, fname, 0, nameFieldCode(folded))
    ) {
      return folded
    }
  }
  // `null` LAST, so the set reads the way the declared spelling of the same shape does
  // (`{ r: i32 | null }`) and two literals minting in either order key ONE set.
  let out = ""
  let hasNull = false
  let k = 0
  while k < atoms.length {
    if atoms[k] == "null" {
      hasNull = true
    } else {
      if out != "" { out = out + "|" }
      out = out + atoms[k]
    }
    k = k + 1
  }
  if hasNull {
    if out != "" { out = out + "|" }
    out = out + "null"
  }
  out
}

// THE FIELD CODE a merged leaf set gets, asked of the SAME speller a declaration asks
// (`nameFieldCode`) — because a minted row must be indistinguishable from the row the user
// could have written, and "a union of atoms" is NOT the same rep question as "code 16".
// Measured: minting 16 for `string|null` put a `{tag, value}` box behind consumers reading
// the code-20 NICHE and turned that pair's loud reject into CHECK-CLEAN INVALID WASM — the
// one trade worth vetoing.
//
// The codes whose COMPANION column this mint can fill are admitted: 16 records the set in
// `sFieldElemName`, 20 is a bare niche that records "", 30 records the non-null alias, and
// the plain scalars record nothing. Anything else — a nullable list, a shape this rung has
// no atom vocabulary for — answers -1 and the field keeps the code `anonFieldCode` gave it.
//
// D902 — `boolean|null` (code 21) WAS DECLINED HERE AND IS NOW ADMITTED, and the reason it
// was declined turned out to be one line elsewhere. D804 measured the trade exactly right:
// an `#anon` row carrying a code-21 field interned no map-value slot, so the pair swapped
// `bare null needs a struct-typed context` for `unsupported map value type`, one loud reject
// for another. What made that "a separate rung" was the assumption that the mv layer could
// not tell a boolean field from an i32 one — true of `fieldCodeWidensElem`, which is handed
// two CODES and where the refusal stands, and false of `shapeFieldTypeCompatK`, which is
// handed the field's TEXT. With the boolean spelling admitted there the map witness RUNS.
// D804's other claim is corrected by D902's row: the DECLARED twin does NOT run at this
// shape — `type R = { r: boolean | null }` beside `?? { r: null }` took the same loud reject
// on master, so this was never a mint-only gap.
function anonLeafPolyFieldCode(set: string): i32 {
  const c = nameFieldCode(set)
  if c == 16 || c == 20 { return c }
  // D884 — AND 30, the `K | null` niche, whose COMPANION column this mint can fill: the
  // non-null alias name, exactly the recording `pushFieldRow`'s declared path makes
  // (`fieldRecElemName`'s code-30 arm). It joins 16 and 20 on the same test the header
  // states — admitted because the column can be filled, not because the code is nullable.
  if c == 30 { return c }
  // D901 — AND THE TWO PLAIN SCALAR CODES A FOLDED SET CAN SPELL. `anonLeafFoldedAtom` drops
  // the atom the checker's join absorbs, so a two-atom family on the widening lattice arrives
  // here as ONE atom — and only ever as the WIDER end of an edge, which is `i64` (23) or `f64`
  // (17). They are admitted for the reason 16/20/30 are: this mint can fill the field's
  // recording completely — a plain scalar records no companion, and `emitObj`'s own f64/i64
  // arms already widen an int literal at the construction boundary. Codes 0/3/24 are NOT
  // admitted: nothing widens INTO i32, boolean, string or f32, so the fold cannot produce them
  // and a set that spells one is a single-atom family the `atoms.length < 2` gate already ended.
  if c == 17 || c == 23 { return c }
  // D902 — AND 21, THE `boolean | null` SENTINEL: the `null` operand of a `??`-joined pair
  // has no rep at all without it (`bare null needs a struct-typed context`), because the
  // field falls back to `anonFieldCode`'s plain boolean and `emitObj`'s code-21 seed for
  // `pendingNulBool` never fires. See the header for the mv-slot trade that used to make
  // this a worse deal than the reject.
  if c == 21 { return c }
  -1
}

// ARE THE TWO OWNERS JOINED INTO ONE VALUE (D672)? True when this owner, or a
// DISAGREEING same-field-set sibling, is the DEFAULT of a `??`.
//
// A `??` is the join: its two operands become one binding, so the pair CANNOT keep two
// rows and the box is the only rep they share. Two owners that are merely both present in
// the program are not joined — `const p = …` beside `const q = …` is D391's shape, each
// read monomorphically, and there two rows is the right answer. That is the whole
// difference between the shape this closes and the shape D391 closed, and it is why the
// gate is on the JOIN rather than on the disagreement (which both shapes have).
//
// DELIBERATELY THE `??` AND NOT A GENERAL JOIN. The other joiners — a two-destination list
// literal, a function returning both arms — reach the emitter's own design refusal
// (`emitProgram: union … cannot be discriminated`) or another cluster's row, so widening
// this gate would claim rows that are not this one's to claim. The 16 cells this closes
// are all `??` defaults; when a second joiner is measured it gets its own rung here.
function anonPolyOwnersJoined(ow: i32, fname: string, inner: i32): boolean {
  let qi = 0
  while qi < P.nodes.length {
    const qn = P.nodes[qi]
    if qn is BinExpr {
      if qn.binOp == "??" {
        const d = unwrapParen(qn.binRight)
        if d == ow { return true }
        if d >= 0 {
          const dn = P.nodes[d]
          if dn is ObjLit {
            if anonObjFieldSetEq(d, ow) {
              const dv = unwrapParen(objFieldVal(d, fname))
              if dv >= 0 {
                const dvn = P.nodes[dv]
                if dvn is ObjLit {
                  if !anonObjFieldSetEq(dv, inner) { return true }
                }
              }
            }
          }
        }
      }
    }
    qi = qi + 1
  }
  false
}

// The literal that owns `objIx` as one of its FIELD VALUES, read out of the owner map
// `nestOwner` built by `collectAnonShapes` — or -1 when the literal is not nested in
// another one. Split out so the gate below reads as one question.
function anonNestOwnerOf(objIx: i32, nestOwner: i32[]) {
  if objIx < 0 { return -1 }
  if objIx >= nestOwner.length { return -1 }
  nestOwner[objIx]
}

// SHOULD a literal that `objVariantName` CLAIMED still get an anonymous row?
//
// `objVariantName` is a GLOBAL scan with no context (its own header says so, and
// `unionArmVariantForObj` exists because of it): it answers "some union arm somewhere in
// this program has this field-name set", not "this literal is boxed into that union". The
// skip is right for a literal the emitter really does box — minting a row would make
// `emitObjLitNode`'s `structIndexOfObj` arm claim it and build a bare struct where a
// `{tag, value}` box was expected. It is WRONG for a literal in a position nothing boxes.
//
// The position this recognises is the one a 250,238-cell census found and D179/D227 filed:
// the literal is the FIELD VALUE of another literal that is itself getting an anonymous row.
// That owner's field type is whatever this literal infers to — the checker renders it as the
// inline shape `{c2: i32}`, never as the union — so nothing boxes it, and with no row
// `anonFieldElemName` records "" for the owner's code-15 field. The owner then fails to
// classify too, and `const c = [{ r: { c2: 1 } }]` beside `type Shape2 = Cir2 | i32` reached
// emit with NO interned shape at all: `emitProgram: ref valtype with no interned shape`,
// on a program that runs the moment the union declaration is deleted.
//
// The owner's own candidacy is asked as the two conditions that gate the loop below, not as
// "did it get a row": whether it gets one depends on THIS literal's field code, so asking
// the full question here is circular. An owner that then declines for an unrelated field
// fails loudly as before — the extra row is unreachable, because a literal whose owner
// interns nothing is never constructed.
function anonNestNeedsRow(objIx: i32, nestOwner: i32[]) {
  const ow = anonNestOwnerOf(objIx, nestOwner)
  if ow < 0 { return false }
  if structIndexOfObj(ow) >= 0 { return false }
  if objVariantName(ow) != "" { return false }
  const fname = anonNestFieldNameOf(ow, objIx)
  if fname == "" { return false }
  anonNestFieldMono(ow, fname, objIx)
}

// The field NAME under which `inner` sits in `ow`. "" when it does not (which
// `anonNestOwnerOf` has already ruled out, so the empty answer is a decline, not a case).
function anonNestFieldNameOf(ow: i32, inner: i32) {
  const o = P.nodes[ow]
  if o is ObjLit {
    let i = 0
    while i < o.objFields.length {
      const f = P.nodes[o.objFields[i]]
      if f is FieldInit {
        if unwrapParen(f.fiValue) == inner { return f.fiName }
      }
      i = i + 1
    }
  }
  ""
}

// Do two object literals set the SAME field names? The key `structIndexOfObj` matches a
// literal to a row on, asked between two literals.
function anonObjFieldSetEq(aIx: i32, bIx: i32) {
  const a = P.nodes[aIx]
  const b = P.nodes[bIx]
  if a is ObjLit {
    if b is ObjLit {
      if a.objFields.length != b.objFields.length { return false }
      let i = 0
      while i < a.objFields.length {
        const f = P.nodes[a.objFields[i]]
        if f is FieldInit {
          if objFieldVal(bIx, f.fiName) < 0 { return false }
        } else {
          return false
        }
        i = i + 1
      }
      return true
    }
  }
  false
}

// WOULD THE OWNER'S ROW BE MONOMORPHIC AT THIS FIELD — the condition that makes minting the
// nested row safe, and the one the first cut of this rung was missing.
//
// `structIndexOfObj` matches a literal to a row by field-NAME set. So the moment TWO literals
// share the owner's field-name set and disagree about the nested layout at `fname`, they
// cannot both have an anonymous row: the second matches the first's and builds `{s2: …}`
// against a `{c2: …}` field. That disagreement is exactly what the union box exists for, and
// those literals must keep taking it.
//
// MEASURED, not reasoned: without this condition census block D moved **16 cells from
// `loud emit reject` to `check-clean invalid wasm`** — a loud reject turned into a silent
// class, the worst trade available. All 16 were map containers holding both arms of one
// union (`c["k0"] = { r: { c2: 1 } }` beside `?? { r: { s2: 1 } }`), and the two-line
// `const p = { r: { c2: 1 } }` / `const q = { r: { s2: 1 } }` is the whole witness.
//
// The scan runs only when the rung has already fired every other condition (a variant-named
// literal nested in an anonymous-row owner), which is why a linear pass over the arena is
// affordable here: a program with no such literal never reaches it.
function anonNestFieldMono(ow: i32, fname: string, inner: i32) {
  let qi = 0
  while qi < P.nodes.length {
    if qi != ow {
      const qn = P.nodes[qi]
      if qn is ObjLit {
        if anonObjFieldSetEq(qi, ow) {
          const qv = unwrapParen(objFieldVal(qi, fname))
          if qv < 0 { return false }
          const qvn = P.nodes[qv]
          if qvn is ObjLit {
            if !anonObjFieldSetEq(qv, inner) { return false }
          } else {
            return false
          }
        }
      }
    }
    qi = qi + 1
  }
  true
}

// The type name to record for one generic-alias field: the annotation as CANON'd, except
// where the field's type IS a type parameter — there, the DECLARED spelling.
//
// `canonEmitTypeNames` is a name rewrite with no scope, so inside the body of
// `type Box<Id> = { v: Id }` it resolved `Id` through the DECLARED registry (`type Id = i32`
// → "i32", `type Id = 0 | 1` → "i32" by a different arm) while the CHECKER resolved it as
// the parameter — `tsLeafTy` asks the live binding before the registry, and reports
// `Box<string>` as `{v: string}`. The emitter then substituted nothing, because the name it
// had to match on was already gone. The pre-canon spelling is banked per annotation node at
// `typecheck.declAnnRawTyName`; the ARENA is untouched, because the substitution is
// the only consumer that wants the parameter name back and a parameter name left standing
// in the arena is a NAME `collectU` may already have claimed (`type Id = i32` is a
// one-member `UnionDecl`, so an `Id[][]` field interned a ref-list of union BOXES and the
// no-op instantiation `Box<i32>` stopped lowering).
//
// The `gaeAnnHasParam` gate is what keeps this narrow: the declared spelling is taken only
// where the substitution would land, so `type Box<T> = { v: 0 | 1 }` still records the
// canon'd `i32` and `type Box<i32> = { v: i32 }` still substitutes nothing.
//
// That gate USED to be `gaeParamSlotOf(arrLeafNameOf(raw), pnames)` — the array grammar and
// nothing else — so it agreed with the substitution only on the constructors a `[]` peel can
// see. A parameter behind a `| null`, an inline `{…}` or a nested application was reported
// as "not substituted here", the canon'd body type was recorded, and the field interned at
// the ALIAS's type while the checker had bound it to the ARGUMENT. Both sides now ask the
// same published question.
function gaeDeclFieldTyName(nodeIx: i32, canoned: string, pnames: string[]) {
  const raw = declAnnRawTyName(nodeIx)
  if raw == "" { return canoned }
  if !gaeAnnHasParam(raw, pnames) { return canoned }
  raw
}

// Record every generic-alias declaration into the registry.
function gaeCollectDecls(stmts: i32[]) {
  gaeBases = []
  gaeParams = []
  gaeFieldStart = []
  gaeFieldCount = []
  gaeFieldNames = []
  gaeFieldTyNames = []
  let i = 0
  while i < stmts.length {
    const s = P.nodes[stmts[i]]
    if s is TypeDecl {
      // The generic-application SPAN test at its home. The `lt > 0` + trailing-`>` pair this
      // spelled out IS `annGenAppSpanEnds`: the home adds an `n < 3` cheap reject that `lt > 0`
      // with a final `>` already forces, and re-asks the same pure `gaeLtAt`. The CUT stays
      // here — this declaration site stores the RAW parameter TEXT (`gaeSplitArgs` runs later,
      // at `gaeEnsure`), which is not what `annGenAppDecompose` returns.
      //
      // **AND THE CUT NOW HAS A HOME TOO** (`tyname.gaeHeadNameOf` / `gaeArgsTextOf`, W2).
      // The sentence above was written when this file's only alternative was
      // `annGenAppDecompose`, which SPLITS the argument text — the wrong shape for a site that
      // stores it raw. The W2 homes take the `<` index and cut, nothing more, so the split
      // stays at `gaeEnsure` exactly where it was.
      if annGenAppSpanEnds(s.tdName) {
        const lt = gaeLtAt(s.tdName)
        gaeBases.push(gaeHeadNameOf(s.tdName, lt))
        const ptext = gaeArgsTextOf(s.tdName, lt)
        gaeParams.push(ptext)
        // The parameter NAMES, needed here (not only at `gaeEnsure`) so a field whose type
        // IS a parameter can be recorded as DECLARED rather than as canon resolved it.
        const pnames: string[] = []
        gaeSplitArgs(ptext, pnames)
        gaeFieldStart.push(gaeFieldNames.length)
        let cnt = 0
        const fields = s.tdFields
        let fi = 0
        while fi < fields.length {
          const fnode = P.nodes[fields[fi]]
          if fnode is FieldDef {
            let tname = ""
            if fnode.fdType >= 0 {
              const ftn = P.nodes[fnode.fdType]
              if ftn is TypeRef { tname = ftn.tyName }
              tname = gaeDeclFieldTyName(fnode.fdType, tname, pnames)
            }
            gaeFieldNames.push(fnode.fdName)
            gaeFieldTyNames.push(tname)
            cnt = cnt + 1
          }
          fi = fi + 1
        }
        gaeFieldCount.push(cnt)
      }
    }
    i = i + 1
  }
  0
}

// Peel the composition wrappers a generic APPLICATION can sit behind in an annotation
// spelling — a `| null` nullable and any number of trailing `[]` — leaving the bare name
// `gaeEnsure` can intern (`Box<i32>[] | null` → `Box<i32>`). A name with no wrapper comes
// back unchanged.
//
// The `[]` half is the ARRAY-NAME grammar's two homes (`emit_base.nameIsArray` TESTS it,
// `arrElemNameRaw` CUTS it, #1175) — this loop is a resume over them, not a third copy.
// The `nm.length > 2` guard is kept IN FRONT of the test rather than folded into it: it
// excludes the degenerate `"[]"`, which `nameIsArray` accepts and whose raw cut is "" —
// exactly the `-1`/`""` ambiguity the home's own header says it asserts nothing about.
function gaePeelWrappers(name: string) {
  let nm = nonNulBaseOf(name)
  while nm.length > 2 && nameIsArray(nm) { nm = arrElemNameRaw(nm) }
  nm
}

// The registry SLOT of generic-alias base `name`, or -1. THE HOME IS HERE — this file
// WRITES the registry (`gaeCollectDecls` twenty lines up), and it is the lowest module
// that can see `gaeBases` at all. `emit_classify.gaeIndexOf` is a second copy of this
// loop; routing it here is a filed hand-off, not done in this change because that file is
// owned by a concurrent slice at this commit.
function gaeBaseSlot(name: string) {
  let i = 0
  while i < gaeBases.length {
    if gaeBases[i] == name { return i }
    i = i + 1
  }
  -1
}

// Intern the inline SHAPES an APPLICATION's substituted field types NAME, before
// `gaeEnsure` codes those fields.
//
// A monomorphized generic-alias field is the one field kind no arena scan can reach. A
// DECLARED struct's nested shape is interned from its own `FieldDef`
// (`collectNestedFieldShapes`), and an inline annotation's from its own `TypeRef`
// (`collectAnnShapes`) — but `type Box<T> = {v: {a: T}}` at `Box<string>` names the target
// `{a:string}`, a text that appears NOWHERE in the program. `gaeEnsure` asks
// `structIndexByName` for it, gets -1, codes the field -1 and declines to intern the
// INSTANCE at all; the literal then lowered against the alias's own canon'd `{a:i32}` and
// the module was `vl check` rc=0 with "expected i32, found (ref $type)".
//
// That this is the INTERN and not the substitution was measured, not inferred: adding a
// `const w: {a: string}` elsewhere in the very same program — which changes nothing about
// the substitution and only makes the shape reachable by `collectAnnShapes` — turns the
// cell CORRECT.
//
// It does NOT recurse into a field that is itself an application. `gaeEnsure` does that
// depth-first under a `structIndexByName` early-out that has already interned the outer
// instance; this pass runs BEFORE any of that, so the same recursion here would not
// terminate on a recursive alias (`type L<T> = {next: L<T> | null}`). A nested
// application's own inline-shape fields are therefore still uncovered — filed, with the
// grid, in `docs/internals/destringify-types-program.md`.
function gaeInternAppFieldShapes(name: string) {
  if !annGenAppSpanEnds(name) { return 0 }
  const ltAt = gaeLtAt(name)
  // Both halves of the GENERIC-APPLICATION cut at their home (`tyname.gaeHeadNameOf` /
  // `gaeArgsTextOf`, W2), given the `<` the line above found. The #1239 census scored this
  // file ONE W2 writing and it carries FOUR — it never listed this function at all.
  const gi = gaeBaseSlot(gaeHeadNameOf(name, ltAt))
  if gi < 0 { return 0 }
  const pnames: string[] = []
  gaeSplitArgs(gaeParams[gi], pnames)
  const args: string[] = []
  gaeSplitArgs(gaeArgsTextOf(name, ltAt), args)
  if args.length != pnames.length { return 0 }
  const fs = gaeFieldStart[gi]
  const fc = gaeFieldCount[gi]
  let fi = 0
  while fi < fc {
    // `internShapeDeep` peels the composition wrappers itself (nullable, `[]` runs,
    // grouping) and descends a map VALUE, so `{a: T}[]` and `{a: T[]}` are covered by the
    // same call, and a non-shape substitution (`i32`, `Box<i32>`) is a no-op.
    internShapeDeep(gaeApplyFieldTy(gaeFieldTyNames[fs + fi], pnames, args))
    fi = fi + 1
  }
  0
}

// Scan every TypeRef in the arena for generic-alias applications (behind
// `|null` and `[]` wrappers) and intern each one.
export function collectGenAliasShapes() {
  if gaeBases.length == 0 { return 0 }
  let ti = 0
  while ti < P.nodes.length {
    const tn = P.nodes[ti]
    if tn is TypeRef {
      const nm = gaePeelWrappers(tn.tyName)
      // The instance's own inline-SHAPE field targets first — `gaeEnsure` codes a field
      // from the struct table and declines the whole instance when the target is not in it.
      gaeInternAppFieldShapes(nm)
      gaeEnsure(nm)
      // A MAP annotation's VALUE position (`{[string]: Box<i32>}`): the application is
      // INTERIOR to the synthetic map name, so the peel above never reaches it and the
      // instance is interned only when some OTHER annotation happens to spell it bare —
      // which is exactly what the map-value classifier then fails to find ("unsupported
      // map value type"). Interning it here makes the map spelling self-sufficient.
      const mv = mapValNameOf(nm)
      if mv != "" { gaeEnsure(gaePeelWrappers(mv)) }
    }
    ti = ti + 1
  }
  0
}

// Intern every INLINE-SHAPE struct field type (`type Box = { inner: {x:i32} }`) depth-first BEFORE the
// struct decls that reference it, so `collectS`'s main loop resolves the nested shape (it can't be
// interned mid-loop — `internInlineShape` shares the flat `sField*` arrays). `internInlineShape` is a
// no-op for a non-shape name and idempotent (`annShapeIndexOf`), so a program with NO inline-shape
// fields — like the compiler itself — interns nothing here and its struct layout is unchanged.
// Intern the OWN canonical render of the union ARM a field type NAMES (`g: Circle`,
// `g: Circle | null`), so `armFieldStructRow` has a row to answer with. A no-op for every
// other spelling; see the call site for why it is demand-driven and why it costs no heap type.
function internArmFieldShape(fdNm: string) { internArmShapeAt(fdNm, 0) }

// The COMPOSITION peel, mirroring `internShapeDeep`'s: grouping parens, a trailing
// `| null`, trailing `[]` runs and a MAP VALUE, to any depth. An arm reached through a
// container needs its row for the same reason a bare one does — `{[string]: Circle[]}`
// is the map-and-list dual of `g: Circle`, and the element render that has to key against
// it (`{r:null}[]`, the un-annotated carrier's own spelling) resolves through the struct
// table exactly as the bare field's does. Depth-bounded like every other name peel in this
// file: a name is finite, but a bug in one of the cuts must not be an unbounded recursion
// in the compiler.
function internArmShapeAt(nm: string, depth: i32) {
  if depth > 8 { return 0 }
  if nm == "" { return 0 }
  const base = nonNulBaseOf(nm)
  if base != nm { return internArmShapeAt(base, depth + 1) }
  if nameIsArray(nm) { return internArmShapeAt(arrElemNameRaw(nm), depth + 1) }
  const mv = mapValNameOf(nm)
  if mv != "" { return internArmShapeAt(mv, depth + 1) }
  internArmShapeOf(nm)
}

// THE ARM'S RENDER, SPELLED THE WAY THE ARM'S OWN ROW IS CODED (silent-class-inventory
// D1093). `tyToEmitName` renders a field's INLINE literal union faithfully — `{r:i32,k:"a"|"b"}`
// — and `internInlineShapeTy` codes that text through the NAME ladder, where
// `nameIsLitUnionType` claims it as the interned i32 ATOM (code 0). The VARIANT recorder
// codes the SAME field from the annotation NODE, where the inline spelling is not a
// registered alias and canon has softened it, so it codes 3 (a plain string slot) — and 3 is
// what the arm's wasm struct is actually laid out with, exactly as the DECLARED spelling of
// the same struct is. `variantStructHeapTwinAt` compares the two tables' codes POSITIONALLY,
// so the mint could never be recognised as the arm's own row and `armFieldStructRow`
// answered -1: a field typed as that arm had no rep, while the NAMED-alias spelling of the
// identical union ran.
//
// THIS IS NOT A REP CHANGE AND IT DOES NOT SOFTEN THE TYPE. `Circle`'s checker type keeps its
// member set, its VARIANT row keeps the unsoftened `"a"|"b"` in the IDENTITY column
// (`variantFieldIdText` — what keeps two literal-tagged arms discriminable), and the emitted
// slot is the string ref it already was. What is softened is the anonymous interned ROW'S OWN
// KEY, which must describe the layout it carries: `annShapeIndexOf` matches rows by field
// NAMES + CODES while `structIndexByName` resolves them by that key, so a row NAMED
// `{r:i32,k:"a"|"b"}` while laid out as `{r:i32,k:string}` is a name that lies about its
// layout — and the next annotation spelling the truthful text would dedup onto it and lose
// its own name.
//
// BYTE-IDENTICAL WHERE NOTHING SOFTENS: the render is returned UNCHANGED unless a field
// actually substitutes, so every arm without an inline literal-union field mints exactly the
// key it minted before. A NAMED alias field (`k: K`) is not touched — `nameIsInlineLitUnion`
// is false for it and both ladders already code it 0 — and neither is a NUMERIC literal union,
// whose members are not quoted.
function armMintShapeName(nm: string) {
  if !nameIsShapeSpanEnds(nm) { return nm }
  const fnames: string[] = []
  const ftexts: string[] = []
  shapeInnerFieldSplit(groupInnerOf(nm), fnames, ftexts)
  let changed = false
  let out = "{"
  let i = 0
  while i < fnames.length {
    if i > 0 { out = out + "," }
    let tx = ftexts[i]
    if nameIsInlineLitUnion(tx) {
      tx = "string"
      changed = true
    }
    out = out + fnames[i] + ":" + tx
    i = i + 1
  }
  if !changed { return nm }
  out + "}"
}

function internArmShapeOf(nm: string) {
  const vi = variantIndexOf(nm)
  if vi < 0 { return 0 }
  if vi >= uVarTyIx.length { return 0 }
  const aty = uVarTyIx[vi]
  if aty < 0 { return 0 }
  // NO ARENA HINT. `internInlineShapeTy` banks its `tyIx` argument into `sTyIx`, which would
  // make `structIndexOfTy` answer this row for the ARM'S OWN declaration node — and a
  // struct-row resolver answering for an arm is the D34 decline ("an ARM value has no
  // `sNames` row, so this resolver declines and `exprVariantIndex` answers") turned off
  // module-wide. The row is found structurally instead, by `variantStructHeapTwinAt`'s
  // `repRowOfTyStruct` rung, which is the same route an inline `{r: i32}` field already takes.
  internInlineShape(armMintShapeName(tyToEmitName(aty)))
  0
}

function collectNestedFieldShapes(stmts: i32[]) {
  let i = 0
  while i < stmts.length {
    const s = P.nodes[stmts[i]]
    if s is TypeDecl {
      if variantIndexOf(s.tdName) < 0 && gaeLtAt(s.tdName) < 0 {
        const fields = s.tdFields
        let fi = 0
        while fi < fields.length {
          const fnode = P.nodes[fields[fi]]
          if fnode is FieldDef {
            // `internShapeDeep` peels the composition wrappers itself (nullable,
            // arrays, grouping) AND descends a MAP field's VALUE position — so a
            // declared `type T0 = {f: {[string]: {f: string}} | null}` interns the
            // map's value struct BEFORE `collectS` codes the field, exactly as the
            // INLINE annotation spelling does via `collectAnnShapes`. The previous
            // manual null/[] peel + `internInlineShape` no-op'd on the map, leaving
            // the value struct un-interned: the nullable-map field gate then found
            // no value rep — a loud reject the inline twin didn't have (and, before
            // the `sScanLim` clamp, an in-flight-entry OOB compiler CRASH; fuzz
            // frontier seed 43909430 d4 --branching --multiobs --declared).
            // The same two gates `collectAnnShapes` states — see its note for why the
            // canon question is asked directly rather than through a surviving tree.
            let fdRoot = -1
            const fdNm = tyNameOf(fnode.fdType)
            if !nameMentionsGenAliasParam(fdNm) {
              if canonRewroteNode(fnode.fdType) {
                fdRoot = canonTyIxOf(fnode.fdType)
              } else {
                fdRoot = nodeTyIxOf(fnode.fdType)
              }
            }
            internShapeDeepTy(tyNameOf(fnode.fdType), fdRoot)
            // AND THE ARM-TYPED FIELD'S OWN SHAPE (silent-class-inventory D761). A field
            // typed as a union ARM stores through the struct row whose heap the arm shares
            // (`armFieldStructRow` → D280's `uVarSTwin`), and an arm with no DECLARED layout
            // twin has no such row for the same reason the field has no code: `collectS`
            // skips a `type X = {…}` that is a union member. Interning the arm's OWN
            // canonical render mints it, and `variantStructHeapTwinAt`'s anonymous-claimant
            // rung (D282) then merges the two, so the mint costs the module no heap type —
            // `mAssignTypeIndices` allocates for the struct row and the arm reuses it.
            //
            // DEMAND-DRIVEN: only a field that NAMES an arm interns anything, so every
            // module without one is byte-identical. Idempotent (`annShapeIndexOf` dedups),
            // and a no-op where a declared twin already exists.
            internArmFieldShape(tyNameOf(fnode.fdType))
          }
          fi = fi + 1
        }
      }
    }
    i = i + 1
  }
  0
}

// THE ONE HOME of the DECLARED-FIELD element-NAME recording: the name a `FieldDef`'s
// annotation node `tyIx` (already coded `code`) records into the flat
// `sFieldElemName` / `uFieldElemName` column.
//
// `collectS`'s struct loop and `collectVariantFields`'s variant loop are the SAME ladder —
// same codes, same order, same column, differing only in which table they push to — and had
// DRIFTED as two hand-written copies (the variant one re-derived a code-4 litunion-ARRAY
// recording `fieldRefElemName` performs itself; the struct one did not).
//
// `fieldRefElemName` answers every code but 0 and 30, for which it returns "" BY CONSTRUCTION
// ("the ATOM codes the shape-text recorder keys and the NODE recorder does not", its own header
// in `emit_classify.vl`); the atom name then comes from the annotation's own spelling, which is
// what these two arms supply.
//
// THE ROW THAT ERASED THE KEY NOW CARRIES IT (B6b). An mv slot's identity is the
// (KEY, VALUE) pair, but a map field records only V — `sFieldElemName` / `uFieldElemName`
// hold the VALUE spelling and `sFieldElemTyIx` the VALUE type — so an i32-keyed map FIELD
// had nothing in its row to resolve its own map struct with, and this function was where
// the position's loud reject lived. The missing half is the field row's KEY COLUMN
// (`sFieldElemKeyI32` / `uFieldElemKeyI32`), written by `pushFieldRow` off the field's own
// SPELLING and read back through `sFieldMapShape` / `uFieldMapShape`. This recorder is
// unchanged by that: the key never travels through the elem NAME, which is exactly why it
// needed a column of its own.
function fieldRecElemName(tyIx: i32, code: i32) {
  const en = fieldRefElemName(tyIx)
  // A literal-union atom field (code 0) records its union NAME (not the ref-elem name,
  // which is "" for it) so `sFieldIsLitUnion` recovers the atom rep + membership.
  if code == 0 {
    // The litunion test off the ROW (B290): `annRowOfNode` reads canon's banked row where
    // canon rewrote the spelling. Dual-written: 932 reaches, 0 disagreements.
    const ftn = tyNameOf(tyIx)
    if tyIsLitUnion(annRowOfNode(tyIx)) { return ftn }
    return en
  }
  // A NULLABLE-litunion niche field (code 30) records the non-null union name — the
  // code-0 recording over the `| null`-stripped part.
  if code == 30 { return nulLitUnionInnerName(tyNameOf(tyIx)) }
  en
}

// THE ONE HOME of the FIELD-ROW push: append one field's four parallel-column entries
// (`*FieldTypes` / `*FieldElemName` / the D5 arena sidecar / `*FieldNames`) to the STRUCT
// table (`toVariant` false) or the VARIANT table (true), then run the two per-row side
// effects every recorder ran — the code-16 value-union box intern and the scalar-list
// wrapper/backing forcing.
//
// Three recorders share it: `collectS` (struct decls), `collectVariantFields` (named-struct
// variants) and `collectShapeVariantFields` (inline SHAPE-TEXT variants). The third is why
// the parameter is the elem NAME rather than the annotation node — it derives that name from
// a field TYPE TEXT (`shapeFieldElemName(ftxt, fc)`) where the two node recorders derive it
// from a `FieldDef` (`fieldRecElemName(fdType, code)`, #1147), genuinely different questions.
// The ROW is what all three share, character for character, and all that is named here.
//
// `keyI32` is the row's KEY column (B6b): a map field records only its VALUE, and an mv
// slot's identity is the (KEY, VALUE) pair, so the caller — which still holds the field's
// SPELLING — answers `nameIsI32KeyedMap` here. Every non-map code passes false, which is
// what the predicate answers for a non-map spelling anyway.
//
// `tyText` is the row's IDENTITY column: the field's own canonical type text, which the
// three recorders hold and no other column preserves (the code is storage, the elem name is
// a referenced layer). Supplied by the same two provenances as `keyI32` — `tyNameOf(fdType)`
// from the two node recorders, the field TYPE TEXT from the shape-text one — so the two
// spellings of one type agree here exactly as they already do there. Recorded only into the
// VARIANT table, whose `variantFieldTysEq` is its one reader.
//
// The push ORDER matters and is preserved exactly: the D5 sidecar recorder pads itself
// against `*FieldElemName.length`, so it must run AFTER that column's push and before the
// next row's; `registerValueUnionName` must run after the row is complete because it can
// push rows of its OWN into the union tables.
function pushFieldRow(
  toVariant: boolean,
  code: i32,
  elemNm: string,
  keyI32: boolean,
  fName: string,
  tyText: string,
  elemTyHint: i32,
) {
  if toVariant {
    uFieldTypes.push(code)
    uFieldTyText.push(tyText)
    uFieldElemName.push(elemNm)
    recordUFieldElemRowTy(elemNm, keyI32, elemTyHint) // D5 + B6b
    uFieldNames.push(fName)
  } else {
    sFieldTypes.push(code)
    sFieldElemName.push(elemNm)
    recordSFieldElemRowTy(elemNm, keyI32, elemTyHint) // D5 + B6b
    sFieldNames.push(fName)
  }
  // A value-union field interns its box reps (the three recorders' shared parity rule):
  // without it the field's per-rep value boxes are never interned, so the construct
  // `struct.new`s a raw scalar where the box `(ref)` is required — invalid wasm.
  if code == 16 { registerValueUnionName(elemNm) }
  // A scalar-list field (`f: i64[]`) forces its backing + wrapper pair: a field may be the
  // type's ONLY mention, with no standalone `i64[]` TypeRef to set the flag.
  forceScalarListField(code)
  0
}

// ── struct-type collection ───────────────────────────────────────────────────
// Scan the top-level statements for EVERY struct `type` declaration and record each into the
// flat multi-struct table (name + field names in declaration order, plus a per-field wasm-type
// code from `fieldTypeCode`); each `type X = {…}` interns its own WasmGC struct heap type, and
// a field whose type has no code fails loudly. Then the shape passes, in order: nested inline
// field shapes, generic-alias applications, inline object-TYPE annotations, and anonymous
// object literals. Returns 0, or -1 (via `emitFail`).
export function collectS(stmts: i32[]) {
  sDeclared = false
  // The per-program literal-resolution memo keys node indices against THIS table —
  // both are program-scoped, so it resets with the table.
  sioMemoReset()
  // D833's three columns are keyed against THIS program's tree and THIS program's row table, so
  // a stale entry would hand the next program's map a row from this one. Reset beside the memo,
  // for the same reason and at the same moment.
  anonLeafJoined = []
  anonLeafFamRow = []
  anonLeafAnnTy = []
  anonLeafParamMoved = []
  anonLeafRetMoved = []
  anonLeafCloSlotFn = []
  anonLeafSupersede = []
  // The struct-row NAME index keys THIS table's spellings — reset it with the table, or
  // the next program's rows answer with this one's names (see its header). MEASURED, not
  // defensive: without this line the shared-instance wasm harness fails 438 of 1,939.
  structNameIxReset()
  shapeSetIxReset()
  structTyIxReset()
  sNames = []
  sRowDecl = []
  sTyIx = []
  sFieldNames = []
  sFieldStart = []
  sFieldCount = []
  sFieldTypes = []
  sFieldElemName = []
  sFieldElemTyIx = []
  sFieldElemKeyI32 = []
  // Nested inline-shape FIELD types intern first, so the struct decls that reference them resolve.
  collectNestedFieldShapes(stmts)
  // A `type X = {…}` that is a UNION VARIANT is collected by `collectU` into its own
  // variant table — it is NOT a standalone struct, so skip it here. Any OTHER struct
  // `type` (e.g. `ast.vl`'s `Tok`/`Diag`, declared alongside the `Node` union) IS a
  // standalone struct and is interned here, so standalone structs coexist with a union.
  let i = 0
  while i < stmts.length {
    const s = P.nodes[stmts[i]]
    // A STRUCT-ALIAS union decl (a canonicalized object intersection — single
    // inline-shape variant) is a plain named struct: intern it here (collectU
    // skipped it).
    if s is UnionDecl {
      const aliasShape = unionStructAliasShape(s.udVariants)
      if aliasShape != "" {
        if internShapeAs(s.udName, aliasShape) < 0 { return -1 }
      }
    }
    // A union variant `TypeDecl` is owned by the variant table, NOT a standalone
    // struct; a GENERIC alias declaration ("Box<T>") has no concrete shape — its
    // APPLICATIONS intern via `collectGenAliasShapes` below.
    if s is TypeDecl {
      if variantIndexOf(s.tdName) < 0 && gaeLtAt(s.tdName) < 0 {
        sDeclared = true
        sNames.push(s.tdName)
        recordSRowDeclOfName(s.tdName)
        recordSTyIx(sTyIxOfName(s.tdName)) // D0
        sFieldStart.push(sFieldNames.length)
        const fields = s.tdFields
        // FIELD ORDER IS CANONICAL: ascending by field NAME (`fieldNameOrder`, D622).
        // The 2026-08 ruling is that `{a: i32, b: string}` and `{b: string, a: i32}` are the
        // SAME TYPE, and the checker agrees — `assignable` takes one where the other is
        // asked for. The emitter did not: two named declarations always mint two ROWS, and
        // two rows collapse to one wasm HEAP TYPE only when their field SEQUENCE matches. So
        // the permuted pair emitted two struct types and the assignment was check-clean
        // INVALID WASM (`xfail-miscompile-permuted-struct-fields.vl`).
        //
        // THIS USED TO BE `rowWithFieldNameSet` — lay the second declaration out in the
        // FIRST one's order. That matched the sequences and it made a shape's layout a
        // function of the whole module: `AB` then `BA` emitted one order, `BA` then `AB` the
        // other. A canonical order matches them the same way and is a pure function of the
        // shape, which is what lets the CHECKER reason about field position at all — see
        // `fieldNameOrder`'s header for the D622 refusal that turns on exactly this.
        // The INLINE spelling already bucketed on a SORTED field-set id and matched BY FIELD
        // NAME (`annShapeIndexOf`), so this is still the named path reaching the answer the
        // inline path gives; `types/permuted-inline-shape-shares-row.vl` is that control.
        //
        // `tdFlat` IS THE RULING'S OWN EXCEPTION and the reason this is one condition rather
        // than a judgement: a `flat type`'s field order IS its layout (`memory/
        // flat-layout-grid.vl`: "order is layout, and nothing is reordered to pack better"),
        // so a flat record is never reordered.
        //
        // Reordering does not change WHICH fields a row has or their types — only the
        // sequence.
        const fOrder: i32[] = []
        let fq = 0
        while fq < fields.length {
          fOrder.push(fields[fq])
          fq = fq + 1
        }
        if s.tdFlat == 0 {
          const fnames: string[] = []
          let fp = 0
          while fp < fields.length {
            const fpn = P.nodes[fields[fp]]
            if fpn is FieldDef { fnames.push(fpn.fdName) }
            fp = fp + 1
          }
          if fnames.length == fields.length {
            const bOrd = fieldNameOrder(fnames)
            let rw = 0
            while rw < bOrd.length {
              fOrder[rw] = fields[bOrd[rw]]
              rw = rw + 1
            }
          }
        }
        let cnt = 0
        let fi = 0
        while fi < fOrder.length {
          const fnode = P.nodes[fOrder[fi]]
          if fnode is FieldDef {
            const code = fieldTypeCode(fnode.fdType)
            if code < 0 {
              // The field's own SPELLING, so the refusal can name what it refused
              // (`fieldTypeRefusalMsg`, D734). A non-`TypeRef` annotation has no name to
              // hand over and takes the general sentence.
              let fdNm = ""
              const fdT = P.nodes[fnode.fdType]
              if fdT is TypeRef { fdNm = fdT.tyName }
              return emitFail(fieldTypeRefusalMsg(fdNm))
            }
            // The ROW is `pushFieldRow`'s (the struct table). The recorded elem name IS
            // `fieldRefElemName`'s answer at code 16 (neither of `fieldRecElemName`'s two
            // arms fires), so the home's code-16 intern reads the same value it would.
            const recNm = fieldRecElemName(fnode.fdType, code)
            pushFieldRow(
              false,
              code,
              recNm,
              nodeTyMapKeyIsI32Span(fnode.fdType),
              fnode.fdName,
              "",
              fieldElemHintOf(fnode.fdType, code, recNm),
            )
            // A DEAD RENDER, deleted. This is `pushFieldRow`'s `tyText`, and the branch this
            // call takes (`toVariant == false`) never reads it — only the VARIANT branch has a
            // text column (`uFieldTyText`); the struct side has no `sFieldTyText` at all. The
            // annotation was being rendered on every struct field and discarded.

            // THE ARENA. `nodeTyMapKeyIsI32Span` and not the exact twin: this column is the mv
            // slot's KEY half (`mvSlotByValNameK`), so under-answering picks a wrong slot or
            // leaves one unminted, and the SPAN form is the one that matches
            // `mapSpellKeyName`'s cut.

            cnt = cnt + 1
          } else {
            return emitFail("emitProgram: malformed struct field")
          }
          fi = fi + 1
        }
        sFieldCount.push(cnt)
      }
    }
    i = i + 1
  }
  // Generic-alias APPLICATION shapes next (the declared structs they may
  // reference are interned above; their own names then resolve as code-15
  // struct-ref fields and annotation/literal sites).
  gaeCollectDecls(stmts)
  collectGenAliasShapes()
  // Inline object-TYPE annotation shapes first, so a literal whose values are
  // unclassifiable param reads (`{ x: n }`) still matches the annotation's shape.
  collectAnnShapes()
  collectAnonShapes()
}

// ── union collection (G1) ─────────────────────────────────────────────────────
// Parse the inline-shape variant `nm` (`{x:i32,y:string}`) into the flat
// union-variant field tables — the variant-table twin of `collectAnnShapes`'s
// field split (same depth-aware `,`/`:` grammar).
function collectShapeVariantFields(nm: string, shapeTy: i32) {
  const fnames: string[] = []
  const ftexts: string[] = []
  // The GROUP-INTERIOR cut at its home (`tyname.groupInnerOf`, W1). The guard is the
  // CALLER's — `collectVariantFields` gates on `nameIsShapeSpanEnds`.
  shapeInnerFieldSplit(groupInnerOf(nm), fnames, ftexts)
  uFieldStart.push(uFieldNames.length)
  // THE CANONICAL FIELD ORDER (D622) — the VARIANT table takes it too, and it has to:
  // `variantStructHeapTwinAt` (D280's cross-table merge) and `variantFieldLayoutEq` both
  // compare field CODES POSITIONALLY, so an arm laid out in declaration order beside a
  // declared struct twin laid out canonically is either a merge missed or — when the codes
  // line up while the NAMES do not — a merge taken with the fields in opposite slots.
  const cOrd = fieldNameOrder(fnames)
  let cnt = 0
  let fx = 0
  while fx < fnames.length {
    const fi = cOrd[fx]
    if fnames[fi] == "" {
      return emitFail("emitProgram: malformed inline union-variant shape")
    }
    const ftxt = ftexts[fi]
    // THE ARENA RUNG, where the shape's own type supplies it. An inline-shape variant carries
    // its fields in its text, so the SPLIT still gives the order and the names — but the
    // variant's arena type is resolved by the caller and is a `TyObj` on 160 of 160 corpus
    // files reaching here, so `objFieldTypes[fi]` is the same field's recorded type.
    //
    // `nameFieldCodeTy` takes `fieldCodeOfTy` first and falls back to this same name ladder on
    // -2, which is the CONFIRM-ONLY contract that rung already documents. Measured: the arena
    // decides 125 of the 160, the name the remaining 35, and the two never disagree.
    //
    // The length guard is not defensive bookkeeping — it is what makes the index correspondence
    // legitimate. If the split and the recorded shape ever disagree about field COUNT, position
    // `fi` is not the same field in both, and the arena rung must not be consulted at all.
    let fldTy = -1
    if shapeTy >= 0 {
      const shp = T.tys[shapeTy]
      if shp is TyObj {
        if shp.objFieldTypes.length == ftexts.length {
          fldTy = shp.objFieldTypes[fi]
        }
      }
    }
    let fc = nameFieldCodeTy(ftxt, fldTy)
    if fc < 0 {
      // A NESTED-STRUCT variant field (`{f: {f: f32}} | {w: i32}`): the shape-text twin of
      // `internInlineShape`'s -1→15 fallback. Validated PURELY here (`collectU` runs before
      // `collectS`, whose reset would wipe anything interned now); `collectA`'s variant
      // field pass interns the accepted shape, and acceptance is monotone — a field code
      // undecidable now can only IMPROVE by the time `internInlineShape` classifies it
      // (union registration only grows), so the deferred intern never fails.
      if variantNestedShapeOk(nonNulBaseOf(ftxt)) { fc = 15 }
    }
    if fc < 0 {
      return emitFail(
        "emitProgram: only i32 / boolean / string / array union-variant fields are supported",
      )
    }
    // The ROW is `pushFieldRow`'s (the variant table) — the same four columns and the same
    // two per-row side effects the two NODE recorders push. Only the elem-NAME derivation
    // is this recorder's own: it reads the field TYPE TEXT, where they read a `FieldDef`.
    // The SHAPE-TEXT recorder has no `FieldDef` node, so no row to hand over: -1 is
    // exactly today's call.
    pushFieldRow(
      true,
      fc,
      shapeFieldElemName(ftxt, fc),
      nameIsI32KeyedMap(ftxt),
      fnames[fi],
      variantFieldIdText(ftxt, fldTy),
      -1,
    )
    cnt = cnt + 1
    fx = fx + 1
  }
  uFieldCount.push(cnt)
  0
}

// Record the field names + per-field wasm-type codes of the `TypeDecl` named `name` into the
// flat `uFieldNames`/`uFieldStart`/`uFieldCount`/`uFieldTypes` table (declaration order = wasm
// field index). The struct must exist among the top-level statements and every field must
// carry a code, else fails loudly. Returns 0, or -1 (via `emitFail`).
function collectVariantFields(stmts: i32[], name: string) {
  // An INLINE-SHAPE variant (`{x:i32}` inside `{x:i32}|{y:i32}`) carries its
  // fields in its own text — parse them (the annotation-shape field grammar)
  // instead of looking for a TypeDecl.
  if nameIsShapeSpanEnds(name) {
    return collectShapeVariantFields(name, declTyIxOfName(name))
  }
  let i = 0
  while i < stmts.length {
    const s = P.nodes[stmts[i]]
    if s is TypeDecl {
      if s.tdName == name {
        uFieldStart.push(uFieldNames.length)
        const fields0 = s.tdFields
        // THE CANONICAL FIELD ORDER (D622) — the variant table takes it for the reason
        // `collectShapeVariantFields` states: the cross-table twin tests compare field codes
        // POSITIONALLY, so an arm and its declared struct twin must agree on the sequence.
        // A `flat` declaration keeps its declared order, exactly as the struct recorder does.
        const fields: i32[] = []
        const vnames: string[] = []
        let vp = 0
        while vp < fields0.length {
          const vpn = P.nodes[fields0[vp]]
          if vpn is FieldDef { vnames.push(vpn.fdName) }
          vp = vp + 1
        }
        if s.tdFlat == 0 && vnames.length == fields0.length {
          const vOrd = fieldNameOrder(vnames)
          let vq = 0
          while vq < vOrd.length {
            fields.push(fields0[vOrd[vq]])
            vq = vq + 1
          }
        } else {
          let vr = 0
          while vr < fields0.length {
            fields.push(fields0[vr])
            vr = vr + 1
          }
        }
        let cnt = 0
        let fi = 0
        while fi < fields.length {
          const fnode = P.nodes[fields[fi]]
          if fnode is FieldDef {
            const ftxt = tyNameOf(fnode.fdType)
            const nodeCode = fieldTypeCode(fnode.fdType)
            let code = nodeCode
            if code < 0 {
              // A NESTED INLINE-SHAPE variant field (`type Outer = { v: { v: i32 } }`) — the
              // NODE recorder's twin of `collectShapeVariantFields`'s -1→15 fallback, and the
              // ONE axis that parts this recorder's accepted fields from that one's. A field
              // naming a DECLARED struct already codes 15 through `fieldTypeCode`
              // (`nameIsStructDecl` reads the arena, which exists); an INLINE shape cannot,
              // because its only resolution is `structIndexOfTypeName` and `collectU` runs
              // before the struct table exists. Same deferral and same obligation as the
              // shape-text recorder's: `collectA`'s code-15 variant-field pass interns the
              // accepted shape once that table exists, and acceptance is monotone.
              if variantNestedShapeOk(nonNulBaseOf(ftxt)) { code = 15 }
            }
            if code < 0 {
              return emitFail(
                "emitProgram: only i32 / boolean / string / array union-variant fields are supported",
              )
            }
            // The struct twin's ladder exactly (`fieldRecElemName` for the name,
            // `pushFieldRow` for the row) — the variant table records the SAME name per code.
            // WHEN THE FALLBACK FIRED the name comes from the field TYPE TEXT instead:
            // `fieldRefElemName` re-derives `fieldTypeCode` internally, so for a shape that
            // entry point still cannot code it answers "" rather than the shape key the
            // deferred intern needs. `shapeFieldElemName(ftxt, 15)` is the shape-text
            // recorder's own answer, and for a code the node path DID produce the two agree.
            let elemNm = shapeFieldElemName(ftxt, code)
            if nodeCode >= 0 { elemNm = fieldRecElemName(fnode.fdType, code) }
            pushFieldRow(
              true,
              code,
              elemNm,
              nodeTyMapKeyIsI32Span(fnode.fdType),
              fnode.fdName,
              variantFieldIdText(ftxt, nodeTyIxOf(fnode.fdType)),
              fieldElemHintOf(fnode.fdType, code, elemNm),
            )
            // Same column, same reasoning — and `fnode` is still live here, 33 lines after
            // `ftxt` was rendered from it. An earlier pass filed this site as string-only by
            // looking at the ARGUMENT's surface form rather than at what was in scope.

            cnt = cnt + 1
          } else {
            return emitFail("emitProgram: malformed union-variant field")
          }
          fi = fi + 1
        }
        uFieldCount.push(cnt)
        return 0
      }
    }
    i = i + 1
  }
  emitFail("emitProgram: union variant names an unknown struct type")
}

// True if variants `a` and `b` are the SAME TYPE per field — the field-TYPE half of variant
// identity, whose name half is `variantSig`. The `assignTags` reject below exempts a pair
// this answers true for, and the exemption means "these two arms ARE one variant", so the
// question asked here has to be IDENTITY.
//
// STORAGE IS NOT IDENTITY, AND KEYING THE EXEMPTION ON STORAGE WAS A SILENT WRONG ANSWER.
// One wasm-type code covers several VL types — `i32` and `boolean` are both code 0 — so
// `{a: i32} | {a: boolean}` presented as the layout-equal twin the exemption exists for:
// both arms ranked tag 0 and both `is` tests lowered to the same `i32.const 0` compare, the
// exact silent miscompile the reject exists to convert into a message. The `uFieldTyText`
// column is the field's own type spelling, so the pair now parts on the same question
// `{a: i32} | {a: f64}` and `{a: i32} | {a: string}` already parted on.
//
// Type text is the discriminator that a code cannot be; the code and elem-name comparisons
// stay because they are the STORAGE half and answer for spellings the text cannot separate
// on its own. This runs inside `collectU`, the FIRST emit pass, so the ref-list / struct /
// map slot tables `variantFieldLayoutEq` consults do not exist yet — a code difference is a
// sufficient (not necessary) witness of divergent storage, which is all the reject needs.
//
// A transparent alias is not a false reject: `canonEmitTypeNames` rewrites every annotation
// into its canonical emit name before any emit pass, so `type Id = i32` reaches this column
// as `"i32"` and `{a: Id} | {a: i32}` stays the one variant it is.
function variantFieldTysEq(a: i32, b: i32) {
  if uFieldCount[a] != uFieldCount[b] { return false }
  let fi = 0
  while fi < uFieldCount[a] {
    if uFieldTypes[uFieldStart[a] + fi] != uFieldTypes[uFieldStart[b] + fi] {
      return false
    }
    if (
      uFieldTyText[uFieldStart[a] + fi] !=
      uFieldTyText[uFieldStart[b] + fi]
    ) {
      return false
    }
    if (
      uFieldElemName[uFieldStart[a] + fi] !=
      uFieldElemName[uFieldStart[b] + fi]
    ) {
      return false
    }
    // The KEY half of a map field's storage (B6b): the elem-name column above records
    // only `V`, so `{f: {[i32]: i32}}` and `{f: {[string]: i32}}` compare EQUAL there
    // while storing two different map structs. Same table, same row, one column over.
    if uFieldElemKeyI32At(a, fi) != uFieldElemKeyI32At(b, fi) { return false }
    fi = fi + 1
  }
  true
}

// Assign each variant its GLOBAL tag = its rank when the variants are ordered by
// structural signature (mirroring `toWasm.ts`'s sorted `variantKey` tag assignment).
// `uTags[i]` is variant i's tag: the number of variants whose sig sorts strictly
// before variant i's (sigs are distinct, so this is a dense 0..n-1 permutation).
function assignTags() {
  // A registration helper's `emitFail` -1 that a caller SWALLOWED (the map-atom and
  // ref-array-atom `registerInlineUnion` recursions discard theirs) leaves the variant
  // row tables HALF-WRITTEN: `collectShapeVariantFields` pushes `uFieldStart` before it
  // can reject a field, so the rejected variant owns a start with no count. Ranking then
  // reads `uFieldCount`/`uFieldNames` past their end and TRAPS THE COMPILER instead of
  // reporting the recorded failure. A failed emit has nothing left to rank — bail on the
  // flag, so the loud message reaches the user (`emitProgram`'s post-`emitModule` catch
  // is too late; this pass runs first).
  if emitFailed { return -1 }
  // The signatures, computed ONCE (the rank loop below reads each O(n) times, and a
  // variant-heavy union — the compiler's own `Node` — has dozens of them).
  const sigs: string[] = []
  let si = 0
  while si < uVariants.length {
    sigs.push(variantSig(si))
    si = si + 1
  }
  // A union whose variants are NOT discriminable: two members of the SAME union sharing a
  // field-NAME set (`{v:i32} | {v:string}`, or its nominal / generic-application spellings)
  // collide on `variantSig` — which IS the tag key — so both rank the same and every `is`
  // test on either answers for both. Worse, the literal → variant resolution matches by
  // field-name set alone, so the second member's literal builds the FIRST member's struct:
  // `const b: {v:i32} | {v:string} = { v: "s" }` stored a string ref into an i32 field —
  // SILENT INVALID WASM. Field names are the discriminator VL's structural unions are built
  // on (`docs/guide/unions.md`), so such a union has no sound representation; reject it
  // loudly here rather than emit the bad module. Layout-EQUAL same-name variants (the same
  // shape reached through two spellings) stay legal — they are one variant, and the twin
  // machinery already folds them.
  let ui = 0
  while ui < unVarStart.length {
    const vs0 = unVarStart[ui]
    const vc = unVarCount[ui]
    let a = 0
    while a < vc {
      let b = a + 1
      while b < vc {
        if sigs[vs0 + a] == sigs[vs0 + b] {
          if !variantFieldTysEq(vs0 + a, vs0 + b) {
            return emitFail(
              "emitProgram: union `" +
                unNames[ui] +
                "` cannot be discriminated — variants `" +
                uVariants[vs0 + a] +
                "` and `" +
                uVariants[vs0 + b] +
                "` have the same field names but different field types",
            )
          }
        }
        b = b + 1
      }
      a = a + 1
    }
    ui = ui + 1
  }
  uTags = []
  let i = 0
  while i < uVariants.length {
    const sigI = sigs[i]
    let rank = 0
    let j = 0
    while j < uVariants.length {
      if j != i {
        if strLess(sigs[j], sigI) { rank = rank + 1 }
      }
      j = j + 1
    }
    uTags.push(rank)
    i = i + 1
  }
  0
}

// The six single-shape tests below call `emit_classify.nameIsWholeSpanShape` directly: the
// local `nameIsSingleShape` it replaced was CHARACTER-IDENTICAL to it once D-SPANHOME stopped
// that resolver hand-walking the braces. Its −6 on the 23-resolver list is a NAMING ARTIFACT —
// the same six questions, under a name the list does not count; the real deletion was the WALK,
// which was never on either list.

// THE ONE HOME of "a bare MAP's VALUE union needs registering too". `registerInlineUnion`
// reaches a map from FOUR positions — a map ATOM of a multi-member union, a NULLABLE map,
// a nul-closure RESULT map, and the bare top-level map — and each spelled out the same
// `mapValNameOf` + non-empty test + recursion. The four are the same rule ("the map itself
// needs no registration, its VALUE does"), and the four bug reports in their comments are
// four discoveries of that ONE rule at four positions.
//
// Returns `-2` when the map has NO value name (the "did not fire" answer, which `0` cannot
// carry — `registerInlineUnion` already uses `0` for success), else `registerInlineUnion`'s
// own `0` / `-1`. The three callers that RETURN on a fire test `!= -2`; the fourth (the
// atom loop) ignores the result exactly as it did.
function registerMapValUnion(stmts: i32[], mapName: string) {
  const mv = mapValNameOf(mapName)
  if mv == "" { return -2 }
  registerInlineUnion(stmts, mv)
}

// THE ONE HOME of "the RESULT ATOM of a closure SPELLING": strip the grouping parens a
// closure carries in a composite position (`(() => i32 | boolean) | null` splits to the
// arm `(() => i32 | boolean)`), take the text after its TOP-LEVEL `=>`, and normalize
// that result the way a union arm is normalized. "" when the spelling carries no
// top-level arrow — which is also every caller's "not a closure" answer.
//
// The three resolvers compose in a fixed ORDER and only in this order: peel BEFORE the
// arrow scan (an unpeeled `(() => T)` hides its arrow at depth 1), normalize AFTER it
// (the peel that matters for the RESULT is the result's own, not the closure's).
// `registerInlineUnion`'s nul-closure arm and `nulCloMixedUnionUnregistered` each wrote
// the composition out verbatim; they ask the same question of the same kind of name.
function cloResultAtomOf(name: string) {
  normTypeAtom(annRetNameOf(peelGroupParens(name)))
}

// Register the inline union synthetic name `name` (e.g. `"A|B"`) as a union alias in
// the per-union tables, exactly as `collectU` registers a `UnionDecl`: record the
// name + its variant-slice range, append each member to the GLOBAL `uVariants` list,
// and collect each member's fields into the flat table. A no-op if `name` is already
// a registered union (a named alias OR a previously-seen inline annotation), or if it
// is not an inline struct-variant union. Returns 0, or -1 (via `emitFail`).
function registerInlineUnion(stmts: i32[], name: string) {
  if isUName(name) { return 0 }
  // A VALUE union (`i32 | null`, `string | i32`, `i32 | f64`) registers the name
  // alone — it owns NO variant structs (its members are scalar atoms whose tags
  // come from `scalarTagOf` and whose payloads ride the shared value boxes), so
  // its variant slice is empty. Registering interns the shared box (`uDeclared`)
  // and the per-rep value boxes it needs. A litunion-ALIAS-armed value union
  // (`K0 | i64`) registers the same way — its alias arm rides the box as the
  // member-string atom (`registerValueUnionName` admits both).
  if isValueUnionName(name) || nameIsLitUnionArmValueUnion(name) {
    return registerValueUnionName(name)
  }
  // A MAP member of a 2+-member union (`{[string]: string} | f64`) rides the variant box like a
  // ref-array arm: its map STRUCT ref sits on the box anyref, tagged by `mapSlotTag`. Register it
  // through the `isVariantBoxUnion` path below and return EARLY — a map-FIRST union name matches
  // `nameIsMap` (it starts `{[`), so the map-value recursion further down would otherwise swallow
  // the whole union name as a garbled map value. A map alongside an UNSUPPORTED neighbour (one
  // `isVariantBoxUnion` still rejects) stays a LOUD fail rather than a silent mis-tagged box. A
  // map-VALUED union (`{[string]: C | S}`) splits to one atom (the `|` sits inside the braces), so
  // `matoms.length < 2` and it passes through to the value recursion untouched.
  const matoms: string[] = []
  splitUnionAtoms(name, matoms)
  if matoms.length >= 2 {
    let mNonNull = 0
    let mHasMap = false
    let mk = 0
    while mk < matoms.length {
      const ma = matoms[mk]
      if ma != "null" {
        mNonNull = mNonNull + 1
        // The MAP-NAME OPENER at its home — the three compares this spelled out, character
        // for character including the bound. It is deliberately NOT `nameIsMap`, which is
        // this predicate minus the arrays: an arm that is a LIST of maps
        // (`{[string]:i32}[] | f64`) still makes the WHOLE union name open `{[`, so it must
        // still set this flag or the map-VALUE recursion below swallows the union name. That
        // is the narrowing `nameIsMapOpen`'s header warns about, seen from its one caller.
        if nameIsMapOpen(ma) { mHasMap = true }
      }
      mk = mk + 1
    }
    // A single map + `null` is exempt: `{[string]:i32}|null` is the NULLABLE map, owned by the
    // nullable machinery (not a box union). Only a map alongside another non-null member is the
    // box-union shape handled here.
    if mHasMap && mNonNull >= 2 {
      // Supported ⇒ fall through to the `isVariantBoxUnion` registration below (the `nameIsMap`
      // value-recursion is skipped via its `matoms.length < 2` guard, so this map-FIRST union
      // name is not mis-parsed). Unsupported neighbour ⇒ a LOUD fail, never a silent mis-tag.
      // `matoms` IS `splitUnionAtoms(name)` — the split this predicate would redo — so it
      // takes the ATOM form (`splitUnionAtoms` is pure in `name` alone).
      if !isVariantBoxUnionAtoms(stmts, matoms) {
        return emitFail(
          "emitProgram: a map union member is not supported — use a struct member instead",
        )
      }
    }
    // A REF-ARRAY ATOM of a 2+-member union (`({a,f,z} | i32)[][] | i32`): its (possibly
    // nested) ELEMENT union needs registration too — the atom is not a standalone
    // annotation, so the nested-array / `pun` recursions below (which see only the WHOLE
    // name) never reach it. Un-registered, the box-element build's `emitUnionBoxArg`
    // fell through to a RAW struct element in the box-element array — INVALID-WASM
    // (fuzz sweep5 plain leg, seed 685652043 case_00254). Non-returning: the OUTER
    // union still registers through the dispatch below.
    let ak = 0
    while ak < matoms.length {
      const aa = matoms[ak]
      if aa != "null" && nameIsArray(aa) { registerInlineUnion(stmts, aa) }
      // A MAP ATOM's VALUE union (`{[string]: f64 | {w: i32}} | i64`): the map arm
      // itself registers through `isVariantBoxUnion` below, but its VALUE union is
      // a separate rep — un-registered, the value union's scalar arms never mark
      // their value boxes (`vbF64Used` stayed false) and BOTH the `?? 14.5`
      // default's boxing and the narrowed `is f64` read minted the box at the
      // DEFAULT type index (the i32 box): INVALID-WASM (fuzz post-#990 sweep
      // plain leg, seed 75710791 case_00323). The map-value sibling of the
      // ref-array atom recursion above; `nameIsMapMemberUnion` keeps a map-FIRST
      // union name from being mis-read as a bare map.
      if aa != "null" && nameIsBareMap(aa) { registerMapValUnion(stmts, aa) }
      ak = ak + 1
    }
  }
  // A union used ONLY as a COLLECTION element / value (`(C | S)[]`, `{[string]: C | S}`)
  // registers that INNER union — without this a union that never appears in a param /
  // return / let / field annotation (only inside a collection) is never interned, so an
  // `is` over a read element fails ("`is` test but no union type declared"). RECURSE on the
  // inner name through the same dispatch: a VALUE element union → the shared box (the
  // `(string|i32)[]` case `parenUnionArrElemName` already covered), a STRUCT / heterogeneous
  // element union → its variant structs, and a non-union inner (`i32`, a struct, a registered
  // alias) → a self-gated no-op. Map values nest (`{[string]: (C|S)[]}` → `(C|S)[]` → `C|S`).
  const pun = parenUnionArrElemName(name)
  if pun != "" { return registerInlineUnion(stmts, pun) }
  // A NULLABLE ref array (`(f64 | {w: i32})[] | null`, `(K0[] | {w: i32})[] | null`): the `| null` niche
  // itself is owned by the nulreflist machinery, but its INNER element union still needs registration
  // (the shared value box + per-rep / variant reps). `isValueUnionName` is false here (the non-null arm is
  // a ref array, not a scalar atom) and `parenUnionArrElemName` / `nameIsArray` both miss it (the name ends
  // in `null`, not `]`), so without this the element union box is never interned and the reflist element
  // mis-lowers (the raw arm value stores into a ref slot — INVALID-WASM). Strip the `| null` and recurse on
  // the non-null ref-array name, which then hits the `pun` recursion above for its element union.
  const rnp = nullablePartOf(name)
  if rnp != "" && nameIsRefArray(rnp) { return registerInlineUnion(stmts, rnp) }
  // A NULLABLE inline SHAPE (`{a, f: {[string]: V} | {w: i32}, z} | null` — the niche
  // nullable struct): the `| null` itself is owned by the nulstruct machinery, but the
  // base shape's FIELD unions still need registration — un-registered, the field codes -1,
  // the base shape fails to intern, and the init literal finds no struct ("field count
  // does not match"). Strip the `| null` and take the single-shape descent below, the
  // nullable twin of the array-of-inline-shape recursion.
  if rnp != "" && nameIsWholeSpanShape(rnp) {
    return registerInlineUnion(stmts, rnp)
  }
  // A NULLABLE MAP with a union VALUE (`{[string]: {[string]: f64} | i32} | null`): the
  // `| null` niche is owned by the nullable-map machinery, but the VALUE union still
  // needs registration — un-registered, the narrowed `t0[k] ?? d` coalesce boxed the
  // default into an UN-MINTED `uBoxIdx` (type index 0 — the i32 array): INVALID-WASM
  // (fuzz-nightly seed 796355240 d4). Recurse on the value name through the same
  // dispatch: a supported union registers its box; an unsupported map-member neighbour
  // keeps `isVariantBoxUnion`'s LOUD fail. The nullable twin of the bare-map value
  // recursion below.
  if rnp != "" && nameIsBareMap(rnp) {
    const nmr = registerMapValUnion(stmts, rnp)
    if nmr != -2 { return nmr }
  }
  // A NULLABLE closure (`(() => i32 | boolean) | null`, kind 19): the `| null` niche is
  // owned by the nulclosure machinery, but the INNER closure's VALUE-union RESULT still
  // needs registration — un-registered, the null-narrowed inner call's `>u` box result has
  // no `uBoxIdx` (`uDeclared` stays false) and the value call rejects loudly (the
  // `cloCallUnionResultUnrepresentable` CASE-A floor). GATED to a pure VALUE union
  // (`isValueUnionName` — scalar atoms + null) or a MAP-member union
  // (`(() => {[string]: i32} | boolean) | null` — the map arm rides the box tagged via
  // `mapSlotTag`, and the narrowed read's map scratch frame is reserved by
  // `unionMapArmIdent`'s typed-IR net): any OTHER composite union result stays loud —
  // registering it would satisfy the CASE-A floor while the box read mis-lowers
  // (verified REJECT→INVALID-WASM).
  if rnp != "" && nameIsNulClosure(name) {
    const ncRes = cloResultAtomOf(rnp)
    if ncRes != "" {
      if isValueUnionName(ncRes) || nameIsMapMemberUnion(ncRes) {
        return registerInlineUnion(stmts, ncRes)
      }
      // A VARIANT-BOX union result (`(() => K0 | {w:i32} | f64 | null) | null`): the
      // contextual pin covers it (the checker's `variantBoxUnionRetName` regroups the
      // flattened litunion arm and `synthRetAnnots`'s `isUName` arm pins the lambda),
      // so the registered box lowers through the annotated named-fn path — register it
      // so the pin arm fires. An arm `isVariantBoxUnion` still rejects stays LOUD.
      if isVariantBoxUnion(stmts, ncRes) {
        return registerInlineUnion(stmts, ncRes)
      }
      // A BARE-MAP result (`(() => {[string]: i32 | string | {q: i64}}) | null`):
      // the map itself needs no registration, but its VALUE union does — the gate
      // above sees neither a value union nor a map-MEMBER union, so the value
      // union's box/variant types were never minted and the narrowed `t0()[k] ?? d`
      // read referenced the DEFAULT type index ("expected struct type at index 0,
      // found (array (mut i32))") — INVALID-WASM (fuzz post-#996 sweep branching
      // leg, seed 499060527 case_00095). The nul-closure sibling of the bare-map
      // value recursion below and the #991 map-atom walk.
      if nameIsBareMap(ncRes) {
        const ncMr = registerMapValUnion(stmts, ncRes)
        if ncMr != -2 { return ncMr }
      }
      // An ARRAY result whose ELEMENT is a value-union (`(() => ({[string]: string} |
      // f64)[]) | null`): the ref array itself needs no registration, but its element
      // union does — un-registered, the narrowed `t0()[0]` element box has no minted
      // `uBox` and both the box build and the `is` read default to type index 0
      // ("expected struct type at index 0, found (array (mut i32))") — INVALID-WASM
      // (fuzz sweep YKq9Jw multiobs, seed 58637234). The NON-nullable closure result
      // reaches this via the function-type arm below (which recurses on the ref-array
      // and hits `parenUnionArrElemName`); the `| null` wrapper never gets there.
      // `registerInlineUnion` self-gates on the element (a non-union element no-ops).
      if nameIsRefArray(ncRes) { return registerInlineUnion(stmts, ncRes) }
    }
  }
  // A NESTED array of an inline union (`(C|D)[][]`, `(C|D)[][][]`): `parenUnionArrElemName` only
  // matches a SINGLE-bracket `(…)[]`, so strip the OUTER `[]` and recurse on the element list,
  // reaching the inner union at any depth — the registration dual of the recursive ref-array
  // interning. Bottoms out at the 1D `(…)[]` (the `pun` path above).
  if nameIsArray(name) {
    // The cut is `arrElemNameRaw`'s (#1175); the TEST half was already the home's.
    const inner = arrElemNameRaw(name)
    if nameIsArray(inner) { return registerInlineUnion(stmts, inner) }
    // A 1D ARRAY-OF-INLINE-SHAPE element (`{a: f64, f: K0 | {w: i32}, z: string}[]` — a struct FIELD
    // that is an array of a struct carrying a value-union FIELD): stripping one `[]` yields a SINGLE
    // inline shape, NOT an array, so the `nameIsArray(inner)` recursion above stops and the element
    // shape's field union (`K0 | {w: i32}`) is never registered. Its field then codes -1 in
    // `internInlineShape` (`nameFieldCode` returns -1 for an unregistered heterogeneous union), so the
    // inner struct FAILS TO INTERN — and the reflist element resolves to the OUTER struct (all three
    // shapes share field names a/f/z), storing the wrong reps: INVALID-WASM. The element shape's
    // field unions are now registered by `collectTyReachRegister`'s structural walk (the retired
    // `registerShapeFieldUnions` name split used to reach them via this recursion); this call is a
    // self-gated no-op for a single shape (the `nameIsWholeSpanShape` decline below) but is kept as
    // the union-REGISTRATION peel twin of `internShapeDeep`'s single-`[]` SHAPE peel, so a future
    // top-level-union element (not a bare shape) still registers here.
    if nameIsWholeSpanShape(inner) { return registerInlineUnion(stmts, inner) }
  }
  // A bare MAP annotation with a union VALUE (`{[string]: C | S}`) registers that inner value union;
  // the `matoms.length < 2` guard restricts this to a bare map (one top-level atom) so a map-
  // MEMBER union (`{[string]: i32} | boolean`, which also matches `nameIsMap` — it starts `{[`) is
  // NOT mis-parsed as a map value but instead falls through to the `isVariantBoxUnion` box path.
  if nameIsMap(name) && matoms.length < 2 {
    const mvr = registerMapValUnion(stmts, name)
    if mvr != -2 { return mvr }
  }
  // A function-type annotation (`(i32) => C | S`) carries an inline union in its RETURN (a closure
  // value whose result is a union). Register that return union so a value call's result narrows —
  // the function type itself is not a union. Mirrors the array/map element recursion above.
  // The PAREN grammar's OPEN half at its home (`emit_base`), spelling-for-spelling: the
  // `length > 0` bound this carried IS the home's own.
  if nameIsParenOpen(name) {
    const fnRes = annRetNameOf(name)
    if fnRes != "" { return registerInlineUnion(stmts, normTypeAtom(fnRes)) }
  }
  // An inline STRUCT-SHAPE annotation (`{f: A | B}`, `{a: C | i32, b: {g: D | E}}`) carries its
  // unions in its FIELDS, not at the top level. The `registerShapeFieldUnions` NAME split that
  // used to descend the shape body here is RETIRED: `collectTyReachRegister`'s structural walk
  // reaches every field union directly (its `TyObj` arm recurses each field type, its `TyFunc`
  // arm the closure-field results), and it renders them with the SAME position-dependent litunion
  // softening the shape NAME carries (`reachRegisterName`'s `underFunc` gate — a func-nested
  // field's `K0|boolean` stays faithful, a direct field softens to `string|boolean`), so the
  // arena registration keys EXACTLY match. The walk runs BEFORE this name call at every
  // annotation site (bucket-(c) ordering), so a shape's field unions are interned before its own
  // row — the ordering the name split preserved. A single shape has no top-level union to
  // register here, so decline.
  if nameIsWholeSpanShape(name) { return 0 }
  // The atom form again: `matoms` is still `splitUnionAtoms(name)` here — nothing between
  // the split at the top of this function and this line rewrites either `name` or `matoms`.
  if !isVariantBoxUnionAtoms(stmts, matoms) { return 0 }
  // Field unions of the shape arms must already be registered HERE (they push their
  // own un*/uVariants rows — after this union's rows are pushed, an interleaved
  // registration would corrupt its variant slice). The arm-field pre-registration is
  // ARENA-DRIVEN now: `collectTyReachRegister`'s members-first `TyUnion` descent (and
  // `rootUnionDeclMembers` for a named `UnionDecl`) registers each arm's field unions
  // BEFORE the outer union's name reaches this point — the retired
  // `registerVariantArmFieldUnions` name split used to do it inline here.
  uDeclared = true
  unNames.push(name)
  unTyIx.push(declTyIxOfName(name)) // B-1 step 1: resolve ONCE at mint, like `sTyIx`
  unDeclIx.push(-1) // inline union: no declaration node
  unMemberSet.push(name)
  recordUnMemTys(name) // D-UNION foundation
  // D-UNION set ADT — the member list below is the row JUST recorded, not a second
  // split of the same string: `recordUnMemTys` splits `name` ONCE and appends exactly
  // `unMemTyCount` verbatim spellings to `unMemAtoms`, so the column's TAIL is that
  // atom list. Reading it back is total by construction (it holds even across the
  // recorder's own self-heal reset, which clears the reference columns and refills
  // them in the same call), which is why this parse is DELETED rather than laddered.
  const atoms: string[] = []
  // The member ROWS, snapshotted in the SAME loop as the spellings. `unMemTys` is parallel
  // to `unMemAtoms` by construction, so slot `i` of these two locals is one member in two
  // encodings — and taking the copy HERE (rather than indexing the column later) keeps it
  // valid across the recursive registration below, which can append to the columns and, on
  // the recorder's self-heal path, clear and refill them.
  const atomTys: i32[] = []
  const uRow = unNames.length - 1
  const uMemN = unMemTyCount[uRow]
  const uMemBase = unMemAtoms.length - uMemN
  let uMemI = 0
  while uMemI < uMemN {
    atoms.push(unMemAtoms[uMemBase + uMemI])
    atomTys.push(unMemTys[uMemBase + uMemI])
    uMemI = uMemI + 1
  }
  unVarStart.push(uVariants.length)
  // Only STRUCT members occupy variant slots (a `null` atom rides the tag, a value-atom
  // tags via `scalarTagOf` and boxes into the shared value boxes). Count + push the
  // struct variants; mark the value-box reps the scalar atoms need (the MIXED case).
  let nStructs = 0
  let cnt = 0
  while cnt < atoms.length {
    if atoms[cnt] != "null" {
      if isStructAtom(stmts, atoms[cnt]) { nStructs = nStructs + 1 }
    }
    cnt = cnt + 1
  }
  unVarCount.push(nStructs)
  let vi = 0
  while vi < atoms.length {
    if atoms[vi] != "null" {
      if isStructAtom(stmts, atoms[vi]) {
        uVariants.push(atoms[vi])
        // THE ROW `recordUnMemTys` ALREADY RESOLVED, one pass earlier and from this very
        // atom. `declTyIxOfName` re-ran the whole name->row ladder (`cUserTypes`, then the
        // primitive and composition rungs) for an answer sitting in the parallel column.
        // Measured over the corpus: 416 resolutions, 0 disagreements.
        uVarTyIx.push(atomTys[vi])
        if collectVariantFields(stmts, atoms[vi]) < 0 { return -1 }
      }
    }
    vi = vi + 1
  }
  // A MIXED union's scalar members box exactly like a value union's — intern their
  // per-rep value boxes (a no-op for an all-struct union: no value atoms).
  markValueUnionAtoms(name)
  // A REF-ARRAY arm (`S[] | {w:i32}`) interns its element shape (so `structIndexByName` sees an
  // inline `{a:f32}[]` element) and its reflist slot — the ref-array twin of the value-atom
  // marking. `collectA` re-interns the reflist slot after its resets; this early call ensures
  // the element STRUCT is in `sNames` before heap assignment. (No-op with no ref-array arm.)
  markRefArrayArms(name)
  // A ref-array arm whose ELEMENT is ITSELF a union (`(C | D)[] | {w:i32}`,
  // `(i32 | string)[] | {w:i32}`) registers that inner element union — the arm-position
  // twin of the whole-name `parenUnionArrElemName` recursion above (which only fires when
  // the ENTIRE annotation is `(…)[]`). Without it a STRUCT element union's variants never
  // intern (`objVariantName` can't resolve a `[{a:1}]` element literal, `x[0] is C` has no
  // variant) and a VALUE element union's box reps are never marked. Alias elements (`N[]`)
  // resolve through their own registration; the `unionMemberCount > 1` gate keeps plain
  // struct/closure elements (`S[]`, `(() => f64)[]`) on their existing no-op path.
  let rai = 0
  while rai < atoms.length {
    const raa = atoms[rai]
    // THE ROW AS A NECESSARY CONDITION. Every arm of the test below requires the member to
    // be an ARRAY — `nameIsRefArray` is a ladder (`annArrowAt`, `nameIsLitUnionArray`,
    // `refArrShapeKind`, then a struct/union TABLE scan) that can only say yes for one. So a
    // recorded row that is not a `TyArray` decides the whole conjunction false without
    // running any of it, and without `valueAtomKind` splitting the atom either.
    //
    // Only the NEGATIVE is taken from the arena: a row that IS an array still goes through
    // the full name test, because the positive answer depends on nominal table membership
    // the row does not carry. Measured: 803 of 882 positions decided by the row, 79 passed
    // through, 0 disagreements.
    let raMaybe = true
    if rai < atomTys.length {
      const rr = atomTys[rai]
      if rr >= 0 {
        const rt = T.tys[rr]
        raMaybe = false
        if rt is TyArray { raMaybe = true }
      }
    }
    if (
      raMaybe &&
      raa != "null" &&
      valueAtomKind(raa) < 0 &&
      nameIsRefArray(raa)
    ) {
      const ren = refArrElemName(raa)
      if ren != "" && unionMemberCount(ren) > 1 {
        if registerInlineUnion(stmts, ren) < 0 { return -1 }
      }
    }
    rai = rai + 1
  }
  // A MAP arm (`{[string]: string} | f64`) interns its value shape + forces the shared map heap
  // flags — the map twin of the ref-array marking. `collectA` re-interns after its mv-table reset;
  // this early call keeps the inline + named spellings identical. (No-op with no map arm.)
  markMapUnionArms(name)
  0
}

// ── usage-driven `let x = null` nullable-hole inference (A-infer-null) ───────
// The host's hole-bearing `null`: an UN-ANNOTATED `let x = null` is NOT pinned to
// the exact `null` type — a later assignment `x = e` fills the hole's `T`, so `x`
// is the value union `T | null`. The native mirror infers `T` once at collection
// time (the FIRST classifiable assignment in the binding's enclosing statement
// list, descending into branch/loop blocks but NOT nested function bodies — their
// same-named locals are different bindings), registers `T|null` as a value union
// (interning its box reps), and records it per LetDecl arena index so every later
// classifier (`letIsUnion` / `letUnionNameOf` / `globalCellKind`) sees the union.
// (The `nliLetIxs`/`nliNames` tables are declared with the narrowing stack —
// module-level `let`s must precede their first textual use site.)

// Infer + register the null hole of the un-annotated `let x = null` at
// `walk[i]`, scanning the REST of `walk` for the filling assignment.
function nliInferLet(walk: i32[], i: i32) {
  const s = P.nodes[walk[i]]
  if s is LetDecl {
    if s.letType < 0 && s.letInit >= 0 {
      const ini = P.nodes[s.letInit]
      if ini is NullLit {
        const atom = nliScanStmts(walk, i + 1, s.letName)
        if atom != "" {
          const nn = atom + "|null"
          registerValueUnionName(nn)
          nliLetIxs.push(walk[i])
          nliNames.push(nn)
        }
      }
    }
  }
  0
}

// Infer + register the value union of an un-annotated `const x = <if-expression>` at
// `walk[i]` — the if-expression counterpart of `nliInferLet`. Records it in the same
// `nli` tables so `nliNameOf` drives the slot classification (`letIsUnion` → kind 4 box)
// and the binding-init emit (`emitNullableIfBinding` via `letUNm`), reusing the
// annotated-binding lowering with NO annotation. The union NAME comes from the CHECKER's
// inferred-binding export (`inferLetNameOf`) — which already resolved the arm types
// (so an ident/expression arm `if c { v } else { null }` works) and the numeric-widening
// join (`if c { 1 } else { 2.5 }` is f64, not a union) — falling back to a static atom
// derivation (`ifExprNliName`) for any binding the export does not carry.
function nliInferIfLet(walk: i32[], i: i32) {
  const s = P.nodes[walk[i]]
  if s is LetDecl {
    if s.letType < 0 && s.letInit >= 0 {
      if exprIsIfStmt(s.letInit) {
        let nn = inferLetNameOf(walk[i])
        if nn == "" { nn = ifExprNliName(s.letInit) }
        if nn != "" {
          registerValueUnionName(nn)
          nliLetIxs.push(walk[i])
          nliNames.push(nn)
        }
      }
    }
  }
  0
}

// Infer + register the value union of an un-annotated `const t = a?.w` at `walk[i]` —
// the OPTIONAL-CHAIN counterpart of `nliInferIfLet`, recorded in the same `nli` tables
// for the same two reasons: `nliNameOf` makes `letIsUnion` classify the cell as the
// kind-4 box, and `letUnionNameOf` gives the narrowed READ the member set it unboxes
// through. Only the union NAME is shared; the if-expression's own binding lowering
// (`emitNullableIfBinding`) is gated on `exprIsIfStmt`, so a `?.` init falls through to
// the ordinary init path.
//
// THIS IS THE ONLY ROUTE FOR THIS TYPE. `i32 | null` here is synthesized by the checker
// from `S | null` plus an `i32` field — it is spelled in no annotation anywhere in the
// program, so every other registration route (a `type` declaration, an annotation walk,
// an inferred return) has nothing to see. Without it the box heap type is never minted
// and `emitOptMemberValue` has no rep to build, which it reports rather than guessing.
function nliInferOptChainLet(walk: i32[], i: i32) {
  const s = P.nodes[walk[i]]
  if s is LetDecl {
    if s.letType < 0 && s.letInit >= 0 {
      const ini = P.nodes[unwrapParen(s.letInit)]
      if ini is OptMember {
        const nn = inferLetNameOf(walk[i])
        if nn != "" {
          registerValueUnionName(nn)
          nliLetIxs.push(walk[i])
          nliNames.push(nn)
        }
      }
    }
  }
  0
}

// ── UNIFIED ARENA REGISTRATION WALK ─────────────────────────────────────────
// The structural sibling of `collectInlineUnionsIn`'s NAME walk: given an annotation
// node's resolved arena type `tyIx` (from `nodeTyIxOf`), recurse over the `T.tys`
// shape and register EVERY reachable `TyUnion` via `registerInlineUnion`. The name
// walk registers a union only where a `tyToEmitName`/`tyNameOf` text render happens
// to surface it (fnRet / parType / letType / fdType spellings + the accreted
// `registerInlineUnion` recursions for the positions we thought to enumerate); a
// union buried in a NOVEL nesting position (a value union in a map value inside a
// closure-result struct field inside a union arm, etc.) is reachable in the arena but
// was never enumerated by a name-walk recursion — the recurring "missed-descent"
// bug (#983/#989/#991/#1000/#1002 all added ONE new descent each). This walk makes
// the miss structurally impossible: it descends through EVERY composite variant
// uniformly, so a reachable union registers regardless of how deeply / unusually it
// nests.
//
// RENDER DISCIPLINE (the #1027 name-faithful renderer): a `TyUnion` is rendered with
// `tyToNominalName` (nominal-first — a declared struct/union keeps its source NAME, so
// the synthetic key matches the nominal `structIndexByName`/`isUName` lookups instead
// of a structural twin), then `canonEmitName` is applied ONCE over the WHOLE render
// (position-dependent litunion softening can only be decided with the surrounding
// func-type structure visible — never per-arm). The result is EXACTLY the key the name
// walk would have produced for that union, so registrations UNION IN: a union the name
// walk already reached is an `isUName` no-op here, and the arena walk only ADDS the
// ones the name walk missed. The register-growth oracle (#1027) is 0 over the corpus.
//
// Depth-capped at 16 (recursive struct/array/map types are cyclic in the arena; the
// nominal short-circuit in `tyToNominalName` already tames named recursion, the cap
// guards the anonymous case). Registration-ONLY: a `TyFunc` is descended for reachable
// unions in its params/result, but its closure SIGNATURE is NOT interned here (sig
// descent is the next slice — the slot digits are nominal-sensitive and need the
// run-diff gate). Returns 0, or -1 (a `registerInlineUnion` `emitFail`).
// ── THE ONE render-then-canon HOP IN THIS MODULE (W9) ─────────────────────────────
// The emitter-vocabulary NAME of an arena type: `tyToNominalName` produces the
// source-faithful (alias-preserving) spelling, then `canonEmitName` applies — ONCE
// over the WHOLE render, where the surrounding structure is visible — the same
// position-dependent rewrites `canonEmitTypeNames` already applied to every source
// annotation. That is what makes an arena-derived key EQUAL the key the NAME walk
// derived for the same type, which is the whole contract of the three walks below
// (registrations and sigs UNION IN rather than forking).
//
// THIS BODY EXISTED THREE TIMES — here, in `funcRetUnrepresentable` and in
// `collectTyReachCloSigs` — and the census that motivates the merge also RULES OUT
// deleting the outer `canonEmitName`, which was the other candidate. One instrumented
// compiler reporting BOTH legs at every reach (`vl check tests/cases --codegen`,
// 1,548 programs, 9,501 reaches):
//
//   site                                    reaches   canon rewrites
//   reachRegisterName (canon leg)             7,914      72  (0.91%)
//   reachRegisterName (`underFunc` leg)         558       — (canon not applied)
//   funcRetUnrepresentable                      134       4  (2.99%)
//   collectTyReachCloSigs                       895       0
//
// The 72 are three rules and nothing else: 58 a string-litunion ALIAS inside a union
// softened to `string` (`K0|f64` → `string|f64`), 12 alias TRANSPARENCY (`Z` → `i32`,
// `L|i32` → `{n:i32}[]|i32`), 2 a union-ALIAS flattened into its members. Each is a
// key the emitter genuinely uses; a render that skipped them would fork the registry.
// (THE FIRST RULE HAS SINCE BEEN REVERSED — the owner's 2026-07-29 ruling preserves the
// alias in a mixed union, so canon no longer rewrites those; the census is kept as the
// record that motivated the merge, and the two rules it also found are unaffected. The
// conclusion it supports — do not delete the outer `canonEmitName` — stands on them.)
//
// AND `collectTyReachCloSigs`' ZERO WAS A COVERAGE ZERO, NOT AN IDENTITY. It was recorded
// here as "`canonEmitName` leaves a top-level function type verbatim EXCEPT when its
// result is parenthesized, where it recurses into the PARAMS at `RC_FN_PARAM` and softens
// there" — an asymmetry #1267 filed and #1273 deleted. `canonEmitName` now canons EVERY
// top-level function type's params and result, bare result or parenthesized, because a
// function TYPE's interior is the signature of a DECLARATION whose own annotations this
// pass canons at `RC_ROOT`; leaving it verbatim forked the two `$fnsig` spellings of one
// closure eight ways. The reach is no longer rare: 938 bare-result reaches over the corpus,
// 36 of which rewrite.
//
// `underFunc` = the union sits INSIDE a function type on the reachability path, and the leg
// SURVIVES that change because the positions it covers are still litunion-KEEPING ones. A
// litunion alias embedded there — a struct FIELD's `K0 | boolean` inside
// `(i32) => {a: K0|boolean,…}` — is still not softened by the annotation pipeline
// (`ctxKeepsLitUnion` holds at `RC_FIELD`, and the name walk extracts field text from the
// func's already-canon'd source spelling), so that leg renders faithfully and stops.
function arenaEmitName(tyIx: i32): string {
  const nom = tyToNominalName(tyIx)
  if nom == "" { return "" }
  canonEmitName(nom)
}

// The name-walk key for a reachable union, honoring the position-dependent litunion
// softening that `canonEmitName` bakes in — see `arenaEmitName` above for the rule and
// for what `underFunc` buys. Reproduces the name-walk key in BOTH positions — the
// prerequisite for retiring `registerShapeFieldUnions`.
function reachRegisterName(tyIx: i32, underFunc: boolean): string {
  if underFunc { return tyToNominalName(tyIx) }
  arenaEmitName(tyIx)
}

function collectTyReachRegister(
  stmts: i32[],
  tyIx: i32,
  depth: i32,
  underFunc: boolean,
) {
  if tyIx < 0 || depth <= 0 { return 0 }
  const t = T.tys[tyIx]
  if t is TyNullable {
    // Bucket (c) pre-descent: a nullable VARIANT-BOX (`X | f64 | null` where `X`'s
    // own field is a union) runs `collectVariantFields` on its struct arms
    // SYNCHRONOUSLY inside the registration below, so each arm's FIELD unions must
    // already be registered when it fires. Descend the inner union's MEMBERS first —
    // WITHOUT registering the inner union itself, so the outer `…|null` name still
    // registers before the bare inner union (the name walk's registration order).
    if collectTyMembersReach(stmts, t.nInner, depth - 1, underFunc) < 0 {
      return -1
    }
    // BUCKET (b): a NICHE nullable (`boolean|null`, `string|null`, a litunion `K0|null`,
    // a union-ALIAS `AB|null`, or a variant-box `X|Y|null`) carries its OWN emit-name
    // registration — the shared value box / variant box reps the `| null` spelling needs.
    // Recursing only the inner type misses them: `boolean|null`'s inner is a bare `TyPrim`,
    // and `AB|null`'s inner union registers `A|B` but not the outer `A|B|null` the checker's
    // `isUName` looks up. Render the whole nullable name-faithfully (mirroring the annotation
    // name call `registerInlineUnion(tyNameOf(...))`, which sees exactly this `…|null`
    // spelling) and register it. Idempotent + self-dispatching: a nullable-STRUCT (`S|null`),
    // nullable-MAP, or nullable-scalar-LIST niche is owned by other machinery and no-ops in
    // `registerInlineUnion`; a union the name walk already reached is an `isUName` no-op.
    const nn = reachRegisterName(tyIx, underFunc)
    if nn != "" {
      if registerInlineUnion(stmts, nn) < 0 { return -1 }
    }
    return collectTyReachRegister(stmts, t.nInner, depth - 1, underFunc)
  }
  if t is TyArray {
    return collectTyReachRegister(stmts, t.aElem, depth - 1, underFunc)
  }
  if t is TyMap {
    return collectTyReachRegister(stmts, t.mVal, depth - 1, underFunc)
  }
  if t is TyObj {
    const ftys = t.objFieldTypes
    let i = 0
    while i < ftys.length {
      if collectTyReachRegister(stmts, ftys[i], depth - 1, underFunc) < 0 {
        return -1
      }
      i = i + 1
    }
    return 0
  }
  if t is TyFunc {
    // Inside a function type every reachable union sits in a litunion-KEEPING position
    // (a field / element / map value / the result — `ctxKeepsLitUnion`), so descend with
    // `underFunc = true` and let embedded litunion aliases render faithfully. This used to
    // read "everything inside a function type is the `canonEmitName` VERBATIM region",
    // which stopped being true in #1273 — the reason survives the rule that motivated it.
    const ps = t.fnParamTypes
    let i = 0
    while i < ps.length {
      if collectTyReachRegister(stmts, ps[i], depth - 1, true) < 0 { return -1 }
      i = i + 1
    }
    return collectTyReachRegister(stmts, t.fnRet, depth - 1, true)
  }
  if t is TyUnion {
    // Descend into the members FIRST — bucket (c): a struct ARM's field may itself be
    // a union (`{f: boolean | {w:i32}} | {w:i32}`), and registering the OUTER union
    // runs `collectVariantFields` on each arm SYNCHRONOUSLY, which needs every arm
    // field union already registered to classify it as the box (code 16) instead of
    // failing loud (`fieldTypeCode` -1). This is the arena mirror of the name walk's
    // "field unions of the shape arms register FIRST" discipline
    // (`registerVariantArmFieldUnions` ran before the caller pushed its rows) — the
    // member descent reaches each arm's field types (TyObj recursion), each field's
    // element/map-value/closure-result unions (TyArray/TyMap/TyFunc recursion), and
    // the #1048 niche-nullable spellings (TyNullable arm). Idempotent — an
    // already-registered union is an `isUName` no-op.
    if collectTyMembersReach(stmts, tyIx, depth - 1, underFunc) < 0 {
      return -1
    }
    // Render the union name-faithfully (`underFunc`-aware softening — see
    // `reachRegisterName`), register.
    // A "" render (an unresolvable nominal / over-deep recursion) declines silently —
    // the name walk still covers those (this walk only ADDS coverage, never removes).
    const nm = reachRegisterName(tyIx, underFunc)
    if nm != "" {
      if registerInlineUnion(stmts, nm) < 0 { return -1 }
    }
    return 0
  }
  0
}

// Descend each MEMBER of the union at `tyIx` through `collectTyReachRegister` —
// WITHOUT registering the union itself. The bucket (c) pre-descent shared by the
// walk's `TyUnion`/`TyNullable` arms and `rootUnionDeclMembers`: whoever is about
// to register a variant-box union calls this first, so every struct arm's field
// unions are registered when `collectVariantFields` fires. A non-union `tyIx`
// (or -1 / exhausted depth) is a no-op. Returns 0, or -1.
function collectTyMembersReach(
  stmts: i32[],
  tyIx: i32,
  depth: i32,
  underFunc: boolean,
) {
  if tyIx < 0 || depth < 0 { return 0 }
  const t = T.tys[tyIx]
  if t is TyUnion {
    const members = t.uMembers
    let i = 0
    while i < members.length {
      if collectTyReachRegister(stmts, members[i], depth, underFunc) < 0 {
        return -1
      }
      i = i + 1
    }
  }
  // A COLLECTION carrying the union (`{[string]: V} | null`, `V[] | null`): the
  // caller's own registration of the outer name recurses by NAME into the value /
  // element union (`registerInlineUnion`'s map-atom and ref-array-atom arms), so
  // that union's variant rows are pushed from inside the caller's `registerInlineUnion`
  // — with no arm-field pre-descent of its own. Descend through the collection so the
  // arms' FIELD unions register first, exactly as a direct union member's do. The
  // collection itself owns no registration, so this only re-orders, never adds.
  if t is TyMap {
    return collectTyMembersReach(stmts, t.mVal, depth - 1, underFunc)
  }
  if t is TyArray {
    return collectTyMembersReach(stmts, t.aElem, depth - 1, underFunc)
  }
  0
}

// True if a closure whose RESULT arena type is `retIx` is NOT yet representable through
// the value ABI — so a concrete lambda of that shape would NOT intern a sig either
// (`cloRetKeySuffix` yields "" / a non-recoverable slot). The arena sig walk must SKIP
// interning such a closure's sig: the render-based key (`annRetKind`) is more permissive
// than the lambda-based one, and synthesizing a sig the concrete producer declines would
// let a value CALL resolve past its clean reject into a downstream INVALID emit (the
// closure-result-field composite draw `(i32) => {f: () => {f: i64} | i32}` — the outer
// closure's result struct carries a bare-closure field, non-lowerable). Two holes:
//   (1) an INLINE result STRUCT that is not `funcTypeShapeLowerable` — the exact gate
//       `cloRetKeySuffix` applies via `cloRetValSlot`/`retStructIndex`. A DECLARED struct
//       (nominal name, not `{`) is always representable.
//   (2) a heterogeneous scalar+composite VALUE UNION (`{f: i64} | i32`) — the deferred
//       #875 box hole; synthesizing its `>u` would defeat the
//       `cloCallUnionResultUnrepresentable` floor ("un-interned `>u` ⟹ reject").
// A concrete lambda that GENUINELY represents such a result interns its own sig earlier
// (the `fnStmts` loop, before this walk), so skipping here never drops a needed sig.
function funcRetUnrepresentable(retIx: i32): boolean {
  if retIx < 0 { return false }
  const t = T.tys[retIx]
  if t is TyObj {
    // `arenaEmitName` — the module's one render-then-canon hop. The `""` render this
    // used to hand `canonEmitName` directly came back `""` and failed `nameIsShapeOpen`;
    // the home returns `""` for it without entering the rewriter, which is the same
    // answer one call earlier.
    const nm = arenaEmitName(retIx)
    // The `length > 0` this replaces was the ONE spelling of the shape-open grammar in the
    // compiler that did not bound the name at 2 — on the single name `"{"` it read `nm[1]`
    // out of bounds, which TRAPS. The home bounds it, so this is the same predicate minus a
    // latent crash, not a narrower one.
    if nameIsShapeOpen(nm) { return !funcTypeShapeLowerable(nm) }
    return false
  }
  if t is TyUnion {
    const members = t.uMembers
    if members.length < 2 { return false }
    let hasScalar = false
    let hasComposite = false
    let i = 0
    while i < members.length {
      const mt = T.tys[members[i]]
      if mt is TyPrim { hasScalar = true }
      else if mt is TyLit { hasScalar = true }
      else if tyIsLitUnion(members[i]) { hasScalar = true }
      else if mt is TyObj { hasComposite = true }
      else if mt is TyArray { hasComposite = true }
      else if mt is TyMap { hasComposite = true }
      else if mt is TyFunc { hasComposite = true }
      i = i + 1
    }
    return hasScalar && hasComposite
  }
  false
}

// ── UNIFIED ARENA CLOSURE-SIG WALK ──────────────────────────────────────────
// The sig-interning sibling of `collectTyReachRegister`: given an annotation node's
// resolved arena type `tyIx`, recurse over the `T.tys` shape and, on EVERY reachable
// `TyFunc`, intern that closure's `$fnsig` key. RETIRED the whole `internShapeFieldCloSigs`
// NAME walk (the depth-0 single-shape `{…}`-field spelling split — closure/nullable-closure
// fields, closure-array fields, closure-array union-arm fields, nested single-shape fields);
// this walk supersedes it measurably (byte-identical corpus + a fresh-seed fuzz A/B with zero
// divergence). Still ALONGSIDE the remaining `collectCloSigs` NAME passes (the closure-array /
// nulclosure / union-arm annotation scans), each of which historically added ONE new
// spelling-descent per fuzz finding (#987/#1006-F2/#1016/#1018/#1026 …). A closure buried in a
// NOVEL nesting position — a closure returning a closure inside a struct FIELD of a union arm
// (`{a: () => ((i32,i32,i32) => string), …} | i64`, the #1028 sig-descent draw) — is reachable
// in the arena but was never enumerated by a name-walk recursion (the TypeRef's whole-name is
// the outer union, and the closure nests below every `nameIsWholeSpanShape` entry). This walk makes
// the miss structurally impossible: it descends through every composite variant uniformly.
//
// RENDER DISCIPLINE (mirrors `collectTyReachRegister`): a `TyFunc` is rendered with
// `tyToNominalName` (nominal-first) then `canonEmitName` ONCE over the WHOLE render, so
// the derived key is EXACTLY the one the value CALL site derives (`nodeTyName` →
// `annSigKey`) and the one a concrete lambda's `cloSigKeyExt` interns — sigs UNION IN.
// `unionArmSigKey` peels any grouping parens to the bare `(…)=>…` `annSigKey` expects.
// The synth rep is -1 (`emitSynthCloSig` builds the functype from the key); the
// `funcRetUnrepresentable` gate + the `nulCloMixedUnionUnregistered` floor keep a
// not-yet-representable result a LOUD reject rather than unmasking a downstream INVALID
// emit (the render key is more permissive than the concrete-lambda key).
//
// IDEMPOTENT + ORDER-STABLE: guarded by `cloSigPosOfKey`, and CALLED LAST in
// `collectCloSigs` (after every name-walk pass + the concrete-lambda loop), so a sig
// any existing path already interned keeps its slot and only a genuinely-missed sig is
// appended at the END — minimizing the nominal-sensitive slot-digit churn (#1019). The
// `$fnsig` slot digits feed interned sig TEXT, so this is run-diff-gated, not
// byte-identical. Depth-capped at 16 (recursive arena types). Returns 0, or -1.
function collectTyReachCloSigs(tyIx: i32, depth: i32) {
  if tyIx < 0 || depth <= 0 { return 0 }
  const t = T.tys[tyIx]
  if t is TyNullable { return collectTyReachCloSigs(t.nInner, depth - 1) }
  if t is TyArray { return collectTyReachCloSigs(t.aElem, depth - 1) }
  if t is TyMap { return collectTyReachCloSigs(t.mVal, depth - 1) }
  if t is TyObj {
    const ftys = t.objFieldTypes
    let i = 0
    while i < ftys.length {
      if collectTyReachCloSigs(ftys[i], depth - 1) < 0 { return -1 }
      i = i + 1
    }
    return 0
  }
  if t is TyUnion {
    const members = t.uMembers
    let i = 0
    while i < members.length {
      if collectTyReachCloSigs(members[i], depth - 1) < 0 { return -1 }
      i = i + 1
    }
    return 0
  }
  if t is TyFunc {
    // Intern THIS closure's sig from its arena render (the key the value-call site and
    // a concrete lambda both derive). A non-value-ABI result (string/i64/void) keys ""
    // and stays unminted; a mixed-union unregistered result is skipped so the call
    // rejects loudly (the name-pass discipline).
    if !funcRetUnrepresentable(t.fnRet) {
      // `arenaEmitName` — the module's one render-then-canon hop. Its own `""` guard
      // subsumes nothing here (the `nm != ""` test below is the one that decides), so
      // the two spellings agree on every input including the unnameable type.
      // THE ARENA WALK STOPS PARSING ITS OWN RENDER. This arm already HAS the functype
      // (`tyIx`, `t is TyFunc`); it rendered it with `arenaEmitName` and handed the
      // string to a producer that parses a function type back out of it.
      // `sigKeyOfTy(tyIx)` is that producer's documented dual, so the key comes off the
      // type and only the GUARD still reads the name.
      //
      // Measured: **1,102 of 1,133 keys identical**, 0 disagreements, arena silent on 31
      // (which fall back to the parse).
      // THE RENDER IS GONE on the definite-no path. `arenaEmitName` ran here only so the
      // guard could read a name; when the arena proves the result cannot be a mixed
      // union, the guard's verdict is known and the key is already in hand.
      //
      // SOUNDNESS, measured: a non-empty key implies a non-empty render at this site —
      // `keyNoName = 0` over the corpus (2 reaches have both empty). So gating on the key
      // preserves the `nm != ""` condition this arm used to apply.
      const kAr = sigKeyOfTy(tyIx)
      if kAr != "" && !cloResultMaybeMixed(tyIx) {
        internCloSigKey(kAr, -1)
      } else {
        const nm = arenaEmitName(tyIx)
        if nm != "" { internCloSigOfAtomTy(nm, kAr) }
      }
    }
    // Descend params + result to reach closures nested inside them (a result struct's
    // closure field, a param closure, a closure arm of a field union).
    const ps = t.fnParamTypes
    let i = 0
    while i < ps.length {
      if collectTyReachCloSigs(ps[i], depth - 1) < 0 { return -1 }
      i = i + 1
    }
    return collectTyReachCloSigs(t.fnRet, depth - 1)
  }
  0
}

// Root the arena registration walk at a NAMED union's declared arena type — bucket
// (c): a `UnionDecl` carries no annotation node, so the walk gets its root from the
// checker's declaration registry (`cUserTypes` keys every `UnionDecl` name to its
// interned `TyUnion`). Descend each MEMBER (not the union itself — `collectU` pushes
// the union's own rows right after, under its SOURCE name): the walk reaches every
// arm's field types (a nominal arm via its declared TypeDecl tyIx, an inline-shape
// arm via its structural TyObj) so `collectVariantFields` classifies each arm field
// union as the box (code 16) instead of failing loud. A helper (not inline in
// `collectU`) so no `is` narrowing unpins the caller's `UnionDecl` narrowing.
// Returns 0, or -1.
function rootUnionDeclMembers(stmts: i32[], udName: string) {
  let udTyIx = -1
  const udHit = cUserTypes[udName]
  if udHit is i32 { udTyIx = udHit }
  collectTyMembersReach(stmts, udTyIx, 16, false)
}

// SAME-SHAPE UNION FALLBACK — the one annotation-site registration the arena register
// walk (`collectTyReachRegister`) provably cannot reproduce. An inline union annotation
// whose non-null members share a SHAPE (`A | B` where `type A`/`type B` have identical
// fields) is DESTROYED at annotation resolution: `resolveAnnot` dedups the members
// (`sameVariantTy`), so `members.length == 1` collapses the whole union to a SINGLE
// struct member (a plain `TyObj`, no `TyUnion` node) — a `B` value structurally IS an
// `A`. The arena walk therefore has no union to reach: `nodeTyIxOf(node)` is that
// collapsed struct, whose `TyObj` field recursion registers nothing. Yet the emitter
// still classifies the param/field/return by its SOURCE spelling `A | B` (`isUName` in
// `emitProgram`'s param arm / the struct-field / return classifiers), and that composite
// spelling lives ONLY in the annotation name — registering the two declared struct names
// `A`, `B` individually does NOT satisfy `isUName("A | B")`. So drive this one case from
// the annotation node's name: when the RESOLVED type is a plain struct but the SPELLING
// is a union (two-plus top-level atoms), register the spelling. Every genuine
// (non-collapsing) union stays a `TyUnion`/`TyNullable` in the arena and is fully covered
// by `collectTyReachRegister` — so this fallback fires ONLY on the same-shape collapse,
// which the disable-then-diff probe pinned to exactly two corpus shapes (`A | B` and
// `Cat | Dog` same-shape params). Returns 0, or -1 (a `registerInlineUnion` `emitFail`).
function registerCollapsedUnionName(stmts: i32[], node: i32) {
  const tyIx = nodeTyIxOf(node)
  if tyIx < 0 { return 0 }
  const t = T.tys[tyIx]
  // A genuine union / nullable / litunion is reached by the arena walk directly; only a
  // spelling that RESOLVED to a plain struct (the same-shape collapse) needs the name.
  if t is TyObj {
    // Two-plus top-level atoms ⇒ the source spelled a union that collapsed to this struct.
    // The count is READ, not re-derived: `canonEmitTypeNames` — the pass that PRODUCED this
    // node's emit-time spelling — banked it on the node (`annUnionAtomsOf`, #1055). No name
    // fall-through, and none is reachable: the bank is rebuilt over the whole node arena at
    // the end of every `checkProgram`, and this runs inside `collectU`, the FIRST emit pass,
    // so no node handed here postdates the bank. A -1 (a node that is not a `TypeRef`) is
    // the same answer the deleted `splitUnionAtoms(tyNameOf(node))` gave for one — `""`
    // splits to a single atom, i.e. not a union.
    if annUnionAtomsOf(node) >= 2 {
      return registerInlineUnion(stmts, tyNameOf(node))
    }
  }
  0
}

// ANONYMOUS-NOMINAL INFERRED-UNION FALLBACK — the one inferred-return registration the
// arena register walk (`collectTyReachRegister`) provably cannot reproduce, the
// inferred-return twin of `registerCollapsedUnionName`'s same-shape annotation case. An
// un-annotated function / lambda whose returns join to a STRUCT-union (`Cat | Dog`) or a
// VARIANT-BOX union (`Cat | i32`, `{w: i32} | i32`) is inferred STRUCTURALLY — the checker
// holds `{meow:i32} | {woof:i32}`, an ANONYMOUS shape with no nominal identity. It reverse-
// maps each member to its declared name by SHAPE (`structUnionRetName` /
// `variantBoxUnionRetName` → `nominalNameOfObj`, bidirectional `assignable`) and records the
// NOMINAL composite (`inferRetTyAt`) — but the recorded arena type (`inferRetTyIxAt`) is that
// anonymous union, so `reachRegisterName` renders it STRUCTURALLY (`{meow:i32}|{woof:i32}`) or
// declines (""), NEVER the nominal `Cat|Dog` the emitter classifies the binding/return by
// (`isUName("Cat|Dog")` in the return + `is`-narrow classifiers). That nominal string lives
// ONLY in the recorded name; registering the anonymous member shapes does NOT satisfy
// `isUName("Cat|Dog")` (exactly as #1055's same-shape collapse lives only in the annotation
// name). So drive this residual from the recorded name — but ONLY when the arena walk did not
// already register it: a scalar/list return is not a union (`splitUnionAtoms < 2`, skip), and
// a VALUE union / niche nullable / already-declared alias the arena render reproduced faithfully
// is `isUName` after the walk (skip). Fires exactly on the anonymous-nominal struct-union /
// variant-box residual (the disable-then-diff probe pinned it to 6 corpus shapes). Returns 0,
// or -1 (a `registerInlineUnion` `emitFail`).
// The #1057 hand-off is TAKEN, at the RECORDER rather than at the arena: the faithful count is
// the one the NAME PRODUCER records (how many atoms it JOINED), not a walk of the type it
// rendered. `recordInferRet` is the single funnel every inferred-return name producer lands in,
// so the count is banked there on the very string this function would have split; `row` reads
// it. The arena dual ("decide on the RECORDED member count", `retMemCountOf`) was measured here
// and REFUTED — that column walked the recorded type's union/nullable SPINE, and a litunion
// member's spine leaf count is not the rendered name's atom count. An additive probe over the
// corpus disagreed on **4** files at this decision, all of them the name `K0 | null`, where the
// renderer emits the litunion ALIAS as ONE atom (2) and the spine walk counts its literal
// members (3, 4). It is unsound the other way too, over a real population: 13 corpus files and
// 833 of 50,400 fuzz programs record a ONE-atom name whose spine walk counts >= 2 (a bare
// inferred litunion / closure-result alias) — the walk would vote to register a union this
// compiler does not register, and only the `isUName` gate above saves them.
function registerInferRetNominalUnion(stmts: i32[], nm: string, row: i32) {
  if isUName(nm) { return 0 }
  // A genuine union spelling (`Cat|Dog`, `Cat|i32`, `{w:i32}|i32|null`) the arena walk left
  // unregistered ⇒ the anonymous-nominal residual. A single-atom name (a scalar / list /
  // bare struct return) has no top-level union to register. No name fall-through: `row`
  // indexes the very table `nm` was read from, so the count is recorded whenever the name is.
  if inferRetAtomCountAt(row) >= 2 { return registerInlineUnion(stmts, nm) }
  0
}

// ONE UNION, ONE SPELLING — the gate that stops the inferred-return row being registered
// TWICE. `registerInferRetNominalUnion` above is a FALLBACK by name, but nothing gated the
// arena walk that runs before it: for an inferred STRUCT-union / VARIANT-BOX return the walk
// renders the recorded (anonymous) arena type STRUCTURALLY (`{meow:i32}|{woof:i32}`) and
// registers THAT, then the fallback registers the checker's reverse-mapped NOMINAL composite
// (`Cat|Dog`) — because `isUName` compares the composite and the two composites differ. Two
// `unNames` rows, ONE layout, and every variant of the second is a DUPLICATE entry in
// `uVariants` — which is the base of all three tag bands, so the duplicates renumber every
// tag in the module and `variantIndexOf`'s exact string compare can land on the copy.
//
// The two producers are not equal and the choice is not a taste: the NOMINAL name is the one
// the rest of the emitter classifies the binding / return / `is`-narrow by (`isUName("Cat|Dog")`),
// and it is the only one that survives the owner's PRESERVE ruling — the vocabulary keeps
// names. `tyToNominalName` simply has no route from an anonymous inferred `TyObj` to the
// declared `Cat` it equals, so its "structural" answer is a MISS, not a second opinion.
// So when the fallback is about to register the nominal composite, the arena walk registers
// only the union's MEMBERS (the bucket (c) pre-descent every variant-box registration needs)
// and leaves the top-level row to the name.
//
// Gated four ways, and each gate is a case where the two names are NOT two spellings of one
// union: a non-`TyUnion` root (a nullable / collection root owns registrations the member
// descent alone would drop); a recorded name with fewer than 2 atoms, which is not a union
// composite at all (a bare inferred litunion / closure-result alias records a ONE-atom name
// whose arena SPINE still walks two members — see `registerInferRetNominalUnion`'s own
// refutation of the spine count); a render that AGREES with the recorded name (nothing
// duplicated — 4 of the corpus's inferred rows are this); and a structural render the source
// itself ALSO spells, which some annotation already registered (`isUName(ar)`) — there the
// arena registration is already an `isUName` no-op and master's path is exact.
//
// **`isUName(nm)` WAS A FIFTH GATE AND IT WAS BACKWARDS (#1310).** It read "a nominal name the
// fallback would not register anyway", which conflated *the fallback declines* with *there
// would be no row*. `isUName(nm)` TRUE means the nominal composite ALREADY HAS ITS ROW —
// registered by an annotation elsewhere in the module (`const w: Cat | Dog = pick(true)`, a
// `(Cat | Dog)[]` binding, a `sink(p: Cat | Dog)` parameter), by a `UnionDecl`, or by an
// EARLIER inferred-return row of the same union. That is the strongest possible reason to
// suppress the walk's second, STRUCTURAL spelling, not a reason to allow it: the row exists,
// so the walk's registration can only be the duplicate this predicate was written to stop.
// With the gate in place, `Cat|Dog` + `{meow:i32}|{woof:i32}` came back the moment ANY
// annotation in the module spelled the union — which is why #1309's own fixture had to omit
// its list and field positions. The gate is gone; the fixture has them back.
function inferRetArenaUnionIsDup(tyIx: i32, nm: string, row: i32): boolean {
  if tyIx < 0 { return false }
  const t = T.tys[tyIx]
  if !(t is TyUnion) { return false }
  if inferRetAtomCountAt(row) < 2 { return false }
  const ar = reachRegisterName(tyIx, false)
  if ar == "" { return false }
  if ar == nm { return false }
  !isUName(ar)
}

// Scan every top-level FuncDecl's parameter + return annotations and every top-level
// `let`/`const` annotation for INLINE union types, registering each as a synthetic
// union alias (so it interns its variant shapes + heap types exactly like a named
// alias). Must run AFTER the `UnionDecl` pass (so an inline name matching a named
// alias is a no-op) and BEFORE `assignTags` (which ranks the FINAL `uVariants` set).
// Returns 0, or -1 (via `emitFail`).
function collectInlineUnions(stmts: i32[]) {
  nliLetIxs = []
  nliNames = []
  cloSigWalkRoots = []
  collectInlineUnionsIn(stmts, stmts)
}

// The recursive worker: scan the statement list `walk` (registering against the
// TOP-LEVEL `stmts`, where struct `TypeDecl`s live), descending into function
// bodies and branch blocks so a `let v: A | B = …` INSIDE a function (or a nested
// `if`/loop body) registers its inline union too — value unions especially appear
// as local annotations, not just at module scope.
function collectInlineUnionsIn(stmts: i32[], walk: i32[]) {
  let i = 0
  while i < walk.length {
    const s = P.nodes[walk[i]]
    if s is FuncDecl {
      // Read both annotation-bearing fields of the narrowed `s` BEFORE the inner loop
      // introduces a `Param` narrowing (a fresh `is`-narrowing pins its own binding;
      // reading `s.fnRet` after it would no longer see `s`'s FuncDecl narrowing).
      const params = s.fnParams
      const retTy = s.fnRet
      const fnBody = s.fnBody
      // Arena walk FIRST: register EVERY union reachable through the resolved return
      // type, not just the ones the `tyNameOf` render surfaced (registrations union
      // in). Ordered BEFORE the name call — bucket (c): the name registration runs
      // `collectVariantFields` on each struct arm synchronously, so an arm's FIELD
      // unions must already be registered when it does (the walk's members-first
      // TyUnion descent reaches them; the retired `registerVariantArmFieldUnions`
      // name split used to pre-register them inside `registerInlineUnion` itself).
      if collectTyReachRegister(stmts, nodeTyIxOf(retTy), 16, false) < 0 {
        return -1
      }
      // Same-shape collapse fallback (the ONE case the arena walk can't reach — the
      // union spelling resolved to a single struct; see `registerCollapsedUnionName`).
      if registerCollapsedUnionName(stmts, retTy) < 0 { return -1 }
      cloSigWalkRoots.push(nodeTyIxOf(retTy))
      let pi = 0
      while pi < params.length {
        const p = P.nodes[params[pi]]
        if p is Param {
          const pt = p.parType
          // Arena walk first (bucket (c) ordering — see the return-type site).
          if collectTyReachRegister(stmts, nodeTyIxOf(pt), 16, false) < 0 {
            return -1
          }
          // Same-shape collapse fallback (see the return-type site).
          if registerCollapsedUnionName(stmts, pt) < 0 { return -1 }
          cloSigWalkRoots.push(nodeTyIxOf(pt))
        }
        pi = pi + 1
      }
      if collectInlineUnionsBlock(stmts, fnBody) < 0 { return -1 }
    } else if s is LetDecl {
      const letTy = s.letType
      // Arena walk first (bucket (c) ordering — see the return-type site).
      if collectTyReachRegister(stmts, nodeTyIxOf(letTy), 16, false) < 0 {
        return -1
      }
      // AN UNANNOTATED BINDING STILL HAS A TYPE, and it can be a union the emitter must
      // register. `letTy` is the ANNOTATION node — `-1` when there is none — so the walk
      // above sees nothing for `const v = m["k"]`, whose inferred type is `i32 | null`,
      // and the nullable's shared value box is never minted.
      //
      // IT HAS TO HAPPEN HERE rather than in `synthNullableAnn`: `collectU` is the FIRST
      // emit pass and the synthesis runs at `synthGlobalEmptyListAnns`, twelve passes
      // later. The two halves are not redundant — this one mints the box type, that one
      // steers the slot classifier.
      //
      // Idempotent: an ANNOTATED binding walks the same arena type twice and every
      // registration below no-ops the second time, so nothing reorders for the spellings
      // that already worked.
      if letTy < 0 {
        if initNullableIsBoxScalar(s.letInit) {
          if (
            collectTyReachRegister(stmts, nodeTyIxOf(s.letInit), 16, false) <
            0
          ) {
            return -1
          }
        }
      }
      // Same-shape collapse fallback (see the return-type site).
      if registerCollapsedUnionName(stmts, letTy) < 0 { return -1 }
      cloSigWalkRoots.push(nodeTyIxOf(letTy))
      // Usage-driven `let x = null` hole (A-infer-null): infer + register `T|null`.
      nliInferLet(walk, i)
      // An un-annotated `const x = if … { … } else { … }` whose arms join to a value
      // union: register the inferred name so the slot classifies + lowers like an
      // annotated nullable/value-union binding.
      nliInferIfLet(walk, i)
      // An un-annotated `const t = a?.w` whose result is a nullable SCALAR: same
      // registration, because the type it needs is spelled nowhere in the program.
      nliInferOptChainLet(walk, i)
    } else if s is TypeDecl {
      // A struct FIELD annotated with an inline union (`type T = { v: A | B }`,
      // `{ v: A | i32 }`) registers that union here — in `collectU`, BEFORE `collectS`
      // interns the variant heap types — so the field classifies as the kind-16 box
      // (`fieldTypeCode` sees `isUName`). A value-union field is interned at field
      // collection instead; this is the struct/heterogeneous variant-box case.
      const flds = s.tdFields
      let tfi = 0
      while tfi < flds.length {
        if flds[tfi] >= 0 {
          const fdn = P.nodes[flds[tfi]]
          if fdn is FieldDef {
            const fdt = fdn.fdType
            // Arena walk first (bucket (c) ordering — see the return-type site).
            if collectTyReachRegister(stmts, nodeTyIxOf(fdt), 16, false) < 0 {
              return -1
            }
            // Same-shape collapse fallback (see the return-type site).
            if registerCollapsedUnionName(stmts, fdt) < 0 { return -1 }
            cloSigWalkRoots.push(nodeTyIxOf(fdt))
          }
        }
        tfi = tfi + 1
      }
    } else if s is IfStmt {
      const thenB = s.ifThen
      const elseN = s.ifElse
      if collectInlineUnionsBlock(stmts, thenB) < 0 { return -1 }
      if elseN >= 0 {
        const els = P.nodes[elseN]
        if els is Block {
          if collectInlineUnionsBlock(stmts, elseN) < 0 { return -1 }
        } else {
          // `else if`: a lone nested statement — wrap it in a one-shot walk.
          const one: i32[] = []
          one.push(elseN)
          if collectInlineUnionsIn(stmts, one) < 0 { return -1 }
        }
      }
    } else if s is WhileStmt {
      if collectInlineUnionsBlock(stmts, s.whileBody) < 0 { return -1 }
    } else if s is ForRange {
      if collectInlineUnionsBlock(stmts, s.frBody) < 0 { return -1 }
    } else if s is ForIn {
      if collectInlineUnionsBlock(stmts, s.fiBody) < 0 { return -1 }
    }
    i = i + 1
  }
  0
}

// Recurse into a Block node's statement list (a function body / branch arm).
function collectInlineUnionsBlock(stmts: i32[], blockIx: i32) {
  if blockIx < 0 { return 0 }
  const b = P.nodes[blockIx]
  if b is Block { return collectInlineUnionsIn(stmts, b.blkStmts) }
  0
}

// ── UNRENDERABLE (CYCLIC) DECLARED TYPES — rejected before anything renders ──
// `applyGenAlias` instantiates a recursive generic alias (`type L<T> = { head: T,
// tail: L<T> | null }`) by registering an EMPTY placeholder under the instance's memo
// key BEFORE it resolves the fields, so a self-application lands on its own arena
// index instead of recursing forever. The resolved `Ty` is therefore genuinely
// CYCLIC — and unlike a recursive DECLARED struct (`type Tree = { kids: Tree[] }`,
// whose index is registered under a name), a generic INSTANCE has no name registered
// against it, so nothing short-circuits a renderer walking it. Every emit-side
// renderer then descends forever: `tyToNominalName` (the registration walk below),
// `tyToEmitName` (the canon pass), and `gaeEnsure`'s field recursion in the shape
// pass. All three exhaust the call stack and TRAP the compiler, which gives the user
// nothing to act on. The emitter rejects such a program by name instead.
//
// THE TEST IS THE RENDER ITSELF (renderEmit P2 / O1). It used to be a hand-written
// SECOND COPY of `tyToNominalName`'s descent — "the same nominal short-circuits, the
// same composite arms, and a path stack in place of the concatenation", as its own
// header put it — which is two walks to keep in step for one question. The renderer
// now carries the ancestor stack its structural sibling has always had
// (`emitNameSeen`'s twin) and BANKS the cut in `tyNomNameCycled`, so asking "does
// this type have a finite nominal name?" is running the renderer and reading the
// bank. Rendering per DECLARED type costs nothing extra in the common case: a
// declared struct / union alias short-circuits to its own NAME at the first line, and
// only the anonymous generic INSTANCES — the ones that can carry a cycle at all —
// descend.
//
// The bank, not the "" return, is the answer: this renderer also returns "" for a
// TyVar, for `never` and for any arm it has no name for, and a generic alias's own
// `cUserTypes` entry (`type Box<T> = {v: T}`) is exactly such a type.

// Would a name-faithful render of arena type `ix` fail to terminate?
function tyNomRenderLoops(ix: i32): boolean {
  tyToNominalName(ix)
  tyNomNameCycled()
}

// The SOURCE spelling of the first annotation whose resolved type is `ix` (`L<i32>`),
// for the diagnostic — the arena type itself has no finite render, which is the whole
// point. Failure path only, so the linear `P.nodes` scan costs nothing otherwise.
function annSpellingOfTyIx(ix: i32): string {
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is TypeRef {
      if nodeTyIxOf(i) == ix { return n.tyName }
    }
    i = i + 1
  }
  ""
}

// Reject every declared type whose expansion has no finite name, BEFORE the first
// pass renders one. `cUserTypes` keys every declared alias and every generic-alias
// INSTANCE (`applyGenAlias` memoizes each under its resolved key), so one scan of the
// checker's registry covers the whole family; a declared struct/union entry answers
// at its own root and costs one registry lookup. Returns 0, or -1 (via `emitFail`).
function guardFiniteUserTypes(): i32 {
  const ks = cUserTypes.keys()
  let i = 0
  while i < ks.length {
    const v = cUserTypes[ks[i]] ?? (-1)
    if tyNomRenderLoops(v) {
      let shown = annSpellingOfTyIx(v)
      if shown == "" { shown = ks[i] }
      return emitFail(
        "emitProgram: recursive generic type `" +
          shown +
          "` is not supported — its expansion has no finite type name",
      )
    }
    i = i + 1
  }
  0
}

// Scan the top-level statements for EVERY union alias `type N = A | B | …` (a
// `UnionDecl`); for each, record its name + variant-slice range in the per-union table
// (`unNames`/`unVarStart`/`unVarCount`), append its variant struct names to the GLOBAL
// `uVariants` list, collect each variant's i32 fields into the flat table, and finally
// assign globally-unique tags across all variants of all unions. Multiple unions
// coexist (mirroring the multi-struct table). Returns 0, or -1 (via `emitFail`).
export function collectU(stmts: i32[]) {
  // The FIRST emit pass, so this is the first thing in the emitter that would walk a
  // declared type — reject the ones no renderer can finish before any of them tries.
  if guardFiniteUserTypes() < 0 { return -1 }
  uDeclared = false
  vbI32Used = false
  vbI64Used = false
  vbF32Used = false
  vbF64Used = false
  unNames = []
  unTyIx = []
  unDeclIx = []
  unMemberSet = []
  unMemTyStart = []
  unMemTyCount = []
  unMemTys = []
  unVarStart = []
  unVarCount = []
  uVariants = []
  uVarTyIx = []
  cloSigTagNames = []
  uFieldNames = []
  uFieldStart = []
  uFieldCount = []
  uFieldTypes = []
  uFieldTyText = []
  uFieldElemName = []
  uFieldElemTyIx = []
  uFieldElemKeyI32 = []
  let i = 0
  while i < stmts.length {
    const s = P.nodes[stmts[i]]
    if s is UnionDecl {
      // A STRUCT-ALIAS union (single inline-shape variant — a canonicalized
      // `type AB = {…} & {…}` object intersection) is a named STRUCT, not a
      // union: `collectS` interns it; skip it here.
      if unionStructAliasShape(s.udVariants) != "" {
        i = i + 1
        continue
      }
      // A TRANSPARENT one-member alias (`type MyCat = Cat`, `type Y = Box<i32>`,
      // `type Id = i32`, `type F = (i32) => i32`, `type L = i32[]`, `type M = {[string]: i32}`)
      // is not a union either — under #1122's ruling it DENOTES its member, and the checker
      // resolves it that way in `declaredTyOfName`. The row this pass used to mint for it cost
      // BOTH of the things a `UnionDecl` row costs. For the OBJECT arm it was the POISON that
      // ruling named: it pushed the member's own name (`Cat`) into `uVariants` a second time,
      // so `Cat` classified as a union VARIANT box wherever it stood, and the transparent
      // render had to be STRUCTURAL to route around it. For EVERY arm — including the four
      // whose row is empty — it also set `uDeclared`, minting the shared union box and the
      // atom / ref-array / map registrations that hang off it for a program with no union at
      // all. One predicate (`isTransparentAlias` → `singleAliasMemberTyIx`) decides it on both
      // sides, exactly as `nameToTy` and `singleMemberAliasTyIx` already do.
      if isTransparentAlias(s.udName) {
        i = i + 1
        continue
      }
      uDeclared = true
      const vs = s.udVariants
      if vs.length < 1 {
        return emitFail("emitProgram: union must have at least one variant")
      }
      // Field unions of the arms register FIRST (see the `registerInlineUnion` twin) —
      // they push their own un*/uVariants rows, which must not interleave with this
      // union's slice. Arena-rooted (bucket (c)): a NAMED union carries no annotation
      // node, so root the walk at the union's DECLARED arena type and descend each
      // MEMBER (`rootUnionDeclMembers`). Replaces the `registerVariantArmFieldUnions`
      // name split at this site.
      if rootUnionDeclMembers(stmts, s.udName) < 0 { return -1 }
      unNames.push(s.udName)
      unTyIx.push(declTyIxOfName(s.udName)) // B-1 step 1
      unDeclIx.push(stmts[i]) // the DECLARATION node — a nominal id that is not a string
      // The alias's full member set, pipe-joined (atom members like `null` kept).
      // D1028 — A UNION-ALIAS MEMBER FLATTENS HERE TOO. `type JR = Json | E` joined its
      // declared members verbatim, so the row's member table held `Json` as ONE opaque atom
      // and every value arm the alias contributed — f64, boolean, string — was absent from
      // it and got delivered raw: check-clean invalid wasm at return, binding and argument
      // alike, while the struct arm `E` and `null` (the members the COMPOSITION added) ran.
      //
      // Canon already flattens the same shape when it sees the whole spelling with a pipe in
      // it, which is why the DIRECT `Json | E` runs (D1021). A named alias never reaches that
      // loop: canon rewrites a `UnionDecl`'s members one at a time, and a lone `Json` has no
      // pipe, so `nameNeedsCanon` declines and the member stays whole. Same flatten, at the
      // one site that had none.
      //
      // A LITUNION alias is NOT expanded: `K0 | f64` renders its run by the registered alias
      // on purpose (the owner's 2026-07-29 ruling), and expanding it would soften the run to
      // `string` — the exact split that ruling reversed.
      let udSet = ""
      let usj = 0
      while usj < vs.length {
        let udMem = vs[usj]
        // A LITUNION alias — NUMERIC as well as string. `nameIsLitUnionType` is the
        // string-only twin (`litKind == "str"`), so gating on it alone expanded `type PA =
        // 61 | 62` inside `type PU = PA | i32`, softened the run to `i32`, and left `is PA`
        // with no arm to find. Asked of the ARENA row, which knows both bases.
        // ONLY A MULTI-ATOM EXPANSION IS TAKEN — a structural self-check rather than a list
        // of type predicates to keep in sync. A LITUNION alias renders through `tyToEmitName`
        // as its SOFTENED base: `type PA = 61 | 62` comes back `i32`, ONE atom, and taking
        // that would delete the arm `is PA` needs — the owner's 2026-07-29 ruling in reverse.
        // `Json`'s six members render as six atoms and are taken. Three narrower guards were
        // tried and each was wrong: `nameIsLitUnionType` is the STRING-only twin,
        // `tyIsLitUnion` off `declTyIxOfName` disagrees with the index the expander resolves,
        // and `unionMemberCount(name)` counts a pipe-joined SPELLING, so a bare alias name
        // answers 1 and rejected every expansion.
        //
        // AND THE SET IS NOT DEDUPED. One entry per member in member order is what the union
        // box-tag ABI depends on (`recordUnMemTys` says so in as many words); a dedupe here
        // silently re-tagged `declared-union-of-litunions` and broke a running program.
        const udExp = unionAliasMembers(udMem)
        if udExp != "" {
          const udExpAtoms: string[] = []
          splitUnionAtoms(udExp, udExpAtoms)
          if udExpAtoms.length > 1 { udMem = udExp }
        }
        if udSet != "" { udSet = udSet + "|" }
        udSet = udSet + udMem
        usj = usj + 1
      }
      unMemberSet.push(udSet)
      recordUnMemTys(udSet) // D-UNION foundation
      unVarStart.push(uVariants.length)
      // Only the STRUCT variants get a variant struct + fields; an atom member
      // (`string`/`i32`/…) of a MIXED union (`{x:i32} | string`) boxes through the shared
      // value boxes, exactly as the inline-annotation path registers it. (A pure struct
      // union has every variant a struct, so this stays byte-identical for `Cat | Dog`.)
      let nStructs = 0
      let nc = 0
      while nc < vs.length {
        if vs[nc] != "null" {
          if isStructAtom(stmts, vs[nc]) { nStructs = nStructs + 1 }
        }
        nc = nc + 1
      }
      unVarCount.push(nStructs)
      let vi = 0
      while vi < vs.length {
        if vs[vi] != "null" {
          if isStructAtom(stmts, vs[vi]) {
            uVariants.push(vs[vi])
            uVarTyIx.push(declTyIxOfName(vs[vi]))
            if collectVariantFields(stmts, vs[vi]) < 0 { return -1 }
          }
        }
        vi = vi + 1
      }
      // A MIXED union's scalar members intern their per-rep value boxes (no-op for an
      // all-struct union).
      markValueUnionAtoms(udSet)
      // A REF-ARRAY arm of a NAMED union (`type U = S[] | i64`) interns its element shape +
      // reflist slot, the same as the inline path — so the two spellings register identically.
      markRefArrayArms(udSet)
      // A MAP arm of a NAMED union (`type U = {[string]: string} | f64`) interns its value shape,
      // matching the inline path.
      markMapUnionArms(udSet)
    }
    i = i + 1
  }
  // Inline union annotations (`v: A | B`) carry no `UnionDecl`; register each as a
  // synthetic alias keyed on its pipe-joined name, so its variant shapes are interned
  // and every name-keyed lookup treats it like a named alias. Runs after the
  // `UnionDecl` pass (so a matching named alias makes the inline form a no-op) and
  // before `assignTags` (which ranks the FINAL variant set).
  if collectInlineUnions(stmts) < 0 { return -1 }
  // Inferred VALUE-union returns (`i32 | string` / `i32 | null`) AND inferred STRUCT-union
  // returns (`Cat | Dog`): register each so its reps intern — even when an inferred
  // return is the program's ONLY union. `registerInlineUnion` dispatches on the name
  // shape (a value union → the shared box; a struct union → its variant structs) and
  // self-gates / dedups (`isUName`), so scalar/array entries and already-declared unions
  // are no-ops.
  let iru = 0
  while iru < inferRetCount() {
    // Arena walk over the INFERRED return type FIRST (the bucket (c) ordering —
    // see `collectInlineUnionsIn`'s return-type site): register EVERY union reachable
    // through the resolved type (not just the ones the `inferRetTyAt` render surfaced)
    // and record the type as a closure-sig walk root, exactly as the annotation sites
    // do. Idempotent (`registerInlineUnion` is `isUName`-gated; `cloSigWalkRoots`
    // interning is `cloSigPosOfKey`-gated), so an inferred type whose reps the name
    // walk already reached is a no-op — this only ADDS the coverage the render missed.
    // #1046 made inferred variant-box returns 0-growth redundancy here.
    // ONE SPELLING (`inferRetArenaUnionIsDup`): where the walk's STRUCTURAL render of
    // this root and the NAME FALLBACK's NOMINAL composite are two spellings of ONE union,
    // the walk descends the MEMBERS only and the row is the name's. Everywhere else the
    // walk is master's, top-level registration included.
    const irTyIx = inferRetTyIxAt(iru)
    const irNom = inferRetTyAt(iru)
    if inferRetArenaUnionIsDup(irTyIx, irNom, iru) {
      if collectTyMembersReach(stmts, irTyIx, 15, false) < 0 { return -1 }
    } else {
      if collectTyReachRegister(stmts, irTyIx, 16, false) < 0 { return -1 }
    }
    // NAME FALLBACK — the one inferred-return registration the arena walk cannot
    // reproduce (see `registerInferRetNominalUnion`): an inferred STRUCT-union /
    // VARIANT-BOX return whose members are ANONYMOUS inferred shapes, recorded under
    // its NOMINAL composite (`Cat|Dog`, `Cat|i32`) which lives only in the name.
    if registerInferRetNominalUnion(stmts, irNom, iru) < 0 { return -1 }
    cloSigWalkRoots.push(irTyIx)
    iru = iru + 1
  }
  // Inferred VALUE-union BINDINGS (`const x = if c { v } else { null }`): same treatment,
  // so an inferred binding union's box reps intern even when it is the program's only
  // value union and `nliInferIfLet` is the only consumer. Self-gating, like the returns.
  let ilu = 0
  while ilu < inferLetCount() {
    registerValueUnionName(inferLetTyAt(ilu))
    ilu = ilu + 1
  }
  // INFERRED ARRAY-ELEMENT UNIONS (`const xs = [1, "two"]`, `const xs = [c, d]`) — the
  // literal twin of the two loops above, and the last position whose union the emitter
  // could learn about only from an annotation.
  //
  // Every other registration route runs off a SPELLING: a `type` declaration, an
  // annotation the name/arena walks reach, an inferred return, an inferred binding. An
  // un-annotated array literal spells its element union nowhere, so the row was never
  // minted, `arrLitUnionElemName`'s `isUName` gate declined, and `arrLitIsRef`'s union rung
  // — written for exactly this literal — could never fire. The literal fell to the i32
  // list, where a boolean member is silently stored as its i32 (`[1, true]` printed `1`
  // twice), a string member is a ref in an i32 backing (`[1, "two"]`: `vl check` rc 0, then
  // `expected i32, found (ref $type)` at instantiation), and a struct member hits the i32
  // path's loud floor (`[c, d]`: `struct array elements are not supported`). One missing
  // row, three failure modes.
  //
  // REGISTERED UNDER THE CLASSIFIER'S OWN KEY (`arrLitInferUnionElemName`, i.e.
  // `nodeArrayElemName`), not under the arena walk's render. `collectTyReachRegister` keys
  // on `canonEmitName(tyToNominalName(ty))` and `nodeArrayElemName` prefers the reverse-
  // mapped nominal composite for an ANONYMOUS inferred member set — two spellings, and only
  // the second one satisfies the `isUName` the classifier asks. This is the same choice
  // `registerInferRetNominalUnion` makes for inferred returns, for the same reason, and it
  // keeps ONE row per union rather than the duplicate-tag hazard that function's header
  // describes.
  //
  // MEMBERS FIRST — bucket (c). Registering a variant-box union runs `collectVariantFields`
  // on its struct arms synchronously, so an arm whose FIELD is itself a union must already
  // be registered or `fieldTypeCode` fails loud. `collectTyMembersReach` is the same
  // pre-descent the walk's own `TyUnion` arm runs.
  //
  // `isUName`-gated, so the ANNOTATED spelling of the same list (`const xs: (i32 |
  // string)[] = [1, "two"]`, which already runs at master) is untouched: its row exists by
  // the time this runs and the loop is a no-op. Every literal this pass does not claim
  // keeps master's classification exactly.
  let iau = 0
  while iau < P.nodes.length {
    const an = P.nodes[iau]
    if an is ArrayLit {
      const aeu = arrLitInferUnionElemName(iau)
      if aeu != "" {
        if !isUName(aeu) {
          const aety = arrLitElemTyIxOf(iau)
          if collectTyMembersReach(stmts, aety, 15, false) < 0 { return -1 }
          if registerInlineUnion(stmts, aeu) < 0 { return -1 }
        }
      }
    }
    iau = iau + 1
  }
  if uDeclared {
    if assignTags() < 0 { return -1 }
  }
  0
}

// Detect bare named-function VALUE uses the other flips miss (arena scan): a
// `let`/`const` initialized to a function name (`const f = inc`), a reassignment
// (`x = inc`), a function name as an equality operand (`inc == h`), or a
// function-valued object-literal field (`{ f: inc }` — `collectAnonShapes`' own
// flip is wiped by `collectFns`' reset, which runs after `collectS`; a LAMBDA
// field re-flips during the lift, a named-function field only here). Each such
// cell is a closure fat-pointer (kind 14), so the closure rec-group types must
// intern (`fnValUsed`) even when no lambda/`.map` site otherwise flips it.
// Programs without such uses set nothing — every golden stays byte-identical.
export function collectFnValUse() {
  let i = 0
  while i < P.nodes.length {
    const nd = P.nodes[i]
    if nd is LetDecl {
      if exprIsBareFnName(nd.letInit) { fnValUsed = true }
    }
    if nd is BinExpr {
      if nd.binOp == "=" || nd.binOp == "==" || nd.binOp == "!=" {
        if exprIsBareFnName(nd.binLeft) { fnValUsed = true }
        if exprIsBareFnName(nd.binRight) { fnValUsed = true }
      }
    }
    if nd is FieldInit {
      if exprIsBareFnName(nd.fiValue) { fnValUsed = true }
    }
    // A bare named function as a CALL ARGUMENT (`m.set(k, inc)`). Every arm above is a
    // position where a function name lands in a cell some ANNOTATION also describes, and
    // that annotation is what flips the machinery for a user call `f(inc)` (the param's
    // `(…) => …` TypeRef). A BUILTIN method has no such annotation: `m.set(k, inc)` over
    // `{[string]: (i32) => i32}` built a closure with no function-value machinery behind
    // it — an invalid module, `vl check` rc 0 — while the index-store twin
    // `m[k] = inc` ran, because THAT is an `Assign` and the `BinExpr` arm above claims it.
    // Keyed on the ARGUMENT being a bare function name, not on the method, so it is inert
    // for every call that does not pass one.
    if nd is Call {
      const cfvArgs = nd.callArgs
      let cfv = 0
      while cfv < cfvArgs.length {
        if exprIsBareFnName(cfvArgs[cfv]) { fnValUsed = true }
        cfv = cfv + 1
      }
    }
    // A closure if-VALUE whose ARM is a bare named function (`if c { inc } else { dec }`): the
    // named function is used as a VALUE, so flip `fnValUsed` so its `$fnsig` interns (a lambda
    // arm already flips it during lifting). The loop visits every `IfStmt`, so this covers a
    // binding / return / argument if-value alike; an `else if` chain's nested `IfStmt` is its own
    // node, visited the same way, so each arm pair is checked.
    if nd is IfStmt {
      if exprIsBareFnName(ifArmValueExpr(nd.ifThen)) { fnValUsed = true }
      if nd.ifElse >= 0 {
        const el = P.nodes[nd.ifElse]
        if el is Block {
          if exprIsBareFnName(ifArmValueExpr(nd.ifElse)) { fnValUsed = true }
        }
      }
    }
    // A SOURCE function-type ANNOTATION (`f: (i32) => i32`, a `(…)=>…` TypeRef) flips the
    // function-value machinery on — the annotated param/field/binding is a closure
    // fat-pointer (kind 14) whose call site `call_ref`s through it, so its signature must
    // intern (`collectCloSigs`), exactly like a lifted lambda or a monomorphized
    // closure-pinned param.
    if nd is TypeRef {
      if tyIsFuncType(i) { fnValUsed = true }
      // A closure-ARRAY annotation (`((i32) => i32)[]`) ALSO uses function values — its
      // elements are closures stored/indexed/called through the array — so it flips the
      // machinery on too. (`tyIsFuncType` is now top-level-arrow only, so the nested arrow
      // here no longer trips it; without this, an array of functions whose ONLY function-type
      // mention is the array annotation would leave its element signatures un-interned and a
      // `fs[i](x)` call would find no signature.)
      if nameIsClosureArrayTy(i) == 1 { fnValUsed = true }
      // A NULLABLE-closure annotation (`(() => f64) | null`, kind 19) is a closure
      // fat-pointer cell too — its null-narrowed call site (`if f != null { f() }`)
      // `call_ref`s through it, so the closure rec-group types + its `$fnsig` must
      // intern even when the value is only ever `null` (no lambda anywhere else flips
      // the machinery on — the nulclosure-sig family's null-only-caller programs).
      if nodeTyIsNulClosure(i) { fnValUsed = true }
      // A SHAPE annotation with a closure/nulclosure FIELD (`{f: () => i32} | null`): the
      // field cell is a closure fat-pointer whose member-call site (`t0.f()`) `call_ref`s
      // through it — the closure machinery + the field's `$fnsig` (the arena sig walk
      // `collectTyReachCloSigs`) must intern even when the value is only ever `null`
      // (no lambda anywhere else flips it on).
      //
      // DESTRINGIFY — MEASURED AND REFUTED, this scan STAYS name-keyed. The arena
      // reading (peel the recorded `TyNullable`, then look for a `TyFunc` /
      // `TyNullable(TyFunc)` / array-of-either FIELD of the recorded `TyObj`, or of any
      // `TyUnion` arm) answers a DIFFERENT QUESTION than the render does: the name walk
      // is ALIAS-BLIND by construction — it inspects only an INLINE `{…}` spelling, so a
      // declared alias annotation (`type Combiner = { op: (i32, i32) => i32 }`, spelled
      // `Combiner`) fails `nameIsWholeSpanShape` and never reaches the field split, while
      // the arena resolves the alias and finds the closure field. An additive probe over
      // the 1,269-file corpus disagreed on 15 files, EVERY one in that direction
      // (`functions/function-type-annotation.vl`, `unions/closure-member-basic.vl`,
      // `objects/error-closure-union-field-local.vl`,
      // `closures/closure-result-closure-array-field.vl`, …). `fnValUsed` is MONOTONE, so
      // the arena's extra `true`s would intern closure machinery this compiler does not
      // intern today — a behavior change, not a destringification. This site retires with
      // the alias-blindness, not before.
      // THE ARENA. This whole block was a name walk: render the annotation, peel `| null`,
      // split union atoms, and ask a shape/array/map grammar about each. `tyReachesClosure`
      // asks the one question all of it was asking — does this type REACH a closure, through a
      // nullable, an array element, an object field, a union arm or a map value.
      //
      // The decline that kept it (B155/B161/B162/B163) rested on the arena being WIDER: it
      // resolves aliases the inline-`{…}` name test cannot see, answering TRUE on 15 more
      // files. Measured, removing the name walk entirely leaves all 1947 corpus modules
      // BYTE-IDENTICAL — `fnValUsed` is monotone and already true on those 15 from another
      // path. The wider reader was never a behaviour change; it was a redundant one.
      if nodeTyReachesClosure(i) { fnValUsed = true }
    }
    // An inferred CLOSURE-element array LITERAL (`const fs = [add, mul]`, no annotation): the
    // checker typed its ELEMENT as a function type, so its elements are closures stored /
    // indexed / called through the array — flip the machinery on to intern their signatures,
    // exactly as the closure-array ANNOTATION above does. `nameIsClosureElem` and not a `=>`
    // substring: an element that merely CONTAINS a closure (a struct field, a map value, a
    // non-first union member) constructs no closure of its own and must not force the pair.
    if nd is ArrayLit {
      // The same arena predicate the three `arrLit*` consumers use (one home, so the four
      // cannot drift). The render is still taken, but only for its EMPTINESS gate — the
      // checker returning "" here means it declined to name the element, which is a different
      // fact from "the element is not a closure".
      if arrElemIsClosureTy(i, nodeArrayElemName(i)) { fnValUsed = true }
    }
    i = i + 1
  }
  0
}

export function collectMapFilterUse() {
  let i = 0
  while i < P.nodes.length {
    const nd = P.nodes[i]
    if nd is Call {
      const callee = P.nodes[nd.callFn]
      if callee is Member {
        if callee.memProp == "map" || callee.memProp == "filter" {
          if nd.callArgs.length == 1 {
            fnValUsed = true
            if callee.memProp == "map" {
              const fe = mfCallbackFe(nd.callArgs[0], -1)
              if fe >= 0 && mfCbResultIsStrList(fe) {
                // A string- or `string | null`-returning callback: the result list is a string
                // list, which may be the program's ONLY one (an i32/struct source mapped to
                // strings) — force its wrapper/backing collection.
                slUsed = true
              } else if fe >= 0 && cloRetValKind(fe) == "struct" {
                // A STRUCT-returning callback (`P[].map((p) => Q-shape)`): the result is a NEW
                // ref list of the callback's result struct — intern ITS slot (a `Q` reached only
                // as a map result has no `Q[]` annotation to force it) so `emitModule` assigns its
                // wrapper/backing and `mfResultSlotOf` resolves it. `cloRetKindOf` folds a struct
                // to -1, so consult `cloRetValKind`/`cloRetValSlot` directly.
                const rsi = cloRetValSlot(fe)
                if rsi >= 0 && rsi < sNames.length {
                  // HINTED with the struct table's own TYPE column. `sTyIx[rsi]` is
                  // resolved from `sNames[rsi]` itself, which is the provenance
                  // `repElemIdOfNameTy`'s header requires ("the type THIS VERY NAME was
                  // resolved to"), so the hint skips `resolveAnnot` rather than racing
                  // it. Dual-written over the corpus before switching: every firing
                  // agrees (`k1 == k2`) with the column populated.
                  //
                  // The read is BOUNDED because `sTyIx` is padded lazily and can lag
                  // `sNames`; a short column yields -1, which is exactly today's
                  // unhinted call.
                  rlInternNameTy(sNames[rsi], 1, rlColAt(sTyIx, rsi))
                  rlUsed = true
                  raUsed = true
                }
              } else if fe >= 0 && cloRetValKind(fe) == "variant" {
                // A concrete-VARIANT-returning callback (a collapse): intern the variant's
                // ref-list slot (kind 1 — its element heap is `uVarHeap[vi]`).
                const cvi = cloRetValSlot(fe)
                if cvi >= 0 && cvi < uVariants.length {
                  // Hinted with the variant table's TYPE column, same provenance and
                  // same bound as the struct arm above.
                  rlInternNameTy(uVariants[cvi], 1, rlColAt(uVarTyIx, cvi))
                  rlUsed = true
                  raUsed = true
                }
              } else if (
                fe >= 0 &&
                cloRetValKind(fe) == "union" &&
                unNames.length > 0
              ) {
                // A UNION-returning callback (`xs.map((a) => unionVal)`): the result is a ref
                // list of union boxes (element kind 2). Intern the union alias's slot so a map
                // whose source is NOT itself a union array still has a result backing.
                // Hinted with the union table's TYPE column, same provenance and bound.
                rlInternNameTy(unNames[0], 2, rlColAt(unTyIx, 0))
                rlUsed = true
                raUsed = true
              } else {
                let rk: VKind | null = null
                if fe >= 0 { rk = cloRetKindOf(fe) }
                if rk == "f64" {
                  fa64Used = true
                } else {
                  aUsed = true
                  lUsed = true
                }
              }
            }
          }
        }
      }
    }
    i = i + 1
  }
  0
}

// True when the nul-closure arm's RESULT is a MIXED scalar+composite union
// (`K0 | {w: i32} | f64 | null` — at least one scalar/litunion atom AND one
// struct/map/array/closure atom) that NO registration path admitted (not a registered
// union alias, not a value union, not a litunion-arm value union, not a map-member
// union). Such a union has no pin/box path for a contextual lambda, so the synthetic
// `>u` `$fnsig` must NOT be interned for it (see `collectCloSigs`' TypeRef pass) — the
// call site then rejects loudly instead of cast-trapping at runtime.
function nulCloMixedUnionUnregistered(arm: string) {
  const res = cloResultAtomOf(arm)
  if res == "" { return false }
  const atoms: string[] = []
  splitUnionAtoms(res, atoms)
  if atoms.length < 2 { return false }
  let hasScalar = false
  let hasComposite = false
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    if a != "null" {
      if valueAtomKind(a) >= 0 || nameIsLitUnionType(a) {
        // A closure atom is value-atom kind 11 but composes like a ref — count only
        // the NON-closure value atoms as the scalar side of the mix test.
        if nameIsFuncTypeAtom(a) {
          hasComposite = true
        } else {
          hasScalar = true
        }
      } else {
        hasComposite = true
      }
    }
    i = i + 1
  }
  if !hasScalar || !hasComposite { return false }
  if isUName(res) { return false }
  if isValueUnionName(res) { return false }
  if nameIsLitUnionArmValueUnion(res) { return false }
  if nameIsMapMemberUnion(res) { return false }
  true
}

// Was the annotation at `ix` SPELLED as an array? The parser's tree where it survives, the
// rendering's trailing-`[]` test where it does not.
function annSpelledArray(ix: i32, nm: string): boolean {
  const root = annTsOf(ix)
  if root >= 0 { return tsKind[root] == TS_ARR }
  nameIsArray(nm)
}
