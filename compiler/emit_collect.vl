// Open the union type block for a value-union join the program declares nowhere. Registration
// is what sets `uDeclared`, and the variant structs, the box and the per-rep value boxes are
// all minted under it, so an inferred join had no box to coerce its atom into. Flag-only and
// order-blind: `markValueUnionAtoms` reads atom KINDS, so no member order is invented (D1745).
function markInferredJoinAtoms(ty: i32) {
  if ty < 0 { return 0 }
  const t = tyAt(ty)
  // A `TyUnion` join boxes; so does the `T | null` an else-less `if` records, but only where
  // its INNER is one of the four scalars a declared `X | null` boxes — `string` and `boolean`
  // are niches. Every other arena shape reaches neither test and is not a join this mint
  // owns, which is the same decline the `TyUnion`-only form made (D1767).
  let joinBoxes = false
  if t is TyUnion { joinBoxes = true }
  if t is TyNullable {
    const ik = repOfTy(t.nInner).rdKind
    if ik == "i32" || ik == "i64" || ik == "f64" || ik == "f32" {
      joinBoxes = true
    }
    if primNameOf(t.nInner) == "v128" { joinBoxes = true }
  }
  if !joinBoxes { return 0 }
  if unRowOfCanonFolded(ty) >= 0 { return 0 }
  const nm = arenaEmitName(ty)
  if nm == "" { return 0 }
  uDeclared = true
  markValueUnionAtoms(ty)
}

// Could this functype's result be a mixed scalar-plus-composite union? `false` is a definite
// no, so the caller knows `nulCloMixedUnionUnregisteredTy` would answer false without
// rendering the type. This is the guard's answer, not its early-out: an atom count is a fact
// about the spelling, while the verdict is structural.
function cloResultMaybeMixed(tyIx: i32): boolean {
  if tyIx < 0 { return false }
  const t = tyAt(tyIx)
  if !(t is TyFunc) { return false }
  const fr = t.fnRet
  if fr < 0 { return false }
  const frt = tyAt(fr)
  // Exhaustive over `Ty` and `_`-less: only a union has arms to mix, and a new arena variant
  // that might must be classified here rather than take the `false` below.
  match frt {
    TyUnion => {
      return unionArmsMixed(frt.uMembers)
    }
    TyNullable => {
      // A `| null` result is a wrapper here and an atom in the spelling; the mix question is
      // about what is inside it.
      if frt.nInner < 0 { return false }
      const it = tyAt(frt.nInner)
      if it is TyUnion { return unionArmsMixed(it.uMembers) }
      return false
    }
    TyPrim => {
      // A scalar result has one arm; nothing to mix.
    }
    TyLit => {
      // A literal is a scalar arm on its own.
    }
    TyObj => {
      // A composite result is one arm too; the mix is a property of a union, not a member.
    }
    TyArray => {
      // As `TyObj`: one composite arm.
    }
    TyMap => {
      // As `TyObj`: one composite arm.
    }
    TyFunc => {
      // A closure result is composite and single; a mixed union under it is that type's own
      // question, asked when the walk reaches it.
    }
    TyVar => {
      // Unsubstituted here, so it names no arms.
    }
    TyErr => {
      // The error hole claims no arms.
    }
    TyNeg => {
      // A negation carries no member list.
    }
  }
  false
}

// Do these union members carry both a scalar (prim or literal) and a composite (object,
// map, array or closure) arm? A closure counts composite, mirroring the name guard's
// `nameIsFuncTypeAtom` exception.
function unionArmsMixed(ms: i32[]): boolean {
  let hasScalar = false
  let hasComposite = false
  let i = 0
  while i < ms.length {
    if ms[i] >= 0 {
      const m = tyAt(ms[i])
      // Exhaustive over `Ty` and `_`-less: a new arena variant must be classified scalar or
      // composite here, not fall into neither and report a mixed union as unmixed.
      match m {
        TyObj => {
          hasComposite = true
        }
        TyMap => {
          hasComposite = true
        }
        TyArray => {
          hasComposite = true
        }
        TyFunc => {
          hasComposite = true
        }
        TyPrim => {
          hasScalar = true
        }
        TyLit => {
          hasScalar = true
        }
        TyUnion => {
          // A nested union's own arms are its own question; this one asks about `ms`.
        }
        TyNullable => {
          // The `| null` wrapper, which the caller strips before asking.
        }
        TyVar => {
          // Unsubstituted, so it is neither side of the mix.
        }
        TyErr => {
          // The error hole is neither side.
        }
        TyNeg => {
          // A negation has no rep of its own to mix.
        }
      }
    }
    i = i + 1
  }
  hasScalar && hasComposite
}

// An annotation node's row, routed through the canon column where canon rewrote the
// node. `canonEmitTypeNames` rewrites `TypeRef.tyName` in place and leaves `nodeTyIx`
// holding the type the checker recorded before that rewrite, so on a rewritten node the
// recorded element name is post-canon while `nodeTyIxOf` is pre-canon.
function fdRowOf(fdType: i32) {
  if canonRewroteNode(fdType) { return canonTyIxOf(fdType) }
  nodeTyIxOf(fdType)
}

// The variant identity column's literal rung: a bare literal annotation (`kind: "circle"`)
// renders through canon as a softened `string`, so two variants differing only in their tag
// record a character-identical row and fold as layout-equal twins. Every `TyLit` kind; the
// quotes keep a literal `"i32"` tag from colliding with the type `i32` in a text column.
function variantFieldIdText(txt: string, tyIx: i32) {
  if tyIx < 0 { return txt }
  const t = tyAt(tyIx)
  if t is TyLit { return "\"" + t.litText + "\"" }
  txt
}

// The discriminant column's cell for a field whose annotation resolved to arena type `tyIx`:
// `tyIx` itself when it denotes a literal set, -1 otherwise (D1023). The identity column
// above cannot answer this — a multi-member set reaches it already softened by canon — so
// the arena index is banked beside the text rather than derived from it.
function litSetTyIxOf(tyIx: i32): i32 {
  if tyIx < 0 { return -1 }
  if tyIsLitSet(tyIx) { return tyIx }
  -1
}

// The hint for a field row pushed from a `FieldDef` node: the field's own row projected per
// `code`, declined for a list of literal unions. The element's type, never its stored name,
// decides its row (D6).
function fieldElemHintOf(fdType: i32, code: i32, elemNm: string) {
  if elemNm == "" { return -1 }
  const fty = nodeTyIxOf(fdType)
  // A bare string literal's atom row is its own literal type; its lexeme resolves to none.
  if code == FC_I32 && tyIsOneStrLit(fty) { return fty }
  fieldElemHintOfRow(fdRowOf(fdType), fty, code)
}

// `fieldElemHintOf` for a field read off its type `fdRow` (`fty` the field's own type where the
// projection has none): the row projected per `code`, a literal union (or a `| null` one's
// non-null part) as its arena type, and -1 for a list of literal unions.
function fieldElemHintOfRow(fdRow: i32, fty: i32, code: i32): i32 {
  const er = shapeFieldElemRow(fdRow, code)
  // A literal union is handed over as its arena type, the field's own where the projection has
  // none, so the recorder never resolves the spelling (that would mint past the mint-order line).
  let lu = er
  if lu < 0 { lu = tyPeelNul(fty) }
  if tyIsLitUnion(lu) && !tyIsOneStrLit(lu) { return lu }
  if tyIsLitUnionArray(er) { return -1 }
  er
}

// The arena element row of the list expression at `ix`, or -1 — the hint half of the
// ref-list interners' `(name, ty)` pair. Offered only beside the checker's own recorded
// element name.
function rlHintElemTy(ix: i32) {
  const rt = nodeRepTyIxOf(ix)
  if rt < 0 { return -1 }
  const t = tyAt(rt)
  if t is TyArray { return t.aElem }
  -1
}

// The arena element type of the array node `ix`, read off the checker's recorded type
// (`nodeTyIxOf`) rather than the rep one — the type `arrLitInferUnionElemName` renders its
// name from, so the members this feeds to `collectTyMembersReach` are that name's members.
function arrLitElemTyIxOf(ix: i32) {
  const at = nodeTyIxOf(ix)
  if at < 0 { return -1 }
  const t = tyAt(at)
  if t is TyArray { return t.aElem }
  -1
}

// A bounded read of a parallel type column beside a name array. These columns are padded
// lazily at their mint sites, so a row can exist in the name array before the column reaches
// it; -1 is the "no hint" value every hinted interner handles, which makes a short column
// degrade to the unhinted call instead of trapping.
function rlColAt(col: i32[], i: i32) {
  if i < 0 { return -1 }
  if i >= col.length { return -1 }
  col[i]
}

// Whether `initIx` is a bare read of a scalar-valued map, whose `V | null` result reps as the
// shared value box.
function initNullableIsBoxScalar(initIx: i32) {
  if initIx < 0 { return false }
  const recv = fusedMapReadRecvIx(unwrapParen(initIx))
  if recv < 0 { return false }
  for rt in elabNodeInstTys(unwrapParen(recv)) {
    if mapTyScalarBoxKind(rt) >= 0 { return true }
  }
  false
}

// Whether `initIx` is a name read, or a narrowed field or element read, the checker typed as a
// value-union box.
function initIsNarrowedBoxRead(initIx: i32): boolean {
  const ri = unwrapParen(initIx)
  if ri < 0 { return false }
  if !(nodeAt(ri) is Ident) && !placeReadIsNarrowed(ri, -1) { return false }
  const ty = nodeTyIxOf(ri)
  ty >= 0 && tyIsValueUnionBox(ty) && !tyIsLitUnion(ty)
}

// The value type at the bottom of a chain of map types — `Circle` for both `{[string]: Circle}`
// and `{[string]: {[string]: Circle}}` — or -1 when `ty` is not a map (D156).
function mapLeafValTy(ty: i32): i32 {
  let cur = tyMapValOf(ty)
  if cur < 0 { return -1 }
  let hops = 0
  while hops < 8 {
    const nxt = tyMapValOf(cur)
    if nxt < 0 { return cur }
    cur = nxt
    hops = hops + 1
  }
  cur
}

// The list literal's element row, keyed off the element's own committed rep rather than off
// the checker's structural shape (D163). A separate pass and not a rung: the classifiers must
// agree per slot but are called from two places, so a rung asking `parentLetOf` would answer
// at one and decline at the other, keying one literal to two rows. Runs before `monomorphize`.
export function scanArrLitCommit(rootIx: i32) {
  let fe = 0
  while fe < fnStmts.length {
    const fnIx = fnStmts[fe]
    const fn = nodeAt(fnIx)
    if fn is FuncDecl { alcWalk(fn.fnBody, fn.fnBody, fnIx) }
    fe = fe + 1
  }
  // The module's own statements, with the program node as the scope: `plScanStmt` has a
  // `Program` arm and no `FuncDecl` one, so a function's locals cannot leak into its map.
  if rootIx >= 0 { alcWalk(rootIx, rootIx, -1) }
  0
}

// Every `ArrayLit` lexically inside one scope, not descending into a nested `FuncDecl`, which
// has its own `fnStmts` row and is walked as its own body.
function alcWalk(ix: i32, bodyIx: i32, fnIx: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if ix != bodyIx {
    if n is FuncDecl { return 0 }
  }
  if n is ArrayLit {
    if n.arrElems.length >= 1 {
      // Every element must commit to the same name: `const xs = [c, d]` over two arms of one
      // union is a union-box list, and reading only the first would key it under one arm. A
      // heterogeneous literal has no single committed rep, so the bank stays empty and the
      // checker-typed union rung keeps it.
      const ca = alcCommitAnn(n.arrElems[0], bodyIx, fnIx, 0)
      const cn = alcAnnName(ca)
      let agree = alcNamesArm(cn, ca)
      let ei = 1
      while ei < n.arrElems.length {
        if alcAnnName(alcCommitAnn(n.arrElems[ei], bodyIx, fnIx, 0)) != cn {
          agree = false
        }
        ei = ei + 1
      }
      if agree { recordArrLitCommitName(ix, cn, ca) }
    }
  }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      alcWalk(kids[k], bodyIx, fnIx)
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  0
}

// Does the annotation `ann`, spelled `name`, reach a union arm — bare, or through map values at
// any depth? The gate, asked of a committed element: the
// struct/variant seam is the only place the checker's structural record and the element's
// committed rep can name different heaps (D39).
function alcNamesArm(name: string, ann: i32): boolean {
  if name == "" { return false }
  if annDeclVariantRow(ann) >= 0 { return true }
  repTyHasArmShape(mapLeafValTy(annRowOfNode(ann)))
}

// The spelling of the annotation node `ann`, or "" for none.
function alcAnnName(ann: i32): string {
  if ann < 0 { return "" }
  tyNameOf(ann)
}

// The annotation node the expression at `ex` has already committed its rep to, or -1. Four
// sources, every one an annotation a user wrote or a pin synthesized and never an inference: a
// bound local, a parameter, a callee's declared result, and a callee's inferred result read
// through the binding that supplies it. Depth-bounded, since the arena is not this pass's to trust.
function alcCommitAnn(ex: i32, bodyIx: i32, fnIx: i32, depth: i32): i32 {
  if ex < 0 { return -1 }
  if depth > 4 { return -1 }
  const u = unwrapParen(ex)
  if u < 0 { return -1 }
  const n = nodeAt(u)
  match n {
    Ident => {
      const lli = bodyLetOfRead(bodyIx, u)
      if lli >= 0 {
        const ld = nodeAt(lli)
        if ld is LetDecl {
          if ld.letType >= 0 { return ld.letType }
          // An un-annotated binding is a link in the chain, not the end of it: the alias
          // re-names a value, it does not re-rep one.
          return alcCommitAnn(ld.letInit, bodyIx, fnIx, depth + 1)
        }
        return -1
      }
      const pn = alcParamAnn(fnIx, n.identName)
      if pn >= 0 { return pn }
      const gli = globalLetOfDeclRead(u)
      if gli >= 0 {
        const gd = nodeAt(gli)
        if gd is LetDecl {
          if gd.letType >= 0 { return gd.letType }
        }
      }
      return -1
    }
    Call => {
      const cf = nodeAt(unwrapParen(n.callFn))
      if cf is Ident {
        const cfe = fnIndexOfNode(unwrapParen(n.callFn))
        if cfe >= 0 && cfe < fnStmts.length {
          const cix = fnStmts[cfe]
          const cfn = nodeAt(cix)
          if cfn is FuncDecl {
            // A declared result is the commitment; nothing inside the callee can overrule the
            // claim it makes about its own result.
            if cfn.fnRet >= 0 { return cfn.fnRet }
            const crx = fnRetExprOf(cix)
            if crx < 0 { return -1 }
            return alcCommitAnn(crx, cfn.fnBody, cix, depth + 1)
          }
        }
      }
      return -1
    }
    // No other expression commits to a name.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// The annotation node of parameter `name` of the function at `fnIx`, or -1. The parameter
// half of the lookup above: `parentLetOf` answers for a function's locals and a parameter is
// not one, yet it is the commitment an identity conduit's body hands back.
function alcParamAnn(fnIx: i32, name: string): i32 {
  if fnIx < 0 { return -1 }
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    let j = 0
    while j < fn.fnParams.length {
      const pp = nodeAt(fn.fnParams[j])
      if pp is Param {
        if pp.parName == name {
          if pp.parType >= 0 { return pp.parType }
          return -1
        }
      }
      j = j + 1
    }
  }
  -1
}

// Scan the program's top-level statements into `fnStmts` (`FuncDecl`s only, in order),
// skipping `TypeDecl`s and gathering top-level `LetDecl`s into `globalStmts` (module
// globals, declaration order = global index). Any other top-level statement fails loudly.
// Returns the function count, or -1 via `emitFail`.
export function collectFns(stmts: i32[]) {
  fnStmts = []
  fnPosIndexDrop()
  fnParent = []
  fnInstOrigin = []
  // Mono refills it; until then a shared instance holds the previous program's, which
  // `fnPosResultUnconsumed` would read at the first `recordedVoidFns`.
  monoOrigNode = []
  cloLiftCapN = []
  cloLiftedFes = []
  cloLiftWrReset()
  lfReset()
  globalStmts = []
  globalStmtOrd = []
  globalIndexBySid = []
  gPromoOk = []
  gPromoSlot = []
  gCellIdx = []
  gFoldOk = []
  gFoldAt = []
  gFoldLen = []
  gFoldPool = []
  startStmts = []
  startStmtOrd = []
  topFnNodes = []
  topFnOrd = []
  lambdaCtr = 0
  fnDispNames = []
  fnValUsed = false
  fnNestUsed = false
  fnAddrTaken = []
  let nCellsSoFar = 0
  let i = 0
  while i < stmts.length {
    const s = nodeAt(stmts[i])
    if s is FuncDecl {
      fnStmts.push(stmts[i])
      fnParent.push(-1)
      fnDispNames.push("")
      topFnNodes.push(stmts[i])
      topFnOrd.push(i)
    } else if s is LetDecl {
      // A top-level `let`/`const` — a module global; its position here is its index.
      globalStmts.push(stmts[i])
      globalStmtOrd.push(i)
      // The build point for `globalIndexBySid`: every key is interned here, which is what
      // makes `sid >= length` mean absent for every later lookup. The id comes from the
      // carrier, so the build pays one intern per global.
      const gsid = sidOfNode(stmts[i])
      if sidArrGet(globalIndexBySid, gsid) < 0 {
        sidArrPut(globalIndexBySid, gsid, globalStmts.length - 1)
      }
      // Every binding starts life as a cell at its own declaration index;
      // `computeGlobalPromotion` rewrites both arrays after the last pass has finished
      // mutating the arena.
      gPromoOk.push(0)
      gPromoSlot.push(-1)
      // An `extern let` is an imported global and never a defined cell.
      if externGlobalLinkOfNode(stmts[i]) >= 0 {
        gCellIdx.push(-1)
      } else {
        gCellIdx.push(nCellsSoFar)
        nCellsSoFar = nCellsSoFar + 1
      }
    } else if nodeIsTypeDecl(stmts[i]) {
    } else if s is UnionDecl {
      // A `type N = A | B` union alias — collected by `collectU`, skipped here.
    } else if s is ImportDecl {
      // A tooling node (the lint tier reads it) — the module front end already
      // resolved and merged the import, so the emitter has nothing to lower.
    } else {
      // A top-level statement — runs in the synthetic start function, in source order.
      startStmts.push(stmts[i])
      startStmtOrd.push(i)
    }
    i = i + 1
  }
  // Lift nested function declarations and anonymous `function(...)` literals into the flat
  // `fnStmts` list, each becoming a real top-level wasm function with its own index. The
  // worklist grows as nested functions are discovered; an anonymous literal gets a synthesized
  // `__lambda_N` name written into the node.
  let wi = 0
  while wi < fnStmts.length {
    const fn = nodeAt(fnStmts[wi])
    if fn is FuncDecl { liftFnsInExpr(fn.fnBody, wi) }
    wi = wi + 1
  }
  // Also lift lambdas in top-level global initializers and start statements (parent -1).
  let gi = 0
  while gi < globalStmts.length {
    const g = nodeAt(globalStmts[gi])
    if g is LetDecl {
      if g.letInit >= 0 {
        const before = fnStmts.length
        liftFnsInExpr(g.letInit, -1)
        recordLambdaDispName(before, g.letInit, g.letName)
      }
    }
    gi = gi + 1
  }
  let si = 0
  while si < startStmts.length {
    liftFnsInExpr(startStmts[si], -1)
    si = si + 1
  }
  // A lambda lifted from a global initializer or start statement is pushed without its own
  // body being descended, because the worklist already finished at the old `fnStmts.length`.
  // Resuming from `wi` descends exactly the newly-lifted functions and is order-preserving:
  // already-descended entries keep their slot, so existing function indices do not move.
  while wi < fnStmts.length {
    const gfn = nodeAt(fnStmts[wi])
    if gfn is FuncDecl { liftFnsInExpr(gfn.fnBody, wi) }
    wi = wi + 1
  }
  // The `$fnsig` collection happens later (`collectCloSigs`, after `fnRetColsFromRecorded`): a
  // signature key reads each function's param and return kinds, and an un-annotated callback's
  // return kind is known only once inference ran.
  cloSigKeys = []
  cloSigPosBy = Map()
  cloSigRepFn = []
  // The pool's twin column is rebuilt at the pool's own emit; clear it with the two columns it
  // parallels so a long-lived process cannot read the previous module's folds through a
  // same-length coincidence.
  cloSigTwin = []
  fnStmts.length
}

// The one home of the `$fnsig` intern. Append `key` to the signature table under representative
// lifted-function `rep` (a real `fnStmts` index, or -1 for a key synthesized from an
// annotation). A "" key interns nothing; a present key keeps its original slot, so every pass
// below is idempotent. The paired push is what keeps the two columns the same length.
function internCloSigKey(key: string, rep: i32) {
  if key == "" { return 0 }
  if cloSigPosOfKey(key) >= 0 { return 0 }
  cloSigPosBy[key] = cloSigKeys.length
  cloSigKeys.push(key)
  cloSigRepFn.push(rep)
  0
}

// Interns the `$fnsig` of a union arm of arena type `ty` (-1 when unknown) at rep -1, keyed
// `kIn`, or by `unionArmSigKeyTy` when `kIn` is "". A mixed scalar-plus-composite union result
// is skipped: its synthesized sig would pass the call's floor while the un-pinned producer keeps
// its own functype, and the cast traps.
function internCloSigOfArmTy(kIn: string, ty: i32) {
  let k = kIn
  if k == "" { k = unionArmSigKeyTy(ty) }
  if k == "" { return 0 }
  if nulCloMixedUnionUnregisteredTy(ty) { return 0 }
  internCloSigKey(k, -1)
}

// Intern the `$fnsig` of function type `ty` at rep -1, keyed by `sigKeyOfTy`. A type the key
// declines (-1, a type parameter, a part outside the value-call ABI) interns nothing.
function internCloSigOfTy(ty: i32) { internCloSigKey(sigKeyOfTy(ty), -1) }

// `internCloSigOfTy` for a nullable closure's inner function type `ty`, skipping the mixed
// scalar-plus-composite union result `nulCloMixedUnionUnregisteredTy` names.
function internNulCloSigOfTy(ty: i32) {
  const k = sigKeyOfTy(ty)
  if k == "" { return 0 }
  if nulCloMixedUnionUnregisteredTy(ty) { return 0 }
  internCloSigKey(k, -1)
}

// Intern every closure `$fnsig` reachable through the result chain of a function type — a
// closure whose result is itself a closure (`() => ((i32) => f32)`), to any nesting depth. The
// concrete-lambda loop keys the outer sig as a collapsed `>c` and never mints the inner one, so
// a value call on the result finds nothing. Bounded to results that round-trip a value call.
function internCloResultChainTy(ty: i32) { internCloResultSpineTy(ty, false) }

// The spine walk. `wideShape` also takes an anonymous record result, for a nullable closure
// annotation whose value may only ever be `null`, so no concrete lambda mints that level's sig.
function internCloResultSpineTy(ty: i32, wideShape: boolean) {
  if ty < 0 { return 0 }
  let curTy = ty
  let guard = 0
  while guard < 64 {
    guard = guard + 1
    const ct = tyAt(curTy)
    if !(ct is TyFunc) { return 0 }
    const retTy = ct.fnRet
    if retTy < 0 { return 0 }
    const rt = tyAt(retTy)
    let retIsClosure = false
    if rt is TyFunc { retIsClosure = true }
    let takes = retIsClosure
    if !takes {
      if rt is TyPrim {
        const rp = rt.primName
        if (
          rp == "i32"
          || rp == "boolean"
          || rp == "f64"
          || rp == "f32"
          || rp == "i64"
        ) {
          takes = true
        }
      }
    }
    if !takes && wideShape && rt is TyObj {
      takes = structNameOfTy(retTy) == ""
    }
    if takes { internCloSigKey(sigKeyOfTy(curTy), -1) }
    if !retIsClosure { return 0 }
    curTy = retTy
  }
  0
}

// Collect the distinct `$fnsig` env-leading functypes — one per distinct eligible signature key
// across all lifted functions, in `fnStmts` order. Runs after `fnRetColsFromRecorded`, whose
// inferred return kinds the key reads, and after `collectMapFilterUse`, which may flip
// `fnValUsed`. Empty unless `fnValUsed`, the invariant that keeps every golden's bytes fixed.
export function collectCloSigs() {
  cloSigKeys = []
  cloSigPosBy = Map()
  cloSigRepFn = []
  // The pool's twin column is rebuilt at the pool's own emit; clear it with the two columns it
  // parallels so a long-lived process cannot read the previous module's folds through a
  // same-length coincidence.
  cloSigTwin = []
  if !fnValUsed { return 0 }
  // With no nested frame, 1 or 0 per `fnStmts` slot: whether its own `$fnsig` is interned. A
  // declared top-level function named nowhere but a call's callee is 0; empty means every slot.
  const valSlots: i32[] = []
  if !fnNestUsed {
    const callees: {[i32]: i32} = Map()
    const idents: i32[] = []
    let ci = 0
    while ci < P.nodes.length {
      const cn = nodeAt(ci)
      if cn is Call { callees[cn.callFn] = 1 }
      if cn is Ident { idents.push(ci) }
      ci = ci + 1
    }
    const named: {[string]: i32} = Map()
    for id in idents {
      const nn = nodeAt(id)
      if nn is Ident {
        if !callees.has(id) { named[nn.identName] = 1 }
      }
    }
    const declared: {[i32]: i32} = Map()
    for tn in topFnNodes { declared[tn] = 1 }
    for sx in fnStmts {
      let v = 1
      const fn = nodeAt(sx)
      if declared.has(sx) && fn is FuncDecl {
        if !named.has(fn.fnName) { v = 0 }
      }
      valSlots.push(v)
    }
  }
  let fe = 0
  while fe < fnStmts.length {
    if valSlots.length > 0 && valSlots[fe] == 0 {
      fe = fe + 1
      continue
    }
    collectLiftedCloSig(fe, fnStmts[fe])
    // A closure-returning-closure result: the lambda keys its own sig as the collapsed `>c` but
    // the inner closure's sig is never minted from a concrete lambda, so `g()(1)` has no
    // interned signature. Walk the result chain off the lambda's checker type — the same source
    // the call site reads — and synthesize each result closure's key at rep -1.
    if cloRetValKind(fe) == "closure" {
      internCloResultChainTy(nodeTyIxOf(fnStmts[fe]))
    }
    fe = fe + 1
  }
  // Extended field-closure signatures for index and operator-trap dispatch: an object-field
  // closure may be void or struct-returning, sigs the value ABI above excludes. Intern each
  // such field closure's extended key so the member-call site can `ref.cast` to the callee's
  // real functype. Only fires where the sig is not already value-eligible.
  let ai = 0
  while ai < P.nodes.length {
    const an = nodeAt(ai)
    if an is ObjLit {
      const fs = an.objFields
      let fi = 0
      while fi < fs.length {
        const f = nodeAt(fs[fi])
        if f is FieldInit {
          const ffe = fieldValueFeOf(f.fiValue)
          if ffe >= 0 {
            // The field closure is concrete, so its rep is the lifted function `ffe`.
            if fnSigKeyOf(ffe) == "" { internCloSigKey(cloSigKeyExt(ffe), ffe) }
          }
        }
        fi = fi + 1
      }
    }
    ai = ai + 1
  }
  // Closure-arm union signatures: a union with a function-type arm whose program has no
  // concrete closure of that arm's type still needs the arm's `$fnsig` interned, since the
  // narrowed call `call_indirect`s at it. `unionArmSigKeyTy` normalizes to the same key
  // `narrowedClosureOf` yields at the call site; rep -1, and gated by `fnValUsed`.
  let ui = 0
  while ui < unMemberSet.length {
    // The row's own recorded member columns, in the mint's atom order. A row the recorder
    // missed is split from its member set and typed member by member, as the recorder would.
    const atoms: string[] = []
    let uSt = -1
    if ui < unMemTyStart.length {
      uSt = unMemTyStart[ui]
      if uSt >= 0 {
        if uSt + unMemTyCount[ui] > unMemAtoms.length { uSt = -1 }
      }
    }
    const atomTys: i32[] = []
    if uSt >= 0 {
      let um = 0
      while um < unMemTyCount[ui] {
        atoms.push(unMemAtoms[uSt + um])
        atomTys.push(unMemTys[uSt + um])
        um = um + 1
      }
    } else {
      return emitFail("emitProgram: a union row has no member columns")
    }
    collectUnionArmCloSigs(atoms, atomTys)
    ui = ui + 1
  }
  // Nullable-closure annotations whose value is only ever `null` — narrowed and called, with no
  // concrete lambda anywhere to intern the closure's `$fnsig`. The nullable dual of the
  // closure-arm union pass above: walk every TypeRef and intern the inner closure key, which
  // `unionArmSigKeyTy` normalizes to the call site's, at rep -1. Idempotent via `cloSigPosOfKey`.
  let ni = 0
  while ni < P.nodes.length {
    const nn = nodeAt(ni)
    if nn is TypeRef {
      if nodeTyIsNulClosure(ni) {
        const nInnerTy = tyPeelNul(nodeTyIxOf(ni))
        // The key reads the result's rep, so a result map mints its value slot first.
        forceCloResultMapTypes(nInnerTy)
        // The nulclosure annotation's inner closure sig.
        internNulCloSigOfTy(nInnerTy)
        // A nulclosure whose result is itself a closure: the intern above mints only the outer
        // sig, its result collapsed to the shared `>c` fat pointer, so a chained value call on
        // the narrowed result finds no sig for the inner closure. Walk the result spine.
        internCloResultSpineTy(nInnerTy, true)
      }
      // A closure-element array annotation, plain or nullable-element, whose value may carry no
      // concrete lambda of the element type: the narrowed indexed or rebound call still
      // `ref.cast`s to the element's `$fnsig`, so intern it from the annotation's element type.
      // The array dual of the nulclosure pass above.
      internCloSigOfTy(cloArrElemFuncTyOf(nodeTyIxOf(ni)))
    }
    ni = ni + 1
  }
  // The arena closure-sig walk, last so an already-interned sig keeps its slot: descend the
  // arena type of each annotation the union registration walk recorded (`cloSigWalkRoots`, the
  // safe root set rather than a blind `P.nodes` scan) and intern each reachable `TyFunc`'s
  // `$fnsig`. Idempotent and order-stable via `cloSigPosOfKey`; unreachable without `fnValUsed`.
  let ri = 0
  while ri < cloSigWalkRoots.length {
    if collectTyReachCloSigs(cloSigWalkRoots[ri], 16) < 0 { return -1 }
    ri = ri + 1
  }
  // Every lifted function's own type is a root too (D1474). `cloSigWalkRoots` holds a
  // declaration's parameter annotations, so its function-typed parameter interns a `$fnsig`;
  // a lambda is an expression and its parameters reach none, so a call of one had no
  // signature. After the roots above, so every key they mint keeps its slot.
  let lf = 0
  while lf < fnStmts.length {
    const lfTy = nodeTyIxOf(fnStmts[lf])
    if valSlots.length > 0 && valSlots[lf] == 0 {
      if collectFnPartsCloSigs(lfTy) < 0 { return -1 }
    } else if collectTyReachCloSigs(lfTy, 16) < 0 {
      return -1
    }
    lf = lf + 1
  }
  0
}

// `collectCloSigs`'s step for the lifted function `fe`, whose statement is `sx`: interns its
// own `$fnsig` at rep `fe`, then the inner closure's sig when its result is a nullable closure.
function collectLiftedCloSig(fe: i32, sx: i32) {
  let key = fnSigKeyOf(fe)
  // A void- (`>v`) or struct-returning (`>sN;`) function used as a value needs its extended
  // sig interned too — the value-eligible key above excludes both. `cloSigKeyExt` yields ""
  // for the kinds still outside the value ABI, so those stay unminted.
  if key == "" { key = cloSigKeyExt(fe) }
  // The concrete-lambda rep: this key's representative is the lifted function itself, not the
  // -1 synth sentinel.
  internCloSigKey(key, fe)
  // A nullable-closure result (key `…>C`): intern the inner closure's `$fnsig` too, since the
  // inner closure is never constructed and a narrowed value call would find no interned sig.
  // The inner type rides the lambda's pinned `fnRet` nullable part, and `unionArmSigKeyTy`
  // yields the same key the narrowed call site derives. Usage-gated by `fnValUsed`.
  if cloRetValKind(fe) == "nulclosure" {
    const rfn = nodeAt(sx)
    if rfn is FuncDecl {
      // An un-instantiated generic template's result still holds its type parameter, which
      // `sigKeyOfTy` declines, so the template cannot steal a concrete lambda's rep for its key.
      const inTy = tyPeelNul(nodeTyIxOf(rfn.fnRet))
      if inTy >= 0 && tyAt(inTy) is TyFunc { internNulCloSigOfTy(inTy) }
    }
  }
  0
}

// `collectCloSigs`'s step for one union row: interns the closure sig of each function-type arm
// and of each closure-array arm's element. `atomTys` is the arms' arena types, parallel to
// `atoms`; an arm with no type (-1) interns nothing.
function collectUnionArmCloSigs(atoms: string[], atomTys: i32[]) {
  let uj = 0
  while uj < atoms.length && uj < atomTys.length {
    const armRow = atomTys[uj]
    if armRow >= 0 {
      const armT = tyAt(armRow)
      if armT is TyFunc { internCloSigOfArmTy(sigKeyOfTy(armRow), armRow) }
      // A closure-array arm, plain or nullable-element: the element closure sig is interned by
      // neither the function-arm branch above nor the TypeRef pass below, which sees only a
      // top-level closure-array annotation.
      internCloSigOfTy(cloArrElemFuncTyOf(armRow))
    }
    uj = uj + 1
  }
  0
}

// The function type of list type `ty`'s element, its `| null` peeled; -1 for any other type.
function cloArrElemFuncTyOf(ty: i32): i32 {
  if ty < 0 { return -1 }
  const at = tyAt(ty)
  if at is TyArray {
    const el = tyPeelNul(at.aElem)
    if el >= 0 && tyAt(el) is TyFunc { return el }
  }
  -1
}

// The closures inside function type `tyIx`'s parameters and result, without the function's own
// `$fnsig`: the walk for a function that is never a value. A non-function type walks whole.
function collectFnPartsCloSigs(tyIx: i32) {
  if tyIx < 0 { return 0 }
  const t = tyAt(tyIx)
  if t is TyFunc {
    const ps = t.fnParamTypes
    let i = 0
    while i < ps.length {
      if collectTyReachCloSigs(ps[i], 15) < 0 { return -1 }
      i = i + 1
    }
    return collectTyReachCloSigs(t.fnRet, 15)
  }
  collectTyReachCloSigs(tyIx, 16)
}

// Record a directly-bound lambda's debug display name for the name section. `slot` is the
// `fnStmts` index it lifted to, captured before the lift call, since a directly-bound lambda is
// that call's first and only push. `fnName` stays the synthesized `__lambda_N` so call
// resolution and `fnNameMap` are untouched; only a trap backtrace reads the friendlier name.
function recordLambdaDispName(slot: i32, initIx: i32, name: string) {
  if initIx < 0 || name.length == 0 || slot >= fnDispNames.length { return 0 }
  const iv = nodeAt(initIx)
  if iv is FuncDecl { fnDispNames[slot] = name }
  0
}

// The lowest arena index in the subtree at `ix`: where a declaration's own scope begins, since
// the arena is built in post-order and a node follows every node beneath it.
function subtreeLo(ix: i32): i32 {
  let lo = ix
  const stack: i32[] = [ix]
  while stack.length > 0 {
    const at = stack.pop() ?? -1
    if at >= 0 && at < P.nodes.length {
      if at < lo { lo = at }
      const kids = nodeChildren(at)
      let k = 0
      while k < kids.length {
        stack.push(kids[k])
        k = k + 1
      }
    }
  }
  lo
}

// Recursively walk the node at `ix` and append every nested `FuncDecl` — a nested declaration
// statement or an arrow lambda in expression position — to `fnStmts`. An anonymous lambda is
// given a synthesized unique name first, so it resolves like a named function. The function's
// own body is not descended here; the worklist in `collectFns` does that exactly once.
function liftFnsInExpr(ix: i32, parent: i32) {
  if ix < 0 { return 0 }
  const n = nodeAt(ix)
  match n {
    FuncDecl => {
      if n.fnName == "" {
        n.fnName = "__lambda_" + i32ToStr(lambdaCtr)
        lambdaCtr = lambdaCtr + 1
        // An in-place name write (`compiler/symbols.vl`): `fnIndexOfSid`'s dense array is keyed by
        // the carrier and `buildFnMap` interns `s.fnName` for every lifted function, so a stale
        // carrier slot here would key the lambda's row under the anonymous "" it replaced.
        sidNoteNodeName(ix, ix)
      }
      fnStmts.push(ix)
      fnParent.push(parent)
      fnDispNames.push("")
      fnValUsed = true
      fnNestUsed = true
      return 0
    }
    Block => {
      const stmts = n.blkStmts
      let i = 0
      while i < stmts.length {
        const before = fnStmts.length
        const sn = nodeAt(stmts[i])
        let named = false
        if sn is FuncDecl { named = sn.fnName != "" }
        liftFnsInExpr(stmts[i], parent)
        if named && fnStmts.length > before {
          const fsid = sidOfNode(stmts[i])
          lfNoteBlockLocal(before, fsid, subtreeLo(stmts[i]), stmts[i], ix)
        }
        i = i + 1
      }
      return 0
    }
    LetDecl => {
      if n.letInit >= 0 {
        const before = fnStmts.length
        liftFnsInExpr(n.letInit, parent)
        recordLambdaDispName(before, n.letInit, n.letName)
      }
      return 0
    }
    RetStmt => {
      if n.retArg >= 0 { liftFnsInExpr(n.retArg, parent) }
      return 0
    }
    IfStmt => {
      // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
      let cur = ix
      while cur >= 0 {
        const c = nodeAt(cur)
        cur = -1
        if c is IfStmt {
          liftFnsInExpr(c.ifCond, parent)
          liftFnsInExpr(c.ifThen, parent)
          if c.ifElse >= 0 {
            if nodeAt(c.ifElse) is IfStmt {
              cur = c.ifElse
            } else {
              liftFnsInExpr(c.ifElse, parent)
            }
          }
        }
      }
      return 0
    }
    WhileStmt => {
      liftFnsInExpr(n.whileCond, parent)
      liftFnsInExpr(n.whileBody, parent)
      return 0
    }
    ForRange => {
      liftFnsInExpr(n.frFrom, parent)
      liftFnsInExpr(n.frTo, parent)
      if n.frStep >= 0 { liftFnsInExpr(n.frStep, parent) }
      liftFnsInExpr(n.frBody, parent)
      return 0
    }
    ForIn => {
      liftFnsInExpr(n.fiIter, parent)
      liftFnsInExpr(n.fiBody, parent)
      return 0
    }
    Call => {
      liftFnsInExpr(n.callFn, parent)
      const args = n.callArgs
      let i = 0
      while i < args.length {
        liftFnsInExpr(args[i], parent)
        i = i + 1
      }
      return 0
    }
    BinExpr => {
      liftFnsInExpr(n.binLeft, parent)
      liftFnsInExpr(n.binRight, parent)
      return 0
    }
    Unary => {
      liftFnsInExpr(n.unArg, parent)
      return 0
    }
    Paren => {
      liftFnsInExpr(n.parInner, parent)
      return 0
    }
    // The operand-carrying node kinds this walk must enter (D1085): each wraps an ordinary
    // expression that may hold a function literal, and a literal this walk does not reach is never
    // pushed to `fnStmts`. `MatchExpr` is absent because `match` desugars into `IfStmt`/`Block`.
    AsExpr => {
      liftFnsInExpr(n.asObj, parent)
      return 0
    }
    IsExpr => {
      liftFnsInExpr(isExprKid(n), parent)
      return 0
    }
    Member => {
      liftFnsInExpr(n.memObj, parent)
      return 0
    }
    // A `?.` RECEIVER, walked like the `.` one above: only the standalone `?.` value path
    // requires a re-readable receiver, so a call — and a lambda argument inside it — reaches
    // the null-test lowering, and an unlifted literal there refuses (D1667).
    OptMember => {
      liftFnsInExpr(n.omObj, parent)
      return 0
    }
    Index => {
      liftFnsInExpr(n.idxArr, parent)
      liftFnsInExpr(n.idxIndex, parent)
      return 0
    }
    ObjLit => {
      const fields = n.objFields
      let i = 0
      while i < fields.length {
        const f = nodeAt(fields[i])
        if f is FieldInit { liftFnsInExpr(f.fiValue, parent) }
        i = i + 1
      }
      return 0
    }
    // A spread's source is an operand like any other (D2334).
    Spread => {
      return liftFnsInExpr(n.spdArg, parent)
    }
    ArrayLit => {
      const elems = n.arrElems
      let i = 0
      while i < elems.length {
        liftFnsInExpr(elems[i], parent)
        i = i + 1
      }
      return 0
    }
    // No other node holds an expression a function literal can sit in.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | ErrExpr | Param | TypeRef | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | MatchExpr | ImportDecl | LoopVar => {}
  }
  0
}

// The monomorphizer re-points a `fnStmts` slot or a `fnParent` entry in place. `buildFnMap`
// reads both — the row comes off `P.nodes[fnStmts[i]]`, and `fnParent[i]` decides the nested
// mark — so such a write re-classifies a function the banked prefix already covers, and
// retires it. No length moves, which is why the arena stamp alone cannot see this.
export function buildFnMapNoteFnSlotWrite() {
  fmSeenFns = -1
  fmDirtySlots = []
  fnPosIndexDrop()
  0
}

// Rows of the banked prefix whose `fnStmts` slot now holds a different declaration of the same
// name; a resume re-classifies each in place instead of the whole prefix (D3761).
let fmDirtySlots: i32[] = []

// Note `fnStmts[slot] = node` before it lands. When the slot is its own row and `node` keeps the
// row's name, the name, its sid and the nested mark stand and only that row's return facts move.
export function buildFnMapNoteFnStmtWrite(slot: i32, node: i32) {
  if slot >= 0 && slot < fnStmts.length {
    inferRetNodeCarryNote(fnStmts[slot], node)
  }
  if fmSeenFns < 0 || slot >= fmSeenFns {
    fnPosIndexDrop()
    return 0
  }
  const nd = nodeAt(node)
  const od = if slot >= 0 && slot < fnStmts.length { nodeAt(fnStmts[slot]) } else { nd }
  if slot >= 0 && slot < fRetKind.length && nd is FuncDecl && od is FuncDecl {
    if nd.fnName == od.fnName {
      fmDirtySlots.push(slot)
      fnPosIndexDrop()
      return 0
    }
  }
  buildFnMapNoteFnSlotWrite()
}

// Can this call keep the covered prefix's rows and classify only the suffix and dirty slots?
// Only an armed call with a prefix banked: mono's own rounds. A kept row stands only until
// `recordedVoidFns#2`, which re-reads every row once mono is done.
function buildFnMapResumable(): boolean {
  if !fmResumeArmed { return false }
  if fmSeenFns < 0 { return false }
  fmSeenFns <= fnStmts.length
}

// Write the annotation's return facts to row `li`: appended when it is the next row, else set.
function buildFnMapPutRow(
  li: i32,
  rv: i32,
  sidx: i32,
  rae: string,
  rb: i32,
  rk: VKind,
) {
  if li < fRetKind.length {
    fRetVoid[li] = rv
    fRetStructIdx[li] = sidx
    fRetRArrElem[li] = rae
    fRetRListRow[li] = -1
    fRetBool[li] = rb
    fRetKind[li] = rk
    fRetLitAtom[li] = 0
    return 0
  }
  fRetVoid.push(rv)
  fRetStructIdx.push(sidx)
  fRetRArrElem.push(rae)
  fRetRListRow.push(-1)
  fRetBool.push(rb)
  fRetKind.push(rk)
  fRetLitAtom.push(0)
  0
}

// Bank the `fnStmts` prefix this run's rows cover. Only an armed run banks, so no prefix
// crosses a pass that edits the arena in place.
function buildFnMapBankPrefix() {
  if !fmResumeArmed { return 0 }
  fmSeenFns = fnStmts.length
  0
}

// Bank row `li`'s return columns from annotation `ann` (-1 for none), read off the declared
// type's rep as an un-annotated row's are off its recorded one. A record's row is the one its
// signature is emitted at (`retStructRowIndex`), which a same-shape twin need not share.
function buildFnMapRowOfRetAnn(li: i32, ann: i32) {
  const rsk = vtKindOfType(ann)
  const t0 = if ann >= 0 { nodeRepTyIxOf(ann) } else { -1 }
  const ty = if t0 >= 0 || ann < 0 { t0 } else { nodeTyIxOf(ann) }
  // A bare annotation is its rows' first reader, so they are minted here, ahead of the read; a
  // `| null` one's mint at the signature pass, and moving either moves the type indices.
  if ann >= 0 && nodeAt(ann) is TypeRef && annTyNulFlag(ann) == 0 {
    arrLitMint(ann)
  }
  let sidx = -1
  if rsk == "struct" || rsk == "nulstruct" {
    sidx = retStructRowIndex(ann)
  } else if rsk == "variant" || rsk == "nulvariant" {
    sidx = repSlotOfKind(rsk, ty)
  }
  const lr = if rsk == "reflist" { repSlotOfKind(rsk, ty) } else { -1 }
  buildFnMapPutRow(
    li,
    if ty == TY_VOID || ty == TY_NEVER { 1 } else { 0 },
    sidx,
    if lr >= 0 && lr < rlElemName.length { rlElemName[lr] } else { "" },
    if ty == TY_BOOL { 1 } else { 0 },
    rsk,
  )
}

// Map each function name to its position in `fnStmts`, and record its
// annotated return facts; `fnRetColsFromRecorded` writes an un-annotated row's after mono. Built
// before any body is emitted, so forward references resolve. Returns the count.
export function buildFnMap(_stmts: i32[]) {
  const resume = buildFnMapResumable()
  let start = fmSeenFns
  // Retired for the duration: a run that ends early leaves the columns partial, and the next
  // call must re-classify rather than resume from a prefix that never finished.
  fmSeenFns = -1
  if resume {
    let d = 0
    while d < fmDirtySlots.length {
      const ds = fmDirtySlots[d]
      const dn = nodeAt(fnStmts[ds])
      if dn is FuncDecl { buildFnMapRowOfRetAnn(ds, dn.fnRet) }
      d = d + 1
    }
  } else {
    start = 0
    fnIndexBySid = []
    nestedNameBySid = []
    fRetVoid = []
    fRetStructIdx = []
    fRetRArrElem = []
    fRetRListRow = []
    fRetBool = []
    fRetKind = []
    // Round 1 drops the previous program's recorded column; round 2 keeps the one just banked.
    if !emitPhaseReached("monomorphized") { fRecRetTy = [] }
    fRetLitAtom = []
  }
  fmDirtySlots = []
  let i = start
  while i < fnStmts.length {
    const s = nodeAt(fnStmts[i])
    if s is FuncDecl {
      // The build point for `fnIndexBySid` and `nestedNameBySid` — see `collectFns`' global row
      // for the exactness the interning-as-we-build gives.
      const fsid = sidOfNode(fnStmts[i])
      // First occurrence wins: a later lifted function sharing a name does not overwrite the
      // earlier slot.
      if sidArrGet(fnIndexBySid, fsid) < 0 { sidArrPut(fnIndexBySid, fsid, i) }
      // A nested (lifted) function's name — drives `fnIndexOfInScopeSid`'s scan gate.
      if (i < fnParent.length && fnParent[i] >= 0) || lfBlockOf(i) >= 0 {
        sidArrPut(nestedNameBySid, fsid, 1)
      }
      buildFnMapRowOfRetAnn(fRetKind.length, s.fnRet)
    }
    i = i + 1
  }
  // The scope-chain child index is derived from `fnParent`, which `collectFns` has just
  // rebuilt — drop the previous program's copy so the lazy build below cannot read it.
  fnChildHead = []
  fnChildNext = []
  buildFnMapBankPrefix()
  fnStmts.length
}

// Append top-level function node `fn` to `fnStmts` and write its `buildFnMap` row as it lands:
// its name's position, first occurrence winning, and its annotated return columns. A pass after
// monomorphization mints it, past the last `buildFnMap` run, so the row is written here or never.
export function fnStmtsAppendTop(fn: i32) {
  const li = fnStmts.length
  fnStmts.push(fn)
  fnParent.push(-1)
  fnDispNames.push("")
  const fsid = sidOfNode(fn)
  if sidArrGet(fnIndexBySid, fsid) < 0 { sidArrPut(fnIndexBySid, fsid, li) }
  if lfBlockOf(li) >= 0 { sidArrPut(nestedNameBySid, fsid, 1) }
  const s = nodeAt(fn)
  if s is FuncDecl && li == fRetKind.length {
    buildFnMapRowOfRetAnn(li, s.fnRet)
  }
  li
}

// Whether no caller reads the result of the function at position `i`, or of the generic
// declaration it is an instance of: the checker took that declaration as `: void` (D2631).
function fnPosResultUnconsumed(i: i32): boolean {
  if fnResultUnconsumed(fnStmts[i]) { return true }
  let o = i
  if i < fnInstOrigin.length && fnInstOrigin[i] >= 0 { o = fnInstOrigin[i] }
  if o < monoOrigNode.length { return fnResultUnconsumed(monoOrigNode[o]) }
  false
}

// Bank each function's recorded result type in `fRecRetTy`, by `fnStmts` position, for the
// readers after mono.
export function recordRetTys() {
  fRecRetTy = []
  let i = 0
  while i < fnStmts.length {
    fRecRetTy.push(fnRecordedRetTy(i))
    i = i + 1
  }
  0
}

// Mark each un-annotated function void that lowers with no result: its recorded result is `void`,
// it has a bare `return` (D1600), or no caller consumes its result; any other lowers with one.
// After mono each row is first re-read off its declaration, whose rows the shape passes mint past
// mono, and voidness is decided again.
export function recordedVoidFns() {
  const post = emitPhaseReached("monomorphized")
  let i = 0
  while i < fnStmts.length {
    const af = nodeAt(fnStmts[i])
    if post && af is FuncDecl { buildFnMapRowOfRetAnn(i, af.fnRet) }
    if fRetVoid[i] == 0 {
      const fn = nodeAt(fnStmts[i])
      if fn is FuncDecl {
        if fn.fnRet < 0 {
          const r = fnRecordedRetTy(i)
          if (
            r == TY_VOID
            || lambdaVoidAdoptedAt(fnStmts[i])
            || blockHasBareReturn(fn.fnBody)
            || fnPosResultUnconsumed(i)
          ) {
            fRetVoid[i] = 1
          }
        }
      }
    }
    i = i + 1
  }
  0
}

let arrLitMintDone: boolean[] = []
// Mints the rows node `i` needs once, on its first read: a list literal's, an `is` test's empty
// arm list and a `Map()`/`Set()` call's value slot. Returns -1 for a node out of range.
function nodeMintOnRead(i: i32): i32 {
  if i < 0 || i >= P.nodes.length { return -1 }
  while arrLitMintDone.length <= i { arrLitMintDone.push(false) }
  if arrLitMintDone[i] { return 0 }
  arrLitMintDone[i] = true
  const nd = nodeAt(i)
  // Frameless: a literal an instance shares reads its template's types.
  const was = nodeTyInstEnter(-1)
  if nd is ArrayLit { collectAArrayLit(i, nd) }
  else if nd is IsExpr { collectAIsExpr(i, nd) }
  else if nd is Call { collectACallMint(i, nd) }
  else if nd is TypeRef { collectATypeRef(i, nd) }
  nodeTyInstEnter(was)
  0
}

// Mints every list literal and held node under the nodes `roots`, not descending into a nested
// function declaration below a root unless `intoFns`: the rows an emission reads first. A held
// node mints ahead of the literals it holds, whose rows its rep twins.
export function arrLitMintTrees(roots: i32[], intoFns: boolean) {
  const todo: i32[] = []
  for r in roots {
    if r >= 0 && r < P.nodes.length {
      heldRepOf(r)
      if nodeAt(r) is ArrayLit { nodeMintOnRead(r) }
      nodeChildrenPush(r, todo)
    }
  }
  while todo.length > 0 {
    const at = todo.pop()
    if at >= 0 && at < P.nodes.length {
      const nd = nodeAt(at)
      heldRepOf(at)
      if nd is ArrayLit { nodeMintOnRead(at) }
      if intoFns || !(nd is FuncDecl) { nodeChildrenPush(at, todo) }
    }
  }
  0
}

// Mints the rows of each function's signature annotations. The type section reads them first,
// after the indices are dealt, so its reads are asked here, ahead of the deal.
export function fnSigRowsMint() {
  for fx in fnStmts {
    const fn = nodeAt(fx)
    if fn is FuncDecl {
      if fn.fnRet >= 0 { nodeMintOnRead(fn.fnRet) }
      for p in fn.fnParams {
        const pn = nodeAt(p)
        if pn is Param && pn.parType >= 0 { nodeMintOnRead(pn.parType) }
      }
    }
  }
  0
}

// Mints the list each `is K[]` test of a record list may hand its arm, from the checker's record
// of those tests. The signature passes read its row first, a `.map` callback over the arm.
export function isListArmRowsMint() {
  for n in isListArmNodes {
    if n >= 0 && n < P.nodes.length && nodeAt(n) is IsExpr { nodeMintOnRead(n) }
  }
  0
}

// Marks the value boxes of each call through a tagged set the checker recorded: a call whose
// members return different types boxes each member's result into the call's union, which nothing
// else in the program need build. The box types are dealt with the type indices.
export function markTagCallJoins() {
  const was = nodeTyInstEnter(-1)
  for c in fnTagArmCalls() {
    const t = nodeTyIxOf(c)
    if t >= 0 && !tyHasTyVar(t) { markInferredJoinAtoms(t) }
  }
  nodeTyInstEnter(was)
  0
}

// Interns the pair each array-intrinsic call outside every function allocates, from the checker's
// record of those calls: it builds a list with no literal or annotation in sight. A call in a
// function mints in its frame (`collectArrNewFrames`).
export function arrNewTopRowsMint() {
  const was = nodeTyInstEnter(-1)
  for c in arrNewAtTop.keys() {
    if c >= 0 && c < P.nodes.length && !arrNewCallInFn(c) {
      collectArrNewIntr(c, -1)
    }
  }
  nodeTyInstEnter(was)
  0
}

// Marks the value boxes of each if-expression join the checker recorded, a value union the
// program declares nowhere (D1745). The box types are dealt with the type indices, ahead of every
// reader of a join.
export function markInferredIfJoins() {
  let i = 0
  while i < inferIfJoinCount() {
    markInferredJoinAtoms(inferIfJoinTyAt(i))
    i = i + 1
  }
  0
}

// Mints the map value slot of each `Map()`/`Set()` call the checker typed as the ambient
// constructor, and of each instance's copy of one: an un-annotated call has no spelling for an
// annotation's mint, and the signature passes read its slot first, which no reader may take
// after the type indices.
export function mapCtorRowsMint() {
  for c in ambientCtorCalls.keys() { mapCtorRowMint(c) }
  for c in nodeSrc.keys() {
    if ambientCtorCalls.has(nodeSrc[c] ?? -1) { mapCtorRowMint(c) }
  }
  0
}

function mapCtorRowMint(c: i32) {
  if c < 0 || c >= P.nodes.length || !(nodeAt(c) is Call) { return 0 }
  nodeMintOnRead(c)
}

// The row inferred list result `i` is built at: `rec`, its recorded result's row, or -2 when a
// returned literal's elements hold different function sets, which one row cannot build (D15203).
function fnRetRefListRowJoin(i: i32, rec: i32): i32 {
  const fn = nodeAt(fnStmts[i])
  const vals: i32[] = []
  if fn is FuncDecl && tyHasFnDeep(fnRecordedRetTy(i), 0) {
    collectRetValues(fn.fnBody, vals)
  }
  if retListLitSetsSplit(vals) { -2 } else { rec }
}

// Whether a returned list literal in `vals` holds elements whose function sets differ.
function retListLitSetsSplit(vals: i32[]): boolean {
  for v in vals {
    if retListValueSig(v) == "!" { return true }
  }
  false
}

// The function sets returned value `v`'s elements hold, as one fingerprint: for a list literal
// its elements', `!` when two of them differ; else the sets its type holds.
function retListValueSig(v: i32): string {
  const av = unwrapParen(v)
  if av < 0 { return "" }
  const an = nodeAt(av)
  // A literal the check built at the function's result holds the result's sets (D15209), and one
  // built at a tagged rep holds that rep's ids (D15226).
  const rep = nodeRepTyIxOf(av)
  if an is ArrayLit && (rep != nodeTyIxOf(av) || fnTagHoldsTy(rep, 6)) {
    return tyFnSetSig(tyArrayElemIx(rep), 6)
  }
  if an is ArrayLit {
    let sig = ""
    let first = true
    for e in an.arrElems {
      const es = valueFnSig(e, 4)
      if !first && es != sig { return "!" }
      sig = es
      first = false
    }
    return sig
  }
  tyFnSetSig(tyArrayElemIx(nodeRepTyIxOf(av)), 6)
}

// The function sets value `v` holds, read from its type: a record literal's by each field's value,
// a list literal's by each element, anything else by the sets its rep type holds (D15224).
function valueFnSig(v: i32, depth: i32): string {
  const x = unwrapParen(v)
  if x < 0 || depth <= 0 { return "_" }
  const n = nodeAt(x)
  match n {
    ObjLit => {
      let out = "{"
      for fx in n.objFields {
        const f = nodeAt(fx)
        if f is FieldInit {
          out = out + f.fiName + ":" + valueFnSig(f.fiValue, depth - 1) + ","
        }
      }
      return out + "}"
    }
    ArrayLit => {
      let out = "["
      for e in n.arrElems { out = out + valueFnSig(e, depth - 1) + "," }
      return out + "]"
    }
    // Any other value holds the sets its type does.
    Ident | NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {
      return tyFnSetSig(nodeRepTyIxOf(x), 6)
    }
  }
}

// A fingerprint of the function sets type `t` holds at its function positions, through records
// and lists, `depth` levels deep.
function tyFnSetSig(t: i32, depth: i32): string {
  if t < 0 || t >= T.tys.length || depth <= 0 { return "_" }
  const a = tyAt(t)
  match a {
    TyFunc => {
      return "s" + i32ToStr(fnTagSetOfTy(t))
    }
    TyArray => {
      return tyFnSetSig(a.aElem, depth - 1) + "[]"
    }
    TyObj => {
      let out = "{"
      let k = 0
      while k < a.objFieldNames.length && k < a.objFieldTypes.length {
        out = out
          + a.objFieldNames[k]
          + ":"
          + tyFnSetSig(a.objFieldTypes[k], depth - 1)
          + ","
        k = k + 1
      }
      return out + "}"
    }
    // A scalar, map, union or open type holds no set this join compares.
    TyPrim | TyErr | TyUnion | TyNullable | TyMap | TyVar | TyLit | TyNeg => {
      return "_"
    }
  }
}

// Interns the ref-list row of un-annotated function `i`'s recorded list result, nullable or not,
// from its closed element type where none holds it yet, so the recorded result names its row.
function criRecordedRefListDemand(i: i32) {
  if i >= fRecRetTy.length { return 0 }
  const r0 = fRecRetTy[i]
  if r0 < 0 || r0 >= T.tys.length || repSigRetTokOfTy(r0) != "" { return 0 }
  if tyHasInferHole(r0, 0) { criRetBindAnnMint(i) }
  const r = nonNullTy(r0)
  if r < 0 || r >= T.tys.length { return 0 }
  const t = tyAt(r)
  if !(t is TyArray) { return 0 }
  const et = t.aElem
  if (
    et < 0
    || tyHasTyVar(et)
    || tyHasInferHole(et, 0)
    || rlSlotOfRowTy(et) >= 0
  ) {
    return 0
  }
  if repOfTy(r).rdKind != "reflist" { return 0 }
  rlInternOfTy(et)
  0
}

// Mints the annotation of each binding function `i` returns: a result recorded with a hole is
// built at the row the binding's pinned annotation names.
function criRetBindAnnMint(i: i32) {
  const fn = nodeAt(fnStmts[i])
  if !(fn is FuncDecl) { return 0 }
  const vals: i32[] = []
  collectRetValues(fn.fnBody, vals)
  for v in vals {
    const d = fnLetOfRead(fnStmts[i], v)
    const dn = if d >= 0 { nodeAt(d) } else { null }
    if dn is LetDecl && dn.letType >= 0 { nodeMintOnRead(dn.letType) }
  }
  0
}

// Write un-annotated valued function `i`'s return columns from its recorded result where that
// names all five (`fnRecordedRetCols`). True when written.
function criColsFromRecorded(i: i32): boolean {
  if i >= fRetKind.length { return false }
  const fn = nodeAt(fnStmts[i])
  if !(fn is FuncDecl) { return false }
  if fn.fnRet >= 0 || fRetVoid[i] != 0 || fnRecordedRetCols(i) != "" {
    return false
  }
  fRetKind[i] = frcKind
  // A nullable ref list's slot rides the struct column, as an annotated one's does.
  fRetStructIdx[i] = if frcKind == "nulreflist" { frcRow } else { frcSlot }
  fRetRArrElem[i] = frcElem
  fRetBool[i] = frcBool
  fRetRListRow[i] = if frcKind == "reflist" { fnRetRefListRowJoin(i, frcRow) } else { -1 }
  fRetLitAtom[i] = frcAtom
  true
}

// The un-annotated return columns, after monomorphize (in `recordedVoidFns#2`): read off the
// recorded result's rep, its list row minted first; then the record-row check.
export function fnRetColsFromRecorded() {
  let i = 0
  while i < fnStmts.length {
    criRecordedRefListDemand(i)
    criColsFromRecorded(i)
    const fn = nodeAt(fnStmts[i])
    if fn is FuncDecl && fn.fnRet < 0 && fRetVoid[i] == 0 {
      if criRecordRowCheck(i) < 0 { return -1 }
    }
    i = i + 1
  }
  0
}

// Declare the locals a `for v in A to B [step S]` needs, in the pre-order `emitForRangeStmt`
// consumes them: the loop variable, a bound temp, and a step temp when the step is not a
// folded constant. Leaves `v` bound, for the caller to `scopeUnbind`. ONE home — the start
// function's walk and the in-function walk must declare the same slots.
export function declareForRangeLocals(s: ForRange, loopIx: i32) {
  const fvSlot = addLocalSlot("i32", -1)
  markLoopVarSlot(fvSlot)
  markLocalDecl(fvSlot, loopIx)
  scopeBind(s.frVar, fvSlot)
  addLocalSlot("i32", -1)
  if !forRangeStepIsConst(s.frStep) { addLocalSlot("i32", -1) }
  0
}

// Declare the locals a `for v[, w] in <iter>` needs, in the pre-order `emitForInStmt` consumes
// them: the element var `v`, a hidden cursor `v#i`, a hidden `v#l` holding the iterable, and
// the SECOND name last when the source wrote one. Leaves each written name bound, one
// `scopeUnbind` per name for the caller. One home: both scope walks declare the same slots.
export function declareForInLocals(s: ForIn, fnIx: i32) {
  const fiEk = forInElemKind(s.fiIter, fnIx)
  if fiEk == null {
    return emitFailAt("emitProgram: unsupported for-in iterable", s.fiIter)
  }
  // A struct element (`S[]`) binds the loop var as a struct local carrying the element struct
  // table index. The slot comes from `forInVarStructIdx` (D1142), because a captured loop
  // variable's env field needs the identical (kind, slot) pair.
  const fiVarIdx = forInVarStructIdx(s.fiIter, fnIx)
  // The `#l` temp holds the walked value itself: the list, the string, or a map's keys list.
  const fiLk = forInWalkKind(s.fiIter, fnIx)
  if fiLk == null {
    return emitFailAt(
      "emitProgram: a for-in iterable walks no list or string",
      s.fiIter,
    )
  }
  const fiSlot = addLocalSlot(fiEk, fiVarIdx)
  // The slot holds the loop variable's declaration, which a scope-less scan asks the column
  // about (D1748).
  markLocalDecl(fiSlot, s.fiDecl1)
  markLoopVarIter(fiSlot, s.fiIter)
  scopeBind(s.fiVar, fiSlot)
  addLocalSlot("i32", -1)
  let fiLs = -1
  if (
    fiEk == "struct"
    || fiEk == "variant"
    || fiEk == "nulvariant"
    || fiEk == "union"
    || fiEk == "nulstruct"
    || fiEk == "list"
    || fiEk == "nullist"
    || fiEk == "strlist"
    || fiEk == "f64list"
    || fiEk == "i64list"
    || fiEk == "f32list"
    || fiEk == "nulstrlist"
    || fiEk == "nulf64list"
    || fiEk == "nuli64list"
    || fiEk == "nulf32list"
    || fiEk == "u8list"
    || fiEk == "nulu8list"
    || fiEk == "closure"
    || fiEk == "nulclosure"
    || fiEk == "reflist"
    || fiEk == "nulreflist"
    || fiEk == "map"
    || fiEk == "nulmap"
  ) {
    const fiMvs = forInMapValsSlot(s.fiIter, fnIx)
    if fiMvs >= 0 {
      fiLs = mvValRep[fiMvs].mrSlot
    } else {
      fiLs = refListSlotOfExpr(s.fiIter, fnIx)
    }
  }
  addLocalSlot(fiLk, fiLs)
  // The SECOND binding, minted LAST so a one-name loop keeps its three-slot shape byte for
  // byte. An index binds a dense i32 counter of body executions rather than the cursor — a
  // string's cursor is a backing offset and a set's skips tombstones, so the cursor is not
  // the index at two of the three sequences.
  if s.fiVar2 != "" {
    const fiPk = forInPairElemKind(s.fiIter, fnIx)
    if fiPk == null {
      return emitFail("emitProgram: unsupported for-in second binding")
    }
    const fiP2 = addLocalSlot(fiPk, forInPairStructIdx(s.fiIter, fnIx))
    if forInPairIsMapVal(s.fiIter, fnIx) { markPairVarIter(fiP2, s.fiIter) }
    markLocalDecl(fiP2, s.fiDecl2)
    scopeBind(s.fiVar2, fiP2)
  }
  return 0
}

// Collect one `let` statement's local: classify its init into a fresh slot, allocate the
// arm-prelude locals its if-expression initializer declares, then bind the name in the current
// scope. Returns 0, or -1 (via `emitFail`, the open scope popped on the paths that owe it).
function collectLetLocal(stmtIx: i32, s: LetDecl, fnIx: i32) {
  // An if-expression initializer whose arms declare locals is walked first, by node, and
  // those locals are bound while the binding is classified, so an arm's tail naming one
  // reads its slot rather than a type parameter's recorded type (D2785).
  let initArms = 0
  if exprArmLocalsAny { initArms = letInitArmsFirst(s.letInit, stmtIx, fnIx) }
  if initArms < 0 {
    scopePop()
    return -1
  }
  // Classify the init type before binding the name, then allocate a fresh slot and bind
  // `name → slot` so a later reference (or a shadowing inner `let`) resolves to this slot.
  // `slot` is the new slot's declared-local position.
  const slot = letLocalSlot(stmtIx, fnIx)
  if slot == -2 {
    scopePop()
    return -1
  }
  if slot == -3 { return -1 }
  // Pin the declaration to the slot, before the arm preludes below can allocate more. In a
  // monomorphized instance the annotation on this node is the only concrete type its body
  // carries (`localDeclIx`), so a rep question about a read of this local has nowhere else
  // to go.
  markLocalDecl(slot, stmtIx)
  if collectByNode > 0 { declSlotByNode[stmtIx] = slot }
  // An if-expression initializer's arm preludes declare locals of their own. They are
  // allocated after this binding's own slot and before its name is bound, because that is
  // the order `emitLetDeclStmt` walks: `emitLetCursor`, then the init, then `scopeBind`.
  if initArms == 1 {
    scopePop()
  } else if initArms == 2 {
    // allocated ahead of the binding, with no frame to close
  } else if collectIfExprLocals(s.letInit, fnIx) < 0 {
    scopePop()
    return -1
  }
  scopeBind(s.letName, slot)
  0
}

// The declared-local slot a `let` statement's binding takes: its cell kind (`letCellKind`, the
// module global's producer too) at that kind's table slot. Returns the slot, -2 when an `i32`
// cell rejects the binding, or -3 when an inline-shape annotation fails (via `emitFail`).
function letLocalSlot(stmtIx: i32, fnIx: i32) {
  const k = letCellKind(stmtIx, fnIx)
  if !letBindRepClaims(stmtIx, fnIx) {
    // An un-internable inline-shape annotation would resolve to a same-field-named struct.
    if (k == "struct" || k == "variant") && letAnnIsUninternedShape(stmtIx) {
      emitFail(
        "emitProgram: binding's inline-shape type has an unsupported field",
      )
      return -3
    }
    if k == "i32" && checkLocalI32(stmtIx) < 0 { return -2 }
  }
  addLocalSlot(k, letCellSlot(stmtIx, fnIx, k))
}

// Recursively collect the declared locals of the block at `blockIx` into the local columns,
// descending into `if` branches, since a wasm local spans the whole function. Each declared
// local's init type is validated here, so a non-i32 local fails loudly before any bytes are
// emitted. Returns 0, or -1 via `emitFail` on a non-block node or an out-of-scope statement.
export function collectLocals(blockIx: i32, fnIx: i32) {
  const b = nodeAt(blockIx)
  if b is Block {
    // Enter this block's lexical scope: bindings appended below are live — and resolve a
    // same-named init expression to the right slot — only within it, and are dropped on exit.
    scopePush()
    const stmts = b.blkStmts
    // Post-guard complement narrowing, pushed at the foot of the loop below and rewound here on
    // exit — the same save and restore `emitStmts` carries. Without it a binding below a
    // divergent guard classifies its init un-narrowed, so the slot falls to the i32 default
    // while `wasmEmit`, which does push it, stores the narrowed variant's field into that cell.
    let i = 0
    while i < stmts.length {
      const s = nodeAt(stmts[i])
      if s is LetDecl {
        if collectLetLocal(stmts[i], s, fnIx) < 0 { return -1 }
      } else if s is IfStmt {
        if collectLocalsIf(stmts[i], fnIx) < 0 {
          scopePop()
          return -1
        }
      } else if s is WhileStmt {
        // Wasm locals are function-scoped, so collect locals from the while body too.
        if (
          collectExprArms(s.whileCond, fnIx) < 0
          || collectLocalsWhile(stmts[i], fnIx) < 0
        ) {
          scopePop()
          return -1
        }
      } else if s is ForRange {
        if (
          collectExprArms(s.frFrom, fnIx) < 0
          || collectExprArms(s.frTo, fnIx) < 0
          || collectExprArms(s.frStep, fnIx) < 0
        ) {
          scopePop()
          return -1
        }
        markByNodeDecl(stmts[i], localByNode.length)
        declareForRangeLocals(s, stmts[i])
        if collectLocals(s.frBody, fnIx) < 0 {
          scopePop()
          return -1
        }
        // The loop variable's scope is the loop (see `scopeUnbind`).
        scopeUnbind()
      } else if s is ForIn {
        if collectExprArms(s.fiIter, fnIx) < 0 {
          scopePop()
          return -1
        }
        markByNodeDecl(stmts[i], localByNode.length)
        if declareForInLocals(s, fnIx) < 0 {
          scopePop()
          return -1
        }
        if collectLocals(s.fiBody, fnIx) < 0 {
          scopePop()
          return -1
        }
        // The loop variables' scope is the loop (see `scopeUnbind`) — one release per name
        // the source wrote, matching `declareForInLocals`' binds.
        if s.fiVar2 != "" { scopeUnbind() }
        scopeUnbind()
      } else if s is RetStmt {
        // `return if c { … } else { … }` — the returned if-expression's arm preludes are the
        // only locals a `return` can introduce, and `emitStmt`'s return path emits them in this
        // same order, with nothing preceding the value.
        if collectIfExprLocals(s.retArg, fnIx) < 0 {
          scopePop()
          return -1
        }
      } else if exprArmLocalsAny && collectExprArms(stmts[i], fnIx) < 0 {
        scopePop()
        return -1
      }
      // Post-guard complement narrowing, mirroring `emitStmts`: a guard `if` with no else whose
      // then-branch always returns narrows the rest of this block, so the bindings below it are
      // classified under the same narrowing the emit applies. The save above restores the depth
      // at block exit.
      i = i + 1
    }
    scopePop()
    return 0
  }
  emitFail("emitProgram: function has no block body")
}

// Allocate the arm-prelude locals of an if-expression standing as a statement's whole value
// expression — a binding initializer or a `return` operand, which is also where a `match` in
// value position lands — off the emitter's cursor. An if-expression nested deeper inside the
// expression is allocated by node instead (`collectExprArms`).
function collectIfExprLocals(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  const bare = unwrapParen(exprIx)
  if bare < 0 { return 0 }
  const n = nodeAt(bare)
  if n is IfStmt { return collectLocalsIf(bare, fnIx) }
  if !exprArmLocalsAny { return 0 }
  collectExprArms(exprIx, fnIx)
}

// Push a frame binding each arm's top-level locals of a binding's bare if-expression
// initializer, ahead of the binding's own classification: 1 when it did (the caller pops it),
// 0 when it declares nothing, -1 on failure, 2 when the statement frame `stmtArmScopeOpen`
// opens for an `if` nested in the initializer declines (D5333).
function letInitArmsFirst(initIx: i32, stmtIx: i32, fnIx: i32): i32 {
  if !exprArmLocalsAny || initIx < 0 { return 0 }
  const bare = unwrapParen(initIx)
  if bare < 0 { return 0 }
  if !(nodeAt(bare) is IfStmt) {
    const ifs: i32[] = []
    preludeIfsIn(initIx, ifs)
    if ifs.length == 0 { return 0 }
    if collectExprArms(initIx, fnIx) < 0 { return -1 }
    if armScopeOpenOver(initIx, stmtIx) { return 1 }
    return 2
  }
  if firstLocalDeclIn(bare) < 0 { return 0 }
  collectByNode = collectByNode + 1
  const rc = collectLocalsIf(bare, fnIx)
  collectByNode = collectByNode - 1
  if rc < 0 { return -1 }
  scopePush()
  armPreludeBindChain(bare)
  1
}

// Allocate the locals of every if-expression nested in the expression at `ix` that declares
// one, by node (`declSlotByNode`): the emitter reaches such an arm wherever its position lowers
// it, in an order this pass does not replay (D2785). Stops at a nested function, whose body
// owns its own frame, and at a statement block, which `collectLocals` walks itself.
export function collectExprArms(ix: i32, fnIx: i32): i32 {
  if !exprArmLocalsAny { return 0 }
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is FuncDecl || n is Block { return 0 }
  if n is IfStmt {
    if firstLocalDeclIn(ix) < 0 { return 0 }
    collectByNode = collectByNode + 1
    const rc = collectLocalsIf(ix, fnIx)
    collectByNode = collectByNode - 1
    return rc
  }
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    if collectExprArms(kids[k], fnIx) < 0 { return -1 }
    k = k + 1
  }
  0
}

// Bind the prelude locals of every arm along the chain at `ifIx`, deepest else first.
export function armPreludeBindChain(ifIx: i32) {
  const links: i32[] = []
  let cur = ifIx
  while cur >= 0 {
    const s = nodeAt(cur)
    cur = -1
    if s is IfStmt {
      links.push(s.ifThen)
      if s.ifElse >= 0 {
        if nodeAt(s.ifElse) is IfStmt {
          cur = s.ifElse
        } else {
          links.push(s.ifElse)
        }
      }
    }
  }
  let k = links.length - 1
  while k >= 0 {
    armPreludeBind(links[k])
    k = k - 1
  }
  0
}

// Bind each top-level `let` of the arm block's prelude to the slot the collect pass gave it.
function armPreludeBind(blockIx: i32) {
  const b = nodeAt(blockIx)
  if b is Block {
    let i = 0
    while i + 1 < b.blkStmts.length {
      const d = nodeAt(b.blkStmts[i])
      if d is LetDecl {
        const slot = declSlotOfNode(b.blkStmts[i])
        if slot >= 0 { scopeBind(d.letName, slot) }
      }
      i = i + 1
    }
    // An arm whose value is another `if` yields that `if`'s arms, whose locals bind after these.
    const k = b.blkStmts.length
    if k > 0 {
      const tail = unwrapParen(b.blkStmts[k - 1])
      if tail >= 0 && nodeAt(tail) is IfStmt { armPreludeBindChain(tail) }
    }
  }
  0
}

// Opens one frame binding the arm-prelude locals of every value `if` in the statement at
// `stmtIx` (an expression, `return`, `let` initializer, or `if`/`while` condition), so a
// classifier asked outside the arm reads an arm tail at its locals (D5333). Returns the
// frame's local count, or -1 with no frame pushed; `stmtArmScopeClose` closes it.
export function stmtArmScopeOpen(stmtIx: i32): i32 {
  const root = stmtArmRoot(stmtIx)
  if root < 0 { return -1 }
  if !armScopeOpenOver(root, stmtIx) { return -1 }
  scopeNames.length - scopeFrames[scopeFrames.length - 1]
}

// The expression of the statement at `stmtIx` that `stmtArmScopeOpen` scopes, or -1 for a
// statement it leaves alone.
export function stmtArmRoot(stmtIx: i32): i32 {
  if !exprArmLocalsAny || stmtIx < 0 || stmtIx >= P.nodes.length { return -1 }
  const s = nodeAt(stmtIx)
  if s is RetStmt { return s.retArg }
  if s is IfStmt { return s.ifCond }
  if s is WhileStmt { return s.whileCond }
  if s is LetDecl { return letArmRoot(s.letInit) }
  if stmtIsScopedExpr(stmtIx) { return stmtIx }
  -1
}

// Whether the expression statement at `stmtIx` is one whose arm preludes a statement frame
// scopes.
function stmtIsScopedExpr(stmtIx: i32): boolean {
  if stmtIx < 0 || stmtIx >= P.nodes.length { return false }
  const s = nodeAt(stmtIx)
  s is Call || s is BinExpr || s is Paren || s is Unary
}

// A `let` initializer as `stmtArmRoot`'s root, or -1 for a bare `if`, which has its own
// frame (`letInitArmsFirst`, `emitIfExpr`).
function letArmRoot(init: i32): i32 {
  if init < 0 { return -1 }
  const b = unwrapParen(init)
  if b < 0 || b >= P.nodes.length { return -1 }
  if nodeAt(b) is IfStmt { return -1 }
  init
}

// `stmtArmScopeOpen` over the expression at `root`, inside node `whole`: declines when two
// preludes share a name, or `whole` reads one outside the arm statements after its declaration.
export function armScopeOpenOver(root: i32, whole: i32): boolean {
  if !exprArmLocalsAny { return false }
  const ifs: i32[] = []
  preludeIfsIn(root, ifs)
  if ifs.length == 0 { return false }
  const names: string[] = []
  const blocks: i32[] = []
  const at: i32[] = []
  let k = 0
  while k < ifs.length {
    chainPreludeDecls(ifs[k], names, blocks, at)
    k = k + 1
  }
  let i = 0
  while i < names.length {
    let j = i + 1
    while j < names.length {
      if names[j] == names[i] { return false }
      j = j + 1
    }
    const b = nodeAt(blocks[i])
    let inArm = 0
    if b is Block {
      let t = at[i] + 1
      while t < b.blkStmts.length {
        inArm = inArm + identReadsOf(b.blkStmts[t], names[i])
        t = t + 1
      }
    }
    if identReadsOf(whole, names[i]) != inArm { return false }
    i = i + 1
  }
  scopePush()
  k = 0
  while k < ifs.length {
    armPreludeBindChain(ifs[k])
    k = k + 1
  }
  true
}

// Closes a frame `stmtArmScopeOpen` opened with `kept` bindings: what the statement bound
// after them — a `let`'s own name — moves to the enclosing frame.
export function stmtArmScopeClose(kept: i32) {
  const mark = scopeFrames[scopeFrames.length - 1] + kept
  const names: string[] = []
  const slots: i32[] = []
  let i = mark
  while i < scopeNames.length {
    names.push(scopeNames[i])
    slots.push(scopeSlots[i])
    i = i + 1
  }
  scopePop()
  i = 0
  while i < names.length {
    scopeBind(names[i], slots[i])
    i = i + 1
  }
  0
}

// Appends each value `if` under `ix` whose chain has an arm prelude, outermost only; a block
// or a nested function bounds the walk.
function preludeIfsIn(ix: i32, out: i32[]) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is FuncDecl || n is Block { return 0 }
  if n is IfStmt {
    if chainHasPrelude(ix) {
      out.push(ix)
      return 0
    }
  }
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    preludeIfsIn(kids[k], out)
    k = k + 1
  }
  0
}

// Appends each prelude `let` along the `if` chain at `ifIx` as `armPreludeBindChain` binds it:
// its name, its arm block and its statement position there.
function chainPreludeDecls(
  ifIx: i32,
  names: string[],
  blocks: i32[],
  at: i32[],
) {
  let cur = ifIx
  while cur >= 0 {
    const s = nodeAt(cur)
    cur = -1
    if s is IfStmt {
      armPreludeDecls(s.ifThen, names, blocks, at)
      if s.ifElse >= 0 {
        if nodeAt(s.ifElse) is IfStmt {
          cur = s.ifElse
        } else {
          armPreludeDecls(s.ifElse, names, blocks, at)
        }
      }
    }
  }
  0
}

// `chainPreludeDecls` for one arm block, then the `if` its tail is.
function armPreludeDecls(
  blockIx: i32,
  names: string[],
  blocks: i32[],
  at: i32[],
) {
  const b = nodeAt(blockIx)
  if b is Block {
    const n = b.blkStmts.length
    let i = 0
    while i + 1 < n {
      const d = nodeAt(b.blkStmts[i])
      if d is LetDecl {
        names.push(d.letName)
        blocks.push(blockIx)
        at.push(i)
      }
      i = i + 1
    }
    if n > 0 {
      const tail = unwrapParen(b.blkStmts[n - 1])
      if tail >= 0 && nodeAt(tail) is IfStmt {
        chainPreludeDecls(tail, names, blocks, at)
      }
    }
  }
  0
}

// How many identifier reads under `ix` are spelled `name`.
function identReadsOf(ix: i32, name: string): i32 {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is Ident {
    if n.identName == name { return 1 }
    return 0
  }
  const kids = nodeChildren(ix)
  let c = 0
  let k = 0
  while k < kids.length {
    c = c + identReadsOf(kids[k], name)
    k = k + 1
  }
  c
}

// The slot the collect pass gave the declaration at `declIx` in the frame being emitted, or -1.
export function declSlotOfNode(declIx: i32): i32 {
  const pinned = declSlotPinned(declIx)
  if pinned >= 0 { return pinned }
  let i = 0
  while i < localDeclIx.length {
    if localDeclIx[i] == declIx { return i }
    i = i + 1
  }
  -1
}

// The slot the collect walk pinned to the declaration at `declIx` by node, or -1 when it took
// its slot off the cursor. A program with no expression-position arm local pins nothing.
export function declSlotPinned(declIx: i32): i32 {
  if !exprArmLocalsAny || declIx < 0 { return -1 }
  declSlotByNode[declIx] ?? -1
}

// Pin the first slot of the loop at `declIx` to its node when the walk is inside an
// expression-position if-expression, so the emitter finds the run by node.
function markByNodeDecl(declIx: i32, pos: i32) {
  if collectByNode > 0 { declSlotByNode[declIx] = pos }
  0
}

// The first node in the subtree at `ix` that binds a local of the function it sits in (a `let`
// or a loop variable), or -1. A nested function's body binds its own, so the walk stops there.
export function firstLocalDeclIn(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = nodeAt(ix)
  if n is LetDecl || n is ForRange || n is ForIn { return ix }
  if n is FuncDecl { return -1 }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      const d = firstLocalDeclIn(kids[k])
      if d >= 0 { return d }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  -1
}

// Whether any if-expression in expression position declares a local (`exprArmLocalsAny`):
// the parser recorded each one (`valueIfNodes`), so this reads that list, not the arena. A
// statement `if` is walked by `collectLocals` itself.
export function scanExprArmLocals() {
  exprArmLocalsAny = false
  let i = 0
  while i < valueIfNodes.length {
    const ix = valueIfNodes[i]
    if ix >= 0 && ix < P.nodes.length && nodeAt(ix) is IfStmt {
      if firstLocalDeclIn(ix) >= 0 {
        exprArmLocalsAny = true
        return 0
      }
    }
    i = i + 1
  }
  0
}

// Record that the arm block at `blockIx` had its prelude locals allocated here, so
// `emitIfArmOpen` may lower them (`armPreludeBlocks`). Only a multi-statement arm carries a
// prelude. Idempotent: a re-walk marks the same node again.
function markArmPrelude(blockIx: i32) {
  if blockIx < 0 { return 0 }
  const b = nodeAt(blockIx)
  if b is Block {
    if b.blkStmts.length > 1 { armPreludeBlocks[blockIx] = true }
  }
  0
}

// Collect a `while` body's locals under the loop's own narrowing, stripped exactly as
// `emitWhile` strips it — the loop twin of `collectLocalsIf`, and one home so the function
// walk and the start-block one cannot drift. Without it a binding is classified at the
// un-narrowed rep while its initializer emits the narrowed one (D1698).
export function collectLocalsWhile(whileIx: i32, fnIx: i32) {
  const s = nodeAt(whileIx)
  if s is WhileStmt {
    const wrc = collectLocals(s.whileBody, fnIx)
    return wrc
  }
  emitFail("emitProgram: collectLocalsWhile: not a while statement")
}

// Collect the declared locals of the `IfStmt` at `ifIx`: its then-branch block, plus its else,
// which is either a `Block` or another `IfStmt`. The `else if` case recurses through this
// function, so every arm of an arbitrarily long chain is walked — mirroring how `emitStmt`
// re-enters each arm, so the slots match the `let`s it stores into. Returns 0, or -1.
export function collectLocalsIf(ifIx: i32, fnIx: i32) {
  if !(nodeAt(ifIx) is IfStmt) {
    return emitFail("emitProgram: collectLocalsIf: not an if statement")
  }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990). Each
  // link's else narrowing holds across the links below it; the outermost one restored is the
  // state the nested restores would have left.
  let rc = 0
  let cur = ifIx
  while cur >= 0 {
    const s = nodeAt(cur)
    cur = -1
    if s is IfStmt {
      if exprArmLocalsAny && collectExprArms(s.ifCond, fnIx) < 0 { return -1 }
      markArmPrelude(s.ifThen)
      if s.ifElse >= 0 { markArmPrelude(s.ifElse) }
      // Narrow `n` to its variant across the then-branch, mirroring `emitStmt`, so a
      // `let x = n.arrField` over a narrowed union-variant array field is classified as an
      // array local here: `exprArray` and `memFieldTypeCode` resolve the variant field type
      // only while narrowing is active. Save and restore, so the else branch is unaffected.
      const trc = collectLocals(s.ifThen, fnIx)
      if trc < 0 {
        rc = -1
      } else if s.ifElse >= 0 {
        // A union narrows to the complement set in the else arm, mirroring `emitStmt`'s else
        // lowering, so a binding of the narrowed variant's field inside `else { … }` is
        // classified under the narrowing the emit applies.
        if nodeAt(s.ifElse) is IfStmt { cur = s.ifElse }
        else if collectLocals(s.ifElse, fnIx) < 0 { rc = -1 }
      }
    }
  }
  rc
}

// Validate the `LetDecl` at `letIx`: its initializer must exist and be an i32 value. A missing
// init, or an init whose annotation names a non-i32 type, fails loudly. Without a per-expression
// type checker the init's value type is approximated, so an init expression outside the i32
// vocabulary fails loudly. Returns 0, or -1 via `emitFail`.
function checkLocalI32(letIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letInit < 0 {
      // An uninitialized `let x: T` is legal for a scalar (i32 or boolean) annotation: the
      // checker guarantees write-before-read and the wasm local's implicit zero-init covers the
      // declaration. A ref-typed or un-annotated uninitialized local still fails, since a
      // non-null ref has no default.
      if d.letType >= 0 {
        const ty = nodeAt(d.letType)
        if ty is TypeRef {
          // The arena where it covers the node, the name where it does not. This is a decline
          // gate — it decides whether an uninitialized local may lean on wasm's implicit
          // zero-init — so the dangerous direction is under-answering, which would reject a
          // valid program.
          const pz = nodeTyPrimName(d.letType)
          if nodeTyIxOf(d.letType) >= 0 {
            if pz == "i32" || pz == "boolean" { return 0 }
          } else if ty.tyName == "i32" || ty.tyName == "boolean" {
            return 0
          }
        }
      }
      return emitFail("emitProgram: local declaration needs an initializer")
    }
    if d.letType >= 0 {
      const ty = nodeAt(d.letType)
      if ty is TypeRef {
        // Canon's banked type, not canon's rendered name: `canonTyIxOf` is the arena type of the
        // softened spelling, banked at the rewrite. Reading it where canon rewrote and `nodeTyIx`
        // where it did not agrees on `const kMix: K | i32` too, a litunion alias mixed with its
        // own base. `boolean` rides in an i32, so a `boolean` local is the same i32 slot.
        let lcTy = nodeTyIxOf(d.letType)
        if canonRewroteNode(d.letType) { lcTy = canonTyIxOf(d.letType) }
        const lcBase = tyScalarBasePrim(lcTy)
        if lcBase != "i32" {
          if lcBase != "boolean" {
            if !nodeTyIsLitUnionAlias(d.letType) {
              return emitFail("emitProgram: only i32 locals are supported")
            }
          }
        }
      } else {
        return emitFail("emitProgram: local type is not a type name")
      }
    }
    return checkExprI32(d.letInit)
  }
  emitFail("emitProgram: not a local declaration")
}

// Reject init expressions that cannot yield an i32: a string literal, or a float `NumLit` whose
// lexeme has a `.`, fails loudly. `BoolLit` and `CharLit` are i32 values and pass, as do i32
// literals, identifiers, parens, unary and binary arithmetic and calls, whose operand shapes the
// per-node emitters re-check. Returns 0, or -1.
function checkExprI32(exprIx: i32) {
  if exprIx < 0 {
    return emitFail("emitProgram: missing local initializer expression")
  }
  const e = nodeAt(exprIx)
  match e {
    StrLit => {
      return emitFail("emitProgram: only i32 locals are supported")
    }
    NumLit => {
      // A float literal carries a "." in its lexeme — out of scope (i32 only).
      let i = 0
      while i < e.numText.length {
        if e.numText[i] == '.' {
          return emitFail("emitProgram: only i32 locals are supported")
        }
        i = i + 1
      }
      return 0
    }
    // Every other initializer is i32 as far as this check sees.
    CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  0
}

// Collect every distinct ref-list slot a `.push`, `.pop` or `.clear` in the block at `blockIx`
// needs a typed scratch frame for into `fnRefPushSlots`. Statement-level pushes go ahead of
// every slot found inside an expression, since that order is the frame order; one walk finds
// both, so each `if` arm is narrowed once.
export function collectRefSlots(blockIx: i32, fnIx: i32) {
  refSlotsStmtPush = []
  refSlotsExpr = []
  refSlotsBuffering = true
  collectMemberPopRefSlots(blockIx, fnIx)
  refSlotsBuffering = false
  let i = 0
  while i < refSlotsStmtPush.length {
    recordRefPushSlot(refSlotsStmtPush[i])
    i = i + 1
  }
  i = 0
  while i < refSlotsExpr.length {
    recordRefPushSlot(refSlotsExpr[i])
    i = i + 1
  }
  refSlotsStmtPush = []
  refSlotsExpr = []
  0
}

// The slots `collectRefSlots` holds back until its walk ends, and whether one is running; a
// standalone `collectMemberPopRefSlotsExpr` records straight into `fnRefPushSlots`.
let refSlotsStmtPush: i32[] = []
let refSlotsExpr: i32[] = []
let refSlotsBuffering = false

function refSlotNote(slot: i32) {
  if refSlotsBuffering {
    refSlotsExpr.push(slot)
    return 0
  }
  recordRefPushSlot(slot)
}

// The slots a ref-list `.push` statement at `stmtIx` reserves, held for `collectRefSlots`.
function noteStmtPushSlots(stmtIx: i32, fnIx: i32) {
  if !callIsPushKind(stmtIx, fnIx, "ref") { return 0 }
  const s = nodeAt(stmtIx)
  if s is Call && s.callFn >= 0 {
    const callee = nodeAt(s.callFn)
    if callee is Member {
      refSlotsStmtPush.push(refListSlotOfExpr(callee.memObj, fnIx))
      refSlotsStmtPush.push(fitPushSlotOf(callee.memObj))
    }
  }
  0
}

// The frame of the `K[]` an `is K[]` arm pushes onto in place of its receiver, whose own list
// holds another element (D4962): its row is the receiver's checked type's. -1 when none.
function fitPushSlotOf(recv: i32): i32 {
  const o = nodeAt(unwrapParen(recv))
  if !(o is Ident) || !listIsTestedIdent(unwrapParen(recv)) { return -1 }
  const t = nodeTyIxOf(recv)
  if t < 0 || t >= T.tys.length { return -1 }
  const a = tyAt(t)
  if !(a is TyArray) { return -1 }
  rlSlotOfTy(a.aElem)
}

// Record the ref-list table slot of every Member-receiver ref-list `.pop` in expression `exprIx`
// into `fnRefPushSlots`, so its typed scratch frame is reserved, descending value positions,
// since a `.pop` is a value.
export function collectMemberPopRefSlotsExpr(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  const e = nodeAt(exprIx)
  match e {
    Call => {
      // D1592 — a ref-list `.push` in value position needs the same typed frame as the `.pop`
      // beside it. `fnUsesRefPush` is inert in `fbBeginFunc`, where ref frames come from
      // `fnRefPushSlots`, so teaching only the kind bits reserves nothing here.
      if (
        callIsMemberPopKind(exprIx, fnIx, "ref")
        || callIsPushKind(exprIx, fnIx, "ref")
      ) {
        if e.callFn >= 0 {
          const callee = nodeAt(e.callFn)
          if callee is Member {
            refSlotNote(refListSlotOfExpr(callee.memObj, fnIx))
            refSlotNote(fitPushSlotOf(callee.memObj))
          }
        }
      }
      const args = e.callArgs
      let i = 0
      while i < args.length {
        collectMemberPopRefSlotsExpr(args[i], fnIx)
        i = i + 1
      }
      return 0
    }
    BinExpr => {
      collectMemberPopRefSlotsExpr(e.binLeft, fnIx)
      collectMemberPopRefSlotsExpr(e.binRight, fnIx)
      return 0
    }
    Member => {
      return collectMemberPopRefSlotsExpr(e.memObj, fnIx)
    }
    OptMember => {
      return collectMemberPopRefSlotsExpr(e.omObj, fnIx)
    }
    Index => {
      collectMemberPopRefSlotsExpr(e.idxArr, fnIx)
      collectMemberPopRefSlotsExpr(e.idxIndex, fnIx)
      return 0
    }
    Unary => {
      return collectMemberPopRefSlotsExpr(e.unArg, fnIx)
    }
    Paren => {
      return collectMemberPopRefSlotsExpr(e.parInner, fnIx)
    }
    // The node set below is the one `exprHasScratch` (emit_query.vl) carries: a ref-list
    // `.pop` in an `is` guard, an `as` operand, an array-literal element, an object-literal field
    // value or an if-expression arm records its slot here. `fnUsesRefPush` is inert in
    // `fbBeginFunc`, so without this the frame is never reserved and the build fails.
    IsExpr => {
      return collectMemberPopRefSlotsExpr(isExprKid(e), fnIx)
    }
    AsExpr => {
      return collectMemberPopRefSlotsExpr(e.asObj, fnIx)
    }
    IfStmt => {
      return collectMemberPopRefSlotsIf(exprIx, fnIx)
    }
    ObjLit => {
      const fs = e.objFields
      let fi = 0
      while fi < fs.length {
        const f = nodeAt(fs[fi])
        if f is FieldInit { collectMemberPopRefSlotsExpr(f.fiValue, fnIx) }
        fi = fi + 1
      }
      return 0
    }
    // A spread's source is an operand like any other (D2334).
    Spread => {
      return collectMemberPopRefSlotsExpr(e.spdArg, fnIx)
    }
    ArrayLit => {
      const es = e.arrElems
      let ei = 0
      while ei < es.length {
        collectMemberPopRefSlotsExpr(es[ei], fnIx)
        ei = ei + 1
      }
      return 0
    }
    // No other node holds a value position a pop can sit in.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | ForRange | ForIn | MatchExpr | ImportDecl | LoopVar => {}
  }
  0
}

// `collectRefSlots`'s walk of the block at `blockIx`: statements, let-inits, returns and loop
// headers, into `if` arms and loop bodies.
function collectMemberPopRefSlots(blockIx: i32, fnIx: i32) {
  const b = nodeAt(blockIx)
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      const s = nodeAt(stmts[i])
      if s is LetDecl {
        collectMemberPopRefSlotsExpr(s.letInit, fnIx)
      } else if s is RetStmt {
        collectMemberPopRefSlotsExpr(s.retArg, fnIx)
      } else if s is IfStmt {
        collectMemberPopRefSlotsIf(stmts[i], fnIx)
      } else if s is WhileStmt {
        collectMemberPopRefSlotsExpr(s.whileCond, fnIx)
        collectMemberPopRefSlots(s.whileBody, fnIx)
      } else if s is ForIn {
        collectMemberPopRefSlotsExpr(s.fiIter, fnIx)
        collectMemberPopRefSlots(s.fiBody, fnIx)
      } else if s is ForRange {
        collectMemberPopRefSlotsExpr(s.frFrom, fnIx)
        collectMemberPopRefSlotsExpr(s.frTo, fnIx)
        collectMemberPopRefSlotsExpr(s.frStep, fnIx)
        collectMemberPopRefSlots(s.frBody, fnIx)
      } else {
        // Bare expression statement — a fall-through, not only the `BinExpr` and `Call` shapes.
        // See `blockHasScratch`.
        noteStmtPushSlots(stmts[i], fnIx)
        collectMemberPopRefSlotsExpr(stmts[i], fnIx)
      }
      i = i + 1
    }
  }
  0
}

// Collect Member-receiver ref-list `.pop` slots from every arm of the `if` chain, condition
// included: `if b.xs.pop() != null { … }` holding the function's only ref-list `.pop` would
// otherwise record no slot and emit against a local the vector never declared. `startScanIf`
// (emit_sections.vl) hand-scans a top-level `if`'s condition for the scalar bits, not for this.
function collectMemberPopRefSlotsIf(ifIx: i32, fnIx: i32) {
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ifIx
  while cur >= 0 {
    const s = nodeAt(cur)
    cur = -1
    if s is IfStmt {
      collectMemberPopRefSlotsExpr(s.ifCond, fnIx)
      // Each arm is walked under its own narrowing, as `emitStmt` lowers it: an arm scanned
      // without its pin classifies a receiver as its whole union, and `.push`, `.pop` and
      // `.clear` find no row at emit time (D1823).
      collectMemberPopRefSlots(s.ifThen, fnIx)
      if s.ifElse >= 0 {
        if nodeAt(s.ifElse) is IfStmt {
          cur = s.ifElse
        } else {
          collectMemberPopRefSlots(s.ifElse, fnIx)
        }
      }
    }
  }
  0
}

// The two compare frames a `==` over two lists stored apart (`xrepEmitPair`) runs
// over, one per operand's rep, reserved whatever core that rep has of its own.
function leqxNoteBin(binIx: i32, fnIx: i32) {
  const e = nodeAt(binIx)
  if !(e is BinExpr) || (e.binOp != "==" && e.binOp != "!=") { return 0 }
  if !xrepEmitPair(e, fnIx) { return 0 }
  leqxNoteSide(e.binLeft, fnIx)
  leqxNoteSide(e.binRight, fnIx)
  0
}

function leqxNoteSide(ix: i32, fnIx: i32) {
  const k = eqgListKindOfExpr(ix, fnIx)
  if k < 0 { return 0 }
  let sl = 0
  if k == LBK_REF { sl = refListSlotOfExpr(ix, fnIx) }
  leqxNoteRep(k, sl, 0)
  0
}

// The frame of rep `(k, sl)` and, for a list of lists, every level below it. The levels below a
// record element (its string and list fields) reserve as a same-rep compare does; a rep with a
// core of its own reserves no generic frame there, so it is forced here.
function leqxNoteRep(k: i32, sl: i32, depth: i32) {
  if depth > 6 || k < 0 { return 0 }
  leqgNoteRep(k, sl, 0)
  if i32PairIndexOf(fnListEqGKinds, fnListEqGSlots, k, sl) < 0 {
    fnListEqGKinds.push(k)
    fnListEqGSlots.push(sl)
  }
  if k == LBK_REF && eqgInnerKind(sl) >= 0 {
    leqxNoteRep(eqgInnerKind(sl), eqgInnerSlot(sl), depth + 1)
  }
  0
}

// Reserve the LEQG frame for compare rep `(kind, slot)` and for every level below it — the
// reservation twin of `emitListEqGCore`'s recursion, along the same home. A nested compare has
// two live loops at once (`f64[][] == f64[][]` runs an outer and an inner), so each level needs
// its own frame. The three older cores reserve through their own flags and stop.
function leqgNoteRep(kind: i32, slot: i32, depth: i32) {
  if depth > 32 { return 0 }
  if kind == LBK_I32_LIST {
    fnUsesListEqI = true
    return 0
  }
  if kind == LBK_STR_LIST {
    fnUsesListEqS = true
    // The per-element string compares stage operands in the string-op frame.
    fnUsesStrOp = true
    return 0
  }
  if kind == LBK_REF && slot >= 0 && slot < rlElemTyIx.length {
    if rlElemKindAt(slot) == RLK_I32_LIST {
      // The `i32[][]` core, which recurses into the i32 one.
      fnUsesListEqI = true
      if !i32ListHas(fnListEqRSlots, slot) { fnListEqRSlots.push(slot) }
      return 0
    }
  }
  if i32PairIndexOf(fnListEqGKinds, fnListEqGSlots, kind, slot) < 0 {
    fnListEqGKinds.push(kind)
    fnListEqGSlots.push(slot)
  }
  match eqgElemClass(kind, slot) {
    // A string leaf rides the shared `__str_eq__` helper, which stages nothing itself — but an
    // operand may still widen an atom into the string-op frame, the same reason `leqNoteBin`'s
    // `k == 5` arm sets it.
    "string" => {
      fnUsesStrOp = true
    }
    "list" => {
      return leqgNoteRep(eqgInnerKind(slot), eqgInnerSlot(slot), depth + 1)
    }
    // A struct element's string and list fields compare inside this loop, each through the
    // frame its own compare uses at top level.
    "struct" => {
      const nk: i32[] = []
      const ns: i32[] = []
      if eqgStructElemNeeds(eqgElemEqRow(slot), 0, nk, ns) {
        fnUsesStrOp = true
      }
      let ni = 0
      while ni < nk.length {
        leqgNoteRep(nk[ni], ns[ni], depth + 1)
        ni = ni + 1
      }
    }
    // A call compares inside the minted function, which reserves its own frames; a union box
    // parks its two operands in the lazily allocated union-`==` stash.
    "none" | "scalar" | "call" | "union" => {}
  }
  0
}

// D1095 — reserve a compare frame for every list arm of a union `==`. A boxed union arm whose
// atom is a list carries the list wrapper in the box's `value` field, so comparing that arm runs
// the ordinary list core over two wrappers. Every arm, not the one the operands pick: the
// lowering emits a compare per shared arm, and under-reserving is invalid wasm.
function leqNoteUnionArms(exprIx: i32, fnIx: i32) {
  const arms: string[] = []
  const rows: i32[] = []
  if !unionArmRowsOfExpr(exprIx, fnIx, arms, rows) { return 0 }
  let ui = 0
  while ui < arms.length {
    const lk = leqCoreKindOfAtomKind(valueAtomKind(arms[ui]))
    if lk >= 0 { leqgNoteRep(lk, 0, 0) }
    // D1096 — a list field of a struct arm needs a frame for the same reason a list arm does:
    // the arm's own compare walks its variant row field by field, so a list-repped field runs
    // the ordinary list core one level in. The scan above only sees the arm atoms.
    leqNoteVariantFields(rows[ui])
    ui = ui + 1
  }
  0
}

// Reserve a compare frame per list field of variant row `vi`, mirroring `leqNoteBin`'s walk over
// a struct row's fields. The map is `eqVariantListKind`, the one home the field emitter
// reads, so a frame reserved here and a core emitted there are one decision.
function leqNoteVariantFields(vi: i32) {
  if vi < 0 { return 0 }
  if vi >= uFieldStart.length { return 0 }
  if vi >= uFieldCount.length { return 0 }
  const start = uFieldStart[vi]
  let j = 0
  while j < uFieldCount[vi] {
    if start + j < sFieldTypes.length {
      let c = fieldRowKind(start + j)
      // A `T[] | null` arm field runs its non-null twin's core under a null guard, so the
      // frame it needs is that twin's — the struct row's walk resolves it the same way (D1180).
      const cn = nulFieldInnerKind(c)
      if cn != null { c = cn }
      // A ref-list field's frame is keyed by its field slot (`variantFieldRefSlot`), exactly as
      // the struct row's code-5 arm keys its own.
      if c == "reflist" {
        const rs = variantFieldRefSlot(vi, j)
        if rs >= 0 { leqgNoteRep(LBK_REF, rs, 0) }
      }
      const lk = eqVariantListKind(c)
      if lk >= 0 { leqgNoteRep(lk, 0, 0) }
    }
    j = j + 1
  }
  0
}

// Reserve a compare frame per list field of struct row `row` and of every struct row its
// nested-struct fields reach, since the inline compare walks those fields too. `seen` holds the
// rows already walked, so a record that nests itself is walked once.
export function leqNoteStructRowFields(row: i32, seen: i32[]) {
  if row < 0 || i32ListHas(seen, row) { return 0 }
  seen.push(row)
  const fc = eqRowFieldCount(row)
  let fj = 0
  while fj < fc {
    // A `T[] | null` field compares through its non-null twin's core under a null guard, so
    // the frame it needs is that twin's (D1180).
    let fjc = eqRowFieldKind(row, fj)
    const fjn = nulFieldInnerKind(fjc)
    if fjn != null { fjc = fjn }
    if fjc == "reflist" {
      const rs = sFieldRefSlot(row, fj)
      if rs >= 0 { leqgNoteRep(LBK_REF, rs, 0) }
    }
    if eqKindIsRecord(fjc) {
      leqNoteStructRowFields(eqRowTgtStructIdx(row, fj), seen)
    }
    // A scalar-backed list field (`string[]`, `f64[]`, `i64[]`, `f32[]`, `u8[]`) too (D1020).
    const eqSk = eqScalarListKind(fjc)
    if eqSk >= 0 { leqgNoteRep(eqSk, 0, 0) }
    fj = fj + 1
  }
  0
}

// Note one BinExpr's list-op kind into the per-function frame flags. `listOpKindOfBin` decides
// `+`; a `==` or `!=` it does not claim falls to the one compare-core home `emitEqNonNullCore`
// reads, so a core reserved here and a core emitted there are the same decision — otherwise the
// emitted core writes locals nobody declared.
function leqNoteBin(binIx: i32, fnIx: i32) {
  const ub = nodeAt(binIx)
  if ub is BinExpr {
    if ub.binOp == "==" || ub.binOp == "!=" {
      leqNoteUnionArms(ub.binLeft, fnIx)
      leqNoteUnionArms(ub.binRight, fnIx)
    }
  }
  // Asked ONCE and threaded: `eqCoreKindOfBin` and `eqgListKindOfBin` both re-derive this same
  // `(binIx, fnIx)` answer, which is four asks per `==` in the pass this function IS.
  const lopK = listOpKindOfBin(binIx, fnIx)
  let k = lopK
  if k == "none" { k = eqCoreKindOfBin(binIx, fnIx, lopK) }
  if k == "i32list" { fnUsesListEqI = true }
  if k == "strlist" {
    fnUsesListEqS = true
    // The per-element string compares stage operands in the string-op frame.
    fnUsesStrOp = true
  }
  // The string-eq helper stages nothing itself, but a nullable-string compare the string-op
  // scan (`exprHasStrOp` → `exprIsStrEq`) does not claim still reaches this core through the
  // banked type, and its operands may widen an atom into the string-op frame.
  if k == "str" { fnUsesStrOp = true }
  if k == "reflist" {
    // The nested element compare recurses into the i32-list frame.
    fnUsesListEqI = true
    const e = nodeAt(binIx)
    if e is BinExpr {
      // Either operand may be the one whose rep resolves a slot — a mixed pairing
      // (`i32[][] | null == i32[][]`) can have the nullable side unresolvable, and
      // `emitEqNonNullCore` falls back the same way, so both must.
      let slot = refListSlotOfExpr(e.binLeft, fnIx)
      if slot < 0 { slot = refListSlotOfExpr(e.binRight, fnIx) }
      if slot >= 0 && !i32ListHas(fnListEqRSlots, slot) {
        fnListEqRSlots.push(slot)
      }
    }
  }
  // A `==` or `!=` over a list rep with no core of its own needs a 4-slot compare frame per
  // level, from the same home `emitBinExprNode`'s dispatch reads. Gated on `k == "glist"`, the
  // core `eqCoreKindOfBin` returns for exactly this rung: a `gk >= 0` forces it, so the gate
  // cannot miss a frame, and every other binary stops paying a second whole classification.
  if k == "glist" {
    const gk = eqgListKindOfBin(binIx, fnIx, lopK)
    if gk >= 0 { leqgNoteRep(gk, listOpSlotOfBin(binIx, fnIx), 0) }
  }
  // Two number lists stored apart compare in one loop over a frame per side (D15055).
  leqxNoteBin(binIx, fnIx)
  // A struct equality whose field is a list needs a compare frame too, and the lookups above
  // note none: they read the binary's own operands, which here are structs, so
  // `eqgListKindOfBin` answers -1 and `emitListEqGCore` refuses (D1017). Walk the row and note
  // a frame per ref-list field.
  const eqRow = binEqStructRow(binIx, fnIx)
  if eqRow >= 0 { leqNoteStructRowFields(eqRow, []) }
  // A `+` over a non-i32 list rep needs its own 4-slot concat frame. The i32 list is excluded
  // because it rides LEQI's `out` slot, which `k == 0` above already reserved; a second frame
  // would move every later frame's base and change the bytes of every concatenating program.
  const ck = catListKindOfBin(binIx, fnIx)
  if ck > 0 {
    const cs = catSlotOfBin(binIx, fnIx)
    if i32PairIndexOf(fnListCatKinds, fnListCatSlots, ck, cs) < 0 {
      fnListCatKinds.push(ck)
      fnListCatSlots.push(cs)
    }
  }
  0
}

// A binary every note function declines: a `+` the checker typed as a primitive, or a compare of
// two scalar operands. Neither can be a list, string, closure, struct or union.
function leqBinIsScalar(e: BinExpr, binIx: i32): boolean {
  if e.binOp == "+" { return nodeTyPrimName(binIx) != "" }
  binOperandsAreScalar(e)
}

// `leqScanExpr` of a long chain's root, inside a session over its region, as an emission is (D2445).
function leqScanExprHeld(exprIx: i32, fnIx: i32) {
  const opened = bcSpineEnter(exprIx, fnIx)
  leqScanExpr(exprIx, fnIx)
  bcSpineLeave(opened)
  0
}

// Recursive expression walk noting every list `==`/`!=`/`+` site (and, riding the
// same walk, every function-identity equality site — `cloEqNoteBin`).
export function leqScanExpr(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  const e = nodeAt(exprIx)
  match e {
    BinExpr => {
      if arithRegionSeen && e.binRegion != 0 && !bcOpen {
        return leqScanExprHeld(exprIx, fnIx)
      }
      // Both note functions claim only `==`, `!=` and `+`, and so does every classifier they
      // ask, so a binary of any other operator reserves nothing. Read the operator once here
      // rather than re-reading it inside each of the six — a new classifier that claims a
      // fourth operator has to widen this gate with it.
      if (
        (e.binOp == "==" || e.binOp == "!=" || e.binOp == "+")
        && !leqBinIsScalar(e, exprIx)
      ) {
        leqNoteBin(exprIx, fnIx)
        cloEqNoteBin(exprIx, fnIx)
      }
      leqScanExpr(e.binLeft, fnIx)
      return leqScanExpr(e.binRight, fnIx)
    }
    Unary => {
      return leqScanExpr(e.unArg, fnIx)
    }
    Paren => {
      return leqScanExpr(e.parInner, fnIx)
    }
    Call => {
      leqScanExpr(e.callFn, fnIx)
      const args = e.callArgs
      let i = 0
      while i < args.length {
        leqScanExpr(args[i], fnIx)
        i = i + 1
      }
      return 0
    }
    Member => {
      return leqScanExpr(e.memObj, fnIx)
    }
    OptMember => {
      return leqScanExpr(e.omObj, fnIx)
    }
    Index => {
      leqScanExpr(e.idxArr, fnIx)
      return leqScanExpr(e.idxIndex, fnIx)
    }
    ArrayLit => {
      const es = e.arrElems
      let i2 = 0
      while i2 < es.length {
        leqScanExpr(es[i2], fnIx)
        i2 = i2 + 1
      }
      return 0
    }
    ObjLit => {
      const fs = e.objFields
      let i3 = 0
      while i3 < fs.length {
        const f = nodeAt(fs[i3])
        if f is FieldInit { leqScanExpr(f.fiValue, fnIx) }
        i3 = i3 + 1
      }
      return 0
    }
    IsExpr => {
      return leqScanExpr(isExprKid(e), fnIx)
    }
    AsExpr => {
      return leqScanExpr(e.asObj, fnIx)
    }
    // A spread's source is lowered in this function's frame like any operand (D2334).
    Spread => {
      return leqScanExpr(e.spdArg, fnIx)
    }
    // An if-expression (`const b = if c { xs == ys } else { false }`) is an `IfStmt` node in a
    // value slot, and `emitExpr` lowers its arms through the ordinary path, so a list `==`, `!=`
    // or `+` in an arm stages operands in `leqIScratchBase` / `leqSScratchBase`. Hand it to the
    // statement walker, which already covers the condition and both arms.
    IfStmt => {
      return leqScanStmt(exprIx, fnIx)
    }
    // No other node holds an operand that can stage a list compare.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | ForRange | ForIn | MatchExpr | ImportDecl | LoopVar => {}
  }
  0
}

// Statement-level walk (descends branch/loop bodies; a bare expression
// statement falls through to the expression walk).
export function leqScanStmt(stmtIx: i32, fnIx: i32) {
  if stmtIx < 0 { return 0 }
  const s = nodeAt(stmtIx)
  match s {
    LetDecl => {
      return leqScanExpr(s.letInit, fnIx)
    }
    RetStmt => {
      return leqScanExpr(s.retArg, fnIx)
    }
    IfStmt => {
      // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
      let cur = stmtIx
      while cur >= 0 {
        const c = nodeAt(cur)
        cur = -1
        if c is IfStmt {
          leqScanExpr(c.ifCond, fnIx)
          leqScanBlock(c.ifThen, fnIx)
          if c.ifElse >= 0 && nodeAt(c.ifElse) is IfStmt {
            cur = c.ifElse
          } else {
            return leqScanBlock(c.ifElse, fnIx)
          }
        }
      }
      return 0
    }
    WhileStmt => {
      leqScanExpr(s.whileCond, fnIx)
      return leqScanBlock(s.whileBody, fnIx)
    }
    ForRange => {
      leqScanExpr(s.frFrom, fnIx)
      leqScanExpr(s.frTo, fnIx)
      leqScanExpr(s.frStep, fnIx)
      return leqScanBlock(s.frBody, fnIx)
    }
    ForIn => {
      leqScanExpr(s.fiIter, fnIx)
      return leqScanBlock(s.fiBody, fnIx)
    }
    Block => {
      return leqScanBlock(stmtIx, fnIx)
    }
    // Every other node is an expression, scanned below.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | Param | TypeRef | FuncDecl | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  leqScanExpr(stmtIx, fnIx)
}

export function leqScanBlock(ix: i32, fnIx: i32) {
  if ix < 0 { return 0 }
  const b = nodeAt(ix)
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      leqScanStmt(stmts[i], fnIx)
      i = i + 1
    }
    return 0
  }
  leqScanStmt(ix, fnIx)
}

// Whether checker type `ty` is a map or a union of maps: an `is`-narrowed arm of the union
// reads as its member at emit time, though not to `exprMap` here.
function tyIsMapOrMapUnion(ty: i32): boolean {
  if tyIsMap(ty) { return true }
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  if !(t is TyUnion) || t.uMembers.length == 0 { return false }
  for m in t.uMembers {
    if !tyIsMap(m) { return false }
  }
  true
}

// Walk the statement or expression tree at `ix`, recording every `.map` and `.filter` call over
// a list receiver into the scratch-frame requirement lists above and setting `fnUsesMapFilter`.
// Walks every statement and expression kind; a nested `FuncDecl` is not descended, since its own
// body's sites are detected when that lifted function is emitted.
export function mfScan(ix: i32, fnIx: i32) {
  if ix < 0 { return 0 }
  const n = nodeAt(ix)
  match n {
    Call => {
      if n.callFn >= 0 {
        const callee = nodeAt(n.callFn)
        if callee is Member {
          if callee.memProp == "map" || callee.memProp == "filter" {
            if n.callArgs.length == 1 {
              const rk = mfRecvKindOf(callee.memObj, fnIx)
              if rk != null {
                fnUsesMapFilter = true
                let slot = -1
                if rk == "reflist" {
                  slot = refListSlotOfExpr(callee.memObj, fnIx)
                }
                mfRecordSrc(rk, slot)
                const resK = mfResultKindOf(ix, fnIx)
                if resK != null { mfRecordDst(resK, mfResultSlotOf(ix, fnIx)) }
              }
            }
          }
          // `xs.slice(start, end?)` builds a new list of the same element type, so it reserves the
          // same source wrapper and destination backing scratch locals a `.filter` does.
          // `emitArrSlice` reads the source through `srcL` and writes the range into a fresh `dstL`.
          if callee.memProp == "slice" {
            if n.callArgs.length == 1 || n.callArgs.length == 2 {
              const rk = mfRecvKindOf(callee.memObj, fnIx)
              if rk != null {
                fnUsesMapFilter = true
                let slot = -1
                if rk == "reflist" {
                  slot = refListSlotOfExpr(callee.memObj, fnIx)
                }
                mfRecordSrc(rk, slot)
                mfRecordDst(rk, slot)
              }
            }
          }
          // `m.keys()` builds a fresh LIVE-key string list — reserve its 6-slot frame.
          if callee.memProp == "keys" {
            if (
              exprMap(callee.memObj, fnIx)
              || tyIsMapOrMapUnion(nodeTyAt(callee.memObj, fnIx))
            ) {
              fnUsesMapKeys = true
            }
          }
          // `m.values()` builds a fresh live-value list. A mono map uses the self-contained
          // `mapValsBase` frame; an mv-slot map uses its per-slot output backing (`fnMvValsOutLocal`)
          // plus the key-list frame for live, i, j and count.
          if callee.memProp == "values" {
            if exprMap(callee.memObj, fnIx) {
              const vsh = mapShapeOfExpr(callee.memObj, fnIx)
              if vsh == -1 {
                fnUsesMapVals = true
              } else if vsh == -4 || vsh == -6 {
                // The i32-keyed map's values are the mono i32 list — the same self-contained
                // `mapValsBase` frame the string-keyed mono map uses.
                fnUsesMapVals = true
              } else if vsh == -5 || vsh == -7 || vsh == -2 {
                // A `Set`'s `.values()` are its keys, so the bound form is built by the key-list
                // path and needs that frame, at either key rep. A Set's shape is neither the mono
                // `-1` nor an mv slot, so the arms either side of this one both miss it.
                fnUsesMapKeys = true
              } else if vsh >= 0 {
                fnUsesMapVals = true
                fnUsesMapKeys = true
              }
            } else if tyIsMapOrMapUnion(nodeTyAt(callee.memObj, fnIx)) {
              // An `is`-narrowed arm of a union of maps, whose shape is not read here.
              fnUsesMapVals = true
              fnUsesMapKeys = true
            }
          }
        }
      }
      mfScan(n.callFn, fnIx)
      const args = n.callArgs
      let i = 0
      while i < args.length {
        mfScan(args[i], fnIx)
        i = i + 1
      }
      return 0
    }
    Block => {
      const stmts = n.blkStmts
      let i = 0
      while i < stmts.length {
        mfScan(stmts[i], fnIx)
        i = i + 1
      }
      return 0
    }
    LetDecl => {
      if n.letInit >= 0 { mfScan(n.letInit, fnIx) }
      return 0
    }
    RetStmt => {
      if n.retArg >= 0 { mfScan(n.retArg, fnIx) }
      return 0
    }
    IfStmt => {
      // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
      let cur = ix
      while cur >= 0 {
        const c = nodeAt(cur)
        cur = -1
        if c is IfStmt {
          mfScan(c.ifCond, fnIx)
          mfScan(c.ifThen, fnIx)
          if c.ifElse >= 0 {
            if nodeAt(c.ifElse) is IfStmt {
              cur = c.ifElse
            } else {
              mfScan(c.ifElse, fnIx)
            }
          }
        }
      }
      return 0
    }
    WhileStmt => {
      mfScan(n.whileCond, fnIx)
      mfScan(n.whileBody, fnIx)
      return 0
    }
    ForRange => {
      mfScan(n.frFrom, fnIx)
      mfScan(n.frTo, fnIx)
      if n.frStep >= 0 { mfScan(n.frStep, fnIx) }
      mfScan(n.frBody, fnIx)
      return 0
    }
    ForIn => {
      mfScan(n.fiIter, fnIx)
      mfScan(n.fiBody, fnIx)
      return 0
    }
    BinExpr => {
      mfScan(n.binLeft, fnIx)
      mfScan(n.binRight, fnIx)
      return 0
    }
    Unary => {
      return mfScan(n.unArg, fnIx)
    }
    Paren => {
      return mfScan(n.parInner, fnIx)
    }
    Member => {
      return mfScan(n.memObj, fnIx)
    }
    // The `?.` receiver, walked like the `.` one above (D1667).
    OptMember => {
      return mfScan(n.omObj, fnIx)
    }
    Index => {
      mfScan(n.idxArr, fnIx)
      mfScan(n.idxIndex, fnIx)
      return 0
    }
    ObjLit => {
      const fields = n.objFields
      let i = 0
      while i < fields.length {
        const f = nodeAt(fields[i])
        if f is FieldInit { mfScan(f.fiValue, fnIx) }
        i = i + 1
      }
      return 0
    }
    ArrayLit => {
      const elems = n.arrElems
      let i = 0
      while i < elems.length {
        mfScan(elems[i], fnIx)
        i = i + 1
      }
      return 0
    }
    Spread => {
      return mfScan(n.spdArg, fnIx)
    }
    // No other node holds a list builder.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | ErrExpr | Param | TypeRef | FuncDecl | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | IsExpr | AsExpr | MatchExpr | ImportDecl | LoopVar => {}
  }
  0
}

// Whether some interned ref-list row has element kind `k`.
function rlHasKind(k: i32): boolean {
  let i = 0
  while i < rlElemName.length {
    if rlElemKindAt(i) == k { return true }
    i = i + 1
  }
  false
}

// Reset the interning counter (call once per module, before assigning indices).
function mResetTypeIntern() {
  mNextType = 0
  mAllocKind = []
  mAllocSlot = []
  fa32TypeIdx = -1
  fl32TypeIdx = -1
  fa64TypeIdx = -1
  fl64TypeIdx = -1
  ia64TypeIdx = -1
  il64TypeIdx = -1
  lTypeIdx = -1
  mkArrIdx = -1
  mkListIdx = -1
  ba8TypeIdx = -1
  bl8TypeIdx = -1
  mStructIdx = -1
  mStructI32Idx = -1
  mStructI64Idx = -1
  strTrioReset()
  0
}

// The mv slot a map-element ref-list slot's value occupies, the element-heap resolver's twin of
// `rlElemMapValMvSlot`: the slot keyed by the element's value type, else the one the ref-list
// slot's own mint interned (a value whose spelling widened its type, `{r: N}` as `{r:i32}`).
function rlMapElemValSlot(slot: i32): i32 {
  const ar = rlElemMapValMvSlotAt(slot, true)
  if ar >= 0 { return ar }
  if slot < 0 || slot >= rlElemMvSlot.length { return -1 }
  rlElemMvSlot[slot]
}

// The variant struct heap index of ref-list slot `slot`'s element (`Cat[]` gives the `Cat`
// variant's `variantHeap`), or -1. One home, so the dedup signature pass and the element-heap pass
// cannot drift: they are the same question by construction, the sig pass existing to predict the
// heap pass. Read off the element's type: an arm and its same-shape twins share one heap.
function rlElemVariantHeap(slot: i32): i32 {
  const evi = repVariantShapeRowOf(rlElemNonNulTyAt(slot))
  if evi < 0 { return -1 }
  variantHeap(evi)
}

// The record-list views (D3041): one per record row the checker saw delivered as a union-box list
// from an unfresh root, and a view type each, after the wrappers it subtypes and keeps a source of.
// Rows are taken at their twin representative, so twins share a view.
function rvAssignViews() {
  rvUnionSlot = -1
  rvSrcSlot = []
  rvTag = []
  rvNul = []
  rvViewTy = []
  if gHelpRvSync < 0 { return 0 }
  let u = 0
  while u < rlElemTyIx.length && rvUnionSlot < 0 {
    if rlElemKindAt(u) == RLK_UNION && u < rlTwin.length {
      rvUnionSlot = rlTwin[u]
    }
    u = u + 1
  }
  if rvUnionSlot < 0 { return 0 }
  let k = 0
  while k < refViewSrcTys.length {
    const s0 = rlSlotOfTy(refViewSrcTys[k])
    if s0 >= 0 && s0 < rlTwin.length && s0 < rlElemNullable.length {
      const s = rlTwin[s0]
      const tag = rlWidenTagOf(s0, rvUnionSlot)
      if tag >= 0 {
        let p = rvPairOf(s, tag)
        if p < 0 {
          p = rvSrcSlot.length
          rvSrcSlot.push(s)
          rvTag.push(tag)
          rvNul.push(0)
          rvViewTy.push(mAllocType(TSK_RV_VIEW, p))
        }
        // A nullable row twins its non-null one, so the view it shares tests for `null`.
        if rlElemNullable[s0] == 1 { rvNul[p] = 1 }
      }
    }
    k = k + 1
  }
  0
}

// The view row for source row `s` (a twin representative) boxing under tag `tag`, or -1.
export function rvPairOf(s: i32, tag: i32): i32 {
  let p = 0
  while p < rvSrcSlot.length {
    if rvSrcSlot[p] == s && rvTag[p] == tag { return p }
    p = p + 1
  }
  -1
}

// Walk the type-section emit order with the `mAllocType` counter, assigning each type's heap
// index into the module-global index state; returns the functype base index (`typeOffset`).
// `mAllocKind`/`mAllocSlot` record the order for `emitTypeSection`. An absent family mints
// nothing, and its index globals still take the counter position they would have occupied.
export function mAssignTypeIndices(_n: i32) {
  mvKeysAtMint = false
  mResetTypeIntern()
  mAssignStructHeaps()
  mAssignUnionHeaps()
  // An `i32[][]` row keys its twin signature by the i32 wrapper, so it mints here; any other
  // reader mints it on first ask.
  if rlHasKind(RLK_I32_LIST) { lTy() }
  mAssignRefListTwins()
  mAssignRefListPairs()
  mAssignScalarListPairs()
  // The scalar list views (D3028), after every wrapper they subtype or keep a source of.
  let svk = 0
  while svk < 3 {
    if svPairOn(svk) { svViewTy[svk] = mAllocType(TSK_SV_VIEW, svk) }
    svk = svk + 1
  }
  rvAssignViews()
  // Second pass: fill the NON-i32 nested-list ref-list element heaps now that the inner
  // string/f64/i64 list wrappers exist (a `string[]`/`f64[]`/`i64[]`-VALUED map's vals
  // ref-list — kinds 6/7/8). The wrappers are forced by `mvShapeOfValTyMint` (a first ask
  // mints them), so the index is real here.
  let rsfix = 0
  while rsfix < rlElemName.length {
    rlInnerListHeap(rsfix)
    rsfix = rsfix + 1
  }
  mAssignClosureTypes()
  const mvFail = mAssignMapValueStructs()
  if mvFail < 0 { return mvFail }
  // Second pass for the TYPED-value map ref-list elements (kind 3, deferred above): now
  // that `mvMapTypeIdx` is minted, point each such element's heap at its own typed map
  // struct. A mono / atom map element kept its key's map struct in the first pass (slot -1).
  let rmf = 0
  while rmf < rlElemName.length {
    if rlElemKindAt(rmf) == RLK_MAP {
      // `canon` means the value-name leg canonicalizes (`mvCanonValNameTy`) before its lookup: the
      // mv table is keyed canonically, so a raw element-map name would miss the slot and leave
      // the element heap at the shared mono map while the map's own binding uses the box-backed
      // struct. Mirrors `mvShapeOfValTyMint`; the arena leg folds that itself.
      const mmv = rlMapElemValSlot(rmf)
      if mmv >= 0 { rlElemHeap[rmf] = mvMapTypeIdx[mmv] }
    }
    rmf = rmf + 1
  }
  rlLateRowsOn(rlPairsLate)
  rlPairsLate(rlElemName.length)
  mvLateSlotsOn(mvMapsLate)
  mvKeysAtMint = true
  // The functypes follow; the first lands at the current counter (`typeOffset`).
  mNextType
}

// A nested scalar-list element's heap: the inner list's wrapper, minted on this ask.
function rlInnerListHeap(rs: i32) {
  const k = rlElemKindAt(rs)
  if k == RLK_STR_LIST { rlElemHeap[rs] = mkListTy() }
  else if k == RLK_F64_LIST { rlElemHeap[rs] = fl64Ty() }
  else if k == RLK_F32_LIST { rlElemHeap[rs] = fl32Ty() }
  else if k == RLK_I64_LIST { rlElemHeap[rs] = il64Ty() }
  else if k == RLK_U8_LIST { rlElemHeap[rs] = bl8Ty() }
}

// The rows below `n` that the pair assignment did not cover: each takes its twin and pair, and
// the element heap the later passes fill, at once. A closure or typed-map element whose struct
// is not minted fails loudly rather than back onto heap 0.
function rlPairsLate(n: i32): i32 {
  while rlTwin.length < n {
    const rs = rlTwin.length
    rlTwin.push(rlTwinRepOf(rs))
    rlPairMint(rs)
    rlInnerListHeap(rs)
    const k = rlElemKindAt(rs)
    if k == RLK_CLOSURE {
      if fnValUsed {
        rlElemHeap[rs] = cloStructIdx
      } else {
        emitFail("emitProgram: a late closure list row has no closure struct")
      }
    } else if k == RLK_MAP {
      const mmv = rlMapElemValSlot(rs)
      if mmv >= 0 {
        mvMapsLate(mmv + 1)
        // Type 0 is a real index here: a map struct can be the module's first type.
        if mmv < mvTwin.length && mmv < mvMapTypeIdx.length {
          rlElemHeap[rs] = mvMapTypeIdx[mmv]
        } else {
          emitFail("emitProgram: a late map list row has no value map struct")
        }
      }
    }
  }
  0
}

// Mint the standalone struct heap types, in `structEmitOrder`, into `sHeapIdx`; a structural
// twin (`sTwin[i] < i`) shares its representative's index and mints nothing.
function mAssignStructHeaps() {
  // Standalone structs occupy the first indices, one heap type per distinct structure:
  // structural twins share a slot's heap index rather than minting a fresh one, so a `B`-value
  // and an `A`-slot use the same `(ref $S)`. `sTwin[i] < i` marks slot `i` a twin of an earlier
  // one; a twin allocates nothing, so it has no entry in the recorded order.
  buildStructTwins()
  // Assigned in `structEmitOrder`, not in declaration order (D622): wasm requires a declared
  // supertype to hold a lower type index than its subtype, and a supertype here is a shorter
  // field list. The order function holds a row back until every proper prefix has an index and
  // degenerates to declaration order otherwise.
  sHeapIdx = []
  let shi = 0
  while shi < sNames.length {
    sHeapIdx.push(-1)
    shi = shi + 1
  }
  const sOrd = structEmitOrder()
  let soi = 0
  while soi < sOrd.length {
    sHeapIdx[sOrd[soi]] = mAllocType(TSK_STRUCT, sOrd[soi])
    soi = soi + 1
  }
  // Twins take their representative's index; the representative is always in `sOrd`, so it
  // already has one.
  let stw = 0
  while stw < sNames.length {
    if sTwin[stw] < stw { sHeapIdx[stw] = sHeapIdx[sTwin[stw]] }
    stw = stw + 1
  }
  0
}

// Mint the declared unions' variant struct heaps and their rows (`uVarRow`), then the union box and the
// per-rep value boxes the registered value unions use. Mints nothing when no union is declared.
function mAssignUnionHeaps() {
  // Union variant structs (one heap type per distinct variant layout), then the union box.
  // `uVarTwin[vi] < vi` marks variant `vi` a layout twin of an earlier slot — the same `sTwin`
  // discipline — so it reuses that heap index and the type-section emit skips it in lock-step.
  // Covers both one variant name pushed by two unions and a declared name against its shape.
  const heaps: i32[] = []
  uVarTwin = []
  uVarRow = []
  if uDeclared {
    buildVariantTwins()
    let vi = 0
    while vi < uVariants.length {
      if uVarTwin[vi] < vi {
        heaps.push(heaps[uVarTwin[vi]])
      } else if uVarSTwinAt(vi) >= 0 {
        // The cross-table merge: this arm's layout IS a declared struct's, so it takes
        // that row's already-allocated heap index instead of minting a second one. The
        // type section has no entry for it.
        heaps.push(sHeapIdx[uVarSTwinAt(vi)])
      } else {
        heaps.push(mAllocType(TSK_VARIANT, vi))
      }
      // The arm's own struct row, once its heap is known. Every reader asks the row for the heap.
      uVarRow.push(variantRowOrMint(vi, heaps[vi]))
      if variantHeap(vi) != heaps[vi] {
        emitFail("emitProgram: a union arm's row is not on the arm's heap")
      }
      if uVarRow[vi] >= 0 && !variantRowFieldsMatch(vi, uVarRow[vi]) {
        emitFail("emitProgram: a union arm's fields are not its row's")
      }
      if uVarRow[vi] >= 0 { armFieldRowMove(vi, uVarRow[vi]) }
      if !armFieldRowHolds(vi) {
        emitFail("emitProgram: a union arm's fields are not on a struct row")
      }
      vi = vi + 1
    }
    uBoxIdx = mAllocType(TSK_UNION_BOX, 0)
    // The per-rep value boxes (`{ i32 }` / `{ i64 }` / `{ f32 }` / `{ f64 }`), in this fixed
    // rep order — only the reps a registered value union uses.
    if vbI32Used { vbI32Idx = mAllocType(TSK_VALUE_BOX, 0) }
    if vbI64Used { vbI64Idx = mAllocType(TSK_VALUE_BOX, 1) }
    if vbF32Used { vbF32Idx = mAllocType(TSK_VALUE_BOX, 2) }
    if vbF64Used { vbF64Idx = mAllocType(TSK_VALUE_BOX, 3) }
    if vbV128Used { vbV128Idx = mAllocType(TSK_VALUE_BOX, 4) }
  }
  0
}

// Each ref-list slot's twin signature, the column `rlTwinRepOf` matches a slot against.
let rlTwinSig: string[] = []

// Assign every ref-list slot its twin representative into `rlTwin`, from an element-heap
// signature knowable before any pair is minted.
function mAssignRefListTwins() {
  rlTwin = []
  rlTwinSig = []
  let rss = 0
  while rss < rlElemName.length {
    rlTwin.push(rlTwinRepOf(rss))
    rss = rss + 1
  }
  0
}

// The twin representative of slot `rs`: the first earlier slot with its signature, else `rs`.
// Records the signature, so a slot minted after the pairs finds its twin the same way.
function rlTwinRepOf(rs: i32): i32 {
  const sig = rlTwinSigOf(rs)
  rlTwinSig.push(sig)
  let sj = 0
  while sj < rs {
    if rlTwinSig[sj] == sig { return sj }
    sj = sj + 1
  }
  rs
}

// Two slots emit identical (backing, wrapper) pairs exactly when they resolve to the same
// element heap, so the signature names that heap; a map-array element and any unresolved
// element are unique and never merged.
function rlTwinSigOf(rs: i32): string {
  const rsk = rlElemKindAt(rs)
  let sig = "u:" + i32ToStr(rs)
  if rsk == RLK_UNION {
    sig = "h:" + i32ToStr(uBoxIdx)
  } else if rsk == RLK_I32_LIST {
    sig = "h:" + i32ToStr(lTy())
  } else if rsk == RLK_CLOSURE || isScalarBackedListRep(rlElemListRepAt(rs)) {
    sig = "k:" + i32ToStr(rsk)
  } else if rsk == RLK_REF_LIST {
    const inner = rlElemInnerSlot(rs)
    if inner >= 0 { sig = "9:" + i32ToStr(rlTwin[inner]) }
  } else if rsk == RLK_MAP {
    // A map element. A mono map element resolves its key's map struct; a typed-value
    // one resolves its value slot's `mvMapTypeIdx`, whose twin decision is knowable here from
    // the canonical value slot (`mvCanonRepOf`). A nullable map element strips to its inner
    // map first, as both heap passes do; un-stripped it twins onto a mono-map-element slot.
    const mmv = rlMapElemValSlot(rs)
    if mmv < 0 {
      // MONO on BOTH key reps, and they are two DIFFERENT structs — so the mono sig
      // has to name the key or an `{[i32]: i32}` element would twin onto a
      // `{[string]: i32}` one and take its (string-ref keys) struct.
      sig = "3:m"
      const rkk = rlElemMapKeyKind(rs)
      if rkk == MAP_KEY_I32 { sig = "3:mi32" }
      if rkk == MAP_KEY_I64 { sig = "3:mi64" }
    } else {
      sig = "3:" + i32ToStr(mvCanonRepOf(mmv))
    }
  } else {
    // Struct, nullable-struct or variant element — the `else` heap resolution below.
    // `rlElemStructRow` peels the `| null` niche off the arena type it resolves, with the
    // recorded element name as the fall-through, so an inline-shape element spelling keys the
    // same post-twin heap its declared twin does.
    const esi = rlElemStructRow(rs)
    if esi >= 0 {
      sig = "h:" + i32ToStr(sHeapIdx[esi])
    } else {
      // The concrete-variant fall-through — `rlElemVariantHeap`, which is also the heap
      // pass's, and which carries this leg's note about the name peel.
      const evh = rlElemVariantHeap(rs)
      if evh >= 0 { sig = "h:" + i32ToStr(evh) }
    }
  }
  sig
}

// Mint one (backing, wrapper) pair per distinct ref-list slot and fill each slot's element heap
// that is known by now; a mono map element mints its key's map struct. The nested scalar-list,
// closure and typed-map elements are left 0 for the later passes to fill.
function mAssignRefListPairs() {
  let rs = 0
  while rs < rlElemName.length {
    rlPairMint(rs)
    rs = rs + 1
  }
  0
}

// Slot `rs`'s pair (a twin reuses its representative's) and the element heap known before the
// inner scalar wrappers, the closure struct and the typed map structs are minted.
function rlPairMint(rs: i32) {
  if rlTwin[rs] < rs {
    rlBackIdx[rs] = rlBackIdx[rlTwin[rs]]
    rlWrapIdx[rs] = rlWrapIdx[rlTwin[rs]]
  } else {
    rlBackIdx[rs] = mAllocType(TSK_REF_BACK, rs)
    rlWrapIdx[rs] = mAllocType(TSK_REF_WRAP, rs)
  }
  if rlElemKindAt(rs) == RLK_UNION {
    rlElemHeap[rs] = uBoxIdx
  } else if rlElemKindAt(rs) == RLK_MAP {
    // A map-struct element resolves the struct a binding does. A mono map (i32, boolean or atom
    // value) is its key rep's struct; a typed-value map has its own (`mvMapTypeIdx`, minted
    // after this loop) and is deferred to the second pass below.
    if rlMapElemValSlot(rs) < 0 {
      const rk = rlElemMapKeyKind(rs)
      if rk == MAP_KEY_I32 { rlElemHeap[rs] = mapI32Ty() }
      else if rk == MAP_KEY_I64 { rlElemHeap[rs] = mapI64Ty() }
      else { rlElemHeap[rs] = mapTy() }
    } else {
      rlElemHeap[rs] = 0
    }
  } else if rlElemKindAt(rs) == RLK_I32_LIST {
    // An `i32[][]` slot's element is the i32-list WRAPPER, minted above.
    rlElemHeap[rs] = lTy()
  } else if (
    rlElemKindAt(rs) == RLK_STR_LIST
    || rlElemKindAt(rs) == RLK_F64_LIST
    || rlElemKindAt(rs) == RLK_I64_LIST
    || rlElemKindAt(rs) == RLK_F32_LIST
    || rlElemKindAt(rs) == RLK_U8_LIST
  ) {
    // string[][] / f64[][] / i64[][]: the element is the inner list's WRAPPER
    // (`mkListIdx` / `fl64TypeIdx` / `il64TypeIdx`) — but those wrappers are allocated AFTER
    // this loop, so a second pass (below) fills these heaps once they exist.
    rlElemHeap[rs] = 0
  } else if rlElemKindAt(rs) == RLK_REF_LIST {
    // A struct-LIST value (`S[]`): the element is the inner struct-list WRAPPER, the ref-list
    // wrapper of the inner `S` slot (interned at a LOWER index, so its `rlWrapIdx` is set).
    // A slot whose element list left its element open has no inner slot (D9662).
    const ins = rlElemInnerSlot(rs)
    if ins < 0 {
      emitFail(
        "emitProgram: a list-of-lists element has no inner list shape: "
          + rlElemName[rs],
      )
    } else {
      rlElemHeap[rs] = rlWrapIdx[ins]
    }
  } else {
    // A NULLABLE-struct element (`(P | null)[]`, slot key "P | null"): the backing is a
    // `(ref null $P)` over the bare struct — `rlElemStructRow` peels the `| null`
    // (structurally) to resolve P's heap, and its name fall-through bridges an
    // inline-shape spelling to its declared twin.
    const esi = rlElemStructRow(rs)
    if esi >= 0 {
      rlElemHeap[rs] = sHeapIdx[esi]
    } else {
      // A concrete-VARIANT element (`Cat[]`): the element heap is the variant struct
      // `variantHeap(vi)` (no standalone `sNames` entry — variants ride the union's structs).
      const evh = rlElemVariantHeap(rs)
      if evh >= 0 { rlElemHeap[rs] = evh } else { rlElemHeap[rs] = 0 }
    }
  }
  0
}

// Mint the scalar list pairs a view needs ahead of the view; every other pair mints on
// first read.
function mAssignScalarListPairs() {
  // The f64, i64 and f32 pairs mint on first read (`fa64Ty`, `ia64Ty`, `fa32Ty`). A scalar view
  // subtypes its destination's wrapper and keeps its source's, so it mints both first.
  if svDstOn(1) { fa64Ty() }
  if svDstOn(0) { ia64Ty() }
  if svPairOn(2) { fa32Ty() }
  if svPairOn(0) || svPairOn(1) { lTy() }
  0
}

// Mint the closure fat-pointer struct, one `$fnsig` per value-call signature and one env struct
// per capturing lifted function into `fnEnvIdx` (-1 for a non-capturing one), when `fnValUsed`.
function mAssignClosureTypes() {
  // The function-value closure types, interned last among the heap types so no existing index
  // shifts: the closure fat-pointer struct `{ code: (ref $fnsig), env: structref }` first, then
  // the env-leading functype `$fnsig`, mutually recursive in one rec group. Then one env struct
  // per capturing lifted function, capture order being field order. Only when `fnValUsed`.
  fnEnvIdx = []
  if fnValUsed {
    cloStructIdx = mAllocType(TSK_CLOSURE, 0)
    // A CLOSURE-element ref-list slot (kind 5, `((i32) => i32)[]`) backs onto the closure
    // fat-pointer struct. `cloStructIdx` is interned HERE (after the ref-pair loop above),
    // so backfill those slots' element heap type now — the backing array `(array (mut (ref
    // null $cloStructIdx)))` forward-references it within the shared rec group.
    let rcs = 0
    while rcs < rlElemName.length {
      if rlElemKindAt(rcs) == RLK_CLOSURE { rlElemHeap[rcs] = cloStructIdx }
      rcs = rcs + 1
    }
    // One `$fnsig` functype per distinct value-call signature (`cloSigKeys`).
    cloSigBase = mNextType
    let sa = 0
    while sa < cloSigKeys.length {
      mAllocType(TSK_CLO_SIG, sa)
      sa = sa + 1
    }
    // One env struct per capturing lifted function (in `fnStmts` order). A
    // non-capturing function gets `-1` (its closure env is `ref.null structref`).
    let fe = 0
    while fe < fnStmts.length {
      const ncap = captureCountOf(fe)
      if ncap > 0 {
        fnEnvIdx.push(mAllocType(TSK_CLO_ENV, fe))
      } else {
        fnEnvIdx.push(-1)
      }
      fe = fe + 1
    }
    // The function-value cell, only when some function is read as a value outside its frame.
    cloCellIdx = -1
    if cloCellUsed { cloCellIdx = mAllocType(TSK_CLO_CELL, 0) }
  } else {
    cloStructIdx = mNextType
    cloSigBase = mNextType + 1
  }
  0
}

// Mint one ref-valued map struct per distinct value layout into `mvMapTypeIdx`, a layout twin
// sharing its representative's; returns 0, or -1 (via `emitFail`) when two twins disagree.
function mAssignMapValueStructs() {
  // The ref-valued map structs, one 7-field struct per distinct value layout, interned last so
  // no existing index shifts. Slot dedup: the struct's only varying field is the vals-list
  // wrapper, so two slots whose value types are layout twins emit the same bytes and must share
  // one heap index. The vals-wrapper interlock makes a predicate or `rlSig` drift loud.
  mvTwin = []
  mvMapsLate(mvValName.length)
}

// The map structs of the map value slots below `n` that have none: each shares its layout
// twin's, or mints its own. Returns 0, or -1 once two twins resolve different vals wrappers.
function mvMapsLate(n: i32): i32 {
  // A slot whose columns are still being pushed (`mvMapTypeIdx` is the last) waits for them.
  while mvTwin.length < n && mvTwin.length < mvMapTypeIdx.length {
    const mvi = mvTwin.length
    const mvRep = mvCanonRepOf(mvi)
    mvTwin.push(mvRep)
    if mvRep >= 0 && mvRep < mvi {
      const k6 = mvValClassOf(mvi)
      if (
        k6 == MVK_STRUCT
        || k6 == MVK_UNION
        || k6 == MVK_REF
        || k6 == MVK_CLOSURE
      ) {
        if (
          rlWrapIdx[mvValRep[mvi].mrSlot]
          != rlWrapIdx[mvValRep[mvRep].mrSlot]
        ) {
          return emitFail(
            "emitProgram: map-value layout twins resolved different vals wrappers",
          )
        }
      }
      mvMapTypeIdx[mvi] = mvMapTypeIdx[mvRep]
    } else {
      if mvKeysAtMint { mvKeysWrapMint(mvi) }
      mvMapTypeIdx[mvi] = mAllocType(TSK_MV_MAP, mvi)
    }
  }
  0
}

// Whether a map struct minted now is past the type-index assignment, so the keys wrapper its
// field 0 names must mint with it rather than at the type section's write, past the functype base.
let mvKeysAtMint = false

// Mints the keys list wrapper of map value slot `mvi`'s struct (`tsMvMap`'s field 0).
function mvKeysWrapMint(mvi: i32) {
  const kk = mvSlotKeyKind(mvi)
  if kk == MAP_KEY_I32 { lTy() }
  else if kk == MAP_KEY_I64 { il64Ty() }
  else { mkListTy() }
}

// Reserve the backing and wrapper heap types list type `kTy` needs, read off its arena element:
// a scalar element list reserves its backing, and any other list reserves nothing here.
function forceListLeafRepsOfTy(kTy: i32): i32 {
  const k = tyAt(kTy)
  if !(k is TyArray) || k.aElem < 0 || k.aElem >= T.tys.length { return 0 }
  const e = tyAt(k.aElem)
  // A record element's list is a ref-list row of its own (D4962), a declared record's named by
  // its declaration and an anonymous one's by its shape (D4994).
  if e is TyObj {
    let sn = structNameOfTy(k.aElem)
    if sn == "" { sn = internShapeDeepOfTy(k.aElem) }
    if sn == "" { return 0 }
    ensureRefElemTy(sn, k.aElem)
    return 0
  }
  if !(e is TyPrim) { return 0 }
  match e.primName {
    "string" => {}
    "f64" => {
      // The f64 pair mints on first read (`fa64Ty`).
    }
    "i64" => {
      // The i64 pair mints on first read (`ia64Ty`).
    }
    "f32" => {
      // The f32 pair mints on first read (`fa32Ty`).
    }
    "i32" | "boolean" => {}
    "void" | "null" | "never" | "u8" | "v128" => {
      // No backing to reserve for this element.
    }
  }
  0
}

// Whether list element `e` rides the i32-list backing: `i32`, `boolean`, `null`, a literal
// union, or a nullable boolean or literal union.
function tyElemRidesI32List(e: i32): boolean {
  if e < 0 || e >= T.tys.length { return false }
  const k = tyAt(e)
  if k is TyPrim {
    return k.primName == "i32"
      || k.primName == "boolean"
      || k.primName == "null"
  }
  if tyIsLitUnion(e) { return true }
  const ni = tyNulInnerTy(e)
  if ni < 0 { return false }
  const nk = tyAt(ni)
  if nk is TyPrim { return nk.primName == "boolean" }
  tyIsLitUnion(ni)
}

// Whether list element `e` is `string` or `string | null`, the two that share the string list.
function tyElemIsStrListLeaf(e: i32): boolean {
  if e < 0 || e >= T.tys.length { return false }
  const k = tyAt(e)
  if k is TyPrim { return k.primName == "string" }
  tyNulInnerIsPrim(e, "string")
}

// Reserve the backing and wrapper heap types a closure field's result or parameter of arena type
// `t` needs. A type it does not name reserves nothing.
function forceAnnLeafRepsOfTy(t: i32): i32 {
  if t < 0 || t >= T.tys.length { return 0 }
  const k = tyAt(t)
  if k is TyPrim { return 0 }
  if k is TyMap { return 0 }
  if k is TyArray {
    const e = k.aElem
    if tyElemIsStrListLeaf(e) { return 0 }
    if e < 0 || e >= T.tys.length { return 0 }
    const ek = tyAt(e)
    if !(ek is TyPrim) { return 0 }
    match ek.primName {
      "f64" => {
        // The f64 pair mints on first read (`fa64Ty`).
      }
      "i64" => {
        // The i64 pair mints on first read (`ia64Ty`).
      }
      "f32" => {
        // The f32 pair mints on first read (`fa32Ty`).
      }
      "i32" | "boolean" => {}
      "string" | "void" | "null" | "never" | "u8" | "v128" => {
        // A string element is taken above; the rest reserve no backing here.
      }
    }
    return 0
  }
  const ni = tyNulInnerTy(t)
  if ni < 0 { return 0 }
  const nk = tyAt(ni)
  if nk is TyPrim { return 0 }
  if !(nk is TyArray) { return 0 }
  const ne = nk.aElem
  if tyElemRidesI32List(ne) { return 0 }
  if tyElemIsStrListLeaf(ne) { return 0 }
  if ne < 0 || ne >= T.tys.length { return 0 }
  const nek = tyAt(ne)
  if !(nek is TyPrim) { return 0 }
  match nek.primName {
    "f64" => {
      // The f64 pair mints on first read (`fa64Ty`).
    }
    "i64" => {
      // The i64 pair mints on first read (`ia64Ty`).
    }
    "f32" => {
      // The f32 pair mints on first read (`fa32Ty`).
    }
    "u8" => {}
    "string" | "i32" | "boolean" | "void" | "null" | "never" | "v128" => {
      // Taken above, or no backing of its own.
    }
  }
  0
}

// Reserve the reps a closure field's signature needs, at every depth of annotation type `t`.
// `collectATypeRef`'s function-type rung handles a top-level function type; a closure that is a field
// of an inline shape (`{f: () => string}`) reaches no rung. Forces only from the result and
// parameters of such a field, descending through unions, lists, function parts and shapes.
function forceNestedCloSigRepsOfTy(t: i32, depth: i32): i32 {
  if depth > 6 || t < 0 || t >= T.tys.length { return 0 }
  const k = tyAt(t)
  match k {
    TyUnion => {
      let ai = 0
      while ai < k.uMembers.length {
        forceNestedCloSigRepsOfTy(k.uMembers[ai], depth + 1)
        ai = ai + 1
      }
    }
    TyNullable => {
      forceNestedCloSigRepsOfTy(k.nInner, depth + 1)
    }
    TyArray => {
      forceNestedCloSigRepsOfTy(k.aElem, depth + 1)
    }
    TyFunc => {
      // A function type's own parts are not forced here: a top-level return belongs to
      // `collectATypeRef`'s function-type rung.
      forceNestedCloSigRepsOfTy(k.fnRet, depth + 1)
      let ti = 0
      while ti < k.fnParamTypes.length {
        forceNestedCloSigRepsOfTy(k.fnParamTypes[ti], depth + 1)
        ti = ti + 1
      }
    }
    TyObj => {
      // A declared record's fields are reserved through its own declaration.
      if structNameOfTy(t) != "" { return 0 }
      let fi = 0
      while fi < k.objFieldTypes.length {
        const ft = k.objFieldTypes[fi]
        if ft >= 0 && ft < T.tys.length {
          const fk = tyAt(ft)
          if fk is TyFunc {
            forceAnnLeafRepsOfTy(fk.fnRet)
            forceNestedCloSigRepsOfTy(fk.fnRet, depth + 1)
            let pi = 0
            while pi < fk.fnParamTypes.length {
              forceAnnLeafRepsOfTy(fk.fnParamTypes[pi])
              forceNestedCloSigRepsOfTy(fk.fnParamTypes[pi], depth + 1)
              pi = pi + 1
            }
          } else {
            forceNestedCloSigRepsOfTy(ft, depth + 1)
          }
        }
        fi = fi + 1
      }
    }
    TyPrim | TyMap | TyVar | TyLit | TyNeg | TyErr => {}
  }
  0
}

// Gather every FuncDecl type-parameter name — a standalone scan, because a `T[]` annotation node
// precedes its FuncDecl in the arena and a gather-as-you-go walk would see it too early. Its own
// pass, ahead of `collectS`, because the shape interner is a consumer too. It resumes from
// `genTyParamSeen`, since `collectA` asks it again after every minted generic instance.
export function collectTyParamNames() {
  let gtp = genTyParamSeen
  while gtp < P.nodes.length {
    const gnd = nodeAt(gtp)
    if gnd is FuncDecl {
      const gtps = gnd.fnTyParams
      let gj = 0
      while gj < gtps.length {
        genTyParamNames.push(gtps[gj])
        gj = gj + 1
      }
    }
    gtp = gtp + 1
  }
  genTyParamSeen = P.nodes.length
  0
}

// The scalar list pair an array-intrinsic call of element kind `ank` needs. Flags only, each
// set and never cleared, so a second ask can only add. `"reflist"` is absent deliberately: a ref
// fill mints a row, which moves slot numbering, and the arena walk is its one home (D1669).
function collectArrNewScalarPair(ank: ArrNewKind) {
  match ank {
    "f64list" => {
      // The f64 pair mints on first read (`fa64Ty`).
    }
    "i64list" => {
      // The i64 pair mints on first read (`ia64Ty`).
    }
    "u8list" => {}
    "f32list" => {
      // D1470: the f32 pair mints on first read (`fa32Ty`).
    }
    "strlist" => {
      // String fill → the string list (wrapper/backing shared with `string[]`).
    }
    "reflist" => {}
    "list" | "none" => {}
  }
  0
}

const ARR_NEW_REF_NO_FILL_TY_MSG = "a ref-list `__array_new__` recorded no fill type"

// Intern the pair the array-intrinsic call at `callIx` allocates, its element kind read
// frameless. The ref arm is here and not in `collectArrNewScalarPair` because it mints a row.
function collectArrNewIntr(callIx: i32, fnIx: i32) {
  const ank = arrNewIntrKind(callIx, fnIx)
  if ank == "reflist" {
    // Ref fill → the ref list of the element (intern its slot). D966 — the element kind is
    // not always 1: over closures, nested lists, string lists and maps, a nested-list element
    // would get a row repped as the raw backing where the annotated path carries the
    // wrapper. `ensureRefElemTy` derives the kind.
    const anFillTy = arrNewFillTyIx(callIx)
    // A generic template's fill is its type parameter: each instance interns its own row.
    if anFillTy >= 0 && tyHasTyVar(anFillTy) { return 0 }
    // A list whose type keys a row has it already; one that keys none, a record fill, mints
    // the fill type's row, labelled by the fill record's struct row.
    if listRowOfExpr(callIx, fnIx) >= 0 { return 0 }
    if anFillTy < 0 {
      emitFail(ARR_NEW_REF_NO_FILL_TY_MSG)
      return 0
    }
    const fsi = structRowOfRecordTy(anFillTy)
    ensureRefElemTy(
      if fsi >= 0 && fsi < sNames.length { sNames[fsi] } else { "" },
      anFillTy,
    )
    return 0
  }
  collectArrNewScalarPair(ank)
}

// Whether the checker found array-intrinsic call `i` (or the node it copies) inside a function body:
// `collectArrNewFrames` asks it in each frame, and a template's body no frame emits interns nothing.
function arrNewCallInFn(i: i32): boolean {
  if arrNewInFn.has(i) { return true }
  const src = nodeSrc[i] ?? -1
  src >= 0 && arrNewInFn.has(src)
}

// The two element-rep questions that need a frame, asked in each function's own: an array
// intrinsic's fill kind, and whether a list literal's elements are strings. The arena walk has
// no frame, so an instance's PARAMETER names neither (D1669, D1740). A pass, and after
// `monomorphize`, because `fnStmts` holds another program's indices until `collectFns` refills it.
export function collectArrNewFrames() {
  let fe = 0
  while fe < fnStmts.length {
    const fnIx = fnStmts[fe]
    if fnIx >= 0 && fnIx < P.nodes.length {
      const fn = nodeAt(fnIx)
      if fn is FuncDecl { arrNewFrameWalk(fn.fnBody, fnIx) }
    }
    fe = fe + 1
  }
  0
}

// The map struct and value slot a `Map()` builds only in its own frame: one whose template type
// is open, which an instance's pins close. The frameless walk saw the open type (D10041).
function collectFrameMapCtor(ix: i32, fnIx: i32) {
  const t = mapCtorOpenInstTy(ix, fnIx)
  if t < 0 { return 0 }
  const m = tyMapHeld(t)
  mvShapeOfMapHeldTy(m, tyMapValOf(m), tyMapValOf(m))
  0
}

// The list pair or row an un-annotated binding's empty literal `ix` builds only in its own frame:
// one whose template element is open, which a `push` of the instance's pin closes (D3100).
function collectFrameEmptyList(ix: i32, fnIx: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const a = nodeAt(ix)
  if !(a is ArrayLit) || a.arrElems.length > 0 || !tyHasTyVar(nodeTyIxOf(ix)) {
    return 0
  }
  const t = litRepTyAt(ix, fnIx)
  if t < 0 || t >= T.tys.length || tyHasTyVar(t) || !tyIsArray(t) { return 0 }
  forceScalarListRep(tyArrayElemRepName(t))
  if tyIsRefArray(t) { collectFrameRefRow(t) }
  0
}

// The scalar list pair a list literal needs where its first element is a hole instance's local,
// read at the hole's pin: `arrLitIsStr` and its siblings ask the locals table for a local's rep,
// and collection runs before any table is built (D3061). Other pins reserve nothing here.
function collectHoleElemListPair(elemIx: i32, fnIx: i32) {
  const p = tyPrimNameOf(holeOperandTyOf(elemIx, fnIx))
  if p == "string" { collectArrNewScalarPair("strlist") }
  else if p == "f64" { collectArrNewScalarPair("f64list") }
  else if p == "i64" { collectArrNewScalarPair("i64list") }
  else if p == "f32" { collectArrNewScalarPair("f32list") }
  0
}

// The row a list-of-lists literal's element keys only in its own frame (`arrLitFrameLeafRow`),
// keyed by the lead inner literal's type in that frame and minted with its leaf list pair: the
// frameless walk keyed the template's `i32[]` (D3115).
function collectFrameLeafRow(ix: i32, fnIx: i32) {
  const pn = arrLitFrameLeafRow(ix, fnIx)
  if pn == "" || ix < 0 || ix >= P.nodes.length { return 0 }
  const a = nodeAt(ix)
  if !(a is ArrayLit) { return 0 }
  const e = litRepTyAt(arrLitLeadInner(a), fnIx)
  if e < 0 || rlSlotOfTy(e) >= 0 { return 0 }
  if arrLitElemName(ix, fnIx) != "i32[]" { return 0 }
  // The f64 and i64 pairs mint on first read (`fa64Ty`, `ia64Ty`).
  rlInternNameTy(pn, refListElemKindOfTy(e), e)
  0
}

// The row of list type `listTy`, which a list literal is only in its own frame
// (`arrLitFrameRefTy`); -1 is no such literal. The frameless walk sees only the template's
// list (D10891).
function collectFrameRefRow(listTy: i32) {
  if listTy < 0 { return 0 }
  const e = tyArrayElemIx(listTy)
  ensureRefElemTys(rlRowNameOfTy(e, false), e, e)
  0
}

// Every frame-sensitive collection site lexically inside one body, not descending into a
// nested `FuncDecl` — that has its own `fnStmts` row and is walked as its own body.
function arrNewFrameWalk(ix: i32, fnIx: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is FuncDecl { return 0 }
  if n is ArrayLit {
    collectFrameLeafRow(ix, fnIx)
    collectFrameRefRow(arrLitFrameRefTy(ix, fnIx))
  }
  if n is LetDecl && n.letType < 0 {
    collectFrameEmptyList(unwrapParen(n.letInit), fnIx)
  }
  if n is ArrayLit {
    // A list literal over a parameter pinned to the softened `string` builds a string list, and
    // only the frame can see that pin: `collectA` asks this frameless, reserves the i32 pair and
    // leaves `emitArrLit` refusing a rep it can name. Monotone, so a spare pair is inert (D1740).
    if arrLitIsStr(ix, fnIx) {
    } else if n.arrElems.length > 0 && !arrLitIsRef(ix, fnIx) {
      // The frame can also take the string answer away: a local closure's call is not a
      // same-named nested function of another frame, so its scalar pair is reserved (D2386).
      const nk = arrLitNumKind(ix, fnIx)
      if nk == ALK_F64 {
        // The f64 pair mints on first read (`fa64Ty`).
      } else if nk == ALK_I64 {
        // The i64 pair mints on first read (`ia64Ty`).
      } else if arrLitIsF32(ix, fnIx) {
        // The f32 pair mints on first read (`fa32Ty`).
      }
      collectHoleElemListPair(n.arrElems[0], fnIx)
    }
  }
  if n is Call && n.callFn >= 0 {
    const cf = nodeAt(n.callFn)
    if cf is Ident {
      if (
        cf.identName == "__array_new__"
        || cf.identName == "__array_new_default__"
      ) {
        collectArrNewIntr(ix, fnIx)
      }
      if cf.identName == "Map" && n.callArgs.length == 0 {
        collectFrameMapCtor(ix, fnIx)
      }
    }
  }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      arrNewFrameWalk(kids[k], fnIx)
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  0
}

// The scalar list pair a non-string, non-ref array literal at `ix` builds, asked with no frame.
// An f64 or i64 element claims its own backing and wrapper; an f32-element literal (`[fv]` over
// f32-typed values) is the f32 list, asked after them so each literal they claim keeps its
// answer; anything else is the i32 array and list.
function collectArrLitScalar(ix: i32) {
  const nk = arrLitNumKind(ix, -1)
  if nk == ALK_F64 {
    // The f64 pair mints on first read (`fa64Ty`).
  } else if nk == ALK_I64 {
    // The i64 pair mints on first read (`ia64Ty`).
  } else if arrLitIsF32(ix, -1) {
    // The f32 pair mints on first read (`fa32Ty`).
  }
  0
}

// The ref-list and map-value row tables back to empty, once per compile. A row any pass mints
// after it stands until the module is written.
export function rlMvTablesReset() {
  rlRowMintOff()
  rlLateRowsOff()
  mvLateSlotsOff()
  sLateRowsOff()
  arrLitMintOff()
  rlElemName = []
  rlElemKey = []
  rlElemTyIx = []
  // The per-annotation-node row sidecars name rows, so they are cleared with them.
  annRlSlot = []
  arrLitRlSlot = []
  annRlNul = []
  rlElemHeap = []
  rlBackIdx = []
  rlWrapIdx = []
  rlTwin = []
  rlElemNullable = []
  rlElemMapKey = []
  rlElemMvSlot = []
  mvValName = []
  mvKeyKind = []
  mvValTyIx = []
  mvValStructIdx = []
  mvValVariantIdx = []
  mvValArmSig = []
  mvValRep = []
  mvMapTypeIdx = []
  mvTwin = []
  mapTwinDropSlots()
}

// The rows the registered value unions force, a union annotation (`f64[] | boolean`) being none
// of the bare-name forms the walk recognizes. Idempotent: a row `collectU` minted stands.
function collectAUnionRows() {
  let umk = 0
  while umk < unMemberSet.length {
    // A ref-array union arm (`S[] | {w:i32}`) and a map arm (`{[string]: string} | f64`), whose
    // wrapper and per-value map struct the box payload reads.
    markValueUnionAtomsRow(umk)
    markRefArrayArmsRow(umk)
    markMapUnionArmsRow(umk)
    umk = umk + 1
  }
}

// Element type `e` of list literal `i`, or where `e` still holds a hole, the one closed element
// type the elaboration records for every instance of `i`, or for its lead inner list's functions
// (D15779).
function arrLitClosedElemTy(i: i32, e: i32): i32 {
  if e < 0 || !tyHasInferHole(e, 0) { return e }
  let one = -1
  for t in elabNodeInstTys(i) {
    const te = tyStepElem(t)
    if te < 0 || tyHasInferHole(te, 0) || tyHasTyVar(te) { return e }
    if one >= 0 && !tySame(one, te) { return e }
    one = te
  }
  if one >= 0 { return one }
  // A list of lists whose inner function element the elaboration pinned is a list of that.
  const a = nodeAt(i)
  if !(a is ArrayLit) || !(tyAt(e) is TyArray) { return e }
  const f = elabListFnElemTy(arrLitLeadInner(a))
  if f < 0 || tyHasInferHole(f, 0) || tyHasTyVar(f) { return e }
  mkArrayTy(f)
}

// The spelling list literal `i`'s row is stored under: the row name of its key type `ty`, else
// the literal's own element name where the key renders none.
function arrLitStoredElemName(i: i32, ty: i32): string {
  const n = rlRowNameOfTy(ty, false)
  if n != "" { return n }
  arrLitElemName(i, -1)
}

// The list mint's key hint for literal `i`: `arrLitElemHintTy`, else the closed element type the
// literal is built at. A hole or a type parameter keeps the name's key, and so does a literal or
// a record: its own type would split the set its list is joined into (D15770).
function arrLitMintHintTy(i: i32): i32 {
  const h = arrLitElemHintTy(i, -1)
  if h >= 0 { return h }
  let e = tyStepElem(arrLitBuildTy(i))
  // A list of lists is built at its lead inner literal's rep, which carries the element join the
  // outer stamp misses (D4874, D4876); an element that is a union of lists keeps the union.
  const ie = arrLitLeadInnerRepTy(i)
  if ie >= 0 && e >= 0 && tyAt(e) is TyArray { e = ie }
  // A build type still open in the template is the one closed type every instance builds at.
  if e >= 0 && (tyHasInferHole(e, 0) || tyHasTyVar(e)) {
    e = tyStepElem(litRepTyOneClosed(i))
  }
  if (
    e < 0
    || tyHasInferHole(e, 0)
    || tyHasTyVar(e)
    || tyMentionsLitOrObj(e, 0)
  ) {
    return -1
  }
  e
}

// The closed rep of list literal `i`'s lead inner literal, or -1 where `i` holds no inner literal.
function arrLitLeadInnerRepTy(i: i32): i32 {
  if i < 0 || i >= P.nodes.length { return -1 }
  const a = nodeAt(i)
  if (
    !(a is ArrayLit)
    || a.arrElems.length < 1
    || !(nodeAt(a.arrElems[0]) is ArrayLit)
  ) {
    return -1
  }
  const t = litRepTyAt(arrLitLeadInner(a), -1)
  if t < 0 || tyHasInferHole(t, 0) || tyHasTyVar(t) { return -1 }
  t
}

// `collectA`'s arm for the list literal at node `i`: the list flags and ref-list rows its
// element type needs. Never fails.
function collectAArrayLit(i: i32, nd: ArrayLit) {
  // A `[…]` literal is a growable list: struct or union-variant elements make it a ref list,
  // an i32-element or empty literal contributes the i32 list. An empty literal whose element
  // the checker pinned to a registered union is invisible to `arrLitIsRef`, and the
  // synthesized annotation runs after this pass, so that slot has to be interned here.
  if nd.arrElems.length == 0 {
    const emptyElem = arrLitUnionElemName(i, -1)
    if emptyElem != "" {
      // Hinted with the literal's own recorded element row; every corpus firing agrees
      // with the name path, and the hint is available at each.
      rlInternNameTy(emptyElem, RLK_UNION, rlHintElemTy(i))
    }
    // The same hole at the nested-array element kind: `const outer = []` then
    // `outer.push(inner)` with `inner: i32[]` reaches this pass with the element pinned to an
    // array and no row interned. The flags mirror the `arrLitIsRef` branch arm for arm,
    // because this interns the row the annotated `i32[][]` spelling interns.
    const nestElem = arrLitNestedElemName(i, -1)
    if nestElem != "" {
      const nestKind = arrLitNestedElemKind(i, -1)
      // A ref inner list (kind 9 — a struct, map, union or closure leaf, or another nesting
      // level) has to intern its inner row first, because the outer element's heap is that
      // inner wrapper and the tables are read forward in this same pass. `ensureRefElemTy`
      // is the one home of that inner-first walk (D702).
      if nestKind == RLK_REF_LIST {
        ensureRefElemTy(nestElem, arrLitClosedElemTy(i, rlHintElemTy(i)))
      } else {
        // Same hint, same provenance; every corpus firing agrees.
        rlInternNameTyK(
          nestElem,
          nestKind,
          rlHintElemTy(i),
          tyStepElem(arrLitBuildTy(i)),
        )
      }
    }
    // D1511 — the same hole at the shape element kind: `xs.push({y: 1, x: 2})` onto `[]` pins
    // the element to a struct no `<shape>[]` spelling interns. The element type keys and
    // classifies it.
    const shapeElem = arrLitShapeElemName(i, -1)
    if shapeElem != "" {
      ensureRefElemTys(shapeElem, rlKeyTyOf(rlHintElemTy(i)), rlHintElemTy(i))
    }
    // The same hole at a nullable ref element: a push of a `T | null` value, or of a bare
    // `null` a later write filled, spells the `(T | null)[]` row nowhere (D2506).
    const nulElem = arrLitNulRefElemName(i, -1)
    if nulElem != "" { ensureRefElemTy(nulElem, rlHintElemTy(i)) }
    // D1569 — the same hole at a scalar element kind, where the three rescues above are all
    // ref ones. `const xs = []` then `xs.push(1.5)` pins the element to an f64 the program
    // spells nowhere, so no `TypeRef` rung minted the f64 pair. The whole scalar vocabulary
    // comes off the arena in one rung, so a sixth element kind needs no fifth rescue here.
    forceScalarListRep(nodeTyArrayElemRepName(i))
  }
  if arrLitIsRef(i, -1) {
    const elemKind = arrLitElemKind(i, -1)
    // A ref inner list (kind 9) interns inner-first through `ensureRefElemTy`, exactly as the
    // empty-literal arm above and the annotated spelling do: the outer element's heap is the
    // inner wrapper, and this pass reads the tables forward (D702). Additive by construction,
    // since the first-element rung answers 4/6/7/8 for a nested `ArrayLit`.
    if elemKind == RLK_REF_LIST {
      // A list the checker built at another type interns that type's rows, inner first.
      const bt = arrLitBuildTy(i)
      const btn = if bt != nodeTyIxOf(i) { rlRowNameOfTy(tyStepElem(bt), true) } else { "" }
      const mh9 = arrLitMintHintTy(i)
      const ck9 = arrLitClosedElemTy(i, tyStepElem(bt))
      ensureRefElemTys(
        if btn != "" { btn } else { arrLitStoredElemName(i, mh9) },
        if mh9 >= 0 { mh9 } else { rlKeyTyOf(ck9) },
        ck9,
      )
    } else {
      // A record list its rep stamp builds elsewhere has that row alone. Any other record list
      // has its element's own row and struct row, except the cases `arrLitArenaRecElem` names,
      // which are still spelled by name (D14533).
      const ae = if elemKind == RLK_STRUCT { arrLitArenaRecElem(i) } else { -1 }
      // A record spelled by shape is built at its declared twin's row, minted first.
      const tw = if elemKind == RLK_STRUCT { rlDeclTwinTy(arrLitElemHintTy(i, -1)) } else { -1 }
      if tw >= 0 { rlRowOfTyMinted(tw) }
      if ae >= 0 {
        rlInternNameTy(rlRowNameOfTy(ae, false), RLK_STRUCT, ae)
      } else if elemKind != RLK_STRUCT || !arrLitRepElemRow(i) {
        const mh = arrLitMintHintTy(i)
        // A row keyed by a list of lists interns its inner rows by type first, as kind 9 does.
        if mh >= 0 && refListElemKindOfTy(mh) == RLK_REF_LIST {
          recordArrLitRlSlot(
            i,
            ensureRefElemTys(arrLitStoredElemName(i, mh), mh, mh),
          )
        } else {
          recordArrLitRlSlot(
            i,
            rlInternNameTyK(
              arrLitStoredElemName(i, mh),
              elemKind,
              mh,
              tyStepElem(arrLitBuildTy(i)),
            ),
          )
        }
      }
      if elemKind == RLK_STRUCT { arrLitInstElemRows(nd) }
    }
  } else if arrLitIsStr(i, -1) {
    // A STRING-element literal is a string-ref list — the same wrapper/backing
    // a `string[]` annotation forces.
  } else {
    collectArrLitScalar(i)
  }
  // The scalar rescue the EMPTY-literal arm above already performs, for a non-empty one
  // whose element rep is only reachable at an instance's binding of a hole: every arm of the
  // ladder above reads the element with no frame, so `[a]` reserves nothing and the emit
  // floor refuses a rep it can name (D1725). Monotone, so a redundant reservation is inert.
  for lt in elabNodeInstTys(i) { forceScalarListRep(tyArrayElemRepName(lt)) }
}
// The inner type of annotation `annIx`'s nullable list element (`(boolean | null)[]`), or -1.
// A union or record inner is not a niche: it boxes, or rides the record's own row.
function annNicheNulElemInner(annIx: i32): i32 {
  const et = annRefArrElemRow(annIx)
  if et < 0 { return -1 }
  const t = tyAt(et)
  if t is TyNullable {
    if t.nInner < 0 { return -1 }
    const it = tyAt(t.nInner)
    if it is TyUnion || it is TyObj { return -1 }
    return t.nInner
  }
  -1
}

// `collectATypeRef`'s ref-list arm: a `S[]`/`N[]` annotation, or its nullable `S[] | null`,
// forces the wrapper and backing of the non-null ref-array name and banks the interned row on
// node `i`. Returns 0, or -1 once a niche-nullable element with no list rep has failed loudly.
function collectARefArrayAnn(i: i32, _nd: TypeRef): i32 {
  // Whether the annotation is the nullable list, asked of its type.
  const ranIsNul = tyIsNulRefArray(fdRowOf(i))
  // The element kind, classified once before the `ensureRefElemTys` intern, the only call here
  // that mutates a table the classifier reads: the recorded element type's. A nullable list's
  // declined element (a type parameter, a union of lists) is no niche, so its kind is not read.
  const raTy = annRefArrElemRow(i)
  const raKind = refListElemKindOfTy(raTy)
  // A literal-union element is a scalar list, whatever its spelling classifies as.
  if raTy >= 0 && raKind < 0 && repSigKindOfTy(raTy) == "i32" {
    recordAnnRlSlot(i, -1, 0)
    return 0
  }
  // The element row's name, from the annotation's recorded element type; an anonymous record
  // element, which renders no name, is its canonical record row.
  let ren = rlRowNameOfTy(raTy, false)
  if ren == "" {
    const rsr = structRowOfRecordTy(raTy)
    if rsr >= 0 { ren = sNames[rsr] }
  }
  // A kind-2 (union-box) element that is a niche nullable (`(boolean | null)[]`,
  // `(string | null)[]` — one non-null member plus null, deliberately not a value union)
  // has no list rep: the box lowering would emit the element's raw value. Reject cleanly.
  // A value-union element and a struct or heterogeneous element box as usual.
  if raKind == RLK_UNION {
    const nicheTy = annNicheNulElemInner(i)
    if nicheTy >= 0 && !isValueUnionName(ren) {
      return emitFail(
        "emitProgram: a nullable-"
          + tyToStr(nicheTy)
          + " list element has no rep; use a non-null element type",
      )
    }
  }
  // Bank the interned ROW on the annotation NODE (`annRlSlot`): this arm runs on
  // exactly the spellings the annotation-node consumers call a ref array, so the
  // row recorded here is the answer each of them needs — read back through
  // `annRefArrSlot` without re-deriving it from the rendering.
  let ranNul = 0
  if ranIsNul { ranNul = 1 }
  // The ref-list slot is keyed by the annotation's own recorded element row where that row is
  // what the name denotes, else by the element type where it is closed (`rlKeyTyOf`).
  let renTy = -1
  if !elemTyIsNominal(raTy) {
    renTy = annRefArrElemRow(i)
  } else {
    renTy = rlKeyTyOf(raTy)
  }
  // A generic template's `T[]` interns no row: each instance's own annotation interns its own.
  const anTy = nodeTyIxOf(i)
  if anTy >= 0 && tyHasTyVar(anTy) {
    recordAnnRlSlot(i, -1, ranNul)
    return 0
  }
  recordAnnRlSlot(i, ensureRefElemTys(ren, renTy, raTy), ranNul)
  // A map element (`{[K]: V}[]`) forces the map machinery inside `ensureRefElemTys` above, whose
  // `k == 3` arm reaches every map element in every position.
  0
}

// Whether the annotation at node `i` is typed as a record, whose spelling can read as a map's:
// a `"[]"` field is spelled `{[]:…}`.
function typeRefIsRecord(i: i32): boolean {
  const t = nodeTyIxOf(i)
  t >= 0 && t < T.tys.length && tyAt(t) is TyObj
}

// Whether a type is a string list, or a list of one string literal: the D7340 list that reps as
// atoms where its annotation is spelled `string[]`.
function annTyIsStrList(t: i32): boolean {
  repOfTy(t).rdKind == "strlist"
    || (t >= 0 && tyIsArray(t) && tyIsOneStrLit(tyStepElem(t)))
}

// Whether annotation `i` is an array the ref-array and validation rungs must not read: a string
// list (its rows mint on read), a generic alias's array field over its parameter (each
// application interns its own element, D11450), or a `(T | null)[]` over a type parameter, whose
// element has no rep until an instance pins it (D2525).
function annArrayRungsSkip(i: i32): boolean {
  annTyIsStrList(nodeTyIxOf(i))
    || gaeParamFieldNodeIs(i) && annSpelledArray(i)
    || annNulArrOverTyParam(i)
}

// Whether annotation `i` is an array `checkArrTy` must not validate: an `f64`, `i64`, `f32` or
// `u8` list, whose pair mints on first read, or an array over a type parameter, which its
// instances re-collect at pinned names.
function annScalarOrOpenArray(i: i32): boolean {
  const er = nodeTyArrayElemRepName(i)
  er == "f64"
    || er == "i64"
    || er == "f32"
    || er == "u8"
    || annArrOverTyParam(i)
}

// Whether the written annotation at node `i` is a ref list or a nullable one, asked of its
// recorded type. A list of a numeric literal union is stored as its scalar base, not by
// reference; an unwritten parameter node is not an annotation.
function annTyIsRefList(i: i32, nd: TypeRef): boolean {
  const ty = nodeTyIxOf(i)
  if ty < 0 || nd.tyName == "" { return false }
  if !(tyIsRefArray(ty) || tyIsNulRefArray(ty)) { return false }
  const e = tyStepElem(tyPeelNul(ty))
  e < 0 || numLitUnionBaseTy(e) < 0
}

// `collectA`'s arm for the annotation at node `i`: the heap types, list and map rows its
// spelling forces. Returns 0, or -1 once a spelling with no rep has failed loudly.
function collectATypeRef(i: i32, nd: TypeRef) {
  // A closure that is a struct field reserves nothing through the rung below —
  // see `forceNestedCloSigRepsOfTy`, which walks into the annotation's type for it.
  forceNestedCloSigRepsOfTy(nodeTyIxOf(i), 0)
  // A function type forces nothing here: its result's types are forced by
  // `forceNestedCloSigRepsOfTy` above.
  if tyIsFuncArena(nodeTyIxOf(i)) {
  } else if tyIsBareMap(nodeTyIxOf(i)) && !typeRefIsRecord(i) {
    // A bare map annotation interns its per-(key, value) slot here, since collect scans every
    // `TypeRef`, so the type-index assignment sees the full slot set. An orphaned parser field
    // (no type) mints nothing: the field-table passes mint from its owner.
    mvShapeOfMapHeldTy(nodeTyIxOf(i), nodeMapValTyIx(i), nodeMapValTyIx(i))
  } else if tyIsNulMap(nodeTyIxOf(i)) {
    // A nullable map annotation collects what its non-null inner map does.
    mvShapeOfMapHeldTy(nodeTyIxOf(i), -1, nodeMapValTyIx(i))
  } else if !annArrayRungsSkip(i) {
    if annTyIsRefList(i, nd) {
      if collectARefArrayAnn(i, nd) < 0 { return -1 }
    } else if (
      annSpelledArray(i)
      && !isUnionOfTy(nodeTyIxOf(i))
      && !annScalarOrOpenArray(i)
    ) {
      // A union ending in an array arm (`i64 | S[]`) is a box whose arms `markRefArrayArms`
      // interns, so it is not validated here.
      if checkArrTy(nodeTyIxOf(i)) < 0 { return -1 }
    }
  }
  // A map reached only as a closure result inside this annotation — a union arm, the
  // nullable-closure niche, or a curried result — is invisible to every branch above, since
  // the whole spelling is one name. Force its machinery and intern its value slot;
  // self-gating, and outside the chain so it composes with whatever branch claimed the name.
  forceCloResultMapTypes(nodeTyIxOf(i))
  // The list dual: a scalar-leaf or string list reached only as a closure result inside this
  // annotation forces its wrapper and backing, so the narrowed arm's value-call index read
  // finds them even when the program never constructs such a list. Same self-gating
  // placement as the map forcer above.
  forceCloResultListTypes(nodeTyIxOf(i))
  0
}

// The value slot an un-annotated `Map()`/`Set()` call `i` constructs: it has no map spelling for
// `collectA`'s `TypeRef` arm, so the slot comes off the call's own recorded type, or a ref or wide
// value never mints its rep. Idempotent: an annotated twin interns the same slot.
function collectACallMint(i: i32, nd: Call) {
  if nd.callFn < 0 { return 0 }
  const cf = nodeAt(nd.callFn)
  if cf is Ident && (cf.identName == "Map" || cf.identName == "Set") {
    mvShapeOfMapNodeTy(i)
  }
  0
}

// The rows of a record `K` an `is K[]` test `i` narrows to, when the receiver's elements can
// never be `K` or the receiver is still typed by a type parameter: the arm's locals read `K`'s
// struct row, which no reader mints, when no row has it yet. The empty list's own row mints at `listFitElemKind`.
function collectAIsExpr(i: i32, nd: IsExpr) {
  // An `is K[]` over a list whose elements can never be `K` hands its arm an empty `K[]`
  // (D4911), a list no annotation or literal of the program need have built.
  const kTy = isVarTyIxOf(i)
  const rTy = nodeTyIxOf(nd.isObj)
  // A receiver still typed by a type parameter is an instance's, whose binding may be one,
  // for a union or nullable receiver as well (D4912).
  const kEl = if kTy >= 0 && kTy < T.tys.length { tyArrayElemIx(kTy) } else { -1 }
  if (
    kEl < 0
    || kEl >= T.tys.length
    || !(tyAt(kEl) is TyObj)
    || structRowOfRecordTy(kEl) >= 0
  ) {
    return 0
  }
  if kTy >= 0 && kTy < T.tys.length && rTy >= 0 && rTy < T.tys.length {
    if (
      listDisjointDepth(rTy, kTy) == 1
      || (tyAt(kTy) is TyArray && tyHasTyVar(rTy))
    ) {
      forceListLeafRepsOfTy(kTy)
    }
  }
  0
}

// Runs after the post-monomorphization annotation shapes: arms the mint-on-read hooks, then
// mints the rows each registered union's arms are read at. Returns 0.
export function collectUnionAndHeldRows() {
  collectTyParamNames()
  arrLitMintDone = []
  arrLitMintOn(nodeMintOnRead)
  heldRepMintDone = []
  heldRepMintOn(collectAHeldRep)
  rlRowMintOn(rlRowOfTyMinted)
  rlArmRowMintOn(rlRowOfArmTyMinted)
  armStructRowMintOn(armFieldStructRowMinted)
  rlOpenRowMintOn(rlRowOfOpenTyMinted)
  rlListOfRowMintOn(rlListOfRowMinted)
  mvTyMintOn(mvShapeOfValTyMint)
  // The read-only-covariance write memo is keyed by slot number, which a re-mint and a
  // resumed walk's own new rows both move (D791). Ahead of the fork, since both invalidate it.
  rlWrSlots = []
  rlWrAns = []
  collectAUnionRows()
  0
}

// The struct row union-variant field row `ufn` stores, interned from the field's spelling and
// type, and the field re-keyed to the interned row's name. -1 for a field that is no record.
function armFieldStructRowMinted(ufn: i32): i32 {
  if ufn < 0 || ufn >= sFieldTypes.length || !fieldRowIsRecordRef(ufn) {
    return -1
  }
  const si = internInlineShapeTy(sFieldElemName[ufn], uFieldElemTyIxRow(ufn))
  if si >= 0 {
    sFieldElemName[ufn] = sNames[si]
    tyRegNoteWrite()
  }
  si
}

// The ref-list row of open element type `ty`, a template field's, interned on a miss under the
// label `nm`; the open type keys and classifies it. -1 for -1.
function rlRowOfOpenTyMinted(ty: i32, nm: string): i32 {
  if ty < 0 { return -1 }
  const s = rlSlotOfTy(ty)
  if s >= 0 || nm == "" { return s }
  ensureRefElemTys(nm, ty, ty)
  rlSlotOfTy(ty)
}

// The ref-list row whose element is a list at row `r`, interned under that list's spelling and
// type on a miss; -1 for no row `r`.
function rlListOfRowMinted(r: i32): i32 {
  if r < 0 || r >= rlElemName.length { return -1 }
  const s = ensureRefElemTy(rlElemName[r] + "[]", mkArrayTy(rlElemTyIx[r]))
  if s >= 0 && s < rlElemName.length { s } else { -1 }
}

// The ref-list row of closed element type `et`, minted on a miss; a record spelled by shape
// mints its declared twin's row, which it shares. -1 for -1, an open type, or a type that may
// hold a function inside a record or list, whose row its function-value sets decide.
function rlRowOfTyMinted(et: i32): i32 {
  const s = rlSlotOfTy(et)
  if s >= 0 || et < 0 || et >= T.tys.length || tyHasTyVar(et) { return s }
  if tyMayHoldFn(et, 0) && !tyIsFuncOrNulFunc(et) { return -1 }
  const tw = rlDeclTwinTy(et)
  rlInternOfTy(if tw >= 0 { tw } else { et })
  rlSlotOfTy(et)
}

// `rlRowOfTyMinted` for a union arm's element, which mints an element holding a function too:
// the arm's declared type, not a function-value set, decides that row.
function rlRowOfArmTyMinted(et: i32): i32 {
  const s = rlRowOfTyMinted(et)
  if s >= 0 || et < 0 || et >= T.tys.length || tyHasTyVar(et) { return s }
  rlInternOfTy(et)
  rlSlotOfTy(et)
}

let heldRepMintDone: boolean[] = []
// Mints, once, the rows held node `i` is read at: a map of a tagged set's records, or a list of
// flat records, held at a rep its own type does not name. Returns 0.
function collectAHeldRep(i: i32): i32 {
  if i < 0 || i >= P.nodes.length { return 0 }
  while heldRepMintDone.length <= i { heldRepMintDone.push(false) }
  if heldRepMintDone[i] { return 0 }
  heldRepMintDone[i] = true
  // A map binding held as a map of a tagged set's records is read at that rep, so its value row
  // and mv slot are interned here, beside the map's own type's.
  const hr = fnTagHeldRepOf(i)
  // A held list's record element row is minted from the rep's type, ahead of the literals it
  // is built from, so which literal mints first never decides the row its elements share.
  if hr >= 0 && hr < T.tys.length && tyAt(hr) is TyArray {
    internShapeDeepOfTy(hr)
  }
  if hr >= 0 { arrLitMintTrees([i], false) }
  const hv = if hr >= 0 && hr < T.tys.length && tyAt(hr) is TyMap { tyMapValOf(hr) } else { -1 }
  if hv >= 0 && tyAt(hv) is TyObj {
    internShapeDeepOfTy(hv)
    mvShapeOfMapHeldTy(hr, hv, hv)
  }
  // A list held so as a list of flat records is read at that rep too: the element's row and
  // the list's ref-list slot (D15552). A nested element's rows are minted where it is built.
  const he = if hr >= 0 && hr < T.tys.length { tyArrayElemIx(hr) } else { -1 }
  if heldElemIsFlatRecord(he) { forceListLeafRepsOfTy(hr) }
  0
}

// Whether `he` is a record with no field that is a record or a list of records or lists.
function heldElemIsFlatRecord(he: i32): boolean {
  if he < 0 || he >= T.tys.length { return false }
  const t = tyAt(he)
  if !(t is TyObj) { return false }
  for f in t.objFieldTypes {
    const e = if f >= 0 && f < T.tys.length { tyArrayElemIx(f) } else { -1 }
    if f < 0 || f >= T.tys.length || tyAt(f) is TyObj { return false }
    if e >= 0 && e < T.tys.length && (tyAt(e) is TyObj || tyAt(e) is TyArray) {
      return false
    }
  }
  true
}

// Interns the row of a value `if` or `match` that joins records into a wider one (D2731), so
// its literal arms can be built at the join's row wherever the join is delivered.
function internJoinedRecordRow(ix: i32) {
  if !recordJoinSeen() { return 0 }
  const ty = nodeTyIxOf(ix)
  if !initJoinsWiderRecord(ix, ty) { return 0 }
  internArmShapeOfTy(ty, 0)
  internShapeDeepOfTy(ty)
}

export function collectAnnShapes() {
  const joins = recordJoinSeen()
  if monoGradualRetPinned && emitPhaseReached("monomorphized") {
    shareObjLitFieldUnionRows()
  }
  let ti = 0
  while ti < P.nodes.length {
    const tn = nodeAt(ti)
    // Ahead of the TypeRef arm: the annotation it mints is appended, so this loop interns it.
    if joins { internJoinedRecordRow(ti) }
    // An annotation an undone adoption dropped belongs to no declaration.
    if tn is TypeRef && !recAdAnnDropped(ti) {
      // One gate and one switch, each closing a disagreement between the recorded type and what
      // the name resolves to in the emitter's context. The gate: a spelling naming a generic-alias
      // type parameter reads the alias's declared type, whose `K` is still a type variable, since
      // the recorded one bound it to an argument. The switch: `canonRewroteNode(ti)` picks a column.
      let root = -1
      if !nameMentionsGenAliasParam(tn.tyName) {
        if canonRewroteNode(ti) {
          root = canonTyIxOf(ti)
        } else {
          root = nodeTyIxOf(ti)
        }
      } else {
        root = declAnnTyOf(ti)
      }
      // Ahead of the intern, which codes each field: an arm-typed field needs the arm's own
      // row to exist before `armFieldStructRow` is asked for it (D1672).
      internArmFieldShapeTy(root, 0)
      // An annotation the checker typed nothing at, such as a type parameter's bound, is not
      // the type of any value, so it has no shape to intern.
      if root >= 0 { internShapeDeepTy(tn.tyName, root) }
    }
    ti = ti + 1
  }
  if emitPhaseReached("monomorphized") {
    mintPinnedObjLitRows()
    mintGradualObjLitRows()
    // A concrete record literal with a field at a union mints its row once every annotation
    // has its own: a generic instance's return (D3264) or a function's inferred return set,
    // which no annotation names (D2891).
    const nLim = P.nodes.length
    let li = 0
    while li < nLim {
      if nodeAt(li) is ObjLit { mintUnionFieldObjRow(li) }
      li = li + 1
    }
  }
  0
}

// Names each union annotation's spelling onto the registered row of the same union, ahead of
// any pass that codes a record's fields (D4930).
function shareObjLitFieldUnionRows() {
  const nLim = P.nodes.length
  let li = 0
  while li < nLim {
    const tr = nodeAt(li)
    if tr is TypeRef {
      const at = nodeTyIxOf(li)
      if (
        at >= 0
        && at < T.tys.length
        && tyAt(at) is TyUnion
        && !tyHasTyVar(at)
        && !tyIsLitUnion(at)
      ) {
        if !unNameBound(tr.tyName) { unNameShareTyKeyRow(tr.tyName, at) }
      }
    }
    li = li + 1
  }
  0
}

// Whether record field type `ft` is a value union's box, nullable or not, or a record holding
// one in a field, at most four records down.
function objFieldHoldsUnionBox(ft: i32, depth: i32): boolean {
  if ft < 0 || ft >= T.tys.length || depth > 4 { return false }
  const fu = tyAt(ft)
  match fu {
    TyUnion => {
      return !tyIsLitUnion(ft)
    }
    TyNullable => {
      const ni = fu.nInner
      return ni >= 0
        && ni < T.tys.length
        && tyAt(ni) is TyUnion
        && !tyIsLitUnion(ft)
    }
    TyObj => {
      for gt in fu.objFieldTypes {
        if objFieldHoldsUnionBox(gt, depth + 1) { return true }
      }
    }
    TyPrim | TyErr | TyFunc | TyArray | TyMap | TyVar | TyLit | TyNeg => {
      // A list, map or function field holds its own row, not a box this literal mints.
    }
  }
  false
}

// Interns the row of concrete record literal `ix` when a field of its recorded type is a union,
// whose box exists by now. A spelling that already resolves to a row is left to it (D1694).
function mintUnionFieldObjRow(ix: i32) {
  const lt = nodeTyIxOf(ix)
  if lt < 0 || lt >= T.tys.length { return 0 }
  const o = tyAt(lt)
  if !(o is TyObj) { return 0 }
  for ft in o.objFieldTypes {
    if ft >= 0 && ft < T.tys.length {
      if objFieldHoldsUnionBox(ft, 0) {
        if tyHasTyVar(lt) { return 0 }
        if structRowOfRecordTy(lt) < 0 || structIndexOfObj(ix) < 0 {
          internShapeDeepOfTy(lt)
        }
        return 0
      }
    }
  }
  0
}

// Every record literal an instance re-made at its pin for a field at a union holding a type
// parameter gets its row, nested literals included, whatever its function returns (D2906).
function mintGradualObjLitRows() {
  for ox in monoGradualObjList {
    const lt = nodeTyIxOf(ox)
    if lt >= 0 && lt < T.tys.length {
      // A tagged set has no spelling for its id, so a record holding one mints from its literal.
      if fnTagHoldsTy(lt, 4) {
        if structIndexOfObj(ox) < 0 || objMintedAtOtherRep(ox) {
          const was = nodeTyInstEnter(monoGradualObjFrame.get(ox) ?? -1)
          anonMintRowFor(ox, -1)
          nodeTyInstEnter(was)
        }
      } else {
        internShapeDeepOfTy(lt)
      }
    }
  }
  0
}

// Whether record literal `ox`, which a joined result re-recorded, holds a mint row at a type
// other than the rep it is built at (D15226).
function objMintedAtOtherRep(ox: i32): boolean {
  const r = sLitMintRow.get(ox) ?? -1
  elabRestampedAt(ox)
    && r >= 0
    && r < sTyIx.length
    && sTyIx[r] != nodeRepTyIxOf(ox)
}

// Every generic instance's record literals with a field at a type parameter get their row at
// that instance's pins, which the template's type cannot mint (D3032); unresolved pins refuse at
// emit. A constructor, whose record leaves the instance, mints only a literal no row or union
// arm serves there, so a pin delivered into a wider declared arm keeps building it (D2850).
function mintPinnedObjLitRows() {
  let ctorRows = false
  let k = 0
  while k < monoInstFe.length && k < monoInstOrig.length {
    const fe = monoInstFe[k]
    if fe >= 0 && fe < fnStmts.length {
      const fd = nodeAt(fnStmts[fe])
      if fd is FuncDecl {
        pinCtorUnserved = !instRetKeepsRecordsIn(monoInstOrig[k])
        if pinCtorUnserved {
          pinCtorRet = tyStepRet(nodeTyIxOf(monoOrigNode[monoInstOrig[k]]))
          pinCtorBody = fd.fnBody
        }
        const before = sNames.length
        mintPinnedObjLitsIn(fd.fnBody, fnStmts[fe], fd.fnBody, 0)
        if pinCtorUnserved && sNames.length > before { ctorRows = true }
        pinCtorUnserved = false
        pinCtorRet = -1
        pinCtorBody = -1
      }
    }
    k = k + 1
  }
  if ctorRows { mintCtorHolderRows() }
  0
}

// Whether `mintPinnedObjLit` is minting a constructor's literal, which mints only when unserved.
let pinCtorUnserved = false
// That constructor's template return type: only a literal of exactly that type mints, never
// one arm of a join, whose other arms would be built at another row (D2855).
let pinCtorRet = -1
// That constructor's body, where a second literal with the same field names is such an arm.
let pinCtorBody = -1

// This module's per-program registers back at rest: the constructor context above and the
// anonymous-shape kind index, whose own clear runs only at the end of a pass that finished.
export function collectRegistersReset() {
  pinCtorRet = -1
  pinCtorBody = -1
  0
}

// How many record literals under `ix` carry the field-name signature `sig`.
function objLitSigCountIn(ix: i32, sig: string, depth: i32): i32 {
  if ix < 0 || ix >= P.nodes.length || depth > 256 { return 0 }
  let c = 0
  if nodeAt(ix) is ObjLit && objLitFieldSig(ix) == sig { c = 1 }
  for k in nodeChildren(ix) { c = c + objLitSigCountIn(k, sig, depth + 1) }
  c
}

// Every concrete record literal left without a row because a field holds a constructor's
// record, whose row exists only once its instance mints it (D2850).
function mintCtorHolderRows() {
  const nLim = P.nodes.length
  let li = 0
  while li < nLim {
    if nodeAt(li) is ObjLit {
      const lt = nodeTyIxOf(li)
      if (
        lt >= 0
        && lt < T.tys.length
        && !tyHasTyVar(lt)
        && structIndexOfObj(li) < 0
        && objVariantName(li) == ""
      ) {
        internShapeDeepOfTy(lt)
      }
    }
    li = li + 1
  }
  0
}

// Whether the generic at monomorphization row `orig` returns no value built at a type
// parameter other than one of the parameters themselves: a concrete type, a bare `T`, or a
// type holding no record.
function instRetKeepsRecordsIn(orig: i32): boolean {
  if orig < 0 || orig >= monoOrigNode.length { return false }
  const r = tyStepRet(nodeTyIxOf(monoOrigNode[orig]))
  if r < 0 || r >= T.tys.length { return false }
  if !tyHasTyVar(r) { return true }
  // A return holding no record (`T[]`) cannot carry one the body built at a pin (D4901).
  if !tyHoldsObj(r, 8) { return true }
  tyAt(r) is TyVar
}

// `mintPinnedObjLitRows` over the subtree at `ix` of instance `fnIx`, whose body is `body`,
// stopping at a nested function, whose literals are pinned by its own instance if any. A list
// literal names its element row once for every instance (D3036), so a literal it holds, or
// one bound to a name it holds, is left to that row.
function mintPinnedObjLitsIn(ix: i32, fnIx: i32, body: i32, depth: i32) {
  if ix < 0 || ix >= P.nodes.length || depth > 256 { return 0 }
  const n = nodeAt(ix)
  if n is FuncDecl || n is ArrayLit { return 0 }
  let lit = ix
  // A `let x: T` with no initializer holds no literal (D3223).
  if n is LetDecl && n.letInit >= 0 {
    const li = unwrapParen(n.letInit)
    // An un-annotated `if` join typed at the parameters is a box at the pin (`V | null` at
    // `i32`), a row no annotation spells (D10231).
    if (
      n.letType < 0
      && li >= 0
      && nodeAt(li) is IfStmt
      && tyHasTyVar(nodeTyIxOf(li))
    ) {
      const lj = elabNodeTyAt(li, fnIx)
      if lj >= 0 && !tyHasTyVar(lj) { mintValueUnionRowOfTy(lj) }
    }
    if (
      li >= 0
      && nodeAt(li) is ObjLit
      && nameInListLit(body, n.letName, false, 0)
    ) {
      lit = li
    }
  }
  if n is ObjLit { mintPinnedObjLit(ix, fnIx) }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if kids[i] == lit && lit != ix {
      const lk = nodeChildren(lit)
      let j = 0
      while j < lk.length {
        mintPinnedObjLitsIn(lk[j], fnIx, body, depth + 2)
        j = j + 1
      }
    } else {
      mintPinnedObjLitsIn(kids[i], fnIx, body, depth + 1)
    }
    i = i + 1
  }
  0
}

// Whether an identifier `name` is read inside a list literal under `ix`; `inList` says whether
// `ix` already is inside one.
function nameInListLit(
  ix: i32,
  name: string,
  inList: boolean,
  depth: i32,
): boolean {
  if ix < 0 || ix >= P.nodes.length || depth > 256 { return false }
  const n = nodeAt(ix)
  if n is Ident { return inList && n.identName == name }
  let inner = inList
  if n is ArrayLit { inner = true }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if nameInListLit(kids[i], name, inner, depth + 1) { return true }
    i = i + 1
  }
  false
}

// Whether a row already serves constructor literal `objIx` (recorded type `lt`) at instance
// `fnIx`: the row it classifies to takes the literal's type at the pins. Another pin's row
// sharing its wasm shape, `{a: i32}` for `{a: boolean}`, does not (D8240).
function pinCtorRowServes(objIx: i32, fnIx: i32, lt: i32): boolean {
  const row = structIndexOfObjCtx(objIx, fnIx)
  if row < 0 { return false }
  const rt = rlColAt(sTyIx, row)
  const st = pinSubstObjLitTy(objIx, fnIx, lt)
  if rt < 0 || st < 0 { return true }
  assignable(st, rt)
}

// The recorded type `lt` of record literal `objIx` with each type-parameter field at its value's
// pin in instance `fnIx` (a hole instance substituting any other field), or -1 when a field
// holds a parameter some other way or has no pin.
function pinSubstObjLitTy(objIx: i32, fnIx: i32, lt: i32): i32 {
  const o = nodeAt(objIx)
  if !(o is ObjLit) { return -1 }
  const bNames: string[] = []
  const bTys: i32[] = []
  for fi in o.objFields {
    const f = nodeAt(fi)
    if f is FieldInit {
      const ft = tyFieldTyOf(lt, f.fiName)
      if ft >= 0 && ft < T.tys.length {
        const fty = tyAt(ft)
        if fty is TyVar {
          const pin = pinnedValTyOf(f.fiValue, fnIx)
          if pin < 0 { return -1 }
          bNames.push(fty.tvName)
          bTys.push(pin)
        } else if tyHasTyVar(ft) {
          return -1
        }
      }
    }
  }
  if bNames.length == 0 { return -1 }
  const st = substTyDeep(lt, bNames, bTys)
  if st < 0 || tyHasTyVar(st) { return -1 }
  st
}

// The row a literal holding a tagged set's id at a record type the same as `t` is built at; -1
// when there is none.
function litIdRowOfSameTy(t: i32): i32 {
  let i = 0
  while i < sLitIdTys.length && i < sLitIdTyRows.length {
    if tySame(sLitIdTys[i], t) { return sLitIdTyRows[i] }
    i = i + 1
  }
  -1
}

// Interns the row of the record literal at `objIx` at instance `fnIx`'s pins, when a field of
// its recorded type is a type parameter and every such field's value has a pin.
function mintPinnedObjLit(objIx: i32, fnIx: i32) {
  const lt = nodeTyIxOf(objIx)
  if monoGradualObjLits.get(objIx) ?? false {
    if lt >= 0 && lt < T.tys.length { internShapeDeepOfTy(lt) }
    return 0
  }
  if lt < 0 || lt >= T.tys.length { return 0 }
  if objIx < 0 { return 0 }
  const o = nodeAt(objIx)
  if !(o is ObjLit) { return 0 }
  // A literal the instance re-made at its pin, over a capture cell's read, is typed at the pin
  // already and made after the collect pass minted rows (D7144).
  if !tyHasTyVar(lt) {
    if objIx >= anonShapesNodeLen {
      if structIndexOfObjCtx(objIx, fnIx) < 0 {
        internShapeDeepOfTy(lt)
      } else if repRowOfTyStruct(lt, sScanLim()) < 0 {
        // A row matched only by field names is another type's, the template's say: the
        // instance's closed type gets its own, minted from the literal and keyed by the type.
        anonMintRowFor(objIx, fnIx)
      }
    }
    return 0
  }
  // A tagged set has no spelling for its id, so a record an instance holds one in mints from
  // its literal at the instance.
  if fnTagHoldsTy(elabNodeTyAt(objIx, fnIx), 4) {
    // A literal the elaboration builds at a closed record is built at that record's row, which
    // the holder it is written into reads at too.
    const lr = litRepTyAt(objIx, fnIx)
    if (
      lr >= 0
      && lr < T.tys.length
      && tyAt(lr) is TyObj
      && !tyHasTyVar(lr)
      && !tyHasInferHole(lr, 0)
    ) {
      internShapeDeepOfTy(lr)
      return 0
    }
    // Another literal's row already denoting the instance's record type is this one's too.
    const lro = lr >= 0 && lr < T.tys.length && tyAt(lr) is TyObj
    let known = if lro { structIndexOfTy(lr) } else { -1 }
    // So is the row a literal of the same record type in another function is built at.
    if known < 0 && lro && !sLitIdRow.has(objIx) {
      known = litIdRowOfSameTy(lr)
      if known >= 0 {
        structTyMarkAliasable(lr)
        structTyIxAlias(lr, known)
      }
    }
    if !sLitIdRow.has(objIx) && known >= 0 {
      sLitIdRow.set(objIx, known)
      sLitIdTys.push(lr)
      sLitIdTyRows.push(known)
    }
    // So is the row another instance builds this literal at, which this instance's record type
    // then denotes too (D15638).
    const had = sLitIdRow.get(objIx) ?? -1
    if had >= 0 && known < 0 && lro {
      structTyMarkAliasable(lr)
      structTyIxAlias(lr, had)
    }
    if !sLitIdRow.has(objIx) {
      const pr = sLitMintRow.get(objIx) ?? -1
      const pf = sLitMintFn.get(objIx) ?? -1
      const before = sNames.length
      anonMintRowFor(objIx, fnIx)
      if sNames.length > before {
        sLitIdRow.set(objIx, sNames.length - 1)
        // The instance's record type denotes that row, which a binding of its call reads.
        if lr >= 0 && lr < T.tys.length && tyAt(lr) is TyObj {
          structTyMarkAliasable(lr)
          structTyIxAlias(lr, sNames.length - 1)
          sLitIdTys.push(lr)
          sLitIdTyRows.push(sNames.length - 1)
        }
      }
      // Instances holding no id keep the literal's own mint (-1 for none).
      sLitMintRow.set(objIx, pr)
      sLitMintFn.set(objIx, pf)
    }
    return 0
  }
  if pinCtorUnserved {
    if !tyEqSameHoles(lt, pinCtorRet) { return 0 }
    if objLitSigCountIn(pinCtorBody, objLitFieldSig(objIx), 0) != 1 { return 0 }
    if pinCtorRowServes(objIx, fnIx, lt) { return 0 }
    if objVariantNameCtx(objIx, fnIx) != "" { return 0 }
  }
  // A field at a union holding a type parameter is substituted through the instance's own
  // bindings, since no one value's pin names the parameter (D2906).
  const lo = tyAt(lt)
  if lo is TyObj {
    for lf in lo.objFieldTypes {
      if (
        lf >= 0
        && lf < T.tys.length
        && tyAt(lf) is TyUnion
        && tyHasTyVar(lf)
      ) {
        return 0
      }
    }
  }
  const bNames: string[] = []
  const bTys: i32[] = []
  let i = 0
  while i < o.objFields.length {
    const f = nodeAt(o.objFields[i])
    if f is FieldInit {
      const ft = tyFieldTyOf(lt, f.fiName)
      if ft >= 0 && ft < T.tys.length {
        const fty = tyAt(ft)
        if fty is TyVar {
          const pin = pinnedValTyOf(f.fiValue, fnIx)
          if pin < 0 { return 0 }
          bNames.push(fty.tvName)
          bTys.push(pin)
        } else if tyHasTyVar(ft) {
          // An exact instance binds a parameter no argument's pin names, as `T` in `v: T[] | i32[]`
          // read at its complement (D4888).
          const ps = exactOperandTyOf(objIx, fnIx)
          if ps >= 0 { internShapeDeepOfTy(ps) }
          return 0
        }
      }
    }
    i = i + 1
  }
  if bNames.length == 0 { return 0 }
  const st = substTyDeep(lt, bNames, bTys)
  if st < 0 || tyHasTyVar(st) { return 0 }
  internOwnShapeOfTy(st)
  0
}

// The arena length when `collectAnonShapes` runs: a literal at or past it is made after it.
let anonShapesNodeLen = 0

// Interns an object literal naming no declared struct or union variant as an unnamed struct,
// keyed by its field-name set and appended after every declared struct — so declared indices,
// and a program with no anonymous literal, stay unchanged. Must run after `collectU`; a field
// `anonFieldCode` cannot type leaves the shape un-interned, so that literal fails loudly later.
function collectAnonShapes() {
  anonShapesNodeLen = P.nodes.length
  if uVariants.length > 0 {
    let pi = 0
    while pi < P.nodes.length {
      const pn = nodeAt(pi)
      if pn is ObjLit {
        let pk = 0
        while pk < pn.objFields.length {
          const pf = nodeAt(pn.objFields[pk])
          if pf is FieldInit {
            // The arm-shape mint an ANONYMOUS holder owes: `collectNestedFieldShapes` interns
            // the row a DECLARED `f: P` field stores through, read off the annotation, and an
            // inferred holder has none — so the field took no code and the literal no row (D1672).
            internArmShapeRow(repVariantShapeRowOf(nodeTyIxOf(pf.fiValue)))
          }
          pk = pk + 1
        }
      }
      pi = pi + 1
    }
  }
  // A call the record solve copies back to its own record lands in that record's row (D15246).
  let ci = 0
  while ci < P.nodes.length {
    if recCopyFromOf(ci) >= 0 {
      const ct = recCopyTyOf(ci)
      if ct >= 0 && ct < T.tys.length && tyAt(ct) is TyObj {
        internShapeDeepOfTy(ct)
      }
    }
    ci = ci + 1
  }
  // A holder whose empty-list field a later push pinned to a record keys that field by the
  // record's row, so it mints after every other literal has minted its row (D2640).
  const late: i32[] = []
  let ai = 0
  while ai < P.nodes.length {
    const an = nodeAt(ai)
    if an is ObjLit {
      if anonHolderAwaitsElemRow(ai, 0, false) {
        late.push(ai)
      } else {
        anonMintLiteral(ai)
      }
    }
    ai = ai + 1
  }
  // Inner holders first: a late holder whose element is itself a late holder's record waits a
  // round for that row, and a round that mints nothing mints the rest as they stand.
  let pending = late
  while pending.length > 0 {
    const next: i32[] = []
    for li in pending {
      if anonHolderAwaitsElemRow(li, 0, true) {
        next.push(li)
      } else {
        anonMintLiteral(li)
      }
    }
    if next.length == pending.length {
      for li in next { anonMintLiteral(li) }
      pending = []
    } else {
      pending = next
    }
  }
  0
}

// The main loop's body for the object literal at `ai`: mint its row unless one already serves it.
// A literal the checker adopted into a record of another type builds at that record's row;
// once that row exists it mints none of its own, since a row keyed by the destination's type with
// the literal's layout would be a canon twin of it.
function anonMintLiteral(ai: i32) {
  // A literal the check never typed is built nowhere: a `__callsite__` object minted for a call
  // that supplied the argument itself.
  if nodeTyIxOf(ai) < 0 { return 0 }
  anonMintInstanceRows(ai)
  const adopted = nodeRepTyIxOf(ai)
  if (
    adopted >= 0
    && adopted != nodeTyIxOf(ai)
    && !tyHasTyVar(adopted)
    && tyAt(adopted) is TyObj
  ) {
    internShapeDeepOfTy(adopted)
    if repRowOfTyStruct(adopted, sNames.length) >= 0 { return 0 }
  }
  if (structIndexOfObj(ai) < 0 && objVariantName(ai) == "") {
    anonMintRowFor(ai, 0 - 1)
  }
  0
}

// Interns a row at each closed record type the elaboration gave the object literal at `ai`, one
// per instance of the generic body it sits in, since each instance builds it at its own type.
function anonMintInstanceRows(ai: i32) {
  for t in elabLitInstTys(ai) {
    if t != nodeTyIxOf(ai) && !tyHasTyVar(t) && tyAt(t) is TyObj {
      internOwnShapeOfTy(t)
    }
  }
  0
}

// Interns the list row of each closed record type an instance builds list literal `nd`'s leading
// record literal at, the rows `arrLitElemName` keys the list by in those instances.
function arrLitInstElemRows(nd: ArrayLit) {
  if nd.arrElems.length < 1 || !(nodeAt(nd.arrElems[0]) is ObjLit) { return 0 }
  const e0 = nd.arrElems[0]
  for t in elabLitInstTys(e0) {
    if t != nodeTyIxOf(e0) && !tyHasTyVar(t) && tyAt(t) is TyObj {
      rlInternNameTy(rlRowNameOfTy(t, false), RLK_STRUCT, t)
    }
  }
  0
}

// The list type list literal `ai` is built as: its rep stamp where the checker built its
// elements at another type, else its own type.
function arrLitBuildTy(ai: i32): i32 {
  const t = litRepTyAt(ai, -1)
  if t < 0 || tyHasTyVar(t) || !(tyAt(t) is TyArray) { return nodeTyIxOf(ai) }
  t
}

// Interns the list row of the record list literal `ai`'s rep stamp builds its elements at, where
// that is not its own element: the row `listRowOfExpr` keys it by. Whether it interned one.
function arrLitRepElemRow(ai: i32): boolean {
  const t = litRepTyAt(ai, -1)
  if t < 0 || t == nodeTyIxOf(ai) || tyHasTyVar(t) { return false }
  const e = tyArrayElemIx(t)
  if e < 0 || e >= T.tys.length { return false }
  // A nullable record element is built at its non-null record too, keyed by the whole type.
  const et = tyAt(e)
  const inner = if et is TyNullable { et.nInner } else { e }
  if inner < 0 || inner >= T.tys.length || !(tyAt(inner) is TyObj) {
    return false
  }
  rlInternNameTy(rlRowNameOfTy(e, false), RLK_STRUCT, e)
  true
}

// Whether the object literal at `objIx` has a field, directly or through a nested literal, that
// is an empty list literal whose recorded element is a record type.
function anonHolderAwaitsElemRow(
  objIx: i32,
  depth: i32,
  unminted: boolean,
): boolean {
  if depth > 8 || objIx < 0 || objIx >= P.nodes.length { return false }
  const o = nodeAt(objIx)
  if !(o is ObjLit) { return false }
  for fx in o.objFields {
    const f = nodeAt(fx)
    if f is FieldInit {
      const v = unwrapParen(f.fiValue)
      if anonEmptyRecordListLit(v, unminted) { return true }
      if anonRecordValuedMap(v, unminted) { return true }
      if anonHolderAwaitsElemRow(v, depth + 1, unminted) { return true }
    }
  }
  false
}

// Whether node `ix` is an empty list literal whose recorded element is a record type — with
// `unminted`, one no struct row holds yet.
function anonEmptyRecordListLit(ix: i32, unminted: boolean): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if n is ArrayLit {
    if n.arrElems.length > 0 || !anonEmptyListElemIsObj(nodeTyIxOf(ix)) {
      return false
    }
    if !unminted { return true }
    return repRowOfTyStruct(tyRefArrElemOf(nodeTyIxOf(ix)), sScanLim()) < 0
  }
  false
}

// Whether node `ix` is a map whose value is a record type, the map twin of
// `anonEmptyRecordListLit`: a later store can be the first literal of that record, so its row
// may not exist yet. With `unminted`, one no struct row holds yet.
function anonRecordValuedMap(ix: i32, unminted: boolean): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const mv = tyMapValOf(nonNullTy(nodeTyIxOf(ix)))
  if mv < 0 || mv >= T.tys.length || !(tyAt(mv) is TyObj) { return false }
  if !unminted { return true }
  repRowOfTyStruct(mv, sScanLim()) < 0
}

// Whether list type `ty` has a record element.
function anonEmptyListElemIsObj(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  if t is TyArray {
    if t.aElem < 0 || t.aElem >= T.tys.length { return false }
    return tyAt(t.aElem) is TyObj
  }
  false
}

// Mint one anonymous struct row for the object literal at `objIx`. The body of
// The field code of value `v` at instance `fnIx`'s primitive type for it, or -1.
function anonInstPrimCode(v: i32, fnIx: i32): i32 {
  const t = elabNodeTyAt(v, fnIx)
  if t < 0 || t >= T.tys.length || !(tyAt(t) is TyPrim) { return -1 }
  const c = fieldCodeOfTy(t)
  if c < 0 { -1 } else { c }
}

// Whether literal `an` at `objIx` is stamped with a record type other than its own that lacks one
// of the fields it writes.
function anonLitDropsAtRep(an: ObjLit, objIx: i32): boolean {
  const at = anonRowTyIx(objIx)
  if at < 0 || at == nodeTyIxOf(objIx) { return false }
  const t = tyAt(at)
  if !(t is TyObj) { return false }
  for fx in an.objFields {
    const f = nodeAt(fx)
    if f is FieldInit && objFieldType(t, f.fiName) < 0 { return true }
  }
  false
}

// The union box a `null` value of the literal at `objIx` is stored in at field `name`: the box
// of the field type the literal is typed at, when that type is a value union, or "" (D15730).
function anonNullFieldBox(objIx: i32, name: string): string {
  const ft = recFieldTyOf(nodeTyIxOf(objIx), name)
  if ft < 0 || tyHasTyVar(ft) { return "" }
  const bn = regUnionNameOfTy(ft)
  if bn == "" || !isValueUnionName(bn) { return "" }
  bn
}

// `collectAnonShapes`' main loop, extracted so the pre-mint pass mints a row the same
// way rather than through a second copy of it — two mints that disagree would put two
// different layouts under one `#anonN` key.
function anonMintRowFor(objIx: i32, fnIx: i32) {
  const an = nodeAt(objIx)
  // A literal the checker built at a record declaring fewer fields than it writes is built at
  // that record's row, its extra fields run for effect, so it mints no row of its own (D3566).
  if an is ObjLit && anonLitDropsAtRep(an, objIx) { return 0 }
  if an is ObjLit {
    const ai = objIx
    const fields = an.objFields
    const codes: i32[] = []
    const names: string[] = []
    const elemNames: string[] = []
    const elemRowTys: i32[] = []
    const elemKeys: i32[] = []
    let ok = true
    let fi = 0
    while fi < fields.length {
      const f = nodeAt(fields[fi])
      if f is FieldInit {
        let code = anonFieldCode(f.fiValue)
        // A value an instance types at a tagged set holds its id.
        if (
          code < 0
          && fnIx >= 0
          && fnTagTyIsTagged(elabNodeTyAt(f.fiValue, fnIx))
        ) {
          code = FC_I32
        }
        // So does one at the template's type parameter, at the instance's primitive (D15554).
        if code < 0 && fnIx >= 0 { code = anonInstPrimCode(f.fiValue, fnIx) }
        const nullBox = if code == FC_NUL_NONE { anonNullFieldBox(ai, f.fiName) } else { "" }
        if nullBox != "" { code = FC_UNION }
        if code == FC_MAP && !anonMapFieldDestAdmits(ai, f.fiName) { code = -1 }
        if code < 0 { ok = false }
        codes.push(code)
        names.push(f.fiName)
        // A nested-struct field keeps the row it names, so its element type is that row's own.
        const er = if code == FC_STRUCT { anonFieldStructRow(f.fiValue) } else { -1 }
        // A ref-list field led by a record literal keeps that literal's row, and so its type.
        elemRowTys.push(
          if er >= 0 && er < sTyIx.length { sTyIx[er] } else if code == FC_REF_LIST { anonRefListLitElemTy(f.fiValue) } else { anonFieldElemValTy(f.fiValue, code) },
        )
        if er >= 0 { elemNames.push(sNames[er]) }
        else if nullBox != "" { elemNames.push(nullBox) }
        else { elemNames.push(anonFieldElemName(f.fiValue, code)) }
        elemKeys.push(anonFieldElemKeyKind(f.fiValue, code))
      } else {
        ok = false
      }
      fi = fi + 1
    }
    if ok && codes.length > 0 {
      sDeclared = true
      // A synthetic unique name (`#` never collides with a user identifier), so a ref list of
      // this shape interns a slot; the arena-index sidecar keys it by type index instead of name.
      sNames.push("#anon" + i32ToStr(sNames.length))
      recordSRowDeclOfName(sNames[sNames.length - 1])
      recordSTyIx(anonRowTyIx(ai))
      sLitMintRow.set(ai, sNames.length - 1)
      sLitMintFn.set(ai, fnIx)
      const ownTy = anonRowOwnTyIx(ai)
      if ownTy >= 0 {
        sAnonOwnTy.set(sNames.length - 1, ownTy)
        tyRegNoteWrite()
      }
      sFieldStart.push(sFieldNames.length)
      sFieldCount.push(codes.length)
      // D622 — the canonical field order (`fieldNameOrder`): an `#anon` row's own dedup is
      // field-name keyed, so only the emitted sequence moves, letting it share a declared row's shape.
      const aOrd = fieldNameOrder(names)
      let pj = 0
      while pj < codes.length {
        const pi = aOrd[pj]
        storeTyPut(
          sFieldStoreTy,
          sFieldNames.length,
          fieldStoreTyOf(codes[pi], recFieldTyOf(anonRowStoreTyIx(ai), names[pi])),
        )
        sFieldNames.push(names[pi])
        sFieldTypes.push(codes[pi])
        // An anonymous literal's field has no annotation text to key a closure signature
        // from — "" is this recorder's honest answer, and the consumer reads it as unknown.
        sFieldCloSig.push("")
        sFieldElemName.push(elemNames[pi])
        // B6b — an anonymous literal's map field (code 19) carries a real key column, since an mv
        // slot's identity is the (key, value) pair and both come off the checker's recorded type.
        let aeTy = elemRowTys[pi]
        if codes[pi] == FC_REF_LIST || codes[pi] == FC_NUL_REF_LIST {
          const sr = shapeFieldElemRow(
            shapeFieldRowOf(anonRowTyIx(ai), names[pi]),
            codes[pi],
          )
          if sr >= 0 || codes[pi] == FC_NUL_REF_LIST { aeTy = sr }
        }
        if aeTy < 0 && elemNames[pi] != "" {
          const fr = shapeFieldRowOf(anonRowTyIx(ai), names[pi])
          aeTy = fieldElemHintOfRow(fr, fr, codes[pi])
        }
        recordSFieldElemRowTy(elemNames[pi], elemKeys[pi], aeTy) // D5
        // A function-valued field (code 14) interns a closure cell, so flag the module to emit the
        // closure rec-group types even when no lambda is otherwise lifted (`{ f: inc }`).
        // Code 22 is the same cell one niche wider (`(ref null $clo)`), and needs the flag for
        // the same reason (D1627).
        if codes[pi] == FC_CLOSURE || codes[pi] == FC_NUL_CLOSURE {
          fnValUsed = true
        }
        pj = pj + 1
      }
      famRelayStructRow(sNames.length - 1)
      // A value-union field interns its box reps here, since this mint skips `pushFieldRow`; D804's
      // leaf set is named nowhere else, so without it `struct.new` builds a raw scalar, not a box.
      let rj = 0
      while rj < codes.length {
        if codes[rj] == FC_UNION { registerValueUnionName(elemNames[rj]) }
        rj = rj + 1
      }
    }
  }
  0
}

// Notes generic-alias field annotation `nodeIx` when its type mentions one of `pnames`: such a
// node is a generic original, read by `gaeParamFieldNodeIs`.
function gaeNoteParamField(nodeIx: i32, pnames: string[]) {
  if declAnnRawTyName(nodeIx) == "" { return 0 }
  if monoAnnHasTyParam(nodeIx, -1, pnames) { gaeParamFieldNodes.push(nodeIx) }
  0
}

// The annotation nodes of generic-alias fields whose type mentions the alias's parameter,
// refilled by `gaeCollectDecls`. Such a node is a generic original with no rep of its own:
// the checker records no type for it, or the last application's (D11450, D11451).
let gaeParamFieldNodes: i32[] = []

function gaeParamFieldNodeIs(ix: i32): boolean {
  let k = 0
  while k < gaeParamFieldNodes.length {
    if gaeParamFieldNodes[k] == ix { return true }
    k = k + 1
  }
  false
}

// Empties the generic-alias registry. `collectS` reads it for declared struct fields before
// `gaeCollectDecls` refills it, so a compile on a shared instance starts from empty, not from
// the previous program's aliases.
export function gaeDeclsReset() {
  gaeBases = []
  gaeParams = []
  gaeParamFieldNodes = []
}

// Record every generic-alias declaration into the registry.
function gaeCollectDecls(stmts: i32[]) {
  gaeDeclsReset()
  let i = 0
  while i < stmts.length {
    const s = nodeAt(stmts[i])
    if s is TypeDecl {
      // The generic-application span test (`annGenAppSpanEnds`); this site stores the raw
      // parameter text (`gaeHeadNameOf`/`gaeArgsTextOf`), split later at `gaeEnsure`.
      if annGenAppSpanEnds(s.tdName) {
        const lt = gaeLtAt(s.tdName)
        gaeBases.push(gaeHeadNameOf(s.tdName, lt))
        const ptext = gaeArgsTextOf(s.tdName, lt)
        gaeParams.push(ptext)
        const pnames: string[] = []
        gaeSplitArgs(ptext, pnames)
        const fields = s.tdFields
        let fi = 0
        while fi < fields.length {
          const fnode = nodeAt(fields[fi])
          if fnode is FieldDef && fnode.fdType >= 0 {
            gaeNoteParamField(fnode.fdType, pnames)
          }
          fi = fi + 1
        }
      }
    }
    i = i + 1
  }
  0
}

// The type a generic application sits at under the wrappers an annotation can put around it,
// one `| null` and any number of `[]` (`Box<i32>[] | null` → `Box<i32>`), or -1 for a hole.
function gaeAppUnder(ty: i32): i32 {
  let t = tyPeelNul(ty)
  while tyIsArray(t) { t = tyStepElem(t) }
  t
}

// Interns every generic-alias application a TypeRef's type holds behind `| null` and `[]`, or
// as a map's value. The row name is the checker's application registry entry for the type
// (`genAppNameOfTy`), "" for an application over a type parameter, which each instance interns.
export function collectGenAliasShapes() {
  if gaeBases.length == 0 { return 0 }
  let ti = 0
  while ti < P.nodes.length {
    const tn = nodeAt(ti)
    if tn is TypeRef {
      const app = gaeAppUnder(fdRowOf(ti))
      const nm = genAppNameOfTy(app)
      if nm != "" { gaeEnsure(nm, app) }
      // A map annotation's value position (`{[string]: Box<i32>}`) is interior to the map's
      // one TypeRef, so the walk above misses it; interning it here makes the map spelling self-sufficient.
      const mvTy = gaeAppUnder(tyMapValOf(app))
      const mv = genAppNameOfTy(mvTy)
      if mv != "" { gaeEnsure(mv, mvTy) }
    }
    ti = ti + 1
  }
  0
}

// Interns the row of the union arm a field or annotation type names (`g: Circle`,
// `g: Circle | null`), through a nullable's inner type, a list's element, a map's value and an
// inline record's fields (D1672), so `armFieldStructRow` has a row to answer with. A declared
// record is a leaf, as its name is. A no-op for a type with no arm, and costs no heap type.
function internArmFieldShapeTy(ty: i32, depth: i32) {
  if depth > 8 || ty < 0 || ty >= T.tys.length { return 0 }
  const t = tyAt(ty)
  if t is TyNullable { return internArmFieldShapeTy(t.nInner, depth + 1) }
  if t is TyArray { return internArmFieldShapeTy(t.aElem, depth + 1) }
  if t is TyMap { return internArmFieldShapeTy(t.mVal, depth + 1) }
  if t is TyObj {
    if structNameOfTy(ty) == "" {
      for f in t.objFieldTypes { internArmFieldShapeTy(f, depth + 1) }
      return 0
    }
  }
  internArmShapeRow(repVariantShapeRowOf(ty))
}

// `internArmFieldShapeTy` with a declared record's fields descended too, for a join whose
// record is spelled by its shape; any other type mints the arm row that carries it.
function internArmShapeOfTy(ty: i32, depth: i32) {
  if depth > 8 || ty < 0 || ty >= T.tys.length { return 0 }
  const t = tyAt(ty)
  if t is TyNullable { return internArmShapeOfTy(t.nInner, depth + 1) }
  if t is TyArray { return internArmShapeOfTy(t.aElem, depth + 1) }
  if t is TyMap { return internArmShapeOfTy(t.mVal, depth + 1) }
  if t is TyObj {
    for f in t.objFieldTypes { internArmShapeOfTy(f, depth + 1) }
    return 0
  }
  internArmShapeRow(repVariantShapeRowOf(ty))
}

// Interns every inline-shape struct field type (`type Box = { inner: {x:i32} }`) depth-first
// before the struct decls that reference it, so `collectS`'s main loop can resolve the nested
// shape (`internInlineShape` shares the flat `sField*` arrays and cannot run mid-loop). A no-op
// for a non-shape name and idempotent, so a program with none is unaffected.
function collectNestedFieldShapes(stmts: i32[]) {
  let i = 0
  while i < stmts.length {
    emitCurStmtIx = stmts[i] // the declaration cursor (D1519 — see `collectU`)
    const s = nodeAt(stmts[i])
    if s is TypeDecl {
      // D1518 — the arm-field mint below is not gated on the owner: it answers for the field's
      // target, which a declaration that is itself a union arm shares with an ordinary owner.
      const ownsRow = !declIsVariantArm(s) && gaeLtAt(s.tdName) < 0
      const fields = s.tdFields
      let fi = 0
      while fi < fields.length {
        const fnode = nodeAt(fields[fi])
        if fnode is FieldDef {
          // D280 — a field typed as a union arm stores through the struct row the arm shares
          // (`armFieldStructRow`); interning the arm's own render mints it at no extra heap
          // type. First, because the nested-shape intern below asks `armFieldStructRow` about
          // its OWN fields' arms and the struct table is otherwise still empty (D1707).
          const fdNm = tyNameOf(fnode.fdType)
          let fdRoot = -1
          if !nameMentionsGenAliasParam(fdNm) {
            if canonRewroteNode(fnode.fdType) {
              fdRoot = canonTyIxOf(fnode.fdType)
            } else {
              fdRoot = nodeTyIxOf(fnode.fdType)
            }
            internArmFieldShapeTy(fdRoot, 0)
          } else {
            internArmFieldShapeTy(declAnnTyOf(fnode.fdType), 0)
          }
          // `internShapeDeepTy` peels composition wrappers and descends a map field's value, so a
          // declared nullable-map field's value struct interns before `collectS` codes the field.
          if ownsRow { internShapeDeepTy(fdNm, fdRoot) }
        }
        fi = fi + 1
      }
    }
    i = i + 1
  }
  emitCurStmtIx = -1
  0
}

// The one home of the declared-field element-name recording: the name a `FieldDef`'s
// annotation node `tyIx` (already coded `code`) records into `sFieldElemName`/`armFieldElemName`.
// `fieldRefElemName` answers every code but 0 and 30, for which the atom name comes from the
// annotation's own spelling instead — the two arms `collectS` and `collectVariantFields` share.
function fieldRecElemName(tyIx: i32, code: i32) {
  const en = fieldRefElemName(tyIx, code)
  // A literal-union atom field (code 0) records its union name (not the ref-elem name,
  // which is "" for it) so `sFieldIsLitUnion` recovers the atom rep + membership.
  if code == FC_I32 {
    // The litunion test off the row (B290): `annRowOfNode` reads canon's banked row where
    // canon rewrote the spelling. Dual-written: 932 reaches, 0 disagreements.
    const ftn = tyNameOf(tyIx)
    if tyIsLitUnion(annRowOfNode(tyIx)) { return ftn }
    // A bare string literal names its one-member set: the set's alias, else its lexeme.
    if tyIsOneStrLit(nodeTyIxOf(tyIx)) {
      return litSetAtomNameOfTy(nodeTyIxOf(tyIx))
    }
    return en
  }
  // The string-slot inline literal-union field: the recorded name must be the member set, not
  // the annotation's spelling, since canon softens a bare inline set to `string` at `RC_ROOT`.
  if code == FC_STR {
    const luN = litUnionInlineNameOfTy(nodeTyIxOf(tyIx))
    if luN != "" { return luN }
    return en
  }
  // A nullable-litunion niche field (code 30) records the non-null union name — the
  // code-0 recording over the `| null`-stripped part.
  if code == FC_NUL_LIT_UNION {
    return nulLitUnionInnerNameOfTy(annRowOfNode(tyIx))
  }
  en
}

// Appends one field's parallel columns to the struct table (`toVariant` false, `tyText` unused)
// or variant table (true), then interns a code-16 field's value union under its type `litTyIx`
// and forces a scalar-list field's wrapper/backing pair.
// Push order matters: the D5 sidecar pads against `*FieldElemName.length`.
function pushFieldRow(
  toVariant: boolean,
  code: i32,
  elemNm: string,
  keyK: i32,
  fName: string,
  tyText: string,
  elemTyHint: i32,
  litTyIx: i32,
  cloSig: string,
) {
  if toVariant {
    storeTyPut(
      armStageStoreTy,
      armStageNames.length,
      fieldStoreTyOf(code, litTyIx),
    )
    armStageTypes.push(code)
    armStageTyText.push(tyText)
    // D1023 — the discriminant column: the field's own arena type when it is a literal set, -1
    // otherwise. Pushed here, not per recorder, so no column drifts out of parallel across the three.
    armStageLitTyIx.push(litSetTyIxOf(litTyIx))
    armStageElemName.push(elemNm)
    recordUFieldElemRowTy(elemNm, keyK, elemTyHint) // D5 + B6b
    armStageNames.push(fName)
  } else {
    storeTyPut(sFieldStoreTy, sFieldNames.length, fieldStoreTyOf(code, litTyIx))
    sFieldTypes.push(code)
    sFieldElemName.push(elemNm)
    sFieldCloSig.push(cloSig)
    recordSFieldElemRowTy(elemNm, keyK, elemTyHint) // D5 + B6b
    sFieldNames.push(fName)
  }
  // A value-union field interns its box reps here (shared by all three recorders); without it
  // `struct.new` builds a raw scalar where the box `(ref)` is required.
  if code == FC_UNION { registerValueUnionOfTy(54, litTyIx) }
  // A scalar-list field (`f: i64[]`) forces its backing + wrapper pair: a field may be the
  // type's only mention, with no standalone `i64[]` TypeRef to set the flag.
  forceScalarListField(code)
  0
}

// The flat declaration named `name` among `stmts`, or -1. Nested layout-only detection needs
// the decl of a nested flat field, keyed by its spelling.
function flatDeclByName(stmts: i32[], name: string): i32 {
  let i = 0
  while i < stmts.length {
    const s = nodeAt(stmts[i])
    if s is TypeDecl {
      if s.tdFlat == 1 && s.tdName == name { return stmts[i] }
    }
    i = i + 1
  }
  -1
}

// True if a `flat` declaration is layout-only: it has a sub-word storage field (`u8`/`i8`/`u16`/
// `i16`), or nests a flat that does — a byte field has a width but no struct-field rep, so the
// record is not also a GC struct and is read by address and offset. Transitive (a nested
// layout-only flat propagates), depth-bounded since a flat cycle is already a size error.
function flatHasSubWordField(sx: i32, stmts: i32[], depth: i32): boolean {
  if depth <= 0 { return false }
  const s = nodeAt(sx)
  if s is TypeDecl {
    if s.tdFlat == 0 { return false }
    const fields = s.tdFields
    let i = 0
    while i < fields.length {
      const fd = nodeAt(fields[i])
      if fd is FieldDef {
        // A sub-word width is a storage spelling the arena types as `i32`.
        const nm = tyNameOf(fd.fdType)
        if flatStorageSpellWidth(nm) > 0 { return true }
        const nx = flatDeclByName(stmts, nm)
        if nx >= 0 {
          if flatHasSubWordField(nx, stmts, depth - 1) { return true }
        }
      }
      i = i + 1
    }
  }
  false
}

// Empties the struct table and the indexes keyed on its spellings, so the next program's rows
// never answer with this one's names. `collectU` runs first and reads it, so it resets it too.
function structTableReset() {
  structNameIxReset()
  shapeSetIxReset()
  structFieldNameIxReset()
  structCanonIxReset()
  structTyIxReset()
  sNames = []
  sRowDecl = []
  sTyIx = []
  sRefRow = []
  refRowIndexReset()
  sAnonOwnTy = Map()
  sLitMintRow = Map()
  sLitMintFn = Map()
  sLitIdRow = Map()
  sLitIdTys = []
  sLitIdTyRows = []
  sFieldNames = []
  sFieldStart = []
  sFieldCount = []
  sFieldTypes = []
  sFieldElemName = []
  sFieldCloSig = []
  sFieldElemTyIx = []
  sFieldElemKeyKind = []
  sFieldTyText = []
  sFieldLitTyIx = []
  sFieldStoreTy = []
  famRelayReset()
  0
}

// Whether record declaration `s` is stored at a variant row: a row holds its checked type, so a
// same-shape record of an arm's type shares that arm's row.
function declIsVariantArm(s: TypeDecl): boolean {
  exactArmRowOfTy(declTyIxOfName(s.tdName)) >= 0
}

// Whether `collectS` mints a declared struct row for type declaration `s` at `sx`: a union variant
// belongs to the variant table, a generic alias has no concrete shape, and a sub-word `flat`
// record is layout-only.
function typeDeclMintsRow(s: TypeDecl, sx: i32, stmts: i32[]): boolean {
  !declIsVariantArm(s)
    && gaeLtAt(s.tdName) < 0
    && !flatHasSubWordField(sx, stmts, 16)
}

// The arena types of the declared struct rows `collectS` will mint from `stmts`.
function declRowTysOf(stmts: i32[]): i32[] {
  const out: i32[] = []
  for sx in stmts {
    const s = nodeAt(sx)
    if s is TypeDecl {
      if typeDeclMintsRow(s, sx, stmts) { out.push(sTyIxOfName(s.tdName)) }
    }
  }
  out
}

// ── struct-type collection ───────────────────────────────────────────────────
// Scans top-level statements for every struct `type` declaration into the flat multi-struct
// table; each interns its own WasmGC struct heap type, and a field whose type has no code
// fails loudly. Then runs the shape passes in order. Returns 0, or -1 (via `emitFail`).
export function collectS(stmts: i32[]) {
  sDeclared = false
  // The per-program literal-resolution memo keys node indices against this table —
  // both are program-scoped, so it resets with the table.
  sioMemoReset()
  anonShapesNodeLen = 0
  structTableReset()
  // Nested inline-shape field types intern first, so the struct decls that reference them resolve.
  collectNestedFieldShapes(stmts)
  // A `type X = {…}` that is a union variant is collected by `collectU` instead, not here; any
  // other struct type (declared alongside a union) is a standalone struct interned here.
  let i = 0
  while i < stmts.length {
    emitCurStmtIx = stmts[i] // the declaration cursor (D1519 — see `collectU`)
    const s = nodeAt(stmts[i])
    // A struct-alias union decl (a single inline-shape variant) is a plain named struct: intern
    // it here, since `collectU` skipped it.
    if s is UnionDecl {
      const aliasShape = unionDeclStructAlias(s)
      if aliasShape != "" {
        if internShapeAs(s.udName, aliasShape) < 0 { return -1 }
      }
    }
    // A union variant `TypeDecl` belongs to the variant table, not here; a generic alias
    // declaration has no concrete shape, its applications intern via `collectGenAliasShapes`.
    if s is TypeDecl {
      // A `flat` record is ordinarily also a GC struct (`flat` subtracts nothing). The one
      // exception is a sub-word storage field (`u8`/`i8`/`u16`/`i16`): it has no struct-field
      // rep, only a byte width, so such a record is layout-only — read by address and offset —
      // and builds no struct-field table.
      if typeDeclMintsRow(s, stmts[i], stmts) {
        sDeclared = true
        sNames.push(s.tdName)
        recordSRowDeclOfName(s.tdName)
        recordSTyIx(sTyIxOfName(s.tdName)) // D0
        sFieldStart.push(sFieldNames.length)
        const fields = s.tdFields
        // D622 — field order is canonical, ascending by field name (`fieldNameOrder`), since two
        // permuted declarations of one shape must collapse to one heap type; `tdFlat` is the
        // exception (its order is its layout).
        const fOrder: i32[] = []
        let fq = 0
        while fq < fields.length {
          fOrder.push(fields[fq])
          fq = fq + 1
        }
        if s.tdFlat == 0 {
          const fnames: string[] = []
          let fp = 0
          while fp < fields.length {
            const fpn = nodeAt(fields[fp])
            if fpn is FieldDef { fnames.push(fpn.fdName) }
            fp = fp + 1
          }
          if fnames.length == fields.length {
            const bOrd = fieldNameOrder(fnames)
            let rw = 0
            while rw < bOrd.length {
              fOrder[rw] = fields[bOrd[rw]]
              rw = rw + 1
            }
          }
        }
        let cnt = 0
        let fi = 0
        while fi < fOrder.length {
          const fnode = nodeAt(fOrder[fi])
          if fnode is FieldDef {
            const code = nameFieldCodeTy(
              tyNameOf(fnode.fdType),
              recFieldTyOf(sTyIxOfName(s.tdName), fnode.fdName),
            )
            if code < 0 {
              // The field's own spelling, so the refusal can name what it refused (`fieldTypeRefusalMsg`,
              // D734); a non-`TypeRef` annotation takes the general sentence.
              let fdNm = ""
              if fnode.fdType >= 0 {
                const fdT = nodeAt(fnode.fdType)
                if fdT is TypeRef { fdNm = fdT.tyName }
              }
              return emitFail(
                fieldTypeRefusalMsg(
                  fdNm,
                  recFieldTyOf(sTyIxOfName(s.tdName), fnode.fdName),
                ),
              )
            }
            // The recorded elem name is `fieldRefElemName`'s answer at code 16 (neither of
            // `fieldRecElemName`'s two arms fires), so `pushFieldRow`'s intern reads the same value.
            const recNm = fieldRecElemName(fnode.fdType, code)
            // The last argument is the arena, not a render: `sigKeyOfTy` answers the closure-signature
            // key from the type it already has.
            pushFieldRow(
              false,
              code,
              recNm,
              nodeTyMapKeyKindSpan(fnode.fdType),
              fnode.fdName,
              "",
              fieldElemHintOf(fnode.fdType, code, recNm),
              nodeTyIxOf(fnode.fdType),
              fieldCloSigOfTy(code, nodeTyIxOf(fnode.fdType)),
            )
            // `nodeTyMapKeyKindSpan`, not the exact twin: this column is the mv slot's key half,
            // and the span form is what matches `mapSpellKeyName`'s cut.
            cnt = cnt + 1
          } else {
            return emitFail("emitProgram: malformed struct field")
          }
          fi = fi + 1
        }
        sFieldCount.push(cnt)
      }
    }
    i = i + 1
  }
  // D1519 — the cursor is the declaration loop's and ends with it; the shape passes below walk
  // the arena, not `stmts`, so a confidently wrong position is worse than none — they stay positionless.
  emitCurStmtIx = -1
  // D1050 — gives a mixed-spelling pair one layout now both field tables are complete, before
  // the shape passes below re-lay a row a shape could otherwise twin onto.
  if unifyMixedLitRepArms() < 0 { return -1 }
  // Generic-alias application shapes next: the declared structs they may reference are
  // interned above, so their names resolve as code-15 struct-ref fields.
  gaeCollectDecls(stmts)
  collectGenAliasShapes()
  // Inline object-type annotation shapes first, so a literal whose values are
  // unclassifiable param reads (`{ x: n }`) still matches the annotation's shape.
  collectAnnShapes()
  collectAnonShapes()
  // The declared rows exist now, so the pending set `collectU` recorded is spent.
  repDeclRowsPending([])
  // Every union arm whose record no struct row holds gets a reference row now, so the rows
  // exist for the rest of collection.
  const realRows = sNames.length
  let avi = 0
  while avi < uVariants.length {
    armRefRowEnsure(avi, realRows)
    avi = avi + 1
  }
  // Every arm adopts the row its fields are; from here the variant field columns name the struct
  // rows' lists, and an arm created later adopts its row as it is minted.
  let adi = 0
  while adi < uVariants.length {
    if armAdopt(adi, realRows) < 0 { return -1 }
    adi = adi + 1
  }
  armAdoptFinish()
  0
}

// ── union collection (G1) ─────────────────────────────────────────────────────
// Parse the inline-shape variant `nm` (`{x:i32,y:string}`) into the flat
// union-variant field tables — the variant-table twin of `collectAnnShapes`'s
// field split (same depth-aware `,`/`:` grammar).
function collectShapeVariantFields(nm: string, shapeTy: i32) {
  const fnames: string[] = []
  const ftexts: string[] = []
  // The group-interior cut at its home (`tyname.groupInnerOf`, W1). The guard is the
  // caller's — `collectVariantFields` gates on `nameIsShapeSpanEnds`.
  shapeInnerFieldSplit(groupInnerOf(nm), fnames, ftexts)
  uFieldStart.push(armStageNames.length)
  // D622 — the canonical field order, needed here too: cross-table twin tests compare codes
  // positionally, so a declaration-order arm can merge into a canonical twin's opposite slots.
  const cOrd = fieldNameOrder(fnames)
  let cnt = 0
  let fx = 0
  while fx < fnames.length {
    const fi = cOrd[fx]
    if fnames[fi] == "" {
      return emitFail("emitProgram: malformed inline union-variant shape")
    }
    const ftxt = ftexts[fi]
    // The arena rung, where the shape's own type supplies the field's recorded type; the length
    // guard keeps the correspondence legitimate — a count mismatch means `fi` is not the same field.
    let fldTy = -1
    if shapeTy >= 0 {
      const shp = tyAt(shapeTy)
      if shp is TyObj {
        if shp.objFieldTypes.length == ftexts.length {
          fldTy = shp.objFieldTypes[fi]
        }
      }
    }
    const fc = nameFieldCodeTy(ftxt, fldTy)
    if fc < 0 {
      // D1518 — `fieldTypeRefusalMsg`'s sentence, one table over: what reaches here is an
      // arm-typed field whose arm has no cross-table heap twin.
      return emitFail(fieldTypeRefusalMsg(ftxt, fldTy))
    }
    // `pushFieldRow`'s variant-table row; this recorder derives the elem name from the field's
    // type text (no `FieldDef` node exists here), and has no `sFieldCloSig` twin, hence the "" tail.
    pushFieldRow(
      true,
      fc,
      shapeFieldElemName(ftxt, fc, fldTy),
      tyMapKeyKindSpan(fldTy),
      fnames[fi],
      variantFieldIdText(ftxt, fldTy),
      fieldElemHintOfRow(fldTy, fldTy, fc),
      fldTy,
      "",
    )
    cnt = cnt + 1
    fx = fx + 1
  }
  uFieldCount.push(cnt)
  0
}

// Whether field type node `ft` names a record declared among `stmts` (or its `| null`): the
// declaration its non-null type is first declared by.
function fieldNamesDeclRecord(stmts: i32[], ft: i32): boolean {
  const dn = structNameOfTy(nonNullTy(nodeTyIxOf(ft)))
  dn != "" && declStructNodeOf(stmts, dn) >= 0
}

// Record the field names + per-field wasm-type codes of the `TypeDecl` named `name` into the
// flat `armFieldNames`/`uFieldStart`/`uFieldCount`/`armFieldTypes` table (declaration order = wasm
// field index). The struct must exist among the top-level statements and every field must
// carry a code, else fails loudly. Returns 0, or -1 (via `emitFail`).
function collectVariantFields(stmts: i32[], name: string, ty: i32) {
  // An inline-shape variant (`{x:i32}` inside `{x:i32}|{y:i32}`) carries its
  // fields in its own text — parse them (the annotation-shape field grammar)
  // instead of looking for a TypeDecl. `ty` is the arm's own type, whose literal fields the
  // text spells as their base.
  if nameIsShapeSpanEnds(name) { return collectShapeVariantFields(name, ty) }
  // The declaration this variant names, from the index `collectU` built — the forward scan
  // this replaces took the FIRST `TypeDecl` spelling `name` and the index records the same
  // one. A miss is the refusal at the tail, reached the same way an exhausted scan reached it.
  const dsIx = declStructNodeOf(stmts, name)
  if dsIx >= 0 {
    const s = nodeAt(dsIx)
    if s is TypeDecl {
      if s.tdName == name {
        uFieldStart.push(armStageNames.length)
        const fields0 = s.tdFields
        // D622 — the canonical field order: cross-table twin tests compare field codes
        // positionally, so an arm and its declared struct twin must agree on the sequence.
        const fields: i32[] = []
        const vnames: string[] = []
        let vp = 0
        while vp < fields0.length {
          const vpn = nodeAt(fields0[vp])
          if vpn is FieldDef { vnames.push(vpn.fdName) }
          vp = vp + 1
        }
        if s.tdFlat == 0 && vnames.length == fields0.length {
          const vOrd = fieldNameOrder(vnames)
          let vq = 0
          while vq < vOrd.length {
            fields.push(fields0[vOrd[vq]])
            vq = vq + 1
          }
        } else {
          let vr = 0
          while vr < fields0.length {
            fields.push(fields0[vr])
            vr = vr + 1
          }
        }
        let cnt = 0
        let fi = 0
        while fi < fields.length {
          const fnode = nodeAt(fields[fi])
          if fnode is FieldDef {
            const ftxt = tyNameOf(fnode.fdType)
            const typeCode = nameFieldCodeTy(
              ftxt,
              recFieldTyOf(ty, fnode.fdName),
            )
            let code = typeCode
            // A field naming a declared record, the arm itself included, waits the same way: the
            // record has no row until `collectS` runs (D3329).
            if code < 0 && fieldNamesDeclRecord(stmts, fnode.fdType) {
              code = FC_STRUCT
            }
            if code < 0 {
              // The shape-text recorder's sentence, from the field's own node so the reader is pointed
              // at the field and not at the union (D1519's anchor).
              return emitFailAt(
                fieldTypeRefusalMsg(ftxt, recFieldTyOf(ty, fnode.fdName)),
                fields[fi],
              )
            }
            // The struct twin's ladder, except when the -1→15 fallback fired: then the name comes from
            // the field's type text (`shapeFieldElemName`), which `fieldRefElemName` cannot re-derive.
            let elemNm = shapeFieldElemName(ftxt, code, fdRowOf(fnode.fdType))
            if typeCode >= 0 { elemNm = fieldRecElemName(fnode.fdType, code) }
            // The variant table has no `sFieldCloSig` twin, so the trailing column is "".
            pushFieldRow(
              true,
              code,
              elemNm,
              nodeTyMapKeyKindSpan(fnode.fdType),
              fnode.fdName,
              variantFieldIdText(ftxt, nodeTyIxOf(fnode.fdType)),
              fieldElemHintOf(fnode.fdType, code, elemNm),
              nodeTyIxOf(fnode.fdType),
              "",
            )
            // `fnode` is still in scope here, so the arena node is passed directly rather
            // than re-deriving it from `ftxt`'s string form.
            cnt = cnt + 1
          } else {
            return emitFail("emitProgram: malformed union-variant field")
          }
          fi = fi + 1
        }
        uFieldCount.push(cnt)
        return 0
      }
    }
  }
  emitFail("emitProgram: union variant names an unknown struct type")
}

// Whether field `fi` of variants `a` and `b` holds one shape under two record names (`R`, `S` =
// `{r: i32}`), directly or as a list element, map key or value, or nullable inner (D15150).
function variantRecordFieldsOneRow(a: i32, b: i32, fi: i32): boolean {
  if a >= uVarTyIx.length || b >= uVarTyIx.length { return false }
  const fnm = armFieldNames()[uFieldStart[a] + fi]
  recordShapesOneRow(
    recFieldTyOf(uVarTyIx[a], fnm),
    recFieldTyOf(uVarTyIx[b], fnm),
    0,
  )
}

// Whether `ta` and `tb` are one shape whose records, at every leaf, share a record-row class.
function recordShapesOneRow(ta: i32, tb: i32, depth: i32): boolean {
  if ta < 0 || tb < 0 || depth > 16 { return false }
  const ca = recordRowClassOf(ta)
  if ca != "" { return ca == recordRowClassOf(tb) }
  const na = tyAt(ta)
  const nb = tyAt(tb)
  match na {
    TyNullable => {
      if !(nb is TyNullable) { return false }
      return recordShapesOneRow(na.nInner, nb.nInner, depth + 1)
    }
    TyArray => {
      if !(nb is TyArray) || na.aRead != nb.aRead { return false }
      return recordShapesOneRow(na.aElem, nb.aElem, depth + 1)
    }
    TyMap => {
      if !(nb is TyMap) || na.mSet != nb.mSet { return false }
      const keyOne = na.mKey == nb.mKey
        || recordShapesOneRow(na.mKey, nb.mKey, depth + 1)
      return keyOne && recordShapesOneRow(na.mVal, nb.mVal, depth + 1)
    }
    TyPrim | TyErr | TyObj | TyFunc | TyUnion | TyVar | TyLit | TyNeg => {
      // No record inside, or a record or union `recordRowClassOf` already answered.
      return false
    }
  }
}

// True if variants `a` and `b` are the same type per field — the field-type half of variant
// identity (`variantSig` is the name half); `assignTags`'s exemption depends on this being
// identity, not storage: `{a: i32}` and `{a: boolean}` share a wasm code but are different
// types, so the `armFieldTyText` spelling column, not just the code, decides.
function variantFieldTysEq(a: i32, b: i32) {
  if uFieldCount[a] != uFieldCount[b] { return false }
  let fi = 0
  while fi < uFieldCount[a] {
    if !armRowsStoreAlike(uFieldStart[a] + fi, uFieldStart[b] + fi) {
      return false
    }
    if !variantRecordFieldsOneRow(a, b, fi) {
      if (
        armFieldTyText()[uFieldStart[a] + fi]
        != armFieldTyText()[uFieldStart[b] + fi]
      ) {
        return false
      }
      if !armFieldElemSame(uFieldStart[a] + fi, uFieldStart[b] + fi) {
        return false
      }
    }
    // B6b — the map field's key half: the elem-name column above records only `V`, so two
    // differently-keyed maps compare equal there; this column catches it.
    if uFieldElemKeyKindAt(a, fi) != uFieldElemKeyKindAt(b, fi) { return false }
    // A `Set<K>` field and a `{[K]: boolean}` field spell one index signature; the arena's set
    // flag is what tells them apart (D2493).
    const fnm = armFieldNames()[uFieldStart[a] + fi]
    if variantFieldSetFlag(a, fnm) != variantFieldSetFlag(b, fnm) {
      return false
    }
    fi = fi + 1
  }
  true
}

// D1050 — lays a mixed-spelling discriminated pair out under one rep: each field goes to
// the rep its arms can both hold — two sets meet on the atom (cheap, all consumers already
// built), a set beside its base meets on the string (an arbitrary string has no interned id).
// Two rows move per field either way: the variant row casts through, the struct row builds everywhere else.
function unifyMixedLitRepArms(): i32 {
  if !uDeclared { return 0 }
  let ui = 0
  while ui < unVarStart.length {
    const vs0 = unVarStart[ui]
    const vc = unVarCount[ui]
    let a = 0
    while a < vc {
      let b = a + 1
      while b < vc {
        const va = vs0 + a
        const vb = vs0 + b
        // Only a same-sig pair shares a layout. Under one tag key it is the gate `assignTags`
        // admits on, asked again rather than banked; under two, any literal field is re-laid.
        const sameSig = variantSig(va) == variantSig(vb)
        if sameSig && variantTagKey(va) != variantTagKey(vb) {
          if reLayLitFieldsByName(va, vb) < 0 { return -1 }
        } else if sameSig && variantLitRepUnifiable(va, vb) {
          let fi = 0
          while fi < uFieldCount[va] {
            if variantFieldLitRepMixed(va, vb, fi) {
              if promoteLitFieldToAtom(va, fi) < 0 { return -1 }
              if promoteLitFieldToAtom(vb, fi) < 0 { return -1 }
            } else if variantFieldLitRepStrMixed(va, vb, fi) {
              // The demotion is a sink (the base arm is already a string), so a three-arm mix of an
              // alias, an inline set and the base converges on the string rep regardless of visit order.
              if demoteLitFieldToString(va, fi) < 0 { return -1 }
              if demoteLitFieldToString(vb, fi) < 0 { return -1 }
            }
            fi = fi + 1
          }
        }
        b = b + 1
      }
      a = a + 1
    }
    ui = ui + 1
  }
  0
}

// Two same-named arms under different tags share a field's rep wherever a literal set meets
// another set or its plain `string` base, so a read that spans both arms has one storage to read.
function reLayLitFieldsByName(va: i32, vb: i32): i32 {
  let fi = 0
  while fi < uFieldCount[va] {
    const ra = uFieldStart[va] + fi
    const fj = variantFieldIndex(vb, armStageNames[ra])
    if fj >= 0 {
      const rb = uFieldStart[vb] + fj
      if armStageTypes[ra] != armStageTypes[rb] {
        if litFieldRowIsAtomisable(ra) && litFieldRowIsAtomisable(rb) {
          if promoteLitFieldToAtom(va, fi) < 0 { return -1 }
          if promoteLitFieldToAtom(vb, fj) < 0 { return -1 }
        }
      }
    }
    fi = fi + 1
  }
  0
}

// The elem-name column's answer for an atom-repped literal set. `litUnionInlineNameOfTy` has
// no answer below two members (`nameIsInlineLitUnion` wants two atoms), so a one-member set's
// quoted lexeme stands in as the row's name, and the sidecar (D1460) is what classifiers
// actually read.
function litSetAtomNameOfTy(lty: i32): string {
  const nm = litUnionInlineNameOfTy(lty)
  if nm != "" { return nm }
  const texts = tyLitMemberTexts(lty)
  if texts.length != 1 { return "" }
  const al = litUnionAliasOfLitTexts(texts)
  if al != "" { return al }
  "\"" + texts[0] + "\""
}

// Re-lays variant `vi`'s field `fi` — a string literal set — under the interned-atom rep, in
// both tables; a row already at code 0 (the alias arm) is untouched, so the pass is idempotent.
// The arena sidecar must move with the code, since `variantFieldIsLitUnion`/`sFieldIsLitUnion`
// read it to tell an interned atom from a plain i32 — its type comes from `armFieldLitTyIx`.
function promoteLitFieldToAtom(vi: i32, fi: i32): i32 {
  const r = uFieldStart[vi] + fi
  const lty = armStageLitTyIx[r]
  if lty < 0 { return 0 }
  const nm = litSetAtomNameOfTy(lty)
  if nm == "" { return 0 }
  if armStageTypes[r] != FC_I32 {
    armStageTypes[r] = FC_I32
    armStageElemName[r] = nm
    uFieldReLayNote()
    setUFieldElemRowTy(r, lty)
  }
  // The struct row sharing the arm's heap type, whose layout must move with the arm's.
  const si = variantStructHeapTwinAt(vi)
  if si >= 0 && fi < sFieldCount[si] {
    const sr = sFieldStart[si] + fi
    if sFieldTypes[sr] != FC_I32 {
      sFieldTypes[sr] = FC_I32
      sFieldElemName[sr] = nm
      tyRegNoteWrite()
      setSFieldElemRowTy(sr, lty)
    }
  }
  0
}

// Re-lays variant `vi`'s field `fi` — an atom-repped string literal set — under the string
// rep, in both tables; a row already at code 3 is untouched, so idempotent. The row lands
// exactly where a declared inline set's row already is, so no consumer needs a new arm:
// `emitDiscrimFieldEq`'s code-3 arm and `strReppedLitUnionAt` already handle it (D1460).
function demoteLitFieldToString(vi: i32, fi: i32): i32 {
  const r = uFieldStart[vi] + fi
  const lty = armStageLitTyIx[r]
  if lty < 0 { return 0 }
  const nm = litUnionInlineNameOfTy(lty)
  if armStageTypes[r] != FC_STR {
    armStageTypes[r] = FC_STR
    armStageElemName[r] = nm
    storeTyPut(armStageStoreTy, r, TY_STR)
    uFieldReLayNote()
    setUFieldElemRowTy(r, lty)
  }
  const si = variantStructHeapTwinAt(vi)
  if si >= 0 && fi < sFieldCount[si] {
    const sr = sFieldStart[si] + fi
    if sFieldTypes[sr] != FC_STR {
      sFieldTypes[sr] = FC_STR
      sFieldElemName[sr] = nm
      storeTyPut(sFieldStoreTy, sr, TY_STR)
      tyRegNoteWrite()
      setSFieldElemRowTy(sr, lty)
    }
  }
  // Every other struct row of the arm's layout family, and each one minted later, stores the
  // field at the string too (D14752).
  famRelayField(uVarTyIx[vi], armStageNames[r], lty)
  0
}

// Assign each variant its GLOBAL tag = its rank when the variants are ordered by tag key
// (`variantTagKey`: the field-name signature, split where same-named fields hold no common
// layout). `uTags[i]` is the number of distinct keys sorting strictly before variant i's.
export function assignTags() {
  // A swallowed `emitFail` can leave the variant row tables half-written, so ranking would read
  // past their end and trap the compiler; bail on the flag instead so the message reaches the user.
  if emitFailed { return -1 }
  // The signatures, computed once (the rank loop below reads each O(n) times, and a
  // variant-heavy union — the compiler's own `Node` — has dozens of them).
  const sigs: string[] = []
  let si = 0
  while si < uVariants.length {
    sigs.push(variantTagKey(si))
    si = si + 1
  }
  // Two members sharing a tag key are layout-equal, or D1023's `variantLitDiscriminable` admits a
  // same-storage literal-set difference.
  let ui = 0
  while ui < unVarStart.length {
    const vs0 = unVarStart[ui]
    const vc = unVarCount[ui]
    let a = 0
    while a < vc {
      let b = a + 1
      while b < vc {
        if sigs[vs0 + a] == sigs[vs0 + b] {
          // D1050 — the third admission is the pair the atom unification will fix later, in
          // `unifyMixedLitRepArms` at the end of `collectS`, once both tables exist.
          if (
            !variantFieldTysEq(vs0 + a, vs0 + b)
            && !variantLitDiscriminable(vs0 + a, vs0 + b)
            && !variantLitRepUnifiable(vs0 + a, vs0 + b)
          ) {
            // D1461 — two refusals; only the design one (arms nothing tells apart) still describes a
            // real program. The other is an unreachable floor, since every mixed literal is re-laid.
            if variantLitRepMismatch(vs0 + a, vs0 + b) {
              return emitFail(
                "emitProgram: assignTags: union `"
                  + unNames[ui]
                  + "` gives `"
                  + uVariants[vs0 + a]
                  + "` and `"
                  + uVariants[vs0 + b]
                  + "` one tag while their literal discriminant at field `"
                  + variantFirstLayoutDisagreeField(vs0 + a, vs0 + b)
                  + "` is laid out two ways — `unifyMixedLitRepArms` re-lays a mixed pair onto one rep and did not reach this one, so this is a compiler bug rather than something to change in the program",
              )
            }
            return emitFailAt(
              "emitProgram: union `"
                + unNames[ui]
                + "` cannot be discriminated — variants `"
                + uVariants[vs0 + a]
                + "` and `"
                + uVariants[vs0 + b]
                + "` have the same field names but different field types",
              if ui < unDeclIx.length { unDeclIx[ui] } else { -1 },
            )
          }
        }
        b = b + 1
      }
      a = a + 1
    }
    ui = ui + 1
  }
  // The tag of a variant is how many signatures sort strictly below its own, so equal
  // signatures share a tag. Sorted, that count is the position at which the run of equal
  // signatures begins: everything before it is strictly smaller and nothing after it is.
  uTags = []
  const ord: i32[] = []
  let i = 0
  while i < uVariants.length {
    uTags.push(0)
    ord.push(i)
    i = i + 1
  }
  sigRankOrder(sigs, ord)
  let p = 0
  while p < ord.length {
    let q = p
    while q < ord.length && sigs[ord[q]] == sigs[ord[p]] { q = q + 1 }
    let t = p
    while t < q {
      uTags[ord[t]] = p + relSkew(RS_TAG)
      t = t + 1
    }
    p = q
  }
  0
}

// Orders `ord` — indices into `keys` — by `strLess` on the key it names, bottom-up so the
// merge depth is a loop and not a recursion. Ties keep no promised order, which the ranking
// above does not depend on: two variants with the same signature take the same tag.
function sigRankOrder(keys: string[], ord: i32[]) {
  const n = ord.length
  const buf: i32[] = []
  let z = 0
  while z < n {
    buf.push(0)
    z = z + 1
  }
  let width = 1
  while width < n {
    let lo = 0
    while lo < n {
      let mid = lo + width
      if mid > n { mid = n }
      let hi = lo + width + width
      if hi > n { hi = n }
      let a = lo
      let b = mid
      let k = lo
      while k < hi {
        // The left run wins a tie, so an equal pair keeps its earlier index first; the merge
        // takes from the right only when the left is spent or the right key is strictly less.
        let fromLeft = a < mid
        if fromLeft && b < hi {
          fromLeft = !strLess(keys[ord[b]], keys[ord[a]])
        }
        if fromLeft {
          buf[k] = ord[a]
          a = a + 1
        } else {
          buf[k] = ord[b]
          b = b + 1
        }
        k = k + 1
      }
      lo = hi
    }
    let c = 0
    while c < n {
      ord[c] = buf[c]
      c = c + 1
    }
    width = width + width
  }
  0
}

// Registers the value union of map type `mapTy`. Returns -2 when `mapTy` is not a map with a
// value type, else 0 or -1.
function registerMapValUnion(stmts: i32[], mapTy: i32): i32 {
  const vt = tyMapValOf(mapTy)
  if vt < 0 { return -2 }
  registerInlineUnionOfChild(stmts, vt, 29)
}

// Registers the inline union synthetic name `name` (e.g. `"A|B"`), the render of arena type
// `sty` or -1, as a union alias, exactly as `collectU` registers a `UnionDecl`; the subtypes of
// `sty` register theirs. A no-op if `name` is already registered or is not an inline
// struct-variant union. Returns 0, or -1 (via `emitFail`).
export function registerInlineUnionOfTy(stmts: i32[], name: string, sty: i32) {
  registerInlineUnionAt(stmts, name, 46, sty, sty)
}

// Told which call site it is (`site`), the identity that site offers (`ty`, an arena type or
// -1; a cut substring offers none, `docs/internals/registry-by-type-id.md` §5 step 4b), and the
// type `name` is a render of (`sty`, or -1), which each recursion steps to its cut's subtype so
// the atoms are read off the type rather than split from the spelling.
function registerInlineUnionAt(
  stmts: i32[],
  name: string,
  site: i32,
  ty: i32,
  sty: i32,
) {
  const r = registerInlineUnionGo(stmts, name, site, ty, sty)
  // A watched untyped recursion offers its stepped type to the type-key shadow.
  const tag = unTyKeySiteTag(site)
  if tag > 0 { unTyKeyShadow(tag, name, sty) }
  r
}

// `registerInlineUnionAt`'s dispatch.
function registerInlineUnionGo(
  stmts: i32[],
  name: string,
  site: i32,
  ty: i32,
  sty: i32,
) {
  // A spelling that names a row skips the mint, and so does one whose type keys to a row.
  if sty >= 0 && unRowOfTyKey(sty) >= 0 && unNameAdoptTyKeyRow(name, sty) {
    return 0
  }
  if isUNameKeyAB(site, name, ty) && unNameAdoptTyKeyRow(name, ty) { return 0 }
  // A value union (`i32 | null`, `i32 | f64`) registers the name alone: its members are scalar
  // atoms riding shared value boxes, so it owns no variant structs and its slice is empty.
  if isValueUnionTyOr(sty) == 1 || riuValueOfBases(sty) {
    return registerValueUnionOfTy(55, sty)
  }
  // A map member of a 2+-member union rides the variant box, registered via `isVariantBoxUnion`
  // below and returned early, or the map-value recursion further down would swallow the name.
  const mtys: i32[] = []
  riuMemberTys(sty, mtys)
  if mtys.length >= 2 {
    if registerInlineUnionMembers(stmts, mtys) < 0 { return -1 }
  }
  // A collection, a `| null`, a closure or an inline shape registers the unions its subtypes
  // hold, read off `sty`; a name with no type registers only itself.
  if sty >= 0 && sty < T.tys.length {
    const cr = registerInlineUnionChildOf(stmts, sty)
    if cr != -2 { return cr }
  }
  // An inline struct-shape annotation's unions live in its fields, interned before this call by
  // `collectTyReachRegister`'s structural walk — a single shape has none to register here.
  if sty >= 0 && tyAt(sty) is TyObj { return 0 }
  // `mtys` is still the read above: nothing between there and here rewrites `sty`.
  if !isVariantBoxUnionTys(mtys) { return 0 }
  // The row records the arena type its registrar holds, never a re-parse of its spelling.
  if ty < 0 {
    return emitFail(
      "emitProgram: inline union row has no arena type at registrar site "
        + i32ToStr(site),
    )
  }
  mintInlineUnion(stmts, name, ty)
}

// Registers the `<scalar> | null` box a nullable of type `ty` reads as, as A/B site `site`: from
// the type where its inner is a primitive, else under `name`, its rep's spelling. A non-primitive
// inner is a function-value set's id, and a function-value-set row has no element type: it is
// keyed by its set.
function registerNulScalarBox(site: i32, name: string, ty: i32): i32 {
  const rt = nulNumScalarUnionRowTy(ty)
  if rt >= 0 { return registerValueUnionOfTy(site, rt) }
  registerValueUnionNameAB(site, name, -1)
}

// Whether arena type `ty` is a union or a `| null`: the element or result a collection or a
// closure registers as a union of its own.
function tyIsUnionOrNullable(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  if t is TyUnion { return true }
  t is TyNullable
}

// The subtypes `registerInlineUnionOfChild` is descending through, innermost last.
const riuOpenTys: i32[] = []

// Registers the union of subtype `cty`, named by its emitter render, as call site `site`. A
// recursive type reaching itself again registers nothing more. Returns 0, or -1 once failed.
function registerInlineUnionOfChild(stmts: i32[], cty: i32, site: i32): i32 {
  if i32ListHas(riuOpenTys, cty) { return 0 }
  const nm = arenaEmitName(cty)
  if nm == "" { return 0 }
  riuOpenTys.push(cty)
  const r = registerInlineUnionAt(stmts, nm, site, cty, cty)
  riuOpenTys.pop()
  r
}

// `registerInlineUnionGo`'s descent into the subtypes of `sty`: a list's union element or
// nested list, a nullable list, map or closure, a map's value and a function's result. Returns
// -2 when `sty` holds none of them and the union itself decides, else 0 or -1.
function registerInlineUnionChildOf(stmts: i32[], sty: i32): i32 {
  const t = tyAt(sty)
  if t is TyArray {
    if tyIsUnionOrNullable(t.aElem) {
      return registerInlineUnionOfChild(stmts, t.aElem, 31)
    }
    if tyStepElem(t.aElem) >= 0 {
      return registerInlineUnionOfChild(stmts, t.aElem, 37)
    }
    // A list of inline shapes registers its field unions in `collectTyReachRegister`'s walk.
    return 0
  }
  if t is TyNullable {
    // The `| null` is owned by the nullable machinery; the inner list, map or closure still
    // registers the unions it holds, and an inner union falls to the box below.
    const it = t.nInner
    if it < 0 { return -2 }
    const inn = tyAt(it)
    if inn is TyArray { return registerInlineUnionOfChild(stmts, it, 32) }
    if inn is TyObj { return 0 }
    if inn is TyMap { return registerMapValUnion(stmts, it) }
    if inn is TyFunc { return registerCloResultUnion(stmts, inn.fnRet) }
    return -2
  }
  if t is TyMap { return registerMapValUnion(stmts, sty) }
  if t is TyFunc {
    // A function type's result union registers so a value call's result narrows.
    if t.fnRet < 0 { return -2 }
    return registerInlineUnionOfChild(stmts, t.fnRet, 39)
  }
  if t is TyObj { return 0 }
  tyHoldsNoChildUnion()
}

// The named default of `registerInlineUnionChildOf`: -2. A union, a primitive, a literal, a
// type variable or the error hole holds no subtype union of its own here; the union decides.
function tyHoldsNoChildUnion(): i32 { -2 }

// Whether `ty` is a union whose first member is a map, `| null` counted as a member: a variant
// box, never a bare map. -1 answers false.
function tyIsMapMemberUnion(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const inner = tyPeelNul(ty)
  if inner != ty { return tyLeadsWithMap(inner) }
  const t = tyAt(ty)
  if t is TyUnion {
    if t.uMembers.length == 1 { return tyIsMapMemberUnion(t.uMembers[0]) }
    return t.uMembers.length >= 2 && tyLeadsWithMap(t.uMembers[0])
  }
  false
}

// Whether `ty` is a map, or a union (or `| null`) whose first member leads with one.
function tyLeadsWithMap(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const inner = tyPeelNul(ty)
  if inner != ty { return tyLeadsWithMap(inner) }
  const t = tyAt(ty)
  if t is TyUnion {
    return t.uMembers.length > 0 && tyLeadsWithMap(t.uMembers[0])
  }
  tyIsMap(ty)
}

// A nullable closure's result `rt`: a list's element union, a map's value union, and a value,
// map-member or variant-box union register; any other composite result stays loud, since it
// would mis-lower. Returns -2 when none applies, else 0 or -1.
function registerCloResultUnion(stmts: i32[], rt: i32): i32 {
  if rt < 0 || rt >= T.tys.length { return -2 }
  const r = tyAt(rt)
  if r is TyMap { return registerMapValUnion(stmts, rt) }
  if r is TyArray { return registerInlineUnionOfChild(stmts, rt, 36) }
  const res = arenaEmitName(rt)
  if res == "" { return -2 }
  if isValueUnionName(res) || tyIsMapMemberUnion(rt) {
    return registerInlineUnionAt(stmts, res, 34, rt, rt)
  }
  // A variant-box union result: the contextual pin covers it once registered, so the
  // annotated named-fn path lowers it; an arm the box still rejects stays loud.
  const rm: i32[] = []
  riuMemberTys(rt, rm)
  if isVariantBoxUnionTys(rm) {
    return registerInlineUnionAt(stmts, res, 35, rt, rt)
  }
  -2
}

// `registerInlineUnionAt`'s pass over the members `mtys` of a union of two or more: refuses a
// map member beside another non-null member that cannot box, and registers each list member's
// element union and each map member's value union. Returns 0, or -1 (via `emitFail`).
function registerInlineUnionMembers(stmts: i32[], mtys: i32[]): i32 {
  let nonNull = 0
  let hasMap = false
  for m in mtys {
    if m >= 0 {
      nonNull = nonNull + 1
      if riuMemberHoldsMap(m) { hasMap = true }
    }
  }
  // A single map + `null` is the nullable map, which the nullable machinery owns; only a map
  // beside another non-null member is the box shape this refuses when it cannot box.
  if hasMap && nonNull >= 2 && !isVariantBoxUnionTys(mtys) {
    return emitFail(
      "emitProgram: a map union member is not supported — use a struct member instead",
    )
  }
  for m in mtys {
    if m >= 0 { registerAtomSubUnion(stmts, m) }
  }
  0
}

// The members of union type `sty` as the registry records them (`canonUnionMembersInto`: nested
// unions flattened, numeric literals at their base, equal members once); `null` is -1. A declared
// union alias's own type is one member, as its declaration registers it. Empty where `sty` is -1
// or has no canonical members.
function riuMemberTys(sty: i32, out: i32[]) {
  if sty < 0 { return 0 }
  if unionAliasDeclNameOfTy(sty) != "" {
    out.push(sty)
    return 0
  }
  const atoms: string[] = []
  if !canonUnionMembersInto(sty, out, atoms) {
    while out.length > 0 { out.pop() }
  }
  0
}

// Whether member type `m` is a map, or a list whose elements are maps at some depth: a member
// whose map value union is registered apart from the box's own map arm.
// Appends the members of union type `ty` with nested unions flattened and a nullable's `null` as
// -1; false past a depth.
function riuFlatMembers(ty: i32, out: i32[], depth: i32): boolean {
  if depth <= 0 || ty < 0 { return false }
  const t = tyAt(ty)
  if t is TyNullable {
    out.push(-1)
    return riuFlatMembers(t.nInner, out, depth - 1)
  }
  if t is TyUnion {
    for m in t.uMembers {
      if m < 0 { out.push(-1) }
      else if !riuFlatMembers(m, out, depth - 1) { return false }
    }
    return true
  }
  if isNullTy(ty) { out.push(-1) } else { out.push(ty) }
  true
}

// The base a literal member `m` boxes at (`litBaseTy`), or for a list whose elements are all
// literals of one base, that base's list, keyed apart (`-2 - base`); -1 for any other member.
function riuLitBaseKey(m: i32): i32 {
  const t = tyAt(m)
  if t is TyLit {
    if t.litKind != "str" && t.litKind != "int" { return -1 }
    return litBaseTy(t)
  }
  if t is TyArray {
    const flat: i32[] = []
    if !riuFlatMembers(t.aElem, flat, 8) { return -1 }
    let b = -1
    for e in flat {
      if e < 0 { return -1 }
      const et = tyAt(e)
      if !(et is TyLit) || (et.litKind != "str" && et.litKind != "int") {
        return -1
      }
      const eb = litBaseTy(et)
      if b >= 0 && eb != b { return -1 }
      b = eb
    }
    if b < 0 { return -1 }
    return -2 - b
  }
  memberIsNoLiteralBase()
}

// The named default of `riuLitBaseKey`: -1. Every other member (a scalar, a record, a map, a
// function, a nullable, a type parameter) is not a literal, so the union is not one of literals.
function memberIsNoLiteralBase(): i32 { -1 }

// Whether union type `sty`, every non-null member a string or integer literal, is a value union
// once each literal is its base (`litBaseTy`): two or more bases, or one numeric base beside
// `null`. False for any other union.
function riuValueOfBases(sty: i32): boolean {
  const flat: i32[] = []
  if !riuFlatMembers(sty, flat, 8) { return false }
  const bases: i32[] = []
  let hasNull = false
  for m in flat {
    if m < 0 {
      hasNull = true
    } else {
      const b = riuLitBaseKey(m)
      if b == -1 { return false }
      if !i32ListHas(bases, b) { bases.push(b) }
    }
  }
  if bases.length >= 2 { return true }
  bases.length == 1 && hasNull && bases[0] != TY_STR
}

// Whether member type `m` is a map, or a list whose elements are maps at some depth: a member
// whose map value union is registered apart from the box's own map arm.
function riuMemberHoldsMap(m: i32): boolean {
  if m < 0 { return false }
  if tyMapHeld(m) >= 0 { return true }
  const t = tyAt(tyPeelNul(m))
  if t is TyArray { return riuMemberHoldsMap(t.aElem) }
  false
}

// Whether the members `tys` (`riuMemberTys`) box as a variant-box union: two or more non-null
// members, each a record, a value atom, a map or a list, with at least one that is not a value
// atom.
function isVariantBoxUnionTys(tys: i32[]): boolean {
  let refs = 0
  let nonNull = 0
  for m in tys {
    if m >= 0 {
      nonNull = nonNull + 1
      if tyAt(m) is TyObj {
        refs = refs + 1
      } else if boxTagOfTy(m) < 0 && !tyIsLitUnion(m) {
        // Not a value atom, which rides a shared value box: a map or a list is a ref arm.
        if tyMapHeld(m) < 0 && !(tyAt(tyPeelNul(m)) is TyArray) { return false }
        refs = refs + 1
      }
    }
  }
  refs >= 1 && nonNull >= 2
}

// Registers the union a union atom of type `at` holds: a ref-array atom's element union, and a
// map atom's value union, a separate rep from the map arm (registered via `isVariantBoxUnion`).
function registerAtomSubUnion(stmts: i32[], at: i32): i32 {
  const att = tyAt(at)
  if att is TyArray { return registerInlineUnionOfChild(stmts, at, 30) }
  if att is TyMap { return registerMapValUnion(stmts, at) }
  atomHoldsNoSubUnion()
}

// The named default of `registerAtomSubUnion`: 0. Any other atom is a scalar, a record, a
// closure or a union that the outer union's own registration reaches.
function atomHoldsNoSubUnion(): i32 { 0 }

// `registerInlineUnionAt`'s mint: records `name` as a union row of arena type `ty`, its struct
// variants and their fields, and the value, ref-array and map arms' shapes. Returns 0, or -1
// once failed.
function mintInlineUnion(stmts: i32[], name: string, ty: i32): i32 {
  // The arms' field unions must already be registered before this point — an interleaved
  // registration would corrupt this union's variant slice — which the arena-driven walk guarantees.
  uDeclared = true
  unNamesPush(name)
  const mintTyIx = ty
  unTyIx.push(mintTyIx)
  unDeclIx.push(-1) // inline union: no declaration node
  unMemberSet.push(name)
  recordUnMemTys(name) // D-UNION foundation
  unTyKeyPushRow()
  // The member list below is the row just recorded, not a second split of `name`:
  // `recordUnMemTys` already split it once, so this just reads the tail it appended.
  const atoms: string[] = []
  // Snapshotted in the same loop as the spellings, since the recursive registration below can
  // append to (or self-heal reset) the columns this reads from.
  const atomTys: i32[] = []
  const uRow = unNames.length - 1
  const uMemN = unMemTyCount[uRow]
  const uMemBase = unMemAtoms.length - uMemN
  let uMemI = 0
  while uMemI < uMemN {
    atoms.push(unMemAtoms[uMemBase + uMemI])
    atomTys.push(unMemTys[uMemBase + uMemI])
    uMemI = uMemI + 1
  }
  const atomPos: i32[] = []
  while atomPos.length < atoms.length { atomPos.push(atomPos.length) }
  if mintVariantRows(stmts, atoms, atomTys, atomPos) < 0 { return -1 }
  // A mixed union's scalar members box like a value union's — interns their per-rep value
  // boxes (a no-op for an all-struct union).
  markValueUnionAtoms(mintTyIx)
  // A ref-array arm interns its element shape and reflist slot, the twin of the value-atom
  // marking above; this early call ensures the element struct is in `sNames` before heap assignment.
  markRefArrayArms(name, mintTyIx)
  if registerRefArrayArmUnions(stmts, atoms, atomTys) < 0 { return -1 }
  // A map arm interns its value shape and forces the shared map heap flags, the map twin of
  // the ref-array marking; this keeps the inline and named spellings identical.
  markMapUnionArms(name, mintTyIx)
  0
}

// `mintInlineUnion`'s ref-array arms: an arm whose element is itself a union of two or more
// registers that inner union, `atomTys[i]` being atom `i`'s arena row. Returns 0, or -1 once failed.
function registerRefArrayArmUnions(
  stmts: i32[],
  atoms: string[],
  atomTys: i32[],
): i32 {
  // A list arm whose element is itself a union registers that inner union too, the
  // arm-position twin of the whole-type list-element recursion above.
  let rai = 0
  while rai < atoms.length && rai < atomTys.length {
    const el = tyStepElem(atomTys[rai])
    if (el >= 0 && tyIsUnionOrNullable(el) && valueAtomKind(atoms[rai]) < 0) {
      if registerInlineUnionOfChild(stmts, el, 40) < 0 { return -1 }
    }
    rai = rai + 1
  }
  0
}

// ── usage-driven `let x = null` nullable-hole inference (A-infer-null) ───────
// An un-annotated `let x = null` is not pinned to the exact `null` type — a later `x = e`
// fills the hole's `T`, making `x` the value union `T | null`, inferred once at collection
// time and registered per `LetDecl` so every later classifier sees the union.

// The checker gives every un-annotated `let x = null` a type: the one a later write fills its
// hole with, else `null` when no write does. A hole it did neither for has no type to lower,
// so it is refused here rather than registered under a spelling.
function nliHoleHasType(walk: i32[], i: i32): i32 {
  const s = nodeAt(walk[i])
  if s is LetDecl {
    if s.letType < 0 && s.letInit >= 0 && nodeAt(s.letInit) is NullLit {
      if letNullHoleFilledTy(walk[i]) < 0 && !letNullHoleUnfilled(walk[i]) {
        return emitFail(
          "emitProgram: `let "
            + s.letName
            + " = null` reached emit with no type: the checker neither filled its hole nor closed it as `null`",
        )
      }
    }
  }
  0
}

// Infers + registers the value union of an un-annotated `const x = <if-expression>` in the
// `nli` tables, so `nliNameOf` drives classification and emit reuses the annotated-binding lowering. The union name comes from
// the checker's `inferLetNameOf`, falling back to `ifExprNliName` when that carries none.
function nliInferIfLet(walk: i32[], i: i32) {
  const s = nodeAt(walk[i])
  if s is LetDecl {
    if s.letType < 0 && s.letInit >= 0 {
      if exprIsIfStmt(s.letInit) {
        let nn = inferLetNameOf(walk[i])
        if nn == "" { nn = ifExprNliName(s.letInit) }
        if nn != "" {
          registerValueUnionOfTy(21, nodeTyIxOf(s.letInit))
          nliLetIxs.push(walk[i])
          nliNames.push(nn)
        }
      }
    }
  }
  0
}

// Infers + registers the value union of an un-annotated `const t = a?.w`, the optional-chain
// counterpart of `nliInferIfLet`. This is the only route for this type: `i32 | null` here is
// synthesized by the checker with no annotation anywhere to see it, so without this the box
// heap type is never minted and `emitOptMemberValue` has no rep to build.
function nliInferOptChainLet(walk: i32[], i: i32) {
  const s = nodeAt(walk[i])
  if s is LetDecl {
    if s.letType < 0 && s.letInit >= 0 {
      const ini = nodeAt(unwrapParen(s.letInit))
      if ini is OptMember {
        const nn = inferLetNameOf(walk[i])
        if nn != "" {
          registerValueUnionOfTy(22, nodeTyIxOf(s.letInit))
          nliLetIxs.push(walk[i])
          nliNames.push(nn)
        }
      }
    }
  }
  0
}

// ── the one render-then-canon hop in this module (W9) ──────────────────────────
// The emitter-vocabulary name of an arena type: `tyToNominalName`'s source-faithful spelling,
// then `canonEmitName` applied once over the whole render — the same rewrites every source
// annotation gets — so an arena-derived key equals the name-walk's key for the same type.
export function arenaEmitName(tyIx: i32): string {
  const nom = tyToNominalName(tyIx)
  if nom == "" { return "" }
  canonEmitNameOfTy(tyIx, nom)
}

// The name-walk key for a reachable union, honoring the position-dependent litunion
// softening that `canonEmitName` bakes in — see `arenaEmitName` above for the rule and
// for what `underFunc` buys. Reproduces the name-walk key in BOTH positions — the
// prerequisite for retiring `registerShapeFieldUnions`.
function reachRegisterName(tyIx: i32, underFunc: boolean): string {
  if underFunc && !tyIsLitFreeMapUnion(tyIx) { return tyToNominalName(tyIx) }
  arenaEmitName(tyIx)
}

// Whether `ty` (through `| null`) is a union with a map member and no literal-union member:
// no softening applies, so it keys as it does at the top level, its aliases flattened.
function tyIsLitFreeMapUnion(ty: i32): boolean {
  const u = tyPeelNul(ty)
  if u < 0 || u >= T.tys.length { return false }
  const t = tyAt(u)
  if !(t is TyUnion) { return false }
  let hasMap = false
  for m in t.uMembers {
    if tyIsLitUnionLike(m, 8) { return false }
    if !isNullTy(m) && tyAt(nonNullTy(m)) is TyMap { hasMap = true }
  }
  hasMap
}

// Per arena type, the deepest `depth` a walk below completed at, one column per `underFunc`,
// so a repeat reaching no deeper is skipped: it would meet only unions already registered.
// Dropped with the union registry at `collectU`'s start; off while the A/B shadow counts calls.
let ctrDoneAt: i32[] = []
let ctrDoneAtFn: i32[] = []

function ctrDoneDepth(tyIx: i32, underFunc: boolean): i32 {
  const col = if underFunc { ctrDoneAtFn } else { ctrDoneAt }
  if tyIx >= col.length { return 0 }
  col[tyIx]
}

function ctrDoneMark(tyIx: i32, underFunc: boolean, depth: i32) {
  const col = if underFunc { ctrDoneAtFn } else { ctrDoneAt }
  while col.length <= tyIx { col.push(0) }
  if col[tyIx] < depth { col[tyIx] = depth }
  0
}

// ── unified arena registration walk ───────────────────────────────────────────
// The structural sibling of the name walk: recurses over `tyIx`'s `T.tys` shape and registers
// every reachable `TyUnion`, so a union in a novel nesting position the name walk cannot see
// is never missed. Keys from `arenaEmitName`, so an already-reached union is a no-op; depth-capped at 16.
function collectTyReachRegister(
  stmts: i32[],
  tyIx: i32,
  depth: i32,
  underFunc: boolean,
) {
  if tyIx < 0 || depth <= 0 { return 0 }
  const memo = unABOn() == 0
  if memo && ctrDoneDepth(tyIx, underFunc) >= depth { return 0 }
  const r = collectTyReachRegisterGo(stmts, tyIx, depth, underFunc)
  if memo && r >= 0 { ctrDoneMark(tyIx, underFunc, depth) }
  r
}

// Registers every union arena type `tyIx` reaches, for a pass after `collectU` that made the
// type itself (a monomorphized instance's annotated return). Returns 0, or -1 (via `emitFail`).
export function registerTyReachUnions(stmts: i32[], tyIx: i32) {
  const before = uVariants.length
  if collectTyReachRegister(stmts, tyIx, 16, false) < 0 { return -1 }
  if uVariants.length != before { return assignTags() }
  0
}

// One step of `collectTyReachRegister`'s walk, unmemoised.
function collectTyReachRegisterGo(
  stmts: i32[],
  tyIx: i32,
  depth: i32,
  underFunc: boolean,
) {
  const t = tyAt(tyIx)
  // Exhaustive over `Ty` and `_`-less: a new arena variant that can carry a union must get a
  // descent here, not take the leaf `0` and drop every union beneath it.
  match t {
    TyNullable => {
      // Descends the inner union's members first, without registering the inner union itself, so
      // the outer `…|null` name registers first (the arms' field unions must precede `collectVariantFields`).
      if collectTyMembersReach(stmts, t.nInner, depth - 1, underFunc) < 0 {
        return -1
      }
      // A niche nullable carries its own emit-name registration too, since recursing only the
      // inner type misses it (`AB|null`'s inner registers `A|B`, not the outer name the registry looks up).
      const nn = reachRegisterName(tyIx, underFunc)
      if nn != "" {
        if registerInlineUnionAt(stmts, nn, 41, tyIx, tyIx) < 0 { return -1 }
      }
      return collectTyReachRegister(stmts, t.nInner, depth - 1, underFunc)
    }
    TyArray => {
      return collectTyReachRegister(stmts, t.aElem, depth - 1, underFunc)
    }
    TyMap => {
      return collectTyReachRegister(stmts, t.mVal, depth - 1, underFunc)
    }
    TyObj => {
      const ftys = t.objFieldTypes
      let i = 0
      while i < ftys.length {
        if collectTyReachRegister(stmts, ftys[i], depth - 1, underFunc) < 0 {
          return -1
        }
        i = i + 1
      }
      return 0
    }
    TyFunc => {
      // Inside a function type every reachable union sits in a litunion-keeping position, so
      // descend with `underFunc = true` and let embedded litunion aliases render faithfully.
      const ps = t.fnParamTypes
      let i = 0
      while i < ps.length {
        if collectTyReachRegister(stmts, ps[i], depth - 1, true) < 0 {
          return -1
        }
        i = i + 1
      }
      return collectTyReachRegister(stmts, t.fnRet, depth - 1, true)
    }
    TyUnion => {
      // Descends into the members first: a struct arm's field may itself be a union, and the
      // outer registration runs `collectVariantFields` synchronously, needing the arm fields registered first.
      if collectTyMembersReach(stmts, tyIx, depth - 1, underFunc) < 0 {
        return -1
      }
      // A "" render (unresolvable nominal / over-deep recursion) declines silently; the name walk
      // still covers those, since this walk only adds coverage.
      const nm = reachRegisterName(tyIx, underFunc)
      if nm != "" {
        if registerInlineUnionAt(stmts, nm, 42, tyIx, tyIx) < 0 { return -1 }
      }
      // The render softens and dedupes, so its row can carry another key; a reader holding
      // this type asks the key of its own member sequence.
      return mintValueUnionRowOfTy(tyIx)
    }
    TyPrim => {
      // A leaf scalar carries nothing to register.
    }
    TyLit => {
      // A literal is a leaf too; its litunion alias registers where it is spelled.
    }
    TyVar => {
      // Unsubstituted, so there is no concrete union under it yet.
    }
    TyErr => {
      // The error hole has no shape to descend.
    }
    TyNeg => {
      // A negation carries no member or element to reach.
    }
  }
  0
}

// Descends each member of the union at `tyIx` through `collectTyReachRegister`, without
// registering the union itself — whoever is about to register a variant-box union calls this
// first, so every struct arm's field unions are registered when `collectVariantFields` fires.
// A non-union `tyIx` (or -1 / exhausted depth) is a no-op. Returns 0, or -1.
function collectTyMembersReach(
  stmts: i32[],
  tyIx: i32,
  depth: i32,
  underFunc: boolean,
) {
  if tyIx < 0 || depth < 0 { return 0 }
  const t = tyAt(tyIx)
  // Exhaustive over `Ty` and `_`-less: a new arena variant that can carry a union owes this
  // walk a descent, and a silent leaf here leaves the arms' field unions unregistered.
  match t {
    TyUnion => {
      const members = t.uMembers
      let i = 0
      while i < members.length {
        if collectTyReachRegister(stmts, members[i], depth, underFunc) < 0 {
          return -1
        }
        i = i + 1
      }
    }
    TyMap => {
      // A collection carrying the union has no arm-field pre-descent of its own (the caller's
      // registration recurses by name into it), so descend through it here to register the arms' field unions first.
      return collectTyMembersReach(stmts, t.mVal, depth - 1, underFunc)
    }
    TyArray => {
      // As `TyMap`: the element carries the union.
      return collectTyMembersReach(stmts, t.aElem, depth - 1, underFunc)
    }
    TyNullable => {
      // The caller strips the `| null` and asks about the inner type.
    }
    TyObj => {
      // A field union is reached through the registration walk, not this pre-descent.
    }
    TyFunc => {
      // As `TyObj`: the sig walk owns a function type's members.
    }
    TyPrim => {
      // A leaf carries no members.
    }
    TyLit => {
      // A leaf carries no members.
    }
    TyVar => {
      // Unsubstituted, so there are no members yet.
    }
    TyErr => {
      // The error hole has no members.
    }
    TyNeg => {
      // A negation carries no member list.
    }
  }
  0
}

// True if a closure whose result arena type is `retIx` is not yet representable through the
// value ABI, so the arena sig walk must skip interning its sig — synthesizing one the concrete
// producer declines would let a value call resolve past its clean reject into invalid emit.
// Two holes: an inline result struct not `funcTypeShapeLowerable`, or a heterogeneous value union.
function funcRetUnrepresentable(retIx: i32): boolean {
  if retIx < 0 { return false }
  const t = tyAt(retIx)
  // Exhaustive over `Ty` and `_`-less: the two holes are an inline result struct and a
  // heterogeneous value union, and a new arena variant with a third must say so here.
  match t {
    TyObj => {
      // `arenaEmitName` is the module's one render-then-canon hop; a `""` render fails
      // `nameIsShapeOpen` without entering the rewriter.
      const nm = arenaEmitName(retIx)
      // `nameIsShapeOpen` bounds the name at 2, avoiding an out-of-bounds `nm[1]` read that a
      // bare `length > 0` test would trap on for the single name `"{"`.
      if nameIsShapeOpen(nm) { return !funcTypeShapeLowerable(retIx) }
      return false
    }
    TyUnion => {
      const members = t.uMembers
      if members.length < 2 { return false }
      let hasScalar = false
      let hasComposite = false
      let i = 0
      while i < members.length {
        const mt = tyAt(members[i])
        match mt {
          TyPrim => {
            hasScalar = true
          }
          TyLit => {
            hasScalar = true
          }
          // A nested literal union is an atom, so it is a scalar member.
          TyUnion => {
            if tyIsLitUnion(members[i]) { hasScalar = true }
          }
          TyObj => {
            hasComposite = true
          }
          TyArray => {
            hasComposite = true
          }
          TyMap => {
            hasComposite = true
          }
          TyFunc => {
            hasComposite = true
          }
          // No other member is either.
          TyErr | TyNullable | TyVar | TyNeg => {}
        }
        i = i + 1
      }
      return hasScalar && hasComposite
    }
    TyNullable => {
      // A `| null` result is a niche, representable through the value ABI.
    }
    TyArray => {
      // A list result is representable.
    }
    TyMap => {
      // A map result is representable.
    }
    TyFunc => {
      // A closure result is representable; its own result is asked when the walk reaches it.
    }
    TyPrim => {
      // A scalar result is representable.
    }
    TyLit => {
      // A literal result rides its base scalar.
    }
    TyVar => {
      // Unsubstituted; the instance's concrete result is what gets asked.
    }
    TyErr => {
      // The error hole is already a checker reject.
    }
    TyNeg => {
      // A negation is not a result type the ABI sees.
    }
  }
  false
}

// ── unified arena closure-sig walk ────────────────────────────────────────────
// The sig-interning sibling of `collectTyReachRegister`: recurses over `tyIx`'s `T.tys` shape
// and interns every reachable `TyFunc`'s `$fnsig`. Render discipline mirrors the registration
// walk, so keys agree; idempotent and order-stable, called last so an existing sig keeps its slot.
function collectTyReachCloSigs(tyIx: i32, depth: i32) {
  ctwSeenDepth = Map()
  ctwSeenGen = Map()
  collectTyReachCloSigsGo(tyIx, depth)
}

// The deepest remaining budget each node has had in this root's walk, and the registry
// generation of that visit: a revisit with no more budget in the same generation interns
// only keys its first visit interned, so it is skipped, and a type nesting one record twice per
// level is walked once per node rather than once per path.
let ctwSeenDepth: {[i32]: i32} = Map()
let ctwSeenGen: {[i32]: i32} = Map()

// One node of `collectTyReachCloSigs`'s walk, behind the revisit memo.
function collectTyReachCloSigsGo(tyIx: i32, depth: i32): i32 {
  if tyIx < 0 || depth <= 0 { return 0 }
  const gen = tyRegGenNow()
  if (ctwSeenGen[tyIx] ?? -1) == gen && (ctwSeenDepth[tyIx] ?? 0) >= depth {
    return 0
  }
  ctwSeenGen[tyIx] = gen
  ctwSeenDepth[tyIx] = depth
  collectTyReachCloSigsArm(tyIx, depth)
}

// The walk's step at `tyIx`, its children asked through `collectTyReachCloSigsGo`.
function collectTyReachCloSigsArm(tyIx: i32, depth: i32): i32 {
  const t = tyAt(tyIx)
  // Exhaustive over `Ty` and `_`-less: a new arena variant that can hold a closure must get a
  // descent, and a silent leaf here leaves its `$fnsig` un-interned.
  match t {
    TyNullable => {
      return collectTyReachCloSigsGo(t.nInner, depth - 1)
    }
    TyArray => {
      return collectTyReachCloSigsGo(t.aElem, depth - 1)
    }
    TyMap => {
      return collectTyReachCloSigsGo(t.mVal, depth - 1)
    }
    TyObj => {
      const ftys = t.objFieldTypes
      let i = 0
      while i < ftys.length {
        if collectTyReachCloSigsGo(ftys[i], depth - 1) < 0 { return -1 }
        i = i + 1
      }
      return 0
    }
    TyUnion => {
      const members = t.uMembers
      let i = 0
      while i < members.length {
        if collectTyReachCloSigsGo(members[i], depth - 1) < 0 { return -1 }
        i = i + 1
      }
      return 0
    }
    TyFunc => {
      // The sig's key reads its result's rep, so a result map mints its value slot first.
      forceCloResultMapTypes(tyIx)
      // Interns this closure's sig from its arena render, the key the value-call site and a
      // concrete lambda both derive; a mixed-union unregistered result is skipped so the call rejects loudly.
      if !funcRetUnrepresentable(t.fnRet) {
        // `sigKeyOfTy(tyIx)` gets the key directly off the type rather than parsing it back out of
        // the render `arenaEmitName` would produce; the render is asked only whether it exists.
        const kAr = sigKeyOfTy(tyIx)
        if kAr != "" && !cloResultMaybeMixed(tyIx) {
          internCloSigKey(kAr, -1)
        } else {
          const nm = arenaEmitName(tyIx)
          if nm != "" { internCloSigOfArmTy(kAr, tyIx) }
        }
      }
      // Descend params + result to reach closures nested inside them (a result struct's
      // closure field, a param closure, a closure arm of a field union).
      const ps = t.fnParamTypes
      let i = 0
      while i < ps.length {
        if collectTyReachCloSigsGo(ps[i], depth - 1) < 0 { return -1 }
        i = i + 1
      }
      return collectTyReachCloSigsGo(t.fnRet, depth - 1)
    }
    TyPrim => {
      // A leaf scalar holds no closure.
    }
    TyLit => {
      // A leaf literal holds no closure.
    }
    TyVar => {
      // Unsubstituted; the instance's concrete type is what gets walked.
    }
    TyErr => {
      // The error hole has no shape to descend.
    }
    TyNeg => {
      // A negation carries no member or element.
    }
  }
  0
}

// Roots the arena registration walk at a named union's declared arena type, from the
// checker's declaration registry (`cUserTypes`), since a `UnionDecl` carries no annotation
// node. Descends each member (not the union itself, which `collectU` pushes right after) so
// `collectVariantFields` sees every arm's field unions already registered. Returns 0, or -1.
function rootUnionDeclMembers(stmts: i32[], udName: string) {
  let udTyIx = -1
  const udHit = cUserTypes[udName]
  if udHit is i32 { udTyIx = udHit }
  collectTyMembersReach(stmts, udTyIx, 16, false)
}

// The arena type of an un-annotated binding: its INITIALIZER's, since a `LetDecl` is a statement
// and records `void`, and that index is the one the value's readers hand `unRowOfCanonFolded`. -1 for
// a node that is not a `LetDecl`.
function letInitTyIxOf(letIx: i32): i32 {
  if letIx < 0 { return -1 }
  const d = nodeAt(letIx)
  if d is LetDecl { return nodeTyIxOf(d.letInit) }
  -1
}

// Registers the MIXED union an un-annotated binding inferred, from the initializer's arena type.
// The mint the inferred RETURN takes, so the two never become two producers.
function registerInferLetMixedUnion(stmts: i32[], letIx: i32) {
  registerInferredUnionTy(stmts, letInitTyIxOf(letIx))
}

// Registers the struct-bearing union at arena type `ity` under its nominal spelling, once. The
// one mint for an inferred binding and an inline join, so the two cannot spell one union twice.
function registerInferredUnionTy(stmts: i32[], ity: i32) {
  if ity < 0 { return 0 }
  // The NOMINAL render, not the structural one: `is A` asks the row for `A`'s arm, and a row
  // whose member is the anonymous `{r:i32}` has no interned arm to answer with. The same
  // renderer the inferred RETURN's name is built from, so the two mints spell one union alike.
  const inm = tyToNominalName(ity)
  if inm == "" { return 0 }
  if tyNomNameCycled() { return 0 }
  if isUNameAB(46, ity) && unNameAdoptTyKeyRow(inm, ity) { return 0 }
  if collectTyMembersReach(stmts, ity, 15, false) < 0 { return -1 }
  registerInlineUnionAt(stmts, inm, 46, ity, ity)
}

// The inferred-return twin of the same-shape annotation fallback above: an un-annotated
// function whose returns join to a struct-union is inferred structurally with no nominal
// identity, so the recorded name (not the anonymous arena render) is the only nominal
// spelling. The atom count comes from the name producer (`recordInferRet`), never a type walk.
function registerInferRetNominalUnion(stmts: i32[], nm: string, row: i32) {
  const rty = inferRetTyIxAt(row)
  if unNameAdoptTyKeyRow(nm, rty) { return 0 }
  // A genuine union spelling the arena walk left unregistered is the anonymous-nominal
  // residual; a single-atom name has no top-level union to register.
  if inferRetAtomCountAt(row) >= 2 {
    return registerInlineUnionAt(stmts, nm, 44, rty, rty)
  }
  0
}

// The gate that stops an inferred-return row registering twice: the arena walk renders the
// recorded anonymous type structurally and registers it, then the fallback registers the
// reverse-mapped nominal composite — two `unNames` rows, one layout, every variant of the
// second a duplicate in `uVariants`. True when the two names are not two spellings of one union.
function inferRetArenaUnionIsDup(tyIx: i32, nm: string, row: i32): boolean {
  if tyIx < 0 { return false }
  const t = tyAt(tyIx)
  if !(t is TyUnion) { return false }
  if inferRetAtomCountAt(row) < 2 { return false }
  const ar = reachRegisterName(tyIx, false)
  if ar == "" { return false }
  if ar == nm { return false }
  !isUNameAB(9, tyIx)
}

// Scans every top-level `FuncDecl`'s param/return annotations and `let`/`const` annotations
// for inline union types, registering each as a synthetic union alias. Must run after the
// `UnionDecl` pass (so a matching inline name is a no-op) and before `assignTags` (which
// ranks the final `uVariants` set). Returns 0, or -1 (via `emitFail`).
function collectInlineUnions(stmts: i32[]) {
  nliLetIxs = []
  nliNames = []
  cloSigWalkRoots = []
  ciuFnSeen = Map()
  collectInlineUnionsIn(stmts, stmts)
}

// The functions `collectInlineUnionsIn` has registered, so `collectU`'s lambda walk skips them.
let ciuFnSeen: {[i32]: boolean} = Map()

// The recursive worker: scans the statement list `walk` (registering against the top-level
// `stmts`, where struct `TypeDecl`s live), descending into function bodies and branch blocks
// so a `let v: A | B = …` inside a function or nested block registers its inline union too.
function collectInlineUnionsIn(stmts: i32[], walk: i32[]) {
  let i = 0
  while i < walk.length {
    const s = nodeAt(walk[i])
    if s is FuncDecl {
      ciuFnSeen[walk[i]] = true
      // Read both annotation-bearing fields of the narrowed `s` before the inner loop introduces
      // a `Param` narrowing, which would unpin `s`'s own `FuncDecl` narrowing.
      const params = s.fnParams
      const retTy = s.fnRet
      const fnBody = s.fnBody
      // The arena walk registers every union the annotation's type reaches.
      if collectTyReachRegister(stmts, nodeTyIxOf(retTy), 16, false) < 0 {
        return -1
      }
      cloSigWalkRoots.push(nodeTyIxOf(retTy))
      let pi = 0
      while pi < params.length {
        const p = nodeAt(params[pi])
        if p is Param {
          const pt = p.parType
          if collectTyReachRegister(stmts, nodeTyIxOf(pt), 16, false) < 0 {
            return -1
          }
          cloSigWalkRoots.push(nodeTyIxOf(pt))
        }
        pi = pi + 1
      }
      if collectInlineUnionsBlock(stmts, fnBody) < 0 { return -1 }
    } else if s is LetDecl {
      const letTy = s.letType
      if collectTyReachRegister(stmts, nodeTyIxOf(letTy), 16, false) < 0 {
        return -1
      }
      // A `let x = null` whose hole a later write filled holds the checker's `T | null`.
      if letTy < 0 {
        const hty = letNullHoleFilledTy(walk[i])
        if collectTyReachRegister(stmts, hty, 16, false) < 0 { return -1 }
      }
      annAdoptRegisteredName(letTy)
      // An unannotated binding still has a type that can be a union (`const v = m["k"]` infers
      // `i32 | null`), so this mints the box here; idempotent, since an annotated binding just no-ops the second walk.
      if letTy < 0 {
        // A read narrowed to a smaller box binds that box, which no declaration
        // registers (D5921).
        if initIsNarrowedBoxRead(s.letInit) {
          if (
            collectTyReachRegister(stmts, nodeTyIxOf(s.letInit), 16, false)
            < 0
          ) {
            return -1
          }
        }
        if initNullableIsBoxScalar(s.letInit) {
          for bt in elabNodeInstTys(s.letInit) {
            if collectTyReachRegister(stmts, bt, 16, false) < 0 { return -1 }
          }
        }
      }
      cloSigWalkRoots.push(nodeTyIxOf(letTy))
      if nliHoleHasType(walk, i) < 0 { return -1 }
      // An un-annotated `const x = if … { … } else { … }` whose arms join to a value
      // union: register the inferred name so the slot classifies + lowers like an
      // annotated nullable/value-union binding.
      nliInferIfLet(walk, i)
      // An un-annotated `const t = a?.w` whose result is a nullable SCALAR: same
      // registration, because the type it needs is spelled nowhere in the program.
      nliInferOptChainLet(walk, i)
    } else if s is TypeDecl {
      // A struct field annotated with an inline union registers that union here, before
      // `collectS` interns the variant heap types, so the field classifies as the kind-16 box.
      const flds = s.tdFields
      let tfi = 0
      while tfi < flds.length {
        if flds[tfi] >= 0 {
          const fdn = nodeAt(flds[tfi])
          if fdn is FieldDef {
            const fdt = fdn.fdType
            if collectTyReachRegister(stmts, nodeTyIxOf(fdt), 16, false) < 0 {
              return -1
            }
            cloSigWalkRoots.push(nodeTyIxOf(fdt))
          }
        }
        tfi = tfi + 1
      }
    } else if s is IfStmt {
      // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
      let cur = walk[i]
      while cur >= 0 {
        const c = nodeAt(cur)
        cur = -1
        if c is IfStmt {
          const elseN = c.ifElse
          if collectInlineUnionsBlock(stmts, c.ifThen) < 0 { return -1 }
          if elseN >= 0 {
            const els = nodeAt(elseN)
            if els is Block {
              if collectInlineUnionsBlock(stmts, elseN) < 0 { return -1 }
            } else if els is IfStmt {
              cur = elseN
            } else {
              // A lone nested statement — wrap it in a one-shot walk.
              const one: i32[] = []
              one.push(elseN)
              if collectInlineUnionsIn(stmts, one) < 0 { return -1 }
            }
          }
        }
      }
    } else if s is WhileStmt {
      if collectInlineUnionsBlock(stmts, s.whileBody) < 0 { return -1 }
    } else if s is ForRange {
      if collectInlineUnionsBlock(stmts, s.frBody) < 0 { return -1 }
    } else if s is ForIn {
      if collectInlineUnionsBlock(stmts, s.fiBody) < 0 { return -1 }
    } else if s is Block {
      // A BARE `{ … }` statement, whose declarations register like any other scope's. The four
      // block-BEARING statements above each hand their body here; this arm is the same
      // delegation for the block that is a statement in its own right (D1900).
      if collectInlineUnionsIn(stmts, s.blkStmts) < 0 { return -1 }
    }
    i = i + 1
  }
  0
}

// A binding's inline union annotation spelled in an order the walk above did not register
// (`Circle | null | string`, registered as `Circle|string|null`) takes the registered spelling,
// so every name-keyed reader of the binding finds the one row its value is boxed at (D3099).
function annAdoptRegisteredName(annIx: i32) {
  if annIx < 0 { return 0 }
  const lt = nodeAt(annIx)
  if !(lt is TypeRef) { return 0 }
  if unNameBound(lt.tyName) { return 0 }
  const ty = nodeTyIxOf(annIx)
  if ty < 0 { return 0 }
  const tt = tyAt(ty)
  if !(tt is TyNullable || tt is TyUnion) { return 0 }
  const an = reachRegisterName(ty, false)
  if an == "" || !unNameBound(an) { return 0 }
  lt.tyName = an
  0
}

// Recurse into a Block node's statement list (a function body / branch arm).
function collectInlineUnionsBlock(stmts: i32[], blockIx: i32) {
  if blockIx < 0 { return 0 }
  const b = nodeAt(blockIx)
  if b is Block { return collectInlineUnionsIn(stmts, b.blkStmts) }
  0
}

// ── unrenderable (cyclic) declared types — rejected before anything renders ──
// `applyGenAlias` registers an empty placeholder under a recursive instance's memo key before
// resolving its fields, so a self-application lands on its own index rather than recursing
// forever — but a generic instance has no name to short-circuit a renderer, which then traps.

// Would a name-faithful render of arena type `ix` fail to terminate? The render itself is
// the test (`renderEmit` banks the cut in `tyNomNameCycled`), not a hand-written copy of it.
function tyNomRenderLoops(ix: i32): boolean {
  tyToNominalName(ix)
  tyNomNameCycled()
}

// The source spelling of the first annotation whose resolved type is `ix` (`L<i32>`),
// for the diagnostic — the arena type itself has no finite render, which is the whole
// point. Failure path only, so the linear `P.nodes` scan costs nothing otherwise.
function annSpellingOfTyIx(ix: i32): string {
  let i = 0
  while i < P.nodes.length {
    const n = nodeAt(i)
    if n is TypeRef {
      if nodeTyIxOf(i) == ix { return n.tyName }
    }
    i = i + 1
  }
  ""
}

// Rejects every declared type whose expansion has no finite name, before the first pass
// renders one. `cUserTypes` keys every declared alias and generic-alias instance, so one scan
// of the registry covers the whole family; a declared struct/union entry costs one lookup.
// Returns 0, or -1 (via `emitFail`).
function guardFiniteUserTypes(): i32 {
  const ks = cUserTypes.keys()
  let i = 0
  while i < ks.length {
    const v = cUserTypes[ks[i]] ?? (-1)
    if tyNomRenderLoops(v) {
      let shown = annSpellingOfTyIx(v)
      if shown == "" { shown = ks[i] }
      return emitFail(
        "emitProgram: recursive generic type `"
          + shown
          + "` is not supported — its expansion has no finite type name",
      )
    }
    i = i + 1
  }
  0
}

// ── the variant field-span invariant, reconciled once per module ─────────────────────
// `uFieldStart`/`uFieldCount` are parallel to `uVariants`; they come apart when a swallowed
// `-1` leaves a pushed row's start with no count, and `emitFail`'s keep-emitting discipline
// then traps some thirty later readers. Restored once here: report both lengths, then pad.
export function reconcileVariantFieldSpans() {
  if (
    uFieldStart.length >= uVariants.length
    && uFieldCount.length >= uVariants.length
  ) {
    return 0
  }
  emitFail(
    "emitProgram: the union-variant field-span tables do not cover every variant — "
      + i32ToStr(uVariants.length)
      + " variants but "
      + i32ToStr(uFieldStart.length)
      + " field starts / "
      + i32ToStr(uFieldCount.length)
      + " field counts",
  )
  // An empty span (start 0, count 0) is in bounds against any flat store, so a padded row
  // reads as a fieldless variant rather than off the end of the table.
  while uFieldStart.length < uVariants.length { uFieldStart.push(0) }
  while uFieldCount.length < uVariants.length { uFieldCount.push(0) }
  -1
}

// Whether no arm of union `ty`, or of its nullable's inner union, is a list or a map: the joins
// a hole's `??` boxes, where a container arm has no value-box delivery.
function collectNoContainerArmJoin(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  let u = ty
  const t = tyAt(ty)
  if t is TyNullable { u = t.nInner }
  if u < 0 || u >= T.tys.length { return false }
  const ut = tyAt(u)
  if !(ut is TyUnion) { return !(ut is TyArray || ut is TyMap) }
  for m in ut.uMembers {
    if m < 0 || m >= T.tys.length { return false }
    const mt = tyAt(m)
    if mt is TyArray || mt is TyMap { return false }
  }
  true
}

// Scans the top-level statements for every union alias `type N = A | B | …`; for each,
// records its name + variant-slice range, appends its variant struct names to the global
// `uVariants` list, and collects each variant's fields into the flat table. Multiple unions
// coexist. Returns 0, or -1 (via `emitFail`).
export function collectU(stmts: i32[]) {
  // The struct table does not exist yet in this program: a previous program's rows would
  // resolve a variant's nested field to a row of theirs (D3031).
  structTableReset()
  repDeclRowsPending([])
  // The declared-struct-name index, rebuilt here rather than memoised: a second module in the
  // same instance can present a statement list of the same length, which the index's own
  // stamp cannot see. Every `isStructAtom` ask in this pass and in mono's reads it.
  declStructIndexBuild(stmts)
  // The first emit pass, so this is the first thing in the emitter that would walk a
  // declared type — reject the ones no renderer can finish before any of them tries.
  if guardFiniteUserTypes() < 0 { return -1 }
  collectUReset()
  let i = 0
  while i < stmts.length {
    // D1519 — the declaration cursor `emitFail` anchors refusals at, since this pass runs before
    // any function body arms one; a failure freezes it, so early returns cannot leak a stale anchor.
    emitCurStmtIx = stmts[i]
    const s = nodeAt(stmts[i])
    if s is UnionDecl {
      if collectDeclaredUnion(stmts, stmts[i], s) < 0 { return -1 }
    }
    i = i + 1
  }
  // Inline union annotations carry no `UnionDecl`; registers each as a synthetic alias so
  // every name-keyed lookup treats it like a named one. Runs after `UnionDecl`, before `assignTags`.
  if collectInlineUnions(stmts) < 0 { return -1 }
  if collectInferredUnions(stmts) < 0 { return -1 }
  // Inferred array-element unions: an un-annotated array literal spells its element union
  // nowhere, so without this the row is never minted.
  let iau = 0
  while iau < P.nodes.length {
    const an = nodeAt(iau)
    if an is ArrayLit {
      const aeu = arrLitInferUnionElemName(iau, -1)
      if aeu != "" {
        const aety = arrLitElemTyIxOf(iau)
        if !(isUNameAB(24, aety) && unNameAdoptTyKeyRow(aeu, aety)) {
          if collectTyMembersReach(stmts, aety, 15, false) < 0 { return -1 }
          if registerInlineUnionAt(stmts, aeu, 45, aety, aety) < 0 { return -1 }
        }
      }
      // The row above is named by the softened render, which dedupes and widens the members,
      // so a reader holding the literal's own element type asks its key and finds this one.
      mintValueUnionRowOfTy(tyArrayElemIx(nodeTyIxOf(iau)))
      // The NULLABLE spelling of the same box. `i32 | null` is recorded as `TyNullable`, so
      // the union rung above declines and an UN-ANNOTATED literal gets no row at all, while
      // the annotated `(i32 | null)[]` mints one through its annotation. Same producer the
      // `.pop`/`.get` loop below uses, which is why those two spellings already registered it (D1830).
      const anuTy = arrLitElemTyIxOf(iau)
      const anu = nulNumScalarUnionName(anuTy)
      if anu != "" { registerNulScalarBox(56, anu, anuTy) }
    }
    iau = iau + 1
  }
  // A numeric-scalar `.pop()` has the same missing-row shape: `xs.pop()` is `T | null` with
  // no niche to hide absence in, so without this the box is never interned (D1174).
  let ipu = 0
  while ipu < P.nodes.length {
    const pn = nodeAt(ipu)
    if pn is Call && pn.callFn >= 0 {
      const pcf = nodeAt(pn.callFn)
      if pcf is Member {
        // `.get(i)` is the same unspoken box (D1281): the checker types the checked
        // read `T | null` at both members, and neither spells the union anywhere.
        if pcf.memProp == "pop" || pcf.memProp == "get" {
          const punTy = nodeTyIxOf(ipu)
          const pun = nulNumScalarUnionName(punTy)
          if pun != "" { registerNulScalarBox(57, pun, punTy) }
        }
      }
      // `Map<K, V>()` may be the only spelling of the unions its value holds (D8260).
      if pcf is Ident && pcf.identName == "Map" && callHasTyArgs(ipu) {
        const mct = nodeTyIxOf(ipu)
        if mct >= 0 && mct < T.tys.length && tyAt(mct) is TyMap {
          if collectTyReachRegister(stmts, mct, 16, false) < 0 { return -1 }
        }
      }
    }
    collectFnTagMapReadBox(ipu)
    // D1250 — an if-expression `??` operand is a second producer of an unspoken solo box, keyed
    // on the `??` (not the `if`, whose statement form also types nullable but has no consumer).
    if pn is BinExpr {
      if pn.binOp == "??" {
        const lin = nodeAt(unwrapParen(pn.binLeft))
        if lin is IfStmt {
          const iunTy = nodeTyIxOf(unwrapParen(pn.binLeft))
          const iun = nulNumScalarUnionName(iunTy)
          if iun != "" { registerNulScalarBox(58, iun, iunTy) }
        }
        // A `??` that joins into a value union (`x ?? 2.5` over `i64 | null`) spells that union
        // nowhere, and a consumer with no annotation of its own reads the box (D3513).
        const cty = nodeTyIxOf(ipu)
        if cty >= 0 && tyAt(cty) is TyUnion && isValueUnionTyOr(cty) == 1 {
          if collectTyReachRegister(stmts, cty, 16, false) < 0 { return -1 }
        }
        // A hole's `??` reads at each instance's binding, which no node records, so its join is
        // registered here.
        if cty >= 0 && tyAt(cty) is TyVar {
          for cpin in elabNodeInstTys(ipu) {
            if (
              cpin >= 0
              && cpin != cty
              && isValueUnionTyOr(cpin) >= 0
              && collectNoContainerArmJoin(cpin)
            ) {
              if collectTyReachRegister(stmts, cpin, 16, false) < 0 {
                return -1
              }
            }
          }
        }
      }
    }
    // A field read over a union whose members store the field as different records is the box
    // of the union it is typed as, which nothing else in the program may spell.
    if (
      pn is Member
      && nodeTyIsUnionRow(ipu)
      && nodeTyIsUnionRow(unwrapParen(pn.memObj))
    ) {
      if collectTyReachRegister(stmts, nodeTyIxOf(ipu), 16, false) < 0 {
        return -1
      }
    }
    // `m[k] is X` narrows its else over the read's own type, whose `null` is a missing key's,
    // which a null-free value type spells nowhere (D8121).
    if pn is IsExpr {
      const iso = unwrapParen(pn.isObj)
      if iso >= 0 && iso < P.nodes.length {
        const isn = nodeAt(iso)
        if (
          isn is Index
          && tyMapValOf(nodeTyIxOf(unwrapParen(isn.idxArr))) >= 0
        ) {
          if collectTyReachRegister(stmts, nodeTyIxOf(iso), 16, false) < 0 {
            return -1
          }
        }
      }
    }
    // A standalone `?.` over a non-null scalar field is `T | null`, spelled nowhere (D3513); a
    // hole's reads at each instance's binding (D3215).
    if pn is OptMember {
      for ounTy in elabNodeInstTys(ipu) {
        const oun = nulNumScalarUnionName(ounTy)
        if oun != "" { registerNulScalarBox(59, oun, ounTy) }
      }
    }
    ipu = ipu + 1
  }
  emitCurStmtIx = -1
  // The variant table is complete, so the declared rows `collectS` will mint are known; a rep
  // asked while the arms are tagged sees them (D15880).
  repDeclRowsPending(declRowTysOf(stmts))
  if uDeclared {
    if assignTags() < 0 { return -1 }
  }
  0
}

// Clear every union-registry table and value-box flag `collectU` fills, so this program's
// registration starts from nothing a previous program left behind; only the i64 and f64 boxes
// a retag widening asks for start used.
function collectUReset() {
  ctrDoneAt = []
  ctrDoneAtFn = []
  uDeclared = false
  vbI32Used = false
  vbI64Used = false
  vbF32Used = false
  vbF64Used = false
  vbV128Used = false
  vbU8ArmUsed = false
  if widenRetagToHas("i64") { vbI64Used = true }
  if widenRetagToHas("f64") { vbF64Used = true }
  mIntMonoArmUsed = false
  vbBoolListTop = -1
  vbAtomListUsed = false
  vbAtomListTop = -1
  mTwinTys = []
  mTwinShapes = []
  mTwinCodes = []
  mTwinExtra = 0
  mTwinSettled = false
  unNames = []
  unRowBySid = []
  unTyIx = []
  unTyKey = []
  unTyKeyFirstRow = []
  unDeclIx = []
  unMemberSet = []
  unMemTyStart = []
  unMemTyCount = []
  unMemTys = []
  unVarStart = []
  unVarCount = []
  uVariants = []
  uVariantRowBySid = []
  uVarTyIx = []
  uVarMemPos = []
  uVarTyIxResets = uVarTyIxResets + 1
  cloSigTagNames = []
  cloSigTagIds = []
  armStageNames = []
  armStageTypes = []
  armStageTyText = []
  armStageLitTyIx = []
  armStageStoreTy = []
  armStageElemName = []
  armStageElemTyIx = []
  armStageElemKeyKind = []
  uFieldStart = []
  uFieldCount = []
  uVarFieldRow = []
  armsAdopted = false
  variantSigMemoDrop()
  0
}

// The one struct shape a union decl `s` lowers as, or "" when it lowers as a union. Arms
// that differ only in a lone literal spell one softened shape yet are distinct types, so
// they keep the box their type names and share its row (D5157).
function unionDeclStructAlias(s: UnionDecl): string {
  const shape = unionStructAliasShape(s.udVariants)
  if shape == "" { return "" }
  const hit = cUserTypes[s.udName]
  if hit is i32 {
    const ut = tyAt(hit)
    if ut is TyUnion {
      if tyIsValueUnionBox(hit) && tyMembersDistinctRecords(ut.uMembers) {
        return ""
      }
    }
  }
  shape
}

// The row member position of the declared union's arm `vs[vi]`: the member spelled alike at the
// same occurrence, since twin arms that differ only in a numeric tag share one spelling. -1 for
// an arm the row does not spell (an expanded alias), which resolves its own name.
function declVariantPos(vs: string[], vi: i32, atoms: string[]): i32 {
  let nth = 0
  let j = 0
  while j < vi {
    if vs[j] == vs[vi] { nth = nth + 1 }
    j = j + 1
  }
  let k = 0
  while k < atoms.length {
    if atoms[k] == vs[vi] {
      if nth == 0 { return k }
      nth = nth - 1
    }
    k = k + 1
  }
  -1
}

// The one producer of variant rows: the newest union row's variant slice, one row per struct
// member `names[i]` at arena type `tys[i]` and row member position `pos[i]`. A variant's
// identity is that position, never its record type (D14552). 0, or -1 once failed.
function mintVariantRows(
  stmts: i32[],
  names: string[],
  tys: i32[],
  pos: i32[],
): i32 {
  unVarStart.push(uVariants.length)
  // Only struct members occupy variant slots; a `null` rides the tag and a value-atom tags
  // via `scalarTagOfKind` into the shared value boxes.
  let nStructs = 0
  for n in names {
    if n != "null" && isStructAtom(stmts, n) { nStructs = nStructs + 1 }
  }
  unVarCount.push(nStructs)
  let i = 0
  while i < names.length {
    if names[i] != "null" && isStructAtom(stmts, names[i]) {
      uVariantsPush(names[i])
      uVarTyIx.push(tys[i])
      uVarMemPos.push(pos[i])
      if collectVariantFields(stmts, names[i], tys[i]) < 0 { return -1 }
      if armsAdopted {
        if armAdopt(uVariants.length - 1, sNames.length) < 0 { return -1 }
        armStageClear()
      }
    }
    i = i + 1
  }
  0
}

// Whether every member of union `ty` is a record, a primitive, a literal or `null`: no list, map
// or function arm, whose rows intern under a declaring alias's own name.
function unionArmsAreRecordsOrScalars(ty: i32): boolean {
  const xs: i32[] = []
  flattenVariantsInto(ty, xs)
  if xs.length < 2 { return false }
  for x in xs {
    if x >= 0 {
      const t = tyAt(x)
      if !(t is TyObj || t is TyPrim || t is TyLit) { return false }
    }
  }
  true
}

// Whether every member of union `ty` is a primitive, a literal, a list, a map or `null`: no record
// or function arm, so a row with no variants holds all of it.
function unionArmsAreScalarsOrContainers(ty: i32): boolean {
  const xs: i32[] = []
  flattenVariantsInto(ty, xs)
  if xs.length < 2 { return false }
  for x in xs {
    if x >= 0 {
      const t = tyAt(x)
      if !(t is TyPrim || t is TyLit || t is TyArray || t is TyMap) {
        return false
      }
    }
  }
  true
}

// Whether each record arm `s` names is a variant of row `kr`: by its own name, or as a layout
// twin of one of the row's arms (`V = D | S` beside `U = C | S`, `D` typed as `C`). Twins are one
// set (D1712), so a twin takes the first such arm no other arm of `s` names or has taken. With
// `bind`, a twin's name is bound to that arm's variant, so both names read one position.
function declArmsMatchRow(s: UnionDecl, kr: i32, bind: boolean): boolean {
  const lo = unVarStart[kr]
  const hi = lo + unVarCount[kr]
  const taken: i32[] = []
  for m in s.udVariants {
    const mt = declTyIxOfName(m)
    if mt >= 0 && tyAt(mt) is TyObj {
      let hit = -1
      let v = lo
      while v < hi && hit < 0 {
        if (
          v < uVarTyIx.length
          && uVarTyIx[v] >= 0
          && !i32ListHas(taken, v)
          && tySame(uVarTyIx[v], mt)
        ) {
          hit = v
        }
        v = v + 1
      }
      if hit < 0 { return false }
      taken.push(hit)
      if bind && variantIndexOf(m) < 0 {
        sidArrPut(uVariantRowBySid, sidOf(m), hit)
      }
    }
  }
  true
}

// Register the declared union `s` (at statement `stmtIx`): its row, member set and key, its
// struct variants and their fields, and the value boxes, ref-array and map arms its members
// need. A struct alias or an alias that denotes one member or one list gets no row. Returns 0,
// or -1 (via `emitFail`).
function collectDeclaredUnion(stmts: i32[], stmtIx: i32, s: UnionDecl) {
  // A struct-alias union (single inline-shape variant) is a named struct, not a union:
  // `collectS` interns it; skip it here.
  if unionDeclStructAlias(s) != "" { return 0 }
  // A transparent one-member alias denotes its member, not a union (#1122's ruling), so it
  // gets no row here: minting one pushed the member's name into `uVariants` a second time.
  if isTransparentAlias(s.udName) { return 0 }
  // Nor does an alias whose lists all spell one list: it denotes that list (D4743).
  if oneListUnionAliasName(s.udName) != "" { return 0 }
  uDeclared = true
  const vs = s.udVariants
  if vs.length < 1 {
    return emitFail("emitProgram: union must have at least one variant")
  }
  // Field unions of the arms register first, so they push their own rows before this union's
  // slice; arena-rooted since a named union carries no annotation node (`rootUnionDeclMembers`).
  if rootUnionDeclMembers(stmts, s.udName) < 0 { return -1 }
  // An alias whose type key already has a row names that row: one row per type. A value or
  // literal union binds to a row with no variants; a union of records and scalars binds to a row
  // whose variants are its own arms or their twins; one with list or map arms registers them off
  // the row's type (D14742). A function arm keeps its row.
  const dty = declTyIxOfName(s.udName)
  if dty >= 0 {
    const kr = unRowOfTyKey(dty)
    if kr >= 0 {
      const plain = isValueUnionTyOr(dty) == 1 || tyIsLitUnion(dty)
      if (
        (plain && unVarCount[kr] == 0)
        || (!plain
          && unionArmsAreRecordsOrScalars(dty)
          && declArmsMatchRow(s, kr, false))
      ) {
        declArmsMatchRow(s, kr, true)
        unNameBindRow(s.udName, kr)
        return 0
      }
      if !plain && unVarCount[kr] == 0 && unionArmsAreScalarsOrContainers(dty) {
        unNameBindRow(s.udName, kr)
        const krSet = unMemberSet[kr]
        markValueUnionAtoms(dty)
        markRefArrayArms(krSet, dty)
        markMapUnionArms(krSet, dty)
        return 0
      }
    }
  }
  unNamesPush(s.udName)
  unTyIx.push(declTyIxOfName(s.udName)) // B-1 step 1
  unDeclIx.push(stmtIx) // the DECLARATION node — a nominal id that is not a string
  // D1028 — a union-alias member (`Json` in `type JR = Json | E`) flattens here too, or its
  // own members are absent from the row and delivered raw; a litunion alias is not expanded.
  let udSet = ""
  // The variant names: a nullable alias member names its own members, as the flat spelling does (D4040).
  const vsx: string[] = []
  let usj = 0
  while usj < vs.length {
    let udMem = vs[usj]
    // Asked of the arena row (knows both numeric and string litunion bases); only a multi-atom
    // expansion is taken (a litunion alias renders as one atom), and never deduped (box-tag ABI).
    const udExp = unionAliasMembers(udMem)
    if udExp != "" {
      const udExpAtoms: string[] = []
      unionSetAtomsOf(udExp, udExpAtoms)
      if udExpAtoms.length > 1 { udMem = udExp }
    }
    const at = declTyIxOfName(vs[usj])
    const vAtoms: string[] = []
    if at >= 0 && at < T.tys.length && tyAt(at) is TyNullable {
      unionSetAtomsOf(udMem, vAtoms)
    }
    if vAtoms.length > 1 {
      for a in vAtoms { vsx.push(a) }
    } else {
      vsx.push(vs[usj])
    }
    // A function-type member keeps its grouping parens in the join, as the inline union's
    // name does: bare, `(i32)=>i32|string` reads as one arrow returning `i32|string`.
    if nameIsFuncTypeAtom(udMem) && peelGroupParens(udMem) == udMem {
      udMem = "(" + udMem + ")"
    }
    if udSet != "" { udSet = udSet + "|" }
    udSet = udSet + udMem
    usj = usj + 1
  }
  unMemberSet.push(udSet)
  recordUnMemTys(udSet) // D-UNION foundation
  // The row just recorded, snapshotted before any registration below can append: a variant's
  // type is its arm's, never a re-parse of its spelling, which drops a numeric tag (D14540).
  const memAtoms: string[] = []
  const memTys: i32[] = []
  const uRow = unNames.length - 1
  const uMemN = unMemTyCount[uRow]
  const uMemBase = unMemAtoms.length - uMemN
  let uMemI = 0
  while uMemI < uMemN {
    memAtoms.push(unMemAtoms[uMemBase + uMemI])
    memTys.push(unMemTys[uMemBase + uMemI])
    uMemI = uMemI + 1
  }
  // Keyed on the declared type; the set this row records (its tag slice is positional over
  // `udSet`) keys it as well.
  unTyKeyPushRow()
  const vTys: i32[] = []
  const vPos: i32[] = []
  while vPos.length < vsx.length {
    const k = declVariantPos(vsx, vPos.length, memAtoms)
    vTys.push(if k >= 0 { memTys[k] } else { declTyIxOfName(vsx[vPos.length]) })
    vPos.push(k)
  }
  if mintVariantRows(stmts, vsx, vTys, vPos) < 0 { return -1 }
  // A MIXED union's scalar members intern their per-rep value boxes (no-op for an
  // all-struct union).
  markValueUnionAtoms(declTyIxOfName(s.udName))
  // A ref-array arm of a named union interns its element shape + reflist slot, the same as
  // the inline path — so the two spellings register identically.
  markRefArrayArms(udSet, declTyIxOfName(s.udName))
  // A map arm of a named union interns its value shape too, matching the inline path.
  markMapUnionArms(udSet, declTyIxOfName(s.udName))
  0
}

// Register the unions no declaration or annotation statement spells: a lambda's, an inferred
// return's or binding's, an inline join's and an optional call's (`collectU` then mints the boxes
// of array literals, `.pop`/`.get`, `??` and `?.`). Returns 0, or -1 (via `emitFail`).
function collectInferredUnions(stmts: i32[]) {
  // A lambda sits in an expression, which the statement walk does not enter, so its
  // parameters, result and body register here, as a declared function's do (D3075).
  let li = 0
  while li < funcDeclNodes.length {
    const fx = funcDeclNodes[li]
    if fx < P.nodes.length && nodeAt(fx) is FuncDecl && !ciuFnSeen.has(fx) {
      ciuFnSeen.set(fx, true)
      const one: i32[] = []
      one.push(fx)
      if collectInlineUnionsIn(stmts, one) < 0 { return -1 }
    }
    li = li + 1
  }
  ciuFnSeen = Map()
  // Inferred value-union and struct-union returns register here too, even when an inferred
  // return is the program's only union; self-gated on the registry, so already-declared ones no-op.
  let iru = 0
  while iru < inferRetCount() {
    // Arena walk over the inferred return type first (bucket (c) ordering, as at the annotation
    // sites): registers every reachable union, not just what the name render surfaced. Idempotent.
    // `inferRetArenaUnionIsDup`: where the walk's structural render and the name fallback's
    // nominal composite are two spellings of one union, the walk descends members only.
    const irTyIx = inferRetTyIxAt(iru)
    const irNom = inferRetTyAt(iru)
    if inferRetArenaUnionIsDup(irTyIx, irNom, iru) {
      if collectTyMembersReach(stmts, irTyIx, 15, false) < 0 { return -1 }
    } else {
      if collectTyReachRegister(stmts, irTyIx, 16, false) < 0 { return -1 }
    }
    // The name fallback: an inferred struct/variant-box return whose members are anonymous
    // shapes, recorded under its nominal composite, which the arena walk cannot reach (`registerInferRetNominalUnion`).
    if registerInferRetNominalUnion(stmts, irNom, iru) < 0 { return -1 }
    cloSigWalkRoots.push(irTyIx)
    iru = iru + 1
  }
  // Inferred value-union bindings get the same treatment, so their box reps intern even
  // when `nliInferIfLet` is the only consumer. Self-gating, like the returns.
  let ilu = 0
  while ilu < inferLetCount() {
    if inferLetTyAt(ilu) == "" {
      if registerInferLetMixedUnion(stmts, inferLetIxAt(ilu)) < 0 { return -1 }
    } else {
      registerValueUnionOfTy(23, letInitTyIxOf(inferLetIxAt(ilu)))
    }
    ilu = ilu + 1
  }
  // An inline join's union (`(a ?? b) is B`) is spelled by no binding either (D2373); one with a
  // literal-union arm registers under its value-union name, as a binding of it does (D2952).
  let iju = 0
  while iju < inferJoinCount() {
    const ijn = valueUnionRetName(inferJoinTyAt(iju))
    if ijn != "" { registerValueUnionOfTy(23, inferJoinTyAt(iju)) }
    else if registerInferredUnionTy(stmts, inferJoinTyAt(iju)) < 0 { return -1 }
    iju = iju + 1
  }
  // An optional call's `| null` comes from the guard, not from the callee, so no annotation
  // in the program spells it — its value-box row is minted here or the result has no rep
  // wherever the destination is not itself annotated (D1814).
  let ocu = 0
  while ocu < optCallRetCount() {
    const ocName = optCallRetNameAt(ocu)
    if ocName != "" {
      registerValueUnionOfTy(47, nodeTyIxOf(optCallRetNodeAt(ocu)))
    }
    ocu = ocu + 1
  }
  0
}

// Detects bare named-function value uses the other flips miss: a `let`/`const` initialized to
// or a `return` of a function name, a reassignment, an equality operand, or a function-valued
// object-literal field. Each such cell is a closure fat-pointer (kind 14), so the closure rec-group types
// must intern (`fnValUsed`) even when no lambda or `.map` site otherwise flips it.
export function collectFnValUse() {
  let i = 0
  while i < P.nodes.length {
    const nd = nodeAt(i)
    match nd {
      LetDecl => {
        if exprIsBareFnName(nd.letInit) { fnValUsed = true }
      }
      RetStmt => {
        if nd.retArg >= 0 && exprIsBareFnName(unwrapParen(nd.retArg)) {
          fnValUsed = true
        }
      }
      // So is a function body whose value is its last statement (D6370).
      FuncDecl => {
        if nd.fnBody >= 0 {
          const fb = nodeAt(nd.fnBody)
          if fb is Block && fb.blkStmts.length > 0 {
            const ft = unwrapParen(fb.blkStmts[fb.blkStmts.length - 1])
            if exprIsBareFnName(ft) { fnValUsed = true }
          }
        }
      }
      BinExpr => {
        if nd.binOp == "=" || nd.binOp == "==" || nd.binOp == "!=" {
          if exprIsBareFnName(nd.binLeft) { fnValUsed = true }
          if exprIsBareFnName(nd.binRight) { fnValUsed = true }
        }
      }
      FieldInit => {
        if exprIsBareFnName(nd.fiValue) { fnValUsed = true }
      }
      // A bare named function as a call argument: a builtin method (`m.set(k, inc)`) has no
      // annotation to flip the machinery otherwise, unlike a user call's param TypeRef.
      Call => {
        const cfvArgs = nd.callArgs
        let cfv = 0
        while cfv < cfvArgs.length {
          if exprIsBareFnName(cfvArgs[cfv]) { fnValUsed = true }
          cfv = cfv + 1
        }
      }
      // A closure if-value whose arm is a bare named function needs the same flip a lambda arm
      // gets during lifting; the loop visits every `IfStmt`, so binding/return/argument alike are covered.
      IfStmt => {
        if exprIsBareFnName(ifArmValueExpr(nd.ifThen)) { fnValUsed = true }
        if nd.ifElse >= 0 {
          const el = nodeAt(nd.ifElse)
          if el is Block {
            if exprIsBareFnName(ifArmValueExpr(nd.ifElse)) { fnValUsed = true }
          }
        }
      }
      // A source function-type annotation flips the machinery too: the annotated cell is a
      // closure fat-pointer whose call site `call_ref`s through it, so its signature must intern.
      TypeRef => {
        if tyIsFuncType(i) { fnValUsed = true }
        // A closure-array annotation's elements are closures too, so it flips the machinery on;
        // without this an array whose only function-type mention is the annotation leaves signatures un-interned.
        if nameIsClosureArrayTy(i) == 1 { fnValUsed = true }
        // A nullable-closure annotation is a closure fat-pointer cell too, so its `$fnsig` must
        // intern even when the value is only ever `null` (no lambda elsewhere flips the machinery).
        if nodeTyIsNulClosure(i) { fnValUsed = true }
        // A shape annotation with a closure field needs the same flip, even for a `null`-only value.
        // `tyReachesClosure` asks directly whether this type reaches a closure through any of those positions.
        if nodeTyReachesClosure(i) { fnValUsed = true }
      }
      // An inferred closure-element array literal needs the same flip as the annotation form,
      // but only when the element itself constructs a closure — one merely containing one must not.
      ArrayLit => {
        // The same predicate the three `arrLit*` consumers use.
        if arrElemIsClosureTy(i, -1) { fnValUsed = true }
      }
      // Every other node makes no bare function-value use.
      NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | Member | OptMember | Paren | ErrExpr | Param | WhileStmt | BreakStmt | ContinueStmt | Block | Program | FieldDef | TypeDecl | ObjLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
    }
    i = i + 1
  }
  0
}

export function collectMapFilterUse() {
  mfPinCalls = Map()
  let i = 0
  while i < P.nodes.length {
    const nd = nodeAt(i)
    if nd is Call && nd.callFn >= 0 {
      const callee = nodeAt(nd.callFn)
      if callee is Member {
        if callee.memProp == "map" || callee.memProp == "filter" {
          if nd.callArgs.length == 1 {
            fnValUsed = true
            if callee.memProp == "map" {
              const fe = mfCallbackFe(nd.callArgs[0], -1)
              const csr = if fe < 0 { mapCallStructResultRow(i) } else { -1 }
              const mlt = mfListResultElemTy(i, -1)
              // A nullable-record result, a union's arm included, reads through its own
              // `| null` row, which the callback's return kind does not name (D10890, D12820).
              const nrt = mfNulRecResultElemTy(i, -1)
              if nrt >= 0 { rlInternOfTy(nrt) }
              if mlt >= 0 {
                // A list-returning callback's result is a ref list of lists, which no
                // annotation may have interned (D4870).
                rlInternOfTy(mlt)
              } else if fe >= 0 && mfCbResultIsStrList(fe) {
                // A string- or `string | null`-returning callback's result list may be the program's only
                // one, so force its wrapper/backing collection.
              } else if fe >= 0 && fnRetIsRecordRow(fe) {
                // A struct-returning callback's result is a new ref list with no `Q[]` annotation to force
                // its slot, so intern it here at the row `cloRetValSlot` names.
                const rsi = cloRetValSlot(fe)
                if rsi >= 0 && rsi < sNames.length {
                  // Hinted with the struct table's own type column, so the hint skips `resolveAnnot` rather
                  // than racing it; the read is bounded since `sTyIx` is padded lazily and a short column yields -1 (today's unhinted call).
                  rlInternNameTy(sNames[rsi], RLK_STRUCT, rlColAt(sTyIx, rsi))
                }
              } else if fe >= 0 && cloRetValKind(fe) == "variant" {
                // A concrete-variant-returning callback (a collapse): interns the variant's
                // ref-list slot (kind 1 — its element heap is `variantHeap(vi)`).
                const cvi = cloRetValSlot(fe)
                if cvi >= 0 && cvi < uVariants.length {
                  // Hinted with the variant table's TYPE column, same provenance and
                  // same bound as the struct arm above.
                  rlInternNameTy(
                    uVariants[cvi],
                    RLK_STRUCT,
                    rlColAt(uVarTyIx, cvi),
                  )
                }
              } else if (
                fe >= 0
                && cloRetValKind(fe) == "union"
                && unNames.length > 0
              ) {
                // A union-returning callback's result is a ref list of union boxes; interns the union
                // alias's slot so a map whose source is not itself a union array still has a result backing.
                const mur = mapUnionResultRow(i, -1)
                if mur >= 0 {
                  rlInternNameTy(unNames[mur], RLK_UNION, rlColAt(unTyIx, mur))
                }
                if tyHasTyVar(nodeTyIxOf(i)) { mfPinCalls.set(i, true) }
              } else if csr >= 0 && csr < sNames.length {
                // A closure-VALUE callback (`f: (A) => B` delivered as a parameter or binding)
                // has no lifted entry to ask, so the call's own recorded type names the struct
                // row its result list needs; without it the result has no ref-list row (D2301).
                rlInternNameTy(sNames[csr], RLK_STRUCT, rlColAt(sTyIx, csr))
              }
            }
          }
        }
      }
    }
    i = i + 1
  }
  if mfPinCalls.length > 0 {
    let f = 0
    while f < fnStmts.length {
      const fd = nodeAt(fnStmts[f])
      if fd is FuncDecl { mfInternPinRows(fd.fnBody, fnStmts[f]) }
      f = f + 1
    }
  }
  0
}

// The union `.map` calls whose recorded element names a type parameter or hole, so each
// instance holding one interns the row its own pin names.
let mfPinCalls: {[i32]: boolean} = Map()

// Interns, for each such call under `ix` in function `fnIx`'s own body (a nested function is
// its own frame), the ref-list row of the union its result holds at that frame's pin (D3092).
function mfInternPinRows(ix: i32, fnIx: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  if nodeAt(ix) is FuncDecl { return 0 }
  if mfPinCalls.get(ix) ?? false {
    const r = mapUnionResultRow(ix, fnIx)
    if r >= 0 { rlInternNameTy(unNames[r], RLK_UNION, rlColAt(unTyIx, r)) }
  }
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    mfInternPinRows(kids[k], fnIx)
    k = k + 1
  }
  0
}

// The struct-table row of the element of the `.map` call at `callIx`'s recorded `S[]` type,
// or -1 when the type is not an array of a registered struct.
function mapCallStructResultRow(callIx: i32): i32 {
  const ty = nodeTyIxOf(callIx)
  if ty < 0 || ty >= T.tys.length { return -1 }
  const at = tyAt(ty)
  if at is TyArray { return structRowOfTy(at.aElem) }
  -1
}

// Whether function type `ty` (its `| null` peeled) has a result that is a union of a scalar and
// a composite member that no registration admitted. A closure member is composite, a literal
// union scalar.
function nulCloMixedUnionUnregisteredTy(ty: i32) {
  const rt = tyStepRet(tyPeelNul(ty))
  if rt < 0 { return false }
  const t = tyAt(rt)
  const ms: i32[] = []
  if t is TyUnion {
    for m in t.uMembers { ms.push(m) }
  } else if t is TyNullable {
    if t.nInner < 0 { return false }
    const it = tyAt(t.nInner)
    if it is TyUnion {
      for m in it.uMembers { ms.push(m) }
    } else {
      ms.push(t.nInner)
    }
  } else {
    return false
  }
  let hasScalar = false
  let hasComposite = false
  for m in ms {
    if m < 0 || tyAt(m) is TyFunc {
      hasComposite = true
    } else if m != TY_NULL {
      if boxTagOfTy(m) >= 0 || tyIsLitUnion(m) {
        hasScalar = true
      } else {
        hasComposite = true
      }
    }
  }
  if !hasScalar || !hasComposite { return false }
  if unRowOfTyKey(rt) >= 0 { return false }
  if isValueUnionTyOr(rt) == 1 { return false }
  if tyIsMapMemberUnion(rt) { return false }
  true
}

// Is the annotation at `ix` spelled as an array? The parser's tree where it survives, else the
// checker's type: a synthesized or canon-rewritten annotation is a list exactly when its type is.
function annSpelledArray(ix: i32): boolean {
  const root = annTsOf(ix)
  if root >= 0 { return tsKind[root] == TS_ARR }
  tyIsArray(nodeTyIxOf(ix))
}

// Is the array annotation at `ix` one whose recorded type still holds a type parameter
// (`{v: T}[]`, `W<T>[]`)? Only a generic original's annotation does; an instance's is pinned.
function annArrOverTyParam(ix: i32): boolean {
  if !annSpelledArray(ix) { return false }
  tyHasTyVar(nodeTyIxOf(ix))
}

// Is the array annotation at `ix` a `(T | null)[]` whose element is a nullable type parameter?
// Asked of the recorded type, so a parameter canon renamed after a same-named alias still counts.
function annNulArrOverTyParam(ix: i32): boolean {
  if !annSpelledArray(ix) { return false }
  const t = nodeTyIxOf(ix)
  if t < 0 { return false }
  const at = tyAt(t)
  if !(at is TyArray) { return false }
  if at.aElem < 0 { return false }
  const nt = tyAt(at.aElem)
  if !(nt is TyNullable) { return false }
  if nt.nInner < 0 { return false }
  tyAt(nt.nInner) is TyVar
}

// Whether node `ix` is typed a map whose value is a tagged set of functions, which an index read
// reads as the id `.get` reads.
// A function map's index read `m[k]` at node `ix` is the `.get(k)` box too, where nothing else
// spells it (D15139): registers that box. A read minted after the collect pass calls it itself.
export function collectFnTagMapReadBox(ix: i32) {
  const pn = nodeAt(ix)
  if !(pn is Index) || !exprIsFnTagMap(pn.idxArr) { return 0 }
  const xunTy = nodeTyIxOf(ix)
  const xun = nulNumScalarUnionName(xunTy)
  if xun != "" { registerNulScalarBox(57, xun, xunTy) }
  0
}

function exprIsFnTagMap(ix: i32): boolean {
  const r = unwrapParen(ix)
  if r < 0 { return false }
  const t = nodeTyIxOf(r)
  if t < 0 || t >= T.tys.length { return false }
  const m = tyAt(t)
  m is TyMap && fnTagSetIsTagged(fnTagSetOfTy(m.mVal))
}
