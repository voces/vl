// The value-union half, read from the rung `recordInferRet` banked rather than re-derived
// from the name it rendered: three of the adoption ladder's rungs are value-union
// producers.
function inferRetIsValueUnionAt(inRow: i32, inm: string): boolean {
  // No entry means no name, so do not scan the registry for one: `inm` is "" exactly when
  // `inRow < 0`, and the union registry never holds an empty name.
  if inm == "" { return false }
  if inRow < 0 { return isValueUnionName(inm) }
  inferRetRungIsValueUnion(inRow)
}

// The registry-membership half, off the same row. `isUName` scans `unNames` comparing
// strings; `unRowOfCanon` compares interned structural ids, the index that agrees.
function inferRetIsUnionAt(inRow: i32, inm: string): boolean {
  // The same empty-name short-circuit as `inferRetIsValueUnionAt`.
  if inm == "" { return false }
  if inRow < 0 { return isUName(inm) }
  const row = inferRetTyIxAt(inRow)
  if row < 0 { return isUName(inm) }
  unRowOfCanon(row) >= 0
}

// The litunion half of the inferred-return kind decision, asked of the arena row the table
// entry records rather than of the rendered name. `tyIsLitUnion` is structural, so it
// escapes both name hazards: canon softening makes the recorded name the lowering while the
// row is the precise type, and the arena is not hash-consed.
function inferRetIsLitUnionAt(inRow: i32, inm: string): boolean {
  if inRow < 0 { return nameIsLitUnionType(inm) }
  const row = inferRetTyIxAt(inRow)
  if row < 0 { return nameIsLitUnionType(inm) }
  tyIsLitUnion(row)
}

// Could this functype's result be a mixed scalar-plus-composite union? `false` is a definite
// no, so the caller knows `nulCloMixedUnionUnregistered` would answer false without
// rendering the type. This is the guard's answer, not its early-out: an atom count is a fact
// about the spelling, while the verdict is structural.
function cloResultMaybeMixed(tyIx: i32): boolean {
  if tyIx < 0 { return false }
  const t = T.tys[tyIx]
  if !(t is TyFunc) { return false }
  const fr = t.fnRet
  if fr < 0 { return false }
  const frt = T.tys[fr]
  if frt is TyUnion { return unionArmsMixed(frt.uMembers) }
  // A `| null` result is a wrapper here and an atom in the spelling; the mix question is
  // about what is inside it.
  if frt is TyNullable {
    if frt.nInner < 0 { return false }
    const it = T.tys[frt.nInner]
    if it is TyUnion { return unionArmsMixed(it.uMembers) }
    return false
  }
  false
}

// Do these union members carry both a scalar (prim or literal) and a composite (object,
// map, array or closure) arm? A closure counts composite, mirroring the name guard's
// `nameIsFuncTypeAtom` exception.
function unionArmsMixed(ms: i32[]): boolean {
  let hasScalar = false
  let hasComposite = false
  let i = 0
  while i < ms.length {
    if ms[i] >= 0 {
      const m = T.tys[ms[i]]
      if m is TyObj { hasComposite = true }
      else if m is TyMap { hasComposite = true }
      else if m is TyArray { hasComposite = true }
      else if m is TyFunc { hasComposite = true }
      else if m is TyPrim { hasScalar = true }
      else if m is TyLit { hasScalar = true }
    }
    i = i + 1
  }
  hasScalar && hasComposite
}

// The field-annotation node's row, routed through the canon column where canon rewrote the
// node. `canonEmitTypeNames` rewrites `TypeRef.tyName` in place and leaves `nodeTyIx`
// holding the type the checker recorded before that rewrite, so on a rewritten node the
// recorded element name is post-canon while `nodeTyIxOf` is pre-canon.
function fdRowOf(fdType: i32) {
  if canonRewroteNode(fdType) { return canonTyIxOf(fdType) }
  nodeTyIxOf(fdType)
}

// The variant identity column's literal rung: a bare literal annotation (`kind: "circle"`)
// renders through canon as a softened `string`, so two variants differing only in their tag
// record a character-identical row and fold as layout-equal twins. Every `TyLit` kind; the
// quotes keep a literal `"i32"` tag from colliding with the type `i32` in a text column.
function variantFieldIdText(txt: string, tyIx: i32) {
  if tyIx < 0 { return txt }
  const t = T.tys[tyIx]
  if t is TyLit { return "\"" + t.litText + "\"" }
  txt
}

// The discriminant column's cell for a field whose annotation resolved to arena type `tyIx`:
// `tyIx` itself when it denotes a literal set, -1 otherwise (D1023). The identity column
// above cannot answer this — a multi-member set reaches it already softened by canon — so
// the arena index is banked beside the text rather than derived from it.
function litSetTyIxOf(tyIx: i32): i32 {
  if tyIx < 0 { return -1 }
  if tyIsLitSet(tyIx) { return tyIx }
  -1
}

// The hint for a field row pushed from a `FieldDef` node: the field's own row projected per
// `code`, declined for the names `repElemKey` keys nominally and for literal unions.
function fieldElemHintOf(fdType: i32, code: i32, elemNm: string) {
  if elemNm == "" { return -1 }
  if elemNameIsNominal(elemNm) { return -1 }
  if nameIsLitUnionType(elemNm) {
    // A registered alias resolves through `recordSFieldElemRowTy`'s own name rung; an inline
    // member set does not, since its spelling is not a declaration and the resolve would run
    // `resolveAnnot` — and this sidecar recorder is on the no-mint side of the mint-order
    // line. Hand the field's own arena type over instead.
    if nameIsInlineLitUnion(elemNm) { return nodeTyIxOf(fdType) }
    return -1
  }
  if nameIsLitUnionArray(elemNm) { return -1 }
  shapeFieldElemRow(fdRowOf(fdType), code)
}

// The arena element row of the list expression at `ix`, or -1 — the hint half of the
// ref-list interners' `(name, ty)` pair, which parses the name when it gets no row. Offered
// only beside the checker's own recorded element name, never at `refListElemNameOfExpr`:
// `repElemKey` keys that one's declared struct nominally.
function rlHintElemTy(ix: i32) {
  const rt = nodeRepTyIxOf(ix)
  if rt < 0 { return -1 }
  const t = T.tys[rt]
  if t is TyArray { return t.aElem }
  -1
}

// The arena element type of the array node `ix`, read off the checker's recorded type
// (`nodeTyIxOf`) rather than the rep one — the type `arrLitInferUnionElemName` renders its
// name from, so the members this feeds to `collectTyMembersReach` are that name's members.
function arrLitElemTyIxOf(ix: i32) {
  const at = nodeTyIxOf(ix)
  if at < 0 { return -1 }
  const t = T.tys[at]
  if t is TyArray { return t.aElem }
  -1
}

// A bounded read of a parallel type column beside a name array. These columns are padded
// lazily at their mint sites, so a row can exist in the name array before the column reaches
// it; -1 is the "no hint" value every hinted interner handles, which makes a short column
// degrade to the unhinted call instead of trapping.
function rlColAt(col: i32[], i: i32) {
  if i < 0 { return -1 }
  if i >= col.length { return -1 }
  col[i]
}

// Synthesize the `<elem>[]` annotation of an un-annotated empty `[]` binding whose element a
// downstream `.push` pinned. Returns 0 always; the mutation is `s.letType`, in place. One
// home for both storage classes: `collectLocals` types function-body locals only, so a
// module-scope `const outer = []` would otherwise take the i32-list default.
export function synthEmptyListAnn(letIx: i32) {
  const s = P.nodes[letIx]
  if s is LetDecl {
    // Synthesize the equivalent `<elem>[]` annotation from the checker's recorded type, so
    // the slot classifier, the later `[]`-seeding (`letAnnRefListKind`) and every other
    // annotation-reading path agree for all element types. Emit-time and post-check, so
    // `fmt` is untouched; a `TyVar` element renders "", which excludes the generic case.
    if s.letType < 0 {
      const synInit = unwrapParen(s.letInit)
      const synN = P.nodes[synInit]
      if synN is ArrayLit {
        if synN.arrElems.length == 0 {
          let synElem = nodeArrayElemName(synInit)
          // The niche-nullable element `nodeArrayElemName` does not render (D772): a hole
          // pinned to a `(P | null)[]` destination synthesizes no annotation and stores that
          // wrapper into an i32-list cell. The membership test is `unionSetHasNull`, not
          // `nullablePartOf`, which demands exactly two halves; the gate is a row existing.
          if synElem == "" {
            const nulEl = tyToEmitName(arrLitElemTyIxOf(synInit))
            if nulEl != "" && unionSetHasNull(nulEl) {
              if rlSlotByName(nulEl) >= 0 { synElem = nulEl }
              else if nameIsNulString(nulEl) { synElem = nulEl }
            }
          }
          if synElem != "" {
            // A struct element renders as a structural shape (`{v: i32}`) while the ref-list
            // machinery keys on the declared struct name, so resolve the shape to its
            // interned struct's name; a scalar element passes through unchanged. The
            // resolution is on the arena (`arrElemNominalOfTy`), so only the name is text.
            let synName = synElem
            const synNom = arrElemNominalOfTy(synInit)
            if synNom != "" { synName = synNom }
            // Re-forming an array name from an element name re-groups a union element:
            // `Cat|Dog[]` binds the `[]` to the last member, so the annotation the source
            // would write is `(Cat | Dog)[]`. Same rule as `rlCanonLitUnionAtoms`'s array
            // descent and `ensureRefElemTy`'s paren branch. A bare name is unaffected.
            let synArr = synName + "[]"
            if unionMemberCount(synName) > 1 { synArr = "(" + synName + ")[]" }
            // The array's own recorded type, not a re-parse of the name just re-formed, and
            // only where the spelling denotes the type handed (`emit_rewrite`'s rule). The
            // struct arm is where they part: the declared name resolves to the `TypeDecl`'s
            // row, the recorded type is the literal's own, and rep keys a struct nominally.
            let synTyIx = -1
            if synName == synElem { synTyIx = nodeTyIxOf(synInit) }
            const synTy = synthTypeRefTy(synArr, -1, synTyIx)
            // This synthesis postdates the last `collectA` run, so the intern pass cannot
            // bank the node's ref-list row — record it here, at the mint, on `collectA`'s own
            // predicate. `rlSlotByName` rather than `ensureRefElem`, because a late intern
            // would append a row past the resolved heap tables.
            if nameIsRefArray(synArr) {
              recordAnnRlSlot(synTy, rlSlotByName(synName), 0)
            }
            s.letType = synTy
          }
        }
      }
    }
  }
  0
}

// Whether `initIx` is the one initializer shape `synthNullableAnn` claims: a bare read of a
// scalar-valued map, whose `V | null` result reps as the shared value box.
function initNullableIsBoxScalar(initIx: i32) {
  if initIx < 0 { return false }
  mapReadScalarBoxKindTy(initIx) >= 0
}

// Synthesize the `T | null` annotation of an un-annotated binding whose initializer is
// already nullable — `synthEmptyListAnn`'s sibling: an annotation is the one input every
// downstream path reads, so writing the inferred type back makes the slot classifier agree
// without re-inferring. `collectInlineUnions` is the other half; neither lowers alone.
export function synthNullableAnn(letIx: i32) {
  const s = P.nodes[letIx]
  if s is LetDecl {
    if s.letType >= 0 { return 0 }
    if s.letInit < 0 { return 0 }
    const nty = nodeTyIxOf(unwrapParen(s.letInit))
    if nty < 0 { return 0 }
    const nt = T.tys[nty]
    if nt is TyNullable {
      // An unfilled hole (`let x = null`, inner -1) is A-infer-null's business: it has its
      // own usage-driven inference (`nliInferLet`) and no type to render yet.
      if nt.nInner < 0 { return 0 }
      // Only the box reps. Every other `T | null` carries "absent" in a niche — `boolean`
      // and a string litunion on an i32 sentinel, a string, struct, list, map or variant on
      // a nullable ref — and those bindings classify and lower without an annotation, so
      // synthesizing one diverts a working path onto a ladder expecting a different slot.
      if mapReadScalarBoxKindTy(s.letInit) < 0 { return 0 }
      const nm = tyToEmitName(nty)
      if nm == "" { return 0 }
      // Hand the recorded type over rather than re-parsing the rendered name, and only where
      // the spelling denotes the type handed (`emit_rewrite`'s rule). A nullable numeric
      // litunion is where they part: `tyToEmitName` renders the rep, so `N2 | null` renders
      // `i32|null`, which does not denote `TyNullable<1|2>` and leaves `unRowOfCanon` at -1.
      let synTyIx = nty
      if nulNumLitUnionBaseName(nty) != "" { synTyIx = -1 }
      s.letType = synthTypeRefTy(nm, -1, synTyIx)
    }
  }
  0
}

// The value spelling at the bottom of a chain of map spellings — `Circle` for both
// `{[string]: Circle}` and `{[string]: {[string]: Circle}}` — or "" when `name` is not a map
// (D156). Termination is structural rather than the hop bound: every cut strictly shortens
// the spelling, and a non-map result such as `mapValNameOf`'s garbled cut stops the loop.
function mapLeafValName(name: string) {
  let cur = mapValNameOf(name)
  if cur == "" { return "" }
  let hops = 0
  while hops < 8 {
    const nxt = mapValNameOf(cur)
    if nxt == "" { return cur }
    cur = nxt
    hops = hops + 1
  }
  cur
}

// Does `name` — a spelling one cut below a map annotation — reach a union arm through further
// map hops, and is that arm's layout uncontested (D171)? Un-gated, the deeper rung costs
// working programs wherever a layout twin is declared: a half-pinned chain is worse than an
// un-pinned one, which rides the arm/twin conflation the mv and ref-list layers still carry.
function pinArmDeepUncontested(name: string) {
  if name == "" { return false }
  const leaf = mapLeafValName(name)
  if leaf == "" { return false }
  if variantIndexOf(leaf) < 0 { return false }
  !armLayoutContested(leaf)
}

// The name-side form of `armPinAnnName`'s ref-list rung: does this spelling name a ref-list
// of a union arm — `Circle[]` yes, `Circle`, `{[string]: Circle}` and `i32[]` no. It exists
// because `dstPinPushAnn`'s element arm holds a bare string and cannot ask the node-keyed
// rung (D184). No `armLayoutContested` gate: that boundary is the deep-map peel's, not this.
function pinArmListName(name: string) {
  if name == "" { return false }
  const leaf = arrLeafNameOf(name)
  if leaf == name { return false }
  variantIndexOf(leaf) >= 0
}

// The one home for "does this type annotation name a concrete union arm a literal must be
// pinned onto" — a bare arm (`Circle`) or a ref-list of one (`Circle[]`), and "" for
// everything else. Gated on `retVariantFlag`, the predicate a variant param or result cell is
// emitted from, so the pin fires exactly where the destination's own cell is an unboxed ref.
function armPinAnnName(tyIx: i32) {
  if tyIx < 0 { return "" }
  if retVariantFlag(tyIx) == 1 { return tyNameOf(tyIx) }
  if retRefArrFlag(tyIx) == 1 {
    const rae = retRefArrElemName(tyIx)
    if rae != "" {
      if variantIndexOf(rae) >= 0 { return tyNameOf(tyIx) }
      // Not widened to `pinArmListName(rae)` here: every caller of this rung also requires
      // `armPinLitInit`, whose widest producer is a value of depth one (D184).
    }
  }
  // A map whose value names an arm (`{[string]: Circle}`), the third container this seam
  // reaches. `variantIndexOf` also fences off `mapValNameOf`'s garbled non-map cut (D87).
  const mvn = mapValNameOf(tyNameOf(tyIx))
  if mvn != "" {
    if variantIndexOf(mvn) >= 0 { return tyNameOf(tyIx) }
    // …and at every depth, not one (D156). Declining here is not neutral: `dstPinPushAnn`
    // reads the "" as a destination disagreement, so one nested-map delivery vetoes the pin.
    if pinArmDeepUncontested(mvn) { return tyNameOf(tyIx) }
  }
  ""
}

// A literal producer, bare or one list deep — the second half of the shared gate: an object
// literal's row is chosen by a field-set scan, so it is the one producer an annotation may
// re-aim without contradicting a decision made elsewhere. A local initialized from a call, an
// ident or a param already carries its producer's committed rep.
function armPinLitInit(initIx: i32) {
  if initIx < 0 { return false }
  const iv = P.nodes[unwrapParen(initIx)]
  if iv is ObjLit { return true }
  if iv is ArrayLit {
    if iv.arrElems.length >= 1 {
      const e0 = P.nodes[unwrapParen(iv.arrElems[0])]
      if e0 is ObjLit { return true }
    }
  }
  // A bare `Map()` or `Set()` commits no value rep at its initializer, so its slot is chosen
  // by later use. The constructor name is the test, not `exprMap`: a map-returning call has
  // already committed its producer's rep.
  if iv is Call {
    const mc = P.nodes[unwrapParen(iv.callFn)]
    if mc is Ident {
      if mc.identName == "Map" || mc.identName == "Set" {
        if iv.callArgs.length == 0 { return true }
      }
    }
  }
  false
}

// Synthesize the return annotation onto an un-annotated local that is the function's returned
// value and whose initializer is an anonymous object literal (D39). Returns 0 always; the
// mutation is `s.letType`, in place. An anonymous shape has two nominal claimants and only
// context separates them, so the scope is the struct/variant seam and a literal producer.
export function synthRetPinAnn(letIx: i32, fnIx: i32) {
  if fnIx < 0 { return 0 }
  const s = P.nodes[letIx]
  if s is LetDecl {
    if s.letType >= 0 { return 0 }
    if s.letInit < 0 { return 0 }
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      if fn.fnRet < 0 { return 0 }
      // The gate: a concrete-variant return, bare or as a ref-list element. `armPinAnnName`
      // is the one home for it, shared with `synthDstPinAnn`, so the two cannot drift.
      const pinName = armPinAnnName(fn.fnRet)
      if pinName == "" { return 0 }
      // The returned local: the tail value resolves through an un-annotated alias chain to
      // this binding, so the pin lands on the let holding the literal, not an intermediate
      // that names it. `retLocalLetOfBlock` is `criRetLocalLet`'s own lookup, shared.
      const rx = fnRetExprOf(fnIx)
      if rx < 0 { return 0 }
      if retLocalLetOfBlock(fn.fnBody, rx) != letIx { return 0 }
      // A literal producer, bare or one list deep.
      if !armPinLitInit(s.letInit) { return 0 }
      // D501 — the same decline as `dstPinAnnIn`'s, at the pin with no destination-agreement
      // gate: this one reads only the return annotation, so a second destination of the other
      // element kind cannot make it disagree.
      if letListDestKindConflict(letIx, fnIx) { return 0 }
      const pinTy = synthTypeRefTy(pinName, -1, nodeTyIxOf(fn.fnRet))
      // The ref-list row, banked on the new node at its mint: this synthesis postdates the
      // last `collectA` run, and the row must be the one the return annotation already
      // interned, or the local's wrapper and the function's result wrapper are two slots.
      const pinSlot = tyAnnRefListSlot(fn.fnRet)
      if pinSlot > 0 { recordAnnRlSlot(pinTy, pinSlot, 0) }
      s.letType = pinTy
    }
  }
  0
}

// Synthesize the destination's annotation onto an un-annotated local whose initializer is an
// anonymous object literal — `synthRetPinAnn`'s sibling at the destinations a `return` is not
// (D81). Returns 0 always; the mutation is `s.letType`, in place. Four destinations — global
// assignment, callee param, annotated local binding, local assignment — and all must agree.
export function synthDstPinAnn(letIx: i32, fnIx: i32, rootIx: i32) {
  if fnIx < 0 { return 0 }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    // The enclosing function's declared result is a destination too, handed to the shared
    // body rather than recorded by `dstPinScan` because it is one annotation for the whole
    // body however many `return`s reach it. It exists for the disagreement gate, not to pin;
    // an un-annotated result records nothing, since an inferred return is no nominal claim.
    return dstPinAnnIn(letIx, fn.fnBody, fn.fnRet, fnIx, rootIx)
  }
  0
}

// The module-scope twin (D139): a top-level binding reaches the same four destinations, and
// the scan needs only a scope to resolve identifiers in, so this is the same body with the
// program node as that scope rather than an `fnIx < 0` arm the callee cannot derive. The two
// `-1`s: the module has no result annotation, and a global is returned by no function.
function synthGlobalDstPinAnn(letIx: i32, rootIx: i32) {
  dstPinAnnIn(letIx, rootIx, -1, -1, rootIx)
}

// The shared body of both entry points: pin `letIx`'s annotation from the destinations it is
// delivered to within the scope `bodyIx`, with `retIx` the scope's declared result annotation
// (-1 where the scope has none). Split out for D139 — the two scopes differ in nothing but
// those arguments, and a copy would be the second place the disagreement gate could drift.
function dstPinAnnIn(
  letIx: i32,
  bodyIx: i32,
  retIx: i32,
  fnIx: i32,
  rootIx: i32,
) {
  const s = P.nodes[letIx]
  if s is LetDecl {
    if s.letType >= 0 { return 0 }
    if !armPinLitInit(s.letInit) { return 0 }
    const dstN: string[] = []
    const dstT: i32[] = []
    if retIx >= 0 { dstPinRetDest(bodyIx, retIx, letIx, dstN, dstT) }
    dstPinScan(bodyIx, bodyIx, letIx, dstN, dstT)
    dstPinCallerDests(letIx, fnIx, rootIx, dstN, dstT)
    if dstN.length == 0 { return 0 }
    const pinName = dstN[0]
    if pinName == "" { return 0 }
    let i = 1
    while i < dstN.length {
      if dstN[i] != pinName { return 0 }
      i = i + 1
    }
    // D501 — decline where the binding's own list literal has a second declared destination
    // of the other element kind: the pin would commit the plain-struct row and hide a program
    // the emitter cannot lower either way. Declined, D411's positioned reject names it.
    if letListDestKindConflict(letIx, fnIx) { return 0 }
    // The annotation's own recorded type is handed over rather than re-resolved from the
    // spelling (`emit_rewrite`'s rule): the spelling denotes exactly the type handed, and
    // `nameToTy` does not hash-cons. `-1` is the element pin, where the spelling is a cut of
    // the destination's annotation rather than the annotation itself.
    let pinTyIx = -1
    if dstT[0] >= 0 { pinTyIx = nodeTyIxOf(dstT[0]) }
    const pinTy = synthTypeRefTy(pinName, -1, pinTyIx)
    // The ref-list row for a `Circle[]` destination, banked at the mint for the reason
    // `synthRetPinAnn` banks its own: this synthesis postdates the last `collectA` run, and
    // the row must be the destination annotation's own or the two wrappers are two slots.
    if dstT[0] >= 0 {
      const pinSlot = tyAnnRefListSlot(dstT[0])
      if pinSlot > 0 { recordAnnRlSlot(pinTy, pinSlot, 0) }
    }
    s.letType = pinTy
    dstPinFired = dstPinFired + 1
  }
  0
}

// The call site is a destination too, for a binding its function returns (D155): a function
// that builds a value and returns it has no destination inside itself. Three gates keep it
// from being a whole-program scan — the enclosing result is un-annotated, the binding is the
// value handed back, and only then is each caller scope scanned as its own `bodyIx`.
function dstPinCallerDests(
  letIx: i32,
  fnIx: i32,
  rootIx: i32,
  outN: string[],
  outT: i32[],
) {
  if fnIx < 0 { return 0 }
  if rootIx < 0 { return 0 }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    if fn.fnRet >= 0 { return 0 }
    const rx = fnRetExprOf(fnIx)
    if rx < 0 { return 0 }
    if retLocalLetOfBlock(fn.fnBody, rx) != letIx { return 0 }
    let fe = 0
    while fe < fnStmts.length {
      const ofx = fnStmts[fe]
      if ofx != fnIx {
        const ofn = P.nodes[ofx]
        if ofn is FuncDecl {
          dstPinScan(ofn.fnBody, ofn.fnBody, letIx, outN, outT)
        }
      }
      fe = fe + 1
    }
    // The module's own statements, with the program node as the scope: `dstPinScan` skips a
    // `FuncDecl` child, so the top-level walk never sees a function's body twice.
    dstPinScan(rootIx, rootIx, letIx, outN, outT)
  }
  0
}

// Collect, into the parallel `outN` / `outT`, the pin name every destination inside `ix`
// demands of the binding at `letIx`, and the annotation node to source its recorded type from
// (-1 = mint from the name); a destination with no nominal claim pushes "". `bodyIx` is the
// scope chains resolve in, and no nested `FuncDecl` is entered: a shadow would fake a delivery.
function dstPinScan(
  ix: i32,
  bodyIx: i32,
  letIx: i32,
  outN: string[],
  outT: i32[],
) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = P.nodes[ix]
  if ix != bodyIx {
    if n is FuncDecl { return 0 }
  }
  // Four legs, four functions, and the sets they move are pairwise disjoint: no leg closes
  // another's cells and no cell needs two.
  dstPinGlobalAssign(ix, bodyIx, letIx, outN, outT)
  dstPinLocalDest(ix, bodyIx, letIx, outN, outT)
  dstPinCallArgs(ix, bodyIx, letIx, outN, outT)
  dstPinMapValue(ix, bodyIx, letIx, outN, outT)
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    dstPinScan(kids[k], bodyIx, letIx, outN, outT)
    k = k + 1
  }
  0
}

// Does any `return` inside `bodyIx` hand back the binding at `letIx`? If so, record the
// enclosing function's declared result `retIx` as one of its destinations. `fnRetExprOf` is
// not enough: it answers with the tail value, and a binding can reach an earlier `return`, so
// this walks every `RetStmt` in the body.
function dstPinRetDest(
  bodyIx: i32,
  retIx: i32,
  letIx: i32,
  outN: string[],
  outT: i32[],
) {
  dstPinRetWalk(bodyIx, bodyIx, retIx, letIx, outN, outT)
}

function dstPinRetWalk(
  ix: i32,
  bodyIx: i32,
  retIx: i32,
  letIx: i32,
  outN: string[],
  outT: i32[],
) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = P.nodes[ix]
  if ix != bodyIx {
    if n is FuncDecl { return 0 }
  }
  if n is RetStmt { dstPinPushAnn(retIx, n.retArg, bodyIx, letIx, outN, outT) }
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    dstPinRetWalk(kids[k], bodyIx, retIx, letIx, outN, outT)
    k = k + 1
  }
  0
}

// Record what the destination annotated `annIx` demands of `letIx`, given that `srcExpr` is
// the expression delivered to it. Nothing is recorded unless the binding actually reaches this
// destination. Two delivery shapes: a whole-value delivery wants the destination's own
// spelling, an element delivery (`const xs: Circle[] = [c]`) wants the element's cut.
function dstPinPushAnn(
  annIx: i32,
  srcExpr: i32,
  bodyIx: i32,
  letIx: i32,
  outN: string[],
  outT: i32[],
) {
  if srcExpr < 0 { return 0 }
  if dstPinSrcIs(bodyIx, srcExpr, letIx) {
    outN.push(armPinAnnName(annIx))
    outT.push(annIx)
    return 0
  }
  // The element delivery, at whatever depth the binding sits at (D243): the cut is the scan's
  // depth, not the gate's, and a depth rather than a boolean because the pinned spelling has to
  // match the level — `Circle[][]` at depth 1, `Circle[]` at depth 2.
  const ed = dstPinElemDepthAt(bodyIx, srcExpr, letIx, 0)
  if ed > 0 {
    outN.push(dstPinElemAnnName(annIx, ed))
    outT.push(-1)
  }
  0
}

// How many list levels below `ex` the binding at `letIx` sits, or -1 when it is not among its
// elements at any depth. Never 0: the whole-value delivery is the caller's own first question.
// Two ways down a level — a nested `ArrayLit`, and an un-annotated binding whose initializer is
// a list literal. An annotated intermediate is its own nominal claim and is not descended.
function dstPinElemDepthAt(bodyIx: i32, ex: i32, letIx: i32, depth: i32): i32 {
  if ex < 0 { return -1 }
  if depth > 4 { return -1 }
  if depth > 0 {
    if dstPinSrcIs(bodyIx, ex, letIx) { return depth }
  }
  const u = unwrapParen(ex)
  const n = P.nodes[u]
  if n is ArrayLit {
    let i = 0
    while i < n.arrElems.length {
      const d = dstPinElemDepthAt(bodyIx, n.arrElems[i], letIx, depth + 1)
      if d > 0 { return d }
      i = i + 1
    }
    return -1
  }
  if n is Ident {
    const li = dstPinUnannListLet(bodyIx, n.identName)
    if li >= 0 && li != letIx {
      const ld = P.nodes[li]
      if ld is LetDecl {
        return dstPinElemDepthAt(bodyIx, ld.letInit, letIx, depth)
      }
    }
  }
  -1
}

// The binding `name` resolves to, when it is un-annotated and its initializer is a list
// literal — the one shape the depth walk above may descend through — else -1. Local first then
// global, the order every storage-class dispatch in this family uses, so a binding shadowing a
// same-named global answers for the cell that actually holds the value.
function dstPinUnannListLet(bodyIx: i32, name: string): i32 {
  let li = parentLetOf(bodyIx, name)
  if li < 0 { li = globalLetOf(name) }
  if li < 0 { return -1 }
  const d = P.nodes[li]
  if d is LetDecl {
    if d.letType >= 0 { return -1 }
    if d.letInit < 0 { return -1 }
    const iv = P.nodes[unwrapParen(d.letInit)]
    if iv is ArrayLit { return li }
  }
  -1
}

// The destination annotation's element spelling `dep` list levels in, gated on that spelling
// naming an arm — bare, or a ref-list of one. "" is the disagreement the caller records, not a
// decline. `retRefArrElemName` takes the first cut, which has a node to read, and
// `arrElemNameRaw` every cut after it, which holds only a string.
function dstPinElemAnnName(annIx: i32, dep: i32) {
  if retRefArrFlag(annIx) != 1 { return "" }
  let nm = retRefArrElemName(annIx)
  let k = 1
  while k < dep {
    if nm == "" { return "" }
    nm = arrElemNameRaw(nm)
    k = k + 1
  }
  if nm == "" { return "" }
  if variantIndexOf(nm) >= 0 { return nm }
  // The element is itself a ref-list of an arm (`Circle[]` cut from a `Circle[][]`
  // destination) — `pinArmListName`'s rung, hand-inlined here at depth (D184).
  if pinArmListName(nm) { return nm }
  ""
}

// Does the value of `ex` come from the binding at `letIx`? `retLocalLetOfBlock` is the same
// "which binding supplies this value" lookup `criRetLocalLet` and `synthRetPinAnn` make: it
// walks an un-annotated alias chain and stops at the first annotated link. An
// identity-forwarding generic is transparent (`dstPinFwdArg`); a transforming callee is not.
function dstPinSrcIs(bodyIx: i32, ex: i32, letIx: i32) {
  dstPinSrcIsAt(bodyIx, ex, letIx, 0)
}

function dstPinSrcIsAt(bodyIx: i32, ex: i32, letIx: i32, depth: i32) {
  if ex < 0 { return false }
  if depth > 4 { return false }
  if retLocalLetOfBlock(bodyIx, ex) == letIx { return true }
  const u = unwrapParen(ex)
  const n = P.nodes[u]
  if n is Call {
    const j = dstPinFwdArg(u)
    if j >= 0 && j < n.callArgs.length {
      return dstPinSrcIsAt(bodyIx, n.callArgs[j], letIx, depth + 1)
    }
    // An ordinary call is transparent to the binding it hands back (D155): the callee's result
    // is un-annotated, so nothing inside it restates the value's type and the only nominal
    // claim is at the call site. A declared result is its own destination, not a hop.
    if dstPinCalleeRetLet(u) == letIx { return true }
  }
  // An element-preserving conduit, read back with an index (D157): `reverse([c])[0]` hands back
  // the very object `c` holds, through a callee whose result is spelled as one of its
  // parameters. Only an `Index` may consume it — read without the index, `reverse([c])` is a
  // `Circle[]`, and pinning one object from that destination would be a different program.
  if n is Index {
    const ia = P.nodes[unwrapParen(n.idxArr)]
    if ia is Call {
      const ej = dstPinElemFwdArg(unwrapParen(n.idxArr))
      if ej >= 0 && ej < ia.callArgs.length {
        return dstPinElemIsAt(bodyIx, ia.callArgs[ej], letIx, depth + 1)
      }
    }
  }
  false
}

// Does the list at `ex` have this binding among its elements? The element half of
// `dstPinSrcIsAt`, deliberately narrow: an `ArrayLit` whose elements the whole-value test
// claims, or a further element-preserving conduit. A bare identifier naming a list is not one,
// since its own row is already committed and re-aiming it would move a value rather than name it.
function dstPinElemIsAt(bodyIx: i32, ex: i32, letIx: i32, depth: i32): boolean {
  if ex < 0 { return false }
  if depth > 4 { return false }
  const u = unwrapParen(ex)
  const n = P.nodes[u]
  if n is ArrayLit {
    let i = 0
    while i < n.arrElems.length {
      if dstPinSrcIsAt(bodyIx, n.arrElems[i], letIx, depth + 1) { return true }
      i = i + 1
    }
    return false
  }
  if n is Call {
    const ej = dstPinElemFwdArg(u)
    if ej >= 0 && ej < n.callArgs.length {
      return dstPinElemIsAt(bodyIx, n.callArgs[ej], letIx, depth + 1)
    }
  }
  false
}

// The argument position a call forwards its elements from, or -1: the callee's return
// annotation is spelled exactly as one of its parameters' and that spelling mentions one of the
// callee's own type parameters (`function rv<T>(xs: T[]): T[]`). First match wins. The element
// twin of `dstPinFwdArg`, which instead requires the result to be a type parameter itself.
function dstPinElemFwdArg(callIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const cf = P.nodes[unwrapParen(c.callFn)]
    if cf is Ident {
      const cfe = fnIndexOf(cf.identName)
      if cfe >= 0 && cfe < fnStmts.length {
        const cfn = P.nodes[fnStmts[cfe]]
        if cfn is FuncDecl {
          if cfn.fnRet < 0 { return -1 }
          const rn = tyNameOf(cfn.fnRet)
          if rn == "" { return -1 }
          if !monoAnnHasTyParam(rn, cfn.fnTyParams) { return -1 }
          // A whole-value conduit is `dstPinFwdArg`'s and not this one's: it is crossed
          // above, and claiming it here too would give an `Index` one hop too many.
          if dstPinIsTyParam(rn, cfn.fnTyParams) { return -1 }
          let j = 0
          while j < cfn.fnParams.length {
            const pp = P.nodes[cfn.fnParams[j]]
            if pp is Param {
              if pp.parType >= 0 {
                if tyNameOf(pp.parType) == rn { return j }
              }
            }
            j = j + 1
          }
        }
      }
    }
  }
  -1
}

// The binding an ordinary un-annotated callee hands back, or -1 (D155). `retLocalLetOfBlock`
// is the same "which binding supplies this value" lookup, asked of the callee's body, so an
// alias chain inside it is walked by the same rule. A declared result answers -1 rather than
// the binding: the annotation is the destination, and reading through it would overrule it.
function dstPinCalleeRetLet(callIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const cf = P.nodes[unwrapParen(c.callFn)]
    if cf is Ident {
      const cfe = fnIndexOf(cf.identName)
      if cfe >= 0 && cfe < fnStmts.length {
        const cix = fnStmts[cfe]
        const cfn = P.nodes[cix]
        if cfn is FuncDecl {
          if cfn.fnRet >= 0 { return -1 }
          const crx = fnRetExprOf(cix)
          if crx < 0 { return -1 }
          return retLocalLetOfBlock(cfn.fnBody, crx)
        }
      }
    }
  }
  -1
}

// The argument position a call forwards its own value from, or -1: the callee's return
// annotation names one of its own type parameters, and some parameter is annotated with that
// same one (`function idg<T>(x: T): T`). First match wins.
function dstPinFwdArg(callIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const cf = P.nodes[unwrapParen(c.callFn)]
    if cf is Ident {
      const cfe = fnIndexOf(cf.identName)
      if cfe >= 0 && cfe < fnStmts.length {
        const cfn = P.nodes[fnStmts[cfe]]
        if cfn is FuncDecl {
          if cfn.fnRet < 0 { return -1 }
          const rn = tyNameOf(cfn.fnRet)
          if rn == "" { return -1 }
          if !dstPinIsTyParam(rn, cfn.fnTyParams) { return -1 }
          let j = 0
          while j < cfn.fnParams.length {
            const pp = P.nodes[cfn.fnParams[j]]
            if pp is Param {
              if pp.parType >= 0 {
                if tyNameOf(pp.parType) == rn { return j }
              }
            }
            j = j + 1
          }
        }
      }
    }
  }
  -1
}

function dstPinIsTyParam(name: string, typarams: string[]) {
  let i = 0
  while i < typarams.length {
    if typarams[i] == name { return true }
    i = i + 1
  }
  false
}

// Leg 1 — `gsto = c`, a module global assignment. The target must not resolve to a
// function-scoped binding: a local of the same name shadows the global, which is the order
// `monoModuleLetOf` declines in for the same reason, and leg 2 owns that case.
function dstPinGlobalAssign(
  ix: i32,
  bodyIx: i32,
  letIx: i32,
  outN: string[],
  outT: i32[],
) {
  const n = P.nodes[ix]
  if n is BinExpr {
    if n.binOp == "=" {
      const tg = P.nodes[unwrapParen(n.binLeft)]
      if tg is Ident {
        if parentLetOf(bodyIx, tg.identName) < 0 {
          const gli = globalLetOf(tg.identName)
          if gli >= 0 {
            const gd = P.nodes[gli]
            if gd is LetDecl {
              dstPinPushAnn(gd.letType, n.binRight, bodyIx, letIx, outN, outT)
            }
          }
        }
      }
    }
  }
  0
}

// Leg 2 — an annotated local destination, in both spellings: the binding `const o: Circle = c`
// and the assignment `let o: Circle = { r: 0 }` … `o = c`. One leg, because both read the same
// node's `letType`.
function dstPinLocalDest(
  ix: i32,
  bodyIx: i32,
  letIx: i32,
  outN: string[],
  outT: i32[],
) {
  const n = P.nodes[ix]
  if n is BinExpr {
    if n.binOp == "=" {
      const tg = P.nodes[unwrapParen(n.binLeft)]
      if tg is Ident {
        const lli = parentLetOf(bodyIx, tg.identName)
        if lli >= 0 {
          const ld = P.nodes[lli]
          if ld is LetDecl {
            dstPinPushAnn(ld.letType, n.binRight, bodyIx, letIx, outN, outT)
          }
        }
      }
    }
  }
  if n is LetDecl {
    // An un-annotated binding is a link in the chain, not a destination: `retLocalLetOfBlock`
    // walks through it to the binding that supplies the value, so recording it would push ""
    // and veto the pin the link exists to carry. The assignment arm above is deliberately not
    // symmetric — an un-annotated `o` is already committed by its own literal initializer.
    if ix != letIx && n.letType >= 0 {
      dstPinPushAnn(n.letType, n.letInit, bodyIx, letIx, outN, outT)
    }
  }
  0
}

// Leg 4 — `m["k"] = c`, an arm-valued map's value slot. The value spelling is cut from the map
// annotation by `mapValNameOf` and then gated on naming an arm, which also keeps out that cut's
// garbled non-map result. The pin's type index is -1 (mint from the name), for the element
// pin's reason: the spelling is a cut, so no node carries a recorded type to hand over.
function dstPinMapValue(
  ix: i32,
  bodyIx: i32,
  letIx: i32,
  outN: string[],
  outT: i32[],
) {
  const n = P.nodes[ix]
  if n is BinExpr {
    if n.binOp == "=" {
      const tg = P.nodes[unwrapParen(n.binLeft)]
      if tg is Index {
        const recv = P.nodes[unwrapParen(tg.idxArr)]
        if recv is Ident {
          if dstPinSrcIs(bodyIx, n.binRight, letIx) {
            let mapAnn = -1
            const mli = parentLetOf(bodyIx, recv.identName)
            if mli >= 0 {
              const md = P.nodes[mli]
              if md is LetDecl { mapAnn = md.letType }
            } else {
              const mgi = globalLetOf(recv.identName)
              if mgi >= 0 {
                const mgd = P.nodes[mgi]
                if mgd is LetDecl { mapAnn = mgd.letType }
              }
            }
            if mapAnn >= 0 {
              // The value cut of the receiver's annotation, gated on the value naming an arm
              // or reaching one through further map hops (D156): a nested map delivers a map
              // to the value cell, and the inner binding's pin is that map's spelling.
              const vn = mapValNameOf(tyNameOf(mapAnn))
              if vn != "" {
                if variantIndexOf(vn) >= 0 || pinArmDeepUncontested(vn) {
                  outN.push(vn)
                  outT.push(-1)
                }
              }
            }
          }
        }
      }
    }
  }
  0
}

// Leg 3 — `thru(c)`, a callee parameter. Positional, and a call with more arguments than the
// callee declares contributes nothing rather than reading past the parameter list. An open
// position is skipped rather than vetoed: a parameter annotated with the callee's own type
// parameter carries no nominal claim, and recording "" would decline on the channel's conduit.
function dstPinCallArgs(
  ix: i32,
  bodyIx: i32,
  letIx: i32,
  outN: string[],
  outT: i32[],
) {
  const n = P.nodes[ix]
  if n is Call {
    const cf = P.nodes[unwrapParen(n.callFn)]
    if cf is Ident {
      const cfe = fnIndexOf(cf.identName)
      if cfe >= 0 && cfe < fnStmts.length {
        const cfn = P.nodes[fnStmts[cfe]]
        if cfn is FuncDecl {
          const ps = cfn.fnParams
          let j = 0
          while j < n.callArgs.length {
            if j < ps.length {
              const pp = P.nodes[ps[j]]
              if pp is Param {
                let open = pp.parType < 0
                if !open {
                  // A position is open when its spelling mentions a type parameter, not only
                  // when it is one (D157): `xs: T[]` carries no more nominal claim than `x: T`,
                  // since the monomorphizer pins both from the argument. `monoAnnHasTyParam` is
                  // that predicate, covering the array, map, union and function-type grammars.
                  open = monoAnnHasTyParam(tyNameOf(pp.parType), cfn.fnTyParams)
                }
                if !open {
                  dstPinPushAnn(
                    pp.parType,
                    n.callArgs[j],
                    bodyIx,
                    letIx,
                    outN,
                    outT,
                  )
                }
              }
            }
            j = j + 1
          }
        }
      }
    }
  }
  0
}

// How many bindings this round of `synthDstPinAnns` pinned — the fixpoint counter, and the
// reason the pass below is a loop rather than a single walk (D171): a destination reads the
// receiver's annotation, so a pin can create a destination for a binding the same walk has
// already passed over.
let dstPinFired = 0

// The list literal's element row, keyed off the element's own committed rep rather than off
// the checker's structural shape (D163). A separate pass and not a rung: the classifiers must
// agree per slot but are called from two places, so a rung asking `parentLetOf` would answer
// at one and decline at the other, keying one literal to two rows. Runs before `monomorphize`.
export function scanArrLitCommit(rootIx: i32) {
  let fe = 0
  while fe < fnStmts.length {
    const fnIx = fnStmts[fe]
    const fn = P.nodes[fnIx]
    if fn is FuncDecl { alcWalk(fn.fnBody, fn.fnBody, fnIx) }
    fe = fe + 1
  }
  // The module's own statements, with the program node as the scope: `plScanStmt` has a
  // `Program` arm and no `FuncDecl` one, so a function's locals cannot leak into its map.
  if rootIx >= 0 { alcWalk(rootIx, rootIx, -1) }
  0
}

// Every `ArrayLit` lexically inside one scope, not descending into a nested `FuncDecl`, which
// has its own `fnStmts` row and is walked as its own body.
function alcWalk(ix: i32, bodyIx: i32, fnIx: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = P.nodes[ix]
  if ix != bodyIx {
    if n is FuncDecl { return 0 }
  }
  if n is ArrayLit {
    if n.arrElems.length >= 1 {
      // Every element must commit to the same name: `const xs = [c, d]` over two arms of one
      // union is a union-box list, and reading only the first would key it under one arm. A
      // heterogeneous literal has no single committed rep, so the bank stays empty and the
      // checker-typed union rung keeps it.
      const cn = alcCommitName(n.arrElems[0], bodyIx, fnIx, 0)
      let agree = alcNamesArm(cn)
      let ei = 1
      while ei < n.arrElems.length {
        if alcCommitName(n.arrElems[ei], bodyIx, fnIx, 0) != cn {
          agree = false
        }
        ei = ei + 1
      }
      if agree { recordArrLitCommitName(ix, cn) }
    }
  }
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    alcWalk(kids[k], bodyIx, fnIx)
    k = k + 1
  }
  0
}

// Does `name` reach a union arm — bare, or through the map grammar at any depth? The gate, and
// it is `armPinAnnName`'s question asked of a name instead of an annotation node: the
// struct/variant seam is the only place the checker's structural record and the element's
// committed rep can name different heaps (D39).
function alcNamesArm(name: string): boolean {
  if name == "" { return false }
  if variantIndexOf(name) >= 0 { return true }
  const leaf = mapLeafValName(name)
  if leaf == "" { return false }
  variantIndexOf(leaf) >= 0
}

// The type name the expression at `ex` has already committed its rep to, or "". Four sources,
// every one an annotation a user wrote or a pin synthesized and never an inference: a bound
// local, a parameter, a callee's declared result, and a callee's inferred result read through
// the binding that supplies it. Depth-bounded, since the arena is not this pass's to trust.
function alcCommitName(ex: i32, bodyIx: i32, fnIx: i32, depth: i32): string {
  if ex < 0 { return "" }
  if depth > 4 { return "" }
  const u = unwrapParen(ex)
  const n = P.nodes[u]
  if n is Ident {
    const lli = parentLetOf(bodyIx, n.identName)
    if lli >= 0 {
      const ld = P.nodes[lli]
      if ld is LetDecl {
        if ld.letType >= 0 { return tyNameOf(ld.letType) }
        // An un-annotated binding is a link in the chain, not the end of it —
        // `dstPinLocalDest`'s rule, shared through `retLocalLetOfBlock`: the alias re-names a
        // value, it does not re-rep one.
        return alcCommitName(ld.letInit, bodyIx, fnIx, depth + 1)
      }
      return ""
    }
    const pn = alcParamAnnName(fnIx, n.identName)
    if pn != "" { return pn }
    const gli = globalLetOf(n.identName)
    if gli >= 0 {
      const gd = P.nodes[gli]
      if gd is LetDecl {
        if gd.letType >= 0 { return tyNameOf(gd.letType) }
      }
    }
    return ""
  }
  if n is Call {
    const cf = P.nodes[unwrapParen(n.callFn)]
    if cf is Ident {
      const cfe = fnIndexOf(cf.identName)
      if cfe >= 0 && cfe < fnStmts.length {
        const cix = fnStmts[cfe]
        const cfn = P.nodes[cix]
        if cfn is FuncDecl {
          // A declared result is the commitment; nothing inside the callee can overrule the
          // claim it makes about its own result.
          if cfn.fnRet >= 0 { return tyNameOf(cfn.fnRet) }
          const crx = fnRetExprOf(cix)
          if crx < 0 { return "" }
          return alcCommitName(crx, cfn.fnBody, cix, depth + 1)
        }
      }
    }
    return ""
  }
  ""
}

// The annotation spelling of parameter `name` of the function at `fnIx`, or "". The parameter
// half of the lookup above: `parentLetOf` answers for a function's locals and a parameter is
// not one, yet it is the commitment an identity conduit's body hands back.
function alcParamAnnName(fnIx: i32, name: string): string {
  if fnIx < 0 { return "" }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    let j = 0
    while j < fn.fnParams.length {
      const pp = P.nodes[fn.fnParams[j]]
      if pp is Param {
        if pp.parName == name {
          if pp.parType >= 0 { return tyNameOf(pp.parType) }
          return ""
        }
      }
      j = j + 1
    }
  }
  ""
}

// The pre-monomorphization run of `synthDstPinAnn`, over every function body, and the ordering
// is a requirement: `synthRetPinAnn`'s home is `collectLocals`, which runs after
// `monomorphize`, by which time a hand-written generic conduit is cloned off the very row the
// literal resolved to. Its edges are `collectU` and `buildFnMap` before, `monomorphize` after.
export function synthDstPinAnns(rootIx: i32) {
  // To a fixpoint. The bound is a guard, not a policy: each round either pins at least one
  // binding or stops, and a binding is pinned at most once. 32 rather than 8 because a round is
  // consumed per level of the pin dependency chain and truncating leaves it half-pinned (D171);
  // the deepest chain the gates can pin is bounded by `mapLeafValName`'s own 8-cut cap.
  let round = 0
  while round < 32 {
    dstPinFired = 0
    let fe = 0
    while fe < fnStmts.length {
      const fnIx = fnStmts[fe]
      const fn = P.nodes[fnIx]
      if fn is FuncDecl { dstPinSynthWalk(fn.fnBody, fn.fnBody, fnIx, rootIx) }
      fe = fe + 1
    }
    // The module run walks `globalStmts` rather than the statement list, for the reason
    // `synthGlobalEmptyListAnns` does: those are the module's bindings, already collected, and
    // a top-level `let` nested in an `if` is a start-function local `collectLocals` reaches.
    let gi = 0
    while gi < globalStmts.length {
      synthGlobalDstPinAnn(globalStmts[gi], rootIx)
      gi = gi + 1
    }
    if dstPinFired == 0 { return 0 }
    round = round + 1
  }
  0
}

// Every `LetDecl` lexically inside one function body — nested `if` and loop blocks included,
// since a wasm local is function-scoped — and not descending into a nested `FuncDecl`, which
// has its own `fnStmts` row and is walked as its own body.
function dstPinSynthWalk(ix: i32, bodyIx: i32, fnIx: i32, rootIx: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = P.nodes[ix]
  if ix != bodyIx {
    if n is FuncDecl { return 0 }
  }
  if n is LetDecl { synthDstPinAnn(ix, fnIx, rootIx) }
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    dstPinSynthWalk(kids[k], bodyIx, fnIx, rootIx)
    k = k + 1
  }
  0
}

// The module-scope run of `synthEmptyListAnn`, over every top-level binding: a global never
// reaches `collectLocals`, which types wasm locals from a function body's block statements.
// Ordered after `collectA#2`, since the synthesis can only resolve a ref-list row and never
// mint one, and before `emitModule`, whose global section reads `globalCellKind`.
export function synthGlobalEmptyListAnns() {
  let i = 0
  while i < globalStmts.length {
    synthEmptyListAnn(globalStmts[i])
    synthNullableAnn(globalStmts[i])
    i = i + 1
  }
  0
}

// The capture-scope run of `synthEmptyListAnn`, one storage class over: `emitTypeSection`
// types each closure env field with `captureValKind`, which classifies an un-annotated
// capture's initializer, and an empty `[]` has no element to classify (D613). Not a second
// answer but the same answer earlier — the late call declines on `s.letType < 0`.
export function synthCaptureEmptyListAnns() {
  if !fnValUsed { return 0 }
  let fe = 0
  while fe < fnStmts.length {
    const caps = captureNamesOf(fe)
    let ci = 0
    while ci < caps.length {
      const b = parentBindingOf(fe, caps[ci])
      if b >= 0 {
        synthEmptyListAnn(b)
        synthNullableAnn(b)
      }
      ci = ci + 1
    }
    fe = fe + 1
  }
  0
}

// Scan the program's top-level statements into `fnStmts` (`FuncDecl`s only, in order),
// skipping `TypeDecl`s and gathering top-level `LetDecl`s into `globalStmts` (module
// globals, declaration order = global index). Any other top-level statement fails loudly.
// Returns the function count, or -1 via `emitFail`.
export function collectFns(stmts: i32[]) {
  fnStmts = []
  fnParent = []
  globalStmts = []
  globalNames = []
  globalIndexBySid = []
  gPromoOk = []
  gPromoSlot = []
  gCellIdx = []
  startStmts = []
  lambdaCtr = 0
  fnDispNames = []
  fnValUsed = false
  fnAddrTaken = []
  let i = 0
  while i < stmts.length {
    const s = P.nodes[stmts[i]]
    if s is FuncDecl {
      fnStmts.push(stmts[i])
      fnParent.push(-1)
      fnDispNames.push("")
    } else if s is LetDecl {
      // A top-level `let`/`const` — a module global; its position here is its index.
      globalStmts.push(stmts[i])
      // The build point for `globalIndexBySid`: every key is interned here, which is what
      // makes `sid >= length` mean absent for every later lookup. The id comes from the
      // carrier, so the build pays one intern per global.
      const gsid = sidOfNode(stmts[i])
      if sidArrGet(globalIndexBySid, gsid) < 0 {
        sidArrPut(globalIndexBySid, gsid, globalNames.length)
      }
      globalNames.push(s.letName)
      // Every binding starts life as a cell at its own declaration index;
      // `computeGlobalPromotion` rewrites both arrays after the last pass has finished
      // mutating the arena.
      gPromoOk.push(0)
      gPromoSlot.push(-1)
      gCellIdx.push(globalStmts.length - 1)
    } else if nodeIsTypeDecl(stmts[i]) {
    } else if s is UnionDecl {
      // A `type N = A | B` union alias — collected by `collectU`, skipped here.
    } else if s is ImportDecl {
      // A tooling node (the lint tier reads it) — the module front end already
      // resolved and merged the import, so the emitter has nothing to lower.
    } else {
      // A top-level statement — runs in the synthetic start function, in source order.
      startStmts.push(stmts[i])
    }
    i = i + 1
  }
  // Lift nested function declarations and anonymous `function(...)` literals into the flat
  // `fnStmts` list, each becoming a real top-level wasm function with its own index. The
  // worklist grows as nested functions are discovered; an anonymous literal gets a synthesized
  // `__lambda_N` name written into the node.
  let wi = 0
  while wi < fnStmts.length {
    const fn = P.nodes[fnStmts[wi]]
    if fn is FuncDecl { liftFnsInExpr(fn.fnBody, wi) }
    wi = wi + 1
  }
  // Also lift lambdas in top-level global initializers and start statements (parent -1).
  let gi = 0
  while gi < globalStmts.length {
    const g = P.nodes[globalStmts[gi]]
    if g is LetDecl {
      if g.letInit >= 0 {
        const before = fnStmts.length
        liftFnsInExpr(g.letInit, -1)
        recordLambdaDispName(before, g.letInit, g.letName)
      }
    }
    gi = gi + 1
  }
  let si = 0
  while si < startStmts.length {
    liftFnsInExpr(startStmts[si], -1)
    si = si + 1
  }
  // A lambda lifted from a global initializer or start statement is pushed without its own
  // body being descended, because the worklist already finished at the old `fnStmts.length`.
  // Resuming from `wi` descends exactly the newly-lifted functions and is order-preserving:
  // already-descended entries keep their slot, so existing function indices do not move.
  while wi < fnStmts.length {
    const gfn = P.nodes[fnStmts[wi]]
    if gfn is FuncDecl { liftFnsInExpr(gfn.fnBody, wi) }
    wi = wi + 1
  }
  // The `$fnsig` collection happens later (`collectCloSigs`, after `computeRetInference`): a
  // signature key reads each function's param and return kinds, and an un-annotated callback's
  // return kind is known only once inference ran.
  cloSigKeys = []
  cloSigRepFn = []
  // The pool's twin column is rebuilt at the pool's own emit; clear it with the two columns it
  // parallels so a long-lived process cannot read the previous module's folds through a
  // same-length coincidence.
  cloSigTwin = []
  fnStmts.length
}

// True if function-result type name `r` round-trips through the nested-closure value-call ABI.
// Only a plain numeric or boolean scalar does: it is the closure `call_ref`'s literal result
// valtype, read straight off the stack. Excluding a composite result keeps those shapes a
// clean reject with no interned sig, rather than invalid wasm or a trap.
function cloResultIsPlainScalar(r: string) {
  r == "i32" || r == "boolean" || r == "f64" || r == "f32" || r == "i64"
}

// The one home of the `$fnsig` intern. Append `key` to the signature table under representative
// lifted-function `rep` (a real `fnStmts` index, or -1 for a key synthesized from an
// annotation). A "" key interns nothing; a present key keeps its original slot, so every pass
// below is idempotent. The paired push is what keeps the two columns the same length.
function internCloSigKey(key: string, rep: i32) {
  if key == "" { return 0 }
  if cloSigPosOfKey(key) >= 0 { return 0 }
  cloSigKeys.push(key)
  cloSigRepFn.push(rep)
  0
}

// The one home of "intern the `$fnsig` of this type-atom spelling, synthesized". Key the atom
// with `unionArmSigKey`, which byte-matches the key a value call site derives; skip a mixed
// scalar-plus-composite union result, whose synthesized sig would satisfy the call's floor
// while the un-pinned producer keeps its own functype and the cast traps; intern at rep -1.
function internCloSigOfAtom(atom: string) { internCloSigOfAtomTy(atom, "") }

// `internCloSigOfAtom` with the key already in hand; `kIn` of "" parses the atom instead. The
// guard still runs: `nulCloMixedUnionUnregistered(atom)` is a deliberate reject, evaluated here
// on the atom whether or not the key came from the arena, so the hint answers only the key and
// leaves the guard in the path.
function internCloSigOfAtomTy(atom: string, kIn: string) {
  let k = kIn
  if k == "" { k = unionArmSigKey(atom) }
  if k == "" { return 0 }
  if nulCloMixedUnionUnregistered(atom) { return 0 }
  internCloSigKey(k, -1)
}

// Intern every closure `$fnsig` reachable through the result chain of a function type — a
// closure whose result is itself a closure (`() => ((i32) => f32)`), to any nesting depth. The
// concrete-lambda loop keys the outer sig as a collapsed `>c` and never mints the inner one, so
// a value call on the result finds nothing. Bounded to results that round-trip a value call.
function internCloResultChainTy(ty: i32) { internCloResultSpineTy(ty) }

function internCloResultSpineTy(ty: i32) {
  if ty < 0 { return 0 }
  let curTy = ty
  let guard = 0
  while guard < 64 {
    guard = guard + 1
    const ct = T.tys[curTy]
    if !(ct is TyFunc) { return 0 }
    const retTy = ct.fnRet
    if retTy < 0 { return 0 }
    const rt = T.tys[retTy]
    let retIsClosure = false
    if rt is TyFunc { retIsClosure = true }
    let takes = retIsClosure
    if !takes {
      if rt is TyPrim {
        const rp = rt.primName
        if (
          rp == "i32" ||
          rp == "boolean" ||
          rp == "f64" ||
          rp == "f32" ||
          rp == "i64"
        ) {
          takes = true
        }
      }
    }
    if takes { internCloSigKey(sigKeyOfTy(curTy), -1) }
    if !retIsClosure { return 0 }
    curTy = retTy
  }
  0
}

// The one home of the closure result-spine walk on a name, with one caller: the
// nulclosure-annotation entry, off the annotation's `| null` inner. The checker-type entry
// walks the arena instead (`internCloResultSpineTy`), because this one is fed an author's
// spelling where a litunion alias survives. `wideShape` is the disjunct the arena twin lacks.
function internCloResultSpine(tn: string, wideShape: boolean) {
  if tn == "" { return 0 }
  let cur = normTypeAtom(tn)
  let guard = 0
  while guard < 64 {
    guard = guard + 1
    // `annRetNameOf` is the `annArrowAt`-then-slice this loop spelled out; "" is its "no
    // top-level arrow" answer, the spine's terminator.
    const rawRet = annRetNameOf(cur)
    if rawRet == "" { return 0 }
    const ret = normTypeAtom(rawRet)
    const retIsClosure = annArrowAt(ret) >= 0
    let takes = retIsClosure || cloResultIsPlainScalar(ret)
    // Evaluated only when the two cheap disjuncts declined; `nameIsWholeSpanShape` is a depth
    // scanner, not a char test. `wideShape` is redundant rather than dead: the sibling covering
    // it is coverage-gated, since `collectTyReachCloSigs`'s roots come from `nodeTyIxOf` and it
    // returns at once for -1, so on an arena-uncovered annotation this flag is the only cover.
    if !takes && wideShape { takes = nameIsWholeSpanShape(ret) }
    // No `nulCloMixedUnionUnregistered` guard, and it is inert here rather than missing:
    // `takes` already restricts this level's result to a nested closure, a plain scalar or a
    // whole-span shape — never a union — so the guard's mix test cannot fire on `cur`.
    if takes { internCloSigKey(unionArmSigKey(cur), -1) }
    // Descend only through a nested-closure result; a scalar or composite result ends the spine.
    if !retIsClosure { return 0 }
    cur = ret
  }
  0
}

// The nulclosure-annotation dual of `internCloResultChain`: intern every closure `$fnsig`
// reachable through the result chain of a nullable closure annotation's inner function type.
// The annotation may be the program's only spelling of these types — the value only ever
// `null`, narrowed and called — so no concrete lambda ever mints them.
function internNulCloResultSpine(tn: string) { internCloResultSpine(tn, true) }

// Collect the distinct `$fnsig` env-leading functypes — one per distinct eligible signature key
// across all lifted functions, in `fnStmts` order. Runs after `computeRetInference`, whose
// inferred return kinds the key reads, and after `collectMapFilterUse`, which may flip
// `fnValUsed`. Empty unless `fnValUsed`, the invariant that keeps every golden's bytes fixed.
export function collectCloSigs() {
  cloSigKeys = []
  cloSigRepFn = []
  // The pool's twin column is rebuilt at the pool's own emit; clear it with the two columns it
  // parallels so a long-lived process cannot read the previous module's folds through a
  // same-length coincidence.
  cloSigTwin = []
  if !fnValUsed { return 0 }
  let fe = 0
  while fe < fnStmts.length {
    let key = fnSigKeyOf(fe)
    // A void- (`>v`) or struct-returning (`>sN;`) function used as a value needs its extended
    // sig interned too — the value-eligible key above excludes both. `cloSigKeyExt` yields ""
    // for the kinds still outside the value ABI, so those stay unminted.
    if key == "" { key = cloSigKeyExt(fe) }
    // The concrete-lambda rep: this key's representative is the lifted function itself, not the
    // -1 synth sentinel.
    internCloSigKey(key, fe)
    // A nullable-closure result (key `…>C`): intern the inner closure's `$fnsig` too, since the
    // inner closure is never constructed and a narrowed value call would find no interned sig.
    // The inner type rides the lambda's pinned `fnRet` nullable part, and `unionArmSigKey`
    // yields the same key the narrowed call site derives. Usage-gated by `fnValUsed`.
    if cloRetValKind(fe) == "nulclosure" {
      const rfn = P.nodes[fnStmts[fe]]
      if rfn is FuncDecl {
        // The mixed-union skip belongs here too, and this is the one synth site where its
        // absence is not inert: for an un-instantiated generic template `inm` still carries the
        // type parameter, which counts as the composite side of the mix test and is registered
        // by nothing. Unguarded, such a template steals a concrete lambda's rep for its key.
        const inm = nullablePartOf(tyNameOf(rfn.fnRet))
        if inm != "" { internCloSigOfAtom(inm) }
      }
    }
    // A closure-returning-closure result: the lambda keys its own sig as the collapsed `>c` but
    // the inner closure's sig is never minted from a concrete lambda, so `g()(1)` has no
    // interned signature. Walk the result chain off the lambda's checker type — the same source
    // the call site reads — and synthesize each result closure's key at rep -1.
    if cloRetValKind(fe) == "closure" {
      internCloResultChainTy(nodeTyIxOf(fnStmts[fe]))
    }
    fe = fe + 1
  }
  // Extended field-closure signatures for index and operator-trap dispatch: an object-field
  // closure may be void or struct-returning, sigs the value ABI above excludes. Intern each
  // such field closure's extended key so the member-call site can `ref.cast` to the callee's
  // real functype. Only fires where the sig is not already value-eligible.
  let ai = 0
  while ai < P.nodes.length {
    const an = P.nodes[ai]
    if an is ObjLit {
      const fs = an.objFields
      let fi = 0
      while fi < fs.length {
        const f = P.nodes[fs[fi]]
        if f is FieldInit {
          const ffe = fieldValueFeOf(f.fiValue)
          if ffe >= 0 {
            // The field closure is concrete, so its rep is the lifted function `ffe`.
            if fnSigKeyOf(ffe) == "" { internCloSigKey(cloSigKeyExt(ffe), ffe) }
          }
        }
        fi = fi + 1
      }
    }
    ai = ai + 1
  }
  // Closure-arm union signatures: a union with a function-type arm whose program has no
  // concrete closure of that arm's type still needs the arm's `$fnsig` interned, since the
  // narrowed call `call_indirect`s at it. `unionArmSigKey` normalizes to the same key
  // `narrowedClosureOf` yields at the call site; rep -1, and gated by `fnValUsed`.
  let ui = 0
  while ui < unMemberSet.length {
    // This walk iterates the row, so it reads the row's own recorded member column directly:
    // the columns keep the mint's atom order, so no text bridge is needed and the 31-member
    // mask limit does not apply. The text split survives only for a row the recorder missed.
    const atoms: string[] = []
    let uSt = -1
    if ui < unMemTyStart.length {
      uSt = unMemTyStart[ui]
      if uSt >= 0 {
        if uSt + unMemTyCount[ui] > unMemAtoms.length { uSt = -1 }
      }
    }
    const atomTys: i32[] = []
    if uSt >= 0 {
      let um = 0
      while um < unMemTyCount[ui] {
        atoms.push(unMemAtoms[uSt + um])
        atomTys.push(unMemTys[uSt + um])
        um = um + 1
      }
    } else {
      splitUnionAtoms(unMemberSet[ui], atoms)
    }
    let uj = 0
    while uj < atoms.length {
      // A function-type union arm: the arm's own closure sig. The row decides the key and also
      // decides there is not one — `unMemTys` is recorded in `unMemAtoms` order, so a `TyFunc`
      // row hands `sigKeyOfTy` the key the parse would have produced and a non-`TyFunc` row is
      // the "" it would have returned. The guard is untouched in both branches.
      let armRow = -1
      if uj < atomTys.length { armRow = atomTys[uj] }
      if armRow >= 0 {
        const armT = T.tys[armRow]
        if armT is TyFunc {
          internCloSigOfAtomTy(atoms[uj], sigKeyOfTy(armRow))
        }
      } else {
        internCloSigOfAtom(atoms[uj])
      }
      // A closure-array arm, plain or nullable-element: the element closure sig is interned by
      // neither the function-arm branch above nor the TypeRef pass below, which sees only a
      // top-level closure-array annotation. Same `unionArmSigKey` element-key normalization the
      // call site derives; the row says whether there is a closure element at all.
      let uCaRow = -1
      if uj < atomTys.length {
        const arow2 = atomTys[uj]
        if arow2 >= 0 {
          const at2 = T.tys[arow2]
          if at2 is TyArray {
            if at2.aElem >= 0 {
              const ee = T.tys[at2.aElem]
              if ee is TyFunc {
                uCaRow = at2.aElem
              } else if ee is TyNullable {
                if ee.nInner >= 0 {
                  const ei = T.tys[ee.nInner]
                  if ei is TyFunc { uCaRow = ee.nInner }
                }
              }
            }
          }
        }
      }
      if uCaRow >= 0 {
        const uCael = cloArrElemNameOf(atoms[uj])
        if uCael != "" { internCloSigOfAtomTy(uCael, sigKeyOfTy(uCaRow)) }
      } else if uj >= atomTys.length {
        const uCael = cloArrElemNameOf(atoms[uj])
        if uCael != "" { internCloSigOfAtom(uCael) }
      }
      uj = uj + 1
    }
    ui = ui + 1
  }
  // Nullable-closure annotations whose value is only ever `null` — narrowed and called, with no
  // concrete lambda anywhere to intern the closure's `$fnsig`. The nullable dual of the
  // closure-arm union pass above: walk every TypeRef and intern the inner closure key, which
  // `unionArmSigKey` normalizes to the call site's, at rep -1. Idempotent via `cloSigPosOfKey`.
  let ni = 0
  while ni < P.nodes.length {
    const nn = P.nodes[ni]
    if nn is TypeRef {
      const nm = nn.tyName
      if (nameIsNulClosure(nm)) {
        // The nulclosure's inner function type, classified once: `nullablePartOf` is a pure
        // scan of `nm` and nothing between the three former call sites writes `nm`, so the
        // hoist is total by construction.
        const nInner = nullablePartOf(nm)
        // The nulclosure annotation's inner closure sig.
        internCloSigOfAtom(nInner)
        // A nulclosure whose result is itself a closure: the intern above mints only the outer
        // sig, its result collapsed to the shared `>c` fat pointer, so a chained value call on
        // the narrowed result finds no sig for the inner closure. Walk the result spine.
        internNulCloResultSpine(nInner)
      }
      // A closure-element array annotation, plain or nullable-element, whose value may carry no
      // concrete lambda of the element type: the narrowed indexed or rebound call still
      // `ref.cast`s to the element's `$fnsig`, so intern it from the annotation. The array dual
      // of the nulclosure pass above; `unionArmSigKey` peels to the call site's own key.
      const cael = cloArrElemNameOf(nm)
      if cael != "" { internCloSigOfAtom(cael) }
    }
    ni = ni + 1
  }
  // The arena closure-sig walk, last so an already-interned sig keeps its slot: descend the
  // arena type of each annotation the union registration walk recorded (`cloSigWalkRoots`, the
  // safe root set rather than a blind `P.nodes` scan) and intern each reachable `TyFunc`'s
  // `$fnsig`. Idempotent and order-stable via `cloSigPosOfKey`; unreachable without `fnValUsed`.
  let ri = 0
  while ri < cloSigWalkRoots.length {
    if collectTyReachCloSigs(cloSigWalkRoots[ri], 16) < 0 { return -1 }
    ri = ri + 1
  }
  0
}

// Record a directly-bound lambda's debug display name for the name section. `slot` is the
// `fnStmts` index it lifted to, captured before the lift call, since a directly-bound lambda is
// that call's first and only push. `fnName` stays the synthesized `__lambda_N` so call
// resolution and `fnNameMap` are untouched; only a trap backtrace reads the friendlier name.
function recordLambdaDispName(slot: i32, initIx: i32, name: string) {
  if initIx < 0 || name.length == 0 || slot >= fnDispNames.length { return 0 }
  const iv = P.nodes[initIx]
  if iv is FuncDecl { fnDispNames[slot] = name }
  0
}

// Recursively walk the node at `ix` and append every nested `FuncDecl` — a nested declaration
// statement or an arrow lambda in expression position — to `fnStmts`. An anonymous lambda is
// given a synthesized unique name first, so it resolves like a named function. The function's
// own body is not descended here; the worklist in `collectFns` does that exactly once.
function liftFnsInExpr(ix: i32, parent: i32) {
  if ix < 0 { return 0 }
  const n = P.nodes[ix]
  if n is FuncDecl {
    if n.fnName == "" {
      n.fnName = "__lambda_" + i32ToStr(lambdaCtr)
      lambdaCtr = lambdaCtr + 1
      // The one in-place `fnName` write that lands after the node is already in the arena, and
      // `emit_base.nameNamesFunction` folds the arena incrementally, so it may already have read
      // this node as the anonymous "" it holds until now. The only names this write can add are
      // `__lambda_<n>`, which nothing asks about today; it is here for the day something can.
      noteFuncName(n.fnName)
      // An in-place name write (`compiler/symbols.vl`): `fnIndexOfSid`'s dense array is keyed by
      // the carrier and `buildFnMap` interns `s.fnName` for every lifted function, so a stale
      // carrier slot here would key the lambda's row under the anonymous "" it replaced.
      sidNoteNodeName(ix)
    }
    fnStmts.push(ix)
    fnParent.push(parent)
    fnDispNames.push("")
    fnValUsed = true
    return 0
  }
  if n is Block {
    const stmts = n.blkStmts
    let i = 0
    while i < stmts.length {
      liftFnsInExpr(stmts[i], parent)
      i = i + 1
    }
    return 0
  }
  if n is LetDecl {
    if n.letInit >= 0 {
      const before = fnStmts.length
      liftFnsInExpr(n.letInit, parent)
      recordLambdaDispName(before, n.letInit, n.letName)
    }
    return 0
  }
  if n is RetStmt {
    if n.retArg >= 0 { liftFnsInExpr(n.retArg, parent) }
    return 0
  }
  if n is IfStmt {
    liftFnsInExpr(n.ifCond, parent)
    liftFnsInExpr(n.ifThen, parent)
    if n.ifElse >= 0 { liftFnsInExpr(n.ifElse, parent) }
    return 0
  }
  if n is WhileStmt {
    liftFnsInExpr(n.whileCond, parent)
    liftFnsInExpr(n.whileBody, parent)
    return 0
  }
  if n is ForRange {
    liftFnsInExpr(n.frFrom, parent)
    liftFnsInExpr(n.frTo, parent)
    if n.frStep >= 0 { liftFnsInExpr(n.frStep, parent) }
    liftFnsInExpr(n.frBody, parent)
    return 0
  }
  if n is ForIn {
    liftFnsInExpr(n.fiIter, parent)
    liftFnsInExpr(n.fiBody, parent)
    return 0
  }
  if n is Call {
    liftFnsInExpr(n.callFn, parent)
    const args = n.callArgs
    let i = 0
    while i < args.length {
      liftFnsInExpr(args[i], parent)
      i = i + 1
    }
    return 0
  }
  if n is BinExpr {
    liftFnsInExpr(n.binLeft, parent)
    liftFnsInExpr(n.binRight, parent)
    return 0
  }
  if n is Unary {
    liftFnsInExpr(n.unArg, parent)
    return 0
  }
  if n is Paren {
    liftFnsInExpr(n.parInner, parent)
    return 0
  }
  // The two operand-carrying node kinds this walk must enter (D1085): both wrap an ordinary
  // expression that may hold a function literal, and a literal this walk does not reach is never
  // pushed to `fnStmts`. `MatchExpr` is absent because `match` desugars into `IfStmt`/`Block`,
  // and `OptMember` because a `?.` receiver must be re-readable and so cannot hold a call.
  if n is AsExpr {
    liftFnsInExpr(n.asObj, parent)
    return 0
  }
  if n is IsExpr {
    liftFnsInExpr(n.isObj, parent)
    return 0
  }
  if n is Member {
    liftFnsInExpr(n.memObj, parent)
    return 0
  }
  if n is Index {
    liftFnsInExpr(n.idxArr, parent)
    liftFnsInExpr(n.idxIndex, parent)
    return 0
  }
  if n is ObjLit {
    const fields = n.objFields
    let i = 0
    while i < fields.length {
      const f = P.nodes[fields[i]]
      if f is FieldInit { liftFnsInExpr(f.fiValue, parent) }
      i = i + 1
    }
    return 0
  }
  if n is ArrayLit {
    const elems = n.arrElems
    let i = 0
    while i < elems.length {
      liftFnsInExpr(elems[i], parent)
      i = i + 1
    }
    return 0
  }
  0
}

// The monomorphizer re-points a `fnStmts` slot or a `fnParent` entry in place. `buildFnMap`
// reads both — the row comes off `P.nodes[fnStmts[i]]`, and `fnParent[i]` decides the nested
// mark — so such a write re-classifies a function the banked prefix already covers, and
// retires it. No length moves, which is why the arena stamp alone cannot see this.
export function buildFnMapNoteFnSlotWrite() {
  fmSeenFns = -1
  0
}

// Can this call re-seed the covered prefix from the row cache instead of re-classifying it?
// Only with a prefix banked and every registry the return classifiers consult unmoved:
// `retStructIndex` reads the struct table and the variant rows, `retAnnKindChain` the union
// names, and a row added to any of them re-classifies an annotation already seen.
function buildFnMapResumable(): boolean {
  if !fmResumeArmed { return false }
  if fmSeenFns < 0 { return false }
  if fmSeenFns > fnStmts.length { return false }
  if fmSeedKind.length > fRetKind.length { return false }
  if fmSeenUnSets != unMemberSet.length { return false }
  if fmSeenUnNames != unNames.length { return false }
  if fmSeenVariants != uVariants.length { return false }
  if fmSeenSNames != sNames.length { return false }
  if fmSeenSFields != sFieldTypes.length { return false }
  if fmSeenUFields != uFieldTypes.length { return false }
  fmSeenTyParams == genTyParamNames.length
}

// Write the cached seed back over the prefix rows. This is what makes the resume exact rather
// than merely cheap: `computeVoidFns` and `computeRetInference` refine these five columns in
// place after every call, so a resume that kept them would hand the next round a refined value
// where a full re-mint hands it the annotation's own. `fRetLitAtom` seeds 0 for every row.
function buildFnMapReseedPrefix() {
  let r = 0
  while r < fmSeedKind.length {
    fRetVoid[r] = fmSeedVoid[r]
    fRetStructIdx[r] = fmSeedStructIdx[r]
    fRetRArrElem[r] = fmSeedRArrElem[r]
    fRetBool[r] = fmSeedBool[r]
    fRetKind[r] = fmSeedKind[r]
    fRetLitAtom[r] = 0
    r = r + 1
  }
  0
}

// Bank the row this iteration just produced, AFTER the inferred-return arms have refined it —
// the seed a full re-mint would leave, not the annotation chain's first answer.
function buildFnMapBankRow() {
  fmSeedVoid.push(fRetVoid[fRetVoid.length - 1])
  fmSeedStructIdx.push(fRetStructIdx[fRetStructIdx.length - 1])
  fmSeedRArrElem.push(fRetRArrElem[fRetRArrElem.length - 1])
  fmSeedBool.push(fRetBool[fRetBool.length - 1])
  fmSeedKind.push(fRetKind[fRetKind.length - 1])
  0
}

// Bank the `fnStmts` prefix this run's rows cover, with the registry lengths that classify it.
// Only an armed run banks, so no prefix crosses a pass that edits the arena in place.
function buildFnMapBankPrefix() {
  if !fmResumeArmed { return 0 }
  fmSeenUnSets = unMemberSet.length
  fmSeenUnNames = unNames.length
  fmSeenVariants = uVariants.length
  fmSeenSNames = sNames.length
  fmSeenSFields = sFieldTypes.length
  fmSeenUFields = uFieldTypes.length
  fmSeenTyParams = genTyParamNames.length
  fmSeenFns = fnStmts.length
  0
}

// Map each function name to its wasm function index — its position in `fnStmts` — and record
// its return facts (voidness, struct index, ref-array element, boolean, kind). Built over all
// top-level functions before any body is emitted, so forward references and recursion resolve
// for free. Two parallel arrays: `fnNames[i]`'s index is `fnIndices[i]`. Returns the count.
export function buildFnMap(_stmts: i32[]) {
  const resume = buildFnMapResumable()
  let start = fmSeenFns
  // Retired for the duration: a run that ends early leaves the columns partial, and the next
  // call must re-classify rather than resume from a prefix that never finished.
  fmSeenFns = -1
  if resume {
    buildFnMapReseedPrefix()
  } else {
    start = 0
    fnNames = []
    fnIndexBySid = []
    nestedNameBySid = []
    fnIndices = []
    fRetVoid = []
    fRetStructIdx = []
    fRetRArrElem = []
    fRetBool = []
    fRetKind = []
    fRetLitAtom = []
    fmSeedVoid = []
    fmSeedStructIdx = []
    fmSeedRArrElem = []
    fmSeedBool = []
    fmSeedKind = []
  }
  let i = start
  while i < fnStmts.length {
    const s = P.nodes[fnStmts[i]]
    if s is FuncDecl {
      fnNames.push(s.fnName)
      // The build point for `fnIndexBySid` and `nestedNameBySid` — see `collectFns`' global row
      // for the exactness the interning-as-we-build gives.
      const fsid = sidOfNode(fnStmts[i])
      // First occurrence wins: a later lifted function sharing a name does not overwrite the
      // earlier slot.
      if sidArrGet(fnIndexBySid, fsid) < 0 { sidArrPut(fnIndexBySid, fsid, i) }
      // A nested (lifted) function's name — drives `fnIndexOfInScope`'s scan gate.
      if i < fnParent.length && fnParent[i] >= 0 {
        sidArrPut(nestedNameBySid, fsid, 1)
      }
      fnIndices.push(i)
      // A declared `: void` return seeds the void classification directly: the fixpoint below
      // (`computeVoidFns`) covers only the un-annotated half, and an unseeded annotation leaves
      // every `: void` function emitting `(result i32)`.
      fRetVoid.push(retVoidAnnFlag(s.fnRet))
      fRetStructIdx.push(retStructIndex(s.fnRet))
      fRetRArrElem.push(retRefArrElemName(s.fnRet))
      fRetBool.push(retBoolFlag(s.fnRet))
      // The stored return kind: one `VKind` slot per function, seeded from the annotation via
      // `retAnnKindChain`. `computeRetInference` writes the un-annotated facts into the same
      // slot, so `inferredRetKindCore` is a plain read.
      fRetKind.push(retAnnKindChain(s.fnRet))
      fRetLitAtom.push(0)
      // An un-annotated scalar, string or array return is set directly from the checker's
      // inferred return name: the expression-based fallback below misses a return that is a
      // plain variable. No AST node is synthesized, so `fmt` is untouched; `i32` needs nothing,
      // and `string[]` stores `"strlist"`, the module-global string-list wrapper.
      if s.fnRet < 0 {
        // An anonymous lambda's inferred return is keyed by node index, since the lambda has no
        // name the checker saw; fall back to that when the name-keyed lookup misses. One row
        // lookup, two columns, so the name arms and the arena arms read the same row by
        // construction rather than by two readers agreeing.
        let inRow = inferRetRowOf(s.fnName)
        if inRow < 0 { inRow = inferRetRowByNode(fnStmts[i]) }
        let inm = ""
        if inRow >= 0 { inm = inferRetTyAt(inRow) }
        // The five list arms take the array grammar's one cut plus a leaf name rather than
        // matching a whole spelling. The `i32` and `string` arms compare the leaf directly,
        // because their sibling homes (`nameIsI32Array` / `nameIsStringArray`) are rep-wide and
        // also accept `boolean[]`, a litunion `K[]` and the nullable forms.
        const li = fRetKind.length - 1
        // The five scalar arms ask the arena, not the render: `inferRetTyIx` banks the type
        // beside the name at the one recorder. What makes this sound is the transparency
        // collapse in `declaredTyOfName` and `isClassifiableRetName`'s admitted set in
        // `typecheck.vl` — widen that gate and these arms fire where the name arms did not.
        let retTyIx = -1
        if inRow >= 0 { retTyIx = inferRetTyIxAt(inRow) }
        let retPrim = ""
        if retTyIx >= 0 {
          const rpt = T.tys[retTyIx]
          if rpt is TyPrim { retPrim = rpt.primName }
          // An inferred return whose join is an un-named literal union reps as a string ref,
          // the same rep its annotated twin gets. A named alias is deliberately excluded: it
          // reps as the interned i32 atom, and forcing it to `"str"` would put a string-ref
          // result on a function returning an id. Same seam as `retLitUnionInline`.
          if retPrim == "" && tyIsLitUnion(retTyIx) {
            if !tyIsLitUnionAlias(retTyIx) { retPrim = "string" }
          }
        }
        // The five array arms, likewise from the arena, with the recorded array type read off
        // the same row the name came from. Narrow by construction: exactly the five element
        // names the cut admits, never the rep-wide helpers, because a `boolean` element is a
        // `TyArray` of `TyPrim` an arena test would claim while the cascade gives it no arm.
        let retElem = ""
        // Five atom compares; the one widening happens only where the name is stored.
        const raePrim = tyArrayElemPrim(retTyIx)
        const raeOk = raePrim == "i32" ||
          raePrim == "string" ||
          raePrim == "f64" ||
          raePrim == "i64" ||
          raePrim == "f32"
        if raeOk { retElem = primNameStr(raePrim) }
        if retPrim == "null" {
          // D1567 — the `null` type, from the rung the checker banks for it. Its rep is
          // `nullref`, the bottom of the GC hierarchy: one value, assignable to every nullable
          // ref destination with no coercion, and `retKindPri` gives it the top tier so
          // `criClassify`'s expression facts cannot lower it.
          fRetKind[li] = "nulnone"
        } else if retPrim == "string" {
          fRetKind[li] = "str"
        } else if retPrim == "i64" {
          fRetKind[li] = "i64"
        } else if retPrim == "f64" {
          fRetKind[li] = "f64"
        } else if retPrim == "f32" {
          fRetKind[li] = "f32"
        } else if retPrim == "boolean" {
          fRetBool[li] = 1
        } else if retElem == "i32" {
          fRetKind[li] = "list"
        } else if retElem == "string" {
          fRetKind[li] = "strlist"
        } else if retElem == "f64" {
          fRetKind[li] = "f64list"
        } else if retElem == "i64" {
          fRetKind[li] = "i64list"
        } else if retElem == "f32" {
          fRetKind[li] = "f32list"
        } else if nameIsMap(inm) && mapValNameOf(inm) == "i32" {
          // A mono `{[string]: i32}` map inferred return. `criClassify`'s `exprMap` can miss it,
          // since a returned local's kind is not collected during the global return pass, so set
          // it from the checker's inferred return name.
          fRetKind[li] = "map"
        } else if nameIsNulString(inm) {
          // A `string | null` niche inferred return drives the kind-16 result valtype, the same
          // kind the annotated path stores. The `boolean | null` niche stores nothing: its
          // result valtype is plain i32, so it falls through to the default. `nameIsNulString`
          // is `nullablePartOf(name) == "string"`, the same home the annotation side calls.
          fRetKind[li] = "nulstr"
        } else if (nameIsMap(nullablePartOf(inm))) {
          // D937 — the nullable map inferred return, the sibling of the mono-map arm above.
          // Same pair the annotated path stores (`retNulMapFlag` -> `"nulmap"`), read off the
          // name the checker recorded. Any string-keyed map, not just the i32-valued one, and
          // ahead of `inferNulStructRow`, which would otherwise resolve a map as a struct row.
          fRetKind[li] = "nulmap"
        } else if inferNulVariantRow(inm) >= 0 {
          // D1562 — a nullable union-variant inferred return, the twin the `nulstruct` arm below
          // never had. Ahead of `nulstruct`, which is the annotated ladder's order:
          // `retAnnKindChain` is last-match-wins and puts the variant after the ref, and this
          // chain is first-match-wins, so mirroring that precedence means going first.
          fRetKind[li] = "nulvariant"
          fRetStructIdx[li] = inferNulVariantRow(inm)
        } else if inferNulStructRow(inm) >= 0 {
          // D887 — a nullable-struct inferred return, the same pair the annotated path stores
          // (`retNulRefFlag` -> `"nulstruct"` + `retStructIndex`), read off the name the checker
          // recorded, so all four owners of a return row read one answer. Ahead of the two union
          // arms below because the row is a nullable; both decline anyway.
          fRetKind[li] = "nulstruct"
          fRetStructIdx[li] = inferNulStructRow(inm)
        } else if inferRetIsValueUnionAt(inRow, inm) {
          fRetKind[li] = "union"
        } else if (
          inferRetIsUnionAt(inRow, inm) &&
          !inferRetIsLitUnionAt(inRow, inm)
        ) {
          // A registered struct-union inferred return: the variant-boxed rep rides the same
          // union result valtype as a value union, so store `"union"`. A registered litunion
          // alias is `isUName` too, but its rep is the interned i32 atom and so the default
          // kind; the annotation side excludes it at the same seam.
          fRetKind[li] = "union"
        }
      }
      buildFnMapBankRow()
    }
    i = i + 1
  }
  // The scope-chain child index is derived from `fnParent`, which `collectFns` has just
  // rebuilt — drop the previous program's copy so the lazy build below cannot read it.
  fnChildHead = []
  fnChildNext = []
  buildFnMapBankPrefix()
  fnStmts.length
}

// The `fnStmts` position of a lifted function named `name` whose parent frame is the `fnStmts`
// position `pp`, or -1 when that frame declares no such function. Visits `pp`'s children in
// `fnStmts` order, so the first declaration wins. The length compare is the lazy build: the
// index is minted per program and re-mints after a late `fnStmts` push, so it is not a flag.
function nestedFnDeclaredIn(name: string, pp: i32) {
  if fnChildHead.length != fnStmts.length { buildFnChildIndex() }
  if pp < 0 || pp >= fnChildHead.length { return -1 }
  let i = fnChildHead[pp]
  while i >= 0 {
    const s = P.nodes[fnStmts[i]]
    if s is FuncDecl {
      if s.fnName == name { return i }
    }
    i = fnChildNext[i]
  }
  -1
}

// Resolve a callee name to its wasm function index through the calling frame's lexical scope
// chain, not `fnIndexOf`'s flat first-occurrence map, which hands every frame the module's
// first function of that name. Innermost declaring scope wins; running off the chain means the
// flat answer is right. `fnIndexOfInScope` is the twin, and cannot delegate here: import cycle.
export function fnIndexOfInScopeChain(name: string, fnIx: i32) {
  fnIndexOfInScopeChainSid(sidLookup(name), name, fnIx)
}

// The sid-taking primitive: a caller holding the callee's arena index passes `sidOfNode(ix)`
// and pays nothing for the gate below, while the string form above pays one `sidLookup`. `name`
// still rides along because the scan the gate guards (`nestedFnDeclaredIn`) compares
// `FuncDecl.fnName` strings, and that scan is off the hot path by construction.
export function fnIndexOfInScopeChainSid(sid: i32, name: string, fnIx: i32) {
  if fnIx >= 0 && sidArrGet(nestedNameBySid, sid) == 1 {
    let pp = fnStmtsPosOf(fnIx)
    // `fnStmts.length` bounds the walk: a parent chain cannot be longer than the function
    // count, so this terminates even if `fnParent` ever held a cycle.
    let steps = 0
    while pp >= 0 && steps <= fnStmts.length {
      const hit = nestedFnDeclaredIn(name, pp)
      if hit >= 0 { return hit }
      if pp < fnParent.length { pp = fnParent[pp] } else { pp = -1 }
      steps = steps + 1
    }
  }
  fnIndexOfSid(sid)
}

// The body block's last statement is a value-yielding member call — D1240's veto input.
function blockTailMemberValue(blockIx: i32): boolean {
  const b = P.nodes[blockIx]
  if b is Block {
    const n = b.blkStmts.length
    if n == 0 { return false }
    return memberCallYieldsValue(b.blkStmts[n - 1])
  }
  false
}

// Classify each function's voidness as a monotone fixed point: a candidate with no return
// annotation is void when its body has no valued `return` and no tail value. `stmtIsTailValue`
// consults `fRetVoid` for tail calls, so marking a callee void can make its callers' tails
// non-values — iterate until stable. The void set only grows, bounded by the function count.
export function computeVoidFns() {
  let changed = true
  while changed {
    changed = false
    let i = 0
    while i < fnStmts.length {
      if fRetVoid[i] == 0 {
        const fn = P.nodes[fnStmts[i]]
        if fn is FuncDecl {
          if fn.fnRet < 0 {
            // A bare `return` pins this function void whatever its tail yields; the checker
            // reads the same predicate, so the functype and the caller's type agree (D1600).
            if blockHasBareReturn(fn.fnBody) {
              fRetVoid[i] = 1
              changed = true
            } else if !blockHasValuedReturn(fn.fnBody) {
              // An else-less tail `if` makes the return `T | null`, but `blockTailIsValue`
              // deliberately ignores else-less ifs, since they feed this fixpoint. So also
              // consult the checker: a nullable inferred return is non-void. One rule replacing
              // three vetoes — an empty arm is the author saying there is no value here.
              const d34Void = !tailIfNullableIsReal(fn.fnBody, fnStmts[i])
              if (
                !blockTailIsValue(fn.fnBody, fnStmts[i]) &&
                !blockTailMemberValue(fn.fnBody) &&
                (d34Void || !inferRetBearsNull(fn.fnName)) &&
                !fnReturnsClosure(i)
              ) {
                // D1240 — a tail member call the checker typed non-void keeps this function
                // non-void. `stmtIsTailValue` declines every member call, since it feeds this
                // fixpoint and a tail `.push` has no value lowering, so an un-annotated
                // `function f(xs) { xs.slice(0, 2) }` classified void while the checker did not.

                // A function whose tail is a function value (`(a) => (b) => …`) returns a
                // closure, not void: `blockTailIsValue` ignores a bare lambda tail, so guard it
                // here, else `f`'s functype is `()->()` and `f(4)` reads as a void result.
                fRetVoid[i] = 1
                changed = true
              }
            }
          }
        }
      }
      i = i + 1
    }
  }
  0
}

// D887 — the struct row an inferred-return name's nullable part occupies, or -1. The name is
// the checker's own render, so a declared inner arrives as its nominal name and an inline shape
// as the emitter-format text, and `structIndexOfTypeName` resolves both onto the row the
// annotated spelling keys. -1 for a non-nullable name and for a part naming no row.
function inferNulStructRow(inm: string): i32 {
  const part = nullablePartOf(inm)
  if part == "" { return -1 }
  structIndexOfTypeName(part)
}

// D1562 — the variant row an inferred-return name's nullable part occupies, or -1: the twin of
// `inferNulStructRow` one index space over. `collectS` gives a union arm no struct row, so the
// struct twin answers -1 for every `Circle | null`. `variantIndexOf` is the same lookup the
// annotated spelling's `nulVariantIndexOf` ends at, so the two faces name one row.
function inferNulVariantRow(inm: string): i32 {
  const part = nullablePartOf(inm)
  if part == "" { return -1 }
  variantIndexOf(part)
}

export function computeRetInference() {
  let changed = true
  while changed {
    changed = false
    let i = 0
    while i < fnStmts.length {
      const fn = P.nodes[fnStmts[i]]
      if fn is FuncDecl {
        if fn.fnRet < 0 && fRetVoid[i] == 0 {
          // Classify over every valued return, tail value first, not just the first: a function
          // whose first return is unclassifiable still types from its others, since the checker
          // proved all returns agree. The walk is narrowing-aware (`criWalkBlock` mirrors the
          // emit loops' narrowing), so a narrowed `v` classifies as its complement.
          criChanged = false
          // The classifier's half of the capture-narrowing replay (the emitter's is in
          // `emitFuncCode`): a closure whose value is a narrowed captured read has to be
          // classified at the narrowed rep, or its inferred result disagrees with its bytes.
          const savedCapNarrow = capNarrowSeed(i)
          const fnb = P.nodes[fnStmts[i]]
          if fnb is FuncDecl {
            const fb = P.nodes[fnb.fnBody]
            if fb is Block {
              const fbs = fb.blkStmts
              if fbs.length > 0 {
                const tailIx = fbs[fbs.length - 1]
                if stmtIsTailValue(tailIx, fnStmts[i]) {
                  criClassify(tailIx, i)
                } else {
                  // A tail value-`if` is not a `stmtIsTailValue` — that predicate has no
                  // `IfStmt` case — so a named function's inferred struct return through an
                  // if-join went unclassified. Classify the whole `if` here; `exprStruct` and
                  // `exprString` see through it and pick up the join's ref.
                  const tn = P.nodes[tailIx]
                  if tn is IfStmt {
                    if tn.ifElse >= 0 { criClassify(tailIx, i) }
                  }
                }
              }
            }
            criWalkBlock(fnb.fnBody, i)
          }
          restoreNarrow(savedCapNarrow)
          if criChanged { changed = true }
        }
      }
      i = i + 1
    }
  }
  // The literal-union atom return, recorded once the kinds have settled. A separate pass and
  // not an arm inside `criClassify`: that classifier runs to a fixpoint and its arms feed each
  // other, so a question asked inside it is not free of the loop. It needs no narrowing replay,
  // and it is a flag rather than an `fRetKind` because both reps are i32 (`fRetLitAtom`).
  let la = 0
  while la < fnStmts.length {
    const laFn = P.nodes[fnStmts[la]]
    if laFn is FuncDecl {
      // Gated on the settled kind being `i32`, which is what an atom return leaves it at. A
      // function whose returns join an atom with a string settles at `"str"` and widens the atom
      // at its own return, while `fnRetExprOf` picks only one return, possibly the atom arm.
      // The kind is the settled answer for all returns; the expression test separates the atom.
      if laFn.fnRet < 0 && fRetVoid[la] == 0 && fRetKind[la] == "i32" {
        const laRx = fnRetExprOf(fnStmts[la])
        if laRx >= 0 {
          if exprIsLitAtom(laRx, fnStmts[la]) {
            if la < fRetLitAtom.length { fRetLitAtom[la] = 1 }
          }
        }
      }
    }
    la = la + 1
  }
  0
}

// Declare the three locals a `for v in <iter>` needs, in the pre-order `emitForInStmt` consumes
// them: the element var `v`, a hidden i32 cursor `v#i`, and a hidden `v#l` holding the iterable,
// evaluated once. The `#` keeps the hidden names off any user identifier. Leaves `v` bound, for
// the caller to `scopeUnbind`. One home: both scope walks must declare the same slots.
export function declareForInLocals(s: ForIn, fnIx: i32) {
  const fiEk = forInElemKind(s.fiIter, fnIx)
  if fiEk == null {
    return emitFail("emitProgram: unsupported for-in iterable")
  }
  // A struct element (`S[]`, code 1) binds the loop var as a struct local carrying the element
  // struct table index; the `#l` temp holds the ref-list wrapper (code 5 plus the slot). The
  // companion slot comes from `forInVarStructIdx` rather than from each arm below (D1142),
  // because a captured loop variable's env field needs the identical (kind, slot) pair.
  const fiVarIdx = forInVarStructIdx(s.fiIter, fnIx)
  let fiLk: VKind = "list"
  if fiEk == "struct" {
    fiLk = "reflist"
  } else if fiEk == "variant" {
    // A union-arm element (code 8): the loop var carries the variant-table row, so its cell is
    // `(ref $(uVarHeap[vi]))` — what a `const c: Circle = …` local binds. The `#l` temp is the
    // ref-list wrapper (code 5), as for every other ref element (D50).
    fiLk = "reflist"
  } else if fiEk == "nulstruct" {
    // A NULLABLE-struct element (`(P | null)[]`): the loop var is a kind-9 niche carrying
    // the element struct index; the `#l` temp is the ref-list WRAPPER (code 5).
    fiLk = "reflist"
  } else if fiEk == "union" {
    // A union-box element list: the loop var is a kind-4 union box (no struct index);
    // the `#l` temp is the ref-list WRAPPER (code 5), like the struct case.
    fiLk = "reflist"
  } else if (
    fiEk == "list" ||
    fiEk == "nullist" ||
    fiEk == "strlist" ||
    fiEk == "f64list" ||
    fiEk == "i64list" ||
    fiEk == "f32list" ||
    fiEk == "nulstrlist" ||
    fiEk == "nulf64list" ||
    fiEk == "nuli64list" ||
    fiEk == "nulf32list" ||
    fiEk == "u8list" ||
    fiEk == "nulu8list"
  ) {
    // A nested-array loop var — the inner list (kind 2/7/12/20), or the nullable niche a
    // `(T[] | null)[]` element binds (kind 15 for the shared i32 backing, 22/23/24/25 for the
    // four distinct-backing leaves). The `#l` temp is the outer ref-list wrapper (code 5).
    fiLk = "reflist"
  } else if fiEk == "closure" {
    // A CLOSURE element (`((i32) => i32)[]`): the loop var is a kind-14 closure (no struct
    // index); the `#l` temp is the ref-list WRAPPER (code 5), like the struct case.
    fiLk = "reflist"
  } else if fiEk == "reflist" || fiEk == "nulreflist" {
    // A nested ref array (`S[][]`): the loop var is the inner ref list (kind 5) carrying its
    // ref-list slot; the `#l` temp is the outer ref-list wrapper (code 5). A `(S[] | null)[]`
    // element binds the kind-18 nullable ref list off the same inner slot — the slot names the
    // wrapper heap type, the kind carries the nullability.
    fiLk = "reflist"
  } else if fiEk == "str" || fiEk == "nulstr" {
    // A `(string | null)[]` iterable shares the string list's backing (`nulstr` is the
    // string-ref niche, a `(ref null $sTypeIdx)` element slot), so the `#l` temp is the same
    // string-list wrapper the non-null element uses. Only the loop var differs.
    fiLk = "strlist"
  } else if fiEk == "f64" {
    fiLk = "f64list" // f64 element → f64-list `#l` temp
  } else if fiEk == "i64" {
    fiLk = "i64list" // i64 element → i64-list `#l` temp
  } else if fiEk == "f32" {
    fiLk = "f32list" // f32 element → f32-list `#l` temp
  }
  // A string iterable (`for ch in s`): the `#l` temp holds the string itself (code 3, the raw
  // `(ref $aTypeIdx)` array), not an i32-list wrapper. The loop var stays code 0 (i32).
  if fiEk == "i32" && forInStringSrc(s.fiIter, fnIx) { fiLk = "str" }
  // A packed byte list (`for b in bs`, `bs: u8[]`): the `#l` temp is the `$bl8` wrapper over
  // the one-byte backing, while the loop var stays code 0 since `array.get_u` widens each byte.
  // Ordered beside the string arm; the two predicates are mutually exclusive.
  if fiEk == "i32" && forInU8Src(s.fiIter, fnIx) { fiLk = "u8list" }
  const fiSlot = addLocalName(s.fiVar, fiEk, fiVarIdx)
  // A literal-union array (`for k in xs`, `xs: K[]`): the loop var is an i32 atom (kind 0),
  // flagged so `k`-as-atom is recognized at print widening, `==` and member compare. The
  // nullable element needs the same flag: a loop var is the one storage class
  // `exprNulLitUnion` cannot reach, having no `LetDecl`.
  if (
    nodeArrayElemIsLitUnion(s.fiIter) ||
    nodeArrayElemIsNulLitUnion(s.fiIter)
  ) {
    localLitUnion[fiSlot] = 1
  }
  markLoopVarIter(fiSlot, s.fiIter)
  scopeBind(s.fiVar, fiSlot)
  addLocalName(s.fiVar + "#i", "i32", -1)
  let fiLs = -1
  if (
    fiEk == "struct" ||
    fiEk == "variant" ||
    fiEk == "union" ||
    fiEk == "nulstruct" ||
    fiEk == "list" ||
    fiEk == "nullist" ||
    fiEk == "strlist" ||
    fiEk == "f64list" ||
    fiEk == "i64list" ||
    fiEk == "f32list" ||
    fiEk == "nulstrlist" ||
    fiEk == "nulf64list" ||
    fiEk == "nuli64list" ||
    fiEk == "nulf32list" ||
    fiEk == "u8list" ||
    fiEk == "nulu8list" ||
    fiEk == "closure" ||
    fiEk == "reflist" ||
    fiEk == "nulreflist"
  ) {
    const fiMvs = forInMapValsSlot(s.fiIter, fnIx)
    if fiMvs >= 0 {
      fiLs = mvRlSlot[fiMvs]
    } else {
      fiLs = refListSlotOfExpr(s.fiIter, fnIx)
    }
  }
  addLocalName(s.fiVar + "#l", fiLk, fiLs)
  return 0
}

// Recursively collect the declared-local names of the block at `blockIx` into `localNames`,
// descending into `if` branches, since a wasm local spans the whole function. Each declared
// local's init type is validated here, so a non-i32 local fails loudly before any bytes are
// emitted. Returns 0, or -1 via `emitFail` on a non-block node or an out-of-scope statement.
export function collectLocals(blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    // Enter this block's lexical scope: bindings appended below are live — and resolve a
    // same-named init expression to the right slot — only within it, and are dropped on exit.
    scopePush()
    const stmts = b.blkStmts
    // Post-guard complement narrowing, pushed at the foot of the loop below and rewound here on
    // exit — the same save and restore `emitStmts` carries. Without it a binding below a
    // divergent guard classifies its init un-narrowed, so the slot falls to the i32 default
    // while `wasmEmit`, which does push it, stores the narrowed variant's field into that cell.
    const savedGuardTop = narrowTop
    let i = 0
    while i < stmts.length {
      const s = P.nodes[stmts[i]]
      if s is LetDecl {
        synthEmptyListAnn(stmts[i])
        synthNullableAnn(stmts[i])
        synthRetPinAnn(stmts[i], fnIx)
        // `-1` for the program root: the late run has no module scope to hand over and must not
        // acquire one. It reaches the start function's blocks and the bodies monomorphization
        // minted, both past the point where a caller's annotation could re-aim an instance's
        // signature. Every binding the pre-mono pass pinned is declined by the `letType` guard.
        synthDstPinAnn(stmts[i], fnIx, -1)
        // Classify the init type before binding the name, then allocate a fresh slot and bind
        // `name → slot` so a later reference (or a shadowing inner `let`) resolves to this slot.
        // `slot` is the new slot's declared-local position.
        let slot = -1
        if letIsNulNone(stmts[i], fnIx) {
          // D1576 — a never-filled `let x = null`. The A-infer-null hole nothing assigns into
          // is not `T | null` for any `T`: the binding's only value is `null`, so its cell is
          // `nullref`, the GC bottom, which flows to every nullable ref destination with no
          // coercion. First in the ladder, since several arms below claim a bare `null`.
          slot = addLocalName(s.letName, "nulnone", -1)
        } else if letIsLitUnion(stmts[i]) || letInitIsLitAtom(stmts[i], fnIx) {
          // A literal-union local, annotated `: K` or un-annotated off an atom init. It is an
          // i32-backed interned atom, not a value-union box. First, because its members register
          // as value-union variants; and before `letIsString`, whose `string`-subtype checker
          // type would else pick the kind-3 ref slot and store the atom into a `(ref $array)`.
          slot = addLocalName(s.letName, "i32", -1)
          localLitUnion[slot] = 1
        } else if letNulLitUnion(stmts[i], fnIx) {
          // A `K | null` niche local (kind 0, plain i32): atom ids >= 0 with the spare `-1` for
          // null. Before `letIsNulString`, since a litunion softens to `string`. Marked
          // `localLitUnion` so reads widen as atoms; the write path seeds `-1` for a `null`.
          slot = addLocalName(s.letName, "i32", -1)
          localLitUnion[slot] = 1
        } else if letIsNulMap(stmts[i], fnIx) {
          // A nullable map local (kind `nulmap`), before `letIsMap`: a nullable init or
          // annotation must not collapse to `"map"`, whose `(ref $mapStruct)` cell cannot hold
          // `null`. Its `localStructIdx` carries the same map shape as the non-null map.
          slot = addLocalName(
            s.letName,
            "nulmap",
            nulMapShapeOf(stmts[i], fnIx),
          )
        } else if letNulMapReadValKind(stmts[i], fnIx) != null {
          // A bare `const t = m[k]` read of a list- or nested-map-valued map (`V | null`): binds
          // the value's established nullable local kind, the same kinds a direct `V | null`
          // annotation produces, so the narrow and read machinery lowers unchanged. Before the
          // union-read guard and the non-null kinds, so a later narrow sees the nullable cell.
          const nmrK = letNulMapReadValKind(stmts[i], fnIx)
          if nmrK != null {
            slot = addLocalName(
              s.letName,
              nmrK,
              letNulMapReadSlotArg(stmts[i], fnIx),
            )
          }
        } else if letNulMapReadUnionBox(stmts[i], fnIx) {
          // A bare `const t = m[k]` read of a union-valued map (mv kind 2): `V | null` binds the
          // established `A | B | null` rep, the shared box itself, with `null` riding as the
          // null-tagged atom. Beside the kind-6 arm for the same ladder-order reason.
          slot = addLocalName(s.letName, "union", -1)
        } else if letIsMap(stmts[i], fnIx) {
          // The kind-6 parallel slot carries the map shape: `-2` for a `Set()` binding, an mv
          // slot for a ref-valued map, `-1` for the mono i32 map. After the bare-map-read arm,
          // whose nested-map value is `{[string]:V} | null` and would else be claimed here as a
          // non-null map local, storing the nullable element into a non-null cell.
          slot = addLocalName(s.letName, "map", letMapShapeOf(stmts[i], fnIx))
        } else if letIsNulVariant(stmts[i], fnIx) {
          // Nullable union variant (`Circle | null`, kind `nulvariant`) — the
          // `(ref null $uVarHeap[vi])` niche. Before the `nulstruct` arm below: the two are
          // disjoint at the producer, but a variant has no struct row for
          // `nulRefStructIdxOfLet` to find, since `collectS` skips it.
          slot = addLocalName(
            s.letName,
            "nulvariant",
            nulVariantIdxOfLet(stmts[i], fnIx),
          )
        } else if letIsNulRef(stmts[i], fnIx) {
          // Nullable struct (`S | null`, code 9): annotation first, else the initializer's
          // nullable-returning call. Before the struct case, so a nullable init does not
          // collapse to the non-null kind 1.
          slot = addLocalName(
            s.letName,
            "nulstruct",
            nulRefStructIdxOfLet(stmts[i], fnIx),
          )
        } else if letIsNulListInfer(stmts[i], fnIx) {
          // Nullable i32 list (`i32[] | null`, kind 15), before the array case: `letIsArray`'s
          // init fallback would otherwise claim the binding as a non-null kind 2, and a later
          // `xs = null` write would be invalid.
          slot = addLocalName(s.letName, "nullist", -1)
        } else if letNulScalarListKind(stmts[i], fnIx) != null {
          // A distinct-backing nullable scalar list local (`string[]|null`, `f64[]|null`,
          // `i64[]|null`, `f32[]|null`): its own `(ref null $wrapper)` slot, before the non-null
          // scalar-list arms whose init fallback would else claim a bare list value non-null.
          const nulSLK = letNulScalarListKind(stmts[i], fnIx)
          if nulSLK != null { slot = addLocalName(s.letName, nulSLK, -1) }
          // The scalar-list checks gate on `!letIsUnion`: a `f64[] | string` binding whose init
          // is a bare list literal would otherwise let `letIsF64Array`'s init fallback claim it
          // as an f64 list instead of the value-union box. A plain `f64[]` is not a union name.
        } else if (
          letIsStringArray(stmts[i], fnIx) &&
          !letIsUnion(stmts[i], fnIx) &&
          !letIsNulRefArray(stmts[i], fnIx)
        ) {
          // The `!letIsNulRefArray` gate: a nullable union-element ref-array binding whose init
          // is a bare string-list literal would otherwise be claimed as a plain string list by
          // the init fallback, storing the union-box list into a string-list-wrapper local. The
          // scalar-list siblings below carry the same gate.
          slot = addLocalName(s.letName, "strlist", -1)
        } else if (
          letIsU8Array(stmts[i], fnIx) &&
          !letIsUnion(stmts[i], fnIx) &&
          !letIsNulRefArray(stmts[i], fnIx)
        ) {
          // Packed byte-list local (`let b: u8[] = …`) — `(ref $bl8TypeIdx)`. Sits with the
          // scalar-list arms and carries their two gates for the same reasons.
          slot = addLocalName(s.letName, "u8list", -1)
        } else if (
          letIsF32Array(stmts[i], fnIx) &&
          !letIsUnion(stmts[i], fnIx) &&
          !letIsNulRefArray(stmts[i], fnIx)
        ) {
          // Scalar-f32-element list local (`let xs: f32[] = …`), kind 21 — `(ref $fl32TypeIdx)`.
          // Before the f64 case: an `f32[]` annotation over a float-literal init would else be
          // claimed by `letIsF64Array`'s init fallback, since a `[1.5]` is `exprF64Array`.
          slot = addLocalName(s.letName, "f32list", -1)
        } else if (
          letIsF64Array(stmts[i], fnIx) &&
          !letIsUnion(stmts[i], fnIx) &&
          !letIsNulRefArray(stmts[i], fnIx)
        ) {
          // Scalar-f64-element list local (`let xs: f64[] = …`, or a float-literal array init),
          // kind 12 — its cell is `(ref $fl64TypeIdx)`.
          slot = addLocalName(s.letName, "f64list", -1)
        } else if (
          letIsI64Array(stmts[i], fnIx) &&
          !letIsUnion(stmts[i], fnIx) &&
          !letIsNulRefArray(stmts[i], fnIx)
        ) {
          // Scalar-i64-element list local (`let xs: i64[] = …`), kind 20 — `(ref $il64TypeIdx)`.
          slot = addLocalName(s.letName, "i64list", -1)
        } else if letIsNulRefArray(stmts[i], fnIx) {
          // A nullable ref-array local (`i32[][] | null`, kind 18), before the non-null
          // ref-array case: its init `v[i]` over a `(<ref-array>|null)[]` would otherwise be
          // claimed as a non-null kind 5. Stores the inner ref-list slot in `localStructIdx`.
          slot = addLocalName(
            s.letName,
            "nulreflist",
            nulRefArrayInnerSlotOfLet(stmts[i], fnIx),
          )
        } else if letIsRefArray(stmts[i], fnIx) && !letIsUnion(stmts[i], fnIx) {
          // The `!letIsUnion` gate mirrors the scalar-list branches above: a union-annotated
          // local whose init is a ref array (`const p: S[] | i64 = xs`) is a union-box local
          // (kind 4), not a reflist local, since the init coerces into the box. Without the gate
          // the ref-array init wins the reflist valtype and the boxed store is invalid wasm.
          slot = addLocalName(
            s.letName,
            "reflist",
            letRefListSlot(stmts[i], fnIx),
          )
        } else if (
          letIsNulClosure(stmts[i], fnIx) ||
          letInfersNulClosure(stmts[i], fnIx)
        ) {
          // A nullable function-value local (kind 19), or an un-annotated `const f = m[k]` over
          // a function-valued map, since a bare map read is nullable. Its cell is the nullable
          // closure fat pointer `(ref null $cloStructIdx)`. Before `letIsUnion`, which reads the
          // `fn | null` annotation as a union name, and before the non-null closure (kind 14).
          slot = addLocalName(s.letName, "nulclosure", -1)
        } else if letIsVariant(stmts[i], fnIx) {
          // A concrete union-variant local (`const c: Cat = …`), kind 8 — its cell is the
          // variant struct ref `(ref $(uVarHeap[vi]))`. Before `letIsUnion` and `letIsStruct`:
          // a variant name is neither the union box nor a standalone struct.
          slot = addLocalName(
            s.letName,
            "variant",
            variantIndexOfLet(stmts[i], fnIx),
          )
        } else if letIsUnion(stmts[i], fnIx) {
          slot = addLocalName(s.letName, "union", -1)
        } else if letIsStruct(stmts[i], fnIx) {
          // `letIsStruct` also matches via the init object literal's field-name set, so an
          // un-internable inline-shape annotation still lands here — and `structIndexOfLet` then
          // resolves to a wrong, same-field-named struct and emits its layout. Reject cleanly
          // when the annotation shape itself could not be interned.
          if letAnnIsUninternedShape(stmts[i]) {
            return emitFail(
              "emitProgram: binding's inline-shape type has an unsupported field",
            )
          }
          // The local half of D51, which `criClassify`'s return rung alone cannot see: `const c
          // = { r: n }` beside `type Shape = Circle | Sq` has no struct row for its field set,
          // so `letIsVariant` declines and the pair `("struct", -1)` reached `fbValtype`'s
          // guard. Gated on the `-1`, so it can only fire on a pair that is a loud reject.
          const lsi = structIndexOfLet(stmts[i], fnIx)
          const lov = letObjLitVariantIdx(stmts[i])
          if lsi < 0 && lov >= 0 {
            slot = addLocalName(s.letName, "variant", lov)
          } else {
            slot = addLocalName(s.letName, "struct", lsi)
          }
        } else if letIsArray(stmts[i], fnIx) {
          slot = addLocalName(s.letName, "list", -1)
        } else if letIsNulString(stmts[i], fnIx) {
          // Nullable string (`string | null`, kind 16), before the string case so a nullable
          // annotation or init does not collapse to the non-null kind 3, after which a later
          // `x = null` write would be invalid.
          slot = addLocalName(s.letName, "nulstr", -1)
        } else if letIsString(stmts[i], fnIx) {
          slot = addLocalName(s.letName, "str", -1)
        } else if letIsI64(stmts[i], fnIx) {
          // Scalar i64 local (`let x: i64 = …`, kind 10, valtype 0x7e). Bypasses
          // `checkLocalI32`, which rejects a non-i32 annotation; the init literal lowers as
          // `i64.const` in `emitStmt`'s LetDecl path.
          slot = addLocalName(s.letName, "i64", -1)
        } else if letIsF32(stmts[i]) || letInfersF32(stmts[i], fnIx) {
          // Scalar f32 local (`let x: f32 = …`, kind 13, valtype 0x7d), or an un-annotated
          // `let y = <f32 expr>` — the f32 dual of the init fallback `letIsF64` and `letIsI64`
          // carry. An annotated float literal lowers as `f32.const`; an inferred f32 init is
          // already an f32 value. A bare un-annotated float literal stays f64.
          slot = addLocalName(s.letName, "f32", -1)
        } else if letIsF64(stmts[i], fnIx) {
          // Scalar f64 local (`let x: f64 = …`, or an un-annotated `.` literal init), kind 11,
          // valtype 0x7c. Bypasses `checkLocalI32`; the init literal lowers as `f64.const` in
          // `emitStmt`'s LetDecl path.
          slot = addLocalName(s.letName, "f64", -1)
        } else if letIsClosure(stmts[i], fnIx) {
          // A function-value local (`const f = function(...)...` or `const g = namedFn`), kind
          // 14 — its cell is the closure fat-pointer struct `(ref $cloStructIdx)`.
          slot = addLocalName(s.letName, "closure", -1)
        } else if letNulBool(stmts[i], fnIx) {
          // `boolean | null` niche local (kind 17): the cell is a plain i32 holding 0 or 1, with
          // the spare value 2 encoding `null`, so `fbValtype` renders it i32. A dedicated kind so
          // `checkLocalI32` does not reject the annotation and the if-binding emit routes it to
          // the sentinel-2 rep; a later `x = null` consults `exprNulBool`, not the slot kind.
          slot = addLocalName(s.letName, "nulbool", -1)
        } else {
          if checkLocalI32(stmts[i]) < 0 {
            scopePop()
            return -1
          }
          slot = addLocalName(s.letName, "i32", -1)
        }
        // Pin the declaration to the slot, before the arm preludes below can allocate more. In a
        // monomorphized instance the annotation on this node is the only concrete type its body
        // carries (`localDeclIx`), so a rep question about a read of this local has nowhere else
        // to go.
        markLocalDecl(slot, stmts[i])
        // An if-expression initializer's arm preludes declare locals of their own. They are
        // allocated after this binding's own slot and before its name is bound, because that is
        // the order `emitLetDeclStmt` walks: `emitLetCursor`, then the init, then `scopeBind`.
        if collectIfExprLocals(s.letInit, fnIx) < 0 {
          scopePop()
          return -1
        }
        scopeBind(s.letName, slot)
      } else if s is IfStmt {
        if collectLocalsIf(stmts[i], fnIx) < 0 {
          scopePop()
          return -1
        }
      } else if s is WhileStmt {
        // Wasm locals are function-scoped, so collect locals from the while body too.
        if collectLocals(s.whileBody, fnIx) < 0 {
          scopePop()
          return -1
        }
      } else if s is ForRange {
        // A range `for` introduces two i32 slots in pre-order: the loop variable and a synthetic
        // bound temp, since the `to` expression is evaluated once. The temp's name carries a `#`
        // so it can never collide with a user identifier.
        const fvSlot = addLocalName(s.frVar, "i32", -1)
        markLoopVarSlot(fvSlot)
        scopeBind(s.frVar, fvSlot)
        addLocalName(s.frVar + "#b", "i32", -1)
        if collectLocals(s.frBody, fnIx) < 0 {
          scopePop()
          return -1
        }
        // The loop variable's scope is the loop (see `scopeUnbind`).
        scopeUnbind()
      } else if s is ForIn {
        if declareForInLocals(s, fnIx) < 0 {
          scopePop()
          return -1
        }
        if collectLocals(s.fiBody, fnIx) < 0 {
          scopePop()
          return -1
        }
        // The loop variable's scope is the loop (see `scopeUnbind`).
        scopeUnbind()
      } else if s is RetStmt {
        // `return if c { … } else { … }` — the returned if-expression's arm preludes are the
        // only locals a `return` can introduce, and `emitStmt`'s return path emits them in this
        // same order, with nothing preceding the value.
        if collectIfExprLocals(s.retArg, fnIx) < 0 {
          scopePop()
          return -1
        }
      }
      // Post-guard complement narrowing, mirroring `emitStmts`: a guard `if` with no else whose
      // then-branch always returns narrows the rest of this block, so the bindings below it are
      // classified under the same narrowing the emit applies. The save above restores the depth
      // at block exit.
      pushPostGuardNarrow(stmts[i], fnIx)
      i = i + 1
    }
    restoreNarrow(savedGuardTop)
    scopePop()
    return 0
  }
  emitFail("emitProgram: function has no block body")
}

// Allocate the arm-prelude locals of an if-expression standing as a statement's whole value
// expression — a binding initializer or a `return` operand, which is also where a `match` in
// value position lands. Only this shape is walked: an if-expression nested deeper inside an
// expression is reached by the emitter in an order this pass does not replay.
function collectIfExprLocals(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  const bare = unwrapParen(exprIx)
  const n = P.nodes[bare]
  if n is IfStmt { return collectLocalsIf(bare, fnIx) }
  0
}

// Record that the arm block at `blockIx` had its prelude locals allocated here, so
// `emitIfArmOpen` may lower them (`armPreludeBlocks`). Only a multi-statement arm carries a
// prelude, which keeps the membership scan trivial. Idempotent: a node index is arena-unique,
// so a re-walk must not append a duplicate.
function markArmPrelude(blockIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    if b.blkStmts.length > 1 {
      let i = 0
      while i < armPreludeBlocks.length {
        if armPreludeBlocks[i] == blockIx { return 0 }
        i = i + 1
      }
      armPreludeBlocks.push(blockIx)
    }
  }
  0
}

// Collect the declared locals of the `IfStmt` at `ifIx`: its then-branch block, plus its else,
// which is either a `Block` or another `IfStmt`. The `else if` case recurses through this
// function, so every arm of an arbitrarily long chain is walked — mirroring how `emitStmt`
// re-enters each arm, so the slots match the `let`s it stores into. Returns 0, or -1.
export function collectLocalsIf(ifIx: i32, fnIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    markArmPrelude(s.ifThen)
    if s.ifElse >= 0 { markArmPrelude(s.ifElse) }
    // Narrow `n` to its variant across the then-branch, mirroring `emitStmt`, so a
    // `let x = n.arrField` over a narrowed union-variant array field is classified as an array
    // local here: `exprArray` and `memFieldTypeCode` resolve the variant field type only while
    // narrowing is active. Save and restore, so the else branch and nesting are unaffected.
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const trc = collectLocals(s.ifThen, fnIx)
    if narrowed { restoreNarrow(savedTop) }
    if trc < 0 { return -1 }
    if s.ifElse >= 0 {
      // A union narrows to the complement set in the else arm, mirroring `emitStmt`'s else
      // lowering, so a binding of the narrowed variant's field inside `else { … }` is classified
      // under the narrowing the emit applies. Save and restore.
      const savedElseTop = narrowTop
      const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
      const els = P.nodes[s.ifElse]
      let erc = 0
      if els is Block {
        erc = collectLocals(s.ifElse, fnIx)
      } else if els is IfStmt {
        // `else if …` — walk the nested if (and its own else chain) recursively.
        erc = collectLocalsIf(s.ifElse, fnIx)
      }
      if narrowedElse { restoreNarrow(savedElseTop) }
      if erc < 0 { return -1 }
    }
    return 0
  }
  emitFail("emitProgram: collectLocalsIf: not an if statement")
}

// Validate the `LetDecl` at `letIx`: its initializer must exist and be an i32 value. A missing
// init, or an init whose annotation names a non-i32 type, fails loudly. Without a per-expression
// type checker the init's value type is approximated, so an init expression outside the i32
// vocabulary fails loudly. Returns 0, or -1 via `emitFail`.
function checkLocalI32(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letInit < 0 {
      // An uninitialized `let x: T` is legal for a scalar (i32 or boolean) annotation: the
      // checker guarantees write-before-read and the wasm local's implicit zero-init covers the
      // declaration. A ref-typed or un-annotated uninitialized local still fails, since a
      // non-null ref has no default.
      if d.letType >= 0 {
        const ty = P.nodes[d.letType]
        if ty is TypeRef {
          // The arena where it covers the node, the name where it does not. This is a decline
          // gate — it decides whether an uninitialized local may lean on wasm's implicit
          // zero-init — so the dangerous direction is under-answering, which would reject a
          // valid program.
          const pz = nodeTyPrimName(d.letType)
          if nodeTyIxOf(d.letType) >= 0 {
            if pz == "i32" || pz == "boolean" { return 0 }
          } else if ty.tyName == "i32" || ty.tyName == "boolean" {
            return 0
          }
        }
      }
      return emitFail("emitProgram: local declaration needs an initializer")
    }
    if d.letType >= 0 {
      const ty = P.nodes[d.letType]
      if ty is TypeRef {
        // Canon's banked type, not canon's rendered name: `canonTyIxOf` is the arena type of the
        // softened spelling, banked at the rewrite. Reading it where canon rewrote and `nodeTyIx`
        // where it did not agrees on `const kMix: K | i32` too, a litunion alias mixed with its
        // own base. `boolean` rides in an i32, so a `boolean` local is the same i32 slot.
        let lcTy = nodeTyIxOf(d.letType)
        if canonRewroteNode(d.letType) { lcTy = canonTyIxOf(d.letType) }
        const lcBase = tyScalarBasePrim(lcTy)
        if lcBase != "i32" {
          if lcBase != "boolean" {
            if !nodeTyIsLitUnionAlias(d.letType) {
              return emitFail("emitProgram: only i32 locals are supported")
            }
          }
        }
      } else {
        return emitFail("emitProgram: local type is not a type name")
      }
    }
    return checkExprI32(d.letInit)
  }
  emitFail("emitProgram: not a local declaration")
}

// Reject init expressions that cannot yield an i32: a string literal, or a float `NumLit` whose
// lexeme has a `.`, fails loudly. `BoolLit` and `CharLit` are i32 values and pass, as do i32
// literals, identifiers, parens, unary and binary arithmetic and calls, whose operand shapes the
// per-node emitters re-check. Returns 0, or -1.
function checkExprI32(exprIx: i32) {
  if exprIx < 0 {
    return emitFail("emitProgram: missing local initializer expression")
  }
  const e = P.nodes[exprIx]
  if e is StrLit {
    return emitFail("emitProgram: only i32 locals are supported")
  }
  if e is NumLit {
    // A float literal carries a "." in its lexeme — out of scope (i32 only).
    let i = 0
    while i < e.numText.length {
      if e.numText[i] == '.' {
        return emitFail("emitProgram: only i32 locals are supported")
      }
      i = i + 1
    }
    return 0
  }
  0
}

// Walk the block at `blockIx`, descending into `if` branches and `while` bodies as
// `collectLocals` does, and collect every distinct ref-list `.push` receiver slot into
// `fnRefPushSlots`. Parallel to the `blockPushPopBits` walk but recording the slot rather than
// testing presence, so a function pushing onto `Tok[]` and `Diag[]` reserves a frame for each.
export function collectRefPushSlots(blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      if callIsPushKind(stmts[i], fnIx, "ref") {
        const s = P.nodes[stmts[i]]
        if s is Call {
          const callee = P.nodes[s.callFn]
          if callee is Member {
            recordRefPushSlot(refListSlotOfExpr(callee.memObj, fnIx))
          }
        }
      }
      const s = P.nodes[stmts[i]]
      if s is IfStmt { collectRefPushSlotsIf(stmts[i], fnIx) }
      else if s is WhileStmt { collectRefPushSlots(s.whileBody, fnIx) }
      else if s is ForRange { collectRefPushSlots(s.frBody, fnIx) }
      else if s is ForIn { collectRefPushSlots(s.fiBody, fnIx) }
      i = i + 1
    }
  }
  0
}

// Collect ref-push receiver slots from every arm of the `if` / `else if` chain at `ifIx` — the
// then-branch, an `else` block, and recursively each chained `else if`. Mirrors
// `ifChainPushPopBits`'s recursion, so a push under two or more `else if` arms is recorded.
function collectRefPushSlotsIf(ifIx: i32, fnIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    collectRefPushSlots(s.ifThen, fnIx)
    if s.ifElse >= 0 {
      const els = P.nodes[s.ifElse]
      if els is Block { collectRefPushSlots(s.ifElse, fnIx) }
      else if els is IfStmt { collectRefPushSlotsIf(s.ifElse, fnIx) }
    }
  }
  0
}

// Record the ref-list table slot of every Member-receiver ref-list `.pop` in expression `exprIx`
// into `fnRefPushSlots`, so its typed scratch frame is reserved — the pop-side analogue of
// `collectRefPushSlots`, descending value positions, since a `.pop` is a value.
export function collectMemberPopRefSlotsExpr(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  const e = P.nodes[exprIx]
  if e is Call {
    // D1592 — a ref-list `.push` in value position needs the same typed frame as the `.pop`
    // beside it. `fnUsesRefPush` is inert in `fbBeginFunc`, where ref frames come from
    // `fnRefPushSlots`, so teaching only the kind bits reserves nothing here.
    if (
      callIsMemberPopKind(exprIx, fnIx, "ref") ||
      callIsPushKind(exprIx, fnIx, "ref")
    ) {
      const callee = P.nodes[e.callFn]
      if callee is Member {
        recordRefPushSlot(refListSlotOfExpr(callee.memObj, fnIx))
      }
    }
    const args = e.callArgs
    let i = 0
    while i < args.length {
      collectMemberPopRefSlotsExpr(args[i], fnIx)
      i = i + 1
    }
    return 0
  }
  if e is BinExpr {
    collectMemberPopRefSlotsExpr(e.binLeft, fnIx)
    collectMemberPopRefSlotsExpr(e.binRight, fnIx)
    return 0
  }
  if e is Member { return collectMemberPopRefSlotsExpr(e.memObj, fnIx) }
  if e is OptMember { return collectMemberPopRefSlotsExpr(e.omObj, fnIx) }
  if e is Index {
    collectMemberPopRefSlotsExpr(e.idxArr, fnIx)
    collectMemberPopRefSlotsExpr(e.idxIndex, fnIx)
    return 0
  }
  if e is Unary { return collectMemberPopRefSlotsExpr(e.unArg, fnIx) }
  if e is Paren { return collectMemberPopRefSlotsExpr(e.parInner, fnIx) }
  // The node set below is the one `exprHasCoalesceCall` (emit_query.vl) carries: a ref-list
  // `.pop` in an `is` guard, an `as` operand, an array-literal element, an object-literal field
  // value or an if-expression arm records its slot here. `fnUsesRefPush` is inert in
  // `fbBeginFunc`, so without this the frame is never reserved and the build fails.
  if e is IsExpr { return collectMemberPopRefSlotsExpr(e.isObj, fnIx) }
  if e is AsExpr { return collectMemberPopRefSlotsExpr(e.asObj, fnIx) }
  if e is IfStmt { return collectMemberPopRefSlotsIf(exprIx, fnIx) }
  if e is ObjLit {
    const fs = e.objFields
    let fi = 0
    while fi < fs.length {
      const f = P.nodes[fs[fi]]
      if f is FieldInit { collectMemberPopRefSlotsExpr(f.fiValue, fnIx) }
      fi = fi + 1
    }
    return 0
  }
  if e is ArrayLit {
    const es = e.arrElems
    let ei = 0
    while ei < es.length {
      collectMemberPopRefSlotsExpr(es[ei], fnIx)
      ei = ei + 1
    }
    return 0
  }
  0
}

// Walk the block at `blockIx` (if/else + while) collecting Member-receiver ref-list
// `.pop` slots from statements + let-inits / returns / while-conds.
export function collectMemberPopRefSlots(blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      const s = P.nodes[stmts[i]]
      if s is LetDecl {
        collectMemberPopRefSlotsExpr(s.letInit, fnIx)
      } else if s is RetStmt {
        collectMemberPopRefSlotsExpr(s.retArg, fnIx)
      } else if s is IfStmt {
        collectMemberPopRefSlotsIf(stmts[i], fnIx)
      } else if s is WhileStmt {
        collectMemberPopRefSlotsExpr(s.whileCond, fnIx)
        collectMemberPopRefSlots(s.whileBody, fnIx)
      } else if s is ForIn {
        collectMemberPopRefSlotsExpr(s.fiIter, fnIx)
        collectMemberPopRefSlots(s.fiBody, fnIx)
      } else if s is ForRange {
        collectMemberPopRefSlotsExpr(s.frFrom, fnIx)
        collectMemberPopRefSlotsExpr(s.frTo, fnIx)
        collectMemberPopRefSlots(s.frBody, fnIx)
      } else {
        // Bare expression statement — a fall-through, not only the `BinExpr` and `Call` shapes.
        // See `blockHasArrNew`.
        collectMemberPopRefSlotsExpr(stmts[i], fnIx)
      }
      i = i + 1
    }
  }
  0
}

// Collect Member-receiver ref-list `.pop` slots from every arm of the `if` chain, condition
// included: `if b.xs.pop() != null { … }` holding the function's only ref-list `.pop` would
// otherwise record no slot and emit against a local the vector never declared. `startScanIf`
// (emit_sections.vl) hand-scans a top-level `if`'s condition for the scalar bits, not for this.
function collectMemberPopRefSlotsIf(ifIx: i32, fnIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    collectMemberPopRefSlotsExpr(s.ifCond, fnIx)
    collectMemberPopRefSlots(s.ifThen, fnIx)
    if s.ifElse >= 0 {
      const els = P.nodes[s.ifElse]
      if els is Block { collectMemberPopRefSlots(s.ifElse, fnIx) }
      else if els is IfStmt { collectMemberPopRefSlotsIf(s.ifElse, fnIx) }
    }
  }
  0
}

// Reserve the LEQG frame for compare rep `(kind, slot)` and for every level below it — the
// reservation twin of `emitListEqGCore`'s recursion, along the same home. A nested compare has
// two live loops at once (`f64[][] == f64[][]` runs an outer and an inner), so each level needs
// its own frame. The three older cores reserve through their own flags and stop.
function leqgNoteRep(kind: i32, slot: i32, depth: i32) {
  if depth > 32 { return 0 }
  if kind == 0 {
    fnUsesListEqI = true
    return 0
  }
  if kind == 3 {
    fnUsesListEqS = true
    // The per-element string compares stage operands in the string-op frame.
    fnUsesStrOp = true
    return 0
  }
  if kind == 1 && slot >= 0 && slot < rlElemKindTbl.length {
    if rlElemKindTbl[slot] == 4 {
      // The `i32[][]` core, which recurses into the i32 one.
      fnUsesListEqI = true
      let ri = 0
      let rseen = false
      while ri < fnListEqRSlots.length {
        if fnListEqRSlots[ri] == slot { rseen = true }
        ri = ri + 1
      }
      if !rseen { fnListEqRSlots.push(slot) }
      return 0
    }
  }
  let seen = false
  let i = 0
  while i < fnListEqGKinds.length {
    if fnListEqGKinds[i] == kind && fnListEqGSlots[i] == slot { seen = true }
    i = i + 1
  }
  if !seen {
    fnListEqGKinds.push(kind)
    fnListEqGSlots.push(slot)
  }
  const cls = eqgElemClass(kind, slot)
  // A string leaf rides the shared `__str_eq__` helper, which stages nothing itself — but an
  // operand may still widen an atom into the string-op frame, the same reason `leqNoteBin`'s
  // `k == 5` arm sets it.
  if cls == 2 { fnUsesStrOp = true }
  if cls == 3 {
    return leqgNoteRep(eqgInnerKind(slot), eqgInnerSlot(slot), depth + 1)
  }
  0
}

// D1095 — reserve a compare frame for every list arm of a union `==`. A boxed union arm whose
// atom is a list carries the list wrapper in the box's `value` field, so comparing that arm runs
// the ordinary list core over two wrappers. Every arm, not the one the operands pick: the
// lowering emits a compare per shared arm, and under-reserving is invalid wasm.
function leqNoteUnionArms(uname: string) {
  if uname == "" { return 0 }
  const arms: string[] = []
  splitUnionAtoms(unionMemberSetOf(uname), arms)
  let ui = 0
  while ui < arms.length {
    const lk = leqCoreKindOfAtomKind(valueAtomKind(arms[ui]))
    if lk >= 0 { leqgNoteRep(lk, 0, 0) }
    // D1096 — a list field of a struct arm needs a frame for the same reason a list arm does:
    // the arm's own compare walks its variant row field by field, so a list-repped field runs
    // the ordinary list core one level in. The scan above only sees the arm atoms.
    leqNoteVariantFields(variantIndexOf(arms[ui]))
    ui = ui + 1
  }
  0
}

// Reserve a compare frame per list field of variant row `vi`, mirroring `leqNoteBin`'s walk over
// a struct row's fields. The map is `eqVariantListFieldKind`, the one home the field emitter
// reads, so a frame reserved here and a core emitted there are one decision.
function leqNoteVariantFields(vi: i32) {
  if vi < 0 { return 0 }
  if vi >= uFieldStart.length { return 0 }
  if vi >= uFieldCount.length { return 0 }
  const start = uFieldStart[vi]
  let j = 0
  while j < uFieldCount[vi] {
    if start + j < uFieldTypes.length {
      let c = uFieldTypes[start + j]
      // A `T[] | null` arm field runs its non-null twin's core under a null guard, so the
      // frame it needs is that twin's — the struct row's walk resolves it the same way (D1180).
      const cn = nulFieldInnerCode(c)
      if cn >= 0 { c = cn }
      // A ref-list field's frame is keyed by the slot its element name resolves to, exactly as
      // the struct row's code-5 arm keys its own.
      if c == 5 {
        const en = uFieldElemName[start + j]
        if en != "" {
          const rs = rlSlotByNameKeyTy(en, 0 - 1)
          if rs >= 0 { leqgNoteRep(1, rs, 0) }
        }
      }
      const lk = eqVariantListFieldKind(c)
      if lk >= 0 { leqgNoteRep(lk, 0, 0) }
    }
    j = j + 1
  }
  0
}

// Note one BinExpr's list-op kind into the per-function frame flags. `listOpKindOfBin` decides
// `+`; a `==` or `!=` it does not claim falls to the one compare-core home `emitEqNonNullCore`
// reads, so a core reserved here and a core emitted there are the same decision — otherwise the
// emitted core writes locals nobody declared.
function leqNoteBin(binIx: i32, fnIx: i32) {
  const ub = P.nodes[binIx]
  if ub is BinExpr {
    if ub.binOp == "==" || ub.binOp == "!=" {
      leqNoteUnionArms(unionNameOfExpr(ub.binLeft, fnIx))
      leqNoteUnionArms(unionNameOfExpr(ub.binRight, fnIx))
    }
  }
  let k = listOpKindOfBin(binIx, fnIx)
  if k < 0 { k = eqCoreKindOfBin(binIx, fnIx) }
  if k == 0 { fnUsesListEqI = true }
  if k == 3 {
    fnUsesListEqS = true
    // The per-element string compares stage operands in the string-op frame.
    fnUsesStrOp = true
  }
  // The string-eq helper stages nothing itself, but a nullable-string compare the string-op
  // scan (`exprHasStrOp` → `exprIsStrEq`) does not claim still reaches this core through the
  // banked type, and its operands may widen an atom into the string-op frame.
  if k == 5 { fnUsesStrOp = true }
  if k == 4 {
    // The nested element compare recurses into the i32-list frame.
    fnUsesListEqI = true
    const e = P.nodes[binIx]
    if e is BinExpr {
      // Either operand may be the one whose rep resolves a slot — a mixed pairing
      // (`i32[][] | null == i32[][]`) can have the nullable side unresolvable, and
      // `emitEqNonNullCore` falls back the same way, so both must.
      let slot = refListSlotOfExpr(e.binLeft, fnIx)
      if slot < 0 { slot = refListSlotOfExpr(e.binRight, fnIx) }
      if slot >= 0 {
        let seen = false
        let i = 0
        while i < fnListEqRSlots.length {
          if fnListEqRSlots[i] == slot { seen = true }
          i = i + 1
        }
        if !seen { fnListEqRSlots.push(slot) }
      }
    }
  }
  // A `==` or `!=` over a list rep with no core of its own needs a 4-slot compare frame per
  // level, from the same home `emitBinExprNode`'s dispatch reads. Gated on `k == 7`, the token
  // `eqCoreKindOfBin` returns for exactly this rung: a `gk >= 0` forces it, so the gate cannot
  // miss a frame, and every other binary stops paying a second whole classification.
  if k == 7 {
    const gk = eqgListKindOfBin(binIx, fnIx)
    if gk >= 0 { leqgNoteRep(gk, eqgListSlotOfBin(binIx, fnIx), 0) }
  }
  // A struct equality whose field is a list needs a compare frame too, and the lookups above
  // note none: they read the binary's own operands, which here are structs, so
  // `eqgListKindOfBin` answers -1 and `emitListEqGCore` refuses (D1017). Walk the row and note
  // a frame per ref-list field.
  const eqRow = binEqStructRow(binIx, fnIx)
  if eqRow >= 0 {
    const fc = eqRowFieldCount(eqRow)
    let fj = 0
    while fj < fc {
      // A `T[] | null` field compares through its non-null twin's core under a null guard, so
      // the frame it needs is that twin's — resolved through the one home the emitter opens the
      // guard from, else the guard runs over a frame nobody reserved (D1180).
      let fjc = eqRowFieldTypeAt(eqRow, fj)
      const fjn = nulFieldInnerCode(fjc)
      if fjn >= 0 { fjc = fjn }
      if fjc == 5 {
        const en = sFieldElemNameAt(eqRow, fj)
        if en != "" {
          const rs = rlSlotByNameKeyTy(en, -1)
          if rs >= 0 { leqgNoteRep(1, rs, 0) }
        }
      }
      // …and a scalar-backed list field needs one for the same reason (D1020): the cores exist
      // for `string[]`, `f64[]`, `i64[]`, `f32[]` and `u8[]` fields, so what this supplies is
      // the frame here and the routing there.
      const eqSk = eqScalarListFieldKind(fjc)
      if eqSk >= 0 { leqgNoteRep(eqSk, 0, 0) }
      fj = fj + 1
    }
  }
  // A `+` over a non-i32 list rep needs its own 4-slot concat frame. The i32 list is excluded
  // because it rides LEQI's `out` slot, which `k == 0` above already reserved; a second frame
  // would move every later frame's base and change the bytes of every concatenating program.
  const ck = catListKindOfBin(binIx, fnIx)
  if ck > 0 {
    const cs = catListSlotOfBin(binIx, fnIx)
    let cseen = false
    let ci = 0
    while ci < fnListCatKinds.length {
      if fnListCatKinds[ci] == ck && fnListCatSlots[ci] == cs { cseen = true }
      ci = ci + 1
    }
    if !cseen {
      fnListCatKinds.push(ck)
      fnListCatSlots.push(cs)
    }
  }
  0
}

// Recursive expression walk noting every list `==`/`!=`/`+` site (and, riding the
// same walk, every function-identity equality site — `cloEqNoteBin`).
export function leqScanExpr(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  const e = P.nodes[exprIx]
  if e is BinExpr {
    // Both note functions claim only `==`, `!=` and `+`, and so does every classifier they
    // ask, so a binary of any other operator reserves nothing. Read the operator once here
    // rather than re-reading it inside each of the six — a new classifier that claims a
    // fourth operator has to widen this gate with it.
    if e.binOp == "==" || e.binOp == "!=" || e.binOp == "+" {
      leqNoteBin(exprIx, fnIx)
      cloEqNoteBin(exprIx, fnIx)
    }
    leqScanExpr(e.binLeft, fnIx)
    return leqScanExpr(e.binRight, fnIx)
  }
  if e is Unary { return leqScanExpr(e.unArg, fnIx) }
  if e is Paren { return leqScanExpr(e.parInner, fnIx) }
  if e is Call {
    leqScanExpr(e.callFn, fnIx)
    const args = e.callArgs
    let i = 0
    while i < args.length {
      leqScanExpr(args[i], fnIx)
      i = i + 1
    }
    return 0
  }
  if e is Member { return leqScanExpr(e.memObj, fnIx) }
  if e is OptMember { return leqScanExpr(e.omObj, fnIx) }
  if e is Index {
    leqScanExpr(e.idxArr, fnIx)
    return leqScanExpr(e.idxIndex, fnIx)
  }
  if e is ArrayLit {
    const es = e.arrElems
    let i2 = 0
    while i2 < es.length {
      leqScanExpr(es[i2], fnIx)
      i2 = i2 + 1
    }
    return 0
  }
  if e is ObjLit {
    const fs = e.objFields
    let i3 = 0
    while i3 < fs.length {
      const f = P.nodes[fs[i3]]
      if f is FieldInit { leqScanExpr(f.fiValue, fnIx) }
      i3 = i3 + 1
    }
    return 0
  }
  if e is IsExpr { return leqScanExpr(e.isObj, fnIx) }
  if e is AsExpr { return leqScanExpr(e.asObj, fnIx) }
  // An if-expression (`const b = if c { xs == ys } else { false }`) is an `IfStmt` node in a
  // value slot, and `emitExpr` lowers its arms through the ordinary path, so a list `==`, `!=`
  // or `+` in an arm stages operands in `leqIScratchBase` / `leqSScratchBase`. Hand it to the
  // statement walker, which already covers the condition and both arms.
  if e is IfStmt { return leqScanStmt(exprIx, fnIx) }
  0
}

// Statement-level walk (descends branch/loop bodies; a bare expression
// statement falls through to the expression walk).
export function leqScanStmt(stmtIx: i32, fnIx: i32) {
  if stmtIx < 0 { return 0 }
  const s = P.nodes[stmtIx]
  if s is LetDecl { return leqScanExpr(s.letInit, fnIx) }
  if s is RetStmt { return leqScanExpr(s.retArg, fnIx) }
  if s is IfStmt {
    leqScanExpr(s.ifCond, fnIx)
    leqScanBlock(s.ifThen, fnIx)
    return leqScanBlock(s.ifElse, fnIx)
  }
  if s is WhileStmt {
    leqScanExpr(s.whileCond, fnIx)
    return leqScanBlock(s.whileBody, fnIx)
  }
  if s is ForRange {
    leqScanExpr(s.frFrom, fnIx)
    leqScanExpr(s.frTo, fnIx)
    leqScanExpr(s.frStep, fnIx)
    return leqScanBlock(s.frBody, fnIx)
  }
  if s is ForIn {
    leqScanExpr(s.fiIter, fnIx)
    return leqScanBlock(s.fiBody, fnIx)
  }
  if s is Block { return leqScanBlock(stmtIx, fnIx) }
  leqScanExpr(stmtIx, fnIx)
}

export function leqScanBlock(ix: i32, fnIx: i32) {
  if ix < 0 { return 0 }
  const b = P.nodes[ix]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      leqScanStmt(stmts[i], fnIx)
      i = i + 1
    }
    return 0
  }
  leqScanStmt(ix, fnIx)
}

// Walk the statement or expression tree at `ix`, recording every `.map` and `.filter` call over
// a list receiver into the scratch-frame requirement lists above and setting `fnUsesMapFilter`.
// Mirrors `blockHasCallRef`'s node coverage; a nested `FuncDecl` is not descended, since its own
// body's sites are detected when that lifted function is emitted.
export function mfScan(ix: i32, fnIx: i32) {
  if ix < 0 { return 0 }
  const n = P.nodes[ix]
  if n is Call {
    const callee = P.nodes[n.callFn]
    if callee is Member {
      if callee.memProp == "map" || callee.memProp == "filter" {
        if n.callArgs.length == 1 {
          const rk = mfRecvKindOf(callee.memObj, fnIx)
          if rk != null {
            fnUsesMapFilter = true
            let slot = -1
            if rk == "ref" { slot = refListSlotOfExpr(callee.memObj, fnIx) }
            mfRecordSrc(rk, slot)
            const resK = mfResultKindOf(ix, fnIx)
            if resK != null { mfRecordDst(resK, mfResultSlotOf(ix, fnIx)) }
          }
        }
      }
      // `xs.slice(start, end?)` builds a new list of the same element type, so it reserves the
      // same source wrapper and destination backing scratch locals a `.filter` does.
      // `emitArrSlice` reads the source through `srcL` and writes the range into a fresh `dstL`.
      if callee.memProp == "slice" {
        if n.callArgs.length == 1 || n.callArgs.length == 2 {
          const rk = mfRecvKindOf(callee.memObj, fnIx)
          if rk != null {
            fnUsesMapFilter = true
            let slot = -1
            if rk == "ref" { slot = refListSlotOfExpr(callee.memObj, fnIx) }
            mfRecordSrc(rk, slot)
            mfRecordDst(rk, slot)
          }
        }
      }
      // `m.keys()` builds a fresh LIVE-key string list — reserve its 6-slot frame.
      if callee.memProp == "keys" {
        if exprMap(callee.memObj, fnIx) { fnUsesMapKeys = true }
      }
      // `m.values()` builds a fresh live-value list. A mono map uses the self-contained
      // `mapValsBase` frame; an mv-slot map uses its per-slot output backing (`mvValsOutBase`)
      // plus the key-list frame for live, i, j and count.
      if callee.memProp == "values" {
        if exprMap(callee.memObj, fnIx) {
          const vsh = mapShapeOfExpr(callee.memObj, fnIx)
          if vsh == -1 {
            fnUsesMapVals = true
          } else if vsh == -4 {
            // The i32-keyed map's values are the mono i32 list — the same self-contained
            // `mapValsBase` frame the string-keyed mono map uses.
            fnUsesMapVals = true
          } else if vsh == -5 {
            // An i32-keyed `Set`'s `.values()` are its keys, so the bound form is built by the
            // key-list path and needs that frame. A Set's shape is neither the mono `-1` nor an
            // mv slot, so the arms either side of this one both miss it. The string-keyed half
            // is deliberately not taught here: this scan also fires on `for v in s.values()`.
            fnUsesMapKeys = true
          } else if vsh >= 0 {
            fnUsesMapVals = true
            fnUsesMapKeys = true
          }
        }
      }
    }
    mfScan(n.callFn, fnIx)
    const args = n.callArgs
    let i = 0
    while i < args.length {
      mfScan(args[i], fnIx)
      i = i + 1
    }
    return 0
  }
  if n is Block {
    const stmts = n.blkStmts
    let i = 0
    while i < stmts.length {
      mfScan(stmts[i], fnIx)
      i = i + 1
    }
    return 0
  }
  if n is LetDecl {
    if n.letInit >= 0 { mfScan(n.letInit, fnIx) }
    return 0
  }
  if n is RetStmt {
    if n.retArg >= 0 { mfScan(n.retArg, fnIx) }
    return 0
  }
  if n is IfStmt {
    mfScan(n.ifCond, fnIx)
    mfScan(n.ifThen, fnIx)
    if n.ifElse >= 0 { mfScan(n.ifElse, fnIx) }
    return 0
  }
  if n is WhileStmt {
    mfScan(n.whileCond, fnIx)
    mfScan(n.whileBody, fnIx)
    return 0
  }
  if n is ForRange {
    mfScan(n.frFrom, fnIx)
    mfScan(n.frTo, fnIx)
    if n.frStep >= 0 { mfScan(n.frStep, fnIx) }
    mfScan(n.frBody, fnIx)
    return 0
  }
  if n is ForIn {
    mfScan(n.fiIter, fnIx)
    mfScan(n.fiBody, fnIx)
    return 0
  }
  if n is BinExpr {
    mfScan(n.binLeft, fnIx)
    mfScan(n.binRight, fnIx)
    return 0
  }
  if n is Unary { return mfScan(n.unArg, fnIx) }
  if n is Paren { return mfScan(n.parInner, fnIx) }
  if n is Member { return mfScan(n.memObj, fnIx) }
  if n is Index {
    mfScan(n.idxArr, fnIx)
    mfScan(n.idxIndex, fnIx)
    return 0
  }
  if n is ObjLit {
    const fields = n.objFields
    let i = 0
    while i < fields.length {
      const f = P.nodes[fields[i]]
      if f is FieldInit { mfScan(f.fiValue, fnIx) }
      i = i + 1
    }
    return 0
  }
  if n is ArrayLit {
    const elems = n.arrElems
    let i = 0
    while i < elems.length {
      mfScan(elems[i], fnIx)
      i = i + 1
    }
    return 0
  }
  0
}

// Reset the interning counter (call once per module, before assigning indices).
function mResetTypeIntern() {
  mNextType = 0
  0
}

// Allocate the next heap-type index (interning in emit order): return the current
// counter, then advance it by one. This is the single auditable place a type index
// is minted — every `mIntern*` below funnels through here.
function mAllocType() {
  const idx = mNextType
  mNextType = mNextType + 1
  idx
}

// The mv slot whose value type-name is `vn`, or -1 when none. A mono map value (i32, boolean or
// literal-union atom) is never interned, so a map element resolves its struct heap to
// `mStructIdxPre` or `mvMapTypeIdx` by this lookup. The non-failing sibling of
// `mvSlotOfValNameFind`: the element-heap resolver below must tolerate the mono case.
function mvSlotByValNameOrK(vn: string, keyI32: boolean): i32 {
  const aOr = mvSlotOfValNameTyK(vn, keyI32)
  if aOr >= 0 { return aOr }
  mvSlotByValNameK(vn, keyI32)
}

// The mv slot a map-element ref-list slot's value occupies — the element-heap resolver's twin of
// `rlElemMapValMvSlot`. Arena first, with the element-name surgery as the fall-through; `canon`
// picks which name leg, since the second heap pass canonicalises the value name and the first
// does not. The arena leg answers only a real slot, so its miss is swallowed, never returned.
function rlMapElemValSlot(slot: i32, canon: boolean): i32 {
  const ar = rlElemMapValMvSlotAt(slot, true)
  if ar >= 0 { return ar }
  let en = rlElemName[slot]
  const enn = nulMapInnerName(en)
  if enn != "" { en = enn }
  let vn = mapValNameOf(en)
  if canon { vn = mvCanonValName(vn) }
  mvSlotByValNameOrK(vn, rlElemMapKeyI32(slot))
}

// The variant struct heap index of ref-list slot `slot`'s element (`Cat[]` gives the `Cat`
// variant's `uVarHeap`), or -1. One home, so the dedup signature pass and the element-heap pass
// cannot drift: they are the same question by construction, the sig pass existing to predict the
// heap pass. The name peel stays because no sweep reaches an arena reading of it.
function rlElemVariantHeap(slot: i32): i32 {
  const rsen = nonNulBaseOf(rlElemName[slot])
  const evi = variantIndexOf(rsen)
  if evi < 0 { return -1 }
  uVarHeap[evi]
}

// Walk the type-section emit order with the `mAllocType` counter, assigning each type's heap
// index into the module-global index state; returns the functype base index (`typeOffset`). The
// order must match the type-section emission exactly. An absent type family mints nothing, and
// its index globals still take the counter position they would have occupied.
export function mAssignTypeIndices(_n: i32) {
  mResetTypeIntern()

  // Standalone structs occupy the first indices, one heap type per distinct structure:
  // structural twins share a slot's heap index rather than minting a fresh one, so a `B`-value
  // and an `A`-slot use the same `(ref $S)`. `sTwin[i] < i` marks slot `i` a twin of an earlier
  // one, and `emitTypeSection` skips the same twins in lock-step, keeping the counts in sync.
  buildStructTwins()
  // Assigned in `structEmitOrder`, not in declaration order (D622): wasm requires a declared
  // supertype to hold a lower type index than its subtype, and a supertype here is a shorter
  // field list. The order function holds a row back until every proper prefix has an index and
  // degenerates to declaration order otherwise. `emitTypeSection` walks the same function.
  sHeapIdx = []
  let shi = 0
  while shi < sNames.length {
    sHeapIdx.push(-1)
    shi = shi + 1
  }
  const sOrd = structEmitOrder()
  let soi = 0
  while soi < sOrd.length {
    sHeapIdx[sOrd[soi]] = mAllocType()
    soi = soi + 1
  }
  // Twins take their representative's index; the representative is always in `sOrd`, so it
  // already has one.
  let stw = 0
  while stw < sNames.length {
    if sTwin[stw] < stw { sHeapIdx[stw] = sHeapIdx[sTwin[stw]] }
    stw = stw + 1
  }
  // Union variant structs (one heap type per distinct variant layout), then the union box.
  // `uVarTwin[vi] < vi` marks variant `vi` a layout twin of an earlier slot — the same `sTwin`
  // discipline — so it reuses that heap index and the type-section emit skips it in lock-step.
  // Covers both one variant name pushed by two unions and a declared name against its shape.
  uVarHeap = []
  uVarTwin = []
  if uDeclared {
    buildVariantTwins()
    let vi = 0
    while vi < uVariants.length {
      if uVarTwin[vi] < vi {
        uVarHeap.push(uVarHeap[uVarTwin[vi]])
      } else if uVarSTwinAt(vi) >= 0 {
        // The cross-table merge: this arm's layout IS a declared struct's, so it takes
        // that row's already-allocated heap index instead of minting a second one. The
        // type section skips it in lock-step (`emitTypeSection`'s variant loop).
        uVarHeap.push(sHeapIdx[uVarSTwinAt(vi)])
      } else {
        uVarHeap.push(mAllocType())
      }
      vi = vi + 1
    }
    uBoxIdx = mAllocType()
    // The per-rep value boxes (`{ i32 }` / `{ i64 }` / `{ f32 }` / `{ f64 }`), in this fixed
    // rep order — only the reps a registered value union uses.
    if vbI32Used { vbI32Idx = mAllocType() }
    if vbI64Used { vbI64Idx = mAllocType() }
    if vbF32Used { vbF32Idx = mAllocType() }
    if vbF64Used { vbF64Idx = mAllocType() }
  }
  // The raw i32 array (list and map backing), then `string`'s own backing array, then the string
  // header struct `{backing, start, len}`, then the i32-list wrapper. All three string-side
  // indices are minted from the one `aUsed` flag, which string use and list use both force, and
  // every string lowering already guards on it. The type section emits the triple in this order.
  if aUsed {
    aTypeIdx = mAllocType()
    sBackIdx = mAllocType()
    sTypeIdx = mAllocType()
  } else {
    aTypeIdx = mNextType
    sBackIdx = mNextType
    sTypeIdx = mNextType
  }
  if lUsed { lTypeIdx = mAllocType() } else { lTypeIdx = mNextType }
  // Ref-list slot dedup, the `sTwin` analogue: two slots emit identical (backing, wrapper) pairs
  // exactly when they resolve to the same element heap, so after struct dedup `A[]` and `B[]`
  // must share one wrapper. `rlTwin[s]` is `s`'s representative, from a signature knowable up
  // front; a map-array element and any unresolved element stay unique and are never merged.
  rlTwin = []
  const rlSig: string[] = []
  let rss = 0
  while rss < rlElemName.length {
    const rsk = rlElemKindTbl[rss]
    let sig = "u:" + i32ToStr(rss) // default: unique (no dedup)
    if rsk == 2 {
      sig = "h:" + i32ToStr(uBoxIdx)
    } else if rsk == 4 {
      sig = "h:" + i32ToStr(lTypeIdx)
    } else if rsk == 5 || rsk == 6 || rsk == 7 || rsk == 8 || rsk == 10 {
      sig = "k:" + i32ToStr(rsk)
    } else if rsk == 9 {
      const inner = rlElemInnerSlot(rss)
      if inner >= 0 { sig = "9:" + i32ToStr(rlTwin[inner]) }
    } else if rsk == 3 {
      // A map element. A mono map element resolves the shared `mStructIdxPre`; a typed-value
      // one resolves its value slot's `mvMapTypeIdx`, whose twin decision is knowable here from
      // the canonical value slot (`mvCanonRepOf`). A nullable map element strips to its inner
      // map first, as both heap passes do; un-stripped it twins onto a mono-map-element slot.
      const mmv = rlMapElemValSlot(rss, false)
      if mmv < 0 {
        // MONO on BOTH key reps, and they are two DIFFERENT structs — so the mono sig
        // has to name the key or an `{[i32]: i32}` element would twin onto a
        // `{[string]: i32}` one and take its (string-ref keys) struct.
        sig = "3:m"
        if rlElemMapKeyI32(rss) { sig = "3:mi32" }
      } else {
        sig = "3:" + i32ToStr(mvCanonRepOf(mmv))
      }
    } else {
      // Struct, nullable-struct or variant element — the `else` heap resolution below.
      // `rlElemStructRow` peels the `| null` niche off the arena type it resolves, with the
      // recorded element name as the fall-through, so an inline-shape element spelling keys the
      // same post-twin heap its declared twin does.
      const esi = rlElemStructRow(rss)
      if esi >= 0 {
        sig = "h:" + i32ToStr(sHeapIdx[esi])
      } else {
        // The concrete-variant fall-through — `rlElemVariantHeap`, which is also the heap
        // pass's, and which carries this leg's note about the name peel.
        const evh = rlElemVariantHeap(rss)
        if evh >= 0 { sig = "h:" + i32ToStr(evh) }
      }
    }
    rlSig.push(sig)
    let rep = rss
    let sj = 0
    while sj < rss {
      if rlSig[sj] == sig { rep = sj; sj = rss }
      sj = sj + 1
    }
    rlTwin.push(rep)
    rss = rss + 1
  }
  // Distinct pairs = slots that are their own representative (each mints 2 heap types).
  let rlDistinctPairs = 0
  let rdp = 0
  while rdp < rlElemName.length {
    if rlTwin[rdp] == rdp { rlDistinctPairs = rlDistinctPairs + 1 }
    rdp = rdp + 1
  }
  // The map struct index is needed below to resolve a map-array ref-list element, yet the map
  // struct lands after the ref pairs and the string-list. It is computable up front from the
  // counter: it follows the distinct ref-pair slots, two per emitted pair post-dedup, plus the
  // two string-list slots.
  const mStructIdxPre = mNextType + rlDistinctPairs * 2 + 2
  // One (backing, wrapper) pair per DISTINCT ref-list element type, interleaved; a
  // twin (`rlTwin[rs] < rs`) reuses its representative's pair (no new heap type).
  let rs = 0
  while rs < rlElemName.length {
    if rlTwin[rs] < rs {
      rlBackIdx[rs] = rlBackIdx[rlTwin[rs]]
      rlWrapIdx[rs] = rlWrapIdx[rlTwin[rs]]
    } else {
      rlBackIdx[rs] = mAllocType()
      rlWrapIdx[rs] = mAllocType()
    }
    if rlElemKindTbl[rs] == 2 {
      rlElemHeap[rs] = uBoxIdx
    } else if rlElemKindTbl[rs] == 3 {
      // A map-struct element. The mono map (i32, boolean or atom value) is the shared
      // `mStructIdxPre`; a typed-value map element has its own map struct (`mvMapTypeIdx`,
      // minted after this loop) and is deferred to the second pass below. This is the
      // position-independent rep: a map element resolves the same struct a binding does.
      if rlMapElemValSlot(rs, false) < 0 {
        // The MONO map of the element's OWN key rep: the string-keyed struct, or its
        // i32-keyed twin one index later (`mStructI32Idx`, minted immediately after —
        // the same "computable up front from the counter" reasoning as `mStructIdxPre`).
        if rlElemMapKeyI32(rs) {
          rlElemHeap[rs] = mStructIdxPre + 1
        } else {
          rlElemHeap[rs] = mStructIdxPre
        }
      } else {
        rlElemHeap[rs] = 0
      }
    } else if rlElemKindTbl[rs] == 4 {
      // An `i32[][]` slot's element is the i32-list WRAPPER (interned just above,
      // so `lTypeIdx` is already assigned).
      rlElemHeap[rs] = lTypeIdx
    } else if (
      rlElemKindTbl[rs] == 6 ||
      rlElemKindTbl[rs] == 7 ||
      rlElemKindTbl[rs] == 8 ||
      rlElemKindTbl[rs] == 10 ||
      rlElemKindTbl[rs] == 11
    ) {
      // string[][] / f64[][] / i64[][]: the element is the inner list's WRAPPER
      // (`mkListIdx` / `fl64TypeIdx` / `il64TypeIdx`) — but those wrappers are allocated AFTER
      // this loop, so a second pass (below) fills these heaps once they exist.
      rlElemHeap[rs] = 0
    } else if rlElemKindTbl[rs] == 9 {
      // A struct-LIST value (`S[]`): the element is the inner struct-list WRAPPER, the ref-list
      // wrapper of the inner `S` slot (interned at a LOWER index, so its `rlWrapIdx` is set).
      rlElemHeap[rs] = rlWrapIdx[rlElemInnerSlot(rs)]
    } else {
      // A NULLABLE-struct element (`(P | null)[]`, slot key "P | null"): the backing is a
      // `(ref null $P)` over the bare struct — `rlElemStructRow` peels the `| null`
      // (structurally) to resolve P's heap, and its name fall-through bridges an
      // inline-shape spelling to its declared twin.
      const esi = rlElemStructRow(rs)
      if esi >= 0 {
        rlElemHeap[rs] = sHeapIdx[esi]
      } else {
        // A concrete-VARIANT element (`Cat[]`): the element heap is the variant struct
        // `uVarHeap[vi]` (no standalone `sNames` entry — variants ride the union's structs).
        const evh = rlElemVariantHeap(rs)
        if evh >= 0 { rlElemHeap[rs] = evh } else { rlElemHeap[rs] = 0 }
      }
    }
    rs = rs + 1
  }
  // The legacy singletons alias slot 0 (or the next index when no ref list).
  if rlElemName.length >= 1 {
    raTypeIdx = rlBackIdx[0]
    rlTypeIdx = rlWrapIdx[0]
  } else {
    raTypeIdx = mNextType
    rlTypeIdx = mNextType
  }
  // The string-ref list (keys backing + keys wrapper), shared by the map's keys
  // list AND any `string[]` field (present when `slUsed || mUsed`).
  if slUsed || mUsed {
    mkArrIdx = mAllocType()
    mkListIdx = mAllocType()
  } else {
    mkArrIdx = mNextType
    mkListIdx = mNextType + 1
  }
  // The map struct (present only when `mUsed`); `mStructIdxPre` is this counter
  // position, precomputed above for the ref-pair loop.
  if mUsed { mStructIdx = mAllocType() } else { mStructIdx = mStructIdxPre }
  // The i32-KEYED map struct, immediately after its string-keyed twin (present only
  // when `mI32Used`, so no index moves in a program without one). Identical 7 fields
  // with `keys` re-typed to the i32 list wrapper — both of whose heap types are
  // already assigned above, so it needs no forward reference.
  if mI32Used {
    mStructI32Idx = mAllocType()
  } else {
    mStructI32Idx = mStructIdx
  }
  // The f64 array and list-wrapper pair, interned last among the heap types so no existing index
  // shifts: the `(array (mut f64))` backing first, then its `{backing,len,cap}` wrapper struct,
  // which references the backing. Present only when `fa64Used`.
  if fa64Used {
    fa64TypeIdx = mAllocType()
    fl64TypeIdx = mAllocType()
  } else {
    fa64TypeIdx = mNextType
    fl64TypeIdx = mNextType + 1
  }
  // The i64-list pair, immediately after the f64 pair (same "interned late so no existing
  // index shifts" discipline): the `(array (mut i64))` backing then its `{backing,len,cap}`
  // wrapper. Present only when `ia64Used`; aliases its slots otherwise (zero types minted).
  if ia64Used {
    ia64TypeIdx = mAllocType()
    il64TypeIdx = mAllocType()
  } else {
    ia64TypeIdx = mNextType
    il64TypeIdx = mNextType + 1
  }
  // The f32-list pair, immediately after the i64 pair (same "interned late" discipline): the
  // `(array (mut f32))` backing then its `{backing,len,cap}` wrapper. Present only when
  // `fa32Used`; aliases its slots otherwise (zero types minted).
  if fa32Used {
    fa32TypeIdx = mAllocType()
    fl32TypeIdx = mAllocType()
  } else {
    fa32TypeIdx = mNextType
    fl32TypeIdx = mNextType + 1
  }
  // The `u8[]` pair, immediately after the f32 pair and under the same "interned late"
  // discipline: the PACKED `(array (mut i8))` backing then its `{backing,len,cap}`
  // wrapper. Present only when `ba8Used`; aliases its slots otherwise, so a program with
  // no `u8[]` mints nothing and every earlier heap-type index is untouched.
  if ba8Used {
    ba8TypeIdx = mAllocType()
    bl8TypeIdx = mAllocType()
  } else {
    ba8TypeIdx = mNextType
    bl8TypeIdx = mNextType + 1
  }
  // Second pass: fill the NON-i32 nested-list ref-list element heaps now that the inner
  // string/f64/i64 list wrappers exist (a `string[]`/`f64[]`/`i64[]`-VALUED map's vals
  // ref-list — kinds 6/7/8). The wrappers are forced by `mvShapeOfValName` (slUsed / fa64Used
  // / ia64Used), so the index is real here.
  let rsfix = 0
  while rsfix < rlElemName.length {
    if rlElemKindTbl[rsfix] == 6 { rlElemHeap[rsfix] = mkListIdx }
    else if rlElemKindTbl[rsfix] == 7 { rlElemHeap[rsfix] = fl64TypeIdx }
    else if rlElemKindTbl[rsfix] == 10 { rlElemHeap[rsfix] = fl32TypeIdx }
    else if rlElemKindTbl[rsfix] == 8 { rlElemHeap[rsfix] = il64TypeIdx }
    else if rlElemKindTbl[rsfix] == 11 { rlElemHeap[rsfix] = bl8TypeIdx }
    rsfix = rsfix + 1
  }
  // The function-value closure types, interned last among the heap types so no existing index
  // shifts: the closure fat-pointer struct `{ code: (ref $fnsig), env: structref }` first, then
  // the env-leading functype `$fnsig`, mutually recursive in one rec group. Then one env struct
  // per capturing lifted function, capture order being field order. Only when `fnValUsed`.
  fnEnvIdx = []
  if fnValUsed {
    cloStructIdx = mAllocType()
    // A CLOSURE-element ref-list slot (kind 5, `((i32) => i32)[]`) backs onto the closure
    // fat-pointer struct. `cloStructIdx` is interned HERE (after the ref-pair loop above),
    // so backfill those slots' element heap type now — the backing array `(array (mut (ref
    // null $cloStructIdx)))` forward-references it within the shared rec group.
    let rcs = 0
    while rcs < rlElemName.length {
      if rlElemKindTbl[rcs] == 5 { rlElemHeap[rcs] = cloStructIdx }
      rcs = rcs + 1
    }
    // One `$fnsig` functype per distinct value-call signature (`cloSigKeys`).
    cloSigBase = mNextType
    let sa = 0
    while sa < cloSigKeys.length {
      mAllocType()
      sa = sa + 1
    }
    // One env struct per capturing lifted function (in `fnStmts` order). A
    // non-capturing function gets `-1` (its closure env is `ref.null structref`).
    let fe = 0
    while fe < fnStmts.length {
      const ncap = captureCountOf(fe)
      if ncap > 0 { fnEnvIdx.push(mAllocType()) } else { fnEnvIdx.push(-1) }
      fe = fe + 1
    }
  } else {
    cloStructIdx = mNextType
    cloSigBase = mNextType + 1
  }
  // The ref-valued map structs, one 7-field struct per distinct value layout, interned last so
  // no existing index shifts. Slot dedup: the struct's only varying field is the vals-list
  // wrapper, so two slots whose value types are layout twins emit the same bytes and must share
  // one heap index. The vals-wrapper interlock makes a predicate or `rlSig` drift loud.
  mvTwin = []
  let mvi = 0
  while mvi < mvValName.length {
    const mvRep = mvCanonRepOf(mvi)
    mvTwin.push(mvRep)
    if mvRep < mvi {
      const k6 = mvValKind[mvi]
      if k6 == 1 || k6 == 2 || k6 == 6 || k6 == 14 {
        if rlWrapIdx[mvRlSlot[mvi]] != rlWrapIdx[mvRlSlot[mvRep]] {
          return emitFail(
            "emitProgram: map-value layout twins resolved different vals wrappers",
          )
        }
      }
      mvMapTypeIdx[mvi] = mvMapTypeIdx[mvRep]
    } else {
      mvMapTypeIdx[mvi] = mAllocType()
    }
    mvi = mvi + 1
  }
  // Second pass for the TYPED-value map ref-list elements (kind 3, deferred above): now
  // that `mvMapTypeIdx` is minted, point each such element's heap at its own typed map
  // struct. A mono / atom map element kept `mStructIdxPre` in the first pass (slot -1).
  let rmf = 0
  while rmf < rlElemName.length {
    if rlElemKindTbl[rmf] == 3 {
      // `canon` means the value-name leg canonicalizes (`mvCanonValName`) before its lookup: the
      // mv table is keyed canonically, so a raw element-map name would miss the slot and leave
      // the element heap at the shared mono map while the map's own binding uses the box-backed
      // struct. Mirrors `mvShapeOfValName`; the arena leg folds that itself.
      const mmv = rlMapElemValSlot(rmf, true)
      if mmv >= 0 { rlElemHeap[rmf] = mvMapTypeIdx[mmv] }
    }
    rmf = rmf + 1
  }
  // The functypes follow; the first lands at the current counter (`typeOffset`).
  mNextType
}

// Whether an annotation spelling that mentions an i32-keyed map is one the emitter can lower:
// 0 when it is, else the loud reject (-1) naming the position that failed. Passing this gate is
// not the same as being collected — a spelling this accepts whose flag nothing sets still emits
// a module with no i32-key scratch frame, `vl check` rc 0 and invalid wasm (ROADMAP B6a).
function i32MapSpellingLowerable(name: string) {
  let bare = name
  // A top-level function type (`() => {[i32]: V}`) delegates to its return spelling: the
  // closure-result boundary carries the map's shape (`cloRetValSlot`), the same key-paired slot
  // every other boundary carries. The arrow must be top-level, so an array of such closures is
  // not peeled here and stays a loud reject.
  const fr = annRetNameOf(name)
  if fr != "" { bare = fr }
  // An array of maps (`{[i32]: V}[]`, and the `({[i32]: V} | null)[]` niche whose one layer of
  // grouping parens `listElemNameOf` strips): peel to the element and ask the same question of
  // it. One `[]` only, so `{[i32]: V}[][]`, whose inner-list element row is a ref-list slot of
  // its own, keeps the loud reject rather than a guess.
  const ae = listElemNameOf(bare)
  if ae != "" { bare = ae }
  const inner = nulMapInnerName(bare)
  if inner != "" { bare = inner }
  if nameIsMapSpanEnds(bare) && nameIsI32KeyedMap(bare) { return 0 }
  // A shape spelling — an inline struct annotation or an inline union arm — delegates to its
  // fields. This is the one position whose map is invisible to the scan that reaches this gate:
  // the whole shape is one `TypeRef` name. Each field text is asked this same question, so the
  // set a field may hold is exactly the set any other position may hold, and nothing wider.
  if nameIsShapeSpanEnds(bare) { return i32MapShapeFieldsLowerable(bare) }
  // A union spelling (`{f: {[i32]: V}} | i32`): every member that mentions an i32-keyed map must
  // be a struct arm, asked as the shape above. A member that is the map itself, boxed, is
  // deliberately not peeled — the box carries no map shape, so it stays a loud reject.
  if unionMemberCount(bare) > 1 {
    const atoms: string[] = []
    splitUnionAtoms(bare, atoms)
    let ai = 0
    while ai < atoms.length {
      if strContains(atoms[ai], "{[i32]:") {
        if !nameIsShapeSpanEnds(atoms[ai]) {
          return i32MapSpellingUnsupported(name)
        }
        if i32MapShapeFieldsLowerable(atoms[ai]) < 0 { return -1 }
      }
      ai = ai + 1
    }
    return 0
  }
  i32MapSpellingUnsupported(name)
}

// The gate's reject, named once: three sites raise it — the leaf test above, the union arm's
// non-shape member, and a shape's field through the recursion — and the message must not drift
// between them. Each position the message names is exercised by a corpus case and lowers today;
// a map value is deliberately absent, since `{[string]: {[i32]: boolean}}` reaches this reject.
function i32MapSpellingUnsupported(name: string): i32 {
  emitFail(
    "emitProgram: an i32-keyed Map/Set is supported as a binding / parameter / " +
      "return / `| null` / an ARRAY ELEMENT / a closure result — not inside '" +
      name +
      "'. A STRING-keyed map lowers in every position; otherwise bind the i32-keyed " +
      "map on its own and pass it where you need it.",
  )
}

// Ask `i32MapSpellingLowerable` of every field of the shape spelling `nm` that mentions an
// i32-keyed map. The field row's key column is what makes this legal: a map field records only
// its value, and the key column is the other half of the mv slot's identity. A field that does
// not mention the key rep is not examined; this gate answers for the i32-keyed rep alone.
function i32MapShapeFieldsLowerable(nm: string): i32 {
  const fnames: string[] = []
  const ftexts: string[] = []
  // The group-interior cut at its home (`tyname.groupInnerOf`); the guard is the caller's
  // `nameIsShapeSpanEnds`.
  shapeInnerFieldSplit(groupInnerOf(nm), fnames, ftexts)
  let i = 0
  while i < ftexts.length {
    if strContains(ftexts[i], "{[i32]:") {
      if i32MapSpellingLowerable(ftexts[i]) < 0 { return -1 }
    }
    i = i + 1
  }
  0
}

// The one home of "reserve the backing and wrapper heap types the type name `a` needs". A
// presence flag is a reservation: `mAssignTypeIndices` mints a heap type only where the flag is
// set, and an unminted index falls through to `mNextType`, so a missed reservation is
// check-clean invalid wasm rather than a missing feature. Monotone, so a redundant call is inert.
function forceAnnLeafReps(a: string): i32 {
  if nameIsStringArray(a) {
    slUsed = true
    aUsed = true
  } else if nameIsF64Array(a) {
    fa64Used = true
  } else if nameIsI64Array(a) {
    ia64Used = true
  } else if nameIsF32Array(a) {
    fa32Used = true
  } else if nameIsBareMap(a) {
    mUsed = true
    lUsed = true
    aUsed = true
  } else if nameIsNulI32List(a) {
    lUsed = true
    aUsed = true
  } else if arrElemIs(a, "i32") || arrElemIs(a, "boolean") {
    lUsed = true
    aUsed = true
  } else if nameIsString(a) || nameIsNulString(a) {
    aUsed = true
  } else if nulScalarListKind(a) != null {
    const nsk = nulScalarListKind(a)
    if nsk == "nulstrlist" {
      slUsed = true
      aUsed = true
    }
    if nsk == "nulf64list" { fa64Used = true }
    if nsk == "nuli64list" { ia64Used = true }
    if nsk == "nulf32list" { fa32Used = true }
    // The packed-byte backing a `u8[] | null` cell's value needs. Its three siblings above mark
    // their backings here; without this one the literal path's `!ba8Used` floor refuses a
    // program whose cell is already typed `nulu8list`.
    if nsk == "nulu8list" { ba8Used = true }
  }
  0
}

// Reserve the reps a generic application's type arguments need. They are invisible to every
// branch of `collectA`'s `TypeRef` ladder, since the whole spelling `Box<string>` is one name, so
// without this `aTypeIdx` names whatever heap type sits at an index never allocated. Flag-only
// and outside the ladder: it bypasses no arm, and at worst allocates a type nothing needed.
function forceGenAppArgTypes(name: string): i32 {
  if !annGenAppSpanEnds(name) { return 0 }
  const args: string[] = []
  const head = annGenAppDecompose(name, args)
  if head == "" { return 0 }
  let i = 0
  while i < args.length {
    const a = args[i]
    // A nested application (`Box<Pair<i32, string>>`) is the same reservation one rung in.
    forceGenAppArgTypes(a)
    forceAnnLeafReps(a)
    i = i + 1
  }
  0
}

// Reserve the reps a closure field's signature needs, at every depth of an annotation spelling.
// `collectA`'s `annRetNameOf` rung handles a top-level function type; a closure spelled as a
// struct field (`{f: () => string}`) reaches no rung, because the top-level arrow scan stops at
// the brace. Scope: it forces only from types reached through an arrow nested in a composite.
function forceNestedCloSigReps(nm: string, depth: i32): i32 {
  if depth > 6 { return 0 }
  if nm == "" { return 0 }
  // A union or nullable spelling: the shape may sit in any arm. `splitUnionAtoms` stops at a
  // top-level `=>`, so a function type reaches the arrow rung below as one atom.
  const arms: string[] = []
  splitUnionAtoms(nm, arms)
  if arms.length > 1 {
    let ai = 0
    while ai < arms.length {
      forceNestedCloSigReps(arms[ai], depth + 1)
      ai = ai + 1
    }
    return 0
  }
  // An array of the spelling (`{f: () => string}[]`) — peel one layer and continue.
  if nameIsArray(nm) {
    return forceNestedCloSigReps(listElemNameOf(nm), depth + 1)
  }
  // A top-level function type: descend into its parts without forcing them, so the
  // `annRetNameOf` rung stays the sole owner of a top-level return's reservation.
  const tps: string[] = []
  const tret = annFnDecompose(nm, tps)
  if tret != "" {
    forceNestedCloSigReps(tret, depth + 1)
    let ti = 0
    while ti < tps.length {
      forceNestedCloSigReps(tps[ti], depth + 1)
      ti = ti + 1
    }
    return 0
  }
  // A shape. Every field whose text carries a top-level arrow is a closure field: force the reps
  // its result and parameters name, then keep descending — a result may itself be a shape with a
  // closure field of its own.
  if !nameIsShapeSpanEnds(nm) { return 0 }
  const fnames: string[] = []
  const ftexts: string[] = []
  // The group-interior cut at its home (`tyname.groupInnerOf`); the guard above is the bound
  // that home requires.
  shapeInnerFieldSplit(groupInnerOf(nm), fnames, ftexts)
  let fi = 0
  while fi < ftexts.length {
    const ft = ftexts[fi]
    const ps: string[] = []
    const ret = annFnDecompose(ft, ps)
    if ret != "" {
      forceAnnLeafReps(ret)
      forceNestedCloSigReps(ret, depth + 1)
      let pi = 0
      while pi < ps.length {
        forceAnnLeafReps(ps[pi])
        forceNestedCloSigReps(ps[pi], depth + 1)
        pi = pi + 1
      }
    } else {
      forceNestedCloSigReps(ft, depth + 1)
    }
    fi = fi + 1
  }
  0
}

// Gather every FuncDecl type-parameter name — a standalone scan, because a `T[]` annotation node
// precedes its FuncDecl in the arena and a gather-as-you-go walk would see it too early. Its own
// pass, ahead of `collectS`, because the shape interner is a consumer too. It resumes from
// `genTyParamSeen`, since `collectA` asks it again after every minted generic instance.
export function collectTyParamNames() {
  let gtp = genTyParamSeen
  while gtp < P.nodes.length {
    const gnd = P.nodes[gtp]
    if gnd is FuncDecl {
      const gtps = gnd.fnTyParams
      let gj = 0
      while gj < gtps.length {
        genTyParamNames.push(gtps[gj])
        gj = gj + 1
      }
    }
    gtp = gtp + 1
  }
  genTyParamSeen = P.nodes.length
  0
}

// The callee names `collectA`'s `Call` arm classifies. One home, so the arm and the rename
// note below cannot disagree about which of the monomorphizer's in-place renames changes the
// answer for a node the resumable prefix has already walked.
function collectACallIntrinsic(name: string): boolean {
  if name == "fromCodePoint" || name == "fromCodePoints" { return true }
  if name == "Map" || name == "Set" { return true }
  name == "__array_new__" || name == "__array_new_default__"
}

// The monomorphizer renames a call's callee in place. Nine of its ten in-place writes land in
// `fnStmts`, `fnParent` or a `Param`, which the walk never reads; a rename of one of the names
// above is the exception, and it retires the prefix instead of extending it.
export function collectANoteIdentRename(oldName: string) {
  if collectACallIntrinsic(oldName) { caSeenNodes = -1 }
  0
}

// Pop `t` back to `n` entries. Two arities, because the row columns are half `string[]` and
// half `i32[]` and one shared helper cannot take both.
function caPopI32(t: i32[], n: i32) {
  while t.length > n { t.pop() }
  0
}

function caPopStr(t: string[], n: i32) {
  while t.length > n { t.pop() }
  0
}

// Pop the ref-list and map-value rows the previous run's field-table phase appended past the
// arena walk. A row's index is its slot and a union's box tags are positional, so a resumed
// walk's own rows must land where a full re-mint puts them — ahead of that tail, which is
// re-derived below either way (B7 of `docs/internals/perf-opportunities-2026-09.md`).
function caPopFieldTail() {
  caPopStr(rlElemName, caRlMark)
  caPopI32(rlElemKey, caRlMark)
  caPopI32(rlElemTyIx, caRlMark)
  caPopI32(rlElemHeap, caRlMark)
  caPopI32(rlBackIdx, caRlMark)
  caPopI32(rlWrapIdx, caRlMark)
  caPopI32(rlElemKindTbl, caRlMark)
  caPopI32(rlElemNullable, caRlMark)
  caPopStr(mvValName, caMvMark)
  caPopI32(mvKeyI32, caMvMark)
  caPopI32(mvValTyIx, caMvMark)
  caPopI32(mvValKind, caMvMark)
  caPopI32(mvValStructIdx, caMvMark)
  caPopI32(mvValVariantIdx, caMvMark)
  caPopI32(mvValArmSig, caMvMark)
  caPopI32(mvRlSlot, caMvMark)
  caPopI32(mvMapTypeIdx, caMvMark)
  0
}

// Can this call extend the tables over the arena suffix instead of re-minting them? Only with
// a prefix banked and every registry the walk classifies against unmoved: `refArrElemKind`
// reads `unNames` and `uVariants`, `nameIsRefArray` the struct table, `genTyParamArr` the
// type-parameter set, and a row added to any of them re-classifies a node already walked.
function collectAResumable(): boolean {
  if !caResumeArmed { return false }
  if caSeenNodes < 0 { return false }
  if caSeenNodes > P.nodes.length { return false }
  if caSeenUnSets != unMemberSet.length { return false }
  if caSeenUnNames != unNames.length { return false }
  if caSeenVariants != uVariants.length { return false }
  if caSeenSNames != sNames.length { return false }
  if caSeenSFields != sFieldTypes.length { return false }
  if caSeenUFields != uFieldTypes.length { return false }
  caSeenTyParams == genTyParamNames.length
}

// Bank the prefix this run's tables cover, with the registry lengths that classify it. Only
// an armed run banks, so no prefix crosses a pass that edits the arena in place. Read back by
// `collectAResumable`, which leads with `caSeenNodes`.
function collectABankPrefix() {
  if !caResumeArmed { return 0 }
  caSeenUnSets = unMemberSet.length
  caSeenUnNames = unNames.length
  caSeenVariants = uVariants.length
  caSeenSNames = sNames.length
  caSeenSFields = sFieldTypes.length
  caSeenUFields = uFieldTypes.length
  caSeenTyParams = genTyParamNames.length
  caSeenNodes = P.nodes.length
  0
}

// Scan the arena for every use of a collection heap type, setting the presence flags and
// minting the ref-list, map-value and annotation-node rows keyed against them; an unclaimed
// array annotation fails loudly. Asked once per minted generic instance, so it resumes on an
// arena prefix — B7 of `docs/internals/perf-opportunities-2026-09.md`. Returns 0, or -1.
export function collectA(_stmts: i32[]) {
  collectTyParamNames()
  // The read-only-covariance write memo is keyed by slot number, which a re-mint and a
  // resumed walk's own new rows both move (D791). Ahead of the fork, since both invalidate it.
  rlWrSlots = []
  rlWrAns = []
  pendingNulRefHeap = -1
  const resume = collectAResumable()
  let start = caSeenNodes
  // Retired for the duration: a walk that refuses mid-arena leaves the tables partial, and the
  // next call must re-mint rather than resume from a prefix that never finished.
  caSeenNodes = -1
  if resume {
    caPopFieldTail()
  } else {
    start = 0
    aUsed = false
    lUsed = false
    raUsed = false
    rlUsed = false
    rElemKind = 0
    rlElemName = []
    rlElemKey = []
    rlElemTyIx = []
    // The per-annotation-node row sidecar names ROWS this pass is about to re-mint, so
    // it is cleared with them and refilled by the walk below.
    annRlSlot = []
    annRlNul = []
    rlElemHeap = []
    rlBackIdx = []
    rlWrapIdx = []
    rlTwin = []
    rlElemKindTbl = []
    rlElemNullable = []
    mUsed = false
    mI32Used = false
    slUsed = false
    fa64Used = false
    mvValName = []
    mvKeyI32 = []
    mvValTyIx = []
    mvValKind = []
    mvValStructIdx = []
    mvValVariantIdx = []
    mvValArmSig = []
    mvRlSlot = []
    mvMapTypeIdx = []
    mvTwin = []
    // Re-mark the list-type flags the registered value unions force: `collectU` set them at
    // registration but the resets above cleared them, and a union annotation (`f64[] | boolean`)
    // is none of the bare-name forms the walk recognizes. Skipped by a resume, whose rows are
    // still in hand; these run first, so their rows stay at the head of the table.
    let umk = 0
    while umk < unMemberSet.length {
      markValueUnionAtoms(unMemberSet[umk])
      // A ref-array union arm (`S[] | {w:i32}`) lost its interned reflist slot to the resets
      // above, so re-intern it here — the ref-array twin of the value-atom re-mark. This is the
      // authoritative ref-array-arm interning: `collectU`'s registration-time call is wiped by
      // those same resets, so the box payload's wrapper heap comes from here.
      markRefArrayArms(unMemberSet[umk])
      // The authoritative map-arm re-intern (`{[string]: string} | f64`): the resets above clear
      // the mv tables, so re-intern each map arm's value slot here — its per-value map struct heap
      // comes from this pass, before `mAssignTypeIndices`, the map twin of the re-mark above.
      markMapUnionArms(unMemberSet[umk])
      umk = umk + 1
    }
  }
  let i = start
  while i < P.nodes.length {
    const nd = P.nodes[i]
    if nd is ArrayLit {
      // A `[…]` literal is a growable list: struct or union-variant elements make it a ref list,
      // an i32-element or empty literal contributes the i32 list. An empty literal whose element
      // the checker pinned to a registered union is invisible to `arrLitIsRef`, and the
      // synthesized annotation runs after this pass, so that slot has to be interned here.
      if nd.arrElems.length == 0 {
        const emptyElem = arrLitUnionElemName(i)
        if emptyElem != "" {
          rlUsed = true
          raUsed = true
          // Hinted with the literal's own recorded element row; every corpus firing agrees
          // with the name path, and the hint is available at each.
          rlInternNameTy(emptyElem, 2, rlHintElemTy(i))
        }
        // The same hole at the nested-array element kind: `const outer = []` then
        // `outer.push(inner)` with `inner: i32[]` reaches this pass with the element pinned to an
        // array and no row interned. The flags mirror the `arrLitIsRef` branch arm for arm,
        // because this interns the row the annotated `i32[][]` spelling interns.
        const nestElem = arrLitNestedElemName(i)
        if nestElem != "" {
          rlUsed = true
          raUsed = true
          const nestKind = arrLitNestedElemKind(i)
          // A ref inner list (kind 9 — a struct, map, union or closure leaf, or another nesting
          // level) has to intern its inner row first, because the outer element's heap is that
          // inner wrapper and the tables are read forward in this same pass. `ensureRefElemTy`
          // is the one home of that inner-first walk (D702).
          if nestKind == 9 {
            ensureRefElemTy(nestElem, rlHintElemTy(i))
          } else {
            // Same hint, same provenance; every corpus firing agrees.
            rlInternNameTy(nestElem, nestKind, rlHintElemTy(i))
            if nestKind == 4 {
              lUsed = true
              aUsed = true
            }
            if nestKind == 6 {
              slUsed = true
              aUsed = true
            }
            if nestKind == 7 { fa64Used = true }
            if nestKind == 8 { ia64Used = true }
            // The two leaf kinds this arm never had a flag for: an f32 inner list (10) rides
            // `$fl32TypeIdx`, and a map inner element (3) rides the map struct plus the i32 list
            // and array its `index` and `vals` fields use. Same flags as the `arrLitIsRef` arm.
            if nestKind == 10 { fa32Used = true }
            if nestKind == 11 { ba8Used = true }
            if nestKind == 3 {
              mUsed = true
              lUsed = true
              aUsed = true
            }
          }
        }
        // D1511 — the same hole at the shape element kind: `const xs = []` then
        // `xs.push({y: 1, x: 2})` reaches this pass with the element pinned to a struct and no
        // row interned, since no `<shape>[]` spelling exists anywhere in the program. Unhinted:
        // the name is nominal, and `rlInternNameTy` takes no key hint for a nominal spelling.
        const shapeElem = arrLitShapeElemName(i)
        if shapeElem != "" {
          rlUsed = true
          raUsed = true
          ensureRefElem(shapeElem)
        }
        // D1569 — the same hole at a scalar element kind, where the three rescues above are all
        // ref ones. `const xs = []` then `xs.push(1.5)` pins the element to an f64 the program
        // spells nowhere, so no `TypeRef` rung minted the f64 pair. The whole scalar vocabulary
        // comes off the arena in one rung, so a sixth element kind needs no fifth rescue here.
        forceScalarListRep(nodeTyArrayElemRepName(i))
      }
      if arrLitIsRef(i) {
        rlUsed = true
        raUsed = true
        rElemKind = arrLitElemKind(i)
        // A ref inner list (kind 9) interns inner-first through `ensureRefElemTy`, exactly as the
        // empty-literal arm above and the annotated spelling do: the outer element's heap is the
        // inner wrapper, and this pass reads the tables forward (D702). Additive by construction,
        // since the first-element rung answers 4/6/7/8 for a nested `ArrayLit`.
        if arrLitElemKind(i) == 9 {
          ensureRefElemTy(arrLitElemName(i), arrLitElemHintTy(i))
        } else {
          // Hinted with the arm-for-arm arena twin. -1 on every arm whose answer is a
          // NAME by design or by measurement, which is exactly today's unhinted call.
          rlInternNameTy(
            arrLitElemName(i),
            arrLitElemKind(i),
            arrLitElemHintTy(i),
          )
          // A nested `[[…]]` literal's elements are i32-list wrappers — force the
          // i32 list + raw array types for them. A string / f64 / i64 leaf (kinds
          // 6/7/8, the self-classified nested literal) forces ITS inner list's
          // wrapper+backing pair, exactly as the `T[][]` annotation branch does.
          if arrLitElemKind(i) == 4 {
            lUsed = true
            aUsed = true
          }
          if arrLitElemKind(i) == 6 {
            slUsed = true
            aUsed = true
          }
          if arrLitElemKind(i) == 7 { fa64Used = true }
          if arrLitElemKind(i) == 8 { ia64Used = true }
          // A map element (kind 3) forces the map struct plus the i32 list and array its `index`
          // and `vals` fields ride — the three flags an annotated map element gets from
          // `ensureRefElem`'s `k == 3` arm, which a bare literal never reaches. `mI32Used`, that
          // arm's fourth, is already flipped for this shape by the `Map()` constructor arm.
          if arrLitElemKind(i) == 3 {
            mUsed = true
            lUsed = true
            aUsed = true
          }
          // The f32 inner list (kind 10), the leaf the old allow-list could not admit — its
          // element is the `$fl32TypeIdx` wrapper, so force that pair exactly as 6/7/8 above
          // force theirs. Beside kind 3 for the same reason: both are now reachable here.
          if arrLitElemKind(i) == 10 { fa32Used = true }
          if arrLitElemKind(i) == 11 { ba8Used = true }
        }
      } else if arrLitIsStr(i, -1) {
        // A STRING-element literal is a string-ref list — the same wrapper/backing
        // a `string[]` annotation forces.
        slUsed = true
        aUsed = true
      } else if arrLitIsF64(i, -1) {
        // An f64-element literal is an f64 list — its own `(array (mut f64))` backing and
        // wrapper. It does not force `aUsed` or `lUsed`, which are the i32 array and list.
        fa64Used = true
      } else if arrLitIsI64(i, -1) {
        // An i64-MAGNITUDE-element literal (`[6000000000]` — e.g. an anon `{f: [6000000000]}`
        // field value) is an i64 list — force its wrapper/backing, like the f64 branch.
        ia64Used = true
      } else if arrLitIsF32(i, -1) {
        // An f32-element literal (`[fv]` over f32-typed values) is an f32 list — the arm
        // `emitArrLit`'s own floor asks for ("f32 array literal but f32 list type not
        // collected"). After the f64 and i64 arms, so every literal either of them claims keeps
        // its answer.
        fa32Used = true
      } else {
        lUsed = true
        aUsed = true
      }
    } else if nd is StrLit {
      aUsed = true
    } else if nd is Call {
      // A `fromCodePoint(code)` call (H2) constructs a length-1 VL string — the shared
      // `(array i32)` heap type — so it forces `aUsed` just like a string literal, even
      // in a program with no other string. The callee is a bare `Ident`.
      const cf = P.nodes[nd.callFn]
      // `m.keys()` builds a fresh STRING list of the map's keys — force the string-list
      // wrapper/backing (`mkListIdx`/`mkArrIdx`) + the shared `(array i32)`. `.keys()` is
      // only valid on a map (checker-enforced), so any such call contributes the type.
      if cf is Member {
        if cf.memProp == "keys" {
          slUsed = true
          aUsed = true
        }
      }
      // Gated on the shared vocabulary, so `collectANoteIdentRename` and this arm cannot
      // disagree about which of the monomorphizer's in-place callee renames retires the
      // resumable prefix.
      if cf is Ident && collectACallIntrinsic(cf.identName) {
        if cf.identName == "fromCodePoint" { aUsed = true }
        // `fromCodePoints(xs)` builds a fresh string from an i32 list.
        if cf.identName == "fromCodePoints" {
          aUsed = true
          lUsed = true
        }
        // An un-annotated `Map()` (usage-inferred binding) still constructs the map
        // struct — force the same types a `{[string]: i32}` annotation does. `Set()`
        // is the same 7-field map struct, so it forces the IDENTICAL types.
        if cf.identName == "Map" || cf.identName == "Set" {
          mUsed = true
          lUsed = true
          aUsed = true
          // An UN-annotated `Map()`/`Set()` whose key the checker inferred as i32
          // (`const m = Map()` then `m.set(1, 2)`) has no map spelling anywhere in the
          // arena for the `TypeRef` walk below to read, so the KEY comes off the
          // constructor call's own recorded type.
          if nodeTyMapKeyIsI32(i) { mI32Used = true }
          // …and so does the value. The `TypeRef` walk's `mvShapeOfMapName` is the only other mv
          // mint, so without this an un-annotated map with a ref or wide value resolves its type
          // and never mints its rep. Idempotent: an annotated twin interns the same (key, value)
          // slot. A `Set()` mints nothing, being boolean-valued, but the node type decides that.
          mvShapeOfMapNodeTy(i)
        }
        // The array-intrinsic allocators construct a list with no literal or annotation in
        // sight, so the pair its element kind names has to be interned here. `arrNewIntrKind` is
        // the one home of that kind, so the intern and the lowering cannot disagree about it.
        if (
          cf.identName == "__array_new__" ||
          cf.identName == "__array_new_default__"
        ) {
          const ank = arrNewIntrKind(i, -1)
          if ank == 1 {
            fa64Used = true
          } else if ank == 4 {
            ia64Used = true // D963 — the i64 list pair, interned like the f64 one
          } else if ank == 5 {
            ba8Used = true // D1470 — `__array_new_default__` over a `u8[]` destination
          } else if ank == 6 {
            fa32Used = true // D1470 — …and over an `f32[]` one
          } else if ank == 2 {
            // String fill → the string list (wrapper/backing shared with `string[]`).
            slUsed = true
            aUsed = true
          } else if ank == 3 {
            // Ref fill → the ref list of the element (intern its slot).
            rlUsed = true
            raUsed = true
            // D966 — the element kind is not always 1. Interning every ref fill as the struct
            // element holds only while the arm runs for structs; over closures, nested lists,
            // string lists and maps, a nested-list element gets a row repped as the raw backing
            // where the annotated path carries the wrapper. `ensureRefElemTy` derives the kind.
            const anFillTy = arrNewFillTyIx(i)
            if anFillTy >= 0 {
              ensureRefElemTy(refListElemNameOfExpr(i, -1), anFillTy)
            } else {
              rlInternName(refListElemNameOfExpr(i, -1), 1)
            }
          } else {
            lUsed = true
            aUsed = true
          }
        }
      }
    } else if nd is TypeRef {
      // The i32-keyed map's capability gate, asked of every annotation name before the
      // type-forcing chain below reads it. The i32-keyed rep is the mono map, with no per-value
      // map struct and no ref-list, field or element plumbing, so exactly two spellings lower and
      // every other position is a loud reject rather than invalid wasm `vl check` cannot see.
      if strContains(nd.tyName, "{[i32]:") {
        if i32MapSpellingLowerable(nd.tyName) < 0 { return -1 }
      }
      // A CLOSURE spelled as a struct FIELD reserves nothing through the rung below —
      // see `forceNestedCloSigReps`, which walks INTO the spelling for it.
      forceNestedCloSigReps(nd.tyName, 0)
      // A top-level function-type annotation (`(i32) => R`): the function-type name needs no
      // array or list type, but its return `R` may, so force the return's backing types. The
      // arrow must be top-level, so an array of functions falls through to the array branches.
      // Checked first, so a list-returning function type's trailing `[]` is not read as an array.
      const frRet = annRetNameOf(nd.tyName)
      if frRet != "" {
        // This arm takes the array grammar's one cut and compares the leaf, matching its three
        // named siblings below. Deliberately not `nameIsI32Array`, which is rep-wide (`boolean[]`,
        // a litunion `K[]` and the nullable forms all ride the i32-list backing): those force
        // their own types further down this same `TypeRef` arm.
        if arrElemIs(frRet, "i32") {
          lUsed = true
          aUsed = true
        } else if nameIsStringArray(frRet) {
          slUsed = true
          aUsed = true
        } else if nameIsF64Array(frRet) {
          fa64Used = true
        } else if nameIsString(frRet) {
          aUsed = true
        }
      } else if nameIsBareMap(nd.tyName) {
        // A `{[string]: i32}` annotation is a string-keyed map: the map struct, the keys list
        // over a string-ref backing, and the i32 vals list. So it forces `aUsed` for the string
        // and vals backings and `lUsed` for the vals wrapper, alongside the three map types.
        // Stays on the name here, since this walk sees interior `TypeRef`s the arena does not.
        mUsed = true
        lUsed = true
        aUsed = true
        // An i32-keyed map additionally forces its own map struct — its `keys` field is the i32
        // list, not the string-ref list — and the i32-keyed probe helper. The arena where it
        // covers the node, the name where it does not: `nodeTyMapKeyIsI32Span` answers false both
        // for "not i32-keyed" and for "no type for this node", and this flag must not under-mint.
        if nodeTyIxOf(i) >= 0 {
          if nodeTyMapKeyIsI32Span(i) { mI32Used = true }
        } else if nameIsI32KeyedMap(nd.tyName) {
          mI32Used = true
        }
        // A ref value type interns a per-(key, value) map slot, its own map struct over a ref
        // vals list. All mv interning happens here, since collect scans every `TypeRef`, so the
        // type-index assignment sees the full slot set. Not routed onto this node's banked map
        // type at the find rung: the call mints, and an arena answer there would skip the mint.
        mvShapeOfMapNameArmTy(nd.tyName, nodeMapValTyIx(i))
      } else if nulMapInnerName(nd.tyName) != "" {
        // A `{[string]: V} | null` annotation collects the same map types as its non-null inner
        // map, even when the program never `Map()`-constructs one: `mUsed` must be set so the
        // `$mapStruct` heap type exists for the `(ref null $mapStruct)` cell and the narrowed map
        // ops. Interns the inner value's mv slot too.
        mUsed = true
        lUsed = true
        aUsed = true
        // The arena where it covers the node, the name where it does not, and the coverage test
        // is the point: `nodeTyMapKeyIsI32Span` answers false both for "not an i32-keyed map" and
        // for "no type for this node", while `mI32Used` is a minting flag whose under-answer
        // leaves the map struct unminted. The uncovered nodes are `parser.vl`'s orphaned fields.
        if nodeTyIxOf(i) >= 0 {
          if nodeTyMapKeyIsI32Span(i) { mI32Used = true }
        } else if nameIsI32KeyedMap(nd.tyName) {
          mI32Used = true
        }
        mvShapeOfMapName(nulMapInnerName(nd.tyName))
      } else if nameIsStringArray(nd.tyName) {
        // Stays on the name, and the reason is the chain rather than the predicate. The arena
        // form is wider — it also answers for a `(string | null)[]` element sharing this backing
        // — and these rungs are an `else if` chain, so an over-answering rung does not merely set
        // its own flags, it suppresses every rung below it. Monotone flags, non-monotone chain.
        slUsed = true
        aUsed = true
      } else if nameIsRefArray(nd.tyName) || nameIsNulRefList(nd.tyName) {
        // A `S[]`/`N[]` annotation is a ref list (wrapper + `(ref null $elem)` backing) — and so is its
        // NULLABLE form `S[] | null` (kind 18): force the wrapper/backing on the NON-null ref-array name,
        // so a bare local whose value does not self-collect the element (e.g. `(i32|null)[] | null = [5]`)
        // still emits the element's ref-list type.
        let ran = nd.tyName
        const ranp = nullablePartOf(ran)
        // "Is this the NULLABLE ref-list spelling" — asked ONCE, and read again twenty
        // lines down to set the banked row's null flag. The second read is by construction
        // the same answer: `ranp` is never rewritten and no intern runs between them.
        const ranIsNul = ranp != "" && nameIsRefArray(ranp)
        if ranIsNul { ran = ranp }
        // The element kind, classified once for the seven reads in this arm, which straddle the
        // `ensureRefElem` intern — the only call between them that mutates a table the classifier
        // reads. `ran` is final here: the `| null` peel two lines up is its last write.
        const raKind = refArrElemKind(ran)
        // The element NAME, resolved ONCE for the same reason: the kind-2 reject and the
        // UNCONDITIONAL `recordAnnRlSlot` bank below both need it, so hoisting strictly
        // REMOVES work (one resolution instead of two on every kind-2 element).
        const ren = refArrElemName(ran)
        // A kind-2 (union-box) element that is a niche nullable (`(boolean | null)[]`,
        // `(string | null)[]` — one non-null member plus null, deliberately not a value union)
        // has no list rep: the box lowering would emit the element's raw value. Reject cleanly.
        // A value-union element and a struct or heterogeneous element box as usual.
        if raKind == 2 {
          const renNul = nullablePartOf(ren)
          if !isValueUnionName(ren) && renNul != "" {
            return emitFail(
              "emitProgram: a nullable-" +
                renNul +
                " list element has no rep; use a non-null element type",
            )
          }
        }
        rlUsed = true
        raUsed = true
        rElemKind = raKind
        // Bank the interned ROW on the annotation NODE (`annRlSlot`): this arm runs on
        // exactly the spellings the annotation-node consumers call a ref array, so the
        // row recorded here is the answer each of them needs — read back through
        // `annRefArrSlot` without re-deriving it from the rendering.
        let ranNul = 0
        if ranIsNul { ranNul = 1 }
        // The ref-list slot is interned from the annotation's own recorded element row where that
        // row is what the name denotes, and from the name alone where it is not
        // (`elemNameIsNominal`). -1 is the unhinted call, so every declined class is unchanged by
        // construction and the hinted firings agree with the name path.
        let renTy = -1
        if !elemNameIsNominal(ren) { renTy = annRefArrElemRow(i) }
        recordAnnRlSlot(i, ensureRefElemTy(ren, renTy), ranNul)
        // An `i32[][]` annotation's ELEMENTS are i32-list wrappers — force the
        // i32 list + raw array so `lTypeIdx`/`aTypeIdx` exist for the elements.
        if raKind == 4 {
          lUsed = true
          aUsed = true
        }
        // A nested NON-i32 scalar / string 2D array (`string[][]`/`f64[][]`/`i64[][]`, element
        // kinds 6/7/8) forces its INNER list's backing+wrapper, as the LIST-valued map path
        // does — else the element wrapper heap (`mkListIdx`/`fl64`/`il64`) is never allocated.
        if raKind == 6 {
          slUsed = true
          aUsed = true
        }
        if raKind == 7 { fa64Used = true }
        if raKind == 10 { fa32Used = true }
        if raKind == 11 { ba8Used = true }
        if raKind == 8 { ia64Used = true }
        // A map element (`{[K]: V}[]`, `({[K]: V} | null)[]`) forces the map machinery — the
        // three type flags, the element map's mv value slot and `mI32Used` for an i32 key —
        // inside `ensureRefElem` above, whose `k == 3` arm is the one home of that forcing and
        // reaches every map element in every position, not just the ones an annotation spells.
      } else if (
        nodeTyArrayElemRepName(i) == "f64" ||
        nameIsF64Array(nd.tyName)
      ) {
        // An `f64[]` annotation forces the f64 array and wrapper pair, its own
        // `(array (mut f64))` backing, independent of the i32 array and list. The name is a
        // second opinion and an `||` rather than a coverage guard: `nodeTyArrayElemRepName` only
        // answers for a `TyPrim` element, so a covered node can still fall out with "".
        fa64Used = true
      } else if (
        nodeTyArrayElemRepName(i) == "i64" ||
        nameIsI64Array(nd.tyName)
      ) {
        // An `i64[]` annotation forces the i64 array + wrapper pair (`ia64`/`il64`). Same
        // second opinion, for the same reason, with the same mis-route without it.
        ia64Used = true
      } else if (
        nodeTyArrayElemRepName(i) == "f32" ||
        nameIsF32Array(nd.tyName)
      ) {
        // The arena first, matching the f64 and i64 rungs above, with the name kept as the
        // documented second opinion. Both answers are strongly represented and agree, so the
        // arena never widens here — which matters in a minting chain where an over-answering rung
        // suppresses every rung below it. The name stays for the families the arena cannot name.

        // An `f32[]` annotation forces the f32 array + wrapper pair (`fa32`/`fl32`).
        fa32Used = true
      } else if (
        nodeTyArrayElemRepName(i) == "u8" ||
        nameIsU8Array(nd.tyName)
      ) {
        // A `u8[]` annotation forces the PACKED byte array + wrapper pair
        // (`ba8`/`bl8`). Arena first then the name, exactly as the three scalar rungs
        // above do and for the same reason: without a forcing rung here the annotation
        // falls into `checkArrName` below and is rejected as a non-i32 element array.
        ba8Used = true
      } else if genTyParamArr(nd.tyName) {
        // A `T[]` over a FuncDecl type parameter — a generic original's annotation. Its
        // monomorphized instances carry concrete pinned names when `monomorphize` re-runs this
        // pass, so nothing is forced or validated here. The union test below is `isUnionOfTy`,
        // matching a declared union by arena index and an inline one structurally.
      } else if annSpelledArray(i, nd.tyName) && !isUnionOfTy(nodeTyIxOf(i)) {
        // The union guard: a union whose last arm is an array (`S[] | T[]`, `i64 | S[]`) has a
        // name ending in `]`, so `nameIsArray` matches it — but it is a union box, not a plain
        // array. Its ref-array arms are interned by `markRefArrayArms`, so skip the array
        // validation here, which would reject the union name as a non-i32 array.
        if checkArrName(nd.tyName) < 0 { return -1 }
        // An `i32[]` annotation is a list (wrapper struct + raw-array backing).
        lUsed = true
        aUsed = true
      } else if nodeTyPrimName(i) == "string" {
        aUsed = true
        // The arena: `nodeTyIsNulString` reads `T.tys` directly, rather than a
        // `<helper>(x) == <const>` twin whose helper never produces that constant.
      } else if nodeTyIsNulString(i) {
        // A `string | null` annotation (kind 16) is a `(ref null $aTypeIdx)` slot — it still needs the
        // string backing forced, exactly like a plain `string`. Without this a bare `string | null = null`
        // (no other string in the module to force `aUsed`) left `$aTypeIdx` unallocated, so the slot
        // valtype + `ref.null` referenced a stale type index → invalid wasm at the read.
        aUsed = true
      } else if nodeTyIsNulI32List(i) {
        // An `i32[] | null` annotation still constructs/reads the i32 list — the
        // nullable wrapper changes only the slot's valtype, not the types needed.
        lUsed = true
        aUsed = true
      } else if nulScalarListKindOfNode(i) != null {
        // A distinct-backing nullable scalar list annotation (`string[]|null`, `f64[]|null`,
        // `i64[]|null`, `f32[]|null`) constructs and reads the leaf list, so force its wrapper
        // and backing even when the module has no other such list. `nulScalarListKindOfNode`
        // leads with `annRepKindOf` and falls back to the name ladder, so it cannot under-answer.
        const nsk = nulScalarListKindOfNode(i)
        if nsk == "nulstrlist" {
          slUsed = true
          aUsed = true
        }
        if nsk == "nulf64list" { fa64Used = true }
        if nsk == "nuli64list" { ia64Used = true }
        if nsk == "nulf32list" { fa32Used = true }
        if nsk == "nulu8list" { ba8Used = true }
      } else if nodeTyIsLitUnionAlias(i) || nodeTyIsNulLitUnion(i) {
        // A literal-union annotation (`: K`): an atom widens to its member `string`, so force the
        // string backing even when the module has no other string literal. The nullable niche
        // (`: K | null`) widens the same way and cannot lean on the alias arm, because the inline
        // spelling has no alias declaration whose own `TypeRef` would force it.
        aUsed = true
      }
      // A map reached only as a closure result inside this annotation — a union arm, the
      // nullable-closure niche, or a curried result — is invisible to every branch above, since
      // the whole spelling is one name. Force its machinery and intern its value slot;
      // self-gating, and outside the chain so it composes with whatever branch claimed the name.
      forceCloResultMapTypes(nd.tyName)
      // The list dual: a scalar-leaf or string list reached only as a closure result inside this
      // annotation forces its wrapper and backing, so the narrowed arm's value-call index read
      // finds them even when the program never constructs such a list. Same self-gating
      // placement as the map forcer above.
      forceCloResultListTypes(nd.tyName)
      // The generic-application dual of the two forcers above: a type argument (`Box<string>`,
      // `Pair<i32, string[]>`) no branch of the chain can see, because the whole `Head<…>` is one
      // name. Same self-gating placement and the same flag-only contract; see the helper.
      forceGenAppArgTypes(nd.tyName)
    }
    i = i + 1
  }
  // The row counts the arena walk above finished at. Everything below appends past them, so a
  // resumed walk pops back to here before extending — its own rows have to land where a full
  // re-mint would put them, ahead of this tail.
  caRlMark = rlElemName.length
  caMvMark = mvValName.length
  // Union-variant nested-struct fields (code 15): intern each field's target shape into the
  // struct table, the intern `collectShapeVariantFields`'s acceptance deferred because
  // `collectU` runs before the struct table exists. Idempotent, and a no-op for a declared
  // target name. Runs before the struct-field pass below, so a fresh shape's fields get slots.
  let ufn = 0
  while ufn < uFieldTypes.length {
    // …with the row's own arena type: `recordUFieldElemRow` records `uFieldElemTyIx` from this
    // cell, so the index the intern banks for the freshly-minted struct row is the index it
    // would otherwise re-resolve the spelling to.
    if uFieldTypes[ufn] == 15 {
      const si15 = internInlineShapeTy(
        uFieldElemName[ufn],
        uFieldElemTyIxRow(ufn),
      )
      // Re-key the row to the interned row's own name. The intern dedups, and a dedup can land
      // on a row spelled differently from the text recorded here: `annShapeIndexOf` treats one
      // wasm code as one layout, so `{b: boolean}` resolves to an existing `{b: i32}` row. The
      // code-15 consumer looks the element up by name, so a stale spelling would read -1.
      if si15 >= 0 { uFieldElemName[ufn] = sNames[si15] }
    }
    // A ref-list variant field (code 5): the variant-table twin of the struct-field pass's
    // code-5 intern below. The recorded element key may be deferred, since `shapeFieldElemName`
    // recorded the stripped element text before the struct table existed — so intern an
    // inline-shape element first, then the element's ref-list slot.
    if uFieldTypes[ufn] == 5 {
      const en5 = uFieldElemName[ufn]
      // The same row's arena type serves BOTH interns on this line and the next
      // (D-INLINESHAPETY / D-REPELEMTY) — one cell, one recorder, two consumers.
      if nameIsShapeOpen(en5) {
        internInlineShapeTy(en5, uFieldElemTyIxRow(ufn))
      }
      rlUsed = true
      raUsed = true
      // The row's arena type, threaded into the intern. `recordUFieldElemRow` records
      // `uFieldElemTyIx` from this cell's own `uFieldElemName`, so the slot key the intern
      // computes from it is the key it computes from the spelling, one `resolveAnnot` fewer.
      ensureRefElemTy(en5, uFieldElemTyIxRow(ufn))
    }
    ufn = ufn + 1
  }
  // Field-table re-derivation, the struct table then the variant table below. Two rules run
  // through every arm of both loops: a field's own type is never a standalone `TypeRef` the arena
  // scan above sees, so its needs are re-derived from the field table here; and the field may be
  // the module's only mention of its rep. Every intern below is idempotent.
  let sfi = 0
  while sfi < sFieldTypes.length {
    if sFieldTypes[sfi] == 19 || sFieldTypes[sfi] == 29 {
      // Code 29, the nullable map field, interns the same mv value slot as its non-null twin.
      mUsed = true
      lUsed = true
      aUsed = true
      // The field row's key, threaded into the intern: an mv slot's identity is the (key, value)
      // pair, so a `{[i32]: string}` field must intern the i32-keyed slot. Interning the
      // string-keyed one and then resolving the i32-keyed one is the loud "map value type has no
      // interned slot"; interning against the wrong key is the silent wrong map struct.
      const sfk = sFieldRowKeyI32(sfi)
      // …and the row's arena type, the third column of the same push. `recordSFieldElemRow`
      // computed it by calling `fieldElemTyIxOfName` on the very `sFieldElemName[sfi]` handed
      // over here, so the intern's lookup rung takes the answer instead of re-deriving it.
      mvShapeOfValNameRowTy(sFieldElemName[sfi], sfk, sFieldElemTyIxRow(sfi))
      // …and the flag. An inline shape (`const s: {m: {[i32]: i32}}`) is one `TypeRef` name, so
      // the annotation scan's bare-map arm — the site that sets `mI32Used` for every other
      // position — never sees this map. `mI32Used` gates the i32-keyed map struct, the probe
      // helper and the per-function i32-key scratch frame, whose absence is invalid wasm.
      if sfk { mI32Used = true }
    }
    // A ref-list field (code 5) and its nullable twin (28): intern the element so
    // `sFieldRefSlot` (`rlSlotByName`) resolves.
    if sFieldTypes[sfi] == 5 || sFieldTypes[sfi] == 28 {
      rlUsed = true
      raUsed = true
      // …with the row's arena type (D-REPELEMTY) — see the variant-table twin above.
      ensureRefElemTy(sFieldElemName[sfi], sFieldElemTyIxRow(sfi))
    }
    // A `string | null` field (code 20) and its non-null twin, the plain `string` field (code 3),
    // are `(ref null $aTypeIdx)` and `(ref $aTypeIdx)` slots, so both force the string backing.
    // Without it a shape whose only string is this field leaves `$aTypeIdx` unallocated, naming
    // whatever heap type sits there — invalid wasm at `vl check` rc 0. Flag-only, a separate `if`.
    if sFieldTypes[sfi] == 3 || sFieldTypes[sfi] == 20 { aUsed = true }
    // An i32/boolean-LIST field (code 4, atom-array elem name or plain) and its NULLABLE twin
    // (code 18, `i32[] | null`): force the wrapper/backing so the field valtype and any
    // narrowed read resolve.
    if sFieldTypes[sfi] == 4 || sFieldTypes[sfi] == 18 {
      lUsed = true
      aUsed = true
    }
    // A STRING-list field (code 6) and its NULLABLE twin (31, `string[] | null`), which rides
    // the SAME `$mkListIdx` wrapper: force that wrapper/backing pair.
    if sFieldTypes[sfi] == 6 || sFieldTypes[sfi] == 31 {
      slUsed = true
      aUsed = true
    }
    // A scalar-list field (f64[], i64[], f32[]; codes 25/26/27): `internInlineShape` forces the
    // pair at intern time, but this pass's re-run resets the flags, so re-derive from the table.
    forceScalarListField(sFieldTypes[sfi])
    sfi = sfi + 1
  }
  // The variant-table twins of the same arms (a shape-text variant records its map value name
  // via `shapeFieldElemName`); a mono map value (i32 / boolean / atom) is a no-op
  // (`mvShapeOfValName` returns -1, no intern).
  let ufi = 0
  while ufi < uFieldTypes.length {
    if uFieldTypes[ufi] == 4 || uFieldTypes[ufi] == 18 {
      lUsed = true
      aUsed = true
    }
    if uFieldTypes[ufi] == 6 || uFieldTypes[ufi] == 31 {
      slUsed = true
      aUsed = true
    }
    // The variant-table twin of the struct pass's code-3 / code-20 string-backing arm: a
    // union VARIANT whose field is a plain `string` (or a `string | null`) is the module's
    // only mention of the string rep just as often as a struct field is.
    if uFieldTypes[ufi] == 3 || uFieldTypes[ufi] == 20 { aUsed = true }
    forceScalarListField(uFieldTypes[ufi])
    // A NULLABLE ref-list variant field (code 28): re-intern its element so the field's
    // storage type + narrowed reads resolve the wrapper slot (`rlSlotByName`).
    if uFieldTypes[ufi] == 28 {
      rlUsed = true
      raUsed = true
      // …with the row's arena type (D-REPELEMTY) — see the code-5 arm above.
      ensureRefElemTy(uFieldElemName[ufi], uFieldElemTyIxRow(ufi))
    }
    if uFieldTypes[ufi] == 19 || uFieldTypes[ufi] == 29 {
      // Code 29, the nullable map field, belongs here too: a variant row this file writes must be
      // collectable from this file's own column, and the flags for a nullable map field on a
      // union arm otherwise arrive only by accident, from an orphaned field `TypeRef` reaching
      // the `nulMapInnerName` rung in the annotation walk.
      mUsed = true
      lUsed = true
      aUsed = true
      // The struct pass's key-and-flag rule, one table over; see its header there. Both writes
      // are jointly, not severally, necessary: either one alone is covered by the struct row an
      // inline union arm must spell to be narrowed. Kept anyway, because that covering row
      // belongs to another pass and not to this table's invariant.
      const ufk = uFieldRowKeyI32(ufi)
      // The struct pass's row-type thread, one table over.
      mvShapeOfValNameRowTy(uFieldElemName[ufi], ufk, uFieldElemTyIxRow(ufi))
      if ufk { mI32Used = true }
    }
    ufi = ufi + 1
  }
  collectABankPrefix()
  0
}

export function collectAnnShapes() {
  let ti = 0
  while ti < P.nodes.length {
    const tn = P.nodes[ti]
    if tn is TypeRef {
      // One gate and one switch, each closing a disagreement between the recorded type and what
      // the name resolves to in the emitter's context. The gate: no generic-alias type parameter
      // in the spelling, since inside such an alias the checker bound `K` to the argument while
      // the emitter re-resolves it. The switch: `canonRewroteNode(ti)` picks which column to read.
      let root = -1
      if !nameMentionsGenAliasParam(tn.tyName) {
        if canonRewroteNode(ti) {
          root = canonTyIxOf(ti)
        } else {
          root = nodeTyIxOf(ti)
        }
      }
      internShapeDeepTy(tn.tyName, root)
    }
    ti = ti + 1
  }
  0
}

// The anon-leaf resolver index (D1514). Every question this family asks is name-keyed, and each
// answered it with a fresh `P.nodes` scan and a string compare per node, nested three deep. The
// tables below hold the same nodes in the same arena order, banked once per program: a pure
// re-indexing, so no decision this family makes moves.
let anonIxOn = false
let anonIxSeen = 0
// The shared node/next pools every name-keyed list links through. A TAIL beside each head is
// what lets one FORWARD walk append in arena order, which every reader below depends on.
let anonIxLnkNode: i32[] = []
let anonIxLnkNext: i32[] = []
// name sid -> how many `FuncDecl`s spell it, and the list of them
let anonIxDeclCnt: i32[] = []
let anonIxDeclHead: i32[] = []
let anonIxDeclTail: i32[] = []
// name sid -> every `Param` / `LetDecl` / `=`-to-`Ident` node that binds it
let anonIxBindHead: i32[] = []
let anonIxBindTail: i32[] = []
// callee-name sid -> every `Call` whose callee position spells it
let anonIxCallHead: i32[] = []
let anonIxCallTail: i32[] = []
// `Block` node -> the `FuncDecl`s owning it (a list, because one reader takes the first
// match and the other folds every match)
let anonIxBodyHead: i32[] = []
let anonIxBodyTail: i32[] = []
// param-name sid -> the (owning `FuncDecl`, position) slots declaring it, in the same order
// `anonLeafParamFnTargetGo`'s nested walk produced
let anonIxParHead: i32[] = []
let anonIxParTail: i32[] = []
let anonIxParOwner: i32[] = []
let anonIxParPos: i32[] = []
let anonIxParNext: i32[] = []
// arena node -> 1 when it is some `Call`'s callee position
let anonIxCalleePos: i32[] = []
// name sid -> 1 when an `Ident` spells it OUTSIDE every callee position
let anonIxIdentValue: i32[] = []
// arena-ordered flats: every `Call` with an `Ident` callee; the subset whose callee name is
// not declared exactly once AND is bound somewhere, so only those can reach a function
// through a value; every binding WRITE; and every function-typed parameter slot.
let anonIxIdentCall: i32[] = []
let anonIxWildCall: i32[] = []
let anonIxWriteSite: i32[] = []
let anonIxFnParOwner: i32[] = []
let anonIxFnParPos: i32[] = []
// every `Call` whose callee is NOT a bare `Ident` — `anonLeafCalleeIsFnValue`'s population
let anonIxNonIdentCall: i32[] = []
// `anonLeafAnyIndirectCall`'s banked answer: -1 unknown, else 0/1
let anonIxIndirect = 0 - 1

// Link `node` onto the END of the `key`-keyed list `(head, tail)`, sharing the node pools.
// `sidArrPut` writes through the reference, so the caller's table grows here.
function anonLeafIxLink(head: i32[], tail: i32[], key: i32, node: i32) {
  if key < 0 { return 0 }
  const slot = anonIxLnkNode.length
  anonIxLnkNode.push(node)
  anonIxLnkNext.push(0 - 1)
  const t = sidArrGet(tail, key)
  if t < 0 { sidArrPut(head, key, slot) } else { anonIxLnkNext[t] = slot }
  sidArrPut(tail, key, slot)
  0
}

// The (owner, position) twin of `anonLeafIxLink`, on its own pool because a parameter slot
// is a pair: the declaring function and the position, which is what the two `…At` resolvers
// are asked in terms of.
function anonLeafIxLinkPar(key: i32, owner: i32, pos: i32) {
  if key < 0 { return 0 }
  const slot = anonIxParOwner.length
  anonIxParOwner.push(owner)
  anonIxParPos.push(pos)
  anonIxParNext.push(0 - 1)
  const t = sidArrGet(anonIxParTail, key)
  if t < 0 {
    sidArrPut(anonIxParHead, key, slot)
  } else {
    anonIxParNext[t] = slot
  }
  sidArrPut(anonIxParTail, key, slot)
  0
}

// D1514 — two passes: a forward walk, then a whole-arena classifying walk. A call is
// wild only when its callee name is not declared exactly once anywhere, and a name is a
// value only when some `Ident` spelling it lies outside every callee position — neither
// is decidable node-by-node, so this always rebuilds in full.
function anonLeafIxBuild() {
  anonIxLnkNode = []
  anonIxLnkNext = []
  anonIxDeclCnt = []
  anonIxDeclHead = []
  anonIxDeclTail = []
  anonIxBindHead = []
  anonIxBindTail = []
  anonIxCallHead = []
  anonIxCallTail = []
  anonIxBodyHead = []
  anonIxBodyTail = []
  anonIxParHead = []
  anonIxParTail = []
  anonIxParOwner = []
  anonIxParPos = []
  anonIxParNext = []
  anonIxCalleePos = []
  anonIxIdentValue = []
  anonIxIdentCall = []
  anonIxWildCall = []
  anonIxWriteSite = []
  anonIxFnParOwner = []
  anonIxFnParPos = []
  anonIxNonIdentCall = []
  anonIxIndirect = 0 - 1
  let i = 0
  while i < P.nodes.length {
    anonLeafIxRowFn(i)
    anonLeafIxRowParam(i)
    anonLeafIxRowLet(i)
    anonLeafIxRowAssign(i)
    anonLeafIxRowCall(i)
    i = i + 1
  }
  // `anonIxWildCall`: every call whose callee could reach a function through a value —
  // name not declared exactly once, and bound somewhere. `anonLeafCallMayTarget` refutes anything else.
  let k = 0
  while k < anonIxIdentCall.length {
    const cn = P.nodes[anonIxIdentCall[k]]
    if cn is Call {
      const csid = sidOfNode(unwrapParen(cn.callFn))
      if sidArrGet(anonIxDeclCnt, csid) != 1 {
        if sidArrGet(anonIxBindHead, csid) >= 0 {
          anonIxWildCall.push(anonIxIdentCall[k])
        }
      }
    }
    k = k + 1
  }
  let vi = 0
  while vi < P.nodes.length {
    const vn = P.nodes[vi]
    if vn is Ident {
      if sidArrGet(anonIxCalleePos, vi) != 1 {
        sidArrPut(anonIxIdentValue, sidOfNode(vi), 1)
      }
    }
    vi = vi + 1
  }
  anonIxSeen = P.nodes.length
  anonIxOn = true
  0
}

// Node `i`'s declaration rows: the name count, the declaration list, the body it owns, and
// its parameter slots. Split from the walk so each half asks about one node kind — the two
// questions are independent, and a node is never both (D1100's index took this shape).
function anonLeafIxRowFn(i: i32) {
  const n = P.nodes[i]
  if n is FuncDecl {
    const fsid = sidOfNode(i)
    const seen = sidArrGet(anonIxDeclCnt, fsid)
    if seen < 0 {
      sidArrPut(anonIxDeclCnt, fsid, 1)
    } else {
      sidArrPut(anonIxDeclCnt, fsid, seen + 1)
    }
    anonLeafIxLink(anonIxDeclHead, anonIxDeclTail, fsid, i)
    if n.fnBody >= 0 {
      anonLeafIxLink(anonIxBodyHead, anonIxBodyTail, n.fnBody, i)
    }
    let pj = 0
    while pj < n.fnParams.length {
      const px = n.fnParams[pj]
      const pn = P.nodes[px]
      if pn is Param {
        anonLeafIxLinkPar(sidOfNode(px), i, pj)
        // `anonLeafCloSlotMark`/`anonLeafCoMoveFnParamSlots` only want function-typed params;
        // recording a scalar one here would cost them the scan their own headers refuse.
        if pn.parType >= 0 && tyIsFuncType(pn.parType) {
          anonIxFnParOwner.push(i)
          anonIxFnParPos.push(pj)
        }
      }
      pj = pj + 1
    }
  }
  0
}

// Node `i`'s parameter row. Banked at the parameter's own index, not the declaration above,
// because the binding readers walk the arena in index order and a parameter's position among
// the writes of its name decides which of their arms fires first.
function anonLeafIxRowParam(i: i32) {
  const n = P.nodes[i]
  if n is Param {
    anonLeafIxLink(anonIxBindHead, anonIxBindTail, sidOfNode(i), i)
  }
  0
}

// Node `i`'s binding row: a `LetDecl` is both a name this binds and a write of it.
function anonLeafIxRowLet(i: i32) {
  const n = P.nodes[i]
  if n is LetDecl {
    anonLeafIxLink(anonIxBindHead, anonIxBindTail, sidOfNode(i), i)
    anonIxWriteSite.push(i)
  }
  0
}

// Node `i`'s assignment row — the `LetDecl` twin for `nm = e`, keyed on the identifier the
// left side names. An assignment to anything else writes no name this family can key.
function anonLeafIxRowAssign(i: i32) {
  const n = P.nodes[i]
  if n is BinExpr {
    if n.binOp == "=" {
      const tgt = unwrapParen(n.binLeft)
      if tgt >= 0 {
        const tn = P.nodes[tgt]
        if tn is Ident {
          anonLeafIxLink(anonIxBindHead, anonIxBindTail, sidOfNode(tgt), i)
          anonIxWriteSite.push(i)
        }
      }
    }
  }
  0
}

// Node `i`'s call rows: the callee position flag `anonLeafIsCalleePos` reads, and the call
// itself filed under the name its callee spells — or onto the non-`Ident` list, which is the
// population `anonLeafCalleeIsFnValue` is asked about.
function anonLeafIxRowCall(i: i32) {
  const n = P.nodes[i]
  if n is Call {
    const cf = unwrapParen(n.callFn)
    if cf < 0 {
      anonIxNonIdentCall.push(i)
    } else {
      sidArrPut(anonIxCalleePos, cf, 1)
      const cfn = P.nodes[cf]
      if cfn is Ident {
        anonIxIdentCall.push(i)
        anonLeafIxLink(anonIxCallHead, anonIxCallTail, sidOfNode(cf), i)
      } else {
        anonIxNonIdentCall.push(i)
      }
    }
  }
  0
}

// The index, valid for the arena as it stands. `collectAnonShapes` builds it before the first
// mark pass; this is what catches a caller reached with the arena grown under it.
function anonLeafIxEnsure() {
  if anonIxOn && anonIxSeen == P.nodes.length { return 0 }
  anonLeafIxBuild()
  0
}

// D1514 — how many `FuncDecl`s spell `nm`. One probe of the interner, then an array read.
function anonLeafIxDeclCount(nm: string): i32 {
  anonLeafIxEnsure()
  const c = sidArrGet(anonIxDeclCnt, sidLookup(nm))
  if c < 0 { return 0 }
  c
}

// D1514 — every `Call` `anonLeafCallMayTarget(…, fname)` would answer true for, in arena
// order: calls whose callee spells `fname` (only when declared exactly once) merged with
// the wild calls (only when `fname` can be delivered as a value). Order is load-bearing —
// `anonLeafCloSlotMark` takes the first member of the result.
function anonLeafIxCallsFor(fname: string, out: i32[]) {
  anonLeafIxEnsure()
  const sid = sidLookup(fname)
  let d = 0 - 1
  if sidArrGet(anonIxDeclCnt, sid) == 1 { d = sidArrGet(anonIxCallHead, sid) }
  let w = 0
  if sidArrGet(anonIxIdentValue, sid) != 1 { w = anonIxWildCall.length }
  while d >= 0 && w < anonIxWildCall.length {
    const dn = anonIxLnkNode[d]
    const wn = anonIxWildCall[w]
    if dn < wn {
      out.push(dn)
      d = anonIxLnkNext[d]
    } else {
      out.push(wn)
      w = w + 1
    }
  }
  while d >= 0 {
    out.push(anonIxLnkNode[d])
    d = anonIxLnkNext[d]
  }
  while w < anonIxWildCall.length {
    out.push(anonIxWildCall[w])
    w = w + 1
  }
  0
}

// Interns an object literal naming no declared struct or union variant as an unnamed struct,
// keyed by its field-name set and appended after every declared struct — so declared indices,
// and a program with no anonymous literal, stay unchanged. Must run after `collectU`; a field
// `anonFieldCode` cannot type leaves the shape un-interned, so that literal fails loudly later.
function collectAnonShapes() {
  // `nestOwner`: for every object literal that is another literal's field value, the owning
  // literal's node index; built only when the program declares a union variant.
  const nestOwner: i32[] = []
  if uVariants.length > 0 {
    while nestOwner.length < P.nodes.length { nestOwner.push(0 - 1) }
    let pi = 0
    while pi < P.nodes.length {
      const pn = P.nodes[pi]
      if pn is ObjLit {
        let pk = 0
        while pk < pn.objFields.length {
          const pf = P.nodes[pn.objFields[pk]]
          if pf is FieldInit {
            const pv = unwrapParen(pf.fiValue)
            if pv >= 0 && pv < nestOwner.length {
              const pvn = P.nodes[pv]
              if pvn is ObjLit { nestOwner[pv] = pi }
            }
          }
          pk = pk + 1
        }
      }
      pi = pi + 1
    }
  }
  // D391 — `anonNestPolyPremint` mints the polymorphic nested rows first, before any owner
  // row exists, so the owner scan below can tell the owners apart.
  anonNestPolyPremint(nestOwner)
  // D1514 — builds the resolver index the four mark passes below read; built after the
  // premint since nothing below appends a node, so one build serves all four.
  anonLeafIxBuild()
  // D833 — marks which literals a `??` joins into one value and which row each join already
  // claims, before the mint loop so the row column is a snapshot the loop's appends cannot move.
  anonLeafJoinedMark()
  // D924 — marks a family member's other destination; see `anonLeafNarrowUseMark`.
  anonLeafNarrowUseMark()
  // D940 — marks the closure-typed slot a moved function is delivered to; runs last because
  // it reads the ret/param marks the two passes above write (`anonLeafCloSlotMark`).
  anonLeafCloSlotMark()
  // D1090 — marks the closure-typed binding it is delivered to, the same signature one
  // holder over (`anonLeafCloBindMark`).
  anonLeafCloBindMark()
  let ai = 0
  while ai < P.nodes.length {
    const an = P.nodes[ai]
    if an is ObjLit {
      // D833 — a row narrower than this literal's `??` join does not skip the mint;
      // `anonLeafMergeField`, read before the mint appends a row, redirects onto the merged row.
      const narrowSi = structIndexOfObj(ai)
      const mf = anonLeafMergeField(ai, narrowSi)
      // D953 — the same question one layer down, for a literal that carries a family member in
      // a nested field rather than being one; without it the carrier's row names the narrow inner.
      const nmf = anonLeafNestedMergedField(ai)
      if (
        (narrowSi < 0 || mf != "" || nmf != "") &&
        (objVariantName(ai) == "" || anonNestNeedsRow(ai, nestOwner))
      ) {
        const rowsBefore = sNames.length
        anonMintRowFor(ai)
        if mf != "" || nmf != "" {
          anonLeafRecordSupersede(narrowSi, sNames.length - 1)
        }
        // D872 — the `??`'s left-operand carrier row: `narrowSi` when there is one row per field
        // set, else the other one — the row the binding cell and the callee's return resolve.
        if sNames.length > rowsBefore {
          if anonLeafMergedFieldOf(ai) != "" {
            anonLeafRecordSupersede(anonLeafCarrierRowOf(ai), sNames.length - 1)
          }
        }
      }
    }
    ai = ai + 1
  }
  0
}

// D924 — marks a family member's other destination: handing a merged-row value to a
// second callee whose parameter is annotated with the narrow shape would deliver
// `(ref $merged)` against a `(ref $narrow)` functype. Considers all members, and early-outs
// when there is no family at all — the walk below is a nested whole-arena scan.
function anonLeafNarrowUseMark() {
  let famAny = false
  let mi = 0
  while mi < anonLeafJoined.length {
    if anonLeafJoined[mi] == 1 { famAny = true }
    mi = mi + 1
  }
  if !famAny { return 0 }
  // Hoisted out of the declaration loop: the answer is a property of the program, and asking
  // it per function made the pass cubic.
  const indirect = anonLeafAnyIndirectCall()
  let fi = 0
  while fi < P.nodes.length {
    const fd = P.nodes[fi]
    if fd is FuncDecl {
      if fd.fnTyParams.length == 0 && fd.fnParams.length > 0 {
        if anonLeafOneDeclNamed(fd.fnName) {
          const pNames: string[] = []
          let pj = 0
          while pj < fd.fnParams.length {
            const pnj = P.nodes[fd.fnParams[pj]]
            if pnj is Param {
              pNames.push(pnj.parName)
            } else {
              pNames.push("")
            }
            pj = pj + 1
          }
          let anyValue = false
          let vi = 0
          while vi < P.nodes.length {
            const vn = P.nodes[vi]
            if vn is Ident {
              if vn.identName == fd.fnName {
                if !anonLeafIsCalleePos(vi) { anyValue = true }
              }
            }
            vi = vi + 1
          }
          let ok = true
          if anyValue {
            if indirect { ok = false }
          }
          if ok {
            let pk = 0
            while pk < fd.fnParams.length {
              // D935 — or a slot this can make all-members by enrolling the plain literals beside the
              // family ones (`anonLeafSlotEnrolMembers`).
              if (
                anonLeafSlotAllMembers(fd.fnName, pNames, pk) ||
                anonLeafSlotEnrolMembers(fd.fnName, pNames, pk)
              ) {
                while anonLeafParamMoved.length <= fd.fnParams[pk] {
                  anonLeafParamMoved.push(0)
                }
                anonLeafParamMoved[fd.fnParams[pk]] = 1
              }
              pk = pk + 1
            }
          }
        }
      }
    }
    fi = fi + 1
  }
  0
}

// D924 — is `nm` declared exactly once? `anonLeafParamArgsOk`'s `decls != 1` refutation,
// split out because the narrow-use pass asks it of a declaration rather than of a read.
function anonLeafOneDeclNamed(nm: string): boolean {
  anonLeafIxDeclCount(nm) == 1
}

// D924 — does every call site deliver a `??` family member at parameter position `pos`?
// `null` counts as delivered (`ref.null` is valid at every row) but not as the one real
// member the mark needs, so a slot every caller passes `null` to is not moved.
function anonLeafSlotAllMembers(
  fname: string,
  pNames: string[],
  pos: i32,
): boolean {
  let member = false
  // D1514 — the call sites this could answer for, rather than the whole arena.
  const cand: i32[] = []
  anonLeafIxCallsFor(fname, cand)
  let ci = 0
  while ci < cand.length {
    const cn = P.nodes[cand[ci]]
    if cn is Call {
      // D925 — through the binding hop too, so a call spelled `f(…)` over `const f = src` is
      // still the call site (`anonLeafCalleeFnName`).
      if anonLeafCallMayTarget(cn.callFn, fname) {
        const slots = orderArgsByParamNames(
          pNames,
          cn.callArgs,
          cn.callArgNames,
        )
        if slots.length != pNames.length { return false }
        if pos >= slots.length { return false }
        if slots[pos] < 0 { return false }
        const av = unwrapParen(slots[pos])
        if av < 0 { return false }
        const avn = P.nodes[av]
        if avn is NullLit { 0 }
        else if anonLeafDeliversMember(av) { member = true }
        else { return false }
      }
    }
    ci = ci + 1
  }
  member
}

// D935 — a slot that receives family members at some call sites and a plain object literal
// at others: declining (as `anonLeafSlotAllMembers` does) does not un-widen the other site, so
// the module ends up invalid wasm rather than refused. The literal instead joins the family at
// the members' row and annotation, but only when its field names match a member's exactly.
function anonLeafSlotEnrolMembers(
  fname: string,
  pNames: string[],
  pos: i32,
): boolean {
  const members: i32[] = []
  const plain: i32[] = []
  // D1514 — the call sites this could answer for, rather than the whole arena.
  const cand: i32[] = []
  anonLeafIxCallsFor(fname, cand)
  let ci = 0
  while ci < cand.length {
    const cn = P.nodes[cand[ci]]
    if cn is Call {
      if anonLeafCallMayTarget(cn.callFn, fname) {
        const slots = orderArgsByParamNames(
          pNames,
          cn.callArgs,
          cn.callArgNames,
        )
        if slots.length != pNames.length { return false }
        if pos >= slots.length { return false }
        if slots[pos] < 0 { return false }
        const av = unwrapParen(slots[pos])
        if av < 0 { return false }
        const avn = P.nodes[av]
        if avn is NullLit { 0 }
        else if anonLeafDeliversMember(av) { members.push(av) }
        else if avn is ObjLit { plain.push(av) }
        else if anonLeafIdentAllObjLits(av, plain) { 0 }
        else { return false }
      }
    }
    ci = ci + 1
  }
  if members.length == 0 { return false }
  if plain.length == 0 { return false }
  // The shape to match against is a member's own literal, through the binding hop when the
  // member is an identifier — the ordinary case, since call sites usually pass a name.
  let shape = 0 - 1
  let mi = 0
  while mi < members.length {
    if shape < 0 { shape = anonLeafMemberLit(members[mi]) }
    mi = mi + 1
  }
  if shape < 0 { return false }
  let pi = 0
  while pi < plain.length {
    if !anonLeafSameFieldNames(shape, plain[pi]) { return false }
    pi = pi + 1
  }
  // Every check has passed, so the writes happen together — a partial enrolment would leave
  // exactly the split this exists to close.
  let wi = 0
  while wi < plain.length {
    const w = plain[wi]
    if w >= 0 && w < anonLeafJoined.length {
      anonLeafJoined[w] = 1
      if anonLeafFamRow[w] < 0 { anonLeafFamRow[w] = anonLeafFamRowOf(shape) }
      if anonLeafAnnTy[w] < 0 { anonLeafAnnTy[w] = anonLeafAnnTyOf(shape) }
    }
    wi = wi + 1
  }
  true
}

// D935 — an identifier argument whose every write is a plain object literal: appends those
// literals to `plain` and answers true. A name with no write, or a write this cannot see,
// answers false — enrolling the literals it does name would move the slot's row while that
// unseen value keeps the old one.
function anonLeafIdentAllObjLits(av: i32, plain: i32[]): boolean {
  const avn = P.nodes[av]
  if avn is Ident {
    const lits: i32[] = []
    let li = 0
    while li < P.nodes.length {
      const lnn = P.nodes[li]
      let w = 0 - 1
      if lnn is LetDecl {
        if lnn.letName == avn.identName { w = unwrapParen(lnn.letInit) }
      }
      if lnn is BinExpr {
        if lnn.binOp == "=" {
          const tgt = unwrapParen(lnn.binLeft)
          if tgt >= 0 {
            const tn = P.nodes[tgt]
            if tn is Ident {
              if tn.identName == avn.identName { w = unwrapParen(lnn.binRight) }
            }
          }
        }
      }
      if w >= 0 {
        const wn = P.nodes[w]
        if wn is NullLit { 0 }
        else if wn is ObjLit { lits.push(w) }
        else { return false }
      }
      li = li + 1
    }
    if lits.length == 0 { return false }
    let ki = 0
    while ki < lits.length {
      plain.push(lits[ki])
      ki = ki + 1
    }
    return true
  }
  false
}

// D935 — the object literal a family member delivers: itself, or the one written to its
// name. `anonLeafDeliversMember` has already proved every write is a joined literal, so
// the first one found is representative.
function anonLeafMemberLit(av: i32): i32 {
  if av < 0 { return 0 - 1 }
  const avn = P.nodes[av]
  if avn is ObjLit { return av }
  if avn is Ident {
    let li = 0
    while li < P.nodes.length {
      const lnn = P.nodes[li]
      let w = 0 - 1
      if lnn is LetDecl {
        if lnn.letName == avn.identName { w = unwrapParen(lnn.letInit) }
      }
      if lnn is BinExpr {
        if lnn.binOp == "=" {
          const tgt = unwrapParen(lnn.binLeft)
          if tgt >= 0 {
            const tn = P.nodes[tgt]
            if tn is Ident {
              if tn.identName == avn.identName { w = unwrapParen(lnn.binRight) }
            }
          }
        }
      }
      if w >= 0 {
        const wn = P.nodes[w]
        if wn is ObjLit { return w }
      }
      li = li + 1
    }
  }
  0 - 1
}

// D935 — do two object literals name the same fields, in any order?
function anonLeafSameFieldNames(a: i32, b: i32): boolean {
  const an = P.nodes[a]
  const bn = P.nodes[b]
  if an is ObjLit {
    if bn is ObjLit {
      if an.objFields.length != bn.objFields.length { return false }
      let i = 0
      while i < an.objFields.length {
        const af = P.nodes[an.objFields[i]]
        if af is FieldInit {
          let found = false
          let j = 0
          while j < bn.objFields.length {
            const bf = P.nodes[bn.objFields[j]]
            if bf is FieldInit {
              if bf.fiName == af.fiName { found = true }
            }
            j = j + 1
          }
          if !found { return false }
        } else {
          return false
        }
        i = i + 1
      }
      return true
    }
  }
  false
}

// D924 — is the argument node `av` a family member, or a binding that only ever holds one?
// The question is the reverse of `anonLeafArgIdentOk`'s: there it asks which literals reach
// a slot, here whether every literal reaching it is already at the merged row. A binding with
// no write, or one write this cannot name, is not a member.
function anonLeafDeliversMember(av: i32): boolean {
  const avn = P.nodes[av]
  if avn is ObjLit { return anonLeafInJoin(av) }
  if avn is Ident {
    let hits = 0
    let li = 0
    while li < P.nodes.length {
      const lnn = P.nodes[li]
      let w = 0 - 1
      if lnn is LetDecl {
        if lnn.letName == avn.identName { w = unwrapParen(lnn.letInit) }
      }
      if lnn is BinExpr {
        if lnn.binOp == "=" {
          const tgt = unwrapParen(lnn.binLeft)
          if tgt >= 0 {
            const tn = P.nodes[tgt]
            if tn is Ident {
              if tn.identName == avn.identName { w = unwrapParen(lnn.binRight) }
            }
          }
        }
      }
      if w >= 0 {
        const wn = P.nodes[w]
        if wn is NullLit {
          0
        } else if wn is ObjLit {
          if !anonLeafInJoin(w) { return false }
          hits = hits + 1
        } else {
          return false
        }
      }
      li = li + 1
    }
    return hits > 0
  }
  false
}

// D833 — marks every object literal a `??` joins into one value, and records the row its
// join already claimed. Two left-operand readers: a map/list index over an identifier
// (the literals stored at `c[…] = { … }`) and a bare identifier (the literals bound to
// `a`); a left operand neither can read yields the default alone, and claims nothing.
function anonLeafJoinedMark() {
  while anonLeafJoined.length < P.nodes.length {
    anonLeafJoined.push(0)
    anonLeafFamRow.push(0 - 1)
    anonLeafAnnTy.push(0 - 1)
  }
  let qi = 0
  while qi < P.nodes.length {
    const qn = P.nodes[qi]
    if qn is BinExpr {
      if qn.binOp == "??" {
        const d = unwrapParen(qn.binRight)
        if d >= 0 {
          const dn = P.nodes[d]
          if dn is ObjLit {
            const mem: i32[] = []
            mem.push(d)
            anonLeafJoinSources(unwrapParen(qn.binLeft), mem)
            // The family's row is the one its members already matched, taken from the first member
            // that has one — a `??`'s operands are one value and cannot sit on two rows.
            let famRow = 0 - 1
            let mi = 0
            while mi < mem.length {
              if famRow < 0 { famRow = structIndexOfObj(mem[mi]) }
              mi = mi + 1
            }
            // D872 — the left operand's own declared type, the half of the family that is not a
            // literal. First `??` to claim a member wins, exactly as `famRow` does.
            const annTy = anonLeafJoinAnnTy(unwrapParen(qn.binLeft))
            let mj = 0
            while mj < mem.length {
              const m = mem[mj]
              if m >= 0 && m < anonLeafJoined.length {
                anonLeafJoined[m] = 1
                if anonLeafFamRow[m] < 0 { anonLeafFamRow[m] = famRow }
                if anonLeafAnnTy[m] < 0 { anonLeafAnnTy[m] = annTy }
              }
              mj = mj + 1
            }
          }
        }
      }
    }
    qi = qi + 1
  }
  0
}

// The object literals that reach a `??`'s left operand — the other half of the one value.
// Appended to `mem`; a reader this does not recognize appends nothing.
function anonLeafJoinSources(lhs: i32, mem: i32[]) {
  if lhs < 0 { return 0 }
  const ln = P.nodes[lhs]
  if ln is Index {
    const base = unwrapParen(ln.idxArr)
    if base >= 0 {
      const bn = P.nodes[base]
      if bn is Ident {
        let ai = 0
        while ai < P.nodes.length {
          const an = P.nodes[ai]
          if an is BinExpr {
            if an.binOp == "=" {
              anonLeafJoinStore(an.binLeft, an.binRight, bn.identName, mem)
            }
          }
          ai = ai + 1
        }
      }
    }
  }
  // D842 — a bare identifier left operand (`a ?? { … }`): the literals bound to `a` by name
  // over the whole program — a same-named binding elsewhere can only add a member, never hide one.
  // D871 — a call left operand (`src() ?? { … }`): the literals that reach the `??` are the
  // ones the callee returns, one delivery form further out than the index/ident arms above.
  if ln is Call { anonLeafJoinCallee(ln.callFn, mem) }
  if ln is Ident {
    let li = 0
    while li < P.nodes.length {
      const lnn = P.nodes[li]
      if lnn is LetDecl {
        if lnn.letName == ln.identName {
          anonLeafJoinBound(lnn.letInit, mem)
          // D871 — and where that initializer is a call, the callee's returns, one hop only: a
          // callee whose own return is another call is declined rather than half-read.
          anonLeafJoinInitCall(lnn.letInit, mem)
        }
      }
      if lnn is BinExpr {
        if lnn.binOp == "=" {
          const tgt = unwrapParen(lnn.binLeft)
          if tgt >= 0 {
            const tn = P.nodes[tgt]
            if tn is Ident {
              if tn.identName == ln.identName {
                anonLeafJoinBound(lnn.binRight, mem)
                // D871 — the same one-hop read as the declaration leg above; skipping it here would make
                // `a = src()` behave unlike `const a = src()` for what is the same binding question.
                anonLeafJoinInitCall(lnn.binRight, mem)
              }
            }
          }
        }
      }
      li = li + 1
    }
  }
  0
}

// D842 — appends `rhs` to `mem` when it is an object literal, deduped: the bare-identifier
// reader's twin of `anonLeafJoinStore`'s tail, split out because the binding scan above reads
// as one question.
function anonLeafJoinBound(rhs: i32, mem: i32[]) {
  const rv = unwrapParen(rhs)
  if rv < 0 { return 0 }
  const rn = P.nodes[rv]
  if rn is ObjLit {
    let i = 0
    while i < mem.length {
      if mem[i] == rv { return 0 }
      i = i + 1
    }
    mem.push(rv)
  }
  0
}

// D872 — the `??` left operand's own declared type, or -1: a bare identifier's `LetDecl`
// annotation, or a call's callee return type — but only when `anonLeafCalleeRead` finds the
// callee returns no literal itself (else the return is already a member and taking the
// annotation would misroute it). Refuses on disagreement among same-named declarations.
function anonLeafJoinAnnTy(lhs: i32): i32 {
  if lhs < 0 { return 0 - 1 }
  const ln = P.nodes[lhs]
  // Licensed by the read above having succeeded: every literal the callee hands back is
  // already a member, so taking the annotation here cannot misroute one.
  if ln is Call {
    const rlits: i32[] = []
    const rfns: string[] = []
    const rpars: i32[] = []
    if !anonLeafCalleeRead(ln.callFn, rlits, rfns, rpars, 0) { return 0 - 1 }
    if rlits.length > 0 { return 0 - 1 }
    const cf = unwrapParen(ln.callFn)
    if cf < 0 { return 0 - 1 }
    const cfn = P.nodes[cf]
    if cfn is Ident {
      let chit = 0 - 1
      let ci2 = 0
      while ci2 < P.nodes.length {
        const cd = P.nodes[ci2]
        if cd is FuncDecl {
          if cd.fnName == cfn.identName {
            if cd.fnRet < 0 { return 0 - 1 }
            if chit >= 0 {
              if tyNameOf(chit) != tyNameOf(cd.fnRet) { return 0 - 1 }
            } else {
              chit = cd.fnRet
            }
          }
        }
        ci2 = ci2 + 1
      }
      return chit
    }
    return 0 - 1
  }
  if ln is Ident {
    let hit = 0 - 1
    let li = 0
    while li < P.nodes.length {
      const lnn = P.nodes[li]
      if lnn is LetDecl {
        if lnn.letName == ln.identName {
          if lnn.letType < 0 { return 0 - 1 }
          if hit >= 0 {
            if tyNameOf(hit) != tyNameOf(lnn.letType) { return 0 - 1 }
          } else {
            hit = lnn.letType
          }
        }
      }
      li = li + 1
    }
    return hit
  }
  0 - 1
}

// D872 — the declared type node stamped on `n`'s `??` family, or -1; see `anonLeafAnnTy`.
function anonLeafAnnTyOf(n: i32): i32 {
  if n < 0 { return 0 - 1 }
  if n >= anonLeafAnnTy.length { return 0 - 1 }
  anonLeafAnnTy[n]
}

// D872 — the atom the `??` left operand's declared type spells at field `fname`, or "".
// Read off the spelling, not the row's field code: `{r: i32}` and `{r: boolean}` fields are
// both code 0 (`fieldCodeOfSpelling`), and a merged set built off the wrong one names a union
// the box cannot hold. Answers "" outside `anonLeafAtomName`'s six spellings.
function anonLeafAnnAtomOf(tyIx: i32, fname: string): string {
  if tyIx < 0 { return "" }
  const arms: string[] = []
  splitUnionAtoms(tyNameOf(tyIx), arms)
  let shape = ""
  let k = 0
  while k < arms.length {
    if arms[k] != "null" {
      // More than one non-null arm: the operand's non-null value is not one shape.
      if shape != "" { return "" }
      shape = arms[k]
    }
    k = k + 1
  }
  // D922 — a declared name (`type R = {r: i32}`) is the same shape written down once, so its
  // fields come off the declaration's `FieldDef` nodes rather than off a spelling to split.
  if !nameIsShapeSpanEnds(shape) { return anonLeafDeclFieldAtom(shape, fname) }
  const fnames: string[] = []
  const ftexts: string[] = []
  shapeInnerFieldSplit(groupInnerOf(shape), fnames, ftexts)
  let i = 0
  while i < fnames.length {
    if fnames[i] == fname { return anonLeafAtomOfText(ftexts[i]) }
    i = i + 1
  }
  ""
}

// D922 — the atom a declared struct type spells at field `fname`, or "". Refuses on
// disagreement rather than taking the first: two declarations of one name give the operand
// no single declared type. A generic declaration's `tdName` carries the parameter span, so
// the plain-name compare never matches one.
function anonLeafDeclFieldAtom(shape: string, fname: string): string {
  if shape == "" { return "" }
  let hit = ""
  let seen = false
  let i = 0
  while i < P.nodes.length {
    const s = P.nodes[i]
    if s is TypeDecl {
      if s.tdName == shape {
        if seen { return "" }
        seen = true
        let fi = 0
        while fi < s.tdFields.length {
          if s.tdFields[fi] >= 0 {
            const fd = P.nodes[s.tdFields[fi]]
            if fd is FieldDef {
              if fd.fdName == fname {
                hit = anonLeafAtomOfText(tyNameOf(fd.fdType))
              }
            }
          }
          fi = fi + 1
        }
      }
    }
    i = i + 1
  }
  hit
}

// A width rank for `typecheck.numWidensName`'s lattice, gating whether an annotation atom
// (describing a value that is absent) may join a set of value atoms (values that will be
// built): only when the annotation is no wider, since a wider annotation folds to a type
// no built value has and mints a doomed cast-failure box. -1 for a non-numeric atom.
function anonLeafAtomWidth(atom: string): i32 {
  if atom == "i32" { return 0 }
  if atom == "i64" { return 1 }
  if atom == "f32" { return 1 }
  if atom == "f64" { return 2 }
  0 - 1
}

function anonLeafAnnAtomJoins(annAtom: string, atoms: string[]): boolean {
  const aw = anonLeafAtomWidth(annAtom)
  if aw < 0 { return true }
  let best = 0 - 1
  let i = 0
  while i < atoms.length {
    const w = anonLeafAtomWidth(atoms[i])
    if w > best { best = w }
    i = i + 1
  }
  if best < 0 { return true }
  aw <= best
}

// D884 — may `atom` join the atoms already in the set? The six scalars always may; a
// literal-union alias may join only `null`, since `K | null` is the one niche
// `nameFieldCode` spells for the declared twin and `K | string | null` has no code — a set
// the mint cannot code falls back to `anonFieldCode`'s answer rather than merely declining.
function anonLeafAtomAdmits(atom: string, atoms: string[]): boolean {
  if !nameIsLitUnionType(atom) { return true }
  let i = 0
  while i < atoms.length {
    if atoms[i] != "null" { return false }
    i = i + 1
  }
  true
}

// The atom NAME a field's annotation TEXT spells, or "" for everything else — the type-side
// twin of `anonLeafAtomName`, and deliberately the same six atoms and no more.
function anonLeafAtomOfText(t: string): string {
  if t == "i32" { return "i32" }
  if t == "boolean" { return "boolean" }
  if t == "string" { return "string" }
  if t == "f64" { return "f64" }
  if t == "i64" { return "i64" }
  if t == "f32" { return "f32" }
  // D884 — a literal-union alias (`type K = "a" | "b"`) is the seventh atom, not a valtype
  // like the six: it names a registered type whose rep is the interned i32 atom.
  if nameIsLitUnionType(t) { return t }
  ""
}

// D873 — the row `n`'s `??` left operand's own carrier resolves to, or -1. Not always
// `structIndexOfObj`'s answer: with a second same-fieldset row (a nested-struct field's
// inline shape beside a declared `type R`) the literals land on one and the annotation on
// the other, so the supersede has to be recorded against both.
function anonLeafCarrierRowOf(n: i32): i32 {
  retNulRefIndex(anonLeafAnnTyOf(n))
}

// D871 — `rhs` is a binding's initializer: when it is a call, the callee's returned literals.
// Split from `anonLeafJoinBound` rather than folded into it so the recursion cannot chain — a
// returned value is read as a literal or not at all, never followed through a second call.
function anonLeafJoinInitCall(rhs: i32, mem: i32[]) {
  const rv = unwrapParen(rhs)
  if rv < 0 { return 0 }
  const rn = P.nodes[rv]
  if rn is Call { return anonLeafJoinCallee(rn.callFn, mem) }
  0
}

// D871 — the object literals a callee returns, appended to `mem`, or nothing when any return
// path is one this cannot name — refuted as a whole, since the merged row also redirects the
// callee's return row and a value this missed would build at the narrow row but return at the
// merged one. Found by name over the whole arena: `fnStmts` is not populated yet.
function anonLeafJoinCallee(callFn: i32, mem: i32[]) {
  // D882 — reads into a scratch pair and commits only on success: a nested success followed
  // by an outer refutation must not leave literals in `mem` with no row moved to match.
  const lits: i32[] = []
  const fns: string[] = []
  // D891 — the third half of the scratch: a returned parameter marks its own slot as an
  // owner of the merged row, and must not publish under an outer refutation either.
  const pars: i32[] = []
  if !anonLeafCalleeRead(callFn, lits, fns, pars, 0) { return 0 }
  let ri = 0
  while ri < lits.length {
    anonLeafJoinBound(lits[ri], mem)
    ri = ri + 1
  }
  // D871 — marks the callees so the four return-row resolvers redirect exactly the functions
  // whose literals this just made family members (`anonLeafRetMoved`).
  let fj = 0
  while fj < fns.length {
    anonLeafMarkRetMoved(fns[fj])
    fj = fj + 1
  }
  // D891 — marks the parameters whose slot the merge moves (`anonLeafParamMoved`).
  let pj = 0
  while pj < pars.length {
    while anonLeafParamMoved.length <= pars[pj] { anonLeafParamMoved.push(0) }
    anonLeafParamMoved[pars[pj]] = 1
    pj = pj + 1
  }
  0
}

// One frame of the callee read: the literals `callFn`'s callee hands back, appended to
// `lits`, with every function name whose return row must follow appended to `fns` — false,
// and nothing published, the moment one return path is unnameable. `fns` doubles as the
// visited set, so a self-call already on the path answers rather than recursing forever.
function anonLeafCalleeRead(
  callFn: i32,
  lits: i32[],
  fns: string[],
  pars: i32[],
  depth: i32,
): boolean {
  if depth < 0 { return false }
  const c = unwrapParen(callFn)
  if c < 0 { return false }
  const cn = P.nodes[c]
  if cn is Ident {
    let k = 0
    while k < fns.length {
      if fns[k] == cn.identName { return true }
      k = k + 1
    }
    fns.push(cn.identName)
    let seen = false
    let fi = 0
    while fi < P.nodes.length {
      const fd = P.nodes[fi]
      if fd is FuncDecl {
        if fd.fnName == cn.identName {
          seen = true
          if (
            !anonLeafCalleeRets(
              fd.fnBody,
              lits,
              true,
              fd.fnBody,
              fns,
              pars,
              depth,
            )
          ) {
            return false
          }
        }
      }
      fi = fi + 1
    }
    return seen
  }
  false
}

// D926 — carries a `??` owner mark onto a monomorphized clone's node. Both marks are
// arena-node keyed, `collectAnonShapes` runs before `monomorphize` mints the clone, and every
// reader resolves through the post-mono declaration — so a clone needs its own copy. Needs no
// guard: `anonLeafSupersedeOf` is a bounds-checked identity outside the family.
export function anonLeafCarryParamMark(origIx: i32, newIx: i32) {
  if origIx < 0 || newIx < 0 { return 0 }
  if origIx >= anonLeafParamMoved.length { return 0 }
  if anonLeafParamMoved[origIx] != 1 { return 0 }
  while anonLeafParamMoved.length <= newIx { anonLeafParamMoved.push(0) }
  anonLeafParamMoved[newIx] = 1
  0
}

// D926 — the return-row twin. See `anonLeafCarryParamMark`.
export function anonLeafCarryRetMark(origIx: i32, newIx: i32) {
  if origIx < 0 || newIx < 0 { return 0 }
  if origIx >= anonLeafRetMoved.length { return 0 }
  if anonLeafRetMoved[origIx] != 1 { return 0 }
  while anonLeafRetMoved.length <= newIx { anonLeafRetMoved.push(0) }
  anonLeafRetMoved[newIx] = 1
  0
}

// D871 — every `FuncDecl` named `nm` has its return row follow the merge. Split out of
// `anonLeafJoinCallee` because a nested read names more than one function.
function anonLeafMarkRetMoved(nm: string) {
  anonLeafIxEnsure()
  let already = false
  // D1514 — the declarations of this name, in arena order, rather than every node.
  let dl = sidArrGet(anonIxDeclHead, sidLookup(nm))
  while dl >= 0 {
    const mi = anonIxLnkNode[dl]
    while anonLeafRetMoved.length <= mi { anonLeafRetMoved.push(0) }
    if anonLeafRetMoved[mi] == 1 { already = true }
    anonLeafRetMoved[mi] = 1
    dl = anonIxLnkNext[dl]
  }
  // D948 — and every function this one shares a binding with, since one binding holds one
  // wasm signature. Guarded on `already`, which bounds the mutual recursion between co-moves.
  if !already {
    anonLeafCoMoveFnRets(nm)
    // D1090 — and every function sharing a closure-typed parameter slot, same reason, under
    // the same `already` guard.
    anonLeafCoMoveFnParamSlots(nm)
  }
  0
}

// Every value a function body hands back: each `return e` and the body block's implicit
// tail expression. False the moment one is a path `anonLeafRetPathOk` cannot name; a nested
// function declaration is skipped. `body` is the frame's own body block, carried unchanged
// through the recursion so the returned-binding arm resolves against the right bindings (D882).
function anonLeafCalleeRets(
  ix: i32,
  out: i32[],
  tail: boolean,
  body: i32,
  fns: string[],
  pars: i32[],
  depth: i32,
): boolean {
  if ix < 0 { return true }
  const n = P.nodes[ix]
  if n is FuncDecl { return true }
  if n is RetStmt {
    if !anonLeafRetPathOk(n.retArg, out, body, fns, pars, depth) {
      return false
    }
  }
  if n is Block {
    if tail {
      if n.blkStmts.length > 0 {
        if (
          !anonLeafTailPathOk(
            n.blkStmts[n.blkStmts.length - 1],
            out,
            body,
            fns,
            pars,
            depth,
          )
        ) {
          return false
        }
      }
    }
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if !anonLeafCalleeRets(kids[i], out, false, body, fns, pars, depth) {
      return false
    }
    i = i + 1
  }
  true
}

// One returned expression. An object literal is a member; a `null` (or bare `return`) is
// not a member and not a refutation (`ref.null` is valid at every row); everything else
// refutes. A returned binding resolves against this function's own bindings only (D882); a
// returned call is one more frame of the same read, carrying the visited set.
function anonLeafRetPathOk(
  argIx: i32,
  out: i32[],
  body: i32,
  fns: string[],
  pars: i32[],
  depth: i32,
): boolean {
  if argIx < 0 { return true }
  const a = unwrapParen(argIx)
  if a < 0 { return true }
  const an = P.nodes[a]
  if an is NullLit { return true }
  if an is ObjLit {
    out.push(a)
    return true
  }
  if an is Ident {
    // D911 — a name-visited set minted here, since an ident chain (`a = b; b = a`) is a cycle
    // the call-frame depth cap cannot bound.
    const ids: string[] = []
    return anonLeafRetIdentOk(an.identName, body, out, fns, pars, depth, ids)
  }
  if an is Call {
    return anonLeafCalleeRead(an.callFn, out, fns, pars, depth + 1)
  }
  false
}

// D882 — the literals bound to `nm` inside the frame that returned it, or a refutation.
// Asked of one function body (the scope a returned name resolves in), and strict where
// `anonLeafJoinSources` is lenient: an unmoved store behind a moved return row is invalid
// wasm. A name with no binding here is a parameter, capture, or global, so an empty scan refutes.
function anonLeafRetIdentOk(
  nm: string,
  body: i32,
  out: i32[],
  fns: string[],
  pars: i32[],
  depth: i32,
  ids: string[],
): boolean {
  let vi2 = 0
  while vi2 < ids.length {
    if ids[vi2] == nm { return true }
    vi2 = vi2 + 1
  }
  ids.push(nm)
  const hits: i32[] = []
  if !anonLeafBindScan(body, nm, body, out, hits, fns, pars, depth, ids) {
    return false
  }
  // D891 — and a parameter, whose sources are the arguments at every call site, asked beside
  // the binding scan (a body can both assign and return a param) and authoritative where it answers.
  const pp = anonLeafParamNodeOf(body, nm)
  if pp >= 0 { return anonLeafParamArgsOk(body, pp, out, fns, pars, depth) }
  hits.length > 0
}

// D891 — the `Param` node named `nm` of the function whose body block is `body`, or -1.
// `body` is the callee frame's own `fnBody`, carried unchanged through the read, so the
// owning `FuncDecl` is the one node whose `fnBody` is exactly it — unique because a nested
// declaration's body is a different block that `anonLeafCalleeRets` never descends into.
function anonLeafParamNodeOf(body: i32, nm: string): i32 {
  if body < 0 { return 0 - 1 }
  anonLeafIxEnsure()
  // D1514 — the declaration owning this body; the first is the whole answer, exactly as the
  // scan's own `return 0 - 1` made it.
  const bl = sidArrGet(anonIxBodyHead, body)
  if bl < 0 { return 0 - 1 }
  const fd = P.nodes[anonIxLnkNode[bl]]
  if fd is FuncDecl {
    let pi = 0
    while pi < fd.fnParams.length {
      const pn = P.nodes[fd.fnParams[pi]]
      if pn is Param {
        if pn.parName == nm { return fd.fnParams[pi] }
      }
      pi = pi + 1
    }
  }
  0 - 1
}

// D891 — a returned parameter: the literals that reach it are the arguments at every call
// site, and marking the param's slot as an owner of the merged row is the other half. Every
// call site has to be visible, so this refutes on a generic callee, two functions of one
// name, the name used as a value, a named argument, a non-literal/non-null argument, or none.
function anonLeafParamArgsOk(
  body: i32,
  pIx: i32,
  out: i32[],
  fns: string[],
  pars: i32[],
  depth: i32,
): boolean {
  // The owning declaration, its name, and this param's position — one scan, because a second
  // declaration of the same name makes the position meaningless.
  let fname = ""
  let pos = 0 - 1
  // D911 — and its parameter names, so a call site's arguments bind to slots the way the
  // emitter binds them (`orderArgsByParamNames`) rather than by source position.
  const pNames: string[] = []
  anonLeafIxEnsure()
  // D1514 — the declarations owning this body, in arena order, rather than every node.
  let bl = sidArrGet(anonIxBodyHead, body)
  while bl >= 0 {
    const fd = P.nodes[anonIxLnkNode[bl]]
    if fd is FuncDecl {
      // D926 — the mark this loop banks is carried to a monomorphized clone rather than
      // recomputed, so a generic callee needs no refusal here (`anonLeafCarryParamMark`).
      fname = fd.fnName
      let pj = 0
      while pj < fd.fnParams.length {
        if fd.fnParams[pj] == pIx { pos = pj }
        const pnj = P.nodes[fd.fnParams[pj]]
        if pnj is Param { pNames.push(pnj.parName) } else { pNames.push("") }
        pj = pj + 1
      }
    }
    bl = anonIxLnkNext[bl]
  }
  if fname == "" { return false }
  if pos < 0 { return false }
  if anonLeafIxDeclCount(fname) != 1 { return false }
  // The param's own DEFAULT, on the three-way split.
  const pn = P.nodes[pIx]
  if pn is Param {
    if pn.parDefault >= 0 {
      const dv = unwrapParen(pn.parDefault)
      if dv < 0 { return false }
      const dn = P.nodes[dv]
      if dn is ObjLit { out.push(dv) }
      else if dn is NullLit { 0 }
      else { return false }
    }
  }
  // A name used as a value only refutes when the program can actually call through one — a
  // bound-but-uninvoked value (`const f = src`) passes no argument anywhere and is safe.
  // D1514 — the same predicate, banked: `anonLeafNameUsedAsValue` IS this loop.
  const anyValue = anonLeafNameUsedAsValue(fname)
  if anyValue {
    if anonLeafAnyIndirectCall() { return false }
  }
  // D911 — the parameter's own name, for the self-pass arm below; read once since the `Param`
  // arm above already proved the node is one.
  let pName = ""
  const pnn = P.nodes[pIx]
  if pnn is Param { pName = pnn.parName }
  // Every call site's argument at this position.
  let seen = false
  // D1514 — the call sites this could answer for, rather than the whole arena.
  const cand: i32[] = []
  anonLeafIxCallsFor(fname, cand)
  let ci = 0
  while ci < cand.length {
    const cn = P.nodes[cand[ci]]
    if cn is Call {
      // D925 — through the binding hop too, so a call spelled `f(…)` over `const f = src` is
      // still the call site (`anonLeafCalleeFnName`).
      if anonLeafCallMayTarget(cn.callFn, fname) {
        // D911 — bound by name then positionally, the same binder the checker and emitter share;
        // a leftover (unknown name, collision, surplus) means the checker did not accept this arity.
        const slots = orderArgsByParamNames(
          pNames,
          cn.callArgs,
          cn.callArgNames,
        )
        if slots.length != pNames.length { return false }
        if pos >= slots.length { return false }
        if slots[pos] < 0 { return false }
        const av = unwrapParen(slots[pos])
        if av < 0 { return false }
        const avn = P.nodes[av]
        if avn is ObjLit {
          out.push(av)
          seen = true
        } else if avn is NullLit {
          seen = true
        } else if avn is Call {
          // D911 — a nested argument is one more frame of the callee read: `src(mk())` hands the
          // parameter whatever `mk` returns, so `mk`'s return row must be marked too.
          if !anonLeafCalleeRead(avn.callFn, out, fns, pars, depth + 1) {
            return false
          }
          seen = true
        } else if avn is Ident {
          // An identifier argument: a self-passed parameter is skipped, not refused, unless the
          // frame rebinds the name (which refutes); otherwise the ident reader at the call site decides.
          if (
            pName != "" &&
            avn.identName == pName &&
            anonLeafInFrame(body, av) &&
            !anonLeafFrameRebinds(body, pName)
          ) {
            0
          } else if (anonLeafArgIdentOk(avn.identName, out, fns, pars, depth)) {
            seen = true
          } else {
            return false
          }
        } else {
          return false
        }
      }
    }
    ci = ci + 1
  }
  if !seen { return false }
  pars.push(pIx)
  true
}

// D911 — is `target` inside the frame rooted at `root`, without crossing a nested `FuncDecl`?
// The containment test the self-pass arm needs: an argument spelling the parameter's name is
// only the parameter itself when the call that passes it is in the parameter's own body.
function anonLeafInFrame(root: i32, target: i32): boolean {
  if root < 0 { return false }
  if root == target { return true }
  const n = P.nodes[root]
  if n is FuncDecl { return false }
  const kids = nodeChildren(root)
  let i = 0
  while i < kids.length {
    if anonLeafInFrame(kids[i], target) { return true }
    i = i + 1
  }
  false
}

// D911 — does the frame rebind `nm`? Every binder the frame can introduce, nested `FuncDecl`s
// excluded (their bindings are their own, and `anonLeafInFrame` already refuses to reach into
// one). A `match` arm's payload binding is a minted `LetDecl`, so the first arm covers it.
function anonLeafFrameRebinds(root: i32, nm: string): boolean {
  if root < 0 { return false }
  const n = P.nodes[root]
  if n is FuncDecl { return false }
  if n is LetDecl {
    if n.letName == nm { return true }
  }
  if n is ForRange {
    if n.frVar == nm { return true }
  }
  if n is ForIn {
    if n.fiVar == nm { return true }
  }
  const kids = nodeChildren(root)
  let i = 0
  while i < kids.length {
    if anonLeafFrameRebinds(kids[i], nm) { return true }
    i = i + 1
  }
  false
}

// D911 — the literals bound to an argument identifier, or a refutation. Unlike a returned
// name (resolved in the frame that returned it), an argument's name resolves in the caller's
// frame — module scope included — so this reads by name over the whole program, strict where
// `anonLeafJoinSources` is lenient. `body` is the binding site's own frame, not this scan's.
function anonLeafArgIdentOk(
  nm: string,
  out: i32[],
  fns: string[],
  pars: i32[],
  depth: i32,
): boolean {
  const ids: string[] = []
  anonLeafArgIdentSeen(nm, out, fns, pars, depth, ids)
}

// D934 — the same scan, carrying the name-visited set so a module-scope chain can re-enter
// it: `const a = b` / `const b = a` at module scope is a cycle the call-frame depth cap does
// not bound, so the visited set must be shared across the recursion rather than minted fresh
// per call.
function anonLeafArgIdentSeen(
  nm: string,
  out: i32[],
  fns: string[],
  pars: i32[],
  depth: i32,
  ids: string[],
): boolean {
  let vi = 0
  while vi < ids.length {
    if ids[vi] == nm { return true }
    vi = vi + 1
  }
  ids.push(nm)
  const hits: i32[] = []
  let li = 0
  while li < P.nodes.length {
    const lnn = P.nodes[li]
    if lnn is LetDecl {
      if lnn.letName == nm {
        if (
          !anonLeafBoundValOk(
            lnn.letInit,
            anonLeafFrameBodyOf(li),
            out,
            hits,
            fns,
            pars,
            depth,
            ids,
          )
        ) {
          return false
        }
      }
    }
    if lnn is BinExpr {
      if lnn.binOp == "=" {
        const tgt = unwrapParen(lnn.binLeft)
        if tgt >= 0 {
          const tn = P.nodes[tgt]
          if tn is Ident {
            if tn.identName == nm {
              if (
                !anonLeafBoundValOk(
                  lnn.binRight,
                  anonLeafFrameBodyOf(li),
                  out,
                  hits,
                  fns,
                  pars,
                  depth,
                  ids,
                )
              ) {
                return false
              }
            }
          }
        }
      }
    }
    li = li + 1
  }
  hits.length > 0
}

// D921 — the body block of the innermost `FuncDecl` containing `n`, or -1 at module scope.
// `anonLeafInFrame` stops at a nested declaration, so the frames it tests partition the
// arena, and the first `FuncDecl` whose body contains `n` is the innermost one.
function anonLeafFrameBodyOf(n: i32): i32 {
  if n < 0 { return 0 - 1 }
  let i = 0
  while i < P.nodes.length {
    const fd = P.nodes[i]
    if fd is FuncDecl {
      if anonLeafInFrame(fd.fnBody, n) { return fd.fnBody }
    }
    i = i + 1
  }
  0 - 1
}

// D911 — could any call in this program go through a function value? Over-approximates on
// purpose: a callee that is not a bare identifier counts, so does an identifier any `LetDecl`
// or `Param` declares anywhere, but a call through a binding this can resolve (`const f =
// src; f(…)`) is not one of them — a name bound to anything else still counts.
function anonLeafAnyIndirectCall(): boolean {
  anonLeafIxEnsure()
  if anonIxIndirect >= 0 { return anonIxIndirect == 1 }
  const ans = anonLeafAnyIndirectCallGo()
  // D1514 — banked only from a quiet stack: the three resolvers under this re-enter
  // themselves, so a value computed inside one of their busy windows is not the module's answer.
  if anonLeafResolverQuiet() {
    if ans { anonIxIndirect = 1 } else { anonIxIndirect = 0 }
  }
  ans
}

function anonLeafAnyIndirectCallGo(): boolean {
  // D1514 — a callee that is not a bare `Ident` needs `anonLeafCalleeIsFnValue`, and the
  // index carries which calls those are; every other call is in `anonIxIdentCall`.
  let ni = 0
  while ni < anonIxNonIdentCall.length {
    const nn = P.nodes[anonIxNonIdentCall[ni]]
    if nn is Call {
      const cf = unwrapParen(nn.callFn)
      if cf < 0 { return true }
      if anonLeafCalleeIsFnValue(cf) { return true }
    }
    ni = ni + 1
  }
  let ci = 0
  while ci < anonIxIdentCall.length {
    const cn = P.nodes[anonIxIdentCall[ci]]
    if cn is Call {
      const cfn = P.nodes[unwrapParen(cn.callFn)]
      if cfn is Ident {
        if anonLeafNameIsBound(cfn.identName) {
          if anonLeafCalleeFnName(cn.callFn) == "" {
            // D948 — a binding whose every write is a known function is attributable even when it
            // names more than one; `anonLeafCallMayTarget` reads it for each.
            const kn: string[] = []
            if !anonLeafFnValueNames(cfn.identName, kn) { return true }
          }
        }
      }
    }
    ci = ci + 1
  }
  false
}

// D1401 — is this non-ident callee a function value, or an ordinary method? A positive
// allow-list, never a subtraction: only a receiver whose recorded type carries a built-in
// method surface is admitted. A struct receiver, an untyped one, and every non-`Member`
// callee keep the veto — the safe direction, since the fall-through is not neutral.
function anonLeafCalleeIsFnValue(cf: i32): boolean {
  const cn = P.nodes[cf]
  if cn is Member {
    const ot = nodeTyIxOf(cn.memObj)
    if ot < 0 { return true }
    if anonLeafBuiltinMethodRecv(ot) { return false }
  }
  // D1100 — a container delivery this pass can name (struct field, array element, returned
  // value) is not unattributable either; anything the resolver cannot name keeps the veto.
  anonLeafDeliveredFnName(cf) == ""
}

// D1100 — the function a container delivers to callee `cf`, by name, or "" — by name and
// off the declaration index, since `fnStmts` is not populated when `collectAnonShapes` runs.
// The three arms each have an emit-side twin that must agree: a struct field
// (`fieldClosureFeOfRecv`), an array element (`anonLeafArrElemFe`), a call's return (`anonLeafRetCallFe`).
function anonLeafDeliveredFnName(cf: i32): string {
  const cn = P.nodes[cf]
  if cn is Member { return anonLeafFieldFnNameOf(cn.memObj, cn.memProp) }
  if cn is Index { return anonLeafElemFnNameOf(cn.idxArr) }
  anonLeafRetFnNameOf(cf)
}

// The one function every binding of the receiver could deliver at `prop`. Two frames each
// declaring `const o = { f: src }` is ordinary code and a module-wide name key cannot scope
// them, so the answer must agree across every candidate rather than be refused the moment
// there are two — the emit side resolves the scoped one, which is always one of them.
function anonLeafFieldFnNameOf(recvIx: i32, prop: string): string {
  const lits: i32[] = []
  anonLeafContainerLits(recvIx, 0, lits)
  // `xs[i].f(…)` — the receiver is an index into the array of literals, so the array itself
  // is the container and every element must agree at the field.
  const rn = P.nodes[unwrapParen(recvIx)]
  if rn is Index { anonLeafContainerLits(rn.idxArr, 0, lits) }
  let nm = ""
  let i = 0
  while i < lits.length {
    const en = anonLeafLitFieldFnName(lits[i], prop)
    if en == "" { return "" }
    if nm == "" { nm = en }
    if nm != en { return "" }
    i = i + 1
  }
  nm
}

// One candidate literal's answer at `prop`: an object literal's own field.
function anonLeafLitFieldFnName(lit: i32, prop: string): string {
  const l = P.nodes[lit]
  if l is ObjLit { return anonLeafFnNameOfVal(objFieldVal(lit, prop)) }
  anonLeafArrFieldFnName(lit, prop)
}

// …and an array of objects', which is `anonLeafLitFieldFnName`'s default: every element must
// hold the same function at the field, for the reason `anonLeafSameFieldFnName` states.
function anonLeafArrFieldFnName(lit: i32, prop: string): string {
  const l = P.nodes[lit]
  if l is ArrayLit { return anonLeafSameFieldFnName(l.arrElems, prop) }
  ""
}

// The one function every element of `els` holds at field `prop`, or "" — a container slot is
// one wasm signature, so two different functions in it agree only by accident.
function anonLeafSameFieldFnName(els: i32[], prop: string): string {
  let nm = ""
  let i = 0
  while i < els.length {
    const ei = unwrapParen(els[i])
    const e = P.nodes[ei]
    if !(e is ObjLit) { return "" }
    const en = anonLeafFnNameOfVal(objFieldVal(ei, prop))
    if en == "" { return "" }
    if nm == "" { nm = en }
    if nm != en { return "" }
    i = i + 1
  }
  nm
}

// The one function every element of every candidate array is, or "".
function anonLeafElemFnNameOf(arrIx: i32): string {
  const lits: i32[] = []
  anonLeafContainerLits(arrIx, 0, lits)
  let nm = ""
  let i = 0
  while i < lits.length {
    const en = anonLeafLitElemFnName(lits[i])
    if en == "" { return "" }
    if nm == "" { nm = en }
    if nm != en { return "" }
    i = i + 1
  }
  nm
}

// One candidate literal's answer: every element of an array is the same named function.
function anonLeafLitElemFnName(lit: i32): string {
  const l = P.nodes[lit]
  if l is ArrayLit {
    const els = l.arrElems
    let nm = ""
    let i = 0
    while i < els.length {
      const en = anonLeafFnNameOfVal(unwrapParen(els[i]))
      if en == "" { return "" }
      if nm == "" { nm = en }
      if nm != en { return "" }
      i = i + 1
    }
    return nm
  }
  ""
}

// The function the callee of `cf` hands back — one hop, through a named declaration's single
// return expression (`pick()(…)`). "" for every other callee kind, which is also this
// ladder's default: a bare `Ident` callee is answered by the arm above this one's caller,
// and nothing else carries a delivery this pass can follow.
function anonLeafRetFnNameOf(cf: i32): string {
  const cn = P.nodes[cf]
  if cn is Call {
    const inner = P.nodes[unwrapParen(cn.callFn)]
    if inner is Ident {
      const fd = anonLeafDeclFnNodeOf(inner.identName)
      if fd >= 0 {
        const rx = fnRetExprOf(fd)
        if rx >= 0 { return anonLeafFnNameOfVal(unwrapParen(rx)) }
      }
    }
  }
  ""
}

// Every literal a container expression could be: itself, or — one binding hop at a time,
// under a depth cap — the initializer of every binding that spells its name. The recursion
// is this ladder's default: a name whose initializer is another name is the same question one
// hop in.
function anonLeafContainerLits(ix0: i32, depth: i32, out: i32[]) {
  if depth > 3 { return 0 }
  // Before `unwrapParen`: the recursion feeds it a binding's -1 initializer, and
  // `unwrapParen(-1)` reads `P.nodes[-1]` — a compiler trap, not a refusal (D1152).
  if ix0 < 0 { return 0 }
  const ix = unwrapParen(ix0)
  if ix < 0 { return 0 }
  const e = P.nodes[ix]
  if e is ObjLit {
    out.push(ix)
    return 0
  }
  if e is ArrayLit {
    out.push(ix)
    return 0
  }
  anonLeafBindingLits(ix, depth, out)
}

// The binding hop: every initializer recorded for the name this `Ident` spells. Not "the one
// binding" — see `anonLeafFieldFnNameOf` for why the candidates are collected rather than
// refused.
function anonLeafBindingLits(ix: i32, depth: i32, out: i32[]) {
  const e = P.nodes[ix]
  if e is Ident {
    anonLeafIxEnsure()
    // D1514 — the nodes that bind this name, off the same list every other resolver here reads;
    // a `Param` and an assignment are in it too, unlike D1100's list which recorded only one.
    let bl = sidArrGet(anonIxBindHead, sidLookup(e.identName))
    while bl >= 0 {
      const b = P.nodes[anonIxLnkNode[bl]]
      // The raw initializer: `unwrapParen` of a binding with none reads `P.nodes[-1]`, and
      // the callee guards -1 itself (D1152).
      if b is LetDecl { anonLeafContainerLits(b.letInit, depth + 1, out) }
      bl = anonIxLnkNext[bl]
    }
  }
  0
}

// A value that is a named function: a bare identifier the module declares as one. A lambda
// answers "" — it has no name for the moved-`$fnsig` lookups to key on, and the safe
// direction here is the veto.
function anonLeafFnNameOfVal(valIx: i32): string {
  if valIx < 0 { return "" }
  const v = P.nodes[unwrapParen(valIx)]
  if v is Ident {
    if nameNamesFunction(v.identName) { return v.identName }
  }
  ""
}

// The `FuncDecl` node named `nm`, or -1 when the module declares none or two.
function anonLeafDeclFnNodeOf(nm: string): i32 {
  if nm == "" { return 0 - 1 }
  // D1514 — "declared exactly once" is `anonLeafOneDeclNamed`'s own question, and the index
  // answers it and hands back the node in one read rather than a scan of the decl list.
  if anonLeafIxDeclCount(nm) != 1 { return 0 - 1 }
  const dl = sidArrGet(anonIxDeclHead, sidLookup(nm))
  if dl < 0 { return 0 - 1 }
  anonIxLnkNode[dl]
}

// D1401 — can a `.m(…)` on a receiver of this kind be a call through a function value?
// Exhaustive over `Ty` on purpose: a list/map/primitive has a fixed built-in surface with no
// fields to hold a closure, a struct's `.f` can be one, and a union, nullable, hole and the
// rest keep the veto since their spelling does not open a wrapper that could hold one.
function anonLeafBuiltinMethodRecv(ot: i32): boolean {
  const o = T.tys[ot]
  if o is TyArray { return true }
  if o is TyMap { return true }
  if o is TyPrim { return true }
  if o is TyObj { return true }
  if o is TyFunc { return false }
  if o is TyUnion { return false }
  if o is TyNullable { return false }
  if o is TyVar { return false }
  if o is TyLit { return false }
  if o is TyNeg { return false }
  if o is TyErr { return false }
  false
}

// D939 — the one function every caller passes to the parameter named `nm`, or "".
// Deliberately narrow: answers only when exactly one `Param` in the program carries the
// name, and every call site of its owning function passes the same single function at that
// position. Anything else — a shared name, a non-function argument, a mismatched call — answers "".
const anonLeafParamFnBusy: string[] = []

function anonLeafParamFnTarget(nm: string): string {
  // D939 — the re-entry guard, not defensive: this asks `anonLeafCalleeFnName`, which asks
  // `anonLeafFnValueTarget`, which asks this — a cycle no call-frame depth cap counts.
  let bi = 0
  while bi < anonLeafParamFnBusy.length {
    if anonLeafParamFnBusy[bi] == nm { return "" }
    bi = bi + 1
  }
  anonLeafParamFnBusy.push(nm)
  const ans = anonLeafParamFnTargetGo(nm)
  anonLeafParamFnBusy.pop()
  ans
}

function anonLeafParamFnTargetGo(nm: string): string {
  // Every `Param` with this name, each answered on its own declaration, with the answers
  // required to agree — the same rule the call-site loop below applies to arguments.
  anonLeafIxEnsure()
  let ans = ""
  // D1514 — the parameter slots declaring this name, in the order the nested walk produced.
  let pl = sidArrGet(anonIxParHead, sidLookup(nm))
  while pl >= 0 {
    const one = anonLeafParamFnTargetAt(anonIxParOwner[pl], anonIxParPos[pl])
    if one == "" { return "" }
    if ans != "" {
      if ans != one { return "" }
    }
    ans = one
    pl = anonIxParNext[pl]
  }
  ans
}

// D1090 — the one function an argument expression evaluates to, or "". Two spellings name a
// function without being its name: an identifier (a declaration, or a binding written with
// one) and a call of a function that hands one back — `apply(pick())` delivers `src` to the
// slot exactly as `apply(src)` does.
function anonLeafArgFnName(argIx: i32): string {
  if argIx < 0 { return "" }
  const av = unwrapParen(argIx)
  if av < 0 { return "" }
  const avn = P.nodes[av]
  if avn is Ident {
    if anonLeafOneDeclNamed(avn.identName) { return avn.identName }
    return anonLeafFnValueTarget(avn.identName)
  }
  if avn is Call {
    const cnm = anonLeafCalleeFnName(avn.callFn)
    if cnm == "" { return "" }
    return anonLeafFnRetFnName(cnm)
  }
  ""
}

// D1090 — the one function a function named `fname` hands back, or "". Strict: every value
// it returns (each `return e` and the body's tail) must name the same single function.
const anonLeafRetFnBusy: string[] = []

function anonLeafFnRetFnName(fname: string): string {
  let bi = 0
  while bi < anonLeafRetFnBusy.length {
    if anonLeafRetFnBusy[bi] == fname { return "" }
    bi = bi + 1
  }
  anonLeafRetFnBusy.push(fname)
  const ans = anonLeafFnRetFnNameGo(fname)
  anonLeafRetFnBusy.pop()
  ans
}

function anonLeafFnRetFnNameGo(fname: string): string {
  if !anonLeafOneDeclNamed(fname) { return "" }
  let ans = ""
  // D1514 — the declarations of this name, rather than every node in the arena.
  let dl = sidArrGet(anonIxDeclHead, sidLookup(fname))
  while dl >= 0 {
    const fd = P.nodes[anonIxLnkNode[dl]]
    if fd is FuncDecl {
      const rets: i32[] = []
      if !anonLeafFnRetExprs(fd.fnBody, rets, true) { return "" }
      if rets.length == 0 { return "" }
      let k = 0
      while k < rets.length {
        const one = anonLeafArgFnName(rets[k])
        if one == "" { return "" }
        if ans != "" {
          if ans != one { return "" }
        }
        ans = one
        k = k + 1
      }
    }
    dl = anonIxLnkNext[dl]
  }
  ans
}

// Every expression a body hands back: each `return e` plus the block's implicit tail. A nested
// function declaration is skipped — its returns are its own. `false` on a bare `return`, which
// hands back no function at all.
function anonLeafFnRetExprs(ix: i32, out: i32[], tail: boolean): boolean {
  if ix < 0 { return true }
  const n = P.nodes[ix]
  if n is FuncDecl { return true }
  if n is RetStmt {
    if n.retArg < 0 { return false }
    out.push(n.retArg)
  }
  if n is Block {
    if tail {
      if n.blkStmts.length > 0 { out.push(n.blkStmts[n.blkStmts.length - 1]) }
    }
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if !anonLeafFnRetExprs(kids[i], out, false) { return false }
    i = i + 1
  }
  true
}

// D1090 — every function the parameter named `nm` may receive, or false when the set is not
// fully known. The membership form of `anonLeafParamFnTarget`: a slot handed two known
// functions is as attributable as one handed a single function, but only deliverable if both
// rows move together (`anonLeafCoMoveFnParamSlots`). Names are appended without dedup.
function anonLeafParamFnNames(nm: string, out: string[]): boolean {
  let bi = 0
  while bi < anonLeafParamFnBusy.length {
    if anonLeafParamFnBusy[bi] == nm { return false }
    bi = bi + 1
  }
  anonLeafParamFnBusy.push(nm)
  const ok = anonLeafParamFnNamesGo(nm, out)
  anonLeafParamFnBusy.pop()
  ok
}

function anonLeafParamFnNamesGo(nm: string, out: string[]): boolean {
  anonLeafIxEnsure()
  let found = false
  // D1514 — the parameter slots declaring this name, in the order the nested walk produced.
  let pl = sidArrGet(anonIxParHead, sidLookup(nm))
  while pl >= 0 {
    if !anonLeafParamFnNamesAt(anonIxParOwner[pl], anonIxParPos[pl], out) {
      return false
    }
    found = true
    pl = anonIxParNext[pl]
  }
  found
}

// D1090 — every other function `nm` shares a closure-typed parameter slot with: their rows
// are coupled to its, the same reason `anonLeafCoMoveFnRets` states about a binding. One slot
// holds one wasm signature, so moving `src`'s row while `other`'s stays narrow gives
// `apply(src)` beside `apply(other)` a parameter neither can hold.
function anonLeafCoMoveFnParamSlots(nm: string) {
  anonLeafIxEnsure()
  // D1514 — the function-typed parameter slots, which the walk this replaces reached by
  // testing every parameter in the program against the same gate.
  let si = 0
  while si < anonIxFnParOwner.length {
    const names: string[] = []
    if anonLeafParamFnNamesAt(anonIxFnParOwner[si], anonIxFnParPos[si], names) {
      let hasNm = false
      let j = 0
      while j < names.length {
        if names[j] == nm { hasNm = true }
        j = j + 1
      }
      if hasNm {
        let k = 0
        while k < names.length {
          if names[k] != nm { anonLeafMarkRetMoved(names[k]) }
          k = k + 1
        }
      }
    }
    si = si + 1
  }
  0
}

// The set form of `anonLeafParamFnTargetAt`: every function delivered to `owner`'s parameter
// at position `pos`, or false when one delivery is something this cannot name.
function anonLeafParamFnNamesAt(owner: i32, pos: i32, out: string[]): boolean {
  const od = P.nodes[owner]
  if od is FuncDecl {
    if !anonLeafOneDeclNamed(od.fnName) { return false }
    const pNames: string[] = []
    let pk = 0
    while pk < od.fnParams.length {
      const pnk = P.nodes[od.fnParams[pk]]
      if pnk is Param { pNames.push(pnk.parName) } else { pNames.push("") }
      pk = pk + 1
    }
    let hits = 0
    // D1514 — the call sites this could answer for, rather than the whole arena.
    const cand: i32[] = []
    anonLeafIxCallsFor(od.fnName, cand)
    let ci = 0
    while ci < cand.length {
      const cn = P.nodes[cand[ci]]
      if cn is Call {
        if anonLeafCallMayTarget(cn.callFn, od.fnName) {
          const slots = orderArgsByParamNames(
            pNames,
            cn.callArgs,
            cn.callArgNames,
          )
          if slots.length != pNames.length { return false }
          if pos >= slots.length { return false }
          const argNm = anonLeafArgFnName(slots[pos])
          if argNm == "" { return false }
          out.push(argNm)
          hits = hits + 1
        }
      }
      ci = ci + 1
    }
    if hits > 0 { return true }
    // D1090 — no call site at all answers true (nothing reaches this slot) unless the name is
    // also used as a value, since a call through the value passes arguments no scan reads.
    return !anonLeafNameUsedAsValue(od.fnName)
  }
  false
}

// Is `fname` mentioned anywhere other than in callee position — i.e. used as a function
// value? The scan `anonLeafNarrowUseMark` and `anonLeafSlotAllMembers` each spell inline.
function anonLeafNameUsedAsValue(fname: string): boolean {
  anonLeafIxEnsure()
  sidArrGet(anonIxIdentValue, sidLookup(fname)) == 1
}

// The one function every caller passes to `owner`'s parameter at position `pos`, or "". The
// per-declaration half of `anonLeafParamFnTargetGo`, split out so the name resolution above
// can ask it once per `Param` rather than once per NAME.
function anonLeafParamFnTargetAt(owner: i32, pos: i32): string {
  const od = P.nodes[owner]
  if od is FuncDecl {
    if !anonLeafOneDeclNamed(od.fnName) { return "" }
    const pNames: string[] = []
    let pk = 0
    while pk < od.fnParams.length {
      const pnk = P.nodes[od.fnParams[pk]]
      if pnk is Param { pNames.push(pnk.parName) } else { pNames.push("") }
      pk = pk + 1
    }
    let hit = ""
    let hits = 0
    // D1514 — the call sites this could answer for, rather than the whole arena.
    const cand: i32[] = []
    anonLeafIxCallsFor(od.fnName, cand)
    let ci = 0
    while ci < cand.length {
      const cn = P.nodes[cand[ci]]
      if cn is Call {
        // D1090 — the membership form (D948): a call through a binding that may hold this function
        // is a call site of it too, not only an exact-name match.
        if anonLeafCallMayTarget(cn.callFn, od.fnName) {
          const slots = orderArgsByParamNames(
            pNames,
            cn.callArgs,
            cn.callArgNames,
          )
          if slots.length != pNames.length { return "" }
          if pos >= slots.length { return "" }
          // D1090 — through the binding hop and the return hop too: `apply(h)` over `const h = src`
          // and `apply(pick())` over a `pick` that returns `src` deliver the same function as `apply(src)`.
          const argNm = anonLeafArgFnName(slots[pos])
          if argNm == "" { return "" }
          if hits > 0 {
            if hit != argNm { return "" }
          }
          hit = argNm
          hits = hits + 1
        }
      }
      ci = ci + 1
    }
    if hits == 0 { return "" }
    return hit
  }
  ""
}

// D940 — the closure-typed slot a moved function is delivered to (`anonLeafCloSlotFn`).
// Runs once the ret/param marks are final. Only a slot whose deliveries agree is marked:
// `anonLeafParamFnTarget` answers "" the moment two call sites hand the parameter different
// functions, since one parameter is one wasm signature and cannot be at two rows.
function anonLeafCloSlotMark() {
  anonLeafIxEnsure()
  // D1514 — the function-typed parameter slots; asking `anonLeafParamFnTarget` of every
  // scalar parameter is the cost this walk cannot pay, so the index applies the gate at the build.
  let si = 0
  while si < anonIxFnParOwner.length {
    const fi = anonIxFnParOwner[si]
    const pj = anonIxFnParPos[si]
    const fd = P.nodes[fi]
    if fd is FuncDecl {
      const pIx = fd.fnParams[pj]
      const pn = P.nodes[pIx]
      if pn is Param {
        let tgt = anonLeafParamFnTarget(pn.parName)
        if tgt == "" {
          // D1090 — a slot fed two known functions still has one signature, since
          // `anonLeafCoMoveFnParamSlots` moved the whole set together, so any member (the first) represents it.
          const setNames: string[] = []
          if anonLeafParamFnNamesAt(fi, pj, setNames) {
            if setNames.length > 0 { tgt = setNames[0] }
          }
        }
        if tgt != "" {
          if anonLeafFnNameMoved(tgt) {
            while anonLeafCloSlotFn.length <= pIx { anonLeafCloSlotFn.push("") }
            anonLeafCloSlotFn[pIx] = tgt
          }
        }
      }
    }
    si = si + 1
  }
  0
}

// D1090 — the bindings a moved function is delivered to (`anonLeafCloBindName`). A binding
// written only with a function whose rows the merge moved must call at that function's own
// `$fnsig`, not its annotation's; a binding whose target is unresolvable or unmoved records
// nothing, keeping every closure-valued binding in every other program byte-identical.
function anonLeafCloBindMark() {
  // The same early-out `anonLeafNarrowUseMark` takes: the loop below asks `anonLeafFnValueTarget`
  // (a whole-arena scan) of every binding, so an ungated pass is quadratic in the node count.
  let moved = false
  let mr = 0
  while mr < anonLeafRetMoved.length {
    if anonLeafRetMoved[mr] == 1 { moved = true }
    mr = mr + 1
  }
  let mp = 0
  while mp < anonLeafParamMoved.length {
    if anonLeafParamMoved[mp] == 1 { moved = true }
    mp = mp + 1
  }
  if !moved { return 0 }
  anonLeafIxEnsure()
  // D1514 — the binding writes, which the walk this replaces found by testing every node.
  let wi = 0
  while wi < anonIxWriteSite.length {
    const n = P.nodes[anonIxWriteSite[wi]]
    let bn = ""
    if n is LetDecl { bn = n.letName }
    if n is BinExpr {
      const tgt = unwrapParen(n.binLeft)
      if tgt >= 0 {
        const tn = P.nodes[tgt]
        if tn is Ident { bn = tn.identName }
      }
    }
    if bn != "" {
      let already = false
      let k = 0
      while k < anonLeafCloBindName.length {
        if anonLeafCloBindName[k] == bn { already = true }
        k = k + 1
      }
      if !already {
        const tgt = anonLeafFnValueTarget(bn)
        if tgt != "" {
          if anonLeafFnNameMoved(tgt) {
            anonLeafCloBindName.push(bn)
            anonLeafCloBindFn.push(tgt)
          }
        }
      }
    }
    wi = wi + 1
  }
  0
}

// D940 — did the merge move any row of a function named `nm`? Either half counts: the
// `$fnsig` key is built from BOTH the parameter tokens and the result token, so a move on
// either side is a key the annotation cannot reproduce.
function anonLeafFnNameMoved(nm: string): boolean {
  anonLeafIxEnsure()
  // D1514 — the declarations of this name, rather than every node in the arena.
  let dl = sidArrGet(anonIxDeclHead, sidLookup(nm))
  while dl >= 0 {
    const i = anonIxLnkNode[dl]
    const n = P.nodes[i]
    if n is FuncDecl {
      if i < anonLeafRetMoved.length {
        if anonLeafRetMoved[i] == 1 { return true }
      }
      let pj = 0
      while pj < n.fnParams.length {
        const px = n.fnParams[pj]
        if px < anonLeafParamMoved.length {
          if anonLeafParamMoved[px] == 1 { return true }
        }
        pj = pj + 1
      }
    }
    dl = anonIxLnkNext[dl]
  }
  false
}

// D948 — every function a binding may hold, or false when it may hold something else.
// `anonLeafFnValueTarget` needs one name; this answers the weaker "is the set fully known"
// question, so `let f = src; if n > 0 { f = other }` is attributable. A `Param` refutes here
// (D939's resolver is its arm), as does a non-identifier write or an unknown name.
function anonLeafFnValueNames(nm: string, out: string[]): boolean {
  anonLeafIxEnsure()
  let found = false
  // D1514 — the nodes that bind this name, in arena order. The name compares the walk this
  // replaces made per node are what the list's key already decided.
  let bl = sidArrGet(anonIxBindHead, sidLookup(nm))
  while bl >= 0 {
    const n = P.nodes[anonIxLnkNode[bl]]
    if n is Param {
      // D1090 — a parameter's sources are its call sites' arguments, the same widening
      // `anonLeafFnValueTarget` already takes for a bound name (D939).
      return anonLeafParamFnNames(nm, out)
    }
    let w = 0 - 1
    if n is LetDecl { w = unwrapParen(n.letInit) }
    if n is BinExpr { w = unwrapParen(n.binRight) }
    if w >= 0 {
      const wn = P.nodes[w]
      if wn is Ident {
        if !anonLeafOneDeclNamed(wn.identName) { return false }
        out.push(wn.identName)
        found = true
      } else {
        return false
      }
    }
    bl = anonIxLnkNext[bl]
  }
  found
}

// D948 — could this call site reach the function named `fname`? The membership form of
// `anonLeafCalleeFnName == fname`: a call through a binding that may hold two known
// functions is a call site of both, not only the one the binding happens to name first.
function anonLeafCallMayTarget(callFn: i32, fname: string): boolean {
  if fname == "" { return false }
  if anonLeafCalleeFnName(callFn) == fname { return true }
  const cf = unwrapParen(callFn)
  if cf < 0 { return false }
  const cfn = P.nodes[cf]
  if cfn is Ident {
    if anonLeafOneDeclNamed(cfn.identName) { return false }
    const names: string[] = []
    if !anonLeafFnValueNames(cfn.identName, names) { return false }
    let i = 0
    while i < names.length {
      if names[i] == fname { return true }
      i = i + 1
    }
  }
  false
}

// D948 — the other functions `nm` shares a binding with: their return rows are coupled to
// its. One binding holds one wasm signature, so moving `src`'s row while `other`'s stays
// narrow gives `let f = src; f = other` two functions it cannot both hold — a merge that
// moves one must move the whole set.
function anonLeafCoMoveFnRets(nm: string) {
  anonLeafIxEnsure()
  // D1514 — the binding writes, which the walk this replaces found by testing every node.
  let wi = 0
  while wi < anonIxWriteSite.length {
    const n = P.nodes[anonIxWriteSite[wi]]
    let bn = ""
    if n is LetDecl { bn = n.letName }
    if n is BinExpr {
      const tgt = unwrapParen(n.binLeft)
      if tgt >= 0 {
        const tn = P.nodes[tgt]
        if tn is Ident { bn = tn.identName }
      }
    }
    if bn != "" {
      const names: string[] = []
      if anonLeafFnValueNames(bn, names) {
        let hasNm = false
        let j = 0
        while j < names.length {
          if names[j] == nm { hasNm = true }
          j = j + 1
        }
        if hasNm {
          let k = 0
          while k < names.length {
            if names[k] != nm { anonLeafMarkRetMoved(names[k]) }
            k = k + 1
          }
        }
      }
    }
    wi = wi + 1
  }
  0
}

// D925 — the function a call's callee position names, through at most one binding hop, or
// "". A bare identifier a `FuncDecl` declares is itself; otherwise it names a function only
// when every write to it is that same function's name. One hop and no more: `const g = f`
// where `f` is itself a binding is a chain this does not follow.
function anonLeafCalleeFnName(callFn: i32): string {
  const cf = unwrapParen(callFn)
  if cf < 0 { return "" }
  const cfn = P.nodes[cf]
  if cfn is Ident {
    if anonLeafOneDeclNamed(cfn.identName) { return cfn.identName }
    return anonLeafFnValueTarget(cfn.identName)
  }
  ""
}

// D925 — the one function name `nm` is ever bound to, or "". A `Param` refutes outright
// (its value is the caller's). A write naming another binding is followed, not refused —
// `let gb = src; gb = ga` over `let ga = src` is one function reached by two hops — under the
// same re-entry guard as `anonLeafParamFnTarget`, since a chain of two can cycle with no frame.
const anonLeafFnValueBusy: string[] = []

function anonLeafFnValueTarget(nm: string): string {
  let bi = 0
  while bi < anonLeafFnValueBusy.length {
    if anonLeafFnValueBusy[bi] == nm { return "" }
    bi = bi + 1
  }
  anonLeafFnValueBusy.push(nm)
  const ans = anonLeafFnValueTargetGo(nm)
  anonLeafFnValueBusy.pop()
  ans
}

function anonLeafFnValueTargetGo(nm: string): string {
  anonLeafIxEnsure()
  let hit = ""
  let hits = 0
  // D1514 — the nodes that bind this name, in arena order. The name compares the walk this
  // replaces made per node are what the list's key already decided.
  let bl = sidArrGet(anonIxBindHead, sidLookup(nm))
  while bl >= 0 {
    const n = P.nodes[anonIxLnkNode[bl]]
    if n is Param {
      // D939 — a callback parameter is resolvable when its own call sites agree: a parameter's
      // sources are the arguments at every call site of the function that declares it.
      return anonLeafParamFnTarget(nm)
    }
    let w = 0 - 1
    if n is LetDecl { w = unwrapParen(n.letInit) }
    if n is BinExpr { w = unwrapParen(n.binRight) }
    if w >= 0 {
      const wn = P.nodes[w]
      if wn is Ident {
        // …and a write naming another binding is chased to that binding's own answer.
        let wNm = wn.identName
        if !anonLeafOneDeclNamed(wNm) { wNm = anonLeafFnValueTarget(wNm) }
        if wNm == "" { return "" }
        if hits > 0 {
          if hit != wNm { return "" }
        }
        hit = wNm
        hits = hits + 1
      } else {
        return ""
      }
    }
    bl = anonIxLnkNext[bl]
  }
  if hits == 0 { return "" }
  hit
}

// D911 — is `nm` bound to a value anywhere in the program (a `LetDecl` or a `Param`)? The
// cheap half of the indirect-call test above; a function declaration is not a binding here,
// which is the whole distinction it draws.
function anonLeafNameIsBound(nm: string): boolean {
  anonLeafIxEnsure()
  // D1514 — the nodes that bind this name. An assignment is in the list too and is not a
  // binding here, which is the same distinction the two arms below always drew.
  let bl = sidArrGet(anonIxBindHead, sidLookup(nm))
  while bl >= 0 {
    const n = P.nodes[anonIxLnkNode[bl]]
    if n is LetDecl { return true }
    if n is Param { return true }
    bl = anonIxLnkNext[bl]
  }
  false
}

// Is the arena node `n` the callee position of some call? The reverse of `Call.callFn`, asked
// of an identifier so `anonLeafParamArgsOk` can tell `src(x)` from `const f = src`.
function anonLeafIsCalleePos(n: i32): boolean {
  anonLeafIxEnsure()
  sidArrGet(anonIxCalleePos, n) == 1
}

// D1514 — are all three resolver re-entry guards empty? The state in which an answer this
// family computes is the module's rather than one recursion's, so a memo may be filled.
function anonLeafResolverQuiet(): boolean {
  anonLeafFnValueBusy.length == 0 &&
    anonLeafParamFnBusy.length == 0 &&
    anonLeafRetFnBusy.length == 0
}

// The subtree scan behind `anonLeafRetIdentOk`: every `const nm = …` and every `nm = …` in this
// frame. A nested function declaration is skipped — its `nm` is a different binding.
function anonLeafBindScan(
  ix: i32,
  nm: string,
  body: i32,
  out: i32[],
  hits: i32[],
  fns: string[],
  pars: i32[],
  depth: i32,
  ids: string[],
): boolean {
  if ix < 0 { return true }
  const n = P.nodes[ix]
  if n is FuncDecl { return true }
  if n is LetDecl {
    if n.letName == nm {
      if (
        !anonLeafBoundValOk(n.letInit, body, out, hits, fns, pars, depth, ids)
      ) {
        return false
      }
    }
  }
  if n is BinExpr {
    if n.binOp == "=" {
      const tgt = unwrapParen(n.binLeft)
      if tgt >= 0 {
        const tn = P.nodes[tgt]
        if tn is Ident {
          if tn.identName == nm {
            if (
              !anonLeafBoundValOk(
                n.binRight,
                body,
                out,
                hits,
                fns,
                pars,
                depth,
                ids,
              )
            ) {
              return false
            }
          }
        }
      }
    }
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if !anonLeafBindScan(kids[i], nm, body, out, hits, fns, pars, depth, ids) {
      return false
    }
    i = i + 1
  }
  true
}

// One value written to a returned binding: a literal is a member, a `null` is neither, a
// call is the next frame, anything else refutes. An identifier is the same resolver one name
// over — a parameter's sources are its call sites' arguments, another local's are its own
// writes — resolved against `body`, the frame that returned it.
function anonLeafBoundValOk(
  rhs: i32,
  body: i32,
  out: i32[],
  hits: i32[],
  fns: string[],
  pars: i32[],
  depth: i32,
  ids: string[],
): boolean {
  const v = unwrapParen(rhs)
  if v < 0 { return false }
  const vn = P.nodes[v]
  if vn is NullLit {
    hits.push(v)
    return true
  }
  if vn is ObjLit {
    out.push(v)
    hits.push(v)
    return true
  }
  if vn is Call {
    if !anonLeafCalleeRead(vn.callFn, out, fns, pars, depth + 1) {
      return false
    }
    hits.push(v)
    return true
  }
  // D953 — a field read of a parameter, projected through the parameter's own call sites; the
  // base literal itself must not be published to `out`, only the projected field value.
  if vn is Member {
    const mo = unwrapParen(vn.memObj)
    if mo >= 0 {
      const mon = P.nodes[mo]
      if mon is Ident {
        const pIx = anonLeafParamNodeOf(body, mon.identName)
        if pIx >= 0 {
          // The owners go to a scratch (`bOut`, discarded); the param does not — its slot must follow
          // the carrier's new row, so it is pushed to the caller's `pars`.
          const bOut: i32[] = []
          const bFns: string[] = []
          if !anonLeafParamArgsOk(body, pIx, bOut, bFns, pars, depth) {
            return false
          }
          pars.push(pIx)
          let ai2 = 0
          while ai2 < bOut.length {
            const al = P.nodes[bOut[ai2]]
            if al is ObjLit {
              let found = 0 - 1
              let fj = 0
              while fj < al.objFields.length {
                const fn2 = P.nodes[al.objFields[fj]]
                if fn2 is FieldInit {
                  if fn2.fiName == vn.memProp {
                    found = unwrapParen(fn2.fiValue)
                  }
                }
                fj = fj + 1
              }
              if found < 0 { return false }
              const fv = P.nodes[found]
              if fv is ObjLit { out.push(found) }
              else if fv is NullLit { 0 }
              else { return false }
            } else {
              return false
            }
            ai2 = ai2 + 1
          }
          hits.push(v)
          return true
        }
      }
    }
    return false
  }
  if vn is Ident {
    // D934 — a module-scope binding has no frame (which `anonLeafRetIdentOk` needs), so the
    // by-name whole-arena scan answers here instead of refuting.
    if body < 0 {
      if !anonLeafArgIdentSeen(vn.identName, out, fns, pars, depth, ids) {
        return false
      }
      hits.push(v)
      return true
    }
    if !anonLeafRetIdentOk(vn.identName, body, out, fns, pars, depth, ids) {
      return false
    }
    hits.push(v)
    return true
  }
  false
}

// The body block's last statement, which carries the implicit return. A statement in that
// position is not a value at all (the function's returns are then its `return`s alone), so it
// is skipped rather than refuted; anything that is an expression goes through
// `anonLeafRetPathOk`.
function anonLeafTailPathOk(
  ix: i32,
  out: i32[],
  body: i32,
  fns: string[],
  pars: i32[],
  depth: i32,
): boolean {
  if ix < 0 { return true }
  const n = P.nodes[ix]
  if n is LetDecl { return true }
  if n is RetStmt { return true }
  if n is IfStmt { return true }
  if n is WhileStmt { return true }
  if n is ForRange { return true }
  if n is ForIn { return true }
  if n is Block { return true }
  if n is FuncDecl { return true }
  anonLeafRetPathOk(ix, out, body, fns, pars, depth)
}

// One `lhs = rhs` statement: append `rhs` to `mem` when it is an object literal stored into
// `name[…]`. Split out so the container scan above reads as one question.
function anonLeafJoinStore(lhs: i32, rhs: i32, name: string, mem: i32[]) {
  const tgt = unwrapParen(lhs)
  if tgt < 0 { return 0 }
  const tn = P.nodes[tgt]
  if tn is Index {
    const tb = unwrapParen(tn.idxArr)
    if tb >= 0 {
      const tbn = P.nodes[tb]
      if tbn is Ident {
        if tbn.identName == name {
          const rv = unwrapParen(rhs)
          if rv >= 0 {
            const rn = P.nodes[rv]
            if rn is ObjLit {
              let seen = false
              let i = 0
              while i < mem.length {
                if mem[i] == rv { seen = true }
                i = i + 1
              }
              if !seen { mem.push(rv) }
            }
          }
        }
      }
    }
  }
  0
}

// D833 — is literal `n` one of a `??`'s joined values? The O(1) read of the mark pass's answer.
function anonLeafInJoin(n: i32): boolean {
  if n < 0 { return false }
  if n >= anonLeafJoined.length { return false }
  anonLeafJoined[n] == 1
}

// D833 — the row that already claims `n`'s `??` family, or -1; see `anonLeafFamRow`.
function anonLeafFamRowOf(n: i32): i32 {
  if n < 0 { return 0 - 1 }
  if n >= anonLeafFamRow.length { return 0 - 1 }
  anonLeafFamRow[n]
}

// D953 — the field at which `ow`'s own nested value is a `??` family member whose row has
// moved, or "". The carrier's half of `anonLeafMergeField`: a carrier like `{ r: { r: 7 } }`
// belongs to no join itself, but still has to follow since the inner literal it holds is a
// member and builds at the merged row now.
function anonLeafNestedMergedField(ow: i32): string {
  const o = P.nodes[ow]
  if o is ObjLit {
    let i = 0
    while i < o.objFields.length {
      const f = P.nodes[o.objFields[i]]
      if f is FieldInit {
        const fv = unwrapParen(f.fiValue)
        if fv >= 0 {
          const fvn = P.nodes[fv]
          if fvn is ObjLit {
            if anonLeafInJoin(fv) {
              const ns = structIndexOfObj(fv)
              if ns >= 0 {
                if anonLeafSupersedeOf(ns) != ns { return f.fiName }
              }
            }
          }
        }
      }
      i = i + 1
    }
  }
  ""
}

// D833 — the field at which the row `narrowSi` already claiming `ow` is narrower than the
// `??` join `ow` belongs to, or "" when there is no such field — the mint gate and the
// supersede's trigger. Asked only of a claimed literal; an unclaimed one still reaches
// `anonMintRowFor` on the gate's first disjunct, unchanged.
function anonLeafMergeField(ow: i32, narrowSi: i32): string {
  if narrowSi < 0 { return "" }
  if !anonLeafInJoin(ow) { return "" }
  const o = P.nodes[ow]
  if o is ObjLit {
    let i = 0
    while i < o.objFields.length {
      const f = P.nodes[o.objFields[i]]
      if f is FieldInit {
        if anonNestPolyUnionName(ow, f.fiName, unwrapParen(f.fiValue)) == "" {
          const set = anonLeafPolyUnionSetOpen(ow, f.fiName, f.fiValue)
          if set != "" {
            // The merged row may already exist — a second `??` family over the same field set, or the
            // declared spelling of the shape — so there is nothing to mint, only the redirect.
            const serv = anonLeafServingRow(ow, f.fiName, set)
            if serv >= 0 {
              anonLeafRecordSupersede(narrowSi, serv)
              // D881 — and the carrier's row, unreachable from the post-mint rung below since
              // this family does not mint: a second same-fieldset `??` family needs this redirect too.
              anonLeafRecordSupersede(anonLeafCarrierRowOf(ow), serv)
              return ""
            }
            return f.fiName
          }
        }
      }
      i = i + 1
    }
  }
  ""
}

// D872 — the field at which `ow`'s own mint carries a merged box, or "". Narrower than
// `anonLeafMergeField`, which starts from `narrowSi >= 0`: a default no row can hold
// (`{r: "s"}` beside a `{r: i32}` row) is claimed by nothing yet still mints a box, and this
// is the predicate that says its carrier owes a supersede too, without that precondition.
function anonLeafMergedFieldOf(ow: i32): string {
  if !anonLeafInJoin(ow) { return "" }
  const o = P.nodes[ow]
  if o is ObjLit {
    let i = 0
    while i < o.objFields.length {
      const f = P.nodes[o.objFields[i]]
      if f is FieldInit {
        if anonNestPolyUnionName(ow, f.fiName, unwrapParen(f.fiValue)) == "" {
          if anonLeafPolyUnionSetOpen(ow, f.fiName, f.fiValue) != "" {
            return f.fiName
          }
        }
      }
      i = i + 1
    }
  }
  ""
}

// D833 — row `mergedSi` supersedes `narrowSi` as a map's value; see `anonLeafSupersede`.
function anonLeafRecordSupersede(narrowSi: i32, mergedSi: i32) {
  if narrowSi < 0 || mergedSi < 0 { return 0 }
  if narrowSi == mergedSi { return 0 }
  while anonLeafSupersede.length <= narrowSi { anonLeafSupersede.push(0 - 1) }
  anonLeafSupersede[narrowSi] = mergedSi
  0
}

// Mint one anonymous struct row for the object literal at `objIx`. The body of
// `collectAnonShapes`' main loop, extracted so the pre-mint pass mints a row the same
// way rather than through a second copy of it — two mints that disagree would put two
// different layouts under one `#anonN` key.
function anonMintRowFor(objIx: i32) {
  const an = P.nodes[objIx]
  if an is ObjLit {
    const ai = objIx
    const fields = an.objFields
    // A literal with a function-valued field classifies its plain-ident fields as i32 (the host
    // types them exactly); one with none leaves idents unclassifiable, matching the pinned annotation.
    let hasFnField = false
    let ffi = 0
    while ffi < fields.length {
      const ff = P.nodes[fields[ffi]]
      if ff is FieldInit {
        // (Direct node checks, not `fieldValueFeOf` — `fnStmts` is not yet
        // populated when `collectS`/`collectAnonShapes` run.)
        const fv = P.nodes[ff.fiValue]
        if fv is FuncDecl { hasFnField = true }
        if fv is Ident {
          if nameNamesFunction(fv.identName) { hasFnField = true }
        }
      }
      ffi = ffi + 1
    }
    const codes: i32[] = []
    const names: string[] = []
    const elemNames: string[] = []
    const elemKeys: boolean[] = []
    let ok = true
    let fi = 0
    while fi < fields.length {
      const f = P.nodes[fields[fi]]
      if f is FieldInit {
        let code = anonFieldCode(f.fiValue)
        // D672 — a joined owner's field is a union box, not a nested ref: where two owner literals
        // disagree at a nested field and something joins them, the code is 16 (`anonNestPolyUnionName` gates it, "" elsewhere).
        const boxU = anonNestPolyUnionName(ai, f.fiName, unwrapParen(f.fiValue))
        if boxU != "" { code = 16 }
        // D804 — the leaf twin, one layer down: two `??`-joined literals disagreeing at a scalar
        // field need the merged row too, so the code comes from the merged spelling, not 16.
        let leafSet = ""
        let leafCode = -1
        if boxU == "" {
          leafSet = anonLeafPolyUnionSet(ai, f.fiName, f.fiValue)
          if leafSet != "" {
            leafCode = anonLeafPolyFieldCode(leafSet)
            if leafCode >= 0 { code = leafCode }
          }
        }
        if code < 0 && hasFnField {
          const iv = P.nodes[f.fiValue]
          if iv is Ident {
            if !nameNamesFunction(iv.identName) { code = 0 }
          }
        }
        if code < 0 { ok = false }
        codes.push(code)
        names.push(f.fiName)
        if boxU != "" {
          elemNames.push(boxU)
        } else if leafCode == 16 {
          elemNames.push(leafSet) // the box's member set
        } else if leafCode == 30 {
          // D884 — the `K | null` niche records the non-null alias, same as `fieldRecElemName`'s
          // code-30 arm; a `""` here would leave the field an i32 slot with no atom table.
          elemNames.push(nulLitUnionInnerName(leafSet))
        } else if leafCode >= 0 {
          elemNames.push("") // a bare niche (code 20) records no companion
        } else {
          // D953 — a nested field whose value is itself a `??` family member names the merged row
          // here, since `sFieldTgtStructIdx` later resolves the field's target row from this name.
          let nestNm = anonFieldElemName(f.fiValue, code)
          if code == 15 {
            const nv = unwrapParen(f.fiValue)
            if anonLeafInJoin(nv) {
              const narrowSi = structIndexOfObj(nv)
              const mergedSi = anonLeafSupersedeOf(narrowSi)
              if mergedSi >= 0 && mergedSi != narrowSi {
                if mergedSi < sNames.length { nestNm = sNames[mergedSi] }
              }
            }
          }
          elemNames.push(nestNm)
        }
        elemKeys.push(anonFieldElemKeyI32(f.fiValue, code))
      } else {
        ok = false
      }
      fi = fi + 1
    }
    if ok && codes.length > 0 {
      sDeclared = true
      // A synthetic unique name (`#` never collides with a user identifier), so a ref list of
      // this shape interns a slot; the arena-index sidecar keys it by type index instead of name.
      sNames.push("#anon" + i32ToStr(sNames.length))
      recordSRowDeclOfName(sNames[sNames.length - 1])
      recordSTyIx(anonRowTyIx(ai))
      sFieldStart.push(sFieldNames.length)
      sFieldCount.push(codes.length)
      // D622 — the canonical field order (`fieldNameOrder`): an `#anon` row's own dedup is
      // field-name keyed, so only the emitted sequence moves, letting it share a declared row's shape.
      const aOrd = fieldNameOrder(names)
      let pj = 0
      while pj < codes.length {
        const pi = aOrd[pj]
        sFieldNames.push(names[pi])
        sFieldTypes.push(codes[pi])
        // An anonymous literal's field has no annotation text to key a closure signature
        // from — "" is this recorder's honest answer, and the consumer reads it as unknown.
        sFieldCloSig.push("")
        sFieldElemName.push(elemNames[pi])
        // B6b — an anonymous literal's map field (code 19) carries a real key column, since an mv
        // slot's identity is the (key, value) pair and both come off the checker's recorded type.
        recordSFieldElemRow(elemNames[pi], elemKeys[pi]) // D5
        // A function-valued field (code 14) interns a closure cell, so flag the module to emit the
        // closure rec-group types even when no lambda is otherwise lifted (`{ f: inc }`).
        if codes[pi] == 14 { fnValUsed = true }
        // (A code-4 i32-list field always rides an ArrayLit value, which the
        // later `collectA` arena scan classifies — `lUsed`/`aUsed` set there.)
        pj = pj + 1
      }
      // A value-union field interns its box reps here, since this mint skips `pushFieldRow`; D804's
      // leaf set is named nowhere else, so without it `struct.new` builds a raw scalar, not a box.
      let rj = 0
      while rj < codes.length {
        if codes[rj] == 16 { registerValueUnionName(elemNames[rj]) }
        rj = rj + 1
      }
    }
  }
  0
}

// D391 — mints the nested rows of a polymorphic owner field set first, breaking a circularity:
// `anonValueFitsField` can only refute two same-fieldset literals' mismatched code-15 targets
// once both target names are known, so an unminted second nested literal matches the first
// owner's row by default and one owner builds a box typed as the other's row.
function anonNestPolyPremint(nestOwner: i32[]) {
  let xi = 0
  while xi < P.nodes.length {
    const xn = P.nodes[xi]
    if xn is ObjLit {
      // Only an arm-claimed nested literal (one the main loop would skip), and only where the
      // owner is a would-be anonymous row a sibling would otherwise absorb it into.
      if structIndexOfObj(xi) < 0 && objVariantName(xi) != "" {
        const ow = anonNestOwnerOf(xi, nestOwner)
        if ow >= 0 && structIndexOfObj(ow) < 0 && objVariantName(ow) == "" {
          const fname = anonNestFieldNameOf(ow, xi)
          // The trigger: a sibling owner shares the field-name set and disagrees about the nested
          // layout — except where the owners are joined into a box (D672), which must mint no row here.
          if (
            fname != "" &&
            !anonNestFieldMono(ow, fname, xi) &&
            anonNestPolyUnionName(ow, fname, xi) == ""
          ) {
            anonMintRowFor(xi)
          }
        }
      }
    }
    xi = xi + 1
  }
  0
}

// D672 — the declared union an owner field's polymorphic nested values are arms of, or "" when
// this literal is not that shape; when it answers, the owner's field is coded 16 over that
// union. Without a declaration each owner gets its own monomorphic row and the `??` default
// targets the other arm's row, so this mints the row a declaration would have.
function anonNestPolyUnionName(ow: i32, fname: string, inner: i32): string {
  if inner < 0 { return "" }
  const iv = P.nodes[inner]
  if !(iv is ObjLit) { return "" }
  if structIndexOfObj(inner) >= 0 { return "" }
  const armNm = objVariantName(inner)
  if armNm == "" { return "" }
  if anonNestFieldMono(ow, fname, inner) { return "" }
  if !anonPolyOwnersJoined(ow, fname, inner) { return "" }
  const vi = variantIndexOf(armNm)
  if vi < 0 { return "" }
  let ui = 0
  while ui < unNames.length {
    if vi >= unVarStart[ui] && vi < unVarStart[ui] + unVarCount[ui] {
      return unNames[ui]
    }
    ui = ui + 1
  }
  ""
}

// ── the leaf twin of the nested polymorphic rung (D804) ──────────────────────
// The atom spelling of an anonymous literal's leaf field value — the member name it would
// carry inside a value union — or "" for a value this rung cannot name. Deliberately narrow:
// it declines the whole rung rather than risk a wrong refutation input.
function anonLeafAtomName(valIx: i32): string {
  if valIx < 0 { return "" }
  const vi = unwrapParen(valIx)
  const v = P.nodes[vi]
  if v is NullLit { return "null" }
  const c = anonFieldCode(valIx)
  if c == 0 {
    // Code 0 folds booleans and integers together; the union needs them apart.
    if isBoolLitExpr(vi) { return "boolean" }
    return "i32"
  }
  if c == 3 { return "string" }
  if c == 17 { return "f64" }
  if c == 23 { return "i64" }
  if c == 24 { return "f32" }
  ""
}

// D804 — are the leaf owners joined into one value? The scalar twin of `anonPolyOwnersJoined`:
// a `??` makes its two operands one value, so a pair disagreeing at a field cannot keep two
// rows and the box is the only shared rep. Two literals that merely both exist need two rows
// (D391's shape), which is why the gate is on the join.
function anonLeafOwnersJoined(ow: i32, fname: string, owAtom: string): boolean {
  let qi = 0
  while qi < P.nodes.length {
    const qn = P.nodes[qi]
    if qn is BinExpr {
      if qn.binOp == "??" {
        const d = unwrapParen(qn.binRight)
        // This literal is the `??` default: whatever the other operand's shape came from
        // (a map value, a binding, a call), the coalesce has to deliver one row.
        if d == ow { return true }
        if d >= 0 {
          const dn = P.nodes[d]
          if dn is ObjLit {
            if anonObjFieldSetEq(d, ow) {
              if anonLeafAtomName(objFieldVal(d, fname)) != owAtom {
                return true
              }
            }
          }
        }
      }
    }
    qi = qi + 1
  }
  false
}

// D804 — the value-union member set a `??`-joined family of same-field-set literals needs at
// leaf field `fname`, or "" when this literal is not that shape; when it answers, the field
// is coded 16 over that set. `structIndexOfObj` merges same-fieldset literals by name alone,
// so building the set from every sibling's atom is what lets one merged row cover them all.
function anonLeafPolyUnionSet(ow: i32, fname: string, val: i32): string {
  // D833 — a literal a row already claims asks the question too, when a `??` names it; the
  // gate still ends the rung for a literal the join does not name, which keeps its own row.
  if structIndexOfObj(ow) >= 0 && !anonLeafInJoin(ow) { return "" }
  const set = anonLeafPolyUnionSetOpen(ow, fname, val)
  if set == "" { return "" }
  // A row that already holds this family — the declared spelling of the shape, or the row a
  // sibling family minted. Nothing to mint; `anonLeafMergeField` records the redirect.
  if anonLeafServingRow(ow, fname, set) >= 0 { return "" }
  set
}

// D901 — is the `??` that joins this family reading a container? Then the merged row has a
// second consumer wanting a different field type, and the box is the only rep serving both:
// a map value slot is keyed by the checker's type, which the fold does not move, so one row
// cannot hold one field at two codes. The scan mirrors `anonLeafOwnersJoined`'s, arm for arm.
function anonLeafJoinLhsIndexed(
  ow: i32,
  fname: string,
  owAtom: string,
): boolean {
  let qi = 0
  while qi < P.nodes.length {
    const qn = P.nodes[qi]
    if qn is BinExpr {
      if qn.binOp == "??" {
        let names = false
        const d = unwrapParen(qn.binRight)
        if d == ow { names = true }
        if d >= 0 {
          const dn = P.nodes[d]
          if dn is ObjLit {
            if anonObjFieldSetEq(d, ow) {
              if anonLeafAtomName(objFieldVal(d, fname)) != owAtom {
                names = true
              }
            }
          }
        }
        if names {
          const lh = P.nodes[unwrapParen(qn.binLeft)]
          if lh is Index { return true }
        }
      }
    }
    qi = qi + 1
  }
  false
}

// D901 — the one atom the checker's join leaves, or "" when the set really is a union.
// `joinTys` is `assignable`-driven, so a lossless-widening pair (`{r: i32}` joined with
// `{r: f64}`) is one type, not a union — folding anything but an `i32`/wider pair risks a
// mint/read disagreement, since `anonLeafAtomName` has no destination to widen a bare float by.
function anonLeafFoldedAtom(atoms: string[]): string {
  if atoms.length != 2 { return "" }
  if atoms[0] == "i32" {
    if atoms[1] == "i64" || atoms[1] == "f64" { return atoms[1] }
  }
  if atoms[1] == "i32" {
    if atoms[0] == "i64" || atoms[0] == "f64" { return atoms[0] }
  }
  ""
}

// The merged member set itself, with no question asked about who already holds it — the half
// `anonLeafMergeField` needs before it can look for a holder, and the half the caller above
// needs after. See `anonLeafPolyUnionSet` for the gates.
function anonLeafPolyUnionSetOpen(ow: i32, fname: string, val: i32): string {
  const owAtom = anonLeafAtomName(val)
  if owAtom == "" { return "" }
  if objVariantName(ow) != "" { return "" }
  const owFam = anonLeafFamRowOf(ow)
  const atoms: string[] = []
  atoms.push(owAtom)
  let qi = 0
  while qi < P.nodes.length {
    if qi != ow {
      const qn = P.nodes[qi]
      if qn is ObjLit {
        if anonObjFieldSetEq(qi, ow) {
          // A claimed sibling contributes its atom only when a `??` names it and both join the same
          // superseded row — read as a mark, not "is it claimed now", so the set cannot drift mid-loop.
          if (
            structIndexOfObj(qi) < 0 ||
            (anonLeafInJoin(qi) && owFam >= 0 && anonLeafFamRowOf(qi) == owFam)
          ) {
            if objVariantName(qi) == "" {
              const qa = anonLeafAtomName(objFieldVal(qi, fname))
              if qa == "" { return "" }
              let seen = false
              let ai2 = 0
              while ai2 < atoms.length {
                if atoms[ai2] == qa { seen = true }
                ai2 = ai2 + 1
              }
              if !seen { atoms.push(qa) }
            }
          }
        }
      }
    }
    qi = qi + 1
  }
  // D872 — and the atom the `??`'s left operand is declared to have, appended last and
  // deduped: for a one-literal family it is the only other atom there is.
  const annAtom = anonLeafAnnAtomOf(anonLeafAnnTyOf(ow), fname)
  if annAtom != "" {
    if (
      anonLeafAtomAdmits(annAtom, atoms) &&
      anonLeafAnnAtomJoins(annAtom, atoms)
    ) {
      let seenA = false
      let ak = 0
      while ak < atoms.length {
        if atoms[ak] == annAtom { seenA = true }
        ak = ak + 1
      }
      if !seenA { atoms.push(annAtom) }
    }
  }
  if atoms.length < 2 { return "" }
  if !anonLeafOwnersJoined(ow, fname, owAtom) { return "" }
  // D901 — a pair the checker's join folds to one type is not a union, and minting a box
  // over it traps (`anonLeafFoldedAtom`).
  const folded = anonLeafFoldedAtom(atoms)
  if folded != "" {
    if (
      !anonLeafJoinLhsIndexed(ow, fname, owAtom) &&
      !anonLeafFoldBlocked(ow, fname, 0, nameFieldCode(folded))
    ) {
      return folded
    }
  }
  // `null` last, so the set reads the way the declared spelling of the same shape does
  // (`{ r: i32 | null }`) and two literals minting in either order key one set.
  let out = ""
  let hasNull = false
  let k = 0
  while k < atoms.length {
    if atoms[k] == "null" {
      hasNull = true
    } else {
      if out != "" { out = out + "|" }
      out = out + atoms[k]
    }
    k = k + 1
  }
  if hasNull {
    if out != "" { out = out + "|" }
    out = out + "null"
  }
  out
}

// The field code a merged leaf set gets, asked of the same speller a declaration asks
// (`nameFieldCode`), since a minted row must be indistinguishable from a user-written one.
// Only codes whose companion column this mint can fill are admitted (16, 20, 30, the two
// folded scalars 17/23, and 21); anything else answers -1 and keeps `anonFieldCode`'s.
function anonLeafPolyFieldCode(set: string): i32 {
  const c = nameFieldCode(set)
  if c == 16 || c == 20 { return c }
  // D884 — and 30, the `K | null` niche: its companion column records the non-null alias
  // name, the same recording `pushFieldRow`'s declared path makes (`fieldRecElemName`).
  if c == 30 { return c }
  // D901 — and the two plain scalar codes a folded set can spell, `i64` (23) or `f64` (17):
  // `anonLeafFoldedAtom` only ever widens to those, and nothing widens into i32/boolean/string/f32.
  if c == 17 || c == 23 { return c }
  // D902 — and 21, the `boolean | null` sentinel: without it a joined `null` operand has no
  // rep at all, since the field falls back to plain boolean and `pendingNulBool` never fires.
  if c == 21 { return c }
  -1
}

// D672 — are the two owners joined into one value? True when this owner, or a disagreeing
// same-field-set sibling, is the default of a `??`. Two owners merely both present (D391's
// shape) are not joined and keep two rows — the gate is on the join, not the disagreement,
// which both shapes have. Deliberately just `??`: a general join would claim rows not this one's.
function anonPolyOwnersJoined(ow: i32, fname: string, inner: i32): boolean {
  let qi = 0
  while qi < P.nodes.length {
    const qn = P.nodes[qi]
    if qn is BinExpr {
      if qn.binOp == "??" {
        const d = unwrapParen(qn.binRight)
        if d == ow { return true }
        if d >= 0 {
          const dn = P.nodes[d]
          if dn is ObjLit {
            if anonObjFieldSetEq(d, ow) {
              const dv = unwrapParen(objFieldVal(d, fname))
              if dv >= 0 {
                const dvn = P.nodes[dv]
                if dvn is ObjLit {
                  if !anonObjFieldSetEq(dv, inner) { return true }
                }
              }
            }
          }
        }
      }
    }
    qi = qi + 1
  }
  false
}

// The literal that owns `objIx` as one of its field values, read out of the owner map
// `nestOwner` built by `collectAnonShapes` — or -1 when the literal is not nested in
// another one. Split out so the gate below reads as one question.
function anonNestOwnerOf(objIx: i32, nestOwner: i32[]) {
  if objIx < 0 { return -1 }
  if objIx >= nestOwner.length { return -1 }
  nestOwner[objIx]
}

// Should a literal that `objVariantName` claimed still get an anonymous row? That scan is
// context-free ("some union arm has this field-name set"), right for a literal the emitter
// really boxes but wrong for one in a position nothing boxes — the field value of another
// literal that is itself getting an anonymous row (D179), whose inline shape nothing boxes.
function anonNestNeedsRow(objIx: i32, nestOwner: i32[]) {
  const ow = anonNestOwnerOf(objIx, nestOwner)
  if ow < 0 { return false }
  if structIndexOfObj(ow) >= 0 { return false }
  if objVariantName(ow) != "" { return false }
  const fname = anonNestFieldNameOf(ow, objIx)
  if fname == "" { return false }
  anonNestFieldMono(ow, fname, objIx)
}

// The field NAME under which `inner` sits in `ow`. "" when it does not (which
// `anonNestOwnerOf` has already ruled out, so the empty answer is a decline, not a case).
function anonNestFieldNameOf(ow: i32, inner: i32) {
  const o = P.nodes[ow]
  if o is ObjLit {
    let i = 0
    while i < o.objFields.length {
      const f = P.nodes[o.objFields[i]]
      if f is FieldInit {
        if unwrapParen(f.fiValue) == inner { return f.fiName }
      }
      i = i + 1
    }
  }
  ""
}

// Do two object literals set the same field names? The key `structIndexOfObj` matches a
// literal to a row on, asked between two literals.
function anonObjFieldSetEq(aIx: i32, bIx: i32) {
  const a = P.nodes[aIx]
  const b = P.nodes[bIx]
  if a is ObjLit {
    if b is ObjLit {
      if a.objFields.length != b.objFields.length { return false }
      let i = 0
      while i < a.objFields.length {
        const f = P.nodes[a.objFields[i]]
        if f is FieldInit {
          if objFieldVal(bIx, f.fiName) < 0 { return false }
        } else {
          return false
        }
        i = i + 1
      }
      return true
    }
  }
  false
}

// D391 — would the owner's row be monomorphic at this field, the condition that makes
// minting the nested row safe? `structIndexOfObj` matches by field-name set, so the moment
// two literals share it and disagree about the nested layout at `fname`, neither can have its
// own anonymous row — that disagreement is exactly what the union box exists for.
function anonNestFieldMono(ow: i32, fname: string, inner: i32) {
  let qi = 0
  while qi < P.nodes.length {
    if qi != ow {
      const qn = P.nodes[qi]
      if qn is ObjLit {
        if anonObjFieldSetEq(qi, ow) {
          const qv = unwrapParen(objFieldVal(qi, fname))
          if qv < 0 { return false }
          const qvn = P.nodes[qv]
          if qvn is ObjLit {
            if !anonObjFieldSetEq(qv, inner) { return false }
          } else {
            return false
          }
        }
      }
    }
    qi = qi + 1
  }
  true
}

// The type name to record for one generic-alias field: the annotation as canon'd, except
// where the field's type is a type parameter, where it is the declared spelling instead.
// `canonEmitTypeNames` has no scope, so inside `type Box<Id> = { v: Id }` it resolves `Id`
// through the declared registry rather than as the parameter; `gaeAnnHasParam` keeps this narrow.
function gaeDeclFieldTyName(nodeIx: i32, canoned: string, pnames: string[]) {
  const raw = declAnnRawTyName(nodeIx)
  if raw == "" { return canoned }
  if !gaeAnnHasParam(raw, pnames) { return canoned }
  raw
}

// Record every generic-alias declaration into the registry.
function gaeCollectDecls(stmts: i32[]) {
  gaeBases = []
  gaeParams = []
  gaeFieldStart = []
  gaeFieldCount = []
  gaeFieldNames = []
  gaeFieldTyNames = []
  let i = 0
  while i < stmts.length {
    const s = P.nodes[stmts[i]]
    if s is TypeDecl {
      // The generic-application span test (`annGenAppSpanEnds`); this site stores the raw
      // parameter text (`gaeHeadNameOf`/`gaeArgsTextOf`), split later at `gaeEnsure`.
      if annGenAppSpanEnds(s.tdName) {
        const lt = gaeLtAt(s.tdName)
        gaeBases.push(gaeHeadNameOf(s.tdName, lt))
        const ptext = gaeArgsTextOf(s.tdName, lt)
        gaeParams.push(ptext)
        // The parameter names, needed here (not only at `gaeEnsure`) so a field whose type
        // is a parameter can be recorded as declared rather than as canon resolved it.
        const pnames: string[] = []
        gaeSplitArgs(ptext, pnames)
        gaeFieldStart.push(gaeFieldNames.length)
        let cnt = 0
        const fields = s.tdFields
        let fi = 0
        while fi < fields.length {
          const fnode = P.nodes[fields[fi]]
          if fnode is FieldDef {
            let tname = ""
            if fnode.fdType >= 0 {
              const ftn = P.nodes[fnode.fdType]
              if ftn is TypeRef { tname = ftn.tyName }
              tname = gaeDeclFieldTyName(fnode.fdType, tname, pnames)
            }
            gaeFieldNames.push(fnode.fdName)
            gaeFieldTyNames.push(tname)
            cnt = cnt + 1
          }
          fi = fi + 1
        }
        gaeFieldCount.push(cnt)
      }
    }
    i = i + 1
  }
  0
}

// Peels the composition wrappers a generic application can sit behind — `| null` and any
// number of trailing `[]` — leaving the bare name `gaeEnsure` can intern (`Box<i32>[] | null`
// → `Box<i32>`); unchanged for a name with no wrapper. `nm.length > 2` guards the degenerate
// `"[]"`, whose raw cut is "".
function gaePeelWrappers(name: string) {
  let nm = nonNulBaseOf(name)
  while nm.length > 2 && nameIsArray(nm) { nm = arrElemNameRaw(nm) }
  nm
}

// The registry slot of generic-alias base `name`, or -1. The home is here since this file
// writes the registry (`gaeCollectDecls`), and it is the lowest module that can see
// `gaeBases` at all — `emit_classify.gaeIndexOf` is a second copy of this loop, not yet
// routed here.
function gaeBaseSlot(name: string) {
  let i = 0
  while i < gaeBases.length {
    if gaeBases[i] == name { return i }
    i = i + 1
  }
  -1
}

// Interns the inline shapes an application's substituted field types name, before `gaeEnsure`
// codes those fields: a monomorphized generic-alias field is the one kind no arena scan can
// reach, since `Box<T> = {v: {a: T}}` at `Box<string>` names `{a:string}`, a text appearing
// nowhere in the program, so `gaeEnsure` would otherwise find no struct row and decline it.
function gaeInternAppFieldShapes(name: string) {
  if !annGenAppSpanEnds(name) { return 0 }
  const ltAt = gaeLtAt(name)
  // Both halves of the generic-application cut at their home (`gaeHeadNameOf`/`gaeArgsTextOf`),
  // given the `<` the line above found.
  const gi = gaeBaseSlot(gaeHeadNameOf(name, ltAt))
  if gi < 0 { return 0 }
  const pnames: string[] = []
  gaeSplitArgs(gaeParams[gi], pnames)
  const args: string[] = []
  gaeSplitArgs(gaeArgsTextOf(name, ltAt), args)
  if args.length != pnames.length { return 0 }
  const fs = gaeFieldStart[gi]
  const fc = gaeFieldCount[gi]
  let fi = 0
  while fi < fc {
    // `internShapeDeep` peels the composition wrappers itself and descends a map value, so
    // `{a: T}[]` and `{a: T[]}` are covered by the same call; a non-shape substitution is a no-op.
    internShapeDeep(gaeApplyFieldTy(gaeFieldTyNames[fs + fi], pnames, args))
    fi = fi + 1
  }
  0
}

// Scan every TypeRef in the arena for generic-alias applications (behind
// `|null` and `[]` wrappers) and intern each one.
export function collectGenAliasShapes() {
  if gaeBases.length == 0 { return 0 }
  let ti = 0
  while ti < P.nodes.length {
    const tn = P.nodes[ti]
    if tn is TypeRef {
      const nm = gaePeelWrappers(tn.tyName)
      // The instance's own inline-shape field targets first — `gaeEnsure` codes a field
      // from the struct table and declines the whole instance when the target is not in it.
      gaeInternAppFieldShapes(nm)
      gaeEnsure(nm)
      // A map annotation's value position (`{[string]: Box<i32>}`) is interior to the synthetic
      // map name, so the peel above misses it; interning it here makes the map spelling self-sufficient.
      const mv = mapValNameOf(nm)
      if mv != "" { gaeEnsure(gaePeelWrappers(mv)) }
    }
    ti = ti + 1
  }
  0
}

// Interns the own canonical render of the union arm a field type names (`g: Circle`,
// `g: Circle | null`), so `armFieldStructRow` has a row to answer with. A no-op for every
// other spelling; see the call site for why it is demand-driven and costs no heap type.
function internArmFieldShape(fdNm: string) { internArmShapeAt(fdNm, 0) }

// The composition peel, mirroring `internShapeDeep`'s: grouping parens, a trailing `| null`,
// trailing `[]` runs, and a map value, to any depth. An arm reached through a container needs
// its row for the same reason a bare one does — `{[string]: Circle[]}` is the map-and-list
// dual of `g: Circle`. Depth-bounded: a bug in one of the cuts must not recurse forever.
function internArmShapeAt(nm: string, depth: i32) {
  if depth > 8 { return 0 }
  if nm == "" { return 0 }
  const base = nonNulBaseOf(nm)
  if base != nm { return internArmShapeAt(base, depth + 1) }
  if nameIsArray(nm) { return internArmShapeAt(arrElemNameRaw(nm), depth + 1) }
  const mv = mapValNameOf(nm)
  if mv != "" { return internArmShapeAt(mv, depth + 1) }
  internArmShapeOf(nm)
}

function internArmShapeOf(nm: string) {
  const vi = variantIndexOf(nm)
  if vi < 0 { return 0 }
  if vi >= uVarTyIx.length { return 0 }
  const aty = uVarTyIx[vi]
  if aty < 0 { return 0 }
  // D34 — no arena hint: banking `tyIx` into `sTyIx` would make `structIndexOfTy` answer this
  // row for the arm's own node, turning off D34's decline module-wide. Found structurally instead.
  internInlineShape(armMintShapeName(tyToEmitName(aty)))
  0
}

// Interns every inline-shape struct field type (`type Box = { inner: {x:i32} }`) depth-first
// before the struct decls that reference it, so `collectS`'s main loop can resolve the nested
// shape (`internInlineShape` shares the flat `sField*` arrays and cannot run mid-loop). A no-op
// for a non-shape name and idempotent, so a program with none is unaffected.
function collectNestedFieldShapes(stmts: i32[]) {
  let i = 0
  while i < stmts.length {
    emitCurStmtIx = stmts[i] // the declaration cursor (D1519 — see `collectU`)
    const s = P.nodes[stmts[i]]
    if s is TypeDecl {
      // D1518 — the arm-field mint below is not gated on the owner: it answers for the field's
      // target, which a declaration that is itself a union arm shares with an ordinary owner.
      const ownsRow = variantIndexOf(s.tdName) < 0 && gaeLtAt(s.tdName) < 0
      const fields = s.tdFields
      let fi = 0
      while fi < fields.length {
        const fnode = P.nodes[fields[fi]]
        if fnode is FieldDef {
          if ownsRow {
            // `internShapeDeep` peels composition wrappers and descends a map field's value, so a
            // declared nullable-map field's value struct interns before `collectS` codes the field.
            let fdRoot = -1
            const fdNm = tyNameOf(fnode.fdType)
            if !nameMentionsGenAliasParam(fdNm) {
              if canonRewroteNode(fnode.fdType) {
                fdRoot = canonTyIxOf(fnode.fdType)
              } else {
                fdRoot = nodeTyIxOf(fnode.fdType)
              }
            }
            internShapeDeepTy(tyNameOf(fnode.fdType), fdRoot)
          }
          // D280 — a field typed as a union arm stores through the struct row the arm shares
          // (`armFieldStructRow`); interning the arm's own render mints it at no extra heap type.
          internArmFieldShape(tyNameOf(fnode.fdType))
        }
        fi = fi + 1
      }
    }
    i = i + 1
  }
  emitCurStmtIx = -1
  0
}

// The one home of the declared-field element-name recording: the name a `FieldDef`'s
// annotation node `tyIx` (already coded `code`) records into `sFieldElemName`/`uFieldElemName`.
// `fieldRefElemName` answers every code but 0 and 30, for which the atom name comes from the
// annotation's own spelling instead — the two arms `collectS` and `collectVariantFields` share.
function fieldRecElemName(tyIx: i32, code: i32) {
  const en = fieldRefElemName(tyIx)
  // A literal-union atom field (code 0) records its union name (not the ref-elem name,
  // which is "" for it) so `sFieldIsLitUnion` recovers the atom rep + membership.
  if code == 0 {
    // The litunion test off the row (B290): `annRowOfNode` reads canon's banked row where
    // canon rewrote the spelling. Dual-written: 932 reaches, 0 disagreements.
    const ftn = tyNameOf(tyIx)
    if tyIsLitUnion(annRowOfNode(tyIx)) { return ftn }
    return en
  }
  // The string-slot inline literal-union field: the recorded name must be the member set, not
  // the annotation's spelling, since canon softens a bare inline set to `string` at `RC_ROOT`.
  if code == 3 {
    const luN = litUnionInlineNameOfTy(nodeTyIxOf(tyIx))
    if luN != "" { return luN }
    return en
  }
  // A nullable-litunion niche field (code 30) records the non-null union name — the
  // code-0 recording over the `| null`-stripped part.
  if code == 30 { return nulLitUnionInnerName(tyNameOf(tyIx)) }
  en
}

// The one home of the field-row push: appends one field's parallel-column entries to the
// struct table (`toVariant` false, `tyText` unused) or variant table (true), then runs the two
// shared side effects (the code-16 value-union intern, the scalar-list wrapper/backing force).
// Push order matters: the D5 sidecar pads against `*FieldElemName.length`.
function pushFieldRow(
  toVariant: boolean,
  code: i32,
  elemNm: string,
  keyI32: boolean,
  fName: string,
  tyText: string,
  elemTyHint: i32,
  litTyIx: i32,
  cloSig: string,
) {
  if toVariant {
    uFieldTypes.push(code)
    uFieldTyText.push(tyText)
    // D1023 — the discriminant column: the field's own arena type when it is a literal set, -1
    // otherwise. Pushed here, not per recorder, so no column drifts out of parallel across the three.
    uFieldLitTyIx.push(litSetTyIxOf(litTyIx))
    uFieldElemName.push(elemNm)
    recordUFieldElemRowTy(elemNm, keyI32, elemTyHint) // D5 + B6b
    uFieldNames.push(fName)
  } else {
    sFieldTypes.push(code)
    sFieldElemName.push(elemNm)
    sFieldCloSig.push(cloSig)
    recordSFieldElemRowTy(elemNm, keyI32, elemTyHint) // D5 + B6b
    sFieldNames.push(fName)
  }
  // A value-union field interns its box reps here (shared by all three recorders); without it
  // `struct.new` builds a raw scalar where the box `(ref)` is required.
  if code == 16 { registerValueUnionName(elemNm) }
  // A scalar-list field (`f: i64[]`) forces its backing + wrapper pair: a field may be the
  // type's only mention, with no standalone `i64[]` TypeRef to set the flag.
  forceScalarListField(code)
  0
}

// ── struct-type collection ───────────────────────────────────────────────────
// Scans top-level statements for every struct `type` declaration into the flat multi-struct
// table; each interns its own WasmGC struct heap type, and a field whose type has no code
// fails loudly. Then runs the shape passes in order. Returns 0, or -1 (via `emitFail`).
export function collectS(stmts: i32[]) {
  sDeclared = false
  // The per-program literal-resolution memo keys node indices against this table —
  // both are program-scoped, so it resets with the table.
  sioMemoReset()
  // D833's three columns are keyed against this program's tree and row table; a stale entry
  // would hand the next program's map a row from this one, so they reset with the memo.
  anonLeafJoined = []
  anonLeafFamRow = []
  anonLeafAnnTy = []
  anonLeafParamMoved = []
  anonLeafRetMoved = []
  anonLeafCloSlotFn = []
  anonLeafCloBindName = []
  anonLeafCloBindFn = []
  anonLeafSupersede = []
  // D1514 — keyed by arena node and by sid, both dense from zero, so a surviving row would
  // answer the next program with this one's nodes.
  anonIxOn = false
  anonIxSeen = 0
  // The struct-row name index keys this table's spellings — reset it with the table, or the
  // next program's rows answer with this one's names.
  structNameIxReset()
  shapeSetIxReset()
  structTyIxReset()
  sNames = []
  sRowDecl = []
  sTyIx = []
  sFieldNames = []
  sFieldStart = []
  sFieldCount = []
  sFieldTypes = []
  sFieldElemName = []
  sFieldCloSig = []
  sFieldElemTyIx = []
  sFieldElemKeyI32 = []
  // Nested inline-shape field types intern first, so the struct decls that reference them resolve.
  collectNestedFieldShapes(stmts)
  // A `type X = {…}` that is a union variant is collected by `collectU` instead, not here; any
  // other struct type (declared alongside a union) is a standalone struct interned here.
  let i = 0
  while i < stmts.length {
    emitCurStmtIx = stmts[i] // the declaration cursor (D1519 — see `collectU`)
    const s = P.nodes[stmts[i]]
    // A struct-alias union decl (a single inline-shape variant) is a plain named struct: intern
    // it here, since `collectU` skipped it.
    if s is UnionDecl {
      const aliasShape = unionStructAliasShape(s.udVariants)
      if aliasShape != "" {
        if internShapeAs(s.udName, aliasShape) < 0 { return -1 }
      }
    }
    // A union variant `TypeDecl` belongs to the variant table, not here; a generic alias
    // declaration has no concrete shape, its applications intern via `collectGenAliasShapes`.
    if s is TypeDecl {
      if variantIndexOf(s.tdName) < 0 && gaeLtAt(s.tdName) < 0 {
        sDeclared = true
        sNames.push(s.tdName)
        recordSRowDeclOfName(s.tdName)
        recordSTyIx(sTyIxOfName(s.tdName)) // D0
        sFieldStart.push(sFieldNames.length)
        const fields = s.tdFields
        // D622 — field order is canonical, ascending by field name (`fieldNameOrder`), since two
        // permuted declarations of one shape must collapse to one heap type; `tdFlat` is the
        // exception (its order is its layout).
        const fOrder: i32[] = []
        let fq = 0
        while fq < fields.length {
          fOrder.push(fields[fq])
          fq = fq + 1
        }
        if s.tdFlat == 0 {
          const fnames: string[] = []
          let fp = 0
          while fp < fields.length {
            const fpn = P.nodes[fields[fp]]
            if fpn is FieldDef { fnames.push(fpn.fdName) }
            fp = fp + 1
          }
          if fnames.length == fields.length {
            const bOrd = fieldNameOrder(fnames)
            let rw = 0
            while rw < bOrd.length {
              fOrder[rw] = fields[bOrd[rw]]
              rw = rw + 1
            }
          }
        }
        let cnt = 0
        let fi = 0
        while fi < fOrder.length {
          const fnode = P.nodes[fOrder[fi]]
          if fnode is FieldDef {
            const code = fieldTypeCode(fnode.fdType)
            if code < 0 {
              // The field's own spelling, so the refusal can name what it refused (`fieldTypeRefusalMsg`,
              // D734); a non-`TypeRef` annotation takes the general sentence.
              let fdNm = ""
              const fdT = P.nodes[fnode.fdType]
              if fdT is TypeRef { fdNm = fdT.tyName }
              return emitFail(fieldTypeRefusalMsg(fdNm))
            }
            // The recorded elem name is `fieldRefElemName`'s answer at code 16 (neither of
            // `fieldRecElemName`'s two arms fires), so `pushFieldRow`'s intern reads the same value.
            const recNm = fieldRecElemName(fnode.fdType, code)
            // The last argument is the arena, not a render: `sigKeyOfTy` answers the closure-signature
            // key from the type it already has.
            pushFieldRow(
              false,
              code,
              recNm,
              nodeTyMapKeyIsI32Span(fnode.fdType),
              fnode.fdName,
              "",
              fieldElemHintOf(fnode.fdType, code, recNm),
              -1,
              fieldCloSigOfTy(code, nodeTyIxOf(fnode.fdType)),
            )
            // `nodeTyMapKeyIsI32Span`, not the exact twin: this column is the mv slot's key half,
            // and the span form is what matches `mapSpellKeyName`'s cut.
            cnt = cnt + 1
          } else {
            return emitFail("emitProgram: malformed struct field")
          }
          fi = fi + 1
        }
        sFieldCount.push(cnt)
      }
    }
    i = i + 1
  }
  // D1519 — the cursor is the declaration loop's and ends with it; the shape passes below walk
  // the arena, not `stmts`, so a confidently wrong position is worse than none — they stay positionless.
  emitCurStmtIx = -1
  // D1050 — gives a mixed-spelling pair one layout now both field tables are complete, before
  // the shape passes below re-lay a row a shape could otherwise twin onto.
  if unifyMixedLitRepArms() < 0 { return -1 }
  // Generic-alias application shapes next: the declared structs they may reference are
  // interned above, so their names resolve as code-15 struct-ref fields.
  gaeCollectDecls(stmts)
  collectGenAliasShapes()
  // Inline object-type annotation shapes first, so a literal whose values are
  // unclassifiable param reads (`{ x: n }`) still matches the annotation's shape.
  collectAnnShapes()
  collectAnonShapes()
}

// ── union collection (G1) ─────────────────────────────────────────────────────
// Parse the inline-shape variant `nm` (`{x:i32,y:string}`) into the flat
// union-variant field tables — the variant-table twin of `collectAnnShapes`'s
// field split (same depth-aware `,`/`:` grammar).
function collectShapeVariantFields(nm: string, shapeTy: i32) {
  const fnames: string[] = []
  const ftexts: string[] = []
  // The group-interior cut at its home (`tyname.groupInnerOf`, W1). The guard is the
  // caller's — `collectVariantFields` gates on `nameIsShapeSpanEnds`.
  shapeInnerFieldSplit(groupInnerOf(nm), fnames, ftexts)
  uFieldStart.push(uFieldNames.length)
  // D622 — the canonical field order, needed here too: cross-table twin tests compare codes
  // positionally, so a declaration-order arm can merge into a canonical twin's opposite slots.
  const cOrd = fieldNameOrder(fnames)
  let cnt = 0
  let fx = 0
  while fx < fnames.length {
    const fi = cOrd[fx]
    if fnames[fi] == "" {
      return emitFail("emitProgram: malformed inline union-variant shape")
    }
    const ftxt = ftexts[fi]
    // The arena rung, where the shape's own type supplies the field's recorded type; the length
    // guard keeps the correspondence legitimate — a count mismatch means `fi` is not the same field.
    let fldTy = -1
    if shapeTy >= 0 {
      const shp = T.tys[shapeTy]
      if shp is TyObj {
        if shp.objFieldTypes.length == ftexts.length {
          fldTy = shp.objFieldTypes[fi]
        }
      }
    }
    let fc = nameFieldCodeTy(ftxt, fldTy)
    if fc < 0 {
      // A nested-struct variant field: validated here only, since `collectU` runs before
      // `collectS`; `collectA`'s variant pass interns the shape once acceptance is decidable.
      if variantNestedShapeOk(nonNulBaseOf(ftxt)) { fc = 15 }
    }
    if fc < 0 {
      // D1518 — `fieldTypeRefusalMsg`'s sentence, one table over: what reaches here is an
      // arm-typed field whose arm has no cross-table heap twin.
      return emitFail(fieldTypeRefusalMsg(ftxt))
    }
    // `pushFieldRow`'s variant-table row; this recorder derives the elem name from the field's
    // type text (no `FieldDef` node exists here), and has no `sFieldCloSig` twin, hence the "" tail.
    pushFieldRow(
      true,
      fc,
      shapeFieldElemName(ftxt, fc),
      nameIsI32KeyedMap(ftxt),
      fnames[fi],
      variantFieldIdText(ftxt, fldTy),
      -1,
      fldTy,
      "",
    )
    cnt = cnt + 1
    fx = fx + 1
  }
  uFieldCount.push(cnt)
  0
}

// Record the field names + per-field wasm-type codes of the `TypeDecl` named `name` into the
// flat `uFieldNames`/`uFieldStart`/`uFieldCount`/`uFieldTypes` table (declaration order = wasm
// field index). The struct must exist among the top-level statements and every field must
// carry a code, else fails loudly. Returns 0, or -1 (via `emitFail`).
function collectVariantFields(stmts: i32[], name: string) {
  // An inline-shape variant (`{x:i32}` inside `{x:i32}|{y:i32}`) carries its
  // fields in its own text — parse them (the annotation-shape field grammar)
  // instead of looking for a TypeDecl.
  if nameIsShapeSpanEnds(name) {
    return collectShapeVariantFields(name, declTyIxOfName(name))
  }
  let i = 0
  while i < stmts.length {
    const s = P.nodes[stmts[i]]
    if s is TypeDecl {
      if s.tdName == name {
        uFieldStart.push(uFieldNames.length)
        const fields0 = s.tdFields
        // D622 — the canonical field order: cross-table twin tests compare field codes
        // positionally, so an arm and its declared struct twin must agree on the sequence.
        const fields: i32[] = []
        const vnames: string[] = []
        let vp = 0
        while vp < fields0.length {
          const vpn = P.nodes[fields0[vp]]
          if vpn is FieldDef { vnames.push(vpn.fdName) }
          vp = vp + 1
        }
        if s.tdFlat == 0 && vnames.length == fields0.length {
          const vOrd = fieldNameOrder(vnames)
          let vq = 0
          while vq < vOrd.length {
            fields.push(fields0[vOrd[vq]])
            vq = vq + 1
          }
        } else {
          let vr = 0
          while vr < fields0.length {
            fields.push(fields0[vr])
            vr = vr + 1
          }
        }
        let cnt = 0
        let fi = 0
        while fi < fields.length {
          const fnode = P.nodes[fields[fi]]
          if fnode is FieldDef {
            const ftxt = tyNameOf(fnode.fdType)
            const nodeCode = fieldTypeCode(fnode.fdType)
            let code = nodeCode
            if code < 0 {
              // A nested inline-shape variant field cannot code 15 yet (`collectU` runs before the struct
              // table exists); `collectA`'s variant pass interns it once acceptance is decidable, as above.
              if variantNestedShapeOk(nonNulBaseOf(ftxt)) { code = 15 }
            }
            if code < 0 {
              // The shape-text recorder's sentence, from the field's own node so the reader is pointed
              // at the field and not at the union (D1519's anchor).
              return emitFailAt(fieldTypeRefusalMsg(ftxt), fields[fi])
            }
            // The struct twin's ladder, except when the -1→15 fallback fired: then the name comes from
            // the field's type text (`shapeFieldElemName`), which `fieldRefElemName` cannot re-derive.
            let elemNm = shapeFieldElemName(ftxt, code)
            if nodeCode >= 0 { elemNm = fieldRecElemName(fnode.fdType, code) }
            // The variant table has no `sFieldCloSig` twin, so the trailing column is "".
            pushFieldRow(
              true,
              code,
              elemNm,
              nodeTyMapKeyIsI32Span(fnode.fdType),
              fnode.fdName,
              variantFieldIdText(ftxt, nodeTyIxOf(fnode.fdType)),
              fieldElemHintOf(fnode.fdType, code, elemNm),
              nodeTyIxOf(fnode.fdType),
              "",
            )
            // `fnode` is still in scope here, so the arena node is passed directly rather
            // than re-deriving it from `ftxt`'s string form.
            cnt = cnt + 1
          } else {
            return emitFail("emitProgram: malformed union-variant field")
          }
          fi = fi + 1
        }
        uFieldCount.push(cnt)
        return 0
      }
    }
    i = i + 1
  }
  emitFail("emitProgram: union variant names an unknown struct type")
}

// True if variants `a` and `b` are the same type per field — the field-type half of variant
// identity (`variantSig` is the name half); `assignTags`'s exemption depends on this being
// identity, not storage: `{a: i32}` and `{a: boolean}` share a wasm code but are different
// types, so the `uFieldTyText` spelling column, not just the code, decides.
function variantFieldTysEq(a: i32, b: i32) {
  if uFieldCount[a] != uFieldCount[b] { return false }
  let fi = 0
  while fi < uFieldCount[a] {
    if uFieldTypes[uFieldStart[a] + fi] != uFieldTypes[uFieldStart[b] + fi] {
      return false
    }
    if (
      uFieldTyText[uFieldStart[a] + fi] !=
      uFieldTyText[uFieldStart[b] + fi]
    ) {
      return false
    }
    if (
      uFieldElemName[uFieldStart[a] + fi] !=
      uFieldElemName[uFieldStart[b] + fi]
    ) {
      return false
    }
    // B6b — the map field's key half: the elem-name column above records only `V`, so two
    // differently-keyed maps compare equal there; this column catches it.
    if uFieldElemKeyI32At(a, fi) != uFieldElemKeyI32At(b, fi) { return false }
    fi = fi + 1
  }
  true
}

// D1050 — lays a mixed-spelling discriminated pair out under one rep: each field goes to
// the rep its arms can both hold — two sets meet on the atom (cheap, all consumers already
// built), a set beside its base meets on the string (an arbitrary string has no interned id).
// Two rows move per field either way: the variant row casts through, the struct row builds everywhere else.
function unifyMixedLitRepArms(): i32 {
  if !uDeclared { return 0 }
  let ui = 0
  while ui < unVarStart.length {
    const vs0 = unVarStart[ui]
    const vc = unVarCount[ui]
    let a = 0
    while a < vc {
      let b = a + 1
      while b < vc {
        const va = vs0 + a
        const vb = vs0 + b
        // The same gate `assignTags` admitted on, asked again rather than banked: the tag
        // key is the field-name set, so only a same-sig pair shares a layout at all.
        if variantSig(va) == variantSig(vb) && variantLitRepUnifiable(va, vb) {
          let fi = 0
          while fi < uFieldCount[va] {
            if variantFieldLitRepMixed(va, vb, fi) {
              if promoteLitFieldToAtom(va, fi) < 0 { return -1 }
              if promoteLitFieldToAtom(vb, fi) < 0 { return -1 }
            } else if variantFieldLitRepStrMixed(va, vb, fi) {
              // The demotion is a sink (the base arm is already a string), so a three-arm mix of an
              // alias, an inline set and the base converges on the string rep regardless of visit order.
              if demoteLitFieldToString(va, fi) < 0 { return -1 }
              if demoteLitFieldToString(vb, fi) < 0 { return -1 }
            }
            fi = fi + 1
          }
        }
        b = b + 1
      }
      a = a + 1
    }
    ui = ui + 1
  }
  0
}

// The elem-name column's answer for an atom-repped literal set. `litUnionInlineNameOfTy` has
// no answer below two members (`nameIsInlineLitUnion` wants two atoms), so a one-member set's
// quoted lexeme stands in as the row's name, and the sidecar (D1460) is what classifiers
// actually read.
function litSetAtomNameOfTy(lty: i32): string {
  const nm = litUnionInlineNameOfTy(lty)
  if nm != "" { return nm }
  const texts = tyLitMemberTexts(lty)
  if texts.length != 1 { return "" }
  const al = litUnionAliasOfLitTexts(texts)
  if al != "" { return al }
  "\"" + texts[0] + "\""
}

// Re-lays variant `vi`'s field `fi` — a string literal set — under the interned-atom rep, in
// both tables; a row already at code 0 (the alias arm) is untouched, so the pass is idempotent.
// The arena sidecar must move with the code, since `variantFieldIsLitUnion`/`sFieldIsLitUnion`
// read it to tell an interned atom from a plain i32 — its type comes from `uFieldLitTyIx`.
function promoteLitFieldToAtom(vi: i32, fi: i32): i32 {
  const r = uFieldStart[vi] + fi
  const lty = uFieldLitTyIx[r]
  if lty < 0 { return 0 }
  const nm = litSetAtomNameOfTy(lty)
  if nm == "" { return 0 }
  if uFieldTypes[r] != 0 {
    uFieldTypes[r] = 0
    uFieldElemName[r] = nm
    setUFieldElemRowTy(r, lty)
  }
  const si = structIndexOfTypeName(uVariants[vi])
  if si >= 0 && fi < sFieldCount[si] {
    const sr = sFieldStart[si] + fi
    if sFieldTypes[sr] != 0 {
      sFieldTypes[sr] = 0
      sFieldElemName[sr] = nm
      setSFieldElemRowTy(sr, lty)
    }
  }
  0
}

// Re-lays variant `vi`'s field `fi` — an atom-repped string literal set — under the string
// rep, in both tables; a row already at code 3 is untouched, so idempotent. The row lands
// exactly where a declared inline set's row already is, so no consumer needs a new arm:
// `emitDiscrimFieldEq`'s code-3 arm and `strReppedLitUnionAt` already handle it (D1460).
function demoteLitFieldToString(vi: i32, fi: i32): i32 {
  const r = uFieldStart[vi] + fi
  const lty = uFieldLitTyIx[r]
  if lty < 0 { return 0 }
  const nm = litUnionInlineNameOfTy(lty)
  if uFieldTypes[r] != 3 {
    uFieldTypes[r] = 3
    uFieldElemName[r] = nm
    setUFieldElemRowTy(r, lty)
  }
  const si = structIndexOfTypeName(uVariants[vi])
  if si >= 0 && fi < sFieldCount[si] {
    const sr = sFieldStart[si] + fi
    if sFieldTypes[sr] != 3 {
      sFieldTypes[sr] = 3
      sFieldElemName[sr] = nm
      setSFieldElemRowTy(sr, lty)
    }
  }
  0
}

// Assign each variant its GLOBAL tag = its rank when the variants are ordered by
// structural signature (`variantSig`, sorted). `uTags[i]` is variant i's tag: the
// number of variants whose sig sorts strictly before variant i's (sigs are distinct,
// so this is a dense 0..n-1 permutation).
export function assignTags() {
  // A swallowed `emitFail` can leave the variant row tables half-written, so ranking would read
  // past their end and trap the compiler; bail on the flag instead so the message reaches the user.
  if emitFailed { return -1 }
  // The signatures, computed once (the rank loop below reads each O(n) times, and a
  // variant-heavy union — the compiler's own `Node` — has dozens of them).
  const sigs: string[] = []
  let si = 0
  while si < uVariants.length {
    sigs.push(variantSig(si))
    si = si + 1
  }
  // Two members sharing a field-name set collide on `variantSig` (the tag key) unless they are
  // layout-equal, or D1023's `variantLitDiscriminable` admits a same-storage literal-set difference.
  let ui = 0
  while ui < unVarStart.length {
    const vs0 = unVarStart[ui]
    const vc = unVarCount[ui]
    let a = 0
    while a < vc {
      let b = a + 1
      while b < vc {
        if sigs[vs0 + a] == sigs[vs0 + b] {
          // D1050 — the third admission is the pair the atom unification will fix later, in
          // `unifyMixedLitRepArms` at the end of `collectS`, once both tables exist.
          if (
            !variantFieldTysEq(vs0 + a, vs0 + b) &&
            !variantLitDiscriminable(vs0 + a, vs0 + b) &&
            !variantLitRepUnifiable(vs0 + a, vs0 + b)
          ) {
            // D1461 — two refusals; only the design one (arms nothing tells apart) still describes a
            // real program. The other is an unreachable floor, since every mixed literal is re-laid.
            if variantLitRepMismatch(vs0 + a, vs0 + b) {
              return emitFail(
                "emitProgram: assignTags: union `" +
                  unNames[ui] +
                  "` gives `" +
                  uVariants[vs0 + a] +
                  "` and `" +
                  uVariants[vs0 + b] +
                  "` one tag while their literal discriminant at field `" +
                  variantFirstLayoutDisagreeField(vs0 + a, vs0 + b) +
                  "` is laid out two ways — `unifyMixedLitRepArms` re-lays a mixed pair onto one rep and did not reach this one, so this is a compiler bug rather than something to change in the program",
              )
            }
            return emitFail(
              "emitProgram: union `" +
                unNames[ui] +
                "` cannot be discriminated — variants `" +
                uVariants[vs0 + a] +
                "` and `" +
                uVariants[vs0 + b] +
                "` have the same field names but different field types",
            )
          }
        }
        b = b + 1
      }
      a = a + 1
    }
    ui = ui + 1
  }
  uTags = []
  let i = 0
  while i < uVariants.length {
    const sigI = sigs[i]
    let rank = 0
    let j = 0
    while j < uVariants.length {
      if j != i {
        if strLess(sigs[j], sigI) { rank = rank + 1 }
      }
      j = j + 1
    }
    uTags.push(rank)
    i = i + 1
  }
  0
}

// The six single-shape tests below call `emit_classify.nameIsWholeSpanShape` directly — no
// local wrapper is needed now that the walk it once required is gone.

// The one home of "a bare map's value union needs registering too" — the same rule four
// call sites in `registerInlineUnionAt` each spelled out separately. Returns -2 when the map
// has no value name (since `0` is `registerInlineUnion`'s success), else its `0`/`-1`; three
// callers test `!= -2` to know whether it fired, the fourth ignores the result.
function registerMapValUnion(stmts: i32[], mapName: string) {
  const mv = mapValNameOf(mapName)
  if mv == "" { return -2 }
  registerInlineUnionAt(stmts, mv, 29, -1)
}

// The one home of "the result atom of a closure spelling": strips grouping parens, takes the
// text after the top-level `=>`, and normalizes it as a union arm is. "" when there is no
// top-level arrow, which is also every caller's "not a closure" answer. The three steps
// compose in a fixed order: peel before the arrow scan, normalize after it.
function cloResultAtomOf(name: string) {
  normTypeAtom(annRetNameOf(peelGroupParens(name)))
}

// Registers the inline union synthetic name `name` (e.g. `"A|B"`) as a union alias, exactly
// as `collectU` registers a `UnionDecl`. A no-op if `name` is already registered or is not an
// inline struct-variant union. Returns 0, or -1 (via `emitFail`).
export function registerInlineUnion(stmts: i32[], name: string) {
  registerInlineUnionAt(stmts, name, 46, -1)
}

// Told which call site it is (`site`) and what identity that site can offer (`ty`, an arena
// type where the caller holds one, else -1). The recursions below hand -1 since a cut
// substring has no node; the key is obtained from canon for the sub-spelling instead
// (`docs/internals/registry-by-type-id.md` §5 step 4b), so an unarmed compile is byte-identical.
function registerInlineUnionAt(stmts: i32[], name: string, site: i32, ty: i32) {
  if isUNameKeyAB(site, name, ty) { return 0 }
  // A value union (`i32 | null`, `i32 | f64`) registers the name alone: its members are scalar
  // atoms riding shared value boxes, so it owns no variant structs and its slice is empty.
  if isValueUnionName(name) || nameIsLitUnionArmValueUnion(name) {
    return registerValueUnionName(name)
  }
  // A map member of a 2+-member union rides the variant box, registered via `isVariantBoxUnion`
  // below and returned early, or the map-value recursion further down would swallow the name.
  const matoms: string[] = []
  splitUnionAtoms(name, matoms)
  if matoms.length >= 2 {
    let mNonNull = 0
    let mHasMap = false
    let mk = 0
    while mk < matoms.length {
      const ma = matoms[mk]
      if ma != "null" {
        mNonNull = mNonNull + 1
        // Deliberately `nameIsMapOpen`, not `nameIsMap`: an arm that is a list of maps still opens
        // `{[`, so it must set this flag or the map-value recursion below swallows the union name.
        if nameIsMapOpen(ma) { mHasMap = true }
      }
      mk = mk + 1
    }
    // A single map + `null` is exempt (the nullable map, owned by the nullable machinery); only
    // a map alongside another non-null member is the box-union shape handled here.
    if mHasMap && mNonNull >= 2 {
      // Supported falls through to `isVariantBoxUnion` below; unsupported is a loud fail, never a
      // silent mis-tag. `matoms` reuses the split this predicate would otherwise redo.
      if !isVariantBoxUnionAtoms(stmts, matoms) {
        return emitFail(
          "emitProgram: a map union member is not supported — use a struct member instead",
        )
      }
    }
    // A ref-array atom's element union needs registration too, since it is not a standalone
    // annotation the recursions below would otherwise reach. Non-returning: the outer union
    // still registers through the dispatch below.
    let ak = 0
    while ak < matoms.length {
      const aa = matoms[ak]
      if aa != "null" && nameIsArray(aa) {
        registerInlineUnionAt(stmts, aa, 30, -1)
      }
      // A map atom's value union is a separate rep from the map arm (registered via
      // `isVariantBoxUnion`) and needs registering here too, the sibling of the ref-array recursion above.
      if aa != "null" && nameIsBareMap(aa) { registerMapValUnion(stmts, aa) }
      ak = ak + 1
    }
  }
  // A union used only as a collection element (`(C|S)[]`, `{[string]: C|S}`) still needs its
  // inner union registered, or a union appearing only inside a collection is never interned.
  const pun = parenUnionArrElemName(name)
  if pun != "" { return registerInlineUnionAt(stmts, pun, 31, -1) }
  // A nullable ref array's `| null` niche is owned elsewhere, but its inner element union still
  // needs registering — strip the `| null` and recurse on the ref-array name, hitting the `pun` path above.
  const rnp = nullablePartOf(name)
  if rnp != "" && nameIsRefArray(rnp) {
    return registerInlineUnionAt(stmts, rnp, 32, -1)
  }
  // A nullable inline shape's `| null` is owned elsewhere, but its field unions still need
  // registering — strip the `| null` and take the single-shape descent below.
  if rnp != "" && nameIsWholeSpanShape(rnp) {
    return registerInlineUnionAt(stmts, rnp, 33, -1)
  }
  // A nullable map's `| null` is owned elsewhere, but its value union still needs
  // registering — the nullable twin of the bare-map value recursion below.
  if rnp != "" && nameIsBareMap(rnp) {
    const nmr = registerMapValUnion(stmts, rnp)
    if nmr != -2 { return nmr }
  }
  // A nullable closure's inner value-union result still needs registration, gated to a pure
  // value union or a map-member union; any other composite result stays loud (would mis-lower).
  if rnp != "" && nameIsNulClosure(name) {
    const ncRes = cloResultAtomOf(rnp)
    if ncRes != "" {
      if isValueUnionName(ncRes) || nameIsMapMemberUnion(ncRes) {
        return registerInlineUnionAt(stmts, ncRes, 34, -1)
      }
      // A variant-box union result: the contextual pin covers it once registered, so the
      // annotated named-fn path lowers it; an arm `isVariantBoxUnion` still rejects stays loud.
      if isVariantBoxUnion(stmts, ncRes) {
        return registerInlineUnionAt(stmts, ncRes, 35, -1)
      }
      // A bare-map result needs no registration itself, but its value union does — the sibling
      // of the bare-map value recursion below and the map-atom walk above.
      if nameIsBareMap(ncRes) {
        const ncMr = registerMapValUnion(stmts, ncRes)
        if ncMr != -2 { return ncMr }
      }
      // An array result's element union needs registration even though the array itself does
      // not; the non-nullable closure result reaches this via the function-type arm below instead.
      if nameIsRefArray(ncRes) {
        return registerInlineUnionAt(stmts, ncRes, 36, -1)
      }
    }
  }
  // A nested array of an inline union: `parenUnionArrElemName` only matches a single `(…)[]`,
  // so strip the outer `[]` and recurse, bottoming out at the `pun` path above.
  if nameIsArray(name) {
    // The cut is `arrElemNameRaw`'s (#1175); the test half already belongs to the home.
    const inner = arrElemNameRaw(name)
    if nameIsArray(inner) { return registerInlineUnionAt(stmts, inner, 37, -1) }
    // A 1D array-of-inline-shape element's field unions are registered by
    // `collectTyReachRegister`'s structural walk instead; this call is a self-gated no-op for a
    // single shape, kept as the peel twin of `internShapeDeep`'s single-`[]` shape peel.
    if nameIsWholeSpanShape(inner) {
      return registerInlineUnionAt(stmts, inner, 38, -1)
    }
  }
  // A bare map's union value registers here; `matoms.length < 2` restricts this to a bare map
  // so a map-member union (which also matches `nameIsMap`) falls to the box path instead.
  if nameIsMap(name) && matoms.length < 2 {
    const mvr = registerMapValUnion(stmts, name)
    if mvr != -2 { return mvr }
  }
  // A function-type annotation's return union registers here so a value call's result narrows;
  // mirrors the array/map element recursion above.
  if nameIsParenOpen(name) {
    const fnRes = annRetNameOf(name)
    if fnRes != "" {
      return registerInlineUnionAt(stmts, normTypeAtom(fnRes), 39, -1)
    }
  }
  // An inline struct-shape annotation's unions live in its fields, interned before this call by
  // `collectTyReachRegister`'s structural walk — a single shape has none to register here.
  if nameIsWholeSpanShape(name) { return 0 }
  // The atom form again: `matoms` is still `splitUnionAtoms(name)` here — nothing between
  // the split at the top of this function and this line rewrites either `name` or `matoms`.
  if !isVariantBoxUnionAtoms(stmts, matoms) { return 0 }
  // The arms' field unions must already be registered before this point — an interleaved
  // registration would corrupt this union's variant slice — which the arena-driven walk guarantees.
  uDeclared = true
  unNamesPush(name)
  unTyIx.push(declTyIxOfName(name)) // B-1 step 1: resolve ONCE at mint, like `sTyIx`
  unKey.push(canonUnionKeyOfName(name)) // D-UNIONKEY: obtained from canon, never rendered
  unDeclIx.push(-1) // inline union: no declaration node
  unMemberSet.push(name)
  recordUnMemTys(name) // D-UNION foundation
  // The member list below is the row just recorded, not a second split of `name`:
  // `recordUnMemTys` already split it once, so this just reads the tail it appended.
  const atoms: string[] = []
  // Snapshotted in the same loop as the spellings, since the recursive registration below can
  // append to (or self-heal reset) the columns this reads from.
  const atomTys: i32[] = []
  const uRow = unNames.length - 1
  const uMemN = unMemTyCount[uRow]
  const uMemBase = unMemAtoms.length - uMemN
  let uMemI = 0
  while uMemI < uMemN {
    atoms.push(unMemAtoms[uMemBase + uMemI])
    atomTys.push(unMemTys[uMemBase + uMemI])
    uMemI = uMemI + 1
  }
  unVarStart.push(uVariants.length)
  // Only struct members occupy variant slots; a `null` rides the tag and a value-atom tags
  // via `scalarTagOf` into the shared value boxes.
  let nStructs = 0
  let cnt = 0
  while cnt < atoms.length {
    if atoms[cnt] != "null" {
      if isStructAtom(stmts, atoms[cnt]) { nStructs = nStructs + 1 }
    }
    cnt = cnt + 1
  }
  unVarCount.push(nStructs)
  let vi = 0
  while vi < atoms.length {
    if atoms[vi] != "null" {
      if isStructAtom(stmts, atoms[vi]) {
        uVariantsPush(atoms[vi])
        // The row `recordUnMemTys` already resolved, from this very atom — reusing it avoids
        // re-running the whole name-to-row ladder for an answer already in the parallel column.
        uVarTyIx.push(atomTys[vi])
        if collectVariantFields(stmts, atoms[vi]) < 0 { return -1 }
      }
    }
    vi = vi + 1
  }
  // A mixed union's scalar members box like a value union's — interns their per-rep value
  // boxes (a no-op for an all-struct union).
  markValueUnionAtoms(name)
  // A ref-array arm interns its element shape and reflist slot, the twin of the value-atom
  // marking above; this early call ensures the element struct is in `sNames` before heap assignment.
  markRefArrayArms(name)
  // A ref-array arm whose element is itself a union registers that inner union too, the
  // arm-position twin of the whole-name `parenUnionArrElemName` recursion above.
  let rai = 0
  while rai < atoms.length {
    const raa = atoms[rai]
    // The arena row is a necessary, not sufficient, condition: a non-array row decides the test
    // false without running `nameIsRefArray`'s ladder; an array row still runs the full name test.
    let raMaybe = true
    if rai < atomTys.length {
      const rr = atomTys[rai]
      if rr >= 0 {
        const rt = T.tys[rr]
        raMaybe = false
        if rt is TyArray { raMaybe = true }
      }
    }
    if (
      raMaybe &&
      raa != "null" &&
      valueAtomKind(raa) < 0 &&
      nameIsRefArray(raa)
    ) {
      const ren = refArrElemName(raa)
      if ren != "" && unionMemberCount(ren) > 1 {
        if registerInlineUnionAt(stmts, ren, 40, -1) < 0 { return -1 }
      }
    }
    rai = rai + 1
  }
  // A map arm interns its value shape and forces the shared map heap flags, the map twin of
  // the ref-array marking; this keeps the inline and named spellings identical.
  markMapUnionArms(name)
  0
}

// ── usage-driven `let x = null` nullable-hole inference (A-infer-null) ───────
// An un-annotated `let x = null` is not pinned to the exact `null` type — a later `x = e`
// fills the hole's `T`, making `x` the value union `T | null`, inferred once at collection
// time and registered per `LetDecl` so every later classifier sees the union.

// Infer + register the null hole of the un-annotated `let x = null` at
// `walk[i]`, scanning the rest of `walk` for the filling assignment.
function nliInferLet(walk: i32[], i: i32) {
  const s = P.nodes[walk[i]]
  if s is LetDecl {
    if s.letType < 0 && s.letInit >= 0 {
      const ini = P.nodes[s.letInit]
      if ini is NullLit {
        const atom = nliScanStmts(walk, i + 1, s.letName)
        if atom != "" {
          const nn = atom + "|null"
          registerValueUnionName(nn)
          nliLetIxs.push(walk[i])
          nliNames.push(nn)
        }
      }
    }
  }
  0
}

// Infers + registers the value union of an un-annotated `const x = <if-expression>`, the
// if-expression counterpart of `nliInferLet`, in the same `nli` tables so `nliNameOf` drives
// classification and emit reuses the annotated-binding lowering. The union name comes from
// the checker's `inferLetNameOf`, falling back to `ifExprNliName` when that carries none.
function nliInferIfLet(walk: i32[], i: i32) {
  const s = P.nodes[walk[i]]
  if s is LetDecl {
    if s.letType < 0 && s.letInit >= 0 {
      if exprIsIfStmt(s.letInit) {
        let nn = inferLetNameOf(walk[i])
        if nn == "" { nn = ifExprNliName(s.letInit) }
        if nn != "" {
          registerValueUnionNameAB(21, nn, nodeTyIxOf(walk[i]))
          nliLetIxs.push(walk[i])
          nliNames.push(nn)
        }
      }
    }
  }
  0
}

// Infers + registers the value union of an un-annotated `const t = a?.w`, the optional-chain
// counterpart of `nliInferIfLet`. This is the only route for this type: `i32 | null` here is
// synthesized by the checker with no annotation anywhere to see it, so without this the box
// heap type is never minted and `emitOptMemberValue` has no rep to build.
function nliInferOptChainLet(walk: i32[], i: i32) {
  const s = P.nodes[walk[i]]
  if s is LetDecl {
    if s.letType < 0 && s.letInit >= 0 {
      const ini = P.nodes[unwrapParen(s.letInit)]
      if ini is OptMember {
        const nn = inferLetNameOf(walk[i])
        if nn != "" {
          registerValueUnionNameAB(22, nn, nodeTyIxOf(walk[i]))
          nliLetIxs.push(walk[i])
          nliNames.push(nn)
        }
      }
    }
  }
  0
}

// ── the one render-then-canon hop in this module (W9) ──────────────────────────
// The emitter-vocabulary name of an arena type: `tyToNominalName`'s source-faithful spelling,
// then `canonEmitName` applied once over the whole render — the same rewrites every source
// annotation gets — so an arena-derived key equals the name-walk's key for the same type.
function arenaEmitName(tyIx: i32): string {
  const nom = tyToNominalName(tyIx)
  if nom == "" { return "" }
  canonEmitName(nom)
}

// The name-walk key for a reachable union, honoring the position-dependent litunion
// softening that `canonEmitName` bakes in — see `arenaEmitName` above for the rule and
// for what `underFunc` buys. Reproduces the name-walk key in BOTH positions — the
// prerequisite for retiring `registerShapeFieldUnions`.
function reachRegisterName(tyIx: i32, underFunc: boolean): string {
  if underFunc { return tyToNominalName(tyIx) }
  arenaEmitName(tyIx)
}

// ── unified arena registration walk ───────────────────────────────────────────
// The structural sibling of the name walk: recurses over `tyIx`'s `T.tys` shape and registers
// every reachable `TyUnion`, so a union in a novel nesting position the name walk cannot see
// is never missed. Keys from `arenaEmitName`, so an already-reached union is a no-op; depth-capped at 16.
function collectTyReachRegister(
  stmts: i32[],
  tyIx: i32,
  depth: i32,
  underFunc: boolean,
) {
  if tyIx < 0 || depth <= 0 { return 0 }
  const t = T.tys[tyIx]
  if t is TyNullable {
    // Descends the inner union's members first, without registering the inner union itself, so
    // the outer `…|null` name registers first (the arms' field unions must precede `collectVariantFields`).
    if collectTyMembersReach(stmts, t.nInner, depth - 1, underFunc) < 0 {
      return -1
    }
    // A niche nullable carries its own emit-name registration too, since recursing only the
    // inner type misses it (`AB|null`'s inner registers `A|B`, not the outer name `isUName` looks up).
    const nn = reachRegisterName(tyIx, underFunc)
    if nn != "" {
      if registerInlineUnionAt(stmts, nn, 41, tyIx) < 0 { return -1 }
    }
    return collectTyReachRegister(stmts, t.nInner, depth - 1, underFunc)
  }
  if t is TyArray {
    return collectTyReachRegister(stmts, t.aElem, depth - 1, underFunc)
  }
  if t is TyMap {
    return collectTyReachRegister(stmts, t.mVal, depth - 1, underFunc)
  }
  if t is TyObj {
    const ftys = t.objFieldTypes
    let i = 0
    while i < ftys.length {
      if collectTyReachRegister(stmts, ftys[i], depth - 1, underFunc) < 0 {
        return -1
      }
      i = i + 1
    }
    return 0
  }
  if t is TyFunc {
    // Inside a function type every reachable union sits in a litunion-keeping position, so
    // descend with `underFunc = true` and let embedded litunion aliases render faithfully.
    const ps = t.fnParamTypes
    let i = 0
    while i < ps.length {
      if collectTyReachRegister(stmts, ps[i], depth - 1, true) < 0 { return -1 }
      i = i + 1
    }
    return collectTyReachRegister(stmts, t.fnRet, depth - 1, true)
  }
  if t is TyUnion {
    // Descends into the members first: a struct arm's field may itself be a union, and the
    // outer registration runs `collectVariantFields` synchronously, needing the arm fields registered first.
    if collectTyMembersReach(stmts, tyIx, depth - 1, underFunc) < 0 {
      return -1
    }
    // A "" render (unresolvable nominal / over-deep recursion) declines silently; the name walk
    // still covers those, since this walk only adds coverage.
    const nm = reachRegisterName(tyIx, underFunc)
    if nm != "" {
      if registerInlineUnionAt(stmts, nm, 42, tyIx) < 0 { return -1 }
    }
    return 0
  }
  0
}

// Descends each member of the union at `tyIx` through `collectTyReachRegister`, without
// registering the union itself — whoever is about to register a variant-box union calls this
// first, so every struct arm's field unions are registered when `collectVariantFields` fires.
// A non-union `tyIx` (or -1 / exhausted depth) is a no-op. Returns 0, or -1.
function collectTyMembersReach(
  stmts: i32[],
  tyIx: i32,
  depth: i32,
  underFunc: boolean,
) {
  if tyIx < 0 || depth < 0 { return 0 }
  const t = T.tys[tyIx]
  if t is TyUnion {
    const members = t.uMembers
    let i = 0
    while i < members.length {
      if collectTyReachRegister(stmts, members[i], depth, underFunc) < 0 {
        return -1
      }
      i = i + 1
    }
  }
  // A collection carrying the union has no arm-field pre-descent of its own (the caller's
  // registration recurses by name into it), so descend through it here to register the arms' field unions first.
  if t is TyMap {
    return collectTyMembersReach(stmts, t.mVal, depth - 1, underFunc)
  }
  if t is TyArray {
    return collectTyMembersReach(stmts, t.aElem, depth - 1, underFunc)
  }
  0
}

// True if a closure whose result arena type is `retIx` is not yet representable through the
// value ABI, so the arena sig walk must skip interning its sig — synthesizing one the concrete
// producer declines would let a value call resolve past its clean reject into invalid emit.
// Two holes: an inline result struct not `funcTypeShapeLowerable`, or a heterogeneous value union.
function funcRetUnrepresentable(retIx: i32): boolean {
  if retIx < 0 { return false }
  const t = T.tys[retIx]
  if t is TyObj {
    // `arenaEmitName` is the module's one render-then-canon hop; a `""` render fails
    // `nameIsShapeOpen` without entering the rewriter.
    const nm = arenaEmitName(retIx)
    // `nameIsShapeOpen` bounds the name at 2, avoiding an out-of-bounds `nm[1]` read that a
    // bare `length > 0` test would trap on for the single name `"{"`.
    if nameIsShapeOpen(nm) { return !funcTypeShapeLowerable(nm) }
    return false
  }
  if t is TyUnion {
    const members = t.uMembers
    if members.length < 2 { return false }
    let hasScalar = false
    let hasComposite = false
    let i = 0
    while i < members.length {
      const mt = T.tys[members[i]]
      if mt is TyPrim { hasScalar = true }
      else if mt is TyLit { hasScalar = true }
      else if tyIsLitUnion(members[i]) { hasScalar = true }
      else if mt is TyObj { hasComposite = true }
      else if mt is TyArray { hasComposite = true }
      else if mt is TyMap { hasComposite = true }
      else if mt is TyFunc { hasComposite = true }
      i = i + 1
    }
    return hasScalar && hasComposite
  }
  false
}

// ── unified arena closure-sig walk ────────────────────────────────────────────
// The sig-interning sibling of `collectTyReachRegister`: recurses over `tyIx`'s `T.tys` shape
// and interns every reachable `TyFunc`'s `$fnsig`. Render discipline mirrors the registration
// walk, so keys agree; idempotent and order-stable, called last so an existing sig keeps its slot.
function collectTyReachCloSigs(tyIx: i32, depth: i32) {
  if tyIx < 0 || depth <= 0 { return 0 }
  const t = T.tys[tyIx]
  if t is TyNullable { return collectTyReachCloSigs(t.nInner, depth - 1) }
  if t is TyArray { return collectTyReachCloSigs(t.aElem, depth - 1) }
  if t is TyMap { return collectTyReachCloSigs(t.mVal, depth - 1) }
  if t is TyObj {
    const ftys = t.objFieldTypes
    let i = 0
    while i < ftys.length {
      if collectTyReachCloSigs(ftys[i], depth - 1) < 0 { return -1 }
      i = i + 1
    }
    return 0
  }
  if t is TyUnion {
    const members = t.uMembers
    let i = 0
    while i < members.length {
      if collectTyReachCloSigs(members[i], depth - 1) < 0 { return -1 }
      i = i + 1
    }
    return 0
  }
  if t is TyFunc {
    // Interns this closure's sig from its arena render, the key the value-call site and a
    // concrete lambda both derive; a mixed-union unregistered result is skipped so the call rejects loudly.
    if !funcRetUnrepresentable(t.fnRet) {
      // `sigKeyOfTy(tyIx)` gets the key directly off the type rather than parsing it back out of
      // the render `arenaEmitName` would produce; only the mixed-union guard still reads the name.
      const kAr = sigKeyOfTy(tyIx)
      if kAr != "" && !cloResultMaybeMixed(tyIx) {
        internCloSigKey(kAr, -1)
      } else {
        const nm = arenaEmitName(tyIx)
        if nm != "" { internCloSigOfAtomTy(nm, kAr) }
      }
    }
    // Descend params + result to reach closures nested inside them (a result struct's
    // closure field, a param closure, a closure arm of a field union).
    const ps = t.fnParamTypes
    let i = 0
    while i < ps.length {
      if collectTyReachCloSigs(ps[i], depth - 1) < 0 { return -1 }
      i = i + 1
    }
    return collectTyReachCloSigs(t.fnRet, depth - 1)
  }
  0
}

// Roots the arena registration walk at a named union's declared arena type, from the
// checker's declaration registry (`cUserTypes`), since a `UnionDecl` carries no annotation
// node. Descends each member (not the union itself, which `collectU` pushes right after) so
// `collectVariantFields` sees every arm's field unions already registered. Returns 0, or -1.
function rootUnionDeclMembers(stmts: i32[], udName: string) {
  let udTyIx = -1
  const udHit = cUserTypes[udName]
  if udHit is i32 { udTyIx = udHit }
  collectTyMembersReach(stmts, udTyIx, 16, false)
}

// The one annotation-site registration the arena walk cannot reproduce: an inline union whose
// non-null members share a shape is deduped at annotation resolution (`resolveAnnot`) to a
// plain `TyObj`, no `TyUnion` left to reach, yet the emitter still classifies by the source
// spelling `A | B`. So this drives that one case from the annotation node's name instead.
function registerCollapsedUnionName(stmts: i32[], node: i32) {
  const tyIx = nodeTyIxOf(node)
  if tyIx < 0 { return 0 }
  const t = T.tys[tyIx]
  // A genuine union / nullable / litunion is reached by the arena walk directly; only a
  // spelling that resolved to a plain struct (the same-shape collapse) needs the name.
  if t is TyObj {
    // Two-plus top-level atoms means the source spelled a union that collapsed to this struct;
    // the count is read from `canonEmitTypeNames`'s own bank (`annUnionAtomsOf`), never re-derived.
    if annUnionAtomsOf(node) >= 2 {
      return registerInlineUnionAt(stmts, tyNameOf(node), 43, -1)
    }
  }
  0
}

// The inferred-return twin of the same-shape annotation fallback above: an un-annotated
// function whose returns join to a struct-union is inferred structurally with no nominal
// identity, so the recorded name (not the anonymous arena render) is the only nominal
// spelling. The atom count comes from the name producer (`recordInferRet`), never a type walk.
function registerInferRetNominalUnion(stmts: i32[], nm: string, row: i32) {
  if isUName(nm) { return 0 }
  // A genuine union spelling the arena walk left unregistered is the anonymous-nominal
  // residual; a single-atom name has no top-level union to register.
  if inferRetAtomCountAt(row) >= 2 {
    return registerInlineUnionAt(stmts, nm, 44, -1)
  }
  0
}

// The gate that stops an inferred-return row registering twice: the arena walk renders the
// recorded anonymous type structurally and registers it, then the fallback registers the
// reverse-mapped nominal composite — two `unNames` rows, one layout, every variant of the
// second a duplicate in `uVariants`. True when the two names are not two spellings of one union.
function inferRetArenaUnionIsDup(tyIx: i32, nm: string, row: i32): boolean {
  if tyIx < 0 { return false }
  const t = T.tys[tyIx]
  if !(t is TyUnion) { return false }
  if inferRetAtomCountAt(row) < 2 { return false }
  const ar = reachRegisterName(tyIx, false)
  if ar == "" { return false }
  if ar == nm { return false }
  !isUNameAB(9, ar, tyIx)
}

// Scans every top-level `FuncDecl`'s param/return annotations and `let`/`const` annotations
// for inline union types, registering each as a synthetic union alias. Must run after the
// `UnionDecl` pass (so a matching inline name is a no-op) and before `assignTags` (which
// ranks the final `uVariants` set). Returns 0, or -1 (via `emitFail`).
function collectInlineUnions(stmts: i32[]) {
  nliLetIxs = []
  nliNames = []
  cloSigWalkRoots = []
  collectInlineUnionsIn(stmts, stmts)
}

// The recursive worker: scans the statement list `walk` (registering against the top-level
// `stmts`, where struct `TypeDecl`s live), descending into function bodies and branch blocks
// so a `let v: A | B = …` inside a function or nested block registers its inline union too.
function collectInlineUnionsIn(stmts: i32[], walk: i32[]) {
  let i = 0
  while i < walk.length {
    const s = P.nodes[walk[i]]
    if s is FuncDecl {
      // Read both annotation-bearing fields of the narrowed `s` before the inner loop introduces
      // a `Param` narrowing, which would unpin `s`'s own `FuncDecl` narrowing.
      const params = s.fnParams
      const retTy = s.fnRet
      const fnBody = s.fnBody
      // Arena walk first, so every reachable union registers, not just the ones the name render
      // surfaced; ordered before the name call since that runs `collectVariantFields` synchronously.
      if collectTyReachRegister(stmts, nodeTyIxOf(retTy), 16, false) < 0 {
        return -1
      }
      // Same-shape collapse fallback (the one case the arena walk can't reach — the
      // union spelling resolved to a single struct; see `registerCollapsedUnionName`).
      if registerCollapsedUnionName(stmts, retTy) < 0 { return -1 }
      cloSigWalkRoots.push(nodeTyIxOf(retTy))
      let pi = 0
      while pi < params.length {
        const p = P.nodes[params[pi]]
        if p is Param {
          const pt = p.parType
          // Arena walk first (bucket (c) ordering — see the return-type site).
          if collectTyReachRegister(stmts, nodeTyIxOf(pt), 16, false) < 0 {
            return -1
          }
          // Same-shape collapse fallback (see the return-type site).
          if registerCollapsedUnionName(stmts, pt) < 0 { return -1 }
          cloSigWalkRoots.push(nodeTyIxOf(pt))
        }
        pi = pi + 1
      }
      if collectInlineUnionsBlock(stmts, fnBody) < 0 { return -1 }
    } else if s is LetDecl {
      const letTy = s.letType
      // Arena walk first (bucket (c) ordering — see the return-type site).
      if collectTyReachRegister(stmts, nodeTyIxOf(letTy), 16, false) < 0 {
        return -1
      }
      // An unannotated binding still has a type that can be a union (`const v = m["k"]` infers
      // `i32 | null`), so this mints the box here; idempotent, since an annotated binding just no-ops the second walk.
      if letTy < 0 {
        if initNullableIsBoxScalar(s.letInit) {
          if (
            collectTyReachRegister(stmts, nodeTyIxOf(s.letInit), 16, false) <
            0
          ) {
            return -1
          }
        }
      }
      // Same-shape collapse fallback (see the return-type site).
      if registerCollapsedUnionName(stmts, letTy) < 0 { return -1 }
      cloSigWalkRoots.push(nodeTyIxOf(letTy))
      // Usage-driven `let x = null` hole (A-infer-null): infer + register `T|null`.
      nliInferLet(walk, i)
      // An un-annotated `const x = if … { … } else { … }` whose arms join to a value
      // union: register the inferred name so the slot classifies + lowers like an
      // annotated nullable/value-union binding.
      nliInferIfLet(walk, i)
      // An un-annotated `const t = a?.w` whose result is a nullable SCALAR: same
      // registration, because the type it needs is spelled nowhere in the program.
      nliInferOptChainLet(walk, i)
    } else if s is TypeDecl {
      // A struct field annotated with an inline union registers that union here, before
      // `collectS` interns the variant heap types, so the field classifies as the kind-16 box.
      const flds = s.tdFields
      let tfi = 0
      while tfi < flds.length {
        if flds[tfi] >= 0 {
          const fdn = P.nodes[flds[tfi]]
          if fdn is FieldDef {
            const fdt = fdn.fdType
            // Arena walk first (bucket (c) ordering — see the return-type site).
            if collectTyReachRegister(stmts, nodeTyIxOf(fdt), 16, false) < 0 {
              return -1
            }
            // Same-shape collapse fallback (see the return-type site).
            if registerCollapsedUnionName(stmts, fdt) < 0 { return -1 }
            cloSigWalkRoots.push(nodeTyIxOf(fdt))
          }
        }
        tfi = tfi + 1
      }
    } else if s is IfStmt {
      const thenB = s.ifThen
      const elseN = s.ifElse
      if collectInlineUnionsBlock(stmts, thenB) < 0 { return -1 }
      if elseN >= 0 {
        const els = P.nodes[elseN]
        if els is Block {
          if collectInlineUnionsBlock(stmts, elseN) < 0 { return -1 }
        } else {
          // `else if`: a lone nested statement — wrap it in a one-shot walk.
          const one: i32[] = []
          one.push(elseN)
          if collectInlineUnionsIn(stmts, one) < 0 { return -1 }
        }
      }
    } else if s is WhileStmt {
      if collectInlineUnionsBlock(stmts, s.whileBody) < 0 { return -1 }
    } else if s is ForRange {
      if collectInlineUnionsBlock(stmts, s.frBody) < 0 { return -1 }
    } else if s is ForIn {
      if collectInlineUnionsBlock(stmts, s.fiBody) < 0 { return -1 }
    }
    i = i + 1
  }
  0
}

// Recurse into a Block node's statement list (a function body / branch arm).
function collectInlineUnionsBlock(stmts: i32[], blockIx: i32) {
  if blockIx < 0 { return 0 }
  const b = P.nodes[blockIx]
  if b is Block { return collectInlineUnionsIn(stmts, b.blkStmts) }
  0
}

// ── unrenderable (cyclic) declared types — rejected before anything renders ──
// `applyGenAlias` registers an empty placeholder under a recursive instance's memo key before
// resolving its fields, so a self-application lands on its own index rather than recursing
// forever — but a generic instance has no name to short-circuit a renderer, which then traps.

// Would a name-faithful render of arena type `ix` fail to terminate? The render itself is
// the test (`renderEmit` banks the cut in `tyNomNameCycled`), not a hand-written copy of it.
function tyNomRenderLoops(ix: i32): boolean {
  tyToNominalName(ix)
  tyNomNameCycled()
}

// The source spelling of the first annotation whose resolved type is `ix` (`L<i32>`),
// for the diagnostic — the arena type itself has no finite render, which is the whole
// point. Failure path only, so the linear `P.nodes` scan costs nothing otherwise.
function annSpellingOfTyIx(ix: i32): string {
  let i = 0
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is TypeRef {
      if nodeTyIxOf(i) == ix { return n.tyName }
    }
    i = i + 1
  }
  ""
}

// Rejects every declared type whose expansion has no finite name, before the first pass
// renders one. `cUserTypes` keys every declared alias and generic-alias instance, so one scan
// of the registry covers the whole family; a declared struct/union entry costs one lookup.
// Returns 0, or -1 (via `emitFail`).
function guardFiniteUserTypes(): i32 {
  const ks = cUserTypes.keys()
  let i = 0
  while i < ks.length {
    const v = cUserTypes[ks[i]] ?? (-1)
    if tyNomRenderLoops(v) {
      let shown = annSpellingOfTyIx(v)
      if shown == "" { shown = ks[i] }
      return emitFail(
        "emitProgram: recursive generic type `" +
          shown +
          "` is not supported — its expansion has no finite type name",
      )
    }
    i = i + 1
  }
  0
}

// ── the variant field-span invariant, reconciled once per module ─────────────────────
// `uFieldStart`/`uFieldCount` are parallel to `uVariants`; they come apart when a swallowed
// `-1` leaves a pushed row's start with no count, and `emitFail`'s keep-emitting discipline
// then traps some thirty later readers. Restored once here: report both lengths, then pad.
export function reconcileVariantFieldSpans() {
  if (
    uFieldStart.length >= uVariants.length &&
    uFieldCount.length >= uVariants.length
  ) {
    return 0
  }
  emitFail(
    "emitProgram: the union-variant field-span tables do not cover every variant — " +
      i32ToStr(uVariants.length) +
      " variants but " +
      i32ToStr(uFieldStart.length) +
      " field starts / " +
      i32ToStr(uFieldCount.length) +
      " field counts",
  )
  // An empty span (start 0, count 0) is in bounds against any flat store, so a padded row
  // reads as a fieldless variant rather than off the end of the table.
  while uFieldStart.length < uVariants.length { uFieldStart.push(0) }
  while uFieldCount.length < uVariants.length { uFieldCount.push(0) }
  -1
}

// Scans the top-level statements for every union alias `type N = A | B | …`; for each,
// records its name + variant-slice range, appends its variant struct names to the global
// `uVariants` list, and collects each variant's fields into the flat table. Multiple unions
// coexist. Returns 0, or -1 (via `emitFail`).
export function collectU(stmts: i32[]) {
  // The first emit pass, so this is the first thing in the emitter that would walk a
  // declared type — reject the ones no renderer can finish before any of them tries.
  if guardFiniteUserTypes() < 0 { return -1 }
  uDeclared = false
  vbI32Used = false
  vbI64Used = false
  vbF32Used = false
  vbF64Used = false
  unNames = []
  unRowBySid = []
  unTyIx = []
  unKey = []
  unDeclIx = []
  unMemberSet = []
  unMemTyStart = []
  unMemTyCount = []
  unMemTys = []
  unVarStart = []
  unVarCount = []
  uVariants = []
  uVariantRowBySid = []
  uVarTyIx = []
  cloSigTagNames = []
  uFieldNames = []
  uFieldStart = []
  uFieldCount = []
  uFieldTypes = []
  uFieldTyText = []
  uFieldLitTyIx = []
  uFieldElemName = []
  uFieldElemTyIx = []
  uFieldElemKeyI32 = []
  let i = 0
  while i < stmts.length {
    // D1519 — the declaration cursor `emitFail` anchors refusals at, since this pass runs before
    // any function body arms one; a failure freezes it, so early returns cannot leak a stale anchor.
    emitCurStmtIx = stmts[i]
    const s = P.nodes[stmts[i]]
    if s is UnionDecl {
      // A struct-alias union (single inline-shape variant) is a named struct, not a union:
      // `collectS` interns it; skip it here.
      if unionStructAliasShape(s.udVariants) != "" {
        i = i + 1
        continue
      }
      // A transparent one-member alias denotes its member, not a union (#1122's ruling), so it
      // gets no row here: minting one pushed the member's name into `uVariants` a second time.
      if isTransparentAlias(s.udName) {
        i = i + 1
        continue
      }
      uDeclared = true
      const vs = s.udVariants
      if vs.length < 1 {
        return emitFail("emitProgram: union must have at least one variant")
      }
      // Field unions of the arms register first, so they push their own rows before this union's
      // slice; arena-rooted since a named union carries no annotation node (`rootUnionDeclMembers`).
      if rootUnionDeclMembers(stmts, s.udName) < 0 { return -1 }
      unNamesPush(s.udName)
      unTyIx.push(declTyIxOfName(s.udName)) // B-1 step 1
      unDeclIx.push(stmts[i]) // the DECLARATION node — a nominal id that is not a string
      // D1028 — a union-alias member (`Json` in `type JR = Json | E`) flattens here too, or its
      // own members are absent from the row and delivered raw; a litunion alias is not expanded.
      let udSet = ""
      let usj = 0
      while usj < vs.length {
        let udMem = vs[usj]
        // Asked of the arena row (knows both numeric and string litunion bases); only a multi-atom
        // expansion is taken (a litunion alias renders as one atom), and never deduped (box-tag ABI).
        const udExp = unionAliasMembers(udMem)
        if udExp != "" {
          const udExpAtoms: string[] = []
          splitUnionAtoms(udExp, udExpAtoms)
          if udExpAtoms.length > 1 { udMem = udExp }
        }
        if udSet != "" { udSet = udSet + "|" }
        udSet = udSet + udMem
        usj = usj + 1
      }
      unMemberSet.push(udSet)
      // Keyed on the set this row actually records, not the alias name — the row's tag slice
      // is positional over `udSet`, which a query must reproduce to name this row.
      unKey.push(canonUnionKeyOfName(udSet))
      recordUnMemTys(udSet) // D-UNION foundation
      unVarStart.push(uVariants.length)
      // Only struct variants get a variant struct + fields; an atom member of a mixed union
      // boxes through the shared value boxes instead, as the inline-annotation path does.
      let nStructs = 0
      let nc = 0
      while nc < vs.length {
        if vs[nc] != "null" {
          if isStructAtom(stmts, vs[nc]) { nStructs = nStructs + 1 }
        }
        nc = nc + 1
      }
      unVarCount.push(nStructs)
      let vi = 0
      while vi < vs.length {
        if vs[vi] != "null" {
          if isStructAtom(stmts, vs[vi]) {
            uVariantsPush(vs[vi])
            uVarTyIx.push(declTyIxOfName(vs[vi]))
            if collectVariantFields(stmts, vs[vi]) < 0 { return -1 }
          }
        }
        vi = vi + 1
      }
      // A MIXED union's scalar members intern their per-rep value boxes (no-op for an
      // all-struct union).
      markValueUnionAtoms(udSet)
      // A ref-array arm of a named union interns its element shape + reflist slot, the same as
      // the inline path — so the two spellings register identically.
      markRefArrayArms(udSet)
      // A map arm of a named union interns its value shape too, matching the inline path.
      markMapUnionArms(udSet)
    }
    i = i + 1
  }
  // Inline union annotations carry no `UnionDecl`; registers each as a synthetic alias so
  // every name-keyed lookup treats it like a named one. Runs after `UnionDecl`, before `assignTags`.
  if collectInlineUnions(stmts) < 0 { return -1 }
  // Inferred value-union and struct-union returns register here too, even when an inferred
  // return is the program's only union; self-gated (`isUName`), so already-declared ones no-op.
  let iru = 0
  while iru < inferRetCount() {
    // Arena walk over the inferred return type first (bucket (c) ordering, as at the annotation
    // sites): registers every reachable union, not just what the name render surfaced. Idempotent.
    // `inferRetArenaUnionIsDup`: where the walk's structural render and the name fallback's
    // nominal composite are two spellings of one union, the walk descends members only.
    const irTyIx = inferRetTyIxAt(iru)
    const irNom = inferRetTyAt(iru)
    if inferRetArenaUnionIsDup(irTyIx, irNom, iru) {
      if collectTyMembersReach(stmts, irTyIx, 15, false) < 0 { return -1 }
    } else {
      if collectTyReachRegister(stmts, irTyIx, 16, false) < 0 { return -1 }
    }
    // The name fallback: an inferred struct/variant-box return whose members are anonymous
    // shapes, recorded under its nominal composite, which the arena walk cannot reach (`registerInferRetNominalUnion`).
    if registerInferRetNominalUnion(stmts, irNom, iru) < 0 { return -1 }
    cloSigWalkRoots.push(irTyIx)
    iru = iru + 1
  }
  // Inferred value-union bindings get the same treatment, so their box reps intern even
  // when `nliInferIfLet` is the only consumer. Self-gating, like the returns.
  let ilu = 0
  while ilu < inferLetCount() {
    registerValueUnionNameAB(
      23,
      inferLetTyAt(ilu),
      nodeTyIxOf(inferLetIxAt(ilu)),
    )
    ilu = ilu + 1
  }
  // Inferred array-element unions (the literal twin of the two loops above): an un-annotated
  // array literal spells its element union nowhere, so without this the row is never minted.
  let iau = 0
  while iau < P.nodes.length {
    const an = P.nodes[iau]
    if an is ArrayLit {
      const aeu = arrLitInferUnionElemName(iau)
      if aeu != "" {
        const aety = arrLitElemTyIxOf(iau)
        if !isUNameAB(24, aeu, aety) {
          if collectTyMembersReach(stmts, aety, 15, false) < 0 { return -1 }
          if registerInlineUnionAt(stmts, aeu, 45, -1) < 0 { return -1 }
        }
      }
    }
    iau = iau + 1
  }
  // A numeric-scalar `.pop()` has the same missing-row shape: `xs.pop()` is `T | null` with
  // no niche to hide absence in, so without this the box is never interned (D1174).
  let ipu = 0
  while ipu < P.nodes.length {
    const pn = P.nodes[ipu]
    if pn is Call {
      const pcf = P.nodes[pn.callFn]
      if pcf is Member {
        // `.get(i)` is the same unspoken box (D1281): the checker types the checked
        // read `T | null` at both members, and neither spells the union anywhere.
        if pcf.memProp == "pop" || pcf.memProp == "get" {
          const pun = nulNumScalarUnionName(nodeTyIxOf(ipu))
          if pun != "" { registerValueUnionName(pun) }
        }
      }
    }
    // D1250 — an if-expression `??` operand is a second producer of an unspoken solo box, keyed
    // on the `??` (not the `if`, whose statement form also types nullable but has no consumer).
    if pn is BinExpr {
      if pn.binOp == "??" {
        const lin = P.nodes[unwrapParen(pn.binLeft)]
        if lin is IfStmt {
          const iun = nulNumScalarUnionName(nodeTyIxOf(unwrapParen(pn.binLeft)))
          if iun != "" { registerValueUnionName(iun) }
        }
      }
    }
    ipu = ipu + 1
  }
  emitCurStmtIx = -1
  if uDeclared {
    if assignTags() < 0 { return -1 }
  }
  0
}

// Detects bare named-function value uses the other flips miss: a `let`/`const` initialized
// to a function name, a reassignment, an equality operand, or a function-valued object-literal
// field. Each such cell is a closure fat-pointer (kind 14), so the closure rec-group types
// must intern (`fnValUsed`) even when no lambda or `.map` site otherwise flips it.
export function collectFnValUse() {
  let i = 0
  while i < P.nodes.length {
    const nd = P.nodes[i]
    if nd is LetDecl {
      if exprIsBareFnName(nd.letInit) { fnValUsed = true }
    }
    if nd is BinExpr {
      if nd.binOp == "=" || nd.binOp == "==" || nd.binOp == "!=" {
        if exprIsBareFnName(nd.binLeft) { fnValUsed = true }
        if exprIsBareFnName(nd.binRight) { fnValUsed = true }
      }
    }
    if nd is FieldInit {
      if exprIsBareFnName(nd.fiValue) { fnValUsed = true }
    }
    // A bare named function as a call argument: a builtin method (`m.set(k, inc)`) has no
    // annotation to flip the machinery otherwise, unlike a user call's param TypeRef.
    if nd is Call {
      const cfvArgs = nd.callArgs
      let cfv = 0
      while cfv < cfvArgs.length {
        if exprIsBareFnName(cfvArgs[cfv]) { fnValUsed = true }
        cfv = cfv + 1
      }
    }
    // A closure if-value whose arm is a bare named function needs the same flip a lambda arm
    // gets during lifting; the loop visits every `IfStmt`, so binding/return/argument alike are covered.
    if nd is IfStmt {
      if exprIsBareFnName(ifArmValueExpr(nd.ifThen)) { fnValUsed = true }
      if nd.ifElse >= 0 {
        const el = P.nodes[nd.ifElse]
        if el is Block {
          if exprIsBareFnName(ifArmValueExpr(nd.ifElse)) { fnValUsed = true }
        }
      }
    }
    // A source function-type annotation flips the machinery too: the annotated cell is a
    // closure fat-pointer whose call site `call_ref`s through it, so its signature must intern.
    if nd is TypeRef {
      if tyIsFuncType(i) { fnValUsed = true }
      // A closure-array annotation's elements are closures too, so it flips the machinery on;
      // without this an array whose only function-type mention is the annotation leaves signatures un-interned.
      if nameIsClosureArrayTy(i) == 1 { fnValUsed = true }
      // A nullable-closure annotation is a closure fat-pointer cell too, so its `$fnsig` must
      // intern even when the value is only ever `null` (no lambda elsewhere flips the machinery).
      if nodeTyIsNulClosure(i) { fnValUsed = true }
      // A shape annotation with a closure field needs the same flip, even for a `null`-only value.
      // `tyReachesClosure` asks directly whether this type reaches a closure through any of those positions.
      if nodeTyReachesClosure(i) { fnValUsed = true }
    }
    // An inferred closure-element array literal needs the same flip as the annotation form,
    // but only when the element itself constructs a closure — one merely containing one must not.
    if nd is ArrayLit {
      // The same arena predicate the three `arrLit*` consumers use; the render is taken only for
      // its emptiness gate, since "" means the checker declined to name the element, not that it isn't a closure.
      if arrElemIsClosureTy(i, nodeArrayElemName(i)) { fnValUsed = true }
    }
    i = i + 1
  }
  0
}

export function collectMapFilterUse() {
  let i = 0
  while i < P.nodes.length {
    const nd = P.nodes[i]
    if nd is Call {
      const callee = P.nodes[nd.callFn]
      if callee is Member {
        if callee.memProp == "map" || callee.memProp == "filter" {
          if nd.callArgs.length == 1 {
            fnValUsed = true
            if callee.memProp == "map" {
              const fe = mfCallbackFe(nd.callArgs[0], -1)
              if fe >= 0 && mfCbResultIsStrList(fe) {
                // A string- or `string | null`-returning callback's result list may be the program's only
                // one, so force its wrapper/backing collection.
                slUsed = true
              } else if fe >= 0 && cloRetValKind(fe) == "struct" {
                // A struct-returning callback's result is a new ref list with no `Q[]` annotation to force
                // its slot, so intern it here; `cloRetKindOf` folds a struct to -1, so ask `cloRetValKind`/`cloRetValSlot` directly.
                const rsi = cloRetValSlot(fe)
                if rsi >= 0 && rsi < sNames.length {
                  // Hinted with the struct table's own type column, so the hint skips `resolveAnnot` rather
                  // than racing it; the read is bounded since `sTyIx` is padded lazily and a short column yields -1 (today's unhinted call).
                  rlInternNameTy(sNames[rsi], 1, rlColAt(sTyIx, rsi))
                  rlUsed = true
                  raUsed = true
                }
              } else if fe >= 0 && cloRetValKind(fe) == "variant" {
                // A concrete-variant-returning callback (a collapse): interns the variant's
                // ref-list slot (kind 1 — its element heap is `uVarHeap[vi]`).
                const cvi = cloRetValSlot(fe)
                if cvi >= 0 && cvi < uVariants.length {
                  // Hinted with the variant table's TYPE column, same provenance and
                  // same bound as the struct arm above.
                  rlInternNameTy(uVariants[cvi], 1, rlColAt(uVarTyIx, cvi))
                  rlUsed = true
                  raUsed = true
                }
              } else if (
                fe >= 0 &&
                cloRetValKind(fe) == "union" &&
                unNames.length > 0
              ) {
                // A union-returning callback's result is a ref list of union boxes; interns the union
                // alias's slot so a map whose source is not itself a union array still has a result backing.
                rlInternNameTy(unNames[0], 2, rlColAt(unTyIx, 0))
                rlUsed = true
                raUsed = true
              } else {
                let rk: VKind | null = null
                if fe >= 0 { rk = cloRetKindOf(fe) }
                // D1088 — `cloRetKindOf` answers only `"i32"`/`"f64"`/null, so an i64/f32-returning callback
                // needs the second reader `cloRetValKind` (already consulted by the arms above) to name it.
                let rvk: VKind | null = null
                if fe >= 0 { rvk = cloRetValKind(fe) }
                if rk == "f64" {
                  fa64Used = true
                } else if rvk == "i64" {
                  ia64Used = true
                } else if rvk == "f32" {
                  fa32Used = true
                } else {
                  aUsed = true
                  lUsed = true
                }
              }
            }
          }
        }
      }
    }
    i = i + 1
  }
  0
}

// True when the nul-closure arm's result is a mixed scalar+composite union that no
// registration path admitted (not a registered alias, value union, litunion-arm value
// union, or map-member union). Such a union has no pin/box path, so its synthetic `>u`
// `$fnsig` must not intern — the call site rejects loudly instead of cast-trapping.
function nulCloMixedUnionUnregistered(arm: string) {
  const res = cloResultAtomOf(arm)
  if res == "" { return false }
  const atoms: string[] = []
  splitUnionAtoms(res, atoms)
  if atoms.length < 2 { return false }
  let hasScalar = false
  let hasComposite = false
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    if a != "null" {
      if valueAtomKind(a) >= 0 || nameIsLitUnionType(a) {
        // A closure atom is value-atom kind 11 but composes like a ref — count only
        // the non-closure value atoms as the scalar side of the mix test.
        if nameIsFuncTypeAtom(a) {
          hasComposite = true
        } else {
          hasScalar = true
        }
      } else {
        hasComposite = true
      }
    }
    i = i + 1
  }
  if !hasScalar || !hasComposite { return false }
  if isUName(res) { return false }
  if isValueUnionName(res) { return false }
  if nameIsLitUnionArmValueUnion(res) { return false }
  if nameIsMapMemberUnion(res) { return false }
  true
}

// Is the annotation at `ix` spelled as an array? The parser's tree where it survives, the
// rendering's trailing-`[]` test where it does not.
function annSpelledArray(ix: i32, nm: string): boolean {
  const root = annTsOf(ix)
  if root >= 0 { return tsKind[root] == TS_ARR }
  nameIsArray(nm)
}
