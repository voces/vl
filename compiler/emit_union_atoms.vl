// The mv shape of the map held as `heldTy` (bare, nullable or through a one-member alias),
// keyed by its value's declared name; `armTy` is the value's type as the caller's node recorded
// it (D34) and `valTy` only classifies the value. The key kind follows spelling `mapName` when
// given, as the map's ops hash by it. A value the arena cannot name has no slot: `-3`.
export function mvShapeOfMapHeldTy(
  mapName: string,
  heldTy: i32,
  armTy: i32,
  valTy: i32,
) {
  const m = tyMapHeld(heldTy)
  const vn = mvDeclNameOfValTy(tyMapValOf(m))
  if vn == "" { return -3 }
  let kk = tyMapKeyKind(m)
  if mapName != "" { kk = mapNameKeyKind(mapName) }
  mvShapeOfMapValKey(vn, kk, armTy, valTy)
}

// The mv shape of a map whose value is keyed `valName` under key kind `ki`: the value's slot,
// or the mono sentinel of `ki` for a value that needs none.
function mvShapeOfMapValKey(valName: string, ki: i32, armTy: i32, valTy: i32) {
  const sh = mvShapeOfValNameTys(valName, ki, armTy, armTy, valTy)
  // A mono value — i32, boolean, a literal-union atom or a nullable atom — rides the shared
  // i32 `vals` list and needs no per-value struct, so it is the `-1` string-keyed or `-4`
  // i32-keyed sentinel every value-blind classifier already reads as the mono rep.
  if sh == -1 { return mapMonoShapeOfKey(ki) }
  sh
}

// The mv shape of the map type the checker recorded on node `ix` — the intern-side twin of
// the `nodeTyIsMap` fall-through in `mapShapeOfExpr`, and the mint an un-annotated map has no
// other route to. The rung order is the spelling mint's, read off the node. Fronted with
// `nodeMapValTyIx` only to find a deep declared record's slot, never to mint one.
export function mvShapeOfMapNodeTy(ix: i32) {
  if !nodeTyIsMap(ix) { return -1 }
  const ki = nodeTyMapKeyKind(ix)
  // A `Map()` whose values the checker builds at another record mints that record's slot.
  const bv = recBuildElemTyOfInit(ix)
  if bv >= 0 && mvDeclNameOfValTy(bv) != "" {
    return mvShapeOfMapValKey(mvDeclNameOfValTy(bv), ki, bv, bv)
  }
  if nodeTyMapValIsLitUnion(ix) { return mapMonoShapeOfKey(ki) }
  if nodeTyMapValIsNulLitUnion(ix) { return mapMonoShapeOfKey(ki) }
  const drs = mvDeclRecSlotOfTy(nodeMapValTyIx(ix), ki)
  if drs >= 0 { return drs }
  // A hole value (an unconstrained `Map()`) has no value rep to intern.
  if nodeMapValTyIx(ix) < 0 { return -3 }
  const fs = mvDeepFuncSlotOfTy(nodeMapValTyIx(ix), ki)
  if fs >= 0 { return fs }
  const sh = mvShapeOfValNameArmTy(
    mapNodeValName(ix),
    ki,
    -1,
    nodeMapValTyIx(ix),
  )
  if sh == -1 { return mapMonoShapeOfKey(ki) }
  sh
}

// The mv slot of a map under key kind `keyK` whose value is record `vTy`, nested past depth 8,
// declared and owning a struct row no other row or variant arm may match, or -1. It finds from
// the type the slot the render path would key by a spelling that doubles per level (D9511).
export function mvDeclRecSlotOfTy(vTy: i32, keyK: i32): i32 {
  if vTy < 0 || vTy >= T.tys.length || !(tyAt(vTy) is TyObj) { return -1 }
  if !tyDeeperThan(vTy, 8) { return -1 }
  if repTyHasArmShape(vTy) { return -1 }
  const nm = structNameOfTy(vTy)
  if nm == "" { return -1 }
  const si = structIndexOfTy(vTy)
  if (
    si < 0
    || repSlotOfTy(vTy) != si
    || !sigRowHasNoTwin(si)
    || !sigRowHasNoArmTwin(si)
  ) {
    return -1
  }
  mvSlotOfTyKArm(vTy, keyK, mvArmSigOfTy(vTy))
}

// Classify and intern a map value type-name under key kind `keyK`, returning the binding's map
// shape code: `-1` for the mono i32 map, a slot `>= 0` for a ref or scalar value type, `-3`
// unsupported. Interning is idempotent. The arena leg can front a find but not a mint
// (D-MAPNODETY); `rowTy` may, since it is the value's own recorded type.
export function mvShapeOfValNameRowTy(
  valNameIn: string,
  keyK: i32,
  rowTy: i32,
) {
  // The row-table callers' `rowTy` IS the value's own recorded type (the D5 field-row cell),
  // so it serves as the arm hint unchanged; a -1 bank is a -1 hint.
  // A row with neither a value name nor a type is a hole value: unsupported, as the name
  // resolver would say of "".
  if valNameIn == "" && rowTy < 0 { return -3 }
  mvShapeOfValNameArmTy(valNameIn, keyK, rowTy, rowTy)
}

let mvShapeNest = 0

// Restarts the nesting guard at compile start.
export function mvShapeNestReset() {
  mvShapeNest = 0
  0
}

export function mvShapeOfValNameArmTy(
  valNameInRaw: string,
  keyK: i32,
  rowTy: i32,
  armTy: i32,
) {
  let kindTy = armTy
  if kindTy < 0 { kindTy = rowTy }
  mvShapeOfValNameTys(valNameInRaw, keyK, rowTy, armTy, kindTy)
}

// `mvShapeOfValNameArmTy` with the value's arena type `kindTy`, or -1, as its own input: it
// classifies the value and splits off a niche's member, and is never a find or mint key.
export function mvShapeOfValNameTys(
  valNameInRaw: string,
  keyK: i32,
  rowTy: i32,
  armTy: i32,
  kindTy: i32,
) {
  // A self-referential map value has no finite shape walk: this function and its callers
  // form a cycle stepping through `mapValNameOf`, and each lap expands the
  // spelling rather than repeating it, so a name-keyed re-entry guard cannot see it (D984).
  // `-1` degrades to the caller's mono shape, which is what an unenumerable value should get.
  if mvShapeNest > 32 { return -1 }
  mvShapeNest = mvShapeNest + 1
  const mvR = mvShapeOfValNameArmTyGo(valNameInRaw, keyK, rowTy, armTy, kindTy)
  mvShapeNest = mvShapeNest - 1
  return mvR
}

function mvShapeOfValNameArmTyGo(
  valNameInRaw: string,
  keyK: i32,
  rowTy: i32,
  armTy: i32,
  kindTyIn: i32,
) {
  const valNameIn = mvArmKeyName(valNameInRaw, armTy)
  // A caller with no type classifies by the type the slot banks, so kind and key agree.
  let kindTy = kindTyIn
  if kindTy < 0 { kindTy = mvValTyIxOfNameRow(valNameIn, rowTy) }
  let valName = mvCanonValNameTy(valNameIn, kindTy)
  const kind = mvValKindOfNameTy(valName, kindTy)
  if kind == MVK_MONO { return -1 }
  if kind < 0 { return -3 }
  // An inferred value union can arrive spelled structurally (`{x:i32}[]|i32[]` for a write of
  // `P[] | i32[]`); a spelling no row is keyed on has no member set, so a narrowed read of
  // the slot loses its arm. The slot takes the row its arena type resolves to (D5113).
  if kind == MVK_UNION && unionRowOfAB(53, valName, kindTy) < 0 {
    const cu = unRowOfTyKey(mvValTyIxOfNameRow(valNameIn, rowTy))
    if cu >= 0 { valName = unNames[cu] }
  }
  // A niche-nullable value name resolves its struct or map identity — and keys its vals
  // ref-list slot — through the single non-null member, so the slot shares the vals rep and
  // the heap-type dedup with its non-null twin.
  let bare = valName
  const nin = nulRefMapValInnerOfTy(valName, kindTy)
  if nin != "" { bare = nin }
  let vsi = -1
  if kind == MVK_STRUCT { vsi = structIndexOfTypeNameTy(bare, kindTy) }
  // A value union also interns its scalar value-box reps; a struct or heterogeneous union just
  // rides the box payload and needs none. A map arm's mv value slot is interned so the
  // store-coerce tag and the narrowed read resolve the same slot.
  if kind == MVK_UNION {
    if isValueUnionName(valName) {
      registerValueUnionNameAB(60, valName, kindTy)
    }
    markMapUnionArms(valName, kindTy)
  }
  // The slot's identity is structural — `repMvValKey` over the value's arena type — paired
  // with the key rep, not the recorded spelling; the name scan is the fall-through for a
  // spelling the arena does not resolve. Held rather than consumed, because the row this call
  // may push records the very same index.
  const vTy = mvValTyIxOfNameRow(valNameIn, rowTy)
  // The arm is part of what is being looked up (D48). Asking the hint at the two find rungs is
  // not the better-answer-at-a-mint the interner rule forbids: it never makes a find succeed
  // where it failed, only decline a slot whose arm is not this value's, so the mint below runs
  // in strictly more cases and is skipped in none.
  const armH = mvArmHintOfShapeTy(armTy)
  const aSh = mvSlotOfTyKArm(vTy, keyK, armH)
  if aSh >= 0 { return aSh }
  const nmSh = mvSlotByValNameKArm(valName, keyK, armH)
  if nmSh >= 0 { return nmSh }
  // A ref-value (nested map or list) value forces the i32-list and map types, and a map value
  // also interns its inner value shape first so a ref-valued inner map's struct exists. All of
  // the recursive interning runs before this slot's parallel arrays are pushed: a reentrant
  // intern between two pushes would land its own entry at this slot's index and skew the rest.
  let rls6 = -1
  if kind == MVK_REF {
    lUsed = true
    aUsed = true
    if nameIsMap(bare) {
      mUsed = true
      mvShapeOfMapHeldTy(bare, kindTy, -1, tyMapValOfHeld(kindTy))
    }
    // `bare`'s arena type: the value's own, or its non-null member's for a niche-nullable
    // value, and -1 where `bare` is not the spelling the find resolved.
    let bareTy = -1
    if bare == valNameIn {
      bareTy = vTy
    } else if nin != "" && vTy >= 0 {
      const vt = tyAt(vTy)
      if vt is TyNullable { bareTy = vt.nInner }
    }
    // A non-i32 list value forces its inner list's type so the element wrapper heap exists.
    if tyScalarListKind(bareTy) == "strlist" { slUsed = true }
    else if nameIsF64Array(bare) { fa64Used = true }
    else if nameIsI64Array(bare) { ia64Used = true }
    // The vals ref-list slot, keyed by the value name with the recursively-interned inner
    // slots — the same `ensureRefElem` the array path uses. Its recursion strictly shrinks the
    // element spelling, so it never re-enters on `valName` itself. Keyed from the find's own
    // resolution, and withheld where `bare` is not that spelling, since that is another input.
    rls6 = ensureRefElemTy(bare, bareTy)
  }
  mvValName.push(valName)
  // The slot's key half, pushed in lockstep with its name half — the pair is the row's
  // identity, so nothing between the two pushes may intern.
  mvKeyKind.push(keyK)
  // An i64 key's struct and keys list exist only where some slot or mono map asks for them.
  if keyK == MAP_KEY_I64 { markMapI64Used() }
  // The row's own resolution is the slot find's, not a second one: the find above resolved
  // `valNameIn` through the same resolver and `resolveAnnot` memoizes per spelling with no
  // invalidation of a positive entry. The one thing that can make the two inputs differ is
  // `mvCanonValNameTy` rewriting the spelling, and there the bank is withheld.
  let vBank = -1
  if valName == valNameIn { vBank = vTy }
  recordMvValTyIx(valName, vBank)
  // The row that line just banked: `recordMvValTyIx` holds `valName`'s arena index over the
  // very spelling the two `valName` interns below key on. A mint may be fronted only with a
  // banked input provably the one it would have computed. The kind-6 site above is not
  // reachable from this bank — it interns before the row is pushed, and it must.
  const vRowTy = mvValTyIxAt(mvValTyIx.length - 1)
  mvValKind.push(kind)
  mvValStructIdx.push(vsi)
  // The variant half of that column, pushed in the same breath so the pair is one row (D34).
  // `repVariantShapeRowOf` writes no `mv*` table, which the parallel-table discipline requires
  // of anything sitting between two pushes. The name is its second source, for the
  // un-hinted caller the key rewrite cannot reach; the two cannot disagree.
  let mvVarRow = repVariantShapeRowOf(armTy)
  if mvVarRow < 0 { mvVarRow = variantIndexOf(valName) }
  // The adopted arm, the third source, on the same gate the kind rung used: only where neither
  // name-keyed lookup placed the render, which is where `objVariantName` claimed the literal.
  if mvVarRow < 0 && vsi < 0 { mvVarRow = mvValArmOfShapeTy(valName, kindTy) }
  mvValVariantIdx.push(mvVarRow)
  // The arm-signature half (D93), pushed in the same breath so the row stays one row: asked of
  // the caller's recorded type, else the key's own, through the map hop the variant row stops
  // at, so an inline arm's annotation reaches its row (D4638). It interns nothing, as the
  // parallel-table discipline requires between two pushes.
  let sigTy = armTy
  if sigTy < 0 { sigTy = kindTy }
  mvValArmSig.push(mvArmSigOfShapeTy(sigTy, 8))
  if kind == MVK_STRUCT {
    // The kind-1 site is deliberately unhinted: it interns `sNames[vsi]`, not `valName`, and
    // that row's `sTyIx` sidecar has two producers that answer differently for an `#anonN` row.
    // It is keyed by the arm's name where the value is one (D34), since `sNames[vsi]` is the
    // inline-shape row minted from the arm's field set, over the wrong heap.
    let armNm = mvValArmName(armTy)
    if armNm == "" && variantIndexOf(valName) >= 0 { armNm = valName }
    // And from the adopted render (D671): an arm reached by its own row spelling has neither
    // an `sNames` row nor a `uVariants` name match, so both rungs above decline and
    // `sNames[-1]` is the out-of-bounds compiler read the rung above exists to stop.
    // `mvValArmOfShapeTy` is the resolver the kind rung and the variant column already used.
    if armNm == "" {
      const armSh = mvValArmOfShapeTy(valName, kindTy)
      if armSh >= 0 { armNm = uVariants[armSh] }
    }
    if armNm != "" {
      mvRlSlot.push(rlInternName(armNm, RLK_STRUCT))
    } else if vsi >= 0 && vsi < sNames.length {
      mvRlSlot.push(rlInternName(sNames[vsi], RLK_STRUCT))
    } else {
      // No row: refused here rather than read out of bounds, the slot kept in step.
      emitFail("emitProgram: a record map value has no struct row")
      mvRlSlot.push(-1)
    }
    rlUsed = true
    raUsed = true
  } else if kind == MVK_UNION {
    // A union-value ref list: element kind 2, the union box, heap `uBoxIdx`.
    mvRlSlot.push(rlInternNameTy(valName, RLK_UNION, vRowTy))
    rlUsed = true
    raUsed = true
  } else if kind == MVK_REF {
    // The map's value is a ref list or a nested map: the vals ref-list slot interned above,
    // before this slot's parallel-array pushes.
    mvRlSlot.push(rls6)
    rlUsed = true
    raUsed = true
  } else if kind == MVK_CLOSURE {
    // A closure-value ref list: element kind 5, the closure fat-pointer, heap `cloStructIdx`.
    mvRlSlot.push(rlInternNameTy(valName, RLK_CLOSURE, vRowTy))
    rlUsed = true
    raUsed = true
  } else {
    mvRlSlot.push(-1)
  }
  if kind == MVK_F64 { fa64Used = true }
  if kind == MVK_I64 { ia64Used = true }
  if kind == MVK_F32 { fa32Used = true }
  // A string-valued map: force the string-list value flag so a bound `m.values()` supports
  // `.length` and indexing, which gate on `slUsed`.
  if kind == MVK_STR {
    slUsed = true
    aUsed = true
  }
  mvMapTypeIdx.push(0)
  mvValName.length - 1
}

// The map shape a `Map()` must build to sit in ref-list slot `slot`'s element position:
// arena first, then the element-name leg. `-1`/`-4` the mono struct of the element's key
// rep, `>= 0` the element's own (key, value) mv slot, `-3` a value the mv layer doesn't
// intern (`emitMapNew`'s reject). Only meaningful when the element kind is a map (3).
export function rlElemMapShape(slot: i32): i32 {
  const ar = rlElemMapValMvSlotAt(slot, true)
  if ar >= 0 { return ar }
  if slot < 0 || slot >= rlElemName.length { return -3 }
  let en = rlElemName[slot]
  const enn = nulMapInnerName(en)
  if enn != "" { en = enn }
  let ety = -1
  if slot >= 0 && slot < rlElemTyIx.length { ety = rlElemTyIx[slot] }
  mvShapeOfMapHeldTy(en, ety, -1, tyMapValOfHeld(ety))
}

// Intern the ref-list slot whose element type is `elemName`, recursively interning a
// nested inner list's element slot first — so the inner wrapper lands at a lower type
// index and the outer element heap (kind 9) resolves to it. The DRY core that makes
// arbitrary `X[]…[]` nesting of any ref leaf fall out, bottoming out at the leaf array.
export function ensureRefElem(elemName: string) {
  ensureRefElemTy(elemName, -1)
}

// `ensureRefElem` with the caller's recorded arena type for `elemName` (D-REPELEMTY),
// threaded to `rlInternNameTy` for the slot key only — classification still reads the
// spelling, and the intern still mints on a miss. `ty` -1 = no hint.
export function ensureRefElemTy(elemName: string, ty: i32) {
  ensureRefElemTys(elemName, ty, ty)
}

// The ref-list mint keyed by type: interns element type `ty`'s row under the spelling
// `rlMintNameOfTy` gives it.
export function rlInternOfTy(ty: i32) {
  ensureRefElemTy(rlMintNameOfTy(ty), ty)
}

// The spelling a row minted by `rlInternOfTy(ty)` is stored and looked up under: the row
// name `rlRowNameOfTy` gives, so a declared record mints under its own name.
export function rlMintNameOfTy(ty: i32): string { rlRowNameOfTy(ty, false) }

// The row name an element of type `ty` is stored under: its nominal render, a function type
// in parentheses. With `unfold`, a recursive declared union renders as its members, the
// spelling a nested list's inner element is written in. "" when `ty` is -1 or has a hole.
export function rlRowNameOfTy(ty: i32, unfold: boolean): string {
  if ty < 0 || ty >= T.tys.length { return "" }
  const n = tyToNominalName(ty)
  if n == "" { return "" }
  const t = tyAt(ty)
  if t is TyFunc { return "(" + n + ")" }
  if (
    !unfold
    || !(t is TyUnion)
    || (cUserTypes[n] ?? -1) < 0
    || !tyReachesCycle(ty)
  ) {
    return n
  }
  let o = ""
  for m in t.uMembers {
    let s = tyToNominalName(m)
    if s == "" { return n }
    if tyAt(m) is TyFunc { s = "(" + s + ")" }
    if o != "" { o = o + "|" }
    o = o + s
  }
  o
}

// `ensureRefElemTy` with the element's type `kindTy` held apart from the key hint `ty`:
// `kindTy` only classifies a map element's value, so a caller whose hint is -1 by design
// still hands over the type it holds. Either may be -1.
export function ensureRefElemTys(elemName: string, ty: i32, kindTy: i32) {
  if elemName == "" { return -1 }
  // The kind is `kindTy`'s; the spelling is the floor for a caller with no type, or a type
  // the classifier declines (a type parameter, a union of lists).
  let k = refListElemKindOfTy(kindTy)
  if k < 0 { k = refArrElemKind(refElemArrName(elemName)) }
  if k == RLK_REF_LIST {
    // The inner element's row is named from `kindTy`'s element type; the spelling cut is
    // the floor for a caller that holds no type, or a type with a hole.
    let inm = rlRowNameOfTy(tyStepElem(kindTy), true)
    if inm == "" { inm = refArrElemName(elemName) }
    let inner = tyStepElem(ty)
    if elemNameIsNominal(inm) { inner = -1 }
    ensureRefElemTys(inm, inner, tyStepElem(kindTy))
  }
  ensureRefElemKindTail(elemName, k, ty, kindTy)
}

// The flag-setting and intern half of `ensureRefElemTy`, run after the kind is known and
// any kind-9 recursion has finished — split out so the literal side (`collectA`) can reach
// it with the kind its own classifier already chose, rather than re-deriving one.
function ensureRefElemKindTail(elemName: string, k: i32, ty: i32, kindTy: i32) {
  // A map element (kind 3): forces the map heap types and interns the element map's value
  // slot, so a typed-value map in any composition position resolves the same per-value map
  // struct a standalone `{[string]: V}` binding does. A mono or atom value interns nothing,
  // riding the shared mono `$mapStruct`.
  if k == RLK_MAP {
    mUsed = true
    lUsed = true
    aUsed = true
    // A nullable map element strips to its inner map for the value intern — the slot
    // shares the map struct and mv slot with the non-null element.
    let mve = elemName
    const nme = nulMapInnerName(elemName)
    if nme != "" { mve = nme }
    // The element's own arena row carries the map value, so a RECURSIVE alias element
    // resolves to the declared type rather than the unrolled anonymous twin its rendered
    // spelling would mint (D1865). `-1` in, `-1` through: the unhinted call is unmoved.
    mvShapeOfMapHeldTy(
      mve,
      kindTy,
      tyMapValOf(unMemPeelAliasWrapper(ty)),
      tyMapValOfHeld(kindTy),
    )
    // The one home that also sets `mI32Used` for an i32-keyed map reached only through a
    // map-typed ref-list element — every other map-forcing site sets `mUsed`/`lUsed`/`aUsed`
    // alone. Without it the key temporary aliases the map-ref temporary at the same local
    // index: `vl check` rc 0, `expected (ref $type), found i32`.
    markMapKeyUsed(mapNameKeyKind(mve))
  }
  // Forces the leaf list-type wrapper flags for a scalar inner-list element, so its singleton
  // wrapper is allocated. A ref inner list (kind 9) forces these in the recursion above; a
  // struct, union, or closure element (kind 1/2/5) needs none. Shared by both the array path
  // and the map-value path.
  if k == RLK_I32_LIST {
    lUsed = true
    aUsed = true
  } else if k == RLK_STR_LIST {
    slUsed = true
    aUsed = true
  } else if k == RLK_F64_LIST {
    fa64Used = true
  } else if k == RLK_I64_LIST {
    ia64Used = true
  } else if k == RLK_F32_LIST {
    fa32Used = true
  } else if k == RLK_U8_LIST {
    ba8Used = true
  }
  rlInternNameTy(elemName, k, ty)
}

export function rlInternName(name: string, kind: i32) {
  rlInternNameTy(name, kind, -1)
}

// The record type a literal's `#anon` struct row recorded at its mint, or -1 for any other
// spelling, a row that recorded none, or a type a declaration also names (the row may then
// be a merge wider than that type).
function anonRowTyOfName(name: string): i32 {
  if name.length < 5 || name[0] != '#' { return -1 }
  const si = structIndexByName(name)
  if si < 0 || si >= sTyIx.length { return -1 }
  const ty = sTyIx[si]
  if rlDeclTwinTy(ty) >= 0 { return -1 }
  ty
}

// `rlInternName` with the caller's recorded arena type for `name`: the hint reaches only
// the key — the scan, mint, stored spelling, and every sidecar push are unchanged, so a
// hinted call that finds no row interns exactly the row an unhinted one would. The hint
// must compute the same key, since a disagreeing hint silently re-keys the row.
export function rlInternNameTy(name: string, kind: i32, tyIn: i32) {
  if name == "" { return -1 }
  // A literal's `#anon` row names no type, so its recorded record type is the hint (D5049).
  let ty = tyIn
  if ty < 0 && kind == RLK_STRUCT { ty = anonRowTyOfName(name) }
  // Dedup on the element's rep key (`repElemKey`), a structural wrapper-equivalence class,
  // not a string-canonicalized name. Two spellings sharing a WasmGC wrapper collapse to one
  // slot — without it, two slots sharing one wrapper mint distinct iso-recursive functypes
  // and a value-call `ref.cast` trap. Declared struct twins stay apart, keyed nominally.
  const key = repElemIdOfNameTy(name, ty)
  let i = 0
  while i < rlElemName.length {
    if rlElemKey[i] == key { return i }
    i = i + 1
  }
  const stored = rlElemStoredName(name, ty)
  rlElemName.push(stored)
  rlElemKey.push(key)
  // The arena type the stored spelling denotes, recorded once at mint time — resolved from
  // the stored name (which `rlElemStoredName` may have folded), never the raw `name`. Prefers
  // the caller's hint when the stored spelling is unfolded (`stored == name`), since a folded
  // spelling's own resolve would land on a different row than the checker's.
  let rlTy = -1
  if ty >= 0 && stored == name { rlTy = ty }
  if rlTy < 0 { rlTy = fieldElemTyIxOfName(stored) }
  rlElemTyIx.push(rlTy)
  rlElemHeap.push(0)
  rlBackIdx.push(0)
  rlWrapIdx.push(0)
  if rlElemNicheNullable(kind, stored) {
    rlElemNullable.push(1)
  } else {
    rlElemNullable.push(0)
  }
  let men = stored
  if kind == RLK_MAP {
    const min = nulMapInnerName(men)
    if min != "" { men = min }
  }
  rlElemMapKey.push(rlMintMapKey(kind, rlTy, men))
  rlElemMvSlot.push(-1)
  // A map element's value slot is found, never minted, at the read; the row it looks for is
  // interned by the value's own first op, which can fall between the frame-layout pass and
  // the emit pass. Minting it HERE is what makes the two passes read one answer (D1786).
  if kind == RLK_MAP {
    const rlIx = rlElemMvSlot.length - 1
    const msh = mvShapeOfMapHeldTy(men, rlTy, -1, tyMapValOfHeld(rlTy))
    if msh >= 0 { rlElemMvSlot[rlIx] = msh }
  }
  rlElemName.length - 1
}

// The key kind a ref-list slot of kind `kind` records at its mint: a map element's from its
// arena type `rlTy` (one `| null` peeled), else from `men`, the spelling the slot's value
// shape is minted under; `MAP_KEY_STR` for every other kind.
function rlMintMapKey(kind: i32, rlTy: i32, men: string): i32 {
  if kind != RLK_MAP { return MAP_KEY_STR }
  if rlTy >= 0 {
    let b = rlTy
    const t = tyAt(b)
    if t is TyNullable { b = t.nInner }
    if b >= 0 {
      const bt = tyAt(b)
      if bt is TyMap { return tyMapKeyKind(b) }
    }
  }
  mapNameKeyKind(men)
}

// The smallest earlier variant whose softened arena type equals variant `i`'s and whose fields
// lay out alike, else `i`. Canon spells a self-referential arm once rolled and once unrolled
// (`next: Node | null`, `next: <Node's members> | null`), keyed apart while denoting one type;
// unfolded, they mint two heap types for one arm (D4615).
function variantUnrolledTwin(i: i32, sigFirst: i32, sigNext: i32[]): i32 {
  const ti = uVarTyIx[i]
  if ti < 0 { return i }
  let d = sigFirst
  while d >= 0 && d < i {
    if uVarTwin[d] == d && uVarTyIx[d] >= 0 {
      if variantFieldLayoutEq(d, i) == 1 && tyEqSoftLits(uVarTyIx[d], ti) {
        return d
      }
    }
    d = sigNext[d]
  }
  i
}

// Chains rows `0..keys.length` by equal key in ascending order: `next[r]` is the following row
// with `keys[r]`, or -1, and `first` maps a key to its lowest row. A negative key is left out.
function twinChain(keys: i32[], first: {[i32]: i32}, next: i32[]) {
  const last: {[i32]: i32} = Map()
  let r = 0
  while r < keys.length {
    next.push(-1)
    const k = keys[r]
    if k >= 0 {
      const p = last[k] ?? (-1)
      if p < 0 { first[k] = r } else { next[p] = r }
      last[k] = r
    }
    r = r + 1
  }
  0
}

// Populates `uVarTwin` (parallel to `uVariants`): `uVarTwin[i]` is the smallest earlier
// layout twin, or `i` itself when `i` is first of its layout. Keys are computed once up
// front, since the compiler's own unions carry hundreds of variants and a per-pair
// recomputation is the hot path. Called from `mAssignTypeIndices` before heap indices allocate.
export function buildVariantTwins() {
  const keys: i32[] = []
  // The signature interned per row, so the D1023 arm below compares integers. `sidOf` is
  // equality-preserving on the text, so `sigIds[d] == sigIds[i]` decides exactly what
  // comparing the two strings decided, and the memo is asked once a row rather than once a pair.
  const sigIds: i32[] = []
  let i = 0
  while i < uVariants.length {
    keys.push(repNameCanonId(uVariants[i]))
    sigIds.push(sidOf(variantSig(i)))
    i = i + 1
  }
  // Each row is compared only with the earlier rows sharing its key or signature, in
  // ascending order, so the first hit is still the smallest twin (D11270).
  const keyFirst: {[i32]: i32} = Map()
  const keyNext: i32[] = []
  twinChain(keys, keyFirst, keyNext)
  const sigFirst: {[i32]: i32} = Map()
  const sigNext: i32[] = []
  twinChain(sigIds, sigFirst, sigNext)
  uVarTwin = []
  i = 0
  while i < uVariants.length {
    let rep = i
    if keys[i] >= 0 {
      let j = keyFirst[keys[i]] ?? (-1)
      while j >= 0 && j < i {
        if variantFieldLayoutEq(j, i) == 1 {
          rep = j
          j = i // stop at the first (smallest) twin
        } else {
          j = keyNext[j]
        }
      }
    }
    // D1023's arms fold here too: the canon key preserves each arm's literal set, so two
    // arms with different literals key differently and miss the guard above, even though
    // `assignTags` already ranked them one tag (same field-name signature). A shared tag with
    // two heap types is not a representation — the other arm's `ref.cast` would trap.
    const sf = sigFirst[sigIds[i]] ?? (-1)
    if rep == i {
      let d = sf
      while d >= 0 && d < i {
        // A shared tag is a fact about one union's arms, so arms of two unions never fold (D2155).
        if (
          unionOfVariant(d) == unionOfVariant(i)
          && variantLitDiscriminable(d, i)
        ) {
          rep = d
          d = i // the smallest such row, matching the guard above
        } else {
          d = sigNext[d]
        }
      }
    }
    if rep == i { rep = variantUnrolledTwin(i, sf, sigNext) }
    uVarTwin.push(rep)
    i = i + 1
  }
  uVarSTwin = []
  i = 0
  while i < uVariants.length {
    uVarSTwin.push(variantStructHeapTwinAt(i))
    i = i + 1
  }
}

// Variant `vi`'s own struct row: the row of the arm's own record type on the arm's heap, else -1.
// The heap twin is tried first; it may be a layout twin of another type or another spelling. An
// arm sharing its tag-mate's layout (D1023) is on that heap, and its record's row is not.
export function variantOwnRow(vi: i32, h: i32): i32 {
  if vi >= uVarTyIx.length || uVarTyIx[vi] < 0 { return -1 }
  const vt = uVarTyIx[vi]
  const st = if vi < uVarSTwin.length { uVarSTwin[vi] } else { -1 }
  if (
    st >= 0
    && st < sTyIx.length
    && st < sHeapIdx.length
    && sHeapIdx[st] == h
    && sTyIx[st] >= 0
    && tySame(vt, sTyIx[st])
  ) {
    return st
  }
  let r = 0
  while r < sTyIx.length && r < sHeapIdx.length {
    if sHeapIdx[r] == h && sTyIx[r] >= 0 && tySame(vt, sTyIx[r]) { return r }
    r = r + 1
  }
  -1
}

// Whether element spelling `en` names a declared type: its head, past `[]`, `| null` and type
// arguments, is a user type. A structural render (`{v:i32}`) does not.
function elemNameIsDeclared(en: string): boolean {
  let h = nonNulBaseOf(en)
  let a = arrElemNameRaw(h)
  while a != "" {
    h = nonNulBaseOf(a)
    a = arrElemNameRaw(h)
  }
  let i = 0
  while i < h.length && h[i] != '<' { i = i + 1 }
  (cUserTypes[h.slice(0, i)] ?? -1) >= 0
}

// Make variant `vi` and its own struct row `r` record one element name and type per field where
// the two record the same type: a declared spelling wins over a structural one, else the row's.
function variantRowAgree(vi: i32, r: i32) {
  if r < 0 || vi >= uFieldCount.length || r >= sFieldCount.length { return 0 }
  if uFieldCount[vi] != sFieldCount[r] { return 0 }
  let k = 0
  while k < uFieldCount[vi] {
    const ui = uFieldStart[vi] + k
    const si = sFieldStart[r] + k
    if (
      ui < uFieldElemName.length
      && ui < uFieldElemTyIx.length
      && si < sFieldElemName.length
      && si < sFieldElemTyIx.length
      && uFieldNames[ui] == sFieldNames[si]
    ) {
      const ut = uFieldElemTyIx[ui]
      const st = sFieldElemTyIx[si]
      const ue = uFieldElemName[ui]
      const se = sFieldElemName[si]
      if ut >= 0 && st >= 0 && (ut != st || ue != se) && tySame(ut, st) {
        if ue != se && elemNameIsDeclared(ue) && !elemNameIsDeclared(se) {
          sFieldElemName[si] = ue
          sFieldElemTyIx[si] = ut
        } else {
          uFieldElemName[ui] = se
          uFieldElemTyIx[ui] = st
        }
      }
    }
    k = k + 1
  }
  0
}

// Whether a struct row other than a reference row records variant `vi`'s record type, on any heap.
// A D1023 shared-tag arm's record has one, off the arm's heap.
function variantRecordHasRow(vi: i32): boolean {
  const vt = uVarTyIx[vi]
  let r = 0
  while r < sTyIx.length {
    if !sIsRefRow(r) && sTyIx[r] >= 0 && tySame(vt, sTyIx[r]) { return true }
    r = r + 1
  }
  false
}

// Variant `vi`'s row: its own struct row, else a reference row minted for its record on its heap.
// -1 for an arm with no recorded type, or one laid out at its tag-mate's heap (D1023).
export function variantRowOrMint(vi: i32, h: i32): i32 {
  const own = variantOwnRow(vi, h)
  if own >= 0 && !sIsRefRow(own) { variantRowAgree(vi, own) }
  if (own >= 0 || vi >= uVarTyIx.length || uVarTyIx[vi] < 0) { return own }
  if variantRecordHasRow(vi) { return -1 }
  refRowMint(vi, h)
}

// Append a reference row for variant `vi`: its record type, heap and fields, a twin of itself and
// no declared name. -1 when the field table is mid-append and the row cannot be laid down.
function refRowMint(vi: i32, h: i32): i32 {
  const si = sNames.length
  const fs = sFieldNames.length
  if (
    sFieldStart.length != si
    || sFieldCount.length != si
    || sHeapIdx.length != si
    || sTwin.length != si
    || sFieldTypes.length != fs
    || sFieldElemName.length != fs
    || sFieldCloSig.length != fs
    || vi >= uFieldStart.length
    || vi >= uFieldCount.length
  ) {
    return -1
  }
  while sRefRow.length < si { sRefRow.push(false) }
  sRefRow.push(true)
  sNames.push("#ref" + i32ToStr(si))
  while sRowDecl.length < si { sRowDecl.push(0) }
  sRowDecl.push(0)
  while sTyIx.length < si { sTyIx.push(-1) }
  sTyIx.push(uVarTyIx[vi])
  sHeapIdx.push(h)
  sTwin.push(si)
  while sFieldElemTyIx.length < fs { sFieldElemTyIx.push(-1) }
  while sFieldElemKeyKind.length < fs { sFieldElemKeyKind.push(MAP_KEY_STR) }
  sFieldStart.push(fs)
  sFieldCount.push(uFieldCount[vi])
  let k = 0
  while k < uFieldCount[vi] {
    const u = uFieldStart[vi] + k
    sFieldNames.push(uFieldNames[u])
    sFieldTypes.push(uFieldTypes[u])
    sFieldElemName.push(
      if u < uFieldElemName.length { uFieldElemName[u] } else { "" },
    )
    sFieldCloSig.push("")
    sFieldElemTyIx.push(
      if u < uFieldElemTyIx.length { uFieldElemTyIx[u] } else { -1 },
    )
    sFieldElemKeyKind.push(
      if u < uFieldElemKeyKind.length { uFieldElemKeyKind[u] } else { MAP_KEY_STR },
    )
    k = k + 1
  }
  si
}

// The static map type of the map-valued expression `exprIx`, or -1: its recorded type, else —
// inside a generic instance, whose clone nodes carry the parameter — a narrowing's arm, or the
// pinned annotation of the parameter or local it names.
export function mapValueTyOf(exprIx: i32, fnIx: i32): i32 {
  const ax = unwrapParen(exprIx)
  if ax < 0 { return -1 }
  const n = nodeAt(ax)
  if n is Ident {
    const nt = mapTyPeel(readNarrowedTyAt(ax, fnIx))
    if nt >= 0 { return nt }
    const pp = mapPinnedParamTyOf(ax, fnIx)
    if pp >= 0 { return pp }
  }
  const own = mapTyPeel(nodeTyIxOf(ax))
  if own >= 0 { return own }
  if n is Ident {
    const pt = mapTyPeel(nodeTyIxOf(paramTypeNodeOfRead(fnIx, ax)))
    if pt >= 0 { return pt }
    if fnIx >= 0 {
      const fd = nodeAt(fnIx)
      if fd is FuncDecl {
        const li = bodyLetOfRead(fd.fnBody, ax)
        if li >= 0 {
          const ld = nodeAt(li)
          if ld is LetDecl { return mapTyPeel(nodeTyIxOf(ld.letType)) }
        }
      }
    }
  }
  -1
}

// The map shape of type `ty` or of its nullable inner map (`mapShapeOfExpr`'s codes), or `-3`
// when it is neither.
export function mapShapeOfTyPeeled(ty: i32): i32 {
  const mt = mapTyPeel(ty)
  if mt < 0 { return -3 }
  mapArmShapeOfTy(mt)
}

// The slot the function type rendered `nm` claims in the closure-signature tag table,
// interning it on a miss. -1 for "", folded onto the value-atom band's kind-11 offset by
// `cloSigSlotTag`. The key is the canonical structural render (`tyToEmitName`), so an alias
// and the inline spelling of one signature share a slot and meet on the same tag.
export function cloSigTagSlot(nm: string): i32 {
  if nm == "" { return -1 }
  let i = 0
  while i < cloSigTagNames.length {
    if cloSigTagNames[i] == nm { return i }
    i = i + 1
  }
  cloSigTagNames.push(nm)
  cloSigTagNames.length - 1
}

// The globally-stable tag of the bare-closure arm whose interned signature slot is `slot`,
// residue 0 of the mod-3 interleave. The first slot deliberately keeps the value-atom band's
// kind-11 offset, so a program with one closure signature tags exactly as it always did; each
// further signature claims the band above. An un-nameable closure (`slot < 0`) shares the first slot's tag.
export function cloSigSlotTag(slot: i32): i32 {
  if slot <= 0 { return scalarTagOfKind(11) }
  refArrSlotTag(slot - 1) + 2
}

// The union box tag a bare function-typed arm of arena type `ty` claims — the one home of
// the function-type-to-tag composition, read by both the box site and the test site
// (`isArmTagOfTy`). The two must derive the tag from the same render, or a value boxed
// through one arm answers an `is` against another.
export function cloArmTagOfTy(ty: i32): i32 {
  if ty < 0 { return scalarTagOfKind(11) }
  cloSigSlotTag(cloSigTagSlot(cloSigNameOfTy(ty)))
}

// The spelling function type `ty` keys its closure-signature slot under, which is also its
// atom in a value union's name: the structural render, so an alias and its inline spelling
// meet.
function cloSigNameOfTy(ty: i32): string { tyToEmitName(ty) }

// `registerValueUnionName` with the caller's arena type for this union, or -1 when the
// caller has only a name. The row's `unTyIx` entry is that index, so the registry can be
// asked by type rather than by spelling once its readers move.
function registerValueUnionNameTy(name: string, tyIx: i32) {
  if isUNameOwnAB(1, name, tyIx) && unNameAdoptTyKeyRow(name, tyIx) { return 0 }
  // The row decides: `isValueUnionTyOr` asks `valueRowKind` per member, matching
  // `isValueUnionName`'s spelling test, and declines (-1) rather than guess. A value union
  // with a litunion-alias arm registers here too, since the alias rides the box as its
  // member-string atom — without it the scalar arms' value boxes are never minted.
  let isVU = isValueUnionTyOr(tyIx)
  if isVU < 0 {
    isVU = 0
    if isValueUnionName(name) { isVU = 1 }
  }
  if isVU == 0 && !nameIsLitUnionArmValueUnion(name) { return 0 }
  pushValueUnionRow(name, tyIx)
}

// Appends the value-union row `name`, typed `tyIx`, with its key and an empty variant slice.
function pushValueUnionRow(name: string, tyIx: i32) {
  // A value union whose type key already has a row names that row: one row per type.
  if tyIx >= 0 && !unNameBound(name) {
    const kr = unRowOfTyKey(tyIx)
    if kr >= 0 && kr < unVarCount.length && unVarCount[kr] == 0 {
      unNameBindRow(name, kr)
      return 0
    }
  }
  uDeclared = true
  unNamesPush(name)
  unTyIx.push(tyIx)
  unDeclIx.push(-1) // value-union row: registered from a name, no declaration
  unMemberSet.push(name)
  recordUnMemTys(name) // D-UNION foundation
  unKeyPushOfTy(tyIx, name)
  unTyKeyPushRow()
  unVarStart.push(uVariants.length)
  unVarCount.push(0)
  markValueUnionAtoms(name, tyIx)
  0
}

// The name-only entry point: resolves the name once, here, exactly as the two
// declaration-driven registration sites do, so a row minted through this path carries an
// arena index instead of -1 without every one of its twelve callers threading one.
// Resolving at the boundary means the string work happens once at mint, not at every query.
export function registerValueUnionName(name: string) {
  registerValueUnionNameTy(name, declTyIxOfName(name))
}

// The row a value union `ty` keys to, minted when no row carries that key: it is named by the
// key's own text, so its members are `ty`'s sequence, never deduped, and a literal member is
// its scalar there. A row the key already finds, a `ty` with no key, a nullable literal union
// (an atom niche, not a box) and a union with a member no value box carries are left alone.
export function mintValueUnionRowOfTy(ty: i32) {
  if ty < 0 || unRowOfKey(ty) >= 0 || nulLitUnionPeelTy(ty) >= 0 { return 0 }
  const text = canonUnionKeyTextOfTy(ty)
  if text == "" { return 0 }
  if isValueUnionTyOr(ty) != 1 && !isValueUnionName(text) { return 0 }
  pushValueUnionRow(text, ty)
}

// The name a value union `ty` registers under: its key's own text, or "" when `ty` has no key or
// is not a value union (`isValueUnionTyOr`, or the text's own test where that declines).
export function valueUnionKeyTextOfTy(ty: i32): string {
  if ty < 0 { return "" }
  const text = canonUnionKeyTextOfTy(ty)
  if text == "" { return "" }
  const vu = isValueUnionTyOr(ty)
  if vu == 1 || (vu < 0 && isValueUnionName(text)) { return text }
  ""
}

// The name a value union `ty` is registered under by spelling: `unionSpellingOfTy` when that
// spelling is a value union, else "".
export function valueUnionNameOfTy(ty: i32): string {
  const text = unionSpellingOfTy(ty, 8)
  if text == UNION_SPELLING_DECLINE || !isValueUnionName(text) { return "" }
  text
}

// The value-union name of union `ty` with each literal member, and each literal set, spelled as
// its base: the box a shared field read builds when a member stores a set at the atom and the
// read widens it (D14750). "" when a member is no scalar or the spelling is no value union.
export function valueUnionNameOfSoftTy(ty: i32): string {
  if ty < 0 || ty >= T.tys.length { return "" }
  const t = tyAt(ty)
  if !(t is TyUnion) { return "" }
  const parts: string[] = []
  for m in t.uMembers {
    if m < 0 { return "" }
    let mt = tyAt(m)
    if mt is TyUnion && tyIsLitUnion(m) { mt = tyAt(mt.uMembers[0]) }
    const b = if mt is TyLit { litBaseTy(mt) } else { m }
    if b < 0 { return "" }
    const bt = tyAt(b)
    if !(bt is TyPrim) { return "" }
    let seen = false
    for q in parts {
      if q == bt.primName { seen = true }
    }
    if !seen { parts.push(bt.primName) }
  }
  if parts.length < 2 { return "" }
  let text = parts[0]
  let i = 1
  while i < parts.length {
    text = text + "|" + parts[i]
    i = i + 1
  }
  if !isValueUnionName(text) { return "" }
  text
}

// `unionSpellingOfTy`'s decline: `ty` is no union, or a member is a hole, a record or a map,
// none of which a value union holds.
export const UNION_SPELLING_DECLINE = ""

// The member-order spelling of union `ty`, bare or nullable, built from its members as the
// emit render spells it: a literal widens to its base, a literal-union alias keeps its name,
// and a part equal to an earlier one drops (`9000000000 | 1` is `i64|i32`). Declines past
// `depth` nested unions, as at any member a value union cannot hold.
export function unionSpellingOfTy(ty: i32, depth: i32): string {
  if ty < 0 || ty >= T.tys.length || depth <= 0 {
    return UNION_SPELLING_DECLINE
  }
  const t = tyAt(ty)
  match t {
    TyUnion => unionMembersSpelling(ty, t.uMembers, depth)
    TyNullable => nullableSpelling(t.nInner, depth)
    TyPrim | TyLit | TyObj | TyArray | TyMap | TyFunc | TyVar | TyNeg | TyErr => {
      UNION_SPELLING_DECLINE
    }
  }
}

// `unionSpellingOfTy` over the members `ms` of union `ty`.
function unionMembersSpelling(ty: i32, ms: i32[], depth: i32): string {
  if ms.length == 0 { return UNION_SPELLING_DECLINE }
  // A pure string-literal union keeps its members only beside `null`.
  const lui = litUnionInlineNameOfTy(ty)
  if lui != "" {
    for m in ms {
      if isNullTy(m) { return lui + "|null" }
    }
  }
  const rgAlias = mixedLitRunAliasOf(ms)
  const parts: string[] = []
  let rgDone = false
  for m in ms {
    let s = ""
    if rgAlias != "" && tyAt(m) is TyLit {
      if rgDone { continue }
      rgDone = true
      s = rgAlias
    } else {
      s = unionPartSpelling(m, depth - 1)
    }
    if s == UNION_SPELLING_DECLINE { return UNION_SPELLING_DECLINE }
    let dup = false
    for p in parts {
      if p == s { dup = true }
    }
    if !dup { parts.push(s) }
  }
  let out = parts[0]
  let k = 1
  while k < parts.length {
    out = out + "|" + parts[k]
    k = k + 1
  }
  out
}

// `T | null` over `inner`, as the render spells it.
function nullableSpelling(inner: i32, depth: i32): string {
  if inner < 0 || inner >= T.tys.length { return UNION_SPELLING_DECLINE }
  const nal = litUnionAliasNameOfTy(inner)
  if nal != "" { return nal + "|null" }
  const nlui = litUnionInlineNameOfTy(inner)
  if nlui != "" { return nlui + "|null" }
  const one = oneStrLitSpelling(inner)
  if one != "" { return one + "|null" }
  const s = unionPartSpelling(inner, depth - 1)
  if s == UNION_SPELLING_DECLINE { return UNION_SPELLING_DECLINE }
  s + "|null"
}

// One member `m` of a union, or a nullable's inner: a nested union spells its own members, a
// list the key's atom, a function its parenthesized closure-signature spelling.
function unionPartSpelling(m: i32, depth: i32): string {
  if m < 0 || m >= T.tys.length || depth <= 0 { return UNION_SPELLING_DECLINE }
  const al = litUnionAliasNameOfTy(m)
  if al != "" { return al }
  const t = tyAt(m)
  match t {
    TyPrim => {
      if t.primName == "never" { return UNION_SPELLING_DECLINE }
      t.primName
    }
    TyLit => {
      const bt = tyAt(litBaseTy(t))
      if bt is TyPrim { return bt.primName }
      UNION_SPELLING_DECLINE
    }
    TyUnion => unionMembersSpelling(m, t.uMembers, depth)
    TyNullable => nullableSpelling(t.nInner, depth)
    TyArray => canonUnionKeyAtomOfTy(m)
    TyFunc => {
      const sig = cloSigNameOfTy(m)
      if sig == "" { return UNION_SPELLING_DECLINE }
      "(" + sig + ")"
    }
    // A record or a map is no value atom, and a hole has no spelling.
    TyObj | TyMap | TyVar | TyNeg | TyErr => UNION_SPELLING_DECLINE
  }
}

// Marks the per-rep value-box usage flags for every scalar atom of the value union `name`,
// typed `ty` (-1 when unknown), at registration time so `mAssignTypeIndices` interns exactly
// the used reps. A row whose members resolved reads them; otherwise the union's own type is
// walked, and only a union with neither keeps the name path.
export function markValueUnionAtoms(name: string, ty: i32) {
  const atoms: string[] = []
  const mems: i32[] = []
  markValueUnionArms(
    atoms,
    mems,
    unionSetArmTysAB(87, name, ty, atoms, mems),
    ty,
  )
}

// `markValueUnionAtoms` over registered row `u`'s own members.
export function markValueUnionAtomsRow(u: i32) {
  const atoms: string[] = []
  const mems: i32[] = []
  let ty = -1
  if u >= 0 && u < unTyIx.length { ty = unTyIx[u] }
  markValueUnionArms(atoms, mems, unionRowArmTys(u, atoms, mems), ty)
}

// The usage bits one arm of box tag `k` forces. Bits: 1 i32, 2 string array, 4 i64, 8 f64, 16 f32,
// 32 v128, 64 i32 list, 128 boolean list, 256 f64 list, 512 string list, 1024 i64 list,
// 2048 f32 list, 4096 byte list, 8192 closure.
function armUseBits(k: i32): i32 {
  if k == 0 || k == 1 { return 1 }
  if k == 2 { return 2 }
  if k == 3 { return 4 }
  if k == 4 { return 8 }
  if k == 5 { return 16 }
  if k == 14 { return 32 }
  // A list member forces its list type so the wrapper heap the box payload rides exists — the
  // union annotation alone may be the only mention of that list type.
  if k == 7 { return 64 | 2 }
  if k == 17 || k == 18 { return 64 | 2 | 128 }
  if k == 8 { return 256 }
  if k == 9 { return 512 | 2 }
  if k == 10 { return 1024 }
  if k == 12 { return 2048 }
  if k == 13 { return 4096 }
  if k == 11 { return 8192 }
  0
}

// The usage bits of every arm of union type `ty`; a nullable contributes its inner's arms.
function tyArmUseBits(ty: i32): i32 {
  if ty < 0 { return 0 }
  const t = tyAt(ty)
  if t is TyUnion {
    let m = 0
    for x in t.uMembers { m = m | tyArmUseBits(x) }
    return m
  }
  if t is TyNullable { return tyArmUseBits(t.nInner) }
  armUseBits(boxTagOfTy(ty))
}

// The usage bits of one arm spelled `atom` in a row with no type: its value-atom kind's, or a
// string's when the spelling declares a literal union.
function atomArmUseBits(atom: string): i32 {
  if atom == "" { return 0 }
  const k = valueAtomKind(atom)
  if k < 0 && tyIsLitUnion(declTyIxOfName(atom)) { return armUseBits(2) }
  armUseBits(k)
}

// The marks for one union's `atoms`: read through member types `mems` when `cov`, else through
// the union's type `ty`, else (`ty` -1) through each atom's declared type.
function markValueUnionArms(
  atoms: string[],
  mems: i32[],
  cov: boolean,
  ty: i32,
) {
  let m = 0
  if cov || ty < 0 {
    let i = 0
    while i < atoms.length {
      if cov {
        m = m | armUseBits(boxTagOfTy(mems[i]))
      } else {
        m = m | atomArmUseBits(atoms[i])
      }
      i = i + 1
    }
  } else {
    m = tyArmUseBits(ty)
  }
  applyArmUseBits(m)
  if cov && unionMixesAtomList(mems) { vbAtomListUsed = true }
  0
}

// Sets the per-rep usage flags `m` names (bits as `armUseBits`). A packed byte-list member is
// the only arm that also decides a tag: `uAtomBandTop` reads `ba8Used` to lift the three
// slot-keyed bands off code 13's tag, so the mark lands before any tag is emitted.
function applyArmUseBits(m: i32) {
  if (m & 1) != 0 { vbI32Used = true }
  if (m & 2) != 0 { aUsed = true }
  if (m & 4) != 0 { vbI64Used = true }
  if (m & 8) != 0 { vbF64Used = true }
  if (m & 16) != 0 { vbF32Used = true }
  if (m & 32) != 0 { vbV128Used = true }
  if (m & 64) != 0 { lUsed = true }
  if (m & 128) != 0 && vbBoolListTop < 0 { vbBoolListTop = 0 }
  if (m & 256) != 0 { fa64Used = true }
  if (m & 512) != 0 { slUsed = true }
  if (m & 1024) != 0 { ia64Used = true }
  if (m & 2048) != 0 { fa32Used = true }
  if (m & 4096) != 0 { ba8Used = true }
  // A closure member rides the box anyref as the `$cloStructIdx` fat-pointer, so the closure
  // rec-group types must exist even when the union is the program's only function value.
  if (m & 8192) != 0 { fnValUsed = true }
  0
}

// Whether the arms `mems` hold a list of string-literal atoms beside another i32-storage list.
function unionMixesAtomList(mems: i32[]): boolean {
  let atom = false
  let other = false
  for m in mems {
    if boxTagOfTy(m) == 7 {
      if tyIsAtomLeafList(m) { atom = true } else { other = true }
    }
  }
  atom && other
}

// Lifts `vbAtomListTop` to the depth of every nested literal-union-leaf list arm of `mems` that
// shares its reflist slot with another arm, which would otherwise answer its tag too (D4914).
export function markAtomLeafListArms(mems: i32[]) {
  for a in mems {
    const d = atomLeafListDepthOfTy(a)
    if d >= 1 && d > vbAtomListTop && unMemIsRefElemArray(a) {
      const sl = rlSlotOfTy(tyRefArrElemOf(a))
      for b in mems {
        if (
          b != a
          && sl >= 0
          && atomLeafListDepthOfTy(b) != d
          && unMemIsRefElemArray(b)
        ) {
          if rlSlotOfTy(tyRefArrElemOf(b)) == sl { vbAtomListTop = d }
        }
      }
    }
  }
}

// Interns the map value-slot for every map arm of the union `name` — its box payload rides
// that arm's map struct ref, and `mapTagOf` needs the slot to exist. Forces the shared map
// heap flags and interns the arm's value shape via `mvShapeOfValNameTys`; a mono/atom value
// interns no slot (rides -1), a typed value gets a distinct mv slot and `mapSlotTag`.
export function markMapUnionArms(name: string, ty: i32) {
  const atoms: string[] = []
  const mems: i32[] = []
  markMapUnionArmsOf(atoms, mems, unionSetArmTysAB(102, name, ty, atoms, mems))
}

// `markMapUnionArms` over registered row `u`'s own members.
export function markMapUnionArmsRow(u: i32) {
  const atoms: string[] = []
  const mems: i32[] = []
  markMapUnionArmsOf(atoms, mems, unionRowArmTys(u, atoms, mems))
}

// The map-arm interning for one union's `atoms`, read through member types `mems` when `cov`.
function markMapUnionArmsOf(atoms: string[], mems: i32[], cov: boolean) {
  // D-UNION: a map arm is a `TyMap` member (`unMemIsMap`), not a `{[`-prefixed
  // rendering. The arm's stored atom TEXT still keys the (name-keyed) map-value slot
  // layer below (`mapValNameOf` → `mvShapeOfValNameTys`). Uncovered rows keep the name gate.
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    let isMap = false
    if cov {
      isMap = unMemIsMap(mems[i])
    } else {
      isMap = a != "null" && nameIsMap(a)
    }
    if isMap {
      mUsed = true
      lUsed = true
      aUsed = true
      let held = -1
      if cov { held = mems[i] }
      const sh = mvShapeOfMapHeldTy(a, held, -1, tyMapValOfHeld(held))
      if sh < 0 && mapShapeKeyKind(sh) != MAP_KEY_STR {
        markMapKeyUsed(mapShapeKeyKind(sh))
        mIntMonoArmUsed = true
      }
      if cov && sh != -3 { mapTwinNote(mems[i], mapShapeFoldSet(sh)) }
    }
    i = i + 1
  }
  0
}

// Forces the shared map machinery and interns the mv value slot of each map reached only as a
// closure result inside an annotation of type `ty` (or -1), which no `collectA` branch can see,
// so its call-result map ops would find no map type. Each function `ty` holds, itself or as a
// union member, forces its result; `| null` is peeled and a curried result is followed.
export function forceCloResultMapTypes(ty: i32) { forceCloMapTypesGo(ty, 8) }

// `forceCloResultMapTypes` at most `depth` curried results deep, so a recursive function alias ends.
function forceCloMapTypesGo(ty: i32, depth: i32) {
  if depth <= 0 { return 0 }
  const t0 = tyPeelNul(ty)
  if t0 < 0 { return 0 }
  const k = tyAt(t0)
  match k {
    TyFunc => {
      forceCloMapResult(t0, depth)
    }
    TyUnion => {
      let i = 0
      while i < k.uMembers.length {
        const m = tyPeelNul(k.uMembers[i])
        if m >= 0 && tyAt(m) is TyFunc { forceCloMapResult(m, depth) }
        i = i + 1
      }
    }
    TyPrim | TyErr | TyObj | TyNullable | TyArray | TyMap | TyVar | TyLit | TyNeg => {
      // Not a closure, nor a union with a closure member: no closure result to force.
    }
  }
  0
}

// The result of function type `fnTy`: a map, bare or nullable, forces the map machinery and
// interns its value slot; a function (a curried result) forces its own result.
function forceCloMapResult(fnTy: i32, depth: i32) {
  const ret = tyStepRet(fnTy)
  const r = tyPeelNul(ret)
  if r < 0 { return 0 }
  if tyMapHeld(r) < 0 { return forceCloMapTypesGo(r, depth - 1) }
  mUsed = true
  lUsed = true
  aUsed = true
  mvShapeOfMapHeldTy("", r, -1, tyMapValOfHeld(ret))
}

// Forces the backing of scalar list rep `sk`; false when `sk` names none.
function forceScalarListBacking(sk: VKind | null): boolean {
  // Exhaustive over `VKind | null` and `_`-less: a new scalar list rep must say what it forces.
  match sk {
    "strlist" => {
      slUsed = true
      aUsed = true
    }
    "f64list" => {
      fa64Used = true
    }
    "i64list" => {
      ia64Used = true
    }
    "f32list" => {
      fa32Used = true
    }
    "u8list" => {
      ba8Used = true
    }
    "list" => {
      lUsed = true
      aUsed = true
    }
    "i32" | "struct" | "str" | "union" | "reflist" | "map" | "variant" | "nulvariant" | "nulstruct" | "i64" | "f64" | "f32" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "v128" | null => {
      // Not a scalar list rep: nothing to force here.
      return false
    }
  }
  true
}

// A ref-element list of type `ty`: intern its element row and force the ref-list machinery, as
// a bare `S[]` annotation's branch does, else a value call keys a signature no producer interned.
function forceRefListOfTy(ty: i32) {
  rlUsed = true
  raUsed = true
  ensureRefElemTys(rlRowNameOfTy(tyStepElem(ty), false), -1, tyStepElem(ty))
  0
}

// Forces the backing of each list reached only as a closure's result or parameter inside an
// annotation of type `ty` (or -1), which no `collectA` branch can see, so a value call would
// find no list type. Each function `ty` holds, itself or as a union member, forces its result
// and parameters; `| null` is peeled at each level. The list dual of `forceCloResultMapTypes`.
export function forceCloResultListTypes(ty: i32) {
  const t0 = tyPeelNul(ty)
  if t0 < 0 { return 0 }
  const k = tyAt(t0)
  match k {
    TyFunc => {
      forceCloFnPositions(t0)
    }
    TyUnion => {
      let i = 0
      while i < k.uMembers.length {
        const m = tyPeelNul(k.uMembers[i])
        if m >= 0 && tyAt(m) is TyFunc { forceCloFnPositions(m) }
        i = i + 1
      }
    }
    TyPrim | TyErr | TyObj | TyNullable | TyArray | TyMap | TyVar | TyLit | TyNeg => {
      // Not a closure, nor a union with a closure member: no closure position to force.
    }
  }
  0
}

// The result and each parameter of function type `fnTy`, forced as one position each.
function forceCloFnPositions(fnTy: i32) {
  const k = tyAt(fnTy)
  if !(k is TyFunc) { return 0 }
  forceCloListOfTy(k.fnRet)
  let i = 0
  while i < k.fnParamTypes.length {
    forceCloListOfTy(k.fnParamTypes[i])
    i = i + 1
  }
  0
}

// One closure position of type `ty`: a scalar list forces its backing, a ref list its row, and a
// function (a curried position) its own positions.
function forceCloListOfTy(ty: i32) {
  const r = tyPeelNul(ty)
  if r < 0 { return 0 }
  if forceScalarListBacking(tyScalarListKind(r)) { return 0 }
  if tyIsRefArray(r) { return forceRefListOfTy(r) }
  forceCloFnPositions(r)
}

// True if the union member-set `name` has a map arm whose interned map value-slot is `slot`
// — the guard `emitUnionCoerce` uses before boxing a value with that arm's `mapSlotTag`. Arm
// and carrier compare canonically (`mvCanonRepOf`), so a twin-spelled carrier matches the arm
// it lowers as. A value matching no arm falls through rather than mis-tag.
export function unionHasMapArmSlot(name: string, ty: i32, slot: i32) {
  // A set compares as its key's map (they share one struct); an unsupported shape matches none.
  if slot == -3 { return false }
  const want = mapShapeFoldSet(slot)
  // D-UNION: the arm SHAPE test is structural (`unMemIsMap` — a `TyMap` member); the
  // SLOT comparison stays where it is, because a slot is a REP question and
  // `mvSlotOfMapValNameOrMonoKTy`/`mvCanonRepOf` already answer it canonically.
  const atoms: string[] = []
  const mems: i32[] = []
  const cov = unionSetArmTysAB(104, name, ty, atoms, mems)
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    let isMap = false
    if cov {
      isMap = unMemIsMap(mems[i])
    } else {
      isMap = a != "null" && nameIsMap(a)
    }
    if isMap {
      let aVt = -1
      if cov { aVt = tyMapValOf(unMemPeelAliasWrapper(mems[i])) }
      let armSlot = -1
      if cov && !nameIsMap(a) {
        armSlot = mapArmShapeOfTy(unMemPeelAliasWrapper(mems[i]))
      } else {
        armSlot = mvSlotOfMapNameTy(a, aVt)
      }
      if mvCanonRepOf(mapShapeFoldSet(armSlot)) == mvCanonRepOf(want) {
        return true
      }
    }
    i = i + 1
  }
  false
}

// True if the union member-set `name` has a MAP arm (`{[string]: V}`). Resolves an alias to its
// member set first. Used by the frame pre-pass (`exprHasMapOp` → `unionMapArmIdent`) to reserve the
// map scratch frame for a `t[k]` on a union binding narrowed to its map arm — the narrowing is not
// active in that pass, so the map op must be spotted from the binding's DECLARED union.
export function unionHasMapArm(name: string) { unionMapArmName(name) != "" }

// The map arm name of the union member-set `name`, or "" when it has none — the value-atom
// scheme carries one map arm per union. `mapReadMvSlot`'s narrowing-blind fallback resolves
// the arm's value mv slot from it, so a `t[k] ?? d` binding classifies its value union in the
// frame pre-pass, where the `is`-narrow that makes `t` a map is not active.
export function unionMapArmName(name: string) {
  const armTy: i32[] = []
  unionMapArmNameTy(name, armTy)
}

// The form that also hands back the arm's arena type, pushed onto `outTy` (empty when the
// arena leg did not decide the arm). The map-slot layer downstream is still name-keyed, so
// the spelling stays the return value, sparing the caller from re-deriving `V` from
// it. An out-array rather than a second function, since the arm is chosen by one walk.
export function unionMapArmNameTy(name: string, outTy: i32[]) {
  const atoms: string[] = []
  // Picks the map arm from the row's recorded arena member types (`unMemIsMap`) instead of
  // re-classifying each atom's rendered spelling with `nameIsMap`. The recorded member slice
  // is in atom order, so `atoms[m]` is this member's stored spelling, which the still-
  // name-keyed map-slot layer downstream needs. An uncovered row keeps the legacy name path.
  const mems: i32[] = []
  if unionArmTys(name, atoms, mems) {
    let m = 0
    while m < mems.length {
      if unMemIsMap(mems[m]) {
        outTy.push(mems[m])
        return atoms[m]
      }
      m = m + 1
    }
    return ""
  }
  let i = 0
  while i < atoms.length {
    if nameIsMap(atoms[i]) { return atoms[i] }
    i = i + 1
  }
  ""
}

// True when the CHECKED type of `exprIx` is a union carrying a MAP member, or a bare
// MAP (a narrowed occurrence records the NARROWED arm type, so the then-branch ident
// of `if t1 is {[string]: i32}` types TyMap, not the union) — the typed-IR net behind
// `unionMapArmIdent`'s syntactic miss.
export function nodeTyUnionHasMapArm(exprIx: i32, fnIx: i32): boolean {
  const ty = nodeTyAt(exprIx, fnIx)
  if ty < 0 { return false }
  const t = tyAt(ty)
  // Exhaustive over `Ty` and `_`-less: a new arena variant that can carry a map arm must be
  // asked here rather than take the `false`.
  match t {
    TyMap => {
      return true
    }
    TyUnion => {
      let i = 0
      while i < t.uMembers.length {
        if tyAt(t.uMembers[i]) is TyMap { return true }
        i = i + 1
      }
    }
    TyPrim | TyErr | TyObj | TyFunc | TyNullable | TyArray | TyVar | TyLit | TyNeg => {
      // Carries no map arm.
    }
  }
  false
}

// The initialiser, parens peeled, of the `let` of function `fnIx` the name read `readIx`
// denotes, or -1 when it denotes none or the binding has no initialiser.
function readLetInitOf(readIx: i32, fnIx: i32): i32 {
  const li = fnLetOfRead(fnIx, readIx)
  if li < 0 { return -1 }
  const d = nodeAt(li)
  if !(d is LetDecl) { return -1 }
  if d.letInit < 0 { return -1 }
  unwrapParen(d.letInit)
}

// The typed-IR net for the narrowed map-arm unbox gate: follows the read `readIx`'s rebind
// chain to its origin expression and tests whether the checker typed it as a union carrying a
// map member. The narrowed occurrence records the narrowed arm type (TyMap), so the receiver
// node itself cannot carry the gate, but the origin records the union before any narrowing.
export function identChainTyMapArmUnion(
  readIx: i32,
  fnIx: i32,
  depth: i32,
): boolean {
  if depth <= 0 { return false }
  const initIx = readLetInitOf(readIx, fnIx)
  if initIx < 0 { return false }
  if nodeAt(initIx) is Ident {
    return identChainTyMapArmUnion(initIx, fnIx, depth - 1)
  }
  const ty = nodeTyIxOf(initIx)
  if ty < 0 { return false }
  let uy = ty
  const tw = tyAt(ty)
  if tw is TyNullable { uy = tw.nInner }
  const tn = tyAt(uy)
  if tn is TyUnion {
    let i = 0
    while i < tn.uMembers.length {
      if tyAt(tn.uMembers[i]) is TyMap { return true }
      i = i + 1
    }
  }
  false
}

// The value-atom dual of `identChainTyMapArmUnion`: follows the read's rebind chain to its
// origin expression and tests whether the checker typed it as a boxed value union — 2+
// members, at least one non-literal. Consulted where the syntactic `unionNameOfIdent`
// cannot render the binding's union: skipping the unbox pushes the box ref where a raw narrowed atom belongs.
export function identChainTyBoxedUnion(
  readIx: i32,
  fnIx: i32,
  depth: i32,
): boolean {
  if depth <= 0 { return false }
  const initIx = readLetInitOf(readIx, fnIx)
  if initIx < 0 { return false }
  if nodeAt(initIx) is Ident {
    return identChainTyBoxedUnion(initIx, fnIx, depth - 1)
  }
  const ty = nodeTyIxOf(initIx)
  if ty < 0 { return false }
  let uy = ty
  const tw = tyAt(ty)
  if tw is TyNullable { uy = tw.nInner }
  const tn = tyAt(uy)
  if tn is TyUnion {
    if tn.uMembers.length < 2 { return false }
    let i = 0
    while i < tn.uMembers.length {
      if !(tyAt(tn.uMembers[i]) is TyLit) { return true }
      i = i + 1
    }
  }
  false
}

// The one answer for "the arena could not give me this union's member types" at every
// frame-reservation guard: `true`, the only sound answer. Every guard exists to
// reserve a frame slot the narrowing-blind pre-pass would otherwise miss, where an
// over-reservation is a harmless spare and an under-reservation is invalid wasm.
export function armPathArenaDeclined(): boolean { true }

// True if the union member-set `name` has a bare-closure arm. A closure is value-atom kind
// 11 (a ref atom riding the box anyref as the fat-pointer), and it tags on an interned slot,
// its signature's (`cloSigSlotTag`), since kind 11 alone cannot separate two function-typed
// arms. Mirrors `unionHasClosureArrayArm`, which tests the distinct closure-element array shape.
export function unionHasClosureArm(name: string) {
  const atoms: string[] = []
  // Value-atom kind 11 is "the member is a function type" — ask the arena
  // (`tyIxIsFunc`) rather than `valueAtomKind`'s spelling ladder.
  const mems: i32[] = []
  if unionArmTys(name, atoms, mems) {
    let m = 0
    while m < mems.length {
      if tyIxIsFunc(mems[m]) { return true }
      m = m + 1
    }
    return false
  }
  let i = 0
  while i < atoms.length {
    if valueAtomKind(atoms[i]) == 11 { return true }
    i = i + 1
  }
  false
}

// The bare-closure arm name of the union member-set `name`, or "" when it has none — the
// presence question `emitUnionCoerce` gates its closure-carrier box on. The returned name
// does not decide the box tag: only the arm's signature separates several function-typed
// arms, so the tag comes from the arena type (`unionClosureArmTy` -> `cloArmTagOfTy`).
export function unionClosureArmName(name: string) {
  const atoms: string[] = []
  // The arm selection is structural (`tyIxIsFunc`); the returned name stays the
  // member's stored spelling.
  const mems: i32[] = []
  if unionArmTys(name, atoms, mems) {
    let m = 0
    while m < mems.length {
      if tyIxIsFunc(mems[m]) { return atoms[m] }
      m = m + 1
    }
    return ""
  }
  let i = 0
  while i < atoms.length {
    if valueAtomKind(atoms[i]) == 11 { return atoms[i] }
    i = i + 1
  }
  ""
}

// D1098 — the arena type of the arm spelled `atom` in union `name`, or -1. The per-arm form
// of `unionClosureArmTy`, which answers for the first function arm only and cannot separate
// two closure signatures. Deliberately no name path beside the arena one: a top-level `=>`
// absorbs the `|` that follows it, so a member set that lost the split cannot be re-split.
export function unionArmTyOfAtom(name: string, atom: string): i32 {
  const atoms: string[] = []
  const mems: i32[] = []
  if unionArmTys(name, atoms, mems) {
    let m = 0
    while m < atoms.length {
      if atoms[m] == atom {
        if m < mems.length { return mems[m] }
      }
      m = m + 1
    }
  }
  0 - 1
}

export function unionClosureArmTy(name: string): i32 {
  const atoms: string[] = []
  const mems: i32[] = []
  if unionArmTys(name, atoms, mems) {
    let m = 0
    while m < mems.length {
      if tyIxIsFunc(mems[m]) { return mems[m] }
      m = m + 1
    }
  }
  -1
}

// The element value-union of union member-set `name`'s array arm whose element is itself a
// value union carrying a bare-closure member, read off that element's ref-list row; "" when
// no arm has one. Such an arm is a union-element array, not a bare closure element, so
// `unionHasClosureArrayArm` does not cover it.
export function unionClosureArrElemUnion(name: string) {
  const atoms: string[] = []
  const mems: i32[] = []
  if !unionArmTys(name, atoms, mems) { return "" }
  for m in mems {
    const a = tyAt(m)
    if a is TyArray {
      const slot = rlSlotOfTy(a.aElem)
      if slot >= 0 && rlElemKindAt(slot) == RLK_UNION {
        const el = rlElemName[slot]
        if isValueUnionName(el) && unionHasClosureArm(el) { return el }
      }
    }
  }
  ""
}

// The recorded member types of a member-set spelling, for the four ref-array arm
// scanners. `unionMemberTysOf` accepts an alias name too, but an alias must not expand
// here: the name loops these scanners replaced split an alias spelling into one atom,
// which no arm test accepts, so expanding it would be an extension, not a migration.
export function unionArmMemberTys(name: string, out: i32[]): boolean {
  if unionMemberSetOf(name) != name { return false }
  unionMemberTysOf(name, out)
}

// D947 — is `atom` one of the member spellings of the rendered set `name`? A pure string
// test on purpose: an ABI-kind derivation per member got the answer inverted, killing a
// live arm. The narrowed atom and the set's members are rendered by the same producer, so
// comparing spellings needs no kind derivation or canonicalisation.
export function unionSetHasAtom(name: string, atom: string): boolean {
  if name == "" { return false }
  if atom == "" { return false }
  const atoms: string[] = []
  unionSetAtomsOf(name, atoms)
  if atoms.length < 2 { return true }
  // Every member must be a plain scalar spelling, or this test means nothing: a set
  // carrying a shape, closure, array, or nested union renders members a name comparison
  // cannot decide, and answering "absent" for those elided live fixtures and trapped the
  // rep fuzzer. Answering true (present) on anything unrecognised keeps master's behaviour.
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    if a == atom { return true }
    if !nameIsPlainScalarAtom(a) { return true }
    i = i + 1
  }
  false
}

// A member spelling this file can compare by name: a bare primitive. Anything carrying a
// grouper is a shape / closure / array / nested union and is deliberately excluded.
function nameIsPlainScalarAtom(a: string): boolean {
  if a == "i32" { return true }
  if a == "i64" { return true }
  if a == "f32" { return true }
  if a == "f64" { return true }
  if a == "boolean" { return true }
  if a == "string" { return true }
  if a == "u8" { return true }
  if a == "null" { return true }
  // Excluded: `void` and `never` are no member, and a vector is not compared by name.
  if a == "void" { return false }
  if a == "never" { return false }
  if a == "v128" { return false }
  false
}

// True if the union member-set `name` has a ref-element array arm whose interned reflist
// slot is `slot` — the guard `emitUnionCoerce` uses to confirm a ref-array carrier matches
// an arm before boxing it with that arm's `refArrSlotTag`. A slot matching no arm falls
// through rather than mis-tag.
export function unionHasRefArrayArmSlot(name: string, slot: i32) {
  // A carrier with no row (-1) must not match a member with no arm row, which is -1 too.
  if slot < 0 { return false }
  const mems: i32[] = []
  if !unionArmMemberTys(name, mems) { return false }
  let i = 0
  while i < mems.length {
    if unMemRefArrArmSlot(mems[i]) == slot { return true }
    i = i + 1
  }
  false
}

// The interned reflist slot of a union-box-element ref-array arm of `name` whose element
// union admits the member atom `elemAtom` (exact match), or -1. An empty `elemAtom` (an
// empty `[]` literal) matches the first union-box-element arm, since an empty list's
// element type is vacuous and the checker already proved the literal fits the union.
export function unionRefArrayArmSlotForElem(name: string, elemAtom: string) {
  const exact = unionRefArrayArmSlotForElemAtom(name, elemAtom)
  if exact >= 0 { return exact }
  // Literal-widening admission: the probe classifies a bare int literal as "i32" and a
  // float literal as "f64", but the checker already admits it into a wider scalar element
  // union. Without this the exact-atom miss let the literal fall to the value-atom ladder,
  // boxing a raw scalar list with a non-matching tag — every `is` on it silently false.
  if elemAtom != "i32" && elemAtom != "f64" {
    // No other atom widens: an i64, f32, u8, string or ref element matches exactly or not at all.
    return -1
  }
  if elemAtom == "i32" {
    const wi = unionRefArrayArmSlotForElemAtom(name, "i64")
    if wi >= 0 { return wi }
    const wf = unionRefArrayArmSlotForElemAtom(name, "f64")
    if wf >= 0 { return wf }
  }
  unionRefArrayArmSlotForElemAtom(name, "f32")
}

// The exact-atom pass of `unionRefArrayArmSlotForElem`: the first union-box-element
// ref-array arm whose element union carries `elemAtom` verbatim (any arm for "").
function unionRefArrayArmSlotForElemAtom(name: string, elemAtom: string) {
  const mems: i32[] = []
  if !unionArmMemberTys(name, mems) { return -1 }
  let i = 0
  while i < mems.length {
    const slot = unMemRefArrArmSlot(mems[i])
    if slot >= 0 && rlElemKindAt(slot) == RLK_UNION {
      if elemAtom == "" { return slot }
      const en = rlElemName[slot]
      const eAtoms: string[] = []
      unionArmsOf(en, eAtoms)
      let j = 0
      while j < eAtoms.length {
        if eAtoms[j] == elemAtom { return slot }
        j = j + 1
      }
      // R3's boxed-member rule: a litunion member of a value union rides the box as the
      // `string` atom. Without this leg a `(K | i32)[]` arm is invisible to a
      // string-element literal — invalid wasm.
      if elemAtom == "string" && elemUnionHasLitUnionMember(en) { return slot }
    }
    i = i + 1
  }
  -1
}

// True when the element union row `en` has a literal-union member; false for an uncovered row.
function elemUnionHasLitUnionMember(en: string): boolean {
  const ms: i32[] = []
  if !unionMemberTysOf(en, ms) { return false }
  for m in ms {
    if m >= 0 && tyIsLitUnion(m) { return true }
  }
  false
}

// True when the element union row `en` has a list member; false for an uncovered row.
function elemUnionHasArrayMember(en: string): boolean {
  const ms: i32[] = []
  if !unionMemberTysOf(en, ms) { return false }
  for m in ms {
    if m >= 0 && tyAt(m) is TyArray { return true }
  }
  false
}

// The interned reflist slot of the first union-box-element ref-array arm of `name` whose
// element union carries an atom that is itself an array (`wantMap` false) or a map
// (`wantMap` true) — the arm a nested list or map-element literal has to build through.
// Structural on the element union's own atoms, not nominal on the union name (D1016).
export function unionRefArrayArmSlotForNestedElem(
  name: string,
  wantMap: boolean,
) {
  const mems: i32[] = []
  if !unionArmMemberTys(name, mems) { return -1 }
  let i = 0
  while i < mems.length {
    const slot = unMemRefArrArmSlot(mems[i])
    if (
      slot >= 0
      && slot < rlElemTyIx.length
      && rlElemKindAt(slot) == RLK_UNION
    ) {
      if wantMap {
        const eAtoms: string[] = []
        unionArmsOf(rlElemName[slot], eAtoms)
        for a in eAtoms {
          if nameIsMapOpen(a) { return slot }
        }
      } else {
        if elemUnionHasArrayMember(rlElemName[slot]) { return slot }
      }
    }
    i = i + 1
  }
  -1
}

// The interned reflist slot of an array-of-map arm of `name` whose element map's value
// rep matches the literal element's map shape `mvShape` (canonical rep, `mvCanonRepOf`),
// or -1. `emitUnionCoerce` routes an array literal of map exprs (invisible to
// `exprRefArray`) into the arm's build and tag; an unmatched literal keeps the loud reject.
export function unionRefArrayArmSlotForMapElem(name: string, mvShape: i32) {
  if mvShape < -1 { return -1 }
  // The arm shape test is `unMemIsMapArray`, and the `nameIsMapMemberUnion` exclusion
  // is free structurally, since a map-member union element is a `TyUnion`. The arm row is
  // `unMemRefArrArmSlot`, and the arm's map-value slot is the ref-list layer's own
  // chokepoint `rlElemMapValMvSlot`.
  const mems: i32[] = []
  if !unionArmMemberTys(name, mems) { return -1 }
  let i = 0
  while i < mems.length {
    if unMemIsMapArray(mems[i]) {
      const slot = unMemRefArrArmSlot(mems[i])
      if (
        slot >= 0
        && slot < rlElemTyIx.length
        && rlElemKindAt(slot) == RLK_MAP
      ) {
        const armMv = rlElemMapValMvSlot(slot)
        if armMv == -1 && mvShape == -1 { return slot }
        if armMv >= 0 && mvShape >= 0 {
          if mvCanonRepOf(armMv) == mvCanonRepOf(mvShape) { return slot }
        }
      }
    }
    i = i + 1
  }
  -1
}

// The interned reflist slot of the single nested-array arm of `name` (an arm whose
// element is itself a list, kinds 4/6/7/8/9/10), or -1 when the union has no such arm or
// more than one — an ambiguous route stays the loud reject. `emitUnionCoerce` routes an
// ArrayLit carrier through this arm's own build so the inner lists build the arm's own leaf.
export function unionNestedArrayArmSlot(name: string) {
  // The arm rows come off the recorded member types, asking `unMemRefArrArmSlot` (does a
  // row exist for the member's element) rather than the shape predicate `unMemIsRefElemArray`,
  // since that predicate is a strict superset of `nameIsRefArray` and an inert
  // over-accept is still not an equality.
  const mems: i32[] = []
  if !unionArmMemberTys(name, mems) { return -1 }
  let found = -1
  let n = 0
  let i = 0
  while i < mems.length {
    const slot = unMemRefArrArmSlot(mems[i])
    if slot >= 0 && slot < rlElemTyIx.length {
      const k = rlElemKindAt(slot)
      if (
        k == RLK_I32_LIST
        || k == RLK_STR_LIST
        || k == RLK_F64_LIST
        || k == RLK_I64_LIST
        || k == RLK_REF_LIST
        || k == RLK_F32_LIST
      ) {
        found = slot
        n = n + 1
      }
    }
    i = i + 1
  }
  if n == 1 { return found }
  -1
}

// True if the union member-set `name` has an array-of-map arm. The frame pre-pass
// consults this (via `unionMapArrayElemIndex`) to reserve the map scratch for a `t[i][k]`
// read on a union binding narrowed to its map-array arm, since the narrowing is not active
// in that pass — the map-array twin of `unionHasMapArm`.
export function unionHasMapArrayArm(name: string) {
  const atoms: string[] = []
  // A `TyArray` over a `TyMap` (`unMemIsMapArray`). The name path's
  // `!nameIsMapMemberUnion(elem)` guard is free structurally — a map-member union
  // element is a `TyUnion`, never a `TyMap`, however it renders.
  const mems: i32[] = []
  if unionArmTys(name, atoms, mems) {
    let m = 0
    while m < mems.length {
      if unMemIsMapArray(mems[m]) { return true }
      m = m + 1
    }
    return false
  }
  armPathArenaDeclined()
}

// The inferred `T|null` union name of the null-init `LetDecl` at `letIx`, or "".
export function nliNameOf(letIx: i32) {
  let i = 0
  while i < nliLetIxs.length {
    if nliLetIxs[i] == letIx { return nliNames[i] }
    i = i + 1
  }
  ""
}

// Drops the inferred-union row of the `LetDecl` at `letIx`, for a rewrite that changed what
// the binding holds. The union stays registered; only the binding stops naming it.
export function nliForgetLet(letIx: i32) {
  let i = 0
  while i < nliLetIxs.length {
    if nliLetIxs[i] == letIx { nliLetIxs[i] = -1 }
    i = i + 1
  }
  0
}

// The value-union name an un-annotated if-expression binding init carries, or "" when it
// is not a value union the box can hold (a non-union if, a `string | null` niche, or an
// arm the static pre-pass cannot classify). The canonical name is the deduped arm atoms in
// arm order, with a trailing `|null` when any arm or the else-less path is null.
export function ifExprNliName(ifIx: i32) {
  const atoms: string[] = []
  const hn = ifExprCollectAtoms(ifIx, atoms)
  if hn == -2 { return "" }
  if atoms.length == 0 { return "" }
  // Mixed numeric arms widen to a single numeric — they are not a union, and this static
  // atom list cannot do that lattice join. Bail so the numeric value-position-if path
  // (`letIsF64`/`letIsI64`) handles them instead. A single numeric scalar is fine.
  let numCount = 0
  let j = 0
  while j < atoms.length {
    const k = valueAtomKind(atoms[j])
    if k == 0 || k == 3 || k == 4 || k == 5 { numCount = numCount + 1 }
    j = j + 1
  }
  if numCount >= 2 { return "" }
  let nm = ""
  let i = 0
  while i < atoms.length {
    if nm != "" { nm = nm + "|" }
    nm = nm + atoms[i]
    i = i + 1
  }
  if hn == 1 { nm = nm + "|null" }
  // Only a value union the box rep can hold (≥2 non-null atoms, or one NUMERIC scalar +
  // null) registers here — a `string | null` niche / a non-union stay on their own paths.
  if !isValueUnionName(nm) { return "" }
  nm
}

// The only writer of `uVariants`, so its sid index cannot drift from it: the row is
// recorded as the name is appended and the first spelling keeps the slot. `sidOf` mints
// here and `variantIndexOf` probes with `sidLookup`, so a name never pushed reads absent.
export function uVariantsPush(name: string) {
  const s = sidOf(name)
  if sidArrGet(uVariantRowBySid, s) < 0 {
    sidArrPut(uVariantRowBySid, s, uVariants.length)
  }
  uVariants.push(name)
  0
}

// A row whose recorded type is exactly `ty` — the index rung of the hybrid identity below,
// with no kind test of its own so the caller's own arms decide when it may fire (D1490).
function unRowHasTyIx(ty: i32): boolean { i32ListHas(unTyIx, ty) }

// "Is this a registered union", answered without the spelling — the hybrid identity. A
// declared union's identity is its declaration, matching by arena index; an inline union
// has no declaration, so its identity is structural, matched with `tySame` against
// `unMemTys`. Interning would have made the second cheap and destroyed the first.
export function isUnionOfTy(ty: i32): boolean {
  if ty < 0 { return false }
  if ty >= T.tys.length { return false }
  const t = tyAt(ty)
  // Exhaustive over `Ty` and `_`-less: `A | null` is a spelling the registry keys with `null`
  // as a member atom while the checker puts nullability in a wrapper, so both shapes answer
  // here and both compare arena indices structurally rather than re-render.
  match t {
    TyNullable => {
      // The index rung belongs inside the shape arms (D1490): the mint resolves a row's
      // spelling, and for a union whose members share a shape that resolver answers a member,
      // so a rung firing for any `ty` would call a declared struct a union.
      if unRowHasTyIx(ty) { return true }
      let rn = 0
      while rn < unMemTyCount.length {
        if unDeclIx[rn] < 0 && unMemTyCount[rn] == 2 {
          const stn = unMemTyStart[rn]
          if stn >= 0 {
            const a0 = unMemTys[stn]
            const a1 = unMemTys[stn + 1]
            if isNullTy(a1) {
              if tySame(a0, t.nInner) { return true }
            }
            if isNullTy(a0) {
              if tySame(a1, t.nInner) { return true }
            }
          }
        }
        rn = rn + 1
      }
    }
    TyUnion => {
      if unRowHasTyIx(ty) { return true }
      let r = 0
      while r < unMemTyCount.length {
        if unDeclIx[r] < 0 && unMemTyCount[r] == t.uMembers.length {
          const st = unMemTyStart[r]
          if st >= 0 {
            let k = 0
            let same = true
            while k < t.uMembers.length {
              if !tySame(unMemTys[st + k], t.uMembers[k]) { same = false }
              k = k + 1
            }
            if same { return true }
          }
        }
        r = r + 1
      }
    }
    TyPrim | TyErr | TyObj | TyFunc | TyArray | TyMap | TyVar | TyLit | TyNeg => {
      // No union row keys this shape.
    }
  }
  false
}

// The arena row a TypeRef node's spelling denotes. Canon rewrites `tyName` in place and
// banks the rewrite in `canonTyIxCol` at the same moment, so a rewritten node's name is a
// compiler-produced spelling whose row is that column, not the pre-canon recorded type.
export function annRowOfNode(ix: i32): i32 {
  if canonRewroteNode(ix) { return canonTyIxOf(ix) }
  nodeTyIxOf(ix)
}

// The only writer of `unNames`, so its sid index cannot drift from it — the variant-table
// twin of `uVariantsPush`, first spelling keeping the slot. The row's parallel columns stay
// the caller's to push, since the three mint sites fill different ones.
export function unNamesPush(name: string) {
  const s = sidOf(name)
  if sidArrGet(unRowBySid, s) < 0 { sidArrPut(unRowBySid, s, unNames.length) }
  unNames.push(name)
  0
}

// Binds spelling `name` to row `u`, by its sid and by its union key, so both lookups read `u`.
export function unNameBindRow(name: string, u: i32) {
  sidArrPut(unRowBySid, sidOf(name), u)
  unKeyAliasRow(canonUnionKeyOfName(name), u)
  0
}

// Names the registered row whose type key is arena union `ty`'s by `name` too, so a
// record's shape spelling and its declared name read one box and one set of tags (D4930). The
// row, or -1 when no row holds that type. The spelling's key finds the row as its name does.
export function unNameShareTyKeyRow(name: string, ty: i32): i32 {
  if unNameBound(name) { return unRowOfName(name) }
  const u = unRowOfTyKey(ty)
  if u < 0 { return -1 }
  sidArrPut(unRowBySid, sidOf(name), u)
  unKeyAliasRow(canonUnionKeyOfName(name), u)
  u
}

// The union alias name that owns global variant `vi` (assumes `vi` is a variant of some
// declared union), or "" if none — interns a ref-list-of-union keyed by the specific
// union, so `Node[]` and `Ty[]` are distinct table slots.
export function unionNameOfVariant(vi: i32) {
  const u = unionOfVariant(vi)
  if u >= 0 { return unNames[u] }
  ""
}

// Resolves `name`'s arm spellings via `unionArmsOf` into `atoms`, then fills `tys` with their
// arena types in the row's box-tag ABI order — true only when the row covers all of them 1:1.
// `atoms` and `tys` stay index-parallel either way; on `false`, `tys` is left untouched and
// the caller keeps its own spelling-based fallback.
export function unionArmTys(
  name: string,
  atoms: string[],
  tys: i32[],
): boolean {
  const nm = unionArmsOf(name, atoms)
  unionMemberTysOf(nm, tys) && tys.length == atoms.length
}

// `isUNameOwnAB` for a binding's annotation node, keyed on the spelling canon left on the node.
export function isUNameAnnAB(site: i32, annIx: i32): boolean {
  isUNameABAt(site, tyNameOf(annIx), annRowOfNode(annIx), true)
}

// The value-union mint's seam. `registerValueUnionName` resolves the spelling once at the
// boundary; a switched site, mode 2, or the inline mint over a type `valueUnionTyIsFlat` accepts
// mints from the caller's id instead. Armed, it then asks the read seams' question: does the
// caller's id name the row the spelling now names.
export function registerValueUnionNameAB(
  site: i32,
  name: string,
  ty: i32,
): i32 {
  const k = ty >= 0
    && (unSiteOnKey(site)
    || unABMode == 2
    || (site == 55 && valueUnionTyIsFlat(ty)))
  if k {
    registerValueUnionNameTy(name, ty)
  } else {
    registerValueUnionNameTy(name, declTyIxOfName(name))
  }
  softKeyProbe(site, name, ty)
  if unABOn() == 0 { return 0 }
  let dr = -1
  if ty >= 0 { dr = unRowOfTyAB(site, ty) }
  unABProbe(site, unRowOfName(name), dr, ty)
  0
}

// Whether `ty` is a value union whose members are its spelling's atoms: no literal member, which
// the spelling softens to its base, and no nested union alias, which the spelling flattens.
function valueUnionTyIsFlat(ty: i32): boolean {
  if isValueUnionTyOr(ty) != 1 { return false }
  let u = ty
  const t = tyAt(ty)
  if t is TyNullable { u = t.nInner }
  if u < 0 { return false }
  const ut = tyAt(u)
  if ut is TyUnion {
    for m in ut.uMembers {
      if m < 0 { return false }
      const mt = tyAt(m)
      if mt is TyUnion { return false }
    }
  }
  true
}
