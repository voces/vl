// Type-parameter bounds and places: the bound a `T` reads its members from, and the element,
// cell and store type of an indexed place. Emptied by `tpBoundReset`.
// Does not import the checker.
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  ErrExpr,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  ImportDecl,
  Index,
  IsExpr,
  LetDecl,
  MatchExpr,
  Member,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  Param,
  Paren,
  Program,
  RetStmt,
  Spread,
  StrLit,
  TypeDecl,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
  nodeAt,
} from "./ast"
import { TyArray, TyMap, TyVar, mkNullableTy, tyAt } from "./check_types"
import { primNameOf } from "./tyquery"
import { HD_ELEMV } from "./check_hole_pins"
import { mkDerivedHole } from "./check_coal"

// `tpBound*` — the bounds live while a bounded body is checked, pushed beside the `tpEnv`
// stack by `checkFuncDeclNode` and popped with it. A separate stack rather than a third
// `tpEnv` column because `tpEnv` is pushed from four places and only the body can host a
// member access on a `T`, so aligning a third column at the other three buys nothing.
export let tpBoundNames: string[] = []
export function tpBoundNamesPop(): string | null { tpBoundNames.pop() }
export function tpBoundNamesPush(v: string) { tpBoundNames.push(v) }

export let tpBoundAnns: i32[] = []
export function tpBoundAnnsPop() {
  tpBoundAnns.pop()
  0
}
export function tpBoundAnnsPush(v: i32) { tpBoundAnns.push(v) }

// The bound annotation live for type-parameter `name`, or -1 — innermost wins, so
// a nested generic's `<T>` shadows an enclosing one exactly as `tpEnvTyOfName` does.
export function tpBoundOfName(name: string) {
  let i = tpBoundNames.length - 1
  while i >= 0 {
    if tpBoundNames[i] == name { return tpBoundAnns[i] }
    i = i - 1
  }
  -1
}

// ── the coherence ledger ─────────────────────────────────────────────────────

// The type of an element READ off `baseTy` for narrowing purposes (no diagnostics) —
// `placeFieldTy`'s index twin. -1 when unresolvable, which is how "no fact" is spelled. A map
// cell reads `V | null` because the key may be absent, and `!= null` proves it present for
// exactly as long as `callInvalidatesReal`'s remover rule lets the narrowing stand (D1734).
export function placeElemTy(baseTy: i32) {
  if baseTy < 0 { return -1 }
  const bt = tyAt(baseTy)
  if bt is TyArray {
    if primNameOf(bt.aElem) == "u8" { return -1 }
    return bt.aElem
  }
  if bt is TyVar { return holePlaceElemTy(baseTy, bt) }
  // The other indexable container, which is its own function so this one keeps a single
  // arm: a map cell's read type is not its storage type, and the two questions differ
  // enough that a second arm here would read as one rule (D1734).
  placeMapCellTy(baseTy)
}

// The map half of `placeElemTy`: a cell READS `V | null`, because the key may be absent. A
// scalar value of every width narrows alike: the null test probes the key, and the narrowed
// read is the stored scalar, whatever a miss would have read as (D1734, D9630).
function placeMapCellTy(baseTy: i32) {
  const bt = tyAt(baseTy)
  if bt is TyMap { return mkNullableTy(bt.mVal) }
  -1
}

// The type an index place STORES, for `writeStorageTy` — an array element as it reads, and a
// map cell WITHOUT the `| null` its read manufactures for an absent key. One function
// answering both would widen what `m[k] = …` accepts to include `null` (D1734).
export function placeCellStoreTy(baseTy: i32) {
  if baseTy < 0 { return -1 }
  const bt = tyAt(baseTy)
  if bt is TyMap { return bt.mVal }
  placeElemTy(baseTy)
}

// The element a read off hole `hole` derives, as `checkIndexNode` types it, so a null test on
// `z[0]` narrows a hole's cell the way it narrows a declared list's (D3287). -1 for a hole that
// reads its members from a bound.
function holePlaceElemTy(hole: i32, ht: TyVar): i32 {
  if ht.tvName.length == 0 { return -1 }
  if ht.tvName[0] != '?' && tpBoundOfName(ht.tvName) >= 0 { return -1 }
  mkDerivedHole(HD_ELEMV, "", -1, -1, hole)
}

// Whether the place runs through a `?.` hop — its negation is then not a sound else-branch
// refinement, the chain being possibly null because a receiver is. The paren arm here is a safety
// rung, not a capability one (D352): without it `if (x?.y) is string { … } else { … }` answers
// false, and the else branch narrows a place that may be null because its receiver is.
export function placeHasOptionalHop(ix: i32) {
  const n = nodeAt(ix)
  match n {
    Paren => {
      return placeHasOptionalHop(n.parInner)
    }
    OptMember => {
      return true
    }
    Member => {
      return placeHasOptionalHop(n.memObj)
    }
    // no other node has a receiver hop
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread => {}
  }
  false
}

export function tpBoundReset() {
  tpBoundNames = []
  tpBoundAnns = []
}
