// A check-time shadow of the elaboration's mint facts: for each call with a binding row, the calls
// its callee's body makes through a parameter the row binds to a function set, with the call's
// argument types and each member's result at them, by substitution. Depth 1 only: a call the
// callee's body makes binds no further instance here. An instrument only; no pass reads it.
// `mintShadowDump` prints the shadow's rows and the elaboration's beside them.
import {
  Call,
  FuncDecl,
  Ident,
  Index,
  LetDecl,
  LoopVar,
  Member,
  P,
  Param,
  i32ToStr,
  nodeAt,
  nodeChildrenPush,
} from "./ast"
import {
  callBindCount,
  callBindIxAt,
  callBindNamesAt,
  callBindTysAt,
} from "./check_bind_rows"
import { quietEnterFlat, quietLeaveFlat } from "./check_cursor"
import { elabCallDeclOf, fnTagMembers, fnTagSetOfTy } from "./check_elab_cap"
import {
  mintFactCallOf,
  mintFactFnOf,
  mintFactRows,
  mintFactRsOf,
  mintFactSetOf,
} from "./check_mint"
import { nodeTyIxOf, nodeTyOf } from "./check_node_tys"
import { substTyDeep, widenLitTy } from "./check_relate_core"
import { T, TyFunc, TyVar, tyAt, tyToStr } from "./check_types"
import { identDeclOf } from "./symbols"
import { tyHasTyVar } from "./tyquery"

// Type `t` as text, "?" when it is no arena row.
function msTyStr(t: i32): string {
  if t < 0 || t >= T.tys.length { return "?" }
  return tyToStr(t)
}

// The names of set `s`'s members, comma-separated, a lambda by its node.
function msMembers(s: i32): string {
  let o = ""
  for m in fnTagMembers(s) {
    const n = nodeAt(m)
    const nm = if n is FuncDecl && n.fnName != "" { n.fnName } else { "lam" + i32ToStr(m) }
    o = if o == "" { nm } else { o + "," + nm }
  }
  return o
}

// The name of declaration `d`, "?" when it is not a function.
function msDeclName(d: i32): string {
  if d < 0 || d >= P.nodes.length { return "?" }
  const n = nodeAt(d)
  return if n is FuncDecl { n.fnName } else { "?" }
}

// Member `m`'s declared result with its parameters at `wp`, widened; -1 when it has no signature.
function msMemberResult(m: i32, wp: i32[]): i32 {
  const sig = nodeTyIxOf(m)
  if sig < 0 || sig >= T.tys.length { return -1 }
  const ft = tyAt(sig)
  if !(ft is TyFunc) || ft.fnRet < 0 { return -1 }
  const names: string[] = []
  const tys: i32[] = []
  let i = 0
  while i < ft.fnParamTypes.length && i < wp.length {
    const pv = tyAt(ft.fnParamTypes[i])
    if pv is TyVar {
      names.push(pv.tvName)
      tys.push(wp[i])
    }
    i = i + 1
  }
  return widenLitTy(substTyDeep(ft.fnRet, names, tys))
}

// The rows for one call `c` through a parameter bound to set `s`, under the row's bindings.
function msCallRow(
  d: i32,
  c: Call,
  ix: i32,
  s: i32,
  names: string[],
  tys: i32[],
): string {
  const wp: i32[] = []
  for a in c.callArgs {
    wp.push(widenLitTy(substTyDeep(nodeTyOf(a), names, tys)))
  }
  let open = false
  for w in wp {
    if w < 0 || tyHasTyVar(w) { open = true }
  }
  let rs = ""
  for m in fnTagMembers(s) {
    const r = msTyStr(msMemberResult(m, wp))
    rs = if rs == "" { r } else { rs + ";" + r }
  }
  return (if open { "MINT shadow-open " } else { "MINT shadow " })
    + msDeclName(d)
    + " "
    + i32ToStr(ix)
    + " {"
    + msMembers(s)
    + "} "
    + rs
    + "\n"
}

// The rows of call-bind row `r`: the calls `d`'s body makes through each parameter bound to a set.
function msBindRow(r: i32): string {
  const d = elabCallDeclOf(callBindIxAt(r))
  if d < 0 || d >= P.nodes.length { return "" }
  const fd = nodeAt(d)
  const sig = nodeTyIxOf(d)
  if !(fd is FuncDecl) || sig < 0 || sig >= T.tys.length { return "" }
  const ft = tyAt(sig)
  if !(ft is TyFunc) { return "" }
  const names = callBindNamesAt(r)
  const tys = callBindTysAt(r)
  let out = ""
  let i = 0
  while i < fd.fnParams.length && i < ft.fnParamTypes.length {
    const p = fd.fnParams[i]
    const s = fnTagSetOfTy(substTyDeep(ft.fnParamTypes[i], names, tys))
    if s >= 0 && p >= 0 && p < P.nodes.length && nodeAt(p) is Param {
      const todo: i32[] = [fd.fnBody]
      while todo.length > 0 {
        const ix = todo.pop() ?? -1
        if ix < 0 || ix >= P.nodes.length { continue }
        const n = nodeAt(ix)
        if (
          n is Call
          && n.callFn >= 0
          && n.callFn < P.nodes.length
          && identDeclOf(n.callFn) == p
        ) {
          out = out + msCallRow(d, n, ix, s, names, tys)
        }
        nodeChildrenPush(ix, todo)
      }
    }
    i = i + 1
  }
  return out
}

// Why fact call `ix` of declaration `d` has the rows it has: its callee's shape, and how many
// binding rows reach `d`, and bind one of its parameters to a set.
function msWhy(d: i32, ix: i32): string {
  let shape = "other"
  if ix >= 0 && ix < P.nodes.length {
    const n = nodeAt(ix)
    if n is Call && n.callFn >= 0 && n.callFn < P.nodes.length {
      const f = nodeAt(n.callFn)
      const dd = if f is Ident { identDeclOf(n.callFn) } else { -1 }
      const dn = if dd >= 0 && dd < P.nodes.length { nodeAt(dd) } else { nodeAt(0) }
      shape = if f is Ident && dn is Param { "param" } else if f is Ident && dn is LetDecl { "local" } else if f is Ident && dn is LoopVar { "loopvar" } else if f is Ident { "ident" } else if f is Member { "member" } else if f is Index { "index" } else { "other" }
    }
  }
  let rows = 0
  let setRows = 0
  let r = 0
  while r < callBindCount() {
    if elabCallDeclOf(callBindIxAt(r)) == d {
      rows = rows + 1
      const fd = nodeAt(d)
      const sig = nodeTyIxOf(d)
      if fd is FuncDecl && sig >= 0 && sig < T.tys.length {
        const ft = tyAt(sig)
        if ft is TyFunc {
          for pt in ft.fnParamTypes {
            if (
              fnTagSetOfTy(
                substTyDeep(pt, callBindNamesAt(r), callBindTysAt(r)),
              )
              >= 0
            ) {
              setRows = setRows + 1
            }
          }
        }
      }
    }
    r = r + 1
  }
  return shape + " rows=" + i32ToStr(rows) + " setrows=" + i32ToStr(setRows)
}

// The shadow's rows, then the elaboration's standing fact rows, one `MINT` line each.
export function mintShadowDump(): string {
  let out = ""
  const q = quietEnterFlat()
  let r = 0
  while r < callBindCount() {
    out = out + msBindRow(r)
    r = r + 1
  }
  quietLeaveFlat(q)
  for f in mintFactRows() {
    let rs = ""
    for t in mintFactRsOf(f) {
      rs = if rs == "" { msTyStr(t) } else { rs + ";" + msTyStr(t) }
    }
    out = out
      + "MINT elab "
      + msDeclName(mintFactFnOf(f))
      + " "
      + i32ToStr(mintFactCallOf(f))
      + " {"
      + msMembers(mintFactSetOf(f))
      + "} "
      + rs
      + "\n"
    out = out
      + "MINT why "
      + msDeclName(mintFactFnOf(f))
      + " "
      + i32ToStr(mintFactCallOf(f))
      + " "
      + msWhy(mintFactFnOf(f), mintFactCallOf(f))
      + "\n"
  }
  return out
}
