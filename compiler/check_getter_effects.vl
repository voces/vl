// Getter resolution and the effect summary a getter body is held to: the getter
// registry reads, the per-row cost and fact walk (`es*`, `gc*`) and the text a refusal
// prints, the type-parameter binding and erasure that walk uses, and the sole-reference
// and value-use tables a narrowed read consults.
// Does not import the checker.
import { declDepthOf, declTyOf } from "./check_scopes"
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  ErrExpr,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  ImportDecl,
  Index,
  IsExpr,
  LetDecl,
  LoopVar,
  MatchExpr,
  Member,
  Node,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  Program,
  RetStmt,
  Spread,
  StrLit,
  TypeDecl,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
  adoptNodeTok,
  arenaEditBumpCount,
  arenaEditCount,
  arenaEditSlotAt,
  arenaEpochNow,
  arenaSetNode,
  binderNameAt,
  declNameTokOf,
  elseIfLink,
  extGMut,
  externGlobalLinkOfName,
  externLinkOf,
  getDeclExported,
  getDeclPropOf,
  i32ToStr,
  mkIdent,
  nodeAt,
  nodeSpineChildren,
  nodeToks,
  opDeclLabel,
  opDeclOpOf,
  ufcsModOfNode,
} from "./ast"
import {
  BME_NONE,
  builtinMethodEffect,
  builtinMethodNamesOf,
  opIdxDeclared,
  opSiteDecls,
} from "./check_callee"
import { nodeLineOf } from "./check_capture_loss"
import {
  crAskProg,
  crFnBases,
  crOpOpaque,
  crProgRoot,
  crSoleDecls,
  crSoleDepths,
  crSoleRoots,
  crSoleTys,
  crValUseDecls,
  crValUseDyn,
  crValUseGetProps,
  crValUseRoot,
  cvuBumps,
  cvuDecls,
  cvuEpoch,
  cvuIdxDecl,
  cvuIdxIx,
  cvuLogAt,
  cvuMemDecl,
  cvuMemIx,
  cvuSlotOf,
} from "./check_capture_rows"
import { crCurRoot } from "./check_capture_widen"
import { inferQuiet } from "./check_cursor"
import {
  ES_UNBOUNDED,
  esAlloc,
  esAllocVia,
  esBindCount,
  esBindNames,
  esBindStart,
  esBindTys,
  esCost,
  esDecl,
  esFrame,
  esHost,
