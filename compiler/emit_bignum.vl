// `emit_bignum.vl` — arbitrary-precision integer math and numeric-literal helpers used
// by the emitter. A `bignum` is a little-endian `i32[]` of base-2^16 limbs, powering the
// i64 and `2^31` literal range checks. A self-contained leaf: no emitter state beyond its
// own `gDivRemNonzero` flag, and no cross-module calls.

// Scratch out-param for `bigDivmod`: set to `true` when the division left a nonzero
// remainder (the IEEE-754 "sticky" bit). The decimal→double encoder reads it right
// after the divide, to decide round-to-nearest-ties-to-even.
let gDivRemNonzero = false

// Whether lexeme `t` is plain decimal — no `0x`/`0X`, `0b`/`0B`, `0o`/`0O` prefix.
// Answers whether a literal can re-encode directly as an `f64.const`/`f32.const`,
// and whether an `e`/`E` in it is an exponent marker or a hex digit. Lives here
// rather than `emit_base` so this file's reader needs no upward import.
export function numLexIsDecimal(t: string) {
  if t.length >= 2 && t[0] == '0' {
    const p = t[1]
    if p == 'x' || p == 'X' || p == 'b' || p == 'B' || p == 'o' || p == 'O' {
      return false
    }
  }
  true
}
// Whether `NumLit` lexeme `t` denotes a float — it carries a `.` (`1.5`) or a
// scientific exponent (`1e3`, `1.5e-7`); both default to `f64` and encode through
// `f64Bytes`/`f32Bytes`. A radix lexeme (`0x1e5`) is excluded: its `e` is a hex digit.
// The checker keeps an independent copy; disagreement produces check-clean invalid wasm.
export function numLexIsFloat(t: string) {
  if !numLexIsDecimal(t) { return false }
  let i = 0
  while i < t.length {
    const c = t[i]
    if c == '.' || c == 'e' || c == 'E' { return true }
    i = i + 1
  }
  false
}
// How many significant bits a radix lexeme (`0x…` / `0b…` / `0o…`) spans, or -1 when `t` is
// plain decimal. Leading zeros and `_` separators contribute nothing and the leading digit
// contributes only the bits it needs, so `0xFFFFFFFF` is 32 and `0x1_0000_0000` is 33.
// A radix literal denotes a bit pattern, so this width is what a destination must hold.
export function numLexRadixBits(t: string) {
  let per = 0
  if t.length >= 2 && t[0] == '0' {
    const p = t[1]
    if p == 'x' || p == 'X' { per = 4 }
    else if p == 'b' || p == 'B' { per = 1 }
    else if p == 'o' || p == 'O' { per = 3 }
  }
  if per == 0 { return -1 }
  let bits = -1
  let i = 2
  while i < t.length {
    const c = t[i]
    if c != '_' {
      let d = 0
      if c >= '0' && c <= '9' { d = c - '0' }
      else if c >= 'a' && c <= 'f' { d = c - 'a' + 10 }
      else if c >= 'A' && c <= 'F' { d = c - 'A' + 10 }
      if bits < 0 {
        if d > 0 {
          let w = 0
          let v = d
          while v > 0 {
            w = w + 1
            v = v >>> 1
          }
          bits = w
        }
      } else {
        bits = bits + per
      }
    }
    i = i + 1
  }
  if bits < 0 { return 0 }
  bits
}
// Whether non-negative integer lexeme `t` (a `NumLit.numText`: decimal / hex / binary
// / octal, `_` separators skipped) defaults to i32. Must mirror the checker's
// `intLexemeFitsI32`. A radix lexeme is a bit pattern and defaults by its width
// (`numLexRadixBits`); a decimal one is a value and defaults by its magnitude.
export function numLexFitsI32(t: string) {
  const rb = numLexRadixBits(t)
  if rb >= 0 { return rb <= 32 }
  let v = 0
  let i = 0
  const base = 10
  while i < t.length {
    const c = t[i]
    if c == '_' {
      i = i + 1
    } else {
      const d = c - '0'
      if v > (2147483647 - d) / base { return false }
      v = v * base + d
      i = i + 1
    }
  }
  true
}
// Whether integer lexeme `t`'s magnitude is exactly 2^31 (2147483648). Must mirror
// the checker's `intLexemeIs2Pow31`: a negated literal folds to a signed one before
// defaulting, so `-2147483648` types i32 even though its bare magnitude is one past
// i32's max. Used by the unary `-` arms; compares significant digits against 2^31.
export function numLexIs2Pow31(t: string) {
  let digits = "2147483648"
  let i = 0
  if t.length >= 2 && t[0] == '0' {
    const p = t[1]
    if p == 'x' || p == 'X' {
      digits = "80000000"
      i = 2
    } else if p == 'b' || p == 'B' {
      digits = "10000000000000000000000000000000"
      i = 2
    } else if p == 'o' || p == 'O' {
      digits = "20000000000"
      i = 2
    }
  }
  let started = false
  let j = 0
  while i < t.length {
    const c = t[i]
    if c == '_' {
      i = i + 1
    } else if !started && c == '0' {
      i = i + 1
    } else {
      started = true
      if j >= digits.length { return false }
      if c != digits[j] { return false }
      i = i + 1
      j = j + 1
    }
  }
  j == digits.length
}
// Folds non-negative integer lexeme `text` (possibly past the i32 range) into a
// 64-bit `(hi, lo)` i32 pair `[hi, lo]`. Mirrors `parseI32`'s base detection but
// accumulates via `mulAdd64`'s 64-bit multiply-add, so a value like `0xFFFFFFFFFF`
// survives intact instead of overflowing a 32-bit fold.
export function parseI64Pair(text: string) {
  let hi = 0
  let lo = 0
  let i = 0
  let base = 10
  if text.length >= 2 && text[0] == '0' {
    const p = text[1]
    if p == 'x' || p == 'X' {
      base = 16
      i = 2
    } else if p == 'b' || p == 'B' {
      base = 2
      i = 2
    } else if p == 'o' || p == 'O' {
      base = 8
      i = 2
    }
  }
  while i < text.length {
    const c = text[i]
    if c == '_' {
      i = i + 1
    } else {
      let d = 0
      if c >= '0' && c <= '9' { d = c - '0' }
      else if c >= 'a' && c <= 'f' { d = c - 'a' + 10 }
      else { d = c - 'A' + 10 }
      const r = mulAdd64(hi, lo, base, d)
      hi = r[0]
      lo = r[1]
      i = i + 1
    }
  }
  const out: i32[] = []
  out.push(hi)
  out.push(lo)
  out
}
// 64-bit `(hi, lo) * m + add`, returned as `[hi, lo]`. `m` and `add` are small enough
// (base ≤ 16, digit ≤ 15) that the multiply fits without a full 64×64: the low lane
// splits into two 16-bit halves so each partial product stays within i32, and carries
// propagate into the high lane. All lanes are unsigned 32-bit.
function mulAdd64(hi: i32, lo: i32, m: i32, add: i32) {
  const loLow = lo & 0xffff
  const loHigh = (lo >>> 16) & 0xffff
  const p0 = loLow * m + add
  const p1 = loHigh * m + (p0 >>> 16)
  const newLo = (p0 & 0xffff) | ((p1 & 0xffff) << 16)
  const carry = p1 >>> 16
  // High lane: hi * m + carry, low 32 bits kept — overflow past 64 bits drops, as
  // the host's `i64.const` wraps mod 2^64.
  const hiLow = hi & 0xffff
  const hiHigh = (hi >>> 16) & 0xffff
  const q0 = hiLow * m + carry
  const q1 = hiHigh * m + (q0 >>> 16)
  const newHi = (q0 & 0xffff) | ((q1 & 0xffff) << 16)
  const out: i32[] = []
  out.push(newHi)
  out.push(newLo)
  out
}
// Drops leading-zero limbs, keeping at least one — a bignum is never empty.
function bigTrim(a: i32[]) {
  while a.length > 1 && a[a.length - 1] == 0 { a.pop() }
  a
}
// True when the bignum is exactly zero.
function bigIsZero(a: i32[]) { a.length == 1 && a[0] == 0 }
// `a * m` for a small (<= 0xffff) multiplier. Each limb×m fits in i32; carry rolls up.
function bigMulSmall(a: i32[], m: i32) {
  const out: i32[] = []
  let carry = 0
  let i = 0
  while i < a.length {
    const p = a[i] * m + carry
    out.push(p & 0xffff)
    carry = (p >>> 16) & 0xffff
    i = i + 1
  }
  while carry != 0 {
    out.push(carry & 0xffff)
    carry = (carry >>> 16) & 0xffff
  }
  if out.length == 0 { out.push(0) }
  bigTrim(out)
}
// `a + v` for a small (<= 0xffff) addend.
function bigAddSmall(a: i32[], v: i32) {
  const out: i32[] = []
  let i = 0
  while i < a.length {
    out.push(a[i])
    i = i + 1
  }
  let carry = v
  let j = 0
  while carry != 0 {
    if j >= out.length { out.push(0) }
    const s = out[j] + carry
    out[j] = s & 0xffff
    carry = (s >>> 16) & 0xffff
    j = j + 1
  }
  bigTrim(out)
}
// Compare two bignums: -1 if a<b, 0 if equal, 1 if a>b.
function bigCmp(a: i32[], b: i32[]) {
  if a.length != b.length {
    if a.length < b.length { return -1 }
    return 1
  }
  let i = a.length - 1
  while i >= 0 {
    if a[i] != b[i] {
      if a[i] < b[i] { return -1 }
      return 1
    }
    i = i - 1
  }
  0
}
// `a - b`, requiring a >= b (caller guarantees). Borrow-propagating limb subtract.
function bigSub(a: i32[], b: i32[]) {
  const out: i32[] = []
  let borrow = 0
  let i = 0
  while i < a.length {
    let bv = 0
    if i < b.length { bv = b[i] }
    let d = a[i] - bv - borrow
    if d < 0 {
      d = d + 0x10000
      borrow = 1
    } else {
      borrow = 0
    }
    out.push(d)
    i = i + 1
  }
  bigTrim(out)
}
// `a * 2` (left shift by one bit).
function bigShl1(a: i32[]) {
  const out: i32[] = []
  let carry = 0
  let i = 0
  while i < a.length {
    const v = (a[i] << 1) | carry
    out.push(v & 0xffff)
    carry = (v >>> 16) & 1
    i = i + 1
  }
  if carry != 0 { out.push(1) }
  bigTrim(out)
}
// `a >> 1` (floor divide by two). Walk limbs high→low, threading the dropped bit.
function bigShr1(a: i32[]) {
  const out: i32[] = []
  let i = 0
  while i < a.length {
    out.push(0)
    i = i + 1
  }
  let carry = 0
  let k = a.length - 1
  while k >= 0 {
    const v = a[k] | (carry << 16)
    out[k] = (v >>> 1) & 0xffff
    carry = v & 1
    k = k - 1
  }
  bigTrim(out)
}
// `a << bits` (multiply by 2^bits), applied bit-by-bit (`bits` is small here).
function bigShlK(a: i32[], bits: i32) {
  let r = a
  let i = 0
  while i < bits {
    r = bigShl1(r)
    i = i + 1
  }
  r
}
// Number of significant bits in `a` (0 for zero).
function bigBitLen(a: i32[]) {
  if bigIsZero(a) { return 0 }
  let top = a[a.length - 1]
  let bits = (a.length - 1) * 16
  while top != 0 {
    bits = bits + 1
    top = top >>> 1
  }
  bits
}
// Bit `idx` (0 = least significant) of `a`.
function bigGetBit(a: i32[], idx: i32) {
  const limb = idx >>> 4
  const off = idx & 15
  if limb >= a.length { return 0 }
  (a[limb] >>> off) & 1
}
// floor(n / d) by bitwise long division. The remainder's nonzero-ness (the sticky
// bit) is returned via the `gDivRemNonzero` module global — the only thing the
// encoder needs from the remainder, so no second array comes back.
function bigDivmod(n: i32[], d: i32[]) {
  const nb = bigBitLen(n)
  let rem: i32[] = []
  rem.push(0)
  const qbits: i32[] = []
  let b = nb - 1
  while b >= 0 {
    rem = bigShl1(rem)
    if bigGetBit(n, b) == 1 { rem = bigAddSmall(rem, 1) }
    if bigCmp(rem, d) >= 0 {
      rem = bigSub(rem, d)
      qbits.push(1)
    } else {
      qbits.push(0)
    }
    b = b - 1
  }
  // qbits are MSB-first; fold into a bignum.
  let q: i32[] = []
  q.push(0)
  let i = 0
  while i < qbits.length {
    q = bigShl1(q)
    if qbits[i] == 1 { q = bigAddSmall(q, 1) }
    i = i + 1
  }
  gDivRemNonzero = !bigIsZero(rem)
  bigTrim(q)
}
// Parses non-negative integer lexeme `text` (a `NumLit.numText`) into its i32 value.
// The lexer keeps the raw spelling un-normalized — decimal, `0x`/`0X` hex, `0b`/`0B`
// binary, or `0o`/`0O` octal — so the base is detected from the first two chars and
// folded here, at value time, rather than earlier by the lexer.
export function parseI32(text: string) {
  let v = 0
  let i = 0
  // Hex `0x…` / binary `0b…` / octal `0o…` — skip the two-char prefix, then fold
  // base 16 / 2 / 8. A `_` digit separator (legal in every base) is skipped.
  if text.length >= 2 && text[0] == '0' {
    const p = text[1]
    if p == 'x' || p == 'X' {
      i = 2
      while i < text.length {
        const c = text[i]
        if c == '_' {
          i = i + 1
        } else {
          let d = 0
          if c >= '0' && c <= '9' { d = c - '0' }
          else if c >= 'a' && c <= 'f' { d = c - 'a' + 10 }
          else { d = c - 'A' + 10 }
          v = v * 16 + d
          i = i + 1
        }
      }
      return v
    }
    if p == 'b' || p == 'B' {
      i = 2
      while i < text.length {
        if text[i] == '_' {
          i = i + 1
        } else {
          v = v * 2 + (text[i] - '0')
          i = i + 1
        }
      }
      return v
    }
    if p == 'o' || p == 'O' {
      i = 2
      while i < text.length {
        if text[i] == '_' {
          i = i + 1
        } else {
          v = v * 8 + (text[i] - '0')
          i = i + 1
        }
      }
      return v
    }
  }
  while i < text.length {
    if text[i] == '_' {
      i = i + 1
    } else {
      v = v * 10 + (text[i] - '0')
      i = i + 1
    }
  }
  v
}

// Set by `ieeeBytes` when the literal's magnitude rounds at or past the format's
// all-ones exponent — a value f64/f32 cannot represent finitely. `f64LitOverflows`/
// `f32LitOverflows` and the `fbF64Const`/`fbF32Const` backstop both read it, so the
// overflow judgement has one implementation and cannot drift between them.
export let gIeeeOverflow = false
// The ±0 encoding of a format `nbytes` wide: every byte zero except the sign bit
// (bit 7 of the high byte). Used by the mantissa-is-zero arm and the underflow clamp.
function ieeeZeroBytes(neg: boolean, nbytes: i32) {
  const z: i32[] = []
  let zi = 0
  while zi < nbytes {
    z.push(0)
    zi = zi + 1
  }
  if neg { z[nbytes - 1] = 0x80 }
  z
}
// The ±infinity encoding: exponent all ones, fraction 0 — byte-for-byte what the
// packer at the bottom of `ieeeBytes` produces from `qs = []`, `biased = 2*bias + 1`.
// The clamp arm exists so a magnitude beyond any format's reach (`1e400`, `1e1000000`)
// never builds the 10^exp bignum just to discard it.
function ieeeInfBytes(neg: boolean, nbytes: i32) {
  const z = ieeeZeroBytes(neg, nbytes)
  if nbytes == 8 {
    z[6] = 0xf0 // biased 2047: low 4 exponent bits in the high nibble
    z[7] = z[7] | 0x7f
  } else {
    z[2] = 0x80 // biased 255: the low exponent bit
    z[3] = z[3] | 0x7f
  }
  z
}
// Encodes decimal literal `text` into IEEE-754 form, little-endian, as an `i32[]`.
// Shared by `f64Bytes`/`f32Bytes` via `sigBits`/`bias`/`nbytes` (53/1023/8 for f64,
// 24/127/4 for f32): the parse, align, divmod and round live once here, and only
// the final byte packing branches on width, so the value rounds exactly once.
function ieeeBytes(text: string, sigBits: i32, bias: i32, nbytes: i32) {
  gIeeeOverflow = false
  let neg = false
  let i = 0
  if text.length > 0 {
    if text[0] == '-' {
      neg = true
      i = 1
    } else if text[0] == '+' {
      i = 1
    }
  }
  // Radix prefix (`0x1f` / `0b101` / `0o17`) on a `NumLit` lexeme reaching a float
  // constexpr context: skip it here, or the digit fold below reads it as decimal digits.
  let base = 10
  if text.length >= i + 2 && text[i] == '0' {
    const p = text[i + 1]
    if p == 'x' || p == 'X' {
      base = 16
      i = i + 2
    } else if p == 'b' || p == 'B' {
      base = 2
      i = i + 2
    } else if p == 'o' || p == 'O' {
      base = 8
      i = i + 2
    }
  }
  // Parses mantissa digits (ignoring `.`/`_`), counting fractional and significant
  // digits (from the first nonzero) so `mant` sits in `[10^(sig-1), 10^sig)` below.
  let mant: i32[] = []
  mant.push(0)
  let frac = 0
  let dot = false
  let sig = 0
  let seenNz = false
  let expv = 0
  let expNeg = false
  while i < text.length {
    const c = text[i]
    if c == '_' {
      i = i + 1
    } else if c == '.' {
      dot = true
      i = i + 1
    } else if base == 10 && (c == 'e' || c == 'E') {
      // Scientific exponent (`1e3`, `2E+10`) scales the same exact rational the plain
      // spelling builds, so the rounding below happens once — never `mantissa * 10^exp`
      // in f64, which drifts a ULP. Guarded on `base == 10` (hex's `e` is a digit, not
      // an exponent marker); `expv` saturates at 10^8, compared only to a digit count.
      i = i + 1
      if i < text.length {
        if text[i] == '-' {
          expNeg = true
          i = i + 1
        } else if text[i] == '+' {
          i = i + 1
        }
      }
      while i < text.length {
        const ec = text[i]
        if ec != '_' {
          if expv <= 100000000 { expv = expv * 10 + (ec - '0') }
        }
        i = i + 1
      }
    } else {
      let d = 0
      if c >= '0' && c <= '9' { d = c - '0' }
      else if c >= 'a' && c <= 'f' { d = c - 'a' + 10 }
      else { d = c - 'A' + 10 }
      mant = bigMulSmall(mant, base)
      mant = bigAddSmall(mant, d)
      if d != 0 { seenNz = true }
      if seenNz { sig = sig + 1 }
      if dot { frac = frac + 1 }
      i = i + 1
    }
  }
  // +/- zero: `0`, `0.000`, and `0e999999` alike — the exponent cannot rescue a zero
  // mantissa, so this stays ahead of the range clamp.
  if bigIsZero(mant) { return ieeeZeroBytes(neg, nbytes) }
  // The literal's decimal exponent: value = `mant * 10^dexp`, `mant` an integer. The
  // plain spelling is the `expv == 0` case (`dexp = -frac`), so both spellings reach
  // the same num/den below.
  let dexp = 0 - frac
  if expNeg { dexp = dexp - expv } else { dexp = dexp + expv }
  // Range clamp: a magnitude no format can reach, decided without building `10^|dexp|`.
  // At or past `10^400` every format overflows; at or below `10^-400` every format
  // rounds to zero. Deliberately slack — everything between is decided exactly by the
  // encoder — so this only stops `1e1000000` from allocating a giant denominator.
  if sig + dexp - 1 >= 400 {
    gIeeeOverflow = true
    return ieeeInfBytes(neg, nbytes)
  }
  if sig + dexp <= -400 { return ieeeZeroBytes(neg, nbytes) }
  // value = `mant * 10^dexp`, as an exact num/den pair: a negative `dexp` scales the
  // denominator, a positive one the numerator.
  let num = mant
  let den: i32[] = []
  den.push(1)
  let fk = 0
  if dexp < 0 {
    while fk < 0 - dexp {
      den = bigMulSmall(den, 10)
      fk = fk + 1
    }
  } else {
    while fk < dexp {
      num = bigMulSmall(num, 10)
      fk = fk + 1
    }
  }
  // value = `(num/den) * 2^exp`. Aligns so `floor(num/den)` has exactly `sigBits + 1`
  // bits, then rounds the guard bit plus the sticky remainder to `sigBits` bits.
  const alignW = sigBits + 1
  let exp = 0
  const diff = bigBitLen(num) - bigBitLen(den)
  if diff < alignW {
    num = bigShlK(num, alignW - diff)
    exp = exp - (alignW - diff)
  } else if diff > alignW {
    den = bigShlK(den, diff - alignW)
    exp = exp + (diff - alignW)
  }
  let q = bigDivmod(num, den)
  // The bit-length estimate can be one off; correct to exactly `alignW` bits.
  while bigBitLen(q) < alignW {
    num = bigShl1(num)
    exp = exp - 1
    q = bigDivmod(num, den)
  }
  while bigBitLen(q) > alignW {
    den = bigShl1(den)
    exp = exp + 1
    q = bigDivmod(num, den)
  }
  // ── exponent-range clamp (overflow / gradual underflow) ──────────────────
  // `q` is `alignW` bits, so value = `q * 2^exp`, carrying biased exponent
  // `exp + sigBits + bias` if encoded normal. Outside `[1, 2*bias]` the packing
  // below would encode an arbitrary wrong value — clamp to ±infinity or underflow.
  const preBiased = exp + sigBits + bias
  let qs: i32[] = []
  let biased = 0
  if preBiased <= 0 {
    // Gradual underflow: too small for a normal, so round at the subnormal precision
    // (fixed exponent `Emin = 1 - bias`). Computes `floor(2f)` from the num/den ratio
    // (extra low bit = round guard, remainder = sticky) and rounds once at the target
    // precision — a value below half the smallest subnormal yields `qs = 0`, packing as ±0.
    den = bigShlK(den, 1 - preBiased)
    const q2 = bigDivmod(num, den) // floor(2f)
    const sGuard = q2[0] & 1
    let sSticky = 0
    if gDivRemNonzero { sSticky = 1 }
    qs = bigShr1(q2) // floor(f)
    let sRoundUp = false
    if sGuard == 1 {
      if sSticky == 1 { sRoundUp = true }
      else if (qs[0] & 1) == 1 { sRoundUp = true }
    }
    if sRoundUp { qs = bigAddSmall(qs, 1) }
    // `biased` stays 0 (subnormal) unless rounding carries all the way up to
    // `1.0 * 2^Emin`, the smallest normal value (fraction 0, biased exponent 1).
    // The shared packing below masks off the implicit-1 bit either way.
    if bigBitLen(qs) >= sigBits { biased = 1 }
  } else {
    // `q` is `alignW` bits; reduce to `sigBits`: guard = dropped low bit, sticky =
    // nonzero remainder.
    const guard = q[0] & 1
    let sticky = 0
    if gDivRemNonzero { sticky = 1 }
    qs = bigShr1(q)
    let es = exp + 1
    // Round-to-nearest, ties-to-even: round up on guard=1 with sticky, or an exact tie
    // (guard=1, sticky=0) when the kept LSB is odd.
    let roundUp = false
    if guard == 1 {
      if sticky == 1 { roundUp = true }
      else if (qs[0] & 1) == 1 { roundUp = true }
    }
    if roundUp {
      qs = bigAddSmall(qs, 1)
      if bigBitLen(qs) > sigBits {
        qs = bigShr1(qs)
        es = es + 1
      }
    }
    // `qs` is exactly `sigBits` bits in `[2^(sigBits-1), 2^sigBits)`: `qs = 1.f *
    // 2^(sigBits-1)`, so value = `1.f * 2^(es + sigBits - 1)`.
    const bigE = es + (sigBits - 1)
    biased = bigE + bias
    // Overflow: at or past the all-ones exponent (rounding included). An out-of-range
    // literal is a compile error — the checker's `f64LitOverflows`/`f32LitOverflows`
    // and the emitter's `fbF64Const`/`fbF32Const` `emitFail` backstop both read this
    // flag — the ±infinity encoding below is the defensive value behind those gates.
    const maxBiased = bias + bias + 1
    if biased >= maxBiased {
      gIeeeOverflow = true
      qs = []
      biased = maxBiased
    }
  }
  // Read the low 16-bit limbs of the significand.
  let m0 = 0
  let m1 = 0
  let m2 = 0
  let m3 = 0
  if qs.length > 0 { m0 = qs[0] }
  if qs.length > 1 { m1 = qs[1] }
  if qs.length > 2 { m2 = qs[2] }
  if qs.length > 3 { m3 = qs[3] }
  const out: i32[] = []
  if nbytes == 8 {
    // 52-bit fraction in bytes 0..6 (low nibble of byte 6), 11-bit biased exponent straddling
    // byte 6 (high nibble) and byte 7, sign in bit 7 of byte 7. m3 bit 52 is the implicit 1.
    out.push(m0 & 0xff)
    out.push((m0 >>> 8) & 0xff)
    out.push(m1 & 0xff)
    out.push((m1 >>> 8) & 0xff)
    out.push(m2 & 0xff)
    out.push((m2 >>> 8) & 0xff)
    const fracHi = m3 & 0xf // frac bits 48..51 (bit 52 implicit-1 dropped)
    out.push(fracHi | ((biased & 0xf) << 4)) // byte 6: frac 48..51 | exp low 4 bits
    let signTop = 0
    if neg { signTop = 0x80 }
    out.push(((biased >>> 4) & 0x7f) | signTop) // byte 7: exp high 7 bits | sign
  } else {
    // 23-bit fraction in bytes 0..2 (low 7 bits of byte 2), 8-bit biased exponent straddling
    // byte 2 (high bit) and byte 3, sign in bit 7 of byte 3. Bit 23 of `sig` is the implicit 1.
    const sig = (m0 & 0xffff) | ((m1 & 0xff) << 16)
    out.push(sig & 0xff)
    out.push((sig >>> 8) & 0xff)
    const fracHi = (sig >>> 16) & 0x7f // frac bits 16..22 (bit 23 implicit-1 dropped)
    out.push(fracHi | ((biased & 1) << 7)) // byte 2: frac 16..22 | exp low bit
    let signTop = 0
    if neg { signTop = 0x80 }
    out.push(((biased >>> 1) & 0x7f) | signTop) // byte 3: exp high 7 bits | sign
  }
  out
}
// The 8-byte little-endian IEEE-754 double for decimal literal `text`. Sign is parsed too
// (a leading `-`/`+`), though the NumLit site never carries one (unary minus is a separate node).
export function f64Bytes(text: string) { ieeeBytes(text, 53, 1023, 8) }
// The 4-byte little-endian IEEE-754 single for decimal literal `text`.
export function f32Bytes(text: string) { ieeeBytes(text, 24, 127, 4) }

// The count of significant integer digits a decimal literal's magnitude needs — digits
// before the `.` (separators and leading zeros skipped), shifted by the exponent when
// the lexeme carries one. Without the shift `1e400` would report one digit, sail past
// the f64 boundary, and let `f64LitOverflows` miss a literal that is actually infinite.
function decIntDigits(t: string) {
  let i = 0
  if t.length > 0 {
    if t[0] == '-' || t[0] == '+' { i = 1 }
  }
  let n = 0
  let seen = false
  let dot = false
  while i < t.length {
    const c = t[i]
    if c == 'e' || c == 'E' {
      const shifted = n + decExpValue(t, i + 1)
      if shifted < 0 { return 0 }
      return shifted
    }
    if c == '.' {
      dot = true
    } else if c != '_' {
      // A non-decimal lexeme (`0x…` hex/binary/octal) never reaches the decimal
      // encoder's range: report 0 digits so the overflow predicates pass it through.
      if c < '0' || c > '9' { return 0 }
      if !dot {
        if c != '0' { seen = true }
        if seen { n = n + 1 }
      }
    }
    i = i + 1
  }
  n
}

// The signed value of the exponent digits of `t` starting at `at` (just past the
// `e`/`E`): an optional `+`/`-`, then a `_`-separated digit run. Saturates at 10^8,
// safe because callers only ever compare it against a digit count. Shares the
// lexer's exponent grammar with `ieeeBytes`.
function decExpValue(t: string, at: i32) {
  let i = at
  let eneg = false
  if i < t.length {
    if t[i] == '-' {
      eneg = true
      i = i + 1
    } else if t[i] == '+' {
      i = i + 1
    }
  }
  let v = 0
  while i < t.length {
    const c = t[i]
    if c != '_' {
      if c < '0' || c > '9' { return 0 }
      if v <= 100000000 { v = v * 10 + (c - '0') }
    }
    i = i + 1
  }
  if eneg { return 0 - v }
  v
}

// Whether decimal literal `text` rounds to ±infinity as an f64 and must be rejected.
// Exact at the boundary: away from it the digit-count prescreen decides (fewer than
// 309 integer digits can never overflow), at it the real encoder runs and its own
// rounding decides — one implementation, so the boundary cannot drift out of step.
export function f64LitOverflows(text: string) {
  if decIntDigits(text) < 309 { return false }
  f64Bytes(text)
  gIeeeOverflow
}

// The f32 flavor: overflow needs >= 39 integer digits (the f32 max is ~3.403e38).
export function f32LitOverflows(text: string) {
  if decIntDigits(text) < 39 { return false }
  f32Bytes(text)
  gIeeeOverflow
}

// Whether non-negative integer lexeme `t` (decimal / hex / binary / octal) is exactly
// representable as a finite f32. An integer literal enters an f32 context only when f32
// keeps it exactly (unlike a `.`-literal, which rounds once). A closed-form bit test —
// significand fits 24 bits, magnitude fits 128 bits — not a re-encode through `ieeeBytes`.
export function intLexemeIsExactF32(t: string) {
  let base = 10
  let i = 0
  if t.length >= 2 && t[0] == '0' {
    const p = t[1]
    if p == 'x' || p == 'X' {
      base = 16
      i = 2
    } else if p == 'b' || p == 'B' {
      base = 2
      i = 2
    } else if p == 'o' || p == 'O' {
      base = 8
      i = 2
    }
  }
  let v: i32[] = []
  v.push(0)
  while i < t.length {
    const c = t[i]
    if c == '_' {
      i = i + 1
    } else {
      let d = 0
      if c >= '0' && c <= '9' { d = c - '0' }
      else if c >= 'a' && c <= 'f' { d = c - 'a' + 10 }
      else { d = c - 'A' + 10 }
      v = bigMulSmall(v, base)
      v = bigAddSmall(v, d)
      i = i + 1
    }
  }
  // Zero is exact in every format (and has no significant bits to strip).
  if bigIsZero(v) { return true }
  const width = bigBitLen(v)
  if width > 128 { return false }
  // Strips trailing zero bits: they are carried by the exponent, not the significand,
  // so `2^100` needs one significand bit, not 101.
  let sig = v
  let low = bigGetBit(sig, 0)
  while low == 0 {
    sig = bigShr1(sig)
    low = bigGetBit(sig, 0)
  }
  bigBitLen(sig) <= 24
}
