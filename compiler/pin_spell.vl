// The naming rule's one producer: the spelling an instance's pin takes from its canonical type
// alone (architecture-target-2026-10.md §3.4), and, under `$VL_REP_SHADOW`, its shadow against the
// spelling mono's cascade chose. It names each parameter's pin it can spell (`monoPinRespell`), and
// closes each pin's own type, the column the instance key reads its row class from.
import {
  T,
  TY_BOOL,
  TY_NEVER,
  TY_STR,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  cStructNames,
  cStructTyIxs,
  litBaseTy,
  litUnionAliasNameOfTy,
  litUnionAliasOfLitTexts,
  mkArrayTy,
  mkMapTy,
  mkNullableTy,
  mkObjTy,
  numLitUnionBaseName,
  numLitUnionBaseTy,
  structNameOfTy,
  tyAt,
  tyHoldsObj,
  tyIsLitUnion,
  tyIsOneStrLit,
  unionAliasDeclNameOfTy,
} from "./check_types"
import { Param, nodeAt } from "./ast"
import { tyIsUnionish } from "./check_node_tys"
import {
  repRowId,
  repRowOfTyStruct,
  repShadowOn,
  repVariantShapeRowOf,
} from "./emit_rep"
import { repABNote } from "./emit_nullable_rets"
import { nomErasedTyIx } from "./check_ty_rep"
import { mkUnionTy } from "./check_union_mint"
import { joinTys } from "./check_relate_core"
import { elabInstTyAt, elabUnboundTpTy } from "./emit_elab"
import { sNames, sTyIx, uVariants } from "./emit_state"
import { strContains } from "./strutil"

import { tyHasTyVar } from "./tyquery"

// The pin spelling of closed type `ty` under the naming rule: a record by its row's registered
// name, every other type by its structural spelling with union members sorted and records inside
// by row name. "" for an open type or a part no annotation can spell.
export function monoPinSpellOf(ty: i32): string { monoPinSpellAt(ty, PS_ROWS) }

// `monoPinSpellOf`, with a record that has no row spelled as its fields: the spelling a pin that
// names no row takes.
export function monoPinSpellShaped(ty: i32): string {
  monoPinSpellAt(ty, PS_SHAPES)
}

// `monoPinSpellShaped`, with a record whose row is an anonymous `#anon` handle also spelled as
// its fields, at any depth: a name a spelling reader can parse back.
export function monoPinSpellNoAnon(ty: i32): string {
  monoPinSpellAt(ty, PS_FIELDS)
}

// The record `ty` spelled by its fields whether or not it has a row, the parts by
// `monoPinSpellShaped`: the shape an anonymous row's handle stands for. Any other type as
// `monoPinSpellShaped` spells it.
export function monoPinSpellFields(ty: i32): string {
  if ty < 0 || ty >= T.tys.length || tyHasTyVar(ty) { return "" }
  const t = tyAt(ty)
  if t is TyObj { return monoPinSpellObjFields(t, PS_SHAPES) }
  monoPinSpellAt(ty, PS_SHAPES)
}

// Record `t` spelled as its fields, in their declared order; "" when a field has no spelling.
function monoPinSpellObjFields(t: TyObj, mode: i32): string {
  const fs: string[] = []
  let i = 0
  while i < t.objFieldNames.length && i < t.objFieldTypes.length {
    const f = monoPinSpellAt(t.objFieldTypes[i], mode)
    if f == "" { return "" }
    fs.push(t.objFieldNames[i] + ":" + f)
    i = i + 1
  }
  "{" + monoPinSpellJoin(fs, ",") + "}"
}

// What a record spells as: its row's name only (`PS_ROWS`), its fields where it has no row
// (`PS_SHAPES`), or its fields too where its row is an `#anon` handle (`PS_FIELDS`).
const PS_ROWS = 0
const PS_SHAPES = 1
const PS_FIELDS = 2

// `monoPinSpellOf` under `mode`.
function monoPinSpellAt(ty: i32, mode: i32): string {
  if ty < 0 || ty >= T.tys.length || tyHasTyVar(ty) { return "" }
  const t = tyAt(ty)
  match t {
    TyObj => {
      const r = repRowOfTyStruct(ty, sNames.length)
      if r >= 0 && r < sNames.length {
        const rn = monoPinSpellRowName(ty, r)
        if mode == PS_FIELDS && strContains(rn, "#anon") {
          return monoPinSpellObjFields(t, mode)
        }
        return rn
      }
      // A union member's record has no struct row; it spells as its declared name, else its
      // variant row.
      const sn = structNameOfTy(ty)
      if sn != "" { return sn }
      const vr = repVariantShapeRowOf(ty)
      if vr >= 0 && vr < uVariants.length {
        if mode == PS_FIELDS && strContains(uVariants[vr], "#anon") {
          return monoPinSpellObjFields(t, mode)
        }
        return uVariants[vr]
      }
      if mode == PS_ROWS { return "" }
      return monoPinSpellObjFields(t, mode)
    }
    // `never` has no value to pin, so a type holding it has no pin.
    TyPrim => {
      return if ty == TY_NEVER { "" } else { t.primName }
    }
    TyLit => {
      if t.litKind == "str" { return "\"" + t.litText + "\"" }
      return t.litText
    }
    TyArray => {
      const e = monoPinSpellAt(t.aElem, mode)
      if e == "" { return "" }
      // A readonly view spells as its list: the view is the node's type, not its rep.
      return monoPinSpellAtom(t.aElem, e) + "[]"
    }
    TyNullable => {
      const inner = monoPinSpellAt(t.nInner, mode)
      if inner == "" { return "" }
      // A union's members and `null` spell as one flat union.
      if t.nInner < T.tys.length && tyAt(t.nInner) is TyUnion {
        return inner + "|null"
      }
      return monoPinSpellAtom(t.nInner, inner) + "|null"
    }
    TyUnion => {
      const lu = monoPinSpellLitUnion(ty, t.uMembers)
      if lu != "" { return lu }
      // A declared union spells as its name.
      const ud = unionAliasDeclNameOfTy(ty)
      if ud != "" { return ud }
      const ms: string[] = []
      for m in t.uMembers {
        const s = monoPinSpellAt(m, mode)
        if s == "" { return "" }
        const a = if tyIsUnionish(m) { s } else { monoPinSpellFnAtom(m, s) }
        let j = ms.length
        ms.push(a)
        while j > 0 && ms[j - 1] > a {
          ms[j] = ms[j - 1]
          j = j - 1
        }
        ms[j] = a
      }
      return monoPinSpellJoin(ms, "|")
    }
    TyMap => {
      const k = monoPinSpellAt(t.mKey, mode)
      if k == "" { return "" }
      // A set spells as the map it is stored as.
      const v = monoPinSpellAt(t.mVal, mode)
      if v == "" { return "" }
      return "{[" + k + "]:" + v + "}"
    }
    TyFunc => {
      const ps: string[] = []
      for p in t.fnParamTypes {
        const s = monoPinSpellAt(p, mode)
        if s == "" { return "" }
        ps.push(s)
      }
      const r = monoPinSpellAt(t.fnRet, mode)
      if r == "" { return "" }
      return "("
        + monoPinSpellJoin(ps, ",")
        + ")=>"
        + monoPinSpellFnAtom(t.fnRet, r)
    }
    TyErr | TyVar | TyNeg => {}
  }
  ""
}

// Row `r`'s spelling for record `ty`: the first declared name whose record has `ty`'s row
// identity (ruling 3), else the row's own name, so the order emit registered rows in does not
// decide it.
function monoPinSpellRowName(ty: i32, r: i32): string {
  if r < 0 || r >= sNames.length { return "" }
  const dn = monoPinFirstDeclOfRow(repRowId(ty))
  if dn != "" { dn } else { sNames[r] }
}

// The first declared record name (`cStructNames` order) whose type has row identity `k`, or "".
function monoPinFirstDeclOfRow(k: i32): string {
  if k < 0 { return "" }
  let i = 0
  while i < cStructNames.length && i < cStructTyIxs.length {
    if repRowId(cStructTyIxs[i]) == k { return cStructNames[i] }
    i = i + 1
  }
  ""
}

// The naming rule at each parameter: a pin whose type closes takes that type's spelling
// (`monoPinSpellOf`), the parameter's own type (`pinOwn`) where it is annotated, else its
// argument's (`pinTys`). A pin the rule cannot spell keeps mono's.
export function monoPinRespell(
  pinned: string[],
  pinTys: i32[],
  params: i32[],
  pinOwn: i32[],
) {
  let i = 0
  while i < pinned.length && i < pinTys.length && i < params.length {
    const p = nodeAt(params[i])
    if p is Param {
      const t = if p.parType < 0 { pinTys[i] } else if i < pinOwn.length { pinOwn[i] } else { -1 }
      const sp = if t >= 0 && t < T.tys.length { monoPinSpellOf(t) } else { "" }
      if sp != "" { pinned[i] = sp }
    }
    i = i + 1
  }
  0
}

// The type a parameter pinned at closed type `ty` takes, as its pin spelling widens it: in a union,
// a numeric or boolean literal beside any other member is its base scalar, and a string literal
// beside such a literal is `string`. A literal union alone keeps its rep; any other type comes back
// unchanged.
export function monoPinWidenTy(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return ty }
  const t = tyAt(ty)
  if t is TyNullable {
    const w = monoPinWidenTy(t.nInner)
    return if w == t.nInner { ty } else { mkNullableTy(w) }
  }
  if !(t is TyUnion) || monoPinSpellLitUnion(ty, t.uMembers) != "" { return ty }
  let strs = false
  let nums = false
  let others = false
  for m in t.uMembers {
    const mt = tyAt(m)
    if mt is TyLit {
      if mt.litKind == "str" { strs = true } else { nums = true }
    } else if !(mt is TyPrim && mt.primName == "null") {
      others = true
    }
  }
  const wideNum = nums && (strs || others)
  const wideStr = strs && nums
  if !wideNum && !wideStr { return ty }
  let acc = -1
  for m in t.uMembers {
    const mt = tyAt(m)
    let w = m
    if mt is TyLit && (if mt.litKind == "str" { wideStr } else { wideNum }) {
      w = litBaseTy(mt)
    }
    acc = if acc < 0 { w } else { joinTys(acc, w) }
  }
  acc
}

// A literal union's spelling is its rep: a numeric one spells as its base scalar, a string one as
// its alias, and with a null member as that alias and `|null`. "" for any other union.
function monoPinSpellLitUnion(ty: i32, ms: i32[]): string {
  const nb = numLitUnionBaseTy(ty)
  if nb >= 0 { return monoPinSpellOf(nb) }
  const al = litUnionAliasNameOfTy(ty)
  if al != "" { return al }
  const texts: string[] = []
  let nul = false
  for m in ms {
    const mt = tyAt(m)
    if mt is TyLit {
      if mt.litKind != "str" { return "" }
      texts.push(mt.litText)
    } else if mt is TyPrim && mt.primName == "null" {
      nul = true
    } else {
      return ""
    }
  }
  if !nul || texts.length == 0 { return "" }
  const a = litUnionAliasOfLitTexts(texts)
  if a == "" { "" } else { a + "|null" }
}

// `s`, the spelling of `ty`, as one atom where a suffix follows it: parenthesized when `ty` is a
// union or a nullable spelled with `|`, or a function.
function monoPinSpellAtom(ty: i32, s: string): string {
  if tyIsUnionish(ty) && strContains(s, "|") { return "(" + s + ")" }
  monoPinSpellFnAtom(ty, s)
}

// `s`, the spelling of `ty`, parenthesized when `ty` is a function.
function monoPinSpellFnAtom(ty: i32, s: string): string {
  if tyAt(ty) is TyFunc { "(" + s + ")" } else { s }
}

function monoPinSpellJoin(xs: string[], sep: string): string {
  let r = ""
  let i = 0
  while i < xs.length {
    if i > 0 { r = r + sep }
    r = r + xs[i]
    i = i + 1
  }
  r
}

// Shadow only: notes, under `$VL_REP_SHADOW`, how pin name `an` of an instance's parameter or type
// parameter (`site`) compares with `monoPinSpellOf` of its pin type `ty`, by class.
export function monoPinSpellNote(site: string, an: string, ty: i32) {
  if !repShadowOn { return 0 }
  const sp = monoPinSpellOf(ty)
  const cls = monoPinSpellClass(an, ty, sp)
  const d = if cls == "agree" || cls == "open pin type" { "" } else { an + " ~ " + sp }
  repABNote("pinSpell", site + "/" + cls, d)
}

function monoPinSpellClass(an: string, ty: i32, sp: string): string {
  if ty < 0 || ty >= T.tys.length { return "no pin type" }
  if tyHasTyVar(ty) { return "open pin type" }
  if an == sp { return "agree" }
  if sp == "" { return "producer has no spelling" }
  if an == "" { return "no name" }
  if an.slice(0, 2) == "=>" { return "fn sig key" }
  if tyAt(ty) is TyObj { return "record, another name" }
  if strContains(an, "#anon") || strContains(sp, "#anon") { return "anon row" }
  if monoPinSpellArms(an) == monoPinSpellArms(sp) {
    return "union order or parens"
  }
  if tyHoldsObj(ty, 8) { return "record inside, another name" }
  "differ"
}

// `s` without spaces and parentheses, its `|` arms sorted: two spellings of one union in
// different orders or groupings read alike.
function monoPinSpellArms(s: string): string {
  const arms: string[] = []
  let cur = ""
  let i = 0
  while i <= s.length {
    const c = if i < s.length { s.slice(i, i + 1) } else { "|" }
    if c == "|" {
      let j = arms.length
      arms.push(cur)
      while j > 0 && arms[j - 1] > cur {
        arms[j] = arms[j - 1]
        j = j - 1
      }
      arms[j] = cur
      cur = ""
    } else if c != " " && c != "(" && c != ")" {
      cur = cur + c
    }
    i = i + 1
  }
  monoPinSpellJoin(arms, "|")
}

// Each pin's own type in instance `ctx`: an annotated parameter's substituted annotation (-1 where
// it stays open), and at an un-annotated one (-2) the argument's type in `pinTys`, its pin.
export function monoPinOwnClose(pinOwn: i32[], pinTys: i32[], ctx: i32) {
  let i = 0
  while i < pinOwn.length && i < pinTys.length {
    const o = pinOwn[i]
    pinOwn[i] = if o >= 0 { monoPinOwnSubTy(o, ctx) } else if o == -2 { pinTys[i] } else { -1 }
    i = i + 1
  }
  0
}

// `t` under instance `ctx`'s bindings where it binds every one `t` names, else `t` (`monoPinSubTyOf`).
function monoPinOwnSubTy(t: i32, ctx: i32): i32 {
  if ctx < 0 { return t }
  const st = elabInstTyAt(t, ctx)
  if st >= 0 { st } else { t }
}

// The typed bindings `tvT` an instance's annotations are built at: a type parameter bound to
// `never` whose spelling in `tvV` is the default takes that default, as its slots rep (D15530).
export function monoPinOwnTvAtRep(
  tvN: string[],
  tvV: string[],
  tvT: i32[],
): i32[] {
  const out: i32[] = []
  let q = 0
  while q < tvT.length {
    let t = tvT[q]
    if t == TY_NEVER && q < tvV.length && q < tvN.length && tvV[q] != "never" {
      const dt = elabUnboundTpTy(-1, -1, tvN[q])
      if dt >= 0 { t = dt }
    }
    out.push(t)
    q = q + 1
  }
  out
}

// The type a pin over closed type `ty` denotes once its rep collapses, as `monoAnnPinName` and the
// canon spelling collapse a name: a newtype brand is its base, a `readonly` list the list, a
// `Set<K>` the map `{[K]: boolean}`, a union of numeric literals its base scalar, at every depth.
// `ty` itself where nothing collapses.
export function monoAnnPinTy(ty: i32): i32 { monoAnnPinTyAt(ty, 0) }

function monoAnnPinTyAt(ty: i32, depth: i32): i32 {
  if ty < 0 || ty >= T.tys.length || depth > 64 { return ty }
  const b = nomErasedTyIx(ty)
  if b != ty { return monoAnnPinTyAt(b, depth + 1) }
  const t = tyAt(ty)
  match t {
    TyArray => {
      const e = monoAnnPinTyAt(t.aElem, depth + 1)
      if e == t.aElem && t.aRead == 0 { return ty }
      return mkArrayTy(e)
    }
    TyNullable => {
      const inner = monoAnnPinTyAt(t.nInner, depth + 1)
      if inner == t.nInner { return ty }
      return mkNullableTy(inner)
    }
    TyMap => {
      const k = monoAnnPinTyAt(t.mKey, depth + 1)
      if t.mSet != 0 { return mkMapTy(k, TY_BOOL, 0) }
      const v = monoAnnPinTyAt(t.mVal, depth + 1)
      if k == t.mKey && v == t.mVal { return ty }
      return mkMapTy(k, v, 0)
    }
    TyObj => {
      const fs: i32[] = []
      let changed = false
      for f in t.objFieldTypes {
        const c = monoAnnPinTyAt(f, depth + 1)
        if c != f { changed = true }
        fs.push(c)
      }
      if changed { return mkObjTy(t.objFieldNames, fs) }
    }
    TyUnion => {
      if numLitUnionBaseName(ty) != "" { return numLitUnionBaseTy(ty) }
      const ms: i32[] = []
      let changed = false
      for m in t.uMembers {
        const c = monoAnnPinTyAt(m, depth + 1)
        if c != m { changed = true }
        ms.push(c)
      }
      if changed { return mkUnionTy(ms) }
    }
    TyPrim | TyLit | TyFunc | TyErr | TyVar | TyNeg => {}
  }
  ty
}

// The type closed argument type `t` pins at (`monoArgTyName`'s first rung; `rec` where it is
// pinned as a record): a record by its declared row's type, a union of numeric literals by its
// base scalar, one string literal by `string`; `t` otherwise.
export function monoClosedPinOwnTy(t: i32, rec: boolean): i32 {
  if t < 0 || t >= T.tys.length { return t }
  if rec {
    if tyAt(t) is TyObj && structNameOfTy(t) != "" {
      const rr = repRowOfTyStruct(t, sNames.length)
      if (
        rr >= 0
        && rr < sNames.length
        && rr < sTyIx.length
        && structNameOfTy(sTyIx[rr]) == sNames[rr]
      ) {
        return sTyIx[rr]
      }
    }
    return t
  }
  if tyAt(t) is TyUnion && numLitUnionBaseName(t) != "" {
    return numLitUnionBaseTy(t)
  }
  if tyIsOneStrLit(t) && !tyIsLitUnion(t) && litUnionAliasNameOfTy(t) == "" {
    return TY_STR
  }
  t
}

// `ty` where it is a closed type, else -1.
export function monoPinClosedOrNone(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length || tyHasTyVar(ty) { -1 } else { ty }
}
