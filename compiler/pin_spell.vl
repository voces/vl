// The naming rule's one producer: the spelling an instance's pin takes from its canonical type
// alone (architecture-target-2026-10.md §3.4), and, under `$VL_REP_SHADOW`, its shadow against the
// spelling mono's cascade chose. It names an un-annotated parameter's pin (`monoPinRespell`).
import {
  T,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  litUnionAliasNameOfTy,
  litUnionAliasOfLitTexts,
  numLitUnionBaseTy,
  tyAt,
  tyHoldsObj,
} from "./check_types"
import { Param, nodeAt } from "./ast"
import { tyIsUnionish } from "./check_node_tys"
import { repRowOfTyStruct, repShadowOn, repVariantShapeRowOf } from "./emit_rep"
import { repABNote } from "./emit_nullable_rets"
import { sNames, uVariants } from "./emit_state"
import { strContains } from "./strutil"
import { tyHasTyVar } from "./tyquery"

// The pin spelling of closed type `ty` under the naming rule: a record by its row's registered
// name, every other type by its structural spelling with union members sorted and records inside
// by row name. "" for an open type or a part no annotation can spell.
export function monoPinSpellOf(ty: i32): string {
  if ty < 0 || ty >= T.tys.length || tyHasTyVar(ty) { return "" }
  const t = tyAt(ty)
  match t {
    TyObj => {
      const r = repRowOfTyStruct(ty, sNames.length)
      if r >= 0 && r < sNames.length { return sNames[r] }
      // A union member's record has no struct row; it spells as its variant row.
      const vr = repVariantShapeRowOf(ty)
      if vr >= 0 && vr < uVariants.length { return uVariants[vr] }
      return ""
    }
    TyPrim => {
      return t.primName
    }
    TyLit => {
      if t.litKind == "str" { return "\"" + t.litText + "\"" }
      return t.litText
    }
    TyArray => {
      const e = monoPinSpellOf(t.aElem)
      if e == "" { return "" }
      const ro = if t.aRead != 0 { "readonly " } else { "" }
      return ro + monoPinSpellAtom(t.aElem, e) + "[]"
    }
    TyNullable => {
      const inner = monoPinSpellOf(t.nInner)
      if inner == "" { return "" }
      return monoPinSpellAtom(t.nInner, inner) + "|null"
    }
    TyUnion => {
      const lu = monoPinSpellLitUnion(ty, t.uMembers)
      if lu != "" { return lu }
      const ms: string[] = []
      for m in t.uMembers {
        const s = monoPinSpellOf(m)
        if s == "" { return "" }
        const a = if tyIsUnionish(m) { s } else { monoPinSpellFnAtom(m, s) }
        let j = ms.length
        ms.push(a)
        while j > 0 && ms[j - 1] > a {
          ms[j] = ms[j - 1]
          j = j - 1
        }
        ms[j] = a
      }
      return monoPinSpellJoin(ms, "|")
    }
    TyMap => {
      const k = monoPinSpellOf(t.mKey)
      if k == "" { return "" }
      if t.mSet != 0 { return "Set<" + k + ">" }
      const v = monoPinSpellOf(t.mVal)
      if v == "" { return "" }
      return "{[" + k + "]:" + v + "}"
    }
    TyFunc => {
      const ps: string[] = []
      for p in t.fnParamTypes {
        const s = monoPinSpellOf(p)
        if s == "" { return "" }
        ps.push(s)
      }
      const r = monoPinSpellOf(t.fnRet)
      if r == "" { return "" }
      return "("
        + monoPinSpellJoin(ps, ",")
        + ")=>"
        + monoPinSpellFnAtom(t.fnRet, r)
    }
    TyErr | TyVar | TyNeg => {}
  }
  ""
}

// The naming rule at an un-annotated parameter, whose pin is its argument's type: a closed pin
// takes that type's spelling (`monoPinSpellOf`). An annotated parameter's pin is its annotation,
// which `pinTys` does not hold, so it keeps mono's spelling, as does an open pin.
export function monoPinRespell(pinned: string[], pinTys: i32[], params: i32[]) {
  let i = 0
  while i < pinned.length && i < pinTys.length && i < params.length {
    const p = nodeAt(params[i])
    if !(p is Param) || p.parType >= 0 {
      i = i + 1
      continue
    }
    const sp = if monoPinRespellOk(pinTys[i], 0) { monoPinSpellOf(pinTys[i]) } else { "" }
    if sp != "" { pinned[i] = sp }
    i = i + 1
  }
  0
}

// Whether pin type `ty` holds no record, map, lone literal or union other than a literal union
// spelled by its rep: the part of the naming rule whose spelling no emit reader resolves by name.
function monoPinRespellOk(ty: i32, depth: i32): boolean {
  if ty < 0 || ty >= T.tys.length || depth > 16 { return false }
  const t = tyAt(ty)
  match t {
    TyPrim => true
    TyArray => monoPinRespellOk(t.aElem, depth + 1)
    TyNullable => monoPinRespellOk(t.nInner, depth + 1)
    // A union pins by its rep, so only one the producer spells by its rep is respelled.
    TyUnion => monoPinSpellLitUnion(ty, t.uMembers) != ""
    TyFunc => {
      for p in t.fnParamTypes {
        if !monoPinRespellOk(p, depth + 1) { return false }
      }
      monoPinRespellOk(t.fnRet, depth + 1)
    }
    // A lone literal pins at its literal union's atom, which its own spelling does not name.
    TyLit | TyObj | TyMap | TyErr | TyVar | TyNeg => false
  }
}

// A literal union's spelling is its rep: a numeric one spells as its base scalar, a string one as
// its alias, and with a null member as that alias and `|null`. "" for any other union.
function monoPinSpellLitUnion(ty: i32, ms: i32[]): string {
  const nb = numLitUnionBaseTy(ty)
  if nb >= 0 { return monoPinSpellOf(nb) }
  const al = litUnionAliasNameOfTy(ty)
  if al != "" { return al }
  const texts: string[] = []
  let nul = false
  for m in ms {
    const mt = tyAt(m)
    if mt is TyLit {
      if mt.litKind != "str" { return "" }
      texts.push(mt.litText)
    } else if mt is TyPrim && mt.primName == "null" {
      nul = true
    } else {
      return ""
    }
  }
  if !nul || texts.length == 0 { return "" }
  const a = litUnionAliasOfLitTexts(texts)
  if a == "" { "" } else { a + "|null" }
}

// `s`, the spelling of `ty`, as one atom where a suffix follows it: parenthesized when `ty` is a
// union, a nullable or a function.
function monoPinSpellAtom(ty: i32, s: string): string {
  if tyIsUnionish(ty) { return "(" + s + ")" }
  monoPinSpellFnAtom(ty, s)
}

// `s`, the spelling of `ty`, parenthesized when `ty` is a function.
function monoPinSpellFnAtom(ty: i32, s: string): string {
  if tyAt(ty) is TyFunc { "(" + s + ")" } else { s }
}

function monoPinSpellJoin(xs: string[], sep: string): string {
  let r = ""
  let i = 0
  while i < xs.length {
    if i > 0 { r = r + sep }
    r = r + xs[i]
    i = i + 1
  }
  r
}

// Shadow only: notes, under `$VL_REP_SHADOW`, how pin name `an` of an instance's parameter or type
// parameter (`site`) compares with `monoPinSpellOf` of its pin type `ty`, by class.
export function monoPinSpellNote(site: string, an: string, ty: i32) {
  if !repShadowOn { return 0 }
  const sp = monoPinSpellOf(ty)
  const cls = monoPinSpellClass(an, ty, sp)
  const d = if cls == "agree" || cls == "open pin type" { "" } else { an + " ~ " + sp }
  repABNote("pinSpell", site + "/" + cls, d)
}

function monoPinSpellClass(an: string, ty: i32, sp: string): string {
  if ty < 0 || ty >= T.tys.length { return "no pin type" }
  if tyHasTyVar(ty) { return "open pin type" }
  if an == sp { return "agree" }
  if sp == "" { return "producer has no spelling" }
  if an == "" { return "no name" }
  if an.slice(0, 2) == "=>" { return "fn sig key" }
  if tyAt(ty) is TyObj { return "record, another name" }
  if strContains(an, "#anon") || strContains(sp, "#anon") { return "anon row" }
  if monoPinSpellArms(an) == monoPinSpellArms(sp) {
    return "union order or parens"
  }
  if tyHoldsObj(ty, 8) { return "record inside, another name" }
  "differ"
}

// `s` without spaces and parentheses, its `|` arms sorted: two spellings of one union in
// different orders or groupings read alike.
function monoPinSpellArms(s: string): string {
  const arms: string[] = []
  let cur = ""
  let i = 0
  while i <= s.length {
    const c = if i < s.length { s.slice(i, i + 1) } else { "|" }
    if c == "|" {
      let j = arms.length
      arms.push(cur)
      while j > 0 && arms[j - 1] > cur {
        arms[j] = arms[j - 1]
        j = j - 1
      }
      arms[j] = cur
      cur = ""
    } else if c != " " && c != "(" && c != ")" {
      cur = cur + c
    }
    i = i + 1
  }
  monoPinSpellJoin(arms, "|")
}
