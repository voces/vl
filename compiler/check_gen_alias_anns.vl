// Generic-alias annotation banking and the builtin collection spelling: `Map<K,V>` and
// `Set<T>` rewritten to their index signatures, and the declared spelling of a banked
// annotation.
// Does not import the checker.
import { FieldDef, FuncDecl, P, Param, TypeDecl, TypeRef } from "./ast"
import { isIdentCharAt } from "./check_suggest"
import { cUserTypes } from "./check_types"
import {
  annGenAppSpanEnds,
  gaeArgsTextOf,
  gaeHeadNameOf,
  gaeLtAt,
  tyTopLevelSplit,
} from "./tyname"

// Generic type aliases: a parameterized `type Box<T> = { value: T }` registers here and not
// in `cUserTypes`, having no concrete type until applied. Parallel per-alias arrays of base
// name and `TypeDecl` node, whose fields are re-resolved per application under a type-param
// binding environment; applications memoize into `cUserTypes` under `Box<i32>`.
export let gaNames: string[] = []
export let gaDeclIxs: i32[] = []

// The registry slot of a generic alias base name ("Box"), or -1.
export function gaIndexOf(name: string) {
  let i = 0
  while i < gaNames.length {
    if gaNames[i] == name { return i }
    i = i + 1
  }
  -1
}

// The index-signature spelling `{[K]:V}` / `{[T]:boolean}` of a builtin collection application
// `Map<K,V>` / `Set<T>`, or "" when `name` is not one, or when a user declaration owns the head.
export function builtinCollSpelling(name: string): string {
  if !annGenAppSpanEnds(name) { return "" }
  const lt = gaeLtAt(name)
  const head = gaeHeadNameOf(name, lt)
  if head != "Map" && head != "Set" { return "" }
  if cUserTypes.has(head) || gaIndexOf(head) >= 0 { return "" }
  const args: string[] = []
  tyTopLevelSplit(gaeArgsTextOf(name, lt), ',', false, args)
  if head == "Set" {
    if args.length != 1 { return "" }
    return "{[" + args[0] + "]:boolean}"
  }
  if args.length != 2 { return "" }
  "{[" + args[0] + "]:" + args[1] + "}"
}

// `name` with every builtin collection application (`Map<K,V>`, `Set<T>`) rewritten, at any
// depth, to the index signature it denotes — the spelling the emitter's name tables read.
// Unchanged when it names none, or when a user declaration owns the head.
export function builtinCollNorm(name: string): string {
  if !name.includes("Map<") && !name.includes("Set<") { return name }
  let out = ""
  let from = 0
  let i = 0
  while i + 4 <= name.length {
    const head = name.slice(i, i + 4)
    let boundary = true
    if i > 0 { boundary = !isIdentCharAt(name, i - 1) }
    if boundary && (head == "Map<" || head == "Set<") {
      const close = angleCloseAt(name, i + 3)
      if close > i + 3 {
        const sp = builtinCollSpelling(name.slice(i, close + 1))
        if sp != "" {
          out = out + name.slice(from, i) + builtinCollNorm(sp)
          from = close + 1
          i = close
        }
      }
    }
    i = i + 1
  }
  out + name.slice(from, name.length)
}

// The index of the `>` closing the `<` at `lt`, depth-aware and skipping the `>` of an
// arrow `=>`; -1 when the name ends first.
function angleCloseAt(name: string, lt: i32): i32 {
  let depth = 0
  let i = lt
  while i < name.length {
    const c = name[i]
    if c == '<' {
      depth = depth + 1
    } else if c == '>' {
      let arrow = false
      if i > 0 { arrow = name[i - 1] == '=' }
      if !arrow {
        depth = depth - 1
        if depth == 0 { return i }
      }
    }
    i = i + 1
  }
  -1
}

// True if `name` is an application of a declared generic alias whose argument list closes
// the whole name (`Box<i32>`), not `Box<i32>[]` or `Box<i32>|Tag`, whose suffix a caller
// peels first. Checked against the generic-alias registry (`gaIndexOf`), not taken on the
// spelling's word, so an unrelated name merely ending in `>` never matches.
export function nameIsGenAppOfDecl(name: string) {
  // The whole spelling test is `annGenAppSpanEnds` at its home in `tyname.vl`. Only the
  // registry lookup is this function's own, taking the head cut from `gaeLtAt` through
  // `tyname.gaeHeadNameOf`.
  if !annGenAppSpanEnds(name) { return false }
  gaIndexOf(gaeHeadNameOf(name, gaeLtAt(name))) >= 0
}

// The pre-canon spelling of every annotation inside a generic declaration, as a node-index
// column and the name each node carried before `canonEmitTypeNames` rewrote it — read by
// `emit_collect.gaeCollectDecls` and `emit_mono`. Needed since canon's rewrite has no scope:
// inside `type Box<Id> = { v: Id }`, `Id` is the alias's own type parameter, not a resolvable name.
let cgpFieldNodes: i32[] = []
let cgpFieldRaw: string[] = []

// Banks every annotation node inside a generic declaration with the name it carries right
// now, before the rewrite loop runs, so the banked spelling is the declared one. A generic
// alias's field annotations and a generic function's parameter/return annotations share the
// bank and reader, since both ask what this annotation said before canon resolved it.
export function collectGenAliasFieldAnns() {
  cgpFieldNodes = []
  cgpFieldRaw = []
  let gi = 0
  while gi < gaNames.length {
    const decl = P.nodes[gaDeclIxs[gi]]
    if decl is TypeDecl {
      const fields = decl.tdFields
      let fi = 0
      while fi < fields.length {
        // The parser's bodyless sentinel is `tdFields == [-1]`; skip it rather than index
        // the arena with it.
        if fields[fi] >= 0 {
          const fnode = P.nodes[fields[fi]]
          if fnode is FieldDef {
            if fnode.fdType >= 0 {
              const tr = P.nodes[fnode.fdType]
              if tr is TypeRef {
                cgpFieldNodes.push(fnode.fdType)
                cgpFieldRaw.push(builtinCollNorm(tr.tyName))
              }
            }
          }
        }
        fi = fi + 1
      }
    }
    gi = gi + 1
  }
  // The generic-function half: every `<T>`-carrying `FuncDecl`'s parameter and return
  // annotations. Signature only — a `LetDecl` in the body carries the same hazard and is
  // not banked here, since the only consumers today are the parameter and return pins.
  let fx = 0
  while fx < P.nodes.length {
    const fnd = P.nodes[fx]
    if fnd is FuncDecl {
      if fnd.fnTyParams.length > 0 {
        const ps = fnd.fnParams
        let pi = 0
        while pi < ps.length {
          const pnd = P.nodes[ps[pi]]
          if pnd is Param {
            if pnd.parType >= 0 {
              const ptr = P.nodes[pnd.parType]
              if ptr is TypeRef {
                cgpFieldNodes.push(pnd.parType)
                cgpFieldRaw.push(builtinCollNorm(ptr.tyName))
              }
            }
          }
          pi = pi + 1
        }
        if fnd.fnRet >= 0 {
          const rtr = P.nodes[fnd.fnRet]
          if rtr is TypeRef {
            cgpFieldNodes.push(fnd.fnRet)
            cgpFieldRaw.push(builtinCollNorm(rtr.tyName))
          }
        }
      }
    }
    fx = fx + 1
  }
  0
}

// The declared spelling of the annotation at `nodeIx`, or "" when `nodeIx` is not a banked
// one. The emitter's route back to a type-parameter name that alias transparency (or
// numeric-literal-union softening) resolved out of the arena.
export function declAnnRawTyName(nodeIx: i32) {
  let i = 0
  while i < cgpFieldNodes.length {
    if cgpFieldNodes[i] == nodeIx { return cgpFieldRaw[i] }
    i = i + 1
  }
  ""
}

// Clears this module's tables (called from `initChecker`).
export function genAliasAnnsReset() {
  gaNames = []
  gaDeclIxs = []
}
