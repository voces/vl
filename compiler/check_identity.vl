// The checker's rule for `===` and `!==`, reference identity (DECISIONS A15): which operands
// carry an identity, and the refusal when one does not. `check_operators.vl` dispatches here
// after both operands are checked, with literal operands already widened.
// Does not lower anything; the emitter's arm is separate.
import { P, STRICT_EQ_CODE } from "./ast"
import { assignable, tErr, tErrPushTok } from "./check_relate_core"
import { nomBinMixes } from "./check_type_shape"
import {
  T,
  TY_BOOL,
  TY_ERR,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  tyAt,
  tyMentionsErr,
  tyToStr,
} from "./check_types"
import { nodeLastTok } from "./fmt_util"
import { isNullTy, nonNullTy } from "./tyquery"

// Whether a value of type `ty` has an identity `===` can compare: a record, a list, a map, a
// function, a nullable of one, or a union whose arms are records or functions. A type parameter
// answers true, so an instance's re-check decides it at the concrete type.
export function tyHasIdentity(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  match t {
    TyObj | TyFunc | TyArray | TyMap | TyVar => {
      return true
    }
    TyNullable => {
      return tyHasIdentity(t.nInner)
    }
    TyUnion => {
      // Records compare by payload, functions by declaration and environment, a mix per arm.
      let arms = 0
      for m in t.uMembers {
        if !isNullTy(m) {
          if m >= 0 && (tyAt(m) is TyObj || tyAt(m) is TyFunc) {
            arms = arms + 1
          } else {
            return false
          }
        }
      }
      return arms > 0
    }
    TyPrim | TyErr | TyLit | TyNeg => {
      return false
    }
  }
}

// Whether `ty`, a nullable peeled, is a union with both record and function arms, whose identity
// compares each arm its own way.
export function tyIdentityMixesArms(ty: i32): boolean {
  let t = ty
  if t >= 0 && t < T.tys.length {
    const n = tyAt(t)
    if n is TyNullable { t = n.nInner }
  }
  if t < 0 || t >= T.tys.length { return false }
  const u = tyAt(t)
  if !(u is TyUnion) { return false }
  let recs = 0
  let fns = 0
  for m in u.uMembers {
    if m >= 0 && tyAt(m) is TyObj { recs = recs + 1 }
    else if m >= 0 && tyAt(m) is TyFunc { fns = fns + 1 }
  }
  recs > 0 && fns > 0
}

// The operator token of identity compare `ix`: the token after its left operand's last one,
// when that token spells `op`, else -1.
function identityOpTok(leftIx: i32, op: string): i32 {
  const lastL = nodeLastTok(leftIx)
  if lastL < 0 || lastL + 1 >= P.toks.length { return -1 }
  if P.toks[lastL + 1].text != op { return -1 }
  lastL + 1
}

// Raise `msg` at the operator token of compare `ix` (left operand `leftIx`), else at the node.
function identityErr(
  msg: string,
  ix: i32,
  leftIx: i32,
  op: string,
  code: string,
) {
  const tk = identityOpTok(leftIx, op)
  if tk >= 0 { return tErrPushTok(msg, ix, tk, code, "") }
  tErr(msg, ix)
  0
}

// Checks `left op right` (at `ix`) for `op` of `===` or `!==`, over operand types `lt` and `rt`;
// answers `boolean`. An operand with no identity is refused with the `==` spelling, which
// `check --fix` writes; operands no value can share answer -1, the caller's to refuse.
export function checkIdentityBinNode(
  ix: i32,
  leftIx: i32,
  rightIx: i32,
  op: string,
  lt: i32,
  rt: i32,
): i32 {
  if lt == TY_ERR || rt == TY_ERR { return TY_BOOL }
  const eqOp = op.slice(0, 2)
  const sides = [lt, rt]
  for s in sides {
    if s >= 0 && !isNullTy(s) && !tyHasIdentity(s) {
      identityErr(
        "`"
          + op
          + "` compares identity, and `"
          + tyToStr(s)
          + "` has none — use `"
          + eqOp
          + "`",
        ix,
        leftIx,
        op,
        STRICT_EQ_CODE,
      )
      return TY_BOOL
    }
  }
  if lt >= 0 && rt >= 0 && !isNullTy(lt) && !isNullTy(rt) {
    if (
      nomBinMixes(lt, rt, leftIx, rightIx)
      || !(assignable(lt, rt) || assignable(rt, lt))
    ) {
      return -1
    }
  }
  TY_BOOL
}

// Where a value of type `ty` can hold a function, by the ruling's positions: "fn" for a function
// or a nullable of one, "arm" for a union arm, "field" for a record field, "elem" for a list
// element; "" when it can hold none. `seen` guards a recursive type.
export function tyFnPosition(ty: i32, seen: i32[]): string {
  if ty < 0 || ty >= T.tys.length { return "" }
  for sv in seen {
    if sv == ty { return "" }
  }
  seen.push(ty)
  const t = tyAt(ty)
  match t {
    TyFunc => {
      return "fn"
    }
    TyNullable => {
      return tyFnPosition(t.nInner, seen)
    }
    TyUnion => {
      for m in t.uMembers {
        if tyFnPosition(m, seen) != "" { return "arm" }
      }
      return ""
    }
    TyObj => {
      for f in t.objFieldTypes {
        if tyFnPosition(f, seen) != "" { return "field" }
      }
      return ""
    }
    TyArray => {
      if tyFnPosition(t.aElem, seen) != "" { return "elem" }
      return ""
    }
    TyPrim | TyErr | TyLit | TyNeg | TyVar | TyMap => {
      return ""
    }
  }
}

// The refusal of identity constraint `op` over a call's substituted operand types `lt`/`rt`, in
// the direct spelling's words, or "" when both have an identity.
export function identityCstrRefusal(op: string, lt: i32, rt: i32): string {
  const sides = [lt, rt]
  for s in sides {
    if s >= 0 && tyIsRecordFnMix(s) {
      return "`"
        + op
        + "` over a union of records and functions is not supported yet"
    }
    if s >= 0 && !isNullTy(s) && !tyHasIdentity(s) {
      return "`"
        + op
        + "` compares identity, and `"
        + tyToStr(s)
        + "` has none — use `"
        + op.slice(0, 2)
        + "`"
    }
  }
  ""
}

// The operand type that fails identity constraint over `lt`/`rt` (the one `identityCstrRefusal`
// names), or -1.
export function identityCstrOffender(lt: i32, rt: i32): i32 {
  const sides = [lt, rt]
  for s in sides {
    if s >= 0 && (tyIsRecordFnMix(s) || (!isNullTy(s) && !tyHasIdentity(s))) {
      return s
    }
  }
  -1
}

// The first field of record `ty` (a nullable peeled) that can hold a function, or "".
function fnFieldName(ty: i32): string {
  const t = tyAt(nonNullTy(ty))
  if t is TyObj {
    let i = 0
    while i < t.objFieldTypes.length {
      if tyFnPosition(t.objFieldTypes[i], []) != "" {
        return t.objFieldNames[i]
      }
      i = i + 1
    }
  }
  ""
}

// Refuses `==`/`!=` (at `ix`, operand types `lt`/`rt`) when both operands can hold a function,
// which has no value to compare (DECISIONS A15); true when refused. A null or scalar operand
// cannot, so `cb == null` and `u == 5` stay legal; an operand an earlier error typed is skipped.
export function fnEqRefused(ix: i32, op: string, lt: i32, rt: i32): boolean {
  if tyMentionsErr(lt, 8) || tyMentionsErr(rt, 8) { return false }
  const lp = tyFnPosition(lt, [])
  if lp == "" || tyFnPosition(rt, []) == "" { return false }
  let advice = "use `" + op + "=` for identity"
  if lp == "arm" && !(tyHasIdentity(lt) && tyHasIdentity(rt)) {
    advice = "narrow both to the same arm first"
  }
  let what = "a function"
  if lp == "field" {
    what = "`"
      + tyToStr(lt)
      + "`'s field `"
      + fnFieldName(lt)
      + "`, a function,"
    advice = "compare the other fields, or " + advice
  }
  if lp == "elem" { what = "a list of functions" }
  if lp == "arm" { what = "a union with a function arm" }
  tErr(
    "`"
      + op
      + "` compares values, and "
      + what
      + " has none: `"
      + tyToStr(lt)
      + "` and `"
      + tyToStr(rt)
      + "` can both hold a function — "
      + advice,
    ix,
  )
  true
}
