// Record adoption: the solve that gives each binding the record its demands share, the
// refusal when two disagree, and the note a refusal of an adopted value carries.
// Does not import the checker.
import { Call, LetDecl, P, i32ToStr, nodeAt, tsListOf } from "./ast"
import { nodeLineOf } from "./check_capture_loss"
import { nodeTyIxOf } from "./check_node_tys"
import { pinRefuse, pinRefusedAt } from "./check_pin_refusals"
import { recAdPass, recAdProg, recAdRaising } from "./check_rec_adopt_rows"
import {
  REC_STORE_DEPTH,
  fieldStorageEq,
  recNumMergeField,
} from "./check_ty_relate"
import {
  T,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  objFieldType,
  tyAt,
  tyElemOf,
  tySame,
  tyToStr,
  tyToTs,
} from "./check_types"
import { i32ListHas } from "./listutil"
import { tyHasTyVar } from "./tyquery"

// Move each settled delivery into the demands unless a binding it closes is closed at another
// record by some call: then no delivery of either call adopts, the bindings stay open, and each
// instance reads them at its own type.
function recAdSettle() {
  const bad: {[i32]: boolean} = Map()
  for g in recAdPass.setDeclined { bad[g] = true }
  let changed = true
  while changed {
    changed = false
    let i = 0
    while i < recAdPass.setDecl.length {
      let j = i + 1
      while j < recAdPass.setDecl.length {
        if recAdPass.setDecl[i] == recAdPass.setDecl[j] {
          const bi = bad.has(recAdPass.setGrp[i])
          const bj = bad.has(recAdPass.setGrp[j])
          const differ = recAdPass.setElem[i] != recAdPass.setElem[j]
            || !fieldStorageEq(
            recAdPass.setDst[i],
            recAdPass.setDst[j],
            REC_STORE_DEPTH,
          )
          const wi = recAdPass.setWhole[i]
          const wj = recAdPass.setWhole[j]
          const wDiffer = (wi < 0) != (wj < 0)
            || wi >= 0 && !fieldStorageEq(wi, wj, REC_STORE_DEPTH)
          if (differ || wDiffer || bi || bj) && !(bi && bj) {
            bad[recAdPass.setGrp[i]] = true
            bad[recAdPass.setGrp[j]] = true
            changed = true
          }
        }
        j = j + 1
      }
      i = i + 1
    }
    // A literal two calls build at different storages is built by neither (D15279).
    i = 0
    while i < recAdPass.setLit.length {
      let j = i + 1
      while j < recAdPass.setLit.length {
        if recAdPass.setLit[i] == recAdPass.setLit[j] {
          const bi = bad.has(recAdPass.setLitGrp[i])
          const bj = bad.has(recAdPass.setLitGrp[j])
          const differ = !fieldStorageEq(
            recAdPass.setLitTy[i],
            recAdPass.setLitTy[j],
            REC_STORE_DEPTH,
          )
          if (differ || bi || bj) && !(bi && bj) {
            bad[recAdPass.setLitGrp[i]] = true
            bad[recAdPass.setLitGrp[j]] = true
            changed = true
          }
        }
        j = j + 1
      }
      i = i + 1
    }
  }
  let li = 0
  while li < recAdPass.setLit.length {
    recAdPass.setLitOk[li] = !bad.has(recAdPass.setLitGrp[li])
    li = li + 1
  }
  let k = 0
  while k < recAdPass.setDecl.length {
    if !bad.has(recAdPass.setGrp[k]) {
      recAdPass.decl.push(recAdPass.setDecl[k])
      recAdPass.own.push(recAdPass.setDst[k])
      recAdPass.dst.push(recAdPass.setDst[k])
      recAdPass.elem.push(recAdPass.setElem[k])
      recAdPass.whole.push(recAdPass.setWhole[k])
      recAdPass.at.push(recAdPass.setAt[k])
    }
    k = k + 1
  }
  return 0
}

// Decide each binding's type: the one record every demand shares a storage with, or a refusal
// naming two that disagree. A binding delivered both whole and by element takes one list type.
// A demand at the enclosing generic's own type parameters is decided first: the demand of each
// pin's re-check instantiates it, so they agree with it and not each other.
export function recAdSolve() {
  recAdSettle()
  let t = 0
  while t < recAdPass.decl.length {
    if tyHasTyVar(recAdPass.dst[t]) { recAdSolveAt(t) }
    t = t + 1
  }
  let i = 0
  while i < recAdPass.decl.length {
    recAdSolveAt(i)
    i = i + 1
  }
  return 0
}

// Decide demand `i`'s binding, unless it is decided or refused.
function recAdSolveAt(i: i32) {
  const decl = recAdPass.decl[i]
  if !i32ListHas(recAdPass.pinDecl, decl) && !pinRefusedAt("recAd", decl) {
    let bad = -1
    let j = 0
    while j < recAdPass.decl.length && bad < 0 {
      if j != i && recAdPass.decl[j] == decl && !recAdDstAgree(i, j) { bad = j }
      j = j + 1
    }
    if bad >= 0 {
      // A union list adopted two ways is no adoption: each delivery is a copy.
      if (
        nodeAt(decl) is LetDecl
        && bad > i
        && !recAdUnionDst(i)
        && !recAdUnionDst(bad)
      ) {
        recAdConflict(decl, i, bad)
      }
    } else {
      let ann = tyToStr(recAdPass.dst[i])
      let root = tyToTs(recAdPass.dst[i])
      if recAdPass.whole[i] >= 0 {
        ann = tyToStr(recAdPass.whole[i])
        root = tyToTs(recAdPass.whole[i])
      } else if recAdPass.elem[i] {
        ann = ann + "[]"
        root = tsListOf(root)
      }
      recAdPass.pinDecl.push(decl)
      recAdPass.pinTy.push(ann)
      recAdPass.pinTs.push(root)
    }
  }
  return 0
}

// Whether demands `i` and `j` adopt one type: a union list only itself, records by storage.
function recAdDstAgree(i: i32, j: i32): boolean {
  if recAdUnionDst(i) || recAdUnionDst(j) {
    return tySame(recAdPass.dst[i], recAdPass.dst[j])
  }
  return fieldStorageEq(recAdPass.dst[i], recAdPass.dst[j], REC_STORE_DEPTH)
}

function recAdUnionDst(i: i32): boolean {
  return tyAt(recAdPass.dst[i]) is TyUnion
}

// A binding whose adoption a re-check undid is built at `dst` and keeps its own type. Where
// `dst` keeps two of a union field's numbers as one, no read at that type can tell which it
// held, so the delivery is refused (D3011).
export function recAdMergeRefuse(
  decl: i32,
  own: i32,
  dst: i32,
  elem: boolean,
  at: i32,
) {
  const f = recNumMergeField(own, dst, REC_STORE_DEPTH)
  if f == "" || pinRefusedAt("recAd", decl) { return 0 }
  const n = nodeAt(decl)
  if !(n is LetDecl) { return 0 }
  const so = tyAt(own)
  const sd = tyAt(dst)
  if !(so is TyObj) || !(sd is TyObj) { return 0 }
  let what = "`" + n.letName + "` is"
  let src = n.letName
  let them = "it"
  if elem {
    what = "the records in `" + n.letName + "` are"
    src = "r"
    them = "each record"
  }
  let copy = "{ "
  let i = 0
  while i < sd.objFieldNames.length {
    if i > 0 { copy = copy + ", " }
    copy = copy + sd.objFieldNames[i] + ": " + src + "." + sd.objFieldNames[i]
    i = i + 1
  }
  copy = copy + " }"
  let fix = " there with an object literal, `" + copy + "`"
  if elem {
    fix = " there, `"
      + n.letName
      + ".map((r): "
      + tyToStr(dst)
      + " => "
      + copy
      + ")`"
  }
  pinRefuse(
    "recAd",
    what
      + " built as "
      + tyToStr(dst)
      + " where line "
      + i32ToStr(nodeLineOf(at))
      + " delivers "
      + them
      + ", which stores field `"
      + f
      + "` (`"
      + tyToStr(objFieldType(so, f))
      + "`) as `"
      + tyToStr(objFieldType(sd, f))
      + "`, keeping two of its numbers as one, so "
      + them
      + " cannot also keep its own type. Copy "
      + them
      + fix,
    decl,
  )
  return 0
}

// The refusal for a binding delivered as two records that store a field differently.
function recAdConflict(decl: i32, a: i32, b: i32) {
  const n = nodeAt(decl)
  let nm = "this binding"
  if n is LetDecl { nm = "`" + n.letName + "`" }
  let what = nm
  if recAdPass.elem[a] { what = "the records in " + nm }
  pinRefuse(
    "recAd",
    nm
      + " holds only a literal, so it is built at the type it is delivered to, but it is "
      + "delivered as "
      + tyToStr(recAdPass.dst[a])
      + " (line "
      + i32ToStr(nodeLineOf(recAdPass.at[a]))
      + ") and as "
      + tyToStr(recAdPass.dst[b])
      + " (line "
      + i32ToStr(nodeLineOf(recAdPass.at[b]))
      + "), which store a field differently, and a record is shared, not copied. Annotate "
      + what
      + " with one of them, and copy it with an object literal for the other",
    decl,
  )
  return 0
}

// Is the refusal at `at` about an adopted value handed on whole: raised by this rule, or at a
// node holding a record stored as an adopted binding's record is (or a list of them)?
export function recAdWholeErr(at: i32): boolean {
  if recAdRaising { return true }
  if at < 0 || at >= P.nodes.length { return false }
  const t = recAdRecOf(nodeTyIxOf(at))
  if t < 0 { return false }
  let i = 0
  while i < recAdPass.bound.length {
    const b = recAdRecOf(recAdPass.bound[i])
    if b >= 0 && fieldStorageEq(t, b, REC_STORE_DEPTH) { return true }
    i = i + 1
  }
  const ts = tyToStr(t)
  let k = 0
  while k < recAdProg.origTy.length {
    if recAdProg.origFn[k] && recAdProg.origTy[k] == ts { return true }
    k = k + 1
  }
  return false
}

// The record `ty` is, or a list of, through `| null`; -1 for anything else.
export function recAdRecOf(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  const t = tyAt(ty)
  match t {
    TyNullable => {
      return recAdRecOf(t.nInner)
    }
    TyArray => {
      return recAdRecOf(tyElemOf(t))
    }
    TyObj => {
      return ty
    }
    // No other type is a record or a list of one.
    TyPrim | TyErr | TyFunc | TyUnion | TyMap | TyVar | TyLit | TyNeg => {
      return -1
    }
  }
}

// The note a refusal of an adopted value carries: which binding or function took which type.
export function recAdNoteFor(at: i32): string {
  const t = recAdRecOf(nodeTyIxOf(at))
  const want = if t >= 0 { tyToStr(t) } else { "" }
  let pick = -1
  let i = 0
  while i < recAdProg.origTy.length {
    let base = recAdProg.origTy[i]
    while base.length > 2 && base.slice(base.length - 2, base.length) == "[]" {
      base = base.slice(0, base.length - 2)
    }
    if pick < 0 || base == want { pick = i }
    i = i + 1
  }
  if pick < 0 { return "" }
  if recAdProg.origFn[pick] {
    return " (`"
      + recAdProg.origName[pick]
      + "` returns only literals, so its result is built as the `"
      + recAdProg.origTy[pick]
      + "` it is delivered to)"
  }
  return " (`"
    + recAdProg.origName[pick]
    + "` holds only "
    + recAdHeldWhat(recAdProg.origDecl[pick])
    + ", so it is built as the `"
    + recAdProg.origTy[pick]
    + "` it is delivered to; annotate it to keep its own type, and copy it for the other use)"
}

// What binding `d` holds fresh, as the adoption note names it: a call's result or a literal.
function recAdHeldWhat(d: i32): string {
  const n = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if n is LetDecl {
    const v = if n.letInit >= 0 { nodeAt(n.letInit) } else { null }
    if v is Call { return "a call's fresh record" }
  }
  return "a literal"
}
