// `symbols.vl` — the compiler's one identifier-intern table, and the arena-node side
// table that carries an identifier's id so it is computed once per node rather than
// once per lookup. `docs/internals/identifier-interning-design.md` holds the rulings;
// each is restated below at the code it constrains.
//
// R1 — one table, in a leaf under `ast`: a mutable global with a reset protocol does
// not belong in the arena's shape module, and a fresh leaf has no illegal down-edge.
//
// R2 — the id space is whole-program, minted per compile, dense from 0 and not stable
// across compiles, so nothing may depend on an id's numeric value. The driver merges
// modules into one arena and renames colliding top-level names; a renamed name is a
// different string, so it interns to a different id and the merge needs no remap.
import {
  Call,
  ForRange,
  FuncDecl,
  Ident,
  LetDecl,
  LoopVar,
  P,
  Param,
  Paren,
  arenaEditBumpCount,
  arenaEditBumps,
  arenaEditCount,
  arenaEditSlotAt,
  arenaNoteRefWrite,
  loopVarName,
  nodeAt,
  ufcsSiteRoot,
} from "./ast"

// ── the table ────────────────────────────────────────────────────────────────
// `sidMap` is the only place a name→id decision is made, and it probes before it
// mints, so "same string ⇒ same id" holds of `sidOf` by construction. The breakable
// half is the carrier below (R4).
let sidMap: {[string]: i32} = Map()
let sidTexts: string[] = []

// The interned id of `text`, minting on first sight — the only minter. One hash plus
// one probe, i.e. exactly the map lookup a converted consumer gives up, so it pays in
// two shapes only: the caller already has the id (from `sidOfNode` or an outer
// intern), or one intern feeds two or more id-keyed lookups in the same call.
export function sidOf(text: string) {
  const hit = sidMap[text] ?? -1
  if hit >= 0 { return hit }
  const id = sidTexts.length
  sidTexts.push(text)
  sidMap[text] = id
  id
}

// The id of `text` if it has already been interned, else -1; never mints. Use it only
// where the table it feeds is already fully built, and prefer `sidOf` in doubt: a
// lazily built table (`parentLetOfSid`) resolves -1 for a name its own build is about
// to intern, and a form recovering its spelling with `sidText` gets "" instead.
export function sidLookup(text: string) { sidMap[text] ?? -1 }

// The inverse: an array read, not a probe. -1 renders as "" so a caller that got its
// id from a name-less node can print it without a guard.
export function sidText(id: i32) {
  if id < 0 { return "" }
  if id >= sidTexts.length { return "" }
  sidTexts[id]
}

// R3 — `sidNode[ix]` is the interned id of node `ix`'s primary name (`identName`,
// `fnName`, `letName`, `parName`, `frVar`, a loop variable's), -1 when it has none and
// `SID_UNFILLED` when unasked; filled lazily and grown on demand. A side table, not a
// node field, because the arena index is what every pass already threads.
const SID_UNFILLED = -2
let sidNode: i32[] = []
// How far `sidNode` has consumed the arena's edit log: a slot replaced since is refilled.
let sidLogPos = 0
let sidLogBumps = 0

// R4 — `sidNode[ix]` must equal `sidOf` of the node's name now, or an identifier resolves to
// the wrong symbol silently. A lazy slot holds until a name is rewritten in place; every such
// write calls this with the declaration a renamed `Ident` now names (-1 when the caller
// cannot say), and that writer set is re-grepped from R3's six fields.
export function sidNoteNodeName(ix: i32, declIx: i32) {
  arenaNoteRefWrite()
  if ix < 0 { return 0 }
  if ix < P.nodes.length {
    if nodeAt(ix) is Ident { identSet(ix, declIx) }
  }
  if ix >= sidNode.length { return 0 }
  sidNode[ix] = SID_UNFILLED
  0
}

// `identDeclIx[ix]`: the declaration the `Ident` at `ix` resolves to, written by the checker's
// last full pass and carried through rewrites; -1 unresolved, `IDENT_BUILTIN` declared by no
// node (a builtin, an extern, a type name). `declOrig[d]` is the declaration a minted
// declaration `d` stands for. fn-value-flow-design.md §(b).
export const IDENT_BUILTIN = -2
let identDeclIx: i32[] = []
let declOrig: {[i32]: i32} = Map()

// `declShadowIx[d]`: the declaration of the same name that `d` hides where it is declared, by the
// binder's scoping rule, or -1. `declMoved` maps a declaration a rewrite moved to its new node.
let declShadowIx: i32[] = []
let declMoved: {[i32]: i32} = Map()
// `declRootIx[d]`: the outermost declaration `d`'s chain of hidden ones reaches, or -2 before it
// is asked; dropped whenever the chain is written.
let declRootIx: i32[] = []

// The audit's must-fire controls: the one propagation site a test switches off, 0 for none.
export const IDENT_DROP_CBOX_READ = 1
export const IDENT_DROP_MONO_CALLEE = 2
export const IDENT_DROP_FN_DECL = 3
export const IDENT_DROP_LOOP_MOVE = 4
export let identAuditDrop = 0
// The armed audit's current pass number, stamped on each entry written; 0 when unarmed.
export let identAuditPass = 0
let identWritePass: i32[] = []

export function identAuditPassSet(n: i32) {
  identAuditPass = n
  0
}

export function identAuditDropSet(site: i32) {
  identAuditDrop = site
  0
}

// Drop both tables; the checker calls this once per full pass, so the last pass's answer stands.
export function identColReset() {
  identDeclIx = []
  memberSlot = Map()
  memberDecl = []
  memberFn = []
  declOrig = Map()
  declShadowIx = []
  declMoved = Map()
  declRootIx = []
  identAuditPass = 0
  identWritePass = []
  0
}

// The declaration `Ident` `ix` resolves to, `IDENT_BUILTIN`, or -1 when none is recorded.
export function identDeclOf(ix: i32) {
  if ix < 0 || ix >= identDeclIx.length { return -1 }
  identDeclIx[ix]
}

// Record that `Ident` `ix` resolves to declaration `declIx`.
export function identSet(ix: i32, declIx: i32) {
  if ix < 0 { return 0 }
  while identDeclIx.length <= ix { identDeclIx.push(-1) }
  identDeclIx[ix] = declIx
  if identAuditPass > 0 {
    while identWritePass.length <= ix { identWritePass.push(0) }
    identWritePass[ix] = identAuditPass
  }
  0
}

// The audit pass that last wrote `ix`'s entry, 0 for the checker or an unarmed compile.
export function identWritePassOf(ix: i32) {
  if ix < 0 || ix >= identWritePass.length { return 0 }
  identWritePass[ix]
}

// Record that declaration `d` hides declaration `o` of the same name; the binder's one writer.
export function declShadowSet(d: i32, o: i32) {
  if d < 0 { return 0 }
  if d >= declShadowIx.length {
    if o < 0 { return 0 }
    let n = P.nodes.length
    if n <= d { n = d + 1 }
    if n < 2 * declShadowIx.length { n = 2 * declShadowIx.length }
    const t: i32[] = __array_new__(n, -1)
    __array_copy__(t, 0, declShadowIx, 0, declShadowIx.length)
    declShadowIx = t
  }
  declShadowIx[d] = o
  declRootIx = []
  0
}

// The declaration `d` hides (`declShadowSet`), at its node after any move, or -1.
export function declShadowOf(d: i32) {
  if d < 0 || d >= declShadowIx.length { return -1 }
  const o = declShadowIx[d]
  if o < 0 { return -1 }
  declMoved[o] ?? o
}

// The outermost declaration `d`'s chain of hidden declarations (`declShadowOf`) reaches: `d`
// itself when it hides none, and any negative slot unchanged. Walked once per declaration.
export function declOutermostOf(d: i32): i32 {
  if d < 0 { return d }
  if d < declRootIx.length && declRootIx[d] != -2 { return declRootIx[d] }
  let k = d
  let o = declShadowOf(k)
  let hops = 0
  while o >= 0 && hops < 64 {
    k = o
    o = declShadowOf(k)
    hops = hops + 1
  }
  if d >= declRootIx.length {
    let n = P.nodes.length
    if n <= d { n = d + 1 }
    const t: i32[] = __array_new__(n, -2)
    __array_copy__(t, 0, declRootIx, 0, declRootIx.length)
    declRootIx = t
  }
  declRootIx[d] = k
  k
}

// Declaration `d` at its node after any move.
export function declMovedOf(d: i32) {
  if d < 0 { return d }
  declMoved[d] ?? d
}

// The declaration minted declaration `d` stands for, or -1 when `d` stands for none.
export function declOrigOf(d: i32) { declOrig[d] ?? -1 }

// The origin column the flow shadow reads (`fn_flow_shadow.vl`): while armed, `identOrig[n]` is
// the node minted node `n` copies, followed back to the first node noted since arming.
let identOrigOn = false
let identOrig: {[i32]: i32} = Map()
// The source node each minted node copies, always recorded: what an elaborated instance table is keyed by.
export let nodeSrc: {[i32]: i32} = Map()
export function nodeSrcNote(newIx: i32, oldIx: i32) {
  if newIx >= 0 && oldIx >= 0 && newIx != oldIx {
    nodeSrc[newIx] = nodeSrc[oldIx] ?? oldIx
  }
  0
}

// Arm (true, dropping what the column held) or stop recording (false, keeping it for reading).
export function identOrigArm(on: boolean) {
  identOrigOn = on
  if on { identOrig = Map() }
  0
}

// Record that minted node `newIx` copies `oldIx`; a no-op unless armed.
export function identOrigNote(newIx: i32, oldIx: i32) {
  if !identOrigOn || newIx < 0 || oldIx < 0 || newIx == oldIx { return 0 }
  identOrig[newIx] = identOrig[oldIx] ?? oldIx
  0
}

// The node `ix` copies, noted since arming, or -1 when it is no copy.
export function identOrigOf(ix: i32) { identOrig[ix] ?? -1 }

// A minted node `newIx` stands for the same binding as `oldIx`: an `Ident` copies its entry,
// a minted declaration records `oldIx`'s original (or `oldIx` itself) as the one it stands for.
export function identFrom(newIx: i32, oldIx: i32) {
  if newIx < 0 || newIx >= P.nodes.length { return 0 }
  identOrigNote(newIx, oldIx)
  if nodeAt(newIx) is Ident { return identSet(newIx, identDeclOf(oldIx)) }
  if oldIx < 0 { return 0 }
  const md = memberDeclOf(oldIx)
  if md != -1 { memberRecord(newIx, md, memberMethodOf(oldIx)) }
  const o = declOrigOf(oldIx)
  if o >= 0 { declOrig[newIx] = o } else { declOrig[newIx] = oldIx }
  0
}

// Each identifier resolving to a key of `moved` (a declaration a rewrite moved to a fresh node,
// leaving another node at its index) resolves to the key's value instead. One walk of the column.
export function identRedirect(moved: {[i32]: i32}) {
  if moved.length == 0 { return 0 }
  for from in moved.keys() {
    const to = moved[from] ?? -1
    if to >= 0 {
      declMoved[from] = to
      declShadowSet(to, declShadowOf(from))
    }
  }
  let i = 0
  while i < identDeclIx.length {
    const to = moved[identDeclIx[i]] ?? -1
    if to >= 0 { identSet(i, to) }
    i = i + 1
  }
  let k = 0
  while k < memberDecl.length {
    const to = moved[memberDecl[k]] ?? -1
    if to >= 0 { memberDecl[k] = to }
    k = k + 1
  }
  0
}

// `memberSlot[c]`: the row of member call `c`, or of its member callee, in the columns below.
// Keyed sparsely, since few nodes are member calls; the rows are dense, so a redirect walks
// recorded calls only.
let memberSlot: {[i32]: i32} = Map()

// `memberDecl[r]`: the declaration row `r`'s property names where the call stands, by lexical
// scope; `IDENT_BUILTIN` declared by no node. One producer for the checker and the emitter, so
// the two cannot dispatch one call to different functions (D14546).
let memberDecl: i32[] = []

// `memberFn[r]`: the method `memberDecl[r]` declares when it is recorded, or -1. A lowering pass
// may replace a binding's initialiser later, so the emitter reads the method from here.
let memberFn: i32[] = []

// Record that member call `callIx`'s property names declaration `declIx`, on the call and on its
// member callee, which is the node the write scan holds.
export function memberDeclSet(callIx: i32, declIx: i32) {
  memberRecord(callIx, declIx, methodFnOfDecl(declIx))
}

// `memberDeclSet` with the method `fnIx` already known, as a copy carries it.
function memberRecord(callIx: i32, declIx: i32, fnIx: i32) {
  if callIx < 0 || callIx >= P.nodes.length { return 0 }
  let r = memberSlotRow(callIx)
  if r < 0 {
    r = memberDecl.length
    memberSlot[callIx] = r
    memberDecl.push(declIx)
    memberFn.push(fnIx)
  } else {
    memberDecl[r] = declIx
    memberFn[r] = fnIx
  }
  const c = nodeAt(callIx)
  if c is Call { memberRecord(c.callFn, declIx, fnIx) }
  0
}

// The row member call `callIx` is recorded at with a declaration, else the row of the call it
// copies, or -1.
function memberRowOf(callIx: i32): i32 {
  const r = memberSlotRow(callIx)
  if r >= 0 && memberDecl[r] != -1 { return r }
  memberSlotRow(ufcsSiteRoot(callIx))
}

// The row recorded for node `ix` since the last reset, or -1.
function memberSlotRow(ix: i32): i32 {
  if ix < 0 { return -1 }
  const r = memberSlot[ix] ?? -1
  if r < 0 || r >= memberDecl.length { return -1 }
  r
}

// The declaration member call `callIx` (or the call it copies) names, `IDENT_BUILTIN`, or -1.
export function memberDeclOf(callIx: i32) {
  const r = memberRowOf(callIx)
  if r < 0 { return -1 }
  memberDecl[r]
}

// The method the declaration `memberDeclOf(callIx)` declared when the binder recorded it, or -1.
export function memberMethodOf(callIx: i32) {
  const r = memberRowOf(callIx)
  if r < 0 { return -1 }
  memberFn[r]
}

// The function declaration `d` names: `d` itself, or the lambda a binding is initialised with
// directly; -1 for any other binding. A binding that only has a function type declares none.
export function fnNodeOfDecl(d: i32): i32 {
  if d < 0 || d >= P.nodes.length { return -1 }
  const dn = nodeAt(d)
  if dn is FuncDecl { return d }
  if !(dn is LetDecl) { return -1 }
  let f = -1
  if dn is LetDecl { f = dn.letInit }
  while f >= 0 && f < P.nodes.length && nodeAt(f) is Paren {
    const pn = nodeAt(f)
    if pn is Paren { f = pn.parInner }
  }
  if f < 0 || f >= P.nodes.length { return -1 }
  const fn = nodeAt(f)
  if fn is FuncDecl {
    if fn.fnName == "" { return f }
  }
  -1
}

// The function `d` declares when it is a method, one whose first parameter is named `self`, or
// -1. Names in a function type are documentation, so only a declaration can qualify.
export function methodFnOfDecl(d: i32): i32 {
  const f = fnNodeOfDecl(d)
  if f < 0 { return -1 }
  const fn = nodeAt(f)
  if fn is FuncDecl {
    if fn.fnParams.length == 0 { return -1 }
    const p0 = nodeAt(fn.fnParams[0])
    if p0 is Param {
      if p0.parName == "self" { return f }
    }
  }
  -1
}

// The parameter nodes of the function declaration `d` names, or the empty list.
export function fnParamsOfDecl(d: i32): i32[] {
  const none: i32[] = []
  const f = fnNodeOfDecl(d)
  if f < 0 { return none }
  const fn = nodeAt(f)
  if fn is FuncDecl { return fn.fnParams }
  none
}

// A minted node `newIx` stands for declaration `declIx`, with no old node to copy from.
export function identFromDecl(newIx: i32, declIx: i32) {
  if newIx < 0 || newIx >= P.nodes.length { return 0 }
  if nodeAt(newIx) is Ident { return identSet(newIx, declIx) }
  if declIx >= 0 { declOrig[newIx] = declIx }
  0
}

// The interned id of the arena node `ix`'s primary name, or -1 if it has none.
// An i32 array read on every call after the first.
export function sidOfNode(ix: i32) {
  if ix < 0 { return -1 }
  if ix >= P.nodes.length { return -1 }
  if arenaEditBumps != sidLogBumps { sidSyncEdits() }
  while sidNode.length <= ix { sidNode.push(SID_UNFILLED) }
  const cur = sidNode[ix]
  if cur != SID_UNFILLED { return cur }
  const n = nodeAt(ix)
  let s = -1
  if n is Ident { s = sidOf(n.identName) }
  else if n is LetDecl { s = sidOf(n.letName) }
  else if n is FuncDecl { s = sidOf(n.fnName) }
  else if n is Param { s = sidOf(n.parName) }
  else if n is ForRange { s = sidOf(n.frVar) }
  else if n is LoopVar { s = sidOf(loopVarName(ix)) }
  sidNode[ix] = s
  s
}

// Retire the slots `arenaSetNode` / `arenaReplaceNode` rewrote since the last read; when a
// log reset falls in between, the logged positions miss some bumps, so drop every slot.
function sidSyncEdits() {
  const n = arenaEditCount()
  const bumps = arenaEditBumpCount()
  if n >= sidLogPos && n - sidLogPos == bumps - sidLogBumps {
    let i = sidLogPos
    while i < n {
      const s = arenaEditSlotAt(i)
      if s >= 0 && s < sidNode.length { sidNode[s] = SID_UNFILLED }
      i = i + 1
    }
  } else {
    sidNode = []
  }
  sidLogPos = n
  sidLogBumps = bumps
  0
}

// Drop the carrier's rows from arena index `n` on: the arena popped them and may reuse the
// indices for different nodes.
export function sidNodeTruncate(n: i32) {
  while sidNode.length > n { sidNode.pop() }
  0
}

// Per-compile reset (R2), called wherever `P.nodes = []` is: the carrier is keyed by
// arena index, so a reset arena reusing an index reads the previous program's answer.
// Every sid-keyed table must be dropped with it — the driver pairs each `sidReset()`
// with `sidKeyedTablesReset()`, since a sid-keyed row collides on a number, not a name.
export function sidReset() {
  sidMap = Map()
  sidTexts = []
  sidNode = []
  nodeSrc = Map()
  sidLogPos = arenaEditCount()
  sidLogBumps = arenaEditBumpCount()
  sidEpoch = sidEpoch + 1
  0
}

// Advances at every `sidReset`, so a sid-indexed cache outside the driver's reset pairing can
// stamp its rows and drop them once the ids are re-minted. Advance, never reset.
export let sidEpoch = 0

// R6 — a name→index map becomes a sid-indexed dense array (a bounds check and a load,
// against a hash and a probe) over an id space dense from 0. Sized at its map's build
// point with every key interned, so a later symbol is a different string and
// `sid >= a.length` is exactly "absent" — provided the array is extended on every write.
export function sidArrGet(a: i32[], sid: i32) {
  if sid < 0 { return -1 }
  if sid >= a.length { return -1 }
  a[sid]
}

// Grow `a` with -1 up to `sid` and store `v`. `a` is a reference, so this writes
// through to the caller's array.
export function sidArrPut(a: i32[], sid: i32, v: i32) {
  if sid < 0 { return 0 }
  while a.length <= sid { a.push(-1) }
  a[sid] = v
  0
}
