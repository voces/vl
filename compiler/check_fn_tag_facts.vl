// The function-set tag facts, held below every rep question that needs them: which set a function
// type's values may be, and which sets are tagged, so that a value of one is its member's i32 id.
// `check_elab_cap` writes them; a module it imports asks `fnTagTyIsTagged`.

import { T, TY_I32, TyMap, mkMapTy, tyAt } from "./check_types"

// The set id a function type's values may be, by type index.
export let elabFnSetTy: {[i32]: i32} = Map()
// The tagged sets, by id.
export let fnTagged: {[i32]: boolean} = Map()

// Whether a value of type `t` is the i32 id of a member of a tagged set.
export function fnTagTyIsTagged(t: i32): boolean {
  if t < 0 { return false }
  const s = elabFnSetTy[t] ?? -1
  s >= 0 && (fnTagged[s] ?? false)
}

// The calls `fvaListSetCopy` built, each a list of a set copied through adapters, by node.
let fvaListCopied: {[i32]: boolean} = Map()

// Forgets every copy, at the start of a compile, whose arena is parsed afresh.
export function fvaListCopyReset() { fvaListCopied = Map() }

// Records call `ix` as a copy `fvaListSetCopy` built.
export function fvaListCopyNote(ix: i32) { fvaListCopied[ix] = true }

// Whether call `ix` is a copy `fvaListSetCopy` built.
export function fvaListCopyAt(ix: i32): boolean { fvaListCopied[ix] ?? false }

// The map type `ty` as it is stored: a value of a tagged function set is its member's i32 id, so
// such a map is the `i32`-valued map at its key (D15186). Any other type is itself.
export function mapStoredTyOf(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return ty }
  const t = tyAt(ty)
  if t is TyMap && fnTagTyIsTagged(t.mVal) {
    return mkMapTy(t.mKey, TY_I32, t.mSet)
  }
  ty
}
