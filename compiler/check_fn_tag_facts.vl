// The function-set tag facts, held below every rep question that needs them: which set a function
// type's values may be, and which sets are tagged, so that a value of one is its member's i32 id.
// `check_elab_cap` writes them; a module it imports asks `fnTagTyIsTagged`.

import {
  T,
  TY_I32,
  TyMap,
  TyObj,
  mkMapTy,
  tyAt,
  tyHasHole,
  tyKeyOf,
  tyValOf,
} from "./check_types"
import { tyHasTyVar } from "./tyquery"

// The set id a function type's values may be, by type index.
export let elabFnSetTy: {[i32]: i32} = Map()
// The tagged sets, by id.
export let fnTagged: {[i32]: boolean} = Map()

// How set `s`'s values are held: `id`, its member's i32 id a call dispatches on, or `closure`,
// its member's closure. The one rep question every site asks of a set, decided once per set.
export type FnSetRep = "id" | "closure"
export function fnSetRep(s: i32): FnSetRep {
  return if s >= 0 && (fnTagged[s] ?? false) { "id" } else { "closure" }
}

// Whether a value of type `t` is the i32 id of a member of a tagged set.
export function fnTagTyIsTagged(t: i32): boolean {
  if t < 0 { return false }
  return fnSetRep(elabFnSetTy[t] ?? -1) == "id"
}

// Whether record type `t` is open only where a field holds a tagged set's id: a list of such
// records is closed for a callback, which takes each element whole.
export function fnTagRecOpenOnlyAtIds(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const o = tyAt(t)
  if !(o is TyObj) { return false }
  let any = false
  for ft in o.objFieldTypes {
    if ft >= 0 && ft < T.tys.length && (tyHasTyVar(ft) || tyHasHole(ft)) {
      if !fnTagTyIsTagged(ft) { return false }
      any = true
    }
  }
  return any
}

// The calls `fvaListSetCopy` built, each a list of a set copied through adapters, by node.
let fvaListCopied: {[i32]: boolean} = Map()

// Forgets every copy, at the start of a compile, whose arena is parsed afresh.
export function fvaListCopyReset() { return fvaListCopied = Map() }

// Records call `ix` as a copy `fvaListSetCopy` built.
export function fvaListCopyNote(ix: i32) { return fvaListCopied[ix] = true }

// Whether call `ix` is a copy `fvaListSetCopy` built.
export function fvaListCopyAt(ix: i32): boolean {
  return fvaListCopied[ix] ?? false
}

// The map type `ty` as it is stored: a value of a tagged function set is its member's i32 id, so
// such a map is the `i32`-valued map at its key (D15186). Any other type is itself.
export function mapStoredTyOf(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return ty }
  const t = tyAt(ty)
  if t is TyMap && fnTagTyIsTagged(tyValOf(t)) {
    return mkMapTy(tyKeyOf(t), TY_I32, t.mSet)
  }
  return ty
}
