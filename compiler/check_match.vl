// A `match` expression: integer and literal arms, type arms with their bindings, and the
// type the arms join to.

import { declTyOf } from "./check_nar_store"
import {
  BinExpr,
  Block,
  Ident,
  IfStmt,
  IsExpr,
  LetDecl,
  MatchExpr,
  P,
  StrLit,
  arenaReplaceNode,
  i32ToStr,
  mkBinary,
  mkIdent,
  nodeAt,
} from "./ast"
import { resolveMatchConstPats } from "./check_annot_resolve"
import {
  checkNodeHook,
  matchArmExits,
  matchOnSpine,
  matchOnSpineSet,
  matchPatWasRefused,
  matchTailNode,
  nestedExitFirstAt,
  valueArmAt,
  valueArmAtSet,
} from "./check_core_state"
import { noteBinCstr } from "./check_cstr_rows"
import { inferQuiet, tpEnvNames } from "./check_cursor"
import { matchUnknownTypeMsg } from "./check_diag_text"
import {
  adoptArmAt,
  isTypeTy,
  litJoinOf,
  matchArmTally,
  matchF32Join,
  tpApartJoinOf,
} from "./check_fit_rules"
import {
  f32ArmPlainTy,
  matchTallyBegin,
  matchTallyEnd,
  valDiscarded,
} from "./check_if_value"
import { tpIfOkAt } from "./check_tp_join"
import {
  blockTailTy,
  intArmRejectMsg,
  matchArmHasBinds,
  matchInRetTail,
  matchInRetTailSet,
  matchIntLitTyValue,
  matchIntPatLexeme,
  matchIntPatValue,
  matchNulPatHint,
  matchScrutRejectMsg,
  matchStrPatLabel,
  matchValued,
  matchValuedSet,
  retTailPos,
  retTailPosSet,
  spineAt,
  spineAtSet,
} from "./check_leaf_steps"
import {
  isVarTyIx,
  isVarTyIxCap,
  isVarTyIxPush,
  isVarTyIxSetAt,
  noteTpJoinRow,
  tpMatchOk,
  tpMatchOkSet,
} from "./check_list_union"
import {
  desugarMatchAt,
  matchArmBindsOf,
  matchArmsAreIntLits,
  matchConstPatLitAt,
  matchElseArmOf,
  matchPatIsWild,
  matchPatLabel,
  matchPatValNode,
} from "./check_match_desugar"
import { noteIntMatchHead } from "./check_match_heads"
import {
  applyNarrows,
  collectElseNarrows,
  collectThenNarrows,
  markUnionCover,
  matchRestNarrows,
  matchValPatFact,
  popScope,
} from "./check_narrow_flow"
import { pushScope } from "./check_narrow_paths"
import { declareDecl } from "./check_scopes"
import { armLit } from "./check_nj_join"
import { checkMatchBindNames, refuseNestedExitFirst } from "./check_node_rules"
import { nodeTyIx, nodeTySet } from "./check_node_tys"
import { numLitAdoptDst } from "./check_num_adopt"
import { matchPatIntNumOf } from "./check_num_lits"
import { assignable, joinArmLit, tErr } from "./check_relate_core"
import { mapTwinTestMsg } from "./check_ty_relate"
import {
  LitKind,
  TY_BOOL,
  TY_ERR,
  TY_NULL,
  TY_VOID,
  TyErr,
  TyLit,
  TyNullable,
  TyUnion,
  tyAt,
  tyIsCompositePat,
  tyIsHole,
  tyToStr,
} from "./check_types"
import {
  flattenVariantsInto,
  isNullTy,
  tyHasNullMember,
  tyIsIntMatchScrut,
  unionHasLitMember,
} from "./tyquery"
import { i32ListAt } from "./listutil"
import { identFrom } from "./symbols"

// ── match ──────────────────────────────────────────────────────────────────

// One integer-literal arm pattern: type-checks it against the scrutinee and claims its value,
// reporting a mismatch or a duplicate at the pattern. `claimed` holds the values already
// claimed, keyed `hi:lo` so a match of any arm count stays linear (D1990). Answers false only
// for a type mismatch — the one refusal that makes the pattern cover nothing.
function checkIntArmLit(
  patIx: i32,
  numIx: i32,
  neg: boolean,
  st: i32,
  claimed: {[string]: boolean},
  setKeys: string[],
) {
  // Checked as the expression it is, so `nodeTyIx` is filled for the `==` the desugar builds
  // over it — an `i32` literal reaches an `i64` scrutinee by the widening lattice, never the reverse.
  const pt = checkNodeHook(patIx)
  if setKeys.length > 0 && numIx >= 0 {
    return checkIntSetArmLit(patIx, numIx, neg, st, claimed, setKeys)
  }
  if !assignable(pt, st) {
    tErr(
      "match pattern type mismatch: expected "
        + tyToStr(st)
        + ", found "
        + tyToStr(pt),
      patIx,
    )
    return false
  }
  // A hole scrutinee can't decide the compare's form here — record the deferred `==` the
  // desugared chain emits, so the call that pins the parameter adjudicates it later.
  noteBinCstr(st, "==", pt)
  if numIx < 0 { return true }
  const key = matchIntPatValue(numIx, neg)
  if key.length != 2 { return true }
  const k = i32ToStr(key[0]) + ":" + i32ToStr(key[1])
  if claimed.has(k) {
    tErr(
      "redundant match arm: `"
        + matchPatLabel(patIx, matchIntPatLexeme(numIx, neg))
        + " is already covered",
      patIx,
    )
    return true
  }
  claimed.set(k, true)
  true
}

// One integer-literal pattern over an integer literal set: claims its value when it is one of
// `setKeys` (each `hi:lo`), and refuses it as a non-member otherwise. False only for that refusal.
function checkIntSetArmLit(
  patIx: i32,
  numIx: i32,
  neg: boolean,
  st: i32,
  claimed: {[string]: boolean},
  setKeys: string[],
) {
  const key = matchIntPatValue(numIx, neg)
  if key.length != 2 { return true }
  const k = i32ToStr(key[0]) + ":" + i32ToStr(key[1])
  const label = matchPatLabel(patIx, matchIntPatLexeme(numIx, neg))
  let member = false
  for sk in setKeys {
    if sk == k { member = true }
  }
  if !member {
    tErr(
      "match pattern `" + label + " is not a member of " + tyToStr(st),
      patIx,
    )
    return false
  }
  if claimed.has(k) {
    tErr("redundant match arm: `" + label + " is already covered", patIx)
    return true
  }
  claimed.set(k, true)
  true
}

// The `hi:lo` keys and printed labels of an integer literal set's members, in declaration order.
function matchIntSetKeys(setTys: i32[], keys: string[], labels: string[]) {
  for m in setTys {
    const v = matchIntLitTyValue(m)
    const mt = tyAt(m)
    if v.length == 2 && mt is TyLit {
      keys.push(i32ToStr(v[0]) + ":" + i32ToStr(v[1]))
      labels.push(mt.litText)
    }
  }
  0
}

// Lowers the checked `match` at `ix` in place and checks the one node the lowering built.
function matchLower(ix: i32) {
  const built = desugarMatchAt(ix)
  if built >= 0 { checkNodeHook(built) }
  0
}

// `match` over an integer (D1572): integer-literal arms plus a mandatory `_`. Over an integer
// literal set `setTys` (D5710) the arms are its members, and `null` when `setNul`, and naming
// them all is complete. `desugarMatchAt` lowers every pattern to `scrut == pat`.
function checkMatchIntArms(
  n: MatchExpr,
  ix: i32,
  st: i32,
  setTys: i32[],
  setNul: boolean,
) {
  const setKeys: string[] = []
  const setLabels: string[] = []
  matchIntSetKeys(setTys, setKeys, setLabels)
  let nulCovered = false
  // The literal values already claimed, keyed by the 64-bit value's `hi:lo` halves.
  const claimed: {[string]: boolean} = Map()
  let hasWild = false
  let wildArm = -1
  // A pattern that is not an integer literal covers nothing — report it at the pattern and
  // suppress the missing-`_` report below, which would mis-blame coverage for it.
  let sawBadPat = false
  const matchArmTys: i32[] = []
  const mValArms: i32[] = []
  const mValTys: i32[] = []
  const join = matchJoinBegin(ix)
  const nArms = n.matchArmStart.length
  let ai = 0
  while ai < nArms {
    let pj = 0
    while pj < n.matchArmCount[ai] {
      const patIx = n.matchPats[n.matchArmStart[ai] + pj]
      const valIx = matchPatValNode(patIx)
      if matchPatIsWild(patIx) {
        hasWild = true
        if wildArm < 0 { wildArm = ai }
      } else if matchPatWasRefused(patIx) {
        sawBadPat = true
      } else if setNul && matchPatIsNull(patIx) {
        if nulCovered {
          tErr("redundant match arm: `null` is already covered", patIx)
        } else {
          nulCovered = true
        }
      } else {
        const numIx = matchPatIntNumOf(valIx)
        if valIx != patIx && numIx < 0 {
          // A constant whose literal is no integer: its read is checked for the mismatch.
          sawBadPat = true
          checkIntArmLit(patIx, -1, false, st, claimed, setKeys)
        } else if numIx < 0 {
          // Any other pattern is another vocabulary's arm (a type pattern, a member string,
          // or a parse-recovery node) — named here rather than read as a missing member.
          sawBadPat = true
          tErr(intArmRejectMsg(st), patIx)
        } else if (
          !checkIntArmLit(patIx, numIx, numIx != valIx, st, claimed, setKeys)
        ) {
          sawBadPat = true
        } else if valIx == patIx {
          numLitAdoptDst(patIx, st)
        }
      }
      pj = pj + 1
    }
    // An arm after the `_` is dead, and silently reordered if allowed: the wildcard
    // becomes the chain's bare `else`, so a later arm would test first — rejected, not reordered.
    if wildArm >= 0 && ai > wildArm {
      tErr(
        "unreachable match arm — the `_` wildcard must be the last arm",
        n.matchPats[n.matchArmStart[ai]],
      )
    }
    const body = n.matchBodies[ai]
    // Over a literal set the `_` arm sees the scrutinee narrowed to the members left (D5284).
    const restNm: i32[] = []
    const restTy: i32[] = []
    if setKeys.length > 0 && ai == wildArm && n.matchArmCount[ai] == 1 {
      const consumed: i32[] = []
      let si = 0
      while si < setKeys.length {
        if claimed.has(setKeys[si]) { consumed.push(setTys[si]) }
        si = si + 1
      }
      if nulCovered { consumed.push(TY_NULL) }
      matchRestNarrows(n.matchScrut, consumed, restNm, restTy)
    }
    if restNm.length > 0 {
      pushScope(-1)
      applyNarrows(restNm, restTy)
    }
    const armTy = matchArmBodyTy(body)
    if restNm.length > 0 { popScope() }
    matchArmJoinStep(ix, body, armTy, join, matchArmTys, mValArms, mValTys)
    ai = ai + 1
  }
  const matchTy = matchTypeJoinEnd(ix, join, matchArmTys, mValArms, mValTys)
  // Exhaustiveness over a bare integer is the wildcard, and it is required — it has no closed
  // member set, so there is no arm list that could stand in for one. A literal set has one.
  if !hasWild && !sawBadPat {
    if setKeys.length > 0 {
      const covered: i32[] = []
      for k in setKeys { covered.push(if claimed.has(k) { 1 } else { 0 }) }
      matchLitUnionExhaustive(ix, setLabels, covered, setNul && !nulCovered, "")
    } else {
      tErr("non-exhaustive match — an integer `match` needs a `_` arm", ix)
    }
  }
  // Lower to an if/else chain in place (real pass only) so lint + emit see only if-chains.
  if !inferQuiet {
    matchLower(ix)
    if !sawBadPat && setKeys.length == 0 { noteIntMatchHead(ix) }
  }
  matchTy
}

// Whether match pattern `patIx` is the `null` type pattern.
function matchPatIsNull(patIx: i32): boolean {
  const pn = nodeAt(matchPatValNode(patIx))
  if pn is IsExpr { return pn.isVariant == "null" }
  false
}

// Checks a clause's `const` decls inside the arm's narrowing scope, so `const x = scrut.x`
// reads the field off the narrowed member and the name is visible to the following body.
// A duplicate binding is not checked — `checkMatchBindNames` already reported it, and checking
// it would stack a terse `redeclared x` on that message — but it is bound at the first one's type.
function checkMatchBindDecls(bIx: i32) {
  if bIx < 0 { return 0 }
  const bn = nodeAt(bIx)
  if bn is Block {
    let i = 0
    while i < bn.blkStmts.length {
      let dup = -1
      const st = nodeAt(bn.blkStmts[i])
      if st is LetDecl {
        let j = 0
        while j < i {
          const pv = nodeAt(bn.blkStmts[j])
          if pv is LetDecl {
            if pv.letName == st.letName && dup < 0 { dup = bn.blkStmts[j] }
          }
          j = j + 1
        }
        if dup >= 0 { declareDecl(bn.blkStmts[i], st.letName, declTyOf(dup)) }
      }
      if dup < 0 { checkNodeHook(bn.blkStmts[i]) }
      i = i + 1
    }
  }
  0
}

// What a match's pattern pass settles: whether a `_` arm stands in for the unnamed members,
// and whether some pattern named no member, which suppresses the exhaustiveness report.
type MatchPatScan = {
  hasWild: boolean,
  sawBadPat: boolean,
}

// A match's joined arm value type (-1 while no arm has joined), its value tally, and whether
// every arm joined so far is a literal.
type MatchArmJoin = {
  ty: i32,
  valAcc: i32,
  lit: boolean,
}

// The join of match `ix` before any arm: unset (-1, which `joinTys` treats as the other
// operand; the positive TY_ERR would poison the join), with its value tally begun.
function matchJoinBegin(ix: i32): MatchArmJoin {
  const j: MatchArmJoin = { ty: -1, valAcc: matchTallyBegin(ix), lit: true }
  j
}

// Joins arm `body` of type `armTy` into `j` unless the arm exits, pushing it onto the three
// caller-owned lists.
function matchArmJoinStep(
  ix: i32,
  body: i32,
  armTy: i32,
  j: MatchArmJoin,
  matchArmTys: i32[],
  mValArms: i32[],
  mValTys: i32[],
) {
  if matchArmExits(ix, body, armTy) { return }
  const bodyLit = armLit(armTy, body)
  j.ty = joinArmLit(j.ty, j.lit, f32ArmPlainTy(body, armTy), bodyLit)
  if tpEnvNames.length > 0 { matchArmTys.push(f32ArmPlainTy(body, armTy)) }
  mValArms.push(body)
  mValTys.push(f32ArmPlainTy(body, armTy))
  j.valAcc = matchArmTally(ix, body, armTy, j.valAcc, j.lit, bodyLit)
  j.lit = j.lit && bodyLit
}

function checkMatchTypeArms(n: MatchExpr, ix: i32, st: i32, uMems: i32[]) {
  // `uMems` is the scrutinee's variant list (a nullable contributes its inner variants plus
  // `null`) — a data structure, never a re-split of a rendered spelling. `covered` is parallel.
  const covered: i32[] = []
  let ci = 0
  while ci < uMems.length {
    covered.push(0)
    ci = ci + 1
  }
  // A union with a literal member takes that literal as a value pattern too (D5714); `valMem`
  // maps each such pattern to the member it names.
  const litMems = unionHasLitMember(uMems)
  const valMem: {[i32]: i32} = Map()
  const scan = matchPatScan(n, st, uMems, covered, litMems, valMem)
  const hasWild = scan.hasWild
  // Whether every member is named (or a `_` stands in for the rest) — settled by pass 1, and
  // read by pass 3 as well as by the exhaustiveness report at the end.
  let exhaustive = hasWild
  if !hasWild { exhaustive = matchAllCovered(covered) }
  // Pass 2 (chain order): the progressive else narrowings, folded into `accNames`/`accTys`.
  const elseArm = matchElseArmOf(n.matchPats, n.matchArmStart, n.matchArmCount)
  const accNames: i32[] = []
  const accTys: i32[] = []
  const armAcc = matchElseArmAcc(n, elseArm, valMem, accNames, accTys)
  const matchArmTys: i32[] = []
  const mValArms: i32[] = []
  const mValTys: i32[] = []
  const join = matchArmsJoin(
    n,
    ix,
    elseArm,
    exhaustive,
    valMem,
    armAcc,
    accNames,
    accTys,
    matchArmTys,
    mValArms,
    mValTys,
  )
  const matchTy = matchTypeJoinEnd(ix, join, matchArmTys, mValArms, mValTys)
  // Exhaustiveness: `_` is allowed but never required — a match naming every member is
  // complete without one. Missing members render from the arena types, not a re-split spelling.
  if !hasWild && !scan.sawBadPat { matchTypeExhaustive(ix, uMems, covered) }
  // Lower to an if/else chain in place (real pass only) so lint + emit see only if-chains.
  if !inferQuiet {
    matchLower(ix)
    if litMems { matchBankValTests(ix, n.matchScrut) }
  }
  matchTy
}

// Pass 1 (source order): resolves and validates every pattern of `n`, banks its check type
// and marks the member it covers in `covered` (a value pattern's member in `valMem`).
function matchPatScan(
  n: MatchExpr,
  st: i32,
  uMems: i32[],
  covered: i32[],
  litMems: boolean,
  valMem: {[i32]: i32},
): MatchPatScan {
  let hasWild = false
  let wildArm = -1
  // A pattern that names no member covers nothing — report it at the pattern and suppress the
  // exhaustiveness report (the bad pattern is the root cause; don't cascade).
  let sawBadPat = false
  const nArms = n.matchArmStart.length
  let ai = 0
  while ai < nArms {
    let pj = 0
    while pj < n.matchArmCount[ai] {
      const patIx = n.matchPats[n.matchArmStart[ai] + pj]
      const pn = nodeAt(patIx)
      if matchPatIsWild(patIx) {
        hasWild = true
        if wildArm < 0 { wildArm = ai }
      } else if matchPatWasRefused(patIx) {
        sawBadPat = true
      } else if pn is IsExpr {
        if matchTypePatCover(patIx, pn, st, uMems, covered) { sawBadPat = true }
      } else if litMems && matchValPatMember(patIx, uMems) != -2 {
        if matchValPatCover(patIx, st, uMems, covered, valMem) {
          sawBadPat = true
        }
      } else if pn is StrLit {
        // A string-literal pattern discriminates a litunion's member text; over a value union
        // the arms discriminate types, so name the difference instead of a phantom missing member.
        sawBadPat = true
        tErr(
          "invalid match pattern "
            + pn.strText
            + " — a pattern over a value union is a member type or the `_` wildcard",
          patIx,
        )
      } else {
        sawBadPat = true
        tErr(
          "invalid match pattern — a pattern over a value union is a member type or the `_` wildcard",
          patIx,
        )
      }
      pj = pj + 1
    }
    matchWildLastAt(n, ai, wildArm)
    checkMatchArmBinds(n, ai)
    ai = ai + 1
  }
  const r: MatchPatScan = { hasWild: hasWild, sawBadPat: sawBadPat }
  r
}

// Pass 3 (source order): checks each arm body under its branch's narrowing and joins the arm
// value types, pushing each joined arm onto the three caller-owned lists.
function matchArmsJoin(
  n: MatchExpr,
  ix: i32,
  elseArm: i32,
  exhaustive: boolean,
  valMem: {[i32]: i32},
  armAcc: i32[],
  accNames: i32[],
  accTys: i32[],
  matchArmTys: i32[],
  mValArms: i32[],
  mValTys: i32[],
): MatchArmJoin {
  const join = matchJoinBegin(ix)
  const nArms = n.matchArmStart.length
  let bi = 0
  while bi < nArms {
    const nmz: i32[] = []
    const tyz: i32[] = []
    let q = 0
    while q < armAcc[bi] {
      nmz.push(accNames[q])
      tyz.push(accTys[q])
      q = q + 1
    }
    // The arm's own then-fact, pushed after the accumulated complement (order matters —
    // `applyNarrows` binds in order, so the arm's own type wins over the complement).
    if bi != elseArm || !exhaustive {
      if n.matchArmCount[bi] == 1 {
        const p0 = n.matchPats[n.matchArmStart[bi]]
        const vm0 = valMem[p0]
        if vm0 != null {
          matchValPatFact(n.matchScrut, vm0, true, nmz, tyz)
        } else {
          collectThenNarrows(p0, nmz, tyz)
        }
      }
    }
    const armTy = matchArmScopedBodyTy(n, bi, nmz, tyz)
    const body = n.matchBodies[bi]
    matchArmJoinStep(ix, body, armTy, join, matchArmTys, mValArms, mValTys)
    bi = bi + 1
  }
  join
}

// Checks arm `bi`'s body under the narrowing `nmz`/`tyz` and its payload `const`s, and
// returns the body's type.
function matchArmScopedBodyTy(
  n: MatchExpr,
  bi: i32,
  nmz: i32[],
  tyz: i32[],
): i32 {
  // The scope is pushed for the payload clause too, not just the narrowing — an arm can
  // bind without narrowing, and its `const`s must still be arm-local.
  const bindIx = matchArmBindsOf(n, bi)
  const scoped = nmz.length > 0 || bindIx >= 0
  if scoped {
    pushScope(-1)
    applyNarrows(nmz, tyz)
    checkMatchBindDecls(bindIx)
  }
  const armTy = matchArmBodyTy(n.matchBodies[bi])
  if scoped { popScope() }
  armTy
}

// The match's type from its arms' join: void when no arm joined, else the f32 or literal
// join where one applies, else the join with its type-parameter row noted. Closes the tally.
function matchTypeJoinEnd(
  ix: i32,
  join: MatchArmJoin,
  matchArmTys: i32[],
  mValArms: i32[],
  mValTys: i32[],
): i32 {
  let matchTy = join.ty
  let matchValAcc = join.valAcc
  if matchTy < 0 { matchTy = TY_VOID }
  const mf32 = matchF32Join(ix, matchTy)
  const mlj = litJoinOf(ix, matchTy, mValArms, mValTys)
  if mf32 >= 0 {
    matchTy = mf32
    matchValAcc = mf32
  } else if mlj >= 0 {
    matchTy = mlj
    matchValAcc = mlj
  } else {
    noteTpJoinRow(ix, tpApartJoinOf(matchArmTys), matchTy, tpMatchOk)
  }
  for a in mValArms { adoptArmAt(a, matchTy) }
  matchTallyEnd(ix, matchValAcc)
  matchTy
}

// The type pattern `pn` at `patIx` over the union `st` of members `uMems`: banks its check
// type, marks the member it names in `covered`, and refuses a non-member, a redundant arm or
// a map twin. True when the pattern names no type or a union, so it covers nothing.
function matchTypePatCover(
  patIx: i32,
  pn: IsExpr,
  st: i32,
  uMems: i32[],
  covered: i32[],
): boolean {
  const pt = isTypeTy(pn.isVariant, patIx)
  if pt < 0 {
    tErr(matchUnknownTypeMsg(pn.isVariant, patIx, st), patIx)
    return true
  }
  if tyIsCompositePat(pt) {
    tErr(
      "match pattern `"
        + pn.isVariant
        + "` names a union — list its members as separate arms (`A | B => …`)",
      patIx,
    )
    return true
  }
  // Banks the resolved check type on the pattern node (the `isVarTyIx` row the emitter
  // reads) instead of re-checking, which would duplicate the scrutinee's diagnostics.
  if patIx < isVarTyIxCap {
    while isVarTyIx.length <= patIx { isVarTyIxPush(-1) }
    isVarTyIxSetAt(patIx, pt)
  }
  if patIx < nodeTyIx.length { nodeTySet(patIx, TY_BOOL) }
  const hit = markUnionCover(uMems, covered, pt)
  if hit == 0 {
    tErr(
      "match pattern `" + pn.isVariant + "` is not a member of " + tyToStr(st),
      patIx,
    )
  } else if hit < 0 {
    tErr(
      "redundant match arm: `" + pn.isVariant + "` is already covered",
      patIx,
    )
  }
  const twin = mapTwinTestMsg(uMems, pt, "a `match` arm")
  if twin != "" { tErr(twin, patIx) }
  false
}

// The index in `uMems` of the literal member value pattern `patIx` names: a string or integer
// literal, or a constant holding one. -1 when no member is that literal, -2 for no such pattern.
function matchValPatMember(patIx: i32, uMems: i32[]): i32 {
  const valIx = matchPatValNode(patIx)
  if valIx < 0 || valIx >= P.nodes.length { return -2 }
  const pv = nodeAt(valIx)
  let mi = 0
  if pv is StrLit {
    const inner = matchStrPatInner(pv)
    while mi < uMems.length {
      const mt = tyAt(uMems[mi])
      if mt is TyLit {
        if mt.litKind == "str" && mt.litText == inner { return mi }
      }
      mi = mi + 1
    }
    return -1
  }
  const numIx = matchPatIntNumOf(valIx)
  if numIx < 0 { return -2 }
  const key = matchIntPatValue(numIx, numIx != valIx)
  if key.length != 2 { return -2 }
  while mi < uMems.length {
    const v = matchIntLitTyValue(uMems[mi])
    if v.length == 2 && v[0] == key[0] && v[1] == key[1] { return mi }
    mi = mi + 1
  }
  -1
}

// A string pattern's member text: its lexeme without the quotes (a degenerate one stays whole).
function matchStrPatInner(pv: StrLit): string {
  const raw = pv.strText
  if raw.length >= 2 { return raw.slice(1, raw.length - 1) }
  raw
}

// The value pattern at `patIx` over the union `st` of members `uMems`: checks it, so the
// desugared `==` has its operand's type, and marks the literal member it names in `covered`
// and `valMem`, or refuses a non-member or a redundant arm. True when it covers nothing.
function matchValPatCover(
  patIx: i32,
  st: i32,
  uMems: i32[],
  covered: i32[],
  valMem: {[i32]: i32},
): boolean {
  checkNodeHook(patIx)
  const mi = matchValPatMember(patIx, uMems)
  const valIx = matchPatValNode(patIx)
  const pv = nodeAt(valIx)
  let label = ""
  if pv is StrLit {
    label = matchStrPatLabel(patIx, matchStrPatInner(pv))
  } else {
    const numIx = matchPatIntNumOf(valIx)
    label = "`" + matchPatLabel(patIx, matchIntPatLexeme(numIx, numIx != valIx))
  }
  if mi < 0 {
    tErr("match pattern " + label + " is not a member of " + tyToStr(st), patIx)
    return true
  }
  if covered[mi] == 1 {
    tErr("redundant match arm: " + label + " is already covered", patIx)
  } else {
    covered[mi] = 1
    valMem[patIx] = uMems[mi]
  }
  false
}

// Banks each value test of the chain lowered at `ix` for the checker's narrowing, as a
// hand-written `==` chain banks its own: a name scrutinee gets its own node in each test, typed
// as the earlier tests leave it, so the emitter's `else` reads what is left (D5714).
function matchBankValTests(ix: i32, scrut: i32) {
  const accN: i32[] = []
  const accT: i32[] = []
  let cur = ix
  while cur >= 0 {
    const c = nodeAt(cur)
    cur = -1
    if c is IfStmt && c.ifCond >= 0 && c.ifCond < P.nodes.length {
      if !(nodeAt(c.ifCond) is IsExpr) {
        pushScope(-1)
        applyNarrows(accN, accT)
        matchFreshScrutIn(c.ifCond, scrut)
        const nm: i32[] = []
        const ty: i32[] = []
        collectThenNarrows(c.ifCond, nm, ty)
        popScope()
      }
      collectElseNarrows(c.ifCond, accN, accT)
      cur = c.ifElse
    }
  }
  0
}

// Gives each `scrut == p` test under `condIx` a fresh copy of the name `scrut`, checked in the
// current scope, and under the left's failure for the right of `||`. A scrutinee that is not a
// bare name keeps the shared node.
function matchFreshScrutIn(condIx: i32, scrut: i32) {
  const sn = nodeAt(scrut)
  if !(sn is Ident) { return 0 }
  const c = nodeAt(condIx)
  if c is BinExpr {
    if c.binOp == "||" {
      matchFreshScrutIn(c.binLeft, scrut)
      const ln: i32[] = []
      const lt: i32[] = []
      collectElseNarrows(c.binLeft, ln, lt)
      pushScope(-1)
      applyNarrows(ln, lt)
      matchFreshScrutIn(c.binRight, scrut)
      popScope()
    } else if c.binOp == "==" && c.binLeft == scrut {
      const id = mkIdent(sn.identName, sn.pos)
      identFrom(id, scrut)
      const idTy = checkNodeHook(id)
      while nodeTyIx.length <= id { nodeTyIx.push(-1) }
      nodeTySet(id, idTy)
      arenaReplaceNode(condIx, mkBinary("==", id, c.binRight, c.pos))
    }
  }
  0
}

// Checks arm `ai`'s payload binding. An or-pattern arm may not carry one: it gets no
// then-narrowing (`collectThenNarrows` reports none for the `||` condition), so `scrut.x`
// would not type.
function checkMatchArmBinds(n: MatchExpr, ai: i32) {
  if n.matchArmCount[ai] > 1 {
    if matchArmHasBinds(n, ai) {
      tErr(
        "payload binding is not allowed on an or-pattern arm — give each type its own arm",
        n.matchPats[n.matchArmStart[ai]],
      )
    }
  } else {
    checkMatchBindNames(matchArmBindsOf(n, ai), n.matchBodies[ai])
  }
  0
}

// Is every entry of the parallel covered-flag column set?
function matchAllCovered(covered: i32[]): boolean {
  let ec = 0
  let allCov = true
  while ec < covered.length {
    if covered[ec] == 0 { allCov = false }
    ec = ec + 1
  }
  allCov
}

// Folds every arm but `elseArm` into the else narrowings `accNames`/`accTys`, in chain order
// (`collectElseNarrows`' fold), and answers per arm how much of the accumulator holds when the
// chain enters it. A value pattern in `valMem` takes its member out as its `==` would.
function matchElseArmAcc(
  n: MatchExpr,
  elseArm: i32,
  valMem: {[i32]: i32},
  accNames: i32[],
  accTys: i32[],
): i32[] {
  const nArms = n.matchArmStart.length
  const armAcc: i32[] = []
  let z = 0
  while z < nArms {
    armAcc.push(0)
    z = z + 1
  }
  let ck = 0
  while ck < nArms {
    if ck != elseArm {
      armAcc[ck] = accNames.length
      let pj = 0
      while pj < n.matchArmCount[ck] {
        const p = n.matchPats[n.matchArmStart[ck] + pj]
        const vm = valMem[p]
        if vm != null {
          matchValPatFact(n.matchScrut, vm, false, accNames, accTys)
        } else {
          collectElseNarrows(p, accNames, accTys)
        }
        pj = pj + 1
      }
    }
    ck = ck + 1
  }
  if elseArm >= 0 { armAcc[elseArm] = accNames.length }
  armAcc
}

// Refuses a type match at `ix` that leaves a member of `uMems` uncovered. `_` is allowed but
// never required, and the missing members render from the arena types.
function matchTypeExhaustive(ix: i32, uMems: i32[], covered: i32[]) {
  let missing = ""
  let mk = 0
  while mk < uMems.length {
    if covered[mk] == 0 {
      if missing != "" { missing = missing + ", " }
      missing = missing + tyToStr(uMems[mk])
    }
    mk = mk + 1
  }
  if missing != "" {
    tErr(
      "non-exhaustive match — missing " + missing + " (add the arm or a `_`)",
      ix,
    )
  }
  0
}

// ── a `const` as a match arm (D3271) ─────────────────────────────────────────
// A bare name in pattern position that names no type is a constant, compared by value: the
// pattern node becomes a read of it, so the desugared test is the hand-written `scrut == K`,
// and its literal is where the arm's value is read for duplicates, members and the jump table.

// Extracted from `checkNodeReal`'s `MatchExpr` arm (C3: thin the dispatcher).
export function checkMatchExprNode(n: MatchExpr, ix: i32) {
  // A discarded `match` lowers its arms as statements, as a spine one does, and so do the
  // blocks, `if`s and `match`es at their tails.
  const savedOnSpine = matchOnSpine
  const savedValued = matchValued
  const savedSpine = spineAt
  matchValuedSet(!valDiscarded(ix))
  matchOnSpineSet(spineAt == ix || !matchValued)
  const r = checkMatchExprNodeIn(n, ix)
  if i32ListAt(nestedExitFirstAt, ix) == 1 { refuseNestedExitFirst(ix, r) }
  matchOnSpineSet(savedOnSpine)
  matchValuedSet(savedValued)
  spineAtSet(savedSpine)
  r
}

// The scrutinee and arm bodies are not in return-tail position: the flags are cleared for the
// walk and restored on every exit, so a `match` subexpression stays transparent to a sibling
// in the same statement.
function checkMatchExprNodeIn(n: MatchExpr, ix: i32) {
  const mTail = retTailPos
  const savedMatchTail = matchInRetTail
  matchInRetTailSet(matchTailNode == ix)
  retTailPosSet(false)
  const r = checkMatchExprByScrut(n, ix, mTail)
  matchInRetTailSet(savedMatchTail)
  retTailPosSet(mTail)
  r
}

// Three arm vocabularies, decided by the scrutinee: an integer dispatches on literals
// (D1572), a litunion on member strings, any other union on member types. `mTail` is the
// return-tail flag the enclosing statement held.
function checkMatchExprByScrut(n: MatchExpr, ix: i32, mTail: boolean): i32 {
  const st = checkNodeHook(n.matchScrut)
  matchCheckPatReads(n, st)
  tpMatchOkSet(mTail || tpIfOkAt.has(ix))
  const strSet = matchLitSetTys(st, "str").length > 0
  const intSet = matchLitSetTys(st, "int")
  const setNul = tyHasNullMember(st)
  if tyIsIntMatchScrut(st) || strSet || intSet.length > 0 {
    resolveMatchConstPats(n, false)
  } else if tyIsHole(st) {
    resolveMatchConstPats(n, true)
  }
  if tyIsIntMatchScrut(st) || (tyIsHole(st) && matchArmsAreIntLits(n)) {
    return checkMatchIntArms(n, ix, st, [], false)
  }
  if intSet.length > 0 { return checkMatchIntArms(n, ix, st, intSet, setNul) }
  // D1898 — a NULLABLE literal union takes the member-string vocabulary too, with `null` as
  // one more member: it is the same interned i32 atom as the bare set, `null` riding the spare
  // `-1`, so the desugared `k is null` / `k == "a"` chain is what already lowers.
  if !strSet { return checkMatchUnionScrut(n, ix, st) }
  checkMatchLitUnionArms(n, ix, st, setNul)
}

// Types each type pattern's own read of the scrutinee (a place or `$scrut` copy, D14538) in the
// scrutinee's scope. An error-typed scrutinee has already reported, so its copies are left
// unchecked rather than report the same read again.
function matchCheckPatReads(n: MatchExpr, st: i32) {
  if st < 0 || tyAt(st) is TyErr { return 0 }
  for p in n.matchPats {
    const pn = nodeAt(p)
    if pn is IsExpr {
      if pn.isObj != n.matchScrut { checkNodeHook(pn.isObj) }
    }
  }
  0
}

// The literal members a `match` over `st` is complete over (D5594, D5710): a lone literal type,
// or a union of literals of one `kind`, with `null` allowed beside them. Empty for any other
// type, a union mixing literal kinds among them, which keeps its refusal.
function matchLitSetTys(st: i32, kind: LitKind): i32[] {
  const out: i32[] = []
  const none: i32[] = []
  if st < 0 { return out }
  let core = st
  const sn = tyAt(st)
  if sn is TyNullable { core = sn.nInner }
  if core < 0 { return out }
  const c = tyAt(core)
  if c is TyLit {
    if c.litKind == kind { out.push(core) }
  } else if c is TyUnion {
    for m in c.uMembers {
      const mt = tyAt(m)
      if mt is TyLit {
        if mt.litKind != kind { return none }
        out.push(m)
      } else if !isNullTy(m) {
        return none
      }
    }
  }
  out
}

// A scrutinee that is no one-kind literal set: a union dispatches on its members, a type by a
// type pattern and a literal by its value (D5714), and anything else is refused, unless it is
// error-typed and its own diagnostic already stands.
function checkMatchUnionScrut(n: MatchExpr, ix: i32, st: i32): i32 {
  const uMems: i32[] = []
  flattenVariantsInto(st, uMems)
  if uMems.length > 1 {
    if unionHasLitMember(uMems) { resolveMatchConstPats(n, false) }
    return checkMatchTypeArms(n, ix, st, uMems)
  }
  if st < 0 || !(tyAt(st) is TyErr) { tErr(matchScrutRejectMsg(st), ix) }
  TY_ERR
}

// The member texts (inner, no quotes) of the literal union `st`. `K | null` interns as a
// `TyNullable` over the set while the expanded `"a" | "b" | null` interns as a `TyUnion` with
// a null member, so both forms are read here; the `null` member is not among them.
function matchLitUnionMembers(st: i32): string[] {
  const members: string[] = []
  for mt in matchLitSetTys(st, "str") {
    const mm = tyAt(mt)
    if mm is TyLit { members.push(mm.litText) }
  }
  members
}

// Refuses arm `ai` when it follows the arm `wildArm` holding the `_`: the wildcard becomes the
// chain's bare `else`, so a later arm would test first (D5288). `wildArm` is -1 for none yet.
function matchWildLastAt(n: MatchExpr, ai: i32, wildArm: i32) {
  if wildArm >= 0 && ai > wildArm {
    tErr(
      "unreachable match arm — the `_` wildcard must be the last arm",
      n.matchPats[n.matchArmStart[ai]],
    )
  }
}

// The types the arms before the `_` consumed: each member `covered` marks, and `null` when
// `nulCovered`. The `_` arm's scrutinee is narrowed to what remains (D5284).
function matchConsumedTys(st: i32, covered: i32[], nulCovered: boolean): i32[] {
  const out: i32[] = []
  const tys = matchLitSetTys(st, "str")
  let i = 0
  while i < tys.length && i < covered.length {
    if covered[i] == 1 { out.push(tys[i]) }
    i = i + 1
  }
  if nulCovered { out.push(TY_NULL) }
  out
}

// A literal union's arms: each pattern is a member string, `null` on a nullable set, a
// constant or `_`; the arm bodies join to the match's type, and the members left uncovered are
// refused unless one of its patterns is itself refused. `nulLit` says the scrutinee is nullable.
function checkMatchLitUnionArms(
  n: MatchExpr,
  ix: i32,
  st: i32,
  nulLit: boolean,
): i32 {
  // A parallel covered-flag per member; the `null` member rides `nulCovered`.
  const members = matchLitUnionMembers(st)
  const covered: i32[] = []
  let ci = 0
  while ci < members.length {
    covered.push(0)
    ci = ci + 1
  }
  let nulCovered = false
  let hasWild = false
  let wildArm = -1
  // A pattern that is neither a member string literal nor the `_` wildcard covers nothing —
  // report it at the pattern and suppress the exhaustiveness error below (don't cascade).
  let sawBadPat = false
  const matchArmTys: i32[] = []
  const mValArms: i32[] = []
  const mValTys: i32[] = []
  const join = matchJoinBegin(ix)
  let ai = 0
  while ai < n.matchArmStart.length {
    // Patterns of arm `ai`.
    let pj = 0
    while pj < n.matchArmCount[ai] {
      const patIx = n.matchPats[n.matchArmStart[ai] + pj]
      const pn = nodeAt(matchPatValNode(patIx))
      if matchPatIsWild(patIx) {
        hasWild = true
        if wildArm < 0 { wildArm = ai }
      } else if matchPatWasRefused(patIx) {
        sawBadPat = true
      } else if pn is IsExpr {
        // D1898 — `null` is the one type pattern this vocabulary takes, and only where the
        // scrutinee carries it; on a bare set it is not a member and keeps the wording below.
        if nulLit && pn.isVariant == "null" {
          if nulCovered {
            tErr("redundant match arm: `null` is already covered", patIx)
          } else {
            nulCovered = true
          }
        } else {
          // A type pattern over a literal union: an identifier naming no type reaches this same
          // arm too, so the wording must not silently claim to cover every member.
          sawBadPat = true
          tErr(
            "invalid match pattern `"
              + pn.isVariant
              + "` — a pattern is a member string literal, a `const` with a literal value"
              + matchNulPatHint(nulLit)
              + " or the `_` wildcard",
            patIx,
          )
        }
      } else if pn is StrLit {
        matchStrPatCover(patIx, pn, st, members, covered)
      } else if matchConstPatLitAt(patIx) >= 0 {
        // A constant holding a number: the read is checked for the mismatch it is.
        sawBadPat = true
        tErr(
          "match pattern type mismatch: expected "
            + tyToStr(st)
            + ", found "
            + tyToStr(checkNodeHook(patIx)),
          patIx,
        )
      } else {
        // Any other node kind (a parse-recovered pattern, a future literal form):
        // same story — it covers nothing, so name it rather than mis-blame coverage.
        sawBadPat = true
        tErr(
          "invalid match pattern — a pattern is a member string literal, a `const` with a literal value or the `_` wildcard",
          patIx,
        )
      }
      pj = pj + 1
    }
    matchWildLastAt(n, ai, wildArm)
    // Body value type. (Arm bodies are not checked in return-tail position; the match's joined
    // value seeds the function return once, below — avoids a per-arm void/err mis-seed.)
    const body = n.matchBodies[ai]
    const restNm: i32[] = []
    const restTy: i32[] = []
    if ai == wildArm && n.matchArmCount[ai] == 1 {
      const consumed = matchConsumedTys(st, covered, nulCovered)
      matchRestNarrows(n.matchScrut, consumed, restNm, restTy)
    }
    if restNm.length > 0 {
      pushScope(-1)
      applyNarrows(restNm, restTy)
    }
    const armTy = matchArmBodyTy(body)
    if restNm.length > 0 { popScope() }
    matchArmJoinStep(ix, body, armTy, join, matchArmTys, mValArms, mValTys)
    ai = ai + 1
  }
  const matchTy = matchTypeJoinEnd(ix, join, matchArmTys, mValArms, mValTys)
  // Exhaustiveness: every member covered, or a wildcard. Skipped after an invalid pattern —
  // that arm covers nothing, so a missing-member report would mis-blame what the pattern already explained.
  if !hasWild && !sawBadPat {
    matchLitUnionExhaustive(ix, members, covered, nulLit && !nulCovered, "\"")
  }
  // Lower to an if/else chain in place (real pass only) so lint + emit see only if-chains.
  if !inferQuiet { matchLower(ix) }
  matchTy
}

// The string pattern `pn` at `patIx` over the literal union `st`: marks the member it names
// in `covered`, or refuses a non-member or an already-covered one. A constant's read is
// checked so the desugared `==` has its operand's type.
function matchStrPatCover(
  patIx: i32,
  pn: StrLit,
  st: i32,
  members: string[],
  covered: i32[],
) {
  if matchConstPatLitAt(patIx) >= 0 { checkNodeHook(patIx) }
  const inner = matchStrPatInner(pn)
  let found = -1
  let fi = 0
  while fi < members.length {
    if members[fi] == inner { found = fi }
    fi = fi + 1
  }
  if found < 0 {
    tErr(
      "match pattern "
        + matchStrPatLabel(patIx, inner)
        + " is not a member of "
        + tyToStr(st),
      patIx,
    )
  } else if covered[found] == 1 {
    tErr(
      "redundant match arm: "
        + matchStrPatLabel(patIx, inner)
        + " is already covered",
      patIx,
    )
  } else {
    covered[found] = 1
  }
  0
}

// Checks the arm body `body` as the match's value arm and spine where it is one, and answers
// its value type: a block's tail type, where a statement-tail block (`blockTailTy == -1`, no
// value) is void rather than the -1 error sentinel it shares.
function matchArmBodyTy(body: i32): i32 {
  const svArm = valueArmAt
  if matchValued { valueArmAtSet(body) }
  if matchOnSpine { spineAtSet(body) }
  const bt = checkNodeHook(body)
  valueArmAtSet(svArm)
  let armTy = bt
  const bn = nodeAt(body)
  if bn is Block {
    armTy = blockTailTy
    if armTy < 0 { armTy = TY_VOID }
  }
  armTy
}

// Refuses a literal-union match at `ix` that leaves a member uncovered, naming each missing
// member in declaration order, wrapped in `q`, and `null` last when `nulMissing`.
function matchLitUnionExhaustive(
  ix: i32,
  members: string[],
  covered: i32[],
  nulMissing: boolean,
  q: string,
) {
  let missing = ""
  let mk = 0
  while mk < members.length {
    if covered[mk] == 0 {
      if missing != "" { missing = missing + ", " }
      missing = missing + q + members[mk] + q
    }
    mk = mk + 1
  }
  if nulMissing {
    if missing != "" { missing = missing + ", " }
    missing = missing + "null"
  }
  if missing != "" {
    tErr(
      "non-exhaustive match — missing " + missing + " (add the arm or a `_`)",
      ix,
    )
  }
  0
}
