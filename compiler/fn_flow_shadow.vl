// The function-value flow table (`docs/internals/fn-value-flow-design.md` §(f)). Before
// `monomorphize` it unions the checked tree's bindings into classes, each holding the functions
// that may flow into it (sources) and the signatures it is called or annotated at (pins).
// `monomorphize` reads it to pin a hole lambda that shares a class with a peer. Armed by a host,
// it also grades every function value the monomorphizer decided against its class after the last
// pass, and counts the verdicts as `flow | …` rows in the per-call shadow's bank.
import { nodeTyIxOf } from "./check_node_tys"
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  Call,
  FieldInit,
  ForIn,
  FuncDecl,
  Ident,
  IfStmt,
  Index,
  LetDecl,
  LoopVar,
  MatchExpr,
  Member,
  NumLit,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  RetStmt,
  Spread,
  TypeRef,
  hasNamedArgs,
  i32ToStr,
  loopVarName,
  nodeAt,
  nodeChildren,
  orderArgsByParamNames,
} from "./ast"
import { callBindShadowCount, fnFlowSigFails } from "./call_bind_shadow"
import { monoIsGenericDecl, normTypeAtom, unwrapParen } from "./emit_base"
import { declTyIxOfName, repNameCanonId } from "./emit_rep"
import {
  fnParent,
  fnStmts,
  monoInstFe,
  monoInstOrig,
  monoOrigNode,
  monoStubValueOk,
} from "./emit_state"
import { i32ListHas, strListHas } from "./listutil"
import {
  IDENT_BUILTIN,
  declOrigOf,
  identDeclOf,
  identOrigArm,
  identOrigOf,
  sidArrGet,
  sidArrPut,
} from "./symbols"
import { substTyDeep } from "./check_relate_core"
import { callBindTyOf } from "./check_bind_rows"
import { fnDeclParent } from "./check_decl_scan"
import { paramHoleName } from "./check_tp_join"
import {
  T,
  TyArray,
  TyErr,
  TyFunc,
  TyMap,
  TyNullable,
  TyObj,
  TyUnion,
  TyVar,
  tyAt,
  tyEmitNameKey,
  tyToEmitName,
  tyToStr,
} from "./check_types"
import { tyHasTyVar } from "./tyquery"
import { sigKeyOfTy } from "./emit_sig_tokens"

// 0 off, 1 armed, 2 armed with names in each row, 3 armed and keyed by call path instead of by
// instance (the control the scaling pair must see blow up), 4 named with `trace |` rows.
let ffMode = 0
let ffWork = 0
const FF_NAIVE_CAP = 400000
// The most instance contexts one generic function's calls mint.
const FF_CTX_PER_FN = 64

// ── the classes: union-find over slots, each root holding its class's facts ─────────────────
// Slots and walk marks by (node, context): a chain per node over `ffPairCtx`/`ffPairVal`/
// `ffPairNext`, one head table per kind; a negative node's head is in `ffPairNeg`.
const FF_PAIR_DECL = 0
const FF_PAIR_RET = 1
const FF_PAIR_WALKED = 2
let ffPairHead: i32[][] = [[], [], []]
let ffPairNeg: {[i32]: i32} = Map()
let ffPairCtx: i32[] = []
let ffPairVal: i32[] = []
let ffPairNext: i32[] = []
// Reads the walk resolved to a local binding, by node: the sweep checks none now names a function.
let ffLocalRead: {[i32]: i32} = Map()
// Per declaration: the binding its initializer reads (-2 for a capture cell, which exists because
// its binding is written), and whether an `=` writes it.
let ffDeclFrom: {[i32]: i32} = Map()
let ffDeclWr: {[i32]: boolean} = Map()
// Per pre-mono declaration (`ffOrigDecl`): its node in the walked tree, the function declaring it
// (-1 at module scope), and the `=` writes of it and of its capture cell (`d[0] = v`), by node.
let ffDeclNode: {[i32]: i32} = Map()
let ffDeclFnOf: {[i32]: i32} = Map()
let ffDeclWrites: {[i32]: i32[]} = Map()
let ffCellWrites: {[i32]: i32[]} = Map()
// Calls through an un-annotated `let` lambda, by call: the lambda, the binding, the walk context
// and function that meet each, and their argument slots (`ffLetLamCall`).
let ffLetLamAt: i32[] = []
let ffLetLamFn: i32[] = []
let ffLetLamDecl: i32[] = []
let ffLetLamCtx: i32[] = []
let ffLetLamIn: i32[] = []
let ffLetLamArgs: i32[][] = []
let ufPar: i32[] = []
let ufSrc: i32[][] = []
let ufPin: i32[][] = []
let ufDecl: i32[][] = []
let ufWritten: boolean[] = []
let ufRes: i32[][] = []
let ufTop: string[] = []
let ufKidK: string[][] = []
let ufKidS: i32[][] = []
// Per class root, its source, binding and result lists as sets, so a membership test never
// scans a list that can hold the program (D4942).
let ufSrcAt: {[i32]: {[i32]: boolean}} = Map()
let ufDeclAt: {[i32]: {[i32]: boolean}} = Map()
let ufResAt: {[i32]: {[i32]: boolean}} = Map()
// The directed half, per slot rather than per class: the slots a slot's value flows into, and
// the pins taken at the slot itself. A merge with no direction (two derived slots) flows both
// ways. Per pre-mono declaration or list or record literal, its slot in each context that walks
// it, and that context.
let dfTo: i32[][] = []
let dfPin: i32[][] = []
let ffDeclSlots: {[i32]: i32[]} = Map()
let ffDeclSlotCtx: {[i32]: i32[]} = Map()
// Per pre-mono direct call of a generic, the context it walks its callee in; -1 when two walks of
// the call's own frame give it two.
let ffCallCtx: {[i32]: i32} = Map()

// A pin is the parameter types a class is called or annotated at, in the context that read
// them, and the return an annotation gives it (-1 for a call); `pinName` renders them once the
// compile is over.
let pinTys: i32[][] = []
let pinRet: i32[] = []
let pinName: string[][] = []
// The function each pin is taken in, -1 in module code, and the functions a query leaves out.
let pinFn: i32[] = []
// The call each pin is taken at, -1 for an annotation.
let pinAt: i32[] = []
let ffPinSkip: {[i32]: boolean} = Map()
// The calls a query leaves out, as `ffPinSkip` leaves out functions.
let ffPinCallSkip: {[i32]: boolean} = Map()
// A slot's closed directed pin keys (`ffPathPinKeys`) at `2 * slot`, sigs, and `2 * slot + 1`,
// rets, set where `ffKeyHas` is; valid while no slot, edge or pin has been added since
// (`ffKeyStamp`), and bypassed by a query with `ffPinSkip` set (D4942).
let ffKeyMemo: string[][] = []
let ffKeyHas: boolean[] = []
let ffKeyStamp: i32[] = [-1, -1, -1]
let dfEdgeN = 0

// A context is one walk of a function body: the type bindings its type variables take. Context 0
// binds nothing (module code, a concrete function); 1 is a generic's template walk.
let ctxKeyIx: {[string]: i32} = Map()
// Contexts minted per generic function, bounded by `FF_CTX_PER_FN`.
let ctxPerFn: {[i32]: i32} = Map()
let ctxBN: string[][] = []
let ctxBT: i32[][] = []
let ffCtx = 0
let ffFn = -1
let declCtx: {[i32]: i32} = Map()
let fnCtx: {[i32]: i32} = Map()
let tyFnMemo: {[i32]: i32} = Map()

// The records the sweep grades, keyed by the pre-mono node: 0 a read of a named function, 1 a
// lambda mono may clone, 2 the callee of a direct generic call, 3 an un-annotated parameter.
let rdHead: {[i32]: i32} = Map()
let rdNext: i32[] = []
let rdKind: i32[] = []
let rdSlot: i32[] = []
let rdPos: string[] = []
let rdFn: i32[] = []
let rdCtx: i32[] = []
let rdWalk: i32[] = []

let ffStmts: i32[] = []
let ffSwept = false
let ffBuilt = false

// Arm the shadow for the compiles that follow (see `ffMode`).
export function fnFlowShadowArm(mode: i32) {
  ffMode = mode
  0
}

// The deterministic work the last armed build did: nodes visited plus classes merged.
export function fnFlowShadowWork() { ffWork }

// Start a compile: drop the previous one's table and stop the origin column recording.
export function fnFlowShadowBegin() {
  ffWork = 0
  ffPairHead = [[], [], []]
  ffPairNeg = Map()
  ffPairCtx = []
  ffPairVal = []
  ffPairNext = []
  ffLocalRead = Map()
  ffDeclFrom = Map()
  ffDeclWr = Map()
  ffDeclNode = Map()
  ffDeclFnOf = Map()
  ffDeclWrites = Map()
  ffCellWrites = Map()
  ffLetLamAt = []
  ffLetLamFn = []
  ffLetLamDecl = []
  ffLetLamCtx = []
  ffLetLamIn = []
  ffLetLamArgs = []
  ufPar = []
  ufSrc = []
  ufPin = []
  ufDecl = []
  ufWritten = []
  ufRes = []
  ufTop = []
  ufKidK = []
  ufKidS = []
  ufSrcAt = Map()
  ufDeclAt = Map()
  ufResAt = Map()
  dfTo = []
  dfPin = []
  dfEdgeN = 0
  ffKeyMemo = []
  ffKeyHas = []
  ffKeyStamp = [-1, -1, -1]
  ffDeclSlots = Map()
  ffDeclSlotCtx = Map()
  ffCallCtx = Map()
  pinTys = []
  pinRet = []
  pinName = []
  pinFn = []
  pinAt = []
  ctxKeyIx = Map()
  ctxPerFn = Map()
  ctxBN = []
  ctxBT = []
  declCtx = Map()
  fnCtx = Map()
  tyFnMemo = Map()
  rdHead = Map()
  rdNext = []
  rdKind = []
  rdSlot = []
  rdPos = []
  rdFn = []
  rdCtx = []
  rdWalk = []
  ffStmts = []
  ffSwept = false
  ffBuilt = false
  identOrigArm(false)
  0
}

function ffNew(): i32 {
  const id = ufPar.length
  ufPar.push(id)
  const s: i32[] = []
  ufSrc.push(s)
  const p: i32[] = []
  ufPin.push(p)
  const d: i32[] = []
  ufDecl.push(d)
  ufWritten.push(false)
  const rs: i32[] = []
  ufRes.push(rs)
  ufTop.push("")
  const kk: string[] = []
  ufKidK.push(kk)
  const ks: i32[] = []
  ufKidS.push(ks)
  const to: i32[] = []
  dfTo.push(to)
  const dp: i32[] = []
  dfPin.push(dp)
  id
}

function ffFind(x: i32): i32 {
  if x < 0 || x >= ufPar.length { return -1 }
  let r = x
  while ufPar[r] != r { r = ufPar[r] }
  let c = x
  while ufPar[c] != r {
    const nx = ufPar[c]
    ufPar[c] = r
    c = nx
  }
  r
}

function ffPairHeadOf(kind: i32, a: i32): i32 {
  if kind < 0 || kind >= ffPairHead.length { return -1 }
  if a < 0 { return ffPairNeg[a * 3 - kind] ?? -1 }
  sidArrGet(ffPairHead[kind], a)
}

// The value stored for node `a` in context `ctx` under `kind`, or -1.
function ffPairGet(kind: i32, a: i32, ctx: i32): i32 {
  let e = ffPairHeadOf(kind, a)
  while e >= 0 {
    if ffPairCtx[e] == ctx { return ffPairVal[e] }
    e = ffPairNext[e]
  }
  -1
}

// Store `v` for a pair `ffPairGet` reports absent.
function ffPairAdd(kind: i32, a: i32, ctx: i32, v: i32) {
  const e = ffPairCtx.length
  ffPairCtx.push(ctx)
  ffPairVal.push(v)
  ffPairNext.push(ffPairHeadOf(kind, a))
  if a < 0 {
    ffPairNeg[a * 3 - kind] = e
  } else if kind >= 0 && kind < ffPairHead.length {
    sidArrPut(ffPairHead[kind], a, e)
  }
  0
}

// The slot of node `a` in context `ctx` under `kind`, minted on first use.
function ffSlotOf(kind: i32, a: i32, ctx: i32): i32 {
  const hit = ffPairGet(kind, a, ctx)
  if hit >= 0 { return hit }
  const s = ffNew()
  ffPairAdd(kind, a, ctx, s)
  s
}

// The slot of declaration `d` in context `ctx`.
function ffDeclSlotIn(d: i32, ctx: i32): i32 { ffSlotOf(FF_PAIR_DECL, d, ctx) }

// The slot of function `fn`'s return in context `ctx`.
function ffRetSlotIn(fn: i32, ctx: i32): i32 { ffSlotOf(FF_PAIR_RET, fn, ctx) }

// Whether function `fn` has a walk in context `ctx`.
function ffWalked(fn: i32, ctx: i32): boolean {
  ffPairGet(FF_PAIR_WALKED, fn, ctx) >= 0
}

// The slot of declaration `d` in the context that last declared it (module code when none did).
function ffDeclSlot(d: i32): i32 { ffDeclSlotIn(d, declCtx[d] ?? 0) }

// The key a derived slot is stored under. A map's value and a list's element share one, since a
// container the checker leaves open (an un-annotated parameter) is indexed as a list (D9440).
function ffKidKey(k: string): string {
  if k == "v" { return "e" }
  k
}

function ffKidOf(r: i32, k0: string): i32 {
  if r < 0 || r >= ufKidK.length { return -1 }
  const k = ffKidKey(k0)
  const ks = ufKidK[r]
  let i = 0
  while i < ks.length {
    if ks[i] == k { return ufKidS[r][i] }
    i = i + 1
  }
  -1
}

// The derived slot `k` of `s`'s class: `e` an element, `v` a map value, `r` a call's result,
// `p<i>` a parameter, `f.<name>` a field. Merging two classes merges their derived slots.
function ffKid(s: i32, k: string): i32 {
  const r = ffFind(s)
  if r < 0 { return -1 }
  const hit = ffKidOf(r, k)
  if hit >= 0 { return hit }
  const n = ffNew()
  const r2 = ffFind(s)
  if r2 < 0 || r2 >= ufKidK.length || r2 >= ufKidS.length { return -1 }
  ufKidK[r2].push(ffKidKey(k))
  ufKidS[r2].push(n)
  n
}

function ffI32Merge(into: i32[], from: i32[]) {
  for x in from {
    if !i32ListHas(into, x) { into.push(x) }
  }
  0
}

// How many facts root `r`'s class holds, which decides the side a merge keeps.
function ffClassSize(r: i32): i32 {
  ufSrc[r].length
    + ufPin[r].length
    + ufDecl[r].length
    + ufRes[r].length
    + ufKidK[r].length
}

// Whether `x` is in root `r`'s list of the kind `sets` indexes.
function ffFactHas(sets: {[i32]: {[i32]: boolean}}, r: i32, x: i32): boolean {
  const s = sets[r]
  if s == null { return false }
  s[x] ?? false
}

// Adds `x` to root `r`'s list `xs`, of the kind `sets` indexes, unless it is there.
function ffFactAdd(sets: {[i32]: {[i32]: boolean}}, xs: i32[], r: i32, x: i32) {
  if ffFactHas(sets, r, x) { return 0 }
  xs.push(x)
  let s = sets[r]
  if s == null {
    const fresh: {[i32]: boolean} = Map()
    sets[r] = fresh
    s = fresh
  }
  s[x] = true
  0
}

// Adds root `gone`'s members of `lists` to root `keep`'s, each once, before `gone` is
// re-parented under `keep`.
function ffFactMove(
  sets: {[i32]: {[i32]: boolean}},
  lists: i32[][],
  keep: i32,
  gone: i32,
) {
  for x in lists[gone] { ffFactAdd(sets, lists[keep], keep, x) }
  0
}

// Merge the classes of `a` and `b` (either may be -1, for no flow) and return a member; the
// value flows both ways.
function ffUnion(a: i32, b: i32): i32 {
  ffEdge(a, b)
  ffEdge(b, a)
  ffMerge(a, b)
}

// `ffUnion` for a value that flows from `src` into `dst` only.
function ffInto(dst: i32, src: i32): i32 {
  ffEdge(src, dst)
  ffMerge(dst, src)
}

// The value of either `a` or `b`, as a fresh slot both flow into, in their merged class.
function ffJoin2(a: i32, b: i32): i32 {
  if a < 0 || b < 0 { return ffMerge(a, b) }
  const r = ffFind(ffMerge(a, b))
  if r < 0 { return -1 }
  const j = ffNew()
  if j >= ufPar.length { return -1 }
  ufPar[j] = r
  ffEdge(a, j)
  ffEdge(b, j)
  j
}

function ffEdge(from: i32, to: i32) {
  if from < 0 || to < 0 || from == to || from >= dfTo.length { return 0 }
  dfTo[from].push(to)
  dfEdgeN = dfEdgeN + 1
  0
}

function ffMerge(a: i32, b: i32): i32 {
  if a < 0 { return b }
  if b < 0 { return a }
  const ra = ffFind(a)
  const rb = ffFind(b)
  if ra < 0 || rb < 0 { return -1 }
  if ra == rb { return ra }
  ffWork = ffWork + 1
  // The larger class keeps its lists and the smaller one's move into them, so a slot's facts
  // move O(log n) times however a program chains its merges (D4942).
  let keep = ra
  let gone = rb
  if ffClassSize(rb) > ffClassSize(ra) {
    keep = rb
    gone = ra
  }
  ffFactMove(ufSrcAt, ufSrc, keep, gone)
  ffFactMove(ufDeclAt, ufDecl, keep, gone)
  ffFactMove(ufResAt, ufRes, keep, gone)
  for id in ufPin[gone] { ufPin[keep].push(id) }
  ufPar[gone] = keep
  ufWritten[keep] = ufWritten[ra] || ufWritten[rb]
  if ufTop[ra] == "" {
    ufTop[keep] = ufTop[rb]
  } else {
    ufTop[keep] = ufTop[ra]
  }
  const pk = ufKidK[gone]
  const ps = ufKidS[gone]
  const noK: string[] = []
  const noS: i32[] = []
  ufKidK[gone] = noK
  ufKidS[gone] = noS
  let i = 0
  while i < pk.length {
    const root = ffFind(keep)
    const mine = ffKidOf(root, pk[i])
    if root < 0 || root >= ufKidK.length || root >= ufKidS.length {
      ffUnion(keep, ps[i])
    } else if mine < 0 {
      ufKidK[root].push(pk[i])
      ufKidS[root].push(ps[i])
    } else {
      ffUnion(mine, ps[i])
    }
    i = i + 1
  }
  ra
}

function ffMarkWritten(s: i32) {
  const r = ffFind(s)
  if r >= 0 { ufWritten[r] = true }
  0
}

function ffMarkTop(s: i32, label: string) {
  const r = ffFind(s)
  if r >= 0 && ufTop[r] == "" { ufTop[r] = label }
  0
}

function ffAddDecl(s: i32, d: i32) {
  const r = ffFind(s)
  if r >= 0 { ffFactAdd(ufDeclAt, ufDecl[r], r, d) }
  0
}

// ── contexts ─────────────────────────────────────────────────────────────────────────────────
function ffCtxOf(key: string, bN: string[], bT: i32[]): i32 {
  const hit = ctxKeyIx[key] ?? -1
  if hit >= 0 { return hit }
  const id = ctxBN.length
  ctxBN.push(bN)
  ctxBT.push(bT)
  ctxKeyIx[key] = id
  id
}

// `ty` with the current context's bindings substituted.
function ffSubst(ty: i32): i32 {
  if ty < 0 || ffCtx < 0 || ffCtx >= ctxBN.length { return ty }
  if ctxBN[ffCtx].length == 0 || !tyHasTyVar(ty) { return ty }
  substTyDeep(ty, ctxBN[ffCtx], ctxBT[ffCtx])
}

// Whether type `ty` holds a function anywhere a value can carry one.
function ffTyHasFn(ty: i32, depth: i32): boolean {
  if ty < 0 || ty >= T.tys.length || depth > 6 { return false }
  const memo = tyFnMemo[ty] ?? -1
  if memo >= 0 { return memo == 1 }
  const t = tyAt(ty)
  let has = false
  if t is TyFunc {
    has = true
  } else if t is TyNullable {
    has = ffTyHasFn(t.nInner, depth + 1)
  } else if t is TyArray {
    has = ffTyHasFn(t.aElem, depth + 1)
  } else if t is TyMap {
    has = ffTyHasFn(t.mVal, depth + 1)
  } else if t is TyUnion {
    for m in t.uMembers {
      if ffTyHasFn(m, depth + 1) { has = true }
    }
  } else if t is TyObj {
    for f in t.objFieldTypes {
      if ffTyHasFn(f, depth + 1) { has = true }
    }
  }
  if has { tyFnMemo[ty] = 1 } else { tyFnMemo[ty] = 0 }
  has
}

// ── sources and pins ─────────────────────────────────────────────────────────────────────────
function ffAddPin(s: i32, tys: i32[], ret: i32, at: i32) {
  const r = ffFind(s)
  if r < 0 { return 0 }
  const id = pinTys.length
  pinTys.push(tys)
  pinRet.push(ret)
  pinFn.push(ffFn)
  pinAt.push(at)
  ufPin[r].push(id)
  dfPin[s].push(id)
  0
}

// Pin `s`'s class with each concrete function type annotation `ty` reaches, through lists,
// nullables, unions, records and map values.
function ffPinTy(s: i32, ty: i32, depth: i32) {
  if s < 0 || ty < 0 || ty >= T.tys.length || depth > 6 { return 0 }
  if !ffTyHasFn(ty, 0) { return 0 }
  const t = tyAt(ty)
  if t is TyFunc {
    if !tyHasTyVar(ty) { ffAddPin(s, t.fnParamTypes, t.fnRet, -1) }
    ffPinTy(ffKid(s, "r"), t.fnRet, depth + 1)
    let i = 0
    while i < t.fnParamTypes.length {
      ffPinTy(ffKid(s, "p" + i32ToStr(i)), t.fnParamTypes[i], depth + 1)
      i = i + 1
    }
    return 0
  }
  if t is TyNullable { return ffPinTy(s, t.nInner, depth + 1) }
  if t is TyArray { return ffPinTy(ffKid(s, "e"), t.aElem, depth + 1) }
  if t is TyMap { return ffPinTy(ffKid(s, "v"), t.mVal, depth + 1) }
  if t is TyUnion {
    for m in t.uMembers { ffPinTy(s, m, depth + 1) }
    return 0
  }
  if t is TyObj {
    let i = 0
    while i < t.objFieldNames.length && i < t.objFieldTypes.length {
      ffPinTy(
        ffKid(s, "f." + t.objFieldNames[i]),
        t.objFieldTypes[i],
        depth + 1,
      )
      i = i + 1
    }
    return 0
  }
  ffNoFnTy(ty)
}

// The types `ffTyHasFn` admits are the five above; any other carries no function to pin.
function ffNoFnTy(ty: i32) {
  if ty >= 0 { return 0 }
  0
}

// The arena type annotation node `tn` spells, -1 when it names none.
function ffAnnTy(tn: i32): i32 {
  if tn < 0 || tn >= P.nodes.length { return -1 }
  const r = nodeTyIxOf(tn)
  if r >= 0 { return r }
  const n = nodeAt(tn)
  if n is TypeRef { return declTyIxOfName(n.tyName) }
  -1
}

// The context a function source's own slots live in: a generic's template walk, or the walk
// that declared a concrete function.
function ffSrcCtx(fn: i32): i32 {
  if monoIsGenericDecl(fn) { return 1 }
  fnCtx[fn] ?? 0
}

// Add function `fn` as a source of `s`'s class, linking the class's result and parameter
// slots to the function's own; a function nobody walked yet is walked here.
function ffAddSrc(s: i32, fn: i32, ctx: i32) {
  const r = ffFind(s)
  if r < 0 { return 0 }
  ffFactAdd(ufSrcAt, ufSrc[r], r, fn)
  ffEnsureWalked(fn, ctx)
  ffUnion(ffKid(s, "r"), ffRetSlotIn(fn, ctx))
  if fn < 0 || fn >= P.nodes.length { return 0 }
  const fd = nodeAt(fn)
  if fd is FuncDecl {
    let i = 0
    while i < fd.fnParams.length {
      ffUnion(ffKid(s, "p" + i32ToStr(i)), ffDeclSlotIn(fd.fnParams[i], ctx))
      i = i + 1
    }
  }
  0
}

function ffRecord(
  ix: i32,
  kind: i32,
  slot: i32,
  pos: string,
  fn: i32,
  ctx: i32,
) {
  if ffMode == 4 {
    callBindShadowCount(
      "trace | record "
        + i32ToStr(kind)
        + " "
        + pos
        + " node "
        + i32ToStr(ix)
        + " fn "
        + i32ToStr(fn)
        + " ctx "
        + i32ToStr(ctx)
        + " walk "
        + i32ToStr(ffCtx)
        + " pins "
        + ffJoin(ffClassPins(slot)),
    )
  }
  const id = rdKind.length
  rdKind.push(kind)
  rdSlot.push(slot)
  rdPos.push(pos)
  rdFn.push(fn)
  rdCtx.push(ctx)
  rdWalk.push(ffCtx)
  rdNext.push(rdHead[ix] ?? -1)
  rdHead[ix] = id
  0
}

// ── the walk ─────────────────────────────────────────────────────────────────────────────────
function ffEnsureWalked(fn: i32, ctx: i32) {
  if ffWalked(fn, ctx) { return 0 }
  if ffMode == 3 && ffWork > FF_NAIVE_CAP { return 0 }
  ffPairAdd(FF_PAIR_WALKED, fn, ctx, 1)
  const svCtx = ffCtx
  const svFn = ffFn
  ffCtx = ctx
  ffFn = fn
  ffWalkFn(fn)
  ffCtx = svCtx
  ffFn = svFn
  0
}

function ffWalkFn(fn: i32) {
  const fd = nodeAt(fn)
  if fd is FuncDecl {
    for pi in fd.fnParams {
      declCtx[pi] = ffCtx
      const s = ffDeclSlotIn(pi, ffCtx)
      ffAddDecl(s, pi)
      ffBankDeclSlot(ffOrigDecl(pi), s)
      const p = nodeAt(pi)
      if p is Param {
        if p.parType >= 0 {
          ffPinTy(s, ffSubst(ffAnnTy(p.parType)), 0)
        } else {
          ffRecord(pi, 3, s, "parameter", fn, ffCtx)
        }
        if p.parDefault >= 0 { ffInto(s, ffFlow(p.parDefault, "default")) }
      }
    }
    if fd.fnRet >= 0 {
      ffPinTy(ffRetSlotIn(fn, ffCtx), ffSubst(ffAnnTy(fd.fnRet)), 0)
    }
    ffInto(ffRetSlotIn(fn, ffCtx), ffFlow(fd.fnBody, "return"))
  }
  0
}

// Records slot `s` as the one declaration `o` stands for holds in the current walk.
function ffBankDeclSlot(o: i32, s: i32) {
  const ds = ffDeclSlots[o] ?? []
  if i32ListHas(ds, s) { return 0 }
  ds.push(s)
  ffDeclSlots[o] = ds
  const dc = ffDeclSlotCtx[o] ?? []
  dc.push(ffCtx)
  ffDeclSlotCtx[o] = dc
  0
}

function ffIsLambdaName(nm: string): boolean {
  nm == "" || (nm.length >= 8 && nm.slice(0, 8) == "__lambda")
}

// Walk statement `ix` for its effects; its value is dropped.
function ffStmt(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  ffWork = ffWork + 1
  const n = nodeAt(ix)
  if n is LetDecl {
    declCtx[ix] = ffCtx
    const o = ffOrigDecl(ix)
    ffDeclNode[o] = ix
    ffDeclFnOf[o] = ffFn
    const s = ffDeclSlotIn(ix, ffCtx)
    ffAddDecl(s, ix)
    ffBankDeclSlot(o, s)
    if n.letType >= 0 { ffPinTy(s, ffSubst(ffAnnTy(n.letType)), 0) }
    if n.letInit >= 0 {
      ffDeclFrom[ix] = ffInitBinding(n.letInit)
      ffInto(s, ffFlow(n.letInit, "binding"))
    }
    return 0
  }
  if n is RetStmt {
    if n.retArg >= 0 {
      ffInto(ffRetSlotIn(ffFn, ffCtx), ffFlow(n.retArg, "return"))
    }
    return 0
  }
  if n is FuncDecl {
    // A named nested function: a concrete one is walked here, where its captures stand; a
    // generic one when a call or a read reaches it.
    if ffIsLambdaName(n.fnName) { return ffFlow(ix, "statement") }
    if !monoIsGenericDecl(ix) {
      fnCtx[ix] = ffCtx
      ffEnsureWalked(ix, ffCtx)
    }
    return 0
  }
  if n is ForIn {
    let kid = "e"
    if n.fiDecl2 >= 0 { kid = fnFlowElemKind(n.fiIter) }
    const vd = ffLoopValueDecl(ix)
    declCtx[vd] = ffCtx
    const s = ffDeclSlotIn(vd, ffCtx)
    ffAddDecl(s, vd)
    ffInto(s, ffKid(ffFlow(n.fiIter, "loop"), kid))
    return ffStmt(n.fiBody)
  }
  if n is Block {
    for st in n.blkStmts { ffStmt(st) }
    return 0
  }
  if n is IfStmt {
    ffFlow(n.ifCond, "condition")
    ffStmt(n.ifThen)
    return ffStmt(n.ifElse)
  }
  ffFlow(ix, "statement")
  0
}

// The binding initializer `ix` reads by name, -2 for a capture cell or a read through one, -1
// for any other value.
function ffInitBinding(ix: i32): i32 {
  const n = nodeAt(ix)
  if n is Ident {
    const d = identDeclOf(ix)
    if d < 0 || d >= P.nodes.length || nodeAt(d) is FuncDecl { return -1 }
    return d
  }
  if ffIsCellValue(ix) { return -2 }
  -1
}

// Whether `ix` is the rewrite's capture cell `[v]`, which carries no source position, or a read
// `c[0]` through one.
function ffIsCellValue(ix: i32): boolean {
  const n = nodeAt(ix)
  if n is ArrayLit { return n.pos < 0 && n.arrElems.length == 1 }
  ffIsCellRead(ix)
}

// Whether `ix` is a read `c[0]` of a name.
function ffIsCellRead(ix: i32): boolean {
  const n = nodeAt(ix)
  if n is Index {
    const k = nodeAt(n.idxIndex)
    if nodeAt(n.idxArr) is Ident && k is NumLit { return k.numText == "0" }
  }
  false
}

function ffKids(ix: i32): i32 {
  for k in nodeChildren(ix) { ffFlow(k, "operand") }
  -1
}

// Bank write `w` against the binding its target `ix` names, or the capture cell it writes.
function ffNoteWrite(w: i32, ix: i32) {
  const n = nodeAt(ix)
  let d = -1
  let into = ffDeclWrites
  if n is Ident {
    d = identDeclOf(ix)
  } else if n is Index {
    if ffIsCellRead(ix) {
      d = identDeclOf(n.idxArr)
      into = ffCellWrites
    }
  }
  if d < 0 { return 0 }
  const o = ffOrigDecl(d)
  const ws = into[o] ?? []
  ws.push(w)
  into[o] = ws
  0
}

// The flow of the value of a block: its last statement's, when that is an expression.
function ffBlock(ix: i32, pos: string): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = nodeAt(ix)
  if n is Block {
    const ss = n.blkStmts
    if ss.length == 0 { return -1 }
    let i = 0
    while i < ss.length - 1 {
      ffStmt(ss[i])
      i = i + 1
    }
    const last = ss[ss.length - 1]
    const ln = nodeAt(last)
    if ln is LetDecl || ln is RetStmt || ln is ForIn { return ffStmt(last) - 1 }
    if ln is FuncDecl {
      if !ffIsLambdaName(ln.fnName) { return ffStmt(last) - 1 }
    }
    return ffFlow(last, pos)
  }
  ffFlow(ix, pos)
}

// The element slot kind for indexing `arr`: a map's value or a list's element.
export function fnFlowElemKind(arr: i32): string {
  const t = nodeTyIxOf(arr)
  if t >= 0 && t < T.tys.length {
    const ty = tyAt(t)
    if ty is TyMap { return "v" }
  }
  "e"
}

// The slot written by assigning to place `ix`.
function ffPlace(ix: i32): i32 {
  const u = unwrapParen(ix)
  if u < 0 || u >= P.nodes.length { return -1 }
  const n = nodeAt(u)
  if n is Ident {
    const d = identDeclOf(u)
    if d < 0 { return -1 }
    ffDeclWr[d] = true
    return ffDeclSlot(d)
  }
  if n is Index {
    ffFlow(n.idxIndex, "index")
    return ffKid(ffFlow(n.idxArr, "write target"), fnFlowElemKind(n.idxArr))
  }
  if n is Member {
    return ffKid(ffFlow(n.memObj, "write target"), "f." + n.memProp)
  }
  ffFlow(u, "write target")
}

// The class slot of expression `ix`'s value, or -1 when it carries nothing the table tracks;
// `pos` names the position, for the rows of a function read there.
function ffFlow(ix: i32, pos: string): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  ffWork = ffWork + 1
  const n = nodeAt(ix)
  if n is Ident { return ffIdent(ix, pos) }
  if n is Paren { return ffFlow(n.parInner, pos) }
  if n is AsExpr { return ffFlow(n.asObj, pos) }
  if n is FuncDecl { return ffLambda(ix, pos) }
  if n is Call {
    const r = ffCall(ix, n.callFn)
    // A call returning an open function value is banked as a read is, so its pins are asked
    // where the value is handed on (D6002).
    const ct = nodeTyIxOf(ix)
    if (
      r >= 0
      && ct >= 0
      && ct < T.tys.length
      && tyAt(ct) is TyFunc
      && tyHasTyVar(ct)
    ) {
      ffBankDeclSlot(ffOrigDecl(ix), r)
    }
    return r
  }
  if n is Block { return ffBlock(ix, pos) }
  if n is ArrayLit {
    const s = ffNew()
    ffBankDeclSlot(ffOrigDecl(ix), s)
    const e = ffKid(s, "e")
    for el in n.arrElems {
      const en = nodeAt(el)
      if en is Spread {
        ffInto(e, ffKid(ffFlow(en.spdArg, "spread"), "e"))
      } else {
        ffInto(e, ffFlow(el, "list element"))
      }
    }
    return s
  }
  if n is ObjLit {
    const s = ffNew()
    ffBankDeclSlot(ffOrigDecl(ix), s)
    for fi in n.objFields {
      const f = nodeAt(fi)
      if f is FieldInit {
        ffInto(ffKid(s, "f." + f.fiName), ffFlow(f.fiValue, "field"))
      } else if f is Spread {
        ffInto(s, ffFlow(f.spdArg, "spread"))
      }
    }
    return s
  }
  if n is Index {
    ffFlow(n.idxIndex, "index")
    return ffKid(ffFlow(n.idxArr, "indexed"), fnFlowElemKind(n.idxArr))
  }
  if n is Member {
    if n.memProp == "length" {
      ffFlow(n.memObj, "operand")
      return -1
    }
    return ffKid(ffFlow(n.memObj, "member"), "f." + n.memProp)
  }
  if n is OptMember { return ffKid(ffFlow(n.omObj, "member"), "f." + n.omProp) }
  if n is BinExpr {
    if n.binOp == "=" {
      ffNoteWrite(ix, n.binLeft)
      const pl = ffPlace(n.binLeft)
      ffMarkWritten(pl)
      return ffInto(pl, ffFlow(n.binRight, "write"))
    }
    if n.binOp == "??" {
      return ffJoin2(ffFlow(n.binLeft, pos), ffFlow(n.binRight, pos))
    }
    return ffKids(ix)
  }
  if n is IfStmt {
    ffFlow(n.ifCond, "condition")
    return ffJoin2(ffBlock(n.ifThen, pos), ffBlock(n.ifElse, pos))
  }
  if n is MatchExpr {
    ffFlow(n.matchScrut, "operand")
    let s = -1
    for b in n.matchBodies { s = ffJoin2(s, ffBlock(b, pos)) }
    return s
  }
  if n is LetDecl { return ffStmt(ix) - 1 }
  if n is RetStmt { return ffStmt(ix) - 1 }
  if n is ForIn { return ffStmt(ix) - 1 }
  ffKids(ix)
}

// A read of a name: a named function is a source of a fresh class, a binding is its slot. The
// read's class is banked under the read, so its pins are asked as a binding's are.
function ffIdent(ix: i32, pos: string): i32 {
  const d = identDeclOf(ix)
  if d < 0 || d >= P.nodes.length { return -1 }
  const dn = nodeAt(d)
  if dn is FuncDecl {
    const t = ffNew()
    const c = ffSrcCtx(d)
    ffAddSrc(t, d, c)
    ffBankDeclSlot(ffOrigDecl(ix), t)
    ffRecord(ix, 0, t, pos, d, c)
    return t
  }
  ffLocalRead[ix] = d
  ffDeclSlot(d)
}

// A lambda: the source of a fresh class, its body walked here in the current context.
function ffLambda(ix: i32, pos: string): i32 {
  const t = ffNew()
  ffAddSrc(t, ix, ffCtx)
  let hole = ffCtx != 0
  const fd = nodeAt(ix)
  if fd is FuncDecl {
    for pi in fd.fnParams {
      const p = nodeAt(pi)
      if p is Param {
        if p.parType < 0 { hole = true }
      }
    }
  }
  if hole { ffRecord(ix, 1, t, pos, ix, ffCtx) }
  t
}

// Call `ix` through callee `fnIx`: a declared function, a builtin, a method, or a slot.
function ffCall(ix: i32, fnIx: i32): i32 {
  const c = unwrapParen(fnIx)
  if c < 0 || c >= P.nodes.length || ix < 0 || ix >= P.nodes.length {
    return -1
  }
  const cn = nodeAt(c)
  if cn is Ident {
    const d = identDeclOf(c)
    if d >= 0 && d < P.nodes.length {
      const dn = nodeAt(d)
      if dn is FuncDecl { return ffDirect(ix, c, d) }
    }
    if d == IDENT_BUILTIN || d < 0 { return ffOpaque(ix, cn.identName) }
    const lam = ffGenLamOf(d, "const")
    if lam >= 0 { return ffConstLamCall(ix, ffCalleeSlot(c), lam) }
    const lLam = ffGenLamOf(d, "let")
    if lLam >= 0 { return ffLetLamCall(ix, ffCalleeSlot(c), lLam, d) }
  }
  if cn is Member {
    const rt = nodeTyIxOf(cn.memObj)
    if rt >= 0 && rt < T.tys.length {
      const ty = tyAt(rt)
      if ty is TyArray || ty is TyMap {
        return ffMethod(ix, cn.memObj, cn.memProp)
      }
      // A `.map` / `.filter` lambda over an un-annotated parameter takes its element (D9230).
      const n = nodeAt(ix)
      if (
        ty is TyVar
        && n is Call
        && n.callArgs.length == 1
        && ffIsElemCallback(cn.memProp, n.callArgs[0], cn.memObj)
      ) {
        return ffMethod(ix, cn.memObj, cn.memProp)
      }
      // A store through an un-annotated parameter names its container by the method (D9591).
      const sk = ffStoreKindOfName(cn.memProp)
      if ty is TyVar && n is Call && sk != "" {
        return ffMethodAt(ix, cn.memObj, cn.memProp, sk)
      }
      if ffObjHasField(rt, cn.memProp) || ffBoundObjHasField(rt, cn.memProp) {
        return ffSlotCall(ix, ffFlow(c, "callee"), [])
      }
    }
    ffFlow(cn.memObj, "receiver")
    ffOpaque(ix, "." + cn.memProp)
    if !ffTyKnown(rt) { return ffUntypedResult() }
    return -1
  }
  ffSlotCall(ix, ffCalleeSlot(c), [])
}

// Whether type `rt`, or the record a nullable `rt` holds (a `?.` call's guarded receiver, D9065),
// is a record with field `prop`.
function ffObjHasField(rt: i32, prop: string): boolean {
  let t = rt
  const n = tyAt(rt)
  if n is TyNullable { t = n.nInner }
  if t < 0 || t >= T.tys.length { return false }
  const o = tyAt(t)
  o is TyObj && strListHas(o.objFieldNames, prop)
}

// Whether `rt`, the open type of an un-annotated parameter's receiver, is bound in this walk's
// instance context to a record with field `prop`, so a call through it is a call through the field.
function ffBoundObjHasField(rt: i32, prop: string): boolean {
  if rt < 0 || rt >= T.tys.length || !(tyAt(rt) is TyVar) { return false }
  const bt = ffSubst(rt)
  if bt < 0 || bt == rt || bt >= T.tys.length { return false }
  ffObjHasField(bt, prop)
}

// Any other callee is a value: its slot is the one the call reads a function from.
function ffCalleeSlot(c: i32): i32 { ffFlow(c, "callee") }

// The lambda an un-annotated declaration `d` with keyword `kw` binds when that lambda is generic
// or has a hole, as mono instances it per call; -1 otherwise.
function ffGenLamOf(d: i32, kw: string): i32 {
  const t = ffLetOf(d)
  if t < 0 { return -1 }
  const n = nodeAt(t)
  if !(n is LetDecl) || n.letKw != kw || n.letType >= 0 || n.letInit < 0 {
    return -1
  }
  const iv = nodeAt(n.letInit)
  if (
    !(iv is FuncDecl)
    || !ffIsLambdaName(iv.fnName)
    || !monoIsGenericDecl(n.letInit)
  ) {
    return -1
  }
  n.letInit
}

// A call through slot `s` to the generic lambda `lam` a const binds: the slot call, and the walk
// of the instance mono builds for it, so a call in its body pins at this call's types (D5751).
function ffConstLamCall(ix: i32, s: i32, lam: i32): i32 {
  const fl: i32[] = []
  const res = ffSlotCall(ix, s, fl)
  ffLamInstWalk(ix, lam, fl)
  res
}

// Walks the instance of lambda `lam` that call `ix` makes, flowing the argument slots `fl` into
// its parameters; nothing when the call binds no hole.
function ffLamInstWalk(ix: i32, lam: i32, fl: i32[]) {
  const ctx = ffInstCtx(ix, lam)
  const fd = nodeAt(lam)
  if ctx == (fnCtx[lam] ?? 0) || !(fd is FuncDecl) { return 0 }
  ffEnsureWalked(lam, ctx)
  let i = 0
  while i < fl.length && i < fd.fnParams.length {
    ffEdge(fl[i], ffDeclSlotIn(fd.fnParams[i], ctx))
    i = i + 1
  }
  0
}

// `ffConstLamCall` for a `let` binding `d`, whose instance is walked only once the build has seen
// every write: a written `let` may hold another lambda at the call (D5791).
function ffLetLamCall(ix: i32, s: i32, lam: i32, d: i32): i32 {
  const fl: i32[] = []
  const res = ffSlotCall(ix, s, fl)
  ffLetLamAt.push(ix)
  ffLetLamFn.push(lam)
  ffLetLamDecl.push(d)
  ffLetLamCtx.push(ffCtx)
  ffLetLamIn.push(ffFn)
  ffLetLamArgs.push(fl)
  res
}

// Walks each deferred `let` lambda call in the context that met it, through every lambda the
// binding may hold there: its initializer's and each write's, when every write stores a generic
// lambda literal; a binding written anything else is not walked.
function ffLetLamFinish() {
  const svCtx = ffCtx
  const svFn = ffFn
  let k = 0
  while k < ffLetLamAt.length {
    const d = ffLetLamDecl[k]
    const lams = ffLetLamsHeld(d, ffLetLamFn[k])
    if lams.length > 0 {
      ffCtx = ffLetLamCtx[k]
      ffFn = ffLetLamIn[k]
      for lam in lams { ffLamInstWalk(ffLetLamAt[k], lam, ffLetLamArgs[k]) }
    }
    k = k + 1
  }
  ffCtx = svCtx
  ffFn = svFn
  0
}

// The lambdas the `let` `d` initialized with `init` may hold: `init` alone when nothing writes it,
// with each write's when every write stores a generic lambda literal, else none.
function ffLetLamsHeld(d: i32, init: i32): i32[] {
  const out: i32[] = [init]
  const o = ffOrigDecl(d)
  const ws: i32[] = []
  for w in ffDeclWrites[o] ?? [] { ws.push(w) }
  for w in ffCellWrites[o] ?? [] { ws.push(w) }
  if ws.length == 0 {
    if ffDeclWr[d] ?? false { return [] }
    return out
  }
  for w in ws {
    const b = nodeAt(w)
    if !(b is BinExpr) { return [] }
    const v = unwrapParen(b.binRight)
    if v < 0 { return [] }
    const fd = nodeAt(v)
    if (
      !(fd is FuncDecl)
      || !ffIsLambdaName(fd.fnName)
      || !monoIsGenericDecl(v)
    ) {
      return []
    }
    if !i32ListHas(out, v) { out.push(v) }
  }
  out
}

// A call through a slot pins the slot's class at the argument types, wherever the callee's own
// type leaves a parameter open, and flows each argument into the class's parameter slot. Each
// argument's own slot is pushed onto `fl`.
function ffSlotCall(ix: i32, s: i32, fl: i32[]): i32 {
  const n = nodeAt(ix)
  if n is Call {
    let fps: i32[] = []
    let typed = false
    const ct = nodeTyIxOf(n.callFn)
    if ct >= 0 && ct < T.tys.length {
      const cty = tyAt(ct)
      if cty is TyFunc {
        fps = cty.fnParamTypes
        typed = true
      }
    }
    const tys: i32[] = []
    let i = 0
    while i < n.callArgs.length {
      const a = n.callArgs[i]
      let t = -1
      if i < fps.length {
        if !tyHasTyVar(fps[i]) { t = fps[i] }
      }
      if t < 0 { t = nodeTyIxOf(a) }
      tys.push(ffSubst(t))
      const af = ffFlow(a, "argument")
      fl.push(af)
      ffInto(ffKid(s, "p" + i32ToStr(i)), af)
      i = i + 1
    }
    if s >= 0 { ffAddPin(s, tys, -1, ix) }
    const res = ffKid(s, "r")
    const rr = ffFind(res)
    if rr >= 0 && !typed { ffFactAdd(ufResAt, ufRes[rr], rr, ffFn) }
    return res
  }
  -1
}

// The slot kind a storing method writes on any receiver: `set` and `add` a map's or a set's,
// `push` / `unshift` / `insert` a list's; "" when `name` is no storing method.
function ffStoreKindOfName(name: string): string {
  if name == "set" || name == "add" { return "v" }
  if name == "push" || name == "unshift" || name == "insert" { return "e" }
  ""
}

// Whether the checker gave node type `t` a shape a member read can resolve against.
function ffTyKnown(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const ty = tyAt(t)
  !(ty is TyVar || ty is TyErr)
}

// A fresh slot for the result of a call whose callee type the checker left open.
function ffUntypedResult(): i32 {
  const s = ffNew()
  if ffFn >= 0 && s >= 0 && s < ufRes.length {
    ffFactAdd(ufResAt, ufRes[s], s, ffFn)
  }
  s
}

// A builtin or unresolved callee: a function argument escapes the table there.
function ffOpaque(ix: i32, name: string): i32 {
  const n = nodeAt(ix)
  if n is Call {
    for a in n.callArgs {
      const f = ffFlow(a, "argument")
      if f >= 0 && ffTyHasFn(nodeTyIxOf(a), 0) {
        ffMarkTop(f, "argument of " + name)
      }
    }
  }
  -1
}

// A list or map method: the storage ones move values in and out of the element slot. A stored
// value flows into the slot only, so the slot's pins are not those of the value's other deliveries.
function ffMethod(ix: i32, recv: i32, name: string): i32 {
  ffMethodAt(ix, recv, name, fnFlowElemKind(recv))
}

// `ffMethod` with the receiver's slot kind `k` given by the caller.
function ffMethodAt(ix: i32, recv: i32, name: string, k: string): i32 {
  const n = nodeAt(ix)
  const r = ffFlow(recv, "receiver")
  if n is Call {
    if (
      name == "push"
      || name == "unshift"
      || name == "insert"
      || name == "set"
      || name == "add"
    ) {
      if n.callArgs.length > 0 {
        ffInto(ffKid(r, k), ffFlow(n.callArgs[n.callArgs.length - 1], "stored"))
        let i = 0
        while i < n.callArgs.length - 1 {
          ffFlow(n.callArgs[i], "argument")
          i = i + 1
        }
      }
      return -1
    }
    let mapped = -1
    for a in n.callArgs {
      const af = ffFlow(a, "argument")
      // A lambda over a list of functions takes the element as its first parameter (D9093),
      // and what a `.map` lambda returns is the element of the list it gives (D9171).
      if ffIsElemCallback(name, a, recv) {
        ffInto(ffKid(af, "p0"), ffKid(r, k))
        if name == "map" {
          mapped = ffNew()
          ffInto(ffKid(mapped, "e"), ffKid(af, "r"))
        }
      }
    }
    if mapped >= 0 { return mapped }
    if name == "get" || name == "pop" || name == "shift" || name == "at" {
      return ffKid(r, k)
    }
    // A whole copy of a list of functions is the spread copy the flow pass rewrites it to.
    if fnFlowWholeSliceRecv(ix) >= 0 {
      const s = ffNew()
      ffInto(ffKid(s, k), ffKid(r, k))
      return s
    }
    if (
      name == "slice"
      || name == "concat"
      || name == "filter"
      || name == "reversed"
    ) {
      return r
    }
  }
  -1
}

// The list `xs` of call `xs.slice(0)` when `xs` is a `const` list literal of functions named by
// their declarations, so the call copies it whole as `[...xs]` does; -1 for any other call.
export function fnFlowWholeSliceRecv(ix: i32): i32 {
  const n = nodeAt(ix)
  if !(n is Call) || n.callArgs.length != 1 { return -1 }
  const a = nodeAt(unwrapParen(n.callArgs[0]))
  if !(a is NumLit) || a.numText != "0" { return -1 }
  const c = unwrapParen(n.callFn)
  if c < 0 { return -1 }
  const cm = nodeAt(c)
  if !(cm is Member) || cm.memProp != "slice" { return -1 }
  const recv = unwrapParen(cm.memObj)
  if recv < 0 || !(nodeAt(recv) is Ident) { return -1 }
  const rt = nodeTyIxOf(recv)
  if rt < 0 || rt >= T.tys.length { return -1 }
  const lt = tyAt(rt)
  if !(lt is TyArray) || !ffTyHasFn(lt.aElem, 0) { return -1 }
  const d = identDeclOf(recv)
  if d < 0 { return -1 }
  const dn = nodeAt(d)
  if !(dn is LetDecl) || dn.letKw != "const" || dn.letInit < 0 { return -1 }
  const lit = nodeAt(unwrapParen(dn.letInit))
  if !(lit is ArrayLit) || lit.arrElems.length == 0 { return -1 }
  for e in lit.arrElems {
    if !ffNamesFnDecl(e, 0) { return -1 }
  }
  recv
}

// Whether `e` names a declared function or a parameter, directly or through `const` aliases.
function ffNamesFnDecl(e: i32, depth: i32): boolean {
  const x = unwrapParen(e)
  if x < 0 || depth > 8 || !(nodeAt(x) is Ident) { return false }
  const d = identDeclOf(x)
  if d < 0 { return false }
  const dn = nodeAt(d)
  if dn is FuncDecl || dn is Param { return true }
  dn is LetDecl
    && dn.letKw == "const"
    && dn.letInit >= 0
    && ffNamesFnDecl(dn.letInit, depth + 1)
}

// Whether `a` is a lambda literal, or the name of a declared function, handed to `.map` /
// `.filter` over `recv`, a list whose element holds a function (D9766).
function ffIsElemCallback(name: string, a: i32, recv: i32): boolean {
  if name != "map" && name != "filter" { return false }
  const x = ffCallbackFn(a)
  if x < 0 { return false }
  const fd = nodeAt(x)
  if !(fd is FuncDecl) || fd.fnParams.length == 0 { return false }
  const rt = nodeTyIxOf(recv)
  if rt < 0 || rt >= T.tys.length { return false }
  const lt = tyAt(rt)
  // An un-annotated parameter's receiver is open; the list it is handed decides (D9230).
  if lt is TyVar { return true }
  if !(lt is TyArray) || lt.aElem < 0 || lt.aElem >= T.tys.length {
    return false
  }
  // So is a list of an un-annotated parameter's values (D9552).
  ffTyHasFn(lt.aElem, 0) || tyAt(lt.aElem) is TyVar
}

// The function callback `a` passes: a lambda literal, or the declaration a name of a declared
// function resolves to; -1 for any other argument.
function ffCallbackFn(a: i32): i32 {
  const x = unwrapParen(a)
  if x < 0 || x >= P.nodes.length { return -1 }
  const n = nodeAt(x)
  if n is FuncDecl {
    if ffIsLambdaName(n.fnName) { return x }
    return -1
  }
  if !(n is Ident) { return -1 }
  const d = identDeclOf(x)
  if d < 0 || d >= P.nodes.length || !(nodeAt(d) is FuncDecl) { return -1 }
  d
}

// The arguments of call `n` to `fd`, one per parameter in parameter order, a -1 for one it does
// not pass, then any it cannot place; a call naming no argument keeps its own order (D6281).
function ffArgsInParamOrder(n: Call, fd: FuncDecl): i32[] {
  if !hasNamedArgs(n.callArgNames) { return n.callArgs }
  const names: string[] = []
  for q in fd.fnParams {
    const qn = nodeAt(q)
    if qn is Param { names.push(qn.parName) } else { return n.callArgs }
  }
  orderArgsByParamNames(names, n.callArgs, n.callArgNames)
}

// The parameter index of argument `a` in `ord` (`ffArgsInParamOrder`) among `nPar`, or -1.
function ffParamIxIn(ord: i32[], a: i32, nPar: i32): i32 {
  let j = 0
  while j < ord.length && j < nPar {
    if ord[j] == a { return j }
    j = j + 1
  }
  -1
}

// The closed type the argument in `args` to a parameter of generic `fn` annotated as the bare type
// variable `tp` has, for a binding `t` the checker left open (it binds from the first argument
// that names `tp`, which may be a generic function's own); `t` when no such argument is closed.
// `args` is in parameter order, a -1 for a parameter the call does not pass.
function ffBareParamArgTy(fn: i32, args: i32[], tp: string, t: i32): i32 {
  const fd = nodeAt(fn)
  if !(fd is FuncDecl) { return t }
  let i = 0
  while i < fd.fnParams.length && i < args.length {
    const p = nodeAt(fd.fnParams[i])
    if p is Param && args[i] >= 0 {
      const pt = ffAnnTy(p.parType)
      if pt >= 0 && pt < T.tys.length {
        const pv = tyAt(pt)
        if pv is TyVar {
          const at = ffSubst(nodeTyIxOf(args[i]))
          if pv.tvName == tp && at >= 0 && !tyHasTyVar(at) { return at }
        }
      }
    }
    i = i + 1
  }
  t
}

// The context-key part that gives call `ix` a walk of its own when it hands the callee `t`, a
// type holding an open generic signature, since each call takes its own instance of it (D5530,
// D6471: two records whose fields are generics called at different types); "" otherwise.
function ffOpenSigSiteKey(t: i32, ix: i32): string {
  if t < 0 || t >= T.tys.length || !tyHasTyVar(t) || !ffTyHasFn(t, 0) {
    return ""
  }
  "@" + i32ToStr(ffCtx) + "/" + i32ToStr(ix) + ","
}

// A direct call: a generic callee is walked once per instance, keyed by the bindings its call
// makes; a concrete one once, where it is declared. Arguments flow into its parameter slots.
function ffDirect(ix: i32, callee: i32, fn: i32): i32 {
  const n = nodeAt(ix)
  const fd = nodeAt(fn)
  const ctx = ffInstCtx(ix, fn)
  if n is Call {
    if fd is FuncDecl {
      if monoIsGenericDecl(fn) {
        ffRecord(callee, 2, -1, "direct call", fn, ctx)
        const was = ffCallCtx[ix] ?? ctx
        ffCallCtx[ix] = if was == ctx { ctx } else { -1 }
      }
      ffEnsureWalked(fn, ctx)
      const ord = ffArgsInParamOrder(n, fd)
      for a in n.callArgs {
        const f = ffFlow(a, "argument")
        const j = ffParamIxIn(ord, a, fd.fnParams.length)
        if j >= 0 { ffInto(ffDeclSlotIn(fd.fnParams[j], ctx), f) }
      }
    }
  }
  ffRetSlotIn(fn, ctx)
}

// The context call `ix` walks `fn` in: one per instance of a generic, keyed by the bindings the
// call makes; where `fn` is declared for a concrete one.
function ffInstCtx(ix: i32, fn: i32): i32 {
  const n = nodeAt(ix)
  const fd = nodeAt(fn)
  let ctx = fnCtx[fn] ?? 0
  if n is Call {
    if fd is FuncDecl {
      if monoIsGenericDecl(fn) {
        const bN: string[] = []
        const bT: i32[] = []
        let key = "F" + i32ToStr(fn) + "<"
        const ord = ffArgsInParamOrder(n, fd)
        for tp in fd.fnTyParams {
          let t = ffSubst(callBindTyOf(ix, tp))
          if t < 0 || tyHasTyVar(t) { t = ffBareParamArgTy(fn, ord, tp, t) }
          bN.push(tp)
          bT.push(t)
          key = key + ffCtxTyKey(t) + "," + ffOpenSigSiteKey(t, ix)
        }
        let i = 0
        while i < fd.fnParams.length && i < ord.length {
          const p = nodeAt(fd.fnParams[i])
          if p is Param && ord[i] >= 0 {
            if p.parType < 0 {
              const t = ffSubst(nodeTyIxOf(ord[i]))
              bN.push(paramHoleName(fd.fnName, fn, i))
              bT.push(t)
              key = key + ffCtxTyKey(t) + "," + ffOpenSigSiteKey(t, ix)
            }
          }
          i = i + 1
        }
        if ffMode == 3 {
          key = key + "/" + i32ToStr(ffCtx) + "/" + i32ToStr(ix)
        }
        // A nested generic's captures resolve in the walk that calls it, so each walk of its
        // enclosing function walks its own instance (D13720).
        if (fnDeclParent[fn] ?? -1) != -1 { key = key + "^" + i32ToStr(ffCtx) }
        // A generic that calls itself at a larger type mints a new context per call (D2721):
        // past the cap, its calls share the template's walk, which answers no pin.
        const known = (ctxKeyIx[key] ?? -1) >= 0
        const minted = ctxPerFn[fn] ?? 0
        if known || minted < FF_CTX_PER_FN {
          if !known { ctxPerFn[fn] = minted + 1 }
          ctx = ffCtxOf(key, bN, bT)
        } else {
          ctx = 1
        }
      }
    }
  }
  ctx
}

// The result type function `fn`'s final signature spells: its checked type, else its written
// result, else its template's concrete one; "" when none of them can be read.
function ffResSpell(fn: i32): string {
  const own = ffConcreteRet(fn)
  if own != "" { return own }
  const fd = nodeAt(fn)
  if fd is FuncDecl {
    if fd.fnRet >= 0 && fd.fnRet < P.nodes.length {
      const rn = nodeAt(fd.fnRet)
      if rn is TypeRef {
        const ti = declTyIxOfName(rn.tyName)
        if ti >= 0 && ti < T.tys.length { return ffTyKey(ti) }
      }
      return ""
    }
  }
  const t = ffTemplateOf(fn)
  if t == fn || t < 0 || t >= P.nodes.length { return "" }
  ffConcreteRet(t)
}

// The result type spelled on function `fn`'s declaration, "" when it carries none.
function ffWrittenRet(fn: i32): string {
  const fd = nodeAt(fn)
  if fd is FuncDecl {
    if fd.fnRet >= 0 && fd.fnRet < P.nodes.length {
      const rn = nodeAt(fd.fnRet)
      if rn is TypeRef { return rn.tyName }
    }
  }
  ""
}

function ffConcreteRet(fn: i32): string {
  const ft = nodeTyIxOf(fn)
  if ft < 0 || ft >= T.tys.length { return "" }
  const fty = tyAt(ft)
  if fty is TyFunc {
    if tyHasTyVar(fty.fnRet) { return "" }
    return ffTyKey(fty.fnRet)
  }
  ""
}

function ffTyKey(t: i32): string {
  if t < 0 { return "-" }
  tyToEmitName(t)
}

// A binding's part of a context key: equal where `ffTyKey`'s are, short for a deep record (D2780).
function ffCtxTyKey(t: i32): string {
  if t < 0 { return "-" }
  tyEmitNameKey(t)
}

// Build the table over the tree `monomorphize` is about to rewrite, and start recording which
// nodes mono copies from which. Runs on every armed compile, generic or not.
export function fnFlowShadowBuild(stmts: i32[]) {
  if ffMode == 0 { return 0 }
  ffBuild(stmts)
  identOrigArm(true)
  0
}

// Build the table `monomorphize` reads, unless the armed shadow already built it this compile.
export function fnFlowTableBuild(stmts: i32[]) {
  if ffBuilt { return 0 }
  ffBuild(stmts)
}

// The parameter types of the one signature every call through a class holding lambda `lam`
// agrees on; empty when nothing pins the class, two signatures do, or the lambda is walked
// inside a generic.
export function fnFlowLamPin(lam: i32): i32[] {
  const none: i32[] = []
  let r = rdHead[lam] ?? -1
  let pick = -1
  let pickName = ""
  while r >= 0 {
    if rdKind[r] == 1 {
      if rdWalk[r] != 0 { return none }
      const root = ffFind(rdSlot[r])
      if root < 0 { return none }
      for id in ufPin[root] {
        if !ffPinOpen(id) {
          const nm = ffJoin(ffPinNames(id))
          if pick < 0 {
            pick = id
            pickName = nm
          } else if nm != pickName {
            return none
          }
        }
      }
    }
    r = rdNext[r]
  }
  if pick < 0 { return none }
  pinTys[pick]
}

// Whether the binding read `at`, or one its initializer chain copies, may hold a value other than
// its initializer's: an `=` writes it, or it is a capture cell. True without a built table, the
// safe answer.
export function fnFlowReadWritten(at: i32): boolean {
  if !ffBuilt { return true }
  let d = ffOrigDecl(identDeclOf(at))
  let hops = 0
  while d >= 0 && hops < 64 {
    if ffDeclWr[d] ?? false { return true }
    const f = ffDeclFrom[d] ?? -1
    if f == -2 { return true }
    d = ffOrigDecl(f)
    hops = hops + 1
  }
  hops >= 64
}

// The named generic function the read `at` names through a chain of un-annotated aliases none of
// which an `=` writes (`const k = inner; const j = k`), as its declaration; -1 for any other read.
export function fnFlowReadGenFn(at: i32): i32 {
  if !ffBuilt { return -1 }
  let d = ffOrigDecl(identDeclOf(at))
  let hops = 0
  while d >= 0 && d < P.nodes.length && hops < 64 {
    const n = nodeAt(d)
    if !(n is LetDecl) || n.letType >= 0 || n.letInit < 0 { return -1 }
    if n.letKw != "const" && (ffDeclWr[d] ?? false) { return -1 }
    if !(nodeAt(n.letInit) is Ident) { return -1 }
    const nd = identDeclOf(n.letInit)
    if nd < 0 || nd >= P.nodes.length { return -1 }
    if nodeAt(nd) is FuncDecl {
      if !monoIsGenericDecl(nd) { return -1 }
      return nd
    }
    d = ffOrigDecl(nd)
    hops = hops + 1
  }
  -1
}

// Whether an `=` writes the binding the read `at` names (a capture cell's `d[0] = v` aside).
export function fnFlowDeclWritten(at: i32): boolean {
  const d = identDeclOf(at)
  if !ffBuilt || d < 0 { return false }
  (ffDeclWrites[ffOrigDecl(d)] ?? []).length > 0
}

// The function declaring the binding declaration `d` stands for, -1 at module scope, and -2
// when the walk saw no such declaration.
export function fnFlowDeclFn(d: i32): i32 { ffDeclFnOf[ffOrigDecl(d)] ?? -2 }

// The distinct closed parameter lists (`p1,p2,`) calls and annotated destinations pin the slot
// `path` (`e`, `v`, `f.<name>`; empty is the value) of `d` at, in walk instance `inst` of generic
// `tmpl` (-1, -1 outside one), leaving out pins taken in a function in `dead`. `[FF_PIN_DECLINE]`
// with no table, no walk of `d`, or walks that disagree with none picked out by the instance.
export function fnFlowDeclPathPinSigs(
  d: i32,
  path: string[],
  inst: i32,
  tmpl: i32,
  dead: {[i32]: boolean},
): string[] {
  ffPinSkip = dead
  const out = ffDeclPathPinKeys(d, path, inst, tmpl, false)
  ffPinSkip = Map()
  out
}

// `fnFlowDeclPathPinSigs` leaving out as well the pins taken at a call in `calls`.
export function fnFlowDeclPathPinSigsOmitting(
  d: i32,
  path: string[],
  inst: i32,
  tmpl: i32,
  dead: {[i32]: boolean},
  calls: i32[],
): string[] {
  for c in calls { ffPinCallSkip[c] = true }
  const out = fnFlowDeclPathPinSigs(d, path, inst, tmpl, dead)
  ffPinCallSkip = Map()
  out
}

// The functions that take the pins downstream of the slot `path` of `d`, over every walk of `d`, -1
// for module code; empty without a table.
export function fnFlowDeclPathPinFns(d: i32, path: string[]): i32[] {
  const out: i32[] = []
  if !ffBuilt || d < 0 { return out }
  for s in ffDeclSlots[ffOrigDecl(d)] ?? [] {
    let r = s
    for k in path {
      if r >= 0 { r = ffKidOf(ffFind(r), k) }
    }
    if r >= 0 {
      for id in ffDirectedPins(r) {
        if !i32ListHas(out, pinFn[id]) { out.push(pinFn[id]) }
      }
    }
  }
  out
}

// The calls that take the pins downstream of the slot `path` of `d`, over every walk of `d`; an
// annotation's pin names none. Empty without a table.
export function fnFlowDeclPathPinCalls(d: i32, path: string[]): i32[] {
  const out: i32[] = []
  if !ffBuilt || d < 0 { return out }
  for s in ffDeclSlots[ffOrigDecl(d)] ?? [] {
    let r = s
    for k in path {
      if r >= 0 { r = ffKidOf(ffFind(r), k) }
    }
    if r >= 0 {
      for id in ffDirectedPins(r) {
        if pinAt[id] >= 0 && !i32ListHas(out, pinAt[id]) { out.push(pinAt[id]) }
      }
    }
  }
  out
}

// The parameter types of a closed pin downstream of the slot `path` of `d` whose parameter list
// `fnFlowDeclPathPinSigs` spells `sig`; empty without a table or with no such pin.
export function fnFlowDeclPathPinTysOf(
  d: i32,
  path: string[],
  sig: string,
): i32[] {
  const none: i32[] = []
  if !ffBuilt || d < 0 { return none }
  for s in ffDeclSlots[ffOrigDecl(d)] ?? [] {
    let r = s
    for k in path {
      if r >= 0 { r = ffKidOf(ffFind(r), k) }
    }
    if r >= 0 {
      for id in ffDirectedPins(r) {
        if !ffPinOpen(id) && ffPinSig(id) == sig { return pinTys[id] }
      }
    }
  }
  none
}

// The parameter types every closed pin call `cx` takes downstream of the slot `path` of `d`
// agrees on; empty without a table, with no closed pin at that call, or with two that differ.
export function fnFlowDeclPathPinTysAt(d: i32, path: string[], cx: i32): i32[] {
  const none: i32[] = []
  if !ffBuilt || d < 0 { return none }
  let hit = -1
  for s in ffDeclSlots[ffOrigDecl(d)] ?? [] {
    let r = s
    for k in path {
      if r >= 0 { r = ffKidOf(ffFind(r), k) }
    }
    if r >= 0 {
      for id in ffDirectedPins(r) {
        if pinAt[id] == cx && !ffPinOpen(id) {
          if hit >= 0 && ffPinSig(hit) != ffPinSig(id) { return none }
          hit = id
        }
      }
    }
  }
  if hit < 0 { return none }
  pinTys[hit]
}

// The one call that pins the slot `path` of `d`, open or closed, with its parameter types pushed
// onto `tys`; -1 without a table, with no pin, with an annotation's pin, or with two calls.
export function fnFlowDeclPathOnlyPinCall(
  d: i32,
  path: string[],
  tys: i32[],
): i32 {
  if !ffBuilt || d < 0 { return -1 }
  let hit = -1
  for s in ffDeclSlots[ffOrigDecl(d)] ?? [] {
    let r = s
    for k in path {
      if r >= 0 { r = ffKidOf(ffFind(r), k) }
    }
    if r >= 0 {
      for id in ffDirectedPins(r) {
        if !(ffPinSkip[pinFn[id]] ?? false) {
          if pinAt[id] < 0 { return -1 }
          if (
            hit >= 0
            && (pinAt[hit] != pinAt[id] || ffPinSig(hit) != ffPinSig(id))
          ) {
            return -1
          }
          hit = id
        }
      }
    }
  }
  if hit < 0 { return -1 }
  for t in pinTys[hit] { tys.push(t) }
  pinAt[hit]
}

// Whether every pin of the slot `path` of `d` is a call at one closed parameter list, pushed onto
// `tys`; false without a table, with no pin, with an open or an annotation's pin, or with two
// lists.
export function fnFlowDeclPathAgreedPinTys(
  d: i32,
  path: string[],
  tys: i32[],
): boolean {
  ffAgreedPinTys(d, path, -1, tys)
}

// `fnFlowDeclPathAgreedPinTys` leaving out the pins taken in the functions `skip`, such as the
// other elements of a list a call reaches one element through (D13202).
export function fnFlowDeclPathAgreedPinTysSkipping(
  d: i32,
  path: string[],
  skip: i32[],
  tys: i32[],
): boolean {
  ffPinSkipFns(skip)
  const ok = ffAgreedPinTys(d, path, -1, tys)
  ffPinSkip = Map()
  ok
}

// Each call pin's parameter list of the slot `path` of `d`, open ones included, for a caller that
// closes them itself, leaving out the calls made in the functions `skip` (such as the other
// elements of a list a call reaches one element through, D13202); empty without a table, with no
// pin, or when an annotation pins the slot.
export function fnFlowDeclPathCallPinTyLists(
  d: i32,
  path: string[],
  skip: i32[],
): i32[][] {
  const out: i32[][] = []
  if !ffBuilt || d < 0 { return out }
  ffPinSkipFns(skip)
  for s in ffDeclSlots[ffOrigDecl(d)] ?? [] {
    let r = s
    for k in path {
      if r >= 0 { r = ffKidOf(ffFind(r), k) }
    }
    if r >= 0 {
      for id in ffDirectedPins(r) {
        if pinAt[id] < 0 {
          ffPinSkip = Map()
          return []
        }
        if !(ffPinSkip[pinFn[id]] ?? false) { out.push(pinTys[id]) }
      }
    }
  }
  ffPinSkip = Map()
  out
}

// `fnFlowDeclPathAgreedPinTys` over the walk pre-mono call `call` makes of `d`'s function alone,
// so another call's instance adds no pin; over every walk when the table has no one for it.
export function fnFlowCallPathAgreedPinTys(
  d: i32,
  path: string[],
  call: i32,
  tys: i32[],
): boolean {
  const cx = ffCallCtx[call] ?? -1
  if cx < 2 { return ffAgreedPinTys(d, path, -1, tys) }
  ffAgreedPinTys(d, path, cx, tys)
}

// Sets `ffPinSkip` to the functions `fns`, each as the walks know it.
function ffPinSkipFns(fns: i32[]) {
  ffPinSkip = Map()
  for f in fns { ffPinSkip[ffOrigDecl(f)] = true }
}

// The result of the annotation pinning the slot `path` of `d` in the walk `call` makes, with its
// parameter types pushed onto `tys`, when every pin there, call or annotation, agrees on one closed
// parameter list and every annotation on one result; -1 when no annotation pins it.
export function fnFlowCallPathAnnPinTys(
  d: i32,
  path: string[],
  call: i32,
  tys: i32[],
): i32 {
  let cx = ffCallCtx[call] ?? -1
  if cx < 2 { cx = -1 }
  const hit = ffAgreedPinHit(d, path, cx, true)
  if hit < 0 || pinAt[hit] >= 0 || pinRet[hit] < 0 || tyHasTyVar(pinRet[hit]) {
    return -1
  }
  for t in pinTys[hit] { tys.push(t) }
  pinRet[hit]
}

// `fnFlowDeclPathAgreedPinTys` over the walks of context `cx`, every walk when it is -1.
function ffAgreedPinTys(d: i32, path: string[], cx: i32, tys: i32[]): boolean {
  const hit = ffAgreedPinHit(d, path, cx, false)
  if hit < 0 { return false }
  for t in pinTys[hit] { tys.push(t) }
  true
}

// The one agreed closed pin `ffAgreedPinTys` reads, an annotation's when `ann` admits them and one
// pins the slot; -1 when the pins do not agree, or `ann` is false and an annotation pins it.
function ffAgreedPinHit(d: i32, path: string[], cx: i32, ann: boolean): i32 {
  if !ffBuilt || d < 0 { return -1 }
  let hit = -1
  const o = ffOrigDecl(d)
  const slots = ffDeclSlots[o] ?? []
  const ctxs = ffDeclSlotCtx[o] ?? []
  let si = 0
  while si < slots.length {
    let r = slots[si]
    if cx >= 0 && (si >= ctxs.length || ctxs[si] != cx) { r = -1 }
    si = si + 1
    for k in path {
      if r >= 0 { r = ffKidOf(ffFind(r), k) }
    }
    if r >= 0 {
      for id in ffDirectedPins(r) {
        if !(ffPinSkip[pinFn[id]] ?? false) {
          if (pinAt[id] < 0 && !ann) || ffPinOpen(id) { return -1 }
          if hit >= 0 && ffPinSig(hit) != ffPinSig(id) { return -1 }
          if hit >= 0 && pinAt[hit] < 0 && pinAt[id] < 0 {
            if ffPinSpell(pinRet[hit]) != ffPinSpell(pinRet[id]) { return -1 }
          }
          if hit < 0 || pinAt[hit] >= 0 { hit = id }
        }
      }
    }
  }
  hit
}

// Whether no call, open or closed, and no annotation reaches the value of the slot `path` of `d`
// in any walk of it, and the slot's class escapes nowhere the table cannot follow; false without
// a table or a walk of `d`, or when a walk derived no such slot.
export function fnFlowDeclPathUncalled(d: i32, path: string[]): boolean {
  if !ffBuilt || d < 0 { return false }
  const slots = ffDeclSlots[ffOrigDecl(d)] ?? []
  if slots.length == 0 { return false }
  for s in slots {
    let r = s
    for k in path {
      if r >= 0 { r = ffKidOf(ffFind(r), k) }
    }
    if r < 0 { return false }
    const root = ffFind(r)
    if root < 0 || ufTop[root] != "" || ffDirectedPins(r).length > 0 {
      return false
    }
  }
  true
}

// `fnFlowDeclPathPinSigs` answering the distinct returns annotated destinations pin the slot at
// instead; a call's pin names no return and is left out.
export function fnFlowDeclPathPinRets(
  d: i32,
  path: string[],
  inst: i32,
  tmpl: i32,
): string[] {
  ffDeclPathPinKeys(d, path, inst, tmpl, true)
}

// The pins' parameter lists, or their returns when `rets`, as `fnFlowDeclPathPinSigs` picks them.
function ffDeclPathPinKeys(
  d: i32,
  path: string[],
  inst: i32,
  tmpl: i32,
  rets: boolean,
): string[] {
  const decline: string[] = [FF_PIN_DECLINE]
  if !ffBuilt || d < 0 { return decline }
  const o = ffOrigDecl(d)
  const slots = ffDeclSlots[o] ?? []
  const ctxs = ffDeclSlotCtx[o] ?? []
  if slots.length == 0 { return decline }
  const first = ffPathPinKeys(slots[0], path, rets)
  let agree = true
  let i = 1
  while i < slots.length {
    if !ffSameSigs(first, ffPathPinKeys(slots[i], path, rets)) { agree = false }
    i = i + 1
  }
  if agree { return first }
  if tmpl < 0 || inst < 0 { return decline }
  const ps = ffInstParamSpells(inst, tmpl)
  let pick = decline
  i = 0
  while i < slots.length && i < ctxs.length {
    const c = ctxs[i]
    if (c >= 2 && ffWalked(tmpl, c) && ffCtxFits(tmpl, c, ps)) {
      const sigs = ffPathPinKeys(slots[i], path, rets)
      if pick.length == 1 && pick[0] == FF_PIN_DECLINE { pick = sigs }
      else if !ffSameSigs(pick, sigs) { return decline }
    }
    i = i + 1
  }
  pick
}

export const FF_PIN_DECLINE = "?"

// The closed pins (`ffPinSigsOf`, or `ffPinRetsOf` when `rets`) taken downstream of the slot
// `path` derives from slot `s`; empty when no walk derived a step of the path.
function ffPathPinKeys(s: i32, path: string[], rets: boolean): string[] {
  let r = s
  for k in path {
    r = ffKidOf(ffFind(r), k)
    if r < 0 { return [] }
  }
  if ffPinSkip.length > 0 || ffPinCallSkip.length > 0 {
    if rets { return ffPinRetsOf(ffDirectedPins(r)) }
    return ffPinSigsOf(ffDirectedPins(r))
  }
  if (
    ffKeyStamp[0] != ufPar.length
    || ffKeyStamp[1] != dfEdgeN
    || ffKeyStamp[2] != pinTys.length
  ) {
    ffKeyMemo = []
    ffKeyHas = []
    ffKeyStamp = [ufPar.length, dfEdgeN, pinTys.length]
  }
  let at = 2 * r
  if rets { at = at + 1 }
  if at < ffKeyHas.length && ffKeyHas[at] { return ffStrCopy(ffKeyMemo[at]) }
  const keys = if rets { ffPinRetsOf(ffDirectedPins(r)) } else { ffPinSigsOf(ffDirectedPins(r)) }
  while ffKeyHas.length <= at {
    const none: string[] = []
    ffKeyMemo.push(none)
    ffKeyHas.push(false)
  }
  ffKeyMemo[at] = keys
  ffKeyHas[at] = true
  ffStrCopy(keys)
}

// A fresh copy of `xs`, so a caller that extends an answer leaves the memo alone.
function ffStrCopy(xs: string[]): string[] {
  const out: string[] = []
  for x in xs { out.push(x) }
  out
}

// Every source of the slot `path` of `d`, in every context `d` is walked in; empty
// for an empty path or when a slot is missing, written or has no source. A generic's template
// walk holds only what a call past the context cap delivers, so an empty slot there is skipped.
export function fnFlowDeclPathSrcs(d: i32, path: string[]): i32[] {
  const out: i32[] = []
  if !ffBuilt || d < 0 || path.length == 0 { return out }
  const o = ffOrigDecl(d)
  const slots = ffDeclSlots[o] ?? []
  const ctxs = ffDeclSlotCtx[o] ?? []
  let i = 0
  while i < slots.length {
    let r = ffFind(slots[i])
    for k in path { r = ffFind(ffKidOf(r, k)) }
    const tmpl = i < ctxs.length && ctxs[i] == 1
    if tmpl && (r < 0 || (!ufWritten[r] && ufSrc[r].length == 0)) {
      i = i + 1
      continue
    }
    if r < 0 || ufWritten[r] || ufSrc[r].length == 0 { return [] }
    ffI32Merge(out, ufSrc[r])
    i = i + 1
  }
  out
}

// Every function the slot `path` of `d` (`d`'s own for an empty path) can hold, written or not, in
// every context `d` is walked in; empty when a slot is missing, has no source, or escapes where
// the table cannot follow.
export function fnFlowDeclPathHeldSrcs(d: i32, path: string[]): i32[] {
  const out: i32[] = []
  if !ffBuilt || d < 0 { return out }
  for s in ffDeclSlots[ffOrigDecl(d)] ?? [] {
    let r = ffFind(s)
    for k in path { r = ffFind(ffKidOf(r, k)) }
    if r < 0 || ufTop[r] != "" || ufSrc[r].length == 0 { return [] }
    ffI32Merge(out, ufSrc[r])
  }
  out
}

// Whether the lists `a` and `b` hold the same strings.
function ffSameSigs(a: string[], b: string[]): boolean {
  if a.length != b.length { return false }
  for x in a {
    if !strListHas(b, x) { return false }
  }
  true
}

// The pins taken at every slot `s`'s value reaches along the directed edges, `s` included.
function ffDirectedPins(s: i32): i32[] {
  const out: i32[] = []
  // Every edge joins one class, and every pin is its class's too: a pinless class reaches none.
  const root = ffFind(s)
  if root >= 0 && ufPin[root].length == 0 { return out }
  const seen: {[i32]: boolean} = Map()
  const work: i32[] = [s]
  seen[s] = true
  let i = 0
  while i < work.length {
    const x = work[i]
    for id in dfPin[x] { out.push(id) }
    for y in dfTo[x] {
      if !(seen[y] ?? false) {
        seen[y] = true
        work.push(y)
      }
    }
    i = i + 1
  }
  out
}

// Type `t` spelled as a pin: its render with each union bar written `A|B`, the spelling a
// function type's name and an instance's parameter give the same type (D5170). A function type
// is spelled `=>` and its signature key, as an instance's function-valued parameter is.
function ffPinSpell(t: i32): string {
  if t >= 0 && t < T.tys.length && tyAt(t) is TyFunc {
    const sk = sigKeyOfTy(t)
    if sk != "" { return "=>" + sk }
  }
  const s = normTypeAtom(tyToStr(t))
  if s.indexOf(" | ") < 0 { return s }
  let out = ""
  let inStr = false
  let st = 0
  let i = 0
  while i < s.length {
    if s[i] == "\""[0] && (i == 0 || s[i - 1] != "\\"[0]) { inStr = !inStr }
    if !inStr && i + 3 <= s.length && s.slice(i, i + 3) == " | " {
      out = out + s.slice(st, i) + "|"
      i = i + 3
      st = i
    } else {
      i = i + 1
    }
  }
  out + s.slice(st, s.length)
}

// The distinct closed pins among `ids`, each as `p1,p2,`, in the order first taken.
function ffPinSigsOf(ids: i32[]): string[] {
  const out: string[] = []
  for id in ids {
    if (
      !ffPinOpen(id)
      && !(ffPinSkip[pinFn[id]] ?? false)
      && !(ffPinCallSkip[pinAt[id]] ?? false)
    ) {
      const sig = ffPinSig(id)
      if !strListHas(out, sig) { out.push(sig) }
    }
  }
  out
}

// Pin `id`'s parameter list spelled `p1,p2,`.
function ffPinSig(id: i32): string { fnFlowPinSigOf(pinTys[id]) }

// Parameter types `tys` spelled as a pin's parameter list, `p1,p2,`.
export function fnFlowPinSigOf(tys: i32[]): string {
  let sig = ""
  for t in tys { sig = sig + ffPinSpell(t) + "," }
  sig
}

// The distinct returns of the closed pins among `ids` an annotation took, in the order first taken.
function ffPinRetsOf(ids: i32[]): string[] {
  const out: string[] = []
  for id in ids {
    if !ffPinOpen(id) && pinRet[id] >= 0 {
      const r = ffPinSpell(pinRet[id])
      if !strListHas(out, r) { out.push(r) }
    }
  }
  out
}

// The longest alias chain the lambda answers below follow; `FF_CHAIN_LONG` reports one longer.
const FF_CHAIN_MAX = 64
export const FF_CHAIN_LONG = -3

// The un-annotated `const` binding of a hole lambda the binding read `at` holds through a chain
// of un-annotated `const` and `let` bindings, each `let` written only with lambdas and at least one
// on the chain (`viaLet` counts one already behind), as its declaration; -1 for none, and
// `FF_CHAIN_LONG` past `FF_CHAIN_MAX` links.
export function fnFlowAliasLam(at: i32, viaLet: boolean): i32 {
  if !ffBuilt { return -1 }
  ffAliasLamFrom(ffReadLet(at), viaLet)
}

// The hole lambda's binding the capture cell read at `at` (`d[0]`, or `d` itself) holds: the
// rewrite's `let d = [v]`, written only with lambdas, whose `v` is such a chain.
export function fnFlowCellLam(at: i32): i32 {
  if !ffBuilt || at < 0 || at >= P.nodes.length { return -1 }
  let r = at
  const rn = nodeAt(at)
  if rn is Index { r = rn.idxArr }
  const d = ffLetOf(identDeclOf(r))
  if d < 0 { return -1 }
  const n = nodeAt(d)
  if !(n is LetDecl) || n.letKw != "let" || n.letInit < 0 { return -1 }
  const lit = nodeAt(n.letInit)
  if !(lit is ArrayLit) { return -1 }
  if lit.pos >= 0 || lit.arrElems.length != 1 { return -1 }
  if !ffWritesAreLams(ffCellWrites[ffOrigDecl(d)] ?? []) { return -1 }
  ffAliasLamFrom(ffReadLet(lit.arrElems[0]), true)
}

// The un-annotated `const` binding the call through read `at` is re-spelled to: the end of a chain
// of at most eight un-annotated `const` aliases (`const c2 = c`), each link's name read in the
// frame declaring the link, when it binds a lambda. -1 for any other read.
export function fnFlowRespellLam(at: i32): i32 {
  if !ffBuilt { return -1 }
  let d = ffReadLet(at)
  let hops = 0
  while hops < 8 && d >= 0 {
    const n = nodeAt(d)
    if !(n is LetDecl) { return -1 }
    if n.letKw != "const" || n.letType >= 0 || n.letInit < 0 { return -1 }
    if !(nodeAt(n.letInit) is Ident) { return -1 }
    const s = ffLetOf(identDeclOf(n.letInit))
    if s < 0 { return -1 }
    const sf = ffDeclFnOf[ffOrigDecl(s)] ?? -2
    // A link read from the frame declaring it, or a module-scope binding.
    if sf == -1 || sf == (ffDeclFnOf[ffOrigDecl(d)] ?? -2) {
      const c = ffClosureOf(s)
      if c == -2 { return -1 }
      if c >= 0 {
        const sn = nodeAt(s)
        if sn is LetDecl {
          if sn.letKw != "const" || sn.letType >= 0 { return -1 }
        }
        return s
      }
    }
    d = s
    hops = hops + 1
  }
  -1
}

// The declaration node the walk saw for the binding read at `ix` (a name, or a cell read
// `d[0]`), or -1.
function ffReadLet(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = nodeAt(ix)
  let d = -1
  if n is Ident {
    d = identDeclOf(ix)
  } else if n is Index {
    if ffIsCellRead(ix) { d = identDeclOf(n.idxArr) }
  }
  ffLetOf(d)
}

// The `LetDecl` node the walk saw for declaration `d`, else `d` when it is one; -1 otherwise.
function ffLetOf(d: i32): i32 {
  if d < 0 || d >= P.nodes.length { return -1 }
  const t = ffDeclNode[ffOrigDecl(d)] ?? -1
  if t >= 0 { return t }
  if nodeAt(d) is LetDecl { return d }
  -1
}

// The binding of a lambda that declaration node `d`'s initializer names: its own lambda, or a
// module-scope un-annotated `const` of one it reads. -2 when it names a named function, else -1.
function ffClosureOf(d: i32): i32 {
  const n = nodeAt(d)
  if !(n is LetDecl) || n.letInit < 0 { return -1 }
  const iv = nodeAt(n.letInit)
  if iv is FuncDecl {
    if ffIsLambdaName(iv.fnName) { return d }
    return -2
  }
  if !(iv is Ident) { return -1 }
  const nd = identDeclOf(n.letInit)
  if nd < 0 || nd >= P.nodes.length { return -1 }
  if nodeAt(nd) is FuncDecl { return -2 }
  const t = ffLetOf(nd)
  if t < 0 || (ffDeclFnOf[ffOrigDecl(t)] ?? -2) != -1 { return -1 }
  const tn = nodeAt(t)
  if tn is LetDecl {
    if tn.letKw == "const" && tn.letType < 0 && tn.letInit >= 0 {
      const tl = nodeAt(tn.letInit)
      if tl is FuncDecl {
        if ffIsLambdaName(tl.fnName) { return t }
        return -2
      }
    }
  }
  -1
}

// `fnFlowAliasLam` from declaration node `d0`.
function ffAliasLamFrom(d0: i32, viaLet: boolean): i32 {
  let d = d0
  let sawLet = viaLet
  let hops = 0
  while hops < FF_CHAIN_MAX {
    if d < 0 { return -1 }
    const n = nodeAt(d)
    if !(n is LetDecl) || n.letType >= 0 || n.letInit < 0 { return -1 }
    const o = ffOrigDecl(d)
    const top = (ffDeclFnOf[o] ?? -2) == -1
    // A module-scope `let` is a link, walked on with its writes checked (D3847, D3856).
    if (hops > 0 || viaLet) && !(n.letKw == "let" && top) {
      const c = ffClosureOf(d)
      if c != -1 {
        if c < 0 || n.letKw != "const" || !sawLet { return -1 }
        return c
      }
    }
    let init = n.letInit
    let cell = false
    const lit = nodeAt(n.letInit)
    if lit is ArrayLit {
      if lit.pos < 0 && lit.arrElems.length == 1 {
        init = lit.arrElems[0]
        cell = true
      }
    }
    if n.letKw == "let" {
      sawLet = true
      let ws = ffDeclWrites[o] ?? []
      if cell { ws = ffCellWrites[o] ?? [] }
      if !ffWritesAreLams(ws) { return -1 }
    }
    d = ffReadLet(init)
    hops = hops + 1
  }
  FF_CHAIN_LONG
}

// Whether every write in `ws` stores a lambda, or a value whose function type is concrete (a
// typed parameter, D3848): a call's arguments fit it, so the lambdas pin at them.
function ffWritesAreLams(ws: i32[]): boolean {
  for w in ws {
    const b = nodeAt(w)
    if b is BinExpr {
      if !ffIsLamValue(b.binRight) && !ffFnTyConcrete(b.binRight) {
        return false
      }
    }
  }
  true
}

// Whether value `v` is a lambda, or a name bound through un-annotated bindings to one.
function ffIsLamValue(v: i32): boolean {
  const vn = nodeAt(v)
  if vn is FuncDecl { return ffIsLambdaName(vn.fnName) }
  let d = ffReadLet(v)
  let hops = 0
  while d >= 0 && hops < FF_CHAIN_MAX {
    const c = ffClosureOf(d)
    if c != -1 { return c >= 0 }
    const n = nodeAt(d)
    if !(n is LetDecl) || n.letType >= 0 || n.letInit < 0 { return false }
    let init = n.letInit
    const lit = nodeAt(n.letInit)
    if lit is ArrayLit {
      if lit.pos < 0 && lit.arrElems.length == 1 { init = lit.arrElems[0] }
    }
    d = ffReadLet(init)
    hops = hops + 1
  }
  false
}

// Whether node `v`'s recorded type is a function type naming no type variable.
function ffFnTyConcrete(v: i32): boolean {
  const t = nodeTyIxOf(v)
  if t < 0 || t >= T.tys.length || tyHasTyVar(t) { return false }
  tyAt(t) is TyFunc
}

// The pre-mono declaration minted declaration `d` stands for, else `d`.
function ffOrigDecl(d: i32): i32 {
  if d < 0 { return -1 }
  const o = declOrigOf(d)
  if o >= 0 { return o }
  d
}

function ffBuild(stmts: i32[]) {
  const noN: string[] = []
  const noT: i32[] = []
  ffCtxOf("", noN, noT)
  const noN1: string[] = []
  const noT1: i32[] = []
  ffCtxOf("template", noN1, noT1)
  ffCtx = 0
  ffFn = -1
  for st in stmts {
    const sn = nodeAt(st)
    if !(sn is FuncDecl) { ffStmt(st) }
  }
  for fe in fnStmts {
    if fe >= 0 && fe < P.nodes.length && !monoIsGenericDecl(fe) {
      ffEnsureWalked(fe, 0)
    }
  }
  for fe in fnStmts {
    if fe >= 0 && fe < P.nodes.length && monoIsGenericDecl(fe) {
      ffEnsureWalked(fe, 1)
    }
  }
  ffLetLamFinish()
  ffBuilt = true
  0
}

// Keep the final tree's roots for the sweep `fnFlowShadowFinish` runs once the compile is over.
export function fnFlowShadowSweep(stmts: i32[]) {
  if ffMode == 0 || !ffBuilt { return 0 }
  ffStmts = stmts
  ffSwept = true
  0
}

// ── the sweep ────────────────────────────────────────────────────────────────────────────────
let swByName: {[string]: i32} = Map()
let swTmpl: {[i32]: i32} = Map()
let swSeen: i32[] = []
let swStamp = 0
let swNextStamp = 0
let swCtxs: i32[] = []
let swChain: i32[] = []
let swFeOf: {[i32]: i32} = Map()
let swVisited: {[string]: boolean} = Map()
let swResOf: {[string]: string} = Map()
let swParamOrig: {[i32]: i32} = Map()

function ffRow(verdict: string, pos: string, name: string) {
  let key = "flow | " + verdict + " | " + pos
  if ffMode >= 2 { key = key + " | " + name }
  callBindShadowCount(key)
}

// Pin `id`'s spellings, rendered once.
function ffPinNames(id: i32): string[] {
  while pinName.length <= id {
    const tys = pinTys[pinName.length]
    const out: string[] = []
    for t in tys { out.push(ffTyKey(t)) }
    pinName.push(out)
  }
  pinName[id]
}

function ffJoin(xs: string[]): string {
  let out = ""
  let i = 0
  while i < xs.length {
    if i > 0 { out = out + ", " }
    out = out + xs[i]
    i = i + 1
  }
  "(" + out + ")"
}

// Whether pin `id` leaves a parameter type unknown or open.
function ffPinOpen(id: i32): boolean {
  for t in pinTys[id] {
    if t < 0 || tyHasTyVar(t) { return true }
  }
  false
}

// The distinct pins of slot `s`'s class, each rendered as one string, open ones left out.
function ffClassPins(s: i32): string[] {
  const out: string[] = []
  const r = ffFind(s)
  if r < 0 { return out }
  for id in ufPin[r] {
    if !ffPinOpen(id) {
      const j = ffJoin(ffPinNames(id))
      if !strListHas(out, j) { out.push(j) }
    }
  }
  out
}

function ffSpellSame(a: string, b: string): boolean {
  if a == b { return true }
  const ca = repNameCanonId(a)
  ca >= 0 && ca == repNameCanonId(b)
}

// Whether pin `pin` (a rendered list) is the parameter spelling list `ps`.
function ffPinFits(pin: string, ps: string[]): boolean {
  if pin == ffJoin(ps) { return true }
  const inner = pin.slice(1, pin.length - 1)
  const parts: string[] = []
  let st = 0
  let depth = 0
  let i = 0
  while i < inner.length {
    const ch = inner[i]
    if ch == '(' || ch == '[' || ch == '{' || ch == '<' { depth = depth + 1 }
    if ch == ')' || ch == ']' || ch == '}' || ch == '>' { depth = depth - 1 }
    if ch == ',' && depth == 0 {
      parts.push(inner.slice(st, i))
      st = i + 2
    }
    i = i + 1
  }
  if inner.length > 0 { parts.push(inner.slice(st, inner.length)) }
  if parts.length != ps.length { return false }
  let k = 0
  while k < ps.length {
    if !ffSpellSame(parts[k], ps[k]) { return false }
    k = k + 1
  }
  true
}

// Function `fn`'s parameter spellings in the final tree, "?" for one still un-annotated.
function ffParamSpells(fn: i32): string[] {
  const out: string[] = []
  const fd = nodeAt(fn)
  if fd is FuncDecl {
    for pi in fd.fnParams {
      const p = nodeAt(pi)
      if p is Param {
        let sp = "?"
        if p.parType >= 0 && p.parType < P.nodes.length {
          const tn = nodeAt(p.parType)
          if tn is TypeRef {
            sp = tn.tyName
          } else {
            const t = nodeTyIxOf(p.parType)
            if t >= 0 { sp = tyToEmitName(t) }
          }
        }
        out.push(sp)
      }
    }
  }
  out
}

// The hole binding of the instance the next pin question is asked in, staged by the caller.
let ffInstHoleN: string[] = []
let ffInstHoleT: i32[] = []

// Stages the hole binding `n`/`t` of the instance the next pin questions are asked in.
export function fnFlowStageInstHoles(n: string[], t: i32[]) {
  ffInstHoleN = n
  ffInstHoleT = t
  0
}

// `ffParamSpells` of instance `inst` of template `tmpl`, an un-annotated parameter spelled at
// the template's type under the staged hole binding when that closes it.
function ffInstParamSpells(inst: i32, tmpl: i32): string[] {
  const out = ffParamSpells(inst)
  const ft = nodeTyIxOf(tmpl)
  if ffInstHoleN.length == 0 || ft < 0 || ft >= T.tys.length { return out }
  const fty = tyAt(ft)
  if !(fty is TyFunc) || fty.fnParamTypes.length != out.length { return out }
  let k = 0
  while k < out.length {
    let pt = fty.fnParamTypes[k]
    if out[k] == "?" && pt >= 0 && tyHasTyVar(pt) {
      pt = substTyDeep(pt, ffInstHoleN, ffInstHoleT)
      if pt >= 0 && !tyHasTyVar(pt) { out[k] = tyToEmitName(pt) }
    }
    k = k + 1
  }
  out
}

function ffHasHole(ps: string[]): boolean { strListHas(ps, "?") }

// Map each parameter of instance `inst` to the same-position parameter of template `tmpl`.
function ffMapParams(inst: i32, tmpl: i32) {
  if inst < 0 || inst >= P.nodes.length || tmpl < 0 || tmpl >= P.nodes.length {
    return 0
  }
  const a = nodeAt(inst)
  const b = nodeAt(tmpl)
  if a is FuncDecl {
    if b is FuncDecl {
      let i = 0
      while i < a.fnParams.length && i < b.fnParams.length {
        if a.fnParams[i] != b.fnParams[i] {
          swParamOrig[a.fnParams[i]] = b.fnParams[i]
        }
        i = i + 1
      }
    }
  }
  0
}

// The template a final-tree function stands for: an instance's, a minted declaration's, or
// itself.
function ffTemplateOf(fn: i32): i32 {
  const t = swTmpl[fn] ?? -1
  if t >= 0 { return t }
  const o = declOrigOf(fn)
  if o >= 0 { return o }
  fn
}

// The function a final-tree read `ix` names: its recorded declaration when that declares the
// name it now spells, else the lifted function of that name.
function ffTargetOf(ix: i32): i32 {
  const n = nodeAt(ix)
  if n is Ident {
    const fe = swByName[n.identName] ?? -1
    if fe >= 0 && fe < fnStmts.length { return fnStmts[fe] }
    const d = identDeclOf(ix)
    if d >= 0 && d < P.nodes.length {
      const dn = nodeAt(d)
      if dn is FuncDecl {
        if dn.fnName == n.identName { return d }
      }
    }
  }
  -1
}

// Whether final function `fn` is a registry entry mono left as a stub.
function ffIsStub(fn: i32): boolean {
  const fe = swFeOf[fn] ?? -1
  fe >= 0 && !monoStubValueOk(fe, -2)
}

// Grade a decided function value `target` against the records of pre-mono node `o`.
function ffGrade(o: i32, target: i32, name: string) {
  let r = ffRecHead(o)
  if r < 0 { return 0 }
  const only = ffRecIn(r)
  const kind = rdKind[r]
  const pos = rdPos[r]
  if target < 0 {
    return ffRow("undecided: resolves to no function", pos, name)
  }
  if kind != 1 {
    if ffTemplateOf(target) != rdFn[r] && target != rdFn[r] {
      if ffIsStub(target) { return ffRow("undecided: a stub", pos, name) }
      return ffRow("disagree: another function", pos, name)
    }
  }
  if ffIsStub(target) { return ffRow("undecided: a stub", pos, name) }
  const ps = ffParamSpells(target)
  if ffHasHole(ps) {
    if kind == 1 {
      return ffRow("undecided: lambda left un-annotated", pos, name)
    }
    return ffRow("undecided: template left un-instanced", pos, name)
  }
  if kind == 2 { return ffGradeDirect(o, ps, name) }
  // A generic named function still carrying its type parameters is not an instance either.
  const td = nodeAt(target)
  if td is FuncDecl {
    if td.fnTyParams.length > 0 {
      return ffRow("undecided: template left un-instanced", pos, name)
    }
  }
  const rs = ffResSpell(target)
  const wr = ffWrittenRet(target)
  const cr = ffConcreteRet(target)
  if wr != "" && cr != "" && wr != cr {
    return ffRow("disagree: written result is not the checked one", pos, name)
  }
  const root = ffFind(rdSlot[r])
  if root >= 0 && rs != "" {
    const rk = i32ToStr(root) + "@" + i32ToStr(rdWalk[r])
    const seen = swResOf[rk] ?? ""
    if seen == "" {
      swResOf[rk] = rs
    } else if seen != rs {
      return ffRow("disagree: one class, two results", pos, name)
    }
  }
  let anyPin = false
  let fitsOne = false
  let fitsMany = false
  while r >= 0 {
    if !only || ffRecIn(r) {
      const pins = ffClassPins(rdSlot[r])
      if pins.length > 0 { anyPin = true }
      for pin in pins {
        if ffPinFits(pin, ps) {
          if pins.length == 1 { fitsOne = true } else { fitsMany = true }
        }
      }
    }
    r = rdNext[r]
  }
  if !anyPin { return ffRow("unpinned: mono decided alone", pos, name) }
  if fitsOne { return ffRow("agree", pos, name) }
  if fitsMany {
    return ffRow(
      "disagree: one instance for a class of several pins",
      pos,
      name,
    )
  }
  ffRow("disagree: instance fits no pin", pos, name)
}

// A direct generic call: the instance's parameters against the callee's checked parameter
// types under the bindings the table keyed the instance by, in any context that walked it.
function ffGradeDirect(o: i32, ps: string[], name: string) {
  let r = ffRecHead(o)
  const only = r >= 0 && ffRecIn(r)
  let anyOpen = false
  while r >= 0 {
    const fn = rdFn[r]
    const ft = nodeTyIxOf(fn)
    const ctx = rdCtx[r]
    if (
      (!only || ffRecIn(r))
      && ft >= 0
      && ft < T.tys.length
      && ctx >= 0
      && ctx < ctxBN.length
    ) {
      const fty = tyAt(ft)
      if fty is TyFunc {
        const want: string[] = []
        let open = false
        for pt in fty.fnParamTypes {
          let t = pt
          if tyHasTyVar(t) { t = substTyDeep(t, ctxBN[ctx], ctxBT[ctx]) }
          if t < 0 || tyHasTyVar(t) { open = true }
          want.push(ffTyKey(t))
        }
        if open {
          anyOpen = true
        } else if ffPinFits(ffJoin(want), ps) {
          return ffRow("agree", "direct call", name)
        }
      }
    }
    r = rdNext[r]
  }
  if anyOpen {
    return ffRow("unpinned: binding left open", "direct call", name)
  }
  ffRow("disagree: instance fits no binding", "direct call", name)
}

function ffSweepNode(ix: i32) {
  if ix < 0 || ix >= P.nodes.length || ix >= swSeen.length { return 0 }
  if swSeen[ix] == swStamp { return 0 }
  swSeen[ix] = swStamp
  const n = nodeAt(ix)
  if n is FuncDecl { return ffSweepFn(ix) }
  ffSweepAt(ix)
}

// A function in the final tree, swept once per set of walk contexts it stands for: a node an
// instance shares with its template is graded under each instance's own bindings.
function ffSweepFn(ix: i32) {
  const ctxs = ffCtxsOf(ix)
  let key = i32ToStr(ix) + "@"
  for c in ctxs { key = key + i32ToStr(c) + "," }
  if swVisited[key] ?? false { return 0 }
  swVisited[key] = true
  const svCtxs = swCtxs
  const svStamp = swStamp
  swCtxs = ctxs
  swStamp = swNextStamp
  swNextStamp = swNextStamp + 1
  swSeen[ix] = swStamp
  swChain.push(ix)
  ffSweepAt(ix)
  swChain.pop()
  swCtxs = svCtxs
  swStamp = svStamp
  0
}

// Whether final function `fn`, or a template or copy it descends from, is among the sources
// of slot `s`'s class.
function ffClassHasSrc(s: i32, fn: i32): boolean {
  const r = ffFind(s)
  if r < 0 { return false }
  let x = fn
  let depth = 0
  while x >= 0 && depth < 8 {
    if ffFactHas(ufSrcAt, r, x) { return true }
    let nx = ffTemplateOf(x)
    if nx == x { nx = ffOrig(x) }
    if nx == x { return false }
    x = nx
    depth = depth + 1
  }
  false
}

// Whether the sweep is inside a generic template, which is never emitted and not graded.
function ffInTemplate(): boolean {
  for c in swChain {
    const cn = nodeAt(c)
    if cn is FuncDecl {
      if cn.fnTyParams.length > 0 && monoIsGenericDecl(c) { return true }
    }
  }
  false
}

// A read the walk resolved to local binding `ld` that mono pointed at function `d`: the
// function must be one the binding holds, and fit its class's pins in the swept instance.
function ffSweepLocalRead(ld: i32, d: i32, name: string) {
  if ld < 0 || ffInTemplate() { return 0 }
  const s = ffSlotOfDecl(ld)
  if !ffClassHasSrc(s, d) {
    return ffRow(
      "disagree: a local read names a function it never held",
      "reference",
      name,
    )
  }
  const pins = ffClassPins(s)
  if pins.length == 0 { return 0 }
  const ps = ffParamSpells(d)
  for pin in pins {
    if ffPinFits(pin, ps) { return 0 }
  }
  ffRow(
    "disagree: a local read names an instance it does not hold",
    "reference",
    name,
  )
}

// The final function enclosing function `f` in the registry, -1 for a top-level one.
function ffOwnerOf(f: i32): i32 {
  const fe = swFeOf[f] ?? -1
  if fe < 0 || fe >= fnParent.length { return -1 }
  const pfe = fnParent[fe]
  if pfe < 0 || pfe >= fnStmts.length { return -1 }
  fnStmts[pfe]
}

// A reference to nested function `d`, owned by one instance of a generic, from inside another
// instance of that generic: mono pointed the use at the wrong instance's clone.
function ffSweepOwner(d: i32, name: string) {
  const owner = ffOwnerOf(d)
  if owner < 0 || swChain.length == 0 || ffInTemplate() { return 0 }
  const ot = swTmpl[owner] ?? -1
  if ot < 0 { return 0 }
  let sibling = false
  for c in swChain {
    let p = c
    let depth = 0
    while p >= 0 && depth < 64 {
      if p == owner { return 0 }
      if p != owner && (swTmpl[p] ?? -1) == ot { sibling = true }
      p = ffOwnerOf(p)
      depth = depth + 1
    }
  }
  if !sibling { return 0 }
  ffRow("disagree: a nested instance used outside its owner", "reference", name)
}

// The walk contexts final function `fn` stands for: a template's own, an instance's matching
// contexts of its template, else the enclosing function's (empty: any context).
function ffCtxsOf(fn: i32): i32[] {
  const out: i32[] = []
  const fd = nodeAt(fn)
  if fd is FuncDecl {
    if fd.fnTyParams.length > 0 && monoIsGenericDecl(fn) {
      out.push(1)
      return out
    }
  }
  const t = swTmpl[fn] ?? -1
  if t < 0 { return swCtxs }
  const ps = ffParamSpells(fn)
  let c = 2
  while c < ctxBN.length {
    if (ffWalked(t, c) && ffCtxFits(t, c, ps)) { out.push(c) }
    c = c + 1
  }
  out
}

// Whether template `t`'s parameter types under context `c`'s bindings spell `ps`.
function ffCtxFits(t: i32, c: i32, ps: string[]): boolean {
  const ft = nodeTyIxOf(t)
  if ft < 0 || ft >= T.tys.length { return false }
  const fty = tyAt(ft)
  if fty is TyFunc {
    const want: string[] = []
    for pt in fty.fnParamTypes {
      let u = pt
      if tyHasTyVar(u) { u = substTyDeep(u, ctxBN[c], ctxBT[c]) }
      if u < 0 || tyHasTyVar(u) { return false }
      want.push(ffTyKey(u))
    }
    return ffPinFits(ffJoin(want), ps)
  }
  false
}

// Whether record `r` comes from a context the function being swept stands for.
function ffRecIn(r: i32): boolean {
  swCtxs.length == 0 || i32ListHas(swCtxs, rdWalk[r])
}

// The first record of `o` made in the swept function's contexts, else the first of any.
function ffRecHead(o: i32): i32 {
  let r = rdHead[o] ?? -1
  while r >= 0 {
    if ffRecIn(r) { return r }
    r = rdNext[r]
  }
  rdHead[o] ?? -1
}

function ffSweepAt(ix: i32) {
  const n = nodeAt(ix)
  const o = ffOrig(ix)
  if ffMode == 4 && (rdHead[o] ?? -1) >= 0 {
    callBindShadowCount(
      "trace | sweep node " + i32ToStr(ix) + " orig " + i32ToStr(o),
    )
  }
  if n is Ident {
    const r = rdHead[o] ?? -1
    if ffMode == 4 && r < 0 {
      callBindShadowCount(
        "trace | unrecorded ident "
          + n.identName
          + " node "
          + i32ToStr(ix)
          + " decl "
          + i32ToStr(identDeclOf(ix))
          + " stamp "
          + i32ToStr(swStamp),
      )
    }
    if r >= 0 && rdKind[r] == 0 { ffGrade(o, ffTargetOf(ix), n.identName) }
    const d = identDeclOf(ix)
    if d >= 0 && d < P.nodes.length {
      const dn = nodeAt(d)
      if dn is FuncDecl {
        ffSweepLocalRead(ffLocalRead[o] ?? -1, d, n.identName)
        ffSweepOwner(d, n.identName)
      }
    }
    return 0
  }
  if n is Call {
    const c = unwrapParen(n.callFn)
    if c >= 0 && c < P.nodes.length {
      let co = identOrigOf(c)
      if co < 0 { co = c }
      const r = rdHead[co] ?? -1
      if r >= 0 && rdKind[r] == 2 {
        const cn = nodeAt(c)
        if cn is Ident { ffGrade(co, ffTargetOf(c), cn.identName) }
        if c < swSeen.length { swSeen[c] = swStamp }
      }
    }
  }
  if n is FuncDecl {
    if ffMode == 4 {
      let rs = "-"
      if n.fnRet >= 0 && n.fnRet < P.nodes.length {
        const rn = nodeAt(n.fnRet)
        if rn is TypeRef { rs = rn.tyName } else { rs = "?" }
      }
      callBindShadowCount(
        "trace | fn "
          + n.fnName
          + " node "
          + i32ToStr(ix)
          + " orig "
          + i32ToStr(o)
          + " "
          + ffJoin(ffParamSpells(ix))
          + " -> "
          + rs
          + " res "
          + ffResSpell(ix),
      )
    }
    const r = rdHead[o] ?? -1
    if r >= 0 && rdKind[r] == 1 { ffGrade(o, ix, n.fnName) }
    ffSweepParams(n.fnParams, n.fnName)
    ffSweepShadow(ix)
    ffSweepRet(ix, n.fnName)
  }
  for k in nodeChildren(ix) { ffSweepNode(k) }
  0
}

// An instance of a generic whose return is left to inference while the table sees that return
// come out of a call, in its own body, through a value the checker gave no function type: mono
// left the result's type open.
function ffSweepRet(fn: i32, fnName: string) {
  const fd = nodeAt(fn)
  if fd is FuncDecl {
    if fd.fnRet >= 0 { return 0 }
  }
  const t = ffTemplateOf(fn)
  if t < 0 || t >= P.nodes.length || !monoIsGenericDecl(t) { return 0 }
  let c = 0
  while c < ctxBN.length {
    const s = ffPairGet(FF_PAIR_RET, t, c)
    const r = ffFind(s)
    if r >= 0 && ffFactHas(ufResAt, r, t) {
      return ffRow(
        "undecided: return through a function value",
        "return",
        fnName,
      )
    }
    c = c + 1
  }
  0
}

// An un-annotated parameter left in the final tree whose class carries a function.
function ffSweepParams(params: i32[], fnName: string) {
  for pi in params {
    const p = nodeAt(pi)
    if p is Param {
      const r = rdHead[ffOrig(pi)] ?? -1
      if (
        r >= 0
        && rdKind[r] == 3
        && p.parType < 0
        && ffCarriesFn(rdSlot[r], 0)
      ) {
        ffRow(
          "undecided: parameter left un-annotated",
          "parameter",
          fnName + "." + p.parName,
        )
      }
    }
  }
  0
}

// Whether `s`'s class, or a slot derived from it, holds a function source.
function ffCarriesFn(s: i32, depth: i32): boolean {
  const r = ffFind(s)
  if r < 0 || depth > 4 { return false }
  if ufSrc[r].length > 0 { return true }
  for k in ufKidS[r] {
    if ffCarriesFn(k, depth + 1) { return true }
  }
  false
}

// Two bindings of one name in one final function whose classes carry functions called at
// different signatures, or a direct call spelled like a local binding: the emitter keys a local
// by its name, so neither pair may meet in one function.
function ffSweepShadow(fn: i32) {
  const names: string[] = []
  const sigs: string[] = []
  const calls: string[] = []
  const srcs: string[] = []
  ffShadowCollect(fn, names, sigs, srcs, calls, true)
  let i = 0
  if ffMode == 4 {
    while i < names.length {
      callBindShadowCount("trace | shadow " + names[i] + " = " + sigs[i])
      i = i + 1
    }
    i = 0
  }
  while i < names.length {
    let j = i + 1
    while j < names.length {
      if (
        names[i] == names[j]
        && sigs[i] != sigs[j]
        && sigs[i] != ""
        && sigs[j] != ""
      ) {
        ffRow(
          "disagree: one name, two signatures",
          "shadowed binding",
          names[i],
        )
      } else if (
        names[i] == names[j]
        && srcs[i] != srcs[j]
        && srcs[i] != ""
        && srcs[j] != ""
      ) {
        ffRow(
          "undecided: one name over two function sets",
          "shadowed binding",
          names[i],
        )
      }
      j = j + 1
    }
    if strListHas(calls, names[i]) {
      ffRow(
        "disagree: a call spelled like a local binding",
        "shadowed binding",
        names[i],
      )
    }
    i = i + 1
  }
  0
}

// The pins of `s`'s class and of every slot derived from it that carries a function, as one
// string; "" when the class carries none.
function ffDeepSig(s: i32, depth: i32): string {
  const r = ffFind(s)
  if r < 0 || depth > 4 || !ffCarriesFn(r, 0) { return "" }
  let out = ffJoin(ffClassPins(r))
  const ks: string[] = []
  let i = 0
  while i < ufKidK[r].length {
    const sub = ffDeepSig(ufKidS[r][i], depth + 1)
    if sub != "" { ks.push(ufKidK[r][i] + "=" + sub) }
    i = i + 1
  }
  ffSortStrs(ks)
  for k in ks { out = out + " " + k }
  out
}

// The function sources of `s`'s class and of the slots derived from it, into `out`.
function ffDeepSrc(s: i32, depth: i32, out: string[]) {
  const r = ffFind(s)
  if r < 0 || depth > 4 { return 0 }
  for f in ufSrc[r] {
    const k = i32ToStr(f)
    if !strListHas(out, k) { out.push(k) }
  }
  for k in ufKidS[r] { ffDeepSrc(k, depth + 1, out) }
  0
}

function ffSortStrs(xs: string[]) {
  let i = 1
  while i < xs.length {
    let j = i
    while j > 0 && ffStrLess(xs[j], xs[j - 1]) {
      const t = xs[j]
      xs[j] = xs[j - 1]
      xs[j - 1] = t
      j = j - 1
    }
    i = i + 1
  }
  0
}

function ffStrLess(a: string, b: string): boolean {
  let i = 0
  while i < a.length && i < b.length {
    if a[i] != b[i] { return a[i] < b[i] }
    i = i + 1
  }
  a.length < b.length
}

// The declaration of the variable a `for` loop `ix` binds its value to: a list's first variable, a
// map's second (`for k, v in m`). -1 when `ix` is no `for` loop.
function ffLoopValueDecl(ix: i32): i32 {
  const n = nodeAt(ix)
  if !(n is ForIn) { return -1 }
  if n.fiDecl2 >= 0 && fnFlowElemKind(n.fiIter) == "v" { return n.fiDecl2 }
  n.fiDecl1
}

// The name declaration `ix` binds, "" for a node that binds none the table tracks.
function ffBindName(ix: i32): string {
  const n = nodeAt(ix)
  if n is LetDecl { return n.letName }
  if n is Param { return n.parName }
  if n is LoopVar { return loopVarName(ix) }
  ffNoBinding(ix)
}

// Every other kind binds no slot the table tracks; a function declaration names a source.
function ffNoBinding(_ix: i32): string { "" }

function ffShadowCollect(
  ix: i32,
  names: string[],
  sigs: string[],
  srcs: string[],
  calls: string[],
  top: boolean,
) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is FuncDecl && !top { return 0 }
  let bd = ix
  if n is ForIn { bd = ffLoopValueDecl(ix) }
  const nm = ffBindName(bd)
  if nm != "" {
    const s = ffSlotOfDecl(ffOrig(bd))
    names.push(nm)
    if s >= 0 { sigs.push(ffDeepSig(s, 0)) } else { sigs.push("") }
    const ss: string[] = []
    ffDeepSrc(s, 0, ss)
    ffSortStrs(ss)
    srcs.push(ffJoin(ss))
  }
  if n is Call {
    const c = unwrapParen(n.callFn)
    if c >= 0 && c < P.nodes.length {
      const cn = nodeAt(c)
      if cn is Ident {
        if (swByName[cn.identName] ?? -1) >= 0 { calls.push(cn.identName) }
      }
    }
  }
  for k in nodeChildren(ix) {
    ffShadowCollect(k, names, sigs, srcs, calls, false)
  }
  0
}

// The pre-mono node final-tree node `ix` copies: the origin column's answer, else the
// same-position parameter of the template that minted an instance, else `ix`.
function ffOrig(ix: i32): i32 {
  const o = identOrigOf(ix)
  if o >= 0 { return o }
  swParamOrig[ix] ?? ix
}

// The slot of declaration `d` in a context the swept function stands for, else in the last
// context that declared it; -1 when the table never declared it.
function ffSlotOfDecl(d: i32): i32 {
  for sc in swCtxs {
    const hit = ffPairGet(FF_PAIR_DECL, d, sc)
    if hit >= 0 { return hit }
  }
  const c = declCtx[d] ?? -1
  if c < 0 { return -1 }
  ffPairGet(FF_PAIR_DECL, d, c)
}

// The name a class is known by: its bindings' names.
function ffClassNames(r: i32): string[] {
  const out: string[] = []
  for d in ufDecl[r] {
    const nm = ffBindName(d)
    if nm != "" { out.push(nm) }
  }
  out
}

// Multi-pin agreement, both directions: a class with two or more pins that holds two functions or
// is written, against the bindings the monomorphizer refused for the same reason.
function ffMultiPin() {
  const fails = fnFlowSigFails()
  const matched: string[] = []
  let r = 0
  while r < ufPar.length {
    if (
      ufPar[r] == r
      && ffClassPins(r).length >= 2
      && (ufSrc[r].length >= 2 || ufWritten[r])
    ) {
      const names = ffClassNames(r)
      let both = ""
      for nm in names {
        if strListHas(fails, nm) { both = nm }
      }
      if both != "" {
        matched.push(both)
        ffRow("multi-pin: both", "binding", both)
      } else if names.length > 0 {
        ffRow("multi-pin: table only", "binding", names[0])
      }
    }
    r = r + 1
  }
  for nm in fails {
    if !strListHas(matched, nm) { ffRow("multi-pin: mono only", "binding", nm) }
  }
  0
}

// The classes a function argument escaped from, once each, by the position that let it go.
function ffTopRows() {
  let r = 0
  while r < ufPar.length {
    if ufPar[r] == r && ufTop[r] != "" && ufSrc[r].length > 0 {
      ffRow("top", ufTop[r], "")
    }
    r = r + 1
  }
  0
}

// Count the last armed compile's verdicts into the shared bank; the host calls this after the
// compile returns, since a refused compile never reaches the sweep's hook.
export function fnFlowShadowFinish() {
  if ffMode == 0 || !ffBuilt { return 0 }
  identOrigArm(false)
  ffMultiPin()
  ffTopRows()
  if !ffSwept { return 0 }
  swByName = Map()
  swFeOf = Map()
  swChain = []
  let fe = 0
  while fe < fnStmts.length {
    const f = fnStmts[fe]
    if f >= 0 && f < P.nodes.length {
      const fd = nodeAt(f)
      if fd is FuncDecl {
        if (swByName[fd.fnName] ?? -1) < 0 { swByName[fd.fnName] = fe }
        swFeOf[f] = fe
      }
    }
    fe = fe + 1
  }
  swTmpl = Map()
  swParamOrig = Map()
  let k = 0
  while k < monoInstFe.length && k < monoInstOrig.length {
    const ife = monoInstFe[k]
    const ofe = monoInstOrig[k]
    if (
      ife >= 0
      && ife < fnStmts.length
      && ofe >= 0
      && ofe < monoOrigNode.length
    ) {
      swTmpl[fnStmts[ife]] = monoOrigNode[ofe]
      ffMapParams(fnStmts[ife], monoOrigNode[ofe])
    }
    k = k + 1
  }
  swSeen = []
  swResOf = Map()
  while swSeen.length < P.nodes.length { swSeen.push(-1) }
  swStamp = 0
  swNextStamp = 1
  swCtxs = []
  swVisited = Map()
  for st in ffStmts { ffSweepNode(st) }
  for f in fnStmts { ffSweepNode(f) }
  swSeen = []
  swVisited = Map()
  ffSwept = false
  0
}
