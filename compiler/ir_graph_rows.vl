// The test instrument over the IR analyses: under `$VL_IR_GRAPH` the claim seam banks one shadow
// row per parameter and local of each claimed function, its writes and reads as source lines,
// each line's effect class, and the seal banks the call graph's sites and components, so a test
// states them by hand.
// `gIrGraph` is a temporary switch, not a build mode: the first pass that reads the analyses
// computes them under its own enablement, and the switch is deleted then.
import { IrFn, SEffect, SLet } from "./ir"
import { irEffectPure, irRhsEffect } from "./ir_effect"
import {
  DuDefKind,
  irDuDefKinds,
  irDuDefs,
  irDuLoopOf,
  irDuOf,
  irDuParent,
  irDuUses,
} from "./ir_defuse"
import { P, i32ToStr } from "./ast"
import {
  cgCallees,
  cgCallers,
  cgComponents,
  cgEscapes,
  cgFunctions,
  cgHasIr,
  cgNameOf,
  cgSizeOf,
} from "./ir_callgraph"
import { nodeStartTok } from "./fmt_util"

export let gIrGraph = 0
export function setIrGraph(k: i32) {
  gIrGraph = if k == 1 { 1 } else { 0 }
  return 0
}

// The line of the first token of node `id`'s source; `0` for the entry (`-1`) or a node with no
// source.
function lineOf(f: IrFn, id: i32): i32 {
  if id < 0 || id >= f.irNodeAt.length { return 0 }
  const tk = nodeStartTok(f.irNodeAt[id])
  return if tk >= 0 && tk < P.toks.length { P.toks[tk].line } else { 0 }
}

// `ns` in ascending order of their lines `ls`, then by text, by insertion: the lists are short.
function sorted(ls: i32[], ns: string[]): string[] {
  const out: string[] = []
  const key: i32[] = []
  let i = 0
  while i < ns.length {
    let k = out.length
    out.push(ns[i])
    key.push(ls[i])
    while (
      k > 0
      && (key[k - 1] > ls[i] || key[k - 1] == ls[i] && out[k - 1] > ns[i])
    ) {
      out[k] = out[k - 1]
      key[k] = key[k - 1]
      k = k - 1
    }
    out[k] = ns[i]
    key[k] = ls[i]
    i = i + 1
  }
  return out
}

function joined(ns: string[]): string {
  let out = ""
  for s in ns { out = if out == "" { s } else { out + "," + s } }
  return out
}

// One row per parameter and local of `f`, in variable order: `du <fn> <param|local> def
// <line>:<kind>[^<parent line>],... use <line>[@<innermost loop line>],...`, each list sorted.
export function irDuRows(f: IrFn): string[] {
  const d = irDuOf(f)
  const out: string[] = []
  let v = 0
  while v < f.irVars.length {
    const k = f.irVars[v].vKind
    if k == "param" || k == "local" {
      const ds = irDuDefs(d, v)
      const ks: DuDefKind[] = irDuDefKinds(d, v)
      const defs: string[] = []
      const dl: i32[] = []
      let i = 0
      while i < ds.length {
        dl.push(lineOf(f, ds[i]))
        const pa = irDuParent(d, ds[i])
        const up = if pa >= 0 { "^" + i32ToStr(lineOf(f, pa)) } else { "" }
        defs.push(i32ToStr(dl[i]) + ":" + ks[i] + up)
        i = i + 1
      }
      const uses: string[] = []
      const ul: i32[] = []
      for u in irDuUses(d, v) {
        ul.push(lineOf(f, u))
        const lp = irDuLoopOf(f, d, u)
        const at = if lp >= 0 { "@" + i32ToStr(lineOf(f, lp)) } else { "" }
        uses.push(i32ToStr(lineOf(f, u)) + at)
      }
      out.push(
        "du "
          + f.irName
          + " "
          + k
          + " def "
          + joined(sorted(dl, defs))
          + " use "
          + joined(sorted(ul, uses)),
      )
    }
    v = v + 1
  }
  return out
}

function srcLine(at: i32): i32 {
  const tk = if at >= 0 { nodeStartTok(at) } else { -1 }
  return if tk >= 0 && tk < P.toks.length { P.toks[tk].line } else { 0 }
}

function fnLabel(fe: i32): string {
  if fe < 0 { return "?" }
  return if cgHasIr(fe) { cgNameOf(fe) } else { "#" + i32ToStr(fe) }
}

// The call graph's rows once sealed: per recorded function in claim order, one
// `cg <caller> <kind> <callee> <line>` per site; per function, its callers' count, whether it
// escapes, and its node count; then each
// component, callees' first, as `scc <k> <names>`, and whether the graph is complete.
export function irCgRows(): string[] {
  const out: string[] = []
  const seen: {[i32]: boolean} = Map()
  for fe in cgFunctions() {
    if seen.has(fe) { continue }
    seen[fe] = true
    const s = cgCallees(fe)
    const name = if fe < 0 { "@start" } else { cgNameOf(fe) }
    let i = 0
    while i < s.csFn.length {
      const k = s.csKind[i]
      const callee = if k == "host" { "host" } else { fnLabel(s.csFn[i]) }
      out.push(
        "cg " + name + " " + k + " " + callee + " " + i32ToStr(srcLine(s.csAt[i])),
      )
      i = i + 1
    }
    if fe >= 0 {
      const esc = if cgEscapes(fe).cfOn { "escapes" } else { "local" }
      out.push(
        "callers "
          + name
          + " "
          + i32ToStr(cgCallers(fe).csFn.length)
          + " "
          + esc
          + " size "
          + i32ToStr(cgSizeOf(fe)),
      )
    }
  }
  const c = cgComponents()
  let k = 0
  while k < c.ccComps.length {
    const names: string[] = []
    for fe in c.ccComps[k] { names.push(cgNameOf(fe)) }
    const ls: i32[] = []
    for _n in names { ls.push(0) }
    out.push("scc " + i32ToStr(k) + " " + joined(sorted(ls, names)))
    k = k + 1
  }
  out.push("cg complete " + if c.ccComplete { "true" } else { "false" })
  return out
}

// One row per source line of `f` holding a right-hand side the body reaches: `eff <fn> <line>
// <class>`, the class `pure` or the union of `trap`, `write` and `call` over that line's.
export function irEffRows(f: IrFn): string[] {
  const d = irDuOf(f)
  const lines: i32[] = []
  const trap: {[i32]: boolean} = Map()
  const write: {[i32]: boolean} = Map()
  const call: {[i32]: boolean} = Map()
  let id = 0
  while id < f.irNodes.length {
    const n = f.irNodes[id]
    const reached = irDuParent(d, id) >= -1
    const r = if !reached { null } else if n is SLet { n.lRhs } else if n is SEffect { n.efRhs } else { null }
    if r != null {
      const e = irRhsEffect(r)
      const l = lineOf(f, id)
      if !trap.has(l) {
        lines.push(l)
        trap[l] = false
        write[l] = false
        call[l] = false
      }
      if !irEffectPure(e) {
        trap[l] = (trap[l] ?? false) || e.rxTrap
        write[l] = (write[l] ?? false) || e.rxWrite
        call[l] = (call[l] ?? false) || e.rxCall
      }
    }
    id = id + 1
  }
  const rows: string[] = []
  for l in lines {
    const parts: string[] = []
    if trap[l] ?? false { parts.push("trap") }
    if write[l] ?? false { parts.push("write") }
    if call[l] ?? false { parts.push("call") }
    const c = if parts.length == 0 { "pure" } else { joined(parts) }
    rows.push("eff " + f.irName + " " + i32ToStr(l) + " " + c)
  }
  return sorted(lines, rows)
}
