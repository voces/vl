// The test instrument over the IR analyses: under `$VL_IR_GRAPH` the claim seam banks one shadow
// row per parameter and local of each claimed function, its writes and reads as source lines, so
// a test states them by hand. `gIrGraph` is a temporary switch, not a build mode: the first pass
// that reads the analyses computes them under its own enablement, and the switch is deleted then.
import { IrFn } from "./ir"
import { DuDefKind, irDuDefKinds, irDuDefs, irDuOf, irDuUses } from "./ir_defuse"
import { nodeLineOf } from "./check_capture_loss"

export let gIrGraph = 0
export function setIrGraph(k: i32) {
  gIrGraph = if k == 1 { 1 } else { 0 }
  return 0
}

function decimal(v: i32): string {
  if v < 0 { return "-" + decimal(0 - v) }
  const ds = "0123456789"
  let out = ""
  let n = v
  while n >= 10 {
    const d = n % 10
    out = ds.slice(d, d + 1) + out
    n = n / 10
  }
  return ds.slice(n, n + 1) + out
}

// The source line of node `id` of `f`; `0` for the entry (`-1`) or a node with no source.
function lineOf(f: IrFn, id: i32): i32 {
  if id < 0 || id >= f.irNodeAt.length { return 0 }
  return nodeLineOf(f.irNodeAt[id])
}

// `ns` in ascending order of their lines `ls`, then by text, by insertion: the lists are short.
function sorted(ls: i32[], ns: string[]): string[] {
  const out: string[] = []
  const key: i32[] = []
  let i = 0
  while i < ns.length {
    let k = out.length
    out.push(ns[i])
    key.push(ls[i])
    while k > 0 && (key[k - 1] > ls[i] || key[k - 1] == ls[i] && out[k - 1] > ns[i]) {
      out[k] = out[k - 1]
      key[k] = key[k - 1]
      k = k - 1
    }
    out[k] = ns[i]
    key[k] = ls[i]
    i = i + 1
  }
  return out
}

function joined(ns: string[]): string {
  let out = ""
  for s in ns {
    out = if out == "" { s } else { out + "," + s }
  }
  return out
}

// One row per parameter and local of `f`, in variable order:
// `du <fn> <param|local> def <line>:<kind>,... use <line>,...`, each list sorted.
export function irDuRows(f: IrFn): string[] {
  const d = irDuOf(f)
  const out: string[] = []
  let v = 0
  while v < f.irVars.length {
    const k = f.irVars[v].vKind
    if k == "param" || k == "local" {
      const ds = irDuDefs(d, v)
      const ks: DuDefKind[] = irDuDefKinds(d, v)
      const defs: string[] = []
      const dl: i32[] = []
      let i = 0
      while i < ds.length {
        dl.push(lineOf(f, ds[i]))
        defs.push(decimal(dl[i]) + ":" + ks[i])
        i = i + 1
      }
      const uses: string[] = []
      const ul: i32[] = []
      for u in irDuUses(d, v) {
        ul.push(lineOf(f, u))
        uses.push(decimal(lineOf(f, u)))
      }
      out.push(
        "du " + f.irName + " " + k + " def " + joined(sorted(dl, defs)) + " use "
          + joined(sorted(ul, uses)),
      )
    }
    v = v + 1
  }
  return out
}
