  // `length < 2`, the `{`/`}` endpoint pair, and the `name[1] == '['` map reject — are
  // `nameIsShapeSpanEnds` character for character, on every input rather than on every input
  // tried. #1186 listed this function among the FOUR `emit_base` sites carrying the WIDER
  // endpoint predicate (the one without the map reject) and left it alone on that basis; the
  // map reject was already on the line below the endpoint pair at #1186's own commit, so the
  // decline was reasoning about a spelling this function did not have.
  if !nameIsShapeSpanEnds(name) { return false }
  if annArrowAt(name) >= 0 { return false }
  let sp = 0
  while sp < name.length {
    if name[sp] == ' ' { return false }
    sp = sp + 1
  }
