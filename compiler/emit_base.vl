// `emit_base.vl` — the emitter's pure vocabulary: type-name analysis (`name*`/`ty*`/
// `ann*`/`ret*`/`nul*`), monomorphization name logic (`mono*`/`gae*`), and low-level
// string/byte/opcode helpers. Touches no emitter state; a leaf the emitter (and
// `emit_query`) import.

import {
  T,
  TyArray,
  TyFunc,
  TyMap,
  TyNullable,
  declAnnRawTyName,
  inferRetNameOf,
  isValueUnionName,
  nameIsLitUnionType,
  nodeTyArrayElemRepName,
  nodeTyIsClosureArray,
  nodeTyIsFunc,
  nodeTyIsLitUnionAlias,
  nodeTyIsNulBool,
  nodeTyIsNulClosure,
  nodeTyIsNulI32List,
  nodeTyIsNulString,
  nodeTyIxOf,
  nodeTyPrimName,
  nodeTyWidenedRepName,
  valueAtomKind,
} from "./typecheck"
import { sidArrGet, sidArrPut, sidLookup, sidOf, sidOfNode } from "./symbols"
// ── the type-name grammars this file calls, homed in `tyname.vl` ──
// A leaf with zero imports; this file binds them for its own calls and republishes
// none — every emitter module asks the home directly. The layering is one-directional:
// `emit_base.vl` imports `typecheck.vl`, which imports nothing from `emit_*`, avoiding a cycle.
import {
  annGenAppSpanEnds,
  arrElemIs,
  arrElemIsArrayOf,
  arrElemNameRaw,
  fieldNameOf,
  fieldTypeTextOf,
  fnParamsTextOf,
  fnRetTextOf,
  gaeArgsTextOf,
  gaeHeadNameOf,
  gaeLtAt,
  groupInnerOf,
  listElemNameOf,
  mapSpellKeyName,
  nameIsArray,
  nameIsBraceSpanEnds,
  nameIsFuncTypeAtom,
  nameIsMapOpen,
  nameIsMapSpan,
  nameIsParenOpen,
  nameIsParenSpanEnds,
  nameIsQuotedLeaf,
  nameIsShapeOpen,
  nameIsSpaceFree,
  peelGroupParens,
  spanEqAt,
  splitUnionAtoms,
  tyGroupEndIndex,
  tyTopIndexOf,
  tyTopLevelSplit,
  unionMemberCount,
  unionMemberCountSpan,
} from "./tyname"
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  Call,
  CharLit,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  Index,
  IsExpr,
  LetDecl,
  Member,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  Program,
  StrLit,
  TypeDecl,
  TypeRef,
  Unary,
  WhileStmt,
  i32ToStr,
} from "./ast"

// Append all of `src` onto `dst` (in place) and return `dst`.
export function appendAll(dst: i32[], src: i32[]) {
  let i = 0
  while i < src.length {
    dst.push(src[i])
    i = i + 1
  }
  dst
}
// The IEEE-754 literal encoders (`f64Bytes`/`f32Bytes`) live in `emit_bignum` — a leaf,
// so the checker shares the exact same overflow judgement (`f64LitOverflows`/
// `f32LitOverflows`) without an import cycle.
// True if `name` is currently in the `bound` set (a param or an in-scope `let`).
export function capIsBound(bound: string[], name: string) {
  let i = 0
  while i < bound.length {
    if bound[i] == name { return true }
    i = i + 1
  }
  false
}
// True if `name` is in `caps` already (dedup the capture list).
export function capHas(caps: string[], name: string) {
  let i = 0
  while i < caps.length {
    if caps[i] == name { return true }
    i = i + 1
  }
  false
}
// True if `name` is a call target the emitter lowers inline — one of the five builtins
// (`print`, `Map`, `Set`, `fromCodePoint`, `fromCodePoints`). Consulted only at `capScan`'s
// `Call` arm, callee position: elsewhere it suppressed genuine captures of a local sharing
// one of these names. Memory intrinsics are a separate list, `typecheck.nameIsEmitterIntrinsic`, consulted by `capScan` beside this one.
export function isBuiltinFnName(name: string) {
  if name == "print" { return true }
  if name == "fromCodePoint" { return true }
  if name == "fromCodePoints" { return true }
  if name == "Map" { return true }
  if name == "Set" { return true }
  false
}
// A single-entry cache for `parentLetOf`, keyed by block: the block whose name → `LetDecl`
// map is built, and the map itself (`name -> LetDecl` arena index, first-wins). Every
// `parentLetOf` caller passes its function's body block, so the cache rebuilds once per
// function. `resetParentLetCache` clears it at `emitProgram` start — a stale block index from a prior compile must not be trusted.
let plCacheBlock: i32 = -1
// `plSidVal`/`plSidGen` are the R6 form of `plCacheMap`: a dense sid-indexed array replaces a
// per-block `{[string]: i32}` that could not be cleared cheaply. A slot counts as present only
// when its `plSidGen` stamp equals the current `plGen`, so clearing is O(1). `plGen` starts at
// 0 and is bumped before the first build, so a lookup always sees `plGen >= 1`, and `sidArrPut`'s -1 fill value can never look present.
let plSidVal: i32[] = []
let plSidGen: i32[] = []
let plGen: i32 = 0

// The loop-variable half of `plCacheMap`'s plan: `name -> ForRange/ForIn` arena index,
// first-wins, under the same generation stamp. A `for v in …` variable is a function-scoped
// local like a body `let`, but is not a `LetDecl`, so it needs its own array — `parentLetOf`
// hands its answer to callers that decode it as a `LetDecl` index, and widening that return would break every one of them.
let plLoopSidVal: i32[] = []
let plLoopSidGen: i32[] = []

// The `FuncDecl`-name set behind `nameNamesFunction`, and the arena high-water mark it has
// folded (append-only — see `nameNamesFunction`'s own contract). Reset rides on
// `resetParentLetCache`: both are per-compile arena caches sharing `emitProgram` as their
// one call site, and splitting them apart is how one of them would rot.
let nnfSet: {[string]: boolean} = Map()
let nnfScanned: i32 = 0

// The module scope's loop-variable names, behind `moduleBindsLoopVar`. Built once per
// compile from the `Program` node, in its own set rather than through the single-entry
// `parentLetOf` cache: capture analysis asks this while resolving a function body, and
// evicting that cache per identifier would rebuild the whole body's plan each time.
let mlvSet: {[string]: boolean} = Map()
let mlvBuilt: boolean = false

// The module scope's block-local bindings — a `const`/`let` written inside a top-level
// `if`/`while`/`for`/bare block, which is a start-function local, not a global. Behind
// `moduleLocalLetOf`, filled by the same walk as `mlvSet` (D1244). A top-level `LetDecl`
// is deliberately absent: that is a global, addressable directly, and never a capture.
let mllMap: {[string]: i32} = Map()
// Is `mllMap` non-empty? `parentBindingOf` consults the module arm on every miss — its hot
// path via `retCapturedMapShape` — so the common answer must cost a branch, not a string hash.
let mllAny: boolean = false
// The names `mllMap` holds more than one binding for. Two sibling top-level blocks may each
// bind `p`, and the map is first-wins, so a reader that needs the binding a given call site
// denotes must decline rather than take the first (D1596): pinning one block's ref binding
// over another block's i32 is a `runs -> not-runs`. `moduleLocalLetOfUnique` is that reader.
let mllDup: {[string]: boolean} = Map()
// The second-and-later bindings behind each `mllDup` name, as parallel (name, arena index)
// rows, read through `moduleLocalLetAll`. Beside the first-wins map rather than in it: the
// common name has exactly one binding and must not pay for a list.
let mllMoreNames: string[] = []
let mllMoreIxs: i32[] = []

// Records `name` as naming a function without waiting for the fold to reach its node — the
// escape hatch for the one writer that renames a `FuncDecl` in place after the arena already
// holds it (`emit_collect`'s lambda numbering). A note is monotone (only adds a name); the
// driver's module-merge rename, which also retires an old name, runs before `emitProgram`'s reset, so the set never needs to see it.
export function noteFuncName(name: string) {
  if name == "" { return 0 }
  nnfSet[name] = true
  0
}

// Drops this file's sid-keyed rows. Paired with `symbols.sidReset` by the driver
// (`emit_sections.sidKeyedTablesReset`) because the id space is re-keyed there: a generation
// stamp defends against a stale key, never against a re-keyed universe — program N+1 would
// re-issue `plGen` from 0 and match program N's rows, handing out that program's arena indices.
export function sidResetParentLet() {
  plCacheBlock = -1
  plSidVal = []
  plSidGen = []
  plLoopSidVal = []
  plLoopSidGen = []
  plGen = 0
  0
}

export function resetParentLetCache() {
  sidResetParentLet()
  nnfSet = Map()
  nnfScanned = 0
  mlvSet = Map()
  mlvBuilt = false
  mllMap = Map()
  mllDup = Map()
  mllMoreNames = []
  mllMoreIxs = []
  mllAny = false
  0
}

// Fills `plCacheMap` (via the parallel sid arrays) with every function-scoped `LetDecl`
// reachable from `blockIx`, first-wins, in `parentLetOf`'s own pre-order. Descends both
// `if`/`else` branches — the else slot may be a bare `Block` or a nested `IfStmt` — plus
// `while`/`for` bodies and nested blocks, since a wasm local is scoped to the whole function.
function plScanStmt(ix: i32) {
  if ix < 0 { return 0 }
  const st = P.nodes[ix]
  if st is LetDecl {
    // The id comes from the carrier — `ix` is this `LetDecl`'s arena index, so the first pass
    // over the node costs no hash. First-wins is the generation test: an earlier write in this
    // generation blocks a later one.
    const lsid = sidOfNode(ix)
    if sidArrGet(plSidGen, lsid) != plGen {
      sidArrPut(plSidGen, lsid, plGen)
      sidArrPut(plSidVal, lsid, ix)
    }
  } else if st is IfStmt {
    plScanStmt(st.ifThen)
    if st.ifElse >= 0 { plScanStmt(st.ifElse) }
  } else if st is WhileStmt {
    plScanStmt(st.whileBody)
  } else if st is ForRange {
    plRecordLoopVar(st.frVar, ix)
    plScanStmt(st.frBody)
  } else if st is ForIn {
    plRecordLoopVar(st.fiVar, ix)
    plScanStmt(st.fiBody)
  } else if st is Block {
    const stmts = st.blkStmts
    let i = 0
    while i < stmts.length {
      plScanStmt(stmts[i])
      i = i + 1
    }
  } else if st is Program {
    // The module scope, reached only when a caller passes the `Program` node as the block —
    // `synthGlobalDstPinAnns` is the only one. A top-level `const`/`let` is the module's analogue
    // of a function-scoped local; the walk stops at a top-level `FuncDecl` for free (no arm
    // handles it here), so a function's own locals never leak into the module's map.
    const pstmts = st.progStmts
    let pi = 0
    while pi < pstmts.length {
      plScanStmt(pstmts[pi])
      pi = pi + 1
    }
  }
  0
}

// Records loop variable `name`, bound by the `ForRange`/`ForIn` at arena index `ix`, into
// the plan's loop-variable half — first-wins under the current generation, matching the
// `LetDecl` half. An unnamed variable ("" — not producible by the parser) records nothing.
function plRecordLoopVar(name: string, ix: i32) {
  if name == "" { return 0 }
  const lsid = sidOf(name)
  if sidArrGet(plLoopSidGen, lsid) != plGen {
    sidArrPut(plLoopSidGen, lsid, plGen)
    sidArrPut(plLoopSidVal, lsid, ix)
  }
  0
}

// Collects every module-scope `for` variable name reachable from statement `ix` into
// `mlvSet`, and every module-scope block-local `LetDecl` into `mllMap` (D1244). Descends
// bodies sharing the module's local frame (loops, `if` arms, bare blocks) and stops at a
// `FuncDecl`. `mlvBuild` skips a top-level `LetDecl` first — that is a global, its own storage class.
function mlvScanStmt(ix: i32) {
  if ix < 0 { return 0 }
  const st = P.nodes[ix]
  if st is LetDecl {
    if (mllMap[st.letName] ?? -1) < 0 {
      mllMap[st.letName] = ix
      mllAny = true
    } else {
      mllDup[st.letName] = true
      mllMoreNames.push(st.letName)
      mllMoreIxs.push(ix)
    }
  } else if st is ForRange {
    if st.frVar != "" { mlvSet[st.frVar] = true }
    mlvScanStmt(st.frBody)
  } else if st is ForIn {
    if st.fiVar != "" { mlvSet[st.fiVar] = true }
    mlvScanStmt(st.fiBody)
  } else if st is WhileStmt {
    mlvScanStmt(st.whileBody)
  } else if st is IfStmt {
    mlvScanStmt(st.ifThen)
    if st.ifElse >= 0 { mlvScanStmt(st.ifElse) }
  } else if st is Block {
    const stmts = st.blkStmts
    let i = 0
    while i < stmts.length {
      mlvScanStmt(stmts[i])
      i = i + 1
    }
  }
  0
}

// Does the module scope bind `name` as a `for` loop variable? `rootIx` is the `Program`
// node. The module's top level is not a lifted frame (`fnParent` is -1 for a lambda written
// there), so the frame walk used inside a function runs off the end before it can answer.
// A top-level loop variable is still a genuine start-function local, captured like any other.
export function moduleBindsLoopVar(rootIx: i32, name: string) {
  mlvBuild(rootIx)
  mlvSet[name] == true
}

// Builds both module-frame tables once per compile. A top-level `LetDecl` is skipped rather
// than descended: it is a module global, so it belongs to no local frame, and recording it
// would make `moduleLocalLetOf` answer for a name that is not a capture.
function mlvBuild(rootIx: i32) {
  if rootIx < 0 { return 0 }
  if mlvBuilt { return 0 }
  mlvBuilt = true
  const r = P.nodes[rootIx]
  if r is Program {
    const stmts = r.progStmts
    let i = 0
    while i < stmts.length {
      const s = P.nodes[stmts[i]]
      if s is LetDecl {} else { mlvScanStmt(stmts[i]) }
      i = i + 1
    }
  }
  0
}

// The module-scope block-local `LetDecl` binding `name`, or -1. `parentBindingOf`'s module
// arm (D1244): the top level is not a lifted frame, so the `fnParent` walk runs off the chain
// before it can type a capture here, and a ref-repped capture then took the i32 default —
// loud on a struct (`field access receiver is not a struct`), invalid wasm on a list or string.
export function moduleLocalLetOf(rootIx: i32, name: string) {
  mlvBuild(rootIx)
  if !mllAny { return -1 }
  mllMap[name] ?? -1
}

// `moduleLocalLetOf`, but -1 when the module scope binds `name` in more than one block. The
// map is first-wins over a walk with no notion of which block a reader sits in, so its answer
// denotes the binding only while the name is unambiguous. D1596: the monomorphizer's pin
// needs the denoted binding — taking the first turned a working two-block program into invalid wasm.
export function moduleLocalLetOfUnique(rootIx: i32, name: string) {
  const ix = moduleLocalLetOf(rootIx, name)
  if ix < 0 { return -1 }
  if mllDup[name] == true { return -1 }
  ix
}

// Every module-scope block-local binding of `name`, in walk order, appended to `out`. The
// first is `moduleLocalLetOf`'s answer and the rest are why `moduleLocalLetOfUnique`
// declines; a caller that can pick among them, or that finds they agree, needs them all
// (D1598).
export function moduleLocalLetAll(rootIx: i32, name: string, out: i32[]) {
  mlvBuild(rootIx)
  if !mllAny { return 0 }
  const first = mllMap[name] ?? -1
  if first < 0 { return 0 }
  out.push(first)
  if mllDup[name] != true { return 0 }
  let i = 0
  while i < mllMoreNames.length {
    if mllMoreNames[i] == name { out.push(mllMoreIxs[i]) }
    i = i + 1
  }
  0
}

function plBuildLetMap(blockIx: i32) { plScanStmt(blockIx) }

// Find a `LetDecl` for `name` anywhere in the parent body block (incl. nested if/loop
// bodies — wasm locals are function-scoped). Returns its arena index or -1. Backed by the
// single-entry per-block cache above (built on a miss, then O(1)).
export function parentLetOf(blockIx: i32, name: string) {
  // `sidOf`, not `sidLookup`: this table is built lazily on the miss inside `parentLetOfSid`,
  // so a name interned only by that build would resolve to -1 for an id taken earlier —
  // see `sidLookup`'s own contract.
  parentLetOfSid(blockIx, sidOf(name))
}

// The sid-taking primitive (R5/R6): no hash, no probe, two array reads — what the hot
// callers (`unionNameOfIdent`, `identFnTypeAnnName`, `identClosureFe`, `identCopySource`)
// use to resolve an identifier and then ask this same table about the same name, spending
// the interned id twice. A caller holding the identifier's arena index gets it from the carrier for free.
export function parentLetOfSid(blockIx: i32, sid: i32) {
  if blockIx < 0 { return -1 }
  if blockIx != plCacheBlock {
    plGen = plGen + 1
    plBuildLetMap(blockIx)
    plCacheBlock = blockIx
  }
  if sid < 0 { return -1 }
  if sidArrGet(plSidGen, sid) != plGen { return -1 }
  sidArrGet(plSidVal, sid)
}

// Finds the `for` loop variable named `name` anywhere in the body block at `blockIx` — the
// loop-variable twin of `parentLetOf`, sharing its walk, cache and generation stamp. Returns
// the binding `ForRange`/`ForIn` arena index, or -1. Ask it wherever "is this name bound in
// this frame" decides something: a loop variable is a function-scoped local `parentLetOf` cannot see.
export function parentLoopVarOf(blockIx: i32, name: string) {
  parentLoopVarOfSid(blockIx, sidOf(name))
}

// The sid-taking primitive, with `parentLetOfSid`'s lazy build (the two halves are one
// table under one generation, so either lookup builds both).
function parentLoopVarOfSid(blockIx: i32, sid: i32) {
  if blockIx < 0 { return -1 }
  if blockIx != plCacheBlock {
    plGen = plGen + 1
    plBuildLetMap(blockIx)
    plCacheBlock = blockIx
  }
  if sid < 0 { return -1 }
  if sidArrGet(plLoopSidGen, sid) != plGen { return -1 }
  sidArrGet(plLoopSidVal, sid)
}
// The loop-stack position a `break`/`continue` targets: "" (unlabelled) binds to the top
// entry (the innermost loop); a label scans from the top for the nearest enclosing loop
// carrying it. Returns -1 when the label names no enclosing loop (the emit-time fail-loud guard).
export function loopStackFind(labels: string[], label: string) {
  if label == "" { return labels.length - 1 }
  let i = labels.length - 1
  while i >= 0 {
    if labels[i] == label { return i }
    i = i - 1
  }
  -1
}
// The value type-name of a synthetic map type-name `{[K]:V}` — the text after the first
// "]:", minus the closing `}`; "" if the name is not that shape. Not `tyname.mapSpellValName`,
// despite the same cut: that one gates on a closing `}`, this one gates on `nameIsMap` (opens
// `{[`, does not end `[]`), so this one accepts `{[string]:i32}|null` and returns garbled text where the checker's twin returns "".
export function mapValNameOf(name: string) {
  if !nameIsMap(name) { return "" }
  let i = 2
  while i < name.length - 1 {
    if name[i] == ']' {
      if name[i + 1] == ':' { return name.slice(i + 2, name.length - 1) }
    }
    i = i + 1
  }
  ""
}
// Maps a binary operator lexeme to its i32 wasm opcode, or -1 if unsupported. The three
// arithmetic ops and the six signed i32 comparisons are recognized; anything else (`/`, `%`,
// `=`, logical `&&`/`||`, …) falls through to -1 so the caller fails loudly rather than
// emitting a wrong opcode. Comparisons leave a 0/1 i32 on the stack, as a wasm `if` expects.
export function binOpcode(op: string) {
  if op == "+" {
    return 106 // 0x6a i32.add
  }
  if op == "-" {
    return 107 // 0x6b i32.sub
  }
  if op == "*" {
    return 108 // 0x6c i32.mul
  }
  if op == "/" {
    return 109 // 0x6d i32.div_s (signed; VL `i32` division is signed)
  }
  if op == "%" {
    return 111 // 0x6f i32.rem_s (signed remainder)
  }
  if op == "==" {
    return 70 // 0x46 i32.eq
  }
  if op == "!=" {
    return 71 // 0x47 i32.ne
  }
  if op == "<" {
    return 72 // 0x48 i32.lt_s
  }
  if op == ">" {
    return 74 // 0x4a i32.gt_s
  }
  if op == "<=" {
    return 76 // 0x4c i32.le_s
  }
  if op == ">=" {
    return 78 // 0x4e i32.ge_s
  }
  // Bitwise / shift (integer-only). VL `i32` is signed, so `>>` is the signed (arithmetic)
  // shift `shr_s` and `>>>` the unsigned (logical) shift `shr_u` — the distinction the LEB
  // encoders' `v >>> 7` relies on. Mirrors the host `INT_BINOPS` map in toWasm.ts (`&`->and,
  // `|`->or, `>>`->shr_s, `>>>`->shr_u).
  if op == "&" {
    return 113 // 0x71 i32.and
  }
  if op == "|" {
    return 114 // 0x72 i32.or
  }
  if op == "^" {
    return 115 // 0x73 i32.xor
  }
  if op == "<<" {
    return 116 // 0x74 i32.shl
  }
  if op == ">>" {
    return 117 // 0x75 i32.shr_s (signed/arithmetic)
  }
  if op == ">>>" {
    return 118 // 0x76 i32.shr_u (unsigned/logical)
  }
  -1
}
// The i64 instruction variant for `op`, selected when an operand is i64. Arithmetic/bitwise/
// shift consume two i64 and leave an i64; comparisons consume two i64 and leave an i32
// boolean. Returns -1 for an op with no i64 form (`&&`/`||`/`=`/`??`).
export function binOpcodeI64(op: string) {
  if op == "+" {
    return 124 // 0x7c i64.add
  }
  if op == "-" {
    return 125 // 0x7d i64.sub
  }
  if op == "*" {
    return 126 // 0x7e i64.mul
  }
  if op == "/" {
    return 127 // 0x7f i64.div_s
  }
  if op == "%" {
    return 129 // 0x81 i64.rem_s
  }
  if op == "&" {
    return 131 // 0x83 i64.and
  }
  if op == "|" {
    return 132 // 0x84 i64.or
  }
  if op == "^" {
    return 133 // 0x85 i64.xor
  }
  if op == "<<" {
    return 134 // 0x86 i64.shl
  }
  if op == ">>" {
    return 135 // 0x87 i64.shr_s
  }
  if op == ">>>" {
    return 136 // 0x88 i64.shr_u
  }
  if op == "==" {
    return 81 // 0x51 i64.eq
  }
  if op == "!=" {
    return 82 // 0x52 i64.ne
  }
  if op == "<" {
    return 83 // 0x53 i64.lt_s
  }
  if op == ">" {
    return 85 // 0x55 i64.gt_s
  }
  if op == "<=" {
    return 87 // 0x57 i64.le_s
  }
  if op == ">=" {
    return 89 // 0x59 i64.ge_s
  }
  -1
}
// The f64 instruction variant for `op`, selected when an operand is f64. Arithmetic
// consumes two f64 and leaves an f64; comparisons consume two f64 and leave an i32 boolean.
// Returns -1 for an op with no f64 form (`%`/bitwise/shift/`&&`/`||`/...) — a hard fail at
// the emitter, `emitBinExprNode` never falls through to the i32 path on it.
export function binOpcodeF64(op: string) {
  if op == "+" {
    return 160 // 0xa0 f64.add
  }
  if op == "-" {
    return 161 // 0xa1 f64.sub
  }
  if op == "*" {
    return 162 // 0xa2 f64.mul
  }
  if op == "/" {
    return 163 // 0xa3 f64.div
  }
  if op == "==" {
    return 97 // 0x61 f64.eq
  }
  if op == "!=" {
    return 98 // 0x62 f64.ne
  }
  if op == "<" {
    return 99 // 0x63 f64.lt
  }
  if op == ">" {
    return 100 // 0x64 f64.gt
  }
  if op == "<=" {
    return 101 // 0x65 f64.le
  }
  if op == ">=" {
    return 102 // 0x66 f64.ge
  }
  -1
}
// The f32 instruction variant for `op`, selected when an operand is f32. Arithmetic
// consumes two f32 and leaves an f32; comparisons consume two f32 and leave an i32 boolean.
// Returns -1 for an op with no f32 form (`%`/bitwise/shift/`&&`/`||`/...) — a hard fail at
// the emitter, `emitBinExprNode` never falls through to the i32 path on it.
export function binOpcodeF32(op: string) {
  if op == "+" {
    return 146 // 0x92 f32.add
  }
  if op == "-" {
    return 147 // 0x93 f32.sub
  }
  if op == "*" {
    return 148 // 0x94 f32.mul
  }
  if op == "/" {
    return 149 // 0x95 f32.div
  }
  if op == "==" {
    return 91 // 0x5b f32.eq
  }
  if op == "!=" {
    return 92 // 0x5c f32.ne
  }
  if op == "<" {
    return 93 // 0x5d f32.lt
  }
  if op == ">" {
    return 94 // 0x5e f32.gt
  }
  if op == "<=" {
    return 95 // 0x5f f32.le
  }
  if op == ">=" {
    return 96 // 0x60 f32.ge
  }
  -1
}
// Find the value-expr index for declared field `fieldName` in the object literal at
// `objIx`, or -1 if the literal does not set that field.
export function objFieldVal(objIx: i32, fieldName: string) {
  const o = P.nodes[objIx]
  if o is ObjLit {
    const fields = o.objFields
    let i = 0
    while i < fields.length {
      const f = P.nodes[fields[i]]
      if f is FieldInit {
        if f.fiName == fieldName { return f.fiValue }
      }
      i = i + 1
    }
  }
  -1
}
// True when evaluating `exprIx` cannot be observed by anything evaluated around it: it calls
// nothing and writes nothing. Reads qualify (permuting reads changes nothing when none of
// them writes), and so does a trap — the program dies at one of them either way. `a += b`/
// `a++` desugar to `a = …` in the parser, so the assignment arm covers every compound form (D1510's object-literal order stash).
function exprEffectFree(ix: i32): boolean {
  if ix < 0 { return false }
  const e = P.nodes[ix]
  if e is NumLit { return true }
  if e is StrLit { return true }
  if e is CharLit { return true }
  if e is BoolLit { return true }
  if e is NullLit { return true }
  if e is Ident { return true }
  if e is Paren { return exprEffectFree(e.parInner) }
  if e is Unary { return exprEffectFree(e.unArg) }
  if e is BinExpr {
    if e.binOp == "=" { return false }
    return exprEffectFree(e.binLeft) && exprEffectFree(e.binRight)
  }
  if e is Member { return exprEffectFree(e.memObj) }
  if e is OptMember { return exprEffectFree(e.omObj) }
  if e is Index {
    return exprEffectFree(e.idxArr) && exprEffectFree(e.idxIndex)
  }
  if e is IsExpr { return exprEffectFree(e.isObj) }
  if e is AsExpr { return exprEffectFree(e.asObj) }
  if e is ArrayLit {
    const es = e.arrElems
    let i = 0
    while i < es.length {
      if !exprEffectFree(es[i]) { return false }
      i = i + 1
    }
    return true
  }
  if e is ObjLit {
    const fs = e.objFields
    let j = 0
    while j < fs.length {
      const f = P.nodes[fs[j]]
      if f is FieldInit {
        if !exprEffectFree(f.fiValue) { return false }
      }
      j = j + 1
    }
    return true
  }
  // The default is named, not fallen through — `kind-ladder-incomplete`'s ask, and here it
  // is also the soundness statement: see `exprEffectFreeUnclassified`.
  exprEffectFreeUnclassified()
}
// Every `Node` kind `exprEffectFree`'s ladder does not test, as one answer: possibly
// effectful. `Call` and a lambda `FuncDecl` are exactly what the allow-list exists to
// exclude; `MatchExpr` and the statement kinds reaching expression position carry control
// flow this predicate does not walk. Fails closed on purpose: an unclassified kind must never have its literal silently reordered.
function exprEffectFreeUnclassified(): boolean { false }
// The layout field indices of `objIx`'s initialisers, ordered by source position — the
// order D1510's stash pass evaluates in. `names`/`start`/`cnt` is the layout name span
// (`sFieldNames` + `sFieldStart[si]` for a struct row, `uFieldNames` + `uFieldStart[vi]`
// for a union variant), so one walk serves both field loops. A field the literal omits contributes no entry.
export function objFieldSrcOrder(
  objIx: i32,
  names: string[],
  start: i32,
  cnt: i32,
): i32[] {
  const ord: i32[] = []
  const o = P.nodes[objIx]
  if o is ObjLit {
    const fs = o.objFields
    let j = 0
    while j < fs.length {
      const f = P.nodes[fs[j]]
      if f is FieldInit {
        let k = 0
        while k < cnt {
          if names[start + k] == f.fiName { ord.push(k) }
          k = k + 1
        }
      }
      j = j + 1
    }
  }
  ord
}
// True when the object literal at `objIx` must evaluate its initialisers into scratch
// locals before it constructs. `struct.new` takes operands in layout order — sorted by
// field name (D622) — so a literal written in any other order runs them permuted unless
// stashed; the stash only fires when the reorder is also observable (`exprEffectFree`).
export function objLitNeedsOrderStash(
  objIx: i32,
  names: string[],
  start: i32,
  cnt: i32,
): boolean {
  const o = P.nodes[objIx]
  if o is ObjLit {
    const fs = o.objFields
    if fs.length < 2 { return false }
    const ord = objFieldSrcOrder(objIx, names, start, cnt)
    let inOrder = true
    let i = 1
    while i < ord.length {
      if ord[i] < ord[i - 1] { inOrder = false }
      i = i + 1
    }
    if inOrder { return false }
    let j = 0
    while j < fs.length {
      const f = P.nodes[fs[j]]
      if f is FieldInit {
        if !exprEffectFree(f.fiValue) { return true }
      }
      j = j + 1
    }
  }
  false
}
// True when an `is` RHS names a literal type (`"a"`, `0`, `1.5`) — the runtime value-test
// arm of `emitIs` (the annotation softened to the base scalar in `canonEmitTypeNames`; the
// `is` compares the value). The quoted-leaf half is `tyname.nameIsQuotedLeaf`; the length==0
// guard stays in front of both — indexing traps and the nine routed sites disagree on the bound to fold in.
export function isLitVariantName(name: string) {
  if name.length == 0 { return false }
  if nameIsQuotedLeaf(name) { return true }
  const c = name[0]
  c >= '0' && c <= '9'
}
// True when the operand at `exprIx` is a place that can be re-evaluated without side
// effects. Every multi-compare union lowering re-reads its operand once per compare
// (`emitUnionLitIs` reads it twice — tag, then payload), so a non-re-readable receiver would
// duplicate its effect. The bound is effect-freedom, not ident-ness: a field path, an optional-chain link, and an element/map read all qualify when their receiver (and any subscript) does.
export function unionEqOperandOk(exprIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Ident { return true }
  if e is NumLit { return true }
  if e is StrLit { return true }
  if e is Member { return unionEqOperandOk(e.memObj) }
  if e is OptMember { return unionEqOperandOk(e.omObj) }
  if e is Index {
    return unionEqOperandOk(e.idxArr) && unionEqOperandOk(e.idxIndex)
  }
  false
}
// The narrowing-stack key of a member path over a plain `Ident` root (`o.y`, or nested
// `n.a.b`) — the same string `setNarrowFromCond` pushes for a union-field `is`/null guard.
// "" for any other receiver shape. The node itself is unwrapped, not only its receiver
// (D222): peeling a `Paren` off only the receiver mishandles `(t.v).r` under `if t.v is Circle`.
export function memberPathKeyOf(memIx: i32) {
  const m = P.nodes[unwrapParen(memIx)]
  if m is Member {
    const r = P.nodes[unwrapParen(m.memObj)]
    if r is Ident { return r.identName + "." + m.memProp }
    // A nested path (`n.a.b`) keys through its receiver's own path key — a non-`Ident`,
    // non-`Member` link (a call, an index) stays un-narrowable.
    if r is Member {
      const inner = memberPathKeyOf(m.memObj)
      if inner != "" { return inner + "." + m.memProp }
    }
  }
  ""
}
// The key text of a literal subscript — an integer literal's digits, a string literal's raw
// lexeme (quotes and all) — or "" when the node is neither. The emitter's twin of
// `typecheck.subscriptKeyTextOf`: deliberately the same rule, so `xs[0]` and `xs[00]` are
// two keys for one cell (over-conservative, never under). The string lexeme keeps its quotes, so `m[0]` and `m["0"]` cannot render one key.
export function subscriptKeyLexemeOf(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return "" }
  const n = P.nodes[unwrapParen(ix)]
  if n is NumLit {
    const t = n.numText
    if t.length < 1 { return "" }
    let i = 0
    while i < t.length {
      if t[i] < '0' || t[i] > '9' { return "" }
      i = i + 1
    }
    return t
  }
  if n is StrLit { return n.strText }
  ""
}
// The narrowing-stack key of an index place (`xs[0]`, `o.xs[0]`) — the emitter's twin of
// the checker's `placeKeyOf` index arm, spelling the same key `base + "[" + digits + "]"`.
// "" for a variable subscript or a non-place receiver. Kept separate from
// `memberPathKeyOf` (D451): a dozen member-shaped readers depend on that one answering "" for an index link.
export function indexPathKeyOf(idxIx: i32) {
  const n = P.nodes[unwrapParen(idxIx)]
  if n is Index {
    const lit = subscriptKeyLexemeOf(n.idxIndex)
    if lit == "" { return "" }
    const r = P.nodes[unwrapParen(n.idxArr)]
    if r is Ident { return r.identName + "[" + lit + "]" }
    if r is Member {
      const inner = memberPathKeyOf(n.idxArr)
      if inner != "" { return inner + "[" + lit + "]" }
    }
  }
  ""
}
// The narrowing-stack key of a non-identifier place — a member path (`n.v`, `n.a.b`) or an
// index place (`xs[0]`, `o.xs[0]`) — or "" when the node is neither. The union of the two
// keyers above; a place has at most one of them, so the answer is unambiguous. D1014: every
// narrow-consuming caller that takes an expression index (rather than an identifier name) asks through here instead, keeping the ident-keyed callers unchanged.
export function placeNarrowKeyOf(exprIx: i32): string {
  if exprIx < 0 || exprIx >= P.nodes.length { return "" }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Member { return memberPathKeyOf(exprIx) }
  if e is Index { return indexPathKeyOf(exprIx) }
  ""
}
// The hex value of a hex-digit code point `c` (`0-9 a-f A-F`), or -1 if not hex.
export function hexDigit(c: i32) {
  if c >= '0' && c <= '9' { return c - '0' }
  if c >= 'a' && c <= 'f' { return c - 'a' + 10 }
  if c >= 'A' && c <= 'F' { return c - 'A' + 10 }
  -1
}
// Decodes the raw string lexeme `raw` (with its surrounding quotes) into the i32 vector of
// code points it denotes, resolving escapes consistently with the lexer's `scanQuoted`. The
// first and last chars are the quote delimiters, skipped. An unknown escape keeps the char
// after the backslash verbatim; \u{...}/\xXX/\uXXXX with too few or invalid hex digits keep the marker char verbatim, matching the lexer.
export function decodeStr(raw: i32[]) {
  const out: i32[] = []
  const n = raw.length
  // Strip the surrounding quote chars (raw always has at least the two delimiters).
  let i = 1
  const last = n - 1
  while i < last {
    const c = raw[i]
    if c == '\\' && i + 1 < last {
      const e = raw[i + 1]
      if e == '\n' || e == '\r' {
        // Line continuation: a backslash immediately before a newline drops both, exactly as
        // `lexer.scanQuoted` does. This arm must stay in step with that one — a backslash-newline
        // falling through to the unknown-escape tail instead keeps the char after the backslash
        // verbatim, disagreeing with the lexer's byte count for the same literal.
        i = i + 2
        // A CRLF pair drops the `\n` too, so the sequence collapses to nothing.
        if e == '\r' && i < last && raw[i] == '\n' { i = i + 1 }
      } else if e == 'n' {
        out.push(10)
        i = i + 2
      } else if e == 't' {
        out.push(9)
        i = i + 2
      } else if e == 'r' {
        out.push(13)
        i = i + 2
      } else if e == '\\' {
        out.push(92)
        i = i + 2
      } else if e == '"' {
        out.push(34)
        i = i + 2
      } else if e == '\'' {
        out.push(39)
        i = i + 2
      } else if e == '0' {
        out.push(0)
        i = i + 2
      } else if e == 'b' {
        out.push(8)
        i = i + 2
      } else if e == 'f' {
        out.push(12)
        i = i + 2
      } else if e == 'v' {
        out.push(11)
        i = i + 2
      } else if e == 'x' {
        // `\xXX` — exactly two hex digits, else keep `x` verbatim.
        let h1 = -1
        let h2 = -1
        if i + 3 < last {
          h1 = hexDigit(raw[i + 2])
          h2 = hexDigit(raw[i + 3])
        }
        if h1 >= 0 && h2 >= 0 {
          out.push(h1 * 16 + h2)
          i = i + 4
        } else {
          out.push('x')
          i = i + 2
        }
      } else if e == 'u' {
        if i + 2 < last && raw[i + 2] == '{' {
          // `\u{…}` — 1-6 hex digits up to `}`.
          let cp = 0
          let cnt = 0
          let j = i + 3
          while j < last && raw[j] != '}' && hexDigit(raw[j]) >= 0 {
            cp = cp * 16 + hexDigit(raw[j])
            cnt = cnt + 1
            j = j + 1
          }
          if (
            j < last &&
            raw[j] == '}' &&
            cnt >= 1 &&
            cnt <= 6 &&
            cp <= 1114111
          ) {
            out.push(cp)
            i = j + 1
          } else {
            out.push('u')
            i = i + 2
          }
        } else {
          // `\uXXXX` — exactly four hex digits, else keep `u` verbatim.
          let u1 = -1
          let u2 = -1
          let u3 = -1
          let u4 = -1
          if i + 5 < last {
            u1 = hexDigit(raw[i + 2])
            u2 = hexDigit(raw[i + 3])
            u3 = hexDigit(raw[i + 4])
            u4 = hexDigit(raw[i + 5])
          }
          if u1 >= 0 && u2 >= 0 && u3 >= 0 && u4 >= 0 {
            out.push(u1 * 4096 + u2 * 256 + u3 * 16 + u4)
            i = i + 6
          } else {
            out.push('u')
            i = i + 2
          }
        }
      } else {
        // Unknown escape: keep the char after the backslash verbatim.
        out.push(e)
        i = i + 2
      }
    } else {
      out.push(c)
      i = i + 1
    }
  }
  out
}
// Copies a `string`'s code points into an `i32[]` so `decodeStr` can index past the end
// safely with arithmetic. It iterates rather than indexes: `s[i]` yields a code point in one
// string representation and a UTF-8 byte in another, while `for cp in s` yields a code point
// under both — and this compiler builds the next one, so this function must give the same answer under either representation or the self-compile fixpoint stops converging.
export function strToCps(s: string) {
  const out: i32[] = []
  for cp in s { out.push(cp) }
  out
}
// UTF-8-encodes a code-point vector into the byte vector a Stage 2c string literal is built
// from — the inverse of `strToCps` plus the decode `for cp in s` lowers to. A code point
// outside [0, 0x10FFFF] or inside the UTF-16 surrogate range D800..DFFF has no UTF-8 encoding
// and is replaced by U+FFFD rather than trapping; `emitUtf8EncFnCode` is this function transliterated into wasm and must stay in step with it.
export function cpsToUtf8(cps: i32[]) {
  const out: i32[] = []
  let i = 0
  while i < cps.length {
    let cp = cps[i]
    if cp < 0 || cp > 1114111 || (cp >= 55296 && cp <= 57343) { cp = 65533 }
    if cp < 128 {
      out.push(cp)
    } else if cp < 2048 {
      out.push(192 | (cp >> 6))
      out.push(128 | (cp & 63))
    } else if cp < 65536 {
      out.push(224 | (cp >> 12))
      out.push(128 | ((cp >> 6) & 63))
      out.push(128 | (cp & 63))
    } else {
      out.push(240 | (cp >> 18))
      out.push(128 | ((cp >> 12) & 63))
      out.push(128 | ((cp >> 6) & 63))
      out.push(128 | (cp & 63))
    }
    i = i + 1
  }
  out
}
// Peel any nested parentheses, returning the innermost wrapped expression index.
export function unwrapParen(exprIx: i32) {
  const cur = exprIx
  const node = P.nodes[cur]
  if node is Paren { return unwrapParen(node.parInner) }
  cur
}
// True when a parameter-ordered argument list failed to bind: a hole (-1, an
// unfilled parameter slot) or a length differing from the source argument
// count (a leftover named/positional arg appended past the slots).
export function directArgsBad(args: i32[], callIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    if args.length != c.callArgs.length { return true }
  }
  let i = 0
  while i < args.length {
    if args[i] < 0 { return true }
    i = i + 1
  }
  false
}
// The inferred niche-nullable name for an un-annotated function `name` — "boolean|null" or
// "string|null" (canonicalized), or "" otherwise, read from the A20 table by name rather
// than an annotation node. Do not re-spell the niche test as a whole-string equality — use
// `nameIsNulBool`/`nameIsNulString` instead; the returned strings are this function's own render and are not routed to the arena (`recordInferRet`'s name and tyIx do not agree).
export function inferNicheNullByName(name: string) {
  const im = inferRetNameOf(name)
  if nameIsNulBool(im) { return "boolean|null" }
  if nameIsNulString(im) { return "string|null" }
  ""
}
// ── the type-name depth walk: the checker's `tyTopIndexOf` is the home ──
// Do not hand-write another bracket ladder here: a quote-blind ladder miscounts depth when a
// separator sits inside a quoted literal member (`Box<"a,b" | "c" | null>`), silently
// rebuilding the annotation from the wrong split — sometimes into a module the runtime cannot parse. `sep` must not itself be a grouper; the home returns at the first hit.

// The one home for the type-name depth walk's "wraps" form: does the group opened by
// `name[0]` run to the end of `name`, with no closer bringing depth back to 0 first?
// Deliberately answers true on a group that never closes, where `tyname.parenEnclosesWhole`
// answers false for the same input — a peel and a span read a never-closing group oppositely, and both are correct for their own consumers.
export function tyGroupWrapsWhole(name: string) {
  const e = tyGroupEndIndex(name, 1)
  if e < 0 { return true }
  e == name.length - 1
}
// ── nullable struct refs (`S | null`) ──
// "S|null" / "null|S" (exactly two `|` parts, one of them `null`) → the non-null
// part's name, or "" when the name is not a two-part nullable.
export function nullablePartOf(name: string) {
  // Depth-aware: a `|` inside an inline shape (`{y:string|i32}|null`) is part of the field's
  // union, not the nullable wrapper — only a depth-0 bar splits. A `|` inside a quoted literal
  // member is part of the member's text, which the home skips.
  const bar = tyTopIndexOf(name, '|', 0, 0)
  if bar < 0 { return "" }
  const a = name.slice(0, bar)
  const b = name.slice(bar + 1, name.length)
  if a == "null" { return b }
  if b == "null" { return a }
  ""
}
// True if the annotation node at `tyIx` is `boolean|null` — the niche scalar nullable
// (host: `nullSentinel`): an i32 holding 0/1, with the spare value 2 encoding `null` (no
// box). `== null` is a sentinel compare; narrowing to non-null is purely type-level (the i32 is already 0/1 in the branch).
export function tyIsNulBool(tyIx: i32) {
  // Structural (destringify): the arena decides — a `TyNullable` over the `boolean` prim.
  // Mirrors `retNulStringFlag`, whose `nodeTyIsNulString` leg is this test's `string` sibling.
  nodeTyIsNulBool(tyIx)
}
// True if the type-annotation node at `tyIx` is `boolean`/`bool`. Structural (destringify):
// the arena decides, matching the `tyIsNulBool` sibling directly above. Uses `nodeTyPrimName`,
// not the already-imported `nodeTyWidenedRepName` — the widened form is a superset (it also
// accepts a softened litunion arm), and using a superset for this exact scalar test is unsound in general even though the two happen to agree for the literal `"boolean"` constant.
export function tyIsBool(tyIx: i32) { nodeTyPrimName(tyIx) == "boolean" }
// True if `name` is a nullable i32-backed list — `i32[] | null`, `boolean[] | null`, or a
// literal-union `K[] | null` (parser-joined `…|null`, depth-aware). `boolean[]` and a litunion
// array share the i32-list rep exactly, so all three ride the same nullable i32-list kind
// (18, `nullist`) as `i32[] | null`. A scalar-elem or ref-elem list has a distinct backing and keeps failing loudly.
export function nameIsNulI32List(name: string) {
  nameIsI32Array(nullablePartOf(name))
}
// A `string | null` field type name — the niche field (code 20): a `(ref null $sTypeIdx)`
// storage slot (the array backing a string), the field analogue of the kind-16 local.
export function nameIsNulString(name: string) {
  nullablePartOf(name) == "string"
}
// A `boolean | null` field type name — the niche field (code 21): an i32 storage slot
// holding 0/1 with the spare value 2 = `null` (the field analogue of the sentinel local).
export function nameIsNulBool(name: string) {
  const b = nullablePartOf(name)
  b == "boolean"
}
// True if `name` is a 1-D `(boolean | null)[]` list — a list of the boolean sentinel niche.
// Its backing is the same `(array (mut i32))` as `boolean[]`/`i32[]`: each element is an i32
// holding 0/1, with the spare value 2 = `null`. So it rides the i32-list machinery
// (`nameIsI32Array`), not the union-box ref-list. A nested `(boolean|null)[][]` is not this — only the single-level list.
export function nameIsNulBoolList(name: string) {
  const elem = listElemNameOf(name)
  if elem == "" { return false }
  nameIsNulBool(elem)
}
// True if `name` is a 1-D `(string | null)[]` list — a list of the string ref made nullable.
// Its backing is the same string list as `string[]`: a `string[]` element is already a
// nullable ref at the wasm level, so only construct/read differ (`null → ref.null
// $aTypeIdx`, narrowed with `!= null`). Rides the string-list machinery, not the union-box ref list; a nested `(string|null)[][]` is not this.
export function nameIsNulStrList(name: string) {
  const elem = listElemNameOf(name)
  if elem == "" { return false }
  nameIsNulString(elem)
}
// The re-quoted source lexeme for a literal-union member's inner text (`i32` -> `"i32"`) —
// matches the raw `StrLit.strText` so `internAtom` yields the same id, and feeds a synthetic
// `StrLit` for printing. Homed down here because membership ("is this default `StrLit` one of
// the niche's members?") is asked by a classifier too, and interning must agree with it by construction.
export function quoteLex(inner: string) {
  const q = "\""
  q + inner + q
}
// True if the raw `StrLit` lexeme `lex` is one of the literal-union member `texts` — the one
// membership test, keyed on the lexeme rather than the default's banked type. A member literal
// in a `??` default position is not typed `TyLit` by the checker (the join carries the type),
// so a banked-type answer says "not a member" about `"aa"` as readily as about `"zz"`.
export function litLexIsMember(lex: string, texts: string[]) {
  let i = 0
  while i < texts.length {
    if quoteLex(texts[i]) == lex { return true }
    i = i + 1
  }
  false
}
// True if `name` is a 1-D `(K | null)[]` list — a list of the literal-union atom made
// nullable via the i32 niche. Each element is an i32 holding a member id (>= 0) with the
// spare value -1 = `null`. Rides the i32-list machinery (`nameIsI32Array`), not the
// union-box ref-list: a member element lowers as its atom id, `null` as -1, and a read narrows by comparing against -1.
export function nameIsNulLitUnionList(name: string) {
  const elem = listElemNameOf(name)
  if elem == "" { return false }
  nameIsNulLitUnion(elem)
}
// A nullable literal-union type name — `K | null` / `"a" | "b" | null` (the i32 atom niche):
// member ids intern >= 0 and the spare value -1 encodes `null`. `canonEmitName` preserves the
// litunion (`nulLitUnionPreserve`) so members survive here. This is the predicate form of
// `nulLitUnionInnerName`, the primitive — the niche exists exactly when that has a non-null part to name, so the two cannot disagree.
export function nameIsNulLitUnion(name: string) { nulLitUnionScan(name) }

// The predicate, decided without building anything: `nulLitUnionInnerName` is still the
// primitive for callers that want the name, but this one only compared that result to "" —
// allocating a joined string just to test emptiness. Same scanner, same bounds, same
// top-level `=>` stop as the split; the per-member tests are the same three, in span form, with zero allocations.
function nulLitUnionScan(name: string): boolean {
  const b = nullablePartOf(name)
  if b != "" { return nameIsLitUnionType(b) }
  let lits = 0
  let hasNull = false
  let start = 0
  let going = true
  while going {
    const at = tyTopIndexOf(name, '|', '=', start)
    let end = name.length
    if at >= 0 && name[at] != '=' { end = at } else { going = false }
    if spanEqAt(name, start, end, "null") {
      hasNull = true
    } else {
      if end - start < 2 { return false }
      if name[start] != '"' { return false }
      lits = lits + 1
    }
    if going { start = at + 1 }
  }
  hasNull && lits >= 2
}
// The one home for the nullable-litunion niche: the non-null part of a nullable-litunion
// name — the litunion alias (`K` of `K | null`) or the re-joined quoted members of the
// expanded inline form (`"a" | "b"` of `"a" | "b" | null`). "" when `name` is not a nullable
// litunion — also the "no" of `nameIsNulLitUnion` above. Decided in one pass over one split: a top-level `null` member, and 2+ non-null members that are all quoted string literals.
export function nulLitUnionInnerName(name: string) {
  // Two-part `K | null`: the non-null part is a litunion alias / inline union.
  const b = nullablePartOf(name)
  if b != "" {
    if nameIsLitUnionType(b) { return b }
    return ""
  }
  // Expanded multi-member form `"a" | "b" | null`: a top-level `null` member plus an
  // all-quoted-literal remainder (2+ members, so `nullablePartOf`'s two-part split missed it).
  // The literal test rejects on the first unquoted member; reaching that reject before seeing
  // the `null` member is the same answer, since both conditions are required.
  const parts: string[] = []
  splitUnionAtoms(name, parts)
  let lits = 0
  let hasNull = false
  let out = ""
  let i = 0
  while i < parts.length {
    const p = parts[i]
    if p == "null" {
      hasNull = true
    } else {
      if p.length < 2 { return "" }
      // The quoted-leaf test at its home (`tyname.nameIsQuotedLeaf`); this site's own
      // `length < 2` bound stays in front of it.
      if !nameIsQuotedLeaf(p) { return "" }
      lits = lits + 1
      if out == "" { out = p } else { out = out + " | " + p }
    }
    i = i + 1
  }
  if !hasNull { return "" }
  if lits < 2 { return "" }
  out
}
// A nullable function-value type name — `((i32) => i32) | null` (kind 19): a `(ref null
// $cloStruct)` cell, the closure analogue of the nullable struct (kind 9). The non-null part
// must be a function type, and the whole name must not itself be a top-level function type:
// `((i32) => i32) | null` is a nullable function, while `(i32) => i32 | null` (top-level arrow) is a function returning a nullable, handled by `annRetKind` instead.
export function nameIsNulClosure(name: string) {
  if annArrowAt(name) >= 0 { return false }
  const b = nullablePartOf(name)
  if b == "" { return false }
  // The non-null part must itself be a closure — a top-level arrow once disambiguating
  // grouping parens are peeled. Merely containing a `=>` is not enough: `((i32) =>
  // boolean)[] | null` is a nullable array of closures, and misclassifying it as nulclosure
  // types the slot `(ref null $cloStruct)` while construct stores a different wrapper — invalid wasm. `nameIsFuncTypeAtom` is this exact peel-then-test, shared with `nullClosureArrElem`.
  nameIsFuncTypeAtom(b)
}
// True if the ref-list element name `name` is a closure cell — ref-list element kind 5, the
// shared closure fat-pointer. A `=>` anywhere in the name is not the question: a closure can
// sit arbitrarily deep inside a non-closure element (a struct field, map value, union member),
// and claiming those for the closure slot stores the wrong wrapper into it. Three arms, three confidences: a top-level arrow after peeling parens; a bare `{…}` span is never a closure; anything else keeps the coarse substring answer.
export function nameIsClosureElem(name: string) {
  if nameIsFuncTypeAtom(name) { return true }
  if nameIsNulClosure(name) { return true }
  if nameIsBraceSpanEnds(name) { return false }
  strContains(name, "=>")
}
// 1 if the type-annotation node at `tyIx` is a nullable function `(fn) | null`, else 0 — the
// closure dual of `retNulRefFlag`. Purely structural, like its nullable-niche siblings
// (`retNulListFlag`, `retNulStringFlag`, `nameIsClosureArrayTy`, `tyIsNulBool`): the `Ty`
// arena is the only source, and a node the arena does not cover answers 0 rather than falling back to a re-parse of the node's synthetic name.
export function nulCloFlag(tyIx: i32) {
  if nodeTyIsNulClosure(tyIx) { return 1 }
  0
}
// The scalar type name for classifying annotation node `tyIx`, read structurally from the
// checker's `Ty` arena (`nodeTyPrimName`) when it recorded a type for the node, else falling
// back to the parser's synthetic annotation name (`tyNameOf`). Byte-identical to the pure-name
// form for a scalar, but reads the checked type where available; the name fallback shrinks as more annotation-resolution sites populate `nodeTyIx`.
function nodeScalarName(tyIx: i32) {
  // `nodeTyWidenedRepName` (not raw `nodeTyPrimName`) lets a single literal / homogeneous
  // numeric literal union widen to its base scalar name here too, so `retI64Flag`/`retF64Flag`/
  // `retF32Flag` fire for an annotated `: 1.5`/`: 7` param or return. It is a superset of
  // `nodeTyPrimName` for prims; the extra "string" for a string literal matches none of the numeric/bool flags.
  if nodeTyIxOf(tyIx) >= 0 { return nodeTyWidenedRepName(tyIx) }
  ""
}
// The array element-rep name for classifying annotation node `tyIx` — structural from the `Ty`
// arena (`nodeTyArrayElemRepName`) where the checker recorded a type, else derived from the
// synthetic name for a node it did not record. Byte-identical to the per-classifier `nameIsX[]`
// tests; the name fallback shrinks as coverage widens.
function arrElemRep(tyIx: i32) {
  if nodeTyIxOf(tyIx) >= 0 { return nodeTyArrayElemRepName(tyIx) }
  ""
}
// 1 if the type-annotation node at `tyIx` is `i32[] | null`, else 0 — the nullable-list dual
// of `retNulRefFlag`. Feeds vt kind 15 (nullable `(ref null $lTypeIdx)`): narrowing is
// type-level only, the slot stays nullable and each list-op read site recovers non-null,
// mirroring the host's lowering (`tests/cases/types/nullable-list-index.vl`).
export function retNulListFlag(tyIx: i32) {
  if nodeTyIsNulI32List(tyIx) { return 1 }
  0
}
// 1 if the type-annotation node at `tyIx` is the i32 array type (`i32[]`), else 0. The
// functype/local valtype layer multiplexes struct/array/i32 through one `kind` code, so this
// flat flag feeds the `kind == 2` (array) branch of `pushVT`. A ref array (`S[]`/`N[]`) is not this — it feeds `kind == 5` via `retRefArrFlag`.
export function retArrFlag(tyIx: i32) {
  if arrElemRep(tyIx) == "i32" { return 1 }
  0
}
// 1 if the type-annotation node at `tyIx` is `string`, else 0. A string is currently the
// same `(array (mut i32))` of code points an array uses, so it feeds the `kind == 3` branch of `pushVT` (the identical array ref valtype).
export function retStrFlag(tyIx: i32) {
  // An aliased literal-union return (`type K = "a" | "b"`; `pick(): K`) reps as an i32 atom —
  // `vtKindOfType` derives its functype result i32, so its "str" return kind must agree.
  // `nodeTyWidenedRepName` renders every litunion as "string", which would route a caller's
  // atom return through the string-ref path — invalid wasm. An inline litunion at the annotation does rep as a string ref and must stay flagged; the guard is alias-only.
  if nodeTyIsLitUnionAlias(tyIx) { return 0 }
  if nodeTyWidenedRepName(tyIx) == "string" { return 1 }
  0
}
// 1 if the type-annotation node at `tyIx` is `boolean`/`bool`, else 0. A bool rides in an
// i32 at the wasm level — this feeds only the `print` import choice (`fRetBool`), never a valtype.
export function retBoolFlag(tyIx: i32) {
  if nodeScalarName(tyIx) == "boolean" { return 1 }
  0
}
// 1 if the type-annotation node at `tyIx` is `void`, else 0. Seeds `fRetVoid` in
// `buildFnMap`, so a declared `: void` function gets the 0-result functype and the void
// tail/return lowering, matching what an inferred-void function earns from `computeVoidFns`.
// Arena-first; the name fallback covers synthesized `void` TypeRefs (`synthRetAnnots`, `synthVoidTwins`) that carry no arena record.
export function retVoidAnnFlag(tyIx: i32) {
  if tyIx < 0 { return 0 }
  if nodeTyPrimName(tyIx) == "void" { return 1 }
  if tyNameOf(tyIx) == "void" { return 1 }
  0
}
// 1 if the type-annotation node at `tyIx` is a `string | null` — the nullable string ref
// `(ref null $sTypeIdx)`, kind 16. A `string` is the raw i32 array `(ref $sTypeIdx)`; the
// nullable form is the same backing made nullable (`null` is `ref.null`, `!= null` is
// `ref.is_null`). Checked in `vtKindOfType` before the bare `string` (kind 3).
export function retNulStringFlag(tyIx: i32) {
  if nodeTyIsNulString(tyIx) { return 1 }
  0
}
// Structural (destringify): the annotation node at `tyIx` is an array whose element is a
// nullable closure — a `TyArray` over a `TyNullable` over a `TyFunc`. The arena dual of
// `nullClosureArrElem(tyNameOf(tyIx)) != ""`, which answers by string surgery instead;
// `nodeTyIsClosureArray` covers only the bare-closure element, so this is that classifier's nullable-element arm.
function tyIsNulClosureArrayNode(tyIx: i32) {
  const ty = nodeTyIxOf(tyIx)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyArray {
    const e = t.aElem
    if e >= 0 {
      const et = T.tys[e]
      if et is TyNullable {
        const inner = T.tys[et.nInner]
        if inner is TyFunc { return true }
      }
    }
  }
  false
}
// 1 if the type-annotation node at `tyIx` is an array of functions (`((i32) => i32)[]`),
// else 0 — the closure-element ref-list guard `vtKindOfType` checks before the kind-14
// function-type test.
export function nameIsClosureArrayTy(tyIx: i32) {
  if nodeTyIsClosureArray(tyIx) { return 1 }
  // A nullable-closure-element array (`(((i32) => boolean) | null)[]`, kind-5 niche):
  // `nodeTyIsClosureArray` has no nullable-element arm, so the same arena spine answers it
  // here — a `TyArray` over a `TyNullable` over a `TyFunc` — replacing the `nullClosureArrElem`
  // string surgery over the rendered name.
  if tyIsNulClosureArrayNode(tyIx) { return 1 }
  0
}
// 1 if the type-annotation node at `tyIx` is an `f64[]` (the f64-element list), else 0.
// Feeds the `kind == 12` (f64-list wrapper) branch of `fbValtype`/`pushVT`. Checked before
// the `retRefArrFlag`/`retArrFlag` cases since `f64[]` is an `[]` array name but is neither a struct/union ref list nor the i32 list.
export function retF64ArrFlag(tyIx: i32) {
  if arrElemRep(tyIx) == "f64" { return 1 }
  0
}
export function retF32ArrFlag(tyIx: i32) {
  if arrElemRep(tyIx) == "f32" { return 1 }
  0
}
// `1` if the type-annotation node at `tyIx` is `i64[]` — the i64-list rep (kind 20).
export function retI64ArrFlag(tyIx: i32) {
  if arrElemRep(tyIx) == "i64" { return 1 }
  0
}
// `1` if the type-annotation node at `tyIx` is `i64`, else `0`. A scalar i64
// param/result/local/global classifies as kind 10 (valtype `0x7e`); checked LAST
// (after every ref/array case) since `i64` is a plain TypeRef name like `i32`.
export function retI64Flag(tyIx: i32) {
  if nodeScalarName(tyIx) == "i64" { return 1 }
  0
}
// 1 if the type-annotation node at `tyIx` is `f64`, else 0. A scalar f64 param/result/
// local/global classifies as kind 11 (valtype `0x7c`); checked last (after every ref/array case) since `f64` is a plain `TypeRef` name like `i32`.
export function retF64Flag(tyIx: i32) {
  if nodeScalarName(tyIx) == "f64" { return 1 }
  0
}
// 1 if the type-annotation node at `tyIx` is `f32`, else 0. A scalar f32 param/result/
// local/global classifies as kind 13 (valtype `0x7d`); checked last (alongside `retI64Flag`/`retF64Flag`) since `f32` is a plain `TypeRef` name like `i32`.
export function retF32Flag(tyIx: i32) {
  if nodeScalarName(tyIx) == "f32" { return 1 }
  0
}
// `1` if the type-annotation node at `tyIx` is a `string[]` (string-ref list), else `0`.
// Feeds the `kind == 7` (string-list wrapper) branch of `pushVT`. Checked BEFORE the
// `retRefArrFlag`/`retArrFlag` cases since `string[]` is an `[]` array name but is NOT a
// struct/union ref list nor the i32 list — it is the dedicated string-ref list.
export function retStrArrFlag(tyIx: i32) {
  if arrElemRep(tyIx) == "string" { return 1 }
  0
}
// The `array.new_fixed` operand cap engines enforce (V8/binaryen/wasmtime reject more than
// 10,000 operands). A literal longer than this cannot lower as one `array.new_fixed`: in a
// function body it builds chunked (`array.new_default` plus per-chunk `array.new_fixed`/
// `array.copy`), and a global initializer holding one routes through the start function instead (a wasm constant expression has no locals to chunk through).
export const NEW_FIXED_MAX = 10000
// Whether the initializer expression at `exprIx` is a valid WasmGC constant expression — the
// forms `emitProgram` lowers inline in the global section. Const: literals, an `ArrayLit`/
// `ObjLit` whose parts are all const, and a `Paren` wrapping one; a literal past the operand
// cap is not (it needs locals to chunk through). Conservative by construction: an unrecognized node falls through to `false`, routed through the start function instead of an invalid constexpr.
export function isConstInit(exprIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is NumLit { return true }
  if e is CharLit { return true }
  if e is BoolLit { return true }
  if e is StrLit { return e.strText.length <= NEW_FIXED_MAX + 2 }
  if e is Paren { return isConstInit(e.parInner) }
  if e is ArrayLit {
    if e.arrElems.length > NEW_FIXED_MAX { return false }
    let i = 0
    while i < e.arrElems.length {
      if !isConstInit(e.arrElems[i]) { return false }
      i = i + 1
    }
    return true
  }
  if e is ObjLit {
    let i = 0
    while i < e.objFields.length {
      const f = P.nodes[e.objFields[i]]
      if f is FieldInit {
        if !isConstInit(f.fiValue) { return false }
      } else {
        return false
      }
      i = i + 1
    }
    return true
  }
  false
}
// ── the array-name grammar: `nameIsArray` tests it, `arrElemNameRaw` cuts it ──
// Both homes are in `tyname.vl` (D-ARRDOWN); this file only layers over them (`typecheck.vl`
// cannot import this one). `nameIsElemArray` is `nameIsArray` minus the degenerate `"[]"`, agreeing with `arrElemNameRaw(name) != ""` by construction — a layer, not a copy, since routing through the cut would allocate a slice to answer a boolean in inner loops.
export function nameIsElemArray(name: string) {
  if name.length < 3 { return false }
  nameIsArray(name)
}
// The one home for the array-dimension peel: `name` with every trailing `[]` pair removed. A
// non-array name is its own leaf (never ""), matching what every hand-written copy did. It is
// the cut home applied to fixpoint, not a second copy: the loop calls `arrElemNameRaw` and
// advances only while that yields a non-empty element, so the degenerate `"[]"` terminates the peel.
export function arrLeafNameOf(name: string) {
  let leaf = name
  let done = false
  while !done {
    const nx = arrElemNameRaw(leaf)
    if nx == "" { done = true } else { leaf = nx }
  }
  leaf
}
// ── the paren grammar and scalar-array classifiers, homed in `tyname.vl` ──
// The two paren walks are not one: `peelGroupParens` rides `parenEnclosesWhole`, `normTypeAtom`
// rides `tyGroupWrapsWhole`, and they differ on a group that never closes (false vs. true) — a
// site spelling the comparison out instead of calling one of the two merges that silently.
export function nameIsI32Array(name: string) {
  // The two i32-backed leaf spellings share one cut — `nameIsI32Array`'s own header explains the family.
  if arrElemIs(name, "i32") || arrElemIs(name, "boolean") { return true }
  // `(boolean | null)[]` shares the exact i32-list backing: each element is an i32 0/1
  // with the spare value 2 = `null` (the sentinel niche). Only the `null → 2` element
  // coercion + the sentinel-aware read/print differ (see `nameIsNulBoolList`).
  if nameIsNulBoolList(name) { return true }
  // A literal-union array (`K[]`, or an inline `("a"|"b")[]`) — its elements are interned-i32
  // ATOMS, so it shares the i32 backing/rep EXACTLY like `i32[]`. (Element construction seeds
  // `pendingLitUnion` so the member literals lower as their ids; reads yield the atom.)
  if nameIsLitUnionArray(name) { return true }
  // A `(K | null)[]` shares the exact i32-list backing: each element is an i32 member id (≥ 0)
  // with the spare value `-1` = `null` (the atom-niche analogue of `(boolean | null)[]`). Only the
  // `null → -1` element coercion + the sentinel-aware read differ (see `nameIsNulLitUnionList`).
  if nameIsNulLitUnionList(name) { return true }
  false
}
// True if `name` is `<litunion>[]` — an array whose element type is a literal union. The element
// name is `name` minus the trailing `[]` (a parenthesized inline union keeps its parens, which
// `nameIsLitUnionType` -> `nameIsInlineLitUnion` tolerates via the union split).
export function nameIsLitUnionArray(name: string) {
  const elem = listElemNameOf(name)
  if elem == "" { return false }
  nameIsLitUnionType(elem)
}
// True if `name` is a 2-D array whose element is an i32-backed scalar list — `i32[][]`,
// `boolean[][]`, or a literal-union `K[][]`. All three share the `i32[][]` rep exactly: the
// element is the i32-list wrapper (ref-list element kind 4), since `i32[]`, `boolean[]` and a
// litunion `K[]` share one i32[] backing (`nameIsI32Array`). A deeper `i32[][][]` is not this — only a single i32-backed leaf list qualifies.
export function nameIsI32ListArray(name: string) {
  // The element must itself be a list for any arm of `nameIsI32Array` to fire, so `name` must
  // be `X[][]` — four character reads, no cut. The two cheap arms are asked in place
  // (`arrElemIsArrayOf`); anything that passes the guard and fails both falls through to the
  // full predicate rather than re-deriving it, so a partial reimplementation here cannot drift from the source of truth.
  if !nameIsArray(name) { return false }
  const to = name.length - 2
  if to < 2 { return false }
  if name[to - 2] != '[' { return false }
  if name[to - 1] != ']' { return false }
  if arrElemIsArrayOf(name, "i32") { return true }
  if arrElemIsArrayOf(name, "boolean") { return true }
  nameIsI32Array(arrElemNameRaw(name))
}
// True if `name` is a string-keyed map — the synthetic name `parseType` builds for an index
// signature; the lowering assumes string keys. Distinct from `nameIsMapOpen` (`tyname.vl`):
// that one also accepts a list-of-maps (`{[string]:i32}[]`), so a caller asking "does this
// name START a map" — a union arm that must not fall into the map-value recursion — wants the opener, not this one.
export function nameIsMap(name: string) {
  // The map-name opener at its home, carrying its own `length >= 2` bound (this spelled the
  // same two character compares out inline behind the same bound).
  if !nameIsMapOpen(name) { return false }
  // A trailing `[]` makes it a LIST of maps, not a bare map — the array-name grammar's
  // TEST half, at its home. (This spelled the same two character compares out inline; at
  // length >= 2 the two readings accept exactly the same names.)
  !nameIsArray(name)
}
// True if `name` is a union whose first atom is a map (`{[string]: V} | …`) — a name that both
// starts with `{[` (matching `nameIsMap`) and has 2+ top-level atoms. Such a name is a variant
// box, not a bare map, and must not be classified as a map local/return/value/field/list
// element. A bare map has one top-level atom (a union-valued map's inner `|` sits inside the braces).
export function nameIsMapMemberUnion(name: string) {
  if !nameIsMap(name) { return false }
  // Count, don't materialize: this built the whole atom array and read only its length.
  // `unionMemberCount` is that query without allocating the strings, sharing the top-level
  // `=>` rule that keeps `(i32) => i32 | string` one member.
  unionMemberCount(name) >= 2
}
// True if the map atom `mapAtom` (`{[string]: V}`) is boxable as a union arm — always. A map
// arm boxes as its value-kind map struct riding the box anyref, tagged via `mapSlotTag`, for
// every value kind. Both the box side and the narrowed read key the same mv slot off the same
// arm atom (`mapValNameOf`), so an unrepresentable value type (`mvValKindOfName == -3`) fails `emitUnionCoerce`'s gate and the arm stays a loud reject, never invalid wasm.
function mapArmValueBoxable(_mapAtom: string) { true }
// True if `name` is a bare map (`{[string]: V}`) — `nameIsMap(name) && !nameIsMapMemberUnion(name)`,
// named once for callers that hold a string with no type node (an atom peeled from a union,
// `nameIsMapArray`'s element). A node-holding caller asks the arena instead
// (`typecheck.nodeTyIsMap`, D-BAREMAP) — `true` for a bare map, `false` for a `TyUnion` with a map arm.
export function nameIsBareMap(name: string) {
  nameIsMap(name) && !nameIsMapMemberUnion(name)
}
// The one home of the emitter's key question: does the map spelling `name` carry an i32 key
// (`{[i32]: V}`)? Reads the map-name grammar's key cut at its home (`mapSpellKeyName`,
// `tyname.vl`), which deliberately does not require the closing `}` — so a list of i32-keyed
// maps or a nullable one also answer true here, matching the checker's unsupported-key diagnostic.
export function nameIsI32KeyedMap(name: string) {
  mapSpellKeyName(name) == "i32"
}
// Folds a map shape to the flavor-blind twin every op that does not care about set-ness wants:
// the set sentinel to its map sibling (-2 → -1 string-keyed, -5 → -4 i32-keyed) and the
// unsupported sentinel to the mono map. The key half of the vocabulary survives the fold —
// that is the whole point of the two disjoint pairs.
export function mapShapeFoldSet(sh: i32) {
  if sh == -2 { return -1 }
  if sh == -3 { return -1 }
  if sh == -5 { return -4 }
  sh
}
// True if the type-annotation node at `tyIx` is a nullable bare map (`{[string]: V} | null`) —
// the arena dual of `nulMapInnerName` on the node's rendering, and the nullable twin of
// `nodeTyIsMap`. A `TyNullable` over a `TyMap`: the `| null` peel and the bare-map test the
// name pair spells as two scans are one walk down two variant tags, with no union split and no substring.
export function tyIsNulBareMap(tyIx: i32) {
  const ty = nodeTyIxOf(tyIx)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    if t.nInner < 0 { return false }
    const it = T.tys[t.nInner]
    return it is TyMap
  }
  false
}
// True if the array type-name `name` is a string-keyed-MAP list `{[string]:i32}[]` —
// a ref list whose ELEMENT is the map struct (`mStructIdx`). It is a `nameIsMap` name
// with a trailing `[]`. The scope chain (`typecheck.vl`'s `scopes: {[string]:i32}[]`)
// is exactly this. Routed through the ref-list machinery as element-kind `3`.
export function nameIsMapArray(name: string) {
  // The bare element (without the trailing `[]`) must be a bare map name, not a map-member union
  // (`({[string]: i32} | boolean)[]` also starts with `{[`) — that is a union-box ref list (kind
  // 2), not a list-of-maps (kind 3). The cut stays raw (`arrElemNameRaw`, not `listElemNameOf`)
  // deliberately: unreached is not the same claim as licensed. Asked in place rather than cut out first, since slicing would allocate on every call.
  if !nameIsArray(name) { return false }
  const to = name.length - 2
  if to == 0 { return false }
  if !nameIsMapSpan(name, 0, to) { return false }
  unionMemberCountSpan(name, 0, to) < 2
}
// True if `name` is an array of functions — `((i32) => i32)[]`: a trailing `[]` whose element
// is a fully-parenthesized function type with the arrow nested (depth > 0). A top-level arrow
// (`(i32) => i32[]`) is a function returning a list, not an array of functions — excluded via
// `annArrowAt`. The element heap type is the shared closure fat-pointer struct; ref-list element kind 5.
export function nameIsClosureArray(name: string) {
  const n = name.length
  if n < 4 { return false }
  // The array-name grammar at its two homes. The TEST stays in front of the `annArrowAt`
  // walk exactly as the inline compares did — running that walk on a non-array name would
  // be a work regression — and the CUT stays behind it, so no name pays for a slice it is
  // about to be rejected for.
  if !nameIsArray(name) { return false }
  if annArrowAt(name) >= 0 { return false }
  const elem = arrElemNameRaw(name)
  // The PAREN grammar's OPEN half at its home. The separate `elem.length < 1` reject this
  // replaced is the home's own bound, so the empty element still declines before the
  // `nameIsFuncTypeAtom` walk below rather than indexing out of bounds.
  if !nameIsParenOpen(elem) { return false }
  // The element must be a genuine function type — a top-level arrow (paren-aware, after
  // peeling grouping parens). A bare `=>` substring test also matches a union whose first
  // member is a closure (`(() => i64) | i64`, arrow nested inside the first member),
  // mis-typing it as a closure ref list — a raw slot the boxed value could not store (invalid wasm).
  nameIsFuncTypeAtom(elem)
}
// The non-null function-type atom of a nullable-closure array element
// (`(((i32) => boolean) | null)[]` → `((i32) => boolean)`), or "". A `<closure> | null`
// element is a nullable niche over the shared closure fat-pointer, not a union box — so such
// an array is a closure ref list (kind 5) whose slot keys the full `"<closure> | null"` name, and the index read stays nullable for the `e != null` narrow.
export function nullClosureArrElem(name: string) {
  const elem = parenUnionArrElemName(name)
  if elem == "" { return "" }
  const nn = nullablePartOf(elem)
  if nn == "" { return "" }
  if nameIsFuncTypeAtom(nn) { return nn }
  ""
}
// The element function-type atom of a closure-array name, plain or nullable-element:
// `((i32) => R)[]` → `(i32) => R`, `(((i32) => R) | null)[]` → `((i32) => R)`, else "". Tries
// the nullable-element form first (its element keeps the `| null` grouping parens, so the
// plain test declines it), then the plain form's `[]` peel — the two are disjoint, so order does not matter.
export function cloArrElemNameOf(name: string) {
  const nul = nullClosureArrElem(name)
  if nul != "" { return nul }
  if nameIsClosureArray(name) { return arrElemNameRaw(name) }
  ""
}
// The VALUE-union element name of a parenthesized union-array annotation:
// `(string|i32)[]` → `string|i32` (`canonEmitName` keeps a union element's
// grouping parens), or "" when `name` is not a value-union array name.
// Registration-independent (classifies from the atom set, not `unNames`).
export function parenUnionArrElemName(name: string) {
  if name.length < 5 { return "" }
  // A top-level arrow makes this a function type returning an array
  // (`(i32) => (string | {w: i32})[]`), not a value-union array. Without this guard, the
  // `name[0]=='('`/`name[len-3]==')'` checks below would match the closure's outer parens,
  // mis-typing the whole closure local as a union-box ref list.
  if annArrowAt(name) >= 0 { return "" }
  // The array-name grammar's TEST half, at its home (this spelled the same two character
  // compares out inline; `name.length >= 5` is already established above).
  if !nameIsArray(name) { return "" }
  // The paren grammar's span, asked of the element rather than the whole name.
  // `arrElemNameRaw(name)` is `name` minus exactly its final two characters (established one
  // line above via `nameIsArray`), so this pair is `nameIsParenSpanEnds(elem)` character for
  // character on every input, and the home's own `length >= 1` bound is covered by `name.length >= 5`.
  if !nameIsParenSpanEnds(arrElemNameRaw(name)) { return "" }
  // The whole name must be ONE atom — a multi-arm union that merely STARTS with a paren
  // group and ENDS with `[]` (`(boolean|string)[] | (i32|f64)[]`) would otherwise slice an
  // UNBALANCED "inner" (`boolean|string)[]|(i32|f64`) and mis-classify the whole union as
  // a single union-array, derailing its registration.
  if unionMemberCount(name) > 1 { return "" }
  const inner = name.slice(1, name.length - 3)
  // A `(boolean | null)[]` element is the i32 sentinel niche, not a box: it reps as a plain i32
  // list (`nameIsI32Array`), so it must not read as a union-box ref-array element here. Returns
  // "" so `nameIsRefArray`/`refArrElemKind` skip it and land on the i32-list path (scalar
  // `boolean | null` is likewise a niche, excluded by `isValueUnionName` already).
  if nameIsNulBool(inner) { return "" }
  // A `(string | null)[]` element is the string ref niche (a `(ref null $sTypeIdx)` string), not a
  // box: it reps as a plain string list (`nameIsNulStrList`), so it must NOT read as a union-box
  // ref-array element here. Return "" so `nameIsRefArray` / `refArrElemKind` skip it and it lands on
  // the string-list path. (Scalar `string | null` is likewise a niche, not a value union.)
  if nameIsNulString(inner) { return "" }
  // A `(K | null)[]` element is the litunion atom NICHE (an i32 member id with `-1` = `null`), not a
  // box: it reps as a plain i32 list (`nameIsNulLitUnionList` → `nameIsI32Array`), so it must NOT read
  // as a union-box ref-array element here. Return "" so `nameIsRefArray` / `refArrElemKind` skip it
  // and it lands on the i32-list path. (Scalar `K | null` is likewise a niche, not a value union.)
  if nameIsNulLitUnion(inner) { return "" }
  if isValueUnionName(inner) { return inner }
  // A struct / heterogeneous union element (`(C | S)[]`, `(A | i32)[]`): the parens are
  // annotation grouping only, and the element slots hold the same `{tag, payload}` boxes a
  // value-union element does (element kind 2, heap `uBoxIdx`). A top-level `|` in a type position
  // is always a union, distinguishing it from a parenthesized non-union element (`((i32) => i32)[]`).
  if unionMemberCount(inner) > 1 { return inner }
  ""
}

// True if the type-name `name` is exactly `string`. A VL string is currently an `array i32`
// of code points (`docs/strings-design.md`), so it shares the array heap type — string use
// also sets `aUsed` and string valtypes reuse the array ref. (`string[]` is not this — it ends
// in `[]`, so `nameIsArray` catches it first.)
export function nameIsString(name: string) { name == "string" }
// True if the type-name `name` is exactly `string[]` — a growable list whose elements
// are string refs. It reuses the map keys list types (the `{backing,len,cap}` wrapper
// over a `(ref null $sTypeIdx)` string backing); field code `6`.
export function nameIsStringArray(name: string) {
  // Element-name compare over the array grammar's one cut — see the family note at
  // `nameIsI32Array`.
  if arrElemIs(name, "string") { return true }
  // `(string | null)[]` shares the exact string-list backing (`$mkListIdx` wrapper, `(ref null
  // $sTypeIdx)` string backing — a `string[]` element is already a nullable ref). It rides the
  // string-list machinery uniformly; only the element read diverges (kept `(ref null)`,
  // intercepted by `exprNulStrArray`) and a `null` element/push/assign lowers as `ref.null`.
  nameIsNulStrList(name)
}
// True if the type-name `name` is exactly `f64[]` — a growable list whose elements are
// scalar f64. Its backing is `(array (mut f64))` (`fa64TypeIdx`); its wrapper is the
// `{backing,len,cap}` triple over that f64 backing (`fl64TypeIdx`). Distinct from `i32[]` so element reads/writes use the f64 element store.
export function nameIsF64Array(name: string) { arrElemIs(name, "f64") }
export function nameIsF32Array(name: string) { arrElemIs(name, "f32") }
// The PACKED sibling: a `u8[]` annotation (backing `ba8TypeIdx` — `(array (mut i8))`,
// one byte per element — wrapper `bl8TypeIdx`). `u8` is a STORAGE type and this is the
// only spelling it appears in; the checker admits it nowhere else, so a name reaching
// here with a `u8` element is always this list and never a scalar `u8` anything.
export function nameIsU8Array(name: string) { arrElemIs(name, "u8") }
// The i64 sibling of `nameIsF64Array`: an `i64[]` annotation (backing `ia64TypeIdx`,
// wrapper `il64TypeIdx` — the i64 element store).
export function nameIsI64Array(name: string) { arrElemIs(name, "i64") }
// True if the node at `ix` is a struct `type` declaration (a single-level narrowing
// helper, so callers avoid an inline `is TypeDecl` on the wide `Node` union).
export function nodeIsTypeDecl(ix: i32) {
  const s = P.nodes[ix]
  if s is TypeDecl { return true }
  false
}
// True if `name` is the name of a `FuncDecl` anywhere in the arena. Used at `collectS` time,
// before `buildFnMap` populates `fnNames`, to classify an anon-struct field whose value is a
// bare function name — including one declared after the literal. An incremental fold of a
// whole-arena scan, sound because the arena is append-only: a node's verdict never changes once folded, except the one in-place rename `noteFuncName` records.
export function nameNamesFunction(name: string) {
  if name == "" { return false }
  if nnfScanned > P.nodes.length {
    nnfSet = Map()
    nnfScanned = 0
  }
  while nnfScanned < P.nodes.length {
    const n = P.nodes[nnfScanned]
    if n is FuncDecl {
      if n.fnName != "" { nnfSet[n.fnName] = true }
    }
    nnfScanned = nnfScanned + 1
  }
  nnfSet[name] ?? false
}
// ── the shape-name grammar: the opener and the wide span are both one module down ──
// `nameIsShapeOpen`/`nameIsBraceSpanEnds` live in `tyname.vl`; this file republishes both and
// keeps only their conjunction (brace-span, not a map's second-char `[`). Not
// `emit_classify.nameIsWholeSpanShape`, which adds a depth walk proving the group is still open at the last character — endpoints alone answer true for `{a:{b:i32}}|{c:i32}` where that walk answers false.
export function nameIsShapeSpanEnds(name: string) {
  if !nameIsBraceSpanEnds(name) { return false }
  nameIsShapeOpen(name)
}
// The inline-shape synthetic name of a struct-alias union decl — a `UnionDecl` whose distinct
// variants are exactly one inline object shape (`{a:i32,b:i32}`, not a map), or "". Distinct,
// not `length == 1` (D446): `parseTypeDecl` dedups nothing, so `{a} | {a}` reads arity 2 and
// is unreachable here — `collectU` claims it instead, and the two reps meet at a store as check-clean invalid wasm. Spelling-distinct, deliberately not type-distinct.
export function unionStructAliasShape(variants: string[]) {
  const first = unionSoleDistinctVariant(variants)
  if first != "" {
    if nameIsShapeSpanEnds(first) { return first }
  }
  ""
}

// The ONE spelling every variant of `variants` shares, or "" when they are not all one
// spelling (or there are none). Split from the caller so the arity rule reads as the
// distinctness question it is, and so the empty list keeps answering "" rather than
// falling into the single-arm arm.
function unionSoleDistinctVariant(variants: string[]) {
  if variants.length == 0 { return "" }
  const v = variants[0]
  let i = 1
  while i < variants.length {
    if variants[i] != v { return "" }
    i = i + 1
  }
  v
}
// `gaeLtAt`/`annGenAppSpanEnds` are homed one module down, in `typecheck.vl`, and republished
// at the top of this file. `gaeSplitArgs` stays: it is a named reading of `tyTopLevelSplit`
// (`sep = ','`, `dropEmpty = true`) for the generic-argument grammar — splits a type-argument
// list at its top-level commas, dropping empty parts (a tolerated trailing comma).
export function gaeSplitArgs(s: string, out: string[]) {
  tyTopLevelSplit(s, ',', true, out)
}
// True when a declared type-parameter name binds nothing because a builtin type spelling wins
// it: `type Box<i32> = { v: i32 }` has no parameter, only a field of type `i32`. This is the
// checker's leaf-resolution order read as a predicate (`primTyOfName` first, the live parameter
// second, the declared registry third): substituting at a primitive-named parameter would hand the emitter a field type the checker never agreed to. The bound is `primTyOfName`'s accept set, not `genTyParamArr`'s.
export function gaeParamShadowed(name: string) {
  if name == "void" { return true }
  valueAtomKind(name) >= 0
}
// The live parameter slots of a generic alias: the declared names that actually bind, paired
// with the application arguments binding them. A primitive-spelled name binds nothing
// (`gaeParamShadowed`), so it is dropped from both lists together before substitution sees it.
// Filtered here rather than inside the shared `monoSubstAnn` walk, since that walk's FuncDecl half has its own, different shadow rule.
function gaeLiveParams(
  pnames: string[],
  args: string[],
  outP: string[],
  outA: string[],
) {
  let i = 0
  while i < pnames.length {
    if !gaeParamShadowed(pnames[i]) {
      outP.push(pnames[i])
      outA.push(args[i])
    }
    i = i + 1
  }
  0
}
// Would the substitution below change this field's type name — does the annotation reach a
// live type parameter anywhere in its structure? Published so the one other caller
// (`emit_collect.gaeDeclFieldTyName`) asks this instead of re-deriving it: two copies of this
// question would be two answers. It replaces a gate that read only the array grammar, so a parameter behind any other constructor (`Id | null`, `{a: Id}`) would otherwise report no substitution and intern the alias's body type instead of the bound argument.
export function gaeAnnHasParam(tn: string, pnames: string[]) {
  const lp: string[] = []
  const la: string[] = []
  gaeLiveParams(pnames, pnames, lp, la)
  monoAnnHasTyParam(arrLeafNameOf(tn), lp)
}
// Substitutes a declared type-parameter name in a field's type name with the application's
// argument name, through the type's structure (`T` → `i32`, `{a: T}` → `{a: i32}`) — via the
// shared `monoSubstAnn` walk, not a hand-rolled ladder (a missed rung interns the alias's body
// type instead of the argument). Not an optimisation: an annotation reaching no live parameter must return verbatim, or a one-character spelling drift becomes a second intern key for one type.
export function gaeApplyFieldTy(tn: string, pnames: string[], args: string[]) {
  const lp: string[] = []
  const la: string[] = []
  gaeLiveParams(pnames, args, lp, la)
  const leaf = arrLeafNameOf(tn)
  if !monoAnnHasTyParam(leaf, lp) { return tn }
  const s = monoSubstAnn(leaf, lp, lp, la)
  // "" is `monoSubstAnn`'s UNBOUND answer, which cannot arise here — every name in `lp`
  // is bound by construction — so this and the unchanged-leaf test are the
  // un-substitutable fallbacks, not cases.
  if s == "" { return tn }
  if s == leaf { return tn }
  s + tn.slice(leaf.length, tn.length)
}
// Lexicographic `a < b` over two strings by code point (VL has no `<` on `string`).
// Compares char-by-char: at the first differing position the smaller code point wins;
// if one is a prefix of the other, the shorter is smaller. Equal strings are NOT `<`.
export function strLess(a: string, b: string) {
  let i = 0
  const na = a.length
  const nb = b.length
  while i < na && i < nb {
    const ca = a[i]
    const cb = b[i]
    if ca < cb { return true }
    if ca > cb { return false }
    i = i + 1
  }
  na < nb
}
// True if union `name` has at least one NON-null value-atom member (`i32`/`f64`/
// `boolean`/`string`/…) — true for a pure value union AND a MIXED struct+scalar union,
// false for an all-struct union. Gates the scalar value-boxing in `emitUnionCoerce`.
export function unionHasValueAtom(name: string) {
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  let i = 0
  while i < atoms.length {
    const k = valueAtomKind(atoms[i])
    if k >= 0 && k != 6 { return true }
    // A litunion-alias atom (`K0 | {w: i32}`) rides the box as its member-string atom (the `K0 |
    // i64` value-union rule) — it is value-boxable, and the coerce ladder below already resolves
    // the alias arm for a string carrier. Without this, an alias plus an all-struct union (no
    // scalar sibling) took the all-struct raw pass-through, returning the raw member string — invalid wasm.
    if nameIsLitUnionType(atoms[i]) { return true }
    i = i + 1
  }
  false
}
// True if union `name` has a member the box carries as a string ref — a literal-union arm
// (riding the box as its member string) or a plain `string` arm (D-ATOMSTORE). Two exclusions,
// neither a box: a pure literal union (`K`, `"a"|"b"`) is the interned i32 atom, and `K | null`
// is the atom niche (an i32 with -1 for null) — widening either's store to a string ref would put a `(ref $array)` in an i32 cell.
export function unionTakesAtomAsStr(name: string) {
  if nameIsLitUnionType(name) { return false }
  if nameIsNulLitUnion(name) { return false }
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  let i = 0
  while i < atoms.length {
    if nameIsLitUnionType(atoms[i]) { return true }
    if atoms[i] == "string" { return true }
    i = i + 1
  }
  false
}
// How many arms of the value union `name` ride the box as a string ref — a plain `string` arm,
// and each literal-union arm. The counting dual of `unionTakesAtomAsStr`: kind 2's box tag
// discriminates an arm only while this answers 1. At 2 or more the arms overlap in the tag (`K
// ⊆ string`), so `x is K` needs membership over the payload, not a tag read.
export function unionStrArmCount(name: string) {
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  let n = 0
  let i = 0
  while i < atoms.length {
    if atoms[i] == "string" || nameIsLitUnionType(atoms[i]) { n = n + 1 }
    i = i + 1
  }
  n
}
// True if the value union `name` contains the member atom `atom`.
export function unionHasAtom(name: string, atom: string) {
  // No split: `splitUnionAtoms` materializes every member as its own slice just to throw it
  // away. Atoms are verbatim substrings between top-level `|` separators, so membership is
  // decidable by comparing each span in place — same scanner, same bounds, same top-level `=>` stop, zero allocations.
  let start = 0
  let going = true
  while going {
    const at = tyTopIndexOf(name, '|', '=', start)
    let end = name.length
    if at >= 0 && name[at] != '=' { end = at } else { going = false }
    if spanEqAt(name, start, end, atom) { return true }
    if going { start = at + 1 }
  }
  false
}
// `peelGroupParens` peels every fully-enclosing grouping-paren layer; its home is `tyname.vl`,
// republished here. Below: the one home of union-arm normalization — trim whitespace, then
// peel one fully-wrapping `(...)` pair, using `tyGroupWrapsWhole` (not `parenEnclosesWhole`),
// so a key derived from a wrapped, space-padded `splitUnionAtoms` arm byte-matches one derived from the annotation; skipping the trailing-`)` reject would slice a real character off a name with no closing paren.
export function normTypeAtom(arm: string) {
  let lo = 0
  let hi = arm.length
  while lo < hi && (arm[lo] == ' ' || arm[lo] == '\t') { lo = lo + 1 }
  while hi > lo && (arm[hi - 1] == ' ' || arm[hi - 1] == '\t') { hi = hi - 1 }
  let t = arm
  if lo != 0 || hi != arm.length { t = arm.slice(lo, hi) }
  // The paren grammar's span half at its home — the cheap reject above, named. Stays
  // `tyGroupWrapsWhole`, not `peelGroupParens`'s `parenEnclosesWhole` (they disagree on a
  // never-closing group). The cut is `tyname.groupInnerOf`, kept separate from the balance walk
  // on purpose: it is the fourth distinct guard the home's call sites put in front of the same three characters of arithmetic, and folding any one in would be wrong for the rest.
  if nameIsParenSpanEnds(t) {
    if tyGroupWrapsWhole(t) { t = groupInnerOf(t) }
  }
  t
}
// The pipe-joined complement of `set` with atom `removed` taken out — the else-branch
// narrowing of `is removed`, paren-insensitive (`peelGroupParens`) so a closure member's
// wrapping parens strip correctly. Memoized, needing no invalidation (pure over the two
// strings); values live in a side pool because "" is a valid result and a real miss must stay distinguishable from it.
const raftNullKeys: {[string]: i32} = Map()
const raftKeys: {[string]: i32} = Map()
const raftVals: string[] = []

function removeAtomFromGo(set: string, removed: string) {
  const atoms: string[] = []
  splitUnionAtoms(set, atoms)
  const rmv = peelGroupParens(removed)
  // Atoms are verbatim contiguous slices of `set` separated by single `|`s, so joining kept
  // atoms with `|` equals slicing the kept runs out of `set` directly — one slice per run of
  // consecutive survivors instead of two concats per atom.
  let out = ""
  let runStart = -1 // char index where the current kept run begins, -1 = none
  let pos = 0 // char index of the current atom's start within `set`
  let i = 0
  while i < atoms.length {
    if peelGroupParens(atoms[i]) != rmv {
      if runStart < 0 { runStart = pos }
    } else if runStart >= 0 {
      // The run ends BEFORE this removed atom's separator (`pos - 1`).
      if out != "" { out = out + "|" }
      out = out + set.slice(runStart, pos - 1)
      runStart = -1
    }
    pos = pos + atoms[i].length + 1
    i = i + 1
  }
  if runStart >= 0 {
    if out != "" { out = out + "|" }
    out = out + set.slice(runStart, set.length)
  }
  out
}

export function removeAtomFrom(set: string, removed: string) {
  if removed == "null" {
    const hit = raftNullKeys[set] ?? -1
    if hit >= 0 { return raftVals[hit] }
    const out = removeAtomFromGo(set, removed)
    raftNullKeys[set] = raftVals.length
    raftVals.push(out)
    return out
  }
  const mk = i32ToStr(set.length) + ":" + set + removed
  const hit = raftKeys[mk] ?? -1
  if hit >= 0 { return raftVals[hit] }
  const out = removeAtomFromGo(set, removed)
  raftKeys[mk] = raftVals.length
  raftVals.push(out)
  out
}
// The declared-struct-name index — `1` at the interned name of every top-level `TypeDecl`.
// `declStructStmtsLen` stamps the statement list it answers for, so a reader holding a list
// of another length rebuilds instead of reading rows that belong to a different program.
let declStructBySid: i32[] = []
let declStructStmtsLen = -1

// Rebuilds the index from `stmts`. `collectU` calls it before its walk, the first pass that
// asks: only the parser mints a `TypeDecl` and only the driver's module merge appends a
// top-level statement, so both are settled before any emit pass runs.
export function declStructIndexBuild(stmts: i32[]) {
  declStructBySid = []
  declStructStmtsLen = stmts.length
  let i = 0
  while i < stmts.length {
    const s = P.nodes[stmts[i]]
    if s is TypeDecl { sidArrPut(declStructBySid, sidOf(s.tdName), 1) }
    i = i + 1
  }
  0
}

// True if `name` is declared by a top-level struct `type X = {…}` (`TypeDecl`). Asked during
// `collectU` — BEFORE `collectS` runs — so it reads the index above rather than the
// not-yet-populated `sNames` table. A name never interned is a name no declaration carries.
function isDeclaredStructName(stmts: i32[], name: string) {
  if declStructStmtsLen != stmts.length { declStructIndexBuild(stmts) }
  sidArrGet(declStructBySid, sidLookup(name)) == 1
}
// True if the atom `a` is a STRUCT variant — a declared `type X = {…}`, or an INLINE
// object shape `{x:i32}` (its fields parse from its own text; a map shape `{[…]}` is
// not). The per-member test shared by `isVariantBoxUnion` and the registration loop.
export function isStructAtom(stmts: i32[], a: string) {
  if isDeclaredStructName(stmts, a) { return true }
  nameIsShapeSpanEnds(a)
}
// True if `name` is a variant-box union this emitter interns: 2+ non-null members, every
// member a struct variant, a value-atom, or a ref-element array, with at least one struct or
// ref-array — all riding the `uBoxIdx` `{tag, value}` box, tag-discriminated. A pure value
// union has no struct/ref-array (handled earlier by `isValueUnionName`); a single struct plus `null` has one non-null member and stays the kind-9 niche nullable ref, not this.
export function isVariantBoxUnion(stmts: i32[], name: string) {
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  isVariantBoxUnionAtoms(stmts, atoms)
}
// The atom-taking form, for a caller that has already split the same name. The split is the
// expensive half of the predicate (a whole depth walk), and it is pure — so a caller that
// splits `name` into `matoms` and then asks this question of `name` at multiple dispatch arms
// pays for one walk instead of three by calling this form on the already-split atoms.
export function isVariantBoxUnionAtoms(stmts: i32[], atoms: string[]) {
  if atoms.length < 2 { return false }
  let structAtoms = 0
  let refArrAtoms = 0
  let mapAtoms = 0
  let nonNull = 0
  let j = 0
  while j < atoms.length {
    if atoms[j] != "null" {
      nonNull = nonNull + 1
      if isStructAtom(stmts, atoms[j]) {
        structAtoms = structAtoms + 1
      } else if valueAtomKind(atoms[j]) >= 0 || nameIsLitUnionType(atoms[j]) {
        // A value atom (scalar/string/scalar-element list/closure) — it boxes into a shared value box
        // or rides the anyref, tagged via `scalarTagOf`. Checked before the array test so a
        // scalar-element list (`i32[]`, `string[]`) keeps its value-atom rep rather than being
        // mistaken for a ref-element array. A litunion-alias atom rides the box as its member-string atom too.
      } else if nameIsMap(atoms[j]) {
        // A map arm (`{[string]: string}`, `{[string]: f64}`): not a struct, nor a value atom, so it
        // boxes as its map struct ref riding the box anyref, tagged via `mapTagOf`. Checked before
        // `nameIsArray` (a bare map ends in `}`, not `]`). Only a scalar/string/mono value is boxable;
        // a ref-value map arm has a heap-type-identity hazard, so the whole union stays a loud reject, never invalid wasm.
        if !mapArmValueBoxable(atoms[j]) { return false }
        mapAtoms = mapAtoms + 1
      } else if nameIsArray(atoms[j]) {
        // A ref-element array arm (`S[]`, `(() => f64)[]`, `(C | D)[]`): not a scalar-element
        // list (those are value atoms, handled above), so it boxes as its reflist wrapper ref
        // riding the box anyref, tagged via `refArrTagOf`.
        refArrAtoms = refArrAtoms + 1
      } else {
        // Neither a struct variant, a value-atom, a map, nor a ref-element array — not boxable.
        return false
      }
    }
    j = j + 1
  }
  (structAtoms >= 1 || refArrAtoms >= 1 || mapAtoms >= 1) && nonNull >= 2
}
// The synthetic type-name string of the annotation node at `tyIx` (a `TypeRef`), or
// "" if `tyIx` is unset / not a type name. Lets the inline-union scan read a param /
// return annotation's name without a `P.nodes[...] is TypeRef` round-trip at the call
// site (this slice cannot narrow there).
export function tyNameOf(tyIx: i32) {
  if tyIx >= 0 {
    const ty = P.nodes[tyIx]
    if ty is TypeRef { return ty.tyName }
  }
  ""
}
// Push `atom` onto `atoms` only if absent (dedup, preserving first-seen order).
export function pushUniqueAtom(atoms: string[], atom: string) {
  let i = 0
  while i < atoms.length {
    if atoms[i] == atom { return 0 }
    i = i + 1
  }
  atoms.push(atom)
  0
}
// The number of NON-`null` members in the pipe-joined set `set`.
export function nonNullMemberCountOf(set: string) {
  const atoms: string[] = []
  splitUnionAtoms(set, atoms)
  let n = 0
  let i = 0
  while i < atoms.length {
    if atoms[i] != "null" { n = n + 1 }
    i = i + 1
  }
  n
}
// The `memProp` of a Member expression at `exprIx` (or "").
export function callMemProp(exprIx: i32) {
  const e = P.nodes[exprIx]
  if e is Member { return e.memProp }
  ""
}
// The `$fnsig` signature key a closure-pinned parameter carries — the part after the `"=>"` of
// a monomorphized instance's synthetic annotation (`"=>ii>i"` → `"ii>i"`), or "" when `name` is
// not such a param of function `fnIx`. Below: top-level (paren/brace/bracket depth 0) index of `=>` in a synthetic function-type name, or -1.
export function annArrowAt(name: string) { tyTopIndexOf(name, '=', 0, 0) }
// The one home of "the return of a function-type name": the text after a top-level `=>`
// (`(i32) => S[]` → `S[]`), or "" when `name` carries no top-level arrow. A caller that
// also needs the result's grouping parens peeled wraps this in `normTypeAtom` at the call
// site — kept separate so this home cannot silently widen a raw-slice consumer. The gate is `>= 1`: no renderer produces a name beginning `=>`.
export function annRetNameOf(name: string) {
  const at = annArrowAt(name)
  if at < 1 { return "" }
  fnRetTextOf(name, at)
}
// The one home of the function-type decomposition `(p1, p2) => ret`: fills `outParams` with
// the top-level parameter annotations and returns the return annotation, or "" when `ann` is
// not a fully-parenthesized function type. The empty param list is not split (`() => R`
// yields no params) — without that, `annSplitParams` would push one empty part, and `monoSubstAnn` would substitute it, get "" back, and report the whole annotation unbindable.
export function annFnDecompose(ann: string, outParams: string[]) {
  const fa = annArrowAt(ann)
  if fa < 1 { return "" }
  // The PAREN grammar's OPEN half at its home; `fa >= 1` above already implies the bound.
  // The CLOSE test stays inline — this is the ARROW-relative spelling, closing the param
  // list at `fa - 1`, where the LAST character belongs to the return annotation.
  if !nameIsParenOpen(ann) { return "" }
  if ann[fa - 1] != ')' { return "" }
  // Both CUTS are `tyname.fnParamsTextOf` / `fnRetTextOf` (W4), given the index above.
  const inner = fnParamsTextOf(ann, fa)
  if inner.length > 0 { annSplitParams(inner, outParams) }
  fnRetTextOf(ann, fa)
}
// The one home of the generic-application decomposition `Head<a1, a2>`: fills `outArgs` with
// the top-level type arguments and returns the head name, or "" when `ann` is not an
// application. The test is `annGenAppSpanEnds` (`typecheck.vl`), republished at the top of
// this file; `gaeLtAt` is re-asked here rather than threaded out, costing a second scan only on a name that already ends in `>` (every other name is rejected before either scan runs).
export function annGenAppDecompose(ann: string, outArgs: string[]) {
  if !annGenAppSpanEnds(ann) { return "" }
  const lt = gaeLtAt(ann)
  gaeSplitArgs(gaeArgsTextOf(ann, lt), outArgs)
  gaeHeadNameOf(ann, lt)
}
// The one home of the inline object-shape decomposition `{a:T,b:U}`: fills `outNames`/
// `outTexts` with the top-level field names and type texts, returning 1 for an object shape,
// 0 for a map (`{[`), -1 otherwise. The tri-state is load-bearing — a map must stay
// distinguishable from "not an object" for its two callers' different unchanged-vs-declined answers. Splits with `gaeSplitArgs` (empty parts dropped), not `shapeInnerFieldSplit` (kept).
export function annObjFieldSplit(
  ann: string,
  outNames: string[],
  outTexts: string[],
) {
  // The brace-span home decides "is this a `{…}` group at all", and the map-open home tells
  // the two positive answers apart — both spellings exact (the endpoint pair plus its length
  // bound IS `nameIsBraceSpanEnds`; once that holds, `ann[1] == '['` IS `nameIsMapOpen`). The
  // `>= 3` conjunct the map test carried is inert: at length 2 index 1 is the closing `}` just demanded, so it can never be `[`.
  if !nameIsBraceSpanEnds(ann) { return -1 }
  if nameIsMapOpen(ann) { return 0 }
  const fields: string[] = []
  // The group-interior cut at its home (`tyname.groupInnerOf`). This site spelled it against a
  // hoisted length (`const n = ann.length` then `ann.slice(1, n - 1)`) rather than the receiver
  // directly; routing it here retires that hoist, which had no other reader.
  gaeSplitArgs(groupInnerOf(ann), fields)
  let j = 0
  while j < fields.length {
    const ci = fields[j].indexOf(":")
    if ci <= 0 {
      outNames.push("")
      outTexts.push("")
    } else {
      // The field-colon cut at its home (`tyname.fieldNameOf`/`fieldTypeTextOf`). The `ci <= 0`
      // guard above stays here: this site and `shapeFieldParse` disagree on whether a zero index is
      // malformed, so the cut is delimiter-blind exactly as `groupInnerOf` and `gaeArgsTextOf` are.
      outNames.push(fieldNameOf(fields[j], ci))
      outTexts.push(fieldTypeTextOf(fields[j], ci))
    }
    j = j + 1
  }
  1
}
// Splits the inner text of an inline object shape (`{…}`'s contents) into parallel
// field-name/field-type-text lists at depth 0. A malformed part (no `name:` prefix) pushes
// an empty name; the split is pure, so callers' side effects run in scan order. Depth-aware
// over `{}`/`[]`/`()` and generic-application brackets too — `>` closes only against an open `<` (`tyGtIsClose`), or the renderers' `->`/`=>` would run the depth negative.
export function shapeInnerFieldSplit(
  inner: string,
  outNames: string[],
  outTexts: string[],
) {
  // An empty shape has zero fields, which is not what the split says (D1081): with
  // `dropEmpty=false`, the empty interior of `{}` still pushes one part with
  // `indexOf(":") == -1`, so a caller received a field named `""` on a check-clean program
  // with nothing malformed. The guard is on the interior text, not the part list, so a genuinely malformed input (`"a:i32,"`) still yields its own empty trailing part.
  if inner == "" { return 0 }
  const parts: string[] = []
  tyTopLevelSplit(inner, ',', false, parts)
  let k = 0
  while k < parts.length {
    const part = parts[k]
    const ci = part.indexOf(":")
    if ci <= 0 {
      outNames.push("")
      outTexts.push("")
    } else {
      // The field-colon cut at its home (`tyname.fieldNameOf`/`fieldTypeTextOf`) — the same pair as
      // `annObjFieldSplit` above: the two functions differ only in how they split the body into
      // parts, and the per-field cut they both need is one operation.
      outNames.push(fieldNameOf(part, ci))
      outTexts.push(fieldTypeTextOf(part, ci))
    }
    k = k + 1
  }
  0
}
// True if `name` is a bare canonical struct shape name — a `{…}` group that is not a map
// (`{[`), carries no top-level arrow, and is space-free. The space test is load-bearing: a
// spaced obj render (`{f: () -> i32 | boolean}`) is not an `sNames` key, so any space marks a
// non-canonical name and rejects it.
function canonBareShapeName(name: string) {
  // The inline-shape endpoint span at its home. The three lines this replaces (`length < 2`,
  // the `{`/`}` endpoint pair, and the `name[1] == '['` map reject) are `nameIsShapeSpanEnds`
  // character for character, on every input rather than on every input tried.
  if !nameIsShapeSpanEnds(name) { return false }
  if annArrowAt(name) >= 0 { return false }
  // The space-free assertion at its home (`tyname.nameIsSpaceFree`) — the rule this function's header calls "the load-bearing half", named once for the tree.
  nameIsSpaceFree(name)
}
// True if `name` is a bare canonical struct shape (not a map) with at least one field whose
// type is a top-level union — `{f:boolean|{w:i32}}`. Such a struct has a boxed field slot (a
// `(ref $uBox)`) a body `ObjLit` built from bare literals does not naturally produce.
// `synthRetAnnots` pins an anonymous lambda's `fnRet` to it so the body's boxing matches; skips a closure field (`=>`), whose `|` binds the result, not the field.
export function nameIsStructWithUnionField(name: string) {
  // CANONICAL only, and not a map / closure — `canonBareShapeName`, the gate this
  // function and its two siblings each spelled out.
  if !canonBareShapeName(name) { return false }
  const fnames: string[] = []
  const ftexts: string[] = []
  // The group-interior cut at its home (`tyname.groupInnerOf`) — the gate above is the
  // guard, and `canonBareShapeName` opens with `nameIsShapeSpanEnds`, so the home's bound is
  // already discharged here.
  shapeInnerFieldSplit(groupInnerOf(name), fnames, ftexts)
  let fi = 0
  while fi < fnames.length {
    if fnames[fi] != "" {
      const ftype = ftexts[fi]
      // A CLOSURE field (top-level `=>`) binds any `|` to its RESULT — skip it. Only a field
      // type that is itself a top-level UNION (`|` at depth 0) is a boxed field slot. The
      // depth-0 bar scan is the checker's home, the same walk `nullablePartOf` asks.
      if annArrowAt(ftype) < 0 {
        if tyTopIndexOf(ftype, '|', 0, 0) >= 0 { return true }
        // A nested bare-shape field (`{f:{f:i32|string}}`): the boxed slot may sit one level down —
        // recurse, so the `synthRetAnnots` pin also fires for a lambda whose nested literal field
        // adopted a union-field shape. No endpoint pre-filter needed: the recursion's own first line
        // is `canonBareShapeName(ftype)`, which already rejects on `length < 2` and the `{`/`}` endpoint pair, so a guard here would cost a call on a field about to be rejected anyway.
        if nameIsStructWithUnionField(ftype) { return true }
      }
    }
    fi = fi + 1
  }
  false
}
// True if `name` is a bare canonical struct shape with at least one field whose type is a
// litunion alias (`{f:K0}`), at any nesting depth. Such a field slot is the litunion's i32
// atom, which a body `ObjLit` built from a bare string literal does not naturally produce
// (it self-infers `{f:string}`, a twin struct at a different rep) — the litunion-atom sibling of `nameIsStructWithUnionField`, whose pin a lambda with no threaded annotation otherwise misses, trapping at the narrowed call.
export function nameIsStructWithLitUnionField(name: string) {
  if !canonBareShapeName(name) { return false }
  const fnames: string[] = []
  const ftexts: string[] = []
  // The group-interior cut at its home (`tyname.groupInnerOf`), same guard as the sibling.
  shapeInnerFieldSplit(groupInnerOf(name), fnames, ftexts)
  let fi = 0
  while fi < fnames.length {
    if fnames[fi] != "" {
      const ftype = ftexts[fi]
      if nameIsLitUnionType(ftype) { return true }
      // The endpoint pre-filter, DELETED as redundant for the same reason as the sibling's:
      // the recursion opens with `canonBareShapeName(ftype)`, which begins with the identical
      // `length < 2` + `{`/`}` endpoint rejects.
      if nameIsStructWithLitUnionField(ftype) { return true }
    }
    fi = fi + 1
  }
  false
}
// Split a function-type PARAM list (`i32,f64,S`) on top-level commas (depth-aware) —
// the KEEP-empty reading of the shared depth walk, so an empty param list yields ONE
// empty part (see `annFnDecompose`'s guard, and D-GRAMHOME's S5 fixture).
export function annSplitParams(s: string, out: string[]) {
  tyTopLevelSplit(s, ',', false, out)
}
// Depth-aware split of a type name on its top-level `|` (the union/nullable separator) —
// the `annSplitParams` analogue for `|`, the same keep-empty reading of the shared walk.
export function annSplitPipe(s: string, out: string[]) {
  tyTopLevelSplit(s, '|', false, out)
}
// True if the type-annotation node at `tyIx` is a function type — the self-host parses a
// function-typed annotation as a `TypeRef` whose name contains `=>` or `(`/`)->`. For the
// corpus, function params are rare; a closure param is detected structurally elsewhere.
export function tyIsFuncType(tyIx: i32) {
  if tyIx < 0 { return false }
  // The arena covers every function-typed node (annotation, mono `=>sigkey` pin, struct field) —
  // read it ONLY; the depth-aware arrow name test is retired (C1 endgame).
  if nodeTyIxOf(tyIx) >= 0 { return nodeTyIsFunc(tyIx) }
  false
}
// True if `s` contains the substring `sub`.
export function strContains(s: string, sub: string) {
  if sub.length == 0 { return true }
  if sub.length > s.length { return false }
  let i = 0
  while i + sub.length <= s.length {
    let j = 0
    let ok = true
    while j < sub.length {
      if s[i + j] != sub[j] {
        ok = false
        j = sub.length
      } else {
        j = j + 1
      }
    }
    if ok { return true }
    i = i + 1
  }
  false
}
// Is the FuncDecl at arena index `fnIx` generic — explicit `<T>` params, or any
// un-annotated parameter (a per-callsite inference hole)?
export function monoIsGenericDecl(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    if fn.fnTyParams.length > 0 { return true }
    const ps = fn.fnParams
    let i = 0
    while i < ps.length {
      const p = P.nodes[ps[i]]
      if p is Param {
        if p.parType < 0 { return true }
      }
      i = i + 1
    }
  }
  false
}
// The type-parameter name a written annotation rides on — `ann == tp` or `ann == tp + "[]"`
// for some `tp` in `typarams`, or "" when concrete. The one-rung `[]` reading is deliberate:
// the branch this feeds writes back exactly one `[]` rung, so matching a deeper `T[][]` here
// would pin an instance a dimension short. A parameter named for a primitive binds nothing (`gaeParamShadowed`), or the param would rewrite to the argument's type while the return keeps the builtin — check-clean, invalid wasm.
export function monoTyParamOf(ann: string, typarams: string[]) {
  let i = 0
  while i < typarams.length {
    if typarams[i] == ann && !gaeParamShadowed(typarams[i]) {
      return typarams[i]
    }
    i = i + 1
  }
  // The array-name grammar at its two homes. The test stays in front of the cut rather than
  // reading the cut's "": this loop compares `base` against each type-param name, so "not an
  // array" and "the element of `[]`" are the one pair of answers `arrElemNameRaw` does not keep apart.
  if nameIsArray(ann) {
    const base = arrElemNameRaw(ann)
    let j = 0
    while j < typarams.length {
      if typarams[j] == base && !gaeParamShadowed(typarams[j]) {
        return typarams[j]
      }
      j = j + 1
    }
  }
  ""
}
// The first-use-wins binding of type-param `tp` in the per-call binding lists,
// or "" if unbound.
export function monoBindOf(tvN: string[], tvV: string[], tp: string) {
  let i = 0
  while i < tvN.length {
    if tvN[i] == tp { return tvV[i] }
    i = i + 1
  }
  ""
}
// Does the annotation name reach a declared type param — bare (`T`), array-of at any
// dimension, a union member, a generic-alias application argument, an object shape's field
// type, a function's parameter or result, or any of those under a paren or `[]` run? The arm
// list is `monoSubstAnn`'s, in the same order, by contract: an arm here that substitution lacks reports a parameter it then fails to replace, and the reverse leaves substitution unreached.
export function monoAnnHasTyParam(ann: string, typarams: string[]) {
  if monoTyParamOf(ann, typarams) != "" { return true }
  // A top-level UNION (`T | null`, `T | i32`). `splitUnionAtoms` is depth- and
  // quote-aware and stops at a top-level `=>`, so a function type whose RESULT is a
  // union stays one atom and falls through to the function arm below.
  if unionMemberCount(ann) > 1 {
    // Counts before cutting (B278): the split otherwise runs unconditionally though its result is
    // needed only for a 2+-member union. `unionMemberCount` equals the split's length at every one
    // of these sites, so counting first is the same answer for strictly less work on the common single-member case.
    const uatoms: string[] = []
    splitUnionAtoms(ann, uatoms)
    let u = 0
    while u < uatoms.length {
      if monoAnnHasTyParam(uatoms[u], typarams) { return true }
      u = u + 1
    }
    return false
  }
  // A map annotation (`{[string]: T}`). This predicate and `monoSubstAnn` need the same arm as
  // one pair: with no arm here the substitution is never attempted, so a generic returning a
  // map keeps the original annotation and the parameter survives into the instance as a
  // nominal name — check-clean, then a runtime type mismatch. The value only: a map key is `string`/`i32` by construction, so a parameter cannot reach that position.
  if nameIsMap(ann) {
    const mval = mapValNameOf(ann)
    if mval != "" {
      if monoAnnHasTyParam(mval, typarams) { return true }
    }
  }
  const parts: string[] = []
  if annGenAppDecompose(ann, parts) != "" {
    let i = 0
    while i < parts.length {
      if monoAnnHasTyParam(parts[i], typarams) { return true }
      i = i + 1
    }
    return false
  }
  const onames: string[] = []
  const otexts: string[] = []
  const okind = annObjFieldSplit(ann, onames, otexts)
  if okind == 0 { return false }
  if okind > 0 {
    let j = 0
    while j < onames.length {
      if onames[j] != "" {
        if monoAnnHasTyParam(otexts[j], typarams) { return true }
      }
      j = j + 1
    }
  }
  // A function-type annotation `(p1, p2) => ret` (a closure param/return): a type param may
  // ride any parameter or the result, so recurse into each, parallel to `monoSubstAnn`'s
  // function-type branch. Without this, a generic closure param `f: (A, T) => A` reads as concrete and keeps its un-substituted annotation.
  const fparts: string[] = []
  const fret = annFnDecompose(ann, fparts)
  if fret != "" {
    let fi = 0
    while fi < fparts.length {
      if monoAnnHasTyParam(fparts[fi], typarams) { return true }
      fi = fi + 1
    }
    if monoAnnHasTyParam(fret, typarams) { return true }
  }
  // A GROUPING paren around the whole (`(T | null)` — the form a composite element wears
  // under a `[]`). Below the function arm, so a top-level function type is claimed there
  // first; `peelGroupParens` answers a non-parenthesized name with itself.
  const pk = peelGroupParens(ann)
  if pk != ann { return monoAnnHasTyParam(pk, typarams) }
  // The `[]` run over a composite element (`(T | null)[]`, `{a: T}[]`, `T[][]`, `Box<T>[]`) —
  // last, peeling the whole run in one step, since every arm above claims a name by its
  // outermost constructor. Kept out of `monoTyParamOf`: that branch answers with exactly one
  // `[]` rung from a boolean, so a `T[][]` pattern routed there would substitute to a one-dimensional name and silently drop a parameter dimension.
  const leaf = arrLeafNameOf(ann)
  if leaf != ann { return monoAnnHasTyParam(leaf, typarams) }
  false
}
// The annotation name to read for a generic function's parameter or return: the arena's
// canon'd spelling, except where the annotation is itself a type parameter — there, the
// declared one. `canonEmitTypeNames` has no scope, so `type Id = i32` alongside
// `function ident<Id>(v: Id): Id` would resolve the parameter to `i32`, disagreeing with the checker; the gate is `monoAnnHasTyParam` on the raw spelling, carrying the primitive-shadow guard through `monoTyParamOf`.
export function monoDeclAnnName(
  nodeIx: i32,
  canoned: string,
  typarams: string[],
) {
  const raw = declAnnRawTyName(nodeIx)
  if raw == "" { return canoned }
  if !monoAnnHasTyParam(raw, typarams) { return canoned }
  raw
}
// Substitutes the per-call type-param bindings through an annotation name — bare `T`/`T[]`,
// application arguments (`Box<T>` → `Box<i32>`), and inline object-shape field types.
// Returns "" when an unbound type param remains (the instance cannot be named); a fully concrete annotation returns unchanged.
export function monoSubstAnn(
  ann: string,
  typarams: string[],
  tvN: string[],
  tvV: string[],
) {
  const tp = monoTyParamOf(ann, typarams)
  if tp != "" {
    const b = monoBindOf(tvN, tvV, tp)
    if b == "" { return "" }
    if ann == tp { return b }
    return b + "[]"
  }
  // A top-level UNION (`T | null`): substitute each member and rejoin. Paired with
  // `monoAnnHasTyParam`'s union arm — see the contract note there.
  if unionMemberCount(ann) > 1 {
    // Counts before cutting (B278): the split otherwise runs unconditionally though its result is
    // needed only for a 2+-member union. `unionMemberCount` equals the split's length at every one
    // of these sites, so counting first is the same answer for strictly less work on the common single-member case.
    const uatoms: string[] = []
    splitUnionAtoms(ann, uatoms)
    // Substitution can collapse a union, and the rejoin must answer for that: a blind `a + "|" +
    // b` produces spellings no source program can contain and no interner has seen (`T | string`
    // at `T := string` → `"string|string"`), check-clean and invalid wasm. So the rejoin does what
    // the checker would: flatten each substituted atom (itself possibly a union), dedupe by first occurrence, and return the bare atom when only one survives.
    const outs: string[] = []
    let u = 0
    while u < uatoms.length {
      const us = monoSubstAnn(uatoms[u], typarams, tvN, tvV)
      if us == "" { return "" }
      const inner: string[] = []
      splitUnionAtoms(us, inner)
      let k = 0
      while k < inner.length {
        let seen = false
        let m = 0
        while m < outs.length {
          if outs[m] == inner[k] { seen = true }
          m = m + 1
        }
        if !seen { outs.push(inner[k]) }
        k = k + 1
      }
      u = u + 1
    }
    if outs.length == 0 { return "" }
    if outs.length == 1 { return outs[0] }
    let outU = ""
    let q = 0
    while q < outs.length {
      if q > 0 { outU = outU + "|" }
      outU = outU + outs[q]
      q = q + 1
    }
    return outU
  }
  // The map arm, paired with `monoAnnHasTyParam`'s. The key prefix rides as the slice it
  // already is (`ann.slice(0, mi + 2)`), never rebuilt from parts, and the re-render is gated on
  // the value actually moving — so a concrete map annotation returns verbatim and never becomes a second intern key.
  if nameIsMap(ann) {
    let mi = 2
    while mi < ann.length - 1 {
      if ann[mi] == ']' {
        if ann[mi + 1] == ':' {
          const mval = ann.slice(mi + 2, ann.length - 1)
          if mval == "" { return ann }
          const msub = monoSubstAnn(mval, typarams, tvN, tvV)
          if msub == "" { return "" }
          if msub == mval { return ann }
          return ann.slice(0, mi + 2) + msub + "}"
        }
      }
      mi = mi + 1
    }
    return ann
  }
  const parts: string[] = []
  const gHead = annGenAppDecompose(ann, parts)
  if gHead != "" {
    let outAnn = gHead + "<"
    let i = 0
    while i < parts.length {
      const s = monoSubstAnn(parts[i], typarams, tvN, tvV)
      if s == "" { return "" }
      if i > 0 { outAnn = outAnn + "," }
      outAnn = outAnn + s
      i = i + 1
    }
    return outAnn + ">"
  }
  const onames: string[] = []
  const otexts: string[] = []
  const okind = annObjFieldSplit(ann, onames, otexts)
  if okind == 0 { return ann }
  if okind > 0 {
    let outObj = "{"
    let j = 0
    while j < onames.length {
      if onames[j] == "" { return ann }
      const fs = monoSubstAnn(otexts[j], typarams, tvN, tvV)
      if fs == "" { return "" }
      if j > 0 { outObj = outObj + "," }
      outObj = outObj + onames[j] + ":" + fs
      j = j + 1
    }
    return outObj + "}"
  }
  // A function-type annotation `(p1, p2) => ret` riding type params: substitute each parameter
  // and the return through the binding, so a generic closure param `f: (A, T) => A` pins to
  // `(string, string) => string` for the instance. Without it the instance body's call resolves no interned `$fnsig` and mis-lowers.
  const fparts: string[] = []
  const fret = annFnDecompose(ann, fparts)
  if fret != "" {
    let outFn = "("
    let fi = 0
    while fi < fparts.length {
      const fs2 = monoSubstAnn(fparts[fi], typarams, tvN, tvV)
      if fs2 == "" { return "" }
      if fi > 0 { outFn = outFn + "," }
      outFn = outFn + fs2
      fi = fi + 1
    }
    const rs2 = monoSubstAnn(fret, typarams, tvN, tvV)
    if rs2 == "" { return "" }
    return outFn + ")=>" + rs2
  }
  // A grouping paren around the whole (`(T | null)`, the form a composite element wears under a
  // `[]`), the arm `monoAnnHasTyParam` closes with. Re-renders only when the recursion actually
  // moved: an untouched inner name returns `ann` verbatim, since a rebuilt spelling is a second intern key.
  const pk = peelGroupParens(ann)
  if pk != ann {
    const ps = monoSubstAnn(pk, typarams, tvN, tvV)
    if ps == "" { return "" }
    if ps == pk { return ann }
    return "(" + ps + ")"
  }
  // The `[]` run, `monoAnnHasTyParam`'s closing arm in the same position. `arrLeafNameOf`
  // strips whole `[]` pairs off the end, so the leaf is a prefix of `ann` and the remainder is
  // precisely the repetitions to re-attach, never rebuilt from a count. An unbound leaf returns
  // "" up the chain — `monoSubstAnn`'s documented "the instance cannot be named" — and re-rendering is gated on the leaf actually moving, so a concrete `[]` run returns verbatim.
  const leaf = arrLeafNameOf(ann)
  if leaf != ann {
    const ls = monoSubstAnn(leaf, typarams, tvN, tvV)
    if ls == "" { return "" }
    if ls == leaf { return ann }
    return ls + ann.slice(leaf.length, ann.length)
  }
  ann
}
// Bind type params by matching a parameter's annotation PATTERN against the
// argument's concrete type name: `T` against anything, `T[]` against `X[]`,
// `Box<T>` against `Box<i32>` (same head, pairwise arguments). First use wins.
export function monoBindFromAnn(
  pat: string,
  actual: string,
  typarams: string[],
  tvN: string[],
  tvV: string[],
) {
  const tp = monoTyParamOf(pat, typarams)
  if tp != "" {
    let bind = actual
    if pat != tp {
      // A `T[]` pattern binds `T` to the ARGUMENT's element — the array-name grammar at
      // its two homes. The TEST is kept in front of the CUT for `monoTyParamOf`'s reason:
      // `bind` is pushed as a binding, so an empty element is not the same answer as "not
      // an array" and this merge asserts nothing about `"[]"`.
      if !nameIsArray(actual) { return 0 }
      bind = arrElemNameRaw(actual)
    }
    if monoBindOf(tvN, tvV, tp) == "" {
      tvN.push(tp)
      tvV.push(bind)
    }
    return 0
  }
  // A top-level union pattern (`T | null` against `string | null`): bind member-wise. The three
  // walks share one arm list in one order, the contract `monoAnnHasTyParam`'s header states. The
  // member counts must match before any pair is believed: on a differing arity this binds
  // nothing rather than pairing `T` with whichever member happens to sit at its index.
  if unionMemberCount(pat) > 1 {
    // Counts before cutting (B278): the split otherwise runs unconditionally though its result is
    // needed only for a 2+-member union. `unionMemberCount` equals the split's length at every one
    // of these sites, so counting first is the same answer for strictly less work on the common single-member case.
    const puatoms: string[] = []
    splitUnionAtoms(pat, puatoms)
    const auatoms: string[] = []
    splitUnionAtoms(actual, auatoms)
    if puatoms.length == auatoms.length {
      let ui = 0
      while ui < puatoms.length {
        monoBindFromAnn(puatoms[ui], auatoms[ui], typarams, tvN, tvV)
        ui = ui + 1
      }
    }
    return 0
  }
  // The `[]` run, the arm `monoSubstAnn` has had all along while this one lacked (D753):
  // `monoTyParamOf`'s branch above peels exactly one `[]`, so a multi-dimensional pattern
  // reaching here binds nothing without this arm. The pattern's dimensions are the cut, not
  // the actual's: `T[][]` against `i32[][][]` binds `T` to `i32[]`, not the argument's own leaf — taking the actual's leaf would bind a parameter no substitution could rebuild.
  const pLeaf = arrLeafNameOf(pat)
  if pLeaf != pat {
    const dims = pat.length - pLeaf.length
    const aLeaf = arrLeafNameOf(actual)
    if actual.length - aLeaf.length >= dims {
      monoBindFromAnn(
        pLeaf,
        actual.slice(0, actual.length - dims),
        typarams,
        tvN,
        tvV,
      )
    }
    return 0
  }
  const pparts: string[] = []
  const pHead = annGenAppDecompose(pat, pparts)
  if pHead != "" {
    const aparts: string[] = []
    if pHead == annGenAppDecompose(actual, aparts) {
      let i = 0
      while i < pparts.length {
        if i < aparts.length {
          monoBindFromAnn(pparts[i], aparts[i], typarams, tvN, tvV)
        }
        i = i + 1
      }
    }
  }
  // An inline object-shape pattern (`{a: T}` against `{a:i32}`): bind field-wise, pairing by
  // the field name rather than the index, because the pattern is the declared spelling and the
  // actual is the arena's canon'd one — two renderings that agree on names but need not agree on anything else. A field the two do not share binds nothing.
  const pon: string[] = []
  const pot: string[] = []
  if annObjFieldSplit(pat, pon, pot) > 0 {
    const aon: string[] = []
    const aot: string[] = []
    if annObjFieldSplit(actual, aon, aot) > 0 {
      let oi = 0
      while oi < pon.length {
        if pon[oi] != "" {
          let oj = 0
          while oj < aon.length {
            if aon[oj] == pon[oi] {
              monoBindFromAnn(pot[oi], aot[oj], typarams, tvN, tvV)
            }
            oj = oj + 1
          }
        }
        oi = oi + 1
      }
    }
    return 0
  }
  // A function-type pattern `(P1, P2) => R` against the argument's function type
  // `(i32, i32) => i32`: bind type params pairwise across the parameters and the return,
  // parallel to `monoSubstAnn`/`monoAnnHasTyParam`. Binds `reduce`'s `f: (A, T) => A` from the lambda argument's concrete type.
  const pp: string[] = []
  const pRet = annFnDecompose(pat, pp)
  if pRet != "" {
    const ap: string[] = []
    const aRet = annFnDecompose(actual, ap)
    if aRet != "" {
      let fi = 0
      while fi < pp.length {
        if fi < ap.length {
          monoBindFromAnn(pp[fi], ap[fi], typarams, tvN, tvV)
        }
        fi = fi + 1
      }
      monoBindFromAnn(pRet, aRet, typarams, tvN, tvV)
    }
  }
  // A GROUPING paren around the whole (`(T | null)` — the form a composite element wears
  // under a `[]`), below the function arm exactly as in the two sibling walks. The ACTUAL
  // is peeled too and independently: the pattern is the DECLARED spelling and the actual
  // the canon'd one, and the two need not agree about whether the group is parenthesized.
  const ppk = peelGroupParens(pat)
  if ppk != pat {
    monoBindFromAnn(ppk, peelGroupParens(actual), typarams, tvN, tvV)
    return 0
  }
  // The `[]` run, the arm its two siblings close with. `T[]` never reaches here —
  // `monoTyParamOf` claims one `[]` level at the top and binds the argument's element — so
  // this is the run of two or more (`T[][]`) or over a composite (`Box<T>[]`). The run
  // lengths must match before either leaf is believed, or a mismatch pairs `T` with the wrong leaf and pins an instance a dimension short of what the checker typed.
  const leafP = arrLeafNameOf(pat)
  if leafP != pat {
    const leafA = arrLeafNameOf(actual)
    if pat.length - leafP.length == actual.length - leafA.length {
      monoBindFromAnn(leafP, leafA, typarams, tvN, tvV)
    }
  }
  0
}
// Is `op` an operator that may dispatch to a `self`-method / operator field?
// Assignment, equality (structural compare), the logicals and `??` keep their
// native forms.
export function drwDispatchOp(op: string) {
  if op == "=" { return false }
  if op == "==" || op == "!=" { return false }
  if op == "&&" || op == "||" || op == "??" { return false }
  true
}
