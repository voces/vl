// `emit_base.vl` — the emitter's PURE vocabulary: type-NAME analysis (`name*`/`ty*`/
// `ann*`/`ret*`/`nul*`), monomorphization name logic (`mono*`/`gae*`), and low-level
// string/byte/opcode helpers. None touch emitter state; a leaf the emitter (and
// `emit_query`) import. Carved out of `wasmEmit.vl`.

import {
  T,
  TyArray,
  TyFunc,
  TyMap,
  TyNullable,
  declAnnRawTyName,
  inferRetNameOf,
  isValueUnionName,
  nameIsLitUnionType,
  nodeTyArrayElemRepName,
  nodeTyIsClosureArray,
  nodeTyIsFunc,
  nodeTyIsLitUnionAlias,
  nodeTyIsNulBool,
  nodeTyIsNulClosure,
  nodeTyIsNulI32List,
  nodeTyIsNulString,
  nodeTyIxOf,
  nodeTyPrimName,
  nodeTyWidenedRepName,
  valueAtomKind,
} from "./typecheck"
import { sidArrGet, sidArrPut, sidOf, sidOfNode } from "./symbols"
// ── the type-name grammars this file CALLS, asked of their HOME directly ──────────────
//
// Pure character grammars over a type-name STRING, homed in `compiler/tyname.vl` — a LEAF
// with zero imports. This file BINDS them for its own calls and republishes NONE: every
// emitter module asks the home itself, so do not re-add an `export … from "./tyname"`.
// THE DIRECTION IS NOT NEGOTIABLE: `emit_base.vl` imports `typecheck.vl`, which imports
// nothing from `emit_*`, so a copy in the checker calling a home here would cycle the
// module graph and the compiler would refuse to build itself — that is why the homes moved
// DOWN, below the checker. Read any "one module DOWN, in `typecheck.vl`" left in this tree
// as naming the FAMILY, not the file. Each grammar's full header lives at its home; the
// sections below keep only the LAYERS this file builds on them. D-TYNAMEHOME phases 0–1c,
// docs/internals/destringify-types-program.md.
import {
  annGenAppSpanEnds,
  arrElemIs,
  arrElemIsArrayOf,
  arrElemNameRaw,
  fieldNameOf,
  fieldTypeTextOf,
  fnParamsTextOf,
  fnRetTextOf,
  gaeArgsTextOf,
  gaeHeadNameOf,
  gaeLtAt,
  groupInnerOf,
  listElemNameOf,
  mapSpellKeyName,
  nameIsArray,
  nameIsBraceSpanEnds,
  nameIsFuncTypeAtom,
  nameIsMapOpen,
  nameIsMapSpan,
  nameIsParenOpen,
  nameIsParenSpanEnds,
  nameIsQuotedLeaf,
  nameIsShapeOpen,
  nameIsSpaceFree,
  peelGroupParens,
  spanEqAt,
  splitUnionAtoms,
  tyGroupEndIndex,
  tyTopIndexOf,
  tyTopLevelSplit,
  unionMemberCount,
  unionMemberCountSpan,
} from "./tyname"
import {
  ArrayLit,
  Block,
  BoolLit,
  Call,
  CharLit,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  Index,
  LetDecl,
  Member,
  NumLit,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  Program,
  StrLit,
  TypeDecl,
  TypeRef,
  WhileStmt,
  i32ToStr,
} from "./ast"

// Unsigned LEB128: 7 bits per byte, low-to-high, high bit set while more remain.

export function ulebToArr(value: i32) {
  const out: i32[] = []
  let v = value
  let more = true
  while more {
    const byte = v & 0x7f
    v = v >>> 7
    if v == 0 {
      out.push(byte)
      more = false
    } else {
      out.push(byte | 0x80)
    }
  }
  out
}
// SLEB-encode `value` into a fresh `i32[]`.
export function slebToArr(value: i32) {
  const out: i32[] = []
  let v = value
  let more = true
  while more {
    const byte = v & 0x7f
    v = v >> 7
    let signBit = 0
    if (byte & 0x40) != 0 { signBit = 1 }
    if v == 0 {
      if signBit == 0 {
        out.push(byte)
        more = false
      } else {
        out.push(byte | 0x80)
      }
    } else {
      if v == -1 {
        if signBit == 1 {
          out.push(byte)
          more = false
        } else {
          out.push(byte | 0x80)
        }
      } else {
        out.push(byte | 0x80)
      }
    }
  }
  out
}
// Append all of `src` onto `dst` (in place) and return `dst`.
export function appendAll(dst: i32[], src: i32[]) {
  let i = 0
  while i < src.length {
    dst.push(src[i])
    i = i + 1
  }
  dst
}
// The IEEE-754 literal encoders (`f64Bytes`/`f32Bytes`) live in `emit_bignum` — a
// leaf, so the CHECKER shares the exact same overflow judgement
// (`f64LitOverflows`/`f32LitOverflows`) without an import cycle.
// True if `name` is currently in the `bound` set (a param or an in-scope `let`).
export function capIsBound(bound: string[], name: string) {
  let i = 0
  while i < bound.length {
    if bound[i] == name { return true }
    i = i + 1
  }
  false
}
// True if `name` is in `caps` already (dedup the capture list).
export function capHas(caps: string[], name: string) {
  let i = 0
  while i < caps.length {
    if caps[i] == name { return true }
    i = i + 1
  }
  false
}
// True if `name` is a call target the emitter LOWERS INLINE — one of the five builtins
// (`print`, `Map`, …). Such a name in CALLEE POSITION denotes instructions, not a value, so
// it is not a captured variable: a closure whose body calls one (`function f() { print(1) }`
// used as a value) must not "capture" it and fail `captured variable not found`.
// Consulted at exactly ONE place — `capScan`'s `Call` arm, CALLEE only. Consulting it at
// every identifier instead suppressed genuine captures of a LOCAL sharing one of these names
// (`const fromCodePoint = 5` + `() => fromCodePoint + 1`); a name is a call target only where
// it is being CALLED.
// DO NOT RE-ADD A DUNDER NAME: the memory intrinsics belong to
// `typecheck.nameIsEmitterIntrinsic`, which `capScan` consults beside this one, and the
// partial copy that used to live here was pure drift (docs/internals/buffer-design.md §B3/O7).
// The five builtins cannot fold into it — a program may legally define its own `print`/`Map`.
export function isBuiltinFnName(name: string) {
  if name == "print" { return true }
  if name == "fromCodePoint" { return true }
  if name == "fromCodePoints" { return true }
  if name == "Map" { return true }
  if name == "Set" { return true }
  false
}
// A single-entry cache for `parentLetOf`: the block whose name->LetDecl map is built, and the
// map (`name -> LetDecl arena index`, FIRST-wins). The emitter resolves identifiers in one
// function at a time, and every `parentLetOf` caller passes that function's BODY block, so a
// one-entry cache rebuilds once per function and serves the rest O(1) — `parentLetOf` was the
// single hottest self-compile function because each call re-walked the whole body.
// `resetParentLetCache` clears it at `emitProgram` start (the arena is rebuilt each compile, so
// a stale block index from a prior compile on a SHARED instance must not be trusted).
let plCacheBlock: i32 = -1
// R6, with the one twist a PER-BLOCK table needs. `plCacheMap` was a `{[string]:
// i32}` thrown away and rebuilt on every block change; a dense sid-indexed array
// cannot be thrown away that cheaply (clearing it is O(all symbols in the program)
// per FUNCTION, which is worse than the map it replaces). So the array is
// GENERATION-STAMPED: `plGen` is bumped once per rebuild and a slot counts as
// present only when its stamp is the current generation. Clearing is O(1), the
// lookup is two array reads, and a stale slot from an earlier block is
// indistinguishable from absent — which is exactly what `Map()` meant.
//
// `plGen` starts at 0 and is bumped BEFORE the first build, so it is >= 1 whenever
// a lookup can happen; `sidArrPut`'s fill value is -1, so an untouched slot can
// never read as present.
let plSidVal: i32[] = []
let plSidGen: i32[] = []
let plGen: i32 = 0

// The LOOP-VARIABLE half of the same plan, filled by the SAME walk under the SAME
// generation stamp: `name -> ForRange/ForIn arena index`, FIRST-wins.
//
// A `for v in …` variable is a function-scoped wasm local exactly as a body `let` is, but
// it is not a `LetDecl`, so it was invisible to every "does this frame bind this name"
// question routed through `parentLetOf`. It rides a SECOND array rather than the first
// because `parentLetOf` hands its answer to 70-odd callers that read it as a `LetDecl`
// arena index; widening THAT return would change what each of them decodes. The question
// this table answers is narrower — "is this name bound here at all" — and its callers ask
// exactly that.
let plLoopSidVal: i32[] = []
let plLoopSidGen: i32[] = []

// The FuncDecl-name set behind `nameNamesFunction`, and the arena high-water mark it has
// folded. See that function's header for the append-only argument; the reset rides on
// `resetParentLetCache` because both are per-COMPILE arena caches with the same lifetime and
// the same one call site (`emitProgram`), and splitting them is how one of them rots.
let nnfSet: {[string]: boolean} = Map()
let nnfScanned: i32 = 0

// The MODULE scope's loop-variable names, behind `moduleBindsLoopVar`. Built once per
// compile from the `Program` node and kept in its own set rather than routed through the
// single-entry `parentLetOf` cache: this is asked from inside capture analysis, which is
// otherwise resolving against a FUNCTION body, and evicting that cache per identifier
// would rebuild the whole body's plan each time.
let mlvSet: {[string]: boolean} = Map()
let mlvBuilt: boolean = false

// The MODULE scope's BLOCK-LOCAL bindings — a `const`/`let` written inside a top-level
// `if`/`while`/`for`/bare block, which is a start-function local and NOT a global. Behind
// `moduleLocalLetOf`, filled by the same walk as `mlvSet` because it answers the other half
// of one question: which binding does a capture from the module frame denote (D1244). A
// TOP-LEVEL `LetDecl` is deliberately absent — that is a global, addressable directly, and
// never a capture.
let mllMap: {[string]: i32} = Map()
// Is `mllMap` non-empty? `parentBindingOf` consults the module arm on EVERY miss, which is
// its hot path (see that function's `retCapturedMapShape` caller), so the common answer has
// to cost a branch rather than a string hash.
let mllAny: boolean = false

// Record `name` as naming a function WITHOUT waiting for the fold to reach its node — the
// escape hatch for the one writer that renames a FuncDecl IN PLACE after the arena already
// holds it (`emit_collect`'s lambda numbering, `n.fnName = "__lambda_" + …`). Every other
// FuncDecl reaches `P.nodes` fully built (`ast.addNode` takes a complete node), so the fold
// sees the final name. A note is monotone — it can only ADD a name — which is why the reverse
// direction (the driver's module-merge rename, which also RETIRES the old name) is not routed
// here: it runs before `emitProgram`, i.e. before the reset, so the set never saw the old one.
export function noteFuncName(name: string) {
  if name == "" { return 0 }
  nnfSet[name] = true
  0
}

// Drop this file's SID-KEYED rows. Paired with `symbols.sidReset` by the driver
// (through `emit_sections.sidKeyedTablesReset`) because the id space is re-keyed
// there: a generation stamp defends against a stale KEY, never against a re-keyed
// universe — program N+1 re-issues `plGen` from 0 and would match program N's rows,
// handing out that program's arena indices. See `sidReset`'s header for the
// measurement that found this.
export function sidResetParentLet() {
  plCacheBlock = -1
  plSidVal = []
  plSidGen = []
  plLoopSidVal = []
  plLoopSidGen = []
  plGen = 0
  0
}

export function resetParentLetCache() {
  sidResetParentLet()
  nnfSet = Map()
  nnfScanned = 0
  mlvSet = Map()
  mlvBuilt = false
  mllMap = Map()
  mllAny = false
  0
}

// Fill `plCacheMap` with every function-scoped `LetDecl` reachable from `blockIx` (descending
// into if/loop bodies — wasm locals are function-scoped), in the SAME pre-order `parentLetOf`
// walked, FIRST-wins, so the map's entry for a name is the first declaration that walk found.
// Scan one statement node (or a block) for `let`/`const` declarations, recording each into
// `plCacheMap` (first occurrence wins). Recurses through every body that shares the function's
// local scope: BOTH branches of an `if`/`else if` CHAIN — crucially the else slot may be a bare
// `Block` OR a nested `IfStmt` (an `else if`), and the old code descended only Blocks, so lets in
// `else if` arms were invisible — plus `while`/`for` loop bodies and nested blocks. wasm locals are
// function-scoped, so a binding ANYWHERE in the function must be found regardless of nesting.
function plScanStmt(ix: i32) {
  if ix < 0 { return 0 }
  const st = P.nodes[ix]
  if st is LetDecl {
    // The id comes from the CARRIER — `ix` IS this `LetDecl`'s arena index, so after
    // the first pass over this node the build costs no hash at all. FIRST-wins is the
    // generation test (an earlier write in THIS generation blocks a later one).
    const lsid = sidOfNode(ix)
    if sidArrGet(plSidGen, lsid) != plGen {
      sidArrPut(plSidGen, lsid, plGen)
      sidArrPut(plSidVal, lsid, ix)
    }
  } else if st is IfStmt {
    plScanStmt(st.ifThen)
    if st.ifElse >= 0 { plScanStmt(st.ifElse) }
  } else if st is WhileStmt {
    plScanStmt(st.whileBody)
  } else if st is ForRange {
    plRecordLoopVar(st.frVar, ix)
    plScanStmt(st.frBody)
  } else if st is ForIn {
    plRecordLoopVar(st.fiVar, ix)
    plScanStmt(st.fiBody)
  } else if st is Block {
    const stmts = st.blkStmts
    let i = 0
    while i < stmts.length {
      plScanStmt(stmts[i])
      i = i + 1
    }
  } else if st is Program {
    // THE MODULE SCOPE, reached only when a caller passes the PROGRAM node as the
    // "block" — which `synthGlobalDstPinAnns` does and nothing else does, because every
    // other caller holds a function body. A top-level `const`/`let` is the module's
    // analogue of a function-scoped local for the one question this table answers
    // ("which binding does this name denote in this scope"), and the walk stops at a
    // top-level `FuncDecl` for free: there is no `FuncDecl` arm above, so a function's
    // own locals never leak into the module's map and shadow a global of the same name.
    const pstmts = st.progStmts
    let pi = 0
    while pi < pstmts.length {
      plScanStmt(pstmts[pi])
      pi = pi + 1
    }
  }
  0
}

// Record loop variable `name`, bound by the `ForRange`/`ForIn` at arena index `ix`, into
// the plan's loop-variable half. FIRST-wins under the current generation, matching the
// `LetDecl` half's convention. An unnamed variable ("" — not producible by the parser, but
// cheap to exclude) records nothing.
function plRecordLoopVar(name: string, ix: i32) {
  if name == "" { return 0 }
  const lsid = sidOf(name)
  if sidArrGet(plLoopSidGen, lsid) != plGen {
    sidArrPut(plLoopSidGen, lsid, plGen)
    sidArrPut(plLoopSidVal, lsid, ix)
  }
  0
}

// Collect every MODULE-scope `for` variable name reachable from statement `ix` into
// `mlvSet`, and every module-scope BLOCK-LOCAL `LetDecl` into `mllMap` (D1244). Descends
// the bodies that share the module's local frame (loops, `if` arms, bare blocks) and stops
// at a `FuncDecl`, whose bindings belong to that function.
//
// The `LetDecl` arm never sees a TOP-LEVEL one: `mlvBuild` skips those before descending,
// because a top-level binding is a module GLOBAL and has its own storage class.
function mlvScanStmt(ix: i32) {
  if ix < 0 { return 0 }
  const st = P.nodes[ix]
  if st is LetDecl {
    if (mllMap[st.letName] ?? -1) < 0 {
      mllMap[st.letName] = ix
      mllAny = true
    }
  } else if st is ForRange {
    if st.frVar != "" { mlvSet[st.frVar] = true }
    mlvScanStmt(st.frBody)
  } else if st is ForIn {
    if st.fiVar != "" { mlvSet[st.fiVar] = true }
    mlvScanStmt(st.fiBody)
  } else if st is WhileStmt {
    mlvScanStmt(st.whileBody)
  } else if st is IfStmt {
    mlvScanStmt(st.ifThen)
    if st.ifElse >= 0 { mlvScanStmt(st.ifElse) }
  } else if st is Block {
    const stmts = st.blkStmts
    let i = 0
    while i < stmts.length {
      mlvScanStmt(stmts[i])
      i = i + 1
    }
  }
  0
}

// Does the MODULE scope bind `name` as a `for` loop variable? `rootIx` is the `Program`
// node.
//
// The module's top level is NOT a lifted frame — `fnParent` is -1 for a lambda written
// there — so the frame walk that answers this question inside a function runs off the end
// before it can. A top-level loop variable is nonetheless a genuine local of the start
// function, and a closure written in the loop body captures it.
export function moduleBindsLoopVar(rootIx: i32, name: string) {
  mlvBuild(rootIx)
  mlvSet[name] == true
}

// Build both module-frame tables once per compile. A top-level `LetDecl` is skipped rather
// than descended: it is a module GLOBAL, so it belongs to no local frame, and recording it
// would make `moduleLocalLetOf` answer for a name that is not a capture.
function mlvBuild(rootIx: i32) {
  if rootIx < 0 { return 0 }
  if mlvBuilt { return 0 }
  mlvBuilt = true
  const r = P.nodes[rootIx]
  if r is Program {
    const stmts = r.progStmts
    let i = 0
    while i < stmts.length {
      const s = P.nodes[stmts[i]]
      if s is LetDecl {} else { mlvScanStmt(stmts[i]) }
      i = i + 1
    }
  }
  0
}

// The module-scope BLOCK-LOCAL `LetDecl` binding `name` — a `const`/`let` written inside a
// top-level `if`/`while`/`for`/bare block — or -1. `parentBindingOf`'s module arm (D1244):
// the module's top level is not a lifted frame, so the `fnParent` walk runs off the chain
// before it can type a capture of one of these, and every ref-repped capture then took the
// i32 default (a loud `field access receiver is not a struct` on a struct, invalid wasm on
// a list or a string).
export function moduleLocalLetOf(rootIx: i32, name: string) {
  mlvBuild(rootIx)
  if !mllAny { return -1 }
  mllMap[name] ?? -1
}

function plBuildLetMap(blockIx: i32) { plScanStmt(blockIx) }

// Find a `LetDecl` for `name` anywhere in the parent body block (incl. nested if/loop
// bodies — wasm locals are function-scoped). Returns its arena index or -1. Backed by the
// single-entry per-block cache above (built on a miss, then O(1)).
export function parentLetOf(blockIx: i32, name: string) {
  // `sidOf`, not `sidLookup`: this table is built LAZILY on the miss inside
  // `parentLetOfSid`, so a name interned only BY that build would resolve to -1 if
  // the id were taken before it. See `sidLookup`'s header, tooth 1.
  parentLetOfSid(blockIx, sidOf(name))
}

// The sid-taking primitive (R5/R6) — NO hash and NO probe, two array reads.
//
// This is the one the hot callers use. `parentLetOf` stayed a large share of a self-compile
// even after #1314 collapsed its double probe, and most of that arrives through four
// functions (`unionNameOfIdent`, `identFnTypeAnnName`, `identClosureFe`, `identCopySource`).
// Each of those resolves ONE identifier and then asks the global table about the SAME name,
// so each interns once and spends the id twice; and the call sites that hold the
// identifier's arena index get it from the carrier for free.
export function parentLetOfSid(blockIx: i32, sid: i32) {
  if blockIx < 0 { return -1 }
  if blockIx != plCacheBlock {
    plGen = plGen + 1
    plBuildLetMap(blockIx)
    plCacheBlock = blockIx
  }
  if sid < 0 { return -1 }
  if sidArrGet(plSidGen, sid) != plGen { return -1 }
  sidArrGet(plSidVal, sid)
}

// Find the `for` LOOP VARIABLE named `name` anywhere in the body block at `blockIx` —
// the loop-variable twin of `parentLetOf`, sharing its walk, its cache and its
// generation stamp. Returns the binding `ForRange`/`ForIn` arena index, or -1.
//
// Ask it wherever "is this name bound in this frame" decides something, because a loop
// variable is a function-scoped local like any other and `parentLetOf` cannot see it.
export function parentLoopVarOf(blockIx: i32, name: string) {
  parentLoopVarOfSid(blockIx, sidOf(name))
}

// The sid-taking primitive, with `parentLetOfSid`'s lazy build (the two halves are one
// table under one generation, so either lookup builds both).
export function parentLoopVarOfSid(blockIx: i32, sid: i32) {
  if blockIx < 0 { return -1 }
  if blockIx != plCacheBlock {
    plGen = plGen + 1
    plBuildLetMap(blockIx)
    plCacheBlock = blockIx
  }
  if sid < 0 { return -1 }
  if sidArrGet(plLoopSidGen, sid) != plGen { return -1 }
  sidArrGet(plLoopSidVal, sid)
}
// The loop-stack position a `break`/`continue` targets: "" (unlabelled) binds
// to the TOP entry (the innermost loop); a label scans from the top for the
// nearest enclosing loop carrying it. Returns -1 when the label names no
// enclosing loop (the emit-time fail-loud guard).
export function loopStackFind(labels: string[], label: string) {
  if label == "" { return labels.length - 1 }
  let i = labels.length - 1
  while i >= 0 {
    if labels[i] == label { return i }
    i = i - 1
  }
  -1
}
// The VALUE type-name of a synthetic map type-name `{[K]:V}` — the text after the FIRST
// "]:" (the key cannot contain `]`), minus the closing `}`. "" if the name is not that shape.
//
// **THIS IS NOT `tyname.mapSpellValName`, DESPITE THE SAME CUT**, and the two are not
// interchangeable. The checker's map-value cut (`mapSpellValName`, D-MAPSPELL) gates on a
// closing `}`; this one gates on `nameIsMap` (opens `{[`, does not end `[]`). So this one
// ACCEPTS `{[string]:i32}|null` and returns the garbled `"i32}|nul"` that its own callers
// strip for, where the checker's returns "". A genuine second predicate rather than a copy —
// which is why the down-move that took `nameIsMapOpen` could not also take this.
export function mapValNameOf(name: string) {
  if !nameIsMap(name) { return "" }
  let i = 2
  while i < name.length - 1 {
    if name[i] == ']' {
      if name[i + 1] == ':' { return name.slice(i + 2, name.length - 1) }
    }
    i = i + 1
  }
  ""
}
// Map a binary operator lexeme to its i32 wasm opcode, or -1 if unsupported. The
// three arithmetic ops and the six signed i32 comparisons are recognized; anything
// else (`/`, `%`, `=`, logical `&&`/`||`, …) falls through to -1 so the caller
// fails loudly rather than emitting a wrong opcode. Comparisons leave a 0/1 i32 on
// the stack — exactly what a wasm `if` condition consumes.
//   `+`  -> i32.add  (0x6a)   `-`  -> i32.sub  (0x6b)   `*`  -> i32.mul  (0x6c)
//   `==` -> i32.eq   (0x46)   `!=` -> i32.ne   (0x47)
//   `<`  -> i32.lt_s (0x48)   `>`  -> i32.gt_s (0x4a)
//   `<=` -> i32.le_s (0x4c)   `>=` -> i32.ge_s (0x4e)
export function binOpcode(op: string) {
  if op == "+" {
    return 106 // 0x6a i32.add
  }
  if op == "-" {
    return 107 // 0x6b i32.sub
  }
  if op == "*" {
    return 108 // 0x6c i32.mul
  }
  if op == "/" {
    return 109 // 0x6d i32.div_s (signed; VL `i32` division is signed)
  }
  if op == "%" {
    return 111 // 0x6f i32.rem_s (signed remainder)
  }
  if op == "==" {
    return 70 // 0x46 i32.eq
  }
  if op == "!=" {
    return 71 // 0x47 i32.ne
  }
  if op == "<" {
    return 72 // 0x48 i32.lt_s
  }
  if op == ">" {
    return 74 // 0x4a i32.gt_s
  }
  if op == "<=" {
    return 76 // 0x4c i32.le_s
  }
  if op == ">=" {
    return 78 // 0x4e i32.ge_s
  }
  // Bitwise / shift (integer-only). VL `i32` is signed, so `>>` is the SIGNED
  // (arithmetic) shift `shr_s` and `>>>` the UNSIGNED (logical) shift `shr_u` —
  // the distinction the LEB encoders' `v >>> 7` relies on. Mirrors the host
  // `INT_BINOPS` map in toWasm.ts (`&`->and, `|`->or, `>>`->shr_s, `>>>`->shr_u).
  if op == "&" {
    return 113 // 0x71 i32.and
  }
  if op == "|" {
    return 114 // 0x72 i32.or
  }
  if op == "^" {
    return 115 // 0x73 i32.xor
  }
  if op == "<<" {
    return 116 // 0x74 i32.shl
  }
  if op == ">>" {
    return 117 // 0x75 i32.shr_s (signed/arithmetic)
  }
  if op == ">>>" {
    return 118 // 0x76 i32.shr_u (unsigned/logical)
  }
  -1
}
// The i64 instruction variant for `op` (Slice 2), selected when an operand is i64.
// Arithmetic/bitwise/shift consume two i64 and leave an i64; comparisons consume two
// i64 and leave an i32 BOOL. Returns -1 for an op with no i64 form (`&&`/`||`/`=`/`??`).
//   +  i64.add 0x7c  -  i64.sub 0x7d  *  i64.mul 0x7e  /  i64.div_s 0x7f  %  i64.rem_s 0x81
//   &  i64.and 0x83  |  i64.or 0x84   ^  i64.xor 0x85  << i64.shl  0x86
//   >> i64.shr_s 0x87  >>> i64.shr_u 0x88
//   == i64.eq 0x51  != i64.ne 0x52  < i64.lt_s 0x53  > i64.gt_s 0x55
//   <= i64.le_s 0x57  >= i64.ge_s 0x59
export function binOpcodeI64(op: string) {
  if op == "+" {
    return 124 // 0x7c i64.add
  }
  if op == "-" {
    return 125 // 0x7d i64.sub
  }
  if op == "*" {
    return 126 // 0x7e i64.mul
  }
  if op == "/" {
    return 127 // 0x7f i64.div_s
  }
  if op == "%" {
    return 129 // 0x81 i64.rem_s
  }
  if op == "&" {
    return 131 // 0x83 i64.and
  }
  if op == "|" {
    return 132 // 0x84 i64.or
  }
  if op == "^" {
    return 133 // 0x85 i64.xor
  }
  if op == "<<" {
    return 134 // 0x86 i64.shl
  }
  if op == ">>" {
    return 135 // 0x87 i64.shr_s
  }
  if op == ">>>" {
    return 136 // 0x88 i64.shr_u
  }
  if op == "==" {
    return 81 // 0x51 i64.eq
  }
  if op == "!=" {
    return 82 // 0x52 i64.ne
  }
  if op == "<" {
    return 83 // 0x53 i64.lt_s
  }
  if op == ">" {
    return 85 // 0x55 i64.gt_s
  }
  if op == "<=" {
    return 87 // 0x57 i64.le_s
  }
  if op == ">=" {
    return 89 // 0x59 i64.ge_s
  }
  -1
}
// The f64 instruction variant for `op` (Slice 3), selected when an operand is f64.
// Arithmetic consumes two f64 and leaves an f64; comparisons consume two f64 and leave
// an i32 BOOL. Returns -1 for an op with no f64 form (`%`/bitwise/shift/`&&`/`||`/...);
// -1 is a HARD FAIL at the emitter, never a fall-through to the i32 path — see `emitBinExprNode`.
//   +  f64.add 0xa0  -  f64.sub 0xa1  *  f64.mul 0xa2  /  f64.div 0xa3
//   == f64.eq 0x61   != f64.ne 0x62   <  f64.lt 0x63   >  f64.gt 0x64
//   <= f64.le 0x65   >= f64.ge 0x66
export function binOpcodeF64(op: string) {
  if op == "+" {
    return 160 // 0xa0 f64.add
  }
  if op == "-" {
    return 161 // 0xa1 f64.sub
  }
  if op == "*" {
    return 162 // 0xa2 f64.mul
  }
  if op == "/" {
    return 163 // 0xa3 f64.div
  }
  if op == "==" {
    return 97 // 0x61 f64.eq
  }
  if op == "!=" {
    return 98 // 0x62 f64.ne
  }
  if op == "<" {
    return 99 // 0x63 f64.lt
  }
  if op == ">" {
    return 100 // 0x64 f64.gt
  }
  if op == "<=" {
    return 101 // 0x65 f64.le
  }
  if op == ">=" {
    return 102 // 0x66 f64.ge
  }
  -1
}
// The f32 instruction variant for `op` (Slice 5), selected when an operand is f32.
// Arithmetic consumes two f32 and leaves an f32; comparisons consume two f32 and leave
// an i32 BOOL. Returns -1 for an op with no f32 form (`%`/bitwise/shift/`&&`/`||`/...);
// -1 is a HARD FAIL at the emitter, never a fall-through to the i32 path — see `emitBinExprNode`.
//   +  f32.add 0x92  -  f32.sub 0x93  *  f32.mul 0x94  /  f32.div 0x95
//   == f32.eq 0x5b   != f32.ne 0x5c   <  f32.lt 0x5d   >  f32.gt 0x5e
//   <= f32.le 0x5f   >= f32.ge 0x60
export function binOpcodeF32(op: string) {
  if op == "+" {
    return 146 // 0x92 f32.add
  }
  if op == "-" {
    return 147 // 0x93 f32.sub
  }
  if op == "*" {
    return 148 // 0x94 f32.mul
  }
  if op == "/" {
    return 149 // 0x95 f32.div
  }
  if op == "==" {
    return 91 // 0x5b f32.eq
  }
  if op == "!=" {
    return 92 // 0x5c f32.ne
  }
  if op == "<" {
    return 93 // 0x5d f32.lt
  }
  if op == ">" {
    return 94 // 0x5e f32.gt
  }
  if op == "<=" {
    return 95 // 0x5f f32.le
  }
  if op == ">=" {
    return 96 // 0x60 f32.ge
  }
  -1
}
// Find the value-expr index for declared field `fieldName` in the object literal at
// `objIx`, or -1 if the literal does not set that field.
export function objFieldVal(objIx: i32, fieldName: string) {
  const o = P.nodes[objIx]
  if o is ObjLit {
    const fields = o.objFields
    let i = 0
    while i < fields.length {
      const f = P.nodes[fields[i]]
      if f is FieldInit {
        if f.fiName == fieldName { return f.fiValue }
      }
      i = i + 1
    }
  }
  -1
}
// True when an `is` RHS names a LITERAL type (`"a"`, `0`, `1.5`) — the runtime
// value-test arm of `emitIs` (the place's literal-union ANNOTATION softened to
// the base scalar in `canonEmitTypeNames`; the `is` compares the value).
// The QUOTED-LEAF half is `tyname.nameIsQuotedLeaf` (W3); the leading-DIGIT half stays,
// and the `length == 0` guard stays in FRONT of both — the home carries no bound, because
// VL string indexing traps and the nine routed sites do not agree on the bound to fold in.
export function isLitVariantName(name: string) {
  if name.length == 0 { return false }
  if nameIsQuotedLeaf(name) { return true }
  const c = name[0]
  c >= '0' && c <= '9'
}
// True when the operand at `exprIx` is a PLACE that can be re-evaluated without side
// effects. Every multi-compare union lowering re-reads its operand once per compare
// (`emitUnionLitIs` reads it TWICE per member — tag, then payload), so a receiver that is
// not re-readable would have its effect duplicated; those sites keep their
// single-evaluation paths instead.
//
// THE BOUND IS EFFECT-FREEDOM, NOT IDENT-NESS, and the difference is a soundness one: while
// this answered NO for every non-Ident receiver, `s.f is K` over a `K | string` FIELD fell
// past `emitIs`'s litunion MEMBERSHIP arm into the bare box-tag compare below it — and
// `K ⊆ string` share kind 2's tag, so that compare answered TRUE for a non-member string,
// fail-OPEN and `vl check --codegen` clean. So: a field path, an optional-chain link and an
// element/map read are places exactly when their receiver (and a subscript) is; nothing else.
export function unionEqOperandOk(exprIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Ident { return true }
  if e is NumLit { return true }
  if e is StrLit { return true }
  if e is Member { return unionEqOperandOk(e.memObj) }
  if e is OptMember { return unionEqOperandOk(e.omObj) }
  if e is Index {
    return unionEqOperandOk(e.idxArr) && unionEqOperandOk(e.idxIndex)
  }
  false
}
// The value-eq opcode table lives once, at `emit_rep.atomEqOpcodeOfKind(k)`; the wrapper
// that re-derived `valueAtomKind(atom)` for it was deleted here rather than left as a second
// copy of the same four-arm table (D-EQOPCODE).
// The narrowing-stack KEY of a member path over a plain Ident root (`o.y`, or nested
// `n.a.b`) — the same string `setNarrowFromCond` pushes for a union-FIELD `is`/null guard.
// "" for any other receiver shape (no path narrowing).
//
// THE NODE ITSELF IS UNWRAPPED, not only its receiver (D222). Peeling a `Paren` off only the
// RECEIVER keyed `(t).v` correctly but answered "" for `(t.v)` — what the three narrowed-read
// readers pass when the member's own receiver is parenthesised — leaving the nested-PATH case
// (`(t.v).r` under `if t.v is Circle`) loud. Three functions, but SIX paren-blind reads; fixed
// once here in the key rather than three more times at the callers.
export function memberPathKeyOf(memIx: i32) {
  const m = P.nodes[unwrapParen(memIx)]
  if m is Member {
    const r = P.nodes[unwrapParen(m.memObj)]
    if r is Ident { return r.identName + "." + m.memProp }
    // A nested path (`n.a.b`) keys through its receiver's own path key — a
    // non-Ident, non-Member link (a call, an index) stays un-narrowable.
    if r is Member {
      const inner = memberPathKeyOf(m.memObj)
      if inner != "" { return inner + "." + m.memProp }
    }
  }
  ""
}
// The KEY TEXT of a LITERAL subscript — an integer literal's DIGITS, a string literal's RAW
// LEXEME (quotes and all) — or "" when the node is neither. The emitter's twin of
// `typecheck.subscriptKeyTextOf`, and deliberately the same rule: the SPELLING is the key, so
// `xs[0]` and `xs[00]` are two keys for one cell. That is over-conservative in the harmless
// direction (two keys narrow LESS, never more) and it keeps the two stages' key grammars
// comparable by eye. The string lexeme keeps its quotes, so `m[0]` and `m["0"]` — two
// different places — cannot render one key.
export function subscriptKeyLexemeOf(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return "" }
  const n = P.nodes[unwrapParen(ix)]
  if n is NumLit {
    const t = n.numText
    if t.length < 1 { return "" }
    let i = 0
    while i < t.length {
      if t[i] < '0' || t[i] > '9' { return "" }
      i = i + 1
    }
    return t
  }
  if n is StrLit { return n.strText }
  ""
}
// The narrowing-stack KEY of an INDEX place (`xs[0]`, `o.xs[0]`) — the emitter's twin of
// the checker's `placeKeyOf` Index arm, which spells the same key `base + "[" + digits +
// "]"` (typecheck.vl). "" for a variable subscript or a receiver that is not itself a
// place, both of which stay un-narrowable.
//
// SEPARATE FROM `memberPathKeyOf` ON PURPOSE. That key answers "" for an index link and a
// dozen member-shaped readers depend on it doing so; widening it would put an `xs[0].f` key
// into every one of them at once. This is the index ROOT case only — the population D451
// measured — and a `.f` hanging off a narrowed cell keeps today's un-narrowed answer.
export function indexPathKeyOf(idxIx: i32) {
  const n = P.nodes[unwrapParen(idxIx)]
  if n is Index {
    const lit = subscriptKeyLexemeOf(n.idxIndex)
    if lit == "" { return "" }
    const r = P.nodes[unwrapParen(n.idxArr)]
    if r is Ident { return r.identName + "[" + lit + "]" }
    if r is Member {
      const inner = memberPathKeyOf(n.idxArr)
      if inner != "" { return inner + "[" + lit + "]" }
    }
  }
  ""
}
// The narrowing-stack KEY of a non-identifier PLACE — a member path (`n.v`, `n.a.b`) or an
// INDEX place (`xs[0]`, `o.xs[0]`) — or "" when the node is neither. The union of the two
// keyers above, and the read-side dual of the two channels `setNarrowFromCond` already
// pushes: a place has AT MOST one of them (a `Member` node never mints an index key and an
// `Index` node never mints a member one), so the answer is unambiguous.
//
// D1014 — WHY THE READERS WANT ONE FUNCTION. The narrow for `if n.v is K[]` is banked; every
// CONSUMER (`exprRefArray`, `refListElemNameOfExpr`, `exprMap`, `mapShapeOfExpr`) asks
// `narrowedRefArrayOf`/`narrowedMapOf` with an identifier NAME and therefore never saw it —
// four different emitter floors for one lost fact. A consumer that takes an expression index
// asks through here instead, and the ident arm it already has stays exactly as it was.
export function placeNarrowKeyOf(exprIx: i32): string {
  if exprIx < 0 || exprIx >= P.nodes.length { return "" }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Member { return memberPathKeyOf(exprIx) }
  if e is Index { return indexPathKeyOf(exprIx) }
  ""
}
// The hex value of a hex-digit code point `c` (`0-9 a-f A-F`), or -1 if not hex.
export function hexDigit(c: i32) {
  if c >= '0' && c <= '9' { return c - '0' }
  if c >= 'a' && c <= 'f' { return c - 'a' + 10 }
  if c >= 'A' && c <= 'F' { return c - 'A' + 10 }
  -1
}
// Decode the raw string lexeme `raw` (with its surrounding quotes) into the i32 vector
// of code points it denotes, resolving escapes consistently with the lexer's
// `scanQuoted`. The first and last chars are the quote delimiters and are skipped. An
// unknown escape keeps the char after the backslash verbatim (the lexer's lenient
// policy). `\u{…}`/`\xXX`/`\uXXXX` with too few/invalid hex digits keep the marker
// char (`u`/`x`) verbatim — again matching the lexer — so this never fails loudly.
export function decodeStr(raw: i32[]) {
  const out: i32[] = []
  const n = raw.length
  // Strip the surrounding quote chars (raw always has at least the two delimiters).
  let i = 1
  const last = n - 1
  while i < last {
    const c = raw[i]
    if c == '\\' && i + 1 < last {
      const e = raw[i + 1]
      if e == '\n' || e == '\r' {
        // LINE CONTINUATION — a backslash immediately before a newline drops BOTH,
        // exactly as `lexer.scanQuoted` does (lexer.vl, "Line continuation"). This arm
        // is the sibling of that one and must stay in step with it: without it the
        // backslash-newline fell through to the unknown-escape tail below, which keeps
        // the char after the backslash verbatim — so the lexer read `"ab\<NL> cd"` as
        // the 5-char `ab cd` while the emitter built the 6-char `ab<NL> cd`. Two
        // decoders for one grammar disagreeing is the whole hazard this function's
        // header warns about ("resolving escapes consistently with the lexer's
        // `scanQuoted`"), and nothing in the corpus covered it.
        i = i + 2
        // A CRLF pair drops the `\n` too, so the sequence collapses to nothing.
        if e == '\r' && i < last && raw[i] == '\n' { i = i + 1 }
      } else if e == 'n' {
        out.push(10)
        i = i + 2
      } else if e == 't' {
        out.push(9)
        i = i + 2
      } else if e == 'r' {
        out.push(13)
        i = i + 2
      } else if e == '\\' {
        out.push(92)
        i = i + 2
      } else if e == '"' {
        out.push(34)
        i = i + 2
      } else if e == '\'' {
        out.push(39)
        i = i + 2
      } else if e == '0' {
        out.push(0)
        i = i + 2
      } else if e == 'b' {
        out.push(8)
        i = i + 2
      } else if e == 'f' {
        out.push(12)
        i = i + 2
      } else if e == 'v' {
        out.push(11)
        i = i + 2
      } else if e == 'x' {
        // `\xXX` — exactly two hex digits, else keep `x` verbatim.
        let h1 = -1
        let h2 = -1
        if i + 3 < last {
          h1 = hexDigit(raw[i + 2])
          h2 = hexDigit(raw[i + 3])
        }
        if h1 >= 0 && h2 >= 0 {
          out.push(h1 * 16 + h2)
          i = i + 4
        } else {
          out.push('x')
          i = i + 2
        }
      } else if e == 'u' {
        if i + 2 < last && raw[i + 2] == '{' {
          // `\u{…}` — 1-6 hex digits up to `}`.
          let cp = 0
          let cnt = 0
          let j = i + 3
          while j < last && raw[j] != '}' && hexDigit(raw[j]) >= 0 {
            cp = cp * 16 + hexDigit(raw[j])
            cnt = cnt + 1
            j = j + 1
          }
          if (
            j < last &&
            raw[j] == '}' &&
            cnt >= 1 &&
            cnt <= 6 &&
            cp <= 1114111
          ) {
            out.push(cp)
            i = j + 1
          } else {
            out.push('u')
            i = i + 2
          }
        } else {
          // `\uXXXX` — exactly four hex digits, else keep `u` verbatim.
          let u1 = -1
          let u2 = -1
          let u3 = -1
          let u4 = -1
          if i + 5 < last {
            u1 = hexDigit(raw[i + 2])
            u2 = hexDigit(raw[i + 3])
            u3 = hexDigit(raw[i + 4])
            u4 = hexDigit(raw[i + 5])
          }
          if u1 >= 0 && u2 >= 0 && u3 >= 0 && u4 >= 0 {
            out.push(u1 * 4096 + u2 * 256 + u3 * 16 + u4)
            i = i + 6
          } else {
            out.push('u')
            i = i + 2
          }
        }
      } else {
        // Unknown escape: keep the char after the backslash verbatim.
        out.push(e)
        i = i + 2
      }
    } else {
      out.push(c)
      i = i + 1
    }
  }
  out
}
// Copy a `string`'s CODE POINTS into an `i32[]` so `decodeStr` can index past the end
// safely with arithmetic.
//
// IT ITERATES RATHER THAN INDEXES, AND THAT IS THE WHOLE POINT AT STAGE 2c. `s[i]` used to
// yield a code point and now yields a UTF-8 BYTE; `for cp in s` yields a code point under
// BOTH representations. Every consumer downstream (`decodeStr`'s escape grammar, the
// `\u{…}` arm, `emitCharLitNode`'s one-code-point check) is written in code points, so this
// is the seam that has to be unit-stable — and it has to be unit-stable in a stronger sense
// than "correct after the migration": the compiler that BUILDS the next compiler is itself
// compiled by the previous one, so this function runs under the OLD representation on the
// bootstrap rung and under the NEW one thereafter. An indexed spelling gives two different
// answers on those two rungs and the self-compile fixpoint stops converging.
export function strToCps(s: string) {
  const out: i32[] = []
  for cp in s { out.push(cp) }
  out
}
// UTF-8-encode a code-point vector into the BYTE vector a Stage 2c string literal is
// built from. The inverse of `strToCps` + the decode `for cp in s` lowers to.
//
// Go-lean, per `docs/guide/strings-design.md` §Validity: a code point outside
// [0, 0x10FFFF] or inside the UTF-16 surrogate range D800..DFFF has NO UTF-8 encoding, so
// it is replaced by U+FFFD rather than trapping or rejecting. The lexer cannot produce
// either (`\u{…}` is capped at 0x10FFFF) but `fromCodePoints` can be handed anything, and
// the emitter half must agree with the runtime half arm for arm — see `emitUtf8EncFnCode`,
// which is this function transliterated into wasm and must stay in step with it.
export function cpsToUtf8(cps: i32[]) {
  const out: i32[] = []
  let i = 0
  while i < cps.length {
    let cp = cps[i]
    if cp < 0 || cp > 1114111 || (cp >= 55296 && cp <= 57343) { cp = 65533 }
    if cp < 128 {
      out.push(cp)
    } else if cp < 2048 {
      out.push(192 | (cp >> 6))
      out.push(128 | (cp & 63))
    } else if cp < 65536 {
      out.push(224 | (cp >> 12))
      out.push(128 | ((cp >> 6) & 63))
      out.push(128 | (cp & 63))
    } else {
      out.push(240 | (cp >> 18))
      out.push(128 | ((cp >> 12) & 63))
      out.push(128 | ((cp >> 6) & 63))
      out.push(128 | (cp & 63))
    }
    i = i + 1
  }
  out
}
// Peel any nested parentheses, returning the innermost wrapped expression index.
export function unwrapParen(exprIx: i32) {
  const cur = exprIx
  const node = P.nodes[cur]
  if node is Paren { return unwrapParen(node.parInner) }
  cur
}
// True when a parameter-ordered argument list failed to bind: a hole (-1, an
// unfilled parameter slot) or a length differing from the source argument
// count (a leftover named/positional arg appended past the slots).
export function directArgsBad(args: i32[], callIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    if args.length != c.callArgs.length { return true }
  }
  let i = 0
  while i < args.length {
    if args[i] < 0 { return true }
    i = i + 1
  }
  false
}
// The inferred NICHE-nullable name for an un-annotated function `name` — "boolean|null" or
// "string|null" (canonicalized), or "" otherwise. A niche nullable lowers via its sentinel /
// `ref.null $array` rep (not the value box), so it is recognized by NAME from the A20
// inferred-return table rather than by a `fn.fnRet` annotation node. The two TESTS are
// `nameIsNulBool` / `nameIsNulString`, the one home for each niche's spelling: do NOT
// re-spell them as WHOLE-SPELLING equalities (`im == "boolean|null"`), which decides a
// COMPOSITE type by matching rendered characters. The RETURNED strings stay literal — they
// are this function's published protocol, i.e. a RENDER, the one use of a spelling allowed.
// NOT ROUTED TO THE ARENA, deliberately: `recordInferRet` stores the spelling the checker
// CHOSE and the type it was choosing ABOUT in one row — a decision and its input, not two
// encodings of one type — and the recorded tyIx does NOT agree with the recorded name, so
// asking the arena here answers a different question. docs/internals/destringify-types-program.md
export function inferNicheNullByName(name: string) {
  const im = inferRetNameOf(name)
  if nameIsNulBool(im) { return "boolean|null" }
  if nameIsNulString(im) { return "string|null" }
  ""
}
// ── the type-name DEPTH WALK: the checker's `tyTopIndexOf` IS the home ────────
// Do NOT hand-write another bracket ladder here. This file's eight copies differed only in
// what they did at depth 0, and every `<>` repair had to be applied to each separately, one
// PR at a time — a copy not yet visited ran its depth NEGATIVE on a generic argument list.
// AND THAT WAS A BUG FIX, NOT TIDYING: the emitter's ladder was quote-BLIND where the home
// skips quoted literal members escape-aware (`skipQuotedName`), so a separator INSIDE a
// literal member (`Box<"a,b" | "c" | null>`) read as top-level and the annotation was rebuilt
// from the rubble — and some of those were not even loud, they emitted a module the runtime
// could not parse. See `docs/internals/destringify-types-program.md`.
// The home's `'='` means the function ARROW `=>`, not a bare `=`: it matches only when the
// NEXT character is `>`. `sep` must not itself be a grouper (every caller separates on `|` or
// `,`) — the grouper arms are tested first — and the home returns at the FIRST hit.

// THE ONE HOME of the type-name depth walk, "WRAPS" form: does the group opened by `name[0]`
// run to the END of `name` — no closer bringing the depth back to 0 before the final
// character? Callers gate on the OPENER themselves, so the scan starts at index 1 with the
// opener already counted. (The SPLIT form is NOT here: `tyTopLevelSplit` lives in
// `tyname.vl`, because its other two writings were in `typecheck.vl`, one module BELOW.)
// The body is `tyGroupEndIndex` plus one `e < 0` arm, and THAT ARM IS THE WHOLE DIVERGENCE
// from `tyname.parenEnclosesWhole`, which asks `tyGroupEndIndex(name, 1) == name.length - 1`:
// on a group that NEVER closes (`{{x}`, `(((a)`) it answers FALSE where this answers TRUE.
// That is the PEEL's reading — a peel answering TRUE on a never-closing group would cut a
// character the group never claimed — and this is the SPAN's; both are correct for their own
// consumers, so do NOT merge them by eyeball. The quote skip comes with the home and is a fix:
// a quoted CLOSER (`{v: "a}b" | "zz"}`) closed the group EARLY. destringify-types-program.md.
export function tyGroupWrapsWhole(name: string) {
  const e = tyGroupEndIndex(name, 1)
  if e < 0 { return true }
  e == name.length - 1
}
// ── nullable struct refs (`S | null`) ─────────────────────────────────────────
// "S|null" / "null|S" (exactly TWO `|` parts, one of them `null`) → the non-null
// part's name, or "" when the name is not a two-part nullable.
export function nullablePartOf(name: string) {
  // Depth-aware: a `|` INSIDE an inline shape (`{y:string|i32}|null`) is part of
  // the FIELD's union, not the nullable wrapper — only a depth-0 bar splits. And a `|`
  // inside a quoted literal member is part of the member's TEXT: the home skips it.
  const bar = tyTopIndexOf(name, '|', 0, 0)
  if bar < 0 { return "" }
  const a = name.slice(0, bar)
  const b = name.slice(bar + 1, name.length)
  if a == "null" { return b }
  if b == "null" { return a }
  ""
}
// `1` if the type-annotation node at `tyIx` is a NULLABLE STRUCT (`S | null` with a
// resolvable struct part), else `0`. Feeds the `kind == 9` (nullable struct ref,
// `0x63`) family.
// True if the annotation node at `tyIx` is `boolean|null` — the NICHE scalar
// nullable (host: `nullSentinel`): an i32 holding 0/1, with the spare value 2
// encoding `null` (no box). `== null` is a sentinel compare; narrowing to
// non-null is purely type-level (the i32 is already 0/1 in the branch).
export function tyIsNulBool(tyIx: i32) {
  // STRUCTURAL (destringify): the ARENA decides — a `TyNullable` over the `boolean` prim.
  // Mirrors `retNulStringFlag`, whose `nodeTyIsNulString` leg is this test's `string` sibling.
  nodeTyIsNulBool(tyIx)
}
// True if the type-annotation node at `tyIx` is `boolean`/`bool`.
// STRUCTURAL (destringify): the ARENA decides, matching the `tyIsNulBool` sibling directly above,
// which has been arena-side since its own slice while this non-null twin was left on the spelling.
//
// `nodeTyPrimName` and NOT the already-imported `nodeTyWidenedRepName`, though the two are
// provably equal for the constant `"boolean"`. The widened form is a SUPERSET twin — it adds a
// litunion arm returning `"string"` and a `softenLitTy` arm — and using a superset for a constant
// it happens not to reach is the shape that broke six tests one slice ago. There is no `boolean`
// literal type to soften (`litKind` is only `"str"`/`"flt"`/int), so the exact form is available
// and is what this asks.
export function tyIsBool(tyIx: i32) { nodeTyPrimName(tyIx) == "boolean" }
// True if `name` is a nullable i32-BACKED list — `i32[] | null`, `boolean[] | null`, or a
// literal-union `K[] | null` / `("a"|"b")[] | null` (parser-joined `…|null`, depth-aware either
// side of the bar). `boolean[]` (an i32 0/1) and a litunion array (interned-i32 atom elements)
// share the i32-list REP exactly, so they ride the SAME nullable i32-list kind/field-code (18 /
// `nullist`) as `i32[] | null` — one predicate, every i32-backed leaf, mirroring `nameIsI32Array`
// at the non-nullable position. A scalar-elem (`f64[]|null`, `i64[]|null`, `f32[]|null`,
// `string[]|null`) or ref-elem (`S[]|null`) list has a DISTINCT backing and keeps failing loudly.
export function nameIsNulI32List(name: string) {
  nameIsI32Array(nullablePartOf(name))
}
// A `string | null` field type name — the niche FIELD (code 20): a `(ref null $sTypeIdx)`
// storage slot (the array backing a string), the field analogue of the kind-16 local.
export function nameIsNulString(name: string) {
  nullablePartOf(name) == "string"
}
// A `boolean | null` field type name — the niche FIELD (code 21): an i32 storage slot
// holding 0/1 with the spare value 2 = `null` (the field analogue of the sentinel local).
export function nameIsNulBool(name: string) {
  const b = nullablePartOf(name)
  b == "boolean"
}
// True if `name` is a 1-D `(boolean | null)[]` list — a LIST of the boolean sentinel
// niche. Its backing is the SAME `(array (mut i32))` as `boolean[]` / `i32[]`: each
// element is an i32 holding 0/1, with the spare value 2 = `null` (the list analogue of
// the scalar `boolean | null` niche — no box). So it rides the i32-list machinery
// (`nameIsI32Array`) rather than the union-box ref-list, and elements coerce/read
// through the sentinel (construct/`push`/index-assign seed `null → 2`; a read compares
// against 2). A nested `(boolean|null)[][]` / nullable `(boolean|null)[] | null` is NOT
// this (their element is a LIST, not the scalar niche) — only the single-level list.
export function nameIsNulBoolList(name: string) {
  const elem = listElemNameOf(name)
  if elem == "" { return false }
  nameIsNulBool(elem)
}
// True if `name` is a 1-D `(string | null)[]` list — a LIST of the string ref made nullable.
// Its backing is the SAME string list (`$mkListIdx` wrapper, `(ref null $sTypeIdx)` string backing)
// as `string[]`: a `string[]` element is ALREADY a NULLABLE ref at the wasm level, so the nullable
// element needs no new type — only `null → ref.null $aTypeIdx` on construct and the element READ
// (kept `(ref null)` = a `nulstr`, narrowed with `!= null`) differ. Rides the string-list machinery
// (`retStrArrFlag`, via `nodeTyArrayElemRepName` → "string"), NOT the union-box ref list. A nested
// `(string|null)[][]` / nullable `(string|null)[] | null` is NOT this (their element is a LIST).
export function nameIsNulStrList(name: string) {
  const elem = listElemNameOf(name)
  if elem == "" { return false }
  nameIsNulString(elem)
}
// The re-quoted source LEXEME for a literal-union member's inner text (`i32` -> `"i32"`) — matches
// the raw `StrLit.strText` so `internAtom` yields the SAME id, and feeds a synthetic `StrLit` for
// printing. Down here rather than beside the emit that widens with it, because MEMBERSHIP ("is
// this `StrLit` default one of the niche's members?") is asked by a CLASSIFIER too, and the
// membership test and the interning must agree on the lexeme by construction.
export function quoteLex(inner: string) {
  const q = "\""
  q + inner + q
}
// True if the raw `StrLit` lexeme `lex` is one of the literal-union member `texts` — the ONE
// membership test, keyed on the LEXEME rather than the default's banked type. A member literal in
// a `??` DEFAULT position is not typed `TyLit` by the checker (the join carries the type), so a
// banked-type answer says "not a member" about `"aa"` as readily as about `"zz"`.
export function litLexIsMember(lex: string, texts: string[]) {
  let i = 0
  while i < texts.length {
    if quoteLex(texts[i]) == lex { return true }
    i = i + 1
  }
  false
}
// True if `name` is a 1-D `(K | null)[]` list — a LIST of the literal-union atom made nullable via
// the i32 NICHE. Its backing is the SAME `(array (mut i32))` as `K[]` / `i32[]`: each element is an
// i32 holding a member id (≥ 0) with the spare value `-1` = `null` (the list analogue of the scalar
// `K | null` niche — no box). So it rides the i32-list machinery (`nameIsI32Array`), NOT the
// union-box ref-list: a member-literal element lowers as its atom id, a `null` element as `-1`, and a
// read compares against `-1` for the narrow. A nested `(K|null)[][]` / nullable `(K|null)[] | null` is
// NOT this (their element is a LIST, not the scalar niche) — only the single-level list.
export function nameIsNulLitUnionList(name: string) {
  const elem = listElemNameOf(name)
  if elem == "" { return false }
  nameIsNulLitUnion(elem)
}
// A NULLABLE LITERAL-UNION type name — `K | null` / `"a" | "b" | null` (the i32 atom NICHE): the
// member ids are interned ≥ 0 and the spare value `-1` encodes `null` (no box, like the boolean
// niche but with a NEGATIVE sentinel since atom ids start at 0). `canonEmitName` PRESERVES the
// litunion (`nulLitUnionPreserve`) so the members survive here — a `K | null` is detected by the
// alias non-null part (`nullablePartOf` → litunion), and the expanded inline form `"a"|"b"|null` by
// its all-quoted non-null members. Routes to `vtKindOfType` kind 0 (plain i32); `== null` is a
// `-1` compare and narrowing to the bare litunion is purely type-level (the i32 already holds a
// valid id in the non-null branch).
// It is the PREDICATE form of `nulLitUnionInnerName`, which is the primitive: the niche
// exists exactly when there IS a non-null litunion part to name, so one function decides
// both and they cannot disagree.
export function nameIsNulLitUnion(name: string) { nulLitUnionScan(name) }

// The PREDICATE, decided without building anything. `nulLitUnionInnerName` is still the
// primitive for the two callers that want the NAME, but this one only ever compared its
// result to `""` — and producing that result cost a `splitUnionAtoms` (one allocated string
// per member) plus a `" | "` re-JOIN of the members it kept, all discarded.
//
// Same scanner, same bounds, same top-level `=>` stop as the split; the per-member tests are
// the same three in span form (`nameIsQuotedLeaf` is `name[0] == '"'`, so it is a single
// character read at the span's start). Zero allocations.
//
// Measured against `nulLitUnionInnerName(name) != ""` before the swap: **34,052 reaches, 0
// disagreements.**
function nulLitUnionScan(name: string): boolean {
  const b = nullablePartOf(name)
  if b != "" { return nameIsLitUnionType(b) }
  let lits = 0
  let hasNull = false
  let start = 0
  let going = true
  while going {
    const at = tyTopIndexOf(name, '|', '=', start)
    let end = name.length
    if at >= 0 && name[at] != '=' { end = at } else { going = false }
    if spanEqAt(name, start, end, "null") {
      hasNull = true
    } else {
      if end - start < 2 { return false }
      if name[start] != '"' { return false }
      lits = lits + 1
    }
    if going { start = at + 1 }
  }
  hasNull && lits >= 2
}
// THE ONE HOME of the nullable-litunion niche. The NON-null part of a nullable-litunion
// name — the litunion alias (`K` of `K | null`) or the re-joined quoted members of the
// expanded inline form (`"a" | "b"` of `"a" | "b" | null`). "" when `name` is not a
// nullable litunion, which is also the "no" of the predicate above.
//
// This family was FOUR functions asking the SAME name the SAME question up to FIVE times:
// `nameIsNulLitUnion` scanned for the nullable split, then split the union in
// `nameHasNullMember`, then split it AGAIN in `nulLitUnionCore`; `nulLitUnionInnerName`
// called that whole cascade and then re-derived the nullable split and the union split for
// itself. The expanded form is decided by ONE pass over ONE split now — a top-level `null`
// member, and 2+ non-null members that are ALL quoted string literals — and the same pass
// builds the answer it was deciding about.
export function nulLitUnionInnerName(name: string) {
  // Two-part `K | null`: the non-null part is a litunion alias / inline union.
  const b = nullablePartOf(name)
  if b != "" {
    if nameIsLitUnionType(b) { return b }
    return ""
  }
  // Expanded multi-member form `"a" | "b" | null`: a top-level `null` member plus an
  // all-quoted-literal remainder (2+ members, so `nullablePartOf`'s two-part split missed
  // it). The literal test rejects on the FIRST unquoted member, exactly as `nulLitUnionCore`
  // did; reaching that reject before seeing the `null` member is the same answer, since both
  // conditions were required.
  const parts: string[] = []
  splitUnionAtoms(name, parts)
  let lits = 0
  let hasNull = false
  let out = ""
  let i = 0
  while i < parts.length {
    const p = parts[i]
    if p == "null" {
      hasNull = true
    } else {
      if p.length < 2 { return "" }
      // The QUOTED-LEAF test at its home (`tyname.nameIsQuotedLeaf`, W3); this site's own
      // `length < 2` bound stays in front of it.
      if !nameIsQuotedLeaf(p) { return "" }
      lits = lits + 1
      if out == "" { out = p } else { out = out + " | " + p }
    }
    i = i + 1
  }
  if !hasNull { return "" }
  if lits < 2 { return "" }
  out
}
// A NULLABLE FUNCTION-VALUE type name — `((i32) => i32) | null` (kind 19): a
// `(ref null $cloStruct)` cell, the closure analogue of the nullable struct (kind 9). The
// non-null part must be a FUNCTION type, and the WHOLE name must NOT itself be a top-level
// function type — `((i32) => i32) | null` (parens preserved by `canonEmitName`, arrow
// nested at depth 1) is a nullable function, whereas `(i32) => i32 | null` (top-level
// arrow) is a function RETURNING a nullable (handled by `annRetKind`, not here).
export function nameIsNulClosure(name: string) {
  if annArrowAt(name) >= 0 { return false }
  const b = nullablePartOf(name)
  if b == "" { return false }
  // The non-null part must itself BE a closure — a TOP-LEVEL arrow once its disambiguating
  // grouping parens are peeled (`((i32) => i32)` → `(i32) => i32`). It is NOT enough to merely
  // CONTAIN a `=>`: `((i32) => boolean)[] | null` is a nullable ARRAY of closures and
  // `{f: () => i32} | null` a nullable STRUCT — the closure is nested in a composite, so the
  // whole is a nullable ref-array / nullable struct, not the closure niche (kind 19). Mis-
  // classifying them as nulclosure typed the field/binding slot `(ref null $cloStruct)` and the
  // construct stored a ref-array wrapper into it — invalid wasm.
  //
  // `nameIsFuncTypeAtom` IS "peel every fully-enclosing grouping-paren layer, then test for a
  // top-level arrow", and it is the predicate the sibling `nullClosureArrElem` already calls to
  // ask the IDENTICAL question of the identical kind of name — so do not spell the peel and the
  // arrow scan out here a second time.
  nameIsFuncTypeAtom(b)
}
// True if the ref-list ELEMENT name `name` is a CLOSURE CELL — ref-list element kind 5, the
// shared closure fat-pointer. A `=>` ANYWHERE IN THE NAME IS NOT THE QUESTION: an element name
// is a whole type spelling, and a closure can sit arbitrarily deep inside one that is not a
// closure — a struct FIELD (`{f: () => i32}`), a map VALUE, a union MEMBER (`(() => i64) |
// i64`). Claiming those for the closure slot types the element cell `(ref $cloStruct)` and the
// construct stores a struct / map / union-box wrapper into it.
// THE THREE ARMS ARE AT THREE DIFFERENT CONFIDENCES, AND THE ORDER RECORDS WHICH: (1) the
// element IS a closure — a TOP-LEVEL arrow after peeling grouping parens, the exact test both
// sibling predicates use; (2) a bare `{…}` SPAN, struct shape or map, is never a closure cell
// whatever it contains; (3) anything else keeps the coarse substring answer, reached by a UNION
// with a closure member, which is a union BOX and not a closure. Narrowing arm 3 away is a
// SEPARATE slice with its own measurement — it moves corpus modules — not this one's business.
export function nameIsClosureElem(name: string) {
  if nameIsFuncTypeAtom(name) { return true }
  if nameIsNulClosure(name) { return true }
  if nameIsBraceSpanEnds(name) { return false }
  strContains(name, "=>")
}
// `1` if the type-annotation node at `tyIx` is a nullable function `(fn) | null`, else `0`
// — the closure dual of `retNulRefFlag`.
//
// PURELY STRUCTURAL, like the four nullable-niche siblings below it (`retNulListFlag`,
// `retNulStringFlag`, `nameIsClosureArrayTy`, `tyIsNulBool`): the `Ty` arena is the ONLY
// source, and an annotation node the arena does not cover answers `0` rather than falling
// back to a re-parse of the node's synthetic name. The name ladder these five carried is
// NOT merely redundant — it is unreachable in the answering direction. Measured over the
// corpus (`vl check tests/cases --codegen`, one `tErr` per band per file): 19 files reach
// an UNCOVERED annotation node in these five (18 of them in `nameIsClosureArrayTy`), and
// the name test answers YES on ZERO of them, while the ARENA band answers YES on 24 files
// and is entered on 1,197 — so the fallback could only ever have re-derived the default.
export function nulCloFlag(tyIx: i32) {
  if nodeTyIsNulClosure(tyIx) { return 1 }
  0
}
// `1` if the type-annotation node at `tyIx` is `i32[] | null`, else `0` — the
// nullable-LIST dual of `retNulRefFlag`. Feeds vt kind 15 (a NULLABLE `(ref null
// $lTypeIdx)` slot: narrowing is type-level only, the slot stays nullable and
// each list-op read site recovers non-null — mirroring the host's lowering, see
// tests/cases/types/nullable-list-index.vl's header).
// The scalar type NAME used to classify annotation node `tyIx`, read STRUCTURALLY from the
// checker's `Ty` arena (`nodeTyPrimName`) when it recorded a type for the node, else falling
// back to the parser's synthetic annotation name (`tyNameOf`) for a node the checker did not
// record. Byte-identical to the pure-name form (a scalar's arena prim-name equals its
// annotation name), but reads the CHECKED type where available — a first step of C1 (thread
// the structured `Ty` to the emitter). The name fallback shrinks as more annotation-resolution
// sites populate `nodeTyIx`.
function nodeScalarName(tyIx: i32) {
  // `nodeTyWidenedRepName` (not the raw `nodeTyPrimName`) so a SINGLE literal / homogeneous
  // numeric literal union widens to its base scalar name here too — `retI64Flag`/`retF64Flag`/
  // `retF32Flag` then fire for a `: 1.5` / `: 7`-annotated param/return, matching the widened
  // value. It is a SUPERSET of `nodeTyPrimName` for prims (identical), adding the lit widening;
  // the extra "string" it yields for a string literal/atom matches none of the numeric/bool flags.
  if nodeTyIxOf(tyIx) >= 0 { return nodeTyWidenedRepName(tyIx) }
  ""
}
// The array ELEMENT-REP name for classifying annotation node `tyIx` — STRUCTURAL from the `Ty`
// arena (`nodeTyArrayElemRepName`) where the checker recorded a type, else derived from the
// synthetic name for a node it did not record. Byte-identical to the per-classifier `nameIsX[]`
// tests; the `ret*ArrFlag` family reads it (C1). The name fallback shrinks as coverage widens.
function arrElemRep(tyIx: i32) {
  if nodeTyIxOf(tyIx) >= 0 { return nodeTyArrayElemRepName(tyIx) }
  ""
}
export function retNulListFlag(tyIx: i32) {
  if nodeTyIsNulI32List(tyIx) { return 1 }
  0
}
// `1` if the type-annotation node at `tyIx` is the i32 array type (`i32[]`), else `0`.
// The functype/local valtype layer multiplexes the struct/array/i32 cases through one
// `kind` code, so this flat flag feeds the `kind == 2` (array) branch of `pushVT`. A REF
// array (`S[]`/`N[]`) is NOT this — it feeds `kind == 5` via `retRefArrFlag`.
export function retArrFlag(tyIx: i32) {
  if arrElemRep(tyIx) == "i32" { return 1 }
  0
}
// `1` if the type-annotation node at `tyIx` is `string`, else `0`. A string is
// CURRENTLY the SAME `(array (mut i32))` of code points an array uses, so it feeds the
// `kind == 3` branch of `pushVT` (which encodes the identical array ref valtype).
export function retStrFlag(tyIx: i32) {
  // An ALIASED literal-union return (`type K = "a" | "b"`; `pick(): K`) reps as an i32
  // ATOM — `vtKindOfType` derives its functype result i32 (`nodeTyIsLitUnionAlias`), so
  // its `"str"` return kind must agree. `nodeTyWidenedRepName` renders every litunion
  // "string" (the print-widening name), which flagged the atom return a string; every call-result
  // consumer (`fnRetStringSid` → `exprString`, the inferred-return chain) then treated the
  // returned i32 atom as a string ref — `print(pick(ks))` / `useK(pick(ks))` routed it to
  // the string-ref path (invalid wasm). The atom widens to its member string at the print
  // seam (`exprIsLitAtom`), not by claiming a string RETURN. An INLINE litunion
  // (`"a" | "b"` written at the annotation) reps as the string ref (its functype result
  // is the `retStrFlag` fallthrough below), so it must stay flagged — the guard is
  // alias-only, matching `vtKindOfType`.
  if nodeTyIsLitUnionAlias(tyIx) { return 0 }
  if nodeTyWidenedRepName(tyIx) == "string" { return 1 }
  0
}
// `1` if the type-annotation node at `tyIx` is `boolean`/`bool`, else `0`. A bool
// rides in an i32 at the wasm level — this feeds ONLY the `print` import choice
// (`fRetBool`), never a valtype.
export function retBoolFlag(tyIx: i32) {
  if nodeScalarName(tyIx) == "boolean" { return 1 }
  0
}
// `1` if the type-annotation node at `tyIx` is `void`, else `0`. Seeds `fRetVoid` in
// `buildFnMap`, so a DECLARED `: void` function gets the 0-result functype and the
// void tail/return lowering — the same classification an INFERRED-void function earns
// from `computeVoidFns`. Before this seed a `: void` annotation was invisible to the
// emitter: the functype defaulted `(result i32)`, an effect-only body was padded with
// a live `unreachable` (calling it TRAPPED), and a ref-valued tail was check-clean
// INVALID wasm. Arena-first (the checker records `TY_VOID` on the annotation node);
// the name fallback covers the SYNTHESIZED `void` TypeRefs (`synthRetAnnots`'s
// void-context lambda pin, `synthVoidTwins`' twins), which carry no arena record.
export function retVoidAnnFlag(tyIx: i32) {
  if tyIx < 0 { return 0 }
  if nodeTyPrimName(tyIx) == "void" { return 1 }
  if tyNameOf(tyIx) == "void" { return 1 }
  0
}
// `1` if the type-annotation node at `tyIx` is a `string | null` — the NULLABLE string
// ref `(ref null $sTypeIdx)`, kind 16. A `string` is the raw i32 array `(ref $sTypeIdx)`;
// the nullable form is the same backing made nullable (`null` is `ref.null`, `!= null`
// is `ref.is_null`). Checked in `vtKindOfType` BEFORE the bare `string` (kind 3).
export function retNulStringFlag(tyIx: i32) {
  if nodeTyIsNulString(tyIx) { return 1 }
  0
}
// Combine the struct/array/string flags for a type-annotation node at `tyIx` into the
// single `pushVT` `kind` code: `1` struct, `2` array, `3` string, `0` i32. (Struct
// wins if a name were somehow both — it cannot be, the lexemes are disjoint.) String
// is a distinct code from array purely for typedness clarity. Since Stage 2b a string is
// the HEADER struct `$sTypeIdx` and an array is `$lTypeIdx`, so `pushVT` emits two DIFFERENT
// ref valtypes — `fbValtype`'s `"str"` and `"list"` arms. The two codes are what pick them.
// STRUCTURAL (destringify): the annotation node at `tyIx` is an array whose ELEMENT is a
// NULLABLE closure (`(((i32) => boolean) | null)[]`) — a `TyArray` over a `TyNullable` over a
// `TyFunc`. The arena dual of `nullClosureArrElem(tyNameOf(tyIx)) != ""`: `nullClosureArrElem`
// answers the same question by string surgery (peel the `(...)[]` element, split the `| null`,
// re-test the non-null part for a top-level arrow). `nodeTyIsClosureArray` covers only the
// BARE-closure element, so this is the nullable-element arm of the same kind-5 classifier.
function tyIsNulClosureArrayNode(tyIx: i32) {
  const ty = nodeTyIxOf(tyIx)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyArray {
    const e = t.aElem
    if e >= 0 {
      const et = T.tys[e]
      if et is TyNullable {
        const inner = T.tys[et.nInner]
        if inner is TyFunc { return true }
      }
    }
  }
  false
}
// `1` if the type-annotation node at `tyIx` is an ARRAY OF FUNCTIONS (`((i32) => i32)[]`),
// else `0` — the closure-element ref-list guard `vtKindOfType` checks before the kind-14
// function-type test.
export function nameIsClosureArrayTy(tyIx: i32) {
  if nodeTyIsClosureArray(tyIx) { return 1 }
  // A NULLABLE-closure-element array (`(((i32) => boolean) | null)[]`, kind-5 niche):
  // `nodeTyIsClosureArray` has no nullable-element arm, so the SAME arena spine answers
  // it here (destringify) — a `TyArray` over a `TyNullable` over a `TyFunc`, replacing
  // the `nullClosureArrElem` string surgery over the annotation's rendered name.
  if tyIsNulClosureArrayNode(tyIx) { return 1 }
  0
}
// `1` if the type-annotation node at `tyIx` is an `f64[]` (the f64-element list), else
// `0`. Feeds the `kind == 12` (f64-list wrapper) branch of `fbValtype`/`pushVT`. Checked
// BEFORE the `retRefArrFlag`/`retArrFlag` cases since `f64[]` is an `[]` array name but
// is neither a struct/union ref list nor the i32 list. (Slice 4.)
export function retF64ArrFlag(tyIx: i32) {
  if arrElemRep(tyIx) == "f64" { return 1 }
  0
}
export function retF32ArrFlag(tyIx: i32) {
  if arrElemRep(tyIx) == "f32" { return 1 }
  0
}
// `1` if the type-annotation node at `tyIx` is `i64[]` — the i64-list rep (kind 20).
export function retI64ArrFlag(tyIx: i32) {
  if arrElemRep(tyIx) == "i64" { return 1 }
  0
}
// `1` if the type-annotation node at `tyIx` is `i64`, else `0`. A scalar i64
// param/result/local/global classifies as kind 10 (valtype `0x7e`); checked LAST
// (after every ref/array case) since `i64` is a plain TypeRef name like `i32`.
export function retI64Flag(tyIx: i32) {
  if nodeScalarName(tyIx) == "i64" { return 1 }
  0
}
// `1` if the type-annotation node at `tyIx` is `f64`, else `0`. A scalar f64
// param/result/local/global classifies as kind 11 (valtype `0x7c`); checked LAST
// (alongside `retI64Flag`) since `f64` is a plain TypeRef name like `i32`. (Slice 3.)
export function retF64Flag(tyIx: i32) {
  if nodeScalarName(tyIx) == "f64" { return 1 }
  0
}
// `1` if the type-annotation node at `tyIx` is `f32`, else `0`. A scalar f32
// param/result/local/global classifies as kind 13 (valtype `0x7d`); checked LAST
// (alongside `retI64Flag`/`retF64Flag`) since `f32` is a plain TypeRef name like `i32`.
// (Slice 5.)
export function retF32Flag(tyIx: i32) {
  if nodeScalarName(tyIx) == "f32" { return 1 }
  0
}
// `1` if the type-annotation node at `tyIx` is a `string[]` (string-ref list), else `0`.
// Feeds the `kind == 7` (string-list wrapper) branch of `pushVT`. Checked BEFORE the
// `retRefArrFlag`/`retArrFlag` cases since `string[]` is an `[]` array name but is NOT a
// struct/union ref list nor the i32 list — it is the dedicated string-ref list.
export function retStrArrFlag(tyIx: i32) {
  if arrElemRep(tyIx) == "string" { return 1 }
  0
}
// The `array.new_fixed` operand cap engines enforce (V8/binaryen/wasmtime reject
// more than 10,000 operands). A literal longer than this cannot lower as one
// `array.new_fixed`: in a FUNCTION body it builds chunked (`array.new_default` +
// per-chunk `array.new_fixed`/`array.copy` — see `emitStr`/`emitArr`), and a
// GLOBAL initializer holding one is routed through the start function
// (`isConstInit` below returns false — a wasm constant expression has no locals
// to chunk through).
export const NEW_FIXED_MAX = 10000
// Whether the initializer expression at `exprIx` is a valid WasmGC *constant expression* —
// the forms `emitProgram` already lowers inline in the global section (`i32.const`,
// `struct.new`, `array.new_fixed`, the string array). Const: `NumLit` / `CharLit` / `BoolLit`,
// `StrLit`, an `ArrayLit` or `ObjLit` whose elements / field values are ALL const, and a
// `Paren` wrapping a const. EVERYTHING ELSE is non-const — an `Ident` (a `global.get`), a
// `Member` / `Index` (the `curBuf = W.bytes` shape), a `Call`, a `BinExpr` / `Unary`, an
// `IsExpr`. A literal past the `array.new_fixed` operand cap is non-const too: it must build
// CHUNKED through locals, which only a function body has (the raw `strText` length bounds the
// decoded length from above, so the `+ 2` quote allowance never under-routes a too-long
// string). CONSERVATIVE by construction — an unrecognized node falls through to `false`, so a
// form we have not proven const-safe is initialized via the start function rather than emitted
// as an invalid constexpr.
export function isConstInit(exprIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is NumLit { return true }
  if e is CharLit { return true }
  if e is BoolLit { return true }
  if e is StrLit { return e.strText.length <= NEW_FIXED_MAX + 2 }
  if e is Paren { return isConstInit(e.parInner) }
  if e is ArrayLit {
    if e.arrElems.length > NEW_FIXED_MAX { return false }
    let i = 0
    while i < e.arrElems.length {
      if !isConstInit(e.arrElems[i]) { return false }
      i = i + 1
    }
    return true
  }
  if e is ObjLit {
    let i = 0
    while i < e.objFields.length {
      const f = P.nodes[e.objFields[i]]
      if f is FieldInit {
        if !isConstInit(f.fiValue) { return false }
      } else {
        return false
      }
      i = i + 1
    }
    return true
  }
  false
}
// ── the ARRAY-NAME grammar: `nameIsArray` TESTS it, `arrElemNameRaw` CUTS it ───────────
//
// **BOTH HOMES ARE IN `tyname.vl` (D-ARRDOWN), AND THE FULL HEADERS LIVE THERE.** They are
// pure character grammars; four of the checker's own functions hand-wrote the two-character
// suffix test, three of them the cut, because `typecheck.vl` cannot import THIS file. What
// follows are the LAYERS the emitter adds over them.
//
// THE ONE HOME of the array-name TEST's second spelling: `nameIsArray` with a NON-EMPTY
// element — `nameIsArray` MINUS exactly one name, the degenerate `"[]"` — which is precisely
// the guard half of `arrElemNameRaw(name) != ""` and agrees with it by construction. A LAYER,
// not a second copy: the compares live once at the home, this adds only the length bound, and
// routing through the cut instead would allocate a slice to answer a boolean in inner loops.
export function nameIsElemArray(name: string) {
  if name.length < 3 { return false }
  nameIsArray(name)
}
// THE ONE HOME of the ARRAY-DIMENSION peel: `name` with EVERY trailing `[]` pair removed
// (`{f: i32}[][]` → `{f: i32}`, `S[]` → `S`, `S` → `S`). Unlike `arrElemNameRaw` this never
// answers "": a non-array name is its own leaf, which is what all five hand-written copies
// did (they are `while`-loops that simply do not iterate). Three of those copies then asked
// the SAME next question of the leaf (`leaf[0] == '{' && leaf[1] != '['`), which is why the
// drift risk is real rather than theoretical: a peel that stopped one level short hands a
// `{…}[]` to a test that only accepts `{…}`.
//
// It is the CUT home applied to fixpoint, not a second copy of the cut: the loop body calls
// `arrElemNameRaw` and advances only while that yields a non-empty element, so the degenerate
// `"[]"` terminates the peel rather than looping. (`nameIsNestedUnionElemArray` below runs the
// same shape by hand because it needs the LAST array-name rung, not the leaf.)
export function arrLeafNameOf(name: string) {
  let leaf = name
  let done = false
  while !done {
    const nx = arrElemNameRaw(leaf)
    if nx == "" { done = true } else { leaf = nx }
  }
  leaf
}
// ── the PAREN grammar and the SCALAR-ARRAY classifiers: homes and full headers in `tyname.vl`
// (D-PARENDOWN, D-ARRDOWN); this file only layers over them. THE TWO PAREN WALKS ARE NOT ONE:
// `peelGroupParens` rides `parenEnclosesWhole`, `normTypeAtom` rides `tyGroupWrapsWhole`, and
// they differ on a group that NEVER CLOSES — the former FALSE, the latter TRUE. That is
// load-bearing, and a site that spells the comparison out rather than calling one of the two is
// making that merge silently. THE FIVE SCALAR-ARRAY CLASSIFIERS ARE `arrElemNameRaw(name) ==
// "<elem>"`, NOT a whole-spelling equality (`name == "f64[]"`) fusing STRUCTURE and NAME into
// one opaque character match; the two are provably equivalent, and the cut is the shape the
// arena-side twin already ships (`arrElemRep(tyIx) == "f64"`). Widening it to `listElemNameOf`,
// which would also accept `(f64)[]`, is DECLINED for want of a witness —
// `tests/cases/arrays/paren-wrapped-scalar-elem.vl` pins that. Below: `i32[]`, whose rep
// `boolean[]` shares (only `listElemIsBool` recovers boolean-ness); a `T[]`/`N[]` is NOT this.
export function nameIsI32Array(name: string) {
  // The two i32-backed leaf spellings share one cut — the family note above.
  if arrElemIs(name, "i32") || arrElemIs(name, "boolean") { return true }
  // `(boolean | null)[]` shares the exact i32-list backing: each element is an i32 0/1
  // with the spare value 2 = `null` (the sentinel niche). Only the `null → 2` element
  // coercion + the sentinel-aware read/print differ (see `nameIsNulBoolList`).
  if nameIsNulBoolList(name) { return true }
  // A literal-union array (`K[]`, or an inline `("a"|"b")[]`) — its elements are interned-i32
  // ATOMS, so it shares the i32 backing/rep EXACTLY like `i32[]`. (Element construction seeds
  // `pendingLitUnion` so the member literals lower as their ids; reads yield the atom.)
  if nameIsLitUnionArray(name) { return true }
  // A `(K | null)[]` shares the exact i32-list backing: each element is an i32 member id (≥ 0)
  // with the spare value `-1` = `null` (the atom-niche analogue of `(boolean | null)[]`). Only the
  // `null → -1` element coercion + the sentinel-aware read differ (see `nameIsNulLitUnionList`).
  if nameIsNulLitUnionList(name) { return true }
  false
}
// True if `name` is `<litunion>[]` — an array whose element type is a literal union. The element
// name is `name` minus the trailing `[]` (a parenthesized inline union keeps its parens, which
// `nameIsLitUnionType` -> `nameIsInlineLitUnion` tolerates via the union split).
export function nameIsLitUnionArray(name: string) {
  const elem = listElemNameOf(name)
  if elem == "" { return false }
  nameIsLitUnionType(elem)
}
// True if `name` is a 2-D array whose ELEMENT is an i32-backed scalar list — `i32[][]`,
// `boolean[][]`, or a literal-union `K[][]`. All three share the `i32[][]` rep EXACTLY: the
// element is the i32-list wrapper (`lTypeIdx`, ref-list element kind 4), because `i32[]`,
// `boolean[]` and a litunion `K[]` share ONE i32[] backing (`nameIsI32Array`). One predicate for
// the three ref-array classifiers (`nameIsRefArray` / `refArrElemKind` / `refArrElemName`), which
// each special-cased only the literal `"i32[][]"` name — so the boolean/atom leaf (`boolean[][]`,
// `K[][]`, the R4 fuzz family) now falls out of the SAME i32-list-element arm without a fourth
// drifting enumeration. A deeper `i32[][][]` is NOT this (its element `i32[][]` is itself a ref
// array, kind 9 via the recursion) — only a single i32-backed leaf list qualifies.
export function nameIsI32ListArray(name: string) {
  // THE ELEMENT MUST ITSELF BE A LIST for any arm of `nameIsI32Array` to fire — every one of
  // its four (`i32[]`, `boolean[]`, a litunion array, a `(K | null)[]`) requires a trailing
  // `[]`, and `nameIsNulBoolList` reaches `listElemNameOf`, which returns "" for a non-array.
  // So `name` must be `X[][]`, and that is four character reads — no cut.
  //
  // The two cheap arms are then asked in place (`arrElemIsArrayOf`); anything that passes the
  // guard and fails both falls through to the FULL predicate, slice and all. That fallback is
  // deliberate: the first attempt here reproduced only two of the four arms and disagreed on
  // **192** reaches — the litunion-array and `(K | null)[]` cases. Delegating instead of
  // re-deriving cannot drift.
  //
  // Dual-written after the fix: 163,407 reaches, 0 disagreements.
  if !nameIsArray(name) { return false }
  const to = name.length - 2
  if to < 2 { return false }
  if name[to - 2] != '[' { return false }
  if name[to - 1] != ']' { return false }
  if arrElemIsArrayOf(name, "i32") { return true }
  if arrElemIsArrayOf(name, "boolean") { return true }
  nameIsI32Array(arrElemNameRaw(name))
}
// ── the MAP-NAME OPENER moved down too (D-MAPOPENDOWN) ────────────────────────────────
//
// **`nameIsMapOpen` IS `tyname.vl`'s AND ITS FULL HEADER LIVES THERE**; this file republishes
// it at the top. **IT IS NOT `nameIsMap`, AND THE TWO MUST NOT BE MERGED BY EYEBALL.**
// `nameIsMap` below is that predicate MINUS the arrays: a list-of-maps `{[string]:i32}[]`
// opens `{[` but is a REF ARRAY, so `nameIsMap` rejects it while the opener accepts it. A
// caller asking "does this name START a map" — a union ARM that must not be swallowed by the
// map-VALUE recursion, whose whole union name also opens `{[` — wants the OPENER; routing an
// arm test to `nameIsMap` narrows it to the non-array arms and re-opens the garbled-map-value
// bug the arm test exists to prevent. (`nameIsStructWithMapField`'s `{[`-anywhere scan below
// is a SUBSTRING search, not this.) Below: true if `name` is a string-keyed MAP — the
// synthetic name `parseType` builds for an index signature; the lowering assumes string KEYS.
export function nameIsMap(name: string) {
  // The MAP-NAME OPENER at its home, carrying its own `length >= 2` bound (this spelled the
  // same two character compares out inline behind the same bound).
  if !nameIsMapOpen(name) { return false }
  // A trailing `[]` makes it a LIST of maps, not a bare map — the array-name grammar's
  // TEST half, at its home. (This spelled the same two character compares out inline; at
  // length >= 2 the two readings accept exactly the same names.)
  !nameIsArray(name)
}
// True if `name` is a UNION whose FIRST atom is a map (`{[string]: V} | …`) — a name that both
// STARTS with `{[` (so `nameIsMap` matches it) AND has 2+ top-level atoms. Such a name is a
// variant BOX, not a bare map: it must NOT be classified as a map local / return / value / field /
// list element. A bare map has ONE top-level atom (the inner `|` of a union-VALUED map like
// `{[string]: C | D}` sits inside the braces, so `splitUnionAtoms` keeps it a single atom).
export function nameIsMapMemberUnion(name: string) {
  if !nameIsMap(name) { return false }
  // COUNT, DO NOT MATERIALIZE. This built the whole atom array and then read only its
  // LENGTH. `unionMemberCount` is that query without allocating the strings — its own
  // header calls itself "the counting dual of `splitUnionAtoms`", including the top-level
  // `=>` rule that keeps `(i32) => i32 | string` one member.
  //
  // Verified rather than taken from the comment: 26,209 reaches, the count equal to the
  // split's length every time, 0 disagreements.
  unionMemberCount(name) >= 2
}
// True if the MAP atom `mapAtom` (`{[string]: V}`) is boxable as a UNION arm — ALWAYS. A map arm
// boxes as its VALUE-KIND map STRUCT ref riding the box anyref, tagged via `mapSlotTag`, for
// every value kind (scalar / string / mono, and ref-VALUE: struct, nested map, union, closure,
// ref-list). The value-kind map struct dedups across the union-box seam because BOTH the box
// side (`markMapUnionArms` → `mvShapeOfValName`, the authoritative `collectA` intern) and the
// narrowed read (`mvSlotOf…` → `mapTypeIdxOf`) key the SAME mv slot off the SAME arm atom via
// `mapValNameOf` — one slot, one `$mapStruct` heap type. An unrepresentable value type
// (`mvValKindOfName == -3`) cannot cross the box: `mapShapeOfExpr` returns -3, so
// `emitUnionCoerce`'s `mSlot >= -1` gate fails and the arm stays a LOUD reject, never invalid
// wasm. The ref-value hazard was the intermediate binding / field / return classifiers mis-typing
// a map-member union as a bare map, now guarded by `nameIsMapMemberUnion` at every `paramMap` /
// `retMapFlag` / `nameFieldCode` site.
export function mapArmValueBoxable(_mapAtom: string) { true }
// True if `name` is a BARE map (`{[string]: V}`) — the composite `nameIsMap(name) &&
// !nameIsMapMemberUnion(name)`, which is the ONE question five call sites in this file and
// `emit_collect.vl` were each spelling out. `nameIsMap` is a two-character probe (`{` then
// `[`), so a map-FIRST union (`{[string]: i32} | boolean`) passes it and every consumer that
// wants "a map, not a box" has to subtract the false positive by hand; an audit of the
// `nameIsMapMemberUnion` sites found most of them holding exactly this corrective-guard
// reading. This is that reading, named once.
//
// It is also the shape the ARENA answers directly: `ty is TyMap` is true for a bare map and
// false for a `TyUnion` with a map arm — that is `typecheck.nodeTyIsMap`, and D-BAREMAP moved
// every ANNOTATION-NODE consumer onto it. What is left here is the calls that hold a STRING and
// no node — an atom peeled out of a union, `nameIsMapArray`'s element — with no type to ask.
export function nameIsBareMap(name: string) {
  nameIsMap(name) && !nameIsMapMemberUnion(name)
}
// THE ONE HOME of the emitter's KEY question: does the map spelling `name` carry an i32
// KEY (`{[i32]: V}`)? Reads the MAP-NAME grammar's KEY CUT at its home (`mapSpellKeyName`,
// tyname.vl), which deliberately does NOT require the closing `}` — so a LIST of i32-keyed
// maps (`{[i32]:i32}[]`) and a nullable one (`{[i32]:i32}|null`) answer TRUE here too,
// exactly as they do for the checker's unsupported-key diagnostic. Every emitter site that
// must pick between the two map struct reps asks this or the arena twin
// (`typecheck.nodeTyMapKeyIsI32`); nothing pattern-matches the key text a second time.
export function nameIsI32KeyedMap(name: string) {
  mapSpellKeyName(name) == "i32"
}
// Fold a map SHAPE to the flavor-blind twin every op that does not care about Set-ness
// wants: the Set sentinel to its map sibling (`-2` → `-1` string-keyed, `-5` → `-4`
// i32-keyed) and the unsupported sentinel to the mono map (the op site that DOES care
// rejects it first; the fold is what the `.length` / for-in / key-list readers apply so
// a Set answers with its own struct). The KEY half of the vocabulary survives the fold —
// that is the whole point of the two disjoint pairs.
export function mapShapeFoldSet(sh: i32) {
  if sh == -2 { return -1 }
  if sh == -3 { return -1 }
  if sh == -5 { return -4 }
  sh
}
// True if the type-ANNOTATION node at `tyIx` is a NULLABLE bare map (`{[string]: V} | null`) —
// the ARENA dual of `nulMapInnerName(<the node's rendering>) != ""`, and the nullable twin of
// `nodeTyIsMap`. A `TyNullable` over a `TyMap`: the `| null` peel and the bare-map test the
// name pair spells as two scans are ONE walk down two variant tags, with no union split and
// no substring. (`typecheck.vl` carries `nodeTyIsNullableStruct`, the same shape over `TyObj`;
// the map sibling lives here because this is where its only consumers are.)
export function tyIsNulBareMap(tyIx: i32) {
  const ty = nodeTyIxOf(tyIx)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable {
    if t.nInner < 0 { return false }
    const it = T.tys[t.nInner]
    return it is TyMap
  }
  false
}
// True if the array type-name `name` is a string-keyed-MAP list `{[string]:i32}[]` —
// a ref list whose ELEMENT is the map struct (`mStructIdx`). It is a `nameIsMap` name
// with a trailing `[]`. The scope chain (`typecheck.vl`'s `scopes: {[string]:i32}[]`)
// is exactly this. Routed through the ref-list machinery as element-kind `3`.
export function nameIsMapArray(name: string) {
  // The bare element (without the trailing `[]`) must be a BARE map name — NOT a map-member union
  // (`({[string]: i32} | boolean)[]` whose paren-stripped element `{[string]: i32}|boolean` starts
  // with `{[` too): that is a union-BOX ref list (kind 2), not a list-of-maps (kind 3).
  // The cut is RAW (`arrElemNameRaw`, not `listElemNameOf`) because that is what this function
  // did before the merge — NOT because the difference is observed: a sabotage installing the
  // paren-STRIPPING cut here reddened nothing on either the corpus or the fuzz channel, so the
  // two readings have an empty measured divergence population. Unreached is not the same claim
  // as licenced; the faithful cut ships, and the SPAN below is that same raw cut with no strip.
  //
  // THE ELEMENT IS ASKED IN PLACE. Cutting it out to hand to `nameIsBareMap` allocated a slice on
  // every call; both halves of `nameIsMap(x) && unionMemberCount(x) < 2` transpose to a SPAN,
  // since `tyTopIndexOf` already takes a `from` and a separator past `to` is the same as none.
  if !nameIsArray(name) { return false }
  const to = name.length - 2
  if to == 0 { return false }
  if !nameIsMapSpan(name, 0, to) { return false }
  unionMemberCountSpan(name, 0, to) < 2
}
// True if `name` is an ARRAY OF FUNCTIONS — `((i32) => i32)[]`: a trailing `[]` whose
// element is a fully-parenthesized FUNCTION type, the arrow NESTED (depth > 0). A
// TOP-LEVEL arrow (`(i32) => i32[]`) is a function RETURNING a list, NOT an array of
// functions — excluded via `annArrowAt` (the same disambiguation as the list-return
// name guard). The element heap type is the shared closure fat-pointer struct
// (`cloStructIdx`); the ref-list element kind is 5.
export function nameIsClosureArray(name: string) {
  const n = name.length
  if n < 4 { return false }
  // The array-name grammar at its two homes. The TEST stays in front of the `annArrowAt`
  // walk exactly as the inline compares did — running that walk on a non-array name would
  // be a work regression — and the CUT stays behind it, so no name pays for a slice it is
  // about to be rejected for.
  if !nameIsArray(name) { return false }
  if annArrowAt(name) >= 0 { return false }
  const elem = arrElemNameRaw(name)
  // The PAREN grammar's OPEN half at its home. The separate `elem.length < 1` reject this
  // replaced is the home's own bound, so the empty element still declines before the
  // `nameIsFuncTypeAtom` walk below rather than indexing out of bounds.
  if !nameIsParenOpen(elem) { return false }
  // The element must be a genuine FUNCTION type — a TOP-LEVEL arrow (paren-aware, after
  // peeling grouping parens). A `strContains(elem, "=>")` test also matched a UNION whose
  // FIRST member is a closure (`(() => i64) | i64`, whose `|` sits at the top level with the
  // arrow NESTED inside the first member) and mis-typed it as a closure ref list — a raw
  // closure element slot the boxed value could not store (invalid wasm). `nameIsFuncTypeAtom`
  // distinguishes `(i32) => C | S` (closure returning a union, kind 5) from `(() => i64) | i64`
  // (value-union box element, kind 2) by where the arrow sits.
  nameIsFuncTypeAtom(elem)
}
// The non-null FUNCTION-TYPE atom of a NULLABLE-closure array element
// (`(((i32) => boolean) | null)[]` → `((i32) => boolean)`), or "". A
// `<closure> | null` element is a nullable NICHE over the shared closure
// fat-pointer (`(ref null $cloStruct)` — the backing a plain closure element
// already uses), NOT a union box — so such an array is a CLOSURE ref list
// (kind 5) whose slot keys the full `"<closure> | null"` name: the index read
// stays nullable (`rlElemNullable`) for the `e != null` narrow, exactly as the
// nullable-struct element (`nullStructArrElem`) does over its struct heap.
export function nullClosureArrElem(name: string) {
  const elem = parenUnionArrElemName(name)
  if elem == "" { return "" }
  const nn = nullablePartOf(elem)
  if nn == "" { return "" }
  if nameIsFuncTypeAtom(nn) { return nn }
  ""
}
// The ELEMENT function-type atom of a closure-array name, PLAIN or nullable-element:
// `((i32) => R)[]` → `(i32) => R`, `(((i32) => R) | null)[]` → `((i32) => R)`, else "".
// The one home of an idiom six call sites carried by hand: the nullable-element form first
// (its element keeps the `| null` grouping parens, so the plain test declines it), then the
// plain form's `[]` peel.
//
// The two are the SAME question — "does this name's element ride the closure fat-pointer" —
// and every caller wanted one of exactly two answers: the element NAME (to key a `$fnsig`) or
// the BOOLEAN. `cloArrElemNameOf(n) != ""` is that boolean exactly, since `nullClosureArrElem`
// returns a non-empty function-type atom or "" and `nameIsClosureArray`'s peel is non-empty
// whenever it fires. Order does not matter: the tests are disjoint (a `| null` element is not
// a `nameIsFuncTypeAtom`) and both are pure.
export function cloArrElemNameOf(name: string) {
  const nul = nullClosureArrElem(name)
  if nul != "" { return nul }
  if nameIsClosureArray(name) { return arrElemNameRaw(name) }
  ""
}
// The VALUE-union element name of a parenthesized union-array annotation:
// `(string|i32)[]` → `string|i32` (`canonEmitName` keeps a union element's
// grouping parens), or "" when `name` is not a value-union array name.
// Registration-independent (classifies from the atom set, not `unNames`).
export function parenUnionArrElemName(name: string) {
  if name.length < 5 { return "" }
  // A TOP-LEVEL arrow makes this a FUNCTION TYPE returning an array (`(i32) => (string | {w:
  // i32})[]`), NOT a value-union array. Without this guard the `name[0]=='('` / `name[len-3]==')'`
  // checks below match the closure name's OUTER parens (first `(` of the param list … last `)` of
  // the return union), capturing an unbalanced inner (`i32)=>(string|{w:i32}`) whose miscounted `|`
  // makes `unionMemberCount > 1` — mis-typing the whole closure LOCAL as a union-box ref list.
  // (`nameIsClosureArray` carries the same guard for the closure-element-array case.)
  if annArrowAt(name) >= 0 { return "" }
  // The array-name grammar's TEST half, at its home (this spelled the same two character
  // compares out inline; `name.length >= 5` is already established above).
  if !nameIsArray(name) { return "" }
  // The PAREN grammar's SPAN, asked of the ELEMENT rather than of the whole name — the whole
  // of the OPEN + `length - 3` CLOSE pair this spelled out inline.
  //
  // D-PARENHOME declined to route these two lines, on the reasoning that "`nameIsParenSpanEnds`
  // asks about the LAST character and would answer for the `]`". That is true of the WHOLE
  // name and false of its ELEMENT, which is the object the `length - 3` spelling was always
  // talking about: `nameIsArray` is established one line above, so `arrElemNameRaw(name)` is
  // `name` minus exactly its final two characters, giving `elem[0] == name[0]` and
  // `elem[elem.length - 1] == name[name.length - 3]`. The pair is therefore
  // `nameIsParenSpanEnds(elem)` character for character, on every input rather than on every
  // input tried — and the home's own `length >= 1` bound is covered by `name.length >= 5`
  // above, which makes `elem` at least 3 characters long.
  if !nameIsParenSpanEnds(arrElemNameRaw(name)) { return "" }
  // The whole name must be ONE atom — a multi-arm union that merely STARTS with a paren
  // group and ENDS with `[]` (`(boolean|string)[] | (i32|f64)[]`) would otherwise slice an
  // UNBALANCED "inner" (`boolean|string)[]|(i32|f64`) and mis-classify the whole union as
  // a single union-array, derailing its registration.
  if unionMemberCount(name) > 1 { return "" }
  const inner = name.slice(1, name.length - 3)
  // A `(boolean | null)[]` element is the i32 SENTINEL niche, not a box: it reps as a
  // plain i32 list (`nameIsI32Array`), so it must NOT read as a union-box ref-array
  // element here. Return "" so `nameIsRefArray` / `refArrElemKind` skip it and it lands
  // on the i32-list path. (Scalar `boolean | null` is likewise a niche, not a value
  // union — `isValueUnionName` already excludes it.)
  if nameIsNulBool(inner) { return "" }
  // A `(string | null)[]` element is the string ref niche (a `(ref null $sTypeIdx)` string), not a
  // box: it reps as a plain string list (`nameIsNulStrList`), so it must NOT read as a union-box
  // ref-array element here. Return "" so `nameIsRefArray` / `refArrElemKind` skip it and it lands on
  // the string-list path. (Scalar `string | null` is likewise a niche, not a value union.)
  if nameIsNulString(inner) { return "" }
  // A `(K | null)[]` element is the litunion atom NICHE (an i32 member id with `-1` = `null`), not a
  // box: it reps as a plain i32 list (`nameIsNulLitUnionList` → `nameIsI32Array`), so it must NOT read
  // as a union-box ref-array element here. Return "" so `nameIsRefArray` / `refArrElemKind` skip it
  // and it lands on the i32-list path. (Scalar `K | null` is likewise a niche, not a value union.)
  if nameIsNulLitUnion(inner) { return "" }
  if isValueUnionName(inner) { return inner }
  // A STRUCT / heterogeneous union element (`(C | S)[]`, `(A | i32)[]`): the parens are
  // annotation grouping only and the element slots hold the SAME `{tag, payload}` boxes a
  // value-union element does (element kind 2, heap `uBoxIdx`). A top-level `|` in a type
  // position is always a union, so `unionMemberCount > 1` distinguishes it from a
  // parenthesized non-union element (`((i32) => i32)[]`, no `|`).
  if unionMemberCount(inner) > 1 { return inner }
  ""
}
// True if `name` is a NESTED (2-D+) array whose innermost 1-D leaf is a parenthesized
// value/variant/map union (`({...}|i32)[][]`, `(i64|boolean)[][]`). Peels the OUTER `[]` levels
// down to the last single-bracket `(...)[]` leaf and confirms it is a union-element array
// (`parenUnionArrElemName`); a top-level arrow (a closure returning an array) is excluded.
//
// NO CALLER SINCE THE RUNG CONVERSION — `synthRetAnnots`' arm for this shape now asks which
// PRODUCER answered (`IR_RUNG_NESTED_ELEM_UNION_LIST`) instead of scanning the rendered name.
// KEPT, NOT DELETED: no calls refutes hotness, never reachability. It is EXPORTED, it is the
// written-down grammar of a nested box-element array, and its siblings in this file are still
// live — deleting it would move that grammar out of the one place it is stated. It is marked
// instead, so the next reader knows it is a definition rather than a decision.
export function nameIsNestedUnionElemArray(name: string): boolean {
  if annArrowAt(name) >= 0 { return false }
  const inner = arrElemNameRaw(name)
  if !nameIsArray(inner) { return false }
  let leaf = inner
  let done = false
  while !done {
    // `leaf` is an array name at every iteration (the line above establishes it, and the
    // loop only advances on a `nameIsArray` hit), so the home's cut IS this slice.
    const nx = arrElemNameRaw(leaf)
    if nameIsArray(nx) { leaf = nx } else { done = true }
  }
  parenUnionArrElemName(leaf) != ""
}

// True if the type-name `name` is exactly `string`. A VL string is CURRENTLY an
// `array i32` of code points (`docs/strings-design.md`), so it shares the array heap
// type — hence string use also sets `aUsed` and string valtypes reuse the array ref.
// (`string[]` is NOT this — it ends in `[]`, so `nameIsArray` catches it first and
// `checkArrName` rejects it as a non-i32 element array.)
export function nameIsString(name: string) { name == "string" }
// True if the type-name `name` is exactly `string[]` — a growable list whose elements
// are string refs. It reuses the map keys list types (the `{backing,len,cap}` wrapper
// over a `(ref null $sTypeIdx)` string backing); field code `6`.
export function nameIsStringArray(name: string) {
  // Element-name compare over the array grammar's one cut — see the family note at
  // `nameIsI32Array`.
  if arrElemIs(name, "string") { return true }
  // `(string | null)[]` shares the EXACT string-list backing (`$mkListIdx` wrapper, `(ref null
  // $sTypeIdx)` string backing — a `string[]` element is already a nullable ref). So it rides the
  // string-list machinery (param slot / `.length` / construct / arg-coerce) uniformly; only the
  // element READ diverges (kept `(ref null)`, intercepted by `exprNulStrArray` before the non-null
  // recovery) and a `null` element/push/assign lowers as `ref.null`.
  nameIsNulStrList(name)
}
// True if the type-name `name` is exactly `f64[]` — a growable list whose elements are
// scalar f64 (Slice 4). Its backing is `(array (mut f64))` (`fa64TypeIdx`); its wrapper
// is the `{backing,len,cap}` triple over that f64 backing (`fl64TypeIdx`). Distinct from
// `i32[]` so element reads/writes use the f64 element store.
// These three are the family note's purest form: one cut, one leaf name. They are also the
// three `emit_rewrite.vl`'s scalar-leaf-list return arm used to hand-write inline as
// `ctx == "i64[]" || ctx == "f64[]" || ctx == "f32[]"` — three copies of three one-line
// homes, in a file that already imported this one.
export function nameIsF64Array(name: string) { arrElemIs(name, "f64") }
export function nameIsF32Array(name: string) { arrElemIs(name, "f32") }
// The PACKED sibling: a `u8[]` annotation (backing `ba8TypeIdx` — `(array (mut i8))`,
// one byte per element — wrapper `bl8TypeIdx`). `u8` is a STORAGE type and this is the
// only spelling it appears in; the checker admits it nowhere else, so a name reaching
// here with a `u8` element is always this list and never a scalar `u8` anything.
export function nameIsU8Array(name: string) { arrElemIs(name, "u8") }
// The i64 sibling of `nameIsF64Array`: an `i64[]` annotation (backing `ia64TypeIdx`,
// wrapper `il64TypeIdx` — the i64 element store).
export function nameIsI64Array(name: string) { arrElemIs(name, "i64") }
// True if the node at `ix` is a struct `type` declaration (a single-level narrowing
// helper, so callers avoid an inline `is TypeDecl` on the wide `Node` union).
export function nodeIsTypeDecl(ix: i32) {
  const s = P.nodes[ix]
  if s is TypeDecl { return true }
  false
}
// True if `name` is the name of a FuncDecl ANYWHERE in the arena (top-level or nested/lifted).
// Used at `collectS` time — BEFORE `buildFnMap` populates `fnNames`, so `fnIndexOf` is not yet
// usable — to classify an anon-struct field whose value is a bare function name (`{ go: add }`).
// It must see a function declared AFTER the literal too, which is why it was a whole-arena scan
// per call, and a hot one: `anonFieldCode` re-read every node in `P.nodes` per identifier.
//
// IT IS NOW AN INCREMENTAL FOLD OF THE SAME SCAN, sound because the arena is APPEND-ONLY.
// `ast.addNode` is the single append and nothing removes, so a node folded at index i keeps its
// verdict; a node arrives fully built, so a FuncDecl's `fnName` is final at append (mono clones
// included); and the ONE in-place `fnName` write that can land later is `emit_collect`'s lambda
// numbering, which calls `noteFuncName` above. The `nnfScanned < P.nodes.length` guard also
// self-heals a missed reset; the reset itself is in `resetParentLetCache`.
export function nameNamesFunction(name: string) {
  if name == "" { return false }
  if nnfScanned > P.nodes.length {
    nnfSet = Map()
    nnfScanned = 0
  }
  while nnfScanned < P.nodes.length {
    const n = P.nodes[nnfScanned]
    if n is FuncDecl {
      if n.fnName != "" { nnfSet[n.fnName] = true }
    }
    nnfScanned = nnfScanned + 1
  }
  nnfSet[name] ?? false
}
// ── the SHAPE-NAME grammar: the OPENER and the WIDE SPAN are BOTH one module down ──────
//
// **`nameIsShapeOpen` (D-SHAPEDOWN) AND `nameIsBraceSpanEnds` (D-BRACEDOWN) LIVE IN
// `tyname.vl`, AND THEIR FULL HEADERS LIVE THERE**; this file republishes both and keeps only
// their CONJUNCTION — `BRACE-SPAN · NOT2ND`. Drop the `name[1] != '['` conjunct and you have a
// DIFFERENT predicate, the one that accepts a MAP name (`{[string]:i32}` opens `{`, ends `}`);
// that one is `nameIsBraceSpanEnds`, which this delegates to, so neither widens the other.
// **AND THIS IS NOT `emit_classify.nameIsWholeSpanShape`**: that one is this PLUS
// `tyGroupWrapsWhole`, a depth walk proving the group opened at index 0 is still open at the
// last character. Endpoints alone do not prove it — `{a:{b:i32}}|{c:i32}` answers TRUE here and
// FALSE at the walk. Every site carrying this endpoint predicate would be TIGHTENED by routing
// to the walk; narrowing one is a behaviour change owing its own graded population, not tidying.
export function nameIsShapeSpanEnds(name: string) {
  if !nameIsBraceSpanEnds(name) { return false }
  nameIsShapeOpen(name)
}
// The inline-shape synthetic name of a STRUCT-ALIAS union decl — a `UnionDecl` whose DISTINCT
// variants are exactly ONE inline object shape (`{a:i32,b:i32}`, not a map `{[…]}`) — or "".
// The shape a canonicalized object intersection (`type AB = {a} & {b}`) leaves behind: a plain
// named STRUCT at runtime, so `collectS` interns it and `collectU` skips it.
//
// DISTINCT, NOT `length == 1` (D446). `type AB = {a:i32,b:i32} | {a:i32,b:i32}` is DEGENERATE:
// `parseTypeDecl` pushes one variant string per `|` arm with no dedup anywhere on the
// declaration route, so an arity test reads 2 and the struct-alias path is unreachable for a
// type that denotes exactly one struct — `collectU` then claims it, `AB[]` becomes a kind-2
// union-BOX element list while the same shape spelled inline stays kind 1, and the two reps
// meet at a store: check-clean INVALID WASM. SPELLING-distinct, deliberately not type-distinct
// — collapsing `Circle` beside `{r:i32}` is a NOMINAL question this predicate cannot settle.
export function unionStructAliasShape(variants: string[]) {
  const first = unionSoleDistinctVariant(variants)
  if first != "" {
    if nameIsShapeSpanEnds(first) { return first }
  }
  ""
}

// The ONE spelling every variant of `variants` shares, or "" when they are not all one
// spelling (or there are none). Split from the caller so the arity rule reads as the
// distinctness question it is, and so the empty list keeps answering "" rather than
// falling into the single-arm arm.
function unionSoleDistinctVariant(variants: string[]) {
  if variants.length == 0 { return "" }
  const v = variants[0]
  let i = 1
  while i < variants.length {
    if variants[i] != v { return "" }
    i = i + 1
  }
  v
}
// The `<`-scan and the generic-application SPAN (`gaeLtAt` / `annGenAppSpanEnds`) moved one
// module DOWN to `typecheck.vl` (D-GENAPPDOWN) and are republished at the top of this file;
// their full headers live at the home. `gaeSplitArgs` below stays: it is a NAMED READING of
// `tyTopLevelSplit` (`sep = ','`, `dropEmpty = true`) for the generic-argument grammar, and
// it keeps its name for the same reason `fieldNameOf` and `gaeHeadNameOf` are two names for
// one `slice(0, i)` — the unit this programme homes is the QUESTION, not the arithmetic.
// The walk it reads is no longer this file's: D-SPLITDOWN moved `tyTopLevelSplit` to
// `tyname.vl`, because `typecheck.vl` held two more writings of it and imports this file.
// Split a type-argument list at its TOP-LEVEL commas (`<>`/`{}`/`[]`/`()`
// nest); empty parts drop (a tolerated trailing comma) — the `dropEmpty` reading of
// the shared depth walk.
export function gaeSplitArgs(s: string, out: string[]) {
  tyTopLevelSplit(s, ',', true, out)
}
// True when a declared type-parameter NAME binds nothing because a BUILTIN type spelling wins
// it: `type Box<i32> = { v: i32 }` has no parameter, it has a field of type `i32`.
// THIS IS THE CHECKER'S LEAF-RESOLUTION ORDER READ AS A PREDICATE, and that order is the whole
// rule: `tsLeafTy`/`nameToTy` ask `primTyOfName` FIRST, the live parameter binding SECOND, the
// declared struct/union registry THIRD. So a parameter named for a primitive is shadowed BY the
// primitive while one named for a DECLARED type shadows it, and substituting at a primitive-
// named parameter hands the emitter a field type the checker never agreed to — two answers for
// one field, i.e. invalid wasm on a program `vl check` accepts. The bound is therefore
// `primTyOfName`'s accept set (`valueAtomKind` plus `void`), NOT `genTyParamArr`'s, which is
// `checkArrName`'s accept set for a different defect. A parameter named for a name CANON
// REWRITES (`type Id = i32`, `type Id = 0 | 1`) used to survive this; `gaeCollectDecls` now
// records the DECLARED spelling (`declAnnRawTyName`). FuncDecl half: `monoTyParamOf`'s guard.
export function gaeParamShadowed(name: string) {
  if name == "void" { return true }
  valueAtomKind(name) >= 0
}
// The LIVE parameter slots of a generic alias — the declared names that actually BIND,
// paired with the application arguments that bind them. A parameter whose name is a
// primitive spelling binds nothing (`gaeParamShadowed`, which is the checker's
// `primTyOfName`-first resolution order read as a predicate), so it is dropped from BOTH
// lists together and the substitution below never sees it.
//
// Filtering here rather than inside the walk is what keeps the shadow rule in ONE place:
// `monoSubstAnn` is shared with the FuncDecl half, whose own shadow question is a
// different arm at a different site, and a guard buried in the shared walk would answer
// both with one rule.
function gaeLiveParams(
  pnames: string[],
  args: string[],
  outP: string[],
  outA: string[],
) {
  let i = 0
  while i < pnames.length {
    if !gaeParamShadowed(pnames[i]) {
      outP.push(pnames[i])
      outA.push(args[i])
    }
    i = i + 1
  }
  0
}
// Would the substitution below CHANGE this field's type name — i.e. does the annotation
// reach a live type parameter anywhere in its structure? THE substitution's decision,
// published so the one other place that has to ask it asks it rather than re-deriving it:
// `emit_collect.gaeDeclFieldTyName` uses it to decide whether a field's DECLARED spelling
// is the one to record. Two copies of this question would be two answers, and the defect
// #1238 closed is exactly that.
//
// It REPLACES the `gaeParamSlotOf(arrLeafNameOf(raw), …)` gate that shipped with the
// sidecar. That gate read the array grammar and nothing else, so a parameter sitting
// behind ANY other constructor — `Id | null`, `{a: Id}`, `Inner<Id>` — was reported as
// "the substitution does not land here", the canon'd `i32` was recorded, and the field
// interned at the ALIAS's body type while the checker had bound it to the ARGUMENT.
export function gaeAnnHasParam(tn: string, pnames: string[]) {
  const lp: string[] = []
  const la: string[] = []
  gaeLiveParams(pnames, pnames, lp, la)
  monoAnnHasTyParam(arrLeafNameOf(tn), lp)
}
// Substitute a declared type-PARAMETER name in a field's type name with the application's
// argument name, THROUGH THE TYPE'S STRUCTURE: `T` → `i32`, `T[][]` → `i32[][]`,
// `T | null` → `i32 | null`, `{a: T}` → `{a: i32}`, `(T | null)[]` → `(i32 | null)[]`.
// It is `monoSubstAnn` — the walk this file already owns for the FuncDecl half — asked with
// the alias's live parameters as the bindings, NOT a third hand-rolled ladder: a ladder peels
// ONE constructor, and each rung someone forgets to write is a field that interns at the
// alias's BODY type while the checker reads the ARGUMENT, i.e. check-clean invalid wasm. Do
// not push the `[]` run into `monoTyParamOf` either — its `monoSubstAnn` branch writes
// `b + "[]"`, answering a two-dimensional pattern with a one-dimensional name.
// THE GATE IS NOT OPTIONAL AND IT IS NOT AN OPTIMISATION: an annotation that reaches no live
// parameter is returned VERBATIM, because the walk RE-RENDERS what it descends and a spelling
// differing from the recorded one by a single character is a second intern key for one type.
export function gaeApplyFieldTy(tn: string, pnames: string[], args: string[]) {
  const lp: string[] = []
  const la: string[] = []
  gaeLiveParams(pnames, args, lp, la)
  const leaf = arrLeafNameOf(tn)
  if !monoAnnHasTyParam(leaf, lp) { return tn }
  const s = monoSubstAnn(leaf, lp, lp, la)
  // "" is `monoSubstAnn`'s UNBOUND answer, which cannot arise here — every name in `lp`
  // is bound by construction — so this and the unchanged-leaf test are the
  // un-substitutable fallbacks, not cases.
  if s == "" { return tn }
  if s == leaf { return tn }
  s + tn.slice(leaf.length, tn.length)
}
// Lexicographic `a < b` over two strings by code point (VL has no `<` on `string`).
// Compares char-by-char: at the first differing position the smaller code point wins;
// if one is a prefix of the other, the shorter is smaller. Equal strings are NOT `<`.
export function strLess(a: string, b: string) {
  let i = 0
  const na = a.length
  const nb = b.length
  while i < na && i < nb {
    const ca = a[i]
    const cb = b[i]
    if ca < cb { return true }
    if ca > cb { return false }
    i = i + 1
  }
  na < nb
}
// True if union `name` has at least one NON-null value-atom member (`i32`/`f64`/
// `boolean`/`string`/…) — true for a pure value union AND a MIXED struct+scalar union,
// false for an all-struct union. Gates the scalar value-boxing in `emitUnionCoerce`.
export function unionHasValueAtom(name: string) {
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  let i = 0
  while i < atoms.length {
    const k = valueAtomKind(atoms[i])
    if k >= 0 && k != 6 { return true }
    // A litunion-ALIAS atom (`K0 | {w: i32}`) rides the box as its member-string atom
    // (the `K0 | i64` value-union rule) — it IS a value-boxable carrier, and the coerce
    // ladder below the gate already resolves the alias arm for a string carrier. Without
    // this an alias + all-struct union (no plain scalar sibling) took the all-struct raw
    // pass-through, returning the RAW member string into the box result — INVALID-WASM.
    if nameIsLitUnionType(atoms[i]) { return true }
    i = i + 1
  }
  false
}
// True if union `name` has a member that the box carries as a STRING ref — a literal-union
// arm (which rides the box as its member string) or a plain `string` arm. THE ONE HOME of
// "this box can take a widened literal-union ATOM". D-ATOMSTORE, slice A of
// `docs/internals/litunion-compact-rep-design.md`. Both legs are load-bearing: the litunion
// leg is the design's F1 population (an atom-typed VALUE stored into `K | f64` fell past
// `emitUnionCoerce`'s value-atom ladder to the numeric default and emitted
// `f64.convert_i32_s` ON THE ATOM ID — a silent miscompile), and the `string` leg is its twin
// one spelling over (`const x: string | f64 = k`), failing the SAME way for the SAME reason.
// TWO EXCLUSIONS, each a REP that is not a box: a PURE literal union (`K`, `"a"|"b"`) is the
// interned i32 ATOM, and `K | null` is the atom NICHE — an i32 with `-1` for null — so
// widening its store to a string ref would put a `(ref $array)` in an i32 cell. `K | f64 |
// null` is NOT excluded: three-plus members with a null sibling is a boxed union, not a niche.
export function unionTakesAtomAsStr(name: string) {
  if nameIsLitUnionType(name) { return false }
  if nameIsNulLitUnion(name) { return false }
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  let i = 0
  while i < atoms.length {
    if nameIsLitUnionType(atoms[i]) { return true }
    if atoms[i] == "string" { return true }
    i = i + 1
  }
  false
}
// How many ARMS of the value union `name` ride the box as a string ref — a plain `string`
// arm, and each literal-union arm. `unionTakesAtomAsStr`'s counting dual, and the reason
// it is worth counting rather than testing: kind 2's box TAG discriminates an arm only
// while this answers 1. At 2 or more the arms OVERLAP in the tag (`K ⊆ string`), and
// `x is K` cannot be decided by reading it — the decision has to be MEMBERSHIP over the
// payload, which is what `emitIs`'s litunion arm emits.
export function unionStrArmCount(name: string) {
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  let n = 0
  let i = 0
  while i < atoms.length {
    if atoms[i] == "string" || nameIsLitUnionType(atoms[i]) { n = n + 1 }
    i = i + 1
  }
  n
}
// True if the value union `name` contains the member atom `atom`.
export function unionHasAtom(name: string, atom: string) {
  // NO SPLIT. `splitUnionAtoms` materializes every member as its own `slice`, and this
  // predicate compared each one to `atom` and threw it away. The atoms are VERBATIM
  // substrings between top-level `|` separators (the split's own header says so), so
  // membership is decidable by comparing each span IN PLACE — same scanner, same bounds,
  // same top-level `=>` stop, zero allocations.
  //
  // Measured against the splitting form before it was removed: 11,327 reaches, 0
  // disagreements.
  let start = 0
  let going = true
  while going {
    const at = tyTopIndexOf(name, '|', '=', start)
    let end = name.length
    if at >= 0 && name[at] != '=' { end = at } else { going = false }
    if spanEqAt(name, start, end, atom) { return true }
    if going { start = at + 1 }
  }
  false
}
// `peelGroupParens` peels every fully-enclosing balanced grouping-paren layer from `name`;
// **ITS HOME IS `tyname.vl` (D-PARENDOWN)** and this file only republishes it.
// BELOW, THE ONE HOME of the union-ARM normalization: trim ASCII whitespace, then peel ONE
// fully-wrapping `(...)` pair. A closure member arrives from `splitUnionAtoms` WRAPPED
// (`(()=>i64)` — an unwrapped top-level arrow would bind the trailing `|` into its RETURN) and
// may carry the `| `-split's spaces, so a key derived from an arm must be normalized to
// byte-match one derived from the annotation. The wrap test is `tyGroupWrapsWhole`'s, NOT
// `parenEnclosesWhole`'s — which is exactly why this is not `peelGroupParens`.
// THE CHEAP TRAILING-`)` REJECT AND THE NO-OP TRIM GUARD ARE PART OF THE HOME, not tidying:
// without the reject, a name with no trailing `)` reaches `tyGroupWrapsWhole`, which answers
// TRUE only for a group that NEVER CLOSES, and the peel then slices a REAL character off the
// end (`(abc` → `ab`). The loops STAY — unreached licenses skipping work, not the contract.
export function normTypeAtom(arm: string) {
  let lo = 0
  let hi = arm.length
  while lo < hi && (arm[lo] == ' ' || arm[lo] == '\t') { lo = lo + 1 }
  while hi > lo && (arm[hi - 1] == ' ' || arm[hi - 1] == '\t') { hi = hi - 1 }
  let t = arm
  if lo != 0 || hi != arm.length { t = arm.slice(lo, hi) }
  // The PAREN grammar's SPAN half at its home — the CHEAP REJECT the paragraph above argues
  // for, now named. The walk stays here and stays `tyGroupWrapsWhole`: it is NOT
  // `peelGroupParens`'s `parenEnclosesWhole` (they disagree on a never-closing group), which
  // is exactly why the home carries the endpoints and neither walk.
  // …and the CUT is `tyname.groupInnerOf`, the delimiter-blind home (W1). The BALANCE WALK
  // stays out of it on purpose: this is the FOURTH distinct guard the home's call sites put
  // in front of the same three characters of arithmetic (the other three being
  // `nameIsParenSpanEnds`, `nameIsShapeSpanEnds` and the OPEN-only `nameIsShapeOpen`), so a
  // cut that folded in any one of them would be wrong for the rest.
  if nameIsParenSpanEnds(t) {
    if tyGroupWrapsWhole(t) { t = groupInnerOf(t) }
  }
  t
}
// The pipe-joined complement of `set` (a union name / narrowed sub-set string) with the atom
// `removed` taken out — the ELSE-branch narrowing of `is removed`. The equality is
// grouping-paren-insensitive (`peelGroupParens`), so `is () => i64` strips the `(() => i64)`
// member `splitUnionAtoms` produced; otherwise the closure arm survives the complement and the
// else-branch reads the raw box where its remaining scalar arm is expected.
// PURE-FUNCTION MEMO: the narrowing passes call this enormously often per self-compile — every
// `if`-chain scan re-derives the same else-branch complements — over a SMALL set of distinct
// `(set, removed)` pairs. The result depends on nothing but the two strings, so the memo needs
// no invalidation and persists across programs. The DOMINANT caller removes `"null"`, so that
// case keys on `set` alone (`raftNullKeys`, no concat on the hot path); every other `removed`
// rides a length-prefixed pair key so no separator collision can conflate two pairs. Values
// live in a side pool because "" is a VALID result — a real miss must stay distinguishable.
const raftNullKeys: {[string]: i32} = Map()
const raftKeys: {[string]: i32} = Map()
const raftVals: string[] = []

function removeAtomFromGo(set: string, removed: string) {
  const atoms: string[] = []
  splitUnionAtoms(set, atoms)
  const rmv = peelGroupParens(removed)
  // Atoms are VERBATIM contiguous slices of `set` separated by single `|`s
  // (see `splitUnionAtoms`), so joining KEPT atoms with `|` equals slicing the
  // kept RUNS out of `set` directly — one slice per run of consecutive
  // survivors (≤2 in the common one-atom removal) instead of two concats per
  // atom, the same slice-over-per-atom-concat pattern as the splitter itself.
  let out = ""
  let runStart = -1 // char index where the current kept run begins, -1 = none
  let pos = 0 // char index of the current atom's start within `set`
  let i = 0
  while i < atoms.length {
    if peelGroupParens(atoms[i]) != rmv {
      if runStart < 0 { runStart = pos }
    } else if runStart >= 0 {
      // The run ends BEFORE this removed atom's separator (`pos - 1`).
      if out != "" { out = out + "|" }
      out = out + set.slice(runStart, pos - 1)
      runStart = -1
    }
    pos = pos + atoms[i].length + 1
    i = i + 1
  }
  if runStart >= 0 {
    if out != "" { out = out + "|" }
    out = out + set.slice(runStart, set.length)
  }
  out
}

export function removeAtomFrom(set: string, removed: string) {
  if removed == "null" {
    const hit = raftNullKeys[set] ?? -1
    if hit >= 0 { return raftVals[hit] }
    const out = removeAtomFromGo(set, removed)
    raftNullKeys[set] = raftVals.length
    raftVals.push(out)
    return out
  }
  const mk = i32ToStr(set.length) + ":" + set + removed
  const hit = raftKeys[mk] ?? -1
  if hit >= 0 { return raftVals[hit] }
  const out = removeAtomFromGo(set, removed)
  raftKeys[mk] = raftVals.length
  raftVals.push(out)
  out
}
// True if `name` is declared by a top-level struct `type X = {…}` (`TypeDecl`). Used
// during `collectU` — BEFORE `collectS` runs — so it scans the arena directly rather
// than reading the not-yet-populated `sNames` table.
export function isDeclaredStructName(stmts: i32[], name: string) {
  let i = 0
  while i < stmts.length {
    const s = P.nodes[stmts[i]]
    if s is TypeDecl {
      if s.tdName == name { return true }
    }
    i = i + 1
  }
  false
}
// True if the atom `a` is a STRUCT variant — a declared `type X = {…}`, or an INLINE
// object shape `{x:i32}` (its fields parse from its own text; a map shape `{[…]}` is
// not). The per-member test shared by `isVariantBoxUnion` and the registration loop.
export function isStructAtom(stmts: i32[], a: string) {
  if isDeclaredStructName(stmts, a) { return true }
  nameIsShapeSpanEnds(a)
}
// True if `name` is a VARIANT-BOX union this emitter interns: two+ non-null members, every
// member a struct variant OR a value-atom OR a REF-ELEMENT array (`S[]`, `(() => f64)[]`,
// `(C | D)[]`), with AT LEAST ONE struct OR ref-array. Covers the all-struct union, the MIXED
// struct + scalar union and unions with a ref-array member — all ride the `uBoxIdx`
// `{tag, value}` box: structs as variant-struct payloads, scalars as value-box payloads,
// ref-arrays as the reflist WRAPPER ref on the anyref, tag-discriminated. A PURE value union
// (`i32 | string`) has no struct/ref-array, so `isValueUnionName` handles it earlier; a single
// struct + `null` has one non-null member, so it stays the kind-9 niche nullable ref.
// ONE walk of `name`, not two: `unionMemberCount` is the COUNTING DUAL of `splitUnionAtoms` —
// identical depth ladder, identical quoted-atom skip, identical top-level-arrow stop — so
// asking the count and then the atoms of the SAME name walked it twice for one answer, and
// `atoms.length` IS that count.
export function isVariantBoxUnion(stmts: i32[], name: string) {
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  isVariantBoxUnionAtoms(stmts, atoms)
}
// The ATOM-taking form, for a caller that has ALREADY split the same name. The split is
// the expensive half of the predicate (a whole depth walk of the name), and it is pure —
// so `registerInlineUnion`, which splits `name` into `matoms` at its top and then asked
// this question of that SAME `name` at TWO of its dispatch arms, was paying for THREE
// walks where one answers. #1147 filed this as hand-off 5 with the count measured but not
// taken; it is taken here, and the invocation counters show it (`splitUnionAtoms` and
// `tyTopIndexOf` both fall, with the classifier's own answer unchanged on every file).
export function isVariantBoxUnionAtoms(stmts: i32[], atoms: string[]) {
  if atoms.length < 2 { return false }
  let structAtoms = 0
  let refArrAtoms = 0
  let mapAtoms = 0
  let nonNull = 0
  let j = 0
  while j < atoms.length {
    if atoms[j] != "null" {
      nonNull = nonNull + 1
      if isStructAtom(stmts, atoms[j]) {
        structAtoms = structAtoms + 1
      } else if valueAtomKind(atoms[j]) >= 0 || nameIsLitUnionType(atoms[j]) {
        // A value atom (scalar / string / scalar-element list [kinds 7-10] / closure) — it
        // boxes into a shared value box or rides the anyref, tagged via `scalarTagOf`. Checked
        // BEFORE the array test so a scalar-element list (`i32[]`, `string[]`) keeps its
        // value-atom rep instead of being mis-taken for a ref-element array.
        // A litunion-ALIAS atom (`K0` in `K0 | {w: i32} | f64`) rides the box as its
        // member-string atom too (the `K0 | i64` value-union rule); the annotated
        // named-fn spelling of such a union already lowers, so the box gate admits it.
      } else if nameIsMap(atoms[j]) {
        // A MAP arm (`{[string]: string}`, `{[string]: f64}`): not a struct (a map shape carries no
        // field set) nor a value atom, so it boxes as its MAP STRUCT ref riding the box anyref,
        // tagged via `mapTagOf` — the direct analogue of the ref-array arm below. Checked BEFORE
        // `nameIsArray` (a bare map ends in `}`, not `]`, so they are disjoint). Only a SCALAR /
        // string / mono value is boxable; a REF-VALUE map arm (`{[string]: S}` / nested / union /
        // closure) has a heap-type-identity hazard in the box composite, so the WHOLE union is not a
        // box union — it stays a LOUD reject (the registration guard fails loudly, never invalid wasm).
        if !mapArmValueBoxable(atoms[j]) { return false }
        mapAtoms = mapAtoms + 1
      } else if nameIsArray(atoms[j]) {
        // A REF-ELEMENT array arm (`S[]`, `(() => f64)[]`, `(C | D)[]`): not a scalar-element
        // list (those are value atoms, handled above), so it boxes as its reflist WRAPPER ref
        // riding the box anyref, tagged via `refArrTagOf`.
        refArrAtoms = refArrAtoms + 1
      } else {
        // Neither a struct variant, a value-atom, a map, nor a ref-element array — not boxable.
        return false
      }
    }
    j = j + 1
  }
  (structAtoms >= 1 || refArrAtoms >= 1 || mapAtoms >= 1) && nonNull >= 2
}
// The synthetic type-name string of the annotation node at `tyIx` (a `TypeRef`), or
// "" if `tyIx` is unset / not a type name. Lets the inline-union scan read a param /
// return annotation's name without a `P.nodes[...] is TypeRef` round-trip at the call
// site (this slice cannot narrow there).
export function tyNameOf(tyIx: i32) {
  if tyIx >= 0 {
    const ty = P.nodes[tyIx]
    if ty is TypeRef { return ty.tyName }
  }
  ""
}
// Push `atom` onto `atoms` only if absent (dedup, preserving first-seen order).
export function pushUniqueAtom(atoms: string[], atom: string) {
  let i = 0
  while i < atoms.length {
    if atoms[i] == atom { return 0 }
    i = i + 1
  }
  atoms.push(atom)
  0
}
// The number of NON-`null` members in the pipe-joined set `set`.
export function nonNullMemberCountOf(set: string) {
  const atoms: string[] = []
  splitUnionAtoms(set, atoms)
  let n = 0
  let i = 0
  while i < atoms.length {
    if atoms[i] != "null" { n = n + 1 }
    i = i + 1
  }
  n
}
// `numLexIsFloat` (was `numTextIsFloat`, a bare `.`-scan) and `numLexIsDecimal` moved DOWN
// to `emit_bignum` when the float literal gained its scientific spelling: the checker had
// its own `.`-scan (`hasDot`) and the two would have had to learn `e`/`E` separately. The
// leaf is the only place BOTH can ask, exactly as the encoders above already do.
// The `memProp` of a Member expression at `exprIx` (or "").
export function callMemProp(exprIx: i32) {
  const e = P.nodes[exprIx]
  if e is Member { return e.memProp }
  ""
}
// The `$fnsig` signature KEY a closure-pinned parameter carries — the part after the `"=>"`
// of a monomorphized instance's synthetic annotation (`"=>ii>i"` → `"ii>i"`), or "" when
// `name` is not such a param of function `fnIx`.
// Below: top-level (paren/brace/bracket depth 0) index of `=>` in a synthetic function-type
// name, or -1.
//
// This was the last hand-written copy of the file's bracket ladder outside the homes. It
// differed from the FIND walk in exactly one thing — the arrow's two-character lookahead — so
// the lookahead moved INTO the home as the `'='` token and the copy became this one line. Do
// not reintroduce a local FIND wrapper: the one this replaced was a frame that only permuted
// arguments.
export function annArrowAt(name: string) { tyTopIndexOf(name, '=', 0, 0) }
// THE ONE HOME of "the RETURN of a function-type name": the text after a TOP-LEVEL `=>`
// (`(i32) => S[]` → `S[]`), or "" when `name` carries no top-level arrow.
//
// Sites that spelled this out as `annArrowAt(n)` + `n.slice(at + 2, n.length)` scanned twice
// on one name for one answer. The arrow INDEX is never what those callers wanted; the RESULT
// NAME is, and holding the index in a local is what let the duplicate scans hide. A caller
// that also needs the result's grouping parens peeled wraps this in `normTypeAtom` — the peel
// is a SEPARATE question and stays at the call site, so this home cannot silently widen a
// raw-slice consumer.
//
// The gate is `>= 1`, matching the function-type consumers': an arrow at index 0 would mean a
// name beginning `=>`, which no renderer produces. The CUT is `tyname.fnRetTextOf`.
export function annRetNameOf(name: string) {
  const at = annArrowAt(name)
  if at < 1 { return "" }
  fnRetTextOf(name, at)
}
// THE ONE HOME of the FUNCTION-TYPE decomposition `(p1, p2) => ret`: fills `outParams` with
// the top-level parameter annotations and returns the RETURN annotation, or "" when `ann` is
// not a fully-parenthesized function type (no top-level arrow, or the arrow is not preceded by
// the param list's own `(`…`)`). The generic-instantiation trio — `monoAnnHasTyParam`,
// `monoSubstAnn`, `monoBindFromAnn` — carried four copies of this three-part test plus its two
// slices; they are the same grammar by construction, each walking the other's output.
//
// THE EMPTY PARAM LIST IS NOT SPLIT (`() => R` yields no params), and that guard is the whole
// subtlety: `annSplitParams` pushes one EMPTY part for an empty input, so without it
// `monoSubstAnn` substitutes the empty part, gets "" back and reports the whole annotation
// unbindable. The unguarded copy paired a one-element `[""]` against another, a recursion that
// binds nothing, which is why unifying on the guarded reading changes no bytes.
export function annFnDecompose(ann: string, outParams: string[]) {
  const fa = annArrowAt(ann)
  if fa < 1 { return "" }
  // The PAREN grammar's OPEN half at its home; `fa >= 1` above already implies the bound.
  // The CLOSE test stays inline — this is the ARROW-relative spelling, closing the param
  // list at `fa - 1`, where the LAST character belongs to the return annotation.
  if !nameIsParenOpen(ann) { return "" }
  if ann[fa - 1] != ')' { return "" }
  // Both CUTS are `tyname.fnParamsTextOf` / `fnRetTextOf` (W4), given the index above.
  const inner = fnParamsTextOf(ann, fa)
  if inner.length > 0 { annSplitParams(inner, outParams) }
  fnRetTextOf(ann, fa)
}
// THE ONE HOME of the GENERIC-APPLICATION decomposition `Head<a1, a2>`: fills `outArgs` with
// the top-level type arguments and returns the HEAD name, or "" when `ann` is not an
// application. The same generic-instantiation trio carried FOUR copies of the
// `ann[n-1] == '>'` + `gaeLtAt` + `gaeSplitArgs(ann.slice(lt+1, n-1))` triple.
//
// The three-part TEST is `annGenAppSpanEnds`, one module down (D-GENAPPDOWN) and republished
// at the top of this file; `gaeLtAt` is re-asked here rather than threaded out, and that costs
// a second scan only on a name that already ends in `>` — every other name is rejected by the
// character compare before either scan runs. Both CUTS are `tyname.gaeHeadNameOf` /
// `gaeArgsTextOf`, which take the `<` index this function already holds.
export function annGenAppDecompose(ann: string, outArgs: string[]) {
  if !annGenAppSpanEnds(ann) { return "" }
  const lt = gaeLtAt(ann)
  gaeSplitArgs(gaeArgsTextOf(ann, lt), outArgs)
  gaeHeadNameOf(ann, lt)
}
// THE ONE HOME of the inline OBJECT-SHAPE decomposition `{a:T,b:U}` in the generic
// instantiation layer: fills `outNames` / `outTexts` with the top-level field names and field
// type TEXTS, returning `1` for an object shape, `0` for a MAP (`{[`) and `-1` when `ann` is
// not a `{…}` group at all. THE TRI-STATE IS LOAD-BEARING: a MAP annotation is descended by
// neither caller, but `monoAnnHasTyParam` answers `false` for the whole function where
// `monoSubstAnn` returns the annotation UNCHANGED, so "not an object" and "a map object" have
// to stay distinguishable.
//
// A malformed part (no `name:` prefix) pushes an EMPTY name, `shapeInnerFieldSplit`'s
// convention. It deliberately splits with `gaeSplitArgs` (empty parts DROPPED) rather than
// reusing `shapeInnerFieldSplit` (empty parts KEPT): the two conventions disagree on a
// trailing comma, and only the dropping one preserves what these two callers do today.
export function annObjFieldSplit(
  ann: string,
  outNames: string[],
  outTexts: string[],
) {
  // The BRACE-SPAN home decides "is this a `{…}` group at all", and the MAP-OPEN home tells
  // the two positive answers apart — the tri-state's whole character surgery, at two homes.
  // Both spellings are exact: the endpoint pair plus its length bound IS `nameIsBraceSpanEnds`,
  // and once that holds, `ann[1] == '['` IS `nameIsMapOpen` (the length bound and the `ann[0]`
  // compare are already established). The `>= 3` conjunct the map test carried was inert —
  // at length 2 the character at index 1 is the closing `}` the line above just demanded, so
  // it can never be `[`.
  if !nameIsBraceSpanEnds(ann) { return -1 }
  if nameIsMapOpen(ann) { return 0 }
  const fields: string[] = []
  // The GROUP-INTERIOR cut at its home (`tyname.groupInnerOf`, W1). This site spelled it
  // against a HOISTED length — `const n = ann.length` at the top, then `ann.slice(1, n - 1)`
  // — which is why the #1239 census scored it in a separate row from the eighteen it filed
  // under W1: the census normalises the RECEIVER but not the length EXPRESSION. Routing it
  // retires the hoist, which had no other reader.
  gaeSplitArgs(groupInnerOf(ann), fields)
  let j = 0
  while j < fields.length {
    const ci = fields[j].indexOf(":")
    if ci <= 0 {
      outNames.push("")
      outTexts.push("")
    } else {
      // The FIELD-COLON cut at its home (`tyname.fieldNameOf` / `fieldTypeTextOf`, W14).
      // The `ci <= 0` guard above stays here: this site and `shapeFieldParse` disagree on
      // whether a zero index is malformed, so the cut is delimiter-blind exactly as
      // `groupInnerOf` and `gaeArgsTextOf` are.
      outNames.push(fieldNameOf(fields[j], ci))
      outTexts.push(fieldTypeTextOf(fields[j], ci))
    }
    j = j + 1
  }
  1
}
// Split the INNER text of an inline object shape (`{…}`'s contents — `a:i32,b:{c:f64}`) into
// PARALLEL field-NAME / field-TYPE-TEXT lists at depth 0. THE ONE HOME of the shape layer's
// field scanner; `emit_base` is the lowest module its importers already depend on. A part with
// no `name:` prefix is MALFORMED and pushes an EMPTY name, and the split is PURE — every
// caller's per-field side effects run in the order they did when interleaved with the scan.
//
// The depth walk is `tyTopLevelSplit`'s, depth-aware over `{}` `[]` `()` AND the generic-
// application brackets: a field whose type is a generic APPLICATION carries the argument
// list's own `,` (`{v: Pair<i32, string>}`), and a bracket-blind depth splits the FIELD list
// at it. `>` closes only against an OPEN `<` (`tyGtIsClose`), because the renderers' `->`/`=>`
// and the `$fnsig` key's `ii>i` would otherwise run the depth NEGATIVE. **A HEADER COMMENT IS
// NOT EVIDENCE — grep the tree before quoting a blocker, including one written here.**
export function shapeInnerFieldSplit(
  inner: string,
  outNames: string[],
  outTexts: string[],
) {
  // AN EMPTY SHAPE HAS ZERO FIELDS, WHICH IS NOT WHAT THE SPLIT SAYS (D1081). The split runs
  // with `dropEmpty=false` — deliberately, so a malformed `{a:i32,,b:i32}` keeps its empty part
  // and is REPORTED rather than silently shrunk — and on the empty interior of `{}` that same
  // rule pushes ONE part whose `indexOf(":")` is -1, so every caller received a single field
  // named `""`. `collectShapeVariantFields`' `fnames[fi] == ""` guard then fired on a shape
  // with no fields at all: `type U = {} | { x: i32 }` was `vl check` rc 0 and `emitProgram:
  // malformed inline union-variant shape`, about a program in which nothing is malformed.
  //
  // The guard is on the INTERIOR, not on the part list, so the malformed-input contract is
  // untouched: `""` means the caller asked for the fields of `{}`, while `"a:i32,"` still
  // yields its empty trailing part. Every caller passes `groupInnerOf(<shape>)` and is asking
  // one question — "the fields of this shape" — for which zero is the answer here.
  if inner == "" { return 0 }
  const parts: string[] = []
  tyTopLevelSplit(inner, ',', false, parts)
  let k = 0
  while k < parts.length {
    const part = parts[k]
    const ci = part.indexOf(":")
    if ci <= 0 {
      outNames.push("")
      outTexts.push("")
    } else {
      // The FIELD-COLON cut at its home (`tyname.fieldNameOf` / `fieldTypeTextOf`, W14) —
      // the same pair as `annObjFieldSplit` above, which is the point: the two functions
      // differ only in how they SPLIT the body into parts, and the per-field cut they then
      // both wrote out is one operation.
      outNames.push(fieldNameOf(part, ci))
      outTexts.push(fieldTypeTextOf(part, ci))
    }
    k = k + 1
  }
  0
}
// True if `name` is a bare CANONICAL STRUCT shape name — a `{…}` group that is not a map
// (`{[`), carries no TOP-LEVEL arrow, and is SPACE-FREE. The gate its three
// `nameIsStructWith*Field` consumers each spelled out identically; the space test is the
// load-bearing half — a SPACED obj render (`{f: () -> i32 | boolean}` from
// `tyToStructStr`, `{f: () => i32 | boolean}` from the display entry) is NOT an `sNames`
// key, so any space marks a non-canonical name and rejects it. The structural render's
// `->` also hides a closure field from `annArrowAt`, which is a second reason and not the
// one this gate rests on.
export function canonBareShapeName(name: string) {
  // The inline-shape ENDPOINT span at its home. The three lines this replaces —
  // `length < 2`, the `{`/`}` endpoint pair, and the `name[1] == '['` map reject — are
  // `nameIsShapeSpanEnds` character for character, on every input rather than on every input
  // tried. #1186 listed this function among the FOUR `emit_base` sites carrying the WIDER
  // endpoint predicate (the one without the map reject) and left it alone on that basis; the
  // map reject was already on the line below the endpoint pair at #1186's own commit, so the
  // decline was reasoning about a spelling this function did not have.
  if !nameIsShapeSpanEnds(name) { return false }
  if annArrowAt(name) >= 0 { return false }
  // The SPACE-FREE ASSERTION at its home (`tyname.nameIsSpaceFree`, W7) — the rule this
  // function's header calls "the load-bearing half", now named once for the tree.
  nameIsSpaceFree(name)
}
// True if `name` is a bare CANONICAL STRUCT shape (`{f:…,…}`, not a map) with at least one FIELD
// whose type is a top-level UNION — `{f:boolean|{w:i32}}`, `{f:i64|string}`. Such a struct has a
// BOXED field slot (a `(ref $uBox)`), which a body ObjLit built from bare-scalar/struct literals
// does NOT naturally produce (the literal self-infers the plain field shape). Used by
// `synthRetAnnots` to pin an anonymous lambda's `fnRet` to the checker-adopted union-field struct
// (recorded by `structFieldBoxRetName`) so its `$fnsig` result + body boxing match the annotated
// named-function form. Requires the CANONICAL (space-free, `=>`-arrow) emit spelling — the only
// interned `sNames` key — and skips a CLOSURE field (top-level `=>`, whose `|` binds to the
// closure RESULT, not the field: `(i32) => f32 | {w:i32}` is a closure returning a union, NOT a
// union field). A top-level arrow / a map (`{[`) is not a struct here.
export function nameIsStructWithUnionField(name: string) {
  // CANONICAL only, and not a map / closure — `canonBareShapeName`, the gate this
  // function and its two siblings each spelled out.
  if !canonBareShapeName(name) { return false }
  const fnames: string[] = []
  const ftexts: string[] = []
  // The GROUP-INTERIOR cut at its home (`tyname.groupInnerOf`, W1) — the gate above is the
  // guard, and `canonBareShapeName` opens with `nameIsShapeSpanEnds`, so the home's bound is
  // already discharged here.
  shapeInnerFieldSplit(groupInnerOf(name), fnames, ftexts)
  let fi = 0
  while fi < fnames.length {
    if fnames[fi] != "" {
      const ftype = ftexts[fi]
      // A CLOSURE field (top-level `=>`) binds any `|` to its RESULT — skip it. Only a field
      // type that is itself a top-level UNION (`|` at depth 0) is a boxed field slot. The
      // depth-0 bar scan is the checker's home, the same walk `nullablePartOf` asks.
      if annArrowAt(ftype) < 0 {
        if tyTopIndexOf(ftype, '|', 0, 0) >= 0 { return true }
        // A NESTED bare-shape field (`{f:{f:i32|string}}`): the boxed slot may sit one level
        // down — RECURSE, so the `synthRetAnnots` pin fires for a lambda whose NESTED literal
        // field adopted a union-field shape (`objLitWidenFields`' descent; without the pin its
        // `$fnsig` kept the self-inferred plain layout — INVALID WASM, found by fuzz-nightly).
        // A nested map (`{[`) declines inside the recursion's own gate.
        //
        // Do not re-add an endpoint pre-filter here: it was REDUNDANT. The recursion's own
        // first line is `canonBareShapeName(ftype)`, whose first two tests are `length < 2`
        // and the same `{`/`}` endpoint pair, so the call already answers `false` on exactly
        // the names such a guard would reject. Both functions are pure, so removing it changes
        // no answer and costs one call on a field type about to be rejected by three compares.
        if nameIsStructWithUnionField(ftype) { return true }
      }
    }
    fi = fi + 1
  }
  false
}
// True if `name` is a bare CANONICAL STRUCT shape with at least one field whose type is a
// LITUNION ALIAS (`{f:K0}`) — at any struct-nesting depth. Such a struct's field slot is the
// litunion's i32 ATOM, which a body ObjLit built from a bare string literal does NOT naturally
// produce (it self-infers `{f:string}` — a TWIN struct at a different rep). The litunion-atom
// sibling of `nameIsStructWithUnionField`: used by `synthRetAnnots` to pin an anonymous lambda's
// `fnRet` to the checker-adopted litunion-field struct (recorded by `structFieldBoxRetName`), so
// its `$fnsig` result + body literal build the atom struct the annotated named-function form
// (and every annotated consumer) codes. Without the pin a lambda nested where NO annotation
// threads (a union's closure arm inside another lambda's expression body) self-coded the string
// twin — a runtime cast-failure TRAP at the narrowed call (fuzz-nightly seed 26306770 d4,
// `() => ((i32) => {f: K0}) | i32`). Same CANONICAL-spelling gate as the sibling.
export function nameIsStructWithLitUnionField(name: string) {
  if !canonBareShapeName(name) { return false }
  const fnames: string[] = []
  const ftexts: string[] = []
  // The GROUP-INTERIOR cut at its home (`tyname.groupInnerOf`, W1), same guard as the sibling.
  shapeInnerFieldSplit(groupInnerOf(name), fnames, ftexts)
  let fi = 0
  while fi < fnames.length {
    if fnames[fi] != "" {
      const ftype = ftexts[fi]
      if nameIsLitUnionType(ftype) { return true }
      // The endpoint pre-filter, DELETED as redundant for the same reason as the sibling's:
      // the recursion opens with `canonBareShapeName(ftype)`, which begins with the identical
      // `length < 2` + `{`/`}` endpoint rejects.
      if nameIsStructWithLitUnionField(ftype) { return true }
    }
    fi = fi + 1
  }
  false
}
// True if `name` is a bare CANONICAL STRUCT shape carrying a MAP (`{[`) anywhere in its
// field tree (`{a:string,f:{f:{[string]:{f:i64}}},z:f32}`). A map-carrying struct a lambda
// body literal builds has no field-set anchor for its nested literals — un-pinned, the
// inner `{f: h0}` resolved by first-field-name-set match onto the map's own VALUE struct
// (a wrong-layout twin), so `synthRetAnnots` pins the lambda's `fnRet` to the checker's
// canonical record (`structMapFieldRetName`) and the body ObjLit threads the SAME
// per-field struct indices the annotated named-function spelling seeds. Same
// CANONICAL-spelling gate as its siblings; the leading `{[` test keeps a bare MAP name
// out (a map is not a field struct), and any deeper `{[` occurrence IS a map field at
// some nesting level (no other canon construct spells `{[`).
export function nameIsStructWithMapField(name: string) {
  if !canonBareShapeName(name) { return false }
  let sp = 0
  while sp < name.length {
    if name[sp] == '{' && sp + 1 < name.length {
      if name[sp + 1] == '[' { return true }
    }
    sp = sp + 1
  }
  false
}
// Split a function-type PARAM list (`i32,f64,S`) on top-level commas (depth-aware) —
// the KEEP-empty reading of the shared depth walk, so an empty param list yields ONE
// empty part (see `annFnDecompose`'s guard, and D-GRAMHOME's S5 fixture).
export function annSplitParams(s: string, out: string[]) {
  tyTopLevelSplit(s, ',', false, out)
}
// The closure-ABI return suffix for a type NAME (`i32`/`boolean` → ">i", `f64` → ">d", a
// struct → ">s<idx>;"), or "" outside the value-returning ABI. (`void` is a later slice —
// its `>v` sig is not interned by the value-eligible pass.)
// Depth-aware split of a type NAME on its top-level `|` (the union/nullable separator) —
// the `annSplitParams` analogue for `|`, the same KEEP-empty reading of the shared walk.
export function annSplitPipe(s: string, out: string[]) {
  tyTopLevelSplit(s, '|', false, out)
}
// True if the type-annotation node at `tyIx` is a function type — the self-host parses a
// function-typed annotation as a `TypeRef` whose name contains `=>` or `(`/`)->`. For the
// corpus, function params are rare; a closure param is detected structurally elsewhere.
export function tyIsFuncType(tyIx: i32) {
  if tyIx < 0 { return false }
  // The arena covers every function-typed node (annotation, mono `=>sigkey` pin, struct field) —
  // read it ONLY; the depth-aware arrow name test is retired (C1 endgame).
  if nodeTyIxOf(tyIx) >= 0 { return nodeTyIsFunc(tyIx) }
  false
}
// True if `s` contains the substring `sub`.
export function strContains(s: string, sub: string) {
  if sub.length == 0 { return true }
  if sub.length > s.length { return false }
  let i = 0
  while i + sub.length <= s.length {
    let j = 0
    let ok = true
    while j < sub.length {
      if s[i + j] != sub[j] {
        ok = false
        j = sub.length
      } else {
        j = j + 1
      }
    }
    if ok { return true }
    i = i + 1
  }
  false
}
// Is the FuncDecl at arena index `fnIx` generic — explicit `<T>` params, or any
// un-annotated parameter (a per-callsite inference hole)?
export function monoIsGenericDecl(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    if fn.fnTyParams.length > 0 { return true }
    const ps = fn.fnParams
    let i = 0
    while i < ps.length {
      const p = P.nodes[ps[i]]
      if p is Param {
        if p.parType < 0 { return true }
      }
      i = i + 1
    }
  }
  false
}
// The type-parameter NAME a written annotation rides on — `ann == tp` (bare) or
// `ann == tp + "[]"` (array-of) for some `tp` in `typarams` — or "" when the annotation is
// concrete. Mirrors the checker's `resolveAnnot` shape.
// THE ONE-RUNG `[]` READING IS DELIBERATE: `monoSubstAnn`'s `monoTyParamOf` branch answers
// `b + "[]"`, ONE `[]` rebuilt from a boolean, so a `T[][]` pattern claimed here would pin an
// instance a dimension short of what the checker typed. It reads one rung because the branch
// it feeds writes one rung — the deeper run is an arm at the BOTTOM of `monoAnnHasTyParam` /
// `monoSubstAnn` / `monoBindFromAnn`, re-attaching the run as the slice it already is.
// A PARAMETER NAMED FOR A PRIMITIVE BINDS NOTHING (`gaeParamShadowed`): the checker resolves a
// bare name `primTyOfName -> tpEnvTyOfName -> declaredTyOfName`, so in `function id<i64>(v: i64)`
// the annotation IS the builtin. Without the guard the instance's PARAM was rewritten to the
// ARGUMENT's type while the RETURN kept `i64` — `vl check` rc=0 and invalid wasm.
export function monoTyParamOf(ann: string, typarams: string[]) {
  let i = 0
  while i < typarams.length {
    if typarams[i] == ann && !gaeParamShadowed(typarams[i]) {
      return typarams[i]
    }
    i = i + 1
  }
  // The array-name grammar at its two homes. The TEST is kept in front of the CUT rather
  // than reading the cut's `""`: this loop compares `base` against each type-param name, so
  // "not an array" and "the element of `[]`" are the one pair of answers `arrElemNameRaw`
  // does NOT keep apart, and collapsing them here would be a behaviour claim about whether
  // `"[]"` is a producible annotation.
  if nameIsArray(ann) {
    const base = arrElemNameRaw(ann)
    let j = 0
    while j < typarams.length {
      if typarams[j] == base && !gaeParamShadowed(typarams[j]) {
        return typarams[j]
      }
      j = j + 1
    }
  }
  ""
}
// The first-use-wins binding of type-param `tp` in the per-call binding lists,
// or "" if unbound.
export function monoBindOf(tvN: string[], tvV: string[], tp: string) {
  let i = 0
  while i < tvN.length {
    if tvN[i] == tp { return tvV[i] }
    i = i + 1
  }
  ""
}
// Does the annotation NAME reach a declared type param — bare (`T`), array-of at any dimension
// (`T[]`, `T[][]`), a UNION member (`T | null`), a generic-alias application argument
// (`Box<T>`), an inline object shape's field type, a function type's parameter or result, or
// any of those under a grouping paren or behind a `[]` run (`(T | null)[]`, `{a: T}[]`)?
//
// THE ARM LIST IS `monoSubstAnn`'S, IN THE SAME ORDER, AND THAT IS A CONTRACT rather than a
// coincidence: every caller asks this first and substitutes second, so an arm here that the
// substitution lacks reports a parameter it then fails to replace, and an arm there that this
// lacks leaves the substitution unreached. The two were already out of step on the UNION and
// on `[]` depth, which is exactly where the generic-alias field residues sat. READ THE ARMS,
// NOT THIS SENTENCE — the `[]`-run claim above stood in this header for two slices before any
// arm delivered it.
export function monoAnnHasTyParam(ann: string, typarams: string[]) {
  if monoTyParamOf(ann, typarams) != "" { return true }
  // A top-level UNION (`T | null`, `T | i32`). `splitUnionAtoms` is depth- and
  // quote-aware and stops at a top-level `=>`, so a function type whose RESULT is a
  // union stays one atom and falls through to the function arm below.
  if unionMemberCount(ann) > 1 {
    // COUNT BEFORE CUTTING (B278's shape). The split ran unconditionally and its result was
    // used only for a 2+-member union; a single-member annotation built one string holding the
    // whole spelling and dropped it. `unionMemberCount` equalled the split's length at every
    // one of these mono sites, so the count is the same answer for strictly less work.
    const uatoms: string[] = []
    splitUnionAtoms(ann, uatoms)
    let u = 0
    while u < uatoms.length {
      if monoAnnHasTyParam(uatoms[u], typarams) { return true }
      u = u + 1
    }
    return false
  }
  // A MAP annotation (`{[string]: T}`). Both this predicate and `monoSubstAnn` were missing
  // this arm, and the pair of omissions is one bug: with no arm here the substitution is
  // never even ATTEMPTED, so a generic returning a map kept the ORIGINAL annotation and the
  // type parameter survived into the instance as a nominal name. `vl check --codegen` rc 0,
  // `vl run` "expected i32, found (ref $type)".
  //
  // The VALUE only. A map KEY is `string` or `i32` by construction (`mkMapTy`'s own rule),
  // so a parameter cannot reach that position, and asking would be dead weight.
  if nameIsMap(ann) {
    const mval = mapValNameOf(ann)
    if mval != "" {
      if monoAnnHasTyParam(mval, typarams) { return true }
    }
  }
  const parts: string[] = []
  if annGenAppDecompose(ann, parts) != "" {
    let i = 0
    while i < parts.length {
      if monoAnnHasTyParam(parts[i], typarams) { return true }
      i = i + 1
    }
    return false
  }
  const onames: string[] = []
  const otexts: string[] = []
  const okind = annObjFieldSplit(ann, onames, otexts)
  if okind == 0 { return false }
  if okind > 0 {
    let j = 0
    while j < onames.length {
      if onames[j] != "" {
        if monoAnnHasTyParam(otexts[j], typarams) { return true }
      }
      j = j + 1
    }
  }
  // A FUNCTION-TYPE annotation `(p1, p2) => ret` (a closure param / return): a type
  // param may ride any parameter or the result, so recurse into each (parallel to
  // `monoSubstAnn`'s function-type branch). Without this, a generic closure param
  // `f: (A, T) => A` reads as concrete and keeps its un-substituted annotation.
  const fparts: string[] = []
  const fret = annFnDecompose(ann, fparts)
  if fret != "" {
    let fi = 0
    while fi < fparts.length {
      if monoAnnHasTyParam(fparts[fi], typarams) { return true }
      fi = fi + 1
    }
    if monoAnnHasTyParam(fret, typarams) { return true }
  }
  // A GROUPING paren around the whole (`(T | null)` — the form a composite element wears
  // under a `[]`). Below the function arm, so a top-level function type is claimed there
  // first; `peelGroupParens` answers a non-parenthesized name with itself.
  const pk = peelGroupParens(ann)
  if pk != ann { return monoAnnHasTyParam(pk, typarams) }
  // The `[]` RUN over a composite element (`(T | null)[]`, `{a: T}[]`, `T[][]`, `Box<T>[]`).
  // LAST, and peeling the WHOLE run in one step: every arm above claims a name by its
  // OUTERMOST constructor, and a `[]` run's outermost constructor is the run.
  //
  // IT IS NOT PUSHED DOWN INTO `monoTyParamOf`, and that distinction is why the earlier
  // version of this widening moved cells BACKWARD. `monoSubstAnn`'s `monoTyParamOf` branch
  // answers with `b + "[]"` — ONE `[]`, from a boolean "was there a `[]`" — so a `T[][]`
  // pattern teaching THAT arm substitutes to a one-dimensional name and the instance's
  // parameter silently loses a dimension. The run arm re-attaches the run as the SLICE it
  // already is, so the dimensions are carried rather than recomputed.
  const leaf = arrLeafNameOf(ann)
  if leaf != ann { return monoAnnHasTyParam(leaf, typarams) }
  false
}
// The annotation name to READ for a generic FUNCTION's parameter or return: the arena's
// (canon'd) spelling, except where the annotation IS a type parameter — there, the DECLARED
// one. The FuncDecl twin of `emit_collect.gaeDeclFieldTyName`, for the identical reason at the
// identical gate.
//
// `canonEmitTypeNames` is a name rewrite with NO SCOPE, so in `type Id = i32` +
// `function ident<Id>(v: Id): Id` it resolved the parameter annotation to `i32` while the
// CHECKER resolved it as the parameter. `monoTyParamOf` was then handed `i32` against a
// parameter list holding `Id`, matched nothing, and the instance pinned `i32` while the call
// passed a string: `vl check` rc=0 and invalid wasm. THE GATE IS `monoAnnHasTyParam` ON THE RAW
// SPELLING — the substitution's own decision, carrying the primitive-shadow guard through
// `monoTyParamOf` — so a non-parametric annotation in the same signature keeps its canon'd name.
export function monoDeclAnnName(
  nodeIx: i32,
  canoned: string,
  typarams: string[],
) {
  const raw = declAnnRawTyName(nodeIx)
  if raw == "" { return canoned }
  if !monoAnnHasTyParam(raw, typarams) { return canoned }
  raw
}
// Substitute the per-call type-param bindings through an annotation NAME —
// bare `T` / `T[]`, application arguments (`Box<T>` → `Box<i32>`), and inline
// object-shape field types (`{first:B,second:A}` → `{first:string,second:i32}`).
// Returns "" when an UNBOUND type param remains (the instance cannot be named);
// a fully concrete annotation returns unchanged.
export function monoSubstAnn(
  ann: string,
  typarams: string[],
  tvN: string[],
  tvV: string[],
) {
  const tp = monoTyParamOf(ann, typarams)
  if tp != "" {
    const b = monoBindOf(tvN, tvV, tp)
    if b == "" { return "" }
    if ann == tp { return b }
    return b + "[]"
  }
  // A top-level UNION (`T | null`): substitute each member and rejoin. Paired with
  // `monoAnnHasTyParam`'s union arm — see the contract note there.
  if unionMemberCount(ann) > 1 {
    // COUNT BEFORE CUTTING (B278's shape). The split ran unconditionally and its result was
    // used only for a 2+-member union; a single-member annotation built one string holding the
    // whole spelling and dropped it. `unionMemberCount` equalled the split's length at every
    // one of these mono sites, so the count is the same answer for strictly less work.
    const uatoms: string[] = []
    splitUnionAtoms(ann, uatoms)
    // SUBSTITUTION CAN COLLAPSE A UNION, and the rejoin has to answer for that. A blind
    // `a + "|" + b` produced spellings no source program can contain and no interner has seen —
    // `T | string` at `T := string` -> `"string|string"`, `T | null` at `T := string | null` ->
    // `"string|null|null"` — all `vl check --codegen` rc 0 and `vl run` invalid wasm.
    //
    // The SOURCE spelling of the first is legal and works, because the parser/checker collapses
    // it before anything interns it. A spelling REBUILT here gets no such pass, which is this
    // layer's documented hazard — "a rebuilt spelling is a second intern key" — in its purest
    // form: the key is not merely a second one, it is one nothing can read. So the rejoin does
    // what the checker would have: FLATTEN each substituted atom (it may itself be a union),
    // DEDUPE by first occurrence (order kept, so a union whose arms do not collapse re-renders
    // to the same bytes and is never a new key), and return the BARE atom when one survives.
    const outs: string[] = []
    let u = 0
    while u < uatoms.length {
      const us = monoSubstAnn(uatoms[u], typarams, tvN, tvV)
      if us == "" { return "" }
      const inner: string[] = []
      splitUnionAtoms(us, inner)
      let k = 0
      while k < inner.length {
        let seen = false
        let m = 0
        while m < outs.length {
          if outs[m] == inner[k] { seen = true }
          m = m + 1
        }
        if !seen { outs.push(inner[k]) }
        k = k + 1
      }
      u = u + 1
    }
    if outs.length == 0 { return "" }
    if outs.length == 1 { return outs[0] }
    let outU = ""
    let q = 0
    while q < outs.length {
      if q > 0 { outU = outU + "|" }
      outU = outU + outs[q]
      q = q + 1
    }
    return outU
  }
  // The MAP arm, paired with `monoAnnHasTyParam`'s — see the contract note there.
  //
  // The KEY PREFIX rides as the SLICE it already is (`ann.slice(0, mi + 2)`, everything
  // through the `]:`), never rebuilt from parts, and the re-render is gated on the value
  // actually MOVING — so a concrete map annotation is returned VERBATIM and never becomes a
  // second intern key. Same discipline as the `[]`-run and grouping-paren arms below.
  if nameIsMap(ann) {
    let mi = 2
    while mi < ann.length - 1 {
      if ann[mi] == ']' {
        if ann[mi + 1] == ':' {
          const mval = ann.slice(mi + 2, ann.length - 1)
          if mval == "" { return ann }
          const msub = monoSubstAnn(mval, typarams, tvN, tvV)
          if msub == "" { return "" }
          if msub == mval { return ann }
          return ann.slice(0, mi + 2) + msub + "}"
        }
      }
      mi = mi + 1
    }
    return ann
  }
  const parts: string[] = []
  const gHead = annGenAppDecompose(ann, parts)
  if gHead != "" {
    let outAnn = gHead + "<"
    let i = 0
    while i < parts.length {
      const s = monoSubstAnn(parts[i], typarams, tvN, tvV)
      if s == "" { return "" }
      if i > 0 { outAnn = outAnn + "," }
      outAnn = outAnn + s
      i = i + 1
    }
    return outAnn + ">"
  }
  const onames: string[] = []
  const otexts: string[] = []
  const okind = annObjFieldSplit(ann, onames, otexts)
  if okind == 0 { return ann }
  if okind > 0 {
    let outObj = "{"
    let j = 0
    while j < onames.length {
      if onames[j] == "" { return ann }
      const fs = monoSubstAnn(otexts[j], typarams, tvN, tvV)
      if fs == "" { return "" }
      if j > 0 { outObj = outObj + "," }
      outObj = outObj + onames[j] + ":" + fs
      j = j + 1
    }
    return outObj + "}"
  }
  // A FUNCTION-TYPE annotation `(p1, p2) => ret` (a closure param / return) riding type
  // params: substitute each parameter and the return through the binding, so a generic
  // closure param `f: (A, T) => A` pins to `(string, string) => string` for the instance.
  // Without it the instance body's `f(…)` call resolves no interned `$fnsig` (the param
  // kept the un-substituted `(A, T) => A`) and the value call mis-lowers.
  const fparts: string[] = []
  const fret = annFnDecompose(ann, fparts)
  if fret != "" {
    let outFn = "("
    let fi = 0
    while fi < fparts.length {
      const fs2 = monoSubstAnn(fparts[fi], typarams, tvN, tvV)
      if fs2 == "" { return "" }
      if fi > 0 { outFn = outFn + "," }
      outFn = outFn + fs2
      fi = fi + 1
    }
    const rs2 = monoSubstAnn(fret, typarams, tvN, tvV)
    if rs2 == "" { return "" }
    return outFn + ")=>" + rs2
  }
  // A GROUPING paren around the whole (`(T | null)` — the form a composite element wears
  // under a `[]`), the arm `monoAnnHasTyParam` closes with. It re-renders only when the
  // recursion actually moved: an untouched inner name returns `ann` VERBATIM, so a
  // concrete annotation is never reassembled (a rebuilt spelling is a second intern key,
  // which is the whole hazard this layer exists in).
  const pk = peelGroupParens(ann)
  if pk != ann {
    const ps = monoSubstAnn(pk, typarams, tvN, tvV)
    if ps == "" { return "" }
    if ps == pk { return ann }
    return "(" + ps + ")"
  }
  // The `[]` RUN, `monoAnnHasTyParam`'s closing arm in the same position. `arrLeafNameOf`
  // strips whole `[]` pairs off the END, so the leaf is a PREFIX of `ann` and the
  // remainder is precisely the repetitions to re-attach — the dimensions ride as the slice
  // they already are, never rebuilt from a count. (Identical to `gaeApplyFieldTy`, which
  // has carried this arm OUTSIDE the walk since #1234; the alias half can now stop
  // peeling first, but the peel there is harmless and its header explains the seam.)
  //
  // An UNBOUND leaf returns "" up the chain, which is `monoSubstAnn`'s documented "the
  // instance cannot be named" — and that is what turns `function fnv<T>(v: T[][])`'s
  // written-then-invalid module into the monomorphizer's own loud reject when nothing
  // binds `T`. Re-rendering is gated on the leaf actually MOVING, so a concrete `[]` run
  // is returned verbatim and never becomes a second intern key.
  const leaf = arrLeafNameOf(ann)
  if leaf != ann {
    const ls = monoSubstAnn(leaf, typarams, tvN, tvV)
    if ls == "" { return "" }
    if ls == leaf { return ann }
    return ls + ann.slice(leaf.length, ann.length)
  }
  ann
}
// Bind type params by matching a parameter's annotation PATTERN against the
// argument's concrete type name: `T` against anything, `T[]` against `X[]`,
// `Box<T>` against `Box<i32>` (same head, pairwise arguments). First use wins.
export function monoBindFromAnn(
  pat: string,
  actual: string,
  typarams: string[],
  tvN: string[],
  tvV: string[],
) {
  const tp = monoTyParamOf(pat, typarams)
  if tp != "" {
    let bind = actual
    if pat != tp {
      // A `T[]` pattern binds `T` to the ARGUMENT's element — the array-name grammar at
      // its two homes. The TEST is kept in front of the CUT for `monoTyParamOf`'s reason:
      // `bind` is pushed as a binding, so an empty element is not the same answer as "not
      // an array" and this merge asserts nothing about `"[]"`.
      if !nameIsArray(actual) { return 0 }
      bind = arrElemNameRaw(actual)
    }
    if monoBindOf(tvN, tvV, tp) == "" {
      tvN.push(tp)
      tvV.push(bind)
    }
    return 0
  }
  // A top-level UNION pattern (`T | null` against `string | null`): bind member-wise.
  // The three walks are the SAME arm list in the SAME order and that is the contract
  // `monoAnnHasTyParam`'s header states — this one was missing the union, the object and
  // the paren, so `monoAnnHasTyParam` reported a parameter, `monoSubstAnn` was ready to
  // replace it, and nothing had put a binding in the table for either to use.
  //
  // THE MEMBER COUNTS MUST MATCH BEFORE ANY PAIR IS BELIEVED. Positional pairing is what
  // the generic-application and function-type arms below already do; on a union it is the
  // arm's whole risk, so a differing arity binds NOTHING rather than pairing `T` with
  // whichever member happens to sit at its index.
  if unionMemberCount(pat) > 1 {
    // COUNT BEFORE CUTTING (B278's shape). The split ran unconditionally and its result was
    // used only for a 2+-member union; a single-member annotation built one string holding the
    // whole spelling and dropped it. `unionMemberCount` equalled the split's length at every
    // one of these mono sites, so the count is the same answer for strictly less work.
    const puatoms: string[] = []
    splitUnionAtoms(pat, puatoms)
    const auatoms: string[] = []
    splitUnionAtoms(actual, auatoms)
    if puatoms.length == auatoms.length {
      let ui = 0
      while ui < puatoms.length {
        monoBindFromAnn(puatoms[ui], auatoms[ui], typarams, tvN, tvV)
        ui = ui + 1
      }
    }
    return 0
  }
  // THE `[]` RUN, the arm `monoSubstAnn` has had all along while this one did not (D753).
  // `monoTyParamOf`'s branch above peels exactly ONE `[]` — written for the `T[]` pattern, it
  // answers "" for `T[][]` — so a MULTI-dimensional pattern reached here, matched no arm, bound
  // nothing, and `monoSubstAnn` then answered "" for a type parameter nobody had put in the
  // table: `emitProgram: monomorphize: unsupported argument type`. `function idLL<T>(a: T[][])`
  // at an `i32[][][]` argument is the witness; a MONOMORPHIZER gap, not an operator one.
  //
  // THE PATTERN'S DIMENSIONS ARE THE CUT, NOT THE ACTUAL'S. `arrLeafNameOf` strips whole `[]`
  // pairs off the END, so `pat.length - leaf.length` IS the run to remove from the argument —
  // `T[][]` against `i32[][][]` binds `T` to `i32[]`, not the argument's own leaf `i32`. Taking
  // the actual's leaf binds a type parameter no substitution can rebuild. An argument with too
  // FEW dimensions binds nothing: a defensive floor, the checker having proved the call typed.
  const pLeaf = arrLeafNameOf(pat)
  if pLeaf != pat {
    const dims = pat.length - pLeaf.length
    const aLeaf = arrLeafNameOf(actual)
    if actual.length - aLeaf.length >= dims {
      monoBindFromAnn(
        pLeaf,
        actual.slice(0, actual.length - dims),
        typarams,
        tvN,
        tvV,
      )
    }
    return 0
  }
  const pparts: string[] = []
  const pHead = annGenAppDecompose(pat, pparts)
  if pHead != "" {
    const aparts: string[] = []
    if pHead == annGenAppDecompose(actual, aparts) {
      let i = 0
      while i < pparts.length {
        if i < aparts.length {
          monoBindFromAnn(pparts[i], aparts[i], typarams, tvN, tvV)
        }
        i = i + 1
      }
    }
  }
  // An INLINE OBJECT SHAPE pattern (`{a: T}` against `{a:i32}`): bind field-wise, pairing
  // by the field NAME rather than the index, because the pattern is the DECLARED spelling
  // and the actual is the arena's canon'd one — two renderings of one shape that agree on
  // names but need not agree on anything else. A field the two do not share binds nothing.
  const pon: string[] = []
  const pot: string[] = []
  if annObjFieldSplit(pat, pon, pot) > 0 {
    const aon: string[] = []
    const aot: string[] = []
    if annObjFieldSplit(actual, aon, aot) > 0 {
      let oi = 0
      while oi < pon.length {
        if pon[oi] != "" {
          let oj = 0
          while oj < aon.length {
            if aon[oj] == pon[oi] {
              monoBindFromAnn(pot[oi], aot[oj], typarams, tvN, tvV)
            }
            oj = oj + 1
          }
        }
        oi = oi + 1
      }
    }
    return 0
  }
  // A FUNCTION-TYPE pattern `(P1, P2) => R` against the argument's function type
  // `(i32, i32) => i32`: bind type params pairwise across the parameters and the
  // return (parallel to `monoSubstAnn` / `monoAnnHasTyParam`). Binds `reduce`'s
  // `f: (A, T) => A` from the lambda argument's concrete `(i32, i32) => i32`.
  const pp: string[] = []
  const pRet = annFnDecompose(pat, pp)
  if pRet != "" {
    const ap: string[] = []
    const aRet = annFnDecompose(actual, ap)
    if aRet != "" {
      let fi = 0
      while fi < pp.length {
        if fi < ap.length {
          monoBindFromAnn(pp[fi], ap[fi], typarams, tvN, tvV)
        }
        fi = fi + 1
      }
      monoBindFromAnn(pRet, aRet, typarams, tvN, tvV)
    }
  }
  // A GROUPING paren around the whole (`(T | null)` — the form a composite element wears
  // under a `[]`), below the function arm exactly as in the two sibling walks. The ACTUAL
  // is peeled too and independently: the pattern is the DECLARED spelling and the actual
  // the canon'd one, and the two need not agree about whether the group is parenthesized.
  const ppk = peelGroupParens(pat)
  if ppk != pat {
    monoBindFromAnn(ppk, peelGroupParens(actual), typarams, tvN, tvV)
    return 0
  }
  // The `[]` RUN, the arm its two siblings close with, in the same position. `T[]` never
  // reaches here — `monoTyParamOf` claims one `[]` level at the top and binds the
  // ARGUMENT's element — so this is the run of TWO OR MORE (`T[][]`) and the run over a
  // composite (`Box<T>[]`).
  //
  // THE RUN LENGTHS MUST MATCH BEFORE EITHER LEAF IS BELIEVED. `arrLeafNameOf` peels to
  // fixpoint on both sides independently, so `T[][]` against `i32[]` would otherwise pair
  // `T` with `i32` and pin an instance one dimension short of what the CHECKER typed —
  // the same class of silent mis-pin this whole layer exists to stop. The lengths are
  // compared as SLICE widths (leaf is a prefix of the whole on both sides), which is the
  // `[]`-pair count without counting.
  const leafP = arrLeafNameOf(pat)
  if leafP != pat {
    const leafA = arrLeafNameOf(actual)
    if pat.length - leafP.length == actual.length - leafA.length {
      monoBindFromAnn(leafP, leafA, typarams, tvN, tvV)
    }
  }
  0
}
// Is `op` an operator that may dispatch to a `self`-method / operator field?
// Assignment, equality (structural compare), the logicals and `??` keep their
// native forms.
export function drwDispatchOp(op: string) {
  if op == "=" { return false }
  if op == "==" || op == "!=" { return false }
  if op == "&&" || op == "||" || op == "??" { return false }
  true
}
