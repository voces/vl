}
// True if `name` is a bare CANONICAL STRUCT shape carrying a MAP (`{[`) anywhere in its
// field tree (`{a:string,f:{f:{[string]:{f:i64}}},z:f32}`). A map-carrying struct a lambda
// body literal builds has no field-set anchor for its nested literals — un-pinned, the
// inner `{f: h0}` resolved by first-field-name-set match onto the map's own VALUE struct
// (a wrong-layout twin), so `synthRetAnnots` pins the lambda's `fnRet` to the checker's
// canonical record (`structMapFieldRetName`) and the body ObjLit threads the SAME
// per-field struct indices the annotated named-function spelling seeds. Same
// CANONICAL-spelling gate as its siblings; the leading `{[` test keeps a bare MAP name
// out (a map is not a field struct), and any deeper `{[` occurrence IS a map field at
// some nesting level (no other canon construct spells `{[`).
export function nameIsStructWithMapField(name: string) {
  if !canonBareShapeName(name) { return false }
  let sp = 0
  while sp < name.length {
    if name[sp] == '{' && sp + 1 < name.length {
      if name[sp + 1] == '[' { return true }
    }
    sp = sp + 1
  }
  false
}
// Split a function-type PARAM list (`i32,f64,S`) on top-level commas (depth-aware) —
// the KEEP-empty reading of the shared depth walk, so an empty param list yields ONE
// empty part (see `annFnDecompose`'s guard, and D-GRAMHOME's S5 fixture).
export function annSplitParams(s: string, out: string[]) {
  tyTopLevelSplit(s, ',', false, out)
}
// The closure-ABI return suffix for a type NAME (`i32`/`boolean` → ">i", `f64` → ">d", a
// struct → ">s<idx>;"), or "" outside the value-returning ABI. (`void` is a later slice —
// its `>v` sig is not interned by the value-eligible pass.)
// Depth-aware split of a type NAME on its top-level `|` (the union/nullable separator) —
// the `annSplitParams` analogue for `|`, the same KEEP-empty reading of the shared walk.
export function annSplitPipe(s: string, out: string[]) {
  tyTopLevelSplit(s, '|', false, out)
}
// True if the type-annotation node at `tyIx` is a function type — the self-host parses a
// function-typed annotation as a `TypeRef` whose name contains `=>` or `(`/`)->`. For the
// corpus, function params are rare; a closure param is detected structurally elsewhere.
export function tyIsFuncType(tyIx: i32) {
  if tyIx < 0 { return false }
  // The arena covers every function-typed node (annotation, mono `=>sigkey` pin, struct field) —
  // read it ONLY; the depth-aware arrow name test is retired (C1 endgame).
  if nodeTyIxOf(tyIx) >= 0 { return nodeTyIsFunc(tyIx) }
  false
}
// True if `s` contains the substring `sub`.
export function strContains(s: string, sub: string) {
  if sub.length == 0 { return true }
  if sub.length > s.length { return false }
  let i = 0
  while i + sub.length <= s.length {
    let j = 0
    let ok = true
    while j < sub.length {
      if s[i + j] != sub[j] {
        ok = false
        j = sub.length
      } else {
        j = j + 1
      }
    }
    if ok { return true }
    i = i + 1
  }
  false
}
// Is the FuncDecl at arena index `fnIx` generic — explicit `<T>` params, or any
// un-annotated parameter (a per-callsite inference hole)?
export function monoIsGenericDecl(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    if fn.fnTyParams.length > 0 { return true }
    const ps = fn.fnParams
    let i = 0
    while i < ps.length {
      const p = P.nodes[ps[i]]
      if p is Param {
        if p.parType < 0 { return true }
      }
      i = i + 1
    }
  }
  false
}
// The type-parameter NAME a written annotation rides on — `ann == tp` (bare) or
// `ann == tp + "[]"` (array-of) for some `tp` in `typarams` — or "" when the
// annotation is concrete. Mirrors the checker's `resolveAnnot` shape.
//
// THE ONE-RUNG `[]` READING IS DELIBERATE AND IT WAS MEASURED — AND THE REASON HAS CHANGED
// SINCE #1242 WROTE IT DOWN, so read this paragraph as two claims and keep only one.
// Widening THIS function to the leaf peel (`arrLeafNameOf`) still moves cells backward, and
// the mechanism is the SUBSTITUTION rather than the emitter's reps: `monoSubstAnn`'s
// `monoTyParamOf` branch answers with `b + "[]"`, ONE `[]` rebuilt from a boolean, so a
// `T[][]` pattern claimed here pins an instance a dimension short of what the checker
// typed. #1242's own measurement of that merge — an 11 x 5 shadowed-name x constructor
// grid, 14 cells `clean reject -> invalid wasm`, nothing forward — stands.
//
// What has changed is the SECOND claim, that the `[]` run must therefore live outside the
// shared walk. It does not: the run is an arm at the BOTTOM of `monoAnnHasTyParam` /
// `monoSubstAnn` / `monoBindFromAnn`, below every constructor arm, re-attaching the run as
// the slice it already is rather than rebuilding it — and `function fnv<T>(v: T[][])`
// instantiates CORRECTLY through it (52 cells invalid wasm -> correct, 12 of them the
// non-shadowing control). `monoTyParamOf` reads one rung because the branch it feeds writes
// one rung, not because the depth is unreachable.
// A PARAMETER NAMED FOR A PRIMITIVE BINDS NOTHING, and this is where the FuncDecl half says
// so — `gaeParamShadowed`, the same predicate its generic-ALIAS sibling `gaeApplyFieldTy` has
// carried since #1234, sitting eight hundred lines up in this very file. The checker resolves
// a bare type name `primTyOfName -> tpEnvTyOfName -> declaredTyOfName`: a primitive beats a
// parameter, so in `function id<i64>(v: i64)` the annotation `i64` IS the builtin and the
// parameter binds nothing. Without the guard this walk claimed `i64` as a type parameter,
// `monoBindFromAnn` bound it to whatever the CALL passed, and the instance's parameter was
// rewritten to the argument's type while the checker (and the RETURN, which the checker
// pins) kept `i64` — a disassembly reading `(param i32) (result i64)`, `vl check` rc=0 and
// invalid wasm.
//
// THE AXIS IS THE ARGUMENT'S TYPE, NOT THE REP, and the earlier filing said the opposite.
// Swept as a 6 x 6 parameter-NAME x ARGUMENT-TYPE grid against a `<T>`-named control, exactly
// two cells move: `<i64>` and `<f64>` handed an `i32`-typed argument. Every other cell is
// either the diagonal (the argument's type equals the shadowed name, so the erasure is a
// no-op) or a checker reject. A single literal per row makes that diagonal look like the
// whole answer.
export function monoTyParamOf(ann: string, typarams: string[]) {
  let i = 0
  while i < typarams.length {
    if typarams[i] == ann && !gaeParamShadowed(typarams[i]) {
      return typarams[i]
    }
    i = i + 1
  }
  // The array-name grammar at its two homes. The TEST is kept in front of the CUT rather
  // than reading the cut's `""`: this loop compares `base` against each type-param name, so
  // "not an array" and "the element of `[]`" are the one pair of answers `arrElemNameRaw`
  // does NOT keep apart, and collapsing them here would be a behaviour claim about whether
  // `"[]"` is a producible annotation.
  if nameIsArray(ann) {
    const base = arrElemNameRaw(ann)
    let j = 0
    while j < typarams.length {
      if typarams[j] == base && !gaeParamShadowed(typarams[j]) {
        return typarams[j]
      }
      j = j + 1
    }
  }
  ""
}
// The first-use-wins binding of type-param `tp` in the per-call binding lists,
// or "" if unbound.
export function monoBindOf(tvN: string[], tvV: string[], tp: string) {
  let i = 0
  while i < tvN.length {
    if tvN[i] == tp { return tvV[i] }
    i = i + 1
  }
  ""
}
// Does the annotation NAME reach a declared type param — bare (`T`), array-of at any
// dimension (`T[]`, `T[][]`), a UNION member (`T | null`), a generic-alias application
// argument (`Box<T>`), an inline object shape's field type (`{first:B,second:A}`), a
// function type's parameter or result, or any of those under a grouping paren or behind
// a `[]` run (`(T | null)[]`, `{a: T}[]`)?
//
// THE ARM LIST IS `monoSubstAnn`'S, IN THE SAME ORDER, AND THAT IS A CONTRACT rather
// than a coincidence: every caller asks this first and substitutes second, so an arm here
// that the substitution lacks reports a parameter it then fails to replace, and an arm
// there that this lacks leaves the substitution unreached. The two were already out of
// step on the UNION and on `[]` depth, which is exactly where the generic-alias field
// residues sat.
//
// **THE `[]`-RUN ARM WAS CLAIMED BY THIS HEADER FOR TWO SLICES BEFORE ANY ARM DELIVERED
// IT.** The sentence above ("array-of at any dimension … or behind a `[]` run") described
// a walk that stopped at `monoTyParamOf`'s ONE `[]` level: a composite under a `[]` was
// claimed by nothing — `splitUnionAtoms` will not split inside the grouping parens of
// `(T|null)[]`, `annObjFieldSplit` answers -1 on a name ending in `]`, and
// `peelGroupParens` returns a `…[]` name unchanged. Read the arms, not the sentence.
export function monoAnnHasTyParam(ann: string, typarams: string[]) {
  if monoTyParamOf(ann, typarams) != "" { return true }
  // A top-level UNION (`T | null`, `T | i32`). `splitUnionAtoms` is depth- and
  // quote-aware and stops at a top-level `=>`, so a function type whose RESULT is a
  // union stays one atom and falls through to the function arm below.
  const uatoms: string[] = []
  splitUnionAtoms(ann, uatoms)
  if uatoms.length > 1 {
    let u = 0
    while u < uatoms.length {
      if monoAnnHasTyParam(uatoms[u], typarams) { return true }
      u = u + 1
    }
    return false
  }
  const parts: string[] = []
  if annGenAppDecompose(ann, parts) != "" {
    let i = 0
    while i < parts.length {
      if monoAnnHasTyParam(parts[i], typarams) { return true }
      i = i + 1
    }
    return false
  }
  const onames: string[] = []
  const otexts: string[] = []
  const okind = annObjFieldSplit(ann, onames, otexts)
  if okind == 0 { return false }
  if okind > 0 {
    let j = 0
    while j < onames.length {
      if onames[j] != "" {
        if monoAnnHasTyParam(otexts[j], typarams) { return true }
      }
      j = j + 1
    }
  }
  // A FUNCTION-TYPE annotation `(p1, p2) => ret` (a closure param / return): a type
  // param may ride any parameter or the result, so recurse into each (parallel to
  // `monoSubstAnn`'s function-type branch). Without this, a generic closure param
  // `f: (A, T) => A` reads as concrete and keeps its un-substituted annotation.
  const fparts: string[] = []
  const fret = annFnDecompose(ann, fparts)
  if fret != "" {
    let fi = 0
    while fi < fparts.length {
      if monoAnnHasTyParam(fparts[fi], typarams) { return true }
      fi = fi + 1
    }
    if monoAnnHasTyParam(fret, typarams) { return true }
  }
  // A GROUPING paren around the whole (`(T | null)` — the form a composite element wears
  // under a `[]`). Below the function arm, so a top-level function type is claimed there
  // first; `peelGroupParens` answers a non-parenthesized name with itself.
  const pk = peelGroupParens(ann)
  if pk != ann { return monoAnnHasTyParam(pk, typarams) }
  // The `[]` RUN over a composite element (`(T | null)[]`, `{a: T}[]`, `T[][]`,
  // `Box<T>[]`). LAST, and peeling the WHOLE run in one step: every arm above claims a
  // name by its OUTERMOST constructor, and a `[]` run's outermost constructor is the run.
  //
  // IT IS NOT PUSHED DOWN INTO `monoTyParamOf`, and that distinction is the whole of why
  // #1242 measured its version of this widening moving 14 cells BACKWARD. `monoSubstAnn`'s
  // `monoTyParamOf` branch answers with `b + "[]"` — ONE `[]`, from a boolean "was there a
  // `[]`" — so a `T[][]` pattern teaching THAT arm substitutes to a one-dimensional name
  // and the instance's parameter silently loses a dimension. The run arm re-attaches the
  // run as the SLICE it already is (`monoSubstAnn`'s twin arm below, and `gaeApplyFieldTy`
  // before it), so the dimensions are carried rather than recomputed.
  const leaf = arrLeafNameOf(ann)
  if leaf != ann { return monoAnnHasTyParam(leaf, typarams) }
  false
}
// The annotation name to READ for a generic FUNCTION's parameter or return: the arena's
// (canon'd) spelling, except where the annotation IS a type parameter — there, the
// DECLARED one. The FuncDecl twin of `emit_collect.gaeDeclFieldTyName`, and it exists for
// the identical reason at the identical gate.
//
// `canonEmitTypeNames` is a name rewrite with no scope, so in `type Id = i32` +
// `function ident<Id>(v: Id): Id` it resolved the parameter annotation to `i32` while the
// CHECKER resolved it as the parameter (`resolveAnnotAt` asks the type-param environment
// before the declared registry). `monoTyParamOf` was then handed `i32` against a parameter
// list holding `Id`, matched nothing, and the instance pinned `i32` while the call passed a
// string — 49 of 66 cells on an 11 x 6 shadowed-name x ARGUMENT-TYPE grid, `vl check` rc=0
// and invalid wasm, with a CORRECT control in every one.
//
// The GATE is `monoAnnHasTyParam` on the RAW spelling, which is the substitution's own
// decision (and carries the primitive-shadow guard through `monoTyParamOf`), so a
// non-parametric annotation in the same signature — `function f<T>(v: T, w: Nm)` — keeps
// the canon'd `string` it has always had.
//
// #1242 SHIPPED THIS SENTENCE WITH `monoTyParamOf` UNDER IT, and the two do not say the
// same thing: `monoTyParamOf` matches a BARE parameter and one `[]` level, so a parameter
// behind ANY other constructor — `Id | null`, `{a: Id}`, `Inner<Id>`, `Id[][]`,
// `(Id | null)[]` — was reported as "not parametric", the canon'd spelling was taken, and
// the instance pinned the shadowed alias's BODY while the checker had bound the ARGUMENT.
// That is the identical narrow-gate defect #1238 closed on the generic-ALIAS half, where
// the gate that shipped read the array grammar and nothing else. The two halves are now
// the same predicate: `emit_collect.gaeDeclFieldTyName` asks `gaeAnnHasParam`, which IS
// `monoAnnHasTyParam` over the live parameters.
//
// THE WIDENING IS NOT FREE AND THE COST IS NAMED. It moves 21 cells from invalid wasm to a
// loud reject and ONE cell backward — `function fnv<Id>(v: {a: Id}): Id` with
// `type Id = string` at a string argument, which built and ran. That accept was never a
// promise the language makes: its NON-SHADOWING control `function fnv<T>(v: {a: T}): T` is
// `emitProgram: monomorphize: unsupported argument type for `v`` on master, so the cell
// only ever compiled because the canon pass erased `Id` to the very type the call happened
// to pass. An inline-shape parameter annotation on a generic FuncDecl is unsupported; the
// shadowed spelling was reaching the supported path by accident, and it now rejects the
// way its control always did. Measured as a 192-cell CONSTRUCTOR x DECLARATION x ARGUMENT x
// RETURN grid, every shadow cell against its own `<T>` control.
export function monoDeclAnnName(
  nodeIx: i32,
  canoned: string,
  typarams: string[],
) {
  const raw = declAnnRawTyName(nodeIx)
  if raw == "" { return canoned }
  if !monoAnnHasTyParam(raw, typarams) { return canoned }
  raw
}
// Substitute the per-call type-param bindings through an annotation NAME —
// bare `T` / `T[]`, application arguments (`Box<T>` → `Box<i32>`), and inline
// object-shape field types (`{first:B,second:A}` → `{first:string,second:i32}`).
// Returns "" when an UNBOUND type param remains (the instance cannot be named);
// a fully concrete annotation returns unchanged.
export function monoSubstAnn(
  ann: string,
  typarams: string[],
  tvN: string[],
  tvV: string[],
) {
  const tp = monoTyParamOf(ann, typarams)
  if tp != "" {
    const b = monoBindOf(tvN, tvV, tp)
    if b == "" { return "" }
    if ann == tp { return b }
    return b + "[]"
  }
  // A top-level UNION (`T | null`): substitute each member and rejoin. Paired with
  // `monoAnnHasTyParam`'s union arm — see the contract note there.
  const uatoms: string[] = []
  splitUnionAtoms(ann, uatoms)
  if uatoms.length > 1 {
    let outU = ""
    let u = 0
    while u < uatoms.length {
      const us = monoSubstAnn(uatoms[u], typarams, tvN, tvV)
      if us == "" { return "" }
      if u > 0 { outU = outU + "|" }
      outU = outU + us
      u = u + 1
    }
    return outU
  }
  const parts: string[] = []
  const gHead = annGenAppDecompose(ann, parts)
  if gHead != "" {
    let outAnn = gHead + "<"
    let i = 0
    while i < parts.length {
      const s = monoSubstAnn(parts[i], typarams, tvN, tvV)
      if s == "" { return "" }
      if i > 0 { outAnn = outAnn + "," }
      outAnn = outAnn + s
      i = i + 1
    }
    return outAnn + ">"
  }
  const onames: string[] = []
  const otexts: string[] = []
  const okind = annObjFieldSplit(ann, onames, otexts)
  if okind == 0 { return ann }
  if okind > 0 {
    let outObj = "{"
    let j = 0
    while j < onames.length {
      if onames[j] == "" { return ann }
      const fs = monoSubstAnn(otexts[j], typarams, tvN, tvV)
      if fs == "" { return "" }
      if j > 0 { outObj = outObj + "," }
      outObj = outObj + onames[j] + ":" + fs
      j = j + 1
    }
    return outObj + "}"
  }
  // A FUNCTION-TYPE annotation `(p1, p2) => ret` (a closure param / return) riding type
  // params: substitute each parameter and the return through the binding, so a generic
  // closure param `f: (A, T) => A` pins to `(string, string) => string` for the instance.
  // Without it the instance body's `f(…)` call resolves no interned `$fnsig` (the param
  // kept the un-substituted `(A, T) => A`) and the value call mis-lowers.
  const fparts: string[] = []
  const fret = annFnDecompose(ann, fparts)
  if fret != "" {
    let outFn = "("
    let fi = 0
    while fi < fparts.length {
      const fs2 = monoSubstAnn(fparts[fi], typarams, tvN, tvV)
      if fs2 == "" { return "" }
      if fi > 0 { outFn = outFn + "," }
      outFn = outFn + fs2
      fi = fi + 1
    }
    const rs2 = monoSubstAnn(fret, typarams, tvN, tvV)
    if rs2 == "" { return "" }
    return outFn + ")=>" + rs2
  }
  // A GROUPING paren around the whole (`(T | null)` — the form a composite element wears
  // under a `[]`), the arm `monoAnnHasTyParam` closes with. It re-renders only when the
  // recursion actually moved: an untouched inner name returns `ann` VERBATIM, so a
  // concrete annotation is never reassembled (a rebuilt spelling is a second intern key,
  // which is the whole hazard this layer exists in).
  const pk = peelGroupParens(ann)
  if pk != ann {
    const ps = monoSubstAnn(pk, typarams, tvN, tvV)
    if ps == "" { return "" }
    if ps == pk { return ann }
    return "(" + ps + ")"
  }
  // The `[]` RUN, `monoAnnHasTyParam`'s closing arm in the same position. `arrLeafNameOf`
  // strips whole `[]` pairs off the END, so the leaf is a PREFIX of `ann` and the
  // remainder is precisely the repetitions to re-attach — the dimensions ride as the slice
  // they already are, never rebuilt from a count. (Identical to `gaeApplyFieldTy`, which
  // has carried this arm OUTSIDE the walk since #1234; the alias half can now stop
  // peeling first, but the peel there is harmless and its header explains the seam.)
  //
  // An UNBOUND leaf returns "" up the chain, which is `monoSubstAnn`'s documented "the
  // instance cannot be named" — and that is what turns `function fnv<T>(v: T[][])`'s
  // written-then-invalid module into the monomorphizer's own loud reject when nothing
  // binds `T`. Re-rendering is gated on the leaf actually MOVING, so a concrete `[]` run
  // is returned verbatim and never becomes a second intern key.
  const leaf = arrLeafNameOf(ann)
  if leaf != ann {
    const ls = monoSubstAnn(leaf, typarams, tvN, tvV)
    if ls == "" { return "" }
    if ls == leaf { return ann }
    return ls + ann.slice(leaf.length, ann.length)
  }
  ann
}
// Bind type params by matching a parameter's annotation PATTERN against the
// argument's concrete type name: `T` against anything, `T[]` against `X[]`,
// `Box<T>` against `Box<i32>` (same head, pairwise arguments). First use wins.
export function monoBindFromAnn(
  pat: string,
  actual: string,
  typarams: string[],
  tvN: string[],
  tvV: string[],
) {
  const tp = monoTyParamOf(pat, typarams)
  if tp != "" {
    let bind = actual
    if pat != tp {
      // A `T[]` pattern binds `T` to the ARGUMENT's element — the array-name grammar at
      // its two homes. The TEST is kept in front of the CUT for `monoTyParamOf`'s reason:
      // `bind` is pushed as a binding, so an empty element is not the same answer as "not
      // an array" and this merge asserts nothing about `"[]"`.
      if !nameIsArray(actual) { return 0 }
      bind = arrElemNameRaw(actual)
    }
    if monoBindOf(tvN, tvV, tp) == "" {
      tvN.push(tp)
      tvV.push(bind)
    }
    return 0
  }
  // A top-level UNION pattern (`T | null` against `string | null`): bind member-wise.
  // The three walks are the SAME arm list in the SAME order and that is the contract
  // `monoAnnHasTyParam`'s header states — this one was missing the union, the object and
  // the paren, so `monoAnnHasTyParam` reported a parameter, `monoSubstAnn` was ready to
  // replace it, and nothing had put a binding in the table for either to use.
  //
  // THE MEMBER COUNTS MUST MATCH BEFORE ANY PAIR IS BELIEVED. Positional pairing is what
  // the generic-application and function-type arms below already do; on a union it is the
  // arm's whole risk, so a differing arity binds NOTHING rather than pairing `T` with
  // whichever member happens to sit at its index.
  const puatoms: string[] = []
  splitUnionAtoms(pat, puatoms)
  if puatoms.length > 1 {
    const auatoms: string[] = []
    splitUnionAtoms(actual, auatoms)
    if puatoms.length == auatoms.length {
      let ui = 0
      while ui < puatoms.length {
        monoBindFromAnn(puatoms[ui], auatoms[ui], typarams, tvN, tvV)
        ui = ui + 1
      }
    }
    return 0
  }
  const pparts: string[] = []
  const pHead = annGenAppDecompose(pat, pparts)
  if pHead != "" {
    const aparts: string[] = []
    if pHead == annGenAppDecompose(actual, aparts) {
      let i = 0
      while i < pparts.length {
        if i < aparts.length {
          monoBindFromAnn(pparts[i], aparts[i], typarams, tvN, tvV)
        }
        i = i + 1
      }
    }
  }
  // An INLINE OBJECT SHAPE pattern (`{a: T}` against `{a:i32}`): bind field-wise, pairing
  // by the field NAME rather than the index, because the pattern is the DECLARED spelling
  // and the actual is the arena's canon'd one — two renderings of one shape that agree on
  // names but need not agree on anything else. A field the two do not share binds nothing.
  const pon: string[] = []
  const pot: string[] = []
  if annObjFieldSplit(pat, pon, pot) > 0 {
    const aon: string[] = []
    const aot: string[] = []
    if annObjFieldSplit(actual, aon, aot) > 0 {
      let oi = 0
      while oi < pon.length {
        if pon[oi] != "" {
          let oj = 0
          while oj < aon.length {
            if aon[oj] == pon[oi] {
              monoBindFromAnn(pot[oi], aot[oj], typarams, tvN, tvV)
            }
            oj = oj + 1
          }
        }
        oi = oi + 1
      }
    }
    return 0
  }
  // A FUNCTION-TYPE pattern `(P1, P2) => R` against the argument's function type
  // `(i32, i32) => i32`: bind type params pairwise across the parameters and the
  // return (parallel to `monoSubstAnn` / `monoAnnHasTyParam`). Binds `reduce`'s
  // `f: (A, T) => A` from the lambda argument's concrete `(i32, i32) => i32`.
  const pp: string[] = []
  const pRet = annFnDecompose(pat, pp)
  if pRet != "" {
    const ap: string[] = []
    const aRet = annFnDecompose(actual, ap)
    if aRet != "" {
      let fi = 0
      while fi < pp.length {
        if fi < ap.length {
          monoBindFromAnn(pp[fi], ap[fi], typarams, tvN, tvV)
        }
        fi = fi + 1
      }
      monoBindFromAnn(pRet, aRet, typarams, tvN, tvV)
    }
  }
  // A GROUPING paren around the whole (`(T | null)` — the form a composite element wears
  // under a `[]`), below the function arm exactly as in the two sibling walks. The ACTUAL
  // is peeled too and independently: the pattern is the DECLARED spelling and the actual
  // the canon'd one, and the two need not agree about whether the group is parenthesized.
  const ppk = peelGroupParens(pat)
  if ppk != pat {
    monoBindFromAnn(ppk, peelGroupParens(actual), typarams, tvN, tvV)
    return 0
  }
  // The `[]` RUN, the arm its two siblings close with, in the same position. `T[]` never
  // reaches here — `monoTyParamOf` claims one `[]` level at the top and binds the
  // ARGUMENT's element — so this is the run of TWO OR MORE (`T[][]`) and the run over a
  // composite (`Box<T>[]`).
  //
  // THE RUN LENGTHS MUST MATCH BEFORE EITHER LEAF IS BELIEVED. `arrLeafNameOf` peels to
  // fixpoint on both sides independently, so `T[][]` against `i32[]` would otherwise pair
  // `T` with `i32` and pin an instance one dimension short of what the CHECKER typed —
  // the same class of silent mis-pin this whole layer exists to stop. The lengths are
  // compared as SLICE widths (leaf is a prefix of the whole on both sides), which is the
  // `[]`-pair count without counting.
  const leafP = arrLeafNameOf(pat)
  if leafP != pat {
    const leafA = arrLeafNameOf(actual)
    if pat.length - leafP.length == actual.length - leafA.length {
      monoBindFromAnn(leafP, leafA, typarams, tvN, tvV)
    }
  }
  0
}
// Is `op` an operator that may dispatch to a `self`-method / operator field?
// Assignment, equality (structural compare), the logicals and `??` keep their
// native forms.
export function drwDispatchOp(op: string) {
  if op == "=" { return false }
  if op == "==" || op == "!=" { return false }
  if op == "&&" || op == "||" || op == "??" { return false }
  true
}
