}
// True if `name` is a bare CANONICAL STRUCT shape (`{f:…,…}`, not a map) with at least one FIELD
// whose type is a top-level UNION — `{f:boolean|{w:i32}}`, `{f:i64|string}`. Such a struct has a
// BOXED field slot (a `(ref $uBox)`), which a body ObjLit built from bare-scalar/struct literals
// does NOT naturally produce (the literal self-infers the plain field shape). Used by
// `synthRetAnnots` to pin an anonymous lambda's `fnRet` to the checker-adopted union-field struct
// (recorded by `structFieldBoxRetName`) so its `$fnsig` result + body boxing match the annotated
// named-function form. Requires the CANONICAL (space-free, `=>`-arrow) emit spelling — the only
// interned `sNames` key — and skips a CLOSURE field (top-level `=>`, whose `|` binds to the
// closure RESULT, not the field: `(i32) => f32 | {w:i32}` is a closure returning a union, NOT a
// union field). A top-level arrow / a map (`{[`) is not a struct here.
export function nameIsStructWithUnionField(name: string) {
  // CANONICAL only, and not a map / closure — `canonBareShapeName`, the gate this
  // function and its two siblings each spelled out.
  if !canonBareShapeName(name) { return false }
  const fnames: string[] = []
  const ftexts: string[] = []
  // The GROUP-INTERIOR cut at its home (`tyname.groupInnerOf`, W1) — the gate above is the
  // guard, and `canonBareShapeName` opens with `nameIsShapeSpanEnds`, so the home's bound is
  // already discharged here.
  shapeInnerFieldSplit(groupInnerOf(name), fnames, ftexts)
  let fi = 0
  while fi < fnames.length {
    if fnames[fi] != "" {
      const ftype = ftexts[fi]
      // A CLOSURE field (top-level `=>`) binds any `|` to its RESULT — skip it. Only a field
      // type that is itself a top-level UNION (`|` at depth 0) is a boxed field slot. The
      // depth-0 bar scan is the checker's home, the same walk `nullablePartOf` asks.
      if annArrowAt(ftype) < 0 {
        if tyTopIndexOf(ftype, '|', 0, 0) >= 0 { return true }
