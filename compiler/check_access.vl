// The type of reading a member, an optional member or an element, including a literal
// union's `length` and index.

import { fnDeclIx } from "./check_write_scan"
import { callBindNote } from "./check_bind_rows"
import { elabCallDeclNote } from "./check_elab_cap"
import {
  Ident,
  Index,
  Member,
  OP_INDEX_GET,
  OP_INDEX_SET,
  OptMember,
  getDeclLabel,
  i32ToStr,
  nodeAt,
  opDeclLabel,
} from "./ast"
import {
  flatMemberFold,
  lmChain,
  lmValTy,
  luAllSpell,
  luChain,
  luDecl,
  luElemTy,
  luTs,
} from "./check_annot_resolve"
import { assignableExpr } from "./check_assignable"
import { strLitRecvTy } from "./check_builtin_methods"
import { opIdxParamTy, opIdxRetTy, opSiteBank } from "./check_call_resolve"
import { opIdxDeclared } from "./check_callee"
import { mkDerivedHole } from "./check_coal"
