// The list decisions both emitters read: how a `.push`, a `.pop`, an element store, a reserve, a
// list literal and a `for … in` walk lower, as plans and arms. Legacy's writers and the IR's
// lowering consume the same answer, so the two cannot disagree.
// It writes no bytes and imports nothing from `wasmEmit.vl` or `ir_*.vl`.

import { narrowedArmNeedsUnbox } from "./emit_plan_coerce"
import {
  ArrayLit,
  Block,
  BreakStmt,
  Call,
  ContinueStmt,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  Index,
  LetDecl,
  Member,
  NullLit,
  NumLit,
  ObjLit,
  P,
  RetStmt,
  Unary,
