// The record-width rewrite's state and step (D3992): a call passing a wider record to a declared
// record parameter notes that parameter, and each step makes the noted parameters generic or
// declines them, restoring a parameter an instance refused. The checker decides candidates and
// writes the per-pass rows; `check_pins.vl`'s width phase drives `wsStep`. Every answer is a
// rewrite of the node arena or a read of the scope chain; nothing here reports a diagnostic.
import { declTyOf } from "./check_nar_store"
import {
  Call,
  FuncDecl,
  Ident,
  Node,
  Param,
  TS_NAME,
  TypeRef,
  arenaSetNode,
  i32ToStr,
  mkTypeRef,
  nodeAt,
  setAnnTs,
  tsLeaf,
} from "./ast"
import { identDepthOf } from "./check_scopes"
import { T, TyFunc, tyAt, tyIsPrimIx } from "./check_types"
import { fnDeclIx } from "./check_write_scan"
import { i32ListHas } from "./listutil"

// D3992 — a record of a wider shape passed to a function's parameter of a declared record type
// is legal (no field changes type, so the shared value keeps every invariant), and is lowered by
// making that parameter generic: the function is re-checked as `f<__W0>(p: __W0)` and each
// instance takes its argument's own layout. Every call is still held to the declared type.
export let wsDecl: i32[] = []
let wsParam: i32[] = []
export let wsOrigAnn: i32[] = []
// Declarations declined a rewrite, whose calls keep the width refusal.
export let wsNoDecl: i32[] = []
export let wsPendDecl: i32[] = []
export let wsPendParam: i32[] = []
// Per pass: declarations whose body refused something, and top-level functions read as values,
// neither of which is rewritten.
export let wsBodyErr: {[i32]: boolean} = Map()
export let wsValueRead: {[string]: boolean} = Map()
// Set while an argument a rewrite serves is delivered, so the width refusal stays quiet.
export let wsSuppress = false
// The argument being delivered to its parameter, parens peeled, or -1: a literal there that sets
// a field a record parameter does not declare is passed wider, its extra initializer evaluated.
// A union parameter has no wider arm to pass, so the literal is refused there (D4070).
export let argLitAt = -1
// Rewritten declarations an instance refused something in this pass: the declared parameter
// accepted it, so the refusal is the rewrite's, and the rewrite is undone.
let wsInstErr: i32[] = []
// Whether this check declined or undid a rewrite over a refusal, one of which may be outside the
// rewritten declaration's module.
export let wsRefusalUndid = false

export function wsReset() {
  wsRefusalUndid = false
  wsDecl = []
  wsParam = []
  wsOrigAnn = []
  wsNoDecl = []
  wsPassReset()
}

export function wsPassReset() {
  argLitAt = -1
  wsPendDecl = []
  wsPendParam = []
  wsBodyErr = Map()
  wsValueRead = Map()
  wsSuppress = false
  wsInstErr = []
  0
}

// Note an instance refusal at a call of declaration `d`, when a rewrite made it generic.
export function wsNoteInstErr(d: i32) {
  if d < 0 || i32ListHas(wsInstErr, d) { return 0 }
  let k = 0
  while k < wsDecl.length {
    if wsDecl[k] == d {
      wsInstErr.push(d)
      return 0
    }
    k = k + 1
  }
  0
}

// Declines every rewrite still pending, whose refusal nothing will now lift, and restores the
// parameters an instance error asked for. True when a re-check is owed to report them (D3992).
export function wsDecline(): boolean {
  if wsPendDecl.length == 0 && wsInstErr.length == 0 { return false }
  wsRefusalUndid = true
  for d in wsPendDecl {
    if !i32ListHas(wsNoDecl, d) { wsNoDecl.push(d) }
  }
  wsUndoInstErr()
  true
}

// Restore the declared parameters of every declaration noted in `wsInstErr` and decline it.
// Answers how many it restored.
function wsUndoInstErr(): i32 {
  if wsInstErr.length > 0 { wsRefusalUndid = true }
  let done = 0
  for d in wsInstErr {
    const fd = nodeAt(d)
    let k = 0
    while k < wsDecl.length {
      if wsDecl[k] == d && fd is FuncDecl && wsParam[k] < fd.fnParams.length {
        const pi = fd.fnParams[wsParam[k]]
        const pn = nodeAt(pi)
        if pn is Param {
          const nn: Node = {
            parName: pn.parName,
            parType: wsOrigAnn[k],
            parDefault: pn.parDefault,
            parOpt: pn.parOpt,
            parRest: pn.parRest,
            pos: pn.pos,
          }
          arenaSetNode(pi, nn)
        }
        const nm = "__W" + i32ToStr(wsParam[k])
        const tps: string[] = []
        const cur = nodeAt(d)
        if cur is FuncDecl {
          for t in cur.fnTyParams {
            if t != nm { tps.push(t) }
          }
          const nn: Node = {
            fnName: cur.fnName,
            fnTyParams: tps,
            fnParams: cur.fnParams,
            fnRet: cur.fnRet,
            fnBody: cur.fnBody,
            pos: cur.pos,
          }
          arenaSetNode(d, nn)
        }
        wsDecl[k] = -1
        done = done + 1
      }
      k = k + 1
    }
    if !i32ListHas(wsNoDecl, d) { wsNoDecl.push(d) }
  }
  wsInstErr = []
  if done > 0 {
    const kd: i32[] = []
    const kp: i32[] = []
    const ka: i32[] = []
    let r = 0
    while r < wsDecl.length {
      if wsDecl[r] >= 0 {
        kd.push(wsDecl[r])
        kp.push(wsParam[r])
        ka.push(wsOrigAnn[r])
      }
      r = r + 1
    }
    wsDecl = kd
    wsParam = kp
    wsOrigAnn = ka
  }
  done
}

// One rewrite step: apply the pending rewrites, or, when there are none, undo the ones an
// instance refused. A refusal in a pass with rewrites pending may be one they serve.
export function wsStep(): i32 {
  const applied = wsApplyPending()
  if applied > 0 {
    wsInstErr = []
    return applied
  }
  wsUndoInstErr()
}

// The rewrite row of parameter `i` of declaration `d`, or -1.
export function wsRowOf(d: i32, i: i32): i32 {
  let k = 0
  while k < wsDecl.length {
    if wsDecl[k] == d && wsParam[k] == i { return k }
    k = k + 1
  }
  -1
}

// Whether `s` is a bare identifier, the spelling of a declared type's name.
export function wsIsIdent(s: string): boolean {
  if s.length == 0 { return false }
  for c in s {
    const ok = (c >= 'a' && c <= 'z')
      || (c >= 'A' && c <= 'Z')
      || (c >= '0' && c <= '9')
      || c == '_'
    if !ok { return false }
  }
  true
}

// Whether the annotation node `ix` spells the type name `nm`, or has no spelling to read.
export function wsAnnMentions(ix: i32, nm: string): boolean {
  if ix < 0 { return false }
  const a = nodeAt(ix)
  if !(a is TypeRef) { return true }
  const s = a.tyName
  let i = 0
  while i + nm.length <= s.length {
    if s.slice(i, i + nm.length) == nm {
      const before = i == 0 || !wsIsIdent(s.slice(i - 1, i))
      const after = i + nm.length == s.length
        || !wsIsIdent(s.slice(i + nm.length, i + nm.length + 1))
      if before && after { return true }
    }
    i = i + 1
  }
  false
}

// Make each pending parameter generic, unless its function's body refused something or it is read
// as a value, which declines it. Answers how many it changed, which the caller re-checks for.
function wsApplyPending(): i32 {
  let done = 0
  let k = 0
  while k < wsPendDecl.length {
    const d = wsPendDecl[k]
    const i = wsPendParam[k]
    const fd = nodeAt(d)
    if fd is FuncDecl {
      if (
        !(wsBodyErr[d] ?? false)
        && !(wsValueRead[fd.fnName] ?? false)
        && wsRowOf(d, i) < 0
        && i < fd.fnParams.length
      ) {
        const pi = fd.fnParams[i]
        const pn = nodeAt(pi)
        if pn is Param {
          const nm = "__W" + i32ToStr(i)
          const tps: string[] = []
          for t in fd.fnTyParams { tps.push(t) }
          tps.push(nm)
          wsDecl.push(d)
          wsParam.push(i)
          wsOrigAnn.push(pn.parType)
          const wt = mkTypeRef(nm, pn.pos)
          setAnnTs(wt, tsLeaf(TS_NAME, nm))
          const np: Node = {
            parName: pn.parName,
            parType: wt,
            parDefault: pn.parDefault,
            parOpt: pn.parOpt,
            parRest: pn.parRest,
            pos: pn.pos,
          }
          arenaSetNode(pi, np)
          const nf: Node = {
            fnName: fd.fnName,
            fnTyParams: tps,
            fnParams: fd.fnParams,
            fnRet: fd.fnRet,
            fnBody: fd.fnBody,
            pos: fd.pos,
          }
          arenaSetNode(d, nf)
          done = done + 1
        }
      } else if wsRowOf(d, i) < 0 && !i32ListHas(wsNoDecl, d) {
        // Declined: the pass that quieted this call's refusal is re-run, and it speaks.
        wsNoDecl.push(d)
        done = done + 1
      }
    }
    k = k + 1
  }
  wsPendDecl = []
  wsPendParam = []
  done
}

// The top-level declaration a call's callee names, or -1.
export function wsCalleeDecl(n: Call): i32 {
  if n.callFn < 0 { return -1 }
  const c = nodeAt(n.callFn)
  if c is Ident {
    if identDepthOf(n.callFn, c.identName) != 0 { return -1 }
    return fnDeclIx[c.identName] ?? -1
  }
  -1
}

// Whether the un-annotated return of top-level function `name` is inferred as a primitive. Any
// other return may carry the parameter's record out, which the rewrite would retype.
export function wsInferredRetPrim(name: string): boolean {
  if name == "" { return false }
  const h = declTyOf(fnDeclIx[name] ?? -1)
  if h < 0 || h >= T.tys.length { return false }
  const ht = tyAt(h)
  if ht is TyFunc { return tyIsPrimIx(ht.fnRet) }
  false
}

// Record parameter `i` of the declaration call `n` names for a rewrite.
export function wsNotePending(n: Call, i: i32) {
  const d = wsCalleeDecl(n)
  let k = 0
  while k < wsPendDecl.length {
    if wsPendDecl[k] == d && wsPendParam[k] == i { return 0 }
    k = k + 1
  }
  wsPendDecl.push(d)
  wsPendParam.push(i)
  0
}
