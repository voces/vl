// `emit_union_tykey_text.vl` — the union registry's canonical type key as text: a member
// multiset, literal-preserving and order-free, and the row it finds. Below the registry, so a
// typed lookup there can ask it.

import { i32ToStr } from "./ast"
import { canonUnionMemberTysOf } from "./check_program"
import {
  T,
  TyArray,
  TyNullable,
  TyUnion,
  cUserTypesVer,
  tyAt,
  tyMutEpoch,
  tyToStructStr,
} from "./check_types"
import { strLess } from "./emit_base"
import { unTyKeyFirstRow } from "./emit_state"
import { flattenVariantsInto } from "./tyquery"

// The depth every whole-type walk starts from: a revisited type is a cycle, so an acyclic
// type is compared or keyed whole and this cap is only a backstop (D2751).
export const TY_WALK_DEPTH = 20000

// Key texts to ids. Pure text identities, so the table lives across programs.
const utkIds: {[string]: i32} = Map()
export const utkTexts: string[] = []

// The id of key text `s`, interning it when new.
export function utkIdOf(s: string): i32 {
  const hit = utkIds[s] ?? -1
  if hit >= 0 { return hit }
  const id = utkTexts.length
  utkTexts.push(s)
  utkIds[s] = id
  id
}

// One member's key text: `null` for -1; a union or a list keyed by its members' texts, sorted;
// any other type its structural render, which keeps literals and spells a record as its shape.
// A union or list already on the walk's path keys as `^k`, k steps up it. A cyclic member is
// re-keyed over its structural classes, so the text is the same whichever id the cycle closes on.
export function utkMemberText(ty: i32): string {
  const path: i32[] = []
  const cyc = [0]
  const t = utkTyText(ty, path, cyc)
  if cyc[0] == 0 { return t }
  utkCycText(ty)
}

function utkTyText(ty: i32, path: i32[], cyc: i32[]): string {
  if ty < 0 { return "null" }
  if ty >= T.tys.length || path.length >= TY_WALK_DEPTH {
    return tyToStructStr(ty)
  }
  const p = unMemPeelAliasWrapper(ty)
  let k = path.length - 1
  while k >= 0 {
    if path[k] == p {
      cyc[0] = 1
      return "^" + i32ToStr(path.length - 1 - k)
    }
    k = k - 1
  }
  const xs: i32[] = []
  flattenVariantsInto(p, xs)
  if xs.length > 1 {
    path.push(p)
    const texts: string[] = []
    for x in xs { texts.push(utkTyText(x, path, cyc)) }
    path.pop()
    return "(" + utkTextOf(texts) + ")"
  }
  const t = tyAt(ty)
  if t is TyArray {
    path.push(p)
    const e = utkTyText(t.aElem, path, cyc)
    path.pop()
    return "[" + e + "]"
  }
  tyToStructStr(ty)
}

// A walk node's kind, its children appended to `out`: 1 a union of two or more members, 2 a
// list, 0 a leaf, which keys as its text.
function utkNodeKids(ty: i32, out: i32[]): i32 {
  if ty < 0 || ty >= T.tys.length { return 0 }
  const xs: i32[] = []
  flattenVariantsInto(unMemPeelAliasWrapper(ty), xs)
  if xs.length > 1 {
    for x in xs { out.push(x) }
    return 1
  }
  const t = tyAt(ty)
  if t is TyArray {
    out.push(t.aElem)
    return 2
  }
  0
}

function utkLeafText(ty: i32): string {
  if ty < 0 { return "null" }
  tyToStructStr(ty)
}

// The text of cyclic member `root` with the walk's nodes merged by bisimulation: two nodes are
// one when their unfoldings are the same tree, so a back-reference names a class, not an id.
function utkCycText(root: i32): string {
  const nodeOf: {[i32]: i32} = Map()
  const kinds: i32[] = []
  const kidStart: i32[] = []
  const kidCount: i32[] = []
  const kidNode: i32[] = []
  const kidLeaf: string[] = []
  const work = [root]
  nodeOf[unMemPeelAliasWrapper(root)] = 0
  let w = 0
  while w < work.length {
    const ks: i32[] = []
    kinds.push(utkNodeKids(work[w], ks))
    kidStart.push(kidNode.length)
    kidCount.push(ks.length)
    for x in ks {
      const sub: i32[] = []
      if utkNodeKids(x, sub) == 0 {
        kidNode.push(-1)
        kidLeaf.push(utkLeafText(x))
      } else {
        const p = unMemPeelAliasWrapper(x)
        let n = nodeOf[p] ?? -1
        if n < 0 {
          n = work.length
          nodeOf[p] = n
          work.push(x)
        }
        kidNode.push(n)
        kidLeaf.push("")
      }
    }
    w = w + 1
  }
  const cls: i32[] = []
  for k in kinds { cls.push(k) }
  let count = 0
  while true {
    const ids: {[string]: i32} = Map()
    const next: i32[] = []
    let i = 0
    while i < kinds.length {
      const descs: string[] = []
      let j = kidStart[i]
      while j < kidStart[i] + kidCount[i] {
        if kidNode[j] < 0 {
          descs.push("l" + kidLeaf[j])
        } else {
          descs.push("c" + i32ToStr(cls[kidNode[j]]))
        }
        j = j + 1
      }
      const sig = i32ToStr(cls[i]) + "|" + utkTextOf(descs)
      let c = ids[sig] ?? -1
      if c < 0 {
        c = next.length
        ids[sig] = c
      }
      next.push(c)
      i = i + 1
    }
    let n = 0
    for c in next {
      if c + 1 > n { n = c + 1 }
    }
    let m = 0
    while m < next.length {
      cls[m] = next[m]
      m = m + 1
    }
    if n == count { break }
    count = n
  }
  const path: i32[] = []
  utkCycNodeText(0, path, kinds, kidStart, kidCount, kidNode, kidLeaf, cls)
}

function utkCycNodeText(
  i: i32,
  path: i32[],
  kinds: i32[],
  kidStart: i32[],
  kidCount: i32[],
  kidNode: i32[],
  kidLeaf: string[],
  cls: i32[],
): string {
  let k = path.length - 1
  while k >= 0 {
    if path[k] == cls[i] { return "^" + i32ToStr(path.length - 1 - k) }
    k = k - 1
  }
  path.push(cls[i])
  const texts: string[] = []
  let j = kidStart[i]
  while j < kidStart[i] + kidCount[i] {
    if kidNode[j] < 0 {
      texts.push(kidLeaf[j])
    } else {
      texts.push(
        utkCycNodeText(
          kidNode[j],
          path,
          kinds,
          kidStart,
          kidCount,
          kidNode,
          kidLeaf,
          cls,
        ),
      )
    }
    j = j + 1
  }
  path.pop()
  if kinds[i] == 2 { return "[" + texts[0] + "]" }
  "(" + utkTextOf(texts) + ")"
}

// The key text of a member multiset: the member texts sorted, never deduped.
export function utkTextOf(texts: string[]): string {
  const ks: string[] = []
  for t in texts {
    let at = 0
    while at < ks.length && !strLess(t, ks[at]) { at = at + 1 }
    ks.push(t)
    let m = ks.length - 1
    while m > at {
      ks[m] = ks[m - 1]
      m = m - 1
    }
    ks[at] = t
  }
  let out = ""
  let j = 0
  while j < ks.length {
    if j > 0 { out = out + " ; " }
    out = out + ks[j]
    j = j + 1
  }
  out
}

// The key text of type `ty`'s canonical members, or "" when it has none. Memoised per arena index
// and stamped with `tyMutEpoch` and `cUserTypesVer`, so a type many lookups share is keyed once: a record's text is
// its render, which doubles with each level of a diamond.
export function utkTyKeyText(ty: i32): string {
  if ty < 0 || ty >= T.tys.length { return "" }
  // Only a union or a nullable has a row; any other type keys nothing, as the softened key did.
  const tt = tyAt(ty)
  if !(tt is TyUnion) && !(tt is TyNullable) { return "" }
  while utkMemoId.length <= ty {
    utkMemoId.push(-1)
    utkMemoStamp.push(-1)
    utkMemoVer.push(-1)
  }
  if utkMemoStamp[ty] == tyMutEpoch && utkMemoVer[ty] == cUserTypesVer {
    const hit = utkMemoId[ty]
    return if hit >= 0 { utkTexts[hit] } else { "" }
  }
  const t = utkTyKeyTextGo(ty)
  utkMemoStamp[ty] = tyMutEpoch
  utkMemoVer[ty] = cUserTypesVer
  utkMemoId[ty] = if t == "" { -1 } else { utkIdOf(t) }
  t
}

// `utkTyKeyText`'s memo: the key text's id per arena index, -1 for none, and its two stamps.
const utkMemoId: i32[] = []
const utkMemoStamp: i32[] = []
const utkMemoVer: i32[] = []

function utkTyKeyTextGo(ty: i32): string {
  const mems: i32[] = []
  if !canonUnionMemberTysOf(ty, mems) { return "" }
  const texts: string[] = []
  for m in mems { texts.push(utkMemberText(m)) }
  utkTextOf(texts)
}

// The first row whose type key is the key of type `ty`'s canonical members, or -1.
export function unRowOfTyKey(ty: i32): i32 {
  const t = utkTyKeyText(ty)
  if t == "" { return -1 }
  const id = utkIds[t] ?? -1
  if id < 0 || id >= unTyKeyFirstRow.length { return -1 }
  unTyKeyFirstRow[id]
}

// `m` with the one-member union wrapper an arrow-bodied alias carries peeled, else `m`.
export function unMemPeelAliasWrapper(m: i32): i32 {
  if m < 0 { return m }
  const t = tyAt(m)
  if t is TyUnion {
    if t.uMembers.length == 1 { return t.uMembers[0] }
  }
  m
}
