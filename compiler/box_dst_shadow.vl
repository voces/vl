// The box-destination shadow: at each union-box delivery a site still lowers at its own union,
// compare that union against the checker's per-instance box record (`boxDstTyAt`). Off unless a
// host arms it; armed, it counts each delivery by class, so the record can replace the sites'
// own unions only where they agree (architecture-target-2026-10.md, step 5's record line). A
// position the table serves counts its deliveries as `table` or a named floor, never graded.
import { atomSrcTyAt, boxDstTyAt, numPairAt } from "./emit_capture_frames"
import { narrowedArmTyAt } from "./emit_local_scope"
import { sHeapIdx, uBoxIdx, variantHeap } from "./emit_state"
import { structIndexOfTy } from "./emit_atom_kinds"
import { variantRowOfShapeTy } from "./emit_ty_canon"
import { tyLitMemberTexts, tyToEmitName } from "./check_types"
import {
  canonUnionKeyOfName,
  canonUnionKeyOfTy,
  canonUnionKeyTextOfName,
} from "./check_nj_join"
import { canonUnionKeyTextOfTy } from "./check_inline_lit_union"
import { splitUnionAtoms } from "./tyname"
import { nodeSrc } from "./symbols"
import { i32ToStr } from "./ast"
import { unwrapParen } from "./emit_base"
import { elabInstTyAt } from "./emit_elab"
import { tyNulLitUnionMemberTexts, tyPeelNul } from "./tyquery"
import { tyHasTyVar } from "./tyquery"

let bdsArmed = false
let bdsNamed = false
let bdsDrop = 0
let bdsDepth = 0
let bdsRowKey: string[] = []
let bdsRowN: i32[] = []
let bdsAs = ""

// Arm (1) or disarm (0) the shadow for the compiles that follow; 2 also names the site and both
// unions in each row.
export function boxDstShadowArm(on: i32) {
  bdsArmed = on != 0
  bdsNamed = on == 2
  0
}

// The shadow's own control: 0 reads the record, 1 reads none (every delivery has no record), 2
// reads a type no site names (every record disagrees).
export function boxDstDropSet(v: i32) {
  bdsDrop = v
  0
}

// Start a compile's shadow.
export function boxDstShadowBegin() {
  bdsRowKey = []
  bdsRowN = []
  bdsDepth = 0
  0
}

function bdsCount(key: string) {
  let i = 0
  while i < bdsRowKey.length {
    if bdsRowKey[i] == key {
      bdsRowN[i] = bdsRowN[i] + 1
      return 0
    }
    i = i + 1
  }
  bdsRowKey.push(key)
  bdsRowN.push(1)
  0
}

// The box record for delivery node `ix` in `fnIx`, read through a paren and the node a rewrite or
// mono copy made it from; -1 for none.
function bdsRecord(ix: i32, fnIx: i32): i32 {
  if bdsDrop == 1 { return -1 }
  let r = boxDstTyAt(ix, fnIx)
  if r < 0 { r = boxDstTyAt(unwrapParen(ix), fnIx) }
  if r < 0 { r = boxDstTyAt(nodeSrc[ix] ?? -1, fnIx) }
  if r < 0 { return -1 }
  if bdsDrop == 2 { return 0 }
  // A record a generic body banked names its type parameters; the instance closes them.
  if tyHasTyVar(r) {
    const it = elabInstTyAt(r, fnIx)
    if it >= 0 { return it }
  }
  r
}

// The class of the delivery of `ix` into the union the site names `unionName` (type `unionTy`
// where it has one); `form` is 1 when the value is already a box, 2 when it never returns.
function bdsClass(
  unionName: string,
  unionTy: i32,
  ix: i32,
  fnIx: i32,
  form: i32,
) {
  if form == 1 { return "value already a box" }
  if form == 2 { return "value never returns" }
  const r = bdsRecord(ix, fnIx)
  if r < 0 { return "no record" }
  if unionTy >= 0 && unionTy == r { return "agree" }
  const rn = tyToEmitName(r)
  if rn == unionName { return "agree" }
  // Two spellings of one union: an alias against its members, `null` in another position, or the
  // members in another order, since a box's tag is its member's alone (`boxTagOfTy`).
  const ks = canonUnionKeyOfName(unionName)
  if ks >= 0 && (canonUnionKeyOfTy(r) == ks || canonUnionKeyOfName(rn) == ks) {
    return "agree up to spelling"
  }
  if rn == "" { return "record renders empty" }
  if (
    bdsSameAtoms(canonUnionKeyTextOfName(unionName), canonUnionKeyTextOfTy(r))
  ) {
    return "agree up to spelling"
  }
  "disagree"
}

// Whether key texts `a` and `b` hold the same members, in any order.
function bdsSameAtoms(a: string, b: string): boolean {
  if a == "" || b == "" { return false }
  const xs: string[] = []
  const ys: string[] = []
  splitUnionAtoms(a, xs)
  splitUnionAtoms(b, ys)
  if xs.length != ys.length { return false }
  for x in xs {
    let hit = false
    for y in ys {
      if y == x { hit = true }
    }
    if !hit { return false }
  }
  true
}

// Note a site's union-box delivery of `ix` into `unionName`, `site` naming the entry point and
// `form` the value's (`bdsClass`). A delivery inside another's lowering counts as `nested`.
export function boxDstShadowNote(
  site: string,
  unionName: string,
  unionTy: i32,
  ix: i32,
  fnIx: i32,
  form: i32,
) {
  if !bdsArmed { return 0 }
  let key = bdsAs
  bdsAs = ""
  if key == "" { key = bdsClass(unionName, unionTy, ix, fnIx, form) }
  // A delivery a site boxes inside its own lowering is counted apart, so a class over sites
  // stays comparable, and a nested delivery with no record is still seen.
  if bdsDepth > 0 { key = "nested " + key }
  if bdsNamed {
    const r = bdsRecord(ix, fnIx)
    let col = "-"
    if r >= 0 { col = tyToEmitName(r) }
    key = key + " | " + site + " | site " + unionName + " | record " + col
  }
  bdsCount(key)
  0
}

// The class the next noted delivery counts as instead of being graded: `table` where the table
// boxes it at its record, `floor: <why>` where a position the table serves boxes at its own union.
// A switched position is graded by the sweep, so only its floors are named.
export function boxDstShadowAs(c: string) {
  if bdsArmed { bdsAs = c }
  0
}

// Bracket a site's own lowering, so the deliveries inside it count as nested.
export function boxDstShadowEnter() {
  if bdsArmed { bdsDepth = bdsDepth + 1 }
  0
}

export function boxDstShadowLeave() {
  if bdsArmed && bdsDepth > 0 { bdsDepth = bdsDepth - 1 }
  0
}

export function boxDstShadowRowCount() { bdsRowKey.length }

export function boxDstShadowRowLen(i: i32) { bdsRowKey[i].length }

export function boxDstShadowRowAt(i: i32, j: i32) { bdsRowKey[i][j] }

export function boxDstShadowRowN(i: i32) { bdsRowN[i] }

export function boxDstShadowArmed(): boolean { bdsArmed }

// A record read at `fnIx`, its type parameters closed by the instance.
function bdsInst(r: i32, fnIx: i32): i32 {
  if r < 0 || !tyHasTyVar(r) { return r }
  const it = elabInstTyAt(r, fnIx)
  if it >= 0 { it } else { r }
}

// Note an atom-to-string decode of `ix` against member texts `texts` the site derived, `nul` when
// the site maps `-1` to null: graded against the literal set the checker recorded at the delivery.
export function atomSrcShadowNote(
  texts: string[],
  nul: boolean,
  ix: i32,
  fnIx: i32,
) {
  if !bdsArmed { return 0 }
  let r = atomSrcTyAt(ix, fnIx)
  if r < 0 { r = atomSrcTyAt(unwrapParen(ix), fnIx) }
  if r < 0 { r = atomSrcTyAt(nodeSrc[ix] ?? -1, fnIx) }
  r = bdsInst(r, fnIx)
  if bdsDrop == 1 { r = -1 }
  let cls = "no record"
  let rt: string[] = []
  if r >= 0 {
    const rn = tyNulLitUnionMemberTexts(r)
    rt = if rn.length > 0 { rn } else { tyLitMemberTexts(r) }
    if bdsDrop == 2 { rt = ["<drop>"] }
    if rt.length == 0 {
      cls = "record holds no member"
    } else if bdsSameTexts(texts, rt) {
      cls = if (rn.length > 0) == nul { "agree" } else { "agree up to null" }
    } else if texts.length == 0 {
      cls = "site has no member"
    } else if bdsSubTexts(rt, texts) {
      cls = "record narrower"
    } else {
      cls = "disagree"
    }
  }
  let key = "atom " + cls
  if bdsAs != "" {
    key = "atom " + bdsAs
    if bdsAs == "table" && cls != "agree" { key = key + " (" + cls + ")" }
    bdsAs = ""
  }
  if bdsNamed {
    key = key
      + " | site "
      + bdsJoin(texts, nul)
      + " | record "
      + bdsJoin(rt, r >= 0 && tyNulLitUnionMemberTexts(r).length > 0)
  }
  bdsCount(key)
  0
}

// Note a narrowed-arm unbox of `ix` to heap `heap` the site derived: graded against the heap of the
// arm the checker recorded for the narrowed read.
export function armSrcShadowNote(heap: i32, ix: i32, fnIx: i32) {
  if !bdsArmed { return 0 }
  const a = bdsInst(narrowedArmTyAt(ix, fnIx), fnIx)
  let rh = -1
  if a >= 0 && bdsDrop != 1 { rh = armHeapOfTy(a) }
  let cls = "disagree"
  if heap < 0 { cls = "site has no heap" }
  else if heap == uBoxIdx { cls = "site takes the box" }
  else if a < 0 || bdsDrop == 1 { cls = "no record" }
  else if rh < 0 { cls = "record has no heap" }
  else if bdsDrop != 2 && rh == heap { cls = "agree" }
  let key = "arm " + cls
  if bdsAs != "" {
    key = "arm " + bdsAs
    bdsAs = ""
  }
  if bdsNamed {
    const an = if a >= 0 { tyToEmitName(a) } else { "-" }
    key = key
      + " | site "
      + i32ToStr(heap)
      + " | record "
      + i32ToStr(rh)
      + " "
      + an
  }
  bdsCount(key)
  0
}

// Note a numeric delivery of `ix` the site lowers from kind `src` to kind `dst` (`numKindOfTy`'s
// codes; -1 where the site builds the value at `dst`): graded against the checker's numeric pair.
export function numPairShadowNote(src: i32, dst: i32, ix: i32, fnIx: i32) {
  if !bdsArmed { return 0 }
  let r = numPairAt(ix, fnIx)
  if r < 0 { r = numPairAt(unwrapParen(ix), fnIx) }
  if r < 0 { r = numPairAt(nodeSrc[ix] ?? -1, fnIx) }
  if bdsDrop == 1 { r = -1 }
  if bdsDrop == 2 && r >= 0 { r = 0 }
  const rs = if r >= 0 && r / 8 == 2 { 1 } else if r >= 0 { r / 8 } else { -1 }
  const rd = if r >= 0 { r % 8 } else { -1 }
  let cls = "src differs"
  if src < 0 { cls = "site builds" }
  else if r < 0 { cls = "no record" }
  else if rd != dst { cls = "dst differs" }
  else if rs == src { cls = "agree" }
  let key = "num " + cls
  if bdsAs != "" {
    key = "num " + bdsAs
    bdsAs = ""
  }
  if bdsNamed {
    key = key
      + " | site "
      + i32ToStr(src)
      + ">"
      + i32ToStr(dst)
      + " | record "
      + i32ToStr(rs)
      + ">"
      + i32ToStr(rd)
  }
  bdsCount(key)
  0
}

// The heap a narrowed arm of type `a` is cast to: its variant row's, else its record's; -1 for none.
export function armHeapOfTy(a: i32): i32 {
  const x = tyPeelNul(a)
  const vi = variantRowOfShapeTy(x)
  if vi >= 0 { return variantHeap(vi) }
  const si = structIndexOfTy(x)
  if si >= 0 && si < sHeapIdx.length { return sHeapIdx[si] }
  -1
}

// Whether every text of `a` is one of `b`'s.
function bdsSubTexts(a: string[], b: string[]): boolean {
  for x in a {
    let hit = false
    for y in b {
      if y == x { hit = true }
    }
    if !hit { return false }
  }
  true
}

// Whether `a` and `b` hold the same texts, in any order.
function bdsSameTexts(a: string[], b: string[]): boolean {
  if a.length != b.length { return false }
  for x in a {
    let hit = false
    for y in b {
      if y == x { hit = true }
    }
    if !hit { return false }
  }
  true
}

function bdsJoin(xs: string[], nul: boolean): string {
  let o = ""
  for x in xs { o = if o == "" { x } else { o + "|" + x } }
  if nul { o = o + "|null" }
  o
}
