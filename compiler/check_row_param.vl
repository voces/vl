// A declared record parameter takes the row of each call's argument (L3, option A): before the
// first check pass `function f(p: P)` becomes `function f<__R0>(p: __R0)`, and slot `__R0` is
// bound by `P`, read through that bound and printed as it. Mono then instances `f` per concrete
// row as it does any generic. The eager spelling is what L1's instantiation into IR replaces.
import {
  FuncDecl,
  Node,
  P,
  Param,
  TS_NAME,
  TypeDecl,
  TypeRef,
  arenaSetNode,
  i32ToStr,
  mkTypeRef,
  nodeAt,
  setAnnTs,
  tsLeaf,
} from "./ast"
import { T, TyObj, TyVar, cUserTypes, tvSlotBound, tvSlotSet, tyAt } from "./check_types"

// The type parameter the record-width rewrite gives parameter slot `k` of declaration `d`, whose
// annotation named `record`: the name carries the record, so its bound is re-derived from it.
export function rowParamName(d: i32, k: i32, record: string): string {
  "__R" + i32ToStr(d) + "_" + i32ToStr(k) + "__" + record
}

// The record a desugared type parameter named `nm` is bound by, `__R<decl>_<k>__<record>`, or ""
// for any other name; the name carries it, so a resumed check of a rewritten tree reads it too.
export function rowParamRecordOf(nm: string): string {
  if nm.length < 4 || nm.slice(0, 3) != "__R" { return "" }
  let i = 3
  while i < nm.length && ((nm[i] >= '0' && nm[i] <= '9') || nm[i] == '_') {
    if nm[i] == '_' && i + 1 < nm.length && nm[i + 1] == '_' { return nm.slice(i + 2, nm.length) }
    i = i + 1
  }
  ""
}

// Binds slot `(binder, idx)`, named `nm`, by its record when the desugar minted it, printed as it.
export function rowParamBind(binder: i32, idx: i32, nm: string) {
  const r = rowParamRecordOf(nm)
  if r == "" { return 0 }
  const b = cUserTypes[r] ?? -1
  if b >= 0 { tvSlotSet(binder, idx, b, true) }
  0
}

// The record bound of slot type `ty`, a desugared record parameter, or -1. Every reader of such a
// slot asks here: the body binds the parameter at it, and a call holds its argument to it.
export function rowSlotBound(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  const t = tyAt(ty)
  if !(t is TyVar) || t.tvKind != "param" { return -1 }
  const b = tvSlotBound(t.tvBinder, t.tvIdx)
  if b < 0 || b >= T.tys.length || !(tyAt(b) is TyObj) { return -1 }
  b
}

// `ty`, or its record bound when it is a desugared record parameter's slot: a reader that would
// treat the slot as an open hole reads the record it is held to instead.
export function rowViewTy(ty: i32): i32 {
  const b = rowSlotBound(ty)
  if b >= 0 { b } else { ty }
}
