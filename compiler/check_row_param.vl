// The row slot the record-width rewrite (`check_width.vl`, L3 option A) gives a declared record
// parameter `p: P` that a call hands a wider row: a type parameter bound by `P`, printed as `P`,
// whose name carries the record so its bound is re-derived on every pass. The rewrite spells the
// slot into the tree; that spelling is what L1's instantiation into IR replaces.
import { i32ToStr } from "./ast"
import {
  T,
  TyObj,
  TyVar,
  cUserTypes,
  tvSlotBound,
  tvSlotSet,
  tyAt,
} from "./check_types"

// The slot name for type-parameter position `k` of declaration `d` whose parameter named `record`.
export function rowParamName(d: i32, k: i32, record: string): string {
  "__R" + i32ToStr(d) + "_" + i32ToStr(k) + "__" + record
}

// The record a slot named `nm` (`__R<decl>_<k>__<record>`) is bound by, or "" for any other name.
export function rowParamRecordOf(nm: string): string {
  if nm.length < 4 || nm.slice(0, 3) != "__R" { return "" }
  let i = 3
  while i < nm.length && ((nm[i] >= '0' && nm[i] <= '9') || nm[i] == '_') {
    if nm[i] == '_' && i + 1 < nm.length && nm[i + 1] == '_' {
      return nm.slice(i + 2, nm.length)
    }
    i = i + 1
  }
  ""
}

// Binds slot `(binder, idx)`, named `nm`, by its record when it is a row slot, printed as it.
export function rowParamBind(binder: i32, idx: i32, nm: string) {
  const r = rowParamRecordOf(nm)
  if r == "" { return 0 }
  const b = cUserTypes[r] ?? -1
  if b >= 0 { tvSlotSet(binder, idx, b, true) }
  0
}

// The record bound of type `ty` when it is a row slot, or -1: what a call holds its argument to.
export function rowSlotBound(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  const t = tyAt(ty)
  if !(t is TyVar) || t.tvKind != "param" { return -1 }
  const b = tvSlotBound(t.tvBinder, t.tvIdx)
  if b < 0 || b >= T.tys.length || !(tyAt(b) is TyObj) { return -1 }
  b
}
