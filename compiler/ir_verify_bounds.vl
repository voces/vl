// `ir_verify_bounds.vl` — the IR verifier's rule 8 (ir-design-2026-11.md §2): in phase A every
// element read or write is guarded by the bounds check fused into it. An `RListGet` or `SListSet`
// must follow an `SBoundsCheck` over the same list and index in its body, and every such check must
// be followed by that access.

import { i32ToStr } from "./ast"
import {
  IrFn,
  OImm,
  OStr,
  OVar,
  Opnd,
  RListGet,
  SBoundsCheck,
  SLet,
  SListSet,
  irPushBodies,
} from "./ir"

function sameOpnd(a: Opnd, b: Opnd): boolean {
  return match a {
    OVar => b is OVar && a.ov == b.ov
    OImm => b is OImm && a.oiRep == b.oiRep && a.oiBits == b.oiBits
    OStr => b is OStr && a.osAt == b.osAt && a.osRep == b.osRep
  }
}

// The element read `RListGet` node `id` binds, or the element write `SListSet` it is, as its list
// and index; null for any other node.
function getAt(f: IrFn, id: i32): Opnd[] | null {
  if id < 0 || id >= f.irNodes.length { return null }
  const n = f.irNodes[id]
  if n is SListSet { return [n.lsV, n.lsIx] }
  if !(n is SLet) { return null }
  const r = n.lRhs
  if !(r is RListGet) { return null }
  return [r.lgV, r.lgIx]
}

function checkAt(f: IrFn, id: i32): SBoundsCheck | null {
  if id < 0 || id >= f.irNodes.length { return null }
  const n = f.irNodes[id]
  if n is SBoundsCheck { return n }
  return null
}

// The first broken pairing in `body` and the bodies under it, or "". One frame per open body
// rather than a recursion, so an `else if` chain's length costs no stack (D1990); a node's own
// pairing is checked before its bodies, which are walked in order.
function bodyRule(f: IrFn, body0: i32[]): string {
  const bodies: i32[][] = [body0]
  const pos: i32[] = [0]
  while bodies.length > 0 {
    const top = bodies.length - 1
    const body = bodies[top]
    const i = pos[top]
    if i >= body.length {
      bodies.pop()
      pos.pop()
      continue
    }
    pos[top] = i + 1
    const id = body[i]
    const g = getAt(f, id)
    if g != null {
      const c = if i > 0 { checkAt(f, body[i - 1]) } else { null }
      if c == null || !sameOpnd(c.bcV, g[0]) || !sameOpnd(c.bcIx, g[1]) {
        return "node "
          + i32ToStr(id)
          + ": an element read with no bounds check fused before it"
      }
    }
    const c2 = checkAt(f, id)
    if c2 != null {
      const g2 = if i + 1 < body.length { getAt(f, body[i + 1]) } else { null }
      if g2 == null || !sameOpnd(c2.bcV, g2[0]) || !sameOpnd(c2.bcIx, g2[1]) {
        return "node "
          + i32ToStr(id)
          + ": a bounds check with no element read after it"
      }
    }
    irPushBodies(f, id, bodies, pos)
  }
  return ""
}

// Rule 8 over `f`: "" when every element read is fused with its bounds check, else what broke.
export function irBoundsRule(f: IrFn): string { return bodyRule(f, f.irBody) }
