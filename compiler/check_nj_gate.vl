// The join gate's name scan: which functions a call reaches other than directly from a concrete
// context (`njFnReached`), read once per program over the arena, with the helper shape a pin of
// the caller re-joins (D3589). It also holds the valued-return walk (`a20RetWalk`) that scan and
// the checker's return joins share. `njGateReset` clears the scan per program; nothing here
// imports the checker.
import {
  Block,
  Call,
  FuncDecl,
  Ident,
  IfStmt,
  MatchExpr,
  Member,
  P,
  Param,
  RetStmt,
  elseIfLink,
  nodeChildren,
} from "./ast"
import { intMatchHeadAt, matchScrutAt } from "./check_match_heads"
import { tailValueLeaves } from "./check_unconsumed"
import { cwPeel, fnDeclIx } from "./check_write_scan"
import { strListHas } from "./listutil"

// Names a call can reach other than directly from a concrete context (`njGateScan`), once per program.
let njGateNames: {[string]: boolean} = Map()
let njGateScanned = false
// The arena prefix `njGateScan` has read.
let njGateSeen = 0

export function njGateReset() {
  njGateNames = Map()
  njGateScanned = false
  njGateSeen = 0
}

// Whether every join in function `fx` is master's: a generic or hole function read by value, or
// mentioned in a lambda body or in another generic or hole body (`njGateScan`). A top-level
// function with no type parameter and no hole has one signature wherever it is read, so never.
export function njFnReached(fx: i32): boolean {
  if fx < 0 || fx >= P.nodes.length { return false }
  const fn = P.nodes[fx]
  if !(fn is FuncDecl) { return false }
  if fn.fnName == "" { return true }
  if !njDeclOpen(fn) && (fnDeclIx.get(fn.fnName) ?? -1) == fx { return false }
  if !njGateScanned { njGateScan() }
  njGateNames.get(fn.fnName) ?? false
}

// Whether `fn` has a type parameter or a parameter with no declared type.
function njDeclOpen(fn: FuncDecl): boolean {
  if fn.fnTyParams.length > 0 { return true }
  for pi in fn.fnParams {
    const pn = P.nodes[pi]
    if pn is Param {
      if pn.parType < 0 { return true }
    }
  }
  false
}

// Records every name read other than as a call's callee or as a member, every name or member
// mentioned in a lambda body or in a gated generic or hole body, and every one such an ungated
// body mentions other than itself and a helper `njHelperShapeOk` admits: that helper's
// kept-apart return each pin of the caller re-joins (D3589). A self-call is one more pin.
function njGateScan() {
  njGateScanned = true
  // 1 at each node a scanned call names as its callee, grown past the arena if one does.
  const callee: i32[] = __array_new__(P.nodes.length, 0)
  const reads: i32[] = []
  const openNames: string[] = []
  const openBodies: i32[] = []
  let i = njGateSeen
  while i < P.nodes.length {
    const n = P.nodes[i]
    if n is Call {
      const cf = n.callFn
      if cf >= 0 {
        while callee.length <= cf { callee.push(0) }
        callee[cf] = 1
      }
    } else if n is Ident {
      reads.push(i)
    } else if n is FuncDecl {
      if n.fnName == "" {
        njGateBody(n.fnBody)
      } else if njDeclOpen(n) {
        openNames.push(n.fnName)
        openBodies.push(n.fnBody)
      }
    }
    i = i + 1
  }
  njGateSeen = P.nodes.length
  njGateHelpers(openNames, openBodies)
  for r in reads {
    if r >= callee.length || callee[r] == 0 {
      const rn = P.nodes[r]
      if rn is Ident { njGateNames[rn.identName] = true }
    }
  }
  // To a fixpoint: an open body gates every name it mentions once its own function is gated.
  const done: boolean[] = []
  for _ in openNames { done.push(false) }
  let grew = true
  while grew {
    grew = false
    let k = 0
    while k < openNames.length {
      if !done[k] && (njGateNames.get(openNames[k]) ?? false) {
        done[k] = true
        grew = true
        njGateBody(openBodies[k])
      }
      k = k + 1
    }
  }
  0
}

// Records each name the body `bodies[k]` of open function `names[k]` mentions other than a
// function in a cycle of open calls back to it, whose call each pin re-checks with the body, and
// a helper `njHelperShapeOk` admits.
function njGateHelpers(names: string[], bodies: i32[]) {
  const ixOf: {[string]: i32} = Map()
  let k = 0
  while k < names.length {
    if !(ixOf.has(names[k])) { ixOf[names[k]] = k }
    k = k + 1
  }
  // Each open body's mentions, and as `edges` the open functions among them.
  const ments: string[][] = []
  const edges: i32[][] = []
  for b in bodies {
    const ms = njBodyMentions(b)
    const es: i32[] = []
    for nm in ms {
      const t = ixOf.get(nm) ?? -1
      if t >= 0 { es.push(t) }
    }
    ments.push(ms)
    edges.push(es)
  }
  // `reach[t]`, once computed, flags each open function a call chain from `t` mentions.
  const reach: boolean[][] = []
  for _ in names { reach.push([]) }
  k = 0
  while k < names.length {
    for nm in ments[k] {
      if !njHelperShapeOk(nm) {
        const t = ixOf.get(nm) ?? -1
        let cyc = false
        if t >= 0 {
          if reach[t].length == 0 { reach[t] = njReachFrom(t, edges) }
          cyc = reach[t][k]
        }
        if !cyc { njGateNames[nm] = true }
      }
    }
    k = k + 1
  }
  0
}

// Every open function the open function `s` reaches through `edges`, itself included.
function njReachFrom(s: i32, edges: i32[][]): boolean[] {
  const seen: boolean[] = __array_new__(edges.length, false)
  seen[s] = true
  const todo: i32[] = [s]
  while todo.length > 0 {
    const at = todo.pop()
    if at >= 0 && at < edges.length {
      for t in edges[at] {
        if !seen[t] {
          seen[t] = true
          todo.push(t)
        }
      }
    }
  }
  seen
}

// Each name body `ix` mentions (`njMentionAt`), once.
function njBodyMentions(ix: i32): string[] {
  const out: string[] = []
  const had: {[string]: boolean} = Map()
  const todo: i32[] = [ix]
  while todo.length > 0 {
    const at = todo.pop()
    if at >= 0 && at < P.nodes.length {
      const nm = njMentionAt(at)
      if nm != "" && !(had.has(nm)) {
        had[nm] = true
        out.push(nm)
      }
      for c in nodeChildren(at) {
        if c >= 0 { todo.push(c) }
      }
    }
  }
  out
}

// Whether top-level function `name` yields only its own parameters, each through `return` or a
// tail `if`/`else` chain, with no `match` in its body: the shape whose return a call keeps as a
// union of the caller's parameters (`keptParamUnion`).
function njHelperShapeOk(name: string): boolean {
  const d = fnDeclIx[name] ?? -1
  if d < 0 || d >= P.nodes.length { return false }
  const fn = P.nodes[d]
  if !(fn is FuncDecl) { return false }
  if fn.fnBody < 0 || fn.fnBody >= P.nodes.length || njBodyHasMatch(fn.fnBody) {
    return false
  }
  const ps: string[] = []
  for pi in fn.fnParams {
    const pn = P.nodes[pi]
    if pn is Param { ps.push(pn.parName) }
  }
  const vals: i32[] = []
  collectValuedReturns(fn.fnBody, vals)
  const b = P.nodes[fn.fnBody]
  if !(b is Block) || b.blkStmts.length == 0 { return false }
  vals.push(b.blkStmts[b.blkStmts.length - 1])
  for v in vals {
    const leaves: i32[] = []
    tailValueLeaves(v, leaves)
    for l in leaves {
      const ln = P.nodes[l]
      if !(ln is Ident) || !strListHas(ps, ln.identName) { return false }
    }
  }
  true
}

// Whether body `ix` holds a `match`, before or after `desugarMatchAt` lowered it.
function njBodyHasMatch(ix: i32): boolean {
  const todo: i32[] = [ix]
  while todo.length > 0 {
    const at = todo.pop() ?? -1
    if at >= 0 && at < P.nodes.length {
      if P.nodes[at] is MatchExpr || njMatchDesugared(at) { return true }
      for k in nodeChildren(at) {
        if k >= 0 { todo.push(k) }
      }
    }
  }
  false
}

// Whether node `at` is an `if` link `desugarMatchAt` built.
export function njMatchDesugared(at: i32): boolean {
  if intMatchHeadAt(at) { return true }
  const n = P.nodes[at]
  if !(n is IfStmt) { return false }
  const c = cwPeel(n.ifCond)
  if c < 0 || c >= P.nodes.length { return false }
  if matchScrutAt(c) { return true }
  for k in nodeChildren(c) {
    if k >= 0 && matchScrutAt(cwPeel(k)) { return true }
  }
  false
}

// Records every name body `ix` mentions (`njMentionAt`).
function njGateBody(ix: i32) {
  const todo: i32[] = [ix]
  while todo.length > 0 {
    const at = todo.pop() ?? -1
    if at >= 0 && at < P.nodes.length {
      const nm = njMentionAt(at)
      if nm != "" { njGateNames[nm] = true }
      for k in nodeChildren(at) {
        if k >= 0 { todo.push(k) }
      }
    }
  }
  0
}

// The function name node `at` mentions: a member, which a call through it may reach, or a name
// (`njNameAt`).
function njMentionAt(at: i32): string {
  if at < 0 || at >= P.nodes.length { return "" }
  const n = P.nodes[at]
  if n is Member { return n.memProp }
  njNameAt(at)
}

// The name an `Ident` at `at` reads; "" at any other node.
function njNameAt(at: i32): string {
  const n = P.nodes[at]
  if n is Ident { return n.identName }
  ""
}

// Every valued `return` under `blockIx` in source order, at any depth but a nested function's.
export function collectValuedReturns(blockIx: i32, out: i32[]) {
  a20RetWalk(blockIx, false, out)
}

// Every valued `return` under `ix` in source order, a nested function's aside, and when `tail`
// holds the values `ix` yields as the body's tail: a block's last statement and each arm of a
// tail `if`, an `else if` chain along its spine. A loop body's last statement is not a tail (D2745).
export function a20RetWalk(ix: i32, tail: boolean, out: i32[]) {
  let cur = ix
  while cur >= 0 && cur < P.nodes.length {
    const at = cur
    const n = P.nodes[at]
    cur = -1
    if n is RetStmt {
      if n.retArg >= 0 {
        a20RetWalk(n.retArg, false, out)
        out.push(n.retArg)
      }
    } else if n is FuncDecl {
      return 0
    } else if n is Block {
      const stmts = n.blkStmts
      let i = 0
      while i < stmts.length {
        a20RetWalk(stmts[i], tail && i == stmts.length - 1, out)
        i = i + 1
      }
    } else if n is IfStmt {
      a20RetWalk(n.ifCond, false, out)
      a20RetWalk(n.ifThen, tail, out)
      if elseIfLink(at) >= 0 {
        cur = n.ifElse
      } else {
        a20RetWalk(n.ifElse, tail, out)
      }
    } else {
      const kids = nodeChildren(at)
      let ki = 0
      while ki < kids.length {
        a20RetWalk(kids[ki], false, out)
        ki = ki + 1
      }
      if tail { out.push(at) }
    }
  }
  0
}
