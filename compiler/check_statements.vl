// ── let declaration ────────────────────────────────────────────────────────

// A `let`'s resolved annotation: its type (-1 when it has none, `TY_ERR` once refused) and
// whether resolving it collapsed a subsumed literal arm (D1048's second hint).
type LetAnnot = {
  ty: i32,
  collapsedHere: boolean,
}

// The type annotation node `ann` already holds from an earlier check of the same body, at this
// pass's type-parameter bindings; -1 when it holds none, a type variable survives, or two bound
// parameters share a name, which substitution by name cannot tell apart (D16012).
function letAnnHeldTyAt(ann: i32): i32 {
  const held = if ann < nodeTyIx.length { nodeTyIx[ann] } else { -1 }
  if held < 0 || tpEnvNamesRepeat() { return -1 }
  const sub = if tpEnvNames.length > 0 { substTyDeep(held, tpEnvNames, tpEnvTys) } else { held }
  if sub < 0 || tyHasTyVar(sub) { return -1 }
  sub
}

// Whether two of the bound type parameters share a name.
function tpEnvNamesRepeat(): boolean {
  let i = 0
  while i < tpEnvNames.length {
    let j = i + 1
    while j < tpEnvNames.length {
      if tpEnvNames[i] == tpEnvNames[j] { return true }
      j = j + 1
    }
    i = i + 1
  }
  false
}

// Resolves the annotation of `n` by reading its TypeRef child inline, refusing an unknown type
// (or a map key with no hash) and recording the resolved type on the annotation node.
function letDeclResolveAnnot(n: LetDecl): LetAnnot {
  let annot = -1
  // Read immediately after resolution and compared against THIS annotation's own answer.
  let annotCollapsedHere = false
  if n.letType >= 0 {
    const tn = nodeAt(n.letType)
    if tn is TypeRef {
      // A binding the list-union rewrite minted is typed as the rewrite typed it, since a
      // written `T[] | i32[]` resolves to one list (D2876).
      const lua = mintedAnnTy(n.letType)
      if lua >= 0 {
        annot = lua
      } else {
        annot = letAnnHeldTyAt(n.letType)
        // Only a shadowed type-parameter name re-parses the spelling here (D16012).
        if annot < 0 { annot = nameToTyAt(tn.tyName, n.letType) }
      }
      if annot >= 0 && annot == collapsedTy { annotCollapsedHere = true }
      if tn.tyName.length > 0 && tn.tyName.slice(0, 1) == "{" {
        recAnnObjs.push(annot)
      }
      if annot < 0 {
        // A map shape whose key is neither `string` nor `i32` has no hash in the map rep —
        // report that directly (with the supported set) rather than a bare "unknown type".
        const mapKeyIx = tsMapKeyNodeOf(annTsOf(n.letType))
        let badKey = ""
        if mapKeyIx >= 0 { badKey = tsText[mapKeyIx] }
        if badKey != "" && !mapKeyTySupported(tsLeafTy(badKey)) {
          mapKeyUnsupportedErr(badKey, initMapCtorName(n.letInit), n.letType)
        } else {
          unknownTyErr(tn.tyName, "", n.letType)
        }
        annot = TY_ERR
      }
      // Record the resolved type on the `let`'s type-annotation node so the emitter can
      // classify it structurally from the `Ty` arena rather than re-parsing `tyNameOf` — C1.
      if !inferQuiet && annot >= 0 {
        if n.letType < nodeTyIx.length { nodeTySet(n.letType, annot) }
        voidStoreCheck(n.letType, annot)
      }
    }
  }
  const r: LetAnnot = { ty: annot, collapsedHere: annotCollapsedHere }
  r
}

// Grades the initializer of `n`, of type `initTy`, against its annotation `annot`: refuses one
// that does not fit, and otherwise records the pair (and a literal's slots) for the pin.
function letDeclGradeAnnotated(n: LetDecl, ix: i32, annot: i32, initTy: i32) {
  // An annotated empty-collection initializer pins the source binding's open holes from
  // the annotation (`const ys: i32[] = zs` resolves `zs`'s element) in place.
  constrainEmptyExpr(n.letInit, initTy, annot)
  // A `never`-typed annotation is already reported at its declaration — don't cascade a
  // second "cannot assign ... of type <empty>" at every use site.
  const neverAnnot = isNeverTy(annot)
  const savedPin = recAdPinInit
  recAdPinInit = recAdPinned[ix] ?? false
  const fits = neverAnnot || assignableExpr(n.letInit, initTy, annot)
  recAdPinInit = savedPin
  if !fits {
    // Three sentences, one home: `letAssignMsg` picks between the object-literal-into-a-map,
    // lossy-numeric and opaque forms; the pin calls the same function on the substituted pair.
    tErrWant(
      letAssignMsg(n.letInit, initTy, annot, n.letName, n.letType),
      n.letInit,
      annot,
    )
  } else if !neverAnnot {
    // The check above is vacuous whenever a side is a hole — record the pair for the pin to
    // re-ask under substitution, only on the PASSING side (a failing one already reported, D572).
    noteLetCstr(coalPinTy(n.letInit, initTy), annot, n.letInit, n.letName)
    // And the slots of a literal source too, but only when the pair above carried no hole —
    // that is exactly when the literal's own element join dropped one, so nothing is recorded.
    if !tyHasHole(initTy) {
      if !tyHasHole(annot) { noteLitElemCstrs(n.letInit, annot, 6) }
    }
  }
  0
}

// Marks the binding of `n` when its type came from a spelling
// that collapsed a subsumed literal arm: its own annotation (`annotCollapsedHere`), or a bare
// call initializer to a function whose return collapsed one, deliberately narrow.
function letDeclMarkCollapsed(n: LetDecl, annotCollapsedHere: boolean) {
  if annotCollapsedHere {
    markCollapsedBinding(n.letName)
  } else if n.letType < 0 && n.letInit >= 0 {
    const cInit = nodeAt(n.letInit)
    if cInit is Call && cInit.callFn >= 0 {
      const cFn = nodeAt(cInit.callFn)
      if cFn is Ident {
        const cDecl = fnDeclIx[cFn.identName] ?? identFnDeclOf(cInit.callFn)
        if fnRetCollapsed(cDecl) { markCollapsedBinding(n.letName) }
      }
    }
  }
  0
}

// Whether `ix` reads a `let` the program writes after its initialiser.
function identReadsWrittenLet(ix: i32): boolean {
  const d = identDeclOf(ix)
  if d < 0 || d >= P.nodes.length { return false }
  const dn = nodeAt(d)
  dn is LetDecl && dn.letKw == "let" && !cwLetUnwritten(d)
}

// `const f = addT` — records which declaration the binding of `n` at `ix` aliases, for
// deferred-constraint ownership alone. A bare Ident initializer naming a declared function, or
// a binding that aliases one, is the whole rung: a copy of an alias owns what it owns (D5160).
function letDeclNoteFnAlias(n: LetDecl, ix: i32) {
  if n.letInit >= 0 {
    const aInit = nodeAt(parenPeelIx(n.letInit))
    if aInit is Ident {
      // The declaration the name resolves to in scope, a nested function shadowing a top-level one.
      let aDecl = identFnDeclOf(parenPeelIx(n.letInit))
      if aDecl < 0 { aDecl = fnDeclIx[aInit.identName] ?? -1 }
      // A written `let` holds more than the function it starts as, so a copy of it aliases none.
      if aDecl < 0 {
        const via = identFnAliasOf(parenPeelIx(n.letInit))
        if via >= 0 && !identReadsWrittenLet(parenPeelIx(n.letInit)) {
          aDecl = via
        }
      }
      if aDecl >= 0 { declFnAliasSet(ix, aDecl) }
    }
  }
  0
}

// The literal-binding marks of a `let` the module hoist did not already record at depth 0
// (D1609): an un-annotated object or container literal, a numeric literal, the literal-binding
// index and a function literal, each at the innermost scope.
function letDeclMarkLitBindings(n: LetDecl, ix: i32, bound: i32) {
  if letDeclIsUnannotObjLit(ix) {
    markObjLitBinding(n.letName, T.frames.length - 1)
  }
  if letDeclIsUnannotCtnLit(ix) {
    markCtnLitBinding(n.letName, T.frames.length - 1, n.letInit)
  }
  if numLitBindCandidateTy(bound) {
    markNumLitBinding(n.letName, T.frames.length - 1, ix)
  }
  lbiMark(n.letName, T.frames.length - 1, ix, bound)
  markFnLitBinding(n.letName, T.frames.length - 1, ix)
  0
}

export function checkLetDeclNodeIn(n: LetDecl, ix: i32) {
  if curFnDeclIx >= 0 { letDeclFnPut(ix, curFnDeclIx) }
  // An un-annotated binding of a call is stored where the call's results are built.
  if n.letType < 0 { storeLetPush(n.letInit, ix) }
  if n.letInit >= 0 { wrDstDeclPut(n.letInit, ix) }
  const la = letDeclResolveAnnot(n)
  const annot = la.ty
  let initTy = -1
  // Bidirectional: an annotated `const f: (i32) => i32 = (x) => ...` infers each un-annotated
  // lambda param from the annotation before the initializer is checked.
  const seedMark = cbSeedUsed
  if n.letInit >= 0 && annot >= 0 { seedExpected(n.letInit, annot) }
  // An un-annotated binding to a bare lambda: mark it so its un-annotated params type as
  // inference holes rather than being rejected as uninferable.
  if annot < 0 && n.letInit >= 0 {
    const liN = nodeAt(n.letInit)
    if liN is FuncDecl {
      if liN.fnName == "" { noteValBindLambda(n.letInit) }
    }
  }
  const keptJoin = if annot < 0 { letKeptJoinAtPin(n.letInit) } else { -1 }
  if n.letInit >= 0 {
    if tpEnvNames.length > 0 { tpIfMarkOk(n.letInit) }
    initTy = checkNodeHook(n.letInit)
  }
  if keptJoin >= 0 && initTy >= 0 { initTy = keptJoin }
  initTy = letDeclInitVerdicts(n, ix, annot, initTy, seedMark)
  let bound = TY_ERR
  if annot >= 0 {
    bound = annot
    if initTy >= 0 { letDeclGradeAnnotated(n, ix, annot, initTy) }
  } else if initTy >= 0 {
    // A binding keeps what it is initialised with, so a list read only an empty list's value fit
    // narrowed is refused here as at any other delivery (D5003).
    narConvListDelivery(n.letInit, initTy, initTy)
    // A copy of a record narrowed by its fields reads it at its declared type (D4133).
    const fitDecl = narRecFitDeclTy(n.letInit)
    if fitDecl >= 0 {
      initTy = fitDecl
      nodeTySetGrow(parenPeelIx(n.letInit), fitDecl)
    }
    bound = elabFnLetTy(ix, letDeclInferredBound(n, ix, initTy))
    // A literal's own binding only: an alias reads its source's writes without their order. Inside
    // a generic the signature is the instance's, which one node cannot record.
    const litInit = nodeAt(parenPeelIx(n.letInit)) is ArrayLit
    let wm: i32[] = []
    if litInit && tpEnvNames.length == 0 {
      wm = elabFnListOpenWideMembers(ix, bound)
    }
    const closedAt = letFnListClosedSig(wm)
    const lw = elabFnListLetTy(ix, bound, closedAt)
    // Each generic member is delivered at the closed signature, as an annotated list's is.
    const lwa = if lw >= 0 && lw < T.tys.length { T.tys[lw] } else { T.tys[TY_ERR] }
    if lw != bound && closedAt >= 0 && lwa is TyArray {
      for m in wm { fvaValueRowAt(m, lwa.aElem) }
    }
    if lw != bound {
      bound = lw
      if nodeAt(parenPeelIx(n.letInit)) is ArrayLit {
        nodeTySetGrow(parenPeelIx(n.letInit), lw)
        if closedAt >= 0 { elabFnListClosedNote(parenPeelIx(n.letInit)) }
      }
    }
    // A map binding reads what its aliases and the maps it is re-pointed to hold too (D15535).
    if !litInit && tpEnvNames.length == 0 { bound = elabFnMapLetTy(ix, bound) }
    // A record literal's list field of functions holds what is written into its elements too,
    // as does one inside a list literal's elements (D15201).
    const initLit = nodeAt(parenPeelIx(n.letInit))
    const namedRec = initLit is ObjLit && recLitNamesFns(initLit)
    if (
      (initLit is ObjLit || initLit is ArrayLit)
      && (tpEnvNames.length == 0 || namedRec)
    ) {
      const none: string[] = []
      // A reassignment from a call writes what the call returns (D15562).
      cwFollowCalls = true
      bound = letLitListsWidenAt(ix, parenPeelIx(n.letInit), bound, none)
      cwFollowEnd()
    } else if initLit is Call && tpEnvNames.length == 0 {
      // A binding a call initialises holds the records the call returns, through the calls it
      // returns, so its function fields take what is written into them too (D15270, D15742).
      const rets: i32[] = []
      if letCallFieldsWidenable(bound) && holeSlotCallRetRecs(initLit, rets) {
        bound = letCallFieldsWiden(ix, bound, rets)
      }
    }
    // A returned record binding, or list of records, reads its function's joined sets (D15559).
    if initLit is ObjLit || initLit is ArrayLit {
      const rr = elabRetRecTy(ix, bound)
      if rr != bound {
        elabRetRecLitGrow(n.letInit, rr)
        bound = rr
      }
    }
    recordCtxTy(n.letInit, bound)
  } else if (
    !refuseOpenElemDecl(
      n.letInit,
      initTy,
      "'" + n.letName + "' takes its type from",
      "'" + n.letName + "'",
      ix,
    )
  ) {
    tErr("'" + n.letName + "' needs a type annotation or initializer", ix)
  }
  // Same-scope redeclaration (B16): a second `let`/`const` of a name already bound in the
  // innermost frame errors; shadowing an outer name in a nested block is legal.
  const dtop = T.frames.length - 1
  // A module global is pre-declared by the pass-1.5 hoist, so its own pass-2 declaration
  // would falsely trip the same-frame check — skip it there (top-level dups are caught in the hoist).
  const preHoisted = dtop == 0 && (moduleGlobals[n.letName] ?? false)
  if crWidenedInTop(n.letName) {
    crUnwidenTop(n.letName)
  } else if !preHoisted && declLayerSharedAt(ix, dtop) {
    tErr("redeclared " + n.letName, ix)
  }
  // The same reservation the `function` path enforces: a `const` of the emitter-intrinsic name
  // is called through the inline arm exactly like `function`, so the lambda never runs.
  checkNotEmitterIntrinsic(n.letName, ix)
  declareDecl(ix, n.letName, bound)
  // The initialiser is the first write, so a read before any other takes its member.
  if annot >= 0 && initTy >= 0 {
    const initMem = writeMemberTy(bound, initTy)
    if letUnionWriteNarrows(ix, bound, initMem) {
      noteNarShadow(ix, NAR_KIND_ASG)
      narLayerNote(ix, T.frames.length - 1, initMem)
    }
  }
  // A read before the first write takes the initialiser's `null`, not the hole a later write
  // fills in place (DECISIONS.md, "A read of a `let` takes its most recent write's type").
  if annot < 0 && isNullTy(initTy) && n.letKw == "let" {
    noteNarShadow(ix, NAR_KIND_ASG)
    narLayerNote(ix, T.frames.length - 1, initTy)
  }
  if recAdOrigDecl.length > 0 && (recAdPinned[ix] ?? false) {
    recAdBound.push(bound)
  }
  crNoteSoleRef(n, ix)
  getLetBank(ix, bound)
  if !preHoisted { letDeclMarkLitBindings(n, ix, bound) }
  fsbMark(n.letName, T.frames.length - 1, ix, bound)
  letDeclMarkCollapsed(n, la.collapsedHere)
  letDeclNoteFnAlias(n, ix)
  symDecl(n.letName, ix, bound, 0)
  // Definite-assignment: an uninitialized `let x` starts unassigned; a later read before a
  // write is an error. An initialized `let`/`const` is assigned from the start and never tracked.
  daMarkAssignedNode(ix)
  if (moduleBeforeDecl[n.letName] ?? -1) == ix {
    moduleBeforeDecl[n.letName] = -1
  }
  // An `extern let` is assigned by whoever provides the import, before any code here runs.
  if n.letInit < 0 && externGlobalLinkOfNode(ix) < 0 { daAddNode(ix) }
  if bound != TY_ERR { letDeclBound = bound }
  return TY_VOID
}

// Under an instance re-check, the type an un-annotated binding of `init` holds when the generic
// body kept `init` a type parameter's join (`T | i32`, D2906): that join at the instance's
// binding, which the re-check alone may narrow to one arm. -1 for any other binding.
function letKeptJoinAtPin(init: i32): i32 {
  if monoRecheckDepth <= 0 || init < 0 || tpEnvNames.length == 0 { return -1 }
  const gen = nodeTyIxOf(parenPeelIx(init))
  if !tyIsTpJoinUnion(gen) { return -1 }
  const st = substTyDeep(gen, tpEnvNames, tpEnvTys)
  if st < 0 || st >= T.tys.length || tyHasTyVar(st) { return -1 }
  st
}

// The type the `let` just checked binds, recorded on its node by `letDeclBoundRecord` once
// `checkNode` has stored the statement's own `void`; -1 when none is pending.
let letDeclBound = -1

// Records the pending bound type on the decl `ix`'s node (real pass only) and clears it, so a
// reader of the decl's node type sees the type the binding holds, retyped annotation included.
// A literal type is recorded widened, as every other node's is, and an instance's capture of
// the node gets the same type.
export function letDeclBoundRecord(ix: i32) {
  if letDeclBound < 0 { return 0 }
  const bt = widenLitTy(letDeclBound)
  if elabCapOn && ix >= 0 && elabCapLive() { elabCapNote(ix, bt) }
  if !inferQuiet && ix >= 0 && ix < nodeTyIx.length { nodeTySet(ix, bt) }
  letDeclBound = -1
  0
}

// The refusals `checkLetDeclNodeIn` asks of an initializer of type `initTy0`: a `void` or
// `never` value, one that may be `void`, and a redundant annotation `annot`. Answers the
// initializer's type, `TY_ERR` once refused.
function letDeclInitVerdicts(
  n: LetDecl,
  ix: i32,
  annot: i32,
  initTy0: i32,
  seedMark: i32,
): i32 {
  let initTy = initTy0
  // A `void` initializer has no value to bind — reject with a source-located message,
  // poisoning `initTy`. Exempted: an if-expression init, whose false path is implicit `null`.
  // A minted scrutinee binding (D1991) keeps the `void`, so the `match` reports it in its own words.
  if n.letInit >= 0 && isVoidTy(initTy) && !symNameIsMinted(n.letName) {
    if !voidSlotExemptExpr(n.letInit) {
      tErr(
        "cannot bind the void result of '"
          + n.letName
          + "' — a void function returns no value",
        ix,
      )
      initTy = TY_ERR
    }
  }
  // An initializer whose type includes `void` has no value to store: refused at the if or match arm
  // that yields none, else at the initializer (D4071).
  if (
    n.letInit >= 0
    && annot < 0
    && initTy >= 0
    && !isVoidTy(initTy)
    && tyMentionsVoid(initTy, 8)
    && !symNameIsMinted(n.letName)
  ) {
    const arm = ifNoValueArmAt(n.letInit)
    if arm != n.letInit {
      const kw = valueBranchKeyword(n.letInit)
      tErr(
        "this arm yields no value, but the `"
          + kw
          + "` is the value of `"
          + n.letName
          + "`: end the arm with a value, or make the `"
          + kw
          + "` a statement",
        arm,
      )
    } else {
      tErr(
        "`"
          + n.letName
          + "` would take the type "
          + tyToStr(initTy)
          + ", and a value that may be `void` cannot be stored: test it before binding "
          + "it, or bind it only where it holds a value",
        n.letInit,
      )
    }
    initTy = TY_ERR
  }
  // A `never` initializer leaves nothing to bind, and an un-annotated binding would take a type
  // no value has; a declared type gives the dead binding a real one (D1972).
  if n.letInit >= 0 && annot < 0 && initTy == TY_NEVER && initTy >= 0 {
    tErr(
      "`"
        + n.letName
        + "` would hold a `never` value, and none exists: its initializer never returns — call it as a statement, or declare the binding's type",
      ix,
    )
    initTy = TY_ERR
  }
  // Redundant explicit annotation: skipped when checking the initializer consumed a contextual
  // seed the annotation supplied (an un-annotated lambda param) — comparing then would be circular (D1442).
  if (
    annot >= 0
    && initTy >= 0
    && n.letInit >= 0
    && cbSeedUsed == seedMark
    && !lbiIsSynth(n.letType, ix)
  ) {
    if cexLitPeel(n.letInit) >= 0 && lbiNumTy(annot) {
      lbiDeferRedundant(ix, initTy)
    } else if !lbiReadsPinned(n.letInit) {
      recordRedundantAnnot(n, ix, initTy, annot)
    }
  }
  initTy
}

// The type an un-annotated `let` node `ix` binds from its initializer's type `initTy`, and
// the rows an if-expression, `?.`, `??` or optional-call initializer exports to the emitter.
function letDeclInferredBound(n: LetDecl, ix: i32, initTy: i32): i32 {
  let bound = constStrLitBound(n, initTy)
  // A-infer-null: an un-annotated `let x = null` binds a nullable with an open inner hole;
  // the first non-null assignment fills it in place (the `=` arm), so `x` becomes `T | null`.
  if isNullTy(initTy) {
    bound = mkNullableTy(-1)
    // ...and record the hole, so scope close can say whether anything ever filled it. A
    // hole nothing fills is the `null` type and has a rep (D1576).
    noteNullHole(bound, ix)
  }
  // Un-inferred empty-collection floor: a still-open hole may yet be pinned by a downstream
  // `.push`/`.set`/`.add` — recorded for the scope-close re-check (`flushUninferred`).
  // A container nothing but reads ever uses takes the default now, so each read is checked at it.
  if unresolvedHole(bound) && cwBindingOnlyRead(ix) {
    defaultReadOnlyContainer(bound)
  }
  const om: i32[] = [-1]
  if unresolvedHole(bound) || recOpenHolePath(bound, 8, om) != "" {
    notePending(n.letName, bound, ix)
  }
  if !unresolvedHole(bound) { notePendingNulList(bound, 0) }
  // Exports an un-annotated if-expression binding's inferred value-union type for the
  // emitter. Gated to if-expr/`?.` inits only — rendering via `tyToStr` is costly on the hot path.
  let initIf = n.letInit
  if initIf >= 0 {
    const ini0 = nodeAt(initIf)
    if ini0 is Paren { initIf = ini0.parInner }
  }
  let isIfInit = false
  if initIf >= 0 {
    const ini1 = nodeAt(initIf)
    if ini1 is IfStmt { isIfInit = true }
    // A standalone optional chain (`const t = a?.w`) is the other init shape whose union the
    // emitter can learn about from nowhere else — as rare as an if-expression init.
    if ini1 is OptMember { isIfInit = true }
    // …and a `??`, whose result is a join the program spells nowhere else (D1709).
    if ini1 is BinExpr {
      if ini1.binOp == "??" { isIfInit = true }
    }
    // …and an optional CALL (`const t = p?.f()`), whose `| null` comes from the guard and
    // so appears in neither the callee's type nor the call's own spelling (D1814).
    if ini1 is Call && ini1.callFn >= 0 {
      const iniCallee = nodeAt(ini1.callFn)
      if iniCallee is OptMember { isIfInit = true }
    }
  }
  if isIfInit {
    const lvn = valueUnionRetName(bound)
    if lvn != "" {
      inferLetIx.push(ix)
      inferLetTy.push(lvn)
    } else if tyIsStructBearingUnion(bound) {
      // A MIXED union renders "" above — a struct member is not a value ATOM — and still reps
      // as the box, so its row is minted from the arena type instead of from a name. Its
      // struct members register as ARMS here, the one place the join is named (D1746).
      inferRegisterVariantMembers(bound)
      inferLetIx.push(ix)
      inferLetTy.push("")
    }
  }
  bound
}

// An `else if` chain is checked along its spine: every link's head runs outermost-first, then
// every tail innermost-first, with `checkNode`'s own bookkeeping for each inner link between, so
// the chain's depth costs no stack (D1990).
export function checkIfStmtNode(ix: i32) {
  const savedChainSpine = ifChainSpine
  ifChainSpineSet(spineAt == ix)
  const frames: IfChk[] = []
  const savedTails: boolean[] = []
  let cur = ix
  let elseRes = TY_VOID
  while cur >= 0 {
    const c = nodeAt(cur)
    const at = cur
    cur = -1
    if c is IfStmt {
      const head = checkIfHead(c, at)
      frames.push(head)
      // A discarded chain discards every link and arm under it.
      if c.ifElse >= 0 && valDiscarded(at) { markValDiscard(c.ifElse) }
      if c.ifElse >= 0 {
        if nodeAt(c.ifElse) is IfStmt {
          // `checkNode`'s entry for the inner link; an `if` is a tail-spine node.
          savedTails.push(retTailPos)
          cur = c.ifElse
        } else {
          const elseSpine = spineAt
          const elseArm = valueArmAt
          if !valDiscarded(at) { valueArmAtSet(c.ifElse) }
          if ifChainSpine { spineAtSet(c.ifElse) }
          const edOuter = head.elseDead && elabCapDeadEnter()
          const edD0 = T.diags.length
          elseRes = checkNodeHook(c.ifElse)
          if head.elseDead { elabCapDeadLeave(edOuter, edD0) }
          spineAtSet(elseSpine)
          valueArmAtSet(elseArm)
        }
      }
    }
  }
  const savedOnTail = ifChainOnFnTail
  ifChainOnFnTailSet(ifChainSpine)
  const savedVloOn = vloMemoOn
  const savedVlo = vloMemo
  vloMemoOnSet(frames.length > 1)
  if vloMemoOn { vloMemoSet(Map()) }
  let k = frames.length - 1
  let res = checkIfTailAt(frames[k], elseRes, false, k > 0)
  while k > 0 {
    const inner = frames[k]
    k = k - 1
    checkNodeDone(inner.ifIx, res, savedTails[k])
    res = checkIfTailAt(frames[k], res, inner.exits, k > 0)
  }
  vloMemoOnSet(savedVloOn)
  vloMemoSet(savedVlo)
  ifChainOnFnTailSet(savedOnTail)
  ifChainSpineSet(savedChainSpine)
  res
}

// Registers the `is`-guard alternatives of the then-narrows `tnPlaces`/`tnTys` that refine a
// hole: a new row goes to both `altRows` and `guardRows`, one a previous pass registered to
// `guardRows` alone, since the guarded-return marking must fire on every pass.
function ifNoteGuardAlts(
  tnPlaces: i32[],
  tnTys: i32[],
  altRows: i32[],
  guardRows: i32[],
) {
  let ai = 0
  while ai < tnPlaces.length {
    const curIx = placeNameTy(tnPlaces[ai])
    if curIx >= 0 {
      const cur = tyAt(curIx)
      if cur is TyVar {
        const row = noteHoleAlt(curIx, cur.tvName, tnTys[ai])
        if row >= 0 {
          altRows.push(row)
          guardRows.push(row)
        } else {
          const seen = holeAltRowOf(cur.tvName, tnTys[ai])
          if seen >= 0 { guardRows.push(seen) }
        }
      }
    }
    ai = ai + 1
  }
  0
}

// Seeds the inferred return from the then-arm value `thenTy` (tail node `thenIx`) of a value
// `if`, guarded by the last of `guardRows` exactly like an explicit `return` inside the arm.
function ifSeedThenRet(n: IfStmt, guardRows: i32[], thenIx: i32, thenTy: i32) {
  const guardedRet = guardRows.length > 0
  if guardedRet { guardAltStackPush(guardRows[guardRows.length - 1]) }
  // The arm, not the arms' join: a tail `if`/`else` whose one arm is an open `[]` needs
  // the sibling arm's shape, and the join is a third arena row (D1591).
  noteInferRetWitness(thenIx, thenTy)
  const seedThen = ifArmValTy(n.ifThen, thenTy)
  if refuseOpenElemRet(thenIx, thenTy, thenIx) {
    noteInferredRet(TY_ERR)
  } else {
    noteInferredSeed(seedThen, armLit(seedThen, n.ifThen))
  }
  if guardedRet { guardAltStackPop() }
  0
}

// Splits what the arm checked since the definite-assignment fork `daFork` made into the ids
// it assigned (`adds`) and the ids it declared and left unwritten (`rems`), then rolls back.
function ifDaArmDelta(daFork: i32, adds: i32[], rems: i32[]) {
  const sid: i32[] = []
  const was: i32[] = []
  daTouchedSince(daFork, sid, was)
  daRollbackTo(daFork)
  daSplitDelta(sid, was, adds, rems)
  0
}

// Enters the else arm of `n`: its else-narrows `enPlaces`/`enTys` in a fresh scope, the
// chain-link mark for an `else if`, and the return-tail position `ifTail`.
function ifEnterElseArm(
  n: IfStmt,
  ifTail: boolean,
  enPlaces: i32[],
  enTys: i32[],
) {
  if n.ifElse < 0 { return 0 }
  if enPlaces.length > 0 {
    pushScope(-1)
    applyNarrows(enPlaces, enTys)
  }
  // An `else if` chain: the else node's VALUE is its own branch join, since `blockTailTy`
  // holds only the innermost block's tail and under-joins a mixed chain.
  const enElse = nodeAt(n.ifElse)
  // A chain link post-narrows the PARENT's fall-through, not its own — marked so its own
  // `checkIfStmtNode` banks into `pgUpKeys` instead of a scope that is about to be popped.
  if enElse is IfStmt { pgUpArmIxSet(n.ifElse) }
  retTailPosSet(ifTail)
  0
}

// Checks the condition of `n`, refusing one that is not boolean, and collects the narrows it
// makes in the then arm (`tnPlaces`/`tnTys`) and the else arm (`enPlaces`/`enTys`).
function ifCheckCondNarrows(
  n: IfStmt,
  tnPlaces: i32[],
  tnTys: i32[],
  enPlaces: i32[],
  enTys: i32[],
) {
  const condTy = checkNodeHook(n.ifCond)
  if !assignable(condTy, TY_BOOL) {
    tErr("if-condition must be boolean, got " + tyToStr(condTy), n.ifCond)
  }
  // Narrowing over a simple identifier: `is T` refines to the variant, `!= null`/`== null`
  // refine a nullable. Union-complement narrowing after `is T` is deliberately excluded — it missed real errors.
  collectThenNarrows(n.ifCond, tnPlaces, tnTys)
  collectElseNarrows(n.ifCond, enPlaces, enTys)
  0
}

// Enters the then arm of one link: its narrows `tnPlaces`/`tnTys` in a fresh scope and the
// return-tail position `ifTail`. True when the last of `guardRows` now guards its returns.
function ifEnterThenArm(
  ifTail: boolean,
  tnPlaces: i32[],
  tnTys: i32[],
  guardRows: i32[],
): boolean {
  if tnPlaces.length > 0 {
    pushScope(-1)
    applyNarrows(tnPlaces, tnTys)
  }
  retTailPosSet(ifTail)
  // Every `return` under this branch is reached only by an argument satisfying the guard's
  // alternative — mark the branch so `noteInferredRet` records it as a guarded member.
  const guardedRet = guardRows.length > 0
  if guardedRet { guardAltStackPush(guardRows[guardRows.length - 1]) }
  guardedRet
}

// Checks the then arm of `n` (at `ix`) as the value arm, or discarded with the `if`, on the
// chain spine and under the condition's non-null facts, restoring all three after.
function ifCheckThenBody(n: IfStmt, ix: i32) {
  const thenArm = valueArmAt
  if valDiscarded(ix) {
    markValDiscard(n.ifThen)
  } else {
    valueArmAtSet(n.ifThen)
  }
  const thenSpine = spineAt
  if ifChainSpine { spineAtSet(n.ifThen) }
  const neMark = neEnter(n.ifCond, curFnDeclIx)
  checkNodeHook(n.ifThen)
  neLeave(neMark)
  spineAtSet(thenSpine)
  valueArmAtSet(thenArm)
  0
}

// The head of one link: everything up to checking its else arm.
function checkIfHead(n: IfStmt, ix: i32): IfChk {
  // Am I the else arm of an enclosing `if`? Read and cleared here, so the flag reaches
  // exactly one callee and every `if` inside a branch body sees `-1` (`pgUpKeys`).
  const isElseArm = ix >= 0 && ix == pgUpArmIx
  pgUpArmIxSet(-1)
  const pgUpMark = pgUpKeys.length
  // What this `if`'s own subtree writes; read by the post-guard leg below (D1736).
  const clobMark = narClobPlace.length
  // Where its places stood on entry, for a key the join first meets inside an arm (`narHeadTy`).
  const ipMark = narIpAt.length
  const headDepth = T.frames.length
  const headNp = npKeys.length
  // An `if`/`else` in value position is an expression whose value is the join of its branch
  // tail values — capture whether THIS `if` sits in the function's return-tail position.
  const ifTail = retTailPos
  const ifInRetArg = inRetArg
  retTailPosSet(false)
  // Where the inferred return stood before this `if`'s arms seeded it (`dropTailIfSeeds`).
  const seedLogMark = inferRetLogTy.length
  const seedObsMark = inferObserved
  const seedObsLit = inferObservedLit
  const tnPlaces: i32[] = []
  const tnTys: i32[] = []
  const enPlaces: i32[] = []
  const enTys: i32[] = []
  const rwD0 = T.diags.length
  const rwT0 = elabCapDeadTests
  const rwA0 = elabCapAlwaysTests
  ifCheckCondNarrows(n, tnPlaces, tnTys, enPlaces, enTys)
  // An elaboration marks the arm of a test its instance makes dead.
  const rwDead = elabCapLive()
    && (T.diags.length > rwD0 || elabCapDeadTests > rwT0)
  // What each tested place held on entry, before either arm's fact: the arm join's start for a
  // path that carries no fact of its own.
  const tnEnt = narKeysNowTys(tnPlaces)
  const enEnt = narKeysNowTys(enPlaces)
  // Definite-assignment fork/join: each branch forks off the if-entry state and they join
  // after — assigned only if assigned on every surviving path; a diverging branch contributes nothing.
  const daFork = daMark()
  // `is`-guard alternatives over a hole: a then-narrow refining a hole is an alternative the
  // body handles on its own branch, not an extra field demand — registered before the scope pushes.
  const altRows: i32[] = []
  // The rows this guard tests, including ones a previous pass already registered — the
  // guarded-return marking must fire on every pass, since the real pass witnesses the call site.
  const guardRows: i32[] = []
  ifNoteGuardAlts(tnPlaces, tnTys, altRows, guardRows)
  const guardedRet = ifEnterThenArm(ifTail, tnPlaces, tnTys, guardRows)
  // The arm's OWN statement depth: its block pushes one scope, so a write recorded at exactly
  // this depth runs whenever the arm does and a deeper one is conditional (D1846).
  const thenOwnDepth = T.frames.length + 1
  const thenLo = narClobPlace.length
  const thenIpLo = narIpAt.length
  const rwOuter = rwDead && elabCapDeadEnter()
  ifCheckThenBody(n, ix)
  if rwDead { elabCapDeadLeave(rwOuter, rwD0) }
  const thenHi = narClobPlace.length
  // The guard-clause divergence test, asked once the arm is checked so a `never` call in it is
  // marked (D1972): the post-guard leg and the `else if` hand-up ask the
  // same predicate.
  const thenExits = stmtAlwaysExits(n.ifThen)
  // A test always true at the pin leaves its `else` arm dead, and when its arm always exits
  // and it has none, the rest of the block.
  const elseDead = elabCapLive() && elabCapAlwaysTests > rwA0
  if elseDead && thenExits && n.ifElse < 0 { elabCapDeadRestSet(true) }
  if guardedRet { guardAltStackPop() }
  retTailPosSet(false)
  const thenTy = blockTailTy
  const thenIx = blockTailIx
  if tnPlaces.length > 0 { popScope() }
  // No path reaches the else arm, or the code after a then arm that exits, through the then
  // arm: what it retired in place is lifted, and the tail restores it for a fall-through (D6690).
  let thenUndoLo = -1
  let thenUndoHi = -1
  if n.ifElse >= 0 || thenExits {
    thenUndoLo = narIpAt.length
    narIpUndoArm(thenIpLo, headDepth, headNp)
    thenUndoHi = narIpAt.length
  }
  // Seeds the inferred return from the then-branch value before the else is checked, so a
  // recursive call in the else resolves against the base case — only from a genuine value-`if`.
  if ifTail && n.ifElse >= 0 {
    if thenTy != TY_VOID && thenTy != TY_ERR {
      ifSeedThenRet(n, guardRows, thenIx, thenTy)
    }
  }
  // Surviving paths' end-states, each as the DELTA its arm made against the fork point: the
  // ids it assigned and the ids it declared and left unwritten.
  const daThenAdds: i32[] = []
  const daThenRems: i32[] = []
  ifDaArmDelta(daFork, daThenAdds, daThenRems)
  // The else arm's own depth and row range, read by the arm join below. An absent else leaves
  // them at their no-rows defaults, which is what says the fall-through wrote nothing.
  let elseOwnDepth = -1
  let elseLo = 0
  const daHasElse = n.ifElse >= 0
  if daHasElse {
    ifEnterElseArm(n, ifTail, enPlaces, enTys)
    elseOwnDepth = T.frames.length + 1
    elseLo = narClobPlace.length
  }
  return {
    ifIx: ix,
    elseDead: elseDead,
    isElseArm: isElseArm,
    pgUpMark: pgUpMark,
    clobMark: clobMark,
    ipMark: ipMark,
    headDepth: headDepth,
    headNp: headNp,
    ifTail: ifTail,
    ifInRetArg: ifInRetArg,
    seedLogMark: seedLogMark,
    seedObsMark: seedObsMark,
    seedObsLit: seedObsLit,
    thenExits: thenExits,
    tnPlaces: tnPlaces,
    tnTys: tnTys,
    tnEnt: tnEnt,
    enPlaces: enPlaces,
    enTys: enTys,
    enEnt: enEnt,
    altRows: altRows,
    thenOwnDepth: thenOwnDepth,
    thenLo: thenLo,
    thenHi: thenHi,
    thenTy: thenTy,
    thenUndoLo: thenUndoLo,
    thenUndoHi: thenUndoHi,
    daFork: daFork,
    daThenAdds: daThenAdds,
    daThenRems: daThenRems,
    daHasElse: daHasElse,
    elseOwnDepth: elseOwnDepth,
    elseLo: elseLo,
    exits: false,
  }
}

// `for v[, i] in recv { body }` over a union of lists, rewritten in place to
// `{ const $lu = recv; let $li = 0; while true { if $li >= <len> { break }; let i = $li;
// $li = $li + 1; let v: E = <$lu[i]>; body } }`, which re-reads the length every pass as a
// list's own loop does. -1 when a member or the element union has no spelling.
function luForInAt(n: ForIn, ix: i32, iterTy: i32, ms: i32[], elem: i32): i32 {
  if !luAllSpell(iterTy, ms) || luTs(elem) < 0 { return -1 }
  const pos = n.pos
  const recv = luDecl("const", "$lu" + i32ToStr(ix), iterTy, n.fiIter, ix, pos)
  const ctr = luDecl(
    "let",
    "$li" + i32ToStr(ix),
    -1,
    luAt(mkNum("0", pos), ix),
    ix,
    pos,
  )
  let at = n.fiVar2
  if at == "" { at = "$lk" + i32ToStr(ix) }
  const outer: i32[] = []
  outer.push(recv)
  outer.push(ctr)
  const lenCond = luAt(
    mkBinary(
      ">=",
      luRef(ctr, ix, pos),
      valueIfAdd(luChain(ms, 0, recv, -1, -1, ix, pos)),
      pos,
    ),
    ix,
  )
  const brk: i32[] = []
  brk.push(luAt(mkBreak("break", "", pos), ix))
  const loop: i32[] = []
  loop.push(luAt(mkIf(lenCond, luAt(mkBlock(brk, pos), ix), -1, pos), ix))
  const atDecl = luDecl("let", at, -1, luRef(ctr, ix, pos), ix, pos)
  luDeclPosPut(atDecl, n.fiIter)
  loop.push(atDecl)
  const inc = luAt(
    mkBinary("+", luRef(ctr, ix, pos), luAt(mkNum("1", pos), ix), pos),
    ix,
  )
  loop.push(luAt(mkBinary("=", luRef(ctr, ix, pos), inc, pos), ix))
  const val = valueIfAdd(luChain(ms, 0, recv, atDecl, elem, ix, pos))
  const vDecl = luDecl("let", n.fiVar, elem, val, ix, pos)
  luDeclPosPut(vDecl, n.fiIter)
  loop.push(vDecl)
  const lmoved: {[i32]: i32} = Map()
  lmoved[n.fiDecl1] = vDecl
  if n.fiDecl2 >= 0 { lmoved[n.fiDecl2] = atDecl }
  identRedirect(lmoved)
  const bn = nodeAt(n.fiBody)
  if bn is Block {
    let i = 0
    while i < bn.blkStmts.length {
      loop.push(bn.blkStmts[i])
      i = i + 1
    }
  } else {
    loop.push(n.fiBody)
  }
  const cond = luAt(mkBool(1, -1), ix)
  const body = luAt(mkBlock(loop, pos), ix)
  outer.push(luAt(mkWhile(cond, body, n.fiLabel, pos, 0), ix))
  // `if true { … }` rather than a bare block, the statement form every walk descends.
  const once = luAt(mkBool(1, -1), ix)
  const w: Node = {
    ifCond: once,
    ifThen: luAt(mkBlock(outer, pos), ix),
    ifElse: -1,
    pos: pos,
  }
  arenaSetNode(ix, w)
  luGrow()
  checkNodeHook(ix)
}

// `for k[, v] in recv { body }` over a union of maps whose keys agree, rewritten in place to a
// loop over the keys read member by member, as `for k in recv.keys()` is. A map's value binding
// reads `.values()` at the key's position: `{ const $lm = recv; const $lv = $lm.values();
// for k, $lj in $lm.keys() { let v: V = $lv[$lj]; body } }`. -1 when a type has no spelling.
function lmForInAt(n: ForIn, ix: i32, iterTy: i32, ms: i32[]): i32 {
  const m0 = tyAt(ms[0])
  if !(m0 is TyMap) || !luAllSpell(iterTy, ms) { return -1 }
  const pos = n.pos
  const none: i32[] = []
  if n.fiVar2 == "" || m0.mSet == 1 {
    const keys = luAt(
      mkCall(luAt(mkMember(n.fiIter, "keys", pos), ix), none, pos),
      ix,
    )
    const fw: Node = {
      fiVar: n.fiVar,
      fiVar2: n.fiVar2,
      fiDecl1: n.fiDecl1,
      fiDecl2: n.fiDecl2,
      fiIter: keys,
      fiBody: n.fiBody,
      fiLabel: n.fiLabel,
      pos: pos,
    }
    arenaSetNode(ix, fw)
    luGrow()
    return checkNodeHook(ix)
  }
  const val = lmValTy(ms)
  if val < 0 || luTs(val) < 0 { return -1 }
  const recv = luDecl("const", "$lm" + i32ToStr(ix), iterTy, n.fiIter, ix, pos)
  const at = "$lj" + i32ToStr(ix)
  const outer: i32[] = []
  outer.push(recv)
  const vcall = mkCall(
    luAt(mkMember(luRef(recv, ix, pos), "values", pos), ix),
    none,
    pos,
  )
  const vals = luDecl(
    "const",
    "$lv" + i32ToStr(ix),
    -1,
    luAt(vcall, ix),
    ix,
    pos,
  )
  outer.push(vals)
  const loop: i32[] = []
  const atRef = luAt(mkIdent(at, pos), ix)
  const rd = luAt(mkIndex(luRef(vals, ix, pos), atRef, pos), ix)
  const vDecl = luDecl("let", n.fiVar2, val, rd, ix, pos)
  luDeclPosPut(vDecl, n.fiIter)
  loop.push(vDecl)
  const bn = nodeAt(n.fiBody)
  if bn is Block {
    for s in bn.blkStmts { loop.push(s) }
  } else {
    loop.push(n.fiBody)
  }
  const kcall = mkCall(
    luAt(mkMember(luRef(recv, ix, pos), "keys", pos), ix),
    none,
    pos,
  )
  const body = luAt(mkBlock(loop, pos), ix)
  const fl = luAt(
    mkForIn(n.fiVar, at, luAt(kcall, ix), body, n.fiLabel, pos),
    ix,
  )
  outer.push(fl)
  if fl < 0 || fl >= P.nodes.length { return -1 }
  const fln = nodeAt(fl)
  if !(fln is ForIn) { return -1 }
  identFromDecl(atRef, fln.fiDecl2)
  const mmoved: {[i32]: i32} = Map()
  mmoved[n.fiDecl1] = fln.fiDecl1
  mmoved[n.fiDecl2] = vDecl
  identRedirect(mmoved)
  const once = luAt(mkBool(1, -1), ix)
  const w: Node = {
    ifCond: once,
    ifThen: luAt(mkBlock(outer, pos), ix),
    ifElse: -1,
    pos: pos,
  }
  arenaSetNode(ix, w)
  luGrow()
  checkNodeHook(ix)
}

// Extracted from `checkNodeReal`'s `WhileStmt` arm (C3: thin the dispatcher).
export function checkWhileStmtNode(n: WhileStmt, ix: i32) {
  crLoopPreRetire(ix)
  // The barrier opens before the condition, which runs again after the body: its reads are
  // among the loop's re-run reads, and a write in it re-runs like one in the body.
  pushReBarrier(crLoopRdSlots.length)
  const wc = checkNodeHook(n.whileCond)
  if !assignable(wc, TY_BOOL) {
    tErr("while-condition must be boolean, got " + tyToStr(wc), n.whileCond)
  }
  // Definite-assignment: a loop body may run zero times, so an in-body assignment is not
  // guaranteed to reach the fall-through — check the body live, then restore the pre-loop state.
  const daLoopMark = daMark()
  // The body is a narrowing scope like an `if` then-arm, re-tested every iteration — every fact
  // the condition proves, for a property path as much as a bare name and an `is T` pin as much
  // as a null strip. What could falsify a path fact mid-body retires it: a write through
  // `retireNarrowingsForWrite`, a call through `noteCallInvalidations` (D1736, D1845).
  const wnPlaces: i32[] = []
  const wnTys: i32[] = []
  collectThenNarrows(n.whileCond, wnPlaces, wnTys)
  if wnPlaces.length > 0 {
    pushScope(-1)
    applyNarrows(wnPlaces, wnTys)
  }
  const blk = n.whileBlk == 1
  // A labelled block's tail is its value, so its body is discarded only when the block is.
  if !blk || valDiscarded(ix) { markValDiscard(n.whileBody) }
  lpPush(n.whileLabel)
  let neMark = neKeys.length
  if !blk { neMark = neEnter(n.whileCond, curFnDeclIx) }
  checkNodeHook(n.whileBody)
  neLeave(neMark)
  let tailTy = -1
  let tailIx = -1
  let runsOut = lpOn && !condLitTrue(n.whileCond)
  if blk {
    runsOut = false
    if blockTailTy >= 0 && !isVoidTy(blockTailTy) && blockTailIx >= 0 {
      tailTy = blockTailTy
      tailIx = blockTailIx
    } else if !stmtAlwaysExits(n.whileBody) {
      runsOut = true
    }
  }
  const res = lpPopResult(ix, tailTy, tailIx, runsOut)
  if wnPlaces.length > 0 { popScope() }
  popReBarrier()
  daRollbackTo(daLoopMark)
  daRelease(daLoopMark)
  return res
}

// Extracted from `checkNodeReal`'s `ForRange` arm (C3: thin the dispatcher).
export function checkForRangeNode(n: ForRange, ix: i32) {
  crLoopPreRetire(ix)
  // A range over `const` bounds keeps them as names: its constant-range refusals and the emitter's
  // step floor are about bounds the author wrote as literals.
  lbiKeepName = lbiKeepName + 1
  const frFrom = checkNodeHook(n.frFrom)
  const frTo = checkNodeHook(n.frTo)
  lbiKeepName = lbiKeepName - 1
  lbiNoteDelivery(n.frFrom, TY_I32, -1)
  lbiNoteDelivery(n.frTo, TY_I32, -1)
  if !assignable(frFrom, TY_I32) || !assignable(frTo, TY_I32) {
    if forRangeFloatish(frFrom) || forRangeFloatish(frTo) {
      tErr(
        "a `for` range counts in i32, so "
          + tyToStr(frFrom)
          + " and "
          + tyToStr(frTo)
          + " bounds have no step — count with an integer and scale: `for i in 0 to 10 { const x = i / 10.0 }`",
        ix,
      )
    } else {
      tErr(
        "for-range bounds must be i32, got "
          + tyToStr(frFrom)
          + " and "
          + tyToStr(frTo),
        ix,
      )
    }
  }
  if n.frStep >= 0 {
    lbiKeepName = lbiKeepName + 1
    const frStep = checkNodeHook(n.frStep)
    lbiKeepName = lbiKeepName - 1
    lbiNoteDelivery(n.frStep, TY_I32, -1)
    if !assignable(frStep, TY_I32) {
      if forRangeFloatish(frStep) {
        tErr(
          "a `for` range counts in i32, so a "
            + tyToStr(frStep)
            + " step has no iteration count — count with an integer and scale: `for i in 0 to 10 { const x = i / 10.0 }`",
          ix,
        )
      } else {
        tErr("for-range step must be i32, got " + tyToStr(frStep), ix)
      }
    }
  }
  checkRangeNeverRuns(n.frFrom, n.frTo, n.frStep, n.frExcl)
  // A `for` body re-executes with no condition to re-establish anything, so every
  // narrowing live here predates it — see `pushReBarrier`.
  pushReBarrier(crLoopRdSlots.length)
  pushScope(ix)
  declareDecl(ix, n.frVar, TY_I32)
  symDecl(n.frVar, ix, TY_I32, 0)
  // Loop body may run zero times — see `WhileStmt` (A-definite-assign).
  const daFrMark = daMark()
  // The loop variable is always assigned in the body — clear it from the dead-zone so a body
  // read isn't flagged when it shadows a still-uninitialized module global of the same name.
  daMarkAssignedNode(ix)
  markValDiscard(n.frBody)
  lpPush(n.frLabel)
  checkNodeHook(n.frBody)
  const res = lpPopResult(ix, -1, -1, true)
  daRollbackTo(daFrMark)
  daRelease(daFrMark)
  popScope()
  popReBarrier()
  return res
}
// ── for v in iterable ───────────────────────────────────────────────────────
// A for-in loop over an array: the loop variable binds to the element type.

// Extracted from `checkNodeReal`'s `ForIn` arm (C3: thin the dispatcher).
export function checkForInNode(n: ForIn, ix: i32) {
  crLoopPreRetire(ix)
  let iterTy = checkNodeHook(n.fiIter)
  if iterTy >= 0 { iterTy = strLitRecvTy(iterTy) }
  pinIterKey(iterTy)
  let elemTy = forInBindTy(iterTy, false)
  let elem2Ty = forInBindTy(iterTy, true)
  const it = tyAt(iterTy)
  let luMs = luMembers(iterTy)
  if !luRecvLowers(n.fiIter, luMs) { luMs = [] }
  const luElem = if luMs.length > 0 { luElemTy(luMs) } else { -1 }
  if luElem >= 0 {
    if !inferQuiet {
      const luf = luForInAt(n, ix, iterTy, luMs, luElem)
      if luf >= 0 { return TY_VOID }
    }
    elemTy = luElem
    elem2Ty = TY_I32
  }
  let lmMs: i32[] = []
  if luElem < 0 && it is TyUnion { lmMs = lmMembers(iterTy) }
  if !luRecvLowers(n.fiIter, lmMs) { lmMs = [] }
  if lmMs.length > 0 {
    const lm0 = tyAt(lmMs[0])
    if !(lm0 is TyMap) {
      lmMs = []
    } else if !inferQuiet {
      if lmForInAt(n, ix, iterTy, lmMs) >= 0 { return TY_VOID }
      lmMs = []
    } else {
      elemTy = lm0.mKey
      elem2Ty = if lm0.mSet == 1 { TY_I32 } else { lmValTy(lmMs) }
      if elem2Ty < 0 { elem2Ty = TY_ERR }
    }
  }
  if (luElem >= 0 || lmMs.length > 0) && inferQuiet {
    // Typed as the rewrite will type it; the real pass rewrites the loop.
  } else if it is TyArray || it is TyMap || isStringTy(iterTy) || it is TyErr {
    // Iterable (or already reported): `forInBindTy` has typed both bindings.
  } else if it is TyObj {
    // A struct is a NOMINAL record whose fields have different types, so a loop variable over
    // one has no type to bind, and the field read the author wants needs a key no operation
    // accepts. The map is the collection with keyed iteration (`open-rulings.md` §B8-for-struct).
    tErr(
      "a struct's fields are not a sequence, so `for … in "
        + tyToStr(iterTy)
        + "` has nothing to iterate — use a map (`{[string]: i32}`) for keyed iteration, or read the fields by name",
      n.fiIter,
    )
  } else {
    tErr(
      "for-in expects an array, a map or a string, got " + tyToStr(iterTy),
      n.fiIter,
    )
  }
  // See ForRange: a `for` body re-executes with nothing to re-establish a narrowing.
  pushReBarrier(crLoopRdSlots.length)
  pushScope(ix)
  declareDecl(n.fiDecl1, n.fiVar, elemTy)
  symDecl(n.fiVar, n.fiDecl1, elemTy, 0)
  // Every element read under an element-only narrowing fits its leaf: a write in the loop that
  // may leave it ended it before the loop (`crLoopPreRetire`).
  efLeaf[ix] = -1
  if it is TyArray {
    const fk = elemOnlyKeyOf(n.fiIter)
    if fk >= 0 { elemFactFor(ix, elemRecvPrefix(n.fiIter), fk) }
    narrowFreshBinding(n.fiDecl1, n.fiVar, ix)
  }
  if n.fiVar2 != "" {
    declareDecl(n.fiDecl2, n.fiVar2, elem2Ty)
    symDecl(n.fiVar2, n.fiDecl2, elem2Ty, 0)
  }
  // Loop body may run zero times — see `WhileStmt` (A-definite-assign).
  const daFiMark = daMark()
  // See ForRange: clear the loop var from the dead-zone for the body so it can't
  // collide with a shadowed, still-uninitialized module global of the same name.
  daMarkAssignedNode(n.fiDecl1)
  if n.fiDecl2 >= 0 { daMarkAssignedNode(n.fiDecl2) }
  markValDiscard(n.fiBody)
  lpPush(n.fiLabel)
  checkNodeHook(n.fiBody)
  const res = lpPopResult(ix, -1, -1, true)
  daRollbackTo(daFiMark)
  daRelease(daFiMark)
  popScope()
  popReBarrier()
  return res
}
// ── return ─────────────────────────────────────────────────────────────────

// Under an instance re-check, a function declared `: T` whose `T` is pinned to a newtype brand
// accepts a body value of the brand's base: the call already admits it (`retNomOnlyAtHole`),
// and the re-check must agree rather than refuse what the call let through.
function retNomPinOk(retArg: i32, got: i32, want: i32): boolean {
  if monoRecheckDepth <= 0 || curFnDeclIx < 0 { return false }
  const dn = nodeAt(curFnDeclIx)
  if !(dn is FuncDecl) || dn.fnRet < 0 { return false }
  const rn = nodeAt(dn.fnRet)
  if !(rn is TypeRef) { return false }
  if strListIndexOf(dn.fnTyParams, rn.tyName) < 0 { return false }
  let k = tpEnvNames.length - 1
  while k >= 0 && tpEnvNames[k] != rn.tyName { k = k - 1 }
  if k < 0 || tpEnvTys[k] != want { return false }
  if !tyIsNewtypeBrand(want) { return false }
  const b = nomBaseTyIx(want)
  if b < 0 || b == want { return false }
  assignableExpr(retArg, got, b)
}

// Extracted from `checkNodeReal`'s `RetStmt` arm (C3: thin the dispatcher).
export function checkRetStmtNode(n: RetStmt, ix: i32) {
  const want = T.curRet
  if tpEnvNames.length > 0 { tpIfMarkOk(n.retArg) }
  // `T.curRet` is only ever `-1` at its `initChecker` reset, never written by a
  // function-body check (`checkFuncDeclNode` always saves/restores a real return type or
  // the `-2` inferring sentinel) — so `-1` here means this `return` is not inside any
  // function, lambda, method or getter body (PL-028, D2262).
  if want == -1 {
    tErr(
      "`return` is only valid inside a function; to end the program early use `exit(code)` from `std:process`, or restructure with `else`",
      ix,
    )
    return TY_VOID
  }
  // Only a call that itself never returns may stand in a `never` function's `return` (D1972).
  if want == TY_NEVER && want >= 0 {
    if n.retArg < 0 || checkNodeHook(n.retArg) != TY_NEVER {
      tErr(
        "a function declared `never` cannot return — end the path in a call that never returns, such as `__trap__()`",
        ix,
      )
    }
    return TY_VOID
  }
  if n.retArg < 0 {
    // `tyIsHole` because `assignable` waves a `TyVar` past any destination, so a declared
    // `: T` accepted the bare return here and the emitter refused the instance (D1600).
    if want >= 0 && (tyIsHole(want) || !assignable(TY_VOID, want)) {
      // Both route-arounds, because either can be intended: the annotation is what makes this
      // return illegal, so dropping it is as valid a fix as supplying a value.
      tErr(
        "return needs a value of type "
          + tyToStr(want)
          + " — return a value, or annotate this function `: void`",
        ix,
      )
    }
    return TY_VOID
  }
  // Under a pending return type (-2: this function's return is being inferred),
  // record the returned type as a witness instead of checking a mismatch.
  if want == -2 {
    // A returned call whose deferred join this site could not decide contributes the
    // whole join, not the lossy collapse the emitter gets (`inferRetTyOf`).
    const savedInRetArg = inRetArg
    inRetArgSet(true)
    const cbArg = cycleBreakCount
    const rArgTy = checkNodeHook(n.retArg)
    inRetArgSet(savedInRetArg)
    // A value read from an undecided element decides the return no more than a binding's type:
    // refused, and noted as an error so the function infers no `void` from it.
    if refuseOpenElemRet(n.retArg, rArgTy, ix) {
      fnSawValueRetSet(true)
      noteInferredRet(TY_ERR)
      return TY_VOID
    }
    // `return <void expr>` evaluates the expression and returns nothing, so it is a void
    // return; the function's finish refuses it if the function returns a value. A void that is
    // only a recursive cycle's provisional answer is still a value return position (D2635).
    if (
      isVoidTy(rArgTy)
      && cycleBreakCount == cbArg
      && !voidSlotExemptExpr(n.retArg)
    ) {
      inferVoidRetSites.push(ix)
      inferVoidRetBlks.push(chkStmtBlk)
      return TY_VOID
    }
    fnSawValueRetSet(true)
    // `return <void call>` names a value to return and has none — reported here rather than
    // left to the mismatch check below, which never sees this path (the return type is still inferred).
    if voidValueSlotErr(rArgTy, n.retArg, "return", ix) { return TY_VOID }
    // D1045 — a body-scoped nominal type may not escape through an inferred return.
    refuseLocalNomEscape(rArgTy, ix)
    // An empty-collection hole returned here has a destination not final until the body ends
    // — the pin is deferred to `flushInferRetHoles` rather than skipped (D1591).
    noteInferRetWitness(n.retArg, rArgTy)
    inferRetNextLitSet(armLit(rArgTy, n.retArg))
    noteInferredRet(inferRetTyOf(n.retArg, rArgTy))
    return TY_VOID
  }
  // Bidirectional: `function mk(): (i32) => i32 { return (x) => … }` infers the returned
  // lambda's param from the declared return type (also through a composite return shape).
  if want >= 0 { seedExpected(n.retArg, want) }
  const cbGot = cycleBreakCount
  const got = checkNodeHook(n.retArg)
  // Under a void return `assignable` passes anything void-bearing, so this gate refuses a union
  // that mentions void. A wholly void value is a void return: `return g()` calls, then returns (D2635).
  if isVoidTy(want) {
    if isVoidTy(got) && cycleBreakCount == cbGot {
      voidRetRwRet.push(ix)
      voidRetRwBlk.push(chkStmtBlk)
      return TY_VOID
    }
    if voidValueSlotErr(got, n.retArg, "return", ix) { return TY_VOID }
  }
  // Redundant-return rule: witness the explicit return's natural type (before
  // constrainEmpty); an annotation-influenced return disqualifies the function.
  if retInfluencedByAnnot(n.retArg) || retSiteTypedByAnnot(n.retArg, got) {
    retNaturalErrSet(true)
  }
  noteNaturalRet(got)
  // An explicit `return inner` of an empty collection pins its element from the
  // declared return type — usage-driven inference clearing the floor.
  constrainEmptyExpr(n.retArg, got, want)
  if (
    want >= 0
    && !assignableExpr(n.retArg, got, want)
    && !retNomPinOk(n.retArg, got, want)
  ) {
    tErrWant(
      "return type mismatch: expected "
        + tyToStr(want)
        + ", got "
        + tyToStr(got)
        + bareRetVoidNote(want)
        + charLitForStringNote(n.retArg, want)
        + boolForNumberNote(got, want)
        + storageListNote(n.retArg, got, want)
        + litMemberNote(n.retArg, want, 8),
      n.retArg,
      want,
    )
  } else if want >= 0 {
    // The check above is vacuous whenever a side is a hole — record the pair for the pin to
    // re-ask under substitution, only on the passing side (D551 body / D561 declared side).
    noteRetCstr(coalPinTy(n.retArg, got), want, n.retArg)
  }
  return TY_VOID
}
// ── block ─────────────────────────────────────────────────────────────────

// Extracted from `checkNodeReal`'s `Block` arm (C3: thin the dispatcher).
export function checkBlockNode(n: Block, ix: i32) {
  const blkOnSpine = spineAt == ix
  const savedStmtBlk = chkStmtBlk
  chkStmtBlkSet(ix)
  pushScope(ix)
  const stmts = n.blkStmts
  const blkDiscard = valDiscarded(ix)
  const savedRTP = retTailPos
  let tailTy = TY_VOID
  let tailIx = -1
  // A tail after a statement that always exits never runs, so the block has no value (D8720).
  // Asked once the predecessors are checked, since a `never` call is marked by its check.
  let tailDead = false
  let restMark = -1
  let i = 0
  while i < stmts.length {
    // Only the last statement is the block's value (and inherits tail position); the
    // rest are not the block's value, so they never carry the return tail.
    if i == stmts.length - 1 {
      tailDead = blockTailIsDead(stmts)
      if tailDead { noteDeadTailBlk(ix) }
      retTailPosSet(savedRTP && !tailDead)
    } else {
      retTailPosSet(false)
    }
    if (
      (blkDiscard || i < stmts.length - 1)
      && !(lpOn && breakValueAt(stmts, i))
    ) {
      markValDiscard(stmts[i])
    }
    crStmtEnter(stmts[i])
    let sty = TY_VOID
    if blkOnSpine && i == stmts.length - 1 {
      spineAtSet(stmts[i])
      sty = checkNodeHook(stmts[i])
      spineAtSet(ix)
    } else {
      sty = checkNodeHook(stmts[i])
    }
    crStmtLeave()
    restMark = elabDeadRestOpen(restMark)
    if lpOn {
      brkPrevTySet(sty)
      brkPrevIxSet(stmts[i])
    }
    if i == stmts.length - 1 && !tailDead {
      // A value-producing trailing expression is the block's value; a trailing
      // statement (return / let / assignment / loop) leaves the block valueless.
      if !isStmtNode(stmts[i]) {
        tailTy = sty
        tailIx = stmts[i]
      } else {
        // An if-expression tail IS the block's value even though `IfStmt` is otherwise a
        // statement node — non-void only for a genuine value-`if` with an else.
        const lastN2 = nodeAt(stmts[i])
        if lastN2 is IfStmt {
          // A discarded tail keeps its value here, typed on no node, for an enclosing arm's join.
          const ity = discardedValTyOf(stmts[i], sty)
          if lastN2.ifElse >= 0 {
            if ity != TY_VOID && ity != TY_ERR {
              tailTy = ity
              tailIx = stmts[i]
            }
          } else {
            // An else-less `if` ending a block is its `T | null` value, as a tail one is, when
            // its then-arm completes with a value (D1995's ruling); a then-arm that always
            // exits yields nothing here, and its fall-through meets the function's own `null`.
            if (
              ity != TY_VOID
              && ity != TY_ERR
              && !stmtAlwaysExits(lastN2.ifThen)
            ) {
              tailTy = ity
              tailIx = stmts[i]
            }
          }
        }
      }
    }
    i = i + 1
  }
  elabDeadRestClose(restMark)
  retTailPosSet(savedRTP)
  popScope()
  chkStmtBlkSet(savedStmtBlk)
  blockTailTySet(tailTy)
  blockTailIxSet(tailIx)
  return TY_VOID
}

// The one closed signature the functions of `ms` share: a plain named one's, else a generic one's
// bound at the annotated parameters of a written lambda, whose result the write is then checked
// against. -1 when a plain one is open, two disagree, or a generic one does not fit.
function letFnListClosedSig(ms: i32[]): i32 {
  let f = -1
  const lams: i32[] = []
  for m in ms {
    const d = nodeAt(m)
    if !(d is FuncDecl) { return -1 }
    if d.fnTyParams.length == 0 {
      if d.fnName == "" {
        lams.push(m)
      } else {
        const mt = nodeTyIxOf(m)
        if mt < 0 || mt >= T.tys.length || !(T.tys[mt] is TyFunc) { return -1 }
        if tyHasTyVar(mt) || tyReachesHole(mt, 8) { return -1 }
        if f < 0 { f = mt }
        else if !tySame(f, mt) { return -1 }
      }
    }
  }
  for m in lams {
    const ps = letFnLambdaParamTys(m)
    if ps.length == 0 { return -1 }
    if f < 0 { f = letFnGenericAt(ms, ps) }
    if f < 0 { return -1 }
    const ff = T.tys[f]
    if !(ff is TyFunc) || ff.fnParamTypes.length != ps.length { return -1 }
    let i = 0
    while i < ps.length {
      if !tySame(ps[i], ff.fnParamTypes[i]) { return -1 }
      i = i + 1
    }
  }
  if f < 0 { return -1 }
  for m in ms {
    if !letFnGenericFitsAt(m, f) { return -1 }
  }
  f
}

// The closed types lambda `m`'s parameters are annotated with; [] when one is not annotated or
// does not resolve to a closed type. Read quietly: the lambda's own check reports its annotations.
function letFnLambdaParamTys(m: i32): i32[] {
  const none: i32[] = []
  const d = nodeAt(m)
  if !(d is FuncDecl) || d.fnParams.length == 0 { return none }
  const out: i32[] = []
  const savedQuiet = inferQuiet
  inferQuiet = true
  quietDepth = quietDepth + 1
  for q in d.fnParams {
    const pn = nodeAt(q)
    let t = -1
    const at = if pn is Param { pn.parType } else { -1 }
    if at >= 0 {
      const tn = nodeAt(at)
      if tn is TypeRef { t = resolveAnnotAt(tn.tyName, d.fnTyParams, at, "") }
    }
    if t < 0 || t >= T.tys.length || tyHasTyVar(t) || tyReachesHole(t, 8) {
      inferQuiet = savedQuiet
      quietDepth = quietDepth - 1
      return none
    }
    out.push(t)
  }
  inferQuiet = savedQuiet
  quietDepth = quietDepth - 1
  out
}

// The signature the first generic function of `ms` gives at closed parameter types `ps`: its
// result with its type parameters bound by them; -1 when there is none or one stays unbound.
function letFnGenericAt(ms: i32[], ps: i32[]): i32 {
  for m in ms {
    const d = nodeAt(m)
    if d is FuncDecl && d.fnTyParams.length > 0 {
      const gt = nodeTyIxOf(m)
      if gt < 0 || gt >= T.tys.length { return -1 }
      const gf = T.tys[gt]
      if !(gf is TyFunc) || gf.fnParamTypes.length != ps.length { return -1 }
      const bn: string[] = []
      const bt: i32[] = []
      let i = 0
      while i < ps.length {
        bindGenWalk(gf.fnParamTypes[i], ps[i], bn, bt)
        i = i + 1
      }
      for tp in d.fnTyParams {
        if !strListHas(bn, tp) { return -1 }
      }
      const r = substTyDeep(gf.fnRet, bn, bt)
      if r < 0 || r >= T.tys.length || tyHasTyVar(r) || tyReachesHole(r, 8) {
        return -1
      }
      const cp: i32[] = []
      for p in ps { cp.push(p) }
      return mkFuncTy(cp, r)
    }
  }
  -1
}

// Whether declaration `m` is plain, or a generic whose signature, bound against closed function
// type `f`'s parameters, gives exactly `f`.
function letFnGenericFitsAt(m: i32, f: i32): boolean {
  const d = nodeAt(m)
  if !(d is FuncDecl) { return false }
  if d.fnTyParams.length == 0 { return true }
  const gt = nodeTyIxOf(m)
  if gt < 0 || gt >= T.tys.length { return false }
  const gf = T.tys[gt]
  const ff = T.tys[f]
  if !(gf is TyFunc) || !(ff is TyFunc) { return false }
  if gf.fnParamTypes.length != ff.fnParamTypes.length { return false }
  const bn: string[] = []
  const bt: i32[] = []
  let i = 0
  while i < gf.fnParamTypes.length {
    bindGenWalk(gf.fnParamTypes[i], ff.fnParamTypes[i], bn, bt)
    i = i + 1
  }
  for tp in d.fnTyParams {
    if !strListHas(bn, tp) { return false }
  }
  i = 0
  while i < gf.fnParamTypes.length {
    if !tySame(substTyDeep(gf.fnParamTypes[i], bn, bt), ff.fnParamTypes[i]) {
      return false
    }
    i = i + 1
  }
  tySame(substTyDeep(gf.fnRet, bn, bt), ff.fnRet)
}

// Whether every field of record literal `o` is a named function, whose type no instance changes, or
// a parameter, whose read keeps its own set, so a generic's literal widens as one outside it does
// (D15472, D15455).
function recLitNamesFns(o: ObjLit): boolean {
  if o.objFields.length == 0 { return false }
  for fx in o.objFields {
    const f = nodeAt(fx)
    const v = if f is FieldInit { parenPeelIx(f.fiValue) } else { -1 }
    if v < 0 || v >= P.nodes.length || !(nodeAt(v) is Ident) { return false }
    const d = identDeclOf(v)
    const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
    if !(dn is Param) && (!(dn is FuncDecl) || dn.fnName == "") { return false }
  }
  true
}

// Type `t` of literal `lit` at step path `pre` of the binding `bd` initialises, each list of
// functions inside it widened by `elabFnFieldTy`: a record's fields, and a list's elements as
// `[]` when every element is a literal (D15168, D15201). Each widened literal is re-typed.
function letLitListsWidenAt(bd: i32, lit: i32, t: i32, pre: string[]): i32 {
  const ln = nodeAt(lit)
  if ln is ObjLit { return letFieldListsWidenAt(bd, lit, t, pre) }
  if !(ln is ArrayLit) || t < 0 || t >= T.tys.length || pre.length > 8 {
    return t
  }
  const ta = T.tys[t]
  if !(ta is TyArray) || ln.arrElems.length == 0 { return t }
  // A list of functions below the binding's own value is the leaf `elabFnFieldTy` widens.
  const ea = if ta.aElem >= 0 && ta.aElem < T.tys.length { T.tys[ta.aElem] } else { T.tys[TY_ERR] }
  if ea is TyFunc {
    const none: i32[] = []
    return if pre.length > 0 { elabFnFieldTy(bd, pre, t, none) } else { t }
  }
  const steps: string[] = []
  for st in pre { steps.push(st) }
  steps.push("[]")
  // Every element must be a literal before any is re-typed, so none is left at the old type.
  for e in ln.arrElems {
    const v = parenPeelIx(e)
    if v < 0 || v >= P.nodes.length { return t }
    const vn = nodeAt(v)
    if !(vn is ArrayLit || vn is ObjLit) { return t }
  }
  let w = -1
  for e in ln.arrElems {
    const v = parenPeelIx(e)
    const we = letLitListsWidenAt(bd, v, ta.aElem, steps)
    if w < 0 { w = we }
  }
  if w < 0 || w == ta.aElem { return t }
  for e in ln.arrElems { nodeTySetGrow(parenPeelIx(e), w) }
  const nt = mkArrayTy(w)
  nodeTySetGrow(lit, nt)
  nt
}

// Type `t` of the record a call returns into binding `bd`, each field holding a function or a
// list of functions widened by `elabFnFieldTy` over the call's returned values `rets` and the
// writes through `bd`.
function letCallFieldsWiden(bd: i32, t: i32, rets: i32[]): i32 {
  if t < 0 || t >= T.tys.length { return t }
  const to = T.tys[t]
  if !(to is TyObj) { return t }
  const tys: i32[] = []
  let changed = false
  let i = 0
  while i < to.objFieldNames.length {
    let ft = to.objFieldTypes[i]
    if letFieldHoldsFn(ft) {
      const steps: string[] = [to.objFieldNames[i]]
      const w = elabFnFieldTy(bd, steps, ft, rets)
      if w != ft {
        ft = w
        changed = true
      }
    }
    tys.push(ft)
    i = i + 1
  }
  if !changed { return t }
  const names: string[] = []
  for nm in to.objFieldNames { names.push(nm) }
  mkObjTy(names, tys)
}

// Whether `letCallFieldsWiden` can move `t`: a record with a function or function-list field.
// Without one the callee's return values are not collected at all.
function letCallFieldsWidenable(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const to = T.tys[t]
  if !(to is TyObj) { return false }
  for ft in to.objFieldTypes {
    if letFieldHoldsFn(ft) { return true }
  }
  false
}

// Whether a record field of type `ft` holds a function, directly or as a list's element.
function letFieldHoldsFn(ft: i32): boolean {
  const fa = if ft >= 0 && ft < T.tys.length { T.tys[ft] } else { T.tys[TY_ERR] }
  const fe = if fa is TyArray && fa.aElem >= 0 && fa.aElem < T.tys.length { T.tys[fa.aElem] } else { fa }
  fe is TyFunc
}

// `letFieldListsWiden` for the record literal `lit` of type `t` at field path `pre`.
function letFieldListsWidenAt(bd: i32, lit: i32, t: i32, pre: string[]): i32 {
  if t < 0 || t >= T.tys.length || pre.length > 8 { return t }
  const to = T.tys[t]
  const ln = nodeAt(lit)
  if !(to is TyObj) || !(ln is ObjLit) { return t }
  const tys: i32[] = []
  let changed = false
  let i = 0
  while i < to.objFieldNames.length {
    const nm = to.objFieldNames[i]
    let ft = to.objFieldTypes[i]
    for fx in ln.objFields {
      const f = nodeAt(fx)
      if f is FieldInit && f.fiName == nm {
        const v = parenPeelIx(f.fiValue)
        if v < 0 || v >= P.nodes.length { continue }
        const steps: string[] = []
        for st in pre { steps.push(st) }
        steps.push(nm)
        let w = ft
        const vd = if nodeAt(v) is Ident { identDeclOf(v) } else { -1 }
        const paramRead = vd >= 0 && vd < P.nodes.length && nodeAt(vd) is Param
        if nodeAt(v) is ArrayLit {
          w = letLitListsWidenAt(bd, v, ft, steps)
        } else if nodeAt(v) is ObjLit {
          w = letFieldListsWidenAt(bd, v, ft, steps)
        } else if (
          ft >= 0
          && ft < T.tys.length
          && (T.tys[ft] is TyFunc || T.tys[ft] is TyMap)
        ) {
          // A field holding a function, or a map of them, takes the functions written into it
          // too (D15119, D15534).
          const none: i32[] = []
          w = elabFnFieldTy(bd, steps, ft, none)
        }
        if w != ft {
          // A parameter's read keeps its own set, whose ids the widened field holds (D15455).
          if !paramRead { nodeTySetGrow(v, w) }
          ft = w
          changed = true
        }
      }
    }
    tys.push(ft)
    i = i + 1
  }
  if !changed { return t }
  const names: string[] = []
  for nm in to.objFieldNames { names.push(nm) }
  const nt = mkObjTy(names, tys)
  nodeTySetGrow(lit, nt)
  nt
}
