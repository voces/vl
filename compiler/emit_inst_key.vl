// The canonical instance key (architecture-target §3.4), computed beside mono's own key under the
// rep shadow only: the elaboration key, or the pinned reps where the elaboration keys none, the
// enclosing call frame a capturing nested instance is built in, and the callbacks it is
// specialized on. A key two of mono's instances share is noted as a merge the switch will make.
import { i32ToStr } from "./ast"
import { repABNote } from "./emit_nullable_rets"
import { repShadowOn } from "./emit_rep"
import { TY_WALK_DEPTH, tyCanonKey } from "./emit_ty_canon"
import {
  elabDeliveryKeyOf,
  elabInstSpelling,
  elabMemberKeyAtFnTy,
  elabMemberKeyAtTys,
  elabValueKeyAt,
  elabWalkKeyOf,
} from "./emit_elab"

// Canonical key → the slot of the first instance made under it, for one program.
let instKeyFirst: {[string]: i32} = Map()
// The destination a function value is being instanced for: its declared function type and the
// delivery's parameter types, both from the checker (-1 / [] where none).
let instKeyDstTy = -1
let instKeyDstTys: i32[] = []

// Stages the destination of the function value `monoInstanceFor` is about to instance.
export function instKeyDstSet(t: i32, tys: i32[]) {
  instKeyDstTy = t
  instKeyDstTys = tys
  0
}

export function instKeyReset() {
  instKeyFirst = Map()
  0
}

// The key the elaboration gave the instance about to be demanded, read before mono demands it:
// template call `call`'s own, else the key it noted for function value `value` (the member taking
// pinned types `pTys` where it noted several), else the one at the checker-recorded type of a
// value delivered to a typed slot; -1 for none. Shadow only.
export function instKeyCallTime(
  call: i32,
  value: i32,
  decl: i32,
  pTys: i32[],
): i32 {
  if !repShadowOn { return -1 }
  if call >= 0 { return elabWalkKeyOf(call, true, decl) }
  const vk = elabValueKeyAt(value, decl, pTys)
  if vk >= 0 { return vk }
  const dk = elabDeliveryKeyOf(value, decl)
  if dk >= 0 { return dk }
  const tk = elabMemberKeyAtFnTy(instKeyDstTy, decl)
  if tk >= 0 { return tk }
  elabMemberKeyAtTys(instKeyDstTys, decl)
}

// The elaboration's key for the instance about to be made for function value `value` of `decl`, read
// as `instKeyCallTime` reads it but outside the shadow too: the key the value half is registered
// under. -1 for none.
export function instKeyValueTime(
  call: i32,
  value: i32,
  decl: i32,
  pTys: i32[],
): i32 {
  if call >= 0 { return elabWalkKeyOf(call, true, decl) }
  const vk = elabValueKeyAt(value, decl, pTys)
  if vk >= 0 { return vk }
  const dk = elabDeliveryKeyOf(value, decl)
  if dk >= 0 { return dk }
  const tk = elabMemberKeyAtFnTy(instKeyDstTy, decl)
  if tk >= 0 { return tk }
  elabMemberKeyAtTys(instKeyDstTys, decl)
}

// The registry key of an instance made for a call the elaboration keyed at `ek`: template slot
// `origFe`, that key, the rep each parameter is pinned at (`pinTys`) with the tagged set it holds
// (`pinSets`, "" where none), the enclosing call frame `frame` (-1 for none) and the callbacks
// `cbNames` it is specialized on ("" where none).
export function instKeyCanon(
  origFe: i32,
  ek: i32,
  pinTys: i32[],
  pinSets: string[],
  frame: i32,
  cbNames: string[],
): string {
  let key = "E" + i32ToStr(origFe) + "|" + i32ToStr(ek) + "|"
  let i = 0
  while i < pinTys.length {
    const t = pinTys[i]
    key = key + (if t >= 0 { tyCanonKey(t, TY_WALK_DEPTH) } else { "?" })
    key = key + (if i < pinSets.length { pinSets[i] } else { "" }) + ","
    i = i + 1
  }
  key = key + "|"
  if frame >= 0 { key = key + i32ToStr(frame) }
  key = key + "|"
  for nm in cbNames {
    if nm != "" { key = key + "@" + nm }
  }
  key
}

// Notes the instance in slot `instFe` of template `origFe` under its canonical key: `ek` the
// elaboration key mono demanded (-1 where none) and `ct` the one `instKeyCallTime` read, `pinTys`
// the pinned parameter types, `frame` the enclosing call frame or -1, `cbNames` the callback names
// it is specialized on ("" where none). Shadow only.
export function instKeyNote(
  origFe: i32,
  name: string,
  ek: i32,
  ct: i32,
  pinTys: i32[],
  frame: i32,
  cbNames: string[],
  instFe: i32,
) {
  if !repShadowOn { return 0 }
  if ct < 0 {
    repABNote("instKey", "callTime", "none " + name)
  } else if (
    ct == ek
    || ek >= 0 && elabInstSpelling(ct) == elabInstSpelling(ek)
  ) {
    repABNote("instKey", "callTime", "agree")
  } else {
    repABNote("instKey", "callTime", "differ " + name)
  }
  let key = i32ToStr(origFe) + "|"
  if ek >= 0 {
    key = key + "e" + i32ToStr(ek)
  } else {
    for t in pinTys {
      key = key
        + (if t >= 0 { tyCanonKey(t, TY_WALK_DEPTH) } else { "?" })
        + ","
    }
  }
  key = key + "|" + (if frame >= 0 { i32ToStr(frame) } else { "" }) + "|"
  for nm in cbNames {
    if nm != "" { key = key + "@" + nm }
  }
  const first = instKeyFirst.get(key)
  if first == null {
    instKeyFirst[key] = instFe
    repABNote("instKey", "made", "keyed")
  } else if first != instFe {
    repABNote("instKey", "merge", name)
  }
  0
}
