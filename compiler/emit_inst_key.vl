// The canonical instance key (architecture-target §3.4), computed beside mono's own key under the
// rep shadow only: the elaboration key, or the pinned reps where the elaboration keys none, the
// enclosing call frame a capturing nested instance is built in, and the callbacks it is
// specialized on. A key two of mono's keys share is noted as a merge the switch will make.
import { i32ToStr } from "./ast"
import { repABNote } from "./emit_nullable_rets"
import { repShadowOn } from "./emit_rep"
import { TY_WALK_DEPTH, tyCanonKey } from "./emit_ty_canon"

// Canonical key → the first mono key made under it, for one program.
let instKeyFirst: {[string]: string} = Map()

export function instKeyReset() {
  instKeyFirst = Map()
  0
}

// Notes instance `monoKey` of template `origFe` under its canonical key: `ek` the elaboration
// key (-1 where none), `pinTys` the pinned parameter types, `frame` the enclosing call frame or
// -1, `cbNames` the callback names it is specialized on ("" where none). Shadow only.
export function instKeyNote(
  origFe: i32,
  name: string,
  ek: i32,
  pinTys: i32[],
  frame: i32,
  cbNames: string[],
  monoKey: string,
) {
  if !repShadowOn { return 0 }
  let key = i32ToStr(origFe) + "|"
  if ek >= 0 {
    key = key + "e" + i32ToStr(ek)
  } else {
    for t in pinTys {
      key = key
        + (if t >= 0 { tyCanonKey(t, TY_WALK_DEPTH) } else { "?" })
        + ","
    }
  }
  key = key + "|" + (if frame >= 0 { i32ToStr(frame) } else { "" }) + "|"
  for nm in cbNames {
    if nm != "" { key = key + "@" + nm }
  }
  const first = instKeyFirst.get(key)
  if first == null {
    instKeyFirst[key] = monoKey
    repABNote("instKey", "made", "keyed")
  } else if first != monoKey {
    repABNote("instKey", "merge", name)
  }
  0
}
