// The canonical instance key (architecture-target §3.4), computed beside mono's own key under the
// rep shadow only: the elaboration key, or the pinned reps where the elaboration keys none, the
// enclosing call frame a capturing nested instance is built in, and the callbacks it is
// specialized on. A key two of mono's keys share is noted as a merge the switch will make.
import { i32ToStr } from "./ast"
import { repABNote } from "./emit_nullable_rets"
import { repShadowOn } from "./emit_rep"
import { TY_WALK_DEPTH, tyCanonKey } from "./emit_ty_canon"
import { elabDeliveryKeyOf, elabInstSpelling, elabWalkKeyOf } from "./emit_elab"

// Canonical key → the first mono key made under it, for one program.
let instKeyFirst: {[string]: string} = Map()

export function instKeyReset() {
  instKeyFirst = Map()
  0
}

// The key the elaboration gave the instance about to be demanded, read before mono demands it:
// template call `call`'s own, else the key it noted for function value `value`, else the one at
// the checker-recorded type of a value delivered to a typed slot; -1 for none. Shadow only.
export function instKeyCallTime(call: i32, value: i32, decl: i32): i32 {
  if !repShadowOn { return -1 }
  if call >= 0 { return elabWalkKeyOf(call, true, decl) }
  const vk = elabWalkKeyOf(value, false, decl)
  if vk >= 0 { return vk }
  elabDeliveryKeyOf(value, decl)
}

// Notes instance `monoKey` of template `origFe` under its canonical key: `ek` the elaboration
// key mono demanded (-1 where none) and `ct` the one `instKeyCallTime` read, `pinTys` the pinned
// parameter types, `frame` the enclosing call frame or -1, `cbNames` the callback names it is
// specialized on ("" where none). Shadow only.
export function instKeyNote(
  origFe: i32,
  name: string,
  ek: i32,
  ct: i32,
  pinTys: i32[],
  frame: i32,
  cbNames: string[],
  monoKey: string,
) {
  if !repShadowOn { return 0 }
  if ct < 0 {
    repABNote("instKey", "callTime", "none " + name)
  } else if (
    ct == ek
    || ek >= 0 && elabInstSpelling(ct) == elabInstSpelling(ek)
  ) {
    repABNote("instKey", "callTime", "agree")
  } else {
    repABNote("instKey", "callTime", "differ " + name)
  }
  let key = i32ToStr(origFe) + "|"
  if ek >= 0 {
    key = key + "e" + i32ToStr(ek)
  } else {
    for t in pinTys {
      key = key
        + (if t >= 0 { tyCanonKey(t, TY_WALK_DEPTH) } else { "?" })
        + ","
    }
  }
  key = key + "|" + (if frame >= 0 { i32ToStr(frame) } else { "" }) + "|"
  for nm in cbNames {
    if nm != "" { key = key + "@" + nm }
  }
  const first = instKeyFirst.get(key)
  if first == null {
    instKeyFirst[key] = monoKey
    repABNote("instKey", "made", "keyed")
  } else if first != monoKey {
    repABNote("instKey", "merge", name)
  }
  0
}
