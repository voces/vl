// The symbol a relocation row's value is named by, for the armed `vl.reloc` section: the
// program-level identity that decides the value, which a link would look up instead of
// trusting this module's numbering. docs/internals/s5-per-module-artifacts.md §8.

import { i32ToStr } from "./ast"
import { uAtomBandTop } from "./emit_map_twins"
import { litAtomTextOf } from "./emit_lit_atoms"
import {
  RS_ATOM,
  RS_GNAME,
  RS_GREAD,
  RS_GUARD,
  RS_TAG,
  relSkew,
} from "./emit_reloc"
import {
  cloSigTagNames,
  gInitReaders,
  mvKeyKind,
  mvValName,
  rlElemName,
  uTags,
  uVariants,
} from "./emit_state"
import { variantTagKey } from "./emit_variant_sig"
import { initGuardGlobalText } from "./wasmEmit"

// The key of value `v` of space `sp`, named from `sub`; a closure slot is the caller's, since
// its name is the name section's. A value no table explains keys as `?:` and its number.
export function relSymKey(sp: i32, sub: i32, v: i32): string {
  if sp == RS_TAG { return relTagKey(v) }
  if sp == RS_ATOM { return "a:" + litAtomTextOf(v) }
  if sp == RS_GUARD || sp == RS_GNAME {
    const t = initGuardGlobalText(sub)
    return "g:" + t[0] + t[1]
  }
  if sp == RS_GREAD && sub >= 0 && sub < gInitReaders.length {
    return "r:" + gInitReaders[sub]
  }
  "?:" + i32ToStr(v)
}

// A union box tag: a struct variant by its signature, a value-atom code, or a slot band's arm
// by the type its slot interns (residue 0 a ref list, 1 a map, 2 a closure signature).
function relTagKey(v: i32): string {
  let vi = 0
  while vi < uTags.length {
    if uTags[vi] == v { return "v:" + variantTagKey(vi) }
    vi = vi + 1
  }
  const t = v - relSkew(RS_TAG)
  const k0 = uVariants.length
  if t >= k0 && t < k0 + uAtomBandTop() { return "k:" + i32ToStr(t - k0) }
  const off = t - uVariants.length - uAtomBandTop()
  if off < 0 { return "?:" + i32ToStr(t) }
  const r = off % 3
  if r == 0 && off / 3 < rlElemName.length {
    return "rl:" + rlElemName[off / 3]
  }
  if r == 1 {
    const s = (off - 4) / 3
    if s == -1 { return "map:mono" }
    if s >= 0 && s < mvValName.length && s < mvKeyKind.length {
      return "map:" + i32ToStr(mvKeyKind[s]) + ":" + mvValName[s]
    }
  }
  if r == 2 {
    const slot = (off - 2) / 3 + 1
    if slot < cloSigTagNames.length { return "clo:" + cloSigTagNames[slot] }
  }
  "?:" + i32ToStr(t)
}
