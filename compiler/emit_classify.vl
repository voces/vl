// The `$fnsig` PARAM-spine token for the parameter at `paramIx` — one token per distinct
// param VALTYPE, so two functions share a `$fnsig` exactly when their param valtypes
// byte-match. Mirrors `fbValtype`'s coverage (the functype emitter writes
// `fbValtype(vtKindOfParam, paramStructIdxOf)` for each param) and the annotation-string
// scheme in `annParamKind`. Single-char tokens for the FIXED-valtype kinds (every i32 /
// string / closure / list param has an identical valtype); the struct-table index is
// appended (delimited by `;`) for the per-shape kinds (struct, nullable struct, ref list).
// "" for a kind still outside the value-call ABI (union box / variant / map param) — that
// keeps the signature un-interned (a clean "no interned signature" rejection at the call /
// value site, never a mis-lowered all-i32 fallback).
function cloParamTok(paramIx: i32) {
  const k = vtKindOfParam(paramIx)
  // The slot-CARRYING kinds append their interned table slot (struct index /
  // variant index / ref-list slot), so two sigs share a `$fnsig` exactly when
  // the param SHAPES match, not just the kind. `nulstruct` carries the SAME
  // struct slot as its non-null twin — `repSigTokHasSlot` names both, and
  // `paramStructIdxOf` resolves a `S | null` annotation to S's row.
  if k == "struct" || k == "variant" || k == "reflist" || k == "nulstruct" {
    return repSigSlotTokOfKind(k, paramStructIdxOf(paramIx))
  }
  // A NULLABLE-closure param (`((i32) => i32) | null`) stays OUTSIDE the value-call ABI
  // (only nullable-closure RESULTS are wired — the closure result carries the niche).
  // `repSigTokOfKind("nulclosure")` yields a RESULT token (`C`), so exclude it explicitly
  // here (like map) — else a nulclosure param would key a slot-less `C` and mis-lower.
  // The soundness floor rejects a nulclosure-param value with a clear message.
  if k == "nulclosure" { return "" }
  // A MAP param stays OUTSIDE the value-call ABI (only map RESULTS are wired — the closure
  // result carries the map shape). `repSigTokOfKind("map")` yields a result token, so
  // exclude it explicitly here — else a map param would key a slot-less `m` and mis-lower.
  // The soundness floor rejects a map-param value with a clear message.
  if k == "map" { return "" }
  // Every slot-free kind reads the shared canonical token table (emit_rep) — "" for the
  // kinds with no token character at all (`nulreflist`, `nulmap`, and the four
  // distinct-backing scalar-list niches), which keeps their signature un-interned so the
  // soundness floor (`emitClosureValue`) rejects the value loudly.
  //
  // The nullable-REF niches that DO have a token — `nulstr` (`N`), `nullist` (`o`), and
  // `nulstruct` (`n<slot>;`) above — are in the ABI at the PARAM position as well as the
  // result one. Their param valtype is exactly the `(ref null …)` the callee's own
  // functype declares (`emitOneFuncType` and `emitSynthCloSig` both stream it through the
  // one `fbValtype` table), so a `call_indirect` through the interned sig passes the
  // engine's signature check and a `null` argument crosses as `ref.null` rather than as a
  // wrong-typed scalar. A nullable ELEMENT read out of a list is the shape that needs
  // this: `xs.map(cb)` over a `(string | null)[]` hands `cb` a `(ref null $aTypeIdx)`, so
  // without a param token there is no `$fnsig` for the loop's `call_indirect` to name.
  repSigTokOfKind(k)
}

// The interning KEY for lifted function `fe`'s env-leading `$fnsig`, or "" when the
// signature is not function-value-eligible (a void / closure-returning function, or a
// param/return kind outside the `cloParamTok` / value-result ABI). The key encodes the
// param kinds (`cloParamTok`) and the return kind, so two functions share one `$fnsig`
// exactly when their env-leading functypes are byte-identical. `fnSigKeyOf` is the
// value-eligible (i32/f64-result) variant; `cloSigKeyExt` extends the RESULT spine.
export function fnSigKeyOf(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return "" }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    let key = ""
    const params = fn.fnParams
    let pi = 0
    while pi < params.length {
      const tok = cloParamTok(params[pi])
      if tok == "" { return "" }
      key = key + tok
      pi = pi + 1
    }
    // KEY/BYTES INTERLOCK. The `$fnsig` functype BYTES are streamed from the key's
    // REPRESENTATIVE function via `cloRetValKind` (emit_sections' type-section rep
    // path), so a KEY coarser than `cloRetValKind` lets two functions with DIFFERENT
    // result reps share one slot — and because `internCloSigKey` keeps the FIRST
    // rep, the loser is declared with the winner's functype: invalid wasm, in
    // ordinary code (`function maybe(n: i32) { if n > 0 { return "yes" } return null }`
    // beside any i32-returning `(i32)` function, or beside a `.map` lambda).
    // `cloRetKindOf` is exactly that coarser answer: it folds the un-annotated
    // `string | null` niche into `"i32"` (its historical flag ladder never consulted
    // `fRetNulStr`), and it does not consult the variant-COLLAPSE that `cloRetValKind`
    // prefers. So the value-ABI key is minted only when the two AGREE; a disagreeing
    // function falls through to `cloSigKeyExt`'s extended spine, which keys the honest
    // token off the SAME `cloRetValKind` the bytes read (`>N` for the nullable string,
    // `>V<idx>;` for the collapsed variant). That is a strict REFINEMENT of the key
    // space: every function whose result really is i32/f64 keys exactly as before, so
    // slots that legitimately shared a functype still share one.
    //
    // HONEST BOUND: `"nulstr"` is the only disagreement with a WITNESS. The
    // variant-collapse arm is covered because the agreement test is cheaper to state
    // than to special-case, not because a program was found that needs it — measured
    // INERT: a probe keying `r == "i32" && vk != "nulstr"` (excluding the niche alone,
    // letting every other disagreement through exactly as before) is byte-identical to
    // this on all 1,418 corpus files and all 326 programs of the result-kind census.
    // Do not read the `>V<idx>;` mention as a second fix.
    const r = cloRetKindOf(fe)
    const vk = cloRetValKind(fe)
    if r == "i32" && vk == "i32" { return key + ">" + repSigTokOfKind("i32") }
    if r == "f64" && vk == "f64" { return key + ">" + repSigTokOfKind("f64") }
    return ""
  }
  ""
}

// The VALUE-ABI return kind of lifted function `fe` for `$fnsig` purposes: `"i32"`
// (i32/boolean), `"f64"`, or `null` (void / closure-returning / any other kind).
// Annotated returns read the annotation; un-annotated ones ride the stored return
// kind, plus a registry-INDEPENDENT f64 tail check (`tailIsF64NoLocal` — the
// general `exprIsF64` consults the per-function locals registry, whose contents
// depend on WHICH function is currently being emitted, so the key must not use it).
export function cloRetKindOf(fe: i32): VKind | null {
  if fe < 0 || fe >= fnStmts.length { return null }
  if fe >= fRetVoid.length { return null }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    if fRetVoid[fe] == 1 { return null }
    if fnReturnsClosure(fe) { return null }
    if fn.fnRet >= 0 {
      const k = vtKindOfType(fn.fnRet)
      if k == "i32" { return "i32" }
      if k == "f64" { return "f64" }
      return null
    }
    // Un-annotated: any inferred ref/i64/f32 kind is out of the value ABI; an f64
    // tail is `"f64"`; everything else (i32 / boolean) rides the i32 result. The
    // `"nulstr"` niche deliberately falls through with `"i32"` — the historical flag
    // ladder here never consulted `fRetNulStr`, so it kept riding the i32 result.
    const irk = fRetKind[fe]
    if irk == "f64" { return "f64" }
    if irk != "i32" && irk != "nulstr" { return null }
    if tailIsF64NoLocal(fnRetExprOf(fnStmts[fe]), fnStmts[fe]) { return "f64" }
    return "i32"
  }
  null
}

// Whether the lifted callback at `fe` returns a STRING — its annotation (`: string`) or the
// inferred `"str"` kind. `cloRetKindOf` folds string into `null` (it is outside the i32/f64
// value ABI), so `.map`/`.filter` consult this separately to pick the string-list result kind.
export function cloRetIsString(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return false }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    if fn.fnRet >= 0 { return nameIsString(tyNameOf(fn.fnRet)) }
    if fe < fRetKind.length { return fRetKind[fe] == "str" }
  }
  false
}

// True when the `.map` callback at `fe` produces an element that rides the STRING LIST — a
// plain `string`, or the `string | null` niche, which share ONE wrapper/backing pair
// (`$mkListIdx` / `$mkArrIdx`, whose element type is already `(ref null $aTypeIdx)` so a
// spare slot defaults to null). The collect-time twin of `mfResultKindOf`'s `"str"` answer,
// and the two must name the same set: a result the emitter picks the string wrapper for
// while the collect flag stayed unforced is `emitProgram: .map/.filter result is string[]
// but string list type not collected`, from a program whose ONLY string list is that result.
export function mfCbResultIsStrList(fe: i32) {
  cloRetIsString(fe) || cloRetValKind(fe) == "nulstr"
}

// Registry-independent f64-ness of a lifted callback's tail expression: float
// literals, f64 PARAMS, f64 arithmetic over those, and f64-returning named calls.
// Deliberately avoids `declaredF64`/`declaredSlotOf` (the locals registry belongs to
// whichever function is currently being emitted), so the answer is STABLE whether
// asked during sig collection or during section emission.
function tailIsF64NoLocal(ix: i32, fnArenaIx: i32) {
  if ix < 0 { return false }
  const e = P.nodes[ix]
  if e is NumLit { return numTextIsFloat(e.numText) }
  if e is Paren { return tailIsF64NoLocal(e.parInner, fnArenaIx) }
  if e is Ident { return paramIsF64(fnArenaIx, e.identName) }
  if e is BinExpr {
    const op = e.binOp
    if op == "+" || op == "-" || op == "*" || op == "/" {
      if tailIsF64NoLocal(e.binLeft, fnArenaIx) { return true }
      return tailIsF64NoLocal(e.binRight, fnArenaIx)
    }
    return false
  }
  if e is Unary {
    if e.unOp == "-" { return tailIsF64NoLocal(e.unArg, fnArenaIx) }
    return false
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const t = fnIndexOfSid(sidOfNode(e.callFn))
      if t >= 0 {
        if t < fRetKind.length { return fRetKind[t] == "f64" }
      }
    }
    return false
  }
  false
}

// The lifted-function position (`fnStmts` index) of an object-literal FIELD
// VALUE that is a function: an inline lambda (`FuncDecl` node — lifted in place,
// so its arena index appears in `fnStmts`) or a bare Ident naming a function.
// -1 for any other field value.
export function fieldValueFeOf(valIx: i32) {
  if valIx < 0 { return -1 }
  const v = P.nodes[valIx]
  if v is FuncDecl { return fnStmtsPosOf(valIx) }
  if v is Ident { return fnIndexOfSid(sidOfNode(valIx)) }
  -1
}

// The historical override-chain PRIORITY of a stored return kind — the position its
// per-family flag held in the deleted `retKindChainOf` ladder (LAST-MATCH won, so a
// higher position overrode a lower one; a struct-UNION return set both the union and
// struct flags, and the later struct arm won). `criSetRetKind` lands a write only when
// it outranks the current kind, so the eager per-fact writes resolve to EXACTLY the
// kind the old post-fixpoint chain snapshot computed. The wide scalars share the top
// tier: they were the chain's final override, and are mutually exclusive with each
// other by the `"i32"`-guarded write sites.
function retKindPri(k: VKind) {
  if k == "str" { return 1 }
  if k == "list" { return 2 }
  if k == "union" { return 3 }
  if k == "struct" { return 4 }
  if k == "nulstruct" { return 5 }
  if k == "reflist" { return 6 }
  if k == "strlist" { return 7 }
  if k == "f64list" { return 8 }
  if k == "i64list" { return 9 }
  if k == "f32list" { return 10 }
  if k == "map" { return 11 }
  if k == "nulstr" { return 12 }
  if k == "i64" { return 13 }
  if k == "f64" { return 13 }
  if k == "f32" { return 13 }
  0
}

// True if `k` is one of the LIST return kinds (the old `fRetListKind != 0`) — the
// shared not-yet-a-list guard of `criClassify`'s list arms.
function retKindIsList(k: VKind) {
  k == "list" ||
    k == "reflist" ||
    k == "strlist" ||
    k == "f64list" ||
    k == "i64list" ||
    k == "f32list"
}

// Store an inferred return-kind FACT for function `i`: the write lands only when it
// outranks the current kind in the historical override-chain priority (`retKindPri`),
// marking the `computeRetInference` fixed point dirty. True exactly when the write
// landed — the struct/nulstruct arms gate their `fRetStructIdx` payload on it.
function criSetRetKind(i: i32, k: VKind) {
  if retKindPri(k) > retKindPri(fRetKind[i]) {
    fRetKind[i] = k
    criChanged = true
    return true
  }
  false
}

// The stored return kind of an ANNOTATED return-type node `tyIx` — the annotation
// flag producers applied in the historical `retKindChainOf` order (LAST-MATCH wins),
// so `buildFnMap`'s seed byte-matches what the old per-flag tables resolved to. An
// i64/f32 LIST annotation never flagged here (those codes were only ever inferred —
// an annotated `i64[]` return rides the typed-IR path), so the producer set is
// deliberately unchanged. A union-VARIANT annotation (`: Cat`) stays `"i32"` with its
// variant index in `fRetStructIdx`, exactly as the flag tables left it.
export function retAnnKindChain(tyIx: i32): VKind {
  let k: VKind = "i32"
  if retStrFlag(tyIx) == 1 { k = "str" }
  const lk = retListKindFlag(tyIx)
  if lk == 2 { k = "list" }
  if retUnionFlag(tyIx) == 1 { k = "union" }
  if retTRFlag(tyIx) == 1 { k = "struct" }
  if retNulRefFlag(tyIx) == 1 { k = "nulstruct" }
  if lk == 5 { k = "reflist" }
  if lk == 7 { k = "strlist" }
  if lk == 12 { k = "f64list" }
  if retMapFlag(tyIx) == 1 { k = "map" }
  if retNulStringFlag(tyIx) == 1 { k = "nulstr" }
  if retI64Flag(tyIx) == 1 { k = "i64" }
  if retF64Flag(tyIx) == 1 { k = "f64" }
  if retF32Flag(tyIx) == 1 { k = "f32" }
  k
}

// The RESULT valtype KIND of a function's return — the stored `fRetKind` slot
// (seeded by `buildFnMap`, refined by `computeRetInference`'s eager writes).
export function inferredRetKindCore(ti: i32): VKind { fRetKind[ti] }

// The RESULT valtype KIND of lifted function `fe`'s `$fnsig` functype — the same kind the
// function's OWN functype emits, read from an annotation (`vtKindOfType`) or the inferred
// stored return kind, so the closure functype byte-matches the callee. -1 for void (0 results)
// and for the kinds still outside the value-call ABI (a ref-list / closure return — `5` /
// `14` are minted by their own paths, not here). The slot (struct index for kinds 1 / 9)
// comes from `cloRetValSlot`.
export function cloRetValKind(fe: i32): VKind | null {
  if fe < 0 || fe >= fnStmts.length { return null }
  if fe >= fRetVoid.length { return null }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    if fRetVoid[fe] == 1 { return null }
    if fn.fnRet >= 0 {
      if tyIsFuncType(fn.fnRet) { return "closure" }
      return vtKindOfType(fn.fnRet)
    }
    if fnReturnsClosure(fe) { return "closure" }
    // An implicit return that is an ASSIGNMENT yields the target CELL (`fnAssignRetKind`).
    // Consulted HERE, ahead of the variant-collapse arm, so the `$fnsig` functype and the
    // function's own functype are minted from ONE fact: a lambda `() => { g = {m: 2} }`
    // over a union global otherwise had `cbRetVariantIdx` name the collapsed VARIANT here
    // while `emitTypeSection` emitted the union BOX — two functypes for one function, and
    // invalid wasm at the `call_ref`.
    const cloArk = fnAssignRetKind(fe)
    if cloArk != null { return cloArk }
    // A callback that COLLAPSES to one concrete variant (`(a) => if a is Cat { a } else {
    // catShape }`) — the checker types it as that variant, so the `$fnsig` result is the
    // variant struct (kind 8), NOT the union box. Checked BEFORE the `"union"` kind, which
    // the emitter's syntactic inference also stores for the narrowed receiver arm.
    if cbRetVariantIdx(fe) >= 0 { return "variant" }
    // The shared inferred-return-kind mapping (the SAME one the named-function functype result
    // uses) — so a scalar/list/ref kind added there is reflected here too. The closure-specific
    // cases (closure / variant-collapse above; the `tailIsF64NoLocal` backup below) are layered
    // around it.
    const core = inferredRetKindCore(fe)
    if core != "i32" { return core }
    // An f64 tail with no intervening local (a `.map`/`.filter` callback `n => n * 2.0`)
    // — its f64-ness is detected structurally, not via `fRetF64` (mirrors the old
    // `cloRetKindOf`; without this the callback's functype declared i32 over an f64 body).
    if tailIsF64NoLocal(fnRetExprOf(fnStmts[fe]), fnStmts[fe]) { return "f64" }
    return "i32"
  }
  null
}

// The struct-table slot for `fe`'s result valtype — a real index only for a struct (kind
// 1) or nullable-struct (kind 9) return, `-1` otherwise.
export function cloRetValSlot(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return -1 }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    if fn.fnRet >= 0 {
      const k = vtKindOfType(fn.fnRet)
      if k == "struct" || k == "nulstruct" { return retStructIndex(fn.fnRet) }
      // A `: Cat` annotated variant result (kind 8) — the slot is the VARIANT index.
      if k == "variant" { return variantIndexOf(tyNameOf(fn.fnRet)) }
      // A `: S[]` / `: ((i32) => i32)[]` annotated REF-LIST result (kind 5) — the slot is the
      // ref-list slot (`rlWrapIdx`-bearing), the dual of a `cloParamTok` kind-5 param's slot.
      if k == "reflist" { return tyAnnRefListSlot(fn.fnRet) }
      // A `: {[string]: V}` annotated MAP result (kind 6) — the slot is the map SHAPE (mono ⇒
      // -1, or the value type's mv slot), so the `$fnsig` result selects THIS map's `$mapStruct`.
      if k == "map" { return mapAnnShape(fn.fnRet) }
      return -1
    }
    // The SLOT half of `cloRetValKind`'s assignment-cell arm, read from the same cell —
    // ahead of the variant-collapse slot for the same reason the kind is.
    if fnAssignRetKind(fe) != null { return fnAssignRetSlot(fe) }
    // A collapsed-to-one-variant inferred result (kind 8) — the variant index.
    const cvi = cbRetVariantIdx(fe)
    if cvi >= 0 { return cvi }
    const srk = fRetKind[fe]
    if srk == "struct" { return fRetStructIdx[fe] }
    if srk == "nulstruct" { return fRetStructIdx[fe] }
    // An INFERRED map return (`() => (h)` over a captured/local map) — the map SHAPE from the
    // return expression (`mapRetExprShape`, capture-aware), so the `$fnsig` result matches the
    // returned map value's typed `$mapStruct`.
    if srk == "map" {
      const mrx = fnRetExprOf(fnStmts[fe])
      if mrx >= 0 { return mapRetExprShape(mrx, fe) }
    }
    // An inferred ref-list return (`() => [{…}]` / `() => [(x) => …]`, kind 5) — its element
    // NAME (`fRetRArrElem`, set by the return-classify scan) resolves the ref-list slot.
    if srk == "reflist" { return rlSlotByName(fRetRArrElem[fe]) }
  }
  -1
}

// The `>X` RESULT suffix of `fe`'s extended `$fnsig` key — one token per distinct result
// functype shape, so two functions share a sig iff their params AND result byte-match.
// Mirrors `cloRetValKind`: `>i`/`>d`/`>I` scalars, `>S` string, `>a`/`>A`/`>D` the i32/
// string/f64 lists, `>u` a union box, `>N` `string | null`, `>sN;`/`>nN;` a struct /
// nullable-struct. "" for the kinds not yet value-callable (a `>v` void is handled by the
// caller; ref-list `5` and closure `14` returns are a later slice).
function cloRetKeySuffix(fe: i32) {
  const k = cloRetValKind(fe)
  // The slot-CARRYING result kinds: a struct / nullable-struct result keyed by
  // its struct index, a concrete-VARIANT result by its variant index — so two
  // callbacks share a sig iff they return the SAME shape.
  if k == "struct" || k == "nulstruct" || k == "variant" {
    return ">" + repSigSlotTokOfKind(k, cloRetValSlot(fe))
  }
  // A MAP result carries its map SHAPE slot (`cloRetValSlot` → the mv slot; mono = -1), so
  // two map-returning closures share a `$fnsig` exactly when their value types match, and the
  // `$fnsig` result `(ref $mapStruct)` selects THIS map's struct — the heap type the returned
  // map value and the closure's env field both carry. Makes a map-returning closure
  // representable (a non-empty key) instead of tripping the soundness floor.
  if k == "map" { return ">" + repSigSlotTokOfKind(k, cloRetValSlot(fe)) }
  // A REF-LIST result (`S[]` / `((i32) => i32)[]` / a union list): the `$fnsig`
  // result is the ref-list WRAPPER ref (slot = `cloRetValSlot`), recovered
  // non-null at the value-call site like every other ref result — the result
  // dual of the `r<idx>;` PARAM token. No resolved slot → no sig.
  if k == "reflist" {
    const rs = cloRetValSlot(fe)
    if rs >= 0 { return ">" + repSigSlotTokOfKind(k, rs) }
    return ""
  }
  // Every slot-free kind reads the shared canonical token table (emit_rep):
  // the scalars, string, the i32/string/f64 list wrappers, the union box, the
  // `string | null` niche, and a CLOSURE result (a function returning a
  // function — the shared fat-pointer, so a curried lambda lowers as a
  // callable value). "" (no sig) for the kinds still outside the value ABI —
  // and for a void/unresolved result (`null`), which the CALLER key-builds
  // as `>v` before consulting this suffix.
  const t = repSigTokOfKind(k)
  if t == "" { return "" }
  ">" + t
}

// The EXTENDED `$fnsig` key of lifted function `fe`: `fnSigKeyOf`'s key when the sig is
// value-eligible, else the same param spine with the extended RESULT suffix
// (`cloRetKeySuffix`) — void, the i32/string/f64 lists, a union box, a nullable scalar/
// struct, a struct ref. "" when any param OR the result kind is still outside the ABI.
export function cloSigKeyExt(fe: i32) {
  const base = fnSigKeyOf(fe)
  if base != "" { return base }
  if fe < 0 || fe >= fnStmts.length { return "" }
  if fe >= fRetVoid.length { return "" }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    const params = fn.fnParams
    let key = ""
    let pi = 0
    while pi < params.length {
      const tok = cloParamTok(params[pi])
      if tok == "" { return "" }
      key = key + tok
      pi = pi + 1
    }
    if fRetVoid[fe] == 1 { return key + ">v" }
    const suf = cloRetKeySuffix(fe)
    if suf == "" { return "" }
    return key + suf
  }
  ""
}

// The lifted-function position of the closure held by FIELD `prop` of struct
// `si`, resolved through the object LITERAL(s) that intern shape `si` — every
// literal of one shape carries sig-identical closures (monomorphized instances
// included), so the first match types the call. -1 when no literal of shape
// `si` sets a function-valued `prop`.
function fieldClosureFeOf(si: i32, prop: string) {
  if si < 0 { return -1 }
  let ai = 0
  while ai < P.nodes.length {
    const an = P.nodes[ai]
    if an is ObjLit {
      if structIndexOfObj(ai) == si {
        const ffe = fieldValueFeOf(objFieldVal(ai, prop))
        if ffe >= 0 { return ffe }
      }
    }
    ai = ai + 1
  }
  -1
}

// The lifted-function position of the closure a member call `recv.prop(...)`
// dispatches to, resolved as precisely as possible: first by following the
// RECEIVER to the literal that built it (a `const o = make(...)` whose maker
// returns an object literal — so two same-shaped receivers from different
// monomorphized makers each resolve their OWN closure), else by the receiver's
// struct SHAPE (`fieldClosureFeOf`). -1 when neither resolves.
export function fieldClosureFeOfRecv(recvIx: i32, prop: string, fnIx: i32) {
  const e = P.nodes[unwrapParen(recvIx)]
  if e is Ident {
    let li = -1
    if fnIx >= 0 {
      const fn = P.nodes[fnIx]
      if fn is FuncDecl { li = parentLetOf(fn.fnBody, e.identName) }
    }
    if li < 0 { li = globalLetOf(e.identName) }
    if li >= 0 {
      const d = P.nodes[li]
      if d is LetDecl {
        const ffe = fieldClosureFeOfInit(d.letInit, prop)
        if ffe >= 0 { return ffe }
      }
    }
  }
  if e is Call {
    const ffe2 = fieldClosureFeOfInit(unwrapParen(recvIx), prop)
    if ffe2 >= 0 { return ffe2 }
  }
  fieldClosureFeOf(structIndexOfExpr(recvIx, fnIx), prop)
}

// The MAKER function (`fnStmts` position) whose tail object literal built the
// receiver expression at `recvIx`: a direct `make(...)` call, or an ident bound
// (let/global) to one. -1 when the receiver's origin is not a maker call.
function recvMakerFnOf(recvIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(recvIx)]
  let initIx = unwrapParen(recvIx)
  if e is Ident {
    let li = -1
    if fnIx >= 0 {
      const fn = P.nodes[fnIx]
      if fn is FuncDecl { li = parentLetOf(fn.fnBody, e.identName) }
    }
    if li < 0 { li = globalLetOf(e.identName) }
    if li < 0 { return -1 }
    const d = P.nodes[li]
    if d is LetDecl { initIx = unwrapParen(d.letInit) } else { return -1 }
  }
  const ie = P.nodes[initIx]
  if ie is Call {
    const callee = P.nodes[ie.callFn]
    if callee is Ident { return fnIndexOfSid(sidOfNode(ie.callFn)) }
  }
  -1
}

// The annotation NAME of parameter `name` of the lifted function at `fe` ("" if
// not a param / un-annotated).
function feParamTyName(fe: i32, name: string) {
  if fe < 0 || fe >= fnStmts.length { return "" }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    const params = fn.fnParams
    let i = 0
    while i < params.length {
      const p = P.nodes[params[i]]
      if p is Param {
        if p.parName == name { return tyNameOf(p.parType) }
      }
      i = i + 1
    }
  }
  ""
}

// BOOLEAN-ness of a field-closure trap call `recv.prop(...)`. Monomorphized
// maker instances SHARE the closure body, so the closure's own inferred return
// kind cannot distinguish `wrap(true)` from `wrap(99)` — instead, follow the
// receiver to ITS maker instance and read the closure's tail through the
// instance's pinned param annotations (`function(_k) x` with the instance's
// `x: boolean` → true). Falls back to the shared closure's `fRetBool`.
function fieldCloCallIsBool(recvIx: i32, prop: string, fnIx: i32) {
  const mk = recvMakerFnOf(recvIx, fnIx)
  if mk >= 0 {
    const rx = fnRetExprOf(fnStmts[mk])
    if rx >= 0 {
      const re = P.nodes[unwrapParen(rx)]
      if re is ObjLit {
        const v = objFieldVal(unwrapParen(rx), prop)
        if v >= 0 {
          const vf = P.nodes[v]
          if vf is FuncDecl {
            const vRet = vf.fnRet
            if vRet >= 0 { return tyNameOf(vRet) == "boolean" }
            const tx = fnRetExprOf(v)
            if tx >= 0 {
              const te = P.nodes[unwrapParen(tx)]
              if te is Ident {
                const ptn = feParamTyName(mk, te.identName)
                if ptn != "" { return ptn == "boolean" }
              }
              return exprIsBool(tx, v)
            }
          }
        }
      }
    }
  }
  const bfe = fieldClosureFeOfRecv(recvIx, prop, fnIx)
  if bfe >= 0 {
    const bfn = P.nodes[fnStmts[bfe]]
    if bfn is FuncDecl {
      if bfn.fnRet >= 0 { return tyNameOf(bfn.fnRet) == "boolean" }
    }
    if bfe < fRetBool.length { return fRetBool[bfe] == 1 }
  }
  false
}

// Resolve `prop`'s closure through an INITIALIZER expression: an object literal
// reads its own field; a call to a maker follows the maker's return expression
// (its tail object literal). -1 otherwise.
function fieldClosureFeOfInit(initIx: i32, prop: string) {
  if initIx < 0 { return -1 }
  const e = P.nodes[unwrapParen(initIx)]
  if e is ObjLit {
    return fieldValueFeOf(objFieldVal(unwrapParen(initIx), prop))
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const t = fnIndexOfSid(sidOfNode(e.callFn))
      if t >= 0 {
        const rx = fnRetExprOf(fnStmts[t])
        if rx >= 0 {
          const re = P.nodes[unwrapParen(rx)]
          if re is ObjLit {
            return fieldValueFeOf(objFieldVal(unwrapParen(rx), prop))
          }
        }
      }
    }
  }
  -1
}

// The position of `key` in `cloSigKeys`, or -1.
export function cloSigPosOfKey(key: string) {
  let i = 0
  while i < cloSigKeys.length {
    if cloSigKeys[i] == key { return i }
    i = i + 1
  }
  -1
}

// The `$fnsig` type index for lifted function `fe`'s own signature, or -1 when its
// signature is not value-eligible / not interned. The EXTENDED key (`cloSigKeyExt`)
// equals the value-ABI key for an eligible sig; a void / struct-returning FIELD
// closure resolves its interned `>v`/`>sN;` sig (so its function-section type IS
// that `$fnsig` and the trap call site's `ref.cast` accepts it); any other
// non-eligible sig stays -1 (its ext key is never interned).
export function fnSigIdxOfFn(fe: i32) {
  const key = cloSigKeyExt(fe)
  if key == "" { return -1 }
  const p = cloSigPosOfKey(key)
  if p < 0 { return -1 }
  cloSigBase + p
}

// The type index of the all-i32 `$fnsig` functype for value-call arity `ar`
// (`(structref, i32 * ar) -> i32`) — the signature every GENERIC value call (a
// let-bound / param / field closure `f(args)`) dispatches through. -1 if not interned.
export function fnSigIdxForArity(ar: i32) {
  let key = ""
  let i = 0
  while i < ar {
    key = key + repSigTokOfKind("i32")
    i = i + 1
  }
  const p = cloSigPosOfKey(key + ">" + repSigTokOfKind("i32"))
  if p < 0 { return -1 }
  cloSigBase + p
}

// The wasm global index for the symbol `sid`, or -1 if no top-level global has that
// name. A bounds check plus a load (R6) — `collectFns` interned every global's name
// when it built the array, so a sid beyond its end is a name that is not a global.
export function globalIndexOfSid(sid: i32) { sidArrGet(globalIndexBySid, sid) }

// The wasm global index for `name`, or -1 if no top-level global has that name.
// The STRING form: one `sidLookup` probe, exactly what the `{[string]: i32}` map
// probe it replaces cost — so this shape is a WASH and is kept only for the call
// sites that hold no arena index. Every hot caller takes the sid form above.
export function globalIndexOf(name: string) {
  sidArrGet(globalIndexBySid, sidLookup(name))
}

// The arena index of the `LetDecl` for the global symbol `sid`, or -1.
export function globalLetOfSid(sid: i32) {
  const gi = sidArrGet(globalIndexBySid, sid)
  if gi < 0 { return -1 }
  globalStmts[gi]
}

// The arena index of the `LetDecl` for the global `name`, or -1 if not a global.
export function globalLetOf(name: string) { globalLetOfSid(sidLookup(name)) }

// Whether the global `name` is a struct/array/string ref (so a bare reference to it in
// an `exprStruct`/`exprArray`/`exprString` check is recognized as that ref type). The
// global's valtype follows its `LetDecl` annotation or literal initializer, evaluated as
// a top-level constexpr (`fnIx = -1`), mirroring the local `letIsX` predicates.
function globalIsStructSid(sid: i32) {
  const li = globalLetOfSid(sid)
  if li < 0 { return false }
  letIsStruct(li, -1)
}

function globalIsArraySid(sid: i32) {
  const li = globalLetOfSid(sid)
  if li < 0 { return false }
  // A kind-18 NULLABLE REF-ARRAY cell is never the i32 list, whatever `letIsArray`
  // says. `letIsArray` falls through to the INITIALIZER when the annotation is not
  // an i32 array, and an EMPTY `[]` initializer answers "i32 list" (it has no
  // element to classify) — so `let g: S[] | null = []` read as an i32 list while
  // its cell was the ref-list wrapper. A LOCAL never hits this: `buildLocals` files
  // it under `declaredKind == "nulreflist"` once and the init is never re-consulted;
  // only a global re-derives its kind per read, which is where the init leaks in.
  if globalIsNulRefArraySid(sid) { return false }
  letIsArray(li, -1)
}

// True if the module global `name` holds a kind-18 NULLABLE REF-ARRAY cell
// (`let g: S[] | null`) — the storage-class twin of `declaredKind(name) ==
// "nulreflist"` (local) and `paramNulRefArray` (param). Keyed on `globalCellKind`
// — the CELL's own answer — so a read can never disagree with the cell, exactly as
// `exprNullableRefArray`'s global arm is keyed.
function globalIsNulRefArraySid(sid: i32) {
  const li = globalLetOfSid(sid)
  if li < 0 { return false }
  globalCellKind(li) == "nulreflist"
}

// True if a READ of the module global `name` leaves a NULLABLE list ref on the stack:
// its cell is one of the nullable LIST kinds — 15 (`i32[] | null`), 18 (`S[] | null`,
// `i32[][] | null`) and the four distinct-backing scalar niches. The Ident→global read
// deliberately withholds the eager `ref.as_non_null` for exactly these kinds (the
// `!= null` compare has to see the raw cell), so a consumer that stages the receiver
// into a NON-null frame slot must recover it itself.
export function globalNulListCellRead(name: string) {
  const li = globalLetOf(name)
  if li < 0 { return false }
  const k = globalCellKind(li)
  if k == "nullist" { return true }
  if k == "nulreflist" { return true }
  isNulScalarListKind(k)
}

function globalIsStringSid(sid: i32) {
  const li = globalLetOfSid(sid)
  if li < 0 { return false }
  // A `string | null` (kind 16) global reads AS a string under narrowing — the global
  // read recovers non-null (`ref.as_non_null`), and the `!= null` check reads it raw.
  letIsString(li, -1) || letIsNulString(li, -1)
}

function globalIsRefArraySid(sid: i32) {
  const li = globalLetOfSid(sid)
  if li < 0 { return false }
  letIsRefArray(li, -1)
}

function globalIsStringArraySid(sid: i32) {
  const li = globalLetOfSid(sid)
  if li < 0 { return false }
  letIsStringArray(li, -1)
}

function globalIsMapSid(sid: i32) {
  const li = globalLetOfSid(sid)
  if li < 0 { return false }
  letIsMap(li, -1)
}

function globalIsF64ArraySid(sid: i32) {
  const li = globalLetOfSid(sid)
  if li < 0 { return false }
  letIsF64Array(li, -1)
}

function globalIsNulRefSid(sid: i32) {
  const li = globalLetOfSid(sid)
  if li < 0 { return false }
  letIsNulRef(li, -1)
}

function globalIsNulListSid(sid: i32) {
  const li = globalLetOfSid(sid)
  if li < 0 { return false }
  // `letIsNulListInfer`, not the annotation-only `letIsNulList`: an UN-annotated global
  // bound to a nullable-list producer (`const g = mk()` with `mk(): i32[] | null`, a
  // code-18 field read `const g = s.rest`, another kind-15 global) carries the kind-15
  // cell too — `globalCellKind`'s un-annotated arm uses the SAME predicate, so the read
  // and the cell agree by construction. (Master's read side saw only the annotation, so
  // `g != null` over such a global rejected the module and `g[i]` mistyped it.)
  letIsNulListInfer(li, -1)
}

// True if the parameter `name` of function `fnIx` is a nullable struct (`S | null`).
function paramNulRef(fnIx: i32, name: string) {
  retNulRefFlag(paramTypeNode(fnIx, name)) == 1
}

// True if the parameter `name` of function `fnIx` is a NULLABLE map (`{[string]: V} | null`,
// kind `nulmap`). The map twin of `paramNulRef`/`paramNulRefArray`.
export function paramNulMap(fnIx: i32, name: string) {
  retNulMapFlag(paramTypeNode(fnIx, name)) == 1
}
// True if the global `name` is a NULLABLE map.
function globalIsNulMapSid(sid: i32) {
  const li = globalLetOfSid(sid)
  if li < 0 { return false }
  letIsNulMap(li, -1)
}

// True if the function `name` returns a nullable struct (`"nulstruct"`).
function fnRetNulRefSid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "nulstruct"
}

// True if the `LetDecl` at `letIx` declares a nullable-struct local: its annotation
// is `S | null`, OR its initializer produces one (a nullable-returning call).
export function letIsNulRef(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      if retNulRefFlag(d.letType) == 1 { return true }
    }
    return exprNullableStruct(d.letInit, fnIx)
  }
  false
}

// The NULLABLE local VKind a bare `const t = m[k]` read of a LIST- or nested-MAP-valued
// map binds (`{[string]: i32[]}` → `nullist`, `{[string]: S[]}` → `nulreflist`,
// `{[string]: {[string]: V}}` → `nulmap`, …), or null when the init is not such a read.
// The read yields `V | null` — the `(ref null $wrapper)` vals element — and every target
// kind is an ESTABLISHED nullable local (`i32[] | null` bindings, `{[string]:V} | null`
// bindings) whose narrow/read machinery already lowers; this arm only routes the map-read
// spelling onto them. Previously the whole kind-6 family was SUPPOSED to hit the
// `letBareUnwiredNulMapRead` loud reject, but the guard's slot resolution missed some
// receivers and the binding fell through the ladder to a MIS-KINDED local — INVALID-WASM
// (`{[string]: {[string]: i32}}` bare read, R1 map-composition survey 2026-07-22).
export function letNulMapReadValKind(letIx: i32, fnIx: i32): VKind | null {
  const d = P.nodes[letIx]
  if !(d is LetDecl) { return null }
  if d.letType >= 0 { return null }
  if d.letInit < 0 { return null }
  const mrs = mapReadMvSlot(d.letInit, fnIx)
  if mrs < 0 { return null }
  if mvValKind[mrs] != 6 { return null }
  const lvk = mvListValKind(mrs)
  if lvk == "list" { return "nullist" }
  if lvk == "strlist" { return "nulstrlist" }
  if lvk == "f64list" { return "nulf64list" }
  if lvk == "i64list" { return "nuli64list" }
  if lvk == "f32list" { return "nulf32list" }
  if lvk == "reflist" { return "nulreflist" }
  // A NESTED-map value (`{[string]: {[string]: V}}` — vals element kind 3, the inner
  // map struct): the read binds the nullable-map local.
  if rlElemKindTbl[mvRlSlot[mrs]] == 3 { return "nulmap" }
  null
}

// The `addLocalName` SLOT argument for a `letNulMapReadValKind` binding: the INNER
// ref-list slot for a `nulreflist` (the value's element slot — the same resolution the
// `?? []` default hint uses), the inner map's SHAPE slot for a `nulmap` (mono ⇒ -1),
// -1 for the scalar-backed list kinds (their wrappers are global singletons).
export function letNulMapReadSlotArg(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if !(d is LetDecl) { return -1 }
  const mrs = mapReadMvSlot(d.letInit, fnIx)
  if mrs < 0 { return -1 }
  if mvListValKind(mrs) == "reflist" { return mvValInnerRlSlot(mrs) }
  if rlElemKindTbl[mvRlSlot[mrs]] == 3 { return mvValInnerMvSlot(mrs) }
  -1
}

// True if the `LetDecl` at `letIx` is a bare `const t = m[k]` read of a UNION-valued
// map (mv kind 2). The read is `V | null`, and the established local rep for a
// `A | B | null` value is the SHARED BOX itself (kind `"union"`) with `null` riding as
// the null-tagged atom (`scalarTagOf("null")` — `emitUnionCoerce`'s NullLit arm), so
// the binding is the non-null `(ref $uBoxIdx)` cell: the hit arm stores the map's
// stored box, the miss arm synthesizes the null-tagged box (`emitLetDeclStmt`'s
// map-read arm), and the `!= null` / `is` narrow machinery lowers unchanged. Gated to
// un-annotated bindings — an annotation drives the kind explicitly. Replaces the
// former `letBareUnwiredNulMapRead` loud reject (the last unwired bare-read family).
export function letNulMapReadUnionBox(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return false }
    const mrs = mapReadMvSlot(d.letInit, fnIx)
    if mrs >= 0 { return mvValKind[mrs] == 2 }
  }
  false
}

// True if evaluating the expression at `exprIx` yields a NULLABLE i32-list ref —
// a nullable-list-annotated param/local/global reference or a `rest: i32[]|null`
// FIELD read (code 18). The nullable-LIST dual of `exprNullableStruct`: list-op
// read sites consult it to insert the `ref.as_non_null` recover (the checker
// proved every such read guarded, so the cast can never trap).
export function exprNullableList(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Paren { return exprNullableList(e.parInner, fnIx) }
  if e is Ident {
    if paramNulList(fnIx, e.identName) { return true }
    if declaredNulList(e.identName) { return true }
    // A CAPTURED `i32[] | null`: the env field is the same `(ref null $lTypeIdx)` cell — the
    // list twin of the `nulstr` capture arm, and the fourth storage class this arm lacked.
    if capturedKindOf(fnIx, e.identName) == "nullist" { return true }
    return globalIsNulListSid(sidOfNode(exprIx))
  }
  if e is Member { return memberFieldCode(exprIx, fnIx) == 18 }
  // Indexing a `(i32[] | null)[]` (a kind-4 ref list whose element slot keeps the `| null`) yields a
  // NULLABLE i32 list — the read left it `(ref null $lTypeIdx)`, so `const t = xs[i]; if t != null` narrows.
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemNullable.length {
        if rlElemKindTbl[slot] == 4 && rlElemNullable[slot] == 1 { return true }
      }
    }
  }
  // A call to a function whose ANNOTATED return is `i32[] | null` yields a nullable list, so an
  // un-annotated `const r = f(…)` infers kind 15 (and narrows with `if r != null`). Mirrors the
  // niche-nullable call inference for bool/string returns.
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const target = fnIndexOfSid(sidOfNode(e.callFn))
      if target >= 0 {
        const fn = P.nodes[fnStmts[target]]
        if fn is FuncDecl {
          if fn.fnRet >= 0 { return retNulListFlag(fn.fnRet) == 1 }
        }
      }
      // A closure-VALUE call (`v()` with `v: () => boolean[] | null` — a binding or a
      // param) whose resolved sig result is the nullable i32-backed list (`>o`), so an
      // un-annotated `const t0 = v()` infers kind 15 and narrows with `if t0 != null`.
      return calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "nullist"
    }
  }
  // `p ?? d` over the SAME niche stays `i32[] | null` exactly when the default can still be
  // null — the CONSUMER half of `emitCoalesce`'s nullable-collection arm. (`exprArray` claims
  // the rep in BOTH halves; only the NULLABILITY is this classifier's question.)
  const nlLhs = coalesceNicheLhs(exprIx)
  if nlLhs >= 0 {
    if exprNullableList(nlLhs, fnIx) {
      return coalesceNicheStaysNullable(exprIx, fnIx)
    }
  }
  false
}

// True if `exprIx` yields a NULLABLE REF-ARRAY (`i32[][] | null` etc., LOCAL kind 18) — the ref-array
// analogue of `exprNullableList`. An `Index` over a `(<ref-array> | null)[]` (a kind-9 ref list whose
// element slot keeps the `| null`) reads `(ref null $innerWrapper)`, so `const t = xs[i]; if t != null`.
export function exprNullableRefArray(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Paren { return exprNullableRefArray(e.parInner, fnIx) }
  if e is Ident {
    if declaredKind(e.identName) == "nulreflist" { return true }
    // A nulreflist PARAM (`p: i32[][] | null`) — its `!= null` narrow reads the `(ref null $wrapper)`
    // niche exactly like the local. (#877 wired the param signature but left this body-side arm.)
    if paramNulRefArray(fnIx, e.identName) { return true }
    // A module-GLOBAL kind-18 cell (`const g: S[] | null = …`) — the third storage class, and
    // the one arm this function never grew: every consumer (`g != null`, `g[i]`, an
    // un-annotated `const t = g`) fell through to the non-nullable path and the bare `null`
    // of the compare reached `emitNullLitNode` with no context, rejecting the module.
    //
    // Keyed on `globalCellKind` — the CELL's own answer — not on `letIsNulRefArray`, so the
    // read and the cell can never disagree. The distinction is load-bearing for an
    // UN-ANNOTATED global (`const g = mk()` with `mk(): S[] | null`): `letIsNulRefArray`
    // would claim it through its initializer while `globalCellKind`'s un-annotated arm still
    // hands the cell a different kind (the inner-wrapper slot `emitGlobalSection` needs comes
    // from `letAnnRefListSlot`, which has no annotation to read), and that disagreement turns
    // today's loud reject into INVALID WASM. Filed instead; see the PR body.
    const gnra = globalLetOf(e.identName)
    if gnra >= 0 { return globalCellKind(gnra) == "nulreflist" }
    return false
  }
  // A `recv.f` read of a NULLABLE ref-list FIELD (`f: S[] | null`, code 28) yields a nullable ref array.
  if e is Member { return memberFieldCode(exprIx, fnIx) == 28 }
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemNullable.length {
        if rlElemKindTbl[slot] == 9 && rlElemNullable[slot] == 1 { return true }
      }
    }
  }
  // A call to a function whose ANNOTATED return is `<ref-array> | null` yields a nullable ref array, so an
  // un-annotated `const t = mk(…)` infers kind 18 and narrows with `if t != null`. Mirrors the nullable-i32
  // -list call inference in `exprNullableList` above.
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if fnRetNulRefArrayNameSid(sidOfNode(e.callFn)) != "" { return true }
    }
  }
  // `p ?? d` over the SAME niche stays `<ref-array> | null` exactly when the default can still
  // be null — the CONSUMER half of `emitCoalesce`'s nullable-collection arm for the REF-array
  // family. (`exprRefArray` claims the rep in both halves.)
  const nraLhs = coalesceNicheLhs(exprIx)
  if nraLhs >= 0 {
    if exprNullableRefArray(nraLhs, fnIx) {
      return coalesceNicheStaysNullable(exprIx, fnIx)
    }
  }
  false
}

// The INNER ref-list slot of a nullable ref-array expression — a kind-18 LOCAL stores it in
// `localStructIdx`; an `Index` `v[i]` over a `(<ref-array> | null)[]` resolves it from the kind-9 element
// (its inner = `refArrElemName` of the element name, which recurses through the `| null`).
function nulRefArrayInnerSlot(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[exprIx]
  if e is Paren { return nulRefArrayInnerSlot(e.parInner, fnIx) }
  if e is Ident {
    const sl = declaredSlotOf(e.identName)
    if sl >= 0 { return localStructIdx[sl] }
    // A nulreflist PARAM has no local slot — resolve its inner ref-list slot from the
    // annotation's interned row, so `p[i]` and `const t = p` agree.
    if paramNulRefArray(fnIx, e.identName) {
      // The param annotation's inner ref-list ROW — the READ counterpart of
      // `nulRefArrayInnerSlotOfLet`'s local store, so a `p[i]` read and a `const t = p`
      // binding keep resolving the same row.
      return annNulRefArrSlot(paramTypeNode(fnIx, e.identName))
    }
    // A kind-18 module GLOBAL has no local slot either — resolve its inner ref-list row from
    // the SAME place `emitGlobalSection` gives the cell its `(ref null …)` valtype and the
    // start fn seeds its null with (`letAnnRefListSlot`), so an un-annotated `const t = g`
    // binding stores the wrapper the cell actually holds. Without it the binding took slot
    // -1 and the read-back mismatched the cell.
    const gnris = globalLetOf(e.identName)
    if gnris >= 0 {
      if globalCellKind(gnris) == "nulreflist" {
        return letAnnRefListSlot(gnris)
      }
    }
    return -1
  }
  // A code-28 nullable ref-list field member: its element ref-list slot (the field's element name).
  if e is Member {
    if memberFieldCode(exprIx, fnIx) == 28 {
      return refListSlotOfExpr(exprIx, fnIx)
    }
    return -1
  }
  if e is Index {
    const slot = refListSlotOfExpr(e.idxArr, fnIx)
    if slot >= 0 && slot < rlElemName.length { return rlElemInnerSlot(slot) }
  }
  // A nulreflist-returning CALL (`const t = mk()`): its inner ref-list slot is the return's inner element.
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const rn = fnRetNulRefArrayNameSid(sidOfNode(e.callFn))
      if rn != "" { return rlSlotByName(rn) }
    }
  }
  // `p ?? d` over the SAME niche yields the LHS place's inner ref list — so an INFERRED
  // `const v = p ?? q` stores the very row `emitCoalesce` declared its block type from.
  // Without it the binding took slot -1 and `fbValtypeNullable` had no shape to name
  // (`emitProgram: ref valtype with no interned shape`).
  const nriLhs = coalesceNicheLhs(exprIx)
  if nriLhs >= 0 { return nulRefArrayInnerSlot(nriLhs, fnIx) }
  -1
}

// Binding test for a kind-18 nullable ref-array local: annotation `<ref-array> | null`, else an
// un-annotated init that yields a nullable ref array.
export function letIsNulRefArray(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // The nullable annotation's inner element ROW — the READ counterpart of
        // `nulRefArrayInnerSlotOfLet`'s slot (both must agree on which bindings are kind 18).
        if annNulRefArrSlot(d.letType) >= 0 { return true }
      }
      return false
    }
    return exprNullableRefArray(d.letInit, fnIx)
  }
  false
}

// The inner ref-list slot to store for a kind-18 binding — from its annotation (`<ref-array> | null` →
// the ref-array's element slot) or its initializer.
export function nulRefArrayInnerSlotOfLet(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // The annotation's inner ref-list ROW — the WRITE half of the kind-18 pair whose
        // READ is `nulRefArrayInnerSlot`.
        return annNulRefArrSlot(d.letType)
      }
      return -1
    }
    return nulRefArrayInnerSlot(d.letInit, fnIx)
  }
  -1
}

// Annotation-OR-init nullable-i32-list test for a BINDING: the annotation (`letIsNulList`), else an
// UN-ANNOTATED `const t = <nullable-i32-list expr>` — e.g. a code-18 field read `const t = v.f` where
// `v.f: i32[] | null`. Without the init inference such a binding took a non-null list kind, so `t != null`
// emitted a bare `null` with no list context. Mirrors `letIsNulString`'s init fallback for nullable strings.
export function letIsNulListInfer(letIx: i32, fnIx: i32) {
  if letIsNulList(letIx, fnIx) { return true }
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType < 0 { return exprNullableList(d.letInit, fnIx) }
  }
  false
}

// The DISTINCT-backing nullable-scalar-list VKind of a BINDING (`const v: string[]|null = …`), or
// "" — the annotation's `nulScalarListKind`, else an un-annotated init that yields such a list (a
// `string[]|null`-returning call / field read). Feeds the local-slot + null-seed classification.
export function letNulScalarListKind(letIx: i32, fnIx: i32): VKind | null {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return nulScalarListKindOfNode(d.letType) }
    return exprNulScalarListKind(d.letInit, fnIx)
  }
  null
}

// The nullable-scalar-list VKind an EXPRESSION yields (a `string[]|null`-returning call), or "" —
// the per-leaf analogue of `exprNullableList`'s call-inference arm (an un-annotated `const r = f()`).
export function exprNulScalarListKind(exprIx: i32, fnIx: i32): VKind | null {
  if exprIx < 0 { return null }
  const e = P.nodes[exprIx]
  if e is Paren { return exprNulScalarListKind(e.parInner, fnIx) }
  if e is Ident {
    // A nullable-scalar-list PARAM, a same-kind LOCAL (`const t0 = v`), or a GLOBAL cell.
    const pk = nulScalarListKindOfNode(paramTypeNode(fnIx, e.identName))
    if pk != null { return pk }
    const dk = declaredKind(e.identName)
    if isNulScalarListKind(dk) { return dk }
    const gl = globalLetOf(e.identName)
    if gl >= 0 { return letNulScalarListKind(gl, fnIx) }
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const target = fnIndexOfSid(sidOfNode(e.callFn))
      if target >= 0 {
        const fn = P.nodes[fnStmts[target]]
        if fn is FuncDecl {
          if fn.fnRet >= 0 { return nulScalarListKindOfNode(fn.fnRet) }
        }
      }
    }
  }
  // A FIELD read of a nullable distinct-backing scalar list (`s.f` where `f: i64[]|null`,
  // codes 31/32/33/34) yields the leaf's `(ref null $wrapper)` — so an un-annotated
  // `const l = s.f` binds the matching nullable local kind and `l != null` narrows it.
  // The distinct-backing dual of `exprNullableList`'s code-18 Member arm.
  if e is Member { return nulScalarListCodeKind(memberFieldCode(exprIx, fnIx)) }
  // Indexing a `(f64[] | null)[]` (a kind-6/7/8/10 ref list whose element slot keeps the
  // `| null`) yields the NULLABLE leaf list — the read left it `(ref null $wrapper)`, so
  // `const t = xs[i]; if t != null` narrows to the leaf list. The distinct-backing dual
  // of `exprNullableList`'s kind-4 Index arm.
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemNullable.length {
        if rlElemNullable[slot] == 1 {
          const k = rlElemKindTbl[slot]
          if k == 6 { return "nulstrlist" }
          if k == 7 { return "nulf64list" }
          if k == 8 { return "nuli64list" }
          if k == 10 { return "nulf32list" }
        }
      }
    }
  }
  // `p ?? d` over the SAME niche stays the nullable leaf list exactly when the default can
  // still be null — the CONSUMER half of `emitCoalesce`'s nullable-collection arm for the
  // DISTINCT-backing family. (The non-null half is the leaf list, which `exprStringArray` /
  // `exprF64Array` / … claim.)
  const nskLhs = coalesceNicheLhs(exprIx)
  if nskLhs >= 0 {
    if coalesceNicheStaysNullable(exprIx, fnIx) {
      return exprNulScalarListKind(nskLhs, fnIx)
    }
  }
  null
}

// ── nullable-string (`string | null`, kind 16) predicates — the ref-rep analog of
// the nullable-list family above; `null` is `ref.null $aTypeIdx`, `!= null` is
// `ref.is_null`. Unlike a nullable list, an INITIALIZER can produce one (a string
// literal, or a `string | null`-returning call), so `letIsNulString` consults the init.
export function declaredNulString(name: string) {
  declaredKind(name) == "nulstr"
}

function globalIsNulStringSid(sid: i32) {
  const li = globalLetOfSid(sid)
  if li < 0 { return false }
  letIsNulString(li, -1)
}

function fnRetNulStringSid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "nulstr"
}

export function letIsNulString(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      if retNulStringFlag(d.letType) == 1 { return true }
    }
    if d.letType < 0 {
      // An un-annotated `const x = if c then "hi" else null` infers `string | null`
      // (a niche the emitter can't statically derive from the if-expr arms). The
      // CHECKER typed it and exported the binding by node index; consult that first,
      // then fall back to the init-shape probe (a nullable-string param/local/call).
      if isInferLetNulStr(letIx) { return true }
      return exprNullableString(d.letInit, fnIx)
    }
  }
  false
}

// True if evaluating the expression at `exprIx` yields a `string | null` ref — a
// nullable-string param/local/global, or a `: string | null`-returning call. Consulted
// by the `!= null` `ref.is_null` path and the assignment/return/arg null-seeding.
export function exprNullableString(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if fnRetNulStringSid(sidOfNode(e.callFn)) { return true }
      // A `string | null`-returning function VALUE (a binding / `(…) => string | null`
      // param callee) — its result is the nullable raw array, `>N`.
      return calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "nulstr"
    }
    // A `string | null`-returning FIELD-closure call.
    if callee is Member {
      const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if ffe >= 0 { return fRetKind[ffe] == "nulstr" }
    }
    // FALLBACK (scoped to a CALL): a `string | null`-returning closure value call whose callee the
    // cases above miss — an INDEXED closure-array element (`arr[i](x)`). The cheap NO-RENDER
    // `nodeTyIsNullableString` reads the checker's per-node type (the niche-string dual of
    // `exprNullableStruct`'s `nodeTyIsNullableStruct` fallback).
    return nodeTyIsNullableString(exprIx)
  }
  if e is Ident {
    if paramNulString(fnIx, e.identName) { return true }
    if declaredNulString(e.identName) { return true }
    // A CAPTURED `string | null`: the env field is the same `(ref null $array)` cell, so it
    // classifies like the param/local — the arm that reconciles this classifier with
    // `emitCapturedReadRecover`, which recovers the non-null ref off that field under exactly
    // the `pendingRawNullRead` / `pendingNulString` gates the local read uses.
    if capturedKindOf(fnIx, e.identName) == "nulstr" { return true }
    return globalIsNulStringSid(sidOfNode(unwrapParen(exprIx)))
  }
  // A `string | null` struct FIELD read (`a.v`, code 20) yields a nullable string ref.
  if e is Member { return memberFieldCode(exprIx, fnIx) == 20 }
  // A BARE `m[k]` over a STRING-valued map is `string | null` (kind 16) — `emitMapGet` yields the
  // `(ref null)` value unrecovered, the string dual of the bare struct-map read.
  if e is Index {
    const mrs = mapReadMvSlot(exprIx, fnIx)
    if mrs >= 0 { return mvValKind[mrs] == 3 }
    // A `(string | null)[]` element read `p[i]` yields `string | null` — the string-ref niche kept
    // `(ref null $aTypeIdx)` by the dedicated `emitIndex` arm — so `const t = p[i]` binds kind 16 and
    // `t != null` / `p[i] != null` narrows against it.
    if exprNulStrArray(e.idxArr, fnIx) { return true }
  }
  // A chained `a ?? b` over nullable strings is ITSELF nullable-string when the default
  // `b` is also nullable (the result can still be null) — the left-associative
  // `(f() ?? g()) ?? d` shape, where the classifier sees this nested `??` as `binLeft`
  // before `emitExpr` re-associates it. Keeps print-routing / `exprString` consistent
  // with the emitted rep.
  if e is BinExpr {
    if e.binOp == "??" {
      // A fused read over a NULLABLE-string-valued map (`{[string]: string | null}`) stays
      // `string | null` ONLY when the default is itself nullable — a non-null default
      // coalesces every null (stored included) to a non-null string.
      const cns = coalesceMvSlot(exprIx, fnIx)
      if cns >= 0 {
        if mvValKind[cns] == 3 && coalesceStaysNullable(exprIx, cns, fnIx) {
          return true
        }
      }
      if exprNullableString(e.binLeft, fnIx) {
        return exprNullableString(e.binRight, fnIx)
      }
    }
  }
  false
}

// The base struct index of a nullable-struct `LetDecl`: the annotation's base, or
// the initializer's resolved struct (a nullable-returning call's `fRetStructIdx`).
export function nulRefStructIdxOfLet(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const ri = retNulRefIndex(d.letType)
      if ri >= 0 { return ri }
    }
    return structIndexOfExpr(d.letInit, fnIx)
  }
  -1
}

// True if evaluating the expression at `exprIx` yields a NULLABLE struct ref —
// a nullable-annotated param/local/global reference or a `S | null`-returning call.
export function exprNullableStruct(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Paren { return exprNullableStruct(e.parInner, fnIx) }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if fnRetNulRefSid(sidOfNode(e.callFn)) { return true }
      // An `S | null`-returning function VALUE (a binding / `(…) => S | null` param
      // callee) — its result is the nullable struct ref, `>nN;`.
      if calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "nulstruct" {
        return true
      }
    }
    // An `S | null`-returning FIELD-closure call.
    if callee is Member {
      const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if ffe >= 0 && fRetKind[ffe] == "nulstruct" { return true }
    }
    // `xs.pop()` / `xs.get(i)` over a STRUCT-element ref list yield `S | null` (the
    // host's nullable list reads — `pop` of an empty list / OOB `get` is null).
    if structListPopGetElem(exprIx, fnIx) >= 0 { return true }
    // FALLBACK (scoped to a CALL): a nullable-struct-returning closure value call whose callee the
    // cases above miss — an INDEXED closure-array element (`arr[i](x)`). The cheap NO-RENDER
    // `nodeTyIsNullableStruct` reads the checker's per-node type. The nullable dual of `exprStruct`'s
    // `nodeTyIsObj` fallback (#654), so `letIsNulRef` classifies such a binding kind-9 and its
    // `!= null` narrow gets the struct context.
    return nodeTyIsNullableStruct(exprIx)
  }
  if e is Ident {
    if paramNulRef(fnIx, e.identName) { return true }
    if declaredNulRef(e.identName) { return true }
    // A CAPTURED nullable struct (`const p: P | null = …; () => if p != null { p.x }`): the env
    // field is `(ref null $S)` (kind 9), so classify it nullable — else `p != null` reads as
    // struct equality. The struct index resolves via `capturedStructIndex`.
    if capturedKindOf(fnIx, e.identName) == "nulstruct" { return true }
    return globalIsNulRefSid(sidOfNode(exprIx))
  }
  // A NESTED-STRUCT field read (code 15) is stored `(ref null $S)` — a `S|null`
  // field genuinely carries null; a plain `inner: S` field is always written
  // non-null but shares the nullable storage, so the read is nullable-classified
  // (the consumer inserts `ref.as_non_null` before a chained field access).
  if e is Member { return memberFieldCode(exprIx, fnIx) == 15 }
  // An INDEX into a NULLABLE-struct array (`(P | null)[]`, ref-list slot key "P | null")
  // yields `P | null` — the element legitimately holds null, so the read is NOT recovered
  // to non-null (unlike a `P[]` element). `const e = xs[i]` binds the kind-9 niche.
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      // GUARD the slot: a NARROWED union-arm rebind receiver (`t2[0]` after
      // `t2 is (i64 | null)[]`) classifies `exprRefArray` true while the slot
      // resolver can still miss (-1) — un-guarded, `rlElemKindTbl[-1]` was an
      // OOB compiler CRASH (fuzz-nightly seed 484694996 d6).
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemKindTbl.length {
        if rlElemKindTbl[slot] == 1 {
          if rlElemIsNulNiche(slot) { return true }
        }
      }
    }
    // A BARE map get `m[k]` over a STRUCT-valued map (`{[string]: S}`) is `S | null` — the
    // `vals` slot is `(ref null $S)` and `emitMapGet` yields it unrecovered (a miss is
    // `ref.null`). So `const v = m[k]` binds the kind-9 niche and narrows with `if v != null`,
    // the map-read dual of the nullable-struct ARRAY element above. (A `?? d` read over a
    // NON-null value stays the non-null struct; see the BinExpr arm below for the nullable one.)
    const mrs = mapReadMvSlot(exprIx, fnIx)
    if mrs >= 0 { return mvValKind[mrs] == 1 }
  }
  // A `m[k] ?? d` read over a NULLABLE-struct-valued map (`{[string]: S | null}`) stays
  // `S | null` ONLY when the default is itself nullable; a non-null default coalesces every
  // null (stored included) to the non-null struct (`exprStruct` claims that).
  if e is BinExpr {
    const cns = coalesceMvSlot(exprIx, fnIx)
    if cns >= 0 {
      return mvValKind[cns] == 1 && coalesceStaysNullable(exprIx, cns, fnIx)
    }
    // The NON-map `??` over the same niche (`p ?? q` over two `S | null` places) obeys the
    // identical rule — the CONSUMER half of the decision `emitCoalesce`'s nullable-struct
    // arm makes. Without it an un-annotated `const nv = p ?? q` bound a NON-null struct
    // cell, and its `nv != null` lowered as struct equality (a loud reject) while an
    // ANNOTATED consumer took the `(ref null $S)` cell and the emit's non-null block type
    // disagreed with it (invalid wasm).
    if e.binOp == "??" {
      if exprNullableStruct(e.binLeft, fnIx) {
        return coalesceDefaultNullable(e.binRight, fnIx)
      }
    }
  }
  false
}

// The arena index of the expression an UN-ANNOTATED function returns: the body's
// trailing tail-value statement, or the first valued `return`'s argument (walking
// into if/while/for bodies). -1 when the function yields nothing (void).
export function fnRetExprOf(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const b = P.nodes[fn.fnBody]
    if b is Block {
      const stmts = b.blkStmts
      if stmts.length > 0 {
        const last = stmts[stmts.length - 1]
        if stmtIsTailValue(last, fnIx) { return last }
      }
    }
    return firstValuedReturn(fn.fnBody)
  }
  -1
}

// True if `rx` is a reference to a LOCAL whose annotation is a mono `{[string]: i32}` map —
// the ordering-safe way to classify a returned map local during the GLOBAL return pass (before
// per-function local kinds are collected, so `exprMap`/`declaredMap` can't see it yet).
// The map SHAPE of a RETURN expression, resolved from ANNOTATIONS ONLY (not collected local
// state) — so it is valid at the type-section emit (before locals are collected) AND from a
// DIFFERENT function (a caller resolving a map factory's value type). A returned map PARAM reads
// its annotation (`paramMapShape`); a returned map LOCAL its `let` annotation (`mapAnnShape`); a
// `Map()`/`Set()` is the mono map (-1); a call to another map fn recurses (`fnRetMapShape`).
// -1 (mono) for anything else.
//
// `fe` is the enclosing function's `fnStmts` POSITION, not its arena index. Every caller
// holds the position already (each spelled its argument `fnStmts[fe]`), and the capture
// arm below needs the position — taking it directly is what keeps `fnStmtsPosOf` from
// scanning `fnStmts` to recover a number the caller was standing on.
export function mapRetExprShape(rx: i32, fe: i32) {
  const fnIx = fnStmts[fe]
  let u = rx
  let done = false
  while !done {
    const node = P.nodes[u]
    if node is Paren { u = node.parInner } else { done = true }
  }
  const e = P.nodes[u]
  if e is Ident {
    if paramMap(fnIx, e.identName) { return paramMapShape(fnIx, e.identName) }
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      const li = parentLetOf(fn.fnBody, e.identName)
      if li >= 0 {
        const d = P.nodes[li]
        if d is LetDecl {
          if d.letType >= 0 { return mapAnnShape(d.letType) }
        }
      }
    }
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      // A bare `Map()` / `Set()` returned straight out (`function mk() { return Map() }`)
      // carries NO spelling at all — neither its value type nor its KEY rep — so it falls to
      // the recorded ladder at the bottom rather than short-circuiting to the string-keyed
      // mono sentinel. (A Set is a boolean-valued map, so it is mono either way; WHICH mono
      // is still the key's to say, and the `-1` / `-4` pair is two different structs.)
      if callee.identName != "Map" && callee.identName != "Set" {
        return fnRetMapShapeSid(sidOfNode(e.callFn))
      }
    }
  }
  // A CAPTURED map return (`(q) => (h)` over an enclosing-frame map `h`): the ident is
  // neither a param nor a local of THIS function, so the arms above miss it. Resolve its
  // shape from the capture — the SAME `captureValStructIdx` the env field uses — so the
  // functype result `$mapStruct` heap type matches the env field AND the captured value.
  const cap = retCapturedMapShape(fe, rx)
  if cap != -3 { return cap }
  // FALLBACK — the map type the CHECKER RECORDED on the returned expression. Every rung
  // above reads a SPELLING (a param annotation, a `let` annotation, a callee's return
  // annotation), and an inferred map has none: `function mk() { return Map() }` and
  // `const t = Map()` pinned by its first write both put zero map syntax in the arena.
  // The mint side (`mvShapeOfMapNodeTy`, through `collectA`) reads this same recorded
  // type, so the slot found here is the one the type section interned — which is what
  // keeps the functype RESULT valtype (`emitFunctionSection`'s inferred-map arm) and the
  // caller's receiver shape (`mapShapeOfExpr` → `fnRetMapShapeSid`) naming one struct.
  if nodeTyIsMap(u) { return mapFindShapeOfNodeTy(u) }
  -1
}

// The map SHAPE of a return expression that is a CAPTURED map variable — an ident the lifted
// function at `fnStmts` position `fe` closes over whose enclosing binding is a `{[string]: V}`
// map — as the mv
// slot (>= -1; mono = -1), or -3 when the return is NOT a captured map. The capture SET
// (`captureNamesOf`) is the source of truth: only a name that is an actual env field is
// resolved here (a same-named local/param shadowing a capture stays with the local arms).
// A map-returning closure over a captured map is invisible to the local/param map tests, so
// without this its result inferred as i32 over a map-ref body — invalid wasm at the return.
//
// THE `parentBindingOf` PRE-GATE IS THE CONJUNCTION'S CHEAP HALF, TAKEN FIRST. This arm runs
// for EVERY return whose expression is a bare identifier — every function in the program, not
// only the closures it is about — and `captureNamesOf` re-WALKS the whole body whenever the
// capture cache is off (the classify passes run before `capCacheBuild`). Measured on a
// self-compile at `1517c7f6`: `captureNamesOf` is **4.35% of all samples and 100% of it is
// reached from here** (12 warm guest profiles, 20,985 samples), which made this one call site
// a fifth of the whole symbol/identifier string layer.
//
// The answer below is a CONJUNCTION — `name` is in the capture set AND its value kind is
// `"map"` — and `captureValKind`'s own FIRST line is `parentBindingOf(fe, name)`, returning
// `"i32"` when that is -1. So `parentBindingOf(fe, name) < 0` already implies the whole arm is
// -3, whichever way the membership loop went. Asking it first is therefore EXACTLY equivalent,
// evaluates no function the original did not evaluate on this path, and is O(1) for a frame
// with no parent (`parentBindingFrameOf` returns -1 on `fnParent[fe] < 0`) — which is every
// top-level function, i.e. the overwhelming majority of reaches. Only a returned identifier
// that a genuinely ENCLOSING frame binds now pays for the walk.
//
// The frame arrives as its `fnStmts` POSITION because every caller already has one — see
// `mapRetExprShape`'s header — and because everything below indexes by position anyway
// (`parentBindingOf`, `captureNamesOf`, `captureValKind`). An arena index here would be
// converted straight back by `fnStmtsPosOf`, which is an O(functions) scan outside the
// code-section emit.
function retCapturedMapShape(fe: i32, rx: i32): i32 {
  let u = rx
  let done = false
  while !done {
    const node = P.nodes[u]
    if node is Paren { u = node.parInner } else { done = true }
  }
  const e = P.nodes[u]
  if e is Ident {
    if fe >= 0 && parentBindingOf(fe, e.identName) >= 0 {
      const caps = captureNamesOf(fe)
      let ci = 0
      while ci < caps.length {
        if caps[ci] == e.identName {
          if captureValKind(fe, e.identName) == "map" {
            return captureValStructIdx(fe, e.identName)
          }
          return -3
        }
        ci = ci + 1
      }
    }
  }
  -3
}

// True if `rx` returns a body-declared map LOCAL whose value type the mv layer can lower.
// The local's kind is not collected during the GLOBAL return pass, so neither `exprMap` nor
// any Ident classifier can see it — this reads the DECLARATION instead, and it is what puts
// `"map"` in `fRetKind` (the functype result valtype, and the `return Map()` constructor
// seed, both follow from there).
function retIsMapLocal(rx: i32, fnIx: i32) {
  let u = rx
  let done = false
  while !done {
    const node = P.nodes[u]
    if node is Paren { u = node.parInner } else { done = true }
  }
  const e = P.nodes[u]
  if e is Ident {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      const li = parentLetOf(fn.fnBody, e.identName)
      if li >= 0 {
        const d = P.nodes[li]
        if d is LetDecl {
          if d.letType >= 0 {
            const lt = P.nodes[d.letType]
            if lt is TypeRef {
              // ARENA (D-BAREMAP): a `TyMap` annotation, never the union box a map-FIRST
              // spelling used to fool `nameIsMap` into claiming.
              if nodeTyIsMap(d.letType) {
                // A supported map value type — the same classifier `retMapFlag` gates the
                // boundary with (`mvValKindOfName`); the return's SHAPE is recovered at the
                // functype-result site via `mapShapeOfExpr` over this same local.
                return mapValKindLowerable(lt.tyName)
              }
            }
            return false
          }
          // An UN-ANNOTATED map local (`const t = Map()`, its value type pinned by the first
          // write) has no annotation for the rung above to read: the checker's recorded type
          // on the returned ident is the only spelling of it. Leaving it unclassified left
          // the functype result at the `"i32"` default over a body that returns a map ref —
          // and the CALLER resolves the same recorded type, so the two disagreed as invalid
          // wasm rather than as a loud reject.
          if nodeTyIsMap(u) { return mapNodeValKindLowerable(u) }
        }
      }
    }
  }
  false
}

// The parent-`let` arena index a returned bare IDENT names in function `i`'s
// body, or -1 (the return is not an ident, or the name is a param / global —
// `parentLetOf` only finds body-declared `let`s). The lookup half of the
// returned-LOCAL classification in `criClassify`, mirroring `retIsMapLocal`.
function criRetLocalLet(rx: i32, i: i32) {
  const u = unwrapParen(rx)
  const e = P.nodes[u]
  if e is Ident {
    const fn = P.nodes[fnStmts[i]]
    if fn is FuncDecl { return parentLetOf(fn.fnBody, e.identName) }
  }
  -1
}

// The IDENT NAME that function `fe`'s IMPLICIT RETURN assigns to, or "". That is: `fe` is
// un-annotated, and its body's LAST statement is `<name> = <rhs>` — the shape
// `emitBinExprNode` lowers as an assignment-as-expression and the trailing-expression rule
// then makes the function's result. WHICH CELL that name denotes is the storage-class
// dispatch in `fnAssignRetKind` below; this is the one place that decides which assignment
// is the implicit return, so the kind and its payload columns can never disagree about it.
//
// WHY THE TARGET AND NOT THE RHS. `emitBinExprNode`'s `=` arm (`wasmEmit.vl`) lowers an
// assignment-as-expression as STORE-then-RE-READ: `emitAssign` stores, then the TARGET
// is re-read through the normal Ident path. The value left on the stack is therefore the
// TARGET CELL's rep — the RHS *coerced to the target's declared type*.
//
// The RHS answer that used to be taken here is only ever right by COINCIDENCE: `g = "x"`
// into a `string` cell needs no coercion, so the RHS's `"str"` IS the cell's kind. It
// goes wrong when `emitAssign` COERCES — an i32 literal widened into an `i64` cell, a
// member literal interned into a literal-union cell's i32 atom, a value stored into a
// NULLABLE cell — and ALSO when the RHS's own classifier answer is merely WEAKER than the
// cell's: an empty `[]` classifies as the DEFAULT i32 list whatever list cell it is stored
// into. Every one of those was INVALID WASM on a program `vl check` accepts, rc 0.
//
// THE OTHER SIDE OF THE DISAGREEMENT IS FILED, NOT FIXED. The CHECKER types `x = e` as
// `e`'s own type UN-coerced — `let g: i64 = 0; function c() { g = 7 }` has `const r =
// c()` inferred `i32`, and `g: string | null; g = null` inferred `null` — while both the
// lowering and the functype use the target's coerced type. The two differ only where the
// value is CONSUMED, and consuming it is what `vl check` will mis-type; the fix is in
// `typecheck.vl`'s assignment-expression typing, outside this partition. Measured at
// `4411fbf3`: `let g: K = "a"; function f() { g = "b" }` is clean as `f()` and INVALID
// WASM as `print(f())`, on the GLOBAL target #1235 already fixed.
function fnAssignRetTargetName(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return "" }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    // An ANNOTATED return already drives the functype from its annotation (and the
    // annotated spellings of every cell below run today) — leave it alone.
    if fn.fnRet >= 0 { return "" }
    const b = P.nodes[fn.fnBody]
    if b is Block {
      const st = b.blkStmts
      if st.length > 0 {
        // The tail statement, and — for the EXPLICIT spelling `return (g = e)` — the
        // returned expression inside it. Both reach `emitBinExprNode`'s `=` arm and both
        // become the function's result, so both take the cell's answer.
        let tailx = st[st.length - 1]
        const ts = P.nodes[tailx]
        // A tail `if`/`else` whose ARMS each end in an assignment is the SAME implicit
        // return, split across branches: `emitIfTail` lowers every arm through
        // `emitStmtTail` → `emitReturnValue`, so each arm pushes ITS target cell's rep.
        // The join is `ifTailAssignName` — one representative name, minted only when every
        // arm's target cell has the same result identity, so the answer below is a plain
        // cell answer again and the whole storage-class dispatch is reused unchanged.
        if ts is IfStmt { return ifTailAssignName(tailx, fnStmts[fe]) }
        if ts is RetStmt {
          if ts.retArg < 0 { return "" }
          tailx = ts.retArg
        }
        const a = P.nodes[unwrapParen(tailx)]
        if a is BinExpr {
          if a.binOp == "=" {
            const t = P.nodes[unwrapParen(a.binLeft)]
            if t is Ident { return t.identName }
          }
        }
      }
    }
  }
  ""
}

// The `Param` node of function `fnIx` named `name`, or -1. The eleventh hand-copy of this
// scan in this file; the other ten each inline it inside a bigger predicate.
function fnParamNodeOf(fnIx: i32, name: string) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const ps = fn.fnParams
    let i = 0
    while i < ps.length {
      const p = P.nodes[ps[i]]
      if p is Param {
        if p.parName == name { return ps[i] }
      }
      i = i + 1
    }
  }
  -1
}

// The `fbValtype` kind an UN-ANNOTATED binding's INITIALIZER decides, classified through the
// same per-`let` predicates `collectLocals` types the binding with, in the same order —
// the ONE home of that ladder, shared by the captured-variable resolver
// (`captureValKind`) and the implicit-return assignment target (`letCellKind`). `"i32"`
// when no arm claims it, which is also the ladder's own trailing default.
function letInitCellKind(letIx: i32, fnIx: i32): VKind {
  if letIsMap(letIx, fnIx) { return "map" }
  if letIsNulRef(letIx, fnIx) { return "nulstruct" }
  // A value union wins over a scalar-list INIT (`f64[] | string = [1.5]`) — see the
  // local-decl chain. Checked before the scalar-list cases for that reason.
  if letIsUnion(letIx, fnIx) { return "union" }
  if letIsStringArray(letIx, fnIx) { return "strlist" }
  if letIsF32Array(letIx, fnIx) { return "f32list" }
  if letIsF64Array(letIx, fnIx) { return "f64list" }
  if letIsI64Array(letIx, fnIx) { return "i64list" }
  if letIsRefArray(letIx, fnIx) { return "reflist" }
  if letIsStruct(letIx, fnIx) { return "struct" }
  if letIsArray(letIx, fnIx) { return "list" }
  if letIsString(letIx, fnIx) { return "str" }
  if letIsI64(letIx, fnIx) { return "i64" }
  if letIsF32(letIx) || letInfersF32(letIx, fnIx) { return "f32" }
  if letIsF64(letIx, fnIx) { return "f64" }
  if letIsClosure(letIx, fnIx) { return "closure" }
  "i32"
}

// The `fbValtype` kind of the CELL a `LetDecl` binds inside function `fnIx` — its
// ANNOTATION's kind through the shared annotation ladder, else the initializer's
// (`letInitCellKind`). The LOCAL storage class's answer to the question `globalCellKind`
// answers for a module global, in `emit_classify`'s own storage class, so the
// implicit-return classifier can reach it (`collectLocals`, the emitter's own local
// ladder, lives in `emit_collect.vl`, which this file cannot import — the module graph
// already runs the other way and the loader rejects the cycle).
function letCellKind(letIx: i32, fnIx: i32): VKind {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return vtKindOfType(d.letType) }
    if d.letInit >= 0 { return letInitCellKind(letIx, fnIx) }
  }
  "i32"
}

// The kinds an implicit-return assignment DECLINES to name, whatever storage class the
// target cell lives in — `null` meaning "no answer, leave every classifier exactly as it
// was". Each declines because naming it makes the outcome WORSE than what it replaces:
//
//   `nulstr` — a `string | null` cell does not read back as its cell. `emitIdentNode`'s
//     kind-16 arm applies `ref.as_non_null` UNCONDITIONALLY (the "`string | null` READ
//     RULE", stated at `emitMem`'s field read), so the re-read pushes `(ref $array)` over
//     a cell that may hold null. Answering `"nulstr"` makes the module VALID and it then
//     TRAPS (`wasm trap: null reference`) on `g = null`; answering `"str"` is the same
//     trap. A trap is worse than a reject, so this stays the loud invalid-wasm reject it
//     is on master, at ALL THREE storage classes. THE ROOT IS THE UNCONDITIONAL RECOVER IN
//     `wasmEmit.emitIdentNode` (~12740), not here — a store-then-re-read cannot be sound
//     while the re-read force-recovers non-null.
//
//   `closure` / `nulclosure` — `fnReturnsClosure` already owns the closure result at both
//     functype producers, ahead of every kind this could supply; naming it here would only
//     race that owner.
//
//   `map` / `nulmap` / `variant` — `emit_sections`' INFERRED-return arm resolves an
//     `infSlot` for `struct` / `nulstruct` / `reflist` / `map` only, and its `map` arm
//     reads the SHAPE off the return EXPRESSION (`mapRetExprShape` over `fnRetExprOf`),
//     which for this shape is the assignment node, not a map expression. A named kind
//     whose companion slot cannot be minted from the same binding would declare a result
//     valtype over the wrong heap type; `null` keeps the master outcome instead.
//     (`nulreflist` is NOT in this list on purpose: `emit_sections` rejects it at
//     `fbValtype` with a loud emit error, which is strictly better than invalid wasm —
//     the outcome `tests/cases/functions/tail-assign-nullable-reflist-reject.vl` pins.)
function fnAssignKindGuard(k: VKind): VKind | null {
  if k == "nulstr" { return null }
  if k == "closure" || k == "nulclosure" { return null }
  if k == "map" || k == "nulmap" || k == "variant" { return null }
  k
}

// ── the assignment TARGET CELL, by name ──────────────────────────────────────────────
// The three resolvers below are the STORAGE-CLASS DISPATCH itself, keyed on a cell NAME
// rather than on a function: a body `let` (`parentLetOf`, which is function-scoped and
// descends into `if`/loop bodies), then a parameter, then a module global — the order the
// emitter resolves an assignment target in, so a binding SHADOWING a same-named global
// answers for the cell that is actually stored into. Each class asks the resolver that
// decides that cell's OWN valtype: `letCellKind` for a local (the mirror of
// `collectLocals`), `vtKindOfParam` for a parameter (the very function `emitTypeSection`
// writes the param valtype with), and `globalCellKind` for a global (the very function the
// global section writes the cell with) — so the answer cannot drift from the cell at any
// of the three.
//
// #1235 gave the GLOBAL class its cell and #1258 the LOCAL/PARAM half, both keyed on the
// function. They are keyed on the NAME here because the IF-ARM join has to ask the SAME
// question of EACH ARM's target before it can answer for the function at all; one home,
// asked N times, is what keeps the arms and the straight-line tail from drifting apart.

// The guarded `fbValtype` KIND of the cell named `nm` inside function `fnIx`, or `null`
// when no storage class claims the name (or `fnAssignKindGuard` declines the kind).
function fnAssignCellKind(fnIx: i32, nm: string): VKind | null {
  if nm == "" { return null }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const li = parentLetOf(fn.fnBody, nm)
    if li >= 0 { return fnAssignKindGuard(letCellKind(li, fnIx)) }
    const pi = fnParamNodeOf(fnIx, nm)
    if pi >= 0 { return fnAssignKindGuard(vtKindOfParam(pi)) }
  }
  const gi = globalLetOf(nm)
  if gi < 0 { return null }
  fnAssignKindGuard(globalCellKind(gi))
}

// The STRUCT-TABLE index of the cell named `nm` inside function `fnIx`, or -1 — the raw
// per-class answer, ungated on the kind (`fnAssignRetSlot` applies the kind gate).
function fnAssignCellSlot(fnIx: i32, nm: string) {
  if nm == "" { return -1 }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const li = parentLetOf(fn.fnBody, nm)
    if li >= 0 { return structIndexOfLet(li, fnIx) }
    const pi = fnParamNodeOf(fnIx, nm)
    if pi >= 0 { return paramStructIdxOf(pi) }
  }
  const gi = globalLetOf(nm)
  if gi < 0 { return -1 }
  globalCellStructIdx(gi)
}

// The DECLARED TYPE SPELLING of the `LetDecl` at `letIx`, or "" when un-annotated (its
// kind then comes from the initializer — `letInitCellKind`).
function letDeclTypeName(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return tyNameOf(d.letType) }
  }
  ""
}

// The DECLARED TYPE SPELLING of the cell named `nm` inside function `fnIx`, or "".
//
// THE COLUMN `VKind` CANNOT SUPPLY. A literal-union cell and a plain `i32` cell are BOTH
// `"i32"` to `fbValtype` (the atom is an interned i32), and a `boolean` cell is too — yet
// `v: K` and `w: i32` are different RESULT types, and the checker joins two arms assigning
// to them into a union BOX that the emitter then lowers correctly. Measured: with the join
// keyed on kind+slot+elem alone, `if c { v = "b" } else { w = 3 }` over `K`/`i32` went
// CORRECT → INVALID WASM — the only two cells of a 271-cell grid that moved BACKWARD, at
// both the local/local and local/global spellings.
function fnAssignCellTypeName(fnIx: i32, nm: string) {
  if nm == "" { return "" }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const li = parentLetOf(fn.fnBody, nm)
    if li >= 0 { return letDeclTypeName(li) }
    const pi = fnParamNodeOf(fnIx, nm)
    if pi >= 0 {
      const p = P.nodes[pi]
      if p is Param { return tyNameOf(p.parType) }
    }
  }
  const gi = globalLetOf(nm)
  if gi < 0 { return "" }
  letDeclTypeName(gi)
}

// The REF-LIST ELEMENT type-name of the cell named `nm` inside function `fnIx`, or "".
function fnAssignCellElem(fnIx: i32, nm: string) {
  if nm == "" { return "" }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const li = parentLetOf(fn.fnBody, nm)
    if li >= 0 { return letRefListElemName(li, fnIx) }
    const pi = fnParamNodeOf(fnIx, nm)
    if pi >= 0 {
      const p = P.nodes[pi]
      if p is Param { return refArrElemNameIf(tyNameOf(p.parType)) }
    }
  }
  const gi = globalLetOf(nm)
  if gi < 0 { return "" }
  letRefListElemName(gi, -1)
}

// ── the IF-ARM join ──────────────────────────────────────────────────────────────────
// THE JOIN RULE: two arms join iff their target cells have the same RESULT IDENTITY — the
// same guarded KIND, the same struct-table SLOT, the same ref-list ELEMENT name and the
// same DECLARED TYPE SPELLING. The first three are exactly what `criClassify` writes into
// `fRetKind` / `fRetStructIdx` / `fRetRArrElem`, i.e. exactly what `emit_sections` turns
// into the functype's result valtype; the fourth separates the cells `VKind` alone cannot
// (see `fnAssignCellTypeName`). The NAMES may differ freely (`if c { v = 1 } else { w = 2 }`
// over two `i64` locals joins, in any pair of storage classes); two `struct` cells of
// DIFFERENT layouts do not (the slots differ).
//
// WHY IDENTITY AND NOT A WIDENING JOIN. The lowering is store-then-re-read per arm, so
// each arm pushes its own cell's rep with no coercion site in between; a join that
// answered anything but "both arms already agree" would declare a result one arm does not
// produce — invalid wasm, the very outcome this replaces. `ifExprValtype` (the if-VALUE
// join) can widen because its arms are EXPRESSIONS emitted into a known blocktype and its
// numeric arms coerce at `emitIfExprAs`; there is no such coercion for a re-read cell.
// Where the arms DISAGREE this declines (`null`) and the master outcome stands — see the
// residue note in `tests/cases/statements/tail-assign-if-arms.vl`.
//
// AGREEMENT WITH `ifExprRefKind`. The if-VALUE ref join classifies the whole `if` from the
// THEN arm alone, on the checker's proof that the arms share a join type. This rule is the
// same shape — a representative arm decides — with the equality made EXPLICIT because the
// checker offers no such proof here: it types `x = e` as `e`'s own type (the filed
// `typecheck.vl` half), so on this family its join is not the emitter's cell join and
// cannot be leaned on.

// The TAIL statement of an if-ARM block, or -1 (an empty arm, or a non-block arm).
function armTailStmtOf(blockIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const st = b.blkStmts
    if st.length > 0 { return st[st.length - 1] }
  }
  -1
}

// The IDENT name an ARM-TAIL statement assigns to, or "" — the same unwrap
// `fnAssignRetTargetName` runs on a straight-line tail, because both spellings reach
// `emitBinExprNode`'s `=` arm through `emitStmtTail` and both leave the target cell on the
// stack. An INDEX / MEMBER target answers "" (its value form is not lowered, so such an
// arm is not a tail value at all and `emitIfTail` never claims the `if`).
function armAssignTargetName(stmtIx: i32) {
  if stmtIx < 0 { return "" }
  let tx = stmtIx
  const ts = P.nodes[tx]
  if ts is RetStmt {
    if ts.retArg < 0 { return "" }
    tx = ts.retArg
  }
  const a = P.nodes[unwrapParen(tx)]
  if a is BinExpr {
    if a.binOp == "=" {
      const t = P.nodes[unwrapParen(a.binLeft)]
      if t is Ident { return t.identName }
    }
  }
  ""
}

// The FIRST (leftmost) arm-tail assignment target under the tail `if` at `ifIx` — the
// candidate the other arms are measured against. "" when the then-arm's tail is not an
// assignment at all. A NESTED tail `if` in the then-arm recurses to ITS first arm.
function ifTailFirstAssignName(ifIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    const t = armTailStmtOf(s.ifThen)
    if t < 0 { return "" }
    const tn = P.nodes[t]
    if tn is IfStmt { return ifTailFirstAssignName(t) }
    return armAssignTargetName(t)
  }
  ""
}

// True if the two cell names resolve, inside function `fnIx`, to the same result identity
// (kind + struct slot + ref-list element + declared type spelling). A name no storage class
// claims — or one whose kind `fnAssignKindGuard` declines — never agrees, so a declined
// kind keeps its master outcome through the join exactly as it does through the
// straight-line tail. Two UN-annotated cells carry "" for the spelling and are separated by
// the other three columns alone (`letInitCellKind` is their one home, so equal kind + slot
// + element there IS equal rep).
function fnAssignCellEq(fnIx: i32, a: string, b: string) {
  const ka = fnAssignCellKind(fnIx, a)
  const kb = fnAssignCellKind(fnIx, b)
  if ka == null { return false }
  if kb == null { return false }
  if ka != kb { return false }
  if fnAssignCellSlot(fnIx, a) != fnAssignCellSlot(fnIx, b) { return false }
  if fnAssignCellElem(fnIx, a) != fnAssignCellElem(fnIx, b) { return false }
  fnAssignCellTypeName(fnIx, a) == fnAssignCellTypeName(fnIx, b)
}

// True if the ARM block at `blockIx` ends in an assignment whose target cell agrees with
// `nm0`'s (a nested tail `if` recurses through every one of ITS arms).
function ifTailArmAgrees(blockIx: i32, fnIx: i32, nm0: string) {
  const t = armTailStmtOf(blockIx)
  if t < 0 { return false }
  const tn = P.nodes[t]
  if tn is IfStmt { return ifTailArmsAgree(t, fnIx, nm0) }
  const nm = armAssignTargetName(t)
  if nm == "" { return false }
  if nm == nm0 { return true }
  fnAssignCellEq(fnIx, nm, nm0)
}

// True if EVERY arm of the tail `if` at `ifIx` ends in an assignment agreeing with `nm0`.
// An `if` with NO else declines: the false path falls through with no value, so the
// function's result is the checker's NULLABLE join and not any arm's cell (`i64` cells
// under `function f(c) { if c { v = 3 } }` infer `i32?`, whose rep is neither cell's) —
// that half stays exactly as master left it, filed with the fixture.
function ifTailArmsAgree(ifIx: i32, fnIx: i32, nm0: string) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    if s.ifElse < 0 { return false }
    if !ifTailArmAgrees(s.ifThen, fnIx, nm0) { return false }
    const els = P.nodes[s.ifElse]
    if els is Block { return ifTailArmAgrees(s.ifElse, fnIx, nm0) }
    // `else if`: a lone nested `IfStmt`, which must carry its own final `else`.
    return ifTailArmsAgree(s.ifElse, fnIx, nm0)
  }
  false
}

// The ONE representative arm-tail assignment target of the tail `if` at `ifIx`, or "" —
// the join. Minted only when every arm's target cell agrees with the first arm's, so the
// name it returns stands for ALL of them and the three `fnAssignRet*` columns can be read
// off it exactly as they are off a straight-line tail.
function ifTailAssignName(ifIx: i32, fnIx: i32) {
  const nm0 = ifTailFirstAssignName(ifIx)
  if nm0 == "" { return "" }
  if !ifTailArmsAgree(ifIx, fnIx, nm0) { return "" }
  nm0
}

// The authoritative result `VKind` of function `fe` when its implicit return is an
// ASSIGNMENT — a straight-line tail, an explicit `return (v = e)`, or a tail `if` whose
// arms all assign to agreeing cells (`fnAssignRetTargetName`) — else `null`.
//
// #1235 gave the GLOBAL storage class its cell, #1258 the LOCAL/PARAM half. Its filing
// said the local answer "needs the two ladders proved equal first"; the proof is that the
// two ladders now have ONE ANNOTATED HOME (`vtKindOfType`, which `collectLocals`'
// annotation arms and this one both ride) and ONE UN-ANNOTATED HOME (`letInitCellKind`),
// plus the per-kind DECLINES in `fnAssignKindGuard` for every kind whose payload column
// `emit_sections` cannot mint from the same binding.
function fnAssignRetKind(fe: i32): VKind | null {
  const nm = fnAssignRetTargetName(fe)
  if nm == "" { return null }
  fnAssignCellKind(fnStmts[fe], nm)
}

// The result-valtype SLOT that goes beside `fnAssignRetKind`'s answer — the struct table
// index for a struct / nullable-struct cell, the ref-list wrapper slot for a ref-list cell,
// -1 for every kind that needs none. GATED ON THE KIND, and read from the SAME binding the
// kind came from, so the two can never be minted from different facts and no non-struct
// cell is asked for a struct index it would answer wrongly.
//
// BOTH ARMS ARE LOAD-BEARING and the ref-list one is reached only through the CLOSURE
// producer: `criClassify` consults this for `struct` / `nulstruct` and fills
// `fRetRArrElem` for `reflist` separately, but `cloRetValSlot` routes the WHOLE
// assignment-cell answer here — so dropping the ref-list arm turns a `$fnsig` result
// suffix into "" and rejects an otherwise-fine `const h = () => { v = [{n: 3}] }` over an
// `S[]` local. (Measured: exactly 2 cells of the 652-cell grid, both `lamlocal`.)
function fnAssignRetSlot(fe: i32) {
  const k = fnAssignRetKind(fe)
  if k == null { return -1 }
  if k == "reflist" { return rlSlotByName(fnAssignRetElemName(fe)) }
  if k != "struct" && k != "nulstruct" { return -1 }
  fnAssignCellSlot(fnStmts[fe], fnAssignRetTargetName(fe))
}

// The ref-list ELEMENT TYPE-NAME beside `fnAssignRetKind`'s `reflist` answer — the column
// `emit_sections`' inferred-return arm turns into the result's wrapper slot
// (`rlSlotByName`). Same binding, same three storage classes, same order.
function fnAssignRetElemName(fe: i32) {
  fnAssignCellElem(fnStmts[fe], fnAssignRetTargetName(fe))
}

// Classify ONE valued return expression at `rx0` of the function at `fnStmts`
// position `i`, under the CURRENT narrowing stack — the loop body the flat
// return scan used to run, extracted so the narrowing-aware walk shares it.
export function criClassify(rx0: i32, i: i32) {
  let rx = rx0
  // AN ASSIGNMENT'S VALUE IS ITS TARGET CELL, not the RHS expression — `fnAssignRetKind`
  // above. It is a property of the FUNCTION, not of this one return node, so it answers
  // for every node of such a function and RETURNS: no expression-derived fact may touch
  // the slot afterwards. That is what keeps `computeRetInference`'s fixed point
  // TERMINATING — the cell kind is a plain direct write (it must beat the checker's A20
  // seed, which `criSetRetKind`'s monotone ladder cannot lower), so leaving the eager
  // expression writes live beside it would let the two alternate forever.
  const ark = fnAssignRetKind(i)
  if ark != null {
    if fRetKind[i] != ark {
      fRetKind[i] = ark
      criChanged = true
    }
    // The per-kind PAYLOAD columns the result valtype needs beside the kind
    // (`emit_sections`' inferred-return arm reads exactly these).
    if ark == "struct" || ark == "nulstruct" {
      fRetStructIdx[i] = fnAssignRetSlot(i)
    }
    if ark == "reflist" {
      if i < fRetRArrElem.length && fRetRArrElem[i] == "" {
        fRetRArrElem[i] = fnAssignRetElemName(i)
      }
    }
    return 0
  }
  // A tail ASSIGNMENT yields its RHS (assignment-as-expression), so the
  // function's return kind is the RHS's kind (`function emit(s: string)
  // { acc = acc + s }` returns the new string).
  const rxe = P.nodes[rx]
  if rxe is BinExpr {
    if rxe.binOp == "=" { rx = rxe.binRight }
  }
  if fRetKind[i] != "str" && exprString(rx, fnStmts[i]) {
    criSetRetKind(i, "str")
  }
  if !retKindIsList(fRetKind[i]) && exprRefArray(rx, fnStmts[i]) {
    // Record the element type-NAME so the inferred functype result can resolve its ref-list
    // slot (`rlSlotByName`) — the annotated path fills `fRetRArrElem` from the annotation, but
    // an un-annotated `return ps` / `return ps.filter(…)` must read it off the return expr.
    if criSetRetKind(i, "reflist") {
      if i < fRetRArrElem.length && fRetRArrElem[i] == "" {
        fRetRArrElem[i] = refListElemNameOfExpr(rx, fnStmts[i])
      }
    }
  }
  if !retKindIsList(fRetKind[i]) && exprStringArray(rx, fnStmts[i]) {
    criSetRetKind(i, "strlist")
  }
  if !retKindIsList(fRetKind[i]) && exprF64Array(rx, fnStmts[i]) {
    criSetRetKind(i, "f64list")
  }
  // The i64/f32 siblings of the f64-list arm above (wrappers `il64TypeIdx` /
  // `fl32TypeIdx`). Checked BEFORE the generic `exprArray` arm below, which would
  // otherwise claim an i64/f32-magnitude return as a plain i32 list — the
  // functype result would declare the i32-list wrapper over a body building the wide list.
  if !retKindIsList(fRetKind[i]) && exprI64Array(rx, fnStmts[i]) {
    criSetRetKind(i, "i64list")
  }
  if !retKindIsList(fRetKind[i]) && exprF32Array(rx, fnStmts[i]) {
    criSetRetKind(i, "f32list")
  }
  if fRetKind[i] != "map" {
    // `exprMap` classifies a returned map PARAM (reads `parType` directly) and a `Map()`/
    // map-returning-call. A returned map LOCAL needs `retIsMapLocal` — its kind isn't
    // collected during this GLOBAL return pass, so read its DECLARATION (the annotation,
    // else the type the checker inferred for it).
    if (
      exprMap(rx, fnStmts[i]) ||
      retIsMapLocal(rx, fnStmts[i]) ||
      retCapturedMapShape(i, rx) != -3
    ) {
      criSetRetKind(i, "map")
    }
  }
  // The not-a-list guard subsumes the old `fRetArr==0 && fRetF64Arr==0`: `exprArray`'s array-
  // literal case is `!arrLitIsRef`, and an f64 element is NOT a ref, so `exprArray` also
  // claims an f64 literal (`[1.5, 2.5]`). The f64-list kind was set just above, so this
  // skips it — no separate i32/f64 mis-classification.
  if !retKindIsList(fRetKind[i]) && exprArray(rx, fnStmts[i]) {
    criSetRetKind(i, "list")
  }
  if fRetKind[i] != "union" && exprUnion(rx, fnStmts[i]) {
    // A union return SUBSUMES a per-arm struct classification: a value-if join (`if c {
    // catVal } else { dogVal }`) has one arm a union-VARIANT object literal (which
    // `exprStruct` would also claim as a plain struct return) and another the union. If the
    // struct arm was classified FIRST it stored `"struct"` while the union was still unseen
    // (the struct arm's guard only blocks the reverse order) — and struct OUTRANKS union in
    // the chain, so a plain `criSetRetKind` would refuse. Overwrite so the union wins — else
    // the inferred-result valtype declares a struct ref over a body that yields the union
    // box. Lambda-gated: only the lambda value-if path (above) hits this order, and a named
    // function's classification must stay byte-identical.
    if fRetKind[i] == "struct" && criFnIsAnonLambda(i) {
      fRetKind[i] = "union"
      criChanged = true
    } else {
      criSetRetKind(i, "union")
    }
  }
  if (
    fRetKind[i] != "nulstruct" &&
    fRetKind[i] != "union" &&
    exprNullableStruct(rx, fnStmts[i])
  ) {
    if criSetRetKind(i, "nulstruct") {
      fRetStructIdx[i] = structIndexOfExpr(rx, fnStmts[i])
    }
  }
  if (
    fRetKind[i] != "struct" &&
    fRetKind[i] != "nulstruct" &&
    fRetKind[i] != "union" &&
    exprStruct(rx, fnStmts[i])
  ) {
    // GUARD `!= "union"`: an INFERRED struct-union return (`Cat | Dog`) stores `"union"`
    // in the A20 name pass, but each of its returns is a SINGLE object literal that
    // `exprStruct` would (wrongly) also classify as a plain struct return — the union
    // kind dominates, so don't claim `"struct"`/`fRetStructIdx` (a conflicting rep).
    if criSetRetKind(i, "struct") {
      fRetStructIdx[i] = structIndexOfExpr(rx, fnStmts[i])
    }
  }
  // A returned LOCAL `let` of a REF kind (`const c: Ctx = {…}; return c`,
  // `const xs = [[1,2]]; return xs`): during this GLOBAL pass the function's
  // locals are not collected, so the `expr*` Ident cases above miss it and the
  // functype result would default to i32 over a body that yields a ref — invalid
  // wasm. Classify through the DECLARATION (annotation first, else the
  // initializer's shape) via the shared per-let classifiers, exactly as
  // `retIsMapLocal` does for a returned map local. The scalar / string /
  // scalar-list local kinds never reach here — the checker's recorded
  // inferred-return name (the A20 pass) already covers them.
  const rll = criRetLocalLet(rx, i)
  if rll >= 0 {
    if !retKindIsList(fRetKind[i]) && letIsRefArray(rll, fnStmts[i]) {
      if criSetRetKind(i, "reflist") {
        if i < fRetRArrElem.length && fRetRArrElem[i] == "" {
          fRetRArrElem[i] = letRefListElemName(rll, fnStmts[i])
        }
      }
    }
    if (
      fRetKind[i] != "struct" &&
      fRetKind[i] != "nulstruct" &&
      fRetKind[i] != "union" &&
      !retKindIsList(fRetKind[i]) &&
      letIsStruct(rll, fnStmts[i])
    ) {
      // `structIndexOfLet` prefers the ANNOTATION's struct over the literal's
      // first field-shape match, so `const c: Ctx = {…}` returns Ctx even when
      // another declared struct shares its field names.
      if criSetRetKind(i, "struct") {
        fRetStructIdx[i] = structIndexOfLet(rll, fnStmts[i])
      }
    }
  }
  if fRetBool[i] == 0 && exprIsBool(rx, fnStmts[i]) {
    fRetBool[i] = 1
    criChanged = true
  }
  // SCALAR f64 / f32 / i64 returns, detected from the return EXPRESSION — the dual of the string
  // / list / struct cases above. A function the checker never recorded an inferred-return name for
  // — a MONOMORPHIZED instance (`f(n)` pinned to `n: f64` by the emitter, whose body the checker
  // only saw with `n` a type variable) — would otherwise default its functype result to i32 over
  // an f64/f32/i64 body: "expected i32, found f64". Gated on the flag being unset (so an annotated
  // return and every i32 return are untouched) AND on a "pure" scalar return: a value-union `?? d`
  // coalesce reads as its unboxed atom (`exprIsF64`/`exprIsI64`) but its result REP is the union
  // box, classified separately — so exclude it, and skip when another return flag already claimed
  // the function.
  let scalarOk = fRetKind[i] == "i32" && fRetBool[i] == 0
  const rxn = P.nodes[rx]
  if rxn is BinExpr {
    if rxn.binOp == "??" { scalarOk = false }
  }
  if scalarOk {
    if exprIsF64(rx, fnStmts[i]) { criSetRetKind(i, "f64") }
    else if exprIsF32(rx, fnStmts[i]) { criSetRetKind(i, "f32") }
    else if exprIsI64(rx, fnStmts[i]) { criSetRetKind(i, "i64") }
  }
  0
}

// Walk a block's statements classifying every `return <e>` under the SAME
// narrowing the emit loops apply: each `if` arm classifies under its
// condition's then/else narrowing, and a divergent guard narrows the rest of
// the block (`pushPostGuardNarrow`). The stack rewinds at block exit.
// True if lifted function `i` (an `fnStmts` index) is an ANONYMOUS lambda (no source
// name). Restricts the if-arm tail-value return classification below to lambdas, leaving
// NAMED-function return inference byte-identical (a named function's inferred-return name
// already rides `buildFnMap`'s A20 pass + `criWalkStmt`'s explicit-`return` classification;
// perturbing it would change the compiler's own self-compilation).
export function criFnIsAnonLambda(i: i32) {
  if i < 0 || i >= fnStmts.length { return false }
  const fn = P.nodes[fnStmts[i]]
  if fn is FuncDecl {
    // The emitter rewrites an anonymous lambda's empty name to the synthesized
    // `__lambda_N` (before this pass runs), so test that prefix — `fnName == ""` never
    // matches a lifted lambda here. A source function never starts with `__lambda`.
    const nm = fn.fnName
    return nm.length >= 8 && nm.slice(0, 8) == "__lambda"
  }
  false
}

export function criWalkBlock(blockIx: i32, i: i32) {
  if blockIx < 0 { return 0 }
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    const savedGuardTop = narrowTop
    let k = 0
    while k < stmts.length {
      // An if-ARM's last statement may be a bare tail VALUE (an implicit return —
      // `if c { catVal } else { dogVal }`), not an explicit `return`. For an ANONYMOUS
      // LAMBDA, classify it under the arm's active narrowing so a value-if union return
      // types from its arms (a named union-returning callback already works via explicit
      // `return`s). Lambda-gated to keep named-function inference byte-identical.
      if (
        k == stmts.length - 1 &&
        criFnIsAnonLambda(i) &&
        stmtIsTailValue(stmts[k], fnStmts[i])
      ) {
        criClassify(stmts[k], i)
      }
      criWalkStmt(stmts[k], i)
      pushPostGuardNarrow(stmts[k], fnStmts[i])
      k = k + 1
    }
    restoreNarrow(savedGuardTop)
    return 0
  }
  criWalkStmt(blockIx, i)
}

function criWalkStmt(stmtIx: i32, i: i32) {
  if stmtIx < 0 { return 0 }
  const s = P.nodes[stmtIx]
  if s is RetStmt {
    if s.retArg >= 0 { criClassify(s.retArg, i) }
    return 0
  }
  if s is IfStmt {
    const savedTop = narrowTop
    setNarrowFromCond(s.ifCond, fnStmts[i])
    criWalkBlock(s.ifThen, i)
    restoreNarrow(savedTop)
    if s.ifElse >= 0 {
      const savedElseTop = narrowTop
      setNarrowFromCondElse(s.ifCond, fnStmts[i])
      criWalkBlock(s.ifElse, i)
      restoreNarrow(savedElseTop)
    }
    return 0
  }
  if s is WhileStmt { return criWalkBlock(s.whileBody, i) }
  if s is ForRange { return criWalkBlock(s.frBody, i) }
  if s is ForIn { return criWalkBlock(s.fiBody, i) }
  0
}

// Look up the wasm function index for `name`, or -1 if no such top-level function
// exists (an undefined callee — the caller fails loudly).
export function fnIndexOf(name: string) {
  sidArrGet(fnIndexBySid, sidLookup(name))
}

// The sid-taking primitive (R6) — an array read. See `globalIndexOfSid`.
export function fnIndexOfSid(sid: i32) { sidArrGet(fnIndexBySid, sid) }

// The `fnStmts` position of a lifted function named `name` whose PARENT frame is the
// `fnStmts` position `pp`, or -1 — ONE rung of the scope-chain walk below. (Twin of
// `emit_collect.nestedFnDeclaredIn`; see `fnIndexOfInScope`'s note on the duplication.)
function nestedFnDeclaredInFrame(name: string, pp: i32) {
  let i = 0
  while i < fnStmts.length {
    const s = P.nodes[fnStmts[i]]
    if s is FuncDecl {
      if s.fnName == name {
        if i < fnParent.length && fnParent[i] == pp { return i }
      }
    }
    i = i + 1
  }
  -1
}

// `fnIndexOf` but SCOPE-AWARE for a name referenced as a VALUE (or as a `.map`/`.filter`
// CALLBACK) inside function `fnIx` (a node index): when two lifted functions share a
// name (each `makeX` declaring its own nested `add`), the flat `fnIndexOf` always returns
// the FIRST — wrong for the SECOND maker's body, whose `add` captures a different frame.
//
// Resolution is the language's own rule: the INNERMOST enclosing scope that declares
// `name` wins, so walk OUTWARD from the calling frame and stop at the first hit — the
// frame's own nested declarations first, then each enclosing frame in turn. Running off
// the chain (`-1` = top level) means no nested binding is in scope and the flat map's
// answer — a top-level function — is the correct one.
//
// This used to match only a function whose parent IS the calling frame, which missed
// three rungs and left each a SILENT WRONG ANSWER on the value path: a SIBLING nested
// function taken as a value, a nested function referring to ITSELF (its declaring frame
// is its PARENT, one step out — which rewired the recursion to another frame's twin, so
// `10+10+10` printed `12`), and a nested function SHADOWING a top-level one as seen from
// a sibling frame.
//
// DUPLICATION, deliberate and filed: this is the twin of `emit_collect.
// fnIndexOfInScopeChain`, which `emitCall` uses for the by-name CALL path. The two are
// one function in two homes because `emit_classify` cannot import `emit_collect` — the
// module graph already runs `emit_collect -> emit_classify` and the loader rejects the
// cycle ("Import cycle detected"). The dedup is a ONE-LINE change in `emit_collect`
// (`fnIndexOfInScopeChain` becomes `fnIndexOfInScope(name, fnIx)`; that direction of the
// import already exists), and belongs to whoever owns that file.
//
// Cost: gated on `nestedNameSet`, so a name that is not a nested function's anywhere —
// every callee in a module with no nested functions, including this compiler — costs
// exactly the one `fnIndexOf` map lookup it cost before.
export function fnIndexOfInScope(name: string, fnIx: i32) {
  fnIndexOfInScopeSid(sidLookup(name), name, fnIx)
}

// The sid-taking primitive (R5/R6); see `emit_collect.fnIndexOfInScopeChainSid`,
// the deliberate twin this mirrors.
export function fnIndexOfInScopeSid(sid: i32, name: string, fnIx: i32) {
  // The parent-matching scan can only succeed for a NESTED function named `name`; skip
  // it entirely (→ O(1) `fnIndexOf`) when no lifted function carries this name.
  if fnIx >= 0 && sidArrGet(nestedNameBySid, sid) == 1 {
    let pp = fnStmtsPosOf(fnIx)
    // `fnStmts.length` bounds the walk: a parent chain cannot be longer than the
    // function count, so this terminates even were `fnParent` ever to contain a cycle.
    let steps = 0
    while pp >= 0 && steps <= fnStmts.length {
      const hit = nestedFnDeclaredInFrame(name, pp)
      if hit >= 0 { return hit }
      if pp < fnParent.length { pp = fnParent[pp] } else { pp = -1 }
      steps = steps + 1
    }
  }
  fnIndexOfSid(sid)
}

// ── capture analysis (closures) ───────────────────────────────────────────────
// The `fnStmts` position of the lifted function whose capture list is being computed
// right now. `capRecord` needs it to ask whether an ENCLOSING frame binds a name, and
// `capScan` is a 30-site recursion, so the frame rides here rather than through every
// call. Sound because there is exactly ONE entry point (`capComputeNamesOf`, the only
// caller of `capScan` in the compiler — every other reference to it is a comment) and no
// re-entrancy: the nested-`FuncDecl` arm's transitive pass is still part of the SAME
// frame's computation, and that is the frame whose ancestors decide the question. -1 (the
// initial value, and the value outside any computation) reproduces the old behaviour
// exactly, because `parentBindingFrameOf(-1, …)` is -1.
let capFrame: i32 = -1

// The captured-variable NAMES of the lifted function at `fnStmts[fe]`, in
// encounter (= env field) order, by DIRECT WALK. A capture is a free variable: an
// identifier read in the body that is NOT one of the function's own params, NOT a
// `let`/`const` declared in the body, NOT a module global, and NOT a top-level/
// lifted function name (those are addressable directly) — the last two UNLESS an
// enclosing frame binds the same name, see `capRecord`. The walk threads a
// growable `bound` set (params, then each `let` as it is declared) and
// accumulates free names into `caps` (deduped). Mirrors the host's
// `captureCollector`. Callers go through `captureNamesOf`, which serves the
// emission phases from the capture cache instead of re-walking.
export function capComputeNamesOf(fe: i32) {
  const caps: string[] = []
  if fe < 0 || fe >= fnStmts.length { return caps }
  capFrame = fe
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    const bound: string[] = []
    const params = fn.fnParams
    let pi = 0
    while pi < params.length {
      const p = P.nodes[params[pi]]
      if p is Param { bound.push(p.parName) }
      pi = pi + 1
    }
    capScan(fn.fnBody, bound, caps)
  }
  caps
}

// The captured-variable NAMES of the lifted function at `fnStmts[fe]` — from the
// capture cache when it is valid (the emission phases), else by direct walk (the
// rewrite/monomorphize phases, which still mutate bodies). Returns a fresh small
// array either way (a `string[][]` cache row is not self-host-emittable).
export function captureNamesOf(fe: i32) {
  if capCacheOn && fe >= 0 && fe < capStartTbl.length {
    const caps: string[] = []
    const start = capStartTbl[fe]
    const cnt = capCountTbl[fe]
    let ci = 0
    while ci < cnt {
      caps.push(capNamesFlat[start + ci])
      ci = ci + 1
    }
    return caps
  }
  capComputeNamesOf(fe)
}

// The number of captured variables of the lifted function at `fnStmts[fe]` —
// O(1) from the cache when valid, else the direct walk's length.
export function captureCountOf(fe: i32) {
  if capCacheOn && fe >= 0 && fe < capCountTbl.length { return capCountTbl[fe] }
  const caps = capComputeNamesOf(fe)
  caps.length
}

// A module GLOBAL and a top-level/lifted FUNCTION name are addressable directly from
// inside a lifted function, so neither is a capture — UNLESS AN ENCLOSING FRAME BINDS THE
// SAME NAME. Then the identifier denotes that binding, and dropping it here left the
// lifted body with nothing to read it from: `emitIdentNode` consults the env FIRST, misses
// (the name never entered the env), and falls through to `global.get` — a SILENT WRONG
// ANSWER, no diagnostic at any tier.
//
//   const a = 99
//   function outer(): i32 {
//     const a = 10                            // shadows the global
//     const inner = (x: i32) => x + a         // reads 99, prints 100, not 11
//     return inner(1)
//   }
//
// Censused at the fix: 9 programs over `const`/`let`/param bindings, i32 and string, a
// nested named function and a lambda, at top level and one frame down — 7 wrong, both
// alias-free controls (distinct names; the same local read DIRECTLY rather than through a
// closure) right, and every wrong cell exits 0. The FUNCTION-name half is the same defect
// one line over and was already filed from the other side: `lint.vl`'s `stmtDiverges`
// carries a comment saying it is spelled uniquely to dodge exactly this, because a bare
// `diverges` would collide with a LOCAL of that name in `typecheck.vl` and the seed's
// capture analysis then mis-resolved it into "captured variable not found in enclosing
// frame". Both halves are one guard.
//
// `parentBindingFrameOf` is the existing resolver for "which ancestor frame owns this
// captured name" — the emitter already uses it to type a transitive capture — so this asks
// the question the env-building side will answer, rather than a second copy of it. It is
// consulted ONLY for a name that is already a global or a function name (the test it
// guards), and it returns -1 immediately when the frame has no parent, which is the
// overwhelming majority of reaches.
//
// WHERE THIS DELIBERATELY BINDS THE LOCAL: a closure written BEFORE the shadowing `let`
// now captures that `let` (reading its pre-initialization zero) instead of the global.
// That matches what the SAME function body already does for a DIRECT read — wasm locals
// are function-scoped and `parentLetOf` sees the whole body, so `const r = 1 + a` before
// `const a = 10` reads the local today. The closure path was the one that disagreed.
function capRecord(name: string, bound: string[], caps: string[]) {
  if capIsBound(bound, name) { return 0 }
  if globalIndexOf(name) >= 0 || fnIndexOf(name) >= 0 {
    if parentBindingFrameOf(capFrame, name) < 0 { return 0 }
  }
  // D-CAPCALLEE: the `isBuiltinFnName` exemption used to sit HERE — at every identifier in
  // every position — and it is POSITIONAL, so it moved to `capScan`'s `Call` arm. A builtin
  // name denotes instructions where it is CALLED and nothing anywhere else, so filtering it
  // here suppressed genuine captures of a local that merely shares the name.
  if capHas(caps, name) { return 0 }
  caps.push(name)
  0
}

// Walk a statement/expression subtree collecting free-variable captures. `bound`
// grows as `let`/`const` declarations are seen (wasm locals are function-scoped, so
// once declared a name shadows an enclosing binding for the rest of the body — a
// conservative but sound match for the corpus). A NESTED FuncDecl is NOT descended
// (it is lifted to its own function with its own capture analysis); its name, if
// any, binds locally.
export function capScan(ix: i32, bound: string[], caps: string[]) {
  if ix < 0 { return 0 }
  const n = P.nodes[ix]
  if n is Ident {
    capRecord(n.identName, bound, caps)
    return 0
  }
  if n is FuncDecl {
    if n.fnName != "" { bound.push(n.fnName) }
    // A nested function's FREE variables that THIS scope does not bind are TRANSITIVE
    // captures: the nested closure's env is built inside this lifted function
    // (`emitCaptureRead` reads each capture in the enclosing frame), so a name the
    // nested body needs from an outer frame must ride this env too. Scan the nested
    // body against its OWN bound set (params + its self-name), then filter the frees
    // through `capRecord` — names bound here (params/locals), globals, and function
    // names drop out; the rest append in encounter order.
    const ibound: string[] = []
    const iparams = n.fnParams
    let ipi = 0
    while ipi < iparams.length {
      const ip = P.nodes[iparams[ipi]]
      if ip is Param { ibound.push(ip.parName) }
      ipi = ipi + 1
    }
    if n.fnName != "" { ibound.push(n.fnName) }
    const ifree: string[] = []
    capScan(n.fnBody, ibound, ifree)
    let ifi = 0
    while ifi < ifree.length {
      capRecord(ifree[ifi], bound, caps)
      ifi = ifi + 1
    }
    return 0
  }
  if n is Block {
    const stmts = n.blkStmts
    let i = 0
    while i < stmts.length {
      capScan(stmts[i], bound, caps)
      i = i + 1
    }
    return 0
  }
  if n is LetDecl {
    if n.letInit >= 0 { capScan(n.letInit, bound, caps) }
    bound.push(n.letName)
    return 0
  }
  if n is RetStmt {
    if n.retArg >= 0 { capScan(n.retArg, bound, caps) }
    return 0
  }
  if n is IfStmt {
    capScan(n.ifCond, bound, caps)
    capScan(n.ifThen, bound, caps)
    if n.ifElse >= 0 { capScan(n.ifElse, bound, caps) }
    return 0
  }
  if n is WhileStmt {
    capScan(n.whileCond, bound, caps)
    capScan(n.whileBody, bound, caps)
    return 0
  }
  if n is ForRange {
    capScan(n.frFrom, bound, caps)
    capScan(n.frTo, bound, caps)
    if n.frStep >= 0 { capScan(n.frStep, bound, caps) }
    bound.push(n.frVar)
    capScan(n.frBody, bound, caps)
    return 0
  }
  if n is ForIn {
    capScan(n.fiIter, bound, caps)
    bound.push(n.fiVar)
    capScan(n.fiBody, bound, caps)
    return 0
  }
  if n is Call {
    // D-CAPCALLEE — the ONE place a builtin/intrinsic name is exempt from capture, and it
    // is a POSITION, not a name filter. In callee position `print` / `Map` / `__load_f64__`
    // denote instructions the emitter lowers inline, so there is nothing to read out of an
    // enclosing frame; anywhere else the same spelling is an ordinary identifier and MUST
    // be captured. A callee that is NOT on the list (a closure local, a param holding a
    // function value) still falls through to the scan below, so `const cb = …; () => cb(1)`
    // keeps capturing `cb`.
    // Parens are unwrapped so `(print)(1)` reads the same as `print(1)` — the master
    // behaviour, whose filter ran inside `capRecord` and so could not see the wrapper.
    //
    // TWO lists are asked, and they PARTITION the exempt names — no name is on both.
    // `typecheck.nameIsEmitterIntrinsic` is the authoritative one: by construction exactly
    // the set of names whose CALL SITE the emitter rewrites before it looks up a
    // declaration, which is precisely the condition that makes the exemption sound. It
    // used to be private, so `emit_base.isBuiltinFnName` kept a PARTIAL COPY of it (which
    // had already drifted — the three wide store widths were missing); #1176 exported it
    // and asked it HERE, and the copy has since been deleted from `emit_base.vl`, so a new
    // inline-lowered intrinsic can no longer be reserved in one file and left capturing in
    // the other.
    //
    // `isBuiltinFnName` is still asked because it carries the six BUILTINS — `print` /
    // `toString` / `fromCodePoint(s)` / `Map` / `Set` — which are deliberately NOT on the
    // reservation list (a program may define its own `print`, so the checker does not
    // reserve the name) and therefore cannot be folded into it.
    let skipCallee = false
    const cal = P.nodes[unwrapParen(n.callFn)]
    if cal is Ident {
      if isBuiltinFnName(cal.identName) { skipCallee = true }
      if nameIsEmitterIntrinsic(cal.identName) { skipCallee = true }
    }
    if !skipCallee { capScan(n.callFn, bound, caps) }
    const args = n.callArgs
    let i = 0
    while i < args.length {
      capScan(args[i], bound, caps)
      i = i + 1
    }
    return 0
  }
  if n is BinExpr {
    capScan(n.binLeft, bound, caps)
    capScan(n.binRight, bound, caps)
    return 0
  }
  if n is Unary {
    capScan(n.unArg, bound, caps)
    return 0
  }
  if n is Paren {
    capScan(n.parInner, bound, caps)
    return 0
  }
  if n is Member {
    capScan(n.memObj, bound, caps)
    return 0
  }
  if n is OptMember {
    capScan(n.omObj, bound, caps)
    return 0
  }
  if n is Index {
    capScan(n.idxArr, bound, caps)
    capScan(n.idxIndex, bound, caps)
    return 0
  }
  if n is IsExpr {
    capScan(n.isObj, bound, caps)
    return 0
  }
  if n is AsExpr {
    capScan(n.asObj, bound, caps)
    return 0
  }
  if n is ObjLit {
    const fields = n.objFields
    let i = 0
    while i < fields.length {
      const f = P.nodes[fields[i]]
      if f is FieldInit { capScan(f.fiValue, bound, caps) }
      i = i + 1
    }
    return 0
  }
  if n is ArrayLit {
    const elems = n.arrElems
    let i = 0
    while i < elems.length {
      capScan(elems[i], bound, caps)
      i = i + 1
    }
    return 0
  }
  0
}

// The env struct heap-type index for the lifted function at index `fe`, or -1 if it
// captures nothing (its closure env is `ref.null structref`). Resolved by
// `mAssignTypeIndices` into `fnEnvIdx`.
export function fnEnvIdxOf(fe: i32) {
  if fe < 0 || fe >= fnEnvIdx.length { return -1 }
  fnEnvIdx[fe]
}

// True if function `fe`'s env-leading signature matches an interned `$fnsig`
// `(structref, params...) -> ret` (`fnSigKeyOf` eligibility: i32/boolean, f64, or
// struct-ref params; an i32/boolean or f64 result; non-void). Such a function is
// declared with `fnSigIdxOfFn` as its functype (so its ACTUAL type IS `$fnsig`),
// which is what the call site's `call_indirect $fnsig` signature-checks the callee
// against. A function outside the eligible kinds keeps its own functype and cannot
// be used as a value (none in the corpus are).
export function fnSigIsClosure(fe: i32) { fnSigIdxOfFn(fe) >= 0 }

// The `fnStmts` POSITION of the enclosing frame whose binding a captured `name`
// resolves to — the direct parent when it binds `name` (a param or a body `let`),
// else the nearest ANCESTOR frame that does (a TRANSITIVE capture: every
// intermediate lifted function re-captures the name into its own env, so the VALUE
// flows env-to-env, but the TYPE lives at the owning frame's binding). -1 when no
// ancestor binds it.
function parentBindingFrameOf(fe: i32, name: string): i32 {
  if fe < 0 || fe >= fnParent.length { return -1 }
  const par = fnParent[fe]
  if par < 0 || par >= fnStmts.length { return -1 }
  const pfn = P.nodes[fnStmts[par]]
  if pfn is FuncDecl {
    const params = pfn.fnParams
    let i = 0
    while i < params.length {
      const p = P.nodes[params[i]]
      if p is Param {
        if p.parName == name { return par }
      }
      i = i + 1
    }
    if parentLetOf(pfn.fnBody, name) >= 0 { return par }
    return parentBindingFrameOf(par, name)
  }
  -1
}

// The arena index of the enclosing frame's binding for a captured `name` — the owning
// frame's matching `Param` node, or a `LetDecl` in its body, or -1. Resolves through
// `parentBindingFrameOf`, so a TRANSITIVE capture (the binding lives frames above the
// direct parent) types exactly as a direct one. Used to resolve a capture's wasm
// valtype (its declared type lives in the owning frame).
function parentBindingOf(fe: i32, name: string) {
  const par = parentBindingFrameOf(fe, name)
  if par < 0 { return -1 }
  const pfn = P.nodes[fnStmts[par]]
  if pfn is FuncDecl {
    const params = pfn.fnParams
    let i = 0
    while i < params.length {
      const p = P.nodes[params[i]]
      if p is Param {
        if p.parName == name { return params[i] }
      }
      i = i + 1
    }
    return parentLetOf(pfn.fnBody, name)
  }
  -1
}

// The enclosing-frame BINDING a CAPTURED `name` of the capturing lifted function `fnIx`
// resolves to — a `Param` or a `LetDecl` arena index — or -1 when `name` is not a capture of
// `fnIx`. THE capture channel for the expression classifiers, and the reason they cannot
// disagree with the env struct: `captureValKind` below types the env FIELD off this very
// binding, so a classifier answering "what rep does this READ have" from the same node is
// answering the same question about the same declaration. The guards mirror
// `capturedStructIndex`'s.
function capturedBindingOf(fnIx: i32, name: string) {
  if fnIx < 0 { return -1 }
  if !fnValUsed { return -1 }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return -1 }
  const caps = captureNamesOf(fe)
  let ci = 0
  while ci < caps.length {
    if caps[ci] == name { return parentBindingOf(fe, name) }
    ci = ci + 1
  }
  -1
}

// The ARENA index of the `FuncDecl` whose frame OWNS a captured `name`'s binding, or -1.
// `capturedBindingOf`'s companion: an UN-ANNOTATED binding is classified from its
// INITIALIZER, and an initializer only resolves in the frame it was written in.
// `parentBindingFrameOf` answers in `fnStmts` POSITIONS while every classifier's `fnIx` is an
// arena index, so the conversion lives here rather than at each caller.
function capturedBindingFrameOf(fnIx: i32, name: string) {
  if fnIx < 0 { return -1 }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return -1 }
  const par = parentBindingFrameOf(fe, name)
  if par < 0 || par >= fnStmts.length { return -1 }
  fnStmts[par]
}

// The `fbValtype` kind for a captured variable `name` of lifted function `fe`,
// resolved against the parent frame's binding (a param's annotation, or a local
// `let`'s annotation / struct-literal initializer). Defaults to i32 (kind 0).
export function captureValKind(fe: i32, name: string): VKind {
  const b = parentBindingOf(fe, name)
  if b < 0 { return "i32" }
  const bn = P.nodes[b]
  if bn is Param { return vtKindOfType(bn.parType) }
  if bn is LetDecl {
    if bn.letType >= 0 { return vtKindOfType(bn.letType) }
    // Un-annotated local: classify the INITIALIZER through the same ladder
    // `collectLocals` types the binding with (resolved in the OWNING frame), so
    // a captured list/string/struct env field carries its real ref valtype —
    // `const store = [a, b]` captured by a closure is the i32-list wrapper ref
    // (kind 2), not an i32 cell. Order mirrors `collectLocals`; the ladder itself
    // is `letInitCellKind`, shared with the implicit-return assignment target.
    //
    // `pf` IS AN `fnStmts` POSITION, and the `letIs*` family's second argument is an
    // ARENA index (each one indexes `P.nodes[fnIx]` / forwards it to `exprIs*`). Kept
    // exactly as master passes it — the two number spaces coincide only at the small
    // indices, so the frame-dependent arms of the ladder read a non-`FuncDecl` node and
    // decline; every capture the corpus has resolves through an arm that does not need
    // the frame. Changing it here would move bytes, so it is FILED, not fixed.
    if bn.letInit >= 0 {
      return letInitCellKind(b, parentBindingFrameOf(fe, name))
    }
  }
  "i32"
}

// The second `fbValtype` arg (struct table index) for a captured struct-ref variable.
export function captureValStructIdx(fe: i32, name: string) {
  const b = parentBindingOf(fe, name)
  if b < 0 { return -1 }
  const bn = P.nodes[b]
  // A captured MAP binding's companion slot is its map SHAPE (mono ⇒ -1, or the value
  // type's mv slot) — the SAME `mapAnnShape` the local/param/return valtypes resolve, so the
  // env field's `$mapStruct` heap type matches the captured map value's exactly (a typed
  // `{[string]: f32}` capture is `(ref $mvMapTypeIdx)`, not the mono `$mapStruct`). Mirrors
  // `captureValKind`, whose annotation arm already yields "map"; without this the annotated
  // arms fell through to `retStructIndex` (−1 for a map) and the env boxed a typed map into a
  // mono field — invalid wasm at the closure `struct.new`.
  if bn is Param {
    if retMapFlag(bn.parType) == 1 { return mapAnnShape(bn.parType) }
    return retStructIndex(bn.parType)
  }
  if bn is LetDecl {
    if bn.letType >= 0 {
      if retMapFlag(bn.letType) == 1 { return mapAnnShape(bn.letType) }
      return retStructIndex(bn.letType)
    }
    if bn.letInit >= 0 {
      const pf = parentBindingFrameOf(fe, name)
      // The kind-specific companion index, mirroring `captureValKind`'s ladder:
      // a map capture carries its mv SHAPE slot, a nullable-struct / struct
      // capture its struct table index, a ref-list capture its ref-list slot.
      if letIsMap(b, pf) { return letMapShapeOf(b, pf) }
      if letIsNulRef(b, pf) { return nulRefStructIdxOfLet(b, pf) }
      if letIsRefArray(b, pf) { return letRefListSlot(b, pf) }
      const iv = P.nodes[bn.letInit]
      if iv is ObjLit { return structIndexOfExpr(bn.letInit, pf) }
    }
  }
  -1
}

// Enter a new lexical block: remember the current binding count as this frame's
// boundary. Returns 0.
export function scopePush() {
  scopeFrames.push(scopeNames.length)
  0
}

// Leave the innermost lexical block: drop its frame boundary and discard every
// binding appended within it (truncate `scopeNames`/`scopeSlots` back to the mark).
// Returns 0.
export function scopePop() {
  if scopeFrames.length == 0 { return 0 }
  const mark = scopeFrames[scopeFrames.length - 1]
  scopeFrames.pop()
  while scopeNames.length > mark {
    scopeNames.pop()
    scopeSlots.pop()
  }
  0
}

// Bind name `name` to declared-local position `slot` in the CURRENT (innermost) frame.
// Called as each `let` is reached, so a binding is in scope only AFTER its declaration
// (sequential), which also yields correct shadowing of an outer same-named binding.
// Returns 0.
export function scopeBind(name: string, slot: i32) {
  scopeNames.push(name)
  scopeSlots.push(slot)
  0
}

// Drop the most recent binding — the loop-VARIABLE unbind. A `for` binds its
// variable in the ENCLOSING frame (no frame of its own), but the variable's
// scope is the LOOP (host parity: the loop declares it in the loop's scope), so
// both passes unbind it as the loop closes. Without this the loop var would
// keep shadowing a same-named binding that resolves through a LATER channel
// (e.g. a top-level `let` lowered to a wasm GLOBAL — locals win the lookup), so
// `for i in …` followed by `let i = 0` mis-read the dead loop counter.
// Returns 0.
export function scopeUnbind() {
  scopeNames.pop()
  scopeSlots.pop()
  0
}

// The declared-local POSITION bound to `name` by the innermost live scope frame, or
// -1 if `name` is not a live lexical binding. Searches the scope stack top-down
// (innermost first), so a shadowing inner `let` wins over an outer same-named one.
function scopeSlotOf(name: string) {
  let k = scopeNames.length
  while k > 0 {
    k = k - 1
    if scopeNames[k] == name { return scopeSlots[k] }
  }
  -1
}

// Opening a control frame: bump the running depth. Returns 0.
export function ctrlEnter() {
  ctrlDepth = ctrlDepth + 1
  0
}

// Closing a control frame (its matching `end`): drop the running depth. Returns 0.
export function ctrlLeave() {
  ctrlDepth = ctrlDepth - 1
  0
}

// The wasm local base of the ref-push scratch frame for ref-list table slot `slot`.
export function refPushScratchBaseFor(slot: i32) {
  let i = 0
  while i < fnRefPushSlots.length {
    if fnRefPushSlots[i] == slot { return refPushBaseBySlot[i] }
    i = i + 1
  }
  refPushScratchBase
}

// Resolve a value type-NAME to a struct TABLE index: a declared struct by name, or
// an inline object type `{a:T,b:U}` matched against the table (anonymous shapes are
// interned from literals by `collectAnonShapes` under `#anonN` names, so the
// annotation text never matches by name — the field set is the key, exactly how
// `structIndexOfObj` binds literals). -1 when nothing matches.
//
// The match is FIELD-TYPE-GUARDED (`structIndexOfTypeName`, the whole-span shape
// resolver), not field-NAME-only: a map's value struct (`{a:f64,f:f64,z:string}`)
// coexisting with a same-fieldset OUTER literal
// (`{a:string|null,f:()=>i64,z:(…)=>…}`) shares the field-name set {a,f,z} but
// differs in every field's TYPE. The old name-only scan keyed the FIRST {a,f,z}
// row (the outer struct, interned first), minting the map's vals ref-list over the
// wrong struct and building the `??`-default value literal with the wrong layout —
// invalid wasm at the value store (fuzz multiobs seed 301346386 case_00047).
// `shapeFieldTypeCompat` rejects only PROVEN mismatches, so the unambiguous
// single-candidate path stays byte-identical.
function structIndexByValName(name: string) { structIndexOfTypeName(name) }

// The mv value KIND of a map VALUE type-name — the ONE enumeration of which value types a
// string-keyed map supports (`mvValKind` vocabulary): `-1` a mono i32 value (i32 / boolean /
// literal-union atom — the value IS an i32, riding the shared mono `$mapStruct`), `-3`
// unsupported, else the per-slot kind (3 string · 11 f64 · 10 i64 · 13 f32 · 6 ref-list /
// nested-map value · 2 union box · 14 closure · 1 struct). Read by BOTH `mvShapeOfValName`
// (the slot interner — the local path) and `retMapFlag` (the param/return valtype gate) so
// the two cannot drift: when the gate enumerated the value types independently it lacked the
// scalar/atom/closure/union arms, and an annotated map return fell through to an i32 result
// valtype over a ref-returning body — invalid wasm at the return seam.
// The single non-null member of a NICHE-nullable map VALUE name — `{f: …} | null` yields
// the struct member, `{[string]: V} | null` the map member — or "" when `valName` is not
// `X | null` with exactly ONE non-null member of a kind the nullable-value map rep covers
// (a struct shape or a map). The chokepoint `mvValKindOfName` / `mvShapeOfValName` / the
// map op sites strip through, so the slot shares its vals rep (and heap dedup) with the
// non-null twin.
export function nulRefMapValInnerOf(valName: string): string {
  if !unionSetHasNull(valName) { return "" }
  const atoms: string[] = []
  splitUnionAtoms(valName, atoms)
  let inner = ""
  let nonNull = 0
  let i = 0
  while i < atoms.length {
    if atoms[i] != "null" {
      nonNull = nonNull + 1
      inner = atoms[i]
    }
    i = i + 1
  }
  if nonNull != 1 { return "" }
  if inner == "string" { return inner }
  if nameIsBareMap(inner) { return inner }
  // A CLOSURE member (`(() => string) | null` — the member keeps its grouping parens, so the
  // arrow sits at paren depth 1): the closure fat-pointer rides the SAME `(ref null
  // $cloStruct)` vals element a non-null closure value uses — the closure niche of the
  // nullable-value map. A top-level arrow on the RAW member would be a function RETURNING a
  // nullable (never produced by `splitUnionAtoms`, which only yields depth-0 `|` members).
  if annArrowAt(peelGroupParens(inner)) >= 0 { return inner }
  // A LIST member (`{f: f64}[] | null`) has NO niche rep yet — the vals slot would need
  // the list's WRAPPER element, not the element struct's. Excluded BEFORE the struct
  // probe: `structIndexByValName`'s field-name parse ignores the trailing `[]`, so
  // `{f: f64}[]` matched the ELEMENT struct `{f: f64}` and the slot minted kind 1 —
  // the list store then pushed a `(ref $rlWrap)` into a `(ref null $struct)` vals
  // element, INVALID-WASM (fuzz frontier seed 615401451 d6 --branching, p2c
  // `{[string]: {f: f64}[] | null}`). Returning "" keeps the -3 loud-reject path.
  if nameIsArray(inner) { return "" }
  if structIndexByValName(inner) >= 0 { return inner }
  ""
}

// True when the interned mv slot's value is a NICHE-nullable ref value (`{f: …} | null` /
// `{[string]: V} | null`): the vals element legitimately holds null — the store seeds
// `ref.null <elem>` for a bare `null` and the fused `?? d` read skips the non-null recover.
export function mvSlotNullable(slot: i32) {
  if slot < 0 { return false }
  const ar = mvValNulRefNicheAt(slot)
  if ar >= 0 { return ar == 1 }
  nulRefMapValInnerOf(mvValName[slot]) != ""
}

// True when a BOXED value-union map slot's value is exactly `scalar | null` (one non-null
// scalar member + null): the fused `m[k] ?? d` coalesce peels it to the RAW unboxed scalar
// (`emitMapGetOrUnionBox`), NOT a union box — so the `??` result classifies as that scalar
// (i32/i64/f64/f32), never a union. A multi-member `A | B | null` stays a boxed union.
export function mvUnionIsScalarNull(slot: i32) {
  if slot < 0 { return false }
  if mvValKind[slot] != 2 { return false }
  const ar = mvValUnionScalarNullAt(slot)
  if ar >= 0 { return ar == 1 }
  const vn = mvValName[slot]
  if !unionSetHasNull(vn) { return false }
  const atoms: string[] = []
  splitUnionAtoms(vn, atoms)
  if atoms.length != 2 { return false }
  // NOT migrated onto the set ADT: this tail sits behind the arena chokepoint
  // `mvValUnionScalarNullAt` AND a 2-member gate, and it answered on 0 of the 1,269
  // corpus files and 0 of 25,200 fuzz programs — no witness to sabotage-verify
  // against, so it keeps the string surgery (method note 6).
  const ak = valueAtomKind(removeAtomFrom(vn, "null"))
  ak >= 0 && ak != 2 && ak != 6
}

// THE ONE HOME of the SCALAR-ELEMENT LIST classification: which of the five scalar
// backings a list type-name rides, or `-1` for "not a scalar-element list".
//
//   0 = the i32-backed list — `i32[]`, `boolean[]`, a literal-union `K[]`, and the two
//       niche forms `(boolean|null)[]` / `(K|null)[]` (all one `lTypeIdx` wrapper)
//   1 = the string-backed list — `string[]` and `(string|null)[]` (`$mkListIdx`)
//   2 = `f64[]`   ·   3 = `i64[]`   ·   4 = `f32[]`   (each its own wrapper heap)
//
// FIVE classifiers wrote this same five-predicate ladder out by hand — `mvValKindOfName`
// (as a five-way `||` disjunction), `fieldCodeOfSpelling` (→ field codes 4/6/25/26/27),
// `forceCloResultListTypes` (→ the `slUsed`/`fa64Used`/`ia64Used`/`fa32Used`/`lUsed` type
// flags), and the two `$fnsig` ABI producers `annParamKind` / `annRetKind` (→ the
// `list`/`strlist`/`f64list`/`i64list`/`f32list` tokens). Twenty-five calls, five places
// that each had to re-decide that this enumeration is CLOSED and what its members are —
// and five places a sixth scalar backing would have to be added to, in agreement.
//
// The five predicates are pairwise DISJOINT (`nameIsF64Array`/`nameIsI64Array`/
// `nameIsF32Array` are whole-name equalities on `f64[]`/`i64[]`/`f32[]`; `nameIsI32Array`
// and `nameIsStringArray` admit only the i32-backed and string-backed niches, and a
// litunion element is all-quoted where `string`/`null` are not), so the ORDER of the arms
// is not load-bearing and the copies' three different orders are one answer. Probe P1
// measures that disjointness rather than asserting it.
//
// NOT folded in, each with the reason: `tyAnnRefListKind` and `nulScalarListKind` look
// like this ladder but SPLIT what this one FOLDS — they answer `nameIsNulBoolList` /
// `nameIsNulLitUnionList` / `nameIsNulStrList` as their own kinds, which arm 0/1 here
// deliberately absorbs. `mvShapeOfValName`'s three arms and `rlElemStoredName`'s two are
// PREFIXES of this ladder that never ask the remaining arms — routing them here would add
// predicate calls the sites never used to pay (method note: a bank-first ladder in front
// of a resolver that already cheap-rejects is a work regression).
export function scalarListKindOfName(t: string): i32 {
  if nameIsI32Array(t) { return 0 }
  if nameIsStringArray(t) { return 1 }
  if nameIsF64Array(t) { return 2 }
  if nameIsI64Array(t) { return 3 }
  if nameIsF32Array(t) { return 4 }
  -1
}

// True if the BARE MAP spelling `mapName` has a value type the mv layer can lower —
// `mvValKindOfName` of its VALUE, tested against the `-3` unsupported sentinel. FIVE
// classifiers (the local / return / nullable-return / field / non-lowerable-field
// gates) each wrote `mvValKindOfName(mapValNameOf(x)) != -3`: five sites deciding
// separately that the way to reach a map's value kind is to SLICE the value out of the
// map's spelling, and five sites that have to be found and changed together if the
// unsupported sentinel ever moves.
function mapValKindLowerable(mapName: string) {
  mvValKindOfName(mapValNameOf(mapName)) != -3
}

// The recorded-type twin of `mapValKindLowerable`: true if the map type the CHECKER
// RECORDED on node `ix` has a value the mv layer can lower. An INFERRED map puts no map
// spelling in the arena at all, so there is nothing to slice a value name out of — the
// value name comes off the arena render instead. Same `-3` sentinel, one home.
function mapNodeValKindLowerable(ix: i32) {
  mvValKindOfName(nodeTyMapValName(ix)) != -3
}

export function mvValKindOfName(valName: string): i32 {
  if valName == "i32" || valName == "boolean" { return -1 }
  // A literal-union ATOM value (`{[string]: K0}`, `K0 = "aa" | "bb"`): each value IS the
  // interned atom code — a plain i32 — so the map is the MONO i32 map. Checked BEFORE the
  // union arm, whose member count would otherwise claim the alias and BOX the values (the
  // store coerced the i32 atom into a union box the read then handed to an i32 consumer).
  if nameIsLitUnionType(valName) { return -1 }
  // A NULLABLE-ATOM value that reps as a plain i32 NICHE (no box): a nullable litunion
  // (`K0 | null` — atom ids ≥ 0, `-1` = null) or a nullable boolean (`boolean | null` —
  // 0/1, `2` = null). Each value IS an i32 with a spare sentinel, so the map is the MONO i32
  // map — NOT a ref-VALUE map. Checked BEFORE the union arm below, whose member count (`K0`'s
  // members + `null`, or `boolean` + `null`) would else claim it and BOX the values into a
  // union box (the store coerced a raw i32 niche into a `(ref $box)` cell — invalid wasm).
  if nameIsNulLitUnion(valName) || nameIsNulBool(valName) { return -1 }
  // A NULLABLE union value. Three sound shapes, one loud remainder:
  //   · a NICHE nullable REF value — ONE struct (`{f: …} | null`) or map
  //     (`{[string]: V} | null`) member + null — rides the SAME vals rep as its
  //     non-null twin: the `(ref null <elem>)` vals slot carries a stored null
  //     DIRECTLY, a bare `null` stores `ref.null <elem>`, and the fused `?? d`
  //     read PRESERVES a stored null (the hit arm skips the non-null recover —
  //     the default fires only on a MISSING key, the corpus oracle's semantics).
  //     The read binds the corresponding NULLABLE local kind (`nulstruct`/`nulmap`).
  //   · a pure scalar/string nullable value-union (`i32 | null`, `i64 | string |
  //     null`) boxes fine — the shared value box has a null tag; the nullable-atom
  //     NICHE forms (`K0 | null` / `boolean | null`) rep as a plain i32 above.
  //   · a nullable union with TWO OR MORE non-null members carrying a ref member
  //     (`{f: {[string]: f64}} | {w: i32} | null`) is a BOX union: `null` boxes as
  //     the null-tagged box at the store (`emitUnionCoerce`'s NullLit arm), so the
  //     vals element itself is never null — it falls to the union arm below.
  //   · a SINGLE list / closure / bare-string member + null has no nullable-value
  //     rep yet (`string | null` is not a value union — no box is ever minted; a
  //     list/closure niche needs its own wrapper slot): reject loudly at every op
  //     site, never invalid wasm.
  if unionSetHasNull(valName) {
    const nin = nulRefMapValInnerOf(valName)
    if nin != "" {
      if nin == "string" { return 3 }
      if nameIsMap(nin) { return 6 }
      // A NULLABLE-CLOSURE value (`(() => string) | null`): kind 14 — the vals element is
      // already the `(ref null $cloStruct)` fat-pointer, so the niche rides the non-null
      // closure rep (a bare `null` stores `ref.null`, the fused `?? d` read preserves a
      // stored null). A litunion RESULT (`((i32) => K0) | null`) stays a loud reject: the
      // read stays nullable (the hit arm preserves a stored null), so the call needs a
      // narrowed spelling the checker does not yet accept for this value shape — the
      // atom-result recovery the NON-null closure arm has cannot be exercised through it.
      const ncl = peelGroupParens(nin)
      const nca = annArrowAt(ncl)
      if nca >= 0 {
        // The ARROW-relative RETURN cut at its home (`tyname.fnRetTextOf`), given the
        // index this site already holds. What stays here is the LEADING-SPACE skip,
        // which is a different operation and has no home: an annotation spelling keeps
        // the source's spaces (`() => K0`), and `nameIsLitUnionType` opens with an
        // EXACT `cUserTypes` lookup, so a leading space would miss the alias outright.
        const nret = fnRetTextOf(ncl, nca)
        let nri = 0
        while nri < nret.length && nret[nri] == ' ' { nri = nri + 1 }
        if nameIsLitUnionType(nret.slice(nri, nret.length)) { return -3 }
        return 14
      }
      return 1
    }
    const nulAtoms: string[] = []
    splitUnionAtoms(valName, nulAtoms)
    let nonNull = 0
    let refMember = false
    let na = 0
    while na < nulAtoms.length {
      if nulAtoms[na] != "null" {
        nonNull = nonNull + 1
        const nvk = valueAtomKind(nulAtoms[na])
        if nvk < 0 || nvk >= 7 { refMember = true }
      }
      na = na + 1
    }
    if refMember && nonNull < 2 { return -3 }
    if !refMember && !isValueUnionName(valName) { return -3 }
  }
  let kind = -1
  if valName == "string" {
    kind = 3
  } else if valName == "f64" {
    // An f64-valued map: its vals list is the scalar f64 list (`$fl64TypeIdx` wrapper /
    // `$fa64TypeIdx` backing), NOT a ref list. Rides the existing mv-slot frame, but the
    // value is a scalar — its typed valStash is an f64 local (not a nullable ref).
    kind = 11
  } else if valName == "i64" {
    // An i64-valued map: the scalar i64 list (`$il64TypeIdx`/`$ia64TypeIdx`); valStash i64.
    kind = 10
  } else if valName == "f32" {
    // An f32-valued map: the scalar f32 list (`$fl32TypeIdx`/`$fa32TypeIdx`); valStash f32.
    kind = 13
  } else if nameIsBareMap(valName) {
    // A NESTED map (`{[string]: {[string]: V}}`): the value is an INNER map struct ref,
    // stored in a ref list whose element kind is 3 (a map element → the inner map struct).
    // Reuses the SAME ref-value spine as a struct-valued map; only the element heap differs.
    // The member-union guard keeps a map-FIRST union value (`{[string]: i32} | f64` — a name
    // `nameIsMap` matches but which is a union BOX, not a nested map) out of this arm, so it
    // reaches the union arm below (where a map MEMBER is rejected loudly — see there).
    // The inner-value chain resolves recursively to ANY depth — a triple-nested map, or one
    // bottoming out in a list of maps (`{[string]: {[string]: {[string]: f32}[]}}`) — through
    // the same `ensureRefElem`/`mvShapeOfValName` mutual recursion the intern side uses.
    kind = 6
  } else if scalarListKindOfName(valName) >= 0 {
    // A LIST-valued map (`{[string]: i32[]}` / `string[]` / `f64[]` / `i64[]` / `f32[]` /
    // `boolean[]`): the value is a list WRAPPER ref, stored in a ref list whose element kind
    // picks the inner list's wrapper (`refArrElemKind("<value>[]")` → 4/6/7/8/10). Same ref-value
    // spine as a nested map.
    kind = 6
  } else if nameIsRefArray(valName) {
    // ANY ref-array map value — struct-list (`S[]`), union-list (`(C|D)[]`), a NESTED `S[][]` /
    // `i32[][]`, or a closure list (`((i32)=>i32)[]`): the value is a list WRAPPER ref, stored in
    // a ref-value list whose element is this value's wrapper (`ensureRefElem`, recursive). The
    // store seeds the value literal off this slot and the read classifies the value's element
    // recursively, so any nesting / leaf falls out — one predicate, no per-shape special cases.
    // A list-of-MAPS element (`{[string]: {[string]: V}[]}`) resolves through the same
    // recursion: `ensureRefElem`'s map-element arm interns the inner map's own value slot
    // BEFORE this slot's parallel arrays are pushed (`mvShapeOfValName`'s kind-6 pre-block),
    // so the deep element read lands on a fully-resolved slot.
    kind = 6
  } else if unionMemberCount(unionMemberSetOf(valName)) > 1 {
    // A UNION-valued map: each value is the shared union BOX ref (`uBoxIdx`), stored in a ref
    // list whose element kind is 2 (the union box) — the SAME ref-value spine as a struct
    // value, only the element heap + the store-coerce / read-classify differ. Covers a VALUE
    // union (`{[string]: i32 | string}`), a STRUCT / heterogeneous union (`{[string]: C | S}`),
    // a union ALIAS (`type Shape = C | S`; `unionMemberSetOf` expands it before the count`),
    // and a union with a MAP member (`{[string]: {[string]: i32} | boolean}`): the map arm
    // boxes exactly as it does in BINDING position — the store/read seams route through
    // `emitUnionBoxArg` → `emitUnionCoerce`, whose map-carrier arm tags the map-struct ref
    // with the arm's `mapSlotTag`; `mvShapeOfValName` interns the arm's mv slot
    // (`markMapUnionArms`) so the tag and the narrowed read resolve the same slot.
    kind = 2
  } else if annArrowAt(valName) >= 0 {
    // A FUNCTION-valued map (`{[string]: (i32) => i32}`): each value is a closure fat-pointer
    // (`ref $cloStructIdx`), stored in a ref list whose element kind is 5 (the closure) — the
    // SAME rep an `((i32) => i32)[]` array uses. A read yields a closure local; the call
    // resolves its sig from the value annotation. A litunion RESULT (`(i32) => K0`) rides the
    // same rep: the call's `$fnsig` keys the i32 atom (`>i`) and the atom widens to its member
    // string at the print seam — `exprString`'s value-call arm gates its per-name `>S` claim on
    // the call node's litunion-alias type, so the `??`-bound callee's SOFTENED render
    // (`(i32) => string`) never routes the raw atom into the string path.
    kind = 14
  } else {
    if structIndexByValName(valName) >= 0 { kind = 1 }
  }
  if kind < 0 { return -3 }
  kind
}

// Classify + intern a map VALUE type-name, returning the binding's map SHAPE code:
// `-1` mono i32 map (i32 / boolean / atom values), a slot `>= 0` for a ref/scalar
// value type, or `-3` unsupported (the op sites fail loudly). Interning is
// idempotent (one slot per distinct name). Kind-1 (struct) values force the
// element's ref-list types (`rlInternName`), and every ref-valued map forces the
// string-list (keys) + mono map types — the shared probe machinery and the keys
// list ride on them.
// Canonicalize a map-VALUE union name for the mv table so that two spellings of ONE value
// union cannot intern TWIN mv slots with divergent vals reps — the narrowed map read then
// resolves the wrong twin's struct, INVALID-WASM (fuzz-nightly seed 658239060 d5). The
// canon is a DESCENT, not a widening: it reaches litunion atoms nested under `[]` / `{…}`
// so every producer keys one slot. Since the owner ruling of 2026-07-29 a litunion-ALIAS
// atom is PRESERVED at every depth (`K0|i64|null` stays `K0|i64|null`), because both
// checker producers spell it that way and this table is queried with what they spell. A
// non-union / alias-free name passes through unchanged.
export function mvCanonValName(valName: string) {
  // RUNAWAY CAP (the `repNameCanonKey` crash family): a value spelling this long is
  // never a legit mv key — pass it through untouched so the kind classifier's -3
  // unsupported path fails LOUDLY instead of splitting/rendering a runaway name.
  if valName.length > 4096 { return valName }
  // A ref-LIST value (`(K0|i32)[]`, the map value of `{[string]: (K0|i32)[]}`): canon its
  // element union THROUGH the array wrapper — the same canon `rlInternName` keys the vals
  // ref-list slot on. Without this the annotation spelling and a self-inferred
  // factory-return lambda (`() => (h0)`) minted twin mv/map structs, a cast TRAP at the
  // returned-map read. (Func-type element arrays are left untouched inside.)
  if nameIsElemArray(valName) { return rlCanonLitUnionAtoms(valName) }
  // A STRUCT / nested-MAP value (`{f: K0 | f64}` — the value of `{[string]: {f: K0|f64}}`):
  // canon its field / value unions THROUGH the shape, the struct sibling of the ref-list
  // `[]` arm above. Without this the annotation and a self-inferred factory-return lambda
  // minted twin mv slots → twin map/functypes → a `$fnsig` cast TRAP at the returned-map
  // read. (Both producers now spell the litunion atom the same way, so what this arm
  // reconciles is the nesting, not the alias.)
  //
  // The WIDE brace-endpoint span at its home (`emit_base.nameIsBraceSpanEnds`): this arm
  // must see a MAP value as well as a struct one, so it is deliberately NOT
  // `nameIsShapeSpanEnds` (which excludes `{[`) and NOT `nameIsWholeSpanShape` (which adds
  // a balance walk). The hand-written bound was `vn > 1`, i.e. the home's `length >= 2`
  // exactly, and `vn` had no other reader — so the local dies with the character compares.
  if nameIsBraceSpanEnds(valName) { return rlCanonLitUnionAtoms(valName) }
  if unionMemberCount(valName) < 2 { return valName }
  canonLitUnionArms(valName)
}

// THE LITUNION-ARM CANON, WRITTEN ONCE. `mvCanonValName` (above) and
// `rlCanonLitUnionAtoms` (the ref-list element normalizer) each carried this
// thirty-line body VERBATIM — same split, same niche guard, same descent loop, same
// "unchanged ⇒ return the original" fall-through — differing only in the name of the
// parameter. Two copies of a union grammar are two copies of the split inside it, and
// two places for the R3 boxed-member rule to drift.
//
// THE WIDENING LEG IS GONE (owner ruling 2026-07-29). This function used to rewrite a
// litunion-ALIAS atom of a genuine MIX to `string`; it is the EMITTER's copy of the rule
// the two checker producers carry, and when they moved to PRESERVE it had to move with
// them — a re-widening here queries the union registry under a spelling no row was ever
// minted with, so a value union failed the box lookup it had registered itself
// (`union box atom test on a union with no recorded members: string|f64`, 4 corpus files).
// What survives is the DESCENT: a non-litunion atom recurses (a nullable struct value
// `{f: K0|f64} | null` carries its union one level down) so the nested spelling keys the
// same slot as the flat one. The `hasOther` MIX gate is kept even though nothing widens
// any more — a pure `K0 | null` is the -1-sentinel MONO niche (`nameIsNulLitUnion`), not
// the string-atom box, and the gate is what states that the two are different reps.
//
// Callers keep their own cardinality gate, because they spell it differently for a
// reason: `mvCanonValName` returns early on a non-union, `rlCanonLitUnionAtoms` falls
// through to its own tail. Both reach here only with 2+ top-level atoms.
function canonLitUnionArms(name: string): string {
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  let hasOther = false
  let h = 0
  while h < atoms.length {
    if atoms[h] != "null" && !nameIsLitUnionType(atoms[h]) { hasOther = true }
    h = h + 1
  }
  if !hasOther { return name }
  let changed = false
  let canon = ""
  let i = 0
  while i < atoms.length {
    let a = atoms[i]
    // A litunion-ALIAS atom is PRESERVED (owner ruling 2026-07-29). The two CHECKER
    // producers no longer soften, so re-widening the atom here would query the union
    // registry under a spelling no row was minted with — registration and query stop
    // agreeing, and the box lookup fails on a union it registered itself.
    if !nameIsLitUnionType(a) && a != "null" {
      const ra = rlCanonLitUnionAtoms(a)
      if ra != a {
        a = ra
        changed = true
      }
    }
    if i > 0 { canon = canon + "|" }
    canon = canon + a
    i = i + 1
  }
  if changed { return canon }
  name
}

// The mv table's NAME scan — first-match-wins over the recorded canonical value
// spellings, WITHIN one key rep. The legacy key of the map-value slot layer, shared by
// every entry point so the one scan order is stated once. The `keyI32` argument is the
// slot identity's other half: `{[string]: S}` and `{[i32]: S}` record the SAME value
// spelling and are two layouts, so a key-blind scan would hand the second map the first
// one's struct (a string-ref keys list read as an i32 list — invalid wasm).
export function mvSlotByValNameK(valName: string, keyI32: boolean): i32 {
  let i = 0
  while i < mvValName.length {
    if mvValName[i] == valName {
      if mvSlotKeyI32(i) == keyI32 { return i }
    }
    i = i + 1
  }
  -1
}
// The mv shape of a BARE MAP spelling — `mvShapeOfValName` of the map's VALUE. Five call
// sites composed these two by hand, which meant five sites each deciding, locally, that
// the way to get from `{[string]: V}` to its value rep is to SLICE `V` out of the
// spelling. One home: when the map's value comes off the arena instead
// (`T.tys[m] is TyMap` → the value ty), there is one call to change.
//
// THIS IS THE ONE PLACE THE KEY ENTERS THE MV LAYER. Every other resolver takes the key
// as an argument; this one reads it off the map spelling itself, so an i32-keyed map's
// VALUE interns against the i32-keyed key rep without any caller being taught.
//
// …AND THE "ONE CALL TO CHANGE" IS NOT THIS ONE — D-MAPNODETY BUILT IT AND TOOK IT BACK.
// The two `collectA` `TypeRef`-walk callers hold the annotation NODE, so the value type is
// free (`nodeMapValTyIx`); routing it emitted INVALID WASM on
// `tests/cases/maps/alias-positions-and-value-kinds.vl`, because this path MINTS. The rule
// that came out of it is on `mvShapeOfValNameK` below.
export function mvShapeOfMapName(mapName: string) {
  const ki = nameIsI32KeyedMap(mapName)
  const sh = mvShapeOfValNameK(mapValNameOf(mapName), ki)
  // A MONO value (i32 / boolean / a literal-union atom / a nullable atom) rides the
  // shared i32 `vals` list, so it needs no per-value struct at all: it is the `-1`
  // string-keyed / `-4` i32-keyed sentinel, which is the pair every value-blind
  // classifier already reads as "the mono rep".
  if sh == -1 { return mapMonoShapeOfKey(ki) }
  sh
}

// The mv shape of the map type the CHECKER RECORDED on node `ix` — the INTERN-side twin of
// the `nodeTyIsMap` fall-through in `mapShapeOfExpr`, and the mint an UN-ANNOTATED map has
// no other route to. `mvShapeOfMapName` mints off an annotation SPELLING, and `collectA`'s
// `TypeRef` walk is the only caller; a `const m = Map()` whose value type is pinned by the
// first `m.set(k, v)` puts no map spelling in the arena at all, so nothing minted its slot
// and every op site's FIND (`mvSlotOfMapValNameOrMonoKTy`) fell to the loud `-3`. The map
// TYPE was resolved and the map REP was not.
//
// The rung order is `mvShapeOfMapName`'s, read off the node instead of off a spelling: the
// KEY is the slot identity's other half (`{[string]: S}` and `{[i32]: S}` are two layouts),
// an ATOM-valued map rides the shared mono i32 `vals` list and interns NO slot (its rendered
// value name would collapse to `string` and claim a string-valued slot), and a mono value
// resolves to the `-1`/`-4` sentinel pair.
//
// NOT FRONTED WITH `nodeMapValTyIx`, though the caller holds the node: this path MINTS, and
// an arena leg that answers where the name bridge does not SKIPS the mint (D-MAPNODETY — the
// rule and its invalid-wasm witness are on `mvShapeOfValNameK`).
export function mvShapeOfMapNodeTy(ix: i32) {
  if !nodeTyIsMap(ix) { return -1 }
  const ki = nodeTyMapKeyIsI32(ix)
  if nodeTyMapValIsLitUnion(ix) { return mapMonoShapeOfKey(ki) }
  if nodeTyMapValIsNulLitUnion(ix) { return mapMonoShapeOfKey(ki) }
  const sh = mvShapeOfValNameK(nodeTyMapValName(ix), ki)
  if sh == -1 { return mapMonoShapeOfKey(ki) }
  sh
}

// The map SHAPE of the map type the CHECKER RECORDED on node `ix` — the FIND-side twin of
// the mint `mvShapeOfMapNodeTy` directly above, and the ONLY route from an INFERRED map
// value type to its rep. Callers gate on `nodeTyIsMap(ix)` first; the rung order is the
// mint's, so a FIND lands on exactly the slot the type section interned.
//
// The two atom rungs are load-bearing, not defensive: an atom-valued map (`{[string]: K0}`)
// rides the MONO i32 `vals` list and interns NO slot, while its RENDERED value name
// collapses to `string` (`tyToEmitName` widens each member literal) — so without them the
// name rung would claim a string-valued slot the mint never made.
export function mapFindShapeOfNodeTy(ix: i32) {
  const ki = nodeTyMapKeyIsI32(ix)
  if nodeTyMapValIsLitUnion(ix) { return mapMonoShapeOfKey(ki) }
  if nodeTyMapValIsNulLitUnion(ix) { return mapMonoShapeOfKey(ki) }
  // The NAME here is `tyToEmitName` of the very type `nodeMapValTyIx` returns — a render
  // followed by a re-parse of the render (D-MAPNODETY). The type goes straight across; the
  // rendered name stays because the rungs BELOW the arena leg are still name-keyed.
  const sh = mvSlotOfMapValNameOrMonoKTy(
    nodeTyMapValName(ix),
    ki,
    nodeMapValTyIx(ix),
  )
  if sh == -1 { return mapMonoShapeOfKey(ki) }
  sh
}

export function mvShapeOfValName(valNameIn: string) {
  mvShapeOfValNameK(valNameIn, false)
}

// The MONO map shape of a key rep — the `-1` / `-4` pair, named once. A value that rides
// the shared i32 `vals` list interns no slot on EITHER key, so every resolver that lands
// on "mono" still has to say which of the two structs it means; before the i32-keyed rep
// existed there was only one answer and the constant was written inline.
export function mapMonoShapeOfKey(keyI32: boolean) {
  if keyI32 { return -4 }
  -1
}

// THE ARENA LEG CAN FRONT A *FIND*; IT MUST NOT FRONT A *MINT* — D-MAPNODETY, measured.
// This function is the mv-slot INTERNER: its first rung asks "is there already a slot for
// this value?", and everything below it exists to create one when there is not. Handing
// that rung a banked node type (`nodeMapValTyIx`, which the two `collectA` `TypeRef`-walk
// callers hold) is a strictly better answer to the LOOKUP and a wrong one to the
// FUNCTION: on `tests/cases/maps/alias-positions-and-value-kinds.vl` the arena leg claimed
// an existing slot at 2 entries where the name bridge claimed none, the mint below never
// ran, and the module emitted INVALID WASM ("expected i32, found (ref $type)") at
// `vl check` rc 0. Its FIND-side siblings — `mapAnnShape` and
// `mvSlotOfMapValNameOrMonoK` — take the same banked type with a dual-write disagreement
// count of 0 and ARE routed.
//
// …AND THE ROW FORM BELOW IS THE ONE EXCEPTION THE RULE ALWAYS HAD, NOW TAKEN. The rule
// forbids a better ANSWER at this rung; it does not forbid the SAME INPUT. The two
// field-table re-derivation loops in `emit_collect` call this function with a
// `sFieldElemName` / `uFieldElemName` cell whose arena type the row's own recorder
// computed — by calling `fieldElemTyIxOfName` on that very string — and `rowTy` carries
// it. Dual-write over the corpus: 441 + 56 entries, all covered, and the raw arena
// INDEX is identical on every one, so the lookup below cannot move and the mint below it
// cannot be skipped. (`ensureRefElemTy` two lines further down the SAME loop already
// takes the same cell; this is that thread reaching the sibling intern.)
export function mvShapeOfValNameK(valNameIn: string, keyI32: boolean) {
  mvShapeOfValNameRowTy(valNameIn, keyI32, -1)
}

export function mvShapeOfValNameRowTy(
  valNameIn: string,
  keyI32: boolean,
  rowTy: i32,
) {
  const valName = mvCanonValName(valNameIn)
  const kind = mvValKindOfName(valName)
  if kind == -1 { return -1 }
  if kind < 0 { return -3 }
  // A NICHE-nullable value name resolves its struct/map identity — and keys its vals
  // ref-list slot — through the single non-null member, so the slot SHARES the vals rep
  // (and the heap-type dedup) with its non-null twin.
  let bare = valName
  const nin = nulRefMapValInnerOf(valName)
  if nin != "" { bare = nin }
  let vsi = -1
  if kind == 1 { vsi = structIndexByValName(bare) }
  // A VALUE union also interns its scalar value-box reps; a struct/heterogeneous
  // union just rides the box payload, so no value boxes are needed. A MAP arm's mv
  // value slot is interned (`markMapUnionArms` — idempotent) so the store-coerce tag
  // (`mapSlotTag`) and the narrowed read resolve the same slot at the map-value position.
  if kind == 2 {
    if isValueUnionName(valName) { registerValueUnionName(valName) }
    markMapUnionArms(valName)
  }
  // The slot's identity is STRUCTURAL (`repMvValKey` over the value's arena type) PAIRED
  // with the key rep, not the recorded spelling; the name scan stays as the fall-through
  // for a value spelling the arena does not resolve. The resolution is held rather than
  // consumed in place, because the row this call may go on to push records the very same
  // index (see `recordMvValTyIx` below).
  const vTy = mvValTyIxOfNameRow(valNameIn, rowTy)
  const aSh = mvSlotOfTyK(vTy, keyI32)
  if aSh >= 0 { return aSh }
  const nmSh = mvSlotByValNameK(valName, keyI32)
  if nmSh >= 0 { return nmSh }
  // A kind-6 (ref-VALUE: nested map / list) value forces the i32-list + map types, and a
  // MAP value also interns its INNER value shape first (so a ref-valued inner map's struct
  // exists) — for the common mono inner (`{[string]: i32}`) that is a no-op
  // (`mvShapeOfValName("i32")` returns -1). ALL of the recursive interning — including the
  // vals ref-list slot (`ensureRefElem`, whose map-element arm RE-ENTERS `mvShapeOfValName`
  // for a list-of-maps value) — runs BEFORE this slot's parallel arrays are pushed: a
  // reentrant intern between `mvValName.push` and `mvRlSlot.push` would land its own
  // `mvRlSlot` entry at THIS slot's index, skewing every parallel table after it.
  let rls6 = -1
  if kind == 6 {
    lUsed = true
    aUsed = true
    if nameIsMap(bare) {
      mUsed = true
      mvShapeOfMapName(bare)
    }
    // A non-i32 LIST value forces its inner list's type so the element wrapper heap exists.
    if nameIsStringArray(bare) { slUsed = true }
    else if nameIsF64Array(bare) { fa64Used = true }
    else if nameIsI64Array(bare) { ia64Used = true }
    // The vals ref-list slot, keyed by the value name with the recursively-interned inner
    // slots — the SAME `ensureRefElem` the array path uses. Its recursion strictly shrinks
    // the element spelling, so it never re-enters on `valName` itself.
    //
    // …KEYED FROM THE FIND'S OWN RESOLUTION, on the same-INPUT rule (destringify
    // D-INLINESHAPETY). `vTy` above is `valNameIn`'s resolution through
    // `mvValTyIxOfNameRow`, and that function's header names this exact class as the one
    // reuse that cannot move a mint: the same spelling's own earlier resolution, which
    // `resolveAnnot`'s never-invalidated positive memo answers without minting. So the
    // resolution is not HOISTED here — it already ran above this block, unconditionally,
    // as the slot FIND's — and no arena entry is skipped or reordered.
    //
    // The bank is withheld where `bare` is not that spelling, exactly as
    // `recordMvValTyIx` below withholds it where canon rewrote the name: a NICHE-nullable
    // value peels to its inner member (`nulRefMapValInnerOf`) and the peel is a different
    // input, so it keeps the name leg. Corpus: 196 of 200 entries carry the bank, all 196
    // key-identical to the name leg with 0 disagreements in either direction, and all 196
    // arena-neutral (`ΔT.tys = 0` on the resolution they replace); the 4 peeled entries
    // include both entries whose resolution does mint, and they are the ones that decline.
    let bareTy = -1
    if bare == valNameIn { bareTy = vTy }
    rls6 = ensureRefElemTy(bare, bareTy)
  }
  mvValName.push(valName)
  // The slot's KEY half, pushed in lockstep with its NAME half — the pair IS the row's
  // identity, so nothing between the two pushes may intern (the same discipline the
  // `rls6` hoist above exists for).
  if keyI32 { mvKeyI32.push(1) } else { mvKeyI32.push(0) }
  // THE ROW'S OWN RESOLUTION IS THE SLOT FIND'S, NOT A SECOND ONE (destringify B4). The
  // FIND above resolved `valNameIn` through the same `fieldElemTyIxOfName`, and
  // `resolveAnnot` memoizes per spelling with no invalidation of a positive entry, so
  // asking again here could only return the index that call already produced. Handing it
  // over instead retires the lookup without moving a mint in either direction. The one
  // thing that can make the two inputs differ is `mvCanonValName` rewriting the spelling;
  // there the bank is withheld and the recorder resolves its own `valName`.
  let vBank = -1
  if valName == valNameIn { vBank = vTy }
  recordMvValTyIx(valName, vBank)
  // THE ROW THAT LINE JUST BANKED (destringify D-INLINESHAPETY). `recordMvValTyIx` holds
  // `valName`'s arena index over the very spelling the two `valName` interns below key
  // on, so the three MINT sites in this block stop asking `resolveAnnot` for an index
  // that is now sitting at the end of the sidecar. The interner-rule discipline
  // (`rlInternNameTy`'s header): a mint may be fronted only with a banked INPUT that is
  // provably the one it would have computed — for the two `valName` sites the recorder's
  // argument IS this call's argument, one line apart.
  //
  // The kind-6 site above is NOT reachable from THIS bank — it interns BEFORE the row is
  // pushed, and it must (a reentrant intern between `mvValName.push` and `mvRlSlot.push`
  // skews every parallel table). It is keyed from `vTy` instead, the slot FIND's own
  // resolution, which sits above the whole block; see the note at that site for why that
  // needs no hoist and therefore moves no mint.
  const vRowTy = mvValTyIxAt(mvValTyIx.length - 1)
  mvValKind.push(kind)
  mvValStructIdx.push(vsi)
  if kind == 1 {
    // THE KIND-1 SITE IS DELIBERATELY UNHINTED, AND THE REASON IS A SIDECAR WITH TWO
    // PRODUCERS. It interns `sNames[vsi]`, not `valName`, so the obvious hint is that
    // row's own D0 cell — except `sTyIx` is written by `sTyIxOfName` at three mint
    // sites AND by `anonRowTyIx` (a NODE bank) at the anonymous-literal row. For an
    // `#anonN` row the two answer differently by construction: the bridge returns -1
    // (the name resolves through neither `cUserTypes` nor the annotation grammar) while
    // the sidecar holds the literal's context-resolved `TyObj`. Measured: 4 of 116
    // entries, first witness `nm=#anon1 A={a:f64,f:f64,z:string,}` — a D2, which at a
    // MINT re-keys the row from "never merged" to a structural key. A hint must be the
    // input the function WOULD have computed; a strictly better-covered sidecar is not
    // that input.
    mvRlSlot.push(rlInternName(sNames[vsi], 1))
    rlUsed = true
    raUsed = true
  } else if kind == 2 {
    // A union-VALUE ref list: element kind 2 (the union box, heap `uBoxIdx`).
    mvRlSlot.push(rlInternNameTy(valName, 2, vRowTy))
    rlUsed = true
    raUsed = true
  } else if kind == 6 {
    // The map's VALUE is a ref LIST (`S[]` struct-list, `(C|D)[]` union-list, `i32[]` scalar
    // list, or a nested map): the vals ref-list slot interned above, before this slot's
    // parallel-array pushes.
    mvRlSlot.push(rls6)
    rlUsed = true
    raUsed = true
  } else if kind == 14 {
    // A CLOSURE-VALUE ref list: element kind 5 (the closure fat-pointer, heap `cloStructIdx`).
    mvRlSlot.push(rlInternNameTy(valName, 5, vRowTy))
    rlUsed = true
    raUsed = true
  } else {
    mvRlSlot.push(-1)
  }
  if kind == 11 { fa64Used = true }
  if kind == 10 { ia64Used = true }
  if kind == 13 { fa32Used = true }
  // A string-valued map: force the string-LIST value flag so a bound `m.values()` (a
  // `string[]`) supports `.length` / indexing (which gate on `slUsed`).
  if kind == 3 {
    slUsed = true
    aUsed = true
  }
  mvMapTypeIdx.push(0)
  mvValName.length - 1
}

// FIND-ONLY mv-slot lookup by value type-name: `-1` for the mono i32 map
// (i32/boolean values), the interned slot otherwise. NEVER interns — all mv
// interning happens in `collectA`'s arena scan (a slot interned after
// `mAssignTypeIndices` would mint no type index) — so a miss is a compiler bug
// and fails loudly.
export function mvSlotOfValNameFind(valNameIn: string) {
  mvSlotOfValNameFindK(valNameIn, false)
}
export function mvSlotOfValNameFindK(valNameIn: string, keyI32: boolean) {
  const valName = mvCanonValName(valNameIn)
  // Mono-ness is decided by the ONE classifier the interner uses (`mvValKindOfName`):
  // i32 / boolean, a literal-union ATOM value (`{[string]: K0}` — a struct FIELD records
  // the alias name "K0" in `sFieldElemName`), and the nullable-atom niches (`K0 | null`,
  // `boolean | null`) all ride the shared mono `$mStructIdx` with NO interned slot. The
  // old two-name test rejected the atom spellings loudly ("no interned slot") even
  // though the SAME map lowers fine as a binding — the R1 map-in-field seam.
  if mvValKindOfName(valName) == -1 { return -1 }
  const aFd = mvSlotOfValNameTyK(valNameIn, keyI32)
  if aFd >= 0 { return aFd }
  const nmFd = mvSlotByValNameK(valName, keyI32)
  if nmFd >= 0 { return nmFd }
  emitFail("emitProgram: map value type has no interned slot")
  -1
}

// A kind-6 (ref-VALUE) map slot's values are either inner MAP structs (ref-list element
// kind 3) or i32-LIST wrappers (element kind 4). These split the two so a read classifies
// as the right thing — `m[k]` over a nested map is a Map, over a list-valued map an i32 list.
export function mvValIsMap(slot: i32) {
  if slot < 0 { return false }
  if mvValKind[slot] != 6 { return false }
  rlElemKindTbl[mvRlSlot[slot]] == 3
}

// The map SHAPE a nested-MAP-valued slot's inner `Map()` must construct: the inner
// value's own mv slot when it has one, else the MONO shape of the INNER map's key. Only
// meaningful when `mvValIsMap(slot)`.
//
// Before the i32-keyed rep this question had a silent right answer at one of its two
// call sites and a silent WRONG one at the other: an inner mono `{[string]: i32}` is the
// `-1` every unseeded `Map()` already builds, so the store/read never had to seed it,
// while an inner `{[string]: string}` built the mono struct into a typed vals slot —
// invalid wasm on master, `vl check` clean. Naming the shape fixes both halves at once.
export function mvInnerMapShape(slot: i32): i32 {
  const inner = mvValInnerMvSlot(slot)
  if inner >= 0 { return inner }
  mapMonoShapeOfKey(rlElemMapKeyI32(mvRlSlot[slot]))
}

// The list-element rep of a list-VALUED map slot — `2` i32-list (ref-list elem 4), `7`
// string-list (elem 6), `12` f64-list (elem 7), `20` i64-list (elem 8) — or -1 if the slot's
// value is not a list. Maps the ref-list element kind to the value list's classifier rep.
export function mvListValKind(slot: i32): VKind | null {
  if slot < 0 { return null }
  if mvValKind[slot] != 6 { return null }
  const ek = rlElemKindTbl[mvRlSlot[slot]]
  if ek == 4 { return "list" }
  if ek == 6 { return "strlist" }
  if ek == 7 { return "f64list" }
  if ek == 8 { return "i64list" }
  if ek == 10 {
    return "f32list" // f32-inner list → an f32-list value (kind 21)
  }
  if ek == 9 {
    return "reflist" // struct-list value → a ref list
  }
  return null
}

// The mv slot of a `m[k]` / `m[k] ?? d` read over a struct-LIST-valued map (the value is a
// struct list, element kind 9), else -1. The hook `refListElemNameOfExpr` uses to name the
// read's element (the inner struct), so `(m[k] ?? []).length` / `[i].field` resolve.
function mapReadStructListMvSlot(exprIx: i32, fnIx: i32) {
  const cm = coalesceMvSlot(exprIx, fnIx)
  if cm >= 0 {
    if mvListValKind(cm) == "reflist" { return cm }
  }
  const mr = mapReadMvSlot(exprIx, fnIx)
  if mr >= 0 {
    if mvListValKind(mr) == "reflist" { return mr }
  }
  -1
}

// ── scalar-list descriptor (the i32 / f64 / i64 list unification) ──────────────
// A SCALAR-element list (`i32[]` / `boolean[]` / `f64[]` / `i64[]`) is one shape
// parameterized by its element's valtype: a growable `{ backing, len, cap }` wrapper over
// a raw `(array (mut <elem>))`. The list ops (`.get`/`.pop`/`.slice`/index/`.map`) used to
// branch `if exprF64Array { fl64/fa64 } else { l/a }` — a binary fork with no room for a
// third element type. These descriptors map a CANONICAL element kind (the `fbValtype`
// codes: 0 i32/boolean · 11 f64 · 10 i64) to its list types + read shape, so a list op is
// written ONCE over the kind and a new scalar type is a descriptor arm, not a new branch
// in every function.

// The canonical scalar element kind of a list-valued expression — 0 (i32/boolean), 11
// (f64), 10 (i64) — or -1 (a ref / string / map list, or not a list). The single dispatch
// the scalar list ops consult instead of each re-deriving `exprF64Array`.
export function scalarListElemKind(exprIx: i32, fnIx: i32): VKind | null {
  if exprF32Array(exprIx, fnIx) { return "f32" }
  if exprF64Array(exprIx, fnIx) { return "f64" }
  if exprI64Array(exprIx, fnIx) { return "i64" }
  if exprArray(exprIx, fnIx) { return "i32" }
  return null
}

// ── active `is`-narrowing scope ───────────────────────────────────────────────
// When emitting the THEN-branch of `if n is A { … }`, the union-typed identifier
// `n` is narrowed to variant `A`, so a field read `n.f` in that branch lowers to
// the downcast. The active narrowings are a STACK (parallel `narrowNames` /
// `narrowVariants`): nested guards over DISTINCT union locals (`if ta is TyPrim { if
// tb is TyPrim { … ta.primName … tb.primName … } }`, the `sameNumeric` shape) each
// push a binding, so BOTH `ta` and `tb` stay narrowed in the inner branch — a single
// slot would lose the outer one. A branch saves the stack LENGTH and truncates back
// on exit, so nesting + the else-branch see the right scope. `narrowVariantFor`
// resolves a receiver name to its INNERMOST active variant (shadowing-correct);
// `narrowSlotTy` resolves the same slot's narrowed TYPE from the structure columns
// (`narrowTys`/`narrowSets`) the push banked, so a consumer asks the arena what the
// binding now is instead of re-classifying the rendered variant.
// `narrowTop` is the logical stack DEPTH: only `narrowNames[0 .. narrowTop-1]` are
// active. Entries are appended on push; on branch exit the depth is rewound (the arrays
// keep their slots — no `.pop()`, so no global-list-pop self-host dependency). A push
// past the current length appends; a push within reuses/overwrites the slot.
// (`narrowNames`/`narrowVariants`/`narrowTop` and the `nli*` tables are declared
// early, before `computeRetInference` — module-level `let`s must textually
// precede the function bodies/call sites that read them.)

// The STACK SLOT of the innermost active narrowing of `name`, or -1 when `name` is not
// currently narrowed. The one scan every narrowing query shares, so a consumer that wants
// both the rendered variant and its structure pays for one walk.
function narrowSlotOf(name: string): i32 {
  let i = narrowTop - 1
  while i >= 0 {
    if narrowNames[i] == name { return i }
    i = i - 1
  }
  -1
}

// The variant a union local `name` is narrowed to in the current scope (the innermost
// active binding within `narrowTop`), or "" if `name` is not currently narrowed.
export function narrowVariantFor(name: string) {
  const i = narrowSlotOf(name)
  if i < 0 { return "" }
  narrowVariants[i]
}

// The arena TYPE the narrowing at stack slot `i` binds: the type banked by an `is` push,
// or — for a complement push — the SOLE surviving member of its set (`i32 | null` minus
// `null` binds `i32`). -1 when the slot binds no single type: a 2+-member set, a set the
// pool does not cover, or a push that banked nothing.
function narrowSlotTy(i: i32): i32 {
  const t = narrowTys[i]
  if t >= 0 { return t }
  msSoleMemberTy(narrowSets[i])
}

// Push an active narrowing `name → variant` carrying its STRUCTURE: `ty` is the narrowed
// type's arena index (a one-type narrowing), `set` the interned member-set id (a
// complement narrowing) — each -1 where it does not apply. Grows the stack arrays if
// needed; all four columns move together, so a slot index is valid in every one of them.
// Returns the new depth.
function pushNarrowRep(name: string, variant: string, ty: i32, set: i32) {
  if narrowTop < narrowNames.length {
    narrowNames[narrowTop] = name
    narrowVariants[narrowTop] = variant
    narrowTys[narrowTop] = ty
    narrowSets[narrowTop] = set
  } else {
    narrowNames.push(name)
    narrowVariants.push(variant)
    narrowTys.push(ty)
    narrowSets.push(set)
  }
  narrowTop = narrowTop + 1
  narrowTop
}

// Push a narrowing whose structure is not carried (the rendered variant is all the
// entry has — every consumer falls through to its name path for it).
function pushNarrow(name: string, variant: string) {
  pushNarrowRep(name, variant, -1, -1)
}

// Push an `is`-test narrowing: the tested SPELLING plus the arena type the checker
// resolved it to at the `is` node (`isVarTyIxOf` — -1 for a node the checker never saw,
// e.g. a monomorphized clone, which lands on the name path).
function pushNarrowIs(name: string, variant: string, condIx: i32) {
  const ity = isVarTyIxOf(condIx)
  pushNarrowRep(name, isVariantSpelling(variant, ity), ity, -1)
}

// The `uVariants` SPELLING of an `is`-tested type: the author's own spelling when it names
// a variant row, otherwise the DECLARED name of the struct that spelling's type equals.
//
// WHY THE SECOND RUNG EXISTS. The emitter resolves an `is` test by an EXACT STRING COMPARE
// against `uVariants` (`variantIndexOf`), so which spellings work is decided by which
// spellings got REGISTERED. For an inferred struct-union return the registration is the
// checker's reverse-mapped NOMINAL composite (`Cat|Dog` — `structUnionRetName` →
// `registerInferRetNominalUnion`), so the rows read `Cat` and `Dog` and the inline shape
// `is {meow: i32}` names no row. It USED to name one, for a reason that was never a rule:
// the arena walk registered the SAME union a second time under its structural spelling, and
// its duplicate rows `{meow:i32}` / `{woof:i32}` were what the inline test matched. Deleting
// that duplicate (`inferRetArenaUnionIsDup`, `emit_collect.vl`) therefore took the inline
// spelling with it — the two-half trap, caught by a 14-cell `is`-spelling x union-PROVENANCE
// sweep before the corpus could see it (the corpus never writes this test).
//
// SO THE SPELLING IS RESOLVED WHERE IT IS CONSUMED, AND FROM THE CHECKER'S OWN BANK. `tyIx`
// is `isVarTyIxOf`'s banked arena type for the `is` node — the same bank `isArmTagOfTy` and
// the narrow push read — and `nominalStructNameOfTy` is the reverse map that spelled the
// union's members in the first place, so the test and the variant it names come from ONE
// producer. That is D-ISALIAS's rule, applied one rung further out than the canon rewriter
// could reach: canon cannot make this call, because whether `{meow: i32}` or `Cat` is the
// registered spelling is EMITTER state (an inline-shape ANNOTATION union registers the
// structural spelling, and rewriting its test would break the one that works).
//
// STRICTLY ADDITIVE — the raw spelling is returned untouched whenever it resolves, so no
// resolution that worked before can change, and the fallback only converts a LOUD REJECT
// into a hit. Two gates read it, and they are two gates rather than one: the `is` test's own
// `variantIndexOf` (`emitIs`) and this narrowing push, whose spelling every downstream
// narrowed-receiver reader inherits. Fixing only the first moved the failure from
// ``is` names a type that is not a union variant`` to `narrowed receiver names no union
// variant` — the same reject, one site over.
//
// IT ALSO CLOSES AN ACTION AT A DISTANCE. On master `if a is {meow: i32}` over a
// `Cat | Dog`-typed binding compiled ONLY when the module happened to contain some OTHER
// function with an inferred struct-union return, because that function's duplicate
// registration is what put `{meow:i32}` in `uVariants`. Delete the unrelated function and
// the test stopped compiling. Both of those cells run here, with or without the bystander.
export function isVariantSpelling(variant: string, tyIx: i32): string {
  if variantIndexOf(variant) >= 0 { return variant }
  const nomn = nominalStructNameOfTy(tyIx)
  if nomn != "" {
    if variantIndexOf(nomn) >= 0 { return nomn }
  }
  variant
}

// Append the declared-local name `name` to `localNames` as a FRESH slot (one wasm
// local PER lexical binding — no dedupe by name, so two same-named `let`s in disjoint
// branches get DISTINCT slots, hence distinct valtypes). `structIdx` is the local's
// struct table index when it is a struct ref (`isRef == 1`), else `-1`. Returns the new
// slot's POSITION in `localNames` (its wasm index is `paramCount + position`).
export function addLocalName(name: string, isRef: VKind, structIdx: i32) {
  const pos = localNames.length
  localNames.push(name)
  localIsRef.push(isRef)
  localStructIdx.push(structIdx)
  localLoopVar.push(0)
  localLoopIter.push(-1)
  localLitUnion.push(0)
  pos
}

// Mark the declared-local slot as a LOOP VARIABLE (a `for` counter / for-in
// element). A loop var's scope is the LOOP: while it is live the scope stack
// resolves it; once its loop closes (`scopeUnbind`) it must NOT be resolvable
// again — but the flat `localNames` fallback scan would still find it (it
// serves the scope-less DETECTION passes, which must keep seeing loop vars for
// in-body classification). RESOLUTION (`declaredIndexOf`) therefore skips
// flagged slots in its fallback, so a post-loop reference falls through to an
// outer/global binding exactly as the host's loop-scoped declaration does.
export function markLoopVarSlot(slot: i32) {
  localLoopVar[slot] = 1
  0
}

// Mark the declared-local slot as a FOR-IN ELEMENT loop variable and pin the ITERABLE node
// its loop iterates, so a question only the iterable can answer resolves from the SLOT the
// scope stack hands out rather than from the loop var's NAME (`localLoopIter`'s header
// carries why the name is not the key). The `for`-counter form has no iterable and keeps
// the plain `markLoopVarSlot`.
export function markLoopVarIter(slot: i32, iterIx: i32) {
  localLoopVar[slot] = 1
  localLoopIter[slot] = iterIx
  0
}

// The `.push`/`.pop` element-kind SELECTOR threaded through the reservation walkers (C2 cleanup:
// a named literal union replacing the bare 0–5 codes). `pop` only uses i32/ref/str.
type PushKind = "i32" | "ref" | "str" | "f64" | "i64" | "f32"

// The scratch pre-scan carries all six PushKinds as ONE bitmask, LSB-first in
// PushKind declaration order, so a single body walk classifies every `.push`/
// `.pop` receiver once (instead of one whole-body walk per kind per query).
function pushKindBit(kind: PushKind) {
  if kind == "i32" { return 1 }
  if kind == "ref" { return 2 }
  if kind == "str" { return 4 }
  if kind == "f64" { return 8 }
  if kind == "i64" { return 16 }
  32 // "f32"
}

// Classify the `.push`/`.pop` RECEIVER at `objIx` into its PushKind bits with one
// classifier fan-out: ref/str/f64/i64/f32 list kinds, or — when none of those
// claim it — the i32 list kind.
function pushKindBitsOf(objIx: i32, fnIx: i32) {
  let bits = 0
  if exprRefArray(objIx, fnIx) { bits = bits | 2 }
  if exprStringArray(objIx, fnIx) { bits = bits | 4 }
  if exprF64Array(objIx, fnIx) { bits = bits | 8 }
  if exprI64Array(objIx, fnIx) { bits = bits | 16 }
  if exprF32Array(objIx, fnIx) { bits = bits | 32 }
  // Bit 64 is ADDITIVE to bit 4, not an alternative: a `(string | null)[]` push uses the
  // STRING quad (one backing), and only its VALUE slot changes — to `(ref null $aTypeIdx)`,
  // because the pushed value may be `null`. `exprNulStrArray` is the same predicate the
  // element READ and the for-in loop var ask, so the frame cannot disagree with the value.
  if exprNulStrArray(objIx, fnIx) { bits = bits | 4 | 64 }
  if bits == 0 { return 1 }
  bits
}

// The receiver-kind bits of a statement-level `recv.push(x)` member-call (the
// `Call` whose `callFn` is a `Member` with property `push`), or 0 when `stmtIx`
// is no such statement. Detects which inline-push scratch locals a function
// needs; the kinds get DISTINCT scratch frames so a function may push onto any mix.
export function stmtPushBits(stmtIx: i32, fnIx: i32) {
  const s = P.nodes[stmtIx]
  if s is Call {
    const callee = P.nodes[s.callFn]
    if callee is Member {
      if callee.memProp == "push" { return pushKindBitsOf(callee.memObj, fnIx) }
    }
  }
  0
}

// The receiver-kind bits of a `recv.pop()` at `callIx` whose receiver is a
// struct-FIELD / global-field array read (a `Member`, e.g. `T.scopes.pop()`), or
// 0 otherwise. A bare-LOCAL pop needs NO scratch (it references the local in
// place), so it reports no bits — only a Member receiver, which must be
// materialized into the push frame's `recvRef` scratch slot. Lets a `.pop`-on-
// field function reserve the same scratch frame a `.push`-on-field one does.
function callPopBits(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      // `.clear()` resolves its receiver the same way `.pop()` does (a Member /
      // global receiver stages the wrapper ref in `recvRef`), so it counts too.
      if callee.memProp == "pop" || callee.memProp == "clear" {
        const recv = P.nodes[callee.memObj]
        // A struct-FIELD / global-field Member receiver, OR a bare module-GLOBAL list
        // ident — both materialize the wrapper ref into the `recvRef` scratch slot, so
        // both need the push frame reserved. A bare LOCAL pop references the local in
        // place and needs no scratch, so it is NOT counted.
        let needsScratch = false
        if recv is Member {
          needsScratch = true
        } else if recv is Ident {
          if localIndexOf(fnIx, recv.identName) < 0 {
            if globalIndexOf(recv.identName) >= 0 { needsScratch = true }
          }
        }
        if needsScratch { return pushKindBitsOf(callee.memObj, fnIx) }
      }
    }
  }
  0
}

// True if the statement at `stmtIx` is a `recv.push(x)` whose receiver's list
// kind matches `kind` (the single-kind view of `stmtPushBits`, for the ref-slot
// collectors).
export function stmtIsPushKind(stmtIx: i32, fnIx: i32, kind: PushKind) {
  (stmtPushBits(stmtIx, fnIx) & pushKindBit(kind)) != 0
}

// True if `callIx` is a Member/global-receiver `.pop`/`.clear` of list kind
// `kind` (the single-kind view of `callPopBits`, for the ref-slot collectors).
export function callIsMemberPopKind(callIx: i32, fnIx: i32, kind: PushKind) {
  (callPopBits(callIx, fnIx) & pushKindBit(kind)) != 0
}

// The Member-receiver `.pop` kind bits anywhere in the expression at `exprIx` —
// a `.pop` appears in VALUE position (`let x = T.scopes.pop()`), so the
// reservation walk must descend expressions, not just statement receivers.
export function exprPopBits(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  const e = P.nodes[exprIx]
  if e is Call {
    let bits = callPopBits(exprIx, fnIx)
    const args = e.callArgs
    let i = 0
    while i < args.length {
      bits = bits | exprPopBits(args[i], fnIx)
      i = i + 1
    }
    return bits
  }
  if e is BinExpr {
    return exprPopBits(e.binLeft, fnIx) | exprPopBits(e.binRight, fnIx)
  }
  if e is Member { return exprPopBits(e.memObj, fnIx) }
  if e is Index {
    return exprPopBits(e.idxArr, fnIx) | exprPopBits(e.idxIndex, fnIx)
  }
  if e is Unary { return exprPopBits(e.unArg, fnIx) }
  if e is Paren { return exprPopBits(e.parInner, fnIx) }
  // The four remaining VALUE positions, taught from this file's own sibling
  // walker: `exprHasMapOp` carries `AsExpr` / `IsExpr` / `ObjLit` / `ArrayLit`
  // arms and this one stopped at `Paren`. `emitExpr` lowers all four positions
  // normally into `emitPop` / `emitPopOr`, which test no `fnUses*Push` flag, so
  // a `.pop()` in an array-literal element, an object-literal field value or an
  // `as`-cast operand staged its receiver into a frame `fbBeginFunc` never
  // reserved: INVALID WASM with `vl check` rc 0.
  if e is AsExpr { return exprPopBits(e.asObj, fnIx) }
  if e is IsExpr { return exprPopBits(e.isObj, fnIx) }
  if e is ObjLit {
    let bits = 0
    const fields = e.objFields
    let i = 0
    while i < fields.length {
      const f = P.nodes[fields[i]]
      if f is FieldInit { bits = bits | exprPopBits(f.fiValue, fnIx) }
      i = i + 1
    }
    return bits
  }
  if e is ArrayLit {
    let bits = 0
    const elems = e.arrElems
    let i = 0
    while i < elems.length {
      bits = bits | exprPopBits(elems[i], fnIx)
      i = i + 1
    }
    return bits
  }
  0
}

// ONE walk of the block at `blockIx` (descending into if/else + while/for bodies,
// the scopes `collectLocals` walks) accumulating BOTH the statement-level `.push`
// receiver kinds and the Member-receiver `.pop` kinds in every let-init / return /
// while-cond / for-header / expression-statement position. Replaces the twelve
// per-kind walks (six push + six pop) with a single pass that classifies each
// site once. `if` CONDITIONS are scanned too, by `ifChainPushPopBits` — the
// header here used to claim they were "deliberately" skipped because the
// start-fn if-scan handles conditions. It handles the START FUNCTION's
// conditions (`startScanIf` walks `st.ifCond`); nothing walked a regular
// function's or a lambda's, and a `.pop()` there is invalid wasm (see the note
// on `ifChainPushPopBits`).
export function blockPushPopBits(blockIx: i32, fnIx: i32) {
  let bits = 0
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      const s = P.nodes[stmts[i]]
      if s is LetDecl {
        bits = bits | exprPopBits(s.letInit, fnIx)
      } else if s is RetStmt {
        bits = bits | exprPopBits(s.retArg, fnIx)
      } else if s is BinExpr {
        bits = bits | exprPopBits(stmts[i], fnIx)
      } else if s is Call {
        bits = bits | stmtPushBits(stmts[i], fnIx) | exprPopBits(stmts[i], fnIx)
      } else if s is IfStmt {
        bits = bits | ifChainPushPopBits(stmts[i], fnIx)
      } else if s is WhileStmt {
        bits = bits |
          exprPopBits(s.whileCond, fnIx) |
          blockPushPopBits(s.whileBody, fnIx)
      } else if s is ForIn {
        bits = bits |
          exprPopBits(s.fiIter, fnIx) |
          blockPushPopBits(s.fiBody, fnIx)
      } else if s is ForRange {
        bits = bits |
          exprPopBits(s.frFrom, fnIx) |
          exprPopBits(s.frTo, fnIx) |
          blockPushPopBits(s.frBody, fnIx)
      }
      i = i + 1
    }
  }
  bits
}

// The push/pop kind bits of every arm of the `if` / `else if` chain at `ifIx` —
// the then-branch, an `else` block, OR (RECURSIVELY) a chained `else if`. Mirrors
// `collectLocalsIf`'s recursion so a push buried under several `else if` arms (the
// `parseProgram` / `parseStmt` recursive-descent dispatch shape) is detected, not just
// the first one level (the prior hand-unrolled form missed 2+-deep chains).
//
// The CONDITION is walked too. It was not, and this walker's own header used to
// justify the omission with "the start-fn if-scan handles its conditions" — which
// is true only of the START FUNCTION: `startScanIf` (emit_sections.vl) does walk
// `st.ifCond`, but nothing walked the condition of an `if` inside a regular
// function or a lambda. Three of the four condition positions were scanned (a
// `while` condition here, an `if` condition at module scope) and the fourth was
// not, so `if (xs.pop() ?? -1) == 1 { … }` in a function staged the receiver's
// wrapper ref into a push frame `fbBeginFunc` never reserved — `emitPop` /
// `emitPopOr` test no `fnUses*Push` flag, so it was INVALID WASM with `vl check`
// rc 0. `ifChainHasMapOp`, the same-shape sibling in this file, has had the
// condition arm all along.
function ifChainPushPopBits(ifIx: i32, fnIx: i32) {
  let bits = 0
  const s = P.nodes[ifIx]
  if s is IfStmt {
    bits = exprPopBits(s.ifCond, fnIx) | blockPushPopBits(s.ifThen, fnIx)
    if s.ifElse >= 0 {
      const els = P.nodes[s.ifElse]
      if els is Block { bits = bits | blockPushPopBits(s.ifElse, fnIx) }
      else if els is IfStmt { bits = bits | ifChainPushPopBits(s.ifElse, fnIx) }
    }
  }
  bits
}

// OR a push/pop kind mask into the six per-function `fnUses*Push` scratch-frame
// flags (a `.push` and a Member-receiver `.pop` of the same kind share a frame).
export function applyPushPopBits(bits: i32) {
  if (bits & 1) != 0 { fnUsesPush = true }
  if (bits & 2) != 0 { fnUsesRefPush = true }
  if (bits & 4) != 0 { fnUsesStrPush = true }
  if (bits & 64) != 0 { fnUsesNulStrPush = true }
  if (bits & 8) != 0 { fnUsesF64Push = true }
  if (bits & 16) != 0 { fnUsesI64Push = true }
  if (bits & 32) != 0 { fnUsesF32Push = true }
  0
}

// Append the ref-list table SLOT of a ref `.push` receiver to `fnRefPushSlots` if not
// already present (so each DISTINCT pushed element type gets its own typed scratch frame).
export function recordRefPushSlot(slot: i32) {
  let i = 0
  while i < fnRefPushSlots.length {
    if fnRefPushSlots[i] == slot { return 0 }
    i = i + 1
  }
  fnRefPushSlots.push(slot)
  0
}

// ── string-op detection (G6: which functions need the string scratch frame) ───
// A function reserves the shared string scratch frame iff it uses ANY string `+`,
// string `==`/`!=`, or `.slice` anywhere in an expression — so the walk below
// descends through EVERY expression position (return values, let inits, conditions,
// call args, operands, members, indices), unlike the push detection which only
// needs statement-level receivers. `exprIsStrConcat`/`exprIsStrEq`/`exprIsStrSlice`
// each classify a single node; `exprHasStrOp` recurses; `blockHasStrOp` walks
// statements. `exprString` (defined later) resolves operand string-typedness from
// the already-built `localNames`/`localIsRef` (so this runs AFTER `buildLocals`).

// True if `binIx` is a `+` whose operands are strings (string concatenation).
export function exprIsStrConcat(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "+" {
      // A literal-union atom is a `string` subtype, so `"x" + k` / `k + "y"` (and `k1 + k2`)
      // concatenate — the atom operand widens to its member string in `emitStrConcat`.
      const lStr = exprString(e.binLeft, fnIx) || exprIsLitAtom(e.binLeft, fnIx)
      const rStr = exprString(e.binRight, fnIx) ||
        exprIsLitAtom(e.binRight, fnIx)
      return lStr || rStr
    }
  }
  false
}

// True if the Call at `callIx` passes a literal-union ATOM into a parameter that WIDENS it to
// a string — a `string` param, or (D-ATOMSTORE) a boxed UNION param with a litunion / `string`
// arm, whose store lowers through `emitAtomToStr` exactly as the `string` param does. The atom
// widening rides the string-op scratch frame either way. An over-approximation (any atom arg +
// any such param) is fine: it only reserves a frame.
//
// THE UNION LEG IS THE SIXTH MEMBER OF THIS SET, and it is this predicate's own witness:
// `tests/cases/literal-unions/atom-store-into-mixed-union.vl`'s `argIsolated` — a `K` atom
// passed to a `K | f64` param from a function holding NOTHING else. Delete the
// `unionTakesAtomAsStr` call below and that fixture is INVALID WASM ("expected i32, found …"
// at a local the vector never declared) while every other position keeps running.
function callWidensAtomToStr(callIx: i32, fnIx: i32) {
  if gLitUnionUsed == 0 { return false }
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Ident {
      const target = fnIndexOfSid(sidOfNode(c.callFn))
      if target >= 0 {
        const cFn = P.nodes[fnStmts[target]]
        if cFn is FuncDecl {
          let anyAtom = false
          let ai = 0
          while ai < c.callArgs.length {
            if exprIsLitAtom(c.callArgs[ai], fnIx) { anyAtom = true }
            ai = ai + 1
          }
          if anyAtom {
            const params = cFn.fnParams
            let pi = 0
            while pi < params.length {
              if vtKindOfParam(params[pi]) == "str" { return true }
              const pn = P.nodes[params[pi]]
              if pn is Param {
                if unionTakesAtomAsStr(tyNameOf(pn.parType)) { return true }
              }
              pi = pi + 1
            }
          }
        }
      }
    }
    // A function-VALUE callee (an annotated binding, a lambda, a HOF parameter, a struct-field
    // or element closure) has no `FuncDecl` to read its parameters off, so the kinds come from
    // the resolved `$fnsig` KEY — the same byte `emitCallRef`'s widening arm reads, so the scan
    // and the handler cannot disagree about which positions widen. Without this leg the frame is
    // not reserved and the widening writes to a local the vector never declared ("unknown local
    // N"), which is this emitter's richest invalid-wasm vein.
    const vkey = cloCallSigKey(callIx, fnIx)
    if vkey != "" {
      let vAtom = false
      let vi = 0
      while vi < c.callArgs.length {
        if exprIsLitAtom(c.callArgs[vi], fnIx) { vAtom = true }
        vi = vi + 1
      }
      if vAtom {
        let vp = 0
        while vp < c.callArgs.length {
          if sigParamKindAt(vkey, vp) == "str" { return true }
          vp = vp + 1
        }
      }
    }
  }
  false
}

// True if the assignment at `binIx` writes a literal-union atom into a target that WIDENS it to
// a string — a `string`-typed lvalue (a local, global, or struct field; `exprString` covers all
// three uniformly), or (D-ATOMSTORE) a boxed UNION lvalue with a litunion / `string` arm.
// Either way the atom widens to its member string, riding the string-op scratch frame.
//
// THE UNION LEG'S OWN WITNESS is `reassignIsolated` in
// `tests/cases/literal-unions/atom-store-into-mixed-union.vl` (`let x: K | f64 = 2.5; x = k`,
// alone in its function). Deleting the `unionTakesAtomAsStr` call takes that one cell to
// INVALID WASM and leaves the other seven positions running.
function assignWidensAtomToStr(binIx: i32, fnIx: i32) {
  if gLitUnionUsed == 0 { return false }
  const a = P.nodes[binIx]
  if a is BinExpr {
    if a.binOp == "=" {
      if exprIsLitAtom(a.binRight, fnIx) {
        if exprString(a.binLeft, fnIx) { return true }
        if unionTakesAtomAsStr(unionNameOfExpr(a.binLeft, fnIx)) { return true }
      }
    }
  }
  false
}

// True if `initIx` is a literal-union ATOM read in a GLOBAL initializer — an `Ident` referencing
// another module global whose declared type is a literal union. (Module-global inits have no
// locals/params, so an Ident is the only atom form; a member literal is a plain string, not an
// atom.) Gates the start-fn `string`-global widening + its scratch-frame reservation.
export function globalInitIsLitAtom(initIx: i32) {
  if initIx < 0 { return false }
  const e = P.nodes[unwrapParen(initIx)]
  if e is Ident {
    const gli = globalLetOf(e.identName)
    if gli >= 0 {
      const r = letIsLitUnion(gli)
      return r
    }
  }
  // A CALL returning a litunion alias (`const gv: K | f64 = kOf()`) is the OTHER atom form a
  // module-global initializer can take — the comment above ruled it out on the grounds that a
  // global init "has no locals/params", which is true and does not cover a call. Measured: the
  // start function's own coercion widens it (`emitUnionCoerce`'s D-ATOMSTORE leg claims it via
  // `exprIsLitAtom`'s Call arm), so the scan has to claim it too or the frame is not there.
  const r2 = exprIsLitAtom(initIx, -1)
  r2
}

// True if the global at `letIx` is a cell that WIDENS a literal-union atom initializer to its
// member string in the start function, riding the string-op scratch frame: a `string` cell
// (kind 3 / its nullable), or (D-ATOMSTORE) a boxed UNION cell (kind 4) with a litunion /
// `string` arm. Witness: `globalIsolated` in
// `tests/cases/literal-unions/atom-store-into-mixed-union.vl` — the ONE position whose frame
// belongs to the START function, so its miss cannot be masked by anything inside a `function`.
export function globalInitWidensAtomToStr(letIx: i32) {
  if gLitUnionUsed == 0 { return false }
  if letIx < 0 { return false }
  const d = P.nodes[letIx]
  if d is LetDecl {
    const gk = globalCellKind(letIx)
    let takes = false
    if gk == "str" || gk == "nulstr" { takes = true }
    if !takes && d.letType >= 0 {
      if unionTakesAtomAsStr(tyNameOf(d.letType)) { takes = true }
    }
    if !takes { return false }
    const r = globalInitIsLitAtom(d.letInit)
    return r
  }
  false
}

// True if the binding at `letIx` is annotated with a target that WIDENS a literal-union atom
// initializer to its member string, riding the string-op scratch frame: `: string`, or
// (D-ATOMSTORE) a boxed UNION with a litunion / `string` arm — and the ARRAY of one, whose
// literal ELEMENTS each take the same store.
//
// TWO WITNESSES, because this predicate answers for TWO positions:
//   · `bindIsolated`  — `const x: K | f64 = k`
//   · `elemIsolated`  — `const xs: (K | f64)[] = [k]`
// Deleting the union leg breaks the first and deleting the array leg breaks the second, each
// alone (`tests/cases/literal-unions/atom-store-into-mixed-union.vl`). The array leg is the
// ELEMENT position the five `*WidensAtomToStr` predicates did not cover: `exprHasStrOp`'s
// ArrayLit arm recurses `exprHasStrOp` over the elements and an atom Ident answers false
// there, while its ObjLit sibling one arm above DOES claim `exprIsLitAtom` on a field value.
// The half of the pair that was taught is why the FIELD position needed no new code here.
function letWidensAtomToStr(letIx: i32, fnIx: i32) {
  if gLitUnionUsed == 0 { return false }
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const tn = tyNameOf(d.letType)
      if unionTakesAtomAsStr(tn) {
        if exprIsLitAtom(d.letInit, fnIx) { return true }
      }
      const el = parenUnionArrElemName(tn)
      if el != "" && unionTakesAtomAsStr(el) {
        if arrLitHasAtomElem(d.letInit, fnIx) { return true }
      }
    }
  }
  false
}

// True if the expression at `ix` is an ARRAY LITERAL with at least one literal-union ATOM
// element. The element-position half of `letWidensAtomToStr`.
function arrLitHasAtomElem(ix: i32, fnIx: i32) {
  if ix < 0 { return false }
  const e = P.nodes[unwrapParen(ix)]
  if e is ArrayLit {
    const elems = e.arrElems
    let i = 0
    while i < elems.length {
      if exprIsLitAtom(elems[i], fnIx) { return true }
      i = i + 1
    }
  }
  false
}

// True if `retArgIx` is a literal-union atom returned from a function whose return type WIDENS
// it to a string (`fnIx`'s `fnRet`): `string`, or (D-ATOMSTORE) a boxed UNION with a litunion /
// `string` arm. It widens at the return, riding the string-op scratch frame. Witness:
// `retIsolated` in `tests/cases/literal-unions/atom-store-into-mixed-union.vl`.
function retWidensAtomToStr(retArgIx: i32, fnIx: i32) {
  if gLitUnionUsed == 0 { return false }
  if retArgIx < 0 { return false }
  if fnIx < 0 { return false }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    if unionTakesAtomAsStr(tyNameOf(fn.fnRet)) {
      if exprIsLitAtom(retArgIx, fnIx) { return true }
    }
    // The INFERRED-string dual (mirrors `emitReturnValue`'s widen): an UN-annotated
    // function whose A20 return is `string` (one path returns a member literal,
    // another the atom) widens an atom return too — reserve the frame.
    if fn.fnRet < 0 && cloRetIsString(fnStmtsPosOf(fnIx)) {
      if exprIsLitAtom(retArgIx, fnIx) { return true }
    }
  }
  false
}

// THE IMPLICIT-RETURN TWIN of `retWidensAtomToStr`, and the reason the pair exists: a VL
// function's value is its LAST STATEMENT, so `emitFuncBody` routes that statement through
// `emitReturnExit` (a bare tail value) or `emitIfTail` (a tail `if` whose arms yield values)
// and BOTH reach the same `emitReturnValue` widen `return e` does. The widen stashes the atom
// id in the string-op scratch frame (`emitAtomToStr` → `setStrScrI`), so the reservation scan
// has to ask the atom-widening question in tail position too — `blockHasStrOpScan` asks it
// only under `RetStmt`, and a bare trailing `Ident` is not even on its statement whitelist.
// Without this leg the tail widen writes `local.set <strScratchBase>` at an index past the
// end of a locals vector that reserved nothing ("unknown local N: local index out of bounds"
// from the engine, with `vl check` clean). Witness:
// `tests/cases/literal-unions/atom-widened-at-tail.vl`.
function fnTailWidensAtomToStr(fnIx: i32) {
  if gLitUnionUsed == 0 { return false }
  if fnIx < 0 { return false }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const savedTop = narrowTop
    const hit = tailBlockWidensAtomToStr(fn.fnBody, fnIx)
    restoreNarrow(savedTop)
    return hit
  }
  false
}

// Mirrors `emitStmtsTail`: every statement but the last is an ordinary statement (walked here
// only for the post-guard narrowing the tail value is classified under, exactly as the emit
// loop does), and the LAST one is the block's value.
function tailBlockWidensAtomToStr(blockIx: i32, fnIx: i32) {
  if blockIx < 0 { return false }
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    const n = stmts.length
    if n == 0 { return false }
    let i = 0
    while i < n - 1 {
      pushPostGuardNarrow(stmts[i], fnIx)
      i = i + 1
    }
    return tailStmtWidensAtomToStr(stmts[n - 1], fnIx)
  }
  false
}

// Mirrors `emitStmtTail`: a tail `if`/`else` whose arms yield values recurses into BOTH arms
// under the same narrowing `emitIfTail` applies (an `else if` is a lone nested `IfStmt`, still
// in tail position); any other tail VALUE statement widens exactly like a `return` of it.
function tailStmtWidensAtomToStr(stmtIx: i32, fnIx: i32) {
  const s = P.nodes[stmtIx]
  if s is IfStmt {
    if !lastStmtIsValueIf(stmtIx, fnIx) && !elseLessNullableTail(stmtIx, fnIx) {
      return false
    }
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const hitThen = tailBlockWidensAtomToStr(s.ifThen, fnIx)
    if narrowed { restoreNarrow(savedTop) }
    if hitThen { return true }
    if s.ifElse >= 0 {
      const savedElseTop = narrowTop
      const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
      const els = P.nodes[s.ifElse]
      let hitElse = false
      if els is Block {
        hitElse = tailBlockWidensAtomToStr(s.ifElse, fnIx)
      } else {
        hitElse = tailStmtWidensAtomToStr(s.ifElse, fnIx)
      }
      if narrowedElse { restoreNarrow(savedElseTop) }
      return hitElse
    }
    return false
  }
  if !stmtIsTailValue(stmtIx, fnIx) { return false }
  retWidensAtomToStr(stmtIx, fnIx)
}

// True if `binIx` is `==`/`!=` whose operands are strings (string value-equality).
export function exprIsStrEq(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" {
      // A comparison with `null` is a NULL-CHECK (handled by the nullable-string /
      // -struct / -list `ref.is_null` paths), never element-wise string equality — a
      // `string | null` operand would otherwise be element-compared against `null`.
      if P.nodes[unwrapParen(e.binLeft)] is NullLit { return false }
      if P.nodes[unwrapParen(e.binRight)] is NullLit { return false }
      return exprString(e.binLeft, fnIx) || exprString(e.binRight, fnIx)
    }
  }
  false
}

// True if `binIx` is an ORDERING comparison (`<`/`>`/`<=`/`>=`) over two STRING operands
// — a lexicographic compare (`emitStrLessCore`), not the numeric `i32.lt_s` path that
// would compare the array refs. BOTH operands must be strings (the checker rejects a
// mixed string/numeric ordering); the frame reserved by `exprHasStrOp` carries the loop.
export function exprIsStrOrder(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    const op = e.binOp
    if op == "<" || op == ">" || op == "<=" || op == ">=" {
      return exprString(e.binLeft, fnIx) && exprString(e.binRight, fnIx)
    }
  }
  false
}

// True if `binIx` is a `==`/`!=` whose union-box value compare can hit the
// STRING arm — a box compared against a string operand, or two boxes whose
// shared arms include `string`. Those payload compares stage their operands in
// the string scratch frame (`emitStrEqCore`), so the frame must be reserved.
function exprIsUnionStrEq(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" {
      const lU = exprUnion(e.binLeft, fnIx)
      const rU = exprUnion(e.binRight, fnIx)
      if lU && rU {
        const ln = unionNameOfExpr(e.binLeft, fnIx)
        const rn = unionNameOfExpr(e.binRight, fnIx)
        return unionHasAtom(ln, "string") && unionHasAtom(rn, "string")
      }
      // A literal-union ATOM operand reaches the box's STRING arm too, and it gets there by
      // WIDENING to its member string (`emitUnionEqOther`'s kind-2 arm → `emitAtomToStr`),
      // which stages the id in this very frame. The handler and this scan have to claim the
      // same operands or the frame is unreserved under a `local.set` that assumes it.
      if lU {
        return exprString(e.binRight, fnIx) || exprIsLitAtom(e.binRight, fnIx)
      }
      if rU {
        return exprString(e.binLeft, fnIx) || exprIsLitAtom(e.binLeft, fnIx)
      }
    }
  }
  false
}

// True if `binIx` is a same-shape STRUCT `==`/`!=` (a field-wise compare). Its
// string/array field compares stage operands in the string-op scratch frame, so
// it counts as a string op for frame reservation.
function exprIsStructEq(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" {
      const lsi = structIndexOfExpr(e.binLeft, fnIx)
      if lsi >= 0 { return lsi == structIndexOfExpr(e.binRight, fnIx) }
    }
  }
  false
}

// ── list `==`/`!=`/`+` detection (which functions need the list-op frames) ────
// The list-op operand KIND of an expression: `0` an i32 list, `3` a string
// list, `4` an `i32[][]` (a ref list of i32-list elements), or -1 (not a list /
// an unsupported element kind). Order mirrors `emitIndex`'s receiver dispatch.
function listOpKindOf(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  if exprString(exprIx, fnIx) { return -1 }
  if exprStringArray(exprIx, fnIx) { return 3 }
  if exprF64Array(exprIx, fnIx) { return -1 }
  if exprRefArray(exprIx, fnIx) {
    const slot = refListSlotOfExpr(exprIx, fnIx)
    if slot >= 0 && slot < rlElemKindTbl.length {
      if rlElemKindTbl[slot] == 4 { return 4 }
    }
    return -1
  }
  if exprArray(exprIx, fnIx) { return 0 }
  -1
}

// The list-op kind of a `==`/`!=`/`+` BinExpr whose operands are BOTH lists of
// one kind, or -1 (not a list op — the caller keeps its existing dispatch).
export function listOpKindOfBin(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" || e.binOp == "+" {
      const lk = listOpKindOf(e.binLeft, fnIx)
      if lk < 0 { return -1 }
      const rk = listOpKindOf(e.binRight, fnIx)
      if rk != lk { return -1 }
      return lk
    }
  }
  -1
}

// ── `==`/`!=` COMPARE-CORE selection — the ONE home ──────────────────────────
// Which compare core a `==`/`!=` needs: `0` the i32/boolean-list loop, `3` the string-list
// loop, `4` the ref-list-of-i32/boolean-lists loop, `5` the string-eq helper, `6` closure
// identity, `-1` none.
//
// READ BY THE FRAME-RESERVATION SCAN (`leqNoteBin`) AND BY THE CORE EMITTER
// (`emitEqNonNullCore`), because they must never disagree: a core the scan does not know about
// is a core emitted against locals the function never declared — invalid wasm with `vl check`
// clean, which is this emitter's richest such vein.
//
// The rep classifiers come FIRST and decide every shape they claim, so the plain compare paths
// are byte-for-byte what they were. `nodeEqCmpKind` is the FALLBACK, not a second ladder: the
// rep classifiers are declaration-scoped and several do not claim a nullable value that arrives
// from a CALL, a closure-value call or an element read, while the checker's banked type names
// the rep for every origin.
export function eqCoreKindOfBin(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" {
      // A bare `null` operand makes this a null TEST, which consumes no compare core at all
      // (`emitNulIsNullTest` owns it). Claiming one here reserved a compare frame for every
      // `xs != null` guard in the language and shifted every local index after it — 48 corpus
      // modules changed bytes for a compare none of them performs.
      if P.nodes[unwrapParen(e.binLeft)] is NullLit { return -1 }
      if P.nodes[unwrapParen(e.binRight)] is NullLit { return -1 }
      const lk = listOpKindOfBin(binIx, fnIx)
      if lk >= 0 { return lk }
      if exprIsStrEq(binIx, fnIx) { return 5 }
      if exprIsClosure(e.binLeft, fnIx) || exprIsClosure(e.binRight, fnIx) {
        return 6
      }
      const tl = eqCoreKindOfTyToken(nodeEqCmpKind(e.binLeft))
      if tl >= 0 { return tl }
      return eqCoreKindOfTyToken(nodeEqCmpKind(e.binRight))
    }
  }
  -1
}

// One `eqCmpKindOfTy` token → its compare core. The nullable niche and its non-null base share
// a core by construction (that IS the null guard's contract), so both spellings map to one
// number here.
function eqCoreKindOfTyToken(k: string) {
  if k == "list" || k == "nullist" { return 0 }
  if k == "strlist" || k == "nulstrlist" { return 3 }
  if k == "reflist" || k == "nulreflist" { return 4 }
  if k == "str" || k == "nulstr" { return 5 }
  if k == "closure" || k == "nulclosure" { return 6 }
  -1
}

// True if struct shape `si` carries a function-typed field (code 14), looking
// through nested-struct fields (code 15). `seen` guards recursive shapes.
function shapeHasCloField(si: i32, seen: i32[]) {
  let k = 0
  while k < seen.length {
    if seen[k] == si { return false }
    k = k + 1
  }
  seen.push(si)
  let fi = 0
  while fi < sFieldCount[si] {
    const code = sFieldTypeAt(si, fi)
    if code == 14 { return true }
    if code == 15 {
      const nsi = sFieldTgtStructIdx(si, fi)
      if nsi >= 0 {
        if shapeHasCloField(nsi, seen) { return true }
      }
    }
    fi = fi + 1
  }
  false
}

// Note one BinExpr's function-identity equality site (`f == g`, or a struct
// equality whose shape carries a function-typed field) into `fnUsesCloEq` — the
// compare stages both operands in the 2-slot closure-eq frame.
export function cloEqNoteBin(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" {
      if exprIsClosure(e.binLeft, fnIx) || exprIsClosure(e.binRight, fnIx) {
        fnUsesCloEq = true
        return 0
      }
      const si = structIndexOfExpr(e.binLeft, fnIx)
      if si >= 0 {
        const seen: i32[] = []
        if shapeHasCloField(si, seen) { fnUsesCloEq = true }
      }
    }
  }
  0
}

// True if `callIx` is a `recv.slice(start, end)` over a STRING receiver.
export function exprIsStrSlice(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if callee.memProp == "slice" { return exprString(callee.memObj, fnIx) }
    }
  }
  false
}

// True if `callIx` is a `recv.indexOf(sub)` / `recv.includes(sub)` over a STRING
// receiver — both ride the same indexOf scan (`includes` negates the -1 compare).
export function exprIsStrIndexOf(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if callee.memProp == "indexOf" || callee.memProp == "includes" {
        return exprString(callee.memObj, fnIx)
      }
    }
  }
  false
}

// True if `callIx` is a `recv.charCodeAt(i)` over a STRING receiver.
export function exprIsStrCharCode(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if callee.memProp == "charCodeAt" {
        return exprString(callee.memObj, fnIx)
      }
    }
  }
  false
}

// True if the expression at `exprIx` (or any sub-expression) is a string `+`,
// string `==`/`!=`, or string `.slice`.
export function exprHasStrOp(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is BinExpr {
    if exprIsStrConcat(exprIx, fnIx) { return true }
    if exprIsStrEq(exprIx, fnIx) { return true }
    // A string ORDERING (`<`/`>`/`<=`/`>=`) rides the same lexicographic compare loop.
    if exprIsStrOrder(exprIx, fnIx) { return true }
    // A union-box `==`/`!=` whose value compare can hit the STRING arm stages
    // its payloads in the same frame (`emitStrEqCore`).
    if exprIsUnionStrEq(exprIx, fnIx) { return true }
    // A struct `==`/`!=` stages its string/array FIELD compares in the same frame.
    if exprIsStructEq(exprIx, fnIx) { return true }
    // An assignment of a literal-union atom into a `string` target widens (`emitAtomToStr`),
    // which stages the atom id in the string-op scratch frame.
    if assignWidensAtomToStr(exprIx, fnIx) { return true }
    if exprHasStrOp(e.binLeft, fnIx) { return true }
    return exprHasStrOp(e.binRight, fnIx)
  }
  if e is Call {
    if exprIsStrSlice(exprIx, fnIx) { return true }
    // A literal-union atom argument flowing into a `string` param widens (`emitAtomToStr`),
    // which stages the atom id in the string-op scratch frame.
    if callWidensAtomToStr(exprIx, fnIx) { return true }
    // `s.indexOf(sub)` / `s.includes(sub)` stage their receiver + needle + loop
    // counters in the same string scratch frame. (`charCodeAt` is a bare
    // `array.get` — no frame needed; its operands recurse below.)
    if exprIsStrIndexOf(exprIx, fnIx) { return true }
    // `print(<string>)` rides the string-op scratch frame (the streaming loop's
    // string ref + cursor + length live there).
    const pcal = P.nodes[e.callFn]
    if pcal is Ident {
      if pcal.identName == "print" {
        if e.callArgs.length == 1 {
          if exprString(e.callArgs[0], fnIx) { return true }
          // `print(<literal-union atom>)` widens to its member string — its per-member print chain rides
          // the same string-op scratch frame.
          if exprIsLitAtom(e.callArgs[0], fnIx) { return true }
          // `print(<string | null>)` streams through `emitPrintNulString`, which `local.set`s
          // the ref it recovers from `br_on_null` into `strScratchBase + 0` — the SAME frame.
          //
          // THE TWO ENDS OF ONE DECISION MUST ASK THE SAME QUESTION. The print HANDLER's
          // ladder is `exprIsLitAtom` → `exprNullableString` → `exprNulBool` → `exprString`,
          // and `exprNullableString` is strictly WIDER than `exprString`: a BARE read over a
          // `{[string]: string}` / `{[string]: string | null}` map, and a call of a function
          // whose return INFERS `string | null`, are claimed by it and by neither of the two
          // predicates this scan used to ask. Where the handler claimed a value the scan did
          // not, the frame was never reserved and `strScratchBase + 0` was not the string
          // scratch at all — the emitter wrote a `(ref $strArray)` into a local declared
          // `(ref $mapStruct)`: INVALID WASM with `vl check` rc 0.
          //
          //     const m: {[string]: string} = Map()
          //     m["k"] = "v"
          //     print(m["k"])          // master: "expected (ref $type), found (ref $type)"
          //
          // The probe that pins it as a RESERVATION miss and not a lowering bug: adding one
          // UNRELATED string op to the same function (`print("x" + "y")`) reserved the frame
          // and the identical print then ran. Binding first (`const v = m["k"]; print(v)`)
          // also ran, because a niche BINDING is claimed by `exprString`.
          //
          // `exprNulBool` (the `boolean | null` arm between them) is deliberately NOT added:
          // `emitPrintNulBool` is a `br_table` over three `__print_bool__`/`emitPrintNullWord`
          // arms and touches no scratch local, so `print(<boolean-valued map read>)` already
          // ran on master — measured, not assumed.
          if exprNullableString(e.callArgs[0], fnIx) { return true }
        }
      }
      // `__trap__(<string>)` prints its reason through the same string streaming
      // loop before the abort, so it rides the string-op scratch frame too.
      if pcal.identName == "__trap__" {
        if e.callArgs.length == 1 {
          if exprString(e.callArgs[0], fnIx) { return true }
        }
      }
      // `toString(x)` builds its digits in the string-op scratch frame.
      if pcal.identName == "toString" { return true }
      // `fromCodePoints(xs)` stages its length + result there too.
      if pcal.identName == "fromCodePoints" { return true }
    }
    if exprHasStrOp(e.callFn, fnIx) { return true }
    const args = e.callArgs
    let i = 0
    while i < args.length {
      if exprHasStrOp(args[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  if e is Member { return exprHasStrOp(e.memObj, fnIx) }
  if e is Index {
    if exprHasStrOp(e.idxArr, fnIx) { return true }
    return exprHasStrOp(e.idxIndex, fnIx)
  }
  // An if-EXPRESSION in value position (`print(if a < b then …)`): a string op in the
  // condition or either arm needs the frame reserved too.
  if e is IfStmt {
    if exprHasStrOp(e.ifCond, fnIx) { return true }
    // An ATOM arm under a `string`-typed join widens (`emitRefIfArm` →
    // `emitAtomToStr`), staging the atom id in the string-op frame — reserve it.
    // Mirrors the emit decision (join type recorded by the checker, any arm).
    if tyKindOf(nodeTyIxOf(exprIx)) == 3 {
      if ifChainHasAtomArm(exprIx, fnIx) { return true }
    }
    if blockHasStrOp(e.ifThen, fnIx) { return true }
    if e.ifElse >= 0 { return blockHasStrOp(e.ifElse, fnIx) }
    return false
  }
  if e is Unary { return exprHasStrOp(e.unArg, fnIx) }
  if e is Paren { return exprHasStrOp(e.parInner, fnIx) }
  if e is IsExpr {
    // A string-LITERAL `is` (`s is "a"`) lowers through `emitStrEqCore`, so it
    // stages operands in the string scratch frame like a string `==`.
    // The QUOTED-LEAF test at its home (`tyname.nameIsQuotedLeaf`, W3) — the census's W3
    // list did not carry this site. The `length > 0` bound stays in front of it.
    if e.isVariant.length > 0 && nameIsQuotedLeaf(e.isVariant) { return true }
    return exprHasStrOp(e.isObj, fnIx)
  }
  if e is AsExpr { return exprHasStrOp(e.asObj, fnIx) }
  if e is ObjLit {
    const fields = e.objFields
    let i = 0
    while i < fields.length {
      const f = P.nodes[fields[i]]
      if f is FieldInit {
        if exprHasStrOp(f.fiValue, fnIx) { return true }
        // A literal-union atom field value widens to a string (`string` field) — reserve the
        // string-op frame. (Any atom field value is destined for a `string` field; a literal-
        // union FIELD is not yet a rep, so this is a safe over-approximation.)
        if exprIsLitAtom(f.fiValue, fnIx) { return true }
      }
      i = i + 1
    }
    return false
  }
  if e is ArrayLit {
    const elems = e.arrElems
    let i = 0
    while i < elems.length {
      if exprHasStrOp(elems[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// True if any arm TAIL of the value if/else-if chain at `ifIx` is a literal-union
// atom (`if c then k else "cc"` — under a `string`-typed join the atom arm widens
// to its member string, which rides the string-op scratch frame).
function ifChainHasAtomArm(ifIx: i32, fnIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    const tv = ifThenValueIx(ifIx)
    if tv >= 0 {
      if exprIsLitAtom(tv, fnIx) { return true }
    }
    if s.ifElse >= 0 {
      const els = P.nodes[s.ifElse]
      if els is IfStmt { return ifChainHasAtomArm(s.ifElse, fnIx) }
      if els is Block {
        const ev = ifArmValueExpr(s.ifElse)
        if ev >= 0 { return exprIsLitAtom(ev, fnIx) }
      }
    }
  }
  false
}

// True if any statement in the block at `blockIx` (descending into if/else branches
// and while bodies, the scopes `collectLocals` walks) contains a string op. A
// wrapper restores the narrowing depth the scan's post-guard pushes (mirroring
// the emit loops) may leave behind on an early `true`.
export function blockHasStrOp(blockIx: i32, fnIx: i32) {
  const savedGuardTop = narrowTop
  const hit = blockHasStrOpScan(blockIx, fnIx)
  restoreNarrow(savedGuardTop)
  hit
}

function blockHasStrOpScan(blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      const s = P.nodes[stmts[i]]
      if s is LetDecl {
        if exprHasStrOp(s.letInit, fnIx) { return true }
        // A literal-union atom initializing a `string` local widens — reserve the frame.
        if letWidensAtomToStr(stmts[i], fnIx) { return true }
      } else if s is RetStmt {
        if exprHasStrOp(s.retArg, fnIx) { return true }
        // A literal-union atom returned as `string` widens — reserve the string-op frame.
        if retWidensAtomToStr(s.retArg, fnIx) { return true }
      } else if s is BinExpr {
        if exprHasStrOp(stmts[i], fnIx) { return true }
      } else if s is Call {
        if exprHasStrOp(stmts[i], fnIx) { return true }
      } else if s is ObjLit {
        // A bare trailing object-literal statement is a function's implicit-return value
        // (e.g. `mkTok` returns `{ …, text: gSrc.slice(…), … }`). Its field initializers
        // can contain string ops, so descend — `exprHasStrOp` walks `objFields`.
        if exprHasStrOp(stmts[i], fnIx) { return true }
      } else if s is Member {
        // A bare trailing MEMBER access is also an implicit-return value — and its
        // receiver may be a string op, e.g. `s.slice(a, b).length` (a `.length` over
        // a slice call). Without this the slice's scratch frame goes unreserved and
        // the slice emit references an unallocated local. `exprHasStrOp` walks `memObj`.
        if exprHasStrOp(stmts[i], fnIx) { return true }
      } else if s is Index {
        // Likewise a trailing `xs[i]` / `m[k]` index whose receiver/key uses a string op.
        if exprHasStrOp(stmts[i], fnIx) { return true }
      } else if s is Paren {
        if exprHasStrOp(stmts[i], fnIx) { return true }
      } else if s is Unary {
        if exprHasStrOp(stmts[i], fnIx) { return true }
      } else if s is IsExpr {
        if exprHasStrOp(stmts[i], fnIx) { return true }
      } else if s is AsExpr {
        if exprHasStrOp(stmts[i], fnIx) { return true }
      } else if s is IfStmt {
        if ifChainHasStrOp(stmts[i], fnIx) { return true }
      } else if s is WhileStmt {
        if exprHasStrOp(s.whileCond, fnIx) { return true }
        if blockHasStrOp(s.whileBody, fnIx) { return true }
      } else if s is ForIn {
        if exprHasStrOp(s.fiIter, fnIx) { return true }
        if blockHasStrOp(s.fiBody, fnIx) { return true }
      } else if s is ForRange {
        if exprHasStrOp(s.frFrom, fnIx) { return true }
        if exprHasStrOp(s.frTo, fnIx) { return true }
        if blockHasStrOp(s.frBody, fnIx) { return true }
      }
      // Post-guard complement narrowing (mirrors the emit loops) — so a string
      // read below a returning guard (`if x is i32 { return 0 } print(x)`) is
      // detected under the SAME narrowing the emit applies. The wrapper restores.
      pushPostGuardNarrow(stmts[i], fnIx)
      i = i + 1
    }
  }
  false
}

// True if any arm of the `if` / `else if` chain at `ifIx` contains a string op — its
// condition, then-branch, `else` block, OR (RECURSIVELY) a chained `else if`. Mirrors
// `ifChainPushPopBits`: walks the WHOLE else-if chain, not just one level.
function ifChainHasStrOp(ifIx: i32, fnIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    if exprHasStrOp(s.ifCond, fnIx) { return true }
    // Narrow across the THEN-branch (mirroring `emitStmt`/`collectLocalsIf`) so a string
    // op over a NARROWED variant field (`if n is A { … n.strField == x … }`, and nested
    // guards over distinct locals) is detected — `exprString` resolves a variant field's
    // string type only while the receiver's narrowing is active. Save/restore the depth.
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const hit = blockHasStrOp(s.ifThen, fnIx)
    if narrowed { restoreNarrow(savedTop) }
    if hit { return true }
    if s.ifElse >= 0 {
      // A VALUE union narrows to the COMPLEMENT set in the else-arm (mirroring
      // `emitStmt`'s else lowering), so `else { print(v) }` with `v` now `string`
      // is detected as a string print and reserves the scratch frame.
      const savedElseTop = narrowTop
      const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
      const els = P.nodes[s.ifElse]
      let hitElse = false
      if els is Block { hitElse = blockHasStrOp(s.ifElse, fnIx) }
      else if els is IfStmt { hitElse = ifChainHasStrOp(s.ifElse, fnIx) }
      if narrowedElse { restoreNarrow(savedElseTop) }
      if hitElse { return true }
    }
  }
  false
}

// True if the FuncDecl at `fnIx` uses any string op (`+`/`==`/`!=`/`.slice`) — so it
// reserves the shared string scratch frame. The statement scan covers every op reachable
// from a STATEMENT; the tail leg covers the one position that is a return without being
// spelled as one (the body's implicit-return value).
export function fnHasStrOp(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    if blockHasStrOp(fn.fnBody, fnIx) { return true }
    return fnTailWidensAtomToStr(fnIx)
  }
  false
}

// ── array-intrinsic detection (std-design D1 / collections-design §LS.2) ──────
// `__array_new__(n, fill)` / `__array_new_default__(n)` / `__array_copy__(…)` /
// `__trap__()` lower INLINE at the call site (host parity: toWasm.ts lowers the
// same names to array.new / array.new_default / array.copy / unreachable). The
// two allocators reserve the 1-slot `arrNewScratchBase` frame; these walkers
// find them anywhere in a body — a pure NAME walk (no classification, so no
// narrowing bookkeeping is needed, unlike the string-op scan).

// The intrinsic-allocation ELEMENT KIND of the Call at `callIx`: `0` = the i32
// list (i32/boolean fills — the i32 backing), `1` = the f64 list (an f64 fill),
// `-1` = not an intrinsic allocation. `__array_new_default__` is always the i32
// list natively: its element kind is not derivable from the argument list (an
// f64 default needs `__array_new__(n, 0.0)`); the host covers it generically.
export function arrNewIntrKind(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Ident {
      if callee.identName == "__array_new__" {
        if c.callArgs.length == 2 {
          if exprIsF64(c.callArgs[1], fnIx) { return 1 }
          // A STRING fill (kind 2) builds the string list; a STRUCT/object-literal
          // fill (kind 3) builds the ref list for that element struct. (Ref
          // long-tail: closures / nested arrays / maps as fills still fail loudly.)
          if exprString(c.callArgs[1], fnIx) { return 2 }
          const anf = P.nodes[c.callArgs[1]]
          if anf is ObjLit { return 3 }
          if exprStruct(c.callArgs[1], fnIx) { return 3 }
        }
        return 0
      }
      if callee.identName == "__array_new_default__" { return 0 }
    }
  }
  -1
}

// The declared-local POSITION of `name`: the innermost live lexical binding if the
// scope stack has one (so a same-named binding in a disjoint/inner block resolves to
// ITS own slot, with its own valtype), else the first `localNames` slot of that name
// as a safety net (used when no scope frame is active, e.g. the `fnUses*` detection
// pass, where any same-named slot's type suffices). -1 if `name` is not a local.
// The RESOLUTION variant of `declaredSlotOf`: identical, except the flat
// fallback scan SKIPS loop-variable slots (`localLoopVar`). At resolution time
// the scope stack is maintained in lockstep with the walk, so a live loop var
// always resolves through it; a flat-scan hit on a loop var would be a DEAD
// binding (its loop already closed) shadowing the outer/global the host would
// resolve (see `markLoopVarSlot`). Detection/classifier passes keep using
// `declaredSlotOf` (they run scope-less and must see in-body loop vars).
function declaredSlotLive(name: string) {
  const scoped = scopeSlotOf(name)
  if scoped >= 0 { return scoped }
  let pos = 0
  while pos < localNames.length {
    if localNames[pos] == name && localLoopVar[pos] == 0 { return pos }
    pos = pos + 1
  }
  -1
}

function declaredSlotOf(name: string) {
  const scoped = scopeSlotOf(name)
  if scoped >= 0 { return scoped }
  let pos = 0
  while pos < localNames.length {
    if localNames[pos] == name { return pos }
    pos = pos + 1
  }
  -1
}

// The `VKind` of declared local `name`, or `null` if there is no such declared local. The
// single `declaredSlotOf` + `localIsRef` lookup the `declared*` type predicates share —
// each compares the result against its kind atom (`"list"` i32-list, `"reflist"`,
// `"strlist"`, `"f64list"`, `"i64list"`, `"struct"`, `"union"`, `"map"`, `"str"`, the
// `"nul*"` niche nullables, `"i64"`/`"f64"`/`"f32"` scalars). The `null` arm matches no
// atom, so an absent local reads as "none of these" exactly as the old `-1` sentinel did.
export function declaredKind(name: string): VKind | null {
  const slot = declaredSlotOf(name)
  if slot < 0 { return null }
  localIsRef[slot]
}

// The wasm local index of declared local `name`, or -1 if it is not a declared
// local. Declared locals sit AFTER the params, so the slot is `paramCount + pos`
// where `pos` is the name's resolved declared-local position (`declaredSlotOf`).
function declaredIndexOf(fnIx: i32, name: string) {
  const pos = declaredSlotLive(name)
  if pos < 0 { return -1 }
  if fnIx < 0 {
    // Module scope = the START FUNCTION's body (top-level statements — a `for`
    // loop's var/bound live here). It has no params, so the local index IS the
    // slot. (A global-section constexpr init also runs with fnIx -1, but the
    // scope stack is empty there, so `declaredSlotOf` already returned -1.)
    return pos
  }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl { return envSlotShift(fnIx) + fn.fnParams.length + pos }
  -1
}

// The wasm-local-index offset introduced by the env-leading closure param: when ANY
// function value exists in the module (`fnValUsed`), EVERY function (except the start
// fn, `fnIx < 0`) carries a hidden leading `structref env` at local 0, so its declared
// params shift to locals 1..p and its declared locals to p+1... Zero otherwise — so a
// no-lambda module keeps the original 0-based param layout and stays byte-identical.
export function envSlotShift(fnIx: i32) {
  if fnValUsed && fnIx >= 0 { return 1 }
  0
}

// Resolve an identifier `name` to its wasm local index for function `fnIx`: a param
// first (locals 0..p-1, shifted past the env param when `fnValUsed`), else a declared
// local. Returns -1 if neither.
export function localIndexOf(fnIx: i32, name: string) {
  const pIx = paramIndexOf(fnIx, name)
  if pIx >= 0 { return envSlotShift(fnIx) + pIx }
  declaredIndexOf(fnIx, name)
}

// Emit the instructions for the returned expression at `exprIx` onto `body`, in
// stack order, resolving identifiers against function `fnIx`'s params. Returns 0
// on success, or calls `emitFail` and returns -1 on any unsupported shape.
//
// Supported operands (any of which may nest as children):
//   NumLit  -> i32.const <value>           (the literal, via parseI32 + slebToArr)
//   Ident   -> local.get <param index>     (a parameter reference)
//   BinExpr -> emit(left), emit(right), <opcode>   (operands first, then the op,
//              the natural wasm post-order stack encoding; arithmetic OR comparison).
//              Logical `&&`/`||` instead lower to a SHORT-CIRCUIT value-typed `if`
//              (blocktype 0x7f): `a && b` ≡ if(a){b}else{0}, `a || b` ≡ if(a){1}else{b}.
//   Unary   -> negation `-x` as i32.const 0, emit(x), i32.sub; logical `!a` as eqz (0x45)
//   Call    -> emit each arg left-to-right, then `call <funcIndex>` (the callee is
//              an `Ident` resolved through the function-index map; recursion works
//              because the function's own name is mapped before its body is emitted)
//   Paren   -> the inner expression (parentheses carry no runtime instruction)
//
// Node shapes read (all from `compiler/ast.vl`):
//   NumLit  { numText: string }
//   Ident   { identName: string }
//   Unary   { unOp: string, unArg: i32 }
//   BinExpr { binOp: string, binLeft: i32, binRight: i32 }
//   Call    { callFn: i32, callArgs: i32[] }
//   Paren   { parInner: i32 }
// The wasm struct field index of `name` within struct `si` (declaration order), or
// -1 if that struct has no such field.
export function sFieldIndex(si: i32, name: string) {
  if si < 0 {
    return -1 // unresolved struct (e.g. an inferred ref with no interned shape)
  }
  const start = sFieldStart[si]
  const cnt = sFieldCount[si]
  let j = 0
  while j < cnt {
    if sFieldNames[start + j] == name { return j }
    j = j + 1
  }
  -1
}

// The wasm-type code (`0` i32, `3` string, `4` i32-list, `5` ref-list) of struct `si`'s
// field at field index `fi`.
export function sFieldTypeAt(si: i32, fi: i32) {
  sFieldTypes[sFieldStart[si] + fi]
}

// The ref-list element type-NAME of struct `si`'s field `fi` (a code-5 field), "" else.
export function sFieldElemNameAt(si: i32, fi: i32) {
  sFieldElemName[sFieldStart[si] + fi]
}

// The ARENA type of struct `si`'s field `fi`'s element/target (destringify D5) — the
// `sFieldElemTyIx` sidecar's accessor, `sFieldElemNameAt`'s structural twin. -1 when
// the sidecar does not cover the row (a shorter sidecar is the pad-on-push self-heal,
// an unresolvable `#anonN` element spelling is a recorded -1); every consumer treats
// -1 as "keep the name path".
export function sFieldElemTyIxAt(si: i32, fi: i32): i32 {
  const ix = sFieldStart[si] + fi
  if ix >= sFieldElemTyIx.length { return -1 }
  sFieldElemTyIx[ix]
}

// The `sFieldElemTyIxAt` twin for VARIANT fields (`uFieldElemTyIx`).
export function uFieldElemTyIxAt(vi: i32, fi: i32): i32 {
  const ix = uFieldStart[vi] + fi
  if ix >= uFieldElemTyIx.length { return -1 }
  uFieldElemTyIx[ix]
}

// The same two sidecars addressed by their FLAT row index — the form the field-table
// re-derivation passes in `emit_collect` hold, because they walk `sFieldTypes` /
// `uFieldTypes` straight through rather than per (struct, field) pair. Same uncovered
// answer as the `…At` pair above (-1 = "keep the name path"), and the same pad-on-push
// self-heal behind it.
export function sFieldElemTyIxRow(ix: i32): i32 {
  if ix < 0 { return -1 }
  if ix >= sFieldElemTyIx.length { return -1 }
  sFieldElemTyIx[ix]
}

export function uFieldElemTyIxRow(ix: i32): i32 {
  if ix < 0 { return -1 }
  if ix >= uFieldElemTyIx.length { return -1 }
  uFieldElemTyIx[ix]
}

// The KEY half of struct `si`'s MAP field `fi` (B6b): true when the field's type is an
// i32-keyed map. `sFieldElemKeyI32At`'s uncovered answer is FALSE (string-keyed), the
// same self-heal shape the arena sidecar's -1 has — and the same conservative one, since
// the string key is what every row meant before the column existed.
export function sFieldElemKeyI32At(si: i32, fi: i32): boolean {
  sFieldRowKeyI32(sFieldStart[si] + fi)
}

// The FLAT-ROW form, for the passes that walk the whole field table by row index rather
// than by (struct, field) — `collectA`'s field re-derivation is the one that must not
// lose the key, because an INLINE `{m: {[i32]: V}}` shape is ONE `TypeRef` whose map
// never reaches the annotation scan's own bare-map arm.
export function sFieldRowKeyI32(row: i32): boolean {
  if row >= sFieldElemKeyI32.length { return false }
  sFieldElemKeyI32[row] == 1
}

// The `sFieldElemKeyI32At` twin for VARIANT fields (`uFieldElemKeyI32`).
export function uFieldElemKeyI32At(vi: i32, fi: i32): boolean {
  uFieldRowKeyI32(uFieldStart[vi] + fi)
}

// The `sFieldRowKeyI32` twin for the VARIANT field table.
export function uFieldRowKeyI32(row: i32): boolean {
  if row >= uFieldElemKeyI32.length { return false }
  uFieldElemKeyI32[row] == 1
}

// THE ONE HOME of "which map does struct `si`'s MAP field `fi` denote" — the shape
// vocabulary every map op site threads (`-1` mono string-keyed, `-4` mono i32-keyed, a
// `>= 0` mv slot for a ref/wide value on either key).
//
// Before B6b this was `mvSlotOfValNameFind(sFieldElemNameAt(si, fi))` spelled at four
// sites (the type SECTION's struct loop, the object-literal construct seed, the field
// STORE seed, and `mapShapeOfExpr`'s struct-receiver arm), each of which read the VALUE
// column alone — so an i32-keyed map field would have resolved its string-keyed twin's
// map struct. The FIELD ROW's key column (`sFieldElemKeyI32`) is the missing half, and
// naming the composition once is what keeps the four sites from disagreeing.
//
// ARENA first (the `sFieldMapValSlot` discipline it replaces): the recorded VALUE type
// resolves through the mv layer's own key, PAIRED with the row's key rep. Every negative
// falls through to the name resolver unchanged, so the mono verdict and the loud
// "no interned slot" failure stay exactly where they were — with the mono verdict now
// naming WHICH mono struct it means (`mapMonoShapeOfKey`), which is the whole point.
export function sFieldMapShape(si: i32, fi: i32): i32 {
  const ki = sFieldElemKeyI32At(si, fi)
  const a = mvSlotOfTyK(sFieldElemTyIxAt(si, fi), ki)
  if a >= 0 { return a }
  const s = mvSlotOfValNameFindK(sFieldElemNameAt(si, fi), ki)
  if s == -1 { return mapMonoShapeOfKey(ki) }
  s
}

// The `sFieldMapShape` twin for a VARIANT's map field, off the `uFieldElemTyIx` /
// `uFieldElemKeyI32` sidecars (the `uFieldTgtStructIdx` / `variantFieldRefSlot` shape).
export function uFieldMapShape(vi: i32, fj: i32): i32 {
  const ki = uFieldElemKeyI32At(vi, fj)
  const a = mvSlotOfTyK(uFieldElemTyIxAt(vi, fj), ki)
  if a >= 0 { return a }
  const s = mvSlotOfValNameFindK(variantFieldElemName(vi, fj), ki)
  if s == -1 { return mapMonoShapeOfKey(ki) }
  s
}

// The ref-list table SLOT for an ARENA element type (destringify D5) — the
// arena-input entry point to the layer `repElemKey` ALREADY keys: `rlInternName`
// interns each slot on `repElemKey` and `rlSlotByName` scans the same column, so this
// is a lookup, not new design. It answers `rlSlotByName`'s first two rungs (the
// exact-stored-name fast path and the `repElemKeyOfNameTy` rescan, which resolves the
// name back to an arena type to compute exactly this key) directly from the type. The
// THIRD rung — the struct-twin name FALLBACK — has no arena input and is deliberately
// NOT reproduced here: a caller keeps its name path for the -1 answer, the
// ladder-faithful shape D1's leg C prescribed (the arena replaces the predicate in
// place; the fall-through is untouched).
export function rlSlotOfTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  const key = repElemKey(ty)
  if key == "" { return -1 }
  let i = 0
  while i < rlElemKey.length {
    if rlElemKey[i] == key { return i }
    i = i + 1
  }
  -1
}

// The ARENA type a ref-list SLOT's stored element name denotes (destringify
// D5-final), or -1 when the sidecar does not cover the slot. The column pads on
// push, so a lagging or missing entry answers "uncovered" and every consumer keeps
// its element-NAME path.
export function rlElemTyIxAt(slot: i32): i32 {
  if slot < 0 { return -1 }
  if slot >= rlElemTyIx.length { return -1 }
  rlElemTyIx[slot]
}

// ── the RENDER→PARSE round trip: "did the checker type this node as a FUNCTION" ──
// `nodeTyName(ix)` RENDERS the node's recorded arena type; three consumers then took
// the render apart with `annArrowAt(...) >= 0` (a top-level `=>` scan). The renderer
// had the type, so the consumers can have it too (destringify D-ARROWTY).
//
// The dual is EXACT, not approximate, for every render `nodeTyName` can produce:
//   · `TyPrim` / `TyObj` render through `tyToStr`, which spells a function type with
//     `->` and never `=>`, and wraps an object in `{…}` so nothing sits at depth 0;
//   · `TyArray` renders `tyToEmitName(elem) + "[]"` with the element PARENTHESIZED
//     whenever it is a `TyFunc` (or contains a top-level `|`), precisely so the
//     trailing `[]` cannot bind into a closure result — so an array's render has no
//     depth-0 `=>` either;
//   · `TyFunc` renders `"(" + params + ")=>" + result`, whose `=>` is always at
//     depth 0 by construction;
//   · every other kind renders "".
// So for a NON-EMPTY render, `annArrowAt(nm) >= 0` holds exactly when the type is a
// `TyFunc`. The one residual is a `TyFunc` whose render FAILS ("" — an unrenderable
// param/result): the name test says no and this says yes. Callers therefore keep the
// `!= ""` render guard where they already had one, which makes the substitution
// byte-exact rather than merely measured. (Measured anyway: 0 disagreements in 11,846
// comparisons over 1,274 corpus files + 50,400 fuzz programs, in BOTH directions.)
export function nodeTyIsFuncTy(ix: i32): boolean {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyFunc { return true }
  false
}

// `refArrElemName`'s structural dual over a ref-list ELEMENT type: peel one
// `TyNullable` hop (the `(S[] | null)[]` niche the name path recurses through),
// then take the `TyArray`'s element. -1 when the element is not an array — the
// name path answers "" there and its `rlSlotByName("")` misses, so both legs
// decline together.
export function tyRefArrElemOf(ty: i32): i32 {
  if ty < 0 { return -1 }
  let b = ty
  const t = T.tys[b]
  if t is TyNullable { b = t.nInner }
  if b < 0 { return -1 }
  const bt = T.tys[b]
  if bt is TyArray { return bt.aElem }
  -1
}

// The ref-list slot of a NESTED ref-list element's INNER list — the arena reading
// of `rlSlotByName(refArrElemName(rlElemName[slot]))`. -1 when the sidecar does not
// cover the slot, the element is not an array, or no slot claims the element type;
// every caller keeps its name path for that answer (the ladder-faithful shape).
export function rlInnerSlotOfElem(slot: i32): i32 {
  rlSlotOfTy(tyRefArrElemOf(rlElemTyIxAt(slot)))
}

// ── the ref-array ANNOTATION-NODE chokepoints (destringify D-REFARR) ──────────
// The three interior parsers (`refArrElemName` / `nameIsRefArray` / `refArrElemKind`)
// are the reflist layer's own naming machinery. Their ANNOTATION-position consumers
// all ask ONE of two questions, and the arena answers both without rendering a name:
//
//   * "what ref-list ROW holds this annotation's element" — INTERN STATE, not shape.
//     `rlSlotOfTy` is the layer's own `repElemKey` lookup, so this is the SAME
//     question `rlSlotByName(refArrElemName(...))` asks, minus the round trip through
//     a rendered element name.
//   * "is this annotation a (nullable) ref array" — which every such consumer resolves
//     by that same row existing. Deliberately NOT the structural "a `TyArray` over a
//     non-scalar element": that dual was REFUTED in D-UNION batch 3 (2 disagreements in
//     50,400 fuzz programs) precisely because `nameIsRefArray` also requires the element
//     be NAMEABLE by the reflist layer. Asking for the ROW asks the intern-state
//     question directly, so the refuted gap cannot open.
//
// `1` when the type-ANNOTATION node's recorded arena type is a `TyNullable`, `0` when it
// is not, `-1` when the checker recorded no type for the node (an emitter synthesis the
// `synthTypeRef` recorder could not resolve, or a node never checked). The tri-state keeps
// "uncovered" distinguishable from "not nullable", so a caller never reads a missing row
// as a positive answer.
export function annTyNulFlag(tyNodeIx: i32): i32 {
  if tyNodeIx < 0 { return -1 }
  const ty = nodeTyIxOf(tyNodeIx)
  // A node the checker never typed falls to the INTERN sidecar's flag, which the
  // ref-array arm records from the very spelling the name path would peel.
  if ty < 0 { return annRlNulAt(tyNodeIx) }
  const t = T.tys[ty]
  if t is TyNullable { return 1 }
  0
}

// ── the intern-pass ANNOTATION-NODE sidecar (`annRlSlot` / `annRlNul`) ────────
// `collectA` already resolves every ref-array ANNOTATION spelling into the ref-list
// table (class (iii), the parser-domain intern side this program keeps): its arm
// runs on exactly the names `nameIsRefArray` / `nameIsNulRefList` accept, and the
// row it interns IS the row every annotation-node consumer asks for. Banking that
// row per NODE turns the consumers' question into a lookup — so a consumer needs no
// leg of its own for a spelling the intern pass has already resolved, whether or not
// the checker recorded a type for the node.
//
// The two annotation SYNTHESES that postdate the final `collectA#2` run
// (`synthParamAnnots`, `collectLocals`' inferred `<elem>[]` binding) record here at
// their own mint sites, so the sidecar covers the whole annotation population rather
// than the subset one pass happens to walk.
export function recordAnnRlSlot(nodeIx: i32, slot: i32, nul: i32) {
  if nodeIx < 0 { return 0 }
  if slot < 0 { return 0 }
  while annRlSlot.length <= nodeIx {
    annRlSlot.push(-1)
    annRlNul.push(-1)
  }
  annRlSlot[nodeIx] = slot
  annRlNul[nodeIx] = nul
  0
}

// The ref-list ROW the intern pass recorded for annotation node `nodeIx`, or -1.
export function annRlSlotAt(nodeIx: i32): i32 {
  if nodeIx < 0 { return -1 }
  if nodeIx >= annRlSlot.length { return -1 }
  annRlSlot[nodeIx]
}

// The intern pass's `| null` flag for annotation node `nodeIx` (`1` a nullable ref
// array, `0` a bare one), or -1 when the node is not a recorded ref-array annotation.
export function annRlNulAt(nodeIx: i32): i32 {
  if nodeIx < 0 { return -1 }
  if nodeIx >= annRlNul.length { return -1 }
  annRlNul[nodeIx]
}

// The ref-list table SLOT the ref-ARRAY type a type-annotation node names — the arena
// reading of `rlSlotByName(refArrElemName(<the node's rendered name>))`. `tyRefArrElemOf`
// peels the SAME single `| null` hop the name path peels with `nullablePartOf` before
// taking the element, so a `S[] | null` annotation resolves its inner ref-list row here
// exactly as `refArrElemName(nullablePartOf(...))` does. -1 when the node has no recorded
// type, is not an array, or no row claims the element — every caller keeps its name path
// on -1 (D1 leg C: the arena replaces the predicate in place, the fall-through is untouched).
export function annRefArrSlot(tyNodeIx: i32): i32 {
  if tyNodeIx < 0 { return -1 }
  const a = rlSlotOfTy(tyRefArrElemOf(nodeTyIxOf(tyNodeIx)))
  if a >= 0 { return a }
  // The INTERN-pass sidecar: the row `collectA` interned for THIS node. Covers what
  // the recorded type cannot — a node the checker never typed, and an element the
  // reflist layer keys by a synthetic name (`#anonN`) no arena key can match.
  annRlSlotAt(tyNodeIx)
}

// `annRefArrSlot` restricted to a NON-nullable annotation. The consumers that ask
// `nameIsRefArray(<the whole annotation>)` get NO for a `S[] | null` spelling (the name
// predicate does not peel a top-level `| null`), so their arena leg must decline it too —
// without this gate `tyRefArrElemOf`'s nullable hop would answer where the name says no.
export function annBareRefArrSlot(tyNodeIx: i32): i32 {
  if annTyNulFlag(tyNodeIx) != 0 { return -1 }
  annRefArrSlot(tyNodeIx)
}

// `annRefArrSlot` restricted to a NULLABLE annotation (`<ref-array> | null`) — the dual of
// `annBareRefArrSlot`. The consumers that peel `nullablePartOf` FIRST and decline a
// non-null spelling outright need the same restriction on the arena leg.
export function annNulRefArrSlot(tyNodeIx: i32): i32 {
  if annTyNulFlag(tyNodeIx) != 1 { return -1 }
  annRefArrSlot(tyNodeIx)
}

// `structIdxOfElemName`'s structural dual: the struct-table row of a ref-list
// element TYPE, peeling the `| null` niche exactly as the name path does before
// resolving. -1 when uncovered / not a declared row (the caller keeps its name path).
export function structIdxOfElemTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  let b = ty
  const t = T.tys[b]
  if t is TyNullable { b = t.nInner }
  structIndexOfTy(b)
}

// The struct-table row of a ref-list SLOT's element, off the arena sidecar.
export function rlElemStructIdxAt(slot: i32): i32 {
  structIdxOfElemTy(rlElemTyIxAt(slot))
}

// The recorded element type of ref-list slot `slot` with its `| null` niche peeled —
// the arena reading of `nullablePartOf(rlElemName[slot])`, and the input the canon-key
// row rung keys on. -1 when the sidecar does not cover the slot.
export function rlElemNonNulTyAt(slot: i32): i32 {
  const ty = rlElemTyIxAt(slot)
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyNullable { return t.nInner }
  ty
}

// Tri-state dual of `nullablePartOf(rlElemName[slot]) != ""`: `1` the element type
// is a `TyNullable`, `0` it is not, `-1` the sidecar does not cover the slot — the
// caller then keeps its name test, so the arena never answers where it cannot.
export function rlElemTyNullableAt(slot: i32): i32 {
  const ty = rlElemTyIxAt(slot)
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyNullable { return 1 }
  0
}

// The `$fnsig` key of a CLOSURE-element ref-list slot, off the arena: peel the
// `| null` niche (the narrowed indexed call casts to the same functype a non-null
// element does), then key the `TyFunc` spine directly (`sigKeyOfTy`, destringify
// D3) instead of stripping the element name's grouping parens and re-parsing the
// rendered signature. "" when uncovered or not a function type.
export function rlElemCloSigKeyAt(slot: i32): string {
  const ty = rlElemTyIxAt(slot)
  if ty < 0 { return "" }
  let b = ty
  const t = T.tys[ty]
  if t is TyNullable { b = t.nInner }
  if b < 0 { return "" }
  const bt = T.tys[b]
  if bt is TyFunc { return sigKeyOfTy(b) }
  ""
}

// The INNER ref-list slot of a nested / nullable ref-array ELEMENT (destringify
// D5-final) - the chokepoint the `rlSlotByName(refArrElemName(rlElemName[s]))`
// readers share. ARENA first (`rlElemTyIx` then the `TyArray`'s element then
// `rlSlotOfTy`, the layer's own `repElemKey` lookup); the element-NAME surgery is the
// untouched fall-through for a slot the sidecar does not cover (D1 leg C).
export function rlElemInnerSlot(slot: i32): i32 {
  const ar = rlInnerSlotOfElem(slot)
  if ar >= 0 { return ar }
  rlSlotOfArrName(rlElemName[slot])
}

// The interned ref-list SLOT of union MEMBER `m`'s ref-ARRAY arm (destringify
// D-UARMSLOT) — the arena reading of the four arm scanners' shared per-atom step
// (`a != "null" && valueAtomKind(a) < 0 && nameIsRefArray(a)`, then
// `rlSlotByName(refArrElemName(a))`), and the answer to D-UNION's standing refutation.
//
// That refutation is about the SHAPE predicate: `unMemIsRefElemArray` (a `TyArray`
// over a non-scalar) accepts an element the reflist layer never NAMED, where
// `nameIsRefArray` folds INTERN STATE into its answer — so substituting it
// over-accepts. This asks the intern-state question DIRECTLY: not "is this member
// structurally a ref array" but "does the ref-list table hold a ROW for this member's
// element type", which is what all four consumers actually want. A member the layer
// never named has no row and declines here exactly as `rlSlotByName("")` does; a
// member that is not an array at all declines inside `tyRefArrElemOf`. -1 = no arm.
//
// A bare-SCALAR array member (`i32[]`, `string[]`) cannot answer through this by
// construction: a ref-list row's element type is never a bare scalar (a scalar leaf
// list is not a ref list — the rows of kinds 4/6/7/8/10 hold LIST elements), so
// `rlSlotOfTy` of a scalar finds no row. Measured: 0 disagreements with the name step
// over 5,727 corpus + 310,467 fuzz member comparisons (1,243 files + 100,800
// programs), and the member columns covered 100% of those reaches.
export function unMemRefArrArmSlot(m: i32): i32 {
  rlSlotOfTy(tyRefArrElemOf(m))
}

// The STRUCT-TABLE ROW of a ref-list element (destringify D5-final, D-ELEMROW) — the
// chokepoint the `structIdxOfElemName(rlElemName[s])` readers share. THREE rungs, in the
// order `structIdxOfElemName` itself resolves them (method note 26: a resolver is a
// LADDER, and a dual of one rung is not a dual of the resolver):
//
//   1. ARENA IDENTITY — the recorded element type, `| null` peeled, through the D0
//      `sTyIx` sidecar (`rlElemStructIdxAt`).
//   2. NOMINAL IDENTITY — `structIndexByName` on the stored spelling. A name is a name:
//      this is the exact-match rung the name ladder opens with, and the only rung that
//      answers for a row the arena does not cover — and the uncovered population is
//      EXACTLY the synthetic-`#anonN` one, cross-tabbed both ways (24 of 24 corpus and
//      36 of 36 fuzz calls, with 0 uncovered non-`#` and 0 covered `#`).
//   3. The CANON-KEY row, off the RECORDED TYPE (`repRowOfTyStruct`) — what
//      `repRowOfName` computes, minus its `renderFaithful` + `resolveAnnot` re-parse of
//      a spelling the intern site already resolved.
//
// The `structIndexOfTypeName` rung the name ladder ends with — `nameIsWholeSpanShape` +
// `shapeFieldParse` + the `shapeFieldTypeCompat`-tightened field-name-set scan — is
// DELETED here, not laddered: it is the ANSWERING rung at this site **0** times over
// 1,243 corpus files and 100,800 fuzz programs (rung 1 answers 48 + 468 of the calls
// where the arena identity declines, rung 3's dual 16 + 624, the fieldset scan 0 + 0).
// The `| null` peel above it is NOT deletable and is kept: dropping it declines 4 calls
// in 2 fuzz programs that resolve a row today.
//
// The LENIENT (untightened) field-name-set scan `rlSlotOfTyTwin` uses is deliberately
// NOT a rung here: it disagrees with the name resolver on 18 corpus and 148 fuzz calls.
// A twin-row consumer can absorb a lenient match (`repStructSlotsTwin` re-gates it);
// this row is a store/push struct index, where a leniently-matched row is a wrong heap
// type — the same asymmetry method note 27 draws around layout twins, in reverse.
export function rlElemStructRow(slot: i32): i32 {
  const ar = rlElemStructIdxAt(slot)
  if ar >= 0 { return ar }
  const ln = nonNulBaseOf(rlElemName[slot])
  const bn = structIndexByName(ln)
  if bn >= 0 { return bn }
  repRowOfTyStruct(rlElemNonNulTyAt(slot), sScanLim())
}

// The array-LITERAL element's struct row: the same arena leg, but the fall-through is
// the NOMINAL `structIndexByName` this site has always used (NOT the structural bridge
// `structIdxOfElemName` adds) - a -1 here routes on to the concrete-VARIANT lookup, so
// widening the name leg would change which arm answers. That is now MEASURED, not
// argued: giving this site `rlElemStructRow`'s canon-key rung (in either order) changes
// the answer on **7** corpus calls and **311** fuzz programs — every one of them a
// both-decline today, i.e. exactly the -1 the variant route depends on.
export function rlElemLitStructRow(slot: i32): i32 {
  const ar = rlElemStructIdxAt(slot)
  if ar >= 0 { return ar }
  const ln = nonNulBaseOf(rlElemName[slot])
  structIndexByName(ln)
}

// Is a ref-list slot's element a NULLABLE NICHE (destringify D5-final)? ARENA first
// (`T.tys[..] is TyNullable`), the `nullablePartOf` render test for an uncovered row.
export function rlElemIsNulNiche(slot: i32): boolean {
  const ar = rlElemTyNullableAt(slot)
  if ar >= 0 { return ar == 1 }
  nullablePartOf(rlElemName[slot]) != ""
}

// The `$fnsig` key of a CLOSURE-element ref-list slot (destringify D5-final): the
// arena keys the `TyFunc` spine directly (`sigKeyOfTy`, D3), so the grouping-paren
// strip + `annSigKey` re-parse of the rendered element name is the fall-through only.
export function rlElemCloSigKey(slot: i32): string {
  const ar = rlElemCloSigKeyAt(slot)
  if ar != "" { return ar }
  const nm = nonNulBaseOf(rlElemName[slot])
  // The grouping-paren SPAN is `tyname.nameIsParenSpanEnds` (first char `(`, last char
  // `)`, NO balance walk). The `nm.length < 2` early return this replaced is IMPLIED by the
  // home, not dropped: on a one-character name `nm[0]` and `nm[nm.length - 1]` are the SAME
  // character and no character is both `(` and `)`, so both readings decline — and the
  // interior cut below is unreachable for any name the home admits.
  // Deliberately NOT the balanced walk (`peelGroupParens` / `normTypeAtom`): widening the
  // span here would re-key a `(a)|(b)`-shaped element, which the home's header records as
  // the reason it carries none.
  if !nameIsParenSpanEnds(nm) { return "" }
  // …and the CUT that pairs with it is `tyname.groupInnerOf`, the delimiter-blind home
  // (W1). The span test stays in FRONT of it because the cut carries no endpoint test —
  // this site wants the PAREN span and the shape sites below want the BRACE one.
  annSigKey(groupInnerOf(nm))
}

// The mv slot of a MAP-element ref-list slot's inner VALUE — the arena reading of
// `mvSlotOfMapValNameOrMono(mapValNameOf(rlElemName[slot]))`, the ref-list twin of
// `mvValInnerMvSlotAt`.
// SENTINEL DISCIPLINE (D3'): the name resolver is TRI-STATE and overloaded (`-1` = a
// MONO i32 map riding the shared struct, `-3` = uninterned/unsupported, `>= 0` = a
// slot), so this leg answers ONLY a real slot (>= 0); every negative — uncovered, not
// a map type, no row claims the inner value — is indistinguishable from "mono" here
// and is therefore swallowed by the chokepoint, never returned to a caller.
// `peelNul` strips ONE `TyNullable` hop first, the arena reading of the
// `nulMapInnerName` peel the list-of-maps composition read performs; the twin
// comparator and the nested-map read do NOT peel (`mapValNameOf` declines a nullable
// spelling, so both legs decline together there).
export function rlElemMapValMvSlotAt(slot: i32, peelNul: boolean): i32 {
  const ty = rlElemTyIxAt(slot)
  if ty < 0 { return -1 }
  let b = ty
  const t = T.tys[b]
  if peelNul {
    if t is TyNullable { b = t.nInner }
  }
  if b < 0 { return -1 }
  const bt = T.tys[b]
  // The slot's KEY comes off the SAME `TyMap` its value does — one hop, both halves.
  if bt is TyMap { return mvSlotOfTyK(bt.mVal, tyMapKeyIsI32(b)) }
  -1
}

// The KEY half of the same element question: `1` the ref-list element is an i32-KEYED
// map, `0` it is string-keyed, `-1` the sidecar does not cover the slot / the element is
// not a map (the caller keeps its element-NAME leg). Always peels one `TyNullable`, as
// the value twin does with `peelNul` — a `{[i32]: V} | null` element carries the SAME
// map struct as its non-null twin, so its key must answer the same too.
export function rlElemMapKeyI32(slot: i32): boolean {
  const ar = rlElemMapKeyI32At(slot)
  if ar >= 0 { return ar == 1 }
  let en = rlElemName[slot]
  const enn = nulMapInnerName(en)
  if enn != "" { en = enn }
  nameIsI32KeyedMap(en)
}

export function rlElemMapKeyI32At(slot: i32): i32 {
  const ty = rlElemTyIxAt(slot)
  if ty < 0 { return -1 }
  let b = ty
  const t = T.tys[b]
  if t is TyNullable { b = t.nInner }
  if b < 0 { return -1 }
  const bt = T.tys[b]
  if bt is TyMap {
    if tyMapKeyIsI32(b) { return 1 }
    return 0
  }
  -1
}

// The map SHAPE a `Map()` must build to sit in ref-list slot `slot`'s ELEMENT position —
// the ref-list twin of `mvInnerMapShape` (the map-VALUE boundary) and of
// `letMapShapeOf` (the binding boundary). ARENA first, the element-NAME leg behind it,
// exactly as its `rlElemMapValMvSlotAt` / `rlElemMapKeyI32` siblings above: `-1`/`-4` the
// MONO struct of the element's key rep, `>= 0` the element's own (KEY, VALUE) mv slot,
// `-3` a value the mv layer does not intern (which `emitMapNew` turns into its loud
// reject). Only meaningful when the slot's element kind is 3 (a map).
//
// A LIST OF MAPS had no such home, and its absence is why `const xs: {[string]: V}[] =
// [Map()]` was invalid wasm for every value type with a per-value map struct: the
// element `Map()` reached `emitMapNew` with the ambient `pendingMapSlot` (-1 — the MONO
// struct) and `struct.new`'d that into a ref backing typed to the element's OWN struct.
// Silently right for exactly the three values whose struct IS the mono one (`i32`,
// `boolean`, a literal-union atom) and silently wrong for the other twelve — the same
// shape, one composition position over, as the map-VALUE seed #1286 named.
export function rlElemMapShape(slot: i32): i32 {
  const ar = rlElemMapValMvSlotAt(slot, true)
  if ar >= 0 { return ar }
  let en = rlElemName[slot]
  const enn = nulMapInnerName(en)
  if enn != "" { en = enn }
  mvShapeOfMapName(en)
}

// The mv slot a MAP-element ref-list slot's value type occupies (destringify
// D5-final (c)) — the chokepoint the
// `mvSlotOfMapValNameOrMono(mapValNameOf(rlElemName[s]))` readers share. ARENA first
// (`rlElemTyIx` → the `TyMap`'s value → `mvSlotOfTy`, the mv layer's own
// `repMvValKey` lookup), and ONLY for a real slot: the name resolver's `-1` (mono)
// and `-3` (unsupported) answers stay its own.
export function rlElemMapValMvSlot(slot: i32): i32 {
  const ar = rlElemMapValMvSlotAt(slot, false)
  if ar >= 0 { return ar }
  mvSlotOfMapName(rlElemName[slot])
}

// `rlElemMapValMvSlot` for a slot whose element may be a NULLABLE map: the arena leg
// peels one `TyNullable`, the name leg the `nulMapInnerName` spelling, before asking
// for the value's slot. Same sentinel discipline.
export function rlElemNulMapValMvSlot(slot: i32): i32 {
  const ar = rlElemMapValMvSlotAt(slot, true)
  if ar >= 0 { return ar }
  let cen = rlElemName[slot]
  const cnin = nulMapInnerName(cen)
  if cnin != "" { cen = cnin }
  mvSlotOfMapName(cen)
}

// The ARENA type a map-VALUE slot's stored value name denotes (destringify D5-final
// (b)), or -1 when the sidecar does not cover the slot. `mvValTyIx` pads on push and
// is emptied per PROGRAM (method note 7), so a lagging / stale row answers
// "uncovered" and every consumer keeps its value-NAME path.
export function mvValTyIxAt(slot: i32): i32 {
  if slot < 0 { return -1 }
  if slot >= mvValTyIx.length { return -1 }
  mvValTyIx[slot]
}

// The INNER ref-list slot of a ref-LIST-valued map slot — the arena reading of
// `rlSlotByName(refArrElemName(mvValName[slot]))`. A SLOT is a REP question (D2), so
// it resolves through `rlSlotOfTy`/`repElemKey` — the key the ref-list layer is
// interned on — never `repCanonKey`. -1 when the sidecar does not cover the slot, the
// value is not an array, or no ref-list slot claims the element type.
export function mvValInnerRlSlotAt(slot: i32): i32 {
  rlSlotOfTy(tyRefArrElemOf(mvValTyIxAt(slot)))
}

// The mv slot of a nested MAP-valued slot's INNER value — the arena reading of
// `mvSlotOfMapValNameOrMono(mapValNameOf(mvValName[slot]))`.
// SENTINEL DISCIPLINE (D3'): the name resolver's misses are TRI-STATE and overloaded
// (`-1` = a MONO i32 map riding the shared struct, `-3` = uninterned/unsupported), so
// the arena leg answers ONLY a real slot (>= 0); every negative — uncovered, not a map
// type, no row claims the inner value — falls through to the name path. No caller can
// see the arena's miss value, so an arena miss can never be read as "mono".
export function mvValInnerMvSlotAt(slot: i32): i32 {
  const ty = mvValTyIxAt(slot)
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  // NOT peeled through a `| null`: `mapValNameOf` requires a bare `{[K]:V}` spelling
  // too (it answers "" for a nullable map name), so both legs decline together.
  if t is TyMap { return mvSlotOfTyK(t.mVal, tyMapKeyIsI32(ty)) }
  -1
}

// Tri-state dual of `unionHasAtomTy(mvValName[slot], "null", false)` over a BOXED-union map
// value: `1` the value type admits null, `0` it does not, `-1` the sidecar does not
// cover the slot / the type is not a union (the caller keeps its member-set test).
export function mvValUnionHasNullAt(slot: i32): i32 {
  const ty = mvValTyIxAt(slot)
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyNullable { return 1 }
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      const mt = T.tys[t.uMembers[i]]
      if mt is TyPrim {
        if mt.primName == "null" { return 1 }
      }
      if mt is TyNullable { return 1 }
      i = i + 1
    }
    return 0
  }
  -1
}

// The single NON-null member of a nullable value type (`TyNullable`'s inner, or the one
// non-null member of an `X | null` union) — `nulRefMapValInnerOf`'s structural front
// half. -1 when the type is not "exactly one non-null member, plus null".
function tyNulSoloMember(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyNullable { return t.nInner }
  if t is TyUnion {
    let solo = -1
    let nonNull = 0
    let hasNull = false
    let i = 0
    while i < t.uMembers.length {
      const mt = T.tys[t.uMembers[i]]
      let isNull = false
      if mt is TyPrim {
        if mt.primName == "null" { isNull = true }
      }
      if isNull {
        hasNull = true
      } else {
        nonNull = nonNull + 1
        solo = t.uMembers[i]
      }
      i = i + 1
    }
    if !hasNull { return -1 }
    if nonNull != 1 { return -1 }
    return solo
  }
  -1
}

// Tri-state dual of `nulRefMapValInnerOf(mvValName[slot]) != ""` — is the slot's value a
// NICHE-nullable ref (string / map / closure / struct, plus null)? `1` yes, `0` no,
// `-1` the arena DECLINES (uncovered, or an object shape the struct table does not
// claim — where the name path's `structIndexByValName` might still resolve). Declining
// is the safe direction: the caller keeps its rendered-name test.
export function mvValNulRefNicheAt(slot: i32): i32 {
  const ty = mvValTyIxAt(slot)
  if ty < 0 { return -1 }
  const t0 = T.tys[ty]
  let nullable = false
  if t0 is TyNullable { nullable = true }
  if t0 is TyUnion { nullable = true }
  if !nullable { return 0 }
  const inner = tyNulSoloMember(ty)
  if inner < 0 { return 0 }
  const it = T.tys[inner]
  if it is TyPrim {
    if it.primName == "string" { return 1 }
    return 0
  }
  if it is TyMap { return 1 }
  if it is TyFunc { return 1 }
  // A LIST member has no niche rep (the vals slot would need the list WRAPPER) — the
  // name path excludes it BEFORE its struct probe, and so does this.
  if it is TyArray { return 0 }
  if it is TyObj {
    if structIndexOfTy(inner) >= 0 { return 1 }
    return -1
  }
  -1
}

// `valueAtomKind`'s arena dual over a union MEMBER type: the same code vocabulary
// (0 i32 · 1 boolean · 2 string · 3 i64 · 4 f64 · 5 f32 · 6 null · 7 i32-backed list ·
// 8 f64 list · 9 string-backed list · 10 i64 list · 11 closure · 12 f32 list). `-1` is
// the arena DECLINING, never "not an atom" — every consumer falls through.
export function tyValueAtomKindOf(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyPrim {
    if t.primName == "i32" { return 0 }
    if t.primName == "boolean" { return 1 }
    if t.primName == "string" { return 2 }
    if t.primName == "i64" { return 3 }
    if t.primName == "f64" { return 4 }
    if t.primName == "f32" { return 5 }
    if t.primName == "null" { return 6 }
    return -1
  }
  if t is TyFunc { return 11 }
  if t is TyArray {
    if tyIsI32LeafElem(t.aElem) { return 7 }
    if tyIsStrLeafElem(t.aElem) { return 9 }
    const et = T.tys[t.aElem]
    if et is TyPrim {
      if et.primName == "f64" { return 8 }
      if et.primName == "i64" { return 10 }
      if et.primName == "f32" { return 12 }
    }
    return -1
  }
  -1
}

// Tri-state dual of `mvUnionIsScalarNull`'s value test: is the boxed union value
// exactly `<scalar> | null` (so the fused `?? d` peels to the RAW unboxed scalar)?
// `1` yes, `0` no, `-1` the arena declines (uncovered, or a member kind it does not
// classify) — the caller keeps its atom-set path.
export function mvValUnionScalarNullAt(slot: i32): i32 {
  const ty = mvValTyIxAt(slot)
  if ty < 0 { return -1 }
  const solo = tyNulSoloMember(ty)
  if solo < 0 { return 0 }
  const ak = tyValueAtomKindOf(solo)
  if ak < 0 { return -1 }
  if ak == 2 { return 0 }
  if ak == 6 { return 0 }
  1
}

// The INNER ref-list slot of a ref-LIST-valued MAP slot (destringify D5-final (b)) —
// the chokepoint the three `rlSlotByName(refArrElemName(mvValName[s]))` readers share.
// ARENA first (`mvValTyIx` → the `TyArray`'s element → `rlSlotOfTy`, the ref-list
// layer's own `repElemKey` lookup); the value-NAME surgery is the untouched
// fall-through for a slot the sidecar does not cover (D1 leg C).
export function mvValInnerRlSlot(slot: i32): i32 {
  const ar = mvValInnerRlSlotAt(slot)
  if ar >= 0 { return ar }
  // …and the fall-through's rung 2 takes the SAME element type as its KEY hint
  // (destringify D-INLINESHAPETY) — the one the arena rung above just computed and
  // found no row for. Both sides start from ONE cell: `mvValTyIx` was recorded by
  // `recordMvValTyIx` off the very `mvValName` spelling peeled here, so this is the
  // arena peel and the name peel of a single row, not two provenances (the distinction
  // #1295 measured at `collect:3465`, where they were two and disagreed 59 times).
  rlSlotOfArrNameTy(mvValName[slot], tyRefArrElemOf(mvValTyIxAt(slot)))
}

// The mv slot of a NESTED-map value's inner value (destringify D5-final (b)). ARENA
// first (`mvValTyIx` → the `TyMap`'s value → `mvSlotOfTy`, the layer's own
// `repMvValKey` lookup), and ONLY for a real slot: the name resolver's `-1` (mono)
// and `-3` (unsupported) answers are its own, never the arena's miss.
export function mvValInnerMvSlot(slot: i32): i32 {
  const ar = mvValInnerMvSlotAt(slot)
  if ar >= 0 { return ar }
  mvSlotOfMapName(mvValName[slot])
}

// Does a BOXED-union map value admit `null` (destringify D5-final (b))? ARENA first
// (a `TyNullable`, or a `TyUnion` with a null member); the union member-SET test is
// the fall-through for a value the sidecar does not cover.
export function mvValUnionHasNull(slot: i32): boolean {
  const ar = mvValUnionHasNullAt(slot)
  if ar >= 0 { return ar == 1 }
  unionHasAtomTy(mvValName[slot], "null", false)
}

// The canonical structural key of a map-VALUE slot (destringify D5-final (b)) — the
// `mvTwin` comparator's input. ARENA first (`repCanonKey` over the recorded index,
// computed at QUERY time so an in-place arena mutation moves both sides together),
// the render-and-re-resolve `repNameCanonKey` for an uncovered row.
export function mvValCanonKey(slot: i32): string {
  const ty = mvValTyIxAt(slot)
  if ty >= 0 { return repCanonKey(ty) }
  repNameCanonKey(mvValName[slot])
}

// The struct-table ROW for an ARENA type (destringify D5) — `structIndexByName`'s
// arena-input twin, scanning the `sTyIx` sidecar (phase D0: the arena type each row
// denotes, recorded at the row's mint) instead of the name column. Same
// first-match-wins order as the name scan. A row the D0 sidecar does not cover is -1
// there and never matches a real type, so the caller falls through to its name path.
export function structIndexOfTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  let i = 0
  while i < sTyIx.length {
    if sTyIx[i] == ty { return i }
    i = i + 1
  }
  -1
}

// The struct-table row a NESTED-STRUCT field (code 15) targets — the chokepoint every
// code-15 consumer shares (field default / literal seed / struct-eq recursion / type
// section / closure-field scan / optional-chain). ARENA first (`sFieldElemTyIx` →
// `structIndexOfTy`), then the recorded NAME (`structIndexByName`) for a row the
// sidecar does not cover.
export function sFieldTgtStructIdx(si: i32, fi: i32): i32 {
  const a = structIndexOfTy(sFieldElemTyIxAt(si, fi))
  if a >= 0 { return a }
  structIndexByName(sFieldElemNameAt(si, fi))
}

// The `sFieldTgtStructIdx` twin for a VARIANT's nested-struct field.
export function uFieldTgtStructIdx(vi: i32, fi: i32): i32 {
  const a = structIndexOfTy(uFieldElemTyIxAt(vi, fi))
  if a >= 0 { return a }
  structIndexByName(uFieldElemName[uFieldStart[vi] + fi])
}

// True if struct `si`'s field `fi` is a literal-union ATOM field (code 0 whose recorded elem name
// is a literal union) — construction/read/assign seed the atom rep (`pendingLitUnion`) for it.
export function sFieldIsLitUnion(si: i32, fi: i32) {
  if sFieldTypeAt(si, fi) != 0 { return false }
  // DESTRINGIFY (the litunion field classifiers): the ARENA leg. "Is this field
  // ATOM-repped?" is a REP question (the program's D2 axis), and the D5 sidecar
  // records the arena type the field's element NAME denotes, so `tyIsLitUnion`
  // answers it structurally instead of re-classifying the rendered spelling.
  // Ladder-faithful (D1 leg C): the arena replaces the PREDICATE in place and the
  // fall-through to the recorded name is untouched, so an uncovered row (-1 — a
  // plain field's "" element, or a spelling that resolved through neither path)
  // still answers exactly as before.
  const ety = sFieldElemTyIxAt(si, fi)
  if ety >= 0 { return tyIsLitUnion(ety) }
  const r = nameIsLitUnionType(sFieldElemNameAt(si, fi))
  r
}

// True if struct `si`'s field `fi` is an ATOM-ARRAY field (`f: K[]` — code 4 whose recorded
// elem name is a litunion array). The field IS the i32 list; construction/assign seed the
// atom-element context so member literals build the i32 backing (not a string list whose
// wrapper ref would mismatch the field type — the `{f: K0[]}` invalid-wasm hole).
export function sFieldIsLitUnionArray(si: i32, fi: i32) {
  if sFieldTypeAt(si, fi) != 4 { return false }
  // The ARENA leg (`sFieldIsLitUnion`'s array sibling): a code-4 atom-array field
  // records its ARRAY type-name, so the sidecar's entry is the `TyArray` and
  // `tyIsLitUnionArray` is the structural reading of "an i32 list of atom ids".
  const ety = sFieldElemTyIxAt(si, fi)
  if ety >= 0 { return tyIsLitUnionArray(ety) }
  const r = nameIsLitUnionArray(sFieldElemNameAt(si, fi))
  r
}

// The union-VARIANT twin of `sFieldIsLitUnionArray`: variant `vi`'s field `fj` is an
// ATOM-ARRAY field (`f: K[]`, code 4 with a recorded litunion-array element name) — the
// variant payload build (`emitVariantStruct`) seeds the atom context so the literal
// builds the i32 list of atom ids, not a string list.
export function variantFieldIsLitUnionArray(vi: i32, fj: i32) {
  if variantFieldTypeAt(vi, fj) != 4 { return false }
  // The ARENA leg, off the `uFieldElemTyIx` sidecar (the struct twin above).
  const ety = uFieldElemTyIxAt(vi, fj)
  if ety >= 0 { return tyIsLitUnionArray(ety) }
  nameIsLitUnionArray(variantFieldElemName(vi, fj))
}

// The union-VARIANT twin of `sFieldIsLitUnion`: variant `vi`'s field `fj` is a
// literal-union ATOM field (code 0 with a recorded litunion element name), so the
// variant payload build and the atom-read classifier seed the atom rep for it. The
// chokepoint for the two sites that spelled this out inline (`emitVariantStruct`'s
// construct arm, `exprIsLitAtom`'s narrowed/variant member read), so both get the
// arena answer from one place.
export function variantFieldIsLitUnion(vi: i32, fj: i32) {
  if variantFieldTypeAt(vi, fj) != 0 { return false }
  const ety = uFieldElemTyIxAt(vi, fj)
  if ety >= 0 { return tyIsLitUnion(ety) }
  nameIsLitUnionType(variantFieldElemName(vi, fj))
}

// The struct table index whose name is `name`, or -1 if `name` is not a declared
// struct type.
export function structIndexByName(name: string) {
  let i = 0
  while i < sNames.length {
    if sNames[i] == name { return i }
    i = i + 1
  }
  -1
}

// The number of FULLY-collected struct entries — the scan bound for any matcher that
// reads a struct's field metadata (`sFieldCount`/`sFieldStart`/`sFieldIndex`). During
// `collectS`'s field-coding loop the IN-FLIGHT declaration has `sNames`/`sFieldStart`
// pushed but `sFieldCount` NOT YET — and `fieldTypeCode` re-enters these matchers (a
// nullable struct-valued map field routes `mvValKindOfName` → `structIndexByValName`),
// so a raw `sNames.length` bound read `sFieldCount` out of bounds: a compiler CRASH
// (fuzz frontier seed 43909430 d4, `type T0 = {f: {[string]: {f: string}} | null}`).
// Outside the reentrancy window the arrays are equal-length — behavior unchanged.
function sScanLim() {
  let n = sNames.length
  if sFieldCount.length < n { n = sFieldCount.length }
  if sFieldStart.length < n { n = sFieldStart.length }
  n
}

// The struct table index whose field-name SET matches the object literal at `objIx`
// EXACTLY (same count, every literal field present in the struct), or -1 if no struct
// matches. With distinct field-name sets across structs this disambiguates which
// struct an `{ … }` literal constructs (the struct analogue of `objVariantName`).
export function structIndexOfObj(objIx: i32) { structIndexOfObjCtx(objIx, -1) }

// Can an object literal's field VALUE — coded `vc` by `anonFieldCode`, node `valIx` —
// be STORED into struct `si`'s field `mfi`, coded `sc`? The fieldset scan in
// `structIndexOfObjCtxGo` is name-only apart from its float and i64 arms, so any two
// literals sharing a field-name SET merge onto ONE interned row and the loser's value
// is written through the WINNER's valtype. Where the valtypes differ that is invalid
// wasm (`{ v: 1 }` beside `{ v: "s" }` stores a string ref into an i32 field); where
// they agree it is a SILENT confusion — `{ v: 6000000000 }` beside `{ v: 2147483647 }`
// read the second literal's field at i64, so `+ 1` did not wrap, and a `{ v: 6 }`
// beside a declared `{ v: boolean | null }` read 6 as that niche's null sentinel.
//
// REFUTATION ONLY, on three standing leniencies:
//   * `vc < 0` is "the value says nothing" (an ident, a call, a map value), never a
//     mismatch — the whole scan is a heuristic over what the value node can be read to
//     mean, and a literal whose fields are all unclassifiable must keep matching by name.
//   * a union BOX field (code 16) accepts every atom by construction, so `{ v: 5 }`
//     still builds a `{ v: i32 | null }` shape.
//   * a field code the value code EQUALS is always storable.
//
// TWO TIERS, and the split is a statement about what a ROW's codes are EVIDENCE of.
// A DECLARED row's codes come from an annotation, and the checker reaches such a
// field through adoption and boxing the field code does not spell: it types a bare
// `{f: 663810583}` against an `f: i64` field and the store re-encodes, it feeds a
// scalar-element array literal to a `(i64|string|{q:i64})[]` field and the elements
// box on the way in. Refuting those pairs breaks working programs, so the composite
// value codes only refute against an ANONYMOUS row — one `collectAnonShapes` minted
// FROM a literal, which is never an annotation target and whose codes are therefore
// exact. The scalar pairs no adoption can bridge (an integer into a string field, a
// string into a plain i32 one) refute against every row.
function anonValueFitsField(vc: i32, sc: i32, valIx: i32, si: i32, mfi: i32) {
  if vc < 0 { return true }
  if sc == 16 { return true }
  const anonRow = sIsAnonRow(si)
  if vc == sc {
    // A NESTED-STRUCT field (code 15) still has to agree on WHICH struct: two
    // `{ n: … }` literals over different inner shapes are both code 15 by name, and
    // merging them stores a `ref $inner2` into a `ref $inner1` field. Both target names
    // must be known to refute — an un-interned inner literal records "" and keeps the
    // lenient match.
    if vc == 15 && anonRow {
      const vn = anonFieldElemName(valIx, 15)
      const fn = sFieldElemNameAt(si, mfi)
      if vn != "" && fn != "" && vn != fn { return false }
    }
    return true
  }
  if vc == 0 {
    // An i32 / boolean / literal-union-atom / arithmetic value.
    // `boolean | null` (21) is an i32 sentinel niche a BOOLEAN value fills — an integer
    // one collides with the sentinel, which is the silent read above.
    // (`isBoolLitExpr` — the code folds booleans and integers together, so the niche
    // test has to ask the node for the distinction the code erased.)
    if sc == 21 { return isBoolLitExpr(valIx) }
    // `K | null` — the i32 atom niche, spare value -1.
    if sc == 30 { return true }
    // The WIDER numeric slots (i64 23, f32 24) and the map slots (19 / 29). An
    // annotated field reaches these from a bare integer literal through the checker's
    // adoption — which `anonFieldCode` reports as the slot's own code only where the
    // adoption was recorded on the node, and it is not always. An anon row's numeric
    // field carries no such promise: a small literal landing there is the collision.
    if sc == 23 || sc == 24 || sc == 19 || sc == 29 { return !anonRow }
    return false
  }
  if vc == 3 {
    // A STRING value. A code-0 field is a plain i32/boolean slot UNLESS it is a
    // literal-union ATOM slot, which records its union name in `sFieldElemName` — and a
    // string literal is exactly how such a field is written (`{ v: "a" }` for
    // `v: "a" | "b"`), so that one stays lenient.
    if sc == 0 { return sFieldElemNameAt(si, mfi) != "" }
    // `string | null` (the same ref, nullable) and `K | null` (a string literal names
    // the atom) are the two niches a string value fills.
    if sc == 20 { return true }
    if sc == 30 { return true }
    return false
  }
  // The COMPOSITE value codes, anon rows only (see the tier note above). Each widens
  // into exactly one nullable spelling of its own backing: `i32[] | null`,
  // `((…) => …) | null`, the wider f64 slot for an f32 value, `f64[] | null`,
  // `i64[] | null`. A nested struct ref (15) has only code 15 and the box above.
  if !anonRow { return true }
  if vc == 4 { return sc == 18 }
  if vc == 14 { return sc == 22 }
  if vc == 24 { return sc == 17 }
  if vc == 25 { return sc == 32 }
  if vc == 26 { return sc == 33 }
  if vc == 15 { return false }
  true
}

// True if struct-table row `si` is an ANONYMOUS shape — one `collectAnonShapes`
// minted from an object literal under a synthetic `#anonN` name, as opposed to a
// declared `type` or an inline-shape annotation. The distinction is what the field
// codes are evidence of: an anon row's codes were READ OFF a literal, so they are
// exact; a declared row's come from an annotation the checker can reach with values
// the code does not spell.
function sIsAnonRow(si: i32) {
  if si < 0 || si >= sNames.length { return false }
  const nm = sNames[si]
  nm.length >= 5 && nm.slice(0, 5) == "#anon"
}

// PERF MEMO (the deep-composite compile wall, `resolveAnnot`-memo's emitter sibling):
// `structIndexOfObjCtx` re-enters per candidate row × per parent literal query
// (`anonFieldCode`'s nested-object arm recurses into child literals), so a deeply
// nested literal tree re-resolved the SAME ObjLit millions of times — probed at
// 1.67M calls / 74.8M row iterations / 5M `shapeFieldTypeCompat` name-parses over a
// 51-row table (the ~140s wall; fuzz sweep keep_167929495). A node's HIT is stable
// (rows only APPEND, so an existing first-match stays the first match); a MISS (-1)
// is stamped with the row count and recomputed only after the table GROWS. Keyed by
// node index + the querying `fnIx` (the f64 axis reads per-instance expression
// context); reset per program in `collectS` (`sioMemoReset` — node indices and the
// row table are both program-scoped).
let sioMemoIx: i32[] = []
let sioMemoFn: i32[] = []
let sioMemoVer: i32[] = []
export function sioMemoReset() {
  sioMemoIx = []
  sioMemoFn = []
  sioMemoVer = []
}

export function structIndexOfObjCtx(objIx: i32, fnIx: i32) {
  while sioMemoIx.length <= objIx {
    sioMemoIx.push(0 - 2)
    sioMemoFn.push(0 - 2)
    sioMemoVer.push(0 - 1)
  }
  if sioMemoIx[objIx] != 0 - 2 && sioMemoFn[objIx] == fnIx {
    // A hit requires the row count unchanged for EVERY cached result (not just
    // misses): appends can turn a single name-match into a 2+-match, routing the
    // AMBIGUITY arm to a typed-IR resolution the first computation never took.
    // The table only grows during collect; the emit-phase recursion (where the
    // exponential lived) queries a frozen table, so the memo still collapses it.
    if sioMemoVer[objIx] == sNames.length { return sioMemoIx[objIx] }
  }
  const r = structIndexOfObjCtxGo(objIx, fnIx)
  sioMemoIx[objIx] = r
  sioMemoFn[objIx] = fnIx
  sioMemoVer[objIx] = sNames.length
  r
}

// The context-aware variant: `fnIx` (when >= 0) classifies field VALUES through
// the expression family too, so a monomorphized instance's SHARED tail literal
// (`{ x: self.x + b.x }`) resolves per instance — f64 against the f64-param
// instance, i32 against the i32 one.
function structIndexOfObjCtxGo(objIx: i32, fnIx: i32) {
  const o = P.nodes[objIx]
  if o is ObjLit {
    const nf = o.objFields.length
    // AMBIGUITY resolution (see below): the name-only scan can match SEVERAL registered
    // structs (`{f: "dn"}` matches both a `{f: string}` and a `{f: K0}` — a string literal
    // legitimately initializes a litunion atom field, so no field-code axis can split
    // them). First match won historically; when 2+ match, the checker's recorded node
    // type picks the right one. `firstSi` keeps the unambiguous path byte-identical.
    let firstSi = -1
    let matches = 0
    // A STRICTER first-match under the nested-struct field-code rule (see below): the
    // first candidate that matches AND whose code-15 field VALUES align with code-15/16
    // fields. Tracked ALONGSIDE the lenient `matches` (never reducing it) — used only as
    // the AMBIGUITY tiebreak when the name/arena resolvers cannot decide, so the lenient
    // resolution (and the `#anon` interning it gates) stays byte-identical.
    let strictSi = -1
    let strictCount = 0
    let si = 0
    const sLimA = sScanLim()
    while si < sLimA {
      if sFieldCount[si] == nf {
        let ok = true
        let strict = true
        let k = 0
        while k < nf {
          const f = P.nodes[o.objFields[k]]
          if f is FieldInit {
            const mfi = sFieldIndex(si, f.fiName)
            if mfi < 0 {
              ok = false
              strict = false
            } else {
              // F64 DISCRIMINATION: an `{x}` literal matches the i32 `{x}` and
              // the f64 `{x}` shapes by NAME — split them on the value's float-
              // ness so `{x: 1.5}` builds the f64 shape and `{x: 1}` the i32
              // one (monomorphized `addx` instances each pin their own).
              const sc = sFieldTypeAt(si, mfi)
              const vc = anonFieldCode(f.fiValue)
              let isFloat = vc == 17
              if !isFloat && fnIx >= 0 {
                if exprIsF64(f.fiValue, fnIx) { isFloat = true }
              }
              if isFloat {
                if sc != 17 && sc != 24 && sc != 16 { ok = false }
              } else if vc == 23 {
                // I64 DISCRIMINATION (the i64 axis of the float rule above): an
                // i64-coded value (a magnitude literal, or a context-ADOPTED small
                // literal — `anonFieldCode` reads the recorded type) must not match
                // an i32-field shape; `{f: 5}` adopted to `{f: i64}` would else claim
                // a coexisting `{f: i32}` struct and store an i64 into its field.
                if sc != 23 && sc != 16 { ok = false }
              } else if vc == 19 {
                // MAP DISCRIMINATION (the map axis of the float / i64 rules above). An mv
                // slot's identity is the (KEY, VALUE) PAIR, so a `Map()` field value aligns
                // only with a map field whose row names that same pair — the two columns the
                // row records, compared as recorded. Two same-fieldset literals over
                // different map types otherwise collapse onto ONE interned shape and the
                // second builds against the first's rep: `{ m: Map() }` string-keyed beside
                // `{ m: Map() }` i32-keyed reported "map key is not a string", and the
                // value-differing pair emitted invalid wasm.
                if sc != 19 && sc != 16 { ok = false }
                if sc == 19 {
                  if (
                    sFieldElemKeyI32At(si, mfi) !=
                    anonFieldElemKeyI32(f.fiValue, vc)
                  ) {
                    ok = false
                  }
                  if (
                    sFieldElemNameAt(si, mfi) !=
                    anonFieldElemName(f.fiValue, vc)
                  ) {
                    ok = false
                  }
                }
              } else if sc == 17 {
                if fnIx >= 0 || vc >= 0 { ok = false }
              } else if !anonValueFitsField(vc, sc, f.fiValue, si, mfi) {
                // THE REMAINING VALUE AXES (the general scalar/ref rule the f64 and
                // i64 arms above are two special cases of).
                ok = false
              }
              // NESTED-STRUCT tiebreak axis: a nested object-LITERAL field value
              // (`f: {a: false}`, a struct ref) aligns only with a nested-struct field
              // (code 15) or a union BOX field (code 16), never a scalar/niche/string/
              // list code. This does NOT reduce the lenient `matches` (a same-fieldset
              // twin whose field is a scalar niche `{f: boolean | null}`, code 21, still
              // name-matches) — it only makes `strictSi` prefer the ref-field candidate,
              // so the ambiguity resolver picks `{f: {a: boolean}}` (code 15) over the
              // niche twin when the name/arena resolvers cannot (fuzz sweep 3aJP7v
              // multiobs, the nul-litunion-field + nested-`{f}`-twins closure result).
              if vc == 15 && sc != 15 && sc != 16 { strict = false }
            }
          } else {
            ok = false
            strict = false
          }
          k = k + 1
        }
        if ok {
          if firstSi < 0 { firstSi = si }
          matches = matches + 1
          if strict {
            if strictSi < 0 { strictSi = si }
            strictCount = strictCount + 1
          }
        }
      }
      si = si + 1
    }
    // NESTED-STRUCT UNIQUE-STRICT resolve: when 2+ candidates name-match but exactly ONE
    // aligns its code-15 field VALUES with code-15/16 fields, the others are field-code
    // INCOMPATIBLE (a nested-struct value into a scalar/niche field is invalid to build),
    // so the strict candidate is definitively correct — take it BEFORE the name/arena
    // resolvers (which can return the wrong same-fieldset niche twin for a lambda-body
    // literal with a mis-recorded / absent type). Only fires when a `vc == 15` field
    // actually split the candidates (a literal with no nested-struct field has every match
    // strict → `strictCount == matches`, never uniquely 1 at 2+ matches), so the lenient
    // resolution stays byte-identical elsewhere. Fuzz sweep 3aJP7v multiobs, the
    // nul-litunion-field + nested-`{f}`-twins closure result.
    if matches >= 2 && strictCount == 1 && strictSi >= 0 { return strictSi }
    if matches >= 2 {
      // 2+ structs match by name/scalar-code alone — a genuine shape COLLISION (a map's
      // `{f: K0}` value struct vs a closure's `{f: string}` result, seed 42931513 d5:
      // first-match built the literal with the WRONG layout — a silent MISMATCH, or
      // invalid wasm when the field valtypes differ). Consult the checker's recorded
      // type for this literal (rendered ONLY on this ambiguous path — off the hot
      // path, the #494 discipline) and resolve it through `structIndexOfTypeName`'s
      // field-TYPE-guarded match. Falls back to the historic first match when the
      // node carries no recorded type (an emit-time-cloned mono node).
      if nodeTyIsObj(objIx) {
        // NODE ROUTE (rep-slot-layer, AUTHORITATIVE): consult the checker's ADOPTED
        // arena type for this literal (`nodeRepTyIxOf` — #988's
        // `recordNullHoleObjAdopt` and #1024's union-softening `recordRepTyAdopt`
        // re-stamp the DESTINATION type here) through `repRowOfTyStruct` (the
        // `slotCanonKey == repCanonKey` pick under the `structFieldCodesEq` layout
        // gate) FIRST — ahead of EVERY render-derived consult below. This IS the row
        // the literal's proven type names; the SELF-classified render fed to
        // `structIndexOfTypeName` only reaches it by leaning on
        // `shapeFieldTypeCompat`'s whole-span refutation arms to DECLINE the wrong
        // twin (`{f: {f: i64|null}}` vs its inner `{f: i64|null}` row — the render
        // spells the nullable field `i64?` / softens a union leaf to `string`, so
        // the canon key matches NO row and the lenient fieldset scan merges onto the
        // inner twin). Consuming the adopted node directly is the #1015–#1019 "stop
        // re-deriving from a render" principle, and hoisting it AHEAD of the nominal
        // consult is what RETIRED arm 2 (#978): with the last render-fed callers
        // node-routed (`structIndexOfObjCtx` #1061, `structIdxOfElemName` #1062,
        // `shapeElemDeclaredStructIdx` + `structIndexOfExpr` #1063), no caller
        // reaches the lenient scan with a whole-span self-classified render, so the
        // refutation is unreachable. Trust the node when it covers this literal
        // (>= 0); fall to the name path only when the node is uncovered
        // (`repRowOfTyStruct` returns -1: no rep type, non-`TyObj`, empty key, or an
        // ambiguous atom-vs-plain collision it must NOT guess through — #974's
        // deliberate decline, which the name path keeps).
        const nsi = repRowOfTyStruct(nodeRepTyIxOf(objIx), sLimA)
        if nsi >= 0 { return nsi }
        const sn = nodeTyName(objIx)
        if sn != "" {
          const tsi = structIndexOfTypeName(sn)
          if tsi >= 0 { return tsi }
        }
        // The SPACED render can spell a nullable field `i64?` — a spelling the
        // canon-key resolver (`repNameCanonKey` → `resolveAnnot`) reads as a
        // proven mismatch against the `i64|null`-keyed row, rejecting EVERY
        // candidate. Retry with the CANONICAL render (`tyToEmitName` — the
        // spelling the intern keys use), the scoped consult #979 introduced for
        // `structIndexOfExpr`'s call fallback. GATED on the `?` spelling: an
        // unconditional canon consult on this arm recursed unboundedly through
        // the resolver cascade (the structural-twin-heap-dedup regression the
        // global canon fold hit before #979 scoped it).
        if strContains(sn, "?") {
          const cn = nodeTyCanonObjName(objIx)
          if cn != "" && cn != sn {
            const csi = structIndexOfTypeName(cn)
            if csi >= 0 { return csi }
          }
        }
      }
      // STRUCTURAL RESOLVE (rep-twin phase 2, AUTHORITATIVE): the name path did
      // not resolve, so the historic behavior falls to the first-match GUESS
      // (`firstSi`). Consult the checker's recorded arena type structurally
      // (`repRowOfTyStruct` — the `slotCanonKey == repCanonKey` pick under the
      // `structFieldCodesEq` layout gate) and TRUST it: it is the row the
      // checker's proven type names for this literal, where `firstSi` was only a
      // fieldset-count heuristic. The sig-canon slice (`repSigSlotTokOfKind`
      // rendering `repStructSlotRep`) removed the byte-safety block that held
      // this subordinate to `firstSi`: an `sTwin` spelling-twin the intern/dedup
      // layer did not merge now keys the SAME `$fnsig` digit as its
      // representative, so a twin re-selection is byte-safe (the #980 KEY-vs-ROW
      // family), and a NON-twin pick is a genuine mis-resolution the arena
      // corrects (the corpus run-diff + rep-fuzz are the gate now that byte
      // identity no longer is). `repRowOfTyStruct` still DECLINES an ambiguous
      // atom-vs-plain canon-key collision (returns -1), so the name path keeps
      // those.
      const xr = repRowOfTyStruct(nodeRepTyIxOf(objIx), sLimA)
      if xr >= 0 { return xr }
      // FIELD-CODE TIEBREAK: the name/arena resolvers could not decide (a lambda-body
      // literal with no recorded obj name / rep type). Prefer the candidate whose
      // code-15 field VALUES align with code-15/16 fields over the historic first
      // match — a `{f: {a: false}}` literal resolves to `{f: {a: boolean}}` (code 15)
      // instead of the same-fieldset `{f: boolean | null}` niche twin `firstSi` would
      // pick (fuzz sweep 3aJP7v multiobs; the nested-`{f}`-twins closure result).
      if strictSi >= 0 { return strictSi }
    }
    return firstSi
  }
  -1
}

// True if lifted function `fe` has any UN-ANNOTATED parameter — a generic (its un-annotated param
// is a per-call-site inference hole). Such a function monomorphizes per direct call but i32-defaults
// when taken as a VALUE, so the value site rejects it.
export function fnHasUnannotatedParam(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return false }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    const ps = fn.fnParams
    let i = 0
    while i < ps.length {
      const p = P.nodes[ps[i]]
      if p is Param {
        if p.parType < 0 { return true }
      }
      i = i + 1
    }
  }
  false
}

export function optChainStructIdxOf(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is OptMember {
    const psi = optChainStructIdxOf(e.omObj, fnIx)
    if psi < 0 { return -1 }
    const pfi = sFieldIndex(psi, e.omProp)
    if pfi < 0 { return -1 }
    if sFieldTypeAt(psi, pfi) != 15 { return -1 }
    return sFieldTgtStructIdx(psi, pfi)
  }
  structIndexOfExpr(exprIx, fnIx)
}

// The union ATOM the concrete (non-box) side of a union `==` compares under —
// the same rep ladder `emitUnionCoerce` classifies a coerced value with.
export function unionEqAtomOf(otherIx: i32, unionName: string, fnIx: i32) {
  let atom = "i32"
  // A literal-union ATOM compares under the box's STRING arm, because that is the rep the
  // arm rides the box as (`unionTakesAtomAsStr`) — the atom's i32 id is a slot encoding, not
  // a box payload. Ahead of `exprString` because the ladder is first-match and an atom is
  // not a string ref until it is widened (`emitUnionEqOther`'s kind-2 arm does the widening).
  // Without this arm the atom fell to the `"i32"` default and the compare read the box's
  // NUMERIC arm's payload against an interned id — a silent wrong answer, not invalid wasm.
  if exprIsLitAtom(otherIx, fnIx) {
    atom = "string"
  } else if exprString(otherIx, fnIx) {
    atom = "string"
  } else if exprIsF32(otherIx, fnIx) {
    atom = "f32"
  } else if exprIsF64(otherIx, fnIx) {
    atom = "f64"
  } else if exprIsI64(otherIx, fnIx) {
    atom = "i64"
  } else if exprIsBool(otherIx, fnIx) {
    atom = "boolean"
  } else {
    if (
      !unionHasAtomTy(unionName, "i32", false) &&
      unionHasAtomTy(unionName, "i64", false)
    ) {
      atom = "i64"
    }
    const bare = P.nodes[unwrapParen(otherIx)]
    if bare is NumLit {
      if !numLexFitsI32(bare.numText) { atom = "i64" }
    }
  }
  atom
}

// True if the member access at `memIx` reads a field of a CURRENTLY-narrowed union
// identifier (the receiver `Ident` has an active binding on the narrowing stack).
export function memIsNarrowed(memIx: i32) {
  if narrowTop == 0 { return false }
  const m = P.nodes[memIx]
  if m is Member {
    const recv = P.nodes[m.memObj]
    if recv is Ident {
      if narrowVariantFor(recv.identName) != "" { return true }
    }
    // A nested union-FIELD receiver (`t.v.a` where `t.v` is narrowed to a variant): the
    // receiver is itself a Member, narrowed by its path key (`t.v`).
    if recv is Member {
      const pk = memberPathKeyOf(m.memObj)
      if pk != "" {
        if narrowVariantFor(pk) != "" { return true }
      }
    }
  }
  false
}

// The variant table index the Member `memIx`'s receiver is currently narrowed to, or -1
// if its receiver is not a narrowed union identifier. Resolves each receiver's OWN active
// narrowing — so simultaneously-narrowed locals each map to their own variant.
export function memNarrowVariantIndex(memIx: i32) {
  const m = P.nodes[memIx]
  if m is Member {
    const recv = P.nodes[m.memObj]
    if recv is Ident { return variantIndexOf(narrowVariantFor(recv.identName)) }
    if recv is Member {
      const pk = memberPathKeyOf(m.memObj)
      if pk != "" { return variantIndexOf(narrowVariantFor(pk)) }
    }
  }
  -1
}

// The VALUE-union name of a union-typed struct FIELD read `o.y` (field code 16),
// or "" when the member is not a union-box field. Covers a NARROWED-variant receiver
// too (`v.f` where `v` is narrowed to a union arm carrying a value-union field `f`) —
// the field then rides the VARIANT tables, not the incrementally-built struct table.
export function memberUnionFieldName(memIx: i32, fnIx: i32) {
  const m = P.nodes[memIx]
  if m is Member {
    const si = structIndexOfExpr(m.memObj, fnIx)
    if si >= 0 {
      const fi = sFieldIndex(si, m.memProp)
      if fi >= 0 {
        if sFieldTypeAt(si, fi) == 16 { return sFieldElemNameAt(si, fi) }
      }
    }
    // The receiver is a narrowed union arm (`v.f`, `v` narrowed to a struct variant):
    // resolve `f` through the variant field tables.
    const nvi = memNarrowVariantIndex(memIx)
    if nvi >= 0 {
      const vfi = variantFieldIndex(nvi, m.memProp)
      if vfi >= 0 {
        if variantFieldTypeAt(nvi, vfi) == 16 {
          return variantFieldElemName(nvi, vfi)
        }
      }
    }
    // NARROWING-BLIND last resort (the frame pre-pass): the receiver is an IDENT
    // declared as a union whose STRUCT arm carries a code-16 field named `memProp` —
    // probe both field tables across the arms, the `unionStructArmMapFieldMember`
    // discipline. The pre-pass runs before any narrowing is active, so the probes
    // above miss and a `const t1 = t0.f` binding's field union resolved "" — its map
    // ops then indexed scratch locals past the frame (invalid wasm). At emit the
    // narrowed probes above answer first, so this is strictly additive. GATED on the
    // checker having typed the READ a union (a cheap arena test): an ordinary struct
    // member read misses both probes above on every classifier query, and the
    // ident-union resolution below (`parentLetOf` body walks) is too hot for that.
    if !nodeTyIsUnion(memIx) { return "" }
    const mObj = P.nodes[unwrapParen(m.memObj)]
    if mObj is Ident {
      const mun = unionNameOfIdent(mObj.identName, fnIx)
      if mun != "" {
        const mAtoms: string[] = []
        unionArmsOf(mun, mAtoms)
        let mi = 0
        while mi < mAtoms.length {
          const ma = mAtoms[mi]
          if ma != "null" {
            const msi = structIndexByName(ma)
            if msi >= 0 {
              const mfi = sFieldIndex(msi, m.memProp)
              if mfi >= 0 {
                if sFieldTypeAt(msi, mfi) == 16 {
                  return sFieldElemNameAt(msi, mfi)
                }
              }
            }
            const mvi = variantIndexOf(ma)
            if mvi >= 0 {
              const mvfi = variantFieldIndex(mvi, m.memProp)
              if mvfi >= 0 {
                if variantFieldTypeAt(mvi, mvfi) == 16 {
                  return variantFieldElemName(mvi, mvfi)
                }
              }
            }
          }
          mi = mi + 1
        }
      }
    }
  }
  ""
}

// Record a distinct (kind, ref-list slot) source frame requirement.
export function mfRecordSrc(kind: MfKind, slot: i32) {
  let i = 0
  while i < mfSrcKinds.length {
    if mfSrcKinds[i] == kind && mfSrcSlots[i] == slot { return 0 }
    i = i + 1
  }
  mfSrcKinds.push(kind)
  mfSrcSlots.push(slot)
  0
}

// Record a distinct (result-element-kind, ref-list slot) dest frame requirement. `slot` is the
// ref-list table slot for a kind-2 (ref-list) dest (so two struct-array filters of DIFFERENT
// element types get distinct backing locals), -1 for a non-ref dest.
export function mfRecordDst(kind: MfKind, slot: i32) {
  let i = 0
  while i < mfDstKinds.length {
    if mfDstKinds[i] == kind && mfDstSlots[i] == slot { return 0 }
    i = i + 1
  }
  mfDstKinds.push(kind)
  mfDstSlots.push(slot)
  0
}

// The wasm local holding the SOURCE wrapper ref for (kind, slot), or -1.
export function mfSrcLocalFor(kind: MfKind, slot: i32) {
  let i = 0
  while i < mfSrcKinds.length {
    if mfSrcKinds[i] == kind && mfSrcSlots[i] == slot {
      if i < mfSrcBases.length { return mfSrcBases[i] }
    }
    i = i + 1
  }
  -1
}

// The wasm local holding the DEST backing ref for result (kind, slot), or -1.
export function mfDstLocalFor(kind: MfKind, slot: i32) {
  let i = 0
  while i < mfDstKinds.length {
    if mfDstKinds[i] == kind && mfDstSlots[i] == slot {
      if i < mfDstBases.length { return mfDstBases[i] }
    }
    i = i + 1
  }
  -1
}

// True if function `fnIx` operates on a map — it has a map PARAM, or `buildLocals`
// flagged a map LOCAL (code `6`). Drives the map scratch-frame reservation. (Run
// AFTER `buildLocals`, so `localIsRef` is populated.)
export function fnHasMap(fnIx: i32) {
  let i = 0
  while i < localNames.length {
    if localIsRef[i] == "map" { return true }
    // A map-ARRAY local (`{[string]:i32}[]`, code 5 with element kind 3) lets map ops
    // run on an indexed element (`scopes[i][k]`) — so the function needs the map scratch
    // frame even though no bare map local is declared.
    if localIsRef[i] == "reflist" {
      const s = localStructIdx[i]
      if s >= 0 {
        if s < rlElemKindTbl.length {
          if rlElemKindTbl[s] == 3 { return true }
        }
      }
    }
    i = i + 1
  }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const params = fn.fnParams
    let pj = 0
    while pj < params.length {
      const p = P.nodes[params[pj]]
      if p is Param {
        if p.parType >= 0 {
          const ty = P.nodes[p.parType]
          if ty is TypeRef {
            if nameIsMap(ty.tyName) { return true }
          }
        }
      }
      pj = pj + 1
    }
  }
  false
}

// True if the statement/expression tree at `ix` contains a function-VALUE call (a
// `Call` whose callee is a closure value rather than a known function name) — so the
// function needs the closure scratch slot for `call_ref`. (Lambdas.)
export function blockHasCallRef(ix: i32, fnIx: i32) {
  if ix < 0 { return false }
  const n = P.nodes[ix]
  if n is Call {
    const callee = P.nodes[n.callFn]
    let isVal = false
    if callee is Ident {
      const t = fnIndexOfSid(sidOfNode(n.callFn))
      if t < 0 {
        if exprIsClosure(n.callFn, fnIx) { isVal = true }
        // `t()` where `t` is a union binding with a bare-closure arm (`const t = p.f; t()`,
        // `const e = arr[0]; e()`): the `is`-narrowing that makes `t` a closure is NOT active
        // during this pre-pass, so `exprIsClosure(t)` is false — reserve `callRefSlot`
        // conservatively so the narrowed emit's `call_ref` has its scratch local (an unused
        // reservation is a harmless spare local, never invalid wasm). The bare-binding twin of
        // the `calleeIsUnionClosureArrayIndex` reservation below.
        if !isVal && calleeIsUnionClosureIdent(n.callFn, fnIx) { isVal = true }
      } else {
        // A direct call to a CAPTURING function is lowered via call_ref too.
        if captureCountOf(t) > 0 { isVal = true }
      }
    } else {
      if exprIsClosure(n.callFn, fnIx) { isVal = true }
      // `p[0]()` where `p` is a union with a CLOSURE-ARRAY arm (`(() => f64)[] | i64`): the
      // `is`-narrowing that makes `p` a closure array is NOT active during this frame pre-pass,
      // so `exprIsClosure(p[0])` (which needs the narrowing to see `p` as a ref array) is false —
      // reserve `callRefSlot` conservatively so the narrowed emit's `call_ref` has its scratch
      // local (an unused reservation is a harmless spare local, never invalid wasm).
      if !isVal && calleeIsUnionClosureArrayIndex(n.callFn, fnIx) {
        isVal = true
      }
      // `t0.f[0]()` where `t0`'s union has a struct arm carrying a CLOSURE-ARRAY field
      // (`{a: i32, f: ((i32) => K0)[], z: f64} | i32`): the `is`-narrowing that resolves
      // the member chain is not active in this pre-pass — reserve conservatively (the
      // indexed-member twin of the two reservations around it).
      if !isVal && calleeIsUnionArmCloArrayIndex(n.callFn, fnIx) {
        isVal = true
      }
      // `t0.f.f()` where `t0`'s union has a struct arm whose (possibly nested) field
      // chain ends in a CLOSURE field: the `is`-narrowing that resolves the chain is
      // not active in this pre-pass — reserve conservatively (a spare local is
      // harmless; an unreserved `call_ref` spill shares the next frame's local —
      // invalid wasm).
      if !isVal && calleeIsUnionArmClosureMember(n.callFn, fnIx) {
        isVal = true
      }
      // `t0[0].f()` where `t0`'s union has a ref-array arm whose ELEMENT struct
      // carries a closure field — the indexed-element-field twin of the arms above.
      if !isVal && calleeIsUnionElemFieldClosure(n.callFn, fnIx) {
        isVal = true
      }
    }
    // The typed-IR net for ANY callee spelling the syntactic classifiers above
    // miss — Ident or composite: the checker records every callee's own checked
    // type, so one that types as a closure reserves the scratch regardless of the
    // callee's shape or depth. Covers `t1[0][0]()` through a narrowed 2-D
    // closure-array arm (INVALID-WASM, fuzz sweep2 multiobs seed 655720167
    // case_00179) AND a narrowed union-box-ELEMENT rebind callee (`const t1 =
    // t0[0]; if t1 is () => f64 { t1() }` — an IDENT the syntactic union-closure
    // chain misses; INVALID-WASM, fuzz sweep4 plain seed 6331245 case_00375).
    // (An over-reservation is a harmless spare local.)
    if !isVal {
      const cty = nodeTyIxOf(n.callFn)
      if cty >= 0 {
        if T.tys[cty] is TyFunc { isVal = true }
      }
    }
    if isVal { return true }
    if blockHasCallRef(n.callFn, fnIx) { return true }
    const args = n.callArgs
    let i = 0
    while i < args.length {
      if blockHasCallRef(args[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  if n is Block {
    const stmts = n.blkStmts
    let i = 0
    while i < stmts.length {
      if blockHasCallRef(stmts[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  if n is LetDecl {
    if n.letInit >= 0 { return blockHasCallRef(n.letInit, fnIx) }
    return false
  }
  if n is RetStmt {
    if n.retArg >= 0 { return blockHasCallRef(n.retArg, fnIx) }
    return false
  }
  if n is IfStmt {
    if blockHasCallRef(n.ifCond, fnIx) { return true }
    if blockHasCallRef(n.ifThen, fnIx) { return true }
    if n.ifElse >= 0 { return blockHasCallRef(n.ifElse, fnIx) }
    return false
  }
  if n is WhileStmt {
    if blockHasCallRef(n.whileCond, fnIx) { return true }
    return blockHasCallRef(n.whileBody, fnIx)
  }
  if n is ForRange {
    if blockHasCallRef(n.frFrom, fnIx) { return true }
    if blockHasCallRef(n.frTo, fnIx) { return true }
    if n.frStep >= 0 {
      if blockHasCallRef(n.frStep, fnIx) { return true }
    }
    return blockHasCallRef(n.frBody, fnIx)
  }
  if n is ForIn {
    if blockHasCallRef(n.fiIter, fnIx) { return true }
    return blockHasCallRef(n.fiBody, fnIx)
  }
  if n is BinExpr {
    if blockHasCallRef(n.binLeft, fnIx) { return true }
    return blockHasCallRef(n.binRight, fnIx)
  }
  if n is Unary { return blockHasCallRef(n.unArg, fnIx) }
  if n is Paren { return blockHasCallRef(n.parInner, fnIx) }
  // An `is` operand (`f(x) is i32`) may itself be a function-value call — without this the
  // closure scratch slot (`callRefSlot`) goes unreserved and the inline `call_ref` reads a
  // non-existent local 0.
  if n is IsExpr { return blockHasCallRef(n.isObj, fnIx) }
  if n is AsExpr { return blockHasCallRef(n.asObj, fnIx) }
  if n is Member { return blockHasCallRef(n.memObj, fnIx) }
  if n is Index {
    if blockHasCallRef(n.idxArr, fnIx) { return true }
    return blockHasCallRef(n.idxIndex, fnIx)
  }
  if n is ObjLit {
    const fields = n.objFields
    let i = 0
    while i < fields.length {
      const f = P.nodes[fields[i]]
      if f is FieldInit {
        if blockHasCallRef(f.fiValue, fnIx) { return true }
      }
      i = i + 1
    }
    return false
  }
  if n is ArrayLit {
    const elems = n.arrElems
    let i = 0
    while i < elems.length {
      if blockHasCallRef(elems[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// True if the STRUCT-table entry `ssi` layout-matches a variant arm of SOME registered
// variant-box union whose arm-variant heap type DIFFERS from `sHeapIdx[ssi]` — a struct of
// this shape flowing into that union must be RE-BOXED (`emitStructExprAsVariantBox`), never
// passed raw (the plain twin is a distinct heap type). The reservation pre-pass has no flow
// context, so this over-approximates (a plain struct merely sharing a fieldset with some
// arm reserves the stash even if it never flows there — a harmless spare local).
function structIdxHasReboxVariant(ssi: i32): boolean {
  if ssi < 0 || ssi >= sHeapIdx.length { return false }
  let u = 0
  while u < unNames.length {
    let vi = unVarStart[u]
    while vi < unVarStart[u] + unVarCount[u] {
      if vi >= 0 && vi < uVarHeap.length {
        if structIdxMatchesVariantIdx(ssi, vi) {
          if sHeapIdx[ssi] != uVarHeap[vi] { return true }
        }
      }
      vi = vi + 1
    }
    u = u + 1
  }
  false
}

// True if the expression at `exprIx` is a MULTI-FIELD struct-returning CALL (a non-re-
// readable source — a call cannot be re-evaluated per field) whose result shape must be
// RE-BOXED into a variant-box union arm. This is the one rebox case `emitStructExprAsVariant
// Box` handles by STASHING the call result in `variantReboxSlot` (single-field / re-readable
// sources re-emit in place and need no stash). Drives that slot's reservation.
export function exprIsMultiFieldReboxCall(exprIx: i32, fnIx: i32): boolean {
  const inner = unwrapParen(exprIx)
  if inner < 0 { return false }
  const n = P.nodes[inner]
  if !(n is Call) { return false }
  if !exprStruct(inner, fnIx) { return false }
  const ssi = structIndexOfExpr(inner, fnIx)
  // `structIndexOfExpr` can return a VARIANT index (its own heap table) for a variant-
  // returning call — not a struct-table index. Bound to the struct table so it is never
  // misused as one (a variant-returning call never reboxes; it builds the variant directly).
  if ssi < 0 || ssi >= sFieldCount.length { return false }
  if sFieldCount[ssi] <= 1 { return false }
  structIdxHasReboxVariant(ssi)
}

// Whether the statement/expression tree at `ix` contains a multi-field struct-returning
// call that must be re-boxed into a variant-box union arm (`exprIsMultiFieldReboxCall`) —
// so the function reserves the `variantReboxSlot`. Mirrors `blockHasCallRef`'s traversal.
// Under-reservation is SAFE (the emit floors loudly, never invalid wasm); over-reservation
// is a harmless spare local — so exact flow-position matching is unnecessary here.
export function blockHasVariantRebox(ix: i32, fnIx: i32): boolean {
  if ix < 0 { return false }
  if exprIsMultiFieldReboxCall(ix, fnIx) { return true }
  const n = P.nodes[ix]
  if n is Call {
    if blockHasVariantRebox(n.callFn, fnIx) { return true }
    const args = n.callArgs
    let i = 0
    while i < args.length {
      if blockHasVariantRebox(args[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  if n is Block {
    const stmts = n.blkStmts
    let i = 0
    while i < stmts.length {
      if blockHasVariantRebox(stmts[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  if n is LetDecl {
    if n.letInit >= 0 { return blockHasVariantRebox(n.letInit, fnIx) }
    return false
  }
  if n is RetStmt {
    if n.retArg >= 0 { return blockHasVariantRebox(n.retArg, fnIx) }
    return false
  }
  if n is IfStmt {
    if blockHasVariantRebox(n.ifCond, fnIx) { return true }
    if blockHasVariantRebox(n.ifThen, fnIx) { return true }
    if n.ifElse >= 0 { return blockHasVariantRebox(n.ifElse, fnIx) }
    return false
  }
  if n is WhileStmt {
    if blockHasVariantRebox(n.whileCond, fnIx) { return true }
    return blockHasVariantRebox(n.whileBody, fnIx)
  }
  if n is ForRange {
    if blockHasVariantRebox(n.frFrom, fnIx) { return true }
    if blockHasVariantRebox(n.frTo, fnIx) { return true }
    if n.frStep >= 0 {
      if blockHasVariantRebox(n.frStep, fnIx) { return true }
    }
    return blockHasVariantRebox(n.frBody, fnIx)
  }
  if n is ForIn {
    if blockHasVariantRebox(n.fiIter, fnIx) { return true }
    return blockHasVariantRebox(n.fiBody, fnIx)
  }
  if n is BinExpr {
    if blockHasVariantRebox(n.binLeft, fnIx) { return true }
    return blockHasVariantRebox(n.binRight, fnIx)
  }
  if n is Unary { return blockHasVariantRebox(n.unArg, fnIx) }
  if n is Paren { return blockHasVariantRebox(n.parInner, fnIx) }
  if n is IsExpr { return blockHasVariantRebox(n.isObj, fnIx) }
  if n is AsExpr { return blockHasVariantRebox(n.asObj, fnIx) }
  if n is Member { return blockHasVariantRebox(n.memObj, fnIx) }
  if n is Index {
    if blockHasVariantRebox(n.idxArr, fnIx) { return true }
    return blockHasVariantRebox(n.idxIndex, fnIx)
  }
  if n is ObjLit {
    const fields = n.objFields
    let i = 0
    while i < fields.length {
      const f = P.nodes[fields[i]]
      if f is FieldInit {
        if blockHasVariantRebox(f.fiValue, fnIx) { return true }
      }
      i = i + 1
    }
    return false
  }
  if n is ArrayLit {
    const elems = n.arrElems
    let i = 0
    while i < elems.length {
      if blockHasVariantRebox(elems[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// Lower an index READ `a[i]` onto `body`. The element store is the raw `(array (mut
// i32))` in BOTH cases, but a list receiver carries it inside the wrapper struct:
//   list `a[i]`   → eval `a` (a wrapper ref), `struct.get $lTypeIdx 0` (backing), eval
//                   `i`, then `array.get $aTypeIdx` — the element i32.
//   string `s[i]` → eval `s` (a raw array ref), eval `i`, `array.get $aTypeIdx` — the
//                   i32 CODE POINT (unchanged from the fixed-array string rep).
// `array.get` is `0xfb 0x0b <typeidx>` (the `_s/_u` forms `0x0c/0x0d` are only for
// PACKED arrays; an unpacked i32 array uses `0x0b`).
// The bounds-check wrapper-ref slot for list kind `kind` (`slot` = the ref-list
// table slot for kind "ref", else 0) — found in this function's lazily grown
// `liKinds` table, or reserved now. Slot 0 of the frame (`listIdxScratchBase`)
// is the shared i32 index stash; wrapper slot k lives at `base + 1 + k`. The
// frame's base is fixed by `fbBeginFunc` (it lays out after every eager frame),
// so handing slots out mid-lowering is safe, and first-use order keeps the
// layout deterministic (the locals vector is derived from the same table).
// The bounds-check frame kind for a SCALAR list element kind (`scalarListElemKind`
// only ever yields the four scalar members of `VKind`).
export function listIdxKindOf(ek: VKind): MfKind {
  if ek == "f64" { return "f64" }
  if ek == "i64" { return "i64" }
  if ek == "f32" { return "f32" }
  "i32"
}

export function listIdxWrapSlot(kind: MfKind, slot: i32) {
  let k = 0
  while k < liKinds.length {
    if liKinds[k] == kind && liSlots[k] == slot && liBack[k] == 0 {
      return listIdxScratchBase + 1 + k
    }
    k = k + 1
  }
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(0)
  listIdxScratchBase + liKinds.length
}

// The tail-value expression of an if-expression's THEN arm (`ifArmValueExpr`: the arm
// Block's LAST statement), or -1. The arms share the checker's join type, so the then
// arm's rep classifies the whole if-expression.
function ifThenValueIx(ifIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt { return ifArmValueExpr(s.ifThen) }
  -1
}

// The `fbValtype` KIND of a REF-typed if-expression join — string (3), string-list (7),
// f64-list (12), ref-list (5), i32-list (2), or struct (1) — classified from the THEN
// arm's tail value. -1 for a numeric join (the single-byte path) and for a value-union /
// concrete-variant join (handled by `emitUnionIfValue` / `emitVariantIfValue` upstream).
// The array predicates run BEFORE the i32-list `exprArray` (which would also claim a
// string/ref/f64 list via its typed-IR fast path).
export function ifExprRefKind(ifIx: i32, fnIx: i32): VKind | null {
  const tv = ifThenValueIx(ifIx)
  if tv < 0 { return null }
  // A CLOSURE join (`if c then (x) => x + 1 else (x) => x - 1`) — kind 14, `(ref $cloStruct)`.
  // Checked FIRST: a bare lambda arm is a function value, not a string/array/struct. Each arm
  // emits via `emitClosureValue` (the default `emitRefIfArm` path), and the binding/return
  // classifies as a closure (`exprIsClosure` / `fnReturnsClosure`).
  if exprIsClosure(tv, fnIx) { return "closure" }
  // The JOIN's checked type is the arm-order-independent string signal: a `string`-typed
  // join (an ATOM arm + a string/member-literal arm — `if c then k else "cc"`, either
  // order) is the string ref kind even when the THEN arm alone doesn't classify stringy
  // (an atom ident reads as its litunion, not `string`); the atom arm then widens at
  // `emitRefIfArm`. A pure-atom join types the LITUNION (not `string`), so it stays the
  // bare i32 path.
  if tyKindOf(nodeTyIxOf(ifIx)) == 3 { return "str" }
  if exprString(tv, fnIx) { return "str" }
  if exprStringArray(tv, fnIx) { return "strlist" }
  // The scalar lists in `scalarListElemKind`'s own order — f32 BEFORE f64, because
  // `exprF64Array`'s typed-IR fast path would claim an `f32[]` join otherwise. Each is a
  // distinct wrapper heap type, so a missing arm is not "the f64 list": it is the numeric
  // fallthrough below, an `if (result i32)` over two arms pushing `(ref $wrapper)`.
  if exprF32Array(tv, fnIx) { return "f32list" }
  if exprF64Array(tv, fnIx) { return "f64list" }
  if exprI64Array(tv, fnIx) { return "i64list" }
  if exprRefArray(tv, fnIx) { return "reflist" }
  if exprArray(tv, fnIx) { return "list" }
  // A MAP join (`if c { a } else { b }` over two `{[K]: V}` values) is the map struct ref;
  // its blocktype selects THIS value-shape's `$mapStruct`, so the slot is the map SHAPE
  // (`ifExprRefSlot`'s map arm), not a struct-table index.
  if exprMap(tv, fnIx) { return "map" }
  if structIndexOfExpr(tv, fnIx) >= 0 { return "struct" }
  // An object LITERAL arm in a struct-typed CONTEXT (return / binding seeds
  // `pendingStructIdx`) — it has no self-derivable struct index.
  const tn = P.nodes[tv]
  if tn is ObjLit {
    if pendingStructIdx >= 0 { return "struct" }
  }
  // A NULLABLE-struct join whose THEN arm is `null` (its rep doesn't classify) — the checker typed the
  // whole if `S | null`. Return the struct kind so the nullable blocktype + struct/null arms lower; the
  // struct index resolves from the checker's inner struct in `ifExprRefSlot`. (The null-in-ELSE case is
  // already caught above via the THEN arm's struct rep.)
  if nodeTyIsNullableStruct(ifIx) { return "struct" }
  null
}

// The `fbValtype` SLOT (second arg) for a REF-typed if-expression join of `kind`: the
// struct table index (kind 1) or the ref-list wrapper slot (kind 5); the other ref kinds
// (string/string-list/f64-list/i32-list) ignore the slot. Prefers the pending context
// seed (a struct/list RETURN or binding) over the then-arm's own derivation.
export function ifExprRefSlot(ifIx: i32, fnIx: i32, kind: VKind) {
  const tv = ifThenValueIx(ifIx)
  if kind == "struct" {
    const si = structIndexOfExpr(tv, fnIx)
    if si >= 0 { return si }
    if pendingStructIdx >= 0 { return pendingStructIdx }
    // THEN arm is `null` with no binding seed — resolve the struct from the checker's nullable join
    // type (`P | null` → its inner `P`), so the arm rep + nullable blocktype find the layout.
    const inn = nodeNulStructInnerName(ifIx)
    if inn != "" { return structIndexOfTypeName(inn) }
    return pendingStructIdx
  }
  if kind == "reflist" {
    if pendingListKind == 5 { return pendingListSlot }
    return refListSlotOfExpr(tv, fnIx)
  }
  // A MAP join's slot is the map SHAPE (mv slot / -1 mono / -2 set), which is what
  // `mapTypeIdxOf` resolves to the struct heap type — the same value every other map
  // valtype site passes.
  if kind == "map" { return mapShapeFoldSet(mapShapeOfExpr(tv, fnIx)) }
  -1
}

// True if the single statement `stmtIx` is usable as an if-expression ARM value: a plain tail value
// (`stmtIsTailValue`), OR a NESTED if-EXPRESSION (an `IfStmt` with an else + value arms, emitted via
// `emitExpr` → `emitIfExpr`). Kept SEPARATE from `stmtIsTailValue` so the function-tail nullable path —
// which gates on `stmtIsTailValue` and routes an else-ful nullable tail through `emitIfTail` — is
// untouched; only the if-expression arm emitters opt into nesting.
export function ifArmIsValue(stmtIx: i32, fnIx: i32) {
  if stmtIsTailValue(stmtIx, fnIx) { return true }
  const s = P.nodes[stmtIx]
  if s is IfStmt { return ifTailIsValue(stmtIx, fnIx) }
  false
}

// The single-byte blocktype valtype for a value-position if-expression: the widest
// numeric rep across its arms (checked f64 → f32 → i64, else the i32 default).
export function ifExprValtype(ifIx: i32, fnIx: i32) {
  if exprIsF64(ifIx, fnIx) {
    return 124 // 0x7c f64
  }
  if exprIsF32(ifIx, fnIx) {
    return 125 // 0x7d f32
  }
  if exprIsI64(ifIx, fnIx) {
    return 126 // 0x7e i64
  }
  127 // 0x7f i32
}

// True if the DECLARED LOCAL `name` is an i64 slot (kind 10 in the local registry).
function declaredI64(name: string) { declaredKind(name) == "i64" }

// True if the module GLOBAL `name` is an i64 cell.
function globalIsI64Sid(sid: i32) {
  const li = globalLetOfSid(sid)
  if li < 0 { return false }
  letIsI64(li, -1)
}

// The unboxed scalar atom KIND of a value-union null-coalesce `lhs ?? d` (where `lhs`
// is an ident or call yielding `T | null` with ONE non-null scalar atom): the result
// of `??` is that atom, so `print`-routing + numeric context coercion classify it by
// the atom (`i64`/`f64`/`f32` need their own import / convert). -1 when the expression
// is not such a `??`, or the union keeps ≥2 non-null atoms (still a box, not a scalar).
function coalesceAtomKind(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is BinExpr {
    if e.binOp == "??" {
      const nm = unionNameOfExpr(e.binLeft, fnIx)
      if nm != "" {
        if isValueUnionName(nm) && unionSetHasNull(nm) {
          const k = valueAtomKind(removeAtomFromSet(nm, "null"))
          if k >= 0 && k != 6 { return k }
        }
      }
    }
  }
  -1
}

// True if evaluating the expression at `exprIx` yields an i64 — a reference to an
// i64 param/local/global, or a parenthesized such. Drives the `print` import choice
// (`__print_i64__`, import 4). Arithmetic/calls returning i64 are Slice 2; here only
// the direct-reference forms (the Slice-1 `print(x)` shape) classify as i64.
export function exprIsI64(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  if tyKindOf(nodeTyIxOf(exprIx)) == 10 {
    return true // typed-IR fast path (see exprIsF64)
  }
  if coalesceAtomKind(exprIx, fnIx) == 3 { return true }
  // `m[k] ?? d` over an i64-VALUED map yields an i64 (the value type).
  const cmi = coalesceMvSlot(exprIx, fnIx)
  if cmi >= 0 {
    if mvValKind[cmi] == 10 { return true }
  }
  const e = P.nodes[exprIx]
  // An explicit `x as T` cast has exactly its target rep (see exprIsF64).
  if e is AsExpr { return e.asTy == "i64" }
  if e is Paren { return exprIsI64(e.parInner, fnIx) }
  // A field read `s.x` whose struct field is an i64 slot (code 23) yields an i64.
  if e is Member { return memFieldTypeCode(exprIx, fnIx) == 23 }
  // A bare `m[k]` read over an i64-valued map yields an i64.
  if e is Index {
    // An indexed read of an i64 list (`xs[i]` over `i64[]`) is an i64 — the syntactic dual of
    // `exprIsF64`'s Index case. Needed for a SYNTHETIC `c[0]` (e.g. a captured-mutation box) that
    // carries no checker-recorded type for the typed-IR fast path above.
    if exprI64Array(e.idxArr, fnIx) { return true }
    const mri = mapReadMvSlot(exprIx, fnIx)
    if mri >= 0 {
      if mvValKind[mri] == 10 { return true }
    }
  }
  // A bare INTEGER literal past the i32 range is typed i64 by the checker (the
  // host's `defaultIntegerType` magnitude rule) and lowers as `i64.const`, so it
  // classifies as i64 here too (a float `.` literal is f64, never i64).
  if e is NumLit {
    if numTextIsFloat(e.numText) { return false }
    return !numLexFitsI32(e.numText)
  }
  if e is Ident {
    // A VALUE-union ident classifies by its narrowed atom (the read unboxes to
    // that rep); an un-narrowed union ident is the box, never a scalar.
    const uk = unionIdentReadKind(exprIx, fnIx)
    if uk != -3 { return uk == 3 }
    if paramIsI64(fnIx, e.identName) { return true }
    if declaredI64(e.identName) { return true }
    // A CAPTURED i64 — same field/read agreement `exprIsF64`'s arm carries: without it
    // the read widens through `i64.extend_i32_s` over a slot the env already types i64.
    if capturedKindOf(fnIx, e.identName) == "i64" { return true }
    return globalIsI64Sid(sidOfNode(exprIx))
  }
  // Slice 2: an ARITHMETIC / BITWISE / SHIFT op yields i64 when EITHER operand is i64
  // (the i32 side widens). COMPARISONS (`==` `!=` `<` `>` `<=` `>=`) and logical
  // connectives produce an i32 BOOL even over i64 operands, so they are NOT i64.
  if e is BinExpr {
    const op = e.binOp
    if (
      op == "+" ||
      op == "-" ||
      op == "*" ||
      op == "/" ||
      op == "%" ||
      op == "&" ||
      op == "|" ||
      op == "^" ||
      op == "<<" ||
      op == ">>" ||
      op == ">>>"
    ) {
      if exprIsI64(e.binLeft, fnIx) { return true }
      return exprIsI64(e.binRight, fnIx)
    }
    return false
  }
  // Unary negation `-x` / bitwise NOT `~x` preserve the operand's i64-ness. (`!`
  // is a bool, never i64; `p+`/`p-` ride their operand but are statement-level.)
  if e is Unary {
    if e.unOp == "-" || e.unOp == "~" {
      // EXCEPT `-2147483648`: the host folds the sign into the literal before
      // defaulting, so a NEGATED magnitude-2^31 literal is i32 (it sits at
      // I32_MIN) even though the bare operand literal classifies i64 above.
      if e.unOp == "-" {
        const negInner = P.nodes[unwrapParen(e.unArg)]
        if negInner is NumLit {
          if !numTextIsFloat(negInner.numText) {
            if numLexIs2Pow31(negInner.numText) { return false }
          }
        }
      }
      return exprIsI64(e.unArg, fnIx)
    }
    return false
  }
  // A call to an i64-returning function yields i64.
  if e is Call {
    // An INDEXED closure call `fs[i](x)` whose element signature returns i64.
    if cloArrCallRetKind(exprIx, fnIx) == "i64" { return true }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const target = fnIndexOfSid(sidOfNode(e.callFn))
      if target >= 0 { return fRetKind[target] == "i64" }
      // An i64-returning function VALUE (a binding / `(…) => i64` param callee).
      return calleeReturnsI64Sid(sidOfNode(e.callFn), fnIx)
    }
    // An i64-returning FIELD-closure call (`o.f(x)` over an `(…) => i64` field).
    if callee is Member {
      const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if ffe >= 0 { return fRetKind[ffe] == "i64" }
    }
    return false
  }
  // A value-position if-EXPRESSION is i64 when either arm's value is i64.
  if e is IfStmt { return ifExprArmIsKind(exprIx, fnIx, "i64") }
  false
}

// True if the DECLARED LOCAL `name` is an f32 slot (kind 13 in the local registry).
function declaredF32(name: string) { declaredKind(name) == "f32" }

// True if the UN-annotated `LetDecl` at `letIx` should INFER an f32 slot — its initializer
// already yields an f32 (`exprIsF32`: an f32 field/index/param/local read, an f32-returning
// call, or f32 arithmetic). f32 is the checker's weak spot (no f32 typed-IR), so `letIsF32`
// is annotation-only; without this an un-annotated `let y = s.x` over an f32 source would
// default to an i32 slot and store an f32 into it (invalid wasm). This is the f32 analogue of
// the init fallback `letIsF64`/`letIsI64` already carry. A BARE float literal init stays f64
// (it is not `exprIsF32`), so `let y = 1.5` is unaffected.
export function letInfersF32(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return false }
    if d.letInit < 0 { return false }
    return exprIsF32(d.letInit, fnIx)
  }
  false
}

// True if the module GLOBAL `name` is an f32 cell. (Slice 5.)
function globalIsF32Sid(sid: i32) {
  const li = globalLetOfSid(sid)
  if li < 0 { return false }
  letIsF32(li)
}

// True if evaluating the expression at `exprIx` yields an f32: a reference to an f32
// param/local/global, f32 arithmetic (either operand f32 — the other side, an i32 or a
// float LITERAL, coerces to f32), or unary `-`/parens over such. A BARE float literal is
// NOT f32 (it defaults f64 — `exprIsF64`); it becomes f32 only as the operand of an f32
// op or the init of an `: f32` binding. Checked BEFORE `exprIsF64` at every dispatch so
// a mixed f32/float-literal expression routes to the f32 instructions. (Slice 5.)
// Is the expression at `exprIx` a FLOAT number literal, peeling grouping parens AND a leading
// unary `-`? A float literal is polymorphic across the float types — it adapts DOWN to an f32
// operand — so it does NOT force f64 the way a genuine f64 reference/result/variable does.
//
// The unary peel is not cosmetic: `-1.0` parses as a `Unary` OVER the literal, so the
// paren-only spelling answered "not a literal" for it and `copysign(fv, -1.0)` / `min(fv, -2.5)`
// resolved at f64 in an f32 slot. `emitExprAsF32` has the matching lowering (it re-encodes a
// negated float literal directly as `f32.const -1.5`), which is what makes the negated form
// genuinely adaptable and not just classified so.
function exprIsFloatLit(exprIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is NumLit { return numTextIsFloat(e.numText) }
  if e is Unary {
    if e.unOp == "-" {
      const neg = P.nodes[unwrapParen(e.unArg)]
      if neg is NumLit { return numTextIsFloat(neg.numText) }
    }
  }
  false
}

// What kinds of LEAF does the arithmetic spine at `exprIx` (parens, unary `-`, `+ - * /`) carry?
// Bit 1 = a leaf the f32 classifier claims; bit 2 = a leaf `exprIsF64` claims that is not a bare
// number literal (a GENUINE f64). Number literals contribute NEITHER — a float literal re-encodes
// at whichever width the operation resolves to.
//
// One `exprIsF32` / `exprIsF64` per spine leaf, so this is LINEAR in the subtree. A leaf is never
// an arithmetic node, so it cannot re-enter `binMixHardF64` on its own spine.
function spineFloatLeafBits(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  const e = P.nodes[exprIx]
  if e is Paren { return spineFloatLeafBits(e.parInner, fnIx) }
  if e is Unary {
    if e.unOp == "-" { return spineFloatLeafBits(e.unArg, fnIx) }
  }
  if e is BinExpr {
    const op = e.binOp
    if op == "+" || op == "-" || op == "*" || op == "/" {
      const lb = spineFloatLeafBits(e.binLeft, fnIx)
      const rb = spineFloatLeafBits(e.binRight, fnIx)
      return lb | rb
    }
  }
  if e is NumLit { return 0 }
  let bits = 0
  if exprIsF32(exprIx, fnIx) { bits = 1 }
  if exprIsF64(exprIx, fnIx) { bits = bits | 2 }
  bits
}

// Is the OPERAND at `exprIx` a GENUINE f64 — an f64 that does NOT adapt down to an f32 operand?
//
// `exprIsF64` alone over-claims, because it is TRUE for any arithmetic node with a float LITERAL
// anywhere inside it: `fv + 0.5` and `-1.0` are both `exprIsF64` while both lower perfectly well
// at f32. Asking it of a COMPOUND operand therefore answered "genuine f64" about an expression
// that is entirely f32 plus literals — which is how `floor(fv + 0.5)` and `copysign(fv, -1.0)`
// came out `f64.floor` / `f64.copysign` in an f32 slot. `emitFloatIntr` asks this of an
// intrinsic's first/last ARGUMENT (a one-argument intrinsic asks it of its single operand twice),
// so the operand IS routinely a compound expression, not the leaf a binary operator's side is.
//
// The rule, in the order the arms below test it:
//   • not `exprIsF64` at all             → not hard
//   • a (parenthesized / negated) float literal → not hard, it re-encodes
//   • a GENUINE f64 leaf anywhere in the spine  → HARD (`fv + dv`, `(fs + ft) * dw`)
//   • otherwise soft ONLY if the spine has an f32 leaf to adapt to. An ALL-LITERAL float
//     compound (`0.0 - 1.0`) has none: there is nothing to adapt to, and `emitExprAsF32` has no
//     lowering for f64 arithmetic — its fallthrough is `f32.convert_i32_s`, which would take an
//     `f64.sub`. So it stays f64, exactly as before (`float-opcodes-f32.vl` pins it).
function exprHasHardF64(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  if !exprIsF64(exprIx, fnIx) { return false }
  if exprIsFloatLit(exprIx) { return false }
  const bits = spineFloatLeafBits(exprIx, fnIx)
  if bits >= 2 { return true }
  bits != 1
}

// Does a binary op over `leftIx`/`rightIx` have a GENUINE (non-literal) f64 operand? Such an operand
// makes the whole op f64 — an f32 / i32 / float-literal side widens to it (`f32var + f64var` is f64,
// computed in f64). A float LITERAL is NOT genuine f64 (it adapts down to an f32 operand), so it does
// not trigger this. Drives both the `exprIsF32` classification and the f32 emit slice: when true,
// the op is f64 (the f64 slice), not f32 — without which the f32 slice demoted the f64 and trapped.
export function binMixHardF64(leftIx: i32, rightIx: i32, fnIx: i32) {
  if exprHasHardF64(leftIx, fnIx) { return true }
  exprHasHardF64(rightIx, fnIx)
}

export function exprIsF32(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  if tyKindOf(nodeTyIxOf(exprIx)) == 13 {
    return true // typed-IR fast path (see exprIsF64)
  }
  if coalesceAtomKind(exprIx, fnIx) == 5 { return true }
  const e = P.nodes[exprIx]
  // An explicit `x as T` cast has exactly its target rep (see exprIsF64).
  if e is AsExpr { return e.asTy == "f32" }
  if e is Paren { return exprIsF32(e.parInner, fnIx) }
  // An index read `xs[i]` over an `f32[]` yields an f32 element.
  if e is Index {
    if exprF32Array(e.idxArr, fnIx) { return true }
  }
  // A field read `s.x` whose struct field is an f32 slot (code 24) yields an f32.
  if e is Member { return memFieldTypeCode(exprIx, fnIx) == 24 }
  if e is Ident {
    // A VALUE-union ident classifies by its narrowed atom (see exprIsI64).
    const uk = unionIdentReadKind(exprIx, fnIx)
    if uk != -3 { return uk == 5 }
    if paramIsF32(fnIx, e.identName) { return true }
    if declaredF32(e.identName) { return true }
    // A CAPTURED f32 — same field/read agreement `exprIsF64`'s arm carries.
    if capturedKindOf(fnIx, e.identName) == "f32" { return true }
    return globalIsF32Sid(sidOfNode(exprIx))
  }
  // Arithmetic yields f32 when EITHER operand is f32. Comparisons / logical connectives
  // produce an i32 BOOL even over f32 operands, so they are NOT f32.
  if e is BinExpr {
    const op = e.binOp
    if op == "+" || op == "-" || op == "*" || op == "/" {
      // f32 arithmetic yields f32 only when NO operand is a genuine f64 — a genuine f64 side makes
      // the op f64 (the f32 side widens). A float literal does not count (it adapts down to f32).
      if binMixHardF64(e.binLeft, e.binRight, fnIx) { return false }
      if exprIsF32(e.binLeft, fnIx) { return true }
      return exprIsF32(e.binRight, fnIx)
    }
    return false
  }
  if e is Unary {
    if e.unOp == "-" { return exprIsF32(e.unArg, fnIx) }
    return false
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const target = fnIndexOfSid(sidOfNode(e.callFn))
      if target >= 0 { return fRetKind[target] == "f32" }
    }
    // An f32-returning FIELD-closure call (`o.f(x)` over an `(…) => f32` field) —
    // the arm `exprIsF64` and `exprIsI64` both carry, and the one this classifier
    // lacked. A member-call node the CHECKER produced is covered by the typed-IR
    // fast path at the top, so the gap only shows on a call the EMITTER synthesized:
    // `x[i]` over a `"[]"` closure field is rewritten to `x["[]"](i)` by
    // `dispatchRewrite`, and the minted `Call` carries no arena entry. Without this,
    // the f32 result was bound into an i32 slot and the module failed validation
    // ("expected i32, found f32"). The free-operator route never hit it: its rewrite
    // mints an IDENT callee, which the arm above resolves.
    if callee is Member {
      const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if ffe >= 0 { return fRetKind[ffe] == "f32" }
    }
    return false
  }
  // A value-position if-EXPRESSION is f32 when either arm's value is f32.
  if e is IfStmt { return ifExprArmIsKind(exprIx, fnIx, "f32") }
  false
}

// The non-i32 numeric rep an if-expression arm can carry. A pure SELECTOR (never encoded):
// it tags which `exprIs*` classifier `armValueIsKind` consults, replacing the bare wasm
// blocktype bytes 124 (f64) / 125 (f32) / 126 (i64) the call sites used to thread through.
// The actual blocktype byte is emitted elsewhere (`ifExprValtype`/`emitIfExprRef`). (C2 cleanup.)
type BtKind = "f64" | "f32" | "i64"

// True if a value-position if-EXPRESSION (`ifIx`) carries the numeric rep named by `kind`:
// either arm's tail value is of that kind, recursing through an `else if` chain in the else
// slot. Drives both the whole-expression classification (`exprIsF64`/`exprIsF32`/`exprIsI64`
// above, so print routing and context coercion see the joined type) and the blocktype
// `emitIfExpr` picks. A bare i32-arm if-expression matches none of these and stays the i32 default.
function ifExprArmIsKind(ifIx: i32, fnIx: i32, kind: BtKind) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    if s.ifElse < 0 { return false }
    const thenV = ifArmValueExpr(s.ifThen)
    if armValueIsKind(thenV, fnIx, kind) { return true }
    const els = P.nodes[s.ifElse]
    if els is IfStmt { return ifExprArmIsKind(s.ifElse, fnIx, kind) }
    return armValueIsKind(ifArmValueExpr(s.ifElse), fnIx, kind)
  }
  false
}

// Classify a single arm-value expression against a numeric rep `kind`.
function armValueIsKind(exprIx: i32, fnIx: i32, kind: BtKind) {
  match kind {
    "f64" => exprIsF64(exprIx, fnIx)
    "f32" => exprIsF32(exprIx, fnIx)
    "i64" => exprIsI64(exprIx, fnIx)
  }
}

// True if the DECLARED LOCAL `name` is an f64 slot (kind 11 in the local registry).
function declaredF64(name: string) { declaredKind(name) == "f64" }

// True if the module GLOBAL `name` is an f64 cell. (Slice 3.)
function globalIsF64Sid(sid: i32) {
  const li = globalLetOfSid(sid)
  if li < 0 { return false }
  letIsF64(li, -1)
}

// True if evaluating the expression at `exprIx` yields an f64: a float `.` literal,
// a reference to an f64 param/local/global, f64 arithmetic (either operand f64 — the
// i32 side widens via `f64.convert_i32_s`), unary `-`/parens over such, or a call to
// an f64-returning function. Drives the `print` import choice (`__print_f64__`) and the
// per-operand opcode selection in the BinExpr path. (Slice 3.)
export function exprIsF64(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  // Typed-IR fast path through the single `tyKindOf` mapping (additive — only turns false
  // into true, so the flow/union-narrowed cases below still apply; a node with no recorded
  // type, e.g. a monomorphized instance body, reads -1 and falls through to the syntactic
  // derivation).
  if tyKindOf(nodeTyIxOf(exprIx)) == 11 { return true }
  if coalesceAtomKind(exprIx, fnIx) == 4 { return true }
  // `m[k] ?? d` / `m.get(k) ?? d` over an f64-VALUED map yields an f64 (the value type).
  const cmf = coalesceMvSlot(exprIx, fnIx)
  if cmf >= 0 {
    if mvValKind[cmf] == 11 { return true }
  }
  const e = P.nodes[exprIx]
  // An explicit `x as T` cast has exactly its target rep — classify syntactically
  // (robust where `nodeTyIx` is absent, e.g. a monomorphized body).
  if e is AsExpr { return e.asTy == "f64" }
  if e is NumLit { return numTextIsFloat(e.numText) }
  if e is Paren { return exprIsF64(e.parInner, fnIx) }
  // An index read into an `f64[]` yields an f64 element (Slice 4) — so it routes to
  // `__print_f64__` and participates in f64 arithmetic. A bare `m[k]` read over an
  // f64-valued map likewise yields an f64.
  if e is Index {
    if exprF64Array(e.idxArr, fnIx) { return true }
    const mrs = mapReadMvSlot(exprIx, fnIx)
    if mrs >= 0 {
      if mvValKind[mrs] == 11 { return true }
    }
    return false
  }
  if e is Ident {
    // A VALUE-union ident classifies by its narrowed atom (see exprIsI64).
    const uk = unionIdentReadKind(exprIx, fnIx)
    if uk != -3 { return uk == 4 }
    if paramIsF64(fnIx, e.identName) { return true }
    if declaredF64(e.identName) { return true }
    // A CAPTURED f64. The env FIELD is typed by `captureValKind`, so the READ must
    // classify by that same answer or the two disagree and the operand is widened
    // through `f64.convert_i32_s` over a slot that already holds an f64 — `vl
    // check`-clean invalid wasm. The typed-IR fast path above covers a capture only
    // when the OWNING binding is annotated; an un-annotated parent param is `any` to
    // the checker, so the syntactic derivation is the only route left and it needs
    // this arm. (Scalar dual of the `"str"`/`"list"`/`"map"` capture arms.)
    if capturedKindOf(fnIx, e.identName) == "f64" { return true }
    return globalIsF64Sid(sidOfNode(exprIx))
  }
  // Arithmetic yields f64 when EITHER operand is f64. Comparisons / logical connectives
  // produce an i32 BOOL even over f64 operands, so they are NOT f64.
  if e is BinExpr {
    const op = e.binOp
    if op == "+" || op == "-" || op == "*" || op == "/" {
      if exprIsF64(e.binLeft, fnIx) { return true }
      return exprIsF64(e.binRight, fnIx)
    }
    // `xs.get(i) ?? d` over an f64 list yields an f64 (the fused checked read);
    // the default `d` shares the element type, so classify by the right side.
    if op == "??" {
      const lhs = P.nodes[unwrapParen(e.binLeft)]
      if lhs is Call {
        const lcallee = P.nodes[lhs.callFn]
        if lcallee is Member {
          if lcallee.memProp == "get" || lcallee.memProp == "pop" {
            if exprF64Array(lcallee.memObj, fnIx) { return true }
          }
        }
      }
      return false
    }
    return false
  }
  // Unary negation `-x` preserves f64-ness (`~` is integer-only; `!` is bool).
  if e is Unary {
    if e.unOp == "-" { return exprIsF64(e.unArg, fnIx) }
    return false
  }
  if e is Call {
    // An INDEXED closure call `fs[i](x)` whose element signature returns f64.
    if cloArrCallRetKind(exprIx, fnIx) == "f64" { return true }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const target = fnIndexOfSid(sidOfNode(e.callFn))
      if target >= 0 { return fRetKind[target] == "f64" }
      // A function-VALUE (closure) callee returning f64 — its result routes as f64.
      return calleeReturnsF64Sid(sidOfNode(e.callFn), fnIx)
    }
    // A FIELD-closure call `t.op(x)` whose field function returns f64.
    if callee is Member {
      const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if ffe >= 0 { return cloRetKindOf(ffe) == "f64" }
    }
    return false
  }
  // A field read `p.x` whose struct field is an f64 slot (code 17) yields an f64.
  if e is Member { return memFieldTypeCode(exprIx, fnIx) == 17 }
  // A value-position if-EXPRESSION is f64 when either arm's value is f64 (the
  // branch-join widens to f64); an `else if` chain recurses through the else slot.
  if e is IfStmt { return ifExprArmIsKind(exprIx, fnIx, "f64") }
  false
}

export function exprIsBool(ix: i32, fnIx: i32) {
  if ix < 0 { return false }
  // Typed-IR fast path (additive — only turns false into true, mirroring exprIsF64):
  // the checker recorded this node as the `boolean` prim. Boolean shares the i32 rep
  // everywhere, so the syntactic derivations below lose the boolean TAG through several
  // read paths — a struct-FIELD read (field code 0 = i32/boolean), a map `??` result, a
  // closure-VALUE call result, a `boolean[]` PARAM element — and `print` rendered 0/1.
  if nodeTyWidenedRepName(ix) == "boolean" { return true }
  const e = P.nodes[ix]
  if e is BoolLit { return true }
  if e is IsExpr { return true }
  if e is Paren { return exprIsBool(e.parInner, fnIx) }
  if e is Index {
    // An element read over a BOOLEAN-element list prints as true/false: a `.map` result
    // whose callback returns boolean (`xs.map(function(n: i32) n > 2)[i]`), OR a directly
    // declared `boolean[]` (`bs[i]`). Any other index read keeps its i32 classification.
    if mfArrElemIsBool(e.idxArr, fnIx) { return true }
    return listElemIsBool(e.idxArr, fnIx)
  }
  if e is Unary { return e.unOp == "!" }
  if e is Ident {
    // A VALUE-union ident narrowed to `boolean` unboxes to the bool rep and
    // prints true/false (see exprIsI64 for the classification rule).
    const uk = unionIdentReadKind(ix, fnIx)
    if uk != -3 { return uk == 1 }
    // A `boolean|null` NICHE binding read (narrowed non-null in its branch)
    // prints true/false. Plain `boolean` idents stay unclassified (existing rule).
    if exprNulBool(ix, fnIx) { return true }
    // A CAPTURED boolean (a closure returning its maker's `x: boolean` param,
    // e.g. a monomorphized `wrap(true)` index-trap instance) — so the closure's
    // inferred return kind (`fRetBool`) sees the bool-ness through the env.
    if capturedIsBool(fnIx, e.identName) { return true }
    // A plain boolean local/param/global — recovered from the binding's annotation
    // or initializer, since a boolean local registers identically to an i32.
    if boundBoolByName(e.identName, fnIx) { return true }
  }
  if e is BinExpr {
    const op = e.binOp
    if op == "==" || op == "!=" { return true }
    if op == "<" || op == ">" || op == "<=" || op == ">=" { return true }
    if op == "&&" || op == "||" { return true }
    // `lhs ?? d` over a BOOLEAN-list `.get`/`.pop` (or a binding seeded by one)
    // yields a boolean — render true/false. Other `??` reads keep i32 (map gets).
    if op == "??" {
      const lhs = P.nodes[unwrapParen(e.binLeft)]
      if lhs is Call {
        const lcallee = P.nodes[lhs.callFn]
        if lcallee is Member {
          if lcallee.memProp == "get" || lcallee.memProp == "pop" {
            if !exprMap(lcallee.memObj, fnIx) {
              return listElemIsBool(lcallee.memObj, fnIx)
            }
          }
        }
      }
      if lhs is Ident { return identNullableBoolPop(lhs.identName, fnIx) }
    }
    return false
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    // A FIELD-CLOSURE call (`(wb."[]")(0)` — an index-trap dispatch) classifies
    // by the field function's return: the receiver's ORIGIN resolves the exact
    // monomorphized MAKER instance, so `wrap(true)`'s trap prints true while
    // `wrap(99)`'s prints 99 (the instances SHARE the closure body — bool-ness
    // lives in the instance's pinned param annotation, not the shared closure).
    if callee is Member {
      if (
        drwFieldClosure(structIndexOfExpr(callee.memObj, fnIx), callee.memProp)
      ) {
        return fieldCloCallIsBool(callee.memObj, callee.memProp, fnIx)
      }
    }
    if callee is Ident {
      const target = fnIndexOf(callee.identName)
      if target >= 0 {
        const fn = P.nodes[fnStmts[target]]
        if fn is FuncDecl {
          if fn.fnRet >= 0 {
            const rt = P.nodes[fn.fnRet]
            if rt is TypeRef { return rt.tyName == "boolean" }
          } else {
            // Un-annotated: `computeRetInference` has classified the callee's first
            // valued return into `fRetBool` (fixed point, so a mutually-recursive
            // group resolves).
            return fRetBool[target] == 1
          }
        }
      }
    }
    // G8: a map membership test `m.has(k)` and a `m.delete(k)` both yield a boolean
    // (print true/false): `.has` = is-present, `.delete` = was-present-and-removed.
    if callee is Member {
      if callee.memProp == "has" { return exprMap(callee.memObj, fnIx) }
      if callee.memProp == "delete" { return exprMap(callee.memObj, fnIx) }
      // A string `s.includes(sub)` yields a boolean (print true/false).
      if callee.memProp == "includes" { return exprString(callee.memObj, fnIx) }
    }
  }
  false
}

// Lower a function-VALUE call `f(args)` through the closure fat-pointer. The closure
// is evaluated ONCE into a scratch local, then: push its env (`struct.get 0`), push the
// args, push its callee function index (`struct.get 1`), and `call_indirect $fnsig`.
// Mirrors the host's `indirectCall`.
// A NAMED argument needs the callee's parameter names, which a function VALUE
// (its `TyFunc`) does not carry — fail loudly rather than mis-map positionally.
// The closure `$fnsig` KEY for the elements of a closure-element ref list (kind 5): the
// slot's element type-NAME is the parenthesized function type `((i32) => i32)`; strip the
// grouping parens to `(i32) => i32` and read its signature key (`annSigKey`, which agrees
// byte-for-byte with `fnSigKeyOf`/`cloSigKeyExt`). "" for a non-closure slot or an
// un-keyable signature. Lets an INDEXED closure call (`fs[i](x)`) cast to the ELEMENT's
// real functype instead of the all-i32 arity fallback — which a non-i32-signature array
// (`((f64) => f64)[]`) doesn't even have interned.
function cloArrSlotSigKey(slot: i32) {
  if slot < 0 || slot >= rlElemName.length { return "" }
  if rlElemKindTbl[slot] != 5 { return "" }
  rlElemCloSigKey(slot)
}

// The closure RESULT type-NAME of a closure-element ref-list slot (kind 5): the element name is the
// parenthesized function type `(() => K0 | null)`; strip the grouping parens and return the text
// after the top-level `=>` (`K0 | null`). "" for a non-closure slot / an un-parseable element. Lets
// an INDEXED closure call (`p[i]()`) classify its result niche (`exprNulLitUnion` → `p[i]() : K|null`).
export function cloArrSlotRetName(slot: i32) {
  if slot < 0 || slot >= rlElemName.length { return "" }
  if rlElemKindTbl[slot] != 5 { return "" }
  let nm = rlElemName[slot]
  // A NULLABLE-closure element slot: peel the `| null` (the call classifies on the
  // narrowed non-null closure), mirroring `cloArrSlotSigKey`.
  nm = nonNulBaseOf(nm)
  // The grouping-paren SPAN home (`tyname.nameIsParenSpanEnds`) then the GROUP-INTERIOR cut
  // home (`tyname.groupInnerOf`), exactly as in `rlElemCloSigKey` above — same two endpoint
  // compares, same implied `length >= 2`, the same deliberate absence of a balance walk,
  // and the same test-in-front-of-cut pairing.
  if !nameIsParenSpanEnds(nm) { return "" }
  // `annRetNameOf` (#1144) IS this `annArrowAt`-then-slice pair. Its gate is `< 1` where
  // this copy spelled `< 0`; the two differ only for an arrow at index 0, i.e. a name
  // BEGINNING `=>`, which no renderer produces (the home's own header argues this).
  return annRetNameOf(groupInnerOf(nm))
}

// The wide-SCALAR coercion kind of parameter `idx` read from a `$fnsig` KEY's param-token
// spine: `"i64"` / `"f64"` / `"f32"`, or `null` (i32 / a ref kind — no coercion). Each
// token decodes through the ONE char→kind table (`repKindOfSigTok`); a slot-carrying ref
// token (`s<idx>;` / `V<idx>;` / `r<idx>;`) skips its `;`-terminated digits via the
// table's own slot predicate (`repSigTokHasSlot`). Lets a value CALL widen an i32-literal
// argument into an i64 / f32 / f64 parameter, exactly as a direct call does — without it
// the `call_ref` pushes an i32 and traps.
//
// NOT A TYPE-NAME GRAMMAR (D-CLASSGRAM census note). The `'>'` below and the one
// `sigKeyRetTokIx` scans for are the `$fnsig` KEY's param/result SEPARATOR — a character
// in the ABI token alphabet `repKindOfSigTok` owns, on a string the compiler MINTED, not
// a rendered type. A destringify census looking for hand-written type grammar should skip
// both, the same way #1222 skipped `emit_base`'s `raw[i + 2] == '{'` string-escape lexing.
// It is also NOT routable to that table: `repKindOfSigTok('>')` is `null`, but so is every
// digit and `;` in a slot token, so the compare would WIDEN. And it is not routable to
// `sigKeyRetTokIx` either — that home finds the LAST `>` with a whole-key scan, which
// inside this per-character loop would make the walk quadratic.
export function sigParamCoerceKind(key: string, idx: i32): VKind | null {
  const k = sigParamKindAt(key, idx)
  if k == "i64" || k == "f64" || k == "f32" { return k }
  null
}

// The `VKind` of parameter `idx` in a `$fnsig` KEY's param-token spine — the WHOLE answer
// `sigParamCoerceKind` above filters down to its three wide-scalar rows. `null` for an
// out-of-range index (the walk reached the `>` result separator or ran out of key) or a
// character outside the token vocabulary.
//
// THE INTERLOCK, and the reason this is a separate export rather than an inlined re-walk:
// the token at position `idx` IS the valtype the `call_ref`'s cast functype declares for
// that parameter, so an argument coercion decided from it cannot disagree with the bytes.
// `emitCallRef`'s union-box arm reads it (`"union"` ⟹ the callee wants `(ref $uBox)`, so a
// raw scalar / string / variant argument must be boxed) — a decision the key can make and
// the CHECKER type alone cannot, because the key is what the three producers agreed on.
// (The union NAME for the tag choice is the opposite: slot-free in the ABI, so it comes
// from the checker type — `cloCallParamUnionName`. Kind from the key, identity from the
// arena; each from the only side that has it.)
export function sigParamKindAt(key: string, idx: i32): VKind | null {
  let i = 0
  let p = 0
  while i < key.length {
    const c = key[i]
    if c == '>' { return null }
    const k = repKindOfSigTok(c)
    if p == idx { return k }
    if repSigTokHasSlot(k) {
      while i < key.length && key[i] != ';' { i = i + 1 }
      i = i + 1
    } else {
      i = i + 1
    }
    p = p + 1
  }
  null
}

// The callee's interned `$fnsig` KEY for a value call (`f(x)`, `(o.field)(x)`, `fs[i](x)`), or "" —
// the param tokens drive argument coercion and the key resolves the functype the `call_ref` casts to.
export function cloCallSigKey(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const cre = P.nodes[c.callFn]
    // The syntactic resolvers — fast (no type render): a function-typed binding/param Ident, a struct
    // field closure, an indexed closure-array element.
    if cre is Ident {
      const k = calleeCloSigKeySid(sidOfNode(c.callFn), fnIx)
      if k != "" { return k }
    }
    if cre is Member {
      const mfe = fieldClosureFeOfRecv(cre.memObj, cre.memProp, fnIx)
      if mfe >= 0 {
        // Same-field-name-set shapes DEDUP to one struct index, so the literal-resolved
        // closure may belong to ANOTHER shape's field (`{f: () => {f: (i32) => K0}}` —
        // the outer and inner structs both spell `{f}`, and `fieldClosureFeOf` returned
        // the OUTER 0-arity lambda for the INNER call). Trust it only when the ARITY
        // matches the call; a mismatch falls through to the checker-typed GENERAL
        // FALLBACK below (`nodeTyName` → `annSigKey`), which keys the field's REAL
        // function type. Un-guarded, the wrong key drove the arg coercion + `ref.cast`
        // — INVALID-WASM (fuzz-nightly seed 54110331 d5).
        const mfn = P.nodes[fnStmts[mfe]]
        let mfArity = -1
        if mfn is FuncDecl { mfArity = mfn.fnParams.length }
        if mfArity == c.callArgs.length {
          const mfk = cloSigKeyExt(mfe)
          // The arity guard alone cannot split SAME-ARITY twin fields: two shapes
          // spelling the fieldset `{a, f, z}` (a nullable arm `{a: {f: i64},
          // f: (i32,i32,i32) => K0, z: f32}` beside a closure-result row
          // `{a: i32[], f: (i32,i32,i32) => string, z: K1}`) dedup, and
          // `fieldClosureFeOf` returned the OTHER row's 3-ary lambda — the
          // `ref.cast` took a struct-result functype and the narrowed field call
          // TRAPPED (fuzz post-#991 branching leg, seed 142348133 case_00233).
          // Verify against the CHECKER-typed callee when it is available and a
          // proven function type: a divergent key means the syntactic resolve
          // aliased the twin — the typed key is the one the field's real lambda
          // interned. Either side unresolvable keeps the historic key.
          const mcty = nodeTyIxOf(c.callFn)
          if mcty >= 0 {
            if T.tys[mcty] is TyFunc {
              // D3: key the callee's arena functype DIRECTLY (`sigKeyOfTy`) — the
              // destringified dual of `nodeTyName` → `annSigKey`, walking the `TyFunc`
              // spine rather than rendering a name and re-parsing it.
              const mtk = sigKeyOfTy(mcty)
              // Only an INTERNED divergent key overrides: the arena key can be a
              // benign twin of the interned key (an inline shape vs its nominal —
              // the closure-array-field-literal canary), and an un-interned key
              // would turn a working call into a loud "no interned signature".
              if mtk != "" && mtk != mfk {
                if cloSigPosOfKey(mtk) >= 0 { return mtk }
              }
            }
          }
          return mfk
        }
      }
    }
    if cre is Index {
      if exprRefArray(cre.idxArr, fnIx) {
        const k = cloArrSlotSigKey(refListSlotOfExpr(cre.idxArr, fnIx))
        if k != "" { return k }
      }
    }
    // GENERAL FALLBACK — derive the key from the callee's CHECKER arena type, uniformly for ANY
    // callee the syntactic resolvers miss (an indexed closure-array element returning a struct/union,
    // a value INFERRED from a factory call `const g = mk()`). `sigKeyOfTy` (destringify D3) walks the
    // `TyFunc` spine of `nodeTyIxOf(c.callFn)` directly — the byte-identical dual of the former
    // `nodeTyName` → `annSigKey` render+reparse — so the call-site `ref.cast` resolves the functype
    // the lambda interned, with no per-position sig producer and no fragile whole-string spine scan.
    // Off the hot path: reached only after the syntactic resolvers, so a common closure call
    // (annotated binding/param) never reaches it. "" for a non-function callee (the arity fallback).
    const ck = sigKeyOfTy(nodeTyIxOf(c.callFn))
    if ck != "" { return ck }
  }
  ""
}

// The literal-union PARAMETER flavour of value call `callIx`'s parameter `idx`: `1` a `K`
// ATOM param, `2` a `K | null` NICHE param, `0` neither. The `emitCallRef` twin of the two
// seeds `emitCall` reads off a DECLARED callee's `Param` node (`nodeTyIsLitUnionAlias` →
// `cParamLitUnion`, `nodeTyIsNulLitUnion` → `cParamNulLitUnion`), which a function VALUE has
// no `Param` node to reach.
//
// IT CANNOT COME FROM THE `$fnsig` KEY, and that is by design rather than by omission: a
// litunion param's token is `i`, deliberately IDENTICAL to a plain `i32` param's, because the
// two valtypes are identical and the key's whole job is to make two functions share one
// `$fnsig` exactly when their functypes byte-match. MEASURED, not assumed — a probe printing
// `cloCallSigKey` over the whole function-value grid reads `i>i` for BOTH `const f: (K) => i32
// = pick` and `const f: (i32) => i32 = inc`. So the distinction can only come from the CHECKER
// type, which is what this reads (`nodeTyIxOf(c.callFn)` → the `TyFunc` spine — the same
// arena walk `cloCallSigKey`'s general fallback already makes).
export function cloCallParamLitUnion(callIx: i32, idx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const ft = nodeTyIxOf(c.callFn)
    if ft < 0 { return 0 }
    const t = T.tys[ft]
    if t is TyFunc {
      if idx < 0 || idx >= t.fnParamTypes.length { return 0 }
      const pty = t.fnParamTypes[idx]
      // ALIAS-ONLY for the non-null form, by arena-index identity — the SAME subtraction
      // `nodeTyIsLitUnionAlias` makes for the declared-callee twin, and for the same measured
      // reason: an INLINE `"a" | "b"` param really IS a string (`canonEmitName` softens it,
      // the param context being outside `litUnionPreserve`'s ELEM/FIELD/MAP_VAL/FN_RES set),
      // and its call sites work today by pushing the string. `unionAliasDeclNameOfTy`, NOT
      // `litUnionAliasNameOfTy` — the latter falls back to a member-literal SET match and so
      // names the inline spelling "K" in any program that also declares `type K = "a" | "b"`.
      if tyIsLitUnion(pty) {
        if unionAliasDeclNameOfTy(pty) != "" { return 1 }
        return 0
      }
      // The NICHE claims BOTH spellings, exactly as `nodeTyIsNulLitUnion` does:
      // `canonEmitTypeNames` PRESERVES a nullable litunion's members
      // (`nulLitUnionPreserve`), so inline and aliased alike rep as the i32 atom with the
      // `-1` null sentinel.
      if tyIsNullableLitUnion(pty) { return 2 }
    }
  }
  0
}

// The union-BOX PARAMETER NAME of value call `callIx`'s parameter `idx` — the emitter's
// registered union name (`isUName`), which `emitUnionCoerce` resolves to its member set for
// the tag choice. "" when the parameter is not a union box.
//
// THE PARAMETER TWIN of the RESULT-side `cloCallUnionResultUnrepresentable`, and the
// `emitCallRef` twin of the seed `emitCall` reads off a DECLARED callee's `Param` node
// (`vtKindOfParam(...) == "union"` → `cUNm = tyNameOf(parType)` → `emitUnionBoxArg`), which a
// function VALUE has no `Param` node to reach. Without it a value call pushed the RAW scalar /
// string / ref into a parameter the `$fnsig` functype declares as `(ref $uBox)` — `vl check`
// rc 0, INVALID WASM, from four ordinary lines:
//
//     function mk(k: string | i64): i32 { return 1 }
//     const f: (string | i64) => i32 = mk
//     print(f("a"))
//   → "type mismatch: expected (ref $type), found (ref $type)"
//
// in EVERY function-value shape (annotated binding, lambda, HOF param) and for EVERY value-
// union spelling (inline `string | i64`, the alias `type U = string | i64`, the mixed
// `{w: i32} | i64`, the nullable-scalar niche `i32 | null` — which reps as the box too). A
// union-VALUE argument escaped, because it already IS the box; only a raw member had to be
// told which rep to take. The exact shape of the litunion `cloCallParamLitUnion` above.
//
// IT CANNOT COME FROM THE `$fnsig` KEY, for the same reason the litunion flavour cannot and a
// stronger one: the union token `u` is deliberately SLOT-FREE (`repSigTokHasSlot` excludes it)
// because every boxed union shares ONE `$uBox` valtype, so two functions taking different
// unions MUST share a `$fnsig`. The key can therefore say a parameter is a box — which is
// exactly what `sigParamKindAt` is read for at the call site — but never WHICH box. So the
// KIND comes from the key (it is the byte the cast functype carries) and the IDENTITY from
// the checker type, here.
//
// The two litunion flavours are subtracted FIRST and by the same predicates
// `cloCallParamLitUnion` claims them with: a litunion alias reps as the interned i32 ATOM and
// a `K | null` as the `-1` niche — neither is a box, and boxing one would undo #1170.
export function cloCallParamUnionName(callIx: i32, idx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const ft = nodeTyIxOf(c.callFn)
    if ft < 0 { return "" }
    const t = T.tys[ft]
    if t is TyFunc {
      if idx < 0 || idx >= t.fnParamTypes.length { return "" }
      const pty = t.fnParamTypes[idx]
      if tyIsLitUnion(pty) { return "" }
      if tyIsNullableLitUnion(pty) { return "" }
      // A REGISTRY LOOKUP, not a key mint — which is why three candidate spellings is the
      // right shape and not a smell. `emitUnionCoerce` needs a name the union REGISTRY
      // knows (`isUName`, so `unionMemberSetOf` resolves it to the member set the tag
      // choice reads); the registry was filled from whichever spelling reached this union
      // first, and the arena cannot say which. So ASK, most-specific first, and let the
      // token producer confirm — each candidate is measured, not guessed:
      //
      //  1. the DECLARED alias, by arena-index identity. `type U = A | B` registers under
      //     `U`, so a render is a name `isUName` does not know: keying the render alone
      //     turned nine working `type U = …` cells into a loud reject. `U` is also exactly
      //     what the direct twin passes (`tyNameOf(parType)`), so both boundaries hand
      //     `emitUnionCoerce` the same string.
      //  2. the NOMINAL render. An INLINE union has no declaration to name and registers
      //     under its member set — but that set is spelled NOMINALLY (`A|B`), because the
      //     registration walk keys `tyToNominalName`. The STRUCTURAL renderer expands a
      //     declared struct member to its shape (`{a:i32}|{b:i32}`), a name nothing
      //     registered: `tests/cases/closures/closure-param-union-arena-walk.vl` — an
      //     `(A | B) => i32` HOF param, registered ONLY by the arena walk — is the witness.
      //  3. the STRUCTURAL render, for an inline union the source itself spelled
      //     structurally, where that IS the registered key.
      //
      // The `canonEmitName` leg of the registration hop (`emit_collect.arenaEmitName`) is
      // deliberately NOT reproduced here: its rewrites are litunion softening and alias
      // transparency, and both litunion flavours are already subtracted above. A fourth
      // copy of that hop would also have to move a private function across a module edge
      // that runs the wrong way (`emit_collect` imports THIS file).
      let nm = unionAliasDeclNameOfTy(pty)
      if nm != "" {
        if annParamKind(nm) == repSigTokOfKind("union") { return nm }
      }
      nm = tyToNominalName(pty)
      if nm != "" {
        if annParamKind(nm) == repSigTokOfKind("union") { return nm }
      }
      nm = tyToEmitName(pty)
      if nm == "" { return "" }
      // The REGISTRATION test, made by the token producer itself rather than restated: a name
      // `annParamKind` keys `u` is one `isUName` admits, hence one `unionMemberSetOf` resolves.
      // Asking the producer keeps this arm and the ABI from ever disagreeing about what a box is.
      if annParamKind(nm) != repSigTokOfKind("union") { return "" }
      return nm
    }
  }
  ""
}

// The PRODUCER (concrete-lambda) `$fnsig` key of a function-VALUE binding `name` — the
// functype the lambda VALUE actually carries (`cloSigKeyExt` of the resolved lambda),
// chasing a plain copy to the source binding's initializer lambda. "" when `name` does
// not resolve to a concrete lambda.
function producerCloSigKey(name: string, fnIx: i32) {
  const fe = identClosureFe(name, fnIx)
  if fe >= 0 { return cloSigKeyExt(fe) }
  const src = identCopySource(name, fnIx)
  if src != "" && src != name { return producerCloSigKey(src, fnIx) }
  ""
}

// SOUNDNESS FLOOR: a function-VALUE call whose RESOLVED cast `$fnsig` (`cloCallSigKey` — the
// EXACT key `emitCallRef` casts the value to) and its concrete PRODUCER lambda's `$fnsig` are
// BOTH interned REF-LIST results on DIFFERENT, non-layout-twin element slots — a latent twin.
// A lambda whose literal element is NON-nullable (`() => ([{f: () => string}])`) self-infers a
// `>r<nonNullSlot>;` sig, while the binding annotation's NULLABLE element (`() => ({f: () =>
// string} | null)[]`) keys `>r<nullableSlot>;`; the two ref-list WRAPPER structs are distinct
// heap types (array elements are INVARIANT — `(array (ref $e))` is not `(array (ref null $e))`),
// so the call-ref `ref.cast` to the annotation's wrapper TRAPS on the producer's. `rlSlotsLayoutTwin`
// gates OUT the benign case where the two slots dedup to one wrapper (no trap). Reject LOUDLY —
// the deferred nullable-element ref-list composition (#875 / the twin-matcher rewrite); the
// DIRECT array binding (element built nullable in place) lowers fully.
export function cloCallReflistElemTwin(callIx: i32, fnIx: i32): boolean {
  const c = P.nodes[callIx]
  if c is Call {
    const cre = P.nodes[c.callFn]
    if cre is Ident {
      const castK = cloCallSigKey(callIx, fnIx)
      if castK == "" { return false }
      const prodK = producerCloSigKey(cre.identName, fnIx)
      if prodK == "" { return false }
      if prodK == castK { return false }
      if cloSigPosOfKey(castK) < 0 { return false }
      if cloSigPosOfKey(prodK) < 0 { return false }
      const crk = sigKeyRetKind(castK)
      const prk = sigKeyRetKind(prodK)
      if crk == null || prk == null { return false }
      if crk == "reflist" && prk == "reflist" {
        const cs = sigKeyRetSlot(castK)
        const ps = sigKeyRetSlot(prodK)
        if cs >= 0 && ps >= 0 && cs != ps {
          if rlSlotsLayoutTwin(cs, ps) == 0 { return true }
        }
      }
    }
  }
  false
}

// True if the list at `arrIx` carries BOOLEAN elements: a `[true, ...]` literal, a
// `boolean[]` annotation, a name tracing to either (local let or module global), or
// a `.map`/`.filter` result whose callback returns boolean (`mfArrElemIsBool`).
// Boolean elements ride the i32 list rep (0/1), with the spare value 2 encoding the
// `boolean | null` of a checked `.pop()` — the niche sentinel, mirroring the host.
export function listElemIsBool(arrIx: i32, fnIx: i32) {
  if arrIx < 0 { return false }
  const inner = unwrapParen(arrIx)
  const e = P.nodes[inner]
  if e is ArrayLit {
    if e.arrElems.length > 0 { return exprIsBool(e.arrElems[0], fnIx) }
    return false
  }
  if e is Ident {
    let li = -1
    if fnIx >= 0 {
      const fn = P.nodes[fnIx]
      if fn is FuncDecl { li = parentLetOf(fn.fnBody, e.identName) }
    }
    if li < 0 { li = globalLetOf(e.identName) }
    if li >= 0 {
      const d = P.nodes[li]
      if d is LetDecl {
        if d.letType >= 0 {
          const lt = P.nodes[d.letType]
          if lt is TypeRef {
            // The ARRAY grammar's ONE CUT (`emit_base.arrElemNameRaw`) plus the bare
            // LEAF name, which is what the whole-spelling compare `== "boolean[]"` was
            // saying — the D-WHOLESPELL pattern, no new helper. Deliberately NOT
            // `nameIsI32Array`: that home is REP-wide (it also accepts `i32[]`, a
            // litunion `K[]`, `(boolean|null)[]` and `(K|null)[]`, all of which share the
            // one i32 backing), and this site is about the element's PRINT formatting,
            // which only a genuine `boolean` leaf recovers. Same file, same family, and
            // the right home differs per arm.
            if arrElemNameRaw(lt.tyName) == "boolean" { return true }
          }
        }
        if d.letInit >= 0 {
          if unwrapParen(d.letInit) != inner {
            return listElemIsBool(d.letInit, fnIx)
          }
        }
      }
    }
    return false
  }
  mfArrElemIsBool(arrIx, fnIx)
}

// True if `name` is a binding whose initializer is a checked `.pop()` over a
// BOOLEAN-element list — its i32 cell holds 0/1 or the niche sentinel 2 (`null`),
// so a later `name ?? d` must compare against 2, not test a ref.
export function identNullableBoolPop(name: string, fnIx: i32) {
  let li = -1
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl { li = parentLetOf(fn.fnBody, name) }
  }
  if li < 0 { li = globalLetOf(name) }
  if li >= 0 {
    const d = P.nodes[li]
    if d is LetDecl {
      if d.letInit >= 0 {
        const ini = P.nodes[unwrapParen(d.letInit)]
        if ini is Call {
          const callee = P.nodes[ini.callFn]
          if callee is Member {
            if callee.memProp == "pop" {
              return listElemIsBool(callee.memObj, fnIx)
            }
          }
        }
      }
    }
  }
  false
}

// Lower a `.map`/`.filter` HOF call onto `body`, leaving the RESULT list wrapper ref
// on the stack. Mirrors the host's `lowerMapMethodCall` (`toWasm.ts:2143–2245`) over
// the `call_ref` closure ABI — the generic closure-calling loop ONLY (the inline
// desugar of single-expression callbacks is a documented non-goal; `vl build -O`
// devirtualizes + inlines it):
//   map:    n = len(src); back = array.new_default(<outElemArr>, n)
//           for i in 0..n:  back[i] = call_ref(clo, [elem(i)])
//           result = wrapper{ back, n, n }
//   filter: n = len(src); back = array.new_default(<elemArr>, n); j = 0
//           for i in 0..n:  if call_ref(clo, [elem(i)]): back[j] = elem(i); j++
//           result = wrapper{ back, j, n }          // len = j, cap = n
// The receiver is evaluated ONCE into the typed src slot; the callback's closure
// value is built ONCE before the loop (an inline literal / named function emits
// `emitClosureValue`; a let-bound value reads its binding). `filter` re-reads
// `elem(i)` off the src backing for the survivor store (a pure re-read — the host
// materializes it the same way). The result element kind is the callback's RETURN
// kind for `map` (an i32→bool callback yields a bool/i32-element list; an f64
// callback the f64 backing + wrapper), the receiver's element kind for `filter`.
// The interned `$fnsig` KEY of a `.map`/`.filter` callback that is a CLOSURE VALUE — a function-typed
// param or binding (`xs.map(f)` with `f: (i32) => i32`), NOT a literal lambda / named function (those
// resolve a lifted `mfCallbackFe`). "" otherwise. Lets `.map`/`.filter` accept a runtime callback (the
// `call_ref` loop already does), so a higher-order function can forward a callback to `.map`.
export function mfCallbackCloKey(cbIx: i32, fnIx: i32) {
  const cb = P.nodes[unwrapParen(cbIx)]
  if cb is Ident {
    if fnIndexOf(cb.identName) >= 0 {
      return "" // a named fn — uses the lifted-fe path
    }
    return calleeCloSigKey(cb.identName, fnIx)
  }
  ""
}

// Map a closure SIG-RETURN kind (`sigKeyRetKind`) to a `.map` RESULT element kind
// (`mfResultKindOf`'s vocabulary), for a closure-value callback. A STRUCT return maps to a
// ref-list result — its slot comes from `mfResultSlotOf`'s closure-value branch. `null`
// for a void result / still-unwired ref kind.
function mfResKindFromSigRet(k: VKind | null): MfKind | null {
  if k == "i32" { return "i32" }
  if k == "f64" { return "f64" }
  if k == "i64" { return "i64" }
  if k == "str" { return "str" }
  if k == "struct" { return "ref" }
  null
}

// If the `if` condition at `condIx` is `n is Variant` over a bare union identifier
// `n`, PUSH the narrowing (`narrowNames`/`narrowVariants`) so the then-branch's
// `n.field` reads downcast through the box, and return true. Otherwise leave the
// narrowing stack untouched and return false. A non-identifier receiver (e.g. `f(x) is
// A`) is not narrowable (no stable name to re-read) and is left un-narrowed. The caller
// saves the stack length and truncates back on branch exit (`restoreNarrow`).
export function setNarrowFromCond(condIx0: i32, fnIx: i32) {
  // A parenthesized condition guards identically (`if (x is A)` ≡ `if x is A`), and
  // the checker's narrowing collectors already peel `Paren` — match them here so the
  // emitter narrows every branch the checker proved narrowed. Every matcher below
  // (including the `&&`-conjunct recursion) sees the bare condition shape.
  const condIx = unwrapParen(condIx0)
  const c = P.nodes[condIx]
  // An `is T` test PINS a variant rather than stripping `null`, so a consumer that only
  // accepts strips (the loop body — see `narrowStripNullOnly`) skips this whole block.
  if c is IsExpr && !narrowStripNullOnly {
    const recv = P.nodes[c.isObj]
    if recv is Ident {
      if exprUnion(c.isObj, fnIx) {
        pushNarrowIs(recv.identName, c.isVariant, condIx)
        return true
      }
    }
    // `o.y is T` over a UNION-typed struct FIELD narrows the member PATH (the
    // narrowing key is the path string `o.y`; `emitMem` unboxes under it).
    const mrecv = P.nodes[unwrapParen(c.isObj)]
    if mrecv is Member {
      if memberUnionFieldName(unwrapParen(c.isObj), fnIx) != "" {
        const mk = memberPathKeyOf(unwrapParen(c.isObj))
        if mk != "" {
          pushNarrowIs(mk, c.isVariant, condIx)
          return true
        }
      }
    }
    // `x?.y is T` narrows the member PATH exactly like `x.y is T` — the then-arm
    // only runs when every chain link held AND the union field matched, so the
    // plain `x.y` reads inside it unbox under the same path key.
    if mrecv is OptMember {
      const omSi = optChainStructIdxOf(mrecv.omObj, fnIx)
      if omSi >= 0 {
        const omFi = sFieldIndex(omSi, mrecv.omProp)
        if omFi >= 0 {
          if sFieldTypeAt(omSi, omFi) == 16 {
            const omRoot = P.nodes[unwrapParen(mrecv.omObj)]
            if omRoot is Ident {
              pushNarrowIs(
                omRoot.identName + "." + mrecv.omProp,
                c.isVariant,
                condIx,
              )
              return true
            }
          }
        }
      }
    }
  }
  // `a && b` composes: the then-branch sees BOTH conjuncts' narrowings (the
  // host's A5 — the RHS is even CHECKED under the LHS's narrowing). The pushes
  // stack; the caller's save/restore of `narrowTop` unwinds them together.
  if c is BinExpr {
    if c.binOp == "&&" {
      const nl = setNarrowFromCond(c.binLeft, fnIx)
      const nr = setNarrowFromCond(c.binRight, fnIx)
      return nl || nr
    }
  }
  // `!cond` swaps the branch senses: the then-arm of `if !(x is A) { … }` sees the
  // ELSE-narrowing of the inner condition (the host's negation complement).
  if c is Unary {
    if c.unOp == "!" {
      return setNarrowFromCondElse(unwrapParen(c.unArg), fnIx)
    }
  }
  // `x == null` / `x != null` over a BOXED VALUE union narrows the THEN-branch:
  // `==` pins `x` to the `null` member; `!=` strips `null` from the current set
  // (so `i32 | null` fully unboxes to `i32` in the non-null branch).
  const nm = valueUnionNullCmpName(condIx, fnIx)
  if nm != "" {
    const cn = P.nodes[condIx]
    if cn is BinExpr {
      if cn.binOp == "==" {
        // Pinning `x` to `null` is not a strip — skipped for a strip-only consumer.
        if narrowStripNullOnly { return false }
        pushNarrow(nm, "null")
        return true
      }
      const nsid = currentNarrowSetIdOf(nm, fnIx)
      if pushNarrowComplement(nm, nsid, "null") != "" { return true }
      const rest = removeAtomFromSet(currentNarrowSetOf(nm, fnIx), "null")
      if rest != "" {
        pushNarrow(nm, rest)
        return true
      }
    }
  }
  // `w.f == null` / `w.f != null` over a boxed-union FIELD narrows the member PATH — the
  // null-compare twin of the `is` arm's member channel above, and the narrowing key is the
  // same path string (`emitMem` unboxes under it). Without it the guard's TEST was correct
  // (the box tag compare) while the then-arm's `w.f` read stayed the raw `(ref $uBox)` and
  // went straight into its i32 consumer: `vl check` clean, INVALID WASM — while the `is null`
  // spelling of the identical program was correct, because only THAT spelling had a member
  // channel. The member set comes from the FIELD's own declared union name, not from
  // `currentNarrowSetOf`, whose `unionNameOfIdent` fallback cannot resolve a path key.
  const mnull = nullCmpRefOf(condIx)
  if mnull >= 0 {
    if P.nodes[mnull] is Member {
      const mfn = memberUnionFieldName(mnull, fnIx)
      if mfn != "" && isValueUnionName(mfn) {
        const mk = memberPathKeyOf(mnull)
        if mk != "" {
          const mcn = P.nodes[condIx]
          if mcn is BinExpr {
            if mcn.binOp == "==" {
              pushNarrow(mk, "null")
              return true
            }
            const mrest = removeAtomFromSet(unionMemberSetOf(mfn), "null")
            if mrest != "" {
              pushNarrow(mk, mrest)
              return true
            }
          }
        }
      }
    }
  }
  // The same null-compare narrowing over a BOXED STRUCT union with a `null` member
  // (`v: A | B | null`): `!=` strips `null` (so an inner `is`/else chain subtracts
  // toward a single variant), `==` pins `null`. The 1-struct niche (`S | null`) is
  // excluded — it is a nullable REF, not a box, and keeps its existing lowering.
  const snm = structUnionNullCmpName(condIx, fnIx)
  if snm != "" {
    const scn = P.nodes[condIx]
    if scn is BinExpr {
      if scn.binOp == "==" {
        // Pinning `v` to `null` is not a strip — skipped for a strip-only consumer.
        if narrowStripNullOnly { return false }
        pushNarrow(snm, "null")
        return true
      }
      const ssid = currentStructNarrowSetIdOf(snm, fnIx)
      if pushNarrowComplement(snm, ssid, "null") != "" { return true }
      const srest = removeAtomFromSet(
        currentStructNarrowSetOf(snm, fnIx),
        "null",
      )
      if srest != "" {
        pushNarrow(snm, srest)
        return true
      }
    }
  }
  false
}

// The NON-NULL operand of a `x == null` / `x != null` comparison at `condIx` (parens
// peeled, either operand order), or -1 when `condIx` is not a null compare. The ONE home
// for that extraction, which the three narrowing selectors below and the emitter's own
// null-test routing each wrote out by hand — and it is a GRAMMAR question (which side is
// the literal), not a per-rep one, so a rep added to one selector cannot get the peel
// subtly different from its siblings.
function nullCmpRefOf(condIx: i32) {
  const c = P.nodes[condIx]
  if c is BinExpr {
    if c.binOp == "==" || c.binOp == "!=" {
      const lhs = P.nodes[unwrapParen(c.binLeft)]
      const rhs = P.nodes[unwrapParen(c.binRight)]
      if rhs is NullLit { return unwrapParen(c.binLeft) }
      if lhs is NullLit { return unwrapParen(c.binRight) }
    }
  }
  -1
}

// The receiver NAME when the condition at `condIx` is `<ident> == null` /
// `<ident> != null` over a BOXED STRUCT union (2+ struct variants plus a `null`
// member), else "". The value-union and 1-struct-niche forms are excluded (each
// keeps its own narrowing path).
function structUnionNullCmpName(condIx: i32, fnIx: i32) {
  const c = P.nodes[condIx]
  if c is BinExpr {
    if c.binOp == "==" || c.binOp == "!=" {
      const refIx = nullCmpRefOf(condIx)
      if refIx >= 0 {
        const r = P.nodes[refIx]
        if r is Ident {
          const un = unionNameOfIdentSid(sidOfNode(refIx), fnIx)
          if un != "" {
            if !isValueUnionName(un) {
              const uset = unionMemberSetOf(un)
              if unionSetHasNull(uset) && unionSetNonNullCount(uset) >= 2 {
                return r.identName
              }
            }
          }
        }
      }
    }
  }
  ""
}

// The receiver NAME when the condition at `condIx` is `<ident> == null` /
// `<ident> != null` over a boxed VALUE union, else "". (A struct union / niche
// nullable keeps its existing lowering and narrowing behavior.)
function valueUnionNullCmpName(condIx: i32, fnIx: i32) {
  const c = P.nodes[condIx]
  if c is BinExpr {
    if c.binOp == "==" || c.binOp == "!=" {
      const refIx = nullCmpRefOf(condIx)
      if refIx >= 0 {
        const r = P.nodes[refIx]
        if r is Ident {
          const un = unionNameOfIdentSid(sidOfNode(refIx), fnIx)
          if un != "" {
            if isValueUnionName(un) { return r.identName }
          }
        }
      }
    }
  }
  ""
}

// The ELSE-branch dual of `setNarrowFromCond`, for VALUE unions only: the guard
// was FALSE there, so `is T` strips `T` from the current set (a 2-member union
// fully discriminates — `string | i32` minus `i32` is `string`, which unboxes),
// `== null` strips `null`, and `!= null` pins `null`. Struct unions keep their
// existing (no else-narrowing) behavior — their member reads must not change.
export function setNarrowFromCondElse(condIx0: i32, fnIx: i32) {
  // Peel `Paren` exactly like `setNarrowFromCond` — the else-arm of `if (x is A)`
  // complement-narrows the same as the bare spelling.
  const condIx = unwrapParen(condIx0)
  const c = P.nodes[condIx]
  // The else of `x is null` STRIPS null (that is how `!(e is null)` narrows); the else of
  // `x is T` subtracts `T`, which pins a variant. A strip-only consumer keeps the former.
  if c is IsExpr && (c.isVariant == "null" || !narrowStripNullOnly) {
    if valueAtomKind(c.isVariant) >= 0 {
      const recv = P.nodes[unwrapParen(c.isObj)]
      if recv is Ident {
        const un = unionNameOfIdent(recv.identName, fnIx)
        if un != "" {
          if isValueUnionName(un) {
            const esid = currentNarrowSetIdOf(recv.identName, fnIx)
            if pushNarrowComplement(recv.identName, esid, c.isVariant) != "" {
              return true
            }
            const rest = removeAtomFromSet(
              currentNarrowSetOf(recv.identName, fnIx),
              c.isVariant,
            )
            if rest != "" {
              pushNarrow(recv.identName, rest)
              return true
            }
          }
        }
      }
      // `o.y is T` over a UNION-typed struct FIELD: the guard was FALSE there, so
      // `T` is stripped from the path's current set — a 2-member field union fully
      // discriminates (`string | i32` minus `i32` reads as `string`), unboxing the
      // else-arm's `o.y` under the same path key `setNarrowFromCond` pushes.
      if recv is Member {
        const mun = memberUnionFieldName(unwrapParen(c.isObj), fnIx)
        if mun != "" {
          const mk = memberPathKeyOf(unwrapParen(c.isObj))
          if mk != "" {
            let mcur = ""
            let msid = -1
            // The member PATH's own narrowing stack slot carries both its rendered
            // current set and that set's identity — one walk answers both.
            const mslot = narrowSlotOf(mk)
            if mslot >= 0 {
              mcur = narrowVariants[mslot]
              msid = narrowSets[mslot]
            } else {
              mcur = unionMemberSetOf(mun)
              msid = msSetOfText(mcur)
            }
            if pushNarrowComplement(mk, msid, c.isVariant) != "" { return true }
            const mrest = removeAtomFromSet(mcur, c.isVariant)
            if mrest != "" {
              pushNarrow(mk, mrest)
              return true
            }
          }
        }
      }
      // A MIXED union — struct arm(s) alongside the tested VALUE atom (`{f: i32} |
      // i32`) — is NOT a value union, so the Ident arm above skipped it. Fall
      // THROUGH to the struct-union complement below: the guard was false, so
      // subtracting the tested atom leaves the struct arm(s), and the else-arm's
      // `v.f` reads through the same narrowed-member downcast the positive arm
      // uses. (The #923-observed hole: the checker's subtract-narrow answered the
      // struct, but the emitter never registered the negative arm — a GLOBAL
      // receiver's `v.f` then read the box RAW, invalid wasm; a local rejected
      // loudly. Both spellings now narrow.) Anything else keeps the reject.
      let elseMixed = false
      if recv is Ident {
        const mxun = unionNameOfIdent(recv.identName, fnIx)
        if mxun != "" {
          if !isValueUnionName(mxun) { elseMixed = true }
        }
      }
      if !elseMixed { return false }
    }
    // STRUCT-union complement (host flow narrowing): the guard was FALSE, so the
    // tested VARIANT is stripped from the receiver's current set. When one member
    // remains, the else-arm fully discriminates (`if v is A {…} else { v.y }`
    // reads `v` as the `B` variant); a multi-member rest ("N2|N3") keeps a later
    // `else if` arm subtracting toward its own singleton. Only a BOXED struct
    // union narrows (`exprUnion` — the 1-struct niche is a nullable ref, whose
    // member reads must not change).
    const srecv = P.nodes[unwrapParen(c.isObj)]
    if srecv is Ident {
      if exprUnion(c.isObj, fnIx) {
        const ssid = currentStructNarrowSetIdOf(srecv.identName, fnIx)
        if pushNarrowComplement(srecv.identName, ssid, c.isVariant) != "" {
          return true
        }
        const srest = removeAtomFromSet(
          currentStructNarrowSetOf(srecv.identName, fnIx),
          c.isVariant,
        )
        if srest != "" {
          pushNarrow(srecv.identName, srest)
          return true
        }
      }
    }
    return false
  }
  // `a || b` composes in the ELSE direction, the exact dual of `setNarrowFromCond`'s
  // `&&` conjunct recursion: the else-arm ran because BOTH disjuncts were false, so it
  // sees both of their else-narrowings. Without it a third disjunct saw nothing —
  // `e == null || g() || e >= 0` and its guard spelling
  // `if e == null || g() { return true } return e >= 0` (reached through
  // `pushPostGuardNarrow`) both pushed the raw box under `i32.ge_s`. The pushes stack;
  // the caller's save/restore of `narrowTop` unwinds them together.
  if c is BinExpr {
    if c.binOp == "||" {
      const el = setNarrowFromCondElse(c.binLeft, fnIx)
      const er = setNarrowFromCondElse(c.binRight, fnIx)
      return el || er
    }
  }
  // `!cond` in the ELSE-arm: the inner condition was TRUE there, so the else sees
  // the inner condition's THEN-narrowing (`if !(n is Program) {…} else { n.progStmts }`).
  if c is Unary {
    if c.unOp == "!" { return setNarrowFromCond(unwrapParen(c.unArg), fnIx) }
  }
  const nm = valueUnionNullCmpName(condIx, fnIx)
  if nm != "" {
    const cn = P.nodes[condIx]
    if cn is BinExpr {
      if cn.binOp == "!=" {
        // The else of `x != null` pins `null`, not a strip.
        if narrowStripNullOnly { return false }
        pushNarrow(nm, "null")
        return true
      }
      const nsid = currentNarrowSetIdOf(nm, fnIx)
      if pushNarrowComplement(nm, nsid, "null") != "" { return true }
      const rest = removeAtomFromSet(currentNarrowSetOf(nm, fnIx), "null")
      if rest != "" {
        pushNarrow(nm, rest)
        return true
      }
    }
  }
  // The MEMBER-PATH dual of the arm above, and the complement of `setNarrowFromCond`'s
  // own member channel: in the else of `w.f != null` the field IS `null`; in the else of
  // `w.f == null` it is the non-null member set, which is what unboxes the else-arm's
  // `w.f` reads. Both branch senses of both spellings must narrow, or the one left out is
  // `vl check`-clean invalid wasm on the very program whose sibling spelling is correct —
  // `if w.f == null { … } else { print(w.f) }` was exactly that residue after the
  // then-side channel landed.
  const emnull = nullCmpRefOf(condIx)
  if emnull >= 0 {
    if P.nodes[emnull] is Member {
      const emfn = memberUnionFieldName(emnull, fnIx)
      if emfn != "" && isValueUnionName(emfn) {
        const emk = memberPathKeyOf(emnull)
        if emk != "" {
          const emcn = P.nodes[condIx]
          if emcn is BinExpr {
            if emcn.binOp == "!=" {
              pushNarrow(emk, "null")
              return true
            }
            const emrest = removeAtomFromSet(unionMemberSetOf(emfn), "null")
            if emrest != "" {
              pushNarrow(emk, emrest)
              return true
            }
          }
        }
      }
    }
  }
  // The struct-union dual: in the else of `v != null` the value IS `null`; in the
  // else of `v == null` it is the non-null variant set.
  const snm = structUnionNullCmpName(condIx, fnIx)
  if snm != "" {
    const scn = P.nodes[condIx]
    if scn is BinExpr {
      if scn.binOp == "!=" {
        // The else of `v != null` pins `null`, not a strip.
        if narrowStripNullOnly { return false }
        pushNarrow(snm, "null")
        return true
      }
      const ssid = currentStructNarrowSetIdOf(snm, fnIx)
      if pushNarrowComplement(snm, ssid, "null") != "" { return true }
      const srest = removeAtomFromSet(
        currentStructNarrowSetOf(snm, fnIx),
        "null",
      )
      if srest != "" {
        pushNarrow(snm, srest)
        return true
      }
    }
  }
  false
}

// Rewind the narrowing stack depth back to `n` (drop bindings a branch pushed). The
// arrays keep their backing slots — only the logical depth changes, so no `.pop()`.
export function restoreNarrow(n: i32) {
  narrowTop = n
  0
}

// After a GUARD `if` — one with NO else whose then-branch always LEAVES the path — the
// rest of the enclosing block only runs when the guard was FALSE, so it sees
// the same complement narrowing an explicit else-arm would (the host's flow
// narrowing after an early return): `if x is boolean { return 0 } return x`
// reads `x` as the unboxed `i32` below the guard. Pushes via
// `setNarrowFromCondElse` (VALUE unions only — struct unions keep their
// no-else-narrowing behavior); the CALLER restores the depth at block exit.
//
// `break`/`continue` leave the path exactly as `return` does, and inside a LOOP body they
// are how a guard clause is spelled (`while … { if e == null { break } … e + 1 … }`). The
// checker post-narrows all three (`checkIfStmtNode`), so both tests are asked here — a
// `return`-only gate left the loop spelling check-clean and invalid.
export function pushPostGuardNarrow(stmtIx: i32, fnIx: i32) {
  const s = P.nodes[stmtIx]
  if s is IfStmt {
    if s.ifElse < 0 {
      if blockAlwaysReturns(s.ifThen) || blockLastStmtExits(s.ifThen) {
        setNarrowFromCondElse(s.ifCond, fnIx)
      }
    }
  }
  // ASSIGNMENT narrowing (A-infer-null, the host's `assignmentNarrowing`): a
  // straight-line `x = <non-null expr>` over a null-bearing VALUE union makes
  // `x` provably non-null for the REST of the enclosing block — `let x = null;
  // x = 5; x + 1` reads the unboxed i32 with no null tax. Emitted only for a
  // plain `=` to a bare name whose RHS is itself non-null (a `x = maybeNull()`
  // RHS, or a bare `null`, leaves `x` un-narrowed). The CALLER restores the
  // depth at block exit, so a branch-local assignment never leaks past the join.
  if s is BinExpr {
    if s.binOp == "=" {
      const tgt = P.nodes[s.binLeft]
      if tgt is Ident {
        const un = unionNameOfIdentSid(sidOfNode(s.binLeft), fnIx)
        if un != "" && isValueUnionName(un) && unionSetHasNull(un) {
          const rhs = P.nodes[unwrapParen(s.binRight)]
          let rhsNullable = false
          if rhs is NullLit { rhsNullable = true }
          const rn = unionNameOfExpr(s.binRight, fnIx)
          if rn != "" {
            // NOT migrated: the RHS union name here is never a covered member SET
            // on any measured surface (0 of 1,269 corpus files, 0 of 25,200 fuzz
            // programs), so it keeps the member-name scan (method note 6).
            if unionHasAtom(rn, "null") { rhsNullable = true }
          }
          if !rhsNullable {
            const asid = msSetOfText(un)
            if pushNarrowComplement(tgt.identName, asid, "null") == "" {
              pushNarrow(tgt.identName, removeAtomFromSet(un, "null"))
            }
          }
        }
      }
    }
  }
  0
}

export function forInElemKind(iterIx: i32, fnIx: i32): VKind | null {
  const e = P.nodes[iterIx]
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Member {
      if exprMap(callee.memObj, fnIx) {
        // A map's KEYS bind at the KEY's kind: string for the string-keyed rep, i32 for
        // the i32-keyed one. A Set's `.values()` yields its ELEMENTS, so it asks the same
        // question — the two `"str"` answers below are the string-keyed half of a pair.
        const kk = mapShapeOfExpr(callee.memObj, fnIx)
        if callee.memProp == "keys" {
          if mapShapeKeyI32(kk) { return "i32" }
          return "str"
        }
        if callee.memProp == "values" {
          if kk == -5 { return "i32" }
          // A SET's `.values()` yields its ELEMENTS — the string keys (kind 3),
          // not the i32 membership booleans. A map's yields its VALUES: i32 for
          // the mono map, the value's kind for a ref-valued map (string 3 /
          // struct 1 — the loop var binds that kind).
          if mapIsSetExpr(callee.memObj, fnIx) { return "str" }
          const vsl = mapShapeOfExpr(callee.memObj, fnIx)
          if vsl >= 0 {
            if mvValKind[vsl] == 3 {
              // A NULLABLE string value (`{[string]: string | null}`) rides the SAME kind-3
              // vals list its non-null twin does — the vals element slot is
              // `(ref null $aTypeIdx)` either way — so only the LOOP VAR differs: kind 16,
              // the `string | null` niche, exactly as `const v = m[k]` binds. The non-null
              // `"str"` loop var recovers each element `ref.as_non_null` and would TRAP on a
              // stored null, and its `v != null` finds no nullable rep to test
              // (`bare null needs a struct-typed context`). One `for` must bind what one
              // index read yields — the rule the LIST ladder below states for `(string|null)[]`.
              if mvSlotNullable(vsl) { return "nulstr" }
              return "str" // string value
            }
            if mvValKind[vsl] == 11 {
              return "f64" // f64 value (scalar local)
            }
            if mvValKind[vsl] == 10 {
              return "i64" // i64 value (scalar local)
            }
            if mvValKind[vsl] == 13 {
              return "f32" // f32 value (scalar local)
            }
            if mvValKind[vsl] == 14 {
              return "closure" // closure value (`{[string]: (i32) => i32}` — loop var calls each)
            }
            // A LIST value (`{[string]: i32[]}` / `f64[]` / `S[]` …): the loop var binds the inner
            // VALUE LIST, exactly as a nested-array `for row in g` over `i32[][]` does — its
            // loop-var kind is the value-list's rep (`mvListValKind` → 2/7/12/20/21, or 5 for a
            // struct/ref list). The `#l` temp is the vals ref-list wrapper (`forInMapValsSlot`).
            if mvValKind[vsl] == 6 { return mvListValKind(vsl) }
            // A UNION-BOX value (`{[string]: i32 | null}`, `{[string]: C | S}`, a numeric
            // litunion `{[string]: 1 | 2 | null}`): the vals element IS `$uBox`, so the loop
            // var binds as a kind-4 union-box local — the SAME arm the ref-list ladder below
            // gives a `(C | S)[]` element. Without it the box fell to `"struct"` and the slot
            // resolution answered -1 (`ref valtype with no interned shape`).
            if mvValKind[vsl] == 2 { return "union" }
            // A NULLABLE-STRUCT value (`{[string]: S | null}`) rides the same kind-1 vals list
            // as its non-null twin, with a `(ref null $S)` element slot: the loop var is the
            // kind-9 niche, the map twin of the `(P | null)[]` element arm below. The non-null
            // `"struct"` loop var recovers each element and its `v != null` reached the
            // structural struct-equality path instead of a null test.
            if mvSlotNullable(vsl) { return "nulstruct" }
            return "struct" // struct value
          }
          return "i32"
        }
      }
    }
  }
  // A bare MAP iterable (`for k in m`) iterates its KEYS — like `m.keys()`: string for
  // the string-keyed rep (kind 3), i32 for the i32-keyed one.
  if exprMap(iterIx, fnIx) {
    const bk = mapShapeOfExpr(iterIx, fnIx)
    if mapShapeKeyI32(bk) { return "i32" }
    return "str"
  }
  // A `(string | null)[]` — the string-ref NICHE list. Its backing IS a plain string list,
  // but the element slot is `(ref null $aTypeIdx)`, so the loop var binds the NULLABLE
  // string (kind 16), exactly as `const e = xs[i]` does through `emitIndex`'s dedicated
  // nulstr arm. Checked BEFORE `exprStringArray`, which claims the same backing for a
  // NON-null element and would hand the loop var a `(ref $aTypeIdx)` slot — the read then
  // recovers non-null and TRAPS on a null element, and the loop var's `!= null` finds no
  // nullable rep to test (`bare null needs a struct-typed context`). One `for` must bind
  // what one index read yields.
  if exprNulStrArray(iterIx, fnIx) { return "nulstr" }
  if exprStringArray(iterIx, fnIx) { return "str" }
  // A STRUCT-element ref list (`S[]`): the element is a struct ref, so bind the loop
  // var as a code-`1` struct local. (Union-box (`2`) / map-array ref lists are not
  // yet supported here — they fall through to the unsupported -1.)
  if exprRefArray(iterIx, fnIx) {
    const rslot = refListSlotOfExpr(iterIx, fnIx)
    if rlElemKindTbl[rslot] == 1 {
      // A NULLABLE-struct element ref list (`(P | null)[]`, slot key "P | null"): the loop var
      // binds as a kind-9 niche (`for e in xs { if e != null { … e.v … } }`), and the element
      // read stays nullable (no `ref.as_non_null`). A plain `S[]` is the non-null kind 1.
      if rlElemIsNulNiche(rslot) { return "nulstruct" }
      return "struct"
    }
    // A UNION-box element ref list (`(C | S)[]`, kind 2): the loop var binds as a kind-4
    // union-box local (the element-kind code IS the loop-var local kind, as struct's `1` is),
    // so `for x in arr { … x is S … }` narrows each element. The `#l` temp is the ref-list
    // wrapper (code 5), same as the struct case.
    if rlElemKindTbl[rslot] == 2 { return "union" }
    // A NESTED-ARRAY element ref list (`i32[][]`/`string[][]`/`f64[][]`/`i64[][]`, element kind
    // 4/6/7/8 = the inner list wrapper): the loop var binds the INNER LIST — a list local of
    // kind 2/7/12/20 (i32/string/f64/i64 list). The element read is a ref (the inner wrapper,
    // recovered non-null), like the struct case; the `#l` temp is the outer ref-list wrapper.
    if rlElemKindTbl[rslot] == 4 {
      // A `(i32[] | null)[]` keeps the `| null` in its element SLOT (the interned
      // `rlElemNullable` bit), so the loop var is the kind-15 NULLABLE list — the same rep
      // `const e = xs[i]` binds through `exprNullableList`'s kind-4 Index arm. Without it the
      // loop var claimed the non-null list: the element read recovered `ref.as_non_null` and
      // TRAPPED on a null row, and `x != null` found no nullable rep to test. Mirrors the
      // `nulstruct` / `nulstr` niches above.
      if rlElemIsNulNiche(rslot) { return "nullist" }
      return "list"
    }
    if rlElemKindTbl[rslot] == 6 { return "strlist" }
    if rlElemKindTbl[rslot] == 7 { return "f64list" }
    if rlElemKindTbl[rslot] == 8 { return "i64list" }
    if rlElemKindTbl[rslot] == 10 {
      return "f32list" // f32-inner list -> an f32-list local (kind 21)
    }
    // A CLOSURE-element ref list (`((i32) => i32)[]`, element kind 5): the loop var binds as a
    // kind-14 closure local — `for f in fs { … f(x) … }` calls each via `call_ref`. The element
    // read recovers the closure ref non-null (like a struct); the `#l` temp is the ref-list
    // wrapper (code 5).
    if rlElemKindTbl[rslot] == 5 { return "closure" }
    // A NESTED REF array (`S[][]`/`(C|D)[][]`/`S[][][]`, element kind 9): the loop var binds the
    // INNER REF LIST — a kind-5 ref-list local carrying the inner slot. `for row in g { … row[j]
    // … }` then indexes/iterates it. The element read recovers the inner wrapper non-null; the
    // `#l` temp is the outer ref-list wrapper. Recurses (the inner slot may itself be kind 9).
    if rlElemKindTbl[rslot] == 9 { return "reflist" }
    return null
  }
  // An f64 element list (`f64[]`): the loop var binds as a scalar f64 local (code 11, the
  // same code a `let x: f64` uses, so `fbValtype` types it `0x7c` automatically), and the
  // `#l` temp is the f64-list (code 12). Recognized through `exprF64Array`, which trusts the
  // checker's recorded type, so an `f64[]`-returning call iterates too. Checked before the
  // i32 default (an f64 element is not an i32).
  // An f32 element list (`f32[]`): the loop var binds as a scalar f32 local (code 13).
  if exprF32Array(iterIx, fnIx) { return "f32" }
  if exprF64Array(iterIx, fnIx) { return "f64" }
  // An i64 element list (`i64[]`): the loop var binds as a scalar i64 local (code 10), and
  // the `#l` temp is the i64-list (code 20).
  if exprI64Array(iterIx, fnIx) { return "i64" }
  // A STRING iterable (`for ch in s`): each code unit is an i32 (loop-var code 0, same as an
  // `i32[]`), but the source is the RAW i32 array — the `#l` temp is the string itself (code 3),
  // and the length/element reads skip the list-wrapper `struct.get`. `forInStringSrc` flags it
  // at the temp-kind and emit sites. Checked before `exprArray` (a string is not an i32 list).
  if exprString(iterIx, fnIx) { return "i32" }
  if exprArray(iterIx, fnIx) { return "i32" }
  return null
}

// Whether a `for v in <iter>` iterable is a STRING (`for ch in s`) — the i32-code-unit walk over
// the raw array, distinct from an `i32[]` (code 0 too) whose backing hides behind a list wrapper.
export function forInStringSrc(iterIx: i32, fnIx: i32) {
  if forInElemKind(iterIx, fnIx) != "i32" { return false }
  exprString(iterIx, fnIx)
}

// TRUE when a `for v in <iter>` walks a map's ordered VALS list (map-struct field 1)
// rather than its ordered KEYS list (field 0) — i.e. a `.values()` call on a map that
// is NOT a set. A set's `.values()` yields its ELEMENTS, which live in the keys list,
// so it walks keys exactly like `.keys()` and a bare `for k in m` do.
//
// ONE HOME for the keys-vs-vals field selection of a map for-in, paired with
// `forInMapRecv`, which answers WHICH expression the receiver is. Every consumer that
// has to pick a field (the lowering) or type a loop var off the value side
// (`forInMapValsSlot`) asks through this pair, so the field a walk reads and the type
// its loop var binds can never disagree.
export function forInMapWalksVals(iterIx: i32, fnIx: i32) {
  const e = P.nodes[iterIx]
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Member {
      if callee.memProp == "values" {
        if exprMap(callee.memObj, fnIx) {
          return !mapIsSetExpr(callee.memObj, fnIx)
        }
      }
    }
  }
  false
}

// The mv SLOT of a `for v in m.values()` walk over a REF-VALUED map, or -1 (not a
// map walk / a mono map / a set). The values walk then types its loop var + list
// temp off the slot's value type instead of a ref-array's element.
export function forInMapValsSlot(iterIx: i32, fnIx: i32) {
  if !forInMapWalksVals(iterIx, fnIx) { return -1 }
  // A MONO-value map interns no slot — its shape is one of the negative sentinels
  // (`-1` mono, `-4` i32-keyed mono), and every one of them answers "no slot" here.
  const sl = mapShapeOfExpr(forInMapRecv(iterIx, fnIx), fnIx)
  if sl < 0 { return -1 }
  sl
}

// The element struct TABLE INDEX of a `for v in <S[]>` iterable (the struct that the
// code-`1` loop var binds), or -1 when the iterable is not a struct ref list. Mirrors
// the index-read resolution (`structIndexOfExpr` over `xs[i]`): the element name comes
// from the ref-list slot, then its struct table index. A STRUCT-VALUED map's
// `.values()` walk binds the slot's value struct.
export function forInRefArrayStructIdx(iterIx: i32, fnIx: i32) {
  const mvs = forInMapValsSlot(iterIx, fnIx)
  if mvs >= 0 {
    if mvValKind[mvs] == 1 { return mvValStructIdx[mvs] }
    return -1
  }
  if !exprRefArray(iterIx, fnIx) { return -1 }
  // Strip a `| null` niche suffix (`(P | null)[]` → "P") so the nullable-struct loop var
  // carries P's struct index.
  structIdxOfElemName(refListElemNameOfExpr(iterIx, fnIx))
}

// True if the map-typed expression at `exprIx` is a SET (`Set()`-seeded binding or
// the constructor itself). Consulted by the `.values()` paths: a set's `.values()`
// yields its ELEMENTS (the keys list), not the membership booleans in `vals` —
// mirroring the checker (`typecheck.vl`: a set's values() returns `mKey[]`).
// Params have no Set-distinguishing annotation, so a set passed as a parameter is
// out of scope (the checker's surface gating keeps `.values()` calls on it valid
// only for sets, but the flavor bit can't cross the call boundary yet).
export function mapIsSetExpr(exprIx: i32, fnIx: i32) {
  mapShapeOfExpr(exprIx, fnIx) == -2
}

// The mv SLOT a map READ expression resolves to: `m[k]` (Index over a ref-valued
// map) or `m.get(k)` (the method form), else -1. The chokepoint the expression-kind
// resolvers (`exprString` / struct resolution / `??` lowering) consult so a
// ref-valued `m[k] ?? d` classifies as its VALUE type.
function mapReadMvSlot(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[exprIx]
  if e is Index {
    if exprMap(e.idxArr, fnIx) {
      const sl = mapShapeOfExpr(e.idxArr, fnIx)
      if sl >= 0 { return sl }
      return -1
    }
    // Narrowing-blind fallback: `t0[k]` where `t0` is a union IDENT whose union has a MAP
    // arm (`{[string]: (() => i64) | string} | {w: i32}`). In the frame pre-pass the
    // `is`-narrow that makes `t0` a map is not active, so `exprMap` misses — resolve the
    // arm's VALUE mv slot directly. Without this a `const t1 = t0[k] ?? d; t1()` never
    // classified `t1` as the value union, `calleeIsUnionClosureIdent` missed its closure
    // arm, and the narrowed `call_ref`'s closure spill landed on the UNRESERVED
    // `callRefSlot` index — shared with the mv map frame's `mapRef` local (invalid wasm).
    const ax = P.nodes[unwrapParen(e.idxArr)]
    if ax is Ident {
      const aun = unionNameOfIdent(ax.identName, fnIx)
      if aun != "" {
        // The arm's ARENA type comes back with its spelling (D-MVSLOTFIND), so the
        // value slot resolves off the `TyMap` the member scan already read instead of
        // re-slicing `V` out of the rendered arm. An arena-blind row pushes nothing and
        // the name leg below `mvSlotOfMapNameTy` answers exactly as before.
        const armTy: i32[] = []
        const ma = unionMapArmNameTy(aun, armTy)
        if ma != "" {
          let maVt = -1
          if armTy.length > 0 { maVt = tyMapValOf(armTy[0]) }
          const msl = mvSlotOfMapNameTy(ma, maVt)
          if msl >= 0 { return msl }
        }
      }
    }
    return -1
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Member {
      if callee.memProp == "get" {
        if exprMap(callee.memObj, fnIx) {
          const sl = mapShapeOfExpr(callee.memObj, fnIx)
          if sl >= 0 { return sl }
        }
      }
    }
  }
  -1
}

// The mv slot of a `lhs ?? d` READ-WITH-DEFAULT over a ref-valued map, else -1. Parens are peeled on
// BOTH the whole expression and the LHS so a `(m[k]) ?? d` classifies its VALUE type identically to
// the bare form — the classifier must agree with the `??` emit (which also peels parens), else a
// parenthesized string/f64/struct map-get is emitted as its real type but the print/coerce routing
// defaults it to i32 (invalid wasm).
function coalesceMvSlot(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is BinExpr {
    if e.binOp == "??" { return mapReadMvSlot(unwrapParen(e.binLeft), fnIx) }
  }
  -1
}

// True when a `m[k] ?? d` read over a NULLABLE-value map (slot `cns`) STAYS nullable — i.e.
// the DEFAULT `d` is itself nullable (a bare `null`, or a nullable-typed default). `??`
// coalesces on the read VALUE being null — a STORED null included — so a NON-null default
// collapses the whole read to the value's NON-null kind (USER SEMANTICS RULING 2026-07-23);
// only a nullable default leaves it `V | null`. Every `??`-over-value-map classifier gates on
// this: the nullable-kind arms require it, the non-null-kind arms require its negation.
export function coalesceStaysNullable(exprIx: i32, cns: i32, _fnIx: i32) {
  if cns < 0 { return false }
  if !mvSlotNullable(cns) { return false }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is BinExpr {
    if e.binOp == "??" {
      const d = P.nodes[unwrapParen(e.binRight)]
      if d is NullLit { return true }
      return nodeTyIsNullable(e.binRight)
    }
  }
  false
}

// THE ONE NULLABILITY DECISION for the NON-map `??` reps — the value-union BOX
// (`i32 | null`, `f64 | null`) and the nullable-STRUCT niche (`S | null`) — and the same
// user-semantics ruling `coalesceStaysNullable` states for the map-value dual: `??` coalesces
// on the LHS being null, so a NON-null default collapses the read to the residual non-null rep
// (the unboxed scalar / the `(ref $S)`), while a NULLABLE default leaves the result `T | null`.
// Every one of those arms hard-coded the residual rep, so a nullable default met a non-null
// block type — `vl check`-clean invalid wasm where the consumer declared the nullable rep, and
// a loud "bare null needs a struct-typed context" / "struct equality is not supported yet"
// where the consumer INFERRED its cell from the same wrong answer.
//
// STRUCTURAL IN THE CHAIN, NEVER BANKED. A chained `p ?? q ?? r` re-associates to
// `p ?? (q ?? r)` through `mkBinary(…, -1)`, and that synthesized inner node has NO banked
// type — so `nodeTyIsNullable` of the DEFAULT answers "non-null" for every chain and declares
// a non-null block around a nullable one. The `??` arm recurses to the chain's LAST default,
// which is always a real source node, so both spellings are covered by construction. This is
// the discipline `coalesceNulStrStaysNullable`'s header states for the `string | null` rep,
// which asks `exprNullableString` of the `??` NODE for exactly the same reason.
//
// The rep-side dual (`unionSetHasNull`) is asked BESIDE the banked type, not instead of it: a
// nullable default the checker banked no `TyNullable` for (a declared union alias, whose arena
// entry is `TyUnion[T, null]`) still has `null` in its member set.
export function coalesceDefaultNullable(defIx: i32, fnIx: i32): boolean {
  if defIx < 0 { return false }
  const dix = unwrapParen(defIx)
  const d = P.nodes[dix]
  if d is NullLit { return true }
  if d is BinExpr {
    if d.binOp == "??" { return coalesceDefaultNullable(d.binRight, fnIx) }
  }
  if nodeTyIsNullable(dix) { return true }
  const un = unionNameOfExpr(dix, fnIx)
  if un != "" { return unionSetHasNull(un) }
  false
}

// The LHS PLACE of a non-map `??`, or -1 when `exprIx` is not a `??` — the CONSUMER-side hook
// of every nullable-niche `??` arm, and the counterpart of `coalesceMvSlot` (which is the same
// hook for the FUSED map-get spellings).
//
// `p ?? d` carries the LHS's REP in both halves — an `i32[] | null` coalesced with a list is
// still the i32-list wrapper, a `K | null` coalesced with a member is still the atom i32 — and
// `coalesceDefaultNullable` alone decides WHICH HALF. So a classifier for the rep asks this and
// ignores the half; one for the NULLABLE half asks this and then `coalesceDefaultNullable`.
// Getting the rep question and the half question from two homes is how a consumer bound a plain
// i32 cell for a `K | null ?? "a"` result and PRINTED THE INTERNED ID.
export function coalesceNicheLhs(exprIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is BinExpr {
    if e.binOp == "??" { return e.binLeft }
  }
  -1
}

// The HALF a non-map `??` result lands in — `true` the NULLABLE half, `false` the non-null one
// (and `false` for a node that is not a `??`, which no caller asks). `coalesceDefaultNullable`
// stays THE nullability decision; this is only its `??`-node accessor, so a consumer classifier
// reaches the default without re-deriving its arena index beside `coalesceNicheLhs`.
export function coalesceNicheStaysNullable(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is BinExpr {
    if e.binOp == "??" { return coalesceDefaultNullable(e.binRight, fnIx) }
  }
  false
}

// True when the DEFAULT of a `K | null` `??` reps as that niche's own i32 — a bare `null` (the
// `-1` sentinel), an ATOM place / field / call, another `K | null`, a MEMBER literal, or,
// structurally, a chain of those.
//
// STRUCTURAL IN THE CHAIN, NEVER BANKED — the discipline `coalesceDefaultNullable`'s header
// states, and for the same reason: the re-association mints a `??` node carrying no type at all,
// so a banked answer says "not an atom" about every chained default.
//
// A member LITERAL is decided by LEXEME MEMBERSHIP (`litLexIsMember`, the same test the
// atom-valued-MAP `??` default already uses), which is the only leg that can say no:
// `exprIsLitAtom` has no `StrLit` arm, so `"aa"` and `"zz"` are indistinguishable to it while only
// one of them is this niche's i32. The lexeme, not the banked type — a member literal in a DEFAULT
// position carries the JOIN's type, not a `TyLit`, so a banked answer declines `"aa"` too.
function coalesceLitUnionDefaultIsAtom(defIx: i32, texts: string[], fnIx: i32) {
  if defIx < 0 { return false }
  const dix = unwrapParen(defIx)
  const d = P.nodes[dix]
  if d is NullLit { return true }
  if d is StrLit { return litLexIsMember(d.strText, texts) }
  if d is BinExpr {
    if d.binOp == "??" {
      if !coalesceLitUnionDefaultIsAtom(d.binLeft, texts, fnIx) { return false }
      return coalesceLitUnionDefaultIsAtom(d.binRight, texts, fnIx)
    }
  }
  exprIsLitAtom(dix, fnIx)
}

// True when the `??` at `exprIx` lowers as the `K | null` ATOM NICHE: its LHS is that niche AND
// its default reps as the same i32.
//
// THE DEFAULT DECIDES WHETHER THE REP SURVIVES AT ALL, not merely its nullability. `k ?? "zz"`
// over `type K0 = "aa" | "bb"` joins the result to `string`, whose rep is a heap array — the atom
// lowering would leave a `(ref $array)` in an i32 blocktype and the `print` widen would have no
// member texts for the join. So a NON-atom default (a non-member literal, a `string` place)
// declines here and keeps the loud emit reject `maps/error-nonmap-coalesce.vl` pins; without the
// decline that reject would have become `vl check`-clean invalid wasm.
//
// ONE HOME FOR THE EMIT ARM AND BOTH CONSUMER HALVES, because they must agree exactly: an emit
// arm that declines while `exprIsLitAtom` still claims an atom cell is how `print(k ?? "zz")`
// stopped reporting the `??` reject and started reporting a downstream "carries no member texts".
export function coalesceLitUnionFits(exprIx: i32, fnIx: i32) {
  const lhs = coalesceNicheLhs(exprIx)
  if lhs < 0 { return false }
  if !exprNulLitUnion(lhs, fnIx) { return false }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is BinExpr {
    // The niche's member set: its nullable spelling first, then the bare one for an LHS whose
    // banked type the narrow already collapsed.
    let lut = nodeNulLitUnionMemberTexts(lhs)
    if lut.length == 0 { lut = nodeLitUnionMemberTexts(lhs) }
    return coalesceLitUnionDefaultIsAtom(e.binRight, lut, fnIx)
  }
  false
}

// The list-element rep (2/7/12/20 — see `mvListValKind`) of a bare `m[k]` or `m[k] ?? d`
// read over a list-VALUED map, else -1. The single classifier hook each `expr*Array` uses to
// claim a list-valued-map read of its own element type.
function mapReadListKind(exprIx: i32, fnIx: i32): VKind | null {
  const cm = coalesceMvSlot(exprIx, fnIx)
  if cm >= 0 { return mvListValKind(cm) }
  return mvListValKind(mapReadMvSlot(exprIx, fnIx))
}

// The map RECEIVER arena index of a `for v in m.keys()` / `m.values()` iterable, or -1
// when the iterable is not a map keys/values walk. Drives the tombstone-aware skip in
// the for-in loop (the map's `live` array is consulted per entry).
export function forInMapRecv(iterIx: i32, fnIx: i32) {
  const e = P.nodes[iterIx]
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Member {
      if callee.memProp == "keys" || callee.memProp == "values" {
        if exprMap(callee.memObj, fnIx) { return callee.memObj }
      }
    }
  }
  // A bare map iterable (`for k in m`) IS its own receiver — the live-skip walks it.
  if exprMap(iterIx, fnIx) { return iterIx }
  -1
}

export function fnRetNullBearing(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if !(fn is FuncDecl) { return false }
  const r = fn.fnRet
  if tyIsNulBool(r) { return true }
  if retNulStringFlag(r) == 1 { return true }
  if retNulRefFlag(r) == 1 { return true }
  if retNulListFlag(r) == 1 { return true }
  if retNulMapFlag(r) == 1 { return true }
  if retUnionFlag(r) == 1 { return unionSetHasNull(tyNameOf(r)) }
  if r < 0 {
    const im = inferRetNameOf(fn.fnName)
    if isValueUnionName(im) { return unionSetHasNull(im) }
    if inferNicheNullByName(fn.fnName) != "" { return true }
  }
  false
}

// True if the statement at `stmtIx` is a BARE VALUE EXPRESSION usable as an IMPLICIT
// RETURN — a VL function whose last statement is an expression (no `return` keyword)
// yields that expression's value (the idiom every `ast.vl` constructor uses:
// `addNode(n)` / `out` as the final line). Recognized: literals, an identifier, a
// unary, a non-assignment `BinExpr`, a paren, a member / index access, an `is` guard,
// an object / array literal, and a value-returning CALL (`f(..)` whose callee is an
// Ident — NOT a `recv.push(x)` member-call, which is void). A `LetDecl`/`RetStmt`/
// `IfStmt`/`WhileStmt`/assignment/`.push` is a STATEMENT, not a tail value, so it is
// lowered normally by `emitStmt`.
export function stmtIsTailValue(stmtIx: i32, fnIx: i32) {
  const s = P.nodes[stmtIx]
  // A bare lambda tail `(a) => (b) => …` is an implicit-return VALUE (a closure), so the
  // outer arrow's body — `(b) => …` — emits as the function's result. Without this the tail
  // is mis-read as a statement, the body emits nothing, and the function is just `unreachable`.
  if s is FuncDecl { return true }
  if s is NumLit { return true }
  // A trailing `null` IS an implicit-return value (the function returns null) — seeded
  // per the return type by `emitReturnValue` (`ref.null` / sentinel / boxed null), the
  // same as `return null`. Without this a `{ … null }` tail fell through to the
  // statement path and failed `unsupported statement in body`.
  if s is NullLit { return true }
  if s is StrLit { return true }
  if s is CharLit { return true }
  if s is BoolLit { return true }
  if s is Ident { return true }
  if s is Unary { return true }
  if s is Paren { return true }
  if s is Member { return true }
  if s is Index { return true }
  if s is IsExpr { return true }
  if s is AsExpr { return true }
  if s is ObjLit { return true }
  if s is ArrayLit { return true }
  if s is BinExpr {
    if s.binOp == "=" {
      // A trailing assignment over an IDENT target IS a tail value — assignment
      // yields its RHS (DECISIONS: assignment-as-expression), so
      // `function bump() { count = count + 1 }` returns the new count. Index/
      // Member-target assignments stay statements (value form not lowered yet).
      const tgt = P.nodes[s.binLeft]
      if tgt is Ident { return true }
      return false
    }
    return true
  }
  if s is Call {
    // A value-returning call `f(..)` is a tail value; a `recv.push(x)` member-call,
    // a `print(...)`, and a call to a VOID function (`fRetVoid`) are statements.
    const callee = P.nodes[s.callFn]
    if callee is Ident {
      if callee.identName == "print" { return false }
      // The void memory intrinsics are statements, never tail values. Every store width
      // joins `__store_i32__` here the day it acquires a lowering, by MEMBERSHIP in
      // `nameIsMemStoreIntrinsic` rather than by spelling: a store as a function's
      // implicit TAIL (`function put(a: i32, v: f64) { __store_f64__(a, v) }`) leaves
      // nothing on the stack, so classifying it as the body's value emits a function
      // that promises a result and produces none — an invalid module. That was the 14th
      // of #1173's 14 cells, and the one that kept the wide widths unshipped for a PR.
      if callee.identName == "__store_i32__" { return false }
      if nameIsMemStoreIntrinsic(callee.identName) { return false }
      // The bulk pair are void for the same reason and reach here the same way —
      // `function blit(d: i32, s: i32, n: i32) { __memory_copy__(d, s, n) }` is the
      // natural spelling and it is a STATEMENT tail, not the body's value.
      if nameIsMemBulkIntrinsic(callee.identName) { return false }
      if callee.identName == "__log__" { return false }
      // The void array intrinsics likewise: `__array_copy__` yields nothing;
      // `__trap__` diverges (no value).
      if callee.identName == "__array_copy__" { return false }
      if callee.identName == "__trap__" { return false }
      const target = fnIndexOf(callee.identName)
      if target >= 0 { return fRetVoid[target] == 0 }
      // A CLOSURE-VALUE callee (a `() => void` param / a void-function binding, invisible
      // to `fnIndexOf`): a void one (`>v` sig) yields nothing, so it is a STATEMENT tail,
      // not a value — the signal that makes `run(g: () => void) { g() }` infer void.
      if fnIx >= 0 && calleeReturnsVoidSid(sidOfNode(s.callFn), fnIx) {
        return false
      }
      return true
    }
    return false
  }
  false
}

// True if the BLOCK at `blockIx` ends in a bare tail VALUE statement (an implicit
// return), as opposed to an explicit `return`/`while`/etc. — i.e. lowering it in tail
// position would need `emitStmtTail`. A nested `if`/`else` tail recurses (any arm).
export function blockTailIsValue(blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    const n = stmts.length
    if n == 0 { return false }
    const last = stmts[n - 1]
    const s = P.nodes[last]
    if s is IfStmt { return ifTailIsValue(last, fnIx) }
    return stmtIsTailValue(last, fnIx)
  }
  false
}

// True if the `if`/`else` at `stmtIx` (in tail position) has any arm that ends in a
// bare value expression rather than an explicit `return` — so it must be lowered via
// `emitIfTail`. An `if` WITHOUT an `else` can fall through with no value, so it never
// qualifies (the existing void-if path handles it). Recurses through `else if` chains.
function ifTailIsValue(stmtIx: i32, fnIx: i32) {
  const s = P.nodes[stmtIx]
  if s is IfStmt {
    // An else-less `if` NEVER qualifies here (it can fall through with no value). This is
    // load-bearing: `ifTailIsValue` feeds `blockTailIsValue` → the `fRetVoid` fixpoint in
    // `buildFnMap`, where treating a void procedure's recursive tail `if n>0 { rec(n-1) }`
    // as a value would wrongly keep it non-void. The else-less NULLABLE-return tail
    // (`function f(c) { if c then 5 }` → `i32 | null`) is handled separately at emit time
    // by `elseLessNullableTail` (gated on the FINAL nullable classification).
    if s.ifElse < 0 { return false }
    if blockTailIsValue(s.ifThen, fnIx) { return true }
    const els = P.nodes[s.ifElse]
    if els is Block { return blockTailIsValue(s.ifElse, fnIx) }
    return ifTailIsValue(s.ifElse, fnIx)
  }
  false
}

// True if the statement at `stmtIx` is a body-tail `if`/`else` whose arms yield a
// value (implicit return) and so must be lowered tail-aware by `emitIfTail`.
export function lastStmtIsValueIf(stmtIx: i32, fnIx: i32) {
  const s = P.nodes[stmtIx]
  if s is IfStmt { return ifTailIsValue(stmtIx, fnIx) }
  false
}

// True if the body-tail statement at `stmtIx` is an ELSE-LESS `if` whose then-arm yields
// a value AND function `fnIx` returns a NULLABLE type — so the false fall-through is the
// `null` of that nullable (lowered by the function-end `emitNullForRet`), exactly the
// #484 fall-through but written `if c then v` with no else. Distinct from
// `lastStmtIsValueIf`: this is consulted only at EMIT time, where `fRetVoid` is final, so
// it never perturbs the `fRetVoid` fixpoint (a void procedure's `if n>0 { rec(n-1) }`
// stays void — `fnRetNullBearing` is false for it).
export function elseLessNullableTail(stmtIx: i32, fnIx: i32) {
  const s = P.nodes[stmtIx]
  if s is IfStmt {
    if s.ifElse >= 0 { return false }
    if !blockTailIsValue(s.ifThen, fnIx) { return false }
    return fnRetNullBearing(fnIx)
  }
  false
}

// True if the function's TOP-LEVEL body block at `blockIx` ends in an instruction
// that the wasm validator treats as making the function's fallthrough UNREACHABLE —
// i.e. its last statement is an explicit `return` (`RetStmt`) or a bare tail value
// (lowered by `emitFuncBody` as `emitExpr` + `return`). In those cases the function's
// trailing `end` is reached only via the polymorphic post-`return` stack, so no
// padding is needed. Otherwise (the body ends in an `if`/`while`/assignment/`.push`
// whose own `return`s exit from INSIDE a structured block) control structurally falls
// through to `end` with an empty stack — which fails the result-type check unless an
// explicit `unreachable` precedes the `end`. The typechecker has already proven such
// a fallthrough is dynamically dead (every path returns), so the `unreachable` is
// sound padding, never executed.
export function bodyEndsInReturn(blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    const n = stmts.length
    if n == 0 { return false }
    const last = stmts[n - 1]
    const s = P.nodes[last]
    if s is RetStmt { return true }
    return stmtIsTailValue(last, fnIx)
  }
  false
}

// How many value-producing EXITS one RETURN VALUE contributes. An if-EXPRESSION
// (`return if c { a } else { b }`, or the same shape as a bare tail value) lowers as a
// void statement-`if` whose arms each terminate as their own return, so it contributes
// one exit PER ARM — which is what makes such a function eligible for the sink at all.
// Every other expression is a single exit.
function retValueExitCount(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  const bare = P.nodes[unwrapParen(exprIx)]
  if bare is IfStmt {
    return retArmExitCount(bare.ifThen, fnIx) +
      retArmExitCount(bare.ifElse, fnIx)
  }
  1
}

// One arm of a returned if-EXPRESSION: an `else if` chain link is another if-expression,
// a block's single tail value recurses (a NESTED if-expression contributes its own arms),
// and anything else is one exit.
function retArmExitCount(armIx: i32, fnIx: i32) {
  if armIx < 0 { return 0 }
  const a = P.nodes[armIx]
  if a is IfStmt { return retValueExitCount(armIx, fnIx) }
  if a is Block {
    const av = ifArmValueExpr(armIx)
    if av >= 0 { return retValueExitCount(av, fnIx) }
  }
  1
}

// How many value-producing EXITS the statement at `stmtIx` contributes, counting an
// explicit `return` and a tail value the same way `emitFuncBody`/`emitStmtTail` do (both
// lower through `emitReturnValue`). Recurses into the structured statements that can
// hold one — `if`/`else`, `while`, both `for` forms — and deliberately NOT into a nested
// `FuncDecl`, whose `return`s belong to its own lifted wasm function.
//
// This is a PREDICTION, and it is used for nothing but deciding whether to reserve the
// return-sink's two locals. It may over- or under-count without consequence: an
// over-count reserves two locals nothing writes, an under-count declines a sink that
// would have paid. The exit block is emitted off `uSinkFired`, which counts what the
// lowering ACTUALLY did.
function retExitCount(stmtIx: i32, fnIx: i32) {
  if stmtIx < 0 { return 0 }
  const s = P.nodes[stmtIx]
  if s is FuncDecl { return 0 }
  if s is RetStmt { return retValueExitCount(s.retArg, fnIx) }
  if s is Block {
    const stmts = s.blkStmts
    let n = 0
    let i = 0
    while i < stmts.length {
      const isLast = i == stmts.length - 1
      if isLast && stmtIsTailValue(stmts[i], fnIx) {
        n = n + retValueExitCount(stmts[i], fnIx)
      } else {
        n = n + retExitCount(stmts[i], fnIx)
      }
      i = i + 1
    }
    return n
  }
  if s is IfStmt {
    return retExitCount(s.ifThen, fnIx) + retExitCount(s.ifElse, fnIx)
  }
  if s is WhileStmt { return retExitCount(s.whileBody, fnIx) }
  if s is ForRange { return retExitCount(s.frBody, fnIx) }
  if s is ForIn { return retExitCount(s.fiBody, fnIx) }
  0
}

// True when function `fnIx` should reserve the union-box RETURN-SINK frame: its result
// rep is the shared union box AND it has at least two value-producing exits, so sinking
// can actually remove a construction site (a single-exit function already has the one
// site the sink would build, and paying a block plus two locals for it is pure loss).
//
// The union-box test is the SAME ladder `emitReturnValue` runs to set `retUNm` — the
// annotated `retUnionFlag` minus the three spellings that read as a union NAME but are
// not a box (a literal-union alias and its nullable form are an i32 atom, a nullable
// closure is the `ref.null $cloStruct` niche), plus the inferred value/struct union. It
// has to agree with `retUNm` or the frame is reserved for a function that never sinks,
// which costs two unused local declarations and nothing else.
export function fnUnionRetSinkOk(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    let isBox = false
    if retUnionFlag(fn.fnRet) == 1 {
      if (
        !nodeTyIsLitUnionAlias(fn.fnRet) &&
        !nodeTyIsNulLitUnion(fn.fnRet) &&
        nulCloFlag(fn.fnRet) != 1
      ) {
        isBox = true
      }
    }
    if fn.fnRet < 0 {
      const im = inferRetNameOf(fn.fnName)
      if isValueUnionName(im) || isUName(im) { isBox = true }
    }
    if !isBox { return false }
    return retExitCount(fn.fnBody, fnIx) >= 2
  }
  false
}

// Is some collected declared local named `name` the union BOX rep (kind 4)? The binding
// sink's prediction asks this rather than re-deriving the slot cursor: `buildLocals` has
// already run, so the kind is on record, and a shadowed name that answers for the WRONG
// slot only mis-predicts — which costs two unused local declarations, never a wrong sink
// (the lowering reads `localIsRef[slot]` for the slot it is actually emitting).
function localNameIsUnionSlot(name: string) {
  let i = 0
  while i < localNames.length {
    if localNames[i] == name {
      if localIsRef[i] == "union" { return true }
    }
    i = i + 1
  }
  false
}

// Does the statement at `stmtIx` hold a `let`/`const` of the union BOX rep whose init is
// an if-EXPRESSION — the shape the binding sink rewrites? Deliberately does NOT descend
// into a nested `FuncDecl`, whose locals belong to its own lifted wasm function.
function blockHasUnionLetIf(stmtIx: i32) {
  if stmtIx < 0 { return false }
  const s = P.nodes[stmtIx]
  if s is FuncDecl { return false }
  if s is LetDecl {
    if exprIsIfStmt(s.letInit) { return localNameIsUnionSlot(s.letName) }
    return false
  }
  if s is Block {
    const stmts = s.blkStmts
    let i = 0
    while i < stmts.length {
      if blockHasUnionLetIf(stmts[i]) { return true }
      i = i + 1
    }
    return false
  }
  if s is IfStmt {
    if blockHasUnionLetIf(s.ifThen) { return true }
    return blockHasUnionLetIf(s.ifElse)
  }
  if s is WhileStmt { return blockHasUnionLetIf(s.whileBody) }
  if s is ForRange { return blockHasUnionLetIf(s.frBody) }
  if s is ForIn { return blockHasUnionLetIf(s.fiBody) }
  false
}

// True when function `fnIx` should reserve the union-box sink pair for a BINDING: it holds
// a union-box `let`/`const` initialized by an if-expression, so an arm's box can be sunk
// past the merge and built once after it.
//
// This is a PREDICTION on the same terms as `fnUnionRetSinkOk`'s: whether the rewrite
// actually fires is decided during lowering (`unionIfBindingAllBox` gates it on every arm
// CONSTRUCTING a box, which only the coercion ladder knows). An over-firing prediction
// costs two unused local declarations; an under-firing one declines a sink.
export function fnUnionLetSinkOk(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl { return blockHasUnionLetIf(fn.fnBody) }
  false
}

// The per-function mv frame base for mv slot `slot` (valid when `fnUsesMap`).
export function fnMvMapRefLocal(slot: i32) { fnMvBase + slot * 3 }

export function fnMvValsBkLocal(slot: i32) { fnMvBase + slot * 3 + 1 }

export function fnMvValStashLocal(slot: i32) { fnMvBase + slot * 3 + 2 }

// The `m.values()` per-mv-slot OUTPUT backing local for mv slot `slot`.
export function fnMvValsOutLocal(slot: i32) { mvValsOutBase + slot }

// The result list REP-kind of a `m.values()` call — `2` i32-list, `7` string-list, `12`
// f64-list, `20` i64-list, `5` ref-list (struct / nested-list / nested-map values) — or -1
// if `exprIx` is not a `.values()` over a map. The result element type IS the map's value
// type, so each `expr*Array` classifier compares against its own rep.
function mapValuesResultKind(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[exprIx]
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Member {
      if callee.memProp == "values" {
        if exprMap(callee.memObj, fnIx) {
          const sh = mapShapeOfExpr(callee.memObj, fnIx)
          if sh == -1 {
            return 2 // mono i32 map → i32 list
          }
          if sh == -2 {
            return 7 // a Set's values() ARE its string keys
          }
          if sh == -4 || sh == -5 {
            // The i32-keyed rep: a map's values are the mono i32 list, and a Set's
            // values ARE its i32 keys — the same i32 list either way.
            return 2
          }
          if sh >= 0 {
            const vk = mvValKind[sh]
            if vk == 3 {
              return 7 // string-valued → string list
            }
            if vk == 11 {
              return 12 // f64-valued → f64 list
            }
            if vk == 10 {
              return 20 // i64-valued → i64 list
            }
            return 5 // struct / nested-list / nested-map → ref list
          }
        }
      }
    }
  }
  -1
}

// The fnStmts POSITION of the FuncDecl at arena index `fnIx`, or -1.
//
// THE CURSOR TEST IS THE WHOLE FUNCTION IN PRACTICE, AND THE SCAN BELOW IT IS THE
// FALLBACK. Counted over one self-compile (22,612 calls, 32,859,699 scan steps, 1,453 per
// call before the test existed): **18,164 of them — 80.3% — ask for the function
// `emitCodeSection` is lowering**, whose `fnStmts` index is that loop's own variable.
// `emitCurFnPos` carries it, so those calls are a compare and a read. The other 4,448 were
// the return-shape classifiers, and their callers already held the position too — they
// spell their argument `fnStmts[fe]` — so `mapRetExprShape` and `retCapturedMapShape` take
// the position by parameter and never reach here at all.
//
// **This is not a MEMO, and the difference is the whole safety argument.** A memo caches an
// ANSWER and is only equal to the scan if no LOWER position can ever come to hold an
// already-memoized node — a property of `emit_mono`'s replacement writer (its `nfn` is a
// fresh clone, so its arena index is new) that is true today, unpinnable from here, and a
// silent miscompile the day it stops being true. `emitCurFnPos` caches nothing: it is the
// caller's own INPUT, written as one pair with `emitCurFnIx` from the loop index. Its two
// exactness clauses live at its declaration in `emit_state`.
//
// **`fnStmts` is not written here**, and the fix deliberately did not go near its writers.
// Re-enumerated structurally: `emit_collect` (the reset, `collectFns`, `collectLifted`);
// `emit_mono` (three `.push` plus two IN-PLACE writes, `fnStmts[origFe] = nfn` for the
// count-0 instance being one). Every one is outside this partition, and all of them
// complete before `emitCodeSection` starts — which is what makes the pair above sound.
//
// THE SCAN'S REMAINING REACHES ARE THE PASSES THAT RUN BEFORE `emitCodeSection`, where
// there is no cursor to answer from: 0.01% of a self-compile, and 3.7% of a 1,600-frame
// ladder (all of it `capturedStructIndex`). The `monoOrigNode` fall-through below is
// reached **0 times** in a self-compile — it exists for the replaced-slot case and is
// measured, not assumed, to be cold.
export function fnStmtsPosOf(fnIx: i32) {
  if fnIx >= 0 && fnIx == emitCurFnIx { return emitCurFnPos }
  let i = 0
  while i < fnStmts.length {
    if fnStmts[i] == fnIx { return i }
    i = i + 1
  }
  // A monomorphized slot was REPLACED in place (a count-0 instance overwrote `fnStmts[fe]`), so the
  // ORIGINAL node — a lambda literal a binding still points at — is no longer found by the scan
  // above. `monoOrigNode[fe]` still records it, so recover the slot from there. (Pure fallback: a
  // non-replaced slot is found above; a non-function node matches neither and stays -1.)
  let j = 0
  while j < monoOrigNode.length {
    if monoOrigNode[j] == fnIx { return j }
    j = j + 1
  }
  -1
}

// True if `name` is a single INLINE STRUCT shape spanning the WHOLE string (`{f: i32}`,
// `{f: {f: i32|string}}`) — its first `{`'s matching `}` is the LAST char, and it is not
// a map spelling (`{[`). A composite (`{…}|null`, `{…}|{…}`, `{…}[]`) is not.
//
// THE LAST HAND-WRITTEN TYPE-NAME WALK IN THIS FILE IS GONE, AND EVERY SWEEP THAT MISSED
// IT MISSED IT FOR THE SAME REASON. This was a brace-only depth ladder whose counter was
// named `d0`; four successive name-list sweeps (`depth|d|lvl|level|dep|nest`) reproduced
// the published walk table function-for-function and never matched `\bd\b` against `d0`.
// A census whose unit says "a DEPTH counter" must not be implemented as a list of the
// words people use for one — only a STRUCTURAL sweep (some integer both incremented and
// decremented in a loop that tests a character against a grouper) finds this.
//
// The header this replaces defended the BRACE-ONLY alphabet at length and correctly: a
// `<`/`>` pair cannot change brace balance, so D-GENBRACKET's angle repair would have
// been inert here by construction. It said nothing about QUOTED literal members, which
// CAN change it — `{v: "a}b"}` closes the group early to a brace-only reader, exactly the
// class #1153 retired from `typecheck.isObjShapeName` "in the direction that loses a
// shape". `tyGroupWrapsWhole` -> `tyGroupEndIndex` -> `skipQuotedName` is quote-aware and
// escape-aware, and `emit_collect.nameIsSingleShape` has asked this same question through
// it since #1160.
//
// This is a DELETION, not a repair: computing both readings at every live invocation gives
// **0 disagreements over 199,621 invocations** (10,581 corpus + 189,040 fuzz), with 408
// quote-carrying names reaching the site, and the inverted comparator firing on 100% of
// reaches on both channels. The one remaining divergence class — a leading `{` that NEVER
// closes, where the walk read FALSE and the home reads TRUE — is guarded away by the
// final-character test (a group that never closes cannot end in `}` unless it is nested,
// and `P_WSNC` fired 0 times on either channel).
export function nameIsWholeSpanShape(name: string) {
  // The endpoint span is `emit_base.nameIsShapeSpanEnds` (`len >= 2` · `'{'` at 0 ·
  // NOT `'['` at 1 · `'}'` at the end); this function is that predicate PLUS the walk.
  // Keeping the walk as the only difference is the point: the sites that carry the
  // endpoint span ALONE must NOT be routed here — `{a:{b:i32}}|{c:i32}` passes the
  // endpoints and fails the walk, so this is a strictly TIGHTER answer, not a synonym.
  if !nameIsShapeSpanEnds(name) { return false }
  tyGroupWrapsWhole(name)
}

// The struct table index a type NAME names: a declared struct name directly, or an
// INLINE object-shape name (`{x:i32,y:i32}`) matched by field-name SET against the
// interned shapes (the anonymous literals interned the same sets). -1 if neither.
export function structIndexOfTypeName(name: string) {
  const si = structIndexByName(name)
  if si >= 0 { return si }
  // Only a SINGLE shape spanning the WHOLE name is a bare struct — a composite (`{…}|null`,
  // `{…}|{…}`, `{…}[]`) is not, so its first `{`'s matching `}` must be the LAST char. Without this
  // guard a nullable-struct name (`{x:i32}|null`) mis-matches its LEADING shape as the bare struct,
  // silently masking the `| null` (e.g. `annRetKind` would key a nullable result `>s` instead of
  // `>n`, breaking a nullable-returning closure value call).
  if nameIsWholeSpanShape(name) {
    // Collect the top-level field NAMES + TYPE texts (`shapeFieldParse` — the
    // variant resolver's grammar: depth-aware over `{}` `[]` `()`, spaces
    // stripped so the canonical and spaced renders parse the same), then match
    // by field-name set TIGHTENED with the field-TYPE layout guard
    // (`shapeFieldTypeCompat`, the `variantIndexOfTypeName` discipline): two
    // shapes sharing field names but differing in a field's TYPE must not
    // collide onto the wrong slot — structural identity alone is not layout
    // identity.
    const fnames: string[] = []
    const ftypes: string[] = []
    shapeFieldParse(name, fnames, ftypes)
    let si2 = 0
    const sLimB = sScanLim()
    while si2 < sLimB {
      // Skip a struct whose per-field ROWS are not yet fully appended. `internInlineShape`
      // pushes the struct HEADER (`sNames`/`sFieldStart`/`sFieldCount`) BEFORE populating its
      // `sFieldNames`/`sFieldTypes`/`sFieldElemName` rows one field at a time, and a code-5
      // ref-list field's element-name computation (`refArrElemName` → `shapeElemDeclaredStructIdx`)
      // RE-ENTERS this scanner mid-field-loop. Reading `sFieldElemNameAt` for the (not-yet-pushed)
      // trailing fields of that half-built struct is an OUT-OF-BOUNDS COMPILER CRASH. The struct
      // being interned was not resolvable before this point anyway, so making it invisible until
      // its rows are complete is behavior-preserving. (`sFieldElemName` is the last row pushed per
      // field, so it is the shortest of the three detail arrays mid-construction.) fuzz sweep
      // zq0NPY multiobs, seed 24438928 (`{a: {…, z: f64[] | null}[], …} | string | {q: i64}`).
      if sFieldStart[si2] + sFieldCount[si2] > sFieldElemName.length {
        si2 = si2 + 1
        continue
      }
      if sFieldCount[si2] == fnames.length {
        let ok = true
        let k = 0
        while k < fnames.length {
          const fj = sFieldIndex(si2, fnames[k])
          if fj < 0 {
            ok = false
          } else if (
            !shapeFieldTypeCompat(
              ftypes[k],
              sFieldTypeAt(si2, fj),
              sFieldElemNameAt(si2, fj),
            )
          ) {
            ok = false
          }
          k = k + 1
        }
        if ok { return si2 }
      }
      si2 = si2 + 1
    }
  }
  -1
}

// The union-VARIANT table index whose field-set matches a `{meow: i32}` SHAPE name (a
// collapsed `.map` callback return the checker rendered structurally) — the variant
// analogue of `structIndexOfTypeName`. -1 if no variant matches. A NAME that is already a
// variant alias resolves directly. Field-name parsing mirrors `structIndexOfTypeName`.
// `spacelessName` — "`name` with every SPACE dropped, or `name` itself when it carries none"
// — MOVED TO `tyname.nameStripSpaces` (W7), header and 21%-of-names measurement with it.
// It was one of two ENFORCEMENTS of the same rule (`emit_rep.renderFaithful` is the other)
// and one of six bodies stating it; the wrapper had exactly one caller and is gone rather
// than re-pointed, so the file names the home directly.
//
// Parse a canonical inline SHAPE name `{a:T,b:U}` into PARALLEL field-name / field-type
// string lists (appended to `outNames` / `outTypes`). A non-`{…}` name appends nothing.
// Shared by the variant / struct field-set resolvers so a field-NAME match can be
// tightened with a field-TYPE (`nameFieldCode`) check — two shapes sharing field names but
// differing in a field's TYPE (`{a:i32,f:i64,z:f64}` vs a union arm
// `{a:boolean,f:()=>{…},z:i32}`) no longer collide onto the wrong slot.
//
// D-SHAPEFIELD — THIS WAS THE COMPILER'S LAST HAND-WRITTEN TYPE-NAME DEPTH LADDER.
// It carried its own `{}` `[]` `()` `<>` depth counter, its own `angOpen`/`tyGtIsClose`
// close rule and its own per-character accumulator, and it is now a resume loop over
// `tyTopLevelSplit` — the published SPLIT home, which rides the checker's `tyTopIndexOf`.
// The structural walk census (a loop that increments AND decrements an integer while
// testing a character against a grouper) reads **0 copies + 2 homes** after this, from
// 1 + 2 at the parent and 5 + 2 two PRs ago.
//
// THE INHERITED HAND-OFF SAID THIS WAS NOT A DEDUP TARGET ("a multi-field SPLITTER, not
// a wrap/find question; retiring it needs the field list to come from the TYPE"). That is
// REFUTED by the code one module down: `emit_base.shapeInnerFieldSplit` splits exactly
// this grammar and has been a resume loop over the home since #1147, and
// `typecheck.canonShapeName` splits it a third time the same way. A splitter IS a
// repeated FIND, and the home's header says so — it counts depth FROM `from`, so a split
// that resumes at the character after a top-level separator still costs ONE pass.
//
// Two behavioural notes, both MEASURED (89,166 twin comparisons over corpus + fuzz, 0
// disagreements, inverted twin firing on every multi-field reach):
//   · The home is QUOTE-AWARE (`skipQuotedName`) where this ladder was quote-BLIND, so a
//     `,` or `:` inside a quoted literal member no longer splits a field. 1,059 reaches
//     carry a quote and none of them has a separator inside it, so the fix is real but
//     its witness population is empty on both channels — stated, not dressed up.
//   · A part with no `:` keeps the WHOLE part as the field name (`ci < 0`), and a part
//     that STARTS with `:` yields an empty name — the ladder's exact convention, kept
//     deliberately. Reusing `shapeInnerFieldSplit` outright (which pushes an empty name
//     AND an empty type for both) was built and measured too: 0 disagreements, because
//     that population is EMPTY on every channel (0 of 89,166). An unreached difference is
//     a coverage statement, not a licence, so the faithful form ships.
function shapeFieldParse(name: string, outNames: string[], outTypes: string[]) {
  if nameIsShapeOpen(name) {
    const flat = nameStripSpaces(name)
    const parts: string[] = []
    // The GROUP-INTERIOR cut at its home (`tyname.groupInnerOf`, W1). This is the ONE routed
    // site whose span test does NOT establish the home's `length >= 2` bound on the cut's
    // own operand: the guard is `nameIsShapeOpen(name)` (an OPEN test, no closing `}`), and
    // the cut runs on `flat`, the DESPACED name — so a hypothetical `"{ "` reaches here with
    // `flat == "{"`. It does not matter: VL's `.slice` clamps, so `"{".slice(1, 0)` is `""`
    // and the home returns `""` too. Same answer, and it is the same answer on every input
    // rather than on every input this site can reach.
    tyTopLevelSplit(groupInnerOf(flat), ',', false, parts)
    let k = 0
    while k < parts.length {
      const part = parts[k]
      const ci = part.indexOf(":")
      if ci < 0 {
        outNames.push(part)
        outTypes.push("")
      } else {
        // The FIELD-COLON cut at its home (`tyname.fieldNameOf` / `fieldTypeTextOf`, W14) —
        // the LAST two hand-written writings of that pair anywhere in the tree. #1259 homed
        // the other eight and FILED these two because this file was held; the substitution is
        // the two lines its header predicted. The `ci < 0` guard above stays: this site keeps
        // the WHOLE part as the field name where `annObjFieldSplit` / `shapeInnerFieldSplit`
        // gate `ci <= 0` and push two empties, which is exactly why the cut is
        // delimiter-blind and takes the index as an ARGUMENT.
        outNames.push(fieldNameOf(part, ci))
        outTypes.push(fieldTypeTextOf(part, ci))
      }
      k = k + 1
    }
  }
}

// True if two map VALUE type-names denote the SAME map rep — the code-19 tightening the
// field-set matchers apply (every map field shares code 19, so the code alone cannot
// separate an i32-valued from a string-valued map field: two shapes sharing field names
// but differing in a map field's VALUE collided onto the wrong slot — invalid wasm at the
// construct). Kind-classified through `mvValKindOfName` (the interner's own classifier):
//   · either side unclassifiable (-3) — LENIENT (never a false reject);
//   · a checker RENDER collapses a litunion alias value to `string` (`tyToEmitName`
//     widens member literals), so a string-vs-declared-alias pair is the SAME map seen
//     through two vocabularies — lenient;
//   · otherwise kinds must agree, and slot-bearing values must share the canonical rep
//     (`mvCanonRepOf` — the `variantFieldLayoutEq` code-19 discipline).
function mvValNamesCompat(va: string, ve: string): boolean {
  const ka = mvValKindOfName(va)
  const ke = mvValKindOfName(ve)
  if ka == -3 || ke == -3 { return true }
  if ka != ke {
    if ka == 3 && ke == -1 && nameIsLitUnionType(ve) { return true }
    if ke == 3 && ka == -1 && nameIsLitUnionType(va) { return true }
    return false
  }
  const sa = mvSlotOfMapValNameOrMono(va)
  const se = mvSlotOfMapValNameOrMono(ve)
  if sa >= 0 && se >= 0 { return mvCanonRepOf(sa) == mvCanonRepOf(se) }
  true
}

// True if a shape field TYPE-string `t` (from `shapeFieldParse`) is compatible with the
// emitter field CODE `code` — i.e. NOT a proven mismatch. A definitive mismatch (both codes
// known and unequal, e.g. i64 `23` vs closure `14`) is the field-name-collision signal.
// When the type-string cannot be classified (`nameFieldCode` -1, e.g. an inline nested
// struct `{…}`) the check stays LENIENT (true), preserving the legacy name-only match for
// shapes the code layer can't render — never a false REJECT of a real twin. A MAP field
// (code 19) is additionally tightened by its VALUE rep (`mvValNamesCompat` against the
// slot's recorded `elem` name) — the code alone is value-blind.
function shapeFieldTypeCompat(t: string, code: i32, elem: string): boolean {
  const want = nameFieldCode(t)
  if want < 0 || code < 0 {
    // A NESTED-STRUCT candidate field (code 15) whose spelled type `nameFieldCode`
    // cannot classify is (almost always) an INLINE nested shape — tighten by the
    // canonical structural key so two unions' arms sharing a field-name set but
    // differing in the nested layout (`{f: {f: f32}} | X` vs `{f: {f: i64}} | Y` in
    // one program) do not collide onto the first arm's variant (invalid wasm at the
    // construct — the code-19 lesson applied to code 15). PROVEN mismatches only:
    // either side unresolvable through the checker stays lenient.
    if code == 15 && elem != "" {
      const tb = nonNulBaseOf(t)
      return nestedStructNamesCompat(tb, elem)
    }
    // RETIRED (arm 2, #978): a UNION-BOX candidate field (code 16) against a
    // WHOLE-SPAN inline-shape spelling used to be refuted here, so the lenient
    // fieldset scan would DECLINE a nested-alias twin pair (`{f: {f: i32|string}}`
    // beside its inner `{f: i32|string}` row) rather than merge the outer
    // annotation onto the inner row. That refutation existed only to make the NAME
    // resolver decline a render the NODE resolver already answers correctly: every
    // caller that could feed it a whole-span self-classified render is now routed
    // through the adopted arena type (`structIndexOfObjCtx` #1061 — hoisted ahead
    // of the nominal consult, `structIdxOfElemName` #1062 and the `rlTwin` heap
    // loop it backs, `shapeElemDeclaredStructIdx` + `structIndexOfExpr` #1063) or
    // through `repRowOfName`'s canon key, both of which separate those twins by the
    // FULL nested field type. Witnesses: the four `nested-{null-hole,union-
    // softening}-list-{elem,return}-twin` pins.
    // RETIRED (arm 3's CLOSURE half, #1041): a code-14/22 (closure / nullable-
    // closure) candidate field against a WHOLE-SPAN inline-shape spelling used to be
    // refuted here, so a lambda returning a nested struct `{f: {f: f64}}` could not
    // leniently match the struct-ARM variant `{f: () => {f: {f: f64}}}` of a
    // `{…} | f64` variant-box union (`cbRetVariantIdx` mis-collapsed the return and
    // the `$fnsig` result token keyed the arm struct). Same disposition as arm 2
    // (#978): the refutation only made the NAME resolver decline a render the NODE
    // resolver already answers, and every caller that can feed it a whole-span
    // self-classified render is now routed through the adopted arena type or
    // `repRowOfName`'s canon key. Witness: the #1041 pin
    // `closures/variant-box-closure-field-nested-struct-result.vl`, plus #1056's
    // `cbRetVariantIdx` plain-struct classification which now carries that case.
    // RETIRED (arm 3's SCALAR/string half, #996): a code-0/3/17/23/24 candidate
    // field against a WHOLE-SPAN inline-shape spelling used to be refuted here, so
    // the lenient fieldset scan would DECLINE the nullable nested-alias twin pair
    // (`type T0 = {f: {f: f64}}` beside its inner `{f: f64}` row) rather than let a
    // `w: {f: {f: f64}} | null` binding adopt the inner. Same disposition as arm 2
    // (#978) and arm 3's closure half (#1041): the refutation only made the NAME
    // resolver decline a render the canon key separates correctly. Its last callers
    // were the NULLABLE-STRUCT ANNOTATION path — `paramStructIndex`,
    // `retStructIndex` and `retNulRefIndex` all resolved a `S | null` annotation's
    // BASE through `structIndexOfTypeName` — now routed through `repRowOfName`
    // above. All three are load-bearing together (measured: routing only
    // `paramStructIndex` turns the loud reject into INVALID-WASM, because the
    // functype/valtype path still resolved the wrong row). Retiring the arm also
    // GRADUATED the whole-span nullable spelling from a loud reject to working code
    // in both the param and the return position — witness
    // `structs/nullable-declared-twin-whole-span-annotation.vl`.
    // RETIRED (arm 4, #935 — the LAST `shapeFieldTypeCompat` refutation): a NULLABLE
    // DISTINCT-BACKING SCALAR-LIST field spelling (`f64[] | null`, `i64[] | null`,
    // `f32[] | null`, `string[] | null`) used to have NO field code at all, so this
    // refuted it against EVERY candidate code — keeping the shape un-matched and the
    // consumer failing LOUDLY, because the lenient `want < 0` fall-through would
    // otherwise let `{f: i64[] | null}` adopt a same-field-name literal's `{f: i32[]}`
    // layout and store i64 elements into the i32 array (fuzz frontier seed 70441494 d4).
    // Unlike arms 2/3 this encoded REPRESENTABILITY, not a twin refutation, so routing
    // could never retire it — #1070 did, by making the four spellings FIELD CODES
    // 31/32/33/34 (`nulScalarListFieldCode`). With `want >= 0` for every one of them the
    // arm was only reachable against a candidate whose OWN code is unclassifiable, where
    // `structFieldCodesEq`'s layout guard and `repRowOfName`'s canon key already separate
    // the twins. Disable-then-diff confirms it twice over (at the #1070 landing and again
    // here): corpus byte-identical AND run-identical, fuzz A/B 25,200 programs/side with
    // an identical finding set. `shapeFieldTypeCompat` now carries NO refutation arms.
    return true
  }
  if want != code {
    // The AMBIGUOUS nullable-closure render: a code-22 field (`f: (() => i64) | null`)
    // RENDERS ungrouped (`()=>i64|null` — the checker drops a union member's grouping
    // parens), which `nameFieldCode` reads as a top-level arrow (code 14) returning a
    // nullable. The grouped and ungrouped spellings render identically, so the text alone
    // cannot refute the 22 layout — stay LENIENT (not a proven mismatch) when the arrow's
    // RESULT carries a depth-0 `| null` tail. A genuine closure field with a non-nullable
    // result (`f: () => i64`) keeps the proven-mismatch reject.
    if code == 22 && want == 14 {
      // The RETURN cut at its home (`tyname.fnRetTextOf`, W4). The `aa >= 0` gate is WIDER
      // than every other routed site's (the rest want `>= 1` or a full function-type
      // predicate), which is why the home folds no bound in — and `.slice` clamps rather
      // than traps, so the two agree at `aa == 0` as they do everywhere else.
      const aa = annArrowAt(t)
      if aa >= 0 && nullablePartOf(fnRetTextOf(t, aa)) != "" { return true }
    }
    return false
  }
  if want == 0 {
    // ATOM-IDENTITY tightening (code 0 is layout-shared between PLAIN i32/boolean
    // slots and litunion-ATOM slots): a `{f: K0}` spelling must not adopt a plain
    // row — its member literal would emit as a STRING ref into the i32 slot
    // (INVALID-WASM; the r9 declared-composite twin family) — and a plain spelling
    // must not adopt an atom row (atom ids read back as booleans: a silent
    // MISMATCH). Both sides are decidable here (the spelling via
    // `nameIsLitUnionType`, the row via its recorded union name), so this is a
    // PROVEN-mismatch reject, never a lenient-side narrowing.
    if nameIsLitUnionType(t) != nameIsLitUnionType(elem) { return false }
    return true
  }
  if want == 4 {
    // The atom-ARRAY sibling: `{f: K0[]}` (i32 list of member ids, per-row atom
    // element context) vs a plain `{f: i32[]}`/`{f: boolean[]}` — same
    // shared-layout, encoding-different split as the code-0 tightening.
    if nameIsLitUnionArray(t) != nameIsLitUnionArray(elem) { return false }
    return true
  }
  if want == 19 && elem != "" { return mvValNamesCompat(mapValNameOf(t), elem) }
  if want == 15 && elem != "" {
    // A DECLARED-name nested-struct field (`inner: Inner`) against the variant's
    // recorded target: the same canonical-key tightening as the inline spelling.
    const tb15 = nonNulBaseOf(t)
    return nestedStructNamesCompat(tb15, elem)
  }
  true
}

// True unless the two nested-struct TYPE spellings `ta` / `elem` are PROVEN to denote
// distinct structures: both resolve through the checker's canonical structural key
// (`repNameCanonKey`, the variant/map slot-layer vocabulary) and the keys differ.
// Either side unresolvable ("" key) stays lenient — never a false reject of a twin
// the canon layer does not cover.
function nestedStructNamesCompat(ta: string, elem: string): boolean {
  if ta == elem { return true }
  const ka = repNameCanonKey(ta)
  if ka == "" { return true }
  const ke = repNameCanonKey(elem)
  if ke == "" { return true }
  ka == ke
}

function variantIndexOfTypeName(name: string) {
  const direct = variantIndexOf(name)
  if direct >= 0 { return direct }
  if nameIsShapeOpen(name) {
    const fnames: string[] = []
    const ftypes: string[] = []
    shapeFieldParse(name, fnames, ftypes)
    let vi = 0
    while vi < uVariants.length {
      if uFieldCount[vi] == fnames.length {
        let ok = true
        let k = 0
        while k < fnames.length {
          const fj = variantFieldIndex(vi, fnames[k])
          if fj < 0 {
            ok = false
          } else if (
            !shapeFieldTypeCompat(
              ftypes[k],
              variantFieldTypeAt(vi, fj),
              variantFieldElemName(vi, fj),
            )
          ) {
            // A shared field NAME but a mismatched field TYPE — a distinct shape that
            // merely collides on names (a closure returning `{a:i32,f:i64,z:f64}` is NOT
            // the union arm `{a:boolean,f:()=>…,z:i32}`). Not this variant.
            ok = false
          }
          k = k + 1
        }
        if ok { return vi }
      }
      vi = vi + 1
    }
  }
  -1
}

// The union-VARIANT index a lifted callback `fe` returns when it COLLAPSES to a single
// variant (`(a) => if a is Cat { a } else { catShape }`), read from the checker's recorded
// node-keyed return shape, or -1. Lets `.map`/`.filter` classify the result as the variant
// ref list (the checker types it `Cat[]`, but the emitter's syntactic union inference would
// otherwise widen the narrowed receiver to the box).
export function cbRetVariantIdx(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return -1 }
  const nm = inferRetNameByNode(fnStmts[fe])
  const vi = variantIndexOfTypeName(nm)
  if vi < 0 { return -1 }
  // A lambda whose inferred return the checker classified as a PLAIN struct
  // (`fRetKind == struct/nulstruct`, with a resolved plain struct row) must NOT
  // collapse to a variant merely because its ANONYMOUS shape (`{f: f64}`) coincides
  // with a union arm REGISTERED for an UNRELATED sibling field (`z: {f: f64} | f64`):
  // the closure's own result type is genuinely that plain struct, so its `$fnsig`
  // result must key `>sN;` (the field annotation's consumer key) — not `>VN;`. A
  // DIRECT nominal variant name (`Cat`) is always a genuine collapse and passes
  // through. Without this the value-call `ref.cast` took the variant functype while
  // the lambda was declared the struct one — a runtime CAST TRAP (fuzz multiobs leg,
  // the `{f: () => {f: f64}, z: {f: f64} | f64}` closure-result-twins-sibling-union
  // composite).
  if fe < fRetKind.length {
    if variantIndexOf(nm) < 0 {
      const k = fRetKind[fe]
      if (k == "struct" || k == "nulstruct") && fRetStructIdx[fe] >= 0 {
        return -1
      }
    }
  }
  vi
}

// The RETURN-type NAME of a function-VALUE callee `name` (in scope of `fnIx`): the return
// part of its source function-type annotation — a closure-typed PARAM of the enclosing
// function, a closure-typed LOCAL/GLOBAL binding, or a union arm narrowed to a bare closure.
// "" when `name` is not a resolvable closure value or its annotation is not a `(…) => R`
// arrow. Lets the niche-nullable classifiers recognize `p()` where `p: () => boolean | null`
// (a closure-param call `fnIndexOf` can't see) as the niche its RETURN type declares — the
// resolved `$fnsig` key can't (a `boolean|null` niche rides `>i`, same as a plain `boolean`).
export function calleeCloRetName(name: string, fnIx: i32) {
  let ft = ""
  // A union binding narrowed to a bare-closure arm carries the arm's `(…) => R` name.
  const nc = narrowedClosureOf(name)
  if nc != "" {
    ft = nc
  } else if fnIx >= 0 {
    // A closure-typed PARAM of the enclosing function.
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      const params = fn.fnParams
      let i = 0
      while i < params.length {
        const p = P.nodes[params[i]]
        if p is Param {
          if p.parName == name {
            const pn = tyNameOf(p.parType)
            if annArrowAt(pn) >= 0 { ft = pn }
          }
        }
        i = i + 1
      }
    }
  }
  // A closure-typed LOCAL / GLOBAL binding annotation.
  if ft == "" { ft = identFnTypeAnnName(name, fnIx) }
  // The second exact copy of `annRetNameOf` (#1144); same `< 0` vs `< 1` note as
  // `cloArrSlotRetName` above.
  return annRetNameOf(ft)
}

// True if the expression is a NAME (param / local / module global) annotated
// `boolean|null` — the niche scalar nullable.
export function exprNulBool(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  // Typed-IR fast path (additive — only turns false into true, mirroring `exprIsBool`):
  // the checker recorded this node's type as `boolean | null`. Recovers the niche for a
  // form the syntactic arms below can't trace — a `(boolean | null)[]` element read
  // `p[i]`, or an inferred `const t = p[i]` bound to it — so its `!= null` compares
  // against the sentinel 2 rather than emitting a bare null.
  if nodeTyIsNulBool(exprIx) { return true }
  const e = P.nodes[unwrapParen(exprIx)]
  // A CALL of a function annotated `: boolean | null` — its result is the niche i32.
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const t = fnIndexOfSid(sidOfNode(e.callFn))
      if t >= 0 {
        const cfn = P.nodes[fnStmts[t]]
        if cfn is FuncDecl {
          if tyIsNulBool(cfn.fnRet) { return true }
          // ...or an UN-ANNOTATED function whose return INFERS to `boolean | null`.
          //
          // NOT A TYPE SPELLING (D-CLASSGRAM census note), even though the literal looks
          // like one. `inferNicheNullByName` publishes a THREE-VALUED PROTOCOL RETURN —
          // `""` / `"boolean|null"` / `"string|null"` — and its header (written by #1213)
          // says exactly that its returned strings stay literal because they are a RENDER
          // of the answer, which is the one use of a type spelling the rule allows: the
          // function's own body asks the grammar homes and then TAGS the result. The value
          // compared here is that tag, not a rendering of any arena type. A whole-spelling
          // census counts it because the literal holds a `|` and an alphanumeric, so it
          // needs the compared expression's PROVENANCE, not the literal's shape. Four more
          // sites of this exact shape live in `wasmEmit.vl` (2 in the return-flag pair, 2 in
          // the niche-result classifier) — the tier-1 census's whole remaining tree-wide
          // population, and every one of them a false positive.
          if cfn.fnRet < 0 {
            if inferNicheNullByName(callee.identName) == "boolean|null" {
              return true
            }
          }
          return false
        }
      }
      // A call of a closure-typed VALUE (`p()` where `p: () => boolean | null`) — a
      // param / local / global `fnIndexOf` can't see: read its return-type annotation.
      if nameIsNulBool(calleeCloRetName(callee.identName, fnIx)) { return true }
    }
    return false
  }
  if e is Ident {
    if fnIx >= 0 {
      const fn = P.nodes[fnIx]
      if fn is FuncDecl {
        const params = fn.fnParams
        let i = 0
        while i < params.length {
          const p = P.nodes[params[i]]
          if p is Param {
            if p.parName == e.identName { return tyIsNulBool(p.parType) }
          }
          i = i + 1
        }
        const li = parentLetOf(fn.fnBody, e.identName)
        if li >= 0 { return letNulBool(li, fnIx) }
      }
    }
    const gi = globalLetOf(e.identName)
    if gi >= 0 { return letNulBool(gi, -1) }
    return false
  }
  // A bare map READ `m[k]` over a `boolean | null`-VALUED map (`{[string]: boolean | null}`)
  // yields the `boolean | null` niche i32 (0/1 with the `2` null sentinel — a stored null is
  // preserved), so an un-annotated `const b = m[k]` binds the niche and narrows with `!= null`
  // against 2. The bare-read dual of the `m[k] ?? d` arm in `exprNulLitUnion` (a bare read has
  // no `??` to route it, so the `!= null` compare would otherwise emit a bare null).
  if e is Index {
    if nodeTyMapValIsNulBool(e.idxArr) { return true }
  }
  // A `boolean | null` struct FIELD read (`a.v`, code 21) is the niche i32 sentinel.
  if e is Member { return memberFieldCode(exprIx, fnIx) == 21 }
  // A chained `a ?? b` over `boolean | null` is itself `boolean | null` when the default
  // `b` is also nullable — the left-associative `(f() ?? g()) ?? d` shape (see the
  // `exprNullableString` companion). Keeps `??` print-routing consistent with the rep.
  if e is BinExpr {
    if e.binOp == "??" {
      if exprNulBool(e.binLeft, fnIx) { return exprNulBool(e.binRight, fnIx) }
    }
  }
  false
}

// A `let`/`const` binding is `boolean | null` if it is so ANNOTATED, or (un-annotated)
// its initializer is a `boolean | null` value — e.g. `const r = f()` where `f` returns
// the niche. Mirrors `letUnionNameOf`'s annotation-or-init resolution for value unions.
export function letNulBool(letIx: i32, fnIx: i32) {
  if letIx < 0 { return false }
  if letIsNulBoolAnn(letIx) { return true }
  // An un-annotated `const x = if c then true else null` infers `boolean | null` (a
  // niche the emitter can't statically derive from the if-expr arms). The CHECKER
  // typed it and exported the binding by node index; consult that before the init probe.
  if isInferLetNulBool(letIx) { return true }
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType < 0 { return exprNulBool(d.letInit, fnIx) }
  }
  false
}

// True if `exprIx` is a `K | null` NICHE value (the i32 atom with the spare `-1` = null) — a
// `K|null`-annotated param / local / global, or a call of a `K|null`-returning function. The
// litunion dual of `exprNulBool`; consulted at the `== null` compare and the `null`-seed boundaries.
export function exprNulLitUnion(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[unwrapParen(exprIx)]
  // A `(K | null)[]` element READ `p[i]` — the niche i32 (a member id or the `-1` null sentinel).
  // Recovered from the array's element type so an inferred `const t = p[i]` and a direct `p[i] !=
  // null` narrow against `-1` rather than emitting a bare null. Scoped to an Index whose receiver is
  // the litunion-niche list (NOT the broad node-type probe, which `exprIsLitAtom` consumes and would
  // over-widen the construction path).
  if e is Index {
    if nodeArrayElemIsNulLitUnion(e.idxArr) { return true }
    // A bare map READ `m[k]` over a `{[string]: K | null}` map yields the `K | null` niche i32
    // (a member id or the `-1` null sentinel — a stored null is preserved), so an un-annotated
    // `const t = m[k]` binds the niche and narrows with `!= null` against `-1`. The bare-read
    // dual of the `m[k] ?? d` arm below (a bare read has no `??` to route it).
    if nodeTyMapValIsNulLitUnion(e.idxArr) { return true }
    // …and the NON-nullable spelling `{[string]: K}` reads the SAME niche: a bare `m[k]` is
    // `K | null` there too (a MISSING key is null), and `emitMapGet`'s miss arm yields the
    // very same `-1`. The two map spellings differ only in whether a null can be STORED, not
    // in what a read produces, so claiming one and not the other left `const g = m[k]` off the
    // atom slot — `g != null` then emitted a bare null (`bare null needs a struct-typed
    // context`) instead of the `-1` compare.
    if nodeTyMapValIsLitUnion(e.idxArr) { return true }
  }
  // A fused `m[k] ?? d` read over a NULLABLE-atom-valued map (`{[string]: K | null}`) yields
  // the `K | null` niche i32 (a member id or the `-1` sentinel — a stored null is preserved),
  // so an un-annotated `const t = m[k] ?? d` binds the niche and narrows with `!= null`. The
  // receiver comes from the ONE fused-read shape home so the METHOD spelling `m.get(k) ?? d`
  // — the same lowering — claims identically (the `exprIsLitAtom` twin of this half-set).
  if e is BinExpr {
    if e.binOp == "??" {
      const nblRecv = fusedMapReadRecvIx(unwrapParen(e.binLeft))
      if nblRecv >= 0 {
        if nodeTyMapValIsNulLitUnion(nblRecv) { return true }
      }
      // The NON-map `p ?? d` over the SAME niche keeps it `K | null` exactly when the default
      // can still be null — the CONSUMER half of `emitCoalesce`'s litunion arm, in the shape
      // `exprNulBool` / `exprNullableString` / `exprNullableStruct` state for their own reps.
      // Without it an inferred `const nv = p ?? q` bound a cell that answered no niche arm and
      // its `nv != null` emitted a bare null: `bare null needs a struct-typed context`.
      // `coalesceLitUnionFits` is the SAME claim the emit arm makes, so a default that pushes
      // the join off the niche (`k ?? "zz"`) is declined on both sides at once.
      if coalesceLitUnionFits(exprIx, fnIx) {
        return coalesceDefaultNullable(e.binRight, fnIx)
      }
    }
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const t = fnIndexOfSid(sidOfNode(e.callFn))
      if t >= 0 {
        const cfn = P.nodes[fnStmts[t]]
        if cfn is FuncDecl {
          if cfn.fnRet >= 0 { return nodeTyIsNulLitUnion(cfn.fnRet) }
        }
      }
      // A call of a closure-typed VALUE (`p()` where `p: () => K | null`) — a param /
      // local / global whose `K | null` niche return `fnIndexOf` can't see.
      if nameIsNulLitUnion(calleeCloRetName(callee.identName, fnIx)) {
        return true
      }
    }
    // An INDEXED closure-array call (`p[i]()` where `p: (() => K | null)[]`): the element's
    // closure result is the `K | null` niche. `cloArrSlotRetName` reads it off the ref-list slot,
    // the indexed dual of the Ident `calleeCloRetName` above — so `const t0 = p[i]()` binds the
    // kind-0 litunion niche (an i32) instead of mis-inferring the softened `string | null` ref.
    if callee is Index {
      if exprRefArray(callee.idxArr, fnIx) {
        const rn = cloArrSlotRetName(refListSlotOfExpr(callee.idxArr, fnIx))
        if nameIsNulLitUnion(rn) { return true }
      }
    }
    // FALLBACK (scoped to a CALL): a `K | null`-returning closure value call whose callee the
    // cases above miss — a CHAINED closure call (`v(1)()` where `v: (i32) => (() => K | null)`).
    // The cheap NO-RENDER `nodeTyIsNulLitUnion` reads the checker's per-node type, mirroring
    // `exprNullableString`'s `nodeTyIsNullableString` fallback (which structurally EXCLUDES the
    // litunion niche, so exactly one of the two claims the node).
    return nodeTyIsNulLitUnion(exprIx)
  }
  if e is Ident {
    // A CAPTURED variable, resolved against the enclosing frame's binding — the niche twin of
    // `exprIsLitAtom`'s capture channel, and the same node `captureValKind` sizes the env
    // field from. Checked first: a capture is none of the three channels below.
    if capturedIsNulLitUnion(fnIx, e.identName) { return true }
    if fnIx >= 0 {
      const fn = P.nodes[fnIx]
      if fn is FuncDecl {
        const params = fn.fnParams
        let i = 0
        while i < params.length {
          const p = P.nodes[params[i]]
          if p is Param {
            if p.parName == e.identName {
              return nodeTyIsNulLitUnion(p.parType)
            }
          }
          i = i + 1
        }
        const li = parentLetOf(fn.fnBody, e.identName)
        if li >= 0 { return letNulLitUnion(li, fnIx) }
      }
    }
    const gi = globalLetOf(e.identName)
    if gi >= 0 { return letNulLitUnion(gi, -1) }
    // A for-in LOOP VAR over a `(K | null)[]` — the one storage class the three channels above
    // cannot reach: a loop var is not a capture, a param, a `let` or a global, and has no
    // declaration node to read an annotation off. `declareForInLocals` flagged its slot as the
    // ATOM (`localLitUnion`); the NULLABILITY then comes from the checker's recorded type for
    // THIS read, which is the niche only where the read is un-narrowed — inside `if x != null`
    // the recorded type is the bare litunion and this correctly declines. Without it `x != null`
    // asked no niche arm and emitted a struct null: `bare null needs a struct-typed context`.
    const nluSlot = declaredSlotOf(e.identName)
    if nluSlot >= 0 && nluSlot < localLitUnion.length {
      if localLitUnion[nluSlot] == 1 { return nodeTyIsNulLitUnion(exprIx) }
    }
    return false
  }
  // A `K | null` struct FIELD read (`a.f`, code 30) is the niche i32 with the `-1`
  // sentinel — the litunion dual of `exprNulBool`'s Member arm. Covers the plain
  // struct receiver AND the `is`-narrowed variant receiver (`memberFieldCode`
  // resolves both), so an inferred `const t0 = v.f` binds the niche and its
  // `!= null` narrows against `-1`.
  if e is Member { return memberFieldCode(exprIx, fnIx) == 30 }
  false
}

// A `let`/`const` binding is `K | null` if it is so ANNOTATED, or (un-annotated) its initializer is
// a `K | null` value. The litunion dual of `letNulBool`.
export function letNulLitUnion(letIx: i32, fnIx: i32) {
  if letIx < 0 { return false }
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return nodeTyIsNulLitUnion(d.letType) }
    return exprNulLitUnion(d.letInit, fnIx)
  }
  false
}

// True if `name` resolves (param / local / module global) to a BOOLEAN binding:
// either a `: boolean`/`: bool` annotation, or an un-annotated `const`/`let` whose
// initializer is itself boolean. A boolean local registers as kind 0 (== i32), so
// bool-ness must be recovered from the binding here, not the local registry.
function boundBoolByName(name: string, fnIx: i32) {
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      const params = fn.fnParams
      let i = 0
      while i < params.length {
        const p = P.nodes[params[i]]
        if p is Param {
          if p.parName == name { return tyIsBool(p.parType) }
        }
        i = i + 1
      }
      const li = parentLetOf(fn.fnBody, name)
      if li >= 0 {
        const d = P.nodes[li]
        if d is LetDecl {
          if d.letType >= 0 { return tyIsBool(d.letType) }
          return exprIsBool(d.letInit, fnIx)
        }
      }
    }
  }
  const gi = globalLetOf(name)
  if gi >= 0 {
    const g = P.nodes[gi]
    if g is LetDecl {
      if g.letType >= 0 { return tyIsBool(g.letType) }
      return exprIsBool(g.letInit, -1)
    }
  }
  false
}

export function retNulRefFlag(tyIx: i32) {
  if tyIx >= 0 {
    // STRUCTURAL fast-path (C1): the checker recorded this node's type as a nullable declared
    // struct (`S | null`). Confirms only; `string | null` and everything else fall to the name path.
    if nodeTyIsNulStruct(tyIx) { return 1 }
    const ty = P.nodes[tyIx]
    if ty is TypeRef {
      const base = nullablePartOf(ty.tyName)
      // `string` is the raw i32 array, NOT a struct — `string | null` is the kind-16
      // nullable-string ref (`retNulStringFlag`), never a nullable struct. Exclude it
      // here so it isn't mis-claimed as kind 9 (which would read the box as a struct).
      if base == "string" { return 0 }
      if base != "" {
        if structIndexOfTypeName(base) >= 0 { return 1 }
      }
    }
  }
  0
}

// The base struct table index of a `S | null` annotation at `tyIx`, or -1.
export function retNulRefIndex(tyIx: i32) {
  if tyIx >= 0 {
    // STRUCTURAL-FIRST (rep-twin phase 1): the checker recorded this annotation node's
    // type — a `TyNullable` whose peeled inner is a struct resolves its slot straight
    // off the arena (`repSlotOfTy` — nominal identity AND the structural→declared-twin
    // bridge), skipping the name-render parse + `sNames` scan. The bridge is byte-safe
    // here now that the sig-canon slice renders `sTwin`-canonical `$fnsig` digits (see
    // `retStructIndex`). Only CONFIRMS (a miss falls through to the name path below).
    const rt = nodeRepTyIxOf(tyIx)
    if rt >= 0 {
      const t = T.tys[rt]
      if t is TyNullable {
        const ds = repSlotOfTy(t.nInner)
        if ds >= 0 { return ds }
      }
    }
    const ty = P.nodes[tyIx]
    if ty is TypeRef {
      const nb = nulBaseStructRow(tyIx, ty.tyName)
      if nb >= 0 { return nb }
    }
  }
  -1
}

// The STRUCT/rep ROW of the base of a nullable-struct annotation (`S | null` -> `S`'s
// row), or -1 — the third writing-out of one grammar (`retNulRefIndex`,
// `retStructIndex`, `paramStructIndex` each carried this five-line block verbatim,
// down to the `repRowOfName`-then-`structIndexOfTypeName` order).
//
// THREE rungs now, in resolution order (method note 26: a resolver is a LADDER, and a
// dual of one rung is not a dual of the resolver):
//
//   1. ARENA (destringify D-NULBASEROW) — the checker recorded this ANNOTATION NODE's
//      type; a `TyNullable`'s peeled `nInner` IS what `nullablePartOf` spells, so the
//      row comes straight off `repRowOfTyStruct` with no render in the loop. All three
//      call sites hold the type-annotation node index and simply threw it away at this
//      boundary, which is why the rung could never be written before.
//   2. `repRowOfName` — the SAME `repRowOfTyStruct` question, reached through
//      `renderFaithful` + a `resolveAnnot` RE-PARSE of the spelling. Kept, not deleted:
//      it is the ANSWERING rung on exactly 1 corpus file and 0 fuzz programs —
//      `structs/nullable-wrapper-literal-widen.vl`, an INLINE-SHAPE nullable
//      `{f: f32} | null` whose recorded `nInner` resolves to no row while the spelling
//      does. ONE witness is enough: deleting this rung would newly decline a row that
//      resolves today. INDEX IDENTITY IS NOT TYPE IDENTITY.
//   3. `structIndexOfTypeName` — the legacy fieldset scan, untouched.
//
// Ladder-faithful (D1 leg C): rung 1 only CONFIRMS — an uncovered node, a node whose
// recorded type is not a `TyNullable`, or a `repRowOfTyStruct` decline all fall through
// to exactly the rungs that ran before, in the same order. Rung 1 sits AFTER the
// `base == ""` guard on purpose: a node recorded `TyNullable` whose SPELLING is not a
// depth-0 `X | null` must keep answering -1, as it always has.
//
// MEASURED over 1,410 corpus files and 7,200 fuzz programs: rung 1 ANSWERS in 42 + 99;
// rung 2 answers where rung 1 declined in 1 + 0 (the witness above); and rung 1's answer
// never differs from what the ladder below would have returned — **0 + 0 divergences**.
// That zero is graded, not assumed: the same rung made deliberately wrong (its row shifted
// down one) reddens 19 corpus files and 20 fuzz programs, so the channel can see this
// resolver. All three call sites collapse -1 and -2, so `repRowOfName`'s tri-state is not
// consulted here. Pinned by `tests/cases/structs/nullable-base-row-arena-node.vl`, which
// fails under that same sabotage.
function nulBaseStructRow(tyIx: i32, name: string): i32 {
  const base = nullablePartOf(name)
  if base == "" { return -1 }
  const nt = nodeRepTyIxOf(tyIx)
  if nt >= 0 {
    const t = T.tys[nt]
    if t is TyNullable {
      const ar = repRowOfTyStruct(t.nInner, sScanLim())
      if ar >= 0 { return ar }
    }
  }
  const rr = repRowOfName(base, sScanLim())
  if rr >= 0 { return rr }
  structIndexOfTypeName(base)
}

// `1` if the type-annotation node at `tyIx` names the struct, else `0` (i32 / none).
// Used for functype param/result valtypes and the `"struct"` return kind. Returning the
// flag (not pushing bytes) keeps each call free of a `0→1` local reassignment, which
// pins a `let x = 0` to the literal `0` type and fails to typecheck.
export function retTRFlag(tyIx: i32) {
  if tyIx >= 0 {
    // STRUCTURAL fast-path (C1): the checker recorded this node's type as a declared struct —
    // confirm directly, skipping the O(nodes) `nameIsStructDecl` scan `isSName` walks. Only
    // CONFIRMS (never denies), so anything it doesn't cover falls to the name test below.
    if nodeTyIsStruct(tyIx) { return 1 }
    return 0
  }
  0
}

// The struct table index named by the type-annotation node at `tyIx`, or -1 if it
// names no declared struct.
export function retStructIndex(tyIx: i32) {
  if tyIx >= 0 {
    // STRUCTURAL-FIRST (rep-twin phase 1, the first arena-keyed row consumer): a
    // struct annotation resolves its slot straight off the checker's arena type
    // (`nodeRepTyIxOf` → `repSlotOfTy`), skipping the O(sNames) name scan. This
    // now consumes the FULL `repSlotOfTy` — nominal identity AND the
    // structural→declared-twin BRIDGE (an INLINE `{…}` spelling resolving to its
    // unique declared twin). The bridge was held OUT of this consumer through
    // phase 1: its 2 corpus divergences are `sTwin` layout twins whose slot
    // DIGIT feeds `$fnsig` tokens, so a twin-slot shift was not byte-safe (the
    // #980 KEY-vs-ROW family). The sig-canon slice
    // (`repSigSlotTokOfKind`→`repStructSlotRep`) renders the `sTwin`-canonical
    // digit, so those twins now key the SAME `$fnsig` — the bridge is byte-safe
    // and opens here. Only CONFIRMS; variants / `S | null` / un-recorded nodes
    // fall through to the name ladder below.
    const ds = repSlotOfTy(nodeRepTyIxOf(tyIx))
    if ds >= 0 { return ds }
    const ty = P.nodes[tyIx]
    if ty is TypeRef {
      const si = structIndexByName(ty.tyName)
      if si >= 0 { return si }
      // A union-variant name carries its VARIANT index here (consumed by `pushVT`'s
      // `kind == 8` variant-struct case); not a standalone struct, so it is -1 above.
      const vi = variantIndexOf(ty.tyName)
      if vi >= 0 { return vi }
      // A `S | null` annotation resolves to its BASE struct's index — the single
      // chokepoint the param/local/return struct lookups read, so a nullable-struct
      // binding's member layout resolves without separate plumbing.
      return nulBaseStructRow(tyIx, ty.tyName)
    }
  }
  -1
}

// The `pendingListKind` a type-annotation node at `tyIx` names (1 = struct/MAP ref list,
// 2 = union box ref list, 3 = string list), or 0 when it is not a list annotation. Shared
// by the let / return / call-arg / global seeding so each position threads the SAME
// annotation-derived list context into `emitArr` (so a non-empty `B[]` literal in a return
// or argument position builds B's list, not the first-element field-shape guess). A
// `LetDecl`-specific wrapper (`letAnnRefListKind`) forwards its `letType` here.
export function tyAnnRefListKind(tyIx: i32) {
  if tyIx >= 0 {
    // The annotation's element ROW, `| null`-tolerant exactly as the intern arm that
    // banked it. The row was interned under the very kind `refArrElemKind` computes
    // (`ensureRefElem` passes it to `rlInternName`), so `rlElemKindTbl` IS the answer —
    // read, not re-derived from the rendering.
    const raK = annRefArrSlot(tyIx)
    if raK >= 0 && raK < rlElemKindTbl.length {
      if rlElemKindTbl[raK] == 2 { return 2 }
      if rlElemKindTbl[raK] == 5 { return 5 }
      return 1
    }
    // An INLINE literal-union ARRAY annotation (`("a" | "b")[]`) seeds NO list kind — the
    // default i32 wrapper, exactly as the `K[]` alias spelling does. Ahead of the name arm:
    // the canon pass softens the bare inline union to `string`, so the spelling reads
    // `string[]` and `nameIsStringArray` would seed the string-list build (kind 3) for an
    // empty `[]` while the cell is the atom i32 list. This function has NO `repOf` leg — it
    // answers a literal-BUILD seed, not a cell rep — so the rep layer cannot subsume it and
    // the check has to stand here.
    if tyIsLitUnionArray(nodeTyIxOf(tyIx)) { return 0 }
    // The nullable-ELEMENT twin (`(("a" | "b") | null)[]`, kind 9), ahead of the name arms
    // for the same reason: the softened `(string | null)[]` spelling would seed the
    // string-list build (kind 3) for a cell that is the i32 atom-niche list.
    if annIsNulLitUnionArray(tyIx) { return 9 }
    const lt = P.nodes[tyIx]
    if lt is TypeRef {
      if nameIsStringArray(lt.tyName) { return 3 }
      // A `(boolean | null)[]` annotation (kind 8): an i32-backed list whose elements
      // carry the boolean sentinel niche (`null → 2`). Threads so an all-`null` `[null]`
      // (which self-infers as `null[]`) builds the i32 wrapper and seeds `pendingNulBool`
      // for its elements. Checked before the scalar-array arms (it is an i32 list).
      if nameIsNulBoolList(lt.tyName) { return 8 }
      // A `(K | null)[]` annotation (kind 9): an i32-backed atom list whose elements carry the
      // litunion sentinel niche (`null → -1`, a member literal → its id). Threads so an all-`null`
      // `[null]` (which self-infers as `null[]`) builds the i32 wrapper and seeds `pendingNulLitUnion`
      // + `pendingLitUnion` for its elements. Checked before the scalar-array arms (it is an i32 list).
      if nameIsNulLitUnionList(lt.tyName) { return 9 }
      // An `f64[]` annotation: an empty `[]` builds the f64-list wrapper (kind 4).
      if nameIsF64Array(lt.tyName) { return 4 }
      // An `i64[]` annotation: an empty `[]` builds the i64-list wrapper (kind 6).
      if nameIsI64Array(lt.tyName) { return 6 }
      // An `f32[]` annotation (kind 7): threads even for a NON-empty literal, since a bare
      // `[1.5]` does not self-identify as f32 (it defaults to f64).
      if nameIsF32Array(lt.tyName) { return 7 }
    }
  }
  0
}

// The ref-list TABLE SLOT a type-annotation node at `tyIx` names (`Tok[]` → the `Tok`
// slot), or 0 when it is not a ref-array annotation. Mirror of `tyAnnRefListKind` for the
// slot; threads `pendingListSlot` so a ref-list literal builds the annotation's distinct
// element type.
export function tyAnnRefListSlot(tyIx: i32) {
  if tyIx >= 0 {
    // Which ref-list ROW holds this annotation's element — the recorded type first,
    // then the row the INTERN pass banked on the node. `| null`-tolerant, exactly as
    // the intern arm is.
    const raS = annRefArrSlot(tyIx)
    if raS >= 0 { return raS }
  }
  0
}

// `1` if the type-annotation node at `tyIx` is a REF array (`S[]`/`N[]`), else `0`.
// Feeds the `kind == 5` (ref list) branch of `pushVT`.
export function retRefArrFlag(tyIx: i32) {
  if tyIx >= 0 {
    // STRUCTURAL fast-path (C1): the checker recorded this node as an array of a declared struct
    // (`S[]`) — the clean base case, without the O(nodes) name scan the bare element match walks.
    if nodeTyIsStructArray(tyIx) { return 1 }
    // A ref-list ROW for the annotation's element IS the intern-state question, and covers the
    // nested / union / niche element spellings the struct-array fast path above declines. Gated
    // to a NON-nullable annotation — a `S[] | null` spelling is `retNulRefArrFlag`'s.
    if annBareRefArrSlot(tyIx) >= 0 { return 1 }
  }
  0
}

// `1` if the type-annotation node at `tyIx` is a NULLABLE ref array (`<ref-array> | null` — e.g.
// `S[] | null`, `((i32) => f64)[] | null`, `i32[][] | null`), else `0`. The value/composite-position
// analogue of the local ladder's `letIsNulRefArray` (kind 18, `"nulreflist"`): a `(ref null $wrapper)`
// slot over the inner ref-list's element wrapper — null is `ref.null $wrapper`, a non-null list value
// subtypes it. Feeds the `"nulreflist"` arm of `vtKindOfType`, so a nullable ref-list crosses a
// RETURN / PARAM / GLOBAL boundary with the SAME sound rep the local already gives it (was: `nameIsRefArray`
// misses the `| null` suffix and the classifier fell through to `"i32"` → an `(ref …)` value in an i32
// slot, INVALID-WASM). The inner-slot resolution is `tyAnnRefListSlot` (already `| null`-aware). A
// value-union-ELEMENT inner (`(i32|null)[] | null`) is excluded implicitly — `nameIsRefArray` returns 0
// for it — so it keeps failing loudly rather than mis-riding this niche.
export function retNulRefArrFlag(tyIx: i32) {
  if tyIx >= 0 {
    // A `TyNullable` annotation whose inner array's element owns a ref-list ROW, with the
    // nullable gate carried by `annNulRefArrSlot` so a bare `S[]` still answers 0.
    if annNulRefArrSlot(tyIx) >= 0 { return 1 }
  }
  0
}

// The folded LIST-rep code of a function RETURN annotation `tyIx`: `2` i32-list, `5`
// ref-list, `7` string-list, `12` f64-list, or `0` (not a list). The four `nameIs*Array`
// predicates are mutually exclusive by name, so the priority order is immaterial. Feeds
// the list arms of `retAnnKindChain` (was `retArrFlag`/`retRefArrFlag`/`retStrArrFlag`/
// `retF64ArrFlag` into four parallel boolean tables).
export function retListKindFlag(tyIx: i32) {
  if retArrFlag(tyIx) == 1 { return 2 }
  if retRefArrFlag(tyIx) == 1 { return 5 }
  if retStrArrFlag(tyIx) == 1 { return 7 }
  if retF64ArrFlag(tyIx) == 1 { return 12 }
  0
}

// The ref-list element type-NAME of a function RETURN type node `tyIx` (an `S[]`/`N[]`),
// or "". Populates `fRetRArrElem`.
export function retRefArrElemName(tyIx: i32) {
  if tyIx >= 0 {
    const ty = P.nodes[tyIx]
    // `refArrElemNameIf` IS the `nameIsRefArray`-gated `refArrElemName` this arm spelled
    // out; its "" for a non-ref-array annotation is the same "" this function's tail
    // returned, so the early return is exact.
    if ty is TypeRef { return refArrElemNameIf(ty.tyName) }
  }
  ""
}

// C1 endgame: an emitter-SYNTHESIZED type-annotation node (a mono clone, an inferred-list synthesis,
// a contextual return/param pin). Records the CONCRETE type on the new node so the structural
// classifiers cover it (unresolvable emitter-internal names record -1 = same as uncovered). See
// `recordClonedNodeTy`. Every synthesis site routes through here so coverage stays uniform.
export function synthTypeRef(name: string, pos: i32) {
  const n = mkTypeRef(name, pos)
  const pin = pinKindOfName(name)
  recordNodePin(n, pin, synthPinPayloadOf(name, pin))
  recordClonedNodeTy(n, name, pin)
  n
}

// THE MINT-SIDE BRIDGE of the PIN COLUMN (census W11): which PROVENANCE, if any,
// the synthesized name `name` carries. Every pin enters the arena through
// `synthTypeRef` above — `mkTypeRef`'s only other caller is the PARSER, whose names
// are source spellings and never handles — so classifying here covers the column
// completely, and no consumer needs to re-read a marker off a `tyName` again.
//
// The ANON leg is STRUCTURAL: an interned anonymous shape is exactly a name the
// emitter's own row table claims (`isSName`). It is an EXACT-name query and must
// stay one — the `#anon` prefix test it replaced also matched `"#anon3[]"`, an
// ARRAY of an interned shape (minted by `emit_collect`'s inferred-list synthesis),
// and the array then recorded the placeholder `TyObj` that tells `nodeTyIsStruct`
// "this annotation is a struct". An array is not a struct, and the mis-record cost
// a closure returning an array of structs its whole emission (the un-resolved
// element struct floored at "ref valtype with no interned shape"). The name-side
// twin needs no arm here at all: a DECLARED struct's array spelling (`P[]`) is a
// real type, so `nameToTy` resolves it and the pin is never consulted.
//
// The SIGKEY leg is the ONE remaining decode, and it goes through the marker's
// documented home (`sigKeyPinPayload`) rather than re-spelling the compares. It
// stays because the marker is still how `monoArgTyName` HANDS the key over — the
// key doubles as the monomorphizer's instance-registry discriminator, so removing
// it from the string is a separate move (and the `$fnsig` ABI itself, W12, is out
// of scope). Everything downstream of this line reads the column.
//
// Exported because `emit_mono` builds the SAME column one step earlier, over its
// per-parameter `pinned` names, before any node exists to key on — one bridge, two
// callers, rather than a second copy of the test.
export function pinKindOfName(name: string) {
  if sigKeyPinPayload(name) != "" { return PIN_SIGKEY }
  if isSName(name) { return PIN_ANON }
  PIN_NONE
}

// The payload the column stores beside `kind` — the `$fnsig` key for a SIGKEY pin,
// "" for every other kind (an interned shape's layout rides `sNames`, keyed by the
// name the node already carries, so it needs no second copy here).
function synthPinPayloadOf(name: string, kind: i32) {
  if kind == PIN_SIGKEY { return sigKeyPinPayload(name) }
  ""
}

// The nullable-scalar-list VKind of a DISTINCT-backing nullable list type name (`string[] | null`,
// `f64[] | null`, `i64[] | null`, `f32[] | null`), or "" for anything else. Each leaf has its OWN
// wrapper heap type, so — unlike the i32-backed `nameIsNulI32List` fold — each is a genuinely
// distinct `(ref null $wrapper)` cell. A bare `= null` init lowers as `ref.null $wrapper`; a list
// value stores its (non-null) wrapper ref, which subtypes the nullable slot.
export function nulScalarListKind(name: string): VKind | null {
  const b = nullablePartOf(name)
  if nameIsStringArray(b) { return "nulstrlist" }
  // A nullable-ELEMENT string list under the outer null (`(string | null)[] | null`):
  // the SAME `$mkListIdx` wrapper heap type as `string[]` (a string element is already
  // a nullable ref at the wasm level — see `nameIsNulStrList`), so the nullable CELL is
  // the same `(ref null $wrapper)` kind. Un-admitted, the param fell through the ladder
  // to the i32 DEFAULT and the call site pushed the wrapper ref into an i32 param —
  // INVALID-WASM (fuzz-nightly plain leg, seed 154928295 d6). The element-read
  // discipline (`(ref null)` element, narrowed with `!= null`) is `exprNulStrArray`'s.
  if nameIsNulStrList(b) { return "nulstrlist" }
  if nameIsF64Array(b) { return "nulf64list" }
  if nameIsI64Array(b) { return "nuli64list" }
  if nameIsF32Array(b) { return "nulf32list" }
  null
}
// The nullable-scalar-list VKind of annotation node `tyIx`, or `null`.
//
// ARENA-FIRST, and the arena's answer is TOTAL where it covers: the four spellings this
// picks out are exactly the nullable lists whose leaf has its OWN wrapper heap type, and
// `repOfNode` names that leaf directly. It has to lead, because the SPELLING can no longer
// tell them apart: `canonEmitName` softens a bare inline literal union to its base scalar,
// so `("a" | "b")[] | null` arrives here rendered `string[] | null` and the name ladder
// codes it `nulstrlist` — a `(ref null $strListWrapper)` — while every construct/read path
// builds the interned-atom i32 list its `K[] | null` alias spelling gets. A covered
// annotation that is NOT one of the four therefore answers `null` outright rather than
// falling through to a name that has lost the distinction.
export function nulScalarListKindOfNode(tyIx: i32): VKind | null {
  if tyIx < 0 { return null }
  const rk = annRepKindOf(tyIx)
  if rk != null {
    if isNulScalarListKind(rk) { return rk }
    return null
  }
  const ty = P.nodes[tyIx]
  if ty is TypeRef { return nulScalarListKind(ty.tyName) }
  null
}
// The `emitArr` list-build code (`pendingListKind` / `ExpCtx.listKind`) a nullable-scalar-list
// value's list literal builds with: strlist 3 · f64list 4 · i64list 6 · f32list 7 (the leaf-list
// build codes), or 0 if `kind` is not a nullable scalar list.
export function nulScalarListBuildKind(kind: VKind | null): i32 {
  if kind == "nulstrlist" { return 3 }
  if kind == "nulf64list" { return 4 }
  if kind == "nuli64list" { return 6 }
  if kind == "nulf32list" { return 7 }
  0
}
// True if `kind` is one of the four distinct-backing nullable-scalar-list VKinds.
export function isNulScalarListKind(kind: VKind | null): boolean {
  if kind == null { return false }
  kind == "nulstrlist" ||
    kind == "nulf64list" ||
    kind == "nuli64list" ||
    kind == "nulf32list"
}
// The struct / variant FIELD code of a DISTINCT-backing nullable scalar-list spelling —
// `string[] | null` 31 · `f64[] | null` 32 · `i64[] | null` 33 · `f32[] | null` 34 — or -1.
// The FIELD-position mirror of the `nulScalarListKind` BINDING niche (and of
// `refArrShapeKind`'s nullable-LIST arm, kinds 6/7/8/10, the list-ELEMENT position):
// each leaf keeps its OWN wrapper
// heap type, so — unlike the i32-backed leaves, which all fold onto code 18's `$lTypeIdx` —
// each spelling needs its own `(ref null $wrapper)` field code. One code per wrapper keeps
// `structFieldCodesEq` splitting same-fieldset twins by their real emitted layout.
// `nulScalarListWrapHeap` maps the kind back to the wrapper the storage type, the
// omitted-field null and the whole-value null seed all reference.
export function nulScalarListFieldCode(name: string) {
  const k = nulScalarListKind(name)
  if k == "nulstrlist" { return 31 }
  if k == "nulf64list" { return 32 }
  if k == "nuli64list" { return 33 }
  if k == "nulf32list" { return 34 }
  -1
}
// The nullable-scalar-list VKind behind FIELD code 31..34 — the inverse of
// `nulScalarListFieldCode`, so the store/read/null paths recover the leaf's build kind
// (`nulScalarListBuildKind`) and wrapper heap (`nulScalarListWrapHeap`) from the code alone.
export function nulScalarListCodeKind(code: i32): VKind | null {
  if code == 31 { return "nulstrlist" }
  if code == 32 { return "nulf64list" }
  if code == 33 { return "nuli64list" }
  if code == 34 { return "nulf32list" }
  null
}
// True if field code `c` is one of the four distinct-backing nullable-scalar-list codes.
export function isNulScalarListFieldCode(c: i32): boolean {
  c == 31 || c == 32 || c == 33 || c == 34
}

// True if the type-ANNOTATION node `tyIx` denotes an ARRAY whose ELEMENT is a NULLABLE
// literal union (`(K | null)[]`, inline `(("a" | "b") | null)[]`) — the atom-NICHE list
// whose elements are interned i32 ids with `-1` for `null`. `nameIsNulLitUnionList`'s
// STRUCTURAL dual, and the reason one is needed: `canonEmitName` preserves the members of
// a nullable ALIAS litunion but softens an inline one, so the inline spelling arrives
// rendered `(string | null)[]` — indistinguishable from a real nullable-string list, whose
// backing is the `$mkListIdx` string wrapper rather than the i32 one. The rep layer cannot
// answer it either (`repOfArray` leaves a nullable ELEMENT to the legacy layer), so the
// question is put to the recorded type directly.
function annIsNulLitUnionArray(tyIx: i32) {
  tyIsNulLitUnionArr(nodeTyIxOf(tyIx))
}

// The same question asked of an ARENA index rather than an annotation node — the form the
// `| null`-peeling `annIsNulStrListDeep` needs, since after the peel there is no node left.
function tyIsNulLitUnionArr(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyArray {
    const e = T.tys[t.aElem]
    if e is TyNullable { return tyIsLitUnion(e.nInner) }
  }
  false
}

// `nameIsNulStrListDeep` asked of a type-ANNOTATION NODE, with the atom-niche element
// ruled out STRUCTURALLY first. The name predicate cannot do it: an inline
// `(("a" | "b") | null)[]` renders `(string | null)[]` after the canon pass, and it
// admits that spelling — so the element read took the `(ref null $aTypeIdx)` STRING
// backing of an i32 atom list (invalid wasm), which is the one thing this predicate
// exists to route. The outer `| null` the name side peels is peeled here too, so a
// narrowed `(K | null)[] | null` binding gets the same structural reject.
function annIsNulStrListDeep(tyIx: i32) {
  if tyIx < 0 { return false }
  let ty = nodeTyIxOf(tyIx)
  if ty >= 0 {
    const t = T.tys[ty]
    if t is TyNullable { ty = t.nInner }
  }
  if tyIsNulLitUnionArr(ty) { return false }
  nameIsNulStrListDeep(tyNameOf(tyIx))
}

// The wasm rep KIND the checker's ARENA assigns to the type-ANNOTATION node `tyNodeIx`,
// or `null` where the arena does not decide it. This is `vtKindOfType`'s `repOf`-first
// leg on its own: when it answers, the annotation's rep is settled STRUCTURALLY and no
// name parse can add anything; when it answers `null` the caller keeps its name ladder.
// The binding classifiers (`letIs*`) consult it so a `let`'s rep comes off the checked
// type rather than a character-by-character re-parse of the annotation's rendering — the
// name-CLASSIFIER layer's hot path (`nameIsRefArray` recursing through `splitUnionAtoms` /
// `refArrElemName` / `structIndexByName` on every ladder rung, per binding, per query).
//
// It is EXACTLY `repOfNode`'s covered answer and holds no spelling-shaped special case of
// its own. An element vocabulary the arena knows — an INLINE `("a" | "b")[]` as much as the
// `K[]` alias — reaches here through the rep tree's list projection (`rtListVKind`), which is
// where a new element kind belongs; a second arm here would be a rep decision taken outside
// the rep layer, and the two would drift.
function annRepKindOf(tyNodeIx: i32): VKind | null {
  if tyNodeIx < 0 { return null }
  const rd = repOfNode(tyNodeIx)
  if rd.rdCovered == 1 { return rd.rdKind }
  null
}

// True if the type-ANNOTATION node `tyIx` denotes the kind-19 nullable-closure niche,
// seeing through a declared ALIAS whose body is a function type (`type F = (i32) => i32`,
// then `F | null`). `nulCloFlag`'s arena leg asks for `TyNullable` over a `TyFunc`; the
// parser encodes every non-`{…}`-bodied `type N = …` as a ONE-MEMBER `UnionDecl`, so the
// alias arrives as `TyNullable(TyUnion[TyFunc])` and the flag reads 0 — while its name leg
// finds no `=>` in the spelling `F | null` either. `tyDenotesFunc` peels the degenerate
// wrapper: a one-member union has nothing to discriminate, so it denotes its member
// (#1122's transparency rule, applied one construct further out).
export function nulCloFlagAnn(tyIx: i32) {
  if nulCloFlag(tyIx) == 1 { return 1 }
  const ty = nodeTyIxOf(tyIx)
  if ty < 0 { return 0 }
  const t = T.tys[ty]
  if t is TyNullable {
    if tyDenotesFunc(t.nInner) { return 1 }
  }
  0
}

export function vtKindOfType(tyIx: i32): VKind {
  // repOf-FIRST (the strangler seam, roadmap Next#1): where the checker's arena covers the
  // annotation's shape, the descriptor (`emit_rep.vl`) decides the kind — ONE structural
  // derivation instead of this ladder re-testing name arms. Since rep-rewrite Stage B wave 1
  // the descriptor's kind is itself the recursive Rep TREE's projection (`repOfTy` is
  // tree-primary), so this delegation reads the tree wherever the flat arms claim coverage.
  // The ladder below remains the fallback for the uncovered remainder (typed-value maps,
  // union-element lists, nested arrays, nullable lists beyond `i32[] | null`, …) and shrinks
  // as coverage widens. `annRepKindOf` IS this leg — the binding classifiers consult the
  // same one, so "what rep does this annotation have" has a single structural answer.
  const rk = annRepKindOf(tyIx)
  if rk != null { return rk }
  // A literal-union annotation (`type K = "a" | "b"`) is an i32-backed interned atom (`"i32"`), NOT
  // a value-union box — checked first (it IS a `TyUnion`, so `retUnionFlag` would claim it).
  if tyIx >= 0 {
    if P.nodes[tyIx] is TypeRef {
      if nodeTyIsLitUnionAlias(tyIx) { return "i32" }
    }
  }
  // A NULLABLE literal-union (`K | null`) is the SAME i32 atom (`"i32"`), with the spare value `-1`
  // encoding `null` (no box). Checked before the `string | null` niche (`"nulstr"`) — `canonEmitName`
  // preserves the litunion members, but a defensive position keeps it ahead of any base-collapse.
  if tyIx >= 0 {
    if P.nodes[tyIx] is TypeRef {
      if nodeTyIsNulLitUnion(tyIx) { return "i32" }
    }
  }
  // A NULLABLE NUMERIC literal union (`1 | 2 | null`, `Z | null` over `type Z = 1 | 2`) is the
  // value-union BOX — `<base scalar> | null`, and a nullable i32/i64/f64 boxes. NEITHER litunion
  // rule claims it (`nulNumLitUnionBaseName`'s header carries why: the string niche is
  // `litKind == "str"` only, and the numeric BASE collapse declines the moment a member is not a
  // `TyLit`, which `null` is), so without this arm it fell to the `"i32"` default at the bottom
  // while the `let`/global ladder's NAME test (`letIsUnion`) built the same type as a box. That
  // disagreement is one type with two reps: the `let` and element/field/map-value positions were
  // correct and the PARAM / RETURN cells were an i32 that cannot hold the null their own
  // annotation admits — `emitProgram: bare null needs a struct-typed context` at `f(null)` and
  // at `return null`, and a `vl check`-clean invalid-wasm `x is null` over the param.
  // AFTER the atom-niche arms above (a STRING litunion keeps the `-1` sentinel, not the box).
  if nodeTyIsNulNumLitUnion(tyIx) { return "union" }
  // A NULLABLE function `(fn) | null` is the closure fat-pointer made nullable, `"nulclosure"` —
  // checked BEFORE `tyIsFuncType` (whose `=>` test would otherwise claim it as the non-null
  // `"closure"`). The non-null part is a function, but the `| null` makes the slot nullable.
  if nulCloFlag(tyIx) == 1 { return "nulclosure" }
  // An ARRAY OF FUNCTIONS (`((i32) => i32)[]`) is a closure-element REF LIST (`"reflist"`),
  // NOT a single closure — checked BEFORE `tyIsFuncType`, whose `=>` substring test would
  // otherwise claim the whole array as `"closure"`. The element arrow is NESTED; a TOP-LEVEL
  // arrow with a trailing `[]` (`(i32) => i32[]`, a function RETURNING a list) is a real
  // closure value and stays `"closure"` below.
  if nameIsClosureArrayTy(tyIx) == 1 { return "reflist" }
  // A function-typed annotation (a name carrying `=>` — incl. the synthetic
  // `"=>sigkey"` a monomorphized closure param is pinned with) is the closure
  // fat-pointer, `"closure"`. Checked first; no other name contains an arrow.
  if tyIsFuncType(tyIx) { return "closure" }
  // A string-keyed MAP annotation (`{[string]: V}`) is the map struct ref, `"map"` — checked
  // before the struct/object arms (an inline `{[…]:…}` is not a field-struct shape). Its
  // `fbValtype` arg is the map shape slot (mono i32 ⇒ -1, via `paramStructIdxOf`/`retStructIndex`).
  if retMapFlag(tyIx) == 1 { return "map" }
  // A NULLABLE string-keyed map (`{[string]: V} | null`) — the `(ref null $mapStruct)` niche
  // (`"nulmap"`), the map twin of `nulstruct`. AFTER `retMapFlag` (a bare map is never nullable);
  // disjoint from it anyway (a `| null` map name is a `nameIsMapMemberUnion`, which `retMapFlag`
  // excludes). Its shape arg is `mapAnnShape` (now `| null`-aware), resolving THIS map's `$mapStruct`.
  if retNulMapFlag(tyIx) == 1 { return "nulmap" }
  if retNulRefFlag(tyIx) == 1 { return "nulstruct" }
  if retNulStringFlag(tyIx) == 1 { return "nulstr" }
  if retNulListFlag(tyIx) == 1 { return "nullist" }
  // A NULLABLE ref array (`<ref-array> | null`) — the `(ref null $wrapper)` niche (kind 18,
  // `"nulreflist"`), the local ladder's rep hoisted to the value/composite positions. BEFORE
  // `retRefArrFlag` (whose non-null `"reflist"` slot cannot hold `null`) and the union arms (a
  // `T[] | null` reads as a union NAME). Disjoint from `retNulListFlag` above: an i32-backed
  // list (`i32[]|null`) is a `"nullist"`, a ref-element / nested list (`S[]|null`, `i32[][]|null`)
  // is a `"nulreflist"` — `nameIsRefArray` excludes the i32-list backing.
  if retNulRefArrFlag(tyIx) == 1 { return "nulreflist" }
  if retStrArrFlag(tyIx) == 1 { return "strlist" }
  if retF64ArrFlag(tyIx) == 1 { return "f64list" }
  if retI64ArrFlag(tyIx) == 1 { return "i64list" }
  if retF32ArrFlag(tyIx) == 1 { return "f32list" }
  if retRefArrFlag(tyIx) == 1 { return "reflist" }
  if retUnionFlag(tyIx) == 1 { return "union" }
  if retVariantFlag(tyIx) == 1 { return "variant" }
  if retTRFlag(tyIx) == 1 { return "struct" }
  if retArrFlag(tyIx) == 1 { return "list" }
  if retStrFlag(tyIx) == 1 { return "str" }
  if retI64Flag(tyIx) == 1 { return "i64" }
  if retF64Flag(tyIx) == 1 { return "f64" }
  if retF32Flag(tyIx) == 1 { return "f32" }
  "i32"
}

// `1` if the type-annotation node at `tyIx` is a string-keyed map (`{[string]: V}`), else `0`.
// Feeds the `kind == 6` (map struct ref) branch of `vtKindOfType`, so a map can be a param /
// return / functype valtype (the `(ref $mapStruct)` cell), not only a local.
export function retMapFlag(tyIx: i32) {
  if tyIx >= 0 {
    const ty = P.nodes[tyIx]
    if ty is TypeRef {
      // A string-keyed map crosses a call boundary as kind 6 (`(ref $mapStruct)`). Its
      // `fbValtype` arg is the map SHAPE (`mapAnnShape`): -1 for the mono map, or the
      // per-value-type mv slot (the value type's interned `$mapStruct` carries across the
      // boundary). The gate is the SAME classifier the local path interns with
      // (`mvValKindOfName`) — every map value type that binds locally also crosses a
      // param/return boundary; anything outside it stays a loud rejection.
      // A map-member UNION (`{[string]: V} | X`) also STARTS with `{[`, so the old `nameIsMap`
      // test matched the whole union name — but it is a union BOX, not a map, and every consumer
      // had to subtract that false positive with a second scan (`nameIsMapMemberUnion`, a
      // top-level union SPLIT). The ARENA never had the false positive to subtract: a bare map is
      // a `TyMap` and a map-member union is a `TyUnion`, so `nodeTyIsMap` — typecheck's variant-tag
      // test, already in production for EXPRESSION nodes — is the whole guard, allocation-free.
      // (D-BAREMAP: 285,915 twin invocations at this site, 0 disagreements, 0 uncovered-live.)
      if nodeTyIsMap(tyIx) {
        if mapValKindLowerable(ty.tyName) { return 1 }
      }
    }
  }
  0
}

// The BARE (non-null) inner map name of a `{[string]: V} | null` type-name — the `nullablePartOf`
// (which peels an EXACT `X | null`), when that part is a bare map. "" for anything that is not a
// nullable map (a plain map, a genuine map-member union `{[..]}|X`, a 3-way `{[..]}|X|null`). The
// single chokepoint every `nulmap` classifier strips through, so `mapValNameOf`/`mvValKindOfName`/
// `mapAnnShape` see the inner `{[string]: V}` (never the garbled `boolean}|null` a raw `mapValNameOf`
// of the `| null` name would slice).
export function nulMapInnerName(name: string) {
  const np = nullablePartOf(name)
  if np != "" && nameIsBareMap(np) { return np }
  ""
}
// `1` if the type-annotation node at `tyIx` is a NULLABLE string-keyed map (`{[string]: V} | null`),
// else `0`. The map analogue of `retNulRefFlag`/`retNulRefArrFlag`: a `(ref null $mapStruct)` niche —
// null is `ref.null $mapStruct`, a non-null map value subtypes it (the `struct → nulstruct` relation
// hoisted to the map struct). Gated to the SAME supported value kinds as the non-null `retMapFlag`
// (`mvValKindOfName(mapValNameOf(inner)) != -3`), so a nullable map over an unrepresentable value type
// keeps failing loudly rather than mis-riding this niche. Feeds the `"nulmap"` arm of `vtKindOfType`.
// D-BAREMAP: the DECISION is the arena's (`tyIsNulBareMap` — a `TyNullable` over a `TyMap`,
// 348,214 twin invocations against the name pair, 0 disagreements, 0 uncovered-live); only the
// value-SHAPE payload still needs the inner spelling, so `nulMapInnerName` moved BEHIND the gate.
// It used to run on every `TypeRef` this classifier saw — a `| null` top-level scan plus a bare-map
// test, 348,214 times to answer yes 7,742 times.
export function retNulMapFlag(tyIx: i32) {
  if tyIx >= 0 {
    const ty = P.nodes[tyIx]
    if ty is TypeRef {
      if tyIsNulBareMap(tyIx) {
        if mapValKindLowerable(nulMapInnerName(ty.tyName)) { return 1 }
      }
    }
  }
  0
}

// The map SHAPE (`fbValtype`/`mapTypeIdxOf` second arg) of a string-keyed map type annotation:
// -1 for the mono i32/boolean map (rides the shared `$mapStruct`), or the value type's interned
// mv slot for a `string`-valued map. A non-map / un-interned value type yields -1 (the mono
// shape) — safe, since `retMapFlag` only lets the supported value types reach kind 6. Shared by
// the param valtype (`paramStructIdxOf`), the return valtype, and the body shape resolution
// (`mapShapeOfExpr`) so all three agree on which `$mapStruct` a map param/return is.
export function mapAnnShape(tyIx: i32) {
  if tyIx >= 0 {
    const ty = P.nodes[tyIx]
    if ty is TypeRef {
      // A NULLABLE map annotation (`{[string]: V} | null`) resolves its shape from the BARE inner
      // map — its `(ref null $mapStruct)` cell selects the SAME `$mapStruct` its non-null twin does.
      let mn = ty.tyName
      const nim = nulMapInnerName(mn)
      if nim != "" { mn = nim }
      if nameIsMap(mn) {
        // The KEY selects which map struct family the annotation names — the
        // param/return/nulmap valtype and the body shape must agree on BOTH halves.
        const kAn = nameIsI32KeyedMap(mn)
        const vn = mapValNameOf(mn)
        // A MONO value rides the shared struct of its own key rep: the `-1`/`-4` pair.
        if vn == "i32" || vn == "boolean" { return mapMonoShapeOfKey(kAn) }
        // The arena leg's type comes from THIS annotation node when the checker banked one
        // (D-MAPNODETY): `mapAnnShape` is handed a node index at every one of its call sites
        // (`fn.fnRet`, `d.letType`, `bn.parType`), so the map it is being asked about is
        // exactly the node whose type `nodeMapValTyIx` reads. An UNCOVERED node (-1) keeps
        // the name bridge, unchanged and in its old position.
        let aAn = -1
        const vtAn = nodeMapValTyIx(tyIx)
        if vtAn >= 0 { aAn = mvSlotOfTyK(vtAn, kAn) }
        if aAn < 0 { aAn = mvSlotOfValNameTyK(vn, kAn) }
        if aAn >= 0 { return aAn }
        const nmAn = mvSlotByValNameK(vn, kAn)
        if nmAn >= 0 { return nmAn }
        // A mono-repped value spelling the two scans above never intern (a literal-union
        // atom, a nullable atom) still resolves by KEY alone.
        if kAn { return -4 }
      }
    }
  }
  -1
}

// The map SHAPE of the map PARAM `name` of function `fnIx` (its annotation's value type),
// or -1. Lets `mapShapeOfExpr` resolve a map param's VALUE type instead of assuming mono i32.
function paramMapShape(fnIx: i32, name: string) {
  if fnIx < 0 { return -1 }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const params = fn.fnParams
    let i = 0
    while i < params.length {
      const p = P.nodes[params[i]]
      if p is Param {
        if p.parName == name { return mapAnnShape(p.parType) }
      }
      i = i + 1
    }
  }
  -1
}

// The map SHAPE a function `name` RETURNS (its return annotation's value type), or -1 (the mono
// map / an un-annotated return whose shape is not annotation-derived). Lets a caller resolve the
// VALUE type of `mk()[k]` over a `string`-valued map factory.
function fnRetMapShapeSid(sid: i32) {
  const fe = fnIndexOfSid(sid)
  if fe >= 0 {
    const fn = P.nodes[fnStmts[fe]]
    if fn is FuncDecl {
      if fn.fnRet >= 0 { return mapAnnShape(fn.fnRet) }
      // An UN-annotated map return (`function passthru(m) { return m }`): derive the shape from
      // the returned expression (a map param/local/`Map()`), so a caller of a `string`-valued
      // map factory resolves the value type.
      const rx = fnRetExprOf(fnStmts[fe])
      if rx >= 0 { return mapRetExprShape(rx, fe) }
    }
  }
  -1
}

// `1` if the type-annotation node at `tyIx` names a union VARIANT struct (e.g. `TyObj`
// of `Ty`), else `0`. Feeds the `kind == 8` (concrete variant struct ref) branch of
// `pushVT`. A variant-struct param/result is the unboxed variant ref directly — gap #2.
export function retVariantFlag(tyIx: i32) {
  if tyIx >= 0 {
    // STRUCTURAL fast-path (C1): the checker recorded this node's type as a union-variant member.
    if nodeTyIsVariant(tyIx) { return 1 }
    return 0
  }
  0
}

// `1` if the type-annotation node at `tyIx` names the declared union alias, else `0`.
// Feeds the `kind == 4` (union box) branch of `pushVT`.
export function retUnionFlag(tyIx: i32) {
  if tyIx >= 0 {
    // STRUCTURAL fast-path (C1): the checker recorded this node's type as a declared value-union box.
    if nodeTyIsUnionAlias(tyIx) { return 1 }
    return 0
  }
  0
}

// The `pushVT` `VKind` for a parameter node at `paramIx` (`"struct"`, `"list"`,
// `"str"`, `"i32"`, …) — its annotation's `vtKindOfType`, or `"i32"` for a node
// that is not a `Param`.
export function vtKindOfParam(paramIx: i32): VKind {
  const p = P.nodes[paramIx]
  if p is Param { return vtKindOfType(p.parType) }
  "i32"
}

// The second `fbValtype` arg for the parameter node at `paramIx` (from its annotation).
// For a STRUCT param (kind 1) this is its struct table index (or -1); for a REF-ARRAY
// param (kind 5) it is the ref-list TABLE SLOT for the element type (`B[]` → B's slot)
// — `fbValtype`'s kind-5 arm now indexes `rlWrapIdx[slot]`, so it must NOT collapse to
// -1/slot 0. Mirrors `tyAnnRefListSlot` (how `let`/return annotations resolve `T[]`).
export function paramStructIdxOf(paramIx: i32) {
  const p = P.nodes[paramIx]
  if p is Param {
    if retRefArrFlag(p.parType) == 1 { return tyAnnRefListSlot(p.parType) }
    // A NULLABLE ref-array param (kind 18) — its `(ref null $wrapper)` slot is the inner ref-list
    // element wrapper (`tyAnnRefListSlot` is `| null`-aware), mirroring the non-null ref-array above.
    if retNulRefArrFlag(p.parType) == 1 { return tyAnnRefListSlot(p.parType) }
    // A string-keyed MAP param's second `fbValtype` arg is the map SHAPE (mono ⇒ -1, or the
    // value type's mv slot for a `string`-valued map), so the param valtype selects THIS map's
    // `$mapStruct`.
    if retMapFlag(p.parType) == 1 { return mapAnnShape(p.parType) }
    // A NULLABLE map param (`{[string]: V} | null`, kind `nulmap`) — the SAME map SHAPE selects its
    // `(ref null $mapStruct)` cell's heap type (`mapAnnShape` is `| null`-aware).
    if retNulMapFlag(p.parType) == 1 { return mapAnnShape(p.parType) }
    // A concrete-VARIANT param (kind 8) — its `fbValtype` slot is the VARIANT index
    // (`uVarHeap[vi]`), which `retStructIndex` (standalone structs) misses.
    if retVariantFlag(p.parType) == 1 {
      const ptv = P.nodes[p.parType]
      if ptv is TypeRef { return variantIndexOf(ptv.tyName) }
    }
    return retStructIndex(p.parType)
  }
  -1
}

// The `pushVT` `kind` for a module global from its literal INITIALIZER at `initIx`:
// `1` struct ref (object literal), `2` list ref (array literal), `3` string ref (string
// literal), else `0` i32. The global's valtype must match the init's wasm type so the
// constexpr validates; the literal cases are the only ones in scope (a non-literal init
// fails loudly when `emitExpr` lowers it as a constexpr with `fnIx = -1`).
function globalKind(initIx: i32): VKind {
  if initIx < 0 { return "i32" }
  const e = P.nodes[initIx]
  // A function-literal init (`const add = function(...)...`) — or a bare reference to a
  // top-level function name in value position — is a closure fat-pointer cell (kind 14).
  if e is FuncDecl { return "closure" }
  if e is Ident {
    if fnIndexOfSid(sidOfNode(initIx)) >= 0 { return "closure" }
  }
  // An un-annotated float `.` literal init (`const a = 1.5`) is an f64 cell (kind 11),
  // lowered as `f64.const`. (Slice 3 — additive; bare integer globals stay kind 0.)
  if e is NumLit {
    if numTextIsFloat(e.numText) { return "f64" }
  }
  if e is ObjLit {
    // A literal matching a standalone struct is that struct ref (kind 1) — even in a
    // union program. Otherwise, in a union program it boxes into the union (kind 4).
    if structIndexOfObj(initIx) >= 0 { return "struct" }
    if uDeclared { return "union" }
    return "struct"
  }
  if e is ArrayLit {
    // A ref-element array literal is a ref list (kind 5); a STRING-element literal
    // is the string list (kind 7); an f64-element literal is the f64 list (kind 12,
    // Slice 4); an i32/empty literal is the i32 list (kind 2). A module-global empty
    // `[]` over a ref type is out of scope (a global ref-list constexpr needs the
    // binding annotation — deferred).
    if arrLitIsRef(initIx) { return "reflist" }
    if arrLitIsStr(initIx, -1) { return "strlist" }
    if arrLitIsF64(initIx, -1) { return "f64list" }
    if arrLitIsI64(initIx, -1) { return "i64list" }
    return "list"
  }
  if e is StrLit { return "str" }
  // A NON-LITERAL initializer (a concat `"a" + "b"`, a `fromCodePoint(...)` or
  // user-function call, a reference to another global): classify via the expression
  // family with no enclosing function (`fnIx = -1`) — the same predicates the local
  // `letIs*` ladder uses. The cell zero-inits (`ref.null` via the non-const path)
  // and the start function `global.set`s the computed value. An i32-producing
  // expression matches none of these and stays kind 0 — programs without ref-typed
  // global expressions emit byte-identical bytes.
  // A non-literal init that evaluates to a function value — a call returning a closure
  // (`const f = makeAdder(5)`) or a member read of a function-valued field (`const h =
  // o.go`) — is a closure fat-pointer cell (kind 14). Checked FIRST among the
  // expression-family cases (it never overlaps the others, and only fires in a program
  // that uses function values, so non-closure globals stay byte-identical).
  if exprIsClosure(initIx, -1) { return "closure" }
  if exprNullableStruct(initIx, -1) { return "nulstruct" }
  if exprMap(initIx, -1) { return "map" }
  if exprString(initIx, -1) { return "str" }
  if exprStringArray(initIx, -1) { return "strlist" }
  if exprRefArray(initIx, -1) { return "reflist" }
  if exprF64Array(initIx, -1) { return "f64list" }
  if exprI64Array(initIx, -1) { return "i64list" }
  if exprF32Array(initIx, -1) { return "f32list" }
  if exprUnion(initIx, -1) { return "union" }
  if exprStruct(initIx, -1) { return "struct" }
  if exprArray(initIx, -1) { return "list" }
  // A SCALAR f32 non-literal init (an f32 map-`??` read, f32 arithmetic, an f32-returning
  // call) — kind 13, the module-scope analogue of the local `letIsF32` inference. Without
  // this arm the cell stays i32 while the start-fn stores an f32 — invalid wasm.
  //
  // Asked BEFORE the f64 arm, which is the ORDER `exprIsF32`'s own header states ("checked
  // BEFORE `exprIsF64` at every dispatch") and `emitExprAsF64`'s opening comment restates —
  // and which this ladder alone did not obey. `exprIsF64` OVER-CLAIMS a mixed f32/float-
  // literal init: `fv * 1.0` is `exprIsF32` (the literal adapts down) AND `exprIsF64` (the
  // literal is a genuine `.` literal), so the f64 arm took the cell while the start-fn init
  // (`emitExprAsF64` → its own f32-first arm) emitted `f32.mul` and every READ of the cell
  // (`print`, `f32bits`, an f32 argument) classified it f32 off the checker's `nodeTyIx`.
  // `vl check` clean, INVALID WASM. A bare float literal is NOT `exprIsF32`, so `const g =
  // 1.5` still takes the f64 arm below, and a GENUINE f64 operand (`fv + dv`, `dv * 1.0`)
  // makes `exprIsF32` false through `binMixHardF64` — so the f64 cells are untouched.
  if exprIsF32(initIx, -1) { return "f32" }
  // A SCALAR f64 / i64 non-literal init (f64 / i64 ARITHMETIC `2.0 + 4.5`, or an
  // f64-returning call `dbl(2.0)`) — kind 11 / 10, the module-scope analogue of the local
  // `letIsF64` / `letIsI64` inference (which is gated to inside a function). A single
  // float literal already classifies above; this covers the COMPOSITE init. (`exprIsF64`
  // /`exprIsI64` may recurse into another global, terminating for an acyclic program — the
  // same shape the `exprString` / `exprStruct` cases above already rely on.)
  if exprIsF64(initIx, -1) { return "f64" }
  if exprIsI64(initIx, -1) { return "i64" }
  "i32"
}

// Whether the module global `name` has a non-const initializer — used at READ sites
// (`global.get`) to decide whether the (nullable) cell needs a `ref.as_non_null`.
export function globalNameIsNonConst(name: string) {
  globalIsNonConst(globalLetOf(name))
}

// The sid-taking primitive (R5): `emitIdentNode` already holds the identifier's id.
export function globalNameIsNonConstSid(sid: i32) {
  globalIsNonConst(globalLetOfSid(sid))
}

// The `fbValtype` kind for a module global's CELL. When the binding has a TYPE
// ANNOTATION (const init OR not), the kind is derived from that annotation via the
// `letIs*` ladder — so a global agrees with a same-typed local/param/field on its
// valtype (kind + struct index). Only an UN-annotated const global (`let g = { … }`,
// no `: T`) falls back to the literal-initializer kind (`globalKind`); the `g_globals`
// golden's struct global IS annotated, and its annotation names the SAME struct its
// literal infers, so the emitted bytes are unchanged. A non-const init's literal kind is
// meaningless (member/index/call), so it likewise rides the annotation ladder. Mirrors
// `buildLocals`' annotation→kind ladder (map 6, string-array 7, ref-array 5, struct 1,
// array 2, string 3, else i32 0).
export function globalCellKind(letIx: i32): VKind {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if globalHasTypeAnn(letIx) {
      // A NULLABLE-function global (`let g: ((i32) => i32) | null = inc`) is a nullable
      // closure cell (kind 19) — checked BEFORE the bare-function kind 14, mirroring
      // `vtKindOfType` / `fieldTypeCode`: `((i32) => i32) | null` is a nullable function,
      // whereas `(i32) => i32 | null` is a function returning a nullable.
      if nulCloFlagAnn(d.letType) == 1 { return "nulclosure" }
      // A function-typed global (`const g: (i32) => i32 = inc`) is a closure fat-pointer
      // cell (kind 14), like a function-valued local.
      if tyIsFuncType(d.letType) { return "closure" }
      if letIsNulRef(letIx, -1) { return "nulstruct" }
      // A NULLABLE ref-array global (`(P | null)[] | null`, `S[] | null`, `i32[][] | null`) —
      // kind 18, a `(ref null $rlWrap)` cell over the inner ref-list's wrapper — BEFORE the
      // i32-backed `nullist` (which `nameIsRefArray`, hence `letIsNulRefArray`, excludes). The
      // local ladder's `letIsNulRefArray` arm, mirrored so a global agrees with a same-typed
      // local on its wrapper heap type (without it the cell fell through to the mono i32-list
      // wrapper while the init built the reflist wrapper — INVALID-WASM at `global.set`).
      if letIsNulRefArray(letIx, -1) { return "nulreflist" }
      if letIsNulList(letIx, -1) { return "nullist" }
      // A DISTINCT-backing nullable scalar list global (`string[]|null`, `f64[]|null`,
      // `i64[]|null`, `f32[]|null`): its own `(ref null $wrapper)` cell — BEFORE the non-null
      // list arms (whose init fallback would else claim a bare list value as a non-null cell).
      const gNulSL = nulScalarListKindOfNode(d.letType)
      if gNulSL != null { return gNulSL }
      // A NULLABLE map global cell (`let g: {[string]: V} | null = …`, kind `nulmap`) — BEFORE
      // `letIsMap` (a nullable annotation/init must not collapse to the non-null `"map"` cell).
      if letIsNulMap(letIx, -1) { return "nulmap" }
      if letIsMap(letIx, -1) { return "map" }
      // A UNION-annotated global cell is the box ref (kind 4), exactly as `buildLocals`
      // classifies a union local — BEFORE the struct/string/scalar-list cases (a `string |
      // i32` / `f64[] | string` annotation is none of those, and a scalar-list INIT must not
      // claim the cell). `S | null` / `boolean | null` never register as union names (they
      // keep their niche kinds above).
      if letIsLitUnion(letIx) { return "i32" }
      // A `K | null` NICHE global (`const g: K0 | null = "404"`) — the i32 atom cell
      // with the `-1` null sentinel, the nullable twin of the litunion arm above.
      // BEFORE `letIsString`, whose init fallback claimed a member-literal init as a
      // STRING-ref cell while the read side classified the niche i32 — INVALID-WASM
      // (fuzz post-#1000 sweep plain leg, `K0 | null` p3r).
      if nodeTyIsNulLitUnion(d.letType) { return "i32" }
      if letIsUnion(letIx, -1) { return "union" }
      if letIsStringArray(letIx, -1) { return "strlist" }
      if letIsRefArray(letIx, -1) { return "reflist" }
      if letIsF32Array(letIx, -1) { return "f32list" }
      if letIsF64Array(letIx, -1) { return "f64list" }
      if letIsI64Array(letIx, -1) { return "i64list" }
      if letIsStruct(letIx, -1) { return "struct" }
      if letIsArray(letIx, -1) { return "list" }
      if letIsNulString(letIx, -1) { return "nulstr" }
      if letIsString(letIx, -1) { return "str" }
      if letIsI64(letIx, -1) { return "i64" }
      if letIsF64(letIx, -1) { return "f64" }
      if letIsF32(letIx) { return "f32" }
      return "i32"
    }
    // No annotation: a const literal init types itself; a non-const un-annotated init is
    // out of scope (no annotation to derive from) and `globalKind` returns its best guess.
    // An empty `[]` whose PUSHES infer a string element is the string list (kind 7).
    if letInfStrListByUse(letIx) { return "strlist" }
    // THE TWO NULLABLE CELLS THE UN-ANNOTATED ARM NEVER GREW. The annotated arm above
    // opens with `nulclosure` and carries `nullist` in the middle of its ladder; the
    // un-annotated arm had neither, so `const g = mk()` with a `((i32) => i32) | null` /
    // `i32[] | null` return fell through to `globalKind`, whose expression family answers
    // `"closure"` / `"i32"` for exactly those two. The cell then disagreed with the value
    // the start fn stores into it — a loud reject at the `!= null` compare in most
    // spellings, and INVALID WASM (`expected i32, found (ref null $type)`) for the
    // field-read init, which is the same class the annotated `nulScalarList` arm below
    // was added to close. Their ORDER mirrors the annotated ladder exactly (nulclosure
    // first, nullist before the distinct-backing scalar lists).
    //
    // The read sides need no separate widening: `exprNulClosure`'s global arm already
    // asks `globalCellKind`, and `globalIsNulList` now asks `letIsNulListInfer` — the
    // same predicate this arm uses.
    if letInfersNulClosure(letIx, -1) { return "nulclosure" }
    if letIsNulListInfer(letIx, -1) { return "nullist" }
    // A DISTINCT-backing nullable scalar list (`string[]|null`, `f64[]|null`, `i64[]|null`,
    // `f32[]|null`) bound to a CALL (`const r = mk()`): its own `(ref null $wrapper)` cell,
    // exactly as the ANNOTATED arm above spells it — but resolved through the BINDING
    // (`letNulScalarListKind` falls through to the init's `exprNulScalarListKind`), because
    // there is no annotation node to read. BEFORE the nulmap/union arms and before the
    // literal-init fallback, whose call-init guess is the i32 cell: an i32 global taking the
    // list wrapper ref is INVALID-WASM at the start function's `global.set`. Found by
    // re-running the rep-kind sweep rather than inheriting its verdict — four kinds, not one.
    const gNulSLU = letNulScalarListKind(letIx, -1)
    if gNulSLU != null { return gNulSLU }
    // An un-annotated global bound to a `{[string]: V} | null`-returning call
    // (`const r = mk()`) carries the `nulmap` cell — a `(ref null $mapStruct)` — as a
    // local would. BEFORE the union arm (a nullable map is a niche, not the box) and
    // before the literal-init fallback, whose call-init guess is the i32 cell: an i32
    // global taking the map ref is INVALID-WASM at the start function's `global.set`.
    if letIsNulMap(letIx, -1) { return "nulmap" }
    // An un-annotated global whose init PRODUCES a union (`const a = make(42)` with
    // a union-returning `make`) carries the box (kind 4), as a local would.
    if letIsUnion(letIx, -1) { return "union" }
    // An un-annotated global bound to a `string | null`-returning call (`const r = f()`)
    // carries the kind-16 nullable-string cell, as a local would.
    if letIsNulString(letIx, -1) { return "nulstr" }
    return globalKind(d.letInit)
  }
  "i32"
}

// The struct table index for a global cell of kind 1 (struct ref), else -1. When the
// binding has a struct ANNOTATION the index comes from THAT annotation (`structIndexOfLet`,
// which prefers the annotation over the init) — so a struct global agrees with a same-
// typed local/param/field. An un-annotated const struct global infers from its literal.
export function globalCellStructIdx(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if globalHasTypeAnn(letIx) { return structIndexOfLet(letIx, -1) }
    return structIndexOfExpr(d.letInit, -1)
  }
  -1
}

// The ref-list TABLE SLOT for a kind-5 (ref array) global cell: the annotation's
// element type when present, else the element type INFERRED from the initializer —
// so an un-annotated `const g = [[1,2]]` declares ITS OWN wrapper type, not slot 0's
// (two un-annotated ref-list globals of distinct element types would otherwise both
// declare the first's wrapper and fail validation). 0 (slot fallback) if unresolvable.
export function globalRefListSlot(letIx: i32) {
  const s = letRefListSlot(letIx, -1)
  if s < 0 { return 0 }
  s
}

// True if the type-name `name` refers to one of the declared struct types.
export function isSName(name: string) { structIndexByName(name) >= 0 }

// The ref-array SHAPE ladder — the ONE home of the arms `nameIsRefArray` and
// `refArrElemKind` each carried as its own hand-copied copy (destringify
// D-REFARRKIND; D-FIELDCODE's move applied to the ref-list layer, which
// `refArrElemName`'s own header already flagged: "Mirrors `refArrElemKind`", and
// "Keyed exactly like `nameIsRefArray`'s bridge (the two must agree)"). Returns
// the ref-list ELEMENT KIND a name's SHAPE decides, or **-1 when no shape arm
// claims it** — the caller's own BASE arm (the one arm whose EVIDENCE differs
// between the two entry points: a boolean over four element tables vs a
// union-vs-struct kind over one) then answers.
//
// The five `(…)`-grouped arms are a PROJECTION OF ONE VALUE (method note 2): the
// paren-union element and its nullable part decide all of nullable-struct /
// nullable-map / nullable-list / nullable-closure / value-union, and both copies
// re-derived them per arm — `parenUnionArrElemName` ran **5x** and
// `nullablePartOf` **4x** on one spelling inside `refArrElemKind` alone (each
// `parenUnionArrElemName` is itself an `annArrowAt` depth scan plus up to two
// `unionMemberCount` splits). They are resolved ONCE here.
function refArrShapeKind(name: string): i32 {
  // `i32[][]`, `boolean[][]`, and literal-union `K[][]` all carry the i32-list wrapper element
  // (kind 4) — one i32[] backing (`nameIsI32ListArray`), not three special cases.
  if nameIsI32ListArray(name) { return 4 }
  // Nested lists of a NON-i32 scalar/string element — the element is that inner list's
  // WRAPPER (kinds 6/7/8 → `mkListIdx` / `fl64TypeIdx` / `il64TypeIdx`). Used for a
  // string[]/f64[]/i64[]-VALUED map's vals ref-list (the value analogue of `i32[][]` kind 4).
  if nameIsArray(name) && nameIsStringArray(arrElemNameRaw(name)) {
    // `string[][]` AND the niche `(string | null)[][]`: the element is the string-list
    // wrapper (`$mkListIdx`) either way — the nullable rides INSIDE the inner elements.
    return 6
  }
  // The three NON-i32 scalar leaves, asked the way the `string[][]` arm above already
  // asks its own: the array grammar's ONE CUT (`arrElemNameRaw`), taken ONCE for the
  // whole arm set, then each inner list named by the one-line home that IS that leaf
  // (`nameIsF64Array` is `arrElemNameRaw(n) == "f64"`, so the pair is `name == "f64[][]"`
  // over every input, not merely over the inputs tried). Unlike `nameIsStringArray`
  // directly above, these three homes are SPELLING-EXACT, not rep-wide — the `(f64 |
  // null)[]` niche has no shared backing to widen them.
  const inner2 = arrElemNameRaw(name)
  if nameIsF64Array(inner2) { return 7 }
  if nameIsI64Array(inner2) { return 8 }
  if nameIsF32Array(inner2) {
    return 10 // f32 inner list (element is the `$fl32TypeIdx` wrapper)
  }
  // A NESTED REF array (`S[][]`, `(C|D)[][]`, `((i32)=>i32)[][]`, `S[][][]`, …): the element is
  // itself a ref array, stored as the inner list's WRAPPER — kind 9. Recurses to any depth via
  // the interned inner slots. The scalar-leaf 2D names above are NOT ref arrays at the inner
  // level (a scalar inner list is a singleton wrapper), so they keep their explicit kinds.
  if nameIsArray(name) && nameIsRefArray(refArrElemName(name)) { return 9 }
  if nameIsMapArray(name) { return 3 }
  // === the PAREN-GROUPED element, resolved ONCE ===
  // A `(…)[]` annotation whose element is a top-level union. Five former arms
  // (`nullStructArrElem` / `nullMapArrElemOf` / `nullArrayArrElem` /
  // `nullClosureArrElem` / `parenUnionArrElemName`) each re-derived this element,
  // and four of them re-derived its `| null` part; every one of the five declines
  // when the element is not paren-grouped, so ONE lookup gates all of them and the
  // arm ORDER inside is byte-for-byte the order `refArrElemKind` tested them in.
  const pun = parenUnionArrElemName(name)
  if pun != "" {
    const nn = nullablePartOf(pun)
    if nn != "" {
      // A `(P | null)[]` nullable-struct array is a STRUCT ref list (kind 1) — its element is a
      // `(ref null $P)` niche, not a union box. Checked before the value-union fall-through.
      if structIndexByName(nn) >= 0 { return 1 }
      // A `({[string]: V} | null)[]` nullable-MAP array is a MAP ref list (kind 3) — the same
      // `(ref null $mapStruct)` backing the non-null map element uses; the slot key keeps the
      // `| null` so the index read stays nullable (`rlElemNullable`) for the `e != null` narrow.
      // `nameIsBareMap` is #1139's one home for this pair — adopted here rather than
      // re-inlining the conjunction that slice had just finished collapsing.
      if nameIsBareMap(nn) { return 3 }
      // A `(i32[] | null)[]` nullable-LIST array reuses the inner list's OWN rep — kind 4 for an
      // i32-backed inner, 6/7/8/10 for a distinct-backing scalar/string inner, 9 for a ref inner.
      // Its element is a `(ref null $wrapper)` niche, not a union box. The inner kind is read by
      // re-forming the inner ARRAY name once; master reached the same value by running
      // `nullArrayArrElem` twice (test then value) and then re-running the ladder on its result —
      // **three** `refArrElemKind` walks and three `elem + "[]"` allocations per hit, for one kind.
      // The kind-SET gate is kept VERBATIM and is measured DEAD: a probe counting
      // every reach and every refusal read **2,227 reaches / 0 refusals** (1,621
      // corpus + 606 fuzz). It is expected to be unreachable — `nameIsArray(nn)`
      // makes `nn + "[]"` a 2-D array name, and every 2-D array lands on one of
      // 4/6/7/8/9/10, while kinds 1/2/3/5 all require a NON-array element. Kept
      // anyway: "measured dead" is not "proven dead", it costs one compare, and
      // removing it would be a behaviour change no channel can pin (sabotage S6).
      if nameIsArray(nn) {
        const ik = refArrElemKind(nn + "[]")
        if ik == 4 || ik == 6 || ik == 7 || ik == 8 || ik == 9 || ik == 10 {
          return ik
        }
      }
      // A `(((i32) => boolean) | null)[]` nullable-CLOSURE array is a closure ref list (kind 5)
      // — its element is a `(ref null $cloStruct)` niche, not a union box. Checked before the
      // value-union fall-through below (whose kind-2 box has no rep for a niche-nullable closure).
      if nameIsFuncTypeAtom(nn) { return 5 }
    }
    // A `(string|i32)[]` value-union element list is a union-box list (kind 2).
    return 2
  }
  // An `((i32) => i32)[]` array of functions is a closure-element list (kind 5).
  if nameIsClosureArray(name) { return 5 }
  -1
}

// The struct-table index for a ref-list element NAME, stripping a `| null` niche suffix first
// (a NULLABLE-struct array's slot keys on the full `"P | null"`, but the struct it stores/reads
// is the bare `P`). Nominal first (`structIndexByName`), then the structural bridge
// (`structIndexOfTypeName`): an INLINE-SHAPE element spelling (`{v:i32}` of a `{v:i32}[]`
// param) that `collectAnnShapes` deduped onto its declared twin has no `sNames` entry of its
// own, so only the layout-guarded field-set match resolves it.
//
// MEASURED DEAD BELOW THE FIRST RUNG (D-PARENCLASSIFY). This function is called from ONE
// place, `forInRefArrayStructIdx`, on **8 of 1,416** corpus files and on **0 of 50,400** fuzz
// programs — and on all 8, the nominal `structIndexByName` consult ANSWERS, so neither the
// `repRowOfName` round trip nor the fieldset scan below it ever executes. A poison probe at
// the `repRowOfName` call reads 0 on both channels; the same probe mechanism fires 105 corpus
// / 2,003 fuzz at `nulBaseStructRow` and 44 / 633 at `shapeElemDeclaredStructIdx`, so the
// zero is agreement on the corpus and blindness in fuzz (where this function is never
// entered at all — a positive control on ENTRY reads 0/84 too). Neither rung is deleted on
// that: an unreached rung is not a wrong one, and the population that reaches it is exactly
// the population no test writes yet. See `emit_rep.repRowOfName`'s header for the census and
// for the arena route this caller could take the day it matters.
export function structIdxOfElemName(name: string) {
  const n = nonNulBaseOf(name)
  // Nominal exact-name match first (unambiguous, byte-identical, cheap).
  const sbn = structIndexByName(n)
  if sbn >= 0 { return sbn }
  // NODE ROUTE (rep-slot-layer p2): the element NAME here is the row name
  // `arrLitElemName`/`structIndexOfObj` recorded for the list-element literal — the
  // FAITHFUL spelling of the element's ADOPTED type (its same-fieldset ambiguity is
  // node-routed at #1061's `structIndexOfObjCtx`). Resolve it through the canon-key
  // vocabulary (`repRowOfName` → `resolveAnnot` → `repRowOfTyStruct`, the
  // `slotCanonKey == repCanonKey` pick under the `structFieldCodesEq` layout gate),
  // which distinguishes a same-fieldset NESTED twin (`{f: {f: i64 | null}}` vs its
  // inner `{f: i64 | null}` row) by the FULL nested field type — the pick the
  // fieldset scan below reaches only by leaning on `shapeFieldTypeCompat`'s
  // whole-span refutation arms (arm 2 #978) to DECLINE the wrong twin. Consuming the
  // adopted type directly (the #1015–#1019 "stop re-deriving from a render"
  // principle) is #1061's ObjLit route one level down, at the list ELEMENT's backing
  // slot — the second, name-only caller that kept arm 2 load-bearing. AFTER the
  // nominal `structIndexByName` consult, BEFORE the fieldset scan (the #1061
  // AFTER-not-FIRST placement, run-identical): trust the arena when it covers the
  // element (>= 0); fall to the legacy fieldset scan when it declines (`repRowOfName`
  // returns -1/-2 — non-`TyObj`, no dedup-participating row, or an ambiguous
  // atom-vs-plain collision it must NOT guess through, which the name path keeps).
  const rr = repRowOfName(n, sScanLim())
  if rr >= 0 { return rr }
  structIndexOfTypeName(n)
}

// (`nullStructArrElem` / `nullMapArrElemOf` / `nullArrayArrElem` lived here. All
// three opened with the SAME two lines — `parenUnionArrElemName(name)` then
// `nullablePartOf(elem)` — and differed only in the one predicate they applied to
// the result, so each was a projection of one value that its two callers computed
// separately. They are now the four consecutive arms of `refArrShapeKind`'s
// paren-grouped block, which derives that value once. Their rep contracts are
// recorded arm-by-arm there.)

// The DECLARED-struct index an inline-SHAPE element spelling (`{v:i32}` of a
// `{v:i32}[]` annotation) resolves to via the structural bridge
// (`structIndexOfTypeName`), or -1. GATED on a DECLARED twin
// (`nameIsStructDecl`): an inline spelling matching only an anonymous-literal /
// interned-shape slot keeps its legacy classification — admitting it would
// route a shape-armed union (`t is {f: boolean}[]` over an inferred closure-call
// binding) into the union-arm narrow machinery, whose read side still
// mis-lowers that flow (the pre-existing nominal `T[]`-arm hole), so the loud
// REJECT must hold until that path is fixed. A non-`{...}` base fast-rejects.
function shapeElemDeclaredStructIdx(base: string) {
  if !nameIsShapeOpen(base) { return -1 }
  // NODE-LESS caller (rep-intern P2): `base` is an INLINE SHAPE `{…}` element
  // spelling — route it through the canonical-key vocabulary (`repRowOfName` →
  // `resolveAnnot(renderFaithful)` → `repRowOfTyStruct`, the `slotCanonKey ==
  // repCanonKey` pick under the `structFieldCodesEq` layout gate) rather than the
  // lenient fieldset scan (`structIndexOfTypeName` → `shapeFieldTypeCompat` arm 2),
  // which distinguishes a same-fieldset NESTED twin (`{f: {f: i64 | null}}` vs its
  // inner `{f: i64 | null}` row) by the FULL nested field type. Falls to the
  // fieldset scan when the arena declines (`repRowOfName` < 0: non-`TyObj`, no
  // dedup-participating row, or an atom-vs-plain collision it must not guess
  // through). The `nameIsStructDecl` gate is PRESERVED — the anonymous-shape-armed-
  // union element loud reject must still hold on whatever row resolves.
  let si = repRowOfName(base, sScanLim())
  if si < 0 { si = structIndexOfTypeName(base) }
  if si < 0 { return -1 }
  if nameIsStructDecl(sNames[si]) { return si }
  -1
}

// True if the array type-name `name` is a REF-element list — `S[]` over a declared
// struct, `N[]` over the declared union alias (the box-ref element), or `{[string]:i32}[]`
// (a map-struct element). Either lowers to the `{ backing: (ref $raTypeIdx), len, cap }`
// wrapper over a `(ref null $elem)` backing (G7-ref). A non-`[]` name or an `i32[]` is
// NOT a ref array. The element name is recovered by checking each declared struct/union
// name + `"[]"` (a `string + string` concat; a `string + i32` would be a type error).
export function nameIsRefArray(name: string) {
  // A TOP-LEVEL arrow is a FUNCTION TYPE (`(i32) => S[]` — a closure RETURNING an array), NEVER a
  // ref array, even though it ends in `[]`. Guarded first so a closure-returning-array LOCAL /
  // param / result is classified as the closure fat-pointer, not mis-picked as a ref-list rep (the
  // array-of-closures `((i32) => i32)[]` has its arrow NESTED, so `annArrowAt` — paren-aware —
  // returns -1 and that case still reaches `nameIsClosureArray` below).
  if annArrowAt(name) >= 0 { return false }
  // A literal-union array (`K[]`) is an i32 ATOM array, NOT a ref list — exclude it before the
  // union-name match below (a literal union registers as a union name, which would otherwise
  // mis-claim `K[]` as a union-box ref array, the wrong rep). Both guards are THIS entry
  // point's alone: `refArrElemKind` is specified on a name already known to be a ref array,
  // so folding them into the shared ladder would change its answers.
  if nameIsLitUnionArray(name) { return false }
  // Every SHAPE-decided arm — the i32/string/scalar 2D leaves, the nested-ref recursion, the
  // map list, the five paren-grouped element arms and the closure list — is `refArrShapeKind`
  // (destringify D-REFARRKIND). This entry point only needs "did any arm claim it", so the
  // kind is discarded; what it deletes is the SECOND hand-written copy of that ladder, and
  // with it the two arms (`nullStructArrElem` / `nullArrayArrElem`) that were tested FIRST
  // here and are strictly SUBSUMED by the `parenUnionArrElemName` arm below them: both
  // require a paren-grouped element, every arm between them and it returns only `true`, and
  // `nullArrayArrElem` reached its verdict by running the WHOLE `refArrElemKind` ladder on a
  // freshly concatenated `elem + "[]"` — an entire second ladder walk, per call, to answer a
  // boolean the arm five lines down already answered.
  if refArrShapeKind(name) >= 0 { return true }
  // Otherwise a `<Struct>[]` / `<Union>[]`: strip the trailing `[]` ONCE and match the bare
  // element NAME against the struct/union tables. (The old form compared `name` to
  // `sNames[i] + "[]"` — a fresh string allocation PER struct PER call; on a struct-heavy
  // program this `O(structs)` garbage dominated emit time + GC. The strip-once form does the
  // same match with no per-iteration allocation.)
  if nameIsElemArray(name) {
    const base = arrElemNameRaw(name)
    if structIndexByName(base) >= 0 { return true }
    // An INLINE-SHAPE element (`{v:i32}[]`) whose shape deduped onto a DECLARED
    // struct at intern time (so the spelling has no `sNames` entry): the
    // structural bridge resolves it — the shape-vs-declared twin of `S[]`.
    if shapeElemDeclaredStructIdx(base) >= 0 { return true }
    // A `Cat[]` over a concrete union VARIANT — a ref list of bare variant structs.
    if variantIndexOf(base) >= 0 { return true }
    let u = 0
    while u < unNames.length {
      if base == unNames[u] { return true }
      u = u + 1
    }
  }
  false
}

// The ref-element kind for an array type-name (assumes `nameIsRefArray(name)`):
// `1` = a struct element, `2` = a union-box element (`uBoxIdx`), `3` = a map-struct
// element (`mStructIdx`, the scope-chain `{[string]:i32}[]`).
// Intern the ref-list slot whose ELEMENT type is `elemName`, recursively interning a nested
// inner list's element slot FIRST — so the inner wrapper lands at a LOWER type index and the
// outer element heap (`rlElemHeap`, kind 9) resolves to it. The DRY core that makes arbitrary
// `X[]…[]` nesting of any ref leaf (struct / union / closure) fall out: interning is inner-first,
// recursively, bottoming out at the leaf array (whose element is not itself a ref array, k != 9).
export function ensureRefElem(elemName: string) {
  ensureRefElemTy(elemName, -1)
}

// `ensureRefElem` with the caller's RECORDED arena type for `elemName` (destringify
// D-REPELEMTY), threaded to `rlInternNameTy` for the slot KEY and to nothing else: every
// classification below still reads the spelling, and the intern still MINTS on a miss.
// `ty` -1 = no hint.
//
// THE k==9 RECURSION IS DELIBERATELY UNHINTED. `tyRefArrElemOf(ty)` is `refArrElemName`'s
// structural dual for ONE peel, but this recursion peels a name the arm has already
// re-formed and re-classified, and the two disagree: 2 of 94 covered entries over the
// corpus (`nm=S A=i32 L=S0`). An arena rung at a MINT site has to be equal by
// construction or it re-keys a row; this one is not, so it stays a name.
export function ensureRefElemTy(elemName: string, ty: i32) {
  if elemName == "" { return -1 }
  // Re-form the element's ARRAY name to read its kind. A nullable-LIST element (`i32[] | null`) needs its
  // grouping parens back (`(elem)[]`) — without them `refArrElemKind` mis-reads `i32[] | null[]` as a
  // plain struct element (kind 1) instead of the kind-4 nullable-i32-list element. Scoped to a nullable
  // element whose non-null part is an ARRAY, so value-union (`i32 | null`) / nullable-struct (`P | null`)
  // elements keep their existing (munged-name) kind and are unaffected.
  let arrName = elemName + "[]"
  const enp = nullablePartOf(elemName)
  if (
    enp != "" &&
    (nameIsArray(enp) || nameIsFuncTypeAtom(enp) || nameIsBareMap(enp))
  ) {
    // A nullable-LIST element (`i32[] | null`), a nullable-CLOSURE element
    // (`((i32) => boolean) | null` — the kind-5 niche), and a nullable-MAP element
    // (`{[string]: V} | null`) all need their grouping parens back to read the kind.
    arrName = "(" + elemName + ")[]"
  } else if (
    parenUnionArrElemName("(" + elemName + ")[]") != "" &&
    (isValueUnionName(elemName) || nullablePartOf(elemName) == "")
  ) {
    // A VALUE-UNION / heterogeneous-union element (`f64 | {w: i32}`, `K0[] | {w: i32}`) — nested as the
    // element of an outer array (`(f64 | {w: i32})[] | null` reached via the kind-9 recursion below, or a
    // bare `(f64 | {w: i32})[]`) — likewise needs its grouping parens back: without them `elemName + "[]"`
    // is `f64 | {w: i32}[]`, which `refArrElemKind` mis-splits (paren-blind) into a plain struct element
    // (kind 1) instead of the kind-2 union box, so the reflist wrapper backs `{w: i32}` refs and the raw
    // f64 arm stores into a ref slot (INVALID-WASM). `parenUnionArrElemName` recognizes exactly the
    // top-level-`|` element that needs grouping (it carries the arrow guard, so a closure element is left
    // alone), and the wrapped `(elem)[]` is identical to the nullable-array branch above. The soundness
    // gate `isValueUnionName(elemName) || nullablePartOf(elemName) == ""` mirrors `collectA`'s reject at the
    // top-level nullable-ref-array path: a NICHE-nullable-scalar element (`string | null`, `boolean | null`)
    // has NO union-box rep (its `| null` is a niche, not a tag), so it must NOT be wrapped into a kind-2
    // element here — leaving it un-grouped keeps its existing (kind-1) classification and its clean REJECT,
    // rather than silently interning an unsound box (INVALID-WASM). A value union with null (`i32 | null`)
    // and any null-free heterogeneous union (`f64 | {w: i32}`, `K0[] | {w: i32}`) box soundly and wrap.

    arrName = "(" + elemName + ")[]"
  }
  const k = refArrElemKind(arrName)
  if k == 9 { ensureRefElem(refArrElemName(elemName)) }
  // A MAP element (`{[string]: V}[]`, kind 3): force the map heap types + intern the element
  // map's VALUE mv slot, so a TYPED-value map in a COMPOSITION position (a list element, a
  // struct field, a nested-map value) resolves the SAME per-value map struct a standalone
  // `{[string]: V}` binding does — position-independent. A mono / atom value interns nothing
  // (`mvShapeOfValName` returns -1), riding the shared mono `$mapStruct`.
  if k == 3 {
    mUsed = true
    lUsed = true
    aUsed = true
    // A NULLABLE map element strips to its inner map for the value intern — the slot
    // shares the map struct (and mv slot) with the non-null element.
    let mve = elemName
    const nme = nulMapInnerName(elemName)
    if nme != "" { mve = nme }
    mvShapeOfMapName(mve)
    // …AND THE KEY HALF OF THE SAME FORCING, which this arm is THE ONE HOME of. Every
    // other place a map spelling forces its machinery sets FOUR things — `mUsed` /
    // `lUsed` / `aUsed` AND `mI32Used` (`collectA`'s bare-map and map-ARRAY annotation
    // arms); this arm set only the first three, and it is the arm EVERY map-typed
    // ref-list ELEMENT passes through, at any nesting and in any position. `mI32Used`
    // gates the i32-keyed map STRUCT, the `__map_probe_i32__` helper and — the symptom
    // — the per-function 5-slot i32-KEY scratch frame (`mapI32Base`), so without it the
    // store's key temporary aliases the map-REF temporary at the SAME local index:
    // `type mismatch: expected (ref $type), found i32` at `vl check` rc 0 for a mv-slot
    // value, and the loud "map struct was not collected" for a mono one.
    //
    // The positions that reach the flag ONLY here are the ones whose map is spelled
    // inside a BIGGER name that no annotation `TypeRef` decomposes: an inline-shape
    // struct field (`{m: {[i32]: V}[]}`), a union-arm field, an alias'd element
    // (`{m: M[]}`), and each of those through a parameter / return / literal. A DECLARED
    // `type S = {m: {[i32]: V}[]}` spells its field as its own `TypeRef` and so has a
    // second source — which is exactly what made this residue invisible.
    //
    // Asked of the PEELED `mve` for the same reason the value intern is: a nullable map
    // element is a map element, and `nameIsI32KeyedMap`'s key cut answers for the list
    // and `| null` widths too, so the peel only ever narrows to the same verdict.
    if nameIsI32KeyedMap(mve) { mI32Used = true }
  }
  // Force the leaf list-type wrapper `Used` flags for a SCALAR inner-list element, so its
  // singleton wrapper (`lTypeIdx` / `mkListIdx` / `fl64TypeIdx` / `il64TypeIdx`) is allocated. A
  // ref inner list (k 9) forces these in the recursion above; a struct / union / closure element
  // (k 1/2/5) needs none. Lets BOTH the array path and the map-value path share this one helper.
  if k == 4 {
    lUsed = true
    aUsed = true
  } else if k == 6 {
    slUsed = true
    aUsed = true
  } else if k == 7 {
    fa64Used = true
  } else if k == 8 {
    ia64Used = true
  } else if k == 10 {
    fa32Used = true
  }
  rlInternNameTy(elemName, k, ty)
}

export function refArrElemKind(name: string) {
  // Every SHAPE-decided arm, in the order this entry point tested them, is
  // `refArrShapeKind` (destringify D-REFARRKIND) — the ladder `nameIsRefArray`
  // carried a second hand-written copy of.
  const sk = refArrShapeKind(name)
  if sk >= 0 { return sk }
  // The BASE arm, which is where the two entry points genuinely differ and so
  // stays local (D-FIELDCODE's rule: keep the arm whose EVIDENCE differs at the
  // call site): a `<Union>[]` element list is kind 2 — strip the `[]` once and
  // match the bare union name (no per-iteration `+ "[]"` concat). Anything else
  // (a struct / inline-shape / variant array, and any name no arm claims) is
  // kind 1, which is why this entry point needs no struct-table consult at all
  // while `nameIsRefArray` needs four.
  if nameIsElemArray(name) {
    const base = arrElemNameRaw(name)
    let u = 0
    while u < unNames.length {
      if base == unNames[u] { return 2 }
      u = u + 1
    }
  }
  1
}

// The per-field wasm-type code for a struct / union-variant field whose type node is
// `tyIx` (a `TypeRef`). Mirrors the inline classifier `collectS`/`collectVariantFields`
// used to use, EXTENDED with array-typed fields (gap #5): a field of array type stores a
// REF to a list wrapper, so its code records WHICH wrapper:
//   `0` = i32 / boolean   (`0x7f`)
//   `3` = string          (`(ref $aTypeIdx)`)
//   `4` = i32 list  `i32[]`         (`(ref $lTypeIdx)`)
//   `5` = ref list  `T[]` / `N[]`   (`(ref $rlTypeIdx)`)
// An `X[]` whose element `X` is not `i32` is a REF list (`5`) — its element is a struct
// or the union box; the element-kind (`rElemKind`) is fixed globally by `collectA`, so it
// is not stored per-field. An unsupported field type yields `-1` (caller fails loudly).
// (`string[]` is NOT yet supported — it would need a string-ref list distinct from the
// struct/union ref backing — so it falls through to `-1`.)
// Force the backing+wrapper type pair for a SCALAR-LIST field code (25 = f64[], 26 = i64[], 27 = f32[]),
// so the wrapper heap type exists whenever a struct/inline-shape field uses it — the field analogue of a
// ref-list field forcing `rlUsed`. A scalar-list LOCAL forces this via its annotation scan; a field-only
// program must force it here (the field's own TypeRef scan is not guaranteed to set the flag).
export function forceScalarListField(code: i32) {
  if code == 25 { fa64Used = true }
  if code == 26 { ia64Used = true }
  if code == 27 { fa32Used = true }
  // The NULLABLE twins (codes 32/33/34) ride the SAME leaf wrapper/backing pair — and are
  // the more urgent case: a field that only ever holds `null` never builds a list literal,
  // so nothing else in the module forces the pair and the field's `(ref null $wrapper)`
  // storage type would reference an unallocated index. (Code 31's `string[] | null` pair is
  // forced beside the code-6 string list, whose flags live outside this scalar trio.)
  if code == 32 { fa64Used = true }
  if code == 33 { ia64Used = true }
  if code == 34 { fa32Used = true }
  0
}

// "THE TYPE UNDER THE `| null`" — `name` with a two-part nullable wrapper peeled, or
// `name` unchanged when it carries none. SEVENTEEN classifiers in this file each wrote
// this out as the same three lines with a different pair of variable names:
//
//     let base = ftxt
//     const nb = nullablePartOf(base)
//     if nb != "" { base = nb }
//
// `nullablePartOf` answers a QUESTION ("is this `T | null`, and what is T?") by returning
// "" for no; every one of those seventeen wanted the ANSWER-or-the-original, and hand-wrote
// the fold. Naming the fold is what makes the population countable: the remaining
// `nullablePartOf` calls in this file are now the sites that genuinely branch on
// nullability, not the ones that were only trying to look through it.
export function nonNulBaseOf(name: string) {
  const nb = nullablePartOf(name)
  if nb != "" { return nb }
  name
}

// True if `name` is a `<ref-list> | null` — a NULLABLE ref-list field/local (`S[] | null`, `(i32|null)[] |
// null`, `{g:i32}[] | null`), the ref-list analogue of `nameIsNulI32List`. Its non-null part is a ref array
// (a struct / union / nested-array element list). NOT an `i32[] | null` (that is code 18, kind 15).
export function nameIsNulRefList(name: string) {
  const np = nullablePartOf(name)
  if np == "" { return false }
  return nameIsRefArray(np)
}

// The per-field wasm-type code a field type SPELLING carries — the ONE home of
// the field-code ladder, shared by both entry points: `fieldTypeCode` (an AST
// `TypeRef` node) and `nameFieldCode` (an inline object-type annotation member's
// text). Both reps of a field must agree arm for arm and in arm ORDER, and a
// single table is the only form of that agreement a reader can check.
//
// `litNode` selects how the literal-union arm is decided, and is the one arm whose
// EVIDENCE differs between the callers: `>= 0` is an AST node index, answered from
// the checker's recorded type (`nodeTyIsLitUnionAlias` — no parse); `-1` means
// there is no node and the spelling must answer (`nameIsLitUnionType`). Passing the
// node rather than a precomputed flag keeps the arm LAZY on both paths, so neither
// caller pays for a verdict the scalar arms above already settle.
function fieldCodeOfSpelling(t: string, litNode: i32) {
  if t == "i32" { return 0 }
  if t == "boolean" { return 0 }
  // An f64 field (`x: f64`) stores a raw f64 valtype slot — code 17. An i64 / f32 field is
  // the same idea in the other scalar valtypes — codes 23 / 24 (0x7e / 0x7d storage).
  if t == "f64" { return 17 }
  if t == "i64" { return 23 }
  if t == "f32" { return 24 }
  // A literal-union field (`kind: K`, or inline `"a"|"b"`) stores an interned-i32 ATOM —
  // code 0 (i32 valtype), NOT a box. Checked before the value/struct-union tests (a literal
  // union registers as a union name, which would otherwise claim it as code 16). The field's
  // union name is recorded in `sFieldElemName` so construction/read/assign recover the atom
  // rep + membership.
  if litNode >= 0 {
    if nodeTyIsLitUnionAlias(litNode) { return 0 }
    // An INLINE literal-union ARRAY field (`xs: ("a" | "b")[]`) is the i32 ATOM list — code
    // 4, exactly the `K[]` alias spelling's code. Its SPELLING cannot say so: `canonEmitName`
    // softens the bare inline union to `string`, so `t` arrives as `"string[]"` and the array
    // arm below would code it 6 (a string-ref list) while every element/construct path reads
    // the arena and builds atom ids. Structural, off the recorded type, ahead of the softened
    // name. Like `tyAnnRefListKind`, this ladder has no `repOf` leg — a field CODE is not a
    // rep kind — so the rep layer cannot subsume this arm either.
    if tyIsLitUnionArray(nodeTyIxOf(litNode)) { return 4 }
    // The `| null` twin, one construct further out: `xs: ("a" | "b")[] | null` is the
    // NULLABLE i32 atom list — code 18, the same code its `K[] | null` alias spelling gets
    // from `nameIsNulI32List` below. Same softening, so the same blindness: `t` arrives
    // `"string[] | null"` and the nullable-scalar-list arm would code it 31, a
    // `(ref null $strListWrapper)` field, while the object literal stores the atom wrapper.
    // Asked of the REP rather than re-derived from the type: `repOfNullable`'s list arm
    // already covers a litunion element ungated, and `nullist` is code 18 for every
    // spelling that reaches it (`i32[] | null` included), so this is the arena stating the
    // arm the name states below, not a second policy.
    if annRepKindOf(litNode) == "nullist" { return 18 }
    // The nullable-ELEMENT twin, which folds onto the SAME code 4: `nameIsI32Array` admits
    // `(K | null)[]` into the i32 backing (one `$lTypeIdx` wrapper for the whole atom-niche
    // family), so the alias spelling already codes 4 here and the inline one must too.
    if annIsNulLitUnionArray(litNode) { return 4 }
  } else {
    if nameIsLitUnionType(t) { return 0 }
  }
  if nameIsString(t) { return 3 }
  if nameIsArray(t) {
    // The scalar-element backings, in the ONE home's order (`scalarListKindOfName`). A
    // `string[]` field is a string-ref list (code `6`) — it reuses the map keys list types
    // (`mkListIdx`/`mkArrIdx`). A SCALAR-element list field stores its scalar-list wrapper
    // (code 25/26/27), NOT a ref-list wrapper (code 5 is for struct/union/closure elements
    // only — returning 5 here emitted the wrong heap type, the invalid-wasm hole). Any
    // OTHER `X[]` is a struct/union ref list.
    const sk = scalarListKindOfName(t)
    if sk == 0 { return 4 }
    if sk == 1 { return 6 }
    if sk == 2 { return 25 }
    if sk == 3 { return 26 }
    if sk == 4 { return 27 }
    return 5
  }
  // A MAP-typed field (`children: {[string]: Tree}`) stores a non-null ref to
  // its value-type's map struct — code 19. The mv SLOT is interned by
  // `collectA`'s arena TypeRef scan (the annotation node), so emission
  // re-finds it by the value name (`fieldRefElemName`).
  // A map-MEMBER union field (`{[string]: string} | string`) starts with `{[` too, but it is a
  // union BOX field (code 16), not a map — `!nameIsMapMemberUnion` lets it fall to the union test.
  if nameIsBareMap(t) { return 19 }
  // A NULLABLE map field (`links: {[string]: V} | null`) stores a NULLABLE ref to the value
  // type's map struct — code 29, the field analogue of the `nulmap` local/param/return niche
  // (the map twin of code 28's nullable ref-list field). Gated to the SAME supported value
  // kinds as the non-null map field (`retNulMapFlag`'s gate), so a nullable map over an
  // unrepresentable value type keeps failing loudly (-1, no interned shape).
  const nmi = nulMapInnerName(t)
  if nmi != "" {
    if mapValKindLowerable(nmi) { return 29 }
  }
  // A NULLABLE i32-list field (`rest: i32[] | null`) stores a NULLABLE ref to
  // the same wrapper as code 4 — code 18 (`0x63 lTypeIdx`). Checked before the
  // value-union test (`i32[]` is not a value atom, so 16 never claims it).
  if nameIsNulI32List(t) { return 18 }
  if nameIsNulRefList(t) { return 28 }
  // A NULLABLE DISTINCT-BACKING scalar-list field (`f64[] | null` 32, `i64[] | null` 33,
  // `f32[] | null` 34, `string[] | null` 31): a `(ref null $leafWrapper)` slot — the field
  // mirror of the same-named binding niche. Checked AFTER the ref-list arm so a spelling
  // the ref-list layer already claims (`(string|null)[] | null`) keeps code 28's rep.
  const nsl = nulScalarListFieldCode(t)
  if nsl >= 0 { return nsl }
  // A `string | null` niche field — `(ref null $aTypeIdx)`, code 20. Checked before
  // the value-union test (it is NOT a value union — a single ref + null is a niche).
  if nameIsNulString(t) { return 20 }
  // A `boolean | null` niche field — i32 sentinel, code 21.
  if nameIsNulBool(t) { return 21 }
  // A `K | null` nullable-litunion niche field — the i32 atom slot with the spare
  // value `-1` = `null` (member ids are interned ≥ 0), code 30. The field analogue
  // of the kind-0 `K | null` binding niche; checked before the value-union test
  // (a single atom set + null is a niche, not a box).
  if nameIsNulLitUnion(t) { return 30 }
  // A BOX-union field — a VALUE union (`v: i32 | null`, `y: string | i32`) OR a
  // registered STRUCT / HETEROGENEOUS union (`v: A | B`, `v: A | i32`) — stores the
  // shared union BOX ref (code 16). Checked BEFORE the nullable-struct strip, so a
  // declared `type Opt = { v: i32 | null }` carries the same rep as the inline
  // `{v:i32|null}` annotation.
  if isValueUnionName(t) { return 16 }
  if isUName(t) { return 16 }
  // A field naming ANOTHER STRUCT (`inner: Inner`) or a NULLABLE struct
  // (`next: Node|null`) stores a `(ref null $S)` — code 15. Resolved via the
  // DECLARATION scan (not the incrementally-built struct table) so a forward /
  // mutually-recursive reference ties in the shared rec group.
  const base = nonNulBaseOf(t)
  if nameIsStructDecl(base) { return 15 }
  -1
}

export function fieldTypeCode(tyIx: i32) {
  if tyIx < 0 { return -1 }
  // A NULLABLE-function field (`op: ((i32) => i32) | null`) stores a NULLABLE closure
  // fat-pointer (code 22) — the field analogue of a kind-19 local. Checked BEFORE the
  // bare-function test (and before `tyIsFuncType`, exactly as `vtKindOfType` orders it):
  // `((i32) => i32) | null` is a nullable function (arrow nested under a top-level `|`),
  // whereas `(i32) => i32 | null` is a function RETURNING a nullable (handled elsewhere).
  // Both arms read the NODE, so this entry point spends no parse on them.
  if nulCloFlagAnn(tyIx) == 1 { return 22 }
  // A function-typed field (`op: (i32) => i32`) stores the closure fat-pointer (code 14),
  // the field analogue of a function-valued local.
  if tyIsFuncType(tyIx) { return 14 }
  const ty = P.nodes[tyIx]
  if ty is TypeRef {
    const c = fieldCodeOfSpelling(ty.tyName, tyIx)
    if c >= 0 { return c }
    // An INLINE-SHAPE struct field (`inner: {x:i32}`) — not a declared name, so resolve it
    // STRUCTURALLY to its interned struct (pre-interned by `collectNestedFieldShapes`). The
    // structural→nominal bridge applied at field classification, the dual of a nominal `inner: Inner`.
    // The NODE entry point's own arm: an inline object-type annotation member reaching
    // `nameFieldCode` is interned by the annotation pass instead.
    // GUARD against an array base (`{x:i32}[]` of a `{x:i32}[] | null` field): `structIndexOfTypeName`
    // ignores the trailing `[]` and would match the element shape, mis-coding a NULLABLE STRUCT-LIST
    // field as a nullable struct (code 15) — invalid wasm. A nominal `Node[] | null` already falls to
    // -1 (clean reject); this brings the inline form to par until nullable ref-list fields are repped.
    const base = nonNulBaseOf(ty.tyName)
    if !nameIsArray(base) && structIndexOfTypeName(base) >= 0 { return 15 }
    // A GENERIC-APPLICATION field (`c: Box<i32>`, `c: Box<i32> | null`) is a struct-ref
    // field over the application's monomorphized instance — code 15, `fieldRefElemName`
    // recording the application NAME, which is the key `gaeEnsure` interns the instance
    // under (`sNames`) and every use site resolves by (`structIndexByName`).
    //
    // IT CANNOT BE `structIndexOfTypeName` ABOVE, AND THAT IS AN ORDER FACT, NOT A
    // CAPABILITY ONE. `collectS` codes every declared struct's fields in its FIRST loop
    // and only then runs `gaeCollectDecls` / `collectGenAliasShapes` — the applications
    // it interns may reference those very structs (`Box<Node>`), so the instance pass
    // cannot precede the declaration pass. At field-code time the instance is therefore
    // absent from BOTH the struct table and the `gaeBases` registry, and the only
    // evidence available is the arena: a `TypeDecl` whose own name applies the same head
    // (`nameIsGenAppDecl`), exactly the DECLARATION scan `nameIsStructDecl` is for.
    //
    // An instance whose fields the emitter cannot type leaves `gaeEnsure` declining to
    // intern it, so this code-15 field then reports `ref valtype with no interned shape` —
    // loud, and the same verdict the application already gets in every other position.
    if !nameIsArray(base) && nameIsGenAppDecl(base) { return 15 }
    return -1
  }
  -1
}

// True if `name` is a generic-alias APPLICATION (`Box<i32>`) whose HEAD names a generic
// `type` declaration in the arena (`type Box<T> = {…}`) — the application analogue of
// `nameIsStructDecl`, and independent of the registry (`gaeBases`) and the struct table
// for the same reason: both are built AFTER `collectS`'s field-coding loop.
//
// ARITY IS NOT CHECKED HERE. `gaeEnsure` is the one place that can compare an
// application's arguments against the declaration's parameters, and it declines to intern
// on a mismatch; a field this predicate admits and that pass declines then fails loudly at
// its use, which is the same reject an unresolvable application already takes.
function nameIsGenAppDecl(name: string) {
  if !annGenAppSpanEnds(name) { return false }
  const head = gaeHeadNameOf(name, gaeLtAt(name))
  if head == "" { return false }
  let i = 0
  while i < P.nodes.length {
    const nd = P.nodes[i]
    if nd is TypeDecl {
      const lt = gaeLtAt(nd.tdName)
      if lt > 0 {
        if gaeHeadNameOf(nd.tdName, lt) == head { return true }
      }
    }
    i = i + 1
  }
  false
}

// True if `name` is a STANDALONE struct `type` declaration's name — independent of
// the (incrementally-built) struct table, so a struct field may reference a LATER
// struct declaration. Union aliases and union variants are excluded (their fields
// ride the variant tables, not the struct table).
function nameIsStructDecl(name: string) {
  if name == "" { return false }
  if isUName(name) { return false }
  if variantIndexOf(name) >= 0 { return false }
  let i = 0
  while i < P.nodes.length {
    const nd = P.nodes[i]
    if nd is TypeDecl {
      if nd.tdName == name { return true }
    }
    i = i + 1
  }
  false
}

// The ref-list ELEMENT type-NAME of a field whose type node is `tyIx` — the table key
// into `rlElemName` — when `fieldTypeCode(tyIx) == 5` (a struct/union ref list); "" for
// any other field. Strips the trailing `"[]"` directly so it does NOT depend on `sNames`
// being fully populated (collectS builds it incrementally; a field may reference a
// later-declared struct). Used to fill `sFieldElemName`/`uFieldElemName`.
export function fieldRefElemName(tyIx: i32) {
  if tyIx < 0 { return "" }
  const code = fieldTypeCode(tyIx)
  const ty = P.nodes[tyIx]
  if ty is TypeRef {
    // A NESTED-STRUCT field (code 15) records its TARGET struct name (the `S` of
    // `inner: S` / `next: S|null`) — resolved to a struct table index at use sites.
    // The NODE recorder NOMINALIZES where the shape-text one does not: an INLINE-SHAPE
    // field (`inner: {x:i32}`) records the NAME of its interned struct
    // (`structIndexOfTypeName` resolves the shape — to its own `{x:i32}` key, or a
    // matching declared struct), so every nominal-keyed use site (`structIndexByName`)
    // resolves it like `inner: Inner`.
    if code == 15 {
      // `nonNulBaseOf` — the fold this file NAMED, hand-written 184 lines below its own
      // home. The detector that found it matches both spelling directions ("peel, keep if
      // non-empty" and "peel, restore if empty"); this is the second.
      const base = nonNulBaseOf(ty.tyName)
      const idx = structIndexOfTypeName(base)
      if idx >= 0 { return sNames[idx] }
      return base
    }
    // A NULLABLE REF-LIST field (code 28, `S[] | null`): its element is the ref-array element of the
    // non-null part (`refArrElemName(nullablePartOf(name))` — `S[]|null` -> `S`, `(i32|null)[]|null` ->
    // `i32|null`), so `sFieldRefSlot` (`rlSlotByName`) finds the element's interned slot. No DEFERRED
    // `[]`-slice fallback here (the shape-text recorder's): this path runs after the struct/union
    // tables exist, so an element the canonicalizer cannot name is a genuine "".
    if code == 28 { return refArrElemName(nullablePartOf(ty.tyName)) }
    // The ATOM codes the shape-text recorder keys and the NODE recorder does not: a
    // code-0 literal-union field and a code-30 `K | null` niche field carry their union
    // name from the annotation interner, not from here.
    if code == 0 { return "" }
    if code == 30 { return "" }
    // Every other code is recorded IDENTICALLY from a spelling, so the shape-text
    // table answers: code 16 the union name, 19 / 29 the map's value name, 4 the atom
    // ARRAY name, 5 the canonical ref element (`refArrElemName`, parens stripped and
    // nullable-array peeled — a DECLARED struct field `f: (f64|null)[]` otherwise
    // recorded the grouping-paren spelling that misses the rl-slot table, storing a raw
    // f64 into the box-ref backing). Its code-5 `[]`-slice fallback is reachable from
    // here too and means the same thing: code 5 is only ever assigned under
    // `nameIsArray`, which is exactly that fallback's guard.
    return shapeFieldElemName(ty.tyName, code)
  }
  ""
}

// Validate an array type-name as a supported element type: `i32[]` (the value list),
// or a REF list `S[]`/`N[]` over the declared struct / union alias (G7-ref). A nested
// `i32[][]` or an array of an unknown / unsupported element fails loudly. Returns 0 on
// success, or -1 (via `emitFail`).
export function checkArrName(name: string) {
  if nameIsI32Array(name) { return 0 }
  if nameIsRefArray(name) { return 0 }
  emitFail(
    "emitProgram: only i32[] arrays and struct/union element arrays are supported",
  )
}

// True when `name` is `T[]` for some declared type PARAMETER `T`. VL binds a type
// parameter at TWO declaration kinds and this predicate must know both: a FuncDecl
// (`function at<T>(xs: T[])`, whose names `collectA`'s pre-pass gathers into
// `genTyParamNames`) and a generic type ALIAS (`type Box<T> = { v: T[] }`, whose names
// the parser folds into the declared name and `gaeCollectDecls` splits back out into
// `gaeParams`).
//
// Knowing only the FuncDecl half is what made `type Box<T> = { v: T[] }` an emit error
// (`"only i32[] arrays and struct/union element arrays are supported"`) for EVERY element
// type including the i32 the message names as supported — the alias body's `T[]`
// annotation node fell past this arm to `collectA`'s `checkArrName`, which sees the
// UNSUBSTITUTED `T[]`. The reject fires on the DECLARATION, so it needs no application at
// all. Same asymmetry shape as #1218 (`monoArgTyName`'s array cascade knowing two of the
// six reps while the scalar cascade below it named them all): one classifier taught half
// of a set its sibling already had whole.
//
// Skipping is right for both halves for the same reason. A generic alias declares NO
// concrete struct — `collectS` skips it (`gaeLtAt(tdName) < 0`) and each APPLICATION
// interns its own substituted shape through `gaeEnsure` — exactly as a generic original
// FuncDecl is replaced by its instances and never emitted. So neither declaration's
// annotations should force or validate a heap type; the instances' pinned names do.
//
// A parameter name that ALSO names a REAL type is not a parameter, and the SHADOW GUARD
// below is what says so. The checker already rules this way: given
// `type Box<i32> = { v: i32 }` it resolves the field to the BUILTIN and reports
// `Box<string>` as `{v: i32}` — the shadowing "parameter" binds nothing. Without the guard
// this arm would swallow a genuine `i32[]`/`boolean[]` annotation elsewhere in such a
// program, leaving `lUsed`/`aUsed` unforced and the list valtype dangling — invalid wasm
// that `vl check` passes. That hole is PRE-EXISTING on the FuncDecl half
// (`function id<i32>(v: i32)` alongside an `i32[]` param is invalid wasm on master); the
// guard closes it for both halves at once rather than extending it to a second one.
//
// The guard is `checkArrName`'s own accept set, read as a predicate — which is exactly the
// right bound: this arm exists ONLY to spare the next arm's `checkArrName` a name it would
// wrongly reject, so any name that call would ACCEPT must stay with it (it is the arm that
// forces the list's heap types). Earlier arms already claimed the `string[]` / ref-array /
// `f64[]` / `i64[]` / `f32[]` spellings, so those need no mention here.
export function genTyParamArr(name: string) {
  if genTyParamNames.length == 0 && gaeBases.length == 0 { return false }
  // The array-name grammar at its two homes. The TEST stays in front of the CUT exactly as
  // the inline compares did (`nameIsArray` IS the `n < 2` bound plus those two compares),
  // and the `""` a non-array cut yields never matches a declared type-parameter name — so
  // the guard is kept rather than folded, per `arrElemNameRaw`'s own rule about `"[]"`.
  if !nameIsArray(name) { return false }
  if nameIsI32Array(name) { return false }
  if nameIsRefArray(name) { return false }
  // The array grammar's cut, taken to the LEAF (`arrLeafNameOf`) rather than one level:
  // `T[][]` is as much a type-parameter array as `T[]` is, and the one-level cut left
  // `"T[]"`, which matches no parameter name — so a NESTED parameter array reached
  // `checkArrName` and was rejected by a message about i32 element types, on BOTH halves
  // (`type Box<T> = { v: T[][] }` and `function n<T>(xs: T[][])`), while the concrete
  // `i32[][]` lowered fine. The peel does NOT make the nested case work: it is still an
  // emit error, now raised by the passes that actually own the gap (the array-literal
  // lowering's "nested arrays are not supported" for the alias, `monoArgTyName`'s
  // documented one-level `[]` scope for the FuncDecl). What it removes is this arm
  // ANSWERING WRONG about a name that is plainly a type-parameter array. Every name the
  // peel newly claims was a hard emit error before it, so no working program moves.
  const base = arrLeafNameOf(name)
  let i = 0
  while i < genTyParamNames.length {
    if genTyParamNames[i] == base { return true }
    i = i + 1
  }
  // The generic-ALIAS half. `gaeParams` stores the RAW parameter text per declaration
  // ("T", "A,B"), so the split is `gaeSplitArgs` — the same cut `gaeEnsure` makes on the
  // same column, not a second grammar. A program with no generic alias has an empty
  // registry and this loop never runs.
  let gi = 0
  while gi < gaeBases.length {
    const pnames: string[] = []
    gaeSplitArgs(gaeParams[gi], pnames)
    let pj = 0
    while pj < pnames.length {
      if pnames[pj] == base { return true }
      pj = pj + 1
    }
    gi = gi + 1
  }
  false
}

// The registered UNION the checker typed this array literal's ELEMENT as, or "" —
// the ONE home of the rule `arrLitIsRef`, `arrLitElemKind` and `arrLitElemName` each
// need an arm for, so the three cannot drift on it. Also `collectA`'s EMPTY-literal
// arm, where the scalar gates below are false by construction (they all decline a
// literal with no elements).
//
// A CALL (`const xs = [pick(true)]`) and an IDENT (`const xs = [w]`) are neither an
// object literal nor a nested literal nor a lambda, so the first-element SYNTAX probes
// those three classifiers run cannot see a union that arrives by either route: the
// literal fell through to the i32 list and the union box stored into it was
// `expected i32, found (ref $type)` — a silently invalid module in every un-annotated
// position (`const`, global, inferred return, `.push` into an empty `[]`).
//
// TWO GATES, AND NEITHER IS REDUNDANT.
//
// `isUName` asks whether the EMITTER HOLDS that union's row, which is what makes the
// kind-2 box build and its variant tags available at all. A union the checker knows
// and the emitter has not registered keeps master's classification and master's LOUD
// failure, rather than building against a slot that does not exist.
//
// The SCALAR/STRING exclusion keeps this the last rung in `collectA`'s order as well
// as in each classifier's. `collectA` asks `arrLitIsRef` FIRST and `emitArr` asks the
// scalar classifiers first, and master's `arrLitIsRef` could never overlap them — an
// objlit / lambda / nested literal is neither a string nor a float. A UNION element
// can be both: `["aa", 2.5]` contextually adopted as `(K | f64)[]` is `arrLitIsStr`
// on the emit side and would be a ref list on the collect side, so the module
// collects a box list and emits an f64 one — `f64 array literal but f64 list type not
// collected` (`literal-unions/mixed-union-alias-member-preserves.vl`, whose subject is
// precisely that such a literal reaches its box through the ARM SCANNER instead).
// Where a scalar classifier claims the literal, master's path is kept exactly.
export function arrLitUnionElemName(arrIx: i32): string {
  const cen = nodeArrayElemName(arrIx)
  if cen == "" { return "" }
  if !isUName(cen) { return "" }
  if arrLitIsStr(arrIx, -1) { return "" }
  if arrLitIsF64(arrIx, -1) { return "" }
  if arrLitIsI64(arrIx, -1) { return "" }
  cen
}

// The ref-list element-NAME of an array literal whose ELEMENTS ARE MAPS (`[Map()]`,
// `[Set()]`, `[mk()]` over a map factory), or "" when they are not — the map twin of
// `arrLitUnionElemName`, and the ONE answer all three `arrLit*` classifiers read so they
// cannot drift arm for arm. The name is the checker's recorded element type
// (`nodeArrayElemName`), whose emit render is the same string the annotated `{[K]: V}[]`
// spelling reduces to (`refArrElemName` → `arrElemNameRaw`), so both spellings intern ONE
// kind-3 row.
//
// `nameIsBareMap` IS THE PREDICATE THE ANNOTATION SIDE USES (`nameIsMapArray` asks it of
// the peeled element), which is what keeps the two sides one decision: a map-MEMBER union
// element (`({[string]: i32} | boolean)[]`) is a union BOX — kind 2, claimed by
// `arrLitUnionElemName` — not a list of maps, and it opens with `{[` too.
export function arrLitMapElemName(arrIx: i32): string {
  const cen = nodeArrayElemName(arrIx)
  if cen == "" { return "" }
  if !nameIsBareMap(cen) { return "" }
  cen
}

// True if the array literal at `arrIx` has ref ELEMENTS — its first element is a
// struct object literal (a `T[]` element) or a union-variant object literal (an
// `N[]` element). An empty literal is NOT detectable here (it has no elements); its
// kind comes from the binding annotation (`pendingListKind`).
export function arrLitIsRef(arrIx: i32) {
  const a = P.nodes[arrIx]
  if a is ArrayLit {
    if a.arrElems.length < 1 { return false }
    // A literal of FUNCTION VALUES the checker typed as a closure array (`[add, mul]`,
    // `[inc, (x) => x]`): its element name carries a `=>`. Checker-driven (not a first-element
    // `fnIndexOf` guess), so a local shadowing a function name is never mis-claimed — and it
    // subsumes the lambda-literal case below for any closure array the checker concretely typed.
    const cen = nodeArrayElemName(arrIx)
    if cen != "" {
      if strContains(cen, "=>") { return true }
    }
    const e0 = P.nodes[a.arrElems[0]]
    if e0 is ObjLit { return true }
    // A CLOSURE-element literal (`[(x) => x + 1]`) is a ref list (element kind 5), NOT an i32
    // list — without this `exprArray` claims it (its `!arrLitIsRef` default), the inferred-return
    // scan mints a `>a` (i32-list) closure sig, and a closure VALUE returning it miscompiles. As a
    // ref list it routes through `exprRefArray` (kind 5) like a struct-element literal.
    if e0 is FuncDecl { return true }
    // A NESTED array literal (`[[1, 2], [3, 4]]`, `[["a"]]`, `[[1.5]]`,
    // `[[6000000000]]`) is a ref list whose element is the INNER list's wrapper —
    // element kind 4 (i32-ish leaves) or 6/7/8 (string / f64 / i64 leaves, via
    // `arrLitElemKind`'s inner probe). Keying every scalar/string leaf here (not
    // only i32) makes a SELF-classified nested literal — an un-annotated binding,
    // a lambda result — build the SAME rep its leaves need: an i64-magnitude leaf
    // (`[[62321678167]]`) previously still keyed the `i32[]` element while its
    // inner literal built the i64 wrapper — a wrapper-heap mismatch, INVALID WASM
    // (the `() => i64[][]` global). A REF inner literal (`[[{v: 1}]]`) stays
    // annotation-driven (the threaded `pendingListKind`/slot path).
    if e0 is ArrayLit {
      if !arrLitIsRef(a.arrElems[0]) { return true }
    }
    // A checker-typed UNION element (`arrLitUnionElemName`): the kind-2 box list.
    // LAST RUNG, deliberately — every literal that classifies by its FIRST ELEMENT
    // keeps exactly the classification it had, so this arm only ever claims a
    // literal that was falling through to the i32 default.
    if arrLitUnionElemName(arrIx) != "" { return true }
    // A checker-typed MAP element (`arrLitMapElemName`): the kind-3 map list. Same
    // placement and same reason as the union rung above — a `Map()` / `Set()` element is
    // no object literal, no nested literal and no lambda, so every first-element probe
    // above misses it and the literal was falling to the i32 list, where the guard in
    // `emitArr` refuses the map-struct ref element loudly.
    if arrLitMapElemName(arrIx) != "" { return true }
  }
  false
}

// True if the array literal at `arrIx` has STRING elements — its first element is a
// string-typed expression (a `"…"` literal, or a string-returning call / string
// param/local). An empty literal is NOT detectable here; its kind comes from the
// binding/field annotation (`pendingListKind == 3`).
export function arrLitIsStr(arrIx: i32, fnIx: i32) {
  const a = P.nodes[arrIx]
  if a is ArrayLit {
    if a.arrElems.length < 1 { return false }
    // An ATOM-element literal (the checker adopted a `K[]` context onto it) is the i32
    // atom-id list, NOT a string list: its member elements are string exprs syntactically,
    // but each lowers as its interned atom id (`emitArr` seeds `pendingLitUnion` off the
    // same recorded type). Without this, the literal claims the string-list slot/collect/
    // build while every consumer reads the atom rep — invalid wasm at the first use.
    if nodeArrayElemIsLitUnion(arrIx) { return false }
    // A `(K | null)[]` literal (`["a", null]`) is likewise the i32 atom-niche list, NOT a string list:
    // its member elements lower as atom ids and a `null` as the `-1` sentinel. Its INFERRED element
    // type is the expanded `"a" | null` union (a null member + str-lit members), which
    // `nodeArrayElemIsNulLitUnion` recognizes — without this exclusion a string-FIRST literal claims
    // the string-list slot/collect while every consumer reads the atom rep (invalid wasm).
    if nodeArrayElemIsNulLitUnion(arrIx) { return false }
    // A `(string | null)[]` literal with NO string-typed first element (`[null]`, `[null,
    // "x"]`): the recorded context-adoption type is the only signal — it IS the string-ref
    // niche list (`emitArr` seeds `pendingNulString` off the same recorded type), so the
    // string-list build is authoritative even though the first-element probe below misses.
    if nodeArrayElemIsNulStr(arrIx) { return true }
    return exprString(a.arrElems[0], fnIx)
  }
  false
}

// True if the array literal at `arrIx` has f64 ELEMENTS — its first element is an
// f64-typed expression (a `.` float literal, or an f64-returning expression). An empty
// literal is NOT detectable here; its kind comes from the binding annotation
// (`pendingListKind == 4`). (Slice 4.)
export function arrLitIsF64(arrIx: i32, fnIx: i32) {
  const a = P.nodes[arrIx]
  if a is ArrayLit {
    if a.arrElems.length < 1 { return false }
    // ANY f64 element makes the literal an f64 LIST (the i64 dual above): an
    // int sibling re-encodes at the store, exactly as when the float comes
    // FIRST. First-element-only classification let `[2, 1.5]` claim the i32
    // list and emit `f64.const` into the i32 array — invalid wasm. An i64
    // element keeps this false (mixed float/int is a checker-level union).
    let anyF64 = false
    let i = 0
    while i < a.arrElems.length {
      if exprIsI64(a.arrElems[i], fnIx) { return false }
      if !anyF64 {
        if exprIsF64(a.arrElems[i], fnIx) { anyF64 = true }
      }
      i = i + 1
    }
    return anyF64
  }
  false
}

// The ref-element kind of the array literal at `arrIx` (assumes `arrLitIsRef`): `2`
// when the FIRST element is a union variant (boxes into the union), else `1` (a direct
// struct element). Per-element-type: a `Tok[]` literal whose element is a plain struct
// is kind `1` even in a program that ALSO declares a union (which `Node[]` uses).
export function arrLitElemKind(arrIx: i32) {
  const a = P.nodes[arrIx]
  if a is ArrayLit {
    // A closure-element literal (the checker typed the element as a function type) is kind 5.
    const cen = nodeArrayElemName(arrIx)
    if cen != "" {
      if strContains(cen, "=>") { return 5 }
    }
    if a.arrElems.length >= 1 {
      const e0 = P.nodes[a.arrElems[0]]
      // A nested-list element: the INNER literal's leaf picks the element kind —
      // string 6 / f64 7 / i64 8, else the i32-list wrapper (4). Mirrors
      // `arrLitElemName`'s leaf keying (the two must agree per slot).
      if e0 is ArrayLit {
        if arrLitIsStr(a.arrElems[0], -1) { return 6 }
        if arrLitIsF64(a.arrElems[0], -1) { return 7 }
        if arrLitIsI64(a.arrElems[0], -1) { return 8 }
        return 4
      }
      if e0 is ObjLit {
        // A union-variant element boxes into the union (kind 2); a plain struct is kind 1.
        if uDeclared {
          if objVariantName(a.arrElems[0]) != "" { return 2 }
        }
        return 1
      }
    }
    // The checker-typed UNION element (`arrLitIsRef`'s last rung) boxes: kind 2. The
    // fall-through below reaches the same answer whenever a union is declared at all,
    // which is necessarily true when the rung holds — stated here because the three
    // classifiers must agree ARM FOR ARM, and this one's answer follows from THIS
    // literal's element type rather than from some other union in the program.
    if arrLitUnionElemName(arrIx) != "" { return 2 }
    // The checker-typed MAP element: kind 3, the same kind `refArrElemKind` gives the
    // annotated `{[K]: V}[]` spelling. BEFORE the `uDeclared` fall-through below, which
    // would otherwise claim a map literal as a union box in any program that declares a
    // union at all.
    if arrLitMapElemName(arrIx) != "" { return 3 }
  }
  if uDeclared { return 2 }
  1
}

// The ref-list ELEMENT type-NAME of the array literal at `arrIx` (assumes `arrLitIsRef`):
// the union alias name for a union-variant element, else the matched struct's name. This
// is the table key (`rlElemName`) the per-element-type interning uses.
export function arrLitElemName(arrIx: i32) {
  const a = P.nodes[arrIx]
  if a is ArrayLit {
    // A closure-element literal: the parenthesized function-type table key the checker recorded.
    const cen = nodeArrayElemName(arrIx)
    if cen != "" {
      if strContains(cen, "=>") { return cen }
    }
    if a.arrElems.length >= 1 {
      const e0 = P.nodes[a.arrElems[0]]
      // A nested-list element keys the INNER list's name by its leaf — the table
      // key `arrLitElemKind` picks the matching kind for (6/7/8, else 4).
      if e0 is ArrayLit {
        if arrLitIsStr(a.arrElems[0], -1) { return "string[]" }
        if arrLitIsF64(a.arrElems[0], -1) { return "f64[]" }
        if arrLitIsI64(a.arrElems[0], -1) { return "i64[]" }
        return "i32[]"
      }
      if e0 is ObjLit {
        if uDeclared {
          const vn = objVariantName(a.arrElems[0])
          if vn != "" { return unionNameOfVariant(variantIndexOf(vn)) }
        }
        const si = structIndexOfObj(a.arrElems[0])
        if si >= 0 { return sNames[si] }
      }
    }
    // The checker-typed UNION element (`arrLitIsRef`'s last rung): the registered
    // composite IS the table key — the same string `refArrElemName` yields for the
    // annotated `(Cat | Dog)[]` spelling, so both spellings intern ONE slot.
    const aun = arrLitUnionElemName(arrIx)
    if aun != "" { return aun }
    // The checker-typed MAP element: the whole `{[K]:V}` spelling IS the table key, the
    // same string `refArrElemName` yields for the annotated `{[K]: V}[]` — so the two
    // spellings intern ONE kind-3 row, and the row carries the KEY as well as the value.
    const amn = arrLitMapElemName(arrIx)
    if amn != "" { return amn }
  }
  ""
}

// The element type-NAME for a ref-array type-name (assumes `nameIsRefArray(name)`): the
// element is `name` with the trailing `"[]"` removed — i.e. the struct / union alias
// name. Mirrors `refArrElemKind` but yields the table key.
export function refArrElemName(name: string) {
  const ranp = nullablePartOf(name)
  if ranp != "" && nameIsArray(ranp) { return refArrElemName(ranp) }
  // `i32[][]` -> `i32[]`, `boolean[][]` -> `boolean[]`, `K[][]` -> `K[]`: the immediate i32-backed
  // inner list is the slot key (all kind-4 `lTypeIdx` elements), mirroring the `i32[][]` case.
  if nameIsI32ListArray(name) { return arrElemNameRaw(name) }
  // A nested NON-i32 scalar / string 2D array — the inner list's name is the slot key (kind
  // 8 / 7 / 6 element), mirroring `i32[][]` → `i32[]`.
  //
  // The three scalar leaves take the array grammar's ONE CUT once for the whole arm set and
  // then name the inner list by its one-line home (`nameIsI64Array` IS `arrElemNameRaw(n) ==
  // "i64"`), so the test is `name == "i64[][]"` over EVERY input. The cut is also the ANSWER
  // — `arrElemNameRaw("i64[][]")` is `"i64[]"` — so the three literal spellings go on both
  // sides of the arm, mirroring the `string[][]` / map arms below, which already return it.
  const raElem = arrElemNameRaw(name)
  if nameIsI64Array(raElem) { return raElem }
  if nameIsF64Array(raElem) { return raElem }
  if nameIsF32Array(raElem) { return raElem }
  if nameIsArray(name) && nameIsStringArray(arrElemNameRaw(name)) {
    return arrElemNameRaw(name)
  }
  if nameIsMapArray(name) { return arrElemNameRaw(name) }
  // `(string|i32)[]` → `string|i32` (the parens are annotation grouping only —
  // the TABLE key is the bare atom-set name every other union position uses).
  const pun = parenUnionArrElemName(name)
  if pun != "" { return pun }
  // `((i32) => i32)[]` → `((i32) => i32)` (the parenthesized function-type element, the
  // table key for the closure-element slot — all such slots share `cloStructIdx`).
  if nameIsClosureArray(name) { return arrElemNameRaw(name) }
  // A `<Union>[]` / `<Struct>[]`: strip the trailing `[]` ONCE and confirm the bare name is a
  // registered union/struct (the stripped base IS the table key — no per-iteration `+ "[]"`
  // concat, which allocated a string per struct/union per call).
  if nameIsElemArray(name) {
    const base = arrElemNameRaw(name)
    let u = 0
    while u < unNames.length {
      if base == unNames[u] { return base }
      u = u + 1
    }
    if structIndexByName(base) >= 0 { return base }
    // An INLINE-SHAPE element (`{v:i32}[]`) resolving to a DECLARED struct by the
    // structural bridge — the SPELLING stays the table key (its slot twins with the
    // declared name's slot at the heap layer, so the pair still dedups). Keyed
    // exactly like `nameIsRefArray`'s bridge (the two must agree).
    if shapeElemDeclaredStructIdx(base) >= 0 { return base }
    // A `Cat[]` concrete-variant element list — the bare variant name is the table key.
    if variantIndexOf(base) >= 0 { return base }
    // A NESTED ref array (`Cell[]` as the element of `Cell[][]`): the base is itself a ref array
    // — the inner list's name keys its slot. Recurses to the leaf struct/union/closure array.
    if nameIsRefArray(base) { return base }
  }
  ""
}

// "GIVE ME THIS NAME'S REF-LIST ELEMENT, OR NOTHING" — the ONE home of the guarded pair
// SEVEN sites in this file wrote out by hand:
//
//     if nameIsRefArray(x) { <use> refArrElemName(x) }      // and "" otherwise
//
// The guard is NOT redundant and the pair cannot be collapsed to `refArrElemName` alone.
// `nameIsRefArray` carries two rejections of its own that `refArrElemName` never learned —
// a TOP-LEVEL arrow (`(i32) => S[]` is a closure RETURNING an array, not a ref array) and a
// literal-union array (`K[]`, whose elements are interned i32 ATOMS). MEASURED (D-REFELEM):
// over 30,970 calls the guard says NO 16,152 times and `refArrElemName` would have answered
// a NON-EMPTY element on **120** of them (20 corpus / 100 fuzz) — every one the LITUNION
// case, where `K` is a registered `unNames` row so the trailing base match fires. The ARROW
// rejection has **zero** witnesses on either channel; it is kept because it is master's
// behaviour, not because it was seen to fire. Seven copies of the pair are seven places that
// had to agree about all of that, and the two-call shape is also two ladder walks per name.
//
// "" means BOTH "not a ref array" and "a ref array whose element does not resolve"; every
// caller answered `false`/"" for the second already (it is `refArrElemName`'s own miss value),
// so the fold is exact at each of them — see the per-site notes.
export function refArrElemNameIf(name: string) {
  if !nameIsRefArray(name) { return "" }
  refArrElemName(name)
}

// Intern a ref-list element type-NAME into the per-element-type table, returning its
// SLOT index (existing slot if already present). `kind` is 1 (struct) or 2 (union box).
// Heap/backing/wrapper indices are filled later in `emitModule`.
// A ref-list element is a NULLABLE NICHE (the index read leaves it `(ref null $elem)`) iff it is a
// niche-bearing KIND — a struct (1), a closure (5, the `(ref null $cloStruct)` fat-pointer), an
// inner LIST of any leaf (4, the distinct-backing scalar/string 6/7/8/10, or a ref inner 9) — AND
// its name carries `| null`. A value-union BOX (kind 2) is NOT a niche even though `i32 | null`
// also has `| null` (its null is a tag inside a non-null box). The KIND is the discriminator;
// recording it once here keeps the read/build sites kind-agnostic.
function rlElemNicheNullable(kind: i32, name: string) {
  if (
    kind != 1 &&
    kind != 3 &&
    kind != 4 &&
    kind != 5 &&
    kind != 6 &&
    kind != 7 &&
    kind != 8 &&
    kind != 9 &&
    kind != 10
  ) {
    return false
  }
  return nullablePartOf(name) != ""
}

// Canonicalize an element NAME's unions to the ONE spelling every producer of that name
// uses, DESCENDING through array-of-union, paren grouping, inline shapes and map values so
// a nested union keys the same slot as a flat one. A closure element / a top-level function
// type is left untouched (its `=>`-result litunion is not a slot-key union — descending
// would corrupt its param/result parens). Mirrors `canonEmitName`'s guarded array/paren
// descent. Since the owner ruling of 2026-07-29 a litunion-ALIAS atom is PRESERVED here
// (`(K0|i32)[]` stays `(K0|i32)[]`), matching what both checker producers spell — see
// `canonLitUnionArms`, which this delegates every union arm to.
function rlCanonLitUnionAtoms(name: string): string {
  const n = name.length
  if n == 0 { return name }
  if isTopLevelFuncTypeName(name) { return name }
  // A trailing `[]`: canon the element, re-grouping a union element with parens
  // (`(K0|i32)[]`), exactly as `canonEmitName` re-wraps.
  if nameIsElemArray(name) {
    const core = rlCanonLitUnionAtoms(arrElemNameRaw(name))
    if unionMemberCount(core) > 1 { return "(" + core + ")[]" }
    if isTopLevelFuncTypeName(core) { return "(" + core + ")[]" }
    return core + "[]"
  }
  // A parenthesized group wrapping the whole: strip and canon the inside — UNLESS the
  // inner is a function type (`((i32) => K0)` — a GROUPED closure element, whose grouping
  // parens are part of its ref-list slot key; stripping them re-keys the slot, and its
  // `=>`-result litunion is not a slot-key union anyway). Leave such a name untouched.
  // (`tyname.nameIsParenSpanEnds` — the endpoint span, no balance walk. This site
  // bounds only `n >= 1` (the `n == 0` early return above); the home's `length >= 1` IS
  // that bound, so the routing is exact on every input including the one-character name.)
  // The interior is `tyname.groupInnerOf` (W1). This site spelled the cut `slice(1, n - 1)`
  // against a HOISTED length rather than `slice(1, name.length - 1)`, which is why the
  // #1239 census scored it as a different normalised operation and left it out of W1's
  // `emit_classify` list — `n` is `name.length`, bound four lines up and never reassigned,
  // so it is the same operation and the same eighteen-copy family.
  if nameIsParenSpanEnds(name) {
    const inner = groupInnerOf(name)
    if isTopLevelFuncTypeName(inner) { return name }
    return rlCanonLitUnionAtoms(inner)
  }
  // An inline SHAPE `{…}`: soften litunion-alias atoms inside its field / value types —
  // the struct sibling of the array `[]` descent. The map-VALUE struct of `{[string]: {f:
  // K0 | f64}}` is canon-softened to `{f:string|f64}` on the annotation side
  // (`canonEmitTypeNames`) but rendered `{f:K0|f64}` by a self-inferred factory-return
  // lambda (`tyToEmitName` preserves litunion aliases) — two mv-slot KEYS, twin map/
  // functypes, a `$fnsig` cast TRAP at the returned-map read. Descending here keys every
  // producer on ONE slot.
  // The BRACE-SPAN home (`emit_base.nameIsBraceSpanEnds`) then the MAP OPENER
  // (`emit_base.nameIsMapOpen`) — "is it a `{…}` group at all", then "which kind of
  // group", the exact two-step `emit_base.annObjFieldSplit`'s tri-state was rewritten as
  // in #1222. The span home must stay the WIDE one: the map arm immediately below is
  // reached only through it, and `nameIsShapeSpanEnds` would reject every `{[` name.
  // Bounds: this site carried only `n >= 1` (the `n == 0` early return above) and the home
  // asks `>= 2`, which agree because one character cannot be both `{` and `}`; the map
  // arm's own `n >= 2` conjunct is the home's bound, now asked once.
  if nameIsBraceSpanEnds(name) {
    // A map `{[K]:V}`: soften the VALUE (a nested map / struct value); leave the key text.
    if nameIsMapOpen(name) {
      const mv = mapValNameOf(name)
      if mv == "" { return name }
      const cmv = rlCanonLitUnionAtoms(mv)
      if cmv == mv { return name }
      // `name` = `{[` + key + `]:` + mv + `}` — replace only the value tail.
      return name.slice(0, n - mv.length - 1) + cmv + "}"
    }
    // A struct `{f:T,…}`: soften each field type.
    const fNames: string[] = []
    const fTypes: string[] = []
    shapeFieldParse(name, fNames, fTypes)
    if fNames.length == 0 { return name }
    let sChanged = false
    let sOut = "{"
    let sfi = 0
    while sfi < fNames.length {
      if sfi > 0 { sOut = sOut + "," }
      const ct = rlCanonLitUnionAtoms(fTypes[sfi])
      if ct != fTypes[sfi] { sChanged = true }
      sOut = sOut + fNames[sfi] + ":" + ct
      sfi = sfi + 1
    }
    sOut = sOut + "}"
    if sChanged { return sOut }
    return name
  }
  // A top-level union: soften each litunion-alias atom, and DESCEND non-litunion atoms
  // (a nullable struct value `{f: K0|f64} | null`, whose struct atom carries the litunion
  // one level down). NICHE GUARD (mirrors `mvCanonValName`): soften a litunion atom ONLY
  // when a genuine non-null, non-litunion sibling exists (a real box MIX). A pure
  // `K0 | null` is the -1-sentinel MONO niche — widening it to `string | null` re-reps the
  // niche and breaks the nullable-litunion values; leave it (and any descent) untouched.
  if unionMemberCount(name) > 1 { return canonLitUnionArms(name) }
  name
}

// The ref-list element's stored NAME normalizer (destringify D2). The slot KEY
// is now `repElemKey` (structural, from the arena type); this produces the
// canonical NAME the slot STORES, which the not-yet-destringified downstream
// name-consumers still read to make their own decisions — the `is`-narrowing
// emit's litunion classifier, the union-variant lookup, `mapValNameOf`,
// `structIdxOfElemName`, and the ref-array ARM scanner
// (`unionRefArrayArmSlotForElemAtom`). Those live in later phases (D3+): until
// they migrate, the stored name must be the emit-canonical spelling — which
// since the owner ruling of 2026-07-29 PRESERVES a litunion-alias atom
// (`K0|{w:i32}` stays `K0|{w:i32}`), because that is what both checker producers
// spell and what the union ROW is registered under. An i32-/string-backed leaf
// list still folds to its shared-wrapper spelling. This is name normalization for
// name-consumers, NOT the slot key — `rlCanonLitUnionAtoms` does the canon, and
// the two array folds mirror `nameIsI32Array` / `nameIsStringArray`.
//
// WHEN THIS SPELLING MOVED, ITS READERS HAD TO MOVE WITH IT, and one of them had
// never been reached by an alias before: the arm scanner compares these atoms
// against a CLOSED probe vocabulary (`"string"`, `"boolean"`, `"f64"`, `"i64"`,
// `"i32"`, a variant name), so a preserved `K0` matched nothing and a list literal
// lost its ref-array arm — invalid wasm. Any future change to what is stored here
// owes that site a look; it cannot report a miss as an error, because "no arm
// matched" is one of its legitimate answers.
function rlElemStoredName(name: string): string {
  const c = rlCanonLitUnionAtoms(name)
  if nameIsI32Array(c) { return "i32[]" }
  if nameIsStringArray(c) { return "string[]" }
  c
}

export function rlInternName(name: string, kind: i32) {
  rlInternNameTy(name, kind, -1)
}

// `rlInternName` with the caller's RECORDED arena type for `name` (destringify
// D-REPELEMTY). The hint reaches the KEY and nothing else — the scan, the MINT, the
// stored spelling and every sidecar push below are unchanged, and a hinted call that
// finds no row interns exactly the row an unhinted one would.
//
// THAT IS THE WHOLE OF WHY THIS IS ALLOWED AT AN INTERNER. D-MAPNODETY's rule — *the
// arena leg can front a FIND; it must NOT front a MINT* — is about a rung that RETURNS
// where the mint would have run; this is not one. What it does require instead is that
// the hint compute the SAME key: a hint that disagrees re-keys the row, which is the
// same silent-wrong-slot failure by another route. `repElemKeyOfNameTy`'s header states
// the construction that makes the two shipped hint sites equal, and the two node-bank
// sites it refutes.
export function rlInternNameTy(name: string, kind: i32, ty: i32) {
  if name == "" { return -1 }
  // Dedup on the element's REP key (`repElemKey`, destringify D2) — the STRUCTURAL
  // wrapper-equivalence class, NOT a string-canonicalized name. Two spellings that
  // share a WasmGC wrapper collapse to ONE slot: an i32-backed leaf list
  // (`boolean[]` / litunion `K[]` / `(boolean|null)[]` — the shared `lTypeIdx`
  // i32-list wrapper), a string-backed leaf list (`(string|null)[]` — the
  // `$mkListIdx` wrapper), and a litunion-alias union member with its boxed `string`
  // atom (`K0|i64` ≡ `string|i64`, R3's rule — else two slots sharing one wrapper
  // keyed TWO `$fnsig` results `>r0;`/`>r1;`, minting byte-identical yet
  // iso-recursively DISTINCT functypes, a value-call `ref.cast` TRAP). That last
  // equivalence is REP-level and structural (`repCanonKey` rewrites a litunion member
  // to `string` while walking `uMembers`), so it is unaffected by the 2026-07-29 ruling
  // that the NAME preserves the alias — the two layers are deliberately separate here.
  // Declared struct twins stay apart (`repElemKey` keys a struct nominally). The stored
  // name is the canonical spelling for downstream name-consumers (`rlElemStoredName`).
  const key = repElemKeyOfNameTy(name, ty)
  let i = 0
  while i < rlElemName.length {
    if rlElemKey[i] == key { return i }
    i = i + 1
  }
  const stored = rlElemStoredName(name)
  rlElemName.push(stored)
  rlElemKey.push(key)
  // The ARENA type the STORED spelling denotes (destringify D5-final) — recorded
  // here, once, because this is where the row is minted and the spelling is in
  // scope. It is the STORED name that every downstream reader sees, so that is the
  // spelling resolved (not the raw `name`, which `rlElemStoredName` may have folded).
  // -1 for a spelling neither path resolves; consumers then keep their name path.
  rlElemTyIx.push(fieldElemTyIxOfName(stored))
  rlElemHeap.push(0)
  rlBackIdx.push(0)
  rlWrapIdx.push(0)
  rlElemKindTbl.push(kind)
  if rlElemNicheNullable(kind, stored) {
    rlElemNullable.push(1)
  } else {
    rlElemNullable.push(0)
  }
  rlElemName.length - 1
}

// The table SLOT for a ref-list element type-NAME (destringify D2). Nominal
// exact-name match is the fast path; on a miss, the REP-KEY scan (`repElemKey`,
// the fold-collapsing structural key the slot was interned on — the i32-leaf /
// string-leaf list folds + the litunion-atom softening); then the struct-twin
// FALLBACK (the struct table's nominal-then-structural bridge, extended to the
// ref-list layer): a STRUCT element spelled differently from the interned key —
// an inline shape vs its declared twin (`{v:i32}` vs `A`), or two
// structurally-identical declared names — resolves to the slot whose element
// backs the SAME heap type. The two-layer discipline holds: the element names
// must resolve to struct slots that are canonical-key AND field-code-layout twins
// (`repStructSlotsTwin`), and the `| null` niche parity must agree (a
// niche-nullable element's index read stays nullable — merging it with a non-null
// slot would change the read discipline, not just the heap type). -1 when nothing
// matches.
export function rlSlotByName(name: string): i32 {
  rlSlotByNameTyK(name, -1, -1)
}

// `rlSlotByName` with a KEY-ONLY hint (destringify D-INLINESHAPETY): the caller's
// recorded arena type for `name` reaches rung 2's `repElemKey` and NOTHING else — the
// rendered rung 3 stays laddered, unlike `rlSlotByNameTy`'s full hint, which deletes it.
//
// THE TWO ARE DIFFERENT CLAIMS AND THAT IS WHY THERE ARE TWO ENTRY POINTS.
// `rlSlotByNameTy(name, ty)` asserts *the arena leg is TOTAL here* — measured for
// `sFieldRefSlot`, whose rendered rung answers 0 times over the corpus. A caller with a
// recorded type but no such measurement (`variantFieldRefSlot`, `mvValInnerRlSlot`)
// wants only the cheaper key; deleting its rendered rung would be an unmeasured
// behaviour change on a rung that DOES answer there (25 of 584 entries at
// `variantFieldRefSlot`). Passing -1 as the twin/rendered `ty` keeps that ladder exactly
// as it was and buys the one thing the hint is for: rung 2 stops calling `resolveAnnot`.
export function rlSlotByNameKeyTy(name: string, keyTy: i32): i32 {
  rlSlotByNameTyK(name, -1, keyTy)
}

// The ref-list slot of the ELEMENT of the ref-array spelling `arrName` — `rlSlotByName`
// of `refArrElemName`. Four sites (the two element/value sidecar fall-throughs and the
// two `$fnsig` result-spine readers) composed these by hand; the file's own comments
// call the composition out by name in five more places, which is the tell that it was
// already a concept without being a function. One home is also the one place an arena
// element type (`tyRefArrElemOf`) has to be threaded when it arrives.
function rlSlotOfArrName(arrName: string): i32 {
  rlSlotByNameKeyTy(refArrElemName(arrName), -1)
}

// `rlSlotOfArrName` with the caller's ARENA element type for `arrName`'s element — the
// thread the home's header above says has to exist "when it arrives". KEY-ONLY (see
// `rlSlotByNameKeyTy`): `elemTy` is `tyRefArrElemOf` of the array's recorded type, the
// arena dual of the `refArrElemName` peel this composition performs on the spelling.
function rlSlotOfArrNameTy(arrName: string, elemTy: i32): i32 {
  rlSlotByNameKeyTy(refArrElemName(arrName), elemTy)
}

// `rlSlotByName` with the caller's RECORDED arena element type as a hint for rungs 2
// and 3 (destringify D-TWINROW, then D-REPELEMTY). Rung 1, the exact-stored-name match,
// is untouched and still first — a hint must never preempt it. Rung 3 is the one that
// had no arena input: it resolves a struct ROW from a rendered element spelling on BOTH
// sides (`structIndexOfTypeName` → `shapeFieldParse`), and `rlSlotOfTyTwin` is its arena
// dual.
//
// RUNG 2 IS THE SAME KEY EITHER WAY, AND FOR A HINTED CALLER IT IS PROVABLY A REPEAT.
// The rung computes `repElemKey` of what `name` resolves to; `repElemKeyOfNameTy` reads
// the hint instead of re-resolving. `sFieldRefSlot`, the only hinted caller, has ALREADY
// run `rlSlotOfTy(ty)` — `repElemKey(ty)` against this very column — and reached here
// because it declined, so the hinted rung 2 can only decline again. It is kept rather
// than deleted because an unreached rung is not a wrong one and the ladder shape is the
// contract; what it stops doing is asking `resolveAnnot`. Measured on the shipped ladder
// before the change: rung 2 returns a slot **0 times in 1,792 entries** at that caller
// (rung 1: 0, rung 3: 7), i.e. the probe #1291 asked for before touching this rung.
//
// **A HINTED call never runs the rendered rung 3** — that leg is DELETED for it, not
// laddered, because the arena leg is TOTAL there and was measured so: an
// `emitFail` where the arena rung declines AND the rendered rung would have answered
// fires **0** times over 1,242 corpus files and 100,800 fuzz programs, while the
// same marker in a build whose arena rung is forced to decline fires on **6** corpus
// files and **22** fuzz programs. Where both answer they never disagree (6/6 corpus,
// 22/22 fuzz); the arena rung additionally answers 16 fuzz cases the rendered rung
// declines, so it strictly EXTENDS coverage rather than overriding it.
//
// `ty` -1 = no hint (every caller but `sFieldRefSlot`), and those keep the rendered
// rung unchanged — it is still load-bearing for them.
export function rlSlotByNameTy(name: string, ty: i32): i32 {
  rlSlotByNameTyK(name, ty, ty)
}

// The shared body of the three entry points above. `ty` is the FULL hint (rung 3's
// twin input, and the assertion that lets the rendered rung be deleted); `keyTy` is the
// KEY hint alone. `rlSlotByNameTy` passes the same index as both — its caller's claim
// is the strong one; `rlSlotByNameKeyTy` passes -1 as `ty`, so only rung 2 moves.
function rlSlotByNameTyK(name: string, ty: i32, keyTy: i32): i32 {
  let i = 0
  while i < rlElemName.length {
    if rlElemName[i] == name { return i }
    i = i + 1
  }
  const key = repElemKeyOfNameTy(name, keyTy)
  let ci = 0
  while ci < rlElemName.length {
    if rlElemKey[ci] == key { return ci }
    ci = ci + 1
  }
  const tw = rlSlotOfTyTwin(ty)
  if tw >= 0 { return tw }
  // The DELETED rendered rung, for a hinted caller (see the header): no
  // `nullablePartOf`, no `structIndexOfTypeName`, no `shapeFieldParse` on this path.
  if ty >= 0 { return -1 }
  const qn = nullablePartOf(name)
  let qBase = name
  if qn != "" { qBase = qn }
  const qsi = structIndexOfTypeName(qBase)
  if qsi < 0 { return -1 }
  let j = 0
  while j < rlElemName.length {
    if rlElemKindTbl[j] == 1 {
      const en = rlElemName[j]
      const enn = nullablePartOf(en)
      let parity = false
      if qn == "" && enn == "" { parity = true }
      if qn != "" && enn != "" { parity = true }
      if parity {
        let eBase = en
        if enn != "" { eBase = enn }
        const esi = structIndexOfTypeName(eBase)
        if esi >= 0 && repStructSlotsTwin(qsi, esi) == 1 { return j }
      }
    }
    j = j + 1
  }
  -1
}

// The struct table row an ARENA type resolves to, with the SAME two-rung shape
// `structIndexOfTypeName` has — which is the thing three earlier attempts at this
// rung each implemented only half of (destringify D-TWINROW):
//
//   rung 1, IDENTITY. `structIndexByName(name)` is nominal: a row minted under this
//   exact spelling IS the answer. Its arena reading is `structIndexOfTy` over the D0
//   sidecar `sTyIx` — the arena index recorded AT the row's mint. Measured: at every
//   `T0`-style declared-alias candidate of the `WSFRL` witness set, `structIndexOfTy`
//   returns exactly the row `structIndexByName` returns.
//   `repRowOfTyStruct`'s CANON key also reproduces this rung (same 6/6) — and that is
//   why a canon-key resolver looks right until it meets rung 2.
//
//   rung 2, LENIENT FIELD-NAME SET. For an INLINE shape spelling no row was minted
//   under, the name resolver falls to a field-NAME-set scan in row order. The canon
//   key does NOT reproduce this — it is strictly stricter, and the leniency is the
//   point (the nested-alias twin pattern: an outer `{f: X}` matching its inner `X`
//   row). Measured: at every inline candidate of the witness set, `structIndexOfTy`
//   declines and the name-set scan returns exactly the row the name resolver returns,
//   while `repRowOfTyStruct` returns a DIFFERENT one.
//
// The name resolver TIGHTENS rung 2 with `shapeFieldTypeCompat`, a field-CODE test.
// That tightening is deliberately NOT reproduced here, for a reason and with a
// guard. The reason: the field-code vocabulary has exactly two producers, both
// string-driven — `nameFieldCode(t: string)` over a rendered type and
// `fieldTypeCode(tyIx)` over an AST `TypeRef` node's `tyName` — and no `Ty`-arena
// classifier, so an arena tightening would mean a THIRD hand-copied copy of a
// 34-arm table (the exact drift hazard D-ABIDEDUP had just removed). The guard: this
// row feeds `repStructSlotsTwin` at the only call site, which is a canonical-key AND
// field-code-LAYOUT equality over the two rows — so a row this scan matches more
// leniently than the name scan cannot yield a slot unless it is a layout twin
// anyway. The rung stays an ARENA LEG: where it declines, the rendered rung runs
// unchanged.
function repRowOfTyLenientRow(ty: i32, lim: i32): i32 {
  const idr = structIndexOfTy(ty)
  if idr >= 0 && idr < lim { return idr }
  if ty < 0 { return -1 }
  if ty >= T.tys.length { return -1 }
  const t = T.tys[ty]
  if !(t is TyObj) { return -1 }
  const n = t.objFieldNames.length
  let si = 0
  while si < lim && si < sNames.length {
    // The half-built-row skip `structIndexOfTypeName` documents: `internInlineShape`
    // pushes a row HEADER before its per-field rows, and this scanner can be
    // re-entered mid-field-loop.
    if sFieldStart[si] + sFieldCount[si] > sFieldElemName.length {
      si = si + 1
      continue
    }
    if sFieldCount[si] == n {
      let ok = true
      let k = 0
      while k < n {
        if sFieldIndex(si, t.objFieldNames[k]) < 0 { ok = false }
        k = k + 1
      }
      if ok { return si }
    }
    si = si + 1
  }
  -1
}

// The ARENA dual of `rlSlotByName`'s struct-twin rung (destringify D-TWINROW): the
// ref-list slot whose ELEMENT is a layout twin of the arena type `ty`, with both
// sides resolved from recorded arena types (`sTyIx` via `repRowOfTyLenientRow`, and
// each candidate slot's `rlElemTyIx`) instead of from rendered element spellings.
// The `| null` niche PARITY the name rung enforces is a `TyNullable` test here — the
// same single hop, structurally. -1 = no arena answer, and the rendered rung runs.
export function rlSlotOfTyTwin(ty: i32): i32 {
  if ty < 0 { return -1 }
  if ty >= T.tys.length { return -1 }
  let qty = ty
  let qNul = false
  const qt = T.tys[ty]
  if qt is TyNullable {
    qty = qt.nInner
    qNul = true
  }
  const qsi = repRowOfTyLenientRow(qty, sScanLim())
  if qsi < 0 { return -1 }
  let j = 0
  while j < rlElemName.length {
    if rlElemKindTbl[j] == 1 {
      const ety = rlElemTyIxAt(j)
      if ety >= 0 && ety < T.tys.length {
        let eb = ety
        let eNul = false
        const et = T.tys[ety]
        if et is TyNullable {
          eb = et.nInner
          eNul = true
        }
        if eNul == qNul {
          const esi = repRowOfTyLenientRow(eb, sScanLim())
          if esi >= 0 && repStructSlotsTwin(qsi, esi) == 1 { return j }
        }
      }
    }
    j = j + 1
  }
  -1
}

// ── Canonical layout twins, MAP-VALUE slot layer (roadmap repOf, slot layer) ──
// The struct table dedups by canonical key + field codes (`sTwin`), the ref-list
// table by resolved element heap (`rlTwin`). The map-VALUE table (`mvValName`)
// is the next name-keyed layer: each slot mints its own 7-field map struct
// (`mvMapTypeIdx`) whose ONLY varying field is the vals-list wrapper, so two
// slots whose VALUE types are layout twins emit byte-identical map structs —
// which, inside the single rec group, are still DISTINCT heap types unless they
// share one index (a `{[string]: B}` passed where a `{[string]: A}` twin is
// expected was invalid wasm). `repMapValSlotsTwin` is the pairwise equivalence,
// TIMING-INDEPENDENT (no heap index is consulted, so it is queryable before
// `mAssignTypeIndices` assigns anything): the struct template's two-layer
// discipline, with the structural key resolved through the checker
// (`repNameCanonKey`) and the layout guard delegated per value KIND to the
// layer that owns the rep.

// True when ref-list slots `a` and `b` resolve the SAME element heap type — the
// pairwise LAYOUT-twin equivalence over the ref-list table, mirroring the
// `rlSig` arms of `mAssignTypeIndices` from checker-level data only (each arm
// below must stay at least as strict as its `rlSig` twin, so a claimed twin
// always resolves equal (backing, wrapper) pairs there):
//   · singleton element heaps — the union box (2), the i32-list wrapper (4),
//     the closure fat-pointer (5), the string/f64/i64/f32 inner-list wrappers
//     (6/7/8/10) — kind equality IS heap equality;
//   · a struct-LIST element (9, `S[][]`) twins iff the inner lists do;
//   · a MAP element (3) twins iff both are the shared mono map or their value
//     slots are `repMapValSlotsTwin` (the mutual recursion bottoms out — every
//     step descends into a strictly shorter element spelling);
//   · a struct / nullable-struct element twins per `repStructSlotsTwin` with
//     matching `| null` niche parity (stricter than heap identity — the
//     `rlSlotByName` discipline: a niche-nullable element's read stays
//     nullable, so parity is part of slot equivalence, not just heap identity),
//     both read off the element's recorded arena TYPE (`rlElemIsNulNiche` /
//     `rlElemStructRow`), not off its rendered spelling;
//   · a variant element only twins with ITSELF (the variant table is the next
//     name-keyed layer; until it dedups, distinct indices are distinct heaps).
export function rlSlotsLayoutTwin(a: i32, b: i32): i32 {
  if a == b { return 1 }
  if a < 0 || b < 0 { return 0 }
  const ka = rlElemKindTbl[a]
  if ka != rlElemKindTbl[b] { return 0 }
  if (
    ka == 2 ||
    ka == 4 ||
    ka == 5 ||
    ka == 6 ||
    ka == 7 ||
    ka == 8 ||
    ka == 10
  ) {
    return 1
  }
  if ka == 9 {
    // The INNER list slots come off the ARENA chokepoint (`rlElemInnerSlot`),
    // whose element-NAME surgery is the untouched fall-through for a slot the
    // sidecar does not cover.
    return rlSlotsLayoutTwin(rlElemInnerSlot(a), rlElemInnerSlot(b))
  }
  if ka == 3 {
    const ma = rlElemMapValMvSlot(a)
    const mb = rlElemMapValMvSlot(b)
    if ma == -1 && mb == -1 { return 1 }
    if ma < 0 || mb < 0 { return 0 }
    return repMapValSlotsTwin(ma, mb)
  }
  // The struct tail, off the ARENA chokepoints: the `| null` niche parity through
  // `rlElemIsNulNiche` (the recorded element TYPE is a `TyNullable`) and the struct
  // ROW through `rlElemStructRow` (the row the element type resolves to). Each keeps
  // its element-NAME leg as the fall-through for a slot the sidecar does not cover.
  if rlElemIsNulNiche(a) != rlElemIsNulNiche(b) { return 0 }
  const sa = rlElemStructRow(a)
  const sb = rlElemStructRow(b)
  if sa >= 0 && sb >= 0 { return repStructSlotsTwin(sa, sb) }
  0
}

// True when map-value slots `a` and `b` share ONE map-struct WasmGC heap type:
// the canonical structural key of the VALUE type (through the checker) plus the
// per-kind layout guard. Scalar/string values (3/10/11/13) ride fixed singleton
// vals lists; a union-box value (2) rides the ONE shared `uBoxIdx` box; a
// closure value (14) the ONE `cloStructIdx` fat pointer — for those the kind +
// canonical key decide. A struct value (1) guards with `repStructSlotsTwin`, a
// ref-list / nested-map value (6) with `rlSlotsLayoutTwin` over the vals slots.
export function repMapValSlotsTwin(a: i32, b: i32): i32 {
  if a == b { return 1 }
  if a < 0 || b < 0 { return 0 }
  // THE KEY IS PART OF THE LAYOUT, not just of the identity: field 0 (`keys`) is the
  // string-ref list wrapper on one rep and the i32 list wrapper on the other, so two
  // slots agreeing on every VALUE question are still two byte-DIFFERENT map structs when
  // their keys differ. Asked first — it is the cheapest discriminator and the only one
  // the value-side guards below cannot see.
  if mvSlotKeyI32(a) != mvSlotKeyI32(b) { return 0 }
  const k = mvValKind[a]
  if k != mvValKind[b] { return 0 }
  const ka = mvValCanonKey(a)
  if ka == "" { return 0 }
  if ka != mvValCanonKey(b) { return 0 }
  if k == 3 || k == 10 || k == 11 || k == 13 { return 1 }
  if k == 2 || k == 14 { return 1 }
  if k == 1 { return repStructSlotsTwin(mvValStructIdx[a], mvValStructIdx[b]) }
  if k == 6 { return rlSlotsLayoutTwin(mvRlSlot[a], mvRlSlot[b]) }
  0
}

// The canonical REPRESENTATIVE map-value slot for `slot`: the smallest slot that
// is a `repMapValSlotsTwin` layout twin (the equivalence is transitive — key
// equality composes, and every guard layer is itself a canonical-key + layout
// equivalence — so first-twin picks one stable representative per class). The
// heap mint (`mAssignTypeIndices`), the union-box tag (`mapSlotTag`), and the
// arm-slot guard (`unionHasMapArmSlot`) all canonicalize through this ONE
// chokepoint, so a twin-spelled map arm boxes, tags, and casts as its
// representative. A negative slot (mono `-1` / unsupported `-3`) passes through.
export function mvCanonRepOf(slot: i32): i32 {
  if slot < 0 { return slot }
  let t = 0
  while t < slot {
    if repMapValSlotsTwin(t, slot) == 1 { return t }
    t = t + 1
  }
  slot
}

// True if a `+` expression has a string LITERAL anywhere in its chain — the syntactic
// concat test `anonFieldCode` can run, standing where `exprIsStrConcat` cannot: a field
// value is classified during `collectS`, before the locals a typed operand test reads
// exist, so there is no `fnIx` to ask. Whole chain, because `+` associates left and a
// concat's outermost operands are then a BinExpr and whatever the last operand is.
function plusChainHasStrLit(ix: i32) {
  const e = P.nodes[unwrapParen(ix)]
  if e is StrLit { return true }
  if e is BinExpr {
    if e.binOp == "+" {
      if plusChainHasStrLit(e.binLeft) { return true }
      return plusChainHasStrLit(e.binRight)
    }
  }
  false
}

// The struct field-type CODE for an ANONYMOUS-shape field, from its literal VALUE
// (an anonymous literal has no `type` annotation to read): a number/boolean is i32
// (`0`), a string literal is a string ref (`3`), a function VALUE is a closure
// fat-pointer (`14` — a `(ref $cloStruct)`, the same kind #306 uses for a closure
// cell). A function value is either a FuncDecl literal (an inline lambda) or a bare
// Ident naming a function. Anything else (a nested literal, a call, …) returns -1 —
// the whole shape is then left un-interned and the literal fails loudly downstream.
export function anonFieldCode(valIx: i32) {
  if valIx < 0 { return -1 }
  const e = P.nodes[valIx]
  if e is NumLit {
    // A float `.` literal field (`x: 1.5`) is an f64 slot (code 17) — UNLESS the context
    // adopted an f32 slot (the checker recorded f32 on the node, `objRetWidenAdopt`'s
    // f32-field arm): code 24, and the literal re-encodes exactly at f32 at the field store.
    if numTextIsFloat(e.numText) {
      if tyKindOf(nodeTyIxOf(valIx)) == 13 { return 24 }
      return 17
    }
    // An i64-magnitude literal field (`x: 6000000000`) is an i64 slot (code 23) — an
    // i32-coded shape would `struct.new` the i64 operand into an i32 field: invalid
    // wasm (the lambda-returning-`{f: i64}` hole; a named function's ANNOTATED return
    // shape already coded 23 via `fieldTypeCode`).
    if !numLexFitsI32(e.numText) { return 23 }
    // A SMALL int literal whose context adopted a wider slot — the checker recorded
    // i64/f64/f32 on the node (`objRetWidenAdopt`, a lambda returning `{f: 5}` against
    // `() => {f: i64}`): code the wide slot; the literal re-encodes at the field store.
    // The f32 rung is the same fact the float arm above already reads, one literal
    // spelling over: an integer literal in an f32 field is an f32 VALUE, and leaving it
    // coded 0 makes `anonValueFitsField` read it as a plain i32 against the f32 slot.
    const tk = tyKindOf(nodeTyIxOf(valIx))
    if tk == 10 { return 23 }
    if tk == 11 { return 17 }
    if tk == 13 { return 24 }
    return 0
  }
  if e is BoolLit { return 0 }
  if e is StrLit { return 3 }
  if e is FuncDecl { return 14 }
  if e is Ident {
    if nameNamesFunction(e.identName) { return 14 }
    return -1
  }
  // An ARITHMETIC field value (`x: x * s` — an operator-overload maker scaling
  // its params) is i32 too; a `+` whose operand is a string literal is a concat
  // (not classifiable here).
  if e is BinExpr {
    const bop = e.binOp
    if bop == "-" || bop == "*" || bop == "/" || bop == "%" { return 0 }
    if bop == "+" {
      // WHOLE CHAIN, not one level: `"a" + f(x) + g(y)` associates left, so its
      // OUTERMOST `+` has a BinExpr on the left and a Call on the right and neither
      // operand is a string LITERAL. Reading that as arithmetic coded the field i32 and
      // then stored a string ref into it.
      if plusChainHasStrLit(valIx) { return -1 }
      return 0
    }
    return -1
  }
  // A NUMERIC-element array literal field: an i32 list (code 4) for i32-range elements,
  // the f64 / i64 scalar-list codes (25 / 26) when ANY element is a float / i64-magnitude
  // literal — the same leaf split the NumLit field takes (an i32-coded list field over an
  // f64/i64 literal mismatched the built list's wrapper). ALL elements scan, exactly like
  // `arrLitIsI64`/`arrLitIsF64`: coding by the FIRST element let `{f: [712583,
  // 13131313131]}` intern an i32-list field and emit `i64.const` into the i32 array —
  // INVALID-WASM (fuzz frontier seed 70441494 d4).
  if e is ArrayLit {
    if e.arrElems.length > 0 {
      const ae0 = P.nodes[e.arrElems[0]]
      if ae0 is NumLit {
        let anyFloat = false
        let anyI64 = false
        let i = 0
        while i < e.arrElems.length {
          const ae = P.nodes[e.arrElems[i]]
          if ae is NumLit {
            if numTextIsFloat(ae.numText) { anyFloat = true }
            else if !numLexFitsI32(ae.numText) { anyI64 = true }
          }
          // A non-literal element (a param read) stays unexamined, as before —
          // only the literal elements steer the leaf split.
          i = i + 1
        }
        // Mixed float + i64-magnitude literals join as a checker-level UNION, not a
        // scalar list — unclassifiable here (-1), the loud path.
        if anyFloat && anyI64 { return -1 }
        if anyFloat { return 25 }
        if anyI64 { return 26 }
        return 4
      }
    }
    return -1
  }
  // A NESTED object-literal field (`pos: { x: 1 }`) is a nested-struct ref (code
  // 15) once the inner literal's shape resolves — the parser interns children
  // before parents (lower arena indices), so a linear collect sees it.
  if e is ObjLit {
    if structIndexOfObj(valIx) >= 0 { return 15 }
    return -1
  }
  // A MAP-producing field value (`const s = { m: Map() }`, `{ m: mk() }`) is a map field,
  // code 19. The literal carries NO annotation, so both halves of the map's rep — the key
  // and the value — come off the type the CHECKER RECORDED on the call, which is the only
  // spelling of them that exists. The lowerability gate is the same `-3` the annotated
  // field position gates with: an unsupported value type leaves the shape un-interned and
  // the literal fails loudly, rather than interning a field with no rep behind it.
  if e is Call {
    if nodeTyIsMap(valIx) {
      if mapNodeValKindLowerable(valIx) { return 19 }
    }
    return -1
  }
  -1
}

// The `sFieldElemName` entry for an ANONYMOUS-shape field: a MAP field (code 19) records
// its VALUE name — `fieldRefElemName`'s code-19 rule, read off the recorded type instead
// of off an annotation — and a code-15 field the nested struct's table NAME (`pos: { x: 1
// }` → the inner shape's synthetic name). "" otherwise.
export function anonFieldElemName(valIx: i32, code: i32) {
  if code == 19 { return nodeTyMapValName(valIx) }
  if code != 15 { return "" }
  const si = structIndexOfObj(valIx)
  if si >= 0 { return sNames[si] }
  ""
}

// The KEY column (B6b) of an ANONYMOUS-shape field row: true only for an i32-keyed MAP
// field, whose (KEY, VALUE) pair is the mv slot's identity — every other code is
// string-keyed by construction. Read off the checker's recorded type, the anonymous
// literal's only spelling of the map.
export function anonFieldElemKeyI32(valIx: i32, code: i32) {
  if code != 19 { return false }
  nodeTyMapKeyIsI32(valIx)
}

// The per-field wasm-type code an INLINE OBJECT-TYPE annotation member names
// (`x:i32` → 0, `name:string` → 3, `tags:i32[]` → 4, …) — the SPELLING entry point
// into the shared field-code table (`fieldCodeOfSpelling`); `fieldTypeCode` is the
// AST-node one.
export function nameFieldCode(t: string) {
  // A NULLABLE function field text (`((i32) => i32) | null`) is the nullable closure
  // fat-pointer, code 22 — the text reading of `fieldTypeCode`'s `nulCloFlag` arm.
  if nameIsNulClosure(t) { return 22 }
  // A function-typed field name — a TOP-LEVEL arrow (`(i32)=>i32`) — is the closure rep,
  // code 14. Depth-aware (`annArrowAt`, not a substring test): a UNION carrying a closure
  // MEMBER (`(() => i32) | string`) nests its arrow in parens and is a value union (code
  // 16, the box) — the substring test claimed it as a bare closure and the constructed
  // box ref mismatched the closure-typed field (an unparseable module when global).
  if annArrowAt(t) >= 0 { return 14 }
  // -1: there is no node, so the literal-union arm is decided from the spelling.
  fieldCodeOfSpelling(t, -1)
}

// Intern every INLINE OBJECT-TYPE annotation (`(p: { x: i32 })`, `: { x: i32 } |
// null` — the synthetic `{x:i32}` TypeRef names) as an anonymous struct shape, so
// a literal with the same field-name SET (`{ x: n }`, even one whose field VALUES
// are param reads `anonFieldCode` cannot classify) matches it via
// `structIndexOfObj`, and `S|null` returns/params resolve their base shape.
// Idempotent per field-name set; a module with no inline object annotation interns
// nothing (byte-identical goldens).
// (ORPHAN: this paragraph documents `emit_collect.collectAnnShapes`, which moved out of this
// file and left its doc behind — `collectAnnShapes` carries none. Left in place because
// `emit_collect.vl` is not this slice's file; the blank line below keeps it from reading as
// `internShapeArms`'s header, which is what it looked like once the function between them went.)

// Intern each union arm whose CORE (trailing `[]`s peeled) is an INLINE `{…}` shape (a struct or
// map arm) via `internShapeDeep` — the shared body of the paren-free and paren-carrying splits.
//
// THE ONE GRAMMAR-PREDICATE CHARACTER TEST THIS FILE KEEPS, AND WHY (D-CLASSGRAM). The arm
// below asks the BARE brace OPENER — `{` at index 0, with NO second-character conjunct and
// NO closing test — under a `length >= 1` bound. The brace family's four homes are
//
//   `typecheck.nameIsShapeOpen`     len >= 2 · OPEN · NOT2ND
//   `emit_base.nameIsMapOpen`       len >= 2 · OPEN · 2ND      (the opener's complement)
//   `emit_base.nameIsBraceSpanEnds` len >= 2 · OPEN · CLOSE
//   `emit_base.nameIsShapeSpanEnds` the first ANDed with the third
//
// and the bare `len >= 1 · OPEN` this site wants is a FIFTH member none of them covers. The
// available spelling, `nameIsShapeOpen(uCore) || nameIsMapOpen(uCore)`, is that disjunction
// exactly — but only above `length >= 2`, so it NARROWS this site at the single input
// `uCore == "{"`. Both halves of that were measured rather than argued: a divergence poison
// (`emitFail` when `uCore` is exactly one `{`) fires on **0** of 1,501 corpus files while its
// inverted control — the same arm reached at all — fires on **160**, and a sabotage that TAKES
// the narrowing reddens 0 wasm sha256 and 0 run-stdout lines. Live arm, measured-EMPTY
// divergence set, no graded consequence: an empty population is the ABSENCE of a witness, not
// agreement, so the faithful `>= 1` bound ships (D-SHAPEFIELD — unreached is not licenced).
//
// The move this site actually wants is a `nameIsBraceOpen` home beside its four siblings in
// `emit_base.vl`, which is not this slice's file. A SOURCES problem, not a site problem.
function internShapeArms(arms: string[]) {
  let uai = 0
  while uai < arms.length {
    const uCore = arrLeafNameOf(arms[uai])
    if uCore.length >= 1 && uCore[0] == '{' {
      internShapeDeep(arms[uai])
    } else if annArrowAt(normTypeAtom(uCore)) >= 0 {
      // A CLOSURE arm (`((i32) => {a: f64, f: K0, z: string}[]) | f64`): the inline
      // shapes buried in its params/result are otherwise unreachable — the arm is ONE
      // spelling inside the union name, so a narrowed arm's value-call result read found
      // no interned struct ("field access but no struct type declared"). Route through
      // the soundness-gated functype interner (`funcTypeShapeLowerable` keeps an
      // unsupported-field shape un-interned — a clean reject, never invalid wasm).
      internFuncTypeShapes(arms[uai])
    }
    uai = uai + 1
  }
  0
}

// Recursively peel the COMPOSITION wrappers off a type name — grouping parens, a trailing `| null`, and
// trailing `[]` suffixes, in any order and to any depth — interning the inline-shape STRUCT reached at the
// bottom (`internInlineShape` then recurses into the shape's own fields). Reaches a shape however deeply it
// is nested under arrays / nullables / groupings: `({g:i32}[] | null)[]` -> `{g:i32}`, `{f:i32}[][]` ->
// `{f:i32}`. A non-shape leaf (`i32`, a named type, a map) interns as a no-op.
export function internShapeDeep(nm: string) {
  if nm.length < 2 { return 0 }
  // Peel ONLY a grouping pair that wraps the WHOLE name. A functype whose leading `(` is its
  // own PARAM LIST (`(i32)=>(()=>{a:i64,f:i32,z:f64})`) must NOT be blind-peeled — the garbled
  // remainder (`i32)=>…`) dead-ends every case below, so the shapes buried in its RESULT spine
  // never intern (and a chained value call's struct read then finds no interned shape).
  const uw = normTypeAtom(nm)
  if uw.length != nm.length { return internShapeDeep(uw) }
  // A VALUE UNION leaf (`i32 | null`, `string | i32`) — register its box reps. Do NOT peel its `| null`:
  // here the null is a union ATOM (a tag in a non-null box), NOT a nullable-niche wrapper. Checked AFTER
  // the parens peel (so `(i32|null)` reaches here) but BEFORE the `| null` peel (which would lose the atom).
  if isValueUnionName(nm) {
    registerValueUnionName(nm)
    // A CLOSURE atom of the value union (`((i32) => {a: f64, f: K0, z: string}[]) | f64`)
    // may bury inline shapes in its params/result — unreachable through the box
    // registration (the arm is one spelling inside the union name), so a narrowed arm's
    // value-call result read found no interned struct. Descend each arrow arm through
    // the soundness-gated functype interner (`funcTypeShapeLowerable` keeps an
    // unsupported-field shape un-interned — a clean reject, never invalid wasm).
    if strContains(nm, "=>") {
      const vArms: string[] = []
      splitUnionAtoms(nm, vArms)
      let va = 0
      while va < vArms.length {
        const vc = normTypeAtom(vArms[va])
        if annArrowAt(vc) >= 0 { internFuncTypeShapes(vc) }
        va = va + 1
      }
    }
    return 0
  }
  const np = nullablePartOf(nm)
  if np != "" { return internShapeDeep(np) }
  // A MIXED / composite UNION (`{f:i64}[] | f64`, `{[string]: K}[] | string`, `{f:i64}[] | {w:i32}`):
  // the all-scalar case was handled by the `isValueUnionName` branch above, so a top-level `|` here
  // means at least one arm is a COMPOSITE. Intern an arm whose CORE (trailing `[]`s peeled) is an
  // INLINE STRUCT / MAP shape (`{f:i64}[]`, `{[string]:V}[]`, a bare `{w:i32}`) NOW — during
  // `collectAnnShapes`, BEFORE the literal that carries it is seen by `collectAnonShapes` (which would
  // otherwise name the same shape `#anonN`, leaving the union-arm's name-based `refArrElemName` /
  // `unionHasRefArrayArmSlot` lookup unable to find the reflist slot the literal interns — a silent
  // fall-through to scalar-boxing, invalid wasm). BOTH branches split with the ONE home
  // `splitUnionAtoms` — it tracks parens, brackets, braces AND `<>` (the D-REFARRKIND-era
  // "paren-blind" reading of it is stale; its own header now spells the paren rule out). The
  // PAREN-FREE branch RETURNS after interning — the descent below is for non-union names — while
  // a PAREN-CARRYING name (`{f: (boolean | string)[]} | f64`, a struct arm whose FIELD groups a
  // union element) interns its `{`-cored arms and then FALLS THROUGH to the paren descent
  // (closure unions etc. keep their existing path). That control-flow difference is the whole
  // difference; the SPLIT is the same query. Before parens were understood, a grouped arm
  // mis-split here and its `{`-cored arm interned only LAZILY at emit, AFTER `collectA`'s
  // type-index assignment, so the arm's ref-list FIELD element (`boolean|string`) had no interned
  // slot and `pushFieldStorage` read `rlWrapIdx` out of bounds — a compiler CRASH (empty table)
  // or a wrong wrapper.
  if !strContains(nm, "(") {
    const uArms: string[] = []
    splitUnionAtoms(nm, uArms)
    if uArms.length > 1 {
      internShapeArms(uArms)
      return 0
    }
  } else {
    const pArms: string[] = []
    splitUnionAtoms(nm, pArms)
    if pArms.length > 1 { internShapeArms(pArms) }
  }
  if nameIsElemArray(nm) { return internShapeDeep(arrElemNameRaw(nm)) }
  // A MAP name (`{[string]: V}`): the inline shapes buried in the VALUE position are
  // otherwise unreachable — the whole map is ONE TypeRef name, so a struct-valued map
  // (`{[string]: {f:f32}}`), a nested-map value (`{[string]: {[string]: i64}}`), a
  // struct value whose field is itself a map (`{[string]: {f: {[string]: i64}}}`), or
  // any list value hides its shape from `internInlineShape` (which no-ops on a map).
  // Descend into the value so its shapes intern — the mv-slot interner (`collectA` →
  // `mvShapeOfValName`) then finds the struct via `structIndexByValName` (position-
  // INDEPENDENT map-value resolution, the #837 template). A NAMED-alias value already
  // interned via its own TypeRef; this is the inline dual, idempotent for either.
  if nameIsMap(nm) { return internShapeDeep(mapValNameOf(nm)) }
  // A FUNCTION-TYPE name (`(p1,p2)=>ret`): the inline shapes buried in a PARAM or
  // the RESULT position are otherwise unreachable — the whole functype is ONE
  // TypeRef name, so a composite closure result (`(i32)=>{f:i32}`, `()=>{a:i32,b:i32}`,
  // `(i32)=>{f:{g:i32}}`) or a composite param hides its shape from
  // `internInlineShape`. A lambda's inferred return literal (`{f:x}` with a param
  // field value `anonFieldCode` codes -1) then has no interned shape to name-set
  // match, and the closure functype result fails loudly ("ref valtype with no
  // interned shape"). `internFuncTypeShapes` interns each PLAINLY-LOWERABLE shape
  // reached — see the soundness note there.
  // (`emit_base.nameIsParenOpen` — the OPEN half only. There is no close test here: the
  // group closes before the `=>`, not at the last character, and `annArrowAt(nm) >= 1`
  // both supplies the home's length bound and stands in for it.)
  if annArrowAt(nm) >= 1 && nameIsParenOpen(nm) {
    return internFuncTypeShapes(nm)
  }
  // A GENERIC-APPLICATION leaf (`Pair<i32,string>`): `collectGenAliasShapes` interns an
  // application only where a TypeRef spells it BARE (behind `| null` / `[]`), so one
  // buried INSIDE another annotation's field text — the list element of
  // `{v: Pair<i32,string>[]}` — reached no interner at all, and the code-5 field's
  // element lookup then failed loudly ("ref-list field element type is not interned").
  // This is the shape-descent dual of the map-VALUE `gaeEnsure` `collectGenAliasShapes`
  // already does for the same reason. `gaeEnsure` no-ops on anything that is not a
  // registered base's application, and is idempotent (`structIndexByName` guard).
  gaeEnsure(nm)
  internInlineShape(nm) // no-op for any non-shape leaf
  0
}

// Whether field CODE `c` is a scalar / string / scalar-list / nested-struct field —
// the reps a struct lowers as a closure result/param WITHOUT touching an unsupported
// composite field (a typed-value MAP is R1, a value-UNION box is R3, a REF list is
// R6). Nested-struct fields (code 15) are checked recursively at the
// `funcTypeShapeLowerable` leaf. A code-18 NULLABLE i32-backed scalar list
// (`i32[] | null` / `boolean[] | null`) IS lowerable: it is the same i32-array +
// `| null` wrapper slot the field carries in any non-closure struct (`internInlineShape`
// interns it identically), so the shape interns and the literal building it name-set-
// matches THIS row instead of fieldset-colliding onto a same-fieldset twin (INVALID
// WASM) or failing loudly ("no interned signature"). The DISTINCT-backing nullable
// scalar lists (`f64[]|null` / `i64[]|null` / `f32[]|null` / `string[]|null`) are
// codes 31/32/33/34 and lower the same way — each is the leaf list's own wrapper slot
// made nullable, exactly what the field carries in any non-closure struct.
function funcTypeFieldCodeSafe(c: i32): boolean {
  c == 0 ||
    c == 3 ||
    c == 4 ||
    c == 6 ||
    c == 15 ||
    c == 17 ||
    c == 18 ||
    c == 23 ||
    c == 24 ||
    c == 25 ||
    c == 26 ||
    c == 27 ||
    isNulScalarListFieldCode(c)
}

// True if `nm` is a NESTED array bottoming out at a SCALAR/STRING leaf list —
// `i32[][]` / `boolean[][]` / `K[][]` (kind 4), `string[][]` / `f64[][]` / `i64[][]` /
// `f32[][]` (kinds 6/7/8/10), or a deeper recursion over those (`i32[][][]`, kind 9
// whose element is itself such an array). NOT a struct/union/closure/map-element
// array (their leaf reps carry the R6/R3/R1 composition seams). The R4 leaf test the
// closure-result shape gate uses: such a field is a plain code-5 ref-list slot whose
// element machinery is fully interned by the `collectA` field pass (`ensureRefElem`).
export function nameIsNestedScalarLeafArray(nm: string): boolean {
  if !nameIsRefArray(nm) { return false }
  const k = refArrElemKind(nm)
  if k == 4 || k == 6 || k == 7 || k == 8 || k == 10 { return true }
  if k == 9 { return nameIsNestedScalarLeafArray(refArrElemName(nm)) }
  false
}

// True if `t` is a STRUCT-element array (`S[]`, `{g: f64}[]`) whose element itself
// lowers as a closure-result field: a declared plain struct name (NOT a union
// variant — its list rides the variant machinery), or an inline shape that
// recursively passes `funcTypeShapeLowerable`. The struct-through-list closure-result
// admission (R6): the element interns like any struct-field element (the code-5
// `ensureRefElem` pass), so the field is a plain ref-list slot. A NULLABLE-struct
// element (`({f: i32} | null)[]`) admits too — it is the kind-1 struct NICHE in the
// SAME ref-list wrapper (see the peel below). A union / map / closure element stays
// un-admitted (their reps carry the R1/R3/R5 seams).
function structElemArrayLowerable(t: string): boolean {
  if !nameIsElemArray(t) { return false }
  // The element text as WRITTEN carries any grouping parens the source spelled
  // (`({g: i32})[]` — pure grouping, `({f: i32} | null)[]` — the nullable-struct
  // NICHE element). Peel the grouping pair, then a `| null` wrapper, so both reach
  // the same admission test the paren-free spelling (`{g:i32}[]`) takes. The
  // nullable peel is the kind-1 struct NICHE (`rlElemNicheNullable`): the element
  // is a `(ref null $S)` in the very same ref-list wrapper the non-null element
  // uses, which the annotated named-function spelling (`mk(): {f: ({f:i32}|null)[]}`)
  // already lowers soundly — so admitting it here only removes the annotation.
  // Un-admitted, the whole closure-result struct stayed un-interned and the body
  // literal fieldset-collided onto its own ELEMENT row (`{f:…}` on both) —
  // INVALID-WASM at the `struct.new` (fuzz report-only branching leg).
  let base = normTypeAtom(arrElemNameRaw(t))
  const nb = nullablePartOf(base)
  if nb != "" { base = normTypeAtom(nb) }
  if nameIsShapeOpen(base) { return funcTypeShapeLowerable(base) }
  nameIsStructDecl(base) && variantIndexOf(base) < 0
}

// `shapeInnerFieldSplit` — the inline-object-shape FIELD scanner — is IMPORTED from
// `emit_base.vl`, one module DOWN. This file used to carry a second, hand-written
// definition of it: the same name, the same signature, the same answer, and its own
// `{}` / `[]` / `()` / `<>` depth walk with its own `tyGtIsClose` close rule. Two
// definitions of one function in two modules is the drift hazard the shape layer's
// history is made of — the `<>` repair (D-GENBRACKET #1118, then #1120's sweep) had to
// be applied to each hand-written scanner separately, one PR at a time.
//
// `emit_base`'s copy had already been migrated onto the published depth-walk home
// (`tyTopLevelSplit`, #1147) while this one still spelled the ladder out, so the two
// were no longer even the same CODE — only the same behaviour. Importing it leaves the
// grammar with one home for all six of its consumers here, `emit_base`'s two and
// `emit_collect`'s two.
//
// ⚠️ THE SENTENCE THAT USED TO END THAT PARAGRAPH — "retires the LAST hand-written
// FIELD-list walk in this file" — WAS FALSE WHEN IT WAS WRITTEN. `shapeFieldParse`, 3,000
// lines up, was a second hand-written field-list walk in this same file, with its own
// `angOpen`/`tyGtIsClose` ladder, and the structural walk census counted it every time.
// It is retired by D-SHAPEFIELD; the claim is true now, and is left standing here only
// because a corrected claim is worth more than a deleted one.

// Whether inline shape `nm` (`{f:i32,g:{h:i32}}`) lowers as a closure result/param
// with NO unsupported composite field, recursing through nested inline shapes (and
// their `| null`). A map / value-union / DISTINCT-backing-nullable-list / closure
// field makes it un-lowerable — those reps are R1/R3/R5, out of THIS slice, and the
// closure must stay a CLEAN reject (never invalid wasm), so the shape is not interned.
// A code-18 i32-backed nullable scalar list (`i32[]|null` / `boolean[]|null`) IS
// lowerable (`funcTypeFieldCodeSafe` admits it) — the same array+`|null` slot a
// non-closure struct carries — and so are the four DISTINCT-backing nullable scalar
// lists (codes 31/32/33/34), each a `(ref null $leafWrapper)` slot.
// A NESTED-array field with a scalar/string leaf (`{f: boolean[][]}` — code 5, but its
// element is a leaf LIST, no struct-through-list seam) IS lowerable: the field is a
// plain ref-list slot the field pass interns like any binding's (the R4 dissolution).
// A STRUCT-element list field (`{f: {g: f64}[]}` / `{f: S[]}`) is likewise lowerable
// when its element is (`structElemArrayLowerable`) — the element shape pre-interns in
// `internFuncTypeShapes` and the slot rides the same code-5 field pass.
//
// ── THE SHAPE-BODY CUT, ONCE, FOR ALL SIX SPLITTERS BELOW (W1) ───────────────────────
// This function and the five under it (`variantNestedShapeOk`,
// `internNonLowerableFieldShapes`, `internShapeFieldElems`, `internInlineShape`,
// `internShapeAs`) each opened with the SAME three lines: two out-arrays and
// `shapeInnerFieldSplit(nm.slice(1, nm.length - 1), …)`. The split has had a home since
// #1147; the CUT it is fed did not, and six identical spellings of it is how a grammar
// drifts. The cut is now `tyname.groupInnerOf`.
//
// THE SIX DO NOT AGREE ON THE GUARD, WHICH IS WHY THE CUT CARRIES NONE. Three test
// `nameIsShapeSpanEnds(nm)` themselves (here, `variantNestedShapeOk`, `internInlineShape`);
// `internNonLowerableFieldShapes` and `internShapeFieldElems` are reached only under
// `internFuncTypeShapes`' own `nameIsShapeSpanEnds` gate; and `internShapeAs` is gated by
// its ONE caller (`emit_collect`'s `unionStructAliasShape`, which returns only names that
// passed `nameIsShapeSpanEnds`). All six therefore establish `length >= 2` — but they
// establish it in three different places, so folding the test into the cut would put it
// where two of the six cannot see it and would double it for the other four.
export function funcTypeShapeLowerable(nm: string): boolean {
  if !nameIsShapeSpanEnds(nm) { return false }
  const fnames: string[] = []
  const ftexts: string[] = []
  shapeInnerFieldSplit(groupInnerOf(nm), fnames, ftexts)
  let okAll = true
  let fieldCount = 0
  let fi = 0
  while fi < fnames.length {
    if fnames[fi] == "" {
      okAll = false
    } else {
      const ftxt = ftexts[fi]
      const fc = nameFieldCode(ftxt)
      if fc < 0 {
        // A NESTED inline-shape field (`g:{h:i32}` / `g:{h:i32}|null`): recurse
        // into the base shape — lowerable only if IT is.
        const base = nonNulBaseOf(ftxt)
        if !funcTypeShapeLowerable(base) { okAll = false }
      } else if !funcTypeFieldCodeSafe(fc) {
        // A code-5 field whose type is a nested SCALAR-LEAF array (`f: boolean[][]`)
        // or a lowerable STRUCT-element array (`f: {g: f64}[]`, `f: S[]`) is a plain
        // ref-list slot — lowerable (see the header note). A code-19 MAP field whose
        // VALUE kind the mv interner represents (`mvValKindOfName != -3`) is likewise
        // lowerable: the field is a plain map-struct slot the `collectA` field pass
        // interns (`mvShapeOfValName`) exactly as for a non-closure struct field —
        // the R1 composition rep the original gate predated. A code-16 union-BOX
        // field whose union is REGISTERED (`isUName` — `registerInlineUnion`'s
        // functype-return descent registers a result shape's field unions in
        // `collectU`, before this gate runs from `internShapeDeep`) is a plain box
        // ref slot the same machinery a non-closure struct field uses. A code-22
        // NULLABLE-CLOSURE field (`f: (() => i64) | null`) is the shared
        // `(ref null $cloStruct)` fat-pointer slot — the SAME rep the field carries in
        // any non-closure-result struct, so the shape interns and the literal that
        // builds it name-set-matches THIS shape (un-interned, the literal self-coded
        // the field 14 — a non-null layout the code-22 reads then mis-cast). Any other
        // unsafe code keeps the shape un-interned (the clean closure reject).
        if (
          !(fc == 5 &&
            (nameIsNestedScalarLeafArray(ftxt) ||
            structElemArrayLowerable(ftxt) ||
            nameIsClosureArray(ftxt))) &&
          !(fc == 19 && mapValKindLowerable(ftxt)) &&
          !(fc == 16 && isUName(ftxt)) &&
          fc != 22
        ) {
          okAll = false
        }
      }
      fieldCount = fieldCount + 1
    }
    fi = fi + 1
  }
  okAll && fieldCount > 0
}

// Whether the inline shape text `nm` (`{f: f32}`, `{a: i64, f: i64, z: boolean}`) will
// intern cleanly as a NESTED struct at the `collectA` phase — the PURE (intern-free)
// mirror of `internInlineShape`'s acceptance, usable during `collectU` (the struct
// table does not exist yet; `collectS`'s reset would wipe anything interned there).
// A field `nameFieldCode` can classify is accepted as-is; an unclassifiable field
// recurses into its own (`|null`-stripped) nested shape, exactly as the interner
// does. Acceptance here OBLIGATES the `collectA` variant-field pass to intern `nm`
// (idempotent), and is monotone-safe: union registration only grows between the two
// phases, so a field code can only improve from -1 — never the reverse.
export function variantNestedShapeOk(nm: string): boolean {
  if !nameIsShapeSpanEnds(nm) { return false }
  const fnames: string[] = []
  const ftexts: string[] = []
  shapeInnerFieldSplit(groupInnerOf(nm), fnames, ftexts)
  let okAll = true
  let fieldCount = 0
  let fi = 0
  while fi < fnames.length {
    if fnames[fi] == "" {
      okAll = false
    } else {
      const ftxt = ftexts[fi]
      if nameFieldCode(ftxt) < 0 {
        // A nested inline-shape field (`g: {h: i32}` / `g: {h: i32} | null`):
        // lowerable only if ITS shape is.
        const base = nonNulBaseOf(ftxt)
        if !variantNestedShapeOk(base) { okAll = false }
      }
      fieldCount = fieldCount + 1
    }
    fi = fi + 1
  }
  okAll && fieldCount > 0
}

// Intern the PLAINLY-LOWERABLE inline shapes buried in the params / result of a
// function-type name `nm` (`(i32)=>{f:i32}`, `({a:i32})=>{b:i32}`), peeling the
// grouping / nullable / array / nested-functype wrappers around each position. Only
// a fully-lowerable struct leaf (`funcTypeShapeLowerable`) is interned — a shape
// with an unsupported composite field (map / value-union / nullable-list) is LEFT
// un-interned so the closure stays a clean reject, exactly as before this slice
// (never invalid wasm). Idempotent (`annShapeIndexOf`); registers no value union
// and interns no map, so a functype over unsupported reps is byte-identical to the
// pre-slice behavior.
function internFuncTypeShapes(nm: string): i32 {
  if nm.length < 2 { return 0 }
  // Peel ONLY a grouping pair that wraps the WHOLE name (`(()=>{f:i32})` → `()=>{f:i32}`).
  // A functype whose leading `(` is its own PARAM LIST (`(i32)=>(()=>{f:i32})`) must NOT be
  // blind-peeled — that garbles the name (`i32)=>(()=>{f:i32}`) and the shapes buried in a
  // NESTED functype result never intern (a chained value call's struct read then finds no
  // interned shape).
  const uw = normTypeAtom(nm)
  if uw.length != nm.length { return internFuncTypeShapes(uw) }
  // A VALUE-UNION leaf (`f64 | null` as a closure RESULT, `i64 | boolean` as a param) —
  // register its box reps, exactly as `internShapeDeep`'s value-union arm does (and
  // BEFORE the `| null` peel: the null is a union ATOM here, not a nullable wrapper).
  // Without it a producer-less closure-arm annotation (`(() => f64 | null) | string`)
  // left the f64 value box UN-MINTED while the narrowed call's unbox still emitted the
  // cast — `ref.cast` to a default type-0 index, INVALID-WASM at the `print` read
  // (fuzz-nightly run 29808029476, seed 100113225 d4).
  if isValueUnionName(nm) {
    registerValueUnionName(nm)
    return 0
  }
  // The ARROW split runs BEFORE the `| null` peel: a TOP-LEVEL arrow (`()=>f64|null`)
  // binds the `| null` to its RESULT (`nulCloFlag`'s rule) — the naive peel treated it
  // as a nullable CLOSURE and the `f64 | null` result never surfaced, so its value box
  // was never registered (the producer-less closure-arm annotation's unbox then cast to
  // a bogus default index — INVALID-WASM; fuzz-nightly run 29808029476, seed 100113225
  // d4). A genuinely nullable closure (`(()=>i32)|null`) nests its arrow in parens —
  // `annArrowAt` is depth-aware, so it still takes the peel below.
  // `annFnDecompose` (#1144) IS this arrow-index + `[0] == '('` + `[fa - 1] == ')'` triple,
  // its param-list slice, its `length > 0`-guarded `annSplitParams` and its return slice —
  // the home's own header names this file's three copies as the residue.
  const fParts: string[] = []
  const fRet = annFnDecompose(nm, fParts)
  if fRet != "" {
    let pi = 0
    while pi < fParts.length {
      internFuncTypeShapes(fParts[pi])
      pi = pi + 1
    }
    return internFuncTypeShapes(fRet)
  }
  const np = nullablePartOf(nm)
  if np != "" { return internFuncTypeShapes(np) }
  if nameIsElemArray(nm) { return internFuncTypeShapes(arrElemNameRaw(nm)) }
  if nameIsShapeSpanEnds(nm) {
    if funcTypeShapeLowerable(nm) {
      internShapeFieldElems(nm)
      internInlineShape(nm)
    } else {
      // The result struct is NOT lowerable as a whole (`funcTypeShapeLowerable`
      // false — e.g. it carries a plain CLOSURE field, code 14): the outer shape
      // stays un-interned here (a literal names it via `collectAnonShapes`), but its
      // NESTED inline-shape fields (`f: {f: string[]}`) and its closure fields' RESULT
      // shapes (`a: () => {f: i64}`) must each still intern their OWN row. Otherwise
      // a literal building the outer shape fieldset-collides the `{f: string[]}` field
      // onto the same-fieldset `{f: i64}` twin (a closure-field sibling's result) — the
      // interned twin drives invalid wasm at the nested struct.new. With both rows
      // present the `collectAnonShapes` ambiguity resolver (`structIndexOfObjCtx`
      // matches>=2 → the checker's recorded node type) disambiguates the nested literal.
      internNonLowerableFieldShapes(nm)
    }
  }
  0
}

// Descend the fields of a NON-lowerable closure-result struct, interning the nested
// inline-shape and closure fields' shapes (via `internShapeDeep`). Only composite
// fields (a `{…}` nested shape, or a `=>` closure) are descended — a scalar / string /
// map / value-union field is left untouched, preserving the closure's clean-reject
// semantics for genuinely-unsupported reps. The depth-0 field split mirrors
// `internShapeFieldElems`.
function internNonLowerableFieldShapes(nm: string) {
  const fnames: string[] = []
  const ftexts: string[] = []
  shapeInnerFieldSplit(groupInnerOf(nm), fnames, ftexts)
  let fi = 0
  while fi < fnames.length {
    if fnames[fi] != "" {
      const ftxt = ftexts[fi]
      // A closure field (`() => {f: i64}`) — intern its result shape. Depth-aware:
      // an inner arrow makes the field a closure regardless of wrappers.
      if annArrowAt(ftxt) >= 0 {
        internShapeDeep(ftxt)
      } else {
        // A nested inline-shape field (`{f: string[]}`, possibly `| null` / `[]`
        // wrapped) — peel the wrappers to the `{…}` (non-map) leaf and intern it.
        const base = arrLeafNameOf(nonNulBaseOf(ftxt))
        if nameIsShapeOpen(base) { internShapeDeep(base) }
      }
    }
    fi = fi + 1
  }
  0
}

// Pre-intern the inline-SHAPE leaves of `nm`'s array-typed fields (`{f: {g: f64}[]}`
// → intern `{g: f64}`), so `internInlineShape`'s code-5 arm resolves each element
// name (its raw-text fallback requires the element already interned — interning
// mid-field-loop would corrupt the flat `sField*` arrays). The functype twin of
// `collectNestedFieldShapes`' leaf strip: peel every trailing `[]` pair and intern a
// `{…}` leaf (`internInlineShape` no-ops on any other text). Runs only on a shape
// `funcTypeShapeLowerable` accepted, BEFORE the shape itself interns.
function internShapeFieldElems(nm: string) {
  const fnames: string[] = []
  const ftexts: string[] = []
  shapeInnerFieldSplit(groupInnerOf(nm), fnames, ftexts)
  let fi = 0
  while fi < fnames.length {
    if fnames[fi] != "" {
      const ftxt = arrLeafNameOf(ftexts[fi])
      // `peeled` — "the loop ran at least once" — IS `leaf != name`: every iteration
      // shortens by exactly two characters, so the peel is the identity iff nothing peeled.
      const peeled = ftxt != ftexts[fi]
      if peeled && nameIsShapeOpen(ftxt) { internInlineShape(ftxt) }
    }
    fi = fi + 1
  }
  0
}

// Intern the inline object-shape TEXT `nm` (`{x:i32}`, `{v:{x:i32}|null}`) as an
// anonymous struct shape, returning its struct table index — or -1 when `nm` is
// not an internable shape (a map `{[…]}`, a named type, a field with no code).
// A field whose type is itself an inline shape (`v:{x:i32}` / `v:{x:i32}|null`)
// RECURSES: the nested shape interns first, the field takes a nullable struct
// ref on it (code 15) — only a nested text with no code fails the whole shape.
// Idempotent per field-name+code set (`annShapeIndexOf`), so a literal-interned
// twin (`collectAnonShapes`) and a re-visited annotation share one entry.
export function internInlineShape(nm: string) { internInlineShapeTy(nm, -1) }

// `internInlineShape` with the caller's RECORDED arena type for `nm` (destringify
// D-INLINESHAPETY). The hint reaches the row's D0 `sTyIx` cell and NOTHING else: the
// field split, every code classification, the `annShapeIndexOf` dedup and the stored
// spelling are untouched, and an unhinted call records exactly what it recorded before.
//
// EQUAL BY CONSTRUCTION, and the construction is the reason this is allowed at a MINT
// at all (`rlInternNameTy`'s header states the rule). Inside this function
// `nameIsShapeSpanEnds(nm)` is TRUE — the early return above is what makes it so — and
// on that branch `sTyIxOfName(nm)` IS `cUserTypes[nm] ?? resolveAnnot(nm)`, which is
// `fieldElemTyIxOfName(nm)`'s whole body. The two shipped hints are
// `uFieldElemTyIxRow(ufn)`, recorded by `recordUFieldElemRow` from the SAME
// `uFieldElemName` cell the caller passes here, so the two legs read one arena index.
// The only spelling where they part is the >4096-character runaway cap, which the
// recorder answers -1 for — and a -1 hint takes the name leg unchanged.
//
// **THE OTHER FOUR CALLERS ARE NOT HINTABLE AND THAT IS THE MEASUREMENT, NOT AN
// OMISSION.** 1,046 of the 1,064 `sTyIxOfName` resolutions arrive from
// `internShapeDeep`'s peeled leaf (873), `internFuncTypeShapes` (116), this function's
// own nested-field recursion (56) and `internShapeFieldElems` (5) — each of which
// composed `nm` by CUTTING a larger spelling, so no caller holds a bank for the cut.
// The largest chain roots at a `TypeRef` node, i.e. the mono-clone `nodeTyIx`
// population D-REPELEMTY §3a refuted, one peel further away.
export function internInlineShapeTy(nm: string, tyIx: i32) {
  if !nameIsShapeSpanEnds(nm) { return -1 }
  // Split `x:i32,y:string` into names + codes at depth 0 (`shapeInnerFieldSplit` —
  // the shape layer's ONE field scanner). `texts` keeps each field's type TEXT (a
  // code-16 union field interns its union and records the name in `sFieldElemName`;
  // a code-15 nested field records its base shape).
  const rawNames: string[] = []
  const rawTexts: string[] = []
  shapeInnerFieldSplit(groupInnerOf(nm), rawNames, rawTexts)
  const names: string[] = []
  const codes: i32[] = []
  const texts: string[] = []
  let ok = true
  let fi = 0
  while fi < rawNames.length {
    if rawNames[fi] == "" {
      ok = false
    } else {
      let ftxt = rawTexts[fi]
      // PRE-INTERN any inline shape / value union buried in the field type BEFORE classifying. A
      // nullable ref-list field (`{g:i32}[] | null` / `(i32|null)[] | null`, code 28) needs its element
      // shape interned (or value-union registered) for `nameFieldCode` to even recognize the non-null
      // part as a ref array. `internShapeDeep` peels array / nullable / grouping wrappers to the leaf and
      // interns/registers it; a no-op for a scalar / nominal / map field. MUST run BEFORE any row is
      // pushed (the outer shape is pushed to `sNames` only after this loop, so the flat `sField*`
      // arrays aren't corrupted by the re-entrant intern).
      internShapeDeep(ftxt)
      let fc = nameFieldCode(ftxt)
      if fc < 0 {
        // A NESTED inline-shape field: intern the nested shape (its `|null`
        // wrapper stripped) and store a struct ref on it under the CANONICAL
        // registered name. An earlier literal may have interned the identical
        // shape as a synthetic `#anonN` (`anonFieldElemName` records that
        // resolved name), so keying this field by the raw inline spelling
        // (`{a:i32}`) both blocks the `annShapeIndexOf` dedup — minting a
        // duplicate struct — and leaves the element `structIndexByName`-
        // UNRESOLVABLE at type-section emit (a -1 `sHeapIdx` read). Store the
        // interned struct's own `sNames` entry so both agree with the literal path.
        const base = nonNulBaseOf(ftxt)
        const iidx = internInlineShape(base)
        if iidx >= 0 {
          fc = 15
          ftxt = sNames[iidx]
        }
      }
      if fc < 0 { ok = false }
      names.push(rawNames[fi])
      codes.push(fc)
      texts.push(ftxt)
    }
    fi = fi + 1
  }
  if !ok || names.length == 0 { return -1 }
  const existing = annShapeIndexOf(names, codes, texts)
  if existing >= 0 { return existing }
  sDeclared = true
  // Interned under the ANNOTATION TEXT itself (`{v:i32}`) — a real key, so
  // `structIndexByName` on the annotation (or on a ref-list element name
  // `{v:i32}[]` → `{v:i32}`) resolves directly.
  sNames.push(nm)
  recordSTyIx(sTyIxOfNameTy(nm, tyIx)) // D0
  sFieldStart.push(sFieldNames.length)
  sFieldCount.push(codes.length)
  let pi = 0
  while pi < codes.length {
    sFieldNames.push(names[pi])
    sFieldTypes.push(codes[pi])
    forceScalarListField(codes[pi])
    // B6b: the ROW'S KEY COLUMN, read off the field's OWN spelling and asked ONCE for
    // every code — the question the other FOUR row recorders (`pushFieldRow`'s three
    // callers and `internShapeAs`) each ask uniformly, and which this one asked in its
    // else-arm only. Its codes 5 and 28 hard-coded `false` under the claim that "a
    // ref-list field has no map key", which is untrue of a ref-list field whose ELEMENT
    // is a map (`{m: {[i32]: V}[]}`) — a column written `false` where the spelling says
    // i32 is the silent wrong answer this column exists to prevent, and only the fact
    // that no consumer reads it outside codes 19/29 kept it from being one.
    // `nameIsI32KeyedMap`'s key cut needs only the `{[K]:` prefix, so it answers for the
    // list and `| null` widths of a map spelling as readily as for a whole span, and it
    // is false for every non-map spelling — inert on every other code.
    const fkI32 = nameIsI32KeyedMap(texts[pi])
    if codes[pi] == 5 {
      // A REF-LIST field (`f: N[]` / `f: (i32|null)[]`): record its element name (the CANONICAL ref-array
      // element name — parens stripped for a value-union element so it keys the same slot every other
      // union position uses), so `sFieldRefSlot` (`rlSlotByName`) finds the element's interned slot.
      // Without this an inline-shape ref-list field stored "" and the read failed to resolve the element.
      // A value-union element additionally interns its box reps here (the code-16 field parity).
      let e5 = refArrElemName(texts[pi])
      // A ref-list element that is itself an INLINE SHAPE (`{g:i32}[]`) is invisible to `refArrElemName`
      // until the shape is interned, so it returns "". The shape was pre-interned by
      // `collectNestedFieldShapes` (interning mid-field-loop would corrupt the flat `sField*` arrays), so
      // here just key it by its stripped text. A nominal / union / scalar element keeps `refArrElemName`.
      if e5 == "" {
        // The trailing-`[]` CUT at its home (`tyname.arrElemNameRaw`, W5). **THE #1239
        // CENSUS SCORED THIS FILE AT TWO HAND-WRITTEN COPIES OF THIS HOME AND THERE ARE
        // FOUR** — this one and the code-28 arm below are the two it missed, and the miss
        // is explainable rather than random: its establishment fixpoint roots at a
        // VARIABLE, and this receiver is an array-element read (`texts[pi]`) while the
        // other is bound from `nullablePartOf`, a cut that is not in the seed rule's home
        // list. Same guard argument as the `gaeEnsure` site: `codes[pi] == 5` implies
        // `nameFieldCode(texts[pi]) == 5` (the code and the text are pushed in the same
        // iteration, and the only reassignment of either is the `fc < 0` → 15 arm above),
        // and `fieldCodeOfSpelling`'s single `return 5` is inside `if nameIsArray(t)`.
        const raw5 = arrElemNameRaw(texts[pi])
        if structIndexByName(raw5) >= 0 { e5 = raw5 }
        // A GROUPING-PAREN element spelling (`f: ({g: i32})[]` — the parens carry no
        // meaning; the source is free to write them). `refArrElemName` keys the
        // paren-FREE spelling, so peel the grouping pair and key the same slot the
        // `{g: i32}[]` spelling does — otherwise the field recorded "" and the type
        // section failed the loud "ref-list field element type is not interned"
        // (or, with a same-fieldset twin in scope, the un-interned closure-result
        // struct fieldset-collided onto its own element row — INVALID-WASM).
        if e5 == "" {
          const uw5 = normTypeAtom(raw5)
          if uw5.length != raw5.length {
            if structIndexByName(uw5) >= 0 { e5 = uw5 }
          }
        }
      }
      sFieldElemName.push(e5)
      recordSFieldElemRow(e5, fkI32) // D5 + B6b
      if isValueUnionName(e5) { registerValueUnionName(e5) }
    } else if codes[pi] == 28 {
      // A NULLABLE ref-list field (`f: S[] | null`): its element name is the ref-array element of the
      // non-null part; the element shape/union was pre-interned in the parse loop (`internShapeDeep`).
      let e28 = refArrElemName(nullablePartOf(texts[pi]))
      if e28 == "" {
        // The same CUT home (`tyname.arrElemNameRaw`, W5), and the same discharge as the
        // `unionListElemMapFieldMember` site: `codes[pi] == 28` is reachable only through
        // `fieldCodeOfSpelling`'s single `return 28`, `if nameIsNulRefList(t)`, which IS
        // `nameIsRefArray(nullablePartOf(t))` — the very value bound below — and
        // `nameIsRefArray` implies `nameIsArray`. So the `raw28.length > 2` conjunct is
        // implied and the guarded `if` collapses.
        //
        // THIS SITE'S FALL-THROUGH IS THE ONE THAT WOULD HAVE DIVERGED had the guard not
        // been dischargeable: where the `[]` cut declines, master left `raw28` at its FULL
        // value and looked THAT up in `structIndexByName`, whereas the home answers "".
        // Recorded because the discharge is what makes the routing legal here, not the
        // shape of the expression.
        const raw28 = arrElemNameRaw(nullablePartOf(texts[pi]))
        if structIndexByName(raw28) >= 0 { e28 = raw28 }
      }
      sFieldElemName.push(e28)
      recordSFieldElemRow(e28, fkI32) // D5 + B6b
      if isValueUnionName(e28) { registerValueUnionName(e28) }
    } else {
      // EVERY OTHER CODE is recorded IDENTICALLY from the field's spelling, so the
      // shape-text table answers (D-ELEMHOME — the same collapse D-FIELDCODE made of
      // the two field-CODE ladders, one layer down): code 16 the union name, 15 the
      // `| null`-stripped nested-struct target, 19 / 29 the map's VALUE name, 0 / 4 the
      // litunion atom / atom-ARRAY name, 30 the `K | null` niche's union — and "" for
      // anything else, including a PLAIN code 0 / 4. Only codes 5 and 28 above stay
      // local: this recorder resolves an element through the ALREADY-INTERNED tables
      // (`structIndexByName`, plus the grouping-paren peel) where the shape-text one
      // records a DEFERRED `[]`-slice for `collectA`'s variant field pass to intern.
      const en = shapeFieldElemName(texts[pi], codes[pi])
      sFieldElemName.push(en)
      recordSFieldElemRow(en, fkI32) // D5 + B6b
      // The union FIELD's name keys its atom set; registering it interns the shared
      // box + the value-box reps it needs (this runs after `collectU`, but before any
      // type-index math).
      if codes[pi] == 16 { registerValueUnionName(en) }
    }
    pi = pi + 1
  }
  sNames.length - 1
}

// Intern the inline shape name `nm` (`{a:i32,b:i32}`) as the NAMED struct
// `key` — the same field parsing as `collectAnnShapes`, but keyed under the
// alias name so `structIndexByName(key)` resolves params/locals/literals.
export function internShapeAs(key: string, nm: string) {
  const rawNames: string[] = []
  const rawTexts: string[] = []
  shapeInnerFieldSplit(groupInnerOf(nm), rawNames, rawTexts)
  const names: string[] = []
  const codes: i32[] = []
  let fi = 0
  while fi < rawNames.length {
    if rawNames[fi] == "" {
      return emitFail("emitProgram: malformed struct field")
    }
    const fc = nameFieldCode(rawTexts[fi])
    if fc < 0 {
      return emitFail(
        "emitProgram: only i32 / boolean / string / array struct fields are supported",
      )
    }
    names.push(rawNames[fi])
    codes.push(fc)
    fi = fi + 1
  }
  if names.length == 0 {
    return emitFail("emitProgram: empty struct alias shape")
  }
  sDeclared = true
  sNames.push(key)
  recordSTyIx(sTyIxOfName(key)) // D0
  sFieldStart.push(sFieldNames.length)
  sFieldCount.push(codes.length)
  let pi = 0
  while pi < codes.length {
    sFieldNames.push(names[pi])
    sFieldTypes.push(codes[pi])
    sFieldElemName.push("")
    // This recorder banks NO element name for any code (its rows carry "" — the alias
    // shape's fields are re-derived elsewhere), but the KEY half is free and is read
    // straight off the field's own spelling, so a mono i32-keyed map field here names
    // its own map struct instead of the string-keyed twin's.
    recordSFieldElemRow("", nameIsI32KeyedMap(rawTexts[pi])) // D5
    pi = pi + 1
  }
  0
}

// The struct table index whose field-name SET matches `names` exactly, or -1.
function annShapeIndexOf(names: string[], codes: i32[], texts: string[]) {
  let si = 0
  const sLimC = sScanLim()
  while si < sLimC {
    if sFieldCount[si] == names.length {
      let allIn = true
      let i = 0
      while i < names.length {
        const fi = sFieldIndex(si, names[i])
        if fi < 0 {
          allIn = false
        } else if sFieldTypeAt(si, fi) != codes[i] {
          // The same field-NAME set with a DIFFERENT field type (`{y:i32}` vs
          // `{y:string|i32}`) is a DISTINCT shape — intern it separately so each
          // annotation resolves its own struct (host: structural interning).
          allIn = false
        } else {
          // Same field name AND code, but a REF field (nested struct / union / …) with a DIFFERENT
          // ELEMENT type is STILL a distinct shape. Without this, `{f:{f:i32}}` and `{f:{f:{f:i32}}}`
          // — both field `f`, code 15 — wrongly dedup (the recursion produces identical name+code at
          // every level when field names repeat). Compare the stored element name to this field's
          // element text (code 15 strips the `|null` wrapper exactly as the interner stores it).
          const en = sFieldElemNameAt(si, fi)
          if en != "" {
            let bi = texts[i]
            if codes[i] == 15 { bi = nonNulBaseOf(bi) }
            if en != bi { allIn = false }
          } else if codes[i] == 0 && nameIsLitUnionType(texts[i]) {
            // ATOM-IDENTITY split (code 0 is layout-shared): a litunion-ATOM field
            // (`{f: K0}` — interned member ids, `sFieldIsLitUnion` keys off the
            // recorded union name) must NOT dedup onto a PLAIN i32/boolean row
            // (`{f: boolean}`, elem "") — layout-equal but ENCODING-different: the
            // shared row served both, and the atom side's member literal emitted as
            // a STRING ref into the i32 slot (INVALID-WASM; the r9
            // declared-composite twin family, seed 358472050 d5 bmd).
            allIn = false
          } else if codes[i] == 4 && nameIsLitUnionArray(texts[i]) {
            // The atom-ARRAY sibling (`{f: K0[]}` vs `{f: i32[]}`/`{f: boolean[]}`):
            // same shared-layout split — the atom-element context is per-row
            // (`sFieldIsLitUnionArray`), so the rows must stay distinct.
            allIn = false
          }
        }
        i = i + 1
      }
      if allIn { return si }
    }
    si = si + 1
  }
  -1
}

// The registry slot of generic-alias base `name`, or -1.
function gaeIndexOf(name: string) {
  let i = 0
  while i < gaeBases.length {
    if gaeBases[i] == name { return i }
    i = i + 1
  }
  -1
}

// Intern the application `name` ("Box<i32>") as a struct shape, once. A field
// the emitter cannot type (an unbound param, an unsupported shape) leaves the
// application un-interned — its use then fails loudly downstream, never a trap.
export function gaeEnsure(name: string) {
  // The GENERIC-APPLICATION SPAN test at its home (`emit_base.annGenAppSpanEnds`), whose
  // own header names this function as the third caller it wants: the home IS the `length <
  // 3` cheap reject, the trailing-`>` compare and the `gaeLtAt(name) > 0` scan, in that
  // order, so the routing keeps the character compare in FRONT of the scan exactly as this
  // site had it. `gaeLtAt` is re-asked below for the head/argument slices rather than
  // threaded out — the same trade `annGenAppSpanEnds`' own caller
  // `emit_base.annGenAppDecompose` takes, and it costs a second scan only on a name that
  // already ended in `>`. Decomposing through `annGenAppDecompose` instead would split the
  // argument list BEFORE the `structIndexByName` early-out below, which is work this
  // per-field-per-application call does not do today — and the two CUTS route to
  // `tyname.gaeHeadNameOf` / `gaeArgsTextOf` (W2) instead, which is exactly the part of
  // `annGenAppDecompose` this site can take without taking its split.
  if !annGenAppSpanEnds(name) { return 0 }
  const ltAt = gaeLtAt(name)
  if structIndexByName(name) >= 0 { return 0 }
  const gi = gaeIndexOf(gaeHeadNameOf(name, ltAt))
  if gi < 0 { return 0 }
  const pnames: string[] = []
  gaeSplitArgs(gaeParams[gi], pnames)
  const args: string[] = []
  gaeSplitArgs(gaeArgsTextOf(name, ltAt), args)
  if args.length != pnames.length { return 0 }
  const names: string[] = []
  const codes: i32[] = []
  const elems: string[] = []
  // B6b: the field ROW's KEY column, banked per field beside its element name — an
  // APPLIED field spelling (`{[i32]: T}` at `T = i32`) is the only place the key is
  // legible, and the push loop below no longer has the spelling.
  const ekeys: i32[] = []
  let ok = true
  const fs = gaeFieldStart[gi]
  const fc = gaeFieldCount[gi]
  let fi = 0
  while fi < fc {
    const tn = gaeApplyFieldTy(gaeFieldTyNames[fs + fi], pnames, args)
    // A field that is ITSELF an application (or an array of one) interns
    // depth-first, so the ref/elem lookups below resolve.
    gaeEnsure(arrLeafNameOf(tn))
    let code = nameFieldCode(tn)
    let elem = ""
    if code < 0 {
      // An interned application name is a struct-ref field (`nameFieldCode`
      // only consults TypeDecl names, which an application is not).
      if structIndexByName(tn) >= 0 {
        code = 15
        elem = tn
      }
    } else if code == 5 {
      // The APPLIED element text, RAW: an instance field's list element is spelled
      // by `gaeApplyFieldTy`'s substitution (`Box<i32>[]` → element `Box<i32>`), a
      // name the canonicalizing recorder (`refArrElemName`) does not key. The one arm
      // this path does not share with the shape-text table.
      //
      // The trailing-`[]` CUT at its home (`tyname.arrElemNameRaw`, W5) — this line was
      // the home's body, hand-written, in a file that already imports it. The home GUARDS
      // on `nameIsArray` and answers "" where this spelling sliced blind, and that guard
      // is DISCHARGED rather than assumed: `code == 5` is reachable only through
      // `nameFieldCode` → `fieldCodeOfSpelling`, whose single `return 5` sits inside
      // `if nameIsArray(t) { … }` (the scalar-element kinds 4/6/25/26/27 take the arm's
      // other exits). So `nameIsArray(tn)` HOLDS at this line and the two forms compute
      // the identical slice — a routing, not a widening.
      elem = arrElemNameRaw(tn)
    } else if code >= 0 {
      // Codes 15 / 16 / 4 are recorded IDENTICALLY from the field's spelling, so the
      // shape-text table answers (D-ELEMHOME): the `| null`-stripped nested target,
      // the union name, and the atom-ARRAY name (so `sFieldIsLitUnionArray` covers
      // monomorphized shapes). The arm list is EXACTLY master's — this path records
      // "" for the map (19/29), litunion-atom (0), nullable-ref-list (28) and
      // `K | null` (30) codes where the shape-text table records a key. That
      // difference is NOT merged here; it is a measured, filed divergence.
      elem = shapeFieldElemName(tn, code)
      if code == 16 { registerValueUnionName(elem) }
    }
    if code < 0 { ok = false }
    names.push(gaeFieldNames[fs + fi])
    codes.push(code)
    elems.push(elem)
    let ek = 0
    if nameIsI32KeyedMap(tn) { ek = 1 }
    ekeys.push(ek)
    fi = fi + 1
  }
  if !ok { return 0 }
  if names.length == 0 { return 0 }
  sDeclared = true
  sNames.push(name)
  recordSTyIx(sTyIxOfName(name)) // D0
  sFieldStart.push(sFieldNames.length)
  sFieldCount.push(codes.length)
  let pi = 0
  while pi < codes.length {
    sFieldNames.push(names[pi])
    sFieldTypes.push(codes[pi])
    sFieldElemName.push(elems[pi])
    recordSFieldElemRow(elems[pi], ekeys[pi] == 1) // D5
    pi = pi + 1
  }
  0
}

// ── literal-union ATOMS (`type K = "a" | "b"`) ────────────────────────────────
// A literal-union value is an INTERNED i32 id: each distinct member STRING (interned lazily by its raw
// `StrLit` text) gets one id. The literal members come from the CHECKER (which preserves them); the
// emit-side `udVariants` are widened to `"string"` and must NOT be used. Slice 1: scalar atoms + `==`.
let litAtomId: {[string]: i32} = Map()

let litAtomNext: i32 = 0

// Seeded around a literal-union BOUNDARY (binding init / `==` operand) so a member `StrLit` lowers as its
// interned i32 id instead of a string. The atom analogue of `pendingNulString`.
export let pendingLitUnion: i32 = 0

// Whether the module uses ANY literal-union type (named or inline). Set ONCE per program by a single
// `P.nodes` scan; every per-node litunion detector (`exprIsLitAtom`, the `*WidensAtomToStr` predicates)
// early-outs on it, so a program with no literal unions — e.g. the self-hosted compiler — pays none of
// the per-node atom-detection cost during the str-op scan / classification.
let gLitUnionUsed: i32 = 0

export function resetLitAtoms() {
  litAtomId = Map()
  litAtomNext = 0
  gLitUnionUsed = 0
  if anyLitUnionUsed() { gLitUnionUsed = 1 }
  // `startStmts` (read by `startBlockLetOf` below) is filled by `collectFns` — the
  // FOURTH emit pass — so on a compiler instance that EMITS several programs (the
  // corpus oracle drives one `WebAssembly.Instance` over the whole tree; `vl check
  // <dir>` shares an instance too but stops at the checker, so it never gets here)
  // the three collect passes ahead of it still observe program N-1's node indices.
  // `collectA` does, measured: 113 out-of-range reads over the corpus, and
  // dereferencing one into program N's re-minted arena TRAPS ("array element access
  // out of bounds" — 11 corpus files, i.e. 11 `deno task test` failures).
  // Emptied HERE — this reset is emit_classify's per-program hook and runs ahead of
  // every pass — so a query issued before `collectFns` reads an EMPTY table and
  // declines, exactly as it already does on a fresh instance. Same reasoning, and the
  // same window, as `emitProgram`'s own `mvValTyIx` / `rlElemTyIx` / `unMemTys`
  // clears; that prologue is the natural home for this line once `emit_sections.vl`
  // is free to edit.
  startStmts = []
  sidResetStartBlockLet()
  0
}

// Drop this file's SID-KEYED rows — the `startBlockLetOf` memo. Paired with
// `symbols.sidReset` by the driver (through `emit_sections.sidKeyedTablesReset`);
// see that function's header for why a generation stamp is not enough on its own.
export function sidResetStartBlockLet() {
  sblVal = []
  sblGen = []
  sblEpoch = sblEpoch + 1
  0
}

export function internAtom(text: string) {
  if litAtomId.has(text) {
    const got = litAtomId[text] ?? 0
    return got
  }
  const id = litAtomNext
  litAtomId[text] = id
  litAtomNext = id + 1
  id
}

// True if the binding/global at `letIx` is annotated with a literal-union type (an i32-backed atom).
export function letIsLitUnion(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const r = nodeTyIsLitUnionAlias(d.letType)
      return r
    }
  }
  false
}

// True if the binding at `letIx` is UN-annotated and its initializer is a literal-union ATOM —
// e.g. `const sk = xs[i]` over a `K[]`, or `const k2 = k` off an atom local. Such a local holds
// an i32 atom id, so it must be the i32 atom slot (kind 0 + `localLitUnion`), NOT the `string`
// ref slot its checker type (a `string` subtype) would otherwise pick — which stores the i32
// atom into a `(ref $array)` cell (invalid wasm). The init-side dual of `letIsLitUnion`.
export function letInitIsLitAtom(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType < 0 && d.letInit >= 0 { return exprIsLitAtom(d.letInit, fnIx) }
  }
  false
}

// True when the BINDING at `bindIx` — a `Param` or a `LetDecl` — holds an interned i32 ATOM
// rather than a member STRING. This is the ONE question every channel of `exprIsLitAtom` asks
// about a name's DECLARATION SITE, and it is the same question `vtKindOfType` answers with
// "i32" when it sizes that binding's SLOT (`nodeTyIsLitUnionAlias` on the annotation) and that
// `collectLocals` answers when it sets `localLitUnion` from an un-annotated initializer.
// `ownerFnIx` is the ARENA index of the frame the binding lives in (-1 at module scope): the
// un-annotated arm classifies the INITIALIZER, which resolves only in its own frame.
export function bindingIsLitAtom(bindIx: i32, ownerFnIx: i32) {
  if bindIx < 0 { return false }
  const bn = P.nodes[bindIx]
  if bn is Param { return nodeTyIsLitUnionAlias(bn.parType) }
  if bn is LetDecl {
    return letIsLitUnion(bindIx) || letInitIsLitAtom(bindIx, ownerFnIx)
  }
  false
}

// The `K | null` NICHE dual of `bindingIsLitAtom`: the binding holds the same i32 atom with
// the spare `-1` encoding null (no box).
function bindingIsNulLitUnion(bindIx: i32, ownerFnIx: i32) {
  if bindIx < 0 { return false }
  const bn = P.nodes[bindIx]
  if bn is Param { return nodeTyIsNulLitUnion(bn.parType) }
  if bn is LetDecl { return letNulLitUnion(bindIx, ownerFnIx) }
  false
}

// True when `name` is a CAPTURED variable of the capturing lifted function `fnIx` whose
// enclosing-frame binding holds an i32 atom. The CAPTURE channel of `exprIsLitAtom`, which
// otherwise resolves an identifier through the reader's own declared locals, its own params
// and the module globals — none of which a capture is. Missing it, a captured atom read as a
// STRING: `strReppedLitUnionAt` claimed it and `emitStrToAtom` handed the env field's i32 to
// `__str_eq__`, while `print` skipped the atom→member widen and printed the RAW ID.
function capturedIsLitAtom(fnIx: i32, name: string) {
  bindingIsLitAtom(
    capturedBindingOf(fnIx, name),
    capturedBindingFrameOf(fnIx, name),
  )
}

// The niche dual of `capturedIsLitAtom` — `exprNulLitUnion`'s capture channel. A `K | null`
// capture rides the same i32 env field (`vtKindOfType` answers "i32" for both spellings), so
// both classifiers need the channel or the two spellings disagree about one field.
function capturedIsNulLitUnion(fnIx: i32, name: string) {
  bindingIsNulLitUnion(
    capturedBindingOf(fnIx, name),
    capturedBindingFrameOf(fnIx, name),
  )
}

// True if `exprIx` is a literal-union ATOM VALUE (an i32 id) — a litunion-flagged local or a litunion-
// annotated param. Distinguishes a real atom from a checker-inferred literal union (which is a string).
export function exprIsLitAtom(exprIx: i32, fnIx: i32) {
  if gLitUnionUsed == 0 { return false }
  // A `K | null` NICHE binding/call (param / local / global / `K|null`-returning call) holds an i32
  // atom id (or the `-1` null sentinel). In any position that consumes it AS an atom — a `print`
  // widen, a litunion-param arg, a member compare — the checker has narrowed it non-null, so it is a
  // valid atom. The narrowed member texts come from the node's narrowed type (`nodeLitUnionMemberTexts`).
  if exprNulLitUnion(exprIx, fnIx) { return true }
  // `p ?? d` over the `K | null` niche is an ATOM in BOTH halves — the line above already
  // claims the nullable one, and a NON-null default coalesces the sentinel away to leave the
  // plain atom id. The half is irrelevant here, so this asks only whether the rep survives
  // (`coalesceLitUnionFits`, the emit arm's own claim). Without it an inferred
  // `const v = p ?? "a"` bound a bare i32 and every atom consumer (the `print` widen, a
  // litunion arg, a member compare) saw a NUMBER: `vl check` rc 0, `0` printed for `"a"`.
  if coalesceLitUnionFits(exprIx, fnIx) { return true }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Ident {
    // A CAPTURED variable, resolved against the enclosing frame's binding — the same node
    // `captureValKind` sizes the env field from, checked FIRST for the reason
    // `emitIdentNode` checks `emitCapturedRead` first: a capture shadows nothing (it is by
    // construction neither a local nor a param of the reader, nor a global).
    if capturedIsLitAtom(fnIx, e.identName) { return true }
    const slot = declaredSlotOf(e.identName)
    if slot >= 0 && slot < localLitUnion.length {
      if localLitUnion[slot] == 1 { return true }
    }
    const pt = paramTypeNode(fnIx, e.identName)
    if pt >= 0 {
      const r = nodeTyIsLitUnionAlias(pt)
      return r
    }
    const gli = globalLetOf(e.identName)
    if gli >= 0 {
      // An annotated `: K` global OR an UN-annotated global whose init is an atom
      // (`const r = pick(ks)` / `const r = ks[0]`) — the global dual of the
      // `localLitUnion` init classification `collectLocals` applies, through the same
      // declaration-site answer the capture channel above asks for.
      return bindingIsLitAtom(gli, -1)
    }
  }
  if e is Index {
    // `xs[i]` over a literal-union ARRAY yields an atom element (the array's i32 backing holds ids).
    const r = nodeArrayElemIsLitUnion(e.idxArr)
    if r { return true }
    // `m[k]` over a LITUNION-valued map (`{[string]: K0}`) yields the atom id — the
    // atom map rides the MONO mv slot, whose i32 backing stores interned member ids
    // (no per-slot value name to consult, so this is the TYPED-IR net: the checker
    // recorded the read's type as the pure litunion). Without the claim a compare
    // `m[k] == "bbpt"` fell to the STRING-equality path (the member literal reads
    // stringy), which called strEq with the raw i32 atom — INVALID-WASM (the r4
    // residual of the nullable-nested-map family: `const m = t1[k] ?? h2` then
    // `m[k] == "bbpt"`; also the bare direct-receiver spelling). The map dual of
    // the array-element claim above.
    if nodeTyIsPureLitUnion(unwrapParen(exprIx)) { return true }
    // The BARE read types `K0 | null` (a missing key reads null) — the emit is the
    // i32 atom either way (the not-found arm yields a non-member sentinel), so the
    // nullable spelling claims too.
    if nodeTyIsNulLitUnion(unwrapParen(exprIx)) { return true }
    return false
  }
  if e is IfStmt {
    // A VALUE if-expression joining two ATOMS (`if c then k else k2`) yields an atom —
    // the join rep is the bare i32 id, so the binding/print classifiers must see through
    // it. Both arms must be atoms; a mixed atom/string join types `string` (its atom arm
    // widens at the string-join seam), so it deliberately does NOT classify here.
    if e.ifElse < 0 { return false }
    const tv = ifArmValueExpr(e.ifThen)
    if tv >= 0 {
      if exprIsLitAtom(tv, fnIx) {
        const eb = P.nodes[e.ifElse]
        // An `else if` chain recurses on the nested IfStmt directly.
        if eb is IfStmt { return exprIsLitAtom(e.ifElse, fnIx) }
        if eb is Block {
          const ev = ifArmValueExpr(e.ifElse)
          if ev >= 0 { return exprIsLitAtom(ev, fnIx) }
        }
      }
    }
    return false
  }
  if e is Member {
    // `t0.f` reading a literal-union atom FIELD through a NARROWED union receiver
    // (`t0 is {f: K0} { print(t0.f) }`) or a variant-typed receiver yields the atom —
    // the variant-table twin of the struct-receiver case below (the `memFieldTypeCode`
    // dispatch order). Without it the read printed the raw atom id.
    const mIxA = unwrapParen(exprIx)
    let mviA = -1
    if memIsNarrowed(mIxA) {
      mviA = memNarrowVariantIndex(mIxA)
    } else {
      mviA = exprVariantIndex(e.memObj, fnIx)
    }
    if mviA >= 0 {
      const mvfiA = variantFieldIndex(mviA, e.memProp)
      if mvfiA >= 0 && variantFieldTypeAt(mviA, mvfiA) == 0 {
        const rv = variantFieldIsLitUnion(mviA, mvfiA)
        return rv
      }
    }
    // `b.kind` reading a literal-union atom FIELD yields the atom.
    const msi = structIndexOfExpr(e.memObj, fnIx)
    if msi >= 0 {
      const mfi = sFieldIndex(msi, e.memProp)
      if mfi >= 0 {
        const r = sFieldIsLitUnion(msi, mfi)
        return r
      }
    }
  }
  if e is Call {
    // ANY call whose CHECKED result type is an aliased litunion holds an i32 atom (its functype
    // result reps i32, the rep #843 established) — widen at print. Covers a closure VALUE call
    // (`v(0)`), a struct-field closure call (`s.f.f(0)`), and an indexed-closure call, none of
    // which the callee-Ident named arm below can reach. A NAMED call to an INLINE-litunion-returning
    // function reps as a string ref, so `nodeTyIsLitUnionAlias` (alias-only) correctly excludes it.
    if nodeTyIsLitUnionAlias(unwrapParen(exprIx)) { return true }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const target = fnIndexOfSid(sidOfNode(e.callFn))
      if target >= 0 {
        const cf = P.nodes[fnStmts[target]]
        if cf is FuncDecl {
          if cf.fnRet >= 0 {
            const r = nodeTyIsLitUnionAlias(cf.fnRet)
            return r
          }
        }
      }
    }
  }
  if e is BinExpr {
    // `m[k] ?? d` over an ATOM-valued map yields the atom — the mono vals list holds
    // ids, so the fused get's result is a real i32 atom (like an atom array element).
    // The METHOD spelling `m.get(k) ?? d` is the SAME fused get (`emitCoalesce` routes
    // both to `emitMapGetOr`), so the receiver comes from the ONE fused-read shape home
    // rather than an `is Index` half-set — without the `.get` half this classifier
    // declined, `print` skipped the atom→member widen, and the read printed its RAW ATOM
    // ID (`0` where `aa` is expected): a silent wrong answer, on both key reps.
    if e.binOp == "??" {
      const blRecv = fusedMapReadRecvIx(unwrapParen(e.binLeft))
      if blRecv >= 0 { return nodeTyMapValIsLitUnion(blRecv) }
    }
  }
  false
}

// The ref-list element KEY of an array spelling, with the DEFERRED fallback the
// shape-text field recorder needs — the ONE home of the four-line ladder its code-5 and
// code-28 arms each wrote out:
//
//     const e = refArrElemName(x)
//     if e != "" { return e }
//     if nameIsArray(x) { return x.slice(0, x.length - 2) }
//     return ""
//
// A NAMED-struct/union or inline-shape element (`S[]`, `{f: f64}[]`) is invisible to
// `refArrElemName` while the struct/union tables are still empty (`collectU` registers
// shape-text variants BEFORE `collectS`/`collectAnnShapes` run). The stripped element
// text IS the canonical slot key for exactly those spellings — the table-INDEPENDENT
// element sorts (paren-union / closure / map / scalar-2D) have already been answered by
// `refArrElemName` above — so it is recorded DEFERRED and `collectA`'s variant field
// pass interns it (`ensureRefElem`) once the tables exist.
//
// NB a THIRD copy of this grammar (`unionListElemMapFieldMember`) gates the fallback on
// `a.length > 2` rather than `nameIsArray(a)`. It is NOT folded in here: the two guards
// agree only because that copy already sits inside a `nameIsRefArray(a)` arm, and
// unifying them would be a behaviour change wearing a dedup's clothes.
function refArrElemKeyDeferred(name: string) {
  const e = refArrElemName(name)
  if e != "" { return e }
  // This IS `arrElemNameRaw` character-for-character (guard, cut, `""` otherwise) — it
  // predates the home and is now the home's call.
  arrElemNameRaw(name)
}

// The ELEMENT/TARGET name a shape-text field records in `uFieldElemName`: a
// ref-list field its element name, a nested-struct field its (non-null) target
// name, a value-union field its atom-set name; "" otherwise.
export function shapeFieldElemName(ftxt: string, code: i32) {
  if code == 5 { return refArrElemKeyDeferred(ftxt) }
  if code == 15 { return nonNulBaseOf(ftxt) }
  if code == 16 { return ftxt }
  // A NULLABLE REF-LIST field (code 28, `S[] | null`): the ref-array element of the
  // non-null part — the shape-text mirror of `fieldRefElemName`'s code-28 arm, with
  // the same deferred-intern fallback the code-5 arm uses for a not-yet-registered
  // struct/union element (`collectA`'s variant field pass interns it once tables exist).
  if code == 28 { return refArrElemKeyDeferred(nullablePartOf(ftxt)) }
  // A MAP-typed field (code 19) records its VALUE type-name — the mv-slot key, the
  // shape-text mirror of `fieldRefElemName`'s code-19 arm. Without it a shape-text
  // union VARIANT with a map field (`{f: {[string]: i32}} | i32`) recorded "" and
  // every op site then failed the loud slot find (the R1 map-in-union-arm seam).
  if code == 19 { return mapValNameOf(ftxt) }
  // A NULLABLE map field (code 29): the `| null`-stripped map's value name — same key.
  if code == 29 { return mapValNameOf(nulMapInnerName(ftxt)) }
  // A literal-union ATOM field (code 0 named `K`) / ATOM-ARRAY field (code 4 named `K[]`)
  // records its union (array) name, so the variant tables recover the atom rep + membership
  // exactly as `sFieldElemName` does (`internInlineShape` / `collectS` parity) — without it a
  // union-arm struct field `{f: K0} | i64` stored "" and construction emitted the raw member
  // string ref into the i32 atom slot.
  if code == 0 && nameIsLitUnionType(ftxt) { return ftxt }
  if code == 4 && nameIsLitUnionArray(ftxt) { return ftxt }
  if code == 4 { return "" }
  // A NULLABLE-litunion niche field (code 30): the non-null union name, the
  // code-0 recording over the `| null`-stripped part.
  if code == 30 { return nulLitUnionInnerName(ftxt) }
  ""
}

// The wasm-type code (`0` i32, `3` string) of variant `vi`'s field at field index `fi`.
export function variantFieldTypeAt(vi: i32, fi: i32) {
  uFieldTypes[uFieldStart[vi] + fi]
}

// The ref-list table SLOT of variant `vi`'s ref-list field `fi`, or -1 if not a ref list.
export function variantFieldRefSlot(vi: i32, fi: i32) {
  // D5: the ARENA leg — the field's recorded element type resolves the slot through
  // the rep key the layer is already interned on; the recorded NAME is the
  // fall-through for a row the sidecar does not cover (and for `rlSlotByName`'s
  // struct-twin rung, which has no arena input).
  const ety = uFieldElemTyIxAt(vi, fi)
  const a = rlSlotOfTy(ety)
  if a >= 0 { return a }
  // …and the fall-through's rung 2 reads that SAME index rather than re-resolving the
  // name beside it (destringify D-INLINESHAPETY). KEY-ONLY: the rendered rung below it
  // answers 25 of 584 entries here, so it stays laddered — `sFieldRefSlot`'s stronger
  // `rlSlotByNameTy` claim is not this caller's.
  rlSlotByNameKeyTy(uFieldElemName[uFieldStart[vi] + fi], ety)
}

// The ELEMENT/atom-set NAME recorded for variant `vi`'s field `fi` — a union-box field
// (code 16) records its atom-set name (the key `emitUnionCoerce` boxes against), a
// ref-list its element name, a nested-struct its target. "" for a plain scalar field.
export function variantFieldElemName(vi: i32, fi: i32) {
  uFieldElemName[uFieldStart[vi] + fi]
}

// ── Canonical layout twins, VARIANT slot layer (roadmap repOf, slot layer) ────
// Two union-variant slots share ONE variant-struct WasmGC heap type under the
// struct template's two-layer discipline: the canonical structural key of the
// variant's TYPE (its name — a declared alias or an inline `{…}` shape —
// resolved through the checker, `repNameCanonKey`), then a layout guard over
// the emitted field storage (`variantFieldLayoutEq`): per-field CODE equality
// plus, for the codes whose storage references another interned heap type, twin
// equivalence of the referenced layer — a ref-list field (5) via
// `rlSlotsLayoutTwin`, a nested-struct field (15) via `repStructSlotsTwin`, a
// map field (19) via the canonical map-value representative. Fixed-storage
// codes (scalars, string, the shared union box / closure / scalar-list
// wrappers) need only the code. The SAME variant name declared into two unions
// (`type U = Cat | Dog` / `type V = Cat | Bird` both pushing `Cat`) is the
// degenerate twin (equal keys, equal fields); structural twins (`Cat`/`Kot`, a
// declared name vs its inline `{…}` spelling) dedup the same way.

// The per-field storage layout guard (the `structFieldCodesEq` analogue).
function variantFieldLayoutEq(a: i32, b: i32): i32 {
  if uFieldCount[a] != uFieldCount[b] { return 0 }
  let fi = 0
  while fi < uFieldCount[a] {
    const ca = uFieldTypes[uFieldStart[a] + fi]
    if ca != uFieldTypes[uFieldStart[b] + fi] { return 0 }
    if ca == 5 || ca == 28 {
      // Code 28 (`<ref-array> | null`) stores through the same per-slot wrapper as a
      // plain ref-list field — twin equivalence is the same referenced-layer guard.
      if (
        rlSlotsLayoutTwin(
          variantFieldRefSlot(a, fi),
          variantFieldRefSlot(b, fi),
        ) ==
        0
      ) {
        return 0
      }
    } else if ca == 15 {
      if (
        repStructSlotsTwin(uFieldTgtStructIdx(a, fi), uFieldTgtStructIdx(b, fi)) ==
        0
      ) {
        return 0
      }
    } else if ca == 19 {
      // NO KEY COMPARISON HERE, AND IT IS MEASURED, NOT ASSUMED (B6b). A `{[i32]: V}`
      // field and a `{[string]: V}` field DO store different map structs, and the value
      // comparison below cannot see the difference (both rows record the same VALUE
      // name) — but this guard never runs on such a pair: `buildVariantTwins` only calls
      // it when `repNameCanonKey` already matched, and that key comes off the ARENA,
      // where the two spellings are `TyMap`s with different key types. The witness is
      // `tests/cases/maps/i32-keyed-variant-field.vl`'s `mixedUnion` plus a two-UNION
      // probe (`{f:{[i32]:string}}` in one, `{f:{[string]:string}}` in another, the only
      // shape that reaches this comparison across unions): both run byte-identically with
      // a key comparison added here and with it absent. The `collectU`-time sibling
      // `variantFieldTysEq` is a different story — it is NOT canon-key gated, and its
      // key comparison has a witness (`unions/same-field-names-different-map-keys-reject.vl`).
      // Each side takes its OWN row's D5 cell (D-MVSLOTFIND): a code-19 row records the
      // map's VALUE name in `uFieldElemName`, and `recordUFieldElemRow` banked
      // `fieldElemTyIxOfName` of that exact string beside it, so the two are one row's
      // two columns rather than two provenances.
      const ma = mvSlotOfMapValNameOrMonoKTy(
        uFieldElemName[uFieldStart[a] + fi],
        false,
        uFieldElemTyIxRow(uFieldStart[a] + fi),
      )
      const mb = mvSlotOfMapValNameOrMonoKTy(
        uFieldElemName[uFieldStart[b] + fi],
        false,
        uFieldElemTyIxRow(uFieldStart[b] + fi),
      )
      let mOk = false
      if ma == -1 && mb == -1 { mOk = true }
      if ma >= 0 && mb >= 0 {
        if mvCanonRepOf(ma) == mvCanonRepOf(mb) { mOk = true }
      }
      if !mOk { return 0 }
    }
    fi = fi + 1
  }
  1
}

// Populate `uVarTwin` (parallel to `uVariants`): `uVarTwin[i]` is the smallest
// earlier layout twin, or `i` itself when `i` is the first of its layout. Keys
// are computed ONCE up front (`buildStructTwins` discipline — the compiler's own
// unions carry hundreds of variants, so a per-pair key recomputation is the
// audit's hot-path anti-pattern); a non-participating slot ("" key — an
// unresolvable spelling) is always its own representative. Called from
// `mAssignTypeIndices` before the variant heap indices allocate.
export function buildVariantTwins() {
  const keys: string[] = []
  let i = 0
  while i < uVariants.length {
    keys.push(repNameCanonKey(uVariants[i]))
    i = i + 1
  }
  uVarTwin = []
  i = 0
  while i < uVariants.length {
    let rep = i
    if keys[i] != "" {
      let j = 0
      while j < i {
        if keys[j] == keys[i] && variantFieldLayoutEq(j, i) == 1 {
          rep = j
          j = i // stop at the first (smallest) twin
        }
        j = j + 1
      }
    }
    uVarTwin.push(rep)
    i = i + 1
  }
}

// The structural signature of variant `vi` — its field names joined with `,` (a
// stable per-shape key). Two variants with the same field-name set share a sig (and
// so, under structural typing, are the same variant — `docs/unions.md`); the slice's
// AST-style unions use DISTINCT field-name prefixes per variant, so every sig differs.
export function variantSig(vi: i32) {
  let out = ""
  const start = uFieldStart[vi]
  const cnt = uFieldCount[vi]
  let j = 0
  while j < cnt {
    if j > 0 { out = out + "," }
    out = out + uFieldNames[start + j]
    j = j + 1
  }
  out
}

// The GLOBALLY-stable tag of a value-union atom: every struct variant takes the
// dense ranks `0 .. uVariants.length-1` (`assignTags`), so atom kinds claim the
// fixed slots above them. Stable across every union in the module (mirroring the
// host's interned `tagOf(variantKey)` global table), so a value boxed as
// `string | i32 | boolean` keeps its tag inside the sub-union `string | i32`.
// The kind→tag table itself lives in `emit_rep` (`scalarTagOfKind`), which is where the
// banked member KIND is read; this is the atom-spelled entry point into it, and NOT a
// second copy of the table (#1110's hand-off — a hand-kept duplicate is a silent
// miscompile waiting for one of the two to be edited).
export function scalarTagOf(atom: string) {
  scalarTagOfKind(valueAtomKind(atom))
}

// The globally-stable tag of the REF-ELEMENT-ARRAY arm whose interned reflist slot is `slot`.
// Value-atom tags fill the fixed band `uVariants.length + 0..12` (the `valueAtomKind` codes —
// scalar/string/null/scalar-list/closure), so ref-array arms claim the band ABOVE it. Ref-array
// and MAP arms can coexist in one union (`S[] | {[string]: i32}`) with INDEPENDENT intern-slot
// tables, so the two bands interleave by PARITY to stay collision-free: ref-arrays take the
// offsets `uVariants.length + 13 + 2*slot`, maps the opposite-parity offsets (`mapSlotTag`). A
// distinct element type interns a distinct reflist slot (`rlSlotByName`), so it gets a distinct,
// deterministic tag stable across every sub-union (mirroring `scalarTagOf`). The `+ 13` clears
// the value-atom band.
export function refArrSlotTag(slot: i32) { uVariants.length + 13 + slot * 2 }

// The globally-stable tag of the MAP arm whose interned map value-slot is `slot` (the mono i32 /
// atom map rides slot `-1`, its shared `$mStructIdx`). Maps claim the offsets of the band above
// the value-atom band — `uVariants.length + 16 + 2*slot` — parity-interleaved with the ref-array
// band (`refArrSlotTag`) so a union carrying BOTH a ref-array and a map arm never collides. The
// `slot+1` shift (folded into `16 = 13 + 3`) maps the mono `-1` slot to the first offset (`+14`),
// typed value slots to `+16`, `+18`, … A distinct map VALUE type interns a distinct mv slot
// (`mvShapeOfValName`), so it gets a distinct, deterministic, sub-union-stable tag.
// The slot canonicalizes through `mvCanonRepOf` first: layout-TWIN value spellings
// (`{[string]: A}` boxed, `is {[string]: {v: i32}}` tested) share one map-struct heap
// type (`mAssignTypeIndices`), so they must share ONE tag — keying the tag on the
// nominal slot would make the `is` compare miss its own twin-spelled value.
export function mapSlotTag(slot: i32) {
  let s = slot
  if s >= 0 { s = mvCanonRepOf(s) }
  uVariants.length + 16 + s * 2
}

// The interned VALUE-BOX heap-type index for a scalar atom (`boolean` shares the
// i32 box — same wasm rep), or -1 for `string`/`null` (no inner box: a string ref
// is already an `anyref` subtype; a null payload is `ref.null`), and likewise for the
// five list flavours and the closure atom, which ride the box anyref directly.
// The kind→box table lives in `emit_rep` (`vbHeapIdxOfKind`), beside the banked member
// KIND; this is the atom-spelled entry point into it (#1110's hand-off).
export function vbHeapIdxOfAtom(atom: string) {
  vbHeapIdxOfKind(valueAtomKind(atom))
}

// Register the VALUE union `name` in the per-union table (no variant structs —
// its atoms tag via `scalarTagOf`, its payloads ride the shared value boxes).
// Idempotent; a non-value-union name is a no-op. Callable from any collection
// phase (it reads no statement table) — `collectAnnShapes` registers a union
// FIELD's atom set through it after `collectU` has run.
export function registerValueUnionName(name: string) {
  if isUName(name) { return 0 }
  // A value union with a litunion-ALIAS arm (`K0 | i64`) registers here too: the alias
  // arm rides the box as its member-string atom (tag `string`, the litunion box rep), so
  // the union is value-box-shaped even though `valueAtomKind("K0")` is -1 — without the
  // registration its scalar arms' value boxes are never minted and a boxed return emits
  // a raw scalar into the box anyref (invalid wasm).
  if !isValueUnionName(name) && !nameIsLitUnionArmValueUnion(name) { return 0 }
  uDeclared = true
  unNames.push(name)
  unMemberSet.push(name)
  recordUnMemTys(name) // D-UNION foundation
  unVarStart.push(uVariants.length)
  unVarCount.push(0)
  markValueUnionAtoms(name)
  0
}

// Mark the per-rep value-box usage flags for every scalar atom of the value union
// `name` (registration-time, so `mAssignTypeIndices` interns exactly the used reps).
//
// D-UNION: each member's atom KIND comes from the row's recorded ARENA member type
// (`unMemAtomKind`) instead of a re-parse of its rendered spelling
// (`valueAtomKind(atom)`), and the litunion-alias member likewise (`tyIsLitUnion`,
// not `nameIsLitUnionType`). **The box-tag ABI is order-sensitive** — this function
// mints the value-box reps in ATOM order — so the recorded slice is consumed in
// lock-step behind a length guard (`unionMemberTysOf` is atom-order-aligned by
// construction) and the loop's shape is untouched. An uncovered row keeps the
// legacy name path.
export function markValueUnionAtoms(name: string) {
  const atoms: string[] = []
  const mems: i32[] = []
  const cov = unionSetArmTys(name, atoms, mems)
  let i = 0
  while i < atoms.length {
    let k = -1
    if cov { k = unMemAtomKind(mems[i]) } else { k = valueAtomKind(atoms[i]) }
    if k == 0 || k == 1 { vbI32Used = true }
    // A STRING member rides the box's anyref `value` as the raw string-array ref (`$aTypeIdx`),
    // so force that array type even when the module CONSTRUCTS no string (`string | i32 = 42`):
    // the narrowed string read's `ref.cast $aTypeIdx` is emitted (dead in the i32 branch, but it
    // must still VALIDATE) and without the type allocated the cast pointed at a bogus heap index.
    if k == 2 { aUsed = true }
    if k == 3 { vbI64Used = true }
    if k == 4 { vbF64Used = true }
    if k == 5 { vbF32Used = true }
    // A LIST member (codes 7..10, 12) forces its list type so the wrapper heap the box
    // payload rides exists — the union annotation alone may be the only mention of that
    // list type.
    if k == 7 {
      lUsed = true
      aUsed = true
    }
    if k == 8 { fa64Used = true }
    if k == 9 {
      slUsed = true
      aUsed = true
    }
    if k == 10 { ia64Used = true }
    if k == 12 { fa32Used = true }
    // A CLOSURE member (code 11) rides the box anyref as the `$cloStructIdx` fat-pointer —
    // force the closure rec-group types so that heap type exists (the union annotation may be
    // the only mention of a function value in the program), the string/list analogue above.
    if k == 11 { fnValUsed = true }
    // A litunion-ALIAS member (`K0` in `K0 | i64`) rides the box anyref as its member-STRING
    // ref (the litunion box rep), so force the string array type exactly like a `string`
    // member — the narrowed `is K0` read's `ref.cast $aTypeIdx` must validate even when the
    // module constructs no string.
    if k < 0 {
      let lit = false
      if cov {
        lit = tyIsLitUnion(mems[i])
      } else {
        lit = nameIsLitUnionType(atoms[i])
      }
      if lit { aUsed = true }
    }
    i = i + 1
  }
  0
}

// Intern the reflist wrapper slot for every REF-ELEMENT-ARRAY arm of the union `name` (`S[]`,
// `(() => f64)[]`, `(C | D)[]`) — its box payload rides that wrapper ref, and `refArrTagOf`
// needs the slot to exist. The ref-array analogue of `markValueUnionAtoms` (which marks the
// scalar arms' value-box reps). `internShapeDeep` first interns any INLINE-shape element struct
// (`{a: f32}[]`) so `refArrElemName`/`ensureRefElem` resolve it; then `ensureRefElem` interns
// the element's reflist slot (recursively for a nested `S[][]`). Gated on a NON-value array atom
// (`valueAtomKind < 0`), so scalar-element lists (`i32[]`, kinds 7-10 — `markValueUnionAtoms`
// owns those) are skipped. A no-op for a union with no ref-array arm; called from BOTH the inline
// and named registration paths so the two spellings intern identically.
export function markRefArrayArms(name: string) {
  // D-UNION: the arm gate is a `TyArray` over a non-scalar-leaf element
  // (`unMemIsRefElemArray`), not `valueAtomKind(a) < 0 && nameIsArray(a)` over the
  // atom's rendering. The stored atom TEXT is still what the name-keyed reflist layer
  // downstream (`internShapeDeep` / `refArrElemName` / `ensureRefElem`) needs, so it
  // stays; only the classification moves. An uncovered row keeps the legacy gate.
  const atoms: string[] = []
  const mems: i32[] = []
  const cov = unionSetArmTys(name, atoms, mems)
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    let isRefArr = false
    if cov {
      isRefArr = unMemIsRefElemArray(mems[i])
    } else {
      isRefArr = a != "null" && valueAtomKind(a) < 0 && nameIsArray(a)
    }
    if isRefArr {
      internShapeDeep(a)
      const elem = refArrElemName(a)
      if elem != "" {
        ensureRefElem(elem)
        // Force the ref-list flags so the backing/wrapper heaps emit and the index/`.length`
        // machinery is enabled — a ref-array mentioned ONLY as a union arm (`S[] | {w:i32}`)
        // otherwise leaves `raUsed`/`rlUsed` false and the narrowed `x[i]` read fails "ref array
        // type not collected". The union-arm analogue of the array-literal / ref-array-local flips.
        rlUsed = true
        raUsed = true
      }
    }
    i = i + 1
  }
  0
}

// Intern the map value-slot for every MAP arm of the union `name` (`{[string]: string}`,
// `{[string]: () => boolean}`) — its box payload rides that arm's map STRUCT ref, and `mapTagOf`
// needs the slot to exist. The map analogue of `markRefArrayArms` / `markValueUnionAtoms`. Forces
// the shared map heap flags (`mUsed`/`lUsed`/`aUsed` — the mono `$mStructIdx` + its key/val lists)
// and interns the arm's VALUE shape via `mvShapeOfValName` (recursively, for a typed/ref/closure
// value), exactly the `ensureRefElem` kind-3 (map element) path. A mono/atom value interns no slot
// (rides `-1`); a typed value gets a distinct mv slot → a distinct `mapSlotTag`. A no-op for a union
// with no map arm; called from BOTH the inline and named registration paths so the two spellings
// intern identically. Runs in `collectA` too (the AUTHORITATIVE re-intern after the mv-table reset).
export function markMapUnionArms(name: string) {
  // D-UNION: a map arm is a `TyMap` member (`unMemIsMap`), not a `{[`-prefixed
  // rendering. The arm's stored atom TEXT still keys the (name-keyed) map-value slot
  // layer below (`mapValNameOf` → `mvShapeOfValName`). Uncovered rows keep the name gate.
  const atoms: string[] = []
  const mems: i32[] = []
  const cov = unionSetArmTys(name, atoms, mems)
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    let isMap = false
    if cov {
      isMap = unMemIsMap(mems[i])
    } else {
      isMap = a != "null" && nameIsMap(a)
    }
    if isMap {
      mUsed = true
      lUsed = true
      aUsed = true
      mvShapeOfMapName(a)
    }
    i = i + 1
  }
  0
}

// Force the shared map machinery + intern the mv value slot of a MAP reached only as
// a CLOSURE RESULT inside a composite annotation — a union arm
// (`(() => {[string]: f64}) | {w: i32}`), the nullable-closure niche
// (`((i32) => {[string]: f64}) | null`), or a curried result. The whole spelling is
// ONE TypeRef whose map is invisible to every branch of the `collectA` scan, so the
// narrowed arm's call-result map ops rejected "map type not collected" even though
// the result names a map — the R2×R1 combo seam. Self-gating: a name with no arrow
// arm (or no map result) forces nothing — byte-identical for every other program. A
// value-UNION result (`() => {[string]: i32} | boolean`) is deliberately NOT forced:
// that closure result stays a loud reject until its rep is minted.
export function forceCloResultMapTypes(nm: string) {
  // Cheap pre-gate (this runs per arena TypeRef): only a name spelling BOTH an
  // arrow and a map can carry a closure-result map — two substring scans, no
  // allocation, before the arm split allocates anything.
  if !strContains(nm, "=>") || !strContains(nm, "{[") { return 0 }
  const arms: string[] = []
  splitUnionAtoms(nm, arms)
  let i = 0
  while i < arms.length {
    const a = normTypeAtom(arms[i])
    // `annRetNameOf` (#1144) IS the `annArrowAt` + `slice(fa + 2, …)` pair, and its `< 1`
    // gate IS this site's `fa >= 1`. The caller keeps its own opener test — which now runs
    // FIRST, so the one-char reject precedes the depth scan instead of following it (a
    // strict work REDUCTION: `annArrowAt` no longer runs on an arm that cannot pass). That
    // opener test is `emit_base.nameIsParenOpen`, whose `length >= 1` bound IS this site's
    // `a.length > 0`; the OPEN half only — the group closes before the `=>`, so there is
    // no last-character question to ask.
    if nameIsParenOpen(a) {
      const ret0 = annRetNameOf(a)
      if ret0 != "" {
        let res = normTypeAtom(ret0)
        const rn = nulMapInnerName(res)
        if rn != "" { res = rn }
        if nameIsBareMap(res) {
          mUsed = true
          lUsed = true
          aUsed = true
          mvShapeOfMapName(res)
        } else if annArrowAt(res) >= 0 {
          // A curried result (`() => () => {[string]: V}`) recurses to ITS result.
          forceCloResultMapTypes(res)
        }
      }
    }
    i = i + 1
  }
  0
}

// Force the wrapper/backing types of a SCALAR-LEAF (or string) LIST reached only as a
// CLOSURE RESULT inside a composite annotation — the nullable-closure niche
// (`((i32) => f32[]) | null`), a union arm, a closure-typed param, or a curried result.
// The whole spelling is ONE TypeRef whose result list is invisible to every branch of the
// `collectA` scan, so a narrowed arm's value-call index read rejected "list type not
// collected" whenever the program never CONSTRUCTS such a list itself (`useIt(null)`).
// The list dual of `forceCloResultMapTypes`. Self-gating: a name with no arrow arm (or a
// non-list result) forces nothing — byte-identical for every other program. A REF-element
// list result resolves through its own annotation branches (`ensureRefElem`); a
// nullable-LIST result (`boolean[] | null`) forces its non-null leaf list (the niche slot
// only changes the valtype's nullability, not the types needed).
export function forceCloResultListTypes(nm: string) {
  // Cheap pre-gate (this runs per arena TypeRef): only a name spelling BOTH an arrow
  // and an array can carry a closure-result list — two substring scans, no allocation.
  if !strContains(nm, "=>") || !strContains(nm, "[]") { return 0 }
  const arms: string[] = []
  splitUnionAtoms(nm, arms)
  let i = 0
  while i < arms.length {
    const a = normTypeAtom(arms[i])
    // `annRetNameOf` (#1144), exactly as in `forceCloResultMapTypes` above: its `< 1` gate
    // IS this site's `fa >= 1`, and the caller's own opener test (`emit_base
    // .nameIsParenOpen`, the OPEN half only) now runs FIRST so the one-char reject
    // precedes the depth scan.
    if nameIsParenOpen(a) {
      const ret0 = annRetNameOf(a)
      if ret0 != "" {
        const res = nonNulBaseOf(normTypeAtom(ret0))
        // The five scalar-element backings via the ONE home (`scalarListKindOfName`).
        // This copy asked them in a THIRD order (string first, i32 last); the five
        // predicates are pairwise disjoint, so the home's order is the same answer —
        // probe P1 measures that rather than asserting it.
        const sk = scalarListKindOfName(res)
        if sk == 1 {
          slUsed = true
          aUsed = true
        } else if sk == 2 {
          fa64Used = true
        } else if sk == 3 {
          ia64Used = true
        } else if sk == 4 {
          fa32Used = true
        } else if sk == 0 {
          lUsed = true
          aUsed = true
        } else if nameIsRefArray(res) {
          // A REF-element list result (`((i32) => {a,f,z}[]) | f64` — a struct-element
          // array returned by a union-arm / nullable-niche closure): intern its element
          // slot + force the ref-list machinery, exactly as a BARE `S[]` annotation's
          // branch does — else a narrowed arm's value call keys a `>r<slot>;` sig no
          // producer interned (its slot unresolvable), or the read finds no wrapper.
          rlUsed = true
          raUsed = true
          ensureRefElem(refArrElemName(res))
        } else if annArrowAt(res) >= 0 {
          // A curried result (`() => () => f32[]`) recurses to ITS result.
          forceCloResultListTypes(res)
        }
      }
    }
    i = i + 1
  }
  0
}

// True if the union member-set `name` has a MAP arm whose interned map value-slot is `slot` — the
// guard `emitUnionCoerce` uses to confirm a map carrier actually matches an arm before boxing it
// with that arm's `mapSlotTag`. A map expr whose value-slot matches no arm falls through (a
// checker-impossible case) rather than mis-tag. The map twin of `unionHasRefArrayArmSlot`.
// Arm and carrier compare CANONICALLY (`mvCanonRepOf`): a twin-spelled carrier (a
// `{[string]: B}` boxed into a `{[string]: {v: i32}} | X`) matches the arm it lowers as.
export function unionHasMapArmSlot(name: string, slot: i32) {
  // D-UNION: the arm SHAPE test is structural (`unMemIsMap` — a `TyMap` member); the
  // SLOT comparison stays where it is, because a slot is a REP question and
  // `mvSlotOfMapValNameOrMono`/`mvCanonRepOf` already answer it canonically.
  const atoms: string[] = []
  const mems: i32[] = []
  const cov = unionSetArmTys(name, atoms, mems)
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    let isMap = false
    if cov {
      isMap = unMemIsMap(mems[i])
    } else {
      isMap = a != "null" && nameIsMap(a)
    }
    if isMap {
      // The arm's VALUE type is already in hand when the arena decided the arm
      // (D-MVSLOTFIND): `mems[i]` IS this atom's `TyMap`, so the slot lookup takes one
      // hop instead of re-parsing `mapValNameOf(a)`. An arena-blind row (`cov` false)
      // passes -1 and the name leg answers where it always did.
      let aVt = -1
      if cov { aVt = tyMapValOf(mems[i]) }
      if (mvCanonRepOf(mvSlotOfMapNameTy(a, aVt)) == mvCanonRepOf(slot)) {
        return true
      }
    }
    i = i + 1
  }
  false
}

// True when the union member-set `name` carries a map arm whose VALUE spelling is the bare
// `string` — the checker's RENDER of a litunion-valued map (`{[string]: K0}` renders
// `{[string]: string}`; the litunion bit lives on the NODE, not the name), so a union
// registered through a rendered spelling (a lambda's pinned result, an inline expanded
// litunion) interned the STRING-map slot for what is a MONO-map value. The box seam
// (`emitUnionCoerce`'s map-carrier arm) consults this when a mono litunion-valued map
// misses the slot match: the collapsed arm IS this value's arm, and the box tags MONO
// (`mapSlotTag(-1)`) — the same tag an `is {[string]: K0}` test derives from its own
// (litunion → mono) spelling, so store and narrow resolve one tag.
export function unionHasCollapsedStringMapArm(name: string) {
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  // D-UNION: DELIBERATELY NOT migrated. This classifier is DEAD on the whole corpus
  // (measured: a per-site sabotage — one that fails the compile whenever the function
  // is entered at all — fires on 0 of 1,234 corpus programs and 0 of 50,400 fuzz
  // programs), so an arena leg here could not be sabotage-verified and would ship
  // unmeasured. Its `mapValNameOf(a) == "string"` verdict is also NOT a candidate: it
  // asks about the checker's RENDER of a litunion map value, which is exactly the
  // information the arena keeps and the name loses.
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    if a != "null" && nameIsBareMap(a) {
      if mapValNameOf(a) == "string" { return true }
    }
    i = i + 1
  }
  false
}

// True if the union member-set `name` has a MAP arm (`{[string]: V}`). Resolves an alias to its
// member set first. Used by the frame pre-pass (`exprHasMapOp` → `unionMapArmIdent`) to reserve the
// map scratch frame for a `t[k]` on a union binding narrowed to its map arm — the narrowing is not
// active in that pass, so the map op must be spotted from the binding's DECLARED union.
export function unionHasMapArm(name: string) { unionMapArmName(name) != "" }

// The MAP arm NAME of the union member-set `name` (`{[string]: V}` in `{[string]: V} | {w: i32}`),
// or "" when it has none (the FIRST map atom; the value-atom scheme carries one map arm per union).
// The name-typed dual of `unionHasMapArm` — `mapReadMvSlot`'s narrowing-blind fallback resolves the
// arm's VALUE mv slot from it so a `t[k] ?? d` binding classifies its value union in the frame
// pre-pass (where the `is`-narrow that makes `t` a map is not active).
export function unionMapArmName(name: string) {
  const armTy: i32[] = []
  unionMapArmNameTy(name, armTy)
}

// …and the form that also HANDS BACK the arm's arena type, pushed onto `outTy` (empty
// when the arena leg did not decide the arm). The map-slot layer downstream is still
// name-keyed, so the spelling stays the return value; what changed is that the caller no
// longer has to re-derive `V` from it — `tyMapValOf(outTy[0])` is the value type this
// scan already read off the row (D-MVSLOTFIND). An out-array rather than a second
// function because the arm is chosen by ONE walk: a `unionMapArmTy` sibling would scan
// the member slice a second time to answer about the row this one already picked.
export function unionMapArmNameTy(name: string, outTy: i32[]) {
  const atoms: string[] = []
  // D-UNION: pick the map arm from the row's recorded ARENA member types
  // (`unMemIsMap` — `T.tys[m] is TyMap`) instead of re-classifying each atom's
  // RENDERED spelling with `nameIsMap`. The recorded member slice is in atom order
  // (the box-tag ABI order), so `atoms[m]` is this member's stored spelling — which is
  // what the still-name-keyed map-slot layer downstream (`mapValNameOf`,
  // `mvSlotOfMapValNameOrMono`) needs. An uncovered row keeps the legacy name path.
  const mems: i32[] = []
  if unionArmTys(name, atoms, mems) {
    let m = 0
    while m < mems.length {
      if unMemIsMap(mems[m]) {
        outTy.push(mems[m])
        return atoms[m]
      }
      m = m + 1
    }
    return ""
  }
  let i = 0
  while i < atoms.length {
    if nameIsMap(atoms[i]) { return atoms[i] }
    i = i + 1
  }
  ""
}

// True if `exprIx` is an IDENT whose DECLARED union has a map arm — the receiver shape the frame
// pre-pass reserves the map scratch for (`t[k]` / `t[k] ?? d` / `t.has(k)` on a union narrowed to
// a map). Narrowing-blind: reads the binding's declared union, not the active narrowing.
export function unionMapArmIdent(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Ident {
    const un = unionNameOfIdent(e.identName, fnIx)
    if un != "" { return unionHasMapArm(un) }
    // The typed-IR fallback: a union binding whose NAME the syntactic resolution cannot
    // render (`const t1 = t0()` off a narrowed nullable-closure rebind — the Ident-callee
    // miss) still records the union on its node type. The emitter lowers the narrowed map
    // read regardless, so the frame pre-pass must reserve the map scratch from the same
    // signal. (An over-reservation is a harmless spare.)
    return nodeTyUnionHasMapArm(exprIx)
  }
  false
}

// True when the CHECKED type of `exprIx` is a union carrying a MAP member, or a bare
// MAP (a narrowed occurrence records the NARROWED arm type, so the then-branch ident
// of `if t1 is {[string]: i32}` types TyMap, not the union) — the typed-IR net behind
// `unionMapArmIdent`'s syntactic miss.
function nodeTyUnionHasMapArm(exprIx: i32): boolean {
  const ty = nodeTyIxOf(exprIx)
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyMap { return true }
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if T.tys[t.uMembers[i]] is TyMap { return true }
      i = i + 1
    }
  }
  false
}

// The typed-IR net for the narrowed MAP-arm UNBOX gate (`emitIdent`'s `narrowedMapOf` arm):
// follow `name`'s rebind chain (`const t2 = t1; const t1 = t0()`) to its ORIGIN expression
// and test whether the checker typed IT as a union carrying a MAP member (optionally under a
// nullable the `!= null` narrow peeled). The narrowed OCCURRENCE records the NARROWED arm
// type (TyMap), so the receiver node itself cannot carry the gate — but the origin (a
// nullable-closure VALUE call `t0()`, the syntactic `unionNameOfIdent` miss) records the
// union before any narrowing. A bare-map origin stays false — its value is never boxed.
export function identChainTyMapArmUnion(
  name: string,
  fnIx: i32,
  depth: i32,
): boolean {
  if depth <= 0 || fnIx < 0 { return false }
  const fn = P.nodes[fnIx]
  if !(fn is FuncDecl) { return false }
  const li = parentLetOf(fn.fnBody, name)
  if li < 0 { return false }
  const d = P.nodes[li]
  if !(d is LetDecl) { return false }
  if d.letInit < 0 { return false }
  const initIx = unwrapParen(d.letInit)
  const init = P.nodes[initIx]
  if init is Ident {
    return identChainTyMapArmUnion(init.identName, fnIx, depth - 1)
  }
  const ty = nodeTyIxOf(initIx)
  if ty < 0 { return false }
  let uy = ty
  const tw = T.tys[ty]
  if tw is TyNullable { uy = tw.nInner }
  const tn = T.tys[uy]
  if tn is TyUnion {
    let i = 0
    while i < tn.uMembers.length {
      if T.tys[tn.uMembers[i]] is TyMap { return true }
      i = i + 1
    }
  }
  false
}

// The value-atom dual of `identChainTyMapArmUnion`: follow `name`'s rebind chain
// (`const t1 = t0`) to its ORIGIN expression and test whether the checker typed IT as a
// BOXED value union — a `TyUnion` (optionally under a nullable the `!= null` narrow
// peeled) with ≥2 members, at least one non-literal (an ALL-literal union reps as the
// i32 atom / bare string ref, never the box). The narrowed-atom unbox gate
// (`emitIdent`'s `narrowedValueAtomOf` arm) consults this where the syntactic
// `unionNameOfIdent` cannot render the binding's union (`const t0 = v[0](1)` — an
// Index-callee closure call): the binding local holds the BOX, and skipping the unbox
// pushed the box ref where the raw narrowed atom was expected — invalid wasm.
export function identChainTyBoxedUnion(
  name: string,
  fnIx: i32,
  depth: i32,
): boolean {
  if depth <= 0 || fnIx < 0 { return false }
  const fn = P.nodes[fnIx]
  if !(fn is FuncDecl) { return false }
  const li = parentLetOf(fn.fnBody, name)
  if li < 0 { return false }
  const d = P.nodes[li]
  if !(d is LetDecl) { return false }
  if d.letInit < 0 { return false }
  const initIx = unwrapParen(d.letInit)
  const init = P.nodes[initIx]
  if init is Ident {
    return identChainTyBoxedUnion(init.identName, fnIx, depth - 1)
  }
  const ty = nodeTyIxOf(initIx)
  if ty < 0 { return false }
  let uy = ty
  const tw = T.tys[ty]
  if tw is TyNullable { uy = tw.nInner }
  const tn = T.tys[uy]
  if tn is TyUnion {
    if tn.uMembers.length < 2 { return false }
    let i = 0
    while i < tn.uMembers.length {
      if !(T.tys[tn.uMembers[i]] is TyLit) { return true }
      i = i + 1
    }
  }
  false
}

// True if `exprIx` is a MEMBER read (`t[i].f`) whose object indexes an IDENT declared as a
// union with a REF-ARRAY arm whose ELEMENT struct's field `.f` is a MAP (code 19) — the
// struct-field-map receiver shape (`t[i].f[k] ?? d` after an `is S[]` narrow) the frame
// pre-pass must reserve the map scratch for. Narrowing-blind, like `unionMapArmIdent`: the
// `is`-narrow that makes `t[i]` a struct is not active in the pre-pass, so `exprMap`'s
// `memFieldTypeCode` resolution misses the receiver and the map read then clobbered the i32
// scratch slots with map refs — invalid wasm. (An over-reservation is a harmless spare.)
export function unionListElemMapFieldMember(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Member {
    const obj = P.nodes[unwrapParen(e.memObj)]
    if obj is Index {
      const arr = P.nodes[unwrapParen(obj.idxArr)]
      if arr is Ident {
        const un = unionNameOfIdent(arr.identName, fnIx)
        if un != "" {
          const atoms: string[] = []
          // D-UNION (batch 2's `tyArmPathLeaf` walk, applied to an INDEXED root): the
          // arm's element type is `tyArmElem` (a `TyArray` arm's element — the name
          // path's `nameIsRefArray(a)` gate plus its `refArrElemName`/inline-shape
          // re-resolution), and the `.f` leaf's code-19 map test is `tyArmPathIsMap`.
          // An uncovered row keeps the legacy name walk.
          const mems: i32[] = []
          const cov = unionArmTys(un, atoms, mems)
          let i = 0
          while i < atoms.length {
            const a = atoms[i]
            if cov {
              const path: string[] = []
              path.push(e.memProp)
              if tyArmPathIsMap(tyArmElem(mems[i]), path) { return true }
            } else if nameIsRefArray(a) {
              // The arm's element struct: `refArrElemName` for a nominal element, the raw
              // `[]`-stripped text for an inline shape it cannot see (the interner's key) —
              // the trailing-`[]` CUT at its home (`tyname.arrElemNameRaw`, W5).
              //
              // The `a.length > 2` conjunct this drops is NOT the home's `nameIsArray`
              // guard, and it is discharged twice over. `nameIsRefArray(a)` is the enclosing
              // arm, and EVERY path by which it answers true establishes `nameIsArray(a)`:
              // its `nameIsElemArray` leg spells it, and every `refArrShapeKind` arm either
              // spells it (`{…}[]` string / nested-ref) or gates on a home that does
              // (`nameIsI32ListArray` / `nameIsMapArray` via a non-empty `arrElemNameRaw`;
              // `nameIsClosureArray` / `parenUnionArrElemName` spell it outright). The only
              // 2-character array name is the degenerate `"[]"`, and `nameIsRefArray("[]")`
              // is false — so `a.length > 2` is IMPLIED here, not weakened. And even where
              // it is not, the two forms still agree: `arrElemNameRaw` answers "" for a
              // non-array and for `"[]"` alike, which is exactly what the guarded spelling
              // left `en` as.
              let en = refArrElemName(a)
              if en == "" { en = arrElemNameRaw(a) }
              const si = structIndexByName(en)
              if si >= 0 {
                const fi = sFieldIndex(si, e.memProp)
                if fi >= 0 {
                  if sFieldTypeAt(si, fi) == 19 { return true }
                }
              }
            }
            i = i + 1
          }
        }
      }
    }
  }
  false
}

// True if `exprIx` is a MEMBER read (`t.f`) whose object is an IDENT declared as a union
// with a STRUCT arm whose field `.f` is a MAP (code 19) — the struct-arm map-field receiver
// shape (`t.f[k] ?? d` after an `is {f: {[string]: V}}` narrow) the frame pre-pass must
// reserve the map scratch for. Narrowing-blind, like the list-element sibling above: the
// `is`-narrow that makes `t` a struct is not active in the pre-pass, so `exprMap`'s
// `memFieldTypeCode` resolution misses the receiver and the narrowed map read then indexed
// scratch locals past the frame — invalid wasm. Probes BOTH field tables: the struct table
// (a `{f:…} | i32` arm interned by `internShapeDeep`) and the variant table (a declared
// struct arm of a 2+-struct union lives in `uVariants`). (An over-reservation is a
// harmless spare local, never invalid wasm.)
export function unionStructArmMapFieldMember(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Member {
    // Collect the field chain root-first: `t0.f.g` → root `t0`, props [f, g] — the
    // same walk `calleeIsUnionArmClosureMember` performs, so a MAP field reached
    // through code-15 nested-struct hops (`t0.f.f[k]` after an `is
    // {f:{f:{[string]:V}}}` narrow) is spotted, not just the single-hop `t0.f[k]`.
    const props: string[] = []
    let cur = unwrapParen(exprIx)
    let rootName = ""
    let guard = 0
    while guard < 32 {
      guard = guard + 1
      const cn = P.nodes[cur]
      if cn is Member {
        props.push(cn.memProp)
        cur = unwrapParen(cn.memObj)
      } else if cn is Ident {
        rootName = cn.identName
        break
      } else {
        return false
      }
    }
    if rootName == "" || props.length == 0 { return false }
    // props collected leaf-first — reverse into walk order.
    const path: string[] = []
    let pr = props.length - 1
    while pr >= 0 {
      path.push(props[pr])
      pr = pr - 1
    }
    const un = unionNameOfIdent(rootName, fnIx)
    if un == "" { return false }
    const atoms: string[] = []
    // D-UNION: the arm's field path is walked over the member's ARENA type
    // (`tyArmPathIsMap` — a `TyMap` leaf) instead of re-resolving the rendered atom to
    // a struct/variant row and consulting its per-field lowering codes.
    const mems: i32[] = []
    // D-ARMNAMELEG: the arena declining is answered CONSERVATIVELY, not by a second
    // walk over the arms' rendered spellings — see `armPathArenaDeclined`.
    if !unionArmTys(un, atoms, mems) { return armPathArenaDeclined() }
    let m = 0
    while m < mems.length {
      if atoms[m] != "null" {
        if tyArmPathIsMap(mems[m], path) { return true }
      }
      m = m + 1
    }
    return false
  }
  false
}

// THE ONE ANSWER for "the arena could not give me this union's member TYPES" at the five
// frame-reservation guards below (`unionStructArmMapFieldMember`,
// `unionStructArmMapListElemIndex`, `identRebindUnionArmClosureField`,
// `calleeIsUnionArmClosureMember`, `calleeIsUnionArmCloArrayIndex`).
//
// It is `true`, and that is the ONLY sound answer — every one of those five guards
// exists to RESERVE a frame slot the narrowing-blind pre-pass would otherwise miss, and
// each one's own header states the asymmetry: **an over-reservation is a harmless spare
// local; an under-reservation is invalid wasm.** So a guard that does not KNOW must say
// yes.
//
// What stood here before was a 27-line hand-written walk over the arms' rendered
// SPELLINGS (`unionArmPathLeafIs` + five `want`-selected leaf tests), re-resolving each
// atom through the struct table or the variant table and re-reading per-field lowering
// codes — a second, string-keyed implementation of the walk `tyArmPath*` performs
// structurally three lines above. It could answer FALSE, which is the unsound direction,
// and it was never reached: the arena leg covered the row at **175 of 175** reaches of
// these five guards — 39 over 1,340 corpus entries and 136 over 33,600 fuzz programs —
// so the fall-through ran zero times on either channel (probe PD; the same counter reads
// 161 under a build that forces the decline, so the 0 is a measurement, not a blind
// instrument). Deleting it removes the grammar and moves the unknown case from "guess,
// possibly wrong, by re-parsing a rendering" to "reserve".
function armPathArenaDeclined(): boolean { true }

// True if `exprIx` is an INDEX (`t0.f[0]`) whose receiver is a member chain rooted at an
// IDENT declared as a union, whose field path walks — narrowing-blindly, the
// `unionStructArmMapFieldMember` discipline — to a LIST-OF-MAPS field (a code-5 reflist
// field whose element name is a map, `{[string]: K0}[]`). The indexed-map-list receiver
// shape (`t0.f[0][k] ?? d` after an `is {f: {[string]: K0}[]}` narrow) the frame pre-pass
// must reserve the map scratch for: the `is`-narrow that resolves the chain is not active
// in the pre-pass, so `exprMap` misses the receiver and the narrowed map read's scratch
// stores landed on UNRESERVED indices — shared with unrelated locals (an i32 local
// receiving the map struct ref, invalid wasm). (An over-reservation is a harmless spare.)
export function unionStructArmMapListElemIndex(exprIx: i32, fnIx: i32) {
  if !uDeclared { return false }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Index {
    const m = unwrapParen(e.idxArr)
    if !(P.nodes[m] is Member) { return false }
    // Collect the field chain root-first: `t0.f.g[0]` → root `t0`, props [f, g]. The
    // root may also be an INDEXED union ident (`t0[i].f[0][k]` — the union's REF-ARRAY
    // arm's element struct carries the list-of-maps field): bottom out at `Index(Ident)`
    // with the via-element flag, so the arm walk starts at the array arm's ELEMENT.
    const props: string[] = []
    let cur = m
    let rootName = ""
    let viaElem = false
    let guard = 0
    while guard < 32 {
      guard = guard + 1
      const cn = P.nodes[cur]
      if cn is Member {
        props.push(cn.memProp)
        cur = unwrapParen(cn.memObj)
      } else if cn is Ident {
        rootName = cn.identName
        break
      } else if cn is Index {
        const rin = P.nodes[unwrapParen(cn.idxArr)]
        if rin is Ident {
          rootName = rin.identName
          viaElem = true
        }
        break
      } else {
        return false
      }
    }
    if rootName == "" || props.length == 0 { return false }
    const path: string[] = []
    let pr = props.length - 1
    while pr >= 0 {
      path.push(props[pr])
      pr = pr - 1
    }
    const un = unionNameOfIdent(rootName, fnIx)
    if un == "" { return false }
    const atoms: string[] = []
    // D-UNION: the arm walk is structural (`tyArmPathIsMapList` — a `TyArray` over a
    // `TyMap` leaf), and so is the indexed-root hop: `tyArmElem` takes a `TyArray` arm's
    // element in place of `nameIsRefArray` + `refArrElemName` on the rendered atom.
    const mems: i32[] = []
    // D-ARMNAMELEG: the arena declining is answered CONSERVATIVELY, not by a second
    // walk over the arms' rendered spellings — see `armPathArenaDeclined`.
    if !unionArmTys(un, atoms, mems) { return armPathArenaDeclined() }
    let mi = 0
    while mi < mems.length {
      if atoms[mi] != "null" {
        let mem = mems[mi]
        if viaElem { mem = tyArmElem(mem) }
        if tyArmPathIsMapList(mem, path) { return true }
      }
      mi = mi + 1
    }
    return false
  }
  false
}

// True if the union member-set `name` has a CLOSURE-ARRAY arm (`(() => f64)[]`). `p[0]()` on
// such a union (narrowed to the closure array) is a `call_ref`, so the frame pre-pass reserves
// `callRefSlot` for it — see `blockHasCallRef`. Resolves an alias to its member set first.
export function unionHasClosureArrayArm(name: string) {
  const atoms: string[] = []
  // D-UNION: `unMemIsFuncArray` (a `TyArray` over a `TyFunc`) is the arena dual of
  // `nameIsClosureArray` — including its NULLABLE-element exclusion, which falls out
  // for free (a `(((i32) => boolean) | null)[]` element is a `TyNullable`).
  const mems: i32[] = []
  if unionArmTys(name, atoms, mems) {
    let m = 0
    while m < mems.length {
      if unMemIsFuncArray(mems[m]) { return true }
      m = m + 1
    }
    return false
  }
  let i = 0
  while i < atoms.length {
    if nameIsClosureArray(atoms[i]) { return true }
    i = i + 1
  }
  false
}

// True if `exprIx` is `p[0]` where `p` is a union IDENT whose union has a closure-array arm —
// the callee shape `blockHasCallRef` reserves `callRefSlot` for (the narrowing-blind pre-pass).
export function calleeIsUnionClosureArrayIndex(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Index {
    const arr = P.nodes[unwrapParen(e.idxArr)]
    if arr is Ident {
      const un = unionNameOfIdent(arr.identName, fnIx)
      if un != "" { return unionHasClosureArrayArm(un) }
    }
  }
  false
}

// `t0[0].f()` where `t0`'s union has a REF-ARRAY arm whose ELEMENT struct carries a
// CLOSURE field (`{f: () => {[string]: string}}[] | f64`): the `is`-narrowing that
// makes `t0` the ref array is not active in this frame pre-pass, so `exprIsClosure`
// on the member chain is false — reserve `callRefSlot` conservatively (a spare local
// is harmless; an UNRESERVED `call_ref` spill shares the next frame's local — here
// the map RESULT local: INVALID-WASM, local fuzz sweep1 branching leg). The
// indexed-ELEMENT-field twin of `calleeIsUnionArmClosureMember` /
// `calleeIsUnionArmCloArrayIndex`. The arm test is conservative: any ref-array arm
// whose element spelling carries an arrow.
export function calleeIsUnionElemFieldClosure(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Member {
    const ix = P.nodes[unwrapParen(e.memObj)]
    if ix is Index {
      const arr = P.nodes[unwrapParen(ix.idxArr)]
      if arr is Ident {
        const un = unionNameOfIdent(arr.identName, fnIx)
        if un != "" {
          const atoms: string[] = []
          // D-UNION: the deliberately-conservative `strContains(elem, "=>")` arm test
          // is a REACHABILITY question — `unMemIsFuncReachArray` asks it of the arena
          // (a `TyArray` whose element structure reaches a `TyFunc`) instead of of the
          // element's rendered spelling.
          const mems: i32[] = []
          if unionArmTys(un, atoms, mems) {
            let m = 0
            while m < mems.length {
              if unMemIsFuncReachArray(mems[m]) { return true }
              m = m + 1
            }
            return false
          }
          let i = 0
          while i < atoms.length {
            const a = atoms[i]
            // `refArrElemNameIf` IS the `nameIsRefArray` gate plus the element read;
            // a non-ref-array atom yields "" and `strContains("", "=>")` is false, so
            // dropping the conjunct is exact.
            if a != "null" && valueAtomKind(a) < 0 {
              if strContains(refArrElemNameIf(a), "=>") { return true }
            }
            i = i + 1
          }
        }
      }
    }
  }
  false
}

// True if the union member-set `name` has a BARE-CLOSURE arm (`(() => i64) | {w:i32}`,
// `(() => i64) | i32`). A closure is value-atom KIND 11 (a REF atom riding the box anyref as
// the `$cloStructIdx` fat-pointer), so — unlike the ref-array / map arms — it needs no new tag
// band: its `scalarTagOf` (`uVariants.length + 11`) already discriminates. Resolves an alias to
// its member set first, mirroring `unionHasClosureArrayArm` (which tests the closure-ELEMENT
// array arm, a distinct shape whose arrow is nested inside `[]`).
export function unionHasClosureArm(name: string) {
  const atoms: string[] = []
  // D-UNION: value-atom kind 11 IS "the member is a function type" — ask the arena
  // (`unMemIsFunc`) rather than `valueAtomKind`'s spelling ladder.
  const mems: i32[] = []
  if unionArmTys(name, atoms, mems) {
    let m = 0
    while m < mems.length {
      if unMemIsFunc(mems[m]) { return true }
      m = m + 1
    }
    return false
  }
  let i = 0
  while i < atoms.length {
    if valueAtomKind(atoms[i]) == 11 { return true }
    i = i + 1
  }
  false
}

// The BARE-CLOSURE arm NAME of the union member-set `name` (`(() => i64)` in `(() => i64) | i32`),
// or "" when it has none. `emitUnionCoerce` boxes a closure carrier with this arm's `scalarTagOf`.
// (A union with two distinct closure arms shares one kind-11 tag — a pre-existing value-atom-scheme
// limitation, not exercised by the supported single-closure-arm shapes; returns the FIRST here.)
export function unionClosureArmName(name: string) {
  const atoms: string[] = []
  // D-UNION: the arm SELECTION is structural (`unMemIsFunc`); the returned NAME stays
  // the member's stored spelling, which `emitUnionCoerce` feeds to the still-name-keyed
  // `scalarTagOf` (a D5 residual, not this slice).
  const mems: i32[] = []
  if unionArmTys(name, atoms, mems) {
    let m = 0
    while m < mems.length {
      if unMemIsFunc(mems[m]) { return atoms[m] }
      m = m + 1
    }
    return ""
  }
  let i = 0
  while i < atoms.length {
    if valueAtomKind(atoms[i]) == 11 { return atoms[i] }
    i = i + 1
  }
  ""
}

// The ELEMENT value-union of union member-set `name`'s REF-ARRAY arm whose element is itself a
// value union carrying a bare-closure member (`((() => i32) | i64)[] | i64` → `(() => i32) | i64`),
// or "". Such an arm is a union-ELEMENT array (`nameIsRefArray`, element kind 2), NOT a
// `nameIsClosureArray` (whose element is a BARE closure) — so `unionHasClosureArrayArm` does not
// cover it. Lets `t0[0]` off a union binding recover its element union narrowing-blindly (the
// `is`-narrowing that makes `t0` the ref array is not active in the frame pre-pass).
export function unionClosureArrElemUnion(name: string) {
  const atoms: string[] = []
  unionArmsOf(name, atoms)
  let i = 0
  while i < atoms.length {
    // `refArrElemNameIf` IS the `nameIsRefArray` gate plus the element read. The
    // `el != ""` test KEEPS the short-circuit master's `nameIsRefArray` arm had —
    // D-GRAMHOME's rule, that a home placed in front of a cheap reject must not cost the
    // early exit. Without it `isValueUnionName("")` would run once per non-ref-array
    // atom, which is an `unionMemberCount` scan this loop never used to pay.
    const el = refArrElemNameIf(atoms[i])
    if el != "" && isValueUnionName(el) && unionHasClosureArm(el) { return el }
    i = i + 1
  }
  ""
}

// True if `exprIx` is an IDENT whose declared union has a bare-closure arm — the callee shape
// `blockHasCallRef` reserves `callRefSlot` for (the `is`-narrowing that makes the ident a closure
// is NOT active during the narrowing-blind frame pre-pass, so `exprIsClosure` is false there).
// The bare-binding analogue of `calleeIsUnionClosureArrayIndex` (`const t = p.f; t()` /
// `const e = arr[0]; e()`, where the closure arm was extracted to a plain union binding first).
export function calleeIsUnionClosureIdent(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Ident {
    const un = unionNameOfIdent(e.identName, fnIx)
    if un != "" { return unionHasClosureArm(un) }
    // REBIND of a union-arm FIELD union (`const t1 = t0.f; const t2 = t1; t2(1)` where
    // `t0`'s arm carries `f: ((i32) => K0) | boolean | null`): the binding's own union
    // name resolves "" here (the `??`-less member read has no syntactic union channel),
    // so walk the init chain to the member's field table — a closure field (14/22) or a
    // union-BOX field (16) with a closure arm means the narrowed `call_ref` needs its
    // scratch. Reservation-only (an over-match is a harmless spare local); without it
    // the closure spill indexed an UNRESERVED local — invalid wasm (fuzz seed
    // 113148886 d6, `{a, f: ((i32) => K0) | boolean | null, z} | string`).
    return identRebindUnionArmClosureField(e.identName, fnIx, 4)
  }
  false
}

// True when local `name`'s LET-INIT chain (rebinds followed up to `depth`) bottoms out at
// a member CHAIN rooted at a union-typed IDENT whose arm field path leafs at a CLOSURE
// field (code 14 / 22) or a closure-armed union-BOX field (code 16) — the rebound-binding
// dual of `calleeIsUnionArmClosureMember`, for `blockHasCallRef`'s narrowing-blind
// `callRefSlot` reservation.
function identRebindUnionArmClosureField(
  name: string,
  fnIx: i32,
  depth: i32,
): boolean {
  if depth <= 0 || fnIx < 0 { return false }
  const fn = P.nodes[fnIx]
  if !(fn is FuncDecl) { return false }
  const li = parentLetOf(fn.fnBody, name)
  if li < 0 { return false }
  const d = P.nodes[li]
  if !(d is LetDecl) { return false }
  if d.letInit < 0 { return false }
  const init = P.nodes[unwrapParen(d.letInit)]
  if init is Ident {
    return identRebindUnionArmClosureField(init.identName, fnIx, depth - 1)
  }
  if init is Member {
    // Collect the field chain root-first (the `calleeIsUnionArmClosureMember` walk).
    const props: string[] = []
    let cur = unwrapParen(d.letInit)
    let rootName = ""
    let guard = 0
    while guard < 32 {
      guard = guard + 1
      const cn = P.nodes[cur]
      if cn is Member {
        props.push(cn.memProp)
        cur = unwrapParen(cn.memObj)
      } else if cn is Ident {
        rootName = cn.identName
        break
      } else {
        return false
      }
    }
    if rootName == "" || props.length == 0 { return false }
    const path: string[] = []
    let pr = props.length - 1
    while pr >= 0 {
      path.push(props[pr])
      pr = pr - 1
    }
    const un = unionNameOfIdent(rootName, fnIx)
    if un == "" { return false }
    const atoms: string[] = []
    // D-UNION: the arm walk is structural (`tyArmPathHasCloValue` — a `TyFunc` leaf,
    // bare / nullable, or a `TyUnion` with a `TyFunc` member).
    const mems: i32[] = []
    // D-ARMNAMELEG: the arena declining is answered CONSERVATIVELY, not by a second
    // walk over the arms' rendered spellings — see `armPathArenaDeclined`.
    if !unionArmTys(un, atoms, mems) { return armPathArenaDeclined() }
    let m = 0
    while m < mems.length {
      if atoms[m] != "null" {
        if tyArmPathHasCloValue(mems[m], path) { return true }
      }
      m = m + 1
    }
    return false
  }
  false
}

// True if `exprIx` is a member CHAIN (`t0.f.f`) rooted at an IDENT declared as a union,
// whose field path walks — NARROWING-BLINDLY through the arms' field tables (struct AND
// variant), across code-15 nested-struct hops — to a CLOSURE field (code 14, or the
// nullable-closure niche 22). The member-chain callee shape `blockHasCallRef` reserves
// `callRefSlot` for: the `is`-narrowing that makes the root a struct arm is not active
// during the frame pre-pass, so `exprIsClosure` misses the chain and the narrowed
// `call_ref`'s closure spill landed on an UNRESERVED index — shared with the next frame
// (the mv map frame in the observed case), a type-mismatched local (invalid wasm). An
// over-reservation is a harmless spare local.
export function calleeIsUnionArmClosureMember(exprIx: i32, fnIx: i32) {
  if !uDeclared {
    return false // no unions declared — nothing to probe (cheap bail)
  }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Member {
    // Collect the field chain root-first: `t0.f.g` → root `t0`, props [f, g].
    const props: string[] = []
    let cur = unwrapParen(exprIx)
    let rootName = ""
    let guard = 0
    while guard < 32 {
      guard = guard + 1
      const cn = P.nodes[cur]
      if cn is Member {
        props.push(cn.memProp)
        cur = unwrapParen(cn.memObj)
      } else if cn is Ident {
        rootName = cn.identName
        break
      } else {
        return false
      }
    }
    if rootName == "" || props.length == 0 { return false }
    // props collected leaf-first — reverse into walk order.
    const path: string[] = []
    let pr = props.length - 1
    while pr >= 0 {
      path.push(props[pr])
      pr = pr - 1
    }
    const un = unionNameOfIdent(rootName, fnIx)
    if un == "" { return false }
    const atoms: string[] = []
    // D-UNION: the arm walk is structural (`tyArmPathIsClosure` — a `TyFunc` leaf, bare
    // or under the nullable-closure niche's `TyNullable`).
    const mems: i32[] = []
    // D-ARMNAMELEG: the arena declining is answered CONSERVATIVELY, not by a second
    // walk over the arms' rendered spellings — see `armPathArenaDeclined`.
    if !unionArmTys(un, atoms, mems) { return armPathArenaDeclined() }
    let m = 0
    while m < mems.length {
      if atoms[m] != "null" {
        if tyArmPathIsClosure(mems[m], path) { return true }
      }
      m = m + 1
    }
    return false
  }
  false
}

// Walk field path `path` from union arm `arm`: the FIRST hop resolves through the arm's
// struct-table OR variant-table row, every MID hop must be a code-15 nested-struct field
// (following its target), and the LAST hop is a closure field (code 14 / 22).
// True if `exprIx` is an INDEX whose receiver is a member CHAIN (`t0.f[0]`) rooted at an
// IDENT declared as a union, whose field path walks — narrowing-blindly, same discipline as
// `calleeIsUnionArmClosureMember` — to a CLOSURE-ELEMENT ARRAY field (a code-5 reflist field
// whose element name is a function type). The indexed-member callee shape `blockHasCallRef`
// reserves `callRefSlot` for: the `is`-narrowing that resolves the chain is not active during
// the frame pre-pass, so `exprIsClosure` misses `t0.f[0]` and the narrowed `call_ref`'s
// closure spill landed on an unreserved (i32-typed) index — invalid wasm. An over-reservation
// is a harmless spare local.
export function calleeIsUnionArmCloArrayIndex(exprIx: i32, fnIx: i32) {
  if !uDeclared { return false }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Index {
    const m = P.nodes[unwrapParen(e.idxArr)]
    if m is Member {
      const props: string[] = []
      let cur = unwrapParen(e.idxArr)
      let rootName = ""
      let guard = 0
      while guard < 32 {
        guard = guard + 1
        const cn = P.nodes[cur]
        if cn is Member {
          props.push(cn.memProp)
          cur = unwrapParen(cn.memObj)
        } else if cn is Ident {
          rootName = cn.identName
          break
        } else {
          return false
        }
      }
      if rootName == "" || props.length == 0 { return false }
      const path: string[] = []
      let pr = props.length - 1
      while pr >= 0 {
        path.push(props[pr])
        pr = pr - 1
      }
      const un = unionNameOfIdent(rootName, fnIx)
      if un == "" { return false }
      const atoms: string[] = []
      // D-UNION: the arm walk is structural (`tyArmPathIsCloArray` — a `TyArray` over a
      // `TyFunc` leaf).
      const mems: i32[] = []
      // D-ARMNAMELEG: the arena declining is answered CONSERVATIVELY, not by a second
      // walk over the arms' rendered spellings — see `armPathArenaDeclined`.
      if !unionArmTys(un, atoms, mems) { return armPathArenaDeclined() }
      let mi = 0
      while mi < mems.length {
        if atoms[mi] != "null" {
          if tyArmPathIsCloArray(mems[mi], path) { return true }
        }
        mi = mi + 1
      }
      return false
    }
  }
  false
}

// The recorded member TYPES of a member-SET spelling, for the four ref-array ARM
// scanners (destringify D-UARMSLOT). `unionMemberTysOf` accepts an ALIAS name too
// (`unionRowOf` matches `unNames` first), and an alias must NOT expand here: the name
// loops these scanners replaced split the alias spelling into ONE atom (`N`), which no
// arm test accepts, so expanding it would be an extension, not a migration. Declining
// an alias reproduces that. Measured: every reach at all four sites is a set spelling
// whose recorded member count matches its atom split (0 alias / uncovered reaches over
// 1,243 corpus files and 100,800 fuzz programs).
function unionArmMemberTys(name: string, out: i32[]): boolean {
  if unionMemberSetOf(name) != name { return false }
  unionMemberTysOf(name, out)
}

// True if the union member-set `name` (pipe-joined atoms) has a REF-ELEMENT array arm whose
// interned reflist slot is `slot` — the guard `emitUnionCoerce` uses to confirm a ref-array
// carrier actually matches an arm before boxing it with that arm's `refArrSlotTag`. A ref-array
// expr whose slot matches no arm falls through (a checker-impossible case) rather than mis-tag.
export function unionHasRefArrayArmSlot(name: string, slot: i32) {
  // `refListSlotOfExpr` floors a miss at 0, so the only caller never asks about a
  // negative slot; the guard keeps "the carrier has no slot" from matching a member
  // that has no arm row (both -1) — the mis-tag the D-UNION note above warned about.
  if slot < 0 { return false }
  const mems: i32[] = []
  if !unionArmMemberTys(name, mems) { return false }
  let i = 0
  while i < mems.length {
    if unMemRefArrArmSlot(mems[i]) == slot { return true }
    i = i + 1
  }
  false
}

// The interned reflist SLOT of a UNION-BOX-ELEMENT ref-array arm of the union member-set
// `name` (`(i32 | string)[]`, `N[]` over a union alias, `(C | D)[]`) whose element union
// admits the member atom `elemAtom` (exact atom match — `"string"` ∈ `i32|string`, a
// variant name `"C"` ∈ `C|D`), or -1 when no arm matches. An EMPTY `elemAtom` (an empty
// `[]` literal, no element to classify) matches the FIRST union-box-element arm — the
// checker already proved the literal fits the union, and an empty list's element type is
// vacuous. `emitUnionCoerce` uses this to route a list LITERAL whose own classification
// is a scalar list (`["a"]` → `string[]`) or a concrete struct list (`[{a:1}]` → `C[]`)
// — neither of which interns the ARM's slot — into the arm's box-element build + tag.
export function unionRefArrayArmSlotForElem(name: string, elemAtom: string) {
  const exact = unionRefArrayArmSlotForElemAtom(name, elemAtom)
  if exact >= 0 { return exact }
  // LITERAL-WIDENING admission: the probe classifies a bare INT literal as "i32" and a
  // float literal as "f64", but the checker already admitted the literal into a WIDER
  // scalar element union (`[167234547]` into `(i64 | null)[]`, `[887.5]` into
  // `(f32 | null)[]`) — the same grant an annotated binding makes, and the arm's build
  // re-encodes the literal at the element's width. Without this the exact-atom miss let
  // the literal fall to the value-atom LADDER, boxing a RAW scalar list with a
  // non-matching tag — every `is (i64|null)[]` on it silently FALSE (a live MISMATCH,
  // fuzz-nightly seed 104984070 d6). Exact matches stay first so a union carrying BOTH
  // widths still picks the literal's own arm.
  if elemAtom == "i32" {
    const wi = unionRefArrayArmSlotForElemAtom(name, "i64")
    if wi >= 0 { return wi }
    const wf = unionRefArrayArmSlotForElemAtom(name, "f64")
    if wf >= 0 { return wf }
    return unionRefArrayArmSlotForElemAtom(name, "f32")
  }
  if elemAtom == "f64" { return unionRefArrayArmSlotForElemAtom(name, "f32") }
  -1
}

// The exact-atom pass of `unionRefArrayArmSlotForElem`: the first union-box-element
// ref-array arm whose element union carries `elemAtom` verbatim (any arm for "").
function unionRefArrayArmSlotForElemAtom(name: string, elemAtom: string) {
  // The arm slot per MEMBER, off the arena (D-UARMSLOT). The element-union ATOM test
  // below still reads a member-set spelling, and it reads the ARM ROW's stored one:
  // `rlElemName[slot] == refArrElemName(a)` at 31 corpus and 151 fuzz calls, 0
  // disagreements — the row stores the very spelling the parse produced.
  const mems: i32[] = []
  if !unionArmMemberTys(name, mems) { return -1 }
  let i = 0
  while i < mems.length {
    const slot = unMemRefArrArmSlot(mems[i])
    if slot >= 0 && rlElemKindTbl[slot] == 2 {
      if elemAtom == "" { return slot }
      const en = rlElemName[slot]
      const eAtoms: string[] = []
      unionArmsOf(en, eAtoms)
      let j = 0
      while j < eAtoms.length {
        if eAtoms[j] == elemAtom { return slot }
        // R3's BOXED-MEMBER rule, at the arm's STORED element spelling. A litunion-ALIAS
        // member of a value union rides the box AS the `string` atom (`K|i32` boxes an
        // "a" with the string tag), and since the owner ruling of 2026-07-29 the stored
        // spelling PRESERVES the alias instead of widening it to `string`. The caller's
        // probe can only ever name the BOXED atom — it classifies a string element as
        // "string", never as `K` — so without this leg a `(K | i32)[]` arm is invisible
        // to a string-element literal, the routing returns -1 and the literal falls to
        // the value-atom LADDER, which stores a RAW string-list wrapper into the
        // box-typed slot: invalid wasm ("expected (ref null $type), found i32").
        if elemAtom == "string" && nameIsLitUnionType(eAtoms[j]) { return slot }
        j = j + 1
      }
    }
    i = i + 1
  }
  -1
}

// The interned reflist SLOT of an ARRAY-OF-MAP arm of the union member-set `name`
// (`{[string]: i64}[] | f64`) whose element MAP's value rep matches the literal
// element's map shape `mvShape` (canonical rep — `mvCanonRepOf`; mono matches mono),
// or -1 when no arm matches. `emitUnionCoerce` routes an array literal whose elements
// are MAP exprs (`[h0]` — invisible to `exprRefArray`, so the ref-array carrier path
// misses) into the arm's build + tag through this; an unmatched literal keeps the
// loud reject.
export function unionRefArrayArmSlotForMapElem(name: string, mvShape: i32) {
  if mvShape < -1 { return -1 }
  // D-UNION / D-UARMSLOT: the arm SHAPE test is `unMemIsMapArray` (a `TyArray` over a
  // `TyMap` — the `nameIsMapMemberUnion` exclusion is free structurally, a map-member
  // UNION element being a `TyUnion`), the arm ROW is `unMemRefArrArmSlot`, and the
  // arm's map-VALUE slot is the ref-list layer's own chokepoint `rlElemMapValMvSlot`
  // — whose name fall-through IS the `mvSlotOfMapValNameOrMono(mapValNameOf(...))`
  // this site used to spell out, tri-state discipline included.
  const mems: i32[] = []
  if !unionArmMemberTys(name, mems) { return -1 }
  let i = 0
  while i < mems.length {
    if unMemIsMapArray(mems[i]) {
      const slot = unMemRefArrArmSlot(mems[i])
      if slot >= 0 && slot < rlElemKindTbl.length && rlElemKindTbl[slot] == 3 {
        const armMv = rlElemMapValMvSlot(slot)
        if armMv == -1 && mvShape == -1 { return slot }
        if armMv >= 0 && mvShape >= 0 {
          if mvCanonRepOf(armMv) == mvCanonRepOf(mvShape) { return slot }
        }
      }
    }
    i = i + 1
  }
  -1
}

// The interned reflist SLOT of the SINGLE NESTED-ARRAY arm of the union member-set
// `name` (`string[][] | string`, `i64[][] | boolean | null` — an arm whose element is
// itself a list, kinds 4/6/7/8/9/10), or -1 when the union has no such arm OR more
// than one (an ambiguous route stays the loud reject — the checker cannot disambiguate
// which arm a bare nested literal meant here). `emitUnionCoerce` routes an ArrayLit
// carrier through this arm's OWN build (`pendingListKind = 1` + the arm's slot, the
// same threading an annotated `T[][]` binding uses), so the inner lists build the
// ARM's leaf — an `i64[][]` arm widens bare-int leaves at the store (`emitExprAsI64`),
// a `string[][]` arm builds string inner lists — where the literal's SELF-classified
// slot (`i32[][]`, or no ref classification at all for a string/f64-leaf literal)
// either mismatched the arm (the old loud reject) or fell through toward the scalar
// value-atom ladder (nested reject).
export function unionNestedArrayArmSlot(name: string) {
  // D-UARMSLOT: the arm rows come off the recorded member types. The D-UNION note this
  // replaced said the arena's `unMemIsRefElemArray` is a strict SUPERSET of
  // `nameIsRefArray` and that an inert over-accept is still not an equality — which is
  // why the migrated form asks `unMemRefArrArmSlot` (does a ROW exist for the member's
  // element) rather than the shape predicate, and why the equality was measured.
  const mems: i32[] = []
  if !unionArmMemberTys(name, mems) { return -1 }
  let found = -1
  let n = 0
  let i = 0
  while i < mems.length {
    const slot = unMemRefArrArmSlot(mems[i])
    if slot >= 0 && slot < rlElemKindTbl.length {
      const k = rlElemKindTbl[slot]
      if k == 4 || k == 6 || k == 7 || k == 8 || k == 9 || k == 10 {
        found = slot
        n = n + 1
      }
    }
    i = i + 1
  }
  if n == 1 { return found }
  -1
}

// True if the union member-set `name` has an ARRAY-OF-MAP arm (`{[string]: V}[]`).
// The frame pre-pass consults this (via `unionMapArrayElemIndex`) to reserve the map
// scratch for a `t[i][k]` read on a union binding narrowed to its map-array arm — the
// narrowing is not active in that pass, so the map op must be spotted from the
// binding's DECLARED union (the map-array twin of `unionHasMapArm`).
export function unionHasMapArrayArm(name: string) {
  const atoms: string[] = []
  // D-UNION: a `TyArray` over a `TyMap` (`unMemIsMapArray`). The name path's
  // `!nameIsMapMemberUnion(elem)` guard is free structurally — a map-member UNION
  // element is a `TyUnion`, never a `TyMap`, however it renders.
  const mems: i32[] = []
  if unionArmTys(name, atoms, mems) {
    let m = 0
    while m < mems.length {
      if unMemIsMapArray(mems[m]) { return true }
      m = m + 1
    }
    return false
  }
  let i = 0
  while i < atoms.length {
    const a = atoms[i]
    if a != "null" && nameIsArray(a) {
      const en = refArrElemName(a)
      if nameIsBareMap(en) { return true }
    }
    i = i + 1
  }
  false
}

// True if `exprIx` is an INDEX read (`t[i]`) whose array indexes an IDENT declared as
// a union with an ARRAY-OF-MAP arm — the receiver shape (`t[i][k]` / `t[i][k] ?? d` /
// `t[i].has(k)` after an `is {[string]: V}[]` narrow) the frame pre-pass reserves the
// map scratch for. Narrowing-blind, like `unionMapArmIdent`. (An over-reservation is a
// harmless spare local, never invalid wasm.)
export function unionMapArrayElemIndex(exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Index {
    const arr = P.nodes[unwrapParen(e.idxArr)]
    if arr is Ident {
      const un = unionNameOfIdent(arr.identName, fnIx)
      if un != "" { return unionHasMapArrayArm(un) }
    }
  }
  false
}

// The inferred `T|null` union name of the null-init `LetDecl` at `letIx`, or "".
export function nliNameOf(letIx: i32) {
  let i = 0
  while i < nliLetIxs.length {
    if nliLetIxs[i] == letIx { return nliNames[i] }
    i = i + 1
  }
  ""
}

// The value-union NAME an un-annotated if-EXPRESSION binding init carries (`const x =
// if c then 5 else null` → `i32|null`, the else-less `if c then 5` → `i32|null`, `if c
// then 5 else "hi"` → `i32|string`), or "" when it is not a value union the box can hold
// (a non-union `if c then 5 else 6`, a `string | null` niche, or an arm the static pre-
// pass cannot classify). The canonical name is the deduped arm atoms (arm order) with a
// trailing `|null` when any arm / the else-less path is null.
export function ifExprNliName(ifIx: i32) {
  const atoms: string[] = []
  const hn = ifExprCollectAtoms(ifIx, atoms)
  if hn == -2 { return "" }
  if atoms.length == 0 { return "" }
  // Mixed NUMERIC arms WIDEN to a single numeric (`i32` + `f64` → `f64`, #490) — they
  // are not a union, and this static atom list cannot do that lattice join. Bail so the
  // numeric value-position-if path (`letIsF64`/`letIsI64`) handles them. A SINGLE numeric
  // scalar (optionally + null, + a non-numeric like `string`) is fine.
  let numCount = 0
  let j = 0
  while j < atoms.length {
    const k = valueAtomKind(atoms[j])
    if k == 0 || k == 3 || k == 4 || k == 5 { numCount = numCount + 1 }
    j = j + 1
  }
  if numCount >= 2 { return "" }
  let nm = ""
  let i = 0
  while i < atoms.length {
    if nm != "" { nm = nm + "|" }
    nm = nm + atoms[i]
    i = i + 1
  }
  if hn == 1 { nm = nm + "|null" }
  // Only a value union the box rep can hold (≥2 non-null atoms, or one NUMERIC scalar +
  // null) registers here — a `string | null` niche / a non-union stay on their own paths.
  if !isValueUnionName(nm) { return "" }
  nm
}

// The per-union table index that OWNS global variant `vi` (the union whose variant
// slice contains it), or -1. Mirrors the `structIndexByName`-style resolver.
function unionOfVariant(vi: i32) {
  let u = 0
  while u < unNames.length {
    const start = unVarStart[u]
    if vi >= start && vi < start + unVarCount[u] { return u }
    u = u + 1
  }
  -1
}

// The position of variant struct `name` in `uVariants` (its heap-type is
// `uVarHeap[pos]`), or -1 if `name` is not a variant of the declared union.
export function variantIndexOf(name: string) {
  let i = 0
  while i < uVariants.length {
    if uVariants[i] == name { return i }
    i = i + 1
  }
  -1
}

// True if the type-name `name` is ANY declared union alias.
export function isUName(name: string) {
  let u = 0
  while u < unNames.length {
    if unNames[u] == name { return true }
    u = u + 1
  }
  false
}

// The union alias name that owns global variant `vi` (assumes `vi` is a variant of some
// declared union), or "" if none. Used to intern a ref-list-of-union by the SPECIFIC
// union (so `Node[]` and `Ty[]` are distinct table slots).
function unionNameOfVariant(vi: i32) {
  const u = unionOfVariant(vi)
  if u >= 0 { return unNames[u] }
  ""
}

// The wasm struct field index of `field` within variant `vi` (declaration order), or
// -1 if that variant has no such field.
export function variantFieldIndex(vi: i32, field: string) {
  const start = uFieldStart[vi]
  const cnt = uFieldCount[vi]
  let j = 0
  while j < cnt {
    if uFieldNames[start + j] == field { return j }
    j = j + 1
  }
  -1
}

// True if the function `name` declares the struct as its return type (flat lookup
// over the stored kind `buildFnMap` recorded — no arena rescan).
function fnRetStructSid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "struct"
}

// True if the parameter `name` of function `fnIx` is the struct type.
function paramStruct(fnIx: i32, name: string) {
  const pt = paramTypeNode(fnIx, name)
  // STRUCTURAL fast-path (C1): a recorded declared-struct param, else the name test.
  if nodeTyIsStruct(pt) { return true }
  false
}

// True if evaluating the expression at `exprIx` yields the struct (a `(ref $0)`):
// an object literal (constructs it), a struct-returning call, a struct param/local
// reference, or a parenthesized struct expression. Anything else is an i32 value.
export function exprStruct(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is ObjLit { return true }
  if e is Paren { return exprStruct(e.parInner, fnIx) }
  // An if-EXPRESSION whose branch join is a struct — an un-annotated binding classifies kind 1
  // (the THEN arm's rep, the arms agreeing by the checker), matching `structIndexOfExpr`.
  if e is IfStmt {
    const tv = ifThenValueIx(exprIx)
    return tv >= 0 && exprStruct(tv, fnIx)
  }
  // A `m[k] ?? default` over a STRUCT-valued map (`{[string]: S}`) yields the value struct — so a
  // bound `const p = m[k] ?? d` classifies as a struct local and `(m[k] ?? d).x` resolves.
  // A NULLABLE-value slot (`{[string]: S | null}`) yields `S | null` instead (a stored null is
  // PRESERVED through `??`) — `exprNullableStruct` claims it, not this non-null arm.
  if e is BinExpr {
    const cms = coalesceMvSlot(exprIx, fnIx)
    if cms >= 0 {
      // A nullable-value slot with a NON-null default coalesces to the non-null struct too
      // (stored null included) — only a nullable default leaves it `S | null`.
      return mvValKind[cms] == 1 && !coalesceStaysNullable(exprIx, cms, fnIx)
    }
    // A `<S|null> ?? <S>` coalesce yields the non-null struct (the generic nullable-struct `??` emit) —
    // so a bound `const p = r ?? d` classifies struct and `(r ?? d).x` resolves. The left is the
    // nullable struct; the right is a plain struct default.
    if e.binOp == "??" {
      if exprNullableStruct(e.binLeft, fnIx) { return true }
      return exprStruct(e.binRight, fnIx)
    }
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if fnRetStructSid(sidOfNode(e.callFn)) { return true }
      // A struct-returning function VALUE (a binding / `(i32) => S` param callee): its
      // resolved `>sN;` sig (mirrors `structIndexOfExpr`'s closure case). Falls through to the
      // per-node-type fallback below when the sig path misses (a factory-inferred value).
      if calleeReturnsStructIdxSid(sidOfNode(e.callFn), fnIx) >= 0 {
        return true
      }
    }
    // A FIELD-CLOSURE call (`(a."*")(2)` — a rewritten operator/index trap)
    // yields the field function's return struct (mirrors `structIndexOfExpr`).
    if callee is Member {
      if (
        drwFieldClosure(structIndexOfExpr(callee.memObj, fnIx), callee.memProp)
      ) {
        const cfe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
        if cfe >= 0 {
          if fRetKind[cfe] == "struct" { return true }
        }
      }
    }
    // FALLBACK (scoped to a CALL): a struct-returning closure value call whose callee the cases above
    // miss — an INDEXED closure-array element (`arr[i](x)`) or a factory-inferred value. The cheap
    // NO-RENDER `nodeTyIsObj` reads the checker's per-node type. Boolean dual of `structIndexOfExpr`'s
    // fallback, so `letIsStruct` classifies such a binding (kind 1) and its field reads resolve.
    return nodeTyIsObj(exprIx)
  }
  if e is Ident {
    if paramStruct(fnIx, e.identName) { return true }
    if declaredStruct(e.identName) { return true }
    // A CAPTURED struct: the env field IS the struct ref (`captureValKind` sized it that
    // way), so classify it like a struct param/local — the fourth storage class, and the one
    // this arm never grew. `capturedStructIndex` already supplies the HEAP TYPE to
    // `structIndexOfExpr`, so the layout resolved while the boolean question answered no: a
    // lambda whose body is a bare captured struct had its `$fnsig` result minted i32
    // (`fRetKind` fell through) over a body returning `(ref $S)`, and the two functypes for
    // one function are invalid wasm.
    if capturedKindOf(fnIx, e.identName) == "struct" { return true }
    return globalIsStructSid(sidOfNode(exprIx))
  }
  // `xs[i]` over a STRUCT-element ref list yields the struct (G7-ref). Per-slot: the
  // element kind comes from the receiver's distinct ref-list slot (1 = struct).
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      // GUARD the slot (a narrowed union-arm rebind receiver can classify
      // `exprRefArray` true while the slot resolver misses — OOB otherwise).
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot < 0 || slot >= rlElemKindTbl.length { return false }
      return rlElemKindTbl[slot] == 1
    }
  }
  // A NULLABLE struct value (`S | null`) participates in the struct machinery
  // (member layout resolution); the field-read path inserts the non-null recover.
  exprNullableStruct(exprIx, fnIx)
}

// True if the already-collected declared local `name` is a nullable struct (code 9).
function declaredNulRef(name: string) { declaredKind(name) == "nulstruct" }

// True if `name` is a declared NULLABLE function-value local (`fn | null`, kind 19) — the
// closure dual of `declaredNulRef`.
function declaredNulClosure(name: string) { declaredKind(name) == "nulclosure" }

// True if the expression at `exprIx` is a NULLABLE function value (`fn | null`, kind 19) —
// currently a kind-19 local ident. Drives the `== null` / `!= null` test (`ref.is_null`)
// and the narrowed-call recover, the closure analogue of `exprNullableStruct`.
export function exprNulClosure(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const ux = unwrapParen(exprIx)
  const e = P.nodes[ux]
  if e is Ident {
    if paramNulClosure(fnIx, e.identName) { return true }
    if declaredNulClosure(e.identName) { return true }
    // A module-global nullable-closure cell (kind 19).
    const gl = globalLetOf(e.identName)
    if gl >= 0 { return globalCellKind(gl) == "nulclosure" }
    return false
  }
  // A CALL of a function whose return type is a nullable closure (`mk()` where `mk:
  // (…) => (fn | null)`): the result is the kind-19 niche `(ref null $cloStruct)`. A named
  // function reads its `fnRet`; a closure-typed VALUE callee reads its return-type annotation
  // (`calleeCloRetName`). Drives the local-kind inference (`const f = mk()`) and the `f !=
  // null` compare, the closure analogue of `exprNullableStruct`'s call classification.
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const t = fnIndexOfSid(sidOfNode(e.callFn))
      if t >= 0 {
        const cfn = P.nodes[fnStmts[t]]
        if cfn is FuncDecl { return nulCloFlag(cfn.fnRet) == 1 }
      }
      if nameIsNulClosure(calleeCloRetName(callee.identName, fnIx)) {
        return true
      }
    }
    // An INDEXED closure-array element call (`v[0](1)` over a `((i32) => (fn | null))[]`)
    // or a struct-FIELD closure call whose resolved `$fnsig` result is the
    // nullable-closure niche (`>C`): the result is the kind-19 `(ref null $cloStruct)`,
    // so `const f = v[0](1)` binds the niche and `f != null` narrows — the same
    // `cloCallSigKey` resolution the call emit casts with, so the two always agree.
    return sigKeyRetKind(cloCallSigKey(ux, fnIx)) == "nulclosure"
  }
  // A nullable-closure struct FIELD read (`recv.op` over a `((i32) => i32) | null` field,
  // code 22): the raw `(ref null $cloStruct)` — its `!= null` lowers to `ref.is_null` and
  // the narrowed call recovers non-null (`ref.as_non_null`) at the call site.
  if e is Member { return memberFieldCode(ux, fnIx) == 22 }
  // A bare `m[k]` over a FUNCTION-valued map (mv kind 14) reads back a NULLABLE closure
  // `(ref null $cloStruct)` — `const f = m[k]` binds the kind-19 niche, narrowed `if f != null`.
  if e is Index {
    // Indexing a `(((i32) => boolean) | null)[]` (a kind-5 ref list whose element slot keeps
    // the `| null`) yields a NULLABLE closure — the read left it `(ref null $cloStruct)`, so
    // `const f = xs[i]; if f != null` narrows. The closure dual of `exprNullableList`'s arm.
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemNullable.length {
        if rlElemKindTbl[slot] == 5 && rlElemNullable[slot] == 1 { return true }
      }
    }
    const mrs = mapReadMvSlot(ux, fnIx)
    if mrs >= 0 { return mvValKind[mrs] == 14 }
  }
  // A `m[k] ?? d` read over a NULLABLE-closure-valued map (`{[string]: (() => T) | null}`)
  // stays nullable ONLY when the default is itself nullable; a non-null default coalesces
  // every null (stored included) to the non-null closure — the closure dual of
  // `exprNullableStruct`'s coalesce arm.
  if e is BinExpr {
    const cns = coalesceMvSlot(ux, fnIx)
    if cns >= 0 {
      return mvValKind[cns] == 14 && coalesceStaysNullable(ux, cns, fnIx)
    }
  }
  false
}

// True if an UN-annotated `const f = <init>` should infer a NULLABLE-closure (kind 19) slot —
// its init reads back a nullable closure (a bare `m[k]` over a function-valued map). The
// annotated form is `letIsNulClosure`; this is its init-driven dual (it lives here, not in
// `emit_query`, because it consults the wasmEmit-side `exprNulClosure`).
export function letInfersNulClosure(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return false }
    if d.letInit < 0 { return false }
    return exprNulClosure(d.letInit, fnIx)
  }
  false
}

// True if the already-collected declared local `name` is a nullable i32 list (kind 15).
function declaredNulList(name: string) { declaredKind(name) == "nullist" }

// True if the already-collected declared local `name` is a struct ref. Resolves to
// the IN-SCOPE binding's slot (so a same-named binding in a sibling/inner block reads
// ITS own valtype, not an unrelated branch's).
function declaredStruct(name: string) { declaredKind(name) == "struct" }

// True if the `LetDecl` at `letIx` declares a struct-typed local: its annotation
// names the struct, OR its initializer produces the struct. Picks the local's
// valtype (`(ref $0)` vs i32) in `collectLocals`.
// True if the binding's annotation is a SINGLE inline object shape (`{ … }`, with a trailing `| null`
// stripped) that is NOT interned as a struct — i.e. its shape could not be built (an unsupported field
// type). A map (`{[…]}`) is excluded. Checked only AFTER union / nullable-struct / struct classification,
// so a valid inline-struct binding never reaches it; this catches the un-internable remainder so it
// rejects cleanly instead of mis-emitting its object literal (a soundness guard).
export function letAnnIsUninternedShape(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType < 0 { return false }
    const nm = nonNulBaseOf(tyNameOf(d.letType))
    if !nameIsShapeSpanEnds(nm) { return false }
    return structIndexByName(nm) < 0
  }
  false
}

export function letIsStruct(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        if isSName(lt.tyName) { return true }
      }
    }
    return exprStruct(d.letInit, fnIx)
  }
  false
}

// True if the `LetDecl` at `letIx` binds a CONCRETE union-VARIANT value (`const c: Cat =
// …` where `Cat` is a variant of the declared union) — a kind-8 local `(ref
// $(uVarHeap[vi]))`, distinct from the union box (kind 4) and a standalone struct (kind 1). Annotation
// first, else the init's variant value (a variant param/local read). Checked AFTER the
// struct/union local cases so only an explicit variant annotation / variant-valued init
// reaches here.
// True if the `LetDecl`'s init produces a PLAIN-STRUCT TWIN of a variant arm (a call /
// literal built as the plain struct — its own interned heap, a layout TWIN of but DISTINCT
// heap from the arm's variant struct), NOT a genuine kind-8 variant ref. Such a value is
// RE-BOXED into the union (`emitStructExprAsVariantBox`, #1005) at whatever boundary later
// consumes it, so the binding must NOT be a variant local `(ref $variant)`:
//   - a UNION-annotated binding falls through to the union BOX (kind 4);
//   - an UN-annotated binding (`const s = mk3(); return s`, mk3 returning the PLAIN struct)
//     falls through to a plain STRUCT (kind 1) — the value IS a plain struct at this point;
//     only its later flow into a union (return/arg/field) reboxes.
// A genuine variant-REP init (a kind-8 variant local/param, a `: Cat`-returning call)
// resolves `structIndexOfExpr < 0` and is left as a raw variant — untouched.
function letInitReboxesToVariant(letIx: i32, fnIx: i32): boolean {
  const d = P.nodes[letIx]
  if d is LetDecl {
    // When ANNOTATED, only a `{…} | scalar` UNION annotation qualifies (a plain-struct /
    // variant-name annotation is authoritative and handled by `letIsVariant`'s annotation
    // arm). An UN-annotated binding (`letType < 0`) is driven purely by the init's shape.
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if !(lt is TypeRef) { return false }
      if !isUName(lt.tyName) { return false }
      if nodeTyIsLitUnionAlias(d.letType) { return false }
    }
    // A genuine variant-REP init (a kind-8 variant local/param, a `: Cat`-returning call)
    // resolves `structIndexOfExpr < 0` and stays raw + boxes at the boundary; only a PLAIN-
    // STRUCT TWIN of an arm (a call / literal built as the plain struct — a DISTINCT heap)
    // reboxes, so the binding must not be a variant `(ref $variant)` that would receive the
    // box `(ref $uBox)` (annotated) or the raw plain struct (un-annotated — invalid wasm).
    const vi = exprVariantIndex(d.letInit, fnIx)
    if vi < 0 || vi >= uVarHeap.length { return false }
    const ssi = structIndexOfExpr(d.letInit, fnIx)
    // `structIndexOfExpr` returns a VARIANT index (not a struct-table index) for a genuine
    // variant-returning call — bound to the struct table so it is never misused as one (a
    // variant-REP init stays raw; only a plain-struct twin reboxes).
    if ssi < 0 || ssi >= sHeapIdx.length { return false }
    return sHeapIdx[ssi] != uVarHeap[vi]
  }
  false
}

export function letIsVariant(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        if variantIndexOf(lt.tyName) >= 0 { return true }
      }
    }
    // A plain-struct-TWIN init (`const t: {w:i32}|i32 = mkS()`, mkS returning the PLAIN
    // struct) matches a variant arm by SHAPE via `exprVariantIndex` but its value is RE-
    // BOXED into the union — so it must bind the union BOX, not a variant. A genuine
    // variant-REP init is untouched (see `letInitReboxesToVariant`).
    if letInitReboxesToVariant(letIx, fnIx) { return false }
    return exprVariantIndex(d.letInit, fnIx) >= 0
  }
  false
}

// The union-variant table index a variant-typed `LetDecl` binds (annotation first, else
// the init's variant value), or -1.
export function variantIndexOfLet(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        const vi = variantIndexOf(lt.tyName)
        if vi >= 0 { return vi }
      }
    }
    // Mirrors `letIsVariant`: a plain-struct-twin init reboxes into the union box (kind 4),
    // so it resolves NO concrete variant index.
    if letInitReboxesToVariant(letIx, fnIx) { return -1 }
    return exprVariantIndex(d.letInit, fnIx)
  }
  -1
}

// ── multi-struct index resolution ─────────────────────────────────────────────
// Parallel to the boolean `exprStruct` family, these return the STRUCT TABLE INDEX a
// struct-typed expression / param / local / return produces, so a field read/write
// can resolve the right heap type + field layout. Return -1 when not a struct.

// The struct table index of the param `name` of function `fnIx` (from its annotation),
// or -1.
function paramStructIndex(fnIx: i32, name: string) {
  if fnIx < 0 {
    return -1 // module-scope initializer (no enclosing function)
  }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const params = fn.fnParams
    let i = 0
    while i < params.length {
      const p = P.nodes[params[i]]
      if p is Param {
        if p.parName == name {
          if p.parType >= 0 {
            const ty = P.nodes[p.parType]
            if ty is TypeRef {
              // A plain struct name, or the `S | null` nullable BASE. (NOT a union
              // variant — a variant-typed param rides the gap-#2 path, and its
              // VARIANT index must not leak into the struct tables.)
              const psi = structIndexByName(ty.tyName)
              if psi >= 0 { return psi }
              const pnb = nulBaseStructRow(p.parType, ty.tyName)
              if pnb >= 0 { return pnb }
            }
          }
          return -1
        }
      }
      i = i + 1
    }
  }
  -1
}

// The union-variant table index of the param `name` of function `fnIx` (when its
// annotation names a VARIANT struct of the declared union, e.g. `o: TyObj`), or -1.
// A variant-struct param's value IS the concrete variant struct ref `(ref
// $(uVarHeap[vi]))` — already narrowed/unboxed by the caller — so a field read on it reads the
// variant struct directly (no box unwrap), the gap-#2 boundary.
function paramVariantIndex(fnIx: i32, name: string) {
  variantIndexOf(tyNameOf(paramTypeNode(fnIx, name)))
}

// The union-variant table index an expression at `exprIx` yields a CONCRETE variant
// struct ref for (a variant-typed param reference, or a parenthesized one), or -1. The
// receiver shape for a gap-#2 field read `o.field` where `o: TyObj`.
export function exprVariantIndex(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[exprIx]
  if e is Paren { return exprVariantIndex(e.parInner, fnIx) }
  if e is Ident {
    const pvi = paramVariantIndex(fnIx, e.identName)
    if pvi >= 0 { return pvi }
    return declaredVariantIndex(e.identName)
  }
  // A call to a `: Cat`-returning function yields the concrete variant ref.
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident { return fnRetVariantIndexSid(sidOfNode(e.callFn)) }
  }
  // An index into a `Cat[]` variant-element ref list yields the bare variant struct.
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const ren = refListElemNameOfExpr(e.idxArr, fnIx)
      // A PLAIN-STRUCT element list (`{f: boolean}[]`) whose element SHAPE also matches a
      // VALUE-union's struct member (`{f: boolean} | string`) must NOT read through that
      // union's variant heap (`uVarHeap`) — the array physically holds the plain struct
      // (its own `sHeapIdx`), a DISTINCT heap type from the box member, so `struct.get
      // uVarHeap[vi]` reads a `(ref plain)` as `(ref variant)` (INVALID-WASM: fuzz sweep
      // F5gJXz multiobs seed, `{f: (…{f:boolean}…)[], z: {f:boolean}[]}` at `v.z[0].f`).
      // Only a GENUINE concrete-variant element list (`Cat[]`, whose element name is NOT a
      // registered plain struct) resolves through the variant heap here.
      if structIndexByName(ren) < 0 { return variantIndexOf(ren) }
    }
  }
  -1
}

// The union-VARIANT table index a function `name` returns (its `: Cat` return
// annotation), or -1.
function fnRetVariantIndexSid(sid: i32) {
  const fe = fnIndexOfSid(sid)
  if fe >= 0 {
    const fn = P.nodes[fnStmts[fe]]
    if fn is FuncDecl {
      if fn.fnRet >= 0 {
        const rt = P.nodes[fn.fnRet]
        if rt is TypeRef { return variantIndexOf(rt.tyName) }
      }
    }
  }
  -1
}

// The union-variant table index of the declared local `name` (a kind-8 variant local —
// its `localStructIdx` holds the variant index), or -1.
function declaredVariantIndex(name: string) {
  const slot = declaredSlotOf(name)
  if slot < 0 { return -1 }
  if localIsRef[slot] == "variant" { return localStructIdx[slot] }
  -1
}

// The struct table index of the declared local `name` (recorded in `localStructIdx`),
// or -1 if `name` is not a struct local.
function declaredStructIndex(name: string) {
  const slot = declaredSlotOf(name)
  if slot < 0 { return -1 }
  if localIsRef[slot] == "struct" { return localStructIdx[slot] }
  if localIsRef[slot] == "nulstruct" { return localStructIdx[slot] }
  -1
}

// The struct table index a function `name` returns (recorded in `fRetStructIdx`), or -1.
function fnRetStructIndexSid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return -1 }
  fRetStructIdx[i]
}

// The struct table index of a module global `name` (from its annotation/initializer),
// or -1.
function globalStructIndexSid(sid: i32) {
  const li = globalLetOfSid(sid)
  if li < 0 { return -1 }
  structIndexOfLet(li, -1)
}

// The struct table index that the expression at `exprIx` produces, or -1 if it is not
// a struct value. Mirrors `exprStruct`'s cases.
// The struct table index of a CAPTURED struct-ref variable `name` of the capturing
// lifted function `fnIx`, or -1 if `name` is not a captured struct of `fnIx`. Mirrors
// `emitCapturedRead`'s guards so a captured struct receiver (`p.x` where `p` is a
// captured `{ … }` in an enclosing frame) resolves to its struct type exactly as a
// param/local/global receiver would — the value itself is read from the env by
// `emitCapturedRead`; this only supplies the heap type so `emitMem` can pick the field.
//
// IT CARRIES NO `fnEnvIdxOf` GUARD, for the reason spelled out on `capturedKindOf`: that
// index is minted by `mAssignTypeIndices`, which runs AFTER every classification pass, so
// gating on it makes this answer -1 for the whole of `computeRetInference`. A lambda whose
// body is a bare captured struct then had its kind classified `"struct"` (via `exprStruct`'s
// capture arm) while its `fRetStructIdx` stayed -1 — `emitProgram: ref valtype with no
// interned shape`, with everything in sight annotated. The guard is redundant besides:
// `fnEnvIdxOf(fe) >= 0` holds exactly when `captureCountOf(fe) > 0`, which the scan below
// decides for itself.
function capturedStructIndex(fnIx: i32, name: string) {
  if fnIx < 0 { return -1 }
  if !fnValUsed { return -1 }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return -1 }
  const caps = captureNamesOf(fe)
  let ci = 0
  while ci < caps.length {
    if caps[ci] == name { return captureValStructIdx(fe, name) }
    ci = ci + 1
  }
  -1
}

// True if the CAPTURED variable `name` of the capturing lifted function `fnIx`
// is BOOLEAN-typed in the parent frame (a `boolean` param annotation, a
// `boolean`-annotated let, or a bool-literal init). Bool rides in an i32, so
// `capturedKindOf` cannot carry it — this is the print/`fRetBool` side channel.
function capturedIsBool(fnIx: i32, name: string) {
  if fnIx < 0 { return false }
  if !fnValUsed { return false }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return false }
  const caps = captureNamesOf(fe)
  let isCap = false
  let ci = 0
  while ci < caps.length {
    if caps[ci] == name { isCap = true }
    ci = ci + 1
  }
  if !isCap { return false }
  const b = parentBindingOf(fe, name)
  if b < 0 { return false }
  const bn = P.nodes[b]
  if bn is Param { return tyNameOf(bn.parType) == "boolean" }
  if bn is LetDecl {
    if bn.letType >= 0 { return tyNameOf(bn.letType) == "boolean" }
    if bn.letInit >= 0 {
      const iv = P.nodes[unwrapParen(bn.letInit)]
      if iv is BoolLit { return true }
    }
  }
  false
}

// The VALUE KIND of a CAPTURED variable `name` of the capturing lifted function
// `fnIx` (the same `fbValtype` codes `captureValKind` types the env field with),
// or `null` if `name` is not a captured variable of `fnIx`. The classifier-side
// mirror of `capturedStructIndex` — an expression classifier (`exprArray` & co) types
// a captured list/string/scalar read exactly as a param/local/global receiver.
//
// IT CARRIES NO `fnEnvIdxOf` GUARD, and that is what makes it answerable to the
// RETURN-KIND passes. `fnEnvIdx` is minted by `mAssignTypeIndices`, which runs after
// every classification pass, so gating on it made this silently answer `null` for the
// whole of `computeRetInference` — and a nested function whose result type is decided
// by its captures (`function g() { a + b }` over two captured strings) was inferred
// `i32` while its body emitted the concat, which is invalid wasm with everything in
// sight annotated. The guard was redundant besides: `fnEnvIdxOf(fe) >= 0` holds
// exactly when `captureCountOf(fe) > 0`, which the scan below decides for itself.
function capturedKindOf(fnIx: i32, name: string): VKind | null {
  if fnIx < 0 { return null }
  if !fnValUsed { return null }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return null }
  const caps = captureNamesOf(fe)
  let ci = 0
  while ci < caps.length {
    if caps[ci] == name { return captureValKind(fe, name) }
    ci = ci + 1
  }
  null
}

// The union member-set NAME of a CAPTURED union-box variable `name` (kind 4) of the capturing
// function `fnIx` — resolved from the PARENT frame's binding annotation / init, so `a is Cat`
// narrows a captured `a: Cat | Dog`. "" when `name` is not a captured union. The union-name
// dual of `capturedStructIndex`.
function capturedUnionName(fnIx: i32, name: string) {
  if capturedKindOf(fnIx, name) != "union" { return "" }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return "" }
  const b = parentBindingOf(fe, name)
  if b < 0 { return "" }
  const bn = P.nodes[b]
  if bn is Param {
    const pn = tyNameOf(bn.parType)
    if isUName(pn) { return pn }
    return ""
  }
  if bn is LetDecl {
    const par = fnParent[fe]
    if par >= 0 { return letUnionNameOf(b, fnStmts[par]) }
  }
  ""
}

export function structIndexOfExpr(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[exprIx]
  if e is ObjLit { return structIndexOfObjCtx(exprIx, fnIx) }
  if e is Paren { return structIndexOfExpr(e.parInner, fnIx) }
  // An if-EXPRESSION whose join is a struct (`const b = if c { mk(1) } else { mk(2) }`): the
  // THEN arm's struct index classifies the whole `if` (the checker proved the arms agree), so an
  // un-annotated binding resolves the same struct heap type the `emitIfExprRef` join emits.
  if e is IfStmt {
    const tv = ifThenValueIx(exprIx)
    if tv >= 0 { return structIndexOfExpr(tv, fnIx) }
  }
  // A `m[k] ?? default` over a STRUCT-valued map resolves to the value type's struct index (the
  // mv slot's `mvValStructIdx`), so the field-read layout is found.
  if e is BinExpr {
    const cms = coalesceMvSlot(exprIx, fnIx)
    if cms >= 0 {
      if mvValKind[cms] == 1 { return mvValStructIdx[cms] }
    }
    // A `<S|null> ?? <S>` coalesce resolves to the (inner) struct index — so `(r ?? d).field` finds
    // the layout. The left's nullable struct drives it (its inner struct), else the right default.
    if e.binOp == "??" {
      const ls = structIndexOfExpr(e.binLeft, fnIx)
      if ls >= 0 { return ls }
      return structIndexOfExpr(e.binRight, fnIx)
    }
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const ri = fnRetStructIndexSid(sidOfNode(e.callFn))
      if ri >= 0 { return ri }
      // A struct-returning function VALUE (a binding / `(i32) => S` param callee, invisible
      // to `fnRetStructIndex`): the struct index from its resolved `>sN;` sig. Falls through to the
      // per-node-type fallback below when the sig path misses (a value INFERRED from a factory call —
      // `const g = mk()` — whose `>sN;` the syntactic path can't recover).
      const ci = calleeReturnsStructIdxSid(sidOfNode(e.callFn), fnIx)
      if ci >= 0 { return ci }
    }
    // A FIELD-CLOSURE call (`(a."[]")(i)` — a chained index trap whose "[]"
    // returns another trap object) yields the field function's return struct.
    if callee is Member {
      if (
        drwFieldClosure(structIndexOfExpr(callee.memObj, fnIx), callee.memProp)
      ) {
        const cfe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
        if cfe >= 0 {
          if fRetKind[cfe] == "struct" || fRetKind[cfe] == "nulstruct" {
            return fRetStructIdx[cfe]
          }
        }
      }
    }
    // `xs.pop()` / `xs.get(i)` over a struct-element ref list yield that list's
    // element struct (as `S | null` — see `structListPopGetElem`).
    const slv = structListPopGetElem(exprIx, fnIx)
    if slv >= 0 { return slv }
    // FALLBACK (scoped to a CALL): a struct-returning closure value call whose callee the cases above
    // miss — an INDEXED closure-array element (`arr[i](x).field`) or a value INFERRED from a factory
    // call (`const g = mk(); g(x).field`). Resolve the struct from the checker's per-node type: gate on
    // the cheap `nodeTyIsObj` (no render), then resolve the rendered inline shape to its declared index
    // by field-set match (`structIndexOfTypeName`). The struct dual of the union `nodeUnionName`
    // fallback, and the consumer half of the `cloCallSigKey` `nodeTyName` producer fallback. Off the
    // hot path — declared / param / field-closure struct receivers resolve syntactically above.
    if nodeTyIsObj(exprIx) {
      // Canonical alias-preserving render FIRST (`nodeTyCanonObjName`): the spaced
      // `nodeTyName` render flattens a litunion-ALIAS field, whose field text the
      // scan can't classify — it leniently matched the plain same-name-set twin row
      // (INVALID-WASM at the boxed-field read; fuzz sweep3 declared leg, seed
      // 128787380 case_00189).
      const snc = nodeTyCanonObjName(exprIx)
      if snc != "" {
        const sic = structIndexOfTypeName(snc)
        if sic >= 0 { return sic }
      }
      const sn = nodeTyName(exprIx)
      if sn != "" { return structIndexOfTypeName(sn) }
    }
    // The NULLABLE-struct dual: a `S | null`-returning closure value call (`arr[i](x)` over a
    // `((i32) => P | null)[]`) resolves to its INNER struct's layout index, so the kind-9 binding's
    // `!= null` narrow and field read find `P`. `nodeNulStructInnerName` renders only the inner shape.
    const nn = nodeNulStructInnerName(exprIx)
    if nn != "" { return structIndexOfTypeName(nn) }
    return -1
  }
  if e is Ident {
    const pi = paramStructIndex(fnIx, e.identName)
    if pi >= 0 { return pi }
    const di = declaredStructIndex(e.identName)
    if di >= 0 { return di }
    const gi = globalStructIndexSid(sidOfNode(exprIx))
    if gi >= 0 { return gi }
    return capturedStructIndex(fnIx, e.identName)
  }
  // `xs[i]` over a STRUCT-element ref list yields that list's element struct. The
  // element struct TABLE INDEX comes from the receiver's per-element-type slot's name
  // (`Tok[]` → `Tok` → its struct index), so distinct struct ref-lists resolve to
  // distinct struct types — not always heap-type 0.
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      let nm = refListElemNameOfExpr(e.idxArr, fnIx)
      // A NULLABLE-struct element (`(P | null)[]`, slot key "P | null") resolves to the bare
      // struct `P` — strip the `| null` so a narrowed `xs[i].field` finds P's layout. The
      // structural bridge (`structIndexOfTypeName`) then also resolves an INLINE-SHAPE
      // element (`{v:i32}[]` param) to its declared twin's layout.
      nm = nonNulBaseOf(nm)
      // Nominal exact-name match first (byte-identical; AFTER-not-FIRST, #1061).
      const sbn = structIndexByName(nm)
      if sbn >= 0 { return sbn }
      // NODE ROUTE (rep-intern P2): the element receiver `v[i]` (this Index node)
      // carries its adopted checked type — resolve its row through the canonical-key
      // vocabulary directly (`repRowOfTyStruct(nodeRepTyIxOf(exprIx))`, the read-side
      // dual of `structIdxOfElemName`). Distinguishes a same-fieldset nested twin by
      // the FULL nested field type, without leaning on `shapeFieldTypeCompat` arm 2's
      // whole-span refutation. Falls to the lenient fieldset scan when the node is
      // uncovered (`repRowOfTyStruct` returns -1: non-`TyObj`, no dedup row, or an
      // atom-vs-plain collision it must not guess through).
      const rr = repRowOfTyStruct(nodeRepTyIxOf(exprIx), sScanLim())
      if rr >= 0 { return rr }
      const si = structIndexOfTypeName(nm)
      if si >= 0 { return si }
    }
    // A BARE `m[k]` over a STRUCT-valued map resolves to the value type's struct index, so a
    // narrowed `(m[k]).field` finds the layout — the Index dual of the `?? default` BinExpr case.
    const mrs = mapReadMvSlot(exprIx, fnIx)
    if mrs >= 0 {
      if mvValKind[mrs] == 1 { return mvValStructIdx[mrs] }
    }
  }
  // A field read `o.inner` whose field is a NESTED STRUCT (code 15) yields the
  // field's target struct — so `o.inner.v` chains and `n.next` re-enters as `S|null`.
  if e is Member {
    const msi = structIndexOfExpr(e.memObj, fnIx)
    if msi >= 0 {
      const mfi = sFieldIndex(msi, e.memProp)
      if mfi >= 0 {
        if sFieldTypeAt(msi, mfi) == 15 { return sFieldTgtStructIdx(msi, mfi) }
      }
      return -1
    }
    // A NARROWED union member (`t0.f` after `is {f: {f: f32}}`) and a VARIANT-typed
    // receiver resolve through the VARIANT field tables — the code-15 twin of
    // `mapShapeOfExpr`'s Member dispatch (without it the struct-table miss returned -1
    // and the nested read had no layout). AFTER the struct probe, and only on its
    // receiver MISS: the struct path answers every plain receiver without paying the
    // narrow-key/variant resolution (`memIsNarrowed` builds a path-key string — hot).
    if memIsNarrowed(exprIx) {
      const nvi = memNarrowVariantIndex(exprIx)
      if nvi >= 0 {
        const nvfi = variantFieldIndex(nvi, e.memProp)
        if nvfi >= 0 {
          if variantFieldTypeAt(nvi, nvfi) == 15 {
            return uFieldTgtStructIdx(nvi, nvfi)
          }
        }
      }
    }
    const pvi = exprVariantIndex(e.memObj, fnIx)
    if pvi >= 0 {
      const pvfi = variantFieldIndex(pvi, e.memProp)
      if pvfi >= 0 {
        if variantFieldTypeAt(pvi, pvfi) == 15 {
          // DELIBERATELY NOT MIGRATED (destringify D5). The arena twin of this
          // lookup is `uFieldTgtStructIdx`, and it is used at every OTHER code-15
          // variant-field site — but this arm (a receiver that is variant-typed
          // WITHOUT being struct-resolvable, i.e. a declared variant NAME) fired on
          // ZERO corpus files and ZERO of 50,400 fuzz programs under a per-site
          // sabotage build. A declared variant rejects nested-struct fields
          // ("only i32 / boolean / string / array union-variant fields are
          // supported") and an inline-shape arm resolves through `structIndexOfExpr`
          // above, so the arm looks unreachable on today's surface. Unverifiable ⇒
          // unmigrated: it keeps the name path until a shape that reaches it exists.
          return structIndexByName(variantFieldElemName(pvi, pvfi))
        }
      }
    }
  }
  -1
}

// The struct table index a struct-typed `LetDecl` binds: from its annotation if
// present, else inferred from its initializer. -1 if not a struct local.
export function structIndexOfLet(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        const si = structIndexByName(lt.tyName)
        if si >= 0 { return si }
        // A NULLABLE annotation (`{n:i32} | null`, `Config | null`) resolves its
        // NON-NULL part — `collectAnnShapes` interns an inline shape under the
        // bare text (the `|null` wrapper stripped), and a named alias interns
        // under its own name. Needed when the initializer is a bare `null` (no
        // struct literal to infer the index from).
        const nb = nullablePartOf(lt.tyName)
        if nb != "" {
          const si2 = structIndexByName(nb)
          if si2 >= 0 { return si2 }
        }
      }
    }
    return structIndexOfExpr(d.letInit, fnIx)
  }
  -1
}

// ── union-typedness of expressions (G1) ───────────────────────────────────────
// Parallel to the struct family: decide whether an expression / param / local / let
// is the declared UNION (a `(ref $uBoxIdx)` boxed value). Unlike structs, an object
// literal's INTRINSIC type is its variant struct, NOT the union — boxing happens at a
// flow boundary (a `let n: U = …`, a union-returning `return`, a union-typed arg). So
// `exprUnion` is true for a union-returning call / union param / union local, but NOT
// a bare object literal (its boxing is driven by the EXPECTED type at the boundary).

// True if function `name` declares the union as its return type.
function fnRetUnionSid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "union"
}

// True if the parameter `name` of function `fnIx` is the union type.
function paramUnion(fnIx: i32, name: string) {
  const pt = paramTypeNode(fnIx, name)
  // STRUCTURAL fast-path (C1): a recorded declared value-union param, else the name test.
  if nodeTyIsUnionAlias(pt) { return true }
  false
}

// True if the already-collected declared local `name` is a union ref (code `4`).
function declaredUnion(name: string) { declaredKind(name) == "union" }

// True if evaluating the expression at `exprIx` yields the union box: a union-returning
// call, a union param/local reference, or a parenthesized union expression. (A bare
// object literal is NOT a union here — see the family note.)
export function exprUnion(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Paren { return exprUnion(e.parInner, fnIx) }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if fnRetUnionSid(sidOfNode(e.callFn)) { return true }
      // A union-returning function VALUE (a binding / `(…) => A | B` param callee) — its
      // result is the union box, `>u`.
      if calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "union" { return true }
      // A miss here is NOT authoritative: a closure REBOUND from a composed carrier with
      // no annotation (`const v = xs[0]; v(1)` over a union-result closure element) has no
      // sig the syntactic resolution sees, yet its call_ref yields the union BOX — fall
      // through to the checker-typed `nodeTyIsUnion` fallback below (the same net the
      // Index-callee spelling already lands in), so the binding slot classifies as the box
      // and the narrowed read unboxes instead of a raw i32 slot taking the ref.
    }
    // A union-returning FIELD-closure call.
    if callee is Member {
      const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if ffe >= 0 { return fRetKind[ffe] == "union" }
    }
    // A union-returning INDEXED closure-element call (`xs[i](1)` over a
    // `((i32) => A | B)[]`): the element signature's result token is the box (`>u`).
    // The checker net below can miss it (a union WITH null records nullable-shaped),
    // so the sig-derived kind is consulted like the other `cloArrCallRetKind` arms.
    if cloArrCallRetKind(exprIx, fnIx) == "union" { return true }
    // A PURE-litunion result (`pick(ks)` → `K`) reps as the i32 atom / string ref,
    // never the box — the checker-typed net must not claim it as a union value.
    if nodeTyIsPureLitUnion(exprIx) { return false }
    // A nullable NUMERIC-scalar result (`f32 | null` from a chained value call
    // `v(1)()`) is the value-union box (`repOfNullable`'s scalar arm) — the checker-typed
    // net's TyNullable case. The niche nullables (string/boolean/litunion/struct/closure/
    // list `| null`) are structurally excluded by the classifier.
    if nodeTyIsNulScalarBox(exprIx) { return true }
    return nodeTyIsUnion(exprIx)
  }
  if e is Ident {
    // A VALUE-union ident narrowed to ONE scalar atom (`if u is i32 { … u … }`)
    // reads UNBOXED in this scope — it is no longer a union value here (the host's
    // narrowing types it as the member). A sub-union narrowing (2+ atoms) keeps
    // the box.
    if narrowedValueAtomOf(e.identName) != "" { return false }
    // A union binding narrowed to a REF-ELEMENT array arm reads UNBOXED to the reflist
    // wrapper (`if x is (i32 | string)[] { const t = x … }`): in this scope it is a
    // LIST, not a union value — the ref-array twin of the scalar-atom rule above.
    // Without it a REBIND under the narrow classified as a union BOX while the init
    // emitted the unboxed wrapper ref — invalid wasm.
    if narrowedRefArrayOf(e.identName) != "" { return false }
    if paramUnion(fnIx, e.identName) { return true }
    if declaredUnion(e.identName) { return true }
    // A CAPTURED union box (`const a: C | D = …; () => … a is C …`): the env field is the union
    // box (kind 4). `capturedUnionName` resolves its member set from the parent binding so `is`
    // narrows; here we only need to know it IS a union value.
    if capturedKindOf(fnIx, e.identName) == "union" { return true }
    // A module GLOBAL union binding (a union annotation, or a union-returning
    // init): top-level `const a = make(42)` / `let w: string | i32 = "a"`.
    const gi = globalLetOf(e.identName)
    if gi >= 0 { return letIsUnion(gi, -1) }
    return false
  }
  // `ns[i]` over a UNION-element ref list yields the union box (G7-ref) — so the value
  // is usable with `is`-narrowing (a `let n0 = ns[i]` is a union local). Per-slot: the
  // element kind comes from the receiver's distinct ref-list slot (2 = union box).
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      // GUARD the slot (same discipline as the struct-element arm — a narrowed
      // union-arm rebind receiver resolves no slot; OOB otherwise).
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot < 0 || slot >= rlElemKindTbl.length { return false }
      return rlElemKindTbl[slot] == 2
    }
    // A bare `m[k]` over a UNION-valued map yields the value union box.
    const mri = mapReadMvSlot(exprIx, fnIx)
    if mri >= 0 { return mvValKind[mri] == 2 }
  }
  // `m[k] ?? d` over a UNION-valued map yields the value union box — EXCEPT a `scalar | null`
  // value, which `??` peels to the raw unboxed scalar (classified by `exprIsI64`/`exprIsF64`/… ).
  if e is BinExpr {
    const cmu = coalesceMvSlot(exprIx, fnIx)
    if cmu >= 0 { return mvValKind[cmu] == 2 && !mvUnionIsScalarNull(cmu) }
    // A non-map `p ?? q` over a nullable value-union BOX keeps the BOX when the DEFAULT is
    // itself nullable — the result is still `T | null`, and `T | null` has no unboxed rep.
    // This is the CONSUMER half of the same decision the `??` lowering makes: without it an
    // un-annotated `const nv = p ?? q` inferred the residual scalar cell and its later
    // `nv != null` found no nullable rep to test. DELEGATED to the name-typed mirror so the
    // two producers cannot disagree about which `??` spellings keep the box — a boolean
    // that claims a box the name resolver cannot name leaves the narrowed read with no
    // member set, which is the same defect one classifier over.
    if e.binOp == "??" {
      if unionNameOfExpr(exprIx, fnIx) != "" { return true }
    }
  }
  // A plain read of a VALUE-UNION struct field (`o.y`, code 16) yields the field's
  // union BOX — a union value usable wherever a union is expected (`return o.y`, a
  // union arg, `const u = o.y`). A read NARROWED to one scalar atom unboxes (mirrors
  // the code-16 read path in emitMem), so it is no longer a union here — same as the
  // narrowed IDENT case above; a sub-union narrowing keeps the box (stays a union).
  if e is Member {
    if memberUnionFieldName(exprIx, fnIx) == "" { return false }
    const mAtom = narrowVariantFor(memberPathKeyOf(exprIx))
    const mk = valueAtomKind(mAtom)
    if mk >= 0 && mk != 6 { return false }
    return true
  }
  false
}

// True if the `LetDecl` at `letIx` declares a union-typed local: its annotation names
// the union, OR its initializer produces the union (a union-returning call etc.). An
// object-literal init under a union annotation is BOXED as the union (`emitStmt`).
export function letIsUnion(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // A literal union (`type K = "a" | "b"`, or an inline `"a" | "b"`) is an interned-i32
        // ATOM, not a value-union box — never classify it kind 4.
        if isUName(lt.tyName) && !nodeTyIsLitUnionAlias(d.letType) {
          return true
        }
      }
    }
    // The init's union-ness applies ONLY when no annotation pinned the cell: an explicit
    // NON-union annotation (`const x: i32 = r` where `r` is a value-union narrowed to `i32`)
    // makes `x` that concrete type — the init UNBOXES the narrowed atom into it, it does NOT
    // box. (A UNION annotation already returned true above; a litunion ATOM init under a
    // `: string` annotation is an atom, not a box, so it must not box the cell either.)
    if d.letType < 0 {
      if exprUnion(d.letInit, fnIx) && !exprIsLitAtom(d.letInit, fnIx) {
        return true
      }
    }
    // A null-hole binding (`let x = null`, A-infer-null) is its inferred union.
    return nliNameOf(letIx) != ""
  }
  false
}

// ── value-union name resolution (the union a value flows as) ─────────────────
// The registered union NAME a binding `name` carries in function `fnIx` (its param
// annotation, its `let` annotation, an inferred union-returning init, or a module
// global's), or "" when the binding is not union-typed. The name string IS the
// atom set (`"boolean|i32"`), so narrowing complements split it directly.
export function unionNameOfIdent(name: string, fnIx: i32) {
  unionNameOfIdentSid(sidOf(name), fnIx)
}

// The sid-taking primitive. THE BIGGEST SINGLE CONVERSION IN THIS PHASE: on the
// `13f318ec` re-baseline this function reaches `parentLetOf` for 1.09% of a
// self-compile and `globalLetOf` for another 0.39%, and it also runs a
// `__str_eq__` per parameter and two more name-keyed lookups on the miss path.
// **One id now serves all five**, and the param scan compares i32s.
//
// Note the string wrapper mints (`sidOf`, not `sidLookup`): this body recovers the
// spelling with `sidText`, which is only faithful for an id that exists. That is the
// standing rule for every sid form that needs its own text back.
export function unionNameOfIdentSid(sid: i32, fnIx: i32) {
  const name = sidText(sid)
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      // Read the body field BEFORE the Param narrowing below pins its own binding.
      const body = fn.fnBody
      const params = fn.fnParams
      let i = 0
      while i < params.length {
        const p = P.nodes[params[i]]
        if p is Param {
          // `sidOfNode(params[i])` IS `sidOf(p.parName)` — the carrier answers from an
          // i32 array, so this scan costs an integer compare per parameter where it
          // cost a `__str_eq__` before.
          if sidOfNode(params[i]) == sid {
            const pn = tyNameOf(p.parType)
            if isUName(pn) { return pn }
            return ""
          }
        }
        i = i + 1
      }
      const li = parentLetOfSid(body, sid)
      if li >= 0 { return letUnionNameOf(li, fnIx) }
      // A `for <name> in <(C|S)[]>` loop variable is a kind-4 union box but is NOT a
      // `LetDecl`, so `parentLetOf` misses it — resolve its member set from the iterable's
      // union-box element type so `x is C` narrows inside the loop body.
      const flv = forInLoopVarUnionName(name, fnIx)
      if flv != "" { return flv }
    }
  }
  // THE MODULE-SCOPE DUAL of the loop-var arm above: a TOP-LEVEL `for x in <(i32|null)[]>`
  // runs in the START function, where there is no `FuncDecl` body, so the arm above is
  // unreachable at `fnIx < 0` and the box loop var resolved to NO union. The slot is still
  // declared as the kind-4 box (`declareForInLocals` is shared), so the narrowed read found
  // no member set to unbox through and pushed the raw `(ref $uBox)` where the loop var's own
  // valtype said the unboxed scalar — `vl check`-clean invalid wasm, in every module-scope
  // read shape (`for`, `.slice`, `.filter`, a nested `for`, a `w.xs` field iterable, a
  // `mk()` return iterable, a `let` iterable). Both arms read the SAME slot sidecar, so the
  // two scopes cannot drift.
  if fnIx < 0 {
    const slv = forInLoopVarUnionName(name, -1)
    if slv != "" { return slv }
  }
  // A CAPTURED union box — resolve its member set from the parent frame's binding.
  const cun = capturedUnionName(fnIx, name)
  if cun != "" { return cun }
  const gi = globalLetOfSid(sid)
  if gi >= 0 { return letUnionNameOf(gi, -1) }
  const bl = startBlockLetOfSid(sid)
  if bl >= 0 { return letUnionNameOf(bl, -1) }
  ""
}

// A per-PROGRAM memo for `startBlockLetOf`: `name` → the `LetDecl` index it resolved
// to, or -1. Cleared by `resetLitAtoms` alongside `startStmts`, so a row can never
// outlive the arena whose node it names. It exists to keep `parentLetOf`'s ONE-entry
// block cache from thrashing: the scan below hands that cache a DIFFERENT block on
// every step, so an unmemoized scan both pays N map rebuilds itself and evicts the
// map the caller's own function was using (measured over the 1,113-program corpus:
// without this memo `plBuildLetMap` is +34,741 and `plScanStmt` +62,350; with it,
// +1,384 and +4,285). A memo MISS is fail-safe: it declines, exactly as master does.
// R6 with a generation stamp, the `parentLetOf` shape: `sblGen[sid] == sblEpoch`
// means the row is live. The epoch is bumped by `resetLitAtoms` alongside
// `startStmts`, so a row can never outlive the arena whose node it names.
let sblVal: i32[] = []
let sblGen: i32[] = []
let sblEpoch: i32 = 0

// The `LetDecl` for a MODULE-scope binding declared inside a top-level BLOCK
// (`if true { const r = g() }`), or -1. Such a binding is a START-FUNCTION LOCAL, not
// a wasm global, so `globalLetOf` — which is the wasm-global name table — cannot see
// it; `parentLetOf` finds the function-scope dual but is never reached at module scope
// (`fnIx < 0`). Scans each top-level statement with the same walker.
//
// The empty-table reject is not only the cheap one — it is also the WINDOW GUARD.
// `startStmts` is filled by `collectFns`, the fourth pass, and `resetLitAtoms` empties
// it per program, so an emptiness here means "the collect pass has not run yet" and
// declining is both correct and what a fresh compiler instance already does.
// Sid-only: the one caller (`unionNameOfIdentSid`) already holds the id, so the
// string wrapper every other converted table keeps would be dead code here.
// It delegates to `parentLetOfSid`, whose table is built LAZILY — which is why a
// string caller would have to mint rather than `sidLookup` (see that function).
function startBlockLetOfSid(sid: i32) {
  if startStmts.length < 1 { return -1 }
  if sid < 0 { return -1 }
  if sidArrGet(sblGen, sid) == sblEpoch { return sidArrGet(sblVal, sid) }
  let si = 0
  let found = -1
  while si < startStmts.length && found < 0 {
    const li = parentLetOfSid(startStmts[si], sid)
    if li >= 0 { found = li }
    si = si + 1
  }
  sidArrPut(sblGen, sid, sblEpoch)
  sidArrPut(sblVal, sid, found)
  found
}

// THE ONE HOME for "which value union does a `for <name> in <iter>` LOOP VARIABLE flow as",
// given the iterable node the enclosing loop iterates (-1 = no enclosing loop found). A loop
// var is the storage class with NO declaration node at all — no `Param`, no `LetDecl` — so
// its member set can only come from the iterable's union-box ELEMENT type, and both walks
// that reach it (`unionNameOfIdentSid`'s function-scope arm and its module-scope dual) must
// answer identically: the slot `declareForInLocals` declares is the same kind-4 box either
// way, and an arm that answers "" leaves the narrowed read with no member set to unbox
// through. Both read ONE fact — the live slot's `localLoopIter` pin — so they cannot drift.
//
// THE SLOT IS THE KEY, NOT THE NAME, AND KEYING ON THE NAME IS A MISCOMPILE. Two for-in
// loops in one frame may share a loop-var name while binding different reps or different
// unions: `for v in xs` over an `i32[]`, then `for v in m.values()` over a box-valued map; or
// two box lists over `C | S` and `A | B`. A first-match-by-name AST scan handed the SECOND
// loop's read the FIRST loop's iterable — for a non-union iterable it answered "" and the raw
// `(ref $uBox)` went into `__print_i32__` (`vl check` clean, invalid wasm), and for a union
// iterable of a DIFFERENT union it answered the wrong member set (loud: `narrowed receiver
// names no union variant`). Renaming either loop var was the whole difference, at module
// scope and inside a function alike. `declaredSlotOf` is the scope-resolved lookup
// `declaredKind` already rides, so the iterable and the kind describe one binding.
//
// GUARDED on the slot ALREADY being a kind-4 union box, so a non-union loop var (an f32
// `for v in m.values()`, a struct `for s in ss`) never reaches the ref-array
// reclassification below — which could mis-name it and corrupt its codegen.
function forInLoopVarUnionName(name: string, fnIx: i32) {
  if declaredKind(name) != "union" { return "" }
  const slot = declaredSlotOf(name)
  if slot < 0 || slot >= localLoopIter.length { return "" }
  forInIterUnionElemName(localLoopIter[slot], fnIx)
}

// The union NAME an ITERABLE's element carries, or "". A union-box ref array (`(C | S)[]`,
// and the vals list of a box-VALUED map, which `exprRefArray` claims too) answers its
// element's registered member set; every other iterable answers "".
function forInIterUnionElemName(iterIx: i32, fnIx: i32) {
  if iterIx < 0 { return "" }
  if !exprRefArray(iterIx, fnIx) { return "" }
  const slot = refListSlotOfExpr(iterIx, fnIx)
  if slot < 0 || slot >= rlElemKindTbl.length { return "" }
  if rlElemKindTbl[slot] != 2 { return "" }
  rlElemName[slot]
}

// The union name of a `LetDecl`: its annotation when that names a union, else the
// union its (un-annotated) initializer produces (`const r = pick(true)`).
export function letUnionNameOf(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    const an = tyNameOf(d.letType)
    if isUName(an) { return an }
    if d.letType < 0 {
      const inf = unionNameOfExpr(d.letInit, fnIx)
      if inf != "" { return inf }
      // A null-hole binding (`let x = null` filled by a later `x = e`) carries
      // its inferred `T|null` value union (A-infer-null).
      return nliNameOf(letIx)
    }
  }
  ""
}

// The UNION return of a function-type NAME (`(i32) => A | B` → "A | B", an alias `(i32) => Sh` → its
// member set via `isUName`), or "" when the name is not a function type returning a multi-member union.
function unionRetOfFnType(fnTyName: string) {
  // `annRetNameOf` (#1144): its `< 1` gate IS this site's `arrowAt >= 1`, and the caller
  // keeps its own opener test (`emit_base.nameIsParenOpen`, the OPEN half only — its
  // `length >= 1` bound IS this site's `length > 0`) — hoisted AHEAD of the scan, as in
  // the two `forceCloResult*` twins.
  if nameIsParenOpen(fnTyName) {
    const ret0 = annRetNameOf(fnTyName)
    if ret0 == "" { return "" }
    const ret = normTypeAtom(ret0)
    if isUName(ret) { return ret }
    if isValueUnionName(ret) { return ret }
    // A value union with a litunion-ALIAS arm (`K0 | i64`): never a registered union
    // alias (a litunion decl is a `UnionDecl`, not a struct `TypeDecl`, so
    // `isVariantBoxUnion` declines it) and not `isValueUnionName` (a `K0` atom is no
    // value atom) — but it boxes as a value union (the alias arm rides the box as its
    // member-string atom), so the name IS the atom set a narrowed read unboxes with.
    if nameIsLitUnionArmValueUnion(ret) { return ret }
  }
  ""
}

// The union return-type NAME of a closure-typed PARAM `name` of function `fnIx` (`g: (i32) => A | B`
// → "A | B"), or "" when `name` is not a union-returning closure param. Lets a value call THROUGH a
// closure param (`g(x)` inside a HOF) classify its result union so a narrowed read unboxes.
function paramUnionRetName(fnIx: i32, name: string) {
  if fnIx < 0 { return "" }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    let i = 0
    while i < fn.fnParams.length {
      const p = P.nodes[fn.fnParams[i]]
      if p is Param {
        if p.parName == name {
          if p.parType >= 0 {
            const ty = P.nodes[p.parType]
            if ty is TypeRef { return unionRetOfFnType(ty.tyName) }
          }
          return ""
        }
      }
      i = i + 1
    }
  }
  ""
}

// The union NAME the expression at `exprIx` produces (the name-typed mirror of the
// boolean `exprUnion`): a union-returning call's return annotation, a union-typed
// ident, a parenthesized union. "" when the expression is not union-valued.
export function unionNameOfExpr(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return "" }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const t = fnIndexOfSid(sidOfNode(e.callFn))
      if t >= 0 {
        const fn = P.nodes[fnStmts[t]]
        if fn is FuncDecl {
          const rn = tyNameOf(fn.fnRet)
          if isUName(rn) { return rn }
          // An UN-annotated function whose returns JOIN to a value union: its inferred
          // name drives the same narrowing/unboxing (`is string` unboxes the box) as an
          // annotation would. Without this an inferred-union binding stays the raw box
          // and a narrowed read mis-types (arrayref vs the union box).
          if fn.fnRet < 0 {
            const im = inferRetNameOf(callee.identName)
            // A value union (`isValueUnionName`) OR a registered struct union (`isUName`
            // — registered from this same inferred name in `collectU`): either drives the
            // binding's narrowing/unboxing exactly as an annotation would.
            if isValueUnionName(im) { return im }
            if im != "" && isUName(im) { return im }
          }
        }
      }
      // A union-returning function VALUE callee (`const f = g; const r = f(7)`): resolve
      // the union name from the underlying lifted function, mirroring the named path above
      // — so a union from a CLOSURE call narrows/unboxes (`if r is i32 { … r … }`), not
      // just one from a named call. Without this the binding keeps the raw box and a
      // narrowed read mis-types (the box ref vs the unboxed scalar).
      const cfe = identClosureFe(callee.identName, fnIx)
      if cfe >= 0 {
        const cfn = P.nodes[fnStmts[cfe]]
        if cfn is FuncDecl {
          const crn = tyNameOf(cfn.fnRet)
          if isUName(crn) { return crn }
          // A VALUE-union annotated return (`i32 | string`, pinned on the lambda by `synthRetAnnots`):
          // `isUName` covers struct unions only, so its narrowed result would not unbox without this.
          if isValueUnionName(crn) { return crn }
          if cfn.fnRet < 0 {
            const cim = inferRetNameOf(cfn.fnName)
            if isValueUnionName(cim) { return cim }
            if cim != "" && isUName(cim) { return cim }
          }
        }
      }
      // A union-returning closure PARAM callee (`callIt(g: (i32) => A | B, x) { … g(x) … }`): resolve
      // the union from the param's function-type annotation, so a narrowed VALUE-union result unboxes
      // inside the HOF body (the struct case reads a field off the variant, so it needs no name).
      const pun = paramUnionRetName(fnIx, callee.identName)
      if pun != "" { return pun }
      // A closure binding whose function-type is INFERRED from a CALL (`const g = mk()` where `mk():
      // (i32) => A | B`): `identClosureFe` can't see through the call result, so recover the closure
      // type from `identFnTypeAnnName` and take its union return.
      const bun = unionRetOfFnType(identFnTypeAnnName(callee.identName, fnIx))
      if bun != "" { return bun }
      // A callee NARROWED to a union's closure ARM (`if t1 is (i32) => (i64|null)[] |
      // {w: i32} { const t2 = t1(1) … }`): the binding's own annotation channel misses
      // (the closure type lives on the ARM, not the binding), and `nodeUnionName`'s
      // cheap all-value-atom gate declines the composite union render — so `t2` never
      // classified as the union and its narrowed arm read skipped the box unbox
      // (INVALID-WASM at the wrapper-typed store; fuzz-nightly seed 484694996 d6).
      // The active narrow names the arm's function type exactly — take its RETURN.
      const ncl = narrowedClosureOf(callee.identName)
      if ncl != "" {
        const nun = unionRetOfFnType(peelGroupParens(ncl))
        if nun != "" { return nun }
      }
    }
    // A union-returning FIELD-closure callee (`const r = o.run(7)` over a `(…) => A | B`
    // field) — the Member analogue of the binding case above: resolve the field's lifted
    // function's union name so the result narrows/unboxes.
    if callee is Member {
      const mfe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if mfe >= 0 {
        const mfn = P.nodes[fnStmts[mfe]]
        if mfn is FuncDecl {
          const mrn = tyNameOf(mfn.fnRet)
          if isUName(mrn) { return mrn }
          if mfn.fnRet < 0 {
            const mim = inferRetNameOf(mfn.fnName)
            if isValueUnionName(mim) { return mim }
            if mim != "" && isUName(mim) { return mim }
          }
        }
      }
    }
    // FALLBACK (scoped to a CALL — never an if-expr, which has its own union rep path): a union-valued
    // call whose callee the cases above miss (an indexed closure-array element `arr[i](x)`) — render its
    // union from the checker's per-node type, for the value-union UNBOX. The name-typed dual of
    // `exprUnion`'s Call `nodeTyIsUnion` fallback; reached only here, so the costly render is off the
    // hot path (declared / param / binding unions resolve from the cheap annotation above).
    return nodeUnionName(exprIx)
  }
  if e is Ident { return unionNameOfIdent(e.identName, fnIx) }
  // `m[k] ?? d` over a UNION-valued map yields the value union's box — resolve its name (the
  // mv slot's value name) so an un-annotated `const v = m[k] ?? d` narrows/unboxes.
  if e is BinExpr {
    const cmu = coalesceMvSlot(unwrapParen(exprIx), fnIx)
    if cmu >= 0 {
      // `scalar | null` peels to a raw scalar (not a union), so it has no union name here.
      if mvValKind[cmu] == 2 && !mvUnionIsScalarNull(cmu) {
        return mvValName[cmu]
      }
    }
    // The name-typed mirror of `exprUnion`'s non-map `??` arm: `p ?? q` over a nullable
    // value-union BOX keeps the box when the default is nullable, so an un-annotated
    // `const nv = p ?? q` needs the resulting MEMBER SET to narrow and unbox through —
    // without it the cell was the box and the narrowed read pushed the raw box where the
    // consumer wanted the unboxed scalar.
    //
    // ONLY when both operands carry the SAME member set (or the default is a bare `null`,
    // which adds none). A default of a DIFFERENT union widens the result set, and there is
    // no set-merge here to render it — inventing the LHS's set would give the narrow a
    // discriminator the box does not actually satisfy, so that spelling keeps declining
    // exactly as it does today.
    if e.binOp == "??" {
      const cln = unionNameOfExpr(e.binLeft, fnIx)
      if cln != "" && coalesceDefaultNullable(e.binRight, fnIx) {
        const crn = unionNameOfExpr(e.binRight, fnIx)
        if crn == "" || crn == cln { return cln }
      }
    }
  }
  // `ns[i]` over a UNION-element ref list yields the element union's box (the
  // name-typed mirror of `exprUnion`'s Index case) — so an un-annotated
  // `const a = arr[0]` binding resolves its union name for narrowing/unboxing.
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemKindTbl.length {
        if rlElemKindTbl[slot] == 2 { return rlElemName[slot] }
      }
    }
    // `t0[i]` where `t0` is a UNION binding whose ref-array arm has a value-union element with
    // a closure member (`((() => i32) | i64)[] | i64`): narrowing-blind, `exprRefArray(t0)` is
    // false (t0 is still the union box, not yet narrowed to the array), so recover the element
    // union directly from the arm. Without this a `const t1 = t0[0]; t1()` left the narrowed
    // `call_ref` closure spill on an UNRESERVED i32 local (`blockHasCallRef` →
    // `calleeIsUnionClosureIdent` could not see t1's closure arm) — invalid wasm.
    const ax = P.nodes[unwrapParen(e.idxArr)]
    if ax is Ident {
      const aun = unionNameOfIdent(ax.identName, fnIx)
      if aun != "" {
        const cel = unionClosureArrElemUnion(aun)
        if cel != "" { return cel }
      }
    }
    // A bare `m[k]` over a UNION-valued map (the value union's box).
    const mri = mapReadMvSlot(unwrapParen(exprIx), fnIx)
    if mri >= 0 {
      if mvValKind[mri] == 2 { return mvValName[mri] }
    }
  }
  // The name-typed mirror of `exprUnion`'s Member case: a code-16 field read carries
  // the field's union name (its atom set), unless narrowed to one scalar (unboxed).
  if e is Member {
    const mix = unwrapParen(exprIx)
    const mAtom = narrowVariantFor(memberPathKeyOf(mix))
    const mk = valueAtomKind(mAtom)
    if mk >= 0 && mk != 6 { return "" }
    return memberUnionFieldName(mix, fnIx)
  }
  ""
}

// The single scalar atom a binding `name` is currently narrowed to (`"i32"`,
// `"string"`, `"boolean"`, `"i64"`, `"f64"`, `"f32"`), or "" when it is not
// narrowed / narrowed to a sub-union (a pipe-joined set classifies as no atom) /
// narrowed to `null` / narrowed to a struct variant. A non-"" answer means an
// ident READ unboxes to that atom's rep.
export function narrowedValueAtomOf(name: string) {
  const i = narrowSlotOf(name)
  if i < 0 { return "" }
  const v = narrowVariants[i]
  if v == "" { return "" }
  // CONTAINMENT: the narrowed TYPE decides the REJECT — a type that is neither a value
  // atom (`unMemAtomKind`, `valueAtomKind`'s arena dual) nor a litunion has no unboxing
  // arm, whatever it is spelled, and that is the population whose rendered spelling is
  // expensive to classify (a struct variant / a list / a map runs the whole
  // `valueAtomKind` ladder down to its arrow scan). Where the type IS an atom the
  // SPELLING decides, because the answer is the spelling: a nominal alias renders
  // itself, not its structure.
  const ty = narrowSlotTy(i)
  if ty >= 0 {
    const tk = unMemAtomKind(ty)
    if tk == 6 { return "" }
    if tk < 0 {
      // A NUMERIC litunion arm (`if p is N` where `type N = 1 | 2`, and the inline /
      // single-literal spellings `is 1 | 2` / `is 1`) unboxes as its BASE SCALAR — the
      // rep the box's payload actually holds, which is `numLitUnionBaseName`'s answer
      // and the same one `emitUnionCoerce` boxed the member with. ASKED OF THE ARENA,
      // not of the spelling, because there is no spelling that carries it: the narrow
      // banks the tested name (`N`, or a bare `1`), and `valueAtomKind` of either is -1
      // while `nameIsLitUnionType` — the STRING twin two lines down — is `litKind ==
      // "str"` only. So this rep reached neither leg and the read stayed the raw
      // `(ref $uBox)` where the arm's i32/i64/f64 was expected: `vl check`-clean INVALID
      // WASM at every `is`-narrowed read of a `N | null`, while the `!= null` spelling of
      // the identical program was correct (its complement push banks the base scalar's
      // own name, so it lands on `valueAtomKind` below).
      const nb = numLitUnionBaseName(ty)
      if nb != "" { return nb }
      if !tyIsLitUnion(ty) { return "" }
    }
  }
  const k = valueAtomKind(v)
  if k >= 0 && k != 6 { return v }
  // A TRANSPARENT ALIAS of a scalar/string atom (`type N = i32` then `if p is N` over a
  // `p: i32 | null`) banks the ALIAS spelling, which `valueAtomKind` declines — while the
  // ARENA type the SAME push banked is the `TyPrim` whose `primName` is the canonical atom
  // spelling. That is not a second rule: it is exactly the string `unMemAtomKind` hands
  // `valueAtomKind` two functions down, so the two legs cannot disagree about which atom
  // an arm is. Without it the box-tag test was correct and the narrowed read stayed the raw
  // `(ref $uBox)` — `vl check`-clean INVALID WASM at every non-capture storage class, while
  // `is i32` (the same question spelled with the atom's own name) was correct beside it.
  // `TyPrim` ONLY: a closure / list / map arm's SPELLING carries information its kind does
  // not (its signature, its element type), and those consumers read the spelling.
  if k < 0 && ty >= 0 {
    const at = T.tys[ty]
    if at is TyPrim {
      const ak = valueAtomKind(at.primName)
      if ak >= 0 && ak != 6 { return at.primName }
    }
  }
  // A litunion-alias narrow (`x is K0` where `type K0 = "a" | "b"`) unboxes as the
  // STRING ref the box stores its litunion member as (`emitUnionCoerce` boxes it so).
  if k < 0 && nameIsLitUnionType(v) { return "string" }
  ""
}

// The REF-ELEMENT-ARRAY arm a union binding `name` is currently narrowed to (`if x is S[]`
// → `S[]`, `if x is (() => f64)[]` → `(() => f64)[]`), or "" when it is not narrowed to a
// ref array (un-narrowed / a scalar atom / a struct variant / `null` / a sub-union). The
// ref-array analogue of `narrowedValueAtomOf`: a non-"" answer means an ident READ recovers
// the reflist WRAPPER ref from the box (`ref.cast` of the anyref payload) so indexing /
// `.length` see the list directly.
export function narrowedRefArrayOf(name: string) {
  const i = narrowSlotOf(name)
  if i < 0 { return "" }
  const v = narrowVariants[i]
  if v == "" { return "" }
  const ty = narrowSlotTy(i)
  if ty >= 0 {
    if unMemAtomKind(ty) >= 0 { return "" }
    // CONTAINMENT: `unMemIsRefElemArray` is the SHAPE question (a `TyArray` over a
    // non-scalar-leaf element) and `nameIsRefArray` is that shape PLUS the reflist
    // layer's nameability, so the arena leg can only REJECT — and rejecting is what
    // almost every narrowed binding needs. A shape-yes re-asks the name.
    if !unMemIsRefElemArray(ty) { return "" }
  }
  if valueAtomKind(v) >= 0 { return "" }
  if nameIsRefArray(v) { return v }
  ""
}

// The BARE-CLOSURE arm a union binding `name` is currently narrowed to (`if x is () => i64` →
// `() => i64`), or "" when it is not narrowed to a closure. A closure is value-atom KIND 11, so
// the narrowed READ already unboxes via `narrowedValueAtomOf` + `emitValueUnionUnboxRead` (which
// casts the box payload to `$cloStructIdx`); this filter isolates the closure case so `exprIsClosure`
// can route the narrowed ident's CALL to `call_ref` (and `calleeCloSigKey` to the arm's `$fnsig`).
export function narrowedClosureOf(name: string) {
  const v = narrowedValueAtomOf(name)
  if v != "" && valueAtomKind(v) == 11 { return v }
  ""
}

// The MAP arm a union binding `name` is currently narrowed to (`if x is {[string]: string}` →
// `{[string]: string}`), or "" when it is not narrowed to a map (un-narrowed / a scalar atom /
// a struct variant / a ref array / `null` / a sub-union). The map analogue of `narrowedRefArrayOf`:
// a non-"" answer means an ident READ recovers the MAP STRUCT ref from the box (`ref.cast` of the
// anyref payload) so `x[k]` / `x[k] ?? d` / `x.has(k)` route through the map lowering directly.
export function narrowedMapOf(name: string) {
  const i = narrowSlotOf(name)
  if i < 0 { return "" }
  const v = narrowVariants[i]
  if v == "" { return "" }
  // CONTAINMENT (as in `narrowedValueAtomOf`): a narrowed type that is not a `TyMap`
  // cannot be the map arm, whatever it is spelled — and the map-member-UNION the name
  // path has to exclude is a `TyUnion`, so the arena leg rejects it for free.
  const ty = narrowSlotTy(i)
  if ty >= 0 {
    if !unMemIsMap(ty) { return "" }
  }
  if valueAtomKind(v) >= 0 { return "" }
  // A narrow can land on a member SET, not a single arm: `t != null` over a map-member
  // union (`{[string]: V} | string | null`) narrows to `{[string]: V}|string` — a name
  // that STARTS with `{[` (so `nameIsMap` matches) but is still a union BOX, not a bare
  // map. Without the member-union guard a rebind under that narrow (`const t1 = t0`)
  // classified as a MONO map local and every read of it emitted the wrong rep — invalid
  // wasm (the same guard every `paramMap` / `retMapFlag` / `nameFieldCode` site carries).
  if nameIsBareMap(v) { return v }
  ""
}

// The map VALUE type the narrowing banks for `name`, or -1 — `narrowedMapOf`'s structural
// sibling, reading the SAME stack slot's TYPE column instead of its rendered variant and
// taking one `TyMap` hop down to the value. The two answers are one row's two halves
// (`pushNarrowRep` writes `narrowVariants[i]` and `narrowTys[i]` together), which is why
// the consumer can pair them without asking whether they describe the same map.
//
// THE BIGGEST SINGLE `fieldElemTyIxOfName` CALLER IN THE EMITTER WAS THE ABSENCE OF THIS
// FUNCTION (D-MVSLOTFIND): `mapShapeOfExpr`'s narrowed-arm rung handed `mvSlotOfMapName`
// the rendered arm spelling, which sliced `V` back out of `{[K]: V}` and put the slice
// through the annotation grammar — 672 `resolveAnnot` reaches over the corpus, every one
// of them re-deriving a type the `is`-narrow had banked at the push. Dual-write, 912
// entries: covered 912, D1/D2/D3 all 0, and the arena leg resolves a slot at exactly the
// 672 entries the name leg does. -1 (a complement narrow, a 2+-member set, a non-map arm)
// keeps the name path in its old position.
export function narrowedMapValTyOf(name: string): i32 {
  const i = narrowSlotOf(name)
  if i < 0 { return -1 }
  tyMapValOf(narrowSlotTy(i))
}

// The atom KIND an IDENT expression currently reads as, for the scalar/string
// classifiers (`exprString`/`exprIsBool`/`exprIsI64`/`exprIsF64`/`exprIsF32`):
// `valueAtomKind` codes when the ident is a union binding narrowed to ONE scalar
// atom (the read unboxes to that atom's rep), -2 when it is a union binding NOT
// narrowed to a single atom (the read is the BOX ref — no scalar classification,
// even if the binding's INIT was a string/bool literal), or -3 when the
// expression is not a union-typed ident at all (the caller keeps its existing
// classification rules).
function unionIdentReadKind(exprIx: i32, fnIx: i32) {
  const e = P.nodes[exprIx]
  if e is Ident {
    if unionNameOfIdentSid(sidOfNode(exprIx), fnIx) != "" {
      const a = narrowedValueAtomOf(e.identName)
      if a != "" { return valueAtomKind(a) }
      return -2
    }
  }
  -3
}

// The member-path dual of `unionIdentReadKind`: the atom KIND a UNION-typed
// struct-FIELD read (`o.y`, field code 16) currently reads as — the narrowed
// single atom's kind when the member PATH is narrowed (the read unboxes to that
// atom's rep), -2 for an un-narrowed box read, -3 when the expression is not a
// union-field member at all.
function memberUnionReadKind(exprIx: i32, fnIx: i32) {
  const e = P.nodes[exprIx]
  if e is Member {
    if memberUnionFieldName(exprIx, fnIx) != "" {
      const a = narrowedValueAtomOf(memberPathKeyOf(exprIx))
      if a != "" { return valueAtomKind(a) }
      return -2
    }
  }
  -3
}

// The CURRENT narrowed atom set of the union binding `name`: its innermost active
// narrowing when one exists (which may already be a sub-union), else its declared
// union's full member set (the union name itself). "" when not a union binding.
export function currentNarrowSetOf(name: string, fnIx: i32) {
  const v = narrowVariantFor(name)
  if v != "" { return v }
  unionNameOfIdent(name, fnIx)
}

// The FULL pipe-joined member set of the union named `name`: a registered alias
// returns its `unMemberSet` entry (a declared `type N = A | B` expands to "A|B",
// atom members like `null` kept); an unregistered / already-pipe-joined name
// passes through unchanged. Lets complement narrowing subtract variants from an
// ALIAS-annotated binding's set.
export function unionMemberSetOf(name: string) {
  let u = 0
  while u < unNames.length {
    if unNames[u] == name { return unMemberSet[u] }
    u = u + 1
  }
  name
}

// "GIVE ME THIS UNION'S TOP-LEVEL ARMS" — the ONE home for the four-line preamble
// FIFTEEN union classifiers in this file each wrote out by hand:
//
//     let nm = unionMemberSetOf(name)        // resolve an alias to its member set
//     if nm == "" { nm = name }              // an unregistered name is its own set
//     const atoms: string[] = []
//     if !msMemberAtomsOf(nm, atoms) { splitUnionAtoms(nm, atoms) }   // memo, else split
//
// Fifteen copies of that preamble are fifteen copies of the `|`-splitting GRAMMAR:
// each one re-decides, in the caller, that a member set is pipe-joined text to be
// taken apart when the interning tables decline it. Named once, the split survives at
// exactly ONE site in the whole family, so the day `msMemberAtomsOf` covers every row
// (or a consumer takes arena member types instead) there is a single line to delete
// rather than fifteen. Two spellings of the alias fallback were in circulation —
// `if nm == "" { nm = name }` and `const s = unionMemberSetOf(n); if s != "" { n = s }`
// — and they are the SAME function, because `unionMemberSetOf` returns its argument on
// a miss; both are this one.
//
// Returns the RESOLVED member-set spelling, which every caller needs afterwards for the
// arena leg (`unionMemberTysOf(nm, mems)`) — so the atoms go out through `out` and the
// set name comes back, and no caller has to hold the resolution twice.
export function unionArmsOf(name: string, out: string[]) {
  let nm = unionMemberSetOf(name)
  if nm == "" { nm = name }
  if !msMemberAtomsOf(nm, out) { splitUnionAtoms(nm, out) }
  nm
}

// "GIVE ME THIS UNION'S ARMS, BOTH WAYS" — the ONE home of the four-line preamble
// TWELVE union classifiers in this file each wrote out by hand on top of
// `unionArmsOf`:
//
//     const atoms: string[] = []
//     const nm = unionArmsOf(name, atoms)                              // arm SPELLINGS
//     const mems: i32[] = []
//     const cov = unionMemberTysOf(nm, mems) && mems.length == atoms.length
//
// Every one of the twelve then branched on `cov`: an arena loop over `mems[i]` when
// true, the legacy spelling loop over `atoms[i]` when false. The pairing rule — the two
// arrays are index-parallel, so `atoms[i]` is `mems[i]`'s stored spelling — and the
// LENGTH check that establishes it were re-decided at each site, and the resolved set
// name `nm` was held by every one of them for one use only. Named once, the coverage
// rule lives in a single place: the day a caller may take the member types WITHOUT a
// spelling array there is one function to change, not twelve.
//
// Returns TRUE when the arena leg covers the row 1:1 (`tys` is then filled, in the
// row's recorded box-tag ABI order); FALSE leaves `tys` untouched — `unionMemberTysOf`
// is all-or-nothing — and the caller keeps its spelling loop. `atoms` is filled EITHER
// WAY, which is what makes the fall-through legal.
export function unionArmTys(
  name: string,
  atoms: string[],
  tys: i32[],
): boolean {
  const nm = unionArmsOf(name, atoms)
  unionMemberTysOf(nm, tys) && tys.length == atoms.length
}

// `unionArmTys` for a caller that already HOLDS a member SET and must NOT have it
// resolved as an alias name — the union REGISTRATION paths (`markValueUnionAtoms`,
// `markRefArrayArms`, `markMapUnionArms`) and `unionHasMapArmSlot`, which are handed
// `unMemberSet[u]` / an inline set / a map VALUE spelling by their callers.
//
// **THE TWO ARE NOT INTERCHANGEABLE, and that is why there are two.** `unionArmsOf`
// runs `unionMemberSetOf` first, so a registered ALIAS name `U` (`type U = A | B`)
// expands to its two arms; `splitUnionAtoms("U")` yields the single atom `"U"`. Both
// spellings genuinely reach these four: `markMapUnionArms` is called with a map's VALUE
// name (which may be a declared union alias) and `unionHasMapArmSlot` with whatever
// `emitUnionCoerce` holds. Expanding there would change which arms are interned /
// tag-matched, so the alias resolution is deliberately absent — the difference between
// the two homes is the whole content of this comment.
export function unionSetArmTys(
  set: string,
  atoms: string[],
  tys: i32[],
): boolean {
  splitUnionAtoms(set, atoms)
  unionMemberTysOf(set, tys) && tys.length == atoms.length
}

// The `unNames` ROW of the union `name` — matched on the alias NAME or on the
// pipe-joined member SET (a consumer that already resolved the alias hands us the
// set), or -1. Nominal identity lookup, not a structural decision.
export function unionRowOf(name: string): i32 {
  if name == "" { return -1 }
  let u = 0
  while u < unNames.length {
    if unNames[u] == name { return u }
    u = u + 1
  }
  let v = 0
  while v < unMemberSet.length {
    if unMemberSet[v] == name { return v }
    v = v + 1
  }
  -1
}

// The ARENA member types of the union `name`, appended to `out` in the row's recorded
// ORDER (== `splitUnionAtoms(unMemberSet[row])` order — the box-tag ABI order). True
// when the row is covered and EVERY member resolved; false leaves `out` untouched and
// the caller must keep its legacy member-NAME path. The D-UNION query seam: consumers
// classify each member STRUCTURALLY (`T.tys[m] is TyMap`, …) instead of re-deriving the
// shape from the member's rendered spelling.
export function unionMemberTysOf(name: string, out: i32[]): boolean {
  const u = unionRowOf(name)
  if u < 0 { return false }
  if u >= unMemTyStart.length { return false }
  const st = unMemTyStart[u]
  if st < 0 { return false }
  const n = unMemTyCount[u]
  let i = 0
  while i < n {
    if unMemTys[st + i] < 0 { return false }
    i = i + 1
  }
  let j = 0
  while j < n {
    out.push(unMemTys[st + j])
    j = j + 1
  }
  true
}

// The union-BOX ABI's atom test, from the arena: 1 = the union `name` has a member
// whose type is EXACTLY the keyword primitive `want`, or exactly an ARRAY over it when
// `arr`; 0 = it has none, -1 = the row is UNCOVERED (an unregistered union, or a member
// spelling that did not resolve). The -1 is now a "cannot happen" its only caller
// diagnoses — see `unionHasAtomTy` for the three closed decline causes. The
// structural dual of `unionHasAtom(name, atom)` for the fixed keyword atoms
// `emitUnionCoerce`'s ladder and the `==` / literal-`is` tag selectors test
// ("i32"/"i64"/"f64"/"f32"/"string"/"boolean"/"null" and their `[]` forms).
//
// **The atom arrives in TWO PIECES, and that is the point** (destringify D-ATOMPAIR).
// This function used to take the JOINED spelling and take it apart again — an
// `atom[n-2] == '['` suffix test plus an `atom.slice(0, n-2)` — i.e. it parsed the
// structure encoded in a type string, outside the parser. Every caller already knew
// both halves at its own source (each is a keyword ladder or a literal; the one
// composite site rendered `elemAtom + "[]"` purely to feed this peel), so the pieces
// are passed instead of joined-then-split. Nothing renders a list spelling for this
// test and nothing peels one: the parse is DELETED, not relocated.
//
// **Deliberately EXACT, not a rep fold** (the D2 lesson, applied in the direction that
// matters here): the caller turns the atom into a TAG (`scalarTagOf(atom)`), so the
// question is "is there an arm spelled exactly this", not "is there an arm that reps
// like this". `boolean[]` and a litunion `K[]` ride the SAME i32-list backing as
// `i32[]` (`valueAtomKind` folds all three to kind 7) — matching them here would hand
// the caller a tag no producer interned for this value. Hence `TyPrim` with the atom's
// own `primName`, and for a list atom a `TyArray` over exactly that `TyPrim`: a
// `(i32 | null)[]` element is a `TyNullable`, a litunion element a `TyUnion`, and both
// answer NO on both paths.
export function unMemHasAtom(name: string, want: string, arr: boolean): i32 {
  const mems: i32[] = []
  if !unionMemberTysOf(name, mems) { return -1 }
  let i = 0
  while i < mems.length {
    let m = mems[i]
    if m >= T.tys.length { return -1 }
    if arr {
      const ta = T.tys[m]
      m = -1
      if ta is TyArray { m = ta.aElem }
      if m >= T.tys.length { return -1 }
    }
    if m >= 0 {
      const t = T.tys[m]
      if t is TyPrim {
        if t.primName == want { return 1 }
      }
    }
    i = i + 1
  }
  0
}

// The union-BOX ABI's atom test (D-UNION), answered ONLY from the arena
// (destringify D-UHATOTAL). The legacy member-NAME fall-through
// (`unionHasAtom(name, want + "[]")`) is DELETED: it was the last place in the
// compiler that rendered a joined list spelling, and it was measured DEAD.
//
// **Why the arena leg is total here**, which is what deletion required — three
// decline causes, each closed:
//
//  1. *A row minted without its members recorded* is structurally impossible.
//     A union row is minted at exactly THREE sites (`registerInlineUnion`,
//     `registerValueUnionName`, `collectU`'s `UnionDecl` arm); each pushes
//     `unNames` / `unMemberSet`, calls `recordUnMemTys`, and pushes the box's
//     `unVarStart` slice in ONE uninterrupted statement sequence. Row identity,
//     member arena columns and value-box slice are minted ATOMICALLY.
//  2. *A member spelling that does not resolve to an arena type* (`unMemAtomTyIx`
//     → -1) would leave `unionMemberTysOf` uncovered. A marker at the recorder
//     fired **0** times over 1,242 corpus files and 100,800 fuzz programs.
//  3. *A name that is not a registered row at all.* Every caller of this predicate
//     is lowering a VALUE BOX (coerce / `==` / literal `is` / the `??` and map-get
//     residuals / a boxed list-literal arm / the boxed map-value and struct-field
//     null tests), and a box exists only because the registration that minted its
//     tag slice also recorded its members — see (1).
//
// Measured, not assumed: a marker inside the deleted fall-through fired **0**
// times over 1,242 corpus files and 100,800 fuzz programs, while the SAME marker
// in a build whose arena leg is forced to decline fired on **182** corpus files
// and **8,420** fuzz programs — precisely the population that reaches this
// predicate at all (an entry marker gives the identical 182 / 8,420). So the
// arena leg answers at 100% of the sites that ask.
//
// An uncovered row is therefore a "cannot happen", and it says so LOUDLY rather
// than silently answering "no such arm" — a false `false` here picks a box tag or
// an `==` arm no producer interned, which is a silent miscompile.
//
// The atom is a (primitive, is-list) PAIR, not a spelling (destringify
// D-ATOMPAIR); with the fall-through gone, NOTHING in this compiler joins a
// primitive to `[]` for a membership test, and nothing peels one back apart.
export function unionHasAtomTy(
  name: string,
  want: string,
  arr: boolean,
): boolean {
  const a = unMemHasAtom(name, want, arr)
  if a >= 0 { return a == 1 }
  emitFail(
    "emitProgram: union box atom test on a union with no recorded members: " +
      name,
  )
  false
}

// ── D-UNION SET ADT — the union member set as a STRUCTURE ────────────────────
// A member set is a SUBSET of one union row's recorded members: the pair (row,
// mask), where bit `i` of the mask is member `i` of the row in the row's RECORDED
// ORDER. That order is the box-tag ABI order (`unVarStart`/`unVarCount` slice
// `uVariants`; `markValueUnionAtoms` mints value boxes in atom order), and nothing
// here can reorder it — the order is never re-derived, only masked.
//
// The members themselves are the reference columns `recordUnMemTys` writes
// (`unMemAtoms`/`unMemAtomIds`/`unMemKinds`/`unMemTys` — spelling, interned identity,
// what the member IS, its arena type). So:
//   membership   — a KIND test (`null`) or an interned-id compare, never a substring
//                  search over a joined string;
//   subtraction  — clearing bits, never string surgery;
//   cardinality  — a bit count, never a re-split;
//   iteration    — a walk of the row's members in the row's order.
// A set is RENDERED (`msTextOf`) only where it is handed to a name-keyed consumer,
// by joining the surviving members' VERBATIM spellings — which is byte-identical to
// what the string surgery produced, because those spellings are the very substrings
// the joined set was built from. (Rendering the recorded arena types instead would
// NOT be: the arena's render of a declared `S` is the structural `{v: i32}` — the
// D5-final lesson about using the right renderer.)

// The member slice of union row `u`, or -1 when the row is not covered by the
// reference columns (a row the recorder missed, an empty row, or one wider than the
// 31-bit mask). `unMemTyStart`/`unMemTyCount` slice all four member columns alike.
// The bounds live ONCE, in `emit_rep` beside the recorder that writes the columns
// (#1110's hand-off) — this is the local spelling of that one function, not a copy.
function msRowStart(u: i32): i32 { unMemRowStart(u) }

// Is member `i` present in `mask`? (Bitwise `&` binds LOOSER than `==` in this
// language, so the test is parenthesized once here rather than at five call sites.)
function msBitSet(mask: i32, i: i32): boolean { ((mask >>> i) & 1) == 1 }

// The rendered form of the subset `mask` of row `u`: the surviving members'
// verbatim spellings, joined on `|`, in the row's recorded order.
function msRenderSet(u: i32, mask: i32): string {
  const st = msRowStart(u)
  if st < 0 { return "" }
  const n = unMemTyCount[u]
  let out = ""
  let i = 0
  while i < n {
    if msBitSet(mask, i) {
      if out != "" { out = out + "|" }
      out = out + unMemAtoms[st + i]
    }
    i = i + 1
  }
  out
}

// The interned set id for the subset `mask` of row `u` — one id per distinct
// (row, mask), so a set's rendering is built once and every later operation on it is
// a table read. Stamped with the pool generation (method note 7).
function msSetIntern(u: i32, mask: i32): i32 {
  while msRowChain.length <= u { msRowChain.push(-1) }
  let s = msRowChain[u]
  while s >= 0 {
    if msSetMask[s] == mask && msSetGen[s] == msGen { return s }
    s = msSetNext[s]
  }
  const id = msSetRow.length
  const txt = msRenderSet(u, mask)
  msSetRow.push(u)
  msSetMask.push(mask)
  msSetGen.push(msGen)
  msSetNext.push(msRowChain[u])
  msSetText.push(txt)
  msRowChain[u] = id
  if txt != "" {
    if (msSetByText[txt] ?? -1) < 0 { msSetByText[txt] = id }
  }
  id
}

// The set id of union row `u`'s FULL member set, or -1 when the row is uncovered.
function msSetOfRow(u: i32): i32 {
  const st = msRowStart(u)
  if st < 0 { return -1 }
  const n = unMemTyCount[u]
  msSetIntern(u, (1 << n) - 1)
}

// The set id for a member-set STRING — the bridge that lets a consumer still holding
// one join the structural side. A set the pool already rendered answers from the text
// index; otherwise the string must be some union row's FULL member set (the only
// place a set string is ever minted from a declaration), and a row whose recorded set
// is exactly this text hands over its members. -1 = uncovered, and every consumer
// keeps its string path — an ALIAS name (`N`, not `A|B`) lands here deliberately: the
// legacy operations treat it as a one-atom set, and expanding it would change answers.
export function msSetOfText(set: string): i32 {
  if set == "" { return -1 }
  const hit = msSetByText[set] ?? -1
  if hit >= 0 {
    if msSetGen[hit] == msGen { return hit }
  }
  if (msSetMiss[set] ?? -1) == msGen { return -1 }
  let u = 0
  while u < unMemberSet.length {
    if unMemberSet[u] == set {
      const id = msSetOfRow(u)
      if id >= 0 { return id }
    }
    u = u + 1
  }
  msSetMiss[set] = msGen
  -1
}

// The rendered member set of `s` (see `msRenderSet`).
export function msTextOf(s: i32): string {
  if s < 0 || s >= msSetText.length { return "" }
  msSetText[s]
}

// ITERATION — append the set's member SPELLINGS to `out`, in the row's recorded
// (box-tag ABI) order, without re-splitting anything: the recorded member column IS
// the atom array `splitUnionAtoms` would rebuild, because `msSetOfText` hands back a
// set only when the string IS that row's recorded member set, and the row's members
// were split from exactly that string once, at registration. False = uncovered, `out`
// untouched, and the caller splits as before.
export function msMemberAtomsOf(set: string, out: string[]): boolean {
  msMemberAtomsOfSet(msSetOfText(set), out)
}

// `msMemberAtomsOf` for a caller that already HOLDS the set id — the whole point of
// banking one (destringify D-SETID). `msSetOfText` is a text→set RESOLUTION (a map
// probe plus, on a miss, a linear scan of every registered `unMemberSet` row); a
// consumer that got its set from the narrowing table or from an earlier resolution of
// the same name has no reason to render it and look it up again.
export function msMemberAtomsOfSet(s: i32, out: string[]): boolean {
  if s < 0 { return false }
  if s >= msSetRow.length { return false }
  const u = msSetRow[s]
  const st = msRowStart(u)
  if st < 0 { return false }
  const n = unMemTyCount[u]
  const mask = msSetMask[s]
  let i = 0
  while i < n {
    if msBitSet(mask, i) { out.push(unMemAtoms[st + i]) }
    i = i + 1
  }
  true
}

// MEMBERSHIP of the `null` keyword — a member-KIND test over the set's members, with
// no string compare at all.
export function msHasNull(s: i32): boolean {
  if s < 0 || s >= msSetRow.length { return false }
  const u = msSetRow[s]
  const st = msRowStart(u)
  if st < 0 { return false }
  const n = unMemTyCount[u]
  const mask = msSetMask[s]
  let i = 0
  while i < n {
    if msBitSet(mask, i) {
      if unMemKinds[st + i] == 0 { return true }
    }
    i = i + 1
  }
  false
}

// CARDINALITY of the non-`null` members — a bit count over the kind column.
export function msNonNullCount(s: i32): i32 {
  if s < 0 || s >= msSetRow.length { return 0 }
  const u = msSetRow[s]
  const st = msRowStart(u)
  if st < 0 { return 0 }
  const n = unMemTyCount[u]
  const mask = msSetMask[s]
  let c = 0
  let i = 0
  while i < n {
    if msBitSet(mask, i) {
      if unMemKinds[st + i] != 0 { c = c + 1 }
    }
    i = i + 1
  }
  c
}

// The arena TYPE of the set's SOLE member, or -1 when the set is empty, uncovered, or
// has two or more members. The bridge from the set ADT to the per-type classifiers: a
// complement narrowing that has subtracted its way down to one member (`i32 | null`
// minus `null`) binds that member's type, and every "what is this binding now" question
// is asked of that type rather than of the rendered survivor.
export function msSoleMemberTy(s: i32): i32 {
  if s < 0 || s >= msSetRow.length { return -1 }
  const u = msSetRow[s]
  const st = msRowStart(u)
  if st < 0 { return -1 }
  const n = unMemTyCount[u]
  const mask = msSetMask[s]
  let found = -1
  let i = 0
  while i < n {
    if msBitSet(mask, i) {
      if found >= 0 { return -1 }
      found = st + i
    }
    i = i + 1
  }
  if found < 0 { return -1 }
  unMemTys[found]
}

// SUBTRACTION of the `null` keyword: clear every member whose KIND is the null token.
export function msSubNull(s: i32): i32 {
  if s < 0 || s >= msSetRow.length { return -1 }
  const u = msSetRow[s]
  const st = msRowStart(u)
  if st < 0 { return -1 }
  const n = unMemTyCount[u]
  let mask = msSetMask[s]
  let i = 0
  while i < n {
    if msBitSet(mask, i) {
      if unMemKinds[st + i] == 0 { mask = mask - (1 << i) }
    }
    i = i + 1
  }
  msSetIntern(u, mask)
}

// SUBTRACTION of a named member: clear every member whose interned IDENTITY is the
// removed one. `msAtomIdOf` peels grouping parens on both sides, exactly as the
// string surgery's `peelGroupParens` comparison did, so an `is () => i64` test still
// strips the `(() => i64)` member.
export function msSubAtom(s: i32, removed: string): i32 {
  if s < 0 || s >= msSetRow.length { return -1 }
  const u = msSetRow[s]
  const st = msRowStart(u)
  if st < 0 { return -1 }
  const n = unMemTyCount[u]
  const rid = msAtomIdOf(removed)
  let mask = msSetMask[s]
  let i = 0
  while i < n {
    if msBitSet(mask, i) {
      if unMemAtomIds[st + i] == rid { mask = mask - (1 << i) }
    }
    i = i + 1
  }
  msSetIntern(u, mask)
}

// ── the set ADT's consumers (structure first, string surgery as fall-through) ──

// Set SUBTRACTION — the else-branch complement of `is removed` / `!= null`. The
// structural path resolves the set, clears the removed member's bits and renders the
// survivors in the row's recorded ORDER; `removeAtomFrom`'s string surgery stays as
// the fall-through for a set the pool does not cover.
export function removeAtomFromSet(set: string, removed: string): string {
  const s = msSetOfText(set)
  if s >= 0 {
    let r = -1
    // `null` is a KEYWORD, not a rendered shape — it is the one member the structural
    // path identifies without any name at all (`unMemKinds`), and it is the dominant
    // removal (every `!= null` else-branch).
    if removed == "null" { r = msSubNull(s) } else { r = msSubAtom(s, removed) }
    if r >= 0 { return msTextOf(r) }
  }
  removeAtomFrom(set, removed)
}

// Set subtraction that KEEPS the set identity: subtract `removed` from the set `s` and
// push the survivors as `name`'s narrowing, banking the resulting set id so the next
// complement over the same binding subtracts from a (row, mask) pair instead of parsing
// a rendered survivor list back into one. Returns the pushed rendering, or "" when the
// structural path declines — the caller then runs its unchanged string path.
function pushNarrowComplement(name: string, s: i32, removed: string): string {
  if s < 0 { return "" }
  let r = -1
  if removed == "null" { r = msSubNull(s) } else { r = msSubAtom(s, removed) }
  if r < 0 { return "" }
  const txt = msTextOf(r)
  if txt == "" { return "" }
  pushNarrowRep(name, txt, -1, r)
  txt
}

// The interned SET a binding is currently narrowed to — the set-ADT reading of
// `currentNarrowSetOf`: the innermost active narrowing's banked set when it has one,
// else the declared union's own set. -1 = no set (an `is`-pinned narrowing, an alias
// name the pool declines by design, an unregistered union), and the caller keeps the
// rendered path. The un-narrowed leg resolves exactly what `removeAtomFromSet` would
// have resolved from the same text, so the alias-decline contract is unchanged.
export function currentNarrowSetIdOf(name: string, fnIx: i32): i32 {
  const i = narrowSlotOf(name)
  if i >= 0 { return narrowSets[i] }
  msSetOfText(unionNameOfIdent(name, fnIx))
}

// The struct-union dual of `currentNarrowSetIdOf` (`currentStructNarrowSetOf`'s set):
// an un-narrowed binding resolves through the ALIAS EXPANSION its rendered twin uses.
export function currentStructNarrowSetIdOf(name: string, fnIx: i32): i32 {
  const i = narrowSlotOf(name)
  if i >= 0 { return narrowSets[i] }
  msSetOfText(unionMemberSetOf(unionNameOfIdent(name, fnIx)))
}

// MEMBERSHIP of `null` in a member set, structurally.
export function unionSetHasNull(set: string): boolean {
  const s = msSetOfText(set)
  if s >= 0 { return msHasNull(s) }
  unionHasAtom(set, "null")
}

// CARDINALITY of a member set's non-`null` members, structurally.
export function unionSetNonNullCount(set: string): i32 {
  const s = msSetOfText(set)
  if s >= 0 { return msNonNullCount(s) }
  nonNullMemberCountOf(set)
}

// ── D-UNION structural member classifiers ────────────────────────────────────
// The arena duals of the per-atom `nameIs*` re-classification the member-set
// consumers used to perform on a RENDERED member spelling. Each answers the same
// question `nameIsMap` / `nameIsClosureArray` / `valueAtomKind(.) == 11` /
// `nameIsArray(.) && nameIsMap(refArrElemName(.))` asked of the atom TEXT, from the
// member's arena type instead.

// A MAP member (`{[string]: V}`). The `nameIsMapMemberUnion` exclusion the name path
// carries is structural here for free: a union whose FIRST atom is a map renders as a
// `{[`-prefixed name but IS a `TyUnion`, never a `TyMap`.
export function unMemIsMap(m: i32): boolean {
  if m < 0 { return false }
  const t = T.tys[m]
  if t is TyMap { return true }
  false
}

// A BARE-CLOSURE member (`(() => i64) | i32` — value-atom kind 11).
export function unMemIsFunc(m: i32): boolean {
  if m < 0 { return false }
  const t = T.tys[m]
  if t is TyFunc { return true }
  false
}

// A CLOSURE-ELEMENT ARRAY member (`((i32) => f64)[]`, `nameIsClosureArray`). A
// NULLABLE-closure element (`(((i32) => boolean) | null)[]`) is a `TyNullable`
// element, not a `TyFunc` — excluded here exactly as `nameIsClosureArray` excludes it.
export function unMemIsFuncArray(m: i32): boolean {
  if m < 0 { return false }
  const t = T.tys[m]
  if t is TyArray {
    const e = T.tys[t.aElem]
    if e is TyFunc { return true }
  }
  false
}

// An ARRAY-OF-MAP member (`{[string]: V}[]`). The name path's
// `!nameIsMapMemberUnion(elem)` guard is again free: a map-member-UNION element is a
// `TyUnion`, not a `TyMap`.
export function unMemIsMapArray(m: i32): boolean {
  if m < 0 { return false }
  const t = T.tys[m]
  if t is TyArray {
    const e = T.tys[t.aElem]
    if e is TyMap { return true }
  }
  false
}

// A REF-ARRAY member whose ELEMENT type REACHES a function type — the structural dual
// of the deliberately-conservative `strContains(refArrElemName(a), "=>")` arm test
// (`calleeIsUnionElemFieldClosure`). Depth-bounded and cycle-tolerant by the bound.
export function unMemIsFuncReachArray(m: i32): boolean {
  if m < 0 { return false }
  const t = T.tys[m]
  if t is TyArray { return tyReachesFuncD(t.aElem, 12) }
  false
}

// A REF-ELEMENT array member — the structural dual of `markRefArrayArms`' gate,
// `valueAtomKind(a) < 0 && nameIsArray(a)`, over a member's rendered spelling. A
// `TyArray` whose element does NOT ride a SCALAR-leaf list backing: the i32-list leaves
// (`i32`/`boolean`/litunion and their sentinel niches — `tyIsI32LeafElem`), the
// string-list leaves (`string`, `string | null` — `tyIsStrLeafElem`), and the three
// per-width numeric lists (`f64`/`i64`/`f32`). Everything else (a struct, a union box,
// a map, a closure, a nested list, a nullable struct/list element) rides the
// `{backing,len,cap}` ref-list wrapper. A non-array member — a bare closure
// `(i32) => f64[]`, whose RENDERING ends in `[]` and which the name gate must exclude
// with `valueAtomKind == 11` — is not a `TyArray` at all.
//
// **Not** the dual of `nameIsRefArray`, which is a strict SUBSET of this: that
// predicate also demands the element be NAMEABLE by the reflist layer, folding intern
// state into a shape question. See the refutation at `unionHasRefArrayArmSlot`.
export function unMemIsRefElemArray(m: i32): boolean {
  if m < 0 { return false }
  const t = T.tys[m]
  if t is TyArray {
    const e = t.aElem
    if e < 0 { return false }
    if tyIsI32LeafElem(e) { return false }
    if tyIsStrLeafElem(e) { return false }
    const et = T.tys[e]
    if et is TyPrim {
      if et.primName == "f64" { return false }
      if et.primName == "i64" { return false }
      if et.primName == "f32" { return false }
    }
    return true
  }
  false
}

// The value-atom KIND of a union member, from the arena — the structural dual of
// `valueAtomKind(atom)` over the member's rendered spelling (the classifier
// `markValueUnionAtoms` drives the per-rep value-box flags from). Same code space,
// same ORDER of tests:
//   · a primitive answers on its own `primName` (`valueAtomKind`'s nominal half —
//     `i32`/`boolean`/`string`/`i64`/`f64`/`f32`/`null`);
//   · an i32-backed leaf array is kind 7 (`i32[]`, `boolean[]`, litunion `K[]`, and
//     the `(boolean | null)[]` / `(K | null)[]` niches `nulElemListAtomKind` folds
//     onto the i32 list) — asked FIRST, exactly as `valueAtomKind` asks its
//     `i32[]`/`boolean[]`/litunion-array arms ahead of the per-width lists;
//   · then the per-width numeric lists (8 f64, 10 i64, 12 f32) and the string-backed
//     leaf array (9 — `string[]` and the `(string | null)[]` niche);
//   · a function type is the closure atom (11), the box's anyref fat pointer.
// Anything else — a struct, a ref-element array, a map, a union — is -1, the name
// path's "not a value atom".
export function unMemAtomKind(m: i32): i32 {
  if m < 0 { return -1 }
  const t = T.tys[m]
  if t is TyPrim { return valueAtomKind(t.primName) }
  if t is TyArray {
    const e = t.aElem
    if e < 0 { return -1 }
    if tyIsI32LeafElem(e) { return 7 }
    const et = T.tys[e]
    if et is TyPrim {
      if et.primName == "f64" { return 8 }
      if et.primName == "i64" { return 10 }
      if et.primName == "f32" { return 12 }
    }
    if tyIsStrLeafElem(e) { return 9 }
    return -1
  }
  if t is TyFunc { return 11 }
  -1
}

// ── D-UNION arm-PATH walk, from the arena ────────────────────────────────────
// The `unionArmPath*` family answers "does this union arm's field path `a.b.c` leaf
// at a MAP / a list-of-maps / a closure / a closure-array / a closure-carrying value"
// by resolving the arm nominally and walking the emitter's per-field LOWERING codes
// (5 ref-list, 14 closure, 15 nested-struct, 16 union-box, 19 map, 22 nullable-closure).
// The codes are lowering decisions, but the five questions asked of them are purely
// STRUCTURAL, so the arena answers them directly — no arena→code bridge is needed:
//
//   code 15 mid hop      ≡ the field is a `TyObj` (or a `TyNullable` over one)
//   code 19 leaf         ≡ the field is a `TyMap`
//   code 5 + map elem    ≡ a `TyArray` over a `TyMap`
//   code 5 + arrow elem  ≡ a `TyArray` over a `TyFunc`
//   code 14 / 22 leaf    ≡ a `TyFunc`, bare or under a `TyNullable`
//   code 16 + clo arm    ≡ a `TyUnion` with a `TyFunc` member
//
// Every walk is narrowing-blind and conservative by design (it over-reserves a frame
// slot; an over-reservation is a harmless spare local, a MISS is invalid wasm), so the
// arena path keeps the same shape: an arm it cannot resolve answers "no".

// The inner of a `T | null`, else `ty` itself. The lowering codes fold a nullable
// struct (`next: S | null`) into the same code-15 nested-struct hop as a bare `S`, and
// a nullable closure into code 22 beside code 14's bare one.
function tyPeelNul(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if t is TyNullable { return t.nInner }
  ty
}

// The arena type of field `name` of the object type `ty` (nullable-peeled — a code-15
// hop follows `S` and `S | null` alike), or -1 when `ty` is not an object or has no
// such field.
function tyObjFieldTy(ty: i32, name: string): i32 {
  const b = tyPeelNul(ty)
  if b < 0 { return -1 }
  const t = T.tys[b]
  if t is TyObj {
    let i = 0
    while i < t.objFieldNames.length {
      if t.objFieldNames[i] == name { return t.objFieldTypes[i] }
      i = i + 1
    }
  }
  -1
}

// Walk the field path `path` from the union member type `m` and return the ARENA type
// of the LEAF field, or -1. Mid hops must be object-typed — the structural dual of the
// walk's `if code != 15 { return false }`, since a map / union-box / list mid field is
// not a `TyObj` and yields no field. The leaf comes back UNCLASSIFIED so each consumer
// applies its own predicate.
function tyArmPathLeaf(m: i32, path: string[]): i32 {
  if m < 0 || path.length == 0 { return -1 }
  let cur = m
  let hop = 0
  while hop < path.length {
    const ft = tyObjFieldTy(cur, path[hop])
    if ft < 0 { return -1 }
    if hop == path.length - 1 { return ft }
    cur = ft
    hop = hop + 1
  }
  -1
}

// The arm type a `t0[i].f…` root walks from: the ELEMENT of a ref-array arm. -1 for a
// non-array arm (the name path's `nameIsRefArray(arm)` gate, structurally).
function tyArmElem(m: i32): i32 {
  if m < 0 { return -1 }
  const t = T.tys[m]
  if t is TyArray { return t.aElem }
  -1
}

// `tyArmPathIsMap`'s leaf: a MAP field (code 19). NOT nullable-peeled — a
// `{[string]: V} | null` field is code 29, which the code walk does not accept.
export function tyArmPathIsMap(m: i32, path: string[]): boolean {
  const leaf = tyArmPathLeaf(m, path)
  if leaf < 0 { return false }
  const t = T.tys[leaf]
  if t is TyMap { return true }
  false
}

// `tyArmPathIsMapList`'s leaf: a LIST-OF-MAPS field (code 5 whose element renders as
// a map) — a `TyArray` over a `TyMap`.
export function tyArmPathIsMapList(m: i32, path: string[]): boolean {
  const leaf = tyArmPathLeaf(m, path)
  if leaf < 0 { return false }
  const t = T.tys[leaf]
  if t is TyArray {
    const e = T.tys[t.aElem]
    if e is TyMap { return true }
  }
  false
}

// `tyArmPathIsClosure`'s leaf: a closure field (code 14) or its nullable niche
// (code 22) — a `TyFunc`, bare or under one `TyNullable`.
export function tyArmPathIsClosure(m: i32, path: string[]): boolean {
  const leaf = tyArmPathLeaf(m, path)
  if leaf < 0 { return false }
  const b = tyPeelNul(leaf)
  if b < 0 { return false }
  const t = T.tys[b]
  if t is TyFunc { return true }
  false
}

// `tyArmPathIsCloArray`'s leaf: a CLOSURE-ELEMENT array field (code 5 whose element
// name carries a top-level arrow) — a `TyArray` over a `TyFunc`. A nullable-closure
// element is a `TyNullable`, excluded here exactly as the arrow scan excludes it (the
// arrow sits under the element's own parens, never at depth 0).
export function tyArmPathIsCloArray(m: i32, path: string[]): boolean {
  const leaf = tyArmPathLeaf(m, path)
  if leaf < 0 { return false }
  const t = T.tys[leaf]
  if t is TyArray {
    const e = T.tys[t.aElem]
    if e is TyFunc { return true }
  }
  false
}

// `tyArmPathHasCloValue`'s leaf: a closure field (14/22) OR a union-BOX field (16)
// whose member set has a bare-closure arm — a `TyFunc`, or a `TyUnion` with a `TyFunc`
// member. Both are nullable-peeled: an `((i32) => i32) | null` field is code 22, and a
// `(A | B) | null` box field keeps its `null` atom in the member set the code walk
// consults.
export function tyArmPathHasCloValue(m: i32, path: string[]): boolean {
  const leaf = tyArmPathLeaf(m, path)
  if leaf < 0 { return false }
  const b = tyPeelNul(leaf)
  if b < 0 { return false }
  const t = T.tys[b]
  if t is TyFunc { return true }
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      const mt = T.tys[tyPeelNul(t.uMembers[i])]
      if mt is TyFunc { return true }
      i = i + 1
    }
  }
  false
}

// True when `ty` contains a `TyFunc` anywhere in its structure (fields, elements, map
// values, nullable inners, union members) within `depth` wrapper hops.
function tyReachesFuncD(ty: i32, depth: i32): boolean {
  if ty < 0 || depth <= 0 { return false }
  const t = T.tys[ty]
  if t is TyFunc { return true }
  if t is TyArray { return tyReachesFuncD(t.aElem, depth - 1) }
  if t is TyNullable { return tyReachesFuncD(t.nInner, depth - 1) }
  if t is TyMap { return tyReachesFuncD(t.mVal, depth - 1) }
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if tyReachesFuncD(t.uMembers[i], depth - 1) { return true }
      i = i + 1
    }
    return false
  }
  if t is TyObj {
    let j = 0
    while j < t.objFieldTypes.length {
      if tyReachesFuncD(t.objFieldTypes[j], depth - 1) { return true }
      j = j + 1
    }
    return false
  }
  false
}

// The CURRENT narrowed variant set of a STRUCT-union binding `name`: its innermost
// active narrowing when one exists (which may already be a subtracted sub-set),
// else its declared union's FULL member set (alias names expanded so subtraction
// sees every variant + a `null` member). "" when not a union binding.
export function currentStructNarrowSetOf(name: string, fnIx: i32) {
  const v = narrowVariantFor(name)
  if v != "" { return v }
  unionMemberSetOf(unionNameOfIdent(name, fnIx))
}

// The map-value compat of an object literal's field VALUE against a candidate
// variant's code-19 field: the literal's checker-recorded map value type must not
// contradict the variant's recorded value rep (`elem`). Lenient when the value is
// not classifiable as a map (a non-map value already fails the construct loudly
// downstream); an ATOM-valued literal field is compatible with any MONO elem (both
// ride the shared `$mStructIdx` — the checker render would collapse it to `string`,
// so it is classified through the recorded litunion bit BEFORE rendering).
function objMapFieldCompat(objIx: i32, fname: string, elem: string): boolean {
  const valIx = objFieldVal(objIx, fname)
  if valIx < 0 { return true }
  if !nodeTyIsMap(valIx) { return true }
  if nodeTyMapValIsLitUnion(valIx) { return mvValKindOfName(elem) == -1 }
  mvValNamesCompat(nodeTyMapValName(valIx), elem)
}

// The nested-struct compat of an object literal's field VALUE against a candidate
// variant's code-15 field: a nested LITERAL value's field-NAME set must equal the
// recorded target struct's (`elem`) — the code-15 twin of `objMapFieldCompat`.
// NAME-set only, deliberately: the checker records the literal's INFERRED leaf types
// (`{f: 663810583}` reads i32 where the arm declares i64), so a canonical-key compare
// here false-rejects every widening construct. A non-literal value stays lenient (its
// type already checked at the boundary; a wrong one fails loudly downstream).
function objNestedFieldCompat(
  objIx: i32,
  fname: string,
  elem: string,
): boolean {
  const valIx = objFieldVal(objIx, fname)
  if valIx < 0 { return true }
  const v = P.nodes[unwrapParen(valIx)]
  if v is ObjLit {
    const si = structIndexByName(elem)
    if si < 0 { return true }
    if v.objFields.length != sFieldCount[si] { return false }
    let fi = 0
    while fi < sFieldCount[si] {
      if objFieldVal(valIx, sFieldNames[sFieldStart[si] + fi]) < 0 {
        return false
      }
      fi = fi + 1
    }
  }
  true
}

// The variant struct name an object literal at `objIx` matches: the union variant
// whose field-name set EQUALS the literal's field names (order-independent), or "" if
// none. Used to pick the tag + variant struct when boxing an object literal into the
// union. A MAP-typed candidate field (code 19) is additionally tightened by its VALUE
// rep (`objMapFieldCompat`): two unions' arms sharing the field-name set but differing
// in the map's VALUE (`{f: {[string]: i32}} | i32` and `{f: {[string]: string}} | i64`
// in one program) must not collide onto the first arm's slot — the literal's typed map
// ref then mis-fed the other value rep's struct (invalid wasm at the construct).
export function objVariantName(objIx: i32) {
  const o = P.nodes[objIx]
  if o is ObjLit {
    let vi = 0
    while vi < uVariants.length {
      if objMatchesVariantIdx(objIx, vi) { return uVariants[vi] }
      vi = vi + 1
    }
  }
  ""
}

// Whether the object literal at `objIx` matches variant `vi`: the field-name set
// EQUALS the variant's (order-independent), tightened per field by the value rep — a
// map field (code 19) by `objMapFieldCompat`, a nested-struct field (code 15) by
// `objNestedFieldCompat`. The one matcher behind `objVariantName` (global scan) and
// `unionArmVariantForObj` (union-context scan), so the two resolutions never diverge.
function objMatchesVariantIdx(objIx: i32, vi: i32): boolean {
  const o = P.nodes[objIx]
  if o is ObjLit {
    const cnt = uFieldCount[vi]
    if cnt != o.objFields.length { return false }
    const start = uFieldStart[vi]
    let allMatch = true
    let fj = 0
    while fj < cnt {
      if objFieldVal(objIx, uFieldNames[start + fj]) < 0 {
        allMatch = false
      } else if uFieldTypes[start + fj] == 19 {
        if (
          !objMapFieldCompat(
            objIx,
            uFieldNames[start + fj],
            uFieldElemName[start + fj],
          )
        ) {
          allMatch = false
        }
      } else if uFieldTypes[start + fj] == 15 {
        // A NESTED-STRUCT candidate field (code 15) is tightened by its target's
        // field-name set, exactly as a map field is by its value rep.
        if (
          !objNestedFieldCompat(
            objIx,
            uFieldNames[start + fj],
            uFieldElemName[start + fj],
          )
        ) {
          allMatch = false
        }
      }
      fj = fj + 1
    }
    return allMatch
  }
  false
}

// The VARIANT table index of the arm OF THE UNION whose registered member set is
// `unionSet` (pipe-joined) that the object literal at `objIx` matches, or -1. The
// union-CONTEXT-restricted `objVariantName`: `emitUnionCoerce` KNOWS its target
// union, so the literal must match one of ITS arms — the global scan's first
// name-set match can land on ANOTHER union's arm sharing the field names (two
// unions' nested-struct arms differing only in a nested layout collided onto the
// first arm's tag — a silent wrong-arm construct). Falls back to -1 (caller keeps
// the global scan) when the set is not a registered union.
export function unionArmVariantForObj(unionSet: string, objIx: i32): i32 {
  let u = 0
  while u < unNames.length {
    if unNames[u] == unionSet || unMemberSet[u] == unionSet {
      let vi = unVarStart[u]
      while vi < unVarStart[u] + unVarCount[u] {
        if objMatchesVariantIdx(objIx, vi) { return vi }
        vi = vi + 1
      }
      return -1
    }
    u = u + 1
  }
  -1
}

// True if the PLAIN struct at table index `ssi` has the SAME field layout (name set,
// count, per-field type code) as the union-variant arm `vi` — the struct-index dual of
// `objMatchesVariantIdx` (which matches an object LITERAL). Used to recognize a struct-
// typed value (an ident / call result — built as the plain struct, a DISTINCT heap type
// from the arm's variant struct) as a member of the union so it can be re-boxed.
function structIdxMatchesVariantIdx(ssi: i32, vi: i32): boolean {
  if ssi < 0 { return false }
  const cnt = uFieldCount[vi]
  if cnt != sFieldCount[ssi] { return false }
  const start = uFieldStart[vi]
  let fj = 0
  while fj < cnt {
    const fname = uFieldNames[start + fj]
    const sfi = sFieldIndex(ssi, fname)
    if sfi < 0 { return false }
    if sFieldTypeAt(ssi, sfi) != uFieldTypes[start + fj] { return false }
    fj = fj + 1
  }
  true
}

// The union VARIANT arm (of `unionSet`) whose struct layout matches the struct-typed
// expression at `exprIx`, or -1. The struct-EXPRESSION dual of `unionArmVariantForObj`:
// a struct-typed IDENT / call result flowing into `unionSet` was BUILT as the plain
// struct (its own interned heap type), which is a layout TWIN of — but a DISTINCT type
// from — the union's variant struct; the emitter re-boxes it against the matched arm
// (`emitStructExprAsVariantBox`) so the box payload is the arm's variant-struct type the
// narrow (`is {…}`) casts to. Restricted to `unionSet`'s own arms exactly as
// `unionArmVariantForObj` is (a global field-name-set scan can pick another union's arm).
export function unionArmVariantForStructExpr(
  unionSet: string,
  exprIx: i32,
  fnIx: i32,
): i32 {
  const ssi = structIndexOfExpr(exprIx, fnIx)
  if ssi < 0 { return -1 }
  let u = 0
  while u < unNames.length {
    if unNames[u] == unionSet || unMemberSet[u] == unionSet {
      let vi = unVarStart[u]
      while vi < unVarStart[u] + unVarCount[u] {
        if structIdxMatchesVariantIdx(ssi, vi) { return vi }
        vi = vi + 1
      }
      return -1
    }
    u = u + 1
  }
  -1
}

// True if re-evaluating the expression at `exprIx` is SIDE-EFFECT-FREE and yields the
// same value — an ident (local / param / global / captured), a parenthesized such, or a
// pure field/index navigation of one. A CALL is NOT re-readable (its effects would fire
// again, and a fresh allocation each time). Gates the field-copy variant re-box, which
// re-emits the source once PER FIELD.
export function exprReReadable(exprIx: i32): boolean {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Ident { return true }
  if e is Paren { return exprReReadable(e.parInner) }
  if e is Member { return exprReReadable(e.memObj) }
  if e is Index {
    return exprReReadable(e.idxArr) && exprReReadable(e.idxIndex)
  }
  false
}

// ── array-typedness of expressions ───────────────────────────────────────────
// Parallel to the struct family above: decide whether an expression / param / local
// PRODUCES the i32 array (a `(ref $aTypeIdx)`) rather than an i32. An index read
// `a[i]` and `a.length` are i32 (NOT arrays), so they are deliberately absent here.

// True if the function `name` declares an array (`i32[]`) as its return type.
function fnRetArraySid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "list"
}

// True if the already-collected declared local `name` is an i32-array ref (code `2`).
function declaredArray(name: string) { declaredKind(name) == "list" }

// True if evaluating the expression at `exprIx` yields the i32 array: an array
// literal (with i32 / no elements — a ref-element literal is NOT this), an
// array-returning call, an array param/local reference, or a parenthesized array
// The wasm-type code of the struct / variant FIELD a `Member` expression at `memIx`
// reads (`0` i32, `3` string, `4` i32-list, `5` ref-list), or `-1` if `memIx` is not a
// field read of a known struct/variant field. Mirrors `exprString`'s Member dispatch:
// a read on a NARROWED union identifier reads the variant field's type; otherwise the
// receiver's struct field's type. Used by `exprArray`/`exprRefArray` to type array-field
// reads (gap #5) so `.length` / indexing / assignment treat the result as a list.
function memFieldTypeCode(memIx: i32, fnIx: i32) {
  const e = P.nodes[memIx]
  if e is Member {
    if memIsNarrowed(memIx) {
      const vi = memNarrowVariantIndex(memIx)
      if vi >= 0 {
        const vfi = variantFieldIndex(vi, e.memProp)
        if vfi >= 0 { return variantFieldTypeAt(vi, vfi) }
      }
      return -1
    }
    // A field read on a VARIANT-typed param `o.field` (`o: TyObj`) reads the variant
    // struct's field type directly (gap #2) — same table as a narrowed read, but the
    // receiver is the unboxed param, not a `narrowName` ident.
    const pvi = exprVariantIndex(e.memObj, fnIx)
    if pvi >= 0 {
      const pvfi = variantFieldIndex(pvi, e.memProp)
      if pvfi >= 0 { return variantFieldTypeAt(pvi, pvfi) }
    }
    const si = structIndexOfExpr(e.memObj, fnIx)
    if si >= 0 {
      const fi = sFieldIndex(si, e.memProp)
      if fi >= 0 { return sFieldTypeAt(si, fi) }
    }
  }
  -1
}

// expression. An index read / `.length` yields an i32, so neither counts.
// True when the ident `name`, read inside frame `fnIx`, is SHADOWED by a binding of
// the frame itself — a declared param of `fnIx`, or a collected declared local (the
// per-function `localNames` registry; at module scope the registry holds the start
// function's loop vars / block-nested lets). The `expr*Array` GLOBAL fallbacks must
// not resolve `name` through a module global when such an inner binding exists:
// scope resolution picks the inner binding whatever its kind, so the global's kind
// is not this read's kind. (The #922 shadow hole: a param/local list named like a
// GLOBAL list of a DIFFERENT element kind routed `.push` through the global's
// classification — the push frame's typed locals then mismatched the receiver's
// actual wrapper ref, invalid wasm.) Each classifier checks its OWN param/declared
// kind BEFORE its global fallback, so gating only the fallback preserves every
// same-kind answer and only turns the cross-kind global claim off.
function identShadowedByFrame(fnIx: i32, name: string) {
  if paramIndexOf(fnIx, name) >= 0 { return true }
  declaredSlotOf(name) >= 0
}

export function exprArray(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  if tyKindOf(nodeTyIxOf(exprIx)) == 2 {
    return true // typed-IR fast path (see exprIsF64)
  }
  const e = P.nodes[exprIx]
  if e is ArrayLit { return !arrLitIsRef(exprIx) }
  if e is Paren { return exprArray(e.parInner, fnIx) }
  if e is Call {
    // An INDEXED closure call `fs[i](x)` whose element signature returns `i32[]`.
    if cloArrCallRetKind(exprIx, fnIx) == "list" { return true }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      // The intrinsic allocators yield an i32 list unless the fill is f64
      // (`arrNewIntrKind` 1 — then `exprF64Array` claims the call).
      if arrNewIntrKind(exprIx, fnIx) == 0 { return true }
      if fnRetArraySid(sidOfNode(e.callFn)) { return true }
      // A closure-VALUE call (`g(x)` with `g: (i32) => i32[]`) whose resolved sig
      // result is the i32 list (`>a`) — so `const xs = g(x)` types `xs` as a
      // list and its `.length` / index reads lower through the list machinery.
      return calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "list"
    }
    // `xs.map(f)` / `xs.filter(p)` yield a NEW list — the i32 list exactly when the
    // result ELEMENT kind is i32/boolean (map: the callback's return kind; filter:
    // the receiver's element kind).
    if callIsMapFilter(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "i32"
    }
    // `xs.slice(...)` yields the same list kind as its receiver — an i32 list iff the
    // receiver is one.
    if callIsArrSlice(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "i32"
    }
    // `m.values()` over an i32-valued map yields an i32 list.
    if mapValuesResultKind(exprIx, fnIx) == 2 { return true }
    // `m.keys()` over the i32-KEYED rep yields an i32 list of its keys — the twin of
    // the string-keyed `.keys()` claimed by the string-list classifier.
    const kc32 = P.nodes[e.callFn]
    if kc32 is Member {
      if kc32.memProp == "keys" {
        if exprMap(kc32.memObj, fnIx) {
          if mapShapeKeyI32(mapShapeOfExpr(kc32.memObj, fnIx)) { return true }
        }
      }
    }
    return false
  }
  if e is Ident {
    // A value-union ident narrowed to a KIND-7 i32-backed LIST atom classifies as an
    // i32 list in the narrowed branch, checked FIRST — the binding's DECLARED type is
    // the union, so the param/local/global tests below miss it. Two narrowing spellings:
    // `is i32[]` / `is (boolean | null)[]` / `is (K | null)[]` read UNBOXED via
    // `emitValueUnionUnboxRead` (the union-ident read kind), and `is K0[]` (a
    // litunion-array member on the i32-list backing) via the narrowed value-atom.
    if unionIdentReadKind(exprIx, fnIx) == 7 { return true }
    if valueAtomKind(narrowedValueAtomOf(e.identName)) == 7 { return true }
    if paramArray(fnIx, e.identName) { return true }
    if declaredArray(e.identName) { return true }
    if globalIsArraySid(sidOfNode(exprIx)) {
      if !identShadowedByFrame(fnIx, e.identName) { return true }
    }
    // A NULLABLE i32-list binding (`i32[] | null`, kind 15) participates in the
    // list machinery — narrowing is type-level, so every list op classifies the
    // read as a list; the op's read site inserts the `ref.as_non_null` recover.
    if paramNulList(fnIx, e.identName) { return true }
    if declaredNulList(e.identName) { return true }
    if globalIsNulListSid(sidOfNode(exprIx)) {
      if !identShadowedByFrame(fnIx, e.identName) { return true }
    }
    // A CAPTURED i32-list read (`store[k]` inside a closure capturing `store`).
    return capturedKindOf(fnIx, e.identName) == "list"
  }
  // A list CONCAT `a + b` yields a NEW i32 list (collections-design §VL.4).
  if e is BinExpr {
    if e.binOp == "+" {
      if (
        exprArray(e.binLeft, fnIx) &&
        !exprStringArray(e.binLeft, fnIx) &&
        !exprRefArray(e.binLeft, fnIx)
      ) {
        return exprArray(e.binRight, fnIx)
      }
    }
    // `m[k] ?? d` over an i32-LIST-valued map (`{[string]: i32[]}`) yields the value i32 list.
    if e.binOp == "??" {
      if mvListValKind(coalesceMvSlot(exprIx, fnIx)) == "list" { return true }
      // The NON-map `p ?? d` over the i32-list niche is the i32-list wrapper in BOTH halves —
      // the rep does not change, only its nullability (`exprNullableList`'s own `??` arm), the
      // same reason the nullable-list Ident arms above claim unconditionally.
      if exprNullableList(e.binLeft, fnIx) { return true }
    }
    return false
  }
  // A field read `p.items` whose struct field is an `i32[]` (code `4`) yields the i32
  // list wrapper ref — so `.length` / indexing / assignment treat it as a list (gap #5).
  // A NULLABLE list field (code 18) classifies the same way (see the Ident rule).
  if e is Member {
    if memFieldTypeCode(exprIx, fnIx) == 4 { return true }
    if memFieldTypeCode(exprIx, fnIx) == 18 { return true }
  }
  // `m[i]` over an `i32[][]` ref list (element kind 4) yields the INNER i32 list,
  // so a chained `m[i][j]` / `m[i].length` treats it as a list.
  if e is Index {
    if nestedRefListElemIs(e.idxArr, fnIx, 4) { return true }
    // A bare `m[k]` over an i32-LIST-valued map yields the value i32 list (`V | null` — the
    // list machinery recovers non-null at the read site).
    if mvListValKind(mapReadMvSlot(exprIx, fnIx)) == "list" { return true }
  }
  false
}

// True if the `LetDecl` at `letIx` declares an array-typed local: its annotation is an
// array type (`i32[]`), OR its initializer produces an array. Picks the local's
// valtype (`(ref $aTypeIdx)` vs i32) in `collectLocals`.
export function letIsArray(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      // ARENA-FIRST: where the checker's arena decides the annotation's rep, the i32-list
      // question IS "is that rep the i32 list" — no name parse. `nameIsI32Array`'s folds
      // (`boolean[]`, litunion `K[]`) are the arena's `"list"` arm; its POSITION-decided
      // spellings (an INLINE litunion element, the `(boolean|null)[]`/`(K|null)[]` niches)
      // are deliberately uncovered there, so they keep the name test below.
      const k = annRepKindOf(d.letType)
      if k != null {
        if k == "list" { return true }
      } else {
        const lt = P.nodes[d.letType]
        if lt is TypeRef {
          if nameIsI32Array(lt.tyName) { return true }
        }
      }
    }
    return exprArray(d.letInit, fnIx)
  }
  false
}

// ── ref-array-typedness of expressions (G7-ref) ───────────────────────────────
// Parallel to the i32-array family: decide whether an expression / param / local
// PRODUCES a REF list — `Tok[]` / `Node[]`, a `(ref $rlTypeIdx)`. Its receiver shapes
// mirror `exprArray` but for `S[]`/`N[]` annotations (the index/`.length` reads still
// yield i32 / the element, not the list). `localIsRef` code `5` flags a ref-list local.

// True if function `name` declares a ref array (`S[]`/`N[]`) as its return type.
function fnRetRefArraySid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "reflist"
}

// True if the parameter `name` of function `fnIx` is a ref-array type.
function paramRefArray(fnIx: i32, name: string) {
  const pt = paramTypeNode(fnIx, name)
  // STRUCTURAL fast-path (C1): a recorded array-of-declared-struct param, else the name test.
  if nodeTyIsStructArray(pt) { return true }
  // A ref-list ROW for the param's element — the intern-state question, covering the
  // nested / union / closure / niche element spellings the struct-array fast path declines.
  // Non-nullable only (a `S[] | null` param is `paramNulRefArray`'s).
  annBareRefArrSlot(pt) >= 0
}

// True if the parameter `name` of function `fnIx` is a NULLABLE ref-array type (`<ref-array> | null`,
// kind 18 — e.g. `i32[][] | null`, `S[] | null`). The param analogue of `paramRefArray`: `retNulRefArrFlag`
// (already `| null`-aware) recognizes the annotation. Lets `exprNullableRefArray` / `exprRefArray` classify
// a nulreflist PARAM (its `!= null` narrow + narrowed indexing), which #877 wired only for a LOCAL.
function paramNulRefArray(fnIx: i32, name: string) {
  retNulRefArrFlag(paramTypeNode(fnIx, name)) == 1
}

// True if the already-collected declared local `name` is a ref-list ref (code `5`).
function declaredRefArray(name: string) { declaredKind(name) == "reflist" }

// True if evaluating the expression at `exprIx` yields a ref list: a ref-element array
// literal, a ref-array-returning call, a ref-array param/local reference, or a
// parenthesized ref-array expression. An index read / `.length` is NOT a list.
export function exprRefArray(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is ArrayLit { return arrLitIsRef(exprIx) }
  if e is Paren { return exprRefArray(e.parInner, fnIx) }
  // `m[k]` / `m[k] ?? d` over a struct-LIST-valued map yields a struct ref list.
  if mapReadListKind(exprIx, fnIx) == "reflist" { return true }
  if e is Call {
    // `__array_new__(n, {…})` builds a ref list of the element struct (kind 3).
    if arrNewIntrKind(exprIx, fnIx) == 3 { return true }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if fnRetRefArraySid(sidOfNode(e.callFn)) { return true }
      // A closure-VALUE callee returning a ref list (`mk: () => S[]`) — its resolved `$fnsig`
      // result is the ref-list wrapper (`>r<slot>;`), so `mk()[i]` indexes it directly.
      return calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "reflist"
    }
    // A `.filter` over a struct/union array yields the SAME ref list (kind 2).
    if callee is Member {
      if mfResultKindOf(exprIx, fnIx) == "ref" { return true }
    }
    // `m.values()` over a struct- / nested-list- / nested-map-valued map yields a ref list.
    if mapValuesResultKind(exprIx, fnIx) == 5 { return true }
    // GENERAL FALLBACK: a value call the resolvers above miss — a NARROWED union
    // binding's closure arm (`t0(1)` after `if t0 is (i32) => S[]`), a struct-FIELD
    // closure (`v.f(1)`), an INDEXED closure-array element (`v[0](1)`) — classifies by
    // its resolved `$fnsig` result (`cloCallSigKey`, whose own fallback derives the key
    // from the callee's CHECKER type). The consumer dual of the call emit's sig
    // resolution, so the two always agree. A UNION-BOX element slot (kind 2 —
    // `(i64 | string)[]`) is claimed too: the element's narrowed binding read rides the
    // interned union-box element machinery, and the lambda-side sig now adopts the
    // union-element list result, so the producers agree with this claim.
    const gk = cloCallSigKey(exprIx, fnIx)
    if sigKeyRetKind(gk) == "reflist" {
      const gs = sigKeyRetSlot(gk)
      if gs >= 0 && gs < rlElemKindTbl.length { return true }
    }
    return false
  }
  if e is Ident {
    // A union binding NARROWED to a ref-element array arm (`if x is S[]` then `x[i]` / `x.length`):
    // its box unboxes to the reflist wrapper, so it IS a ref array in the narrowed branch. Checked
    // FIRST — the binding's DECLARED type is a union, so the param/local/global tests below miss it.
    if narrowedRefArrayOf(e.identName) != "" { return true }
    // A kind-18 NULLABLE ref-array local is a ref array too (narrowed `if t != null`) — so indexing /
    // `.length` reuse the ref-array machinery; the index emit recovers non-null for the niche receiver.
    if declaredKind(e.identName) == "nulreflist" { return true }
    // A nulreflist PARAM narrowed non-null is a ref array too — index / `.length` reuse the
    // ref-array machinery (the index emit recovers non-null for the niche receiver).
    if paramNulRefArray(fnIx, e.identName) { return true }
    if paramRefArray(fnIx, e.identName) { return true }
    if declaredRefArray(e.identName) { return true }
    if identShadowedByFrame(fnIx, e.identName) { return false }
    // A kind-18 nullable ref-array GLOBAL is a ref array too — the third storage
    // class, and the one this arm never grew (the local reads `declaredKind`, the
    // param `paramNulRefArray`, and both sit above). Without it every ref-list op
    // over `let g: S[] | null` missed the ref-list machinery: with an EMPTY `[]`
    // initializer `exprArray`'s init fallback claimed the read as an i32 list and
    // `.length` / `.push` / a call argument addressed the MONO i32-list wrapper
    // against the cell's ref-list wrapper (invalid wasm, `vl check` clean); with a
    // `= null` initializer no classifier claimed it at all and the read fell out of
    // the list family entirely (a loud emit error).
    if globalIsNulRefArraySid(sidOfNode(exprIx)) { return true }
    return globalIsRefArraySid(sidOfNode(exprIx))
  }
  // A field read `p.items` whose struct field is a `T[]`/`N[]` (code `5`) yields the ref
  // list wrapper ref — so `.length` / indexing / assignment treat it as a ref list.
  if e is Member {
    if memFieldTypeCode(exprIx, fnIx) == 5 { return true }
  }
  // Indexing a NESTED ref array (`g[i]` where `g: S[][]`, kind-9 elements): each element IS the
  // inner ref list, so the index yields a ref array. Recurses — `g[i][j]` over `S[][][]` is a ref
  // array too (the inner slot is itself kind 9).
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemKindTbl.length {
        return rlElemKindTbl[slot] == 9
      }
    }
  }
  // `p ?? d` over the `<ref-array> | null` niche is the ref-list wrapper in BOTH halves — the
  // rep is unchanged, only its nullability (`exprNullableRefArray`'s own `??` arm), the same
  // reason the kind-18 local / param / global Ident arms above claim unconditionally.
  const raLhs = coalesceNicheLhs(exprIx)
  if raLhs >= 0 {
    if exprNullableRefArray(raLhs, fnIx) { return true }
  }
  false
}

// The ref-list ELEMENT type-NAME a ref-array param `name` of function `fnIx` declares
// (`p: Tok[]` → `Tok`), or "" if not a ref-array param.
function paramRefArrayName(fnIx: i32, name: string) {
  if fnIx < 0 {
    return "" // module-scope initializer (no enclosing function)
  }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const params = fn.fnParams
    let i = 0
    while i < params.length {
      const p = P.nodes[params[i]]
      if p is Param {
        if p.parName == name {
          if p.parType >= 0 {
            const ty = P.nodes[p.parType]
            // `refArrElemNameIf` (the `nameIsRefArray`-gated element read): its "" for a
            // non-ref-array annotation is the same "" the next line returns.
            if ty is TypeRef { return refArrElemNameIf(ty.tyName) }
          }
          return ""
        }
      }
      i = i + 1
    }
  }
  ""
}

// The ref-list ELEMENT type-NAME a function `name` returns (from its `S[]`/`N[]` return
// annotation, recorded in `fRetRArrElem`), or "".
function fnRetRefArrayNameSid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return "" }
  fRetRArrElem[i]
}

// The INNER ref-list element type-NAME a function `name` returns when its return is a NULLABLE ref array
// (`i32[][] | null` → the inner `i32[]`), else "". Reads the return-type node directly (`fRetRArrElem`
// records only the NON-null ref-array element), so a consumer `const t = mk()` infers the kind-18 niche
// and its `!= null` narrow + narrowed indexing resolve the inner ref-list slot.
function fnRetNulRefArrayNameSid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return "" }
  const fn = P.nodes[fnStmts[i]]
  if fn is FuncDecl {
    if fn.fnRet >= 0 {
      // `refArrElemNameIf` (the `nameIsRefArray`-gated element read). The `np != ""`
      // conjunct is KEPT rather than folded in: it is master's short-circuit, and
      // `nameIsRefArray("")` is not free (an `annArrowAt` scan, a `nameIsLitUnionArray`
      // and a whole `refArrShapeKind` ladder) — D-GRAMHOME's rule again.
      const np = nullablePartOf(tyNameOf(fn.fnRet))
      if np != "" { return refArrElemNameIf(np) }
    }
  }
  ""
}

// The ref-list ELEMENT type-NAME of the declared local `name` (recorded in
// `localStructIdx` as its table SLOT for code-5 locals), or "".
function declaredRefArrayName(name: string) {
  const i = declaredSlotOf(name)
  if i >= 0 {
    if localIsRef[i] == "reflist" {
      const slot = localStructIdx[i]
      if slot >= 0 {
        if slot < rlElemName.length { return rlElemName[slot] }
      }
    }
  }
  ""
}

// The ref-list ELEMENT type-NAME a module global `name` declares (`S[]`/`N[]`), or "".
function globalRefArrayName(name: string) {
  const li = globalLetOf(name)
  if li < 0 { return "" }
  letRefListElemName(li, -1)
}

// The ref-list ELEMENT type-NAME the expression at `exprIx` produces, or "" if it is not
// a ref list. Mirrors `exprRefArray`'s receiver shapes — used to resolve the per-element-
// type table SLOT (`refListSlotOfExpr`) at every push / index / `.length` / store site.
export function refListElemNameOfExpr(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return "" }
  const e = P.nodes[exprIx]
  if e is ArrayLit { return arrLitElemName(exprIx) }
  if e is Paren { return refListElemNameOfExpr(e.parInner, fnIx) }
  // `m[k]` / `m[k] ?? d` over a struct-LIST-valued map — the element is the value's struct.
  const slsMv = mapReadStructListMvSlot(exprIx, fnIx)
  if slsMv >= 0 { return refArrElemName(mvValName[slsMv]) }
  if e is Call {
    // `__array_new__(n, {…})` — the ref-list element name is the fill's struct.
    if arrNewIntrKind(exprIx, fnIx) == 3 {
      const asi = structIndexOfExpr(e.callArgs[1], fnIx)
      if asi >= 0 { return sNames[asi] }
      return ""
    }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const fn = fnRetRefArrayNameSid(sidOfNode(e.callFn))
      if fn != "" { return fn }
      // A nulreflist-returning function (`mk: () => i32[][] | null`): the INNER ref-list element name.
      const nfn = fnRetNulRefArrayNameSid(sidOfNode(e.callFn))
      if nfn != "" { return nfn }
      // A closure-VALUE callee returning a ref list (`mk: () => S[]`): its element name is the
      // `rlElemName` of the `>r<slot>;` result slot parsed off the callee's resolved `$fnsig`
      // (kind-gated on `"reflist"` — the shared slot reader parses ANY slot-carrying result).
      const ck = calleeCloSigKeySid(sidOfNode(e.callFn), fnIx)
      if sigKeyRetKind(ck) == "reflist" {
        const rs = sigKeyRetSlot(ck)
        if rs >= 0 && rs < rlElemName.length { return rlElemName[rs] }
      }
      // A NARROWED union binding's closure arm (`t0(1)` after `if t0 is (i32) => S[]`):
      // the name-based `calleeCloSigKey` misses it, but the general `cloCallSigKey`
      // fallback derives the key from the callee's CHECKER type — the same key the call
      // emit resolves, so the element slot always matches the called functype's. A
      // union-box element slot (kind 2) resolves too, like `exprRefArray`'s fallback.
      const nk = cloCallSigKey(exprIx, fnIx)
      if sigKeyRetKind(nk) == "reflist" {
        const nrs = sigKeyRetSlot(nk)
        if nrs >= 0 && nrs < rlElemName.length { return rlElemName[nrs] }
      }
      return ""
    }
    // A ref-valued `m.values()` yields a ref list whose element is the map's VALUE — read
    // its name off the value's mv ref-list slot (`mvRlSlot`). Checked before the `.filter`
    // result-slot path (a `.values()` is not a `.map`/`.filter`).
    if callee is Member {
      if callee.memProp == "values" {
        if exprMap(callee.memObj, fnIx) {
          const vsh = mapShapeOfExpr(callee.memObj, fnIx)
          if vsh >= 0 {
            const rs = mvRlSlot[vsh]
            if rs >= 0 { return rlElemName[rs] }
          }
        }
      }
      const ms = mfResultSlotOf(exprIx, fnIx)
      if ms >= 0 { return rlElemName[ms] }
    }
    // A struct-FIELD closure call (`v.f(1)` — the callee is a Member) or an INDEXED
    // closure-array element call (`v[0](1)` — the callee is an Index) whose result is a
    // ref list: the resolved `$fnsig` result slot names the element (the same
    // `cloCallSigKey` fallback as the Ident-callee arm above; a union-box element slot
    // — kind 2 — likewise resolves).
    const mk2 = cloCallSigKey(exprIx, fnIx)
    if sigKeyRetKind(mk2) == "reflist" {
      const mrs2 = sigKeyRetSlot(mk2)
      if mrs2 >= 0 && mrs2 < rlElemName.length { return rlElemName[mrs2] }
    }
    return ""
  }
  if e is Ident {
    // A union binding NARROWED to a ref-element array arm (`if x is S[]` then `x[i]`): its element
    // name is the arm's, so `refListSlotOfExpr` resolves the wrapper the narrowed read casts to.
    const raN = narrowedRefArrayOf(e.identName)
    if raN != "" { return refArrElemName(raN) }
    // A kind-18 nullable ref-array local stores its INNER ref-list slot in `localStructIdx`; its element
    // name is that inner slot's element name, so `refListSlotOfExpr` round-trips back to the inner slot.
    if declaredKind(e.identName) == "nulreflist" {
      const sl18 = declaredSlotOf(e.identName)
      if sl18 >= 0 {
        const is18 = localStructIdx[sl18]
        if is18 >= 0 && is18 < rlElemName.length { return rlElemName[is18] }
      }
    }
    // A nulreflist PARAM (`p: i32[][] | null`) — its inner ref-list element name is the ref-array's
    // element (`refArrElemName` of the `| null`-stripped annotation), so `refListSlotOfExpr` resolves
    // the inner wrapper the narrowed `p[i]` read casts to (the param analogue of the local block above).
    if paramNulRefArray(fnIx, e.identName) {
      const np18 = nullablePartOf(tyNameOf(paramTypeNode(fnIx, e.identName)))
      if np18 != "" { return refArrElemName(np18) }
    }
    const pn = paramRefArrayName(fnIx, e.identName)
    if pn != "" { return pn }
    const dn = declaredRefArrayName(e.identName)
    if dn != "" { return dn }
    // A kind-18 nullable ref-array GLOBAL keeps its inner ref-list ROW on the
    // ANNOTATION (there is no local slot to read) — the SAME place `emitGlobalSection`
    // takes the cell's `(ref null $wrapper)` from, so the read resolves the wrapper the
    // cell actually holds. `globalRefArrayName` below cannot: its `letRefListElemName`
    // reads a BARE ref-array annotation and then falls through to the initializer, which
    // for the `[]` / `null` spellings names no element at all (slot 0 — whatever row that
    // happens to be).
    if globalIsNulRefArraySid(sidOfNode(exprIx)) {
      const g18 = globalLetOf(e.identName)
      const gs18 = letAnnRefListSlot(g18)
      if gs18 >= 0 && gs18 < rlElemName.length { return rlElemName[gs18] }
    }
    return globalRefArrayName(e.identName)
  }
  if e is Member {
    // A `recv.field` ref-list field read — the field's element name from the receiver's
    // struct / narrowed variant.
    if memIsNarrowed(exprIx) {
      const vi = memNarrowVariantIndex(exprIx)
      if vi >= 0 {
        const vfi = variantFieldIndex(vi, e.memProp)
        if vfi >= 0 { return uFieldElemName[uFieldStart[vi] + vfi] }
      }
      return ""
    }
    const si = structIndexOfExpr(e.memObj, fnIx)
    if si >= 0 {
      const fi = sFieldIndex(si, e.memProp)
      if fi >= 0 { return sFieldElemNameAt(si, fi) }
    }
  }
  // Indexing a NESTED ref array (`g[i]` where `g: S[][]`): the element of `g[i]` is the element
  // of `g`'s element list — strip ONE `[]` off `g`'s element name (`S[]` → `S`). Recurses for
  // deeper nesting (`g[i][j]` over `S[][][]`).
  if e is Index {
    const outer = refListElemNameOfExpr(e.idxArr, fnIx)
    if outer != "" && nameIsArray(outer) { return refArrElemName(outer) }
  }
  // `p ?? d` over a `<ref-array> | null` niche yields the SAME inner ref list, so its element
  // name is the LHS place's — `refListSlotOfExpr` then round-trips the `??` result back to the
  // very row `emitCoalesce` declared its block type from.
  //
  // THE NICHE'S OWN INNER-SLOT RESOLVER ANSWERS FIRST, because the recursion below cannot for
  // every LHS: an `Index` over a `(<ref-array> | null)[]` names its element `i32[][] | null`,
  // which the arm above declines (`nameIsArray` says no to a `| null` suffix) while
  // `nulRefArrayInnerSlot`'s kind-9 arm resolves the row directly. Asking only the recursion
  // left the NON-null half of that LHS (`xs[i] ?? [[7]]`) with no shape to name.
  const rlnLhs = coalesceNicheLhs(exprIx)
  if rlnLhs >= 0 {
    const rlnIn = nulRefArrayInnerSlot(rlnLhs, fnIx)
    if rlnIn >= 0 && rlnIn < rlElemName.length { return rlElemName[rlnIn] }
    return refListElemNameOfExpr(rlnLhs, fnIx)
  }
  ""
}

// The per-element-type ref-list table SLOT the expression at `exprIx` produces, or 0
// (slot fallback) if the element type can't be resolved — every migrated site uses this
// to pick the right backing/wrapper/element indices.
export function refListSlotOfExpr(exprIx: i32, fnIx: i32) {
  const nm = refListElemNameOfExpr(exprIx, fnIx)
  const s = rlSlotByName(nm)
  if s < 0 { return 0 }
  s
}

// The `pendingListKind` an EXPRESSION's list CELL demands — the same 0/1/2/3/4/5/6/7
// vocabulary `tyAnnRefListKind` produces from an ANNOTATION node, for the positions that
// have no annotation node left to read. A declared LOCAL's annotation is compiled away by
// `buildLocals` into the slot tables, and a PARAM's lives on the `FuncDecl`, so an
// ASSIGNMENT whose target is either one cannot use the `LetDecl`-keyed `letAnnRefListKind`
// the global arm and `emitLetDeclStmt` share. Every leg answers off the SAME classifiers the
// rest of the assignment arm already consults, so the seed agrees with the cell's own valtype
// by construction.
//
// ORDER MATTERS and mirrors `tyAnnRefListKind`'s: the ref-list row first (its `rlElemKindTbl`
// entry distinguishes 1 struct/map, 2 union box, 5 closure), then the nullable scalar
// backings through their one home (`nulScalarListBuildKind`), then the non-null scalars. A
// LITERAL-UNION array (`K[]`) deliberately reaches the trailing `0`: its backing IS the
// default i32 list of interned atom ids, exactly as `tyAnnRefListKind`'s own
// `tyIsLitUnionArray` subtraction arranges — pinned by `L-litunion-empty` in the fixture.
export function exprListCellBuildKind(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  if exprRefArray(exprIx, fnIx) || exprNullableRefArray(exprIx, fnIx) {
    const s = refListSlotOfExpr(exprIx, fnIx)
    if s >= 0 && s < rlElemKindTbl.length {
      if rlElemKindTbl[s] == 2 { return 2 }
      if rlElemKindTbl[s] == 5 { return 5 }
    }
    return 1
  }
  // `string[] | null`, `f64[] | null`, `i64[] | null`, `f32[] | null` — the DISTINCT-backing
  // niches, mapped by the one home the call-argument and global-assign boundaries also read.
  const nsk = exprNulScalarListKind(exprIx, fnIx)
  if nsk != null { return nulScalarListBuildKind(nsk) }
  if exprStringArray(exprIx, fnIx) { return 3 }
  if exprF64Array(exprIx, fnIx) { return 4 }
  if exprI64Array(exprIx, fnIx) { return 6 }
  if exprF32Array(exprIx, fnIx) { return 7 }
  0
}

// The `pendingListSlot` twin of `exprListCellBuildKind` — WHICH ref-list element row the
// cell holds. `0` (the slot fallback `refListSlotOfExpr` itself returns) for a non-ref list,
// matching `tyAnnRefListSlot`'s `0` for a non-ref-array annotation.
export function exprListCellBuildSlot(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  if exprRefArray(exprIx, fnIx) || exprNullableRefArray(exprIx, fnIx) {
    return refListSlotOfExpr(exprIx, fnIx)
  }
  0
}

// True if the `LetDecl` at `letIx` declares a ref-list local: its annotation is a ref
// array (`S[]`/`N[]`), OR its initializer produces a ref list. Picks the local's valtype
// (`(ref $rlTypeIdx)`) and the code-`5` flag in `collectLocals`.
export function letIsRefArray(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // A UNION annotation (even `S[] | i64`, a union WITH a ref-array member) is a union-BOX
        // local, NOT a reflist local — the init coerces into the box. Return false so a ref-array
        // INIT below does not mis-pick the reflist valtype (an invalid boxed-store otherwise).
        // A declared union NAME is nominal identity, so this stays a name lookup.
        if isUName(lt.tyName) { return false }
        // ARENA-FIRST: the arena's `"reflist"` arm is exactly `nameIsRefArray`'s settled base
        // cases (an array over a struct / variant / inline shape / closure element); the
        // spellings it declines — nested arrays, niche-nullable elements, union-box elements,
        // map elements — are the ones `repOfArray` leaves uncovered, so they keep the name
        // walk below rather than the recursive `refArrElemName` re-parse.
        const k = annRepKindOf(d.letType)
        if k != null {
          if k == "reflist" { return true }
        } else {
          // ARENA (destringify D-REFARR): where `repOfArray` declines the element (nested
          // arrays, niche-nullable / union-box / map elements) the reflist layer's own ROW
          // still answers — the intern-state question, off the recorded type.
          if annBareRefArrSlot(d.letType) >= 0 { return true }
        }
      }
    }
    return exprRefArray(d.letInit, fnIx)
  }
  false
}

// The ref-list ELEMENT type-NAME a ref-list `LetDecl` binds: from its `S[]`/`N[]`
// annotation if present, else inferred from its initializer (`refListElemNameOfExpr`).
// "" if not a ref-list local.
function letRefListElemName(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // `refArrElemNameIf` (the `nameIsRefArray`-gated element read). This is the ONE
        // of the seven sites whose else-branch is not "" but the initializer path, so
        // the fold merges two answers that master kept apart: "not a ref array" (fall
        // through) and "a ref array whose element does not resolve" (return ""). That
        // second cell is measured EMPTY — a probe counting `nameIsRefArray(t) &&
        // refArrElemName(t) == ""` over every annotation reaching here read 0 on both
        // channels (see D-REFELEM in the program doc) — and it is expected to be empty
        // by construction: every arm that makes `nameIsRefArray` true either is a
        // `refArrShapeKind` arm (each of which `refArrElemName` re-tests, in the same
        // order) or is the trailing base-name match, whose four rungs are the same four.
        const en = refArrElemNameIf(lt.tyName)
        if en != "" { return en }
      }
    }
    return refListElemNameOfExpr(d.letInit, fnIx)
  }
  ""
}

// The ref-list TABLE SLOT a ref-list `LetDecl` binds (stored in `localStructIdx` for a
// code-5 local so `declaredRefArrayName` can recover its element type), or -1.
export function letRefListSlot(letIx: i32, fnIx: i32) {
  rlSlotByName(letRefListElemName(letIx, fnIx))
}

// The ref-list element kind a `LetDecl`'s ANNOTATION declares (`S[]` → 1, `N[]` → 2),
// or `0` when it is not a ref-array annotation. Used to type an empty `[]` initializer
// (a non-empty literal types itself from its elements).
export function letAnnRefListKind(letIx: i32) {
  // `pendingListKind` semantics: 1 = struct/MAP ref list (use `pendingListSlot`),
  // 2 = union box ref list, 3 = string list. Delegates to the shared `tyAnnRefListKind`
  // over the let's `letType` so the let / return / call-arg / global seeds agree.
  const d = P.nodes[letIx]
  if d is LetDecl {
    const k = tyAnnRefListKind(d.letType)
    if k == 0 {
      // An UN-ANNOTATED empty `[]` whose pushes infer a string element
      // (`letInfStrListByUse`) seeds the string-list kind, so the empty literal
      // builds the string-list wrapper (not the default i32 list).
      if letInfStrListByUse(letIx) { return 3 }
    }
    return k
  }
  0
}

// The ref-list TABLE SLOT a `LetDecl`'s ref-array annotation names (`let xs: Tok[] = []`
// → the `Tok` slot), or 0 when it is not a ref-array annotation. Threads `pendingListSlot`
// so an empty `[]` initializer builds the annotation's distinct element type.
export function letAnnRefListSlot(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl { return tyAnnRefListSlot(d.letType) }
  0
}

// The STRUCT TABLE INDEX a `LetDecl`'s annotation names (`let b: B = { … }` → B's index),
// or -1 when the let is un-annotated OR its annotation names a non-struct (a union alias,
// `i32`, an array). Threads `pendingStructIdx` so an annotated struct literal builds the
// annotation's struct over a first-field-name match. An un-annotated `let` is left to the
// literal's own field-shape (-1).
export function letAnnStructIdx(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef { return structIndexByName(lt.tyName) }
    }
  }
  -1
}

// The union-VARIANT table index a `LetDecl`'s annotation names (`const c: Cat`), or -1.
// Seeds `pendingVariantIdx` so the object-literal init builds the bare variant (kind 8).
export function letAnnVariantIdx(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef { return variantIndexOf(lt.tyName) }
    }
  }
  -1
}

// Shared `g[i]` NESTED-array test for the scalar-element list families (string / f64 /
// f32 / i64): indexing a `T[][]` ref list whose INNER element kind is `elemKind` yields
// the inner `T[]`, so `g[i][j]` reads the scalar. The four `exprXArray` walks used a
// byte-identical block differing only in the `rlElemKindTbl` constant (string 6, f64 7,
// i64 8, f32 10); this is that block, parameterized by `elemKind`. (The i32 `exprArray`
// and the ref `exprRefArray` Index cases carry extra per-type logic and stay inline.)
function nestedRefListElemIs(idxArr: i32, fnIx: i32, elemKind: i32) {
  if exprRefArray(idxArr, fnIx) {
    const slot = refListSlotOfExpr(idxArr, fnIx)
    if slot >= 0 && slot < rlElemKindTbl.length {
      // A NULLABLE-niche element (`(f64[] | null)[]`, kinds 6/7/8/10 with the `| null`
      // slot key) reads `(ref null $wrapper)` — a nullable leaf list (`nulf64list` …,
      // `exprNulScalarListKind`'s Index arm), NOT the non-null leaf list; claiming it
      // here would route an unnarrowed read through the non-null scalar path.
      if rlElemNullable[slot] == 1 { return false }
      if rlElemKindTbl[slot] == elemKind { return true }
    }
  }
  false
}

// ── string-array-typedness of expressions (`string[]`) ────────────────────────
// Parallel to the ref-array family: decide whether an expression / param / local
// PRODUCES a string list — a `(ref $mkListIdx)`. Receiver shapes: a `string[]` literal,
// a `string[]` param/local, a parenthesized string-array, or a `string[]` FIELD read
// (code `6`). An index read `xs[i]` (a string) / `.length` (i32) is NOT a list.

// True if the already-collected declared local `name` is a string-list ref (code `7`).
function declaredStringArray(name: string) { declaredKind(name) == "strlist" }

// True if function `name` declares (or, un-annotated, infers) a `string[]` return type
// (`"strlist"`). Mirrors `fnRetArray`/`fnRetRefArray` — lets a `string[]`-returning call
// classify so an untyped `let x = snap()` picks the string-list local kind (code `7`).
function fnRetStringArraySid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "strlist"
}

// True if function `name` declares (or, un-annotated, infers) an `f64[]` return — the f64
// analogue of `fnRetStringArray`, so an untyped `let x = mk()` / a call argument classifies as
// an f64 list (kind 12) instead of falling through to i32.
function fnRetF64ArraySid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "f64list"
}

// True if function `name` returns a string-keyed mono map (`{[string]: i32}`, annotated or
// inferred — `"map"`). Lets `exprMap`/`mapShapeOfExpr` classify a call to it, so
// `const r = mk()` (or `mk()[k]`) routes through the map lowering.
function fnRetMapSid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "map"
}

// True if evaluating the expression at `exprIx` yields a string list: a string-element
// array literal, a `string[]`-returning call, a `string[]` param/local reference, a
// parenthesized string-array, or a `string[]` field read (code `6`). An index read /
// `.length` is NOT a list.
export function exprStringArray(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  if tyKindOf(nodeTyIxOf(exprIx)) == 7 {
    return true // typed-IR fast path (see exprIsF64)
  }
  // `m[k]` / `m[k] ?? d` over a string[]-VALUED map yields a string list.
  if mapReadListKind(exprIx, fnIx) == "strlist" { return true }
  const e = P.nodes[exprIx]
  if e is ArrayLit { return arrLitIsStr(exprIx, fnIx) }
  if e is Paren { return exprStringArray(e.parInner, fnIx) }
  if e is Call {
    // `__array_new__(n, "s")` builds a string list (intrinsic kind 2).
    if arrNewIntrKind(exprIx, fnIx) == 2 { return true }
    // An INDEXED closure call `fs[i](x)` whose element signature returns `string[]`.
    if cloArrCallRetKind(exprIx, fnIx) == "strlist" { return true }
    // `xs.map(f)` / `xs.filter(p)` yield a NEW list — the string list exactly when the
    // result ELEMENT kind is a string (map: the callback's return kind; filter: the
    // receiver's element kind). The i32-list classifier carries the same pair of arms; a
    // rep that has the `.slice` arm and not this one answers "not a string list" for the
    // `.filter` RESULT of a `(string | null)[]`, whose arena kind is the nulstr-element
    // array rather than the plain `string[]` the fast path above claims — and the cell
    // that binds it then takes the i32 DEFAULT while `emitMapFilter` pushes the string-list
    // wrapper (`vl check`-clean invalid wasm).
    if callIsMapFilter(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "str"
    }
    // `xs.slice(...)` over a string list yields a string list.
    if callIsArrSlice(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "str"
    }
    // `m.keys()` over a STRING-keyed map yields a string list of its keys; over the
    // i32-keyed rep it yields an i32 list, which is not this classifier's answer.
    const kcallee = P.nodes[e.callFn]
    if kcallee is Member {
      if kcallee.memProp == "keys" {
        if exprMap(kcallee.memObj, fnIx) {
          return !mapShapeKeyI32(mapShapeOfExpr(kcallee.memObj, fnIx))
        }
      }
    }
    // `m.values()` over a string-valued map (or a Set) yields a string list.
    if mapValuesResultKind(exprIx, fnIx) == 7 { return true }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if fnRetStringArraySid(sidOfNode(e.callFn)) { return true }
      // A closure-VALUE call (`g(x)` with `g: (i32) => string[]`) whose resolved sig
      // result is the string list (`>A`).
      return calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "strlist"
    }
    return false
  }
  if e is Ident {
    // A VALUE-union ident narrowed to a string-backed LIST arm (`is string[]`, `is
    // (string | null)[]` — value-atom kind 9) reads UNBOXED as the string list.
    if unionIdentReadKind(exprIx, fnIx) == 9 { return true }
    if paramStringArray(fnIx, e.identName) { return true }
    if declaredStringArray(e.identName) { return true }
    if globalIsStringArraySid(sidOfNode(exprIx)) {
      if !identShadowedByFrame(fnIx, e.identName) { return true }
    }
    // A CAPTURED string-list read (incl. a boxed captured-mutated `string` local). Kind 7.
    return capturedKindOf(fnIx, e.identName) == "strlist"
  }
  // A field read `p.names` whose field is a `string[]` (code `6`) yields the string-list
  // wrapper ref — so `.length` / indexing / assignment / `.push` treat it as a string list.
  if e is Member {
    if memFieldTypeCode(exprIx, fnIx) == 6 { return true }
  }
  // `g[i]` over a `string[][]` (ref-list element kind 6 — the inner string-list wrapper)
  // yields a `string[]`, so `g[i][j]` reads the string element.
  if e is Index {
    if nestedRefListElemIs(e.idxArr, fnIx, 6) { return true }
  }
  // `p ?? d` over the `string[] | null` niche is the string-list wrapper in BOTH halves — the
  // rep is unchanged, only its nullability (`exprNulScalarListKind`'s own `??` arm).
  const salLhs = coalesceNicheLhs(exprIx)
  if salLhs >= 0 {
    if exprNulScalarListKind(salLhs, fnIx) == "nulstrlist" { return true }
  }
  false
}

// True if `name` is a `(string | null)[]`, ALSO through one `| null` wrapper
// (`(string | null)[] | null`, the form a `!= null` narrow leaves behind). The one home
// for a four-line block three sibling classifiers carried verbatim — each asked
// `nameIsNulStrList`, then peeled with `nullablePartOf`, then asked AGAIN. Written once,
// the peel is one call, not three, and the three siblings can no longer drift apart on
// whether the wrapper counts.
function nameIsNulStrListDeep(name: string) {
  if nameIsNulStrList(name) { return true }
  const p = nullablePartOf(name)
  if p != "" { return nameIsNulStrList(p) }
  false
}

// True if the expression at `exprIx` produces a `(string | null)[]` — the string-ref niche list
// (`nameIsNulStrList`), whose backing IS a plain string list but whose element READ stays `(ref null)`
// (a `nulstr`, narrowed) instead of recovering non-null. Recognizes the receiver by its recorded array
// element type (the node-type fast path) and by a param / declared-local `(string | null)[]` annotation
// (a nulstrlist local is collected as a plain `strlist`, so the annotation carries the nullable bit).
// Drives the dedicated element-read arm in `emitIndex`, checked BEFORE `exprStringArray`.
export function exprNulStrArray(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  if nodeArrayElemIsNulStr(exprIx) { return true }
  const e = P.nodes[exprIx]
  if e is Paren { return exprNulStrArray(e.parInner, fnIx) }
  if e is Ident {
    const pt = paramTypeNode(fnIx, e.identName)
    if pt >= 0 {
      // `…Deep` also admits a `(string | null)[] | null` PARAM narrowed with `!= null`:
      // the narrowed value is the same nulstr-element list (the read must stay
      // `(ref null)`; the plain-string arm's recover TRAPPED on a null element —
      // fuzz-nightly plain leg, seed 154928295 d6).
      return annIsNulStrListDeep(pt)
    }
    // A union binding narrowed to the `(string | null)[]` arm reads unboxed as the
    // string list whose ELEMENT stays `(ref null)` — the same nullable read discipline.
    if nameIsNulStrList(narrowVariantFor(e.identName)) { return true }
    // A LOCAL/GLOBAL binding (or a rebind chain `const t0 = g`) annotated
    // `(string | null)[]` — or `(string | null)[] | null`, narrowed via `t0 != null`.
    if identBindingNulStrList(e.identName, fnIx, 4) { return true }
  }
  false
}

// The `exprNulStrArray` binding resolver: the LetDecl for `name` (function-local via
// `parentLetOf`, else a module-level `startStmts` global) whose ANNOTATION — directly or
// under an outer `| null` — is a `(string | null)[]` list; an un-annotated rebind
// (`const t0 = g`) follows its init chain (depth-capped).
function identBindingNulStrList(name: string, fnIx: i32, depth: i32): boolean {
  if depth <= 0 { return false }
  let li = -1
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl { li = parentLetOf(fn.fnBody, name) }
  }
  if li < 0 {
    // A rebind chain ending at a PARAM of the enclosing function (`const t0 = p`).
    const pt = paramTypeNode(fnIx, name)
    if pt >= 0 { return annIsNulStrListDeep(pt) }
    // A module GLOBAL (`const g: (string | null)[] | null = …`) — top-level LetDecls
    // live in `globalStmts` (they emit as wasm globals, not start statements).
    li = globalLetOf(name)
  }
  if li < 0 { return false }
  const d = P.nodes[li]
  if !(d is LetDecl) { return false }
  if d.letType >= 0 { return annIsNulStrListDeep(d.letType) }
  if d.letInit >= 0 {
    const init = P.nodes[unwrapParen(d.letInit)]
    if init is Ident {
      return identBindingNulStrList(init.identName, fnIx, depth - 1)
    }
  }
  false
}

// Usage-driven element inference for an un-annotated empty `[]` LOCAL, the richer
// dual of `letInfStrListByUse` (which only sees a string LITERAL push): with the
// enclosing function `fnIx` in hand it also recognises a push of any STRING-typed
// expression — `out.push(self[i])` over a `string[]` param, `out.push(s)` over a
// string local — so a build-loop accumulator (`slice`/`reverse` over `string[]`)
// classifies as `string[]`. The `gStrInfLet` guard breaks the `out.push(out[0])`
// self-reference cycle (the push arg's `exprString` would re-enter this binding).
export function letInfStrListByUseV(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return false }
    if d.letInit < 0 { return false }
    const ini = P.nodes[unwrapParen(d.letInit)]
    if ini is ArrayLit {
      if ini.arrElems.length != 0 { return false }
      if gStrInfLet == letIx { return false }
      const saved = gStrInfLet
      gStrInfLet = letIx
      let found = false
      let i = 0
      while i < P.nodes.length {
        const nd = P.nodes[i]
        if nd is Call {
          const callee = P.nodes[nd.callFn]
          if callee is Member {
            if callee.memProp == "push" {
              const recv = P.nodes[callee.memObj]
              if recv is Ident {
                if recv.identName == d.letName && nd.callArgs.length == 1 {
                  const argN = P.nodes[unwrapParen(nd.callArgs[0])]
                  if argN is StrLit {
                    found = true
                  } else if fnIx >= 0 && exprString(nd.callArgs[0], fnIx) {
                    found = true
                  }
                }
              }
            }
          }
        }
        i = i + 1
      }
      gStrInfLet = saved
      return found
    }
  }
  false
}

// True if the `LetDecl` at `letIx` declares a `string[]` local: its annotation is
// `string[]`, OR its initializer produces a string list. Picks the local's valtype
// (`(ref $mkListIdx)`) and the code-`7` flag in `collectLocals`.
export function letIsStringArray(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      // ARENA-FIRST (see `letIsArray`): a covered annotation answers both questions the
      // name ladder asks — `"strlist"` is its `nameIsStringArray` (both `string[]` and the
      // `(string|null)[]` niche share the `$mkListIdx` wrapper), and `"reflist"` is its
      // authoritative `nameIsRefArray` reject. The `(K|null)[]` reject has no covered
      // counterpart (`repOfArray` leaves the atom-niche element uncovered), so that
      // spelling reaches the name arm below.
      const k = annRepKindOf(d.letType)
      if k != null {
        if k == "strlist" { return true }
        if k == "reflist" { return false }
      } else {
        // The `(K | null)[]` reject, STRUCTURALLY — and it must lead the name arms, not
        // sit beside them: the INLINE spelling of the same type renders `(string | null)[]`
        // after the canon pass, which `nameIsStringArray` accepts as its own niche. The
        // alias spelling survives to `nameIsNulLitUnionList` below; the inline one has
        // nothing left in the name to survive with.
        if annIsNulLitUnionArray(d.letType) { return false }
        const lt = P.nodes[d.letType]
        if lt is TypeRef {
          if nameIsStringArray(lt.tyName) { return true }
          // A REF-array annotation (a union-element list) is authoritative — see `letIsF64Array`.
          // ARENA (destringify D-REFARR): the reject asks intern state ("the reflist layer holds
          // a row for this element"), which `annBareRefArrSlot` answers off the recorded type —
          // reaching the union / nested / niche element spellings `annRepKindOf` leaves uncovered.
          if annBareRefArrSlot(d.letType) >= 0 { return false }
          // A `(K | null)[]` annotation is the i32 atom-niche list, authoritative over a string-FIRST
          // init literal (`["a", null]`): its member elements are atom ids, not string refs. Without
          // this the init's `exprStringArray` claimed the string-list slot while the construct/read
          // used the i32 rep (invalid wasm). Mirrors the `nameIsRefArray` authority above.
          if nameIsNulLitUnionList(lt.tyName) { return false }
        }
      }
    }
    if exprStringArray(d.letInit, fnIx) { return true }
    return letInfStrListByUseV(letIx, fnIx)
  }
  false
}

// ── f64-array-typedness of expressions (Slice 4) ──────────────────────────────
// Parallel to the i32/string-array families: decide whether an expression / param /
// local PRODUCES an `f64[]` list — a `(ref $fl64TypeIdx)`. Drives the index-read
// dispatch (an f64-array `xs[i]` yields an f64 from `array.get $fa64TypeIdx`) and the
// f64-list local/global cell kind (`12`). `localIsRef` code `12` flags an f64-list local.

// True if the already-collected declared local `name` is an f64-list ref (code `12`).
function declaredF64Array(name: string) { declaredKind(name) == "f64list" }

// True if evaluating the expression at `exprIx` yields an f64 list: an f64-element
// array literal, an f64-array param/local reference, or a parenthesized one.
// THE single typed-IR → emitter-kind mapping (the unification centerpiece): map a checker
// type-arena index to the emitter's local/value KIND code the per-rep predicates speak
// (0 i32 · 3 string · 10 i64 · 11 f64 · 13 f32 · 2 i32-list · 7 string-list · 12 f64-list).
// One place classifies a type; consumers compare the result to a specific kind instead of
// each re-deriving it. Scalars and scalar-element lists resolve fully; a struct / ref / map
// / nullable / closure type returns -1 (its lowering needs a slot/table the kind code alone
// can't carry), and a node with no recorded type (a monomorphized instance body, whose
// shared leaves can't hold a per-instance type) also reads -1 — both keep the syntactic path.
function tyKindOf(tyIx: i32) {
  if tyIx < 0 { return -1 }
  const t = T.tys[tyIx]
  if t is TyPrim {
    const n = t.primName
    if n == "i32" { return 0 }
    if n == "f64" { return 11 }
    if n == "i64" { return 10 }
    if n == "f32" { return 13 }
    if n == "string" { return 3 }
    if n == "boolean" { return 0 }
    return -1
  }
  if t is TyArray {
    if t.aElem < 0 { return -1 }
    const el = T.tys[t.aElem]
    if el is TyPrim {
      const en = el.primName
      if en == "i32" { return 2 }
      if en == "f64" { return 12 }
      if en == "i64" { return 20 }
      if en == "string" { return 7 }
      if en == "boolean" { return 2 }
    }
    return -1 // struct / ref / nested-list element — needs the ref-list slot
  }
  // A NUMERIC literal type or literal UNION (`1`, `1 | 2`, `1.5 | 2.5`) has NO rep of its own
  // — it reps as its BASE SCALAR — so its kind is that scalar's, resolved through
  // `numLitUnionBaseName` (the single home for that rule) and then through THIS function's own
  // `TyPrim` arm, so the name→kind map is not written twice.
  //
  // Without it every typed-IR fast path built on this function answered -1 for an `is`-narrowed
  // litunion arm and fell back to a syntactic derivation that has no litunion case either. The
  // reaching shape: a struct FIELD typed `W | null` over `type W = 1.5 | 2.5`, narrowed by
  // `if s.f is W` — the field read correctly unboxed to an f64 and `print` then routed it to
  // `__print_i32__`, because `exprIsF64`'s fast path asks this function and its Member arm asks
  // the field's DECLARED code (16, the box). `vl check` rc 0, `type mismatch: expected i32,
  // found f64`. The `f64 | string` field one line away was correct, because the checker banks
  // the bare `f64` there and this function has always answered for that.
  //
  // STRING literals answer "" at that home and stay -1 here, which is required, not incidental:
  // a string litunion member is an interned i32 ATOM, not the `(ref $array)` kind 3 would name.
  //
  // The walk is GATED ON THE VARIANT rather than charged to every -1: only a literal or a union
  // node can be a numeric litunion, and this function sits under every scalar classifier.
  let litBase = ""
  if t is TyLit { litBase = numLitUnionBaseName(tyIx) }
  if t is TyUnion { litBase = numLitUnionBaseName(tyIx) }
  if litBase != "" { return tyKindOf(primTyOfName(litBase)) }
  -1
}

// TYPED-IR consumer: is the type the checker recorded for `tyIx` an `f64[]`? Lets the emitter
// recognize an f64 list the SYNTACTIC predicates miss (e.g. an `f64[]`-returning call, which
// `calleeRetKind` doesn't map to a list kind) without a bespoke per-position predicate.
function tyIsF64Array(tyIx: i32) { tyKindOf(tyIx) == 12 }

export function exprF64Array(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  // Typed-IR fast path: trust the checker's recorded type when it has one. Emitter-
  // synthesized nodes (monomorphized instance bodies) read back -1 and fall through to the
  // syntactic derivation below, so generic lowering is unaffected.
  if tyIsF64Array(nodeTyIxOf(exprIx)) { return true }
  // `m[k]` / `m[k] ?? d` over an f64[]-VALUED map yields an f64 list.
  if mapReadListKind(exprIx, fnIx) == "f64list" { return true }
  const e = P.nodes[exprIx]
  if e is ArrayLit { return arrLitIsF64(exprIx, fnIx) }
  if e is Paren { return exprF64Array(e.parInner, fnIx) }
  if e is Ident {
    // A VALUE-union ident narrowed to the `f64[]` LIST arm (value-atom kind 8) reads
    // UNBOXED as the f64 list — the string/i32-list classifiers carry the same arm.
    if unionIdentReadKind(exprIx, fnIx) == 8 { return true }
    if paramF64Array(fnIx, e.identName) { return true }
    if declaredF64Array(e.identName) { return true }
    if globalIsF64ArraySid(sidOfNode(exprIx)) {
      if !identShadowedByFrame(fnIx, e.identName) { return true }
    }
    // A CAPTURED f64-list read (`xs[i]` inside a closure capturing `xs` — incl. a boxed
    // captured-mutated `f64` local, lowered to a length-1 `f64[]`). Kind 12 = f64 list.
    return capturedKindOf(fnIx, e.identName) == "f64list"
  }
  // A `.map`/`.filter` whose result ELEMENT kind is f64 yields an f64 list (an f64
  // receiver's filter, or a map whose callback returns f64). (Slices 3–4.)
  if e is Call {
    // `__array_new__(n, <f64 fill>)` yields an f64 list.
    if arrNewIntrKind(exprIx, fnIx) == 1 { return true }
    if callIsMapFilter(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "f64"
    }
    // `xs.slice(...)` over an f64 list yields an f64 list.
    if callIsArrSlice(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "f64"
    }
    // An INDEXED closure call `fs[i](x)` whose element signature returns `f64[]`.
    if cloArrCallRetKind(exprIx, fnIx) == "f64list" { return true }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      // A NAMED function returning `f64[]` (annotated or inferred, `"f64list"`).
      if fnRetF64ArraySid(sidOfNode(e.callFn)) { return true }
      // A closure-VALUE call (`g(x)` with `g: (i32) => f64[]`) whose resolved sig
      // result is the f64 list (`>D`).
      return calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "f64list"
    }
    return false
  }
  // `g[i]` over an `f64[][]` (ref-list element kind 7 — the inner f64-list wrapper) yields an
  // `f64[]`, so `g[i][j]` reads the f64 scalar.
  if e is Index {
    if nestedRefListElemIs(e.idxArr, fnIx, 7) { return true }
  }
  false
}

// ── f32-array typedness (the f32 sibling of the f64-array family, rep code 21) ──
// f32 is the checker's weak spot (a float literal types f64), so these lean on the SYNTACTIC
// path — an `f32[]` annotation (`nameIsF32Array`) on a let/param/global/return — rather than a
// typed-IR fast path. A bare `[1.5]` literal stays f64 (it is NOT claimed here), so a value is
// f32[] only when its declared type says so.
function tyIsF32Array(tyIx: i32) { tyKindOf(tyIx) == 21 }

// The checker-recorded type `tyIx` tested for an f32-element ARRAY — scoped to CALL
// results only (`exprF32Array`'s curried-call arm). `tyKindOf` deliberately carries no
// f32-array kind (a float LITERAL types f64, so a general typed claim would mis-claim a
// literal-built f64 list as f32); a call result's f32-ness comes from the callee's
// functype and is reliable.
function callResTyIsF32Array(tyIx: i32) {
  if tyIx < 0 { return false }
  const t = T.tys[tyIx]
  if t is TyArray {
    if t.aElem < 0 { return false }
    const el = T.tys[t.aElem]
    if el is TyPrim { return el.primName == "f32" }
  }
  false
}

function declaredF32Array(name: string) { declaredKind(name) == "f32list" }

function globalIsF32ArraySid(sid: i32) {
  const li = globalLetOfSid(sid)
  if li < 0 { return false }
  letIsF32Array(li, -1)
}

function fnRetF32ArraySid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "f32list"
}

// True if function `name` carries an ANNOTATED `f32[]` return — read STRAIGHT OFF the
// annotation node, because neither of the two channels its i64/f64 siblings use can
// answer for f32:
//
//   * `fRetKind` cannot. `retAnnKindChain`'s producer set has no f32-list arm and its
//     header says so deliberately — "an i64/f32 LIST annotation never flagged here (those
//     codes were only ever inferred — an annotated `i64[]` return rides the typed-IR
//     path)". `retListKindFlag` accordingly folds only 2/5/7/12.
//   * The typed-IR fast path cannot. `tyKindOf` carries NO f32-array kind on purpose (a
//     float LITERAL types f64, so a general typed claim would mis-claim a literal-built
//     f64 list as f32) — which is exactly why `exprI64Array`'s annotated case rides
//     `tyIsI64Array` and `exprF32Array` has no such arm.
//
// So an annotated `f32[]` return had NO reader at all, and `function mk(): f32[] { … }`
// followed by `mk()[0]` was an EMIT REJECT ("index access but array type not collected")
// while the identical three lines with an `f64`/`i64`/`i32` leaf all run. The function's
// own RESULT VALTYPE was never wrong — `cloRetValKind` reads `vtKindOfType(fn.fnRet)` from
// the annotation — only the CALLER's classifier disagreed with it.
//
// Deliberately gated on `fn.fnRet >= 0`: an UN-annotated `f32[]` return is a DIFFERENT and
// still-open defect (`emit_collect`'s A20 arm never stores `"f32list"` for it, so the
// function's result valtype really is i32 and claiming the call site is an f32 list turns
// a loud reject into invalid wasm — measured). Pinned by
// `tests/cases/arrays/error-inferred-f32-list-return.vl`, which stays an `@emit-error`.
function fnRetAnnF32ArraySid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 || i >= fnStmts.length { return false }
  const fn = P.nodes[fnStmts[i]]
  if fn is FuncDecl {
    if fn.fnRet < 0 { return false }
    return retF32ArrFlag(fn.fnRet) == 1
  }
  false
}

export function letIsF32Array(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      // ARENA-FIRST (see `letIsArray`).
      const k = annRepKindOf(d.letType)
      if k != null {
        if k == "f32list" { return true }
        if k == "reflist" { return false }
      } else {
        const lt = P.nodes[d.letType]
        if lt is TypeRef {
          if nameIsF32Array(lt.tyName) { return true }
          // A REF-array annotation (`(f32 | null)[]`) is authoritative — see `letIsF64Array`.
          // ARENA (destringify D-REFARR): the intern-state reading of that reject.
          if annBareRefArrSlot(d.letType) >= 0 { return false }
        }
      }
    }
    return exprF32Array(d.letInit, fnIx)
  }
  false
}

export function exprF32Array(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  if tyIsF32Array(nodeTyIxOf(exprIx)) { return true }
  // A read of an `f32[]`-valued map (`m[k] ?? []`, or a bare `m[k]`) — its value-list rep is the
  // f32 list (`mvListValKind` → 21), the f32 dual of the f64-list (12) case above.
  if mapReadListKind(exprIx, fnIx) == "f32list" { return true }
  const e = P.nodes[exprIx]
  if e is Paren { return exprF32Array(e.parInner, fnIx) }
  if e is Ident {
    // A VALUE-union ident narrowed to the `f32[]` LIST arm (value-atom kind 12) reads
    // UNBOXED as the f32 list — the checker's typed-IR carries no f32-array claim (a
    // float literal types f64), so the narrowed-atom kind is the only signal here.
    if unionIdentReadKind(exprIx, fnIx) == 12 { return true }
    if paramF32Array(fnIx, e.identName) { return true }
    if declaredF32Array(e.identName) { return true }
    if globalIsF32ArraySid(sidOfNode(exprIx)) {
      if !identShadowedByFrame(fnIx, e.identName) { return true }
    }
    // A CAPTURED f32-list read (incl. a boxed captured-mutated `f32` local). Kind 21 = f32 list.
    return capturedKindOf(fnIx, e.identName) == "f32list"
  }
  // A struct-field READ of an `f32[]` field (code 27) — the checker's per-node type does not always
  // carry f32[] through a member, so recognize it directly by the field code (the f64/i64 duals get
  // this from their typed-IR fast path; this keeps f32 fields on par).
  if e is Member {
    if memberFieldCode(exprIx, fnIx) == 27 { return true }
  }
  if e is Call {
    // `xs.map(f)` / `xs.filter(p)` whose result element is f32 (mf-result kind 13) — a `.map`
    // with an f32-returning callback, or a `.filter` over an f32 list (preserves the element).
    if callIsMapFilter(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "f32"
    }
    // `xs.slice(...)` over an f32 list yields an f32 list.
    if callIsArrSlice(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "f32"
    }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if fnRetF32ArraySid(sidOfNode(e.callFn)) { return true }
      // A NAMED function with an ANNOTATED `f32[]` return — the annotation node read
      // directly, because f32 has neither of the two channels the i64/f64 siblings use
      // (see `fnRetAnnF32Array`). Without it the callee emitted the f32-list wrapper as
      // its result while every caller-side classifier said "not a list", and the read
      // `mk()[0]` fell through to the array arm's loud reject.
      if fnRetAnnF32ArraySid(sidOfNode(e.callFn)) { return true }
      // A closure-VALUE call (`g()` with `g: () => f32[]`) whose resolved sig result is
      // the f32 list (`>F`) — the f32 dual of the i64/f64-list callee arms.
      return calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "f32list"
    }
    // A CURRIED / composed value call (`t0()(1)` — the callee is itself a Call): the
    // checker's recorded RESULT type decides. Reliable here, unlike a general typed-IR
    // claim (see `tyIsF32Array`'s note — a float LITERAL types f64): a call result's
    // f32-ness comes from the callee's functype, not a literal's default.
    return callResTyIsF32Array(nodeTyIxOf(exprIx))
  }
  // `g[i]` over an `f32[][]` (ref-list element kind 10 — the inner f32-list wrapper) yields an
  // `f32[]`, so `g[i][j]` reads the f32 scalar.
  if e is Index {
    if nestedRefListElemIs(e.idxArr, fnIx, 10) { return true }
  }
  false
}

// ── i64-array typedness (the i64 sibling of the f64-array family) ──────────────
// These mirror the f64 predicates over the i64-list rep (code 20, wrapper `il64TypeIdx`).
// The typed-IR fast path (`tyKindOf == 20`) carries the annotated cases; the syntactic
// fallback covers a monomorphized body whose nodes have no recorded type.
function tyIsI64Array(tyIx: i32) { tyKindOf(tyIx) == 20 }

function declaredI64Array(name: string) { declaredKind(name) == "i64list" }

export function letIsI64Array(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      // ARENA-FIRST (see `letIsArray`).
      const k = annRepKindOf(d.letType)
      if k != null {
        if k == "i64list" { return true }
        if k == "reflist" { return false }
      } else {
        const lt = P.nodes[d.letType]
        if lt is TypeRef {
          if nameIsI64Array(lt.tyName) { return true }
          // A REF-array annotation (`(i64 | null)[]`) is authoritative — see `letIsF64Array`.
          // ARENA (destringify D-REFARR): the intern-state reading of that reject.
          if annBareRefArrSlot(d.letType) >= 0 { return false }
        }
      }
    }
    return exprI64Array(d.letInit, fnIx)
  }
  false
}

function globalIsI64ArraySid(sid: i32) {
  const li = globalLetOfSid(sid)
  if li < 0 { return false }
  letIsI64Array(li, -1)
}

export function arrLitIsI64(arrIx: i32, fnIx: i32) {
  const a = P.nodes[arrIx]
  if a is ArrayLit {
    if a.arrElems.length < 1 { return false }
    // ANY i64 element makes the literal an i64 LIST — a small-magnitude sibling
    // widens at the store, exactly as it does when the i64 element comes FIRST.
    // First-element-only classification let `[712583, 13131313131]` claim the i32
    // list and emit `i64.const` into the i32 array — INVALID-WASM (fuzz frontier
    // seed 70441494 d4, the `{f: i64[] | null}` closure-result lambda). An f64
    // element keeps this false (a mixed float/int literal is a checker-level
    // union, not a scalar list).
    let anyI64 = false
    let i = 0
    while i < a.arrElems.length {
      if exprIsF64(a.arrElems[i], fnIx) { return false }
      if !anyI64 {
        if exprIsI64(a.arrElems[i], fnIx) { anyI64 = true }
      }
      i = i + 1
    }
    return anyI64
  }
  false
}

export function exprI64Array(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  if tyIsI64Array(nodeTyIxOf(exprIx)) { return true }
  // `m[k]` / `m[k] ?? d` over an i64[]-VALUED map yields an i64 list.
  if mapReadListKind(exprIx, fnIx) == "i64list" { return true }
  const e = P.nodes[exprIx]
  if e is ArrayLit { return arrLitIsI64(exprIx, fnIx) }
  if e is Paren { return exprI64Array(e.parInner, fnIx) }
  if e is Ident {
    if paramI64Array(fnIx, e.identName) { return true }
    if declaredI64Array(e.identName) { return true }
    if globalIsI64ArraySid(sidOfNode(exprIx)) {
      if !identShadowedByFrame(fnIx, e.identName) { return true }
    }
    // A CAPTURED i64-list read (incl. a boxed captured-mutated `i64` local). Kind 20 = i64 list.
    return capturedKindOf(fnIx, e.identName) == "i64list"
  }
  if e is Call {
    if callIsMapFilter(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "i64"
    }
    if callIsArrSlice(exprIx, fnIx) {
      return mfResultKindOf(exprIx, fnIx) == "i64"
    }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      // A closure-VALUE call (`g()` with `g: () => i64[]`) whose resolved sig result is
      // the i64 list (`>L`) — the i64 dual of the f64/f32-list callee arms. A NAMED
      // function returning `i64[]` is recognized via the typed-IR fast path above.
      return calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "i64list"
    }
    return false
  }
  // `g[i]` over an `i64[][]` (ref-list element kind 8 — the inner i64-list wrapper) yields an
  // `i64[]`, so `g[i][j]` reads the i64 scalar.
  if e is Index {
    if nestedRefListElemIs(e.idxArr, fnIx, 8) { return true }
  }
  false
}

// True if the `LetDecl` at `letIx` declares an `f64[]` local: its annotation is `f64[]`,
// OR its initializer produces an f64 list. Picks the local's valtype (`(ref $fl64TypeIdx)`)
// and the code-`12` flag in `collectLocals`.
export function letIsF64Array(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      // ARENA-FIRST (see `letIsArray`): a covered annotation's kind IS the authority the
      // three name tests below were spelling out — `"f64list"` accepts, `"reflist"` and
      // `"f32list"` reject, and nothing else can reach the init fallback wrongly.
      const k = annRepKindOf(d.letType)
      if k != null {
        if k == "f64list" { return true }
        if k == "reflist" { return false }
        if k == "f32list" { return false }
      } else {
        const lt = P.nodes[d.letType]
        if lt is TypeRef {
          if nameIsF64Array(lt.tyName) { return true }
          // A REF-array annotation (`(f64 | null)[]` — union-BOX elements) is authoritative:
          // the float-literal init must not claim the binding as a scalar f64 list (kind 12)
          // when the slot is a kind-2 ref list — the literal's elements box instead.
          // ARENA (destringify D-REFARR): the intern-state reading of that reject.
          if annBareRefArrSlot(d.letType) >= 0 { return false }
          // An `f32[]` annotation is authoritative too: its float-literal init reads as
          // `exprF64Array`, so without this guard a GLOBAL `const a: f32[] = [1.5]` claims
          // BOTH kinds — the ordered ladders (`buildLocals`, `globalCellKind`) pick f32
          // first, but `exprF64Array`'s Ident arm consults `globalIsF64Array` directly and
          // the double claim routed `.push` through the f64 frame against the f32 cell
          // (invalid wasm). The annotation names the kind; the init must not override it.
          if nameIsF32Array(lt.tyName) { return false }
        }
      }
    }
    return exprF64Array(d.letInit, fnIx)
  }
  false
}

// ── map-typedness of expressions (G8: `{[string]: i32}`) ──────────────────────
// Parallel to the array family: decide whether an expression / param / local PRODUCES
// a string-keyed MAP — a `(ref $mStructIdx)`. The receiver shapes that matter for the
// self-host checker are a map LOCAL (`let m: {[string]: i32} = Map()` → code `6`), a
// map PARAM, and `Map()` itself (the empty-map constructor). An index read `m[k]` /
// `m.has(k)` yields an i32, NOT a map, so neither counts here.

// True if the already-collected declared local `name` is a map ref (code `6`).
function declaredMap(name: string) { declaredKind(name) == "map" }
function declaredNulMap(name: string) { declaredKind(name) == "nulmap" }

// True if evaluating the expression at `exprIx` yields a NULLABLE MAP ref (`{[string]: V} | null`,
// kind `nulmap`) — a nulmap-annotated param / local / global reference, or a nulmap-returning call.
// The map analogue of `exprNullableStruct` / `exprNullableRefArray`: the `!= null` narrow reads the
// `(ref null $mapStruct)` niche, and the narrowed map ops recover it non-null at the receiver.
export function exprNullableMap(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Paren { return exprNullableMap(e.parInner, fnIx) }
  if e is Ident {
    if paramNulMap(fnIx, e.identName) { return true }
    if declaredNulMap(e.identName) { return true }
    return globalIsNulMapSid(sidOfNode(exprIx))
  }
  // A `recv.f` read of a NULLABLE map FIELD (`f: {[string]: V} | null`, code 29) yields a
  // nullable map — `const t = v.f` infers kind `nulmap` and narrows with `if t != null`.
  if e is Member { return memFieldTypeCode(exprIx, fnIx) == 29 }
  // A read over a NULLABLE-inner-map-valued map (`{[string]: {[string]: V} | null}`) yields
  // `map | null` — the fused `?? d` hit arm preserves a stored null, and the bare `m[k]` is
  // nullable by construction. The binding infers kind `nulmap`; its shape resolves through
  // `mapShapeOfExpr`'s composition arm (the inner map's own value slot).
  if e is BinExpr {
    const cnm = coalesceMvSlot(exprIx, fnIx)
    if cnm >= 0 {
      return mvValIsMap(cnm) && coalesceStaysNullable(exprIx, cnm, fnIx)
    }
  }
  if e is Index {
    // An INDEX into a nullable-map array (`({[string]: V} | null)[]`, element kind 3 with the
    // nullable bit): the element legitimately holds null — `const e = xs[i]` binds `nulmap`.
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemNullable.length {
        if rlElemKindTbl[slot] == 3 && rlElemNullable[slot] == 1 { return true }
      }
    }
    const mnm = mapReadMvSlot(exprIx, fnIx)
    if mnm >= 0 { return mvValIsMap(mnm) && mvSlotNullable(mnm) }
  }
  // A call whose ANNOTATED return is `{[string]: V} | null` yields a nullable map, so an
  // un-annotated `const t = mk(…)` infers kind `nulmap` and narrows with `if t != null`.
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const target = fnIndexOfSid(sidOfNode(e.callFn))
      if target >= 0 {
        const fn = P.nodes[fnStmts[target]]
        if fn is FuncDecl {
          if fn.fnRet >= 0 { return retNulMapFlag(fn.fnRet) == 1 }
        }
      }
    }
  }
  false
}

// True if evaluating the expression at `exprIx` yields a string-keyed map: the
// `Map()` constructor call, a map param/local reference, or a parenthesized map
// expression.
export function exprMap(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Paren { return exprMap(e.parInner, fnIx) }
  if e is Call {
    const callee = P.nodes[e.callFn]
    // A `Set()` is a boolean-valued string map — the SAME 7-field struct — so a
    // `Set()`-bound value is treated as a map throughout the emitter. A NAMED function
    // returning a map (`fnRetMap`) yields one too — so `mk()[k]` / `const r = mk()` route
    // through the map lowering.
    if callee is Ident {
      if callee.identName == "Map" || callee.identName == "Set" { return true }
      if fnRetMapSid(sidOfNode(e.callFn)) { return true }
    }
    // `scopes.pop()` over a map ref list (`{[string]:i32}[]`) yields a Map ref.
    if callee is Member {
      if callee.memProp == "pop" {
        if exprRefArray(callee.memObj, fnIx) {
          const slot = refListSlotOfExpr(callee.memObj, fnIx)
          if slot >= 0 && slot < rlElemKindTbl.length {
            return rlElemKindTbl[slot] == 3
          }
        }
      }
    }
    // FALLBACK: a map-returning CLOSURE-VALUE / factory call whose callee the syntactic cases miss (a
    // closure local `v()`, an indexed closure `arr[i]()`) — the checker recorded a map type for the node.
    // The map dual of `structIndexOfExpr`'s `nodeTyIsObj` fallback: a `v()[k] ?? d` (or any map op on the
    // call result) routes through the map lowering regardless of how the map value was produced.
    if nodeTyIsMap(exprIx) { return true }
    return false
  }
  if e is Ident {
    // A union binding NARROWED to a MAP arm (`if x is {[string]: string}` then `x[k]`): its box
    // unboxes to the map struct ref, so it IS a map in the narrowed branch. Checked FIRST — the
    // binding's DECLARED type is a union, so `paramMap`/`declaredMap`/`globalIsMap` below miss it.
    if narrowedMapOf(e.identName) != "" { return true }
    if paramMap(fnIx, e.identName) { return true }
    if declaredMap(e.identName) { return true }
    if globalIsMapSid(sidOfNode(exprIx)) { return true }
    // A CAPTURED map variable of a lifted lambda (`() => (h0)` with `h0` a parent-frame
    // map binding): its env field carries the map ref — classify it exactly as a
    // param/local receiver would, so a captured map flowing into a union-boxed RESULT
    // (`() => {[string]: string} | boolean`) takes the map-arm boxing, not the raw ref.
    if capturedKindOf(fnIx, e.identName) == "map" { return true }
    // A NULLABLE map binding (`{[string]: V} | null`, kind `nulmap`) IS a map ref in the narrowed
    // (`!= null`) branch — the checker proved the map op guarded. The map-op receiver recovers it
    // non-null (`ref.as_non_null` in `emitMapPrep`); its shape resolves through `mapShapeOfExpr`
    // (the nulmap arms below). Checked here so `t["k"]` / `t["k"] ?? d` route to the map lowering.
    return exprNullableMap(exprIx, fnIx)
  }
  // A MAP-typed struct field read (`node.children`, code 19) yields a Map ref —
  // map member/index ops on it route to the existing map lowering.
  if e is Member {
    if memFieldTypeCode(exprIx, fnIx) == 19 { return true }
  }
  // `outer[k] ?? d` over a NESTED map (value kind 6) yields the inner Map ref — so a
  // chained `(outer[k] ?? d)[j]` routes through the map lowering.
  if e is BinExpr {
    const cmm = coalesceMvSlot(exprIx, fnIx)
    if cmm >= 0 {
      // A NULLABLE inner-map value with a NULLABLE default yields `map | null` —
      // `exprNullableMap` claims that; a non-null default coalesces to the non-null map.
      if mvValIsMap(cmm) && !coalesceStaysNullable(exprIx, cmm, fnIx) {
        return true
      }
    }
  }
  // `scopes[i]` over a MAP ref list (`{[string]:i32}[]`, element kind 3) yields a Map ref
  // — so map member/index ops on it route to the existing map lowering. Per-slot: the
  // element kind comes from the receiver's distinct ref-list slot. A bare `outer[k]` over a
  // nested map (value kind 6) likewise yields the inner Map.
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      // `refListSlotOfExpr` falls back to slot 0 for an UN-INTERNED element name (the ref-list
      // tables can be empty when the only ref-array-shaped type is never interned — e.g. a
      // nullable array-of-map field of a union arm). Bound-check before the read, the idiom the
      // sibling ref-list classifiers already use — else `rlElemKindTbl[0]` on an empty table is a
      // compiler-internal OOB trap. (Same guard added to the `.pop()` twin above.)
      if slot >= 0 && slot < rlElemKindTbl.length {
        // A NULLABLE map element (`({[string]: V} | null)[]`) yields `map | null` —
        // `exprNullableMap`'s element arm claims it, not this non-null arm.
        return rlElemKindTbl[slot] == 3 && rlElemNullable[slot] == 0
      }
    }
    const mri = mapReadMvSlot(exprIx, fnIx)
    if mri >= 0 {
      // A bare read of a NULLABLE inner-map value stays `map | null` — `exprNullableMap`'s.
      if mvValIsMap(mri) && !mvSlotNullable(mri) { return true }
    }
  }
  false
}

// ── G8: map ops on a GLOBAL struct-field map-array element ─────────────────────
// `fnHasMap` (above) reserves the map scratch frame from map PARAMS / map LOCALS /
// map-array LOCALS (code 5 + element kind 3). But a map op can also run on an
// element of a GLOBAL struct-field map-array — e.g. `T.scopes[top][name] = v` in the
// self-host checker's `declare`, where `T` is a module global struct and `scopes` is
// a `{[string]:i32}[]` field. Such a function has NO map local, so the local scan
// misses it and `mapScratchBase` points past the locals → `invalid local index`.
//
// This walk fires on EXACTLY the four shapes `emitExpr`/`emitStmt` lower as map ops —
// each gated by `exprMap` on the same receiver (`exprMap` already resolves a
// global-field map-array element via `exprRefArray`→`memFieldTypeCode`==5 +
// `rlElemKindTbl`==3): the map GET `recv[k]`, the fused `recv[k] ?? d`, the
// `.has(k)` member-call, and the map SET `recv[k] = v`. Matching the lowered set
// EXACTLY means it never over-reserves: a function with no map-op shape stays
// byte-identical. The map LOCAL / param cases are already handled by `fnHasMap`, so
// this is OR'd in only as the additional global-field coverage.
//
// (No narrowing is applied here — a global-field map-array receiver resolves through
// `structIndexOfExpr` on a global ident, independent of any active variant narrowing,
// and this helper must stay declare-before-use-safe relative to the narrow stack.)

// True if the expression at `exprIx` (recursively) contains a map-op shape whose
// receiver `exprMap` resolves — i.e. a shape the emitter lowers via the map scratch
// frame.
export function exprHasMapOp(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Index {
    // Map GET `recv[k]`.
    if exprMap(e.idxArr, fnIx) { return true }
    // A union binding with a MAP arm indexed `t[k]`: the `is`-narrowing that makes `t` a map is
    // not active in this frame pre-pass, so `exprMap` misses it — spot the union-with-map-arm ident
    // directly so the map scratch frame is reserved (an unused reservation is a harmless spare).
    if unionMapArmIdent(e.idxArr, fnIx) { return true }
    // A MAP-FIELD read through a union's ref-array arm (`t[i].f[k]` after an `is S[]` narrow):
    // likewise invisible to `exprMap` here — spot the member shape from the declared union.
    if unionListElemMapFieldMember(e.idxArr, fnIx) { return true }
    // A MAP-FIELD read through a union's STRUCT arm (`t.f[k]` after an `is {f:{[string]:V}}`
    // narrow): likewise invisible — spot it from the declared union's arm field tables.
    if unionStructArmMapFieldMember(e.idxArr, fnIx) { return true }
    // A map read through a union's ARRAY-OF-MAP arm (`t[i][k]` after an `is {[string]:V}[]`
    // narrow): likewise invisible — spot the index shape from the declared union.
    if unionMapArrayElemIndex(e.idxArr, fnIx) { return true }
    // A map read through a union STRUCT arm's LIST-OF-MAPS field (`t.f[0][k]` after an
    // `is {f: {[string]:V}[]}` narrow): likewise invisible — walk the arm's field path.
    if unionStructArmMapListElemIndex(e.idxArr, fnIx) { return true }
    // The typed-IR net for ANY receiver spelling the syntactic classifiers above miss
    // (`t[i][j][k]` through a 2-D map-array arm, `t.f[k]` on a narrowed union-box
    // binding): the checker records every receiver's own checked type, so one that
    // types as a map — or a union carrying one — reserves the frame regardless of the
    // receiver's shape or depth. (An over-reservation is a harmless spare.)
    if nodeTyUnionHasMapArm(e.idxArr) { return true }
    if exprHasMapOp(e.idxArr, fnIx) { return true }
    return exprHasMapOp(e.idxIndex, fnIx)
  }
  if e is BinExpr {
    // Fused map get-with-default `recv[k] ?? d` (and the method form `recv.get(k) ?? d`).
    if e.binOp == "??" {
      const lhs = P.nodes[e.binLeft]
      if lhs is Index {
        if exprMap(lhs.idxArr, fnIx) { return true }
        if unionMapArmIdent(lhs.idxArr, fnIx) { return true }
        if unionListElemMapFieldMember(lhs.idxArr, fnIx) { return true }
        if unionStructArmMapFieldMember(lhs.idxArr, fnIx) { return true }
        if unionMapArrayElemIndex(lhs.idxArr, fnIx) { return true }
        if unionStructArmMapListElemIndex(lhs.idxArr, fnIx) { return true }
        if nodeTyUnionHasMapArm(lhs.idxArr) { return true }
      }
      if lhs is Call {
        const lcallee = P.nodes[lhs.callFn]
        if lcallee is Member {
          if lcallee.memProp == "get" {
            if exprMap(lcallee.memObj, fnIx) { return true }
          }
        }
      }
    }
    // Map SET `recv[k] = v` (an assignment is a statement, but walk it defensively).
    if e.binOp == "=" {
      const target = P.nodes[e.binLeft]
      if target is Index {
        if exprMap(target.idxArr, fnIx) { return true }
        if unionMapArmIdent(target.idxArr, fnIx) { return true }
        if unionListElemMapFieldMember(target.idxArr, fnIx) { return true }
        if unionStructArmMapFieldMember(target.idxArr, fnIx) { return true }
        if unionMapArrayElemIndex(target.idxArr, fnIx) { return true }
        if unionStructArmMapListElemIndex(target.idxArr, fnIx) { return true }
        if nodeTyUnionHasMapArm(target.idxArr) { return true }
      }
    }
    if exprHasMapOp(e.binLeft, fnIx) { return true }
    return exprHasMapOp(e.binRight, fnIx)
  }
  if e is Call {
    // `recv.has(k)` map membership / `recv.delete(k)` map removal — both touch a map.
    // `m.keys()` / `m.values()` ITERATION also needs the map scratch frame (slot 0
    // holds the map ref for the tombstone-aware `live[i]` skip in the for-in loop).
    const callee = P.nodes[e.callFn]
    if callee is Member {
      if callee.memProp == "has" {
        if exprMap(callee.memObj, fnIx) { return true }
        if unionMapArmIdent(callee.memObj, fnIx) { return true }
        if unionMapArrayElemIndex(callee.memObj, fnIx) { return true }
        if nodeTyUnionHasMapArm(callee.memObj) { return true }
      }
      if callee.memProp == "delete" {
        if exprMap(callee.memObj, fnIx) { return true }
        if unionMapArmIdent(callee.memObj, fnIx) { return true }
        if nodeTyUnionHasMapArm(callee.memObj) { return true }
      }
      if callee.memProp == "keys" || callee.memProp == "values" {
        if exprMap(callee.memObj, fnIx) { return true }
        if unionMapArmIdent(callee.memObj, fnIx) { return true }
        if nodeTyUnionHasMapArm(callee.memObj) { return true }
      }
      // The METHOD map SET `recv.set(k, v)` and its Set twin `recv.add(x)` — the
      // same store the `recv[k] = v` arm above claims, spelled as a member call.
      // `emitMapSet` / `emitMapSetV` gate on `exprMap(callee.memObj)` and stage the
      // key/value in `mapScratchBase + k` with no "frame not reserved" floor, so a
      // receiver this arm did not claim emitted `local.set` against locals that do
      // not exist (INVALID WASM at `vl check` rc 0) whenever NO other map op in the
      // same function happened to reserve the frame. A map LOCAL / PARAM receiver
      // hid it: `fnHasMap`'s declaration scan covers those whatever the body does.
      // Gated on the SAME predicate the handlers use, so this claims exactly the
      // shapes that write the frame — it can never over-reserve.
      if callee.memProp == "set" || callee.memProp == "add" {
        if exprMap(callee.memObj, fnIx) { return true }
        if unionMapArmIdent(callee.memObj, fnIx) { return true }
        if unionMapArrayElemIndex(callee.memObj, fnIx) { return true }
        if nodeTyUnionHasMapArm(callee.memObj) { return true }
      }
    }
    if exprHasMapOp(e.callFn, fnIx) { return true }
    const args = e.callArgs
    let i = 0
    while i < args.length {
      if exprHasMapOp(args[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  if e is Member { return exprHasMapOp(e.memObj, fnIx) }
  if e is Unary { return exprHasMapOp(e.unArg, fnIx) }
  if e is Paren { return exprHasMapOp(e.parInner, fnIx) }
  if e is IsExpr { return exprHasMapOp(e.isObj, fnIx) }
  if e is AsExpr { return exprHasMapOp(e.asObj, fnIx) }
  if e is ObjLit {
    const fields = e.objFields
    let i = 0
    while i < fields.length {
      const f = P.nodes[fields[i]]
      if f is FieldInit {
        if exprHasMapOp(f.fiValue, fnIx) { return true }
      }
      i = i + 1
    }
    return false
  }
  if e is ArrayLit {
    const elems = e.arrElems
    let i = 0
    while i < elems.length {
      if exprHasMapOp(elems[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  false
}

// True if any statement in the block at `blockIx` (descending into if/else branches
// and while bodies) contains a map op. An assignment statement (`recv[k] = v`) is a
// bare `BinExpr` with `binOp == "="` — `exprHasMapOp` recognizes its SET shape.
export function blockHasMapOp(blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      const s = P.nodes[stmts[i]]
      if s is LetDecl {
        if exprHasMapOp(s.letInit, fnIx) { return true }
      } else if s is RetStmt {
        if exprHasMapOp(s.retArg, fnIx) { return true }
      } else if s is BinExpr {
        if exprHasMapOp(stmts[i], fnIx) { return true }
      } else if s is Call {
        if exprHasMapOp(stmts[i], fnIx) { return true }
      } else if s is IfStmt {
        if ifChainHasMapOp(stmts[i], fnIx) { return true }
      } else if s is WhileStmt {
        if exprHasMapOp(s.whileCond, fnIx) { return true }
        if blockHasMapOp(s.whileBody, fnIx) { return true }
      } else if s is ForIn {
        // The ITERABLE is asked through `forInMapRecv` — the emitter's OWN
        // receiver predicate for a for-in header — not through `exprHasMapOp`.
        // `exprHasMapOp` claims the `m.keys()` / `m.values()` Call spellings but
        // has no arm for a BARE map iterable (`for k in m`), because a bare map
        // Ident in an ordinary expression position is not a map op; only this
        // header position makes one. The bare form walks the map's live/keys
        // arrays out of `mapScratchBase`, so a header the scan did not claim
        // emitted `local.set` against locals that do not exist. `for k in
        // m.keys()` IS covered, which is why this hid.
        if forInMapRecv(s.fiIter, fnIx) >= 0 { return true }
        if exprHasMapOp(s.fiIter, fnIx) { return true }
        if blockHasMapOp(s.fiBody, fnIx) { return true }
      } else if s is ForRange {
        if exprHasMapOp(s.frFrom, fnIx) { return true }
        if exprHasMapOp(s.frTo, fnIx) { return true }
        if blockHasMapOp(s.frBody, fnIx) { return true }
      }
      i = i + 1
    }
  }
  false
}

// True if any arm of the `if` / `else if` chain at `ifIx` contains a map op — its
// condition, then-branch, `else` block, OR (recursively) a chained `else if`.
function ifChainHasMapOp(ifIx: i32, fnIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    if exprHasMapOp(s.ifCond, fnIx) { return true }
    if blockHasMapOp(s.ifThen, fnIx) { return true }
    if s.ifElse >= 0 {
      const els = P.nodes[s.ifElse]
      if els is Block {
        if blockHasMapOp(s.ifElse, fnIx) { return true }
      } else if els is IfStmt {
        if ifChainHasMapOp(s.ifElse, fnIx) { return true }
      }
    }
  }
  false
}

// True if the FuncDecl at `fnIx` performs a map op on a GLOBAL struct-field map-array
// element (or any map-op shape `fnHasMap`'s local scan does not already cover) — so it
// reserves the shared 12-slot map scratch frame. OR'd into `fnUsesMap`.
export function fnHasGlobalMapOp(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl { return blockHasMapOp(fn.fnBody, fnIx) }
  false
}

// True if the `LetDecl` at `letIx` declares a map-typed local: its annotation is a map
// type (`{[string]: i32}`), OR its initializer produces a map (`Map()`). Picks the
// local's valtype (`(ref $mStructIdx)`) and the code-`6` flag in `collectLocals`.
export function letIsMap(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // ARENA-FIRST (see `letIsArray`): a `TyMap` is a map however it renders, and a
        // map-member UNION is a `TyUnion` — so the arena's `"map"` arm subsumes BOTH the
        // `nameIsMap` test and its `nameIsMapMemberUnion` exclusion, without splitting the
        // name into top-level atoms. The typed-value maps `repOfMap` leaves uncovered
        // (struct / nullable values, whose slot gates the emitter still owns) fall to the
        // name pair below.
        const k = annRepKindOf(d.letType)
        if k != null {
          if k == "map" { return true }
        } else if nodeTyIsMap(d.letType) {
          // The REP is uncovered but the TYPE is not: `annRepKindOf` answers only where the
          // emitter also knows how to LOWER the map (`repOfMap` declines a struct/nullable value
          // type), while `nodeTyIsMap` answers the strictly weaker question this branch asks —
          // "is this annotation a map at all". So the fall-through is still the arena, one
          // variant tag down, instead of the `nameIsMap` + top-level-union-split pair that had to
          // subtract the map-FIRST union (`{[string]: string} | f64` — a union BOX local, not a
          // map) by hand. D-BAREMAP measured 18,506 twin invocations here, 0 disagreements.
          return true
        }
        // Any registered UNION annotation (a map-member union — map-FIRST `{[..]}|X`, whose
        // `nameIsMap` name the branch above already excluded, or a map-LAST `X|{[..]}` whose
        // name does not start with `{[`) is a union BOX local whose INIT is the bare map ARM
        // (`const v: {[string]: i32} | f64 = h0`). Return false — the annotation is
        // authoritative — so the `exprMap(init)` fall-through below cannot reclaim the box as a
        // bare map; `collectLocals` then reaches `letIsUnion` and the cell rides its union box.
        if isUName(lt.tyName) { return false }
      }
    }
    return exprMap(d.letInit, fnIx)
  }
  false
}

// True if the `LetDecl` at `letIx` declares a NULLABLE map local (`{[string]: V} | null`,
// kind `nulmap`): its annotation is a nullable map, OR its initializer produces one (a
// nulmap param/local passthrough, or a nulmap-returning call). Checked BEFORE `letIsMap` in
// the collect ladder so a nullable init does not collapse to the non-null kind `"map"`.
export function letIsNulMap(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      if retNulMapFlag(d.letType) == 1 { return true }
    }
    return exprNullableMap(d.letInit, fnIx)
  }
  false
}
// The map SHAPE code of a nulmap-typed `LetDecl` (the same vocabulary as `letMapShapeOf`:
// `-2` Set, mv slot >= 0, `-1` mono, `-3` unsupported). Annotation-first (the `| null`-aware
// `mapAnnShape`), else the nulmap initializer's shape.
export function nulMapShapeOf(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      if retNulMapFlag(d.letType) == 1 { return mapAnnShape(d.letType) }
    }
    return mapShapeOfExpr(d.letInit, fnIx)
  }
  -1
}

// The map SHAPE code of a map-typed `LetDecl`: `-2` a Set, an mv SLOT (>= 0) for a
// ref-valued map (from the annotation's value type-name), `-1` the mono i32 map,
// `-3` an unsupported value type (op sites fail loudly). Annotation-first, else the
// initializer's shape (a `Map()`/`Set()` constructor, or a map-typed passthrough).
// True if the `LetDecl` at `letIx` declares an i32-KEYED map/set. Annotation-first (the
// spelling, `| null` tolerated by the KEY CUT's width), else the checker's recorded type
// on the initializer — which is the only answer for an un-annotated `const s = Set()`
// whose key the first `.add(1)` pinned.
function letI32KeyedMap(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        if nameIsI32KeyedMap(lt.tyName) { return true }
      }
      if nodeTyMapKeyIsI32(d.letType) { return true }
    }
    return nodeTyMapKeyIsI32(d.letInit)
  }
  false
}

export function letMapShapeOf(letIx: i32, fnIx: i32) {
  if letIsSet(letIx) {
    // The Set flavor of the i32-keyed rep (`-5`): a Set is a boolean-valued map, so it
    // is mono either way — the sentinel is what keeps `.values()` yielding ELEMENTS.
    if letI32KeyedMap(letIx) { return -5 }
    return -2
  }
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // A map-member UNION annotation is NOT a bare map (see `letIsMap`) — skip it so the union
        // box, not a garbled map value shape, is picked. ARENA (D-BAREMAP): a `TyUnion` is not a
        // `TyMap`, so the exclusion is the classifier itself rather than a second scan after it.
        //
        // …AND THE VALUE DOES *NOT* COME OFF THE SAME `TyMap` THE GATE JUST READ — MEASURED,
        // NOT ASSUMED (D-MAPNODETY). This is the single largest re-resolution in the whole
        // `fieldElemTyIxOfName` population (2,042 of its 9,805 `resolveAnnot` reaches on
        // `tests/cases`) and the obvious route — give `mvShapeOfMapName` a `Ty` form and hand it
        // the `nodeMapValTyIx(d.letType)` the gate above already proved is a `TyMap` — is WRONG.
        // A dual-write of the two legs over the corpus: 2,097 entries, ALL covered, and **128
        // land on a DIFFERENT mv slot** (both legs answering, `A=0` vs `L=1`), from ONE fixture,
        // `tests/cases/maps/alias-positions-and-value-kinds.vl`.
        //
        // THE CAUSE IS AN ALIAS NAME THE EMIT SPELLING DROPS. That fixture declares
        // `type Pt = {x:i32}` and `type P = {[string]: Pt}`; `lt.tyName` renders the value as
        // the INLINE `{x:i32}` while the arena keeps the NOMINAL `Pt`, and `repMvValKey` keys a
        // struct nominally — so the two spellings claim two different mv slots and the shipped
        // answer is the name's. (That fixture's own header argues the map arm has no such
        // exposure because "`tyToEmitName`'s map arm emits `{[K]:V}` whatever `V` is". True of
        // the map NAME; false one layer down, at the mv slot the value name resolves.)
        // Routing this site is a behaviour change, not a refactor — it needs the alias identity
        // in the emit spelling, or an mv layer keyed structurally at the value. The four
        // conflict-free node sites are routed; this one is not.
        if nodeTyIsMap(d.letType) { return mvShapeOfMapName(lt.tyName) }
      }
    }
    return mapShapeOfExpr(d.letInit, fnIx)
  }
  -1
}

// The map SHAPE code of a map-typed EXPRESSION (the receiver of a map op): `-2`
// Set, mv slot >= 0, `-1` mono, `-3` unsupported. Mirrors `exprMap`'s resolution
// chain: constructor calls, locals (the kind-6 parallel slot stored by
// `collectLocals`), globals (their `LetDecl`'s shape), and the mono-only map-array
// element / `.pop()` forms. Map-typed PARAMS stay mono-only (no `vtKindOfParam`
// map case exists yet — a ref-valued map cannot cross a call boundary).
export function mapShapeOfExpr(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[exprIx]
  if e is Paren { return mapShapeOfExpr(e.parInner, fnIx) }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if callee.identName == "Set" {
        if nodeTyMapKeyIsI32(exprIx) { return -5 }
        return -2
      }
      // A map-returning function yields its declared map SHAPE (mono ⇒ -1, or a `string`-valued
      // map's mv slot); a `Map()` constructor is the mono map (-1).
      const fe = fnIndexOfSid(sidOfNode(e.callFn))
      if fe >= 0 { return fnRetMapShapeSid(sidOfNode(e.callFn)) }
    }
    // An i32-KEYED constructor / factory result: the KEY comes off the CALL's own
    // recorded type, since a bare `Map()` carries no spelling. It is the other half of
    // the slot identity, so it is read HERE and PAIRED with the value below rather than
    // short-circuiting to the mono sentinel (which was right only while an i32-keyed map
    // could not have a ref value).
    const ckI32 = nodeTyMapKeyIsI32(exprIx)
    // FALLBACK: a map-returning CLOSURE-VALUE / factory call whose callee the syntactic path misses (a
    // closure local `v()`, an indexed closure `arr[i]()`) — resolve the shape from the checker's recorded
    // map VALUE type (mono/atom ⇒ -1, else the value name's mv slot). Mirrors the `exprMap` fallback and
    // `structIndexOfExpr`'s `nodeTyName` struct fallback, so `v()[k] ?? d` picks the right value rep.
    if nodeTyIsMap(exprIx) { return mapFindShapeOfNodeTy(exprIx) }
    if ckI32 { return -4 }
    return -1
  }
  if e is Ident {
    // A union binding NARROWED to a MAP arm resolves its shape from the arm's VALUE type (mono ⇒
    // -1, or a typed value's mv slot) — the map ops in the narrowed branch read that value type,
    // not the mono i32 assumption a bare -1 would force. Checked FIRST (the declared type is a
    // union, so `declaredMap`/`paramMap`/global below miss it), mirroring `exprMap`.
    // …and the VALUE type comes off the same narrow-stack row as the arm spelling
    // (D-MVSLOTFIND — `narrowedMapValTyOf`), so the rendered `{[K]: V}` is no longer
    // re-sliced and re-parsed to recover what the `is`-push banked. The name leg stays
    // BELOW it, unmoved, for a narrow that banked no single type.
    const nm = narrowedMapOf(e.identName)
    if nm != "" {
      return mvSlotOfMapNameTy(nm, narrowedMapValTyOf(e.identName))
    }
    if declaredMap(e.identName) {
      const slot = declaredSlotOf(e.identName)
      if slot >= 0 { return localStructIdx[slot] }
      return -1
    }
    // A map PARAM's shape is its annotation's value type (mono ⇒ -1, or a `string`-valued
    // map's mv slot) — so the body's map ops resolve the param's VALUE type, not the mono i32
    // assumption a bare `-1` would force.
    if paramMap(fnIx, e.identName) { return paramMapShape(fnIx, e.identName) }
    // A NULLABLE map binding narrowed non-null — its shape is the `| null`-stripped map value type,
    // resolved from the local slot (`declaredNulMap`) or the param annotation (`paramNulMap`), so the
    // narrowed `t["k"]` reads THIS map's value rep (not the mono i32 assumption).
    if declaredNulMap(e.identName) {
      const nslot = declaredSlotOf(e.identName)
      if nslot >= 0 { return localStructIdx[nslot] }
      return -1
    }
    if paramNulMap(fnIx, e.identName) {
      return paramMapShape(fnIx, e.identName)
    }
    // A CAPTURED map variable of a lifted lambda: resolve its shape from the PARENT
    // frame's binding, the map dual of `capturedUnionName` — so a captured typed-value
    // map boxes/reads with its own mv slot rather than the mono -1.
    if capturedKindOf(fnIx, e.identName) == "map" {
      const cfe = fnStmtsPosOf(fnIx)
      if cfe >= 0 {
        const cb = parentBindingOf(cfe, e.identName)
        if cb >= 0 {
          const cbn = P.nodes[cb]
          if cbn is LetDecl {
            const cpar = parentBindingFrameOf(cfe, e.identName)
            if cpar >= 0 { return letMapShapeOf(cb, fnStmts[cpar]) }
          }
        }
      }
      return -1
    }
    const gl = globalLetOf(e.identName)
    if gl >= 0 {
      if letIsMap(gl, -1) { return letMapShapeOf(gl, -1) }
      if letIsNulMap(gl, -1) { return nulMapShapeOf(gl, -1) }
    }
  }
  // A MAP-typed struct field read (`node.children`, code 19): the shape is the field
  // row's (KEY, VALUE) pair — `-1` the mono string-keyed map, `-4` the mono i32-keyed
  // one, a mv slot for a ref/wide value. Mirrors `memberFieldCode`'s receiver dispatch
  // — a NARROWED union member (`t0.f` after `is {f:{[string]:V}}`) and a VARIANT-typed
  // value resolve through the variant field tables (without the arms the read fell to
  // the mono -1 and the typed map ref mismatched its mono-typed scratch local — invalid
  // wasm), a plain struct receiver through the struct table. All three read the shape
  // through the same home the CONSTRUCT and the TYPE SECTION do (B6b): a receiver
  // classifier that answered a different struct than the field's storage type is the
  // same invalid-wasm class one layer up.
  if e is Member {
    if memIsNarrowed(exprIx) {
      const nvi = memNarrowVariantIndex(exprIx)
      if nvi >= 0 {
        const nvfi = variantFieldIndex(nvi, e.memProp)
        if nvfi >= 0 {
          const nvc = variantFieldTypeAt(nvi, nvfi)
          if nvc == 19 || nvc == 29 { return uFieldMapShape(nvi, nvfi) }
        }
      }
    }
    const pvi = exprVariantIndex(e.memObj, fnIx)
    if pvi >= 0 {
      const pvfi = variantFieldIndex(pvi, e.memProp)
      if pvfi >= 0 {
        const pvc = variantFieldTypeAt(pvi, pvfi)
        if pvc == 19 || pvc == 29 { return uFieldMapShape(pvi, pvfi) }
      }
    }
    const msi = structIndexOfExpr(e.memObj, fnIx)
    if msi >= 0 {
      const mfi = sFieldIndex(msi, e.memProp)
      if mfi >= 0 {
        const mfc = sFieldTypeAt(msi, mfi)
        if mfc == 19 || mfc == 29 { return sFieldMapShape(msi, mfi) }
      }
    }
  }
  // A composition MAP READ that yields a typed-value map — either a NESTED-map read
  // (`outer[k]` / `outer[k] ?? d`, whose receiver's VALUE is itself a map) or a LIST-of-maps
  // element read (`xs[i]`). The read produces the element map, whose shape is the element
  // map's OWN value slot. Without this the binding falls to the mono map (-1) and its
  // `(ref $mStructIdx)` local rejects the typed map ref the read produces.
  const cms2 = compositionMapReadSlot(exprIx, fnIx)
  if cms2 != -2 { return cms2 }
  -1
}

// The mv slot of the map a COMPOSITION read yields, `-1` for a mono/atom-valued map (it
// rides the shared `$mStructIdx`), or the sentinel `-2` when the expression is not a
// composition map read at all (so the caller keeps its own `-1` default). Two shapes:
//   · a NESTED-map read (`outer[k]` / `outer[k] ?? d`): the inner map is the receiver's
//     vals ref-list element (`{[string]: V}` → `V`).
//   · a LIST-of-maps element read (`xs[i]`): the map is the ref-list element itself.
function compositionMapReadSlot(exprIx: i32, fnIx: i32): i32 {
  // Nested-map read: resolve the receiver's mv slot, then its inner map value.
  let os = coalesceMvSlot(exprIx, fnIx)
  if os < 0 { os = mapReadMvSlot(exprIx, fnIx) }
  if os >= 0 && mvValIsMap(os) { return rlElemMapValMvSlot(mvRlSlot[os]) }
  // List-of-maps element read: the element name is the map type; its value picks the slot.
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemKindTbl.length && rlElemKindTbl[slot] == 3 {
        // A NULLABLE map element strips to its inner map for the value-slot resolve.
        return rlElemNulMapValMvSlot(slot)
      }
    }
  }
  -2
}

// The mv slot whose map value type-name is `iv`, `-1` for a mono / atom value
// (`i32` / `boolean` / literal-union atom — never interned, rides `$mStructIdx`), or
// `-3` for a TYPED value whose slot was never interned (unsupported — op sites fail
// loudly, never the silent mono fallback). A mono-tolerant find (unlike
// `mvSlotOfValNameFind`, which fails loudly on the mono miss) for the composition
// read resolvers.
// The mv slot of the VALUE of the bare-map spelling `mapName` —
// `mvSlotOfMapValNameOrMono` of `mapValNameOf`. SEVEN sites composed the pair by hand.
// Same shape as `mvShapeOfMapName` (the intern side) and `mapValKindLowerable` (the
// support side): three questions about a map's value, each of which was being answered
// by re-slicing `V` out of `{[string]: V}` at every asking.
function mvSlotOfMapName(mapName: string): i32 {
  mvSlotOfMapNameTy(mapName, -1)
}
// The `Ty` form (D-MAPNODETY): `valTy` is the map VALUE's banked arena type when the caller
// holds the node, else -1. There is deliberately NO intern-side twin of this — the intern
// path is `mvShapeOfMapName`, and its header says why it does not get one.
function mvSlotOfMapNameTy(mapName: string, valTy: i32): i32 {
  // The KEY comes off the map spelling, exactly as on the intern side
  // (`mvShapeOfMapName`); a MONO value needs no slot on either key rep, so it is the
  // `-1`/`-4` sentinel pair.
  const ki = nameIsI32KeyedMap(mapName)
  const sl = mvSlotOfMapValNameOrMonoKTy(mapValNameOf(mapName), ki, valTy)
  if sl == -1 { return mapMonoShapeOfKey(ki) }
  sl
}

export function mvSlotOfMapValNameOrMono(ivIn: string): i32 {
  mvSlotOfMapValNameOrMonoK(ivIn, false)
}

export function mvSlotOfMapValNameOrMonoK(ivIn: string, keyI32: boolean): i32 {
  mvSlotOfMapValNameOrMonoKTy(ivIn, keyI32, -1)
}
// The `Ty` form (D-MAPNODETY) — the same rung swap `mapAnnShape` makes: the arena leg's
// type comes from the caller's node when it banked one, and every other rung (the mono
// early-out, the name scan, the loud `-3`) is unmoved.
export function mvSlotOfMapValNameOrMonoKTy(
  ivIn: string,
  keyI32: boolean,
  valTy: i32,
): i32 {
  const iv = mvCanonValName(ivIn)
  if mvValKindOfName(iv) == -1 { return -1 }
  let aMo = -1
  if valTy >= 0 { aMo = mvSlotOfTyK(valTy, keyI32) }
  if aMo < 0 { aMo = mvSlotOfValNameTyK(ivIn, keyI32) }
  if aMo >= 0 { return aMo }
  const nmMo = mvSlotByValNameK(iv, keyI32)
  if nmMo >= 0 { return nmMo }
  // A TYPED value name (kind != -1) with NO interned slot: the map was reached through a
  // seam whose collect pass missed it. Returning the mono `-1` here silently lowered the
  // read/store as the i32 map — the value rep then mismatched (invalid wasm). `-3`
  // (unsupported) keeps the op sites' loud-reject contract instead.
  -3
}

// ── string-typedness of expressions ──────────────────────────────────────────
// Parallel to the array family above: decide whether an expression / param / local
// PRODUCES a `string` (CURRENTLY the same `(array (mut i32))` of code points an array
// is — `docs/strings-design.md`). Used to route `s.length` to `array.len` and `s[i]`
// to `array.get`, and to give string locals/params the array ref valtype. Like the
// array family, a `.length`/index READ yields an i32 (NOT a string), so neither
// counts here. Concatenation (`+`), equality (`==`), and `slice`/`indexOf` are DEFERRED
// (this slice covers only literal construction + `.length` + index read), so no
// binary/call op below produces a string except a `string`-returning call.

// True if the function `name` declares `string` as its return type. The `fromCodePoint`
// compiler builtin (H2) constructs a single-character VL string, so it is `string`-
// returning too — classifying it here (the single chokepoint `exprString` consults for
// a named call) routes `value + fromCodePoint(cp)` to string concat, flags
// `let s = fromCodePoint(n)` as a string local, etc., exactly as a user `string`-
// returning function would be.
function fnRetStringSid(sid: i32) {
  // The three BUILTIN string producers are recognized by spelling, not by the
  // function table — `sidText` reads the spelling back out of the intern table with
  // an array index (the sid form's callers all mint, so the text is faithful).
  const name = sidText(sid)
  if name == "fromCodePoint" { return true }
  if name == "fromCodePoints" { return true }
  if name == "toString" { return true }
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "str"
}

// True if the parameter `name` of function `fnIx` is `string`-typed.
function paramString(fnIx: i32, name: string) {
  const pt = paramTypeNode(fnIx, name)
  if retNulStringFlag(pt) == 1 { return true }
  nameIsString(tyNameOf(pt))
}

// True if the already-collected declared local `name` is a string ref (code `3`).
function declaredString(name: string) {
  // A `string | null` (kind 16) local reads AS a string for string ops — it is narrowed
  // non-null at every such read (the checker gates string ops on the narrowed branch),
  // and the array ops (`array.len`/`array.get`) accept the nullable ref. The `!= null`
  // null-check reads it through `exprNullableString` FIRST, so this never mis-routes it.
  const dk = declaredKind(name)
  return dk == "str" || dk == "nulstr"
}

// True if evaluating the expression at `exprIx` yields a string: a string literal, a
// `string`-returning call, a string param/local reference, or a parenthesized string
// expression. An index read / `.length` yields an i32, so neither counts.
// The wasm-type CODE (`0` i32/bool, `3` string, `4` i32[], `5` ref list, `6` string
// list) of the field a `Member` access `recv.field` reads, resolving the receiver
// through the three field-bearing shapes — a NARROWED union local (`if n is A {…}`),
// a VARIANT-TYPED value/param (`fn f(n: A)`, the `checkXNode(n: Variant)` idiom), or a
// plain declared struct — or -1 when the receiver is none of these. The single place
// the `exprString`/`exprStruct`/`exprArray`/`exprMap` classifiers consult so a field
// read of ANY receiver shape resolves to its declared field type.
function memberFieldCode(memIx: i32, fnIx: i32) {
  const e = P.nodes[memIx]
  if e is Member {
    if memIsNarrowed(memIx) {
      const vi = memNarrowVariantIndex(memIx)
      if vi >= 0 {
        const vfi = variantFieldIndex(vi, e.memProp)
        if vfi >= 0 { return variantFieldTypeAt(vi, vfi) }
      }
      return -1
    }
    const pvi = exprVariantIndex(e.memObj, fnIx)
    if pvi >= 0 {
      const pvfi = variantFieldIndex(pvi, e.memProp)
      if pvfi >= 0 { return variantFieldTypeAt(pvi, pvfi) }
      return -1
    }
    const si = structIndexOfExpr(e.memObj, fnIx)
    if si >= 0 {
      const fi = sFieldIndex(si, e.memProp)
      if fi >= 0 { return sFieldTypeAt(si, fi) }
    }
  }
  -1
}

export function exprString(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is StrLit { return true }
  if e is Paren { return exprString(e.parInner, fnIx) }
  // An if-EXPRESSION whose branch join is a STRING (`const b = if c { "x" } else { "y" }`):
  // the value is a string ref, so an UN-annotated binding classifies kind 3 — matching the
  // `(ref $aTypeIdx)` the `emitIfExprRef` join already emits. The checker proved both arms
  // agree, so the THEN arm's rep classifies the whole `if` (the numeric `exprIsF64`/`exprIsI64`
  // duals consult `ifExprArmIsKind` the same way). Without this an un-annotated string if-value
  // bound an i32 local while the `if` yielded a string ref — a wasm type mismatch.
  if e is IfStmt {
    // The JOIN's checked type is the arm-order-independent signal: a `string`-typed
    // join may LEAD with an atom arm (`if c then k else "cc"`), which alone doesn't
    // read stringy — the atom arm widens at `emitRefIfArm`, so the value IS a string.
    if tyKindOf(nodeTyIxOf(exprIx)) == 3 { return true }
    const tv = ifThenValueIx(exprIx)
    return tv >= 0 && exprString(tv, fnIx)
  }
  if e is Call {
    // G6: `s.slice(...)` over a string receiver produces a string. Otherwise a
    // bare call produces a string iff the callee declares a `string` return.
    if exprIsStrSlice(exprIx, fnIx) { return true }
    // An INDEXED closure call `fs[i](x)` whose element signature returns `string`.
    if cloArrCallRetKind(exprIx, fnIx) == "str" { return true }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if fnRetStringSid(sidOfNode(e.callFn)) { return true }
      // A string-returning function VALUE (a binding / `(i32) => string` param callee,
      // invisible to `fnRetString`): its resolved `>S` sig. EXCEPT a call the checker
      // typed as an aliased LITUNION (`t(3)` where `t: (i32) => K0` came off a map
      // `?? d` read): the binding's sig resolves through the checker's RENDERED type
      // name, which softens `K0` to `string` — keying `>S` — while the call_ref's
      // result reps the i32 ATOM. The node-type gate on the per-node fallback below
      // already excludes it; the per-name claim needs the same gate, else `print`
      // hands the raw atom to the string path (invalid wasm). The atom widens at
      // `exprIsLitAtom` instead.
      if calleeReturnsStringSid(sidOfNode(e.callFn), fnIx) {
        if !nodeTyIsLitUnionAlias(exprIx) { return true }
      }
    }
    // A string-returning FIELD-closure call (`o.label(3)` over a `(i32) => string` field).
    if callee is Member {
      const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if ffe >= 0 {
        // EXCEPT a call the checker typed as an aliased LITUNION — the atom reps
        // i32, and same-fieldset twin rows can alias `fieldClosureFeOf` onto the
        // OTHER row's string-result lambda (`f: (i32,i32,i32) => K0` beside a twin's
        // `f: (i32,i32,i32) => string` — the `cloCallSigKey` twin discipline): the
        // string claim would route `print` to the ref path over the raw i32 atom —
        // INVALID-WASM (fuzz post-#991 branching leg, seed 142348133 case_00233).
        // The member dual of the Ident-callee `calleeReturnsString` gate above.
        if fRetKind[ffe] == "str" {
          if nodeTyIsLitUnionAlias(exprIx) { return false }
          // A `{f: (…) => string}` field beside a `{f: (…) => boolean}` twin collapses to
          // the SAME layout heap type, so `fieldClosureFeOf` can resolve the OTHER field's
          // STRING lambda for a genuinely-BOOLEAN (or other non-string) closure call. Trust
          // the CHECKER's recorded result type when present: it typed `p.z.f(1,1,1)` boolean
          // (kind 0), so the string routing is wrong — `print` would read a raw i32 as a
          // string ref (INVALID-WASM; fuzz sweep wo7cNe declared, seed 172658796). Fall back
          // to the fe's kind only when the node is un-typed (defensive).
          const nts = nodeTyIxOf(exprIx)
          if nts >= 0 { return tyKindOf(nts) == 3 }
          return true
        }
        return false
      }
    }
    // A closure-VALUE call whose callee sig the per-NAME resolvers above cannot key — a local
    // whose closure type was inferred from a Member/Index init (`const t0 = v[0].f`, a
    // nullable-closure struct field narrowed non-null). `calleeCloSigKey` (per name) lacks the
    // `nodeTyName` fallback the actual `call_ref` lowering (`cloCallSigKey`, per call node) uses,
    // so the two disagreed: the call emitted a `() => string` `call_ref` (a string ref) while this
    // classifier said i32 → `print` dispatched `__print_i32__` on a string (invalid wasm). Resolve
    // the call node's sig the SAME way the emitter does so print/coerce dispatch agrees — but only
    // when the checker ALSO typed the result a plain `string` (kind 3). A string-LITERAL-union result
    // (`(i32) => K0`, `K0 = "a" | "b"`) keys `>S` too yet reps as the i32 ATOM, so the sig alone would
    // mis-claim it a string (a `(ref $type)` vs i32 mismatch); the node-type gate excludes it.
    if tyKindOf(nodeTyIxOf(exprIx)) == 3 {
      if sigKeyRetKind(cloCallSigKey(exprIx, fnIx)) == "str" { return true }
    }
    return false
  }
  if e is BinExpr {
    // A `m[k] ?? d` / `m.get(k) ?? d` read over a STRING-valued map yields a string ref (the
    // value type). A NULLABLE-string value with a NULLABLE default stays `string | null`
    // (`exprNullableString`'s); a non-null default coalesces to a non-null string.
    const cms = coalesceMvSlot(exprIx, fnIx)
    if cms >= 0 {
      return mvValKind[cms] == 3 && !coalesceStaysNullable(exprIx, cms, fnIx)
    }
    // `r ?? d` over a `string | null` LHS yields a (non-null) string — the coalesce
    // recovers the non-null array ref, so `.length`/`+`/etc. on the result work.
    if e.binOp == "??" {
      if exprNullableString(e.binLeft, fnIx) { return true }
    }
    // G6: string concatenation `a + b` produces a string; no other binary operator
    // does (`==`/`!=` yield an i32).
    return exprIsStrConcat(exprIx, fnIx)
  }
  if e is Ident {
    // A VALUE-union ident is a string ONLY when narrowed to the `string` atom
    // (the unboxed read is the array ref); an un-narrowed union binding is the
    // BOX, even when its init was a string literal (see exprIsI64).
    const uk = unionIdentReadKind(exprIx, fnIx)
    if uk != -3 { return uk == 2 }
    if paramString(fnIx, e.identName) { return true }
    if declaredString(e.identName) { return true }
    // A CAPTURED string (`const s = "…"; () => s.length`): the env field is a string ref (kind
    // 3), so classify it like a string param/local — else `s.length` reads as a struct field.
    if capturedKindOf(fnIx, e.identName) == "str" { return true }
    return globalIsStringSid(sidOfNode(exprIx))
  }
  // An index read over a STRING list (`names[i]`, a `string[]` element) yields a
  // string ref. (An index over an i32 list or a string `s[i]` yields an i32 — the
  // string-array check is the only string-producing index form.)
  if e is Index {
    if exprStringArray(e.idxArr, fnIx) { return true }
  }
  // A field read `p.f` where `f` is a STRING struct field yields a string ref (gap #2:
  // `let k = t.kind` must give `k` the string type, not i32).
  if e is Member {
    // A UNION-typed field read narrowed to the `string` atom unboxes to the
    // string ref (the member-path dual of the Ident rule above).
    const muk = memberUnionReadKind(exprIx, fnIx)
    if muk != -3 { return muk == 2 }
    // A field read whose declared field type is `string` (code 3), or a `string | null`
    // niche field (code 20) read as a VALUE (it recovers the non-null string ref) —
    // resolved through the narrowed-local / variant-param / plain-struct shapes by
    // `memberFieldCode`.
    const mfc = memberFieldCode(exprIx, fnIx)
    return mfc == 3 || mfc == 20
  }
  false
}

// True if the `LetDecl` at `letIx` declares a string-typed local: its annotation is
// `string`, OR its initializer produces a string. Picks the local's valtype
// (`(ref $aTypeIdx)` vs i32) in `collectLocals`.
export function letIsString(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        if nameIsString(lt.tyName) { return true }
      }
    }
    return exprString(d.letInit, fnIx)
  }
  false
}

// True if the `LetDecl`/global at `letIx` declares an `i64` binding. ANNOTATION-ONLY:
// a bare integer literal stays i32 by design (Slice 1 keeps existing programs
// byte-identical), so only an explicit `: i64` annotation selects the i64 slot
// (valtype `0x7e`, kind 10). The initializer literal is then lowered as `i64.const`.
export function letIsI64(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        if lt.tyName == "i64" { return true }
      }
      return false
    }
    // Un-annotated: infer i64 from the initializer (`const m = n` where `n: i64`, i64
    // arithmetic, an i64-returning call), mirroring the host and `letIsF64`. At MODULE
    // scope (`fnIx < 0`) this recurses through `globalIsI64` for a global-ident operand,
    // terminating for an acyclic program (each global's init is below it) — the same shape
    // `globalKind`'s expression-family classifiers already rely on.
    if d.letInit >= 0 { return exprIsI64(d.letInit, fnIx) }
  }
  false
}

// True if the `LetDecl`/global at `letIx` declares an `f64` binding: an explicit
// `: f64` annotation, OR an UN-annotated binding whose initializer is a float `.`
// literal (e.g. `const a = 1.5`). Such a binding selects the f64 slot (valtype 0x7c,
// kind 11) and lowers its init literal as `f64.const`. An un-annotated float `let`
// was previously a hard error (`checkExprI32` rejects `.`), so accepting it here is
// strictly additive — no existing i32 program changes. (Slice 3.)
export function letIsF64(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        if lt.tyName == "f64" { return true }
      }
      return false
    }
    if d.letInit >= 0 {
      const ie = P.nodes[d.letInit]
      if ie is NumLit { return numTextIsFloat(ie.numText) }
      // An f32 init is NOT an f64 binding — the f32-before-f64 order the whole family
      // obeys, stated here because this predicate is the BINDING-level answer every READ
      // site reaches (`globalIsF64` is one line of delegation to it). `exprIsF64`
      // over-claims a mixed f32/float-literal init (`fv * 1.0`), so without this an
      // un-annotated inferred-f32 global answered "f64" to `exprIsF64` while its CELL was
      // f32 — and `x = 2.5` / `x = fv` over it emitted `emitExprAsF64` into an `(mut f32)`
      // cell. The slot ladders (`collectLocals`, `globalCellKind`) all ask their f32 arm
      // first, so no site that reaches here after an f32 arm changes.
      if exprIsF32(d.letInit, fnIx) { return false }
      // Un-annotated: infer f64 from the initializer (`const r = 1.5 + 2.5` / `const m =
      // x` where `x: f64` / a float-returning call). At MODULE scope (`fnIx < 0`) this
      // recurses through `globalIsF64` for a global-ident operand, which terminates for an
      // acyclic program (each global's init is below it) — the same shape `globalKind`'s
      // expression-family classifiers (`exprString` / `exprStruct` / …) already rely on.
      return exprIsF64(d.letInit, fnIx)
    }
  }
  false
}

// True if the `LetDecl` at `letIx` binds a FUNCTION VALUE (kind 14): its initializer is
// a `function(...)` literal, a bare reference to a top-level/lifted function name, or a
// call returning a function value. The cell is the closure fat-pointer `(ref
// $cloStructIdx)`. (Lambdas.)
export function letIsClosure(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letInit < 0 { return false }
    return exprIsClosure(d.letInit, fnIx)
  }
  false
}

// True if the expression at `exprIx` evaluates to a function value (a closure
// fat-pointer): a `function(...)` literal, a bare reference to a top-level/lifted
// function name, a reference to a closure-typed param/local, or a call returning a
// function value (a function whose body's tail is itself a function value).
export function exprIsClosure(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Paren { return exprIsClosure(e.parInner, fnIx) }
  if e is FuncDecl { return true }
  // An if-EXPRESSION whose branch join is a CLOSURE (`const f = if c then g else h`): the value
  // is a closure ref, so an un-annotated binding classifies kind 14 — the THEN arm's rep (the
  // arms agreeing by the checker), matching the `(ref $cloStruct)` `emitIfExprRef` emits.
  if e is IfStmt {
    const tv = ifThenValueIx(exprIx)
    return tv >= 0 && exprIsClosure(tv, fnIx)
  }
  if e is Ident {
    if fnIndexOf(e.identName) >= 0 { return true }
    // A union binding NARROWED to a bare-closure arm (`if x is () => i64 { x() }`): its box
    // payload IS the closure fat-pointer (`emitValueUnionUnboxRead` casts to `$cloStructIdx`),
    // so it calls via `call_ref` exactly like a closure local — route the CALL here. Checked
    // FIRST since the binding's DECLARED type is a union, so the param/local closure tests miss it.
    if narrowedClosureOf(e.identName) != "" { return true }
    // A closure-typed param/local (kind 14), or a NULLABLE one (kind 19) — both call via
    // `call_ref`; the nullable cell is recovered to non-null at the call site (after the
    // `if c != null` narrowing the checker requires).
    if paramIsClosure(fnIx, e.identName) { return true }
    if paramNulClosure(fnIx, e.identName) { return true }
    const slot = declaredSlotOf(e.identName)
    if slot >= 0 {
      return localIsRef[slot] == "closure" || localIsRef[slot] == "nulclosure"
    }
    // A module-global closure cell — a bare closure (kind 14) or a NULLABLE one (kind 19).
    const gl = globalLetOf(e.identName)
    if gl >= 0 {
      const gk = globalCellKind(gl)
      return gk == "closure" || gk == "nulclosure"
    }
    return false
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const t = fnIndexOfSid(sidOfNode(e.callFn))
      if t >= 0 { return fnReturnsClosure(t) }
      // A CLOSURE-VALUE callee (`f(4)` where `f: (i32) => ((i32) => i32)`) whose result is
      // itself a closure — resolved from `f`'s `$fnsig` result (`>c`). Lets a curried lambda
      // `const g = f(4)` bind `g` as a closure and call it.
      return calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "closure"
    }
    // A CHAINED value call `g()()` — the callee is itself a Call (`g()`) yielding a closure.
    // The whole call is a closure iff the checker typed its RESULT as a function type; the
    // inner call lowers via its own `exprIsClosure`/`call_ref`. Reads the checker type
    // directly (the same source `cloCallSigKey` keys off), so no per-position resolver.
    // The "is it a function type" question is asked of the ARENA (`nodeTyIsFuncTy`,
    // D-ARROWTY) instead of of the render; the render survives only as the
    // does-it-render gate that made the old `annArrowAt` test byte-exact.
    const tn = nodeTyName(exprIx)
    return tn != "" && nodeTyIsFuncTy(exprIx)
  }
  if e is Member {
    // A closure FIELD of a NARROWED union receiver (`t0 is {a, f: (i32) => K0, z} {
    // t0.f(1) }`) or a variant-typed receiver reads back a closure exactly like a plain
    // struct's — the variant-table twin of `memberIsClosure` (the `memFieldTypeCode`
    // dispatch order), so the call routes to `call_ref`.
    let mviC = -1
    if memIsNarrowed(exprIx) {
      mviC = memNarrowVariantIndex(exprIx)
    } else {
      mviC = exprVariantIndex(e.memObj, fnIx)
    }
    if mviC >= 0 {
      const mvfiC = variantFieldIndex(mviC, callMemProp(exprIx))
      if mvfiC >= 0 {
        const vfcC = variantFieldTypeAt(mviC, mvfiC)
        if vfcC == 14 || vfcC == 22 { return true }
      }
    }
    // A struct field holding a function value reads back as a closure.
    return memberIsClosure(e.memObj, callMemProp(exprIx), fnIx)
  }
  // An index `xs[i]` into an ARRAY OF FUNCTIONS (`((i32) => i32)[]`, ref-list element
  // kind 5) reads back a closure fat-pointer — callable via `call_ref`.
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemKindTbl.length {
        return rlElemKindTbl[slot] == 5
      }
    }
    // A bare `m[k]` over a FUNCTION-valued map (`{[string]: (i32) => i32}`, mv kind 14) reads
    // back the closure (nullable — narrow with `if f != null`).
    const mrs = mapReadMvSlot(exprIx, fnIx)
    if mrs >= 0 { return mvValKind[mrs] == 14 }
  }
  // `m[k] ?? d` over a function-valued map yields the closure (a nullable-value slot with a
  // non-null default coalesces to the non-null closure; a nullable default stays
  // `closure | null`, claimed by `exprNullableClosure`).
  if e is BinExpr {
    const cm = coalesceMvSlot(exprIx, fnIx)
    if cm >= 0 {
      return mvValKind[cm] == 14 && !coalesceStaysNullable(exprIx, cm, fnIx)
    }
  }
  false
}

// The closure-ABI param-kind code for a type NAME — the annotation-string analogue of
// `cloParamTok` (which reads the AST), producing the IDENTICAL token per valtype so a
// value call over an annotated higher-order callee (`g: (string) => i32`) resolves the
// same interned `$fnsig` the passed lambda was minted under. "" for a type outside the
// value-call ABI (the all-i32 arity fallback / soundness floor then applies).
function annParamKind(t: string) {
  if t == "i32" || t == "boolean" { return repSigTokOfKind("i32") }
  if t == "f64" { return repSigTokOfKind("f64") }
  if t == "i64" { return repSigTokOfKind("i64") }
  if t == "f32" { return repSigTokOfKind("f32") }
  // A registered UNION name — the `{tag, value}` BOX (`u`), EXCEPT a literal-union alias
  // (`type K = "a" | "b"`), whose runtime rep is the interned i32 ATOM. Same subtraction, in
  // the same order, that `vtKindOfType` makes ("checked first — it IS a `TyUnion`, so
  // `retUnionFlag` would claim it") and `fieldCodeOfSpelling` makes ("a literal union
  // registers as a union name, which would otherwise claim it as code 16"); it is the arm
  // this producer never got, while its RESULT twin `annRetKind` has carried it since #613.
  // Without it the two `$fnsig` param-token producers DISAGREED on the one axis: the AST side
  // (`cloParamTok` → `vtKindOfType`) keyed the atom `i` while this side keyed the box `u`, so a
  // `const f: (K) => i32 = pick` value call `ref.cast` resolved a `(structref, (ref $uBox))`
  // functype over a callee declared `(structref, i32)` — INVALID WASM, `vl check`-clean (the
  // soundness floor cannot see it: BOTH keys are non-empty and BOTH intern, so nothing is
  // un-interned to reject).
  //
  // GATED ON `isUName`, not on the bare `nameIsLitUnionType` the result twin uses, and the gate
  // is MEASURED: only a DECLARED alias registers a union name. An INLINE param spelling
  // (`function pick(v: "a" | "b")`) is softened to `string` by `canonEmitName` — the param
  // context is outside `litUnionPreserve`'s ELEM/FIELD/MAP_VAL/FN_RES set — so its param really
  // IS a string, and its value call resolves the honest `S` through `cloCallSigKey`'s arena
  // fallback. Keying the ungated predicate here claims that inline name too and turns two
  // WORKING programs into "function-value call arity has no interned signature".
  //
  // THE NUMERIC HALF OF THAT SUBTRACTION IS NOT MISSING HERE — IT IS UNREACHABLE, and the
  // difference is worth one sentence because the reachable-looking version was built and
  // measured. `nameIsLitUnionType` is STRING-only (`tyIsLitUnion` rejects any member whose
  // `litKind != "str"`), and a `type Z = 0 | 1` alias registers an `unNames` row exactly as a
  // string one does, so `isUName` would claim it for the BOX while the AST side keys the
  // softened scalar. That fork was real while canon left a function type's interior VERBATIM,
  // which was the only region handing this producer an un-softened alias. #1273 canons that
  // interior, so `(Z) => i32` arrives here as `(i32) => i32` and the alias never reaches these
  // arms at all: a `numLitUnionAliasName` projection added ahead of `isUName` is byte-identical
  // on all 1,602 corpus files across six channels and on a 120-cell numeric-litunion closure
  // grid. Do not add it back without a witness; the live numeric half of this defect lives in
  // `emit_rewrite.unionParamPinName`, which reads registered ROWS and the ARENA, neither of
  // which canon rewrites.
  if isUName(t) {
    if nameIsLitUnionType(t) { return repSigTokOfKind("i32") }
    return repSigTokOfKind("union")
  }
  if nameIsString(t) { return repSigTokOfKind("str") }
  // The five scalar-element list backings, via the ONE home (`scalarListKindOfName`) —
  // the SAME enumeration, in the same order, `annRetKind` reads for its `>`-prefixed
  // result token, so the two `$fnsig` producers cannot drift on what a scalar list is.
  const sk = scalarListKindOfName(t)
  if sk == 0 { return repSigTokOfKind("list") }
  if sk == 1 { return repSigTokOfKind("strlist") }
  if sk == 2 { return repSigTokOfKind("f64list") }
  if sk == 3 { return repSigTokOfKind("i64list") }
  if sk == 4 { return repSigTokOfKind("f32list") }
  const si = structIndexByName(t)
  if si >= 0 { return repSigSlotTokOfKind("struct", si) }
  // A concrete-variant name (`Cat`), keyed by the variant index (matches `cloParamTok`).
  const vti = variantIndexOf(t)
  if vti >= 0 { return repSigSlotTokOfKind("variant", vti) }
  // A ref-LIST param (`S[]`, `(C|D)[]`, a closure / nested list) — the recursive dual of
  // `annRetKind`'s ref-list result and `cloParamTok`'s ref-list param. BEFORE the arrow
  // case so a closure-ELEMENT array's nested `=>` is not misread as a single closure. The
  // slot resolves via the element name — the SAME `rlSlotByName(refArrElemName(...))` the
  // AST producer uses.
  if nameIsRefArray(t) {
    const rs = rlSlotOfArrName(t)
    if rs >= 0 { return repSigSlotTokOfKind("reflist", rs) }
  }
  // A FUNCTION-type param (`(i32) => i32`) is the shared closure fat-pointer, matching
  // `cloParamTok`. Without this a higher-order closure param (a callback that itself takes
  // a callback) left the value's `$fnsig` un-interned: the call fell back to the all-i32
  // arity sig and emitted INVALID WASM. The arrow finder is recursive (a top-level `=>` at
  // paren depth 0).
  if annArrowAt(t) >= 0 { return repSigTokOfKind("closure") }
  // A struct param the CHECKER rendered structurally (`{x: i32}`, not a nominal `P`) — the call-site
  // `nodeTyName` fallback in `cloCallSigKey` produces such a name. `structIndexOfTypeName` resolves
  // BOTH a nominal name (above, via `structIndexByName`) and an inline shape (by field-set match), to
  // the SAME struct index the AST producer's `cloParamTok` keys — so the two sig producers agree.
  const sti = structIndexOfTypeName(t)
  if sti >= 0 { return repSigSlotTokOfKind("struct", sti) }
  ""
}

function annRetKind(t: string) {
  if t == "i32" || t == "boolean" { return ">" + repSigTokOfKind("i32") }
  if t == "f64" { return ">" + repSigTokOfKind("f64") }
  // A LITERAL-UNION result (`type K = "a"|"b"`, or inline `"a"|"b"`), OR a NULLABLE literal-union
  // (`K | null`): both rep as the interned i32 ATOM (`vtKindOfType` → "i32", the `-1`-sentinel niche
  // for the nullable), so the result token is `>i` — the SAME token `cloRetKeySuffix` yields (its
  // `cloRetValKind` reads `vtKindOfType`). Checked BEFORE the union-split below, which would
  // otherwise mis-key a litunion's 2+ string atoms as a value-union box (`>u`). Without this the
  // annotation and construct sig producers disagreed on a litunion closure result.
  if nameIsLitUnionType(t) || nameIsNulLitUnion(t) {
    return ">" + repSigTokOfKind("i32")
  }
  // The NUMERIC half of that subtraction is UNREACHABLE here for the same reason it is in
  // `annParamKind` — see the note there. #1273 canons the interior of a function type, so a
  // `(i32) => Z` result arrives already softened and this producer never sees the alias.
  // Void is the ABSENCE of a result kind, not a member of the `VKind` vocabulary
  // (`repSigTokOfKind` deliberately has no arm for it) — stays a literal token.
  if t == "void" { return ">v" }
  if t == "string" { return ">" + repSigTokOfKind("str") }
  if t == "i64" { return ">" + repSigTokOfKind("i64") }
  if t == "f32" { return ">" + repSigTokOfKind("f32") }
  // A LIST return — `i32[]`, `string[]`, `f64[]` (matching `cloRetKeySuffix` for the
  // underlying function), so a `(i32) => i32[]` callback resolves the interned signature
  // and its value call lowers. `nameIsI32Array` (not a literal `"i32[]"`) so `boolean[]`,
  // `(boolean | null)[]` and a litunion `K[]` — all sharing the i32-list "a" backing that
  // `cloRetValKind` → `vtKindOfType` reports as "list" — key the SAME `>a` the concrete
  // lambda interns; the param dual (`annParamKind`) already keys these via `nameIsI32Array`.
  const sk = scalarListKindOfName(t)
  if sk == 0 { return ">" + repSigTokOfKind("list") }
  if sk == 1 { return ">" + repSigTokOfKind("strlist") }
  if sk == 2 { return ">" + repSigTokOfKind("f64list") }
  if sk == 3 { return ">" + repSigTokOfKind("i64list") }
  if sk == 4 { return ">" + repSigTokOfKind("f32list") }
  // A REF-LIST return — `S[]` / `((i32) => i32)[]` / a union list, matching
  // `cloRetKeySuffix`. BEFORE the closure case so a closure-ELEMENT array's nested `=>` is not
  // misread as a single-closure result. The slot resolves via the element name — the SAME
  // `rlSlotByName(refArrElemName(...))` the AST producer's `cloRetValSlot` uses, so the two
  // producers' keys byte-match (else the value-call `ref.cast` to this `$fnsig` traps).
  if nameIsRefArray(t) {
    const rs = rlSlotOfArrName(t)
    if rs >= 0 { return ">" + repSigSlotTokOfKind("reflist", rs) }
  }
  // A MAP return — `{[string]: V}`, matching `cloRetKeySuffix`'s map result token so the AST
  // and annotation sig producers agree (a value call's `ref.cast` to this `$fnsig` must
  // byte-match). The slot is the map SHAPE (mono ⇒ -1, else the value type's mv slot) — the
  // SAME `mapAnnShape`/`cloRetValSlot` the AST producer keys. BEFORE the closure case (a map
  // annotation carries no top-level arrow, but keep the ABI arms grouped).
  // A map-member UNION (`{[string]: f32} | {w: i32}`) also STARTS with `{[`, so `nameIsMap`
  // matches it — but it is a union BOX, not a bare map. Exclude it (`nameIsMapMemberUnion`) so
  // it falls through to the union arm below (`>u`), byte-matching the lambda's pinned map-union
  // `$fnsig` (`cloRetKeySuffix` reaches the box via `cloRetValKind` → "union"). Without this the
  // value call keyed `>m` while the closure interned `>u` — a "no interned signature" reject.
  if nameIsBareMap(t) {
    return ">" + repSigSlotTokOfKind("map", mvSlotOfMapName(t))
  }
  // A CLOSURE return — a function-type result (`(i32) => ((i32) => i32)`), matching
  // `cloRetKeySuffix`'s closure-result token so the AST and annotation sig producers agree
  // (a curried lambda's `$fnsig` must byte-match, else the value-call `ref.cast` traps). The
  // result often arrives PARENTHESIZED (`((i32) => i32)` — source groups the arrow result),
  // hiding its arrow one paren-depth down, so peel a single fully-wrapping `(...)` first.
  // The peel is `emit_base.normTypeAtom` — the same wrap grammar `unionArmSigKey` spelled
  // out one screen down, written here a THIRD time without the whitespace trim. The trim is
  // the only difference and it cannot matter to the only question asked of the result
  // (`annArrowAt(tc) >= 0`); measured rather than argued, at 63,655 live invocations (5,582
  // corpus + 58,073 fuzz) with 0 disagreements on the peeled STRING *and* 0 on the arrow
  // CONSEQUENCE, comparator firing 100% on both channels.
  const tc = normTypeAtom(t)
  if annArrowAt(tc) >= 0 { return ">" + repSigTokOfKind("closure") }
  // `structIndexOfTypeName` (not `structIndexByName`) so a struct return the CHECKER rendered as an
  // inline shape (`{x: i32}` — the `cloCallSigKey` `nodeTyName` fallback's form) resolves by field-set
  // to the same index the AST producer's `cloRetValSlot` keys, as well as a nominal `P`.
  const si = structIndexOfTypeName(t)
  if si >= 0 { return ">" + repSigSlotTokOfKind("struct", si) }
  // A UNION / NULLABLE return — `string | null`, `S | null`, a 2+-member union → the box
  // (matching `cloRetKeySuffix` for the underlying function). An `i32 | null` boxed niche
  // and any other shape stay "" (un-resolvable here). A union ALIAS (`type Sh = C | S`) is
  // resolved to its member set first (`unionMemberSetOf`), so a closure returning the alias
  // (`(i32) => Sh`) keys the union box — matching `cloRetKeySuffix`, which reaches the box
  // via `vtKindOfType` recognizing the alias. (A non-union name passes through unchanged.)
  const parts: string[] = []
  annSplitPipe(unionMemberSetOf(t), parts)
  if parts.length >= 2 {
    const nonNull: string[] = []
    let hasNull = false
    let pi = 0
    while pi < parts.length {
      const p = parts[pi]
      if p == "null" { hasNull = true }
      else if p.length > 0 { nonNull.push(p) }
      pi = pi + 1
    }
    if hasNull && nonNull.length == 1 {
      if nonNull[0] == "string" { return ">" + repSigTokOfKind("nulstr") }
      // A NULLABLE i32-backed LIST result (`boolean[] | null`, `i32[] | null`, a litunion
      // `K0[] | null` — kind 15): the i32-list wrapper made nullable, slot-free. Matches
      // `cloRetKeySuffix`'s `>o` (via `cloRetValKind` → `vtKindOfType` → "nullist"), so the
      // value call's `ref.cast` byte-matches the closure's interned `$fnsig`. The
      // distinct-backing nullable lists (`i64[] | null`, …) keep falling through to ""
      // (outside the ABI — a loud reject, never invalid wasm).
      if nameIsI32Array(nonNull[0]) { return ">" + repSigTokOfKind("nullist") }
      const msi = structIndexOfTypeName(nonNull[0])
      if msi >= 0 { return ">" + repSigSlotTokOfKind("nulstruct", msi) }
      // A NULLABLE-CLOSURE result (`((i32) => K0) | null`, kind 19): the shared closure
      // fat-pointer made nullable (`(ref null $cloStruct)`, slot-free). Matches
      // `cloRetKeySuffix`'s `>C` (via `cloRetValKind` → "nulclosure"), so the value call's
      // `ref.cast` byte-matches the closure's pinned `$fnsig` — without it the call keyed ""
      // and fell to the all-i32 arity sig (an invalid `(ref $cloStruct)`-where-i32 cast).
      if strContains(nonNull[0], "=>") {
        return ">" + repSigTokOfKind("nulclosure")
      }
      // A nullable numeric scalar (`i32 | null`, `i64 | null`, `f64 | null`, `f32 | null`) reps
      // its result as the value-union {tag,value} BOX (`repOfNullable`'s scalar arm → "union",
      // proven by a constructed `(i32) => i32 | null` interning `i>u`), so the token is `>u` —
      // matching `cloRetKeySuffix`. Lets a value call over a nullable-scalar-returning closure
      // resolve its interned sig; the boxed result recovers exactly as the annotated form's
      // does. (`boolean | null` is the i32-sentinel NICHE, not a box — excluded: its result
      // valtype is plain i32, so the all-i32 arity fallback already agrees.)
      if (
        nonNull[0] == "i32" ||
        nonNull[0] == "i64" ||
        nonNull[0] == "f64" ||
        nonNull[0] == "f32"
      ) {
        return ">" + repSigTokOfKind("union")
      }
      return ""
    }
    if nonNull.length >= 2 { return ">" + repSigTokOfKind("union") }
  }
  ""
}

// The `$fnsig` KEY of a SOURCE function-type annotation `(params)=>ret` — the SAME
// encoding `fnSigKeyOf` produces for a function (`"i>i"`, `"d>d"`, `"s3;>i"`), so a value
// call over an annotated callee resolves the interned signature. "" if any param/return
// type is outside the value-call ABI (the all-i32 arity fallback then applies).
function annSigKey(name: string) {
  // `annFnDecompose` (#1144) IS this whole preamble — the three gates, the param-list
  // slice, the `length > 0`-guarded `annSplitParams` and the return slice. The home's ""
  // sentinel covers all three of this copy's own `return ""` legs.
  const parts: string[] = []
  const retStr = annFnDecompose(name, parts)
  if retStr == "" { return "" }
  let key = ""
  let i = 0
  while i < parts.length {
    const pc = annParamKind(parts[i])
    if pc == "" { return "" }
    key = key + pc
    i = i + 1
  }
  const rc = annRetKind(retStr)
  if rc == "" { return "" }
  key + rc
}

// The `$fnsig` KEY of a FUNCTION-TYPE ARENA type `funcTyIx` (a `TyFunc`) — the destringify-D3
// dual of `annSigKey(nodeTyName(node))`. Instead of RENDERING the whole functype to a NAME and
// re-parsing its STRUCTURE (`annArrowAt` to find the separator, `annSplitParams` to cut the
// params, the paren-peel — the fragile whole-string spine scan the `$fnsig` twins historically
// came from), it walks the arena SPINE directly: the `fnParamTypes` array and `fnRet`. Each
// LEAF is classified by the SAME `annParamKind` / `annRetKind` the string path uses, on the
// leaf's own emit render — so the two producers cannot diverge on leaf classification, and the
// STRUCTURAL decisions (arity, which slot is the return) come from the arena, not a scan.
//
// Byte-identical to `annSigKey(tyToEmitName(funcTyIx))` by construction: `tyToEmitName`'s TyFunc
// arm builds the whole as `(` + join(param renders, `,`) + `)=>` + the return render, and
// `annSplitParams` (paren/brace/bracket-depth aware) recovers exactly those leaf renders. The
// return render mirrors that arm EXACTLY — a litunion ALIAS is preserved (`() => K0` keys the
// i32-atom `>i`, not the softened `string`'s `>S`) and a function-type result keeps its grouping
// parens (one result token). "" for a non-function type, or any leaf outside the value-call ABI
// (the same "" the string path yields → the all-i32 arity fallback / soundness floor).
export function sigKeyOfTy(funcTyIx: i32): string {
  if funcTyIx < 0 { return "" }
  const t = T.tys[funcTyIx]
  if !(t is TyFunc) { return "" }
  let key = ""
  let i = 0
  while i < t.fnParamTypes.length {
    // A litunion ALIAS parameter is PRESERVED, exactly as the RETURN leg below preserves it
    // (and for the same reason): `tyToEmitName` renders `K` as `string` — the print-widening
    // name — so a raw render keys the string token `S` while the two OTHER `$fnsig` producers
    // (`cloParamTok` → `vtKindOfType` → `nodeTyIsLitUnionAlias`, and `annSigKey` →
    // `annParamKind` → `isUName`) both key the i32 ATOM `i`. Three producers, one ABI: this
    // was the third one disagreeing. Witness: `function mk(): (K) => i32` + `const g = mk()` +
    // `g(k)` keyed `S>i`, so the `call_ref`'s `ref.cast` demanded a `(structref, stringref)`
    // functype over a callee declared `(structref, i32)` — INVALID WASM with `vl check` clean.
    //
    // ALIAS-ONLY, by arena-index identity (`unionAliasDeclNameOfTy`), NOT by
    // `litUnionAliasNameOfTy`: that one falls back to matching the member-literal SET, so in a
    // program that ALSO declares `type K = "a" | "b"` it names the INLINE spelling `"a" | "b"`
    // "K" too — and an inline litunion param really IS a string (`canonEmitName` softens it;
    // the param context is outside `litUnionPreserve`'s ELEM/FIELD/MAP_VAL/FN_RES set). Keying
    // the atom for it turns WORKING programs into invalid wasm; measured, both spellings, at
    // `tests/cases/literal-unions/fn-value-litunion-arg.vl`'s inline controls.
    let pnm = ""
    if tyIsLitUnion(t.fnParamTypes[i]) {
      pnm = unionAliasDeclNameOfTy(t.fnParamTypes[i])
    }
    if pnm == "" { pnm = tyToEmitName(t.fnParamTypes[i]) }
    if pnm == "" { return "" }
    const pc = annParamKind(pnm)
    if pc == "" { return "" }
    key = key + pc
    i = i + 1
  }
  // The RETURN render, mirroring `tyToEmitName`'s TyFunc arm (see the doc-comment): the
  // litunion-alias preservation is what keeps a `() => K0` closure keying `>i` on BOTH producers
  // (a raw `tyToEmitName(fnRet)` would soften the alias to `string` and key `>S`), and the
  // function-type paren-wrap keeps a curried result a single `>c`/nested token.
  let rs = ""
  const rtn = T.tys[t.fnRet]
  if rtn is TyNullable {
    const nal = litUnionAliasNameOfTy(rtn.nInner)
    if nal != "" { rs = nal + "|null" }
  }
  if rs == "" {
    const bal = litUnionAliasNameOfTy(t.fnRet)
    if bal != "" { rs = bal }
  }
  if rs == "" { rs = tyToEmitName(t.fnRet) }
  if rs == "" { return "" }
  const rt = T.tys[t.fnRet]
  if rt is TyFunc { rs = "(" + rs + ")" }
  const rc = annRetKind(rs)
  if rc == "" { return "" }
  key + rc
}

// The `$fnsig` KEY of a union MEMBER-SET arm (a `splitUnionAtoms` atom), or "" for a
// non-closure arm / a signature outside the value-call ABI. A closure arm arrives WRAPPED
// in the disambiguating parens the source requires (`(()=>i64)` — an unwrapped top-level
// arrow would bind the trailing `|` into its RETURN, so `splitUnionAtoms` never splits one
// out) and may carry `| `-split whitespace; neither is peeled by `annSigKey`. Normalize —
// trim, then strip ONE fully-wrapping paren pair — so the key byte-matches the one the
// narrowed CALL site derives (`narrowedClosureOf` → `annSigKey` on the bare `()=>i64`).
export function unionArmSigKey(arm: string) {
  // Trim surrounding ASCII whitespace, then peel a single fully-wrapping `(...)` (the arrow
  // lives one paren-depth down). That pair of steps IS `emit_base.normTypeAtom` — this
  // prelude was character-identical to the home's body, and the home's own header has said
  // so since #1150 ("`emit_classify.vl`'s `unionArmSigKey` prelude was a CHARACTER-IDENTICAL
  // copy of this"). A comment saying two things must not drift is not a mechanism that stops
  // them; deleting one of them is. Measured at every live invocation before deletion:
  // 54,524 (1,916 corpus + 52,608 fuzz), 0 disagreements on the peeled STRING, comparator
  // firing 100% on both channels. See `annRetKind` for the sibling copy.
  const t = normTypeAtom(arm)
  if annArrowAt(t) < 0 { return "" }
  annSigKey(t)
}

// The lifted-function position (`fnStmts` index) of the function VALUE bound to `let`/
// `const`/global `name` in scope of `fnIx` — `const f = dbl` traces to `dbl`, `const f =
// function(…)…` to the lifted lambda. -1 when `name` is not a binding holding a bare
// function value. Lets a closure call over an INFERRED binding resolve the callee's real
// signature (`fnSigKeyOf`), not the all-i32 arity sig.
export function identClosureFe(name: string, fnIx: i32) {
  identClosureFeSid(sidOf(name), fnIx)
}

// The sid-taking primitive. THE CANONICAL SHAPE (b) OF THIS ARC: the body asks TWO
// name-keyed tables about the same identifier — the function-scope one and the
// global one — so one intern replaces two hash-and-probes even when the caller has
// no arena index to offer. With one (`sidOfNode` at the call site) it replaces two
// with zero.
export function identClosureFeSid(sid: i32, fnIx: i32) {
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      const li = parentLetOfSid(fn.fnBody, sid)
      if li >= 0 {
        const d = P.nodes[li]
        if d is LetDecl { return fieldValueFeOf(d.letInit) }
      }
    }
  }
  const gi = globalLetOfSid(sid)
  if gi >= 0 {
    const gd = P.nodes[gi]
    if gd is LetDecl { return fieldValueFeOf(gd.letInit) }
  }
  -1
}

// The function-type ANNOTATION NAME (`(f64)=>f64`) of a `let`/`const`/global `name` in
// scope of `fnIx`, or "" when `name` is not a function-typed binding.
export function identFnTypeAnnName(name: string, fnIx: i32) {
  identFnTypeAnnNameSid(sidOf(name), fnIx)
}

// The sid-taking primitive — the second shape-(b) conversion: `parentLetOf` reached
// from here is 1.00% of a self-compile and `globalLetOf` another 0.59%, the largest
// pair of the four. One id serves both.
export function identFnTypeAnnNameSid(sid: i32, fnIx: i32) {
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      const li = parentLetOfSid(fn.fnBody, sid)
      if li >= 0 {
        const d = P.nodes[li]
        if d is LetDecl {
          if tyIsFuncType(d.letType) { return tyNameOf(d.letType) }
          // A NULLABLE-closure annotation (`(() => string | null) | null`, kind 19): return
          // its name — `cloNameSigKey` peels the `| null` + grouping parens to the bare
          // closure — so a narrowed call through a null-seeded binding (`const v: (fn) | null
          // = null; const t0 = v; if t0 != null { t0() }`) resolves its sig from the
          // annotation even when no closure VALUE exists to trace. Every other caller guards
          // on a top-level arrow (`annArrowAt`), which a nulclosure name never has.
          if nulCloFlag(d.letType) == 1 { return tyNameOf(d.letType) }
          // An UN-annotated closure local from a CALL result (`const g = f(4)` where `f`
          // returns a closure): recover the function type from the checker's recorded type of
          // the init, so its `$fnsig` resolves (the intermediate binding of a curried lambda).
          // Restricted to a Call init: for a bare LAMBDA init the authoritative sig is the
          // lifted function's own `cloSigKeyExt` (via `identClosureFe`), and the checker's
          // INFERRED return for that lambda can disagree (an assignment-tail lambda the checker
          // reads as i32-returning but the emitter lowers as void) — which would mis-cast.
          if d.letType < 0 && d.letInit >= 0 {
            const ini = P.nodes[d.letInit]
            if ini is Call {
              const itn = nodeTyName(d.letInit)
              // D-ARROWTY: the arena answers "is this a function type"; the render
              // is still the RETURN VALUE, so its `!= ""` gate stays.
              if itn != "" && nodeTyIsFuncTy(d.letInit) { return itn }
            }
            // A COPY of another closure binding (`const t0 = p` where `p: ((i32) => string) | null`
            // — the intermediate the nullable-read pattern `const t0 = p; if t0 != null { t0(1) }`
            // introduces). The init is a bare Ident, so its checked type is authoritative (unlike a
            // lambda, whose inferred return can disagree with the lowering). Return that type NAME —
            // a plain closure OR a nullable closure (`cloNameSigKey` peels the latter) — so the
            // narrowed call classifies its result instead of defaulting to i32 (invalid wasm).
            // A `??`-DEFAULTED closure binding (`const t0 = v["k"] ?? d` over a `{[string]: (i32) =>
            // i32 | null}` map): the coalesce has NO single lifted fe (a runtime pick between the
            // map value and the default), so `identClosureFe` can't see it — recover the function
            // type from the checker's join type of the `??` expression (both arms share it), so its
            // `$fnsig` resolves and the call's result classifies. Like the Call arm, and SAFE for the
            // same reason: NOT a bare lambda (whose lifted `cloSigKeyExt` is authoritative), so the
            // checker's inferred return cannot disagree with the emitter's lowering.
            if ini is BinExpr {
              if ini.binOp == "??" {
                const jtn = nodeTyName(d.letInit)
                // D-ARROWTY, as the Call arm above.
                if jtn != "" && nodeTyIsFuncTy(d.letInit) { return jtn }
              }
            }
            // An UN-annotated binding read from a CLOSURE-element ref list (`const f = xs[i]`
            // over `((i32) => R)[]` / `(((i32) => R) | null)[]`): the kind-5 slot's element
            // name IS the function type — return it (grouping parens peeled for a plain
            // element; a nullable element keeps its `| null`, which `cloNameSigKey` peels) so
            // a call through the binding resolves the ELEMENT's real `$fnsig`, exactly as the
            // direct indexed call (`xs[i](1)` → `cloArrSlotSigKey`) does.
            if ini is Index {
              if exprRefArray(ini.idxArr, fnIx) {
                const islot = refListSlotOfExpr(ini.idxArr, fnIx)
                if islot >= 0 && islot < rlElemKindTbl.length {
                  if rlElemKindTbl[islot] == 5 {
                    const enm = rlElemName[islot]
                    if nullablePartOf(enm) != "" { return enm }
                    return peelGroupParens(enm)
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  const gi = globalLetOfSid(sid)
  if gi >= 0 {
    const gd = P.nodes[gi]
    if gd is LetDecl {
      if tyIsFuncType(gd.letType) { return tyNameOf(gd.letType) }
      // The global dual of the local nulclosure-annotation arm above.
      if nulCloFlag(gd.letType) == 1 { return tyNameOf(gd.letType) }
    }
  }
  ""
}

// The `$fnsig` KEY for a function-VALUE callee Ident `name` (in scope of `fnIx`): a
// function-typed PARAM (its annotation / monomorphized pin), a function-typed LOCAL/GLOBAL
// annotation, or — for an INFERRED binding — the underlying function's own sig. "" → the
// all-i32 arity fallback applies (an unresolved or non-value-ABI signature, incl. void).
// The `$fnsig` key of a function-type NAME that may be a plain closure (`(i32) => string`, a
// top-level arrow) OR a NULLABLE closure (`((i32) => string) | null`, kind 19 — its arrow nested
// one paren-depth down, invisible to `annArrowAt`). For the nullable form, peel `| null` + the
// grouping parens to the bare closure first. "" when neither resolves — the call keeps its all-i32
// arity fallback. Recovers the result token so a narrowed nullable-closure CALL classifies its
// result correctly (print routing / numeric coercion) instead of the pre-fix i32 default.
function cloNameSigKey(nm: string) {
  if annArrowAt(nm) >= 0 { return annSigKey(nm) }
  if nameIsNulClosure(nm) {
    const clo = peelGroupParens(nullablePartOf(nm))
    if annArrowAt(clo) >= 0 { return annSigKey(clo) }
  }
  ""
}

// The SOURCE binding name of an inferred COPY `const name = <Ident>` in scope of `fnIx` (`const
// t0 = p` → `"p"`), or "" when `name` is not such a copy. Lets a closure-VALUE call resolve its
// sig through the intermediate binding the nullable/closure read pattern introduces (`const t0 =
// p; if t0 != null { t0(1) }`) — the checker records no type on a plain Ident init node, so the
// callee sig is recovered by chasing the copy to its source (a param / annotated binding).
function identCopySource(name: string, fnIx: i32) {
  identCopySourceSid(sidOf(name), fnIx)
}

function identCopySourceSid(sid: i32, fnIx: i32) {
  if fnIx < 0 { return "" }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const li = parentLetOfSid(fn.fnBody, sid)
    if li >= 0 {
      const d = P.nodes[li]
      if d is LetDecl {
        if d.letType < 0 && d.letInit >= 0 {
          const ini = P.nodes[d.letInit]
          if ini is Ident { return ini.identName }
        }
      }
    }
  }
  ""
}

function calleeCloSigKey(name: string, fnIx: i32) {
  calleeCloSigKeySid(sidOf(name), fnIx)
}

// The sid-taking primitive. THE DENSEST RESOLUTION CHAIN IN THE CLASSIFIER: the
// three `ident*` resolutions below each ask the function-scope table and the global
// table about the SAME identifier, so one id replaces five hash-and-probes — and the
// ~14 `calleeRetKind(callee.identName, …)` call sites hand it the CALLEE NODE's id
// straight from the carrier, so they pay none at all.
function calleeCloSigKeySid(sid: i32, fnIx: i32) {
  const name = sidText(sid)
  // A union binding narrowed to a bare-closure arm (`if x is () => i64 { x() }`): the arm's
  // function-type name interns the SAME `$fnsig` an annotated closure would — so the `call_ref`
  // casts to the right functype and the result classifiers (`calleeReturnsI64`/…) read its return.
  const nc = narrowedClosureOf(name)
  if nc != "" {
    const nk = annSigKey(nc)
    if nk != "" { return nk }
  }
  const pk = paramCloSigKey(fnIx, name)
  if pk != "" { return pk }
  // ONE intern for the three resolutions below (design R3's shape (b) at its densest:
  // `identFnTypeAnnName`, `identClosureFe` and `identCopySource` each resolve the SAME
  // identifier against the SAME two tables, so this line removes five hash-and-probes).
  const csid = sid
  const an = identFnTypeAnnNameSid(csid, fnIx)
  if an != "" {
    const ak = cloNameSigKey(an)
    if ak != "" { return ak }
  }
  const fe = identClosureFeSid(csid, fnIx)
  // The EXTENDED key (not just `fnSigKeyOf`) so a VOID-returning binding (`const f = hi`)
  // resolves its `>v` sig — interned above for void function values. A value-eligible
  // (i32/f64) binding takes the same key `fnSigKeyOf` would give.
  if fe >= 0 { return cloSigKeyExt(fe) }
  // An inferred COPY of another closure binding (`const t0 = p`): chase the source so a call
  // through the intermediate binding classifies its result (nullable-closure read pattern).
  const src = identCopySourceSid(csid, fnIx)
  if src != "" && src != name { return calleeCloSigKey(src, fnIx) }
  ""
}

// True if the function-VALUE callee `name` (in scope of `fnIx`) returns f64 — its resolved
// `$fnsig` key's result kind is `"f64"`. Drives the closure-call RESULT classification
// (print routing, numeric-context coercion), the value-call analogue of `fRetF64` for a
// named function.
function calleeReturnsF64Sid(sid: i32, fnIx: i32) {
  calleeRetKindSid(sid, fnIx) == "f64"
}

// True if the function-VALUE callee `name` (in scope of `fnIx`) returns void — its
// resolved `$fnsig` key carries the `>v` void marker (`sigKeyRetIsVoid`, NOT the `null`
// an unresolved key also decodes to). A void closure call leaves NOTHING on the stack, so
// its statement form must NOT `drop` (the value-call analogue of `fRetVoid` for a named
// function — which `fnIndexOf` can't see for a param / binding closure value).
export function calleeReturnsVoid(name: string, fnIx: i32) {
  sigKeyRetIsVoid(calleeCloSigKey(name, fnIx))
}

export function calleeReturnsVoidSid(sid: i32, fnIx: i32) {
  sigKeyRetIsVoid(calleeCloSigKeySid(sid, fnIx))
}

// True if the function-VALUE callee `name` (in scope of `fnIx`) returns a string — its
// resolved `$fnsig` key's result kind is `"str"`. The value-call analogue of
// `fnRetString` for a named function — drives the closure-call RESULT's string typing
// (binding cell, print routing).
function calleeReturnsStringSid(sid: i32, fnIx: i32) {
  calleeRetKindSid(sid, fnIx) == "str"
}

// True if the function-VALUE callee `name` (in scope of `fnIx`) returns i64 — its resolved
// `$fnsig` key's result kind is `"i64"`. The value-call analogue of `fRetI64` for a named
// function — drives the closure-call RESULT's i64 typing (print routing, numeric-context
// coercion).
function calleeReturnsI64Sid(sid: i32, fnIx: i32) {
  calleeRetKindSid(sid, fnIx) == "i64"
}

// The struct-table INDEX a function-VALUE callee `name` (in scope of `fnIx`) returns, or
// -1. Its resolved `$fnsig` key's result kind is `"struct"` (`>sN;`) or `"nulstruct"`
// (`>nN;`); the slot digits parse through the shared result-slot reader
// (`sigKeyRetSlot`). The value-call analogue of `fnRetStructIndex` — drives the closure-
// call RESULT's struct typing (`p.x` over `const p = f(5)`, struct or nullable-struct).
function calleeReturnsStructIdxSid(sid: i32, fnIx: i32) {
  const k = calleeCloSigKeySid(sid, fnIx)
  const rk = sigKeyRetKind(k)
  if rk == "struct" || rk == "nulstruct" { return sigKeyRetSlot(k) }
  -1
}

// The position of a `$fnsig` key's RESULT token char — just past the LAST `>` (params
// never contain one, so the last `>` begins the result spine) — or -1 for an empty /
// result-less key. The ONE last-`>` scan: every result-side reader (`sigKeyRetKind` /
// `sigKeyRetIsVoid` / `sigKeyRetSlot`) decodes through it instead of re-scanning the
// key string per site.
//
// NOT A TYPE-NAME GRAMMAR (D-CLASSGRAM census note) — the `$fnsig` ABI alphabet, exactly
// as at `sigParamCoerceKind`; `i` here is a bare walk CURSOR, which is the boundary #1186
// drew and #1222 kept. This IS the home of the last-`>` scan: the three result-side
// readers already route through it rather than re-scanning.
function sigKeyRetTokIx(k: string) {
  const n = k.length
  let gt = -1
  let i = 0
  while i < n {
    if k[i] == '>' { gt = i }
    i = i + 1
  }
  if gt < 0 || gt + 1 >= n { return -1 }
  gt + 1
}

// THE ONE HOME of the MONOMORPHIZED CLOSURE PIN's marker: the `$fnsig` key a
// closure-pinned parameter carries in its `TypeRef.tyName` slot behind a bare `"=>"`
// prefix (`"=>i>d"`), or "" when `nm` is not a pin.
//
// **THE `"=>"` HERE IS NOT THE FUNCTION-TYPE ARROW, AND THE TWO MUST NOT BE MERGED BY
// EYEBALL.** A source function-type annotation is `(i32) => string` — its arrow sits at a
// POSITIVE index behind a parenthesized parameter list, which is what `annArrowAt` /
// `nameIsFuncTypeAtom` / `strContains(nm, "=>")` ask about. This predicate asks whether the
// tyName column holds a type SPELLING at all: a pin's payload is an interned ABI key, not a
// renderable type, and the two-character marker is how `monoInstantiate` stamps that
// PROVENANCE onto the column. Reading it as "is a function type" would classify every
// annotated closure param as a pin and slice two characters off its annotation.
//
// The `length > 2` bound is the copies' own and is load-bearing on BOTH sides: it keeps
// the index-1 read in bounds and it guarantees a non-empty payload, so "" is unambiguously
// "not a pin". TWO more copies live in `emit_mono.vl` (`monoInstantiate`'s `fnValUsed`
// flip, and the un-annotated closure param's result-kind pin, which already decodes the
// payload through `sigKeyRetKind` above) — outside this partition, named here so the slice
// that owns that file has the list already made.
export function sigKeyPinPayload(nm: string) {
  if nm.length <= 2 { return "" }
  if nm[0] != '=' { return "" }
  if nm[1] != '>' { return "" }
  // BOUND rather than left as the trailing expression: a bare member-call statement is
  // not a lowerable form (`emitProgram: unsupported member-call statement`) — the same
  // reason `emit_base.arrElemNameRaw` and `annRetNameOf` bind their slices.
  const payload = nm.slice(2, nm.length)
  payload
}

// The `cloRetValKind`-style RESULT kind of a function-VALUE callee `name` (in scope of
// `fnIx`), decoded from the trailing `>X` token of its resolved `$fnsig` key — the `VKind`
// the token names, or `null` for a void result / when `name` resolves to no value-call
// sig (the two are indistinguishable here; no consumer needs to tell them apart). Drives
// the per-kind closure-call RESULT classifiers.
// The RESULT value-KIND encoded in a closure `$fnsig` key (the atom after the final `>`),
// or `null` when the key is empty / malformed. Shared by the Ident-callee path
// (`calleeRetKind`), the indexed-element path (`cloArrCallRetKind`), and — for a
// monomorphized closure-pinned param (`"=>i>d"`) — the instance-return pin (emit_mono).
export function sigKeyRetKind(k: string): VKind | null {
  const ti = sigKeyRetTokIx(k)
  if ti < 0 { return null }
  const c = k[ti]
  // Void is the ABSENCE of a result kind, not a member of the token
  // vocabulary — tested before the shared table.
  if c == 'v' { return null }
  // ONE vocabulary with the encode sites: the token decodes through the
  // canonical char→kind table (`repKindOfSigTok` — the inverse of the
  // `repSigTokOfKind` the encoders read). An encoder arm can no longer exist
  // without its decoder twin.
  repKindOfSigTok(c)
}

// True when a `$fnsig` key's result token is the literal void marker (`…>v`) —
// distinguishable from an EMPTY/unresolved key, which `sigKeyRetKind` folds into the
// same `null` a void result yields.
function sigKeyRetIsVoid(k: string) {
  const ti = sigKeyRetTokIx(k)
  ti >= 0 && k[ti] == 'v'
}

// True when a closure value CALL's DECLARED result is a value UNION but the resolved
// closure `$fnsig` reps its result as a NON-union — a single concrete member (a plain
// struct / scalar, not the shared `{tag, value}` box). This is the deferred VALUE-UNION-
// with-a-COMPOSITE-member closure-RESULT family (the typecheck.vl C2/C3 note): the union
// box READ does not yet compose through a closure result, so the lambda's body self-infers
// its single concrete arm (`(q0) => ({w:77})` reps a bare `{w:i32}`) while the checker types
// the call as the whole union `f32 | {w:i32}`. The narrow that consumes it (`t0 is f32`)
// then mis-reads the plain struct rep as the box — INVALID WASM (a dead-but-invalid narrowed
// arm printing a `(ref)` via `__print_f32__`). The value-call emitter REJECTS on this so the
// hole is a clean loud REJECT, never silent invalid wasm. A SUPPORTED value-union closure
// result (the lambda adopted the union, its `$fnsig` result keys `>u`) returns false — as
// does every non-union result. Mirrors the binding-position loud reject.
export function cloCallUnionResultUnrepresentable(
  callIx: i32,
  fnIx: i32,
): boolean {
  // CASE A (nullable-closure-union RESULT, `() => (() => i32 | boolean) | null`): the resolved
  // sig claims a value-union BOX result (`>u`) but NO value union is declared in the program —
  // the box only arose inside an UN-CONSTRUCTED nested closure-result type, so `uBoxIdx` is
  // never minted and `fbValtype("union")` would emit `(ref 0)` (the string/array type): invalid
  // wasm at the inner call's `struct.get` tag read. The box read through this closure-result
  // nesting is the deferred #875 family (a plain-binding nullable-closure-union already rejects
  // cleanly); reject here too so the closure-RESULT position never leaks invalid wasm.
  const ckeyA = cloCallSigKey(callIx, fnIx)
  if ckeyA != "" {
    const rkA = sigKeyRetKind(ckeyA)
    if rkA != null && rkA == "union" && !uDeclared { return true }
  }
  const ty = nodeTyIxOf(callIx)
  if ty < 0 { return false }
  // A NULLABLE NUMERIC-SCALAR result (`() => f64 | null` as a union ARM's closure) reps
  // as the SAME value-union box (`>u`, the nullable-scalar arm of `annRetKind`) — so it
  // takes the identical rep-consistency tail the union case below uses: no sig / a
  // non-box result token / an UN-INTERNED `>u` key means the box read has nothing to
  // recover. Without this the TyUnion-only gate let a producer-less
  // `(() => f64 | null) | string` arm's narrowed call emit a raw-scalar read against
  // the box functype — INVALID-WASM (fuzz-nightly run 29808029476, seed 100113225 d4).
  // `string | null` (the `>N` niche) and `boolean | null` (the i32 sentinel) are NOT
  // the box — they keep their own paths. (Probed on its OWN binding, so the union
  // narrow below keeps its clean `is` chain.)
  const tn = T.tys[ty]
  if tn is TyNullable {
    const nit = T.tys[tn.nInner]
    let nulBoxScalar = false
    if nit is TyPrim {
      const pn = nit.primName
      if pn == "i32" || pn == "f64" || pn == "i64" || pn == "f32" {
        nulBoxScalar = true
      }
    }
    if !nulBoxScalar {
      // A NULLABLE value-UNION result (`(() => string | null)[] | i32 | null` =
      // TyNullable(TyUnion)): the non-null spelling (`(…)[] | i32`) floors via the main union
      // analysis, but the outer `| null` wraps it in TyNullable, bypassing that branch. Route
      // the inner union through the SAME scalar+composite analysis so the nullable spelling
      // floors too rather than TRAP at the narrow's `ref.cast` (fuzz sweep wo7cNe declared
      // backlog, `() => (() => string | null)[] | i32 | null`).
      if nit is TyUnion { return cloCallUnionMixUnrep(tn.nInner, callIx, fnIx) }
      return false
    }
    const nkey = cloCallSigKey(callIx, fnIx)
    if nkey == "" { return true }
    const nrk = sigKeyRetKind(nkey)
    if nrk == null { return true }
    if nrk != "union" { return true }
    return cloSigPosOfKey(nkey) < 0
  }
  if !(T.tys[ty] is TyUnion) { return false }
  return cloCallUnionMixUnrep(ty, callIx, fnIx)
}

// The scalar+composite value-union analysis of `cloCallUnionResultUnrepresentable`, factored
// so BOTH a direct TyUnion result AND a NULLABLE-wrapped union result (`(…)[] | i32 | null` =
// TyNullable(TyUnion), whose `| null` bypasses the main TyUnion branch) run the identical
// representability test. `ty` is the UNION type index; `callIx`/`fnIx` drive the `$fnsig`
// producer checks (the same call node in both spellings).
function cloCallUnionMixUnrep(ty: i32, callIx: i32, fnIx: i32): boolean {
  const t = T.tys[ty]
  if !(t is TyUnion) { return false }
  if t.uMembers.length < 2 { return false }
  // A "boxing" value union: at least one SCALAR (`TyPrim` — i32/f64/f32/i64/boolean/string)
  // member AND at least one COMPOSITE (object/array/map/closure) member. Their reps differ,
  // so the union needs the shared `{tag, value}` box — the case a closure result does not yet
  // compose. A pure-scalar value union (`i64 | boolean`) OR a pure litunion (`TyLit` members)
  // is REP-uniform and already lowers (its sig keys `>u` / `>i`); a struct/variant union
  // (`Cat | Dog`, no scalar member) reps via the variant tag. Only the heterogeneous
  // scalar+composite mix is the deferred hole, so gate on it precisely.
  let hasScalar = false
  let hasComposite = false
  let i = 0
  while i < t.uMembers.length {
    const mt = T.tys[t.uMembers[i]]
    if mt is TyPrim {
      hasScalar = true
    } else if mt is TyLit {
      // A LITUNION member (`K0 | {w: i32} | {q: i64}` — a bare TyLit atom OR the alias's
      // NESTED all-lit TyUnion) reps as an i32 ATOM, so a litunion + composite mix is
      // exactly as rep-heterogeneous as the scalar mix: it needs the box. A PURE litunion
      // stays rep-uniform (`hasComposite` false → no reject, the `>i` path) — only the mix
      // reaches the rep-consistency tail. Without this a FIELD-position lambda whose
      // self-inferred `>s` sig disagreed with the union-typed call slipped the floor —
      // INVALID-WASM (fuzz seed 248841346 d5).
      hasScalar = true
    } else if tyIsLitUnion(t.uMembers[i]) {
      hasScalar = true
    } else if mt is TyObj {
      hasComposite = true
    } else if mt is TyArray {
      hasComposite = true
    } else if mt is TyMap {
      hasComposite = true
    } else if mt is TyFunc {
      hasComposite = true
    }
    i = i + 1
  }
  if !hasComposite { return false }
  // Rep-consistent only when the resolved closure `$fnsig` result IS the union box (`>u`).
  // No sig, an unparseable result, or a concrete-member result token (`>s…`, a scalar) means
  // the box read has nothing to recover — the deferred hole for a scalar+composite mix. A
  // COMPOSITE-ONLY union that resolves to a NON-box rep (a `Cat | Dog` VARIANT, `>V…;`, or no
  // sig) is the working variant path — only the scalar+composite mix is a definite hole there,
  // so those arms return `hasScalar` (reject the mix, pass the variant union through).
  const ckey = cloCallSigKey(callIx, fnIx)
  if ckey == "" { return hasScalar }
  const rk = sigKeyRetKind(ckey)
  if rk == null { return hasScalar }
  if rk != "union" { return hasScalar }
  // A `>u` KEY TEXT alone is not consistency — some PRODUCER must have interned this exact
  // key (the box-result functype exists). A ref-arm union result (`{…}[] | i32`) renders
  // `>u` from the annotation while the lambda self-infers its bare scalar arm and never
  // interns it: the call then fell back to the all-i32 arity sig and stored the raw i32
  // into the box-typed local — INVALID-WASM (fuzz frontier seed 615401451 d6 --branching,
  // any arity). Un-interned `>u` is the same deferred hole for the mix: reject loudly.
  if cloSigPosOfKey(ckey) < 0 { return hasScalar }
  // The `>u` box IS interned (e.g. by an outer NULLABLE-closure annotation, or an inline
  // composite-arm union), yet the concrete PRODUCER lambda self-inferred a NON-union arm
  // (`(q0) => ([…])` reps the bare string-LIST arm `>A`, or a ref-list `>r…;`), so the closure
  // VALUE carries that functype while the call casts to `>u` — an iso-recursive twin cast TRAP.
  // This catches BOTH the nullable value-union spelling that bypassed the un-interned-`>u`
  // check (the box minted on the annotation side: `((i32,i32,i32) => (() => i64)[] | i32) | null`)
  // AND the ref-arm+struct-arm composite-only union (`(i32) => (f32 | string)[] | {w: i32}`,
  // box vs `>A`). The deferred #938/#875 value-union-result composition; reject cleanly.
  const pk = callProducerCloSigKey(callIx, fnIx)
  if pk != "" && pk != ckey {
    const prk = sigKeyRetKind(pk)
    if prk != null && prk != "union" { return true }
  }
  // A param/arg-fed closure (no resolvable producer, `pk == ""`) whose value-union result
  // carries a MAP-ARRAY arm (`{[string]: f32}[] | f64`): the DIRECT binding of such a union
  // already rejects as "not yet representable" (its `>u` box is never interned, so the
  // `cloSigPosOfKey < 0` arm above catches it), but a NULLABLE-closure annotation
  // (`((i32,i32,i32) => {[string]:f32}[] | f64) | null`) interns the box on the annotation
  // side, slipping that check. Without a producer we cannot prove the closure VALUE carries
  // the box, and the map-array composite arm is the deferred value-union-result hole
  // (struct/closure/scalar-list/struct-list arms all rep fine) — reject cleanly rather than
  // TRAP at the narrow's `ref.cast` (fuzz sweep wo7cNe branching, seed 565560412).
  if pk == "" && tyUnionHasMapArrayArm(ty) { return true }
  // A param/arg-fed closure (no resolvable producer, `pk == ""`) whose value-union result
  // carries a CLOSURE-ARRAY arm (`(() => string | null)[] | i32`): the DIRECT binding of such
  // a union already rejects as "not yet representable" (its `>u` box is never interned), but an
  // outer `| null` on the union (`(() => string | null)[] | i32 | null`) interns the box on the
  // annotation side, slipping the `cloSigPosOfKey < 0` arm above. Without a producer we cannot
  // prove the closure VALUE carries the box, and the closure-array composite arm is the deferred
  // value-union-result hole (struct-list / scalar-list arms rep fine) — reject cleanly rather
  // than TRAP at the value call's `ref.cast` (fuzz sweep wo7cNe declared backlog, `() => (() =>
  // string | null)[] | i32 | null`). The closure-array sibling of the map-array arm above.
  if pk == "" && tyUnionHasClosureArrayArm(ty) { return true }
  // A param/arg-fed closure (no resolvable producer, `pk == ""`) whose value-union result
  // carries a NESTED (2-D+) LITUNION-array arm (`K0[][] | boolean`): the litunion 2-D array
  // folds to a distinct wrapper slot the value-union box does not yet compose through (the
  // DIRECT binding rejects as "not yet representable"), but the nullable-closure annotation
  // interns the box, slipping the `cloSigPosOfKey < 0` arm — and the producer lambda's bare
  // scalar arm makes the value call's closure `ref.cast` TRAP. Reject cleanly rather than
  // trap (fuzz sweep P8mid2 branching, seed 75568152). The litunion-2D-array sibling of the
  // map-array / closure-array arms above.
  if pk == "" && tyUnionHasLitUnionNestedArrayArm(ty) { return true }
  // An INDEXED closure-array-element callee (`f[0]()` / `p.f[0]()`) whose result union has a
  // VALUE-UNION-element-ARRAY arm (`(i64|boolean)[] | i32`): the element sig is the array-
  // element ANNOTATION's box (`>u`), while the array may hold a concrete lambda that self-
  // inferred the bare list arm (`>A`) — a param-fed array (`p.f`) has no producer to verify,
  // so the twin check above (which needs a resolvable `pk`) never fires. Only the value-union-
  // element-array arm is the deferred hole (the DIRECT binding of such a union rejects as "not
  // yet representable"); a struct / closure composite arm (`f64 | {w:i32}`, `(() => string) |
  // i64`) reps fine, so gate on the arm structure to keep those representable. Reject cleanly
  // rather than TRAP at the narrow's `ref.cast` (fuzz sweep 3aJP7v plain, closure-array field
  // of `(i64|boolean)[] | i32` results — the #1034 family one closure-array level deeper).
  if tyUnionHasValueUnionElemArrayArm(ty) {
    if calleeIsIndexedRefArrayCall(callIx, fnIx) {
      if pk == "" { return true }
      const prkI = sigKeyRetKind(pk)
      if prkI == null || prkI != "union" { return true }
    }
  }
  false
}

// True when the TyUnion at `ty` has a MEMBER that is an ARRAY whose element is itself a
// value union (`(i64 | boolean)[]` — a ref array of value-union boxes). This arm is the
// deferred hole in a closure-RESULT union: the box-of-value-union-element-array rep does
// not yet compose through a closure result. A struct / closure / plain-scalar-list arm is
// NOT flagged (those closure-result unions rep fine).
function tyUnionHasValueUnionElemArrayArm(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if !(t is TyUnion) { return false }
  let i = 0
  while i < t.uMembers.length {
    const m = T.tys[t.uMembers[i]]
    if m is TyArray {
      const el = T.tys[m.aElem]
      if el is TyUnion {
        // A VALUE union element (2+ members, at least one scalar) — not a variant union.
        if el.uMembers.length >= 2 {
          let hasPrim = false
          let j = 0
          while j < el.uMembers.length {
            if T.tys[el.uMembers[j]] is TyPrim { hasPrim = true }
            j = j + 1
          }
          if hasPrim { return true }
        }
      }
    }
    i = i + 1
  }
  false
}

// True when the TyUnion at `ty` has a MEMBER that is an ARRAY whose element is a MAP
// (`{[string]: f32}[]`). This arm is a deferred hole in a closure-RESULT value union:
// the box-of-map-array rep does not yet compose through a closure result (the DIRECT
// binding rejects as "not yet representable"). A struct-array (`{w:i32}[]`), plain
// scalar-list (`i32[]`), struct, or closure arm is NOT flagged — those rep fine.
function tyUnionHasMapArrayArm(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if !(t is TyUnion) { return false }
  let i = 0
  while i < t.uMembers.length {
    const m = T.tys[t.uMembers[i]]
    if m is TyArray {
      if T.tys[m.aElem] is TyMap { return true }
    }
    i = i + 1
  }
  false
}

// True when the TyUnion at `ty` has a MEMBER that is an ARRAY whose element is a CLOSURE
// (`(() => string | null)[]`, `((i32) => f64)[]` — a nullable-closure element peels its
// `| null` to the TyFunc). This arm is a deferred hole in a closure-RESULT value union: the
// box-of-closure-array rep does not yet compose through a closure result (the DIRECT binding
// rejects as "not yet representable"). A struct-array / scalar-list arm is NOT flagged — those
// rep fine.
function tyUnionHasClosureArrayArm(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if !(t is TyUnion) { return false }
  let i = 0
  while i < t.uMembers.length {
    const m = T.tys[t.uMembers[i]]
    if m is TyArray {
      let el = m.aElem
      const en = T.tys[el]
      if en is TyNullable { el = en.nInner }
      if el >= 0 {
        if T.tys[el] is TyFunc { return true }
      }
    }
    i = i + 1
  }
  false
}

// True when the TyUnion at `ty` has a MEMBER that is a NESTED (2-D+) array whose ultimate
// LEAF element is a LITUNION (`K0[][]`, `K0[][][]`). This arm is a deferred hole in a
// closure-RESULT value union: the litunion 2-D array folds to a distinct wrapper slot
// (`rlCanonElemName`'s i32-atom-leaf canon) that does not yet compose through a value-union
// box result — the DIRECT binding already rejects as "not yet representable", but a
// PARAM/arg-fed closure interns the box on the annotation side and slips the
// `cloSigPosOfKey < 0` arm, then the concrete producer lambda self-infers its bare scalar
// arm (`(q0,q1,q2) => (false)` → `boolean` functype) and the value call's closure
// `ref.cast` to the `>u`-result functype TRAPS (fuzz sweep P8mid2 branching, seed 75568152:
// `((i32,i32,i32) => K0[][] | boolean) | null`). A 1-D litunion array (`K0[]`) and a
// SCALAR-leaf nested array (`i32[][]`, `string[][]`, `f64[][]`) rep fine — only the
// litunion 2-D+ leaf is the hole, so gate precisely on it.
function tyUnionHasLitUnionNestedArrayArm(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if !(t is TyUnion) { return false }
  let i = 0
  while i < t.uMembers.length {
    const m = T.tys[t.uMembers[i]]
    if m is TyArray {
      const el = T.tys[m.aElem]
      // A NESTED array: the outer array's element is itself an array. Walk to the leaf.
      if m.aElem >= 0 && el is TyArray {
        let leaf = m.aElem
        while leaf >= 0 {
          const lt = T.tys[leaf]
          if lt is TyArray { leaf = lt.aElem } else { break }
        }
        if leaf >= 0 && tyIsLitUnion(leaf) { return true }
      }
    }
    i = i + 1
  }
  false
}

// The concrete PRODUCER lambda's `$fnsig` key for a value-CALL whose callee is a plain
// Ident binding — the functype the closure VALUE actually carries. "" for a non-Ident
// callee or an unresolvable producer.
function callProducerCloSigKey(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const cre = P.nodes[c.callFn]
    if cre is Ident { return producerCloSigKey(cre.identName, fnIx) }
  }
  ""
}

// True when a call's CALLEE is an INDEX into a ref (closure) array (`f[0]()`, `p.f[0]()`):
// the element sig comes from the array-element ANNOTATION (`cloArrSlotSigKey`), not a
// resolvable producer lambda. Used by the union-result floor to reject the deferred
// scalar+composite closure-result union in this spelling (the array element may hold a
// lambda that self-inferred a non-box arm; a param-fed array has no producer to verify).
function calleeIsIndexedRefArrayCall(callIx: i32, fnIx: i32): boolean {
  const c = P.nodes[callIx]
  if c is Call {
    const cre = P.nodes[c.callFn]
    if cre is Index { return exprRefArray(cre.idxArr, fnIx) }
  }
  false
}

// The interned SLOT of a slot-carrying result token (`>s3;`, `>n1;`, `>V0;`, `>r2;`,
// `>m0;`) — the `;`-terminated decimal after the token char — or -1 when the key's
// result kind carries no slot (`repSigTokHasSlot`, the encode side's own predicate) or
// the digits are malformed. The ONE result-slot digit parser; callers gate on
// `sigKeyRetKind` for WHICH table the slot indexes (struct / variant / ref-list / map).
function sigKeyRetSlot(k: string) {
  const ti = sigKeyRetTokIx(k)
  if ti < 0 { return -1 }
  if !repSigTokHasSlot(repKindOfSigTok(k[ti])) { return -1 }
  let j = ti + 1
  let acc = 0
  let saw = false
  while j < k.length && k[j] != ';' {
    const d = k[j]
    if d < '0' || d > '9' { return -1 }
    acc = acc * 10 + (d - '0')
    saw = true
    j = j + 1
  }
  if !saw { return -1 }
  acc
}

function calleeRetKindSid(sid: i32, fnIx: i32): VKind | null {
  return sigKeyRetKind(calleeCloSigKeySid(sid, fnIx))
}

// The RESULT value-KIND of a call whose CALLEE is an INDEX into a closure array
// (`fs[i](x)`): the closure-element signature's return atom (`cloArrSlotSigKey` →
// `sigKeyRetKind`). `null` when the call's callee is not an indexed closure value. The
// expr classifiers (`exprString`/`exprIsF64`/… Call arms) consult this so an indexed
// closure call's result routes to the right print / arithmetic / store path — the dual of
// the call-SIGNATURE resolution `emitCallRef` does for the same shape.
function cloArrCallRetKind(callIx: i32, fnIx: i32): VKind | null {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Index {
      if exprRefArray(callee.idxArr, fnIx) {
        return sigKeyRetKind(
          cloArrSlotSigKey(refListSlotOfExpr(callee.idxArr, fnIx)),
        )
      }
    }
  }
  null
}

function paramCloSigKey(fnIx: i32, name: string) {
  if fnIx < 0 { return "" }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const params = fn.fnParams
    let i = 0
    while i < params.length {
      const p = P.nodes[params[i]]
      if p is Param {
        if p.parName == name {
          if p.parType >= 0 {
            // A MONOMORPHIZED closure-pinned param announces itself in the PIN COLUMN,
            // which also carries the `$fnsig` key as its payload (census W11) — so this
            // reads the fact where it lives instead of prefix-testing the node's NAME.
            // An unpinned param records nothing, so "" here is unambiguously "not a pin"
            // and the annotation arms below get their turn.
            const pin = nodePinPayloadOf(p.parType)
            if pin != "" { return pin }
            const ty = P.nodes[p.parType]
            if ty is TypeRef {
              const nm = ty.tyName
              if nm.length > 2 {
                // The `strContains` arm keeps the `length > 2` bound because it asks a
                // DIFFERENT question of the same two characters (an arrow ANYWHERE, i.e. a
                // real function-type spelling, not the pin's provenance marker).
                // A NULLABLE-closure param (`((i32) => string) | null`, kind 19) OR a SOURCE
                // function-type annotation `(params)=>ret`: derive its sig key so a non-i32 (e.g.
                // f64) signature casts to the right functype, and — for a nullable closure whose
                // arrow is nested one paren-depth down — the RESULT classifiers (`calleeReturns*`,
                // print routing) recover the closure's result token instead of defaulting to i32
                // (the pre-fix invalid-wasm: a narrowed `p(1)` string result printed as i32).
                if strContains(nm, "=>") { return cloNameSigKey(nm) }
              }
            }
          }
          return ""
        }
      }
      i = i + 1
    }
  }
  ""
}

// True if the function at `fnStmts` position `t` returns a function value — its body's
// tail expression is itself a function value (a bare function name, a `function(...)`
// literal, or a closure-typed local). Drives `exprIsClosure` for call results
// (`const f = makeAdder(5)` where `makeAdder` returns its inner closure).
export function fnReturnsClosure(t: i32) {
  if t < 0 || t >= fnStmts.length { return false }
  const fn = P.nodes[fnStmts[t]]
  if fn is FuncDecl {
    // An ANNOTATED function-type return (`: (i32) => i32`) is a closure result regardless of
    // how the body yields it — e.g. `return f(x)`, a higher-order call the tail scan can't see
    // (`exprIsClosureNoLocal` has no Call case). The annotated result valtype is already kind 14.
    if fn.fnRet >= 0 && tyIsFuncType(fn.fnRet) { return true }
    return blockTailIsClosure(fn.fnBody, fnStmts[t])
  }
  false
}

// True if the block's tail (implicit-return) expression is a function value.
function blockTailIsClosure(blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    const n = stmts.length
    if n == 0 { return false }
    const last = stmts[n - 1]
    const s = P.nodes[last]
    if s is RetStmt {
      if s.retArg >= 0 { return exprIsClosureNoLocal(s.retArg, fnIx) }
      return false
    }
    return exprIsClosureNoLocal(last, fnIx)
  }
  false
}

// `exprIsClosure` restricted to forms safe to query during return-kind classification
// (avoids recursion through `declaredSlotOf`, which needs the local registry built):
// a function name, a `function(...)` literal, or an object field. Captures the common
// `return add` / `{ go: add }` escaping-closure tails.
function exprIsClosureNoLocal(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Paren { return exprIsClosureNoLocal(e.parInner, fnIx) }
  if e is FuncDecl { return true }
  if e is Ident { return fnIndexOfSid(sidOfNode(exprIx)) >= 0 }
  if e is ObjLit { return false }
  false
}

// True if member access `obj.prop` yields a function value — `prop` is a struct field
// whose declared type is a function type. (For `objects/equality-function-field.vl` and
// `escaping.vl`'s `o.go`.) Resolved against the receiver's struct table fields.
function memberIsClosure(objIx: i32, prop: string, fnIx: i32) {
  const si = structIndexOfExpr(objIx, fnIx)
  if si >= 0 { return structFieldIsClosure(si, prop) }
  // A NARROWED union receiver (`t0.f(1)` after `if t0 is {f: (i32) => boolean[]}` over a
  // `{f: …} | f64` binding): the receiver's struct index is not resolvable from its
  // DECLARED (union) type, but the narrowed VARIANT's field tables carry the field code —
  // a closure field (14) / nullable-closure field (22) reads back a closure and calls via
  // `call_ref` (the member READ itself lowers through `emitNarrowedMem`).
  const o = P.nodes[unwrapParen(objIx)]
  if o is Ident {
    const nv = narrowVariantFor(o.identName)
    if nv != "" {
      const vi = variantIndexOf(nv)
      if vi >= 0 {
        const vfi = variantFieldIndex(vi, prop)
        if vfi >= 0 {
          const vfc = variantFieldTypeAt(vi, vfi)
          return vfc == 14 || vfc == 22
        }
      }
    }
  }
  false
}

// True if field `prop` of struct table index `si` is a function-valued field — a bare
// closure (code 14) or a NULLABLE closure (code 22). Both read back as a closure and call
// via `call_ref`; the nullable one is recovered to non-null at the call site.
function structFieldIsClosure(si: i32, prop: string) {
  if si < 0 || si >= sNames.length { return false }
  const cnt = sFieldCount[si]
  const start = sFieldStart[si]
  let fj = 0
  while fj < cnt {
    if sFieldNames[start + fj] == prop {
      const fc = sFieldTypeAt(si, fj)
      return fc == 14 || fc == 22
    }
    fj = fj + 1
  }
  false
}

// `xs.pop()` / `xs.get(i)` over a STRUCT-element ref list — the host types both as
// `S | null`. Returns the element STRUCT TABLE INDEX, or -1 when the call is not such
// a read. Restricted to plain-struct elements (`rlElemKindTbl == 1`): map-array
// (`{[string]:i32}[]`, kind 3) and union-element (kind 2) pops keep their existing
// classification (g_maparray's golden bytes depend on it).
export function structListPopGetElem(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[exprIx]
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Member {
      if callee.memProp == "pop" || callee.memProp == "get" {
        if exprRefArray(callee.memObj, fnIx) {
          const slot = refListSlotOfExpr(callee.memObj, fnIx)
          if slot >= 0 && slot < rlElemKindTbl.length {
            if rlElemKindTbl[slot] == 1 { return rlElemStructRow(slot) }
          }
        }
      }
    }
  }
  -1
}

// ── `.map` / `.filter` classification (Slices 3–4) ─────────────────────────────

// True if the expression at `exprIx` is a `.map`/`.filter` HOF call over a LIST
// receiver (one callback argument). A member call named `map`/`filter` over a
// NON-list receiver (e.g. a function-valued struct field) is NOT a HOF site.
function callIsMapFilter(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Member {
      if callee.memProp == "map" || callee.memProp == "filter" {
        if e.callArgs.length == 1 {
          return mfRecvKindOf(callee.memObj, fnIx) != null
        }
      }
    }
  }
  false
}

// True if the expression at `exprIx` is an array `.slice(start, end?)` over a LIST
// receiver — a sublist of the SAME element type. (A string `.slice` is a separate
// `exprIsStrSlice` path; this is the array dual.)
export function callIsArrSlice(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Member {
      if callee.memProp == "slice" {
        if e.callArgs.length == 1 || e.callArgs.length == 2 {
          return mfRecvKindOf(callee.memObj, fnIx) != null
        }
      }
    }
  }
  false
}

// The RECEIVER list kind of a `.map`/`.filter` call: `0` (i32/boolean list), `1`
// (f64 list), `2` (struct/union ref list), or -1 (not a supported list — a string
// list or a non-list receiver).
export function mfRecvKindOf(recvIx: i32, fnIx: i32): MfKind | null {
  if exprF64Array(recvIx, fnIx) { return "f64" }
  if exprI64Array(recvIx, fnIx) { return "i64" }
  if exprF32Array(recvIx, fnIx) { return "f32" }
  if exprRefArray(recvIx, fnIx) { return "ref" }
  if exprStringArray(recvIx, fnIx) { return "str" }
  if exprArray(recvIx, fnIx) { return "i32" }
  null
}

// The RESULT element kind of the `.map`/`.filter` call at `callIx`: `0` (i32/boolean
// element — an i32 list result), `1` (f64 element — an f64 list result), or -1
// (unsupported). `filter` keeps the receiver's element kind (a ref-list filter is
// out of scope — it fails loudly at emit); `map`'s result element kind IS the
// callback's RETURN kind (`cloRetKindOf`).
export function mfResultKindOf(callIx: i32, fnIx: i32): MfKind | null {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      // `.slice` preserves the element type — its result kind IS the receiver's.
      if callee.memProp == "slice" { return mfRecvKindOf(callee.memObj, fnIx) }
      if callee.memProp == "filter" { return mfRecvKindOf(callee.memObj, fnIx) }
      if c.callArgs.length == 1 {
        const fe = mfCallbackFe(c.callArgs[0], fnIx)
        if fe < 0 {
          // A CLOSURE-VALUE callback (`xs.map(f)`, `f` a function-typed param/binding) — its result
          // kind comes from the closure's sig RETURN token, not a lifted fe (scalar returns only).
          const ck = mfCallbackCloKey(c.callArgs[0], fnIx)
          if ck != "" { return mfResKindFromSigRet(sigKeyRetKind(ck)) }
          return null
        }
        // A string-returning callback maps to a string-list result (kind 3) — checked first
        // since `cloRetKindOf` folds string into -1.
        if cloRetIsString(fe) { return "str" }
        // A STRUCT-returning callback maps to a NEW ref list of the result struct (kind 2) —
        // `cloRetKindOf` folds a struct into -1, so consult `cloRetValKind` (which classifies
        // the struct result as kind 1) directly. The result element type DIFFERS from the
        // source (`P[].map((p) => Q-shape)` ⇒ `Q[]`), so the dst slot is the RESULT struct's
        // ref-list slot, not the source's (`mfResultSlotOf`).
        if cloRetValKind(fe) == "struct" { return "ref" }
        // A concrete-VARIANT-returning callback (a collapse) maps to a ref list of bare
        // variant structs (kind 2, element a variant) — checked before the union case since
        // `cloRetValKind` already prefers the variant.
        if cloRetValKind(fe) == "variant" { return "ref" }
        // A UNION-returning callback maps to a ref list of union BOXES (kind 2, element kind
        // 2). All unions share `$uBox`, so the result element is the declared union; its box
        // body is produced by the callback's own union-boxing return path.
        if cloRetValKind(fe) == "union" { return "ref" }
        // A NULLABLE-STRING-returning callback maps to a `(string | null)[]` result — the SAME
        // string list (one wrapper, one backing, whose element type is already
        // `(ref null $aTypeIdx)` so spare slots can default to null), with the nullable element
        // DISCIPLINE on reads. `cloRetKindOf` folds the un-annotated niche into the i32 result
        // token, so this consults `cloRetValKind` — the answer the callback's own functype BYTES
        // are streamed from — exactly as the struct/union/i64/f32 cases above do.
        if cloRetValKind(fe) == "nulstr" { return "str" }
        // An i64- / f32-returning callback maps to an i64- / f32-list result (mf-kinds 4 / 13).
        // `cloRetKindOf` folds these to -1 (out of the value-CALL ABI), so consult
        // `cloRetValKind` (10 = i64, 13 = f32) directly, as the struct/union cases above do.
        if cloRetValKind(fe) == "i64" { return "i64" }
        if cloRetValKind(fe) == "f32" { return "f32" }
        // RESULT-KIND INTERLOCK — the `.map` dual of `fnSigKeyOf`'s KEY/BYTES interlock.
        // `cloRetKindOf` is the VALUE-CALL ABI's coarse answer: it folds the un-annotated
        // `string | null` niche into `"i32"` (its flag ladder never consulted `fRetNulStr`),
        // so a bare `if n > 0 { return "yes" } return null` callback claimed an i32-LIST
        // result while the `$fnsig` the loop `call_ref`s returns `(ref null $string)` —
        // `array.set` on the i32 backing then took a ref: invalid wasm, from `vl check`-clean
        // ordinary code (`xs.map(maybe)`). The honest kind is `cloRetValKind` — the same
        // answer the callback's own functype BYTES are streamed from — so the i32/f64 result
        // is claimed only when the two AGREE; a disagreement falls through to `null` and
        // `emitMapFilter` rejects loudly ("unsupported .map/.filter element type"), which is
        // ALREADY what the ANNOTATED spelling of the same callback (`: string | null`) does.
        // The fix makes the two spellings agree instead of one of them miscompiling.
        //
        // HONEST BOUND: `"nulstr"` is the only reachable disagreement. `cloRetKindOf` and
        // `cloRetValKind` read the SAME stored inferred kind (`fRetKind` via
        // `inferredRetKindCore`) and the SAME `tailIsF64NoLocal` backup; every other kind
        // that differs is already peeled off above (str / struct / variant / union / i64 /
        // f32) or folds to `null` in BOTH. Measured: over a 188-program census (`.map`/
        // `.filter` x callback-form x return-kind x receiver-kind) exactly the nine
        // named-callback nulstr cells change outcome, INVALID-WASM -> a loud reject, and
        // nothing else moves; over the 1,443-file corpus nothing moves at all. The witness
        // is `tests/cases/arrays/error-map-named-nulstr-callback.vl`.
        const rk2 = cloRetKindOf(fe)
        const vk2 = cloRetValKind(fe)
        if rk2 == "i32" && vk2 == "i32" { return "i32" }
        if rk2 == "f64" && vk2 == "f64" { return "f64" }
      }
      return null
    }
  }
  null
}

// The ref-list TABLE SLOT of a kind-2 `.map`/`.filter` result, or -1. `.filter` preserves the
// receiver's element list, so the result slot IS the source ref-list slot.
export function mfResultSlotOf(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      // `.slice` preserves the ref-list element — its result slot IS the receiver's.
      if callee.memProp == "slice" {
        if mfRecvKindOf(callee.memObj, fnIx) == "ref" {
          return refListSlotOfExpr(callee.memObj, fnIx)
        }
      }
      if callee.memProp == "filter" {
        if mfRecvKindOf(callee.memObj, fnIx) == "ref" {
          return refListSlotOfExpr(callee.memObj, fnIx)
        }
      }
      // A STRUCT-returning `.map`: the result is a NEW ref list whose element is the
      // callback's RETURN struct — its ref-list slot (interned by `mfScan`).
      if callee.memProp == "map" && c.callArgs.length == 1 {
        const fe = mfCallbackFe(c.callArgs[0], fnIx)
        if fe >= 0 && cloRetValKind(fe) == "struct" {
          const si = cloRetValSlot(fe)
          if si >= 0 && si < sNames.length { return rlSlotByName(sNames[si]) }
        }
        // A struct-returning CLOSURE-VALUE callback (`xs.map(f)`, `f: (i32) => P`): no lifted fe, so the
        // result struct index comes from the closure's `>s<idx>;` sig-return token. Its ref-list slot
        // (`P[]`) is the `.map` result — the closure-value dual of the lifted-fe branch above.
        if fe < 0 {
          const ck = mfCallbackCloKey(c.callArgs[0], fnIx)
          if ck != "" && sigKeyRetKind(ck) == "struct" {
            const csi = sigKeyRetSlot(ck)
            if csi >= 0 && csi < sNames.length {
              return rlSlotByName(sNames[csi])
            }
          }
        }
        // A concrete-VARIANT `.map`: the result element is the variant — its ref-list slot
        // is keyed by the variant NAME (`uVariants[vi]`).
        if fe >= 0 && cloRetValKind(fe) == "variant" {
          const vi = cloRetValSlot(fe)
          if vi >= 0 && vi < uVariants.length {
            return rlSlotByName(uVariants[vi])
          }
        }
        // A UNION-returning `.map`: the result is a ref list of the declared union (all
        // unions share `$uBox`, so the element key is the union alias name).
        if fe >= 0 && cloRetValKind(fe) == "union" && unNames.length > 0 {
          return rlSlotByName(unNames[0])
        }
      }
    }
  }
  -1
}

// Resolve a `.map`/`.filter` CALLBACK argument to its lifted-function position in
// `fnStmts`: an inline `function(...)` literal (lifted by `collectFns`), a named
// function reference, or a let-bound function value whose binding initializer is one
// of those (a local `let` in the enclosing function, else a module global). -1 when
// the callback's target function cannot be statically resolved.
//
// The named-reference rung resolves through `fnIndexOfInScope` — the language's own
// innermost-declaring-scope rule — not the flat first-occurrence-wins `fnIndexOf`.
// With the flat map, `xs.map(inner)` in EVERY frame reached the module's FIRST `inner`,
// so a second maker declaring its own same-named callback silently mapped with the
// first maker's function: rc=0 and a wrong list. That was the one shape #1204's
// 28-shape census left wrong (`.map(inner)` printing `4 / 4` for `4 / 103`), and the
// chain walk extends the repair to the callback taken from a sibling frame, from a
// lambda, from a deeper frame that shadows an outer callback, and to `.filter`.
export function mfCallbackFe(cbIx: i32, fnIx: i32) {
  if cbIx < 0 { return -1 }
  const inner = unwrapParen(cbIx)
  const e = P.nodes[inner]
  if e is FuncDecl { return fnStmtsPosOf(inner) }
  if e is Ident {
    const t = fnIndexOfInScope(e.identName, fnIx)
    if t >= 0 { return t }
    let li = -1
    // The frame whose scope the BINDING's initializer is elaborated in. A local `let`
    // keeps the current frame; a MODULE GLOBAL's initializer is elaborated at top
    // level, where no frame's nested declarations are in scope — resolving it against
    // the calling frame would let a nested same-named function hijack a global binding
    // that can only ever denote the top-level one.
    let initFn = fnIx
    if fnIx >= 0 {
      const fn = P.nodes[fnIx]
      if fn is FuncDecl { li = parentLetOf(fn.fnBody, e.identName) }
    }
    if li < 0 {
      li = globalLetOf(e.identName)
      if li >= 0 { initFn = -1 }
    }
    if li >= 0 {
      const d = P.nodes[li]
      if d is LetDecl {
        if d.letInit >= 0 {
          // Guard the degenerate self-referential binding against infinite recursion.
          if unwrapParen(d.letInit) != inner {
            return mfCallbackFe(d.letInit, initFn)
          }
        }
      }
    }
  }
  -1
}

// True if the lifted callback at `fe` returns a BOOLEAN (its annotation, or the
// inferred `fRetBool`) — the element-bool-ness of a `.map` result, threaded to the
// print import choice (`__print_bool__` renders true/false).
function mfCbRetIsBool(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return false }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    if fn.fnRet >= 0 {
      const rt = P.nodes[fn.fnRet]
      if rt is TypeRef { return rt.tyName == "boolean" }
      return false
    }
    if fe < fRetBool.length { return fRetBool[fe] == 1 }
  }
  false
}

// True if an INDEX READ over the list at `arrIx` yields a boolean element. Today the
// only boolean-element list producer is a `.map` whose callback returns boolean
// (`xs.map(function(n: i32) n > 2)`); a `.filter` keeps its receiver's element
// bool-ness, and a module-global binding traces through its initializer.
function mfArrElemIsBool(arrIx: i32, fnIx: i32) {
  if arrIx < 0 { return false }
  const inner = unwrapParen(arrIx)
  const e = P.nodes[inner]
  if e is Call {
    if callIsMapFilter(inner, fnIx) {
      const callee = P.nodes[e.callFn]
      if callee is Member {
        if callee.memProp == "filter" {
          return mfArrElemIsBool(callee.memObj, fnIx)
        }
        return mfCbRetIsBool(mfCallbackFe(e.callArgs[0], fnIx))
      }
    }
    return false
  }
  if e is Ident {
    const li = globalLetOf(e.identName)
    if li >= 0 {
      const d = P.nodes[li]
      if d is LetDecl {
        if d.letInit >= 0 {
          if unwrapParen(d.letInit) != inner {
            return mfArrElemIsBool(d.letInit, -1)
          }
        }
      }
    }
  }
  false
}

// Detect `.map`/`.filter` HOF sites up front (one arena scan, mirroring the print
// scan): ANY site makes the program function-value-using (`fnValUsed` — the callback
// is a closure value even when it is a bare named-function reference), and a `.map`
// whose callback returns i32/boolean (f64) forces the i32 (f64) list types for the
// RESULT list — the receiver may be a ref/f64 list that never otherwise touches
// them. `.filter` reuses the receiver's own (already-collected) types. Runs after
// `computeRetInference` (an un-annotated callback's return kind is inferred);
// programs without `.map`/`.filter` set nothing — every golden stays byte-identical.
// True if the expression at `ix` is a bare Ident naming a top-level function —
// a function VALUE use when it sits in a value position (an initializer, an
// assignment's right side, an equality operand).
export function exprIsBareFnName(ix: i32) {
  if ix < 0 { return false }
  const e = P.nodes[ix]
  if e is Ident { return fnIndexOfSid(sidOfNode(ix)) >= 0 }
  false
}

// The concrete annotation NAME for the argument expression at `ix` inside
// function `fnIx` (-1 = top level) — the same classification ladder the return-
// kind inference runs (`exprString`/`exprArray`/…), rendered back to the
// annotation name an instance's pinned `TypeRef` carries. "" = a kind this pass
// cannot name (the caller fails loudly).
// The RESULT type NAME of lifted function `fe` (`i32`, `string`, `i32[]`, a struct
// name, …) — its declared return annotation, or the inferred kind mapped back to a
// name. Used to build a closure argument's function-type name for generic binding.
export function cloRetTypeName(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return "" }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    if fn.fnRet >= 0 { return tyNameOf(fn.fnRet) }
  }
  const k = cloRetValKind(fe)
  if k == "i32" { return "i32" }
  if k == "f64" { return "f64" }
  if k == "i64" { return "i64" }
  if k == "f32" { return "f32" }
  if k == "str" { return "string" }
  if k == "list" { return "i32[]" }
  if k == "strlist" { return "string[]" }
  if k == "f64list" { return "f64[]" }
  if k == "struct" {
    const slot = cloRetValSlot(fe)
    if slot >= 0 && slot < sNames.length { return sNames[slot] }
  }
  ""
}

// The function-TYPE name `(p1, p2) => ret` of a closure-VALUE argument (a lambda
// literal or a bare top-level function name) — the form `monoBindFromAnn` matches a
// generic closure param `(A, T) => A` against. "" when the argument is not a resolvable
// closure value or a param/return type lies outside the name vocabulary. (Distinct from
// `monoArgTyName`'s `"=>sigkey"` pin, which an UN-annotated closure param wants.)
// Resolve any STRUCTURAL shapes inside a `(params)=>ret` function-type name to their NOMINAL names —
// the single structural→nominal bridge (`resolveShapeToNominal`, which also peels `[]`) applied to each
// param and the return. The checker renders a lambda's struct part as `{x: i32}` / `{x: i32}[]`; the
// monomorphizer's type-param bindings and every nominal-keyed emitter site (`nameIsRefArray`,
// `rlSlotByName`, `structIndexByName`) want `P` / `P[]`. Applied ONCE at the mono boundary so the
// instance is nominal throughout. A non-function name, or one with no resolvable shape, passes through.
export function nominalizeFnType(name: string) {
  // `annFnDecompose` (#1144) IS the three gates + both slices + the guarded param split;
  // this copy's three `return name` legs are exactly the home's "" sentinel. The third and
  // last copy in this file — `annSplitParams` goes to ZERO call sites here.
  const parts: string[] = []
  const retStr = annFnDecompose(name, parts)
  if retStr == "" { return name }
  let out = "("
  let i = 0
  while i < parts.length {
    if i > 0 { out = out + "," }
    out = out + resolveShapeToNominal(parts[i])
    i = i + 1
  }
  out + ")=>" + resolveShapeToNominal(retStr)
}

// `monoUnwrapParens` LIVED HERE and is gone (D-MONOPAREN) — it was the compiler's LAST
// paren-ONLY wrap walk, and `emit_base.normTypeAtom` is the same peel riding the shared
// `tyGroupWrapsWhole` ladder. #1150 moved this function's five out-of-file consumers to the
// home and filed the remaining twelve as a measured hand-off; those twelve now call the
// home directly and the walk is deleted rather than repaired.
//
// The two readings differ in THREE ways and all three were measured rather than argued:
// the home TRIMS surrounding whitespace, its wrap test is the FULL `{}[]()<>` ladder rather
// than a paren count, and its `>` is gated by `tyGtIsClose` so a `$fnsig` `ii>i` or a
// `tyToStr` `->` cannot unbalance it. Computing both at every live invocation of all twelve
// sites: **0 disagreements over 1,112,807 invocations** (31,005 corpus + 1,081,802 fuzz),
// with the INVERTED comparator firing on 100% of reaches on both channels AND at every one
// of the twelve sites individually. `normTypeAtom` carries the trailing-`)` cheap reject
// this copy had, so the substitution is work-neutral on the guard.

// Does struct `si` carry a CLOSURE-valued field `name` (code 14)?
export function drwFieldClosure(si: i32, name: string) {
  if si < 0 { return false }
  const fi = sFieldIndex(si, name)
  if fi < 0 { return false }
  sFieldTypeAt(si, fi) == 14
}

// Give each un-annotated parameter the concrete scalar/string type the checker recorded for
// it (`nodeTyName`) — a contextually-inferred callback param (`xs.map((x) => x * 2.0)` ⇒
// `x: f64`) whose annotation the emitter otherwise defaults to i32 (`checkParams`), so an
// f64/string-element callback mis-lowered. Emit-time, post-check (fmt untouched); a generic
// hole / already-annotated / non-scalar param yields "" and is left as-is.
// Resolve a checker-rendered type-shape NAME to the emitter's NOMINAL form: a struct shape
// (`{x: i32}`) to its declared name (matched by field-set), a variant shape to its variant name,
// and — RECURSIVELY — a ref-array shape to `<resolved element>[]` at any depth. A scalar / closure
// / already-nominal name passes through. One recursive resolver, so a new container shape (a
// nested list, a list-of-lists) falls out instead of being special-cased per depth.
export function resolveShapeToNominal(name: string) {
  if name == "" { return "" }
  if nameIsArray(name) {
    const inner = resolveShapeToNominal(arrElemNameRaw(name))
    if inner == "" { return "" }
    return inner + "[]"
  }
  const si = structIndexOfTypeName(name)
  if si >= 0 { return sNames[si] }
  const vti = variantIndexOfTypeName(name)
  if vti >= 0 { return uVariants[vti] }
  name
}
