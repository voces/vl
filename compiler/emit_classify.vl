}

// True if `callIx` is a `recv.bytes()` over a string receiver.
export function exprIsStrBytes(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if callee.memProp == "bytes" { return exprString(callee.memObj, fnIx) }
    }
