// The `$fnsig` param-spine token for parameter `paramIx` — one token per distinct param
// valtype, so two functions share a `$fnsig` exactly when their param valtypes byte-match.
// Single char for the fixed-valtype kinds; a `;`-delimited table index for the per-shape
// ones. "" for a kind outside the value-call ABI, which keeps the signature un-interned.

function cloParamTok(paramIx: i32) {
  const k = vtKindOfParam(paramIx)
  // Slot-carrying kinds append their interned table slot, so two sigs share a `$fnsig`
  // only when the param shapes match. `paramStructIdxFinal` reads the row after the merge
  // in both phases; the phase-gated `paramStructIdxOf` would key the narrow row (D925).
  if k == "variant" { return repSigVariantTok(paramStructIdxFinal(paramIx)) }
  if k == "struct" || k == "reflist" || k == "nulstruct" {
    return repSigSlotTokOfKind(k, paramStructIdxFinal(paramIx))
  }
  // A nullable-closure param stays outside the value-call ABI; only the result position is
  // wired. `repSigTokOfKind("nulclosure")` yields a result token (`C`), so without this arm
  // a nulclosure param would key a slot-less `C` and mis-lower.
  if k == "nulclosure" { return "" }
  // A map param keyed by its map shape, as the map result already is. The slot is what
  // makes it sound: the digit minted here is the heap slot the callee's own functype
  // declares — the interlock a `call_ref` through the interned sig has to pass. D701.
  if k == "map" { return repSigSlotTokOfKind(k, paramStructIdxFinal(paramIx)) }
  // Every slot-free kind reads the shared canonical token table in `emit_rep`, and "" for a
  // kind with no token at all keeps its signature un-interned so `emitClosureValue`'s
  // soundness floor rejects the value loudly. The nullable-ref niches that do have a token
  // are in the ABI at the param position too: one `fbValtype` table serves both functypes.
  repSigTokOfKind(k)
}

// The interning key for lifted function `fe`'s env-leading `$fnsig`, or "" when the
// signature is not function-value-eligible. It encodes the param kinds (`cloParamTok`) and
// the return kind, so two functions share one `$fnsig` exactly when their env-leading
// functypes render the same bytes. `cloSigKeyExt` extends the result spine.
export function fnSigKeyOf(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return "" }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    let key = ""
    const params = fn.fnParams
    let pi = 0
    while pi < params.length {
      const tok = cloParamTok(params[pi])
      if tok == "" { return "" }
      key = key + tok
      pi = pi + 1
    }
    // Key/bytes interlock: the `$fnsig` bytes stream from the key's representative via
    // `cloRetValKind`, so a key coarser than it would let two different result reps share
    // one slot and declare the loser with the winner's functype. `cloRetKindOf` is that
    // coarser answer, so the value-ABI key is minted only where the two agree.
    const r = cloRetKindOf(fe)
    const vk = cloRetValKind(fe)
    if r == "i32" && vk == "i32" { return key + ">" + repSigTokOfKind("i32") }
    if r == "f64" && vk == "f64" { return key + ">" + repSigTokOfKind("f64") }
    return ""
  }
  ""
}

// The value-ABI return kind of lifted function `fe` for `$fnsig` purposes: `"i32"`,
// `"f64"`, or `null` for void, closure-returning, or any other kind. An annotated return
// reads the annotation; an un-annotated one rides the stored kind plus `tailIsF64NoLocal`,
// which stays registry-independent so the key cannot depend on the current function.
export function cloRetKindOf(fe: i32): VKind | null {
  if fe < 0 || fe >= fnStmts.length { return null }
  if fe >= fRetVoid.length { return null }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    if fRetVoid[fe] == 1 { return null }
    if fnReturnsClosure(fe) { return null }
    if fn.fnRet >= 0 {
      const k = vtKindOfType(fn.fnRet)
      if k == "i32" { return "i32" }
      if k == "f64" { return "f64" }
      return null
    }
    // Un-annotated: an inferred ref, i64 or f32 kind is out of the value ABI, an f64 tail
    // is `"f64"`, and everything else rides the i32 result. The `"nulstr"` niche falls
    // through with `"i32"` deliberately — this ladder does not consult `fRetNulStr`.
    const irk = fRetKind[fe]
    if irk == "f64" { return "f64" }
    if irk != "i32" && irk != "nulstr" { return null }
    if tailIsF64NoLocal(fnRetExprOf(fnStmts[fe]), fnStmts[fe]) { return "f64" }
    return "i32"
  }
  null
}

// Whether the lifted callback at `fe` returns a string — its annotation, or the inferred
// `"str"` kind. `cloRetKindOf` folds string into `null` since it is outside the i32/f64
// value ABI, so `.map` and `.filter` consult this to pick the string-list result kind.
export function cloRetIsString(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return false }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    // The arena, not the spelling: canon softens an inline literal union to `string`, so
    // reading the annotation name answers true for a result whose elements are interned
    // i32 atoms. Answering false here routes the shape to the `.map` result classifier's
    // decline — a loud reject rather than a module only the post-emit validator catches.
    if fn.fnRet >= 0 { return nodeTyPrimName(fn.fnRet) == "string" }
    if fe < fRetKind.length { return fRetKind[fe] == "str" }
  }
  false
}

// True when the `.map` callback at `fe` produces an element riding the string list — a
// plain `string` or the `string | null` niche, which share one wrapper and backing pair.
// The collect-time twin of `mfResultKindOf`'s `"str"` answer; the two must name the same
// set, or the emitter picks the string wrapper for a list type collection never forced.
export function mfCbResultIsStrList(fe: i32) {
  cloRetIsString(fe) || cloRetValKind(fe) == "nulstr"
}

// Registry-independent f64-ness of a lifted callback's tail expression: float literals,
// f64 params, f64 arithmetic over those, and f64-returning named calls. It avoids
// `declaredF64` and `declaredSlotOf` — the locals registry belongs to whichever function
// is being emitted — so the answer is the same during sig collection and section emission.
function tailIsF64NoLocal(ix: i32, fnArenaIx: i32) {
  if ix < 0 { return false }
  const e = P.nodes[ix]
  if e is NumLit { return numLexIsFloat(e.numText) }
  if e is Paren { return tailIsF64NoLocal(e.parInner, fnArenaIx) }
  if e is Ident { return paramIsF64(fnArenaIx, e.identName) }
  if e is BinExpr {
    const op = e.binOp
    if op == "+" || op == "-" || op == "*" || op == "/" {
      if tailIsF64NoLocal(e.binLeft, fnArenaIx) { return true }
      return tailIsF64NoLocal(e.binRight, fnArenaIx)
    }
    return false
  }
  if e is Unary {
    if e.unOp == "-" { return tailIsF64NoLocal(e.unArg, fnArenaIx) }
    return false
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const t = fnIndexOfSid(sidOfNode(e.callFn))
      if t >= 0 {
        if t < fRetKind.length { return fRetKind[t] == "f64" }
      }
    }
    return false
  }
  false
}

// The lifted-function position (`fnStmts` index) of an object-literal field value that is
// a function: an inline lambda (a `FuncDecl` node, lifted in place, so its arena index
// appears in `fnStmts`) or a bare `Ident` naming a function. -1 for any other field value.
export function fieldValueFeOf(valIx: i32) {
  if valIx < 0 { return -1 }
  const v = P.nodes[valIx]
  if v is FuncDecl { return fnStmtsPosOf(valIx) }
  if v is Ident { return fnIndexOfSid(sidOfNode(valIx)) }
  -1
}

// The override priority of a stored return kind: `criSetRetKind` lands a write only when
// the new kind outranks the current one, so eager per-fact writes resolve to one kind
// however they are ordered. Kinds that are mutually exclusive facts about a single return
// share a tier, since neither may overwrite the other.
function retKindPri(k: VKind) {
  if k == "str" { return 1 }
  if k == "list" { return 2 }
  if k == "union" { return 3 }
  if k == "struct" { return 4 }
  // The concrete variant shares `struct`'s tier: a return is a plain struct or a union
  // arm, never both (`collectS` skips a `TypeDecl` that `variantIndexOf` claims), so
  // neither fact may overwrite the other and the strict `>` in `criSetRetKind` is that
  // refusal. An annotated `: Cat` stays `"i32"` with its index in `fRetStructIdx`.
  if k == "variant" { return 4 }
  if k == "nulstruct" { return 5 }
  // D1562 — the nullable variant shares `nulstruct`'s tier, for the reason the concrete
  // variant shares `struct`'s: the two are mutually exclusive facts about one return. At
  // tier 0 `exprNullableStruct`'s cheap fallback, which cannot tell a union arm from a
  // standalone struct, wins and leaves the pair (`"nulstruct"`, -1).
  if k == "nulvariant" { return 5 }
  if k == "reflist" { return 6 }
  if k == "strlist" { return 7 }
  if k == "f64list" { return 8 }
  if k == "i64list" { return 9 }
  if k == "f32list" { return 10 }
  // The packed byte list shares `f32list`'s tier: the two are mutually exclusive facts
  // about one return, so neither needs to outrank the other.
  if k == "u8list" { return 10 }
  if k == "map" { return 11 }
  // D937 — the nullable map ranks above `map`, which is not mutually exclusive with it:
  // the name ladder records `nulmap`, then `criClassify` writes the non-null `map` fact
  // about the same return, and at tier 0 that later write wins — result valtype
  // `(ref $mapStruct)`, and a bare `return null` reaching `emitNullLitNode` with no context.
  if k == "nulmap" { return 12 }
  if k == "nulstr" { return 12 }
  if k == "i64" { return 13 }
  if k == "f64" { return 13 }
  if k == "f32" { return 13 }
  // D1567 — the `null` type shares the top tier: a return whose every value is a bare
  // `null` is the `null` type or something else, never both. The strict `>` is what stops
  // an expression fact lowering a kind the checker already settled.
  if k == "nulnone" { return 13 }
  0
}

// True if `k` is one of the list return kinds — the shared not-yet-a-list guard of
// `criClassify`'s list arms.
function retKindIsList(k: VKind) {
  k == "list" ||
    k == "reflist" ||
    k == "strlist" ||
    k == "f64list" ||
    k == "i64list" ||
    k == "f32list"
}

// Store an inferred return-kind fact for function `i`: the write happens only when it
// outranks the current kind (`retKindPri`), marking the `computeRetInference` fixed point
// dirty. Returns true exactly when it does — the struct and nulstruct arms gate their
// `fRetStructIdx` payload on that.
function criSetRetKind(i: i32, k: VKind) {
  if retKindPri(k) > retKindPri(fRetKind[i]) {
    fRetKind[i] = k
    criChanged = true
    return true
  }
  false
}

// The stored return kind of an annotated return-type node `tyIx` — the flag producers in
// last-match order, which is what `buildFnMap` seeds `fRetKind` from. An i64 or f32 list
// annotation is deliberately not flagged here (an annotated `i64[]` return rides the typed
// IR path), and a `: Cat` variant stays `"i32"` with its index in `fRetStructIdx`.
export function retAnnKindChain(tyIx: i32): VKind {
  let k: VKind = "i32"
  if retStrFlag(tyIx) == 1 { k = "str" }
  const lk = retListKindFlag(tyIx)
  if lk == 2 { k = "list" }
  if retUnionFlag(tyIx) == 1 { k = "union" }
  if retTRFlag(tyIx) == 1 { k = "struct" }
  if retNulRefFlag(tyIx) == 1 { k = "nulstruct" }
  // `Circle | null` — the recorded return kind a caller reads back to declare an inferred
  // binding's slot and resolve the call's result valtype. Without it the chain falls to
  // `"i32"` and the call lands in an i32 local while the functype says `(ref null …)`.
  if retNulVariantFlag(tyIx) == 1 { k = "nulvariant" }
  if lk == 5 { k = "reflist" }
  if lk == 7 { k = "strlist" }
  if lk == 12 { k = "f64list" }
  if retMapFlag(tyIx) == 1 { k = "map" }
  if retNulStringFlag(tyIx) == 1 { k = "nulstr" }
  if retI64Flag(tyIx) == 1 { k = "i64" }
  if retF64Flag(tyIx) == 1 { k = "f64" }
  if retF32Flag(tyIx) == 1 { k = "f32" }
  k
}

// The result valtype kind of a function's return — the stored `fRetKind` slot, seeded by
// `buildFnMap` and refined by `computeRetInference`'s eager writes.
export function inferredRetKindCore(ti: i32): VKind { fRetKind[ti] }

// The result valtype kind of lifted function `fe`'s `$fnsig` functype — the same kind the
// function's own functype emits, read from an annotation (`vtKindOfType`) or the stored
// inferred return kind, so the closure functype byte-matches the callee. `null` for a void
// result. The slot for the kinds that carry one comes from `cloRetValSlot`.
export function cloRetValKind(fe: i32): VKind | null {
  if fe < 0 || fe >= fnStmts.length { return null }
  if fe >= fRetVoid.length { return null }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    if fRetVoid[fe] == 1 { return null }
    if fn.fnRet >= 0 {
      if tyIsFuncType(fn.fnRet) { return "closure" }
      return vtKindOfType(fn.fnRet)
    }
    if fnReturnsClosure(fe) { return "closure" }
    // An implicit return that is an assignment yields the target cell. Consulted ahead of
    // the variant-collapse arm so the `$fnsig` and the function's own functype are minted
    // from one fact: over a union global, `cbRetVariantIdx` would name the collapsed
    // variant here while `emitTypeSection` emits the union box.
    const cloArk = fnAssignRetKind(fe)
    if cloArk != null { return cloArk }
    // A callback collapsing to one concrete variant is typed as that variant, so the
    // `$fnsig` result is the variant struct, not the union box. Checked before the
    // `"union"` kind, which the emitter's syntactic inference also stores.
    if cbRetVariantIdx(fe) >= 0 { return "variant" }
    // The shared inferred-return-kind mapping, the same one the named-function functype
    // result uses, so a kind added there is reflected here. The closure-specific cases are
    // layered around it.
    const core = inferredRetKindCore(fe)
    if core != "i32" { return core }
    // An f64 tail with no intervening local (`n => n * 2.0`) — detected structurally, not
    // via `fRetF64`; without it the callback's functype declares i32 over an f64 body.
    if tailIsF64NoLocal(fnRetExprOf(fnStmts[fe]), fnStmts[fe]) { return "f64" }
    return "i32"
  }
  null
}

// The struct-table slot for `fe`'s result valtype — a real index only for the kinds that
// carry one (struct, nullable struct, variant, ref list, map), `-1` otherwise.
export function cloRetValSlot(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return -1 }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    if fn.fnRet >= 0 {
      const k = vtKindOfType(fn.fnRet)
      if k == "struct" || k == "nulstruct" {
        // D911 — the `??` merge redirect. A module holding any function value gives every
        // eligible function an env-leading `$fnsig`, and this slot is both that pool entry's
        // interning key and its emitted result valtype, so an unmoved row here declares
        // `(result (ref null $narrow))` beside a function functype of the merged row.
        return anonLeafRetRowOf(fnStmts[fe], retStructIndex(fn.fnRet))
      }
      // A `: Cat` annotated variant result — the slot is the variant index.
      if k == "variant" { return variantIndexOf(tyNameOf(fn.fnRet)) }
      // A `: Circle | null` annotated result — the slot is the variant index under the
      // null, since `retStructIndex` has no row for a variant.
      if k == "nulvariant" { return nulVariantIndexOf(fn.fnRet) }
      // A `: S[]` or `: ((i32) => i32)[]` annotated ref-list result — the slot is the
      // `rlWrapIdx`-bearing ref-list slot, the dual of a `cloParamTok` ref-list param's.
      if k == "reflist" { return tyAnnRefListSlot(fn.fnRet) }
      // A `: {[string]: V}` annotated map result — the slot is the map shape (-1 when mono,
      // else the value type's mv slot), so the `$fnsig` result selects this map's struct.
      if k == "map" { return mapAnnShape(fn.fnRet) }
      return -1
    }
    // The slot half of `cloRetValKind`'s assignment-cell arm, read from the same cell,
    // ahead of the variant-collapse slot for the same reason the kind is.
    if fnAssignRetKind(fe) != null { return fnAssignRetSlot(fe) }
    // A collapsed-to-one-variant inferred result — the variant index.
    const cvi = cbRetVariantIdx(fe)
    if cvi >= 0 { return cvi }
    const srk = fRetKind[fe]
    // D911 — the same redirect on the inferred half: the two halves of one signature must
    // not learn the merge separately.
    if srk == "struct" {
      return anonLeafRetRowOf(fnStmts[fe], fRetStructIdx[fe])
    }
    if srk == "nulstruct" {
      return anonLeafRetRowOf(fnStmts[fe], fRetStructIdx[fe])
    }
    // The inferred concrete-variant result, from the same companion column — the twin of
    // `emitOneFuncType`'s inferred `variant` arm. Without it the `$fnsig` and the
    // function's own functype are minted from two different facts.
    if srk == "variant" { return fRetStructIdx[fe] }
    // D1562 — the nullable twin, same column and index space. Every caller reads the kind
    // and this slot as a pair; without the arm the pair is (`"nulvariant"`, -1) and
    // `fbValtype`'s bounds guard fires with `ref valtype with no interned shape`.
    if srk == "nulvariant" { return fRetStructIdx[fe] }
    // An inferred map return — the map shape from the return expression
    // (`mapRetExprShape`, capture-aware), so the `$fnsig` result matches the returned
    // map value's own `$mapStruct`.
    if srk == "map" {
      const mrx = fnRetExprOf(fnStmts[fe])
      if mrx >= 0 { return mapRetExprShape(mrx, fe) }
    }
    // An inferred ref-list return — its element name (`fRetRArrElem`, set by the
    // return-classify scan) resolves the ref-list slot.
    if srk == "reflist" { return rlSlotByName(fRetRArrElem[fe]) }
  }
  -1
}

// The `>X` result suffix of `fe`'s extended `$fnsig` key — one token per distinct result
// functype shape, so two functions share a sig exactly when their params and result
// byte-match. "" for a kind outside the value ABI; the caller key-builds a void result as
// `>v` before consulting this.
function cloRetKeySuffix(fe: i32) {
  const k = cloRetValKind(fe)
  // The slot-carrying result kinds: a struct or nullable-struct result keyed by its struct
  // index, a concrete variant by its variant index, so two callbacks share a sig only when
  // they return the same shape.
  if k == "variant" { return ">" + repSigVariantTok(cloRetValSlot(fe)) }
  if k == "struct" || k == "nulstruct" {
    return ">" + repSigSlotTokOfKind(k, cloRetValSlot(fe))
  }
  // A map result carries its map shape slot, so two map-returning closures share a
  // `$fnsig` exactly when their value types match and the result `(ref $mapStruct)` is the
  // heap type the returned map and the closure's env field both carry.
  if k == "map" { return ">" + repSigSlotTokOfKind(k, cloRetValSlot(fe)) }
  // A ref-list result: the `$fnsig` result is the ref-list wrapper ref, recovered non-null
  // at the value-call site like every other ref result — the dual of the `r<idx>;` param
  // token. No resolved slot means no sig.
  if k == "reflist" {
    const rs = cloRetValSlot(fe)
    if rs >= 0 { return ">" + repSigSlotTokOfKind(k, rs) }
    return ""
  }
  // Every slot-free kind reads the shared canonical token table in `emit_rep`, a closure
  // result included, so a curried lambda lowers as a callable value. "" for a kind outside
  // the value ABI, and for the void or unresolved result the caller key-builds as `>v`.
  const t = repSigTokOfKind(k)
  if t == "" { return "" }
  ">" + t
}

// The extended `$fnsig` key of lifted function `fe`: `fnSigKeyOf`'s key when the sig is
// value-eligible, else the same param spine with `cloRetKeySuffix`'s result suffix. "" when
// any param or the result kind is outside the ABI.
export function cloSigKeyExt(fe: i32) {
  const base = fnSigKeyOf(fe)
  if base != "" { return base }
  if fe < 0 || fe >= fnStmts.length { return "" }
  if fe >= fRetVoid.length { return "" }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    const params = fn.fnParams
    let key = ""
    let pi = 0
    while pi < params.length {
      const tok = cloParamTok(params[pi])
      if tok == "" { return "" }
      key = key + tok
      pi = pi + 1
    }
    if fRetVoid[fe] == 1 { return key + ">v" }
    const suf = cloRetKeySuffix(fe)
    if suf == "" { return "" }
    return key + suf
  }
  ""
}

// Which position of `fe`'s signature has no `$fnsig` token — a named parameter and its
// type, or its result type, else "". It walks `cloSigKeyExt`'s own ladder in that order,
// so the two cannot disagree about the offender: params first, first fail winning, then
// the result; a void result is never it, since `>v` is a key.
export function cloSigRejectWhat(fe: i32): string {
  if fe < 0 || fe >= fnStmts.length { return "" }
  if fe >= fRetVoid.length { return "" }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    const params = fn.fnParams
    let pi = 0
    while pi < params.length {
      if cloParamTok(params[pi]) == "" {
        const p = P.nodes[params[pi]]
        if p is Param {
          // The declared spelling: for a lambda whose param the pin synthesized this is
          // the pinned nullable, which is exactly the type the token table declined. "" is
          // only a parameter with no annotation node, which `cloParamTok` never refuses.
          const pn = tyNameOf(p.parType)
          if pn != "" {
            return "parameter `" + p.parName + "` of type `" + pn + "`"
          }
          return "parameter `" + p.parName + "`"
        }
      }
      pi = pi + 1
    }
    if fRetVoid[fe] != 1 {
      if cloRetKeySuffix(fe) == "" { return "its result type" }
    }
  }
  // Total, so the reject is one message literal rather than two: a caller falling back to a
  // second sentence writes a second concession into the source. No reachable third case —
  // the floor fires only when the key build stopped, and this walk is that build's ladder.
  "its signature"
}

// The lifted-function position of the closure held by field `prop` of struct `si`,
// resolved through the object literals that intern shape `si` — every literal of one
// shape carries sig-identical closures, so the first match types the call. -1 when no
// literal of shape `si` sets a function-valued `prop`.
function fieldClosureFeOf(si: i32, prop: string) {
  if si < 0 { return -1 }
  let ai = 0
  while ai < P.nodes.length {
    const an = P.nodes[ai]
    if an is ObjLit {
      if structIndexOfObj(ai) == si {
        const ffe = fieldValueFeOf(objFieldVal(ai, prop))
        if ffe >= 0 { return ffe }
      }
    }
    ai = ai + 1
  }
  -1
}

// The lifted-function position of the closure a member call `recv.prop(...)` dispatches
// to: first by following the receiver to the literal that built it, so two same-shaped
// receivers from different monomorphized makers each resolve their own closure, else by
// the receiver's struct shape (`fieldClosureFeOf`). -1 when neither resolves.
export function fieldClosureFeOfRecv(recvIx: i32, prop: string, fnIx: i32) {
  // With no function value module-wide there is no closure field: every terminal below is
  // `fieldValueFeOf(objFieldVal(…))`, which resolves only a lambda field or a bare
  // function-name field, so the flag being clear makes -1 the only answer. The gate also
  // keeps the hole-param arm below from scanning the whole arena per member call.
  if !fnValUsed { return -1 }
  const e = P.nodes[unwrapParen(recvIx)]
  if e is Ident {
    let li = -1
    if fnIx >= 0 {
      const fn = P.nodes[fnIx]
      if fn is FuncDecl { li = parentLetOf(fn.fnBody, e.identName) }
    }
    if li < 0 { li = globalLetOfIn(fnIx, e.identName) }
    if li >= 0 {
      const d = P.nodes[li]
      if d is LetDecl {
        const ffe = fieldClosureFeOfInit(d.letInit, prop)
        if ffe >= 0 { return ffe }
      }
    }
  }
  if e is Call {
    const ffe2 = fieldClosureFeOfInit(unwrapParen(recvIx), prop)
    if ffe2 >= 0 { return ffe2 }
  }
  // A hole param's receiver is its argument, which the struct-index fallback below cannot
  // see: `{f: () => string}` and `{f: () => i32}` collapse to one struct row, so the scan
  // returns whichever literal is declared first and traps otherwise (D987). Resolving the
  // call-site argument disambiguates without refusing the two order-lucky spellings.
  if e is Ident {
    if fnIx >= 0 {
      const rf = P.nodes[fnIx]
      if rf is FuncDecl {
        if rf.fnName != "" {
          const rps = rf.fnParams
          let rpi = 0
          while rpi < rps.length {
            const rpn = P.nodes[rps[rpi]]
            if rpn is Param {
              if rpn.parName == e.identName {
                let rci = 0
                while rci < P.nodes.length {
                  const rcn = P.nodes[rci]
                  if rcn is Call {
                    const rcf = P.nodes[rcn.callFn]
                    if rcf is Ident {
                      if rcf.identName == rf.fnName {
                        if rpi < rcn.callArgs.length {
                          // fnIx -1: the argument resolves in module scope, which also
                          // stops this arm re-entering for a param of the same name.
                          const rfe = fieldClosureFeOfRecv(
                            rcn.callArgs[rpi],
                            prop,
                            -1,
                          )
                          if rfe >= 0 { return rfe }
                        }
                      }
                    }
                  }
                  rci = rci + 1
                }
              }
            }
            rpi = rpi + 1
          }
        }
      }
    }
  }
  fieldClosureFeOf(structIndexOfExpr(recvIx, fnIx), prop)
}

// The maker function (`fnStmts` position) whose tail object literal built the receiver
// expression at `recvIx`: a direct `make(...)` call, or an ident bound to one. -1 when the
// receiver's origin is not a maker call.
function recvMakerFnOf(recvIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(recvIx)]
  let initIx = unwrapParen(recvIx)
  if e is Ident {
    let li = -1
    if fnIx >= 0 {
      const fn = P.nodes[fnIx]
      if fn is FuncDecl { li = parentLetOf(fn.fnBody, e.identName) }
    }
    if li < 0 { li = globalLetOfIn(fnIx, e.identName) }
    if li < 0 { return -1 }
    const d = P.nodes[li]
    if d is LetDecl { initIx = unwrapParen(d.letInit) } else { return -1 }
  }
  const ie = P.nodes[initIx]
  if ie is Call {
    const callee = P.nodes[ie.callFn]
    if callee is Ident { return fnIndexOfSid(sidOfNode(ie.callFn)) }
  }
  -1
}

// The annotation name of parameter `name` of the lifted function at `fe`, or "" when it is
// not a param or is un-annotated.
function feParamTyName(fe: i32, name: string) {
  if fe < 0 || fe >= fnStmts.length { return "" }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    const params = fn.fnParams
    let i = 0
    while i < params.length {
      const p = P.nodes[params[i]]
      if p is Param {
        if p.parName == name { return tyNameOf(p.parType) }
      }
      i = i + 1
    }
  }
  ""
}

// Boolean-ness of a field-closure trap call `recv.prop(...)`. Monomorphized maker instances
// share the closure body, so its inferred return kind cannot distinguish `wrap(true)` from
// `wrap(99)`; follow the receiver to its maker instance and read the closure's tail through
// that instance's pinned param annotations, falling back to the shared closure's `fRetBool`.
function fieldCloCallIsBool(recvIx: i32, prop: string, fnIx: i32) {
  const mk = recvMakerFnOf(recvIx, fnIx)
  if mk >= 0 {
    const rx = fnRetExprOf(fnStmts[mk])
    if rx >= 0 {
      const re = P.nodes[unwrapParen(rx)]
      if re is ObjLit {
        const v = objFieldVal(unwrapParen(rx), prop)
        if v >= 0 {
          const vf = P.nodes[v]
          if vf is FuncDecl {
            const vRet = vf.fnRet
            // The arena: `nodeTyPrimName` reads `T.tys[ty].primName`, so an aliased
            // `type B = boolean` return answers `"boolean"` where the spelling reads `"B"`.
            // The `>= 0` guard decides whether this returns and the predicate only what, so
            // a wider answer cannot suppress the fallbacks below.
            if vRet >= 0 { return nodeTyPrimName(vRet) == "boolean" }
            const tx = fnRetExprOf(v)
            if tx >= 0 {
              const te = P.nodes[unwrapParen(tx)]
              if te is Ident {
                const ptn = feParamTyName(mk, te.identName)
                if ptn != "" { return ptn == "boolean" }
              }
              return exprIsBool(tx, v)
            }
          }
        }
      }
    }
  }
  const bfe = fieldClosureFeOfRecv(recvIx, prop, fnIx)
  if bfe >= 0 {
    const bfn = P.nodes[fnStmts[bfe]]
    if bfn is FuncDecl {
      if bfn.fnRet >= 0 { return nodeTyPrimName(bfn.fnRet) == "boolean" }
    }
    if bfe < fRetBool.length { return fRetBool[bfe] == 1 }
  }
  false
}

// Resolve `prop`'s closure through an initializer expression: an object literal reads its
// own field, a call to a maker follows the maker's return expression. -1 otherwise.
function fieldClosureFeOfInit(initIx: i32, prop: string) {
  if initIx < 0 { return -1 }
  const e = P.nodes[unwrapParen(initIx)]
  if e is ObjLit {
    return fieldValueFeOf(objFieldVal(unwrapParen(initIx), prop))
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const t = fnIndexOfSid(sidOfNode(e.callFn))
      if t >= 0 {
        const rx = fnRetExprOf(fnStmts[t])
        if rx >= 0 {
          const re = P.nodes[unwrapParen(rx)]
          if re is ObjLit {
            return fieldValueFeOf(objFieldVal(unwrapParen(rx), prop))
          }
        }
      }
    }
  }
  -1
}

// The position of `key` in `cloSigKeys`, or -1.
export function cloSigPosOfKey(key: string) {
  let i = 0
  while i < cloSigKeys.length {
    if cloSigKeys[i] == key { return i }
    i = i + 1
  }
  -1
}

// The one place a `$fnsig` pool position becomes a type index (D351), so the four sites
// needing one cannot declare a closure with one functype and call it at another. Two
// identical functypes at two indices of one rec group are distinct types in WasmGC, so a
// position resolves through the twin column to the smallest matching one, never the key.
export function cloSigTypeIdxAt(pos: i32) {
  if pos < 0 { return -1 }
  if cloSigTwin.length != cloSigKeys.length { return cloSigBase + pos }
  cloSigBase + cloSigTwin[pos]
}

// The `$fnsig` type index for lifted function `fe`'s own signature, or -1 when it is not
// value-eligible or not interned. `cloSigKeyExt` equals the value-ABI key for an eligible
// sig; a void or struct-returning field closure resolves its interned extended sig, so its
// function-section type is that `$fnsig` and the trap call site's `ref.cast` accepts it.
export function fnSigIdxOfFn(fe: i32) {
  const key = cloSigKeyExt(fe)
  if key == "" { return -1 }
  cloSigTypeIdxAt(cloSigPosOfKey(key))
}

// The type index of the all-i32 `$fnsig` functype for value-call arity `ar` — the
// signature every generic value call (a let-bound, param or field closure) dispatches
// through. -1 if not interned.
export function fnSigIdxForArity(ar: i32) {
  let key = ""
  let i = 0
  while i < ar {
    key = key + repSigTokOfKind("i32")
    i = i + 1
  }
  cloSigTypeIdxAt(cloSigPosOfKey(key + ">" + repSigTokOfKind("i32")))
}

// The wasm global index for the symbol `sid`, or -1 if no top-level global has that name.
// `collectFns` interned every global's name when it built the array, so a sid beyond its
// end is a name that is not a global.
export function globalIndexOfSid(sid: i32) { sidArrGet(globalIndexBySid, sid) }

// The wasm global index for `name`, or -1 if no top-level global has that name. The string
// form is for call sites that hold no arena index; every hot caller takes the sid form.
export function globalIndexOf(name: string) {
  sidArrGet(globalIndexBySid, sidLookup(name))
}

// The arena index of the `LetDecl` for the global symbol `sid`, or -1.
export function globalLetOfSid(sid: i32) {
  const gi = sidArrGet(globalIndexBySid, sid)
  if gi < 0 { return -1 }
  globalStmts[gi]
}

// The arena index of the `LetDecl` for the global `name`, or -1 if not a global.
export function globalLetOf(name: string) { globalLetOfSid(sidLookup(name)) }

// Has the walk's own scope stack already had its say about which binding a read denotes?
// True while a scope frame is active (the collect and lowering walks keep it in lockstep,
// so every live block binding resolves through `scopeSlotOf`) and during the detection
// sweep that hides them. Where it holds, a block binding a name scan finds is out of scope.
function blockBindingHidden() { blockLetHidden || scopeFrames.length > 0 }

// True when the bare identifier `name`, read from inside function `fnIx`, is bound by that
// frame — a declared local, a param or a capture — so a module global of the same name is
// not what the reference denotes. It asks `localIndexOf` and `capturedKindOf`, the two
// resolvers the lowering itself uses, so classifier and instruction cannot disagree (D705).
export function identBoundInFrame(fnIx: i32, name: string) {
  if localIndexOf(fnIx, name) >= 0 { return true }
  if capturedKindOf(fnIx, name) != null { return true }
  // The arena rung, because `localNames` is empty in the global passes: `buildLocals` runs
  // per function during emission, long after `computeRetInference`, so at the un-annotated
  // return face both rungs above answer -1. Loop variables are deliberately not asked, since
  // `localIndexOf` skips them and the lowering sends those reads to the global.
  if fnIx < 0 { return false }
  const fnb = P.nodes[fnIx]
  if fnb is FuncDecl { return frameLetOfLive(fnb.fnBody, name) >= 0 }
  false
}

// The `LetDecl` a read of `name` denotes in the frame whose body is `bodyIx`, or -1.
// `parentLetOf` answers for the whole body including nested blocks, so where
// `blockBindingHidden` holds the live binding outranks that name scan and a nested hit that
// is not live is out of scope. Scope-less passes keep the whole body. D1597.
function frameLetOfLive(bodyIx: i32, name: string) {
  const li = parentLetOf(bodyIx, name)
  if li < 0 { return -1 }
  if !blockBindingHidden() { return li }
  const slot = scopeSlotOf(name)
  if slot >= 0 && slot < localDeclIx.length {
    if localDeclIx[slot] >= 0 { return localDeclIx[slot] }
  }
  if blockDeclaresStmt(bodyIx, li) { return li }
  -1
}

// Is `stmtIx` a direct statement of the block at `blockIx`, rather than one inside a nested
// block of it? The lexical-extent half of `frameLetOfLive`.
function blockDeclaresStmt(blockIx: i32, stmtIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const ss = b.blkStmts
    let i = 0
    while i < ss.length {
      if ss[i] == stmtIx { return true }
      i = i + 1
    }
  }
  false
}

// `globalLetOfSid` as read from inside function `fnIx`: -1 when the frame binds the name.
// The global lookup runs first, so a name that is not a module global never pays for the
// frame scan.
export function globalLetOfSidIn(fnIx: i32, sid: i32) {
  const li = globalLetOfSid(sid)
  if li < 0 { return -1 }
  if identBoundInFrame(fnIx, sidText(sid)) { return -1 }
  li
}

function globalLetOfIn(fnIx: i32, name: string) {
  globalLetOfSidIn(fnIx, sidLookup(name))
}

// Whether the global `name` is a struct/array/string ref (so a bare reference to it in
// an `exprStruct`/`exprArray`/`exprString` check is recognized as that ref type). The
// global's valtype follows its `LetDecl` annotation or literal initializer, evaluated as
// a top-level constexpr (`fnIx = -1`), mirroring the local `letIsX` predicates.
function globalIsStructSid(fnIx: i32, sid: i32) {
  const li = globalLetOfSidIn(fnIx, sid)
  if li < 0 { return false }
  letIsStruct(li, -1)
}

function globalIsArraySid(fnIx: i32, sid: i32) {
  const li = globalLetOfSidIn(fnIx, sid)
  if li < 0 { return false }
  // A nullable ref-array cell is never the i32 list, whatever `letIsArray` says: that
  // falls through to the initializer when the annotation is not an i32 array, and an empty
  // `[]` answers "i32 list". Only a global re-derives its kind per read, so only a global
  // lets the initializer leak in; `buildLocals` files a local's kind once.
  if globalIsNulRefArraySid(fnIx, sid) { return false }
  letIsArray(li, -1)
}

// True if the module global holds a nullable ref-array cell (`let g: S[] | null`) — the
// storage-class twin of `declaredKind == "nulreflist"` and `paramNulRefArray`. Keyed on
// `globalCellKind`, the cell's own answer, so a read can never disagree with the cell.
function globalIsNulRefArraySid(fnIx: i32, sid: i32) {
  const li = globalLetOfSidIn(fnIx, sid)
  if li < 0 { return false }
  globalCellKind(li) == "nulreflist"
}

// True if a read of the module global `name` leaves a nullable list ref on the stack. The
// ident-to-global read deliberately withholds the eager `ref.as_non_null` for exactly these
// kinds, since the `!= null` compare has to see the raw cell, so a consumer staging the
// receiver into a non-null frame slot must recover it itself.
export function globalNulListCellRead(fnIx: i32, name: string) {
  const li = globalLetOfIn(fnIx, name)
  if li < 0 { return false }
  const k = globalCellKind(li)
  if k == "nullist" { return true }
  if k == "nulreflist" { return true }
  isNulScalarListKind(k)
}

function globalIsStringSid(fnIx: i32, sid: i32) {
  const li = globalLetOfSidIn(fnIx, sid)
  if li < 0 { return false }
  // A `string | null` global reads as a string under narrowing: the global read recovers
  // non-null, and the `!= null` check reads the cell raw.
  letIsString(li, -1) || letIsNulString(li, -1)
}

function globalIsRefArraySid(fnIx: i32, sid: i32) {
  const li = globalLetOfSidIn(fnIx, sid)
  if li < 0 { return false }
  letIsRefArray(li, -1)
}

function globalIsStringArraySid(fnIx: i32, sid: i32) {
  const li = globalLetOfSidIn(fnIx, sid)
  if li < 0 { return false }
  letIsStringArray(li, -1)
}

function globalIsMapSid(fnIx: i32, sid: i32) {
  const li = globalLetOfSidIn(fnIx, sid)
  if li < 0 { return false }
  letIsMap(li, -1)
}

function globalIsF64ArraySid(fnIx: i32, sid: i32) {
  const li = globalLetOfSidIn(fnIx, sid)
  if li < 0 { return false }
  letIsF64Array(li, -1)
}

function globalIsNulRefSid(fnIx: i32, sid: i32) {
  const li = globalLetOfSidIn(fnIx, sid)
  if li < 0 { return false }
  letIsNulRef(li, -1)
}

function globalIsNulListSid(fnIx: i32, sid: i32) {
  const li = globalLetOfSidIn(fnIx, sid)
  if li < 0 { return false }
  // `letIsNulListInfer`, not the annotation-only `letIsNulList`: an un-annotated global
  // bound to a nullable-list producer carries the nullable-list cell too, and
  // `globalCellKind`'s un-annotated arm uses the same predicate, so the read and the cell
  // agree by construction.
  letIsNulListInfer(li, -1)
}

// True if the parameter `name` of function `fnIx` is a nullable struct (`S | null`).
function paramNulRef(fnIx: i32, name: string) {
  retNulRefFlag(paramTypeNode(fnIx, name)) == 1
}

// True if parameter `name` of `fnIx` is a nullable union variant (`Circle | null`, kind
// `nulvariant`) — the variant twin of `paramNulRef`, disjoint from it by construction.
function paramNulVariant(fnIx: i32, name: string) {
  retNulVariantFlag(paramTypeNode(fnIx, name)) == 1
}

// True if the parameter `name` of function `fnIx` is a nullable map (`{[string]: V} | null`,
// kind `nulmap`) — the map twin of `paramNulRef` and `paramNulRefArray`.
function paramNulMap(fnIx: i32, name: string) {
  retNulMapFlag(paramTypeNode(fnIx, name)) == 1
}
// True if the global `name` is a nullable map.
function globalIsNulMapSid(fnIx: i32, sid: i32) {
  const li = globalLetOfSidIn(fnIx, sid)
  if li < 0 { return false }
  letIsNulMap(li, -1)
}

// True if the function `name` returns a nullable struct (`"nulstruct"`).
function fnRetNulRefSid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "nulstruct"
}

// True if the `LetDecl` at `letIx` declares a nullable-struct local: its annotation
// is `S | null`, OR its initializer produces one (a nullable-returning call).
export function letIsNulRef(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      if retNulRefFlag(d.letType) == 1 { return true }
    }
    return exprNullableStruct(d.letInit, fnIx)
  }
  false
}

// The variant twin of `letIsNulRef`: binding `letIx` is a `Circle | null` (kind
// `nulvariant`), by annotation or by a nullable-variant initializer. Disjoint from its
// struct twin, so the `declareLocals` ladder can test either order.
export function letIsNulVariant(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      if retNulVariantFlag(d.letType) == 1 { return true }
    }
    return exprNullableVariant(d.letInit, fnIx)
  }
  false
}

// The variant-table index a `Circle | null` binding's `(ref null $uVarHeap[vi])` cell
// resolves to, or -1 — the `nulvariant` twin of `nulRefStructIdxOfLet`.
export function nulVariantIdxOfLet(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const a = nulVariantIndexOf(d.letType)
      if a >= 0 { return a }
    }
    return nulVariantIdxOfExpr(d.letInit, fnIx)
  }
  -1
}

// The variant-table index of a captured `Circle | null` cell of `fnIx`, or -1 — the
// kind-gated reader on the companion-slot index space, beside `capturedStructIndex` and
// `capturedRefListSlot`. The env field takes its type from this number, so the narrowed
// read and the field cannot name two different heap types.
function capturedNulVariantIdx(fnIx: i32, name: string) {
  if capturedKindOf(fnIx, name) != "nulvariant" { return -1 }
  capturedCompanionSlot(fnIx, name)
}

// The non-null twin of `capturedNulVariantIdx`: the variant-table index of a captured
// `v: Circle` cell, or -1. Same index space and kind gate; without it `exprVariantIndex`'s
// Ident arm has no capture leg and a captured variant handed to a union parameter is
// never boxed.
function capturedVariantIndex(fnIx: i32, name: string) {
  if capturedKindOf(fnIx, name) != "variant" { return -1 }
  capturedCompanionSlot(fnIx, name)
}

// The variant index behind a nullable-variant expression, or -1 — the initializer half of
// `nulVariantIdxOfLet` and the index twin of `exprNullableVariant`, arm for arm, each arm
// reading the resolver that typed that storage class. The kind gate on every arm is the
// contract: `cloRetValSlot` is polymorphic, so an ungated arm returns a row of another space.
export function nulVariantIdxOfExpr(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[exprIx]
  if e is Paren { return nulVariantIdxOfExpr(e.parInner, fnIx) }
  // The index half of `exprNullableVariant`'s if-expression rung (D1560) — the row comes
  // from the arm that carries the rep, which is the arm the kind comes from.
  if e is IfStmt { return nulVariantIdxOfExpr(ifRepArmValueIx(exprIx), fnIx) }
  // The index half of the two map rungs in `exprNullableVariant` (D34) — a bare `m[k]` and
  // an `m[k] ?? d` over an arm-valued map. Same slot and column, so the kind and its
  // companion index come from one fact.
  if e is Index {
    // The index half of the nullable variant-element list arm (D851) — same slot, same
    // kind gate, the column that names the row.
    if exprRefArray(e.idxArr, fnIx) {
      const irls = refListSlotOfExpr(e.idxArr, fnIx)
      if irls >= 0 && irls < rlElemKindTbl.length {
        if rlElemKindTbl[irls] == 1 {
          if rlElemIsNulNiche(irls) {
            const irlv = rlElemVariantRow(irls)
            if irlv >= 0 { return irlv }
          }
        }
      }
    }
    const mri = mapReadMvSlot(exprIx, fnIx)
    if mri >= 0 { return mvValVariantOf(mri) }
  }
  if e is BinExpr {
    const cri = coalesceMvSlot(exprIx, fnIx)
    if cri >= 0 { return mvValVariantOf(cri) }
  }
  if e is AsExpr { return nulVariantIndexOf(exprIx) }
  // The index half of the nested-shape field arm — same field, same column, one fact
  // (D1150).
  if e is Member { return memberNulVariantRow(exprIx, fnIx) }
  // A call of a `: Circle | null`-returning function — the callee's own annotation owns the
  // index, which is what an inferred binding has to read: it has no annotation of its own,
  // and its slot is declared from this answer.
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const cfe = fnIndexOfSid(sidOfNode(e.callFn))
      if cfe >= 0 {
        if cloRetValKind(cfe) == "nulvariant" { return cloRetValSlot(cfe) }
        return -1
      }
      // A closure-value callee (`const f = mk; f()`), which `fnIndexOfSid` misses.
      // `calleeCloSigKeySid` is the key the kind comes from and `sigKeyRetSlot` that same
      // key's slot digit, so the pair stays one fact.
      const nvck = calleeCloSigKeySid(sidOfNode(e.callFn), fnIx)
      if sigKeyRetKind(nvck) == "nulvariant" { return sigKeyRetSlot(nvck) }
      return -1
    }
    if callee is Member {
      const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if ffe >= 0 {
        if cloRetValKind(ffe) == "nulvariant" { return cloRetValSlot(ffe) }
      }
    }
    return -1
  }
  if e is Ident {
    // A declared local carries its variant index in the slot's parallel column, put there
    // by the `declareLocals` ladder — read it back rather than re-deriving from the
    // annotation, which an inferred binding (`const c = x as? Circle`) does not have.
    const dsl = declaredSlotOf(e.identName)
    if dsl >= 0 {
      if localIsRef[dsl] == "nulvariant" { return localStructIdx[dsl] }
    }
    const pt = paramTypeNode(fnIx, e.identName)
    if pt >= 0 {
      const pa = nulVariantIndexOf(pt)
      if pa >= 0 { return pa }
    }
    // The capture arm of the twin: a `Circle | null` cell read from an enclosing frame's
    // env is the same `(ref null $uVarHeap[vi])` niche.
    const cnv = capturedNulVariantIdx(fnIx, e.identName)
    if cnv >= 0 { return cnv }
    const gi = globalLetOfIn(fnIx, e.identName)
    if gi >= 0 {
      const g = P.nodes[gi]
      if g is LetDecl {
        if g.letType >= 0 { return nulVariantIndexOf(g.letType) }
        // Un-annotated (`const c = h(true)`): the index comes from the initializer, the
        // same place `globalCellKind` reads the cell's kind from.
        return nulVariantIdxOfExpr(g.letInit, -1)
      }
    }
  }
  -1
}

// The nullable local `VKind` a bare `const t = m[k]` read of a list- or nested-map-valued
// map binds, or null when the init is not such a read. The read yields `V | null`, the
// `(ref null $wrapper)` vals element, so this only routes the spelling onto an established
// nullable local kind whose narrow and read machinery already lowers.
export function letNulMapReadValKind(letIx: i32, fnIx: i32): VKind | null {
  const d = P.nodes[letIx]
  if !(d is LetDecl) { return null }
  if d.letType >= 0 { return null }
  if d.letInit < 0 { return null }
  const mrs = mapReadMvSlot(d.letInit, fnIx)
  if mrs < 0 { return null }
  if mvValKind[mrs] != 6 { return null }
  const lvk = mvListValKind(mrs)
  if lvk == "list" { return "nullist" }
  if lvk == "strlist" { return "nulstrlist" }
  if lvk == "f64list" { return "nulf64list" }
  if lvk == "i64list" { return "nuli64list" }
  if lvk == "f32list" { return "nulf32list" }
  if lvk == "u8list" { return "nulu8list" }
  if lvk == "reflist" { return "nulreflist" }
  // A nested-map value (`{[string]: {[string]: V}}`, vals element kind 3, the inner map
  // struct): the read binds the nullable-map local.
  if rlElemKindTbl[mvRlSlot[mrs]] == 3 { return "nulmap" }
  null
}

// The `addLocalName` slot argument for a `letNulMapReadValKind` binding: the inner ref-list
// slot for a `nulreflist`, the inner map's shape slot for a `nulmap` (-1 when mono), and -1
// for the scalar-backed list kinds, whose wrappers are global singletons.
export function letNulMapReadSlotArg(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if !(d is LetDecl) { return -1 }
  const mrs = mapReadMvSlot(d.letInit, fnIx)
  if mrs < 0 { return -1 }
  if mvListValKind(mrs) == "reflist" { return mvValInnerRlSlot(mrs) }
  if rlElemKindTbl[mvRlSlot[mrs]] == 3 { return mvValInnerMvSlot(mrs) }
  -1
}

// True if the `LetDecl` at `letIx` is a bare `const t = m[k]` read of a union-valued map.
// The read is `V | null` and the local rep for `A | B | null` is the shared box itself,
// with `null` riding as the null-tagged atom, so the binding is the non-null
// `(ref $uBoxIdx)` cell. Gated to un-annotated bindings: an annotation drives the kind.
export function letNulMapReadUnionBox(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return false }
    const mrs = mapReadMvSlot(d.letInit, fnIx)
    if mrs >= 0 {
      // Except where the read unboxes: a cell narrowed to one value atom leaves no box for
      // this local to hold (D1025), and `collectLocals` runs under the same narrowing stack
      // the lowering does, so the slot follows the read rather than the map's rep.
      if mapReadNarrowedAtomKind(unwrapParen(d.letInit), fnIx) >= 0 {
        return false
      }
      return mvValKind[mrs] == 2
    }
  }
  false
}

// The ref-list element kind a checked read over a nested list yields, or -1 (D1210).
// `xs.pop()` over an `i32[][]` is `i32[] | null` to the checker and the popped value is the
// inner list's wrapper, so each nullable-list classifier claims it at its own element kind.
// No `rlElemNullable` bit is asked: a pop is nullable by construction.
function popRefElemKind(exprIx: i32, fnIx: i32): i32 {
  const slot = popRefRecvSlot(exprIx, fnIx)
  if slot >= 0 && slot < rlElemKindTbl.length { return rlElemKindTbl[slot] }
  -1
}

// The receiver's ref-list slot of a checked read over a nested list, or -1 — the row every
// question about the read element asks, its kind in `popRefElemKind` and its inner slot in
// `nulRefArrayInnerSlot`. `.get(i)` counts for the same reason `.pop()` does (D1281): both
// are `T | null` over the same receiver and both yield the inner list's wrapper.
function popRefRecvSlot(exprIx: i32, fnIx: i32): i32 {
  if exprIx < 0 { return -1 }
  const e = P.nodes[exprIx]
  if e is Paren { return popRefRecvSlot(e.parInner, fnIx) }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Member {
      if callee.memProp == "pop" || callee.memProp == "get" {
        if exprRefArray(callee.memObj, fnIx) {
          return refListSlotOfExpr(callee.memObj, fnIx)
        }
      }
    }
  }
  -1
}

// True if evaluating the expression at `exprIx` yields a nullable i32-list ref — a
// nullable-list-annotated param, local or global reference, or a `rest: i32[] | null` field
// read. The nullable-list dual of `exprNullableStruct`: list-op read sites consult it to
// insert the `ref.as_non_null` recover, which cannot trap since the checker guards the read.
export function exprNullableList(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Paren { return exprNullableList(e.parInner, fnIx) }
  // An `if` whose arm is itself nullable — see `nulIfArmNullableValueIx` (D1560).
  const nlIfL = nulIfArmNullableValueIx(exprIx)
  if nlIfL >= 0 {
    if exprNullableList(nlIfL, fnIx) { return true }
  }
  // An if-expression with a null arm over an i32-list arm — see `nulArmIfThenValueIx`.
  const elIfL = nulArmIfThenValueIx(exprIx)
  if elIfL >= 0 { return exprArray(elIfL, fnIx) }
  if e is Ident {
    if paramNulList(fnIx, e.identName) { return true }
    if declaredNulList(e.identName) { return true }
    // A captured `i32[] | null`: the env field is the same `(ref null $lTypeIdx)` cell, the
    // list twin of the `nulstr` capture arm and this arm's fourth storage class.
    if capturedKindOf(fnIx, e.identName) == "nullist" { return true }
    return globalIsNulListSid(fnIx, sidOfNode(exprIx))
  }
  if e is Member { return memberFieldCode(exprIx, fnIx) == 18 }
  // Indexing a `(i32[] | null)[]`, a ref list whose element slot keeps the `| null`, yields
  // a nullable i32 list: the read leaves `(ref null $lTypeIdx)`, so `if t != null` narrows.
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemNullable.length {
        if rlElemKindTbl[slot] == 4 && rlElemNullable[slot] == 1 { return true }
      }
    }
    // The map read is the same niche one container over (D1039): a read of a list-valued
    // map yields `i32[] | null` — a miss is the null — and the vals element is already
    // `(ref null $lTypeIdx)`. One arm covers the inline `if m[k] != null` and, through
    // `letIsNulListInfer`, the un-annotated binding; `nameIsI32Array` is rep-wide on purpose.
    const mvSh = mapShapeOfExpr(e.idxArr, fnIx)
    if mvSh >= 0 && mvSh < mvValName.length {
      if nameIsI32Array(mvValName[mvSh]) { return true }
      // D1107 — the value's own `| null`, which the name test cannot see: `mvValName` banks
      // the declared spelling, so `{[string]: i32[] | null}` reads `"i32[] | null"` and
      // `nameIsI32Array` declines it, while `globalCellKind` reads the element kind. Asked
      // of the element kind here too, so the cell and the read come from one home.
      if mvNulListValKind(mvSh) == "nullist" { return true }
    }
  }
  // A call whose annotated return is `i32[] | null` yields a nullable list, so an
  // un-annotated `const r = f(…)` infers the nullable-list kind and narrows with
  // `if r != null`. Mirrors the niche-nullable call inference for bool and string returns.
  if e is Call {
    // `xs.pop()` over an `i32[][]` — the member callee the Ident and closure legs below
    // cannot see (D1210).
    if popRefElemKind(exprIx, fnIx) == 4 { return true }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const target = fnIndexOfSid(sidOfNode(e.callFn))
      if target >= 0 {
        const fn = P.nodes[fnStmts[target]]
        if fn is FuncDecl {
          if fn.fnRet >= 0 { return retNulListFlag(fn.fnRet) == 1 }
        }
      }
      // A closure-value call whose resolved sig result is the nullable i32-backed list
      // (`>o`), so an un-annotated `const t0 = v()` infers the nullable-list kind and
      // narrows with `if t0 != null`.
      return calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "nullist"
    }
  }
  // `p ?? d` over the same niche stays `i32[] | null` exactly when the default can still be
  // null — the consumer half of `emitCoalesce`'s nullable-collection arm. `exprArray` claims
  // the rep in both halves; only the nullability is this classifier's question.
  const nlLhs = coalesceNicheLhs(exprIx)
  if nlLhs >= 0 {
    if exprNullableList(nlLhs, fnIx) {
      return coalesceNicheStaysNullable(exprIx, fnIx)
    }
  }
  false
}

// True if `exprIx` yields a nullable ref-array (`i32[][] | null`) — the ref-array analogue
// of `exprNullableList`. An `Index` over a `(T[] | null)[]`, a ref list whose element slot
// keeps the `| null`, reads `(ref null $innerWrapper)`, so `if t != null` narrows.
export function exprNullableRefArray(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Paren { return exprNullableRefArray(e.parInner, fnIx) }
  // An `if` whose arm is itself nullable — see `nulIfArmNullableValueIx` (D1560).
  const nlIfR = nulIfArmNullableValueIx(exprIx)
  if nlIfR >= 0 {
    if exprNullableRefArray(nlIfR, fnIx) { return true }
  }
  // An if-expression with a null arm over a ref-array arm — see `nulArmIfThenValueIx`.
  const elIfR = nulArmIfThenValueIx(exprIx)
  if elIfR >= 0 { return exprRefArray(elIfR, fnIx) }
  if e is Index {
    // The map read (D1039), the sibling of `exprNullableList`'s map arm, which carries the
    // reason one arm covers both the inline `if m[k] != null` and the un-annotated binding.
    const mvSh = mapShapeOfExpr(e.idxArr, fnIx)
    if mvSh >= 0 && mvSh < mvValName.length {
      if nameIsRefArray(mvValName[mvSh]) { return true }
      // D1107 — the ref twin of the `nullist` rung: a `{[string]: S[] | null}` value name
      // carries the `| null` the name test cannot read past.
      if mvNulListValKind(mvSh) == "nulreflist" { return true }
    }
  }
  if e is Ident {
    if declaredKind(e.identName) == "nulreflist" { return true }
    // A nulreflist param (`p: i32[][] | null`) — its `!= null` narrow reads the
    // `(ref null $wrapper)` niche exactly like the local.
    if paramNulRefArray(fnIx, e.identName) { return true }
    // A captured nulreflist binding, asked of the ladder that typed the env field, so the
    // `!= null` compare reads the `(ref null $wrapper)` niche instead of falling through to
    // the non-nullable path, where the bare `null` reaches `emitNullLitNode` with no seed.
    if capturedKindOf(fnIx, e.identName) == "nulreflist" { return true }
    // A module-global nulreflist binding, keyed on `globalCellKind` — the cell's own answer
    // — not on `letIsNulRefArray`, so the read and the cell can never disagree. For an
    // un-annotated global `letIsNulRefArray` claims it through the initializer while the
    // cell takes another kind, and that disagreement is invalid wasm; left refused.
    const gnra = globalLetOfIn(fnIx, e.identName)
    if gnra >= 0 { return globalCellKind(gnra) == "nulreflist" }
    return false
  }
  // A `recv.f` read of a nullable ref-list field (code 28) yields a nullable ref array.
  if e is Member { return memberFieldCode(exprIx, fnIx) == 28 }
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemNullable.length {
        if rlElemKindTbl[slot] == 9 && rlElemNullable[slot] == 1 { return true }
      }
    }
  }
  // A call whose annotated return is `<ref-array> | null` yields a nullable ref array, so an
  // un-annotated `const t = mk(…)` infers the kind and narrows with `if t != null`. Mirrors
  // the nullable-i32-list call inference in `exprNullableList`.
  if e is Call {
    // `g.pop()` over an `S[][]` — the nested-ref sibling of `exprNullableList`'s pop leg (D1210).
    if popRefElemKind(exprIx, fnIx) == 9 { return true }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if fnRetNulRefArrayNameSid(sidOfNode(e.callFn)) != "" { return true }
    }
  }
  // `p ?? d` over the same niche stays `<ref-array> | null` exactly when the default can
  // still be null — the consumer half of `emitCoalesce`'s nullable-collection arm for the
  // ref-array family; `exprRefArray` claims the rep in both halves.
  const nraLhs = coalesceNicheLhs(exprIx)
  if nraLhs >= 0 {
    if exprNullableRefArray(nraLhs, fnIx) {
      return coalesceNicheStaysNullable(exprIx, fnIx)
    }
  }
  false
}

// The inner ref-list slot of a nullable ref-array expression — a local stores it in
// `localStructIdx`; an `Index` over a `(<ref-array> | null)[]` resolves it from the
// ref-array element, whose inner name recurses through the `| null`.
function nulRefArrayInnerSlot(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = P.nodes[exprIx]
  if e is Paren { return nulRefArrayInnerSlot(e.parInner, fnIx) }
  // The slot half of `exprNullableRefArray`'s if-expression rung (D1560) — read off the arm
  // the kind comes from, or the binding takes slot -1 and `fbValtypeNullable` has no shape
  // to name.
  if e is IfStmt { return nulRefArrayInnerSlot(ifRepArmValueIx(exprIx), fnIx) }
  if e is Ident {
    const sl = declaredSlotOf(e.identName)
    if sl >= 0 { return localStructIdx[sl] }
    // A nulreflist param has no local slot — resolve its inner ref-list slot from the
    // annotation's interned row, so `p[i]` and `const t = p` agree.
    if paramNulRefArray(fnIx, e.identName) {
      // The param annotation's inner ref-list row — the read counterpart of
      // `nulRefArrayInnerSlotOfLet`'s local store, so a `p[i]` read and a `const t = p`
      // binding keep resolving the same row.
      return annNulRefArrSlot(paramTypeNode(fnIx, e.identName))
    }
    // A captured nulreflist binding has no local slot either — its inner ref-list row is the
    // one that typed the env field, so the read round-trips to the wrapper the field holds.
    const cnris = capturedRefListSlot(fnIx, e.identName)
    if cnris >= 0 { return cnris }
    // A module global has no local slot either — resolve its inner ref-list row from the same
    // place `emitGlobalSection` gives the cell its `(ref null …)` valtype, so an un-annotated
    // `const t = g` binding stores the wrapper the cell holds rather than slot -1.
    const gnris = globalLetOfIn(fnIx, e.identName)
    if gnris >= 0 {
      if globalCellKind(gnris) == "nulreflist" {
        return letAnnRefListSlot(gnris)
      }
    }
    return -1
  }
  // A code-28 nullable ref-list field member: its element ref-list slot (the field's element name).
  if e is Member {
    if memberFieldCode(exprIx, fnIx) == 28 {
      return refListSlotOfExpr(exprIx, fnIx)
    }
    return -1
  }
  if e is Index {
    const slot = refListSlotOfExpr(e.idxArr, fnIx)
    if slot >= 0 && slot < rlElemName.length { return rlElemInnerSlot(slot) }
  }
  // A nulreflist-returning call: its inner ref-list slot is the return's inner element.
  if e is Call {
    // `g.pop()` over an `S[][]`: the popped element is the inner ref list, so the row is the
    // receiver slot's inner one — the same answer the `Index` arm gives (D1210).
    const pes = popRefRecvSlot(exprIx, fnIx)
    if pes >= 0 && pes < rlElemName.length { return rlElemInnerSlot(pes) }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const rn = fnRetNulRefArrayNameSid(sidOfNode(e.callFn))
      if rn != "" { return rlSlotByName(rn) }
    }
  }
  // `p ?? d` over the same niche yields the left place's inner ref list, so an inferred
  // `const v = p ?? q` stores the row `emitCoalesce` declares its block type from. Without
  // it the binding takes slot -1 and `fbValtypeNullable` has no shape to name.
  const nriLhs = coalesceNicheLhs(exprIx)
  if nriLhs >= 0 { return nulRefArrayInnerSlot(nriLhs, fnIx) }
  -1
}

// Binding test for a kind-18 nullable ref-array local: annotation `<ref-array> | null`, else an
// un-annotated init that yields a nullable ref array.
export function letIsNulRefArray(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // The nullable annotation's inner element row — the read counterpart of
        // `nulRefArrayInnerSlotOfLet`'s slot; both must agree on which bindings are kind 18.
        if annNulRefArrSlot(d.letType) >= 0 { return true }
      }
      return false
    }
    return exprNullableRefArray(d.letInit, fnIx)
  }
  false
}

// The inner ref-list slot to store for a kind-18 binding — from its annotation (`<ref-array> | null` →
// the ref-array's element slot) or its initializer.
export function nulRefArrayInnerSlotOfLet(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = P.nodes[d.letType]
      if lt is TypeRef {
        // The annotation's inner ref-list row — the write half of the pair whose read is
        // `nulRefArrayInnerSlot`.
        return annNulRefArrSlot(d.letType)
      }
      return -1
    }
    return nulRefArrayInnerSlot(d.letInit, fnIx)
  }
  -1
}

// Annotation-or-init nullable-i32-list test for a binding: the annotation (`letIsNulList`),
// else an un-annotated `const t = <nullable-i32-list expr>`. Without the init inference such
// a binding takes a non-null list kind and `t != null` emits a bare `null` with no list
// context. Mirrors `letIsNulString`'s init fallback for nullable strings.
export function letIsNulListInfer(letIx: i32, fnIx: i32) {
  if letIsNulList(letIx, fnIx) { return true }
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType < 0 { return exprNullableList(d.letInit, fnIx) }
  }
  false
}

// The distinct-backing nullable-scalar-list `VKind` of a binding (`const v: string[] | null`),
// or null — the annotation's `nulScalarListKind`, else an un-annotated init that yields such
// a list. Feeds the local-slot and null-seed classification.
export function letNulScalarListKind(letIx: i32, fnIx: i32): VKind | null {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return nulScalarListKindOfNode(d.letType) }
    return exprNulScalarListKind(d.letInit, fnIx)
  }
  null
}

// The nullable-scalar-list `VKind` an expression yields, or null — the per-leaf analogue of
// `exprNullableList`'s call-inference arm (an un-annotated `const r = f()`).
export function exprNulScalarListKind(exprIx: i32, fnIx: i32): VKind | null {
  if exprIx < 0 { return null }
  const e = P.nodes[exprIx]
  if e is Paren { return exprNulScalarListKind(e.parInner, fnIx) }
  // An `if` whose arm is itself nullable — see `nulIfArmNullableValueIx` (D1560).
  const nlIfK = nulIfArmNullableValueIx(exprIx)
  if nlIfK >= 0 {
    const nlk = exprNulScalarListKind(nlIfK, fnIx)
    if nlk != null { return nlk }
  }
  // An if-expression with a null arm over a distinct-backing scalar-list arm — see
  // `nulArmIfThenValueIx`. The four leaf kinds in `ifExprRefKind`'s own order.
  const elIfK = nulArmIfThenValueIx(exprIx)
  if elIfK >= 0 {
    if exprStringArray(elIfK, fnIx) { return "nulstrlist" }
    if exprF32Array(elIfK, fnIx) { return "nulf32list" }
    if exprF64Array(elIfK, fnIx) { return "nulf64list" }
    if exprI64Array(elIfK, fnIx) { return "nuli64list" }
    return null
  }
  if e is Index {
    // The map read (D1039), the sibling of `exprNullableList`'s map arm, which carries the
    // reason one arm covers both the inline `if m[k] != null` and the un-annotated binding.
    const mvSh = mapShapeOfExpr(e.idxArr, fnIx)
    if mvSh >= 0 && mvSh < mvValName.length {
      // The nullable spelling, because that is what `nulScalarListKind` reads: it runs
      // `nullablePartOf`, which answers "" for a name with no top-level `|`. The mv slot
      // banks the value's non-null name, and the read's niche is that name's `| null` twin.
      const slk = nulScalarListKind(mvValName[mvSh] + "|null")
      if slk != null { return slk }
      // D1107 — the element-kind rung, for a value spelling that already carries `| null`:
      // the `+ "|null"` above then builds a doubled suffix and `nullablePartOf` answers for
      // neither leaf. Same one home as the `nullist` and `nulreflist` siblings.
      const mvSlk = mvNulListValKind(mvSh)
      if isNulScalarListKind(mvSlk) { return mvSlk }
    }
  }
  if e is Ident {
    // A nullable-scalar-list param, a same-kind local (`const t0 = v`), a capture, or a
    // global cell — the four storage classes a binding of this niche can have.
    const pk = nulScalarListKindOfNode(paramTypeNode(fnIx, e.identName))
    if pk != null { return pk }
    const dk = declaredKind(e.identName)
    if isNulScalarListKind(dk) { return dk }
    // A captured leaf-list cell, asked of the ladder that typed the env field, so the read
    // and the field can never disagree about the wrapper. The `nullist`, `nulreflist` and
    // `nulvariant` arms of the sibling classifiers are the same rung on other niches.
    const ck = capturedKindOf(fnIx, e.identName)
    if isNulScalarListKind(ck) { return ck }
    const gl = globalLetOfIn(fnIx, e.identName)
    if gl >= 0 { return letNulScalarListKind(gl, fnIx) }
  }
  if e is Call {
    // `xs.pop()` over a `string[][]` / `f64[][]` / `i64[][]` / `f32[][]` — the
    // distinct-backing siblings of `exprNullableList`'s pop leg (D1210).
    const pek = popRefElemKind(exprIx, fnIx)
    if pek == 6 { return "nulstrlist" }
    if pek == 7 { return "nulf64list" }
    if pek == 8 { return "nuli64list" }
    if pek == 10 { return "nulf32list" }
    if pek == 11 { return "nulu8list" }
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      const target = fnIndexOfSid(sidOfNode(e.callFn))
      if target >= 0 {
        const fn = P.nodes[fnStmts[target]]
        if fn is FuncDecl {
          if fn.fnRet >= 0 { return nulScalarListKindOfNode(fn.fnRet) }
        }
      }
    }
  }
  // A field read of a nullable distinct-backing scalar list (codes 31 to 34) yields the
  // leaf's `(ref null $wrapper)`, so an un-annotated `const l = s.f` binds the matching
  // nullable local kind and `l != null` narrows it. The dual of the code-18 `Member` arm.
  if e is Member { return nulScalarListCodeKind(memberFieldCode(exprIx, fnIx)) }
  // Indexing a `(f64[] | null)[]`, a ref list whose element slot keeps the `| null`, yields
  // the nullable leaf list: the read leaves `(ref null $wrapper)`, so `if t != null` narrows.
  // The distinct-backing dual of `exprNullableList`'s `Index` arm.
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemNullable.length {
        if rlElemNullable[slot] == 1 {
          const k = rlElemKindTbl[slot]
          if k == 6 { return "nulstrlist" }
          if k == 7 { return "nulf64list" }
          if k == 8 { return "nuli64list" }
          if k == 10 { return "nulf32list" }
          if k == 11 { return "nulu8list" }
        }
      }
    }
  }
  // `p ?? d` over the same niche stays the nullable leaf list exactly when the default can
  // still be null — the consumer half of `emitCoalesce`'s nullable-collection arm for the
  // distinct-backing family; the non-null half is the leaf list.
  const nskLhs = coalesceNicheLhs(exprIx)
  if nskLhs >= 0 {
    if coalesceNicheStaysNullable(exprIx, fnIx) {
      return exprNulScalarListKind(nskLhs, fnIx)
    }
  }
  null
}

// ── nullable-string (`string | null`) predicates — the ref-rep analogue of the
// nullable-list family: `null` is `ref.null $aTypeIdx` and `!= null` is `ref.is_null`.
// Unlike a nullable list an initializer can produce one, so `letIsNulString` consults it.
export function declaredNulString(name: string) {
  declaredKind(name) == "nulstr"
}

function globalIsNulStringSid(fnIx: i32, sid: i32) {
  const li = globalLetOfSidIn(fnIx, sid)
  if li < 0 { return false }
  letIsNulString(li, -1)
}

function fnRetNulStringSid(sid: i32) {
  const i = fnIndexOfSid(sid)
  if i < 0 { return false }
  fRetKind[i] == "nulstr"
}

export function letIsNulString(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      if retNulStringFlag(d.letType) == 1 { return true }
    }
    if d.letType < 0 {
      // An un-annotated `const x = if c then "hi" else null` infers `string | null`, a niche
      // the emitter cannot derive from the if-expression arms. The checker typed it and
      // exported the binding by node index, so consult that before the init-shape probe.
      if isInferLetNulStr(letIx) { return true }
      return exprNullableString(d.letInit, fnIx)
    }
  }
  false
}

// True if evaluating the expression at `exprIx` yields a `string | null` ref — a
// nullable-string param/local/global, or a `: string | null`-returning call. Consulted
// by the `!= null` `ref.is_null` path and the assignment/return/arg null-seeding.
export function exprNullableString(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  // An if-expression whose arm is itself nullable — see `nulIfArmNullableValueIx` (D1560).
  const nlIfStr = nulIfArmNullableValueIx(exprIx)
  if nlIfStr >= 0 {
    if exprNullableString(nlIfStr, fnIx) { return true }
  }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is AsExpr { return nodeTyIsNulString(unwrapParen(exprIx)) }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if fnRetNulStringSid(sidOfNode(e.callFn)) { return true }
      // A `string | null`-returning function value (a binding, or a `(…) => string | null`
      // param callee) — its result is the nullable raw array, `>N`.
      return calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "nulstr"
    }
    // A `string | null`-returning field-closure call.
    if callee is Member {
      const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if ffe >= 0 { return fRetKind[ffe] == "nulstr" }
    }
    // Fallback, scoped to a call: a `string | null`-returning closure value call whose callee
    // the cases above miss, such as an indexed closure-array element. `nodeTyIsNullableString`
    // reads the checker's per-node type without rendering it.
    return nodeTyIsNullableString(exprIx)
  }
  if e is Ident {
    if paramNulString(fnIx, e.identName) { return true }
    if declaredNulString(e.identName) { return true }
    // A captured `string | null`: the env field is the same `(ref null $array)` cell, so it
    // classifies like the param or local. This is what reconciles the classifier with
    // `emitCapturedReadRecover`, which recovers off that field under the same gates.
    if capturedKindOf(fnIx, e.identName) == "nulstr" { return true }
    return globalIsNulStringSid(fnIx, sidOfNode(unwrapParen(exprIx)))
  }
  // A `string | null` struct field read (`a.v`, code 20) yields a nullable string ref.
  if e is Member { return memberFieldCode(exprIx, fnIx) == 20 }
  // A `?.` over a nullable struct whose leaf field is a string — plain or already nullable —
  // is `string | null`, the same niche `emitOptMemberValue`'s `nulstr` arm builds. Saying so
  // here routes `(x?.y) ?? "z"` through the string-niche `??` core and gives `print` and an
  // un-annotated binding the string rep (D802).
  if e is OptMember {
    const occ = optChainLeafFieldCode(exprIx, fnIx)
    return occ == 3 || occ == 20
  }
  // A bare `m[k]` over a string-valued map is `string | null` — `emitMapGet` yields the
  // `(ref null)` value unrecovered, the string dual of the bare struct-map read.
  if e is Index {
    const mrs = mapReadMvSlot(exprIx, fnIx)
    if mrs >= 0 { return mvValKind[mrs] == 3 }
    // A `(string | null)[]` element read yields `string | null` — the string-ref niche kept
    // `(ref null $aTypeIdx)` by the dedicated `emitIndex` arm — so `const t = p[i]` binds the
    // nullable-string kind and `t != null` narrows against it.
    if exprNulStrArray(e.idxArr, fnIx) { return true }
  }
  // A chained `a ?? b` over nullable strings is itself nullable-string when the default `b`
  // is also nullable — the left-associative `(f() ?? g()) ?? d` shape, where the classifier
  // sees the nested `??` as `binLeft` before `emitExpr` re-associates it. Keeps print
  // routing and `exprString` consistent with the emitted rep.
  if e is BinExpr {
    if e.binOp == "??" {
      // A fused read over a nullable-string-valued map stays `string | null` only when the
      // default is itself nullable — a non-null default coalesces every null, stored
      // included, to a non-null string.
      const cns = coalesceMvSlot(exprIx, fnIx)
      if cns >= 0 {
        if mvValKind[cns] == 3 && coalesceStaysNullable(exprIx, cns, fnIx) {
          return true
        }
      }
      if exprNullableString(e.binLeft, fnIx) {
        if exprNullableString(e.binRight, fnIx) { return true }
        // A bare `null` default is nullable too (D801): `exprNullableString` alone answers
        // only for a default that is itself a nullable string, so `s ?? null` reads as
        // non-null and the lowering declares a `(ref $aTypeIdx)` block.
        // `coalesceDefaultNullable` is the one nullability decision every other `??` arm takes.
        return coalesceDefaultNullable(e.binRight, fnIx)
      }
    }
  }
  false
}

// The base struct index of a nullable-struct `LetDecl`: the annotation's base, or the
// initializer's resolved struct. The annotated leg takes the same `??` merge redirect the
// map's value slot takes (D842) — `anonLeafSupersedeOf` answers `si` unchanged for every row
// outside a merge family, so it is one bounds-checked array read everywhere else.
export function nulRefStructIdxOfLet(letIx: i32, fnIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const ri = retNulRefIndex(d.letType)
      if ri >= 0 { return anonLeafSupersedeOf(ri) }
    }
    // The init leg is deliberately not redirected: an un-annotated nullable-struct binding
    // takes its row from the callee's return, and no `??` family can have superseded that row
    // — the join reader sees a declaration whose initializer is a call, not a literal, so the
    // merge never runs. It becomes live only with a reader that sees into a callee (D861).
    return structIndexOfExpr(d.letInit, fnIx)
  }
  -1
}

// True if evaluating the expression at `exprIx` yields a nullable struct ref — a
// nullable-annotated param, local or global reference, or a `S | null`-returning call.
export function exprNullableStruct(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = P.nodes[exprIx]
  if e is Paren { return exprNullableStruct(e.parInner, fnIx) }
  // An `if` whose arm is itself nullable — see `nulIfArmNullableValueIx` (D1560). Asked
  // first because the rung below returns whatever its non-null predicate says, and a
  // `S | null`-returning call arm answers no to that one.
  const nlIfS = nulIfArmNullableValueIx(exprIx)
  if nlIfS >= 0 {
    if exprNullableStruct(nlIfS, fnIx) { return true }
  }
  // An if-expression with a null arm over a struct arm — see `nulArmIfThenValueIx`.
  const elIfS = nulArmIfThenValueIx(exprIx)
  if elIfS >= 0 { return structIndexOfExpr(elIfS, fnIx) >= 0 }
  // `x as? S` over a union yields `S | null`, the nullable struct ref. The `AsExpr` twin of
  // the `exprNullableString` arm; both read the cast's own recorded type, which for the
  // coalescing member is the nullable result.
  if e is AsExpr { return retNulRefFlag(exprIx) == 1 }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      if fnRetNulRefSid(sidOfNode(e.callFn)) { return true }
      // An `S | null`-returning function value (a binding, or a `(…) => S | null` param
      // callee) — its result is the nullable struct ref, `>nN;`.
      if calleeRetKindSid(sidOfNode(e.callFn), fnIx) == "nulstruct" {
        return true
      }
    }
    // An `S | null`-returning field-closure call.
    if callee is Member {
      const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if ffe >= 0 && fRetKind[ffe] == "nulstruct" { return true }
    }
    // `xs.pop()` and `xs.get(i)` over a struct-element ref list yield `S | null` — a pop of
    // an empty list and an out-of-range get are both null.
    if structListPopGetElem(exprIx, fnIx) >= 0 { return true }
    // Fallback, scoped to a call: a nullable-struct-returning closure value call whose callee
    // the cases above miss, such as an indexed closure-array element.
    // `nodeTyIsNullableStruct` reads the checker's per-node type without rendering it, so
    // `letIsNulRef` classifies such a binding nullable and its `!= null` narrow gets context.
    return nodeTyIsNullableStruct(exprIx)
  }
  if e is Ident {
    if paramNulRef(fnIx, e.identName) { return true }
    if declaredNulRef(e.identName) { return true }
    // A captured nullable struct: the env field is `(ref null $S)`, so classify it nullable,
    // else `p != null` reads as struct equality. The struct index resolves through
    // `capturedStructIndex`.
    if capturedKindOf(fnIx, e.identName) == "nulstruct" { return true }
    return globalIsNulRefSid(fnIx, sidOfNode(exprIx))
  }
  // A nested-struct field read (code 15) is stored `(ref null $S)`: an `S | null` field
  // genuinely carries null, and a plain `inner: S` field shares the nullable storage, so
  // the read is nullable-classified and the consumer inserts `ref.as_non_null` before a
  // chained field access.
  if e is Member {
    if memberFieldCode(exprIx, fnIx) != 15 { return false }
    // A code-15 field whose target is a union arm stores `(ref null $uVarHeap[vi])`, not
    // `(ref null $S)`, and the variant twin owns it. Declining here keeps the two twins
    // from both answering yes about one read (D1150).
    return memberNulVariantRow(exprIx, fnIx) < 0
  }
  // The `?.` spelling of the same read (D1084): `o?.f` over a code-15 field is `S | null`
  // for the second reason as well as the first — the chain itself can be null — so it is
  // nullable-classified wherever `o.f` is, which is what makes the un-annotated spelling
  // work. `optChainStructIdxOf` is the resolver the emitter uses at this node.
  if e is OptMember {
    const oNsi = optChainStructIdxOf(e.omObj, fnIx)
    if oNsi >= 0 {
      const oNfi = sFieldIndex(oNsi, e.omProp)
      if oNfi >= 0 { return sFieldTypeAt(oNsi, oNfi) == 15 }
    }
    return false
  }
  // An index into a nullable-struct array (`(P | null)[]`) yields `P | null` — the element
  // legitimately holds null, so the read is not recovered to non-null as a `P[]` element
  // is. `const e = xs[i]` binds the nullable-struct niche.
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      // Guard the slot: a narrowed union-arm rebind receiver classifies `exprRefArray` true
      // while the slot resolver can still miss, and an unguarded `rlElemKindTbl[-1]` is an
      // out-of-bounds crash in the compiler itself.
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemKindTbl.length {
        if rlElemKindTbl[slot] == 1 {
          // The element must be a struct row, not a union arm (D851): a `(Circle | null)[]`
          // whose `Circle` is a declared union's member also interns kind 1, and its element
          // heap is `uVarHeap[vi]` rather than `sHeapIdx`, so claiming it here binds the read
          // to a `nulstruct` local whose struct row does not exist.
          if rlElemVariantRow(slot) < 0 {
            if rlElemIsNulNiche(slot) { return true }
          }
        }
      }
    }
    // A bare `m[k]` over a struct-valued map is `S | null`: the `vals` slot is
    // `(ref null $S)` and `emitMapGet` yields it unrecovered, a miss being `ref.null`. So
    // `const v = m[k]` binds the nullable-struct niche; a `?? d` read over a non-null value
    // stays the non-null struct, which the `BinExpr` arm settles.
    const mrs = mapReadMvSlot(exprIx, fnIx)
    if mrs >= 0 { return mvValKind[mrs] == 1 }
  }
  // A `m[k] ?? d` read over a nullable-struct-valued map stays `S | null` only when the
  // default is itself nullable; a non-null default coalesces every null, stored included,
  // to the non-null struct, which `exprStruct` claims.
  if e is BinExpr {
    const cns = coalesceMvSlot(exprIx, fnIx)
    if cns >= 0 {
      return mvValKind[cns] == 1 && coalesceStaysNullable(exprIx, cns, fnIx)
    }
    // The non-map `??` over the same niche obeys the identical rule — the consumer half of
    // the decision `emitCoalesce`'s nullable-struct arm makes. Without it an un-annotated
    // `const nv = p ?? q` binds a non-null struct cell and its `nv != null` lowers as struct
    // equality, while an annotated consumer takes the `(ref null $S)` cell.
    if e.binOp == "??" {
      if exprNullableStruct(e.binLeft, fnIx) {
        return coalesceDefaultNullable(e.binRight, fnIx)
      }
    }
  }
  false
}

// The arena index of the expression an un-annotated function returns: the body's trailing
// tail-value statement, or the first valued `return`'s argument, walking into if, while and
// for bodies. -1 when the function yields nothing.
export function fnRetExprOf(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const b = P.nodes[fn.fnBody]
    if b is Block {
      const stmts = b.blkStmts
      if stmts.length > 0 {
        const last = stmts[stmts.length - 1]
        if stmtIsTailValue(last, fnIx) { return last }
      }
    }
    return firstValuedReturn(fn.fnBody)
  }
  -1
}

// The map shape of a return expression, resolved from annotations only, so it is valid at
// the type-section emit before locals are collected and from a different function. -1, the
// mono map, for anything no rung claims. `fe` is the enclosing function's `fnStmts`
// position, not its arena index, which is what the capture arm below needs.
export function mapRetExprShape(rx: i32, fe: i32) {
  const fnIx = fnStmts[fe]
  let u = rx
  let done = false
  while !done {
    const node = P.nodes[u]
    if node is Paren { u = node.parInner } else { done = true }
  }
  const e = P.nodes[u]
  if e is Ident {
    if paramMap(fnIx, e.identName) { return paramMapShape(fnIx, e.identName) }
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      const li = parentLetOf(fn.fnBody, e.identName)
      if li >= 0 {
        const d = P.nodes[li]
        if d is LetDecl {
          if d.letType >= 0 { return mapAnnShape(d.letType) }
        }
      }
    }
  }
  if e is Call {
    const callee = P.nodes[e.callFn]
    if callee is Ident {
      // A bare `Map()` or `Set()` returned straight out carries no spelling — neither value
      // type nor key rep — so it falls to the recorded ladder at the bottom rather than
      // short-circuiting to the string-keyed mono sentinel; `-1` and `-4` are two structs.
      if callee.identName != "Map" && callee.identName != "Set" {
        return fnRetMapShapeAt(sidOfNode(e.callFn), u)
      }
    }
  }
  // A captured map return: the ident is neither a param nor a local of this function, so the
  // arms above miss it. Resolve its shape from the capture, the same `captureValStructIdx`
  // the env field uses, so the functype result heap type matches the field and the value.
  const cap = retCapturedMapShape(fe, rx)
  if cap != -3 { return cap }
  // Fallback: the map type the checker recorded on the returned expression. Every rung above
  // reads a spelling and an inferred map has none. The mint side reads this same recorded
  // type, so the slot found here is the one the type section interned, which keeps the
  // functype result valtype and the caller's receiver shape naming one struct.
  if nodeTyIsMap(u) { return mapFindShapeOfNodeTy(u) }
  -1
}

// The map shape of a return expression that is a captured map variable, as the mv slot
// (mono is -1), or -3 when the return is not a captured map. `captureNamesOf` is the source
// of truth, so a same-named local or param shadowing a capture stays with the local arms.
// The `parentBindingOf` pre-gate is the cheap half of the conjunction, taken first.
function retCapturedMapShape(fe: i32, rx: i32): i32 {
  let u = rx
  let done = false
  while !done {
    const node = P.nodes[u]
    if node is Paren { u = node.parInner } else { done = true }
  }
  const e = P.nodes[u]
  if e is Ident {
    if fe >= 0 && parentBindingOf(fe, e.identName) >= 0 {
      const caps = captureNamesOf(fe)
      let ci = 0
      while ci < caps.length {
        if caps[ci] == e.identName {
          if captureValKind(fe, e.identName) == "map" {
            return captureValStructIdx(fe, e.identName)
          }
          return -3
        }
        ci = ci + 1
      }
    }
  }
  -3
}

// True if `rx` returns a body-declared map local whose value type the mv layer can lower.
// The local's kind is not collected during the global return pass, so neither `exprMap` nor
// any Ident classifier can see it; this reads the declaration instead, and it is what puts
// `"map"` in `fRetKind`.
function retIsMapLocal(rx: i32, fnIx: i32) {
  let u = rx
  let done = false
  while !done {
    const node = P.nodes[u]
    if node is Paren { u = node.parInner } else { done = true }
  }
  const e = P.nodes[u]
  if e is Ident {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      const li = parentLetOf(fn.fnBody, e.identName)
      if li >= 0 {
        const d = P.nodes[li]
        if d is LetDecl {
          if d.letType >= 0 {
            const lt = P.nodes[d.letType]
            if lt is TypeRef {
              // The arena: a `TyMap` annotation, never the union box a map-first spelling
              // can fool `nameIsMap` into claiming.
              if nodeTyIsMap(d.letType) {
                // A supported map value type, asked of the arena — the same call the
                // un-annotated leg makes. The return's shape is recovered at the
                // functype-result site through `mapShapeOfExpr` over this same local.
                return mapNodeValKindLowerable(d.letType)
              }
            }
            return false
          }
          // An un-annotated map local has no annotation for the rung above to read: the
          // checker's recorded type on the returned ident is the only spelling of it.
          // Unclassified, the functype result stays at the `"i32"` default over a body that
          // returns a map ref, while the caller resolves the same recorded type.
          if nodeTyIsMap(u) { return mapNodeValKindLowerable(u) }
        }
      }
    }
  }
  false
}

// The parent-`let` arena index a returned bare ident names in the body at `bodyIx`, or -1.
// The alias hop is part of the lookup because this pass is global: an init that is itself a
// bare local ident is the same miss one hop in (D41). Only an un-annotated link is followed,
// since an annotation pins the cell's rep. One home, so its callers cannot drift apart.
export function retLocalLetOfBlock(bodyIx: i32, rx: i32) {
  const u = unwrapParen(rx)
  const e = P.nodes[u]
  if e is Ident {
    let li = parentLetOf(bodyIx, e.identName)
    let hops = 0
    while li >= 0 && hops < 8 {
      const d = P.nodes[li]
      if d is LetDecl {
        if d.letType >= 0 { return li }
        const iv = P.nodes[unwrapParen(d.letInit)]
        if iv is Ident {
          const nx = parentLetOf(bodyIx, iv.identName)
          if nx < 0 { return li }
          if nx == li { return li }
          li = nx
          hops = hops + 1
        } else {
          return li
        }
      } else {
        return li
      }
    }
    return li
  }
  -1
}

function criRetLocalLet(rx: i32, i: i32) {
  const fn = P.nodes[fnStmts[i]]
  if fn is FuncDecl { return retLocalLetOfBlock(fn.fnBody, rx) }
  -1
}

// The node an empty-`[]` hole must be read off for return `rx` of function `i` — the return
// expression when that is the literal, else the initializer of the local it names (D626).
// It routes through `retLocalLetOfBlock`, which hops un-annotated alias chains and stops at
// an annotated binding, whose annotation has already decided the cell's rep.
function criRetHoleNode(rx: i32, i: i32) {
  if emptyArrLitIxOf(rx) >= 0 { return rx }
  const rll = criRetLocalLet(rx, i)
  if rll < 0 { return rx }
  const d = P.nodes[rll]
  if d is LetDecl {
    if d.letType >= 0 { return rx }
    return d.letInit
  }
  rx
}

// The ident name that function `fe`'s implicit return assigns to, or "": `fe` is
// un-annotated and its body's last statement is `<name> = <rhs>`. The one place that decides
// which assignment is the implicit return. The target and not the rhs, because the `=` arm
// lowers store-then-re-read, so the value left on the stack is the target cell's rep.
function fnAssignRetTargetName(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return "" }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    // An annotated return already drives the functype from its annotation — leave it alone.
    if fn.fnRet >= 0 { return "" }
    const b = P.nodes[fn.fnBody]
    if b is Block {
      const st = b.blkStmts
      if st.length > 0 {
        // The tail statement, and for the explicit spelling `return (g = e)` the returned
        // expression inside it. Both reach `emitBinExprNode`'s `=` arm and both become the
        // function's result, so both take the cell's answer.
        let tailx = st[st.length - 1]
        const ts = P.nodes[tailx]
        // A tail `if` whose arms each end in an assignment is the same implicit return split
        // across branches: every arm pushes its own target cell's rep. `ifTailAssignName`
        // joins them to one representative name, minted only when every arm's target cell
        // has the same result identity, so the dispatch below stays a plain cell answer.
        if ts is IfStmt { return ifTailAssignName(tailx, fnStmts[fe]) }
        if ts is RetStmt {
          if ts.retArg < 0 { return "" }
          tailx = ts.retArg
        }
        const a = P.nodes[unwrapParen(tailx)]
        if a is BinExpr {
          if a.binOp == "=" {
            const t = P.nodes[unwrapParen(a.binLeft)]
            if t is Ident { return t.identName }
          }
        }
      }
    }
  }
  ""
}

// The `Param` node of function `fnIx` named `name`, or -1.
function fnParamNodeOf(fnIx: i32, name: string) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const ps = fn.fnParams
    let i = 0
    while i < ps.length {
      const p = P.nodes[ps[i]]
      if p is Param {
        if p.parName == name { return ps[i] }
      }
      i = i + 1
    }
  }
  -1
}

// The `fbValtype` kind an un-annotated binding's initializer decides, through the same
// per-`let` predicates `collectLocals` types the binding with and in the same order — the one
// home of that ladder, shared by `captureValKind` and `letCellKind`. `"i32"` when no arm
// claims it. A missing nullable arm types the env field at the non-null kind (D21).
function letInitCellKind(letIx: i32, fnIx: i32): VKind {
  // A never-filled `let x = null` is the `null` type, cell `nullref` — first, as in
  // `collectLocals` (D1576). This is what types a captured such binding's env field; without
  // it the field is an i32 holding 0 and the lambda reads a present value out of it.
  if letIsNulNone(letIx, fnIx) { return "nulnone" }
  // A literal-union binding is an i32-backed interned atom, not a value-union box — first,
  // ahead of `letIsVariant`, `letIsUnion` and `letIsString`.
  if letIsLitUnion(letIx) || letInitIsLitAtom(letIx, fnIx) { return "i32" }
  // The `K | null` niche: the same i32 atom with the spare `-1` for null. Before
  // `letIsNulString`, since a litunion softens to `string`.
  if letNulLitUnion(letIx, fnIx) { return "i32" }
  // A nullable map, before `letIsMap`, whose `(ref $mapStruct)` cell cannot hold null.
  if letIsNulMap(letIx, fnIx) { return "nulmap" }
  // A bare `const t = m[k]` read of a list- or nested-map-valued map binds the value's
  // established nullable kind, a union-valued one the shared box. Both before `letIsMap`.
  const nmrK = letNulMapReadValKind(letIx, fnIx)
  if nmrK != null { return nmrK }
  if letNulMapReadUnionBox(letIx, fnIx) { return "union" }
  if letIsMap(letIx, fnIx) { return "map" }
  // The nullable variant niche, before `nulstruct`: `collectS` refuses a variant its own
  // struct row, so the two cannot share an index space.
  if letIsNulVariant(letIx, fnIx) { return "nulvariant" }
  if letIsNulRef(letIx, fnIx) { return "nulstruct" }
  // The nullable lists, each before its non-null twin.
  if letIsNulListInfer(letIx, fnIx) { return "nullist" }
  const nulSLK = letNulScalarListKind(letIx, fnIx)
  if nulSLK != null { return nulSLK }
  if (
    letIsStringArray(letIx, fnIx) &&
    !letIsUnion(letIx, fnIx) &&
    !letIsNulRefArray(letIx, fnIx)
  ) {
    return "strlist"
  }
  if (
    letIsU8Array(letIx, fnIx) &&
    !letIsUnion(letIx, fnIx) &&
    !letIsNulRefArray(letIx, fnIx)
  ) {
    return "u8list"
  }
  if (
    letIsF32Array(letIx, fnIx) &&
    !letIsUnion(letIx, fnIx) &&
    !letIsNulRefArray(letIx, fnIx)
  ) {
    return "f32list"
  }
  if (
    letIsF64Array(letIx, fnIx) &&
    !letIsUnion(letIx, fnIx) &&
    !letIsNulRefArray(letIx, fnIx)
  ) {
    return "f64list"
  }
  if (
    letIsI64Array(letIx, fnIx) &&
    !letIsUnion(letIx, fnIx) &&
    !letIsNulRefArray(letIx, fnIx)
  ) {
    return "i64list"
  }
  if letIsNulRefArray(letIx, fnIx) { return "nulreflist" }
  if letIsRefArray(letIx, fnIx) && !letIsUnion(letIx, fnIx) { return "reflist" }
  // The nullable closure fat-pointer, before `letIsUnion` (the `fn | null` annotation reads
  // as a union name) and before the non-null closure.
  if letIsNulClosure(letIx, fnIx) || letInfersNulClosure(letIx, fnIx) {
    return "nulclosure"
  }
  if letIsVariant(letIx, fnIx) { return "variant" }
  if letIsUnion(letIx, fnIx) { return "union" }
  if letIsStruct(letIx, fnIx) {
    // Mirrored from `collectLocals`' own struct arm (D51): where the struct table has no row
    // for the literal's field set and a union arm is the only claimant, the kind is
    // `"variant"`. The kind selects the table — `fbValtype` reads `sHeapIdx` for a struct
    // and `uVarHeap` for a variant — so the flip has to happen here or the slot is wrong.
    if structIndexOfLet(letIx, fnIx) < 0 {
      if letObjLitVariantIdx(letIx) >= 0 { return "variant" }
    }
    return "struct"
  }
  if letIsArray(letIx, fnIx) { return "list" }
  if letIsNulString(letIx, fnIx) { return "nulstr" }
  if letIsString(letIx, fnIx) { return "str" }
  if letIsI64(letIx, fnIx) { return "i64" }
  if letIsF32(letIx) || letInfersF32(letIx, fnIx) { return "f32" }
  if letIsF64(letIx, fnIx) { return "f64" }
  if letIsClosure(letIx, fnIx) { return "closure" }
  // The `boolean | null` niche — a plain i32 to `fbValtype`, but a dedicated kind so the
  // sentinel-2 rep is reachable and a later `x = null` stays valid.
  if letNulBool(letIx, fnIx) { return "nulbool" }
  "i32"
}

// The `fbValtype` kind of the cell a `LetDecl` binds inside function `fnIx` — the
// annotation's kind through the shared annotation ladder, else the initializer's. The local
// storage class's answer to what `globalCellKind` answers for a module global, kept here
// because `emit_collect.vl` cannot be imported back into this file.
function letCellKind(letIx: i32, fnIx: i32): VKind {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return vtKindOfType(d.letType) }
    if d.letInit >= 0 { return letInitCellKind(letIx, fnIx) }
  }
  "i32"
}

// ── the assignment target cell, by name ────────────────────────────────────────────
// The resolvers below are the storage-class dispatch itself: a body `let`, then a parameter,
// then a module global — the emitter's own order, so a binding shadowing a same-named global
// answers for the cell stored into. Each asks the resolver that decides that cell's valtype.

// The `fbValtype` kind of the cell named `nm` inside function `fnIx`, or `null` when no
// storage class claims the name. `null` means exactly one thing — there is no such cell —
// and never "this kind is unwelcome": a declined kind falls to `emitFunctionSection`'s `i32`
// default over a body pushing a ref, which is check-clean invalid wasm (D27).
function fnAssignCellKind(fnIx: i32, nm: string): VKind | null {
  if nm == "" { return null }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const li = parentLetOf(fn.fnBody, nm)
    if li >= 0 { return letCellKind(li, fnIx) }
    const pi = fnParamNodeOf(fnIx, nm)
    if pi >= 0 { return vtKindOfParam(pi) }
  }
  const gi = globalLetOfIn(fnIx, nm)
  if gi < 0 { return null }
  globalCellKind(gi)
}

// The struct-table index of the cell named `nm` inside function `fnIx`, or -1 — the raw
// per-class answer, ungated on the kind (`fnAssignRetSlot` applies the kind gate).
function fnAssignCellSlot(fnIx: i32, nm: string) {
  if nm == "" { return -1 }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const li = parentLetOf(fn.fnBody, nm)
    if li >= 0 { return structIndexOfLet(li, fnIx) }
    const pi = fnParamNodeOf(fnIx, nm)
    if pi >= 0 { return paramStructIdxOf(pi) }
  }
  const gi = globalLetOfIn(fnIx, nm)
  if gi < 0 { return -1 }
  globalCellStructIdx(gi)
}

// The map shape of the cell named `nm` inside function `fnIx` at cell kind `k`, or -1 — the
// payload column a `map` or `nulmap` result valtype needs, as `fnAssignCellSlot` is the one
// a struct needs. A wrong shape names the mono `$mapStruct` over a ref-valued map. Read from
// the same binding the kind came from, per storage class, like every other column here.
function fnAssignCellMapShape(fnIx: i32, nm: string, k: VKind) {
  if nm == "" { return -1 }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const li = parentLetOf(fn.fnBody, nm)
    if li >= 0 {
      if k == "nulmap" { return nulMapShapeOf(li, fnIx) }
      return letMapShapeOf(li, fnIx)
    }
    const pi = fnParamNodeOf(fnIx, nm)
    if pi >= 0 { return paramMapShape(fnIx, nm) }
  }
  const gi = globalLetOfIn(fnIx, nm)
  if gi < 0 { return -1 }
  if k == "nulmap" { return nulMapShapeOf(gi, -1) }
  letMapShapeOf(gi, -1)
}

// The declared type spelling of the `LetDecl` at `letIx`, or "" when un-annotated, its kind
// then coming from the initializer through `letInitCellKind`.
function letDeclTypeName(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 { return tyNameOf(d.letType) }
  }
  ""
}

// The declared type spelling of the cell named `nm` inside function `fnIx`, or "" — the
// column `VKind` cannot supply. A literal-union cell, a plain `i32` cell and a `boolean`
// cell are all `"i32"` to `fbValtype`, yet `v: K` and `w: i32` are different result types
// and the checker joins two arms assigning to them into a union box.
function fnAssignCellTypeName(fnIx: i32, nm: string) {
  if nm == "" { return "" }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const li = parentLetOf(fn.fnBody, nm)
    if li >= 0 { return letDeclTypeName(li) }
    const pi = fnParamNodeOf(fnIx, nm)
    if pi >= 0 {
      const p = P.nodes[pi]
      if p is Param { return tyNameOf(p.parType) }
    }
  }
  const gi = globalLetOfIn(fnIx, nm)
  if gi < 0 { return "" }
  letDeclTypeName(gi)
}

// The ref-list element type-name of the cell named `nm` inside function `fnIx`, or "".
function fnAssignCellElem(fnIx: i32, nm: string) {
  if nm == "" { return "" }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const li = parentLetOf(fn.fnBody, nm)
    if li >= 0 { return letRefListElemName(li, fnIx) }
    const pi = fnParamNodeOf(fnIx, nm)
    if pi >= 0 {
      const p = P.nodes[pi]
      if p is Param { return refArrElemNameIf(tyNameOf(p.parType)) }
    }
  }
  const gi = globalLetOfIn(fnIx, nm)
  if gi < 0 { return "" }
  letRefListElemName(gi, -1)
}

// ── the if-arm join ────────────────────────────────────────────────────────────────
// Two arms join exactly when their target cells have the same result identity: the same
// guarded kind, struct-table slot, ref-list element name and declared type spelling. Not a
// widening join: the lowering is store-then-re-read per arm with no coercion site between.

// The tail statement of an if-arm block, or -1 for an empty arm or a non-block arm.
function armTailStmtOf(blockIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const st = b.blkStmts
    if st.length > 0 { return st[st.length - 1] }
  }
  -1
}

// The ident name an arm-tail statement assigns to, or "" — the same unwrap
// `fnAssignRetTargetName` runs on a straight-line tail, since both reach `emitBinExprNode`'s
// `=` arm and both leave the target cell on the stack. An index or member target answers "":
// its value form is not lowered, so `emitIfTail` never claims the `if`.
function armAssignTargetName(stmtIx: i32) {
  if stmtIx < 0 { return "" }
  let tx = stmtIx
  const ts = P.nodes[tx]
  if ts is RetStmt {
    if ts.retArg < 0 { return "" }
    tx = ts.retArg
  }
  const a = P.nodes[unwrapParen(tx)]
  if a is BinExpr {
    if a.binOp == "=" {
      const t = P.nodes[unwrapParen(a.binLeft)]
      if t is Ident { return t.identName }
    }
  }
  ""
}

// The leftmost arm-tail assignment target under the tail `if` at `ifIx` — the candidate the
// other arms are compared against. "" when the then-arm's tail is not an assignment. A
// nested tail `if` in the then-arm recurses to its own first arm.
function ifTailFirstAssignName(ifIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    const t = armTailStmtOf(s.ifThen)
    if t < 0 { return "" }
    const tn = P.nodes[t]
    if tn is IfStmt { return ifTailFirstAssignName(t) }
    return armAssignTargetName(t)
  }
  ""
}

// True if the two cell names resolve, inside function `fnIx`, to the same result identity:
// kind, struct slot, ref-list element and declared type spelling. A name no storage class
// claims never agrees. Two un-annotated cells carry "" for the spelling and are separated by
// the other three columns alone, `letInitCellKind` being their one home.
function fnAssignCellEq(fnIx: i32, a: string, b: string) {
  const ka = fnAssignCellKind(fnIx, a)
  const kb = fnAssignCellKind(fnIx, b)
  if ka == null { return false }
  if kb == null { return false }
  if ka != kb { return false }
  if fnAssignCellSlot(fnIx, a) != fnAssignCellSlot(fnIx, b) { return false }
  if fnAssignCellElem(fnIx, a) != fnAssignCellElem(fnIx, b) { return false }
  fnAssignCellTypeName(fnIx, a) == fnAssignCellTypeName(fnIx, b)
}

// True if the arm block at `blockIx` ends in an assignment whose target cell agrees with
// `nm0`'s; a nested tail `if` recurses through every one of its own arms.
function ifTailArmAgrees(blockIx: i32, fnIx: i32, nm0: string) {
  const t = armTailStmtOf(blockIx)
  if t < 0 { return false }
  const tn = P.nodes[t]
  if tn is IfStmt { return ifTailArmsAgree(t, fnIx, nm0) }
  const nm = armAssignTargetName(t)
  if nm == "" { return false }
  if nm == nm0 { return true }
  fnAssignCellEq(fnIx, nm, nm0)
}

// True if every arm of the tail `if` at `ifIx` ends in an assignment agreeing with `nm0`.
// An `if` with no else declines: the false path falls through with no value, so the
// function's result is the checker's nullable join and not any arm's cell.
function ifTailArmsAgree(ifIx: i32, fnIx: i32, nm0: string) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    if s.ifElse < 0 { return false }
    if !ifTailArmAgrees(s.ifThen, fnIx, nm0) { return false }
    const els = P.nodes[s.ifElse]
    if els is Block { return ifTailArmAgrees(s.ifElse, fnIx, nm0) }
    // `else if`: a lone nested `IfStmt`, which must carry its own final `else`.
    return ifTailArmsAgree(s.ifElse, fnIx, nm0)
  }
  false
}

// The one representative arm-tail assignment target of the tail `if` at `ifIx`, or "" — the
// join. Minted only when every arm's target cell agrees with the first arm's, so the name
// stands for all of them and the `fnAssignRet*` columns read off it as off a straight tail.
function ifTailAssignName(ifIx: i32, fnIx: i32) {
  const nm0 = ifTailFirstAssignName(ifIx)
  if nm0 == "" { return "" }
  if !ifTailArmsAgree(ifIx, fnIx, nm0) { return "" }
  nm0
}

// The authoritative result `VKind` of function `fe` when its implicit return is an assignment
// — a straight-line tail, an explicit `return (v = e)`, or a tail `if` whose arms all assign
// to agreeing cells — else `null`. Exported because `emitReturnValue` needs the same answer
// for its `nulstr` seed: one fact, two readers, or functype and value disagree.
export function fnAssignRetKind(fe: i32): VKind | null {
  const nm = fnAssignRetTargetName(fe)
  if nm == "" { return null }
  fnAssignCellKind(fnStmts[fe], nm)
}

// The result-valtype slot beside `fnAssignRetKind`'s answer — the struct-table index for a
// struct cell, the ref-list wrapper slot for a ref-list cell, -1 for the kinds needing none.
// Gated on the kind and read from the same binding the kind came from. The ref-list arm is
// reached only through `cloRetValSlot`, which routes the whole assignment-cell answer here.
function fnAssignRetSlot(fe: i32) {
  const k = fnAssignRetKind(fe)
  if k == null { return -1 }
  if k == "reflist" { return rlSlotByName(fnAssignRetElemName(fe)) }
  // A map cell's slot is its value shape, not a struct index. Naming the kind without the
  // shape points the cell at the mono map, so this arm has to sit beside the `map` and
  // `nulmap` kinds rather than after them.
  if k == "map" || k == "nulmap" {
    return fnAssignCellMapShape(fnStmts[fe], fnAssignRetTargetName(fe), k)
  }
  if k != "struct" && k != "nulstruct" { return -1 }
  fnAssignCellSlot(fnStmts[fe], fnAssignRetTargetName(fe))
}

// The map shape beside an inferred `map` or `nulmap` result valtype — the assignment cell's
// shape when the implicit return is an assignment, else the return expression's. The cell
// rung comes first because the expression rung is unreachable for an if-arm tail:
// `fnRetExprOf` reads the body's last statement, which is the `if`, and answers -1 (D30).
export function inferredRetMapSlot(ti: i32) {
  retMapFlight.push(ti)
  const sh = inferredRetMapSlotCore(ti)
  retMapFlight.pop()
  sh
}

function inferredRetMapSlotCore(ti: i32) {
  const ark = fnAssignRetKind(ti)
  if ark == "map" || ark == "nulmap" { return fnAssignRetSlot(ti) }
  const mrx = fnRetExprOf(fnStmts[ti])
  if mrx >= 0 { return mapRetExprShape(mrx, ti) }
  -1
}

// The ref-list element type-name beside `fnAssignRetKind`'s `reflist` answer — the column
// `emit_sections`' inferred-return arm turns into the result's wrapper slot. Same binding,
// same three storage classes, same order.
function fnAssignRetElemName(fe: i32) {
  fnAssignCellElem(fnStmts[fe], fnAssignRetTargetName(fe))
}

// Classify one valued return expression at `rx0` of the function at `fnStmts` position `i`,
// under the current narrowing stack — the shared loop body of the narrowing-aware walk.
export function criClassify(rx0: i32, i: i32) {
  let rx = rx0
  // An assignment's value is its target cell, not the rhs expression, and that is a property
  // of the function rather than of this return node — so it answers for every node of such a
  // function and returns, letting no expression fact touch the slot afterwards. The cell kind
  // is a direct write, so leaving the eager writes beside it would never reach a fixed point.
  const ark = fnAssignRetKind(i)
  if ark != null {
    if fRetKind[i] != ark {
      fRetKind[i] = ark
      criChanged = true
    }
    // The per-kind payload columns the result valtype needs beside the kind;
    // `emit_sections`' inferred-return arm reads exactly these.
    if ark == "struct" || ark == "nulstruct" {
      fRetStructIdx[i] = fnAssignRetSlot(i)
    }
    if ark == "reflist" {
      if i < fRetRArrElem.length && fRetRArrElem[i] == "" {
        fRetRArrElem[i] = fnAssignRetElemName(i)
      }
    }
    return 0
  }
  // A tail assignment yields its rhs, so the function's return kind is the rhs's kind.
  const rxe = P.nodes[rx]
  if rxe is BinExpr {
    if rxe.binOp == "=" { rx = rxe.binRight }
  }
  if fRetKind[i] != "str" && exprString(rx, fnStmts[i]) {
    criSetRetKind(i, "str")
  }
  if !retKindIsList(fRetKind[i]) && exprRefArray(rx, fnStmts[i]) {
    // Record the element type-name so the inferred functype result can resolve its ref-list
    // slot: the annotated path fills `fRetRArrElem` from the annotation, but an un-annotated
    // return must read it off the return expression.
    if criSetRetKind(i, "reflist") {
      if i < fRetRArrElem.length && fRetRArrElem[i] == "" {
        fRetRArrElem[i] = refListElemNameOfExpr(rx, fnStmts[i])
      }
    }
  }
  if !retKindIsList(fRetKind[i]) && exprStringArray(rx, fnStmts[i]) {
    criSetRetKind(i, "strlist")
  }
  // The returned list local whose element spelling only the arena knows — the list twin of
  // the `retIsMapLocal` rung, for the same reason: a returned local's collected kind does not
  // exist during this global pass. Asked here and not in `tyKindOf`, because widening that
  // mapping makes `exprArray` claim a `K[]` at every position, not just the result valtype.
  if !retKindIsList(fRetKind[i]) {
    const rlk = tyScalarBackedListKind(nodeTyIxOf(rx))
    if rlk != null { criSetRetKind(i, rlk) }
  }
  if !retKindIsList(fRetKind[i]) && exprF64Array(rx, fnStmts[i]) {
    criSetRetKind(i, "f64list")
  }
  // The i64 and f32 siblings of the f64-list arm, checked before the generic `exprArray` arm
  // below, which would otherwise claim a wide-magnitude return as a plain i32 list and
  // declare the i32-list wrapper over a body building the wide one.
  if !retKindIsList(fRetKind[i]) && exprI64Array(rx, fnStmts[i]) {
    criSetRetKind(i, "i64list")
  }
  if !retKindIsList(fRetKind[i]) && exprF32Array(rx, fnStmts[i]) {
    criSetRetKind(i, "f32list")
  }
  // A `u8[]` return expression — the packed byte list. `u8` is a storage type and not a value
  // kind (`array.get_u` widens at every value seam), so no `expr*Array` classifier speaks it
  // and the result would declare an i32 scalar over a body pushing the wrapper. Narrow by
  // construction: only the `u8` answer is taken, the other leaves being decided above.
  if !retKindIsList(fRetKind[i]) && fRetKind[i] != "u8list" {
    if tyPrimLeafListKind(nodeTyIxOf(rx)) == "u8list" {
      criSetRetKind(i, "u8list")
    }
  }
  // The empty `[]` return — the element hole, and the result-valtype half of D16. Every arm
  // above classifies from the literal's own elements, so a hole whose element is a struct,
  // closure or nested list falls to the i32-list default. Read off the type the checker
  // unified the hole with, the same node `emitReturnValue`'s build seed reads.
  if !retKindIsList(fRetKind[i]) && fRetKind[i] != "u8list" {
    // The hole's node, not the return's (D626): `return cc` over `const cc = []` reads `cc`'s
    // initializer, where the checker recorded the element it unified the hole with.
    // `criRetHoleNode` is `rx` itself in every other case.
    const hn = criRetHoleNode(rx, i)
    const hk = emptyArrHoleKind(hn)
    if hk != null {
      if criSetRetKind(i, hk) {
        // The ref-list payload column the result valtype needs beside the kind — the same
        // `fRetRArrElem` slot the `exprRefArray` arm above fills, from the same renderer.
        if hk == "reflist" {
          if i < fRetRArrElem.length && fRetRArrElem[i] == "" {
            fRetRArrElem[i] = emptyArrHoleElemName(hn)
          }
        }
      }
    }
  }
  if fRetKind[i] != "map" {
    // `exprMap` classifies a returned map param and a `Map()` or map-returning call. A
    // returned map local needs `retIsMapLocal`: its kind is not collected during this global
    // return pass, so read its declaration — the annotation, else the checker's type.
    if (
      exprMap(rx, fnStmts[i]) ||
      retIsMapLocal(rx, fnStmts[i]) ||
      retCapturedMapShape(i, rx) != -3
    ) {
      criSetRetKind(i, "map")
    }
  }
  // The not-a-list guard is what separates i32 and f64 lists here: `exprArray`'s array-literal
  // case is `!arrLitIsRef` and an f64 element is not a ref, so it also claims `[1.5, 2.5]`.
  // The f64-list arm above has already set the kind, so this one skips it.
  if !retKindIsList(fRetKind[i]) && exprArray(rx, fnStmts[i]) {
    criSetRetKind(i, "list")
  }
  if fRetKind[i] != "union" && exprUnion(rx, fnStmts[i]) {
    // A union return subsumes a per-arm struct classification: a value-if join has one arm a
    // union-variant object literal, which `exprStruct` would also claim as a plain struct, and
    // struct outranks union, so `criSetRetKind` would refuse. Lambda-gated, because only the
    // lambda value-if path reaches this order and a named function must not move.
    if (
      (fRetKind[i] == "struct" || fRetKind[i] == "variant") &&
      criFnIsAnonLambda(i)
    ) {
      fRetKind[i] = "union"
      criChanged = true
    } else {
      criSetRetKind(i, "union")
    }
  }
  if (
    fRetKind[i] != "nulstruct" &&
    fRetKind[i] != "union" &&
    exprNullableStruct(rx, fnStmts[i])
  ) {
    if criSetRetKind(i, "nulstruct") {
      fRetStructIdx[i] = structIndexOfExpr(rx, fnStmts[i])
    }
  }
  // A return expression that already yields a concrete variant — the expression-level twin of
  // the annotated-local rung below. Safe by `exprVariantIndex`'s own property, not by
  // inspection here: every arm of it is rep-authoritative rather than a shape match, and it
  // has no object-literal field-set leg, so a bare `return { r: n }` falls to the struct arm.
  if (
    fRetKind[i] != "struct" &&
    fRetKind[i] != "nulstruct" &&
    fRetKind[i] != "union" &&
    fRetKind[i] != "variant" &&
    !retKindIsList(fRetKind[i])
  ) {
    const rvx = exprVariantIndex(rx, fnStmts[i])
    if rvx >= 0 {
      if criSetRetKind(i, "variant") { fRetStructIdx[i] = rvx }
    }
  }
  if (
    fRetKind[i] != "struct" &&
    fRetKind[i] != "nulstruct" &&
    fRetKind[i] != "union" &&
    fRetKind[i] != "variant" &&
    exprStruct(rx, fnStmts[i])
  ) {
    // The `!= "union"` guard: an inferred struct-union return stores `"union"` in the name
    // pass, but each of its returns is a single object literal `exprStruct` would also claim
    // as a plain struct. The union kind dominates, so neither column may be reclaimed.
    if criSetRetKind(i, "struct") {
      const rsx = structIndexOfExpr(rx, fnStmts[i])
      // D51 with no local at all — `function mk(n: i32) { return { r: n } }` beside a declared
      // union. Same `-1` gate as the returned-local rung, which cannot see this shape because
      // there is no local to hand it. Three classifiers and one emit seed mint the pair
      // (`"struct"`, -1), so each one left behind is a program that still refuses.
      if rsx < 0 {
        const rov = objLitVariantIdxNoStructRow(rx)
        if rov >= 0 {
          fRetKind[i] = "variant"
          criChanged = true
          fRetStructIdx[i] = rov
        } else {
          fRetStructIdx[i] = rsx
        }
      } else {
        fRetStructIdx[i] = rsx
      }
    }
  }
  // A returned nested-struct field read whose chain roots at a local — the member twin of the
  // returned-local rungs below, blind for the identical reason (D131). `"nulstruct"` and not
  // `"struct"`: the lowering codes fold `inner: S` and `inner: S | null` onto one code-15 hop
  // and the slot is `(ref null $S)` either way. Ahead of that block; it fills holes only.
  if fRetKind[i] == "i32" && fRetBool[i] == 0 {
    const rnf = criRetNestedFieldStructIdx(rx, i)
    if rnf >= 0 {
      if criSetRetKind(i, "nulstruct") { fRetStructIdx[i] = rnf }
    }
  }
  // A returned local `let` of a ref kind: during this global pass the function's locals are
  // not collected, so the `expr*` Ident cases above miss it and the result would default to
  // i32 over a body yielding a ref. Classify through the declaration, annotation first, as
  // `retIsMapLocal` does for a map; the scalar and string kinds are covered by the name pass.
  const rll = criRetLocalLet(rx, i)
  if rll >= 0 {
    if !retKindIsList(fRetKind[i]) && letIsRefArray(rll, fnStmts[i]) {
      if criSetRetKind(i, "reflist") {
        if i < fRetRArrElem.length && fRetRArrElem[i] == "" {
          fRetRArrElem[i] = letRefListElemName(rll, fnStmts[i])
        }
      }
    }
    // A returned local annotated at a concrete union arm, before the struct arm below, whose
    // `structIndexOfLet` has no row for an arm and falls through to a field-set scan of the
    // initializer that contradicts the annotation. That scan picks an exact layout twin and
    // the module is refused one heap type apart. The annotation, not `letIsVariant` (D52).
    let rlv = letAnnVariantIdx(rll)
    // The init's own rep, when the annotation has nothing to say — `variantIndexOfLet` is
    // `structIndexOfLet`'s twin, arm for arm. Asked first: otherwise `structIndexOfLet` falls
    // through to `structIndexOfExpr`, whose non-kind-gated legs resolve a variant param to a
    // layout twin's struct row. Storage class beats a structural twin (D99).
    if rlv < 0 { rlv = variantIndexOfLet(rll, fnStmts[i]) }
    if (
      rlv >= 0 &&
      fRetKind[i] != "union" &&
      fRetKind[i] != "nulstruct" &&
      !retKindIsList(fRetKind[i])
    ) {
      if criSetRetKind(i, "variant") { fRetStructIdx[i] = rlv }
    }
    if (
      fRetKind[i] != "struct" &&
      fRetKind[i] != "nulstruct" &&
      fRetKind[i] != "union" &&
      fRetKind[i] != "variant" &&
      !retKindIsList(fRetKind[i]) &&
      letIsStruct(rll, fnStmts[i])
    ) {
      // `structIndexOfLet` prefers the annotation's struct over the literal's first
      // field-shape match, so `const c: Ctx = {…}` returns `Ctx` even when another declared
      // struct shares its field names.
      if criSetRetKind(i, "struct") {
        const rsi = structIndexOfLet(rll, fnStmts[i])
        // The un-annotated half of the arm above (D51): `const c = { r: n }` beside a declared
        // union has no struct row at all, since `collectS` skips a `type X = {…}` that is a
        // union member, so the pair (`"struct"`, -1) trips `fbValtype`'s bounds guard. The `-1`
        // is the gate; the kind is written directly because the two share one `retKindPri` tier.
        if rsi < 0 {
          const rov = letObjLitVariantIdx(rll)
          if rov >= 0 {
            fRetKind[i] = "variant"
            criChanged = true
            fRetStructIdx[i] = rov
          } else {
            fRetStructIdx[i] = rsi
          }
        } else {
          fRetStructIdx[i] = rsi
        }
      }
    }
    // A returned local annotated as the string primitive: a branded newtype is not admitted by
    // `isClassifiableRetName`, so no inferred-return row exists and the result stays i32.
    // `nodeTyPrimName` is the narrow arena test both ways — a brand is a `TyPrim` named
    // `string`, a literal union is not — and `letIsString` would claim the litunion's literal.
    const rld = P.nodes[rll]
    if rld is LetDecl {
      if rld.letType >= 0 {
        if nodeTyPrimName(rld.letType) == "string" { criSetRetKind(i, "str") }
      }
    }
  }
  if fRetBool[i] == 0 && exprIsBool(rx, fnStmts[i]) {
    fRetBool[i] = 1
    criChanged = true
  }
  // Scalar f64, f32 and i64 returns detected from the return expression, for a function the
  // checker recorded no inferred-return name for — a monomorphized instance, whose body the
  // checker only saw with a type variable. Gated on a pure scalar return: a value-union `?? d`
  // reads as its unboxed atom while its result rep is the union box, classified separately.
  let scalarOk = fRetKind[i] == "i32" && fRetBool[i] == 0
  const rxn = P.nodes[rx]
  if rxn is BinExpr {
    if rxn.binOp == "??" { scalarOk = false }
  }
  if scalarOk {
    if exprIsF64(rx, fnStmts[i]) { criSetRetKind(i, "f64") }
    else if exprIsF32(rx, fnStmts[i]) { criSetRetKind(i, "f32") }
    else if exprIsI64(rx, fnStmts[i]) { criSetRetKind(i, "i64") }
  }
  // Last resort: a returned local typed from its own declaration. Both the typed-IR fast path
  // and `declaredKind` can be blind at once — the latter reads a table `buildLocals` fills much
  // later, and a monomorphized instance's body is a clone whose leaves carry no recorded type.
  // The payload-free kinds only, gated on the slot still being the default, so it fills holes.
  if fRetKind[i] == "i32" && fRetBool[i] == 0 {
    const lk = retLocalCellKind(rx, i)
    if lk != null { criSetRetKind(i, lk) }
  }
  0
}

// The payload-free cell kind of a returned local of function `i`, or `null` — the declaration
// half of `criClassify`'s last rung. Resolves the `LetDecl` by name in this function's own
// body and asks `letCellKind`, the shared annotation-else-initializer ladder.
function retLocalCellKind(rx: i32, i: i32): VKind | null {
  if i < 0 || i >= fnStmts.length { return null }
  const rn = P.nodes[unwrapParen(rx)]
  if rn is Ident {
    const fn = P.nodes[fnStmts[i]]
    if fn is FuncDecl {
      const li = parentLetOf(fn.fnBody, rn.identName)
      if li < 0 { return null }
      const k = letCellKind(li, fnStmts[i])
      if (
        k == "f64" ||
        k == "f32" ||
        k == "i64" ||
        k == "str" ||
        k == "list" ||
        k == "strlist" ||
        k == "f64list" ||
        k == "i64list" ||
        k == "f32list"
      ) {
        return k
      }
    }
  }
  null
}

// The struct-table row a nested-struct (code-15) field-read chain yields, resolved with the
// local receivers this global return pass cannot otherwise see. The descent is
// `structIndexOfExpr`'s own Member arm one hop at a time; only the root rung differs, going
// through the `let` declaration. Nothing but a code-15 hop is followed.
function criRetMemberChainStructIdx(rx: i32, i: i32): i32 {
  const u = unwrapParen(rx)
  const e = P.nodes[u]
  if e is Member {
    const psi = criRetMemberChainStructIdx(e.memObj, i)
    if psi < 0 { return -1 }
    const pfi = sFieldIndex(psi, e.memProp)
    if pfi < 0 { return -1 }
    if sFieldTypeAt(psi, pfi) != 15 { return -1 }
    return sFieldTgtStructIdx(psi, pfi)
  }
  const si = structIndexOfExpr(u, fnStmts[i])
  if si >= 0 { return si }
  const fn = P.nodes[fnStmts[i]]
  if fn is FuncDecl {
    const li = retLocalLetOfBlock(fn.fnBody, u)
    if li >= 0 { return structIndexOfLet(li, fnStmts[i]) }
  }
  -1
}

// The struct row a returned value's code-15 nested-struct field slot targets, for the two
// spellings `criClassify`'s D131 rung answers: the field read itself, and a returned local
// bound to one. -1 for everything else. The local leg takes only an un-annotated `let`: an
// annotated one already has a claimant, and its cell is built from that annotation.
function criRetNestedFieldStructIdx(rx: i32, i: i32): i32 {
  if i < 0 || i >= fnStmts.length { return -1 }
  const u = unwrapParen(rx)
  const e = P.nodes[u]
  if e is Member { return criRetMemberChainStructIdx(u, i) }
  if e is Ident {
    const fn = P.nodes[fnStmts[i]]
    if fn is FuncDecl {
      const li = retLocalLetOfBlock(fn.fnBody, u)
      if li >= 0 {
        const d = P.nodes[li]
        if d is LetDecl {
          if d.letType < 0 {
            const iv = unwrapParen(d.letInit)
            const ivn = P.nodes[iv]
            if ivn is Member { return criRetMemberChainStructIdx(iv, i) }
          }
        }
      }
    }
  }
  -1
}

// True if lifted function `i` is an anonymous lambda with no source name. It restricts the
// if-arm tail-value return classification to lambdas, leaving named-function inference to
// `buildFnMap`'s name pass and `criWalkStmt`'s explicit-`return` classification.
export function criFnIsAnonLambda(i: i32) {
  if i < 0 || i >= fnStmts.length { return false }
  const fn = P.nodes[fnStmts[i]]
  if fn is FuncDecl {
    // The emitter rewrites an anonymous lambda's empty name to `__lambda_N` before this pass
    // runs, so the prefix is the test and `fnName == ""` never matches a lifted lambda. A
    // source function never starts with `__lambda`.
    const nm = fn.fnName
    return nm.length >= 8 && nm.slice(0, 8) == "__lambda"
  }
  false
}

// Walk a block's statements classifying every `return <e>` under the same narrowing the
// emit loops apply: each `if` arm under its condition's then or else narrowing, and a
// divergent guard narrowing the rest of the block. The stack rewinds at block exit.
export function criWalkBlock(blockIx: i32, i: i32) {
  if blockIx < 0 { return 0 }
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    const savedGuardTop = narrowTop
    let k = 0
    while k < stmts.length {
      // An if-arm's last statement may be a bare tail value rather than an explicit
      // `return`. For an anonymous lambda, classify it under the arm's active narrowing so a
      // value-if union return types from its arms. Lambda-gated to leave named-function
      // inference unchanged.
      if (
        k == stmts.length - 1 &&
        criFnIsAnonLambda(i) &&
        stmtIsTailValue(stmts[k], fnStmts[i])
      ) {
        criClassify(stmts[k], i)
      }
      criWalkStmt(stmts[k], i)
      pushPostGuardNarrow(stmts[k], fnStmts[i])
      k = k + 1
    }
    restoreNarrow(savedGuardTop)
    return 0
  }
  criWalkStmt(blockIx, i)
}

function criWalkStmt(stmtIx: i32, i: i32) {
  if stmtIx < 0 { return 0 }
  const s = P.nodes[stmtIx]
  if s is RetStmt {
    if s.retArg >= 0 { criClassify(s.retArg, i) }
    return 0
  }
  if s is IfStmt {
    const savedTop = narrowTop
    setNarrowFromCond(s.ifCond, fnStmts[i])
    criWalkBlock(s.ifThen, i)
    restoreNarrow(savedTop)
    if s.ifElse >= 0 {
      const savedElseTop = narrowTop
      setNarrowFromCondElse(s.ifCond, fnStmts[i])
      criWalkBlock(s.ifElse, i)
      restoreNarrow(savedElseTop)
    }
    return 0
  }
  if s is WhileStmt { return criWalkBlock(s.whileBody, i) }
  if s is ForRange { return criWalkBlock(s.frBody, i) }
  if s is ForIn { return criWalkBlock(s.fiBody, i) }
  0
}

// Look up the wasm function index for `name`, or -1 if no such top-level function
// exists (an undefined callee — the caller fails loudly).
export function fnIndexOf(name: string) {
  sidArrGet(fnIndexBySid, sidLookup(name))
}

// The sid-taking primitive — an array read. See `globalIndexOfSid`.
export function fnIndexOfSid(sid: i32) { sidArrGet(fnIndexBySid, sid) }

// The `fnStmts` position of a lifted function named `name` whose parent frame is the
// `fnStmts` position `pp`, or -1 — one rung of the scope-chain walk in
// `fnIndexOfInScopeSid`, and the twin of `emit_collect.nestedFnDeclaredIn`. Both walk the
// one `fnChildHead`/`fnChildNext` index, so both see `pp`'s children in `fnStmts` order.
function nestedFnDeclaredInFrame(name: string, pp: i32) {
  if fnChildHead.length != fnStmts.length { buildFnChildIndex() }
  if pp < 0 || pp >= fnChildHead.length { return -1 }
  let i = fnChildHead[pp]
  while i >= 0 {
    const s = P.nodes[fnStmts[i]]
    if s is FuncDecl {
      if s.fnName == name { return i }
    }
    i = fnChildNext[i]
  }
  -1
}

// `fnIndexOf` but scope-aware for a name referenced as a value or a callback inside function
// `fnIx`: when two lifted functions share a name, the flat `fnIndexOf` always returns the
// first. Resolution walks outward from the calling frame and stops at the first scope that
// declares `name`; running off the chain means the flat map's top-level answer is right.
export function fnIndexOfInScope(name: string, fnIx: i32) {
  fnIndexOfInScopeSid(sidLookup(name), name, fnIx)
}

// The sid-taking primitive. `emit_collect.fnIndexOfInScopeChainSid` is the deliberate twin:
// this file cannot import `emit_collect`, since the module graph runs the other way.
export function fnIndexOfInScopeSid(sid: i32, name: string, fnIx: i32) {
  // The parent-matching scan can only succeed for a nested function named `name`; skip it
  // entirely when no lifted function carries this name.
  if fnIx >= 0 && sidArrGet(nestedNameBySid, sid) == 1 {
    let pp = fnStmtsPosOf(fnIx)
    // `fnStmts.length` bounds the walk: a parent chain cannot be longer than the function
    // count, so this terminates even if `fnParent` ever held a cycle.
    let steps = 0
    while pp >= 0 && steps <= fnStmts.length {
      const hit = nestedFnDeclaredInFrame(name, pp)
      if hit >= 0 { return hit }
      if pp < fnParent.length { pp = fnParent[pp] } else { pp = -1 }
      steps = steps + 1
    }
  }
  fnIndexOfSid(sid)
}

// ── capture analysis (closures) ───────────────────────────────────────────────
// The `fnStmts` position of the lifted function whose capture list is being computed, so
// `capRecord` can ask whether an enclosing frame binds a name without threading it through
// `capScan`'s recursion. Sound because `capComputeNamesOf` is the only entry point.
let capFrame: i32 = -1

// The captured-variable names of the lifted function at `fnStmts[fe]`, in encounter order,
// which is env-field order, by direct walk. A capture is a free variable: read in the body,
// and not a param, a body `let`, a module global or a lifted function name — the last two
// unless an enclosing frame binds it (`capRecord`). Callers go through `captureNamesOf`.
export function capComputeNamesOf(fe: i32) {
  const caps: string[] = []
  if fe < 0 || fe >= fnStmts.length { return caps }
  capFrame = fe
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    const bound: string[] = []
    const params = fn.fnParams
    let pi = 0
    while pi < params.length {
      const p = P.nodes[params[pi]]
      if p is Param { bound.push(p.parName) }
      pi = pi + 1
    }
    // `capScan` resolves a narrowing condition against the frame whose body it is in;
    // this is that frame. Set only while recording, so an ordinary scan is unchanged.
    if cnRecording { cnScanFnIx = fnStmts[fe] }
    capScan(fn.fnBody, bound, caps)
  }
  caps
}

// The captured-variable names of the lifted function at `fnStmts[fe]` — from the capture
// cache when it is valid (the emission phases), else by direct walk (the rewrite and
// monomorphize phases, which still mutate bodies). A fresh small array either way, since a
// `string[][]` cache row is not self-host-emittable.
export function captureNamesOf(fe: i32) {
  if capCacheOn && fe >= 0 && fe < capStartTbl.length {
    const caps: string[] = []
    const start = capStartTbl[fe]
    const cnt = capCountTbl[fe]
    let ci = 0
    while ci < cnt {
      caps.push(capNamesFlat[start + ci])
      ci = ci + 1
    }
    return caps
  }
  capComputeNamesOf(fe)
}

// The number of captured variables of the lifted function at `fnStmts[fe]` —
// O(1) from the cache when valid, else the direct walk's length.
export function captureCountOf(fe: i32) {
  if capCacheOn && fe >= 0 && fe < capCountTbl.length { return capCountTbl[fe] }
  const caps = capComputeNamesOf(fe)
  caps.length
}

// A module global and a lifted function name are addressable directly from inside a lifted
// function, so neither is a capture — unless an enclosing frame binds the same name, when
// the identifier denotes that binding and dropping it leaves the body reading `global.get`.
// It deliberately binds the local: a closure written before a shadowing `let` captures it.
function capRecord(name: string, bound: string[], caps: string[]) {
  if capIsBound(bound, name) { return 0 }
  if globalIndexOf(name) >= 0 || fnIndexOf(name) >= 0 {
    if parentBindingFrameOf(capFrame, name) < 0 {
      // The module scope is the one enclosing scope the frame walk cannot reach, and it has
      // a binding form that is not a global: a top-level `for` variable. Without it a closure
      // in a top-level loop body addresses the module function instead of the loop variable.
      if !moduleBindsLoopVar(emitRootIx, name) { return 0 }
    }
  }
  // The builtin-name exemption is positional and lives in `capScan`'s `Call` arm, not here:
  // a builtin name denotes instructions where it is called and nowhere else, so filtering it
  // at every identifier would suppress a genuine capture of a local sharing the name.
  if capHas(caps, name) { return 0 }
  caps.push(name)
  0
}

// Walk a statement or expression subtree collecting free-variable captures. `bound` grows as
// `let` declarations are seen: wasm locals are function-scoped, so once declared a name
// shadows an enclosing binding for the rest of the body. A nested `FuncDecl` is not
// descended, being lifted to its own function with its own capture analysis.
export function capScan(ix: i32, bound: string[], caps: string[]) {
  if ix < 0 { return 0 }
  const n = P.nodes[ix]
  if n is Ident {
    capRecord(n.identName, bound, caps)
    return 0
  }
  if n is FuncDecl {
    if n.fnName != "" { bound.push(n.fnName) }
    // A nested function's free variables that this scope does not bind are transitive
    // captures: the nested closure's env is built inside this lifted function, so a name the
    // nested body needs from an outer frame must ride this env too. Scan the nested body
    // against its own bound set, then filter the frees through `capRecord`.
    const ibound: string[] = []
    const iparams = n.fnParams
    let ipi = 0
    while ipi < iparams.length {
      const ip = P.nodes[iparams[ipi]]
      if ip is Param { ibound.push(ip.parName) }
      ipi = ipi + 1
    }
    if n.fnName != "" { ibound.push(n.fnName) }
    const ifree: string[] = []
    // `ifree` is the nested body's free-name set before the global and function-name filter,
    // which is exactly the population `capNarrowRecord` may record: it excludes every name
    // the nested function shadows with a param or local, so a replayed narrowing can never
    // land on a binding that is not the capture.
    const savedScanFn = cnScanFnIx
    if cnRecording { cnScanFnIx = ix }
    capScan(n.fnBody, ibound, ifree)
    cnScanFnIx = savedScanFn
    if cnRecording { capNarrowRecord(ix, ifree) }
    let ifi = 0
    while ifi < ifree.length {
      capRecord(ifree[ifi], bound, caps)
      ifi = ifi + 1
    }
    return 0
  }
  if n is Block {
    const stmts = n.blkStmts
    let i = 0
    const savedBlkTop = narrowTop
    while i < stmts.length {
      capScan(stmts[i], bound, caps)
      // A guard `if` with no else whose then-branch always leaves narrows the rest of the
      // block, so a closure written below the guard is inside that narrowing exactly as one
      // written in an else-arm is.
      if cnRecording { cnPostGuard(stmts[i]) }
      i = i + 1
    }
    if cnRecording { restoreNarrow(savedBlkTop) }
    return 0
  }
  if n is LetDecl {
    if n.letInit >= 0 { capScan(n.letInit, bound, caps) }
    bound.push(n.letName)
    return 0
  }
  if n is RetStmt {
    if n.retArg >= 0 { capScan(n.retArg, bound, caps) }
    return 0
  }
  if n is IfStmt {
    capScan(n.ifCond, bound, caps)
    // While recording, each arm is scanned under the narrowing that arm sees — the same
    // `setNarrowFromCond` and `setNarrowFromCondElse` pair the emit and classify loops use,
    // so a closure's recorded narrowing is the one the rest of the compiler would compute
    // for a read written in its place.
    if cnRecording {
      const savedIfTop = narrowTop
      cnSetNarrow(n.ifCond, false)
      capScan(n.ifThen, bound, caps)
      restoreNarrow(savedIfTop)
      if n.ifElse >= 0 {
        cnSetNarrow(n.ifCond, true)
        capScan(n.ifElse, bound, caps)
        restoreNarrow(savedIfTop)
      }
      return 0
    }
    capScan(n.ifThen, bound, caps)
    if n.ifElse >= 0 { capScan(n.ifElse, bound, caps) }
    return 0
  }
  if n is WhileStmt {
    capScan(n.whileCond, bound, caps)
    capScan(n.whileBody, bound, caps)
    return 0
  }
  if n is ForRange {
    capScan(n.frFrom, bound, caps)
    capScan(n.frTo, bound, caps)
    if n.frStep >= 0 { capScan(n.frStep, bound, caps) }
    bound.push(n.frVar)
    capScan(n.frBody, bound, caps)
    return 0
  }
  if n is ForIn {
    capScan(n.fiIter, bound, caps)
    bound.push(n.fiVar)
    capScan(n.fiBody, bound, caps)
    return 0
  }
  if n is Call {
    // The one place a builtin or intrinsic name is exempt from capture, and it is a position,
    // not a name filter: in callee position `print` or `Map` denote instructions the emitter
    // lowers inline, and anywhere else the same spelling is an ordinary identifier that must
    // be captured. Three lists partition the exempt names; the third needs the guard below.
    let skipCallee = false
    const cal = P.nodes[unwrapParen(n.callFn)]
    if cal is Ident {
      if isBuiltinFnName(cal.identName) { skipCallee = true }
      // The dunder family takes the same shadowing guard as the numeric one (D1087):
      // `emitCall`'s intrinsic arms are gated on `identNameIsUserBound`, so a call whose name
      // the frame binds routes to the value, and the closure's env must carry it for the gate
      // to find. The condition is the one under which the emitter writes the opcode.
      if (
        nameIsEmitterIntrinsic(cal.identName) ||
        isNumIntrinsicName(cal.identName)
      ) {
        let shadowed = capIsBound(bound, cal.identName)
        if fnIndexOf(cal.identName) >= 0 { shadowed = true }
        if globalIndexOf(cal.identName) >= 0 { shadowed = true }
        if parentBindingFrameOf(capFrame, cal.identName) >= 0 {
          shadowed = true
        }
        if !shadowed { skipCallee = true }
      }
    }
    if !skipCallee { capScan(n.callFn, bound, caps) }
    const args = n.callArgs
    let i = 0
    while i < args.length {
      capScan(args[i], bound, caps)
      i = i + 1
    }
    return 0
  }
  if n is BinExpr {
    capScan(n.binLeft, bound, caps)
    capScan(n.binRight, bound, caps)
    return 0
  }
  if n is Unary {
    capScan(n.unArg, bound, caps)
    return 0
  }
  if n is Paren {
    capScan(n.parInner, bound, caps)
    return 0
  }
  if n is Member {
    capScan(n.memObj, bound, caps)
    return 0
  }
  if n is OptMember {
    capScan(n.omObj, bound, caps)
    return 0
  }
  if n is Index {
    capScan(n.idxArr, bound, caps)
    capScan(n.idxIndex, bound, caps)
    return 0
  }
  if n is IsExpr {
    capScan(n.isObj, bound, caps)
    return 0
  }
  if n is AsExpr {
    capScan(n.asObj, bound, caps)
    return 0
  }
  if n is ObjLit {
    const fields = n.objFields
    let i = 0
    while i < fields.length {
      const f = P.nodes[fields[i]]
      if f is FieldInit { capScan(f.fiValue, bound, caps) }
      i = i + 1
    }
    return 0
  }
  if n is ArrayLit {
    const elems = n.arrElems
    let i = 0
    while i < elems.length {
      capScan(elems[i], bound, caps)
      i = i + 1
    }
    return 0
  }
  0
}

// The env struct heap-type index for the lifted function at index `fe`, or -1 if it
// captures nothing (its closure env is `ref.null structref`). Resolved by
// `mAssignTypeIndices` into `fnEnvIdx`.
export function fnEnvIdxOf(fe: i32) {
  if fe < 0 || fe >= fnEnvIdx.length { return -1 }
  fnEnvIdx[fe]
}

// True if function `fe`'s env-leading signature matches an interned `$fnsig`. Such a
// function is declared with `fnSigIdxOfFn` as its functype, so its actual type is that
// `$fnsig` and the call site's `call_indirect` signature check accepts it. A function
// outside the eligible kinds keeps its own functype and cannot be used as a value.
export function fnSigIsClosure(fe: i32) { fnSigIdxOfFn(fe) >= 0 }

// The `fnStmts` position of the enclosing frame whose binding a captured `name` resolves to
// — the direct parent when it binds `name`, else the nearest ancestor that does. For a
// transitive capture every intermediate lifted function re-captures the name, so the value
// flows env to env while the type lives at the owning frame's binding. -1 when none does.
function parentBindingFrameOf(fe: i32, name: string): i32 {
  if fe < 0 || fe >= fnParent.length { return -1 }
  const par = fnParent[fe]
  if par < 0 || par >= fnStmts.length { return -1 }
  const pfn = P.nodes[fnStmts[par]]
  if pfn is FuncDecl {
    const params = pfn.fnParams
    let i = 0
    while i < params.length {
      const p = P.nodes[params[i]]
      if p is Param {
        if p.parName == name { return par }
      }
      i = i + 1
    }
    if parentLetOf(pfn.fnBody, name) >= 0 { return par }
    // A `for` loop variable binds the frame exactly as a body `let` does — same
    // function-scoped wasm local, same shadowing. Without this arm the frame answers "does
    // not bind it" and `capRecord`'s global and function-name guard drops the capture, so a
    // closure over the loop variable reads a module function of the same name instead.
    if parentLoopVarOf(pfn.fnBody, name) >= 0 { return par }
    return parentBindingFrameOf(par, name)
  }
  -1
}

// The arena index of the enclosing frame's binding for a captured `name` — the owning
// frame's matching `Param` node, or a `LetDecl` in its body, or -1. Resolves through
// `parentBindingFrameOf`, so a transitive capture types exactly as a direct one. It is what
// resolves a capture's wasm valtype, whose declared type lives in the owning frame.
export function parentBindingOf(fe: i32, name: string) {
  const par = parentBindingFrameOf(fe, name)
  // The module frame (D1244): the top level is not in `fnStmts`, so the walk runs off the
  // chain for a closure written in a module-scope block and every ref-repped capture there
  // takes `captureValKind`'s i32 default. `moduleLocalLetOf` excludes top-level bindings,
  // which are globals and never captures.
  if par < 0 { return moduleLocalLetOf(emitRootIx, name) }
  const pfn = P.nodes[fnStmts[par]]
  if pfn is FuncDecl {
    const params = pfn.fnParams
    let i = 0
    while i < params.length {
      const p = P.nodes[params[i]]
      if p is Param {
        if p.parName == name { return params[i] }
      }
      i = i + 1
    }
    return parentLetOf(pfn.fnBody, name)
  }
  -1
}

// The enclosing-frame binding a captured `name` of the lifted function `fnIx` resolves to —
// a `Param` or `LetDecl` arena index — or -1 when `name` is not a capture of `fnIx`. The
// capture channel for the expression classifiers, and why they cannot disagree with the env
// struct: `captureValKind` types the env field off this very binding.
function capturedBindingOf(fnIx: i32, name: string) {
  if fnIx < 0 { return -1 }
  if !fnValUsed { return -1 }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return -1 }
  const caps = captureNamesOf(fe)
  let ci = 0
  while ci < caps.length {
    if caps[ci] == name { return parentBindingOf(fe, name) }
    ci = ci + 1
  }
  -1
}

// The arena index of the `FuncDecl` whose frame owns a captured `name`'s binding, or -1 —
// `parentBindingFrameOf`'s answer converted out of `fnStmts` positions into the arena index
// space every classifier's `fnIx` argument is in. One home: the two spaces coincide only at
// small indices, so forwarding a raw position makes frame-dependent arms silently decline.
function parentBindingFrameArenaOf(fe: i32, name: string) {
  const par = parentBindingFrameOf(fe, name)
  if par < 0 || par >= fnStmts.length { return -1 }
  fnStmts[par]
}

// The arena index of the frame owning capturing function `fnIx`'s captured `name`, or -1.
// `capturedBindingOf`'s companion: an un-annotated binding is classified from its
// initializer, which only resolves in the frame it is written in. Takes an arena index where
// `parentBindingFrameArenaOf` takes a position — the same question from either side.
function capturedBindingFrameOf(fnIx: i32, name: string) {
  if fnIx < 0 { return -1 }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return -1 }
  parentBindingFrameArenaOf(fe, name)
}

// The `for-in` node whose loop variable binds a captured `name` of lifted frame `fe`, or -1
// (D1142) — the third storage class of a capture, and the one with no declaration node, so
// `captureValKind` would fall to its i32 default whatever the iterated element is. Asked
// only where `parentBindingOf` declines, which is the right precedence by construction.
function captureLoopVarIterOf(fe: i32, name: string): i32 {
  const par = parentBindingFrameOf(fe, name)
  if par < 0 || par >= fnStmts.length { return -1 }
  const pfn = P.nodes[fnStmts[par]]
  if pfn is FuncDecl {
    const lv = parentLoopVarOf(pfn.fnBody, name)
    if lv < 0 { return -1 }
    const ln = P.nodes[lv]
    if ln is ForIn {
      const it = ln.fiIter
      // A bare local iterable is the one storage class this position cannot read: every rung
      // of `forInElemKind`'s Ident arm is frame-independent except `declaredKind`, which reads
      // the live scope stack, and the type section runs with no frame's locals bound. Re-ask
      // against the binding's initializer, widening only where the answer is the default.
      const ek = forInElemKind(it, fnStmts[par])
      if ek == null || ek == "i32" {
        const itn = P.nodes[unwrapParen(it)]
        if itn is Ident {
          const li = parentLetOf(pfn.fnBody, itn.identName)
          if li >= 0 {
            const ld = P.nodes[li]
            if ld is LetDecl {
              if ld.letInit >= 0 {
                const iek = forInElemKind(ld.letInit, fnStmts[par])
                if iek != null && iek != "i32" { return ld.letInit }
              }
            }
          }
        }
      }
      return it
    }
  }
  -1
}

// The `fbValtype` kind for a captured variable `name` of lifted function `fe`, resolved
// against the parent frame's binding — a param's annotation, or a local `let`'s annotation
// or initializer. Defaults to i32.
export function captureValKind(fe: i32, name: string): VKind {
  const b = parentBindingOf(fe, name)
  if b < 0 {
    // A captured `for-in` loop variable (D1142) — typed off the very ladder
    // `declareForInLocals` types the loop-var local with, resolved in the owning frame, so
    // the env field and the local it is built from cannot disagree.
    const lvIter = captureLoopVarIterOf(fe, name)
    if lvIter >= 0 {
      const lvk = forInElemKind(lvIter, parentBindingFrameArenaOf(fe, name))
      if lvk != null { return lvk }
    }
    return "i32"
  }
  const bn = P.nodes[b]
  if bn is Param { return vtKindOfType(bn.parType) }
  if bn is LetDecl {
    if bn.letType >= 0 { return vtKindOfType(bn.letType) }
    // Un-annotated local: classify the initializer through `letInitCellKind`, the same ladder
    // `collectLocals` types the binding with, resolved in the owning frame, so a captured
    // list, string or struct env field carries its real ref valtype. The frame is an arena
    // index and not an `fnStmts` position — `parentBindingFrameArenaOf` is that one home.
    if bn.letInit >= 0 {
      return letInitCellKind(b, parentBindingFrameArenaOf(fe, name))
    }
  }
  "i32"
}

// The second `fbValtype` argument, the table index, for a captured ref variable. An
// annotated binding resolves it through `annValtypeSlotOf`, the one home for which interned
// slot an annotation selects, and `captureValKind` hands the same annotation node to
// `vtKindOfType`, so kind and index cannot come from different ladders.
export function captureValStructIdx(fe: i32, name: string) {
  const b = parentBindingOf(fe, name)
  if b < 0 {
    // The loop-variable pair's second half (D1142) — `captureValKind`'s companion, from the
    // same home `declareForInLocals` reads. A kind without its slot is a loud reject and not
    // a fallback, so the two arms land together.
    const lvIter = captureLoopVarIterOf(fe, name)
    if lvIter >= 0 {
      return forInVarStructIdx(lvIter, parentBindingFrameArenaOf(fe, name))
    }
    return -1
  }
  const bn = P.nodes[b]
  // D891 — a captured parameter whose slot the `??` merge moved reads its env field at the
  // merged row too. The third resolver of the same owner; see `anonLeafParamRowOf`.
  if bn is Param { return anonLeafParamRowOf(b, annValtypeSlotOf(bn.parType)) }
  if bn is LetDecl {
    if bn.letType >= 0 { return annValtypeSlotOf(bn.letType) }
    if bn.letInit >= 0 {
      // The owning frame as an arena index — the same conversion `captureValKind`'s
      // un-annotated arm makes, and for the same reason: `letIsMap`, `letIsNulRef` and
      // `letIsRefArray` all forward `pf` to `P.nodes[pf]`.
      const pf = parentBindingFrameArenaOf(fe, name)
      // The kind-specific companion index, arm for arm with `letInitCellKind` and with the
      // slot arguments `collectLocals` passes `addLocalName` for the same bindings. A kind
      // without its slot is a loud reject and not a fallback: `fbValtype`'s bounds guard
      // turns a -1 on any ref kind into `ref valtype with no interned shape` (D21).
      if letIsNulMap(b, pf) { return nulMapShapeOf(b, pf) }
      if letNulMapReadValKind(b, pf) != null {
        return letNulMapReadSlotArg(b, pf)
      }
      if letIsMap(b, pf) { return letMapShapeOf(b, pf) }
      if letIsNulVariant(b, pf) { return nulVariantIdxOfLet(b, pf) }
      if letIsNulRef(b, pf) { return nulRefStructIdxOfLet(b, pf) }
      if letIsNulRefArray(b, pf) { return nulRefArrayInnerSlotOfLet(b, pf) }
      if letIsRefArray(b, pf) && !letIsUnion(b, pf) {
        return letRefListSlot(b, pf)
      }
      if letIsVariant(b, pf) { return variantIndexOfLet(b, pf) }
      // The struct rung is a `letIs*` classifier like every rung above it (D731):
      // `letInitCellKind` types this env field `"struct"` for every struct-valued initializer,
      // so a slot column answering only for a bare object literal leaves the pair
      // (`"struct"`, -1). `structIndexOfLet` is the ladder `collectLocals` runs one class over.
      if letIsStruct(b, pf) {
        const csi = structIndexOfLet(b, pf)
        if csi < 0 {
          const cov = letObjLitVariantIdx(b)
          if cov >= 0 { return cov }
        }
        return csi
      }
    }
  }
  -1
}

// ── the declaration-site narrowing of a capture: record, look up, replay ──────
// `capNarrowRecord` banks the narrowing stack at a nested function's declaration site, only
// from `capScan` and only while `capNarrowBuild` walks; `capNarrowSlotOf` finds a banked
// record; `capNarrowSeed` replays it for the walk of that frame's body.

// Push the narrowing of `condIx`'s then-arm, or with `elseSide` its complement, while
// `capNarrowBuild` walks. The flag dance is a re-entrancy guard: `setNarrowFromCond` runs
// classifiers, a classifier may ask for a capture list, and before `capCacheBuild` that list
// is recomputed by `capScan`, which re-enters here until the compiler's stack is exhausted.
function cnSetNarrow(condIx: i32, elseSide: boolean) {
  cnRecording = false
  if elseSide {
    setNarrowFromCondElse(condIx, cnScanFnIx)
  } else {
    setNarrowFromCond(condIx, cnScanFnIx)
  }
  cnRecording = true
  0
}

// The post-guard narrowing dual of `cnSetNarrow`, with the same re-entrancy guard.
function cnPostGuard(stmtIx: i32) {
  cnRecording = false
  pushPostGuardNarrow(stmtIx, cnScanFnIx)
  cnRecording = true
  0
}

// Bank the narrowing active at the declaration site of the nested function at arena index
// `fnIx`, for each of its free names. One record per frame and name; under nested guards the
// innermost is appended last and `capNarrowSlotOf` reads backward, so the innermost wins —
// the same rule `narrowSlotOf` applies to the live stack.
function capNarrowRecord(fnIx: i32, ifree: string[]) {
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return 0 }
  let i = 0
  while i < narrowTop {
    const nm = narrowNames[i]
    // A retired entry is not a declaration-site fact: the closure below the write reads its
    // capture at the declared rep, the same as the live stack answers for it.
    if capHas(ifree, nm) && narrowRetired[i] == 0 {
      cnFe.push(fe)
      cnName.push(nm)
      cnVariant.push(narrowVariants[i])
      cnTy.push(narrowTys[i])
      cnSet.push(narrowSets[i])
    }
    i = i + 1
  }
  0
}

// The record index of the declaration-site narrowing of `name` in frame `fe`, or -1.
// Scanned backward so the innermost banked narrowing answers (see `capNarrowRecord`).
function capNarrowSlotOf(fe: i32, name: string) {
  let i = cnFe.length - 1
  while i >= 0 {
    if cnFe[i] == fe {
      if cnName[i] == name { return i }
    }
    i = i - 1
  }
  -1
}

// Bank the declaration-site narrowing of every frame declared inside frame `fe`'s body, by
// scanning that body with the narrowing stack live. Called twice per frame and it has to be:
// a param's union-ness resolves from the arena, a function-scope local's only from the
// emit-time table `buildLocals` fills, so `emitFuncCode` re-banks after it, appending.
export function capNarrowRecordFrame(fe: i32) {
  const savedTop = narrowTop
  cnRecording = true
  capComputeNamesOf(fe)
  cnRecording = false
  cnScanFnIx = -1
  restoreNarrow(savedTop)
  0
}

// Rebuild the declaration-site narrowing table from the current arena. Runs before each
// `computeRetInference` (the classifier needs it to type a closure whose return is a
// narrowed captured read) and again after monomorphization, which renumbers `fnStmts`
// and therefore every recorded frame position.
export function capNarrowBuild() {
  cnFe = []
  cnName = []
  cnVariant = []
  cnTy = []
  cnSet = []
  const savedTop = narrowTop
  cnRecording = true
  let fe = 0
  while fe < fnStmts.length {
    if fe >= fnParent.length || fnParent[fe] < 0 { capComputeNamesOf(fe) }
    fe = fe + 1
  }
  // Module-level statements are the start function's body. A closure written there has no
  // enclosing frame to capture from, but a top-level `if` still narrows a module global,
  // and the frames declared under it are frames like any other.
  cnScanFnIx = -1
  const sbound: string[] = []
  const scaps: string[] = []
  let si = 0
  while si < startStmts.length {
    capScan(startStmts[si], sbound, scaps)
    si = si + 1
  }
  cnRecording = false
  cnScanFnIx = -1
  restoreNarrow(savedTop)
  0
}

// Replay frame `fe`'s declaration-site narrowing onto the narrowing stack, so a walk over
// `fe`'s body answers every rep question about a captured read under the narrowing the
// closure is written inside. Gated on the capture's rep being the value-union box, the only
// rep whose read needs a narrowing to pick an unboxing. Returns the depth to restore to.
export function capNarrowSeed(fe: i32) {
  const saved = narrowTop
  if fe < 0 { return saved }
  if cnFe.length == 0 { return saved }
  const caps = captureNamesOf(fe)
  let ci = 0
  while ci < caps.length {
    const nm = caps[ci]
    const si = capNarrowSlotOf(fe, nm)
    if si >= 0 {
      if captureValKind(fe, nm) == "union" {
        pushNarrowRep(nm, cnVariant[si], cnTy[si], cnSet[si])
      }
    }
    ci = ci + 1
  }
  saved
}

// Enter a new lexical block: remember the current binding count as this frame's
// boundary. Returns 0.
export function scopePush() {
  scopeFrames.push(scopeNames.length)
  0
}

// Leave the innermost lexical block: drop its frame boundary and discard every
// binding appended within it (truncate `scopeNames`/`scopeSlots` back to the mark).
// Returns 0.
export function scopePop() {
  if scopeFrames.length == 0 { return 0 }
  const mark = scopeFrames[scopeFrames.length - 1]
  scopeFrames.pop()
  while scopeNames.length > mark {
    scopeNames.pop()
    scopeSlots.pop()
  }
  0
}

// Bind name `name` to declared-local position `slot` in the innermost frame. Called as each
// `let` is reached, so a binding is in scope only after its declaration, which also yields
// correct shadowing of an outer same-named binding. Returns 0.
export function scopeBind(name: string, slot: i32) {
  scopeNames.push(name)
  scopeSlots.push(slot)
  0
}

// Drop the most recent binding — the loop-variable unbind. A `for` binds its variable in the
// enclosing frame, but the variable's scope is the loop, so both passes unbind it as the loop
// closes. Without it the loop var keeps shadowing a same-named binding that resolves through
// a later channel, and `for i in …` followed by `let i = 0` reads the dead loop counter.
export function scopeUnbind() {
  scopeNames.pop()
  scopeSlots.pop()
  0
}

// Opening a control frame: bump the running depth. Returns 0.
export function ctrlEnter() {
  ctrlDepth = ctrlDepth + 1
  0
}

// Closing a control frame (its matching `end`): drop the running depth. Returns 0.
export function ctrlLeave() {
  ctrlDepth = ctrlDepth - 1
  0
}

// The wasm local base of the ref-push scratch frame for ref-list table slot `slot`.
export function refPushScratchBaseFor(slot: i32) {
  let i = 0
  while i < fnRefPushSlots.length {
    if fnRefPushSlots[i] == slot { return refPushBaseBySlot[i] }
    i = i + 1
  }
  // No slot, no frame, and a fall-through here can never be right: with `fnRefPushSlots` empty
  // `refPushScratchBase` is the cursor past every reserved frame, and with it non-empty it
  // names a quad typed for a different element. It is reached when the frame pre-pass, which
  // runs with no `is`-narrow active, classified this receiver differently from the emit.
  emitFail(
    "emitProgram: a ref-element list op needs its receiver's element type known before " +
      "the body is lowered; a union arm narrowed to a ref-element list is not yet reached " +
      "by that pass",
  )
  refPushScratchBase
}

// Resolve a value type-name to a struct table index: a declared struct by name, or an inline
// object type matched against the table by field set, since `collectAnonShapes` interns
// anonymous shapes under `#anonN` names the annotation text never matches. The match is
// field-type-guarded, so a same-fieldset outer literal cannot key the wrong row.
function structIndexByValName(name: string) { structIndexOfTypeName(name) }

// D871 — did a `??` family take the returned literals of the function declared at node
// `fnDeclIx`? The gate on every return-row redirect. See `anonLeafRetMoved`.
export function anonLeafRetMovedOf(fnDeclIx: i32): boolean {
  if fnDeclIx < 0 { return false }
  if fnDeclIx >= anonLeafRetMoved.length { return false }
  anonLeafRetMoved[fnDeclIx] == 1
}

// D940 — the `$fnsig` key a closure-typed parameter's slot must use, or "". Non-empty only
// where `anonLeafCloSlotMark` proved the slot receives exactly one function and the merge
// moved that function's rows. The kind tokens are identical either way and only the struct
// slot digits move, so what changes is the heap type the `call_indirect` checks against.
export function anonLeafCloSlotSigKey(pIx: i32): string {
  if pIx < 0 { return "" }
  if pIx >= anonLeafCloSlotFn.length { return "" }
  anonLeafMovedFnSigKey(anonLeafCloSlotFn[pIx])
}

// D1090 — the same answer at a binding. `anonLeafCloBindName` and `anonLeafCloBindFn` hold
// only bindings written with a function the merge moved, so "" here means this binding is not
// one of them and the annotation arms downstream get their turn unchanged.
function anonLeafCloBindSigKey(name: string): string {
  let i = 0
  while i < anonLeafCloBindName.length {
    if anonLeafCloBindName[i] == name {
      return anonLeafMovedFnSigKey(anonLeafCloBindFn[i])
    }
    i = i + 1
  }
  ""
}

// The `$fnsig` key the function named `nm` actually interned, or "" — the half
// `anonLeafCloSlotSigKey` and `anonLeafCloBindSigKey` share.
function anonLeafMovedFnSigKey(nm: string): string {
  if nm == "" { return "" }
  let fe = 0
  while fe < fnStmts.length {
    const fd = P.nodes[fnStmts[fe]]
    if fd is FuncDecl {
      if fd.fnName == nm {
        const k = cloSigKeyExt(fe)
        // An un-interned key is one nothing can `call_indirect` at; keep the annotation's.
        if k != "" && cloSigPosOfKey(k) >= 0 { return k }
        return ""
      }
    }
    fe = fe + 1
  }
  ""
}

// D833 — the row a `??` merge put in `si`'s place, or `si` unchanged. `collectAnonShapes`
// records one only where a merged row exists for a family a narrower same-fieldset row
// already claimed, so outside that shape every row supersedes to itself and this is one
// bounds-checked array read. See `anonLeafSupersede`.
export function anonLeafSupersedeOf(si: i32): i32 {
  if si < 0 { return si }
  if si >= anonLeafSupersede.length { return si }
  if anonLeafSupersede[si] < 0 { return si }
  anonLeafSupersede[si]
}

// D911 — the return-row redirect as one call: the mark and the supersede together, so a site
// following a `??` merge cannot pick up one half and miss the other. `fnDeclIx` is the arena
// node of the owning `FuncDecl`. The sites that spell the pair out longhand each carry a
// different extra gate; this is for the readers that need only the pair.
export function anonLeafRetRowOf(fnDeclIx: i32, si: i32): i32 {
  if !anonLeafRetMovedOf(fnDeclIx) { return si }
  anonLeafSupersedeOf(si)
}

// The single non-null member of a niche-nullable map value name — `{f: …} | null` yields the
// struct member, `{[string]: V} | null` the map member — or "" when there is not exactly one
// non-null member of a kind the nullable-value map rep covers. The chokepoints strip through
// it, so the slot shares its vals rep with the non-null twin.
export function nulRefMapValInnerOf(valName: string): string {
  if !unionSetHasNull(valName) { return "" }
  let nonNull = 0
  let from = -1
  let to = -1
  let st = 0
  let go = true
  while go {
    const at = tyTopIndexOf(valName, '|', '=', st)
    let en = valName.length
    if at >= 0 && valName[at] != '=' { en = at } else { go = false }
    if !spanEqAt(valName, st, en, "null") {
      nonNull = nonNull + 1
      from = st
      to = en
    }
    if go { st = at + 1 }
  }
  if nonNull != 1 { return "" }
  const inner = valName.slice(from, to)
  if inner == "string" { return inner }
  if nameIsBareMap(inner) { return inner }
  // A closure member keeps its grouping parens, so the arrow sits at paren depth 1: the fat
  // pointer rides the same `(ref null $cloStruct)` vals element a non-null closure uses. A
  // top-level arrow on the raw member would be a function returning a nullable, which
  // `splitUnionAtoms` never produces.
  if annArrowAt(peelGroupParens(inner)) >= 0 { return inner }
  // A list member rides the same vals rep its non-null twin does, since a ref-valued map's
  // vals element is `(ref null <elem>)` for every value kind — the wrapper element, not the
  // element struct's. Answered above the struct probe: `structIndexByValName`'s field-name
  // parse ignores a trailing `[]`, so `{f: f64}[]` would match the element struct.
  if nameIsArray(inner) {
    if scalarListKindOfName(inner) >= 0 { return inner }
    if nameIsRefArray(inner) { return inner }
    return ""
  }
  if structIndexByValName(inner) >= 0 { return inner }
  ""
}

// True when the interned mv slot's value is a niche-nullable ref value: the vals element
// legitimately holds null — the store seeds `ref.null <elem>` for a bare `null` and the fused
// `?? d` read skips the non-null recover.
export function mvSlotNullable(slot: i32) {
  if slot < 0 { return false }
  const ar = mvValNulRefNicheAt(slot)
  if ar >= 0 { return ar == 1 }
  nulRefMapValInnerOf(mvValName[slot]) != ""
}

// True when a boxed value-union map slot's value is exactly `scalar | null`: the fused
// `m[k] ?? d` coalesce peels it to the raw unboxed scalar rather than a union box, so the
// `??` result classifies as that scalar. A multi-member `A | B | null` stays a boxed union.
function mvUnionIsScalarNull(slot: i32) {
  if slot < 0 { return false }
  if mvValKind[slot] != 2 { return false }
  const ar = mvValUnionScalarNullAt(slot)
  if ar >= 0 { return ar == 1 }
  const vn = mvValName[slot]
  if !unionSetHasNull(vn) { return false }
  const atoms: string[] = []
  splitUnionAtoms(vn, atoms)
  if atoms.length != 2 { return false }
  // Not migrated onto the set ADT: this tail sits behind the arena chokepoint
  // `mvValUnionScalarNullAt` and a two-member gate, with no witness to verify a migration
  // against, so it keeps the string surgery.
  const ak = valueAtomKind(removeAtomFrom(vn, "null"))
  ak >= 0 && ak != 2 && ak != 6
}

// The one home of the scalar-element list classification: which of the five scalar backings a
// list type-name rides (0 i32-backed and its niches, 1 string, 2 `f64[]`, 3 `i64[]`, 4
// `f32[]`), or -1. The predicates are pairwise disjoint, so arm order is not load-bearing.
// `tyAnnRefListKind` and `nulScalarListKind` are not folded in: they split what this folds.
export function scalarListKindOfName(t: string): i32 {
  if nameIsI32Array(t) { return 0 }
  if nameIsStringArray(t) { return 1 }
  if nameIsF64Array(t) { return 2 }
  if nameIsI64Array(t) { return 3 }
  if nameIsF32Array(t) { return 4 }
  -1
}

// True if the bare map spelling `mapName` has a value type the mv layer can lower —
// `mvValKindOfName` of its value, tested against the `-3` unsupported sentinel. One home for
// the classifier gates that would otherwise each spell out the slice and the sentinel, and
// each have to be found again if the sentinel moves.
function mapValKindLowerable(mapName: string) {
  mvValKindOfName(mapValNameOf(mapName)) != -3
}

// 1 when this map value type unambiguously lowers, 0 for "ask the spelling". A strict subset
// of `mvValKindOfName`'s lowering set, read off the type rather than off a render. A shape
// this cannot decide must answer 0: claiming one the name ladder would reject turns a loud
// refusal into a silent lowering.
function mvValLowersTy(ty: i32): i32 {
  if ty < 0 { return 0 }
  const t = T.tys[ty]
  if t is TyPrim {
    const p = t.primName
    if p == "i32" { return 1 }
    if p == "boolean" { return 1 }
    if p == "string" { return 1 }
    if p == "f64" { return 1 }
    if p == "i64" { return 1 }
    if p == "f32" { return 1 }
    return 0
  }
  if t is TyMap { return 1 }
  if t is TyFunc { return 1 }
  // A list value reaches `mvValKindOfName`'s two array arms and both answer kind 6, so every
  // array shape the classifier recognises lowers. The `-3` guard tests the top level, which an
  // array spelling never trips: `(T | null)[]` is an array with a nullable element.
  if t is TyArray { return 1 }
  // A struct-valued map is kind 1, the name ladder's last arm, which asks
  // `structIndexByValName` — a name lookup into the struct table. `isStructOfTy` is that same
  // registry question asked of the type. A bare struct value never trips the `-3` guard, so
  // reaching this arm means the ladder would reach its struct arm too.
  if t is TyObj {
    if isStructOfTy(ty) { return 1 }
    // The nominal half, paired with the name ladder's (D47): `isStructOfTy` answers no for a
    // union arm, since `collectS` skips a `type X = {…}` that is a union member, so the arm has
    // a `uVariants` row and no `sNames` one. This gate and the interner must not drift —
    // teaching only the interner leaves an arm-valued map's return at the mono i32 valtype.
    if variantRowOfTy(ty) >= 0 { return 1 }
  }
  // A nullable value with a single ref inner is a lowering branch, not a rejecting one: only a
  // closure inner whose result is a literal union rejects, and that shape is excluded rather
  // than reproduced. A union with no null member never reaches the `-3` guard at all, which is
  // entered only under `unionSetHasNull`, so the kind dispatch below claims it.
  if t is TyNullable {
    const inr = t.nInner
    if inr >= 0 {
      const it2 = T.tys[inr]
      if it2 is TyObj { return 1 }
      if it2 is TyMap { return 1 }
      if it2 is TyArray { return 1 }
      // Any prim inner, not just `string`: a non-ref inner leaves `nulRefMapValInnerOf` empty
      // and falls to the atom counting, where a prim is a value atom, and the only remaining
      // `-3` there needs `!isValueUnionName`, which `prim | null` is not.
      if it2 is TyPrim { return 1 }
      // A closure inner lowers as the nullable fat-pointer unless its result is a literal
      // union, the branch's one reject. Reproduced faithfully rather than approximated:
      // `tyIsLitUnion` of the return type is the same question the name ladder asks of the
      // rendered return spelling.
      if it2 is TyFunc {
        if !tyIsLitUnion(it2.fnRet) { return 1 }
      }
      // A nullable union value lands in the atom counting, whose second `-3` needs
      // `!isValueUnionName`. That predicate is copied rather than re-derived: every atom must
      // have a `valueAtomKind` — the prims, `null`, and the list atoms — with at least two
      // non-null; a paraphrase treating arrays as refs, which `valueAtomKind` does not, is inert.
      if it2 is TyUnion {
        const ims = it2.uMembers
        let allAtoms = true
        let nonNull = 0
        let m2 = 0
        while m2 < ims.length {
          const mt2 = T.tys[ims[m2]]
          let isAtom = false
          let isNull = false
          if mt2 is TyPrim {
            isAtom = true
            if mt2.primName == "null" { isNull = true }
          }
          if mt2 is TyArray { isAtom = true }
          if tyIsLitUnion(ims[m2]) { isAtom = true }
          if !isAtom { allAtoms = false }
          if !isNull { nonNull = nonNull + 1 }
          m2 = m2 + 1
        }
        if allAtoms {
          if nonNull >= 2 { return 1 }
        }
      }
    }
  }
  if t is TyUnion {
    const ms = t.uMembers
    if ms.length > 1 {
      let anyNull = false
      let k = 0
      while k < ms.length {
        const mt = T.tys[ms[k]]
        if mt is TyNullable { anyNull = true }
        if mt is TyPrim {
          if mt.primName == "null" { anyNull = true }
        }
        k = k + 1
      }
      if !anyNull { return 1 }
    }
  }
  0
}

// The recorded-type twin of `mapValKindLowerable`. The name rung renders the value and
// classifies the render, so this asks the arena first and falls through to the render only
// for a value kind `mvValLowersTy` declines.
function mapNodeValKindLowerable(ix: i32) {
  const mty = nodeTyIxOf(ix)
  if mty >= 0 {
    const mt = T.tys[mty]
    if mt is TyMap {
      if mvValLowersTy(mt.mVal) == 1 { return true }
    }
  }
  mvValKindOfName(nodeTyMapValName(ix)) != -3
}

// The mv value kind of a map value type-name — the one enumeration of which value types a
// string-keyed map supports: `-1` a mono i32 value riding the shared `$mapStruct`, `-3`
// unsupported, else the per-slot kind. Read by both `mvShapeOfValName`, the slot interner, and
// `retMapFlag`, the param and return valtype gate, so the two cannot drift.
export function mvValKindOfName(valName: string): i32 {
  if valName == "i32" || valName == "boolean" { return -1 }
  // A literal-union atom value: each value is the interned atom code, a plain i32, so the map
  // is the mono i32 map. Checked before the union arm, whose member count would otherwise
  // claim the alias and box the values.
  if nameIsLitUnionType(valName) { return -1 }
  // A nullable-atom value that reps as a plain i32 niche with no box — a nullable litunion
  // (atom ids, `-1` for null) or a nullable boolean (0/1, `2` for null). Each value is an i32
  // with a spare sentinel, so the map is the mono i32 map. Checked before the union arm, whose
  // member count would else box a raw i32 niche into a `(ref $box)` cell.
  if nameIsNulLitUnion(valName) || nameIsNulBool(valName) { return -1 }
  // A nullable union value has three sound shapes: a niche nullable ref value — one struct,
  // map or list member plus null — riding the same vals rep as its non-null twin; a pure
  // scalar nullable value-union, which boxes; and one with two or more non-null members, which
  // falls to the union arm. The remainder is a list element the kind-6 pair does not name.
  if unionSetHasNull(valName) {
    const nin = nulRefMapValInnerOf(valName)
    if nin != "" {
      if nin == "string" { return 3 }
      if nameIsMap(nin) { return 6 }
      // A nullable-closure value is kind 14: the vals element is already the
      // `(ref null $cloStruct)` fat-pointer, so the niche rides the non-null closure rep. A
      // litunion result stays a loud reject — the read stays nullable, so the call needs a
      // narrowed spelling the checker does not accept for this value shape.
      const ncl = peelGroupParens(nin)
      const nca = annArrowAt(ncl)
      if nca >= 0 {
        // The arrow-relative return cut at its home, given the index this site holds. The
        // leading-space skip stays here: an annotation spelling keeps the source's spaces and
        // `nameIsLitUnionType` opens with an exact `cUserTypes` lookup, which a leading space
        // would miss.
        const nret = fnRetTextOf(ncl, nca)
        let nri = 0
        while nri < nret.length && nret[nri] == ' ' { nri = nri + 1 }
        if nameIsLitUnionType(nret.slice(nri, nret.length)) { return -3 }
        return 14
      }
      // A nullable list value is kind 6, the same kind the non-null list value gets: the vals
      // element is the list wrapper ref and it is already `(ref null <wrapper>)`, so a stored
      // `null` is `ref.null` of that wrapper. The two predicates are this ladder's own kind-6
      // pair, so the niche and its non-null twin cover the same element reps.
      if scalarListKindOfName(nin) >= 0 { return 6 }
      if nameIsRefArray(nin) { return 6 }
      return 1
    }
    const nulAtoms: string[] = []
    splitUnionAtoms(valName, nulAtoms)
    let nonNull = 0
    let refMember = false
    let na = 0
    while na < nulAtoms.length {
      if nulAtoms[na] != "null" {
        nonNull = nonNull + 1
        const nvk = valueAtomKind(nulAtoms[na])
        if nvk < 0 || nvk >= 7 { refMember = true }
      }
      na = na + 1
    }
    if refMember && nonNull < 2 { return -3 }
    if !refMember && !isValueUnionName(valName) { return -3 }
  }
  let kind = -1
  if valName == "string" {
    kind = 3
  } else if valName == "f64" {
    // An f64-valued map: its vals list is the scalar f64 list, not a ref list. It rides the
    // existing mv-slot frame, but the value is a scalar, so its typed valStash is an f64
    // local rather than a nullable ref.
    kind = 11
  } else if valName == "i64" {
    // An i64-valued map: the scalar i64 list (`$il64TypeIdx`/`$ia64TypeIdx`); valStash i64.
    kind = 10
  } else if valName == "f32" {
    // An f32-valued map: the scalar f32 list (`$fl32TypeIdx`/`$fa32TypeIdx`); valStash f32.
    kind = 13
  } else if nameIsBareMap(valName) {
    // A nested map: the value is an inner map struct ref, stored in a ref list whose element
    // kind is 3, reusing the same ref-value spine as a struct-valued map. The member-union
    // guard keeps a map-first union value out of this arm, so it reaches the union arm below.
    // The inner-value chain resolves recursively to any depth through `mvShapeOfValName`.
    kind = 6
  } else if scalarListKindOfName(valName) >= 0 {
    // A list-valued map: the value is a list wrapper ref, stored in a ref list whose element
    // kind picks the inner list's wrapper. Same ref-value spine as a nested map.
    kind = 6
  } else if nameIsRefArray(valName) {
    // Any ref-array map value — a struct list, a union list, a nested `S[][]`, a closure list
    // — is a list wrapper ref stored in a ref-value list whose element is this value's
    // wrapper. The store seeds the value literal off this slot and the read classifies the
    // element recursively, so any nesting falls out with no per-shape special cases.
    kind = 6
  } else if unionMemberCount(unionMemberSetOf(valName)) > 1 {
    // A union-valued map: each value is the shared union box ref, stored in a ref list whose
    // element kind is 2 — the same ref-value spine as a struct value, differing only in the
    // element heap and the store-coerce. A map member boxes exactly as it does in binding
    // position, and `markMapUnionArms` interns the arm's mv slot so tag and read agree.
    kind = 2
  } else if annArrowAt(valName) >= 0 {
    // A function-valued map: each value is a closure fat-pointer stored in a ref list whose
    // element kind is 5, the same rep an `((i32) => i32)[]` array uses. A litunion result
    // rides it too — the call's `$fnsig` keys the i32 atom and the atom widens at the print
    // seam, since `exprString` gates its `>S` claim on the call node's litunion-alias type.
    kind = 14
  } else {
    if structIndexByValName(valName) >= 0 { kind = 1 }
    // The nominal half of that rung (D47): `structIndexByValName` is a `sNames` lookup and
    // `collectS` skips a `type X = {…}` that is a union member, so an arm spelled by its own
    // name has no struct row. Reached only by the name-keyed gates, which do not canon and
    // must not disagree with the interner. Nominal: an exact `uVariants` lookup, no shape scan.
    if kind < 0 && variantIndexOf(valName) >= 0 { kind = 1 }
    // The shape rung the adopter already took (D671), reached only when both lookups above
    // decline — the one state in which the render names no row at all, and one the node side
    // put it in. `mvValRowOfShape` is the name-keyed reading of `collectAnonShapes`' own gate:
    // a literal whose `#anon` row is suppressed because a declared row or an arm adopts it.
    if kind < 0 && mvValArmOfShape(valName) >= 0 { kind = 1 }
    if kind < 0 && mvValRowOfShape(valName) >= 0 { kind = 1 }
  }
  if kind < 0 { return -3 }
  kind
}

// The row an adopted shape names — the name-keyed twin of `collectAnonShapes`' suppression
// gate, in two halves with `mvValRowOfShape`. `collectAnonShapes` mints an `#anonN` row for
// an object literal unless a node-side resolver already gave it one, so the shape has exactly
// one row and it is the adopter's; the mv layer's four readers all come here (D671).
export function mvValArmOfShape(name: string): i32 {
  if !nameIsWholeSpanShape(name) { return -1 }
  if structIndexByValName(name) >= 0 { return -1 }
  variantIndexOfTypeName(name)
}

// The struct half: the declared row `structIndexOfObj` adopted the literal onto. -1 for a
// name that is not a whole-span shape, or one no adopter would have claimed.
export function mvValRowOfShape(name: string): i32 {
  if !nameIsWholeSpanShape(name) { return -1 }
  const fnames: string[] = []
  const ftypes: string[] = []
  shapeFieldParse(name, fnames, ftypes)
  let si = 0
  while si < sScanLim() {
    // The half-built-row guard `shapeRowScanK` carries, for the same reason: a code-5
    // element-name computation re-enters this scanner mid-field-loop.
    if sFieldStart[si] + sFieldCount[si] > sFieldElemName.length {
      si = si + 1
      continue
    }
    // An anonymous row's codes are read off a literal, so they are exact and the strict scan
    // above already had its chance at them; only a declared row adopts.
    if sFieldCount[si] == fnames.length && !sIsAnonRow(si) {
      let ok = true
      let k = 0
      while k < fnames.length {
        const fj = sFieldIndex(si, fnames[k])
        if fj < 0 { ok = false }
        else if !adoptedFieldCompat(ftypes[k], si, fj) { ok = false }
        k = k + 1
      }
      if ok { return si }
    }
    si = si + 1
  }
  -1
}

// Could a value of the field type spelled `t` be adopted into row `si`'s field `fj`?
// `anonValueFitsField`'s declared-row tier, read off a spelling rather than off a value node:
// the two scalar pairs no adoption can bridge refute, and a nested-struct field keeps the
// canonical-rep tightening, so two arms sharing a field-name set cannot collide.
function adoptedFieldCompat(t: string, si: i32, fj: i32): boolean {
  const want = fieldCodeForMatch(fieldElemTyIxOfName(t))
  const code = sFieldTypeAt(si, fj)
  if want == code {
    if code == 15 {
      return nestedStructNamesCompat(t, sFieldElemNameAt(si, fj))
    }
    return true
  }
  // An integer or boolean value into a string slot, or a string into a plain i32 one — the
  // two pairs `anonValueFitsField` refutes against every row. A code-0 slot recording a
  // literal-union name is the atom slot a string literal legitimately writes.
  if want == 0 && code == 3 { return false }
  if want == 3 && code == 0 { return sFieldElemNameAt(si, fj) != "" }
  // A nested-struct or closure slot takes neither a scalar nor a string.
  if code == 15 || code == 14 { return false }
  if want == 15 || want == 14 { return false }
  true
}

// Canonicalize a map-value union name for the mv table so two spellings of one value union
// cannot intern twin mv slots with divergent vals reps, which makes a narrowed map read
// resolve the wrong twin's struct. The canon is a descent, not a widening: it reaches litunion
// atoms nested under `[]` and `{…}`, and a litunion-alias atom is preserved at every depth.
export function mvCanonValName(valName: string) {
  // Runaway cap: a value spelling this long is never a legitimate mv key, so pass it through
  // untouched and let the kind classifier's `-3` path fail loudly instead of rendering it.
  if valName.length > 4096 { return valName }
  // A ref-list value: canon its element union through the array wrapper, the same canon
  // `rlInternName` keys the vals ref-list slot on. Without it an annotation spelling and a
  // self-inferred factory-return lambda mint twin mv and map structs, a cast trap at the
  // returned-map read. Func-type element arrays are left untouched inside.
  if nameIsElemArray(valName) { return rlCanonLitUnionAtoms(valName) }
  // A struct or nested-map value: canon its field and value unions through the shape, the
  // struct sibling of the `[]` arm above; what it reconciles is the nesting, not the alias.
  // The wide brace-endpoint span is deliberate — this arm must see a map value as well as a
  // struct one, so it is neither `nameIsShapeSpanEnds` nor `nameIsWholeSpanShape`.
  if nameIsBraceSpanEnds(valName) { return rlCanonLitUnionAtoms(valName) }
  if unionMemberCount(valName) < 2 { return valName }
  canonLitUnionArms(valName)
}

// The litunion-arm canon, written once: `mvCanonValName` and `rlCanonLitUnionAtoms` would
// otherwise each carry this split, niche guard and descent loop, and two copies of a union
// grammar are two copies of the split inside it. There is no widening leg — the preserve
// ruling, `docs/internals/litunion-compact-rep-design.md`. What survives is the descent.
function canonLitUnionArms(name: string): string {
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  let hasOther = false
  let h = 0
  while h < atoms.length {
    if atoms[h] != "null" && !nameIsLitUnionType(atoms[h]) { hasOther = true }
    h = h + 1
  }
  if !hasOther { return name }
  let changed = false
  let canon = ""
  let i = 0
  while i < atoms.length {
    let a = atoms[i]
    // A litunion-alias atom is preserved (the preserve ruling,
    // `docs/internals/litunion-compact-rep-design.md`): re-widening it here would query the
    // union registry under a spelling no row is minted with, so registration and query would
    // stop agreeing.
    if !nameIsLitUnionType(a) && a != "null" {
      const ra = rlCanonLitUnionAtoms(a)
      if ra != a {
        a = ra
        changed = true
      }
    }
    if i > 0 { canon = canon + "|" }
    canon = canon + a
    i = i + 1
  }
  if changed { return canon }
  name
}

// The mv table's name scan — first match wins over the recorded canonical value spellings,
// within one key rep. The `keyI32` argument is the slot identity's other half: `{[string]: S}`
// and `{[i32]: S}` record the same value spelling and are two layouts, so a key-blind scan
// would hand the second map the first one's struct.
export function mvSlotByValNameK(valName: string, keyI32: boolean): i32 {
  mvSlotByValNameKArm(valName, keyI32, MV_ARM_NOHINT)
}

// The name rung's half of the arm component (D48). Both rungs of an mv slot's identity have
// to carry it or neither does: a spelling is a render here, so an arm and its layout twin
// record the same `mvValName`. Tri-state as `mvSlotOfTyKArm` documents — `MV_ARM_NOHINT`
// matches any parity and is what every un-hinted entry point passes.
function mvSlotByValNameKArm(
  valName: string,
  keyI32: boolean,
  armHint: i32,
): i32 {
  let i = 0
  while i < mvValName.length {
    if mvValName[i] == valName {
      if mvSlotKeyI32(i) == keyI32 {
        if mvSlotArmMatches(i, armHint) { return i }
      }
    }
    i = i + 1
  }
  -1
}
// The mv shape of a bare map spelling — `mvShapeOfValName` of the map's value. One home, so
// that getting from `{[string]: V}` to its value rep is decided once rather than at each call
// site. This is also the one place the key enters the mv layer: every other resolver takes it
// as an argument, so an i32-keyed map's value interns against the i32 key rep untaught.
export function mvShapeOfMapName(mapName: string) {
  mvShapeOfMapNameArmTy(mapName, -1)
}

// `mvShapeOfMapName` plus the arm-only type hint (D34). `armTy` is the map value's arena type
// as the caller's node recorded it, used for exactly one question inside the mint — whether
// the value is a declared union arm. It never reaches a slot lookup rung: a better answer at
// the find rung skips the mint, while one consulted after cannot move which slot is minted.
export function mvShapeOfMapNameArmTy(mapName: string, armTy: i32) {
  const ki = nameIsI32KeyedMap(mapName)
  const sh = mvShapeOfValNameArmTy(mapValNameOf(mapName), ki, -1, armTy)
  // A mono value — i32, boolean, a literal-union atom or a nullable atom — rides the shared
  // i32 `vals` list and needs no per-value struct, so it is the `-1` string-keyed or `-4`
  // i32-keyed sentinel every value-blind classifier already reads as the mono rep.
  if sh == -1 { return mapMonoShapeOfKey(ki) }
  sh
}

// The mv shape of the map type the checker recorded on node `ix` — the intern-side twin of
// the `nodeTyIsMap` fall-through in `mapShapeOfExpr`, and the mint an un-annotated map has no
// other route to. The rung order is `mvShapeOfMapName`'s, read off the node. Not fronted with
// `nodeMapValTyIx` though the caller holds it: this path mints, and an arena leg would skip it.
export function mvShapeOfMapNodeTy(ix: i32) {
  if !nodeTyIsMap(ix) { return -1 }
  const ki = nodeTyMapKeyIsI32(ix)
  if nodeTyMapValIsLitUnion(ix) { return mapMonoShapeOfKey(ki) }
  if nodeTyMapValIsNulLitUnion(ix) { return mapMonoShapeOfKey(ki) }
  const sh = mvShapeOfValNameArmTy(
    nodeTyMapValName(ix),
    ki,
    -1,
    nodeMapValTyIx(ix),
  )
  if sh == -1 { return mapMonoShapeOfKey(ki) }
  sh
}

// The map shape of the map type the checker recorded on node `ix` — the find-side twin of the
// mint `mvShapeOfMapNodeTy`, and the only route from an inferred map value type to its rep.
// The two atom rungs are load-bearing: an atom-valued map rides the mono i32 `vals` list and
// interns no slot, while its rendered value name collapses to `string`.
function mapFindShapeOfNodeTy(ix: i32) {
  const ki = nodeTyMapKeyIsI32(ix)
  if nodeTyMapValIsLitUnion(ix) { return mapMonoShapeOfKey(ki) }
  if nodeTyMapValIsNulLitUnion(ix) { return mapMonoShapeOfKey(ki) }
  // The name here is `tyToEmitName` of the very type `nodeMapValTyIx` returns — a render
  // followed by a re-parse of it. The type goes straight across; the rendered name stays
  // because the rungs below the arena leg are still name-keyed.
  const sh = mvSlotOfMapValNameOrMonoKTy(
    nodeTyMapValName(ix),
    ki,
    nodeMapValTyIx(ix),
  )
  if sh == -1 { return mapMonoShapeOfKey(ki) }
  sh
}

// Classify and intern a map value type-name, returning the binding's map shape code: `-1` for
// the mono i32 map, a slot `>= 0` for a ref or scalar value type, `-3` unsupported. Interning
// is idempotent. A struct value forces the element's ref-list types, and every ref-valued map
// forces the string-list keys and the mono map types the shared probe machinery rides on.
export function mvShapeOfValName(valNameIn: string) {
  mvShapeOfValNameK(valNameIn, false)
}

// The mono map shape of a key rep — the `-1` and `-4` pair, named once. A value riding the
// shared i32 `vals` list interns no slot on either key, so every resolver landing on "mono"
// still has to say which of the two structs it means.
function mapMonoShapeOfKey(keyI32: boolean) {
  if keyI32 { return -4 }
  -1
}

// The arena leg can front a find; it must not front a mint (D-MAPNODETY). This function is
// the mv-slot interner: its first rung asks whether a slot already exists, and everything
// below creates one when it does not, so a better answer there skips the mint and emits
// invalid wasm. The `rowTy` form below is the exception, since it carries the same input.
export function mvShapeOfValNameK(valNameIn: string, keyI32: boolean) {
  mvShapeOfValNameRowTy(valNameIn, keyI32, -1)
}

// The variant-table row a map-value slot's value is a declared arm of, or -1. Every consumer
// pairs it with the struct half and the two cannot both answer. Read through the slot's layout
// identity (D123) via `mvCanonRepOf`; `mvValVariantRawOf` is the exception by construction,
// since `mvCanonRepOf` asks this column and reading the canonical row would recurse.
function mvValVariantRawOf(slot: i32): i32 {
  if slot < 0 { return -1 }
  if slot >= mvValVariantIdx.length { return -1 }
  mvValVariantIdx[slot]
}
export function mvValVariantOf(slot: i32): i32 {
  mvValVariantRawOf(mvCanonRepOf(slot))
}
// The struct half of the same pair, bounds-guarded like every other parallel-table accessor.
// The mint's own push and `repMapValSlotsTwin`'s comparison read the column directly — the
// first has no canonical rep yet, the second is what defines one.
export function mvValStructIdxOf(slot: i32): i32 {
  const c = mvCanonRepOf(slot)
  if c < 0 { return -1 }
  if c >= mvValStructIdx.length { return -1 }
  mvValStructIdx[c]
}

// The bounds-guarded read of the cross-table twin column (every parallel-table
// accessor in this file carries one): an uncovered variant reads -1, which is "no
// cross-table merge" and is what every site meant before the column existed.
export function uVarSTwinAt(vi: i32): i32 {
  if vi < 0 { return -1 }
  if vi >= uVarSTwin.length { return -1 }
  uVarSTwin[vi]
}

// Is the union arm named `armName` contested — is there a declared struct row of its exact
// layout (D171)? `repSlotOfTy`'s structural-to-nominal bridge is the same unique-declared-twin
// question asked of the arm's own declaration index rather than of a render, which would
// re-resolve to a fresh anonymous row. False for a name that is not a registered arm.
export function armLayoutContested(armName: string): boolean {
  armLayoutContestedAt(variantIndexOf(armName))
}

// The index-taking primitive, for a caller that already holds the variant index and would
// otherwise render it to a name only to look the name back up. -1, not an arm at all, is not
// contested, which is what lets any caller ask this unconditionally.
function armLayoutContestedAt(vi: i32): boolean {
  if vi < 0 { return false }
  if vi >= uVarTyIx.length { return false }
  repSlotOfTy(uVarTyIx[vi]) >= 0
}

// The tri-state arm hint a caller's recorded value type produces (D48): `MV_ARM_NOHINT` when
// there is no type to ask, else the type's arm signature — the arm's declaration row, or -1
// for a resolved type that reaches no arm. Only the second may refuse an arm's slot. Nominal
// at every rung, and `mvArmSigOfTy` rather than `variantRowOfTy` so a map hop is followed.
export function mvArmHintOfTy(ty: i32): i32 {
  if ty < 0 { return MV_ARM_NOHINT }
  mvArmSigOfTy(ty)
}

// The typed-find entry point, since every caller of the mv slot find holds the value's type
// (D93). An un-hinted find matches a slot of any arm parity and lands on the first slot of
// that structural key; the hint is a pure function of the argument the caller already had. A
// find, therefore safe: a hint can only make one decline, never succeed where it failed.
export function mvSlotOfValTyK(valTy: i32, keyI32: boolean): i32 {
  const direct = mvSlotOfTyKArm(valTy, keyI32, mvArmHintOfTy(valTy))
  if direct >= 0 { return direct }
  // Through the null fold's wrapper on a miss (D1037): `type J = null | f64 | JO` fills its
  // placeholder with the fold as its single member, so `cUserTypes["J"]` is the wrapper while
  // a map value's `mVal` is the member inside it. Both are the type `J` and the slot is the
  // same slot; on a miss only, so no lookup that answers today can move.
  const wrap = nulFoldWrapperTyIxOf(valTy)
  if wrap >= 0 { return mvSlotOfTyKArm(wrap, keyI32, mvArmHintOfTy(wrap)) }
  -1
}

// The arm signature of a map-value type: the variant row the value is, or — one container
// further out — the row its transitive map value is, or -1 for a resolved type reaching no
// arm (D93). `variantRowOfTy` alone cannot answer the second, so `{[string]: Circle}` and
// `{[string]: Dot}` would share one slot. Nominal at every depth, so an anonymous value stays -1.
function mvArmSigOfTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  const v = variantRowOfTy(ty)
  if v >= 0 { return v }
  mvDeepArmOfTy(ty, 8)
}

// The name-side twin of `mvArmSigOfTy`, for the mint's fallback: the arm a rendered map value
// spelling reaches through its own value. `mapValNameOf` peels one `{[K]: V}` hop and
// `variantIndexOf` is the same nominal table lookup reached by index.
function mvArmSigOfName(nm: string, depth: i32): i32 {
  if depth <= 0 { return -1 }
  const direct = variantIndexOf(nm)
  if direct >= 0 { return direct }
  if !nameIsMap(nm) { return -1 }
  mvArmSigOfName(mapValNameOf(nm), depth - 1)
}

// The declared union arm a map value's arena type names, or "" when the value is not one —
// the mv layer's reading of the nominal question the ref-list element asks too. It must be
// asked of the type: every name this layer holds is a render, so an arm arrives spelled
// `{r:i32}` and `structIndexByValName` would accept it as the inline-shape row.
function mvValArmName(ty: i32): string {
  const vr = variantRowOfTy(ty)
  if vr < 0 { return "" }
  if vr >= uVariants.length { return "" }
  uVariants[vr]
}

export function mvShapeOfValNameRowTy(
  valNameIn: string,
  keyI32: boolean,
  rowTy: i32,
) {
  // The row-table callers' `rowTy` IS the value's own recorded type (the D5 field-row cell),
  // so it serves as the arm hint unchanged; a -1 bank is a -1 hint.
  mvShapeOfValNameArmTy(valNameIn, keyI32, rowTy, rowTy)
}

// The mv table's key for a value the caller's type says is a declared union arm: the arm's own
// name, whatever the caller spelled (D47). Two spellings of one map reach this layer as two
// names — an inline annotation hands over `Circle`, a hoisted alias `{r:i32}` — and the arm's
// name is the key computable from either. It cannot move a non-arm slot.
function mvArmKeyName(valNameIn: string, armTy: i32): string {
  const an = mvValArmName(armTy)
  if an != "" { return an }
  const dn = mvDeepArmKeyName(armTy)
  if dn != "" { return dn }
  const dd = mvDeepDeclKeyName(armTy)
  if dd != "" { return dd }
  valNameIn
}

// The variant row a map value type reaches through its own value, or -1 — the arm the render
// drops at a depth `mvValArmName` cannot see, because that one asks whether the value is an
// arm and this one whether it contains one. Depth-bounded: a recursive alias is a cycle in
// the arena, and the bound declines, which leaves the render the layer has always used.
function mvDeepArmOfTy(ty: i32, depth: i32): i32 {
  if ty < 0 { return -1 }
  if depth <= 0 { return -1 }
  const t = T.tys[ty]
  if t is TyMap {
    const v = variantRowOfTy(t.mVal)
    if v >= 0 { return v }
    return mvDeepArmOfTy(t.mVal, depth - 1)
  }
  -1
}

// The mv table's key for a map-valued map whose transitive value is a declared arm (D93) —
// `mvArmKeyName`'s rewrite one container out, which D47's cannot reach because the outer value
// is a `TyMap`. A key and not a refusal: a refusal would have to decide whether a
// differently-armed value will later claim the slot, a property of the pair a mint cannot see.
function mvDeepArmKeyName(armTy: i32): string {
  if mvDeepArmOfTy(armTy, 8) < 0 { return "" }
  tyToNominalName(armTy)
}

// The other side of the same pair (D93): the rung above rewrites the arm side's key, this one
// the side that is a declared struct. Both are needed — rewriting only the arm side leaves the
// other's key a render, and that render re-resolves through `resolveAnnot` to the index the
// arm's declaration owns. Gated on declaredness, so an anonymous value keeps its render.
function mvDeepDeclKeyName(armTy: i32): string {
  if mvDeepDeclOfTy(armTy, 8) == 0 { return "" }
  tyToNominalName(armTy)
}

// True when a map type's transitive value is a declared type — an arm or a struct row.
// Depth-bounded: a recursive alias is a cycle in the arena, and an unbounded descent would
// trap the compiler rather than answer.
function mvDeepDeclOfTy(ty: i32, depth: i32): i32 {
  if ty < 0 { return 0 }
  if depth <= 0 { return 0 }
  const t = T.tys[ty]
  if t is TyMap {
    if variantRowOfTy(t.mVal) >= 0 { return 1 }
    if structIndexOfTy(t.mVal) >= 0 { return 1 }
    return mvDeepDeclOfTy(t.mVal, depth - 1)
  }
  0
}

let mvShapeNest = 0

export function mvShapeOfValNameArmTy(
  valNameInRaw: string,
  keyI32: boolean,
  rowTy: i32,
  armTy: i32,
) {
  // A self-referential map value has no finite shape walk: this function, its caller and
  // `mvValRowOfShape` form a cycle stepping through `mapValNameOf`, and each lap expands the
  // spelling rather than repeating it, so a name-keyed re-entry guard cannot see it (D984).
  // `-1` degrades to the caller's mono shape, which is what an unenumerable value should get.
  if mvShapeNest > 32 { return -1 }
  mvShapeNest = mvShapeNest + 1
  const mvR = mvShapeOfValNameArmTyGo(valNameInRaw, keyI32, rowTy, armTy)
  mvShapeNest = mvShapeNest - 1
  return mvR
}

function mvShapeOfValNameArmTyGo(
  valNameInRaw: string,
  keyI32: boolean,
  rowTy: i32,
  armTy: i32,
) {
  const valNameIn = mvArmKeyName(valNameInRaw, armTy)
  const valName = mvCanonValName(valNameIn)
  const kind = mvValKindOfName(valName)
  if kind == -1 { return -1 }
  if kind < 0 { return -3 }
  // A niche-nullable value name resolves its struct or map identity — and keys its vals
  // ref-list slot — through the single non-null member, so the slot shares the vals rep and
  // the heap-type dedup with its non-null twin.
  let bare = valName
  const nin = nulRefMapValInnerOf(valName)
  if nin != "" { bare = nin }
  let vsi = -1
  if kind == 1 { vsi = anonLeafSupersedeOf(structIndexByValName(bare)) }
  // The adopted row (D671), read through the same resolver the kind rung used. Without it a
  // shape the kind rung admitted mints a slot whose struct column is -1 — a vals element over
  // no heap. Reached only where the strict lookup declined and the shape is not an arm; the
  // arm half is the variant column below, and the two are never both set.
  if kind == 1 && vsi < 0 && mvValArmOfShape(bare) < 0 {
    vsi = mvValRowOfShape(bare)
  }
  // A value union also interns its scalar value-box reps; a struct or heterogeneous union just
  // rides the box payload and needs none. A map arm's mv value slot is interned so the
  // store-coerce tag and the narrowed read resolve the same slot.
  if kind == 2 {
    if isValueUnionName(valName) { registerValueUnionName(valName) }
    markMapUnionArms(valName)
  }
  // The slot's identity is structural — `repMvValKey` over the value's arena type — paired
  // with the key rep, not the recorded spelling; the name scan is the fall-through for a
  // spelling the arena does not resolve. Held rather than consumed, because the row this call
  // may push records the very same index.
  const vTy = mvValTyIxOfNameRow(valNameIn, rowTy)
  // The arm is part of what is being looked up (D48). Asking the hint at the two find rungs is
  // not the better-answer-at-a-mint the interner rule forbids: it never makes a find succeed
  // where it failed, only decline a slot whose arm is not this value's, so the mint below runs
  // in strictly more cases and is skipped in none.
  const armH = mvArmHintOfTy(armTy)
  const aSh = mvSlotOfTyKArm(vTy, keyI32, armH)
  if aSh >= 0 { return aSh }
  const nmSh = mvSlotByValNameKArm(valName, keyI32, armH)
  if nmSh >= 0 { return nmSh }
  // A ref-value (nested map or list) value forces the i32-list and map types, and a map value
  // also interns its inner value shape first so a ref-valued inner map's struct exists. All of
  // the recursive interning runs before this slot's parallel arrays are pushed: a reentrant
  // intern between two pushes would land its own entry at this slot's index and skew the rest.
  let rls6 = -1
  if kind == 6 {
    lUsed = true
    aUsed = true
    if nameIsMap(bare) {
      mUsed = true
      mvShapeOfMapName(bare)
    }
    // A non-i32 list value forces its inner list's type so the element wrapper heap exists.
    if nameIsStringArray(bare) { slUsed = true }
    else if nameIsF64Array(bare) { fa64Used = true }
    else if nameIsI64Array(bare) { ia64Used = true }
    // The vals ref-list slot, keyed by the value name with the recursively-interned inner
    // slots — the same `ensureRefElem` the array path uses. Its recursion strictly shrinks the
    // element spelling, so it never re-enters on `valName` itself. Keyed from the find's own
    // resolution, and withheld where `bare` is not that spelling, since that is another input.
    let bareTy = -1
    if bare == valNameIn { bareTy = vTy }
    rls6 = ensureRefElemTy(bare, bareTy)
  }
  mvValName.push(valName)
  // The slot's key half, pushed in lockstep with its name half — the pair is the row's
  // identity, so nothing between the two pushes may intern.
  if keyI32 { mvKeyI32.push(1) } else { mvKeyI32.push(0) }
  // The row's own resolution is the slot find's, not a second one: the find above resolved
  // `valNameIn` through the same resolver and `resolveAnnot` memoizes per spelling with no
  // invalidation of a positive entry. The one thing that can make the two inputs differ is
  // `mvCanonValName` rewriting the spelling, and there the bank is withheld.
  let vBank = -1
  if valName == valNameIn { vBank = vTy }
  recordMvValTyIx(valName, vBank)
  // The row that line just banked: `recordMvValTyIx` holds `valName`'s arena index over the
  // very spelling the two `valName` interns below key on. A mint may be fronted only with a
  // banked input provably the one it would have computed. The kind-6 site above is not
  // reachable from this bank — it interns before the row is pushed, and it must.
  const vRowTy = mvValTyIxAt(mvValTyIx.length - 1)
  mvValKind.push(kind)
  mvValStructIdx.push(vsi)
  // The variant half of that column, pushed in the same breath so the pair is one row (D34).
  // `variantRowOfTy` is a pure scan and interns nothing, which the parallel-table discipline
  // requires of anything sitting between two pushes. The name is its second source, for the
  // un-hinted caller the key rewrite cannot reach; the two cannot disagree.
  let mvVarRow = variantRowOfTy(armTy)
  if mvVarRow < 0 { mvVarRow = variantIndexOf(valName) }
  // The adopted arm, the third source, on the same gate the kind rung used: only where neither
  // name-keyed lookup placed the render, which is where `objVariantName` claimed the literal.
  if mvVarRow < 0 && vsi < 0 { mvVarRow = mvValArmOfShape(valName) }
  mvValVariantIdx.push(mvVarRow)
  // The arm-signature half (D93), pushed in the same breath so the row stays one row. Same two
  // sources as the column above and in the same order — the caller's recorded type first, the
  // key's own spelling second — asked through the map hop `variantRowOfTy` stops at. Neither
  // interns, which is what the parallel-table discipline requires between two pushes.
  let mvSigRow = mvArmSigOfTy(armTy)
  if mvSigRow < 0 { mvSigRow = mvArmSigOfName(valName, 8) }
  mvValArmSig.push(mvSigRow)
  if kind == 1 {
    // The kind-1 site is deliberately unhinted: it interns `sNames[vsi]`, not `valName`, and
    // that row's `sTyIx` sidecar has two producers that answer differently for an `#anonN` row.
    // It is keyed by the arm's name where the value is one (D34), since `sNames[vsi]` is the
    // inline-shape row minted from the arm's field set, over the wrong heap.
    let armNm = mvValArmName(armTy)
    if armNm == "" && variantIndexOf(valName) >= 0 { armNm = valName }
    // And from the adopted render (D671): an arm reached by its own row spelling has neither
    // an `sNames` row nor a `uVariants` name match, so both rungs above decline and
    // `sNames[-1]` is the out-of-bounds compiler read the rung above exists to stop.
    // `mvValArmOfShape` is the resolver the kind rung and the variant column already used.
    if armNm == "" {
      const armSh = mvValArmOfShape(valName)
      if armSh >= 0 { armNm = uVariants[armSh] }
    }
    if armNm != "" {
      mvRlSlot.push(rlInternName(armNm, 1))
    } else {
      mvRlSlot.push(rlInternName(sNames[vsi], 1))
    }
    rlUsed = true
    raUsed = true
  } else if kind == 2 {
    // A union-value ref list: element kind 2, the union box, heap `uBoxIdx`.
    mvRlSlot.push(rlInternNameTy(valName, 2, vRowTy))
    rlUsed = true
    raUsed = true
  } else if kind == 6 {
    // The map's value is a ref list or a nested map: the vals ref-list slot interned above,
    // before this slot's parallel-array pushes.
    mvRlSlot.push(rls6)
    rlUsed = true
    raUsed = true
  } else if kind == 14 {
    // A closure-value ref list: element kind 5, the closure fat-pointer, heap `cloStructIdx`.
    mvRlSlot.push(rlInternNameTy(valName, 5, vRowTy))
    rlUsed = true
    raUsed = true
  } else {
    mvRlSlot.push(-1)
  }
  if kind == 11 { fa64Used = true }
  if kind == 10 { ia64Used = true }
  if kind == 13 { fa32Used = true }
  // A string-valued map: force the string-list value flag so a bound `m.values()` supports
  // `.length` and indexing, which gate on `slUsed`.
  if kind == 3 {
    slUsed = true
    aUsed = true
  }
  mvMapTypeIdx.push(0)
  mvValName.length - 1
}

// Find-only mv-slot lookup by value type-name: `-1` for the mono i32 map, the interned slot
// otherwise. It never interns — all mv interning happens in `collectA`'s arena scan, since a
// slot interned after `mAssignTypeIndices` would mint no type index — so a miss is a compiler
// bug and fails loudly.
export function mvSlotOfValNameFind(valNameIn: string) {
  mvSlotOfValNameFindK(valNameIn, false)
}
function mvSlotOfValNameFindK(valNameIn: string, keyI32: boolean) {
  const valName = mvCanonValName(valNameIn)
  // Mono-ness is decided by the one classifier the interner uses: i32 and boolean, a
  // literal-union atom value, and the nullable-atom niches all ride the shared mono
  // `$mStructIdx` with no interned slot. A two-name test rejects the atom spellings loudly
  // even though the same map lowers fine as a binding.
  if mvValKindOfName(valName) == -1 { return -1 }
  const aFd = mvSlotOfValNameTyK(valNameIn, keyI32)
  if aFd >= 0 { return aFd }
  const nmFd = mvSlotByValNameK(valName, keyI32)
  if nmFd >= 0 { return nmFd }
  emitFail("emitProgram: map value type has no interned slot")
  -1
}

// A ref-value map slot's values are either inner map structs (ref-list element kind 3) or
// i32-list wrappers (element kind 4). This splits the two so a read classifies as the right
// thing: `m[k]` over a nested map is a Map, over a list-valued map an i32 list.
export function mvValIsMap(slot: i32) {
  if slot < 0 { return false }
  if mvValKind[slot] != 6 { return false }
  rlElemKindTbl[mvRlSlot[slot]] == 3
}

// The map shape a nested-map-valued slot's inner `Map()` must construct: the inner value's own
// mv slot when it has one, else the mono shape of the inner map's key. Only meaningful when
// `mvValIsMap(slot)`. It peels one `| null`, as its ref-list twin `rlElemMapShape` does — a
// `{[K]: {[K2]: V} | null}` value rides the same vals element, nullable only in the slot.
export function mvInnerMapShape(slot: i32): i32 {
  const inner = mvValNulInnerMvSlot(slot)
  if inner >= 0 { return inner }
  mapMonoShapeOfKey(rlElemMapKeyI32(mvRlSlot[slot]))
}

// The list-element rep of a list-valued map slot, or -1 when the slot's value is not a list.
// Maps the ref-list element kind to the value list's classifier rep.
export function mvListValKind(slot: i32): VKind | null {
  if slot < 0 { return null }
  if mvValKind[slot] != 6 { return null }
  const ek = rlElemKindTbl[mvRlSlot[slot]]
  if ek == 4 { return "list" }
  if ek == 6 { return "strlist" }
  if ek == 7 { return "f64list" }
  if ek == 8 { return "i64list" }
  if ek == 10 {
    return "f32list" // f32-inner list → an f32-list value (kind 21)
  }
  if ek == 9 {
    return "reflist" // struct-list value → a ref list
  }
  return null
}

// The niche twin of `mvListValKind` — the nullable `VKind` a `{[K]: T[] | null}` value binds,
// or null when the value is not a list. Composed on `mvListValKind` so the element-kind to rep
// mapping has one home. It is half of a pair: the `.values()` loop var binds the niche here
// and `emitForInStmt` must leave the element read raw, or the stored null traps.
export function mvNulListValKind(slot: i32): VKind | null {
  const k = mvListValKind(slot)
  if k == "list" { return "nullist" }
  if k == "strlist" { return "nulstrlist" }
  if k == "f64list" { return "nulf64list" }
  if k == "i64list" { return "nuli64list" }
  if k == "f32list" { return "nulf32list" }
  if k == "u8list" { return "nulu8list" }
  if k == "reflist" { return "nulreflist" }
  null
}

// The mv slot of a `m[k]` or `m[k] ?? d` read over a struct-list-valued map, else -1. The hook
// `refListElemNameOfExpr` uses to name the read's element, so `(m[k] ?? []).length` resolves.
function mapReadStructListMvSlot(exprIx: i32, fnIx: i32) {
  const cm = coalesceMvSlot(exprIx, fnIx)
  if cm >= 0 {
    if mvListValKind(cm) == "reflist" { return cm }
  }
  const mr = mapReadMvSlot(exprIx, fnIx)
  if mr >= 0 {
    if mvListValKind(mr) == "reflist" { return mr }
  }
  -1
}

// ── scalar-list descriptor (the i32, f64 and i64 list unification) ─────────────
// A scalar-element list is one shape parameterized by its element's valtype: a growable
// `{ backing, len, cap }` wrapper over a raw `(array (mut <elem>))`. The descriptors map a
// canonical element kind to its list types, so a list op is written once over the kind.

// The canonical scalar element kind of a list-valued expression, or null for a ref, string or
// map list and for anything that is not a list. The single dispatch the scalar list ops
// consult instead of each re-deriving `exprF64Array`.
export function scalarListElemKind(exprIx: i32, fnIx: i32): VKind | null {
  // The packed byte list first: what this returns is the discriminator the scalar-list ops
  // select a rep with, and `u8[]` is the one list whose element value kind does not identify
  // its rep — its backing is `(array (mut i8))` where every other i32-element list is
  // `(array (mut i32))`. It must precede `exprArray`, which claims any i32-element list.
  if exprU8Array(exprIx, fnIx) { return "u8list" }
  if exprF32Array(exprIx, fnIx) { return "f32" }
  if exprF64Array(exprIx, fnIx) { return "f64" }
  if exprI64Array(exprIx, fnIx) { return "i64" }
  if exprArray(exprIx, fnIx) { return "i32" }
  return null
}

// ── active `is`-narrowing scope ───────────────────────────────────────────────
// The active narrowings are a stack of parallel columns, so nested guards over distinct union
// locals each stay narrowed in the inner branch. A branch saves the stack length and truncates
// on exit; `narrowTop` is the logical depth, rewound rather than popped.

// The stack slot of the innermost active narrowing of `name`, or -1 when `name` is not
// narrowed — the one scan every narrowing query shares. A retired entry is skipped rather
// than answering, so a name whose narrowing a write falsified reads at the declared rep;
// skipping rather than stopping lets an outer narrowing of the same name still answer.
export function narrowSlotOf(name: string): i32 {
  let i = narrowTop - 1
  while i >= 0 {
    if narrowNames[i] == name {
      if narrowRetired[i] == 0 { return i }
    }
    i = i - 1
  }
  -1
}

// The arena type the narrowing at stack slot `i` binds — see `narrowSlotTy`. Exported for the
// emitter's narrowed-arm consumers, which ask it of the slot `narrowSlotOf` returned.
export function narrowSlotTyOf(i: i32): i32 { narrowSlotTy(i) }

// Retire every live narrowing of `name`. Called for a write the narrowing does not admit;
// the entry is marked in place (see `narrowRetired`).
function retireNarrowFor(name: string) {
  let i = 0
  while i < narrowTop {
    if narrowNames[i] == name { narrowRetired[i] = 1 }
    i = i + 1
  }
  0
}

// The variant a union local `name` is narrowed to in the current scope (the innermost
// active binding within `narrowTop`), or "" if `name` is not currently narrowed.
export function narrowVariantFor(name: string) {
  const i = narrowSlotOf(name)
  if i < 0 { return "" }
  narrowVariants[i]
}

// The arena type the narrowing at stack slot `i` binds: the type banked by an `is` push, or —
// for a complement push — the sole surviving member of its set (`i32 | null` minus `null`
// binds `i32`). -1 when the slot binds no single type: a two-or-more-member set, a set the
// pool does not cover, or a push that banked nothing.
function narrowSlotTy(i: i32): i32 {
  const t = narrowTys[i]
  if t >= 0 { return t }
  msSoleMemberTy(narrowSets[i])
}

// Push an active narrowing `name` to `variant` carrying its structure: `ty` is the narrowed
// type's arena index for a one-type narrowing, `set` the interned member-set id for a
// complement one, each -1 where it does not apply. All columns move together, so a slot index
// is valid in every one of them. Returns the new depth.
function pushNarrowRep(name: string, variant: string, ty: i32, set: i32) {
  // The bare-name-only window, held only across the post-guard complement of an `if` that has
  // an `else`. Declining here rather than at each member arm is deliberate: this is the single
  // push every narrowing channel bottoms out at. A path key is any key with a separator, not
  // just a dotted one (D451) — an index key carries no dot and would walk straight through.
  if narrowBareIdentOnly {
    if name.indexOf(".") >= 0 { return narrowTop }
    if name.indexOf("[") >= 0 { return narrowTop }
  }
  if narrowTop < narrowNames.length {
    narrowNames[narrowTop] = name
    narrowVariants[narrowTop] = variant
    narrowTys[narrowTop] = ty
    narrowSets[narrowTop] = set
    narrowRetired[narrowTop] = 0
  } else {
    narrowNames.push(name)
    narrowVariants.push(variant)
    narrowTys.push(ty)
    narrowSets.push(set)
    narrowRetired.push(0)
  }
  narrowTop = narrowTop + 1
  narrowTop
}

// Push a narrowing whose structure is not carried (the rendered variant is all the
// entry has — every consumer falls through to its name path for it).
function pushNarrow(name: string, variant: string) {
  pushNarrowRep(name, variant, -1, -1)
}

// Push an `is`-test narrowing: the tested spelling plus the arena type the checker resolved
// it to at the `is` node (`isVarTyIxOf`, -1 for a node the checker never saw, such as a
// monomorphized clone, which lands on the name path).
function pushNarrowIs(name: string, variant: string, condIx: i32) {
  const ity = isVarTyIxOf(condIx)
  pushNarrowRep(name, isVariantSpelling(variant, ity), ity, -1)
}

// The `uVariants` spelling of an `is`-tested type: the author's own spelling when it names a
// variant row, otherwise the declared name of the struct that spelling's type equals. The
// emitter resolves an `is` test by an exact string compare against `uVariants`, so which
// spellings work is decided by which got registered. Two gates read it, so both must ask here.
export function isVariantSpelling(variant: string, tyIx: i32): string {
  if variantIndexOf(variant) >= 0 { return variant }
  const nomn = nominalStructNameOfTy(tyIx)
  if nomn != "" {
    if variantIndexOf(nomn) >= 0 { return nomn }
  }
  variant
}

// Append the declared-local name `name` to `localNames` as a fresh slot — one wasm local per
// lexical binding, with no dedupe by name, so two same-named `let`s in disjoint branches get
// distinct slots and distinct valtypes. `structIdx` is the local's struct table index when it
// is a ref, else -1. Returns the new slot's position (its wasm index is `paramCount + pos`).
export function addLocalName(name: string, isRef: VKind, structIdx: i32) {
  const pos = localNames.length
  localNames.push(name)
  localIsRef.push(isRef)
  localStructIdx.push(structIdx)
  localLoopVar.push(0)
  // Block-scoped when the collect walk is inside a nested block: depth 1 is the frame's own
  // statement list, deeper is a block whose bindings die at its `}`. Every call site sits
  // inside `collectLocals` or `collectStartLocals`, so the depth is the caller's answer.
  let inBlk = 0
  if scopeFrames.length > 1 { inBlk = 1 }
  localBlockLet.push(inBlk)
  localLoopIter.push(-1)
  localDeclIx.push(-1)
  localLitUnion.push(0)
  pos
}

// Pin the `LetDecl` that declared the slot, so a question only the declaration can answer
// resolves from the slot the scope stack hands out. The `LetDecl` twin of `markLoopVarIter`.
export function markLocalDecl(slot: i32, declIx: i32) {
  if slot >= 0 { localDeclIx[slot] = declIx }
  0
}

// Mark the declared-local slot as a loop variable. A loop var's scope is the loop: while it is
// live the scope stack resolves it, and once its loop closes it must not be resolvable again —
// but the flat `localNames` fallback scan would still find it, since that serves the scope-less
// detection passes. `declaredIndexOf` therefore skips flagged slots in its fallback.
export function markLoopVarSlot(slot: i32) {
  localLoopVar[slot] = 1
  0
}

// Mark the declared-local slot as a for-in element loop variable and pin the iterable node its
// loop iterates, so a question only the iterable can answer resolves from the slot the scope
// stack hands out rather than from the loop var's name. The `for`-counter form has no iterable
// and keeps the plain `markLoopVarSlot`.
export function markLoopVarIter(slot: i32, iterIx: i32) {
  localLoopVar[slot] = 1
  localLoopIter[slot] = iterIx
  0
}

// The `.push` and `.pop` element-kind selector threaded through the reservation walkers.
// `pop` only uses i32, ref and str.
type PushKind = "i32" | "ref" | "str" | "f64" | "i64" | "f32" | "u8"

// The scratch pre-scan carries all the PushKinds as one bitmask, least-significant first in
// declaration order, so a single body walk classifies every `.push` and `.pop` receiver once
// rather than one whole-body walk per kind per query.
function pushKindBit(kind: PushKind) {
  if kind == "i32" { return 1 }
  if kind == "ref" { return 2 }
  if kind == "str" { return 4 }
  if kind == "f64" { return 8 }
  if kind == "i64" { return 16 }
  if kind == "f32" { return 32 }
  // Bit 64 is taken by the additive `(string | null)[]` value-slot marker (see
  // `pushKindBitsOf`), so the packed byte list takes 128.
  128 // "u8"
}

// Classify the `.push` or `.pop` receiver at `objIx` into its PushKind bits with one classifier
// fan-out: the ref, str, f64, i64 and f32 list kinds, or the i32 list kind when none claim it.
function pushKindBitsOf(objIx: i32, fnIx: i32) {
  let bits = 0
  if exprRefArray(objIx, fnIx) { bits = bits | 2 }
  if exprStringArray(objIx, fnIx) { bits = bits | 4 }
  if exprF64Array(objIx, fnIx) { bits = bits | 8 }
  if exprI64Array(objIx, fnIx) { bits = bits | 16 }
  if exprF32Array(objIx, fnIx) { bits = bits | 32 }
  // The packed byte list gets its own bit, and so its own scratch quad: its value slot is an
  // i32 like the plain list's, but its backing and receiver refs are not.
  if exprU8Array(objIx, fnIx) { bits = bits | 128 }
  // Bit 64 is additive to bit 4, not an alternative: a `(string | null)[]` push uses the string
  // quad, one backing, and only its value slot changes — to `(ref null $sTypeIdx)`, since the
  // pushed value may be `null`. `exprNulStrArray` is the same predicate the element read and
  // the for-in loop var ask, so the frame cannot disagree with the value.
  if exprNulStrArray(objIx, fnIx) { bits = bits | 4 | 64 }
  if bits == 0 { return 1 }
  bits
}

// The receiver-kind bits of a `recv.push(x)` member call, or 0 when `callIx` is no such call.
// Detects which inline-push scratch locals a function needs; the kinds get distinct scratch
// frames so a function may push onto any mix. Asked at value positions too (D1592): `.push`
// yields the new length, so `const n = xs.push(2)` runs the same grow sequence.
export function callPushBits(callIx: i32, fnIx: i32) {
  const s = P.nodes[callIx]
  if s is Call {
    const callee = P.nodes[s.callFn]
    if callee is Member {
      if callee.memProp == "push" {
        let b = pushKindBitsOf(callee.memObj, fnIx)
        if pushStagesAtomNarrow(callIx) { b = b | 256 }
        if listOpRecvStages(callee.memObj, fnIx) { b = b | 512 }
        return b
      }
    }
  }
  0
}

// Bit 256: does this `.push` need the atom-narrow staging slot? Deliberately an
// over-approximation, with scope-free inputs — this walk carries no live scope stack, so it
// claims the whole superset. Claiming too much costs one unused local; claiming too little is
// a `local.set` against an index the locals vector never declared. It rides `callPushBits`.
function pushStagesAtomNarrow(callIx: i32): boolean {
  if gLitUnionUsed == 0 { return false }
  const c = P.nodes[callIx]
  if c is Call {
    if c.callArgs.length != 1 { return false }
    const a = P.nodes[unwrapParen(c.callArgs[0])]
    // A member string literal lowers as its interned id with no tower at all.
    if a is StrLit { return false }
    // A re-readable place takes the re-reading tower, which needs no slot.
    return !unionEqOperandOk(c.callArgs[0])
  }
  false
}

// True if a list op on receiver `objIx` must materialize the wrapper ref into the frame's one
// `recvRef` slot rather than referencing a local in place. A frame slot holding a union box
// narrowed to a list arm stages too, and is asked of the slot because this walk runs with no
// narrowing active. Two readers must agree: `callPopBits` and `emitPush` (D1280).
function listOpRecvStages(objIx: i32, fnIx: i32): boolean {
  const recv = P.nodes[objIx]
  if recv is Ident {
    if identSlotIsUnionBox(fnIx, recv.identName) { return true }
    if localIndexOf(fnIx, recv.identName) >= 0 { return false }
    return globalIndexOf(recv.identName) >= 0
  }
  true
}

// The receiver-kind bits of a `recv.pop()` at `callIx` whose receiver is a struct-field or
// global-field array read, or 0 otherwise. A bare-local pop needs no scratch, referencing the
// local in place, so it reports no bits — only a `Member` receiver, which must be materialized
// into the push frame's `recvRef` slot.
function callPopBits(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      // `.clear()` resolves its receiver the way `.pop()` does, and since D1281 so does
      // `.get(i)`, which shares `.pop`'s body. `.get` is gated on the receiver being a list,
      // because a map `.get(k)` is a different lowering and `pushKindBitsOf`'s no-bits
      // fallback would hand it the i32-list quad it never uses.
      let getIsList = false
      if callee.memProp == "get" {
        getIsList = mfRecvKindOf(callee.memObj, fnIx) != null
      }
      if callee.memProp == "pop" || callee.memProp == "clear" || getIsList {
        // Bit 512 rides along: this op parks its receiver in the frame's one `recvRef` slot,
        // which is what `emitPush` must know about its own pushed value (D1592).
        if listOpRecvStages(callee.memObj, fnIx) {
          return pushKindBitsOf(callee.memObj, fnIx) | 512
        }
      }
    }
  }
  0
}

// True if the call at `callIx` is a `recv.push(x)` whose receiver's list kind matches `kind` —
// the single-kind view of `callPushBits`, for the ref-slot collectors.
export function callIsPushKind(callIx: i32, fnIx: i32, kind: PushKind) {
  (callPushBits(callIx, fnIx) & pushKindBit(kind)) != 0
}

// True if `callIx` is a `Member` or global-receiver `.pop` or `.clear` of list kind `kind` —
// the single-kind view of `callPopBits`, for the ref-slot collectors.
export function callIsMemberPopKind(callIx: i32, fnIx: i32, kind: PushKind) {
  (callPopBits(callIx, fnIx) & pushKindBit(kind)) != 0
}

// Bit 256 at a value position: does the expression at `ix` itself need the atom-narrow staging
// slot? The sibling of `pushStagesAtomNarrow`, one destination set wider — that one asks of a
// `.push` argument, where the members come from the destination, this of any value reaching
// `emitExpr`'s `pendingLitUnion` hook. `_fnIx` is unused: a scope test here would be wrong.
function exprStagesAtomNarrow(exprIx: i32, _fnIx: i32): boolean {
  if gLitUnionUsed == 0 { return false }
  const ax = unwrapParen(exprIx)
  const a = P.nodes[ax]
  // A member string literal lowers as its interned id with no tower at all.
  if a is StrLit { return false }
  // A re-readable place takes the re-reading tower, which needs no slot.
  if unionEqOperandOk(exprIx) { return false }
  // A value whose recorded type is a registered litunion alias is already the atom — no
  // conversion is wanted at any destination, and the emit declines it through the same test.
  // Scope-free, an arena index-set membership, so unlike `exprIsLitAtom` as a whole it cannot
  // answer differently here from at emit time for the shape it claims.
  const axTy = nodeTyIxOf(ax)
  if tyIsLitUnionAlias(axTy) { return false }
  // The value's own recorded type — `strReppedLitUnionAt`'s test, and a singleton `TyLit`
  // counts for that predicate's reason: `if s is "aa"` and an `"aa"` parameter both produce
  // one, whose value is the same string and whose atom-slot destination is the same i32.
  tyIsLitUnionOrLit(axTy)
}

// The `Member`-receiver `.pop` kind bits anywhere in the expression at `exprIx`. A `.pop`
// appears in value position, so the reservation walk must descend expressions rather than
// only statement receivers.
export function exprPopBits(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  if exprStagesAtomNarrow(exprIx, fnIx) {
    // Or'd in and the descent continues: the staging slot is one shared local, so a second
    // site inside the same expression needs nothing more, but the `.pop` bits below still do.
    return 256 | exprPopBitsGo(exprIx, fnIx)
  }
  exprPopBitsGo(exprIx, fnIx)
}

function exprPopBitsGo(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  const e = P.nodes[exprIx]
  if e is Call {
    // A `.push` in value position (D1592) runs the same grow sequence a statement one does and
    // needs the same scratch frame. This walk is the one that descends value positions, so it
    // asks for both here rather than growing a second walker whose node set could drift.
    let bits = callPopBits(exprIx, fnIx) | callPushBits(exprIx, fnIx)
    const args = e.callArgs
    let i = 0
    while i < args.length {
      bits = bits | exprPopBits(args[i], fnIx)
      i = i + 1
    }
    return bits
  }
  if e is BinExpr {
    return exprPopBits(e.binLeft, fnIx) | exprPopBits(e.binRight, fnIx)
  }
  if e is Member { return exprPopBits(e.memObj, fnIx) }
  if e is Index {
    return exprPopBits(e.idxArr, fnIx) | exprPopBits(e.idxIndex, fnIx)
  }
  if e is Unary { return exprPopBits(e.unArg, fnIx) }
  if e is Paren { return exprPopBits(e.parInner, fnIx) }
  // The four remaining value positions, taught from this file's own sibling walker
  // `exprHasMapOp`. `emitExpr` lowers all four into `emitPop` and `emitPopOr`, which test no
  // `fnUses*Push` flag, so a `.pop()` in an array-literal element, an object-literal field
  // value or an `as`-cast operand would stage into a frame `fbBeginFunc` never reserved.
  if e is AsExpr { return exprPopBits(e.asObj, fnIx) }
  if e is IsExpr { return exprPopBits(e.isObj, fnIx) }
  if e is ObjLit {
    let bits = 0
    const fields = e.objFields
    let i = 0
    while i < fields.length {
      const f = P.nodes[fields[i]]
      if f is FieldInit { bits = bits | exprPopBits(f.fiValue, fnIx) }
      i = i + 1
    }
    return bits
  }
  if e is ArrayLit {
    let bits = 0
    const elems = e.arrElems
    let i = 0
    while i < elems.length {
      bits = bits | exprPopBits(elems[i], fnIx)
      i = i + 1
    }
    return bits
  }
  0
}

// One walk of the block at `blockIx`, descending into if, else, while and for bodies — the
// scopes `collectLocals` walks — accumulating both the statement-level `.push` receiver kinds
// and the `Member`-receiver `.pop` kinds in every let-init, return, condition, for-header and
// expression-statement position. `if` conditions are scanned by `ifChainPushPopBits`.
export function blockPushPopBits(blockIx: i32, fnIx: i32) {
  let bits = 0
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      const s = P.nodes[stmts[i]]
      if s is LetDecl {
        bits = bits | exprPopBits(s.letInit, fnIx)
      } else if s is RetStmt {
        bits = bits | exprPopBits(s.retArg, fnIx)
      } else if s is BinExpr {
        bits = bits | exprPopBits(stmts[i], fnIx)
      } else if s is Call {
        // `exprPopBits` asks `callPushBits` of every `Call` it reaches (D1592), so the
        // statement receiver is covered by the same descent as a value-position one.
        bits = bits | exprPopBits(stmts[i], fnIx)
      } else if s is IfStmt {
        bits = bits | ifChainPushPopBits(stmts[i], fnIx)
      } else if s is WhileStmt {
        bits = bits |
          exprPopBits(s.whileCond, fnIx) |
          blockPushPopBits(s.whileBody, fnIx)
      } else if s is ForIn {
        bits = bits |
          exprPopBits(s.fiIter, fnIx) |
          blockPushPopBits(s.fiBody, fnIx)
      } else if s is ForRange {
        bits = bits |
          exprPopBits(s.frFrom, fnIx) |
          exprPopBits(s.frTo, fnIx) |
          blockPushPopBits(s.frBody, fnIx)
      }
      i = i + 1
    }
  }
  bits
}

// The push and pop kind bits of every arm of the `if` chain at `ifIx` — the then-branch, an
// `else` block, or recursively a chained `else if`. Mirrors the recursion in `collectLocalsIf`
// so a push buried under several arms is detected. The condition is walked too: `emitPop` and
// `emitPopOr` test no `fnUses*Push` flag, so a `.pop()` there needs the frame reserved.
function ifChainPushPopBits(ifIx: i32, fnIx: i32) {
  let bits = 0
  const s = P.nodes[ifIx]
  if s is IfStmt {
    bits = exprPopBits(s.ifCond, fnIx) | blockPushPopBits(s.ifThen, fnIx)
    if s.ifElse >= 0 {
      const els = P.nodes[s.ifElse]
      if els is Block { bits = bits | blockPushPopBits(s.ifElse, fnIx) }
      else if els is IfStmt { bits = bits | ifChainPushPopBits(s.ifElse, fnIx) }
    }
  }
  bits
}

// Or a push/pop kind mask into the per-function `fnUses*Push` scratch-frame flags; a `.push`
// and a `Member`-receiver `.pop` of the same kind share a frame. Bit 512, the staging tell
// `emitPush` reads, reserves nothing and is ignored here.
export function applyPushPopBits(bits: i32) {
  if (bits & 1) != 0 { fnUsesPush = true }
  if (bits & 2) != 0 { fnUsesRefPush = true }
  if (bits & 4) != 0 { fnUsesStrPush = true }
  if (bits & 64) != 0 { fnUsesNulStrPush = true }
  if (bits & 8) != 0 { fnUsesF64Push = true }
  if (bits & 16) != 0 { fnUsesI64Push = true }
  if (bits & 32) != 0 { fnUsesF32Push = true }
  if (bits & 128) != 0 { fnUsesU8Push = true }
  if (bits & 256) != 0 { fnUsesAtomStage = true }
  0
}

// Append the ref-list table slot of a ref `.push` receiver to `fnRefPushSlots` if not already
// present, so each distinct pushed element type gets its own typed scratch frame.
export function recordRefPushSlot(slot: i32) {
  let i = 0
  while i < fnRefPushSlots.length {
    if fnRefPushSlots[i] == slot { return 0 }
    i = i + 1
  }
  fnRefPushSlots.push(slot)
  0
}

// ── string-op detection: which functions need the string scratch frame ────────
// A function reserves the shared string scratch frame exactly when it uses any string `+`,
// `==` or `.slice` anywhere in an expression, so the walk below descends every expression
// position, not only statement receivers. `exprString` reads the already-built `localNames`.

// True if `binIx` is a `+` whose operands are strings (string concatenation).
export function exprIsStrConcat(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "+" {
      // A literal-union atom is a `string` subtype, so `"x" + k` and `k + "y"` concatenate —
      // the atom operand widens to its member string in `emitStrConcat`.
      const lStr = exprString(e.binLeft, fnIx) || exprIsLitAtom(e.binLeft, fnIx)
      const rStr = exprString(e.binRight, fnIx) ||
        exprIsLitAtom(e.binRight, fnIx)
      return lStr || rStr
    }
  }
  false
}

// The reservation scan's over-approximation for a shadowed name. `exprIsLitAtom`'s `Ident` arm
// resolves through `declaredSlotOf`, whose fallback is a first-match scan over `localNames`,
// and this scan runs with an empty scope stack, so an outer binding wins where emit time binds
// the inner one. Scan-side only: over-reserving costs locals, under-reserving is invalid wasm.
function identShadowMayBeLitAtom(exprIx: i32, _fnIx: i32) {
  if gLitUnionUsed == 0 { return false }
  if exprIx < 0 { return false }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Ident {
    // Only a name with more than one declared local can be resolved differently by the two
    // phases; a unique name gets the same answer from both, and claiming it here would reserve
    // frames for every ordinary string local in the program.
    let seen = 0
    let hit = false
    let i = 0
    while i < localNames.length {
      if localNames[i] == e.identName {
        seen = seen + 1
        if i < localLitUnion.length {
          if localLitUnion[i] == 1 { hit = true }
        }
      }
      i = i + 1
    }
    if seen > 1 { return hit }
  }
  false
}

// A literal-union atom pushed into a `string[]` widens to its member string, which stages the
// atom id in the string-op scratch frame — the emit's reservation side. The receiver test is
// the list's element type and the value test is the value's rep, a pairing `emitPush`'s other
// seeds do not make. Deliberately a superset: `(string | null)[]` takes an earlier arm.
function pushWidensAtomToStr(callIx: i32, fnIx: i32) {
  if gLitUnionUsed == 0 { return false }
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if callee.memProp == "push" {
        if c.callArgs.length == 1 {
          if exprStringArray(callee.memObj, fnIx) {
            if exprIsLitAtom(c.callArgs[0], fnIx) { return true }
            if identShadowMayBeLitAtom(c.callArgs[0], fnIx) { return true }
          }
        }
      }
    }
  }
  false
}

// True if the `Call` at `callIx` passes a literal-union atom into a parameter that widens it to
// a string — a `string` param, or a boxed union param with a litunion or `string` arm, whose
// store lowers through `emitAtomToStr` exactly as the `string` param does. An
// over-approximation is fine here: it only reserves a frame.
function callWidensAtomToStr(callIx: i32, fnIx: i32) {
  if gLitUnionUsed == 0 { return false }
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Ident {
      const target = fnIndexOfSid(sidOfNode(c.callFn))
      if target >= 0 {
        const cFn = P.nodes[fnStmts[target]]
        if cFn is FuncDecl {
          let anyAtom = false
          let ai = 0
          while ai < c.callArgs.length {
            if exprIsLitAtom(c.callArgs[ai], fnIx) { anyAtom = true }
            if identShadowMayBeLitAtom(c.callArgs[ai], fnIx) { anyAtom = true }
            ai = ai + 1
          }
          if anyAtom {
            const params = cFn.fnParams
            let pi = 0
            while pi < params.length {
              if vtKindOfParam(params[pi]) == "str" { return true }
              const pn = P.nodes[params[pi]]
              if pn is Param {
                if unionTakesAtomAsStr(tyNameOf(pn.parType)) { return true }
              }
              pi = pi + 1
            }
          }
        }
      }
    }
    // A function-value callee has no `FuncDecl` to read its parameters off, so the kinds come
    // from the resolved `$fnsig` key — the same byte `emitCallRef`'s widening arm reads, so the
    // scan and the handler cannot disagree about which positions widen. Without this leg the
    // widening writes to a local the vector never declared.
    const vkey = cloCallSigKey(callIx, fnIx)
    if vkey != "" {
      let vAtom = false
      let vi = 0
      while vi < c.callArgs.length {
        if exprIsLitAtom(c.callArgs[vi], fnIx) { vAtom = true }
        if identShadowMayBeLitAtom(c.callArgs[vi], fnIx) { vAtom = true }
        vi = vi + 1
      }
      if vAtom {
        let vp = 0
        while vp < c.callArgs.length {
          if sigParamKindAt(vkey, vp) == "str" { return true }
          vp = vp + 1
        }
      }
    }
  }
  false
}

// True if the assignment at `binIx` writes a literal-union atom into a target that widens it to
// a string — a `string`-typed lvalue, which `exprString` covers for a local, global or field
// alike, or a boxed union lvalue with a litunion or `string` arm. Either way the atom widens to
// its member string, riding the string-op scratch frame.
function assignWidensAtomToStr(binIx: i32, fnIx: i32) {
  if gLitUnionUsed == 0 { return false }
  const a = P.nodes[binIx]
  if a is BinExpr {
    if a.binOp == "=" {
      if (
        exprIsLitAtom(a.binRight, fnIx) ||
        identShadowMayBeLitAtom(a.binRight, fnIx)
      ) {
        if exprString(a.binLeft, fnIx) { return true }
        if unionTakesAtomAsStr(unionNameOfExpr(a.binLeft, fnIx)) { return true }
        // A string-valued map target (`m["k"] = <atom>`): `exprString`'s `Index` arm asks
        // `exprStringArray(idxArr)`, which declines for a map receiver, so neither test above
        // fires and the string-op scratch frame goes unreserved for the widen
        // `emitMapSetValExpr` performs. Without it `strScratchBase` aliases `mapScratchBase`.
        const at = P.nodes[unwrapParen(a.binLeft)]
        if at is Index {
          if nodeTyIsMap(at.idxArr) { return true }
        }
      }
    }
  }
  false
}

// True if `initIx` is a literal-union atom read in a global initializer — an `Ident`
// referencing another module global whose declared type is a literal union, or a call
// returning a litunion alias. Gates the start function's `string`-global widening and its
// scratch-frame reservation.
export function globalInitIsLitAtom(initIx: i32) {
  if initIx < 0 { return false }
  const e = P.nodes[unwrapParen(initIx)]
  if e is Ident {
    const gli = globalLetOf(e.identName)
    if gli >= 0 {
      const r = letIsLitUnion(gli)
      return r
    }
  }
  // A call returning a litunion alias is the other atom form a module-global initializer can
  // take: the start function's own coercion widens it through `exprIsLitAtom`'s `Call` arm, so
  // the scan has to claim it too or the frame is not there.
  const r2 = exprIsLitAtom(initIx, -1)
  r2
}

// True if the global at `letIx` is a cell that widens a literal-union atom initializer to its
// member string in the start function, riding the string-op scratch frame: a `string` cell or
// its nullable, or a boxed union cell with a litunion or `string` arm. This is the one position
// whose frame belongs to the start function, so its miss cannot be masked from inside one.
export function globalInitWidensAtomToStr(letIx: i32) {
  if gLitUnionUsed == 0 { return false }
  if letIx < 0 { return false }
  const d = P.nodes[letIx]
  if d is LetDecl {
    const gk = globalCellKind(letIx)
    let takes = false
    if gk == "str" || gk == "nulstr" { takes = true }
    if !takes && d.letType >= 0 {
      if unionTakesAtomAsStr(tyNameOf(d.letType)) { takes = true }
    }
    if !takes { return false }
    const r = globalInitIsLitAtom(d.letInit)
    return r
  }
  false
}

// True if the binding at `letIx` is annotated with a target that widens a literal-union atom
// initializer to its member string, riding the string-op scratch frame: `: string`, a boxed
// union with a litunion or `string` arm, and the array of one, whose literal elements each take
// the same store. The array leg covers the element position `exprHasStrOp`'s ArrayLit arm misses.
function letWidensAtomToStr(letIx: i32, fnIx: i32) {
  if gLitUnionUsed == 0 { return false }
  const d = P.nodes[letIx]
  if d is LetDecl {
    if d.letType >= 0 {
      const tn = tyNameOf(d.letType)
      if unionTakesAtomAsStr(tn) {
        if exprIsLitAtom(d.letInit, fnIx) { return true }
        if identShadowMayBeLitAtom(d.letInit, fnIx) { return true }
      }
      const el = parenUnionArrElemName(tn)
      if el != "" && unionTakesAtomAsStr(el) {
        if arrLitHasAtomElem(d.letInit, fnIx) { return true }
      }
    }
  }
  false
}

// True if the expression at `ix` is an array literal with at least one literal-union atom
// element. The element-position half of `letWidensAtomToStr`.
function arrLitHasAtomElem(ix: i32, fnIx: i32) {
  if ix < 0 { return false }
  const e = P.nodes[unwrapParen(ix)]
  if e is ArrayLit {
    const elems = e.arrElems
    let i = 0
    while i < elems.length {
      if exprIsLitAtom(elems[i], fnIx) { return true }
      if identShadowMayBeLitAtom(elems[i], fnIx) { return true }
      i = i + 1
    }
  }
  false
}

// True if `retArgIx` is a literal-union atom returned from a function whose return type widens
// it to a string — `string`, or a boxed union with a litunion or `string` arm. It widens at the
// return, riding the string-op scratch frame. An inline literal-union return reps as a string
// ref and so widens an atom operand; a named alias reps as the atom itself and must not.
function retLitUnionInlineTy(tyIx: i32): boolean {
  if tyIx < 0 { return false }
  if nodeTyIsLitUnionAlias(tyIx) { return false }
  tyIsLitUnion(nodeTyIxOf(tyIx))
}

function retWidensAtomToStr(retArgIx: i32, fnIx: i32) {
  if gLitUnionUsed == 0 { return false }
  if retArgIx < 0 { return false }
  if fnIx < 0 { return false }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    if unionTakesAtomAsStr(tyNameOf(fn.fnRet)) {
      if exprIsLitAtom(retArgIx, fnIx) { return true }
      if identShadowMayBeLitAtom(retArgIx, fnIx) { return true }
    }
    // The inline literal-union return, mirroring the arm of the same name in
    // `emitReturnValue`'s widen ladder. This is a reservation pass and that is an emit pass,
    // and the two must claim the same set arm for arm, or the widen runs against unreserved
    // locals. Reachable only through a monomorphized instance, whose element read is an atom.
    if retLitUnionInlineTy(fn.fnRet) {
      if exprIsLitAtom(retArgIx, fnIx) { return true }
      if identShadowMayBeLitAtom(retArgIx, fnIx) { return true }
    }
    // The inferred-string dual, mirroring `emitReturnValue`'s widen: an un-annotated function
    // whose recorded return is `string` — one path returning a member literal, another the
    // atom — widens an atom return too, so reserve the frame.
    if fn.fnRet < 0 && cloRetIsString(fnStmtsPosOf(fnIx)) {
      if exprIsLitAtom(retArgIx, fnIx) { return true }
      if identShadowMayBeLitAtom(retArgIx, fnIx) { return true }
    }
  }
  false
}

// The implicit-return twin of `retWidensAtomToStr`, and the reason the pair exists: a VL
// function's value is its last statement, so `emitFuncBody` routes that statement through
// `emitReturnExit` or `emitIfTail` and both reach the same `emitReturnValue` widen. The
// reservation scan has to ask the atom-widening question in tail position too.
function fnTailWidensAtomToStr(fnIx: i32) {
  if gLitUnionUsed == 0 { return false }
  if fnIx < 0 { return false }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    const savedTop = narrowTop
    const hit = tailBlockWidensAtomToStr(fn.fnBody, fnIx)
    restoreNarrow(savedTop)
    return hit
  }
  false
}

// Mirrors `emitStmtsTail`: every statement but the last is an ordinary statement, walked here
// only for the post-guard narrowing the tail value is classified under, exactly as the emit
// loop does, and the last one is the block's value.
function tailBlockWidensAtomToStr(blockIx: i32, fnIx: i32) {
  if blockIx < 0 { return false }
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    const n = stmts.length
    if n == 0 { return false }
    let i = 0
    while i < n - 1 {
      pushPostGuardNarrow(stmts[i], fnIx)
      i = i + 1
    }
    return tailStmtWidensAtomToStr(stmts[n - 1], fnIx)
  }
  false
}

// Mirrors `emitStmtTail`: a tail `if` whose arms yield values recurses into both arms under the
// same narrowing `emitIfTail` applies, an `else if` being a lone nested `IfStmt` still in tail
// position; any other tail value statement widens exactly like a `return` of it.
function tailStmtWidensAtomToStr(stmtIx: i32, fnIx: i32) {
  const s = P.nodes[stmtIx]
  if s is IfStmt {
    if !lastStmtIsValueIf(stmtIx, fnIx) && !elseLessNullableTail(stmtIx, fnIx) {
      return false
    }
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const hitThen = tailBlockWidensAtomToStr(s.ifThen, fnIx)
    if narrowed { restoreNarrow(savedTop) }
    if hitThen { return true }
    if s.ifElse >= 0 {
      const savedElseTop = narrowTop
      const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
      const els = P.nodes[s.ifElse]
      let hitElse = false
      if els is Block {
        hitElse = tailBlockWidensAtomToStr(s.ifElse, fnIx)
      } else {
        hitElse = tailStmtWidensAtomToStr(s.ifElse, fnIx)
      }
      if narrowedElse { restoreNarrow(savedElseTop) }
      return hitElse
    }
    return false
  }
  if !stmtIsTailValue(stmtIx, fnIx) { return false }
  retWidensAtomToStr(stmtIx, fnIx)
}

// True if `binIx` is `==`/`!=` whose operands are strings (string value-equality).
export function exprIsStrEq(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" {
      // A comparison with `null` is a null check, handled by the nullable `ref.is_null` paths,
      // never element-wise string equality — a `string | null` operand would otherwise be
      // element-compared against `null`.
      if P.nodes[unwrapParen(e.binLeft)] is NullLit { return false }
      if P.nodes[unwrapParen(e.binRight)] is NullLit { return false }
      return exprString(e.binLeft, fnIx) || exprString(e.binRight, fnIx)
    }
  }
  false
}

// True if `binIx` is an ordering comparison whose operands are text — a lexicographic compare
// (`emitStrLessCore`), not the numeric `i32.lt_s` path. Both operands must be text. "Text" is
// wider than "string ref": a litunion whose type is a registered alias reps as the interned
// atom, and comparing two ids follows interning order rather than member text.
export function exprIsStrOrder(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    const op = e.binOp
    if op == "<" || op == ">" || op == "<=" || op == ">=" {
      return strOrderOperandIsText(e.binLeft, fnIx) &&
        strOrderOperandIsText(e.binRight, fnIx)
    }
  }
  false
}

// One ordering operand's is-this-text test: a string ref, or a literal-union atom that widens
// to its member string. Exactly the set `emitStrValue` can push as a string, which is what
// makes one predicate safe as both the dispatch and the frame reservation. A mixed `s < k` is
// claimed: the checker accepts the spelling, and declining leaves a ref under `i32.lt_s`.
function strOrderOperandIsText(ix: i32, fnIx: i32) {
  if exprString(ix, fnIx) { return true }
  exprIsLitAtom(ix, fnIx)
}

// True if `binIx` is a `==` or `!=` whose union-box value compare can hit the string arm — a
// box compared against a string operand, or two boxes whose shared arms include `string`.
// Those payload compares stage their operands in the string scratch frame, so it must be
// reserved.
function exprIsUnionStrEq(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" {
      const lU = exprUnion(e.binLeft, fnIx)
      const rU = exprUnion(e.binRight, fnIx)
      if lU && rU {
        const ln = unionNameOfExpr(e.binLeft, fnIx)
        const rn = unionNameOfExpr(e.binRight, fnIx)
        return unionHasAtomAB(
          11,
          ln,
          nodeTyIxOf(unwrapParen(e.binLeft)),
          "string",
        ) &&
          unionHasAtomAB(
          12,
          rn,
          nodeTyIxOf(unwrapParen(e.binRight)),
          "string",
        )
      }
      // A literal-union atom operand reaches the box's string arm too, by widening to its
      // member string, which stages the id in this very frame. The handler and this scan have
      // to claim the same operands or the frame is unreserved under a `local.set`.
      if lU {
        return exprString(e.binRight, fnIx) || exprIsLitAtom(e.binRight, fnIx)
      }
      if rU {
        return exprString(e.binLeft, fnIx) || exprIsLitAtom(e.binLeft, fnIx)
      }
    }
  }
  false
}

// ── the eq layout row ─────────────────────────────────────────────────────────
// A field-wise compare walks a layout and this emitter has two tables holding one, disjoint
// because `collectS` skips a `type X = {…}` that is a union member (D57). An eq row encodes
// both: `row >= 0` is a struct row, `row < 0` variant `-1 - row`; only a chain root is a variant.
export function eqRowOfVariant(vi: i32) { -1 - vi }

// Field count of an eq row, from whichever table owns it.
export function eqRowFieldCount(row: i32) {
  if row < 0 { return uFieldCount[-1 - row] }
  sFieldCount[row]
}

// The wasm-type code of an eq row's field `fi`. The two tables share one code vocabulary, so
// the compare's field ladder is written once and its one loud floor catches the unsupported
// codes whichever table the row came from.
export function eqRowFieldTypeAt(row: i32, fi: i32) {
  if row < 0 { return variantFieldTypeAt(-1 - row, fi) }
  sFieldTypeAt(row, fi)
}

// The heap type an eq row's values are physically read through. A variant's cell is
// `(ref $uVarHeap[vi])` — a different heap type from any same-shaped `sHeapIdx` twin, and
// reading one through the other is the `expected (ref $type), found (ref $type)` family.
export function eqRowHeapIdx(row: i32) {
  if row < 0 { return uVarHeap[-1 - row] }
  sHeapIdx[row]
}

// The struct-table row an eq row's code-15 field targets — a struct row from either table, or
// -1, the loud no-interned-shape floor, when the target is itself an arm.
export function eqRowTgtStructIdx(row: i32, fi: i32) {
  if row < 0 { return uFieldTgtStructIdx(-1 - row, fi) }
  sFieldTgtStructIdx(row, fi)
}

// ── the one row resolution for a `==`, in three namespaces ───────────────────
// Read by the frame-reservation scan and by the core emitter alike: a compare the scan does
// not know about is emitted against locals the function never declared. Each answers on
// agreement only, and returns a table index (-1 none) — a bare eq row of -1 is variant row 0.

// The union-variant row both operands of a `==` or `!=` resolve to, or -1.
export function binEqVariantRow(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" {
      const lvi = exprVariantIndex(e.binLeft, fnIx)
      if lvi >= 0 && lvi == exprVariantIndex(e.binRight, fnIx) { return lvi }
    }
  }
  -1
}

// The nullable-niche variant row both operands resolve to, or -1 — the `Circle | null` twin of
// `binEqVariantRow`, off `nulVariantIdxOfExpr`. Kept separate rather than laddered into one
// resolver: the two reach different emitters, and a resolver answering for both would let the
// unguarded dispatch claim a niche pair if the guard's dispatch ever stopped running first.
export function binEqNulVariantRow(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" {
      const lvi = nulVariantIdxOfExpr(e.binLeft, fnIx)
      if lvi >= 0 && lvi == nulVariantIdxOfExpr(e.binRight, fnIx) { return lvi }
    }
  }
  -1
}

// The struct-table row both operands resolve to, or -1.
export function binEqStructRow(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" {
      const lsi = structIndexOfExpr(e.binLeft, fnIx)
      const rsi = structIndexOfExpr(e.binRight, fnIx)
      if lsi >= 0 && lsi == rsi { return lsi }
      // D959 — two different rows that share a heap type are one wasm type, and VL is
      // structurally typed, so they are one VL type too: two same-shaped declarations get two
      // struct-table rows and one emitted struct. The heap index is the test, not the field
      // lists, and both must be resolved — an unassigned row is not evidence of agreement.
      if (
        lsi >= 0 &&
        rsi >= 0 &&
        lsi < sHeapIdx.length &&
        rsi < sHeapIdx.length
      ) {
        if sHeapIdx[lsi] >= 0 && sHeapIdx[lsi] == sHeapIdx[rsi] { return lsi }
      }
    }
  }
  -1
}

// True if `binIx` is a same-layout field-wise `==` or `!=` — over a standalone struct or over
// a union arm, non-null or through the nullable niche. Its string and array field compares
// stage operands in the string-op scratch frame, so it counts as a string op for reservation.
function exprIsStructEq(binIx: i32, fnIx: i32) {
  if binEqStructRow(binIx, fnIx) >= 0 { return true }
  if binEqVariantRow(binIx, fnIx) >= 0 { return true }
  binEqNulVariantRow(binIx, fnIx) >= 0
}

// ── list `==` and `+` detection: which functions need the list-op frames ──────
// Which list rep claims an expression: `LR_NONE` 0, string list 1, f64 2, i64 3, f32 4, u8 5,
// ref 6, the i32 core 7. `lrSlot` is the ref list's `rlElemKindTbl` slot (-1 on every other
// arm), read here because both consumers need it and neither may ask twice.
type ListRep = { lrRep: i32, lrSlot: i32 }
const LR_NONE = 0
const LR_STR = 1
const LR_F64 = 2
const LR_I64 = 3
const LR_F32 = 4
const LR_U8 = 5
const LR_REF = 6
const LR_I32 = 7

// The one ladder `listOpKindOf` and `catListKindOfExpr` run, so the two cannot classify one
// expression two ways. `exprArray` claims the four distinct-backing scalar lists, so it asks
// last or a scalar list answers as the i32 core. The other `expr*Array` consumers run their
// own orders and are deliberately not this ladder.
function exprListRep(exprIx: i32, fnIx: i32): ListRep {
  const none: ListRep = { lrRep: LR_NONE, lrSlot: -1 }
  if exprIx < 0 { return none }
  if exprString(exprIx, fnIx) { return none }
  if exprStringArray(exprIx, fnIx) { return lrOf(LR_STR) }
  if exprF64Array(exprIx, fnIx) { return lrOf(LR_F64) }
  if exprI64Array(exprIx, fnIx) { return lrOf(LR_I64) }
  if exprF32Array(exprIx, fnIx) { return lrOf(LR_F32) }
  if exprU8Array(exprIx, fnIx) { return lrOf(LR_U8) }
  if exprRefArray(exprIx, fnIx) {
    const ref: ListRep = {
      lrRep: LR_REF,
      lrSlot: refListSlotOfExpr(exprIx, fnIx),
    }
    return ref
  }
  if exprArray(exprIx, fnIx) { return lrOf(LR_I32) }
  none
}

// A rep with no ref slot — every arm but `LR_REF`.
function lrOf(rep: i32): ListRep {
  const r: ListRep = { lrRep: rep, lrSlot: -1 }
  r
}

// The list-op operand kind of an expression: `0` an i32 list, `3` a string list, `4` an
// `i32[][]`, or -1 for a non-list or an unsupported element kind. The four distinct-backing
// scalar lists decline: `-1` is the right answer rather than a new code, since this home means
// which of the three old cores and `eqgListKindOfBin` claims them one ladder over (D755).
function listOpKindOf(exprIx: i32, fnIx: i32) {
  const lr = exprListRep(exprIx, fnIx)
  if lr.lrRep == LR_STR { return 3 }
  if lr.lrRep == LR_REF {
    if rlSlotIsKindList(lr.lrSlot, 4) { return 4 }
    return -1
  }
  if lr.lrRep == LR_I32 { return 0 }
  -1
}

// ── list `+` concat rep detection — the one home ──────────────────────────────
// The list rep an expression concatenates over, in `listBuildKindOfVKind`'s alphabet, or -1
// for a non-list. `listOpKindOf`'s ladder, read through a wider accept set: a concat inspects
// no element, so the four scalar reps answer here where the list-op home declines them.
export function catListKindOfExpr(exprIx: i32, fnIx: i32) {
  const lr = exprListRep(exprIx, fnIx)
  if lr.lrRep == LR_STR { return 3 }
  if lr.lrRep == LR_F64 { return 4 }
  if lr.lrRep == LR_I64 { return 6 }
  if lr.lrRep == LR_F32 { return 7 }
  if lr.lrRep == LR_U8 { return 10 }
  if lr.lrRep == LR_REF {
    if lr.lrSlot >= 0 { return 1 }
    return -1
  }
  if lr.lrRep == LR_I32 { return 0 }
  -1
}

// The concat rep of a `+` `BinExpr` whose operands are both lists of one rep, or -1. Both must
// resolve to the same rep and the same ref-list slot: two ref lists at different slots have
// different backing heap types, and `array.copy` between them is a validation error rather
// than a coercion, so a pairing this declines keeps the refusal it has today.
export function catListKindOfBin(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "+" {
      const lk = catListKindOfExpr(e.binLeft, fnIx)
      if lk < 0 { return -1 }
      if catListKindOfExpr(e.binRight, fnIx) != lk { return -1 }
      if lk == 1 {
        if (
          refListSlotOfExpr(e.binLeft, fnIx) !=
          refListSlotOfExpr(e.binRight, fnIx)
        ) {
          return -1
        }
      }
      return lk
    }
  }
  -1
}

// ── list `==` over a rep with no core of its own — the one home ───────────────
// The `==` twin of `catListKindOfBin`, separate because a concat inspects no element and a
// compare does — one opcode per scalar leaf, the string helper for a string leaf, a recursion
// for a nested list — so the accept set is narrower. `listOpKindOfBin` runs first.

// What `emitListEqGCore` must do with one element of list rep (kind, slot): `1` compare two
// scalar leaves with `eqgNeOpcode(kind)`, `2` compare two string leaves through the string-eq
// helper, `3` recurse into the element's own list core, `0` no answer. Keyed on the rep and
// not the arena type, because the emitter's frames and heap indices are keyed that way.
export function eqgElemClass(kind: i32, slot: i32) {
  // The scalar-leaf list reps: i32 (and everything that reps as one), f64, i64, f32, u8.
  if kind == 0 || kind == 4 || kind == 6 || kind == 7 || kind == 10 { return 1 }
  if kind == 3 { return 2 }
  if kind == 1 {
    if slot < 0 || slot >= rlElemKindTbl.length { return 0 }
    const ek = rlElemKindTbl[slot]
    // 4 i32-list · 6 string-list · 7 f64-list · 8 i64-list · 10 f32-list · 9 a ref list.
    if ek == 4 || ek == 6 || ek == 7 || ek == 8 || ek == 9 || ek == 10 {
      return 3
    }
    // A struct element, field-wise, but only over the fields whose compare needs no frame of
    // its own. A nullable element is excluded here rather than by the row lookup, and the two
    // are not the same test: `(Circle | null)[]` resolves the same row a `Circle[]` does, so a
    // row-based gate would admit it and the field compare would `struct.get` through a null.
    if slot < rlElemNullable.length {
      if rlElemNullable[slot] == 1 { return 0 }
    }
    if eqgElemHasEqRow(slot) {
      if eqgStructElemFlat(eqgElemEqRow(slot), 0) { return 4 }
    }
    return 0
  }
  0
}

// ── the ref-list element's eq row, in both namespaces ─────────────────────────
// Asked in the order the `==` dispatch asks them: declaring `type Shape = Circle | Sq` moves
// `Circle` out of the struct table, so a `Circle[]` element resolves a variant row where it
// resolved a struct one (D57). The found flag is needed because -1 is variant row 0.
export function eqgElemHasEqRow(slot: i32): boolean {
  if rlElemStructRow(slot) >= 0 { return true }
  rlElemVariantRow(slot) >= 0
}

export function eqgElemEqRow(slot: i32): i32 {
  const sr = rlElemStructRow(slot)
  if sr >= 0 { return sr }
  eqRowOfVariant(rlElemVariantRow(slot))
}

// Is this struct row's field-wise compare emittable inside a list loop with no frame the
// reservation scan did not reserve? Every field must be a native-compare scalar or a nested
// struct whose own row satisfies the same rule. The accept set is drawn around the frames, not
// around soundness: a `string` field compares correctly but stages in a frame nothing reserved.
export function eqgStructElemFlat(row: i32, depth: i32): boolean {
  if depth > 8 { return false }
  const cnt = eqRowFieldCount(row)
  // A fieldless struct compares as `i32.const 1`, which is correct and needs nothing — but it
  // is also the answer a row the tables do not cover gives, so a count alone cannot admit it.
  if cnt == 0 { return false }
  let fi = 0
  while fi < cnt {
    const code = eqRowFieldTypeAt(row, fi)
    if code == 15 {
      // A nested-struct field target is a struct row in either namespace, or -1 for no
      // interned shape, so here — unlike the row above — a negative is the absence and must
      // be refused.
      const tgt = eqRowTgtStructIdx(row, fi)
      if tgt < 0 { return false }
      if !eqgStructElemFlat(tgt, depth + 1) { return false }
    } else if code != 0 && code != 17 && code != 21 && code != 30 {
      return false
    }
    fi = fi + 1
  }
  true
}

// The nested element's own list-rep kind, in `catListKindOfExpr`'s alphabet. Only a ref-list
// slot has one; `eqgElemClass` answering 3 is the precondition.
export function eqgInnerKind(slot: i32) {
  if slot < 0 || slot >= rlElemKindTbl.length { return -1 }
  const ek = rlElemKindTbl[slot]
  if ek == 4 { return 0 }
  if ek == 6 { return 3 }
  if ek == 7 { return 4 }
  if ek == 8 { return 6 }
  if ek == 10 { return 7 }
  if ek == 9 { return 1 }
  -1
}

// The nested element's ref-list slot, or 0 for an element rep that is not slot-keyed — the
// same convention `catListSlotOfBin` uses, and for the same reason.
export function eqgInnerSlot(slot: i32) {
  if slot < 0 || slot >= rlElemKindTbl.length { return 0 }
  if rlElemKindTbl[slot] == 9 { return rlElemInnerSlot(slot) }
  0
}

// The scalar-list field code to generic-compare kind map (D1020), in `catListKindOfExpr`'s
// alphabet, or -1 for a field code that is not a scalar-backed list. One home because two
// sides read it: the compare-frame reservation and the field-equality ladder, and a core
// emitted against a frame nobody reserved refuses loudly. Code 4 is deliberately absent.
export function eqScalarListFieldKind(code: i32): i32 {
  if code == 6 {
    return 3 // string[]
  }
  if code == 25 {
    return 4 // f64[]
  }
  if code == 26 {
    return 6 // i64[]
  }
  if code == 27 {
    return 7 // f32[]
  }
  if code == 35 {
    return 10 // u8[] — the packed byte list (D1008)
  }
  0 - 1
}

// D1180 — the non-null twin of a ref-niche field code, or -1 when the code is not one. A
// `(ref null $H)` field is `null` or a value of `$H`, so its compare is the non-null code's
// core under a null guard — one wrapper, not one arm per rep. One home, since the frame
// pre-pass resolves a niche through this and `emitStructEqFieldInner` opens the guard from it.
export function nulFieldInnerCode(code: i32): i32 {
  if code == 20 {
    return 3 // `string | null`
  }
  if code == 18 {
    return 4 // `i32[] | null`
  }
  if code == 31 {
    return 6 // `string[] | null`
  }
  if code == 32 {
    return 25 // `f64[] | null`
  }
  if code == 33 {
    return 26 // `i64[] | null`
  }
  if code == 34 {
    return 27 // `f32[] | null`
  }
  if code == 28 {
    return 5 // `S[] | null`
  }
  if code == 22 {
    return 14 // `fn | null`
  }
  -1
}

// D1180 — the same map for a variant arm's field, differing in exactly one rung: code 4 is
// included here and excluded there, because the struct ladder carries a hand-written `i32[]`
// arm that predates the generic cores and the variant ladder has none. One home for the same
// pairing its sibling is one for: the frame reservation and the core emitter read it alike.
export function eqVariantListFieldKind(code: i32): i32 {
  if code == 4 {
    return 0 // i32[] / boolean[] / K[]
  }
  eqScalarListFieldKind(code)
}

// The union-atom code to generic-compare kind map, in `catListKindOfExpr`'s alphabet, or -1
// for an atom that is not a list (D1095). The union box's `value` field holds a list arm's
// wrapper ref directly, so an arm's compare is a list compare over that wrapper. The two
// alphabets differ — an atom's `7` is `i32[]`, a compare kind's `7` is `f32[]` — hence a name.
export function leqCoreKindOfAtomKind(k: i32): i32 {
  if k == 7 {
    return 0 // i32[] / boolean[] / K[]
  }
  if k == 8 {
    return 4 // f64[]
  }
  if k == 9 {
    return 3 // string[]
  }
  if k == 10 {
    return 6 // i64[]
  }
  if k == 12 {
    return 7 // f32[]
  }
  if k == 13 {
    return 10 // u8[] — the packed byte list
  }
  0 - 1
}

// Can `emitListEqGCore` compare two values of list rep (kind, slot)? Walks the element chain
// the emitter will recurse along, so the reservation scan, the emitter and this predicate
// cannot disagree about how deep the recursion goes. The depth bound is not decoration: this
// walks a table, and an inner-slot column pointing at its own row would hang the compiler.
function eqgRepComparable(kind: i32, slot: i32, depth: i32): boolean {
  if depth > 32 { return false }
  const c = eqgElemClass(kind, slot)
  if c == 1 || c == 2 || c == 4 { return true }
  if c == 3 {
    return eqgRepComparable(eqgInnerKind(slot), eqgInnerSlot(slot), depth + 1)
  }
  false
}

// One `==` operand's list rep, in `catListKindOfExpr`'s alphabet, through a `| null`.
// `emitNulNicheEq` guards the compare and then runs the rep's own core on the unwrapped refs,
// so a niche and its base share one core by construction. `catListKindOfExpr`'s classifiers
// are non-null, so without this the guard is emitted and the core underneath finds no frame.
function eqgListKindOfExpr(exprIx: i32, fnIx: i32) {
  const k = catListKindOfExpr(exprIx, fnIx)
  if k >= 0 { return k }
  // The four distinct-backing nullable scalar lists, off the same home the build side reads
  // them through.
  const nk = exprNulScalarListKind(exprIx, fnIx)
  if isNulScalarListKind(nk) { return nulScalarListBuildKind(nk) }
  if exprNullableRefArray(exprIx, fnIx) {
    if refListSlotOfExpr(exprIx, fnIx) >= 0 { return 1 }
  }
  -1
}

// The generic-compare rep of a `==` or `!=` whose operands are both lists of one rep that has
// no core of its own, or -1. Both must resolve to the same rep and the same ref-list slot, as
// `catListKindOfBin` requires and for the same reason: two ref lists at different slots have
// different wrapper and backing heap types, and one core cannot read both.
export function eqgListKindOfBin(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" {
      // A bare `null` operand is a null test, not a value compare.
      if P.nodes[unwrapParen(e.binLeft)] is NullLit { return -1 }
      if P.nodes[unwrapParen(e.binRight)] is NullLit { return -1 }
      // The three existing cores decide every shape they claim.
      if listOpKindOfBin(binIx, fnIx) >= 0 { return -1 }
      // So does the checker's own token, the stronger of the two gates: `eqCmpKindOfOperand`
      // names the core the checker accepted this program for, so a token naming one of the old
      // three is that core's shape however the classifiers read it. A token of -1 is the opaque
      // case — a monomorphized instance — where the classifiers are the only channel.
      const tl = eqCoreKindOfTyToken(eqCmpKindOfOperand(e.binLeft, fnIx))
      if tl >= 0 && tl != 7 { return -1 }
      const tr = eqCoreKindOfTyToken(eqCmpKindOfOperand(e.binRight, fnIx))
      if tr >= 0 && tr != 7 { return -1 }
      const lk = eqgListKindOfExpr(e.binLeft, fnIx)
      if lk < 0 { return -1 }
      if eqgListKindOfExpr(e.binRight, fnIx) != lk { return -1 }
      let sl = 0
      if lk == 1 {
        const ls = refListSlotOfExpr(e.binLeft, fnIx)
        if ls < 0 { return -1 }
        if refListSlotOfExpr(e.binRight, fnIx) != ls { return -1 }
        sl = ls
      }
      if !eqgRepComparable(lk, sl, 0) { return -1 }
      return lk
    }
  }
  -1
}

// The ref-list slot a generic-compare `==` runs over, or 0 for a rep that is not slot-keyed.
// The `==` twin of `catListSlotOfBin`, split from the kind for the same reason.
export function eqgListSlotOfBin(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    const s = refListSlotOfExpr(e.binLeft, fnIx)
    if s >= 0 { return s }
  }
  0
}

// The ref-list slot a `+` `BinExpr` concatenates over, or 0 for a rep that is not slot-keyed,
// the frame's two ref slots reading their heap indices off the rep code alone. Split from
// `catListKindOfBin` rather than packed into its return value: the callers needing the slot
// need the kind too, and an encoded pair is a decode at every site.
export function catListSlotOfBin(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    const s = refListSlotOfExpr(e.binLeft, fnIx)
    if s >= 0 { return s }
  }
  0
}

// The list-op kind of a `==`, `!=` or `+` whose operands are both lists of one kind, or -1
// when it is not a list op, leaving the caller its existing dispatch.
export function listOpKindOfBin(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" || e.binOp == "+" {
      const lk = listOpKindOf(e.binLeft, fnIx)
      if lk < 0 { return -1 }
      const rk = listOpKindOf(e.binRight, fnIx)
      if rk != lk { return -1 }
      return lk
    }
  }
  -1
}

// ── `==` compare-core selection — the one home ───────────────────────────────
// Which compare core a `==` needs, or -1 for none. Read by the frame-reservation scan and by
// the core emitter, which must never disagree: a core the scan does not know about is emitted
// against locals the function never declared. `nodeEqCmpKind` is the classifiers' fallback.
export function eqCoreKindOfBin(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" {
      // A bare `null` operand makes this a null test, which consumes no compare core at all.
      // Claiming one here would reserve a compare frame for every `xs != null` guard in the
      // language and shift every local index after it.
      if P.nodes[unwrapParen(e.binLeft)] is NullLit { return -1 }
      if P.nodes[unwrapParen(e.binRight)] is NullLit { return -1 }
      const lk = listOpKindOfBin(binIx, fnIx)
      if lk >= 0 { return lk }
      // The generic list compare, above the string and closure rungs for the same reason the
      // three cores above it are: a list operand must be claimed by a list answer before a
      // scalar ladder reads it. Its own home declines every shape `listOpKindOfBin` claims, so
      // this rung can only add a rep that had no core at all.
      if eqgListKindOfBin(binIx, fnIx) >= 0 { return 7 }
      if exprIsStrEq(binIx, fnIx) { return 5 }
      if exprIsClosure(e.binLeft, fnIx) || exprIsClosure(e.binRight, fnIx) {
        return 6
      }
      const tl = eqCoreKindOfTyToken(eqCmpKindOfOperand(e.binLeft, fnIx))
      if tl >= 0 { return tl }
      return eqCoreKindOfTyToken(eqCmpKindOfOperand(e.binRight, fnIx))
    }
  }
  -1
}

// ── the emitter's own name for a nullable ref niche, `fnIx`-scoped ────────────
// The second channel of `binEqNulNiche`: the same six tokens, read off the emitter's rep
// classifiers rather than the checker's banked type, which inside a monomorphized instance is
// the type variable and answers "" (D42). Exactly the six niches whose non-null core exists.
export function exprNulNicheKind(exprIx: i32, fnIx: i32): EqCmpKind {
  if exprIx < 0 { return "" }
  if exprNullableString(exprIx, fnIx) { return "nulstr" }
  // `exprNullableRefNiche`, not the struct-only twin: a nullable union variant is a
  // `(ref null $uVarHeap[vi])` whose arena type is a `TyObj`, so the other channel names it
  // `nulstruct` too, and a channel answering differently would be a second guess.
  if exprNullableRefNiche(exprIx, fnIx) { return "nulstruct" }
  if exprNulClosure(exprIx, fnIx) { return "nulclosure" }
  if exprNullableList(exprIx, fnIx) { return "nullist" }
  if exprNulScalarListKind(exprIx, fnIx) == "nulstrlist" { return "nulstrlist" }
  // The generic core's niche on the second channel. `eqCmpKindOfNulInner` names `nulglist` on
  // the first, so a written-out `f64[] | null == null` takes the guard; inside a monomorphized
  // instance the banked type is `T | null` and that channel answers "", so without this arm
  // `emitEqRecoverNarrowed` emits `ref.as_non_null` on a genuinely null operand.
  const nsk = exprNulScalarListKind(exprIx, fnIx)
  if isNulScalarListKind(nsk) {
    // `nulstrlist` is claimed one line up, having the string-list core; the other three
    // distinct-backing niches are exactly the generic core's.
    if nsk != "nulstrlist" { return "nulglist" }
  }
  if exprNullableRefArray(exprIx, fnIx) {
    const slot = refListSlotOfExpr(exprIx, fnIx)
    if slot >= 0 && slot < rlElemKindTbl.length {
      if rlElemKindTbl[slot] == 4 { return "nulreflist" }
      if eqgRepComparable(1, slot, 0) { return "nulglist" }
    }
  }
  ""
}

// ── one `==` operand's lowering token, across both channels ──────────────────
// The checker's banked type first, the emitter's own `fnIx`-scoped rep classifiers when — and
// only when — it still contains a type variable. Both consumers ask this, one deciding whether
// the compare needs a null guard and the other which core goes under it (D421).
export function eqCmpKindOfOperand(exprIx: i32, fnIx: i32): EqCmpKind {
  const k = nodeEqCmpKind(exprIx)
  if k != "" { return k }
  if !nodeTyHasTyVar(exprIx) { return "" }
  exprNulNicheKind(exprIx, fnIx)
}

// True if the layout at eq row `row` carries a function-typed field, looking through
// nested-struct fields. `seen` guards recursive shapes and holds eq rows rather than struct
// indices — the encoding is injective, so a struct row and a variant row cannot collide.
function shapeHasCloField(row: i32, seen: i32[]) {
  let k = 0
  while k < seen.length {
    if seen[k] == row { return false }
    k = k + 1
  }
  seen.push(row)
  let fi = 0
  while fi < eqRowFieldCount(row) {
    let code = eqRowFieldTypeAt(row, fi)
    // A `fn | null` field runs the identity core under a null guard, so it needs the same
    // two-slot frame its non-null twin does — resolved through the one home the guard opens
    // from, else the core is a `local.set` into a slot the function never declared (D1292).
    const cn = nulFieldInnerCode(code)
    if cn >= 0 { code = cn }
    if code == 14 { return true }
    if code == 15 {
      const nsi = eqRowTgtStructIdx(row, fi)
      if nsi >= 0 {
        if shapeHasCloField(nsi, seen) { return true }
      }
    }
    fi = fi + 1
  }
  false
}

// Note one `BinExpr`'s function-identity equality site into `fnUsesCloEq` — the compare stages
// both operands in the two-slot closure-eq frame. All three namespaces, off the shared
// resolvers: this is a reservation scan, and a layout it cannot see is a `local.set` into a
// slot the function never declared. `unionArmsNeedCloEq` asks it of a union operand's arms.
function unionArmsNeedCloEq(uname: string): boolean {
  if uname == "" { return false }
  const arms: string[] = []
  splitUnionAtoms(unionMemberSetOf(uname), arms)
  let ui = 0
  while ui < arms.length {
    if valueAtomKind(arms[ui]) == 11 { return true }
    const avi = variantIndexOf(arms[ui])
    if avi >= 0 {
      const aseen: i32[] = []
      if shapeHasCloField(eqRowOfVariant(avi), aseen) { return true }
    }
    ui = ui + 1
  }
  false
}

export function cloEqNoteBin(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" {
      if exprIsClosure(e.binLeft, fnIx) || exprIsClosure(e.binRight, fnIx) {
        fnUsesCloEq = true
        return 0
      }
      // And the arms of a union operand (D1096), which the legs below cannot see: they read
      // the binary's own operands and here those are boxes. A union `==` compares the arm its
      // tag selects, and which arm runs is a runtime test, so every arm of either operand has
      // to be reserved for. Over-reserving costs two locals; under-reserving is invalid wasm.
      if unionArmsNeedCloEq(unionNameOfExpr(e.binLeft, fnIx)) {
        fnUsesCloEq = true
      }
      if unionArmsNeedCloEq(unionNameOfExpr(e.binRight, fnIx)) {
        fnUsesCloEq = true
      }
      // The struct leg stays left-only, deliberately, and is not `binEqStructRow`. A
      // reservation scan may over-reserve and may not under-reserve, and this one fires on the
      // left operand's row alone, so a pair the emitter will refuse still reserves the frame.
      // Tightening it to the shared agreement resolver moves bytes for no defect.
      const si = structIndexOfExpr(e.binLeft, fnIx)
      if si >= 0 {
        const seen: i32[] = []
        if shapeHasCloField(si, seen) { fnUsesCloEq = true }
        return 0
      }
      // The variant leg is agreement-gated, because that is exactly when the emitter emits a
      // variant compare — reserve for the compare that will be produced, no wider.
      let vi = binEqVariantRow(binIx, fnIx)
      if vi < 0 { vi = binEqNulVariantRow(binIx, fnIx) }
      if vi >= 0 {
        const vseen: i32[] = []
        if shapeHasCloField(eqRowOfVariant(vi), vseen) { fnUsesCloEq = true }
      }
    }
  }
  0
}

// True if `callIx` is a `recv.slice(start, end)` over a string receiver.
export function exprIsStrSlice(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if callee.memProp == "slice" { return exprString(callee.memObj, fnIx) }
    }
  }
  false
}

// True if `callIx` is a `recv.indexOf(sub)` or `recv.includes(sub)` over a string receiver —
// both ride the same indexOf scan, `includes` negating the -1 compare.
export function exprIsStrIndexOf(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if callee.memProp == "indexOf" || callee.memProp == "includes" {
        return exprString(callee.memObj, fnIx)
      }
    }
  }
  false
}

// True if `callIx` is a `recv.charCodeAt(i)` over a string receiver.
export function exprIsStrCharCode(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if callee.memProp == "charCodeAt" {
        return exprString(callee.memObj, fnIx)
      }
    }
  }
  false
}

// True if `callIx` is a `recv.cpAt(i)` over a string receiver.
export function exprIsStrCpAt(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if callee.memProp == "cpAt" { return exprString(callee.memObj, fnIx) }
    }
  }
  false
}

// True if `callIx` is a `recv.cpLen()` over a string receiver.
export function exprIsStrCpLen(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if callee.memProp == "cpLen" { return exprString(callee.memObj, fnIx) }
    }
  }
  false
}

// True if `callIx` is a `recv.isCharBoundary(i)` over a string receiver.
export function exprIsStrCharBoundary(callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if callee.memProp == "isCharBoundary" {
        return exprString(callee.memObj, fnIx)
      }
    }
