// The interning key for lifted function `fe`'s env-leading `$fnsig`, or "" when the
// signature is not function-value-eligible. It encodes the param kinds (`cloParamTok`) and
// the return kind, so two functions share one `$fnsig` exactly when their env-leading
// functypes render the same bytes. `cloSigKeyExt` extends the result spine.
export function fnSigKeyOf(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return "" }
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    let key = ""
    const params = fn.fnParams
    let pi = 0
    while pi < params.length {
      const tok = cloParamTok(params[pi])
      if tok == "" { return "" }
      key = key + tok
      pi = pi + 1
    }
    // Key/bytes interlock: the `$fnsig` bytes stream from the key's representative via
    // `cloRetValKind`, so a key coarser than it would let two different result reps share
    // one slot and declare the loser with the winner's functype. `cloRetKindOf` is that
    // coarser answer, so the value-ABI key is minted only where the two agree.
    const r = cloRetKindOf(fe)
    const vk = cloRetValKind(fe)
    match r {
      "i32" | "f64" => {
        if vk == r { return key + ">" + repSigTokOfKind(r) }
      }
      // Every other result kind is out of the value ABI, and void has no result.
      "struct" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "i64" | "f64list" | "f32" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" | "v128" | null => {}
    }
    return ""
  }
  ""
}

// The value-ABI return kind of lifted function `fe` for `$fnsig` purposes: `"i32"`,
// `"f64"`, or `null` for void, closure-returning, or any other kind. An annotated return
// reads the annotation; an un-annotated one rides the stored kind plus `tailIsF64NoLocal`,
// which stays registry-independent so the key cannot depend on the current function.
export function cloRetKindOf(fe: i32): VKind | null {
  if fe < 0 || fe >= fnStmts.length { return null }
  if fe >= fRetVoid.length { return null }
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    if fRetVoid[fe] == 1 { return null }
    if fnReturnsClosure(fe) { return null }
    if fn.fnRet >= 0 {
      const k = vtKindOfType(fn.fnRet)
      if k == "i32" || k == "nulbool" { return "i32" }
      if k == "f64" { return "f64" }
      return null
    }
    // Un-annotated: an inferred ref, i64 or f32 kind is out of the value ABI, an f64 tail
    // is `"f64"`, and everything else rides the i32 result. The `"nulstr"` niche falls
    // through with `"i32"` deliberately — this ladder does not consult `fRetNulStr`.
    const irk = fRetKind[fe]
    if irk == "f64" { return "f64" }
    if irk != "i32" && irk != "nulstr" && irk != "nulbool" { return null }
    if tailIsF64NoLocal(fnRetExprOf(fnStmts[fe]), fnStmts[fe]) { return "f64" }
    return "i32"
  }
  null
}

// The lifted-function position (`fnStmts` index) of an object-literal field value that is
// a function: an inline lambda (a `FuncDecl` node, lifted in place, so its arena index
// appears in `fnStmts`) or a bare `Ident` naming a function. -1 for any other field value.
export function fieldValueFeOf(valIx: i32) { fieldValueFeOfIn(valIx, -1) }

// The positioned twin: `fnIx` is the frame the value is READ from, so a bare `Ident` naming a
// function resolves through the scope chain. A monomorphized instance's per-pin clone shares
// the template's name, and the flat map answers the template — the call then reaches the wrong
// clone with the right signature, which validates and runs wrong (D1782).
export function fieldValueFeOfIn(valIx: i32, fnIx: i32) {
  if valIx < 0 { return -1 }
  const v = nodeAt(valIx)
  match v {
    FuncDecl => {
      return fnStmtsPosOf(valIx)
    }
    Ident => {
      const fe = fnIndexOfInScopeAt(sidOfNode(valIx), v.identName, fnIx, valIx)
      if fe >= 0 { return fe }
      // A module-scope `const` bound to a lambda literal (D3847). A function's own bindings keep
      // the scope chain's answer, which the alias resolvers refine.
      const li = identLetOfRead(valIx, fnIx)
      if li >= 0 && fnIx >= 0 {
        const fn = nodeAt(fnIx)
        if fn is FuncDecl {
          if bodyLetReadAtSid(fn.fnBody, sidOfNode(valIx), valIx) == li {
            return -1
          }
        }
      }
      if li >= 0 {
        const d = nodeAt(li)
        if d is LetDecl {
          // Un-annotated only: an annotation (a union with a function arm) is the binding's rep.
          if (
            d.letKw == "const"
            && d.letType < 0
            && d.letInit >= 0
            && nodeAt(d.letInit) is FuncDecl
          ) {
            return fnStmtsPosOf(d.letInit)
          }
          // A `let` bound once and never assigned holds its lambda like a `const` (D6390).
          if (
            d.letKw == "let"
            && d.letType < 0
            && d.letInit >= 0
            && nodeAt(d.letInit) is FuncDecl
          ) {
            const lam = cwLambdaDeclOf(cwBindingOf(valIx))
            if lam >= 0 && lam == d.letInit { return fnStmtsPosOf(lam) }
          }
        }
      }
      return -1
    }
    // No other field value names a function.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// The result valtype kind of lifted function `fe`'s `$fnsig` functype — the same kind the
// function's own functype emits, read from an annotation (`vtKindOfType`) or the stored
// inferred return kind, so the closure functype byte-matches the callee. `null` for a void
// result. The slot for the kinds that carry one comes from `cloRetValSlot`.
export function cloRetValKind(fe: i32): VKind | null {
  if fe < 0 || fe >= fnStmts.length { return null }
  if fe >= fRetVoid.length { return null }
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    if fRetVoid[fe] == 1 { return null }
    if fn.fnRet >= 0 {
      if tyIsFuncType(fn.fnRet) { return "closure" }
      return vtKindOfType(fn.fnRet)
    }
    if fnReturnsClosure(fe) { return "closure" }
    // A callback collapsing to one concrete variant is typed as that variant, so the
    // `$fnsig` result is the variant struct, not the union box. Checked before the
    // `"union"` kind, which the emitter's syntactic inference also stores.
    if cbRetVariantIdx(fe) >= 0 { return "variant" }
    // The shared inferred-return-kind mapping, the same one the named-function functype
    // result uses, so a kind added there is reflected here. The closure-specific cases are
    // layered around it.
    const core = inferredRetKindCore(fe)
    if core != "i32" { return core }
    // An f64 tail with no intervening local (`n => n * 2.0`) — detected structurally, not
    // via `fRetF64`; without it the callback's functype declares i32 over an f64 body.
    if tailIsF64NoLocal(fnRetExprOf(fnStmts[fe]), fnStmts[fe]) { return "f64" }
    return "i32"
  }
  null
}

// Does `fe` return a struct row, bare or nullable? A `C | null` element lives in the same
// ref list as a `C` one (the backing is already nullable), so `.map` builds both alike.
export function cloRetIsStructRow(fe: i32): boolean {
  const k = cloRetValKind(fe)
  k == "struct" || k == "nulstruct"
}

// The variant row of the `(ref null $uVarHeap[vi])` niche a call of `fe` returns, or -1.
// The annotation, or an un-annotated result's recorded return kind, is read first, so a call
// that is not the niche never runs `cloRetValKind`'s inference.
function cloRetNulVariantRow(fe: i32): i32 {
  if fe < 0 || fe >= fnStmts.length { return -1 }
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    if fn.fnRet >= 0 {
      if nulVariantIndexOf(fn.fnRet) < 0 { return -1 }
    } else {
      if fe >= fRetKind.length { return -1 }
      if fRetKind[fe] != "nulvariant" { return -1 }
    }
  }
  if cloRetValKind(fe) == "nulvariant" { return cloRetValSlot(fe) }
  -1
}

// The struct-table slot for `fe`'s result valtype — a real index only for the kinds that
// carry one (struct, nullable struct, variant, ref list, map), `-1` otherwise.
export function cloRetValSlot(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return -1 }
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    if fn.fnRet >= 0 {
      const k = vtKindOfType(fn.fnRet)
      if k == "struct" || k == "nulstruct" {
        return retStructRowIndex(fn.fnRet)
      }
      // A `: Cat` annotated variant result — the slot is the variant index.
      if k == "variant" { return annVariantRowOf(fn.fnRet) }
      // A `: Circle | null` annotated result — the slot is the variant index under the
      // null, since `retStructIndex` has no row for a variant.
      if k == "nulvariant" { return nulVariantIndexOf(fn.fnRet) }
      // A `: S[]` or `: ((i32) => i32)[]` annotated ref-list result — the slot is the
      // `rlWrapIdx`-bearing ref-list slot, the dual of a `cloParamTok` ref-list param's.
      if k == "reflist" || k == "nulreflist" {
        return tyAnnRefListSlot(fn.fnRet)
      }
      // A `: {[string]: V}` annotated map result — the slot is the map shape (-1 when mono,
      // else the value type's mv slot), so the `$fnsig` result selects this map's struct.
      if k == "map" || k == "nulmap" { return mapAnnShape(fn.fnRet) }
      return -1
    }
    // A collapsed-to-one-variant inferred result — the variant index.
    const cvi = cbRetVariantIdx(fe)
    if cvi >= 0 { return cvi }
    const srk = fRetKind[fe]
    match srk {
      "struct" | "nulstruct" => {
        return fRetStructIdx[fe]
      }
      // The inferred concrete-variant result, from the same companion column — the twin of
      // `emitOneFuncType`'s inferred `variant` arm — and its nullable twin (D1562): every
      // caller reads the kind and this slot as a pair, and (`"nulvariant"`, -1) trips
      // `fbValtype`'s bounds guard with `ref valtype with no interned shape`.
      "variant" | "nulvariant" => {
        return fRetStructIdx[fe]
      }
      // An inferred map or nullable-map return — the slot the function's own functype result reads.
      "map" | "nulmap" => {
        return inferredRetMapSlot(fe)
      }
      // An inferred ref-list return — its element name (`fRetRArrElem`, set by the
      // return-classify scan) resolves the ref-list slot.
      "reflist" => {
        return fnRetRefListSlot(fe)
      }
      // Every other inferred kind carries no slot.
      "i32" | "list" | "str" | "union" | "strlist" | "i64" | "f64" | "f64list" | "f32" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulnone" | "u8list" | "v128" => {}
    }
  }
  -1
}

// The `>X` result suffix of `fe`'s extended `$fnsig` key — one token per distinct result
// functype shape, so two functions share a sig exactly when their params and result
// byte-match. "" for a kind outside the value ABI; the caller key-builds a void result as
// `>v` before consulting this.
export function cloRetKeySuffix(fe: i32) {
  const k = cloRetValKind(fe)
  // The slot-carrying result kinds: a struct or nullable-struct result keyed by its struct
  // index, a concrete variant by its variant index, so two callbacks share a sig only when
  // they return the same shape.
  if k == "variant" { return ">" + repSigVariantTok(cloRetValSlot(fe)) }
  if k == "nulvariant" {
    const nrs = cloRetValSlot(fe)
    if nrs < 0 { return "" }
    return ">" + repSigNulVariantTok(nrs)
  }
  if k == "struct" || k == "nulstruct" {
    return ">" + repSigSlotTokOfKind(k, cloRetValSlot(fe))
  }
  // A map result carries its map shape slot, so two map-returning closures share a
  // `$fnsig` exactly when their value types match and the result `(ref $mapStruct)` is the
  // heap type the returned map and the closure's env field both carry.
  if k == "map" || k == "nulmap" {
    return ">" + repSigSlotTokOfKind(k, cloRetValSlot(fe))
  }
  // A ref-list result: the `$fnsig` result is the ref-list wrapper ref, recovered non-null
  // at the value-call site like every other ref result — the dual of the `r<idx>;` param
  // token. No resolved slot means no sig.
  if k == "reflist" || k == "nulreflist" {
    const rs = cloRetValSlot(fe)
    if rs >= 0 { return ">" + repSigSlotTokOfKind(k, rs) }
    return ""
  }
  // Every slot-free kind reads the shared canonical token table in `emit_rep`, a closure
  // result included, so a curried lambda lowers as a callable value. "" for a kind outside
  // the value ABI, and for the void or unresolved result the caller key-builds as `>v`.
  const t = repSigTokOfKind(k)
  if t == "" { return "" }
  ">" + t
}

// The extended `$fnsig` key of lifted function `fe`: `fnSigKeyOf`'s key when the sig is
// value-eligible, else the same param spine with `cloRetKeySuffix`'s result suffix. "" when
// any param or the result kind is outside the ABI.
export function cloSigKeyExt(fe: i32) {
  const base = fnSigKeyOf(fe)
  if base != "" { return base }
  if fe < 0 || fe >= fnStmts.length { return "" }
  if fe >= fRetVoid.length { return "" }
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    const params = fn.fnParams
    let key = ""
    let pi = 0
    while pi < params.length {
      const tok = cloParamTok(params[pi])
      if tok == "" { return "" }
      key = key + tok
      pi = pi + 1
    }
    if fRetVoid[fe] == 1 { return key + ">v" }
    const suf = cloRetKeySuffix(fe)
    if suf == "" { return "" }
    return key + suf
  }
  ""
}

// The lifted-function position of the closure held by field `prop` of struct `si`,
// resolved through the object literals that intern shape `si` — every literal of one
// shape carries sig-identical closures, so the first match types the call. -1 when no
// literal of shape `si` sets a function-valued `prop`.
function fieldClosureFeOf(si: i32, prop: string) {
  fieldClosureFeOfWant(si, prop, -1)
}

// `fieldClosureFeOf` restricted, when `want` is a function type, to a closure of exactly that
// type, else to one an open field value takes at it: one row stores closures of every
// signature alike, so only the type tells them apart. -1 when none has it.
function fieldClosureFeOfWant(si: i32, prop: string, want: i32) {
  if si < 0 { return -1 }
  let open = -1
  for ai in objLitSlotsNow() {
    if nodeAt(ai) is ObjLit && structIndexOfObj(ai) == si {
      const fv = objFieldVal(ai, prop)
      const ffe = fieldValueFeOf(fv)
      if ffe >= 0 {
        if want < 0 || tyEq(nodeTyIxOf(fnStmts[ffe]), want) { return ffe }
        if open < 0 && fieldValueTakesFnTy(fv, want) { open = ffe }
      }
    }
  }
  open
}

// Every `ObjLit` slot of the arena in ascending order, and every name a `FieldInit` sets. What a
// node IS changes only by a push (the length) or an in-place replacement (the epoch): an append
// extends both, a replacement rebuilds them. Reset per program.
let objLitSlots: i32[] = []
let objLitFieldNames: {[string]: i32} = Map()
let olsIxLen: i32 = -1
let olsIxEpoch: i32 = -1

function objLitSlotsReset() {
  objLitSlots = []
  objLitFieldNames = Map()
  olsIxLen = -1
  olsIxEpoch = -1
  0
}

function objLitSlotsNow(): i32[] {
  if P.nodes.length == olsIxLen && olsIxEpoch == arenaEpochNow() {
    return objLitSlots
  }
  let i = olsIxLen
  if olsIxEpoch != arenaEpochNow() || i < 0 || i > P.nodes.length {
    objLitSlots = []
    objLitFieldNames = Map()
    i = 0
  }
  while i < P.nodes.length {
    const n = nodeAt(i)
    if n is ObjLit { objLitSlots.push(i) }
    if n is FieldInit { objLitFieldNames[n.fiName] = 1 }
    i = i + 1
  }
  olsIxLen = P.nodes.length
  olsIxEpoch = arenaEpochNow()
  objLitSlots
}

// Whether the function a field value `fv` names, which the checker left open, has function type
// `want`: an un-annotated function by its body's result at `want`'s parameters, where the field's
// type is the one guessed at another literal of its row's call (D9312); else as its field is typed.
function fieldValueTakesFnTy(fv: i32, want: i32): boolean {
  const wk = sigKeyOfTy(want)
  const w = tyAt(want)
  if fv < 0 || wk == "" || !(w is TyFunc) { return false }
  const hr = holeFnArgRetAtParams(fv, w.fnParamTypes)
  if hr >= 0 { return sigKeyOfTy(mkFuncTy(w.fnParamTypes, hr)) == wk }
  // A closed type is the field's own and compares exactly; only an open one is a guess.
  const ft = nodeTyIxOf(fv)
  if ft < 0 || !(tyHasTyVar(ft) || tyHasInferHole(ft, 0)) { return false }
  sigKeyOfTy(ft) == wk
}

// The function type field `prop` of `recvIx`'s record has in the generic instance `fnIx` is,
// or is lifted inside: at its pin, else as the instance recorded it. -1 anywhere else, or where
// the field is not a function.
function instRecvFieldFnTy(recvIx: i32, prop: string, fnIx: i32): i32 {
  let rt = exactOperandTyOf(recvIx, fnIx)
  if rt < 0 && fnInMonoInstance(fnIx) {
    const nt = nodeTyAt(unwrapParen(recvIx), fnIx)
    if nt >= 0 && !tyHasTyVar(nt) { rt = nt }
    // A receiver typed at a type parameter reads the instance's own binding of it; a member
    // call's receiver is past its `null` (a `Z | null` parameter narrowed, D3124).
    if rt < 0 && nt >= 0 { rt = holeOperandTyOf(recvIx, fnIx) }
    if rt < 0 && nt >= 0 {
      const pt = valueReadPinTy(recvIx, fnIx, 0)
      if pt >= 0 { rt = nonNullTy(pt) }
    }
    if rt < 0 && nt >= 0 { rt = pinSubOperandTyOf(nt, fnIx) }
  }
  // A receiver a lambda captures reads the binding of the frame that declares it (D3141).
  if rt < 0 {
    const fs = captureDeclFrames(recvIx, fnIx)
    let i = 0
    while rt < 0 && i < fs.length {
      rt = exactOperandTyOf(recvIx, fs[i])
      if rt < 0 { rt = holeOperandTyOf(recvIx, fs[i]) }
      if rt < 0 {
        const pt = valueReadPinTy(recvIx, fs[i], 0)
        if pt >= 0 { rt = nonNullTy(pt) }
      }
      i = i + 1
    }
  }
  // Outside an instance the checker's own type of the receiver names the closure's signature,
  // where a declared record claiming the literal by its field names would name another (D3180).
  if rt < 0 && !fnInMonoInstance(fnIx) {
    const nt = nodeTyAt(unwrapParen(recvIx), fnIx)
    if nt >= 0 && !tyHasTyVar(nt) { rt = nonNullTy(nt) }
  }
  if rt < 0 { return -1 }
  const ft = tyFieldTyOf(nonNullTy(rt), prop)
  if ft < 0 || ft >= T.tys.length || !(tyAt(ft) is TyFunc) { return -1 }
  ft
}

// The lifted-function position of the closure a member call `recv.prop(...)` dispatches
// to: first by following the receiver to the literal that built it, so two same-shaped
// receivers from different monomorphized makers each resolve their own closure, else by
// the receiver's struct shape (`fieldClosureFeOf`). -1 when neither resolves.
export function fieldClosureFeOfRecv(recvIx: i32, prop: string, fnIx: i32) {
  // A receiver already being resolved further up answers -1 here: the walk reaches a maker's
  // tail through `fnRetExprOf`, and that tail can be this same member call (D4290).
  if fcrInFlight(recvIx, fnIx) { return -1 }
  // Every answer below is read off an object literal's `prop` field, so a name no literal
  // sets anywhere in the arena resolves nothing.
  if !fnValUsed { return -1 }
  objLitSlotsNow()
  if objLitFieldNames[prop] == null { return -1 }
  fcrRecvStack.push(recvIx)
  fcrFnStack.push(fnIx)
  const fe = fieldClosureFeOfRecvRaw(recvIx, prop, fnIx)
  fcrRecvStack.pop()
  fcrFnStack.pop()
  if fe < 0 { return fe }
  // Records of one row whose closures differ in signature: the receiver's type names which one
  // it holds, where the syntactic walk above can reach only the first (D3110). A closure of
  // another closed type is never the answer.
  const want = instRecvFieldFnTy(recvIx, prop, fnIx)
  const fty = nodeTyIxOf(fnStmts[fe])
  if want < 0 || tyEq(fty, want) { return fe }
  const tfe = fieldClosureFeOfWant(structIndexOfExpr(recvIx, fnIx), prop, want)
  if tfe >= 0 { return tfe }
  if (
    fty >= 0
    && !tyHasTyVar(fty)
    && !tyHasInferHole(fty, 0)
    && !tyHasTyVar(want)
  ) {
    return -1
  }
  fe
}

function fieldClosureFeOfRecvRaw(recvIx: i32, prop: string, fnIx: i32) {
  // With no function value module-wide there is no closure field: every terminal below is
  // `fieldValueFeOf(objFieldVal(…))`, which resolves only a lambda field or a bare
  // function-name field, so the flag being clear makes -1 the only answer. The gate also
  // keeps the hole-param arm below from scanning the whole arena per member call.
  if !fnValUsed { return -1 }
  const e = nodeAt(unwrapParen(recvIx))
  if e is Ident {
    let li = -1
    if fnIx >= 0 {
      const fn = nodeAt(fnIx)
      if fn is FuncDecl { li = bodyLetOfRead(fn.fnBody, unwrapParen(recvIx)) }
    }
    if li < 0 { li = globalLetOfRead(fnIx, unwrapParen(recvIx)) }
    if li >= 0 {
      const d = nodeAt(li)
      if d is LetDecl {
        const ffe = fieldClosureFeOfInit(d.letInit, prop, fnIx)
        if ffe >= 0 { return ffe }
      }
    }
  }
  // A literal receiver reads its own field: a per-instance clone of it shares its shape with
  // the template's, so the shape scan below would answer the template's closure (D2551).
  if e is Call || e is ObjLit {
    const ffe2 = fieldClosureFeOfInit(unwrapParen(recvIx), prop, fnIx)
    if ffe2 >= 0 { return ffe2 }
  }
  // A hole param's receiver is its argument, which the struct-index fallback below cannot
  // see: `{f: () => string}` and `{f: () => i32}` collapse to one struct row, so the scan
  // returns whichever literal is declared first and traps otherwise (D987). Resolving the
  // call-site argument disambiguates without refusing the two order-lucky spellings.
  if e is Ident {
    if fnIx >= 0 {
      const rf = nodeAt(fnIx)
      if rf is FuncDecl {
        if rf.fnName != "" {
          const rps = rf.fnParams
          let rpi = 0
          while rpi < rps.length {
            const rpn = nodeAt(rps[rpi])
            if rpn is Param {
              if rpn.parName == e.identName {
                const rcs = callsOfCallee(rf.fnName)
                let rcj = 0
                while rcj < rcs.length {
                  const rcn = nodeAt(rcs[rcj])
                  if rcn is Call {
                    if rpi < rcn.callArgs.length {
                      // fnIx -1: the argument resolves in module scope, which also
                      // stops this arm re-entering for a param of the same name.
                      const rfe = fieldClosureFeOfRecv(
                        rcn.callArgs[rpi],
                        prop,
                        -1,
                      )
                      if rfe >= 0 { return rfe }
                    }
                  }
                  rcj = rcj + 1
                }
              }
            }
            rpi = rpi + 1
          }
        }
      }
    }
  }
  fieldClosureFeOf(structIndexOfExpr(recvIx, fnIx), prop)
}

// Resolve `prop`'s closure through an initializer expression: an object literal reads its
// own field, a call to a maker follows the maker's return expression. -1 otherwise.
function fieldClosureFeOfInit(initIx: i32, prop: string, fnIx: i32) {
  if initIx < 0 { return -1 }
  const e = nodeAt(unwrapParen(initIx))
  match e {
    ObjLit => {
      return fieldValueFeOfIn(objFieldVal(unwrapParen(initIx), prop), fnIx)
    }
    Call => {
      if e.callFn < 0 { return -1 }
      const callee = nodeAt(e.callFn)
      if callee is Ident {
        const t = fnIndexOfNode(e.callFn)
        if t >= 0 {
          const rx = fnRetExprOf(fnStmts[t])
          if rx >= 0 {
            const re = nodeAt(unwrapParen(rx))
            if re is ObjLit {
              return fieldValueFeOf(objFieldVal(unwrapParen(rx), prop))
            }
          }
        }
      }
    }
    // No other initializer has a field to read a function from.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// True when the bare identifier `sid`, read at node `atIx` (-1: position unknown) from inside
// function `fnIx`, is bound by that frame — a declared local, a param or a capture — so a
// module global of the same name is not what the reference denotes. It asks `localIndexOf` and
// `capturedKindOf`, the resolvers the lowering itself uses, so the two cannot disagree (D705).
export function identBoundAt(fnIx: i32, sid: i32, atIx: i32) {
  const name = sidText(sid)
  if atIx >= 0 && sidOfNode(atIx) == sid && localIndexOf(fnIx, atIx) >= 0 {
    return true
  }
  if paramIndexOf(fnIx, name) >= 0 { return true }
  if capturedKindOf(fnIx, name) != null { return true }
  // The arena rung, because the local columns are empty in the global passes: `buildLocals` runs
  // per function during emission, long after `computeRetInference`.
  if fnIx < 0 { return false }
  const fnb = nodeAt(fnIx)
  if fnb is FuncDecl {
    if fnHasParamSid(fnb.fnParams, sid) { return true }
    // A `let` in a block the read is outside does not hide the global (D3294).
    const r = bodyReadLet(fnb.fnBody, sid, atIx)
    if r != PL_READ_UNPLACED { return r >= 0 }
  }
  false
}

// The module global the read `readIx` inside function `fnIx` denotes, or -1. The read's own
// declaration decides; a minted read, which has none, asks the frame whether it binds the name.
export function globalLetOfRead(fnIx: i32, readIx: i32) {
  if readIx < 0 { return -1 }
  const sid = sidOfNode(readIx)
  const li = globalLetOfSid(sid)
  if li < 0 { return -1 }
  const d = identDeclOf(readIx)
  if d >= 0 { return if d == li || declOrigOf(d) == li { li } else { -1 } }
  if identBoundAt(fnIx, sid, readIx) { return -1 }
  li
}

// True when the resolver bound the read `readIx` to a module global, which it then denotes
// whatever the live scope holds: a chase into a global's initializer runs inside the
// reader's frame, whose same-named local would otherwise answer, and can lead back to the
// chase's start (D9681).
export function identReadsGlobal(readIx: i32): boolean {
  if readIx < 0 { return false }
  const li = globalLetOfSid(sidOfNode(readIx))
  li >= 0 && identDeclOf(readIx) == li
}

// Whether the global the read `readIx` denotes is a struct/array/string ref (so a bare
// reference to it in an `exprStruct`/`exprArray`/`exprString` check is recognized as that
// ref type). The global's valtype follows its `LetDecl` annotation or literal initializer,
// evaluated as a top-level constexpr (`fnIx = -1`), mirroring the local `letIsX` predicates.
function globalReadIsStruct(fnIx: i32, readIx: i32) {
  const li = globalLetOfRead(fnIx, readIx)
  if li < 0 { return false }
  letIsStruct(li, -1)
}

function globalReadIsString(fnIx: i32, readIx: i32) {
  const li = globalLetOfRead(fnIx, readIx)
  if li < 0 { return false }
  // A `string | null` global reads as a string under narrowing: the global read recovers
  // non-null, and the `!= null` check reads the cell raw.
  globalReadAsk(sidOfNode(readIx), li, 2)
}

function globalReadIsMap(fnIx: i32, readIx: i32) {
  const li = globalLetOfRead(fnIx, readIx)
  if li < 0 { return false }
  letIsMap(li, -1)
}

// True if the function `name` returns a nullable struct (`"nulstruct"`).
function fnRetNulRefSid(sid: i32, name: string, fnIx: i32, at: i32) {
  repOfNameResult(sid, name, fnIx, at).rdKind == "nulstruct"
}

// The variant-table index a `Circle | null` binding's `(ref null $uVarHeap[vi])` cell
// resolves to, or -1 — the `nulvariant` twin of `nulRefStructIdxOfLet`. A value-union
// annotation boxes the init at the store, so it holds no niche whatever the init is (D1721).
export function nulVariantIdxOfLet(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      const a = nulVariantIndexOf(d.letType)
      if a >= 0 { return a }
      if letAnnIsUnion(letIx) { return -1 }
    }
    return nulVariantIdxOfExpr(d.letInit, fnIx)
  }
  -1
}

// The non-null twin of `capturedNulVariantIdx`: the variant-table index of a captured
// `v: Circle` cell, or -1. Same index space and kind gate; without it `exprVariantIndex`'s
// Ident arm has no capture leg and a captured variant handed to a union parameter is
// never boxed.
function capturedVariantIndex(fnIx: i32, name: string) {
  if capturedKindOf(fnIx, name) != "variant" { return -1 }
  capturedCompanionSlot(fnIx, name)
}

// The variant row of the `(ref null $uVarHeap[vi])` niche expression `exprIx` holds, or -1
// when it holds none. The one producer of the nullable-variant kind and its row:
// `exprNullableVariant` is this answer `>= 0`. Each arm reads the storage that typed the value,
// so an arm and its layout twin in another position keep their own rows.
export function nulVariantIdxOfExpr(exprIx: i32, fnIx: i32): i32 {
  if exprIx < 0 { return -1 }
  const e = nodeAt(exprIx)
  match e {
    Paren => {
      return nulVariantIdxOfExpr(e.parInner, fnIx)
    }
    // An if-expression whose arms join to one nullable rep (D1560): the row comes from the
    // arm that carries the rep.
    IfStmt => {
      const nlv = nulIfArmNullableValueIx(exprIx)
      if nlv < 0 { return -1 }
      const nlr = nulVariantIdxOfExpr(nlv, fnIx)
      if nlr < 0 { return -1 }
      const rav = ifRepArmValueIx(exprIx)
      if rav == nlv { return nlr }
      return nulVariantIdxOfExpr(rav, fnIx)
    }
    // A nullable variant-element list read (D851), then a bare `m[k]` over an arm-valued map
    // (D34).
    Index => {
      if exprRefArray(e.idxArr, fnIx) {
        const irls = refListSlotOfExpr(e.idxArr, fnIx)
        if irls >= 0 && irls < rlElemKindTbl.length {
          if rlElemKindTbl[irls] == RLK_STRUCT {
            if rlElemIsNulNiche(irls) {
              const irlv = rlElemVariantRow(irls)
              if irlv >= 0 { return irlv }
            }
          }
        }
      }
      const mri = mapReadMvSlot(exprIx, fnIx)
      if mri >= 0 { return mvValVariantOf(mri) }
    }
    BinExpr => {
      // An assignment's value is its target cell (D2603).
      if e.binOp == "=" {
        const ar = asgReadNode(exprIx, fnIx)
        if ar != exprIx { return nulVariantIdxOfExpr(ar, fnIx) }
      }
      // `m[k] ?? d` over an arm-valued map stays the niche only while `d` can be null.
      const cri = coalesceMvSlot(exprIx, fnIx)
      if cri >= 0 {
        if !coalesceStaysNullable(exprIx, cri, fnIx) { return -1 }
        return mvValVariantOf(cri)
      }
      // A same-arm `p ?? q` stays the left niche while its default is nullable (D2373).
      if e.binOp == "??" && !coalesceResultIsBox(exprIx) {
        const lv = nulVariantIdxOfExpr(e.binLeft, fnIx)
        if lv >= 0 && coalesceDefaultNullable(e.binRight, fnIx) { return lv }
      }
    }
    AsExpr => {
      return nulVariantIndexOf(exprIx)
    }
    // The index half of the nested-shape field arm — same field, same column, one fact
    // (D1150).
    Member => {
      return memberNulVariantRow(exprIx, fnIx)
    }
    // A call of a `: Circle | null`-returning function — the callee's own annotation owns the
    // index, which is what an inferred binding has to read: it has no annotation of its own,
    // and its slot is declared from this answer.
    Call => {
      if e.callFn < 0 { return -1 }
      const callee = nodeAt(e.callFn)
      if callee is Ident {
        const cfe = fnIndexOfNode(e.callFn)
        if cfe >= 0 { return cloRetNulVariantRow(cfe) }
        // A closure-value callee (`const f = mk; f()`), which `fnIndexOfSid` misses.
        // `calleeCloSigKeySid` is the key the kind comes from and `sigKeyRetSlot` that same
        // key's slot digit, so the pair stays one fact.
        const nvck = calleeCloSigKeyOfRead(e.callFn, fnIx)
        if sigKeyRetKind(nvck) == "nulvariant" { return sigKeyRetSlot(nvck) }
        return -1
      }
      if callee is Member {
        const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
        if ffe >= 0 {
          const fvr = cloRetNulVariantRow(ffe)
          if fvr >= 0 { return fvr }
        }
      }
      return popArmElemVariantRow(exprIx, fnIx)
    }
    // A read: the row of the storage it reads, the type it is narrowed out of, else its own.
    Ident => {
      return nulVariantRowOfRead(exprIx, fnIx)
    }
    // No other expression carries a nullable variant row.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// The variant row of the `(ref null $uVarHeap[vi])` niche the read `ix` reads inside `fnIx`: its
// storage type's, which is the type it is narrowed out of, else its own type; -1 for none.
function nulVariantRowOfRead(ix: i32, fnIx: i32): i32 {
  let st = readNarrowedStoreAt(ix, fnIx)
  if st < 0 { st = nodeTyAt(ix, fnIx) }
  if st < 0 || st >= T.tys.length { return -1 }
  const sty = tyAt(st)
  if sty is TyNullable { return repVariantShapeRowOf(sty.nInner) }
  -1
}

// The nullable local `VKind` a bare `const t = m[k]` read of a list- or nested-map-valued
// map binds, or null when the init is not such a read. The read yields `V | null`, the
// `(ref null $wrapper)` vals element, so this only routes the spelling onto an established
// nullable local kind whose narrow and read machinery already lowers.
export function letNulMapReadValKind(letIx: i32, fnIx: i32): VKind | null {
  const d = nodeAt(letIx)
  if !(d is LetDecl) { return null }
  if d.letType >= 0 { return null }
  if d.letInit < 0 { return null }
  const mrs = mapReadMvSlot(d.letInit, fnIx)
  if mrs < 0 { return null }
  if mvValKind[mrs] != MVK_REF { return null }
  match mvListValKind(mrs) {
    "list" => {
      return "nullist"
    }
    "strlist" => {
      return "nulstrlist"
    }
    "f64list" => {
      return "nulf64list"
    }
    "i64list" => {
      return "nuli64list"
    }
    "f32list" => {
      return "nulf32list"
    }
    "u8list" => {
      return "nulu8list"
    }
    "reflist" => {
      return "nulreflist"
    }
    // A value that is not a list has no nullable-list twin.
    "i32" | "struct" | "str" | "union" | "map" | "variant" | "nulvariant" | "nulstruct" | "i64" | "f64" | "f32" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "v128" | null => {}
  }
  // A nested-map value (`{[string]: {[string]: V}}`, vals element kind 3, the inner map
  // struct): the read binds the nullable-map local.
  if rlElemKindTbl[mvRlSlot[mrs]] == RLK_MAP { return "nulmap" }
  null
}

// The `addLocalSlot` slot argument for a `letNulMapReadValKind` binding: the inner ref-list
// slot for a `nulreflist`, the inner map's shape slot for a `nulmap` (-1 when mono), and -1
// for the scalar-backed list kinds, whose wrappers are global singletons.
export function letNulMapReadSlotArg(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if !(d is LetDecl) { return -1 }
  const mrs = mapReadMvSlot(d.letInit, fnIx)
  if mrs < 0 { return -1 }
  if mvListValKind(mrs) == "reflist" { return mvValInnerRlSlotAt(mrs) }
  if rlElemKindTbl[mvRlSlot[mrs]] == RLK_MAP { return mvValInnerMvSlot(mrs) }
  -1
}

// True if the `LetDecl` at `letIx` is a bare `const t = m[k]` read of a union-valued map.
// The read is `V | null` and the local rep for `A | B | null` is the shared box itself,
// with `null` riding as the null-tagged atom, so the binding is the non-null
// `(ref $uBoxIdx)` cell. Gated to un-annotated bindings: an annotation drives the kind.
export function letNulMapReadUnionBox(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 { return false }
    const mrs = mapReadMvSlot(d.letInit, fnIx)
    if mrs >= 0 {
      // Except where the read unboxes: a cell narrowed to one value atom leaves no box for
      // this local to hold (D1025), so the slot follows the read rather than the map's rep.
      if mapReadNarrowedAtomKind(unwrapParen(d.letInit), fnIx) >= 0 {
        return false
      }
      // …and where it unboxes to a CONTAINER arm, for the same reason: the init delivers
      // that container's own ref, so a box cell cannot hold it (D1866).
      if mapReadNarrowedContainer(unwrapParen(d.letInit), fnIx) { return false }
      // …and where it converts to a niche `A | null` (D2590).
      if placeNicheAtomKind(unwrapParen(d.letInit), fnIx) >= 0 { return false }
      return mvValKind[mrs] == MVK_UNION
    }
  }
  false
}

// The receiver's ref-list slot of a checked read over a nested list, or -1 — the row every
// question about the read element asks, such as its inner slot in `nulRefArrayInnerSlot`. `.get(i)` counts for the same reason `.pop()` does (D1281): both
// are `T | null` over the same receiver and both yield the inner list's wrapper.
function popRefRecvSlot(exprIx: i32, fnIx: i32): i32 {
  if exprIx < 0 { return -1 }
  const e = nodeAt(exprIx)
  match e {
    Paren => {
      return popRefRecvSlot(e.parInner, fnIx)
    }
    Call => {
      if e.callFn < 0 { return -1 }
      const callee = nodeAt(e.callFn)
      if callee is Member {
        if callee.memProp == "pop" || callee.memProp == "get" {
          if exprRefArray(callee.memObj, fnIx) {
            return refListSlotOfExpr(callee.memObj, fnIx)
          }
        }
      }
    }
    // No other expression is a ref-list pop or get.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Member | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// The variant row a `.pop()` / `.get(i)` over a union-arm element list yields as its
// `Arm | null` niche, or -1 when the read is not one (D4668).
function popArmElemVariantRow(exprIx: i32, fnIx: i32): i32 {
  const slot = popRefRecvSlot(exprIx, fnIx)
  if slot < 0 || slot >= rlElemKindTbl.length { return -1 }
  if rlElemKindTbl[slot] != RLK_STRUCT { return -1 }
  rlElemVariantRow(slot)
}

// Whether the value at `exprIx` is an `i32[] | null` the checker has not narrowed present.
export function exprNullableList(exprIx: i32, fnIx: i32): boolean {
  exprNulKind(exprIx, fnIx) == "nullist"
}

// Whether the value at `exprIx` is a ref list (`S[] | null`, `i32[][] | null`) the checker has
// not narrowed present.
export function exprNullableRefArray(exprIx: i32, fnIx: i32): boolean {
  exprNulKind(exprIx, fnIx) == "nulreflist"
}

// The inner ref-list slot of a nullable ref-array expression — a read takes it from its checked
// type; an `Index` over a `(<ref-array> | null)[]` resolves it from the ref-array element,
// whose inner name recurses through the `| null`.
function nulRefArrayInnerSlot(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = nodeAt(exprIx)
  if e is Paren { return nulRefArrayInnerSlot(e.parInner, fnIx) }
  // `u as? S[]` out of a union box: the arm's own row.
  if e is AsExpr {
    const asArm = asUnionNulArmTy(exprIx, fnIx)
    if unMemIsRefElemArray(asArm) { return rlSlotOfTy(tyRefArrElemOf(asArm)) }
  }
  // The slot half of `exprNullableRefArray`'s if-expression rung (D1560) — read off the arm
  // the kind comes from, or the binding takes slot -1 and `fbValtypeNullable` has no shape
  // to name.
  // A non-null ref-list arm beside `null` names its own row, as `ifExprRefSlot` does (D2236).
  if e is IfStmt {
    const rav = ifRepArmValueIx(exprIx)
    const ras = nulRefArrayInnerSlot(rav, fnIx)
    if ras >= 0 { return ras }
    if exprRefArray(rav, fnIx) { return refListSlotOfExpr(rav, fnIx) }
    return -1
  }
  // A read names the inner row of the type the checker gave it: the ref list its element is.
  if e is Ident { return rlSlotOfTy(tyRefArrElemOf(nodeTyAt(exprIx, fnIx))) }
  // A code-28 nullable ref-list field member: its element ref-list slot (the field's element name).
  if e is Member {
    if memberFieldCode(exprIx, fnIx) == FC_NUL_REF_LIST {
      return refListSlotOfExpr(exprIx, fnIx)
    }
    return -1
  }
  // The `?.` twin of the arm above, one code wider: the receiver's `| null` makes even a
  // non-nullable ref-list field's read nullable, so code 5 answers here too (D1681).
  if e is OptMember {
    const orc = optChainLeafFieldCode(exprIx, fnIx)
    if orc == FC_REF_LIST || orc == FC_NUL_REF_LIST {
      return refListSlotOfExpr(exprIx, fnIx)
    }
    return -1
  }
  if e is Index {
    const slot = refListSlotOfExpr(e.idxArr, fnIx)
    if slot >= 0 && slot < rlElemName.length { return rlElemInnerSlot(slot) }
  }
  // A nulreflist-returning call: its inner ref-list slot is the return's inner element.
  if e is Call {
    // `g.pop()` over an `S[][]`: the popped element is the inner ref list, so the row is the
    // receiver slot's inner one — the same answer the `Index` arm gives (D1210).
    const pes = popRefRecvSlot(exprIx, fnIx)
    if pes >= 0 && pes < rlElemName.length { return rlElemInnerSlot(pes) }
    if e.callFn < 0 { return -1 }
    const callee = nodeAt(e.callFn)
    if callee is Ident {
      const rs = fnRetNulRefArraySlotSid(
        sidOfNode(e.callFn),
        callee.identName,
        fnIx,
        e.callFn,
      )
      if rs >= 0 { return rs }
    }
    // A function-value callee keyed `>R<slot>;` answers the slot its signature carries (D5882).
    const nvk = cloCallSigKey(exprIx, fnIx)
    if sigKeyRetKind(nvk) == "nulreflist" {
      const nvs = sigKeyRetSlot(nvk)
      if nvs >= 0 && nvs < rlElemName.length { return nvs }
    }
  }
  // `p ?? d` over the same niche yields the left place's inner ref list, so an inferred
  // `const v = p ?? q` stores the row `emitCoalesce` declares its block type from. Without
  // it the binding takes slot -1 and `fbValtypeNullable` has no shape to name.
  const nriLhs = coalesceNicheLhs(exprIx)
  if nriLhs >= 0 { return nulRefArrayInnerSlot(nriLhs, fnIx) }
  -1
}

// Binding test for a kind-18 nullable ref-array local: annotation `<ref-array> | null`, else an
// un-annotated init that yields a nullable ref array.
export function letIsNulRefArray(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = nodeAt(d.letType)
      if lt is TypeRef {
        // The nullable annotation's inner element row — the read counterpart of
        // `nulRefArrayInnerSlotOfLet`'s slot; both must agree on which bindings are kind 18.
        if annNulRefArrSlot(d.letType) >= 0 { return true }
      }
      return false
    }
    return exprNullableRefArray(d.letInit, fnIx)
  }
  false
}

// The inner ref-list slot to store for a kind-18 binding — from its annotation (`<ref-array> | null` →
// the ref-array's element slot) or its initializer.
export function nulRefArrayInnerSlotOfLet(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = nodeAt(d.letType)
      if lt is TypeRef {
        // The annotation's inner ref-list row — the write half of the pair whose read is
        // `nulRefArrayInnerSlot`.
        return annNulRefArrSlot(d.letType)
      }
      return -1
    }
    return nulRefArrayInnerSlot(d.letInit, fnIx)
  }
  -1
}

// The nullable distinct-backing list kind (`nulstrlist`, `nulf64list`, …) of the value at
// `exprIx`, or null for any other value, a narrowed one included.
export function exprNulScalarListKind(exprIx: i32, fnIx: i32): VKind | null {
  const k = exprNulKind(exprIx, fnIx)
  if isNulScalarListKind(k) { return k }
  null
}

export function letIsNulString(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      if nodeRepIs(d.letType, "nulstr", fnIx) { return true }
      // A generic instance's binding carries the re-check's type, which can drop a null its
      // `if` still yields at the pin; the cell holds what the join builds (D3290).
      if d.letInit >= 0 && fnInPinnedInstance(fnIx) {
        if nodeAt(unwrapParen(d.letInit)) is IfStmt {
          return exprNullableString(d.letInit, fnIx)
        }
      }
    }
    if d.letType < 0 {
      // An un-annotated `const x = if c then "hi" else null` infers `string | null`, a niche
      // the emitter cannot derive from the if-expression arms. The checker typed it and
      // exported the binding by node index, so consult that before the init-shape probe.
      if isInferLetNulStr(letIx) { return true }
      return exprNullableString(d.letInit, fnIx)
    }
  }
  false
}

// The nullable rep kind of the value at `exprIx` (`nulstr`, `nulbool`, …), or null for a value
// that is not a nullable niche or a node the checker recorded no type for. A read the checker
// narrowed to `null` still holds its cell, so the cell's kind answers for it.
export function exprNulKind(exprIx: i32, fnIx: i32): VKind | null {
  if exprIx < 0 { return null }
  const d = repOfNode(exprIx, fnIx)
  if d.rdCovered != 1 { return null }
  if d.rdKind == "nulnone" { return nulNoneReadCellKind(exprIx, fnIx) }
  vkNulKindOf(d.rdKind)
}

// The kind of the cell a `null`-narrowed read names: a name's cell, or a field's by its code.
// `nulnone` when the read names no cell, since the value is then the `null` unit itself.
function nulNoneReadCellKind(exprIx: i32, fnIx: i32): VKind {
  const ck = readCellKind(exprIx, fnIx)
  if ck != null { return ck }
  "nulnone"
}

// The kind of the cell a read takes its value from: a name's cell, or a field's storage. A
// code-15 field is stored nullable whether it is declared `S` or `S | null`. Null for a node
// that names no cell, or a field whose storage is not a nullable niche.
function readCellKind(exprIx: i32, fnIx: i32): VKind | null {
  const ck = identCellVKind(exprIx, fnIx)
  if ck != null { return ck }
  const fc = memberFieldCode(unwrapParen(exprIx), fnIx)
  if fc == FC_NUL_STR { return "nulstr" }
  if fc == FC_NUL_BOOL { return "nulbool" }
  if fc == FC_STRUCT { return "nulstruct" }
  if fc == FC_NUL_CLOSURE { return "nulclosure" }
  if fc == FC_NUL_MAP { return "nulmap" }
  const lk = listRepOfFieldCode(fc)
  if lk == null { return null }
  vkNulKindOf(lk)
}

// Does the read at `exprIx` hold a nullable ref its recorded rep says is present? The checker
// narrowed it to the cell's non-null twin, so the read recovers and every consumer sees the
// read's recorded rep. A `string | null` read keeps its own eager rule.
export function readOwesNonNullRecover(exprIx: i32, fnIx: i32): boolean {
  // A read at its storage is the nullable cell itself.
  if isStorageRead(exprIx) { return false }
  // A primitive is one rep in every instance, and none is a ref.
  if nodeTyPrimName(exprIx) != "" { return false }
  const ck = readCellKind(exprIx, fnIx)
  if ck == null { return false }
  const tw = vkNonNullRefTwin(ck)
  if tw == null { return false }
  const d = repOfNode(exprIx, fnIx)
  d.rdCovered == 1 && d.rdKind == tw
}

// Can the cell the read at `exprIx` names hold null, whatever the read narrows to? A
// question about the storage before any guard, such as a loop prologue's hoisted header.
export function readCellHoldsNullRef(exprIx: i32, fnIx: i32): boolean {
  const ck = readCellKind(exprIx, fnIx)
  ck != null && vkNonNullRefTwin(ck) != null
}

// The non-null twin of a nullable ref kind, or null for a kind that is not one.
function vkNonNullRefTwin(k: VKind): VKind | null {
  match k {
    "nulvariant" => {
      return "variant"
    }
    "nulstruct" => {
      return "struct"
    }
    "nullist" => {
      return "list"
    }
    "nulreflist" => {
      return "reflist"
    }
    "nulclosure" => {
      return "closure"
    }
    "nulstrlist" => {
      return "strlist"
    }
    "nulf64list" => {
      return "f64list"
    }
    "nuli64list" => {
      return "i64list"
    }
    "nulf32list" => {
      return "f32list"
    }
    "nulu8list" => {
      return "u8list"
    }
    "nulmap" => {
      return "map"
    }
    "nulstr" | "nulbool" | "nulnone" | "i32" | "struct" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "i64" | "f64" | "f64list" | "f32" | "closure" | "i64list" | "f32list" | "u8list" | "v128" => {
      return null
    }
  }
}

// `k` when it is a nullable niche kind, else null.
function vkNulKindOf(k: VKind): VKind | null {
  match k {
    "nulvariant" | "nulstruct" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" => {
      return k
    }
    "i32" | "struct" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "i64" | "f64" | "f64list" | "f32" | "closure" | "i64list" | "f32list" | "u8list" | "v128" => {
      return null
    }
  }
}

// Whether the value at `exprIx` is a `string | null` ref.
export function exprNullableString(exprIx: i32, fnIx: i32) {
  exprNulKind(exprIx, fnIx) == "nulstr"
}

// The base struct index of a nullable-struct `LetDecl`: the annotation's base, or the
// initializer's resolved struct.
export function nulRefStructIdxOfLet(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      const ri = retNulRefIndex(d.letType)
      if ri >= 0 { return ri }
    }
    return structIndexOfExpr(d.letInit, fnIx)
  }
  -1
}

// True if evaluating the expression at `exprIx` yields a nullable struct ref — a
// nullable-annotated param, local or global reference, or a `S | null`-returning call.
export function exprNullableStruct(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = nodeAt(exprIx)
  match e {
    Paren => {
      return exprNullableStruct(e.parInner, fnIx)
    }
    // An assignment's value is its target cell, as `exprUnion` states it (D2602).
    BinExpr => {
      if e.binOp == "=" {
        const ar = asgReadNode(exprIx, fnIx)
        if ar != exprIx { return exprNullableStruct(ar, fnIx) }
      }
    }
    // Any other expression is classified below.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | Call | Member | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  // An `if` whose arm is itself nullable — see `nulIfArmNullableValueIx` (D1560). Asked
  // first because the rung below returns whatever its non-null predicate says, and a
  // `S | null`-returning call arm answers no to that one.
  const nlIfS = nulIfArmNullableValueIx(exprIx)
  if nlIfS >= 0 {
    if exprNullableStruct(nlIfS, fnIx) { return true }
  }
  // An if-expression with a null arm over a struct arm — see `nulArmIfThenValueIx`.
  const elIfS = nulArmIfThenValueIx(exprIx, fnIx)
  if elIfS >= 0 { return structIndexOfExpr(elIfS, fnIx) >= 0 }
  // `x as? S` over a union yields `S | null`, the nullable struct ref. The `AsExpr` twin of
  // the `exprNullableString` arm; both read the cast's own recorded type, which for the
  // coalescing member is the nullable result.
  match e {
    AsExpr => {
      if nodeRepIs(exprIx, "nulstruct", fnIx) { return true }
      return asNulStructRow(exprIx) >= 0
    }
    Call => {
      if e.callFn < 0 { return false }
      const callee = nodeAt(e.callFn)
      if callee is Ident {
        if (
          fnRetNulRefSid(sidOfNode(e.callFn), callee.identName, fnIx, e.callFn)
        ) {
          return true
        }
        // An `S | null`-returning function value (a binding, or a `(…) => S | null` param
        // callee) — its result is the nullable struct ref, `>nN;`.
        if calleeRetKindOfRead(e.callFn, fnIx) == "nulstruct" { return true }
      }
      // An `S | null`-returning field-closure call.
      if callee is Member {
        const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
        if ffe >= 0 && repOfFnSlot(ffe).rdKind == "nulstruct" { return true }
      }
      // `xs.pop()` and `xs.get(i)` over a struct-element ref list yield `S | null` — a pop of
      // an empty list and an out-of-range get are both null.
      if structListPopGetElem(exprIx, fnIx) >= 0 { return true }
      // Fallback, scoped to a call: a nullable-struct-returning closure value call whose callee
      // the cases above miss, such as an indexed closure-array element. Either object niche
      // counts, a union arm's included, so `letIsNulRef` classifies such a binding nullable
      // and its `!= null` narrow gets context.
      return nodeRepIs(exprIx, "nulstruct", fnIx)
        || nodeRepIs(exprIx, "nulvariant", fnIx)
    }
    // A read is what its recorded rep says: a narrowed read of a nullable cell, and a plain
    // `inner: S` field stored `(ref null $S)`, recover at the read (`readOwesNonNullRecover`).
    Ident | Member => {
      return exprNulKind(exprIx, fnIx) == "nulstruct"
    }
    // The `?.` spelling of the same read (D1084): `o?.f` over a code-15 field is `S | null`
    // for the second reason as well as the first — the chain itself can be null — so it is
    // nullable-classified wherever `o.f` is, which is what makes the un-annotated spelling
    // work. `optChainStructIdxOf` is the resolver the emitter uses at this node.
    OptMember => {
      const oNsi = optChainStructIdxOf(e.omObj, fnIx)
      if oNsi >= 0 {
        const oNfi = sFieldIndex(oNsi, e.omProp)
        if oNfi >= 0 { return sFieldTypeAt(oNsi, oNfi) == FC_STRUCT }
      }
      return false
    }
    // An index into a nullable-struct array (`(P | null)[]`) yields `P | null` — the element
    // legitimately holds null, so the read is not recovered to non-null as a `P[]` element
    // is. `const e = xs[i]` binds the nullable-struct niche.
    Index => {
      if exprRefArray(e.idxArr, fnIx) {
        // Guard the slot: a narrowed union-arm rebind receiver classifies `exprRefArray` true
        // while the slot resolver can still miss, and an unguarded `rlElemKindTbl[-1]` is an
        // out-of-bounds crash in the compiler itself.
        const slot = refListSlotOfExpr(e.idxArr, fnIx)
        if slot >= 0 && slot < rlElemKindTbl.length {
          if rlElemKindTbl[slot] == RLK_STRUCT {
            // The element must be a struct row, not a union arm (D851): a `(Circle | null)[]`
            // whose `Circle` is a declared union's member also interns kind 1, and its element
            // heap is `uVarHeap[vi]` rather than `sHeapIdx`, so claiming it here binds the read
            // to a `nulstruct` local whose struct row does not exist.
            if rlElemVariantRow(slot) < 0 {
              if rlElemIsNulNiche(slot) { return true }
            }
          }
        }
      }
      // A bare `m[k]` over a struct-valued map is `S | null`: the `vals` slot is
      // `(ref null $S)` and `emitMapGet` yields it unrecovered, a miss being `ref.null`. So
      // `const v = m[k]` binds the nullable-struct niche; a `?? d` read over a non-null value
      // stays the non-null struct, which the `BinExpr` arm settles.
      const mrs = mapReadMvSlot(exprIx, fnIx)
      if mrs >= 0 { return mvValKind[mrs] == MVK_STRUCT }
    }
    // A `m[k] ?? d` read over a nullable-struct-valued map stays `S | null` only when the
    // default is itself nullable; a non-null default coalesces every null, stored included,
    // to the non-null struct, which `exprStruct` claims.
    BinExpr => {
      const cns = coalesceMvSlot(exprIx, fnIx)
      if cns >= 0 {
        return mvValKind[cns] == MVK_STRUCT
          && coalesceStaysNullable(exprIx, cns, fnIx)
      }
      // The non-map `??` over the same niche obeys the identical rule — the consumer half of
      // the decision `emitCoalesce`'s nullable-struct arm makes. Without it an un-annotated
      // `const nv = p ?? q` binds a non-null struct cell and its `nv != null` lowers as struct
      // equality, while an annotated consumer takes the `(ref null $S)` cell.
      if e.binOp == "??" {
        // A join to a default of another type is the union box, never the operand's niche.
        if coalesceResultIsBox(exprIx) { return false }
        if exprNullableStruct(e.binLeft, fnIx) {
          return coalesceDefaultNullable(e.binRight, fnIx)
        }
      }
    }
    // No other expression is a nullable struct.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// The arena index of the expression an un-annotated function returns: the body's trailing
// tail-value statement, or the first valued `return`'s argument, walking into if, while and
// for bodies. -1 when the function yields nothing.
export function fnRetExprOf(fnIx: i32) {
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    if fn.fnBody < 0 { return -1 }
    const b = nodeAt(fn.fnBody)
    if b is Block {
      const stmts = b.blkStmts
      if stmts.length > 0 {
        const last = stmts[stmts.length - 1]
        if stmtIsTailValue(last, fnIx) { return last }
      }
    }
    return firstValuedReturn(fn.fnBody)
  }
  -1
}

// The map shape of a return expression, resolved from annotations only, so it is valid at
// the type-section emit before locals are collected and from a different function. -1, the
// mono map, for anything no rung claims. `fe` is the enclosing function's `fnStmts`
// position, not its arena index, which is what the capture arm below needs.
export function mapRetExprShape(rx: i32, fe: i32) {
  const fnIx = fnStmts[fe]
  let u = rx
  let done = false
  while !done {
    const node = nodeAt(u)
    if node is Paren { u = node.parInner } else { done = true }
  }
  const e = nodeAt(u)
  if e is Ident {
    // The `let` in scope at the read, which shadows a same-named parameter (D3295).
    let li = -1
    const fn = nodeAt(fnIx)
    if fn is FuncDecl { li = bodyLetOfRead(fn.fnBody, u) }
    if (li < 0 && paramMap(fnIx, u)) { return paramMapShape(fnIx, e.identName) }
    if li >= 0 {
      const d = nodeAt(li)
      if d is LetDecl {
        if d.letType >= 0 { return mapAnnShape(d.letType) }
      }
    }
  }
  if e is Call {
    if e.callFn < 0 { return -1 }
    const callee = nodeAt(e.callFn)
    if callee is Ident {
      // A bare `Map()` or `Set()`, and a call through a function-typed parameter or local
      // (D2867), name no declaration's map, so they take the recorded ladder at the bottom
      // rather than the string-keyed mono sentinel; `-1` and `-4` are two structs.
      const csid = sidOfNode(e.callFn)
      if (
        callee.identName != "Map"
        && callee.identName != "Set"
        && fnIndexOfNode(e.callFn) >= 0
      ) {
        return fnRetMapShapeAt(csid, u)
      }
    }
  }
  // A captured map return: the ident is neither a param nor a local of this function, so the
  // arms above miss it. Resolve its shape from the capture, the same `captureValStructIdx`
  // the env field uses, so the functype result heap type matches the field and the value.
  const cap = retCapturedMapShape(fe, rx)
  if cap != -3 { return cap }
  // Fallback: the map type the checker recorded on the returned expression. Every rung above
  // reads a spelling and an inferred map has none. The mint side reads this same recorded
  // type, so the slot found here is the one the type section interned, which keeps the
  // functype result valtype and the caller's receiver shape naming one struct.
  if nodeTyIsMap(u) { return mapFindShapeOfNodeTy(u) }
  -1
}

// The map shape of a return expression that is a captured map variable, as the mv slot
// (mono is -1), or -3 when the return is not a captured map. `captureNamesOf` is the source
// of truth, so a same-named local or param shadowing a capture stays with the local arms.
// The `parentBindingOf` pre-gate is the cheap half of the conjunction, taken first.
export function retCapturedMapShape(fe: i32, rx: i32): i32 {
  let u = rx
  let done = false
  while !done {
    const node = nodeAt(u)
    if node is Paren { u = node.parInner } else { done = true }
  }
  const e = nodeAt(u)
  if e is Ident {
    if fe >= 0 && parentBindingOf(fe, e.identName) >= 0 {
      const caps = captureNamesOf(fe)
      let ci = 0
      while ci < caps.length {
        if caps[ci] == e.identName {
          if captureValKind(fe, e.identName) == "map" {
            return captureValStructIdx(fe, e.identName)
          }
          return -3
        }
        ci = ci + 1
      }
    }
  }
  -3
}

// The predicate half of that pair, gated on the init being the union box: without the gate a
// bare variant-valued init would take this rung instead of `letIsVariant`'s, which reads the
// same row from the rep and owes no unbox.
export function letInitTyIsNarrowedArm(letIx: i32, fnIx: i32): boolean {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if letInitTyVariantRow(letIx, fnIx) < 0 { return false }
    return letInitIsBox(d.letInit, fnIx)
  }
  false
}

// The element kind of the walk variable a binding's initializer bare-reads, or null.
function letInitLoopElemKind(letIx: i32, fnIx: i32): VKind | null {
  if letIx < 0 { return null }
  const d = nodeAt(letIx)
  if d is LetDecl {
    const ix = unwrapParen(d.letInit)
    if ix < 0 { return null }
    const e = nodeAt(ix)
    if e is Ident { return readLoopElemKind(ix, fnIx) }
  }
  null
}

// Whether the un-annotated binding at `letIx` in frame `fnIx` bare-copies a frame `let` that
// holds the union box, `depth` copies down the chain: the box a classifier outside the frame's
// emission reads through the chain's declarations rather than the live locals (D3139).
function letInitCopiesBox(letIx: i32, fnIx: i32, depth: i32): boolean {
  if depth <= 0 || fnIx < 0 || letIx < 0 { return false }
  const d = nodeAt(letIx)
  if !(d is LetDecl) { return false }
  const ix = unwrapParen(d.letInit)
  if ix < 0 { return false }
  const e = nodeAt(ix)
  if !(e is Ident) { return false }
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return false }
  const src = bodyLetReadAtSid(fn.fnBody, sidOfNode(ix), ix)
  if src < 0 || src == letIx { return false }
  const sd = nodeAt(src)
  if !(sd is LetDecl) { return false }
  if sd.letType >= 0 { return letAnnIsUnion(src) }
  if exprUnion(sd.letInit, fnIx) && !exprIsLitAtom(sd.letInit, fnIx) {
    return true
  }
  if letInitLoopElemKind(src, fnIx) == "union" { return true }
  letInitCopiesBox(src, fnIx, depth - 1)
}

// The value-atom kind the identifier read at `ix` unboxes to, or -1 when it reads its cell as
// stored: the cell is a union box and the checker typed this read as one atom of it.
export function identReadAtomKindAt(ix: i32, fnIx: i32): i32 {
  if !uDeclared { return -1 }
  const rx = unwrapParen(ix)
  if rx < 0 || isStorageRead(rx) { return -1 }
  if identCellVKind(rx, fnIx) != "union" { return -1 }
  const pt = asgReReadPinAt(rx, fnIx)
  if pt >= 0 { readAtomAgreed(rx, pt, fnIx) } else { readTypeVerdict(rx, fnIx) }
}

// The atom type `t` is, when the instance's elaboration of `rx` names the same one, else -1: a
// pinned hole can make the read wider than the generic body's type.
function readAtomAgreed(rx: i32, t: i32, fnIx: i32): i32 {
  const k = readAtomKindOfTy(t)
  if k < 0 || k == 6 { return -1 }
  const et = elabNodeTyAt(rx, fnIx)
  if et >= 0 && readAtomKindOfTy(et) != k { return -1 }
  k
}

// The atom the checker typed the path read `ix` (a field, element or map value) as, or -1.
export function pathReadAtomKind(ix: i32, fnIx: i32): i32 {
  const rx = unwrapParen(ix)
  if rx < 0 || isStorageRead(rx) { return -1 }
  readAtomAgreed(rx, nodeTyAt(rx, fnIx), fnIx)
}

// True when every record arm of the receiver type `rt` declares field `prop` at atom `k`; a
// receiver that is not a union asks `tyFieldTyOf`, which declines every kind but a record.
function recvFieldReadsAs(rt: i32, prop: string, k: i32): boolean {
  if rt < 0 { return false }
  const p = tyPeelNul(rt)
  if p < 0 || p >= T.tys.length { return false }
  const r = tyAt(p)
  if r is TyUnion {
    let seen = false
    let i = 0
    while i < r.uMembers.length {
      const m = r.uMembers[i]
      if m >= 0 && tyAt(m) is TyObj {
        if !recvFieldReadsAs(m, prop, k) { return false }
        seen = true
      }
      i = i + 1
    }
    return seen
  }
  const ft = tyFieldTyOf(p, prop)
  ft >= 0 && readShapeKindOfTy(ft) == k
}

// The atom or container (`readContainerKindOfTy`) a slot declared at `ty` reads as; a nullable
// container counts as that container, since its read is the ref, not a box.
function readShapeKindOfTy(ty: i32): i32 {
  const a = readAtomKindOfTy(ty)
  if a >= 0 { return a }
  const c = readContainerKindOfTy(tyPeelNul(ty))
  if c > 0 { c } else { -1 }
}

// The container (`readContainerKindOfTy`) `t` is, when the instance's elaboration of `rx` names
// the same one, else 0.
function readContainerAgreed(rx: i32, t: i32, fnIx: i32): i32 {
  const k = readContainerKindOfTy(t)
  if k == 0 { return 0 }
  const et = elabNodeTyAt(rx, fnIx)
  if et >= 0 && readContainerKindOfTy(et) != k { return 0 }
  k
}

// The checked type the read `rx` has here: the value an assignment just stored when it re-reads
// its target, else its own.
function readTyHere(rx: i32, fnIx: i32): i32 {
  const pt = asgReReadPinAt(rx, fnIx)
  if pt >= 0 { pt } else { nodeTyAt(rx, fnIx) }
}

// The container the identifier read at `ix` unboxes to (`RC_REF_LIST` or `RC_MAP`), or 0 when
// it reads its cell as stored: the cell is a union box and the checker typed this read as a
// ref-element list or a map its binding's type is not.
export function identReadContainerAt(ix: i32, fnIx: i32): i32 {
  if !uDeclared { return 0 }
  const rx = unwrapParen(ix)
  if rx < 0 || isStorageRead(rx) { return 0 }
  const k = readContainerAgreed(rx, readTyHere(rx, fnIx), fnIx)
  if k == 0 { return 0 }
  if identCellVKind(rx, fnIx) != "union" { return 0 }
  const li = readBindingLetOf(rx, fnIx)
  if li >= 0 && readShapeKindOfTy(nodeTyAt(li, fnIx)) == k { return 0 }
  k
}

// The container a field, element or map-value read `ix` unboxes to, or 0: the checker typed
// it as a ref-element list or a map that the slot's declared type is not already.
export function placeReadContainerAt(ix: i32, fnIx: i32): i32 {
  const rx = unwrapParen(ix)
  if rx < 0 || isStorageRead(rx) { return 0 }
  const k = readContainerAgreed(rx, nodeTyAt(rx, fnIx), fnIx)
  if k == 0 { return 0 }
  const e = nodeAt(rx)
  if e is Member {
    if recvFieldReadsAs(nodeTyAt(e.memObj, fnIx), e.memProp, k) { return 0 }
    return k
  }
  indexReadContainerAt(rx, k, fnIx)
}

// `k` when `rx` is an element or map-value read whose slot is a union box (its declared element
// has no atom or container shape of its own), else 0 for every other read.
function indexReadContainerAt(rx: i32, k: i32, fnIx: i32): i32 {
  const e = nodeAt(rx)
  if !(e is Index) { return 0 }
  const rt = nodeTyAt(e.idxArr, fnIx)
  if rt < 0 { return 0 }
  const pt = tyPeelNul(rt)
  if pt < 0 || pt >= T.tys.length { return 0 }
  const r = tyAt(pt)
  let dt = -1
  if r is TyArray { dt = r.aElem }
  if r is TyMap { dt = r.mVal }
  if dt < 0 || readShapeKindOfTy(dt) >= 0 { return 0 }
  k
}

// The map shape (`mapShapeOfExpr`) of a read a container verdict answered `RC_MAP` for.
export function readMapArmShapeAt(ix: i32, fnIx: i32): i32 {
  const rx = unwrapParen(ix)
  mapArmShapeOfTy(mapTyPeel(readTyHere(rx, fnIx)))
}

// The atom a field read `o.f` is narrowed to below the field's declared type, or -1: a read
// typed as every receiver arm declares the field narrows nothing.
export function memNarrowAtomKind(memIx: i32, fnIx: i32): i32 {
  const m = nodeAt(unwrapParen(memIx))
  if m is Member {
    const k = pathReadAtomKind(memIx, fnIx)
    if k < 0 { return -1 }
    if recvFieldReadsAs(nodeTyAt(m.memObj, fnIx), m.memProp, k) { return -1 }
    return k
  }
  -1
}

// The atom an element or map-value read `a[i]` is narrowed to below the receiver's element
// or value type, or -1.
export function idxNarrowAtomKind(idxIx: i32, fnIx: i32): i32 {
  const e = nodeAt(unwrapParen(idxIx))
  if e is Index {
    const rt = nodeTyAt(e.idxArr, fnIx)
    if rt < 0 { return -1 }
    const r = tyAt(tyPeelNul(rt))
    let dt = -1
    if r is TyArray { dt = r.aElem }
    if r is TyMap { dt = r.mVal }
    if dt < 0 { return -1 }
    const k = pathReadAtomKind(idxIx, fnIx)
    if k < 0 || readAtomKindOfTy(dt) == k { return -1 }
    return k
  }
  -1
}

// The atom the read `rx` is typed as below its binding, from types alone, or -1: where the
// checker typed the read as its `let` is typed, no narrowing applies.
function readTypeVerdictGo(rx: i32, fnIx: i32): i32 {
  const k = readAtomAgreed(rx, nodeTyAt(rx, fnIx), fnIx)
  if k < 0 { return -1 }
  const li = readBindingLetOf(rx, fnIx)
  if li < 0 { return k }
  const rt = nodeTyIxOf(rx)
  if rt >= 0 && tySame(rt, nodeTyIxOf(li)) { return -1 }
  if readAtomKindOfTy(nodeTyAt(li, fnIx)) == k { return -1 }
  k
}

// `readTypeVerdictGo` remembered per resolver-bound, non-generic read, for the function asking
// and the raw types of the read and its declaration; every classifier rung asks it of one read.
const rtvGen = memoGenNew(0)
const rtvKey = memoKeyNew(4)
const rtvStamp: i32[] = []
const rtvFn: i32[] = []
const rtvRaw: i32[] = []
const rtvDeclRaw: i32[] = []
const rtvVal: i32[] = []
function readTypeVerdict(rx: i32, fnIx: i32): i32 {
  const di = identDeclOf(rx)
  if di < 0 { return readTypeVerdictGo(rx, fnIx) }
  let moved = memoMoved3(rtvKey, emitPassGen, tyMutEpoch, ekDecl.length)
  moved = memoMoved(
    rtvKey,
    3,
    if emitPhaseReached("arenaFinal") { 1 } else { 0 },
  )
    || moved
  if moved { memoGenAdvance(rtvGen) }
  const raw = nodeTyIxOf(rx)
  const draw = nodeTyIxOf(di)
  // A generic body's read answers per instance, which `fnIx` alone does not name.
  if raw < 0 || draw < 0 || tyHasTyVar(raw) || tyHasTyVar(draw) {
    return readTypeVerdictGo(rx, fnIx)
  }
  if rx < rtvStamp.length {
    if (
      rtvStamp[rx] == rtvGen.at
      && rtvFn[rx] == fnIx
      && rtvRaw[rx] == raw
      && rtvDeclRaw[rx] == draw
    ) {
      return rtvVal[rx]
    }
  }
  const v = readTypeVerdictGo(rx, fnIx)
  while rtvStamp.length <= rx {
    rtvStamp.push(-1)
    rtvFn.push(-1)
    rtvRaw.push(-1)
    rtvDeclRaw.push(-1)
    rtvVal.push(-1)
  }
  rtvStamp[rx] = rtvGen.at
  rtvFn[rx] = fnIx
  rtvRaw[rx] = raw
  rtvDeclRaw[rx] = draw
  rtvVal[rx] = v
  v
}

// The `let` the read `rx` denotes: the resolver's declaration when it bound one (-1 for a
// parameter), else the scope walk's answer for a read the resolver never saw (a clone).
function readBindingLetOf(rx: i32, fnIx: i32): i32 {
  const savedLocal = identLetIsModuleLocal
  const li = identLetOfRead(rx, fnIx)
  identLetIsModuleLocal = savedLocal
  li
}

// The type the target `rx` of the assignment whose value is being lowered re-reads at, the value
// just stored; -1 for any other read.
function asgReReadPinAt(rx: i32, fnIx: i32): i32 {
  if asgReReadIx < 0 { return -1 }
  const a = nodeAt(asgReReadIx)
  if !(a is BinExpr) { return -1 }
  if unwrapParen(a.binLeft) != rx { return -1 }
  asgReReadTy(asgReReadIx, fnIx)
}

// The assignment whose target `emitAsgValue` is re-reading for its value, or -1.
let asgReReadIx = -1

// Mark `asgIx` as the assignment whose target is being re-read; returns the mark to restore.
export function asgReReadEnter(asgIx: i32): i32 {
  const saved = asgReReadIx
  asgReReadIx = asgIx
  saved
}

export function asgReReadLeave(saved: i32) { asgReReadIx = saved }

// The type the re-read of assignment `asgIx`'s target yields where the cell is wider than the
// value: the member the checker typed the value at, or -1 when the cell's own type is the answer.
export function asgReReadTy(asgIx: i32, fnIx: i32): i32 {
  if asgReadNarrows(asgIx, fnIx) { return asgReadNarrowTy(asgIx, fnIx) }
  asgReadNullInnerTy(asgIx, fnIx)
}

// Whether an un-annotated binding's initializer `init` is the union box: `exprUnion`, or a
// read of a `for-in` variable over box elements, which has no declaration for a classifier
// run outside its frame's emission (a capture's env field) to read (D3135).
function letInitIsBox(init: i32, fnIx: i32): boolean {
  if exprUnion(init, fnIx) { return true }
  const ix = unwrapParen(init)
  if ix < 0 { return false }
  const e = nodeAt(ix)
  if e is Ident { return readIsLoopBox(ix, fnIx) }
  false
}

// Whether the read `ix` in frame `fnIx` (-1 the module) is a `for-in` variable over
// value-union-box elements.
function readIsLoopBox(ix: i32, fnIx: i32): boolean {
  readLoopElemKind(ix, fnIx) == "union"
}

// The element kind of the `for-in` loop whose variable the read `ix` in frame `fnIx`
// (-1 the module) is, or null.
function readLoopElemKind(ix: i32, fnIx: i32): VKind | null {
  const lp = readLoopNodeOf(ix, fnIx)
  if lp < 0 { return null }
  const ln = nodeAt(lp)
  if ln is ForIn { return forInElemKind(frameBlindIter(ln.fiIter, fnIx), fnIx) }
  null
}

// A value narrowed to `X | null` out of a wider box: the init is still the box, so the cell is
// the `nulvariant` niche and the binding boundary unboxes into it, nullably.
export function letInitTyIsNarrowedNulArm(letIx: i32, fnIx: i32): boolean {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if letInitTyNulArmRow(letIx, fnIx) < 0 { return false }
    return letInitIsBox(d.letInit, fnIx)
  }
  false
}

// Whether an un-annotated binding of a value narrowed out of a wider box takes the narrowed
// cell (the `K | null` atom niche, the arm, its nullable niche, or `string`), not the box.
function letInitBindsNarrowedCell(letIx: i32, fnIx: i32): boolean {
  if letInitTyIsNarrowedArm(letIx, fnIx) { return true }
  if letInitTyIsNarrowedNulArm(letIx, fnIx) { return true }
  if letInitTyIsNarrowedLit(letIx, fnIx) { return true }
  if letInitTyIsNarrowedNulStr(letIx, fnIx) { return true }
  if letIx < 0 { return false }
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType < 0 && d.letInit >= 0 {
      return letInitIsNulLitBox(d.letInit, fnIx)
    }
  }
  false
}

// A value narrowed to a literal union out of a wider box, as an un-annotated binding's
// initializer: the box holds the member as its string, which the narrowed read delivers, so
// the cell is `string`. Asked of the checker's type, so a capture agrees with the frame (D3120).
function letInitTyIsNarrowedLit(letIx: i32, fnIx: i32): boolean {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 || d.letInit < 0 { return false }
    if !tyIsLitUnion(nodeTyAt(d.letInit, fnIx)) { return false }
    return letInitIsBox(d.letInit, fnIx)
  }
  false
}

// The nullable-string twin: a value narrowed to `string | null` out of a wider box binds the
// niche the narrowed read delivers, asked of the checker's type for a capture's sake (D3161).
function letInitTyIsNarrowedNulStr(letIx: i32, fnIx: i32): boolean {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 || d.letInit < 0 { return false }
    if !nodeRepIs(d.letInit, "nulstr", fnIx) { return false }
    return letInitIsBox(d.letInit, fnIx)
  }
  false
}

// The scalar cell of an un-annotated binding whose initializer is narrowed to a number or a
// boolean out of a wider box, or null. The narrowed read unboxes, so the cell is the scalar;
// asked of the checker's type so a capture's env field agrees with the frame (D6771).
function letInitTyNarrowedScalarKind(letIx: i32, fnIx: i32): VKind | null {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 || d.letInit < 0 { return null }
    const ty = nodeTyInOf(d.letInit, fnIx)
    const pn = tyPrimNameOf(ty)
    if pn == null || pn == "string" || pn == "void" { return null }
    if !letInitIsBox(d.letInit, fnIx) { return null }
    const rd = repOfTy(ty)
    if rd.rdCovered == 1 { return rd.rdKind }
  }
  null
}

// The `fbValtype` kind an un-annotated binding's initializer decides when its checked type
// names no rep (`letBindRepClaims` declined), shared by `captureValKind` and `letCellKind`.
// `"i32"` when no arm claims it. A missing nullable arm types the env field at the non-null
// kind (D21).
function letInitCellKind(letIx: i32, fnIx: i32): VKind {
  // A never-filled `let x = null` is the `null` type, cell `nullref` (D1576). Without it the
  // env field is an i32 holding 0 and the lambda reads a present value out of it.
  if letIsNulNone(letIx, fnIx) { return "nulnone" }
  const nsk = letInitTyNarrowedScalarKind(letIx, fnIx)
  if nsk != null { return nsk }
  if (
    letIsF64Array(letIx, fnIx)
    && !letIsUnion(letIx, fnIx)
    && !letIsNulRefArray(letIx, fnIx)
  ) {
    return "f64list"
  }
  // A string list whose element type is a union the rep does not cover.
  if (
    letIsStringArray(letIx, fnIx)
    && !letIsUnion(letIx, fnIx)
    && !letIsNulRefArray(letIx, fnIx)
  ) {
    return "strlist"
  }
  if letIsRefArray(letIx, fnIx) && !letIsUnion(letIx, fnIx) { return "reflist" }
  if letIsUnion(letIx, fnIx) { return "union" }
  if letIsStruct(letIx, fnIx) {
    // Mirrored from `collectLocals`' own struct arm (D14441): where the struct table has no
    // row for the literal's field set and a union arm is the only claimant, the kind is
    // `"variant"`, since the kind selects the table `fbValtype` reads the slot from.
    if structIndexOfLet(letIx, fnIx) < 0 {
      if letObjLitVariantIdx(letIx, fnIx) >= 0 { return "variant" }
    }
    return "struct"
  }
  // A projection commits no rep the syntactic ladder reads, and the checker recorded the
  // type. An atom is `letInitIsLitAtom`'s to claim: a projection typed as a string literal
  // union that commits no atom is the string it reads (D5432).
  const projK = letInitProjKind(letIx)
  if projK != null && !(projK == "i32" && letInitProjTyIsAtom(letIx, fnIx)) {
    return projK
  }
  if letIsString(letIx, fnIx) { return "str" }
  if letIsF64(letIx, fnIx) { return "f64" }
  if letIsClosure(letIx, fnIx) { return "closure" }
  letInitHoleKind(letIx, fnIx)
}

// Whether the un-annotated binding at `letIx` has an initializer whose type reps as the atom.
function letInitProjTyIsAtom(letIx: i32, fnIx: i32): boolean {
  const d = nodeAt(letIx)
  if d is LetDecl { return d.letInit >= 0 && nodeRepIsAtom(d.letInit, fnIx) }
  false
}

// The type binding `letIx` holds inside `fnIx`: its annotation's, else its own.
export function letBindTy(letIx: i32, fnIx: i32): i32 {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      const at = nodeTyAt(d.letType, fnIx)
      if at >= 0 { return at }
    } else {
      const held = letHeldTyOf(letIx, d.letInit, fnIx)
      if held >= 0 { return held }
    }
  }
  scopeTyAt(letIx, fnIx)
}

// The record, union arm or list the un-annotated binding `letIx` of `init` is stored as where that
// is another type than its own, else -1. A scalar binding holds its own type, so the rungs, which
// build whole-program indices to answer, are not asked of one.
function letHeldTyOf(letIx: i32, init: i32, fnIx: i32): i32 {
  const own = nodeTyIxOf(letIx)
  if (
    own >= 0
    && own < T.tys.length
    && tyAt(own) is TyPrim
    && !tyIsNullUnit(own)
  ) {
    return -1
  }
  // The checker's record solve builds the binding at another record's storage.
  const rb = recBuildTyOf(letIx)
  if rb >= 0 { return rb }
  const held = letLitHeldTy(init, fnIx)
  if held >= 0 { return held }
  const called = letCallHeldTy(init)
  if called >= 0 { return called }
  const mread = letElemReadHeldTy(init)
  if mread >= 0 { return mread }
  letNamedHeldTy(letIx, init, fnIx)
}

// The record a read `xs[i]`, `m[k]` or `m.get(k)` of a container binding holds, nullable where the
// read is, where the checker builds its values at another record (`recBuildElemTyOf`); else -1.
function letElemReadHeldTy(init: i32): i32 {
  const u = unwrapParen(init)
  if u < 0 { return -1 }
  const n = nodeAt(u)
  let recv = -1
  if n is Index { recv = n.idxArr }
  if n is Call && n.callArgs.length == 1 && n.callFn >= 0 {
    const f = nodeAt(n.callFn)
    if f is Member && f.memProp == "get" { recv = f.memObj }
  }
  if recv < 0 || !(nodeAt(recv) is Ident) { return -1 }
  const et = recBuildElemTyOf(identDeclOf(recv))
  if et < 0 { return -1 }
  if tyAdmitsNull(nodeTyIxOf(u)) { mkNullableTy(et) } else { et }
}

// The type the binding `init` names holds, where it holds only a literal built at another type than
// the read's own, or where the read is narrowed to `null`; -1 for any other initializer.
function letNamedHeldTy(letIx: i32, init: i32, fnIx: i32): i32 {
  const u = unwrapParen(init)
  if u < 0 || !(nodeAt(u) is Ident) { return -1 }
  // A read narrowed to `null` still holds the named cell's nullable value.
  if tyIsNullUnit(nodeTyIxOf(u)) {
    const nd = identDeclOf(u)
    if nd < 0 || nd == letIx || !(nodeAt(nd) is LetDecl) { return -1 }
    const nt = letBindTy(nd, fnIx)
    if nt >= 0 && nt < T.tys.length && tyAt(nt) is TyNullable { return nt }
    return -1
  }
  // The resolved declaration answers the type first; whether it holds only its literal is the
  // costly question, asked last.
  const bd = identDeclOf(u)
  if bd < 0 || bd == letIx || !(nodeAt(bd) is LetDecl) { return -1 }
  const own = nodeTyIxOf(u)
  const t0 = letBindTy(bd, fnIx)
  if own < 0 || own >= T.tys.length || t0 < 0 || t0 >= T.tys.length {
    return -1
  }
  const ot = tyAt(own)
  // A read narrowed past `null` holds the named cell's non-null record.
  const t = if ot is TyObj && tyAt(t0) is TyNullable { tyPeelNul(t0) } else { t0 }
  if t < 0 || t >= T.tys.length { return -1 }
  const tt = tyAt(t)
  const same = (ot is TyObj && tt is TyObj) || (ot is TyArray && tt is TyArray)
  if !same || tySame(t, own) { return -1 }
  if recFreshDeclOf(u) != bd && t == t0 && !letHoldsCallBuilt(bd) { return -1 }
  t
}

// Whether binding `d` holds a call whose results are all built at another record than its type.
function letHoldsCallBuilt(d: i32): boolean {
  const n = nodeAt(d)
  n is LetDecl && n.letType < 0 && letCallHeldTy(n.letInit) >= 0
}

// The record the inferred-result function `init` calls builds every result at, where that is another
// record than the call's own type; -1 for any other initializer or where its literals disagree.
function letCallHeldTy(init: i32): i32 {
  const u = unwrapParen(init)
  if u < 0 || !(nodeAt(u) is Call) { return -1 }
  const own = nodeTyIxOf(u)
  if own < 0 || own >= T.tys.length || !(tyAt(own) is TyObj) { return -1 }
  const r = callBuiltTy(u, 8)
  if r < 0 || tySame(r, own) { return -1 }
  r
}

// The record every result of the inferred-result call `u` is built at, through results that are
// further such calls or a generic identity of one; -1 where a result is anything else or the
// results disagree.
function callBuiltTy(x: i32, depth: i32): i32 {
  if depth <= 0 { return -1 }
  const u = solePinPeel(x)
  const fd = if u >= 0 { recInferredFnOf(u) } else { -1 }
  if fd < 0 { return -1 }
  let r = -1
  for lf in recFnValueLeaves(fd) {
    const l = solePinPeel(lf)
    if l < 0 { return -1 }
    const s = if nodeAt(l) is ObjLit { litRepTyAt(l, -1) } else { callBuiltTy(l, depth - 1) }
    if s < 0 || s >= T.tys.length || !(tyAt(s) is TyObj) { return -1 }
    if r < 0 { r = s }
    else if !tySame(r, s) { return -1 }
  }
  r
}

// The value `x` delivers once each generic identity it passes through (`recSolePinArg`) is peeled.
function solePinPeel(x: i32): i32 {
  let l = unwrapParen(x)
  let hops = 0
  while l >= 0 && hops < 8 && recSolePinArg(l) >= 0 {
    l = unwrapParen(recSolePinArg(l))
    hops = hops + 1
  }
  l
}

// The closed type a record or list literal `init` is built at, which may be a declared record its
// fields fit or the list type its destinations agree on rather than its own type; -1 when `init`
// is not a record literal with fields or a list literal with elements.
function letLitHeldTy(init: i32, fnIx: i32): i32 {
  const u = unwrapParen(init)
  if u < 0 { return -1 }
  const o = nodeAt(u)
  const rec = o is ObjLit && o.objFields.length > 0
  const lst = o is ArrayLit && o.arrElems.length > 0
  if !rec && !lst { return -1 }
  const a = litRepTyAt(u, fnIx)
  if a < 0 || a >= T.tys.length || tyHasTyVar(a) { return -1 }
  const at = tyAt(a)
  if (rec && !(at is TyObj)) || (lst && !(at is TyArray)) { return -1 }
  a
}

// Whether binding `letIx` of type `ty` is a `Map()` keyed by a literal union, which the
// constructor builds string-keyed where the key type stores an atom (D14229).
function letMapCtorAtomKey(letIx: i32, ty: i32): boolean {
  const d = nodeAt(letIx)
  if !(d is LetDecl) || d.letInit < 0 { return false }
  const c = nodeAt(unwrapParen(d.letInit))
  if !(c is Call) || c.callArgs.length != 0 || c.callFn < 0 { return false }
  const f = nodeAt(c.callFn)
  if !(f is Ident) || f.identName != "Map" { return false }
  const t = tyAt(ty)
  t is TyMap && tyLitUnionHashesI32(t.mKey)
}

// Whether binding `letIx`'s cell is the rep of the type it holds: that type answers a rep,
// and the binding is not a never-filled `null`, a literal-union atom or its `K | null` niche,
// whose cells the binding's own spelling decides. A type holding a type variable, other than a
// function type, names no rep: the value's row is the one its initializer delivers.
export function letBindRepClaims(letIx: i32, fnIx: i32): boolean {
  const r = bindCellFill(letIx, fnIx)
  if r < 0 || r >= bcClaims.length { return false }
  bcClaims[r]
}

// The rep of binding `letIx`'s cell when `letBindRepClaims` holds, read off the type it holds.
export function letBindRep(letIx: i32, fnIx: i32): RepDesc {
  const r = bindCellFill(letIx, fnIx)
  if r < 0 || r >= bcRep.length { return repDescNone() }
  bcRep[r]
}

// Whether binding `letIx`'s cell is the literal-union atom, its `K | null` niche included.
export function letBindIsAtom(letIx: i32, fnIx: i32): boolean {
  const r = bindCellFill(letIx, fnIx)
  if r < 0 || r >= bcClaims.length { return false }
  bcClaims[r] && bcRep[r].rdAtom == 1
}

// Whether binding `letIx`'s cell is the `K | null` niche: the atom with `-1` for null.
export function letBindIsNulAtom(letIx: i32, fnIx: i32): boolean {
  const r = bindCellFill(letIx, fnIx)
  if r < 0 || r >= bcClaims.length || !bcClaims[r] { return false }
  bcRep[r].rdAtom == 1 && bcRep[r].rdNul == 3
}

// The table slot of binding `letIx`'s cell when `letBindRepClaims` holds, at its rep's kind.
export function letBindRepSlot(letIx: i32, fnIx: i32): i32 {
  const r = bindCellFill(letIx, fnIx)
  if r < 0 || r >= bcSlot.length { return -1 }
  if !bcSlotHave[r] {
    bcSlot[r] = repSlotOfKind(bcRep[r].rdKind, bcTy[r])
    bcSlotHave[r] = true
  }
  bcSlot[r]
}

// ── the binding storage column (D14434) ──────────────────────────────────────
// One row per (binding, instance) asked about: whether its rep claims the cell, that rep, and
// its row slot. `bcHead[letIx]` is the binding's first row and `bcNext` the next instance's. A
// row is current while it holds the `globalCellKind` walk generation.
let bcHead: i32[] = []
let bcNext: i32[] = []
let bcStamp: i32[] = []
let bcFn: i32[] = []
let bcClaims: boolean[] = []
let bcRep: RepDesc[] = []
let bcTy: i32[] = []
let bcSlot: i32[] = []
let bcSlotHave: boolean[] = []
let bcDepth = 0
let bcGenSeen = 0

// Empties the column; `classifyStateReset` runs it at compile start, with `bcDepth`.
function bindCellReset() {
  bcHead = []
  bcNext = []
  bcStamp = []
  bcFn = []
  bcClaims = []
  bcRep = []
  bcTy = []
  bcSlot = []
  bcSlotHave = []
  bcGenSeen = 0
}

// Fill binding `letIx`'s column row for instance `fnIx` and return the row; -1 when `letIx` is
// not a node.
function bindCellFill(letIx: i32, fnIx: i32): i32 {
  if letIx < 0 || letIx >= P.nodes.length { return -1 }
  if bcDepth == 0 {
    if gckStale() { gckDrop() }
  }
  // A generation that restarted could alias an old stamp, so the column restarts with it.
  if gckGen < bcGenSeen { bindCellReset() }
  bcGenSeen = gckGen
  const had = bindCellRow(letIx, fnIx)
  if had >= 0 && bcStamp[had] == gckGen { return had }
  const gen = gckGen
  bcDepth = bcDepth + 1
  const c = bindCellGo(letIx, fnIx)
  bcDepth = bcDepth - 1
  // The walk may have reset the column, so the row is looked up again.
  let r = bindCellRow(letIx, fnIx)
  if r < 0 {
    while bcHead.length <= letIx { bcHead.push(-1) }
    r = bcStamp.length
    bcNext.push(bcHead[letIx])
    bcHead[letIx] = r
    bcStamp.push(0)
    bcFn.push(-2)
    bcClaims.push(false)
    bcRep.push(c.bgRep)
    bcTy.push(-1)
    bcSlot.push(-1)
    bcSlotHave.push(false)
  }
  // A walk that minted rows moved the generation; its answer is served once and not kept.
  bcStamp[r] = if gckGen == gen { gen } else { 0 }
  bcFn[r] = fnIx
  bcClaims[r] = c.bgClaims
  bcRep[r] = c.bgRep
  bcTy[r] = c.bgTy
  bcSlot[r] = c.bgSlot
  bcSlotHave[r] = c.bgSlotHave
  r
}

// Binding `letIx`'s column row for instance `fnIx`, current or not; -1 when it has none.
function bindCellRow(letIx: i32, fnIx: i32): i32 {
  if letIx >= bcHead.length { return -1 }
  let r = bcHead[letIx]
  while r >= 0 && bcFn[r] != fnIx { r = bcNext[r] }
  r
}

// One binding's storage answer as `bindCellGo` reads it.
type BindCellGo = {
  bgClaims: boolean,
  bgRep: RepDesc,
  bgTy: i32,
  bgSlot: i32,
  bgSlotHave: boolean,
}

// Binding `letIx`'s storage answer: whether its cell is its rep's, and the rep, type and slot it
// read. They are read only once the binding's own spelling has not decided the cell, since
// reading a slot can mint a row; a refusal before then carries none.
function bindCellGo(letIx: i32, fnIx: i32): BindCellGo {
  const no: BindCellGo = {
    bgClaims: false,
    bgRep: repDescNone(),
    bgTy: -1,
    bgSlot: -1,
    bgSlotHave: false,
  }
  if loopVarLoop(letIx) >= 0 { return loopVarCellGo(letIx, fnIx) }
  if letIsNulNone(letIx, fnIx) { return no }
  // A literal-union binding is the i32 atom, whatever rep its held type reads as: annotated
  // `: K`, off an atom initialiser, or the `K | null` niche with `-1` for null.
  const atom = letAnnIsAtom(letIx, fnIx) || letInitIsLitAtom(letIx, fnIx)
  if atom || letSpellsNulAtom(letIx, fnIx) {
    const aty = letBindTy(letIx, fnIx)
    const niche = !atom || (aty >= 0 && tyIsNulLitUnionNiche(aty))
    return {
      bgClaims: true,
      bgRep: repAtomMk(if niche { 3 } else { 0 }),
      bgTy: aty,
      bgSlot: -1,
      bgSlotHave: true,
    }
  }
  const ty = letBindTy(letIx, fnIx)
  if ty < 0 { return no }
  // A function value's cell is the closure rep whatever its type variables bind to; a list or
  // record of one is not, since its row names the signature.
  if tyHasTyVar(ty) {
    const t0 = tyAt(ty)
    const inner = if t0 is TyNullable { t0.nInner } else { ty }
    if !tyIsFuncArena(inner) && !fnTagListTy(inner) { return no }
  }
  // A parameter the D4551 default bound is a guess at the value, not its type.
  if fnIx >= 0 && elabKeyReadsDefault(elabKeyAt(fnIx), letBindTy(letIx, -1)) {
    return no
  }
  if letMapCtorAtomKey(letIx, ty) { return no }
  const rd = repOfNodeAt(letIx, ty)
  // A row kind whose type has no row names no cell.
  const k = rd.rdKind
  const rowed = (k == "struct"
    || k == "nulstruct"
    || k == "variant"
    || k == "nulvariant"
    || k == "reflist"
    || k == "nulreflist")
  if rd.rdCovered != 1 || !rowed {
    return {
      bgClaims: rd.rdCovered == 1,
      bgRep: rd,
      bgTy: ty,
      bgSlot: -1,
      bgSlotHave: false,
    }
  }
  const slot = repSlotOfKind(k, ty)
  { bgClaims: slot >= 0, bgRep: rd, bgTy: ty, bgSlot: slot, bgSlotHave: true }
}

// Loop variable `d`'s storage answer in frame `fnIx`, off the loop of that frame declaring it:
// the i32 atom, or its `K | null` niche, when the walk yields one; else no claim.
function loopVarCellGo(d: i32, fnIx: i32): BindCellGo {
  let body = emitRootIx
  if fnIx >= 0 {
    const fn = nodeAt(fnIx)
    if fn is FuncDecl { body = fn.fnBody }
  }
  let lp = parentLoopOfDecl(body, sidOfNode(d), d)
  if lp < 0 { lp = loopVarLoop(d) }
  let atom = false
  let nul = false
  const l = nodeAt(lp)
  if l is ForIn {
    const it = frameBlindIter(l.fiIter, fnIx)
    if l.fiDecl2 == d {
      atom = forInPairVarIsLitAtom(it, fnIx)
      nul = atom && nodeTyMapValIsNulLitUnion(it)
    } else {
      atom = forInVarIsLitAtom(it, fnIx, forInElemKind(it, fnIx))
      nul = atom
        && (nodeArrayElemIsNulLitUnion(it)
        || tyIsNulLitUnionNiche(iterElemPinTy(it, fnIx)))
    }
  }
  {
    bgClaims: atom,
    bgRep: if atom { repAtomMk(if nul { 3 } else { 0 }) } else { repDescNone() },
    bgTy: -1,
    bgSlot: -1,
    bgSlotHave: true,
  }
}

// The table slot beside binding `stmtIx`'s cell kind `k`: its rep's slot where the rep claims
// the cell, else the map shape, nullable-variant row, list row, struct row or variant row its
// initializer delivers; any other kind reads its slot off the type the binding holds.
export function letCellSlot(stmtIx: i32, fnIx: i32, k: VKind): i32 {
  // A map's shape and a list's row are what its stores and initializer deliver, which its
  // type's rep cannot see.
  if k == "map" { return letMapShapeOf(stmtIx, fnIx) }
  if k == "nulmap" { return nulMapShapeOf(stmtIx, fnIx) }
  if k == "reflist" { return letRefListSlot(stmtIx, fnIx) }
  if letBindRepClaims(stmtIx, fnIx) { return letBindRepSlot(stmtIx, fnIx) }
  match k {
    "nulvariant" => nulVariantIdxOfLet(stmtIx, fnIx)
    "struct" => structIndexOfLet(stmtIx, fnIx)
    "variant" => letObjLitVariantIdx(stmtIx, fnIx)
    _ => repSlotOfKind(k, letBindTy(stmtIx, fnIx))
  }
}

// The `fbValtype` kind of the cell a `LetDecl` binds inside function `fnIx` — the
// annotation's kind through the shared annotation ladder, else the initializer's. The local
// storage class's answer to what `globalCellKind` answers for a module global, kept here
// because `emit_collect.vl` cannot be imported back into this file.
export function letCellKind(letIx: i32, fnIx: i32): VKind {
  if letBindRepClaims(letIx, fnIx) { return letBindRep(letIx, fnIx).rdKind }
  // A map whose type names no rep, in `letLocalSlot`'s order (D14229).
  if letIsMap(letIx, fnIx) { return "map" }
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 { return vtKindOfType(d.letType) }
    if d.letInit >= 0 { return letInitCellKind(letIx, fnIx) }
  }
  "i32"
}

// The map shape beside an inferred `map` or `nulmap` result valtype: the return expression's,
// else the checker's return type's for a tail `fnRetExprOf` does not reach (a tail `if`, D30).
export function inferredRetMapSlot(ti: i32) {
  retMapFlight.push(ti)
  const sh = inferredRetMapSlotCore(ti)
  retMapFlight.pop()
  sh
}

function inferredRetMapSlotCore(ti: i32) {
  if ti < 0 { return -1 }
  const mrx = fnRetExprOf(fnStmts[ti])
  if mrx >= 0 { return mapRetExprShape(mrx, ti) }
  const crt = fnCheckedRetTy(ti)
  if crt >= 0 {
    const csh = mapShapeOfTyPeeled(crt)
    if csh != -3 { return csh }
  }
  -1
}

// The member type the value of assignment `asgIx` reads back at when its target is a name
// whose cell is a value-union box and the checker typed the value at one member of it, or
// -1. The re-read is then lowered under that member's narrowing, so the value has the rep
// its type names rather than the box's (D2391). A literal-union member keeps the box path.
export function asgReadNarrowTy(asgIx: i32, fnIx: i32): i32 {
  if asgIx < 0 { return -1 }
  const a = nodeAt(asgIx)
  if !(a is BinExpr) { return -1 }
  if a.binOp != "=" { return -1 }
  if !uDeclared { return -1 }
  const t = unwrapParen(a.binLeft)
  if t < 0 { return -1 }
  if !(nodeAt(t) is Ident) { return -1 }
  const at = nodeTyIxOf(asgIx)
  const rt = nodeTyIxOf(a.binRight)
  if at < 0 || rt < 0 { return -1 }
  if !tySame(at, rt) { return -1 }
  if tyIsLitUnion(at) { return -1 }
  // `null` has no rep apart from the box's null tag.
  if tyPrimNameOf(at) == "null" { return -1 }
  const un = unionNameOfRead(t, fnIx)
  if un == "" { return -1 }
  if !isValueUnionName(un) { return -1 }
  if (
    msSoleMemberTy(asgReadNarrowSet(identUnionTyAt(sidOfNode(t), fnIx, t), at))
    < 0
  ) {
    return -1
  }
  at
}

// The node whose rep the value of assignment `asgIx` has at a consumer: its target, which
// the lowering re-reads, or its right side when that re-read is narrowed to the member the
// right side has (`asgReadNarrows`).
export function asgReadNode(asgIx: i32, fnIx: i32): i32 {
  if asgLitWidth(asgIx, fnIx) != "" { return asgIx }
  const a = nodeAt(asgIx)
  if a is BinExpr {
    if asgYieldsNullLit(asgIx) { return a.binRight }
    if asgReadNarrows(asgIx, fnIx) { return a.binRight }
    if asgReadUnwidenOp(asgIx, fnIx) >= 0 { return a.binRight }
    return a.binLeft
  }
  asgIx
}

// True if assignment `asgIx` writes the `null` literal and the checker typed its value `null`:
// the value is that literal, not a re-read of the wider cell.
export function asgYieldsNullLit(asgIx: i32): boolean {
  if asgIx < 0 || asgIx >= P.nodes.length { return false }
  const a = nodeAt(asgIx)
  if !(a is BinExpr) { return false }
  if a.binOp != "=" || a.binCompound != "" { return false }
  const r = unwrapParen(a.binRight)
  if r < 0 || !(nodeAt(r) is NullLit) { return false }
  tyPrimNameOf(nodeTyIxOf(asgIx)) == "null"
}

// The width of the checker's type of assignment `asgIx` when its value is its right side's
// number literal rather than a re-read of the cell: a name or closure-cell target that is not
// the function's result cell, at a numeric type. The value is that literal, built where it is
// read; else "".
export function asgLitWidth(asgIx: i32, fnIx: i32): string {
  if asgIx < 0 || asgIx >= P.nodes.length { return "" }
  const a = nodeAt(asgIx)
  if !(a is BinExpr) { return "" }
  if a.binOp != "=" || a.binCompound != "" { return "" }
  if cexLitPeel(a.binRight) < 0 { return "" }
  const lhs = unwrapParen(a.binLeft)
  if lhs < 0 || lhs >= P.nodes.length { return "" }
  if !(nodeAt(lhs) is Ident) && (cboxStoreCells[lhs] ?? 0) != 1 { return "" }
  numLitTyWidth(asgIx, fnIx)
}

// The opcode taking the re-read of a widening assignment's target cell back to its right
// side's rep — a scalar narrowed back, or a nullable ref recovered — or -1 where the reps
// agree. Each widening it inverts is injective; a tail returning the cell keeps it (D2512).
export function asgReadUnwidenOp(asgIx: i32, fnIx: i32): i32 {
  const vt = nodeTyIxOf(asgIx)
  const st = asgStoreTyOf(asgIx)
  if vt < 0 || st < 0 { return -1 }
  const stT = tyAt(st)
  if stT is TyNullable {
    // A scalar widened into a nullable box is re-read under its inner member's narrowing.
    const inner = asgReadNullInnerTy(asgIx, fnIx)
    if inner >= 0 { return asgUnwidenPrim(vt, inner) }
    // A ref written into its own nullable niche: the cell is `(ref null T)`, the value `(ref T)`.
    if stT.nInner < 0 || !tySame(stT.nInner, vt) { return -1 }
    const vT = tyAt(vt)
    if vT is TyObj || vT is TyArray || vT is TyMap || vT is TyFunc {
      return 212 // 0xd4 ref.as_non_null
    }
    return -1
  }
  asgUnwidenPrim(vt, st)
}

// The member a nullable scalar cell of assignment `asgIx` is re-read at so that an unwidening
// opcode can take it back to the right side's primitive rep, or -1. The checker admits only
// widenings it can invert exactly, so the round trip is the right side's value.
export function asgReadNullInnerTy(asgIx: i32, fnIx: i32): i32 {
  if asgIx < 0 || asgIx >= P.nodes.length { return -1 }
  const vt = nodeTyIxOf(asgIx)
  const st = asgStoreTyOf(asgIx)
  if vt < 0 || st < 0 { return -1 }
  const stT = tyAt(st)
  if !(stT is TyNullable) { return -1 }
  const inner = stT.nInner
  if inner < 0 || tySame(inner, vt) { return -1 }
  if tyPrimNameOf(inner) == null { return -1 }
  if asgUnwidenPrim(vt, inner) < 0 { return -1 }
  const a = nodeAt(asgIx)
  if !(a is BinExpr) { return -1 }
  const t = unwrapParen(a.binLeft)
  if t < 0 { return -1 }
  if !(nodeAt(t) is Ident) { return -1 }
  const un = unionNameOfRead(t, fnIx)
  if un == "" { return -1 }
  if (
    msSoleMemberTy(
      asgReadNarrowSet(identUnionTyAt(sidOfNode(t), fnIx, t), inner),
    )
    < 0
  ) {
    return -1
  }
  inner
}

// True if the re-read of assignment `asgIx`'s target is lowered narrowed: the value has one
// member's type (`asgReadNarrowTy`) and is not a tail whose function returns the cell.
export function asgReadNarrows(asgIx: i32, fnIx: i32): boolean {
  asgReadNarrowTy(asgIx, fnIx) >= 0
}

// Look up the wasm function index for `name`, or -1 if no such top-level function
// exists (an undefined callee — the caller fails loudly).
export function fnIndexOf(name: string) { fnIndexOfSid(sidLookup(name), -1) }

// The sid-taking primitive. While a body is lowered, a name some nested function carries
// resolves through that body's scope chain, since the flat map is first-wins. A sibling
// frame's nested function under the name of one of this body's params, or of the local the
// read at `atIx` (-1: none) denotes, is not that binding: answers -1 (D1966).
export function fnIndexOfSid(sid: i32, atIx: i32) {
  if emitCurFnIx >= 0 && sidArrGet(nestedNameBySid, sid) == 1 {
    const name = sidText(sid)
    const fe = fnIndexOfInScopeSid(sid, name, emitCurFnIx)
    if fe >= 0 && fe < fnParent.length && fnParent[fe] >= 0 {
      if (
        !fnPosOnScopeChain(fnParent[fe], emitCurFnPos)
        && ((atIx >= 0
          && sidOfNode(atIx) == sid
          && localIndexOf(emitCurFnIx, atIx) >= 0)
          || paramIndexOf(emitCurFnIx, name) >= 0)
      ) {
        return -1
      }
    }
    return fe
  }
  sidArrGet(fnIndexBySid, sid)
}

// `fnIndexOfSid` asked of the identifier at node `ix`, positioned as `fnIndexOfInScopeChainAt`.
export function fnIndexOfNode(ix: i32): i32 {
  fnIndexOfAt(sidOfNode(ix), emitCurFnIx, ix)
}

// `fnIndexOfSid` asked of a read of `sid` at node `atIx` in frame `fnIx` (-1 for none known).
export function fnIndexOfAt(sid: i32, fnIx: i32, atIx: i32): i32 {
  if sidArrGet(nestedNameBySid, sid) == 1 {
    const hit = lfResolveAt(sid, sidText(sid), fnIx, atIx)
    if hit >= 0 { return hit }
    if hit == -1 { return lfFlatAt(sid) }
  }
  fnIndexOfSid(sid, atIx)
}

// The same rep, reached by NAME: the one home for the walk (#2815's calling frame, #2840's
// origin hop). `rdCovered` 0 means the name resolves to no lifted function, and `rdNul` is
// unanswered throughout, since these columns carry no null discipline.
// `atIx` is the callee identifier's node, or -1 (`fnIndexOfInScopeAt`).
export function repOfNameResult(
  sid: i32,
  name: string,
  fnIx: i32,
  atIx: i32,
): RepDesc {
  const i = fnIndexOfInScopeAt(sid, name, fnIx, atIx)
  if repShadowOn { repABNoteNameResult(sid, i) }
  repOfFnSlot(i)
}

// The oracle at this surface compares the FLAT map's answer against the frame-aware walk's:
// a disagreement is one site where a per-pin clone would have adopted its template's rep,
// which is the whole D1788 family in one measurement.
function repABNoteNameResult(sid: i32, scoped: i32) {
  const flat = fnIndexOfSid(sid, -1)
  if flat == scoped { return 0 }
  repABNote("nameResult", repABRetWord(flat), repABRetWord(scoped))
}

// ── capture analysis (closures) ───────────────────────────────────────────────
// The `fnStmts` position of the lifted function whose capture list is being computed, so
// `capRecord` can ask whether an enclosing frame binds a name without threading it through
// `capScan`'s recursion. Sound because `capComputeNamesOf` is the only entry point.
let capFrame: i32 = -1
// Set by `capScan`'s `Ident` arm for the one `capRecord` it makes: the identifier is read as a
// value rather than named as a call's callee (`capCalleeIx`), so a function it names needs a cell.
let capValueRead = false
let capCalleeIx: i32 = -1
// Set when the frame being computed reads itself as a value; `capComputeNamesOf` answers it.
let capSelfCell = false

// The capture name standing for the cell of function `fe`, which no source identifier can spell.
export function capCellName(fe: i32): string { "#cell:" + i32ToStr(fe) }

// The function whose cell capture `name` is, or -1 when `name` is an ordinary capture.
export function capCellTargetOf(name: string): i32 {
  if name.length < 7 || name.slice(0, 6) != "#cell:" { return -1 }
  let v = 0
  let i = 6
  while i < name.length {
    const c = name[i]
    if c < '0' || c > '9' { return -1 }
    v = v * 10 + (c - '0')
    i = i + 1
  }
  v
}

// Whether a value read of function `fe` from another frame goes through `fe`'s cell: a nested
// function declared by statement, since a lambda's every evaluation is a new value.
function capCellEligible(fe: i32): boolean {
  if fe < 0 || fe >= fnParent.length || fe >= fnStmts.length { return false }
  fnParent[fe] >= 0 && !criFnIsAnonLambda(fe)
}

// The captured-variable names of the lifted function at `fnStmts[fe]`, in encounter order,
// which is env-field order, by direct walk. A capture is a free variable: read in the body,
// and not a param, a body `let`, a module global or a lifted function name — the last two
// unless an enclosing frame binds it (`capRecord`). Callers go through `captureNamesOf`.
export function capComputeNamesOf(fe: i32) {
  const caps: string[] = []
  if fe < 0 || fe >= fnStmts.length { return caps }
  capFrame = fe
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    const bound: {[string]: i32} = Map()
    const params = fn.fnParams
    let pi = 0
    while pi < params.length {
      const p = nodeAt(params[pi])
      if p is Param { bound[p.parName] = 1 }
      pi = pi + 1
    }
    const savedSelf = capSelfCell
    capSelfCell = false
    capCalleeIx = -1
    nfdWalkEnter()
    capScan(fn.fnBody, bound, caps)
    nfdWalkLeave()
    // A function that reads itself as a value takes its own cell, but only when it captures
    // something else: with nothing captured its one constant closure is already one value.
    const self = capCellName(fe)
    if capSelfCell && caps.length > 0 && !strListHas(caps, self) {
      caps.push(self)
    }
    capSelfCell = savedSelf
  }
  caps
}

// The captured-variable names of the lifted function at `fnStmts[fe]` — from the capture
// cache when it is valid (the emission phases), else from the pass memo, else by direct walk
// (the rewrite and monomorphize phases, which still mutate bodies). A fresh small array
// either way, since a `string[][]` cache row is not self-host-emittable.
export function captureNamesOf(fe: i32) {
  if !fnNestUsed {
    const none: string[] = []
    return none
  }
  if emitPhaseReached("capsCached") && fe >= 0 && fe < capStartTbl.length {
    const caps: string[] = []
    const start = capStartTbl[fe]
    const cnt = capCountTbl[fe]
    let ci = 0
    while ci < cnt {
      caps.push(capNamesFlat[start + ci])
      ci = ci + 1
    }
    return caps
  }
  if capMemoUsable(fe) { return capMemoNamesOf(fe) }
  capComputeNamesOf(fe)
}

// The number of captured variables of the lifted function at `fnStmts[fe]` —
// O(1) from the cache when valid, else the memo's or the direct walk's length.
export function captureCountOf(fe: i32) {
  if emitPhaseReached("capsCached") && fe >= 0 && fe < capCountTbl.length {
    return capCountTbl[fe]
  }
  const caps = captureNamesOf(fe)
  caps.length
}

// The pass memo: `captureNamesOf`'s walk kept within one armed pass, laid out as the capture
// cache is. The memo is dropped when the pass ends, when a node is minted, or when the pass
// reports an edit that mints nothing, so no answer outlives the tree it describes (D2017).
// `capMemoStamp[fe]` is 1 where the memo holds `fe`'s answer, -1 where it does not.
let capMemoStamp: i32[] = []
let capMemoStart: i32[] = []
let capMemoCount: i32[] = []
let capMemoFlat: string[] = []

// `capComputeNamesOf(fe)` through the pass memo; the caller has checked `capMemoUsable`.
function capMemoNamesOf(fe: i32): string[] {
  let moved = memoPassMoved(capMemoGenKey, 0)
  moved = memoMoved(capMemoGenKey, 1, P.nodes.length) || moved
  moved = memoMoved(capMemoGenKey, 2, capMemoEdits) || moved
  moved = memoMoved(capMemoGenKey, 3, arenaEpochNow()) || moved
  moved = memoMoved(capMemoGenKey, 4, arenaRefWritesNow()) || moved
  moved = memoMoved(capMemoGenKey, 5, fnStmts.length) || moved
  if moved {
    capMemoStamp = []
    capMemoStart = []
    capMemoCount = []
    capMemoFlat = []
  }
  if fe < 0 { return capComputeNamesOf(fe) }
  while capMemoStamp.length <= fe {
    capMemoStamp.push(0 - 1)
    capMemoStart.push(0)
    capMemoCount.push(0)
  }
  if capMemoStamp[fe] == 1 {
    // A hit leaves `capFrame` where the walk it stands for would have left it.
    capFrame = fe
    const hit: string[] = []
    const start = capMemoStart[fe]
    let ci = 0
    while ci < capMemoCount[fe] {
      hit.push(capMemoFlat[start + ci])
      ci = ci + 1
    }
    return hit
  }
  const caps = capComputeNamesOf(fe)
  capMemoStamp[fe] = 1
  capMemoStart[fe] = capMemoFlat.length
  capMemoCount[fe] = caps.length
  let ci = 0
  while ci < caps.length {
    capMemoFlat.push(caps[ci])
    ci = ci + 1
  }
  caps
}

// A module global and a lifted function name are addressable directly from inside a lifted
// function, so neither is a capture — unless an enclosing frame binds the same name, when
// the identifier denotes that binding and dropping it leaves the body reading `global.get`.
// It deliberately binds the local: a closure written before a shadowing `let` captures it.
function capRecord(
  name: string,
  bound: {[string]: i32},
  caps: string[],
  atIx: i32,
) {
  const valueRead = capValueRead
  capValueRead = false
  // A cell rides every env between its function's declaring frame, which owns it, and a reader.
  // A nested body is scanned inline, so the owner is also the scope binding the function's name.
  const cellOf = capCellTargetOf(name)
  if cellOf >= 0 {
    if cellOf < fnParent.length && fnParent[cellOf] == capFrame { return 0 }
    if cellOf < fnStmts.length {
      const decl = nodeAt(fnStmts[cellOf])
      if decl is FuncDecl {
        if capIsBound(bound, decl.fnName) { return 0 }
      }
    }
    if !strListHas(caps, name) { caps.push(name) }
    return 0
  }
  if capIsBound(bound, name) { return 0 }
  // An extern is a module-level import, addressable from any frame like a function; only a
  // program that reads one as a value can meet it here (D2618).
  if (
    globalIndexOf(name) >= 0
    || fnIndexOfAt(sidOf(name), -1, atIx) >= 0
    || (externValueSeen() && externLinkOf(name) >= 0)
  ) {
    if parentBindingFrameAt(capFrame, name, atIx) < 0 {
      // The module scope is the one enclosing scope the frame walk cannot reach, and it has
      // a binding form that is not a global: a top-level `for` variable. Without it a closure
      // in a top-level loop body addresses the module function instead of the loop variable.
      if moduleLoopEnclosing(capFrame, name) < 0 {
        const sib = capSiblingFe(name, atIx)
        const nsub = capSiblingFold(sib, bound, caps)
        if valueRead { capCellNote(sib, nsub, caps) }
        return 0
      }
    }
  }
  // The builtin-name exemption is positional and lives in `capScan`'s `Call` arm, not here:
  // a builtin name denotes instructions where it is called and nowhere else, so filtering it
  // at every identifier would suppress a genuine capture of a local sharing the name.
  if strListHas(caps, name) { return 0 }
  caps.push(name)
  0
}

// The nested function `name` denotes at `atIx` from the frame being computed, or -1.
function capSiblingFe(name: string, atIx: i32): i32 {
  if capFrame < 0 || capFrame >= fnStmts.length { return -1 }
  // The same outward walk `fnIndexOfInScopeSid` takes, and for the same reason: only a
  // NESTED function is found, so a module-level callee resolves to -1 and folds in nothing.
  let pp = capFrame
  let fe = 0 - 1
  let steps = 0
  while pp >= 0 && steps <= fnStmts.length {
    const hit = nestedFnDeclaredIn(name, pp)
    if hit >= 0 {
      fe = hit
      pp = 0 - 1
    } else {
      if pp < fnParent.length { pp = fnParent[pp] } else { pp = 0 - 1 }
    }
    steps = steps + 1
  }
  // A placed read takes the block-local scopes' answer instead, so a function declared later
  // or in a closed block is not it (D3608); a per-pin clone stands in, as in `lfResolveAt`.
  // A later instance's minted name has no lexical row, so the frame chain's answer stands (D3827).
  const lf = lfFnAt(sidOf(name), atIx)
  const inst = fe >= 0 && fe < fnInstOrigin.length && fnInstOrigin[fe] >= 0
  if (
    lf != LF_UNPLACED
    && !(lf >= 0 && fe >= 0 && lfBlockOf(fe) < 0)
    && !(lf < 0 && inst)
  ) {
    fe = 0 - 1
    if lf >= 0 && lf < fnParent.length && fnParent[lf] >= 0 { fe = lf }
    if lf >= 0 {
      const lc = lfCloneOnChain(lf, capFrame)
      if lc >= 0 { fe = lc }
    }
  }
  fe
}

// A SIBLING's free names are the caller's captures too: `j` calling `k` builds `k`'s env
// inside `j`, so every name `k` needs from an outer frame rides `j`'s env (D1761). Returns how
// many `fe` has, or -1 when `fe` is none, the frame itself, or a sibling already being walked.
function capSiblingFold(fe: i32, bound: {[string]: i32}, caps: string[]): i32 {
  if fe < 0 || fe == capFrame { return -1 }
  let si = 0
  while si < capSibStack.length {
    if capSibStack[si] == fe { return -1 }
    si = si + 1
  }
  capSibStack.push(fe)
  const savedFrame = capFrame
  const sub = capComputeNamesOf(fe)
  capFrame = savedFrame
  capSibStack.pop()
  let ci = 0
  while ci < sub.length {
    capRecord(sub[ci], bound, caps, -1)
    ci = ci + 1
  }
  sub.length
}

// A value read of nested function `fe` outside its declaring frame takes `fe`'s cell, so the
// read reaches the env that frame keeps. `nsub` is `fe`'s capture count from the fold; with
// none, `fe` is one constant closure and needs no cell. A read in the frame itself asks
// `capComputeNamesOf`, which alone knows the frame's own count once its walk ends.
function capCellNote(fe: i32, nsub: i32, caps: string[]) {
  if !capCellEligible(fe) || fnParent[fe] == capFrame { return 0 }
  if fe == capFrame {
    capSelfCell = true
    return 0
  }
  if nsub <= 0 { return 0 }
  const name = capCellName(fe)
  if !strListHas(caps, name) { caps.push(name) }
  0
}

// Walk a statement or expression subtree collecting free-variable captures. `bound` holds
// the names the scopes open at this point bind: a `let` binds to the end of its block and a
// loop variable to the end of its loop, as the checker scopes them. A nested `FuncDecl` is
// scanned against its own bound set and folds only its free names into this one.
export function capScan(ix: i32, bound: {[string]: i32}, caps: string[]) {
  if ix < 0 { return 0 }
  const n = nodeAt(ix)
  match n {
    FuncDecl => {
      capScanFunc(n, bound, caps)
      return 0
    }
    Block => {
      const stmts = n.blkStmts
      let i = 0
      const mark = capTrailName.length
      while i < stmts.length {
        capScan(stmts[i], bound, caps)
        i = i + 1
      }
      if capTrailName.length > mark { capTrim(bound, mark) }
      return 0
    }
    LetDecl => {
      if n.letInit >= 0 { capScan(n.letInit, bound, caps) }
      capBind(bound, n.letName)
      return 0
    }
    RetStmt => {
      if n.retArg >= 0 { capScan(n.retArg, bound, caps) }
      return 0
    }
    IfStmt => {
      capScanIf(ix, bound, caps)
      return 0
    }
    WhileStmt => {
      capScan(n.whileCond, bound, caps)
      capScan(n.whileBody, bound, caps)
      return 0
    }
    ForRange => {
      capScan(n.frFrom, bound, caps)
      capScan(n.frTo, bound, caps)
      if n.frStep >= 0 { capScan(n.frStep, bound, caps) }
      const rmark = capTrailName.length
      capBind(bound, n.frVar)
      capScan(n.frBody, bound, caps)
      capTrim(bound, rmark)
      return 0
    }
    ForIn => {
      capScanForIn(n, bound, caps)
      return 0
    }
    Ident => {
      capValueRead = ix != capCalleeIx
      capRecord(n.identName, bound, caps, ix)
      return 0
    }
    Call => {
      capCalleeIx = n.callFn
      if !capCalleeExempt(ix, n, bound) { capScan(n.callFn, bound, caps) }
      capScanEach(n.callArgs, bound, caps)
      return 0
    }
    BinExpr => {
      capScan(n.binLeft, bound, caps)
      capScan(n.binRight, bound, caps)
      return 0
    }
    Unary => {
      capScan(n.unArg, bound, caps)
      return 0
    }
    Paren => {
      capScan(n.parInner, bound, caps)
      return 0
    }
    Member => {
      capScan(n.memObj, bound, caps)
      return 0
    }
    OptMember => {
      capScan(n.omObj, bound, caps)
      return 0
    }
    Index => {
      capScan(n.idxArr, bound, caps)
      capScan(n.idxIndex, bound, caps)
      return 0
    }
    IsExpr => {
      capScan(n.isObj, bound, caps)
      return 0
    }
    AsExpr => {
      capScan(n.asObj, bound, caps)
      return 0
    }
    ObjLit => {
      capScanFields(n.objFields, bound, caps)
      return 0
    }
    ArrayLit => {
      capScanEach(n.arrElems, bound, caps)
      return 0
    }
    Spread => {
      capScan(n.spdArg, bound, caps)
      return 0
    }
    // Literals, declarations and a match (lowered to an if before emit) reach no capture.
    NumLit | StrLit | CharLit | BoolLit | NullLit | ErrExpr | Param | TypeRef | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | MatchExpr | ImportDecl | LoopVar => {}
  }
  0
}

function capScanEach(xs: i32[], bound: {[string]: i32}, caps: string[]) {
  let i = 0
  while i < xs.length {
    capScan(xs[i], bound, caps)
    i = i + 1
  }
}

function capScanFields(fields: i32[], bound: {[string]: i32}, caps: string[]) {
  let i = 0
  while i < fields.length {
    const f = nodeAt(fields[i])
    if f is FieldInit { capScan(f.fiValue, bound, caps) }
    i = i + 1
  }
}

// The arms below are kept out of `capScan`'s frame: it recurses once per level of nesting, so
// every local an arm declares is paid at every level of a deep body.
function capScanFunc(n: FuncDecl, bound: {[string]: i32}, caps: string[]) {
  if n.fnName != "" { capBind(bound, n.fnName) }
  // A nested function's free variables that this scope does not bind are transitive
  // captures: the nested closure's env is built inside this lifted function, so a name the
  // nested body needs from an outer frame must ride this env too. Scan the nested body
  // against its own bound set, then filter the frees through `capRecord`.
  const ibound: {[string]: i32} = Map()
  const iparams = n.fnParams
  let ipi = 0
  while ipi < iparams.length {
    const ip = nodeAt(iparams[ipi])
    if ip is Param { ibound[ip.parName] = 1 }
    ipi = ipi + 1
  }
  if n.fnName != "" { ibound[n.fnName] = 1 }
  const ifree: string[] = []
  capScan(n.fnBody, ibound, ifree)
  let ifi = 0
  while ifi < ifree.length {
    capRecord(ifree[ifi], bound, caps, -1)
    ifi = ifi + 1
  }
}

function capScanIf(ix: i32, bound: {[string]: i32}, caps: string[]) {
  // An `else if` chain is walked along its spine (D1990).
  let cur = ix
  while cur >= 0 {
    const c = nodeAt(cur)
    cur = -1
    if c is IfStmt {
      capScan(c.ifCond, bound, caps)
      capScan(c.ifThen, bound, caps)
      if c.ifElse >= 0 {
        if nodeAt(c.ifElse) is IfStmt {
          cur = c.ifElse
        } else {
          capScan(c.ifElse, bound, caps)
        }
      }
    }
  }
}

function capScanForIn(n: ForIn, bound: {[string]: i32}, caps: string[]) {
  capScan(n.fiIter, bound, caps)
  const imark = capTrailName.length
  capBind(bound, n.fiVar)
  if n.fiVar2 != "" { capBind(bound, n.fiVar2) }
  capScan(n.fiBody, bound, caps)
  capTrim(bound, imark)
}

// Whether a call's callee name is exempt from capture: a builtin or intrinsic in callee position.
function capCalleeExempt(ix: i32, n: Call, bound: {[string]: i32}): boolean {
  // The one place a builtin or intrinsic name is exempt from capture, and it is a position,
  // not a name filter: in callee position `print` or `Map` denote instructions the emitter
  // lowers inline, and anywhere else the same spelling is an ordinary identifier that must
  // be captured. Three lists partition the exempt names; the third needs the guard below.
  let skipCallee = false
  const cal = nodeAt(unwrapParen(n.callFn))
  if cal is Ident {
    if isBuiltinFnName(cal.identName) { skipCallee = true }
    // The dunder family, the numeric one and the `extern` imports take one shadowing guard
    // (D1087): `emitCall`'s arms for them are gated on `identNameIsUserBound`, so a call whose
    // name the frame binds routes to the value, and the closure's env must carry it for the
    // gate to find. The condition is the one under which the emitter writes the call.
    if (
      nameIsEmitterIntrinsic(cal.identName)
      || isNumIntrinsicName(cal.identName)
      || externLinkOf(cal.identName) >= 0
    ) {
      let shadowed = capIsBound(bound, cal.identName)
      if fnIndexOfNode(unwrapParen(n.callFn)) >= 0 { shadowed = true }
      if globalIndexOf(cal.identName) >= 0 { shadowed = true }
      if (
        externLinkOf(cal.identName) >= 0
        && capFrame >= 0
        && capFrame < fnStmts.length
      ) {
        // An outer frame's loop variable binds only inside its own loop (D2620).
        if outerFrameBinds(capFrame, fnStmts[capFrame], cal.identName) {
          shadowed = true
        } else if moduleLoopEnclosing(capFrame, cal.identName) >= 0 {
          shadowed = true
        }
      } else if parentBindingFrameAt(capFrame, cal.identName, ix) >= 0 {
        shadowed = true
      } else if moduleLoopEnclosing(capFrame, cal.identName) >= 0 {
        // The frame walk stops short of the module scope, whose `for` variable is a
        // start-function local: `capRecord` reads the same table for the same reason.
        shadowed = true
      }
      if !shadowed { skipCallee = true }
    }
  }
  skipCallee
}

// The `fnStmts` position of the lifted function `fnIx` when `name` is one of its captures, or
// -1. The capture channel for the expression classifiers, which resolve the capture through
// `parentBindingOf(fe, name)`, the binding `captureValKind` types the env field off.
function capturedFrameOf(fnIx: i32, name: string): i32 {
  if fnIx < 0 || !fnNestUsed { return -1 }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return -1 }
  if !strListHas(captureNamesOf(fe), name) { return -1 }
  fe
}

// The iterable of the `for-in` whose loop variable binds a captured `name` of lifted frame
// `fe`, or -1 (D1142) — the third storage class of a capture, and the one with no declaration
// node, so `captureValKind` would fall to its i32 default whatever the iterated element is.
// Asked only where `parentBindingOf` declines, which is the right precedence by construction.
function captureLoopVarIterOf(fe: i32, name: string): i32 {
  const lp = captureLoopNodeOf(fe, name)
  if lp < 0 { return -1 }
  const ln = nodeAt(lp)
  if !(ln is ForIn) { return -1 }
  // A module-scope `for` variable is a start-function local, typed with the frame -1 its own
  // `declareForInLocals` call passes, which is what the callers' frame reads answer.
  const par = parentBindingFrameOf(fe, name)
  if par < 0 { return ln.fiIter }
  frameBlindIter(ln.fiIter, fnStmts[par])
}

// The node to classify iterable `it` of frame `fnIx` by outside that frame's emission. A bare
// local iterable is the one storage class this position cannot read: every rung of
// `forInElemKind`'s Ident arm is frame-independent except `declaredKind`, which reads the live
// scope stack, so it is re-asked of the binding's initializer where the answer is the default.
function frameBlindIter(it: i32, fnIx: i32): i32 {
  const ek = forInElemKind(it, fnIx)
  if ek != null && ek != "i32" { return it }
  if fnIx < 0 { return it }
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return it }
  const itx = unwrapParen(it)
  if itx < 0 { return it }
  const itn = nodeAt(itx)
  if !(itn is Ident) { return it }
  const li = bodyLetReadAtSid(fn.fnBody, sidOfNode(itx), itx)
  if li < 0 { return it }
  const ld = nodeAt(li)
  if ld is LetDecl {
    if ld.letInit >= 0 {
      const iek = forInElemKind(ld.letInit, fnIx)
      if iek != null && iek != "i32" { return ld.letInit }
    }
  }
  it
}

// The `for-in` variable an un-annotated captured binding `name` of lifted frame `fe` is a bare
// copy of, or "". The copy's own cell is typed with the frame's locals in force, which the env
// field is not, so the field takes the loop variable's type as a direct capture of it does.
function captureLoopCopySrc(fe: i32, name: string): string {
  captureLoopCopySrcAt(fe, name, 0)
}

// `captureLoopCopySrc` `depth` copies down the chain, bounded against a shadowing cycle.
function captureLoopCopySrcAt(fe: i32, name: string, depth: i32): string {
  if depth > 8 { return "" }
  const b = parentBindingOf(fe, name)
  if b < 0 { return "" }
  const bn = nodeAt(b)
  if bn is LetDecl {
    if bn.letType >= 0 || bn.letInit < 0 { return "" }
    const src = nodeAt(unwrapParen(bn.letInit))
    if src is Ident {
      const sn = src.identName
      if sn == name { return "" }
      // A copy of a copy is typed as the loop variable at the end of the chain, and an
      // un-narrowed copy of a `let` as that `let`, whose cell only the frame's locals know.
      const sb = parentBindingOf(fe, sn)
      if sb >= 0 {
        const deeper = captureLoopCopySrcAt(fe, sn, depth + 1)
        if deeper != "" { return deeper }
        if copyReadIsUnnarrowed(unwrapParen(bn.letInit), sb) { return sn }
        return ""
      }
      // A boxed element is not redirected: the closure's narrowed reads of the copy resolve
      // its union through the copy's own binding, which has no loop in scope (D2523).
      if (
        captureLoopVarIterOf(fe, sn) >= 0
        && captureValKind(fe, sn) != "union"
      ) {
        return sn
      }
    }
  }
  ""
}

// Set only while `captureValKind` types an un-annotated env field off its initializer.
let capInitAsk = false

// The `fbValtype` kind for a captured variable `name` of lifted function `fe`, resolved
// against the parent frame's binding — a param's annotation, or a local `let`'s annotation
// or initializer. Defaults to i32.
export function captureValKind(fe: i32, name: string): VKind {
  const cps = captureLoopCopySrc(fe, name)
  if cps != "" { return captureValKind(fe, cps) }
  const b = parentBindingOf(fe, name)
  if b < 0 {
    // A captured `for-in` loop variable (D1142) — typed off the very ladder
    // `declareForInLocals` types the loop-var local with, resolved in the owning frame, so
    // the env field and the local it is built from cannot disagree.
    const lvIter = captureLoopVarIterOf(fe, name)
    if lvIter >= 0 {
      const lvf = parentBindingFrameArenaOf(fe, name)
      if captureLoopVarIsPair(fe, name) {
        const lpk = forInPairElemKind(lvIter, lvf)
        if lpk != null { return lpk }
        return "i32"
      }
      const lvk = forInElemKind(lvIter, lvf)
      if lvk != null { return lvk }
    }
    return "i32"
  }
  const bn = nodeAt(b)
  match bn {
    Param => {
      return vtKindOfType(bn.parType)
    }
    LetDecl => {
      // The env field is the local's own cell, so it is read where the local's is.
      const rpf = parentBindingFrameArenaOf(fe, name)
      if letBindRepClaims(b, rpf) { return letBindRep(b, rpf).rdKind }
      if bn.letType >= 0 {
        const annK = vtKindOfType(bn.letType)
        // The env field must match the LOCAL's own cell, not re-derive from the annotation:
        // a narrowed nullable initialiser keeps its niche through the binding, because the
        // narrowing is type-level and the rep is not. Reading the annotation alone declares a
        // non-null field over a value that arrives nullable (D1632).
        if bn.letInit >= 0 {
          const nicheK = vkNulNicheOf(annK)
          if nicheK != null {
            const initK = letInitCellKind(
              b,
              parentBindingFrameArenaOf(fe, name),
            )
            if initK == nicheK { return nicheK }
            // …and a walk variable over niche elements, whose cell only the loop knows (D3139).
            if (
              letInitLoopElemKind(b, parentBindingFrameArenaOf(fe, name))
              == nicheK
            ) {
              return nicheK
            }
            // The rung above reads the frame, and a MODULE-frame block binding has none, so a
            // field read's nullable slot goes unseen exactly where the ladder cannot ask. This
            // one is frame-blind: the field's storage decides it, not the scope (D1759).
            if initIsNestedStructFieldRead(b) { return nicheK }
          }
        }
        return annK
      }
      // Un-annotated local: classify the initializer through `letInitCellKind`, the same ladder
      // `collectLocals` types the binding with, resolved in the owning frame, so a captured
      // list, string or struct env field carries its real ref valtype. The frame is an arena
      // index and not an `fnStmts` position — `parentBindingFrameArenaOf` is that one home.
      if bn.letInit >= 0 {
        const askWas = capInitAsk
        capInitAsk = true
        const ck = letInitCellKind(b, parentBindingFrameArenaOf(fe, name))
        capInitAsk = askWas
        return ck
      }
    }
    // No other binding has a captured kind.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  "i32"
}

// The second `fbValtype` argument, the table index, for a captured ref variable. An
// annotated binding resolves it through `annValtypeSlotOf`, the one home for which interned
// slot an annotation selects, and `captureValKind` hands the same annotation node to
// `vtKindOfType`, so kind and index cannot come from different ladders.
export function captureValStructIdx(fe: i32, name: string) {
  const cps = captureLoopCopySrc(fe, name)
  if cps != "" { return captureValStructIdx(fe, cps) }
  const b = parentBindingOf(fe, name)
  if b < 0 {
    // The loop-variable pair's second half (D1142) — `captureValKind`'s companion, from the
    // same home `declareForInLocals` reads. A kind without its slot is a loud reject and not
    // a fallback, so the two arms land together.
    const lvIter = captureLoopVarIterOf(fe, name)
    if lvIter >= 0 {
      const lvf = parentBindingFrameArenaOf(fe, name)
      if captureLoopVarIsPair(fe, name) {
        return forInPairStructIdx(lvIter, lvf)
      }
      return forInVarStructIdx(lvIter, lvf)
    }
    return -1
  }
  const bn = nodeAt(b)
  match bn {
    Param => {
      return annValtypeSlotOf(bn.parType)
    }
    LetDecl => {
      const rpf = parentBindingFrameArenaOf(fe, name)
      if letBindRepClaims(b, rpf) { return letBindRepSlot(b, rpf) }
      if bn.letType >= 0 { return annValtypeSlotOf(bn.letType) }
      if bn.letInit >= 0 {
        // The owning frame as an arena index — the same conversion `captureValKind`'s
        // un-annotated arm makes, and for the same reason: `letIsMap`, `letIsNulRef` and
        // `letIsRefArray` all forward `pf` to `P.nodes[pf]`.
        const pf = parentBindingFrameArenaOf(fe, name)
        // The companion index of `letInitCellKind`'s ref kinds, arm for arm. A kind without
        // its slot is a loud reject and not a fallback: `fbValtype`'s bounds guard turns a -1
        // on any ref kind into `ref valtype with no interned shape` (D21).
        if letIsRefArray(b, pf) && !letIsUnion(b, pf) {
          return letRefListSlot(b, pf)
        }
        if letIsStruct(b, pf) {
          const csi = structIndexOfLet(b, pf)
          if csi < 0 {
            const cov = letObjLitVariantIdx(b, pf)
            if cov >= 0 { return cov }
          }
          return csi
        }
      }
    }
    // No other binding has a captured slot.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// The mv slot of a `m[k]` or `m[k] ?? d` read over a struct-list-valued map, else -1. The hook
// `refListElemNameOfExpr` uses to name the read's element, so `(m[k] ?? []).length` resolves.
function mapReadStructListMvSlot(exprIx: i32, fnIx: i32) {
  const cm = coalesceMvSlot(exprIx, fnIx)
  if cm >= 0 {
    if mvListValKind(cm) == "reflist" { return cm }
  }
  const mr = mapReadMvSlot(exprIx, fnIx)
  if mr >= 0 {
    if mvListValKind(mr) == "reflist" { return mr }
  }
  -1
}

// True when `name` read in lifted frame `fnIx` is one of its captures, so the read is an env
// field rather than a local. The list-op receiver stages such a name (D1965); the scratch
// collector and the emitter both ask this one predicate.
export function identIsEnvCapture(fnIx: i32, name: string): boolean {
  if fnIx < 0 || !fnNestUsed { return false }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return false }
  strListHas(captureNamesOf(fe), name)
}

// ── string-op detection: which functions need the string scratch frame ────────
// A function reserves the shared string scratch frame exactly when it uses any string `+`,
// `==` or `.slice` anywhere in an expression, so the walk below descends every expression
// position, not only statement receivers. `exprString` reads the already-built local columns.

// True if `binIx` is a `+` whose operands are strings (string concatenation).
export function exprIsStrConcat(binIx: i32, fnIx: i32) {
  const e = nodeAt(binIx)
  if e is BinExpr {
    if e.binOp == "+" {
      const m = if arithRegionSeen && (bcOpen || e.binRegion != 0) { bcGet(binIx, fnIx, BC_STR) } else { -2 }
      if m >= 0 { return m == 1 }
      // A literal-union atom is a `string` subtype, so `"x" + k` and `k + "y"` concatenate —
      // the atom operand widens to its member string in `emitStrConcat`.
      const r = exprString(e.binLeft, fnIx)
        || exprIsLitAtom(e.binLeft, fnIx)
        || exprString(e.binRight, fnIx)
        || exprIsLitAtom(e.binRight, fnIx)
      if m != -2 { bcPutB(m, binIx, fnIx, BC_STR, r) }
      return r
    }
  }
  false
}

// The one ladder `listOpKindOf` and `catListKindOfExpr` run, so the two cannot classify one
// expression two ways. `exprArray` claims the four distinct-backing scalar lists, so it asks
// last or a scalar list answers as the i32 core. The other `expr*Array` consumers run their
// own orders and are deliberately not this ladder.
export function listOpRepOf(exprIx: i32, fnIx: i32): ListRep {
  const none: ListRep = { lrRep: LR_NONE, lrSlot: -1 }
  if exprIx < 0 { return none }
  if exprString(exprIx, fnIx) { return none }
  if exprStringArray(exprIx, fnIx) { return lrOf(LR_STR) }
  if exprF64Array(exprIx, fnIx) { return lrOf(LR_F64) }
  if exprI64Array(exprIx, fnIx) { return lrOf(LR_I64) }
  if exprF32Array(exprIx, fnIx) { return lrOf(LR_F32) }
  if exprU8Array(exprIx, fnIx) { return lrOf(LR_U8) }
  if exprRefArray(exprIx, fnIx) {
    const ref: ListRep = {
      lrRep: LR_REF,
      lrSlot: refListSlotOfExpr(exprIx, fnIx),
    }
    return ref
  }
  if exprArray(exprIx, fnIx) { return lrOf(LR_I32) }
  none
}

// ── list `+` concat rep detection — the one home ──────────────────────────────
// The list rep an expression concatenates over, in `listBuildKindOfVKind`'s alphabet, or -1
// for a non-list. `listOpKindOf`'s ladder, read through a wider accept set: a concat inspects
// no element, so the four scalar reps answer here where the list-op home declines them.
export function catListKindOfExpr(exprIx: i32, fnIx: i32) {
  const lr = listOpRepOf(exprIx, fnIx)
  if lr.lrRep == LR_STR { return LBK_STR_LIST }
  if lr.lrRep == LR_F64 { return LBK_F64_LIST }
  if lr.lrRep == LR_I64 { return LBK_I64_LIST }
  if lr.lrRep == LR_F32 { return LBK_F32_LIST }
  if lr.lrRep == LR_U8 { return LBK_U8_LIST }
  if lr.lrRep == LR_REF {
    if lr.lrSlot >= 0 { return LBK_REF }
    return -1
  }
  if lr.lrRep == LR_I32 { return LBK_I32_LIST }
  -1
}

// The operand of a list `+` over two reps that is copied into the other's before the concat:
// 1 the left, 2 the right, 0 neither. The checker types the concat at the operand the other
// is assignable to, so exactly one direction can hold.
export function catWidenSideOfBin(binIx: i32, fnIx: i32): i32 {
  const e = nodeAt(binIx)
  if e is BinExpr {
    if e.binOp != "+" { return 0 }
    const lk = catListKindOfExpr(e.binLeft, fnIx)
    const rk = catListKindOfExpr(e.binRight, fnIx)
    return catWidenSide(e, lk, rk, fnIx)
  }
  0
}

// `catWidenSideOfBin` over a `+` whose operands' concat kinds `lk`/`rk` are already read.
export function catWidenSide(e: BinExpr, lk: i32, rk: i32, fnIx: i32): i32 {
  if lk < 0 && rk < 0 { return 0 }
  if catSameKind(e, lk, rk, fnIx) >= 0 { return 0 }
  if catOperandWidensTo(e.binRight, rk, e.binLeft, lk, fnIx) { return 2 }
  if catOperandWidensTo(e.binLeft, lk, e.binRight, rk, fnIx) { return 1 }
  0
}

// Whether list `src` (concat kind `sk`) reaches list `dst`'s rep (`dk`) by an
// element-converting copy: boxed into a union element (`spreadSrcBoxes`), or one of the
// lossless scalar widenings.
function catOperandWidensTo(
  src: i32,
  sk: i32,
  dst: i32,
  dk: i32,
  fnIx: i32,
): boolean {
  if dk == LBK_REF {
    const row = refListSlotOfExpr(dst, fnIx)
    if row < 0 || row >= rlElemKindTbl.length { return false }
    if rlElemKindTbl[row] != RLK_UNION { return false }
    return spreadSrcBoxes(src, row, fnIx) == 1
  }
  if dk != LBK_F64_LIST && dk != LBK_I64_LIST { return false }
  const sp = tyArrayElemPrimName(nodeTyIxOf(src))
  const fromI32 = sk == LBK_I32_LIST && sp == "i32"
  if dk == LBK_F64_LIST {
    return fromI32 || (sk == LBK_F32_LIST && sp == "f32")
  }
  fromI32
}

// The concat kind of a `+` whose operands' kinds `lk`/`rk` are of one rep and one ref-list
// row, or -1.
export function catSameKind(e: BinExpr, lk: i32, rk: i32, fnIx: i32) {
  if lk < 0 || rk != lk { return -1 }
  if lk == LBK_REF {
    if (
      refListSlotOfExpr(e.binLeft, fnIx)
      != refListSlotOfExpr(e.binRight, fnIx)
    ) {
      return -1
    }
  }
  lk
}

// True if `callIx` is a `recv.<prop>(...)` call over a string receiver. The string
// intrinsics (`slice`, `charCodeAt`, `cpAt`, `cpLen`, `isCharBoundary`, `bytes`) are each
// this test with their own method name.
export function exprIsStrMethod(callIx: i32, fnIx: i32, prop: string) {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return false }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      if callee.memProp == prop { return exprString(callee.memObj, fnIx) }
    }
  }
  false
}

export function arrNewIntrKind(callIx: i32, fnIx: i32): ArrNewKind {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return "none" }
    const callee = nodeAt(c.callFn)
    if callee is Ident {
      if callee.identName == "__array_new__" {
        const ank = arrNewNamedKind(callIx, fnIx)
        if ank != "none" { return ank }
        // Nothing named it, so `"list"` here is a guess. Every consumer of this classifier
        // keeps reading it; the emitter asks `arrNewKindNamed` and refuses instead (D1630).
        return "list"
      }
      if callee.identName == "__array_new_default__" {
        return arrNewDefaultKind(callIx)
      }
    }
  }
  "none"
}

// The `__array_new__` element kind some source NAMES, or `"none"` where none does. Three
// sources, asked in that order: the fill's own rep, the destination's recorded type, and —
// inside a monomorphized body, where that type is still the unpinned `T[]` — the instance's
// substituted parameter annotation.
export function arrNewNamedKind(callIx: i32, fnIx: i32): ArrNewKind {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callArgs.length == 2 {
      if exprIsF64(c.callArgs[1], fnIx) { return "f64list" }
      // D963 — the i64 fill: `ia64TypeIdx` and `il64TypeIdx` are interned like the f64
      // pair above and `i64[]` lists lower and run. Ahead of the string and struct arms
      // for the same reason f64 is: a scalar fill cannot be either. An f32 fill needs no
      // arm here — a float literal types f64, so the two channels below name it (D1673).
      if exprIsI64(c.callArgs[1], fnIx) { return "i64list" }
      // A string fill builds the string list; a struct or object-literal fill builds the
      // ref list for that element struct.
      if exprString(c.callArgs[1], fnIx) { return "strlist" }
      const anf = nodeAt(c.callArgs[1])
      if anf is ObjLit { return "reflist" }
      if exprStruct(c.callArgs[1], fnIx) { return "reflist" }
      if exprIsClosure(c.callArgs[1], fnIx) { return "reflist" }
      if exprArray(c.callArgs[1], fnIx) { return "reflist" }
      if exprRefArray(c.callArgs[1], fnIx) { return "reflist" }
      if exprStringArray(c.callArgs[1], fnIx) { return "reflist" }
      if exprMap(c.callArgs[1], fnIx) { return "reflist" }
      // A wide-scalar list fill is a ref-list element like every other list. The three arms
      // above claim one only where it is a module global; an `f64[]`/`i64[]`/`u8[]`/`f32[]`
      // parameter or local reaches here (D1631).
      if exprF64Array(c.callArgs[1], fnIx) { return "reflist" }
      if exprI64Array(c.callArgs[1], fnIx) { return "reflist" }
      if exprU8Array(c.callArgs[1], fnIx) { return "reflist" }
      if exprF32Array(c.callArgs[1], fnIx) { return "reflist" }
      // The fill named no kind, so the DESTINATION's rep decides. A union-typed fill answers
      // none of the questions above (D1630).
      const anDest = arrNewDestKind(callIx)
      if anDest != "none" { return anDest }
      return arrNewFillAnnKind(callIx, fnIx)
    }
  }
  "none"
}

// The wasm local index of the declared-local position `pos` in function `fnIx`, or -1 when
// `pos` names no local. Declared locals sit after the params, so the index is
// `envShift + paramCount + pos`. The position-to-index half of declared-local resolution,
// shared by `localIndexOf`, `captureHomeOf` and the loop-value frames.
export function declaredIndexAt(fnIx: i32, pos: i32) {
  if pos < 0 { return -1 }
  if fnIx < 0 {
    // Module scope is the start function's body, which has no params, so the local index is
    // the slot. A global-section constexpr init also runs at `fnIx` -1, but its scope stack
    // is empty, so `declaredSlotOf` has already answered -1.
    return pos
  }
  const fn = nodeAt(fnIx)
  if fn is FuncDecl { return envSlotShift(fnIx) + fn.fnParams.length + pos }
  -1
}

// Whether function `fe` carries the hidden leading `structref env` param: only a function
// that reads one, which is one with captures or one lambda-lifted (its captures follow the
// env). Every other function keeps its plain signature, and a value of it dispatches through
// an env-taking thunk (`cloThunkFes`).
export function fnHasEnvParam(fe: i32): boolean {
  if !fnNestUsed || fe < 0 { return false }
  if fe < cloLiftCapN.length && cloLiftCapN[fe] >= 0 { return true }
  captureCountOf(fe) > 0
}

// The wasm-local-index offset of a function's declared params: the env (local 0) when the
// function carries one (`fnHasEnvParam`), plus a lifted function's captures after it. Zero
// for every other function and for the start one.
export function envSlotShift(fnIx: i32) {
  if !fnNestUsed || fnIx < 0 { return 0 }
  const fe = fnStmtsPosOf(fnIx)
  if !fnHasEnvParam(fe) { return 0 }
  if fe < cloLiftCapN.length && cloLiftCapN[fe] > 0 {
    return 1 + cloLiftCapN[fe]
  }
  1
}

// Is `name` bound by the user in this frame — a parameter, a local, or a capture of one?
// Scoped to callee position only (a parameter named `__load_i32__` is legal VL); a
// parameter is the only binding form that can hold such a name, since the checker refuses
// a `function`/`const`/`let` of an intrinsic spelling. Guards a capture-of-parameter miss (D1087).
export function identNameIsUserBound(ix: i32, fnIx: i32): boolean {
  if localIndexOf(fnIx, ix) >= 0 { return true }
  const n = nodeAt(ix)
  const name = if n is Ident { n.identName } else { "" }
  if paramIndexOf(fnIx, name) >= 0 { return true }
  capturedKindOf(fnIx, name) != null
}

// `identNameIsUserBound` asked of the read at node `atIx`, from the arena rather than the emit
// cursor, so it answers in a pass before emission too: a body `let` binds the read only where
// its scope covers it, so a call above a later local of a builtin's name is the builtin (D3607).
export function identNameIsBoundAt(
  name: string,
  fnIx: i32,
  atIx: i32,
): boolean {
  if !identNameIsUserBound(atIx, fnIx) { return false }
  if paramIndexOf(fnIx, name) >= 0 { return true }
  if capturedKindOf(fnIx, name) != null { return true }
  if fnIx < 0 || atIx < 0 { return true }
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    // An unplaceable binding keeps the unpositioned answer, as does a loop variable.
    if parentLetReadAt(fn.fnBody, sidOf(name), atIx) != -1 { return true }
    return parentLoopVarOf(fn.fnBody, name) >= 0
  }
  true
}

// True when `name` in callee position lowers to a result-less `extern function` import — the
// scope does not bind the name (a parameter of that spelling wins, as in `emitCall`) and its
// link row returns void. Such a call leaves nothing on the stack: a statement, never a value.
export function calleeIsVoidExtern(ix: i32, fnIx: i32): boolean {
  if identNameIsUserBound(ix, fnIx) { return false }
  const n = nodeAt(ix)
  if !(n is Ident) { return false }
  externRetIsVoid(externLinkOf(n.identName))
}

// The wasm local index the `Ident` read at `ix` denotes in function `fnIx`, or -1: the slot of
// the declaration the binder resolved it to, else a param, else a capture a lifted function
// assigns. A read the binder left unresolved (an emitter-minted one) takes the live scope stack.
export function localIndexOf(fnIx: i32, ix: i32) {
  if ix < 0 { return -1 }
  const n = nodeAt(ix)
  if !(n is Ident) { return -1 }
  const slot = declaredSlotOf(ix)
  if slot >= 0 { return declaredIndexAt(fnIx, slot) }
  if identDeclOf(ix) < 0 {
    const scoped = scopeSlotOf(n.identName)
    if scoped >= 0 { return declaredIndexAt(fnIx, scoped) }
  }
  bindingHomeOf(fnIx, n.identName)
}

// The wasm local index frame `fnIx` keeps capture `name` of a function it calls or closes over
// in, or -1. `name` comes from `captureNamesOf` alone: a capture list holds names, not reads,
// so this is a named floor until the list carries declarations (D14575).
export function captureHomeOf(fnIx: i32, name: string) {
  const scoped = scopeSlotOf(name)
  if scoped >= 0 { return declaredIndexAt(fnIx, scoped) }
  bindingHomeOf(fnIx, name)
}

// A param of `fnIx`, else a capture lifted frame `fnIx` assigns, which is its own param.
function bindingHomeOf(fnIx: i32, name: string) {
  const pIx = paramIndexOf(fnIx, name)
  if pIx >= 0 { return envSlotShift(fnIx) + pIx }
  if cloLiftWrName.length == 0 { return -1 }
  cloLiftWriteSlot(fnStmtsPosOf(fnIx), name)
}

// `structIndexOfObjCtx` outside any instance: the struct row the checker names for the
// object literal at `objIx`, or -1. A caller inside a generic instance passes its own `fnIx`.
export function structIndexOfObj(objIx: i32) { structIndexOfObjCtx(objIx, -1) }

// The record an anonymous struct row holds: the minting literal's own type where the row
// recorded its hole's context, else the recorded type; -1 for a declared row or none.
export function anonRowOwnTyOf(name: string): i32 {
  if name.length < 5 || name[0] != '#' { return -1 }
  const si = structIndexByName(name)
  if si < 0 || si >= sTyIx.length { return -1 }
  sAnonOwnTy.get(si) ?? sTyIx[si]
}

// Whether a field of type `rowTy` stores field `name` of the object literal at `objIx`, whose
// checked type is a type parameter, at the type instance `fnIx` binds it to: kind 0 reads as
// agreeing everywhere else, so every pin would share one row (D3032). A `boolean` pin keeps the
// `i32` slot it shared before an instance had a row of its own. True outside an instance.
function pinKindFitsTy(
  objIx: i32,
  name: string,
  rowTy: i32,
  fnIx: i32,
): boolean {
  if fnIx < 0 || rowTy < 0 || rowTy >= T.tys.length { return true }
  const lt = tyFieldTyOf(nodeRepTyIxOf(objIx), name)
  if lt < 0 || !tyHasTyVar(lt) { return true }
  const valIx = objFieldVal(objIx, name)
  if valIx < 0 { return true }
  const pin = pinnedValTyOf(valIx, fnIx)
  if pin < 0 { return true }
  const lk = fieldScalarKindOf(pin)
  const rk = fieldScalarKindOf(rowTy)
  if lk == 2 && rk == 1 { return true }
  if lk != 0 && rk != 0 { return fieldKindWidens(lk, rk) }
  // A scalar and a reference share no slot, and two references one only as one type.
  const pRef = tyIsRefShaped(pin)
  const rRef = tyIsRefShaped(rowTy)
  if pRef && rRef { return tySameSet(pin, rowTy, TY_WALK_DEPTH) }
  if pRef { return rk == 0 }
  if rRef { return lk == 0 }
  true
}

export function structIndexOfObjCtx(objIx: i32, fnIx: i32) {
  const own = structIndexOfObjCtxMemo(objIx, fnIx)
  const dst = objLitBindDestRow(objIx, own)
  if dst >= 0 { return dst }
  const fdst = objLitFieldDestRow(objIx, own, fnIx)
  if fdst >= 0 { return fdst }
  own
}

// The row of the record field the object literal at `objIx` is the value of, where the literal
// holding it is built at another row than its own; else -1 to keep `own`.
function objLitFieldDestRow(objIx: i32, own: i32, fnIx: i32): i32 {
  if own < 0 || !rsIxReady() { return -1 }
  const fi = rsUp(objIx)
  if fi < 0 || fi >= P.nodes.length { return -1 }
  const f = nodeAt(fi)
  if !(f is FieldInit) { return -1 }
  const pi = rsUp(fi)
  if pi < 0 || pi >= P.nodes.length || !(nodeAt(pi) is ObjLit) { return -1 }
  const pr = structIndexOfObjCtx(pi, fnIx)
  if pr < 0 || pr == structIndexOfObjCtxMemo(pi, fnIx) { return -1 }
  const k = sFieldIndex(pr, f.fiName)
  if k < 0 || sFieldTypeAt(pr, k) != FC_STRUCT { return -1 }
  const t = sFieldTgtStructIdx(pr, k)
  if t < 0 || rsSameRow(t, own) { return -1 }
  t
}

function structIndexOfObjCtxMemo(objIx: i32, fnIx: i32) {
  while sioMemoIx.length <= objIx {
    sioMemoIx.push(0 - 2)
    sioMemoFn.push(0 - 2)
    sioMemoVer.push(0 - 1)
    sioMemoUn.push(0 - 1)
  }
  if sioMemoIx[objIx] != 0 - 2 && sioMemoFn[objIx] == fnIx {
    // A hit requires the row and union counts unchanged: an append can mint the row a
    // remembered miss waits for.
    const fresh = sioMemoVer[objIx] == sNames.length
      && sioMemoUn[objIx] == unNames.length
    if fresh { return sioMemoIx[objIx] }
  }
  const r = structIndexOfObjCtxGo(objIx, fnIx)
  // A miss over a type still holding a hole is not remembered: a pin fills the hole in place.
  if r < 0 && tyHasInferHole(nodeTyIxOf(objIx), 0) { return r }
  sioMemoIx[objIx] = r
  sioMemoFn[objIx] = fnIx
  sioMemoVer[objIx] = sNames.length
  sioMemoUn[objIx] = unNames.length
  r
}

// The struct row record literal `objIx` is built at, read only from the checker's answers: its
// adopted rep, then its own type, elaborated in instance `fnIx` (when >= 0) so a shared generic
// body's literal resolves per instance. -1 when the checker names no struct row.
function structIndexOfObjCtxGo(objIx: i32, fnIx: i32) {
  const o = nodeAt(objIx)
  if o is ObjLit {
    const nf = o.objFields.length
    // A bare `{}` completes the record the checker adopted for it, which a field-count scan
    // cannot find: its fields are omitted, and a declared `type E = {}` row would match (D2223).
    if nf == 0 {
      const er = repRowOfTyStruct(nodeRepTyAt(objIx, fnIx), sScanLim())
      if er >= 0 { return er }
      const fr = structRowOfObjFieldSet(nodeTyIxOf(objIx))
      if fr >= 0 { return fr }
    }
    // A literal is built at the row of the record the checker stored it as: its own field types
    // would name a different row, or several (D2437).
    const adopted = litRepTyAt(objIx, fnIx)
    if nf > 0 && adopted >= 0 {
      const ar = repRowOfTyStruct(adopted, sScanLim())
      if ar >= 0 { return ar }
      // A shape minted for a hole instance may share a rep-equal row it records as an alias.
      const al = structIndexOfTy(adopted)
      if al >= 0 { return al }
    }
    // Else the checker's own type for the literal names the row; a stamp still holding a
    // hole is no answer, so an instance reads its elaborated type instead.
    if nf > 0 {
      const nt = nodeRepTyIxOf(objIx)
      if nt >= 0 && !tyHasTyVar(nt) && !tyHasInferHole(nt, 0) {
        const nr = repRowOfTyStruct(nt, sScanLim())
        if nr >= 0 { return nr }
      } else {
        // A stamp naming the hole of the parameter it is handed to leaves the literal its own
        // record type, which that parameter's instance stores it as (D2762).
        const ot = nodeTyIxOf(objIx)
        if ot >= 0 && !tyHasTyVar(ot) && !tyHasInferHole(ot, 0) {
          const orr = repRowOfTyStruct(ot, sScanLim())
          if orr >= 0 { return orr }
        }
      }
    }
    // Else the anonymous row the mint made for this literal, in this instance or in none.
    const mr = sLitMintRow.get(objIx) ?? -1
    if mr >= 0 {
      const mf = sLitMintFn.get(objIx) ?? -1
      if mf < 0 || mf == fnIx { return mr }
    }
    return -1
  }
  -1
}

// The leaf field's wasm type code of an optional chain (`x?.y`, `o?.inner?.y`) — the
// `sFieldTypeAt` of the last link, or -1 when `exprIx` isn't a resolvable chain. The
// chokepoint for "what rep does a `?.` deliver" (`exprNullableString`, `exprUnion`); the
// consumer-side twin of what `emitOptMemberValue`'s `?? d` arm resolves by hand.
function optChainLeafFieldCode(exprIx: i32, fnIx: i32) {
  const e = nodeAt(unwrapParen(exprIx))
  if e is OptMember {
    const si = optChainStructIdxOf(e.omObj, fnIx)
    if si >= 0 {
      const fi = sFieldIndex(si, e.omProp)
      if fi >= 0 { return sFieldTypeAt(si, fi) }
    }
  }
  -1
}

export function optChainStructIdxOf(exprIx: i32, fnIx: i32) {
  const e = nodeAt(unwrapParen(exprIx))
  if e is OptMember {
    const psi = optChainStructIdxOf(e.omObj, fnIx)
    if psi < 0 { return -1 }
    const pfi = sFieldIndex(psi, e.omProp)
    if pfi < 0 { return -1 }
    if sFieldTypeAt(psi, pfi) != FC_STRUCT { return -1 }
    return sFieldTgtStructIdx(psi, pfi)
  }
  structIndexOfExpr(exprIx, fnIx)
}

// The fifth receiver shape of the member field-code ladder: a receiver typed `Arm | null`
// (code `nulvariant`), which none of the ladder's other rungs cover. Shares its reader
// with `addLocalSlot`'s typing (`nulVariantIdxOfExpr`), so the classifier and the slot
// cannot name two different rows (D1094).
function memRecvNulVariantIndex(recvIx: i32, fnIx: i32) {
  nulVariantIdxOfExpr(recvIx, fnIx)
}

// The variant row an un-narrowed receiver's value is laid out at: a union ARM (variant param,
// local, capture, call) or an `Arm | null`, or -1 when the receiver is neither.
export function memRecvArmVariantIndex(recvIx: i32, fnIx: i32): i32 {
  const vi = exprVariantIndex(recvIx, fnIx)
  if vi >= 0 { return vi }
  memRecvNulVariantIndex(recvIx, fnIx)
}

// The variant row a code-15 struct-field read `p.err` targets, or -1 when the field isn't
// a nested-shape field or its target is a plain struct. A code-15 field stores a ref
// whether or not it's nullable, and `T` may be a union arm rather than a standalone
// struct — `collectS` skips a union member, so only the variant table has its layout.
function memberNulVariantRow(memIx: i32, fnIx: i32) {
  const m = nodeAt(memIx)
  if m is Member {
    if memberFieldCode(memIx, fnIx) != FC_STRUCT { return -1 }
    // The checker's type on the read node, not the field table's recorded name: the field
    // table banks canon's softened rendering, which can miss the arm `variantIndexOf` needs.
    const ty = nodeTyAt(memIx, fnIx)
    if ty < 0 { return -1 }
    const t = tyAt(ty)
    if t is TyNullable { return repVariantShapeRowOf(t.nInner) }
    repVariantShapeRowOf(ty)
  } else {
    -1
  }
}

// The value-union name of a union-typed struct field read `o.y` (field code 16), or ""
// when the member isn't a union-box field. Covers a narrowed-variant receiver too (`v.f`
// where `v` is narrowed to a union arm carrying a value-union field `f`) — the field then
// rides the variant tables, not the incrementally-built struct table.
export function memberUnionFieldName(memIx: i32, fnIx: i32) {
  const m = nodeAt(memIx)
  if m is Member {
    const si = structIndexOfExpr(m.memObj, fnIx)
    if si >= 0 {
      const fi = sFieldIndex(si, m.memProp)
      if fi >= 0 {
        if sFieldTypeAt(si, fi) == FC_UNION { return sFieldElemNameAt(si, fi) }
      }
    }
    // The receiver is a narrowed union arm (`v.f`, `v` narrowed to a struct variant):
    // resolve `f` through the variant field tables.
    const nvi = memNarrowVariantIndex(memIx, fnIx)
    if nvi >= 0 {
      const vfi = variantFieldIndex(nvi, m.memProp)
      if vfi >= 0 {
        if variantFieldTypeAt(nvi, vfi) == FC_UNION {
          return variantFieldElemName(nvi, vfi)
        }
        // The narrowed arm stores the field unboxed, whatever a same-named field of a
        // sibling arm stores.
        return ""
      }
    }
    // Narrowing-blind last resort (the frame pre-pass runs before narrowing is active): an
    // ident declared as a union whose struct arm carries a code-16 field named `memProp`,
    // probed across the arms directly. Gated on the checker having typed the read a union
    // (cheap), since the ident-union walk below is too hot to run on every struct read.
    if !nodeTyIsUnion(memIx) { return "" }
    const mObj = nodeAt(unwrapParen(m.memObj))
    if mObj is Ident {
      const mun = unionNameOfRead(unwrapParen(m.memObj), fnIx)
      if mun != "" {
        const mAtoms: string[] = []
        unionArmsOf(mun, mAtoms)
        // The arm's struct row can be asked for by type: `unionMemberTysOf` appends
        // member types in the same order `splitUnionAtoms` cuts names, so the two arrays pair up.
        const mTys: i32[] = []
        let mCov = unionMemberTysOfAB(
          13,
          mun,
          unionDeclTyIxOfExpr(m.memObj, fnIx),
          mTys,
        )
        if mTys.length != mAtoms.length { mCov = false }
        let mi = 0
        while mi < mAtoms.length {
          const ma = mAtoms[mi]
          if ma != "null" {
            let msi = -1
            if mCov { msi = structIndexOfTy(mTys[mi]) }
            if msi < 0 {
              if mCov {
                msi = structIndexOfTypeNameTy(ma, mTys[mi])
              } else {
                msi = structIndexOfTypeName(ma)
              }
            }
            if msi >= 0 {
              const mfi = sFieldIndex(msi, m.memProp)
              if mfi >= 0 {
                if sFieldTypeAt(msi, mfi) == FC_UNION {
                  return sFieldElemNameAt(msi, mfi)
                }
              }
            }
            const mvi = variantIndexOf(ma)
            if mvi >= 0 {
              const mvfi = variantFieldIndex(mvi, m.memProp)
              if mvfi >= 0 {
                if variantFieldTypeAt(mvi, mvfi) == FC_UNION {
                  return variantFieldElemName(mvi, mvfi)
                }
              }
            }
          }
          mi = mi + 1
        }
      }
    }
  }
  ""
}

// The value-union name of a code-16 field read whose receiver is a declared union arm
// (`const g: Circle = …; g.r`, a `Circle` parameter or return, a `Circle[]` element) —
// the gap `memberUnionFieldName` leaves, since a union arm has no row in the standalone
// struct table (`collectS` skips a member of a `type X = {…}` union). "" for the rest (D219).
function armFieldUnionName(memIx: i32, fnIx: i32) {
  const m = nodeAt(memIx)
  if m is Member {
    const avi = exprVariantIndex(m.memObj, fnIx)
    if armLayoutAmbiguousAt(avi) { return "" }
    if avi >= 0 {
      const afi = variantFieldIndex(avi, m.memProp)
      if afi >= 0 {
        if variantFieldTypeAt(avi, afi) == FC_UNION {
          return variantFieldElemName(avi, afi)
        }
      }
    }
    // The nullable receiver (`z: A | null` under its null test) reads the same arm field, so
    // it names the same box — `emitMem`'s nullable twin unboxes through this answer (D4636).
    // A named receiver only: asked of every link of a member chain, the walk is super-linear.
    if avi < 0 && nodeAt(unwrapParen(m.memObj)) is Ident {
      const nvi = nulVariantIdxOfExpr(m.memObj, fnIx)
      if nvi >= 0 && !armLayoutAmbiguousAt(nvi) {
        const nfi = variantFieldIndex(nvi, m.memProp)
        if nfi >= 0 && variantFieldTypeAt(nvi, nfi) == FC_UNION {
          return variantFieldElemName(nvi, nfi)
        }
      }
    }
    // A shared read whose members store the field at different atoms boxes each one, so the
    // read is the box of the checker's join (`sharedFieldArmsBoxable`). A receiver narrowed to
    // one arm reads that arm's own field instead.
    if avi < 0 && memNarrowVariantIndex(memIx, fnIx) < 0 {
      const bvis: i32[] = []
      const bfis: i32[] = []
      const bcode = sharedUnionFieldPlan(
        m.memObj,
        m.memProp,
        memIx,
        fnIx,
        bvis,
        bfis,
      )
      const sbn = sharedFieldStructBoxName(bvis, bfis, memIx)
      if bcode == FC_UNION && sbn != "" {
        return sbn
      } else if bcode == FC_UNION && sharedPlanBoxesSome(bvis, bfis) {
        // A join holding `null` is a nullable row, and names its box as a union row does (D13361).
        if nodeTyIsUnionRow(memIx) || nodeTyIsNullable(memIx) {
          const bn = valueUnionNameOfTy(nodeTyPinIxOf(memIx))
          if bn != "" { return bn }
        } else {
          // A read the checker typed at one atom of the box (a then arm over a type parameter).
          return sharedPlanBoxName(bvis, bfis)
        }
      } else if bcode == FC_UNION {
        // Every member stores the field as one box, which the read delivers as stored, whatever
        // the receiver's spelling (D13280).
        return sharedPlanOneBoxName(bvis, bfis)
      }
    }
  }
  ""
}

// The read-side composite: `memberUnionFieldName` (the receiver's own spelling where the read
// narrows a wider box), then the declared-arm rung (`armFieldUnionName`). The read classifiers
// ask this; the `is`-narrowing push sites ask `memberUnionFieldName` directly, since a pushed
// value there is already a bare variant ref, not a box `emitNarrowedMem` could unwrap (D220).
export function memberUnionFieldNameRead(memIx: i32, fnIx: i32) {
  const r = memberUnionFieldName(memIx, fnIx)
  if r != "" {
    const nn = memReadBoxNarrowName(memIx, fnIx)
    if nn != "" { return nn }
    return r
  }
  armFieldUnionName(memIx, fnIx)
}

// ── the read/consumer channel predicate ──────────────────────────────────────
// An un-narrowed code-16 field read's delivered atom, or -1 when the box comes back
// unchanged. Asked by both the read site and every consumer so the two cannot disagree:
// unnarrowed, a checker-banked atom at the read, and a recoverable box payload (D209).
export function memReadUnboxAtomKind(memIx: i32, fnIx: i32): i32 {
  if memReadBoxedAtomKind(memIx, fnIx) < 0 { return -1 }
  memReadCheckerAtomKind(memIx, fnIx)
}

// The other half of the channel: the atom the box the read yields actually holds, which
// isn't always the atom the read delivers — a field's declared member, the payload the
// store boxed, and the checker's type for the read can each name a different one (D291),
// so the read site needs both ends to bridge them. -1 wherever the predicate declines.
export function memReadBoxedAtomKind(memIx: i32, fnIx: i32): i32 {
  const un0 = memberUnionFieldNameRead(memIx, fnIx)
  if un0 == "" { return -1 }
  if memNarrowAtomKind(memIx, fnIx) >= 0 { return -1 }
  const cty = nodeTyAt(memIx, fnIx)
  if cty < 0 { return -1 }
  const t = tyAt(cty)
  if nodeTyIsFunc(memIx) { return boxTagOfTy(cty) }
  if t is TyPrim {
    const k = valueAtomKind(t.primName)
    if k < 0 || k == 6 { return -1 }
    return unionStoreAtomKind(un0, k)
  }
  -1
}

// The gate the lowering and every cast-result classifier ask: `asExprIsUnionCast`'s
// node-local answer, plus the rung the recorded type can't carry — a hole operand whose box
// the emitter's own rep answer (`exprUnion`) knows about. The same function the union arm's
// own boxed-operand check asks, so the gate and the arm cannot disagree (D1251).
export function asExprIsUnionCastIn(ix: i32, fnIx: i32): boolean {
  if asExprIsUnionCast(ix) { return true }
  if !asExprOperandIsHole(ix) { return false }
  if ix < 0 { return false }
  const n = nodeAt(ix)
  if n is AsExpr { return exprUnion(n.asObj, fnIx) }
  false
}

// Is `ix` a call of the intrinsic `min` / `max` / `abs` — not a user function, and (given a
// frame `fnIx >= 0`) not a parameter, local or closure value of that name, as `emitCall` reads
// it? The three take their operands' width, an integer one included.
export function callIsIntrMinMax(ix: i32, fnIx: i32): boolean {
  if ix < 0 { return false }
  const n = nodeAt(ix)
  if !(n is Call) { return false }
  if n.callArgs.length != 2 && n.callArgs.length != 1 { return false }
  const cf = n.callFn
  if cf < 0 { return false }
  const callee = nodeAt(cf)
  if !(callee is Ident) { return false }
  // The names are three bytes: the length test spares every other call its compares.
  if callee.identName.length != 3 { return false }
  if n.callArgs.length == 1 {
    if callee.identName != "abs" { return false }
  } else if callee.identName != "min" && callee.identName != "max" {
    return false
  }
  if fnIndexOfNode(cf) >= 0 { return false }
  if fnIx < 0 { return true }
  if identNameIsBoundAt(callee.identName, fnIx, cf) { return false }
  // Unbound here, the name is a module global's or the intrinsic's.
  globalIndexOf(callee.identName) < 0
}

// The width the intrinsic `min` / `max` / `abs` call at `ix` computes at — "i32", "i64", "f32" or
// "f64" — or "" when `ix` is not one. A recorded float type decides; otherwise (a generic
// instance's clone records none) the operands as they lower: any float operand takes the
// float rule, else i64 when an operand is i64, else i32.
export function minMaxKind(ix: i32, fnIx: i32): string {
  if !callIsIntrMinMax(ix, fnIx) { return "" }
  const rec = minMaxRecordedFloat(ix)
  if rec != "" { return rec }
  const n = nodeAt(ix)
  if !(n is Call) { return "" }
  const a = n.callArgs[0]
  const b = n.callArgs[n.callArgs.length - 1]
  const aF32 = exprIsF32(a, fnIx)
  const bF32 = exprIsF32(b, fnIx)
  if aF32 || bF32 || exprIsF64(a, fnIx) || exprIsF64(b, fnIx) {
    if (aF32 || bF32) && !binMixHardF64(a, b, fnIx) { return "f32" }
    return "f64"
  }
  if exprIsI64(a, fnIx) || exprIsI64(b, fnIx) { return "i64" }
  "i32"
}

// The rep the spread literal at `arrIx` builds at: its first known source's, or the scalar
// element the checker typed the literal at when every source widens to it losslessly
// (`[...ints, 2.5]` is `f64[]`), each such group then copied converting. `null` when no source
// is a list the emitter knows, which is the caller's refusal.
export function spreadDestKind(arrIx: i32, fnIx: i32): MfKind | null {
  const a = nodeAt(arrIx)
  if !(a is ArrayLit) { return null }
  const elems = a.arrElems
  let k: MfKind | null = null
  let i = 0
  while i < elems.length && k == null {
    const src = spreadArgOf(elems[i])
    if src >= 0 { k = mfRecvKindOf(src, fnIx) }
    i = i + 1
  }
  if k == null { return null }
  // A union element whose sources each box into it builds at its union-box row.
  if (
    spreadBoxingSource(arrIx, fnIx) >= 0
    && spreadOwnBoxRow(arrIx, elems, fnIx) >= 0
  ) {
    return "ref"
  }
  if spreadLitElemIsString(arrIx) && spreadSourcesStrOrAtoms(elems, fnIx) {
    return "str"
  }
  const de = spreadLitScalarElem(arrIx)
  if de == null || de == k { return k }
  if spreadSourcesWidenTo(elems, de, fnIx) { return de }
  k
}

// The row name a spread literal of ref-list sources builds at: its first source's own row
// (`spreadDestRow`), not a record the checker's structural element type resolves to, which
// can be a same-layout record declared earlier (D2938). "" for any other literal.
export function spreadLitSrcRowName(arrIx: i32, fnIx: i32): string {
  const a = nodeAt(arrIx)
  if !(a is ArrayLit) || !hasSpreadItem(a.arrElems) { return "" }
  if spreadDestKind(arrIx, fnIx) != "ref" { return "" }
  if spreadBoxingSource(arrIx, fnIx) >= 0 { return "" }
  // Only when the literal's element IS every source's: a `null` or a nullable source joins
  // the literal to `C | null`, whose row is not the source's.
  const de = tyStepElem(nodeTyIxOf(arrIx))
  if de < 0 || tyAt(de) is TyNullable { return "" }
  let i = 0
  while i < a.arrElems.length {
    const src = spreadArgOf(a.arrElems[i])
    if src >= 0 {
      const se = tyStepElem(nodeTyAt(src, fnIx))
      if se < 0 || !tySame(se, de) { return "" }
    }
    i = i + 1
  }
  const row = spreadDestRow(a.arrElems, fnIx)
  if row < 0 || row >= rlElemName.length { return "" }
  rlElemName[row]
}

// The union-box row of spread literal `arrIx`'s own typed element, when every source reaches
// it (`spreadSrcBoxes`); -1 otherwise, which keeps the caller's refusal.
export function spreadOwnBoxRow(arrIx: i32, elems: i32[], fnIx: i32): i32 {
  const row = spreadLitElemRow(arrIx)
  if row < 0 || row >= rlElemKindTbl.length { return -1 }
  if rlElemKindTbl[row] != RLK_UNION { return -1 }
  let i = 0
  while i < elems.length {
    const src = spreadArgOf(elems[i])
    if src >= 0 && spreadSrcBoxes(src, row, fnIx) < 0 { return -1 }
    i = i + 1
  }
  row
}

// How spread source `src` reaches union-box row `row`: 1 boxed per element (a scalar list whose
// element is a member, a record list the element-converting copy widens), 0 a list of that row,
// -1 neither, which keeps the plain backing copy (a union-box list shares the backing).
export function spreadSrcBoxes(src: i32, row: i32, fnIx: i32): i32 {
  if row < 0 || row >= rlElemName.length { return -1 }
  const k = mfRecvKindOf(src, fnIx)
  if k == null || k == "u8" { return -1 }
  if k == "ref" {
    const s = refListSlotOfExpr(src, fnIx)
    if s == row { return 0 }
    if s < 0 || s >= rlElemKindTbl.length { return -1 }
    if rlElemKindTbl[s] == RLK_UNION { return -1 }
    if rlWidenVariantOf(s, row) < 0 { return -1 }
    return 1
  }
  if spreadSrcBoxAtom(src, rlElemName[row]) < 0 { return -1 }
  1
}

// The member texts of spread source `src` when it is a list of an atom-repped literal union,
// whose elements each widen to their string in a `string[]` destination (D2868); else empty.
export function spreadSrcAtomTexts(src: i32, fnIx: i32): string[] {
  const none: string[] = []
  if mfRecvKindOf(src, fnIx) != "i32" { return none }
  tyLitMemberTexts(tyStepElem(nodeTyIxOf(src)))
}

// Whether every spread source among `elems` is a string list or a list of literal-union atoms,
// and at least one is the latter: the sources a `string[]` spread builds from.
export function spreadSourcesStrOrAtoms(elems: i32[], fnIx: i32): boolean {
  let atoms = false
  let j = 0
  while j < elems.length {
    const src = spreadArgOf(elems[j])
    if src >= 0 {
      if spreadSrcAtomTexts(src, fnIx).length > 0 { atoms = true }
      else if mfRecvKindOf(src, fnIx) != "str" { return false }
    }
    j = j + 1
  }
  atoms
}

// The spread source of literal `arrIx` whose elements would each need boxing: the literal is
// typed a list of a union element and this source's element is another type, or of a nullable
// element and this source is a scalar list, which has no null niche. -1 when none (D2868).
export function spreadBoxingSource(arrIx: i32, fnIx: i32): i32 {
  const a = nodeAt(arrIx)
  if !(a is ArrayLit) { return -1 }
  const de = tyStepElem(nodeTyIxOf(arrIx))
  if de < 0 { return -1 }
  const dT = tyAt(de)
  if !(dT is TyUnion || dT is TyNullable) { return -1 }
  if tyIsLitUnion(de) { return -1 }
  // A nullable string list is the string list's rep, which atom sources widen into.
  if spreadLitElemIsString(arrIx) && spreadSourcesStrOrAtoms(a.arrElems, fnIx) {
    return -1
  }
  let i = 0
  while i < a.arrElems.length {
    const src = spreadArgOf(a.arrElems[i])
    if src >= 0 {
      const se = tyStepElem(nodeTyAt(src, fnIx))
      if se >= 0 && !tySame(se, de) {
        if dT is TyUnion { return src }
        const sk = mfRecvKindOf(src, fnIx)
        if sk != "ref" && sk != "str" { return src }
      }
    }
    i = i + 1
  }
  -1
}

// Whether every spread source among `elems` is a `de` list or one that widens to it.
export function spreadSourcesWidenTo(
  elems: i32[],
  de: MfKind,
  fnIx: i32,
): boolean {
  let j = 0
  while j < elems.length {
    const src = spreadArgOf(elems[j])
    if src >= 0 {
      const sk = mfRecvKindOf(src, fnIx)
      if sk != de && !spreadElemWidens(sk, de) { return false }
    }
    j = j + 1
  }
  true
}

// The ref-list row a spread literal builds at — 0 for every kind but `"ref"`, where the row is
// the source's own, since a ref list's wrapper and backing heap types come from the row.
export function spreadDestRow(elems: i32[], fnIx: i32) {
  let i = 0
  while i < elems.length {
    const src = spreadArgOf(elems[i])
    if src >= 0 {
      const k = mfRecvKindOf(src, fnIx)
      if k != null {
        if k == "ref" { return refListSlotOfExpr(src, fnIx) }
        return 0
      }
    }
    i = i + 1
  }
  0
}

// True when one arm of the join at `ifIx` holds an interned atom and the other a string: the
// join is the string ref and the atom arm widens to its member text. The recorded-type rung
// cannot see this inside a generic body, where the join's type is one ARM's and every other
// predicate reads the THEN arm alone (D1728).
export function ifJoinAtomMeetsString(ifIx: i32, fnIx: i32) {
  const tv = ifThenValueIx(ifIx)
  const ev = ifElseValueIx(ifIx)
  if tv < 0 || ev < 0 { return false }
  if exprIsLitAtom(tv, fnIx) { return exprString(ev, fnIx) }
  if exprIsLitAtom(ev, fnIx) { return exprString(tv, fnIx) }
  false
}

// The `fbValtype` kind of a ref-typed if-expression join — string, string-list, f64-list,
// ref-list, i32-list, or struct — classified from the then arm's tail value. -1 for a
// numeric join and for a value-union/concrete-variant join (handled upstream). The array
// predicates run before the i32-list `exprArray`, which would also claim a wider list via its typed-IR fast path.
export function ifExprRefKind(ifIx: i32, fnIx: i32): VKind | null {
  // A join the checker typed as a bare number or boolean has no ref rep. Answering before the
  // arm predicates keeps a nest of `if` arms linear, since each of them asks this of its arm.
  if ifJoinIsScalarPrim(ifIx) { return null }
  // Nor does a join of a tagged set, whose value is its member's i32 id.
  if fnTagTyIsTagged(nodeTyIxOf(ifIx)) { return null }
  let i = 0
  while i < irkMemoIx.length {
    if irkMemoIx[i] == ifIx && irkMemoFn[i] == fnIx {
      if irkMemoNul[i] == 1 { return null }
      return irkMemoKind[i]
    }
    i = i + 1
  }
  irkDepth = irkDepth + 1
  const k = ifExprRefKindOf(ifIx, fnIx)
  irkDepth = irkDepth - 1
  if irkDepth == 0 {
    irkMemoIx = []
    irkMemoFn = []
    irkMemoKind = []
    irkMemoNul = []
  } else {
    irkMemoIx.push(ifIx)
    irkMemoFn.push(fnIx)
    if k == null {
      irkMemoKind.push("i32")
      irkMemoNul.push(1)
    } else {
      irkMemoKind.push(k)
      irkMemoNul.push(0)
    }
  }
  k
}

// `ifExprRefKind`'s answers per (join, function) asked during one outermost query, which
// emits nothing, so an inner join asked by several arm predicates is classified
// once rather than once per path (exponential in the nest depth otherwise, D2271). Emptied when
// the outermost query returns; `irkMemoNul` 1 marks a null answer.
let irkDepth = 0
let irkMemoIx: i32[] = []
let irkMemoFn: i32[] = []
let irkMemoKind: VKind[] = []
let irkMemoNul: i32[] = []

function ifExprRefKindOf(ifIx: i32, fnIx: i32): VKind | null {
  const tv = ifListArmValueIx(ifIx)
  if tv < 0 { return null }
  // A join of two maps the checker kept apart is their union box, not the then arm's map (D2666).
  if ifJoinIsMapUnion(ifIx, fnIx) { return null }
  // A closure join (kind 14, `(ref $cloStruct)`) checked first: a bare lambda arm is a
  // function value, not a string/array/struct.
  if exprIsClosure(tv, fnIx) { return "closure" }
  // An empty `[]` arm with no non-empty sibling to decide (an `else if` chain follows it): the
  // join pinned its element, so its recorded type is the join's rep (D2209).
  const hk = emptyArrHoleKind(tv)
  if (
    hk == "strlist"
    || hk == "f32list"
    || hk == "f64list"
    || hk == "i64list"
    || hk == "u8list"
    || hk == "reflist"
  ) {
    return hk
  }
  // The join's checked type is the arm-order-independent string signal: a `string`-typed
  // join (an atom + a string/member-literal arm, either order) is the string ref kind even
  // when the then arm alone doesn't classify stringy; the atom arm widens later.
  if tyKindOf(nodeTyAt(ifIx, fnIx)) == TK_STR { return "str" }
  if nodeRepIs(ifIx, "nulstr", fnIx) { return "str" }
  // The same signal read off the ARMS, for the body where the rung above is blind: a hole
  // arm absorbs the join, so the `if` records that arm's type. Both arms are asked, so a join
  // of two atoms keeps the i32 rep its own rungs give it (D1728).
  if ifJoinAtomMeetsString(ifIx, fnIx) { return "str" }
  // The join's checked type decides a wide scalar list: `[2]` beside `[1.5]` is an `f64[]`,
  // which the then arm alone reads as `i32[]` (D2716).
  const jlk = tyPrimLeafListKind(nodeTyAt(ifIx, fnIx))
  if jlk == "f64list" || jlk == "i64list" || jlk == "f32list" { return jlk }
  if exprString(tv, fnIx) { return "str" }
  if exprStringArray(tv, fnIx) { return "strlist" }
  // The packed byte list before every other list rung, which would claim its i32 elements (D2246).
  if exprU8Array(tv, fnIx) { return "u8list" }
  // Scalar lists in `scalarListElemKind`'s own order — f32 before f64, since
  // `exprF64Array`'s typed-IR fast path would otherwise claim an `f32[]` join too.
  if exprF32Array(tv, fnIx) { return "f32list" }
  if exprF64Array(tv, fnIx) { return "f64list" }
  if exprI64Array(tv, fnIx) { return "i64list" }
  if exprRefArray(tv, fnIx) { return "reflist" }
  if exprArray(tv, fnIx) { return "list" }
  // A map join's blocktype selects this value-shape's `$mapStruct`, so the slot is the
  // map shape (`ifExprRefSlot`'s map arm), not a struct-table index.
  if exprMap(tv, fnIx) { return "map" }
  // A concrete union ARM join: its heap type is `uVarHeap`, which the struct rung cannot
  // name. A program that also declares the union classifies the arm value as a variant, so
  // `structIndexOfExpr` answers -1 and the ladder fell through to the numeric blocktype over
  // a ref value (D1668). Ahead of the struct rung for the reason the nullable half says.
  if exprVariantIndex(tv, fnIx) >= 0 { return "variant" }
  if structIndexOfExpr(tv, fnIx) >= 0 { return "struct" }
  // A join whose deciding arm is itself nullable (D1560): every predicate above is
  // non-null, so a `T | null`-returning arm answers no to all of them and would otherwise
  // fall to the scalar path. Same kind order as the ladder above.
  const nlv = nulIfArmNullableValueIx(ifIx)
  if nlv >= 0 {
    if exprNullableString(nlv, fnIx) { return "str" }
    const nsk = exprNulScalarListKind(nlv, fnIx)
    if nsk == "nulstrlist" { return "strlist" }
    if nsk == "nulu8list" { return "u8list" }
    if nsk == "nulf32list" { return "f32list" }
    if nsk == "nulf64list" { return "f64list" }
    if nsk == "nuli64list" { return "i64list" }
    if exprNullableRefArray(nlv, fnIx) { return "reflist" }
    if exprNullableList(nlv, fnIx) { return "list" }
    if exprNullableMap(nlv, fnIx) { return "map" }
    // The variant arm goes ahead of the struct one: a union member's heap is `uVarHeap`,
    // and the struct fallback below would claim it with a row `sHeapIdx` doesn't have.
    if exprNullableVariant(nlv, fnIx) { return "variant" }
    if exprNullableStruct(nlv, fnIx) { return "struct" }
  }
  // A narrowed `X | null` arm (`b` inside `b != null`) keeps its niche cell, which the
  // non-null variant rung above does not answer for; the arm recovers to the join's rep (D3593).
  if exprNullableVariant(tv, fnIx) { return "variant" }
  // A nullable-struct join whose then arm is `null` (no rep of its own): the struct index
  // resolves from the checker's inner struct in `ifExprRefSlot` instead.
  if nodeRepIs(ifIx, "nulstruct", fnIx) { return "struct" }
  null
}

// The `fbValtype` slot (second arg) for a ref-typed if-expression join of `kind`: the
// struct table index (kind 1) or the ref-list wrapper slot (kind 5); the other ref kinds
// ignore the slot. `destStruct` is the destination's record row, -1 for none; a destination
// is preferred over the then-arm's own derivation.
export function ifExprRefSlot(
  ifIx: i32,
  fnIx: i32,
  kind: VKind,
  destStruct: i32,
) {
  // The arm that carries the rep (D1560) — the same one `ifExprRefKind` classified from, so
  // a kind and its slot are never read off two different arms.
  const tv = ifRepArmValueIx(ifIx)
  match kind {
    // A nullable-variant join: the row is the arm's own `uVarHeap` index. Without it the
    // struct arm below would claim the value and `fbValtype` would floor with no interned shape.
    "variant" => {
      // The non-null resolver first: `nulVariantIdxOfExpr` answers only for a `T | null` arm,
      // and the two rungs of `ifExprRefKind` that ask for this kind are exactly those two cases.
      const dvi = exprVariantIndex(tv, fnIx)
      if dvi >= 0 { return dvi }
      return nulVariantIdxOfExpr(tv, fnIx)
    }
    "struct" => {
      // An object-literal arm under a struct destination builds at the destination's row, as
      // the literal does outside an `if`; its own shape can name an anonymous twin whose
      // union-valued field (`{ f: A | B }` for `Sx = { f: B | string }`) is stored differently.
      if destStruct >= 0 && nodeAt(unwrapParen(tv)) is ObjLit {
        return destStruct
      }
      // With no destination, a join of records into a wider one builds at the join's own row.
      const jrow = joinedRecordRowOf(ifIx, fnIx)
      if jrow >= 0 { return jrow }
      const si = structIndexOfExpr(tv, fnIx)
      if si >= 0 { return si }
      if destStruct >= 0 { return destStruct }
      // Then arm is `null` with no binding seed — resolve the struct from the checker's
      // nullable join type instead, so the arm rep and nullable blocktype find the layout.
      const inn = nodeNulStructInnerName(ifIx)
      if inn != "" { return structIndexOfTypeNameTy(inn, nodeTyIxOf(ifIx)) }
      return destStruct
    }
    "reflist" => {
      const hs = emptyArrHoleElemSlot(tv)
      if hs >= 0 { return hs }
      return refListSlotOfExpr(tv, fnIx)
    }
    // A map join's slot is the map shape (mv slot / -1 mono / -2 set), the value every other
    // map valtype site passes to `mapTypeIdxOf`.
    "map" => {
      return mapShapeFoldSet(mapShapeOfExpr(tv, fnIx))
    }
    // Every other kind carries no slot here.
    "i32" | "list" | "str" | "union" | "strlist" | "nulvariant" | "nulstruct" | "i64" | "f64" | "f64list" | "f32" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" | "v128" => {}
  }
  -1
}

// True if evaluating `exprIx` yields an i64 scalar (see `exprScalarWidth`).
export function exprIsI64(exprIx: i32, fnIx: i32) {
  exprScalarWidth(exprIx, fnIx) == "i64"
}

// True if the un-annotated `LetDecl` at `letIx` should infer an f32 slot — its initializer
// already yields an f32. f32 is the checker's weak spot (no f32 typed-IR), so this is
// annotation-only; without it an un-annotated `let y = s.x` over an f32 source would
// default to an i32 slot and store an f32 into it. A bare float literal stays f64.
export function letInfersF32(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 { return false }
    if d.letInit < 0 { return false }
    return exprIsF32(d.letInit, fnIx)
  }
  false
}

// True if evaluating `exprIx` yields a v128 vector, a `new v128` brand included (see
// `exprScalarWidth`).
export function exprIsV128(exprIx: i32, fnIx: i32) {
  exprScalarWidth(exprIx, fnIx) == "v128"
}

// True if the `LetDecl` at `letIx` binds a v128 — annotated with `v128` or a brand over it, or
// un-annotated with an init that yields a vector. The one route a `v128` local is classified through.
export function letInfersV128(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    // An annotated binding (`const v: F32x4 = …`): the brand is erased to its `v128` base.
    if d.letType >= 0 { return retV128Flag(d.letType) == 1 }
    if d.letInit < 0 { return false }
    return exprIsV128(d.letInit, fnIx)
  }
  false
}

// The leaf kinds of the arithmetic spine at `exprIx` (parens, unary `-`, `+ - * / %`): bit 1 =
// an f32 leaf, bit 2 = a genuine f64 leaf. A bare literal is neither, as it re-encodes at the
// operation's width; an operation over literals alone is a genuine f64, as the checker and
// `exprHasHardF64` type it (D1983). Linear in the subtree.
function spineFloatLeafBits(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return 0 }
  const e = nodeAt(exprIx)
  if e is Paren { return spineFloatLeafBits(e.parInner, fnIx) }
  if e is Unary {
    if e.unOp == "-" { return spineFloatLeafBits(e.unArg, fnIx) }
  }
  if e is BinExpr {
    const op = e.binOp
    if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
      const m = if arithRegionSeen && (bcOpen || e.binRegion != 0) { bcGet(exprIx, fnIx, BC_LEAF) } else { -2 }
      if m >= 0 { return m }
      let bits = spineFloatLeafBits(e.binLeft, fnIx)
        | spineFloatLeafBits(e.binRight, fnIx)
      if bits == 0 && exprIsF64(exprIx, fnIx) { bits = 2 }
      if m != -2 {
        bcPut(exprIx, fnIx, BC_LEAF, bits)
        bcSpineLeave(m == -3)
      }
      return bits
    }
  }
  if e is NumLit { return 0 }
  let bits = 0
  if exprIsF32(exprIx, fnIx) { bits = 1 }
  if exprIsF64(exprIx, fnIx) { bits = bits | 2 }
  bits
}

// Is the operand at `exprIx` a genuine f64 — one that does not adapt down to an f32
// operand? `exprIsF64` alone over-claims for a float literal anywhere inside an
// arithmetic node (`fv + 0.5`, `-1.0` both lower fine at f32), which matters because
// `emitFloatIntr` asks this of a routinely-compound intrinsic argument, not a leaf.
function exprHasHardF64(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  if !exprIsF64(exprIx, fnIx) { return false }
  if exprIsFloatLit(exprIx) { return false }
  // In order: not `exprIsF64` → not hard; a float literal → not hard; a genuine f64 leaf
  // anywhere in the spine → hard; otherwise soft only if the spine has an f32 leaf to adapt to.
  const bits = spineFloatLeafBits(exprIx, fnIx)
  if bits >= 2 { return true }
  bits != 1
}

// Does a binary op over `leftIx`/`rightIx` have a genuine (non-literal) f64 operand? Such an
// operand makes the whole op f64 — an f32/i32/float-literal side widens to it. Drives both
// `exprIsF32` and the f32 emit slice: without it, the f32 slice would demote a genuine f64
// operand and trap.
export function binMixHardF64(leftIx: i32, rightIx: i32, fnIx: i32) {
  if exprHasHardF64(leftIx, fnIx) { return true }
  exprHasHardF64(rightIx, fnIx)
}

// The scalar width evaluating `exprIx` yields: its type at instance `fnIx` peeled to one base
// scalar, else "" (a numeric union is a box). A direct call yields its callee slot's result, a `??`
// what its lowering yields, and a number literal its built width; where the type names no scalar,
// a parameter read yields its instance's declared type and a function-value call its signature's.
export function exprScalarWidth(exprIx: i32, fnIx: i32): string {
  if exprIx < 0 { return "" }
  const n = nodeAt(exprIx)
  if n is NumLit { return numLitWidth(exprIx, fnIx) }
  if n is Call && n.callFn >= 0 {
    const callee = nodeAt(n.callFn)
    if callee is Ident {
      const fe = fnIndexOfInScopeAt(
        sidOfNode(n.callFn),
        callee.identName,
        fnIx,
        n.callFn,
      )
      if fe >= 0 { return scalarKindWidth(repOfFnSlot(fe).rdKind) }
    }
  }
  if n is BinExpr && n.binOp == "??" {
    const ct = coalResultTyOf(exprIx, fnIx)
    if numUnionMinted && numBoxExpr(exprIx, ct) { return "" }
    return tyScalarBasePrim(ct) ?? ""
  }
  let ty = nodeTyAt(exprIx, fnIx)
  if n is Ident && ty >= 0 && tyHasTyVar(ty) {
    const pt = nodeTyIxOf(paramTypeNodeOfRead(fnIx, exprIx))
    if pt >= 0 && !tyHasTyVar(pt) { ty = pt }
  }
  if numUnionMinted && numBoxExpr(exprIx, ty) { return "" }
  const w: string = tyScalarBasePrim(ty) ?? ""
  if w != "" || !(n is Call) { return w }
  scalarKindWidth(cloCallResultKind(n, exprIx, fnIx))
}

// `k` where it names a scalar width, else "".
function scalarKindWidth(k: string): string {
  if k == "i32" || k == "i64" || k == "f32" || k == "f64" || k == "v128" {
    k
  } else {
    ""
  }
}

// The result kind of the signature function-value call `n` at `exprIx` is called at; "" where
// its callee is not a function value or its signature does not resolve.
function cloCallResultKind(n: Call, exprIx: i32, fnIx: i32): string {
  if n.callFn < 0 { return "" }
  if nodeAt(n.callFn) is Ident {
    return calleeRetKindOfRead(n.callFn, fnIx) ?? ""
  }
  cloArrCallRetKind(exprIx, fnIx) ?? cloValueCallRetKind(exprIx, fnIx) ?? ""
}

// True if evaluating `exprIx` yields an f32 scalar (see `exprScalarWidth`).
export function exprIsF32(exprIx: i32, fnIx: i32) {
  exprScalarWidth(exprIx, fnIx) == "f32"
}

// True if evaluating `exprIx` yields an f64 scalar (see `exprScalarWidth`).
export function exprIsF64(exprIx: i32, fnIx: i32) {
  exprScalarWidth(exprIx, fnIx) == "f64"
}

// The tail of the lambda a call's callee `callFnIx` names, when it is a `const` of instance
// `fnIx` bound to an un-annotated one-expression lambda whose value reads a field of one of
// `fnIx`'s own parameters, else -1. The lambda is lifted once, so its shared result kind is the
// template's; reading this tail at the enclosing instance answers per pin instead (D2864).
export function localCloPinFieldTail(callFnIx: i32, fnIx: i32): i32 {
  if fnIx < 0 { return -1 }
  const fd = nodeAt(fnIx)
  if !(fd is FuncDecl) { return -1 }
  const li = bodyLetReadAtSid(fd.fnBody, sidOfNode(callFnIx), callFnIx)
  if li < 0 { return -1 }
  const ld = nodeAt(li)
  if !(ld is LetDecl) { return -1 }
  if ld.letKw != "const" || ld.letInit < 0 { return -1 }
  const lam = unwrapParen(ld.letInit)
  if lam < 0 { return -1 }
  const lf = nodeAt(lam)
  if !(lf is FuncDecl) { return -1 }
  if lf.fnRet >= 0 { return -1 }
  if lf.fnBody < 0 { return -1 }
  const lb = nodeAt(lf.fnBody)
  if !(lb is Block) { return -1 }
  if lb.blkStmts.length != 1 { return -1 }
  const tx = fnRetExprOf(lam)
  if tx < 0 { return -1 }
  const te = nodeAt(unwrapParen(tx))
  if !(te is Member) { return -1 }
  const r = nodeAt(unwrapParen(te.memObj))
  if !(r is Ident) { return -1 }
  if fnHasParamNamed(lam, r.identName) { return -1 }
  if !fnHasParamNamed(fnIx, r.identName) { return -1 }
  unwrapParen(tx)
}

// The interned `$fnsig` key every element of the array literal behind `arrIx` shares, each a
// lambda literal, or "" when any element is not one or two keys differ. Literals only: a
// named element resolves by name, and two frames' same-named functions share it.
function cloArrElemSelfKey(arrIx: i32, fnIx: i32): string {
  const li = cloArrLitOf(arrIx, fnIx)
  if li < 0 { return "" }
  const a = nodeAt(li)
  if a is ArrayLit {
    let key = ""
    let i = 0
    while i < a.arrElems.length {
      const el = unwrapParen(a.arrElems[i])
      if el < 0 || !(nodeAt(el) is FuncDecl) { return "" }
      const fe = fnStmtsPosOf(el)
      if fe < 0 { return "" }
      const k = cloSigKeyExt(fe)
      if k == "" { return "" }
      if key != "" && k != key { return "" }
      key = k
      i = i + 1
    }
    if key != "" && cloSigPosOfKey(key) >= 0 { return key }
  }
  ""
}

// The `ArrayLit` node an indexed callee's receiver resolves to — the literal itself, or the
// initializer of the binding that names it. -1 for anything this cannot follow, which is the
// answer that keeps every other indexed closure call on `cloArrSlotSigKey`'s route.
function cloArrLitOf(arrIx: i32, fnIx: i32): i32 {
  const ix = unwrapParen(arrIx)
  if ix < 0 { return -1 }
  const e = nodeAt(ix)
  if e is ArrayLit { return ix }
  cloArrBindingLitOf(ix, fnIx)
}

// The array literal a BINDING's initializer is — the one hop `cloArrLitOf`'s own arm
// does not cover, and that ladder's default. -1 for a name this cannot follow: a parameter,
// a global built elsewhere, an initializer that is not a literal.
function cloArrBindingLitOf(ix: i32, fnIx: i32): i32 {
  const e = nodeAt(ix)
  if e is Ident {
    let li = -1
    if fnIx >= 0 {
      const fn = nodeAt(fnIx)
      if fn is FuncDecl { li = bodyLetOfRead(fn.fnBody, ix) }
    }
    if li < 0 { li = globalLetOfRead(fnIx, ix) }
    if li >= 0 {
      const d = nodeAt(li)
      if d is LetDecl {
        // Guarded before `unwrapParen`: a binding with no initializer is -1, and peeling
        // parens off it reads `P.nodes[-1]` — a compiler trap, not a refusal (D1152).
        if d.letInit >= 0 {
          const iv = unwrapParen(d.letInit)
          if iv >= 0 {
            const ivn = nodeAt(iv)
            if ivn is ArrayLit { return iv }
          }
        }
      }
    }
  }
  -1
}

// The type `monoFieldReadTys` holds for read `rd` in function `fx` or the nearest function
// enclosing it that has one, since a closure minted inside an instance reads at it (D5112).
function monoFieldReadTyAt(rd: i32, fx: i32): i32 {
  let f = fx
  let hops = 0
  while f >= 0 && hops < 64 {
    const t = monoFieldReadTyIn(rd, f)
    if t >= 0 { return t }
    const pos = fnStmtsPosOf(f)
    if pos < 0 || pos >= fnParent.length { return -1 }
    const pp = fnParent[pos]
    if pp < 0 || pp >= fnStmts.length { return -1 }
    f = fnStmts[pp]
    hops = hops + 1
  }
  -1
}

// The callee's interned `$fnsig` KEY for a value call (`f(x)`, `(o.field)(x)`, `fs[i](x)`), or "" —
// the param tokens drive argument coercion and the key resolves the functype the `call_ref` casts to.
export function cloCallSigKey(callIx: i32, fnIx: i32) {
  const c = nodeAt(callIx)
  if c is Call {
    // Parens group, they are not a value shape: `(v)(m)` resolves through the same syntactic
    // resolvers `v(m)` does. Unpeeled, a parenthesised callee reaches only the arena fallback
    // below, which answers "" for a callee the checker left an inference hole (D1626).
    const cfx = unwrapParen(c.callFn)
    if cfx < 0 { return "" }
    const cre = nodeAt(cfx)
    // A field read a generic's instances share holds its pinned type per instance (D5079).
    const pk = sigKeyOfTy(monoFieldReadTyAt(cfx, fnIx))
    if pk != "" && cloSigPosOfKey(pk) >= 0 { return pk }
    // The syntactic resolvers — fast (no type render): a function-typed binding/param Ident, a struct
    // field closure, an indexed closure-array element.
    if cre is Ident {
      const k = calleeCloSigKeyOfRead(cfx, fnIx)
      if k != "" {
        // A loop variable or binding read at the instance's type parameters (D7202).
        const ik = cloInstanceSigKey(nodeTyIxOf(c.callFn), fnIx)
        if ik != "" { return ik }
        // The interned-divergence override: a name-shaped key cannot always answer what a type
        // can. It fires when the name key is un-interned, or when the result is a nullable
        // literal union, whose two-alias spelling renders `string | null` (D3208); every other
        // call whose historic key names a real `$fnsig` keeps it.
        if (
          cloSigPosOfKey(k) < 0
          || (gLitUnionUsed != 0 && calleeRetIsNulLitUnion(c.callFn, fnIx))
        ) {
          const ak = sigKeyOfTy(nodeTyIxOf(c.callFn))
          if ak != "" && ak != k {
            if cloSigPosOfKey(ak) >= 0 { return ak }
          }
        }
        return k
      }
    }
    // A lambda literal called in place is keyed by its own lifted function, as a binding holding
    // it is; its node type renders no key for a niche signature (`string | null`), and the
    // arity fallback below then picks an unrelated functype (D2552).
    if cre is FuncDecl {
      const lfe = fnStmtsPosOf(cfx)
      if lfe >= 0 {
        const lk = cloSigKeyExt(lfe)
        if lk != "" && cloSigPosOfKey(lk) >= 0 { return lk }
      }
    }
    if cre is Member {
      const mfe = fieldClosureFeOfRecv(cre.memObj, cre.memProp, fnIx)
      if mfe >= 0 {
        // Same-field-name-set shapes dedup to one struct index, so the literal-resolved
        // closure may belong to another shape's field. Trust it only when the arity matches
        // the call; a mismatch falls to the checker-typed general fallback below, which keys
        // the field's real function type — unguarded, the wrong key drove invalid wasm.
        const mfn = nodeAt(fnStmts[mfe])
        let mfArity = -1
        if mfn is FuncDecl { mfArity = mfn.fnParams.length }
        if mfArity == c.callArgs.length {
          const mfk = cloSigKeyExt(mfe)
          // The arity guard alone can't split same-arity twin fields that dedup to one row:
          // verify against the checker-typed callee when it's a proven function type — a
          // divergent key means the syntactic resolve aliased the twin, and the typed key is
          // the field's real lambda. Either side unresolvable keeps the historic key.
          const mcty = nodeTyAt(c.callFn, fnIx)
          if mcty >= 0 {
            if tyAt(mcty) is TyFunc {
              // Keys the callee's arena functype directly (`sigKeyOfTy`) — the destringified
              // dual of rendering a name and re-parsing it.
              const mtk = sigKeyOfTy(mcty)
              // Only an interned divergent key overrides: the arena key can be a benign twin
              // of the interned one, and an un-interned key would break a working call.
              if mtk != "" && mtk != mfk {
                if cloSigPosOfKey(mtk) >= 0 { return mtk }
              }
            }
          }
          return mfk
        }
      }
    }
    if cre is Index {
      const xk = cloIndexCalleeSigKey(cfx, nodeTyAt(c.callFn, fnIx), fnIx)
      if xk != "" { return xk }
    }
    // A copy of a list element (`const g = fs[0]`) holds that element, so it is keyed as the
    // read it copies is (D6524).
    if cre is Ident {
      const ci = cloElemCopyInitOf(cfx)
      if ci >= 0 {
        const ck = cloIndexCalleeSigKey(ci, nodeTyIxOf(ci), fnIx)
        if ck != "" { return ck }
      }
    }
    // General fallback, off the hot path: derive the key from the callee's checker arena type
    // uniformly for any callee the syntactic resolvers miss (an indexed closure-array element
    // returning a struct/union, a value inferred from a factory call). `sigKeyOfTy` walks the
    // `TyFunc` spine directly, with no per-position sig producer or string spine scan.
    const ck = sigKeyOfTy(nodeTyAt(c.callFn, fnIx))
    if ck != "" { return ck }
    // A field callee read at the instance's type parameters (D7201).
    if cre is Member {
      const ik = cloInstanceSigKey(nodeTyIxOf(c.callFn), fnIx)
      if ik != "" { return ik }
    }
    // A read the capture rewrite minted (`d[0]`) carries no type of its own; the cell's list
    // type names the element's function type (D3846).
    if cre is Index && nodeTyIxOf(cfx) < 0 {
      const lt = nodeTyIxOf(cre.idxArr)
      if lt >= 0 && lt < T.tys.length {
        const la = tyAt(lt)
        if la is TyArray {
          const ek = sigKeyOfTy(la.aElem)
          if ek != "" { return ek }
        }
      }
    }
    // A call through a `const` list of function names at a computed index takes the one key the
    // named functions share, which no read retypes the index to (D6831).
    if cre is Index {
      const lk = cloPinnedListElemKey(cre.idxArr, fnIx)
      if lk != "" { return lk }
    }
    // A callee the checker left a hole (`const g = z.f` in a hole instance), or a capture of
    // one, is keyed by the function type the instance binds it to, for a result the hole-pin
    // classifiers read (`exprIsBool`, the three numeric ones, `exprString`); any other stays unkeyed (D3117).
    const hft = holeOrCapturedTyOf(c.callFn, fnIx)
    if hft >= 0 {
      const hf = tyAt(hft)
      if hf is TyFunc {
        const rp = tyPrimNameOf(hf.fnRet)
        if (
          rp == "i32"
          || rp == "boolean"
          || rp == "f64"
          || rp == "string"
          || rp == "i64"
          || rp == "f32"
        ) {
          return sigKeyOfTy(hft)
        }
      }
    }
  }
  ""
}

// The interned key of a callee of type `tyIx` that names the instance's own type parameters,
// at instance `fnIx`'s binding of them, which a slot two instances share cannot name; "" else.
function cloInstanceSigKey(tyIx: i32, fnIx: i32): string {
  if tyIx < 0 || !tyHasTyVar(tyIx) { return "" }
  const ik = sigKeyOfTy(instanceTyOf(tyIx, fnIx))
  if ik == "" || cloSigPosOfKey(ik) < 0 { return "" }
  ik
}

// The key of an indexed callee `ix` (`fs[i]`) over a list of function values whose own arena
// type is `tyIx`; "" when its receiver is no such list or no resolver answers.
function cloIndexCalleeSigKey(ix: i32, tyIx: i32, fnIx: i32): string {
  const cre = nodeAt(ix)
  if cre is Index {
    if exprRefArray(cre.idxArr, fnIx) {
      // A literal whose elements are lifted lambdas of one signature is keyed by it, as a
      // lambda called in place is: the slot's name-rendered key disagrees with it at a
      // literal union or a niche (D2552).
      const efk = cloArrElemSelfKey(cre.idxArr, fnIx)
      if efk != "" { return efk }
      // An element read at the instance's type parameters (D7142).
      const ik = cloInstanceSigKey(tyIx, fnIx)
      if ik != "" { return ik }
      const k = arrSlotSigKeyOf(cre.idxArr, fnIx)
      if k != "" {
        // The slot's key is rendered from the element's name, which spells a union arm by
        // its field set; the arena key names the arm's row. Overrides only an un-interned
        // key with an interned one, as the `Ident` resolver does (D3108).
        if cloSigPosOfKey(k) < 0 {
          const iak = sigKeyOfTy(tyIx)
          if iak != "" && iak != k && cloSigPosOfKey(iak) >= 0 { return iak }
        }
        return k
      }
    }
  }
  ""
}

// The one signature key of every function named by the literal initializing the `const` list
// `arr` reads; "" when an element is not a function name or two keys differ.
function cloPinnedListElemKey(arr: i32, fnIx: i32): string {
  const ax = unwrapParen(arr)
  if ax < 0 || !(nodeAt(ax) is Ident) { return "" }
  const d = identDeclOf(ax)
  if d < 0 || d >= P.nodes.length { return "" }
  const dn = nodeAt(d)
  if !(dn is LetDecl) || dn.letKw != "const" || dn.letInit < 0 { return "" }
  const lit = nodeAt(dn.letInit)
  if !(lit is ArrayLit) || lit.arrElems.length == 0 { return "" }
  let k = ""
  for e in lit.arrElems {
    if !(nodeAt(e) is Ident) { return "" }
    const fe = fnIndexOfAt(sidOfNode(e), fnIx, e)
    if fe < 0 { return "" }
    const ek = cloSigKeyExt(fe)
    if ek == "" || (k != "" && ek != k) { return "" }
    k = ek
  }
  if cloSigPosOfKey(k) < 0 { return "" }
  k
}

// The indexed initializer of the un-annotated binding the callee `ix` reads, -1 when it reads
// anything else.
function cloElemCopyInitOf(ix: i32): i32 {
  const d = identDeclOf(ix)
  if d < 0 || d >= P.nodes.length { return -1 }
  const n = nodeAt(d)
  if n is LetDecl {
    if n.letType >= 0 || n.letInit < 0 { return -1 }
    const ii = unwrapParen(n.letInit)
    if ii >= 0 && nodeAt(ii) is Index { return ii }
  }
  -1
}

// The interned `$fnsig` key of a `.map`/`.filter` callback that is a closure value — a
// function-typed param or binding (`xs.map(f)` with `f: (i32) => i32`), not a literal
// lambda / named function (those resolve a lifted `mfCallbackFe`). "" otherwise. Lets a
// higher-order function forward a runtime callback to `.map`.
export function mfCallbackCloKey(cbIx: i32, fnIx: i32) {
  const cb = nodeAt(unwrapParen(cbIx))
  if cb is Ident {
    if cbIdentNamesFn(cbIx, fnIx) {
      return "" // a named fn — uses the lifted-fe path
    }
    return calleeCloSigKeyOfRead(unwrapParen(cbIx), fnIx)
  }
  // Any other plain function-valued expression is a closure value of its own type (D9072).
  if !(cb is FuncDecl) && fnValuePlain(cbIx, 0) {
    const k = sigKeyOfTy(nodeTyIxOf(unwrapParen(cbIx)))
    if k != "" && cloSigPosOfKey(k) >= 0 { return k }
  }
  ""
}

// Whether the identifier callback `cbIx` read in frame `fnIx` names a lifted function, rather
// than a parameter, binding or capture that shadows a function of the same name (D9110).
export function cbIdentNamesFn(cbIx: i32, fnIx: i32): boolean {
  const x = unwrapParen(cbIx)
  if x < 0 { return false }
  const cb = nodeAt(x)
  if !(cb is Ident) { return false }
  fnIndexOfInScopeAt(sidOfNode(x), cb.identName, fnIx, x) >= 0
}

// Whether building the value of `ix` runs no `.map` / `.filter` of its own over the caller's
// scratch frame: a function name, a lambda, a field of a name, an `if` with an `else` whose
// arms are such values, or a call of such a value (not a method) with such arguments.
export function fnValuePlain(ix: i32, depth: i32): boolean {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length || depth > 8 { return false }
  const n = nodeAt(x)
  if n is Ident || n is FuncDecl { return true }
  if n is Member { return nodeAt(unwrapParen(n.memObj)) is Ident }
  if n is Call {
    const f = unwrapParen(n.callFn)
    if f < 0 || nodeAt(f) is Member || !fnValuePlain(f, depth + 1) {
      return false
    }
    for a in n.callArgs {
      if !fnValuePlain(a, depth + 1) { return false }
    }
    return true
  }
  if !(n is IfStmt) || n.ifElse < 0 { return false }
  for arm in [n.ifThen, n.ifElse] {
    const a = nodeAt(arm)
    let v = arm
    if a is Block {
      if a.blkStmts.length != 1 { return false }
      v = a.blkStmts[0]
    }
    if !fnValuePlain(v, depth + 1) { return false }
  }
  true
}

// The union a union-box list at slot `slot` holds when the list's own type is `listTy`. Slots
// dedup by rep, so the slot's union may be a generic's spelling of the box (`S | T`); a list
// whose own element type is closed reads under the row that type keys to (D10931).
export function rlUnionNameOfTy(slot: i32, listTy: i32): string {
  const et = tyArrayElemIx(listTy)
  if et >= 0 && !tyHasTyVar(et) && tyHasTyVar(rlElemTyIxAt(slot)) {
    const r = unRowOfKey(et)
    if r >= 0 { return unNames[r] }
  }
  rlElemName[slot]
}

// The value-union name of an index read `xs[0]` whose receiver is a ref list with a
// union-box element (kind 2), or "" otherwise. The index twin of `memberUnionFieldNameRead`
// — the one gate every index narrowing channel asks before minting a key, so the push side
// and the read side cannot disagree about which cells hold a box.
export function indexElemUnionName(idxIx: i32, fnIx: i32) {
  const slot = indexElemUnionSlot(idxIx, fnIx)
  if slot < 0 { return "" }
  rlElemName[slot]
}

function indexElemUnionSlot(idxIx: i32, fnIx: i32): i32 {
  const e = nodeAt(unwrapParen(idxIx))
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot >= 0 && slot < rlElemKindTbl.length {
        if rlElemKindTbl[slot] == RLK_UNION { return slot }
      }
    }
  }
  -1
}

// The ref-list slot of the receiver of `xs[0]` when its element is a nullable ref list, else -1.
function indexElemNulRefArraySlot(idxIx: i32, fnIx: i32): i32 {
  const ix = unwrapParen(idxIx)
  if ix < 0 { return -1 }
  const e = nodeAt(ix)
  if e is Index {
    if exprNullableRefArray(ix, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if (
        slot >= 0
        && slot < rlElemName.length
        && rlElemNullable[slot] == 1
        && rlElemKindTbl[slot] == RLK_REF_LIST
      ) {
        return slot
      }
    }
  }
  -1
}

// The mv slot of a bare map read `m[1]` whose value reads back as a reference, or -1. The
// three scalar-backed value kinds are excluded (11 f64, 10 i64, 13 f32): `emitMapGet`'s
// miss arm yields `ref.null` for every other kind, so a guard can prove the read present,
// while those three miss as a numeric zero with no null to recover from.
export function mapReadNarrowableSlot(idxIx: i32, fnIx: i32) {
  const mrs = mapReadMvSlot(idxIx, fnIx)
  if mrs < 0 || mrs >= mvValKind.length { return -1 }
  const k = mvValKind[mrs]
  if k == MVK_I64 || k == MVK_F64 || k == MVK_F32 { return -1 }
  mrs
}

// The value-atom kind a bare map read `m[1]` unboxes to, or -1 for "keeps its rep". Answers
// only for a union-box value (kind 2) whose index place is narrowed to one value atom — the
// one producer both the read (`emitNarrowedMapReadTail`) and every classifier that must stop
// calling it a box ask, so the two cannot disagree about which reads the lowering already opened.
export function mapReadNarrowedAtomKind(exprIx: i32, fnIx: i32) {
  const mrs = mapReadNarrowableSlot(exprIx, fnIx)
  if mrs < 0 { return -1 }
  if mvValKind[mrs] != MVK_UNION { return -1 }
  const ak = idxNarrowAtomKind(exprIx, fnIx)
  if ak < 0 || ak == 6 { return -1 }
  ak
}

// True when a bare map read `m[1]` unboxes to a CONTAINER arm — a map or a ref-element array
// — because its index place is narrowed to one. `mapReadNarrowedAtomKind`'s twin: neither
// container is a value atom, so that question answers -1 for both, and a classifier reading
// only it calls the read a box while the lowering delivers the container (D1866).
export function mapReadNarrowedContainer(exprIx: i32, fnIx: i32): boolean {
  const mrs = mapReadNarrowableSlot(exprIx, fnIx)
  if mrs < 0 { return false }
  if mvValKind[mrs] != MVK_UNION { return false }
  placeReadContainerAt(exprIx, fnIx) > 0
}

// The type the expression `exprIx` has at the pin of the instance `fnIx` is, or is lifted
// inside, when its recorded type names a type parameter or a hole; -1 anywhere else.
export function instanceOperandTyOf(exprIx: i32, fnIx: i32): i32 {
  const e = exactOperandTyOf(exprIx, fnIx)
  if e >= 0 { return e }
  const h = holeOperandTyOf(exprIx, fnIx)
  if h >= 0 { return h }
  const ax = unwrapParen(exprIx)
  if ax < 0 { return -1 }
  pinSubOperandTyOf(nodeTyIxOf(ax), fnIx)
}

export function forInElemKind(iterIx: i32, fnIx: i32): VKind | null {
  // A narrowed union arm iterates the arm's elements, not the literal's own values: for
  // `type K = string | K[]`, `if c is K[]` narrows to a list of boxes, while the plain
  // classifiers would type the temp as a string list (check-clean invalid wasm, D1015).
  if nodeAt(iterIx) is Ident {
    const fiNt = readNarrowedTyAt(iterIx, fnIx)
    // A literal union's element is an atom, never a box (D4907).
    const fiEl = tyStepElem(fiNt)
    if fiEl >= 0 && !tyIsLitUnionArray(fiNt) && unRowOfKey(fiEl) >= 0 {
      return "union"
    }
  }
  const e = nodeAt(iterIx)
  if e is Call {
    if e.callFn < 0 { return null }
    const callee = nodeAt(e.callFn)
    if callee is Member {
      if exprMap(callee.memObj, fnIx) {
        // A map's keys bind at the key's kind: string for the string-keyed rep, i32 or i64
        // for the integer-keyed ones. A Set's `.values()` yields its elements, asking the same
        // question — the two `"str"` answers below are the string-keyed half of a triple.
        const kk = mapShapeOfExpr(callee.memObj, fnIx)
        if callee.memProp == "keys" { return mapKeyElemVKind(kk) }
        if callee.memProp == "values" {
          if kk == -5 { return "i32" }
          if kk == -7 { return "i64" }
          // A set's `.values()` yields its elements — the string keys (kind 3), not the
          // i32 membership booleans. A map's yields its values: i32 for the mono map, the
          // value's kind for a ref-valued map.
          if mapIsSetExpr(callee.memObj, fnIx) { return "str" }
          return mapValElemKind(callee.memObj, fnIx)
        }
      }
    }
  }
  // A bare map iterable (`for k in m`) iterates its keys — like `m.keys()`: string for
  // the string-keyed rep (kind 3), i32 for the i32-keyed one.
  if exprMap(iterIx, fnIx) {
    return mapKeyElemVKind(mapShapeOfExpr(iterIx, fnIx))
  }
  // A `(string | null)[]` — the string-ref niche list. Its backing is a plain string list,
  // but the element slot is nullable, so the loop var binds the nullable string (kind 16),
  // exactly as `const e = xs[i]` does. Checked before `exprStringArray`, which would claim
  // the same backing for a non-null element and trap on a stored null.
  if exprNulStrArray(iterIx, fnIx) { return "nulstr" }
  // …and so does a list whose recorded element is a type parameter pinned there (D3015).
  if tyIsNulPrim(iterElemPinTy(iterIx, fnIx), "string") { return "nulstr" }
  if exprStringArray(iterIx, fnIx) { return "str" }
  // A struct-element ref list (`S[]`): the element is a struct ref, so bind the loop var
  // as a code-1 struct local. (Union-box (2) / map-array ref lists aren't wired here yet.)
  if exprRefArray(iterIx, fnIx) {
    // Bound-guarded, since `refListSlotOfExpr` doesn't answer -1 on a miss — it clamps to
    // 0, so a miss is indistinguishable from slot 0, and with no ref list interned at all
    // `rlElemKindTbl` is empty: an unguarded read is `wasm trap: out of bounds array
    // access` from inside the compiler, not a diagnostic (D179).
    const rslot = refListSlotOfExpr(iterIx, fnIx)
    if rslot < 0 || rslot >= rlElemKindTbl.length {
      // A box-element list built at its destination's row names no row of its own spelling.
      if tyIsValueUnionBox(tyArrayElemIx(nodeTyInOf(iterIx, fnIx))) {
        return "union"
      }
      return null
    }
    if rlElemKindTbl[rslot] == RLK_STRUCT {
      // A nullable-struct element ref list (`(P | null)[]`): the loop var binds as a
      // kind-9 niche, its read staying nullable (no `ref.as_non_null`); plain `S[]` is kind 1.
      // A nullable union arm (`(Circle | null)[]`) has no struct row, so it binds the
      // `nulvariant` niche over the arm's heap, as `const e = xs[i]` does (D3096).
      if rlElemIsNulNiche(rslot) {
        if rlElemVariantRow(rslot) >= 0 { return "nulvariant" }
        return "nulstruct"
      }
      // An arm-element ref list (`Circle[]` where `Circle` is a declared union member): the
      // loop var binds as the kind-8 variant local over `uVarHeap[vi]`, since
      // `structIdxOfElemName`'s nominal floor declines an arm (D50).
      if rlElemVariantRow(rslot) >= 0 { return "variant" }
      return "struct"
    }
    // A union-box element ref list (`(C | S)[]`, kind 2): the loop var binds as a kind-4
    // union-box local (the element-kind code IS the loop-var local kind, as struct's `1` is),
    // so `for x in arr { … x is S … }` narrows each element. The `#l` temp is the ref-list
    // wrapper (code 5), same as the struct case.
    if rlElemKindTbl[rslot] == RLK_UNION { return "union" }
    // A nested-array element ref list (`i32[][]`/`string[][]`/`f64[][]`/`i64[][]`): the
    // loop var binds the inner list — a list local of kind 2/7/12/20. The element read is
    // a ref (the inner wrapper, recovered non-null); the `#l` temp is the outer wrapper.
    if rlElemKindTbl[rslot] == RLK_I32_LIST {
      // A `(i32[] | null)[]` keeps the `| null` in its element slot, so the loop var is
      // the kind-15 nullable list — the same rep `exprNullableList`'s kind-4 arm binds.
      if rlElemIsNulNiche(rslot) { return "nullist" }
      return "list"
    }
    // The four distinct-backing inner lists (`string[][]` 6 / `f64[][]` 7 / `i64[][]` 8 /
    // `f32[][]` 10). A `(T[] | null)[]` element keeps `| null` in its slot exactly as the
    // kind-4 niche above, so the loop var is the matching nullable-list kind.
    if rlElemKindTbl[rslot] == RLK_STR_LIST {
      if rlElemIsNulNiche(rslot) { return "nulstrlist" }
      return "strlist"
    }
    if rlElemKindTbl[rslot] == RLK_F64_LIST {
      if rlElemIsNulNiche(rslot) { return "nulf64list" }
      return "f64list"
    }
    if rlElemKindTbl[rslot] == RLK_I64_LIST {
      if rlElemIsNulNiche(rslot) { return "nuli64list" }
      return "i64list"
    }
    if rlElemKindTbl[rslot] == RLK_F32_LIST {
      if rlElemIsNulNiche(rslot) { return "nulf32list" }
      return "f32list" // f32-inner list -> an f32-list local (kind 21)
    }
    if rlElemKindTbl[rslot] == RLK_U8_LIST {
      if rlElemIsNulNiche(rslot) { return "nulu8list" }
      return "u8list" // u8-inner list -> a packed-byte-list local
    }
    // A closure-element ref list (`((i32) => i32)[]`, element kind 5): the loop var binds a
    // kind-14 closure recovered non-null, the `#l` temp the ref-list wrapper (code 5). A
    // `(F | null)[]` element binds the nullable niche instead, since recovering it would trap
    // on the null the body means to test.
    if rlElemKindTbl[rslot] == RLK_CLOSURE {
      if rlElemIsNulNiche(rslot) { return "nulclosure" }
      return "closure"
    }
    // A nested ref array (`S[][]`/`(C|D)[][]`/`S[][][]`, element kind 9): the loop var
    // binds the inner ref list — a kind-5 ref-list local carrying the inner slot,
    // recursing (the inner slot may itself be kind 9). A `(S[] | null)[]` element is the
    // kind-18 nullable ref list, the same niche rule.
    if rlElemKindTbl[rslot] == RLK_REF_LIST {
      if rlElemIsNulNiche(rslot) { return "nulreflist" }
      return "reflist"
    }
    // A map element (`{[K]: V}[]`, element kind 3): the loop var binds a map local over the
    // element's shape, and a `({[K]: V} | null)[]` element the nullable-map niche.
    if rlElemKindTbl[rslot] == RLK_MAP {
      if rlElemIsNulNiche(rslot) { return "nulmap" }
      return "map"
    }
    return null
  }
  // An f64 element list (`f64[]`): the loop var binds as a scalar f64 local (code 11), and
  // the `#l` temp is the f64-list (code 12), recognized through `exprF64Array` so an
  // `f64[]`-returning call iterates too. An f32 element list (`f32[]`) binds a scalar f32
  // local (code 13). Both checked before the i32 default.
  if exprF32Array(iterIx, fnIx) { return "f32" }
  if exprF64Array(iterIx, fnIx) { return "f64" }
  // An i64 element list (`i64[]`): the loop var binds as a scalar i64 local (code 10), and
  // the `#l` temp is the i64-list (code 20).
  if exprI64Array(iterIx, fnIx) { return "i64" }
  // A packed byte list (`u8[]`): each element reads as an i32 (`array.get_u` zero-
  // extends), so the loop var is the plain i32 code — the one-byte storage lives entirely
  // in the `#l` temp (`forInU8Src`). Asked explicitly rather than left to the i32 default,
  // since `exprArray` claims a `u8[]` in only some storage classes.
  if exprU8Array(iterIx, fnIx) { return "i32" }
  // A STRING iterable (`for ch in s`): each code unit is an i32 (loop-var code 0, same as an
  // `i32[]`), but the source is the RAW i32 array — the `#l` temp is the string itself (code 3),
  // and the length/element reads skip the list-wrapper `struct.get`. `forInStringSrc` flags it
  // at the temp-kind and emit sites. Checked before `exprArray` (a string is not an i32 list).
  if exprString(iterIx, fnIx) { return "i32" }
  if exprArray(iterIx, fnIx) {
    // A `null[]` walks the i32 list, but its loop var is the `null` unit cell, never written.
    if arrElemIsNullUnitAt(iterIx, fnIx) { return "nulnone" }
    return "i32"
  }
  return null
}

// True when a `for v in <iter>` walks a map's ordered vals list (field 1) rather than its
// keys list (field 0) — a `.values()` call on a map that isn't a set (a set's `.values()`
// yields its elements, in the keys list instead). Paired with `forInMapRecv`, so the field
// a walk reads and the type its loop var binds can never disagree.

export function forInMapWalksVals(iterIx: i32, fnIx: i32) {
  const e = nodeAt(iterIx)
  if e is Call {
    if e.callFn < 0 { return false }
    const callee = nodeAt(e.callFn)
    if callee is Member {
      if callee.memProp == "values" {
        if exprMap(callee.memObj, fnIx) {
          return !mapIsSetExpr(callee.memObj, fnIx)
        }
      }
    }
  }
  false
}

// The mv slot of a `for v in m.values()` walk over a ref-valued map, or -1 (not a
// map walk / a mono map / a set). The values walk then types its loop var + list
// temp off the slot's value type instead of a ref-array's element.
export function forInMapValsSlot(iterIx: i32, fnIx: i32) {
  if !forInMapWalksVals(iterIx, fnIx) { return -1 }
  // A MONO-value map interns no slot — its shape is one of the negative sentinels
  // (`-1` mono, `-4` i32-keyed mono), and every one of them answers "no slot" here.
  const sl = mapShapeOfExpr(forInMapRecv(iterIx, fnIx), fnIx)
  if sl < 0 { return -1 }
  sl
}

// The kind a map's VALUE binds at, for both spellings that walk one: `for v in m.values()`
// and the second name of `for k, v in m`. ONE ladder, or the two spellings agree about the
// value's type and disagree about its rep, which is invalid wasm rather than a diagnostic.
export function mapValElemKind(mapObjIx: i32, fnIx: i32): VKind | null {
  const vsl = mapShapeOfExpr(mapObjIx, fnIx)
  if vsl >= 0 {
    if mvValKind[vsl] == MVK_STR {
      // A nullable string value (`{[string]: string | null}`) rides the same kind-3
      // vals list as its non-null twin (the element slot is nullable either way), so
      // only the loop var differs: the `string | null` niche, exactly as `const v =
      // m[k]` binds — the non-null `"str"` var would trap on a stored null.
      if mvSlotNullable(vsl) { return "nulstr" }
      return "str" // string value
    }
    if mvValKind[vsl] == MVK_F64 {
      return "f64" // f64 value (scalar local)
    }
    if mvValKind[vsl] == MVK_I64 {
      return "i64" // i64 value (scalar local)
    }
    if mvValKind[vsl] == MVK_F32 {
      return "f32" // f32 value (scalar local)
    }
    if mvValKind[vsl] == MVK_CLOSURE {
      return "closure" // closure value (`{[string]: (i32) => i32}` — loop var calls each)
    }
    // A list value (`{[string]: i32[]}` / `S[]` …): the loop var binds the inner
    // value list's own rep (`mvListValKind`), exactly as a nested-array `for row in
    // g` does. A nullable list value rides the same vals list as its non-null twin,
    // so only the loop var differs — the niche kind, mirroring `nulstr`/`nulstruct`.
    if mvValKind[vsl] == MVK_REF {
      // A nested-map value (`{[K]: {[K2]: V}}`) rides the same kind-6 vals list with a map
      // element, and binds the map local its own `m[k]` read binds (D2515).
      if mvValIsMap(vsl) {
        if mvSlotNullable(vsl) { return "nulmap" }
        return "map"
      }
      if mvSlotNullable(vsl) { return mvNulListValKind(vsl) }
      return mvListValKind(vsl)
    }
    // A union-box value (`{[string]: i32 | null}`, `{[string]: C | S}`): the vals
    // element IS `$uBox`, so the loop var binds as a kind-4 union-box local.
    if mvValKind[vsl] == MVK_UNION { return "union" }
    // A nullable-struct value (`{[string]: S | null}`) rides the same kind-1 vals
    // list as its non-null twin; the loop var is the kind-9 niche instead.
    if mvSlotNullable(vsl) { return "nulstruct" }
    // A union-arm value (`{[string]: Circle}` where `Circle` is a declared union
    // member): the loop var is the kind-8 variant local, not struct — the arm's
    // layout lives in `uVarHeap`, since `collectS` skips a union member (D50).
    if mvValVariantOf(vsl) >= 0 { return "variant" }
    return "struct" // struct value
  }
  // A `null`-valued map rides the mono map; its value is the `null` cell, never read.
  if mapTyValIsNullUnit(mapRecvTyIn(mapObjIx, fnIx)) { return "nulnone" }
  return "i32"
}

// The kind a `for`'s SECOND name binds at. A sequence's companion is its INDEX (an i32
// counter of body executions), a map's is the VALUE at the key just bound. A set is a
// sequence here, not a map: its `vals` holds membership booleans nobody wrote.
export function forInPairElemKind(iterIx: i32, fnIx: i32): VKind | null {
  if !forInPairIsMapVal(iterIx, fnIx) { return "i32" }
  mapValElemKind(iterIx, fnIx)
}

// Whether a `for`'s SECOND name binds a map VALUE rather than a sequence index. One
// predicate, read by the collect pass and the emitter alike.
export function forInPairIsMapVal(iterIx: i32, fnIx: i32) {
  if !exprMap(iterIx, fnIx) { return false }
  !mapIsSetExpr(iterIx, fnIx)
}

// The interned vals slot a `for k, v in m` walks — the same one `.values()` walks, without
// the call spelling. Negative for a mono-value map, whose vals list is the plain i32 list.
export function forInPairValsSlot(iterIx: i32, fnIx: i32) {
  if !forInPairIsMapVal(iterIx, fnIx) { return -1 }
  mapShapeOfExpr(iterIx, fnIx)
}

// The companion slot the second name binds: the struct row of a struct value, or the inner
// shape of a nested-map value — the resolution `forInVarStructIdx` performs for `.values()`.
export function forInPairStructIdx(iterIx: i32, fnIx: i32): i32 {
  const vsl = forInPairValsSlot(iterIx, fnIx)
  if vsl < 0 { return -1 }
  if mvValVariantOf(vsl) >= 0 { return -1 }
  if mvValKind[vsl] == MVK_STRUCT { return mvValStructIdxOf(vsl) }
  if mvValIsMap(vsl) { return mvInnerMapShape(vsl) }
  const lk = mvListValKind(vsl)
  if lk == "reflist" { return mvValInnerRlSlotAt(vsl) }
  -1
}

// The element struct table index of a `for v in <S[]>` iterable (the struct that the
// code-1 loop var binds), or -1 when the iterable is not a struct ref list. Mirrors
// the index-read resolution (`structIndexOfExpr` over `xs[i]`): the element name comes
// from the ref-list slot, then its struct table index.
export function forInRefArrayStructIdx(iterIx: i32, fnIx: i32) {
  const mvs = forInMapValsSlot(iterIx, fnIx)
  if mvs >= 0 {
    // An ARM-valued map's `.values()` walk has no STRUCT row to bind (D34) — the loop var's
    // layout lives in the variant table, and this resolver's contract is a struct index. It
    // declines rather than handing back a row from the other namespace.
    if mvValVariantOf(mvs) >= 0 { return -1 }
    if mvValKind[mvs] == MVK_STRUCT { return mvValStructIdxOf(mvs) }
    return -1
  }
  if !exprRefArray(iterIx, fnIx) { return -1 }
  // Strip a `| null` niche suffix (`(P | null)[]` → "P") so the nullable-struct loop var
  // carries P's struct index.
  structIdxOfElemName(refListElemNameOfExpr(iterIx, fnIx))
}

// The variant row of the same loop var — `forInRefArrayStructIdx`'s storage-class twin,
// built arm for arm against it (D50): an arm-valued map's `.values()` walk (the row the
// struct half declines) and an arm-element ref list (the row `structIdxOfElemName`'s
// nominal floor declines, via `rlElemVariantRow`). Both halves already existed as declines.
export function forInRefArrayVariantIdx(iterIx: i32, fnIx: i32) {
  const mvs = forInMapValsSlot(iterIx, fnIx)
  if mvs >= 0 { return mvValVariantOf(mvs) }
  if !exprRefArray(iterIx, fnIx) { return -1 }
  rlElemVariantRow(refListSlotOfExpr(iterIx, fnIx))
}

// The companion table slot of a `for-in` loop variable's cell — paired with `addLocalSlot`
// the same way `declareForInLocals` does (lifted out of it, D1142, since a captured loop
// var needs the same pair for its closure env field). -1 for every kind needing no slot —
// the scalars, the leaf scalar lists, `str`/`nulstr`/`list`/`u8list`/`union`/`closure`.
export function forInVarStructIdx(iterIx: i32, fnIx: i32): i32 {
  match forInElemKind(iterIx, fnIx) {
    "struct" | "nulstruct" => {
      return forInRefArrayStructIdx(iterIx, fnIx)
    }
    "variant" | "nulvariant" => {
      return forInRefArrayVariantIdx(iterIx, fnIx)
    }
    // A nested ref array (`S[][]`): the loop var is the inner ref list, off the outer
    // list's element slot.
    "reflist" | "nulreflist" => {
      return rlElemInnerSlot(refListSlotOfExpr(iterIx, fnIx))
    }
    // A map element or a nested-map value: the loop var's map shape, off the vals slot of a
    // `.values()` walk or the element slot of a map list.
    "map" | "nulmap" => {
      const mvs = forInMapValsSlot(iterIx, fnIx)
      if mvs >= 0 { return mvInnerMapShape(mvs) }
      const rs = refListSlotOfExpr(iterIx, fnIx)
      if rs < 0 || rs >= rlElemKindTbl.length { return -1 }
      return rlElemMapShape(rs)
    }
    // Every other element kind, and no element kind, carries no row.
    "i32" | "list" | "str" | "union" | "strlist" | "i64" | "f64" | "f64list" | "f32" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulclosure" | "i64list" | "f32list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulnone" | "u8list" | "v128" | null => {}
  }
  -1
}

// True if the map-typed expression at `exprIx` is a set at either key rep (shape -2 or -5,
// D2314). Consulted by the `.values()` paths: a set's `.values()` yields its elements (the
// keys list), not the membership booleans in `vals` — mirroring the checker (`typecheck.vl`:
// a set's values() returns `mKey[]`).
function mapIsSetExpr(exprIx: i32, fnIx: i32) {
  const sh = mapShapeOfExpr(exprIx, fnIx)
  sh == -2 || sh == -5 || sh == -7
}

// The value type of map type `ty`, or of the one map member of union type `ty` (a `| null`
// peeled); -1 for a hole, or a union with no map member or with two.
function unionMapArmValTyOf(ty: i32): i32 {
  const u = tyPeelNul(ty)
  if u < 0 { return -1 }
  const own = tyMapValOf(u)
  if own >= 0 { return own }
  const t = tyAt(u)
  if !(t is TyUnion) { return -1 }
  let found = -1
  for m in t.uMembers {
    if tyMapValOf(m) >= 0 {
      if found >= 0 { return -1 }
      found = tyMapValOf(m)
    }
  }
  found
}

// The mv slot a map READ expression resolves to: `m[k]` (Index over a ref-valued map) or
// `m.get(k)` (the method form), else -1. The chokepoint the expression-kind resolvers
// (`exprString` / struct resolution / `??` lowering) consult so a ref-valued `m[k] ?? d`
// classifies as its value type.
function mapReadMvSlot(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = nodeAt(exprIx)
  match e {
    Index => {
      if exprMap(e.idxArr, fnIx) {
        const sl = mapShapeOfExpr(e.idxArr, fnIx)
        if sl >= 0 { return sl }
        return -1
      }
      // Narrowing-blind fallback: `t0[k]` where `t0` is a union ident with a map arm. In the
      // frame pre-pass the `is`-narrow that would make `t0` a map isn't active, so `exprMap`
      // misses — resolve the arm's value mv slot directly.
      const ax = nodeAt(unwrapParen(e.idxArr))
      if ax is Ident {
        // A read the checker narrowed to the array or `string` arm is no map read, whether the
        // narrow names an alias or its spelled-out twin; a `string` index reads a char (D1012).
        const d12t = readNarrowedTyAt(unwrapParen(e.idxArr), fnIx)
        if tyIsArray(d12t) || tyPrimNameOf(d12t) == "string" { return -1 }
        const aun = unionNameOfRead(unwrapParen(e.idxArr), fnIx)
        if aun != "" {
          // The arm's arena type comes back with its spelling: the value slot resolves off
          // the `TyMap` the member scan already read, rather than re-slicing `V` from the render.
          // A row the scan does not cover asks the receiver's own type instead.
          const armTy: i32[] = []
          const ma = unionMapArmNameTy(aun, armTy)
          if ma != "" {
            let maVt = -1
            if armTy.length > 0 {
              maVt = tyMapValOf(armTy[0])
            } else {
              maVt = unionMapArmValTyOf(nodeTyIxOf(unwrapParen(e.idxArr)))
            }
            const msl = mvSlotOfMapNameTy(ma, maVt)
            if msl >= 0 { return msl }
          }
        }
      }
      return -1
    }
    Call => {
      if e.callFn < 0 { return -1 }
      const callee = nodeAt(e.callFn)
      if callee is Member {
        if callee.memProp == "get" {
          if exprMap(callee.memObj, fnIx) {
            const sl = mapShapeOfExpr(callee.memObj, fnIx)
            if sl >= 0 { return sl }
          }
        }
      }
    }
    // No other expression is a map read.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// The mv slot of a `lhs ?? d` read-with-default over a ref-valued map, else -1. Parens are
// peeled on both the whole expression and the LHS so `(m[k]) ?? d` classifies identically
// to the bare form — must agree with the `??` emit, which also peels parens, else a
// parenthesized string/f64/struct map-get keeps its real type but routes as i32.
function coalesceMvSlot(exprIx: i32, fnIx: i32) {
  const e = nodeAt(unwrapParen(exprIx))
  if e is BinExpr {
    if e.binOp == "??" {
      if coalesceMapReadJoins(exprIx, fnIx) { return -1 }
      return mapReadMvSlot(unwrapParen(e.binLeft), fnIx)
    }
  }
  -1
}

// Whether `m[k] ?? d` is typed as a union box that the map's value type is not, because `d` is
// another arm of it. The read is then a nullable operand like any other, and the fused
// read-with-default, which builds `d` at the value's own rep, does not apply (D4643).
export function coalesceMapReadJoins(exprIx: i32, fnIx: i32): boolean {
  const ix = unwrapParen(exprIx)
  if ix < 0 || ix >= P.nodes.length { return false }
  const e = nodeAt(ix)
  if !(e is BinExpr) || e.binOp != "??" { return false }
  const recv = fusedMapReadRecvIx(unwrapParen(e.binLeft))
  if recv < 0 || !exprMap(recv, fnIx) { return false }
  // A default an atom-valued map's read cannot hold joins it to `string` (D7448).
  if nodeTyIsMap(recv) && coalMapReadForeignDefault(recv, e.binRight, fnIx) {
    return true
  }
  if !coalesceResultIsBox(ix) { return false }
  const vt = tyPeelNul(tyMapValOf(mapRecvTyIn(recv, fnIx)))
  if vt < 0 { return false }
  !tySameSet(vt, tyPeelNul(nodeTyPinIxOf(ix)), TY_WALK_DEPTH)
}

// The one nullability decision for the `??` reps: a non-null default collapses to the
// non-null rep, a nullable one leaves `T | null`. A hole's read off a map its instance pins is
// `V | null` whatever the template recorded. Structural in the chain, never banked, since a
// re-associated `p ?? q ?? r` mints an untyped inner node.
export function coalesceDefaultNullable(defIx: i32, fnIx: i32): boolean {
  if defIx < 0 { return false }
  const dix = unwrapParen(defIx)
  if dix < 0 { return false }
  const d = nodeAt(dix)
  match d {
    NullLit => {
      return true
    }
    BinExpr => {
      if d.binOp == "??" { return coalesceDefaultNullable(d.binRight, fnIx) }
    }
    Index => {
      if coalHoleMapReadIx(dix, fnIx) { return true }
    }
    // Any other default is nullable only by its type or its union, read below.
    NumLit | StrLit | CharLit | BoolLit | Ident | Unary | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  if nodeTyIsNullable(dix) { return true }
  // A hole the instance binds to a nullable type is nullable there.
  if tyBearsNull(holeOperandTyOf(dix, fnIx)) { return true }
  const un = unionNameOfExpr(dix, fnIx)
  if un != "" { return unionSetHasNull(un) }
  false
}

// Whether `ix` is a hole's read off a map its instance pins, `V | null` whatever the template
// recorded; false for any other node.
function coalHoleMapReadIx(ix: i32, fnIx: i32): boolean {
  if ix < 0 { return false }
  const d = nodeAt(ix)
  if !(d is Index) || nodeTyProvesNonNull(ix) { return false }
  const dt = nodeTyIxOf(ix)
  if dt < 0 || dt >= T.tys.length || !(tyAt(dt) is TyVar) { return false }
  mapRecvTyIn(d.idxArr, fnIx) >= 0
}

// Whether the last default of the `??` chain at `defIx` is a hole's map read
// (`coalHoleMapReadIx`), whose own union name is no evidence of its set.
function coalDefaultEndsInHoleMapRead(defIx: i32, fnIx: i32): boolean {
  const dix = unwrapParen(defIx)
  if dix < 0 { return false }
  const d = nodeAt(dix)
  if d is BinExpr {
    if d.binOp == "??" { return coalDefaultEndsInHoleMapRead(d.binRight, fnIx) }
    return false
  }
  coalHoleMapReadIx(dix, fnIx)
}

// True when the default of a `K | null` `??` reps as that niche's own i32 — a bare `null`,
// an atom place/field/call, another `K | null`, a member literal, or a chain (structural,
// never banked). A member literal is decided by lexeme membership (`litLexIsMember`),
// since a default-position literal carries the join's type, not a `TyLit`.
function coalesceLitUnionDefaultIsAtom(defIx: i32, texts: string[], fnIx: i32) {
  if defIx < 0 { return false }
  const dix = unwrapParen(defIx)
  if dix < 0 { return false }
  const d = nodeAt(dix)
  if d is NullLit { return true }
  if d is StrLit { return litLexIsMember(d.strText, texts) }
  if d is BinExpr {
    if d.binOp == "??" {
      if !coalesceLitUnionDefaultIsAtom(d.binLeft, texts, fnIx) { return false }
      return coalesceLitUnionDefaultIsAtom(d.binRight, texts, fnIx)
    }
  }
  exprIsLitAtom(dix, fnIx)
}

// True when `defIx`, the default of a `??` over a read off the atom-valued map `recvIx`, is a
// value that read's atom rep cannot hold, so the result is not an atom: the read is a nullable
// operand whose member decodes to its string, and a hole instance reads the map at its pin.
export function coalMapReadForeignDefault(
  recvIx: i32,
  defIx: i32,
  fnIx: i32,
): boolean {
  const texts = mapTyValLitUnionTexts(mapRecvTyIn(recvIx, fnIx))
  if texts.length == 0 { return false }
  !coalesceLitUnionDefaultIsAtom(defIx, texts, fnIx)
}

// True when the `??` at `exprIx` lowers as the `K | null` atom niche: its LHS is that
// niche and its default reps as the same i32. The default decides whether the rep
// survives at all, not just its nullability — a non-atom default (joining to `string`)
// declines here and keeps the loud reject instead of check-clean invalid wasm.
export function coalesceLitUnionFits(exprIx: i32, fnIx: i32) {
  const lhs = coalesceNicheLhs(exprIx)
  if lhs < 0 { return false }
  if !exprNulLitUnion(lhs, fnIx) { return false }
  const e = nodeAt(unwrapParen(exprIx))
  if e is BinExpr {
    // The niche's member set: its nullable spelling first, then the bare one for an LHS whose
    // banked type the narrow already collapsed.
    let lut = nodeNulLitUnionMemberTexts(lhs)
    if lut.length == 0 { lut = nodeLitUnionMemberTexts(lhs) }
    // A hole operand's members come from its pin, where the `??` there reads at the union (D3423).
    const pin = nodeTyPinIxOf(exprIx)
    if lut.length == 0 && tyIsLitUnion(pin) { lut = nulLitAtomTexts(lhs, fnIx) }
    // An instance's `??` records its generic's hole, and the operand's own members decide.
    if (
      lut.length == 0
      && fnInPinnedInstance(fnIx)
      && (pin < 0 || tyHasTyVar(pin))
    ) {
      lut = nulLitAtomTexts(lhs, fnIx)
    }
    return coalesceLitUnionDefaultIsAtom(e.binRight, lut, fnIx)
  }
  false
}

// True when the `??` at `exprIx` joins a `K | null` niche with a default outside `K`, so the
// checker typed it `string` and the present atom widens to its member string. The
// reservation scan and the emit arm both ask this (D3198).
export function coalesceNulAtomToStr(exprIx: i32, fnIx: i32): boolean {
  const e = nodeAt(unwrapParen(exprIx))
  if !(e is BinExpr) { return false }
  if e.binOp != "??" { return false }
  if coalesceLitUnionFits(exprIx, fnIx) { return false }
  if !exprNulLitUnion(e.binLeft, fnIx) { return false }
  const texts = nulLitAtomTexts(e.binLeft, fnIx)
  if texts.length == 0 { return false }
  const rt = nodeTyPinIxOf(exprIx)
  // An instance's `??` records its generic's hole, where a string default outside the set is
  // what makes the join `string`.
  if fnInPinnedInstance(fnIx) && (rt < 0 || tyHasTyVar(rt)) {
    const d = nodeAt(unwrapParen(e.binRight))
    if d is StrLit { return !litLexIsMember(d.strText, texts) }
  }
  if rt < 0 || rt >= T.tys.length { return false }
  // A nullable `string` default leaves the join `string | null` (D7448).
  const pr = tyPeelNul(rt)
  if pr < 0 { return false }
  const r = tyAt(pr)
  if r is TyPrim { return r.primName == "string" }
  false
}

// Whether the `??` at `exprIx` in the pinned instance `fnIx` reads an operand `lhsIx` the
// instance typed without `null`, at the `??`'s own type or at a numeric literal type that reps
// as its scalar: the default is dead, the fold the template's rewrite makes of a concrete one.
export function coalRetypedDead(exprIx: i32, lhsIx: i32, fnIx: i32): boolean {
  if !fnInPinnedInstance(fnIx) { return false }
  const lt = nodeTyAt(lhsIx, fnIx)
  if lt < 0 || lt >= T.tys.length || !tyProvesNonNull(lt) { return false }
  const pt = nodeTyPinIxOf(exprIx)
  if lt == pt { return true }
  if tyAt(lt) is TyPrim { return false }
  const pn = tyPrimNameOf(pt)
  pn != null && tyNumScalarBaseName(lt) == pn
}

// True when the `??` at `exprIx` sits in a generic body whose operand this instance pins to
// `string` or `i32` and whose default is of that same type: the `??` is its operand, as the
// fold makes it at a direct spelling (D3206). Any other pin or default keeps its refusal,
// since the node's own classifiers read neither the operand's rep nor the join.
export function coalesceOperandPinNonNull(exprIx: i32, fnIx: i32): boolean {
  const e = nodeAt(unwrapParen(exprIx))
  if !(e is BinExpr) { return false }
  const d = unwrapParen(e.binRight)
  if d < 0 { return false }
  // A read off a map keeps the fused lowering, which reads the stored value at its own rep
  // whatever a store before it narrowed the place to.
  const mr = fusedMapReadRecvIx(unwrapParen(e.binLeft))
  if mr >= 0 && mapRecvTyIn(mr, fnIx) >= 0 { return false }
  const pn = tyPrimNameOf(coalPinTyOf(unwrapParen(e.binLeft), fnIx))
  if pn == "string" { return exprString(d, fnIx) }
  if pn == null { return false }
  // The default may be typed at the same parameter, pinned with it (D10231).
  const dp = coalPinTyOf(d, fnIx)
  if dp >= 0 { return tyPrimNameOf(dp) == pn }
  pn == "i32" && tyPrimNameOf(nodeTyIxOf(d)) == "i32"
}

// `coalesceOperandPinTy`, else the type an instance shared between pins gives `ix` at its own.
function coalPinTyOf(ix: i32, fnIx: i32): i32 {
  const p = coalesceOperandPinTy(ix, fnIx)
  if p >= 0 { return p }
  instanceOperandTyOf(ix, fnIx)
}

// The map receiver arena index of a `for v in m.keys()` / `m.values()` iterable, or -1
// when the iterable is not a map keys/values walk. Drives the tombstone-aware skip in
// the for-in loop (the map's `live` array is consulted per entry).
export function forInMapRecv(iterIx: i32, fnIx: i32) {
  const e = nodeAt(iterIx)
  if e is Call {
    if e.callFn < 0 { return -1 }
    const callee = nodeAt(e.callFn)
    if callee is Member {
      if callee.memProp == "keys" || callee.memProp == "values" {
        if exprMap(callee.memObj, fnIx) { return callee.memObj }
      }
    }
  }
  // A bare map iterable (`for k in m`) is its own receiver — the live-skip walks it.
  if exprMap(iterIx, fnIx) { return iterIx }
  -1
}

// Whether the assignment at `asgIx` lowers as a value by storing and re-reading its target: a
// name, a captured literal-union cell (`c[0]`, which the capture rewrite leaves untyped), or
// a literal-index / field write on a named non-map place whose checked type is the assignment's.
export function assignTargetReReads(asgIx: i32, fnIx: i32): boolean {
  const a = nodeAt(asgIx)
  if !(a is BinExpr) { return false }
  if a.binOp != "=" { return false }
  const tgt = nodeAt(a.binLeft)
  let recv = -1
  match tgt {
    Ident => {
      return true
    }
    Index => {
      if !(nodeAt(tgt.idxIndex) is NumLit) { return false }
      recv = tgt.idxArr
    }
    Member => {
      recv = tgt.memObj
    }
    // No other target is a place to re-read.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {
      return false
    }
  }
  if !(nodeAt(recv) is Ident) { return false }
  if exprMap(recv, fnIx) { return false }
  const tt = nodeTyIxOf(a.binLeft)
  if tt < 0 { return tgt is Index && nodeAt(tgt.idxArr) is Ident }
  if tySame(tt, nodeTyAt(asgIx, fnIx)) { return true }
  // A binding a closure shares is its cell's slot, and its re-read is taken back to the right
  // side's rep exactly as the binding's own would be (D2557).
  const rn = nodeAt(recv)
  if tgt is Index && rn is Ident {
    if cboxReadsCell(recv) {
      // A hole lambda written there takes the cell's signature (D3857), and values of one
      // signature share a closure rep, so the cell's re-read is the value written (D3860).
      if tyAt(tt) is TyFunc && asgValueIsFunc(asgIx, fnIx) { return true }
      return asgReadUnwidenOp(asgIx, fnIx) >= 0
    }
  }
  false
}

// Whether callee name node `callFn`, read in function `fnIx`, is `tailSelfFnIx` itself. A name
// a live closure binding holds, a function-typed parameter among them, denotes that value and
// not the function of its name (D1602).
function tailCallsSelf(callFn: i32, fnIx: i32): boolean {
  const sid = sidOfNode(callFn)
  const target = fnIndexOfAt(sid, fnIx, callFn)
  const bound = identIsBoundClosure(callFn, fnIx)
  if (
    !bound
    && target >= 0
    && target < fnStmts.length
    && fnStmts[target] == tailSelfFnIx
  ) {
    return true
  }
  const cf = identClosureFeOfRead(callFn, fnIx)
  cf >= 0 && cf < fnStmts.length && fnStmts[cf] == tailSelfFnIx
}

// True if the statement at `stmtIx` is a bare value expression usable as an implicit
// return — no `return` keyword needed. Recognized: literals, an identifier, a unary, a
// non-assignment `BinExpr`, a paren, a member/index access, an `is` guard, an
// object/array literal, and a value-returning call — not a void member-call or `.push`.
export function stmtIsTailValue(stmtIx: i32, fnIx: i32) {
  const s = nodeAt(stmtIx)
  // A bare lambda tail `(a) => (b) => …` is an implicit-return VALUE (a closure), so the
  // outer arrow's body — `(b) => …` — emits as the function's result. Without this the tail
  // is mis-read as a statement, the body emits nothing, and the function is just `unreachable`.
  match s {
    FuncDecl => {
      return true
    }
    NumLit => {
      return true
    }
    // A trailing `null` is an implicit-return value (the function returns null) — seeded
    // per the return type by `emitReturnValue`, the same as `return null`.
    NullLit => {
      return true
    }
    StrLit => {
      return true
    }
    CharLit => {
      return true
    }
    BoolLit => {
      return true
    }
    Ident => {
      return true
    }
    Unary => {
      return true
    }
    // A parenthesised call is that call, which may be a void statement (D2637).
    Paren => {
      if nodeAt(unwrapParen(stmtIx)) is Call {
        return stmtIsTailValue(unwrapParen(stmtIx), fnIx)
      }
      return true
    }
    Member => {
      return true
    }
    // A `?.` read yields its field or null, so it is a value wherever it ends an arm.
    OptMember => {
      return true
    }
    Index => {
      return true
    }
    IsExpr => {
      return true
    }
    AsExpr => {
      return true
    }
    ObjLit => {
      return true
    }
    ArrayLit => {
      return true
    }
    BinExpr => {
      if s.binOp == "=" {
        // A trailing assignment is a tail value — assignment yields its right side (DECISIONS:
        // assignment-as-expression): re-read where `assignTargetReReads` can, and any other
        // field or element write is rewritten by `spillTail` to yield its spilled value (D2496).
        if assignTargetReReads(stmtIx, fnIx) { return true }
        return assignTargetSpills(stmtIx)
      }
      return true
    }
    Call => {
      // A value-returning call `f(..)` is a tail value; a `recv.push(x)` member-call,
      // a `print(...)`, and a call to a VOID function (`fRetVoid`) are statements.
      if s.callFn < 0 { return false }
      const callee = nodeAt(s.callFn)
      if callee is Ident {
        if callee.identName == "print" { return false }
        // The void memory/array intrinsics (`__store_*__`, the bulk pair, `__log__`,
        // `__array_copy__`, `__trap__`) are statements: classifying one as the body's value
        // would emit a function promising a result it never produces.
        if callee.identName == "__store_i32__" { return false }
        if nameIsMemStoreIntrinsic(callee.identName) { return false }
        if nameIsMemBulkIntrinsic(callee.identName) { return false }
        if callee.identName == "__store_v128__" { return false }
        if atomicIntrinsicIsVoid(callee.identName) { return false }
        if callee.identName == "__log__" { return false }
        if callee.identName == "__array_copy__" { return false }
        if callee.identName == "__trap__" { return false }
        // A void HOST import is a statement for the same reason. Asked through the slot
        // table rather than by spelling, so a diverging slot added there cannot be missed
        // here — every other entry above is a name, which a new slot would not carry.
        if fsRetIsVoid(fsIntrinsicSlot(callee.identName)) { return false }
        if calleeIsVoidExtern(s.callFn, fnIx) { return false }
        if tailSelfFnIx >= 0 && tailCallsSelf(s.callFn, fnIx) { return false }
        const target = fnIndexOfAt(sidOfNode(s.callFn), fnIx, s.callFn)
        // A live closure binding of the name is what the tail denotes, so the voidness is
        // that closure's and the module function of the name settles nothing (D1602).
        if target >= 0 && !identIsBoundClosure(s.callFn, fnIx) {
          return fRetVoid[target] == 0
        }
        // A closure-value callee (invisible to `fnIndexOf`): a void one yields nothing, so
        // it's a statement tail, letting `run(g: () => void) { g() }` infer void.
        if (fnIx >= 0 && calleeReturnsVoidOfRead(s.callFn, fnIx)) {
          return false
        }
        const xct = nodeTyAt(stmtIx, fnIx)
        if xct >= 0 && tyPrimNameOf(xct) == "void" { return false }
        return true
      }
      // A member call left to each instance (D2517) is a value exactly when the `self`-function
      // call it stands for is, so the template's return is inferred from it; the pin holds a
      // built-in that takes the call to the same type.
      if callee is Member {
        if memberCallRungOf(stmtIx) == MC_RUNG_PER_INSTANCE {
          let sfe = fnIndexOf(ufcsAliasAtSite(stmtIx, callee.memProp))
          const sd = memberDeclOf(stmtIx)
          if sd >= 0 { sfe = fnIndexOf(binderNameAt(sd)) }
          if sd >= 0 && memberMethodOf(stmtIx) != sd { sfe = -1 }
          if sfe >= 0 && sfe < fRetVoid.length { return fRetVoid[sfe] == 0 }
        }
      }
      // D980 — a closure-field call in tail position is a value: without this arm,
      // `function p(x: {f: () => string}): string { x.f() }` lowered its tail as a
      // statement and trapped. Narrow on purpose: widening to every non-void member call
      // would wrongly claim `xs.push(1)` as a value inside a void function.
      if callee is Member {
        if fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx) >= 0 {
          // A field whose function the checker typed `void` yields nothing, so the tail is a
          // statement: claiming it typed the enclosing function's result `i32` (D3917).
          const ct = nodeTyAt(stmtIx, fnIx)
          if ct >= 0 && tyPrimNameOf(ct) == "void" { return false }
          return true
        }
      }
      // Every OTHER callee shape that is a function value — an element read, a call result, a
      // parenthesised value, one delivered through an un-annotated parameter. The RESOLVED
      // `$fnsig` is the whole warrant: an unresolved key lowers the call at the all-i32 arity
      // sig inside `emitCallRef` instead of refusing, so claiming a tail on one is wrong (D1623).
      const tvKey = cloCallSigKey(stmtIx, fnIx)
      if tvKey == "" { return false }
      return !sigKeyRetIsVoid(tvKey)
    }
    // Every other statement is not a value.
    ErrExpr | LetDecl | Param | TypeRef | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// The result type of calling the closure value at callee node `callFn`, through a `| null` on
// the callee's type; -1 when the checker recorded no function type there.
function cloCallRetTy(callFn: i32, fnIx: i32): i32 {
  tyStepRet(tyPeelNul(nodeTyAt(callFn, fnIx)))
}

// Whether the value at `exprIx` is the `boolean | null` niche (an i32 with sentinel 2).
export function exprNulBool(exprIx: i32, fnIx: i32) {
  exprNulKind(exprIx, fnIx) == "nulbool"
}

// A `let`/`const` binding is `boolean | null` if it is so ANNOTATED, or (un-annotated)
// its initializer is a `boolean | null` value — e.g. `const r = f()` where `f` returns
// the niche. Mirrors `letUnionNameOf`'s annotation-or-init resolution for value unions.
export function letNulBool(letIx: i32, fnIx: i32) {
  if letIx < 0 { return false }
  if letIsNulBoolAnn(letIx) { return true }
  // An un-annotated `const x = if c then true else null` infers `boolean | null` (a
  // niche the emitter can't statically derive from the if-expr arms). The CHECKER
  // typed it and exported the binding by node index; consult that before the init probe.
  if isInferLetNulBool(letIx) { return true }
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType < 0 { return exprNulBool(d.letInit, fnIx) }
  }
  false
}

// True if `exprIx` is a `K | null` NICHE value (the i32 atom with the spare `-1` = null) — a
// `K|null`-annotated param / local / global, or a call of a `K|null`-returning function. The
// litunion dual of `exprNulBool`; consulted at the `== null` compare and the `null`-seed boundaries.
export function exprNulLitUnion(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  // A node the generic body shares, typed at a hole this instance pins to the niche (D2978).
  if (
    monoHoleSubN.length > 0
    && tyIsNulLitUnionNiche(holeOperandTyOf(exprIx, fnIx))
    && holeLitReadIsAtom(exprIx, fnIx, 0)
  ) {
    return true
  }
  const e = nodeAt(unwrapParen(exprIx))
  // `k as? K` over an atom is the niche: the id on a hit, the `-1` sentinel on a miss.
  if e is AsExpr {
    if (
      e.asMode == "null"
      && asExprLitAtomYieldsAtom(unwrapParen(exprIx), fnIx)
    ) {
      return true
    }
    // …and over a union box, whose string arm converts to the id on a hit (D11221).
    if (
      e.asMode == "null"
      && asExprBoxToLitUnion(unwrapParen(exprIx), fnIx)
      && asBoxLitUnionYieldsAtom(unwrapParen(exprIx), fnIx)
    ) {
      return true
    }
  }
  // …and the same `if` whose arm is itself nullable — see `nulIfArmNullableValueIx` (D1560).
  const nlIfA = nulIfArmNullableValueIx(exprIx)
  // A join typed `string | null` is the string niche, whatever its first arm is, at its chain's
  // head in a function or the module; a link of an `else if` chain keeps its chain's answer (D3303).
  if (
    nlIfA >= 0
    && !(ifJoinIsNulString(unwrapParen(exprIx), fnIx)
      && ifIsChainHeadIn(unwrapParen(exprIx), fnIx))
  ) {
    if exprNulLitUnion(nlIfA, fnIx) { return true }
  }
  // A value `if` is the niche exactly when its join's type reps as one, whichever arms hold the
  // atom and the `null` (D5770, D14571).
  if e is IfStmt { return nodeRepIsNulAtom(unwrapParen(exprIx), fnIx) }
  // A `(K | null)[]` element read `p[i]` — the niche i32 (a member id or `-1`). Recovered
  // from the array's element type so `p[i] != null` narrows against `-1`, not a bare null.
  match e {
    Index => {
      if nodeArrayElemIsNulLitUnion(e.idxArr) { return true }
      if (
        monoHoleSubN.length > 0
        && tyIsNulLitUnionNiche(holeNulLitElemTy(e.idxArr, fnIx))
      ) {
        return true
      }
      // A bare map read `m[k]` over `{[string]: K | null}` yields the niche i32 (a member id
      // or `-1`), so `const t = m[k]` narrows with `!= null` against `-1`.
      const nlMt = mapRecvTyIn(e.idxArr, fnIx)
      if mapTyValIsNulLitUnion(nlMt) { return true }
      // …and the non-nullable spelling `{[string]: K}` reads the same niche: a bare `m[k]`
      // is `K | null` there too (a missing key is null), via the same `-1` miss value.
      if mapTyValIsLitUnion(nlMt) { return true }
    }
    // A fused `m[k] ?? d` read over `{[string]: K | null}` yields the niche i32, so
    // `const t = m[k] ?? d` narrows with `!= null` — the same fused-read home `m.get(k) ?? d` shares.
    BinExpr => {
      if e.binOp == "??" {
        const nblRecv = fusedMapReadRecvIx(unwrapParen(e.binLeft))
        if nblRecv >= 0 {
          if coalMapReadForeignDefault(nblRecv, e.binRight, fnIx) {
            return false
          }
          if mapTyValIsNulLitUnion(mapRecvTyIn(nblRecv, fnIx)) { return true }
        }
        // The non-map `p ?? d` over the same niche keeps it `K | null` exactly when the
        // default can still be null — the consumer half of `emitCoalesce`'s litunion arm.
        // `coalesceLitUnionFits` makes the same claim the emit arm does, so both decline together.
        if coalesceLitUnionFits(exprIx, fnIx) {
          return coalesceDefaultNullable(e.binRight, fnIx)
        }
      }
    }
    Call => {
      if e.callFn < 0 { return false }
      const callee = nodeAt(e.callFn)
      if callee is Ident {
        const t = fnIndexOfNode(e.callFn)
        if t >= 0 {
          const cfn = nodeAt(fnStmts[t])
          if cfn is FuncDecl {
            if cfn.fnRet >= 0 { return nodeRepIsNulAtom(cfn.fnRet, fnIx) }
          }
        }
        // A call of a closure-typed VALUE (`p()` where `p: () => K | null`) — a param /
        // local / global whose `K | null` niche return `fnIndexOf` can't see.
        if t < 0 && tyIsNullableLitUnion(cloCallRetTy(e.callFn, fnIx)) {
          return true
        }
      }
      // An INDEXED closure-array call (`p[i]()` where `p: (() => K | null)[]`): the element's
      // closure result is the `K | null` niche, read off the element's closure type, the indexed
      // dual of the Ident case above — so `const t0 = p[i]()` binds the
      // kind-0 litunion niche (an i32) instead of mis-inferring the softened `string | null` ref.
      if callee is Index {
        if exprRefArray(callee.idxArr, fnIx) {
          if tyIsNullableLitUnion(cloCallRetTy(e.callFn, fnIx)) { return true }
        }
      }
      // Fallback, scoped to a call: a `K | null`-returning closure value call whose callee the
      // cases above miss — a chained closure call (`v(1)()` where `v: (i32) => (() => K | null)`).
      // The checked-rep column reads the checker's per-node type, mirroring
      // `exprNullableString`'s fallback, which structurally excludes the litunion niche.
      if !nodeRepIsNulAtom(exprIx, fnIx) { return false }
      // The callee's `$fnsig` decides the rep: a closure keyed with a boxed result hands back the
      // box whatever the checker's type says (D2535).
      const nlk = cloCallSigKey(unwrapParen(exprIx), fnIx)
      return nlk == "" || sigKeyRetKind(nlk) != "union"
    }
    Ident => {
      // A CAPTURED variable, resolved against the enclosing frame's binding — the niche twin of
      // `exprIsLitAtom`'s capture channel, and the same node `captureValKind` sizes the env
      // field from. Checked first: a capture is none of the three channels below.
      if capturedIsNulLitUnion(fnIx, e.identName) { return true }
      // A `let`: the storage column, at the frame whose body declares it.
      const nld = readLetDeclOf(exprIx, fnIx)
      if nld >= 0 {
        return bindingIsNulLitUnion(nld, readDeclOwnerOf(nld, fnIx))
      }
      // A loop variable: the storage column, at the frame whose loop declares it.
      const nlv = readLoopVarDeclOf(exprIx)
      if nlv >= 0 {
        return bindingIsNulLitUnion(nlv, readDeclOwnerOf(nlv, fnIx))
      }
      if fnIx >= 0 {
        const fn = nodeAt(fnIx)
        if fn is FuncDecl {
          const params = fn.fnParams
          let i = 0
          while i < params.length {
            const p = nodeAt(params[i])
            if p is Param {
              if p.parName == e.identName {
                return nodeRepIsNulAtom(p.parType, fnIx)
              }
            }
            i = i + 1
          }
        }
      }
      return false
    }
    // A `K | null` struct field read (`a.f`, code 30) is the niche i32 with the `-1`
    // sentinel — the litunion dual of `exprNulBool`'s Member arm. Covers the plain struct
    // receiver and the `is`-narrowed variant receiver (`memberFieldCode` resolves both), so
    // `const t0 = v.f` binds the niche and its `!= null` narrows against `-1`.
    Member => {
      return memberFieldCode(exprIx, fnIx) == FC_NUL_LIT_UNION
    }
    // A `?.` whose leaf is a literal-union atom field, nullable or not, is the same niche:
    // `emitOptMemberValue` yields the field's atom or `-1` (D3457).
    OptMember => {
      const olc = optChainLeafFieldCode(exprIx, fnIx)
      if olc == FC_NUL_LIT_UNION { return true }
      return olc == FC_I32 && nodeRepIsNulAtom(exprIx, fnIx)
    }
    // No other expression reads a literal-union niche.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// Whether binding `letIx` is annotated with a type that reps as the bare atom.
function letAnnIsAtom(letIx: i32, fnIx: i32): boolean {
  const d = nodeAt(letIx)
  if d is LetDecl { return d.letType >= 0 && nodeRepIsAtom(d.letType, fnIx) }
  false
}

// Whether binding `letIx` spells the `K | null` niche: annotated so, or un-annotated over a
// `K | null` initializer. `bindCellGo` reads it; every other reader asks the column.
function letSpellsNulAtom(letIx: i32, fnIx: i32): boolean {
  if letIx < 0 { return false }
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 { return nodeRepIsNulAtom(d.letType, fnIx) }
    if exprNulLitUnion(d.letInit, fnIx) { return true }
    return letInitIsNulLitBox(d.letInit, fnIx)
  }
  false
}

// A `K | null` read out of a wider box, as an un-annotated binding's initializer: the binding is
// the niche and its store converts. Asked of the checker's type and the box, not of the live
// narrowing, so a capture's classification agrees with the frame's (D3118).
function letInitIsNulLitBox(init: i32, fnIx: i32): boolean {
  const ix = unwrapParen(init)
  if ix < 0 { return false }
  if !nodeRepIsNulAtom(ix, fnIx) { return false }
  const e = nodeAt(ix)
  if !(e is Ident || e is Member || e is Index) { return false }
  letInitIsBox(ix, fnIx)
}

// The map shape a function `name` returns, as seen from the call at `callIx`: its return
// annotation's value type, else the inferred shape its own result valtype is minted from
// (`inferredRetMapSlot`), else -1 (the mono map). `callIx` carries the call node only for
// the re-entrant case (D30) — a tail `if` return isn't caught by `fnRetExprOf` alone.
function fnRetMapShapeAt(sid: i32, callIx: i32) {
  const fe = fnIndexOfAt(sid, emitCurFnIx, callIx)
  if fe >= 0 {
    const fn = nodeAt(fnStmts[fe])
    if fn is FuncDecl {
      if fn.fnRet >= 0 { return mapAnnShape(fn.fnRet) }
      if retMapInFlight(fe) { return mapRecordedCallShape(callIx) }
      return inferredRetMapSlot(fe)
    }
  }
  -1
}

let gckDepth = 0
// `letIsF64` for `q == 0`, `letIsI64` for 1, and `letIsString` or `letIsNulString` for 2, of
// the global `letIx` that `sid` names, memoised by its ordinal in `globalStmts`.
function globalReadAsk(sid: i32, letIx: i32, q: i32): boolean {
  if gckDepth == 0 {
    if gckStale() { gckDrop() }
  }
  const gi = sidArrGet(globalIndexBySid, sid)
  const bit = 1 << q
  if gi >= 0 && gi < grStamp.length {
    if grStamp[gi] == gckGen && grLet[gi] == letIx && (grKnown[gi] & bit) != 0 {
      return (grVal[gi] & bit) != 0
    }
  }
  gckDepth = gckDepth + 1
  let v = false
  if q == 0 { v = letIsF64(letIx, -1) }
  else if q == 1 { v = letIsI64(letIx, -1) }
  else { v = letIsString(letIx, -1) || letIsNulString(letIx, -1) }
  gckDepth = gckDepth - 1
  if gi >= 0 {
    while grStamp.length <= gi {
      grStamp.push(0)
      grLet.push(-1)
      grKnown.push(0)
      grVal.push(0)
    }
    if grStamp[gi] != gckGen || grLet[gi] != letIx {
      grStamp[gi] = gckGen
      grLet[gi] = letIx
      grKnown[gi] = 0
      grVal[gi] = 0
    }
    grKnown[gi] = grKnown[gi] | bit
    if v { grVal[gi] = grVal[gi] | bit }
  }
  if gckDepth == 0 {
    if gckStale() { gckDrop() }
  }
  v
}

export function globalCellKind(letIx: i32): VKind {
  if letIx < 0 { return "i32" }
  // Only the TOP of a walk re-stamps: inside one, the columns are what stops the ladder
  // re-deriving the same global once per rung, which is the exponential.
  if gckDepth == 0 {
    if gckStale() { gckDrop() }
  }
  if letIx < gckHave.length {
    if gckHave[letIx] == gckGen { return gckVal[letIx] }
  }
  gckDepth = gckDepth + 1
  const k = globalCellKindGo(letIx)
  gckDepth = gckDepth - 1
  while gckHave.length <= letIx {
    gckHave.push(0)
    gckVal.push("i32")
  }
  gckHave[letIx] = gckGen
  gckVal[letIx] = k
  // A rung that re-parses a spelling MINTS rows, so a walk can move its own generation. Drop
  // the columns at the top when it did: nothing computed under the old one may persist.
  if gckDepth == 0 {
    if gckStale() { gckDrop() }
  }
  k
}

// The `fbValtype` kind of a module global's cell: a local's cell kind (`letCellKind`), read
// in no frame, after the never-filled `null` (D1576) and the v128 vector, which it does not name.
function globalCellKindGo(letIx: i32): VKind {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if letIsNulNone(letIx, -1) { return "nulnone" }
    if letInfersV128(letIx, -1) { return "v128" }
    return letCellKind(letIx, -1)
  }
  "i32"
}

// The struct table index for a global cell of kind 1 (struct ref), else -1. When the
// binding has a struct ANNOTATION the index comes from THAT annotation (`structIndexOfLet`,
// which prefers the annotation over the init) — so a struct global agrees with a same-
// typed local/param/field. An un-annotated const struct global infers from its literal.
export function globalCellStructIdx(letIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if letBindRepClaims(letIx, -1) { return letBindRepSlot(letIx, -1) }
    if globalHasTypeAnn(letIx) {
      // The annotated twin of the variant leg below: a kind-8 slot IS the variant index,
      // named directly by the annotation. Before `structIndexOfLet`, which answers -1 for
      // a variant by construction (the struct table doesn't hold one).
      const avi = letAnnVariantIdx(letIx)
      if avi >= 0 { return avi }
      return structIndexOfLet(letIx, -1)
    }
    // A kind-8 VARIANT cell's slot is the VARIANT index, not a struct row — paired with
    // `globalKind`'s variant arm, which decides the kind this slot is read beside.
    const gvi = exprVariantIndex(d.letInit, -1)
    if gvi >= 0 { return gvi }
    // The object-literal leg of the same pairing (D244): the rung above carries no
    // object-literal field-set arm by design, so `globalKind`'s `variant` arm and this slot
    // must read the same helper (`objLitVariantIdxNoStructRow`) or they'd disagree.
    const govi = letObjLitVariantIdx(letIx, -1)
    if govi >= 0 { return govi }
    // The UN-ANNOTATED nullable-variant cell (`const c = h(true)` where `h` returns
    // `Circle | null`) — its slot comes from the callee's return, the same place its
    // KIND does.
    const gnvi = nulVariantIdxOfExpr(d.letInit, -1)
    if gnvi >= 0 { return gnvi }
    return structIndexOfExpr(d.letInit, -1)
  }
  -1
}

// The registered union the checker typed this array literal's element as, or "" — the one
// home `arrLitIsRef`, `arrLitElemKind`, and `arrLitElemName` each need an arm for. A call or
// an ident element is neither an object literal, nested literal, nor lambda, so the
// first-element probes those three classifiers run cannot see a union arriving by either route.
export function arrLitUnionElemName(arrIx: i32): string {
  const ety = nodeArrayElemTyIx(arrIx)
  if !isUNameABTyMayHit(ety) { return "" }
  const cen = arrLitElemRender(arrIx)
  if cen == "" { return "" }
  // A numeric literal union keys to its own row but reps as its base scalar: no union element.
  if tyNumScalarBaseName(ety) != "" { return "" }
  // A union of lists that all spell one list is that list, never a box (D6732).
  if oneListUnionRender(ety) != "" { return "" }
  if !isUNameAB(16, cen, ety) { return "" }
  if arrLitIsStr(arrIx, -1) { return "" }
  if arrLitNumKind(arrIx, -1) != ALK_NONE { return "" }
  cen
}

// True if the array literal at `arrIx` has ref elements in function `fnIx` (-1: no frame) —
// its first element is a struct or variant object literal, or its type there is a ref list.
// An empty literal is not detectable here; its kind comes from the destination.
export function arrLitIsRef(arrIx: i32, fnIx: i32) {
  arrLitIsRefTpl(arrIx) || arrLitFrameRefTy(arrIx, fnIx) >= 0
}

// The list type literal `arrIx` has in frame `fnIx` when the frame's type of it is a ref list
// with a row name the frameless rungs cannot see: its recorded type names a hole or a type
// parameter, or its lead inner literal is such a list. -1 otherwise (D10891, D3154).
export function arrLitFrameRefTy(arrIx: i32, fnIx: i32): i32 {
  if fnIx < 0 { return -1 }
  const it = nodeTyInOf(arrIx, fnIx)
  if it < 0 || it >= T.tys.length { return -1 }
  const e = tyArrayElemIx(it)
  if e < 0 || e >= T.tys.length { return -1 }
  const k = refListElemKindOfTy(e)
  if k < 0 || !tyIsRefArray(it) || rlRowNameOfTy(e, false) == "" { return -1 }
  // A list of lists follows its inner literal, so the two build one row (D3154).
  if k == RLK_REF_LIST {
    if arrLitLeadFrameRef(arrIx, fnIx) { return it }
    return -1
  }
  if it == nodeTyIxOf(arrIx) || tyIsArray(e) || arrLitIsRefTpl(arrIx) {
    return -1
  }
  it
}

// Whether list literal `arrIx`'s lead inner literal is a ref list in frame `fnIx` only.
function arrLitLeadFrameRef(arrIx: i32, fnIx: i32): boolean {
  const a = nodeAt(arrIx)
  if a is ArrayLit {
    if a.arrElems.length < 1 || !(nodeAt(a.arrElems[0]) is ArrayLit) {
      return false
    }
    return arrLitFrameRefTy(arrLitLeadInner(a), fnIx) >= 0
  }
  false
}

// `arrLitIsRef` read off the literal's own recorded type, the answer every frame shares.
function arrLitIsRefTpl(arrIx: i32) {
  const a = nodeAt(arrIx)
  if a is ArrayLit {
    if a.arrElems.length < 1 { return false }
    // A literal of function values the checker typed as a closure array: its element is a
    // closure cell, checker-driven rather than a first-element guess, so a local shadowing
    // a function name is never mis-claimed. Subsumes the lambda-literal rung below for any
    // closure array the checker concretely typed.
    if arrElemIsClosureTy(arrIx) { return true }
    const e0 = nodeAt(a.arrElems[0])
    if e0 is ObjLit { return true }
    // A closure-element literal is a ref list (kind 5), not an i32 list — without this,
    // `exprArray` claims it by default, the inferred-return scan mints an i32-list closure
    // signature, and a closure value returning it miscompiles.
    if e0 is FuncDecl { return true }
    // A nested array literal is a ref list whose element is the inner list's wrapper (kind
    // 4, or 6/7/8 for a string/f64/i64 leaf). Keying every scalar leaf, not only i32, avoids
    // a wrapper-heap mismatch between the outer key and the inner literal's own build. A ref
    // inner literal falls through to the arena rung below instead, one level short here.
    if e0 is ArrayLit {
      if !arrLitIsRefTpl(a.arrElems[0]) { return true }
    }
    // A checker-typed union element: the kind-2 box list. Last rung, deliberately — every
    // literal that classifies by its first element keeps that classification, so this arm
    // only ever claims a literal that otherwise falls through to the i32 default.
    if arrLitUnionElemName(arrIx) != "" { return true }
    // A checker-typed map element: the kind-3 map list. Same placement as the union rung —
    // a `Map()`/`Set()` element is no object literal, no nested literal, and no lambda, so
    // every probe above misses it and the literal falls to the i32 list, where
    // `emitArr`'s guard refuses the map-struct ref element loudly.
    if arrLitMapElemName(arrIx) != "" { return true }
    // A checker-typed object-shaped element the first-element probes cannot see — an ident
    // or a call whose recorded element is a declared struct or union arm. Last, beside the
    // union and map rungs, for the same reason: it only claims a literal falling to i32.
    if arrLitNominalElemName(arrIx) != "" { return true }
    // A checker-typed list element the first-element probes cannot see (D180): `[c]` where
    // `c` is a `string[]` local is no object literal, nested literal, lambda, map, or
    // declared shape, so it fell to the i32 backing with a ref operand — check-clean invalid
    // wasm. Reuses `arrLitNestedElemName`, last because an array-first-element is claimed above.
    if arrLitNestedElemName(arrIx) != "" { return true }
    // D1270 — the nullable-niche element, one peel short of the list rung above: its
    // recorded element is a `TyNullable`, not the `TyArray` that rung reads, so every probe
    // missed it and the literal built the mono i32 list with a nullable-ref element stored
    // in it — check-clean invalid wasm. Last, for the same reason the rungs above are.
    if arrLitNulRefElemName(arrIx) != "" { return true }
  }
  false
}

// True if the array literal at `arrIx` has string elements — its first element is a
// string-typed expression. An empty literal is not detectable here; its kind comes from
// the binding/field annotation (`LBK_STR_LIST`).
export function arrLitIsStr(arrIx: i32, fnIx: i32) {
  const a = nodeAt(arrIx)
  if a is ArrayLit {
    if a.arrElems.length < 1 { return false }
    if hasSpreadItem(a.arrElems) { return spreadDestKind(arrIx, fnIx) == "str" }
    // An atom-element literal (the checker adopted a `K[]` context) is the i32 atom-id
    // list, not a string list — its elements are string exprs syntactically but each lowers
    // as its interned atom id. Without this the literal claims the string-list build while
    // every consumer reads the atom rep, invalid wasm at first use.
    if nodeArrayElemIsLitUnion(arrIx) { return false }
    // A `(K | null)[]` literal is likewise the i32 atom-niche list, not a string list: its
    // elements lower as atom ids and `null` as the `-1` sentinel. Without this exclusion a
    // string-first literal claims the string-list build while every consumer reads the atom
    // rep, invalid wasm.
    if nodeArrayElemIsNulLitUnion(arrIx) { return false }
    // A `string[]` literal with no string-typed first element (a litunion value under a
    // `string[]` annotation): the recorded context-adoption type is the only signal, and
    // without it the emitter built the atom list from the first element into a string-list
    // slot — check-clean invalid wasm. Checked after the two literal-union exclusions above.
    if nodeArrayElemIsStr(arrIx) { return true }
    // A one-member set spelled bare (`("a")[]`) is a string list (D1460): its only element,
    // a promoted one-member discriminant field, reads as an atom, so the first-element probe
    // below misses it and the literal would build the i32 list into a string-list slot.
    // Checked beside the `string[]` arm, after the two litunion exclusions.
    if nodeArrayElemIsBareStrLit(arrIx) { return true }
    // A `(string | null)[]` literal with no string-typed first element (`[null]`): the
    // recorded context-adoption type is the only signal — it is the string-ref niche list,
    // so the string-list build is authoritative even though the first-element probe misses.
    // A generic instance reads its own element: the template records `(T | null)[]` (D10881).
    if arrElemIsNulStrAt(arrIx, fnIx) { return true }
    // A box-list literal whose first element happens to be a string: the checker recorded a
    // value union and the elements box, so the string-list build would store the i32 sibling
    // into a ref backing — invalid wasm. Asked of the recorded type, order-blind, so
    // `[1, "two"]` and `["two", 1]` are one answer. Last, right before the first-element probe.
    if arrLitBoxElem(arrIx) { return false }
    return exprString(a.arrElems[0], fnIx)
  }
  false
}

// The scalar list the array literal at `arrIx` makes by its elements: `ALK_F64` when some
// element is an f64 and none an i64, `ALK_I64` for the converse, else `ALK_NONE` (an empty
// literal included, whose kind comes from its destination). Mixed float and int elements are a
// checker-level union, so they answer `ALK_NONE`; one scan asks each element both widths.
export function arrLitNumKind(arrIx: i32, fnIx: i32): i32 {
  const a = nodeAt(arrIx)
  if a is ArrayLit {
    if a.arrElems.length < 1 { return ALK_NONE }
    // A spread element is no scalar VALUE, so the element scan below would read `[...fs]` as
    // the i32 default while `emitArrSpread` builds the source's rep — two heap types for one
    // value. Both sides ask `spreadDestKind`, so they cannot disagree.
    if hasSpreadItem(a.arrElems) {
      const sk = spreadDestKind(arrIx, fnIx)
      if sk == "f64" { return ALK_F64 }
      if sk == "i64" { return ALK_I64 }
      return ALK_NONE
    }
    // A box-list literal with an f64 or i64 member: the checker recorded a value union, so the
    // elements box, and a scalar build would store a string ref into a scalar backing. The scan
    // below is order-blind (any member claims the list), so the union has to win here.
    if arrLitBoxElem(arrIx) { return ALK_NONE }
    let anyF64 = false
    let anyI64 = false
    let i = 0
    while i < a.arrElems.length && !(anyF64 && anyI64) {
      const el = a.arrElems[i]
      const n = if el >= 0 { nodeAt(el) } else { null }
      if n is NumLit {
        const w = numLitWidth(el, fnIx)
        if w == "f64" || w == "f32" { anyF64 = true }
        if w == "i64" { anyI64 = true }
      } else {
        if !anyI64 && exprIsI64(el, fnIx) { anyI64 = true }
        if !anyF64 && exprIsF64(el, fnIx) { anyF64 = true }
      }
      i = i + 1
    }
    if anyF64 && !anyI64 { return ALK_F64 }
    if anyI64 && !anyF64 { return ALK_I64 }
  }
  ALK_NONE
}

// The union variant an object-literal-element array literal boxes its elements under, or ""
// — the one home the rule `arrLitElemName`, `arrLitElemKind`, and `arrLitElemHintTy` all
// need an arm for. `objVariantName` alone over-widens an anonymous shape shared by two
// variants (D36); `arrLitBoxElemName` is the second gate, asking whether the element is a real union.
export function arrLitObjElemBoxVariant(arrIx: i32): string {
  if !uDeclared { return "" }
  if arrLitBoxElemName(arrIx) == "" { return "" }
  // The third gate (D361): the recorded union may be a join, not a disagreement of rows.
  // When every element denotes one arm, the literal is a list of that arm, and declining
  // here routes all three classifiers to kind 1 under that arm's own name — the same slot
  // the annotated `Circle[]` spelling interns.
  if arrLitObjElemsOneVariant(arrIx) != "" { return "" }
  const a = nodeAt(arrIx)
  if a is ArrayLit {
    if a.arrElems.length >= 1 {
      const e0 = nodeAt(a.arrElems[0])
      if e0 is ObjLit { return objVariantName(a.arrElems[0]) }
    }
  }
  ""
}

// The ref-list row literal `arrIx` builds in frame `fnIx`, found by the element type
// `arrLitRowTyIn` keys it by, or -1 for none.
export function arrLitRowSlotIn(arrIx: i32, fnIx: i32): i32 {
  rlSlotOfRowTy(arrLitRowTyIn(arrIx, fnIx))
}

// The element type ref-list literal `arrIx` keys its row by in frame `fnIx`, or -1.
export function arrLitRowTyIn(arrIx: i32, fnIx: i32): i32 {
  let et = -1
  const ft = arrLitFrameRefTy(arrIx, fnIx)
  if ft >= 0 { et = tyArrayElemIx(ft) }
  const inst = if et < 0 { arrLitInstElemRow(arrIx, fnIx) } else { -1 }
  if inst >= 0 && inst < sTyIx.length { et = sTyIx[inst] }
  if et < 0 { et = arrLitElemHintTy(arrIx) }
  if et < 0 { et = arrLitObjRowTy(arrIx, fnIx) }
  // The element's own committed annotation outranks its recorded shape's row (D163).
  if et < 0 {
    const ca = arrLitCommitAnnAt(arrIx)
    if ca >= 0 { et = annRowOfNode(ca) }
  }
  if et < 0 { et = arrLitNominalRowTy(arrIx) }
  if et < 0 && arrLitLeadIsList(arrIx) {
    et = tyRefArrElemOf(nodeTyInOf(arrIx, fnIx))
  }
  if et < 0 { et = tyRefArrElemOf(nodeRepTyIxOf(arrIx)) }
  rlRowTyOfElem(et)
}

// The row type of an object-literal element list's lead element: its struct row, else its
// arm's row; -1 where the union-box or nullable-element arm owns the answer.
function arrLitObjRowTy(arrIx: i32, fnIx: i32): i32 {
  const a = nodeAt(arrIx)
  if a is ArrayLit {
    if a.arrElems.length < 1 || !(nodeAt(a.arrElems[0]) is ObjLit) { return -1 }
    if arrLitObjElemBoxVariant(arrIx) != "" { return -1 }
    if arrLitNulRefElemName(arrIx) != "" { return -1 }
    const si = structIndexOfObjCtx(a.arrElems[0], fnIx)
    if si >= 0 && si < sTyIx.length { return sTyIx[si] }
    if uDeclared {
      const vi = objVariantRowCtx(a.arrElems[0], -1)
      if vi >= 0 && vi < uVarTyIx.length { return uVarTyIx[vi] }
    }
  }
  -1
}

// The arena twin of `arrLitElemName`, arm for arm: the row that arm's name denotes, or -1
// where the arm's answer is deliberately a name. Each arm must use its own source — hinting
// every arm from the array's arena element disagrees for the two object-literal arms, whose
// name is a row found in a table, not the array's recorded element.
export function arrLitElemHintTy(arrIx: i32) {
  const a = nodeAt(arrIx)
  if a is ArrayLit {
    // The closure-element arm is hinted at full agreement under the guard: the row is the
    // array's own recorded element, but only where the element mentions no literal type and
    // no object shape (`tyMentionsLitOrObj`), the two classes that disagree.
    if arrElemIsClosureTy(arrIx) {
      const cty = arrLitArenaElemRow(arrIx)
      if cty < 0 { return -1 }
      if tyMentionsLitOrObj(cty, 0) { return -1 }
      // A row still carrying a hole is the TEMPLATE's, and the name arm answered through the
      // hole's pin — hinting the unsubstituted row would key a second one (D1794).
      if tyHasTyVar(cty) { return -1 }
      return cty
    }
    if a.arrElems.length >= 1 {
      const e0 = nodeAt(a.arrElems[0])
      // Arm 2 — the coarse nested-list bucket.
      if e0 is ArrayLit { return -1 }
      if e0 is ObjLit {
        // Must agree arm for arm with the two classifiers above: the hint denotes the row
        // the name arm picked, so it asks the same predicate. An element resolving to a bare
        // arm falls past into the struct arm, which declines the hint rather than guess.
        const vn = arrLitObjElemBoxVariant(arrIx)
        if vn != "" {
          // The variant arm, dual-written at full agreement: the name is `unNames[u]`, the
          // row is that table's own `unTyIx[u]`, resolved from that name at mint.
          const u = unionOfVariant(variantIndexOf(vn))
          if u < 0 { return -1 }
          if u >= unTyIx.length { return -1 }
          return unTyIx[u]
        }
        // The nullable-element arm's twin: the name arm answers the NICHE spelling, and this
        // DECLINES rather than hand over the non-null struct row below, which would key a
        // second slot for one wrapper. Declining keys on the name alone, the one string both
        // the inferred literal and the annotation reach the table with.
        if arrLitNulRefElemName(arrIx) != "" { return -1 }
        // The struct arm, at full agreement once two row classes are excluded: `sIsAnonRow`
        // (`sTyIx` has two producers that disagree for an `#anonN` row), and
        // `nameIsNewtypeBrand` (the row's name is the brand while `sTyIx[si]` holds the
        // unbranded base, so `repElemKey` keys the two differently).
        const si = structIndexOfObj(a.arrElems[0])
        if si >= 0 {
          if si >= sTyIx.length { return -1 }
          if sIsAnonRow(si) { return -1 }
          if nameIsNewtypeBrand(sNames[si]) { return -1 }
          return sTyIx[si]
        }
        return -1
      }
    }
    // The union-element arm, dual-written at full agreement: `arrLitUnionElemName` is
    // `nodeArrayElemName` gated by a union row, so its row is the array's own recorded
    // element, read off `nodeTyIxOf` — the same column that renderer reads.
    if arrLitUnionElemName(arrIx) != "" { return arrLitArenaElemRow(arrIx) }
    // The committed-rep arm declines too (D163): its name is a spelling the element
    // expression committed to, never a row this function looked up, so there is no arena
    // twin to hand over. The nominal-element arm declines deliberately, for the same reason
    // — a declined hint costs nothing, a wrong hint is a silently wrong rep key.
  }
  -1
}
// The one nominal row every object-literal element of `arrIx` denotes, or "" when they do
// not all denote one row (D361) — the rung `arrLitObjElemBoxVariant` consults before it
// widens. "The checker recorded a union" and "the elements denote different rows" are two
// different facts: a naive structural join can name a union while every element is one arm.
function arrLitObjElemsOneVariant(arrIx: i32): string {
  const a = nodeAt(arrIx)
  if a is ArrayLit {
    if a.arrElems.length < 2 { return "" }
    let nm = ""
    let i = 0
    while i < a.arrElems.length {
      const e = nodeAt(a.arrElems[i])
      if !(e is ObjLit) { return "" }
      const vn = objVariantName(a.arrElems[i])
      if vn == "" { return "" }
      if i == 0 { nm = vn }
      else if vn != nm { return "" }
      i = i + 1
    }
    return nm
  }
  ""
}

// The scalar leaf kind of list-of-lists literal `a` (lead inner literal `e0x`): order-blind
// over every inner literal, as `arrLitNumKind` is over a flat literal's elements, so a later
// `[2.5]` keys `f64[]` as the checker's element join does (D4876). ALK_NONE for a mixed one.
export function arrLitNestedNumKind(a: ArrayLit, e0x: i32, fnIx: i32): i32 {
  let anyF64 = false
  let anyI64 = false
  for el in a.arrElems {
    if el == e0x || nodeAt(el) is ArrayLit {
      const nk = arrLitNumKind(el, fnIx)
      if nk == ALK_F64 { anyF64 = true }
      if nk == ALK_I64 { anyI64 = true }
    }
  }
  if anyF64 && !anyI64 { return ALK_F64 }
  if anyI64 && !anyF64 { return ALK_I64 }
  ALK_NONE
}

// `arrLitElemName` with a nested literal's scalar leaf read inside function `fnIx`, where an
// instance's parameter pin names it (`[[t]]` at `T := string` keys `string[]`); the pin-blind
// answer when the leaf reads the same, or when the pinned leaf has no element row (D2798).
export function arrLitElemNameIn(arrIx: i32, fnIx: i32): string {
  const sn = spreadLitSrcRowName(arrIx, fnIx)
  if sn != "" { return sn }
  const nm = arrLitElemName(arrIx, fnIx)
  if nm != "i32[]" { return nm }
  const pn = arrLitFrameLeafRow(arrIx, fnIx)
  if pn != "" && rlSlotByName(pn) >= 0 { return pn }
  nm
}

// The scalar-leaf row a list-of-lists literal's element keys in frame `fnIx`: `string[]`, `f64[]`
// or `i64[]` when the inner literal's leaf is one there, as a parameter pinned by a generic
// instance is (D3115). "" otherwise; the caller asks it only where the frameless name is `i32[]`.
export function arrLitFrameLeafRow(arrIx: i32, fnIx: i32): string {
  if fnIx < 0 { return "" }
  const a = nodeAt(arrIx)
  if a is ArrayLit {
    if a.arrElems.length < 1 || !(nodeAt(a.arrElems[0]) is ArrayLit) {
      return ""
    }
    const e0x = arrLitLeadInner(a)
    if emptyArrLitIxOf(e0x) >= 0 || arrLitIsRef(e0x, fnIx) { return "" }
    if arrLitIsStr(e0x, fnIx) { return "string[]" }
    const nk = arrLitNestedNumKind(a, e0x, fnIx)
    if nk == ALK_F64 { return "f64[]" }
    if nk == ALK_I64 { return "i64[]" }
  }
  ""
}

// The ref-list row name the array literal at `arrIx` keys in function `fnIx` (-1: no frame),
// or "" when it is no ref list there.
export function arrLitElemName(arrIx: i32, fnIx: i32): string {
  const ft = arrLitFrameRefTy(arrIx, fnIx)
  if ft >= 0 { return rlRowNameOfTy(tyArrayElemIx(ft), false) }
  const inst = arrLitInstElemRow(arrIx, fnIx)
  if inst >= 0 { return sNames[inst] }
  arrLitElemNameTpl(arrIx)
}

// The struct row a plain record literal leading list literal `arrIx` builds at in instance
// `fnIx`, or outside any instance at the record solve's build row (`objLitBindDestRow`), when
// that is not the template's row and its list row exists; else -1.
function arrLitInstElemRow(arrIx: i32, fnIx: i32): i32 {
  if arrIx < 0 || arrIx >= P.nodes.length { return -1 }
  const a = nodeAt(arrIx)
  if a is ArrayLit {
    if a.arrElems.length < 1 || !(nodeAt(a.arrElems[0]) is ObjLit) { return -1 }
    if (
      arrLitObjElemBoxVariant(arrIx) != ""
      || arrLitNulRefElemName(arrIx) != ""
    ) {
      return -1
    }
    const e0 = a.arrElems[0]
    let si = -1
    if fnIx < 0 {
      si = objLitBindDestRow(e0, structIndexOfObjCtxMemo(e0, -1))
    } else {
      si = structIndexOfObjCtx(e0, fnIx)
      if si == structIndexOfObj(e0) { return -1 }
    }
    if si < 0 || si >= sNames.length { return -1 }
    if rlSlotByName(sNames[si]) >= 0 { return si }
  }
  -1
}

// `arrLitElemName` read off the literal's own recorded type, the answer every frame shares.
function arrLitElemNameTpl(arrIx: i32): string {
  const a = nodeAt(arrIx)
  if a is ArrayLit {
    // A closure-element literal: the parenthesized function-type table key the checker
    // recorded. Must agree arm for arm with `arrLitElemKind`'s kind-5 gate.
    if arrElemIsClosureTy(arrIx) { return arrLitElemRender(arrIx) }
    if a.arrElems.length >= 1 {
      const e0 = nodeAt(a.arrElems[0])
      // A nested-list element keys the inner list's name by its leaf — the table key
      // `arrLitElemKind` picks the matching kind for (6/7/8, else 4).
      if e0 is ArrayLit {
        // A union-of-lists element keys the union, as `arrLitElemKind`'s rung does (D4894).
        const nun = arrLitUnionElemName(arrIx)
        if nun != "" { return nun }
        // An inner hole (`[[]]`) has no element for the three leaf probes below to read, so
        // all three would decline and key `i32[]` regardless of what the outer list holds —
        // check-clean invalid wasm (D16). The checker's own recorded element renders the
        // inner list's emit name instead, gated on the hole so a non-empty inner classifies normally.
        if emptyArrLitIxOf(a.arrElems[0]) >= 0 {
          const cen = arrLitElemRender(arrIx)
          if cen != "" { return cen }
        }
        const e0x = arrLitLeadInner(a)
        if emptyArrLitIxOf(e0x) >= 0 {
          const hen = arrLitNestedElemName(arrIx)
          if hen != "" { return hen }
        }
        // A ref inner literal's element is the inner ref list, whose name the leaf probes
        // below cannot render — they answer one level short, keying a different row than
        // the element actually builds (D702). The arena renders it instead, the same string
        // the annotated spelling interns. Must agree arm for arm with `arrLitElemKind`'s kind-9 rung.
        if arrLitIsRef(e0x, -1) {
          const rin = arrLitNestedElemName(arrIx)
          if rin != "" { return rin }
        }
        if arrLitIsStr(e0x, -1) { return "string[]" }
        const nk = arrLitNestedNumKind(a, e0x, -1)
        if nk == ALK_F64 { return "f64[]" }
        if nk == ALK_I64 { return "i64[]" }
        return "i32[]"
      }
      if e0 is ObjLit {
        // The union widening is `arrLitObjElemBoxVariant`'s, not a bare field-set scan's —
        // one home for the rule, so this arm and `arrLitElemKind`'s cannot drift.
        const vn = arrLitObjElemBoxVariant(arrIx)
        if vn != "" { return unionNameOfVariant(variantIndexOf(vn)) }
        // A LATER `null` element makes the row the NICHE, and the niche bit is read off the
        // name (`rlElemNicheNullable`) — so the nullable spelling has to be asked before the
        // bare nominal one, or `[{n: 42}, null]` keys a different slot than the annotated
        // `(P | null)[]` interns and the `!= null` guard falls to a struct compare (D1831).
        const nre = arrLitNulRefElemName(arrIx)
        if nre != "" { return nre }
        const si = structIndexOfObj(a.arrElems[0])
        if si >= 0 { return sNames[si] }
        // The arm's own name, not its union — the fall-through this gate needs, in the same
        // ladder order every consumer uses (struct row, then variant row). A concrete-variant
        // element list has no `sNames` row, so without this an anonymous element whose only
        // claimant is an arm has no name here and the literal falls to the i32 list (D38).
        if uDeclared {
          const av = objVariantName(a.arrElems[0])
          if av != "" { return av }
        }
      }
    }
    // The checker-typed union element: the registered composite is the table key — the
    // same string `refArrElemName` yields for the annotated `(Cat | Dog)[]` spelling, so
    // both spellings intern one slot.
    const aun = arrLitUnionElemName(arrIx)
    if aun != "" { return aun }
    // The element expression's own committed rep, ahead of every rung that reads the
    // checker's structural record (D163): `shapeNominalOfTy` resolves the struct table
    // before the variant table, so an annotated `Circle` element could key its layout twin
    // `Dot` instead. Checked after the literal arms and the checker-typed union element.
    const acn = arrLitCommitNameAt(arrIx)
    if acn != "" { return acn }
    // The checker-typed map element: the whole `{[K]:V}` spelling is the table key, the
    // same string `refArrElemName` yields for the annotated `{[K]: V}[]` — so the two
    // spellings intern one row of kind 3, carrying the key as well as the value.
    const amn = arrLitMapElemName(arrIx)
    if amn != "" { return amn }
    // The checker-typed object-shaped element: the declared row's own name is the table
    // key, the same string `refArrElemName` yields for the annotated `Circle[]` spelling,
    // whether that row is a struct or a union arm — so the inferred literal and the
    // annotation intern one kind-1 slot.
    const ann = arrLitNominalElemName(arrIx)
    if ann != "" { return ann }
    // The checker-typed list element: the inner list's own emit name is the table key, the
    // same string `refArrElemName` yields for the annotated `string[][]` spelling, so all
    // three spellings intern one row. Must agree arm for arm with `arrLitIsRef` and
    // `arrLitElemKind`, which ask the identical predicate.
    const anl = arrLitNestedElemName(arrIx)
    if anl != "" { return anl }
    // D1270 — the checker-typed nullable-container element: the element's own emit render
    // is the table key, the same string `refArrElemName` yields for the annotated
    // `(i32[] | null)[]` spelling, so both spellings intern one row. Must agree arm for arm
    // with `arrLitIsRef` and `arrLitElemKind`.
    const anr = arrLitNulRefElemName(arrIx)
    if anr != "" { return anr }
  }
  ""
}

export function anonFieldCode(valIx: i32) {
  if valIx < 0 { return -1 }
  // The packed byte list's own field code, 35 — the code `fieldCodeOfSpelling` gives the
  // DECLARED twin (D1008). Asked here ahead of all three guessing rungs because they read the
  // literal's own type and a bare `[7]` never infers `u8[]`; `nodeRepTyIxOf` carries the
  // destination it adopts, which is the one thing that can see the difference (D1854).
  if tyIsU8ArrayTy(nodeRepTyIxOf(valIx)) { return FC_U8_LIST }
  const syn = anonFieldCodeSyn(valIx)
  if syn >= 0 { return syn }
  // A field whose value is the `null` unit type stores its `nullref` slot, the code the
  // declared twin gets (D4671).
  if tyIsNullUnit(nodeRepTyIxOf(valIx)) { return FC_NUL_NONE }
  // A literal-union field value is the interned i32 atom, code 0 — the rule
  // `fieldCodeOfSpelling` states for the DECLARED twin, which this ladder lacked. Ahead of the
  // box rung below, since a literal union also registers as a union NAME and would otherwise
  // be minted as a `(ref)` box every reader of the row then lowers as an atom (D1757).
  if tyIsLitUnionAlias(nodeTyIxOf(valIx)) { return FC_I32 }
  // The INLINE spelling of that field is the string slot, code 3 — the other half of the split
  // `fieldCodeOfSpelling` makes for the declared twin. Without it a member set with no alias
  // reached the spellability gate, which declines a `TyUnion`, and cost the whole literal its
  // row (D1783).
  if tyIsLitUnion(nodeTyIxOf(valIx)) { return FC_STR }
  // A lone literal type (`"a"`, `7`) stores its base scalar, the slot the declared twin gets
  // through `tyScalarBaseIs`; the spellability gate below declines a `TyLit` (D5341).
  const lt = nodeTyIxOf(valIx)
  if lt >= 0 {
    const ltt = tyAt(lt)
    if ltt is TyLit {
      const lc = fieldCodeOfTy(litBaseTy(ltt))
      if lc >= 0 { return lc }
    }
  }
  // A `K | null` whose `K` narrowing a wider box re-minted at a fresh index, which the alias
  // test in the niche rung below misses, is the same atom niche, named by its members (D3121).
  if nodeTyIsNulLitUnion(valIx) {
    if nulLitAliasNameOfTy(nodeTyIxOf(valIx)) != "" { return FC_NUL_LIT_UNION }
  }
  // A value-union field value is the shared box, code 16 — the same code the declared twin
  // gets from `isValueUnionName`. Checked ahead of the spellability gate on purpose:
  // `nodeTyName` spells no union, so that gate would refuse the whole literal a row (D1242).
  // `anonUnionFieldName` supplies the companion column the admission rule needs.
  if anonUnionFieldName(valIx) != "" { return FC_UNION }
  // The niche-nullable rung, ahead of the spellability gate for the same reason code 16 is:
  // `anonTySpellable` declines a `TyNullable` and `nodeTyName` spells no `| null`, so a
  // nullable ref field reached neither ladder and cost the whole literal its row (D1627).
  const anonNul = anonNulFieldCodeOfTy(nodeTyIxOf(valIx))
  if anonNul >= 0 {
    if !anonCodeAdmitsValue(anonNul, valIx) { return -1 }
    return anonNul
  }
  // A map fed by a binding, a parameter or a read is code 19, the rung `anonFieldCodeSyn`
  // takes for a `Map()` call: the spellability gate declines a `TyMap`, so without it the
  // literal lost its row and its function's return type had no shape (D3123).
  if nodeTyIsMap(valIx) {
    if !mapNodeValKindLowerable(valIx) { return -1 }
    if anonFieldElemName(valIx, FC_MAP) == "" { return -1 }
    return FC_MAP
  }
  // The gate, then the arena, then the render: `anonTySpellable` keeps an unspellable type
  // out of both paths, which a naive hoist of the arena rung drops — regressing a
  // generic-alias reresolve to a loud reject. With the gate preserved, the render is built
  // only when the arena declines, so a miss on either half gives the same -1.
  if !anonTySpellable(nodeTyIxOf(valIx)) { return -1 }
  const anonTy = nodeTyIxOf(valIx)
  const anonArena = fieldCodeOfTy(anonTy)
  if anonArena != -2 {
    if !anonCodeAdmitsValue(anonArena, valIx) { return -1 }
    return anonArena
  }
  // A record value is a nested struct exactly when its row resolves: the name ladder below
  // has no code for a record's spelling, which can be exponential in its depth (D2780).
  if anonTy >= 0 && anonTy < T.tys.length {
    const rt = tyAt(anonTy)
    if rt is TyObj {
      if anonFieldElemName(valIx, FC_STRUCT) != "" { return FC_STRUCT }
      return -1
    }
  }
  const tn = nodeTyName(valIx)
  if tn == "" { return -1 }
  // The arena rung first: `nameFieldCodeTy` takes `fieldCodeOfTy` first, the confirm-only
  // rung that answers where the arena decides the code exactly and returns -2 otherwise, and
  // falls back to this same name ladder. The render above stays as the fallback's input; the
  // `tn == ""` guard keeps an unspellable type out of both paths.
  const c = nameFieldCodeTy(tn, anonTy)
  // A nested-struct field fed by a non-literal (D1543): the name ladder codes a field by its
  // rendered type, and an anonymous literal's struct-valued field renders structurally even
  // where the value carries a declared alias, which `fieldCodeOfSpelling` has no code for.
  // Gated on the companion resolving, the same bargain `anonCodeIsSelfContained` requires.
  if c < 0 {
    if fieldCodeForMatch(anonTy) == FC_STRUCT {
      if anonFieldElemName(valIx, FC_STRUCT) != "" { return FC_STRUCT }
    }
  }
  if !anonCodeAdmitsValue(c, valIx) { return -1 }
  c
}

// The admission rule the recorded-type rung actually applies: `anonCodeIsSelfContained` plus
// the one code that needs a companion and can now supply it, stated where the value is in
// hand (D1515).
function anonCodeAdmitsValue(c: i32, valIx: i32) {
  if anonCodeIsSelfContained(c) { return true }
  if anonNulCodeIsSelfContained(c) { return true }
  // The codes that need a companion and can supply it, all through `anonFieldElemName`: 15
  // names a struct row (and the nullable struct `fieldCodeForMatch` folds onto it), 28 its
  // ref-list element's, and 30 the union whose members its i32 atom is an id into — a
  // self-contained slot would lose that membership (D1627, D1710).
  if c == FC_STRUCT || c == FC_NUL_REF_LIST || c == FC_NUL_LIT_UNION {
    return anonFieldElemName(valIx, c) != ""
  }
  // Code 29 the same way: the nullable map's slot is a ref to its value type's mv struct, so
  // the value name is the companion the emitter re-finds that slot by (D1665).
  if c == FC_NUL_MAP { return anonFieldElemName(valIx, c) != "" }
  // Code 5 the same way, once its companion can name a non-struct element (D1688). The
  // struct-row rung stays its own disjunct: an EMPTY array literal resolves a row and names
  // no element, so folding the two would refuse a shape that mints today.
  if c == FC_REF_LIST {
    if anonRefListElemRow(valIx) >= 0 { return true }
    return anonRefListElemKeyOf(valIx) != ""
  }
  false
}

// The struct row a ref list literal's elements name: the first element's, when every other
// element is an object literal of that row or `null` (a `ref null` slot holds it), else -1.
// A mixed `[{ x: 1 }, "t"]` is a union list, which the arena names instead (D4688).
function arrLitRefListRow(a: ArrayLit): i32 {
  if a.arrElems.length < 1 { return -1 }
  const si = structIndexOfObj(a.arrElems[0])
  if si < 0 { return -1 }
  let j = 1
  while j < a.arrElems.length {
    const aej = nodeAt(a.arrElems[j])
    if !(aej is NullLit) {
      if !(aej is ObjLit) { return -1 }
      if structIndexOfObj(a.arrElems[j]) != si { return -1 }
    }
    j = j + 1
  }
  si
}

// The syntax half of `anonFieldCode` — the field value's own literal form. Kept separate
// so the recorded-type fallback above cannot shadow a context-adopted literal rep: every
// arm here is a fact about the literal the checker's recorded type either does not carry
// or carries less exactly.
function anonFieldCodeSyn(valIx: i32) {
  const e = nodeAt(valIx)
  match e {
    // A literal field is a slot of the width the literal is built at.
    NumLit => {
      const w = numLitWidth(valIx, -1)
      if w == "i64" { return FC_I64 }
      if w == "f64" { return FC_F64 }
      if w == "f32" { return FC_F32 }
      return FC_I32
    }
    BoolLit => {
      return FC_I32
    }
    StrLit => {
      return FC_STR
    }
    FuncDecl => {
      return FC_CLOSURE
    }
    Ident => {
      // A tagged set's member is its id, which the recorded type codes.
      if fnTagTyIsTagged(nodeTyIxOf(valIx)) { return -1 }
      const d = identDeclOf(valIx)
      if d >= 0 && nodeAt(d) is FuncDecl { return FC_CLOSURE }
      return -1
    }
    // An arithmetic field value is i32 unless the arena says otherwise; a `+` whose operand
    // is a string literal is a concat, not classifiable here.
    BinExpr => {
      const bop = e.binOp
      if bop == "-" || bop == "*" || bop == "/" || bop == "%" {
        return anonArithFieldCode(valIx)
      }
      if bop == "+" {
        // Whole chain, not one level: `"a" + f(x) + g(y)` associates left, so its outermost
        // `+` has neither operand a string literal. Reading that as arithmetic would code
        // the field i32 and then store a string ref into it.
        if plusChainHasStrLit(valIx) { return -1 }
        // A concat of string VALUES has no literal in its chain: the recorded type says string,
        // and the arena rung below codes it (D2305).
        if tyPrimNameOf(nodeTyIxOf(valIx)) == "string" { return -1 }
        // A list concatenation is a list, never arithmetic: the arena rung codes its field the
        // way it codes any other list-valued one (D2382).
        if nodeTyIsArrayish(valIx) { return -1 }
        return anonArithFieldCode(valIx)
      }
      return -1
    }
    // A numeric-element array literal field: an i32 list (code 4), or the f64/i64 scalar-list
    // codes (25/26) when any element is a float or i64-magnitude literal — the same leaf split
    // the NumLit field takes. All elements scan, since coding by the first element alone let a
    // mixed-magnitude list intern an i32-list field and emit an i64 const into the i32 array.
    ArrayLit => {
      if e.arrElems.length > 0 {
        const ae0 = nodeAt(e.arrElems[0])
        if ae0 is NumLit {
          let anyFloat = false
          let anyI64 = false
          let anyRuntime = false
          let i = 0
          while i < e.arrElems.length {
            const ae = nodeAt(e.arrElems[i])
            if ae is NumLit {
              const w = numLitWidth(e.arrElems[i], -1)
              if w == "f64" || w == "f32" { anyFloat = true }
              else if w == "i64" { anyI64 = true }
            } else {
              anyRuntime = true
            }
            i = i + 1
          }
          // Mixed float and i64-magnitude literals join as a checker-level union, not a
          // scalar list — unclassifiable here (-1), the loud path.
          if anyFloat && anyI64 { return -1 }
          let lc = FC_I32_LIST
          if anyFloat { lc = FC_F64_LIST }
          else if anyI64 { lc = FC_I64_LIST }
          // A runtime element can make the list wider than its literals, or a list of a number
          // union: the arena rung codes the list the checker typed.
          if anyRuntime && anonListWiderThanLits(valIx, lc) { return -1 }
          return lc
        }
        // A list-of-anonymous-struct field is the struct ref list, code 5: the parser
        // interns children before parents, so each element literal already has its own row.
        // Every element must resolve to the same row, or coding it 5 would intern a field
        // whose `sFieldElemName` names one arm while its values build another (D1443).
        if ae0 is ObjLit {
          const e0si = structIndexOfObj(e.arrElems[0])
          if e0si < 0 { return -1 }
          let j = 1
          while j < e.arrElems.length {
            const aej = nodeAt(e.arrElems[j])
            if !(aej is ObjLit) { return -1 }
            if structIndexOfObj(e.arrElems[j]) != e0si { return -1 }
            j = j + 1
          }
          return FC_REF_LIST
        }
      }
      return -1
    }
    // A nested object-literal field is a nested-struct ref (code 15) once the inner
    // literal's shape resolves — the parser interns children before parents, so a linear
    // collect sees it.
    ObjLit => {
      if structIndexOfObj(valIx) >= 0 { return FC_STRUCT }
      return -1
    }
    // A map-producing field value is a map field, code 19. The literal carries no
    // annotation, so both halves of the map's rep come off the type the checker recorded on
    // the call. The lowerability gate is the same one the annotated field position uses: an
    // unsupported value type leaves the shape un-interned and the literal fails loudly.
    Call => {
      if nodeTyIsMap(valIx) {
        if mapNodeValKindLowerable(valIx) { return FC_MAP }
      }
      return -1
    }
    // No other expression has a literal form this field code reads.
    CharLit | NullLit | Unary | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// The `sFieldElemName` entry for an anonymous-shape field: a map field (code 19) records
// its value name, read off the recorded type instead of an annotation; a code-15 field
// records the nested struct's table name. "" otherwise.
export function anonFieldElemName(valIx: i32, code: i32) {
  if code == FC_MAP { return anonMapValName(nodeTyIxOf(valIx)) }
  // A nullable map field (code 29) records the `| null`-peeled map's value name — the same
  // mv-slot key `shapeFieldElemName`'s code-29 arm reads off the declared spelling, so one
  // map value type is one key at both codes (D1665).
  if code == FC_NUL_MAP { return anonMapValName(anonNulInnerTyOf(valIx)) }
  // A value-union field (code 16) records its member set, the same column
  // `shapeFieldElemName` fills from the declared spelling. Supplying it is what admits
  // code 16 to `anonFieldCode` at all (D1242).
  if code == FC_UNION { return anonUnionFieldName(valIx) }
  // A struct-ref-list field (code 5) records its element row's name — the companion the
  // emitter resolves the list's element heap type through, the same bargain code 16
  // struck (D1443).
  if code == FC_REF_LIST {
    const av = nodeAt(valIx)
    if av is ArrayLit {
      const esi = arrLitRefListRow(av)
      // A `null` element keeps its niche in the key, the spelling the arena route gives
      // `[p, null]`, so the element read is classified nullable (D4721).
      if esi >= 0 && arrLitHasNullElem(av) { return sNames[esi] + "|null" }
      if esi >= 0 { return sNames[esi] }
    }
    // D1515/D1688 — the arena, once the literal route has declined: a list produced by
    // anything but an array literal of object literals has no element node, so the recorded
    // element type names the row, or, for an element no row names, its own nominal key. An
    // empty literal is one of those: a later push pinned its element in place.
    return anonRefListElemKeyOfTy(nodeTyIxOf(valIx))
  }
  // A nullable ref-list field (code 28) records its ELEMENT's key, read off the type rather
  // than the `| null` spelling the literal does not carry — the same ladder code 5 uses, on
  // the peeled inner array, so one element type is one key at both codes (D1627, D1663).
  if code == FC_NUL_REF_LIST {
    return anonRefListElemKeyOfTy(anonNulInnerTyOf(valIx))
  }
  // A `K | null` niche field (code 30) records the non-null union's NAME, the same value
  // `shapeFieldElemName`'s code-30 arm gives the declared twin — without it the atom rep and
  // its membership are unrecoverable, so the admission rule below refused the field (D1710).
  if code == FC_NUL_LIT_UNION {
    const nla = litUnionAliasNameOfTy(anonNulInnerTyOf(valIx))
    if nla != "" { return nla }
    return nulLitAliasNameOfTy(nodeTyIxOf(valIx))
  }
  // The non-null twin of that arm, paired with the code-0 rung in `anonFieldCode`: a literal
  // union records its NAME so the atom's membership survives the mint. Self-gating, since the
  // reader answers "" for the plain `i32` and `boolean` values that share code 0 (D1757).
  if code == FC_I32 { return litUnionAliasNameOfTy(nodeTyIxOf(valIx)) }
  // A string field (code 3) records no member set. An inline literal union usually takes
  // code 0 through its hidden alias first (D1783); one that does not is laid out and read
  // as a plain string field.
  if code != FC_STRUCT { return "" }
  const si = structIndexOfObj(valIx)
  if si >= 0 { return sNames[si] }
  // The value is not always a literal, and its row usually already exists (D1543): a field
  // fed by a binding, call, or member read has no child literal to read a row off. The
  // missing piece is the reverse lookup from the value's recorded type to the row — the
  // declared name first, then a field-set match on the type.
  const nvt = nodeTyIxOf(valIx)
  if nvt < 0 { return "" }
  if nodeTyIsObj(valIx) {
    // A declared record's row is read off its arena type, since its spelling can be
    // exponential in its depth (D2780). An anonymous one keeps the spelling-first order.
    const ri = structIndexOfTy(nvt)
    if ri >= 0 && ri < sRowDecl.length && sRowDecl[ri] == 1 {
      const dr = structRowOfObjFieldSet(nvt)
      if dr >= 0 { return sNames[dr] }
    }
    // A deep anonymous one is read off its structural id before any spelling, which a shared
    // sub-record doubles per level (D9930).
    if tyDeeperThan(nvt, 8) {
      const sr = repRowOfTyStruct(nvt, sScanLim())
      if sr >= 0 { return sNames[sr] }
    }
    const cn = nodeTyCanonObjName(valIx)
    if cn != "" {
      const bn = structIndexOfTypeNameTy(cn, nvt)
      if bn >= 0 { return sNames[bn] }
    }
    const fsr = structRowOfObjFieldSet(nvt)
    if fsr >= 0 { return sNames[fsr] }
    return ""
  }
  // The nullable twin, which `fieldCodeForMatch` already folds onto the same code 15: peel
  // and ask the inner's row, so `{ item: mkMaybe() }` over a `Rec | null` names `Rec` too.
  const nvr = tyAt(nvt)
  if nvr is TyNullable {
    const inr = structRowOfObjFieldSet(nvr.nInner)
    if inr >= 0 { return sNames[inr] }
  }
  ""
}

// True if the binding at `letIx` is un-annotated and its initializer is a literal-union atom.
// Such a local holds an i32 atom id, so it must be the i32 atom slot, not the string ref slot
// its checker type would otherwise pick — which stores the atom into a `(ref $array)` cell,
// invalid wasm.
export function letInitIsLitAtom(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType < 0 && d.letInit >= 0 { return exprIsLitAtom(d.letInit, fnIx) }
    // The annotated face, at any scope: the INITIALIZER is the gate, not the scope. An
    // annotation that softens to `string` over a non-atom init produces no atom, so this
    // declines it and the loud refusal stands for that shape (D1752).
    if d.letInit >= 0 {
      if nodeRepIsAtom(d.letType, fnIx) {
        return exprIsLitAtom(d.letInit, fnIx)
      }
    }
  }
  false
}

// True when the binding at `bindIx` (a `Param` or `LetDecl`) holds an interned i32 atom
// rather than a member string — the one question every channel of `exprIsLitAtom` asks about
// a declaration site, matching `vtKindOfType`'s slot sizing. `ownerFnIx` is the frame the
// binding lives in (-1 at module scope), since the un-annotated arm resolves the initializer there.
export function bindingIsLitAtom(bindIx: i32, ownerFnIx: i32) {
  if bindIx < 0 { return false }
  const bn = nodeAt(bindIx)
  match bn {
    Param => {
      // The parameter's own type at its frame, which for an instance copy is the instance's.
      return nodeRepIsAtom(bindIx, ownerFnIx)
    }
    LetDecl => {
      return letBindIsAtom(bindIx, ownerFnIx)
    }
    LoopVar => {
      return letBindIsAtom(bindIx, ownerFnIx)
    }
    // No other binding is a literal atom.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread => {}
  }
  false
}

// The `K | null` NICHE dual of `bindingIsLitAtom`: the binding holds the same i32 atom with
// the spare `-1` encoding null (no box).
function bindingIsNulLitUnion(bindIx: i32, ownerFnIx: i32) {
  if bindIx < 0 { return false }
  const bn = nodeAt(bindIx)
  match bn {
    Param => {
      return nodeRepIsNulAtom(bindIx, ownerFnIx)
    }
    LetDecl => {
      return letBindIsNulAtom(bindIx, ownerFnIx)
    }
    LoopVar => {
      return letBindIsNulAtom(bindIx, ownerFnIx)
    }
    // No other binding is a nullable literal union.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread => {}
  }
  false
}

// True when `name` is a captured variable of lifted function `fnIx` whose enclosing-frame
// binding holds an i32 atom — the capture channel of `exprIsLitAtom`, which otherwise
// resolves an identifier through the reader's own locals, params, and module globals, none
// of which a capture is. Without it a captured atom read as a string, `print` printing the raw id.
function capturedIsLitAtom(fnIx: i32, name: string) {
  const fe = capturedFrameOf(fnIx, name)
  if fe < 0 { return false }
  const b = parentBindingOf(fe, name)
  if b >= 0 {
    // Asked off the initializer from the capturing frame, as `captureValKind` sizes the env
    // field, so a parent local the read names answers from its own declaration (D7441).
    const askWas = capInitAsk
    capInitAsk = true
    const at = bindingIsLitAtom(b, parentBindingFrameArenaOf(fe, name))
    capInitAsk = askWas
    if at { return true }
  }
  const lv = capturedLoopVarName(fe, name, b)
  if lv == "" { return false }
  const lvd = captureLoopVarDeclOf(fe, lv)
  if lvd < 0 { return false }
  bindingIsLitAtom(lvd, parentBindingFrameArenaOf(fe, lv))
}

// The loop variable a capture `name` of lifted frame `fe` reads, whose binding is `b`: itself
// when it has no binding, the variable a bare un-annotated copy names, or "" (D3119).
function capturedLoopVarName(fe: i32, name: string, b: i32): string {
  if b < 0 { return name }
  const bn = nodeAt(b)
  if !(bn is LetDecl) { return "" }
  if bn.letType >= 0 || bn.letInit < 0 { return "" }
  if !(nodeAt(unwrapParen(bn.letInit)) is Ident) { return "" }
  captureLoopCopySrc(fe, name)
}

// Whether a `for-in` variable over `iterIx`, walked in frame `fnIx`, holds an interned atom:
// a literal-union element or its niche, a literal-union map key, or an element that is one only
// at the instance's pin. `ek` is the iterable's `forInElemKind`. The loop variable's storage
// cell (`loopVarCellGo`) is its one reader.
function forInVarIsLitAtom(iterIx: i32, fnIx: i32, ek: VKind | null): boolean {
  // A string list holds refs whatever literal-union list an `is` narrowed it to (D4916).
  if exprListRep(iterIx, fnIx) == "strlist" { return false }
  if nodeArrayElemIsLitUnion(iterIx) || nodeArrayElemIsNulLitUnion(iterIx) {
    return true
  }
  if nodeTyMapKeyIsLitUnion(iterIx) { return true }
  if ek != "i32" { return false }
  const hp = iterElemPinTy(iterIx, fnIx)
  if hp >= 0 { return tyIsLitUnion(hp) || tyIsNulLitUnionNiche(hp) }
  false
}

// The second name's twin: a map walk's literal-union value (D2656).
function forInPairVarIsLitAtom(iterIx: i32, fnIx: i32): boolean {
  if !forInPairIsMapVal(iterIx, fnIx) { return false }
  nodeTyMapValIsLitUnion(iterIx) || nodeTyMapValIsNulLitUnion(iterIx)
}

// The niche dual of `capturedIsLitAtom` — `exprNulLitUnion`'s capture channel. A `K | null`
// capture rides the same i32 env field (`vtKindOfType` answers "i32" for both spellings), so
// both classifiers need the channel or the two spellings disagree about one field.
function capturedIsNulLitUnion(fnIx: i32, name: string) {
  const fe = capturedFrameOf(fnIx, name)
  if fe < 0 { return false }
  const b = parentBindingOf(fe, name)
  if b >= 0 {
    // From the capturing frame, as `capturedIsLitAtom` asks (D7441).
    const askWas = capInitAsk
    capInitAsk = true
    const at = bindingIsNulLitUnion(b, parentBindingFrameArenaOf(fe, name))
    capInitAsk = askWas
    if at { return true }
  }
  const lv = capturedLoopVarName(fe, name, b)
  if lv == "" { return false }
  const lvd = captureLoopVarDeclOf(fe, lv)
  if lvd < 0 { return false }
  bindingIsNulLitUnion(lvd, parentBindingFrameArenaOf(fe, lv))
}

// Does the list LITERAL at `arrIx` lower its elements as interned atoms? A non-literal array
// is not this question and answers true, since its own declaration fixed the rep. The one place
// the element-pin reader asks about a REP rather than a type (D1756).
function arrLitElemRepIsAtom(arrIx: i32, fnIx: i32): boolean {
  const a = nodeAt(unwrapParen(arrIx))
  if a is ArrayLit {
    if a.arrElems.length < 1 { return true }
    return exprIsLitAtom(a.arrElems[0], fnIx)
  }
  true
}

// The element arena type of the array expression `arrIx` when that element is a literal
// union, or -1. `nodeArrayElemIsLitUnion` is exactly the `tyIsLitUnion` of its direct half.
export function arrElemLitUnionTy(arrIx: i32, fnIx: i32) {
  arrElemLitUnionTyAt(arrIx, fnIx, 0)
}

function arrElemLitUnionTyAt(arrIx: i32, fnIx: i32, depth: i32): i32 {
  if arrIx < 0 { return 0 - 1 }
  const direct = nodeArrayElemTyIx(arrIx)
  if tyIsLitUnion(direct) { return direct }
  // The banked PIN's element, where the array node records nothing of its own: a container
  // reached through an un-annotated parameter is one, and `nodeTyPinIxOf` falls back to the
  // recorded type wherever no pin exists, so this is a strict widening (D1693, D1545).
  const pinElem = tyStepElem(nodeTyPinIxOf(unwrapParen(arrIx)))
  if tyIsLitUnion(pinElem) { return pinElem }
  // The ELEMENT's own pin. A container whose own type is not a hole can still have one for its
  // element — `const xs = [a]` over a hole parameter records `<hole>[]` — and every rung above
  // asks the container, so this is the only one that reaches the pinned litunion (D1725).
  const pinElemHole = pinnedHoleTyOf(nodeArrayElemTyIx(arrIx))
  if tyIsLitUnion(pinElemHole) {
    // A list LITERAL's rep comes from what its elements LOWER as, not from the type they pin
    // to: a parameter pinned at the softened `string` carries the same literal union as one
    // pinned at an alias, and only the first builds a string list. `exprIsLitAtom` is that rep
    // question, and this reader has the frame it needs (D1756).
    if arrLitElemRepIsAtom(arrIx, fnIx) { return pinElemHole }
  }
  if depth >= declFallbackDepthCap() { return 0 - 1 }
  const n = nodeAt(unwrapParen(arrIx))
  if n is Ident {
    const d = bindingDeclInScope(unwrapParen(arrIx))
    if d >= 0 { return declLitUnionTyAt(d, fnIx, depth, true) }
    const pElem = nodeArrayElemTyIx(paramTypeNodeOfRead(fnIx, arrIx))
    if tyIsLitUnion(pElem) { return pElem }
  }
  0 - 1
}

// The literal-union arena type an atom-repped expression's members come from, or -1 — the
// `arrElemLitUnionTy` dual for a value that is the atom rather than the array holding it.
export function litAtomMemberTy(exprIx: i32, fnIx: i32) {
  litAtomMemberTyAt(exprIx, fnIx, 0)
}

// The member texts of `ix` when it holds the `K | null` niche, empty otherwise. A node an
// instance shares with its generic body records the type parameter, so the instance's pin is
// read in its place (D2978).
export function nulLitAtomTexts(ix: i32, fnIx: i32): string[] {
  nulLitAtomTextsAt(ix, fnIx, 0)
}

// `nulLitAtomTexts` through at most `declFallbackDepthCap` un-annotated local initializers.
function nulLitAtomTextsAt(ix: i32, fnIx: i32, depth: i32): string[] {
  const own = nodeNulLitUnionMemberTexts(ix)
  if own.length > 0 { return own }
  const hole = tyNulLitUnionMemberTexts(holeOperandTyOf(ix, fnIx))
  if hole.length > 0 { return hole }
  const lv = tyNulLitUnionMemberTexts(loopVarPinTyOf(ix, fnIx))
  if lv.length > 0 { return lv }
  // A join with a `null` arm holds its other arm's atom or `-1`, so a field read there names it.
  const thIx = nulArmIfThenValueIx(ix, fnIx)
  if thIx >= 0 {
    const th = memberAtomFieldTexts(thIx, fnIx)
    if th.length > 0 { return th }
  }
  const e = nodeAt(unwrapParen(ix))
  if e is Index {
    const elem = tyNulLitUnionMemberTexts(holeNulLitElemTy(e.idxArr, fnIx))
    if elem.length > 0 { return elem }
    // A read off an atom-valued map is `K | null` at either value spelling: a miss is `-1`.
    const mv = mapTyValLitUnionTexts(mapRecvTyIn(e.idxArr, fnIx))
    if mv.length > 0 && !nodeTyProvesNonNull(unwrapParen(ix)) { return mv }
  }
  // A `??` over such a read keeps the `-1` when its default can be null.
  const cmv = coalMapReadNulAtomTexts(ix, fnIx)
  if cmv.length > 0 { return cmv }
  // So does a `??` over a nullable atom whose nullable default holds that same atom.
  if (
    e is BinExpr
    && e.binOp == "??"
    && coalesceDefaultNullable(e.binRight, fnIx)
  ) {
    const cl = nulLitAtomTextsAt(e.binLeft, fnIx, depth)
    if (
      cl.length > 0
      && textsInOrder(cl, nulLitAtomTextsAt(e.binRight, fnIx, depth))
    ) {
      return cl
    }
  }
  // A call of a named function, whose return annotation `exprNulLitUnion` claimed it by.
  if e is Call && e.callFn >= 0 && nodeAt(e.callFn) is Ident {
    const t = fnIndexOfNode(e.callFn)
    if t >= 0 {
      const cf = nodeAt(fnStmts[t])
      if cf is FuncDecl && cf.fnRet >= 0 {
        return nodeNulLitUnionMemberTexts(cf.fnRet)
      }
    }
  }
  // An instance's parameter or local, whose declaration is what `exprNulLitUnion` claimed it by.
  if e is Ident && depth < declFallbackDepthCap() {
    const pt = paramTypeNodeOfRead(fnIx, unwrapParen(ix))
    if pt >= 0 { return nodeNulLitUnionMemberTexts(pt) }
    let d = bindingDeclInScope(unwrapParen(ix))
    // Outside the emit walk no scope is open, so the body's own declaration answers, as it
    // does for `exprNulLitUnion`.
    if d < 0 && fnIx >= 0 {
      const dfn = nodeAt(fnIx)
      if dfn is FuncDecl { d = bodyLetOfRead(dfn.fnBody, unwrapParen(ix)) }
    }
    // A capture's declaration is in the frame that owns it, and classifies there (D7441).
    if d < 0 {
      const fe = capturedFrameOf(fnIx, e.identName)
      const b = if fe >= 0 { parentBindingOf(fe, e.identName) } else { -1 }
      if b >= 0 {
        const bn = nodeAt(b)
        if bn is LetDecl && bn.letType < 0 && bn.letInit >= 0 {
          const pfn = parentBindingFrameArenaOf(fe, e.identName)
          const askWas = capInitAsk
          capInitAsk = true
          const ct = nulLitAtomTextsAt(bn.letInit, pfn, depth + 1)
          capInitAsk = askWas
          return ct
        }
      }
    }
    if d >= 0 {
      const dn = nodeAt(d)
      if dn is LetDecl {
        if dn.letType >= 0 { return nodeNulLitUnionMemberTexts(dn.letType) }
        if dn.letInit >= 0 {
          return nulLitAtomTextsAt(dn.letInit, fnIx, depth + 1)
        }
      }
    }
  }
  tyNulLitUnionMemberTexts(exactOperandTyOf(ix, fnIx))
}

// The member texts of the atom FIELD a `recv.f` read lands on, from the row's own sidecar. A
// literal whose checked type is `{f: string}` can share the row a literal-union field minted,
// so the row, not the read's recorded type, is what names the members (D2151). A field every
// arm of a struct union stores as an atom names every set its members' rows hold (D5164).
export function memberAtomFieldTexts(ix: i32, fnIx: i32): string[] {
  const e = nodeAt(unwrapParen(ix))
  if e is Member {
    const vis: i32[] = []
    const fis: i32[] = []
    const ux = unwrapParen(ix)
    if sharedUnionFieldPlan(e.memObj, e.memProp, ux, fnIx, vis, fis) == FC_I32 {
      const texts: string[] = []
      let k = 0
      while k < vis.length {
        for t in sharedFieldArmLitTexts(vis[k], fis[k]) {
          pushUniqueAtom(texts, t)
        }
        k = k + 1
      }
      if texts.length > 0 { return texts }
    }
    // A variant receiver's atom field names its own set, as `exprIsLitAtomMember` claims it.
    const vi = memRecvVariantIndex(e, ux, fnIx)
    if vi >= 0 {
      const vfi = variantFieldIndex(vi, e.memProp)
      if vfi >= 0 && variantFieldIsLitUnion(vi, vfi) {
        return sharedFieldArmLitTexts(vi, vfi)
      }
    }
    const si = structIndexOfExpr(e.memObj, fnIx)
    if si >= 0 {
      const fi = sFieldIndex(si, e.memProp)
      if fi >= 0 && sFieldIsLitUnion(si, fi) {
        return tyLitMemberTexts(sFieldElemTyIxAt(si, fi))
      }
    }
    // An instance's hole receiver, read where no narrowing is open: its pin's every record arm
    // stores the field as an atom of a literal set.
    if fnInPinnedInstance(fnIx) {
      return holeRecvAtomFieldTexts(e.memObj, e.memProp, fnIx)
    }
  }
  const none: string[] = []
  none
}

// The member texts of field `prop` over every record arm of hole receiver `recvIx`'s pin, a
// `null` arm skipped; empty when any arm lacks the field or stores it as anything but a set.
function holeRecvAtomFieldTexts(
  recvIx: i32,
  prop: string,
  fnIx: i32,
): string[] {
  const none: string[] = []
  const rt = holeOperandTyOf(recvIx, fnIx)
  if rt < 0 || rt >= T.tys.length { return none }
  const arms: i32[] = []
  const r = tyAt(rt)
  if r is TyUnion {
    for m in r.uMembers { arms.push(m) }
  } else {
    arms.push(rt)
  }
  const texts: string[] = []
  for m in arms {
    if tyPrimNameOf(m) != "null" {
      const ft = tyFieldTyOf(m, prop)
      if !tyIsLitUnion(ft) && !tyIsOneStrLit(ft) { return none }
      for t in tyLitMemberTexts(ft) { pushUniqueAtom(texts, t) }
    }
  }
  texts
}

// The element type of receiver `arrIx`, which a hole instance `fnIx` pins to a list; -1 for any
// other receiver, and for a list literal built as strings, whose elements are no atom niche.
function holeNulLitElemTy(arrIx: i32, fnIx: i32): i32 {
  if idxRecvIsStrList(arrIx, fnIx) { return -1 }
  const rt = holeOperandTyOf(arrIx, fnIx)
  if rt < 0 { return holeArrElemPinTyOf(arrIx, fnIx) }
  tyStepElem(rt)
}

// True when `a` and `b` hold the same texts in the same order, so their atom ids agree.
function textsInOrder(a: string[], b: string[]): boolean {
  if a.length != b.length { return false }
  let i = 0
  while i < a.length {
    if a[i] != b[i] { return false }
    i = i + 1
  }
  true
}

// The member texts of a `??` at `ix` over a read off an atom-valued map whose default can be
// null, so the result keeps the `-1` niche; empty for any other expression.
function coalMapReadNulAtomTexts(ix: i32, fnIx: i32): string[] {
  const none: string[] = []
  const u = unwrapParen(ix)
  if u < 0 { return none }
  const e = nodeAt(u)
  if !(e is BinExpr) || e.binOp != "??" { return none }
  if !coalesceDefaultNullable(e.binRight, fnIx) { return none }
  coalMapReadChainTexts(u, fnIx)
}

// The member texts of the `??` chain at `u` whose leftmost operand is a read off an atom-valued
// map and each of whose defaults that read's atom rep holds; empty for any other expression.
// A chain groups left, so `m[a] ?? m[b] ?? d` is found through its left spine (D7444).
function coalMapReadChainTexts(u: i32, fnIx: i32): string[] {
  const none: string[] = []
  const e = nodeAt(u)
  if !(e is BinExpr) || e.binOp != "??" { return none }
  const l = unwrapParen(e.binLeft)
  if l < 0 { return none }
  const cr = fusedMapReadRecvIx(l)
  if cr >= 0 {
    if coalMapReadForeignDefault(cr, e.binRight, fnIx) { return none }
    return mapTyValLitUnionTexts(mapRecvTyIn(cr, fnIx))
  }
  const texts = coalMapReadChainTexts(l, fnIx)
  if texts.length == 0 { return none }
  if !coalesceLitUnionDefaultIsAtom(e.binRight, texts, fnIx) { return none }
  texts
}

// `callResultAtomTexts`'s type: the callee's result where it names member texts, else -1. An
// inferred result's returned expression is read `depth` hops into the declaration walk.
export function callResultAtomTyAt(ix: i32, fnIx: i32, depth: i32): i32 {
  const c = unwrapParen(ix)
  if c < 0 { return -1 }
  const cn = nodeAt(c)
  if cn is Call {
    const ft = cloCallCalleeFnTy(c, fnIx)
    if ft >= 0 {
      const t = tyAt(ft)
      if t is TyFunc {
        if tyLitMemberTexts(t.fnRet).length > 0 { return t.fnRet }
      }
    }
    if cn.callFn < 0 { return -1 }
    if nodeAt(cn.callFn) is Ident {
      const target = fnIndexOfNode(cn.callFn)
      if target >= 0 {
        const cf = nodeAt(fnStmts[target])
        if cf is FuncDecl {
          if cf.fnRet >= 0 { return nodeTyIxOf(cf.fnRet) }
          // An inferred atom result whose checked type is wider than the atom — the value of
          // an assignment to a literal-union cell types as the right-hand side's `string` —
          // takes its members from the returned expression, the same one `fRetLitAtom` read.
          if target < fRetLitAtom.length && fRetLitAtom[target] == 1 {
            const rx = fnRetExprOf(fnStmts[target])
            if rx >= 0 { return litAtomMemberTyAt(rx, fnStmts[target], depth) }
          }
        }
      }
    }
  }
  -1
}

function litAtomMemberTyAt(exprIx: i32, fnIx: i32, depth: i32): i32 {
  if exprIx < 0 { return 0 - 1 }
  const ix = unwrapParen(exprIx)
  if ix < 0 { return 0 - 1 }
  const e = nodeAt(ix)
  // An assignment's atom is its target's re-read, so the target's type names the members,
  // not the right-hand side's narrower one.
  match e {
    BinExpr => {
      if e.binOp == "=" { return litAtomMemberTyAt(e.binLeft, fnIx, depth) }
    }
    // Every other expression is resolved by the rungs below.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  const direct = nodeTyAt(ix, fnIx)
  if tyIsLitUnion(direct) { return direct }
  if depth >= declFallbackDepthCap() { return 0 - 1 }
  match e {
    Index => {
      return arrElemLitUnionTyAt(e.idxArr, fnIx, depth + 1)
    }
    Call => {
      // A call an instance shares with its generic body records the type parameter, so its callee's
      // result names the members: an un-annotated local's initializer (D3017).
      if direct < 0 || tyHasTyVar(direct) {
        const cr = callResultAtomTyAt(ix, fnIx, depth + 1)
        if tyIsLitUnion(cr) { return cr }
      }
    }
    Member => {
      // A field every arm of a struct union stores as an atom names the set its members' rows hold,
      // whatever an instance's shared read recorded (D5164).
      const vis: i32[] = []
      const fis: i32[] = []
      if (
        sharedUnionFieldPlan(e.memObj, e.memProp, ix, fnIx, vis, fis)
        == FC_I32
      ) {
        const st = sharedFieldPlanLitTy(vis, fis)
        if tyIsLitUnion(st) { return st }
      }
    }
    Ident => {
      // A field read names its row's atom field members, as `memberAtomFieldTexts` reads them: a
      // hole parameter's read records the hole, and its pinned row holds the set (D2866).
      const slot = declaredSlotOf(ix)
      if slot >= 0 {
        // A for-in element loop var IS the array's element, so its members come from the
        // ITERABLE — the one storage class with no declaration node to read, so it is asked
        // ahead of the declaration walk rather than through it.
        const iter = localLoopIter[slot]
        if iter >= 0 {
          const lvTy = arrElemLitUnionTyAt(iter, fnIx, depth + 1)
          if lvTy >= 0 { return lvTy }
          // …or read at the instance's pin, where the iterable records a type parameter (D2983).
          const lvPin = loopVarPinTyOf(ix, fnIx)
          if tyIsLitUnion(lvPin) { return lvPin }
          return 0 - 1
        }
      }
      const d = bindingDeclInScope(ix)
      if d >= 0 { return declLitUnionTyAt(d, fnIx, depth, false) }
      const pTy = nodeTyIxOf(paramTypeNodeOfRead(fnIx, ix))
      if tyIsLitUnion(pTy) { return pTy }
    }
    // No other expression names a literal-atom union member.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  0 - 1
}

// The two above, asked of a `LetDecl`: its annotation when it has one, else its initializer
// one hop deeper. `wantElem` picks which question — the declaration's element type or the
// declaration's own type.
function declLitUnionTyAt(
  declIx: i32,
  fnIx: i32,
  depth: i32,
  wantElem: boolean,
): i32 {
  const d = nodeAt(declIx)
  if d is LetDecl {
    if d.letType >= 0 {
      if wantElem {
        const aTy = nodeArrayElemTyIx(d.letType)
        if tyIsLitUnion(aTy) { return aTy }
        return 0 - 1
      }
      const lTy = nodeTyIxOf(d.letType)
      if tyIsLitUnion(lTy) { return lTy }
      return 0 - 1
    }
    if d.letInit >= 0 {
      if wantElem { return arrElemLitUnionTyAt(d.letInit, fnIx, depth + 1) }
      return litAtomMemberTyAt(d.letInit, fnIx, depth + 1)
    }
  }
  0 - 1
}

// Does index receiver `arrIx` denote a local bound to a list LITERAL whose elements lower as
// string refs? An annotated binding is not this question — its annotation fixed the rep — and
// neither is a parameter or a global, both of which reach their elements by another route.
export function idxRecvIsStrList(arrIx: i32, fnIx: i32) {
  if fnIx < 0 { return false }
  // An instance's string-list parameter narrowed to a literal-union list by `is` (D4916).
  if exprListRep(arrIx, fnIx) == "strlist" { return true }
  const n = nodeAt(unwrapParen(arrIx))
  if n is Ident {
    const d = bindingDeclInScope(unwrapParen(arrIx))
    if d < 0 { return false }
    const dn = nodeAt(d)
    if dn is LetDecl {
      if dn.letType >= 0 { return false }
      if dn.letInit < 0 { return false }
      const iv = nodeAt(unwrapParen(dn.letInit))
      if iv is ArrayLit { return arrLitIsStr(dn.letInit, fnIx) }
    }
  }
  false
}

// True if `exprIx` is a literal-union atom value (an i32 id) — a litunion-flagged local or a
// litunion-annotated param. Distinguishes a real atom from a checker-inferred literal union.
export function exprIsLitAtom(exprIx: i32, fnIx: i32) {
  if gLitUnionUsed == 0 { return false }
  // A `K | null` niche binding or call holds an i32 atom id (or the -1 null sentinel). Any
  // position that consumes it as an atom has the checker narrowing it non-null first, so it
  // is a valid atom, with member texts from the node's narrowed type.
  if exprNulLitUnion(exprIx, fnIx) { return true }
  // `p ?? d` over the `K | null` niche is an atom in both halves — a non-null default
  // coalesces the sentinel away to leave the plain atom id, so this asks only whether the
  // rep survives (`coalesceLitUnionFits`). Without it an inferred `const v = p ?? "a"` bound
  // a bare i32 and every atom consumer saw a number instead of the member.
  if coalesceLitUnionFits(exprIx, fnIx) { return true }
  // A node the generic body shares, typed at a hole this instance pins to a literal union,
  // which every rung below reads at the hole (D2942).
  if (
    tyIsLitUnion(holeOperandTyOf(exprIx, fnIx))
    && holeLitReadIsAtom(exprIx, fnIx, 0)
  ) {
    return true
  }
  const e = nodeAt(unwrapParen(exprIx))
  match e {
    BinExpr => {
      // An assignment's value is lowered as a re-read of its target, so it is an atom exactly
      // when that target is one whose members are known (D2168).
      if e.binOp == "=" {
        if !assignTargetReReads(unwrapParen(exprIx), fnIx) { return false }
        if litAtomMemberTy(e.binLeft, fnIx) < 0 { return false }
        return exprIsLitAtom(e.binLeft, fnIx)
      }
      // `m[k] ?? d` over an atom-valued map yields the atom — the mono vals list holds ids.
      // The method spelling `m.get(k) ?? d` is the same fused get, so the receiver comes from
      // the one fused-read shape home rather than an `is Index` half-set; without the `.get`
      // half this classifier declined and `print` printed the raw atom id.
      if e.binOp == "??" {
        if coalRetypedDead(exprIx, unwrapParen(e.binLeft), fnIx) {
          return exprIsLitAtom(e.binLeft, fnIx)
        }
        const blRecv = fusedMapReadRecvIx(unwrapParen(e.binLeft))
        if blRecv >= 0 {
          if coalMapReadForeignDefault(blRecv, e.binRight, fnIx) {
            return false
          }
          return mapTyValIsLitUnion(mapRecvTyIn(blRecv, fnIx))
        }
      }
    }
    Ident => {
      return exprIsLitAtomIdent(e, exprIx, fnIx)
    }
    Index => {
      return exprIsLitAtomIndex(e, exprIx, fnIx)
    }
    IfStmt => {
      // A value if-expression joining two atoms yields an atom, since the join rep is the
      // bare i32 id. A mixed atom/string join is an atom too when the checker recorded a
      // registered literal union for it, which is the atom rep (`ifJoinTypedAtom`); otherwise it
      // types `string` and widens at the string-join seam, so it does not classify here.
      if e.ifElse < 0 { return false }
      if ifJoinTypedAtom(unwrapParen(exprIx), fnIx) { return true }
      // A join typed `string | null` is the nullable string ref, whatever atoms its arms hold.
      if nodeRepIs(unwrapParen(exprIx), "nulstr", fnIx) { return false }
      // A join `emitIfExpr` lowers as a union box is the box, whatever its arms are alone: a
      // generic's `a ?? 5` pinned at a literal union joins to `K | i32` (D3281).
      if (
        exprUnion(exprIx, fnIx)
        && ifJoinUnionNameIn(unwrapParen(exprIx), fnIx) != ""
      ) {
        return false
      }
      const tv = ifArmValueExpr(e.ifThen)
      if tv >= 0 {
        if exprIsLitAtom(tv, fnIx) {
          const eb = nodeAt(e.ifElse)
          // An `else if` chain recurses on the nested IfStmt directly.
          if eb is IfStmt { return exprIsLitAtom(e.ifElse, fnIx) }
          if eb is Block {
            const ev = ifArmValueExpr(e.ifElse)
            if ev >= 0 { return exprIsLitAtom(ev, fnIx) }
          }
        }
      }
      return false
    }
    Member => {
      return exprIsLitAtomMember(e, exprIx, fnIx)
    }
    Call => {
      return exprIsLitAtomCall(e, exprIx, fnIx)
    }
    AsExpr => {
      if e.asMode != "null" {
        const ax = unwrapParen(exprIx)
        if asExprBoxToLitUnion(ax, fnIx) {
          return asBoxLitUnionYieldsAtom(ax, fnIx)
        }
        return asExprLitAtomYieldsAtom(ax, fnIx)
      }
    }
    // No other expression is a literal atom.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// Whether `ix` is an `as` from a literal-union atom to a registered literal union (for `as?`,
// one or null), which lowers as a compare of the operand's id against the target's (D5286).
export function asExprLitAtomCast(ix: i32, fnIx: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if !(n is AsExpr) { return false }
  if n.asMode == "wrap" { return false }
  let tty = nodeTyIxOf(ix)
  if n.asMode == "null" { tty = tyPeelNul(tty) }
  if tyLitMemberTexts(tty).length == 0 { return false }
  if (
    litUnionAliasNameOfTy(tty) == ""
    && !asTargetRepsAtom(ix, n.asMode, fnIx)
    && !tyIsBareStrLit(tty)
  ) {
    return false
  }
  exprIsLitAtom(n.asObj, fnIx)
}

// Whether `as` node `ix` is an atom cast whose result is the atom too: not a lone literal target
// (`as! "a"`), whose result reps as its string (D5289).
export function asExprLitAtomYieldsAtom(ix: i32, fnIx: i32): boolean {
  if !asExprLitAtomCast(ix, fnIx) { return false }
  !tyIsBareStrLit(tyPeelNul(nodeTyIxOf(ix)))
}

// Whether `as` node `ix` is an atom cast to a lone literal (`as! "a"`), whose result is its
// string rather than the atom (D5289).
export function asExprLitAtomYieldsStr(ix: i32, fnIx: i32): boolean {
  if !asExprLitAtomCast(ix, fnIx) { return false }
  tyIsBareStrLit(tyPeelNul(nodeTyIxOf(ix)))
}

// Whether `ty` is a lone string literal type.
export function tyIsBareStrLit(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  if t is TyLit { return t.litKind == "str" }
  false
}

// Whether `as` node `ix` reps as the atom (`as?`: the nullable atom), so an inline target such
// as `as! "a"` or `as ("a" | "b")` takes the id compare too (D5289).
function asTargetRepsAtom(ix: i32, mode: string, fnIx: i32): boolean {
  if mode == "null" { return nodeRepIsNulAtom(ix, fnIx) }
  nodeRepIsAtom(ix, fnIx)
}

// Whether function `fnIx` returns a literal-union atom or its `| null` niche, so a propagating
// `as` over an atom can hand its miss back unchanged.
export function fnReturnsLitAtom(fnIx: i32): boolean {
  if fnIx < 0 || fnIx >= P.nodes.length { return false }
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return false }
  if fn.fnRet >= 0 {
    if nodeTyIsLitUnionAlias(fn.fnRet) || nodeTyIsNulLitUnion(fn.fnRet) {
      return true
    }
    return tyIsLitUnion(nodeTyIxOf(fn.fnRet))
  }
  const pos = fnStmtsPosOf(fnIx)
  pos >= 0 && pos < fRetLitAtom.length && fRetLitAtom[pos] == 1
}

// The `LetDecl` the name read at `exprIx` resolves to in frame `fnIx`, or -1 when it resolves to anything
// else. A monomorphized instance's read names the generic's declaration, so the frame's own copy
// is the slot collected for it, or the frame's binding of the name when the frame is not emitting.
export function readLetDeclOf(exprIx: i32, fnIx: i32): i32 {
  const u = unwrapParen(exprIx)
  const d = identDeclOf(u)
  if d < 0 || d >= P.nodes.length { return -1 }
  if !(nodeAt(d) is LetDecl) { return -1 }
  if fnIx < 0 || globalLetOfSid(sidOfNode(d)) == d { return d }
  if fnIx == emitCurFnIx {
    const s = declaredSlotOf(u)
    if s >= 0 { return localDeclIx[s] }
    return d
  }
  const fl = frameLetOf(fnIx, u)
  if fl >= 0 { return fl }
  d
}

// The loop-variable declaration a name read `exprIx` resolves to, or -1.
function readLoopVarDeclOf(exprIx: i32): i32 {
  const u = unwrapParen(exprIx)
  if u < 0 || u >= P.nodes.length || !(nodeAt(u) is Ident) { return -1 }
  const d = identDeclOf(u)
  if loopVarLoop(d) < 0 { return -1 }
  d
}

// The frame whose body declares a read's `let` or loop variable `decl` (or a copy minted from
// it): `fnIx` or the nearest enclosing frame, -1 for a module-scope binding (D14574).
function readDeclOwnerOf(decl: i32, fnIx: i32): i32 {
  const sid = sidOfNode(decl)
  if globalLetOfSid(sid) == decl { return -1 }
  let f = fnIx
  let pos = fnStmtsPosOf(fnIx)
  while f >= 0 {
    if frameDeclares(f, sid, decl) { return f }
    if pos < 0 || pos >= fnParent.length { return -1 }
    pos = fnParent[pos]
    if pos < 0 || pos >= fnStmts.length { return -1 }
    f = fnStmts[pos]
  }
  -1
}

// Whether frame `fnIx`'s body holds declaration `decl` (interned `sid`): a `let` or its copy
// (`bodyLetOfDecl`), or a loop whose variable it is.
function frameDeclares(fnIx: i32, sid: i32, decl: i32): boolean {
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return false }
  if loopVarLoop(decl) >= 0 {
    return parentLoopOfDecl(fn.fnBody, sid, decl) >= 0
  }
  bodyLetOfDecl(fn.fnBody, decl) >= 0
}

// True if a name read `e` holds a literal-union atom: a capture, a `let` by the storage chosen
// for its declaration, an atom param, or a walk variable.
function exprIsLitAtomIdent(e: Ident, exprIx: i32, fnIx: i32): boolean {
  // A captured variable, resolved against the enclosing frame's binding — the same node
  // `captureValKind` sizes the env field from, checked first because a capture shadows
  // nothing: it is by construction neither a local, param, nor global of the reader.
  if capturedIsLitAtom(fnIx, e.identName) { return true }
  // A `let`: the storage column, at the frame whose body declares it.
  const ld = readLetDeclOf(exprIx, fnIx)
  if ld >= 0 { return bindingIsLitAtom(ld, readDeclOwnerOf(ld, fnIx)) }
  // A loop variable: the storage column, at the frame whose loop declares it.
  const lvd = readLoopVarDeclOf(exprIx)
  if lvd >= 0 { return bindingIsLitAtom(lvd, readDeclOwnerOf(lvd, fnIx)) }
  const pt = paramTypeNodeOfRead(fnIx, unwrapParen(exprIx))
  if pt >= 0 {
    // The same structural predicate the rep layer assigns the valtype by, so the consumer
    // agrees with the rep by construction.
    const r = nodeRepIsAtom(pt, fnIx)
    return r
  }
  false
}

// True if an index read `e` yields a literal-union atom: an atom-element list's cell or an
// atom-valued map's value. False when the receiver holds string refs.
function exprIsLitAtomIndex(e: Index, exprIx: i32, fnIx: i32): boolean {
  // Every rung below asks a TYPE, and a literal union's type does not carry its rep: a list
  // built over a parameter pinned at the softened `string` holds string refs while its
  // element type is the same union an atom list has. The receiver's own literal is the rep,
  // and claiming an atom over it emits an i32 consumer for a `(ref $type)` (D1740).
  if idxRecvIsStrList(e.idxArr, fnIx) { return false }
  // `xs[i]` over a literal-union array yields an atom element, through the declaration
  // fallback: a monomorphized instance's receiver records the generic's `T[]`, so the
  // direct probe answers false for an array it should claim. Without it, a generic
  // returning the atom emitted a string-ref result over a body yielding the i32 atom — silent invalid wasm.
  if arrElemLitUnionTy(e.idxArr, fnIx) >= 0 { return true }
  // A list whose element is `string` or `string | null` holds refs, whatever a write of a
  // type parameter narrowed the read to (D3198).
  const recvTy = nonNullTy(nodeTyPinIxOf(e.idxArr))
  if recvTy >= 0 && recvTy < T.tys.length {
    const recvEl = tyArrayElemIx(recvTy)
    if recvEl >= 0 && tyPrimNameOf(nonNullTy(recvEl)) == "string" {
      return false
    }
    // A box element read under a narrowing unboxes to the member's own rep, which for a
    // string literal is the string ref, however few literals the narrowing left (D4201).
    if recvEl >= 0 && tyIsValueUnionBox(nonNullTy(recvEl)) { return false }
    // …and so does a map cell's box read under one (D8120).
    if mapReadNarrowedAtomKind(unwrapParen(exprIx), fnIx) == 2 { return false }
  }
  // `m[k]` over a litunion-valued map yields the atom id; without the claim a compare
  // falls to string equality with the raw i32 atom — invalid wasm. Unless the members are
  // numbers, whose values have no member id to widen — a case that needs both families in
  // one module to surface, since the classifier sits behind `gLitUnionUsed`.
  if nodeRepIsAtom(unwrapParen(exprIx), fnIx) { return true }
  // The bare read types `K0 | null` (a missing key reads null) — the emit is the i32
  // atom either way (the not-found arm yields a non-member sentinel), so the nullable
  // spelling claims too.
  if nodeRepIsNulAtom(unwrapParen(exprIx), fnIx) { return true }
  return false
}

// True if a field read `e` yields a literal-union atom, through a variant or nullable-variant
// receiver, a struct union whose members all store it as one, or a struct's own field.
// The variant member read `memIx`'s receiver holds, in the order the field-code twins take
// it: the narrowing, else a bare variant, else the `Arm | null` niche; -1 for none of them.
export function memRecvVariantIndex(e: Member, memIx: i32, fnIx: i32): i32 {
  const vi = memNarrowVariantIndex(memIx, fnIx)
  if vi >= 0 { return vi }
  memRecvArmVariantIndex(e.memObj, fnIx)
}

function exprIsLitAtomMember(e: Member, exprIx: i32, fnIx: i32): boolean {
  // `t0.f` reading a literal-union atom field through a narrowed union receiver or a
  // variant-typed receiver yields the atom — the variant-table twin of the struct-receiver
  // case below, in `memFieldTypeCode`'s dispatch order. Without it the read printed the raw atom id.
  const mIxA = unwrapParen(exprIx)
  const mviA = memRecvVariantIndex(e, mIxA, fnIx)
  if mviA >= 0 {
    const mvfiA = variantFieldIndex(mviA, e.memProp)
    if mvfiA >= 0 && variantFieldTypeAt(mviA, mvfiA) == FC_I32 {
      const rv = variantFieldIsLitUnion(mviA, mvfiA)
      return rv
    }
  }
  // The fourth receiver shape, whose absence causes a silent wrong value: an un-narrowed
  // struct union whose members all carry the field printed the raw atom id instead of the
  // member. `sharedUnionFieldPlan` is the same derivation the dispatch reads, so the atom
  // claim cannot drift; code 0 alone is not sufficient, since it is also plain i32/boolean.
  const avis: i32[] = []
  const afis: i32[] = []
  const aplan = sharedUnionFieldPlan(
    e.memObj,
    e.memProp,
    mIxA,
    fnIx,
    avis,
    afis,
  )
  if aplan == FC_I32 {
    let allAtom = avis.length > 0
    let ai = 0
    while ai < avis.length {
      const conv = sharedFieldArmConverts(FC_I32, avis[ai], afis[ai])
      const nul = sharedFieldArmNull(avis[ai], afis[ai])
      if !conv && !nul && !variantFieldIsLitUnion(avis[ai], afis[ai]) {
        allAtom = false
      }
      ai = ai + 1
    }
    if allAtom { return true }
  }
  // `b.kind` reading a literal-union atom FIELD yields the atom.
  const msi = structIndexOfExpr(e.memObj, fnIx)
  if msi >= 0 {
    const mfi = sFieldIndex(msi, e.memProp)
    if mfi >= 0 {
      // A plain i32 slot the checker reads as a literal-set alias holds its atom id: a record
      // with a function field keeps its ident fields as i32 slots with no atom table (D2853).
      if !sFieldIsLitUnion(msi, mfi) && sFieldTypeAt(msi, mfi) == FC_I32 {
        if (
          nodeTyIsLitUnionAlias(mIxA)
          && numLitUnionBaseTy(nodeTyIxOf(mIxA)) < 0
        ) {
          return true
        }
      }
      const r = sFieldIsLitUnion(msi, mfi)
      return r
    }
  }
  // An instance's hole receiver where no narrowing is open, as `memberAtomFieldTexts` reads it.
  if aplan < 0 && mviA < 0 && fnInPinnedInstance(fnIx) {
    return holeRecvAtomFieldTexts(e.memObj, e.memProp, fnIx).length > 0
  }
  false
}

// True if a call `e` returns a literal-union atom: a registered literal-union result type,
// a function value's aliased result, or a callee whose annotated or inferred return is one.
function exprIsLitAtomCall(e: Call, exprIx: i32, fnIx: i32): boolean {
  // Any call whose checked result type is a registered litunion holds an i32 atom, widened
  // at print. Covers a closure value call, a struct-field closure call, and an
  // indexed-closure call, none of which the callee-Ident named arm below can reach. A
  // generic call whose result a pin minted is excluded: its instance may return a string.
  if nodeTyIsLitUnionAlias(unwrapParen(exprIx)) { return true }
  // A function-value call whose callee's annotated result is an aliased litunion — the arm
  // above cannot reach inside a monomorphized instance, where the call node is shared with
  // the generic and still records the type variable. `cloCallResultLitUnion` asks the
  // callee's own substituted annotation instead.
  if cloCallResultLitUnion(unwrapParen(exprIx), fnIx) { return true }
  if e.callFn < 0 { return false }
  const callee = nodeAt(e.callFn)
  if callee is Ident {
    // A CLOSURE call, whose result rep is what the lifted body yields and not what a
    // spelling renders — so the alias arms above miss an INLINE member set. `fRetLitAtom`
    // is the banked answer the named rung below reads, asked of the lambda (D1768).
    const cloFe = identClosureFeOfRead(e.callFn, fnIx)
    if cloFe >= 0 && cloFe < fRetLitAtom.length {
      if fRetLitAtom[cloFe] == 1 { return true }
    }
    const target = fnIndexOfNode(e.callFn)
    if target >= 0 {
      const cf = nodeAt(fnStmts[target])
      if cf is FuncDecl {
        if cf.fnRet >= 0 {
          const r = nodeTyIsLitUnionAlias(cf.fnRet)
          return r
        }
        // An un-annotated callee, from the flag its own classification recorded: an
        // inferred return has neither a type node nor an annotation, so the signature's
        // result kind is classified from the returned expression, and this reads that
        // banked answer. Without it, a named-litunion tag printed its raw atom id.
        if target < fRetLitAtom.length {
          if fRetLitAtom[target] == 1 { return true }
        }
      }
    }
  }
  false
}

// The type the value at `valIx`, recorded at a type parameter, has in the instance `fnIx`: an
// exact instance's substitution, a hole's binding, or the pin of the parameter it names. -1 when
// none answers, or the answer still carries a type parameter.
export function pinnedValTyOf(valIx: i32, fnIx: i32): i32 {
  if fnIx < 0 || valIx < 0 { return -1 }
  let pin = exactOperandTyOf(valIx, fnIx)
  if pin < 0 { pin = holeOperandTyOf(valIx, fnIx) }
  if pin < 0 { pin = pinnedParamTyAt(valIx, fnIx, 4) }
  // A value typed at the instance's own type parameter that no walk to a parameter reaches,
  // such as a copy a closure writes, is at the instance's binding of it (D7144).
  if pin < 0 {
    const vt = nodeTyAt(unwrapParen(valIx), fnIx)
    if vt >= 0 && vt < T.tys.length && tyAt(vt) is TyVar {
      pin = pinSubOperandTyOf(vt, fnIx)
    }
  }
  if pin < 0 || pin >= T.tys.length || tyHasTyVar(pin) { return -1 }
  pin
}

// The type of `exprIx` inside an exact instance: its recorded type names a type parameter,
// which that instance binds to one pinned type. -1 outside one, or when nothing substitutes.
export function exactOperandTyOf(exprIx: i32, fnIx: i32): i32 {
  const row = monoExactSubRowOf(fnIx)
  if row < 0 || row >= monoExactSubN.length { return -1 }
  const ax = unwrapParen(exprIx)
  if ax < 0 { return -1 }
  const ty = nodeTyIxOf(ax)
  if ty < 0 { return exactCallResultTyOf(ax) }
  if !tyHasTyVar(ty) { return -1 }
  const st = exactSubAt(ty, row)
  if st < 0 { return -1 }
  if tyHasTyVar(st) { return exactSubOuterTyOf(st, fnIx) }
  st
}

// The type of the read at `exprIx` in function `fnIx`: an exact instance's substitution of a
// type parameter, else the type every call of a hole pinned, else that hole instance's
// binding (which renders inline literal members as `string`), else the recorded type.
export function instanceReadTyOf(exprIx: i32, fnIx: i32): i32 {
  const st = exactOperandTyOf(exprIx, fnIx)
  if st >= 0 { return st }
  const pt = nodeTyPinIxOf(unwrapParen(exprIx))
  if pt >= 0 && pt < T.tys.length && !(tyAt(pt) is TyVar) { return pt }
  const ht = holeOperandTyOf(exprIx, fnIx)
  if ht >= 0 { return ht }
  pt
}

// Whether `exprIx`, typed at a hole instance `fnIx` pins to a literal union, holds the atom: not
// a join, whose string arm makes it a string ref (D1728), nor the instance's own parameter, which
// its annotation already pins. A local answers by its un-annotated initializer.
export function holeLitReadIsAtom(exprIx: i32, fnIx: i32, depth: i32): boolean {
  if fnIx < 0 || exprIx < 0 || depth > 4 { return false }
  const ix = unwrapParen(exprIx)
  if ix < 0 { return false }
  const e = nodeAt(ix)
  if e is Ident {
    if (paramIndexOf(fnIx, e.identName) >= 0 && paramReadAt(fnIx, ix)) {
      return false
    }
    const fn = nodeAt(fnIx)
    if !(fn is FuncDecl) { return false }
    const li = bodyLetOfRead(fn.fnBody, ix)
    if li < 0 { return false }
    const d = nodeAt(li)
    if !(d is LetDecl) { return false }
    // An annotation with no type parameter fixes the cell's rep, whatever a write narrowed
    // the read to (D3198).
    if d.letType >= 0 { return tyHasTyVar(nodeTyIxOf(d.letType)) }
    return holeLitReadIsAtom(d.letInit, fnIx, depth + 1)
  }
  if nodeIsValueJoin(ix) { return holeJoinArmsAllAtom(ix, fnIx, depth + 1) }
  true
}

// Whether every arm value of the value join at `ix` holds the atom, so the join is the atom too;
// one string arm makes it a string ref (D1728, D3291).
function holeJoinArmsAllAtom(ix: i32, fnIx: i32, depth: i32): boolean {
  if depth > 4 { return false }
  const arms = valueJoinArmValues(ix)
  if arms.length == 0 { return false }
  for v in arms {
    if v < 0 { return false }
    const u = unwrapParen(v)
    if nodeIsValueJoin(u) {
      if !holeJoinArmsAllAtom(u, fnIx, depth + 1) { return false }
    } else if !exprIsLitAtom(u, fnIx) {
      return false
    }
  }
  true
}

// The list type the instance a call `callIx` names declares it returns, or -1 when the callee is
// no lifted function, or its return is absent, not a list, or still names a type parameter.
function instCallRetListTy(callIx: i32): i32 {
  const c = nodeAt(callIx)
  if !(c is Call) || c.callFn < 0 { return -1 }
  if !(nodeAt(c.callFn) is Ident) { return -1 }
  const pos = fnIndexOfNode(c.callFn)
  if pos < 0 || pos >= fnStmts.length { return -1 }
  const fd = nodeAt(fnStmts[pos])
  if !(fd is FuncDecl) || fd.fnRet < 0 { return -1 }
  const rt = nodeTyIxOf(fd.fnRet)
  if rt < 0 || rt >= T.tys.length || tyHasTyVar(rt) || !(tyAt(rt) is TyArray) {
    return -1
  }
  rt
}

// The element type iterable `iterIx` holds at the pin of the instance `fnIx` is: the hole and
// exact rungs, an instance parameter's annotation, a local's own or its initializer's recorded
// type, else its recorded element's hole. -1 anywhere else. Needs no locals table.
export function iterElemPinTy(iterIx: i32, fnIx: i32): i32 {
  if fnIx < 0 { return -1 }
  const own = holeOperandTyOf(iterIx, fnIx)
  if own >= 0 { return tyStepElem(own) }
  const ex = exactOperandTyOf(iterIx, fnIx)
  if ex >= 0 { return tyStepElem(ex) }
  // The iterable's recorded type through the binding chain of the instances `fnIx` is lifted
  // inside, as the iterable's index read is typed: one rule for any spelling (D3842).
  const rec = nodeTyAt(unwrapParen(iterIx), fnIx)
  if rec >= 0 && rec < T.tys.length {
    let st = rec
    if tyHasTyVar(rec) { st = pinSubOperandTyOf(rec, fnIx) }
    // A list over holes a hole instance binds, such as an `if` join of two of its lists (D10794).
    if st < 0 && tyHasTyVar(rec) { st = holeCompositeTyOf(rec, fnIx) }
    if st >= 0 && st < T.tys.length && tyAt(st) is TyArray && !tyHasTyVar(st) {
      return tyStepElem(st)
    }
  }
  // A captured list of an enclosing hole instance's hole, which no pin row binds (D3831).
  const ci = nodeAt(unwrapParen(iterIx))
  if ci is Ident {
    if capturedKindOf(fnIx, ci.identName) != null {
      const ch = holeCaptureArrElemTyOf(iterIx, fnIx)
      if ch >= 0 { return ch }
    }
  }
  // A loop variable over a list of lists holds its iterable's element at the pin (D3115).
  const lv = loopVarElemPinTyOf(iterIx, fnIx)
  if lv >= 0 && !tyHasTyVar(lv) { return tyStepElem(lv) }
  const n = nodeAt(unwrapParen(iterIx))
  const fn = nodeAt(fnIx)
  if n is Ident {
    if fn is FuncDecl {
      let et = -1
      const pt = paramTypeNodeOfRead(fnIx, iterIx)
      if pt >= 0 {
        et = tyStepElem(monoParamPinTy.get(pt) ?? nodeTyIxOf(pt))
      } else {
        const li = bodyLetOfRead(fn.fnBody, unwrapParen(iterIx))
        if li >= 0 {
          const d = nodeAt(li)
          if d is LetDecl {
            if d.letType >= 0 {
              et = tyStepElem(nodeTyIxOf(d.letType))
            } else if d.letInit >= 0 {
              et = tyStepElem(nodeTyAt(d.letInit, fnIx))
              // An un-annotated rebind of another pinned list holds what that one does.
              if et >= 0 && tyHasTyVar(et) {
                et = iterElemPinTy(d.letInit, fnIx)
              }
            }
          }
        }
      }
      if et >= 0 && !tyHasTyVar(et) { return et }
    }
  }
  // A list literal of the instance's own parameter, `[x, x]`, holds that parameter's pin.
  if n is ArrayLit {
    const ln = arrLitSameIdentName(n.arrElems)
    const lpt = if ln == "" { -1 } else { paramTypeNodeOfRead(fnIx, n.arrElems[0]) }
    if lpt >= 0 {
      const lp = monoParamPinTy.get(lpt) ?? nodeTyIxOf(lpt)
      if lp >= 0 && !tyHasTyVar(lp) { return lp }
    }
    // A literal of other reads, `[l[0]]` or `[y]`, holds what they hold there (D3066).
    const rp = arrLitReadsPinTy(n.arrElems, fnIx)
    if rp >= 0 { return rp }
  }
  // A `.filter` or `.slice` holds its receiver's elements.
  if n is Call && n.callFn >= 0 {
    const cm = nodeAt(n.callFn)
    if cm is Member {
      if cm.memProp == "filter" || cm.memProp == "slice" {
        const rt = iterElemPinTy(cm.memObj, fnIx)
        if rt >= 0 { return rt }
      }
      if cm.memProp == "map" && n.callArgs.length == 1 {
        const mt = mapCbResultPinTy(n.callArgs[0], cm.memObj, fnIx)
        if mt >= 0 { return mt }
      }
    }
  }
  // A generic call an instance body copied has no recorded type; its instance's return does.
  if rec < 0 && n is Call {
    const rt = instCallRetListTy(unwrapParen(iterIx))
    if rt >= 0 { return tyStepElem(rt) }
  }
  if monoHoleSubN.length == 0 { return -1 }
  const hv = nodeArrayElemTyIx(iterIx)
  if hv < 0 || hv >= T.tys.length || !(tyAt(hv) is TyVar) { return -1 }
  const row = monoHoleSubRow.get(fnStmtsPosOf(fnIx)) ?? -1
  if row < 0 || row >= monoHoleSubN.length { return -1 }
  const b = holePinReadOf(hv, monoHoleSubN[row], monoHoleSubT[row])
  if b < 0 || b >= T.tys.length || tyHasTyVar(b) { return -1 }
  b
}

// What an inline `.map` callback returns at the pin of the instance `fnIx` is: its own element
// parameter holds the receiver's element, any other read answers as `valueReadPinTy` does. -1
// for a callback that is not an inline lambda returning one such read.
function mapCbResultPinTy(cbIx: i32, recvIx: i32, fnIx: i32): i32 {
  const cx = unwrapParen(cbIx)
  if cx < 0 { return -1 }
  const cb = nodeAt(cx)
  if !(cb is FuncDecl) { return -1 }
  // A declared return is the result's element, which may be wider than what the body returns.
  if cb.fnRet >= 0 { return mapCbDeclRetPinTy(nodeTyIxOf(cb.fnRet), fnIx) }
  const rx = unwrapParen(fnRetExprOf(cx))
  if rx < 0 { return -1 }
  const rn = identNameOrEmpty(rx)
  if rn != "" {
    const pi = paramIndexOf(cx, rn)
    if pi == 0 { return iterElemPinTy(recvIx, fnIx) }
    if pi > 0 { return -1 }
  }
  valueReadPinTy(rx, fnIx, 0)
}

// The one type every element of `elems` holds at the pin of the instance `fnIx` is, each an
// element read or a name (`valueReadPinTy`); -1 when one answers none or they differ.
function arrLitReadsPinTy(elems: i32[], fnIx: i32): i32 {
  if elems.length == 0 { return -1 }
  const t0 = valueReadPinTy(elems[0], fnIx, 0)
  if t0 < 0 { return -1 }
  let i = 1
  while i < elems.length {
    const ti = valueReadPinTy(elems[i], fnIx, 0)
    if ti < 0 || (ti != t0 && !tyEq(ti, t0)) { return -1 }
    i = i + 1
  }
  t0
}

// `holeOperandTyOf` of `ix`, or of the name it reads asked of each enclosing frame that
// name is captured from, since a lambda lifted inside a hole instance has no binding of its own.
export function holeOrCapturedTyOf(ix: i32, fnIx: i32): i32 {
  const t = holeOperandTyOf(ix, fnIx)
  if t >= 0 { return t }
  const fs = captureDeclFrames(ix, fnIx)
  let i = 0
  while i < fs.length {
    const ht = holeOperandTyOf(ix, fs[i])
    if ht >= 0 { return ht }
    i = i + 1
  }
  -1
}

// The enclosing frames of lifted frame `fnIx`, innermost first, that the name `ix` reads is
// captured through, ending at the one that declares it; empty for anything but a captured name.
function captureDeclFrames(ix: i32, fnIx: i32): i32[] {
  const out: i32[] = []
  const name = identNameOrEmpty(unwrapParen(ix))
  if name == "" { return out }
  let cur = fnIx
  while out.length < 8 && identIsEnvCapture(cur, name) {
    const pos = fnStmtsPosOf(cur)
    if pos < 0 || pos >= fnParent.length { return out }
    const pp = fnParent[pos]
    if pp < 0 || pp >= fnStmts.length { return out }
    cur = fnStmts[pp]
    out.push(cur)
  }
  out
}

// The type the read `ix` holds at the pin of the instance `fnIx` is: an element read's list
// element (`iterElemPinTy`), a parameter's pin, a local's annotation or initializer, or a loop
// variable's list element. -1 for any other node, or where the type still names a type parameter.
export function valueReadPinTy(ix: i32, fnIx: i32, depth: i32): i32 {
  const rx = unwrapParen(ix)
  if rx < 0 || fnIx < 0 || depth > 4 { return -1 }
  const n = nodeAt(rx)
  if n is Index { return iterElemPinTy(n.idxArr, fnIx) }
  if !(n is Ident) { return -1 }
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return -1 }
  const pt = paramTypeNodeOfRead(fnIx, rx)
  if pt >= 0 {
    const pp = monoParamPinTy.get(pt) ?? nodeTyIxOf(pt)
    if pp >= 0 && !tyHasTyVar(pp) { return pp }
    return -1
  }
  const li = bodyLetOfRead(fn.fnBody, rx)
  if li < 0 {
    const lv = loopVarElemPinTyOf(rx, fnIx)
    if lv >= 0 && !tyHasTyVar(lv) { return lv }
    return -1
  }
  const d = nodeAt(li)
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = nodeTyIxOf(d.letType)
      if lt >= 0 && !tyHasTyVar(lt) { return lt }
      return -1
    }
    return valueReadPinTy(d.letInit, fnIx, depth + 1)
  }
  -1
}

// The type the for-in loop variable `exprIx` names holds at the pin of the instance `fnIx` is,
// where its recorded type names a type parameter or hole and its list holds `i32` cells; -1
// for any other read (D2983). Found by walking the body, so it needs no locals table.
export function loopVarPinTyOf(exprIx: i32, fnIx: i32): i32 {
  const t = loopVarElemPinTyOf(exprIx, fnIx)
  if t < 0 || fnIx < 0 { return -1 }
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return -1 }
  if !loopVarReadIsAtom(unwrapParen(exprIx), fn.fnBody, fnIx) { return -1 }
  t
}

// `loopVarPinTyOf` for a list of any cells: the element the loop variable's list holds at the
// instance's pin, or -1.
export function loopVarElemPinTyOf(exprIx: i32, fnIx: i32): i32 {
  const ix = unwrapParen(exprIx)
  if ix < 0 || fnIx < 0 || !(nodeAt(ix) is Ident) { return -1 }
  const rt = nodeTyIxOf(ix)
  if rt < 0 || rt >= T.tys.length || !tyHasTyVar(rt) { return -1 }
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    if paramIndexOf(fnIx, identNameOrEmpty(ix)) >= 0 { return -1 }
    if bodyLetOfRead(fn.fnBody, ix) >= 0 { return -1 }
    const lp = frameElemLoopOfRead(fn.fnBody, ix)
    if lp < 0 { return -1 }
    const fl = nodeAt(lp)
    if fl is ForIn { return iterElemPinTy(fl.fiIter, fnIx) }
  }
  -1
}

// Whether Ident `ix` is a for-in loop variable of body `bodyIx` whose list holds `i32` cells, not
// the string refs a literal of strings builds (D2983).
function loopVarReadIsAtom(ix: i32, bodyIx: i32, fnIx: i32): boolean {
  const lp = frameElemLoopOfRead(bodyIx, ix)
  if lp < 0 { return false }
  const fl = nodeAt(lp)
  if fl is ForIn {
    const it = nodeAt(unwrapParen(fl.fiIter))
    if it is Ident {
      const il = bodyLetOfRead(bodyIx, unwrapParen(fl.fiIter))
      if il >= 0 {
        const d = nodeAt(il)
        if d is LetDecl {
          if d.letType < 0 && d.letInit >= 0 && nodeAt(d.letInit) is ArrayLit {
            return !arrLitIsStr(d.letInit, fnIx)
          }
        }
      }
    }
    return true
  }
  false
}

// The exact type a call to a generic's instance returns: the template's declared return
// through the callee instance's own exact row. A generic call inside a generic body records no
// type of its own. -1 when the callee has no exact row, or a type parameter stays open.
function exactCallResultTyOf(callIx: i32): i32 {
  const c = nodeAt(callIx)
  if !(c is Call) { return -1 }
  if c.callFn < 0 || !(nodeAt(c.callFn) is Ident) { return -1 }
  const pos = fnIndexOfNode(c.callFn)
  if pos < 0 { return -1 }
  const row = monoExactSubRow.get(pos) ?? -1
  if row < 0 || row >= monoExactSubN.length { return -1 }
  let orig = -1
  let k = 0
  while k < monoInstFe.length && orig < 0 {
    if monoInstFe[k] == pos { orig = monoInstOrig[k] }
    k = k + 1
  }
  if orig < 0 || orig >= monoOrigNode.length { return -1 }
  const fd = nodeAt(monoOrigNode[orig])
  if !(fd is FuncDecl) || fd.fnRet < 0 { return -1 }
  const st = exactSubAt(nodeTyIxOf(fd.fnRet), row)
  if st < 0 || tyHasTyVar(st) { return -1 }
  st
}

// The map an `as` cast out of a union box yields (`u as! M`), or with `wantNull` the map of
// `u as? M`, whose result is the nullable map ref; -1 when `exprIx` is no such cast.
function asUnionMapTy(exprIx: i32, fnIx: i32, wantNull: boolean): i32 {
  const e = nodeAt(exprIx)
  if e is AsExpr {
    if (e.asMode == "null") != wantNull { return -1 }
    if !exprUnion(e.asObj, fnIx) || !asExprIsUnionCastIn(exprIx, fnIx) {
      return -1
    }
    return mapTyPeel(nodeTyIxOf(exprIx))
  }
  -1
}

// The arm type `u as? T` tests for out of a union box, `T` itself; -1 for any other node.
function asUnionNulArmTy(exprIx: i32, fnIx: i32): i32 {
  if exprIx < 0 { return -1 }
  const e = nodeAt(exprIx)
  if e is AsExpr {
    if e.asMode != "null" { return -1 }
    if !exprUnion(e.asObj, fnIx) || !asExprIsUnionCastIn(exprIx, fnIx) {
      return -1
    }
    return tyPeelNul(nodeTyIxOf(exprIx))
  }
  -1
}

// Whether `e`, at node `ix`, is `o ?? d` over a nullable map `o` whose result is that map type:
// its value is `o`'s map when present, else `d`, at the operand's shape. A default of another map
// type makes the result their union, which is not a map.
function coalesceOfNulMapIsMap(e: BinExpr, ix: i32, fnIx: i32): boolean {
  if e.binOp != "??" || !exprNullableMap(e.binLeft, fnIx) { return false }
  const lm = mapTyPeel(nodeTyAt(e.binLeft, fnIx))
  if lm >= 0 && !tyHasTyVar(lm) { return tySame(nodeTyAt(ix, fnIx), lm) }
  // An operand whose map type still holds a hole the instance pins answers by the default:
  // its own non-null map type is the result's (D12390).
  const dt = nodeTyIxOf(e.binRight)
  mapTyPeel(dt) >= 0 && !tyBearsNull(dt)
}

// True if the function `name` declares the struct as its return type (over the stored kind
// `buildFnMap` recorded — no arena rescan). Frame-aware, like the scalar and list readers: a
// per-pin clone shares its template's name, and the flat lookup always answers the template,
// so an i32 instance read the struct pin's kind and returned a ref it never built (D1788).
function fnRetStructSid(sid: i32, name: string, fnIx: i32, at: i32) {
  repOfNameResult(sid, name, fnIx, at).rdKind == "struct"
}

// True if evaluating the expression at `exprIx` yields the struct (a `(ref $0)`):
// an object literal (constructs it), a struct-returning call, a struct param/local
// reference, or a parenthesized struct expression. Anything else is an i32 value.
export function exprStruct(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = nodeAt(exprIx)
  if e is ObjLit { return true }
  if e is Paren { return exprStruct(e.parInner, fnIx) }
  if e is AsExpr { return asTrapStructRow(exprIx) >= 0 }
  // An if-EXPRESSION whose branch join is a struct — an un-annotated binding classifies kind 1
  // (the THEN arm's rep, the arms agreeing by the checker), matching `structIndexOfExpr`.
  if e is IfStmt {
    const tv = ifThenValueIx(exprIx)
    return tv >= 0 && exprStruct(tv, fnIx)
  }
  // A `m[k] ?? default` over a struct-valued map yields the value struct, so a bound
  // `const p = m[k] ?? d` classifies as a struct local. A nullable-value slot yields
  // `S | null` instead, since a stored null is preserved through `??` — `exprNullableStruct`
  // claims that arm, not this one.
  if e is BinExpr {
    // A name's assignment yields a re-read of its cell, so it is the name's struct (D2170).
    const asgCell = asgCellOf(exprIx, fnIx)
    if asgCell >= 0 { return exprStruct(asgCell, fnIx) }
    const cms = coalesceMvSlot(exprIx, fnIx)
    if cms >= 0 {
      // A nullable-value slot with a NON-null default coalesces to the non-null struct too
      // (stored null included) — only a nullable default leaves it `S | null`.
      return mvValKind[cms] == MVK_STRUCT
        && !coalesceStaysNullable(exprIx, cms, fnIx)
    }
    // A `<S|null> ?? <S>` coalesce yields the non-null struct (the generic nullable-struct `??` emit) —
    // so a bound `const p = r ?? d` classifies struct and `(r ?? d).x` resolves. The left is the
    // nullable struct; the right is a plain struct default.
    if e.binOp == "??" {
      if exprNullableStruct(e.binLeft, fnIx) { return true }
      return exprStruct(e.binRight, fnIx)
    }
  }
  if e is Call {
    if e.callFn < 0 { return false }
    const callee = nodeAt(e.callFn)
    if callee is Ident {
      if fnRetStructSid(sidOfNode(e.callFn), callee.identName, fnIx, e.callFn) {
        return true
      }
      // A struct-returning function VALUE (a binding / `(i32) => S` param callee): its
      // resolved `>sN;` sig (mirrors `structIndexOfExpr`'s closure case). Falls through to the
      // per-node-type fallback below when the sig path misses (a factory-inferred value).
      if calleeReturnsStructIdxOfRead(e.callFn, fnIx) >= 0 { return true }
    }
    // A field-closure call (`(a."*")(2)` — a rewritten operator/index trap)
    // yields the field function's return struct (mirrors `structIndexOfExpr`).
    if callee is Member {
      if (
        drwFieldClosure(structIndexOfExpr(callee.memObj, fnIx), callee.memProp)
      ) {
        const cfe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
        if cfe >= 0 {
          if repOfFnSlot(cfe).rdKind == "struct" { return true }
        }
      }
    }
    // Fallback, scoped to a call: a struct-returning closure value call whose callee the
    // cases above miss — an indexed closure-array element or a factory-inferred value. The
    // cheap no-render `nodeTyIsObj` reads the checker's per-node type, the boolean dual of
    // `structIndexOfExpr`'s fallback.
    return nodeTyIsObj(exprIx)
  }
  if e is Ident {
    if (paramStruct(fnIx, exprIx)) { return true }
    if declaredStruct(exprIx) { return true }
    // A captured struct: the env field is the struct ref (`captureValKind` sized it that
    // way), so classify it like a struct param/local — the fourth storage class this arm
    // never grew. Without it, a lambda whose body is a bare captured struct minted its
    // `$fnsig` result i32 over a body returning `(ref $S)` — two functypes, invalid wasm.
    if capturedKindOf(fnIx, e.identName) == "struct" { return true }
    if globalReadIsStruct(fnIx, exprIx) { return true }
    // The frame's own `let`, asked outside the frame's emission, where `declaredStruct` has no
    // collected slot to read: the kind `structIndexOfExpr`'s frame leg already names a row for.
    const fli = frameLetOf(fnIx, exprIx)
    if fli >= 0 && !letIsVariant(fli, fnIx) {
      if structIndexOfLet(fli, fnIx) >= 0 {
        return !exprNullableStruct(exprIx, fnIx)
      }
    }
    return false
  }
  // `xs[i]` over a STRUCT-element ref list yields the struct (G7-ref). Per-slot: the
  // element kind comes from the receiver's distinct ref-list slot (1 = struct).
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      // GUARD the slot (a narrowed union-arm rebind receiver can classify
      // `exprRefArray` true while the slot resolver misses — OOB otherwise).
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if slot < 0 || slot >= rlElemKindTbl.length { return false }
      return rlElemKindTbl[slot] == RLK_STRUCT
    }
  }
  // A field read is a struct when its recorded rep is one, whatever its storage holds.
  if e is Member {
    const md = repOfNode(exprIx, fnIx)
    if md.rdCovered == 1 && md.rdKind == "struct" { return true }
  }
  // A NULLABLE struct value (`S | null`) participates in the struct machinery
  // (member layout resolution); the field-read path inserts the non-null recover.
  exprNullableStruct(exprIx, fnIx)
}

// The node standing for the value of the assignment at `ix` when its target is a name, whose
// re-read is how the value is lowered (`asgReadNode`); -1 for any other node or target.
function asgCellOf(ix: i32, fnIx: i32): i32 {
  const e = nodeAt(ix)
  if e is BinExpr {
    if e.binOp == "=" && asgLitWidth(ix, fnIx) == "" {
      const t = unwrapParen(e.binLeft)
      if t < 0 { return -1 }
      if nodeAt(t) is Ident { return asgReadNode(ix, fnIx) }
    }
  }
  -1
}

// Expression `exprIx` is a nullable union variant: it holds a `(ref null $uVarHeap[vi])`
// niche, which is `nulVariantIdxOfExpr` naming its row. Strict beside `exprNullableStruct`,
// since the two kinds index different heap tables; a null test wants `exprNullableRefNiche`.
export function exprNullableVariant(exprIx: i32, fnIx: i32): boolean {
  nulVariantIdxOfExpr(exprIx, fnIx) >= 0
}

// Expression `exprIx` is a nullable ref niche — a nullable struct (kind 9) or a nullable
// union variant. The predicate every null-test and narrowing site wants: both lower a bare
// `null` as `ref.null` and test with `ref.is_null`, neither consulting the heap table that
// separates the two kinds. A site deciding a kind must ask the strict twins instead.
export function exprNullableRefNiche(exprIx: i32, fnIx: i32) {
  if exprNullableStruct(exprIx, fnIx) { return true }
  exprNullableVariant(exprIx, fnIx)
}

// The rep kind of the cell an identifier reads, across the four storage classes: parameter
// annotation, declared local, captured env field, module global. The kind-level
// generalization of `exprNullableStruct`'s four-arm ladder. Parameter first is not a
// shadowing bug: `paramTypeNodeOfRead` answers -1 for a read a `let` shadows.
export function identCellVKind(exprIx: i32, fnIx: i32): VKind | null {
  if exprIx < 0 { return null }
  const e = nodeAt(unwrapParen(exprIx))
  if e is Ident {
    const pt = paramTypeNodeOfRead(fnIx, unwrapParen(exprIx))
    if pt >= 0 { return vtKindOfType(pt) }
    const dk = declaredKind(unwrapParen(exprIx))
    if dk != null { return dk }
    const ck = capturedKindOf(fnIx, e.identName)
    if ck != null { return ck }
    const gl = globalLetOfRead(fnIx, unwrapParen(exprIx))
    if gl >= 0 { return globalReadCellKind(gl) }
  }
  null
}

// A module global's cell kind as a read sees it. `globalCellKind` lays a `boolean | null`
// global out as a plain i32 cell; its values still carry the niche sentinel.
function globalReadCellKind(gl: i32): VKind {
  const k = globalCellKind(gl)
  if k == "i32" && letNulBool(gl, -1) { return "nulbool" }
  k
}

// D1576 — is this expression's value the `null` type, whose rep is `nullref`? Producers: a
// never-filled `let x = null` binding, a call to a function whose every return is a bare
// `null`, and a call through a function value whose `$fnsig` result token is `Z`. The one home,
// so consumers that must treat the value as statically null ask once.
export function exprIsNulNone(exprIx: i32, fnIx: i32): boolean {
  if exprIx < 0 { return false }
  const e = nodeAt(unwrapParen(exprIx))
  if e is Call {
    const cf = nodeAt(unwrapParen(e.callFn))
    if cf is Ident {
      const t = fnIndexOfNode(e.callFn)
      if t >= 0 { return repOfFnSlot(t).rdKind == "nulnone" }
      return calleeRetKindOfRead(e.callFn, fnIx) == "nulnone"
    }
    if cloValueCallRetKind(unwrapParen(exprIx), fnIx) == "nulnone" {
      return true
    }
    // A `null[]`'s `pop` and `get` hand back its element, and a `null`-valued map's `get` its value.
    if cf is Member {
      if cf.memProp != "pop" && cf.memProp != "get" { return false }
      if exprMap(cf.memObj, fnIx) {
        return cf.memProp == "get"
          && mapTyValIsNullUnit(mapRecvTyIn(cf.memObj, fnIx))
      }
      return arrElemIsNullUnitAt(cf.memObj, fnIx)
    }
    return false
  }
  // An if-expression whose every arm is a bare `null` or itself `null`-typed is `null`-typed:
  // the join of `null` with `null` is `null`. One arm carrying a real value is not this — its
  // join is a genuine `T | null` and the niche paths own it. An else-less `if` used as a value
  // is `T | null`, and here `T` is already `null`.
  if e is IfStmt {
    if !armIsNulNone(ifArmValueExpr(e.ifThen), fnIx) { return false }
    if e.ifElse < 0 { return true }
    if nodeAt(e.ifElse) is IfStmt { return exprIsNulNone(e.ifElse, fnIx) }
    return armIsNulNone(ifArmValueExpr(e.ifElse), fnIx)
  }
  // A struct field of the `null` unit type reads its `nullref` slot (D4671).
  if e is Member { return memberFieldCode(exprIx, fnIx) == FC_NUL_NONE }
  // So does an element of a `null[]`, which rides the i32 list, and a `null`-valued map's read.
  if e is Index {
    if exprMap(e.idxArr, fnIx) {
      return mapTyValIsNullUnit(mapRecvTyIn(e.idxArr, fnIx))
    }
    return arrElemIsNullUnitAt(e.idxArr, fnIx)
  }
  // `a ?? b` over a `null`-typed `a` is `b`, so it is `null`-typed when `b` is (D3355).
  if e is BinExpr {
    if e.binOp == "??" && e.binCompound.length == 0 {
      if !exprIsNulNone(e.binLeft, fnIx) { return false }
      return exprIsNullLit(e.binRight) || exprIsNulNone(e.binRight, fnIx)
    }
  }
  // Every other node kind asks the cell, which is the named default and not a fall-through:
  // an Ident, a captured read, and a module global all resolve through `identCellVKind`, and
  // for a kind that names no cell it answers `null` — the right answer for every remaining kind.
  identCellVKind(exprIx, fnIx) == "nulnone"
}

// Does the if-arm tail value `v` add nothing but `null` to the join? A bare `null`, a `null`-typed
// value, or the `never` tail of an arm that always exits, which hands no value over (D3355).
function armIsNulNone(v: i32, fnIx: i32): boolean {
  if v < 0 { return false }
  exprIsNullLit(v) || callIsNever(v) || exprIsNulNone(v, fnIx)
}

// D1576 — `x ?? d` where `x` is the `null` type is exactly `d`, so a classifier asked about
// the `??` must answer about the default, at the default's rep. Returns `d`'s node index, or
// -1 when this is not that shape. Without it, `print(x ?? "d")` classified i32 over a string ref.
function coalesceNulNoneDefaultIx(exprIx: i32, fnIx: i32): i32 {
  if exprIx < 0 { return -1 }
  const e = nodeAt(unwrapParen(exprIx))
  if e is BinExpr {
    if e.binOp == "??" {
      if exprIsNulNone(e.binLeft, fnIx) { return e.binRight }
    }
  }
  -1
}

// The binding half of `exprIsNulNone`: is the LetDecl at `letIx` a binding whose only value
// is `null`? Two producers, matching the expression side: a never-filled infer-null hole
// (D1576), and an un-annotated binding to a call returning `null` always. An annotation
// lands here only when it names `null` itself; `C | null = null` is `nulstruct`.
export function letIsNulNone(letIx: i32, fnIx: i32): boolean {
  if letIx < 0 { return false }
  const s = nodeAt(letIx)
  if s is LetDecl {
    // An annotation naming the `null` unit type pins the same cell (D4550).
    if s.letType >= 0 { return nodeTyIsNullType(s.letType) }
    if s.letInit < 0 { return false }
    const ini = nodeAt(unwrapParen(s.letInit))
    if ini is NullLit { return letNullHoleUnfilled(letIx) }
    // A `null`-typed initializer a later write filled is that write's `T | null` (D3355).
    if letNullHoleFilledTy(letIx) >= 0 { return false }
    return exprIsNulNone(s.letInit, fnIx)
  }
  false
}

// Whether the value at `exprIx` is a function value `fn | null` the checker has not narrowed
// present.
export function exprNulClosure(exprIx: i32, fnIx: i32): boolean {
  exprNulKind(exprIx, fnIx) == "nulclosure"
}

// True if the `LetDecl` at `letIx` declares a struct-typed local: its annotation names the
// struct, or its initializer produces one. Picks the local's valtype (`(ref $0)` vs i32) in
// `collectLocals`.
export function letIsStruct(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = nodeAt(d.letType)
      if lt is TypeRef {
        // The arena rung: `nodeTyIsStruct` is the checker-side twin already provided for
        // "does this annotation denote a struct", an arena-index set instead of an O(nodes)
        // name scan. A strict superset: the arena claims spellings `isSName` structurally
        // cannot — a generic application, a canonicalized intersection, an inline shape.
        if nodeTyIsStruct(d.letType) { return true }
        // This residue leg is inert on the corpus: the arena rung above already claims every
        // struct-typed let a corpus program declares. Kept rather than deleted, since inert
        // proves redundant, not dead — the shape it would catch is exactly what a fixture
        // corpus can lack.
        if isSName(lt.tyName) { return true }
      }
    }
    return exprStruct(d.letInit, fnIx)
  }
  false
}

// True if the `LetDecl` at `letIx` binds a concrete union-variant value — a kind-8 local
// `(ref $(uVarHeap[vi]))`, distinct from the union box (kind 4) and a standalone struct
// (kind 1). Annotation first, else the init's variant value. Checked after the struct/union
// local cases so only an explicit variant annotation or variant-valued init reaches here.
export function letIsVariant(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = nodeAt(d.letType)
      if lt is TypeRef {
        // Name, not an arena-node lookup: that answers only for a node that
        // resolves to the variant's declaration. A second node spelling the same inline shape
        // mints its own arena row and compares unequal, so under-answering here would unbind
        // a variant let — the name stays.
        if variantIndexOf(lt.tyName) >= 0 { return true }
      }
    }
    // A value-union annotation pins the cell to the box, whatever the init produces (D1606):
    // `emitLetDeclStmt` coerces the init against the ANNOTATION, so classifying from the init
    // instead stores a box in a variant cell wherever `emitUnionCoerce` finds the arm a row.
    if letAnnIsUnion(letIx) { return false }
    // The init's rep is `exprVariantIndex`'s answer, and nothing second-guesses it. A guard
    // that re-asks the struct table to catch a plain-struct twin of an arm misreads a variant
    // index as a struct row whenever the struct table is non-empty, since the two tables
    // share one integer namespace and a bounds check against `sHeapIdx.length` cannot tell (D26).
    return exprVariantIndex(d.letInit, fnIx) >= 0
  }
  false
}

// The union-variant table index a variant-typed `LetDecl` binds (annotation first, else
// the init's variant value), or -1.
export function variantIndexOfLet(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = nodeAt(d.letType)
      if lt is TypeRef {
        const vi = variantIndexOf(lt.tyName)
        if vi >= 0 { return vi }
      }
    }
    // Mirrors `letIsVariant` — including the retired `letInitReboxesToVariant` guard and the
    // union-annotation gate, whose reasoning is recorded there. The pair answers arm for arm,
    // so a binding that predicate declines has no variant index for a caller to bank either.
    if letAnnIsUnion(letIx) { return -1 }
    return exprVariantIndex(d.letInit, fnIx)
  }
  -1
}

// The union-variant row an un-annotated object-literal initializer in function `fnIx` (or a value
// join of such) denotes: `objVariantName`'s match, or -1 if `structIndexOfObjCtx` claims a
// row. Re-asks under the opposite precondition from `structIndexOfLet`'s -1, since a bare
// `{ r: n }` can have two nominal claimants and only one remains once a struct row is ruled out.
export function objLitVariantIdxNoStructRow(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const oi = unwrapParen(exprIx)
  if oi < 0 { return -1 }
  const e = nodeAt(oi)
  if e is ObjLit {
    if structIndexOfObjCtx(oi, fnIx) >= 0 { return -1 }
    return objVariantRowCtx(oi, fnIx)
  }
  // A value `if`/`match` denotes the row only when every arm does; a literal arm is answered
  // here and any other arm by `exprVariantIndex` (D4639).
  const arms = valueJoinArmValues(oi)
  if arms.length == 0 { return -1 }
  let row = -1
  for v in arms {
    if v < 0 { return -1 }
    let av = objLitVariantIdxNoStructRow(v, fnIx)
    if av < 0 { av = exprVariantIndex(v, fnIx) }
    if av < 0 || (row >= 0 && av != row) { return -1 }
    row = av
  }
  row
}

// The same answer for a `LetDecl`'s INITIALIZER, and only for an UN-annotated binding:
// an ANNOTATED one is `letAnnVariantIdx`'s (D52), whose nominal answer must not be
// second-guessed by a field-set scan in either direction.
export function letObjLitVariantIdx(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 { return -1 }
    return objLitVariantIdxNoStructRow(d.letInit, fnIx)
  }
  -1
}

// The union-variant table index an expression at `exprIx` yields a CONCRETE variant
// struct ref for (a variant-typed param reference, or a parenthesized one), or -1. The
// receiver shape for a gap-#2 field read `o.field` where `o: TyObj`.
export function exprVariantIndex(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = nodeAt(exprIx)
  match e {
    Paren => {
      return exprVariantIndex(e.parInner, fnIx)
    }
    // `x as Cat` over a union yields the concrete variant — the cast's own recorded type is
    // the arm the checker proved. Without it, a binding cast to a variant falls to the i32 slot
    // default, and the `ref.cast` the cast emits lands in a slot typed i32.
    AsExpr => {
      if asExprIsUnionCastIn(exprIx, fnIx) {
        const anm = nominalStructNameOfTy(nodeTyIxOf(exprIx))
        if anm != "" { return variantIndexOf(anm) }
      }
      return -1
    }
    Ident => {
      const pvi = paramVariantIndex(fnIx, exprIx)
      if pvi >= 0 { return pvi }
      const dvi = declaredVariantIndex(exprIx)
      if dvi >= 0 { return dvi }
      // The capture leg — the fourth storage class this ladder lacked while its
      // boolean-and-nullable siblings carry it. `captureValKind`/`captureValStructIdx` already
      // bank the fact; only the reader is missing here. Without it a captured variant read
      // answers -1 and a nested function hands a raw struct ref to a union-box parameter.
      const cvi = capturedVariantIndex(fnIx, e.identName)
      if cvi >= 0 { return cvi }
      // A module GLOBAL whose cell is the kind-8 raw variant — the global twin of the
      // `declaredVariantIndex` LOCAL leg above, and the leg every member-read site
      // (`o.field`) needs to pick `uVarHeap` over `sHeapIdx` for a variant receiver.
      return globalReadVariantIndex(fnIx, exprIx)
    }
    // A call to a `: Cat`-returning function yields the concrete variant ref, in the three
    // callee forms the nullable twin handles arm for arm: a declared function, a closure value,
    // or a closure-valued field. Missing the latter two, a lambda binding or field closure
    // answers -1 — the whole kind decision here — so the value falls to the struct table.
    Call => {
      if e.callFn < 0 { return -1 }
      const callee = nodeAt(e.callFn)
      if callee is Ident {
        const cvsid = sidOfNode(e.callFn)
        const cvname = callee.identName
        // A DECLARED function keeps its own richer resolution (the `: Cat` annotation, then
        // the inferred `fRetKind`/`fRetStructIdx` pair) — unchanged, and asked first so no
        // named-callee answer moves.
        if fnIndexOfInScopeAt(cvsid, cvname, fnIx, e.callFn) >= 0 {
          return fnRetVariantIndexSid(cvsid, cvname, fnIx, e.callFn)
        }
        // A closure-value callee (`const f = (x: Circle) => x; f(c)`, `const f = idc; f(c)`,
        // a closure param `f(c)`), which `fnIndexOfSid` misses by construction. The resolved
        // `$fnsig` key is the same key `emitCallRef` casts the call through, so the slot this
        // reads and the functype the call site emits come from one fact.
        const cvk = calleeCloSigKeyOfRead(e.callFn, fnIx)
        if sigKeyRetKind(cvk) == "variant" { return sigKeyRetSlot(cvk) }
        return -1
      }
      // A closure-valued FIELD callee (`holder.go(c)`) — the twin's third rung, same gate.
      if callee is Member {
        const cvfe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
        if cvfe >= 0 {
          if cloRetValKind(cvfe) == "variant" { return cloRetValSlot(cvfe) }
        }
        return -1
      }
      return -1
    }
    // An index into a `Cat[]` variant-element ref list yields the bare variant struct.
    Index => {
      if exprRefArray(e.idxArr, fnIx) {
        const ren = refListElemNameOfExpr(e.idxArr, fnIx)
        // A plain-struct element list whose element shape also matches a value-union's struct
        // member must not read through that union's variant heap: the array physically holds
        // the plain struct's own heap, a distinct type from the box member. Only a genuine
        // concrete-variant element list resolves through the variant heap here.
        if structIndexOfTypeNameTy(ren, nodeTyAt(exprIx, fnIx)) < 0 {
          return variantIndexOf(ren)
        }
      }
      // A bare `m[k]` over an arm-valued map yields the bare variant struct — the map rung
      // this ladder lacked while `structIndexOfExpr`'s own `Index` arm carries its struct twin
      // (D34). Same slot, same kind gate, the other column; the two cannot both answer for one
      // binding.
      const ivs = mapReadMvSlot(exprIx, fnIx)
      if ivs >= 0 { return mvValVariantOf(ivs) }
    }
    // A `m[k] ?? d` over an arm-valued map — the BinExpr dual of the Index rung above, and
    // the same pairing: `structIndexOfExpr`'s `??` arm already reads `mvValStructIdx` off
    // `coalesceMvSlot`.
    BinExpr => {
      const cvs = coalesceMvSlot(exprIx, fnIx)
      if cvs >= 0 { return mvValVariantOf(cvs) }
      // A `<T|null> ?? <T>` whose `T` is a union ARM yields the non-null arm ref — the
      // variant twin of `structIndexOfExpr`'s own `??` arm, and needed for the same reason:
      // without it `(r ?? d).field` has no layout. The left's nullable-variant row drives
      // it, else the right default's. A join to another type is the box and has no row (D2373).
      if e.binOp == "??" {
        if coalesceResultIsBox(exprIx) { return -1 }
        // A nullable default keeps the result the niche, which no concrete row answers for.
        if exprNullableVariant(exprIx, fnIx) { return -1 }
        const lv = nulVariantIdxOfExpr(e.binLeft, fnIx)
        if lv >= 0 { return lv }
        return exprVariantIndex(e.binRight, fnIx)
      }
    }
    // An if-EXPRESSION whose every arm denotes ONE union row — the variant twin of
    // `exprStruct`'s own `IfStmt` arm. Arms denoting DIFFERENT rows join to the union BOX,
    // which `emitUnionCoerce`'s if-value path builds, so answering a concrete row for those
    // would store a raw variant ref into a box cell (D1668).
    IfStmt => {
      const ivi = ifThenValueIx(exprIx)
      if ivi >= 0 {
        const tvi = exprVariantIndex(ivi, fnIx)
        if tvi >= 0 {
          if ifArmsAllVariantIdx(exprIx, fnIx, tvi) { return tvi }
        }
      }
    }
    // No other expression names a union variant by its own form.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | Member | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// Does every arm of the if-expression at `ifIx` — an `else if` chain included — denote the
// union row `vi`? False for an else-less `if`, whose missing arm is `null` and whose join is
// the nullable niche, not this row.
function ifArmsAllVariantIdx(ifIx: i32, fnIx: i32, vi: i32): boolean {
  const s = nodeAt(ifIx)
  if s is IfStmt {
    const tv = ifArmValueExpr(s.ifThen)
    if tv < 0 { return false }
    if exprVariantIndex(tv, fnIx) != vi { return false }
    if s.ifElse < 0 { return false }
    const els = nodeAt(s.ifElse)
    if els is IfStmt { return ifArmsAllVariantIdx(s.ifElse, fnIx, vi) }
    const ev = ifArmValueExpr(s.ifElse)
    if ev < 0 { return false }
    return exprVariantIndex(ev, fnIx) == vi
  }
  false
}

// The union-variant table index a module global's cell holds, or -1 — the global sibling
// of `globalReadStructIndex`, gated on the cell actually being the kind-8 variant so the two
// never both answer for one binding. A global whose init names another global recurses one
// level per link; module globals cannot cycle.
function globalReadVariantIndex(fnIx: i32, readIx: i32): i32 {
  const li = globalLetOfRead(fnIx, readIx)
  if li < 0 { return -1 }
  if globalCellKind(li) != "variant" { return -1 }
  globalCellStructIdx(li)
}

// The struct table index a function `name` returns (recorded in `fRetStructIdx`), or -1.
// Frame-aware for the same reason its kind companion is: the two must resolve to the SAME
// function, or the kind says struct while the row is another instance's (D1788).
function fnRetStructIndexSid(sid: i32, name: string, fnIx: i32, at: i32) {
  const d = repOfNameResult(sid, name, fnIx, at)
  if d.rdCovered == 0 { return -1 }
  // Kind-gated, like every other reader of the polymorphic companion slot: `fRetStructIdx`
  // holds four namespaces selected by `fRetKind` (struct row, variant index, ref-list slot,
  // map shape), and every sibling reader gates on the kind first (D26) — the producer needs
  // the same gate a misreading consumer already carries.
  const k = d.rdKind
  if k != "struct" && k != "nulstruct" { return -1 }
  d.rdSlot
}

// The struct table index of the module global the read `readIx` denotes (from its
// annotation/initializer), or -1.
function globalReadStructIndex(fnIx: i32, readIx: i32) {
  const li = globalLetOfRead(fnIx, readIx)
  if li < 0 { return -1 }
  // Kind-gated, like every other storage class's struct reader — with only its variant
  // sibling gated, the two can both answer for one binding, and `emitUnionBoxArg`'s
  // layout-twin test re-emits the value from the twin's heap type (D200). `globalCellKind` is
  // the same function `emitGlobalSection` writes the cell with, so the two cannot drift.
  const gk = globalCellKind(li)
  if gk != "struct" && gk != "nulstruct" { return -1 }
  // The row the global section writes the cell at (D842), so the two cannot drift.
  globalCellStructIdx(li)
}

// The struct table index of a captured struct-ref variable `name` of the capturing lifted
// function `fnIx`, or -1. Mirrors `emitCapturedRead`'s guards so a captured struct receiver
// resolves exactly as a param/local/global receiver would. Gated on the capture's kind: the
// companion slot is polymorphic, so a map's mv slot read back as a struct index traps.
function capturedStructIndex(fnIx: i32, name: string) {
  const ck = capturedKindOf(fnIx, name)
  if ck != "struct" && ck != "nulstruct" { return -1 }
  capturedCompanionSlot(fnIx, name)
}

// The ref-list table slot of a captured ref-array variable, or -1 — `capturedStructIndex`'s
// sibling on the other index space the companion slot ranges over. The kind gate keeps a
// ref-list slot out of `sFieldStart` and a struct row out of `rlElemName`, so a captured
// `S[]` read resolves the same wrapper the env field is typed with.
export function capturedRefListSlot(fnIx: i32, name: string) {
  const ck = capturedKindOf(fnIx, name)
  if ck != "reflist" && ck != "nulreflist" { return -1 }
  capturedCompanionSlot(fnIx, name)
}

// The map shape of a captured nullable-map cell, or -1 when `name` is not such a capture.
// Reads the companion slot rather than re-deriving from the parent binding on purpose:
// `captureValStructIdx` typed the env field off that very number, so the narrowed read and
// the field cannot name two different `$mapStruct`s. -1 is safe only because the kind gate runs first.
function capturedNulMapShape(fnIx: i32, name: string) {
  if capturedKindOf(fnIx, name) != "nulmap" { return -1 }
  capturedCompanionSlot(fnIx, name)
}

// The raw `fbValtype` companion slot of a captured `name` of `fnIx`, or -1 when `name` is
// not a capture. Polymorphic in the kind — the number lives in whichever index space
// `capturedKindOf` names, so every consumer goes through a kind-gated reader above and never
// calls this directly.
function capturedCompanionSlot(fnIx: i32, name: string) {
  if fnIx < 0 { return -1 }
  if !fnNestUsed { return -1 }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return -1 }
  const caps = captureNamesOf(fe)
  let ci = 0
  while ci < caps.length {
    if caps[ci] == name { return captureValStructIdx(fe, name) }
    ci = ci + 1
  }
  -1
}

// The value kind of a captured variable `name` of the capturing lifted function `fnIx`, or
// `null` if not a capture — the classifier-side mirror of `capturedStructIndex`. No
// `fnEnvIdxOf` guard, since that index is minted after every classification pass and gating
// on it silently answered `null` for the whole of `computeRetInference` — invalid wasm.
export function capturedKindOf(fnIx: i32, name: string): VKind | null {
  if fnIx < 0 { return null }
  if !fnNestUsed { return null }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return null }
  const caps = captureNamesOf(fe)
  let ci = 0
  while ci < caps.length {
    if caps[ci] == name { return captureValKind(fe, name) }
    ci = ci + 1
  }
  null
}

// The union member-set NAME of a CAPTURED union-box variable `name` (kind 4) of the capturing
// function `fnIx` — resolved from the PARENT frame's binding annotation / init, so `a is Cat`
// narrows a captured `a: Cat | Dog`. "" when `name` is not a captured union. The union-name
// dual of `capturedStructIndex`.
function capturedUnionName(fnIx: i32, name: string) {
  if capturedKindOf(fnIx, name) != "union" { return "" }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return "" }
  const b = parentBindingOf(fe, name)
  if b < 0 {
    // A captured loop variable has no declaration: its member set comes from the iterable,
    // through the rung `forInLoopVarUnionName` asks for the uncaptured read (D2521).
    const lvIter = captureLoopVarIterOf(fe, name)
    if lvIter < 0 { return "" }
    const lvf = parentBindingFrameArenaOf(fe, name)
    if captureLoopVarIsPair(fe, name) {
      return forInPairUnionElemName(lvIter, lvf)
    }
    return forInIterUnionElemName(lvIter, lvf)
  }
  const bn = nodeAt(b)
  match bn {
    Param => {
      const pn = tyNameOf(bn.parType)
      // The registry test off the row: a canon-rewritten `tyName` is a compiler-produced
      // spelling, so `annRowOfNode` reads `canonTyIxOf` there and `nodeTyIxOf` otherwise, though
      // the name is still the product returned.
      if unRowOfCanon(annRowOfNode(bn.parType)) >= 0 { return pn }
      return ""
    }
    LetDecl => {
      const par = fnParent[fe]
      if par >= 0 {
        const lun = letUnionNameOf(b, fnStmts[par])
        if lun != "" { return lun }
        // The env field is the box, so an un-annotated init the checker typed as a value union
        // (`m[k]`, `m.get(k)` over a scalar-valued map) names its set from that type (D3757).
        if bn.letType < 0 {
          const nun = nodeUnionName(unwrapParen(bn.letInit))
          if isValueUnionName(nun) { return nun }
        }
      }
    }
    // No other node is a captured union binding.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  ""
}

// `capturedUnionName`'s type: the parent frame's binding's, or -1 (a captured loop variable
// has no declaration to read one from).
function capturedUnionTyIx(fnIx: i32, name: string): i32 {
  if capturedKindOf(fnIx, name) != "union" { return -1 }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return -1 }
  const b = parentBindingOf(fe, name)
  if b < 0 { return -1 }
  const bn = nodeAt(b)
  if bn is Param { return annRowOfNode(bn.parType) }
  const par = fnParent[fe]
  if par < 0 { return -1 }
  letUnionTyIxOf(b, fnStmts[par])
}

// The union type the ident `sid` read at `atIx` is declared or inferred at — the binding
// `unionNameOfRead` names, as a type: a capture's from its own frame, else the binding's
// annotation or initializer. -1 for a loop variable, which has no binding node.
export function identUnionTyAt(sid: i32, fnIx: i32, atIx: i32): i32 {
  const c = capturedUnionTyIx(fnIx, sidText(sid))
  if c >= 0 { return c }
  unionTyIxOfIdentAt(sid, fnIx, atIx)
}

export function structIndexOfExpr(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = nodeAt(exprIx)
  match e {
    ObjLit => {
      return structIndexOfObjCtx(exprIx, fnIx)
    }
    // Every other expression is resolved by the rungs below.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  const asgCell = asgCellOf(exprIx, fnIx)
  if asgCell >= 0 { return structIndexOfExpr(asgCell, fnIx) }
  match e {
    Paren => {
      return structIndexOfExpr(e.parInner, fnIx)
    }
    AsExpr => {
      const asr = asNulStructRow(exprIx)
      if asr >= 0 { return asr }
      const atr = asTrapStructRow(exprIx)
      if atr >= 0 { return atr }
    }
    IfStmt => {
      // An if-EXPRESSION whose join is a struct (`const b = if c { mk(1) } else { mk(2) }`): the
      // THEN arm's struct index classifies the whole `if` (the checker proved the arms agree), so an
      // un-annotated binding resolves the same struct heap type the `emitIfExprRef` join emits.
      // A join of records wider than its arms is its own row, whatever row an arm takes (D2731).
      const jr = joinedRecordRowOf(exprIx, fnIx)
      if jr >= 0 { return jr }
      const tv = ifThenValueIx(exprIx)
      if tv >= 0 { return structIndexOfExpr(tv, fnIx) }
    }
    BinExpr => {
      // A `m[k] ?? default` over a STRUCT-valued map resolves to the value type's struct index (the
      // mv slot's `mvValStructIdx`), so the field-read layout is found.
      const cms = coalesceMvSlot(exprIx, fnIx)
      if cms >= 0 {
        // An ARM value has no `sNames` row; its layout is `exprVariantIndex`'s (D34).
        if mvValVariantOf(cms) >= 0 { return -1 }
        if mvValKind[cms] == MVK_STRUCT { return mvValStructIdxOf(cms) }
      }
      // A `<S|null> ?? <S>` coalesce resolves to the (inner) struct index — so `(r ?? d).field` finds
      // the layout. The left's nullable struct drives it (its inner struct), else the right default.
      if e.binOp == "??" {
        if coalesceResultIsBox(exprIx) { return -1 }
        const ls = structIndexOfExpr(e.binLeft, fnIx)
        if ls >= 0 { return ls }
        return structIndexOfExpr(e.binRight, fnIx)
      }
    }
    Call => {
      return structIndexOfCallExpr(e, exprIx, fnIx)
    }
    Ident => {
      return structIndexOfIdentExpr(e, exprIx, fnIx)
    }
    Index => {
      // `xs[i]` over a struct-element ref list yields that list's element struct. The
      // element struct table index comes from the receiver's per-element-type slot's name
      // (`Tok[]` → `Tok` → its struct index), so distinct struct ref-lists resolve to
      // distinct struct types — not always heap-type 0.
      return structIndexOfIndexExpr(e, exprIx, fnIx)
    }
    OptMember => {
      // The `?.` producer (D1084): `o?.f` over `o: T | null` with `T = {f: S}` banks `S | null`,
      // so an `==` against another `S | null` resolves both operands through this function. Every
      // other producer of `S | null` already answered; only `?.` fell to the -1 tail — a missing
      // arm. The body is the `Member` arm's struct leg verbatim.
      const osi = structIndexOfExpr(e.omObj, fnIx)
      if osi >= 0 {
        const ofi = sFieldIndex(osi, e.omProp)
        if ofi >= 0 {
          if sFieldTypeAt(osi, ofi) == FC_STRUCT {
            return sFieldTgtStructIdx(osi, ofi)
          }
        }
      }
      return -1
    }
    Member => {
      return structIndexOfMemberExpr(e, exprIx, fnIx)
    }
    // No other expression names a struct row.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// The return annotation node of function `name` when it names a record type, or -1. A generic
// instance's declared return is its pin, which can be wider than the argument the call's
// checked type echoes, and the instance returns the pin's row (D8203).
function fnDeclRetRecNodeAt(sid: i32, name: string, fnIx: i32, at: i32): i32 {
  const fi = fnIndexOfInScopeAt(sid, name, fnIx, at)
  if fi < 0 || fi >= fnStmts.length { return -1 }
  const fd = nodeAt(fnStmts[fi])
  if !(fd is FuncDecl) || fd.fnRet < 0 { return -1 }
  const rt = nodeTyIxOf(fd.fnRet)
  if rt < 0 || !(tyAt(rt) is TyObj) { return -1 }
  fd.fnRet
}

// The row of return annotation `drn`'s own record type: its rep's row, else a field-set match
// whose row type is that type. -1 when neither; a row only sharing the field names is not it.
function fnDeclRetOwnRow(drn: i32): i32 {
  if drn < 0 { return -1 }
  const cr = repRowOfTyStruct(nodeRepTyIxOf(drn), sScanLim())
  if cr >= 0 { return cr }
  const fr = structRowOfObjFieldSet(nodeTyIxOf(drn))
  if fr < 0 || fr >= sTyIx.length { return -1 }
  if tySame(sTyIx[fr], nodeTyIxOf(drn)) { return fr }
  -1
}

// The struct row a call `e` returns: a named or closure callee's return row, a field or
// indexed closure's, a list `pop`/`get`, then the checker's recorded type. -1 when the
// result is not a struct.
function structIndexOfCallExpr(e: Call, exprIx: i32, fnIx: i32): i32 {
  if e.callFn < 0 { return -1 }
  const callee = nodeAt(e.callFn)
  if callee is Ident {
    const ri = fnRetStructIndexSid(
      sidOfNode(e.callFn),
      callee.identName,
      fnIx,
      e.callFn,
    )
    if ri >= 0 { return ri }
    const drn = fnDeclRetRecNodeAt(
      sidOfNode(e.callFn),
      callee.identName,
      fnIx,
      e.callFn,
    )
    const dr = fnDeclRetOwnRow(drn)
    // A function handing back a union arm, with no row of its declared return's own type, returns
    // that arm's variant row, which `exprVariantIndex` names; a field-set scan names another (D8341).
    if (
      dr < 0
      && fnRetVariantIndexSid(
        sidOfNode(e.callFn),
        callee.identName,
        fnIx,
        e.callFn,
      )
        >= 0
    ) {
      return -1
    }
    // A struct-returning function VALUE (a binding / `(i32) => S` param callee, invisible
    // to `fnRetStructIndex`): the struct index from its resolved `>sN;` sig. Falls through to the
    // per-node-type fallback below when the sig path misses (a value INFERRED from a factory call —
    // `const g = mk()` — whose `>sN;` the syntactic path can't recover).
    const ci = calleeReturnsStructIdxOfRead(e.callFn, fnIx)
    if ci >= 0 { return ci }
    if dr >= 0 { return dr }
    if drn >= 0 {
      const fr = structRowOfObjFieldSet(nodeTyIxOf(drn))
      if fr >= 0 { return fr }
    }
  }
  // A field-closure call (`(a."[]")(i)` — a chained index trap whose "[]"
  // returns another trap object) yields the field function's return struct.
  if callee is Member {
    if (
      drwFieldClosure(structIndexOfExpr(callee.memObj, fnIx), callee.memProp)
    ) {
      const cfe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      if cfe >= 0 {
        if fRetKind[cfe] == "struct" || fRetKind[cfe] == "nulstruct" {
          return fRetStructIdx[cfe]
        }
      }
    }
  }
  // `xs.pop()` / `xs.get(i)` over a struct-element ref list yield that list's
  // element struct (as `S | null` — see `structListPopGetElem`).
  const slv = structListPopGetElem(exprIx, fnIx)
  if slv >= 0 { return slv }
  // Fallback, scoped to a call: a struct-returning closure value call whose callee the
  // cases above miss — an indexed closure-array element or a value inferred from a factory
  // call. Resolves the struct from the checker's per-node type, gated on the cheap
  // `nodeTyIsObj`. Off the hot path — struct receivers resolve syntactically above.
  if nodeTyIsObj(exprIx) {
    // The Index arm's ordering, exactly: exact spelling, then the arena row, then the
    // lenient field-set scan — `structIndexByName` runs ahead of the arena rung on purpose,
    // since an inline shape interned under its render can differ from the arena's smallest
    // row sharing the canon key; arena-first would silently flip a struct `==` into false.
    const snc = nodeTyCanonObjName(exprIx)
    if snc != "" {
      const sbn = structIndexOfTypeNameTy(snc, nodeTyIxOf(exprIx))
      if sbn >= 0 {
        // The render says struct; a declared record's own row says which one (D9784).
        const sdr = recRowOfTy(nodeTyIxOf(exprIx))
        if sdr >= 0 { return sdr }
        return sbn
      }
    }
    const cr = repRowOfTyStruct(nodeRepTyAt(exprIx, fnIx), sScanLim())
    if cr >= 0 { return cr }
    // The field-set rung on the canon render is gone: `structRowOfObjFieldSet` below already
    // asks the same question of the type. `canonTyIxOf` can be -1 at this node while
    // `nodeTyIxOf`/`nodeRepTyIxOf` hold it; `snc` stays since `structIndexByName(snc)` is a
    // lookup of a declared name — nominal identity the arena cannot recover.
    const fsx = structRowOfObjFieldSet(nodeTyIxOf(exprIx))
    if fsx >= 0 { return fsx }
    // The render-based rung here is gone: the question it asked — the type's spelling's
    // field set against the table — is what the rung above now asks of the type directly.
    // Its `-1` return is load-bearing, short-circuiting the nullable-struct rung below, so
    // the fallback stays and only the render lookup is retired (`anonTySpellable`).
    if anonTySpellable(nodeTyIxOf(exprIx)) { return -1 }
  }
  // The nullable-struct dual: a `S | null`-returning closure value call resolves to its
  // inner struct's layout index, so the kind-9 binding's `!= null` narrow finds `P`. Arena
  // first, peeling `TyNullable`. Wider than the name rung it fronts: `tyToEmitName` returns
  // "" on a cycle while `repCanonId` does not, so a recursive inner answers a row here where the name rung declines.
  const nnTy = nodeRepTyAt(exprIx, fnIx)
  if nnTy >= 0 {
    const nnT = tyAt(nnTy)
    if nnT is TyNullable {
      const nr = repRowOfTyStruct(nnT.nInner, sScanLim())
      if nr >= 0 { return nr }
    }
  }
  const nn = nodeNulStructInnerName(exprIx)
  if nn != "" { return structIndexOfTypeNameTy(nn, nodeTyIxOf(exprIx)) }
  return -1
}

// The struct row a name read `e` holds: a param, a declared or global binding, a capture,
// or the frame's own `let`. -1 when the binding is not a struct, or is a variant.
function structIndexOfIdentExpr(e: Ident, exprIx: i32, fnIx: i32): i32 {
  const pi = paramStructIndex(fnIx, e.identName)
  if pi >= 0 && paramReadAt(fnIx, exprIx) { return pi }
  if !identReadsGlobal(exprIx) {
    const di = declaredStructIndex(exprIx)
    if di >= 0 { return di }
  }
  const gi = globalReadStructIndex(fnIx, exprIx)
  if gi >= 0 { return gi }
  const ci = capturedStructIndex(fnIx, e.identName)
  if ci >= 0 { return ci }
  // The frame's own `let`, arm for arm with `exprNullableStruct`'s leg: a kind without its
  // row is `ref valtype with no interned shape`, so the two land together (D21). Gated on
  // the variant the way every other index resolver here is: an arm's values live at
  // `uVarHeap`, so answering a struct row for one reaches a receiver that is not one.
  const fli = frameLetOf(fnIx, exprIx)
  if fli >= 0 && !letIsVariant(fli, fnIx) { return structIndexOfLet(fli, fnIx) }
  // The module frame's own `let`, which the leg above cannot reach: a module-scope BLOCK
  // binding is no frame's `fnBody` and no global. Annotated only — an initializer resolves
  // against the frame it is written in, so reading one from outside can name a row other
  // than the local's, while an annotation reads the same anywhere (D1636).
  const mli = moduleLocalLetOfRead(emitRootIx, exprIx)
  if mli >= 0 && globalHasTypeAnn(mli) && !letIsVariant(mli, -1) {
    return structIndexOfLet(mli, -1)
  }
  -1
}

// The struct row an index read `e` yields: a struct-element ref list's element row, or a
// struct-valued map's value row. -1 otherwise.
function structIndexOfIndexExpr(e: Index, exprIx: i32, fnIx: i32): i32 {
  if exprRefArray(e.idxArr, fnIx) {
    let nm = refListElemNameOfExpr(e.idxArr, fnIx)
    // A nullable-struct element (`(P | null)[]`, slot key "P | null") resolves to the bare
    // struct `P` — strip the `| null` so a narrowed `xs[i].field` finds P's layout. The
    // structural bridge (`structIndexOfTypeName`) then also resolves an inline-shape
    // element (`{v:i32}[]` param) to its declared twin's layout.
    nm = nonNulBaseOf(nm)
    // Nominal exact-name match first — AFTER-not-FIRST relative to the arena rung (#1061).
    const sbn = structIndexByName(nm)
    if sbn >= 0 { return sbn }
    // Node route: resolve the receiver's checked type, `| null` peeled like the name above,
    // through the canonical-key vocabulary (`repRowOfTyStruct`), the read-side dual of
    // `structIdxOfElemName`. Tells a same-fieldset nested twin apart by its full field types
    // (D4721); falls to the lenient fieldset scan when uncovered.
    const rr = repRowOfTyStruct(
      tyPeelNul(nodeRepTyAt(exprIx, fnIx)),
      sScanLim(),
    )
    if rr >= 0 { return rr }
    // The arena already said "not an object", so the field-set matcher is not asked:
    // `structIndexOfTypeName` parses a field set that a non-`TyObj` recorded type does not
    // have, so skipping it is answer-preserving. The guard is on "the arena recorded a
    // non-object", not on "the arena declined" — `repRowOfTyStruct` also returns -1 for other reasons, where the name path still answers.
    let sieObj = false
    let sieKnown = false
    const sieTy = nodeRepTyAt(exprIx, fnIx)
    if sieTy >= 0 {
      sieKnown = true
      const sieT = tyAt(sieTy)
      if sieT is TyObj { sieObj = true }
    }
    if !sieKnown || sieObj {
      const si = structIndexOfTypeNameTy(nm, sieTy)
      if si >= 0 { return si }
    }
  }
  // A BARE `m[k]` over a STRUCT-valued map resolves to the value type's struct index, so a
  // narrowed `(m[k]).field` finds the layout — the Index dual of the `?? default` BinExpr case.
  const mrs = mapReadMvSlot(exprIx, fnIx)
  if mrs >= 0 {
    // An ARM value has no `sNames` row; its layout is `exprVariantIndex`'s (D34).
    if mvValVariantOf(mrs) >= 0 { return -1 }
    if mvValKind[mrs] == MVK_STRUCT { return mvValStructIdxOf(mrs) }
  }
  -1
}

// The struct row a field read `e` yields: the receiver's struct field, a narrowed or
// variant receiver's field, or the row every member of a struct union shares. -1 when the
// field is not a nested struct.
function structIndexOfMemberExpr(e: Member, exprIx: i32, fnIx: i32): i32 {
  const msi = structIndexOfExpr(e.memObj, fnIx)
  if msi >= 0 {
    const mfi = sFieldIndex(msi, e.memProp)
    if mfi >= 0 {
      if sFieldTypeAt(msi, mfi) == FC_STRUCT {
        return sFieldTgtStructIdx(msi, mfi)
      }
    }
    return -1
  }
  // A narrowed union member and a variant-typed receiver resolve through the variant
  // field tables — the code-15 twin of `mapShapeOfExpr`'s Member dispatch. Checked after
  // the struct probe, and only on its receiver miss.
  const nvi = memNarrowVariantIndex(exprIx, fnIx)
  if nvi >= 0 {
    const nvfi = variantFieldIndex(nvi, e.memProp)
    if nvfi >= 0 {
      if variantFieldTypeAt(nvi, nvfi) == FC_STRUCT {
        return uFieldTgtStructIdx(nvi, nvfi)
      }
    }
  }
  // D1114 — the niche twin of the `pvi` rung below: an arm has no `sNames` row, so the
  // struct probe above misses, and `variantStructHeapTwinAt` declines code 15 by design. A
  // nested read needs the field's target row, which `uFieldTgtStructIdx` holds. Kind-gated
  // exactly as `nulVariantIdxOfExpr`'s header requires.
  const nvi2 = nulVariantIdxOfExpr(e.memObj, fnIx)
  if nvi2 >= 0 {
    const nvfi2 = variantFieldIndex(nvi2, e.memProp)
    if nvfi2 >= 0 {
      if variantFieldTypeAt(nvi2, nvfi2) == FC_STRUCT {
        return uFieldTgtStructIdx(nvi2, nvfi2)
      }
    }
  }
  const pvi = exprVariantIndex(e.memObj, fnIx)
  if pvi >= 0 {
    const pvfi = variantFieldIndex(pvi, e.memProp)
    if pvfi >= 0 {
      if variantFieldTypeAt(pvi, pvfi) == FC_STRUCT {
        // Not migrated: the arena twin of this lookup is `uFieldTgtStructIdx`, used at every
        // other code-15 variant-field site. This arm does run, but only on names the nominal
        // table already holds, so the widening it would take is unexercised rather than safe;
        // the flip count licenses it, not byte identity (rep-descriptor-campaign.md §11.8).
        return structIndexByName(variantFieldElemName(pvi, pvfi))
      }
    }
  }
  // A shared read over an un-narrowed struct union: the one row every member's field
  // targets, the layout the dispatch's result is typed at (D3562).
  if pvi < 0 {
    return sharedFieldTgtStructIdx(e.memObj, e.memProp, exprIx, fnIx)
  }
  -1
}

// The struct row the shared field read `readIx` over a struct union yields, or -1 unless every
// member it reads stores the field as a nested struct of one row.
function sharedFieldTgtStructIdx(
  recvIx: i32,
  prop: string,
  readIx: i32,
  fnIx: i32,
): i32 {
  // The common receiver, a list or a string, is no union: answered off its recorded type.
  const rt = nodeTyAt(unwrapParen(recvIx), fnIx)
  if rt >= 0 && rt < T.tys.length {
    const rk = tyAt(rt)
    if !(rk is TyUnion) && !(rk is TyNullable) { return -1 }
  }
  const vis: i32[] = []
  const fis: i32[] = []
  if sharedUnionFieldPlan(recvIx, prop, readIx, fnIx, vis, fis) != FC_STRUCT {
    return -1
  }
  const r0 = uFieldTgtStructIdx(vis[0], fis[0])
  let i = 1
  while i < vis.length {
    if uFieldTgtStructIdx(vis[i], fis[i]) != r0 { return -1 }
    i = i + 1
  }
  r0
}

// The struct table index a struct-typed `LetDecl` binds: from its annotation if
// present, else inferred from its initializer. -1 if not a struct local.
export function structIndexOfLet(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    // A value-union annotation pins the cell to the box, which has no struct-table layout,
    // so the answer is -1 and the initializer must not be consulted. Falling through would
    // resolve the arm's object literal by field-name set and hand back whichever row shares
    // those names, short-circuiting the narrowed-variant resolution the read actually needs.
    if letAnnIsUnion(letIx) { return -1 }
    if d.letType >= 0 {
      const lt = nodeAt(d.letType)
      if lt is TypeRef {
        // The arena rung: this is the emitter's hottest name query and it holds a node, so it
        // can ask by type. `structIndexByName` finds the row interned under this spelling,
        // while `structIndexOfTy` finds the first row denoting this type, possibly a
        // structurally identical twin. Revert this rung if a pair ever surfaces with `repStructSlotsTwin == 0`.
        let si = structIndexOfTy(nodeTyIxOf(d.letType))
        if si < 0 {
          si = structIndexOfTypeNameTy(lt.tyName, nodeTyIxOf(d.letType))
        }
        if si >= 0 { return si }
        // A nullable annotation resolves its non-null part, as `collectAnnShapes` interned it:
        // needed when the initializer is a bare `null`, with no struct literal to infer from.
        const si2 = structIndexOfNullPartTy(nodeTyIxOf(d.letType))
        if si2 >= 0 { return si2 }
        // A non-null part spelled as a same-shape union (`A | B | null`) names no struct
        // row; its arena type is the one record they share.
        const si3 = structIndexOfTy(nonNullTy(nodeTyIxOf(d.letType)))
        if si3 >= 0 { return si3 }
      }
    }
    return structIndexOfExpr(d.letInit, fnIx)
  }
  -1
}

// ── union-typedness of expressions (G1) ──
// Parallel to the struct family: decide whether an expression, param, local, or let is the
// declared union (a boxed value). An object literal's intrinsic type is its variant struct,
// not the union — boxing happens at a flow boundary, so a bare object literal is not this.

// True if function `name` declares the union as its return type.
function fnRetUnionSid(sid: i32, name: string, fnIx: i32, at: i32) {
  repOfNameResult(sid, name, fnIx, at).rdKind == "union"
}

// The type of the operator at `exprIx` inside function `fnIx`: the instance's pin of a recorded
// hole, else the recorded type (D9701).
function opTyIn(exprIx: i32, fnIx: i32): i32 {
  const p = holeOperandTyOf(exprIx, fnIx)
  if p >= 0 { return p }
  nodeTyIxOf(unwrapParen(exprIx))
}

// `opTyIn` where the operator yields a numeric union's box: an instance's read of the hole counts
// only when an operand `l`/`r` (-1 for none) is itself a box, since an operand the instance keeps
// at its scalar pin is computed at that width (D9870). -1 otherwise.
function opNumUnionTyIn(exprIx: i32, fnIx: i32, l: i32, r: i32): i32 {
  const t = opTyIn(exprIx, fnIx)
  if !tyIsNumUnion(t) { return -1 }
  if holeOperandTyOf(exprIx, fnIx) < 0 { return t }
  if (l >= 0 && exprUnion(l, fnIx)) || (r >= 0 && exprUnion(r, fnIx)) {
    return t
  }
  -1
}

// True if evaluating the expression at `exprIx` yields the union box: a union-returning
// call, a union param/local reference, or a parenthesized union expression. A bare object
// literal is not a union here.
export function exprUnion(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = nodeAt(exprIx)
  match e {
    Paren => {
      return exprUnion(e.parInner, fnIx)
    }
    // A standalone `?.` whose leaf is a scalar yields `<scalar> | null`, which has no spare
    // value to niche into and so reps as the value-union box, exactly what
    // `emitOptMemberValue` builds. Without this arm, boxing happened twice — `struct.new
    // $vbI32` applied to a `(ref $uBox)` — invalid wasm. The niche nullables a `?.` can also produce are structurally excluded.
    OptMember => {
      if tyIsNulScalarBox(nodeTyAt(exprIx, fnIx)) { return true }
      // A value-union leaf (code 16) is already the box, and the chain only adds `null` to
      // its member set, so the whole `?.` is a box value too (D803): without this arm the
      // chain classified as a scalar while `emitOptMemberValue` built the box.
      return optChainLeafFieldCode(exprIx, fnIx) == FC_UNION
    }
    // `x as Shape` over a wider union yields the BOX at a narrower type — the sub-union cast
    // does not unbox, so its result is a union value like any other. Answered from the cast's
    // own recorded type: a SINGLE-arm target is not a union and correctly answers false here,
    // which is what keeps `const c = mk(a) as Circle` a variant binding rather than a box one.
    AsExpr => {
      return exprUnionAs(e, exprIx, fnIx)
    }
    Call => {
      return exprUnionCall(e, exprIx, fnIx)
    }
    Ident => {
      return exprUnionIdent(e, exprIx, fnIx)
    }
    // Every other expression is resolved by the rungs below.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Member | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  match e {
    Member => {
      // A field read is a union box when its recorded rep is one.
      const urd = repOfNode(exprIx, fnIx)
      if urd.rdCovered == 1 && urd.rdKind == "union" { return true }
      // A field or cell narrowed to a niche-repped `A | null` reads as that niche (D2590).
      if nicheReadKindAt(exprIx, fnIx) >= 0 { return false }
      // A plain read of a value-union struct field (code 16) yields the field's union box, a
      // value usable wherever a union is expected. A read narrowed to one scalar atom unboxes
      // (mirrors the code-16 read path in emitMem), so the union box is not the value here — same
      // as the narrowed Ident case above; a sub-union narrowing keeps the box.
      if memberUnionFieldNameRead(exprIx, fnIx) == "" { return false }
      if memNarrowAtomKind(exprIx, fnIx) >= 0 { return false }
      // The container arms of the same narrowing (D1014), as the Index arm above.
      if placeReadContainerAt(exprIx, fnIx) > 0 { return false }
      // D209 — the other end of the read: an un-narrowed read the read site unboxes is not a
      // union value here either, asked with the same predicate that site uses, so the consumer
      // boxes exactly what the read delivered.
      if memReadUnboxAtomKind(exprIx, fnIx) >= 0 { return false }
      return true
    }
    Index => {
      // A field or cell narrowed to a niche-repped `A | null` reads as that niche (D2590).
      if nicheReadKindAt(exprIx, fnIx) >= 0 { return false }
      // `ns[i]` over a UNION-element ref list yields the union box (G7-ref) — so the value
      // is usable with `is`-narrowing (a `let n0 = ns[i]` is a union local). Per-slot: the
      // element kind comes from the receiver's distinct ref-list slot (2 = union box).
      return exprUnionIndex(e, exprIx, fnIx)
    }
    Unary => {
      // An operator over a numeric union whose member results differ yields their union's box.
      if numUnionMinted && opNumUnionTyIn(exprIx, fnIx, e.unArg, -1) >= 0 {
        if e.unOp == "-" { return true }
      }
    }
    BinExpr => {
      if (
        numUnionMinted
        && opNumUnionTyIn(exprIx, fnIx, e.binLeft, e.binRight) >= 0
      ) {
        if e.binOp != "=" && e.binOp != "??" { return true }
      }
      // `m[k] ?? d` over a UNION-valued map yields the value union box — EXCEPT a `scalar | null`
      // value, which `??` peels to the raw unboxed scalar (classified by `exprIsI64`/`exprIsF64`/… ).
      return exprUnionBin(e, exprIx, fnIx)
    }
    IfStmt => {
      // D969 — an if-expression is its then arm's union-ness. The `??` desugaring turns `x ?? d`
      // over a nullable value-union box into an if-expression, and with an un-annotated
      // destination the binding took a scalar cell and the box went into it — invalid wasm. The
      // arms share the checker's join type, so the then arm classifies the whole if-expression.
      return exprUnionIf(exprIx, fnIx)
    }
    // No other expression is a union value.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Call | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// Whether `ty` is a literal union of one base, which reps as an interned atom (string members)
// or as that base scalar (numeric members), never as a box.
export function litUnionAtomTy(ty: i32): boolean {
  if ty < 0 { return false }
  tyIsLitUnion(ty) || numLitUnionBaseTy(ty) >= 0
}

// Whether `as` node `ix` casts a union box to a literal-union target, whose arm rides the box at
// its base's rep: the base scalar for numeric members, the member string for string ones (D11221).
export function asExprBoxToLitUnion(ix: i32, fnIx: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if !(n is AsExpr) { return false }
  if n.asMode == "wrap" { return false }
  if !exprUnion(n.asObj, fnIx) { return false }
  let tty = nodeTyIxOf(ix)
  if n.asMode == "null" { tty = tyPeelNul(tty) }
  litUnionAtomTy(tty)
}

// Whether `as` node `ix` casts a numeric literal-union scalar to a numeric literal union of the
// same base, which lowers as a member test of the scalar itself (D11221).
export function asExprNumLitScalarCast(ix: i32, fnIx: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if !(n is AsExpr) { return false }
  if n.asMode == "wrap" { return false }
  if exprUnion(n.asObj, fnIx) { return false }
  let tty = nodeTyIxOf(ix)
  if n.asMode == "null" { tty = tyPeelNul(tty) }
  const tb = numLitUnionBaseTy(tty)
  tb >= 0 && tb == numLitUnionBaseTy(nodeTyIxOf(n.asObj))
}

// Whether box cast `ix` to a string literal union yields the atom id rather than the member
// string: the same rule `asExprLitAtomCast` applies to an atom operand.
export function asBoxLitUnionYieldsAtom(ix: i32, fnIx: i32): boolean {
  const n = nodeAt(ix)
  if !(n is AsExpr) { return false }
  let tty = nodeTyAt(ix, fnIx)
  if n.asMode == "null" { tty = tyPeelNul(tty) }
  if !tyIsLitUnion(tty) || tyIsBareStrLit(tty) { return false }
  litUnionAliasNameOfTy(tty) != "" || asTargetRepsAtom(ix, n.asMode, fnIx)
}

// True if a cast `e` yields the union box: a sub-union cast, or a numeric `as?` that
// can fail. A single-arm target and a numeric `as!` or `as` are not.
function exprUnionAs(e: AsExpr, exprIx: i32, fnIx: i32): boolean {
  // D1041 — a numeric `as?` that can fail yields `T | null`, and for the four numeric
  // atoms that is the value-union box, exactly as the union arm's `as? i32` is. Every box
  // consumer keys on this predicate, so without it the box lands in a scalar slot —
  // `vl check` rc 0, invalid wasm.
  if asExprHoleNumOpt(exprIx) && !asExprIsUnionCastIn(exprIx, fnIx) {
    return true
  }
  // A scalar member test's `as?` yields `N | null`, the base-tagged box (D11221).
  if e.asMode == "null" && asExprNumLitScalarCast(exprIx, fnIx) { return true }
  if asExprNumFallible(exprIx) {
    if e.asMode == "null" { return true }
    // `as!` and a bare `as` yield `T` itself — a plain scalar, never a box.
    return false
  }
  if asExprIsUnionCastIn(exprIx, fnIx) {
    const cty = nodeTyIxOf(exprIx)
    // A literal-union target reps as one atom or its base scalar, so `as!` and `as` unbox (D11220).
    if e.asMode != "null" && litUnionAtomTy(cty) { return false }
    if cty >= 0 {
      const ct = tyAt(cty)
      if ct is TyUnion { return true }
      // `x as? T` records `T | null`, and for a sub-union or a numeric arm that is still a
      // box — a non-null box carrying `nullBoxTag()` for the absent case. Reading only the
      // bare `TyUnion` left the coalescing forms classified as "not a union" and emitted an
      // untyped `null`. `nodeTyIsUnionAlias`'s third arm already asks exactly this question.
      if nodeTyIsUnionAlias(exprIx) { return true }
    }
  }
  return false
}

// True if a call `e` yields the union box: a union-returning named, closure, field or
// indexed callee, a list `pop`/`get` box, then the checker's recorded type. False for a
// pure literal union or a one-list union.
function exprUnionCall(e: Call, exprIx: i32, fnIx: i32): boolean {
  if e.callFn < 0 { return false }
  const callee = nodeAt(e.callFn)
  if callee is Ident {
    if fnRetUnionSid(sidOfNode(e.callFn), callee.identName, fnIx, e.callFn) {
      return true
    }
    // A union-returning function VALUE (a binding / `(…) => A | B` param callee) — its
    // result is the union box, `>u`.
    if calleeRetKindOfRead(e.callFn, fnIx) == "union" { return true }
    // A miss here is not authoritative: a closure rebound from a composed carrier with no
    // annotation has no sig the syntactic resolution sees, yet its call_ref yields the
    // union box — fall through to the checker-typed `nodeTyIsUnion` fallback below, so the
    // binding classifies as the box instead of a raw i32 slot.
  }
  // A union-returning FIELD-closure call.
  if callee is Member {
    // `xs.pop()` / `xs.get(i)` over a value-union ref list already yields the box, `null`
    // riding as its tag, so every box-typed destination must pass it through rather than
    // box it again — the predicate twin of `unionNameOfExpr`'s own arm (D1881).
    if popUnionBoxElem(popRefRecvSlot(exprIx, fnIx)) { return true }
    const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
    if ffe >= 0 { return repOfFnSlot(ffe).rdKind == "union" }
  }
  // A union-returning INDEXED closure-element call (`xs[i](1)` over a
  // `((i32) => A | B)[]`): the element signature's result token is the box (`>u`).
  // The checker net below can miss it (a union WITH null records nullable-shaped),
  // so the sig-derived kind is consulted like the other `cloArrCallRetKind` arms.
  if cloArrCallRetKind(exprIx, fnIx) == "union" { return true }
  // A lambda literal called in place, or a closure a call hands back (`mk()(x)`): its
  // `$fnsig` result token decides the rep, and a `string | i32 | null` or `K | null` result
  // is keyed as the box while the checker's nullable type answers no union below (D2567).
  const ucx = nodeAt(unwrapParen(e.callFn))
  if ucx is FuncDecl || ucx is Call {
    if sigKeyRetKind(cloCallSigKey(exprIx, fnIx)) == "union" { return true }
  }
  // A PURE-litunion result (`pick(ks)` → `K`) reps as the i32 atom / string ref,
  // never the box — the checker-typed net must not claim it as a union value.
  if nodeTyIsPureLitUnion(exprIx) { return false }
  // A nullable NUMERIC-scalar result (`f32 | null` from a chained value call
  // `v(1)()`) is the value-union box (`repOfNullable`'s scalar arm) — the checker-typed
  // net's TyNullable case. The niche nullables (string/boolean/litunion/struct/closure/
  // list `| null`) are structurally excluded by the classifier.
  if nodeTyIsNulScalarBox(exprIx) { return true }
  // A union whose every member spells one list is that list, not a box (D4745).
  if oneListUnionRender(nodeTyAt(exprIx, fnIx)) != "" { return false }
  return nodeTyIsUnion(exprIx)
}

// True if a name read `e` is a union box: a union param, local, capture or global. False
// under a narrow that unboxes it to a scalar atom, a niche, a ref array or a map.
function exprUnionIdent(e: Ident, exprIx: i32, fnIx: i32): boolean {
  // A value-union ident narrowed to one scalar atom (`if u is i32 { … u … }`) reads
  // unboxed in this scope: the host's narrowing types it as the member, not the union.
  // A sub-union narrowing (2+ atoms) keeps the box.
  if identReadAtomKindAt(exprIx, fnIx) >= 0 { return false }
  // …and one narrowed to a niche-repped `A | null`, which the read converts (D2590).
  if nicheReadKindAt(exprIx, fnIx) >= 0 { return false }
  // A union binding narrowed to a ref-element array arm reads unboxed to the reflist
  // wrapper: in this scope it is a list, not a union value — the ref-array twin of the
  // scalar-atom rule above. Without it a rebind under the narrow classified as a union
  // box while the init emitted the unboxed wrapper ref — invalid wasm.
  if identReadContainerAt(exprIx, fnIx) > 0 { return false }
  // D1029 — and the map arm, the third member of the same rule: a map binding narrowed
  // this way reads unboxed to the map struct, but `exprUnion` keeps answering true for it,
  // so `emitUnionCoerce` hands the unboxed map to a destination typed at the union —
  // invalid wasm at six delivery positions.
  if paramUnion(fnIx, exprIx) { return true }
  if declaredUnion(exprIx) { return true }
  // A CAPTURED union box (`const a: C | D = …; () => … a is C …`): the env field is the union
  // box (kind 4). `capturedUnionName` resolves its member set from the parent binding so `is`
  // narrows; here we only need to know it IS a union value.
  if capturedKindOf(fnIx, e.identName) == "union" { return true }
  // A module GLOBAL union binding (a union annotation, or a union-returning
  // init): top-level `const a = make(42)` / `let w: string | i32 = "a"`.
  const gi = globalLetOfRead(fnIx, exprIx)
  if gi >= 0 { return letIsUnion(gi, -1) || globalCellKind(gi) == "union" }
  // While a capture's env field is typed off its initializer from the capturing frame, a
  // parent local with no loaded slot answers from its own declaration, so the field and the
  // parent's cell agree. Only there: elsewhere an unloaded ident may be flow-narrowed (D5332).
  if capInitAsk && declaredSlotOf(exprIx) < 0 {
    const ud = identDeclOf(exprIx)
    if ud >= 0 && nodeAt(ud) is LetDecl { return letIsUnion(ud, fnIx) }
  }
  return false
}

// True if an index read `e` yields the union box: a union-element ref list's cell or a
// union-valued map's value. False when the read unboxes a narrowed atom or container.
function exprUnionIndex(e: Index, exprIx: i32, fnIx: i32): boolean {
  if exprRefArray(e.idxArr, fnIx) {
    // GUARD the slot (same discipline as the struct-element arm — a narrowed
    // union-arm rebind receiver resolves no slot; OOB otherwise).
    const slot = refListSlotOfExpr(e.idxArr, fnIx)
    if slot < 0 || slot >= rlElemKindTbl.length { return false }
    // A cell narrowed to one scalar atom unboxes at the read (D451), exactly as the
    // Member arm below declines a narrowed field read — the union box is not the value in
    // this scope. A sub-union narrowing (kind 6 = `null`, or no atom kind at all) keeps the box.
    if idxNarrowAtomKind(exprIx, fnIx) >= 0 { return false }
    // The container arms of the same narrowing (D1014): the Ident arm declines a narrowed
    // ref-array or map for the same reason the atom rule above exists, since the read
    // unboxes. Without them an un-annotated rebind under the narrow took the union-box
    // cell while the init emitted the unboxed wrapper — invalid wasm.
    if placeReadContainerAt(exprIx, fnIx) > 0 { return false }
    return rlElemKindTbl[slot] == RLK_UNION
  }
  // A bare `m[k]` over a union-valued map yields the value union box — unless the cell is
  // narrowed to one scalar atom, which the read unboxes (D1025), exactly as the ref-list
  // arm above declines its narrowed cell. The two index receivers must answer alike, or the
  // binding claims a box the read does not deliver.
  const mri = mapReadMvSlot(exprIx, fnIx)
  if mri >= 0 {
    if mapReadNarrowedAtomKind(exprIx, fnIx) >= 0 { return false }
    // The container arms of the same narrowing, exactly as the ref-list arm above declines
    // them — the read delivers the map or list wrapper, not the box (D1866).
    if mapReadNarrowedContainer(exprIx, fnIx) { return false }
    return mvValKind[mri] == MVK_UNION
  }
  false
}

// True for `m[k] ?? d` in an instance whose map `m` is a hole read there as holding a nullable
// number, beside a default that is `null` or that same nullable number: the result is that
// number's box and the read is its arm.
export function coalHoleNulNumRead(e: BinExpr, fnIx: i32): boolean {
  coalHoleNulNumTy(e, fnIx) >= 0
}

// The nullable number `coalHoleNulNumRead` keeps, the instance's map value type, or -1.
export function coalHoleNulNumTy(e: BinExpr, fnIx: i32): i32 {
  const lhsIx = unwrapParen(e.binLeft)
  if lhsIx < 0 || !exprReReadable(lhsIx) { return -1 }
  const rd = nodeAt(lhsIx)
  if !(rd is Index) { return -1 }
  const own = nodeTyIxOf(unwrapParen(rd.idxArr))
  if own < 0 || own >= T.tys.length || !(tyAt(own) is TyVar) { return -1 }
  const mt = mapRecvTyIn(rd.idxArr, fnIx)
  if mt < 0 { return -1 }
  const vt = tyMapValOf(mt)
  if (
    !(tyIsNulPrim(vt, "i32")
      || tyIsNulPrim(vt, "i64")
      || tyIsNulPrim(vt, "f64")
      || tyIsNulPrim(vt, "f32"))
  ) {
    return -1
  }
  const dix = unwrapParen(e.binRight)
  if dix < 0 { return -1 }
  const d = nodeAt(dix)
  if d is NullLit { return vt }
  let dt = holeOperandTyOf(dix, fnIx)
  if d is BinExpr {
    // An inner link that is no such read may drop the null, so only its own answer counts.
    if d.binOp == "??" {
      const it = coalHoleNulNumTy(d, fnIx)
      if it < 0 || !tySame(it, vt) { return -1 }
      return vt
    }
  }
  // A map read is its value or `null`, so a plain number map's read is that nullable number.
  if dt < 0 && d is Index {
    const dm = mapRecvTyIn(d.idxArr, fnIx)
    if dm >= 0 { dt = mapPinReadTy(dm) }
  }
  if dt < 0 { dt = nodeTyIxOf(dix) }
  if dt < 0 || !tySame(dt, vt) { return -1 }
  vt
}

// True if a binary `e` (other than an operator over a numeric union) yields the union box:
// a `??` over a union-valued map or a nullable box, or an assignment whose target is one.
function exprUnionBin(e: BinExpr, exprIx: i32, fnIx: i32): boolean {
  // A hole's map read of a nullable number beside a nullable default stays that number's box.
  if e.binOp == "??" && coalHoleNulNumRead(e, fnIx) { return true }
  const cmu = coalesceMvSlot(exprIx, fnIx)
  if cmu >= 0 {
    if mvValKind[cmu] == MVK_UNION && !mvUnionIsScalarNull(cmu) { return true }
    // A nullable default keeps a scalar read `S | null`, which is the box (D2253).
    return coalesceKeepsScalarBox(exprIx, cmu, fnIx)
  }
  // A non-map `p ?? q` over a nullable value-union box keeps the box when the default is
  // itself nullable, since the result is still `T | null`, with no unboxed rep. Without it
  // an un-annotated binding inferred the residual scalar cell and its `!= null` found no
  // nullable rep to test. Delegated to the name-typed mirror so the two cannot disagree.
  if e.binOp == "??" {
    // Over a `null`-typed LHS the value is the default, at the default's rep (D4550).
    const cnnU = coalesceNulNoneDefaultIx(exprIx, fnIx)
    if cnnU >= 0 { return exprUnion(cnnU, fnIx) }
    if unionNameOfExpr(exprIx, fnIx) != "" { return true }
    // A niche joined to a default of another type is the box the lowering builds (D2373).
    if coalesceNicheJoinsToBox(exprIx, fnIx) { return true }
  }
  // D1589 — an assignment's value is the node `asgReadNode` names, since the value this node
  // leaves on the stack is `emitExpr` of it. Without it a tail assignment over a nullable box
  // cell struct.new'd the box as a scalar payload — invalid wasm.
  if e.binOp == "=" && asgLitWidth(exprIx, fnIx) == "" {
    return exprUnion(asgReadNode(exprIx, fnIx), fnIx)
  }
  false
}

// True if the if-expression at `exprIx` yields the union box: its join is a union neither
// arm is, or its then arm is a union. False for a numeric literal union join, or a join
// that is a bare primitive or a list.
function exprUnionIf(exprIx: i32, fnIx: i32): boolean {
  // …unless the join is a numeric literal union, whose rep is the `i32` and never the box (D2531).
  if nodeTyIsNumLitUnion(exprIx, fnIx) { return false }
  // …unless the JOIN is a union neither arm is: `if c { "green" } else { 7 }` joins to
  // `string | i32` and neither arm is a union, so the then arm answers false for a node
  // whose own type is a box. Asked of the node's recorded type, which is the join (D1733).
  if coalesceResultUnionName(exprIx) != "" { return true }
  // …and never when the join is a bare primitive or a list: an arm narrowed by the `if`'s own
  // condition (`if x is i32 { x }`, `if v is string[] { v }`) keeps its declared union here,
  // where no narrow is active, while `emitIfExpr` lowers the join as the member (D2264). Not
  // in a generic body, whose narrowed list arm is typed at the parameter and lowers as the box.
  const iuTv = ifThenValueIx(exprIx)
  let ijp = nodeTyPinIxOf(exprIx)
  // Inside an instance a join over its type parameters is read at the pin, where it can be
  // the one primitive both bind (D3528).
  if ijp >= 0 && tyHasTyVar(ijp) {
    const ijs = pinSubOperandTyOf(ijp, fnIx)
    // A join the pin makes a box (`V | null` at `i32`) is one, whatever its arms read as (D10231).
    if valueUnionNameOfTy(ijs) != "" { return true }
    if ijs >= 0 { ijp = ijs }
  }
  if ijp >= 0 && ijp < T.tys.length {
    const ijt = tyAt(ijp)
    if ijt is TyPrim { return false }
    if ijt is TyArray && iuTv >= 0 {
      const tvt = nodeTyAt(iuTv, fnIx)
      if tvt >= 0 && tvt < T.tys.length && !tyHasTyVar(tvt) { return false }
    }
  }
  if iuTv >= 0 { return exprUnion(iuTv, fnIx) }
  return false
}

// True if the `LetDecl` at `letIx` declares a union-typed local: its annotation names
// the union, or its initializer produces the union. An object-literal init under a union
// annotation is boxed as the union (`emitStmt`).
export function letIsUnion(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    // The annotation half (`letAnnIsUnion`) — a literal union (`type K = "a" | "b"`, or an
    // inline `"a" | "b"`) is an interned-i32 ATOM, not a value-union box, and it declines.
    if letAnnIsUnion(letIx) { return true }
    // The init's union-ness applies only when no annotation pinned the cell: an explicit
    // non-union annotation unboxes the narrowed atom into the concrete type instead of boxing.
    if d.letType < 0 {
      if (exprUnion(d.letInit, fnIx) && !exprIsLitAtom(d.letInit, fnIx)) {
        return true
      }
      // A walk variable read at a type that is itself the box, asked outside the frame (D3139).
      const li = unwrapParen(d.letInit)
      if li >= 0 && nodeAt(li) is Ident && nodeTyIsUnionShaped(li, fnIx) {
        if nodeTyIsBoxRep(li, fnIx) {
          if letInitLoopElemKind(letIx, fnIx) == "union" { return true }
          // …and a copy of a copy, whose source's box only the frame's locals record.
          if letInitCopiesBox(letIx, fnIx, 8) { return true }
        }
      }
    }
    // A null-hole binding (`let x = null`, A-infer-null) is its inferred union.
    return nliNameOf(letIx) != ""
  }
  false
}

// ── value-union name resolution (the union a value flows as) ──────────────────

// The registered union name the read `atIx` in function `fnIx` carries — from its param
// annotation, `let` annotation, an inferred union-returning init, or a module global — or ""
// when not union-typed. `atIx` picks among sibling blocks binding one name (`parentLetOfAt`,
// D2316) and lets a block shadow of a same-named PARAMETER win (`fnBlockShadowsAt`, D2325).
export function unionNameOfRead(atIx: i32, fnIx: i32) {
  const sid = sidOfNode(atIx)
  const name = sidText(sid)
  if fnIx >= 0 {
    const fn = nodeAt(fnIx)
    if fn is FuncDecl {
      // Reads `body` before the `Param` narrowing below can rebind it.
      const body = fn.fnBody
      const params = fn.fnParams
      // The cheap scan first: `fnBlockShadowsAt` walks a duplicate-name chain as long as the
      // function has same-named LetDecls, so it is asked only once a param of `sid` is
      // actually found — never on every read of every OTHER local in the function (D2326).
      let pIx = -1
      let i = 0
      while i < params.length {
        // `sidOfNode(params[i])` is `sidOf(p.parName)` off a side table, so the scan compares
        // interned ids rather than strings, and only the slot that matches pays the arena read
        // and the `Param` narrowing below.
        if sidOfNode(params[i]) == sid {
          pIx = params[i]
          break
        }
        i = i + 1
      }
      if pIx >= 0 && !fnBlockShadowsAt(fnIx, sid, atIx) {
        const p = nodeAt(pIx)
        if p is Param {
          // The registry-membership test via the canon-keyed index instead of a spelling's
          // linear scan over `unNames`: same question, same name returned, on interned ids.
          // The spelling renders only once the row exists, since a non-union param drops it.
          if unRowOfCanon(annRowOfNode(p.parType)) >= 0 {
            return tyNameOf(p.parType)
          }
          return ""
        }
      }
      const li = bodyLetReadAtSid(body, sid, atIx)
      if li >= 0 { return letUnionNameOf(li, fnIx) }
      // A `for <name> in <(C|S)[]>` loop variable is a kind-4 union box with no `LetDecl` of
      // its own, so its member set comes from the iterable's union-box element type instead.
      const flv = forInLoopVarUnionName(atIx, fnIx)
      if flv != "" { return flv }
      const rlf = readLoopUnionName(atIx, fnIx)
      if rlf != "" { return rlf }
    }
  }
  // A top-level `for` loop runs in the start function, which has no `FuncDecl` body, so its
  // union-box loop var needs this same `forInLoopVarUnionName` rung to avoid an unboxed read.
  if fnIx < 0 {
    const slv = forInLoopVarUnionName(atIx, -1)
    if slv != "" { return slv }
    const rlm = readLoopUnionName(atIx, -1)
    if rlm != "" { return rlm }
  }
  // A captured union box resolves its member set from the parent frame's binding — a
  // DIFFERENT function's coordinate space, so `atIx` (this frame's) is not passed through.
  const cun = capturedUnionName(fnIx, name)
  if cun != "" { return cun }
  const gi = globalLetOfRead(fnIx, atIx)
  if gi >= 0 { return letUnionNameOf(gi, -1) }
  // A module block's binding: the read's own declaration, when no frame declares it (D2252).
  const bl = identDeclOf(atIx)
  if bl >= 0 && nodeAt(bl) is LetDecl && readDeclOwnerOf(bl, fnIx) < 0 {
    return letUnionNameOf(bl, -1)
  }
  ""
}

// The one home for "which value union does a `for <name> in <iter>` loop variable flow
// as", from the iterable's union-box element type (there is no declaration node to read).
// Keyed by the slot the read at `atIx` resolves to, never the name — two `for` loops in one
// frame can share a loop-var name while binding different unions.
function forInLoopVarUnionName(atIx: i32, fnIx: i32) {
  if declaredKind(atIx) != "union" { return "" }
  const slot = declaredSlotOf(atIx)
  if slot < 0 || slot >= localLoopIter.length { return "" }
  if slot < localPairIter.length && localPairIter[slot] >= 0 {
    return forInPairUnionElemName(localPairIter[slot], fnIx)
  }
  forInIterUnionElemName(localLoopIter[slot], fnIx)
}

// The union NAME a `for k, v in m` walk's value carries, or "": the element of the vals list
// `forInPairValsSlot` names, which is the list `m.values()` walks.
function forInPairUnionElemName(iterIx: i32, fnIx: i32) {
  const vsl = forInPairValsSlot(iterIx, fnIx)
  if vsl < 0 || vsl >= mvRlSlot.length { return "" }
  const slot = mvRlSlot[vsl]
  if slot < 0 || slot >= rlElemKindTbl.length { return "" }
  if rlElemKindTbl[slot] != RLK_UNION { return "" }
  rlElemName[slot]
}

// The member set of the walk variable read at `atIx` in frame `fnIx`, found by the
// loop enclosing the read: the answer a classifier typing a capture needs while no slot of the
// walking frame is live, which `forInLoopVarUnionName` reads (D2523).
function readLoopUnionName(atIx: i32, fnIx: i32): string {
  if atIx < 0 { return "" }
  const lp = readLoopNodeOf(atIx, fnIx)
  if lp < 0 { return "" }
  const ln = nodeAt(lp)
  if ln is ForIn {
    return forInIterUnionElemName(frameBlindIter(ln.fiIter, fnIx), fnIx)
  }
  ""
}

// The union NAME an ITERABLE's element carries, or "". A union-box ref array (`(C | S)[]`,
// and the vals list of a box-VALUED map, which `exprRefArray` claims too) answers its
// element's registered member set; every other iterable answers "".
function forInIterUnionElemName(iterIx: i32, fnIx: i32) {
  if iterIx < 0 { return "" }
  if !exprRefArray(iterIx, fnIx) { return "" }
  const slot = refListSlotOfExpr(iterIx, fnIx)
  if slot < 0 || slot >= rlElemKindTbl.length { return "" }
  if rlElemKindTbl[slot] != RLK_UNION { return "" }
  rlElemName[slot]
}

// The union name of a `LetDecl`: its annotation when that names a union, else the
// union its (un-annotated) initializer produces (`const r = pick(true)`).
export function letUnionNameOf(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    // Membership decided via `unRowOfCanon` (canon-keyed), the name still rendered via
    // `tyNameOf` — the same split `unionNameOfIdentSid`'s param arm uses, and rendered on the
    // same side of the test, since an annotation naming no union row discards the spelling.
    if unRowOfCanon(annRowOfNode(d.letType)) >= 0 { return tyNameOf(d.letType) }
    if d.letType < 0 {
      const inf = unionNameOfExpr(d.letInit, fnIx)
      if inf != "" {
        // A narrowed read bound at its niche or arm cell is no box, whatever it reads (D3133).
        if nodeTyIsNarrowedShape(unwrapParen(d.letInit), fnIx) {
          if letInitBindsNarrowedCell(letIx, fnIx) { return "" }
        }
        // A read narrowed to a smaller box binds that box, as its annotation would (D5921).
        const nrw = narrowedBoxRenderOf(
          d.letInit,
          inf,
          unionDeclTyIxOfIdentRead(d.letInit, fnIx),
          fnIx,
        )
        if nrw != "" { return nrw }
        return inf
      }
      // A null-hole binding (`let x = null` filled by a later `x = e`) carries
      // its inferred `T|null` value union (A-infer-null).
      const nli = nliNameOf(letIx)
      if nli != "" { return nli }
      return letNulScalarBoxName(letIx, fnIx)
    }
  }
  ""
}

// The row an un-annotated binding's `T | null` box cell names off its member's rep, so an init
// that is the bare scalar (a map read's hit or miss) boxes into it; "" for any other binding.
export function letNulScalarBoxName(letIx: i32, fnIx: i32): string {
  const d = nodeAt(letIx)
  if !(d is LetDecl) || d.letType >= 0 { return "" }
  // Only a binding checked at `T | null`, or open in a type variable an instance binds, holds one.
  const own = nodeTyIxOf(letIx)
  if (
    own >= 0
    && own < T.tys.length
    && !(tyAt(own) is TyNullable)
    && !tyHasTyVar(own)
  ) {
    return ""
  }
  const ty = letBindTy(letIx, fnIx)
  const name = nulNumScalarUnionName(ty)
  if name == "" || repOfTy(ty).rdKind != "union" { return "" }
  name
}

// The value union a name, or a narrowed field or element read, at `ix` is narrowed to, when it
// has fewer variants than the registered union `whole` (the one its binding holds), else "".
// Box tags are per atom, so the narrowed box is the same value under fewer members.
function narrowedBoxRenderOf(
  ix: i32,
  whole: string,
  wholeTy: i32,
  fnIx: i32,
): string {
  const rx = unwrapParen(ix)
  if rx < 0 { return "" }
  if !(nodeAt(rx) is Ident) && !placeReadIsNarrowed(rx, fnIx) { return "" }
  const nt = nodeTyAt(rx, fnIx)
  const nrw = valueUnionNameOfTy(nt)
  if nrw == "" { return "" }
  const u = unionRowKeyAB(90, whole, wholeTy)
  if u < 0 || u >= unTyIx.length || unTyIx[u] < 0 { return "" }
  if flatVariantCount(nt) >= flatVariantCount(unTyIx[u]) { return "" }
  nrw
}

// Whether `ix` is a field or element read the checker typed at fewer members than the place
// declares. A record built at a wider destination's row reads its own type there, which is
// no narrowing (D3403), so the place's own declaration is what a read is compared with.
export function placeReadIsNarrowed(ix: i32, fnIx: i32): boolean {
  if ix < 0 { return false }
  const n = nodeAt(ix)
  let dt = -1
  match n {
    Member => {
      dt = tyFieldTyOf(nodeTyAt(n.memObj, fnIx), n.memProp)
    }
    Index => {
      const bt = nodeTyAt(n.idxArr, fnIx)
      if bt >= 0 {
        const b = tyAt(bt)
        if b is TyArray { dt = b.aElem }
      }
    }
    // No other read names a place with a declaration of its own.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  if dt < 0 { return false }
  flatVariantCount(nodeTyAt(ix, fnIx)) < flatVariantCount(dt)
}

// How many variants type `ty` flattens to, `null` counted as one.
function flatVariantCount(ty: i32): i32 {
  const vs: i32[] = []
  flattenVariantsInto(ty, vs)
  vs.length
}

// Whether call `callIx` goes through a function value: its callee names no lifted function.
function callIsValueCall(callIx: i32): boolean {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return false }
    const callee = nodeAt(c.callFn)
    if callee is Ident { return fnIndexOfNode(c.callFn) < 0 }
    return true
  }
  false
}

// Is the operand of a `??` one of the nullable-REF niches — a bare `(ref null $H)` cell rather
// than a box or an i32 sentinel? These are the reps `emitCoalesceNulRefCtx` serves.
export function coalesceNulRefNicheOperand(ix: i32, fnIx: i32): boolean {
  if exprNullableString(ix, fnIx) { return true }
  if exprNullableRefNiche(ix, fnIx) { return true }
  if exprNullableList(ix, fnIx) { return true }
  if exprNullableRefArray(ix, fnIx) { return true }
  exprNulScalarListKind(ix, fnIx) != null
}

// Does the `??` at `ix` join a nullable-ref niche, or the `boolean | null` i32 niche, to a
// default of another type, so the result is the union BOX rather than the niche's own rep?
// Two or more non-null members is what makes the result a box; one is the niche itself (D2383).
export function coalesceNicheJoinsToBox(ix: i32, fnIx: i32): boolean {
  if !coalesceResultIsBox(ix) { return false }
  const e = nodeAt(ix)
  if e is BinExpr {
    const l = coalesceChainLeftmost(e.binLeft)
    return coalesceNulRefNicheOperand(l, fnIx) || exprNulBool(l, fnIx)
  }
  false
}

// Whether `ty` is a union of literals only (`"a" | "b"`, `1 | 2`): one atom, not a box.
function asResultIsOneAtom(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  if t is TyUnion {
    if t.uMembers.length == 0 { return false }
    for m in t.uMembers {
      if m < 0 || !(tyAt(m) is TyLit) { return false }
    }
    return true
  }
  false
}

// The union NAME the expression at `exprIx` produces (the name-typed mirror of the
// boolean `exprUnion`): a union-returning call's return annotation, a union-typed
// ident, a parenthesized union. "" when the expression is not union-valued.
export function unionNameOfExpr(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return "" }
  const e = nodeAt(unwrapParen(exprIx))
  // `x as? T`'s box (`i32 | null`, `Shape | null`) needs the union name so a narrow/unbox
  // consumer sees a box, not a raw ref — rendered the same way an equivalent annotation would be.
  match e {
    AsExpr => {
      const aty = nodeTyIxOf(unwrapParen(exprIx))
      const avn = valueUnionNameOfTy(aty)
      if avn != "" { return avn }
      if asResultIsOneAtom(aty) { return "" }
      const ar = unRowOfKeyOrMembers(aty)
      if ar >= 0 && ar < unNames.length { return unNames[ar] }
      return ""
    }
    // An if-expression names its union from its own recorded type, like the `AsExpr` arm: only
    // a desugared `??` (`nodeTyCarry`) puts a type on an `if` — a source-written one has none. D969.
    IfStmt => {
      return ifJoinUnionNameIn(unwrapParen(exprIx), fnIx)
    }
    // Every other expression is resolved by the rungs below.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  match e {
    BinExpr => {
      // An operator over a numeric union names the union of its member results.
      if numUnionMinted {
        const nuTy = opNumUnionTyIn(exprIx, fnIx, e.binLeft, e.binRight)
        if (nuTy >= 0 && !(e.binOp == "=" || e.binOp == "??")) {
          const nun = valueUnionNameOfTy(nuTy)
          if nun != "" { return nun }
        }
      }
      // A `??`'s desugared call-operand form still needs a name here: it drives the default's
      // coercion and makes `exprUnion` true, so a consumer boxes the result exactly once. D960.
      if e.binOp == "??" {
        // Through the banked pin, so the un-annotated face names the same union the annotated
        // one does: inside a hole-parameter body the `??` result is a deferred hole, and the
        // consumers that ask this (`exprUnion`, the print ladder) would otherwise classify the
        // box the lowering just built as a scalar (D1702).
        const ccn = valueUnionNameOfTy(
          coalResultTyOf(unwrapParen(exprIx), fnIx),
        )
        if ccn != "" { return ccn }
        // A MIXED result renders structurally, so the name comes off the canon index — the same
        // fallback the lowering takes. The two must agree or the destination boxes a value the
        // `??` already boxed, and the arm test then casts a box to the arm's struct (D1703). A
        // miss falls THROUGH to the map and `?.` arms below, which own their own `??` shapes.
        const cmn = nodeMixedUnionName(exprIx)
        if cmn != "" { return cmn }
        // An ALL-variant join (`A | B`) is the box too, and `nodeMixedUnionName` excludes it by
        // design. The desugared face falls through to a wider producer, so the fused face needs
        // the same rung or the box arm declines and the consumer's cell is not the box (D1764).
        const cvn = nodeVariantUnionName(exprIx)
        if cvn != "" { return cvn }
        // A scalar joined to a literal union is the box the lowering builds (`nodeJoinRowName`).
        const cjn = nodeJoinRowName(exprIx, fnIx)
        if cjn != "" { return cjn }
      }
      // `m[k] ?? d` over a UNION-valued map yields the value union's box — resolve its name (the
      // mv slot's value name) so an un-annotated `const v = m[k] ?? d` narrows/unboxes.
      const cmu = coalesceMvSlot(unwrapParen(exprIx), fnIx)
      if cmu >= 0 {
        // `scalar | null` peels to a raw scalar (not a union), so it has no union name here.
        if mvValKind[cmu] == MVK_UNION && !mvUnionIsScalarNull(cmu) {
          return mvValName[cmu]
        }
      }
      // The name-typed mirror of `exprUnion`'s non-map `??` arm: needs the resulting member set
      // to narrow/unbox through, only when both operands share the same set (or default is `null`).
      if e.binOp == "??" {
        // A niche JOIN's result is the union BOX, and the destination has to be told: a local
        // slot typed from the operand's own niche holds a bare ref where the box lands, which
        // is check-clean invalid wasm at every in-function position (D1714).
        if coalesceNicheJoinsToBox(unwrapParen(exprIx), fnIx) {
          return coalesceResultUnionName(unwrapParen(exprIx))
        }
        const cln = unionNameOfExpr(e.binLeft, fnIx)
        if cln != "" && coalesceDefaultNullable(e.binRight, fnIx) {
          const crn = unionNameOfExpr(e.binRight, fnIx)
          // A hole's map read default names no set, so it keeps `cln` only by naming it.
          if crn == cln { return cln }
          if crn == "" && !coalDefaultEndsInHoleMapRead(e.binRight, fnIx) {
            return cln
          }
        }
        // A `?.` LHS over a value-union LEAF stays a BOX past the `??` even with a NON-null
        // default: peeling `null` off `i32 | string | null` leaves TWO atoms, which have no
        // shared unboxed rep. The result set is the checker's type for the `??` NODE — the
        // union minus `null` — rendered rather than assembled, as the `?.` arm above. D803.
        const olh = nodeAt(unwrapParen(e.binLeft))
        if olh is OptMember {
          if optChainLeafFieldCode(e.binLeft, fnIx) == FC_UNION {
            return nodeUnionName(unwrapParen(exprIx))
          }
        }
      }
    }
    Unary => {
      // An operator over a numeric union names the union of its member results.
      if numUnionMinted {
        const nuTy = opNumUnionTyIn(exprIx, fnIx, e.unArg, -1)
        if nuTy >= 0 {
          const nun = valueUnionNameOfTy(nuTy)
          if nun != "" { return nun }
        }
      }
    }
    Call => {
      return unionNameOfCall(e, exprIx, fnIx)
    }
    Ident => {
      // The ident arm declines the same three narrows `exprUnion`'s ident arm does (scalar atom,
      // ref array, map): a rebind under a narrow must not still be named a union here. D1252.
      if identReadAtomKindAt(exprIx, fnIx) >= 0 { return "" }
      if nicheReadKindAt(unwrapParen(exprIx), fnIx) >= 0 { return "" }
      if identReadContainerAt(exprIx, fnIx) > 0 { return "" }
      // The sid-taking twin, off the node's own column: `sidOfNode` of this Ident is `sidOf` of
      // its name by that column's contract, so the id is read rather than the spelling re-interned.
      return unionNameOfRead(unwrapParen(exprIx), fnIx)
    }
    OptMember => {
      // A `?.` whose leaf is a value-union field (code 16): the checker's own type for the node
      // is exactly the union plus `null`, so it is rendered rather than assembled here. D803.
      if optChainLeafFieldCode(exprIx, fnIx) == FC_UNION {
        return nodeUnionName(unwrapParen(exprIx))
      }
      // A scalar leaf's `T | null` box, the row the collection walk registers for it (D3513),
      // at the instance's type when a hole receiver is pinned (D3215).
      return nulNumScalarUnionName(nodeTyAt(unwrapParen(exprIx), fnIx))
    }
    Member => {
      // The name-typed half of `exprUnion`'s niche decline for a field or cell (D2590).
      const nrx = unwrapParen(exprIx)
      if nicheReadKindAt(nrx, fnIx) >= 0 { return "" }
      // The name-typed mirror of `exprUnion`'s Member case: a code-16 field read carries
      // the field's union name (its atom set), unless narrowed to one scalar (unboxed).
      const mix = unwrapParen(exprIx)
      if memNarrowAtomKind(mix, fnIx) >= 0 { return "" }
      // Must decline the same read `exprUnion`'s Member case does: a read the read site already
      // unboxes is a string ref, not a union box, whatever this field's declared type says. D311.
      if memReadUnboxAtomKind(mix, fnIx) >= 0 { return "" }
      return memberUnionFieldNameRead(mix, fnIx)
    }
    Index => {
      // The name-typed half of `exprUnion`'s niche decline for a field or cell (D2590).
      const nrx = unwrapParen(exprIx)
      if nicheReadKindAt(nrx, fnIx) >= 0 { return "" }
      // `ns[i]` over a UNION-element ref list yields the element union's box (the
      // name-typed mirror of `exprUnion`'s Index case) — so an un-annotated
      // `const a = arr[0]` binding resolves its union name for narrowing/unboxing.
      return unionNameOfIndex(e, exprIx, fnIx)
    }
    // No other expression names a union.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  ""
}

// The union name a call `e` returns: a list `pop`/`get` box, a named, closure, param or
// field callee's annotated or inferred return, a boxed `$fnsig` result, then the
// checker's recorded type. "" when the result is not a union.
function unionNameOfCall(e: Call, exprIx: i32, fnIx: i32): string {
  if e.callFn < 0 { return "" }
  const callee = nodeAt(e.callFn)
  // `xs.pop()` / `xs.get(i)` over a value-union ref list: the read's `T | null` IS the
  // box, `null` riding as its tag, so the element's union name is what makes a narrowed
  // read unbox rather than hand its consumer the raw box ref (D1825).
  if callee is Member {
    const pus = popRefRecvSlot(exprIx, fnIx)
    if pus >= 0 && pus < rlElemName.length && popUnionBoxElem(pus) {
      return rlElemName[pus]
    }
  }
  if callee is Ident {
    const t = fnIndexOfNode(e.callFn)
    if t >= 0 {
      const fn = nodeAt(fnStmts[t])
      if fn is FuncDecl {
        const rn = tyNameOf(fn.fnRet)
        if unRowOfCanon(annRowOfNode(fn.fnRet)) >= 0 { return rn }
        // An un-annotated function whose returns join to a value union: without its inferred
        // name, a binding stays the raw box and a narrowed read mis-types (arrayref vs scalar).
        if fn.fnRet < 0 {
          const irk = inferRetFnKey(fnStmts[t], callee.identName)
          const im = inferRetNameOf(irk)
          // A value union or a registered struct union (a union row, from this same inferred
          // name in `collectU`) — either drives narrowing/unboxing as an annotation would.
          if isValueUnionName(im) { return im }
          if im != "" && isUNameAB(18, im, inferRetTyIxOf(irk)) { return im }
        }
      }
    }
    // A union-returning function-value callee (`const f = g; const r = f(7)`): without
    // resolving through the lifted function, a closure-call union stays the raw box.
    const cfe = identClosureFeOfRead(e.callFn, fnIx)
    if cfe >= 0 {
      const cfn = nodeAt(fnStmts[cfe])
      if cfn is FuncDecl {
        const crn = tyNameOf(cfn.fnRet)
        if unRowOfCanon(annRowOfNode(cfn.fnRet)) >= 0 { return crn }
        // A value-union annotated return (`i32 | string`, pinned by `synthRetAnnots`) needs this:
        // The struct-union row test covers struct unions only, so this narrowed result would not unbox otherwise. B290.
        if isValueUnionTyOr(annRowOfNode(cfn.fnRet)) == 1 { return crn }
        if cfn.fnRet < 0 {
          const cirk = inferRetFnKey(fnStmts[cfe], cfn.fnName)
          const cim = inferRetNameOf(cirk)
          if isValueUnionName(cim) { return cim }
          if cim != "" && isUNameAB(19, cim, inferRetTyIxOf(cirk)) {
            return cim
          }
        }
      }
    }
    // A union-returning closure param callee (`callIt(g: (i32) => A | B, x)`): resolve via
    // the param's function-type annotation, so the HOF body's narrowed result unboxes too.
    const pun = paramUnionRetName(fnIx, callee.identName)
    if pun != "" { return pun }
    // A closure binding with an inferred function type (`const g = mk()`): recover it from
    // `identFnTypeAnnNameOfRead`, since `identClosureFeOfRead` can't see through the call result.
    const bun = unionRetOfFnType(identFnTypeAnnNameOfRead(e.callFn, fnIx))
    if bun != "" { return bun }
    // A callee narrowed to a union's closure arm: the binding's own annotation channel
    // misses (the type lives on the arm), so resolve the return from the active narrow instead.
    const nft = narrowedFnTyOf(e.callFn, fnIx)
    if nft >= 0 {
      const nun = unionRetOfFnType(tyToStructStr(nft))
      if nun != "" { return nun }
    }
  }
  // A union-returning field-closure callee (`o.run(7)` over a `(…) => A | B` field): resolve
  // via the lifted function `fieldClosureFeOfRecv` finds, mirroring the plain-binding case.
  if callee is Member {
    const mfe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
    if mfe >= 0 {
      const mfn = nodeAt(fnStmts[mfe])
      if mfn is FuncDecl {
        const mrn = tyNameOf(mfn.fnRet)
        if unRowOfCanon(annRowOfNode(mfn.fnRet)) >= 0 { return mrn }
        if mfn.fnRet < 0 {
          const mirk = inferRetFnKey(fnStmts[mfe], mfn.fnName)
          const mim = inferRetNameOf(mirk)
          if isValueUnionName(mim) { return mim }
          if mim != "" && isUNameAB(20, mim, inferRetTyIxOf(mirk)) {
            return mim
          }
        }
      }
    }
  }
  // A value call the callee's `$fnsig` keys with a boxed result is that union, named from the
  // call's type (D2535).
  if (
    tyBearsNull(nodeTyAt(unwrapParen(exprIx), fnIx))
    && callIsValueCall(unwrapParen(exprIx))
  ) {
    const cuk = cloCallSigKey(unwrapParen(exprIx), fnIx)
    if cuk != "" && sigKeyRetKind(cuk) == "union" {
      const kun = callUnionNameOfTy(nodeTyIxOf(unwrapParen(exprIx)))
      if kun != "" { return kun }
    }
  }
  // An instance's call through a hole parameter names no annotation, and its pinned result
  // is the nullable value-union box the bound function returns (D9700).
  if (
    fnInPinnedInstance(fnIx)
    && tyIsNulValueUnionBox(nodeTyAt(unwrapParen(exprIx), fnIx))
  ) {
    const iun = valueUnionNameOfTy(nodeTyIxOf(unwrapParen(exprIx)))
    if iun != "" { return iun }
  }
  // Fallback scoped to a call (an if-expr has its own union path): renders from the checker's
  // per-node type when the callee has no static name to key on (`arr[i](x)`).
  const crun = nodeUnionName(exprIx)
  if crun != "" { return crun }
  // A type parameter bound to a union stays nested in the result (`T | string` at `f64 | i32`),
  // which no render above flattens; the box is the row holding its flattened members (D10522).
  const nfr = nestedUnionRowName(nodeTyAt(unwrapParen(exprIx), fnIx))
  if nfr != "" { return nfr }
  // `nodeUnionName` gates itself to a value union first, so a call returning a declared
  // struct union (an inferred hole-param return with no annotation) named nothing here either. D1561.
  return nodeRegisteredUnionName(exprIx)
}

// The union name a value call of result type `ty` boxes as: a literal-union alias, bare or
// nullable, else its value-union spelling, else the name of the row its key holds; "" for none.
function callUnionNameOfTy(ty: i32): string {
  if ty < 0 { return "" }
  const t = tyAt(ty)
  if t is TyNullable {
    const nal = litUnionAliasNameOfTy(t.nInner)
    if nal != "" { return unionRetName(nal + "|null") }
  }
  const bal = litUnionAliasNameOfTy(ty)
  if bal != "" { return unionRetName(bal) }
  const vn = valueUnionNameOfTy(ty)
  if vn != "" { return vn }
  const r = unRowOfKey(ty)
  if r >= 0 { return unNames[r] }
  ""
}

// The registered name of the box a union `ty` with a union member reads through, or "" when
// `ty` has no such member or no row holds its flattened members.
function nestedUnionRowName(ty: i32): string {
  if ty < 0 { return "" }
  const t = tyAt(ty)
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if tyAt(t.uMembers[i]) is TyUnion {
        const row = unRowOfFlatMembers(ty)
        if row < 0 { return "" }
        return unNames[row]
      }
      i = i + 1
    }
  }
  ""
}

// The union name an index read `e` yields: a union-element ref list's element union, a
// closure arm's element union, or a union-valued map's value union. "" when the cell is
// narrowed to one scalar atom or is not a union.
function unionNameOfIndex(e: Index, exprIx: i32, fnIx: i32): string {
  if exprRefArray(e.idxArr, fnIx) {
    const slot = refListSlotOfExpr(e.idxArr, fnIx)
    if slot >= 0 && slot < rlElemKindTbl.length {
      if rlElemKindTbl[slot] == RLK_UNION {
        // The name-typed half of `exprUnion`'s D451 decline: a cell narrowed to one
        // scalar atom is unboxed by the read, so it carries no union name either. The two
        // must answer together — `exprUnion` false with a name still resolving is exactly
        // the split D311 records one classifier over.
        if idxNarrowAtomKind(exprIx, fnIx) >= 0 { return "" }
        return rlElemName[slot]
      }
    }
  }
  // A union binding's ref-array arm with a closure member: narrowing-blind, `exprRefArray(t0)`
  // is false, so recover the element union directly from the arm instead.
  const ax = nodeAt(unwrapParen(e.idxArr))
  if ax is Ident {
    const aun = unionNameOfRead(unwrapParen(e.idxArr), fnIx)
    if aun != "" {
      const cel = unionClosureArrElemUnion(aun)
      if cel != "" { return cel }
    }
  }
  // A bare `m[k]` over a UNION-valued map (the value union's box). The name-typed half of
  // `exprUnion`'s D1025 decline: a cell narrowed to one scalar atom is unboxed by the read,
  // so it carries no union name either — the two must answer together.
  const mri = mapReadMvSlot(unwrapParen(exprIx), fnIx)
  if mri >= 0 {
    if mvValKind[mri] == MVK_UNION {
      if mapReadNarrowedAtomKind(unwrapParen(exprIx), fnIx) >= 0 { return "" }
      if mapReadNarrowedContainer(unwrapParen(exprIx), fnIx) { return "" }
      return mvValName[mri]
    }
  }
  ""
}

// The niche kind the read `ix` converts its box to: 1 for `boolean | null`, 2 for `string | null`,
// when the checker narrowed it to exactly that niche out of a wider storage type (D2590), else -1.
// A read of the storage itself (`storageReadEnter`) converts nothing.
export function nicheReadKindAt(ix: i32, fnIx: i32): i32 {
  if isStorageRead(ix) { return -1 }
  if readNarrowedStoreAt(ix, fnIx) < 0 { return -1 }
  if nodeTyIsNulBool(ix) { return 1 }
  if nodeRepIs(ix, "nulstr", fnIx) { return 2 }
  -1
}

// The niche kind a field or cell read at `exprIx` converts to: the read is narrowed to a niche
// `A | null` and the field or cell, read at its storage, is the union box. -1 otherwise.
export function placeNicheAtomKind(exprIx: i32, fnIx: i32): i32 {
  if placeNarrowKeyOf(exprIx) == "" { return -1 }
  const r = unwrapParen(exprIx)
  const nk = nicheReadKindAt(r, fnIx)
  if nk < 0 { return -1 }
  const sMark = storageReadEnter(r)
  const box = exprUnion(r, fnIx)
  storageReadLeave(sMark)
  if box { nk } else { -1 }
}

// The `valueAtomKind` code of the narrowed atom that un-annotated `LetDecl` `letIx`'s bare-ident
// initializer reads as at the declaration, or -3 (no such let, or that read not narrowed).
function letInitNarrowedAtomKind(letIx: i32, fnIx: i32): i32 {
  if letIx < 0 { return -3 }
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType < 0 && d.letInit >= 0 {
      const ini = nodeAt(d.letInit)
      if ini is Ident {
        const a = identReadAtomKindAt(d.letInit, fnIx)
        if a >= 0 { return a }
      }
    }
  }
  -3
}

// The atom kind an ident expression currently reads as, for the scalar/string classifiers:
// `valueAtomKind`'s code when narrowed to one scalar atom (the read unboxes to it), -2 for
// a union binding not narrowed to a single atom (still the box ref, whatever its init spelled),
// or -3 when the expression is not a union-typed ident at all.
export function unionIdentReadKind(exprIx: i32, fnIx: i32) {
  // No union anywhere in the program means no identifier can denote one — skips
  // `unionNameOfRead`'s duplicate-chain walk for every OTHER read of a popular name a
  // non-union program happens to reuse across many sibling blocks. `exprString` (this
  // function's only caller) asks it of every ident, so this is the hot rung (D2326 perf).
  if !uDeclared { return -3 }
  if exprIx < 0 { return -3 }
  const e = nodeAt(exprIx)
  if e is Ident {
    if unionNameOfRead(exprIx, fnIx) != "" {
      const a = identReadAtomKindAt(exprIx, fnIx)
      if a >= 0 { return a }
      // An un-annotated binding whose init is itself a narrowed ident inherits that one level
      // of narrowing only (deeper would inherit someone else's), else `exprString` sees a box. D1013.
      // Only the read's own declaration: a parameter or loop variable inherits nothing.
      const rd = identDeclOf(exprIx)
      if rd >= 0 && nodeAt(rd) is LetDecl {
        const rk = letInitNarrowedAtomKind(rd, fnIx)
        if rk != -3 { return rk }
      }
      return -2
    }
  }
  -3
}

// The member-path dual of `unionIdentReadKind`: the atom kind a union-typed struct-field read
// (`o.y`, field code 16) currently reads as — the narrowed atom's kind when the member path is
// narrowed, -2 for an un-narrowed box read, -3 for a non-union-field member. An un-narrowed
// read is not always the box: where the read site itself unboxes, this must say so too. D311.
function memberUnionReadKind(exprIx: i32, fnIx: i32) {
  const e = nodeAt(exprIx)
  if e is Member {
    if memberUnionFieldNameRead(exprIx, fnIx) != "" {
      const a = memNarrowAtomKind(exprIx, fnIx)
      if a >= 0 { return a }
      const d = memReadUnboxAtomKind(exprIx, fnIx)
      if d >= 0 { return d }
      return -2
    }
    // A shared read delivering a box, typed as one atom (`emitMemSharedRead`'s twin).
    if memberFieldCode(exprIx, fnIx) == FC_UNION {
      const sa = pathReadAtomKind(exprIx, fnIx)
      if sa >= 0 { return sa }
    }
  }
  -3
}

// The index-place dual of `unionIdentReadKind`: the atom kind a union-box element read
// (`xs[0]`) reads as — the narrowed atom's kind, -2 for an un-narrowed box read, -3 when not a
// union-element index. Every classifier asks it, since a captured binding's cell read `c[0]`
// has no recorded type for their typed-IR fast paths (D2387).
export function indexUnionReadKind(exprIx: i32, fnIx: i32) {
  const e = nodeAt(exprIx)
  if e is Index {
    if indexElemUnionName(exprIx, fnIx) != "" {
      const a = idxNarrowAtomKind(exprIx, fnIx)
      if a >= 0 { return a }
      return -2
    }
    // A union-valued map's bare read is the same box a union-element cell is (D1025), and a
    // narrowed cell unboxes at the read — the map receiver just one container over.
    const mrs = mapReadNarrowableSlot(exprIx, fnIx)
    if mrs >= 0 && mvValKind[mrs] == MVK_UNION {
      const mak = mapReadNarrowedAtomKind(exprIx, fnIx)
      if mak >= 0 { return mak }
      return -2
    }
  }
  -3
}

// The variant struct name an object literal at `objIx` matches: the union variant whose
// field-name set equals the literal's field names (order-independent), or "" if none. A
// map-typed candidate field is further tightened by its value rep, so two unions' arms
// sharing field names but differing in map value type cannot collide onto the wrong slot.
export function objVariantName(objIx: i32) { objVariantNameCtx(objIx, -1) }

// `objVariantName` inside function `fnIx`, whose instance binds a type-parameter field (D3032).
export function objVariantNameCtx(objIx: i32, fnIx: i32) {
  const vi = objVariantRowCtx(objIx, fnIx)
  if vi < 0 { return "" }
  uVariants[vi]
}

// The variant row of literal `objIx` built at record type `ty` in function `fnIx`: the arm's row in
// the union the checker adopted the literal through, else the first row of `ty`'s shape; -1 for none.
export function litArmRowOf(objIx: i32, fnIx: i32, ty: i32): i32 {
  const au = litRepUnionAt(objIx, fnIx)
  const inU = if au >= 0 { variantRowInRowOfTy(unRowOfKey(au), ty) } else { -1 }
  if inU >= 0 { inU } else { repVariantShapeRowOf(ty) }
}

// The variant row `objVariantNameCtx` names, or -1. Twin arms can share one spelling, so a
// caller wanting the row takes it here rather than looking the name up again.
export function objVariantRowCtx(objIx: i32, fnIx: i32): i32 {
  const o = nodeAt(objIx)
  if o is ObjLit {
    // The arm the checker adopted this literal into, read at its position in the union it
    // adopted it through: two arms of two unions can share every field name and field code, and
    // the first-match scan below would build the other one (D2155). A literal adopted through
    // no union is found by its shape, as a structural record is (D14511).
    const lrt = litRepTyAt(objIx, fnIx)
    const own = litArmRowOf(objIx, fnIx, lrt)
    // A literal whose checker row is no arm builds at an arm only where the arm stores every
    // field as the row does, or the field is null, so no value read off it changes (D14493).
    const ownRow = own < 0
      && lrt >= 0
      && lrt < T.tys.length
      && tyAt(lrt) is TyObj
    // A bare `{}` names its arm only through the checker, having no field to match by (D2223).
    if own >= 0 && o.objFields.length == 0 { return own }
    if own >= 0 && objMatchesVariantIdxOmit(objIx, own, fnIx, true) {
      return own
    }
    // A literal leaving out a nullable field (D4601) is a row with the adopted record's names.
    if lrt >= 0 && lrt < T.tys.length {
      const r = tyAt(lrt)
      if r is TyObj && r.objFieldNames.length > o.objFields.length {
        let vo = ovnFirst(fieldNamesSig(r.objFieldNames))
        while vo >= 0 && vo < uVariants.length {
          if (
            objMatchesVariantIdxOmit(objIx, vo, fnIx, true)
            && (!ownRow || ovnStoredAlike(lrt, vo))
          ) {
            return vo
          }
          vo = ovnNextOf(vo)
        }
      }
    }
    // Only a variant whose field-name signature equals the literal's can match — the matcher
    // below needs equal counts and every variant name present — so the bucket for that
    // signature holds every candidate, in the ascending order the scan visited them.
    let vi = ovnFirst(objLitFieldSig(objIx))
    while vi >= 0 {
      if (
        objMatchesVariantIdxOmit(objIx, vi, fnIx, false)
        && (!ownRow || ovnStoredAlike(lrt, vi))
      ) {
        return vi
      }
      vi = ovnNextOf(vi)
    }
  }
  -1
}

// Whether arm `vi` stores each field of record type `ty` at that field's own code; a `null`
// field fits any field the name match already let hold null.
function ovnStoredAlike(ty: i32, vi: i32): boolean {
  if vi < 0 || vi >= uFieldCount.length { return false }
  const t = tyAt(ty)
  if !(t is TyObj) { return false }
  const start = uFieldStart[vi]
  let i = 0
  while i < t.objFieldNames.length {
    const ft = t.objFieldTypes[i]
    const lc = fieldCodeOfTy(ft)
    let fj = 0
    while fj < uFieldCount[vi] {
      if uFieldNames[start + fj] == t.objFieldNames[i] {
        if lc != uFieldTypes[start + fj] && !isNullTy(ft) { return false }
      }
      fj = fj + 1
    }
    i = i + 1
  }
  true
}

// Whether the object literal at `objIx` matches variant `vi`: equal field-name sets, tightened
// per field by `objMapFieldCompat`, `objNestedFieldCompat` or `variantFieldKindFits`. With
// `omit`, a field the literal leaves out matches when the variant may hold it as null (D4601),
// asked only of an arm carrying the names of the record the checker adopted the literal as.
export function objMatchesVariantIdxOmit(
  objIx: i32,
  vi: i32,
  fnIx: i32,
  omit: boolean,
): boolean {
  const o = nodeAt(objIx)
  if vi < 0 || vi >= uFieldCount.length || vi >= uFieldStart.length {
    return false
  }
  if o is ObjLit {
    const cnt = uFieldCount[vi]
    if !omit && cnt != o.objFields.length { return false }
    const start = uFieldStart[vi]
    let allMatch = true
    let present = 0
    let fj = 0
    while fj < cnt {
      const at = objFieldVal(objIx, uFieldNames[start + fj])
      if at >= 0 { present = present + 1 }
      if at < 0 {
        if !omit || !variantFieldMayOmit(vi, fj) { allMatch = false }
      } else if uFieldTypes[start + fj] == FC_MAP {
        if (
          !objMapFieldCompat(
            objIx,
            uFieldNames[start + fj],
            uFieldElemName[start + fj],
            uFieldElemTyIxAt(vi, fj),
          )
          || !objMapFieldKeyFits(objIx, uFieldNames[start + fj], vi)
        ) {
          allMatch = false
        }
      } else if uFieldTypes[start + fj] == FC_STRUCT {
        // A nested-struct candidate field (code 15) is tightened by its target's
        // field-name set, exactly as a map field is by its value rep.
        if (
          !objNestedFieldCompat(
            objIx,
            uFieldNames[start + fj],
            uFieldElemName[start + fj],
            fnIx,
          )
          || !variantFieldKindFits(objIx, uFieldNames[start + fj], vi)
        ) {
          allMatch = false
        }
      } else if !variantFieldKindFits(objIx, uFieldNames[start + fj], vi) {
        allMatch = false
      } else if (
        vi < uVarTyIx.length
        && !pinKindFitsTy(
          objIx,
          uFieldNames[start + fj],
          tyFieldTyOf(uVarTyIx[vi], uFieldNames[start + fj]),
          fnIx,
        )
      ) {
        allMatch = false
      }
      fj = fj + 1
    }
    // Every entry the literal writes is one of the variant's fields.
    if present != o.objFields.length { return false }
    return allMatch
  }
  false
}

// ── array-typedness of expressions ──────────────────────────────────────────────

// Parallel to the struct family above: decide whether an expression / param / local
// produces the i32 array (a `(ref $aTypeIdx)`) rather than an i32. An index read
// `a[i]` and `a.length` are i32 (not arrays), so they are deliberately absent here.

// The shared-field plan over an un-narrowed struct union `(A | B).tag`: fills `outVis`/`outFis`
// with each member's variant and field index in box-tag order, and returns the one field code
// they carry, or -1 when a member lacks the field or the codes disagree. `readIx` is the read,
// whose type picks the rep of a field stored at two (-1 when there is none).
export function sharedUnionFieldPlan(
  recvIx: i32,
  prop: string,
  readIx: i32,
  fnIx: i32,
  outVis: i32[],
  outFis: i32[],
): i32 {
  // A receiver the checker recorded as a scalar, list, map or function is no struct union at
  // any instance; a record can be, when same-shape arms collapse onto it (D5066).
  if !tyMayInstUnion(nodeTyAt(unwrapParen(recvIx), fnIx)) { return -1 }
  if !exprUnion(recvIx, fnIx) { return -1 }
  const recv = nodeAt(unwrapParen(recvIx))
  // The receiver need not be an ident — a non-ident receiver's re-evaluation is handled by
  // the emitter's lazy-frame stash; what's decided here is only the narrowed-set typing.
  let set = ""
  let setId = -1
  const rnt = readNarrowedTyAt(recvIx, fnIx)
  if rnt >= 0 {
    setId = msSetOfTyAny(rnt)
    if setId >= 0 { set = msTextOf(setId) }
  } else if recv is Ident {
    const un = unionNameOfRead(unwrapParen(recvIx), fnIx)
    set = unionMemberSetOf(un)
    setId = msSetOfUnion(un)
  } else {
    const un = unionNameOfExpr(recvIx, fnIx)
    set = unionMemberSetOf(un)
    setId = msSetOfUnion(un)
  }
  if set == "" { return -1 }
  const atoms: string[] = []
  msMemberAtomsOfSet(setId, atoms)
  if atoms.length < 2 { return -1 }
  let code = -1
  let mixed = false
  let i = 0
  // A receiver the checker proved non-null reads no field off its `null` atom.
  const skipNull = !nodeTyIsNullable(recvIx)
  while i < atoms.length {
    // `variantIndexOfTypeName` (D1083), not the exact `variantIndexOf`: the atoms here can be
    // structural renders (a narrowed complement's fallback), which `variantIndexOf` can't match.
    const vi = variantIndexOfTypeName(atoms[i])
    if vi < 0 && skipNull && atoms[i] == "null" {
      i = i + 1
      continue
    }
    if vi < 0 { return -1 }
    const fi = variantFieldIndex(vi, prop)
    if fi < 0 { return -1 }
    const fc = variantFieldTypeAt(vi, fi)
    if code < 0 { code = fc }
    else if code != fc { mixed = true }
    // `boolean` and `i32` share code 0 and are still two atoms of the join.
    if i > 0 && fc == FC_I32 && code == FC_I32 {
      const k0 = sharedFieldArmAtomKind(outVis[0], outFis[0])
      const ki = sharedFieldArmAtomKind(vi, fi)
      if k0 >= 0 && ki >= 0 && k0 != ki { mixed = true }
    }
    outVis.push(vi)
    outFis.push(fi)
    i = i + 1
  }
  if (
    !mixed
    && code == FC_STRUCT
    && sharedFieldNarrowedArms(readIx, fnIx, outVis, outFis)
  ) {
    return code
  }
  if outVis.length < 2 { return -1 }
  // Records stored at different rows read as the box of the union the read is typed as.
  if (
    !mixed
    && code == FC_STRUCT
    && sharedFieldStructBoxPlan(outVis, outFis, readIx)
  ) {
    return FC_UNION
  }
  if mixed {
    const lit = sharedFieldLitSetPlan(outVis, outFis, readIx)
    if lit >= 0 { return lit }
    const nb = sharedFieldNulBoolPlan(outVis, outFis, readIx)
    if nb >= 0 { return nb }
    const ns = sharedFieldNulStrPlan(outVis, outFis, readIx)
    if ns >= 0 { return ns }
    if !sharedFieldArmsBoxable(outVis, outFis) { return -1 }
    return FC_UNION
  }
  code
}

// Whether the record field read `readIx` is narrowed to one record (`if w.c is C`), keeping in
// `vis`/`fis` only the members whose field stores that record; the `is` test read the box tag,
// so no other member reaches the read. False, the plan untouched, when no member stores it.
function sharedFieldNarrowedArms(
  readIx: i32,
  fnIx: i32,
  vis: i32[],
  fis: i32[],
): boolean {
  const nt = readNarrowedTyAt(readIx, fnIx)
  if nt < 0 || !(tyAt(nt) is TyObj) { return false }
  const kv: i32[] = []
  const kf: i32[] = []
  let i = 0
  while i < vis.length {
    const si = uFieldTgtStructIdx(vis[i], fis[i])
    if si >= 0 && si < sTyIx.length && tySame(sTyIx[si], nt) {
      kv.push(vis[i])
      kf.push(fis[i])
    }
    i = i + 1
  }
  if kv.length == 0 || kv.length == vis.length { return false }
  while vis.length > 0 { vis.pop() }
  while fis.length > 0 { fis.pop() }
  let j = 0
  while j < kv.length {
    vis.push(kv[j])
    fis.push(kf[j])
    j = j + 1
  }
  true
}

// The opcode narrowing the field read at `memIx` back to the `i32` or `f32` the checker typed it,
// or -1: a wider scalar slot of a record built at a wider declared record of its field names,
// read through any handle at its own type. Exact, since nothing writes a covariant delivery's
// widened slot (D2987).
export function memReadNarrowOp(memIx: i32, fnIx: i32): i32 {
  const ty = nodeTyAt(memIx, fnIx)
  if ty < 0 || ty >= T.tys.length { return -1 }
  const t = tyAt(ty)
  let own = ""
  if t is TyPrim { own = t.primName }
  if own != "i32" && own != "f32" { return -1 }
  if !memRecvIsRecord(memIx, fnIx) { return -1 }
  const fc = memFieldTypeCode(memIx, fnIx)
  let wk = -1
  if fc == FC_I64 { wk = 3 }
  if fc == FC_F64 { wk = 4 }
  if fc == FC_F32 { wk = 5 }
  atomNarrowOp(wk, valueAtomKind(own))
}

// Whether the checker typed the receiver of the field read at `memIx` as a record, `| null`
// peeled: the one receiver whose storage can be a wider record of the same field names.
function memRecvIsRecord(memIx: i32, fnIx: i32): boolean {
  if memIx < 0 || memIx >= P.nodes.length { return false }
  const m = nodeAt(memIx)
  if m is Member {
    // A read the variant tables serve is lowered by `emitMem`'s variant rungs, not its struct one.
    if memNarrowVariantIndex(memIx, fnIx) >= 0 { return false }
    if exprVariantIndex(m.memObj, fnIx) >= 0 { return false }
    if memRecvNulVariantIndex(m.memObj, fnIx) >= 0 { return false }
    return rsTyIsRecord(recvCheckedTyOf(unwrapParen(m.memObj), fnIx, 0))
  }
  false
}

// The checker's type of the receiver `rx`, or, where it recorded none for the node (a narrowed
// member read's receiver), of the binding or record field `rx` names; -1 when neither is known.
function recvCheckedTyOf(rx: i32, fnIx: i32, depth: i32): i32 {
  const t = nodeTyAt(rx, fnIx)
  if t >= 0 || rx < 0 || rx >= P.nodes.length || depth > 16 { return t }
  const n = nodeAt(rx)
  if n is Member {
    let ot = recvCheckedTyOf(unwrapParen(n.memObj), fnIx, depth + 1)
    if ot < 0 || ot >= T.tys.length { return -1 }
    const o = tyAt(ot)
    if o is TyNullable { ot = o.nInner }
    return tyFieldTyOf(ot, n.memProp)
  }
  identDeclTyOf(rx, fnIx)
}

// The declared type of the binding or parameter the identifier at `rx` names in function `fnIx`
// (an un-annotated binding's initializer's type), or -1 for any other node.
function identDeclTyOf(rx: i32, fnIx: i32): i32 {
  if rx < 0 || rx >= P.nodes.length { return -1 }
  const n = nodeAt(rx)
  if n is Ident {
    const li = identLetOfRead(rx, fnIx)
    if li >= 0 {
      const d = nodeAt(li)
      if d is LetDecl {
        if d.letType >= 0 { return annRowOfNode(d.letType) }
        return nodeTyIxOf(unwrapParen(d.letInit))
      }
    }
    const pi = paramIndexOf(fnIx, n.identName)
    const ft = nodeTyIxOf(fnIx)
    if pi < 0 || ft < 0 || ft >= T.tys.length { return -1 }
    const f = tyAt(ft)
    if f is TyFunc {
      if pi < f.fnParamTypes.length { return f.fnParamTypes[pi] }
    }
  }
  -1
}

// The receiver record's own type of the union-box field read at `memIx` when its storage is a
// wider record's: each stored scalar member the own union lacks is one of its members widened.
// The read site rebuilds such a box at the own members, so every consumer reads it (D3006). -1
// for any other read.
export function memReadBoxNarrowTy(memIx: i32, fnIx: i32): i32 {
  const nt: i32[] = []
  if memReadBoxPlan(memIx, fnIx, nt) != 1 { return -1 }
  nt[0]
}

// The name of the union `memReadBoxNarrowTy` rebuilds the box at, or "" for any other read.
export function memReadBoxNarrowName(memIx: i32, fnIx: i32): string {
  const nt = memReadBoxNarrowTy(memIx, fnIx)
  if nt < 0 { return "" }
  unionSpellingOfTy(nt, 8)
}

// Appends the own and the stored type of the union-box field read at `memIx` to `out`, and
// answers 1 when every stored member the own union lacks narrows back to exactly one of its
// members, 2 when one of them narrows back to two, and 0 for any other read.
export function memReadBoxPlan(memIx: i32, fnIx: i32, out: i32[]): i32 {
  if memIx < 0 || memIx >= P.nodes.length { return 0 }
  const m = nodeAt(memIx)
  if m is Member {
    const si = structIndexOfExpr(m.memObj, fnIx)
    if si < 0 { return 0 }
    const fi = sFieldIndex(si, m.memProp)
    if fi < 0 || sFieldTypeAt(si, fi) != FC_UNION { return 0 }
    if !memRecvIsRecord(memIx, fnIx) { return 0 }
    const rt = recvCheckedTyOf(unwrapParen(m.memObj), fnIx, 0)
    if rt < 0 || rt >= T.tys.length { return 0 }
    let ot = rt
    const t = tyAt(rt)
    if t is TyNullable { ot = t.nInner }
    const own = tyFieldTyOf(ot, m.memProp)
    const phys = sFieldElemTyIxAt(si, fi)
    const oa: string[] = []
    const pa: string[] = []
    if !canonUnionMembersInto(own, [], oa) { return 0 }
    if !canonUnionMembersInto(phys, [], pa) { return 0 }
    out.push(own)
    out.push(phys)
    let narrowed = 0
    let i = 0
    while i < pa.length {
      if !strListHas(oa, pa[i]) {
        const k = boxNarrowAtomFor(pa[i], oa, pa)
        if k == -2 { return 2 }
        if k < 0 { return 0 }
        narrowed = 1
      }
      i = i + 1
    }
    return narrowed
  }
  0
}

// The wasm-type code of the struct/variant field a `Member` expression at `memIx` reads
// (`0` i32, `3` string, `4` i32-list, `5` ref-list), or `-1` if not a known field read.
// Mirrors `exprString`'s Member dispatch: a narrowed union identifier reads the variant
// field's type; otherwise the receiver's struct field's type — drives array-field reads.
function memFieldTypeCode(memIx: i32, fnIx: i32) {
  const e = nodeAt(memIx)
  if e is Member {
    // Only a narrowing that names a VARIANT re-homes the field onto the variant tables; one
    // that does not leaves the receiver at its own shape, so it falls through to the rungs
    // below rather than answering -1. A place narrowed to a plain struct is that case, and
    // its `string` field read then classified as an i32 at `print` (D1735).
    const vi = memNarrowVariantIndex(memIx, fnIx)
    if vi >= 0 {
      const vfi = variantFieldIndex(vi, e.memProp)
      if vfi >= 0 { return variantFieldTypeAt(vi, vfi) }
      return -1
    }
    // A field read on a variant-typed param `o.field` reads the variant struct's field type
    // directly, off the unboxed param rather than a `narrowName` ident.
    const pvi = exprVariantIndex(e.memObj, fnIx)
    if pvi >= 0 {
      const pvfi = variantFieldIndex(pvi, e.memProp)
      if pvfi >= 0 { return variantFieldTypeAt(pvi, pvfi) }
    }
    // The fifth receiver shape — `memRecvNulVariantIndex`'s own header states what it costs.
    const nvi5 = memRecvNulVariantIndex(e.memObj, fnIx)
    if nvi5 >= 0 {
      const nvfi5 = variantFieldIndex(nvi5, e.memProp)
      if nvfi5 >= 0 { return variantFieldTypeAt(nvi5, nvfi5) }
    }
    const si = structIndexOfExpr(e.memObj, fnIx)
    if si >= 0 {
      const fi = sFieldIndex(si, e.memProp)
      if fi >= 0 { return sFieldTypeAt(si, fi) }
    }
    // The fourth receiver shape: an un-narrowed struct union whose members all carry the
    // field at one code (`(A | B).tag`) — without it, a shared read classified as i32.
    const uvis: i32[] = []
    const ufis: i32[] = []
    const ucode = sharedUnionFieldPlan(
      e.memObj,
      e.memProp,
      memIx,
      fnIx,
      uvis,
      ufis,
    )
    if ucode >= 0 { return ucode }
  }
  -1
}

// True if `exprIx` evaluates to an `i32[]` (or `boolean[]`): a projection of `exprListRep`.
export function exprArray(exprIx: i32, fnIx: i32) {
  exprListRep(exprIx, fnIx) == "list"
}

// True if `exprIx` evaluates to a ref list: a projection of `exprListRep`.
export function exprRefArray(exprIx: i32, fnIx: i32) {
  exprListRep(exprIx, fnIx) == "reflist"
}

// The ref-list ELEMENT type-NAME a function `name` returns (from its `S[]`/`N[]` return
// annotation, recorded in `fRetRArrElem`), or "".
export function fnRetRefArrayNameSid(
  sid: i32,
  name: string,
  fnIx: i32,
  at: i32,
) {
  repOfNameResult(sid, name, fnIx, at).rdListElem
}

// The type the receiver `recv` of a list `is` has in function `fnIx`: its recorded type, or where
// that names a type parameter, the instance's binding of it, exact, pinned or a hole's (D4771).
// -1 where the instance leaves it open.
export function listIsRecvTyOf(recv: i32, fnIx: i32): i32 {
  const declTy = nodeTyAt(recv, fnIx)
  if declTy >= 0 && !tyHasTyVar(declTy) { return declTy }
  const ext = exactOperandTyOf(recv, fnIx)
  if ext >= 0 || declTy < 0 { return ext }
  instanceTyOf(declTy, fnIx)
}

// The `K[]` a read `exprIx` of a local list takes in `fnIx` when it is typed by an `is K[]` over
// that local whose elements can never be `K`, so the arm reads an empty `K[]` in its place
// (D4911, D4962); -1 for any other read. Answered from types alone, so collect and emit agree.
export function listFitArmTyOf(exprIx: i32, fnIx: i32): i32 {
  if fnIx < 0 || listIsIdentNames.length == 0 { return -1 }
  const ax = unwrapParen(exprIx)
  if ax < 0 || ax >= P.nodes.length { return -1 }
  const r = nodeAt(ax)
  if !(r is Ident) || !strListHas(listIsIdentNames, r.identName) { return -1 }
  const t = nodeTyAt(ax, fnIx)
  if t < 0 || t >= T.tys.length || !(tyAt(t) is TyArray) || tyHasTyVar(t) {
    return -1
  }
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return -1 }
  if listFitArmTestIn(fn.fnBody, r.identName, t, fnIx) { return t }
  -1
}

// Whether `ix` holds, outside nested functions, an `is` over local `name` testing `kTy` whose
// receiver's elements, in `fnIx`, can never be `kTy`'s, the receiver neither a union nor nullable.
function listFitArmTestIn(ix: i32, name: string, kTy: i32, fnIx: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if n is FuncDecl { return false }
  if n is IsExpr {
    const o = nodeAt(unwrapParen(n.isObj))
    if (
      o is Ident
      && o.identName == name
      && tySame(isVarTyIxOf(ix), kTy)
      && !exprUnion(n.isObj, fnIx)
      && !nodeTyIsNullable(n.isObj)
      && listDisjointDepth(listIsRecvTyOf(n.isObj, fnIx), kTy) == 1
    ) {
      return true
    }
  }
  for k in nodeChildren(ix) {
    if listFitArmTestIn(k, name, kTy, fnIx) { return true }
  }
  false
}

// The list type, in `fnIx`, of the receiver of the `is K[]` tests over the local read at
// `exprIx`, where the read is typed as a list and every such receiver is one list type. An
// `is` narrows a list's reads only, so the read keeps the receiver's storage (D4916). -1 for
// any other read, and for an arm that reads an empty `K[]` in the local's place.
export function listNarrowRecvTyOf(exprIx: i32, fnIx: i32): i32 {
  if fnIx < 0 || listIsIdentNames.length == 0 { return -1 }
  const ax = unwrapParen(exprIx)
  if ax < 0 || ax >= P.nodes.length { return -1 }
  const r = nodeAt(ax)
  if !(r is Ident) || !strListHas(listIsIdentNames, r.identName) { return -1 }
  const t = nodeTyInOf(ax, fnIx)
  if t < 0 || t >= T.tys.length || !(tyAt(t) is TyArray) { return -1 }
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return -1 }
  if listFitArmTyOf(exprIx, fnIx) >= 0 { return -1 }
  const found: i32[] = []
  listIsRecvTysIn(fn.fnBody, r.identName, fnIx, found)
  if found.length == 0 { return -1 }
  for f in found {
    if f < 0 || !tySame(f, found[0]) { return -1 }
  }
  // A receiver whose elements can never be the read's is another list the read does not hold.
  if listDisjointDepth(found[0], t) >= 0 { return -1 }
  found[0]
}

// Appends to `out`, for each `is` with a list type over local `name` in `ix` outside nested
// functions, its receiver's type in `fnIx` where that is a list, else -1.
function listIsRecvTysIn(ix: i32, name: string, fnIx: i32, out: i32[]) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is FuncDecl { return 0 }
  if n is IsExpr {
    const o = nodeAt(unwrapParen(n.isObj))
    const kTy = isVarTyIxOf(ix)
    if o is Ident && o.identName == name && kTy >= 0 && kTy < T.tys.length {
      if tyAt(kTy) is TyArray {
        const rt = listIsRecvTyOf(n.isObj, fnIx)
        if rt >= 0 && rt < T.tys.length && tyAt(rt) is TyArray {
          out.push(rt)
        } else {
          out.push(-1)
        }
      }
    }
  }
  for k in nodeChildren(ix) { listIsRecvTysIn(k, name, fnIx, out) }
  0
}

// The row name of the ref-list element an array-typed node carries, keyed by its element
// type; "" when no row is keyed by that type (a closure element, an unresolved hole).
function refListElemNameOfNodeTy(exprIx: i32): string {
  const s = rlSlotOfTy(tyRefArrElemOf(nodeTyIxOf(exprIx)))
  if s >= 0 && s < rlElemName.length { return rlElemName[s] }
  ""
}
// `refListElemNameOfNodeTy` at the pins of instance `fnIx`: a generic body's `T[]` names the
// row of its pinned element; "" when a type parameter stays open or no row is keyed by it.
function refListElemNameOfInstTy(exprIx: i32, fnIx: i32): string {
  const s = rlSlotOfTy(tyRefArrElemOf(instanceTyOf(nodeTyIxOf(exprIx), fnIx)))
  if s >= 0 && s < rlElemName.length { return rlElemName[s] }
  ""
}
// The ref-list ELEMENT type-NAME the expression at `exprIx` produces, or "" if it is not
// a ref list. Mirrors `exprRefArray`'s receiver shapes, resolving the per-element-
// type table slot (`refListSlotOfExpr`) at every push / index / `.length` / store site.
export function refListElemNameOfExpr(exprIx: i32, fnIx: i32) {
  const rs = listRowOfExpr(exprIx, fnIx)
  if rs >= 0 && rs < rlElemName.length { return rlElemName[rs] }
  refListElemNameOfExprRaw(exprIx, fnIx)
}
// The ref-list row the expression at `exprIx` is built as in function `fnIx`: the row of its
// rep type (`exprRepTy`), as `listBuildOfTy` builds that type; -1 where it is no ref list.
export function listRowOfExpr(exprIx: i32, fnIx: i32): i32 {
  const t = exprRepTy(exprIx, fnIx, 8)
  if t < 0 { return -1 }
  const rt = recListRowTy(t)
  if rt < 0 { return -1 }
  const lb = listBuildOfTy(rt)
  if lb == null { return -1 }
  if (
    lb.lbKind == LBK_REF
    || lb.lbKind == LBK_UNION
    || lb.lbKind == LBK_REF_AT_SLOT
  ) {
    return lb.lbSlot
  }
  -1
}

// A list of records `t` as the list of the struct row its element is built at, where the row
// an alias leads to records another type (`structIndexOfTy`); `t` itself when the element has
// no struct row but the row under its rep key does, or when it is no record; else -1, so a
// stamp whose keyed row has no layout to read is not trusted over the value's own build.
function recListRowTy(t: i32): i32 {
  const a = if t >= 0 && t < T.tys.length { T.tys[t] } else { null }
  if !(a is TyArray) || a.aElem < 0 || !(tyAt(a.aElem) is TyObj) { return t }
  if structRowRecordingTy(a.aElem) >= 0 { return t }
  const si = structIndexOfTy(a.aElem)
  if si < 0 || si >= sTyIx.length || sTyIx[si] < 0 {
    const ks = rlSlotOfTy(a.aElem)
    if ks >= 0 && structIndexOfTy(rlElemTyIxAt(ks)) >= 0 { return t }
    return -1
  }
  mkArrayTy(sTyIx[si])
}

// The type the expression at `exprIx` is built as in function `fnIx`: an un-annotated binding's
// read is its initializer's, an index read the element of its list's, anything else its own
// stamp (`litRepTyAt`); -1 where none closes or `depth` runs out.
function exprRepTy(exprIx: i32, fnIx: i32, depth: i32): i32 {
  if exprIx < 0 || exprIx >= P.nodes.length || depth <= 0 { return -1 }
  const e = nodeAt(exprIx)
  if e is Paren { return exprRepTy(e.parInner, fnIx, depth - 1) }
  if e is Ident {
    const d = identDeclOf(exprIx)
    const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
    if dn is LetDecl && dn.letType < 0 && dn.letInit >= 0 {
      const r = exprRepTy(dn.letInit, fnIx, depth - 1)
      if r >= 0 { return r }
    }
    return litRepTyAt(exprIx, fnIx)
  }
  if e is Index {
    const b = exprRepTy(e.idxArr, fnIx, depth - 1)
    const bt = if b >= 0 && b < T.tys.length { T.tys[b] } else { null }
    if bt is TyArray && bt.aElem >= 0 { return bt.aElem }
  }
  // A call is built bottom-up: a plain function's result rep (`fnRetRepTy`), or a list `.map`
  // over that of its callback.
  const callee = if e is Call && e.callFn >= 0 && e.callFn < P.nodes.length { nodeAt(e.callFn) } else { null }
  if e is Call && callee is Ident {
    const fe = fnIndexOfInScopeAt(
      sidOfNode(e.callFn),
      callee.identName,
      fnIx,
      e.callFn,
    )
    const r = fnRetRepTy(fe, depth)
    if r >= 0 { return r }
  }
  if (
    e is Call
    && callee is Member
    && callee.memProp == "map"
    && e.callArgs.length == 1
  ) {
    const rt = nodeTyIxOf(callee.memObj)
    const r = if rt >= 0 && rt < T.tys.length && T.tys[rt] is TyArray { fnRetRepTy(mfCallbackFe(e.callArgs[0], fnIx), depth) } else { -1 }
    if r >= 0 { return mkArrayTy(r) }
  }
  litRepTyAt(exprIx, fnIx)
}

// The rep of what function `fe` (an `fnStmts` index) returns, when its result is inferred and
// every value it returns has one rep; -1 otherwise (a generic, an annotated return).
function fnRetRepTy(fe: i32, depth: i32): i32 {
  if fe < 0 || fe >= fnStmts.length { return -1 }
  const fd = nodeAt(fnStmts[fe])
  if !(fd is FuncDecl) || fd.fnRet >= 0 || fd.fnTyParams.length > 0 {
    return -1
  }
  const vals: i32[] = []
  a20RetWalk(fd.fnBody, true, vals)
  let r = -1
  for v in vals {
    const vr = exprRepTy(v, fnStmts[fe], depth - 1)
    if vr < 0 || (r >= 0 && !tyEq(r, vr)) { return -1 }
    r = vr
  }
  r
}
function refListElemNameOfExprRaw(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return "" }
  const e = nodeAt(exprIx)
  match e {
    ArrayLit => {
      return arrLitElemNameIn(exprIx, fnIx)
    }
    Paren => {
      return refListElemNameOfExpr(e.parInner, fnIx)
    }
    BinExpr => {
      if (
        e.binOp == "="
        && assignTargetReReads(exprIx, fnIx)
        && asgLitWidth(exprIx, fnIx) == ""
      ) {
        return refListElemNameOfExpr(asgReadNode(exprIx, fnIx), fnIx)
      }
    }
    // An if-expression's element is its join's row, the one its blocktype names (D2210).
    IfStmt => {
      if ifExprRefKind(exprIx, fnIx) != "reflist" { return "" }
      const ifs = ifExprRefSlot(exprIx, fnIx, "reflist", -1)
      if ifs < 0 || ifs >= rlElemName.length { return "" }
      return rlElemName[ifs]
    }
    // Every other expression is resolved by the rungs below.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | Call | Member | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  // `m[k]` / `m[k] ?? d` over a struct-LIST-valued map: the row keyed by the value's element
  // type, "" when none is.
  const slsMv = mapReadStructListMvSlot(exprIx, fnIx)
  if slsMv >= 0 {
    const mvRs = mvValInnerRlSlotAt(slsMv)
    if mvRs >= 0 && mvRs < rlElemName.length { return rlElemName[mvRs] }
    return ""
  }
  match e {
    Call => {
      return refListElemNameOfCall(e, exprIx, fnIx)
    }
    Ident => {
      return refListElemNameOfIdent(e, exprIx, fnIx)
    }
    Member => {
      return refListElemNameOfMember(e, exprIx, fnIx)
    }
    OptMember => {
      // The `?.` twin of the field read above: the chain resolves the receiver's row, and the
      // element name is the field's own — the receiver's `| null` does not change it (D1676).
      const osi = optChainStructIdxOf(e.omObj, fnIx)
      if osi >= 0 {
        const ofi = sFieldIndex(osi, e.omProp)
        if ofi >= 0 { return sFieldElemNameAt(osi, ofi) }
      }
    }
    Index => {
      // Indexing a nested ref array (`g[i]` where `g: S[][]`): the element strips one `[]` off
      // `g`'s element name — recurses for deeper nesting.
      return refListElemNameOfIndex(e, exprIx, fnIx)
    }
    BinExpr => {
      // `p ?? d` over a `<ref-array> | null` niche resolves via the niche's own inner-slot resolver
      // first — the plain recursion alone misses an `Index`'s `| null`-suffixed element name.
      const rlnLhs = coalesceNicheLhs(exprIx)
      if rlnLhs >= 0 {
        const rlnIn = nulRefArrayInnerSlot(rlnLhs, fnIx)
        if rlnIn >= 0 && rlnIn < rlElemName.length { return rlElemName[rlnIn] }
        return refListElemNameOfExpr(rlnLhs, fnIx)
      }
      // A ref-list concat yields a new list at the operands' own slot — skipping this, the slot-0
      // clamp reads a wrong row as real. Both operands must agree, or there is no single slot. D721.
      if e.binOp == "+" {
        const cl = refListElemNameOfExpr(e.binLeft, fnIx)
        if cl != "" {
          if cl == refListElemNameOfExpr(e.binRight, fnIx) { return cl }
        }
        // A mixed pair concatenates at the row the narrower operand is copied into.
        const side = catWidenSideOfBin(exprIx, fnIx)
        if side == 2 { return cl }
        if side == 1 { return refListElemNameOfExpr(e.binRight, fnIx) }
      }
    }
    // No other expression names a ref-list element.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  ""
}

// The ref-list row of the bare list annotation on the return of the function `name` read at
// `calleeIx` resolves to, or -1. The arena's row, which is the one the signature declares.
function calleeAnnRetRefListSlot(name: string, calleeIx: i32, fnIx: i32): i32 {
  const fe = fnIndexOfInScopeAt(sidOfNode(calleeIx), name, fnIx, calleeIx)
  if fe < 0 || fe >= fnStmts.length { return -1 }
  const fd = nodeAt(fnStmts[fe])
  if fd is FuncDecl {
    if fd.fnRet < 0 { return -1 }
    return annBareRefArrSlot(fd.fnRet)
  }
  -1
}

// The ref-list element name a call `e` returns: an `__array_new__` fill, a named or
// closure callee's result slot, `m.values()`, or a `.map`/`.filter` result. "" when the
// result is not a ref list.
function refListElemNameOfCall(e: Call, exprIx: i32, fnIx: i32): string {
  // `__array_new__(n, {…})` — the ref-list element name is the fill's struct.
  if arrNewIntrKind(exprIx, fnIx) == "reflist" {
    // The DESTINATION's element names the row first: the list is allocated at the heap
    // types it is stored into, and the fill's own spelling can be narrower — a `Node | null`
    // fill answers the bare `Node`, whose row the destination never interned (D1630). The
    // row is keyed by the destination's element type at this instance's pins; a miss is "".
    const anDstNm = refListElemNameOfInstTy(exprIx, fnIx)
    if anDstNm != "" { return anDstNm }
    // An ANNOTATED fill names its own element, ahead of the struct index below: inside a
    // monomorphized instance the annotation carries the pin, and it is the only one of the
    // two that keeps a `| null` — the struct index answers the bare struct for both.
    const anInst = instAnnTyNameOfExpr(e.callArgs[1], fnIx)
    if anInst != "" { return anInst }
    const asi = structIndexOfExpr(e.callArgs[1], fnIx)
    if asi >= 0 { return sNames[asi] }
    // The fill's own recorded type. A monomorphized clone shares this call node, so that
    // type is still the template's `T` and only the annotation above can name the element;
    // `""` reaches the caller's strict slot and refuses, rather than taking another
    // element's row (D1605).
    return rlMintNameOfTy(nodeTyIxOf(e.callArgs[1]))
  }
  if e.callFn < 0 { return "" }
  const callee = nodeAt(e.callFn)
  if callee is Ident {
    // A declared list return's element is the row its signature's result names (D6731).
    const asl = calleeAnnRetRefListSlot(callee.identName, e.callFn, fnIx)
    if asl >= 0 && asl < rlElemName.length { return rlElemName[asl] }
    const fn = fnRetRefArrayNameSid(
      sidOfNode(e.callFn),
      callee.identName,
      fnIx,
      e.callFn,
    )
    if fn != "" { return fn }
    // A nulreflist-returning function (`mk: () => i32[][] | null`): the INNER ref-list element name.
    const nfn = fnRetNulRefArrayNameSid(
      sidOfNode(e.callFn),
      callee.identName,
      fnIx,
      e.callFn,
    )
    if nfn != "" { return nfn }
    // A closure-value callee returning a ref list: its element name is the `rlElemName` of
    // the result slot parsed off the callee's resolved `$fnsig`.
    const ck = calleeCloSigKeyOfRead(e.callFn, fnIx)
    if sigKeyRetKind(ck) == "reflist" || sigKeyRetKind(ck) == "nulreflist" {
      const rs = sigKeyRetSlot(ck)
      if rs >= 0 && rs < rlElemName.length { return rlElemName[rs] }
    }
    // A narrowed union binding's closure arm: the name-based path misses it, so the general
    // `cloCallSigKey` fallback derives the key from the callee's checker type instead.
    const nk = cloCallSigKey(exprIx, fnIx)
    if sigKeyRetKind(nk) == "reflist" || sigKeyRetKind(nk) == "nulreflist" {
      const nrs = sigKeyRetSlot(nk)
      if nrs >= 0 && nrs < rlElemName.length { return rlElemName[nrs] }
    }
    return ""
  }
  // A ref-valued `m.values()` yields a ref list whose element is the map's value — read its
  // name off the value's mv ref-list slot, checked before the `.filter` result-slot path.
  if callee is Member {
    if callee.memProp == "values" {
      if exprMap(callee.memObj, fnIx) {
        const vsh = mapShapeOfExpr(callee.memObj, fnIx)
        if vsh >= 0 {
          const rs = mvRlSlot[vsh]
          if rs >= 0 { return rlElemName[rs] }
        }
      }
    }
    // Bound-guarded like the other reads in this function: `mfResultSlotOf` clamps a miss to
    // 0 rather than -1, so an unbounded `rlElemName[ms]` traps the compiler on an empty table. D227.
    // A nullable-record `.map` result names its own `| null` row even before it is interned,
    // which a function's inferred return asks for (D12820).
    const nrt = mfNulRecMapElemTy(exprIx, fnIx)
    if nrt >= 0 { return rlMintNameOfTy(nrt) }
    const ms = mfResultSlotOf(exprIx, fnIx)
    if ms >= 0 && ms < rlElemName.length { return rlElemName[ms] }
    const mrn = mfStructResultRowName(exprIx, fnIx)
    if mrn != "" { return mrn }
    // A list-returning `.map` named before `collectMapFilterUse` interns its row.
    const mln = mfListResultElemName(exprIx, fnIx)
    if mln != "" { return mln }
  }
  // A struct-field or indexed closure-array element call whose result is a ref list: the
  // resolved `$fnsig` result slot names the element, mirroring the Ident-callee arm above.
  const mk2 = cloCallSigKey(exprIx, fnIx)
  if sigKeyRetKind(mk2) == "reflist" || sigKeyRetKind(mk2) == "nulreflist" {
    const mrs2 = sigKeyRetSlot(mk2)
    if mrs2 >= 0 && mrs2 < rlElemName.length { return rlElemName[mrs2] }
  }
  return ""
}

// The ref-list element name a name read `e` holds: a narrowed arm, a param, a local, a
// capture or a global, nullable ref arrays answering their inner list. "" when the
// binding is not a ref list.
function refListElemNameOfIdent(e: Ident, exprIx: i32, fnIx: i32): string {
  // An `is K[]` arm's read of an empty list of another element is the arm's own `K[]` (D4962).
  const fat = listFitArmTyOf(exprIx, fnIx)
  if fat >= 0 {
    const fa = tyAt(fat)
    const fsl = if fa is TyArray { rlSlotOfTy(fa.aElem) } else { -1 }
    if fsl >= 0 && fsl < rlElemName.length { return rlElemName[fsl] }
  }
  // A union binding NARROWED to a ref-element array arm (`if x is S[]` then `x[i]`): the row
  // keyed by the arm's element at this instance's pins, the wrapper the narrowed read casts to.
  if identReadContainerAt(exprIx, fnIx) == RC_REF_LIST {
    return refListElemNameOfInstTy(exprIx, fnIx)
  }
  // A read the resolver bound to a module global is no same-named local of this frame (D9681).
  const rdg = identReadsGlobal(exprIx)
  // A kind-18 nullable ref-array local stores its INNER ref-list slot in `localStructIdx`; its element
  // name is that inner slot's element name, so `refListSlotOfExpr` round-trips back to the inner slot.
  if !rdg && declaredKind(exprIx) == "nulreflist" {
    const sl18 = declaredSlotOf(exprIx)
    if sl18 >= 0 {
      const is18 = localStructIdx[sl18]
      if is18 >= 0 && is18 < rlElemName.length { return rlElemName[is18] }
    }
  }
  // A nulreflist param's inner ref-list element name is the ref-array's element (the
  // `| null`-stripped annotation), so `refListSlotOfExpr` resolves the narrowed inner wrapper.
  if (paramNulRefArray(fnIx, exprIx)) {
    // Asked of the annotation's type: a monomorphized instance's grouped spelling
    // `(i32[][]|null)` is still a nullable ref array there.
    const pn18 = paramTypeNodeOfRead(fnIx, exprIx)
    if annNulRefArrSlot(pn18) >= 0 { return refListElemNameOfNodeTy(pn18) }
  }
  const pn = paramRefArrayName(fnIx, e.identName)
  if pn != "" && paramReadAt(fnIx, exprIx) { return pn }
  const dn = if rdg { "" } else { declaredRefArrayName(exprIx) }
  if dn != "" { return dn }
  // A captured ref-array's element name is the `rlElemName` of the slot the env field is
  // typed with — the storage-class mirror of `exprRefArray`'s capture arm.
  const cn = capturedRefListSlot(fnIx, e.identName)
  if cn >= 0 && cn < rlElemName.length { return rlElemName[cn] }
  const grl = globalLetOfRead(fnIx, exprIx)
  if grl >= 0 {
    const gk = globalCellKind(grl)
    // A kind-18 nullable ref-array global reads its inner ref-list row off the annotation,
    // since the declared-element name below falls through to a nameless `[]`/`null` init.
    if gk == "nulreflist" {
      const gs18 = letAnnRefListSlot(grl)
      if gs18 >= 0 && gs18 < rlElemName.length { return rlElemName[gs18] }
    }
    // A ref-list global reads the row its cell is declared at, which a destination may name
    // instead of the literal's own element, as a local reads its slot's (D3093).
    if gk == "reflist" {
      const grs = letRefListSlot(grl, -1)
      if grs >= 0 && grs < rlElemName.length { return rlElemName[grs] }
    }
    // The ref-list element type-name the global declares (`S[]`/`N[]`).
    const gra = letRefListElemName(grl, -1)
    if gra != "" { return gra }
  }
  // A box narrowed to a list arm no registered union names (`{x: i32}[]` of a field read
  // at a pin) reads the arm's row off its narrowed type (D4930).
  const nrs = recordListSlotOfNode(exprIx, fnIx)
  if nrs >= 0 && nrs < rlElemName.length { return rlElemName[nrs] }
  return ""
}

// The ref-list element name a field read `e` yields, through the same receiver rungs as
// `memFieldTypeCode`: a narrowed place, a union arm, a struct, or a struct union whose
// members all record one element name. "" when the field is not a ref list.
function refListElemNameOfMember(e: Member, exprIx: i32, fnIx: i32): string {
  // The member path's own narrowing first (D1014): a narrowed ref-element arm names the
  // arm's element, ahead of the receiver-narrowing arm below (a different question).
  if placeReadContainerAt(exprIx, fnIx) == RC_REF_LIST {
    return refListElemNameOfNodeTy(exprIx)
  }
  // A `recv.field` ref-list field read — the field's element name from the receiver's
  // struct / narrowed variant.
  // A narrowing that names no variant (a place narrowed to a plain struct) falls through to
  // the receiver rungs below, as `memFieldTypeCode` does (D1735).
  const vi = memNarrowVariantIndex(exprIx, fnIx)
  if vi >= 0 {
    const vfi = variantFieldIndex(vi, e.memProp)
    if vfi >= 0 { return uFieldElemName[uFieldStart[vi] + vfi] }
    return ""
  }
  // The receiver rungs of `memFieldTypeCode`, arm for arm: a union ARM value (a variant
  // param, local, capture or call) keeps its fields in the variant tables, so a struct-only
  // leg answers "" for a field that code already called a ref list (D1960).
  const avi = memRecvArmVariantIndex(e.memObj, fnIx)
  if avi >= 0 {
    const aen = variantFieldElemNameOr(avi, e.memProp)
    if aen != "" { return aen }
  }
  const si = structIndexOfExpr(e.memObj, fnIx)
  if si >= 0 {
    const fi = sFieldIndex(si, e.memProp)
    if fi >= 0 { return sFieldElemNameAt(si, fi) }
  }
  // An un-narrowed struct union whose members share the field: one element name only
  // when every member records the same one, since the read has a single wrapper row.
  const uvis: i32[] = []
  const ufis: i32[] = []
  if (
    sharedUnionFieldPlan(e.memObj, e.memProp, exprIx, fnIx, uvis, ufis)
    == FC_REF_LIST
  ) {
    const un0 = variantFieldElemName(uvis[0], ufis[0])
    let uk = 1
    while uk < uvis.length {
      if variantFieldElemName(uvis[uk], ufis[uk]) != un0 { return "" }
      uk = uk + 1
    }
    return un0
  }
  // The field read's twin of the Ident arm's last rung (D4930).
  if memNarrowVariantIndex(exprIx, fnIx) >= 0 {
    const mrs = recordListSlotOfNode(exprIx, fnIx)
    if mrs >= 0 && mrs < rlElemName.length { return rlElemName[mrs] }
  }
  ""
}

// The ref-list element name an index read `e` yields: a narrowed place's arm element, a
// nullable-ref-array cell's inner element, or the receiver's element name less one `[]`.
// "" when the cell is not a ref list.
function refListElemNameOfIndex(e: Index, exprIx: i32, fnIx: i32): string {
  // The index place's own narrowing to a ref-array arm (D1014) — distinct from the
  // nullable-niche narrowing below it, which peels a `| null` off the cell's own name.
  if placeReadContainerAt(exprIx, fnIx) == RC_REF_LIST {
    return refListElemNameOfNodeTy(exprIx)
  }
  // A narrowed index over a nullable-ref-array element resolves via `nulRefArrayInnerSlot`,
  // gated on the ref-array shape so an unrelated nullable-string cell can't borrow the row. D451.
  if indexElemNulRefArraySlot(unwrapParen(exprIx), fnIx) >= 0 {
    if tyIsArray(nodeTyAt(unwrapParen(exprIx), fnIx)) {
      const nin = nulRefArrayInnerSlot(unwrapParen(exprIx), fnIx)
      if nin >= 0 && nin < rlElemName.length { return rlElemName[nin] }
    }
  }
  // The outer row's own inner row first: a structural name can key a same-layout record
  // declared earlier than the one the items are built at (D6731). Otherwise a receiver whose
  // element is itself a ref list — raw, `| null`, or at this instance's pins — yields the
  // read's own typed row; any other receiver yields no ref-list element.
  const outer = refListElemNameOfExpr(e.idxArr, fnIx)
  if outer == "" { return "" }
  const os = rlSlotByNameTwin(outer, tyRefArrElemOf(nodeTyInOf(e.idxArr, fnIx)))
  if rlSlotIsKindList(os, RLK_REF_LIST) {
    const ins = rlElemInnerSlot(os)
    if ins >= 0 && ins < rlElemName.length {
      if rlSlotByNameTwin(rlElemName[ins], rlElemTyIxAt(ins)) == ins {
        return rlElemName[ins]
      }
    }
  }
  const at = nodeTyAt(e.idxArr, fnIx)
  if tyRefArrElemOf(tyRefArrElemOf(at)) >= 0 {
    return refListElemNameOfNodeTy(exprIx)
  }
  if tyRefArrElemOf(tyRefArrElemOf(instanceTyOf(at, fnIx))) >= 0 {
    return refListElemNameOfNodeTy(exprIx)
  }
  ""
}

// The per-element-type ref-list table SLOT the expression at `exprIx` produces, or -1 when
// the element type does not resolve. Slot 0 is a real row, so an unresolved read must not
// borrow it: every caller tests the result before indexing a backing/wrapper/element table.
export function refListSlotOfExpr(exprIx: i32, fnIx: i32) {
  const rs0 = listRowOfExpr(exprIx, fnIx)
  if rs0 >= 0 { return rs0 }
  const nm = refListElemNameOfExpr(exprIx, fnIx)
  const s = rlSlotByNameTwin(nm, tyRefArrElemOf(nodeTyInOf(exprIx, fnIx)))
  if repShadowOn { repABNote("clamp", "refListSlotOfExpr", "call") }
  if s < 0 {
    if repShadowOn { repABNote("clamp", "refListSlotOfExpr", "CLAMPED") }
    return -1
  }
  s
}

// True if the `LetDecl` at `letIx` declares a ref-list local: its annotation is a ref
// array (`S[]`/`N[]`), OR its initializer produces a ref list. Picks the local's valtype
// (`(ref $rlTypeIdx)`) and the code-`5` flag in `collectLocals`.
export function letIsRefArray(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = nodeAt(d.letType)
      if lt is TypeRef {
        // A union annotation (even `S[] | i64`) is a union-box local, not a reflist local —
        // return false so a ref-array init below doesn't mis-pick the reflist valtype.
        if isUNameAnnAB(5, d.letType) { return false }
        // Arena-first: the arena's `"reflist"` arm covers the settled base cases; the
        // spellings it declines (nested arrays, niches, union/map elements) keep the name walk.
        const k = annRepKindOf(d.letType)
        if k != null {
          if k == "reflist" { return true }
        } else {
          // Where the arena declines the element (nested arrays, niche/union-box/map
          // elements) the reflist layer's own row still answers, off the recorded type.
          if annBareRefArrSlot(d.letType) >= 0 { return true }
        }
      }
    }
    return exprRefArray(d.letInit, fnIx)
  }
  false
}

// The ref-list ELEMENT type-NAME a ref-list `LetDecl` binds: from its `S[]`/`N[]`
// annotation if present, else inferred from its initializer (`refListElemNameOfExpr`).
// "" if not a ref-list local.
export function letRefListElemName(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = nodeAt(d.letType)
      if lt is TypeRef {
        // The one site whose else-branch is the initializer path rather than "": an annotation
        // whose element has no row yet falls through to the initializer's row.
        const en = annBareRefArrElemName(d.letType)
        if en != "" { return en }
      }
    }
    return refListElemNameOfExpr(d.letInit, fnIx)
  }
  ""
}

// The arena element type of the name `letRefListElemName` returns, read from the same source:
// the annotation's element where that names one, else the initializer's at `fnIx`. -1 else.
export function letRefListElemTy(letIx: i32, fnIx: i32): i32 {
  if letIx < 0 { return -1 }
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 && nodeAt(d.letType) is TypeRef {
      if annBareRefArrElemName(d.letType) != "" {
        return tyRefArrElemOf(nodeTyIxOf(d.letType))
      }
    }
    if d.letInit < 0 { return -1 }
    return tyRefArrElemOf(nodeTyInOf(d.letInit, fnIx))
  }
  -1
}

// The arena element type of function `fe`'s ref-list return, the type beside its
// `fRetRArrElem` name, or -1.
export function fnRetRArrElemTy(fe: i32): i32 {
  if fe < 0 || fe >= fnStmts.length { return -1 }
  tyRefArrElemOf(rsFnRetTy(fnStmts[fe]))
}

// The ref-list slot function `fe`'s inferred ref-list result is built under: the slot its
// classified element name keys, else the row of its checked element type when that type is
// closed (`fnRetRefListDemand` interns it). -1 for none.
export function fnRetRefListSlot(fe: i32): i32 {
  if fe < 0 || fe >= fRetRArrElem.length { return -1 }
  const byName = rlSlotByNameTwin(fRetRArrElem[fe], -1)
  if byName >= 0 { return byName }
  const et = fnRetRArrElemTy(fe)
  if et < 0 || tyHasTyVar(et) { return -1 }
  rlSlotOfRowTy(et)
}

// The ref-list table slot a ref-list `LetDecl` binds (stored in `localStructIdx` for a
// code-5 local so `declaredRefArrayName` can recover its element type), or -1.
export function letRefListSlot(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl && d.letType < 0 && d.letInit >= 0 {
    const rr = listRowOfExpr(d.letInit, fnIx)
    if rr >= 0 { return rr }
  }
  if d is LetDecl {
    // Guarded by the newtype-brand receipt: a brand is a second arena index over its base's
    // `Ty`, so no structural reader can tell them apart — only `nwTyIxs` can, so it declines here. B123.
    const elemTy = tyRefArrElemOf(nodeTyIxOf(d.letType))
    if !tyIsNewtypeBrand(elemTy) {
      const a = annBareRefArrSlot(d.letType)
      if a >= 0 { return a }
    }
  }
  const ul = letInitUnionListTy(letIx, fnIx)
  if ul >= 0 { return rlSlotOfTy(tyArrayElemIx(ul)) }
  letTailRowSlot(letIx, fnIx)
}

// The union list an un-annotated list literal binding is built at, where the checker stamped
// its literal of records with one (D853); -1 otherwise.
export function letInitUnionListTy(letIx: i32, fnIx: i32): i32 {
  const d = nodeAt(letIx)
  if !(d is LetDecl) { return -1 }
  if d.letType >= 0 || d.letInit < 0 { return -1 }
  const ai = unwrapParen(d.letInit)
  if ai < 0 || !(nodeAt(ai) is ArrayLit) { return -1 }
  const own = tyArrayElemIx(nodeTyIxOf(ai))
  if own < 0 || !(tyAt(own) is TyObj) { return -1 }
  const lt = nonNullTy(litRepTyAt(ai, fnIx))
  const et = if lt >= 0 { tyArrayElemIx(lt) } else { -1 }
  if et < 0 || !(tyAt(et) is TyUnion) { return -1 }
  lt
}

// The row a `let` with no destination binds: for an un-annotated one, the initializer's
// delivered row where the element type does not decide it (`letInitDeliversRow`), else a list
// literal's own row; otherwise the row keyed by the element type. -1 for none.
function letTailRowSlot(letIx: i32, fnIx: i32): i32 {
  const et = letRefListElemTy(letIx, fnIx)
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letInit >= 0 && d.letType < 0 {
      const ai = unwrapParen(d.letInit)
      if ai < 0 { return -1 }
      if letInitDeliversRow(ai, et, fnIx) { return refListSlotOfExpr(ai, fnIx) }
      if nodeAt(ai) is ArrayLit { return arrLitRowSlotIn(ai, fnIx) }
    }
  }
  rlSlotOfRowTy(rlRowTyOfElem(et))
}

// Whether initializer `ai`, of element type `et`, binds the row its value already has: a
// spread copy its source's, a named function's call its callee's result (none when that is no
// ref list), a closure whose signature holds a type variable its bound one, and a record the
// nominal row its value is delivered at rather than a same-layout twin.
function letInitDeliversRow(ai: i32, et: i32, fnIx: i32): boolean {
  const ini = nodeAt(ai)
  if ini is ArrayLit {
    for el in ini.arrElems {
      if nodeAt(el) is Spread { return true }
    }
    return false
  }
  if ini is Call {
    if ini.callFn >= 0 {
      const ce = nodeAt(ini.callFn)
      if ce is Ident {
        const sid = sidOfNode(ini.callFn)
        if fnIndexOfInScopeAt(sid, ce.identName, fnIx, ini.callFn) >= 0 {
          return true
        }
      }
    }
  }
  if et < 0 || et >= T.tys.length { return false }
  const t = tyAt(et)
  if t is TyFunc { return tyHasTyVar(et) }
  t is TyObj
}

// The struct row an un-annotated binding of the object literal at `objIx` is built at, or -1
// to keep `own`: a declared destination's record of the literal's field names, when the
// literal's own record would reach it unconverted (D2933). Memoised per literal in `rsRecRow`.
export function objLitBindDestRow(objIx: i32, own: i32): i32 {
  if own < 0 || objIx < 0 || !emitPhaseReached("arenaFinal") { return -1 }
  if rsRecVer != sNames.length {
    rsRecRowClear()
    rsRecVer = sNames.length
  }
  if objIx < rsRecRow.length {
    if rsRecRow[objIx] != -2 { return rsRecRow[objIx] }
  }
  let r = recBuildRowOf(objIx)
  if r >= 0 && rsSameRow(r, own) { r = -1 }
  rsRecRowPut(objIx, r)
  r
}

// The struct row the object literal at `objIx`, an un-annotated binding's initializer, is built
// at by the checker's record solve (`recBuildTyOf`), or an element of a list literal that is one,
// or a value `m[k] = {...}` or `m.set(k, {...})` stores into such a `Map()` (`recBuildElemTyOf`);
// -1 to keep its own type's row.
export function recBuildRowOf(objIx: i32): i32 {
  if objIx < 0 || !rsIxReady() { return -1 }
  const li = rsUp(objIx)
  if li < 0 || li >= P.nodes.length { return -1 }
  if nodeAt(li) is ArrayLit {
    const ld = rsUp(li)
    if ld < 0 || ld >= P.nodes.length || !rsLetInitIs(ld, li) { return -1 }
    const et = recBuildElemTyOf(ld)
    if et < 0 { return -1 }
    return structIdxOfElemTy(et)
  }
  const pn = nodeAt(li)
  if pn is BinExpr && pn.binOp == "=" && pn.binRight == objIx {
    const tn = nodeAt(pn.binLeft)
    if !(tn is Index) || !(nodeAt(tn.idxArr) is Ident) { return -1 }
    const et = recBuildElemTyOf(identDeclOf(tn.idxArr))
    if et < 0 { return -1 }
    return structIdxOfElemTy(et)
  }
  if (
    pn is Call
    && pn.callArgs.length == 2
    && pn.callArgs[1] == objIx
    && pn.callFn >= 0
  ) {
    const f = nodeAt(pn.callFn)
    if !(f is Member) || f.memProp != "set" || !(nodeAt(f.memObj) is Ident) {
      return -1
    }
    const et = recBuildElemTyOf(identDeclOf(f.memObj))
    if et < 0 { return -1 }
    return structIdxOfElemTy(et)
  }
  if !rsLetInitIs(li, objIx) { return -1 }
  const t = recBuildTyOf(li)
  if t < 0 { return -1 }
  structIdxOfElemTy(t)
}

function rsRecRowPut(objIx: i32, r: i32) {
  while rsRecRow.length <= objIx { rsRecRow.push(-2) }
  rsRecRow[objIx] = r
  rsRecTouched.push(objIx)
  0
}

// Empty `rsRecRow` at the entries written since the last emptying (D3740): a table replaced and
// regrown to the literal's node index costs the arena's size each time.
function rsRecRowClear() {
  let i = 0
  while i < rsRecTouched.length {
    const x = rsRecTouched[i]
    if x >= 0 && x < rsRecRow.length { rsRecRow[x] = -2 }
    i = i + 1
  }
  rsRecTouched = []
  0
}

// The parent index `rsUp` reads, built once per final arena like `dsgReady`'s: each node's first
// parent from the root.
let rsIxRoot: i32 = -1
let rsIxLen: i32 = -1
let rsIxEpoch: i32 = -1
let rsPar: i32[] = []
let rsRecRow: i32[] = []
let rsRecTouched: i32[] = []
let rsRecVer: i32 = -1
// Drops the parent index, beside the global-destination index it mirrors.
export function rsResetUseIx() {
  rsIxRoot = -1
  rsIxLen = -1
  rsIxEpoch = -1
  rsPar = []
  rsRecRow = []
  rsRecTouched = []
  rsRecVer = -1
  0
}

function rsIxReady(): boolean {
  if !emitPhaseReached("arenaFinal") { return false }
  if emitRootIx < 0 { return false }
  if rsIxRoot == emitRootIx && rsIxLen == P.nodes.length { return true }
  if (
    rsIxRoot == emitRootIx
    && rsIxLen >= 0
    && rsIxLen < P.nodes.length
    && rsIxEpoch == arenaEpochNow()
  ) {
    return rsIxGrow()
  }
  rsResetUseIx()
  const n = P.nodes.length
  rsPar = __array_new__(n, -1)
  const stack: i32[] = [emitRootIx]
  const kids: i32[] = []
  while stack.length > 0 {
    const x = stack.pop() ?? -1
    nodeChildrenPush(x, kids)
    let k = 0
    while k < kids.length {
      const c = kids[k]
      if c >= 0 && c < n && c != emitRootIx {
        if rsPar[c] < 0 {
          rsPar[c] = x
          stack.push(c)
        }
      }
      k = k + 1
    }
    while kids.length > 0 { kids.pop() }
  }
  rsIxRoot = emitRootIx
  rsIxLen = n
  rsIxEpoch = arenaEpochNow()
  true
}

// Extend the index over an arena that only grew (D3740): with no slot rewritten, no node the root
// reaches leads to an appended one except a late annotation pin, which no query starts at or
// climbs through. The memoised build rows are dropped as a rebuild drops them.
function rsIxGrow(): boolean {
  rsRecRowClear()
  rsRecVer = -1
  const n = P.nodes.length
  let k = rsIxLen
  while k < n {
    rsPar.push(-1)
    k = k + 1
  }
  rsIxLen = n
  true
}

// The nearest ancestor of `x` that is not a parenthesis, or -1.
function rsUp(x: i32): i32 {
  if x < 0 || x >= rsPar.length { return -1 }
  let p = rsPar[x]
  while p >= 0 && p < rsPar.length && nodeAt(p) is Paren { p = rsPar[p] }
  p
}

// The ref-list table slot a `LetDecl`'s ref-array annotation names (`let xs: Tok[] = []`
// → the `Tok` slot), or 0 when it is not a ref-array annotation.
export function letAnnRefListSlot(letIx: i32) { letAnnRefListSlotIn(letIx, -1) }

// `letAnnRefListSlot` of a binding declared in function `fnIx` (-1 at module scope), whose
// un-annotated initializer is read at that function's instance.
export function letAnnRefListSlotIn(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    // An un-annotated map read has no annotation to name its slot, and 0 is a wrong answer,
    // not a missing one — two such globals would otherwise share slot 0's wrapper wrongly. D1040.
    if d.letType < 0 {
      if letNulMapReadValKind(letIx, fnIx) != null {
        return letNulMapReadSlotArg(letIx, fnIx)
      }
      // The same "0 is wrong, not missing" hazard for the other un-annotated kind-18 source:
      // resolved through the binding's own init, so a global and same-typed local agree. D1106.
      if letIsNulRefArray(letIx, fnIx) {
        return nulRefArrayInnerSlotOfLet(letIx, fnIx)
      }
    }
    return tyAnnRefListSlot(d.letType)
  }
  if repShadowOn { repABNote("clamp", "letAnnRefListSlot", "CLAMPED-notLet") }
  0
}

// ── string-array-typedness of expressions (`string[]`) ──────────────────────────

// Parallel to the ref-array family: decide whether an expression / param / local produces
// a string list — a `(ref $mkListIdx)`. An index read `xs[i]` (a string) / `.length` (i32)
// is not a list.

// True if function `name` returns a string-keyed mono map (`{[string]: i32}`, annotated or
// inferred — `"map"`). Lets `exprMap`/`mapShapeOfExpr` classify a call to it, so
// `const r = mk()` (or `mk()[k]`) routes through the map lowering.
function fnRetMapSid(sid: i32, name: string, fnIx: i32, at: i32) {
  repOfNameResult(sid, name, fnIx, at).rdKind == "map"
}

// True if `exprIx` evaluates to a `string[]`: a projection of `exprListRep`.
export function exprStringArray(exprIx: i32, fnIx: i32) {
  exprListRep(exprIx, fnIx) == "strlist"
}

// True if the expression at `exprIx` produces a `(string | null)[]` — the string-ref niche
// list, whose backing is a plain string list but whose element read stays `(ref null)`
// instead of recovering non-null. Recognizes the receiver by its recorded array element
// type or a param/local annotation. Drives the dedicated read arm, checked before `exprStringArray`.
export function exprNulStrArray(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  if arrElemIsNulStrAt(exprIx, fnIx) { return true }
  // A list whose recorded element is a hole's variable holds what the instance `fnIx` pins it
  // to, and at `string | null` a read that recovers non-null traps on the null (D3089).
  const pe = nodeArrayElemTyIx(exprIx)
  if pe >= 0 && tyHasTyVar(pe) {
    if tyIsNulPrim(iterElemPinTy(exprIx, fnIx), "string") { return true }
  }
  const e = nodeAt(exprIx)
  match e {
    Paren => {
      return exprNulStrArray(e.parInner, fnIx)
    }
    Ident => {
      const pt = paramTypeNodeOfRead(fnIx, exprIx)
      if pt >= 0 {
        // `…Deep` also admits a `(string | null)[] | null` param narrowed with `!= null`: the
        // narrowed value stays `(ref null)`, since the plain-string arm's recover traps on null.
        return annIsNulStrListDeep(pt)
      }
      // A union binding narrowed to the `(string | null)[]` arm reads unboxed as the
      // string list whose ELEMENT stays `(ref null)` — the same nullable read discipline.
      if tyScalarBackedListKind(readNarrowedTyAt(exprIx, fnIx)) == "strlist" {
        return true
      }
      // A local/global binding (or a rebind chain `const t0 = g`) annotated
      // `(string | null)[]` — or `(string | null)[] | null`, narrowed via `t0 != null`.
      if identBindingNulStrList(exprIx, fnIx, 4) { return true }
    }
    // No other expression is a nullable-string list.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | Member | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// The `exprNulStrArray` binding resolver: whether the LetDecl the read `readIx` names
// (a `let` of the frame, else a module global) has an ANNOTATION — directly or
// under an outer `| null` — that is a `(string | null)[]` list; an un-annotated rebind
// (`const t0 = g`) follows its init chain (depth-capped).
function identBindingNulStrList(readIx: i32, fnIx: i32, depth: i32): boolean {
  if depth <= 0 { return false }
  let li = fnLetOfRead(fnIx, readIx)
  if li < 0 {
    // A rebind chain ending at a PARAM of the enclosing function (`const t0 = p`).
    const pt = paramTypeNodeOfRead(fnIx, readIx)
    if pt >= 0 { return annIsNulStrListDeep(pt) }
    // A module GLOBAL (`const g: (string | null)[] | null = …`) — top-level LetDecls
    // live in `globalStmts` (they emit as wasm globals, not start statements).
    li = globalLetOfRead(fnIx, readIx)
  }
  if li < 0 { return false }
  const d = nodeAt(li)
  if !(d is LetDecl) { return false }
  if d.letType >= 0 { return annIsNulStrListDeep(d.letType) }
  if d.letInit >= 0 {
    const init = nodeAt(unwrapParen(d.letInit))
    if init is Ident {
      return identBindingNulStrList(unwrapParen(d.letInit), fnIx, depth - 1)
    }
  }
  false
}

// Usage-driven element inference for an un-annotated empty `[]` local: a push of any
// string-typed expression makes a build-loop accumulator classify as `string[]`.
// `gStrInfLet` guards against the `out.push(out[0])` self-reference cycle.
export function letInfStrListByUseV(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 { return false }
    if d.letInit < 0 { return false }
    const ini = nodeAt(unwrapParen(d.letInit))
    if ini is ArrayLit {
      if ini.arrElems.length != 0 { return false }
      if gStrInfLet == letIx { return false }
      const saved = gStrInfLet
      gStrInfLet = letIx
      let found = false
      let i = 0
      while i < P.nodes.length {
        const nd = nodeAt(i)
        if nd is Call && nd.callFn >= 0 {
          const callee = nodeAt(nd.callFn)
          if callee is Member {
            if callee.memProp == "push" {
              const recv = nodeAt(callee.memObj)
              if recv is Ident {
                if recv.identName == d.letName && nd.callArgs.length == 1 {
                  const argN = nodeAt(unwrapParen(nd.callArgs[0]))
                  if argN is StrLit {
                    found = true
                  } else if fnIx >= 0 && exprString(nd.callArgs[0], fnIx) {
                    found = true
                  }
                }
              }
            }
          }
        }
        i = i + 1
      }
      gStrInfLet = saved
      return found
    }
  }
  false
}

// True if the `LetDecl` at `letIx` declares a `string[]` local: its annotation is
// `string[]`, OR its initializer produces a string list. Picks the local's valtype
// (`(ref $mkListIdx)`) and the code-`7` flag in `collectLocals`.
export function letIsStringArray(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      // A `K[]` annotation is the i32 atom list, authoritative over a string-typed init (since
      // #1852, no string expression can reach here wrongly). Ahead of `annRepKindOf`, not
      // beside the name arms it mirrors: a covered annotation skips the name-arm block entirely.
      if tyIsLitUnionArray(nodeTyIxOf(d.letType)) { return false }
      // Arena-first: a covered annotation answers both the string-list test and the
      // authoritative ref-list reject; an uncovered one asks the annotation's type below.
      const k = annRepKindOf(d.letType)
      if k != null {
        if k == "strlist" { return true }
        if k == "reflist" { return false }
      } else {
        // The `(K | null)[]` reject, authoritative over a string-first init literal (#1563), must
        // lead the string arm.
        if annIsNulLitUnionArray(d.letType) { return false }
        // Live and asymmetric with its sibling `letIsI32List`: forcing this arm false uniquely
        // loses a corpus row where the arena legs above don't reach.
        const lt = nodeAt(d.letType)
        if lt is TypeRef {
          if tyScalarListKind(nodeTyIxOf(d.letType)) == "strlist" {
            return true
          }
          // A ref-array annotation is authoritative (see `letIsF64Array`) — `annBareRefArrSlot`
          // answers the intern-state question for spellings `annRepKindOf` leaves uncovered.
          if annBareRefArrSlot(d.letType) >= 0 { return false }
        }
      }
    }
    if exprStringArray(d.letInit, fnIx) { return true }
    return letInfStrListByUseV(letIx, fnIx)
  }
  false
}

// True if `exprIx` evaluates to an `f64[]`: a projection of `exprListRep`.
export function exprF64Array(exprIx: i32, fnIx: i32) {
  exprListRep(exprIx, fnIx) == "f64list"
}

// ── f32-array typedness (the f32 sibling of the f64-array family, rep code 21) ───

// f32 is the checker's weak spot (a float literal types f64), so a recorded `f64[]` yields to
// the syntactic f32 rungs in `exprListRep`. A bare `[1.5]` literal stays f64; a value is f32[]
// only when a declared type or an f32 element says so.

// True if the array literal at `arrIx` has f32 elements — every element must be `exprIsF32`,
// unlike its f64/i64 siblings, which claim on any element. A mixed literal (`[fv, 1]`) is a
// checker-level union, not an f32 list, and an annotated `f32[]` binding routes through the
// annotation instead. A bare `[1.5]` stays f64: a float literal is deliberately not `exprIsF32`.
export function arrLitIsF32(arrIx: i32, fnIx: i32) {
  const a = nodeAt(arrIx)
  if a is ArrayLit {
    if a.arrElems.length < 1 { return false }
    if hasSpreadItem(a.arrElems) { return spreadDestKind(arrIx, fnIx) == "f32" }
    // The checker types an f32 element beside literal ones `f32[]`; the literals adopt it.
    if tyIsF32ArrayTy(nodeTyAt(arrIx, fnIx)) { return true }
    let i = 0
    while i < a.arrElems.length {
      if !exprIsF32(a.arrElems[i], fnIx) { return false }
      i = i + 1
    }
    return true
  }
  false
}

// True if `exprIx` evaluates to a `u8[]`: a projection of `exprListRep`.
export function exprU8Array(exprIx: i32, fnIx: i32) {
  exprListRep(exprIx, fnIx) == "u8list"
}

// The non-null list rep the expression at `exprIx` produces, or null when this cannot name one.
// The recorded type answers first, then the expression's shape. Each `expr*Array` predicate is
// this answer compared with one kind, so no two of them can claim one expression (D2275).
export function exprListRep(exprIx: i32, fnIx: i32): VKind | null {
  if exprIx < 0 { return null }
  if lrDepth == 0 { memoGenAdvance(lrGen) }
  if exprIx < lrMemoGen.length {
    if lrMemoGen[exprIx] == lrGen.at && lrMemoFn[exprIx] == fnIx {
      if lrMemoNul[exprIx] == 1 { return null }
      return lrMemoKind[exprIx]
    }
  }
  lrDepth = lrDepth + 1
  const k = exprListRepOf(exprIx, fnIx)
  lrDepth = lrDepth - 1
  if repShadowOn { repABNoteListRep(exprIx, fnIx, k) }
  while lrMemoGen.length <= exprIx {
    lrMemoGen.push(-1)
    lrMemoFn.push(-1)
    lrMemoKind.push("list")
    lrMemoNul.push(1)
  }
  lrMemoGen[exprIx] = lrGen.at
  lrMemoFn[exprIx] = fnIx
  if k == null {
    lrMemoNul[exprIx] = 1
  } else {
    lrMemoKind[exprIx] = k
    lrMemoNul[exprIx] = 0
  }
  k
}

// The oracle at this surface: the ladder's list rep against the pin-aware column (a nullable
// list's being its list's), noted only where they disagree; `unc` is a column the descriptor
// does not cover. The measurement is §13.10 of docs/internals/rep-descriptor-campaign.md.
function repABNoteListRep(exprIx: i32, fnIx: i32, k: VKind | null) {
  let lw = "none"
  if k != null { lw = k }
  const d = listColumnDesc(exprIx, fnIx)
  let cw = "unc"
  if d.rdCovered == 1 {
    cw = "none"
    const ck = listOfColumn(d)
    if ck != null { cw = ck }
  }
  if lw == cw || (lw == "none" && cw == "unc") { return 0 }
  const fam = listRepFamilyOf(exprIx, fnIx)
  if fam == "" { return 0 }
  repABNote(fam, lw, cw)
}

// The checked-rep column at the node `exprIx` in `fnIx`: its rep at its instance's type, or at
// its receiver's list for a read an `is K[]` narrowed (D4916).
function listColumnDesc(exprIx: i32, fnIx: i32): RepDesc {
  const nrt = listNarrowRecvTyOf(exprIx, fnIx)
  if nrt >= 0 { return repOfNodeAt(exprIx, nrt) }
  nodeRepIn(exprIx, fnIx)
}

// The non-null list a covered column `d` names, a nullable list's being its list's, or null.
function listOfColumn(d: RepDesc): VKind | null {
  if d.rdCovered != 1 { return null }
  const c = vkListClass(d.rdKind)
  if c == 1 { return d.rdKind }
  if c == 2 { return nulListBase(d.rdKind) }
  null
}

// The family a `listRep` disagreement is noted under: `listRep` where both sides answer the same
// question, else why they cannot. `/open` is a type no instance binds, `/scope` a local read
// with no live slot (§13.13). "" while instances are still being chosen: an open type then has
// no binding to read, since the ladder's answer is what picks one.
function listRepFamilyOf(exprIx: i32, fnIx: i32) {
  const ty = nodeTyInOf(exprIx, fnIx)
  if ty >= 0 && ty < T.tys.length && tyHasTyVar(ty) {
    if !emitPhaseReached("monomorphized") { return "" }
    if instanceBindsNothingClosed(ty, fnIx) { return "" }
    return "listRep/open"
  }
  if identReadOutOfScope(exprIx, fnIx) { return "listRep/scope" }
  "listRep"
}

// Whether `exprIx` reads a name that is no parameter, capture or module global of `fnIx` and
// has no live declared slot: a local asked about from outside its own emission.
function identReadOutOfScope(exprIx: i32, fnIx: i32) {
  const e = nodeAt(exprIx)
  if !(e is Ident) { return false }
  const n = e.identName
  if declaredSlotOf(exprIx) >= 0 || paramIndexOf(fnIx, n) >= 0 { return false }
  if capturedKindOf(fnIx, n) != null { return false }
  globalLetOfRead(fnIx, exprIx) < 0
}

// `exprListRep`'s answers during one outermost query, indexed by expression and stamped with
// that query's generation, so an answer never outlives the query that computed it. A global's
// initializer is asked once per list kind its declaration is tested for; without the memo a
// chain of global aliases costs that many times more per link. `lrMemoNul` 1 marks a null.
let lrDepth = 0

// `exprListRep` unmemoised. A recorded scalar, object, function or map type is no list, a call
// included: its record is this call's result. A recorded array over a primitive is
// its list unless a float literal or spread built another; a recorded `f64[]` yields to an f32
// shape, and the unpinned `i32[]` to any shape.
function exprListRepOf(exprIx: i32, fnIx: i32): VKind | null {
  // A node recorded at a type variable has the column's rep at its instance's bindings. Before
  // `monomorphize` binds one, a node still open there has no rep.
  const xraw = nodeTyIxOf(exprIx)
  let xty = xraw
  if (
    tyVarRowsMinted > 0
    && xraw >= 0
    && xraw < T.tys.length
    && lrRawHasTyVar(xraw)
  ) {
    xty = nodeTyInOf(exprIx, fnIx)
    const od = repOfNodeAt(exprIx, xty)
    if od.rdCovered == 1 && vkListClass(od.rdKind) == 1 { return od.rdKind }
    const open = xty < 0 || xty >= T.tys.length || tyHasTyVar(xty)
    if open && !emitPhaseReached("monomorphizing") { return null }
  }
  if exprIx >= 0 && xty >= 0 && xty < T.tys.length {
    const xt = tyAt(xty)
    // A nullable map is no list, whatever its binding's declaration spells.
    if xt is TyNullable {
      const inner = xt.nInner
      if inner >= 0 && inner < T.tys.length && tyAt(inner) is TyMap {
        return null
      }
    }
    // A nullable list is stored in its list's wrapper, so its rep is that list's, read off the
    // type at its instance whatever the read's spelling or slot.
    if xt is TyNullable || xt is TyUnion {
      const nd = repOfNodeAt(exprIx, xty)
      if nd.rdCovered == 1 && vkListClass(nd.rdKind) == 2 {
        return nulListBase(nd.rdKind)
      }
    }
  }
  // An `is K[]` arm reading an empty list of another element reads the arm's `K[]` (D4993).
  const fat = listFitArmTyOf(exprIx, fnIx)
  if fat >= 0 {
    const fd = repOfTy(fat)
    if fd.rdCovered == 1 && vkListClass(fd.rdKind) == 1 { return fd.rdKind }
  }
  // A read an `is K[]` narrowed keeps its receiver's list (D4916).
  const nrt = listNarrowRecvTyOf(exprIx, fnIx)
  if nrt >= 0 {
    const nd = repOfNodeAt(exprIx, nrt)
    if nd.rdCovered == 1 && vkListClass(nd.rdKind) == 1 { return nd.rdKind }
  }
  const pin = nodeTyPinIxOf(exprIx)
  const raw = nodeTyIxOf(exprIx)
  const e = nodeAt(exprIx)
  if pin >= 0 && pin == raw {
    const t = tyAt(pin)
    if t is TyPrim || t is TyObj || t is TyFunc || t is TyMap || t is TyLit {
      return null
    }
    // A union or nullable type the column holds as no list at its instance (a box, a nullable
    // scalar or struct) is no list, whatever its declaration, initializer or arms spell.
    if t is TyUnion || t is TyNullable {
      const ud = repOfTy(nodeTyInOf(exprIx, fnIx))
      if ud.rdCovered == 1 && vkListClass(ud.rdKind) == 0 { return null }
    }
  }
  const pk = tyPrimLeafListKind(pin)
  if pk == "strlist" || pk == "i64list" || pk == "u8list" { return pk }
  if pk == "f32list" {
    if !(e is ArrayLit || e is Index) { return pk }
  }
  if pk == "list" && pin == raw && !arrLitHasSpread(exprIx) { return pk }
  const rd = arenaRepOf(pin)
  // A union whose every member spells one list is that list (D4745).
  if pin >= 0 && oneListUnionRender(pin) != "" {
    if rd.rdCovered == 1 && vkListClass(rd.rdKind) == 1 { return rd.rdKind }
  }
  if rd.rdCovered == 1 && rd.rdKind == "f32list" {
    if !(e is ArrayLit || e is Index) { return "f32list" }
  }
  const a = arenaListRep(exprIx, pin, rd, fnIx)
  if a != null && a != "f64list" && a != "list" { return a }
  // A concat's recorded list is its rep, a ref list's included; its operands are not asked, so
  // a chain stays linear (D2275).
  if e is BinExpr {
    if e.binOp == "+" {
      if a != null { return a }
      if rd.rdCovered == 1 && rd.rdKind == "reflist" { return "reflist" }
    }
  }
  if valueUnionBoxList(exprIx, fnIx) { return "reflist" }
  // The column answers every node it covers at a type an instance binds; at an open type it
  // is asked again below, after the arena's own answer.
  const cd = listColumnDesc(exprIx, fnIx)
  if cd.rdCovered == 1 && listRepFamilyOf(exprIx, fnIx) != "" {
    return listOfColumn(cd)
  }
  const s = columnListRepOfRead(exprIx, fnIx)
  match a {
    "f64list" => {
      if s != "f32list" { return a }
    }
    "list" => {
      if s == null { return a }
    }
    // Every other arena answer is returned above; a null one takes the column's.
    "i32" | "struct" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "i64" | "f64" | "f32" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" | "v128" | null => {}
  }
  s
}

// `tyHasTyVar` of arena type `ty`, kept while the arena neither grows nor is written in place.
// `exprListRepOf` asks it of every node it is asked about, most of them the same few types.
function lrRawHasTyVar(ty: i32): boolean {
  let moved = memoMoved(lrTvKey, 0, tyMutEpoch)
  moved = memoMoved(lrTvKey, 1, T.tys.length) || moved
  if moved { memoGenAdvance(lrTvGen) }
  if ty < lrTvStamp.length && lrTvStamp[ty] == lrTvGen.at {
    return lrTvAns[ty] == 1
  }
  const r = tyHasTyVar(ty)
  while lrTvStamp.length <= ty {
    lrTvStamp.push(-1)
    lrTvAns.push(0)
  }
  lrTvStamp[ty] = lrTvGen.at
  lrTvAns[ty] = 0
  if r { lrTvAns[ty] = 1 }
  r
}

const lrTvKey = memoKeyNew(2)

const lrTvGen = memoGenNew(0)

const lrTvStamp: i32[] = []

const lrTvAns: i32[] = []

// Whether the node at `exprIx` is a list whose element type at its instance is a union the
// checked-rep column boxes. Every element is then a box, so the list is the ref list whatever
// its first element or its callee spells.
function valueUnionBoxList(exprIx: i32, fnIx: i32): boolean {
  if !tyMayInstUnionList(nodeTyIxOf(exprIx)) { return false }
  const ty = nodeTyInOf(exprIx, fnIx)
  const el = tyArrayElemIx(ty)
  if el < 0 || !(tyAt(el) is TyUnion) { return false }
  columnListRepAt(exprIx, ty) == "reflist"
}

// Whether a node recorded at `raw` can be a list of unions at some instance, read off its head
// (D5065): binding a type variable keeps a record, function, map or nullable head, and a
// union is kept, since its members can collapse onto one list.
function tyMayInstUnionList(raw: i32): boolean {
  if raw < 0 || raw >= T.tys.length { return false }
  const t = tyAt(raw)
  match t {
    TyArray => {
      const el = t.aElem
      if el < 0 || el >= T.tys.length { return false }
      const et = tyAt(el)
      et is TyUnion || et is TyVar
    }
    TyVar | TyUnion | TyNeg => true
    TyPrim | TyErr | TyObj | TyFunc | TyMap | TyLit | TyNullable => false
  }
}

// Whether a node recorded at `raw` can be a union at some instance, read off the head alone;
// true where nothing is recorded.
function tyMayInstUnion(raw: i32): boolean {
  if raw < 0 || raw >= T.tys.length { return true }
  const t = tyAt(raw)
  match t {
    TyVar | TyUnion | TyNullable | TyNeg | TyErr | TyObj => true
    TyPrim | TyFunc | TyMap | TyLit | TyArray => false
  }
}

// `exprListRep`'s last rung: the column at the node, a grouped read's through its parens, for a
// node the earlier rungs leave. Every list-bearing expression reads it, so a list rep is always
// its type's; any other node has none.
function columnListRepOfRead(exprIx: i32, fnIx: i32): VKind | null {
  const e = nodeAt(exprIx)
  match e {
    Paren => {
      return exprListRep(e.parInner, fnIx) ?? columnListRep(exprIx, fnIx)
    }
    ArrayLit | Ident | Member | IfStmt | Call | Index | BinExpr | OptMember => {
      return columnListRep(exprIx, fnIx)
    }
    // Every other expression answers no list here.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  null
}

// True if `exprIx` evaluates to an `f32[]`: a projection of `exprListRep`.
export function exprF32Array(exprIx: i32, fnIx: i32) {
  exprListRep(exprIx, fnIx) == "f32list"
}

// True if `exprIx` evaluates to an `i64[]`: a projection of `exprListRep`.
export function exprI64Array(exprIx: i32, fnIx: i32) {
  exprListRep(exprIx, fnIx) == "i64list"
}

// True if the `LetDecl` at `letIx` declares an `f64[]` local: its annotation is `f64[]`,
// OR its initializer produces an f64 list. Picks the local's valtype (`(ref $fl64TypeIdx)`)
// and the code-`12` flag in `collectLocals`.
export function letIsF64Array(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      // Arena-first: a covered annotation's kind is the authority the three name tests below
      // spell out — nothing else can reach the init fallback wrongly.
      const k = annRepKindOf(d.letType)
      if k != null {
        if k == "f64list" { return true }
        if k == "reflist" { return false }
        if k == "f32list" { return false }
      } else {
        const lt = nodeAt(d.letType)
        if lt is TypeRef {
          if nameIsF64Array(lt.tyName) { return true }
          // A ref-array annotation (union-box elements) is authoritative: the float-literal
          // init must not claim a scalar f64 list when the slot is a kind-2 ref list.
          if annBareRefArrSlot(d.letType) >= 0 { return false }
          // An `f32[]` annotation is authoritative too — without this, a global `const a:
          // f32[] = [1.5]` double-claimed both kinds and routed `.push` through the wrong frame.
          if nameIsF32Array(lt.tyName) { return false }
        }
      }
    }
    return exprF64Array(d.letInit, fnIx)
  }
  false
}

// True if evaluating the expression at `exprIx` yields a nullable map ref (`{[string]: V} | null`,
// kind `nulmap`) — a nulmap-annotated param / local / global reference, or a nulmap-returning call.
// The map analogue of `exprNullableStruct` / `exprNullableRefArray`: the `!= null` narrow reads the
// `(ref null $mapStruct)` niche, and the narrowed map ops recover it non-null at the receiver.
export function exprNullableMap(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = nodeAt(exprIx)
  match e {
    Paren => {
      return exprNullableMap(e.parInner, fnIx)
    }
    AsExpr => {
      if asUnionMapTy(exprIx, fnIx, true) >= 0 { return true }
    }
    // Every other expression is resolved by the rungs below.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  // …and the same `if` whose arm is itself nullable — see `nulIfArmNullableValueIx` (D1560).
  const nlIfM = nulIfArmNullableValueIx(exprIx)
  if nlIfM >= 0 {
    if exprNullableMap(nlIfM, fnIx) { return true }
  }
  // An if-EXPRESSION with a NULL arm over a map arm — see `nulArmIfThenValueIx`.
  const elIfM = nulArmIfThenValueIx(exprIx, fnIx)
  if elIfM >= 0 { return exprMap(elIfM, fnIx) }
  match e {
    Index => {
      // The map read (D1038/D1039), the sibling of `exprNullableList`'s map arm: one arm covers
      // both the inline `if m[k] != null` test and the un-annotated `const g = m[k]` binding.
      const mvSh = mapShapeOfExpr(e.idxArr, fnIx)
      if mvSh >= 0 && mvSh < mvValName.length {
        if nameIsBareMap(mvValName[mvSh]) { return true }
      }
      // An INDEX into a nullable-map array (`({[string]: V} | null)[]`, element kind 3 with the
      // nullable bit): the element legitimately holds null — `const e = xs[i]` binds `nulmap`.
      if exprRefArray(e.idxArr, fnIx) {
        const slot = refListSlotOfExpr(e.idxArr, fnIx)
        if slot >= 0 && slot < rlElemNullable.length {
          if rlElemKindTbl[slot] == RLK_MAP && rlElemNullable[slot] == 1 {
            return true
          }
        }
      }
      const mnm = mapReadMvSlot(exprIx, fnIx)
      if mnm >= 0 { return mvValIsMap(mnm) && mvSlotNullable(mnm) }
    }
    Ident | Member => {
      return exprNulKind(exprIx, fnIx) == "nulmap"
    }
    BinExpr => {
      // A read over a nullable-inner-map-valued map yields `map | null` — the fused `?? d` hit
      // arm preserves a stored null, and a bare `m[k]` is nullable by construction.
      const cnm = coalesceMvSlot(exprIx, fnIx)
      if cnm >= 0 {
        return mvValIsMap(cnm) && coalesceStaysNullable(exprIx, cnm, fnIx)
      }
    }
    Call => {
      // A call whose ANNOTATED return is `{[string]: V} | null` yields a nullable map, so an
      // un-annotated `const t = mk(…)` infers kind `nulmap` and narrows with `if t != null`.
      if e.callFn < 0 { return false }
      const callee = nodeAt(e.callFn)
      if callee is Ident {
        const target = fnIndexOfNode(e.callFn)
        if target >= 0 {
          const fn = nodeAt(fnStmts[target])
          if fn is FuncDecl {
            if fn.fnRet >= 0 { return retNulMapFlag(fn.fnRet) == 1 }
            // The inferred return too, off the kind column `buildFnMap` recorded: without it a
            // caller's `const r = pick(…)` bound a non-null cell with nothing to narrow against. D937.
            return repOfFnSlot(target).rdKind == "nulmap"
          }
        }
        return calleeRetKindOfRead(e.callFn, fnIx) == "nulmap"
      }
      return cloValueCallRetKind(exprIx, fnIx) == "nulmap"
    }
    // No other expression is a nullable map by its own form.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// A read whose recorded rep is a map cell, nullable or not: a narrowed read recovers non-null at
// the read, and an un-narrowed one reaches only value positions that take the nullable ref.
function readRepIsMapCell(exprIx: i32, fnIx: i32): boolean {
  const rd = repOfNode(exprIx, fnIx)
  rd.rdCovered == 1 && (rd.rdKind == "map" || rd.rdKind == "nulmap")
}

// True if evaluating the expression at `exprIx` yields a string-keyed map: the
// `Map()` constructor call, a map param/local reference, or a parenthesized map
// expression.
export function exprMap(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  // A union of maps delivered as one map reads as that map (`emitMapUnionPayload`).
  if mapDeliveryRecorded && mapUnboxTyOf(exprIx) >= 0 { return true }
  const e = nodeAt(exprIx)
  match e {
    Paren => {
      return exprMap(e.parInner, fnIx)
    }
    IfStmt => {
      // A value `if` whose join lowers at the map rep (D2663).
      return ifExprRefKind(exprIx, fnIx) == "map"
    }
    BinExpr => {
      // An assignment's value is its target cell, as `exprUnion` states it (D2602).
      if e.binOp == "=" {
        const mar = asgReadNode(exprIx, fnIx)
        if mar != exprIx { return exprMap(mar, fnIx) }
      }
      // A nullable map with a map default is the non-null map (D3257).
      if e.binOp.length == 2 && coalesceOfNulMapIsMap(e, exprIx, fnIx) {
        return true
      }
      // `outer[k] ?? d` over a NESTED map (value kind 6) yields the inner Map ref — so a
      // chained `(outer[k] ?? d)[j]` routes through the map lowering.
      const cmm = coalesceMvSlot(exprIx, fnIx)
      if cmm >= 0 {
        // A NULLABLE inner-map value with a NULLABLE default yields `map | null` —
        // `exprNullableMap` claims that; a non-null default coalesces to the non-null map.
        if mvValIsMap(cmm) && !coalesceStaysNullable(exprIx, cmm, fnIx) {
          return true
        }
      }
    }
    AsExpr => {
      if asUnionMapTy(exprIx, fnIx, false) >= 0 { return true }
    }
    Call => {
      if e.callFn < 0 { return false }
      const callee = nodeAt(e.callFn)
      // A `Set()` is a boolean-valued string map — the same struct — treated as a map
      // throughout; a named function returning a map (`fnRetMap`) yields one too.
      match callee {
        Ident => {
          if callee.identName == "Map" || callee.identName == "Set" {
            return true
          }
          if (
            fnRetMapSid(sidOfNode(e.callFn), callee.identName, fnIx, e.callFn)
          ) {
            return true
          }
        }
        Member => {
          // `scopes.pop()` over a map ref list (`{[string]:i32}[]`) yields a Map ref.
          if callee.memProp == "pop" {
            if exprRefArray(callee.memObj, fnIx) {
              const slot = refListSlotOfExpr(callee.memObj, fnIx)
              if slot >= 0 && slot < rlElemKindTbl.length {
                return rlElemKindTbl[slot] == RLK_MAP
              }
            }
          }
        }
        // Any other callee falls to the recorded-type fallback below.
        NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
      }
      // Fallback: a map-returning closure-value/factory call the syntactic cases miss — the map
      // dual of `structIndexOfExpr`'s `nodeTyIsObj` fallback, off the checker's recorded type.
      if nodeTyIsMap(exprIx) { return true }
      return false
    }
    Ident => {
      // A union binding narrowed to a map arm unboxes to the map struct ref, so it is a map in
      // the narrowed branch — checked first, ahead of its declared type.
      if identReadContainerAt(exprIx, fnIx) == RC_MAP { return true }
      if paramMap(fnIx, exprIx) { return true }
      const gmr = identReadsGlobal(exprIx)
      if !gmr && declaredMap(exprIx) { return true }
      if globalReadIsMap(fnIx, exprIx) { return true }
      // A captured map variable of a lifted lambda: classify it exactly as a param/local
      // receiver would, so it takes the map-arm boxing in a union-boxed result.
      if capturedKindOf(fnIx, e.identName) == "map" { return true }
      // Last, after every resolver that can speak sooner: the frame's own `let`, read from the
      // arena rather than the declared-locals table, so a cross-frame question answers.
      const fmm = frameLetOf(fnIx, exprIx)
      if fmm >= 0 && letIsMap(fmm, fnIx) { return true }
      return readRepIsMapCell(exprIx, fnIx)
    }
    Member => {
      // A MAP-typed struct field read (`node.children`, code 19) yields a Map ref —
      // map member/index ops on it route to the existing map lowering.
      // A union-box field narrowed to a map arm unboxes to the map struct ref — the Ident
      // arm's rule at the one receiver shape that never had it. D1014.
      if placeReadContainerAt(exprIx, fnIx) == RC_MAP { return true }
      if memFieldTypeCode(exprIx, fnIx) == FC_MAP { return true }
      if readRepIsMapCell(exprIx, fnIx) { return true }
    }
    Index => {
      // A union-box ELEMENT whose index PLACE is narrowed to a MAP arm (`if xs[0] is {[string]:
      // K}`) — the index twin of the Member arm above (D1014).
      if placeReadContainerAt(exprIx, fnIx) == RC_MAP { return true }
      // `scopes[i]` over a map ref list yields a Map ref, per-slot; a bare `outer[k]` over a
      // nested map likewise yields the inner Map.
      if exprRefArray(e.idxArr, fnIx) {
        const slot = refListSlotOfExpr(e.idxArr, fnIx)
        // Bound-checked before the read: `refListSlotOfExpr` falls back to slot 0 for an
        // un-interned element name, so an unguarded read is a compiler-internal OOB trap.
        if slot >= 0 && slot < rlElemKindTbl.length {
          // A NULLABLE map element (`({[string]: V} | null)[]`) yields `map | null` —
          // `exprNullableMap`'s element arm claims it, not this non-null arm.
          return rlElemKindTbl[slot] == RLK_MAP && rlElemNullable[slot] == 0
        }
      }
      const mri = mapReadMvSlot(exprIx, fnIx)
      if mri >= 0 {
        // A bare read of a NULLABLE inner-map value stays `map | null` — `exprNullableMap`'s.
        if mvValIsMap(mri) && !mvSlotNullable(mri) { return true }
      }
    }
    // No other expression is a map by its own form.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// True if the `LetDecl` at `letIx` declares a map-typed local: its annotation is a map
// type (`{[string]: i32}`), OR its initializer produces a map (`Map()`). Picks the
// local's valtype (`(ref $mStructIdx)`) and the code-`6` flag in `collectLocals`.
export function letIsMap(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = nodeAt(d.letType)
      if lt is TypeRef {
        // Arena-first: a `TyMap` is a map however it renders, subsuming both `nameIsMap` and
        // its map-member-union exclusion, without splitting the name into top-level atoms.
        const k = annRepKindOf(d.letType)
        if k != null {
          if k == "map" { return true }
        } else if nodeTyIsMap(d.letType) {
          // The rep is uncovered but the type is not: `nodeTyIsMap` answers the strictly
          // weaker "is this annotation a map at all", the arena fallback one variant tag down.
          return true
        }
        // Any registered union annotation carrying a bare map arm is a union-box local whose
        // init is that arm — authoritative, so the map fall-through can't reclaim it as bare.
        if isUNameAnnAB(6, d.letType) { return false }
      }
    }
    return exprMap(d.letInit, fnIx)
  }
  false
}

// True if the `LetDecl` at `letIx` declares a NULLABLE map local (`{[string]: V} | null`,
// kind `nulmap`): an annotated one by its annotation's rep alone, an unannotated one by its
// initializer (a nulmap passthrough, or a nulmap-returning call). Checked BEFORE `letIsMap` in
// the collect ladder so a nullable init does not collapse to the non-null kind `"map"`.
export function letIsNulMap(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      return retNulMapFlag(d.letType) == 1
        || annRepKindOf(d.letType) == "nulmap"
    }
    return exprNullableMap(d.letInit, fnIx)
  }
  false
}
// The map SHAPE code of a nulmap-typed `LetDecl` (the same vocabulary as `letMapShapeOf`:
// `-2` Set, mv slot >= 0, `-1` mono, `-3` unsupported). Annotation-first (the `| null`-aware
// `mapAnnShape`), else the nulmap initializer's shape.
export function nulMapShapeOf(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      if retNulMapFlag(d.letType) == 1 { return mapAnnShape(d.letType) }
    }
    return mapShapeOfExpr(d.letInit, fnIx)
  }
  -1
}

// The map shape code of a map-typed `LetDecl`: `-2` a Set, an mv slot (>= 0) for a
// ref-valued map, `-1` the mono i32 map, `-3` an unsupported value type (op sites fail
// loudly). Annotation-first, else the initializer's shape (a `Map()`/`Set()` constructor,
// or a map-typed passthrough).
export function letMapShapeOf(letIx: i32, fnIx: i32) {
  if letIsSet(letIx, fnIx) {
    // The Set flavor of the i32-keyed rep (`-5`): a Set is a boolean-valued map, so it
    // is mono either way — the sentinel is what keeps `.values()` yielding ELEMENTS.
    const lk = letMapKeyKind(letIx)
    if lk == MAP_KEY_I32 { return -5 }
    if lk == MAP_KEY_I64 { return -7 }
    return -2
  }
  if letIx < 0 { return -1 }
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = nodeAt(d.letType)
      if lt is TypeRef {
        // A map-member union annotation is not a bare map — skip it so the union box is
        // picked. The value must resolve by its nominal arena type, not the rendered spelling.
        if nodeTyIsMap(d.letType) {
          const tsh = mvShapeOfMapHeldTy(
            lt.tyName,
            nodeTyIxOf(d.letType),
            nodeMapValTyIx(d.letType),
            nodeMapValTyIx(d.letType),
          )
          if tsh != -3 { return tsh }
        }
      }
    }
    // A `Map()` whose values are delivered to a record storing a field differently is built
    // at that record's storage, so the delivery is a reference.
    const bv = recBuildElemTyOf(letIx)
    if d.letType < 0 && bv >= 0 {
      const bs = mvSlotOfValTyK(bv, letMapKeyKind(letIx))
      if bs >= 0 { return bs }
    }
    return mapShapeOfExpr(d.letInit, fnIx)
  }
  -1
}

// `mapShapeOfExpr` of a composition map read (a nested-map read, or a list-of-maps element)
// yielding a typed-value map; `-1`, the mono map, otherwise.
function mapShapeOfComposition(exprIx: i32, fnIx: i32): i32 {
  const cms2 = compositionMapReadSlot(exprIx, fnIx)
  if cms2 != -2 { return cms2 }
  -1
}

// `mapShapeOfExpr` of a map-typed field read `e`: the field row's (key, value) pair, across
// narrowed, variant and plain-struct receivers, else the composition read's.
function mapShapeOfMember(exprIx: i32, e: Member, fnIx: i32): i32 {
  // The member path's own narrowing to a map arm (D1014): its shape is the arm's value
  // type, ahead of the receiver-narrowing arm below (which would fall to the mono `-1`).
  if placeReadContainerAt(exprIx, fnIx) == RC_MAP {
    return readMapArmShapeAt(exprIx, fnIx)
  }
  const nvi = memNarrowVariantIndex(exprIx, fnIx)
  if nvi >= 0 {
    const nvfi = variantFieldIndex(nvi, e.memProp)
    if nvfi >= 0 {
      const nvc = variantFieldTypeAt(nvi, nvfi)
      if nvc == FC_MAP || nvc == FC_NUL_MAP { return uFieldMapShape(nvi, nvfi) }
    }
  }
  const pvi = exprVariantIndex(e.memObj, fnIx)
  if pvi >= 0 {
    const pvfi = variantFieldIndex(pvi, e.memProp)
    if pvfi >= 0 {
      const pvc = variantFieldTypeAt(pvi, pvfi)
      if pvc == FC_MAP || pvc == FC_NUL_MAP { return uFieldMapShape(pvi, pvfi) }
    }
  }
  const msi = structIndexOfExpr(e.memObj, fnIx)
  if msi >= 0 {
    const mfi = sFieldIndex(msi, e.memProp)
    if mfi >= 0 {
      const mfc = sFieldTypeAt(msi, mfi)
      if mfc == FC_MAP || mfc == FC_NUL_MAP { return sFieldMapShape(msi, mfi) }
    }
  }
  mapShapeOfComposition(exprIx, fnIx)
}

// The map shape code of a map-typed expression (the receiver of a map op): `-2` Set, an mv
// slot >= 0, `-1` mono, `-3` unsupported. Mirrors `exprMap`'s resolution chain: constructor
// calls, locals, globals, and the mono-only map-array element / `.pop()` forms. Map-typed
// params stay mono-only — a ref-valued map cannot cross a call boundary.
export function mapShapeOfExpr(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  if mapDeliveryRecorded {
    const mub = mapUnboxTyOf(exprIx)
    if mub >= 0 { return mapArmShapeOfTy(mub) }
  }
  const e = nodeAt(exprIx)
  if e is Paren { return mapShapeOfExpr(e.parInner, fnIx) }
  if e is BinExpr {
    if e.binOp == "=" {
      const msr = asgReadNode(exprIx, fnIx)
      if msr != exprIx { return mapShapeOfExpr(msr, fnIx) }
    }
    if e.binOp.length == 2 && coalesceOfNulMapIsMap(e, exprIx, fnIx) {
      const cls = mapShapeOfExpr(e.binLeft, fnIx)
      if cls != -3 { return cls }
      return mapShapeOfTyPeeled(nodeTyIxOf(e.binLeft))
    }
  }
  // A value `if`: the shape of the arm its join's rep is read off, as `ifExprRefSlot` does.
  if e is IfStmt { return mapShapeOfExpr(ifRepArmValueIx(exprIx), fnIx) }
  // A set-typed expression is the set shape whatever produced it: the flavor is the TYPE's
  // (`mSet`), so a set reached through a parameter, field or call walks its elements too.
  const sst = setShapeOfTy(nodeTyAt(exprIx, fnIx))
  if sst != 0 { return sst }
  if e is AsExpr {
    let amt = asUnionMapTy(exprIx, fnIx, false)
    if amt < 0 { amt = asUnionMapTy(exprIx, fnIx, true) }
    if amt >= 0 {
      const ast = setShapeOfTy(amt)
      if ast != 0 { return ast }
      return mapArmShapeOfTy(amt)
    }
  }
  if e is Call {
    if e.callFn < 0 { return -1 }
    const callee = nodeAt(e.callFn)
    if callee is Ident {
      if callee.identName == "Set" {
        const sk = nodeTyMapKeyKind(exprIx)
        if sk == MAP_KEY_I32 { return -5 }
        if sk == MAP_KEY_I64 { return -7 }
        return -2
      }
      // A map-returning function yields its declared map SHAPE (mono ⇒ -1, or a `string`-valued
      // map's mv slot); a `Map()` constructor is the mono map (-1).
      const fe = fnIndexOfNode(e.callFn)
      if fe >= 0 { return fnRetMapShapeAt(sidOfNode(e.callFn), exprIx) }
    }
    // A call through a function value lands in its `$fnsig` result's map shape.
    const vrk = cloValueCallRetKind(exprIx, fnIx)
    if vrk == "map" || vrk == "nulmap" {
      return sigKeyRetSlot(cloCallSigKey(exprIx, fnIx))
    }
    if callee is Ident && fnIndexOfNode(e.callFn) < 0 {
      const ivk = calleeRetKindOfRead(e.callFn, fnIx)
      if ivk == "map" || ivk == "nulmap" {
        return sigKeyRetSlot(calleeCloSigKeyOfRead(e.callFn, fnIx))
      }
    }
    // An i32-keyed constructor/factory result: the key comes off the call's own recorded
    // type, paired with the value below rather than short-circuiting to the mono sentinel.
    const ckK = nodeTyMapKeyKind(exprIx)
    // Fallback: a map-returning closure-value/factory call the syntactic path misses — resolve
    // from the checker's recorded map value type, mirroring the `exprMap` fallback.
    if nodeTyIsMap(exprIx) { return mapFindShapeOfNodeTy(exprIx) }
    return mapMonoShapeOfKey(ckK)
  }
  if e is Ident {
    // A union binding narrowed to a map arm resolves its shape from the arm the narrowing
    // banks, checked first ahead of declaredMap/paramMap.
    if identReadContainerAt(exprIx, fnIx) == RC_MAP {
      return readMapArmShapeAt(exprIx, fnIx)
    }
    const gms = identReadsGlobal(exprIx)
    if !gms && declaredMap(exprIx) {
      const slot = declaredSlotOf(exprIx)
      if slot >= 0 { return localStructIdx[slot] }
      return -1
    }
    // A map param's shape is its annotation's value type — so the body's map ops resolve
    // the param's value type, not the mono i32 assumption a bare -1 would force.
    if paramMap(fnIx, exprIx) { return paramMapShape(fnIx, e.identName) }
    // A nullable map binding narrowed non-null — its shape is the `| null`-stripped value
    // type, resolved from the local slot or the param annotation.
    if !gms && declaredNulMap(exprIx) {
      const nslot = declaredSlotOf(exprIx)
      if nslot >= 0 { return localStructIdx[nslot] }
      return -1
    }
    if (paramNulMap(fnIx, exprIx)) { return paramMapShape(fnIx, e.identName) }
    // A captured map variable resolves its shape from the parent frame's binding — both a
    // `Param` and a `LetDecl`, else a captured map param reads mono `-1` against a typed field.
    if capturedKindOf(fnIx, e.identName) == "map" {
      const cfe = fnStmtsPosOf(fnIx)
      if cfe >= 0 {
        const cb = parentBindingOf(cfe, e.identName)
        if cb >= 0 {
          const cbn = nodeAt(cb)
          if cbn is Param { return mapAnnShape(cbn.parType) }
          if cbn is LetDecl {
            // The annotation first, then the owning frame as an ARENA index — the same two
            // rungs, in the same order, the env field's own resolver uses. A module-frame
            // block binding's arena frame is -1, which `letMapShapeOf` reads, while the
            // `fnStmts` position it has none of would answer the mono map (D1861).
            if cbn.letType >= 0 { return mapAnnShape(cbn.letType) }
            return letMapShapeOf(
              cb,
              parentBindingFrameArenaOf(cfe, e.identName),
            )
          }
        }
      }
      return -1
    }
    // A captured nullable map narrowed non-null — the `| null` twin of the arm above, for a
    // storage class the local/param resolvers can't reach (the binding lives in another frame).
    if capturedKindOf(fnIx, e.identName) == "nulmap" {
      return capturedNulMapShape(fnIx, e.identName)
    }
    // The frame's own `let`, arm for arm with the module-frame leg below it — a kind
    // without its shape is a different reject, so the two land together.
    const fms = frameLetOf(fnIx, exprIx)
    if fms >= 0 {
      if letIsMap(fms, fnIx) { return letMapShapeOf(fms, fnIx) }
      if letIsNulMap(fms, fnIx) { return nulMapShapeOf(fms, fnIx) }
    }
    const gl = globalLetOfRead(fnIx, exprIx)
    if gl >= 0 {
      if letIsMap(gl, -1) { return letMapShapeOf(gl, -1) }
      if letIsNulMap(gl, -1) { return nulMapShapeOf(gl, -1) }
    }
  }
  // A map-typed struct field read: the shape is the field row's (key, value) pair, mirroring
  // `memberFieldCode`'s receiver dispatch across narrowed/variant/plain-struct receivers.
  if e is Member { return mapShapeOfMember(exprIx, e, fnIx) }
  // The index place's own narrowing to a map arm (D1014) — ahead of the composition read
  // below, whose answer describes the cell rather than the narrowed arm.
  if e is Index {
    if placeReadContainerAt(exprIx, fnIx) == RC_MAP {
      return readMapArmShapeAt(exprIx, fnIx)
    }
  }
  // A composition map read yielding a typed-value map (a nested-map read, or a list-of-maps
  // element): without this, the binding fell to the mono map and its cell rejected the read.
  mapShapeOfComposition(exprIx, fnIx)
}

// The mv slot of the map a composition read yields, `-1` for a mono/atom-valued map (rides
// the shared `$mStructIdx`), or `-2` when the expression is not a composition map read at
// all. Two shapes: a nested-map read (the receiver's vals element), or a list-of-maps
// element read (the ref-list element itself).
function compositionMapReadSlot(exprIx: i32, fnIx: i32): i32 {
  // Nested-map read: resolve the receiver's mv slot, then its inner map value.
  let os = coalesceMvSlot(exprIx, fnIx)
  if os < 0 { os = mapReadMvSlot(exprIx, fnIx) }
  if os >= 0 && mvValIsMap(os) { return rlElemMapValMvSlot(mvRlSlot[os]) }
  // List-of-maps element read: the element name is the map type; its value picks the slot.
  const e = nodeAt(unwrapParen(exprIx))
  if e is Index {
    if exprRefArray(e.idxArr, fnIx) {
      const slot = refListSlotOfExpr(e.idxArr, fnIx)
      if (
        slot >= 0
        && slot < rlElemKindTbl.length
        && rlElemKindTbl[slot] == RLK_MAP
      ) {
        // A NULLABLE map element strips to its inner map for the value-slot resolve.
        return rlElemNulMapValMvSlot(slot)
      }
    }
  }
  -2
}

// ── string-typedness of expressions ─────────────────────────────────────────────

// Parallel to the array family above: decide whether an expression / param / local
// produces a `string` (currently the same `(array (mut i32))` of code points an array is
// — `docs/strings-design.md`). Like the array family, a `.length`/index read yields an i32.

// True if the function `name` declares `string` as its return type. The `fromCodePoint`
// builtin (H2) constructs a single-character VL string, so it is `string`-returning too —
// classifying it here routes `value + fromCodePoint(cp)` to string concat and
// `let s = fromCodePoint(n)` to a string local, exactly as a user function would.
function fnRetStringSid(sid: i32, name: string, fnIx: i32, at: i32) {
  // The builtin string producers are recognized by spelling, not the function table
  // — `sidText` reads the spelling back out of the intern table, faithful since callers mint.
  const spelled = sidText(sid)
  if spelled == "fromCodePoint" { return true }
  if spelled == "fromCodePoints" { return true }
  if spelled == "__str_from_bytes__" { return true }
  repOfNameResult(sid, name, fnIx, at).rdKind == "str"
}

// The wasm-type code (`0` i32/bool, `3` string, `4` i32[], `5` ref list, `6` string list)
// of the field a `Member` access reads, resolving the receiver through the three
// field-bearing shapes — a narrowed union local, a variant-typed value, or a plain struct —
// or -1 otherwise. The one place `exprString`/`exprStruct`/`exprArray`/`exprMap` consult.
export function memberFieldCode(memIx: i32, fnIx: i32) {
  const e = nodeAt(memIx)
  if e is Member {
    // Only a narrowing that names a VARIANT re-homes the field onto the variant tables; one
    // that does not leaves the receiver at its own shape, so it falls through to the rungs
    // below rather than answering -1. A place narrowed to a plain struct is that case, and
    // its `string` field read then classified as an i32 at `print` (D1735).
    const vi = memNarrowVariantIndex(memIx, fnIx)
    if vi >= 0 {
      const vfi = variantFieldIndex(vi, e.memProp)
      if vfi >= 0 { return variantFieldTypeAt(vi, vfi) }
      return -1
    }
    const pvi = exprVariantIndex(e.memObj, fnIx)
    if pvi >= 0 {
      const pvfi = variantFieldIndex(pvi, e.memProp)
      if pvfi >= 0 { return variantFieldTypeAt(pvi, pvfi) }
      return -1
    }
    // The fifth receiver shape, in lock-step with the twin above.
    const nvi5 = memRecvNulVariantIndex(e.memObj, fnIx)
    if nvi5 >= 0 {
      const nvfi5 = variantFieldIndex(nvi5, e.memProp)
      if nvfi5 >= 0 { return variantFieldTypeAt(nvi5, nvfi5) }
      return -1
    }
    const si = structIndexOfExpr(e.memObj, fnIx)
    if si >= 0 {
      const fi = sFieldIndex(si, e.memProp)
      if fi >= 0 { return sFieldTypeAt(si, fi) }
    }
    // The fourth receiver shape: an un-narrowed struct union whose members all carry the
    // field at one code (`(A | B).tag`) — without it, a shared read classified as i32.
    const uvis: i32[] = []
    const ufis: i32[] = []
    const ucode = sharedUnionFieldPlan(
      e.memObj,
      e.memProp,
      memIx,
      fnIx,
      uvis,
      ufis,
    )
    if ucode >= 0 { return ucode }
  }
  -1
}

// True if evaluating the expression at `exprIx` yields a string: a string literal, a
// `string`-returning call, a string param/local reference, or a parenthesized string
// expression. An index read / `.length` yields an i32, so neither counts.
export function exprString(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = nodeAt(exprIx)
  match e {
    StrLit => {
      return true
    }
    Paren => {
      return exprString(e.parInner, fnIx)
    }
    // `x as T` yields exactly `T`, asked of that recorded type rather than the operand — the
    // point of the cast. A numeric cast lands here too and correctly answers false.
    AsExpr => {
      if e.asMode != "null" && asExprLitAtomYieldsStr(exprIx, fnIx) {
        return true
      }
      return nodeRepIs(exprIx, "str", fnIx)
    }
    // An if-expression whose branch join is a string: the checker proved both arms agree, so
    // the join's type (or the then-arm) classifies the whole `if` as kind 3, matching the emit.
    IfStmt => {
      // The join's checked type is arm-order-independent: a `string`-typed join may lead with
      // an atom arm, which widens at `emitRefIfArm` — so the value is still a string.
      if nodeRepIs(exprIx, "str", fnIx) { return true }
      // Inside an instance a join over its type parameters is read at the pin (D3528).
      const sjt = nodeTyAt(exprIx, fnIx)
      if sjt >= 0 && tyHasTyVar(sjt) {
        const sjs = pinSubOperandTyOf(sjt, fnIx)
        if sjs >= 0 { return tyKindOf(sjs) == TK_STR }
      }
      // A join the checker kept as a value union is that union's box, whatever its then arm
      // is, so a string then arm does not make the `if` a string (D2839).
      if tyIsValueUnionBox(nodeTyAt(exprIx, fnIx)) { return false }
      // The arm-read of that same signal, for the body where the recorded join type is one
      // arm's — the three sites this one decision moves through (`ifExprRefKind`,
      // `exprHasStrOp`, here), or the rep and its readers disagree.
      if ifJoinAtomMeetsString(exprIx, fnIx) { return true }
      const tv = ifThenValueIx(exprIx)
      return tv >= 0 && exprString(tv, fnIx)
    }
    Call => {
      // G6: `s.slice(...)` over a string receiver produces a string. Otherwise a
      // bare call produces a string iff the callee declares a `string` return.
      if exprIsStrMethod(exprIx, fnIx, "slice") { return true }
      if popTakesElem(exprIx) {
        return exprStringArray(popRecvOf(exprIx), fnIx)
      }
      // An INDEXED closure call `fs[i](x)` whose element signature returns `string`.
      if cloArrCallRetKind(exprIx, fnIx) == "str" { return true }
      // A call through a tagged set is its member calls, typed at this call by the checker.
      if fnTagCallArms(exprIx).length > 0 {
        return nodeRepIs(exprIx, "str", fnIx)
      }
      if e.callFn < 0 { return false }
      const callee = nodeAt(e.callFn)
      if callee is Ident {
        if (
          fnRetStringSid(sidOfNode(e.callFn), callee.identName, fnIx, e.callFn)
        ) {
          return true
        }
        // A string-returning function value's resolved `>S` sig, except an aliased litunion
        // call whose checker type softens to `string` while `call_ref` reps the i32 atom.
        if calleeReturnsStringOfRead(e.callFn, fnIx) {
          if !nodeTyIsLitUnionAlias(exprIx) { return true }
        }
      }
      // A value call the generic body shares, typed at a hole this instance pins (D3117), through
      // a name or a field no closure literal of that signature reaches (D3203).
      if callee is Ident || callee is Member {
        if tyKindOf(holeOperandTyOf(exprIx, fnIx)) == TK_STR {
          if sigKeyRetKind(cloCallSigKey(exprIx, fnIx)) == "str" { return true }
        }
      }
      // A string-returning FIELD-closure call (`o.label(3)` over a `(i32) => string` field).
      if callee is Member {
        const ffe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
        if ffe >= 0 {
          // Except an aliased litunion whose checker type softens to `string`: same-fieldset
          // twin rows can alias onto the OTHER row's string-result lambda (invalid wasm otherwise). #991.
          if repOfFnSlot(ffe).rdKind == "str" {
            if nodeTyIsLitUnionAlias(exprIx) { return false }
            // A `{f: (…) => string}` field beside a boolean twin collapses to one layout heap
            // type, so trust the checker's recorded result type over the fe's kind when present.
            const nts = nodeTyIxOf(exprIx)
            // Only when the checker actually resolved it: an un-annotated param's recorded type
            // may still be a type variable, which is an absence of an opinion, not a disagreement. D976.
            if nts >= 0 {
              if !tyHasTyVar(nts) {
                return tyKindOf(nts) == TK_STR || tyIsBareStrLit(nts)
              }
            }
            return true
          }
          return false
        }
      }
      // A closure-value call whose sig the per-name resolvers can't key: resolve it the same way
      // the emitter does, gated on the checker's plain-`string` result to exclude litunion aliases.
      if nodeRepIs(exprIx, "str", fnIx) {
        if sigKeyRetKind(cloCallSigKey(exprIx, fnIx)) == "str" { return true }
      }
      // …and a lone string literal result, whose function type returns the string ref (D8001).
      if tyIsBareStrLit(nodeTyAt(exprIx, fnIx)) {
        if sigKeyRetKind(cloCallSigKey(exprIx, fnIx)) == "str" { return true }
      }
      return false
    }
    BinExpr => {
      // `m[k] ?? d`/`m.get(k) ?? d` over a string-valued map yields a string ref (the value
      // type); a nullable value with a nullable default stays `string | null`.
      const cms = coalesceMvSlot(exprIx, fnIx)
      if cms >= 0 {
        return mvValKind[cms] == MVK_STR
          && !coalesceStaysNullable(exprIx, cms, fnIx)
      }
      // `r ?? d` over a `string | null` LHS yields a (non-null) string — the coalesce
      // recovers the non-null array ref, so `.length`/`+`/etc. on the result work.
      if e.binOp == "??" {
        if exprNullableString(e.binLeft, fnIx) { return true }
        if coalesceNulAtomToStr(exprIx, fnIx) { return true }
        if coalesceRetypedAtomToStr(exprIx, fnIx) { return true }
        if coalesceOperandPinNonNull(exprIx, fnIx) {
          return exprString(e.binLeft, fnIx)
        }
        if coalRetypedDead(exprIx, unwrapParen(e.binLeft), fnIx) {
          return exprString(e.binLeft, fnIx)
        }
        // …and over a `null`-typed LHS the value is the default, at the default's rep (D1576).
        const cnnS = coalesceNulNoneDefaultIx(exprIx, fnIx)
        if cnnS >= 0 { return exprString(cnnS, fnIx) }
      }
      // G6: string concatenation `a + b` produces a string; no other binary operator
      // does (`==`/`!=` yield an i32).
      return exprIsStrConcat(exprIx, fnIx)
    }
    Ident => {
      // A value-union ident is a string only when narrowed to the `string` atom — an
      // un-narrowed union binding is the box, even when its init is a string literal.
      const uk = unionIdentReadKind(exprIx, fnIx)
      // ...unless the locals table slotted this binding as the string ref. The union resolver
      // reads the CHECKER's type, which a hole-armed join records as one arm's; the slot is the
      // rep, so where the two disagree about a binding the emitter itself sized, it wins (D1728).
      if uk != -3 && !declaredString(exprIx) { return uk == 2 }
      if (paramString(fnIx, exprIx)) { return true }
      if declaredString(exprIx) { return true }
      // A captured string reads as a string ref (kind 3), like a string param/local; `nulstr`
      // too, since `exprNullableString` claims the `!= null` test first and never mis-routes it.
      const csk = capturedKindOf(fnIx, e.identName)
      if csk == "str" || csk == "nulstr" { return true }
      return globalReadIsString(fnIx, exprIx)
    }
    // An index read over a string list (`names[i]`) yields a string ref — the only
    // string-producing index form (an i32 list or `s[i]` yields an i32).
    Index => {
      if exprStringArray(e.idxArr, fnIx) { return true }
      // A union-box cell narrowed to the `string` atom unboxes to the string ref — `exprString`
      // has no typed-IR fast path (canon softens a literal union to `string`), unlike its siblings.
      const iuk = indexUnionReadKind(exprIx, fnIx)
      if iuk != -3 { return iuk == 2 }
      // A string-valued MAP cell, and only once a guard has proved the key present: the read is
      // `V | null` until then, which `exprNullableString` owns, and the checker types it non-null
      // after, exactly as the ref-list arm of the index READ asks before it recovers (D1735).
      const smv = mapReadMvSlot(exprIx, fnIx)
      if smv >= 0 {
        if mvValKind[smv] == MVK_STR {
          return nodeTyProvesNonNull(unwrapParen(exprIx))
        }
      }
    }
    // A field read `p.f` where `f` is a STRING struct field yields a string ref (gap #2:
    // `let k = t.kind` must give `k` the string type, not i32).
    Member => {
      // A UNION-typed field read narrowed to the `string` atom unboxes to the
      // string ref (the member-path dual of the Ident rule above).
      const muk = memberUnionReadKind(exprIx, fnIx)
      if muk != -3 { return muk == 2 }
      // A field read whose declared type is `string` (code 3), or a `string | null` niche
      // field (code 20) read as a value (it recovers the non-null string ref).
      const mfc = memberFieldCode(exprIx, fnIx)
      return mfc == FC_STR || mfc == FC_NUL_STR
    }
    // No other expression is a string value by its own form.
    NumLit | CharLit | BoolLit | NullLit | Unary | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// True if the `LetDecl` at `letIx` declares a string-typed local: its annotation is
// `string`, OR its initializer produces a string. Picks the local's valtype
// (`(ref $aTypeIdx)` vs i32) in `collectLocals`.
export function letIsString(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = nodeAt(d.letType)
      if lt is TypeRef {
        // Canon's banked type: `nameIsString` reads the spelling, which softens a litunion to
        // `string` — right here since nothing else claims the binding first.
        if nodeTyPrimName(d.letType) == "string" { return true }
        // A lone literal value is its string, whatever atom field initialises it (D7220).
        if tyIsBareStrLit(nodeTyIxOf(d.letType)) { return true }
        // A nullable literal union is the atom niche, whatever literal initialises it (D7122).
        if tyIsNulLitUnionNiche(nodeTyIxOf(d.letType)) { return false }
      }
    }
    return exprString(d.letInit, fnIx)
  }
  false
}

// True if the `LetDecl`/global at `letIx` declares an `i64` binding. Annotation-only: a bare
// integer literal stays i32 by design, so only an explicit `: i64` annotation selects the i64
// slot (valtype `0x7e`, kind 10), and the initializer literal is then lowered as `i64.const`.
export function letIsI64(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = nodeAt(d.letType)
      if lt is TypeRef {
        // Canon's banked type (B144): `nodeTyPrimName` disagrees for an i64 literal union that
        // softens to the spelling `i64`, so the arena type of the softened spelling is used instead.
        let liTy = nodeTyIxOf(d.letType)
        if canonRewroteNode(d.letType) { liTy = canonTyIxOf(d.letType) }
        if tyScalarBaseIs(liTy, "i64") { return true }
      }
      return false
    }
    // Un-annotated: infer i64 from the initializer, mirroring the host and `letIsF64`. At
    // module scope this recurses through `globalIsI64` for a global-ident operand.
    if d.letInit >= 0 { return exprIsI64(d.letInit, fnIx) }
  }
  false
}

// True if the `LetDecl`/global at `letIx` declares an `f64` binding: an explicit `: f64`
// annotation, or an un-annotated binding whose initializer is a float `.` literal. Such a
// binding selects the f64 slot (valtype 0x7c, kind 11). Accepting an un-annotated float
// `let` here is strictly additive: no other arm claims an un-annotated float binding first.
export function letIsF64(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = nodeAt(d.letType)
      if lt is TypeRef {
        // Canon's banked type (B144): a numeric literal type/union softens to `f64` (never to
        // `i64`), so the arena type of the softened spelling is used, as `letIsI64` does for i64.
        let lfTy = nodeTyIxOf(d.letType)
        if canonRewroteNode(d.letType) { lfTy = canonTyIxOf(d.letType) }
        if tyScalarBaseIs(lfTy, "f64") { return true }
      }
      return false
    }
    if d.letInit >= 0 {
      const ie = nodeAt(d.letInit)
      if ie is NumLit { return numLitWidth(d.letInit, fnIx) == "f64" }
      // An f32 init is not an f64 binding — this predicate is the binding-level answer every
      // read site reaches, and without it an inferred-f32 global answered "f64" wrongly.
      if exprIsF32(d.letInit, fnIx) { return false }
      // Un-annotated: infer f64 from the initializer. At module scope this recurses through
      // `globalIsF64` for a global-ident operand, terminating for an acyclic program.
      return exprIsF64(d.letInit, fnIx)
    }
  }
  false
}

// True if the `LetDecl` at `letIx` binds a function value (kind 14): its initializer is
// a `function(...)` literal, a bare reference to a top-level/lifted function name, or a
// call returning a function value, or, with no initializer, a function-type annotation. The
// cell is the closure fat-pointer `(ref $cloStructIdx)`. (Lambdas.)
export function letIsClosure(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letInit < 0 { return d.letType >= 0 && tyIsFuncType(d.letType) }
    return exprIsClosure(d.letInit, fnIx)
  }
  false
}

// Does the read `readIx` denote a live binding holding a closure in frame `fnIx` — a narrowed arm, a
// closure-typed param, a nullable one, a CAPTURE, or a `let`/`const` whose cell is a
// closure? The rungs of `exprIsClosure`'s `Ident` arm that read a binding, asked without
// the module-function rung above them, so a call site can let the binding win (D1602).
export function identIsBoundClosure(readIx: i32, fnIx: i32): boolean {
  if readIx < 0 { return false }
  if narrowedFnTyOf(readIx, fnIx) >= 0 { return true }
  const rn = nodeAt(readIx)
  const name = if rn is Ident { rn.identName } else { "" }
  if paramIsClosure(fnIx, readIx) { return true }
  if paramNulClosure(fnIx, readIx) { return true }
  const slot = declaredSlotOf(readIx)
  if slot >= 0 {
    return localIsRef[slot] == "closure" || localIsRef[slot] == "nulclosure"
  }
  // The capture rung: a function value that reached this frame in the env struct is a
  // closure binding like any other, and `captureValKind` — which typed that env field — is
  // what says so, the channel `exprNulClosure` already asks for the nullable half. Below
  // the local rungs, so a same-named local of the frame still shadows it (D1608).
  const capK = capturedKindOf(fnIx, name)
  if capK != null { return capK == "closure" || capK == "nulclosure" }
  // The arena rung, for a pass that runs before `buildLocals` fills the registry — a binding
  // declared directly in the frame body covers every call in it, a nested-block one does not.
  if fnIx < 0 || fnIndexOf(name) < 0 { return false }
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    const li = bodyLetOfRead(fn.fnBody, readIx)
    if li >= 0 && parentLetOwnedBy(fn.fnBody, sidOfNode(li), li) {
      const ld = nodeAt(li)
      if ld is LetDecl {
        if ld.letType >= 0 { return tyIsFuncType(ld.letType) }
        // `exprIsClosureNoLocal`, not `letDeclIsClosureNoLocal`: an alias of a closure param
        // or global is a closure binding too, and that one hop is what this classifier is for.
        return exprIsClosureNoLocal(ld.letInit, fnIx)
      }
    }
  }
  false
}

// True if the expression at `exprIx` evaluates to a function value (a closure
// fat-pointer): a `function(...)` literal, a bare reference to a top-level/lifted
// function name, a reference to a closure-typed param/local, or a call returning a
// function value (a function whose body's tail is itself a function value).
export function exprIsClosure(exprIx: i32, fnIx: i32) {
  // A tagged set's value is the i32 id of its member.
  if exprIx < 0 || fnTagTyIsTagged(nodeTyIxOf(exprIx)) { return false }
  const e = nodeAt(exprIx)
  match e {
    Paren => {
      return exprIsClosure(e.parInner, fnIx)
    }
    FuncDecl => {
      return true
    }
    // An if-expression whose branch join is a closure: the checker proved both arms agree, so
    // the then-arm's rep classifies the whole `if`, matching `emitIfExprRef`'s `(ref $cloStruct)`.
    IfStmt => {
      const tv = ifThenValueIx(exprIx)
      return tv >= 0 && exprIsClosure(tv, fnIx)
    }
    Ident => {
      if fnIndexOfAt(sidOfNode(exprIx), fnIx, exprIx) >= 0 { return true }
      // A narrowed closure arm, a closure-typed param (kind 14) or nullable one (kind 19), or a
      // closure-celled local — every one calls via `call_ref`, recovered non-null at the call site.
      if identIsBoundClosure(exprIx, fnIx) { return true }
      // A declared local of the name that is not a closure cell denotes no module global.
      if declaredSlotOf(exprIx) >= 0 { return false }
      // A module-global closure cell — a bare closure (kind 14) or a NULLABLE one (kind 19).
      const gl = globalLetOfRead(fnIx, exprIx)
      if gl >= 0 {
        const gk = globalCellKind(gl)
        return gk == "closure" || gk == "nulclosure"
      }
      return false
    }
    Call => {
      if e.callFn < 0 { return false }
      const callee = nodeAt(e.callFn)
      if callee is Ident {
        const t = fnIndexOfNode(e.callFn)
        if t >= 0 { return fnReturnsClosure(t) }
        // A closure-value callee (`f(4)` where `f: (i32) => ((i32) => i32)`) whose result is
        // itself a closure — resolved from `f`'s `$fnsig` result (`>c`). Lets a curried lambda
        // `const g = f(4)` bind `g` as a closure and call it.
        return calleeRetKindOfRead(e.callFn, fnIx) == "closure"
      }
      // A chained value call `g()()`: the whole call is a closure iff the checker typed its
      // result as a function type, read directly off the arena rather than a rendered name.
      return anonTySpellable(nodeTyAt(exprIx, fnIx)) && nodeTyIsFunc(exprIx)
    }
    Member => {
      // A place (`h.f`) narrowed to a union's bare-closure arm reads back the closure
      // unboxed, as a narrowed binding does (D4346).
      if narrowedFnTyOf(exprIx, fnIx) >= 0 { return true }
      // A field read the checker narrowed to a function arm at a receiver no narrowing key
      // reaches (`hs[0].f`), which the read site unboxes to the closure.
      if memReadUnboxAtomKind(exprIx, fnIx) == 11 { return true }
      // A closure field of a narrowed union or variant-typed receiver reads back a closure
      // exactly like a plain struct's, so the call routes to `call_ref`.
      let mviC = memNarrowVariantIndex(exprIx, fnIx)
      if mviC < 0 { mviC = exprVariantIndex(e.memObj, fnIx) }
      if mviC >= 0 {
        const mvfiC = variantFieldIndex(mviC, callMemProp(exprIx))
        if mvfiC >= 0 {
          const vfcC = variantFieldTypeAt(mviC, mvfiC)
          if vfcC == FC_CLOSURE || vfcC == FC_NUL_CLOSURE { return true }
        }
      }
      // A struct field holding a function value reads back as a closure.
      return memberIsClosure(e.memObj, callMemProp(exprIx), fnIx)
    }
    Index => {
      // A place (`xs[0]`) narrowed to a union's bare-closure arm reads back the closure
      // unboxed, as a narrowed binding does (D4346).
      if narrowedFnTyOf(exprIx, fnIx) >= 0 { return true }
      // An index `xs[i]` into an ARRAY OF FUNCTIONS (`((i32) => i32)[]`, ref-list element
      // kind 5) reads back a closure fat-pointer — callable via `call_ref`.
      if exprRefArray(e.idxArr, fnIx) {
        const slot = refListSlotOfExpr(e.idxArr, fnIx)
        if slot >= 0 && slot < rlElemKindTbl.length {
          return rlElemKindTbl[slot] == RLK_CLOSURE
        }
      }
      // A bare `m[k]` over a FUNCTION-valued map (`{[string]: (i32) => i32}`, mv kind 14) reads
      // back the closure (nullable — narrow with `if f != null`).
      const mrs = mapReadMvSlot(exprIx, fnIx)
      if mrs >= 0 { return mvValKind[mrs] == MVK_CLOSURE }
    }
    // `m[k] ?? d` over a function-valued map yields the closure — a non-null default coalesces
    // to non-null, a nullable default stays `closure | null` (`exprNullableClosure`'s).
    BinExpr => {
      const cm = coalesceMvSlot(exprIx, fnIx)
      if cm >= 0 {
        return mvValKind[cm] == MVK_CLOSURE
          && !coalesceStaysNullable(exprIx, cm, fnIx)
      }
    }
    // No other expression is a closure value.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | OptMember | ErrExpr | LetDecl | Param | TypeRef | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// The lifted-function position (`fnStmts` index) of the function value the binding read at
// `readIx` in `fnIx` holds — `const f = dbl` traces to `dbl` — or -1 when it holds no bare
// function value. Lets a closure call over an inferred binding resolve its real signature.
export function identClosureFeOfRead(readIx: i32, fnIx: i32) {
  identClosureFeHop(readIx, fnIx, 16)
}

// `identClosureFeOfRead` through at most `hops` un-annotated `const` aliases of one another (D6420).
function identClosureFeHop(readIx: i32, fnIx: i32, hops: i32) {
  const li = identLetOfRead(readIx, fnIx)
  if li < 0 { return -1 }
  const d = nodeAt(li)
  if d is LetDecl {
    // An alias reaches an un-annotated `const` only: a `let` may be written after the alias reads
    // it, and an annotation (a union, say) may hold the lambda in another rep than its own.
    if hops < 16 && (d.letKw != "const" || d.letType >= 0) { return -1 }
    // The frame the binding lives in, which its initializer is read in: this function's own
    // body, or the module's.
    let frame = -1
    if !identLetIsModuleLocal && fnIx >= 0 {
      const fn = nodeAt(fnIx)
      if fn is FuncDecl {
        if (
          bodyLetReadAtSid(
            fn.fnBody,
            sidOfNode(readIx),
            readPosIn(readIx, fnIx),
          )
          == li
        ) {
          frame = fnIx
        }
      }
    }
    let fe = -1
    if identLetIsModuleLocal {
      fe = fieldValueFeOf(d.letInit)
    } else {
      fe = fieldValueFeOfIn(d.letInit, fnIx)
    }
    if (
      fe >= 0
      || hops <= 0
      || d.letKw != "const"
      || d.letType >= 0
      || d.letInit < 0
    ) {
      return fe
    }
    if nodeAt(d.letInit) is Ident {
      return identClosureFeHop(d.letInit, frame, hops - 1)
    }
  }
  -1
}

// Whether `identLetOfRead`'s last answer came from the module frame, whose initializers
// resolve without an enclosing function.
let identLetIsModuleLocal = false

// The `let`/`const` binding the read `readIx` inside function `fnIx` (-1 = the start
// function) resolves to: the function's own frame, then a global, then the module frame
// (D1350), whose locals live in no `fnBody` and are not globals either. -1 when none binds it.
export function identLetOfRead(readIx: i32, fnIx: i32) {
  identLetIsModuleLocal = false
  if readIx < 0 { return -1 }
  const atIx = readPosIn(readIx, fnIx)
  const sid = sidOfNode(readIx)
  if fnIx >= 0 {
    const fn = nodeAt(fnIx)
    if fn is FuncDecl {
      const li = bodyLetReadAtSid(fn.fnBody, sid, atIx)
      if li >= 0 && nodeAt(li) is LetDecl { return li }
    }
  }
  const gi = globalLetOfRead(fnIx, readIx)
  if gi >= 0 && nodeAt(gi) is LetDecl { return gi }
  const ml = moduleLocalLetOfRead(emitRootIx, readIx)
  if ml >= 0 && nodeAt(ml) is LetDecl {
    identLetIsModuleLocal = true
    return ml
  }
  -1
}

// The function-type annotation name (`(f64)=>f64`) of the `let`/`const`/global binding the read
// `readIx` in `fnIx` resolves to, or "" when it is not a function-typed binding.
export function identFnTypeAnnNameOfRead(readIx: i32, fnIx: i32) {
  if fnIx >= 0 && readIx >= 0 {
    const fn = nodeAt(fnIx)
    if fn is FuncDecl {
      const li = bodyLetReadAtSid(
        fn.fnBody,
        sidOfNode(readIx),
        readPosIn(readIx, fnIx),
      )
      if li >= 0 {
        const d = nodeAt(li)
        if d is LetDecl {
          if tyIsFuncType(d.letType) { return tyNameOf(d.letType) }
          // A nullable-closure annotation (kind 19): return its name so a narrowed call
          // through a null-seeded binding resolves its sig even with no closure value to trace.
          if nulCloFlag(d.letType) == 1 { return tyNameOf(d.letType) }
          // An un-annotated closure local from a call result: recover the function type from
          // the checker's recorded init type — a bare lambda instead trusts its own lifted sig.
          if d.letType < 0 && d.letInit >= 0 {
            const ini = nodeAt(d.letInit)
            if ini is Call {
              // The arena test before the render: the two conditions are ANDed, so this builds
              // the name only for an init the arena already agreed is a function type.
              if nodeTyIsFunc(d.letInit) {
                const itn = nodeTyName(d.letInit)
                if itn != "" { return itn }
              }
            }
            // A copy of another closure binding: the init is a bare Ident, so its checked type
            // is authoritative (unlike a lambda's inferred return, which can disagree).
            if ini is BinExpr {
              if ini.binOp == "??" {
                // The arena test before the render, as the Call arm above: builds the name
                // only for an init the arena already agreed is a function type.
                if nodeTyIsFunc(d.letInit) {
                  const jtn = nodeTyName(d.letInit)
                  if jtn != "" { return jtn }
                }
              }
            }
            // An un-annotated binding read from a closure-element ref list: the kind-5 slot's
            // element name is the function type — return it so a call resolves the element's real sig.
            if ini is Index {
              if exprRefArray(ini.idxArr, fnIx) {
                const islot = refListSlotOfExpr(ini.idxArr, fnIx)
                if islot >= 0 && islot < rlElemKindTbl.length {
                  if rlElemKindTbl[islot] == RLK_CLOSURE {
                    const enm = rlElemName[islot]
                    if (
                      islot < rlElemNullable.length
                      && rlElemNullable[islot] == 1
                    ) {
                      return enm
                    }
                    return peelGroupParens(enm)
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  // A global or a module-scope block's binding, resolved as `identClosureFeOfRead` resolves it:
  // the annotation is the binding's type in every frame, an alias of a generic included (D5230).
  const gi = identLetOfRead(readIx, fnIx)
  if gi >= 0 {
    const gd = nodeAt(gi)
    if gd is LetDecl {
      if tyIsFuncType(gd.letType) { return tyNameOf(gd.letType) }
      // The dual of the local nulclosure-annotation arm above.
      if nulCloFlag(gd.letType) == 1 { return tyNameOf(gd.letType) }
    }
  }
  ""
}

// The identifier node the un-annotated binding the read `readIx` resolves to copies, or -1: the
// position its source name is read at, which picks among sibling blocks binding it (D3632).
export function identCopySourceNodeOfRead(readIx: i32, fnIx: i32): i32 {
  if readIx < 0 { return -1 }
  let li = -1
  if fnIx >= 0 {
    const fn = nodeAt(fnIx)
    if fn is FuncDecl {
      li = bodyLetReadAtSid(
        fn.fnBody,
        sidOfNode(readIx),
        readPosIn(readIx, fnIx),
      )
    }
  }
  // A module-scope binding read at module scope (D3854).
  if li < 0 && fnIx < 0 { li = identLetOfRead(readIx, fnIx) }
  if li >= 0 {
    const d = nodeAt(li)
    if d is LetDecl {
      if d.letType < 0 && d.letInit >= 0 {
        if nodeAt(d.letInit) is Ident { return d.letInit }
      }
    }
  }
  -1
}

// The key of the lambda the module-scope binding `sid` holds, following un-annotated copies
// (`const d = c`) from binding to binding; "" when it ends anywhere else. Asked by a function
// whose own locals may share a name in the chain, which the frame-relative rungs would see.
function moduleCopySigKey(sid: i32): string {
  let s = sid
  let hops = 0
  while hops < COPY_CHAIN_MAX && s >= 0 {
    const li = globalLetOfSid(s)
    if li < 0 { return "" }
    const d = nodeAt(li)
    if !(d is LetDecl) || d.letType >= 0 || d.letInit < 0 { return "" }
    const fe = fieldValueFeOf(d.letInit)
    if fe >= 0 { return cloSigKeyExt(fe) }
    if !(nodeAt(d.letInit) is Ident) { return "" }
    s = sidOfNode(d.letInit)
    hops = hops + 1
  }
  ""
}

// The `$fnsig` key of the function value the callee read `atIx` in `fnIx` calls through: the
// read's own node picks among sibling blocks binding its name, a module-scope block (D1751) as
// much as a function-scoped one (D2316).
function calleeCloSigKeyOfRead(atIx: i32, fnIx: i32): string {
  if atIx < 0 { return "" }
  const sid = sidOfNode(atIx)
  // An alias of a field read a generic's instances share holds its pinned type per instance.
  const fk = sigKeyOfTy(monoFieldReadTyAt(atIx, fnIx))
  if fk != "" && cloSigPosOfKey(fk) >= 0 { return fk }
  const name = sidText(sid)
  // Where the name denotes a named function (no binding on the frame chain is in scope at
  // `atIx`), only the callee's own checker type may answer: every rung below reads a binding,
  // and one in a closed block would lend the call its signature (D2384). A minted callee is
  // asked at its call's position; any other node past the frame's body cannot decide this.
  const srcAt = callOriginOf(atIx)
  // A minted callee has no place of its own, so the binding rungs read at its call's (D2479).
  const posAt = readPosIn(atIx, fnIx)
  if srcAt >= 0 && srcAt <= frameBodyEnd(fnIx) {
    if fnIndexOfInScopeAt(sid, name, fnIx, srcAt) >= 0 {
      return calleeNodeSigKey(atIx, fnIx)
    }
  }
  // A union binding narrowed to a bare-closure arm (`if x is () => i64 { x() }`): the arm's
  // function-type name interns the SAME `$fnsig` an annotated closure would — so the `call_ref`
  // casts to the right functype and the result classifiers (`calleeReturnsI64`/…) read its return.
  const nft = narrowedFnTyOf(atIx, fnIx)
  if nft >= 0 { return sigKeyOfTy(nft) }
  // Skipped when a block still open at `atIx` shadows `sid` (D2325): the loop-var/param/
  // anon-leaf rungs below answer for the function's OUTER binding, which a nearer block
  // `const`/`let` of the same name hides at this position — the ladder falls through to the
  // positioned rungs after this guard, which resolve the shadow itself.
  if !fnBlockShadowsAt(fnIx, sid, atIx) {
    // A `for f in fs` loop variable has no declaration node, so no rung below can name it;
    // it IS the iterable's element and calls through the element's key (D2110).
    const lk = loopVarCloSigKey(name, fnIx, atIx)
    if lk != "" { return lk }
    const pk = paramCloSigKey(fnIx, name)
    if pk != "" { return pk }
  }
  // Positioned throughout (D2316): two sibling FUNCTION-scoped blocks binding one name are as
  // ambiguous unpositioned as two sibling module-scoped ones (D1751).
  const csid = sid
  const an = identFnTypeAnnNameOfRead(atIx, fnIx)
  if an != "" {
    // The arena builds the key where the binding carries a plain annotation; `cloNameSigKeyTy`
    // is the fall-through, and parses the rendered name only where the type cannot key it. B255.
    const jnd = identFnTypeAnnNodeOfRead(atIx, fnIx)
    if jnd >= 0 {
      const jty = nodeTyIxOf(jnd)
      if jty >= 0 {
        const jt = tyAt(jty)
        if jt is TyFunc {
          const jk = sigKeyOfTy(jty)
          if jk != "" { return jk }
        }
      }
    }
    // An annotation with no arena type renders its emit spelling, which softens a union of
    // literal-union aliases to `string` though the value is boxed; the callee's own checker
    // type keys the box (D3208).
    const cty = nodeTyAt(atIx, fnIx)
    if cty >= 0 && cty < T.tys.length {
      if tyAt(cty) is TyFunc {
        const ck = sigKeyOfTy(cty)
        if ck != "" && cloSigPosOfKey(ck) >= 0 { return ck }
      }
    }
    let aty = -1
    if jnd >= 0 { aty = nodeTyIxOf(jnd) }
    if aty < 0 { aty = cty }
    const ak = cloNameSigKeyTy(an, aty)
    if ak != "" { return ak }
  }
  const fe = identClosureFeOfRead(atIx, fnIx)
  // The extended key (not just `fnSigKeyOf`) so a void-returning binding resolves its `>v`
  // sig, interned above; a value-eligible binding takes the same key `fnSigKeyOf` would.
  if fe >= 0 { return cloSigKeyExt(fe) }
  // An inferred COPY of another closure binding (`const t0 = p`): chase the source so a call
  // through the intermediate binding classifies its result (nullable-closure read pattern).
  // Asked at the source's own read, so a same-named binding in a sibling block is not it (D3632).
  const srcIx = identCopySourceNodeOfRead(atIx, fnIx)
  if srcIx >= 0 {
    const srcSid = sidOfNode(srcIx)
    if srcSid != csid {
      // A copy that is no binding of this function's own body is a module-scope one, whose
      // source is read at module scope (D3868).
      let srcFn = fnIx
      if fnIx >= 0 {
        const ofn = nodeAt(fnIx)
        if ofn is FuncDecl {
          if bodyLetReadAtSid(ofn.fnBody, csid, posAt) < 0 { srcFn = -1 }
        }
      }
      if srcFn < 0 && fnIx >= 0 {
        const mk = moduleCopySigKey(srcSid)
        if mk != "" { return mk }
      }
      const sk = calleeCloSigKeyOfRead(srcIx, srcFn)
      if sk != "" { return sk }
    }
  }
  // A binding whose initializer is a call: read the checker's recorded type directly, since
  // every rung above resolves a name and a call result is none of them. D945. Positioned
  // (D2316), the same ambiguity as every other rung in this ladder.
  let letIx = 0 - 1
  let letFn = fnIx
  if fnIx >= 0 {
    const cfn = nodeAt(fnIx)
    if cfn is FuncDecl { letIx = bodyLetReadAtSid(cfn.fnBody, csid, posAt) }
  }
  if letIx < 0 {
    letIx = globalLetOfRead(fnIx, atIx)
    letFn = -1
  }
  // The module frame, the third scope this ladder must reach, exactly as `identClosureFeOfRead`
  // reaches it (D1350): a binding in a module-scope BLOCK lives in no `fnBody` and is not a
  // global. Positioned, since a sig chosen off the first of two same-named blocks is D1596.
  if letIx < 0 { letIx = moduleLocalLetOfRead(emitRootIx, atIx) }
  if letIx >= 0 {
    const cd = nodeAt(letIx)
    if cd is LetDecl {
      // A binding initialized by another name holds that name's value, whose key is that
      // binding's, asked in the frame that declares this one (D3868).
      const isid = sidOfNode(cd.letInit)
      if (
        cd.letType < 0
        && cd.letInit >= 0
        && nodeAt(cd.letInit) is Ident
        && isid != csid
      ) {
        // Read from inside a function, a module binding's source is not one of that function's
        // locals of the same name (D3880).
        if letFn < 0 && fnIx >= 0 {
          const mk = moduleCopySigKey(isid)
          if mk != "" { return mk }
        }
        const ik = calleeCloSigKeyOfRead(cd.letInit, letFn)
        if ik != "" { return ik }
      }
      if cd.letInit >= 0 {
        const cty = nodeTyAt(cd.letInit, fnIx)
        if cty >= 0 {
          const ct = tyAt(cty)
          // A generic's value left uninstantiated records a type with no key, so the callee's
          // own type below answers instead (D5610).
          if ct is TyFunc {
            const lk = sigKeyOfTy(cty)
            if lk != "" { return lk }
          }
          // The nullable twin (`letInitTyIsNulFunc`'s shape): a bare `const t = m[k]` read of
          // a function-valued map records `TyFunc | null`, and the narrowed call runs at the
          // inner signature — so the key is the inner's, not "" (D1662).
          if ct is TyNullable { return sigKeyOfTy(ct.nInner) }
        }
      }
    }
  }
  // The capture channel, last: a captured callee's binding lives in an ENCLOSING frame, which
  // none of the rungs above asks about — they read `fnIx`'s own params and body, the globals
  // registry and the module frame. Re-asked against the frame that owns the binding, so a
  // captured void closure resolves its `>v` sig and its call stays a statement (D1634).
  const cowner = capturedBindingFrameOf(fnIx, name)
  if cowner >= 0 && cowner != fnIx {
    const ok = calleeCloSigKeyOfRead(atIx, cowner)
    if ok != "" { return ok }
  }
  // Positioned, the callee node's own checker type answers last: it is the key
  // `cloCallSigKey`'s general fallback lowers the call with, so the void answer and the
  // emitted `call_ref` cannot disagree about whether a value is left (D2110).
  calleeNodeSigKey(atIx, fnIx)
}

// True if the function-VALUE callee at `sid` returns void — its resolved `$fnsig` key has no
// result. POSITIONED at the callee's own arena node, which is what picks among sibling
// module-scope blocks binding one closure name: unpositioned, the module rung declines on the
// ambiguous name and the empty key reads as "returns a value" (D1862).
export function calleeReturnsVoidOfRead(atIx: i32, fnIx: i32) {
  sigKeyRetIsVoid(calleeCloSigKeyOfRead(atIx, fnIx))
}

// Whether the lifted frame `fnIx` captures `name`: a free variable of its body, not one of
// its own params, locals or globals.
function frameCapturesName(fnIx: i32, name: string): boolean {
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return false }
  const caps = captureNamesOf(fe)
  let i = 0
  while i < caps.length {
    if caps[i] == name { return true }
    i = i + 1
  }
  false
}

// The `$fnsig` key a for-in loop variable `name` calls through, or "" when `name` is no
// closure-element loop variable of frame `fnIx`, keyed as `fs[i]` is so the two agree. The slot
// of the read at `atIx` (a minted read: the live scope's) answers a loop the frame owns.
function loopVarCloSigKey(name: string, fnIx: i32, atIx: i32) {
  let iter = -1
  const un = unwrapParen(atIx)
  const slot = if identDeclOf(un) >= 0 { declaredSlotOf(un) } else { scopeSlotOf(name) }
  if slot >= 0 {
    if slot >= localLoopIter.length { return "" }
    iter = localLoopIter[slot]
  } else {
    // The capture set walks the frame's whole body, so it is asked only once an enclosing
    // frame is known to bind `name` as a loop variable; asked first, it made every call
    // site of a large function a walk of that function (D2180).
    const fe = fnStmtsPosOf(fnIx)
    if (
      fe >= 0
      && enclosingLoopVarBinds(fe, name)
      && frameCapturesName(fnIx, name)
    ) {
      iter = captureLoopVarIterOf(fe, name)
    }
  }
  if iter < 0 { return "" }
  const mvs = forInMapValsSlot(iter, fnIx)
  if mvs >= 0 {
    if mvs >= mvRlSlot.length { return "" }
    return cloArrSlotSigKey(mvRlSlot[mvs])
  }
  if !exprRefArray(iter, fnIx) { return "" }
  arrSlotSigKeyOf(iter, fnIx)
}

// The `$fnsig` key of the closure-list slot `arrIx` reads, or "". A hole parameter renders
// out of the slot's element name, so the slot can be one a function of another arity
// interned; such a key does not answer for this element (D10702).
function arrSlotSigKeyOf(arrIx: i32, fnIx: i32): string {
  const sk = cloArrSlotSigKey(refListSlotOfExpr(arrIx, fnIx))
  if sk != "" && !sigArityIsElemOf(sk, nodeTyAt(arrIx, fnIx)) { return "" }
  sk
}

// Whether `key` takes exactly as many parameters as the function element of list type
// `listTy`; true when `listTy` is no list of functions over an inference hole.
function sigArityIsElemOf(key: string, listTy: i32): boolean {
  if listTy < 0 || listTy >= T.tys.length { return true }
  const lt = tyAt(listTy)
  if !(lt is TyArray) || lt.aElem < 0 || lt.aElem >= T.tys.length {
    return true
  }
  if !tyHasInferHole(lt.aElem, 0) { return true }
  const et = tyAt(lt.aElem)
  if !(et is TyFunc) { return true }
  sigTakesParams(key, et.fnParamTypes.length)
}

// True if the function-VALUE callee at `sid` (in scope of `fnIx`) returns a string — its
// resolved `$fnsig` key's result kind is `"str"`. The value-call analogue of
// `fnRetString` for a named function — drives the closure-call RESULT's string typing
// (binding cell, print routing). `atIx` is the callee's own arena node (D2316).
function calleeReturnsStringOfRead(atIx: i32, fnIx: i32) {
  calleeRetKindOfRead(atIx, fnIx) == "str"
}

// The struct-table index a function-value callee at `sid` (in scope of `fnIx`) returns, or
// -1. Its resolved `$fnsig` key's result kind is `"struct"` (`>sN;`) or `"nulstruct"`
// (`>nN;`); the slot digits parse through the shared result-slot reader. Drives the
// closure-call result's struct typing. `atIx` is the callee's own arena node (D2316).
function calleeReturnsStructIdxOfRead(atIx: i32, fnIx: i32) {
  const k = calleeCloSigKeyOfRead(atIx, fnIx)
  const rk = sigKeyRetKind(k)
  if rk == "struct" || rk == "nulstruct" { return sigKeyRetSlot(k) }
  -1
}

// The `cloRetValKind`-style result kind of a function-value callee (by `sid`, in scope of
// `fnIx`), decoded from its resolved `$fnsig` key — the trailing `>X` token's `VKind`, or
// `null` for a void or unresolved result. `atIx` is the callee's own arena node, threaded to
// `calleeCloSigKeyOfRead` so two sibling blocks binding one name resolve the call's own (D2316).
function calleeRetKindOfRead(atIx: i32, fnIx: i32): VKind | null {
  return sigKeyRetKind(calleeCloSigKeyOfRead(atIx, fnIx))
}

// The result kind of a call through a function value reached by an index, a record field, a
// returned function or a parenthesised lambda, off its `$fnsig` key's result token; `null`
// for any other callee, an `Ident` among them (those resolve through `calleeRetKindOfRead`).
function cloValueCallRetKind(callIx: i32, fnIx: i32): VKind | null {
  const c = nodeAt(callIx)
  if c is Call {
    const cfx = unwrapParen(c.callFn)
    if cfx < 0 { return null }
    const cre = nodeAt(cfx)
    if cre is Member {
      if !memberIsClosure(cre.memObj, cre.memProp, fnIx) { return null }
    } else if !(cre is Index || cre is Call || cre is FuncDecl) {
      return null
    }
    return sigKeyRetKind(cloCallSigKey(callIx, fnIx))
  }
  null
}

// The result value-kind of a call whose callee is an index into a closure array (`fs[i](x)`):
// the closure-element signature's return atom. `null` when the call's callee is not an
// indexed closure value. The expr classifiers consult this so an indexed closure call's
// result routes to the right print/arithmetic/store path.
function cloArrCallRetKind(callIx: i32, fnIx: i32): VKind | null {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return null }
    const callee = nodeAt(c.callFn)
    if callee is Index {
      // A read a generic's instances share holds its pinned type per instance (D7840).
      const fk = sigKeyOfTy(monoFieldReadTyAt(c.callFn, fnIx))
      if fk != "" { return sigKeyRetKind(fk) }
      if exprRefArray(callee.idxArr, fnIx) {
        const sk = arrSlotSigKeyOf(callee.idxArr, fnIx)
        if sk != "" { return sigKeyRetKind(sk) }
        // A slot with no key of its own, an instance's list of hole lambdas among them, is
        // called at the key the emitter lowers the call with (D12300).
        return sigKeyRetKind(cloCallSigKey(callIx, fnIx))
      }
    }
  }
  null
}

function paramCloSigKey(fnIx: i32, name: string) {
  if fnIx < 0 { return "" }
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    const params = fn.fnParams
    let i = 0
    while i < params.length {
      const p = nodeAt(params[i])
      if p is Param {
        if p.parName == name {
          if p.parType >= 0 {
            // A monomorphized closure-pinned param announces itself in the pin column, which
            // also carries the `$fnsig` key — read where it lives, not by prefix-testing the name.
            const pin = nodePinPayloadOf(p.parType)
            if pin != "" { return pin }
            const ty = nodeAt(p.parType)
            if ty is TypeRef {
              const nm = ty.tyName
              if nm.length > 2 {
                // The parser's tree, not a character scan: asks whether the annotation spells a
                // function type anywhere, including inside a union arm (unlike the narrower arena test).
                if annCloSigSpelled(p.parType, nm) {
                  return cloNameSigKeyTy(nm, nodeTyIxOf(p.parType))
                }
              }
            }
          }
          return ""
        }
      }
      i = i + 1
    }
  }
  ""
}

// True if the function at `fnStmts` position `t` returns a function value — its body's
// tail expression is itself a function value (a bare function name, a `function(...)`
// literal, or a closure-typed local). Drives `exprIsClosure` for call results
// (`const f = makeAdder(5)` where `makeAdder` returns its inner closure).
export function fnReturnsClosure(t: i32) {
  if t < 0 || t >= fnStmts.length { return false }
  const fn = nodeAt(fnStmts[t])
  if fn is FuncDecl {
    // A function returning a tagged set's value returns its member's i32 id.
    if fnTagRetIsTagged(fnStmts[t]) { return false }
    // An annotated function-type return is a closure result regardless of how the body yields
    // it (a higher-order call the tail scan can't see), since the valtype is already kind 14.
    if fn.fnRet >= 0 && tyIsFuncType(fn.fnRet) { return true }
    // Any other concrete annotation is not one, though its tail may yield a closure arm (D4348).
    if fn.fnRet >= 0 {
      const rt = nodeTyIxOf(fn.fnRet)
      if rt >= 0 && !tyHasTyVar(rt) { return false }
    }
    return blockTailIsClosure(fn.fnBody, fnStmts[t])
  }
  false
}

// True if the block's tail (implicit-return) expression is a function value.
function blockTailIsClosure(blockIx: i32, fnIx: i32) {
  const b = nodeAt(blockIx)
  if b is Block {
    const stmts = b.blkStmts
    const n = stmts.length
    if n == 0 { return false }
    const last = stmts[n - 1]
    const s = nodeAt(last)
    if s is RetStmt {
      if s.retArg >= 0 { return tailValueIsClosure(s.retArg, fnIx) }
      return false
    }
    return tailValueIsClosure(last, fnIx)
  }
  false
}

// The tail value's own question, asked of the ARENA first and of the syntax second. The
// checker recorded a `TyFunc` for every spelling that yields a function value — a call
// hop, a returned local, a chain of them — and `nodeTyIsFunc` is structural, so a func
// ARRAY and a NULLABLE closure are excluded and only the plain `closure` rep claims (D1620).
function tailValueIsClosure(exprIx: i32, fnIx: i32) {
  if exprIx < 0 || fnTagTyIsTagged(nodeTyIxOf(exprIx)) { return false }
  if nodeTyIsFunc(exprIx) { return true }
  exprIsClosureNoLocal(exprIx, fnIx)
}

// The declaration half of `exprIsClosureNoLocal`'s binding arm: "does this `let`/`const`
// hold a function value", without the locals registry. The annotation decides it outright;
// an un-annotated binding is claimed only by a one-node-read initializer. Deliberately not
// recursive — a chained initializer is left to `exprIsClosure`, since a scan here could loop.
export function letDeclIsClosureNoLocal(letIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 { return tyIsFuncType(d.letType) }
    if d.letInit < 0 { return false }
    const u = unwrapParen(d.letInit)
    if u < 0 { return false }
    const ui = nodeAt(u)
    match ui {
      FuncDecl => {
        return true
      }
      Ident => {
        return fnIndexOfNode(u) >= 0
      }
      // No other declaration is a closure without a local cell.
      NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
    }
  }
  false
}

function exprIsClosureNoLocal(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = nodeAt(exprIx)
  match e {
    Paren => {
      return exprIsClosureNoLocal(e.parInner, fnIx)
    }
    FuncDecl => {
      return true
    }
    Ident => {
      // The scope must be asked first: a module-wide function lookup ranks below every scope
      // question, or a shadowing param/let/for-var would misclassify as the function.
      const b = identBindingOfRead(fnIx, exprIx)
      if b >= 0 {
        const bn = nodeAt(b)
        if bn is Param { return tyIsFuncType(bn.parType) }
        if bn is LetDecl { return letDeclIsClosureNoLocal(b) }
        // A `for` variable: an i32 counter, or an element of the iterated list. Neither is
        // a bare function NAME, which is all this no-registry predicate can claim.
        return false
      }
      const d = identDeclOf(exprIx)
      if d >= 0 {
        const dn = nodeAt(d)
        if dn is LoopVar || dn is ForRange { return false }
      }
      // The module is the outermost frame, and the chain above never reaches it (D1542): a
      // top-level lambda's `fnParent` walk ends at -1, missing a module-scope capture.
      const mll = moduleLocalLetOfRead(emitRootIx, exprIx)
      if mll >= 0 { return letDeclIsClosureNoLocal(mll) }
      const gcl = globalLetOfDeclRead(exprIx)
      if gcl >= 0 { return letDeclIsClosureNoLocal(gcl) }
      return fnIndexOfNode(exprIx) >= 0
    }
    ObjLit => {
      return false
    }
    // No other expression is a closure without a local cell.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | Member | OptMember | ErrExpr | LetDecl | Param | TypeRef | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// True if member access `obj.prop` yields a function value — `prop` is a struct field
// whose declared type is a function type. (For `objects/equality-function-field.vl` and
// `escaping.vl`'s `o.go`.) Resolved against the receiver's struct table fields.
function memberIsClosure(objIx: i32, prop: string, fnIx: i32) {
  const si = structIndexOfExpr(objIx, fnIx)
  if si >= 0 { return structFieldIsClosure(si, prop) }
  // A narrowed union receiver: the struct index isn't resolvable from the declared union
  // type, so read the closure field code off the narrowed variant's own field tables instead.
  const ox = unwrapParen(objIx)
  if ox >= 0 && nodeAt(ox) is Ident && narrowedFromTyOf(ox) >= 0 {
    const vi = variantRowOfShapeTy(nodeTyAt(ox, fnIx))
    if vi >= 0 {
      const vfi = variantFieldIndex(vi, prop)
      if vfi >= 0 {
        const vfc = variantFieldTypeAt(vi, vfi)
        return vfc == FC_CLOSURE || vfc == FC_NUL_CLOSURE
      }
    }
  }
  false
}

// `xs.pop()`/`xs.get(i)` over a struct-element ref list — the host types both as `S | null`.
// Returns the element struct table index, or -1 when the call is not such a read.
// Restricted to plain-struct elements: map-array and union-element pops keep their
// existing classification (`g_maparray`'s golden bytes depend on it).
export function structListPopGetElem(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return -1 }
  const e = nodeAt(exprIx)
  if e is Call {
    if e.callFn < 0 { return -1 }
    const callee = nodeAt(e.callFn)
    if callee is Member {
      if callee.memProp == "pop" || callee.memProp == "get" {
        if exprRefArray(callee.memObj, fnIx) {
          const slot = refListSlotOfExpr(callee.memObj, fnIx)
          if slot >= 0 && slot < rlElemKindTbl.length {
            if rlElemKindTbl[slot] == RLK_STRUCT {
              return rlElemStructRow(slot)
            }
          }
        }
      }
    }
  }
  -1
}

// ── `.map` / `.filter` classification (Slices 3–4) ─────────────────────────────

// True if the expression at `exprIx` is a `.map`/`.filter` HOF call over a LIST
// receiver (one callback argument). A member call named `map`/`filter` over a
// NON-list receiver (e.g. a function-valued struct field) is NOT a HOF site.
export function callIsMapFilter(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = nodeAt(exprIx)
  if e is Call {
    if e.callFn < 0 { return false }
    const callee = nodeAt(e.callFn)
    if callee is Member {
      if callee.memProp == "map" || callee.memProp == "filter" {
        if e.callArgs.length == 1 {
          return mfRecvKindOf(callee.memObj, fnIx) != null
        }
      }
    }
  }
  false
}

// True if the expression at `exprIx` is an array `.slice(start, end?)` over a LIST
// receiver — a sublist of the SAME element type. (A string `.slice` is a separate
// `exprIsStrSlice` path; this is the array dual.)
export function callIsArrSlice(exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return false }
  const e = nodeAt(exprIx)
  if e is Call {
    if e.callFn < 0 { return false }
    const callee = nodeAt(e.callFn)
    if callee is Member {
      if callee.memProp == "slice" {
        if e.callArgs.length == 1 || e.callArgs.length == 2 {
          return mfRecvKindOf(callee.memObj, fnIx) != null
        }
      }
    }
  }
  false
}

// The RECEIVER list kind of a `.map`/`.filter` call: `0` (i32/boolean list), `1`
// (f64 list), `2` (struct/union ref list), or -1 (not a supported list — a string
// list or a non-list receiver).
export function mfRecvKindOf(recvIx: i32, fnIx: i32): MfKind | null {
  if exprF64Array(recvIx, fnIx) { return "f64" }
  if exprI64Array(recvIx, fnIx) { return "i64" }
  if exprF32Array(recvIx, fnIx) { return "f32" }
  if exprRefArray(recvIx, fnIx) { return "ref" }
  if exprStringArray(recvIx, fnIx) { return "str" }
  // The packed byte list before `exprArray` (D1141): `u8[]`'s backing differs from every
  // other i32-element list, so a `.slice` must pick this rep or mint the wrong wrapper.
  if exprU8Array(recvIx, fnIx) { return "u8" }
  if exprArray(recvIx, fnIx) { return "i32" }
  null
}

// The result element kind of the `.map`/`.filter` call at `callIx`: `0` (i32/boolean
// element), `1` (f64 element), or -1 (unsupported). `filter` keeps the receiver's element
// kind (a ref-list filter fails loudly at emit); `map`'s result element kind is the
// callback's return kind (`cloRetKindOf`).
export function mfResultKindOf(callIx: i32, fnIx: i32): MfKind | null {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return null }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      // `.slice` preserves the element type — its result kind IS the receiver's.
      if callee.memProp == "slice" { return mfRecvKindOf(callee.memObj, fnIx) }
      if callee.memProp == "filter" { return mfRecvKindOf(callee.memObj, fnIx) }
      if c.callArgs.length == 1 {
        // A list-returning callback maps to a ref list of that list's wrapper (D4870).
        if mfListResultElemTy(callIx, fnIx) >= 0 { return "ref" }
        // A call typed as a list of a nullable record, a union's arm included, is a ref list
        // of that type's own row, whatever kind the callback's return is classified as (D12820).
        if mfNulRecResultElemTy(callIx, fnIx) >= 0 { return "ref" }
        // A call typed `u8[]` builds the packed byte list; its callback's return reads as an
        // `i32`, which would pick the plain list (D12902).
        if tyIsU8ArrayTy(nodeTyInOf(callIx, fnIx)) { return "u8" }
        const fe = mfCallbackFe(c.callArgs[0], fnIx)
        if fe < 0 {
          // A closure-value callback (`xs.map(f)`, `f` a function-typed param/binding) — its result
          // kind comes from the closure's sig RETURN token, not a lifted fe (scalar returns only).
          const ck = mfCallbackCloKey(c.callArgs[0], fnIx)
          if ck != "" { return mfResKindFromSigRet(sigKeyRetKind(ck)) }
          return null
        }
        // A string-returning callback maps to a string-list result (kind 3) — checked first
        // since `cloRetKindOf` folds string into -1.
        if cloRetIsString(fe) { return "str" }
        // A struct-returning callback maps to a new ref list of the result struct — consult
        // `cloRetValKind` directly, since the result element type differs from the source.
        if cloRetIsStructRow(fe) { return "ref" }
        // A concrete-variant-returning callback maps to a ref list of bare variant structs —
        // checked before the union case since `cloRetValKind` already prefers the variant.
        if cloRetValKind(fe) == "variant" { return "ref" }
        // A union-returning callback maps to a ref list of union boxes; all unions share
        // `$uBox`, so the result element is the declared union.
        if cloRetValKind(fe) == "union" { return "ref" }
        // A nullable-string-returning callback maps to the same `(string | null)[]` string
        // list — `cloRetKindOf` folds the niche into i32, so consult `cloRetValKind` instead.
        if cloRetValKind(fe) == "nulstr" { return "str" }
        // An i64-/f32-returning callback maps to an i64-/f32-list result — `cloRetKindOf`
        // folds these to -1 (out of the value-call ABI), so consult `cloRetValKind` directly.
        if cloRetValKind(fe) == "i64" { return "i64" }
        if cloRetValKind(fe) == "f32" { return "f32" }
        // The `.map` dual of `fnSigKeyOf`'s key/bytes interlock: claim i32/f64 only when the
        // coarse `cloRetKindOf` agrees with the honest `cloRetValKind`; else fall to a loud reject.
        const rk2 = cloRetKindOf(fe)
        // `boolean | null` rides the i32 result and maps to the i32 list its elements share.
        let vk2 = cloRetValKind(fe)
        if vk2 == "nulbool" { vk2 = "i32" }
        if rk2 == vk2 {
          match rk2 {
            "i32" => {
              return mfI32ResultOrColumn(callIx, fnIx, fe)
            }
            "f64" => {
              return "f64"
            }
            // Every other coarse kind is claimed above or has no `.map` result kind.
            "struct" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "i64" | "f64list" | "f32" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" | "v128" | null => {}
          }
        }
      }
      return null
    }
  }
  null
}

// The element type of a `.map` whose callback returns a list, a function, a nullable list, a
// map, a nullable map or a nullable closure, so its result is a ref list at that element's row;
// -1 when the callback returns none of these or the call's element is not that concrete type.
export function mfListResultElemTy(callIx: i32, fnIx: i32): i32 {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 || c.callArgs.length != 1 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      if callee.memProp != "map" { return -1 }
      const fe = mfCallbackFe(c.callArgs[0], fnIx)
      // A closure-value callback has no lifted function to ask; its call's type decides.
      const vk = if fe >= 0 { cloRetValKind(fe) } else { null }
      if (
        fe >= 0
        && !vkIsPlainList(vk)
        && vk != "closure"
        && !vkIsBoxedRefElem(vk)
      ) {
        return -1
      }
      let et = iterElemPinTy(callIx, fnIx)
      if et < 0 {
        const rt = tyRefArrElemOf(nodeTyIxOf(callIx))
        if rt >= 0 && !tyHasTyVar(rt) { et = rt }
      }
      if et < 0 || et >= T.tys.length { return -1 }
      // A function-returning callback maps to a ref list of closures (D9171).
      if vk == "closure" { return if tyIsFuncArena(et) { et } else { -1 } }
      if tyAt(et) is TyArray { return et }
      // A nullable list, a map, a nullable map or a nullable closure is a ref-list element
      // read at its own `et` row (D12901).
      if fe >= 0 && !vkIsBoxedRefElem(vk) { return -1 }
      if tyIsMap(et) { return et }
      const nt = tyAt(et)
      if nt is TyNullable {
        if nt.nInner >= 0 && nt.nInner < T.tys.length {
          const it = tyAt(nt.nInner)
          if it is TyArray || it is TyMap || it is TyFunc { return et }
        }
      }
    }
  }
  -1
}

// The element type of a `.map` whose call is typed as a list of a nullable record, or -1.
export function mfNulRecResultElemTy(callIx: i32, fnIx: i32): i32 {
  const et = tyRefArrElemOf(nodeTyInOf(callIx, fnIx))
  if et < 0 || et >= T.tys.length || tyHasTyVar(et) { return -1 }
  const t = tyAt(et)
  if !(t is TyNullable) || t.nInner < 0 { return -1 }
  if !(tyAt(t.nInner) is TyObj) { return -1 }
  et
}

// `mfNulRecResultElemTy` of a `.map` call only; -1 for any other call.
function mfNulRecMapElemTy(callIx: i32, fnIx: i32): i32 {
  const c = nodeAt(callIx)
  if !(c is Call) || c.callFn < 0 { return -1 }
  const callee = nodeAt(c.callFn)
  if !(callee is Member) || callee.memProp != "map" { return -1 }
  mfNulRecResultElemTy(callIx, fnIx)
}

// `mfListResultElemTy` rendered as the ref-list row key; "" when it answers -1.
export function mfListResultElemName(callIx: i32, fnIx: i32): string {
  const lt = mfListResultElemTy(callIx, fnIx)
  if lt < 0 { return "" }
  rlMintNameOfTy(lt)
}

// The ref-list table slot of a kind-2 `.map`/`.filter` result, or -1. `.filter` preserves the
// receiver's element list, so the result slot IS the source ref-list slot.
export function mfResultSlotOf(callIx: i32, fnIx: i32) {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      // `.slice` preserves the ref-list element — its result slot IS the receiver's.
      if callee.memProp == "slice" {
        if mfRecvKindOf(callee.memObj, fnIx) == "ref" {
          return refListSlotOfExpr(callee.memObj, fnIx)
        }
      }
      if callee.memProp == "filter" {
        if mfRecvKindOf(callee.memObj, fnIx) == "ref" {
          return refListSlotOfExpr(callee.memObj, fnIx)
        }
      }
      // A STRUCT-returning `.map`: the result is a NEW ref list whose element is the
      // callback's RETURN struct — its ref-list slot (interned by `mfScan`).
      if callee.memProp == "map" && c.callArgs.length == 1 {
        // A list-returning `.map`: the row `collectMapFilterUse` interned for that list type.
        const lt = mfListResultElemTy(callIx, fnIx)
        if lt >= 0 { return rlSlotOfTy(lt) }
        const fe = mfCallbackFe(c.callArgs[0], fnIx)
        // A nullable-record result keeps its `| null` in the row, so its elements read
        // nullable; the struct row below would recover each one non-null (D10890). Its row,
        // or -1 before `collectMapFilterUse` interns it, never the struct's (D12820).
        const nrt = mfNulRecResultElemTy(callIx, fnIx)
        if nrt >= 0 { return rlSlotOfTy(nrt) }
        if fe >= 0 && cloRetIsStructRow(fe) {
          const si = cloRetValSlot(fe)
          if si >= 0 && si < sNames.length {
            // Arena route, one layer up from the rep tables: the struct row's own `sTyIx`
            // already carries its type, so `rlSlotOfTyOrTwin` needs no spelling to be produced at all.
            let elemTy = -1
            if si < sTyIx.length { elemTy = sTyIx[si] }
            return rlSlotOfTyOrTwin(elemTy)
          }
        }
        // A struct-returning closure-value callback: no lifted fe, so the result struct
        // index comes from the closure's `>s<idx>;` sig-return token instead.
        if fe < 0 {
          const ck = mfCallbackCloKey(c.callArgs[0], fnIx)
          if ck != "" && sigKeyRetKind(ck) == "struct" {
            const csi = sigKeyRetSlot(ck)
            if csi >= 0 && csi < sNames.length {
              let cElemTy = -1
              if csi < sTyIx.length { cElemTy = sTyIx[csi] }
              return rlSlotOfTyOrTwin(cElemTy)
            }
          }
        }
        // A concrete-VARIANT `.map`: the result element is the variant — its ref-list slot
        // is keyed by the variant's type (`uVarTyIx[vi]`).
        if fe >= 0 && cloRetValKind(fe) == "variant" {
          const vi = cloRetValSlot(fe)
          if vi >= 0 && vi < uVariants.length {
            let vTy = -1
            if vi < uVarTyIx.length { vTy = uVarTyIx[vi] }
            return rlSlotOfTyOrTwin(vTy)
          }
        }
        // A UNION-returning `.map`: the result is a ref list of the declared union (all
        // unions share `$uBox`, so the element key is the union alias name).
        if fe >= 0 && cloRetValKind(fe) == "union" && unNames.length > 0 {
          // With no row resolved, the first union's: every union shares one box.
          let mur = mapUnionResultRow(callIx, fnIx)
          if mur < 0 || mur >= unNames.length { mur = 0 }
          let uTy = -1
          if mur < unTyIx.length { uTy = unTyIx[mur] }
          return rlSlotOfTyOrTwin(uTy)
        }
      }
    }
  }
  -1
}

// The element name of a struct- or variant-returning `.map`'s result row, or "". `collectMapFilterUse`
// interns that row after return inference, which still has to name it in the result valtype.
function mfStructResultRowName(callIx: i32, fnIx: i32): string {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return "" }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      if callee.memProp != "map" || c.callArgs.length != 1 { return "" }
      const fe = mfCallbackFe(c.callArgs[0], fnIx)
      if fe < 0 {
        const ck = mfCallbackCloKey(c.callArgs[0], fnIx)
        if ck != "" && sigKeyRetKind(ck) == "struct" {
          const csi = sigKeyRetSlot(ck)
          if csi >= 0 && csi < sNames.length { return sNames[csi] }
        }
        return ""
      }
      const si = cloRetValSlot(fe)
      if cloRetIsStructRow(fe) && si >= 0 && si < sNames.length {
        return sNames[si]
      }
      if cloRetValKind(fe) == "variant" && si >= 0 && si < uVariants.length {
        return uVariants[si]
      }
    }
  }
  ""
}

// The `unNames` row of a union-returning `.map`'s result element: the call's element type at
// the pin of the instance `fnIx` is, else its recorded one; -1 when neither names a row. Every
// union shares one box, so the row decides only what a reader of the element believes (D3092).
export function mapUnionResultRow(callIx: i32, fnIx: i32): i32 {
  let et = iterElemPinTy(callIx, fnIx)
  if et < 0 {
    const rt = tyRefArrElemOf(nodeTyIxOf(callIx))
    if rt >= 0 && !tyHasTyVar(rt) { et = rt }
  }
  if et >= 0 {
    const r = unRowOfCanon(et)
    if r >= 0 { return r }
    return unRowOfFlatMembers(et)
  }
  // With one union registered there is no other row the element could be.
  if unNames.length == 1 { return 0 }
  -1
}

// Resolve a `.map`/`.filter` callback argument to its lifted-function position in `fnStmts`:
// an inline `function(...)` literal, a named function reference, or a let-bound function
// value whose initializer is one of those. -1 when unresolvable. The named-reference rung
// resolves through the innermost-declaring scope (`fnIndexOfInScopeSid`), not a flat lookup. #1204.
export function mfCallbackFe(cbIx: i32, fnIx: i32) {
  if cbIx < 0 { return -1 }
  const inner = unwrapParen(cbIx)
  if inner < 0 { return -1 }
  const e = nodeAt(inner)
  match e {
    FuncDecl => {
      return fnStmtsPosOf(inner)
    }
    Ident => {
      const t = fnIndexOfInScopeAt(sidOfNode(inner), e.identName, fnIx, inner)
      if t >= 0 { return t }
      let li = -1
      // The frame whose scope the binding's initializer is elaborated in: a global's init is
      // elaborated at top level, so resolving it against the calling frame could hijack it.
      let initFn = fnIx
      if fnIx >= 0 {
        const fn = nodeAt(fnIx)
        if fn is FuncDecl { li = bodyLetOfRead(fn.fnBody, inner) }
      }
      if li < 0 {
        li = globalLetOfRead(fnIx, inner)
        if li >= 0 { initFn = -1 }
      }
      if li >= 0 {
        const d = nodeAt(li)
        if d is LetDecl {
          if d.letInit >= 0 {
            // Guard the degenerate self-referential binding against infinite recursion.
            if unwrapParen(d.letInit) != inner {
              return mfCallbackFe(d.letInit, initFn)
            }
          }
        }
      }
    }
    // No other expression is a callback function value.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// Writes the classifier's query depths, capture frame and narrowing decline window back to
// their declared values at compile start. Each is balanced or written before it is read on
// every path that returns; a trap inside a query leaves a depth above 0 and stales its memo.
export function classifyStateReset() {
  capCalleeIx = -1
  capFrame = -1
  capInitAsk = false
  gckDepth = 0
  bcDepth = 0
  bindCellReset()
  irkDepth = 0
  lrDepth = 0
  asgReReadIx = -1
  storageReadLeave(-1)
  objLitSlotsReset()
  0
}
